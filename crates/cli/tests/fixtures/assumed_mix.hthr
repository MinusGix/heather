import bitvec;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// Nothing proves it: the sum does wrap.
axiom sum_keeps_order(left, right: BitVec(64)): left <= left.add(right);

runtime fn mix(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    let ordered: (left <= left.add(right)) = sum_keeps_order(left, right);
    left.add(right)
}

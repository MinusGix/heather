// The pure loop control of the one-Wp round (issues/native-loop-rule.md):
// seven items that count slot 0 of the frame, its first word, down to zero,
// then exit 0. No call inside the loop, so `loop_at` measures each pass by
// the variant, the slot's value. The program's view of the frame
// (`DataRegion::program_view` over `io_frame`, the second page of an eight-KiB segment) carries its bytes
// and the code; the proofs are one pass (`count_pass`) and the exit
// (`count_exit`).
import linux_x86_64_wp;
import linux_x86_64_byte_memory;
import linux_x86_64_image;
import linux_x86_64_sim;
import linux_x86_64_io;
import linux_trees;
import linux_calls;
import x86_64_byte_memory;
import memory;
import itree;
import itree_trace;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_data_read;
import x86_64_store;
import x86_64_fetched_code;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import omega;

// The frame: the profile's second page, its segment eight KiB.
fn io_frame() → DataRegion {
    DataRegion(profile := X86Profile::io(8192), low := BitVec::ofNat(0x411000), size := 4096,
        canonical := Nat::leb_sound(BitVec::ofNat(0x411000, n := 64).toNat() + 4096, Nat::pow(2, 47), trivial),
        data := λ perms relied i inside => {
            let top: (0x412000 <= Nat::pow(2, 64)) = Nat::leb_sound(0x412000, Nat::pow(2, 64), trivial);
            let a = next_rip(BitVec::ofNat(0x411000), i);
            let b = next_rip(BitVec::ofNat(0x410000), 4096 + i);
            let va: (a.toNat() = 0x411000 + i) = BitVec::ofNat_offset_toNat(64, 0x411000, i, omega(inside, top));
            let vb: (b.toNat() = 0x410000 + (4096 + i)) = BitVec::ofNat_offset_toNat(64, 0x410000, 4096 + i, omega(inside, top));
            let place: (0x410000 + (4096 + i) = 0x411000 + i) = omega;
            let same: (b = a) = trans(sym(BitVec::ofNat_toNat(64, b)),
                trans(cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), trans(vb, trans(place, sym(va)))), BitVec::ofNat_toNat(64, a)));
            j(same, λ x _ => perms(x) = Perm::data(), relied(4096 + i, omega(inside)))
        })
}

// Count slot 0 of the frame down to zero, then exit 0: the pure loop control.
fn count_loop() → Prog {
    At(At(At(At(At(At(At(Start,
        1, Block([MovRI(Rbx, BitVec::ofNat(0x411000))])),
        0, Load(WordLoad(Rcx, Rbx))),
        0, Block([TestRR(Rcx, Rcx)])),
        0, Jcc(E, 2)),
        0, Block([MovRI(R8, BitVec::ofNat(1)), SubRR(Rcx, R8)])),
        0, Store(WordStore(Rbx, Rcx))),
        0, Jmp(1))
}
fn count_prog() → Prog {
    At(At(count_loop(), 2, Block([MovRI(Rax, BitVec::ofNat(60)), MovRI(Rdi, BitVec::ofNat(0))])), 0, Syscall)
}
fn count_labels() → Nat → Nat { asm_labels(count_prog()) }
fn count_contracts() → Nat → Contract { λ _ => Contract(λ _ => True, λ _ _ => True) }
fn no_callees() → Nat → Callee<X86Memory(X86Profile::io(8192)), Nat → BitVec(8)> { λ _ => Callee(λ _ _ _ => True, λ _ _ _ _ _ => True) }
fn count_code() → List<BitVec(8)> { asm_code(no_fills(), count_labels(), count_prog()) }
fn count_view(origin: BitVec(64)) → View<X86Memory(X86Profile::io(8192)), Nat → BitVec(8)> {
    io_frame().program_view(count_code(), next_rip(origin, 0))
}
theorem count_sound(origin: BitVec(64)): ViewSound<X86Memory(X86Profile::io(8192)), Nat → BitVec(8)>(X86Profile::io(8192).linux(), count_view(origin)) {
    io_frame().program_view_sound(count_code(), next_rip(origin, 0))
}
// Slot 0: the frame's first word.
fn count_slot(frame: Nat → BitVec(8)) → BitVec(64) { io_frame().buffer(frame).x86_word(0) }

theorem count_reach(): wp_reach(count_labels(), count_loop(), 7).IsTrue() { trivial }
theorem count_exit_reach(): wp_reach(count_labels(), count_prog(), 2).IsTrue() { trivial }

theorem count_exit(origin: BitVec(64), frame: Nat → BitVec(8), state: MachineState<X86Memory(X86Profile::io(8192))>,
    rip: state.rip = next_rip(origin, prog_len(count_loop())),
    holds: count_view(origin).Holds(frame, state.memory)): Sim(X86Profile::io(8192).linux(), Ret(BitVec::ofNat(0)), state) {
    wp_sound(X86Profile::io(8192).linux(), count_view(origin), count_sound(origin), origin, no_fills(), count_labels(), count_contracts(), no_callees(), count_prog(), 2,
        λ _ _ _ _ => False, trivial, Nil,
        λ v m h => j(sym(List::append_nil(count_code())), λ c _ => CodeResident(X86Profile::io(8192).fetch(), m, c, next_rip(origin, 0)), h.right),
        count_exit_reach(), ⟨trivial, ⟨trivial, trivial⟩⟩,
        λ _ _ _ _ never _ => false_elim(never),
        Ret(BitVec::ofNat(0)), frame, state, rip, holds, ⟨refl, refl⟩)
}

fn count_inv() → Nat → ITree<BitVec(64)>(Events::linux()) → (Nat → BitVec(8)) → MachineState<X86Memory(X86Profile::io(8192))> → Type {
    λ w t frame state => (t = Ret(BitVec::ofNat(0))) ∧ (count_slot(frame).toNat() = w)
}

theorem count_down(x: BitVec(64), m: Nat, at: x.toNat() = Succ(m)): x.sub(BitVec::ofNat(1)).toNat() = m {
    let one = BitVec::toNat_ofNat(64, 1, { omega });
    let fits: (BitVec::ofNat(1, n := 64).toNat() <= x.toNat()) = j(sym(one), λ k _ => k <= x.toNat(), { omega });
    trans(bitvec_nat::toNat_sub(64, x, BitVec::ofNat(1), fits),
        trans(cong_fn<Nat, Nat>(λ k => k - BitVec::ofNat(1, n := 64).toNat(), at), trans(cong_fn<Nat, Nat>(λ k => Succ(m) - k, one), Nat::sub_zero(m))))
}

theorem count_room(): 0 + 8 <= 4096 { omega }
theorem count_store_room(w: BitVec(64)): 0 + word_bytes(w).len() <= 4096 {
    let l: (word_bytes(w).len() = 8) = refl;
    omega(l)
}

// The slot, with one less stored in it, holds one less.
theorem count_stored(frame: Nat → BitVec(8), m: Nat, at: count_slot(frame).toNat() = Succ(m)):
    count_slot(io_frame().buffer(frame).set_span(0, word_bytes(count_slot(frame).sub(BitVec::ofNat(1))).to_vector()).cells).toNat() = m {
    trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), io_frame().x86_word_stored(frame, 0, count_slot(frame).sub(BitVec::ofNat(1)))),
        count_down(count_slot(frame), m, at))
}

// One pass of the loop: back to the head one lower, or out at zero.
theorem count_pass(origin: BitVec(64), w: Nat):
    (t: ITree<BitVec(64)>(Events::linux())) → (frame: Nat → BitVec(8)) → (state: MachineState<X86Memory(X86Profile::io(8192))>) →
    count_inv(w, t, frame, state) →
    Wp(X86Profile::io(8192).linux(), count_view(origin), origin, count_labels(), count_contracts(), no_callees(), count_loop(), 7,
        LoopPost(X86Profile::io(8192).linux(), count_view(origin), origin, prog_len(asm_back(count_loop(), 7)), count_inv(), w), t, frame, state) {
    match w {
        Zero => λ t frame state held => Exists(0, ⟨count_room(), ⟨refl,
            ⟨refl, ⟨λ yes after rip same => Inr(λ holds => j(sym(held.left), λ s _ => Sim(X86Profile::io(8192).linux(), s, after),
                count_exit(origin, frame, after, rip, holds))),
             λ no => absurd(trans(sym(test_self_zero(64, count_slot(frame), held.right)), no))⟩⟩⟩⟩),
        Succ(m) => λ t frame state held => Exists(0, ⟨count_room(), ⟨refl,
            ⟨refl, ⟨λ yes => absurd(trans(sym(yes), test_self_nonzero(64, count_slot(frame), j(sym(held.right), λ k _ => 0 < k, { omega })))),
             λ no => Exists(0, ⟨count_store_room(count_slot(frame).sub(BitVec::ofNat(1))), ⟨refl,
                λ after rip same => Inl(Exists(m, ⟨rip, ⟨⟨held.left, count_stored(frame, m, held.right)⟩, { omega }⟩⟩))⟩⟩)⟩⟩⟩⟩),
    }
}

// From the head, with `w` in slot 0, the machine counts it down and exits 0.
theorem count_runs(origin: BitVec(64), frame: Nat → BitVec(8), state: MachineState<X86Memory(X86Profile::io(8192))>,
    rip: state.rip = next_rip(origin, 0),
    holds: count_view(origin).Holds(frame, state.memory)): Sim(X86Profile::io(8192).linux(), Ret(BitVec::ofNat(0)), state) {
    loop_at(X86Profile::io(8192).linux(), count_view(origin), count_sound(origin), origin, no_fills(), count_labels(), count_contracts(), no_callees(), count_loop(), 7,
        trivial, asm_code_after(no_fills(), count_labels(), count_prog(), 2) ++ Nil,
        λ v m h => wp_code_at(X86Profile::io(8192).fetch(), m, origin, no_fills(), count_labels(), count_prog(), 2, Nil,
            j(sym(List::append_nil(count_code())), λ c _ => CodeResident(X86Profile::io(8192).fetch(), m, c, next_rip(origin, 0)), h.right)),
        count_reach(), ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩⟩⟩⟩⟩,
        count_inv(),
        λ w t v s at h held => count_pass(origin, w, t, v, s, held),
        count_slot(frame).toNat(), Ret(BitVec::ofNat(0)), frame, state, rip, holds, ⟨refl, refl⟩)
}

import x86_64;
import x86_64_data_read;
import x86_64_store;
import x86_64_stack;
import x86_64_byte_memory;
import x86_64_memory_contract;
import x86_64_memory_tiers;
import linux_x86_64_io;
import linux_x86_64_wp;
import linux_x86_64_byte_memory;
import memory;
import bitvec;
import list;
import logic;
import nat;
import option;
import omega;

fn at(n: Nat) → BitVec(64) { BitVec::ofNat(n) }

// A run that relies on 64 bytes at 0x10000 being data, and on nothing else.
fn stack_data(perms: BitVec(64) → Perm) → Type { (i: Nat) → i < 64 → perms(next_rip(at(65536), i)) = Perm::data() }
fn profile() → X86Profile { X86Profile(stack_data) }

// A memory where the whole user half is data: the canonical rule refuses
// the rest.
fn flat() → BitVec(64) → Perm { λ (a: BitVec(64)) => Perm::data() }
fn blank() → X86Memory(profile()) {
    X86Memory(cells := λ (a: BitVec(64)) => BitVec::zero(), perms := flat(), relied := λ i _ => refl)
}

// By evaluation, at literal addresses: a read, the kernel half refused, a
// store read back and its neighbour kept.
theorem flat_reads(): profile().read(blank(), at(4096)) = Some(BitVec::zero()) { refl }
theorem flat_refuses_the_kernel_half(): profile().read(blank(), at(Nat::pow(2, 47))) = None { refl }
theorem flat_stores(): profile().read(profile().store(blank(), at(4096), [BitVec::ofNat(7), BitVec::ofNat(9)]), at(4097)) = Some(BitVec::ofNat(9)) { refl }
theorem flat_keeps(): profile().read(profile().store(blank(), at(4096), [BitVec::ofNat(7), BitVec::ofNat(9)]), at(4098)) = Some(BitVec::zero()) { refl }
theorem flat_not_executable(): profile().fetch().executable(blank(), at(4096)) = False { refl }

// The stack the profile relies on, and its laws at a literal region.
fn stack_region() → DataRegion {
    DataRegion(profile := profile(), low := at(65536), size := 64,
        canonical := Nat::leb_sound(at(65536).toNat() + 64, Nat::pow(2, 47), trivial), data := λ perms relied => relied)
}
theorem literal_spill(w: BitVec(64)):
    read_word(profile().data(), profile().store(blank(), next_rip(at(65536), 8), word_bytes(w)), next_rip(at(65536), 8)) = Some(w) {
    stack_region().stack().stored(blank(), 8, { omega }, w)
}

// The permissions change outside the stack (a page at 2^40 unmapped): the
// new memory proves the reliance again, and the same stack's laws apply.
fn unmapped() → BitVec(64) → Perm {
    λ (a: BitVec(64)) => match a.eq_bit(at(Nat::pow(2, 40))) { True => Perm::none(), False => Perm::data() }
}
theorem unmapped_keeps_the_stack(): stack_data(unmapped()) {
    let apart = BitVec::space_apart(64, at(65536), 64, at(Nat::pow(2, 40)), 1,
        Nat::leb_sound(at(65536).toNat() + 64, at(Nat::pow(2, 40)).toNat(), trivial),
        Nat::leb_sound(at(Nat::pow(2, 40)).toNat() + 1, Nat::pow(2, 64), trivial));
    λ i inside => j(sym(apart(i, 0, inside, trivial)), λ s _ => (match s { True => Perm::none(), False => Perm::data() }) = Perm::data(), refl)
}
fn remapped() → X86Memory(profile()) { X86Memory(cells := blank().cells, perms := unmapped(), relied := unmapped_keeps_the_stack()) }
theorem remapped_refuses(): profile().read(remapped(), at(Nat::pow(2, 40))) = None { refl }
theorem remapped_spill(w: BitVec(64)):
    read_word(profile().data(), profile().store(remapped(), next_rip(at(65536), 8), word_bytes(w)), next_rip(at(65536), 8)) = Some(w) {
    stack_region().stack().stored(remapped(), 8, { omega }, w)
}

// At an open profile, region and memory: a spill reads back, and spilling
// below a frame leaves the frame.
theorem spill_reload(r: DataRegion, m: X86Memory(r.profile), i: Nat, fits: i + 8 <= r.size, w: BitVec(64)):
    read_word(r.profile.data(), r.profile.store(m, next_rip(r.low, i), word_bytes(w)), next_rip(r.low, i)) = Some(w) {
    r.stack().stored(m, i, fits, w)
}
theorem spill_below(r: DataRegion, m: X86Memory(r.profile), i, from: Nat, fits: i + 8 <= r.size, below: i + 8 <= from,
    w: BitVec(64)): r.stack().Unchanged(from, m, r.profile.store(m, next_rip(r.low, i), word_bytes(w))) {
    r.stack().store_below(m, i, from, fits, below, w)
}

// A buffer in a region: Linux's read stores at its start and the view
// knows the buffer with the bytes there; a word load reads the buffer.
theorem read_into(r: DataRegion, v: Nat → BitVec(8), m: X86Memory(r.profile), holds: r.Holds(v, m),
    bytes: List<BitVec(8)>, fits: bytes.len() <= r.size):
    r.Holds(r.buffer(v).set_span(0, bytes.to_vector()).cells, r.profile.store(m, r.low, bytes)) {
    r.store_holds(v, m, holds, 0, bytes, omega(fits))
}
theorem read_into_span(r: DataRegion, v: Nat → BitVec(8), m: X86Memory(r.profile), holds: r.Holds(v, m)):
    r.profile.at(m).get_span(r.low, r.size) = r.buffer(v).get_span(0, r.size) {
    r.holds_span(v, m, holds)
}
theorem load_first(r: DataRegion, v: Nat → BitVec(8), m: X86Memory(r.profile), holds: r.Holds(v, m), room: 8 <= r.size):
    Exists<BitVec(64)>(λ w => WordAt(r.profile.data(), m, r.low, w) ∧ (w = r.buffer(v).x86_word(0))) {
    r.buffer_view_sound().word(v, m, r.low, λ w => w = r.buffer(v).x86_word(0), holds, Exists(0, ⟨omega(room), ⟨refl, refl⟩⟩))
}
// A word stored at the start of an eight-byte buffer fits it.
theorem store_fits(r: DataRegion, v: Nat → BitVec(8), w: BitVec(64), room: r.size = 8):
    r.buffer_view().Stores(v, r.low, word_bytes(w), λ _ => True) {
    let eight: (word_bytes(w).len() = 8) = refl;
    Exists(0, ⟨omega(eight, room), ⟨refl, trivial⟩⟩)
}

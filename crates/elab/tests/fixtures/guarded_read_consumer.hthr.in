import x86_64; import x86_64_block; import x86_64_structured_block;
import x86_64_data_read; import x86_64_access_code; import function_ir_loop;
import function_ir_loop_x86; import bitvec; import bool; import nat; import logic; import option;
import prefixes; import identity_body; import identity_selected;

// Open memory and source values: the guard's checked result chooses the
// actual machine arm. The end path needs no address or access premise.
theorem end_path<M>(access: ByteReadAccess<M>, before: MachineState<M>,
    cursor_word, length_word: BitVec(64), cursor, length: Nat,
    cw: LoopWord(64, cursor_word, cursor), lw: LoopWord(64, length_word, length),
    pc: cursor_word = read_gpr(Rsi, before.gprs), pl: length_word = read_gpr(Rdx, before.gprs),
    ended: nat::leb(length, cursor) = True):
    ExecuteAccess(access, whole_code(), before,
        zero_after(structured_branch_entry(Rax, bitvec::ofNat(8, $FD), guard_after(before)))) {
    let guarded = guard_after(before);
    let selected = trans(loop_bounds_zf(Rax, guarded, cursor_word, length_word, cursor, length, cw, lw,
        guard_typed_correct(cursor_word, length_word, before, pc, pl)), ended);
    access_sequence(access, AccessPure(guard_code()), branch_code(), before, guarded,
        zero_after(structured_branch_entry(Rax, bitvec::ofNat(8, $FD), guarded)), refl,
        access_branch_false(access, Rax, bitvec::ofNat(8, $FD), bitvec::ofNat(8, $JD), yes_code(), AccessPure(zero_code()),
            guarded, zero_after(structured_branch_entry(Rax, bitvec::ofNat(8, $FD), guarded)), selected, refl))
}

theorem read_path<M>(access: ByteReadAccess<M>, before: MachineState<M>, buffer: ReadonlyBytes,
    base_word, cursor_word, length_word: BitVec(64), cursor: Nat, byte: BitVec(8),
    bw: LoopWord(64, base_word, buffer.base), cw: LoopWord(64, cursor_word, cursor), lw: LoopWord(64, length_word, buffer.length),
    pb: base_word = read_gpr(Rdi, before.gprs), pc: cursor_word = read_gpr(Rsi, before.gprs), pl: length_word = read_gpr(Rdx, before.gprs),
    inside: LoopBounds(buffer, cursor), bounded: LoopAddressBound(64, buffer), selected: nat::leb(buffer.length, cursor) = False,
    canonical: bitvec::drop_low(47, 17, bitvec::add(64, base_word, cursor_word)) = bitvec::zero(17),
    memory_agrees: (word: BitVec(64)) → access.read(before.memory, word) = buffer.read(bitvec::toNat(64, word)),
    present: ReadsByte(buffer, cursor, byte)):
    Exists<MachineState<M>>(λ after => AccessArtifact<M>(access, whole_code(), whole_bytes(), before, after) ∧
        (read_gpr(Rax, after.gprs) = bitvec::zero_extend(8, 56, byte))) {
    let guarded = guard_after(before);
    let entry = structured_branch_entry(Rax, bitvec::ofNat(8, $FD), guarded);
    let addressed = address_after(entry);
    let address_correct = address_typed_correct(base_word, cursor_word, entry,
        trans(pb, sym(guard_preserves(Rdi, before, trivial))), trans(pc, sym(guard_preserves(Rsi, before, trivial))));
    let address_word = loop_placed_address(R8, addressed, buffer, cursor, base_word, cursor_word, bw, cw, inside, bounded, address_correct);
    let same_memory = trans(address_memory(entry), guard_memory(before));
    let byte_present = j(sym(same_memory), λ memory _ => access.read(memory, read_gpr(R8, addressed.gprs)) = Some(byte),
        loop_read_address(access, before.memory, buffer, cursor, read_gpr(R8, addressed.gprs), byte, memory_agrees, address_word, present));
    let byte_canonical = j(sym(address_correct), λ address _ => bitvec::drop_low(47, 17, address) = bitvec::zero(17), canonical);
    let body = identity_read_artifact(byte, access, addressed, byte_canonical, byte_present);
    let middle = body.continuation.after;
    let read_step = access_read_then(access, identity_load(), byte, identity_body_code(), identity_published_bytes(), addressed,
        Rax, bitvec::zero_extend(8, 56, byte), identity_body_Protected, body);
    let yes_step = access_sequence(access, AccessPure(address_code()), AccessSequence(AccessRead(identity_load()), AccessPure(identity_body_code())),
        entry, addressed, middle, refl, read_step);
    let chosen = trans(loop_bounds_zf(Rax, guarded, cursor_word, length_word, cursor, buffer.length, cw, lw,
        guard_typed_correct(cursor_word, length_word, before, pc, pl)), selected);
    let after = execute_short_control(Jump(bitvec::ofNat(8, $JD)), middle);
    let branch_step = access_branch_true(access, Rax, bitvec::ofNat(8, $FD), bitvec::ofNat(8, $JD), yes_code(), AccessPure(zero_code()),
        guarded, middle, chosen, yes_step);
    Exists(after, ⟨AccessArtifact(encoding := whole_encoding(), layout := whole_layout(),
        execution := access_sequence(access, AccessPure(guard_code()), branch_code(), before, guarded, after, refl, branch_step)),
        body.continuation.result_correct⟩)
}

theorem end_artifact<M>(access: ByteReadAccess<M>, before: MachineState<M>,
    cursor_word, length_word: BitVec(64), cursor, length: Nat,
    cw: LoopWord(64, cursor_word, cursor), lw: LoopWord(64, length_word, length),
    pc: cursor_word = read_gpr(Rsi, before.gprs), pl: length_word = read_gpr(Rdx, before.gprs),
    ended: nat::leb(length, cursor) = True):
    Exists<MachineState<M>>(λ after => AccessArtifact<M>(access, whole_code(), whole_bytes(), before, after) ∧
        (read_gpr(Rax, after.gprs) = bitvec::zero(64))) {
    let entry = structured_branch_entry(Rax, bitvec::ofNat(8, $FD), guard_after(before));
    Exists(zero_after(entry), ⟨AccessArtifact(encoding := whole_encoding(), layout := whole_layout(),
        execution := end_path(access, before, cursor_word, length_word, cursor, length, cw, lw, pc, pl, ended)),
        zero_typed_correct(entry)⟩)
}

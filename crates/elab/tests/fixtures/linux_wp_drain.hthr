// The I/O loop control of the one-Wp round (issues/native-loop-rule.md):
// five items that read stdin into the page until a read returns no bytes,
// then exit 0. No variant: every pass makes a call, so `loop_at` measures it
// by the trace. The page view (`io_page_view`) carries the page the reads
// fill; the proofs are one pass (`drain_pass`) and the exit (`drain_exit`).
import linux_x86_64_wp;
import linux_x86_64_views;
import linux_x86_64_sim;
import linux_x86_64_io;
import linux_trees;
import linux_calls;
import elf64_io;
import itree;
import itree_trace;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_fetched_code;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import omega;

// Read stdin to its end, into the page, and exit 0: the I/O loop control.
fn drain(n: Nat) → ITree<BitVec(64)>(Events::linux()) {
    match n {
        Zero => Cut,
        Succ(m) => Vis(ReadCmd(BitVec::ofNat(0), 4096), λ (r: ReadResult) => match r {
            ReadBytes(bytes) => match bytes { Nil => Ret(BitVec::ofNat(0)), Cons(_, _) => drain(m) },
            ReadFailed(_) => drain(m),
        }),
    }
}

fn drain_loop() → Prog {
    At(At(At(At(At(Start,
        1, Block([MovRI(Rax, BitVec::ofNat(0)), MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rsi, BitVec::ofNat(0x410000)), MovRI(Rdx, BitVec::ofNat(4096))])),
        0, Syscall),
        0, Block([TestRR(Rax, Rax)])),
        0, Jcc(E, 2)),
        0, Jmp(1))
}
fn drain_prog() → Prog {
    At(At(drain_loop(), 2, Block([MovRI(Rax, BitVec::ofNat(60)), MovRI(Rdi, BitVec::ofNat(0))])), 0, Syscall)
}
fn drain_labels() → Nat → Nat { asm_labels(drain_prog()) }
fn no_contracts() → Nat → Contract { λ _ => Contract(λ _ => True, λ _ _ => True) }

theorem drain_reach(): wp_reach(drain_labels(), drain_loop(), 5).IsTrue() { trivial }
theorem drain_exit_reach(): wp_reach(drain_labels(), drain_prog(), 2).IsTrue() { trivial }

// The exit: from the exit label, the machine exits 0.
theorem drain_exit(file: IoImage, origin: BitVec(64),
    code: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), asm_code(no_fills(), drain_labels(), drain_prog()), next_rip(origin, 0)),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, rip: state.rip = next_rip(origin, prog_len(drain_loop())),
    holds: state.memory = IoMemory(file, page)): Sim(io_linux(), Ret(BitVec::ofNat(0)), state) {
    wp_sound(io_linux(), io_page_view(file), io_page_view_sound(file), origin, no_fills(), drain_labels(), no_contracts(), drain_prog(), 2,
        λ _ _ _ _ => False, trivial, Nil,
        λ v m h => j(sym(h), λ x _ => CodeResident(io_fetch_access(), x, asm_code(no_fills(), drain_labels(), drain_prog()) ++ Nil, next_rip(origin, 0)),
            j(sym(List::append_nil(asm_code(no_fills(), drain_labels(), drain_prog()))), λ c _ => CodeResident(io_fetch_access(), IoMemory(file, v), c, next_rip(origin, 0)), code(v))),
        drain_exit_reach(), ⟨trivial, ⟨trivial, trivial⟩⟩,
        λ _ _ _ _ never _ => false_elim(never),
        Ret(BitVec::ofNat(0)), page, state, rip, holds, ⟨refl, refl⟩)
}

fn drain_inv(file: IoImage) → Nat → ITree<BitVec(64)>(Events::linux()) → (Nat → BitVec(8)) → MachineState<IoMemory> → Type {
    λ w t page state => t = drain(w)
}

theorem drain_fits(n: Nat, fits: n <= 4096): 0 + n <= 4096 { omega }
theorem drain_small(n: Nat, fits: n <= 4096): n < Nat::pow(2, 64) { omega }
theorem drain_pos(n: Nat): 0 < Succ(n) { omega }

// A read that came back with bytes, or failed, leaves RAX nonzero.
theorem drain_some_nonzero(n: Nat, fits: Succ(n) <= 4096):
    is_zero_bits(64, bitvec_nat::word_of_nat(64, Succ(n)).band(bitvec_nat::word_of_nat(64, Succ(n)))) = bool::False {
    test_self_nonzero(64, bitvec_nat::word_of_nat(64, Succ(n)),
        j(sym(bitvec_nat::toNat_word_of_nat(64, Succ(n), drain_small(Succ(n), fits))), λ x _ => 0 < x, drain_pos(n)))
}
theorem drain_failed_nonzero(e: Nat, error: Errno(e)): is_zero_bits(64, errno_word(e).band(errno_word(e))) = bool::False {
    test_self_nonzero(64, errno_word(e), errno_nonzero(e, error))
}

// One pass of the loop: a read, then back to the head, or out at the end.
theorem drain_pass(file: IoImage, origin: BitVec(64),
    code: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), asm_code(no_fills(), drain_labels(), drain_prog()), next_rip(origin, 0)),
    w: Nat, page: Nat → BitVec(8), state: MachineState<IoMemory>):
    Wp(io_linux(), io_page_view(file), origin, drain_labels(), no_contracts(), drain_loop(), 5,
        LoopPost(io_linux(), io_page_view(file), origin, prog_len(asm_back(drain_loop(), 5)), drain_inv(file), w), drain(w), page, state) {
    match w {
        Zero => trivial,
        Succ(m) => ⟨⟨⟨refl, ⟨refl, refl⟩⟩, page_span_writable(IoMemory(file, page), BitVec::ofNat(0x410000), 0, 4096, trivial, refl)⟩,
            λ a => match a {
                ReadBytes(bytes) => match bytes {
                    Nil => λ fits junk leaves rcx r11 => Exists(0, ⟨trivial, ⟨trivial, ⟨refl,
                        ⟨λ yes after rip _ => Inr(λ holds => drain_exit(file, origin, code, page_stored(page, 0, Nil), after, rip, holds)),
                         λ no => absurd(no)⟩⟩⟩⟩),
                    Cons(b, rest) => λ fits junk leaves rcx r11 => Exists(0, ⟨trivial, ⟨drain_fits(Succ(rest.len()), fits), ⟨refl,
                        ⟨λ yes => absurd(trans(sym(yes), drain_some_nonzero(rest.len(), fits))),
                         λ no after rip _ => Inl(Exists(m, ⟨rip, ⟨refl, trivial⟩⟩))⟩⟩⟩⟩),
                },
                ReadFailed(e) => λ error junk leaves rcx r11 => Exists(0, ⟨trivial, ⟨drain_fits(junk.len(), leaves), ⟨refl,
                    ⟨λ yes => absurd(trans(sym(yes), drain_failed_nonzero(e, error))),
                     λ no after rip _ => Inl(Exists(m, ⟨rip, ⟨refl, trivial⟩⟩))⟩⟩⟩⟩),
            }⟩,
    }
}

// From the head, the machine reads to the end of its input and exits 0, at
// every fuel.
theorem drain_runs(file: IoImage, origin: BitVec(64),
    code: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), asm_code(no_fills(), drain_labels(), drain_prog()), next_rip(origin, 0)),
    n: Nat, page: Nat → BitVec(8), state: MachineState<IoMemory>, rip: state.rip = next_rip(origin, 0),
    holds: state.memory = IoMemory(file, page)): Sim(io_linux(), drain(n), state) {
    loop_at(io_linux(), io_page_view(file), io_page_view_sound(file), origin, no_fills(), drain_labels(), no_contracts(), drain_loop(), 5,
        trivial, asm_code_after(no_fills(), drain_labels(), drain_prog(), 2) ++ Nil,
        λ v m h => j(sym(h), λ x _ => CodeResident(io_fetch_access(), x,
                asm_code(no_fills(), drain_labels(), drain_loop()) ++ (asm_code_after(no_fills(), drain_labels(), drain_prog(), 2) ++ Nil), next_rip(origin, 0)),
            wp_code_at(io_fetch_access(), IoMemory(file, v), origin, no_fills(), drain_labels(), drain_prog(), 2, Nil,
                j(sym(List::append_nil(asm_code(no_fills(), drain_labels(), drain_prog()))),
                    λ c _ => CodeResident(io_fetch_access(), IoMemory(file, v), c, next_rip(origin, 0)), code(v)))),
        drain_reach(), ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩⟩⟩,
        drain_inv(file),
        λ w t v s at h same => j(sym(same), λ x _ => Wp(io_linux(), io_page_view(file), origin, drain_labels(), no_contracts(), drain_loop(), 5,
            LoopPost(io_linux(), io_page_view(file), origin, prog_len(asm_back(drain_loop(), 5)), drain_inv(file), w), x, v, s),
            drain_pass(file, origin, code, w, v, s)),
        n, drain(n), page, state, rip, holds, refl)
}

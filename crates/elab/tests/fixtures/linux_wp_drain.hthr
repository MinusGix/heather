// The I/O loop control of the one-Wp round (issues/native-loop-rule.md):
// five items that read stdin into the page until a read returns no bytes,
// then exit 0. No variant: every pass makes a call, so `loop_at` measures it
// by the trace. The program's view of the page (`DataRegion::program_view`
// over `DataRegion::io_page`) carries the buffer the reads fill and the code;
// the proofs are one pass (`drain_pass`), the exit (`drain_exit`), and the
// process Linux loads from an image of the program, from its entry
// (`drain_entry`).
import linux_x86_64_wp;
import linux_x86_64_byte_memory;
import linux_x86_64_image;
import linux_x86_64_sim;
import linux_x86_64_io;
import linux_trees;
import linux_calls;
import x86_64_byte_memory;
import memory;
import itree;
import itree_trace;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_fetched_code;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import omega;

// Read stdin to its end, into the page, and exit 0: the I/O loop control.
fn drain(n: Nat) → ITree<BitVec(64)>(Events::linux()) {
    match n {
        Zero => Cut,
        Succ(m) => Vis(ReadCmd(BitVec::ofNat(0), 4096), λ (r: ReadResult) => match r {
            ReadBytes(bytes) => match bytes { Nil => Ret(BitVec::ofNat(0)), Cons(_, _) => drain(m) },
            ReadFailed(_) => drain(m),
        }),
    }
}

fn drain_loop() → Prog {
    At(At(At(At(At(Start,
        1, Block([MovRI(Rax, BitVec::ofNat(0)), MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rsi, BitVec::ofNat(0x410000)), MovRI(Rdx, BitVec::ofNat(4096))])),
        0, Syscall),
        0, Block([TestRR(Rax, Rax)])),
        0, Jcc(E, 2)),
        0, Jmp(1))
}
fn drain_prog() → Prog {
    At(At(drain_loop(), 2, Block([MovRI(Rax, BitVec::ofNat(60)), MovRI(Rdi, BitVec::ofNat(0))])), 0, Syscall)
}
fn drain_labels() → Nat → Nat { asm_labels(drain_prog()) }
fn no_contracts() → Nat → Contract { λ _ => Contract(λ _ => True, λ _ _ => True) }
fn no_callees() → Nat → Callee<X86Memory(X86Profile::io()), Nat → BitVec(8)> { λ _ => Callee(λ _ _ _ => True, λ _ _ _ _ _ => True) }
fn drain_code() → List<BitVec(8)> { asm_code(no_fills(), drain_labels(), drain_prog()) }
fn drain_view(origin: BitVec(64)) → View<X86Memory(X86Profile::io()), Nat → BitVec(8)> {
    DataRegion::io_page().program_view(drain_code(), next_rip(origin, 0))
}
theorem drain_sound(origin: BitVec(64)): ViewSound<X86Memory(X86Profile::io()), Nat → BitVec(8)>(X86Profile::io().linux(), drain_view(origin)) {
    DataRegion::io_page().program_view_sound(drain_code(), next_rip(origin, 0))
}

theorem drain_reach(): wp_reach(drain_labels(), drain_loop(), 5).IsTrue() { trivial }
theorem drain_exit_reach(): wp_reach(drain_labels(), drain_prog(), 2).IsTrue() { trivial }

// The exit: from the exit label, the machine exits 0.
theorem drain_exit(origin: BitVec(64), page: Nat → BitVec(8), state: MachineState<X86Memory(X86Profile::io())>,
    rip: state.rip = next_rip(origin, prog_len(drain_loop())),
    holds: drain_view(origin).Holds(page, state.memory)): Sim(X86Profile::io().linux(), Ret(BitVec::ofNat(0)), state) {
    wp_sound(X86Profile::io().linux(), drain_view(origin), drain_sound(origin), origin, no_fills(), drain_labels(), no_contracts(), no_callees(), drain_prog(), 2,
        λ _ _ _ _ => False, trivial, Nil,
        λ v m h => j(sym(List::append_nil(drain_code())), λ c _ => CodeResident(X86Profile::io().fetch(), m, c, next_rip(origin, 0)), h.right),
        drain_exit_reach(), ⟨trivial, ⟨trivial, trivial⟩⟩,
        λ _ _ _ _ never _ => false_elim(never),
        Ret(BitVec::ofNat(0)), page, state, rip, holds, ⟨refl, refl⟩)
}

fn drain_inv() → Nat → ITree<BitVec(64)>(Events::linux()) → (Nat → BitVec(8)) → MachineState<X86Memory(X86Profile::io())> → Type {
    λ w t page state => t = drain(w)
}

theorem drain_fits(n: Nat, fits: n <= 4096): 0 + n <= 4096 { omega }
theorem drain_small(n: Nat, fits: n <= 4096): n < Nat::pow(2, 64) { omega }
theorem drain_pos(n: Nat): 0 < Succ(n) { omega }

// A read that came back with bytes, or failed, leaves RAX nonzero.
theorem drain_some_nonzero(n: Nat, fits: Succ(n) <= 4096):
    is_zero_bits(64, bitvec_nat::word_of_nat(64, Succ(n)).band(bitvec_nat::word_of_nat(64, Succ(n)))) = bool::False {
    test_self_nonzero(64, bitvec_nat::word_of_nat(64, Succ(n)),
        j(sym(bitvec_nat::toNat_word_of_nat(64, Succ(n), drain_small(Succ(n), fits))), λ x _ => 0 < x, drain_pos(n)))
}
// A read of no bytes leaves RAX zero. Stated here and cited, as the other two
// answers' facts are: `absurd` of the bare flag equation reduces the flag off
// the answered machine state by substitution, most of this module's
// elaboration (issues/absurd-reduces-computed-sides-by-substitution.md).
theorem drain_none_zero(): is_zero_bits(64, bitvec_nat::word_of_nat(64, 0).band(bitvec_nat::word_of_nat(64, 0))) = bool::True {
    test_self_zero(64, bitvec_nat::word_of_nat(64, 0), refl)
}
theorem drain_failed_nonzero(e: Nat, error: Errno(e)): is_zero_bits(64, errno_word(e).band(errno_word(e))) = bool::False {
    test_self_nonzero(64, errno_word(e), errno_nonzero(e, error))
}

// The read asks for the whole page, which is writable in every memory of
// the profile.
theorem drain_writable(m: X86Memory(X86Profile::io())):
    X86Profile::io().at(m).Allows(Perm::writes, BitVec::ofNat(0x410000), 4096) {
    DataRegion::io_page().allows(Perm::writes, refl, m, 0, 4096, drain_fits(4096, omega))
}

// One pass of the loop: a read, then back to the head, or out at the end.
theorem drain_pass(origin: BitVec(64), w: Nat, page: Nat → BitVec(8), state: MachineState<X86Memory(X86Profile::io())>):
    Wp(X86Profile::io().linux(), drain_view(origin), origin, drain_labels(), no_contracts(), no_callees(), drain_loop(), 5,
        LoopPost(X86Profile::io().linux(), drain_view(origin), origin, prog_len(asm_back(drain_loop(), 5)), drain_inv(), w), drain(w), page, state) {
    match w {
        Zero => trivial,
        Succ(m) => ⟨λ memory _ => ⟨⟨refl, ⟨refl, refl⟩⟩, drain_writable(memory)⟩,
            λ a => match a {
                ReadBytes(bytes) => match bytes {
                    Nil => λ fits junk leaves rcx r11 => Exists(0, ⟨trivial, ⟨refl,
                        ⟨λ yes after rip _ => Inr(λ holds => drain_exit(origin, DataRegion::io_page().buffer(page).set_span(0, List::to_vector<BitVec(8)>(Nil)).cells,
                            after, rip, holds)),
                         λ no => absurd(trans(sym(drain_none_zero()), no))⟩⟩⟩),
                    Cons(_, rest) => λ fits junk leaves rcx r11 => Exists(0, ⟨drain_fits(Succ(rest.len()), fits), ⟨refl,
                        ⟨λ yes => absurd(trans(sym(yes), drain_some_nonzero(rest.len(), fits))),
                         λ no after rip _ => Inl(Exists(m, ⟨rip, ⟨refl, trivial⟩⟩))⟩⟩⟩),
                },
                ReadFailed(e) => λ error junk leaves rcx r11 => Exists(0, ⟨drain_fits(junk.len(), leaves), ⟨refl,
                    ⟨λ yes => absurd(trans(sym(yes), drain_failed_nonzero(e, error))),
                     λ no after rip _ => Inl(Exists(m, ⟨rip, ⟨refl, trivial⟩⟩))⟩⟩⟩),
            }⟩,
    }
}

// From the head, the machine reads to the end of its input and exits 0, at
// every fuel.
theorem drain_runs(origin: BitVec(64), n: Nat, page: Nat → BitVec(8), state: MachineState<X86Memory(X86Profile::io())>,
    rip: state.rip = next_rip(origin, 0), holds: drain_view(origin).Holds(page, state.memory)): Sim(X86Profile::io().linux(), drain(n), state) {
    loop_at(X86Profile::io().linux(), drain_view(origin), drain_sound(origin), origin, no_fills(), drain_labels(), no_contracts(), no_callees(), drain_loop(), 5,
        trivial, asm_code_after(no_fills(), drain_labels(), drain_prog(), 2) ++ Nil,
        λ v m h => wp_code_at(X86Profile::io().fetch(), m, origin, no_fills(), drain_labels(), drain_prog(), 2, Nil,
            j(sym(List::append_nil(drain_code())), λ c _ => CodeResident(X86Profile::io().fetch(), m, c, next_rip(origin, 0)), h.right)),
        drain_reach(), ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩⟩⟩,
        drain_inv(),
        λ w t v s at h same => j(sym(same), λ x _ => Wp(X86Profile::io().linux(), drain_view(origin), origin, drain_labels(), no_contracts(), no_callees(), drain_loop(), 5,
            LoopPost(X86Profile::io().linux(), drain_view(origin), origin, prog_len(asm_back(drain_loop(), 5)), drain_inv(), w), x, v, s),
            drain_pass(origin, w, v, s)),
        n, drain(n), page, state, rip, holds, refl)
}

// The entry: the process Linux loads from a file of a 232-byte header and
// the program, started at the entry with any registers and flags, reads to
// the end of its input and exits 0.
theorem drain_entry(header: List<BitVec(8)>, long: header.len() = 232, n: Nat, gprs: Gprs, flags: Flags):
    Sim(X86Profile::io().linux(), drain(n), MachineState(gprs, flags, io_entry(), X86Memory::io_load(header ++ drain_code()))) {
    let memory = X86Memory::io_load(header ++ drain_code());
    let fits: (232 + drain_code().len() <= 65536) = Nat::leb_sound(232 + drain_code().len(), 65536, trivial);
    drain_runs(io_entry(), n, io_zero(), MachineState(gprs, flags, io_entry(), memory), refl,
        ⟨X86Memory::io_load_page(header ++ drain_code()), X86Memory::io_load_entry(header, drain_code(), long, fits)⟩)
}

// Regions lowered by `function_ir_lower`'s one theorem
// (issues/function-ir-verified-lowering.md, round 1): the code is computed
// by evaluation, and each region's claim is the theorem instantiated. No
// proof here is about the region's own code.

import function_ir;
import function_ir_lower;
import x86_64;
import x86_64_block;
import x86_64_kept;
import bitvec;
import list;
import logic;
import option;

// add64: x + y, as the per-function certificate path lowers it.
fn add64_code() → List<Instruction> { [MovRR(Rax, Rdi), AddRR(Rax, Rsi)] }

theorem add64_lowers(): add64_raw().lower_planned([Rdi, Rsi], [Rax]) = Some(add64_code()) {
    refl
}

theorem add64_bytes(): canonical_block_bytes(add64_code()).len() = 6 { refl }

theorem add64_computes<M>(values: Valuation(), s: MachineState<M>,
    left: values(64, 0) = read_gpr(Rdi, s.gprs),
    right: values(64, 1) = read_gpr(Rsi, s.gprs),
    graph: RegionHolds(add64_raw(), values)):
    values(64, 2) = read_gpr(Rax, execute_block_normal(add64_code(), s).gprs)
{
    add64_raw().lower_correct<M>([Rdi, Rsi], [Rax],
        add64_raw().plan([Rdi, Rsi], [Rax]), add64_code(), values, s,
        add64_lowers(), ⟨left, ⟨right, trivial⟩⟩, graph).left
}

// sum4: two independent additions and their join, in either schedule.
fn sum4_code() → List<Instruction> {
    [AddRR(Rdi, Rsi), AddRR(Rdx, Rcx), MovRR(Rax, Rdi), AddRR(Rax, Rdx)]
}

theorem sum4_lowers():
    sum4_left_first_raw().lower_planned([Rdi, Rsi, Rdx, Rcx], [Rax]) = Some(sum4_code())
{
    refl
}

theorem sum4_computes<M>(values: Valuation(), s: MachineState<M>,
    a: values(64, 0) = read_gpr(Rdi, s.gprs), b: values(64, 1) = read_gpr(Rsi, s.gprs),
    c: values(64, 2) = read_gpr(Rdx, s.gprs), d: values(64, 3) = read_gpr(Rcx, s.gprs),
    graph: RegionHolds(sum4_left_first_raw(), values)):
    values(64, 6) = read_gpr(Rax, execute_block_normal(sum4_code(), s).gprs)
{
    sum4_left_first_raw().lower_correct<M>([Rdi, Rsi, Rdx, Rcx], [Rax],
        sum4_left_first_raw().plan([Rdi, Rsi, Rdx, Rcx], [Rax]), sum4_code(), values, s,
        sum4_lowers(), ⟨a, ⟨b, ⟨c, ⟨d, trivial⟩⟩⟩⟩, graph).left
}

// mix (examples/x86-native/mix.hthr): a shared sum, a full-width constant,
// and an XOR of the two.
fn mix_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [
            Add(width := 64, output := 2, left := 0, right := 1),
            Const(width := 64, output := 3, value := 81985529216486895),
            Add(width := 64, output := 4, left := 2, right := 3),
            BitXor(width := 64, output := 5, left := 2, right := 4),
        ],
        outputs := Ports([Port(id := 5, width := 64)]))
}

fn mix_code() → List<Instruction> {
    [AddRR(Rdi, Rsi), MovRI(Rax, BitVec::ofNat(81985529216486895)), MovRR(Rcx, Rdi),
     AddRR(Rcx, Rax), MovRR(Rax, Rdi), XorRR(Rax, Rcx)]
}

theorem mix_lowers(): mix_region().lower_planned([Rdi, Rsi], [Rax]) = Some(mix_code()) {
    refl
}

theorem mix_computes<M>(values: Valuation(), s: MachineState<M>,
    left: values(64, 0) = read_gpr(Rdi, s.gprs),
    right: values(64, 1) = read_gpr(Rsi, s.gprs),
    graph: RegionHolds(mix_region(), values)):
    values(64, 5) = read_gpr(Rax, execute_block_normal(mix_code(), s).gprs)
{
    mix_region().lower_correct<M>([Rdi, Rsi], [Rax],
        mix_region().plan([Rdi, Rsi], [Rax]), mix_code(), values, s,
        mix_lowers(), ⟨left, ⟨right, trivial⟩⟩, graph).left
}

// A comparison's bit, zero-extended in RAX.
fn below_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [UnsignedLessThan(width := 64, output := 2, left := 0, right := 1)],
        outputs := Ports([Port(id := 2, width := 1)]))
}

fn below_code() → List<Instruction> { [XorRR(Rax, Rax), CmpRR(Rdi, Rsi), SetBelow(Al)] }

theorem below_lowers(): below_region().lower_planned([Rdi, Rsi], [Rax]) = Some(below_code()) {
    refl
}

theorem below_computes<M>(values: Valuation(), s: MachineState<M>,
    left: values(64, 0) = read_gpr(Rdi, s.gprs),
    right: values(64, 1) = read_gpr(Rsi, s.gprs),
    graph: RegionHolds(below_region(), values)):
    values(1, 2).zero_extend(63) = read_gpr(Rax, execute_block_normal(below_code(), s).gprs)
{
    below_region().lower_correct<M>([Rdi, Rsi], [Rax],
        below_region().plan([Rdi, Rsi], [Rax]), below_code(), values, s,
        below_lowers(), ⟨left, ⟨right, trivial⟩⟩, graph).left
}

// A placement that puts x + y over y: ADD commutes, so the sum is taken
// into y's register in place instead of copying x over y first.
theorem commuted_into_right(): add64_raw().lower([Rdi, Rsi], [Rax], [Into(Rsi)]) =
    Some([AddRR(Rsi, Rdi), MovRR(Rax, Rsi)])
{
    refl
}

// Negative controls. SUB does not commute: a placement that writes x's
// copy over y before the SUB reads y is refused, not lowered wrong.
fn sub64_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [Sub(width := 64, output := 2, left := 0, right := 1)],
        outputs := Ports([Port(id := 2, width := 64)]))
}

theorem clobbering_placement_refused():
    sub64_region().lower([Rdi, Rsi], [Rax], [Into(Rsi)]) = None
{
    refl
}

// The comparison's XOR would clear an operand, so a placement that puts the
// bit over one is lowered in the second form: compare first, then clear with
// a MOV, which writes no flag. It was a refusal while the XOR form was the
// only one (issues/function-ir-planner-register-pressure.md).
theorem compared_over_an_operand():
    below_region().lower([Rdi, Rsi], [Rax], [Into(Rsi)]) =
        Some([CmpRR(Rdi, Rsi), MovRI(Rsi, BitVec::zero()), SetBelow(Sil), MovRR(Rax, Rsi)])
{
    refl
}

// A shift by a constant lowers to one SHL by an imm8 (§16.13 round 4).
fn shift_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64)]),
        nodes := [ShiftLeft(width := 64, output := 1, value := 0, amount := 3)],
        outputs := Ports([Port(id := 1, width := 64)]))
}

theorem shift_lowers(): shift_region().lower_planned([Rdi], [Rax]).is_some() = True { refl }

// Narrow widths (issues/function-ir-narrow-arithmetic.md). Inside a region
// a value of any width up to 64 has a register: here two words are cut to
// 32 bits, added and shifted there, and the result widened.
fn narrow_inside_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [
            Resize(from := 64, to := 32, output := 2, source := 0),
            Resize(from := 64, to := 32, output := 3, source := 1),
            Add(width := 32, output := 4, left := 2, right := 3),
            ShiftLeft(width := 32, output := 5, value := 4, amount := 3),
            Resize(from := 32, to := 64, output := 6, source := 5),
        ],
        outputs := Ports([Port(id := 6, width := 64)]))
}

theorem narrow_inside_lowers(): narrow_inside_region().lower_planned([Rdi, Rsi], [Rax]).is_some() = True { refl }

// The same at a width no instruction has.
fn odd_inside_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [
            Resize(from := 64, to := 27, output := 2, source := 0),
            Resize(from := 64, to := 27, output := 3, source := 1),
            Sub(width := 27, output := 4, left := 2, right := 3),
            Resize(from := 27, to := 64, output := 5, source := 4),
        ],
        outputs := Ports([Port(id := 5, width := 64)]))
}

theorem odd_inside_lowers(): odd_inside_region().lower_planned([Rdi, Rsi], [Rax]).is_some() = True { refl }

// The signed order is not the unsigned order of zero-extended words, so a
// narrow signed comparison has no code yet.
fn narrow_signed_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 64), Port(id := 1, width := 64)]),
        nodes := [
            Resize(from := 64, to := 32, output := 2, source := 0),
            Resize(from := 64, to := 32, output := 3, source := 1),
            SignedLessThan(width := 32, output := 4, left := 2, right := 3),
        ],
        outputs := Ports([Port(id := 4, width := 1)]))
}

theorem narrow_signed_refused(): narrow_signed_region().lower_planned([Rdi, Rsi], [Rax]) = None { refl }

// A narrow value does not cross a region's boundary: a port is a word or a
// bit (issues/runtime-repr-narrow-words.md).
fn narrow_shift_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 32)]),
        nodes := [ShiftLeft(width := 32, output := 1, value := 0, amount := 3)],
        outputs := Ports([Port(id := 1, width := 32)]))
}

theorem narrow_shift_refused(): narrow_shift_region().lower_planned([Rdi], [Rax]) = None { refl }

fn narrow_region() → Region {
    Region(
        inputs := Ports([Port(id := 0, width := 32), Port(id := 1, width := 32)]),
        nodes := [Add(width := 32, output := 2, left := 0, right := 1)],
        outputs := Ports([Port(id := 2, width := 32)]))
}

theorem narrow_refused(): narrow_region().lower_planned([Rdi, Rsi], [Rax]) = None { refl }

// The rest of mix's contract, from the frame lemmas: memory untouched, RIP
// past the block, and the callee-saved registers kept.
theorem mix_frame<M>(s: MachineState<M>):
    execute_block_normal(mix_code(), s).memory = s.memory ∧
    (execute_block_normal(mix_code(), s).rip = block_end(mix_code(), s.rip) ∧
     Kept(callee_saved(), s.gprs, execute_block_normal(mix_code(), s).gprs))
{
    ⟨execute_block_memory<M>(mix_code(), s),
     ⟨execute_block_rip<M>(mix_code(), s),
      execute_block_kept<M>(mix_code(), s, callee_saved(), trivial)⟩⟩
}

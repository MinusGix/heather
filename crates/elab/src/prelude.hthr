// Stage-1 prelude: the J lemmas. `sym` and `trans` are polymorphic in the
// type the equation is at (issues/surface-polymorphism.md). Proofs are
// ordinary expressions; `refl` is just a value (docs/sketches/surface-v1.md).
//
// `cong`'s function argument is **implicit**, and in *checking* position it
// is inferred (issues/congruence-by-anti-unification.md): `cong(p)` against
// an expected `Succ(a) = Succ(b)` elaborates to `cong(λz => Succ(z), p)`.
// The information was never in the proof — no unifier reaches `?f a ≟ X`,
// which is flex-rigid with `a` an arbitrary term and so outside the Miller
// fragment — it is in the *expected type*, and recovering it is
// anti-unification (the least general generalization of the goal's two
// sides) rather than unification. In *inference* position there is no
// expected type and the function still has to be given: `@cong(λ (x: Nat)
// => Succ(x), a, b, p)`, or an annotated `let`.
//
// `cong_succ` stays: it is a different lemma by name, and the Nat suite's.
//
// Universe polymorphism is still out: `A` ranges over `Ty 0`, so these live
// at level 1. Quantifying over the *level* is layer-m `ΠΠ ℓ⃗` territory.

// The expected-type-directed meaning of `[…]`. The syntax supplies the
// container `C` from checking position and the literal length `n`; the
// dictionary supplies the element type used to check every entry and a
// conversion from the primitive vector representation. Keeping this class in
// the implicit prelude gives the syntax one canonical protocol identity.
class CollectionLiteral<C>(n: Nat) {
    element: Type,
    fromLiteral: [element; n] → C,
}

// Endpoints are implicit `{}`-parameters: they are recovered by unification
// from the proof argument's type (issues/elab-stage2-metas.md). `@sym(a,b,p)`
// still supplies them positionally *and leaves `A` inferred* — `@` controls
// the value implicits, `<…>` the type arguments, and the two compose as
// `@sym<A>(a, b, p)` (issues/at-and-type-arguments.md).
theorem sym<A>({a: A}, {b: A}, p: a = b): b = a {
    j(p, λ y q => y = a, refl)
}

theorem trans<A>({a: A}, {b: A}, {c: A}, p: a = b, q: b = c): a = c {
    j(q, λ y r => a = y, p)
}

theorem Nat::cong_succ({a: Nat}, {b: Nat}, p: a = b): Succ(a) = Succ(b) {
    j(p, λ y q => Succ(a) = Succ(y), refl)
}

// Congruence, general in the function and in both types. `f` is implicit and
// solved by anti-unification against the expected type — see the header and
// issues/congruence-by-anti-unification.md. The *declaration* is entirely
// ordinary: nothing about it knows how its argument is found, which is what
// keeps the eventual layer-m tactic a producer of calls to this very lemma.
theorem cong<A, B>({f: A -> B}, {a: A}, {b: A}, p: a = b): f(a) = f(b) {
    j(p, λ y q => f(a) = f(y), refl)
}

+                        loop_later_stop_extends(x, blocks, calls, inner, parameters, exit, next,
+                            λ rest st m io l aft _ rn => inner.run_extends(blocks, calls, extends, rest, fr.start, fr.inside, Config(l, m, io), aft, fr.body, rn),
+                            λ rest m io l g => inner.stop_extends(blocks, calls, extends, stops, rest, fr.start, fr.inside, Config(l, m, io), x, fr.body, g), fuel),
+                        one.witness, c.memory, c.io, going),
+                    Inr(two) => false_elim(Ran::done_not_stopped<Locals, Config>(bind_values(outputs, two.witness.state, c.locals), two.witness.io,
+                        λ (l: Locals) => Config(l, two.witness.memory, two.witness.io), x, two.proof.right)),
+                },
+            }
+        },
+        Sys(call) => λ used used2 c x fresh ran => false_elim(absurd(trans(sym(ran), call.stopped_none(blocks, c)))),
+        Exit(status) => λ used used2 c x fresh ran => j(Option::some_inj(StopExited(c.locals.word(status), c.io), x, ran), λ y _ => Extends(y.world().past, c.io.past),
+            extends_refl(c.io.past)),
+    }
+}

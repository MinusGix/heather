+theorem pass_stop_extends(x: Stop, Pass: Valuation() → Now → Now → Type, PassStops: Valuation() → Nat → Now → Type,
+    grows: (v: Valuation()) → (from, to: Now) → Pass(v, from, to) → Extends(to.io.past, from.io.past),
+    stops: (v: Valuation()) → (k: Nat) → (from: Now) → PassStops(v, k, from) → Extends(x.world().past, from.io.past),
+    parameters: List<Typed>, exit: Nat, next: List<Typed>, zero: Now → Type, zeroes: (now: Now) → zero(now) → Extends(x.world().past, now.io.past),
+    fuel: Nat): (state: List<BitVec(64)>) → (from: Now) →
+    PassesStop(Pass, PassStops, parameters, exit, next, zero, fuel, state, from) → Extends(x.world().past, from.io.past) {
+    match fuel {
+        Zero => λ state from h => match h.proof.right {
+            Inl(going) => stops(h.witness, 0, from, going),
+            Inr(done) => extends_trans(x.world().past, done.witness.io.past, from.io.past, zeroes(done.witness, done.proof.right.right),
+                grows(h.witness, from, done.witness, done.proof.left)),
+        },
+        Succ(rest) => λ state from h => match h.proof.right {

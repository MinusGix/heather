+// The guarded callees of the routine being emitted, the room by routine,
+// and the stop's label.
+record CallGuards { at: List<Nat>, rooms: Nat → Nat, stop: Nat }
+
+fn CallGuards::none() → CallGuards { CallGuards([], λ (_: Nat) => 0, 0) }
+
+fn among(ids: List<Nat>, id: Nat) → Bool { match ids { Nil => False, Cons(x, rest) => x.same(id) || among(rest, id) } }
+
+fn CallGuards::guards(self g: CallGuards, callee: Nat) → Bool { among(g.at, callee) }
+
+// What a guarded call to `callee` needs below the frame: the table's own
+// term for a call, its 24 bytes (at most two words on the stack, which is
+// all FunctionIR's call passes there, and the return address) and the
+// callee's room (§17.10: the call's own count of stack words is
+// FunctionIR's, not visible where its CALL is proved, so the guard asks the
+// most any call asks).
+fn CallGuards::need(self g: CallGuards, callee: Nat) → Nat { 24 + g.rooms(callee) }
+

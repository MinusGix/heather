+// ---------------------------------------------------------------------------
+// The ceiling (docs/language/ownership-design.md §17.10, step 3)
+//
+// A routine's regions are proved at the escaping kernel: Linux, with the
+// out-of-room stop carried as a kernel step owing nothing after it
+// (`Kernel::escaping`), so FunctionIR's composition lemmas compose them as
+// they are. An escape spends a call, so a region's count cannot be the
+// exchanges its world gained; every region of one routine's proof is
+// counted instead to one ceiling, the world `top` no state of the run gets
+// past (the outcome's), and one more for the escape: `|top| + 1`. Each part
+// of a sequence, each arm and each pass is counted so, the sum read back to
+// it by `Site::claims_ceiling` (the escaping kernel's `escaping_ceiling`).
+// A region's facts carry that its world after is a prefix of `top`
+// (`Ceiling::Under`), and the escape that the stop's world is
+// (`Ceiling::Esc`).
+
+record Ceiling<M> { esc: Running<M, Io> → Type, top: Io }
+
+fn Ceiling::Esc<M>(self c: Ceiling<M>) → Running<M, Io> → Type { λ (t: Running<M, Io>) => c.esc(t) ∧ Extends(c.top.past, t.io.past) }
+
+fn Ceiling::count<M>(self c: Ceiling<M>) → Nat { c.top.past.len() + 1 }
+
+fn Ceiling::Under<M>(self c: Ceiling<M>, now: Now) → Type { Extends(c.top.past, now.io.past) }
+
+fn Site::ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>) → Kernel<M, Io> { site.linux_escaping(stack, c.Esc()) }
+
+theorem Ceiling::under_len<M>(self c: Ceiling<M>, now: Now, w: Io, same: w = now.io, under: c.Under(now)): w.past.len() <= c.top.past.len() {
+    j(sym(same), λ x _ => x.past.len() <= c.top.past.len(), extends_len(c.top.past, now.io.past, under))
+}
+
+// Under a later world, under an earlier one.
+theorem Ceiling::under_extends<M>(self c: Ceiling<M>, later, earlier: Now, under: c.Under(later), grown: Extends(later.io.past, earlier.io.past)):
+    c.Under(earlier) {
+    extends_trans(c.top.past, later.io.past, earlier.io.past, under, grown)
+}
+
+// Linux resumes wherever it does, at the escaping kernel.
+theorem Site::linux_in_ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>):
+    (r: Running<M, Io>) → (P: Running<M, Io> → Type) → site.linux_kernel(stack).resumes(r, P) → site.ceiling(stack, c).resumes(r, P) {
+    λ r P called => Inl(called)
+}
+
+// Any count, read back to the ceiling where every goal state is under it.
+theorem Site::claims_ceiling<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), c: Ceiling<M>, calls, least, from: Nat,
+    pre, goal: Running<M, Io> → Type, bounded: (r: Running<M, Io>) → pre(r) → (t: Running<M, Io>) → goal(t) → t.io.past.len() <= c.top.past.len(),
+    claims: site.Claims(stack.writes, site.ceiling(stack, c), calls, least, from, pre, goal)):
+    site.Claims(stack.writes, site.ceiling(stack, c), c.count(), least, from, pre, goal) {
+    λ r here resident held => site.escaping_ceiling(stack, goal, c.Esc(), c.top,
+        λ t reached => match reached {
+            Inl(g) => bounded(r, held, t, g),
+            Inr(e) => extends_len(c.top.past, t.io.past, e.right),
+        }, calls, least, r, c.count(), { let k: (c.count() = c.top.past.len() + 1) = refl; omega }, claims(r, here, resident, held))
+}
+
+// A claim whose goal is never reached claims any bound: every branch ends
+// where its kernel takes it.
+theorem Site::performs_never<M, W>(self site: Site<M>, writes: ByteWrites<M>, kernel: Kernel<M, W>, goal: Running<M, W> → Type,
+    never: (t: Running<M, W>) → goal(t) → False, calls: Nat): (least, more: Nat) → (from: Running<M, W>) →
+    site.Performs(writes, kernel, goal, calls, least, from) → site.Performs(writes, kernel, goal, calls, more, from) {
+    match calls {
+        Zero => λ least more from p => false_elim(never(Running(p.witness, from.io),
+            reach_goal<M, W>(goal, least, p.proof.witness, Running(p.witness, from.io), p.proof.proof.right).right)),
+        Succ(k) => λ least more from p => match p.proof.proof.right {
+            Inl(reach) => false_elim(never(Running(p.witness, from.io), reach_goal<M, W>(goal, least, p.proof.witness, Running(p.witness, from.io), reach).right)),
+            Inr(called) => Exists(p.witness, Exists(p.proof.witness, ⟨p.proof.proof.left, Inr(kernel.monotone(Running(p.witness, from.io),
+                λ (u: Running<M, W>) => site.Performs(writes, kernel, goal, k, least - p.proof.witness, u),
+                λ (u: Running<M, W>) => site.Performs(writes, kernel, goal, k, more - p.proof.witness, u),
+                λ u q => site.performs_never(writes, kernel, goal, never, k, least - p.proof.witness, more - p.proof.witness, u, q), called))⟩)),
+        },
+    }
+}
+
+// What a region's code proves: `EmitsClaim` at the heap and the world, at
+// the ceiling's kernel and count, no bound on steps, its world after under
+// the ceiling.
+fn EmitsNow<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
+    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted) → Type {
+    EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c), c.count(), 0,
+        values, d, s0, prog, file, facts ∧ c.Under(after), before, after, out)
+}
+
+fn MayEmitNow<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
+    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>) → Type {
+    out.All(λ (emitted: Emitted) => EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, emitted))
+}
+
+// Any count at the ceiling's kernel, read back to the ceiling.
+theorem emits_now_ceiling<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
+    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted, calls: Nat,
+    emits: EmitsClaim<M, Now, Io>(saves, site, stack, spans, now_in<M>(site.data, spans), NowWorld(), site.ceiling(stack, c), calls, 0, values, d, s0,
+        prog, file, facts ∧ c.Under(after), before, after, out)):
+    EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
+    ⟨emits.left, λ within => site.claims_ceiling(stack, c, calls, 0, prog_len(prog),
+        NowPre<M>(saves, site, stack, spans, values, d, s0, file, facts ∧ c.Under(after), before),
+        NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after),
+        λ r held t arrived => c.under_len(after, t.io, arrived.right.right.left, held.left.left.right.right), emits.right(within))⟩
+}
+
+// A region proved at Linux, at the ceiling: the kernel widened, the count
+// read back.
+theorem emits_now_of_linux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(), d: Nat,
+    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Emitted,
+    emits: EmitsLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, out)):
+    EmitsNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
+    let goal = NowPost<M>(saves, site, stack, spans, values, d, s0, prog_len(out.prog), out.file, after);
+    emits_now_ceiling<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out, calls_between(before, after),
+        ⟨emits.left, λ within r here resident held => site.performs_or_kernel(stack.writes, site.linux_kernel(stack), site.ceiling(stack, c), goal,
+            λ (_: Running<M, Io>) => False, site.linux_in_ceiling(stack, c), calls_between(before, after), 0, r,
+            emits.right(within)(r, here, resident, ⟨⟨⟨held.left.left.left, held.left.left.right.left⟩, held.left.right⟩, held.right⟩))⟩)
+}
+
+theorem may_emit_now_of_linux<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, c: Ceiling<M>, values: Valuation(),
+    d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Now, out: Option<Emitted>):
+    MayEmitLinux<M>(saves, site, stack, spans, values, d, s0, prog, file, facts, before, after, out) →
+    MayEmitNow<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, out) {
+    match out {
+        None => λ _ => trivial,
+        Some(e) => λ emits => emits_now_of_linux<M>(saves, site, stack, spans, c, values, d, s0, prog, file, facts, before, after, e, emits),
+    }
+}

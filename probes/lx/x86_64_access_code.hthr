// Effectful composition reuses pure StructuredCode leaves and their existing
// artifacts. Reads are relational: no byte is invented for a denied access.
import x86_64;
import x86_64_block;
import x86_64_structured_block;
import x86_64_data_read;
import bitvec;
import bool;
import list;
import logic;
import nat;

inductive AccessCode {
    AccessPure(code: StructuredCode),
    AccessRead(load: ByteLoad),
    AccessSequence(prefix: AccessCode, continuation: AccessCode),
    AccessBranch(register: Gpr, false_displacement: BitVec(8),
        join_displacement: BitVec(8), when_true: AccessCode, when_false: AccessCode),
    // A bounded loop (docs/native-bounded-loops-design.md §3). A zero `flag`
    // after the guard exits forward; after the body, a zero `step_flag`
    // (Continue) jumps back to the guard and a set one (Break) falls through
    // to the same exit. Both edges are near jumps.
    AccessLoop(guard: AccessCode, flag: Gpr, exit_displacement: BitVec(32),
        body: AccessCode, step_flag: Gpr, back_displacement: BitVec(32)),
}
fn access_bytes(code: AccessCode) → List<BitVec(8)> {
    match code {
        AccessPure(pure) => structured_bytes(pure),
        AccessRead(load) => byte_load_bytes(load),
        AccessSequence(prefix, tail) => access_bytes(prefix) ++ access_bytes(tail),
        AccessBranch(register, fd, jd, yes, no) =>
            canonical_bytes(TestRR(register, register)) ++ short_control_bytes(JumpZero(fd)) ++
            access_bytes(yes) ++ short_control_bytes(Jump(jd)) ++ access_bytes(no),
        AccessLoop(guard, flag, ed, body, step, bd) =>
            access_bytes(guard) ++ canonical_bytes(TestRR(flag, flag)) ++
            near_control_bytes(JumpZeroNear(ed)) ++ access_bytes(body) ++
            canonical_bytes(TestRR(step, step)) ++ near_control_bytes(JumpZeroNear(bd)),
    }
}
fn AccessLayout(code: AccessCode) → Type {
    match code {
        AccessPure(pure) => StructuredLayout(pure),
        AccessRead(_) => True,
        AccessSequence(prefix, tail) => AccessLayout(prefix) ∧ AccessLayout(tail),
        AccessBranch(_, fd, jd, yes, no) =>
            ((start: BitVec(64)) → short_branch_target(start, fd) = next_rip(start, 2 + (access_bytes(yes).len() + 2))) ∧
            (((start: BitVec(64)) → short_branch_target(start, jd) = next_rip(start, 2 + access_bytes(no).len())) ∧
            (AccessLayout(yes) ∧ AccessLayout(no))),
        // The exit edge skips the body, its TEST (3) and the back edge (6);
        // the back edge, starting after the guard, the forward edge's TEST
        // and JZ (9), the body and its TEST, returns to the loop's start.
        AccessLoop(guard, _, ed, body, _, bd) =>
            ((start: BitVec(64)) → near_branch_target(start, 6, ed) =
                next_rip(start, 6 + (access_bytes(body).len() + 9))) ∧
            (((start: BitVec(64)) → near_branch_target(
                next_rip(start, access_bytes(guard).len() + 9 + access_bytes(body).len() + 3), 6, bd) = start) ∧
            (AccessLayout(guard) ∧ AccessLayout(body))),
    }
}
// Generated layouts are stated through these over the children's codes and
// layouts. A tuple checked against AccessLayout of a literal code tree makes
// the elaborator spell the tree's reduct, which the kernel pays for per
// constructor (issues/fast-lane-heaviest-declarations.md).
theorem access_sequence_layout(prefix, tail: AccessCode,
    prefix_layout: AccessLayout(prefix), tail_layout: AccessLayout(tail)):
    AccessLayout(AccessSequence(prefix, tail)) {
    ⟨prefix_layout, tail_layout⟩
}
theorem access_branch_layout(register: Gpr, fd, jd: BitVec(8), yes, no: AccessCode,
    false_target: (start: BitVec(64)) → short_branch_target(start, fd) = next_rip(start, 2 + (access_bytes(yes).len() + 2)),
    join_target: (start: BitVec(64)) → short_branch_target(start, jd) = next_rip(start, 2 + access_bytes(no).len()),
    yes_layout: AccessLayout(yes), no_layout: AccessLayout(no)):
    AccessLayout(AccessBranch(register, fd, jd, yes, no)) {
    ⟨false_target, ⟨join_target, ⟨yes_layout, no_layout⟩⟩⟩
}
theorem access_loop_layout(guard: AccessCode, flag: Gpr, ed: BitVec(32), body: AccessCode,
    step: Gpr, bd: BitVec(32),
    exit_target: (start: BitVec(64)) → near_branch_target(start, 6, ed) =
        next_rip(start, 6 + (access_bytes(body).len() + 9)),
    back_target: (start: BitVec(64)) → near_branch_target(
        next_rip(start, access_bytes(guard).len() + 9 + access_bytes(body).len() + 3), 6, bd) = start,
    guard_layout: AccessLayout(guard), body_layout: AccessLayout(body)):
    AccessLayout(AccessLoop(guard, flag, ed, body, step, bd)) {
    ⟨exit_target, ⟨back_target, ⟨guard_layout, body_layout⟩⟩⟩
}

// TEST then JZ rel32: the state either edge of a loop leaves.
fn loop_edge<M>(register: Gpr, displacement: BitVec(32), before: MachineState<M>) → MachineState<M> {
    execute_near_control(JumpZeroNear(displacement), structured_test(register, before))
}

// `n` counts the iterations that jump back; the last iteration stops, either
// at the guard or by falling through after the body. The child relations are
// arguments, so ExecuteAccess stays structural over the code tree.
fn LoopRuns<M>(guard, body: MachineState<M> → MachineState<M> → Type, flag: Gpr,
    exit: BitVec(32), step: Gpr, back: BitVec(32), n: Nat) → MachineState<M> → MachineState<M> → Type {
    match n {
        Zero => λ before after => Exists<MachineState<M>>(λ tested => guard(before, tested) ∧
            match structured_test(flag, tested).flags.zf {
                True => after = loop_edge(flag, exit, tested),
                False => Exists<MachineState<M>>(λ done => body(loop_edge(flag, exit, tested), done) ∧
                    ((structured_test(step, done).flags.zf = False) ∧ (after = loop_edge(step, back, done)))),
            }),
        Succ(k) => λ before after => Exists<MachineState<M>>(λ tested => guard(before, tested) ∧
            ((structured_test(flag, tested).flags.zf = False) ∧
            Exists<MachineState<M>>(λ done => body(loop_edge(flag, exit, tested), done) ∧
                ((structured_test(step, done).flags.zf = True) ∧
                LoopRuns(guard, body, flag, exit, step, back, k, loop_edge(step, back, done), after))))),
    }
}

fn ExecuteAccess<M>(access: ByteReadAccess<M>, code: AccessCode) → MachineState<M> → MachineState<M> → Type {
    match code {
        AccessPure(pure) => λ before after => ExecuteStructured(pure, before, after),
        AccessRead(load) => λ before after => Exists<BitVec(8)>(λ byte => ByteLoadStep<M>(access, load, byte, before, after)),
        AccessSequence(prefix, tail) => λ before after => Exists<MachineState<M>>(λ middle =>
            ExecuteAccess(access, prefix, before, middle) ∧ ExecuteAccess(access, tail, middle, after)),
        AccessBranch(register, fd, jd, yes, no) => λ before after =>
            match structured_test(register, before).flags.zf {
                False => Exists<MachineState<M>>(λ middle =>
                    ExecuteAccess(access, yes, structured_branch_entry(register, fd, before), middle) ∧
                    (after = execute_short_control(Jump(jd), middle))),
                True => ExecuteAccess(access, no, structured_branch_entry(register, fd, before), after),
            },
        AccessLoop(guard, flag, ed, body, step, bd) => λ before after => Exists<Nat>(λ n =>
            LoopRuns(ExecuteAccess(access, guard), ExecuteAccess(access, body), flag, ed, step, bd, n, before, after)),
    }
}

// The three ways an iteration ends, from the actual TEST flags.
theorem loop_runs_exit<M>(guard, body: MachineState<M> → MachineState<M> → Type, flag: Gpr,
    exit: BitVec(32), step: Gpr, back: BitVec(32), before, tested: MachineState<M>,
    checked: guard(before, tested), selected: structured_test(flag, tested).flags.zf = True):
    LoopRuns(guard, body, flag, exit, step, back, 0, before, loop_edge(flag, exit, tested)) {
    Exists(tested, ⟨checked, j(sym(selected), λ zf _ => match zf {
        True => loop_edge(flag, exit, tested) = loop_edge(flag, exit, tested),
        False => Exists<MachineState<M>>(λ done => body(loop_edge(flag, exit, tested), done) ∧
            ((structured_test(step, done).flags.zf = False) ∧ (loop_edge(flag, exit, tested) = loop_edge(step, back, done)))),
    }, refl)⟩)
}
theorem loop_runs_break<M>(guard, body: MachineState<M> → MachineState<M> → Type, flag: Gpr,
    exit: BitVec(32), step: Gpr, back: BitVec(32), before, tested, done: MachineState<M>,
    checked: guard(before, tested), entered: structured_test(flag, tested).flags.zf = False,
    stepped: body(loop_edge(flag, exit, tested), done), broke: structured_test(step, done).flags.zf = False):
    LoopRuns(guard, body, flag, exit, step, back, 0, before, loop_edge(step, back, done)) {
    Exists(tested, ⟨checked, j(sym(entered), λ zf _ => match zf {
        True => loop_edge(step, back, done) = loop_edge(flag, exit, tested),
        False => Exists<MachineState<M>>(λ last => body(loop_edge(flag, exit, tested), last) ∧
            ((structured_test(step, last).flags.zf = False) ∧ (loop_edge(step, back, done) = loop_edge(step, back, last)))),
    }, Exists(done, ⟨stepped, ⟨broke, refl⟩⟩))⟩)
}
theorem loop_runs_continue<M>(guard, body: MachineState<M> → MachineState<M> → Type, flag: Gpr,
    exit: BitVec(32), step: Gpr, back: BitVec(32), k: Nat, before, tested, done, after: MachineState<M>,
    checked: guard(before, tested), entered: structured_test(flag, tested).flags.zf = False,
    stepped: body(loop_edge(flag, exit, tested), done), continued: structured_test(step, done).flags.zf = True,
    rest: LoopRuns(guard, body, flag, exit, step, back, k, loop_edge(step, back, done), after)):
    LoopRuns(guard, body, flag, exit, step, back, Succ(k), before, after) {
    Exists(tested, ⟨checked, ⟨entered, Exists(done, ⟨stepped, ⟨continued, rest⟩⟩)⟩⟩)
}

// The selected equality comes from the actual TEST/JZ flags. Neither helper
// asks for execution or access evidence for the unselected arm.
theorem access_branch_true<M>(access: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(8),
    yes, no: AccessCode, before, middle: MachineState<M>,
    selected: structured_test(register, before).flags.zf = False,
    step: ExecuteAccess(access, yes, structured_branch_entry(register, fd, before), middle)):
    ExecuteAccess(access, AccessBranch(register, fd, jd, yes, no), before, execute_short_control(Jump(jd), middle)) {
    j(sym(selected), λ flag _ => match flag {
        False => Exists<MachineState<M>>(λ next => ExecuteAccess(access, yes, structured_branch_entry(register, fd, before), next) ∧
            (execute_short_control(Jump(jd), middle) = execute_short_control(Jump(jd), next))),
        True => ExecuteAccess(access, no, structured_branch_entry(register, fd, before), execute_short_control(Jump(jd), middle)),
    }, Exists(middle, ⟨step, refl⟩))
}
theorem access_branch_false<M>(access: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(8),
    yes, no: AccessCode, before, after: MachineState<M>,
    selected: structured_test(register, before).flags.zf = True,
    step: ExecuteAccess(access, no, structured_branch_entry(register, fd, before), after)):
    ExecuteAccess(access, AccessBranch(register, fd, jd, yes, no), before, after) {
    j(sym(selected), λ flag _ => match flag {
        False => Exists<MachineState<M>>(λ middle => ExecuteAccess(access, yes, structured_branch_entry(register, fd, before), middle) ∧
            (after = execute_short_control(Jump(jd), middle))),
        True => ExecuteAccess(access, no, structured_branch_entry(register, fd, before), after),
    }, step)
}

// Published bytes are checked against the recursive encoding. Child pure
// artifacts provide their own decoding; memory operands have canonical exact
// decoding in byte_load_bytes. Layout remains independent of execution.
record AccessArtifact<M>(access: ByteReadAccess<M>, code: AccessCode,
    bytes: List<BitVec(8)>, before, after: MachineState<M>) {
    encoding: bytes = access_bytes(code),
    layout: AccessLayout(code),
    execution: ExecuteAccess(access, code, before, after),
}

theorem access_sequence<M>(access: ByteReadAccess<M>, prefix, tail: AccessCode,
    before, middle, after: MachineState<M>, first: ExecuteAccess(access, prefix, before, middle),
    second: ExecuteAccess(access, tail, middle, after)):
    ExecuteAccess(access, AccessSequence(prefix, tail), before, after) {
    Exists(middle, ⟨first, second⟩)
}

theorem access_read_then<M>(access: ByteReadAccess<M>, load: ByteLoad, byte: BitVec(8),
    code: StructuredCode, bytes: List<BitVec(8)>, before: MachineState<M>,
    output: Gpr, result: BitVec(64), protected: Gpr → Type,
    artifact: ReadThenArtifact<M>(access, load, byte, code, bytes, before, output, result, protected)):
    ExecuteAccess(access, AccessSequence(AccessRead(load), AccessPure(code)), before, artifact.continuation.after) {
    access_sequence(access, AccessRead(load), AccessPure(code), before, byte_load_after(load, byte, before),
        artifact.continuation.after, Exists(byte, artifact.load_step), artifact.continuation.execution)
}

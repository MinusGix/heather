// The real library `Certified` — a telescoped dependent record whose third
// value parameter is FUNCTION-typed (`relation`) — read through 1/2/3 chained
// receivers. This is the shape `calc_parser::close_body` is made of, and the
// one the design's hole-matcher has to place.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

inductive QTok { QA, QB }
fn QR(source: List<QTok>, begin: Cursor<QTok>(source), end: Cursor<QTok>(source), value: Nat) -> Type {
    nat::Le(begin.offset, end.offset)
}
fn qchain1(source: List<QTok>, begin: Cursor<QTok>(source),
    a: Certified<QTok,Nat>(source,begin,QR)) -> nat::Le(begin.offset, a.end.offset) {
    a.forward
}
fn qchain2(source: List<QTok>, begin: Cursor<QTok>(source),
    a: Certified<QTok,Nat>(source,begin,QR),
    b: Certified<QTok,Nat>(source,a.end,QR)) -> nat::Le(begin.offset, b.end.offset) {
    nat::le_trans(begin.offset, a.end.offset, b.end.offset, a.forward, b.forward)
}
fn qchain3(source: List<QTok>, begin: Cursor<QTok>(source),
    a: Certified<QTok,Nat>(source,begin,QR),
    b: Certified<QTok,Nat>(source,a.end,QR),
    c: Certified<QTok,Nat>(source,b.end,QR)) -> nat::Le(begin.offset, c.end.offset) {
    nat::le_trans(begin.offset, a.end.offset, c.end.offset, a.forward,
        nat::le_trans(a.end.offset, b.end.offset, c.end.offset, b.forward, c.forward))
}
fn qev3(source: List<QTok>, begin: Cursor<QTok>(source),
    a: Certified<QTok,Nat>(source,begin,QR),
    b: Certified<QTok,Nat>(source,a.end,QR),
    c: Certified<QTok,Nat>(source,b.end,QR)) -> QR(source, b.end, c.end, c.value) {
    c.evidence
}

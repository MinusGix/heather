import logic;
import nat;
record Grammar(level: Nat, value: Nat) { at_level: level = level, }
fn takes<A>(rel: Nat -> A -> Type, a: A) -> Type { rel(0, a) }
fn takes1<A>(rel: A -> Type, a: A) -> Type { rel(a) }
fn explicit_bare() -> Type { takes<Nat>(Grammar, 1) }
fn explicit_prefix() -> Type { takes1<Nat>(Grammar(0), 1) }
fn inferred_bare() -> Type { takes(Grammar, 1) }
fn inferred_prefix() -> Type { takes1(Grammar(0), 1) }
fn GrammarSpec(level: Nat, value: Nat) -> Type { Grammar(level, value) }
fn inferred_wrapper() -> Type { takes1(GrammarSpec(0), 1) }
fn later_arg_first<A>(a: A, rel: A -> Type) -> Type { rel(a) }
fn inferred_after() -> Type { later_arg_first(1, Grammar(0)) }

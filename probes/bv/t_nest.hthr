import logic;
import bool;
import nat;
import bitvec;
record R(n: Nat) { x: Nat, p: x = n }
fn R::mk({n: Nat}) → R(n) { R(x := n, p := refl) }
fn R::bump({n: Nat}, self r: R(n)) → R(n) { r }
fn q1(n: Nat, y: BitVec(n)) → BitVec(n) { BitVec::band(BitVec::iterate_increment(BitVec::zero(), 3), y) }
fn q2(n: Nat) → R(n) { R::bump(R::bump(R::mk())) }
fn q3(n: Nat, y: BitVec(n)) → BitVec(n) { BitVec::zero().iterate_increment(3).band(y) }
fn q4(n: Nat) → R(n) { R::mk().bump().bump() }
fn q5(y: BitVec(8)) → BitVec(8) { BitVec::zero().band(y) }
// negative: nothing pins the width
fn z1() → Nat { BitVec::toNat(BitVec::iterate_increment(BitVec::zero(), 3)) }

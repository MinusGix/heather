import logic;
import bool;
import nat;
import list;
import char;
import bitvec;
theorem l_nat(): Cons(1, Cons(2, Nil)) = Cons(1, Cons(2, Nil)) { decide }
theorem l_nat_ne(): ¬(Cons(1, Cons(2, Nil)) = Cons(1, Cons(3, Nil))) { decide }
theorem l_char(): Cons('a', Nil) = Cons('a', Nil) { decide }
theorem l_nested(): Cons(Cons(1, Nil), Nil) = Cons(Cons(1, Nil), Nil) { decide }
theorem bv_lt(): BitVec::unsigned_lt(BitVec::ofNat(3, n := 8), BitVec::ofNat(5)) { decide }
theorem bv_le(): BitVec::signed_le(BitVec::ofNat(5, n := 8), BitVec::ofNat(5)) { decide }

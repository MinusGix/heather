import logic;
import bool;
import nat;
import list;
import bitvec;

record R(n: Nat) { x: Nat, p: x = n }
fn R::mk({n: Nat}) → R(n) { R(x := n, p := refl) }
fn R::get({n: Nat}, self r: R(n)) → Nat { r.x }
fn r00(n: Nat, r: R(n)) → Nat { r.get() }
fn r01() → Nat { R::mk().get() }
fn r02(n: Nat) → Nat { R::mk(n := n).get() }
fn r03(n: Nat) → R(n) { R::mk() }

record V(n: Nat) { bits: [Bool; n] }
fn V::mk({n: Nat}) → V(n) { V(bits := BitVec::zero(n := n).bits) }
fn V::get({n: Nat}, self r: V(n)) → Nat { 0 }
fn v00(n: Nat, r: V(n)) → Nat { r.get() }
fn v01(n: Nat) → Nat { V::mk(n := n).get() }
fn v02() → Nat { V::mk().get() }

inductive W(n: Nat) { WK(Nat) }
fn W::mk({n: Nat}) → W(n) { WK(0) }
fn W::get({n: Nat}, self w: W(n)) → Nat { 0 }
fn w01() → Nat { W::mk().get() }

fn l02() → Nat { Nil.len() }
fn l04(xs: List<Nat>) → Nat { Nil.append(xs).len() }

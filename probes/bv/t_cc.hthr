import logic;
import nat;
import list;
theorem cc({l, r: Nat}, {lt, rt: List<Nat>}, h: l = r, t: lt = rt): Cons(l, lt) = Cons(r, rt) {
    j(t, λ z _ => Cons(l, lt) = Cons(r, z), j(h, λ z _ => Cons(l, lt) = Cons(z, lt), refl))
}
fn two() → List<Nat> { Cons(1, Cons(2, Nil)) }
fn tail2() → List<Nat> { Cons(2, Nil) }
theorem t0(): Cons(1, Cons(2, Nil)) = Cons(1, Cons(2, Nil)) { cc(refl, cc(refl, refl)) }
theorem t1(): Cons(1, Cons(2, Nil)) = two() { cc(refl, cc(refl, refl), rt := tail2()) }
theorem t2(): Cons(1, Cons(2, Nil)) = two() { cc(refl, cc(refl, refl, rt := Nil), rt := tail2()) }
theorem t3(): Cons(2, Nil) = tail2() { cc(refl, refl, rt := Nil) }

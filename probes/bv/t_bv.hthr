import logic;
import bool;
import nat;
import list;
import bitvec;

// c: controls, width from the expected type in checking position
fn c01(n: Nat) → BitVec(n) { BitVec::zero() }
fn c03(y: Bool) → BitVec(3) { BitVec::from_bits([y, False, True]) }

// A: unpinned receiver, result pinned by expected type
fn a01(n: Nat) → BitVec(n) { (BitVec::zero()).iterate_increment(3) }
fn a02(n: Nat) → BitVec(n) { BitVec::zero().iterate_increment(3) }

// B: width only from a vector literal's length, no expected type
fn b01(y: Bool) → Type { BitVec::from_bits([y, False, True]) = BitVec::from_bits([False, False, True]) }
fn b02(y: Bool) → Type { BitVec::from_bits([y, False, True]) = @BitVec::from_bits(3, [False, False, True]) }

// C: concat, sum width against expected type
fn c04(p: BitVec(7)) → BitVec(8) { BitVec::concat(p, BitVec::from_bits([False])) }
fn c05(p: BitVec(7)) → BitVec(8) { p.concat(BitVec::from_bits([False])) }

// D: annotated let
fn d01(code: Nat) → Nat { let p: BitVec(11) = BitVec::ofNat(code); p.toNat() }

// E: head_bit at a width whose Succ is under +
fn e01(m, k: Nat, x: BitVec(m + Succ(k))) → Bool { x.head_bit() }
fn e02(m, k: Nat, x: BitVec(m + Succ(k))) → Bool { BitVec::head_bit(x) }

// F: polymorphic function as an argument
fn use_dec(d: (x, y: BitVec(8)) → x = y ∨ x ≠ y) → Nat { 0 }
fn f01() → Nat { use_dec(BitVec::eq_dec) }
fn use_dec2<A>(d: (x, y: A) → x = y ∨ x ≠ y, a: A) → Nat { 0 }
fn f02(b: BitVec(8)) → Nat { use_dec2(BitVec::eq_dec, b) }

// G: sign_extend, ?n + 56 against 64
fn g01() → BitVec(64) { BitVec::sign_extend(56, BitVec::ofNat(8)) }

// H: cons_bit_cong without @, checking and inference positions
theorem h01(n: Nat, x, y: BitVec(n), e: x = y): x.cons_bit(True) = y.cons_bit(True) { BitVec::cons_bit_cong(n, refl, e) }
theorem h02(n: Nat, x, y: BitVec(n), e: x = y): x.cons_bit(True) = y.cons_bit(True) { trans(BitVec::cons_bit_cong(n, refl, e), refl) }

// I: genuinely unconstrained width; named argument instead of @
fn i01(n: Nat) → Type { BitVec::zero().band(BitVec::zero()) = @BitVec::zero(n) }
fn i02(n: Nat) → Type { BitVec::zero(n := n).band(BitVec::zero()) = BitVec::zero() }
fn i03(n: Nat, x: Nat) → Type { BitVec::ofNat(x, n := n).toNat() = x }

// J: Decide instance head
fn my_lt({n: Nat}, self a, b: BitVec(n)) → Type { a.toNat() < b.toNat() }
instance(n: Nat, a, b: BitVec(n)) Decide<my_lt(a, b)> { dec := BitVec::unsigned_lt_dec(a, b) }

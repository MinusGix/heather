import bitvec;
import bool;
import logic;
import nat;
import list;
import omega;

fn digit(d: Nat) → BitVec(8) { BitVec::ofNat(48 + d) }

theorem div10_lt(n: Nat, big: 10 <= n): n.div(10) < n { omega }

// The decimal digits of `n`, most significant first.
fn decimal(n: Nat) → List<BitVec(8)> decreases n {
    match Nat::le_dec(10, n) {
        Inl(big) => decimal(n.div(10)) ++ [digit(n.mod(10))],
        Inr(_) => [digit(n)],
    }
    on ?dec1 := div10_lt(n, big);
}

theorem d7(): decimal(7) = [digit(7)] { refl }
theorem d42(): decimal(42) = [digit(4), digit(2)] { refl }
theorem unfold_check(n: Nat): decimal(n) = (match Nat::le_dec(10, n) { Inl(big) => decimal(n.div(10)) ++ [digit(n.mod(10))], Inr(_) => [digit(n)] }) { decimal_unfold(n) }

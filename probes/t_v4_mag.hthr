// V4 (design §8.4): the respelling's magnitude behaviour at the workload's
// REAL ofNat(64, ·) arguments — 0..8 at 205 of 218 sites, and the three
// addresses at the rest. If a mid-magnitude argument is worse than either of
// §4.3's two measured points, `half`'s classification has a window the design
// did not see. Fresh --cache-dir (probes/README.md).

import bitvec;
import bool;
import nat;

fn odd_bit(n: Nat) → Bool {
    match n { Zero => False, Succ(k) => match k { Zero => True, Succ(l) => odd_bit(l) } }
}

fn ofNatH(n: Nat) → Nat → bitvec::BitVec(n) {
    match n as λ k => Nat → bitvec::BitVec(k) {
        Zero => λ x => bitvec::from_bits(0, []),
        Succ(k, ih) => λ x => bitvec::cons_bit(k, odd_bit(x), ih(nat::half(x))),
    }
}

theorem v4_half_401000(): ofNatH(64, 4198400) = bitvec::from_bits(64, [False, False, False, False, False, False, False, False, False, False, False, False, True, False, False, False, False, False, False, False, False, False, True, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False]) { refl }


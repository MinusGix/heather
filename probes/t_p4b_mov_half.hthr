// P4b: the P4 item with every bitvec::ofNat replaced by the respelled
// ofNatH (low bit by parity, rest at half) — the candidate-2 library step,
// hand-run. canonical_bytes itself still uses the shipped ofNat for the REX
// and opcode bytes, so this UNDERSTATES the respelling by two ofNat(8, .).
// Compare against t_p4_mov_imm64.hthr's p4_mov_ofnat / p4_mov_lit.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import x86_64;
import bitvec;
import bool;
import nat;
import list;

fn odd_bit(n: Nat) → Bool {
    match n { Zero => False, Succ(k) => match k { Zero => True, Succ(l) => odd_bit(l) } }
}

fn ofNatH(n: Nat) → Nat → bitvec::BitVec(n) {
    match n as λ k => Nat → bitvec::BitVec(k) {
        Zero => λ x => bitvec::from_bits(0, []),
        Succ(k, ih) => λ x => bitvec::cons_bit(k, odd_bit(x), ih(nat::half(x))),
    }
}

theorem p4b_mov_half(): x86_64::canonical_bytes(MovRI(R9, ofNatH(64, 0x123456789abcdef))) = [x86_64::rex_w_ri(R9), x86_64::mov_ri_opcode(R9), ofNatH(8, 0xef), ofNatH(8, 0xcd), ofNatH(8, 0xab), ofNatH(8, 0x89), ofNatH(8, 0x67), ofNatH(8, 0x45), ofNatH(8, 0x23), ofNatH(8, 0x1)] { refl }

theorem p4b_mov_half_lit(): x86_64::canonical_bytes(MovRI(R9, ofNatH(64, 0x123456789abcdef))) = [x86_64::rex_w_ri(R9), x86_64::mov_ri_opcode(R9), bitvec::from_bits(8, [True, True, True, True, False, True, True, True]), bitvec::from_bits(8, [True, False, True, True, False, False, True, True]), bitvec::from_bits(8, [True, True, False, True, False, True, False, True]), bitvec::from_bits(8, [True, False, False, True, False, False, False, True]), bitvec::from_bits(8, [True, True, True, False, False, True, True, False]), bitvec::from_bits(8, [True, False, True, False, False, False, True, False]), bitvec::from_bits(8, [True, True, False, False, False, True, False, False]), bitvec::from_bits(8, [True, False, False, False, False, False, False, False])] { refl }

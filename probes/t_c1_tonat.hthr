// C1: toNat of a literal — the consumer into Nat.
// Probe file for docs/native-bitvector-values-design.md §2.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import bitvec;
import bool;
import nat;

theorem c1_tonat_8(): bitvec::toNat(8, bitvec::from_bits(8, [True, False, True, False, True, False, True, False])) = 85 { refl }

theorem c1_tonat_16(): bitvec::toNat(16, bitvec::from_bits(16, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False])) = 21845 { refl }

theorem c1_tonat_32(): bitvec::toNat(32, bitvec::from_bits(32, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False])) = 1431655765 { refl }

theorem c1_tonat_64(): bitvec::toNat(64, bitvec::from_bits(64, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False])) = 6148914691236517205 { refl }

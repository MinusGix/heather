fn V0(values: Valuation(), width: Nat) → BitVec(width) { values(width, 0) }
fn a1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 65535) }
fn b1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, V0(values, width), a1(values, width)) }
fn c1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 8) }
fn d1(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => @bitvec::BitVec::cons_bit(k, @bitvec::BitVec::unsigned_lt_bit(64, b1(values, 64), c1(values, 64)), @bitvec::BitVec::zero(k)) } }
fn t1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::bor(width, @bitvec::BitVec::ofNat(width, 0), V0(values, width)) }
fn s1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::sub(width, V0(values, width), @bitvec::BitVec::ofNat(width, 8)) }
fn f1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s1(values, width), @bitvec::BitVec::ofNat(width, 1000)) }
fn V1(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, d1(values, 1)) { False => f1(values, width), True => t1(values, width) } }

fn valuation(values: Valuation()) → Valuation() { λ width id => match id { Zero => values(width, 0), Succ(id_1) => match id_1 { Zero => @bitvec::BitVec::zero(width), Succ(id_2) => match id_2 { Zero => @bitvec::BitVec::zero(width), Succ(id_3) => match id_3 { Zero => @bitvec::BitVec::zero(width), Succ(id_4) => match id_4 { Zero => @bitvec::BitVec::zero(width), Succ(id_5) => match id_5 { Zero => V8(values, width), Succ(id_6) => match id_6 { Zero => a9(values, width), Succ(id_7) => match id_7 { Zero => b9(values, width), Succ(id_8) => match id_8 { Zero => c9(values, width), Succ(id_9) => match id_9 { Zero => d9(values, width), Succ(id_10) => @bitvec::BitVec::zero(width) } } } } } } } } } } }
fn raw() → Region { Region(inputs := Ports([Port(id := 0, width := 64), Port(id := 5, width := 64)]), nodes := [Const(width := 64, output := 6, value := 65535), BitAnd(width := 64, output := 7, left := 5, right := 6), Const(width := 64, output := 8, value := 400), UnsignedLessThan(width := 64, output := 9, left := 7, right := 8)], outputs := Ports([Port(id := 9, width := 1)])) }
theorem graph(values: Valuation()): RegionHolds(raw(), valuation(values)) { ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩ }

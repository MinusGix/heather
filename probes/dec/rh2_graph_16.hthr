fn d16(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => match k as λ m => BitVec(Succ(m)) { Zero => bitvec::BitVec::ofBool(@bitvec::BitVec::unsigned_lt_bit(64, b16(values, 64), c16(values, 64))), Succ(j) => @bitvec::BitVec::cons_bit(Succ(j), @bitvec::BitVec::unsigned_lt_bit(64, b16(values, 64), c16(values, 64)), @bitvec::BitVec::zero(Succ(j))) } } }
fn t16(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::bor(width, @bitvec::BitVec::ofNat(width, 0), V15(values, width)) }
fn s16(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::sub(width, V15(values, width), @bitvec::BitVec::ofNat(width, 113)) }
fn f16(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s16(values, width), @bitvec::BitVec::ofNat(width, 16000)) }
fn V16(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, d16(values, 1)) { False => f16(values, width), True => t16(values, width) } }
fn a17(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 65535) }
fn b17(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, V16(values, width), a17(values, width)) }
fn c17(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 400) }
fn d17(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => match k as λ m => BitVec(Succ(m)) { Zero => bitvec::BitVec::ofBool(@bitvec::BitVec::unsigned_lt_bit(64, b17(values, 64), c17(values, 64))), Succ(j) => @bitvec::BitVec::cons_bit(Succ(j), @bitvec::BitVec::unsigned_lt_bit(64, b17(values, 64), c17(values, 64)), @bitvec::BitVec::zero(Succ(j))) } } }
fn valuation(values: Valuation()) → Valuation() { λ width id => match id { Zero => values(width, 0), Succ(id_1) => match id_1 { Zero => @bitvec::BitVec::zero(width), Succ(id_2) => match id_2 { Zero => @bitvec::BitVec::zero(width), Succ(id_3) => match id_3 { Zero => @bitvec::BitVec::zero(width), Succ(id_4) => match id_4 { Zero => @bitvec::BitVec::zero(width), Succ(id_5) => match id_5 { Zero => V16(values, width), Succ(id_6) => match id_6 { Zero => a17(values, width), Succ(id_7) => match id_7 { Zero => b17(values, width), Succ(id_8) => match id_8 { Zero => c17(values, width), Succ(id_9) => match id_9 { Zero => d17(values, width), Succ(id_10) => @bitvec::BitVec::zero(width) } } } } } } } } } } }
fn raw() → Region { Region(inputs := Ports([Port(id := 0, width := 64), Port(id := 5, width := 64)]), nodes := [Const(width := 64, output := 6, value := 65535), BitAnd(width := 64, output := 7, left := 5, right := 6), Const(width := 64, output := 8, value := 400), UnsignedLessThan(width := 64, output := 9, left := 7, right := 8)], outputs := Ports([Port(id := 9, width := 1)])) }
theorem graph(values: Valuation()): RegionHolds(raw(), valuation(values)) { ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩ }

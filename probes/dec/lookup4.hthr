fn S3(values: Valuation()) → BitVec(64) { place(S2(values), @bitvec::BitVec::ofNat(64, 3000), @bitvec::BitVec::ofNat(64, 196608)) }
fn S4(values: Valuation()) → BitVec(64) { place(S3(values), @bitvec::BitVec::ofNat(64, 4000), @bitvec::BitVec::ofNat(64, 262144)) }
fn S5(values: Valuation()) → BitVec(64) { place(S4(values), @bitvec::BitVec::ofNat(64, 5000), @bitvec::BitVec::ofNat(64, 327680)) }
fn S6(values: Valuation()) → BitVec(64) { place(S5(values), @bitvec::BitVec::ofNat(64, 6000), @bitvec::BitVec::ofNat(64, 393216)) }

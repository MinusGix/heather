import function_ir;
import bitvec;
import bool;
import nat;
import list;
import logic;
fn V0(values: Valuation(), width: Nat) → BitVec(width) { values(width, 0) }
fn a1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 65535) }
fn b1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, V0(values, width), a1(values, width)) }
fn c1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 8) }
fn d1(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => @bitvec::BitVec::cons_bit(k, @bitvec::BitVec::unsigned_lt_bit(64, b1(values, 64), c1(values, 64)), @bitvec::BitVec::zero(k)) } }
fn t1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::bor(width, @bitvec::BitVec::ofNat(width, 0), V0(values, width)) }
fn s1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::sub(width, V0(values, width), @bitvec::BitVec::ofNat(width, 8)) }
fn f1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s1(values, width), @bitvec::BitVec::ofNat(width, 1000)) }
fn V1(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, d1(values, 1)) { False => f1(values, width), True => t1(values, width) } }
fn a2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 65535) }
fn b2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, V1(values, width), a2(values, width)) }
fn c2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 15) }
fn d2(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => @bitvec::BitVec::cons_bit(k, @bitvec::BitVec::unsigned_lt_bit(64, b2(values, 64), c2(values, 64)), @bitvec::BitVec::zero(k)) } }
fn t2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::bor(width, @bitvec::BitVec::ofNat(width, 0), V1(values, width)) }
fn s2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::sub(width, V1(values, width), @bitvec::BitVec::ofNat(width, 15)) }
fn f2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s2(values, width), @bitvec::BitVec::ofNat(width, 2000)) }
fn V2(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, d2(values, 1)) { False => f2(values, width), True => t2(values, width) } }
fn a3(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 65535) }
fn b3(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, V2(values, width), a3(values, width)) }
fn c3(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::ofNat(width, 400) }
fn d3(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => @bitvec::BitVec::cons_bit(k, @bitvec::BitVec::unsigned_lt_bit(64, b3(values, 64), c3(values, 64)), @bitvec::BitVec::zero(k)) } }
fn valuation(values: Valuation()) → Valuation() { λ width id => match id { Zero => values(width, 0), Succ(id_1) => match id_1 { Zero => @bitvec::BitVec::zero(width), Succ(id_2) => match id_2 { Zero => @bitvec::BitVec::zero(width), Succ(id_3) => match id_3 { Zero => @bitvec::BitVec::zero(width), Succ(id_4) => match id_4 { Zero => @bitvec::BitVec::zero(width), Succ(id_5) => match id_5 { Zero => V2(values, width), Succ(id_6) => match id_6 { Zero => a3(values, width), Succ(id_7) => match id_7 { Zero => b3(values, width), Succ(id_8) => match id_8 { Zero => c3(values, width), Succ(id_9) => match id_9 { Zero => d3(values, width), Succ(id_10) => @bitvec::BitVec::zero(width) } } } } } } } } } } }
fn raw() → Region { Region(inputs := Ports([Port(id := 0, width := 64), Port(id := 5, width := 64)]), nodes := [Const(width := 64, output := 6, value := 65535), BitAnd(width := 64, output := 7, left := 5, right := 6), Const(width := 64, output := 8, value := 400), UnsignedLessThan(width := 64, output := 9, left := 7, right := 8)], outputs := Ports([Port(id := 9, width := 1)])) }
theorem n4(values: Valuation()): valuation(values)(1, 9) = bitvec::BitVec::ofBool(@bitvec::BitVec::unsigned_lt_bit(64, valuation(values)(64, 7), valuation(values)(64, 8))) { refl }

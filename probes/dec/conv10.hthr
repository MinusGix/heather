import bitvec;
import bool;
fn place(state, threshold, weight: BitVec(64)) → BitVec(64) {
    match state.band(BitVec::ofNat(0xffff)).unsigned_lt_bit(threshold) {
        True => state,
        False => state.sub(threshold).add(weight),
    }
}
fn chain(n: BitVec(64)) → BitVec(64) { place(place(place(place(place(place(place(place(place(place(n.add(BitVec::ofNat(0x0a303030300000)), BitVec::ofNat(8000), BitVec::ofNat(0x80000)), BitVec::ofNat(4000), BitVec::ofNat(0x40000)), BitVec::ofNat(2000), BitVec::ofNat(0x20000)), BitVec::ofNat(1000), BitVec::ofNat(0x10000)), BitVec::ofNat(800), BitVec::ofNat(0x8000000)), BitVec::ofNat(400), BitVec::ofNat(0x4000000)), BitVec::ofNat(200), BitVec::ofNat(0x2000000)), BitVec::ofNat(100), BitVec::ofNat(0x1000000)), BitVec::ofNat(80), BitVec::ofNat(0x800000000)), BitVec::ofNat(40), BitVec::ofNat(0x400000000)) }
fn v0(n: BitVec(64)) → BitVec(64) { n.add(BitVec::ofNat(0x0a303030300000)) }
fn v1(n: BitVec(64)) → BitVec(64) { match v0(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(8000)) { True => v0(n), False => v0(n).sub(BitVec::ofNat(8000)).add(BitVec::ofNat(0x80000)) } }
fn v2(n: BitVec(64)) → BitVec(64) { match v1(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(4000)) { True => v1(n), False => v1(n).sub(BitVec::ofNat(4000)).add(BitVec::ofNat(0x40000)) } }
fn v3(n: BitVec(64)) → BitVec(64) { match v2(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(2000)) { True => v2(n), False => v2(n).sub(BitVec::ofNat(2000)).add(BitVec::ofNat(0x20000)) } }
fn v4(n: BitVec(64)) → BitVec(64) { match v3(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(1000)) { True => v3(n), False => v3(n).sub(BitVec::ofNat(1000)).add(BitVec::ofNat(0x10000)) } }
fn v5(n: BitVec(64)) → BitVec(64) { match v4(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(800)) { True => v4(n), False => v4(n).sub(BitVec::ofNat(800)).add(BitVec::ofNat(0x8000000)) } }
fn v6(n: BitVec(64)) → BitVec(64) { match v5(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(400)) { True => v5(n), False => v5(n).sub(BitVec::ofNat(400)).add(BitVec::ofNat(0x4000000)) } }
fn v7(n: BitVec(64)) → BitVec(64) { match v6(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(200)) { True => v6(n), False => v6(n).sub(BitVec::ofNat(200)).add(BitVec::ofNat(0x2000000)) } }
fn v8(n: BitVec(64)) → BitVec(64) { match v7(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(100)) { True => v7(n), False => v7(n).sub(BitVec::ofNat(100)).add(BitVec::ofNat(0x1000000)) } }
fn v9(n: BitVec(64)) → BitVec(64) { match v8(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(80)) { True => v8(n), False => v8(n).sub(BitVec::ofNat(80)).add(BitVec::ofNat(0x800000000)) } }
fn v10(n: BitVec(64)) → BitVec(64) { match v9(n).band(BitVec::ofNat(0xffff)).unsigned_lt_bit(BitVec::ofNat(40)) { True => v9(n), False => v9(n).sub(BitVec::ofNat(40)).add(BitVec::ofNat(0x400000000)) } }
theorem expands(n: BitVec(64)): v10(n) = chain(n) { refl }

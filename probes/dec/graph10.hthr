fn f2(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s2(values, width), @bitvec::BitVec::ofNat(width, 200)) }
fn t2(values: Valuation(), width: Nat) → BitVec(width) { v1(values, width) }
fn v2(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, c2(values, 1)) { False => f2(values, width), True => t2(values, width) } }

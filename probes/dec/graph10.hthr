import logic;
fn v0(values: Valuation(), width: Nat) → BitVec(width) { values(width, 0) }
fn b1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::band(width, v0(values, width), @bitvec::BitVec::ofNat(width, 65535)) }
fn c1(values: Valuation(), width: Nat) → BitVec(width) { match width as λ n => BitVec(n) { Zero => @bitvec::BitVec::zero(0), Succ(k) => @bitvec::BitVec::cons_bit(k, @bitvec::BitVec::unsigned_lt_bit(64, b1(values, 64), @bitvec::BitVec::ofNat(64, 7)), @bitvec::BitVec::zero(k)) } }
fn s1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::sub(width, v0(values, width), @bitvec::BitVec::ofNat(width, 7)) }
fn f1(values: Valuation(), width: Nat) → BitVec(width) { @bitvec::BitVec::add(width, s1(values, width), @bitvec::BitVec::ofNat(width, 100)) }
fn t1(values: Valuation(), width: Nat) → BitVec(width) { v0(values, width) }
fn v1(values: Valuation(), width: Nat) → BitVec(width) { match @bitvec::BitVec::head_bit(0, c1(values, 1)) { False => f1(values, width), True => t1(values, width) } }

// Reduced reproducer: a value-parameterized dependent record (Certified's
// shape) read through chained receivers, one binder deeper per item.
import nat;
import list;
import logic;

record Cur<T>(source: List<T>) { identity: source = source, offset: Nat, within: nat::Le(offset, list_len(source)) }
fn Rel<T>(source: List<T>, begin,end: Cur<T>(source), value: Nat) -> Type { nat::Le(begin.offset, end.offset) }
record Cert<T>(source: List<T>, begin: Cur<T>(source)) {
    value: Nat,
    end: Cur<T>(source),
    forward: nat::Le(begin.offset, end.offset),
    evidence: Rel(source, begin, end, value),
}
fn chain1(source: List<Nat>, begin: Cur<Nat>(source), a: Cert<Nat>(source,begin)) -> nat::Le(begin.offset, a.end.offset) {
    a.forward
}

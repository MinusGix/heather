// cp4 — the FLOOR: no combinator in the conclusion at all, the same `match r`
// and the same two `Post`s. What a seven-line theorem over an open Reply
// costs when nothing is composed.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

theorem cp_floor<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,relation,r) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => h }
}

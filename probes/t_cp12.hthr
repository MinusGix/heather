// cp12 — `And<True, equation>`: the And with the relation conjunct replaced by `True`, the equation kept.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPTEq<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<True,rest(source,end) = Nil<T>>
}
theorem cp_teq<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPTEq<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(trivial,shape), Cons(head,tail) => trivial,
    } }
}

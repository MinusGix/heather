// The final OS boundary after an ordinary fetched x86 trace.
import linux_x86_64_entry;
import x86_64;
import x86_64_fetch;
import x86_64_fetch_block;
import bitvec;
import list;

fn linux_inline_instructions(body: List<Instruction>, left, right: BitVec(64)) →
    List<Instruction>
{
    linux_entry_instructions(left, right) ++ body ++ linux_exit_instructions()
}

record LinuxFetchedTrace<M>(access: FetchAccess<M>, instructions: List<Instruction>,
    before: MachineState<M>, result: BitVec(64))
{
    after: MachineState<M>,
    execution: ExecuteFetchedBlock(access, instructions, before, after),
    syscall_fetched: FetchedFrom(access, after.memory,
        InstructionBytes(after.rip, linux_syscall_bytes())),
    request: LinuxExitRequest<M>(after, result),
}

theorem linux_exit_request_at_equal_state<M>(before, after: MachineState<M>,
    result: BitVec(64), same: before = after, request: LinuxExitRequest<M>(before, result)):
    LinuxExitRequest<M>(after, result)
{
    j(same, λ state _ => LinuxExitRequest<M>(state, result), request)
}

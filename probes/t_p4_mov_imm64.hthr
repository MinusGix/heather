// P4: the shape the x86 model actually pays — canonical_bytes of a MOV
// with a 64-bit immediate (the reproducer of issues/bitvec-ofnat-large-literals).
// p4_mov_ofnat  : immediate spelled ofNat(64, k), bytes spelled ofNat(8, b)
//                 — exactly how lib/ and examples/x86-native spell it.
// p4_mov_lit    : the same instruction with every literal spelled from_bits
//                 — what candidate 1 (a packed vector literal) would reach.
// p4_mov_mixed  : ofNat immediate against from_bits bytes, to separate the
//                 two sides.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import x86_64;
import bitvec;
import bool;
import list;

theorem p4_mov_ofnat(): x86_64::canonical_bytes(MovRI(R9, bitvec::ofNat(64, 0x123456789abcdef))) = [x86_64::rex_w_ri(R9), x86_64::mov_ri_opcode(R9), bitvec::ofNat(8, 0xef), bitvec::ofNat(8, 0xcd), bitvec::ofNat(8, 0xab), bitvec::ofNat(8, 0x89), bitvec::ofNat(8, 0x67), bitvec::ofNat(8, 0x45), bitvec::ofNat(8, 0x23), bitvec::ofNat(8, 0x1)] { refl }

theorem p4_mov_lit(): x86_64::canonical_bytes(MovRI(R9, bitvec::from_bits(64, [True, True, True, True, False, True, True, True, True, False, True, True, False, False, True, True, True, True, False, True, False, True, False, True, True, False, False, True, False, False, False, True, True, True, True, False, False, True, True, False, True, False, True, False, False, False, True, False, True, True, False, False, False, True, False, False, True, False, False, False, False, False, False, False]))) = [x86_64::rex_w_ri(R9), x86_64::mov_ri_opcode(R9), bitvec::from_bits(8, [True, True, True, True, False, True, True, True]), bitvec::from_bits(8, [True, False, True, True, False, False, True, True]), bitvec::from_bits(8, [True, True, False, True, False, True, False, True]), bitvec::from_bits(8, [True, False, False, True, False, False, False, True]), bitvec::from_bits(8, [True, True, True, False, False, True, True, False]), bitvec::from_bits(8, [True, False, True, False, False, False, True, False]), bitvec::from_bits(8, [True, True, False, False, False, True, False, False]), bitvec::from_bits(8, [True, False, False, False, False, False, False, False])] { refl }

theorem p4_mov_mixed(): x86_64::canonical_bytes(MovRI(R9, bitvec::ofNat(64, 0x123456789abcdef))) = [x86_64::rex_w_ri(R9), x86_64::mov_ri_opcode(R9), bitvec::from_bits(8, [True, True, True, True, False, True, True, True]), bitvec::from_bits(8, [True, False, True, True, False, False, True, True]), bitvec::from_bits(8, [True, True, False, True, False, True, False, True]), bitvec::from_bits(8, [True, False, False, True, False, False, False, True]), bitvec::from_bits(8, [True, True, True, False, False, True, True, False]), bitvec::from_bits(8, [True, False, True, False, False, False, True, False]), bitvec::from_bits(8, [True, True, False, False, False, True, False, False]), bitvec::from_bits(8, [True, False, False, False, False, False, False, False])] { refl }

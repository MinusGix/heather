theorem chain_native_prefix_carry_at(values: Valuation(),
    s: BitVec(64)):
    chain_native_prefix_carry(values, s)(64, 15) = s
{
    refl
}

fn chain_native_prefix_code() → StructuredCode
{
    CodeSequence(chain_native_prefix_prefix_code(), chain_native_prefix_continuation_code())
}

fn chain_native_prefix_bytes() → List<BitVec(8)>
{
    structured_bytes(chain_native_prefix_code())
}

fn chain_native_prefix_after<M>(before: MachineState<M>) → MachineState<M>
{
    structured_after(chain_native_prefix_code(), before)
}

fn chain_native_prefix_value(values: Valuation(),
    width: Nat) → BitVec(width)
{
    chain_native_prefix_continuation_value(chain_native_prefix_carry(values, chain_native_prefix_source(values)), width)
}

fn chain_native_prefix_result(values: Valuation()) → BitVec(64)
{
    chain_native_prefix_value(values, 64)
}

theorem chain_native_prefix_correct<M>(values: Valuation(),
    before: MachineState<M>,
    placed_0: values(64, 0) = read_gpr(Rdi, before.gprs),
    placed_1: values(64, 1) = read_gpr(Rsi, before.gprs)):
    read_gpr(R8, chain_native_prefix_after(before).gprs) = chain_native_prefix_result(values)
{
    chain_native_prefix_continuation_correct(chain_native_prefix_carry(values, chain_native_prefix_source(values)), chain_native_prefix_prefix_after(before), trans(placed_0, sym(chain_native_prefix_prefix_preserves(Rdi, before, trivial))), trans(placed_1, sym(chain_native_prefix_prefix_preserves(Rsi, before, trivial))), j(sym(chain_native_prefix_carry_at(values, chain_native_prefix_source(values))), λ y _ => y = read_gpr(R9, chain_native_prefix_prefix_after(before).gprs), sym(trans(chain_native_prefix_prefix_correct(values, before, placed_0, placed_1), chain_native_prefix_link(values)))))
}

theorem chain_native_prefix_memory<M>(before: MachineState<M>):
    chain_native_prefix_after(before).memory = before.memory
{
    trans(chain_native_prefix_continuation_memory(chain_native_prefix_prefix_after(before)), chain_native_prefix_prefix_memory(before))
}

theorem chain_native_prefix_span<M>(before: MachineState<M>):
    chain_native_prefix_after(before).rip = next_rip(before.rip, 268)
{
    trans(chain_native_prefix_continuation_span(chain_native_prefix_prefix_after(before)), trans(bitvec::BitVec::cong_iterate_increment(64, 84, chain_native_prefix_prefix_span(before)), bitvec::BitVec::iterate_increment_compose(64, before.rip, 184, 84)))
}

theorem chain_native_prefix_layout():
    StructuredLayout(chain_native_prefix_code())
{
    ⟨chain_native_prefix_prefix_layout(), chain_native_prefix_continuation_layout()⟩
}

theorem chain_native_prefix_decodes(start: BitVec(64)):
    StructuredDecodes(chain_native_prefix_code(), start)
{
    ⟨chain_native_prefix_prefix_decodes(start), j(sym(chain_native_prefix_prefix_byte_length()), λ y _ => StructuredDecodes(chain_native_prefix_continuation_code(), next_rip(start, y)), chain_native_prefix_continuation_decodes(next_rip(start, 184)))⟩
}

theorem chain_native_prefix_byte_length():
    chain_native_prefix_bytes().len() = 268
{
    trans(list::List::len_append(structured_bytes(chain_native_prefix_prefix_code()), structured_bytes(chain_native_prefix_continuation_code())), trans(cong_fn<Nat, Nat>(λ k => k + (structured_bytes(chain_native_prefix_continuation_code())).len(), chain_native_prefix_prefix_byte_length()), cong_fn<Nat, Nat>(λ k => 184 + k, chain_native_prefix_continuation_byte_length())))
}

fn chain_native_prefix_lit() → List<BitVec(8)>
{
    chain_native_prefix_prefix_lit() ++ chain_native_prefix_continuation_lit()
}

theorem chain_native_prefix_bytes_are():
    chain_native_prefix_bytes() = chain_native_prefix_lit()
{
    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ xs => xs ++ chain_native_prefix_continuation_bytes(), chain_native_prefix_prefix_bytes_are()), cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ ys => chain_native_prefix_prefix_lit() ++ ys, chain_native_prefix_continuation_bytes_are()))
}

theorem chain_native_prefix_rip<M>(before: MachineState<M>):
    chain_native_prefix_after(before).rip = next_rip(before.rip, structured_bytes(chain_native_prefix_code()).len())
{
    j(sym(chain_native_prefix_byte_length()), λ y _ => chain_native_prefix_after(before).rip = next_rip(before.rip, y), chain_native_prefix_span(before))
}

fn chain_native_prefix_Protected(register: Gpr) → Type
{
    match register { Rax => False, Rcx => False, Rdx => False, R8 => False, R9 => False, _ => True }
}


fn chain_native_value_0(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::ofNat(64, 1003)
}

fn chain_native_value_1(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(1)
{
    bitvec::BitVec::ofBool(
            @bitvec::BitVec::unsigned_lt_bit(
                64,
                chain4::place(chain4::place(chain4::place(@bitvec::BitVec::add(64, arg0, @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1000), @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1001), @bitvec::BitVec::ofNat(64, 2)), @bitvec::BitVec::ofNat(64, 1002), @bitvec::BitVec::ofNat(64, 3)),
                chain_native_value_0(arg0, arg1)
            )
        )
}

fn chain_native_value_2(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::ofNat(64, 0)
}

fn chain_native_value_3(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    chain4::place(chain4::place(chain4::place(@bitvec::BitVec::add(64, arg0, @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1000), @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1001), @bitvec::BitVec::ofNat(64, 2)), @bitvec::BitVec::ofNat(64, 1002), @bitvec::BitVec::ofNat(64, 3))
}

fn chain_native_value_4(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::ofNat(64, 1003)
}

fn chain_native_value_5(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::sub(
            64,
            chain4::place(chain4::place(chain4::place(@bitvec::BitVec::add(64, arg0, @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1000), @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1001), @bitvec::BitVec::ofNat(64, 2)), @bitvec::BitVec::ofNat(64, 1002), @bitvec::BitVec::ofNat(64, 3)),
            chain_native_value_4(arg0, arg1)
        )
}

fn chain_native_value_6(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::ofNat(64, 4)
}

fn chain_native_value_7(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    @bitvec::BitVec::add(64, chain_native_value_5(arg0, arg1), chain_native_value_6(arg0, arg1))
}

fn chain_native_expression(arg0: BitVec(64),
    arg1: BitVec(64)) → BitVec(64)
{
    match @bitvec::BitVec::unsigned_lt_bit(
        64,
        chain4::place(chain4::place(chain4::place(@bitvec::BitVec::add(64, arg0, @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1000), @bitvec::BitVec::ofNat(64, 1)), @bitvec::BitVec::ofNat(64, 1001), @bitvec::BitVec::ofNat(64, 2)), @bitvec::BitVec::ofNat(64, 1002), @bitvec::BitVec::ofNat(64, 3)),
        chain_native_value_0(arg0, arg1)
    ) { False => chain_native_value_7(arg0, arg1), True => chain_native_value_3(arg0, arg1) }
}


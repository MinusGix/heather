}

theorem chain_native_carry_at(values: Valuation(),
    s: BitVec(64)):
    chain_native_carry(values, s)(64, 24) = s
{
    refl
}

fn chain_native_code() → StructuredCode
{
    CodeSequence(chain_native_prefix_code(), chain_native_continuation_code())
}

fn chain_native_bytes() → List<BitVec(8)>
{
    structured_bytes(chain_native_code())
}

fn chain_native_after<M>(before: MachineState<M>) → MachineState<M>
{
    structured_after(chain_native_code(), before)
}

fn chain_native_value(values: Valuation(),
    width: Nat) → BitVec(width)
{
    chain_native_continuation_value(chain_native_carry(values, chain_native_source(values)), width)
}

fn chain_native_result(values: Valuation()) → BitVec(64)
{
    chain_native_value(values, 64)
}

theorem chain_native_correct<M>(values: Valuation(),
    before: MachineState<M>,
    placed_0: values(64, 0) = read_gpr(Rdi, before.gprs),
    placed_1: values(64, 1) = read_gpr(Rsi, before.gprs)):
    read_gpr(Rax, chain_native_after(before).gprs) = chain_native_result(values)
{
    chain_native_continuation_correct(chain_native_carry(values, chain_native_source(values)), chain_native_prefix_after(before), trans(placed_0, sym(chain_native_prefix_preserves(Rdi, before, trivial))), trans(placed_1, sym(chain_native_prefix_preserves(Rsi, before, trivial))), j(sym(chain_native_carry_at(values, chain_native_source(values))), λ y _ => y = read_gpr(R8, chain_native_prefix_after(before).gprs), sym(trans(chain_native_prefix_correct(values, before, placed_0, placed_1), chain_native_link(values)))))
}

theorem chain_native_memory<M>(before: MachineState<M>):
    chain_native_after(before).memory = before.memory
{
    trans(chain_native_continuation_memory(chain_native_prefix_after(before)), chain_native_prefix_memory(before))
}

theorem chain_native_span<M>(before: MachineState<M>):
    chain_native_after(before).rip = next_rip(before.rip, 343)
{
    trans(chain_native_continuation_span(chain_native_prefix_after(before)), trans(bitvec::BitVec::cong_iterate_increment(64, 75, chain_native_prefix_span(before)), bitvec::BitVec::iterate_increment_compose(64, before.rip, 268, 75)))
}

theorem chain_native_layout():
    StructuredLayout(chain_native_code())
{
    ⟨chain_native_prefix_layout(), chain_native_continuation_layout()⟩
}

theorem chain_native_decodes(start: BitVec(64)):
    StructuredDecodes(chain_native_code(), start)
{
    ⟨chain_native_prefix_decodes(start), j(sym(chain_native_prefix_byte_length()), λ y _ => StructuredDecodes(chain_native_continuation_code(), next_rip(start, y)), chain_native_continuation_decodes(next_rip(start, 268)))⟩
}

theorem chain_native_byte_length():
    chain_native_bytes().len() = 343
{
    trans(list::List::len_append(structured_bytes(chain_native_prefix_code()), structured_bytes(chain_native_continuation_code())), trans(cong_fn<Nat, Nat>(λ k => k + (structured_bytes(chain_native_continuation_code())).len(), chain_native_prefix_byte_length()), cong_fn<Nat, Nat>(λ k => 268 + k, chain_native_continuation_byte_length())))
}

fn chain_native_lit() → List<BitVec(8)>
{
    chain_native_prefix_lit() ++ chain_native_continuation_lit()
}

theorem chain_native_bytes_are():
    chain_native_bytes() = chain_native_lit()
{
    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ xs => xs ++ chain_native_continuation_bytes(), chain_native_prefix_bytes_are()), cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ ys => chain_native_prefix_lit() ++ ys, chain_native_continuation_bytes_are()))
}

theorem chain_native_rip<M>(before: MachineState<M>):
    chain_native_after(before).rip = next_rip(before.rip, structured_bytes(chain_native_code()).len())
{
    j(sym(chain_native_byte_length()), λ y _ => chain_native_after(before).rip = next_rip(before.rip, y), chain_native_span(before))
}

fn chain_native_Protected(register: Gpr) → Type
{
    match register { Rax => False, Rcx => False, Rdx => False, R8 => False, R9 => False, _ => True }
}

theorem chain_native_preserves<M>(register: Gpr,
    before: MachineState<M>):
    chain_native_Protected(register) → read_gpr(register, chain_native_after(before).gprs) = read_gpr(register, before.gprs)
{
    match register { Rax => protected ⊢ false_elim(protected), Rcx => protected ⊢ false_elim(protected), Rdx => protected ⊢ false_elim(protected), Rbx => _ ⊢ trans(chain_native_continuation_preserves(Rbx, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(Rbx, before, trivial)), Rsp => _ ⊢ trans(chain_native_continuation_preserves(Rsp, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(Rsp, before, trivial)), Rbp => _ ⊢ trans(chain_native_continuation_preserves(Rbp, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(Rbp, before, trivial)), Rsi => _ ⊢ trans(chain_native_continuation_preserves(Rsi, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(Rsi, before, trivial)), Rdi => _ ⊢ trans(chain_native_continuation_preserves(Rdi, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(Rdi, before, trivial)), R8 => protected ⊢ false_elim(protected), R9 => protected ⊢ false_elim(protected), R10 => _ ⊢ trans(chain_native_continuation_preserves(R10, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R10, before, trivial)), R11 => _ ⊢ trans(chain_native_continuation_preserves(R11, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R11, before, trivial)), R12 => _ ⊢ trans(chain_native_continuation_preserves(R12, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R12, before, trivial)), R13 => _ ⊢ trans(chain_native_continuation_preserves(R13, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R13, before, trivial)), R14 => _ ⊢ trans(chain_native_continuation_preserves(R14, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R14, before, trivial)), R15 => _ ⊢ trans(chain_native_continuation_preserves(R15, chain_native_prefix_after(before), trivial), chain_native_prefix_preserves(R15, before, trivial)) }
}

theorem chain_native_artifact<M>(values: Valuation(),
    before: MachineState<M>,
    placed_0: values(64, 0) = read_gpr(Rdi, before.gprs),
    placed_1: values(64, 1) = read_gpr(Rsi, before.gprs)):
    StructuredArtifact<M>(chain_native_code(), before, Rax, chain_native_result(values), chain_native_Protected)
{
    StructuredArtifact(after := chain_native_after(before), execution := refl, layout := chain_native_layout(), decoding := chain_native_decodes(before.rip), result_correct := chain_native_correct(values, before, placed_0, placed_1), memory_preserved := chain_native_memory(before), rip_correct := chain_native_rip(before), registers_preserved := λ register protected => chain_native_preserves(register, before, protected))
}

theorem chain_native_meaning_at(values: Valuation(),
    s: BitVec(64)):
    chain_native_continuation_value(chain_native_carry(values, s), 64) = chain4::place(s, @bitvec::BitVec::ofNat(64, 1003), @bitvec::BitVec::ofNat(64, 4))
{
    refl
}

theorem chain_native_meaning(values: Valuation()):
    chain_native_result(values) = chain4::place(chain_native_source(values), @bitvec::BitVec::ofNat(64, 1003), @bitvec::BitVec::ofNat(64, 4))
{
    chain_native_meaning_at(values, chain_native_source(values))
}

theorem chain_native_result_expands(values: Valuation()):
    chain_native_result(values) = chain_native_expression(values(64, 0), values(64, 1))
{
    chain_native_meaning(values)
}

theorem chain_native_denotes_source(values: Valuation()):
    chain_native_result(values) = chain4::chain(values(64, 0), values(64, 1))
{
    trans(chain_native_result_expands(values), chain_native_source_expands(values(64, 0), values(64, 1)))
}

fn chain_native_entry_values<M>(before: MachineState<M>) → Valuation()
{
    λ width id => match id { Zero => @bitvec::BitVec::ofNat(width, @bitvec::BitVec::toNat(64, read_gpr(Rdi, before.gprs))), Succ(rest) => match rest { Zero => @bitvec::BitVec::ofNat(width, @bitvec::BitVec::toNat(64, read_gpr(Rsi, before.gprs))), Succ(_) => @bitvec::BitVec::zero(width) } }
}

theorem chain_native_source_correct<M>(before: MachineState<M>):
    read_gpr(Rax, chain_native_after(before).gprs) = chain4::chain(read_gpr(Rdi, before.gprs), read_gpr(Rsi, before.gprs))
{
    trans(chain_native_correct(chain_native_entry_values(before), before, bitvec::BitVec::ofNat_toNat(64, read_gpr(Rdi, before.gprs)), bitvec::BitVec::ofNat_toNat(64, read_gpr(Rsi, before.gprs))), trans(chain_native_denotes_source(chain_native_entry_values(before)), trans(cong_fn<BitVec(64), BitVec(64)>(λ left => chain4::chain(left, chain_native_entry_values(before)(64, 1)), bitvec::BitVec::ofNat_toNat(64, read_gpr(Rdi, before.gprs))), cong_fn<BitVec(64), BitVec(64)>(λ right => chain4::chain(read_gpr(Rdi, before.gprs), right), bitvec::BitVec::ofNat_toNat(64, read_gpr(Rsi, before.gprs))))))
}

theorem chain_native_source_artifact<M>(before: MachineState<M>):
    StructuredArtifact<M>(chain_native_code(), before, Rax, chain4::chain(read_gpr(Rdi, before.gprs), read_gpr(Rsi, before.gprs)), chain_native_Protected)
{
    StructuredArtifact(after := chain_native_after(before), execution := refl, layout := chain_native_layout(), decoding := chain_native_decodes(before.rip), result_correct := chain_native_source_correct(before), memory_preserved := chain_native_memory(before), rip_correct := chain_native_rip(before), registers_preserved := λ register protected => chain_native_preserves(register, before, protected))
}

fn chain_native_published() → List<BitVec(8)>
{
    chain_native_lit()
}

theorem chain_native_exported_bytes():
    chain_native_bytes() = chain_native_published()
{
    chain_native_bytes_are()
}

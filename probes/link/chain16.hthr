import bitvec;
import bool;
fn place(state, threshold, weight: BitVec(64)) → BitVec(64) {
    match state.unsigned_lt_bit(threshold) {
        True => state,
        False => state.sub(threshold).add(weight),
    }
}
fn chain(n, unused: BitVec(64)) → BitVec(64) {
    place(place(place(place(place(place(place(place(place(place(place(place(place(place(place(place(n.add(BitVec::ofNat(1)), BitVec::ofNat(1000), BitVec::ofNat(1)), BitVec::ofNat(1001), BitVec::ofNat(2)), BitVec::ofNat(1002), BitVec::ofNat(3)), BitVec::ofNat(1003), BitVec::ofNat(4)), BitVec::ofNat(1004), BitVec::ofNat(5)), BitVec::ofNat(1005), BitVec::ofNat(6)), BitVec::ofNat(1006), BitVec::ofNat(7)), BitVec::ofNat(1007), BitVec::ofNat(8)), BitVec::ofNat(1008), BitVec::ofNat(9)), BitVec::ofNat(1009), BitVec::ofNat(10)), BitVec::ofNat(1010), BitVec::ofNat(11)), BitVec::ofNat(1011), BitVec::ofNat(12)), BitVec::ofNat(1012), BitVec::ofNat(13)), BitVec::ofNat(1013), BitVec::ofNat(14)), BitVec::ofNat(1014), BitVec::ofNat(15)), BitVec::ofNat(1015), BitVec::ofNat(16))
}

import bitvec;
import bool;
fn place(state, threshold, weight: BitVec(64)) → BitVec(64) {
    match state.unsigned_lt_bit(threshold) {
        True => state,
        False => state.sub(threshold).add(weight),
    }
}
fn chain(n, unused: BitVec(64)) → BitVec(64) {
    place(place(place(place(place(place(place(place(n.add(BitVec::ofNat(1)), BitVec::ofNat(1000), BitVec::ofNat(1)), BitVec::ofNat(1001), BitVec::ofNat(2)), BitVec::ofNat(1002), BitVec::ofNat(3)), BitVec::ofNat(1003), BitVec::ofNat(4)), BitVec::ofNat(1004), BitVec::ofNat(5)), BitVec::ofNat(1005), BitVec::ofNat(6)), BitVec::ofNat(1006), BitVec::ofNat(7)), BitVec::ofNat(1007), BitVec::ofNat(8))
}

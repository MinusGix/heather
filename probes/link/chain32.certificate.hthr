}

theorem chain_native_prefix_artifact<M>(values: Valuation(),
    before: MachineState<M>,
    placed_0: values(64, 0) = read_gpr(Rdi, before.gprs),
    placed_1: values(64, 1) = read_gpr(Rsi, before.gprs)):
    StructuredArtifact<M>(chain_native_prefix_code(), before, R8, chain_native_prefix_result(values), chain_native_prefix_Protected)

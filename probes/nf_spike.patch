+/// SPIKE, round "emit the application, not its normal form"
+/// (`docs/conversion-query-traversal-design.md` §8 item 2): `HEATHER_NF_SPIKE=<µs>`
+/// prints every head-shape probe that cost more than that budget, with the
+/// input's bounded spelling and the elaborator frames that asked for it. The
+/// exponential normal forms of §3 take milliseconds each to build, so a budget
+/// of a few hundred microseconds separates them from every other probe.
+/// Temporary: this is removed before the round's tree is offered for review.
+#[cfg(feature = "value-metrics")]
+pub(crate) fn nf_spike_budget() -> Option<u128> {
+    static BUDGET: std::sync::OnceLock<Option<u128>> = std::sync::OnceLock::new();
+    *BUDGET.get_or_init(|| {
+        std::env::var("HEATHER_NF_SPIKE")
+            .ok()
+            .and_then(|v| v.trim().parse::<u128>().ok())
+    })
+}
+
+#[cfg(feature = "value-metrics")]
+pub(crate) fn nf_spike_report(
+    what: &str,
+    start: Option<std::time::Instant>,
+    input: &impl std::fmt::Debug,
+    output: &impl std::fmt::Debug,
+) {
+    let (Some(start), Some(budget)) = (start, nf_spike_budget()) else {
+        return;
+    };
+    let us = start.elapsed().as_micros();
+    if us < budget {
+        return;
+    }
+    let bt = std::backtrace::Backtrace::force_capture().to_string();
+    let frames: Vec<&str> = bt
+        .lines()
+        .map(str::trim)
+        .filter(|l| l.contains("heather_elab") && !l.contains("closure"))
+        .skip(1)
+        .take(10)
+        .collect();
+    let item = crate::stats::current_item().map_or_else(|| "-".to_string(), |(m, i)| format!("{m}::{i}"));
+    let inp = format!("{input:?}");
+    eprintln!(
+        "nf spike {what} {us}us item={item} in_len={} out_len={} in={} site: {}",
+        inp.len(),
+        format!("{output:?}").len(),
+        inp,
+        frames.join(" < ")
+    );
+}

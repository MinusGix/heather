// C2: the certificate's unit — is_zero_bits over bxor. The definition is
// Probe file for docs/native-bitvector-values-design.md §2.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

// copied from std/arch/x86_64/model so the probe needs no arch import.
import bitvec;
import bool;

fn is_zero_p(n: Nat) → BitVec(n) → Bool {
    match n as λ k => BitVec(k) → Bool {
        Zero => λ x => True,
        Succ(k, ih) => λ x => bool::not(bitvec::head_bit(k, x)) && ih(bitvec::tail_bits(k, x)),
    }
}

theorem c2_zero_of_self_8(): is_zero_p(8, bitvec::bxor(8, bitvec::from_bits(8, [True, False, True, False, True, False, True, False]), bitvec::from_bits(8, [True, False, True, False, True, False, True, False]))) = True { refl }

theorem c2_zero_of_diff_8(): is_zero_p(8, bitvec::bxor(8, bitvec::from_bits(8, [True, False, True, False, True, False, True, False]), bitvec::from_bits(8, [True, True, True, True, True, True, True, True]))) = False { refl }

theorem c2_zero_lit_8(): is_zero_p(8, bitvec::zero(8)) = True { refl }


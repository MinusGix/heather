theorem c2_zero_of_diff_16(): is_zero_p(16, bitvec::bxor(16, bitvec::from_bits(16, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(16, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True]))) = False { refl }

theorem c2_zero_lit_16(): is_zero_p(16, bitvec::zero(16)) = True { refl }


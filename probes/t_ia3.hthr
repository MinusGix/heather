// Arm 3 reproducer: a `Result` over a `Certified` and a `Failure`, read
// through `result::fold`. Expected decline:
// `instance_match Result hole-match-Sum/Sigma`.
import nat;
import list;
import logic;
import result;
import parser;

inductive DTok { DA, DB }
fn DR(source: List<DTok>, begin: Cursor<DTok>(source), end: Cursor<DTok>(source), value: Nat) -> Type {
    nat::Le(begin.offset, end.offset)
}
fn ia_res(source: List<DTok>, begin: Cursor<DTok>(source),
    r: Result<Certified<DTok,Nat>(source,begin,DR),Failure<DTok>(source)>) -> Nat {
    result::fold<Certified<DTok,Nat>(source,begin,DR),Failure<DTok>(source),Nat>(r,
        λ (c: Certified<DTok,Nat>(source,begin,DR)) => c.value,
        λ (e: Failure<DTok>(source)) => 0)
}

// A4: the library's ripple add at literal operands (carry as state).
// Probe file for docs/native-bitvector-values-design.md §2.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import bitvec;
import bool;

theorem a4_add_8(): bitvec::add(8, bitvec::from_bits(8, [True, False, True, False, True, False, True, False]), bitvec::from_bits(8, [True, True, True, True, True, True, True, True])) = bitvec::from_bits(8, [False, False, True, False, True, False, True, False]) { refl }

theorem a4_add_16(): bitvec::add(16, bitvec::from_bits(16, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(16, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(16, [False, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]) { refl }

theorem a4_add_32(): bitvec::add(32, bitvec::from_bits(32, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(32, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(32, [False, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]) { refl }

theorem a4_add_64(): bitvec::add(64, bitvec::from_bits(64, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(64, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(64, [False, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]) { refl }

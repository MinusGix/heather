// P3c: which half of ofNat costs, and what the OBVIOUS spelling costs today.
// ofNat(n, x) = from_bit_list(n, bits_at_powers(powers, mod_succ(x, 2^n - 1), Nil)).
//   p3c_bits_*   list_len of bits_at_powers alone — the top-down bit reader.
//   p3c_asm_*    from_bit_list over a LITERAL List<Bool> — the assembly fold alone.
//   p3c_half_*   the spelling the module header rejected in 2026-09-07:
//                low bit by parity, rest at half(x). At a SMALL x the half
//                chain is short, and 90% of lib/'s 218 ofNat(64, k) sites
//                have k < 9. p3c_half_big is the magnitude control.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import bitvec;
import bool;
import nat;
import list;

fn odd_bit(n: Nat) → Bool {
    match n { Zero => False, Succ(k) => match k { Zero => True, Succ(l) => odd_bit(l) } }
}

fn ofNatH(n: Nat) → Nat → bitvec::BitVec(n) {
    match n as λ k => Nat → bitvec::BitVec(k) {
        Zero => λ x => bitvec::from_bits(0, []),
        Succ(k, ih) => λ x => bitvec::cons_bit(k, odd_bit(x), ih(nat::half(x))),
    }
}

fn powers_lit_8() → List<Nat> { Cons(128, Cons(64, Cons(32, Cons(16, Cons(8, Cons(4, Cons(2, Cons(1, Nil)))))))) }

theorem p3c_bits_w8(): list_len(bitvec::bits_at_powers(powers_lit_8(), 7, Nil)) = 8 { refl }

fn bitlist_8() → List<Bool> { Cons(True, Cons(True, Cons(True, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Nil)))))))) }

theorem p3c_asm_w8(): bitvec::from_bit_list(8, bitlist_8()) = bitvec::from_bits(8, [True, True, True, False, False, False, False, False]) { refl }

theorem p3c_half_w8(): ofNatH(8, 7) = bitvec::from_bits(8, [True, True, True, False, False, False, False, False]) { refl }

fn powers_lit_64() → List<Nat> { Cons(9223372036854775808, Cons(4611686018427387904, Cons(2305843009213693952, Cons(1152921504606846976, Cons(576460752303423488, Cons(288230376151711744, Cons(144115188075855872, Cons(72057594037927936, Cons(36028797018963968, Cons(18014398509481984, Cons(9007199254740992, Cons(4503599627370496, Cons(2251799813685248, Cons(1125899906842624, Cons(562949953421312, Cons(281474976710656, Cons(140737488355328, Cons(70368744177664, Cons(35184372088832, Cons(17592186044416, Cons(8796093022208, Cons(4398046511104, Cons(2199023255552, Cons(1099511627776, Cons(549755813888, Cons(274877906944, Cons(137438953472, Cons(68719476736, Cons(34359738368, Cons(17179869184, Cons(8589934592, Cons(4294967296, Cons(2147483648, Cons(1073741824, Cons(536870912, Cons(268435456, Cons(134217728, Cons(67108864, Cons(33554432, Cons(16777216, Cons(8388608, Cons(4194304, Cons(2097152, Cons(1048576, Cons(524288, Cons(262144, Cons(131072, Cons(65536, Cons(32768, Cons(16384, Cons(8192, Cons(4096, Cons(2048, Cons(1024, Cons(512, Cons(256, Cons(128, Cons(64, Cons(32, Cons(16, Cons(8, Cons(4, Cons(2, Cons(1, Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) }

theorem p3c_bits_w64(): list_len(bitvec::bits_at_powers(powers_lit_64(), 7, Nil)) = 64 { refl }

fn bitlist_64() → List<Bool> { Cons(True, Cons(True, Cons(True, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Cons(False, Nil)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) }

theorem p3c_asm_w64(): bitvec::from_bit_list(64, bitlist_64()) = bitvec::from_bits(64, [True, True, True, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False]) { refl }

theorem p3c_half_w64(): ofNatH(64, 7) = bitvec::from_bits(64, [True, True, True, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False, False]) { refl }

theorem p3c_half_big(): ofNatH(64, 0x123456789abcdef) = bitvec::from_bits(64, [True, True, True, True, False, True, True, True, True, False, True, True, False, False, True, True, True, True, False, True, False, True, False, True, True, False, False, True, False, False, False, True, True, True, True, False, False, True, True, False, True, False, True, False, False, False, True, False, True, True, False, False, False, True, False, False, True, False, False, False, False, False, False, False]) { refl }

theorem p3c_half_w8_c0(): ofNatH(8, 0xc0) = bitvec::from_bits(8, [False, False, False, False, False, False, True, True]) { refl }

// qt5 — one more identity `map_at` than t_qt3 (five combinator layers). The
// fifth point on the scaling curve; the reply computes exactly what t_cp9's
// does. Run under a wider rail than the other probes on purpose.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPAndT<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<relation(source,begin,end,value),True>
}
theorem qt_deeper<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPAndT<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward =>
            map_at(source,middle,map_at(source,middle,map_at(source,middle,eof_at(expected,source,middle),λ (i: Nat) => i),λ (j: Nat) => j),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(h,trivial), Cons(head,tail) => trivial,
    } }
}

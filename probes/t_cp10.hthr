// cp10 — the decisive one. The spec's body is the relation APPLIED AND
// NOTHING ELSE, so `CPWrap<T,A>(relation)` and `relation` mean the same
// function. cp2 passes `relation` (3.1 s); this passes a `→ Type` wrapper
// around it. Whatever separates the two is the cost of the wrapper, not of
// anything written inside it.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPWrap<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    relation(source,begin,end,value)
}
theorem cp_wrap<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPWrap<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => h, Cons(head,tail) => trivial,
    } }
}

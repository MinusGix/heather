    let f3: (double(double(double(double(bitvec_nat::word_of_nat(64, n))))).toNat() = double(double(double(bitvec_nat::word_of_nat(64, n)))).toNat() + double(double(double(bitvec_nat::word_of_nat(64, n)))).toNat()) = bitvec_nat::toNat_add(64, double(double(double(bitvec_nat::word_of_nat(64, n)))), double(double(double(bitvec_nat::word_of_nat(64, n)))), omega);
    let f4: (double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))).toNat() = double(double(double(double(bitvec_nat::word_of_nat(64, n))))).toNat() + double(double(double(double(bitvec_nat::word_of_nat(64, n))))).toNat()) = bitvec_nat::toNat_add(64, double(double(double(double(bitvec_nat::word_of_nat(64, n))))), double(double(double(double(bitvec_nat::word_of_nat(64, n))))), omega);
    let f5: (double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n))))))).toNat() = double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))).toNat() + double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))).toNat()) = bitvec_nat::toNat_add(64, double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))), double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))), omega);
    let f6: (double(double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))))).toNat() = double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n))))))).toNat() + double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n))))))).toNat()) = bitvec_nat::toNat_add(64, double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n))))))), double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n))))))), omega);
    let f7: (times256(bitvec_nat::word_of_nat(64, n)).toNat() = double(double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))))).toNat() + double(double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))))).toNat()) = bitvec_nat::toNat_add(64, double(double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))))), double(double(double(double(double(double(double(bitvec_nat::word_of_nat(64, n)))))))), omega);

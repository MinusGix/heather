fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }
fn times256(x: BitVec(64)) → BitVec(64) { double(double(double(double(double(double(double(double(x)))))))) }
fn raise(n: BitVec(64)) → BitVec(64) { times256(times256(times256(times256(times256(n))))) }
theorem deep(n: Nat, small: n < 16384): times256(bitvec_nat::word_of_nat(64, n)).toNat() = n * 256 {
    let b0: (bitvec_nat::word_of_nat(64, n).toNat() = n) = bitvec_nat::toNat_word_of_nat(64, n, omega);
    let f0: (double(bitvec_nat::word_of_nat(64, n)).toNat() = bitvec_nat::word_of_nat(64, n).toNat() + bitvec_nat::word_of_nat(64, n).toNat()) = bitvec_nat::toNat_add(64, bitvec_nat::word_of_nat(64, n), bitvec_nat::word_of_nat(64, n), omega);
    let f1: (double(double(bitvec_nat::word_of_nat(64, n))).toNat() = double(bitvec_nat::word_of_nat(64, n)).toNat() + double(bitvec_nat::word_of_nat(64, n)).toNat()) = bitvec_nat::toNat_add(64, double(bitvec_nat::word_of_nat(64, n)), double(bitvec_nat::word_of_nat(64, n)), omega);

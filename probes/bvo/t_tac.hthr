import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;
import bitvec_omega;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }
fn times4(x: BitVec(64)) → BitVec(64) { double(double(x)) }
fn times256(x: BitVec(64)) → BitVec(64) { double(double(double(double(double(double(double(double(x)))))))) }

theorem four(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v * 4 < 1152921504606846976): times4(y).toNat() = v * 4 { bv_omega }

theorem t256(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v * 256 < 1152921504606846976): times256(y).toNat() = v * 256 { bv_omega }

theorem plus5(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v < 1000): y.add(BitVec::ofNat(5)).toNat() = v + 5 { bv_omega }

theorem minus(s: BitVec(64), r, h, c: Nat, value: s.toNat() = 1099511627776 * r + h, fit: c <= r):
    s.sub(BitVec::ofNat(1099511627776 * c)).toNat() + 1099511627776 * c = 1099511627776 * r + h { bv_omega }

// Negative control: the bound is too weak for the doubling.
theorem wrong(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v < 18446744073709551615): double(y).toNat() = v * 2 { bv_omega }

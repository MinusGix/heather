import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }
fn times4(x: BitVec(64)) → BitVec(64) { double(double(x)) }

theorem four(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v * 4 < 1152921504606846976):
    times4(y).toNat() = v * 4 {
    let b0: (y.toNat() < Nat::pow(2, 64)) = BitVec::toNat_lt_pow(64, y);
    let f1: (double(y).toNat() = y.toNat() + y.toNat()) = bitvec_nat::toNat_add(64, y, y, omega);
    let f2: (times4(y).toNat() = double(y).toNat() + double(y).toNat()) = bitvec_nat::toNat_add(64, double(y), double(y), omega);
    omega
}

theorem ofnat(y: BitVec(64), v: Nat, value: y.toNat() = v, bound: v < 1000):
    y.add(BitVec::ofNat(5)).toNat() = v + 5 {
    let f1: (BitVec::ofNat(5, n := 64).toNat() = 5) = BitVec::toNat_ofNat(64, 5, omega);
    let f2: (y.add(BitVec::ofNat(5)).toNat() = y.toNat() + BitVec::ofNat(5, n := 64).toNat()) = bitvec_nat::toNat_add(64, y, BitVec::ofNat(5), omega);
    omega
}

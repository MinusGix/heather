import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }
fn times256(x: BitVec(64)) → BitVec(64) { double(double(double(double(double(double(double(double(x)))))))) }

theorem leaf(n: Nat, a: BitVec(n)): a.toNat() + 0 = a.toNat() { refl }
theorem add_affine(n: Nat, a, b: BitVec(n), pa, na, pb, nb, p, q: Nat,
    ha: a.toNat() + na = pa, hb: b.toNat() + nb = pb,
    bound: pa + pb < Nat::pow(2, n) + (na + nb), norm: pa + pb + q = p + (na + nb)):
    a.add(b).toNat() + q = p {
    let lt: (a.toNat() + b.toNat() < Nat::pow(2, n)) = omega;
    let sum: (a.add(b).toNat() = a.toNat() + b.toNat()) = bitvec_nat::toNat_add(n, a, b, lt);
    omega
}
theorem aff3(y: BitVec(64), n: Nat, value: y.toNat() = n, small: n < 16384): double(double(double(y))).toNat() = n * 8 {
    let f0: (y.toNat() + 0 = y.toNat()) = leaf(64, y);
    let f1: (double(y).toNat() + 0 = y.toNat() * 2) = add_affine(64, y, y, y.toNat(), 0, y.toNat(), 0, y.toNat() * 2, 0, f0, f0, omega, omega);
    let f2: (double(double(y)).toNat() + 0 = y.toNat() * 4) = add_affine(64, double(y), double(y), y.toNat() * 2, 0, y.toNat() * 2, 0, y.toNat() * 4, 0, f1, f1, omega, omega);
    let f3: (double(double(double(y))).toNat() + 0 = y.toNat() * 8) = add_affine(64, double(double(y)), double(double(y)), y.toNat() * 4, 0, y.toNat() * 4, 0, y.toNat() * 8, 0, f2, f2, omega, omega);
    let g: ((w, v: Nat) → w + 0 = v * 8 → v = n → w = n * 8) = λ w v h e => omega;
    g(double(double(double(y))).toNat(), y.toNat(), f3, value)
}
theorem aff8(y: BitVec(64), n: Nat, value: y.toNat() = n, small: n < 16384): double(double(double(double(double(double(double(double(y)))))))).toNat() = n * 256 {
    let f0: (y.toNat() + 0 = y.toNat()) = leaf(64, y);
    let f1: (double(y).toNat() + 0 = y.toNat() * 2) = add_affine(64, y, y, y.toNat(), 0, y.toNat(), 0, y.toNat() * 2, 0, f0, f0, omega, omega);
    let f2: (double(double(y)).toNat() + 0 = y.toNat() * 4) = add_affine(64, double(y), double(y), y.toNat() * 2, 0, y.toNat() * 2, 0, y.toNat() * 4, 0, f1, f1, omega, omega);
    let f3: (double(double(double(y))).toNat() + 0 = y.toNat() * 8) = add_affine(64, double(double(y)), double(double(y)), y.toNat() * 4, 0, y.toNat() * 4, 0, y.toNat() * 8, 0, f2, f2, omega, omega);
    let f4: (double(double(double(double(y)))).toNat() + 0 = y.toNat() * 16) = add_affine(64, double(double(double(y))), double(double(double(y))), y.toNat() * 8, 0, y.toNat() * 8, 0, y.toNat() * 16, 0, f3, f3, omega, omega);
    let f5: (double(double(double(double(double(y))))).toNat() + 0 = y.toNat() * 32) = add_affine(64, double(double(double(double(y)))), double(double(double(double(y)))), y.toNat() * 16, 0, y.toNat() * 16, 0, y.toNat() * 32, 0, f4, f4, omega, omega);
    let f6: (double(double(double(double(double(double(y)))))).toNat() + 0 = y.toNat() * 64) = add_affine(64, double(double(double(double(double(y))))), double(double(double(double(double(y))))), y.toNat() * 32, 0, y.toNat() * 32, 0, y.toNat() * 64, 0, f5, f5, omega, omega);
    let f7: (double(double(double(double(double(double(double(y))))))).toNat() + 0 = y.toNat() * 128) = add_affine(64, double(double(double(double(double(double(y)))))), double(double(double(double(double(double(y)))))), y.toNat() * 64, 0, y.toNat() * 64, 0, y.toNat() * 128, 0, f6, f6, omega, omega);
    let f8: (double(double(double(double(double(double(double(double(y)))))))).toNat() + 0 = y.toNat() * 256) = add_affine(64, double(double(double(double(double(double(double(y))))))), double(double(double(double(double(double(double(y))))))), y.toNat() * 128, 0, y.toNat() * 128, 0, y.toNat() * 256, 0, f7, f7, omega, omega);
    let g: ((w, v: Nat) → w + 0 = v * 256 → v = n → w = n * 256) = λ w v h e => omega;
    g(double(double(double(double(double(double(double(double(y)))))))).toNat(), y.toNat(), f8, value)
}

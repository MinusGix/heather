import bitvec;
import list;
import logic;
import nat;
import omega;

theorem uses(n: Nat, fact: BitVec::ofNat(5, n := 64).toNat() = n, small: n < 10): BitVec::ofNat(5, n := 64).toNat() < 20 { omega }

fn empty<A>() → List<A> { Nil }
theorem typed(k: Nat, fact: empty<Nat>().len() = k, small: k < 3): empty<Nat>().len() < 5 { omega }

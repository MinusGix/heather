import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }
fn times256(x: BitVec(64)) → BitVec(64) { double(double(double(double(double(double(double(double(x)))))))) }
fn raise(n: BitVec(64)) → BitVec(64) { times256(times256(times256(times256(times256(n))))) }
theorem c1(y: BitVec(64)): double(double(double(double(y)))).toNat() = double(double(double(y))).add(double(double(double(y)))).toNat() { refl }
theorem c2(y: BitVec(64)): double(double(double(double(y)))) = double(double(double(y))).add(double(double(double(y)))) { refl }

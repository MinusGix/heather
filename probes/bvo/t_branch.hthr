import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;
import bitvec_omega;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }

theorem plain_branch(y: BitVec(64), v, q: Nat, value: y.toNat() = v, small: v < 1000): y.toNat() + y.toNat() = v + v {
    match q { Zero => omega, Succ(_) => omega }
}
theorem bv_branch(y: BitVec(64), v, q: Nat, value: y.toNat() = v, small: v < 1000): double(y).toNat() = v + v {
    match q { Zero => bv_omega, Succ(_) => bv_omega }
}

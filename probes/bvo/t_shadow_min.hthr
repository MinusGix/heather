import logic;
import nat;
import omega;

theorem shadow(n: Nat, small: n < 5): n < 10 {
    let g: ((n: Nat) → n < 5 → n < 10) = λ n s => omega;
    g(n, small)
}
theorem shadow_plain(n: Nat, small: n < 5): n < 10 {
    let g: ((n: Nat) → n < 5 → n < 10) = λ m s => Nat::le_trans(Succ(m), 5, 10, s, trivial);
    g(n, small)
}

// cp1 — the BASE: `parser_primitives::complete_post` verbatim under a new
// name, so the probe file's item row can be compared with the library item's
// in the same run. Everything else in this family removes exactly one thing.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

theorem cp_full<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CompleteSpec<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(h,shape), Cons(head,tail) => trivial,
    } }
}

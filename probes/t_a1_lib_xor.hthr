// A1: the library's bxor at literal operands, widths 8/16/32/64.
// Probe file for docs/native-bitvector-values-design.md §2.
// Re-measure with a FRESH --cache-dir (see probes/README.md).

import bitvec;
import bool;

theorem a1_xor_8(): bitvec::bxor(8, bitvec::from_bits(8, [True, False, True, False, True, False, True, False]), bitvec::from_bits(8, [True, True, True, True, True, True, True, True])) = bitvec::from_bits(8, [False, True, False, True, False, True, False, True]) { refl }

theorem a1_xor_16(): bitvec::bxor(16, bitvec::from_bits(16, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(16, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(16, [False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True]) { refl }

theorem a1_xor_32(): bitvec::bxor(32, bitvec::from_bits(32, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(32, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(32, [False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True]) { refl }

theorem a1_xor_64(): bitvec::bxor(64, bitvec::from_bits(64, [True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False]), bitvec::from_bits(64, [True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True, True])) = bitvec::from_bits(64, [False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True, False, True]) { refl }

import logic;
import bool;
import nat;
import option;
import char;

theorem d7(): digit_of('7') = Some(7) { refl }
theorem dx(): digit_of('x') = None<Nat> { refl }
theorem sp(): is_space(' ') = True { refl }
theorem tab(): is_space('	') = True { refl }
theorem vtab(): is_space('+') = False { refl }
theorem val9(): digit_val('9') = 9 { refl }

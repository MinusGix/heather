import logic;
import bool;
import nat;
import list;
import option;
import result;
import pair;
import int;
import omega;
import char;
import string;
import parser;

fn digit_of(c: Char) → Option<Nat> {
    match nat::le_dec(0x30, c.code) {
        Inr(_) => None,
        Inl(_) => match nat::le_dec(Succ(c.code), 0x3A) {
            Inr(_) => None,
            Inl(_) => Some(nat::sub(c.code, 0x30)),
        },
    }
}

fn digit() → Parser<Char, Nat> { recognize(digit_of, 0) }

fn run_string<A>(p: Parser<Char, A>, s: String) → Result<A, ErrorView> { run(p, s.chars) }

theorem one_digit(): run_string(digit(), "7") = Ok(7) { refl }
theorem not_digit(): run_string(digit(), "+") = Err(ErrorView(0, [0], Retryable)) { refl }

fn digits() → Parser<Char, List<Nat>> { some(digit(), recognize_consumes(digit_of, 0)) }
theorem three_digits(): run_string(digits(), "123") = Ok([1,2,3]) { refl }

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;

// A sequence is a type with a spec-level list view, together with the
// operations a consumer actually runs, each tied to the view by a law.
class Sequence<S, T> {
    toList: S → List<T>,
    seq_len: S → Nat,
    seq_drop: S → Nat → S,
    len_view: (s: S) → seq_len(s) = list_len(toList(s)),
    drop_view: (s: S) → (n: Nat) → toList(seq_drop(s, n)) = list::drop(toList(s), n),
}

instance<A> Sequence<List<A>, A> {
    toList := λ (xs: List<A>) => xs,
    seq_len := λ (xs: List<A>) => list_len(xs),
    seq_drop := λ (xs: List<A>) (n: Nat) => list::drop(xs, n),
    len_view := λ (xs: List<A>) => refl,
    drop_view := λ (xs: List<A>) (n: Nat) => refl,
}

instance Sequence<String, Char> {
    toList := λ (s: String) => s.chars,
    seq_len := λ (s: String) => s.len(),
    seq_drop := λ (s: String) (n: Nat) => string::drop(s, n),
    len_view := λ (s: String) => refl,
    drop_view := λ (s: String) (n: Nat) => refl,
}

// A consumer generic in the sequence: does class dispatch still compute?
fn head_of<T, S: Sequence<T>>(s: S) → Option<T> {
    match S.toList(s) { Nil => None, Cons(h, t) => Some(h) }
}

theorem head_string(): head_of("7x") = Some('7') { refl }
theorem head_list(): head_of([4,5]) = Some(4) { refl }
theorem len_string(): seq_len("abc") = 3 { refl }
theorem drop_string(): seq_drop("abc", 1).chars = "bc".chars { refl }

import logic;
import nat;
import list;

inductive Tree { Leaf(n: Nat), Node(l: Tree, r: Tree) }

// Freestanding: the recursive call varies `tail`, and the IH is generalized
// over it. This checks.
fn flat(t: Tree, tail: List<Nat>) -> List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => flat(l, flat(r, tail)) }
}

// The same body as a receiver member. Identical recursion, identical varying
// argument.
fn Tree::flat_m(self t: Tree, tail: List<Nat>) -> List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => l.flat_m(r.flat_m(tail)) }
}

theorem both(): flat(Node(Leaf(1), Leaf(2)), Nil<Nat>) = [1, 2] { refl }

// Does spelling the self-call directly, inside the member, restore it?
fn Tree::flat_d(self t: Tree, tail: List<Nat>) -> List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => Tree::flat_d(l, Tree::flat_d(r, tail)) }
}

import logic;
import bool;
import nat;
import list;
import char;
import string;

fn is_digit(c: Char) → Bool {
    nat::leb(0x30, c.code) && nat::leb(Succ(c.code), 0x3A)
}

fn digit_val(c: Char) → Nat { nat::sub(c.code, 0x30) }

theorem lit_len(): "ab".len() = 2 { refl }
theorem digit_true(): is_digit('7') = True { refl }
theorem digit_false(): is_digit('+') = False { refl }
theorem digit_seven(): digit_val('7') = 7 { refl }
theorem chars_lit(): "7".chars = [Char('7'.code, '7'.valid)] { refl }

// Probe V5 of docs/native-wc-command-design.md §10.1: one digit of the
// `%*d` formatter's `emit` loop (§7), at an open place value. From RDX = n
// with n < 10 · place and RBX = place, it counts the subtractions into RCX,
// stores '0' + n / place at RDI and steps RDI past it, leaving n mod place in
// RDX. Written like elf64_write_loop: a layout of blocks and near jumps at an
// offset `at`, a record per piece, one lemma per way through.
//
// What it leaves out: the table read that loads `place` from pow10[k-1]
// (one WordLoad, probe V2) and the outer loop over the places. It is a
// probe of the cost per declaration, not the library formatter, which a
// separate round writes in lib/.
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_io;
import decimal_line;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// d ← 0; while n ≥ place: n ← n − place, d ← d + 1; store '0' + d; cursor + 1.
fn digit_init_block() → List<Instruction> { [MovRI(Rcx, BitVec::ofNat(0))] }
fn digit_test_block() → List<Instruction> { [CmpRR(Rdx, Rbx)] }
fn digit_take_block() → List<Instruction> { [SubRR(Rdx, Rbx), AddRI8(Rcx, BitVec::ofNat(1))] }
fn digit_char_block() → List<Instruction> { [AddRI8(Rcx, BitVec::ofNat(48))] }
fn digit_store() → ByteStore { ByteStore(base := Rdi, source := Rcx) }
fn digit_next_block() → List<Instruction> { [AddRI8(Rdi, BitVec::ofNat(1))] }

fn digit_init_len() → Nat { canonical_block_bytes(digit_init_block()).len() }
fn digit_test_len() → Nat { canonical_block_bytes(digit_test_block()).len() }
fn digit_take_len() → Nat { canonical_block_bytes(digit_take_block()).len() }
fn digit_char_len() → Nat { canonical_block_bytes(digit_char_block()).len() }
fn digit_next_len() → Nat { canonical_block_bytes(digit_next_block()).len() }

// JB out of the loop once n < place; JMP back to the compare.
record DigitJumps { od: BitVec(32), bd: BitVec(32) }

fn digit_parts(dj: DigitJumps) → List<List<BitVec(8)>> {
    [canonical_block_bytes(digit_init_block()), canonical_block_bytes(digit_test_block()), near_control_bytes(JumpIfNear(B, dj.od)),
     canonical_block_bytes(digit_take_block()), near_control_bytes(JumpNear(dj.bd)), canonical_block_bytes(digit_char_block()),
     byte_store_bytes(digit_store())]
}
fn digit_lens() → List<Nat> { [digit_init_len(), digit_test_len(), 6, digit_take_len(), 5, digit_char_len(), 3] }
fn digit_code(dj: DigitJumps) → List<BitVec(8)> { layout_code(digit_parts(dj), canonical_block_bytes(digit_next_block())) }
theorem digit_measured(dj: DigitJumps): LayoutMeasured(digit_parts(dj), digit_lens()) {
    ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩
}

fn dg_at(at, i: Nat) → Nat { layout_at(at, digit_lens(), i) }
fn dg_end(at: Nat) → Nat { dg_at(at, 7) + digit_next_len() }

record DigitPieces(memory: IoMemory, at: Nat, dj: DigitJumps) {
    init_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(digit_init_block()), eof_rip(dg_at(at, 0))),
    test_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(digit_test_block()), eof_rip(dg_at(at, 1))),
    jb_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpIfNear(B, dj.od)), eof_rip(dg_at(at, 2))),
    take_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(digit_take_block()), eof_rip(dg_at(at, 3))),
    jmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(dj.bd)), eof_rip(dg_at(at, 4))),
    char_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(digit_char_block()), eof_rip(dg_at(at, 5))),
    store_at: CodeResident(io_fetch_access(), memory, byte_store_bytes(digit_store()), eof_rip(dg_at(at, 6))),
    next_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(digit_next_block()), eof_rip(dg_at(at, 7))),
}
theorem digit_pieces(memory: IoMemory, at: Nat, dj: DigitJumps,
    resident: CodeResident(io_fetch_access(), memory, digit_code(dj), eof_rip(at))): DigitPieces(memory, at, dj) {
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), canonical_block_bytes(digit_next_block()), digit_parts(dj),
        digit_lens(), digit_measured(dj), at, resident);
    DigitPieces(piece(0), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6), piece(7))
}

record DigitTargets(at: Nat, dj: DigitJumps) {
    out: near_branch_target(eof_rip(dg_at(at, 2)), 6, dj.od) = eof_rip(dg_at(at, 5)),
    back: near_branch_target(eof_rip(dg_at(at, 4)), 5, dj.bd) = eof_rip(dg_at(at, 1)),
}

// At the compare: what is left of n, the place, the digit so far.
record DigitAt(memory: IoMemory, at, place, rest, d: Nat, cursor: BitVec(64), state: MachineState<IoMemory>) {
    memory_is: state.memory = memory,
    rip_is: state.rip = eof_rip(dg_at(at, 1)),
    rdx: read_gpr(Rdx, state.gprs).toNat() = rest,
    rbx: read_gpr(Rbx, state.gprs).toNat() = place,
    rcx: read_gpr(Rcx, state.gprs).toNat() = d,
    rdi: read_gpr(Rdi, state.gprs) = cursor,
}
// Out of the loop, at the character block.
record DigitOut(memory: IoMemory, at, place, r, d: Nat, cursor: BitVec(64), state: MachineState<IoMemory>) {
    memory_is: state.memory = memory,
    rip_is: state.rip = eof_rip(dg_at(at, 5)),
    rdx: read_gpr(Rdx, state.gprs).toNat() = r,
    rbx: read_gpr(Rbx, state.gprs).toNat() = place,
    rcx: read_gpr(Rcx, state.gprs).toNat() = d,
    rdi: read_gpr(Rdi, state.gprs) = cursor,
}

// The ADD immediates' values.
theorem ri8_one(): BitVec::ofNat(1, n := 8).sign_extend(56).toNat() = 1 { refl }
theorem ri8_char(): BitVec::ofNat(48, n := 8).sign_extend(56).toNat() = 48 { refl }

// The compare's CF is the Nat test.
theorem digit_cf(state: MachineState<IoMemory>, rest, place: Nat,
    rdx: read_gpr(Rdx, state.gprs).toNat() = rest, rbx: read_gpr(Rbx, state.gprs).toNat() = place):
    execute_block_normal(digit_test_block(), state).flags.cf = Succ(rest).leb(place) {
    trans(bitvec_nat::unsigned_lt_nat(64, read_gpr(Rdx, state.gprs), read_gpr(Rbx, state.gprs)),
        trans(cong_fn<Nat, Bool>(λ a => Succ(a).leb(read_gpr(Rbx, state.gprs).toNat()), rdx), cong_fn<Nat, Bool>(λ b => Succ(rest).leb(b), rbx)))
}

theorem char_sum(q: Nat): (0 + q) + 48 = 48 + q { omega }
theorem char_fits(q: Nat, small: q < 10): (0 + q) + 48 < Nat::pow(2, 64) { omega }
theorem char_byte(q: Nat, small: q < 10): (48 + q < 256) ∧ (48 + q = (48 + q) + 256 * 0) { ⟨omega, omega⟩ }

// The cursor inside the page, and one past it still a word.
theorem cursor_writable(i: Nat, inside: i < 4096):
    (io_page_base() <= io_page_base() + i) ∧ ((io_page_base() + i) + 1 <= io_page_base() + 4096) { ⟨omega, omega⟩ }
theorem cursor_word(i: Nat, inside: i < 4096): (io_page_base() + i) + 1 < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}

theorem take_rest(q, place, r: Nat): Succ(q) * place + r = (q * place + r) + place {
    let m = Nat::mul_succ_left(q, place);
    j(sym(m), λ t _ => t + r = (q * place + r) + place, { omega })
}

// The loop, by recursion on the subtractions left: `q` more, then out.
fn DigitLoop(memory: IoMemory, at, place, r: Nat, cursor: BitVec(64), q: Nat) → Type {
    (d: Nat) → (state: MachineState<IoMemory>) → d + q < 10 → DigitAt(memory, at, place, q * place + r, d, cursor, state) →
    Exists<MachineState<IoMemory>>(λ out => FetchedSteps(io_fetch_access(), io_data_access(), state, out) ∧
        DigitOut(memory, at, place, r, d + q, cursor, out))
}
theorem digit_loop(memory: IoMemory, at: Nat, dj: DigitJumps, pieces: DigitPieces(memory, at, dj), targets: DigitTargets(at, dj),
    place, r: Nat, small: r < place, cursor: BitVec(64), q: Nat): DigitLoop(memory, at, place, r, cursor, q) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    match q as λ k => DigitLoop(memory, at, place, r, cursor, k) {
        Zero => λ d state few here => {
            let none: (0 * place + r = r) = trans(cong_fn<Nat, Nat>(λ t => t + r, Nat::mul_left_zero(place)), Nat::add_left_zero(r));
            let rest_is: (read_gpr(Rdx, state.gprs).toNat() = r) = trans(here.rdx, none);
            have tested = block_ran(digit_test_block(), memory, dg_at(at, 1), pieces.test_at, state, here.memory_is, here.rip_is);
            let s1 = execute_block_normal(digit_test_block(), state);
            let below: (s1.flags.cf = True) = trans(digit_cf(state, r, place, rest_is, here.rbx), leb_yes(Succ(r), place, small));
            let jb = near_ran(JumpIfNear(B, dj.od), memory, dg_at(at, 2), pieces.jb_at, s1, tested.memory_is, tested.rip_is);
            let s2 = execute_near_control(JumpIfNear(B, dj.od), s1);
            Exists(s2, ⟨fetched_steps_trans(fetch, data, state, s1, s2, tested.steps, jb),
                DigitOut(memory_is := tested.memory_is,
                    rip_is := trans(near_if_taken_rip(B, dj.od, s1, below),
                        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, dj.od), tested.rip_is), targets.out)),
                    rdx := rest_is, rbx := here.rbx, rcx := here.rcx, rdi := here.rdi)⟩)
        },
        Succ(k) => λ d state few here => {
            let rest = k * place + r;
            let more: (read_gpr(Rdx, state.gprs).toNat() = rest + place) = trans(here.rdx, take_rest(k, place, r));
            have tested = block_ran(digit_test_block(), memory, dg_at(at, 1), pieces.test_at, state, here.memory_is, here.rip_is);
            let s1 = execute_block_normal(digit_test_block(), state);
            let enough: (s1.flags.cf = False) = trans(digit_cf(state, rest + place, place, more, here.rbx), leb_no(Succ(rest + place), place, { omega }));
            let jb = near_ran(JumpIfNear(B, dj.od), memory, dg_at(at, 2), pieces.jb_at, s1, tested.memory_is, tested.rip_is);
            let s2 = execute_near_control(JumpIfNear(B, dj.od), s1);
            let s2_rip: (s2.rip = eof_rip(dg_at(at, 3))) =
                trans(near_if_not_taken_rip(B, dj.od, s1, enough), rip_advance(io_entry(), s1.rip, dg_at(at, 2), 6, tested.rip_is));
            have took = block_ran(digit_take_block(), memory, dg_at(at, 3), pieces.take_at, s2, tested.memory_is, s2_rip);
            let s3 = execute_block_normal(digit_take_block(), s2);
            let jmp = near_ran(JumpNear(dj.bd), memory, dg_at(at, 4), pieces.jmp_at, s3, took.memory_is, took.rip_is);
            let s4 = execute_near_control(JumpNear(dj.bd), s3);
            let rdx = read_gpr(Rdx, state.gprs);
            let rbx = read_gpr(Rbx, state.gprs);
            let rcx = read_gpr(Rcx, state.gprs);
            let one = BitVec::ofNat(1, n := 8).sign_extend(56);
            let one_value: (one.toNat() = 1) = ri8_one();
            let taken: (rdx.sub(rbx).toNat() = rest) = {
                let place_is = here.rbx;
                let fits: (rbx.toNat() <= rdx.toNat()) = { omega };
                let difference = bitvec_nat::toNat_sub(64, rdx, rbx, fits);
                let back: ((rdx.toNat() -rbx.toNat()) + rbx.toNat() = rdx.toNat()) = Nat::sub_add_cancel(rbx.toNat(), rdx.toNat(), fits);
                omega
            };
            let counted: (rcx.add(one).toNat() = Succ(d)) = bitvec_nat::add_words(64, rcx, one, d, 1, here.rcx, one_value, { omega });
            let next: DigitAt(memory, at, place, k * place + r, Succ(d), cursor, s4) = DigitAt(
                memory_is := took.memory_is,
                rip_is := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, dj.bd), took.rip_is), targets.back),
                rdx := taken, rbx := here.rbx, rcx := counted, rdi := here.rdi);
            have rest_of = digit_loop(memory, at, dj, pieces, targets, place, r, small, cursor, k)(Succ(d), s4, { omega }, next);
            let order: (Succ(d) + k = d + Succ(k)) = { omega };
            Exists(rest_of.witness, ⟨fetched_steps_trans(fetch, data, state, s1, rest_of.witness, tested.steps,
                    fetched_steps_trans(fetch, data, s1, s2, rest_of.witness, jb,
                        fetched_steps_trans(fetch, data, s2, s3, rest_of.witness, took.steps,
                            fetched_steps_trans(fetch, data, s3, s4, rest_of.witness, jmp, rest_of.proof.left)))),
                j(order, λ e _ => DigitOut(memory, at, place, r, e, cursor, rest_of.witness), rest_of.proof.right)⟩)
        },
    }
}

// One digit, from the entry of the piece: the digit stored at the cursor,
// the cursor past it, the remainder in RDX.
record DigitEmitted(file: List<BitVec(8)>, page: Nat → BitVec(8), at, place, n, o: Nat, state, out: MachineState<IoMemory>) {
    steps: LinuxSteps(io_linux(), state, out),
    memory_is: out.memory = io_store_offset(IoMemory(file, page), o, [digit(n.div(place))]),
    rip_is: out.rip = eof_rip(dg_end(at)),
    rdx: read_gpr(Rdx, out.gprs).toNat() = n.mod(place),
    rbx: read_gpr(Rbx, out.gprs).toNat() = place,
    rdi: read_gpr(Rdi, out.gprs).toNat() = io_page_base() + Succ(o),
}
theorem digit_emit(file: List<BitVec(8)>, page: Nat → BitVec(8), at: Nat, dj: DigitJumps,
    pieces: (page: Nat → BitVec(8)) → DigitPieces(IoMemory(file, page), at, dj), targets: DigitTargets(at, dj),
    place, n, o: Nat, positive: 0 < place, small: n < place * 10, inside: o < 4096,
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = eof_rip(at),
    rdx: read_gpr(Rdx, state.gprs).toNat() = n, rbx: read_gpr(Rbx, state.gprs).toNat() = place,
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + o):
    Exists<MachineState<IoMemory>>(λ out => DigitEmitted(file, page, at, place, n, o, state, out)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let writes = linux_writes(io_linux());
    let memory = IoMemory(file, page);
    let q = n.div(place);
    let r = n.mod(place);
    let q_small: (q < 10) = Nat::div_lt_of_lt_mul(n, place, 10, small);
    let r_small: (r < place) = Nat::mod_lt(n, place, positive);
    have started = block_ran(digit_init_block(), memory, at, pieces(page).init_at, state, memory_is, rip_is);
    let s1 = execute_block_normal(digit_init_block(), state);
    let top: DigitAt(memory, at, place, q * place + r, 0, read_gpr(Rdi, state.gprs), s1) = DigitAt(
        memory_is := started.memory_is, rip_is := started.rip_is,
        rdx := trans(rdx, sym(Nat::div_mul_add_mod(n, place))), rbx := rbx, rcx := refl, rdi := refl);
    have looped = digit_loop(memory, at, dj, pieces(page), targets, place, r, r_small, read_gpr(Rdi, state.gprs), q)(0, s1, { omega }, top);
    let s2 = looped.witness;
    let left = looped.proof.right;
    have charred = block_ran(digit_char_block(), memory, dg_at(at, 5), pieces(page).char_at, s2, left.memory_is, left.rip_is);
    let s3 = execute_block_normal(digit_char_block(), s2);
    let zero_q: (0 + q = q) = Nat::add_left_zero(q);
    let rcx3: (read_gpr(Rcx, s3.gprs).toNat() = 48 + q) =
        trans(bitvec_nat::add_words(64, read_gpr(Rcx, s2.gprs), BitVec::ofNat(48, n := 8).sign_extend(56), 0 + q, 48,
            left.rcx, ri8_char(), char_fits(q, q_small)), char_sum(q));
    let low: (imm_byte0(read_gpr(Rcx, s3.gprs)) = digit(q)) = byte_parts(56, read_gpr(Rcx, s3.gprs), 48 + q, 0, trans(rcx3, char_byte(q, q_small).right), char_byte(q, q_small).left).left;
    let cursor = read_gpr(Rdi, state.gprs);
    let at_cursor: (read_gpr(Rdi, s3.gprs).toNat() = io_page_base() + o) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), left.rdi), rdi);
    let room = cursor_writable(o, inside);
    let writable: IoWritable(s3.memory, read_gpr(Rdi, s3.gprs), 1) =
        ⟨j(sym(at_cursor), λ v _ => io_page_base() <= v, room.left), j(sym(at_cursor), λ v _ => v + 1 <= io_page_base() + 4096, room.right)⟩;
    let s4 = byte_store_after(writes, digit_store(), s3);
    let stored = byte_store_step(fetch, writes, digit_store(), s3, refl,
        FetchedFrom(resident_readable(fetch, s3.memory, byte_store_bytes(digit_store()), s3.rip,
            resident_state(fetch, byte_store_bytes(digit_store()), memory, eof_rip(dg_at(at, 6)), s3, charred.memory_is, charred.rip_is,
                pieces(page).store_at))),
        writable);
    let after = io_store_offset(memory, o, [digit(q)]);
    let s4_memory: (s4.memory = after) =
        trans(cong_fn<IoMemory, IoMemory>(λ m => io_store(m, read_gpr(Rdi, s3.gprs), [imm_byte0(read_gpr(Rcx, s3.gprs))]), charred.memory_is),
            trans(cong_fn<BitVec(8), IoMemory>(λ y => io_store(memory, read_gpr(Rdi, s3.gprs), [y]), low),
                store_at_offset(memory, read_gpr(Rdi, s3.gprs), o, [digit(q)], at_cursor)));
    let s4_rip: (s4.rip = eof_rip(dg_at(at, 7))) = rip_advance(io_entry(), s3.rip, dg_at(at, 6), 3, charred.rip_is);
    have stepped = block_ran(digit_next_block(), IoMemory(file, after.page), dg_at(at, 7), pieces(after.page).next_at, s4, s4_memory, s4_rip);
    let s5 = execute_block_normal(digit_next_block(), s4);
    let rdi5: (read_gpr(Rdi, s5.gprs).toNat() = io_page_base() + Succ(o)) =
        bitvec_nat::add_words(64, read_gpr(Rdi, s4.gprs), BitVec::ofNat(1, n := 8).sign_extend(56), io_page_base() + o, 1,
            at_cursor, ri8_one(), cursor_word(o, inside));
    Exists(s5, DigitEmitted(
        steps := linux_steps_trans(io_linux(), state, s3, s5,
            linux_steps_of_fetched(io_linux(), state, s3,
                fetched_steps_trans(fetch, data, state, s1, s3, started.steps,
                    fetched_steps_trans(fetch, data, s1, s2, s3, looped.proof.left, charred.steps))),
            linux_steps_trans(io_linux(), s3, s4, s5, linux_steps_store(io_linux(), s3, s4, stored),
                linux_steps_of_fetched(io_linux(), s4, s5, stepped.steps))),
        memory_is := trans(pure_block_memory(digit_next_block(), s4), s4_memory),
        rip_is := stepped.rip_is,
        rdx := left.rdx,
        rbx := left.rbx,
        rdi := rdi5))
}

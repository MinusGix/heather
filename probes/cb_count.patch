+++ b/crates/elab/src/ttsimp.rs
@@ -0,0 +1,1437 @@
+//! The δ-free deep simplifier, and the node-count instrument that measured
+//! what it removes (`docs/projected-tuple-tower-design.md`).
+//!
+//! `Elaborator::whnf` spells its answer with the kernel's small-step rewriter,
+//! which fires redexes **at the head only**. A combinator layer whose `Ok`
+//! branch rebuilds `Success(s.value, s.end, s.forward)` therefore leaves three
+//! `Fst`/`Snd`-of-`Pair` redexes per layer, each carrying the whole previous
+//! tuple, and the reduct the elaborator writes into a constructor value's
+//! annotations is exponential in the nesting. Firing those projections — and
+//! β of an applied `Lam`, and `case` of a constructor — everywhere in the
+//! term, with **no δ**, is the candidate D of the design.
+//!
+//! Two entry points, gated by `HEATHER_TT`:
+//!
+//! - `count` — the instrument: [`count_ty`] over the reduct before and after
+//!   [`simp_ty`], printed at `build_ctor`, nothing else changed;
+//! - `fire` — candidate D: `build_ctor` keeps the simplified reduct.
+//!
+//! The walk's binder depths are `crates/elab/src/emission_walk.rs`'s, which
+//! are the ones each variant's doc comment in `crates/kernel/src/term.rs`
+//! states. Arms that cannot carry this tower — code payloads, the code
+//! recursors' motives and branches — are leaves for the *rewrite* and are
+//! still counted.
+
+use std::cell::Cell;
+use std::sync::Arc as Rc;
+use std::sync::OnceLock;
+
+use heather_kernel::level::Level;
+use heather_kernel::term::{LocalCtx, LocalSubst, Term, Type};
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Mode {
+    Off,
+    /// Count only: the simplified reduct is measured and thrown away.
+    Count,
+    /// Candidate D: the simplified reduct is what the emitters see.
+    Fire,
+}
+
+pub(crate) fn mode() -> Mode {
+    static M: OnceLock<Mode> = OnceLock::new();
+    *M.get_or_init(|| match std::env::var("HEATHER_TT").ok().as_deref() {
+        Some("count") => Mode::Count,
+        Some("fire") => Mode::Fire,
+        _ => Mode::Off,
+    })
+}
+
+/// How many redexes one call may fire. A δ-free reduct of a well-typed term
+/// normalizes, so this is a guard against a malformed input and not a policy.
+const FIRE_BUDGET: u64 = 8_000_000;
+
+#[derive(Default, Clone, Copy)]
+pub(crate) struct Counts {
+    pub(crate) nodes: u64,
+    /// `Fst`/`Snd` whose pair is syntactically a `Pair`.
+    pub(crate) proj_on_pair: u64,
+    /// `App` whose function is syntactically a `Lam`.
+    pub(crate) beta: u64,
+    /// `Case` whose scrutinee is syntactically an `Inl`/`Inr`.
+    pub(crate) case_on_ctor: u64,
+}
+
+impl Counts {
+    fn node(&mut self) {
+        self.nodes += 1;
+    }
+}
+
+// -- the instrument -----------------------------------------------------------
+
+pub(crate) fn count_ty(ty: &Type) -> Counts {
+    let mut c = Counts::default();
+    cty(ty, &mut c);
+    c
+}
+
+/// The same tree count over a *term* — the other half of the pair the kernel
+/// is handed (`docs/close-body-family-attribution-design.md`'s instrument).
+pub(crate) fn count_tm(t: &Term) -> Counts {
+    let mut c = Counts::default();
+    ctm(t, &mut c);
+    c
+}
+
+fn ctms(ts: &[Rc<Term>], c: &mut Counts) {
+    for t in ts {
+        ctm(t, c);
+    }
+}
+
+fn cty(ty: &Type, c: &mut Counts) {
+    c.node();
+    match ty {
+        Type::Nat | Type::Ty(_) | Type::SEmpty { .. } | Type::Unit { .. } | Type::Empty { .. } => {}
+        Type::Pi { dom, cod, .. } => {
+            cty(dom, c);
+            cty(cod, c);
+        }
+        Type::UPi { body, .. } | Type::CtxPi { body, .. } | Type::TyPi { body, .. } => cty(body, c),
+        Type::El { tm, .. } => ctm(tm, c),
+        Type::Id { ty, lhs, rhs, .. } | Type::SEq { ty, lhs, rhs, .. } => {
+            cty(ty, c);
+            ctm(lhs, c);
+            ctm(rhs, c);
+        }
+        Type::Squash { ty, .. } => cty(ty, c),
+        Type::Sigma { fst, snd, .. } => {
+            cty(fst, c);
+            cty(snd, c);
+        }
+        Type::Sum { lhs, rhs, .. } => {
+            cty(lhs, c);
+            cty(rhs, c);
+        }
+        Type::W { shape, pos, .. } => {
+            cty(shape, c);
+            cty(pos, c);
+        }
+        Type::Vec { elem, len, .. } => {
+            cty(elem, c);
+            ctm(len, c);
+        }
+        Type::Fin { len } => ctm(len, c),
+        Type::Wf { shape, arity, .. } => {
+            cty(shape, c);
+            ctm(arity, c);
+        }
+        Type::GlobalTy { subst, .. } => ctms(&subst.terms, c),
+        Type::CodeTy { .. } => {}
+        Type::CodeTm { ty, .. } => cty(ty, c),
+    }
+}
+
+fn ctm(t: &Term, c: &mut Counts) {
+    c.node();
+    match t {
+        Term::Var(_)
+        | Term::TmNat
+        | Term::TmTy(_)
+        | Term::Zero
+        | Term::NatLit(_)
+        | Term::TmSEmpty { .. }
+        | Term::TmUnit { .. }
+        | Term::TmEmpty { .. }
+        | Term::Triv { .. } => {}
+        Term::Succ(t) => ctm(t, c),
+        Term::TmPi { dom, cod, .. } => {
+            ctm(dom, c);
+            ctm(cod, c);
+        }
+        Term::TmId { ty, lhs, rhs, .. } | Term::TmSEq { ty, lhs, rhs, .. } => {
+            ctm(ty, c);
+            ctm(lhs, c);
+            ctm(rhs, c);
+        }
+        Term::TmSquash { ty, .. } => ctm(ty, c),
+        Term::TmSigma { fst, snd, .. } => {
+            ctm(fst, c);
+            ctm(snd, c);
+        }
+        Term::TmSum { lhs, rhs, .. } => {
+            ctm(lhs, c);
+            ctm(rhs, c);
+        }
+        Term::TmW { shape, pos, .. } => {
+            ctm(shape, c);
+            ctm(pos, c);
+        }
+        Term::TmVec { elem, len, .. } => {
+            ctm(elem, c);
+            ctm(len, c);
+        }
+        Term::TmFin { len } => ctm(len, c),
+        Term::TmWf { shape, arity, .. } => {
+            ctm(shape, c);
+            ctm(arity, c);
+        }
+        Term::ElimNat {
+            motive,
+            base,
+            step,
+            scrut,
+            ..
+        } => {
+            cty(motive, c);
+            ctm(base, c);
+            ctm(step, c);
+            ctm(scrut, c);
+        }
+        Term::Refl { ty, tm, .. } | Term::SRefl { ty, tm, .. } | Term::Squash { ty, tm, .. } => {
+            cty(ty, c);
+            ctm(tm, c);
+        }
+        Term::J {
+            ty,
+            lhs,
+            motive,
+            case,
+            rhs,
+            proof,
+            ..
+        } => {
+            cty(ty, c);
+            cty(motive, c);
+            ctm(lhs, c);
+            ctm(case, c);
+            ctm(rhs, c);
+            ctm(proof, c);
+        }
+        Term::Transp {
+            ty,
+            motive,
+            lhs,
+            rhs,
+            proof,
+            tm,
+            ..
+        } => {
+            cty(ty, c);
+            cty(motive, c);
+            ctm(lhs, c);
+            ctm(rhs, c);
+            ctm(proof, c);
+            ctm(tm, c);
+        }
+        Term::ElimSEmpty { motive, scrut, .. } | Term::ElimEmpty { motive, scrut, .. } => {
+            cty(motive, c);
+            ctm(scrut, c);
+        }
+        Term::ElimSquash {
+            src_ty,
+            motive,
+            case,
+            scrut,
+            ..
+        } => {
+            cty(src_ty, c);
+            cty(motive, c);
+            ctm(case, c);
+            ctm(scrut, c);
+        }
+        Term::Pair {
+            fst_ty,
+            snd_ty,
+            fst,
+            snd,
+            ..
+        } => {
+            cty(fst_ty, c);
+            cty(snd_ty, c);
+            ctm(fst, c);
+            ctm(snd, c);
+        }
+        Term::Fst {
+            fst_ty,
+            snd_ty,
+            pair,
+            ..
+        }
+        | Term::Snd {
+            fst_ty,
+            snd_ty,
+            pair,
+            ..
+        } => {
+            if matches!(&**pair, Term::Pair { .. }) {
+                c.proj_on_pair += 1;
+            }
+            cty(fst_ty, c);
+            cty(snd_ty, c);
+            ctm(pair, c);
+        }
+        Term::Inl { lhs, rhs, val, .. } | Term::Inr { lhs, rhs, val, .. } => {
+            cty(lhs, c);
+            cty(rhs, c);
+            ctm(val, c);
+        }
+        Term::Case {
+            lhs,
+            rhs,
+            motive,
+            case_l,
+            case_r,
+            scrut,
+            ..
+        } => {
+            if matches!(&**scrut, Term::Inl { .. } | Term::Inr { .. }) {
+                c.case_on_ctor += 1;
+            }
+            cty(lhs, c);
+            cty(rhs, c);
+            cty(motive, c);
+            ctm(case_l, c);
+            ctm(case_r, c);
+            ctm(scrut, c);
+        }
+        Term::Sup {
+            shape_ty,
+            pos_ty,
+            label,
+            children,
+            ..
+        } => {
+            cty(shape_ty, c);
+            cty(pos_ty, c);
+            ctm(label, c);
+            ctm(children, c);
+        }
+        Term::ElimW {
+            shape,
+            pos,
+            motive,
+            step,
+            scrut,
+            ..
+        } => {
+            cty(shape, c);
+            cty(pos, c);
+            cty(motive, c);
+            ctm(step, c);
+            ctm(scrut, c);
+        }
+        Term::Supf {
+            shape,
+            arity,
+            label,
+            children,
+            ..
+        } => {
+            cty(shape, c);
+            ctm(arity, c);
+            ctm(label, c);
+            ctm(children, c);
+        }
+        Term::ElimWf {
+            shape,
+            arity,
+            motive,
+            step,
+            scrut,
+            ..
+        } => {
+            cty(shape, c);
+            ctm(arity, c);
+            cty(motive, c);
+            ctm(step, c);
+            ctm(scrut, c);
+        }
+        Term::Lam { dom, body, .. } => {
+            cty(dom, c);
+            ctm(body, c);
+        }
+        Term::App {
+            fun,
+            dom,
+            cod,
+            arg,
+            ..
+        } => {
+            if matches!(&**fun, Term::Lam { .. }) {
+                c.beta += 1;
+            }
+            cty(dom, c);
+            cty(cod, c);
+            ctm(fun, c);
+            ctm(arg, c);
+        }
+        Term::ULam { body, .. } => ctm(body, c),
+        Term::UApp { fun, .. } => ctm(fun, c),
+        Term::GlobalTm { subst, .. } => ctms(&subst.terms, c),
+        Term::CtxLam { body, .. } => ctm(body, c),
+        Term::CtxApp { fun, .. } => ctm(fun, c),
+        Term::TyLam { body, .. } => ctm(body, c),
+        Term::TyApp { fun, arg } => {
+            cty(arg, c);
+            ctm(fun, c);
+        }
+        Term::BoxTy(ty) => cty(ty, c),
+        Term::BoxTm(tm) => ctm(tm, c),
+        Term::LetBoxTy {
+            motive,
+            body,
+            scrut,
+            ..
+        } => {
+            cty(motive, c);
+            ctm(body, c);
+            ctm(scrut, c);
+        }
+        Term::LetBoxTm {
+            ty,
+            motive,
+            body,
+            scrut,
+            ..
+        } => {
+            cty(ty, c);
+            cty(motive, c);
+            ctm(body, c);
+            ctm(scrut, c);
+        }
+        Term::ElimCodeTy { scrut, .. } => ctm(scrut, c),
+        Term::ElimCodeTm { ty, scrut, .. } => {
+            cty(ty, c);
+            ctm(scrut, c);
+        }
+    }
+}
+
+/// The one call site: `build_ctor`'s reduct, after the elaborator's whnf and
+/// before `spine`/`respell_spine`/`build_fields_skel` read components out of
+/// it. `Off` is the parent's behaviour to the byte.
+pub(crate) fn at_build_ctor(gamma: &LocalCtx, expected: Type) -> Type {
+    match mode() {
+        Mode::Off => expected,
+        Mode::Count => {
+            let pre = count_ty(&expected);
+            let t0 = std::time::Instant::now();
+            let fired = simp_ty(gamma, &expected);
+            let us = t0.elapsed().as_micros();
+            let post = count_ty(fired.as_ref().unwrap_or(&expected));
+            let (m, i) = crate::stats::current_item().unwrap_or(("-".into(), "-".into()));
+            eprintln!(
+                "tt count item={m}::{i} nodes={} -> {} proj={} -> {} beta={} -> {} case={} -> {} us={us}",
+                pre.nodes,
+                post.nodes,
+                pre.proj_on_pair,
+                post.proj_on_pair,
+                pre.beta,
+                post.beta,
+                pre.case_on_ctor,
+                post.case_on_ctor,
+            );
+            expected
+        }
+        Mode::Fire => simp_ty(gamma, &expected).unwrap_or(expected),
+    }
+}
+
+// -- the simplifier -----------------------------------------------------------
+
+/// The δ-free deep simplification of `ty` in `gamma`, or `None` when nothing
+/// fired (so the caller keeps its original and its sharing).
+pub(crate) fn simp_ty(gamma: &LocalCtx, ty: &Type) -> Option<Type> {
+    let s = Simp {
+        budget: Cell::new(FIRE_BUDGET),
+    };
+    s.ty(gamma, ty)
+}
+
+struct Simp {
+    budget: Cell<u64>,
+}
+
+fn or_ty(orig: &Rc<Type>, new: Option<Type>) -> Rc<Type> {
+    match new {
+        Some(t) => Rc::new(t),
+        None => Rc::clone(orig),
+    }
+}
+
+fn or_tm(orig: &Rc<Term>, new: Option<Term>) -> Rc<Term> {
+    match new {
+        Some(t) => Rc::new(t),
+        None => Rc::clone(orig),
+    }
+}
+
+/// One more binder of Γ. Only the context's **length** is read (every rule
+/// here builds `LocalSubst::id(gamma)`), so the entry's type is a filler.
+fn under(gamma: &LocalCtx) -> LocalCtx {
+    gamma.extended(Rc::new(Type::Nat), Level::Zero)
+}
+
+impl Simp {
+    fn spend(&self) -> bool {
+        let left = self.budget.get();
+        if left == 0 {
+            return false;
+        }
+        self.budget.set(left - 1);
+        true
+    }
+
+    fn tms(&self, g: &LocalCtx, ts: &[Rc<Term>]) -> Option<Vec<Rc<Term>>> {
+        let mut out: Option<Vec<Rc<Term>>> = None;
+        for (i, t) in ts.iter().enumerate() {
+            let Some(n) = self.tm(g, t) else { continue };
+            let v = out.get_or_insert_with(|| ts.to_vec());
+            v[i] = Rc::new(n);
+        }
+        out
+    }
+
+    fn ty(&self, g: &LocalCtx, ty: &Type) -> Option<Type> {
+        match ty {
+            Type::Nat
+            | Type::Ty(_)
+            | Type::SEmpty { .. }
+            | Type::Unit { .. }
+            | Type::Empty { .. }
+            | Type::CodeTy { .. } => None,
+            Type::Pi {
+                dom_level,
+                cod_level,
+                dom,
+                cod,
+            } => {
+                let nd = self.ty(g, dom);
+                let nc = self.ty(&under(g), cod);
+                if nd.is_none() && nc.is_none() {
+                    return None;
+                }
+                Some(Type::Pi {
+                    dom_level: dom_level.clone(),
+                    cod_level: cod_level.clone(),
+                    dom: or_ty(dom, nd),
+                    cod: or_ty(cod, nc),
+                })
+            }
+            Type::UPi {
+                num_vars,
+                level,
+                body,
+            } => Some(Type::UPi {
+                num_vars: *num_vars,
+                level: level.clone(),
+                body: Rc::new(self.ty(g, body)?),
+            }),
+            Type::El { level, tm } => Some(Type::El {
+                level: level.clone(),
+                tm: Rc::new(self.tm(g, tm)?),
+            }),
+            Type::Id {
+                level,
+                ty,
+                lhs,
+                rhs,
+            } => {
+                let nt = self.ty(g, ty);
+                let nl = self.tm(g, lhs);
+                let nr = self.tm(g, rhs);
+                if nt.is_none() && nl.is_none() && nr.is_none() {
+                    return None;
+                }
+                Some(Type::Id {
+                    level: level.clone(),
+                    ty: or_ty(ty, nt),
+                    lhs: or_tm(lhs, nl),
+                    rhs: or_tm(rhs, nr),
+                })
+            }
+            Type::SEq {
+                level,
+                ty,
+                lhs,
+                rhs,
+            } => {
+                let nt = self.ty(g, ty);
+                let nl = self.tm(g, lhs);
+                let nr = self.tm(g, rhs);
+                if nt.is_none() && nl.is_none() && nr.is_none() {
+                    return None;
+                }
+                Some(Type::SEq {
+                    level: level.clone(),
+                    ty: or_ty(ty, nt),
+                    lhs: or_tm(lhs, nl),
+                    rhs: or_tm(rhs, nr),
+                })
+            }
+            Type::Squash { level, ty } => Some(Type::Squash {
+                level: level.clone(),

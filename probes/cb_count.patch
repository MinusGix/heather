+    fn tm(&self, g: &LocalCtx, t: &Term) -> Option<Term> {
+        let rebuilt = self.tm_children(g, t);
+        let here = rebuilt.as_ref().unwrap_or(t);
+        // …and then the head, on the rebuilt children: firing a projection
+        // exposes the next one (`Fst(Snd(Pair(…Pair…)))`), which is the whole
+        // point of a bottom-up pass.
+        match self.fire(g, here) {
+            Some(fired) => Some(self.tm(g, &fired).unwrap_or(fired)),
+            None => rebuilt,
+        }
+    }
+
+    /// The three rules, and only these three: no δ, no `El` decode, no `Vec`
+    /// or `Fin` unrolling, no `Nat`/`W`/`Wf` recursor.
+    fn fire(&self, g: &LocalCtx, t: &Term) -> Option<Term> {
+        let out = match t {
+            Term::Fst { pair, .. } => match &**pair {
+                Term::Pair { fst, .. } => (**fst).clone(),
+                _ => return None,
+            },
+            Term::Snd { pair, .. } => match &**pair {
+                Term::Pair { snd, .. } => (**snd).clone(),
+                _ => return None,
+            },
+            Term::App { fun, arg, .. } => match &**fun {
+                Term::Lam { body, .. } => {
+                    body.apply_local(&LocalSubst::id(g).extended(Rc::clone(arg)))
+                }
+                _ => return None,
+            },
+            Term::Case {
+                case_l,
+                case_r,
+                scrut,
+                ..
+            } => match &**scrut {
+                Term::Inl { val, .. } => {
+                    case_l.apply_local(&LocalSubst::id(g).extended(Rc::clone(val)))
+                }
+                Term::Inr { val, .. } => {
+                    case_r.apply_local(&LocalSubst::id(g).extended(Rc::clone(val)))
+                }
+                _ => return None,
+            },
+            _ => return None,
+        };
+        if !self.spend() {
+            return None;
+        }
+        Some(out)
+    }
+

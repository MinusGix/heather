+                let nsc = self.tm(g, scrut);
+                if nsh.is_none() && np.is_none() && nm.is_none() && nst.is_none() && nsc.is_none() {
+                    return None;
+                }
+                Some(Term::ElimW {
+                    shape_level: shape_level.clone(),
+                    pos_level: pos_level.clone(),
+                    motive_level: motive_level.clone(),
+                    shape: or_ty(shape, nsh),
+                    pos: or_ty(pos, np),
+                    motive: or_ty(motive, nm),
+                    step: or_tm(step, nst),
+                    scrut: or_tm(scrut, nsc),
+                })
+            }
+            Term::Supf {
+                level,
+                shape,
+                arity,
+                label,
+                children,
+            } => {
+                let nsh = self.ty(g, shape);
+                let na = self.tm(&under(g), arity);
+                let nl = self.tm(g, label);
+                let nc = self.tm(g, children);
+                if nsh.is_none() && na.is_none() && nl.is_none() && nc.is_none() {
+                    return None;
+                }
+                Some(Term::Supf {
+                    level: level.clone(),
+                    shape: or_ty(shape, nsh),
+                    arity: or_tm(arity, na),
+                    label: or_tm(label, nl),
+                    children: or_tm(children, nc),
+                })
+            }
+            Term::ElimWf {
+                level,
+                motive_level,
+                shape,
+                arity,
+                motive,
+                step,
+                scrut,
+            } => {
+                let nsh = self.ty(g, shape);
+                let na = self.tm(&under(g), arity);
+                let nm = self.ty(&under(g), motive);
+                let nst = self.tm(&under(&under(&under(g))), step);
+                let nsc = self.tm(g, scrut);
+                if nsh.is_none() && na.is_none() && nm.is_none() && nst.is_none() && nsc.is_none() {
+                    return None;
+                }
+                Some(Term::ElimWf {
+                    level: level.clone(),
+                    motive_level: motive_level.clone(),
+                    shape: or_ty(shape, nsh),
+                    arity: or_tm(arity, na),
+                    motive: or_ty(motive, nm),
+                    step: or_tm(step, nst),
+                    scrut: or_tm(scrut, nsc),
+                })
+            }
+            Term::Lam {
+                dom_level,
+                cod_level,
+                dom,
+                body,
+            } => {
+                let nd = self.ty(g, dom);
+                let nb = self.tm(&under(g), body);
+                if nd.is_none() && nb.is_none() {
+                    return None;
+                }
+                Some(Term::Lam {
+                    dom_level: dom_level.clone(),
+                    cod_level: cod_level.clone(),
+                    dom: or_ty(dom, nd),
+                    body: or_tm(body, nb),
+                })
+            }
+            Term::App {
+                fun,
+                dom_level,
+                cod_level,
+                dom,
+                cod,
+                arg,
+            } => {
+                let nd = self.ty(g, dom);
+                let nc = self.ty(&under(g), cod);
+                let nf = self.tm(g, fun);
+                let na = self.tm(g, arg);
+                if nd.is_none() && nc.is_none() && nf.is_none() && na.is_none() {
+                    return None;
+                }
+                Some(Term::App {
+                    fun: or_tm(fun, nf),
+                    dom_level: dom_level.clone(),
+                    cod_level: cod_level.clone(),
+                    dom: or_ty(dom, nd),
+                    cod: or_ty(cod, nc),
+                    arg: or_tm(arg, na),
+                })
+            }
+            // Universe and meta binders extend L or Ψ, never Γ.
+            Term::ULam {
+                num_vars,
+                level,
+                body,
+            } => Some(Term::ULam {
+                num_vars: *num_vars,
+                level: level.clone(),
+                body: Rc::new(self.tm(g, body)?),
+            }),
+            Term::UApp { fun, levels } => Some(Term::UApp {
+                fun: Rc::new(self.tm(g, fun)?),
+                levels: levels.clone(),
+            }),
+            Term::GlobalTm { var, subst } => {
+                let terms = self.tms(g, &subst.terms)?;
+                let mut subst = subst.clone();
+                subst.terms = terms;
+                Some(Term::GlobalTm { var: *var, subst })
+            }
+            Term::CtxLam { level, body } => Some(Term::CtxLam {
+                level: level.clone(),
+                body: Rc::new(self.tm(g, body)?),
+            }),
+            Term::CtxApp { fun, ctx } => Some(Term::CtxApp {
+                fun: Rc::new(self.tm(g, fun)?),
+                ctx: ctx.clone(),
+            }),
+            Term::TyLam {
+                ctx,
+                arg_level,
+                body_level,
+                body,
+            } => Some(Term::TyLam {
+                ctx: ctx.clone(),
+                arg_level: arg_level.clone(),
+                body_level: body_level.clone(),
+                body: Rc::new(self.tm(g, body)?),
+            }),
+            Term::TyApp { fun, arg } => {
+                let na = self.ty(g, arg);
+                let nf = self.tm(g, fun);
+                if na.is_none() && nf.is_none() {
+                    return None;
+                }
+                Some(Term::TyApp {
+                    fun: or_tm(fun, nf),
+                    arg: or_ty(arg, na),
+                })
+            }
+        }
+    }
+}

// cp6 — the BASE with the function-typed `relation` parameter replaced by a
// named relation of the file's own, `T`/`A` still open: does the cost follow
// the open relation PARAMETER or the shape it is used in?
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPR<T,A>(source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    nat::Le(begin.offset, end.offset)
}
theorem cp_fixed<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat):
    Post(source,begin,CPR<T,A>,r) -> Post(source,begin,CompleteSpec<T,A>(CPR<T,A>),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(h,shape), Cons(head,tail) => trivial,
    } }
}

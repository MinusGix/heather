// cp13 — cp7 with `logic::And` replaced by a record of the probe file's own,
// same two fields, same instantiation: is the cost `And` in particular, or any
// two-field record at these arguments?
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

record CPPair<P,Q> { fst_of: P, snd_of: Q }
fn CPBoth<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    CPPair<relation(source,begin,end,value),rest(source,end) = Nil<T>>
}
theorem cp_both<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPBoth<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => CPPair(h,shape), Cons(head,tail) => trivial,
    } }
}

import logic;
import nat;
import list;
inductive Tree { Leaf(n: Nat), Node(l: Tree, r: Tree) }
fn flat(t: Tree, tail: List<Nat>) → List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => flat(l, flat(r, tail)) }
}
fn Tree::flat_m(self t: Tree, tail: List<Nat>) → List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => l.flat_m(r.flat_m(tail)) }
}
fn Tree::flat_q(self t: Tree, tail: List<Nat>) → List<Nat> {
    match t { Leaf(n) => Cons(n, tail), Node(l, r) => Tree::flat_q(l, Tree::flat_q(r, tail)) }
}
fn Tree::size(self t: Tree) → Nat { match t { Leaf(_) => 1, Node(l, r) => l.size() + r.size() } }
fn Tree::size_q(self t: Tree) → Nat { match t { Leaf(_) => 1, Node(l, r) => Tree::size_q(l) + Tree::size_q(r) } }
fn use_q(t: Tree) → Nat { Tree::size_q(t) }

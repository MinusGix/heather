// `t_cb4` on `Success` instead of `Certified`: the same three chained
// receivers and the same two chained `le_trans`, on a telescoped dependent
// record whose parameters are all VALUE-typed (`source`, `begin`). The one
// difference from `t_cb4` is `Certified`'s function-typed `relation`.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

inductive STok { SA, SB }
fn sb_nofold(source: List<STok>, begin: Cursor<STok>(source),
    op: Success<STok,Nat>(source,begin),
    inner: Success<STok,Nat>(source,op.end),
    close: Success<STok,Nat>(source,inner.end)) -> Success<STok,Nat>(source,begin) {
    Success(inner.value,close.end,
        nat::le_trans(begin.offset,op.end.offset,close.end.offset,op.forward,
            nat::le_trans(op.end.offset,inner.end.offset,close.end.offset,inner.forward,close.forward)))
}

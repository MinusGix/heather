// cp19 — the decisive test of "it is the argument SLOT", and at the same time
// the library respelling the design has to cost: the two conjuncts move out of
// `And`'s TYPE-argument slots and become the FIELD types of a telescoped
// dependent record whose parameters are all VALUE parameters. Exactly the
// shape `parser_contracts::Certified` already has. Nothing else changes.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

record CPRec<T,A>(relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) {
    left: relation(source,begin,end,value),
    right: rest(source,end) = Nil<T>,
}
fn CPSpecR<T,A>(relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    CPRec<T,A>(relation,source,begin,end,value)
}
theorem cp_rec<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPSpecR<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => CPRec(h,shape), Cons(head,tail) => trivial,
    } }
}

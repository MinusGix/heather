// cp17 — the argument slot at its SMALLEST binder-dependent occupant:
// `nat::Le(begin.offset,end.offset)`, a two-argument global applied to two
// projections. No equation, no relation parameter, no computed list. If this
// costs what cp9 and cp12 cost, the payer is the slot's DEPENDENCE on the
// enclosing binders and not anything written in it.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPLe<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<nat::Le(begin.offset,end.offset),True>
}
theorem cp_le<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPLe<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(s.forward,trivial), Cons(head,tail) => trivial,
    } }
}

// cp2 — BASE minus `CompleteSpec`: the conclusion's relation is the plain
// parameter instead of the quoted `→ Type` composition. Everything else,
// including both matches and the whole `bind_at(map_at(eof_at))` reply, is
// the base's. What this subtracts from cp1 is the CompleteSpec spelling.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

theorem cp_plain<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,relation,
        bind_at<T,A,A>(source,begin,r,λ value middle forward => map_at(source,middle,eof_at(expected,source,middle),λ (ignored: Nat) => value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => h, Cons(head,tail) => trivial,
    } }
}

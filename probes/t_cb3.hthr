// `t_cb1` with the chain gone (one receiver, no `le_trans`): the floor., on the real library `Certified` (whose third value
// parameter is FUNCTION-typed): three chained receivers, a `result::fold` over
// a recognized reply, and an `Ok(Certified(...))` whose `forward` field is two
// chained `le_trans` over projected cursors.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

inductive CTok { CA, CB }
fn CR(source: List<CTok>, begin: Cursor<CTok>(source), end: Cursor<CTok>(source), value: Nat) -> Type {
    nat::Le(begin.offset, end.offset)
}
fn cb_one(source: List<CTok>, begin: Cursor<CTok>(source),
    r: Result<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source)>)
    -> Result<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source)> {
    result::fold<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source),Result<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source)>>(r,
        λ (close: Certified<CTok,Nat>(source,begin,CR)) =>
            Ok(Certified(close.value,close.end,close.forward,close.forward)),
        λ (e: Failure<CTok>(source)) => Err(e))
}

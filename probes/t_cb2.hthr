// `t_cb1` with ONE chained receiver removed (two receivers, one `le_trans`):
// the growth axis of the chain., on the real library `Certified` (whose third value
// parameter is FUNCTION-typed): three chained receivers, a `result::fold` over
// a recognized reply, and an `Ok(Certified(...))` whose `forward` field is two
// chained `le_trans` over projected cursors.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

inductive CTok { CA, CB }
fn CR(source: List<CTok>, begin: Cursor<CTok>(source), end: Cursor<CTok>(source), value: Nat) -> Type {
    nat::Le(begin.offset, end.offset)
}
fn cb_two(source: List<CTok>, begin: Cursor<CTok>(source),
    op: Certified<CTok,Nat>(source,begin,CR),
    r: Result<Certified<CTok,Nat>(source,op.end,CR),Failure<CTok>(source)>)
    -> Result<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source)> {
    result::fold<Certified<CTok,Nat>(source,op.end,CR),Failure<CTok>(source),Result<Certified<CTok,Nat>(source,begin,CR),Failure<CTok>(source)>>(r,
        λ (close: Certified<CTok,Nat>(source,op.end,CR)) =>
            Ok(Certified(op.value,close.end,
                nat::le_trans(begin.offset,op.end.offset,close.end.offset,op.forward,close.forward),
                nat::le_trans(begin.offset,op.end.offset,close.end.offset,op.forward,close.forward))),
        λ (e: Failure<CTok>(source)) => Err(e))
}

// The facts `bv_omega` builds, one per word (docs/bv-omega-design.md §2). A
// word's value is stated as `w.toNat() + q = p`, with `p` and `q` over the
// words the tactic does not take apart; `+ q` keeps a difference in Nat. Each
// lemma takes its operands' facts, the bound that says the operation does not
// wrap, and the arithmetic that normalises the result, and states the word's
// fact. The arithmetic is proved here, once, over variables.
import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;

theorem add_arith(x, y, px, nx, py, ny, p, q, top: Nat, hx: x + nx = px, hy: y + ny = py,
    bound: px + py < top + (nx + ny), norm: px + py + q = p + (nx + ny)): (x + y < top) ∧ (x + y + q = p) {
    ⟨omega, omega⟩
}

theorem sub_arith_fits(x, y, px, nx, py, ny: Nat, hx: x + nx = px, hy: y + ny = py, fits: py + nx <= px + ny): y <= x { omega }

theorem sub_arith(x, y, d, px, nx, py, ny, p, q: Nat, hx: x + nx = px, hy: y + ny = py, back: d + y = x,
    fits: py + nx <= px + ny, norm: px + ny + q = p + (nx + py)): d + q = p {
    omega
}

// A word the tactic does not take apart is its own value.
theorem leaf_affine(n: Nat, a: BitVec(n)): a.toNat() + 0 = a.toNat() { refl }

theorem add_affine(n: Nat, a, b: BitVec(n), pa, na, pb, nb, p, q: Nat,
    ha: a.toNat() + na = pa, hb: b.toNat() + nb = pb,
    bound: pa + pb < Nat::pow(2, n) + (na + nb), norm: pa + pb + q = p + (na + nb)):
    a.add(b).toNat() + q = p {
    let facts = add_arith(a.toNat(), b.toNat(), pa, na, pb, nb, p, q, Nat::pow(2, n), ha, hb, bound, norm);
    j(sym(bitvec_nat::toNat_add(n, a, b, facts.left)), λ v _ => v + q = p, facts.right)
}

theorem sub_affine(n: Nat, a, b: BitVec(n), pa, na, pb, nb, p, q: Nat,
    ha: a.toNat() + na = pa, hb: b.toNat() + nb = pb,
    fits: pb + na <= pa + nb, norm: pa + nb + q = p + (na + pb)):
    a.sub(b).toNat() + q = p {
    let d = a.toNat() -b.toNat();
    let le = sub_arith_fits(a.toNat(), b.toNat(), pa, na, pb, nb, ha, hb, fits);
    j(sym(bitvec_nat::toNat_sub(n, a, b, le)), λ v _ => v + q = p,
        sub_arith(a.toNat(), b.toNat(), d, pa, na, pb, nb, p, q, ha, hb, Nat::sub_add_cancel(b.toNat(), a.toNat(), le), fits, norm))
}

theorem ofNat_affine(n, c, p, q: Nat, bound: c < Nat::pow(2, n), norm: c + q = p): BitVec::ofNat(c, n := n).toNat() + q = p {
    j(sym(BitVec::toNat_ofNat(n, c, bound)), λ v _ => v + q = p, norm)
}

theorem word_of_nat_affine(n, c, p, q: Nat, bound: c < Nat::pow(2, n), norm: c + q = p): bitvec_nat::word_of_nat(n, c).toNat() + q = p {
    j(sym(bitvec_nat::toNat_word_of_nat(n, c, bound)), λ v _ => v + q = p, norm)
}

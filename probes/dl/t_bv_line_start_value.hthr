import bitvec;
import logic;
import nat;
import omega;
import bitvec_nat;
import bitvec_omega;
import decimal_line;

theorem bv_line_start_value(n: Nat, small: n < 10000):
    line_start(BitVec::ofNat(0x401000), bitvec_nat::word_of_nat(64, n)).toNat() = 0x401000 + line_skip(n) {
    let skip = line_skip_le(n);
    let zeros = leading_zeros_value(n, small);
    bv_omega
}


import bv_decide;

// The length of the UTF-8 sequence that begins with the byte `lead` and
// goes on with `next1`, `next2` and `next3`, by Unicode's table of
// well-formed byte sequences (Table 3-7), or 0 when they begin none. After
// a lead byte each byte is a continuation `80..BF`, except the second
// after `E0` (`A0..BF`), `ED` (`80..9F`), `F0` (`90..BF`) and `F4`
// (`80..8F`): those narrower ranges rule out overlong values, surrogates
// and values past 0x10FFFF. The bytes come in as words, the only thing a
// compiled function takes yet, and are compared as bytes.
runtime fn sequence_length(lead, next1, next2, next3: u64) → u64 {
    let b = lead.truncate(8, 56);
    let c1 = next1.truncate(8, 56);
    let c2 = next2.truncate(8, 56);
    let c3 = next3.truncate(8, 56);
    if b < 0x80 {
        1
    } else if b < 0xC2 {
        0
    } else if b < 0xE0 {
        if c1 & 0xC0 = 0x80 { 2 } else { 0 }
    } else if b < 0xF0 {
        if c1 & 0xC0 = 0x80 ∧ c2 & 0xC0 = 0x80 ∧ (b ≠ 0xE0 ∨ 0xA0 <= c1) ∧ (b ≠ 0xED ∨ c1 < 0xA0) { 3 } else { 0 }
    } else if b < 0xF5 {
        if c1 & 0xC0 = 0x80 ∧ c2 & 0xC0 = 0x80 ∧ c3 & 0xC0 = 0x80 ∧ (b ≠ 0xF0 ∨ 0x90 <= c1) ∧ (b ≠ 0xF4 ∨ c1 < 0x90) { 4 } else { 0 }
    } else {
        0
    }
}

// The length of the sequence the `n` bytes of `s` begin at offset `i`. A
// read past the end is 0, which continues no sequence.
runtime fn sequence_at(s: List<u8>, n, i: u64) → u64 {
    sequence_length(↑s.byte_within(n, i), ↑s.byte_within(n, i + 1), ↑s.byte_within(n, i + 2), ↑s.byte_within(n, i + 3))
}

// The offset of the first byte from `i` that begins no UTF-8 sequence, or
// `n` when the bytes from `i` are UTF-8 to the end; `left` is `n - i`. A
// sequence the bytes end inside of is not one.
runtime fn utf8_valid_from(s: List<u8>, n, i, left: u64) → u64 decreases left.toNat() {
    if h: 0 < left {
        let k = sequence_at(s, n, i);
        if k = 1 {
            utf8_valid_from(s, n, i + 1, left - 1)
        } else if k = 2 {
            if room: 1 < left { utf8_valid_from(s, n, i + 2, left - 2) } else { i }
        } else if k = 3 {
            if room: 2 < left { utf8_valid_from(s, n, i + 3, left - 3) } else { i }
        } else if k = 4 {
            if room: 3 < left { utf8_valid_from(s, n, i + 4, left - 4) } else { i }
        } else {
            i
        }
    } else {
        i
    }
}

// The length of the longest prefix of the `n` bytes of `s` that is UTF-8:
// `n` exactly when all of them are.
runtime fn utf8_valid_up_to(s: List<u8>, n: u64) → u64 { utf8_valid_from(s, n, 0, n) }

// ---------------------------------------------------------------------------
// Why it is right: the table against the strict decoder `utf8::decode`

// The decoder emits a character exactly when the value is not overlong and
// is a scalar value.
theorem emit_is_some(min, code: Nat, r: List<u8>): utf8::emit(min, code, r).is_some() = (min.leb(code) && char::is_scalar(code)) {
    split_all; all_goals { refl }
}

// The scalar value a sequence spells, as the decoder assembles it.
fn code2(b, c1: u8) → Nat { utf8::cont_payload(c1).concat(utf8::lead2_payload(b)).toNat() }
fn code3(b, c1, c2: u8) → Nat { utf8::cont_payload(c2).concat(utf8::cont_payload(c1).concat(utf8::lead3_payload(b))).toNat() }
fn code4(b, c1, c2, c3: u8) → Nat {
    utf8::cont_payload(c3).concat(utf8::cont_payload(c2).concat(utf8::cont_payload(c1).concat(utf8::lead4_payload(b)))).toNat()
}

// Whether a byte is a continuation byte, `10xxxxxx`.
fn cont(c: u8) → Bool { utf8::bit7(c) && !utf8::bit6(c) }

// The decoder takes a sequence exactly when each byte after the lead is a
// continuation and the value they spell is emitted.
theorem seq2_is_some(b, c1: u8, r: List<u8>):
    utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() = (cont(c1) && utf8::emit(0x80, code2(b, c1), r).is_some()) {
    split_all; all_goals { refl }
}
theorem seq3_is_some(b, c1, c2: u8, r: List<u8>):
    utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() = ((cont(c1) && cont(c2)) && utf8::emit(0x800, code3(b, c1, c2), r).is_some()) {
    split_all; all_goals { refl }
}
theorem seq4_is_some(b, c1, c2, c3: u8, r: List<u8>):
    utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some()
        = (((cont(c1) && cont(c2)) && cont(c3)) && utf8::emit(0x10000, code4(b, c1, c2, c3), r).is_some()) {
    split_all; all_goals { refl }
}

// A sequence the table takes the decoder takes, and one the table refuses
// after a lead of that length the decoder refuses: `bv_decide` reads the
// table's tests and the decoder's arithmetic as one circuit on the four
// bytes.
theorem two_takes(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 2): utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() = True {
    rewrite(seq2_is_some, emit_is_some, by bv_decide())
}
theorem two_refuses(b, c1, c2, c3: u8, r: List<u8>, t: ¬(b < 0xC0), u: b < 0xE0, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) ≠ 2):
    utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() = False {
    rewrite(seq2_is_some, emit_is_some, by bv_decide())
}
theorem three_takes(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 3): utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() = True {
    rewrite(seq3_is_some, emit_is_some, by bv_decide())
}
theorem three_refuses(b, c1, c2, c3: u8, r: List<u8>, t: ¬(b < 0xE0), u: b < 0xF0, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) ≠ 3):
    utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() = False {
    rewrite(seq3_is_some, emit_is_some, by bv_decide())
}
theorem four_takes(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 4): utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some() = True {
    rewrite(seq4_is_some, emit_is_some, by bv_decide())
}
theorem four_refuses(b, c1, c2, c3: u8, r: List<u8>, t: ¬(b < 0xF0), u: b < 0xF8, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) ≠ 4):
    utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some() = False {
    rewrite(seq4_is_some, emit_is_some, by bv_decide())
}

// The length the table answers says which lead byte it read.
theorem length_one(b, c1, c2, c3: u8, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 1): b < 0x80 { by bv_decide() }
theorem length_two(b, c1, c2, c3: u8, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 2): ¬(b < 0xC0) ∧ b < 0xE0 { by bv_decide() }
theorem length_three(b, c1, c2, c3: u8, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 3): ¬(b < 0xE0) ∧ b < 0xF0 { by bv_decide() }
theorem length_four(b, c1, c2, c3: u8, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 4): ¬(b < 0xF0) ∧ b < 0xF8 { by bv_decide() }
theorem length_ascii(b, c1, c2, c3: u8, t: b < 0x80): sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 1 { by bv_decide() }

// ---------------------------------------------------------------------------
// The lead byte's class, from tests on it: the decoder reads the top bits,
// and `bv_decide` proves each from the tests.

theorem class_one(b: u8, t: b < 0x80): utf8::class_of(b) = utf8::C1 {
    simp_only(utf8::class_of, discharge := by bv_decide())
}
theorem class_cont(b: u8, t: ¬(b < 0x80), u: b < 0xC0): utf8::class_of(b) = utf8::CBad {
    simp_only(utf8::class_of, utf8::class_lead, discharge := by bv_decide())
}
theorem class_two(b: u8, t: ¬(b < 0xC0), u: b < 0xE0): utf8::class_of(b) = utf8::C2 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, discharge := by bv_decide())
}
theorem class_three(b: u8, t: ¬(b < 0xE0), u: b < 0xF0): utf8::class_of(b) = utf8::C3 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, discharge := by bv_decide())
}
theorem class_four(b: u8, t: ¬(b < 0xF0), u: b < 0xF8): utf8::class_of(b) = utf8::C4 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, utf8::class_lead4, discharge := by bv_decide())
}
theorem class_past(b: u8, t: ¬(b < 0xF8)): utf8::class_of(b) = utf8::CBad {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, utf8::class_lead4, discharge := by bv_decide())
}

// ---------------------------------------------------------------------------
// The decoder at a lead byte

theorem decode_cons(b: u8, r: List<u8>): utf8::decode([b, ..r]) = utf8::decode_class(utf8::class_of(b), b, r) {
    match r { [] => refl, [c1] => refl, [c1, c2] => refl, [c1, c2, c3, ..r3] => refl }
}

theorem push_is_some(step: Option<Pair<Char, List<u8>>>, tail: Option<String>):
    utf8::push_char(step, tail).is_some() = (step.is_some() && tail.is_some()) {
    match step {
        None => refl,
        Some(st) => match tail { None => refl, Some(t) => refl },
    }
}

// What the decoder makes of a byte list, by its lead byte's class.
theorem valid_by_class(b: u8, r: List<u8>, cl: utf8::Class, class: utf8::class_of(b) = cl):
    utf8::is_utf8([b, ..r]) = utf8::decode_class(cl, b, r).is_some() {
    let decoded: (utf8::decode([b, ..r]) = utf8::decode_class(cl, b, r)) = rewrite(decode_cons(b, r), class, refl);
    cong_fn(λ (o: Option<String>) => o.is_some(), decoded)
}

// An ASCII byte is always a character.
theorem seq1_is_some(b: u8, r: List<u8>): utf8::decode_seq(utf8::C1, b, r).is_some() = True {
    rewrite(emit_is_some(0, utf8::ascii_payload(b).toNat(), r), by bv_decide())
}

theorem ascii(b: u8, r: List<u8>, t: b < 0x80): utf8::is_utf8([b, ..r]) = utf8::is_utf8(r) {
    rewrite(valid_by_class(b, r, utf8::C1, class_one(b, t)), push_is_some(utf8::decode_seq(utf8::C1, b, r), utf8::decode(r)), seq1_is_some(b, r), refl)
}
theorem stray(b: u8, r: List<u8>, t: ¬(b < 0x80), u: b < 0xC0): utf8::is_utf8([b, ..r]) = False {
    rewrite(valid_by_class(b, r, utf8::CBad, class_cont(b, t, u)), refl)
}
theorem past(b: u8, r: List<u8>, t: ¬(b < 0xF8)): utf8::is_utf8([b, ..r]) = False {
    rewrite(valid_by_class(b, r, utf8::CBad, class_past(b, t)), refl)
}

// A sequence of each length, by the decoder: its value, then the bytes after
// it.
theorem valid_two(b, c1: u8, r: List<u8>, t: ¬(b < 0xC0), u: b < 0xE0):
    utf8::is_utf8([b, c1, ..r]) = (utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, ..r], utf8::C2, class_two(b, t, u)), push_is_some(utf8::decode_seq(utf8::C2, b, [c1, ..r]), utf8::decode(r)), refl)
}
theorem valid_three(b, c1, c2: u8, r: List<u8>, t: ¬(b < 0xE0), u: b < 0xF0):
    utf8::is_utf8([b, c1, c2, ..r]) = (utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, c2, ..r], utf8::C3, class_three(b, t, u)), push_is_some(utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]), utf8::decode(r)), refl)
}
theorem valid_four(b, c1, c2, c3: u8, r: List<u8>, t: ¬(b < 0xF0), u: b < 0xF8):
    utf8::is_utf8([b, c1, c2, c3, ..r]) = (utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some() && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, c2, c3, ..r], utf8::C4, class_four(b, t, u)),
        push_is_some(utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]), utf8::decode(r)), refl)
}

// A sequence the table takes: the decoder takes it too, and goes on after it.
theorem one_taken(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 1): utf8::is_utf8([b, ..r]) = utf8::is_utf8(r) {
    ascii(b, r, length_one(b, c1, c2, c3, k))
}
theorem two_taken(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 2): utf8::is_utf8([b, c1, ..r]) = utf8::is_utf8(r) {
    let lead = length_two(b, c1, c2, c3, k);
    rewrite(valid_two(b, c1, r, lead.left, lead.right), two_takes(b, c1, c2, c3, r, k), refl)
}
theorem three_taken(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 3): utf8::is_utf8([b, c1, c2, ..r]) = utf8::is_utf8(r) {
    let lead = length_three(b, c1, c2, c3, k);
    rewrite(valid_three(b, c1, c2, r, lead.left, lead.right), three_takes(b, c1, c2, c3, r, k), refl)
}
theorem four_taken(b, c1, c2, c3: u8, r: List<u8>, k: sequence_length(↑b, ↑c1, ↑c2, ↑c3) = 4): utf8::is_utf8([b, c1, c2, c3, ..r]) = utf8::is_utf8(r) {
    let lead = length_four(b, c1, c2, c3, k);
    rewrite(valid_four(b, c1, c2, c3, r, lead.left, lead.right), four_takes(b, c1, c2, c3, r, k), refl)
}

// A sequence the bytes end inside of.
theorem cut_two(b: u8, r: List<u8>, t: ¬(b < 0xC0), u: b < 0xE0): r.len() < 1 → utf8::is_utf8([b, ..r]) = False {
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C2, class_two(b, t, u)), refl),
        [c1, ..r1] => λ short => false_elim(omega),
    }
}
theorem cut_three(b: u8, r: List<u8>, t: ¬(b < 0xE0), u: b < 0xF0): r.len() < 2 → utf8::is_utf8([b, ..r]) = False {
    let class = class_three(b, t, u);
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C3, class), refl),
        [c1] => λ _ => rewrite(valid_by_class(b, [c1], utf8::C3, class), refl),
        [c1, c2, ..r2] => λ short => false_elim(omega),
    }
}
theorem cut_four(b: u8, r: List<u8>, t: ¬(b < 0xF0), u: b < 0xF8): r.len() < 3 → utf8::is_utf8([b, ..r]) = False {
    let class = class_four(b, t, u);
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C4, class), refl),
        [c1] => λ _ => rewrite(valid_by_class(b, [c1], utf8::C4, class), refl),
        [c1, c2] => λ _ => rewrite(valid_by_class(b, [c1, c2], utf8::C4, class), refl),
        [c1, c2, c3, ..r3] => λ (short: r3.len() + 3 < 3) => false_elim(omega),
    }
}

// ---------------------------------------------------------------------------
// The loop

// Byte `k` of a list, 0 past its end.
fn at(s: List<u8>, k: Nat) → u8 { s.nth(k).unwrap_or(0) }

// The bytes the loop reads, as a list: `w`, `m` of them, each at its offset
// in the span.
record Window(s: List<u8>, n: u64, w: List<u8>, m: u64) {
    wide: w.len() = m.toNat(),
    reads: (x: u64) → x.toNat() < m.toNat() → s.byte_within(n, x) = at(w, x.toNat()),
}

// Inside the window, the bytes from offset `x` are the byte the loop reads
// there and the bytes from the next offset `y`.
theorem Window::from({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x, y: u64,
    inside: x.toNat() < m.toNat(), next: y.toNat() = x.toNat() + 1): w.drop(x.toNat()) = Cons(s.byte_within(n, x), w.drop(y.toNat())) {
    rewrite(win.reads(x, inside), next, w.drop_at(x.toNat(), 0, rewrite(win.wide, inside)))
}

// The one, two, three or four bytes the loop reads from `x`, and the bytes
// after them.
theorem Window::one({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), w.drop((x + 1).toNat())) {
    win.from(x, x + 1, inside, bv_omega)
}
theorem Window::two({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 1 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), w.drop((x + 2).toNat()))) {
    rewrite(win.one(x, bv_omega), win.from(x + 1, x + 2, bv_omega, bv_omega), refl)
}
theorem Window::three({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 2 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), Cons(s.byte_within(n, x + 2), w.drop((x + 3).toNat())))) {
    rewrite(win.two(x, bv_omega), win.from(x + 2, x + 3, bv_omega, bv_omega), refl)
}
theorem Window::four({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 3 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), Cons(s.byte_within(n, x + 2), Cons(s.byte_within(n, x + 3), w.drop((x + 4).toNat()))))) {
    rewrite(win.three(x, bv_omega), win.from(x + 3, x + 4, bv_omega, bv_omega), refl)
}

// How many bytes are left from offset `x`.
theorem Window::left({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64): w.drop(x.toNat()).len() = m.toNat() - x.toNat() {
    rewrite(w.len_drop(x.toNat()), win.wide, refl)
}

// No bytes are left at the window's end.
theorem Window::ends({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, end: x.toNat() = m.toNat()): w.drop(x.toNat()) = Nil {
    rewrite(end, sym(win.wide), w.drop_len())
}

// The loop stops at `x` before the window's end.
theorem stops(x, m: u64, before: x.toNat() < m.toNat()): x.eq_bit(m) = False { by bv_decide() }

// The bytes the table reads at offset `x`, as the window holds them, and
// what the decoder makes of them.
theorem Window::takes_one({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat(), k: sequence_at(s, n, x) = 1):
    utf8::is_utf8(w.drop(x.toNat())) = utf8::is_utf8(w.drop((x + 1).toNat())) {
    rewrite(win.one(x, inside), one_taken(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), w.drop((x + 1).toNat()), k))
}
theorem Window::takes_two({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 1 < m.toNat(), k: sequence_at(s, n, x) = 2):
    utf8::is_utf8(w.drop(x.toNat())) = utf8::is_utf8(w.drop((x + 2).toNat())) {
    rewrite(win.two(x, inside), two_taken(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), w.drop((x + 2).toNat()), k))
}
theorem Window::takes_three({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 2 < m.toNat(), k: sequence_at(s, n, x) = 3):
    utf8::is_utf8(w.drop(x.toNat())) = utf8::is_utf8(w.drop((x + 3).toNat())) {
    rewrite(win.three(x, inside), three_taken(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), w.drop((x + 3).toNat()), k))
}
theorem Window::takes_four({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 3 < m.toNat(), k: sequence_at(s, n, x) = 4):
    utf8::is_utf8(w.drop(x.toNat())) = utf8::is_utf8(w.drop((x + 4).toNat())) {
    rewrite(win.four(x, inside), four_taken(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), w.drop((x + 4).toNat()), k))
}

// A sequence the window ends inside of.
theorem Window::short_two({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat(),
    k: sequence_at(s, n, x) = 2, short: ¬(x.toNat() + 1 < m.toNat())): utf8::is_utf8(w.drop(x.toNat())) = False {
    let lead = length_two(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), k);
    rewrite(win.one(x, inside), cut_two(s.byte_within(n, x), w.drop((x + 1).toNat()), lead.left, lead.right, rewrite(win.left(x + 1), bv_omega)))
}
theorem Window::short_three({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat(),
    k: sequence_at(s, n, x) = 3, short: ¬(x.toNat() + 2 < m.toNat())): utf8::is_utf8(w.drop(x.toNat())) = False {
    let lead = length_three(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), k);
    rewrite(win.one(x, inside), cut_three(s.byte_within(n, x), w.drop((x + 1).toNat()), lead.left, lead.right, rewrite(win.left(x + 1), bv_omega)))
}
theorem Window::short_four({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat(),
    k: sequence_at(s, n, x) = 4, short: ¬(x.toNat() + 3 < m.toNat())): utf8::is_utf8(w.drop(x.toNat())) = False {
    let lead = length_four(s.byte_within(n, x), s.byte_within(n, x + 1), s.byte_within(n, x + 2), s.byte_within(n, x + 3), k);
    rewrite(win.one(x, inside), cut_four(s.byte_within(n, x), w.drop((x + 1).toNat()), lead.left, lead.right, rewrite(win.left(x + 1), bv_omega)))
}

// A lead byte the table refuses: whatever the bytes after it, the decoder
// refuses the window from it.
theorem Window::refused({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat(),
    k1: sequence_at(s, n, x) ≠ 1, k2: sequence_at(s, n, x) ≠ 2, k3: sequence_at(s, n, x) ≠ 3, k4: sequence_at(s, n, x) ≠ 4):
    utf8::is_utf8(w.drop(x.toNat())) = False {
    let b = s.byte_within(n, x);
    let c1 = s.byte_within(n, x + 1);
    let c2 = s.byte_within(n, x + 2);
    let c3 = s.byte_within(n, x + 3);
    let r = w.drop((x + 1).toNat());
    if t: b < 0x80 {
        false_elim(k1(length_ascii(b, c1, c2, c3, t)))
    } else if u: b < 0xC0 {
        rewrite(win.one(x, inside), stray(b, r, t, u))
    } else if v: b < 0xE0 {
        if room: x.toNat() + 1 < m.toNat() {
            rewrite(win.two(x, room), valid_two(b, c1, w.drop((x + 2).toNat()), u, v), two_refuses(b, c1, c2, c3, w.drop((x + 2).toNat()), u, v, k2), refl)
        } else {
            rewrite(win.one(x, inside), cut_two(b, r, u, v, rewrite(win.left(x + 1), bv_omega)))
        }
    } else if v3: b < 0xF0 {
        if room: x.toNat() + 2 < m.toNat() {
            rewrite(win.three(x, room), valid_three(b, c1, c2, w.drop((x + 3).toNat()), v, v3), three_refuses(b, c1, c2, c3, w.drop((x + 3).toNat()), v, v3, k3), refl)
        } else {
            rewrite(win.one(x, inside), cut_three(b, r, v, v3, rewrite(win.left(x + 1), bv_omega)))
        }
    } else if v4: b < 0xF8 {
        if room: x.toNat() + 3 < m.toNat() {
            rewrite(win.four(x, room), valid_four(b, c1, c2, c3, w.drop((x + 4).toNat()), v3, v4), four_refuses(b, c1, c2, c3, w.drop((x + 4).toNat()), v3, v4, k4), refl)
        } else {
            rewrite(win.one(x, inside), cut_four(b, r, v3, v4, rewrite(win.left(x + 1), bv_omega)))
        }
    } else {
        rewrite(win.one(x, inside), past(b, r, v4))
    }
}

theorem valid_window_decides(s: List<u8>, n, i, left: u64, w: List<u8>, m: u64, win: Window(s, n, w, m), here: i.toNat() + left.toNat() = m.toNat()):
    utf8_valid_from(s, n, i, left).eq_bit(m) = utf8::is_utf8(w.drop(i.toNat())) {
    induct utf8_valid_from(s, n, i, left) {
        True::True => rewrite(ih(w, m, win, bv_omega), win.takes_one(i, bv_omega, by assumption()), refl),
        True::False::True::True => rewrite(ih(w, m, win, bv_omega), win.takes_two(i, bv_omega, by assumption()), refl),
        True::False::True::False => rewrite(stops(i, m, bv_omega), win.short_two(i, bv_omega, by assumption(), bv_omega), refl),
        True::False::False::True::True => rewrite(ih(w, m, win, bv_omega), win.takes_three(i, bv_omega, by assumption()), refl),
        True::False::False::True::False => rewrite(stops(i, m, bv_omega), win.short_three(i, bv_omega, by assumption(), bv_omega), refl),
        True::False::False::False::True::True => rewrite(ih(w, m, win, bv_omega), win.takes_four(i, bv_omega, by assumption()), refl),
        True::False::False::False::True::False => rewrite(stops(i, m, bv_omega), win.short_four(i, bv_omega, by assumption(), bv_omega), refl),
        True::False::False::False::False => rewrite(stops(i, m, bv_omega), win.refused(i, bv_omega, by assumption(), by assumption(), by assumption(), by assumption()), refl),
        False => rewrite(BitVec::eq_bit_of_eq(64, i, m, bitvec_omega::word_eq(64, i, m, bv_omega)), win.ends(i, bv_omega), refl),
    }
}

// A read below the length word is the byte there.
theorem read_at(s: List<u8>, n, x: u64, inside: x.toNat() < n.toNat()): s.byte_within(n, x) = at(s, x.toNat()) {
    Bool::picked_true(x.unsigned_lt_bit(n), s.byte_at(x), 0, bitvec_omega::unsigned_of_true(64, x, n, inside))
}

// The bytes from `i` to the length word are UTF-8 exactly when the loop
// runs to the end.
theorem valid_from_decides(s: List<u8>, n, i, left: u64, sized: s.len() = n.toNat(), here: i.toNat() + left.toNat() = n.toNat()):
    utf8_valid_from(s, n, i, left).eq_bit(n) = utf8::is_utf8(s.drop(i.toNat())) {
    valid_window_decides(s, n, i, left, s, n, Window(wide := sized, reads := λ x inside => read_at(s, n, x, inside)), here)
}

// A window: the loop over the `left` bytes from `i`, inside a longer
// buffer, decides whether the bytes from `i` to `i + left` are UTF-8. A
// program that lends its buffer validates its first `filled` bytes this
// way, `utf8_valid_from(s, n, 0, filled)`.
theorem valid_window(s: List<u8>, n, i, left: u64, fits: i.toNat() + left.toNat() <= n.toNat(), sized: n.toNat() <= s.len()):
    utf8_valid_from(s, n, i, left).eq_bit(i + left) = utf8::is_utf8(s.take((i + left).toNat()).drop(i.toNat())) {
    let end = (i + left).toNat();
    let sum: (end = i.toNat() + left.toNat()) = bv_omega;
    valid_window_decides(s, n, i, left, s.take(end), i + left, Window(
        wide := s.len_take(end, omega),
        reads := λ x inside => trans(read_at(s, n, x, omega), cong_fn(λ (o: Option<u8>) => o.unwrap_or(0), sym(s.nth_take(end, x.toNat(), inside))))),
        sym(sum))
}

// The first `filled` bytes of a longer buffer, as a program that reads
// into a buffer asks.
theorem valid_prefix(s: List<u8>, n, filled: u64, fits: filled.toNat() <= n.toNat(), sized: n.toNat() <= s.len()):
    utf8_valid_from(s, n, 0, filled).eq_bit(filled) = utf8::is_utf8(s.take(filled.toNat())) {
    let whole: ((0: u64) + filled = filled) = bv_omega;
    rewrite(whole, s.take(filled.toNat()).drop_zero(), in := valid_window(s, n, 0, filled, omega, sized))
}

// ---------------------------------------------------------------------------
// What the program does

// The validator's answer is the strict decoder's: the `n` bytes of `s` are
// valid exactly when `utf8::decode` accepts them.
theorem utf8_valid_up_to_decides(s: List<u8>, n: u64, sized: s.len() = n.toNat()):
    utf8_valid_up_to(s, n).eq_bit(n) = utf8::is_utf8(s) {
    rewrite(valid_from_decides(s, n, 0, n, sized, bv_omega), s.drop_zero(), refl)
}

// All of the bytes are valid exactly when they are the UTF-8 encoding of
// some string.
theorem utf8_valid_up_to_iff(s: List<u8>, n: u64, sized: s.len() = n.toNat()):
    (utf8_valid_up_to(s, n) = n) ↔ (∃ t: String, utf8::encode(t) = s) {
    let decides = utf8_valid_up_to_decides(s, n, sized);
    Iff(
        mp := λ all => utf8::is_utf8_iff(s).mp(trans(sym(decides), rewrite(all, BitVec::eq_bit_self(64, n)))),
        mpr := λ e => BitVec::eq_of_eq_bit(64, utf8_valid_up_to(s, n), n, trans(decides, utf8::is_utf8_iff(s).mpr(e))),
    )
}

import bv_decide;

// Whether a lead byte and the continuation bytes after it are one UTF-8
// sequence: 1 when they are, 0 when not. Each byte is a word, read from the
// span by the loop below; the scalar value they spell is assembled from their
// payloads and checked as the strict decoder checks it: not overlong (at
// least the least value of its length), and a Unicode scalar value (not a
// surrogate, at most 0x10FFFF).

// `110xxxxx 10xxxxxx`, at least 0x80.
runtime fn utf8_two(b, c1: u64) → u64 {
    if c1 & 0xC0 = 0x80 {
        let code = ((b & 0x1F) << 6) + (c1 & 0x3F);
        if code < 0x80 { 0 } else { 1 }
    } else {
        0
    }
}

// `1110xxxx 10xxxxxx 10xxxxxx`, at least 0x800, not a surrogate.
runtime fn utf8_three(b, c1, c2: u64) → u64 {
    if c1 & 0xC0 = 0x80 {
        if c2 & 0xC0 = 0x80 {
            let code = ((b & 0x0F) << 12) + ((c1 & 0x3F) << 6) + (c2 & 0x3F);
            if code < 0x800 { 0 } else if code < 0xD800 { 1 } else if code < 0xE000 { 0 } else { 1 }
        } else {
            0
        }
    } else {
        0
    }
}

// `11110xxx` and three continuations, from 0x10000 to 0x10FFFF.
runtime fn utf8_four(b, c1, c2, c3: u64) → u64 {
    if c1 & 0xC0 = 0x80 {
        if c2 & 0xC0 = 0x80 {
            if c3 & 0xC0 = 0x80 {
                let code = ((b & 0x07) << 18) + ((c1 & 0x3F) << 12) + ((c2 & 0x3F) << 6) + (c3 & 0x3F);
                if code < 0x10000 { 0 } else if code < 0x110000 { 1 } else { 0 }
            } else {
                0
            }
        } else {
            0
        }
    } else {
        0
    }
}

// The same tests on the bytes from offset `i` of the span. The loop calls
// these rather than reading the bytes itself, which keeps it small enough
// for the compiler's certificate to scan in one step.
runtime fn utf8_two_at(s: List<u8>, n, i: u64) → u64 {
    utf8_two(↑s.byte_within(n, i), ↑s.byte_within(n, i + 1))
}
runtime fn utf8_three_at(s: List<u8>, n, i: u64) → u64 {
    utf8_three(↑s.byte_within(n, i), ↑s.byte_within(n, i + 1), ↑s.byte_within(n, i + 2))
}
runtime fn utf8_four_at(s: List<u8>, n, i: u64) → u64 {
    utf8_four(↑s.byte_within(n, i), ↑s.byte_within(n, i + 1), ↑s.byte_within(n, i + 2), ↑s.byte_within(n, i + 3))
}

// The offset of the first byte from `i` where no sequence starts, or `n`
// when the bytes from `i` are UTF-8 to the end; `left` is the number of
// bytes from `i`, `n - i`.
runtime fn utf8_valid_from(s: List<u8>, n, i, left: u64) → u64 decreases left.toNat() {
    if h: 0 < left {
        let b: u8 = s.byte_within(n, i);
        if b < 0x80 {
            utf8_valid_from(s, n, i + 1, left - 1)
        } else if b < 0xC0 {
            i
        } else if b < 0xE0 {
            if h2: 1 < left {
                if utf8_two_at(s, n, i) = 0 { i } else { utf8_valid_from(s, n, i + 2, left - 2) }
            } else {
                i
            }
        } else if b < 0xF0 {
            if h3: 2 < left {
                if utf8_three_at(s, n, i) = 0 { i } else { utf8_valid_from(s, n, i + 3, left - 3) }
            } else {
                i
            }
        } else if b < 0xF8 {
            if h4: 3 < left {
                if utf8_four_at(s, n, i) = 0 { i } else { utf8_valid_from(s, n, i + 4, left - 4) }
            } else {
                i
            }
        } else {
            i
        }
    } else {
        i
    }
}

// The length of the longest prefix of the `n` bytes of `s` that is UTF-8:
// `n` exactly when all of them are.
runtime fn utf8_valid_up_to(s: List<u8>, n: u64) → u64 { utf8_valid_from(s, n, 0, n) }

// ---------------------------------------------------------------------------
// Why it is right

// The decoder emits a character exactly when the value is not overlong and
// is a scalar value.
theorem emit_is_some(min, code: Nat, r: List<u8>): utf8::emit(min, code, r).is_some() = (min.leb(code) && char::is_scalar(code)) {
    match low: min.leb(code) {
        False => calc {
            utf8::emit(min, code, r).is_some() = utf8::emit_min(min.leb(code), code, r).is_some() := refl,
            = False && char::is_scalar(code) := rewrite(low, refl),
        },
        True => calc {
            utf8::emit(min, code, r).is_some() = utf8::emit_min(min.leb(code), code, r).is_some() := refl,
            = utf8::emit_dec(code, char::is_scalar(code).is_true_dec(), r).is_some() := rewrite(low, refl),
            = True && char::is_scalar(code) := match d: char::is_scalar(code).is_true_dec() {
                Inl(p) => sym(cong_fn(λ (x: Bool) => True && x, eq_true_of_is_true(char::is_scalar(code), p))),
                Inr(np) => sym(cong_fn(λ (x: Bool) => True && x, eq_false_of_not_is_true(char::is_scalar(code), np))),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// One sequence: the program's test is the decoder's

// The scalar value a sequence spells, as the decoder assembles it.
fn code2(b, c1: u8) → Nat { utf8::cont_payload(c1).concat(utf8::lead2_payload(b)).toNat() }
fn code3(b, c1, c2: u8) → Nat { utf8::cont_payload(c2).concat(utf8::cont_payload(c1).concat(utf8::lead3_payload(b))).toNat() }
fn code4(b, c1, c2, c3: u8) → Nat {
    utf8::cont_payload(c3).concat(utf8::cont_payload(c2).concat(utf8::cont_payload(c1).concat(utf8::lead4_payload(b)))).toNat()
}

// Whether a byte is a continuation byte, `10xxxxxx`.
fn cont(c: u8) → Bool { utf8::bit7(c) && !utf8::bit6(c) }

// The decoder takes a sequence exactly when each byte after the lead is a
// continuation and the value they spell is emitted.
theorem seq2_is_some(b, c1: u8, r: List<u8>):
    utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() = (cont(c1) && utf8::emit(0x80, code2(b, c1), r).is_some()) {
    split_all; all_goals { refl }
}
theorem seq3_is_some(b, c1, c2: u8, r: List<u8>):
    utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() = ((cont(c1) && cont(c2)) && utf8::emit(0x800, code3(b, c1, c2), r).is_some()) {
    split_all; all_goals { refl }
}
theorem seq4_is_some(b, c1, c2, c3: u8, r: List<u8>):
    utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some()
        = (((cont(c1) && cont(c2)) && cont(c3)) && utf8::emit(0x10000, code4(b, c1, c2, c3), r).is_some()) {
    split_all; all_goals { refl }
}

// The program refuses a sequence exactly when the decoder does.
theorem two_decides(b, c1: u8, r: List<u8>): utf8::decode_seq(utf8::C2, b, [c1, ..r]).is_some() = !utf8_two(↑b, ↑c1).eq_bit(0) {
    rewrite(seq2_is_some, emit_is_some, by bv_decide())
}
theorem three_decides(b, c1, c2: u8, r: List<u8>):
    utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]).is_some() = !utf8_three(↑b, ↑c1, ↑c2).eq_bit(0) {
    rewrite(seq3_is_some, emit_is_some, by bv_decide())
}
// utf8_four's verdict as one Boolean formula. bv_decide could split the
// program's ifs itself, but four nested tests over a 21-bit code point peak
// near three times the memory of reading this formula (the native gate's
// 6 GiB rail; issues/utf8-example-elegance.md). The range-table program
// (item 4 there) retires it.
theorem four_bits(b, c1, c2, c3: u64): utf8_four(b, c1, c2, c3).eq_bit(0)
    = !(((((c1 & 0xC0).eq_bit(0x80) && (c2 & 0xC0).eq_bit(0x80)) && (c3 & 0xC0).eq_bit(0x80))
        && !(((b & 0x07) << 18) + ((c1 & 0x3F) << 12) + ((c2 & 0x3F) << 6) + (c3 & 0x3F)).unsigned_lt_bit(0x10000))
        && (((b & 0x07) << 18) + ((c1 & 0x3F) << 12) + ((c2 & 0x3F) << 6) + (c3 & 0x3F)).unsigned_lt_bit(0x110000)) {
    split_all; all_goals { refl }
}
theorem four_decides(b, c1, c2, c3: u8, r: List<u8>):
    utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]).is_some() = !utf8_four(↑b, ↑c1, ↑c2, ↑c3).eq_bit(0) {
    rewrite(four_bits, seq4_is_some, emit_is_some, by bv_decide())
}

// ---------------------------------------------------------------------------
// The lead byte's class, from the loop's tests on it: the decoder reads the
// top bits, and `bv_decide` proves each from the tests.

theorem class_one(b: u8, t: b < 0x80): utf8::class_of(b) = utf8::C1 {
    simp_only(utf8::class_of, discharge := by bv_decide())
}
theorem class_cont(b: u8, t: ¬(b < 0x80), u: b < 0xC0): utf8::class_of(b) = utf8::CBad {
    simp_only(utf8::class_of, utf8::class_lead, discharge := by bv_decide())
}
theorem class_two(b: u8, t: ¬(b < 0xC0), u: b < 0xE0): utf8::class_of(b) = utf8::C2 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, discharge := by bv_decide())
}
theorem class_three(b: u8, t: ¬(b < 0xE0), u: b < 0xF0): utf8::class_of(b) = utf8::C3 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, discharge := by bv_decide())
}
theorem class_four(b: u8, t: ¬(b < 0xF0), u: b < 0xF8): utf8::class_of(b) = utf8::C4 {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, utf8::class_lead4, discharge := by bv_decide())
}
theorem class_past(b: u8, t: ¬(b < 0xF8)): utf8::class_of(b) = utf8::CBad {
    simp_only(utf8::class_of, utf8::class_lead, utf8::class_lead2, utf8::class_lead3, utf8::class_lead4, discharge := by bv_decide())
}

// ---------------------------------------------------------------------------
// The decoder at a lead byte, by the loop's tests on it

theorem decode_cons(b: u8, r: List<u8>): utf8::decode([b, ..r]) = utf8::decode_class(utf8::class_of(b), b, r) {
    match r { [] => refl, [c1] => refl, [c1, c2] => refl, [c1, c2, c3, ..r3] => refl }
}

theorem push_is_some(step: Option<Pair<Char, List<u8>>>, tail: Option<String>):
    utf8::push_char(step, tail).is_some() = (step.is_some() && tail.is_some()) {
    match step {
        None => refl,
        Some(st) => match tail { None => refl, Some(t) => refl },
    }
}

// What the decoder makes of a byte list, by its lead byte's class.
theorem valid_by_class(b: u8, r: List<u8>, cl: utf8::Class, class: utf8::class_of(b) = cl):
    utf8::is_utf8([b, ..r]) = utf8::decode_class(cl, b, r).is_some() {
    let decoded: (utf8::decode([b, ..r]) = utf8::decode_class(cl, b, r)) = rewrite(decode_cons(b, r), class, refl);
    cong_fn(λ (o: Option<String>) => o.is_some(), decoded)
}

// An ASCII byte is always a character.
theorem seq1_is_some(b: u8, r: List<u8>): utf8::decode_seq(utf8::C1, b, r).is_some() = True {
    rewrite(emit_is_some(0, utf8::ascii_payload(b).toNat(), r), by bv_decide())
}

theorem ascii(b: u8, r: List<u8>, t: b < 0x80): utf8::is_utf8([b, ..r]) = utf8::is_utf8(r) {
    rewrite(valid_by_class(b, r, utf8::C1, class_one(b, t)), push_is_some(utf8::decode_seq(utf8::C1, b, r), utf8::decode(r)), seq1_is_some(b, r), refl)
}
theorem stray(b: u8, r: List<u8>, t: ¬(b < 0x80), u: b < 0xC0): utf8::is_utf8([b, ..r]) = False {
    rewrite(valid_by_class(b, r, utf8::CBad, class_cont(b, t, u)), refl)
}
theorem past(b: u8, r: List<u8>, t: ¬(b < 0xF8)): utf8::is_utf8([b, ..r]) = False {
    rewrite(valid_by_class(b, r, utf8::CBad, class_past(b, t)), refl)
}
theorem two(b, c1: u8, r: List<u8>, t: ¬(b < 0xC0), u: b < 0xE0):
    utf8::is_utf8([b, c1, ..r]) = (!utf8_two(↑b, ↑c1).eq_bit(0) && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, ..r], utf8::C2, class_two(b, t, u)), push_is_some(utf8::decode_seq(utf8::C2, b, [c1, ..r]), utf8::decode(r)), two_decides(b, c1, r), refl)
}
theorem three(b, c1, c2: u8, r: List<u8>, t: ¬(b < 0xE0), u: b < 0xF0):
    utf8::is_utf8([b, c1, c2, ..r]) = (!utf8_three(↑b, ↑c1, ↑c2).eq_bit(0) && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, c2, ..r], utf8::C3, class_three(b, t, u)),
        push_is_some(utf8::decode_seq(utf8::C3, b, [c1, c2, ..r]), utf8::decode(r)), three_decides(b, c1, c2, r), refl)
}
theorem four(b, c1, c2, c3: u8, r: List<u8>, t: ¬(b < 0xF0), u: b < 0xF8):
    utf8::is_utf8([b, c1, c2, c3, ..r]) = (!utf8_four(↑b, ↑c1, ↑c2, ↑c3).eq_bit(0) && utf8::is_utf8(r)) {
    rewrite(valid_by_class(b, [c1, c2, c3, ..r], utf8::C4, class_four(b, t, u)),
        push_is_some(utf8::decode_seq(utf8::C4, b, [c1, c2, c3, ..r]), utf8::decode(r)), four_decides(b, c1, c2, c3, r), refl)
}

// A sequence the bytes end inside of.
theorem cut_two(b: u8, r: List<u8>, t: ¬(b < 0xC0), u: b < 0xE0): r.len() < 1 → utf8::is_utf8([b, ..r]) = False {
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C2, class_two(b, t, u)), refl),
        [c1, ..r1] => λ short => false_elim(omega),
    }
}
theorem cut_three(b: u8, r: List<u8>, t: ¬(b < 0xE0), u: b < 0xF0): r.len() < 2 → utf8::is_utf8([b, ..r]) = False {
    let class = class_three(b, t, u);
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C3, class), refl),
        [c1] => λ _ => rewrite(valid_by_class(b, [c1], utf8::C3, class), refl),
        [c1, c2, ..r2] => λ short => false_elim(omega),
    }
}
theorem cut_four(b: u8, r: List<u8>, t: ¬(b < 0xF0), u: b < 0xF8): r.len() < 3 → utf8::is_utf8([b, ..r]) = False {
    let class = class_four(b, t, u);
    match r {
        [] => λ _ => rewrite(valid_by_class(b, [], utf8::C4, class), refl),
        [c1] => λ _ => rewrite(valid_by_class(b, [c1], utf8::C4, class), refl),
        [c1, c2] => λ _ => rewrite(valid_by_class(b, [c1, c2], utf8::C4, class), refl),
        [c1, c2, c3, ..r3] => λ (short: r3.len() + 3 < 3) => false_elim(omega),
    }
}

// ---------------------------------------------------------------------------
// The loop

// Byte `k` of a list, 0 past its end.
fn at(s: List<u8>, k: Nat) → u8 { s.nth(k).unwrap_or(0) }

// The bytes the loop reads, as a list: `w`, `m` of them, each at its offset
// in the span.
record Window(s: List<u8>, n: u64, w: List<u8>, m: u64) {
    wide: w.len() = m.toNat(),
    reads: (x: u64) → x.toNat() < m.toNat() → s.byte_within(n, x) = at(w, x.toNat()),
}

// Inside the window, the bytes from offset `x` are the byte the loop reads
// there and the bytes from the next offset `y`.
theorem Window::from({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x, y: u64,
    inside: x.toNat() < m.toNat(), next: y.toNat() = x.toNat() + 1): w.drop(x.toNat()) = Cons(s.byte_within(n, x), w.drop(y.toNat())) {
    rewrite(win.reads(x, inside), next, w.drop_at(x.toNat(), 0, rewrite(win.wide, inside)))
}

// The one, two, three or four bytes the loop reads from `x`, and the bytes
// after them.
theorem Window::one({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), w.drop((x + 1).toNat())) {
    win.from(x, x + 1, inside, bv_omega)
}
theorem Window::two({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 1 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), w.drop((x + 2).toNat()))) {
    rewrite(win.one(x, bv_omega), win.from(x + 1, x + 2, bv_omega, bv_omega), refl)
}
theorem Window::three({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 2 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), Cons(s.byte_within(n, x + 2), w.drop((x + 3).toNat())))) {
    rewrite(win.two(x, bv_omega), win.from(x + 2, x + 3, bv_omega, bv_omega), refl)
}
theorem Window::four({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, inside: x.toNat() + 3 < m.toNat()):
    w.drop(x.toNat()) = Cons(s.byte_within(n, x), Cons(s.byte_within(n, x + 1), Cons(s.byte_within(n, x + 2), Cons(s.byte_within(n, x + 3), w.drop((x + 4).toNat()))))) {
    rewrite(win.three(x, bv_omega), win.from(x + 3, x + 4, bv_omega, bv_omega), refl)
}

// How many bytes are left from offset `x`.
theorem Window::left({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64): w.drop(x.toNat()).len() = m.toNat() - x.toNat() {
    rewrite(w.len_drop(x.toNat()), win.wide, refl)
}

// No bytes are left at the window's end.
theorem Window::ends({s: List<u8>}, {n: u64}, {w: List<u8>}, {m: u64}, self win: Window(s, n, w, m), x: u64, end: x.toNat() = m.toNat()): w.drop(x.toNat()) = Nil {
    rewrite(end, sym(win.wide), w.drop_len())
}

// The loop stops at `x` before the window's end.
theorem stops(x, m: u64, before: x.toNat() < m.toNat()): x.eq_bit(m) = False { by bv_decide() }

theorem valid_window_decides(s: List<u8>, n, i, left: u64, w: List<u8>, m: u64, win: Window(s, n, w, m), here: i.toNat() + left.toNat() = m.toNat()):
    utf8_valid_from(s, n, i, left).eq_bit(m) = utf8::is_utf8(w.drop(i.toNat())) {
    induct utf8_valid_from(s, n, i, left) {
        // ASCII: one byte, and on.
        True::True => rewrite(ih(w, m, win, bv_omega), win.one(i, bv_omega), ascii, refl),
        // A continuation byte where a sequence should start.
        True::False::True => rewrite(stops(i, m, bv_omega), win.one(i, bv_omega), stray, refl),
        // Two bytes: refused, accepted, or cut off by the end.
        True::False::False::True::True::True => rewrite(stops(i, m, bv_omega), win.two(i, bv_omega), two, BitVec::eq_bit_of_eq, refl),
        True::False::False::True::True::False => rewrite(ih(w, m, win, bv_omega), win.two(i, bv_omega), two, BitVec::eq_bit_of_ne, refl),
        True::False::False::True::False => rewrite(stops(i, m, bv_omega), win.one(i, bv_omega),
            cut_two(s.byte_within(n, i), w.drop((i + 1).toNat()), h3, h4, rewrite(win.left(i + 1), bv_omega)), refl),
        // Three bytes.
        True::False::False::False::True::True::True => rewrite(stops(i, m, bv_omega), win.three(i, bv_omega), three, BitVec::eq_bit_of_eq, refl),
        True::False::False::False::True::True::False => rewrite(ih(w, m, win, bv_omega), win.three(i, bv_omega), three, BitVec::eq_bit_of_ne, refl),
        True::False::False::False::True::False => rewrite(stops(i, m, bv_omega), win.one(i, bv_omega),
            cut_three(s.byte_within(n, i), w.drop((i + 1).toNat()), h4, h5, rewrite(win.left(i + 1), bv_omega)), refl),
        // Four bytes.
        True::False::False::False::False::True::True::True => rewrite(stops(i, m, bv_omega), win.four(i, bv_omega), four, BitVec::eq_bit_of_eq, refl),
        True::False::False::False::False::True::True::False => rewrite(ih(w, m, win, bv_omega), win.four(i, bv_omega), four, BitVec::eq_bit_of_ne, refl),
        True::False::False::False::False::True::False => rewrite(stops(i, m, bv_omega), win.one(i, bv_omega),
            cut_four(s.byte_within(n, i), w.drop((i + 1).toNat()), h5, h6, rewrite(win.left(i + 1), bv_omega)), refl),
        // A lead byte past 0xF7.
        True::False::False::False::False::False => rewrite(stops(i, m, bv_omega), win.one(i, bv_omega), past, refl),
        // The end of the window: every byte was a character.
        False => rewrite(BitVec::eq_bit_of_eq(64, i, m, bitvec_omega::word_eq(64, i, m, bv_omega)), win.ends(i, bv_omega), refl),
    }
}

// A read below the length word is the byte there.
theorem read_at(s: List<u8>, n, x: u64, inside: x.toNat() < n.toNat()): s.byte_within(n, x) = at(s, x.toNat()) {
    Bool::picked_true(x.unsigned_lt_bit(n), s.byte_at(x), 0, bitvec_omega::unsigned_of_true(64, x, n, inside))
}

// The bytes from `i` to the length word are UTF-8 exactly when the loop
// runs to the end.
theorem valid_from_decides(s: List<u8>, n, i, left: u64, sized: s.len() = n.toNat(), here: i.toNat() + left.toNat() = n.toNat()):
    utf8_valid_from(s, n, i, left).eq_bit(n) = utf8::is_utf8(s.drop(i.toNat())) {
    valid_window_decides(s, n, i, left, s, n, Window(wide := sized, reads := λ x inside => read_at(s, n, x, inside)), here)
}

// A window: the loop over the `left` bytes from `i`, inside a longer
// buffer, decides whether the bytes from `i` to `i + left` are UTF-8. A
// program that lends its buffer validates its first `filled` bytes this
// way, `utf8_valid_from(s, n, 0, filled)`.
theorem valid_window(s: List<u8>, n, i, left: u64, fits: i.toNat() + left.toNat() <= n.toNat(), sized: n.toNat() <= s.len()):
    utf8_valid_from(s, n, i, left).eq_bit(i + left) = utf8::is_utf8(s.take((i + left).toNat()).drop(i.toNat())) {
    let end = (i + left).toNat();
    let sum: (end = i.toNat() + left.toNat()) = bv_omega;
    valid_window_decides(s, n, i, left, s.take(end), i + left, Window(
        wide := s.len_take(end, omega),
        reads := λ x inside => trans(read_at(s, n, x, omega), cong_fn(λ (o: Option<u8>) => o.unwrap_or(0), sym(s.nth_take(end, x.toNat(), inside))))),
        sym(sum))
}

// The first `filled` bytes of a longer buffer, as a program that reads
// into a buffer asks.
theorem valid_prefix(s: List<u8>, n, filled: u64, fits: filled.toNat() <= n.toNat(), sized: n.toNat() <= s.len()):
    utf8_valid_from(s, n, 0, filled).eq_bit(filled) = utf8::is_utf8(s.take(filled.toNat())) {
    let whole: ((0: u64) + filled = filled) = bv_omega;
    rewrite(whole, s.take(filled.toNat()).drop_zero(), in := valid_window(s, n, 0, filled, omega, sized))
}

// ---------------------------------------------------------------------------
// What the program does

// The validator's answer is the strict decoder's: the `n` bytes of `s` are
// valid exactly when `utf8::decode` accepts them.
theorem utf8_valid_up_to_decides(s: List<u8>, n: u64, sized: s.len() = n.toNat()):
    utf8_valid_up_to(s, n).eq_bit(n) = utf8::is_utf8(s) {
    rewrite(valid_from_decides(s, n, 0, n, sized, bv_omega), s.drop_zero(), refl)
}

// All of the bytes are valid exactly when they are the UTF-8 encoding of
// some string.
theorem utf8_valid_up_to_iff(s: List<u8>, n: u64, sized: s.len() = n.toNat()):
    (utf8_valid_up_to(s, n) = n) ↔ (∃ t: String, utf8::encode(t) = s) {
    let decides = utf8_valid_up_to_decides(s, n, sized);
    Iff(
        mp := λ all => utf8::is_utf8_iff(s).mp(trans(sym(decides), rewrite(all, BitVec::eq_bit_self(64, n)))),
        mpr := λ e => BitVec::eq_of_eq_bit(64, utf8_valid_up_to(s, n), n, trans(decides, utf8::is_utf8_iff(s).mpr(e))),
    )
}

import runtime;

// The length of the UTF-8 sequence at byte `i` of `s`, or 0 when no
// sequence starts there. `s` is lent with its length `n`; a byte read past
// it is 0, which is never a continuation byte, so a sequence cut short by
// the end is refused like any other.

// Two bytes: `110xxxxx 10xxxxxx`, at least 0x80.
runtime fn utf8_two(s: List<u8>, n, i, b: u64) → u64 {
    let c1 = s.byte_within(n, i + 1).zero_extend(56);
    if c1 & 0xC0 = 0x80 {
        let code = ((b & 0x1F) << 6) | (c1 & 0x3F);
        if code < 0x80 { 0 } else { 2 }
    } else {
        0
    }
}

// Three bytes: `1110xxxx 10xxxxxx 10xxxxxx`, at least 0x800, and not a
// surrogate.
runtime fn utf8_three(s: List<u8>, n, i, b: u64) → u64 {
    let c1 = s.byte_within(n, i + 1).zero_extend(56);
    if c1 & 0xC0 = 0x80 {
        let c2 = s.byte_within(n, i + 2).zero_extend(56);
        if c2 & 0xC0 = 0x80 {
            let code = ((b & 0x0F) << 12) | ((c1 & 0x3F) << 6) | (c2 & 0x3F);
            if code < 0x800 { 0 } else if code < 0xD800 { 3 } else if code < 0xE000 { 0 } else { 3 }
        } else {
            0
        }
    } else {
        0
    }
}

// Four bytes: `11110xxx` and three continuations, from 0x10000 below
// 0x110000.
runtime fn utf8_four(s: List<u8>, n, i, b: u64) → u64 {
    let c1 = s.byte_within(n, i + 1).zero_extend(56);
    if c1 & 0xC0 = 0x80 {
        let c2 = s.byte_within(n, i + 2).zero_extend(56);
        if c2 & 0xC0 = 0x80 {
            let c3 = s.byte_within(n, i + 3).zero_extend(56);
            if c3 & 0xC0 = 0x80 {
                let code = ((b & 0x07) << 18) | ((c1 & 0x3F) << 12) | ((c2 & 0x3F) << 6) | (c3 & 0x3F);
                if code < 0x10000 { 0 } else if code < 0x110000 { 4 } else { 0 }
            } else {
                0
            }
        } else {
            0
        }
    } else {
        0
    }
}

// The offset of the first byte from `i` where no sequence starts, or `n`
// when the bytes from `i` are UTF-8 to the end; `left` is the number of
// bytes from `i`, `n - i`.
runtime fn utf8_valid_from(s: List<u8>, n, i, left: u64) → u64 decreases left.toNat() {
    if h: 0 < left {
        let b = s.byte_within(n, i).zero_extend(56);
        if b < 0x80 {
            utf8_valid_from(s, n, i + 1, left - 1)
        } else if b < 0xC0 {
            i
        } else if b < 0xE0 {
            if h2: 1 < left {
                if utf8_two(s, n, i, b) = 0 { i } else { utf8_valid_from(s, n, i + 2, left - 2) }
            } else {
                i
            }
        } else if b < 0xF0 {
            if h3: 2 < left {
                if utf8_three(s, n, i, b) = 0 { i } else { utf8_valid_from(s, n, i + 3, left - 3) }
            } else {
                i
            }
        } else if b < 0xF8 {
            if h4: 3 < left {
                if utf8_four(s, n, i, b) = 0 { i } else { utf8_valid_from(s, n, i + 4, left - 4) }
            } else {
                i
            }
        } else {
            i
        }
    } else {
        i
    }
}

// The length of the longest prefix of the `n` bytes of `s` that is UTF-8:
// `n` exactly when all of them are.
runtime fn utf8_valid_up_to(s: List<u8>, n: u64) → u64 { utf8_valid_from(s, n, 0, n) }

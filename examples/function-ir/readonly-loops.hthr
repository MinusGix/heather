// Two clients of one bounded loop interface; application-specific behavior is
// confined to the pure body. first_match also compiles to a native loop with a
// complete certificate (function_ir_loop_trace.rs, native-bounded-loops-design).
// count_occurrences waits on a Nat carry port.
import function_ir_loop;
import bitvec;
import bool;
import nat;

fn byte_equal(left, right: BitVec(8)) → Bool {
    match left.unsigned_lt_bit(right) {
        True => False,
        False => match right.unsigned_lt_bit(left) { True => False, False => True },
    }
}

fn count_body(needle: BitVec(8), cursor: Nat, byte: BitVec(8), count: Nat) → LoopStep<Nat> {
    match byte_equal(needle, byte) { False => Continue(count), True => Continue(Succ(count)) }
}

fn search_body(needle: BitVec(8), cursor: Nat, byte: BitVec(8), found: Bool) → LoopStep<Bool> {
    match byte_equal(needle, byte) { False => Continue(found), True => Break(True) }
}

fn count_occurrences(buffer: ReadonlyBytes, needle: BitVec(8), budget: Nat,
    cursor: Nat, count: Nat) → LoopOutcome<Nat> {
    bounded_readonly<Nat>(buffer, needle, budget, cursor, count, count_body)
}

// Start with found=False. Early(next, remaining, True) reports a match at
// next-1. The shared semantics count that byte as consumed.
fn first_match(buffer: ReadonlyBytes, needle: BitVec(8), budget: Nat,
    cursor: Nat, found: Bool) → LoopOutcome<Bool> {
    bounded_readonly<Bool>(buffer, needle, budget, cursor, found, search_body)
}

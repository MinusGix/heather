import bitvec_fintype;

// The first offset from `lo` below `hi` whose byte is at least `key`, or
// `hi` when there is none: in a sorted span, where `key` would go.
runtime fn lower_bound_in(s: List<u8>, n, key, lo, hi: u64) → u64 decreases (hi - lo).toNat() {
    if h: lo < hi {
        let mid = lo + ((hi - lo) >> 1);
        if less: s.byte_within(n, mid).zero_extend(56) < key {
            lower_bound_in(s, n, key, mid + 1, hi)
        } else {
            lower_bound_in(s, n, key, lo, mid)
        }
    } else {
        lo
    }
}

runtime fn lower_bound(s: List<u8>, n, key: u64) → u64 { lower_bound_in(s, n, key, 0, n) }

// ---------------------------------------------------------------------------
// What it computes. The span's bytes, as words, read in ascending order:

fn Ascending(s: List<u8>, n: u64) → Type {
    (i, j: u64) → i <= j → j < n → s.byte_within(n, i).zero_extend(56) <= s.byte_within(n, j).zero_extend(56)
}

// Every byte before `r` is below `key`, and from `r` to the end none is.
fn Below(s: List<u8>, n, key, r: u64) → Type { (j: u64) → j < r → s.byte_within(n, j).zero_extend(56) < key }
fn Above(s: List<u8>, n, key, r: u64) → Type { (j: u64) → r <= j → j < n → ¬(s.byte_within(n, j).zero_extend(56) < key) }

// The loop keeps both sides: what lies below `lo` is below `key`, what lies
// from `hi` on is not, and the answer stays in the range. One arm per way
// the function can go, each with the induction hypothesis for its call.
theorem lower_bound_in_splits(s: List<u8>, n, key, lo, hi: u64, asc: Ascending(s, n), order: lo <= hi, fits: hi <= n,
    below: Below(s, n, key, lo), above: Above(s, n, key, hi)):
    And<lower_bound_in(s, n, key, lo, hi) <= hi, And<Below(s, n, key, lower_bound_in(s, n, key, lo, hi)), Above(s, n, key, lower_bound_in(s, n, key, lo, hi))>>
{
    induct lower_bound_in(s, n, key, lo, hi) {
        // The byte at `mid` is below `key`: so is every byte up to it.
        True::True => {
            let mid = lo + ((hi - lo) >> 1);
            let below2: Below(s, n, key, mid + 1) = λ j before => {
                let up = asc(j, mid, bv_omega, bv_omega);
                bv_omega
            };
            ih(asc, bv_omega, fits, below2, above)
        },
        // It is not: neither is any byte from it on.
        True::False => {
            let mid = lo + ((hi - lo) >> 1);
            let above2: Above(s, n, key, mid) = λ j after within reached => {
                let up = asc(mid, j, after, within);
                bv_omega
            };
            let r = ih(asc, bv_omega, bv_omega, below, above2);
            ⟨{ let rl = r.left; bv_omega }, r.right⟩
        },
        // The range is empty: `lo` is `hi`.
        False => {
            let same: (lo = hi) = bv_omega;
            ⟨order, ⟨below, λ (j: u64) (after: lo <= j) (within: j < n) => above(j, rewrite(sym(same), after), within)⟩⟩
        },
    }
}

// ---------------------------------------------------------------------------
// The headline: over an ascending span, `lower_bound` splits it at the answer.
// A byte is below `key` exactly when it comes before the answer, and the
// answer is at most the length.
theorem lower_bound_splits(s: List<u8>, n, key: u64, asc: Ascending(s, n)):
    And<lower_bound(s, n, key) <= n,
        (j: u64) → j < n → Iff<s.byte_within(n, j).zero_extend(56) < key, j < lower_bound(s, n, key)>>
{
    let none_below: Below(s, n, key, 0) = λ (j: u64) (before: j < 0) => bv_omega;
    let none_above: Above(s, n, key, n) = λ (j: u64) (after: n <= j) (within: j < n) (lt: s.byte_within(n, j).zero_extend(56) < key) => bv_omega;
    let start: ((0: u64).toNat() <= n.toNat()) = bv_omega;
    let sides = lower_bound_in_splits(s, n, key, 0, n, asc, start, n.toNat().le_refl(), none_below, none_above);
    let r = lower_bound(s, n, key);
    ⟨sides.left, λ (j: u64) (within: j < n) => Iff(
        mp := λ lt => match c: decide_bit<j < r>() {
            True => decide_bit_true<j < r>(c),
            False => {
                let past: (r <= j) = { let not = decide_bit_false<j < r>(c); omega };
                false_elim(sides.right.right(j, past, within, lt))
            },
        },
        mpr := λ before => sides.right.left(j, before),
    )⟩
}

// The midpoint written the obvious way, `(lo + hi) / 2`, can leave the range:
// the sum wraps. At `lo = 2^63`, `hi = 2^63 + 1` it is `0`. (The bug Joshua
// Bloch found in the JDK's binary search in 2006, after nine years.) The
// program above computes `lo + (hi - lo) / 2`, which `midpoint_from` and
// `midpoint_below` keep in `[lo, hi)`.
theorem midpoint_from(lo, hi: u64, h: lo < hi): lo <= lo + ((hi - lo) >> 1) { bv_omega }
theorem midpoint_below(lo, hi: u64, h: lo < hi): lo + ((hi - lo) >> 1) < hi { bv_omega }

theorem naive_midpoint_escapes(): ¬((lo, hi: u64) → lo < hi → lo <= (lo + hi) >> 1) {
    λ claim => {
        let lo: u64 = 0x8000000000000000;
        let hi: u64 = 0x8000000000000001;
        decide_bit_false<lo <= (lo + hi) >> 1>(refl, claim(lo, hi, decide_bit_true<lo < hi>(refl)))
    }
}

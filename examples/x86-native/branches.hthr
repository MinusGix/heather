import bitvec;
import bool;
fn nested_true(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) {
        False => a.sub(b),
        True => match b.unsigned_lt_bit(BitVec::ofNat(10)) {
            False => b.bxor(a),
            True => a.add(b),
        },
    }
}
fn nested_false(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) {
        False => match a.unsigned_lt_bit(BitVec::ofNat(10)) {
            False => b.sub(a),
            True => a.bor(b),
        },
        True => b.add(a),
    }
}
fn unequal(a, b: BitVec(64)) → Bool {
    match a.unsigned_lt_bit(b) {
        False => b.unsigned_lt_bit(a),
        True => a.unsigned_lt_bit(b),
    }
}
fn composed(a, b: BitVec(64)) → BitVec(64) {
    match unequal(a, b) {
        False => a.sub(b),
        True => a.add(b),
    }
}
// A comparison against a constant that only the branch reads: CMP and a
// Jcc on its flags, no bit materialised.
fn unsigned_threshold(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(BitVec::ofNat(4294967296)) {
        False => a.sub(b),
        True => a.add(b),
    }
}
// The constant the comparison loads is the one the false arm takes away:
// the arm reads the comparison's register instead of loading it again.
fn take_threshold(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(BitVec::ofNat(4294967296)) {
        False => a.sub(BitVec::ofNat(4294967296)).add(b),
        True => a.add(b),
    }
}
// A step that keeps its state below the threshold, applied twice: the outer
// step's state is the inner one's result, dead after it, so the arm that
// returns it unchanged is empty.
fn keep_below(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(BitVec::ofNat(4294967296)) {
        True => a,
        False => a.sub(BitVec::ofNat(4294967296)).add(b),
    }
}
fn keep_twice(a, b: BitVec(64)) → BitVec(64) { keep_below(keep_below(a, b), b) }
// Constants an ADD takes as an immediate the processor sign-extends: 16 and
// -1 as imm8, 65536 as imm32; 2^31, which an imm32 would read as negative,
// is loaded.
fn nudged(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) {
        True => a.add(BitVec::ofNat(16)).add(b.add(BitVec::ofNat(18446744073709551615))),
        False => a.add(BitVec::ofNat(65536)).add(BitVec::ofNat(2147483648)),
    }
}
// Connectives: each operand is tested only where the connective needs it,
// and `!` swaps the arms.
fn either(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) || (b.eq_bit(BitVec::ofNat(7)) && !a.signed_lt_bit(b)) {
        False => a.bxor(b),
        True => match unequal(b, a.add(b)) { False => a, True => b.sub(a) },
    }
}

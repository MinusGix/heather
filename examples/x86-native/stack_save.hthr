import bitvec;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

runtime fn leaf(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    left.add(right).bxor(left.sub(right))
}

runtime fn caller(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    let saved = left.bor(right);
    let other = left.band(right);
    let third = left.sub(right);
    let argument = left.add(right);
    let first = leaf(argument, left);
    let updated = saved.bxor(first);
    updated.sub(other.add(
        third.bxor(leaf(first, right))))
}

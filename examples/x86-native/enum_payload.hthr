// An enum whose constructor carries a field, as a function's result
// (docs/native/runtime-fn-setups-design.md §16.16): returned as its tag
// word in RAX and its payload's one slot in RDX, which is how System V
// returns a C structure of two integer words (`{ tag, value }`). A
// constructor without the field leaves the slot zero.
inductive Diff { Borrow, Exact(d: u64) }

runtime fn sub_checked(a, b: u64) → Diff { if a < b { Borrow } else { Exact(a - b) } }

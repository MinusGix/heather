// `wc -l`, as a certified static executable (docs/native-first-program-design.md,
// docs/native-read-until-eof-design.md). The program is `wc_l_program` at
// the end: the step `line_step`, folded over each chunk the reads of stdin
// return until the empty one, and what its count means, `wc_l`. The process
// exits with (or, with `--print`, prints) the total. Its facts are about its
// step alone (docs/native-wc-design.md §3): it grows by at most one per byte
// (checked by the program's default), and folded over the input from zero it
// is `wc_l` (`count_lines_input`). Buffers, chunks and machines are the
// library's.
//
//     heather build-x86 examples/x86-native/wc_l.hthr wc_l_program --print -o wc_l
import function_ir_loop;
import read_program;
import bitvec;
import bool;
import list;
import logic;
import nat;
import omega;

// A newline: byte 10.
fn newline(b: BitVec(8)) → Bool {
    match b.unsigned_lt_bit(BitVec::ofNat(10)) { True => False, False => b.unsigned_lt_bit(BitVec::ofNat(11)) }
}

// What the count means: the input's newlines.
fn wc_l(bytes: List<BitVec(8)>) → Nat {
    match bytes {
        Nil => 0,
        Cons(byte, rest) => match newline(byte) { False => wc_l(rest), True => Succ(wc_l(rest)) },
    }
}

// The step: one more at a newline.
fn line_step(count: Nat, byte: BitVec(8)) → Nat {
    match newline(byte) { False => count, True => Succ(count) }
}

theorem count_lines_fold(bytes: List<BitVec(8)>): (count: Nat) → fold_bytes(line_step, bytes, count) = count + wc_l(bytes) {
    match bytes {
        Nil => λ count => refl,
        Cons(byte, rest) => λ count => match newline(byte) as λ nl =>
                fold_bytes(line_step, rest, match nl { False => count, True => Succ(count) }) =
                count + match nl { False => wc_l(rest), True => Succ(wc_l(rest)) } {
            False => count_lines_fold(rest, count),
            True => trans(count_lines_fold(rest, Succ(count)), Nat::add_succ_left(count, wc_l(rest))),
        },
    }
}

theorem count_lines_input(bytes: List<BitVec(8)>): wc_l(bytes) = fold_bytes(line_step, bytes, 0) {
    let counted = count_lines_fold(bytes, 0);
    omega
}

// The program: the step and what its count means, with the fact above; that
// the count grows by at most one per byte is the program's default.
// `heather build-x86` builds it by this name.
fn wc_l_program() → CountProgram(line_step, wc_l) {
    CountProgram(count_lines_input)
}

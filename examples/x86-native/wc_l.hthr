// `wc -l`, as a certified static executable (docs/native-first-program-design.md,
// docs/native-read-until-eof-design.md). The program is the counting loop
// below, run over each chunk the reads of stdin return until the empty one;
// the process exits with (or prints) the total. `wc_l` is the specification
// the total is stated against, and this client's facts about its own loop
// are two: over a buffer holding `bytes`, it adds `wc_l(bytes)` to the count
// (`count_lines_input`), and `wc_l` adds over concatenation (`wc_l_append`).
// Everything machine-shaped comes from the shared generators.
import function_ir_loop;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

fn byte_equal(left, right: BitVec(8)) → Bool {
    match left.unsigned_lt_bit(right) {
        True => False,
        False => match right.unsigned_lt_bit(left) { True => False, False => True },
    }
}

fn newline() → BitVec(8) { BitVec::ofNat(10) }

// The number of newlines.
fn wc_l(bytes: List<BitVec(8)>) → Nat {
    match bytes {
        Nil => 0,
        Cons(byte, rest) => match byte_equal(newline(), byte) { False => wc_l(rest), True => Succ(wc_l(rest)) },
    }
}

fn line_body(needle: BitVec(8), cursor: Nat, byte: BitVec(8), count: Nat) → LoopStep<Nat> {
    match byte_equal(needle, byte) { False => Continue(count), True => Continue(Succ(count)) }
}

theorem line_body_advances(): LoopAdvancesByAtMostOne(ReadonlyLoop<Nat>(line_body)) {
    λ needle cursor byte count => match byte_equal(needle, byte) as λ equal =>
            loop_step_payload(match equal { False => Continue(count), True => Continue(Succ(count)) }) <= Succ(count) {
        False => count.le_succ_r(count, count.le_refl()),
        True => Succ(count).le_refl(),
    }
}

fn count_lines(buffer: ReadonlyBytes, needle: BitVec(8), budget: Nat, cursor: Nat, count: Nat) → LoopOutcome<Nat> {
    bounded_readonly<Nat>(buffer, needle, budget, cursor, count, line_body)
}

theorem past_cursor(cursor: Nat): (k: Nat) → Succ(cursor + k).leb(cursor) = False {
    match cursor {
        Zero => λ k => refl,
        Succ(c) => λ k => trans(cong_fn<Nat, Bool>(λ n => Succ(n).leb(Succ(c)), Nat::add_succ_left(c, k)), past_cursor(c, k)),
    }
}

// Over any buffer holding `tail` from `cursor` on, and ending there, the
// loop counts `tail`'s newlines onto `count`.
theorem count_lines_reads(tail: List<BitVec(8)>): (buffer: ReadonlyBytes) → (cursor, count: Nat) →
    buffer.length = cursor + tail.len() →
    ((i: Nat) → (byte: BitVec(8)) → tail.nth(i) = Some(byte) → buffer.read(buffer.base + (cursor + i)) = Some(byte)) →
    count_lines(buffer, newline(), tail.len(), cursor, count) = End(cursor + tail.len(), 0, count + wc_l(tail)) {
    match tail {
        Nil => λ buffer cursor count length reads =>
            loop_run_end(ReadonlyLoop<Nat>(line_body), buffer, newline(), cursor, count,
                trans(cong_fn<Nat, Bool>(λ n => n.leb(cursor), length),
                    eq_true_of_is_true(cursor.leb(cursor), Nat::leb_complete(cursor, cursor, cursor.le_refl()))), 0),
        Cons(byte, rest) => λ buffer cursor count length reads => {
            let region = ReadonlyLoop<Nat>(line_body);
            let open: (buffer.length.leb(cursor) = False) =
                trans(cong_fn<Nat, Bool>(λ n => n.leb(cursor), length), past_cursor(cursor, rest.len()));
            let moved: (Succ(cursor) + rest.len() = cursor + Succ(rest.len())) = Nat::add_succ_left(cursor, rest.len());
            let later = λ (next: Nat) => count_lines_reads(rest, buffer, Succ(cursor), next, trans(length, sym(moved)),
                λ i found present => j(sym(Nat::add_succ_left(cursor, i)), λ at _ => buffer.read(buffer.base + at) = Some(found),
                    reads(Succ(i), found, present)));
            (match byte_equal(newline(), byte) as λ equal => (byte_equal(newline(), byte) = equal) →
                    count_lines(buffer, newline(), Succ(rest.len()), cursor, count) =
                        End(cursor + Succ(rest.len()), 0, count + (match equal { False => wc_l(rest), True => Succ(wc_l(rest)) })) {
                False => λ equal => trans(loop_run_step(rest.len(), region, buffer, newline(), cursor, count, byte, Continue(count),
                        open, reads(0, byte, refl), cong_fn<Bool, LoopStep<Nat>>(λ e => match e { False => Continue(count), True => Continue(Succ(count)) }, equal)),
                    trans(later(count), cong_fn<Nat, LoopOutcome<Nat>>(λ at => End(at, 0, count + wc_l(rest)), moved))),
                True => λ equal => trans(loop_run_step(rest.len(), region, buffer, newline(), cursor, count, byte, Continue(Succ(count)),
                        open, reads(0, byte, refl), cong_fn<Bool, LoopStep<Nat>>(λ e => match e { False => Continue(count), True => Continue(Succ(count)) }, equal)),
                    trans(later(Succ(count)), trans(cong_fn<Nat, LoopOutcome<Nat>>(λ at => End(at, 0, Succ(count) + wc_l(rest)), moved),
                        cong_fn<Nat, LoopOutcome<Nat>>(λ total => End(cursor + Succ(rest.len()), 0, total), Nat::add_succ_left(count, wc_l(rest)))))),
            })(refl)
        },
    }
}

// The fact the profile asks of its loop (elf64_read_loop's ReadEofComputes):
// from the start of a buffer holding `bytes`, the loop adds `wc_l(bytes)` to
// whatever count it starts from.
theorem count_lines_input(carry: Nat, bytes: List<BitVec(8)>, buffer: ReadonlyBytes, length: buffer.length = bytes.len(),
    reads: (i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → buffer.read(buffer.base + i) = Some(byte)):
    count_lines(buffer, newline(), bytes.len(), 0, carry) = End(bytes.len(), 0, carry + wc_l(bytes)) {
    let from_start = Nat::add_left_zero(bytes.len());
    let counted = count_lines_reads(bytes, buffer, 0, carry, trans(length, sym(from_start)),
        λ i byte present => j(sym(Nat::add_left_zero(i)), λ at _ => buffer.read(buffer.base + at) = Some(byte), reads(i, byte, present)));
    trans(counted, cong_fn<Nat, LoopOutcome<Nat>>(λ at => End(at, 0, carry + wc_l(bytes)), from_start))
}

// Counting chunk by chunk counts the whole input.
theorem wc_l_append(front: List<BitVec(8)>, back: List<BitVec(8)>): wc_l(front ++ back) = wc_l(front) + wc_l(back) {
    match front {
        Nil => sym(Nat::add_left_zero(wc_l(back))),
        Cons(byte, rest) => (match byte_equal(newline(), byte) as λ equal =>
                (match equal { False => wc_l(rest ++ back), True => Succ(wc_l(rest ++ back)) }) =
                (match equal { False => wc_l(rest), True => Succ(wc_l(rest)) }) + wc_l(back) {
            False => wc_l_append(rest, back),
            True => trans(cong_fn<Nat, Nat>(λ n => Succ(n), wc_l_append(rest, back)), sym(Nat::add_succ_left(wc_l(rest), wc_l(back)))),
        }),
    }
}

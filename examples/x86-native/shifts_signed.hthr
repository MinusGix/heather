// An `i64`'s right shift is SAR; by 63 or more it leaves the sign in every
// bit, legalized to SAR by 63.
runtime fn signed_shifts(a, b: BitVec(64)) → BitVec(64) {
    a.as_signed().shift_right(7).as_unsigned().add(b.as_signed().shift_right(64).as_unsigned())
}

import bitvec;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

runtime fn leaf(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    left.add(right)
}

runtime fn caller(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    leaf(leaf(left, right), right).bxor(left.bxor(right))
}

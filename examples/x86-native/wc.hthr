// `wc`, as a certified static executable (docs/native-wc-command-design.md):
// GNU `wc` under `LC_ALL=C`, over its file operands or stdin, with `-l`, `-w`,
// `-m` and `-c` selecting the columns it prints. The program is the step
// below, which counts and emits nothing, folded over each input with its
// state in registers across the reads; the command around it (the options,
// the opens, the width, the rows and the total) is the library's. What the
// counts mean is stated the way a reader would check them: the newlines, the
// non-empty pieces of the input split at whitespace, and the length. Each
// count's proof is what one byte does to it (`lines_step` …, by case
// analysis), carried over the input by the library's fold lemmas;
// `wc_command` at the end is the program.
//
//     heather build-x86 examples/x86-native/wc.hthr wc_command -o wc
import function_ir_loop;
import filter_program;
import stream_filter;
import algebra;
import bitvec;
import bool;
import byte;
import char;
import list;
import logic;
import nat;
import omega;
import bitvec_omega;

// The in-word flag is the fourth field: the three counts are the first three,
// in the order they are printed.
record WcState { lines: Nat, words: Nat, bytes: Nat, inside: Bool }

fn newline(b: BitVec(8)) → Bool { decide_bit<b = '\n'>() }

// Whitespace in the C locale: space, and tab to carriage return.
fn space(b: BitVec(8)) → Bool { decide_bit<b = ' ' ∨ ('\t' <= b ∧ b <= '\r')>() }

// What the counts mean.

// The number of newlines.
fn wc_lines(bytes: List<BitVec(8)>) → Nat { bytes.filter(newline).len() }

// The number of words: the pieces between whitespace that aren't empty.
fn wc_words(bytes: List<BitVec(8)>) → Nat { bytes.split_by(space).filter(List::non_empty).len() }

// The number of bytes.
fn wc_bytes(bytes: List<BitVec(8)>) → Nat { bytes.len() }

// The step: the next state from a state and a byte. Every byte is counted;
// whitespace ends a word, and a newline is a line; any other byte starts a
// word unless the state is already in one.
fn wc_step(s: WcState, b: BitVec(8)) → WcState {
    match space(b) {
        True => match newline(b) {
            True => s with { lines = Succ(s.lines), bytes = Succ(s.bytes), inside = False },
            False => s with { bytes = Succ(s.bytes), inside = False },
        },
        False => match s.inside {
            True => s with { bytes = Succ(s.bytes) },
            False => s with { words = Succ(s.words), bytes = Succ(s.bytes), inside = True },
        },
    }
}

// Why the fold counts what the specifications say: what one byte does to
// each count. A newline is one more line; a byte that isn't whitespace starts
// a word when the state isn't in one; every byte is one more byte.
theorem lines_step(s: WcState, b: BitVec(8)): wc_step(s, b).lines = s.lines + Nat::of_bit(newline(b)) { split_all; all_goals { omega } }
theorem words_step(s: WcState, b: BitVec(8)): wc_step(s, b).words = s.words + starts_run(space(b), s.inside) { split_all; all_goals { omega } }
theorem inside_step(s: WcState, b: BitVec(8)): wc_step(s, b).inside = !space(b) { split_all; all_goals { refl } }
theorem bytes_step(s: WcState, b: BitVec(8)): wc_step(s, b).bytes = Succ(s.bytes) { split_all; all_goals { omega } }

// The columns GNU prints, in its order, with the letter that selects each and
// what it means. In the C locale a character is a byte, so `-m` and `-c` both
// print the byte count.
fn wc_columns() → List<Column<WcState>> {
    [Column('l', λ s => s.lines, wc_lines), Column('w', λ s => s.words, wc_words), Column('m', λ s => s.bytes, wc_bytes),
     Column('c', λ s => s.bytes, wc_bytes)]
}

// The program: the step, the zero state, its counts in order, its columns,
// and the ones printed with no option (lines, words and bytes), with each
// column's count folded from zero; that each count grows by at most one per
// byte is the program's default. `heather build-x86` builds it by this name.
fn wc_command() → Command<WcState>(counting(wc_step), WcState(0, 0, 0, False), [λ s => s.lines, λ s => s.words, λ s => s.bytes],
    wc_columns(), [True, True, False, True]) {
    let zero = WcState(0, 0, 0, False);
    let lines = fold_counts_filtered(wc_step, λ s => s.lines, newline, lines_step, zero, refl);
    let words = fold_counts_runs(wc_step, λ s => s.words, λ s => s.inside, space, words_step, inside_step, zero, refl, refl);
    let bytes = fold_counts_len(wc_step, λ s => s.bytes, bytes_step, zero, refl);
    Command(counting_columns(wc_step, zero, wc_columns(), λ input => ⟨lines(input), ⟨words(input), ⟨bytes(input), ⟨bytes(input), trivial⟩⟩⟩⟩))
}

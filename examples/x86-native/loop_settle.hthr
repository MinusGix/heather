import bitvec;
import runtime;

// A call in a loop's pass, and a result computed when the passes run out:
// `stir` mixes `x` with `y` until its low three bits are clear, at most a
// hundred times.

runtime fn stir(x, y: BitVec(64)) → BitVec(64) {
    x.add(y).bxor(x.sub(y))
}

runtime fn settling(fuel: Nat, x, y: BitVec(64)) → BitVec(64) {
    match fuel {
        Zero => x.bxor(y),
        Succ(k) => match x.band(BitVec::ofNat(7)).eq_bit(BitVec::ofNat(0)) {
            True => x,
            False => settling(k, stir(x, y), y.add(BitVec::ofNat(1))),
        },
    }
}

runtime fn settle(a, b: BitVec(64)) → BitVec(64) {
    settling(BitVec::ofNat(100, n := 64).toNat(), a, b)
}

import bitvec;

fn leaf(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    left.bxor(right).bor(
        left.band(right).bxor(left.bor(right)))
}

fn caller(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    let saved = left.bor(right);
    let other = left.band(right);
    let third = left.sub(right);
    let argument = left.add(right);
    saved.sub(other.add(
        third.bxor(leaf(argument, left))))
}

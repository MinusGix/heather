import bitvec;
import runtime;

runtime fn leaf(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    left.add(right)
}

// The native producer saves left XOR right in a frame slot before the call.
runtime fn caller(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    leaf(left, right).bxor(left.bxor(right))
}

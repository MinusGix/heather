import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import runtime;

// 32-bit words in 64-bit registers (issues/function-ir-narrow-arithmetic.md):
// a rotation as its shift pair, where the left shift's upper half must be
// cleared before the OR; sums that wrap at 2^32; a constant with its top
// bit set, which a sign-extended immediate would turn into a different
// 64-bit word; and a comparison against 2^31.
runtime fn words(a, b: BitVec(64)) → BitVec(64) {
    let x = a.truncate(32, 32);
    let y = b.truncate(32, 32);
    let rotated = x.shift_left(7).bor(x.shift_right(25));
    let sum = rotated.add(y).add(BitVec::ofNat(2654435769));
    match y.unsigned_lt_bit(BitVec::ofNat(2147483648)) {
        True => sum.sub(x).zero_extend(32),
        False => sum.bxor(y.shift_right(31)).shift_left(1).zero_extend(32),
    }
}

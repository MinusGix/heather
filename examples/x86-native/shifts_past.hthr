import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import int;
import sint;
import runtime;

// A count x86 would mask is legalized before selection: SHL by 64 or more
// is zero, an immediate MOV, never a shift.
runtime fn past(a, b: BitVec(64)) → BitVec(64) { a.shift_left(1000).bor(b) }

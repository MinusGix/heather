// `tr a-z A-Z`, as a certified static executable (docs/native-tr-design.md,
// docs/native-stream-filter-design.md): stdin to stdout with every lowercase
// ASCII letter made uppercase. The byte map below is the program, run as a
// stream filter that keeps nothing between bytes (`mapping`); reading,
// writing and the claim are the library's.
//
//     heather build-x86 examples/x86-native/tr.hthr tr_program -o tr
import filter_program;
import stream_filter;
import algebra;
import bitvec;
import bool;
import byte;
import char;
import list;
import logic;

// A lowercase letter's uppercase one is 0x20 below it; every other byte is
// itself.
fn upcase(b: BitVec(8)) → BitVec(8) {
    if 'a' <= b ∧ b <= 'z' { b.sub(0x20) } else { b }
}

theorem upcase_letter(): upcase('q') = 'Q' { refl }
theorem upcase_edges(): (upcase('`') = '`') ∧ ((upcase('a') = 'A') ∧ ((upcase('z') = 'Z') ∧ (upcase('{') = '{'))) {
    ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩
}

// What stdout is: the input, upcased byte by byte.
fn upcased(bytes: List<BitVec(8)>) → List<BitVec(8)> { bytes.map(upcase) }

// The program: the byte map as a step that keeps nothing. `heather build-x86`
// builds it by this name.
fn tr_program() → Filter<Stateless>(mapping(upcase), Stateless(), Nil, Quiet, upcased) {
    Filter(λ bytes => sym(mapping_output(upcase, bytes)))
}

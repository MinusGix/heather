// `tr a-z A-Z`, as a certified static executable (docs/native-tr-design.md):
// stdin to stdout with every lowercase ASCII letter made uppercase, a page at
// a time. The byte map below is the program; the process that reads a chunk,
// maps it in place, writes it and reads again, and its claim, are the
// library's (lib/elf64_read_map.hthr), for any byte map the compiler lowers.
//
//     heather build-x86 examples/x86-native/tr.hthr upcase --map -o tr
import bitvec;
import bool;
import logic;

// A lowercase ASCII letter: 'a' (0x61) to 'z' (0x7a).
fn lower_byte(b: BitVec(8)) → Bool {
    match b.unsigned_lt_bit(BitVec::ofNat(0x61)) { True => False, False => b.unsigned_lt_bit(BitVec::ofNat(0x7b)) }
}

// A lowercase letter's uppercase one is 0x20 below it; every other byte is
// itself.
fn upcase(b: BitVec(8)) → BitVec(8) {
    match lower_byte(b) { True => b.sub(BitVec::ofNat(0x20)), False => b }
}

theorem upcase_letter(): upcase(BitVec::ofNat(0x71)) = BitVec::ofNat(0x51) { refl }
theorem upcase_edges(): (upcase(BitVec::ofNat(0x60)) = BitVec::ofNat(0x60)) ∧ ((upcase(BitVec::ofNat(0x61)) = BitVec::ofNat(0x41)) ∧
    ((upcase(BitVec::ofNat(0x7a)) = BitVec::ofNat(0x5a)) ∧ (upcase(BitVec::ofNat(0x7b)) = BitVec::ofNat(0x7b)))) {
    ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩
}

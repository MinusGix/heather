import runtime;

runtime fn leaf(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    left.sub(right)
}

runtime fn caller(left: BitVec(64), right: BitVec(64)) -> BitVec(64) {
    let saved = left.bor(right);
    let first = leaf(right, left);
    let second = leaf(left, right);
    let shared = first.add(saved);
    shared.add(shared).add(
        first.add(first.add(second)))
}

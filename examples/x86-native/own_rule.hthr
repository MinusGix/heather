// A program that brings its own optimizer rule.
//
// `add_sub_left` is an ordinary theorem about words under the `rule` prefix
// (docs/native/optimizer-rules-design.md). Declaring it is all there is:
// the prefix registers it, `compile-x86` takes the rules registered in the
// program's modules beside the library's, the search finds where the
// statement fits, and the certificate's replay uses the rule's soundness,
// which the prefix proved from the theorem.
//
//     heather compile-x86 examples/x86-native/own_rule.hthr first_and_back -o own_rule.s
//
// With the rule the compiled function has no add and no subtraction;
// without it, both. The standard set of rules (function_ir_identities)
// has the sum taken back from the right, `(a + b) - b`, and not this one.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import function_ir_replay;
import function_ir_rule;
import runtime;

rule theorem add_sub_left({w: Nat}, a, b: BitVec(w)): (a + b) - a = b {
    trans(cong_fn(λ (z: BitVec(w)) => z - a, BitVec::add_comm(w, a, b)), BitVec::add_sub_cancel(w, b, a))
}

// The first byte of a span, or zero of an empty one, with the length
// added in front and taken away again.
runtime fn first_and_back(s: List<u8>, n: u64) → u64 {
    if h: 0 < n {
        (n + s.byte_within(n, 0).zero_extend(56)) - n
    } else {
        0
    }
}

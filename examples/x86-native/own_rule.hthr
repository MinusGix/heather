// A program that brings its own optimizer rule.
//
// `sub_self` is an ordinary theorem about words under the `rule` prefix
// (docs/native/optimizer-rules-design.md). Declaring it is all there is:
// the prefix registers it, `compile-x86` takes the rules registered in the
// program's modules beside the library's, the search finds where the
// statement fits, and the certificate's replay uses the rule's soundness,
// which the prefix proved from the theorem.
//
//     heather compile-x86 examples/x86-native/own_rule.hthr first_and_nothing -o own_rule.s
//
// With the rule the compiled function has no subtraction and no add;
// without it, both. The standard set of rules (function_ir_identities)
// does not have a word taken from itself, and no rule it has gives it.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import bitvec_ring;
import ring;
import omega;
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import function_ir_replay;
import function_ir_rule;
import runtime;

rule theorem sub_self({w: Nat}, a: BitVec(w)): a - a = 0 { ring }

// The first byte of a span, or zero of an empty one, with the length
// less itself added on.
runtime fn first_and_nothing(s: List<u8>, n: u64) → u64 {
    if h: 0 < n {
        s.byte_within(n, 0).zero_extend(56) + (n - n)
    } else {
        0
    }
}

import bitvec;

// Three levels of calls, a call in each arm of a branch, and arguments
// passed swapped: `compile-x86 … program` exports the whole program the
// verified lowering compiles (examples/x86-native/README.md).

fn twist(a, b: BitVec(64)) → BitVec(64) {
    a.sub(b).bxor(b)
}

fn middle(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) {
        False => twist(b, a),
        True => twist(a, b).add(a),
    }
}

fn program(a, b: BitVec(64)) → BitVec(64) {
    let m = middle(b, a);
    middle(m, a.add(b)).bor(twist(a, m))
}

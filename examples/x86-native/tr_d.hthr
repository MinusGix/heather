// `tr -d '\r'`, as a certified static executable
// (docs/native-stream-filter-design.md): stdin to stdout with every carriage
// return removed. The program is `tr_d_program` at the end: a step that keeps
// nothing between bytes, and what stdout is, `stripped`.
//
//     heather build-x86 examples/x86-native/tr_d.hthr tr_d_program -o tr_d
import filter_program;
import stream_filter;
import algebra;
import bitvec;
import bool;
import byte;
import char;
import list;
import logic;
import option;

fn kept(b: BitVec(8)) → Bool { decide_bit<b ≠ '\r'>() }

// What stdout is: the input less its carriage returns.
fn stripped(bytes: List<BitVec(8)>) → List<BitVec(8)> { bytes.filter(kept) }

// The step: a carriage return emits nothing, any other byte itself.
fn strip_step(s: Stateless, b: BitVec(8)) → Filtered<Stateless> {
    if b = '\r' { Filtered(s, None) } else { Filtered(s, Some(b)) }
}

// Why: one byte emits what the filter keeps of it.
theorem strip_one(s: Stateless, b: BitVec(8), rest: List<BitVec(8)>):
    Cons(b, rest).filter(kept) = emitted_byte(strip_step(s, b).emit) ++ rest.filter(kept) { split_all; all_goals { refl } }

// The program. `heather build-x86` builds it by this name.
fn tr_d_program() → Filter<Stateless>(strip_step, Stateless(), Nil, Quiet, stripped) {
    Filter(quiet_computes(strip_step, Stateless(), Nil, λ _ bytes => stripped(bytes), λ _ => refl, strip_one))
}

// Copies the big-endian word at `from` to `to`.
runtime fn List::copy_word(mut self s: List<u8>, n, from, to: u64) → u64 {
    let w = s.u32_be_within(n, from);
    s.put_u32_be_within(n, to, w);
    0
}

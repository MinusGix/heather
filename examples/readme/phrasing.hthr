// ---------------------------------------------------------------------------
// The pieces, named

// A program the compiler takes: functions, each calling only those before
// it, every node one the evaluator gives a meaning to.
record Program { functions: List<Function>, evaluable: program_evaluable(functions) = True }

// What the planner chooses, which nothing trusts: the register each value
// lives in, and how much stack each function asks for.
record Plan { placement: List<Place>, rooms: Nat → Nat }

fn Program::lower(self p: Program, plan: Plan) → Option<Prog> {
    lower_program_roomed(p.functions, plan.placement, [], plan.rooms)
}

// A call the program can make: one of its functions, at as many words as
// it takes.
record Call(p: Program) {
    function: Nat,
    arguments: List<u64>,
    defined: function < p.functions.len(),
    arity: arity_fits(program_arity(p.functions, function), arguments.len()) = True,
}

// What the program answers to it.
fn Program::answer(self p: Program, call: Call(p)) → u64 { program_eval(p.functions, call.function, call.arguments) }

// What holds of the value an option holds; of no value, nothing to hold.
fn Option::Each<A>(self o: Option<A>, P: A → Type) → Type {
    match o {
        None => True,
        Some(a) => P(a),
    }
}

// The code, called as `call` on `machine` with the room the plan gives,
// returns `answer`. (In the library this would be `Computes` itself.)
fn Prog::Yields<M>(self code: Prog, machine: Machine<M>, plan: Plan, {p: Program}, call: Call(p), answer: u64) → Type {
    code.Computes(machine, call.function, plan.rooms(call.function), call.arguments, answer)
}

// The code does what the program does on `machine`: every call of the
// program, run as machine code, returns what the program answers.
fn Prog::Runs<M>(self code: Prog, machine: Machine<M>, p: Program, plan: Plan) → Type {
    (call: Call(p)) → code.Yields(machine, plan, call, p.answer(call))
}

// ---------------------------------------------------------------------------
// The theorem

// Whatever the plan, the code the compiler gives does what the program does.
theorem Program::compiles<M>(self p: Program, plan: Plan, machine: Machine<M>):
    p.lower(plan).Each(λ code => code.Runs(machine, p, plan)) {
    match lowered: p.lower(plan) {
        None => trivial,
        Some(code) => λ call => compiler_correct<M>(p.functions, plan.placement, plan.rooms, code, lowered,
            Bool::is_true_of_eq(p.evaluable), machine, call.function, call.defined, call.arguments, Bool::is_true_of_eq(call.arity)),
    }
}

// ---------------------------------------------------------------------------
// At `clamp`

fn clamp_program() → Program { Program(clamp::program, refl) }

// `clamp(x, lo, hi)` as a call of its program.
fn clamp_call(x, lo, hi: u64) → Call(clamp_program()) { Call(0, [x, lo, hi], trivial, refl) }

// The program answers each call as `clamp` does.
theorem clamp_answers(x, lo, hi: u64): clamp_program().answer(clamp_call(x, lo, hi)) = clamp(x, lo, hi) {
    clamp::agrees(x, lo, hi)
}

// Whatever the plan, the code the compiler gives for `clamp`, called with
// any three words, returns `clamp` of them.
theorem clamp_compiles<M>(plan: Plan, machine: Machine<M>):
    clamp_program().lower(plan).Each(λ code => (x, lo, hi: u64) → code.Yields(machine, plan, clamp_call(x, lo, hi), clamp(x, lo, hi))) {
    match lowered: clamp_program().lower(plan) {
        None => trivial,
        Some(code) => λ x lo hi => {
            let runs: code.Runs(machine, clamp_program(), plan) = j(lowered, λ o _ => o.Each(λ c => c.Runs(machine, clamp_program(), plan)), clamp_program().compiles(plan, machine));
            rewrite(sym(clamp_answers(x, lo, hi)), runs(clamp_call(x, lo, hi)))
        },
    }
}

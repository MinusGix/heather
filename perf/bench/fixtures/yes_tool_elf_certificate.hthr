// The file written: its header, then the code.
fn yes_tool_elf_file() → List<BitVec(8)> { yes_tool_elf_header() ++ yes_tool_elf_upto_0() }

theorem yes_tool_elf_file_is(): io_elf_file(yes_tool_elf_upto_0(), yes_tool_elf_size()) = yes_tool_elf_file() {
    trans(cong_fn<Nat, List<BitVec(8)>>(λ n => List::append(io_elf_header(BitVec::ofNat(232 + n), BitVec::ofNat((232 + n).shr(8)), yes_tool_elf_size()), yes_tool_elf_upto_0()), yes_tool_elf_length()),
        cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ h => List::append(h, yes_tool_elf_upto_0()), yes_tool_elf_header_is()))
}

// Whatever names the compile's program, its file is the one written.
theorem yes_tool_elf_written(program: Prog, compiled: yes_tool_elf_lowered().compile(io_data_low(), yes_tool_elf_homes()) = Some(program)):
    io_elf_file(assemble(no_fills(), program, []), yes_tool_elf_size()) = yes_tool_elf_file() {
    let same: (yes_tool_elf_code() = program) = Option::some_inj(yes_tool_elf_code(), program, trans(sym(yes_tool_elf_compiles()), compiled));
    j(same, λ q _ => io_elf_file(assemble(no_fills(), q, []), yes_tool_elf_size()) = yes_tool_elf_file(),
        trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ x => io_elf_file(x, yes_tool_elf_size()), yes_tool_elf_bytes()), yes_tool_elf_file_is()))
}

theorem yes_tool_elf_short(): 232 + assemble(no_fills(), yes_tool_elf_code(), []).len() <= 65536 {
    j(sym(yes_tool_elf_bytes()), λ b _ => 232 + b.len() <= 65536,
        j(sym(yes_tool_elf_length()), λ n _ => 232 + n <= 65536, Nat::leb_sound(232 + 733, 65536, trivial)))
}

// The process Linux makes of the file written, at its entry with `depth`
// bytes of stack below RSP and the command line `args` on the stack above,
// simulates `yes_tool`'s tree run with `args` (`Source::elf_file_simulates`,
// from `native_compile_correct`).
theorem yes_tool_elf_simulates(top, depth: Nat, placed: StackPlaced(yes_tool_elf_size(), top, depth),
    s: MachineState<X86Memory(X86Profile::process(yes_tool_elf_size(), top, depth))>, entry: s.rip = io_entry(), rsp: read_gpr(Rsp, s.gprs).toNat() = top,
    loaded: s.memory.LoadedFrom(X86Profile::process(yes_tool_elf_size(), top, depth), yes_tool_elf_size(), yes_tool_elf_file()), args: List<List<BitVec(8)>>,
    argv: ArgvAt(X86Profile::process(yes_tool_elf_size(), top, depth).data().above(io_data_end(yes_tool_elf_size())), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimProgram(X86Profile::process(yes_tool_elf_size(), top, depth).linux(), yes_tool().source().denote(args), s) {
    j(sym(yes_tool_elf_lowered_is()), λ src _ => SimProgram(X86Profile::process(yes_tool_elf_size(), top, depth).linux(), src.denote(args), s),
        yes_tool_elf_lowered().elf_file_simulates(yes_tool_elf_size(), yes_tool_elf_within(), yes_tool_elf_code(), yes_tool_elf_homes(), yes_tool_elf_compiles(), yes_tool_elf_fits(), yes_tool_elf_short(),
        top, depth, placed, s, entry, rsp,
        j(sym(yes_tool_elf_written(yes_tool_elf_code(), yes_tool_elf_compiles())), λ f _ => s.memory.LoadedFrom(X86Profile::process(yes_tool_elf_size(), top, depth), yes_tool_elf_size(), f), loaded), args, argv))
}

import rt_held_fields;
import rt_held_reflect;
import rt_held_loop;

laid(endian := BigEndian) record Sched { w: [u64; 8], rounds: u64 }

runtime fn Sched::expand(mut self s: Sched, j: u64) → u64
    decreases (6 - j).toNat() {
    if h: j < 6 {
        let a = s.w.at(j + 1);
        let b = s.w.at(j);
        s.w := s.w.put(j + 2, a + b);
        s.expand(j + 1)
    } else {
        s.rounds
    }
}

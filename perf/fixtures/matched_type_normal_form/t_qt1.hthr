// qt1 — t_cp9's component (`And<relation(…),True>`, the +1.72 M block) with
// the ENCLOSING proof shortened to t_cp3's: the same `bind_at` over the same
// open `r`, continued by `pure_at`, so nothing is stuck on the remainder and
// the reply is one combinator instead of three. Component fixed, proof
// varied — the round's (a)-against-(b)/(c) probe.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPAndT<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<relation(source,begin,end,value),True>
}
theorem qt_pure<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPAndT<T,A>(relation),
        bind_at<T,A,A>(source,begin,r,λ value middle forward => pure_at(source,middle,value))) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => And(h,trivial) }
}

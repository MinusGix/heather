// qt2 — the same component again with NO combinator in the conclusion at all
// (t_cp4's floor). If the block is a property of the component, it is here
// too; if it is charged per node of the enclosing proof, it is gone.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPAndT<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<relation(source,begin,end,value),True>
}
theorem qt_floor<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPAndT<T,A>(relation),r) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => And(h,trivial) }
}

// qt4 — t_qt3's conclusion with the reply expression NAMED: the same term,
// written once as a declaration and applied, so the conclusion's type carries
// a four-argument global instead of the inline spine. The library form of the
// design's lever; if the count collapses, the multiplier is the inline
// spelling of the reply in the type it is checked against.
import nat;
import list;
import logic;
import result;
import option;
import pair;
import int;
import omega;
import parser;

fn CPAndT<T,A>(
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin: Cursor<T>(source), end: Cursor<T>(source), value: A) -> Type {
    And<relation(source,begin,end,value),True>
}
fn qt_reply<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat) ->
    Reply<T,A>(source,begin) {
    bind_at<T,A,A>(source,begin,r,λ value middle forward =>
        map_at(source,middle,map_at(source,middle,eof_at(expected,source,middle),λ (i: Nat) => i),λ (ignored: Nat) => value))
}
theorem qt_named<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), expected: Nat,
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type):
    Post(source,begin,relation,r) -> Post(source,begin,CPAndT<T,A>(relation),
        qt_reply<T,A>(source,begin,r,expected)) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h => match shape : rest(source,s.end) {
        Nil => And(h,trivial), Cons(head,tail) => trivial,
    } }
}

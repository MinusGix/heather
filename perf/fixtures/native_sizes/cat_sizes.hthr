// write-elf's size probes (issues/native-compile-capacity.md): cat with its
// pass inlined k times in its loop, so code grows linearly in k while the
// statement tree keeps cat's shape. `run.sh` builds each with `--timings`;
// the shapes are in the issue's log.
import native_source;
import native_cat;
import function_ir;
import list;
import native_compile;
import native_compile_correct;
import linux_x86_64_image;
import x86_64;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_data_read;
import x86_64_store;
import bitvec;
import bool;
import logic;
import nat;
import option;

fn passes(k: Nat) → Stmt { match k { Zero => cat_pass(), Succ(j) => Then(cat_pass(), passes(j)) } }
fn cat_x(k: Nat) → Source {
    Source(functions := [], buffers := [Buffer(512)], main := Then(cat_setup(512), Repeat(passes(k), 15)))
}
fn cat_x2() → Source { cat_x(1) }
fn cat_x4() → Source { cat_x(3) }
fn cat_x8() → Source { cat_x(7) }
fn cat_x16() → Source { cat_x(15) }
fn cat_x60() → Source { cat_x(59) }

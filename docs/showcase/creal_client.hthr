// Regular Cauchy reals as a setoid client (docs/library/creal.md).
//
// As with the rationals, the proofs below never look inside a sequence. They
// use the laws `std/creal` states modulo `≈`: `calc` chains glued by the
// `Equivalence<CReal>(CReal::Same)` instance and by the mixed `Trans` pairs
// of `≈` with `<` and `≤`, and `rel_cong` through `+` and `*` by the
// registered `Respects2` instances.

import logic;
import nat;
import int;
import omega;
import algebra;
import rat;
import creal;
import relation_props;
import algebra_rel;

// Cancel a pair inside a sum: `rel_cong` carries `y + -y ≈ 0` under `x + _`.
theorem cancel_inside(x, y: CReal): x + (y + -y) ≈ x {
    calc {
        x + (y + -y) ≈ x + 0 := rel_cong(y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

// Subtraction undoes addition.
theorem add_sub_cancel(x, y: CReal): (x + y) -y ≈ x {
    calc {
        (x + y) -y ≈ x + (y + -y) := x.add_assoc(y, -y),
        ≈ x := cancel_inside(x, y),
    }
}

// A strict chain may pass through `≈` steps on either side.
theorem lt_chain(x, y, z, w: CReal, a: x ≈ y, b: y < z, c: z ≈ w): x < w {
    calc {
        x ≈ y := a,
        < z := b,
        ≈ w := c,
    }
}

// The rationals' order and sums carry over to their embeddings.
theorem embedded_sum_below(p, q, r: Rat, h: p + q < r): CReal::ofRat(p) + CReal::ofRat(q) < CReal::ofRat(r) {
    calc {
        CReal::ofRat(p) + CReal::ofRat(q) ≈ CReal::ofRat(p + q) := CReal::same_sym(CReal::ofRat_add(p, q)),
        < CReal::ofRat(r) := CReal::ofRat_lt(h),
    }
}

// Distinct rationals embed apart; apartness, not a decision, is what tells
// reals apart.
theorem zero_below_one(): CReal::Lt(0, 1) {
    let gap: Rat::Lt(0, 1) = omega;
    CReal::ofRat_lt(gap)
}

theorem one_not_le_zero(): ¬CReal::Le(1, 0) { λ h => h(zero_below_one()) }

theorem zero_apart_one(): CReal::Apart(0, 1) { Inl(zero_below_one()) }

// Reals that are not apart are the same.
theorem tight(x, y: CReal, h: ¬(x.Apart(y))): y ≈ x { CReal::same_sym(CReal::same_of_not_apart(h)) }

// ---------------------------------------------------------------------------
// Products and the non-strict order.

// `rel_cong` carries `≈` through `*` as through `+`.
theorem drop_one_inside(x, y: CReal): x * (y * 1) ≈ x * y { rel_cong(y.mul_one()) }

// Distributing from the right goes through commutativity.
theorem mul_add_distr_r(x, y, z: CReal): (x + y) * z ≈ x * z + y * z {
    calc {
        (x + y) * z ≈ z * (x + y) := (x + y).mul_comm(z),
        ≈ z * x + z * y := z.mul_add_distr(x, y),
        ≈ x * z + y * z := CReal::add_respects(z.mul_comm(x), z.mul_comm(y)),
    }
}

// The embedding carries rational products, and zero absorbs.
theorem embedded_square(q: Rat): CReal::ofRat(q) * CReal::ofRat(q) ≈ CReal::ofRat(q * q) {
    CReal::same_sym(CReal::ofRat_mul(q, q))
}

theorem times_zero(x, y: CReal): (x + y) * 0 ≈ 0 { (x + y).mul_zero() }

// `≤` is the refutation of `>`, and a chain may mix it with `≈` and `<`.
theorem le_chain(x, y, z, w: CReal, a: x ≈ y, b: y <= z, c: z < w): x < w {
    calc {
        x ≈ y := a,
        <= z := b,
        < w := c,
    }
}

// Reals below each other are the same.
theorem squeeze(x, y: CReal, a: x <= y, b: y <= x): x ≈ y { CReal::le_antisymm(a, b) }

// ---------------------------------------------------------------------------
// The inverse, at a proof of apartness from zero.

// Dividing and multiplying back. `y⁻¹` finds the apartness in scope.
theorem div_mul_cancel(x, y: CReal, h: y.Apart(0)): (x * y⁻¹) * y ≈ x {
    calc {
        (x * y⁻¹) * y ≈ x * (y⁻¹ * y) := x.mul_assoc(y⁻¹, y),
        ≈ x * 1 := rel_cong(y.inv_mul()),
        ≈ x := x.mul_one(),
    }
}

// Which apartness proof is used does not matter, though their gaps may
// differ and with them where the inverse reads.
theorem inv_any_proof(x: CReal, h, h2: x.Apart(0)): x.inv(h := h) ≈ x.inv(h := h2) {
    CReal::inv_respects(x.same_refl(), h := h, h2 := h2)
}

// A sign is enough, and the inverse is the power at -1.
theorem inv_of_positive(x: CReal, h: 0 < x): x * x⁻¹ ≈ 1 { x.mul_inv() }

theorem inv_is_pow(x: CReal, h: x.Apart(0)): x ^ (-1) ≈ x⁻¹ { x.pow_neg_one() }

// ---------------------------------------------------------------------------
// Order and addition, and Bishop's pointwise forms.

// Positive reals have a positive sum, and a gap between sums lies between
// one pair of summands.
theorem sum_pos(x, y: CReal, a: 0 < x, b: 0 < y): 0 < x + y { CReal::add_pos(a, b) }

theorem gap_splits(x, y, z, w: CReal, h: x + y < z + w): x < z ∨ y < w { CReal::add_lt_cancel(h) }

// Adding to both sides keeps `≤`, so translation is monotone in a chain.
theorem shift_chain(x, y, z: CReal, a: x <= y, b: y < z): x + 1 < z + 1 {
    calc {
        x + 1 <= y + 1 := x.add_le_mono_r(y, 1, a),
        < z + 1 := y.add_lt_mono_r(z, 1, b),
    }
}

// Products against the order: positive factors, a positive product; and a
// nonnegative factor scales both sides of `≤`, a positive one both of `<`.
theorem square_pos(x: CReal, h: 0 < x): 0 < x * x { CReal::mul_pos(h, h) }

theorem scale_chain(x, y, z, w: CReal, a: x <= y, b: y < z, hw: 0 < w): x * w < z * w {
    calc {
        x * w <= y * w := CReal::mul_le_mono_r(a, CReal::le_of_lt(hw)),
        < z * w := CReal::mul_lt_mono_r(b, hw),
    }
}

// `≈` read Bishop's way: at every index, not only eventually. A term `x.at(n)`
// is the dyadic `x.seq(n)` read as a rational, within 2^-n of the real.
theorem close_at_three(x, y: CReal, h: x ≈ y): (x.at(3) - y.at(3)).abs() <= Rat::inv_pow2(3) + Rat::inv_pow2(3) {
    CReal::bishop_of_same(h)(3)
}

// And `≤` read Bishop's way, back to the refutation.
theorem le_from_terms(x, y: CReal, h: (n: Nat) → x.at(n) <= y.at(n) + (Rat::inv_pow2(n) + Rat::inv_pow2(n))): x <= y {
    CReal::le_of_bishop(h)
}

// ---------------------------------------------------------------------------
// The representation computes.

fn half() → Rat { Rat(OfNat(1), 2) }
fn third() → Rat { Rat(OfNat(1), 3) }

// A sum's term is the summands' terms one index further out, added as
// dyadics: at index 6 a half is 64/128 and a third rounds down to 42/128.
theorem sum_term(): (CReal::ofRat(half()) + CReal::ofRat(third())).at(5) ≈ Rat(OfNat(53), 64) { refl }

// The modulus is data: `add_zero` says how far out `x + 0` is within
// 1/(k+1) of `x`, and the answer evaluates.
theorem add_zero_start(): CReal::add_zero(1, 3).witness = 7 { refl }

// So is a gap: `0 < 1` is witnessed by 1/(k+1) below the rational gap, with
// room left for the terms' roundings: 1/8 here.
theorem one_gap(): zero_below_one().witness = 7 { refl }

// Two different sequences are the same real: 1/2 written as 2/4.
theorem half_same(): CReal::ofRat(half()) ≈ CReal::ofRat(Rat(OfNat(2), 4)) { CReal::ofRat_respects(refl) }

// A product reads its factors a few bits further out (their bounds' bit
// width) and rounds the exact product down to n + 1 bits: a sixth at index
// 10 is 341/2048.
theorem product_term(): (CReal::ofRat(half()) * CReal::ofRat(third())).at(10) ≈ Rat(OfNat(341), 2048) { refl }

// The product laws' moduli compute too, through `mul_close`: for 1 · 1,
// regularity grants the closeness the bounds ask for from index 143 on.
theorem mul_comm_start(): CReal::mul_comm(1, 1, 0).witness = 143 { refl }

// The inverse computes: 0 < 2 carries the gap 1/8 (k = 7), so term n reads
// x past the gap's start and at least n + 1 + w out, w the bit width of
// (k+1)², and every term inverts the constant 2 exactly.
theorem two_apart(): CReal::ofRat(Rat(OfNat(2), 1)).Apart(0) {
    let gap: (0 < Rat(OfNat(2), 1)) = omega;
    Inr(CReal::ofRat_lt(gap))
}

theorem two_gap(): (CReal::ofRat(Rat(OfNat(2), 1)).away_of_apart(two_apart())).witness = 7 { refl }

theorem inv_two_index(): CReal::inv_at(7, 0, 4) = 12 { refl }

theorem inv_two_term(): CReal::ofRat(Rat(OfNat(2), 1)).inv(h := two_apart()).at(4) ≈ half() { refl }

// Written as notation, the apartness comes from the rational's sign
// (`ofRat_apart`, `Rat::apart_of_positive`), and the embedding carries the
// rational inverse across.
theorem inv_two_searched(): CReal::ofRat(Rat(OfNat(2), 1))⁻¹ ≈ CReal::ofRat(Rat(OfNat(2), 1)⁻¹) {
    CReal::ofRat_inv(Rat(OfNat(2), 1))
}

// Adding to both sides of a gap keeps it: the same 1/(k+1), from the same
// start.
theorem shifted_gap(z: CReal): CReal::add_lt_mono_r(0, 1, z, zero_below_one()).witness = 7 { refl }

// A product of positive reals clears zero by the product of the gaps: 0 < 1
// has the gap 1/8, and the product's gap, 1/256, leaves room for the
// product's rounding.
theorem squared_gap(): CReal::mul_pos(zero_below_one(), zero_below_one()).witness = 255 { refl }

// One theory, two carriers: the constructive ordered-field interface
// (lib/std/algebra/ordered_field.hthr, docs/library/constructive-ordered-field-design.md)
// used at the rationals and at the regular Cauchy reals.
//
// Each generic theorem below is proved once, at the weakest layer it needs,
// and then called at `Rat` and at `CReal`. The calls name no dictionary and
// no operation: the carrier is read off the first point, and its registered
// instances fill `≈`, `<`, `≤`, `+` and `*`.

import logic;
import nat;
import int;
import omega;
import algebra;
import relation_props;
import algebra_rel;
import ordered_field;
import rat;
import creal;

// ---------------------------------------------------------------------------
// A client's own generic theorem: if x is within e of a and within d of b,
// then a and b are within e + d. The triangle inequality, in the bounded
// form, at any ordered additive group; locatedness is never asked for.
theorem close_through<A: OrderedAddGroup(≈, <, <=, +)>(a, b, x, e, d: A, ha: Close(x, a, e), hb: Close(x, b, d)):
    Close(a, b, e + d)
{
    OrderedAddGroup::close_triangle(a, x, b, e, d, OrderedAddGroup::close_sym(x, a, e, ha), hb)
}

theorem rat_close_through(a, b, x, e, d: Rat, ha: Close(x, a, e), hb: Close(x, b, d)): Close(a, b, e + d) {
    close_through(a, b, x, e, d, ha, hb)
}

theorem creal_close_through(a, b, x, e, d: CReal, ha: Close(x, a, e), hb: Close(x, b, d)): Close(a, b, e + d) {
    close_through(a, b, x, e, d, ha, hb)
}

// The bounds unfold to each carrier's own order and negation: `AbsLt(x, e)`
// at `Rat` is `-e < x ∧ x < e`, with `Rat::neg` and `Rat::Lt`. A hypothesis
// may be written either way, and so may a result: the carrier, read off the
// first point, fills the theorem's indices whichever spelling it meets.
theorem rat_abs_lt_add(x, y, e, d: Rat, hx: -e < x ∧ x < e, hy: -d < y ∧ y < d): -(e + d) < x + y ∧ x + y < e + d {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}

theorem creal_abs_lt_add(x, y, e, d: CReal, hx: -e < x ∧ x < e, hy: -d < y ∧ y < d): -(e + d) < x + y ∧ x + y < e + d {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}

// ---------------------------------------------------------------------------
// Tightness: what is within every positive distance is the same.

theorem rat_same_of_close(x, y: Rat, all: (e: Rat) → 0 < e → Close(x, y, e)): x ≈ y {
    OrderedAddGroup::same_of_close(x, y, all)
}

theorem creal_same_of_close(x, y: CReal, all: (e: CReal) → 0 < e → Close(x, y, e)): x ≈ y {
    OrderedAddGroup::same_of_close(x, y, all)
}

// `≤` antisymmetry modulo `≈` at both, through each carrier's own `≤`.
theorem rat_le_antisymm(x, y: Rat, hxy: x <= y, hyx: y <= x): x ≈ y { StrictOrder::le_antisymm(x, y, hxy, hyx) }

theorem creal_le_antisymm(x, y: CReal, hxy: x <= y, hyx: y <= x): x ≈ y { StrictOrder::le_antisymm(x, y, hxy, hyx) }

// ---------------------------------------------------------------------------
// Intervals. Closed ones need locatedness for their transitivity; both
// carriers are located, so both get every lemma.

theorem rat_nested(a, x, b, a2, b2: Rat, ha: a2 <= a, hb: b <= b2, h: a <= x ∧ x <= b): a2 <= x ∧ x <= b2 {
    PseudoOrder::within_widen(a, x, b, a2, b2, ha, hb, h)
}

theorem creal_nested(a, x, b, a2, b2: CReal, ha: a2 <= a, hb: b <= b2, h: a <= x ∧ x <= b): a2 <= x ∧ x <= b2 {
    PseudoOrder::within_widen(a, x, b, a2, b2, ha, hb, h)
}

// A gap places every real, without deciding anything about it.
theorem creal_locate(a, b, x: CReal, h: a < b): a < x ∨ x < b { PseudoOrder::locate(a, b, x, h) }

// A bound with a point under it is positive: a located-group theorem.
theorem creal_bound_pos(x, e: CReal, h: -e < x ∧ x < e): 0 < e { LocatedAddGroup::abs_lt_pos(x, e, h) }

// ---------------------------------------------------------------------------
// The field. The inverse is unique whichever apartness proof built it, which
// the reals did not have on their own.

theorem creal_inv_unique(x, u: CReal, h: x.Apart(0), hu: x * u ≈ 1): u ≈ x.inv(h := h) {
    OrderedField::recip_unique(x, h, u, hu)
}

theorem creal_inv_any_proof(x: CReal, h, h2: x.Apart(0)): x.inv(h := h) ≈ x.inv(h := h2) {
    OrderedField::recip_respects(x, x, h, h2, x.same_refl())
}

theorem rat_mul_lt(x, y, z: Rat, h: x < y, hz: 0 < z): z * x < z * y { OrderedSemiring::mul_lt_mono_l(x, y, z, h, hz) }

// Every real is below some natural number, and the naturals climb.
theorem creal_below_nat(x: CReal): ∃ n: Nat, x < CReal::ofRat(Rat::ofInt(OfNat(n))) { CReal::archimedean(x) }

theorem creal_nat_climbs(n: Nat): CReal::ofRat(Rat::ofInt(OfNat(n))) < CReal::ofRat(Rat::ofInt(OfNat(Succ(n)))) {
    OrderedField::of_nat_lt_succ(n)
}

// ---------------------------------------------------------------------------
// The inverse's sign. A positive factor reflects a product's sign at both
// carriers (`pos_of_mul_pos`, a law), so the inverse has its argument's sign
// and reverses the order of positives, once for both.

theorem rat_inv_pos(x: Rat, hx: 0 < x): 0 < x⁻¹ { OrderedField::recip_pos(x, Inr(hx), hx) }

theorem creal_inv_pos(x: CReal, hx: 0 < x): 0 < x⁻¹ { OrderedField::recip_pos(x, Inr(hx), hx) }

theorem creal_inv_neg(x: CReal, hx: x < 0): x⁻¹ < 0 { OrderedField::recip_neg(x, Inl(hx), hx) }

// `y⁻¹` is searched, so the client names y's positivity; the generic
// theorem derives it from x < y.
theorem creal_inv_lt_inv(x, y: CReal, hx: 0 < x, hy: 0 < y, h: x < y): y⁻¹ < x⁻¹ {
    OrderedField::recip_lt_recip(x, y, Inr(hx), Inr(hy), hx, h)
}

// Every positive real is above some 1/(n+1), the form the Cauchy reals'
// own estimates are written in. A real's inverse reads its argument where
// the apartness proof's gap says, so the generic theorem's inverse, built
// from its own proof, is the searched one only up to `≈`.
theorem creal_archimedean_inv(x: CReal, hx: 0 < x):
    ∃ n: Nat, CReal::ofRat(Rat::ofInt(OfNat(Succ(n))))⁻¹ < x
{
    match OrderedField::archimedean_recip(x, hx) {
        Exists(n, below) => Exists(n, CReal::lt_respects(CReal::inv_respects(CReal::ofRat(Rat::ofInt(OfNat(Succ(n)))).same_refl(), h := Inr(OrderedField::of_nat_pos(n))), x.same_refl(), below)),
    }
}

// Calculator grammar built from the checked parser library.
//
// `import parser;` is the whole library. The facade reexports the cursor
// model, the contracts, the diagnostics, the combinators, the primitives and
// the recursion guard under one module name (docs/modules-design.md §3.4), so
// the operations below are spelled unqualified and still resolve to the
// component that declares each one — `rest` is `parser_core::rest`, and an
// axiom audit reports that component, not the facade.
import nat;
import list;
import result;
import logic;
import option;
import parser;
import calc;
// The mutual `decreases` group below shares one recursion whose motive is a
// nested `Pair` (docs/mutual-recursion-design.md §3); nothing here names it.
import pair;

inductive PTok { TNum(n: Nat), TPlusSym, TStarSym, TOpen, TClose }
inductive ParseError { ExpectedAtom, UnexpectedEnd, BadParen, Trailing }
fn number(t: PTok) -> Option<Expr> { match t { TNum(n) => Some(Lit(n)), _ => None } }
fn plus(t: PTok) -> Option<Nat> { match t { TPlusSym => Some(0), _ => None } }
fn times(t: PTok) -> Option<Nat> { match t { TStarSym => Some(0), _ => None } }
fn opening(t: PTok) -> Option<Nat> { match t { TOpen => Some(0), _ => None } }
fn closing(t: PTok) -> Option<Nat> { match t { TClose => Some(0), _ => None } }

// Independent grammar: constructors describe productions, without executing a parser.
// Tiers are expression = 0, factor = 1, atom = 2.
inductive Derivation {
    Number(n: Nat),
    AtomFactor(atom: Derivation),
    FactorExpr(factor: Derivation),
    Sum(left: Derivation, right: Derivation),
    Product(left: Derivation, right: Derivation),
    Parenthesized(inner: Derivation),
}
fn tier(d: Derivation) -> Nat {
    match d { Number(_) => 2, AtomFactor(_) => 1, FactorExpr(_) => 0,
        Sum(_,_) => 0, Product(_,_) => 1, Parenthesized(_) => 2 }
}
fn meaning(d: Derivation) -> Expr {
    match d { Number(n) => Lit(n), AtomFactor(a) => meaning(a), FactorExpr(f) => meaning(f),
        Sum(l,r) => Plus(meaning(l),meaning(r)), Product(l,r) => Times(meaning(l),meaning(r)),
        Parenthesized(e) => meaning(e) }
}
fn spelling(d: Derivation) -> List<PTok> {
    match d { Number(n) => [TNum(n)], AtomFactor(a) => spelling(a), FactorExpr(f) => spelling(f),
        Sum(l,r) => spelling(l) ++ Cons(TPlusSym,spelling(r)),
        Product(l,r) => spelling(l) ++ Cons(TStarSym,spelling(r)),
        Parenthesized(e) => Cons(TOpen,spelling(e) ++ [TClose]) }
}
fn WellFormed(d: Derivation) -> Type {
    match d { Number(_) => True,
        AtomFactor(a) => And<tier(a) = 2, WellFormed(a)>,
        FactorExpr(f) => And<tier(f) = 1, WellFormed(f)>,
        Sum(l,r) => And<And<tier(l) = 1, WellFormed(l)>, And<tier(r) = 0, WellFormed(r)>>,
        Product(l,r) => And<And<tier(l) = 2, WellFormed(l)>, And<tier(r) = 1, WellFormed(r)>>,
        Parenthesized(e) => And<tier(e) = 0, WellFormed(e)> }
}
record Grammar(level: Nat, source: List<PTok>, begin,end: Cursor<PTok>(source), value: Expr) {
    derivation: Derivation,
    valid: WellFormed(derivation),
    at_level: tier(derivation) = level,
    yields: meaning(derivation) = value,
    span: rest(source,begin) = spelling(derivation) ++ rest(source,end),
}
fn GrammarSpec(level: Nat, source: List<PTok>, begin,end: Cursor<PTok>(source), value: Expr) -> Type {
    Grammar(level,source,begin,end,value)
}
// What a tier's parser returns: a certified `Expr` whose evidence is the
// grammar at that tier, or a failure over the same source. Spelled out, this
// type runs to sixty-nine columns and appears twenty-five times below.
fn Checked(level: Nat, source: List<PTok>, begin: Cursor<PTok>(source)) -> Type {
    Result<Certified<PTok,Expr>(source,begin,GrammarSpec(level)),Failure<PTok>(source)>
}
fn factor_grammar(source: List<PTok>, begin,end: Cursor<PTok>(source), value: Expr,
    atom: Grammar(2,source,begin,end,value)) -> Grammar(1,source,begin,end,value) {
    Grammar(AtomFactor(atom.derivation),⟨atom.at_level,atom.valid⟩,refl,atom.yields,atom.span)
}
fn expression_grammar(source: List<PTok>, begin,end: Cursor<PTok>(source), value: Expr,
    factor: Grammar(1,source,begin,end,value)) -> Grammar(0,source,begin,end,value) {
    Grammar(FactorExpr(factor.derivation),⟨factor.at_level,factor.valid⟩,refl,factor.yields,factor.span)
}
// A token step specifies the actual remainder, including its next boundary.
fn TokenSpan(token: PTok, source: List<PTok>, begin,end: Cursor<PTok>(source), ignored: Nat) -> Type {
    rest(source,begin) = Cons(token,rest(source,end))
}
theorem span_join(xs,ys,first,middle,last: List<PTok>, a: first = xs ++ middle, b: middle = ys ++ last):
    first = (xs ++ ys) ++ last {
    trans(a,trans(j(b,λ tail q => xs ++ middle = xs ++ tail,refl),sym(list::append_assoc(xs,ys,last))))
}
fn sum_grammar(source: List<PTok>, begin,middle,next,end: Cursor<PTok>(source), left,right: Expr,
    l: Grammar(1,source,begin,middle,left), op: TokenSpan(TPlusSym,source,middle,next,0),
    r: Grammar(0,source,next,end,right)) -> Grammar(0,source,begin,end,Plus(left,right)) {
    Grammar(Sum(l.derivation,r.derivation),⟨⟨l.at_level,l.valid⟩,⟨r.at_level,r.valid⟩⟩,refl,
        j(l.yields,λ value q => Plus(meaning(l.derivation),meaning(r.derivation)) = Plus(value,right),
            j(r.yields,λ value q => Plus(meaning(l.derivation),meaning(r.derivation)) = Plus(meaning(l.derivation),value),refl)),
        span_join(spelling(l.derivation),Cons(TPlusSym,spelling(r.derivation)),rest(source,begin),rest(source,middle),rest(source,end),
            l.span,trans(op,list::cong_cons(TPlusSym,r.span))))
}
fn product_grammar(source: List<PTok>, begin,middle,next,end: Cursor<PTok>(source), left,right: Expr,
    l: Grammar(2,source,begin,middle,left), op: TokenSpan(TStarSym,source,middle,next,0),
    r: Grammar(1,source,next,end,right)) -> Grammar(1,source,begin,end,Times(left,right)) {
    Grammar(Product(l.derivation,r.derivation),⟨⟨l.at_level,l.valid⟩,⟨r.at_level,r.valid⟩⟩,refl,
        j(l.yields,λ value q => Times(meaning(l.derivation),meaning(r.derivation)) = Times(value,right),
            j(r.yields,λ value q => Times(meaning(l.derivation),meaning(r.derivation)) = Times(meaning(l.derivation),value),refl)),
        span_join(spelling(l.derivation),Cons(TStarSym,spelling(r.derivation)),rest(source,begin),rest(source,middle),rest(source,end),
            l.span,trans(op,list::cong_cons(TStarSym,r.span))))
}
fn paren_grammar(source: List<PTok>, begin,next,middle,end: Cursor<PTok>(source), value: Expr,
    op: TokenSpan(TOpen,source,begin,next,0), inner: Grammar(0,source,next,middle,value),
    close: TokenSpan(TClose,source,middle,end,0)) -> Grammar(2,source,begin,end,value) {
    Grammar(Parenthesized(inner.derivation),⟨inner.at_level,inner.valid⟩,refl,inner.yields,
        trans(op,list::cong_cons(TOpen,
            span_join(spelling(inner.derivation),[TClose],rest(source,next),rest(source,middle),rest(source,end),inner.span,close))))
}

theorem number_selected(token: PTok, value: Expr):
    number(token) = Some(value) -> Exists<Nat>(λ n => And<token = TNum(n), Lit(n) = value>) {
    match token { TNum(n) => λ h => Exists(n,⟨refl,inj(h)⟩),
        TPlusSym => λ h => absurd(h), TStarSym => λ h => absurd(h),
        TOpen => λ h => absurd(h), TClose => λ h => absurd(h) }
}
fn number_grammar(source: List<PTok>, begin,end: Cursor<PTok>(source), value: Expr,
    proof: Recognized<PTok,Expr>(number,source,begin,end,value)) -> Grammar(2,source,begin,end,value) {
    let head = recognized_head(number,source,begin,end,value,proof);
    let selected = number_selected(head.head,value,head.selected);
    Grammar(Number(selected.witness),trivial,refl,selected.proof.right,
        trans(head.suffix,j(selected.proof.left,λ token q => Cons(head.head,rest(source,end)) = Cons(token,rest(source,end)),refl)))
}
theorem plus_selected(token: PTok, value: Nat): plus(token) = Some(value) -> token = TPlusSym {
    match token { TPlusSym => λ h => refl, TNum(_) => λ h => absurd(h), TStarSym => λ h => absurd(h), TOpen => λ h => absurd(h), TClose => λ h => absurd(h) }
}
theorem times_selected(token: PTok, value: Nat): times(token) = Some(value) -> token = TStarSym {
    match token { TStarSym => λ h => refl, TNum(_) => λ h => absurd(h), TPlusSym => λ h => absurd(h), TOpen => λ h => absurd(h), TClose => λ h => absurd(h) }
}
theorem opening_selected(token: PTok, value: Nat): opening(token) = Some(value) -> token = TOpen {
    match token { TOpen => λ h => refl, TNum(_) => λ h => absurd(h), TPlusSym => λ h => absurd(h), TStarSym => λ h => absurd(h), TClose => λ h => absurd(h) }
}
theorem closing_selected(token: PTok, value: Nat): closing(token) = Some(value) -> token = TClose {
    match token { TClose => λ h => refl, TNum(_) => λ h => absurd(h), TPlusSym => λ h => absurd(h), TStarSym => λ h => absurd(h), TOpen => λ h => absurd(h) }
}
fn symbol_span(pick: PTok -> Option<Nat>, token: PTok,
    selects: (t: PTok) -> (value: Nat) -> pick(t) = Some(value) -> t = token,
    source: List<PTok>, begin,end: Cursor<PTok>(source), value: Nat,
    proof: Recognized<PTok,Nat>(pick,source,begin,end,value)) -> TokenSpan(token,source,begin,end,value) {
    let head = recognized_head(pick,source,begin,end,value,proof);
    trans(head.suffix,j(selects(head.head,value,head.selected),λ t q => Cons(head.head,rest(source,end)) = Cons(t,rest(source,end)),refl))
}

fn sum_finish(source: List<PTok>, begin,middle,next: Cursor<PTok>(source), forward: nat::Le(begin.offset,next.offset),
    left: Expr, proof: Grammar(1,source,begin,middle,left), token: TokenSpan(TPlusSym,source,middle,next,0),
    r: Checked(0,source,next)) -> Checked(0,source,begin) {
    match r { Err(e) => Err(commit_after(source,begin,next,e)),
        Ok(right) => Ok(Certified(Plus(left,right.value),right.end,
            nat::le_trans(begin.offset,next.offset,right.end.offset,forward,right.forward),
            sum_grammar(source,begin,middle,next,right.end,left,right.value,proof,token,right.evidence))) }
}
fn product_finish(source: List<PTok>, begin,middle,next: Cursor<PTok>(source), forward: nat::Le(begin.offset,next.offset),
    left: Expr, proof: Grammar(2,source,begin,middle,left), token: TokenSpan(TStarSym,source,middle,next,0),
    r: Checked(1,source,next)) -> Checked(1,source,begin) {
    match r { Err(e) => Err(commit_after(source,begin,next,e)),
        Ok(right) => Ok(Certified(Times(left,right.value),right.end,
            nat::le_trans(begin.offset,next.offset,right.end.offset,forward,right.forward),
            product_grammar(source,begin,middle,next,right.end,left,right.value,proof,token,right.evidence))) }
}
// The productions compose through the generic `Result` eliminators rather than
// through `match`, which keeps one proof type per tier. Their type arguments and
// their continuations' parameter types are all inferred: writing them out, as
// this file used to, cost 577 conversion misses and bought nothing.
fn expr_body(source: List<PTok>, begin: Cursor<PTok>(source),
    first: Checked(1,source,begin),
    recur: (next: Cursor<PTok>(source))
        -> nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))
        -> Checked(0,source,next))
    -> Checked(0,source,begin) {
    first.and_then(λ left =>
        recognize_certified(plus,0,source,left.end).fold(
            λ op => {
                let token = symbol_span(plus,TPlusSym,plus_selected,source,left.end,op.end,op.value,op.evidence);
                let step = recognized_progress(plus,source,left.end,op.end,op.value,op.evidence);
                let small = progress_after(source,begin,left.end,op.end,left.forward,step);
                sum_finish(source,begin,left.end,op.end,nat::le_trans(begin.offset,left.end.offset,op.end.offset,left.forward,op.forward),
                    left.value,left.evidence,token,recur(op.end,small))
            },
            λ ignored => Ok(Certified(left.value,left.end,left.forward,
                expression_grammar(source,begin,left.end,left.value,left.evidence)))))
}
fn factor_body(source: List<PTok>, begin: Cursor<PTok>(source),
    first: Checked(2,source,begin),
    recur: (next: Cursor<PTok>(source))
        -> nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))
        -> Checked(1,source,next))
    -> Checked(1,source,begin) {
    first.and_then(λ left =>
        recognize_certified(times,0,source,left.end).fold(
            λ op => {
                let token = symbol_span(times,TStarSym,times_selected,source,left.end,op.end,op.value,op.evidence);
                let step = recognized_progress(times,source,left.end,op.end,op.value,op.evidence);
                let small = progress_after(source,begin,left.end,op.end,left.forward,step);
                product_finish(source,begin,left.end,op.end,nat::le_trans(begin.offset,left.end.offset,op.end.offset,left.forward,op.forward),
                    left.value,left.evidence,token,recur(op.end,small))
            },
            λ ignored => Ok(Certified(left.value,left.end,left.forward,
                factor_grammar(source,begin,left.end,left.value,left.evidence)))))
}
fn close_body(source: List<PTok>, begin: Cursor<PTok>(source),
    op: Certified<PTok,Nat>(source,begin,Recognized<PTok,Nat>(opening)),
    inner: Certified<PTok,Expr>(source,op.end,GrammarSpec(0))) -> Checked(2,source,begin) {
    recognize_certified(closing,2,source,inner.end).fold(
        λ close => Ok(Certified(inner.value,close.end,
                nat::le_trans(begin.offset,op.end.offset,close.end.offset,op.forward,
                    nat::le_trans(op.end.offset,inner.end.offset,close.end.offset,inner.forward,close.forward)),
                paren_grammar(source,begin,op.end,inner.end,close.end,inner.value,
                    symbol_span(opening,TOpen,opening_selected,source,begin,op.end,op.value,op.evidence),inner.evidence,
                    symbol_span(closing,TClose,closing_selected,source,inner.end,close.end,close.value,close.evidence)))),
        λ e => Err(commit_after(source,begin,op.end,commit_after(source,op.end,inner.end,e))))
}
fn open_body(source: List<PTok>, begin: Cursor<PTok>(source),
    op: Certified<PTok,Nat>(source,begin,Recognized<PTok,Nat>(opening)),
    recur: (next: Cursor<PTok>(source))
        -> nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))
        -> Checked(0,source,next))
    -> Checked(2,source,begin) {
    let step = recognized_progress(opening,source,begin,op.end,op.value,op.evidence);
    let small = drop_length_strict(source,begin.offset,op.end.offset,step,op.end.within);
    recur(op.end,small).fold(λ inner => close_body(source,begin,op,inner),
        λ e => Err(commit_after(source,begin,op.end,e)))
}
fn parentheses_body(source: List<PTok>, begin: Cursor<PTok>(source),
    recur: (next: Cursor<PTok>(source))
        -> nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))
        -> Checked(0,source,next))
    -> Checked(2,source,begin) {
    recognize_certified(opening,0,source,begin).and_then(λ op => open_body(source,begin,op,recur))
}
fn atom_body(source: List<PTok>, begin: Cursor<PTok>(source),
    recur: (next: Cursor<PTok>(source))
        -> nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))
        -> Checked(0,source,next))
    -> Checked(2,source,begin) {
    recognize_certified(number,0,source,begin).fold(
        λ n =>
            Ok(Certified(n.value,n.end,n.forward,number_grammar(source,begin,n.end,n.value,n.evidence))),
        λ number_error =>
            parentheses_body(source,begin,recur).map_err(λ e => merge_error(source,number_error,e)))
}
fn checked_expr(source: List<PTok>, begin: Cursor<PTok>(source)) -> Checked(0,source,begin)
    decreases list_len(rest(source,begin)) {
    expr_body(source,begin,checked_factor(source,begin),
        λ (next: Cursor<PTok>(source)) (smaller: nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))) => checked_expr(source,next) decreasing tail)
    on decreasing tail := smaller;
}
fn checked_factor(source: List<PTok>, begin: Cursor<PTok>(source)) -> Checked(1,source,begin)
    decreases list_len(rest(source,begin)) {
    factor_body(source,begin,checked_atom(source,begin),
        λ (next: Cursor<PTok>(source)) (smaller: nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))) => checked_factor(source,next) decreasing tail)
    on decreasing tail := smaller;
}
fn checked_atom(source: List<PTok>, begin: Cursor<PTok>(source)) -> Checked(2,source,begin)
    decreases list_len(rest(source,begin)) {
    atom_body(source,begin,
        λ (next: Cursor<PTok>(source)) (smaller: nat::Lt(list_len(rest(source,next)),list_len(rest(source,begin)))) => checked_expr(source,next) decreasing inner)
    on decreasing inner := smaller;
}
fn parse_expr(source: List<PTok>, begin: Cursor<PTok>(source)) -> Reply<PTok,Expr>(source,begin) {
    forget_at(source,begin,GrammarSpec(0),checked_expr(source,begin))
}
fn parse_factor(source: List<PTok>, begin: Cursor<PTok>(source)) -> Reply<PTok,Expr>(source,begin) {
    forget_at(source,begin,GrammarSpec(1),checked_factor(source,begin))
}
fn parse_atom(source: List<PTok>, begin: Cursor<PTok>(source)) -> Reply<PTok,Expr>(source,begin) {
    forget_at(source,begin,GrammarSpec(2),checked_atom(source,begin))
}
fn grammar() -> Parser<PTok,Expr> { Parser(λ source begin => parse_expr(source,begin)) }
fn grammar_sound() -> Sound<PTok,Expr>(grammar(),GrammarSpec(0)) {
    Sound(λ source begin => forget_post(source,begin,GrammarSpec(0),checked_expr(source,begin)))
}
fn factor_sound() -> Sound<PTok,Expr>(Parser(λ source begin => parse_factor(source,begin)),GrammarSpec(1)) {
    Sound(λ source begin => forget_post(source,begin,GrammarSpec(1),checked_factor(source,begin)))
}
fn atom_sound() -> Sound<PTok,Expr>(Parser(λ source begin => parse_atom(source,begin)),GrammarSpec(2)) {
    Sound(λ source begin => forget_post(source,begin,GrammarSpec(2),checked_atom(source,begin)))
}
theorem expression_sound(source: List<PTok>, begin: Cursor<PTok>(source), s: Success<PTok,Expr>(source,begin), shape: parse_expr(source,begin) = Ok(s)):
    Grammar(0,source,begin,s.end,s.value) {
    post_on_success(source,begin,GrammarSpec(0),parse_expr(source,begin),grammar_sound().law(source,begin),s,shape)
}
fn error_code(expected: List<Nat>) -> Nat { match expected { Nil => 0, Cons(code,_) => code } }
fn public_error(source: List<PTok>, error: ErrorView) -> ParseError {
    match error_code(error.expected) {
        Zero => match nat::le_dec(list_len(source),error.offset) { Inl(_) => UnexpectedEnd, Inr(_) => ExpectedAtom },
        Succ(k) => match k { Zero => UnexpectedEnd, Succ(j) => match j { Zero => BadParen, _ => Trailing } },
    }
}
record WholeGrammar(source: List<PTok>, value: Expr) {
    derivation: Derivation,
    valid: WellFormed(derivation),
    at_level: tier(derivation) = 0,
    yields: meaning(derivation) = value,
    tokens: spelling(derivation) = source,
}
fn whole_grammar(source: List<PTok>, end: Cursor<PTok>(source), value: Expr,
    proof: CompleteSpec<PTok,Expr>(GrammarSpec(0),source,start(source),end,value)) -> WholeGrammar(source,value) {
    let g = proof.left;
    WholeGrammar(g.derivation,g.valid,g.at_level,g.yields,
        sym(trans(sym(initial_rest(source)),trans(g.span,
            trans(j(proof.right,λ suffix q => spelling(g.derivation) ++ rest(source,end) = spelling(g.derivation) ++ suffix,refl),list::append_nil(spelling(g.derivation)))))))
}
fn public_reply(source: List<PTok>, r: Reply<PTok,Expr>(source,start(source))) -> Result<Expr,ParseError> {
    match r { Err(e) => Err(public_error(source,error_view(source,e))), Ok(s) => Ok(s.value) }
}
fn ParsedGrammar(source: List<PTok>, r: Result<Expr,ParseError>) -> Type {
    match r { Err(_) => True, Ok(value) => WholeGrammar(source,value) }
}
theorem public_reply_sound(source: List<PTok>, r: Reply<PTok,Expr>(source,start(source))):
    Post(source,start(source),CompleteSpec<PTok,Expr>(GrammarSpec(0)),r) -> ParsedGrammar(source,public_reply(source,r)) {
    match r { Err(_) => λ h => trivial, Ok(s) => λ h => whole_grammar(source,s.end,s.value,h) }
}
fn parse(ts: List<PTok>) -> Result<Expr,ParseError> {
    public_reply(ts,complete(grammar(),3).run(ts,start(ts)))
}
theorem parse_post(source: List<PTok>): ParsedGrammar(source,parse(source)) {
    public_reply_sound(source,complete(grammar(),3).run(source,start(source)),
        complete_sound(grammar(),3,GrammarSpec(0),grammar_sound()).law(source,start(source)))
}
theorem parse_sound(source: List<PTok>, value: Expr, success: parse(source) = Ok(value)):
    WholeGrammar(source,value) {
    j(success,λ result q => ParsedGrammar(source,result),parse_post(source))
}

fn evaluate_parsed(parsed: Result<Expr, ParseError>) -> Result<Nat, ParseError> {
    let e = parsed?;
    Ok(e.eval())
}

fn execute_parsed(parsed: Result<Expr, ParseError>) -> Result<Option<List<Nat>>, ParseError> {
    let e = parsed?;
    Ok(calc::run(compile(e), []))
}

fn calculate(ts: List<PTok>) -> Result<Nat, ParseError> { evaluate_parsed(parse(ts)) }
fn execute(ts: List<PTok>) -> Result<Option<List<Nat>>, ParseError> { execute_parsed(parse(ts)) }

// Prove agreement at an open parse result, then specialize to any token
// stream. This only assumes the compiler theorem, not parser unfolding laws.
theorem compile_result_correct(parsed: Result<Expr, ParseError>):
    execute_parsed(parsed) = evaluate_parsed(parsed).map(λ n => Some([n])) {
    match parsed {
        Err(_) => refl,
        Ok(e) => j(compile_correct(e),
            λ answer q => Ok<Option<List<Nat>>, ParseError>(calc::run(compile(e), [])) = Ok(answer), refl),
    }
}

theorem parsed_compile_correct(ts: List<PTok>):
    execute(ts) = calculate(ts).map(λ n => Some([n])) {
    compile_result_correct(parse(ts))
}

// AST equations pin precedence, right association, and parentheses directly.
theorem precedence():
    parse([TNum(2), TPlusSym, TNum(3), TStarSym, TNum(4)]) =
        Ok(Plus(Lit(2), Times(Lit(3), Lit(4)))) { refl }
theorem product_before_sum():
    parse([TNum(2), TStarSym, TNum(3), TPlusSym, TNum(4)]) =
        Ok(Plus(Times(Lit(2), Lit(3)), Lit(4))) { refl }
theorem sum_association():
    parse([TNum(1), TPlusSym, TNum(2), TPlusSym, TNum(3)]) =
        Ok(Plus(Lit(1), Plus(Lit(2), Lit(3)))) { refl }
theorem product_association():
    parse([TNum(1), TStarSym, TNum(2), TStarSym, TNum(3)]) =
        Ok(Times(Lit(1), Times(Lit(2), Lit(3)))) { refl }
theorem parentheses():
    parse([TOpen, TNum(2), TPlusSym, TNum(3), TClose, TStarSym, TNum(4)]) =
        Ok(Times(Plus(Lit(2), Lit(3)), Lit(4))) { refl }
theorem nested_parentheses(n: Nat):
    parse([TOpen, TOpen, TNum(n), TClose, TClose]) = Ok(Lit(n)) { refl }
theorem single_number(n: Nat): parse([TNum(n)]) = Ok(Lit(n)) { refl }

// The whole pipeline, with and without parentheses.
theorem evaluated(): calculate([TNum(2), TPlusSym, TNum(3), TStarSym, TNum(4)]) = Ok(14) { refl }
theorem executed(): execute([TNum(2), TPlusSym, TNum(3), TStarSym, TNum(4)]) = Ok(Some([14])) { refl }
theorem executed_parentheses():
    execute([TOpen, TNum(2), TPlusSym, TNum(3), TClose, TStarSym, TNum(4)]) = Ok(Some([20])) { refl }

// Malformed input is an error, including leftover input after a valid prefix.
theorem empty_input(): parse([]) = Err(UnexpectedEnd) { refl }
theorem missing_rhs(): parse([TNum(2), TPlusSym]) = Err(UnexpectedEnd) { refl }
theorem missing_product_rhs(): parse([TNum(2), TStarSym]) = Err(UnexpectedEnd) { refl }
theorem leading_operator(): parse([TPlusSym, TNum(2)]) = Err(ExpectedAtom) { refl }
theorem doubled_operator(): parse([TNum(2), TPlusSym, TStarSym, TNum(3)]) = Err(ExpectedAtom) { refl }
theorem empty_parentheses(): parse([TOpen, TClose]) = Err(ExpectedAtom) { refl }
theorem missing_close(): parse([TOpen, TNum(2)]) = Err(BadParen) { refl }
theorem wrong_close(): parse([TOpen, TNum(2), TNum(3)]) = Err(BadParen) { refl }
theorem extra_close(): parse([TNum(2), TClose]) = Err(Trailing) { refl }
theorem trailing_number(): parse([TNum(2), TNum(3)]) = Err(Trailing) { refl }
theorem first_error(): parse([TPlusSym, TOpen]) = Err(ExpectedAtom) { refl }
theorem execution_error(): execute([TOpen, TNum(2)]) = Err(BadParen) { refl }

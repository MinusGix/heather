+/// How many bits of a run one word holds, and what width is left over.
+/// `None` when the program cannot be taken apart that far; zero bits is
+/// `None` too, since there is no word to produce.
+fn word_split(program: &Rc<ContextProgram<()>>) -> Option<(u32, Option<Rc<ContextProgram<()>>>)> {
+    let cap = u64::from(BIT_RUN_WIDTH_CAP);
+    let (width, residual) = match ContextProgram::repetition_count_up_to(program, cap) {
+        Some(c) => (c as u32, None),
+        None => {
+            // Wider than one word: the design's §13 answer is a second run
+            // over the first's tail, so take a word's worth and leave the
+            // rest as the width of the fold at the tail.
+            let mut rest = Rc::clone(program);
+            for _ in 0..BIT_RUN_WIDTH_CAP {
+                let (_, next) = ContextProgram::uncons(&rest);
+                rest = next?;
+            }
+            (BIT_RUN_WIDTH_CAP, Some(rest))
+        }
+    };
+    (width > 0).then_some((width, residual))

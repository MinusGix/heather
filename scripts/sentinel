#!/usr/bin/env python3
"""The master sentinel: the full exact-policy suite on a fresh box, nightly.

docs/testing-architecture-design.md §2.1. A scheduled cloud session checks
out `master` on a fresh container and runs `scripts/sentinel run`. It is the
one place the exact image policy runs (round verification is
`scripts/test --pr`), and the one configuration nobody tests by hand: a cold
image store, a cold verdict store, a cold target directory.

    scripts/sentinel run          # suite, then publish (green) or bisect (red)
    scripts/sentinel seed DIR     # unpack the latest published image stores
    scripts/sentinel refresh      # publish this checkout's images, no suite
    scripts/sentinel audit [REV]  # the early cutoff's audit from REV's library

`run` writes target/sentinel/report.md and exits 0 green, 1 red, 2 when the
suite was INCOMPLETE (a binary died; the bisect still runs on what failed).

Green: the image stores this run built are published as one commit on the
orphan branch `claude/sentinel-images` (`images.tgz`, in parts under
GitHub's file limit, + `manifest.json`: the commit, the date, the suite
line, per-target CPU). A fresh session seeds its
stores from it (scripts/session-start); replay rechecks every image with the
reader's kernel, so a seeded image can only ever be a miss, never a wrong
answer. The suite's verdict store (target/decl-cache) is not published: a
vouched verdict skips the kernel. The report lists targets whose CPU grew
past the last green run's.

Only the images the run used are published (`live_files`): a store keeps
every image of every earlier tree until its budget is spent
(`ModuleImageCache::sweep`), and a seed that carries them is ten times the
size of the library's images and no more use to a fresh box.

`refresh` publishes the same stores from a checkout whose tree is master's,
without running anything: for a session that has just run a lane over
master (a round that merged), so that the seed follows master through the
day and not only at night. A fresh box whose seed is behind master pays
again for every module master changed since, and for every module those
changes keep from being moved (issues/sentinel-seed-follows-master.md). The
manifest keeps the last green run's commit, suite line and CPU table, which
`run` bisects and compares from; `images_commit` and `images_date` say what
the images are of. It does nothing while the published images are younger
than REFRESH_MIN_AGE_H hours (`--force` publishes anyway), and `--dry-run`
builds the archive and reports its size without pushing.

Either way, the library is checked once at the last green run's commit and
once here, by this commit's compiler and into one image store, with the
relocation audit on (docs/module-interface-cutoff-design.md §5): every
module the stale lanes would have moved onto the new world rather than
elaborated is moved and compared with its elaboration. A `diverged` module is
one the early cutoff let through wrongly; the report names it.

Red: the failing targets are bisected over the first-parent merges since the
last green run, rerunning only those targets at each step, and the report
names the first merge at which each fails.
"""

import calendar
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "target" / "sentinel"
BRANCH = "claude/sentinel-images"
STORES = ["semantic-test-images", "native-test-images", "cli-check-images"]
# Where the suite keeps those stores: target/, or $HEATHER_CACHE_DIR when it is
# set (heather_cache::store_root; a relative value is taken from the root).
STORE_ROOT = ROOT / (os.environ.get("HEATHER_CACHE_DIR") or "target")
# A target is reported as grown when its CPU rose by this factor and by at
# least this many seconds over the last green run's.
GROWTH_FACTOR = 1.25
GROWTH_FLOOR_S = 10.0
# GitHub refuses a pushed file over 100 MB, and the compressed stores passed
# 89 MB by 2026-10-26, so the archive is published in parts below that
# (`images.tgz.000`, `.001`, …) and seed() joins them.
PART_BYTES = 90 * 1000 * 1000
# `refresh` leaves published images younger than this alone: each publish is
# an orphan commit of the whole archive, and the host keeps what a force-push
# drops for a while.
REFRESH_MIN_AGE_H = 3
# The images a `refresh` keeps when the manifest does not say since when the
# published ones were live (a seed published before `since` was recorded).
REFRESH_WINDOW_H = 36


def git(*args, check=True, capture=True):
    r = subprocess.run(["git", *args], cwd=ROOT, check=check,
                       stdout=subprocess.PIPE if capture else None, text=True)
    return r.stdout.strip() if capture else ""


def run_suite(args, log):
    """`scripts/test` with `args`, teed to `log`; returns (exit, output)."""
    with open(log, "w") as f:
        p = subprocess.Popen([str(ROOT / "scripts" / "test"), *args], cwd=ROOT,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        lines = []
        for line in p.stdout:
            f.write(line)
            lines.append(line)
        return p.wait(), "".join(lines)


DONE = re.compile(r"^\[done\s+\d+/\d+\] (.+?): (PASS|FAIL|INCOMPLETE)\b", re.M)
SUITE = re.compile(r"^== suite: .*==$", re.M)


def failing_targets(output):
    return sorted({m.group(1) for m in DONE.finditer(output) if m.group(2) != "PASS"})


def suite_line(output):
    m = list(SUITE.finditer(output))
    return m[-1].group(0) if m else "== suite: no summary line =="


def processes_near_rail(output):
    """The runner's `== processes past …` section: one row per process that
    came near its own CPU rail (scripts/run-test-targets.mjs), the margin a
    target's summed CPU cannot show."""
    lines = output.split("\n")
    for i, line in enumerate(lines):
        if line.startswith("== processes past "):
            rows = []
            for row in lines[i + 1:]:
                if not row.strip() or row.startswith("=="):
                    break
                rows.append(row.strip())
            return line, rows
    return None, []


def target_cpu():
    """Per-target CPU-s from the newest run in the full lane's history."""
    path = ROOT / "target" / "test-target-timings-full.tsv"
    if not path.exists():
        return {}
    rows = [l.rstrip("\n").split("\t") for l in path.open() if l.strip()]
    rows = [r for r in rows if len(r) >= 4]
    if not rows:
        return {}
    newest = max(r[0] for r in rows)
    return {r[2]: float(r[3]) for r in rows if r[0] == newest}


def package_of(crate_dir):
    for line in (ROOT / crate_dir / "Cargo.toml").read_text().splitlines():
        m = re.match(r'\s*name\s*=\s*"([^"]+)"', line)
        if m:
            return m.group(1)
    raise SystemExit(f"sentinel: no package name in {crate_dir}/Cargo.toml")


def target_args(label):
    """`scripts/test` arguments that run one runner target alone.

    Labels are the runner's: `crates/<c>/tests/<t>.rs` for an integration
    target (an elab family member included: scripts/test maps the member
    file to its family), `<package> (<path>/src/lib.rs|main.rs)` for unit
    tests (the runner strips a `-lib` suffix from the package)."""
    m = re.fullmatch(r"crates/([^/]+)/tests/([^/]+)\.rs", label)
    if m:
        return ["-p", package_of(f"crates/{m.group(1)}"), "--test", m.group(2)]
    m = re.fullmatch(r"(\S+) \((crates/[^/]+)/src/(lib|main)\.rs\)", label)
    if m:
        packages = {package_of(d.relative_to(ROOT)) for d in (ROOT / "crates").iterdir()
                    if (d / "Cargo.toml").exists()}
        package = m.group(1)
        if f"{package}-lib" in packages:
            package = f"{package}-lib"
        return ["-p", package, "--lib" if m.group(3) == "lib" else "--bins"]
    raise SystemExit(f"sentinel: cannot rerun target label {label!r}")


def fetch_manifest():
    """The last green run's manifest, or None when there is none."""
    if subprocess.run(["git", "fetch", "--quiet", "--depth=1", "origin", BRANCH], cwd=ROOT,
                      stderr=subprocess.DEVNULL).returncode != 0:
        return None
    r = subprocess.run(["git", "show", "FETCH_HEAD:manifest.json"], cwd=ROOT,
                       stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    return json.loads(r.stdout) if r.returncode == 0 else None


def live_files(store, since):
    """The files of `store` (a directory of STORE_ROOT) worth seeding a box
    with, as paths relative to STORE_ROOT: every image read or written at or
    after `since` (reading an image renews its modification time,
    `ModuleImageCache::load`), the pointers that name one of those (a
    `.latest` or `.src` file holds the 32-byte key of an image), and the
    store's other files as they are. Lock files are made on demand."""
    root = STORE_ROOT / store
    kept, pointers, rest = set(), [], []
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        if path.suffix == ".hmi":
            if path.stat().st_mtime >= since:
                kept.add((path.parent, path.stem))
                rest.append(path)
        elif path.suffix in (".latest", ".src"):
            pointers.append(path)
        elif path.suffix != ".lock":
            rest.append(path)
    for path in pointers:
        key = path.read_bytes()
        if len(key) == 32 and (path.parent, key.hex()) in kept:
            rest.append(path)
    return [p.relative_to(STORE_ROOT) for p in sorted(rest)]


def write_archive(tmp, since):
    """`images.tgz` in `tmp`, of every store's live files; returns how many
    images it holds."""
    images = 0
    with tarfile.open(tmp / "images.tgz", "w:gz", compresslevel=6) as tar:
        for store in STORES:
            if (STORE_ROOT / store).is_dir():
                for rel in live_files(store, since):
                    images += rel.suffix == ".hmi"
                    tar.add(STORE_ROOT / rel, arcname=str(rel))
    return images


def publish(manifest, since):
    """One orphan commit holding the image stores' files live since `since`
    and `manifest`, force-pushed."""
    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        write_archive(tmp, since)
        manifest = dict(manifest, since=int(since))
        head, line = manifest["images_commit"], manifest["suite"]
        (tmp / "manifest.json").write_text(json.dumps(manifest, indent=1, sort_keys=True) + "\n")
        names = ["manifest.json"]
        with open(tmp / "images.tgz", "rb") as archive:
            while part := archive.read(PART_BYTES):
                names.append(f"images.tgz.{len(names) - 1:03d}")
                (tmp / names[-1]).write_bytes(part)
        env = dict(os.environ, GIT_INDEX_FILE=str(tmp / "index"))
        def g(*args, **kw):
            return subprocess.run(["git", *args], cwd=ROOT, env=env, check=True,
                                  stdout=subprocess.PIPE, text=True, **kw).stdout.strip()
        blobs = [(name, g("hash-object", "-w", str(tmp / name))) for name in names]
        for name, blob in blobs:
            g("update-index", "--add", "--cacheinfo", f"100644,{blob},{name}")
        tree = g("write-tree")
        commit = g("commit-tree", tree, "-m", f"sentinel images for {head[:12]}\n\n{line}")
        for delay in (0, 2, 4, 8, 16):
            time.sleep(delay)
            if subprocess.run(["git", "push", "--force", "origin", f"{commit}:refs/heads/{BRANCH}"],
                              cwd=ROOT).returncode == 0:
                return True
        return False


def image_headers(store_root):
    """(cache key) -> (producing build, interface hash) for every image under
    `store_root`, read from the header crates/cache/src/module_image.rs
    writes: magic, key, semantics, interface hash, each 32 bytes after the
    8-byte magic."""
    out = {}
    for path in Path(store_root).glob("*/modules-v1/*.hmi"):
        head = path.open("rb").read(104)
        if len(head) == 104 and head[:7] == b"HTHCACH":
            out[head[8:40]] = (head[40:72], head[72:104])
    return out


def drifted(before, after):
    """Images rebuilt by a different build of the compiler whose interface
    changed: the same source and dependencies, elaborated differently. These
    are what a stale-image lane (`scripts/test --pr`) was replaying the older
    elaboration of until this run."""
    return sorted(k.hex()[:12] for k, (build, iface) in after.items()
                  if k in before and before[k][0] != build and before[k][1] != iface)


def grown(previous, cpu):
    out = []
    for label, now in sorted(cpu.items()):
        before = previous.get(label)
        if before and now >= before * GROWTH_FACTOR and now - before >= GROWTH_FLOOR_S:
            out.append((label, before, now))
    return out


def bisect(failing, last_green, head):
    """First first-parent merge after `last_green` at which each target fails."""
    # Cloud checkouts are shallow; the bisect needs the merges in between.
    subprocess.run(["git", "fetch", "--quiet", "--unshallow", "origin"], cwd=ROOT, stderr=subprocess.DEVNULL)
    merges = git("rev-list", "--first-parent", "--reverse", f"{last_green}..{head}").split()
    blame = {}
    for label in failing:
        lo, hi = 0, len(merges) - 1  # merges[hi] fails (it is head); find the first
        while lo < hi:
            mid = (lo + hi) // 2
            git("checkout", "--quiet", "--detach", merges[mid])
            code, _ = run_suite(target_args(label), OUT / f"bisect-{merges[mid][:12]}.log")
            if code == 0:
                lo = mid + 1
            else:
                hi = mid
        blame[label] = merges[lo]
    git("checkout", "--quiet", "--detach", head)
    return blame


AUDIT_VERDICTS = ("same", "same-interface", "refused", "diverged")


def relocation_audit(base):
    """Check `lib/std` as of commit `base`, then as of the working tree, into
    one fresh image store with the relocation audit on; returns the verdict
    counts and the diverged modules, or None when a check failed. The second
    check runs the exact policy: each module is elaborated, and the audit
    also moves the first check's image of the same source onto the new
    world, when the cutoff lets it, and compares the two."""
    work = OUT / "relocation-audit"
    shutil.rmtree(work, ignore_errors=True)
    (work / "old").mkdir(parents=True)
    archive = subprocess.run(["git", "archive", base, "lib"], cwd=ROOT, stdout=subprocess.PIPE)
    if archive.returncode != 0:
        return None
    with tarfile.open(fileobj=io.BytesIO(archive.stdout)) as tar:
        tar.extractall(work / "old")
    if subprocess.run(["cargo", "build", "--quiet", "--release", "-p", "heather-cli"], cwd=ROOT).returncode != 0:
        return None
    audit = work / "audit.tsv"
    # Capped like every heather run (CLAUDE.md); the CPU rail counts all
    # eight kernel workers.
    def check(lib, env):
        cmd = (f"ulimit -v 8388608 -t 7200 -c 0; exec target/release/heather check --cache "
               f"--cache-dir {work / 'images'} {lib}")
        with open(work / "check.log", "a") as log:
            return subprocess.run(["bash", "-c", cmd], cwd=ROOT, env=env, stdout=log,
                                  stderr=subprocess.STDOUT).returncode == 0
    env = {k: v for k, v in os.environ.items() if k != "HEATHER_RELOCATION_AUDIT"}
    if not check(work / "old" / "lib" / "std", env):
        return None
    if not check(ROOT / "lib" / "std", dict(env, HEATHER_RELOCATION_AUDIT=str(audit))):
        return None
    counts = {v: 0 for v in AUDIT_VERDICTS}
    diverged = []
    for line in audit.read_text().splitlines() if audit.exists() else []:
        module, verdict, _ = (line.split("\t") + ["", ""])[:3]
        counts[verdict] = counts.get(verdict, 0) + 1
        if verdict == "diverged":
            diverged.append(module)
    return counts, diverged


def audit_report(base):
    result = relocation_audit(base)
    if result is None:
        return [f"Relocation audit from {base[:12]}: a library check failed (`target/sentinel/relocation-audit/check.log`)."]
    counts, diverged = result
    line = (f"Relocation audit from {base[:12]}: "
            + ", ".join(f"{counts[v]} {v}" for v in AUDIT_VERDICTS) + ".")
    if diverged:
        line += (f" **The early cutoff moved {len(diverged)} module(s) its elaboration does not reproduce:** "
                 + ", ".join(f"`{m}`" for m in diverged)
                 + ". The stale lanes replay a wrong world for these; see `target/sentinel/relocation-audit/audit.tsv`.")
    return [line]


def run():
    OUT.mkdir(parents=True, exist_ok=True)
    head = git("rev-parse", "HEAD")
    previous = fetch_manifest()
    # The previous green run's images, unpacked aside, to compare with what
    # this run's exact policy rebuilds (`drifted`).
    before = {}
    if previous is not None:
        aside = OUT / "previous-images"
        shutil.rmtree(aside, ignore_errors=True)
        if seed(aside, fetched=True) == 0:
            before = image_headers(aside)
    started = time.time()
    code, output = run_suite([], OUT / "suite.log")
    line = suite_line(output)
    cpu = target_cpu()
    failing = failing_targets(output)
    report = [f"# Sentinel {time.strftime('%Y-%m-%d', time.gmtime())} at {head[:12]}", "",
              f"`{line}` in {int(time.time() - started)} s (fresh box, exact images).", ""]
    if code == 0 and not failing:
        now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        # The suite read or wrote every image it needs after `started`; a
        # minute of slack for a clock that steps.
        ok = publish({"commit": head, "date": now, "suite": line, "target_cpu": cpu,
                      "images_commit": head, "images_date": now}, started - 60)
        report.append("Green. Image stores published to `claude/sentinel-images`." if ok
                      else "Green, but publishing the image stores failed (see the session log).")
        changed = drifted(before, image_headers(STORE_ROOT))
        if before:
            report += ["", f"Library images whose elaboration changed since the last green run: {len(changed)}"
                       + (f" ({', '.join(changed[:20])}{', …' if len(changed) > 20 else ''})." if changed else ".")
                       + " A stale-image lane replayed the older elaboration of these until now."]
        growth = grown((previous or {}).get("target_cpu", {}), cpu)
        if growth:
            report += ["", f"Targets whose CPU grew since {previous['commit'][:12]}:", "",
                       "| target | CPU-s before | now |", "|---|---|---|"]
            report += [f"| `{l}` | {b:.1f} | {n:.1f} |" for l, b, n in growth]
        status = 0
    else:
        status = 2 if "INCOMPLETE" in line else 1
        report += ["Red. Failing targets:", ""] + [f"- `{t}`" for t in failing]
        ancestor = previous is not None and subprocess.run(
            ["git", "merge-base", "--is-ancestor", previous["commit"], head], cwd=ROOT).returncode == 0
        if ancestor and failing:
            blame = bisect(failing, previous["commit"], head)
            report += ["", f"First failing merge since the last green run ({previous['commit'][:12]}):", ""]
            for label, commit in blame.items():
                report.append(f"- `{label}`: {git('log', '-1', '--format=%h %s', commit)}")
        elif previous is not None:
            report += ["", f"The last green run ({previous['commit'][:12]}) is not an ancestor of this commit; no bisect."]
        else:
            report += ["", "No earlier green run on record; no bisect."]
    heading, near = processes_near_rail(output)
    if near:
        report += ["", heading.strip("= ") + ":", ""] + [f"- `{row}`" for row in near]
        if any(f" {t}: " in f" {row}" for t in failing for row in near):
            # A process killed at its rail over a cold store leaves the images
            # it finished behind, so the bisect's next probe of the same
            # library replays them and passes: the first merge probed takes
            # the blame (issues/master-red-2026-11-06.md).
            report += ["", "A failing target with a process at its rail bisects to whichever merge was probed first "
                       "over a cold store; check that the blamed merge can reach the target before trusting it."]
    if previous is not None:
        report += [""] + audit_report(previous["commit"])
    (OUT / "report.md").write_text("\n".join(report) + "\n")
    print("\n".join(report))
    return status


def seed(dest, fetched=False):
    """Unpack the published stores into `dest` (normally target/) for any
    store not already there; staged beside it and renamed into place, so a
    test that starts meanwhile sees a whole store or none. `fetched`: the
    branch is already at FETCH_HEAD."""
    dest = Path(dest)
    if all((dest / s).exists() for s in STORES):
        return 0
    if not fetched and subprocess.run(["git", "fetch", "--quiet", "--depth=1", "origin", BRANCH],
                                      cwd=ROOT, stderr=subprocess.DEVNULL).returncode != 0:
        return 1
    # One `images.tgz`, or (since the stores outgrew GitHub's file limit) its
    # parts `images.tgz.NNN` in order.
    listed = subprocess.run(["git", "ls-tree", "--name-only", "FETCH_HEAD"], cwd=ROOT,
                            stdout=subprocess.PIPE, text=True)
    if listed.returncode != 0:
        return 1
    parts = sorted(n for n in listed.stdout.split() if re.fullmatch(r"images\.tgz(\.\d{3})?", n))
    if not parts:
        return 1
    dest.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=".sentinel-seed-", dir=dest))
    try:
        archive = stage / "images.tgz"
        with open(archive, "wb") as out:
            for part in parts:
                blob = subprocess.run(["git", "show", f"FETCH_HEAD:{part}"], cwd=ROOT, stdout=subprocess.PIPE)
                if blob.returncode != 0:
                    return 1
                out.write(blob.stdout)
        with tarfile.open(archive) as tar:
            tar.extractall(stage, filter="data")
        for store in STORES:
            if (stage / store).is_dir() and not (dest / store).exists():
                os.rename(stage / store, dest / store)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    return 0


def seconds(stamp):
    """A manifest date as seconds since the epoch."""
    return calendar.timegm(time.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ"))


def refresh(force=False, dry_run=False):
    """Publish this checkout's image stores under the last green run's
    manifest. 0 published (or nothing to do), 1 refused or failed."""
    previous = fetch_manifest()
    if previous is None:
        print("sentinel refresh: no green run on record to refresh", file=sys.stderr)
        return 1
    if subprocess.run(["git", "fetch", "--quiet", "origin", "master"], cwd=ROOT).returncode != 0:
        print("sentinel refresh: cannot fetch master", file=sys.stderr)
        return 1
    # The images are of this tree. A merged round's branch has master's tree
    # without being master's commit, so the trees are compared; uncommitted
    # edits to tracked files make it another tree.
    if subprocess.run(["git", "diff", "--quiet", "FETCH_HEAD", "--"], cwd=ROOT).returncode != 0:
        print("sentinel refresh: this checkout is not master's tree; a seed follows master", file=sys.stderr)
        return 1
    master = git("rev-parse", "FETCH_HEAD")
    published = previous.get("images_date", previous["date"])
    age_h = (time.time() - seconds(published)) / 3600
    if previous.get("images_commit", previous["commit"]) == master:
        print(f"sentinel refresh: the published images are already of {master[:12]}")
        return 0
    if age_h < REFRESH_MIN_AGE_H and not force and not dry_run:
        print(f"sentinel refresh: the published images are {age_h:.1f} h old (under {REFRESH_MIN_AGE_H}); left alone")
        return 0
    # What the last run published as live stays, with what this checkout
    # read or built since: a lane that ran only the tests its diff could
    # affect renewed only their images.
    since = previous.get("since", time.time() - REFRESH_WINDOW_H * 3600)
    manifest = dict(previous, images_commit=master,
                    images_date=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    if dry_run:
        with tempfile.TemporaryDirectory() as tmp:
            images = write_archive(Path(tmp), since)
            size = (Path(tmp) / "images.tgz").stat().st_size
        print(f"sentinel refresh: would publish {images} images of {master[:12]}, {size / 1e6:.0f} MB "
              f"(published: {published}, {age_h:.1f} h old)")
        return 0
    if not publish(manifest, since):
        print("sentinel refresh: publishing failed", file=sys.stderr)
        return 1
    print(f"sentinel refresh: images of {master[:12]} published to `{BRANCH}`")
    return 0


def main(argv):
    if argv[:1] == ["run"]:
        return run()
    if argv[:1] == ["refresh"] and set(argv[1:]) <= {"--force", "--dry-run"}:
        return refresh(force="--force" in argv, dry_run="--dry-run" in argv)
    if argv[:1] == ["seed"] and len(argv) == 2:
        return seed(argv[1])
    if argv[:1] == ["audit"] and len(argv) <= 2:
        base = argv[1] if len(argv) == 2 else (fetch_manifest() or {}).get("commit")
        if base is None:
            print("sentinel: no green run on record; name a commit", file=sys.stderr)
            return 64
        OUT.mkdir(parents=True, exist_ok=True)
        lines = audit_report(git("rev-parse", base))
        print("\n".join(lines))
        return 1 if "**" in lines[0] else 0
    print(__doc__, file=sys.stderr)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env bash
# Run the test suite under hard resource limits.
#
# ALWAYS use this instead of bare `cargo test`. Kernel terms are recursive
# structures; a buggy generator or an accidental Debug-format of a large term
# can consume unbounded memory, and an unbounded test process OOMs the whole
# machine (it has happened). Under these limits the test process dies alone.
#
# Usage: scripts/test [--fast|--pr|--long] [cargo-test args...]
#
# --fast replays semantic test images written by other builds of the
# compiler (HEATHER_SEMANTIC_IMAGES=accept-stale; see tests/support) so a
# Rust edit does not cold-rebuild every library prefix, and skips the two
# whole-library acceptance tests that dominate wall
# time (issues/suite-wall-time-two-tests.md) and the four perturbed-library
# mutation controls (issues/certgen-harness-cost.md, the 2026-08-12 lever:
# each control elaborates a `match code` shell, and their whole content is
# kernel-refusal of mutants — acceptance-class, nothing an inner loop
# iterates on) and the native x86 certificate gates (crates/cli/tests/native*.rs
# and their prefix warmup; issues/native-summary-test-cpu-margin.md, ~1200
# CPU-s that no elaborator edit iterates on) — the inner loop
# while iterating. The fast lane also disables
# Cargo's cross-target fail-fast, so a red run shows every failing test
# binary while the expensive acceptance tests stay skipped.
# --pr runs every test, like the plain lane, but replays semantic images
# other builds of the compiler wrote, like --fast (kernel-rechecked or
# vouched for by target/decl-cache). It is a round's final verification:
# what it leaves out is the exact policy's check that the *current* frontend
# still elaborates unchanged library modules identically, which the nightly
# master sentinel runs instead (docs/testing-architecture-design.md §2.1).
# After an elab edit that check is most of the extra cost: every library
# module re-elaborated.
# --long additionally runs every slow kernel self-check on every occasion
# (crates/kernel/src/checks.rs) in its own target directory; not a gate,
# a sweep to run when the kernel's traversals or bounds memo changed.
# default runs everything under the exact image policy: the nightly master
# sentinel's lane, and a round's final verification when the round changes
# the semantic image format, the caches or the loader (crates/cache,
# crates/cli/src/semantic.rs), whose writer a stale replay would not test.
# Stable exhaustive matrices may opt into that lane by naming the test
# `slow_acceptance_*`; `--fast` filters that prefix while retaining the
# target's explicitly chosen load-bearing smoke and refusal cases.
set -euo pipefail
cd "$(dirname "$0")/.."

# Cheap and dependency-free: fail the ordinary CI entrypoint when Heather's
# compiler keywords or fixed symbols drift away from the editor manifest.
suite_started=$SECONDS
node scripts/check-tree-sitter-inventory.js
# crates/elab declares its test targets instead of discovering them (family
# binaries mount their member files by path), so check no file fell out.
node scripts/check-elab-test-families.mjs
node --test scripts/test-target-runner.test.mjs

# The kernel's `value-metrics` feature is off in every test target — it is the
# diagnostic build (`--timings`' value counters, the conv-miss sampler, the
# `diag_enter` frames), so nothing the suite runs compiles it. That means it
# can rot silently, and it did: it did not build at 9c16741 and no test
# noticed. A `cargo check` of that one feature is seconds and closes the hole.
# A *check*, not tests: the feature changes instrumentation, not judgments.
cargo check --quiet -p heather-kernel-lib --features value-metrics

SKIP=()
TEST_ARGS=()
CARGO_FLAGS=()
TEST_LANE=full
HAS_LIBTEST_SEPARATOR=false
if [[ "${1:-}" == --fast ]]; then
  shift
  TEST_LANE=fast
  TEST_ARGS=(--no-fail-fast)
  # The fast lane replays semantic test images an earlier build of the
  # compiler wrote instead of rebuilding every library prefix after each
  # Rust edit (tests/support's semantic_test_base reads this). Replay still
  # kernel-checks every binding; what this lane does not verify is that the
  # *current* frontend elaborates unchanged library modules identically —
  # the exact policy does, which the master sentinel runs nightly; a round's
  # final verification is `--pr`, which runs everything this lane skips.
  export HEATHER_SEMANTIC_IMAGES=accept-stale
  echo "fast lane: semantic test images from other builds are replayed (kernel-rechecked, or vouched for by target/decl-cache); the full lane rebuilds them"
  # By exact test-fn name; `cargo test -- --skip` applies the filter in
  # every test binary, where these names are unique. If the caller already
  # passed a `--`, don't add a second one.
  SKIP=(--skip the_full_ir_library_checks --skip slow_acceptance_
        # The native x86 certificate gates (crates/cli/tests/native*.rs):
        # each spawns a whole `compile-x86` and kernel-checks the generated
        # certificate, which an elaborator or kernel edit's inner loop
        # cannot iterate on. Acceptance-class; the full lane runs them.
        --skip source_nested_conditionals_execute
        --skip a_call_of_a_deciding_function_is_refused
        --skip programs_with_calls_execute
        --skip source_to_native_binary)
elif [[ "${1:-}" == --pr ]]; then
  shift
  TEST_LANE=pr
  export HEATHER_SEMANTIC_IMAGES=accept-stale
  echo "pr lane: every test runs; semantic images from other builds are replayed (kernel-rechecked, or vouched for by target/decl-cache); the master sentinel runs the exact policy"
elif [[ "${1:-}" == --long ]]; then
  shift
  TEST_LANE=long
  # Every slow kernel self-check on every occasion (crates/kernel/src/checks.rs;
  # the default samples one bounds-skip verification in sixteen). Builds in
  # its own target directory so switching lanes does not rebuild the
  # workspace twice.
  CARGO_FLAGS=(--features heather-kernel/long-checks)
  export CARGO_TARGET_DIR=target/long
  echo "long lane: every kernel self-check runs on every occasion (target/long)"
fi

# `--test <file>` keeps meaning that file's tests when the file is a member of
# an elab family binary (docs/elab-test-families-design.md §D4): the helper
# rewrites it to `--test <family>` with a `<file>::` filter, or `<file>::<name>`
# when a filter was given. The warm-up choice below reads the args as the
# caller wrote them.
requested=" $* "
# Named directly, a family is one process under one rail: allowed, and a
# rail kill reads INCOMPLETE rather than red. Per-file rails are what the
# member spelling or the plain suite (which shards families by file) give.
if [[ "$requested" =~ (--test[=\ ]family_[a-z0-9_]+) ]]; then
  echo "${BASH_REMATCH[1]}: the family runs as one process under one rail; \`--test <file>\` or the plain suite runs each member file under its own"
fi
if (( $# > 0 )); then
  rewritten_args=$(mktemp)
  node scripts/check-elab-test-families.mjs --rewrite-args -- "$@" > "$rewritten_args" || exit 2
  mapfile -d '' rewritten < "$rewritten_args"
  rm -f "$rewritten_args"
  set -- "${rewritten[@]}"
fi
for a in "$@"; do
  if [[ "$a" == -- ]]; then
    HAS_LIBTEST_SEPARATOR=true
    break
  fi
done

# Keep libtest's compact dot output while leaving Cargo itself non-quiet: the
# latter is what prints `Running tests/foo.rs`, which the timing table needs.
# Respect a caller-supplied `--`; otherwise introduce the separator here.
LIBTEST_ARGS=(--format terse "${SKIP[@]}")
if ! $HAS_LIBTEST_SEPARATOR; then
  LIBTEST_ARGS=(-- "${LIBTEST_ARGS[@]}")
fi

# A fresh cloud container starts from the image stores the last green master
# sentinel published (scripts/sentinel seed; docs/testing-architecture-design.md
# §3.1.2), so its first suite replays library modules instead of elaborating
# them all cold. Seconds, once; skipped when the stores exist or off-cloud.
# Replay rechecks every image, so a seeded one can only be a miss. Never the
# verdict store. HEATHER_NO_SEED=1 skips it.
if [[ "${CLAUDE_CODE_REMOTE:-}" == true && -z "${HEATHER_NO_SEED:-}" &&
      ! -e target/semantic-test-images ]]; then
  timeout 300 scripts/sentinel seed target && echo "seeded image stores from the master sentinel"
fi

# Compile without limits (rustc is memory-hungry but trusted)...
compile_started=$SECONDS
manifest=$(mktemp)
cargo test --workspace "${CARGO_FLAGS[@]}" --no-run --quiet --message-format=json > "$manifest"
compile_seconds=$((SECONDS - compile_started))

# Expensive acceptance targets consume a semantic library prefix and then a
# large freshly checked suffix. On a cold or invalidated cache each half fits
# the per-process CPU rail, while their sum may not. Populate/replay the shared
# prefix first in its own bounded process so whichever shard Cargo schedules
# first cannot inherit both budgets. Focused invocations get only the warmup
# they need; an unfiltered suite prepares both families before parallel target
# scheduling. The warmup itself uses safe semantic replay — never the trusted
# declaration gate — and stale images rebuild from source.
semantic_warmup() {
  local target=$1
  shift
  (
    ulimit -v 6291456
    ulimit -t 300
    RUST_MIN_STACK=8388608 RUST_TEST_THREADS=1 \
      cargo test "${CARGO_FLAGS[@]}" -p heather-elab --test "$target" -- --format terse "$@"
  )
}

# One test of the heather binary's native module, alone in a bounded process.
native_bin_warmup() {
  (
    ulimit -v 6291456
    ulimit -t 300
    RUST_MIN_STACK=8388608 RUST_TEST_THREADS=1 \
      cargo test "${CARGO_FLAGS[@]}" -p heather-cli --bin heather "native::tests::$1" -- --exact --format terse
  )
}

native_warmup() {
  # Native certificates use a separate SemanticSession cache. Populate its
  # exact-build prefix before a child spends its budget on the generated
  # certificate; replay still kernel-checks every cached declaration.
  native_bin_warmup the_bundled_library_checks
}

if (( $# == 0 )); then
  semantic_warmup semantic_x86_warmup
  semantic_warmup semantic_omega_warmup
  # The fast lane skips every native certificate gate, so it has no prefix
  # to warm; the warmup alone is ~150 CPU-s.
  if [[ "$TEST_LANE" != fast ]]; then
    native_warmup
  fi
else
  if [[ "$requested" == *"--test native"* ]]; then
    native_warmup
  fi
  whole_elab=false
  if { [[ "$requested" == *" -p heather-elab "* ]] ||
       [[ "$requested" == *" --package heather-elab "* ]]; } &&
     [[ "$requested" != *" --test "* ]]; then
    whole_elab=true
  fi
  # Every target that replays a prefix of the x86 list through
  # `support::semantic_test_base` (the bitvec kit reads its first nine
  # modules; the function_ir_x86 family extends it) shares that store.
  if $whole_elab || [[ "$requested" == *"--test x86_64"* ]] ||
     [[ "$requested" == *"--test lib_std_bitvec"* ]] ||
     [[ "$requested" == *"--test function_ir_x86"* ]] ||
     [[ "$requested" =~ --test[=\ ]family_(library|function_ir|x86)\  ]]; then
    semantic_warmup semantic_x86_warmup
  fi
  # `--test omega` also matches every `omega_*` target, including
  # `omega_measure_reduction`; the `decreases` family replays the same list.
  if $whole_elab || [[ "$requested" == *"--test omega"* ]] ||
     [[ "$requested" == *"--test omega_logic"* ]] ||
     [[ "$requested" == *"--test omega_reconstruction"* ]] ||
     [[ "$requested" == *"--test omega_div_mod_scaling"* ]] ||
     [[ "$requested" == *"--test mutual_recursion"* ]] ||
     [[ "$requested" == *"--test termination_measures"* ]] ||
     [[ "$requested" == *"--test decreases_unfolding"* ]] ||
     [[ "$requested" =~ --test[=\ ]family_omega\  ]]; then
    semantic_warmup semantic_omega_warmup
  fi
fi

# An unfiltered workspace run has no Cargo selection semantics left to
# preserve, so run its independent binaries in bounded parallel. Focused
# invocations retain Cargo's native serial path below. By default the runner
# chooses the smaller of a CPU bound (two-thread slots minus one on eight or
# more CPUs, three children per four CPUs below that; `jobBounds` in
# run-test-targets.mjs says why) and the number of children a 3 GiB working-set
# budget each fits in MemAvailable while leaving 2 GiB for the host (the
# address-space cap is 6 GiB; LIMIT_KIB/BUDGET_KIB in run-test-targets.mjs).
# HEATHER_TEST_JOBS
# can lower or request a higher count; both safety caps remain authoritative.
if (( $# == 0 )); then
  mkdir -p target
  test_started=$SECONDS
  set +e
  runner_args=(--manifest "$manifest" --timings "target/test-target-timings-${TEST_LANE}.tsv"
               --jobs "${HEATHER_TEST_JOBS:-auto}" --keep-going)
  node scripts/run-test-targets.mjs "${runner_args[@]}" -- "${LIBTEST_ARGS[@]:1}"
  status=$?
  set -e
  rm -f "$manifest"
  test_seconds=$((SECONDS - test_started))
  printf 'runner wall time: compile %ds + tests %ds = %ds total\n' \
    "$compile_seconds" "$test_seconds" "$((SECONDS - suite_started))"
  exit "$status"
fi
rm -f "$manifest"

# ...then run under them: 6 GiB address space, 5 CPU minutes, two threads, and
# a SERIAL kernel gate. The gate's default width is eight, and the CPU rail
# counts every worker thread, so two test threads at the default width spend
# their five minutes about 2.5x faster than the work costs — see
# `KERNEL_WORKERS` in scripts/run-test-targets.mjs for the measurement. An
# explicitly set `HEATHER_KERNEL_WORKERS` still wins here too.
#
# The awk pass-through counts per-binary `test result:` lines — cargo
# scatters them across ~60 targets and prints no total, so callers (humans
# and agents both) were re-running the whole suite just to grep failures and
# sum counts separately. The final summary line is printed by *bash*, not
# awk, so it can see cargo's exit status: a ulimit-killed binary contributes
# no `test result:` line, and summing alone printed a SMALLER passed count
# with `0 failed` — a false green on the one line callers are told to trust
# (issues/scripts-test-killed-binary-reads-green.md, seen twice). awk also
# counts cargo's kill/crash lines as a second, status-independent signal.
#
# RUST_MIN_STACK raises the *test thread* stack from its 2 MiB default: the
# `Wf` step telescope embeds the `nth` schema (a nested elim_Nat under two
# λs), so checking the `tm_elim_wf` branch of a 56-branch recursor recurses
# deeper than 2 MiB allows. 8 MiB is comfortable; the cap above still bounds
# total address space.
ulimit -v 6291456
ulimit -t 300
counts=$(mktemp)
timings=$(mktemp)
test_started=$SECONDS
set +e
RUST_MIN_STACK=8388608 RUST_TEST_THREADS=2 \
HEATHER_KERNEL_WORKERS="${HEATHER_KERNEL_WORKERS:-1}" \
cargo test "${CARGO_FLAGS[@]}" "${TEST_ARGS[@]}" "$@" "${LIBTEST_ARGS[@]}" 2>&1 |
  awk -v out="$counts" -v timing_out="$timings" '
       { print }
       /^     Running / {
         target = $0
         sub(/^     Running /, "", target)
         sub(/ \([^)]*\)$/, "", target)
       }
       /^   Doc-tests / {
         target = $0
         sub(/^   Doc-tests /, "doc-tests ", target)
       }
       /^test result:/ {
         passed += $4; failed += $6; ignored += $8
         duration = $0
         sub(/^.*finished in /, "", duration)
         sub(/s$/, "", duration)
         if (target != "" && duration ~ /^[0-9]+([.][0-9]+)?$/) {
           printf "%s\t%s\n", duration, target >> timing_out
         }
       }
       /\(signal: [0-9]+/ || /process didn.t exit successfully/ { killed++ }
       END { printf "%d %d %d %d\n", passed, failed, ignored, killed > out }'
status=${PIPESTATUS[0]}
set -e
test_seconds=$((SECONDS - test_started))
read -r passed failed ignored killed < "$counts"
rm -f "$counts"
printf '\n== slowest test targets (reported test time) ==\n'
sort -t $'\t' -k1,1nr "$timings" | awk -F '\t' '
  NR <= 20 && $1 + 0 >= 1 { printf "%8.2fs  %s\n", $1, $2; shown++ }
  { total += $1 }
  END {
    if (!shown) print "  (no target took at least 1 second)"
    printf "reported target time: %.2fs across %d targets\n", total, NR
  }'
rm -f "$timings"
printf 'runner wall time: compile %ds + tests %ds = %ds total\n' \
  "$compile_seconds" "$test_seconds" "$((SECONDS - suite_started))"
if (( killed > 0 )) || { (( status != 0 )) && (( failed == 0 )); }; then
  # cargo died for a reason other than ordinary test failures (a binary was
  # killed by ulimit, crashed, etc.). Never print a green-looking count.
  printf '\n== suite: INCOMPLETE (a test binary died, exit %d, %d kill/crash lines; %d passed before death, %d failed) ==\n' \
    "$status" "$killed" "$passed" "$failed"
  exit $(( status != 0 ? status : 1 ))
fi
printf '\n== suite: %d passed, %d failed, %d ignored ==\n' "$passed" "$failed" "$ignored"
exit "$status"

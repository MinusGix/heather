#!/usr/bin/env python3
"""Regenerate the P3109 value-table probes in lib/_tests/std/num/float/p3109_codes_tests.hthr.

The P3109 working group publishes every code point's value for every format
with K = 3 .. 16 (`Value Tables/Hexadecimal/K*/P*/{signed,unsigned}/*.csv` in
github.com/P3109/Public). This script reads the formats listed in FORMATS
from a checkout of that repository and rewrites everything after the
`// generated by scripts/p3109-tables` marker in the test module: one layout
per format and `table_ok` theorems over its codes, split into stage theorems
of 16 codes (8 where the kernel needs it) for the 8-bit formats.

Usage: scripts/p3109-tables PATH/TO/P3109-Public
"""
import csv
import sys
from fractions import Fraction
from pathlib import Path

FORMATS = [(3, 1, 's', 'e'), (3, 1, 's', 'f'), (3, 1, 'u', 'e'), (3, 1, 'u', 'f'), (3, 2, 's', 'e'), (3, 2, 's', 'f'),
           (3, 2, 'u', 'e'), (3, 2, 'u', 'f'), (3, 3, 'u', 'e'), (3, 3, 'u', 'f'),
           (8, 1, 's', 'e'), (8, 1, 'u', 'f'), (8, 2, 's', 'e'), (8, 3, 's', 'e'), (8, 3, 's', 'f'), (8, 3, 'u', 'e'),
           (8, 4, 's', 'e'), (8, 4, 's', 'f'), (8, 5, 's', 'e')]
MARKER = "// generated by scripts/p3109-tables"
TARGET = Path(__file__).resolve().parent.parent / "lib/_tests/std/num/float/p3109_codes_tests.hthr"


def want(v):
    v = v.strip()
    if v == 'NaN':
        return 'WNaN'
    if v == 'Inf':
        return 'WPinf'
    if v == '-Inf':
        return 'WNinf'
    fr = Fraction(float.fromhex(v))
    neg = fr < 0
    fr = abs(fr)
    e = -(fr.denominator.bit_length() - 1)
    assert fr.denominator == 1 << -e
    m = fr.numerator
    if m == 0:
        e = 0
    while m and m % 2 == 0:
        m //= 2
        e += 1
    return f"WFin({'True' if neg else 'False'}, {m}, {e})"


def main():
    root = Path(sys.argv[1]) / "Value Tables" / "Hexadecimal"
    out = [MARKER + " from the P3109 value tables; do not edit by hand.", ""]
    for K, P, s, d in FORMATS:
        name = f"Binary{K}p{P}{s}{d}"
        with open(root / f"K{K}" / f"P{P}" / ("signed" if s == 's' else "unsigned") / f"{name}.csv") as fh:
            rows = list(csv.reader(fh))[1:]
        assert [int(r[0], 16) for r in rows] == list(range(len(rows)))
        wants = [want(r[1]) for r in rows]
        sg = 'Signed' if s == 's' else 'Unsigned'
        dm = 'ExtendedDomain' if d == 'e' else 'FiniteDomain'
        ln = f"b{K}p{P}{s}{d}"
        out.append(f"fn {ln}() → P3109Layout(Format::p3109({K}, {P}, {sg}, {dm})) {{ Format::p3109_layout({K}, {P}, {sg}, {dm}, trivial, trivial) }}")
        step = (8 if (P, s, d) == (3, 'u', 'e') else 16) if K > 4 else len(wants)
        for c in range(0, len(wants), step):
            tag = "" if step == len(wants) else f"_{c:03d}"
            out.append(f"theorem {ln}_table{tag}(): table_ok({ln}(), [{', '.join(wants[c:c + step])}])({c}) = True {{ refl }}")
        out.append(f"theorem {ln}_count(): Nat::pow(2, {K}) = {len(wants)} {{ refl }}")
    text = TARGET.read_text()
    head = text[:text.index(MARKER)]
    TARGET.write_text(head + "\n".join(out) + "\n")


if __name__ == "__main__":
    main()

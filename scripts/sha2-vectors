#!/usr/bin/env python3
"""Write `lib/_tests/std/crypto/sha2_tests.hthr`: SHA-2's test vectors as theorems.

A whole block evaluated in one declaration is past the kernel's fuel, so a
vector is proved by stages: the block, the schedule a few words at a time,
the rounds a few at a time, each stage a `refl` whose two sides are a
computation and a literal, and `lib/std/crypto/sha2.hthr`'s `*_then` and
`*_of` theorems put the stages together. The literals come from the
reference below, which is FIPS 180-4 transcribed, checked here against
`hashlib` before anything is written.

    scripts/sha2-vectors            # rewrite the tests module
    scripts/sha2-vectors --check    # exit 1 if the module on disk is stale

Stage sizes are the knobs (`EXTEND`, `RUN`): a stage must stay inside
2^20 kernel steps, and wider words cost more per round.
"""

import hashlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "lib/_tests/std/crypto/sha2_tests.hthr"

K256 = [

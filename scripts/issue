#!/usr/bin/env python3
"""Repo-local issue tracker over issues/*.md with YAML-ish frontmatter.

Stdlib only. See issues/README.md for the file convention.
"""

import argparse
import datetime
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ISSUES = ROOT / "issues"
INDEX = ISSUES / "INDEX.md"

STATUSES = ["open", "blocked", "closed"]


def parse_list(val: str):
    val = val.strip()
    if val.startswith("[") and val.endswith("]"):
        val = val[1:-1]
    return [x.strip() for x in val.split(",") if x.strip()]


def parse_issue(path: Path):
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.DOTALL)
    if not m:
        return None
    meta = {"slug": path.stem, "path": path}
    for line in m.group(1).splitlines():
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        key, val = key.strip(), val.strip()
        if key in ("labels", "blocked-by"):
            meta[key] = parse_list(val)
        else:
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            meta[key] = val
    meta.setdefault("title", meta["slug"])
    meta.setdefault("status", "open")
    meta.setdefault("labels", [])
    meta.setdefault("blocked-by", [])
    meta["body"] = m.group(2)
    return meta


def load_all():
    issues = []
    for path in sorted(ISSUES.glob("*.md")):
        if path.name in ("README.md", "INDEX.md"):
            continue
        meta = parse_issue(path)
        if meta is None:
            print(f"warning: {path.name} has no frontmatter, skipping", file=sys.stderr)
            continue
        issues.append(meta)
    return issues


def set_field(path: Path, key: str, value: str):
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.DOTALL)
    if not m:
        sys.exit(f"error: {path.name} has no frontmatter")
    front = m.group(1)
    pattern = re.compile(rf"^{re.escape(key)}:.*$", re.MULTILINE)
    if pattern.search(front):
        front = pattern.sub(f"{key}: {value}", front)
    else:
        front += f"\n{key}: {value}"
    path.write_text(f"---\n{front}\n---\n{m.group(2)}")


def today():
    return datetime.date.today().isoformat()


def read_prose(text, body_file, what: str, default_stdin: bool):
    """Prose for a log entry or a new issue's body.

    Prose here is markdown with `code spans`, so it must not travel through
    argv — a shell expands backticks inside a double-quoted argument and one
    entry was silently mangled that way ([[issue-log-text-through-stdin]]).
    A file or stdin is the safe path; the positional/--body form stays for
    short entries that are genuinely free of shell metacharacters.
    """
    if body_file is not None:
        if text is not None:
            sys.exit(f"error: give the {what} either inline or with --body-file, not both")
        return (sys.stdin.read() if body_file == "-" else Path(body_file).read_text())
    if text is not None:
        return text
    if not default_stdin:
        return None
    if sys.stdin.isatty():
        sys.exit(
            f"error: no {what} given. Write it on stdin (heredoc or `< entry.md`),\n"
            "       or pass --body-file <path>. Inline text is only safe without "
            "backticks."
        )
    return sys.stdin.read()


def as_log_entry(text: str) -> str:
    """`- <date>: <first line>` with continuation lines indented into the item.

    Everything after the first line is indented two spaces so that a multi-line
    entry — the normal shape once prose arrives on stdin — stays inside the list
    item, fenced blocks included.
    """
    if not text.strip():
        sys.exit("error: empty log entry")
    lines = text.strip("\n").rstrip().split("\n")
    head, rest = lines[0].strip(), lines[1:]
    return "\n".join([f"- {today()}: {head}"] + [("  " + l if l.strip() else "") for l in rest])


def index_entries(issues):
    """{slug: (status, line)}: one INDEX.md line per issue, from its frontmatter alone."""
    entries = {}
    for m in issues:
        tags = " ".join(
            ([f"`{m['thread']}`"] if m.get("thread") else [])
            + [f"`{l}`" for l in m["labels"]]
        )
        blocked = (
            " — blocked by " + ", ".join(f"[[{b}]]" for b in m["blocked-by"])
            if m["blocked-by"]
            else ""
        )
        entries[m["slug"]] = (m["status"], f"- [{m['title']}]({m['slug']}.md) {tags}{blocked}")
    return entries


def render_entries(entries):
    lines = ["# Issue Index", "", "Generated by `scripts/issue index` — do not edit.", ""]
    for status in STATUSES:
        group = sorted(slug for slug, (s, _) in entries.items() if s == status)
        if not group:
            continue
        lines.append(f"## {status} ({len(group)})")
        lines.append("")
        lines += [entries[slug][1] for slug in group]
        lines.append("")
    return "\n".join(lines)


def render_index(issues):
    return render_entries(index_entries(issues))


def parse_index(text: str):
    """Inverse of render_entries, for the merge driver: {slug: (status, line)}."""
    entries, status = {}, None
    for line in text.splitlines():
        h = re.match(r"^## (\S+) \(\d+\)$", line)
        if h:
            status = h.group(1)
            continue
        e = re.match(r"^- \[.*\]\(([^()/\s]+)\.md\)", line)
        if e and status:
            entries[e.group(1)] = (status, line)
    return entries


def write_index(issues):
    INDEX.write_text(render_index(issues))


def cmd_list(args):
    issues = load_all()
    if args.status:
        issues = [m for m in issues if m["status"] == args.status]
    if args.thread:
        issues = [m for m in issues if m.get("thread") == args.thread]
    if args.label:
        issues = [m for m in issues if args.label in m["labels"]]
    if not issues:
        print("no issues match")
        return
    order = {s: i for i, s in enumerate(STATUSES)}
    issues.sort(key=lambda m: (order.get(m["status"], 99), m["slug"]))
    wslug = max(len(m["slug"]) for m in issues)
    for m in issues:
        thread = m.get("thread", "")
        labels = ",".join(m["labels"])
        print(f"{m['status']:<8} {m['slug']:<{wslug}}  {thread:<4} {m['title']}" + (f"  [{labels}]" if labels else ""))


def find(slug: str) -> Path:
    path = ISSUES / f"{slug}.md"
    if not path.exists():
        matches = [p for p in ISSUES.glob("*.md") if slug in p.stem and p.name not in ("README.md", "INDEX.md")]
        if len(matches) == 1:
            return matches[0]
        sys.exit(f"error: no issue '{slug}'" + (f" (ambiguous: {', '.join(p.stem for p in matches)})" if matches else ""))
    return path


def backlinks(slug: str):
    """Issues whose body links [[slug]] or whose blocked-by names it.

    An issue's body should assert only what it owns and link everything else,
    so this is the list that has to be re-read when this issue moves.
    """
    out = []
    for m in load_all():
        if m["slug"] == slug:
            continue
        if slug in m["blocked-by"]:
            out.append((m, "blocked-by"))
        elif f"[[{slug}]]" in m["body"]:
            out.append((m, m["status"]))
    return sorted(out, key=lambda r: r[0]["slug"])


def print_backlinks(slug: str, header: str):
    refs = backlinks(slug)
    if not refs:
        return
    print(f"\n{header}")
    for m, why in refs:
        print(f"  {m['slug']:<40}  {why}")


def cmd_show(args):
    print(find(args.slug).read_text(), end="")
    print_backlinks(find(args.slug).stem, "Referenced by:")


def cmd_new(args):
    path = ISSUES / f"{args.slug}.md"
    if path.exists():
        sys.exit(f"error: {path.name} already exists")
    date = today()
    front = [f"title: {args.title}", "status: open"]
    if args.thread:
        front.append(f"thread: {args.thread}")
    if args.labels:
        front.append(f"labels: [{args.labels}]")
    front += [f"created: {date}", f"updated: {date}"]
    text = read_prose(args.body, args.body_file, "body", default_stdin=False)
    body = text.strip("\n") + "\n" if text and text.strip() else "\n"
    path.write_text("---\n" + "\n".join(front) + "\n---\n\n" + body)
    write_index(load_all())
    print(f"created issues/{path.name}")


def _set_status(slug: str, status: str):
    path = find(slug)
    set_field(path, "status", status)
    set_field(path, "updated", today())
    write_index(load_all())
    print(f"{path.stem}: status -> {status}")
    print_backlinks(path.stem, "Assumes something about this — re-read before moving on:")


def cmd_close(args):
    _set_status(args.slug, "closed")


def cmd_reopen(args):
    _set_status(args.slug, "open")


def cmd_index(_args):
    write_index(load_all())
    print(f"wrote {INDEX.relative_to(ROOT)}")


MERGE_DRIVER = "issue-index"


def cmd_merge_index(args):
    """Git merge driver for INDEX.md: `%O %A %B`, result written over %A.

    Each index line is a function of one issue's frontmatter, so a three-way
    merge per slug gives what `index` would print over the merged issue files
    whenever those merged cleanly. The one case it cannot settle is both sides
    changing the same issue's line differently; that issue's own file has
    almost certainly conflicted too, so the index is left conflicted with ours,
    to be regenerated once the issue is resolved.
    """
    base, ours, theirs = (parse_index(Path(f).read_text()) for f in (args.base, args.ours, args.theirs))
    merged, clashes = {}, []
    for slug in sorted(set(base) | set(ours) | set(theirs)):
        o, a, b = base.get(slug), ours.get(slug), theirs.get(slug)
        pick = a if a == b or b == o else b if a == o else None
        if pick is None:
            clashes.append(slug)
            pick = a
        if pick is not None:
            merged[slug] = pick
    Path(args.ours).write_text(render_entries(merged))
    if clashes:
        print(f"issues/INDEX.md: both sides changed {', '.join(clashes)}; "
              "resolve the issue file(s), then `scripts/issue index`", file=sys.stderr)
        sys.exit(1)


def cmd_setup_git(_args):
    """Register the INDEX.md merge driver in this clone's .git/config (idempotent)."""
    import subprocess
    for key, val in (("name", "regenerate issues/INDEX.md entries"),
                     ("driver", "scripts/issue merge-index %O %A %B")):
        subprocess.run(["git", "-C", str(ROOT), "config", f"merge.{MERGE_DRIVER}.{key}", val], check=True)
    print(f"merge driver '{MERGE_DRIVER}' registered for issues/INDEX.md (see .gitattributes)")


def cmd_log(args):
    entry = as_log_entry(read_prose(args.text, args.body_file, "entry", default_stdin=True))
    path = find(args.slug)
    text = path.read_text().rstrip("\n")
    if "\n## Log" not in text:
        text += "\n\n## Log"
    sep = "\n\n" if text.endswith("## Log") else "\n"
    text += sep + entry
    path.write_text(text + "\n")
    set_field(path, "updated", today())
    write_index(load_all())
    print(f"{path.stem}: logged")
    print_backlinks(path.stem, "Assumes something about this — re-read before moving on:")


def cmd_threads(_args):
    issues = load_all()
    threads = {}
    for m in issues:
        threads.setdefault(m.get("thread", "(none)"), []).append(m["status"])
    def sort_key(t):
        m = re.fullmatch(r"T(\d+)([a-z]?)", t)
        return (0, int(m.group(1)), m.group(2)) if m else (1, 0, t)
    width = max(len(t) for t in threads)
    print(f"{'thread':<{width}}  open  blocked  closed")
    for t in sorted(threads, key=sort_key):
        s = threads[t]
        print(f"{t:<{width}}  {s.count('open'):>4}  {s.count('blocked'):>7}  {s.count('closed'):>6}")


def cmd_check(_args):
    issues = load_all()
    slugs = {m["slug"] for m in issues}
    problems = []
    for m in issues:
        for b in m["blocked-by"]:
            if b not in slugs:
                problems.append(f"{m['slug']}: blocked-by '{b}' does not exist")
        for link in re.findall(r"\[\[([^\]]+)\]\]", m["body"]):
            if link not in slugs:
                problems.append(f"{m['slug']}: [[{link}]] does not resolve")
        if m["status"] not in STATUSES:
            problems.append(f"{m['slug']}: unknown status '{m['status']}'")
    if not INDEX.exists() or INDEX.read_text() != render_index(issues):
        problems.append("INDEX.md is stale — run `scripts/issue index`")

    # Warnings, not errors: judgement calls the README's ownership rules ask
    # for, which were both live in the tracker on 2026-07-27.
    warnings = []
    linked = set()
    for m in issues:
        linked |= set(re.findall(r"\[\[([^\]]+)\]\]", m["body"])) | set(m["blocked-by"])
    for m in issues:
        if m["status"] != "open":
            continue
        entries = re.findall(r"^- \d{4}-\d\d-\d\d: .*", m["body"], re.M)
        if entries and re.search(r"\b(LANDED|DONE|COMPLETE|IMPLEMENTED)\b", entries[-1]):
            warnings.append(f"{m['slug']}: open, but its last log entry says it landed (README rule 3)")
        if m["slug"] not in linked:
            warnings.append(f"{m['slug']}: open and nothing links to it — unfindable (README rule 1)")

    for p in problems:
        print(p)
    for w in warnings:
        print(f"warning: {w}")
    if problems:
        sys.exit(1)
    print(f"ok: {len(issues)} issues, no dangling links, index fresh"
          + (f" ({len(warnings)} warning(s))" if warnings else ""))


WEB = Path(__file__).resolve().parent / "issue-web.html"


def stamp():
    """Changes whenever an issue file is added, removed, or edited."""
    paths = [p for p in ISSUES.glob("*.md") if p.name not in ("README.md", "INDEX.md")]
    return f"{len(paths)}:{max((p.stat().st_mtime_ns for p in paths), default=0)}"


def issues_json():
    import json
    issues = load_all()
    slugs = {m["slug"] for m in issues}
    out = []
    for m in issues:
        links = []
        for link in re.findall(r"\[\[([^\]]+)\]\]", m["body"]):
            if link in slugs and link != m["slug"] and link not in links:
                links.append(link)
        out.append({
            "slug": m["slug"],
            "title": m["title"],
            "status": m["status"],
            "labels": m["labels"],
            "blockedBy": [b for b in m["blocked-by"] if b in slugs],
            "thread": m.get("thread", ""),
            "code": m.get("code", ""),
            "created": m.get("created", ""),
            "updated": m.get("updated", ""),
            "links": links,
            "body": m["body"],
        })
    return json.dumps({"stamp": stamp(), "today": today(), "issues": out})


def cmd_serve(args):
    """Read-only web viewer. Every request re-reads issues/, so edits made
    while it runs show up (the page polls /api/stamp and refetches)."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def send(self, body: bytes, ctype: str):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path in ("/", "/index.html"):
                self.send(WEB.read_bytes(), "text/html; charset=utf-8")
            elif path == "/api/issues":
                self.send(issues_json().encode(), "application/json")
            elif path == "/api/stamp":
                self.send(stamp().encode(), "text/plain")
            else:
                self.send_error(404)

        def log_message(self, *_):
            pass

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{server.server_address[1]}/"
    print(f"serving issues at {url} (read-only; Ctrl-C to stop)", flush=True)
    if args.open:
        import webbrowser
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    p = argparse.ArgumentParser(prog="issue", description="repo-local issue tracker")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="list issues")
    sp.add_argument("--status", choices=STATUSES)
    sp.add_argument("--thread")
    sp.add_argument("--label")
    sp.set_defaults(fn=cmd_list)

    sp = sub.add_parser("show", help="print one issue")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_show)

    sp = sub.add_parser("new", help="create an issue")
    sp.add_argument("slug")
    sp.add_argument("--title", required=True)
    sp.add_argument("--thread")
    sp.add_argument("--labels", help="comma-separated")
    sp.add_argument("--body", help="short body; unsafe for prose with `code spans`")
    sp.add_argument("--body-file", metavar="PATH", help="read the body from a file, or `-` for stdin")
    sp.set_defaults(fn=cmd_new)

    sp = sub.add_parser("close", help="mark closed")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_close)

    sp = sub.add_parser("reopen", help="mark open")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_reopen)

    sp = sub.add_parser("index", help="regenerate INDEX.md")
    sp.set_defaults(fn=cmd_index)

    sp = sub.add_parser("merge-index", help="git merge driver for INDEX.md (%%O %%A %%B); see setup-git")
    sp.add_argument("base")
    sp.add_argument("ours")
    sp.add_argument("theirs")
    sp.set_defaults(fn=cmd_merge_index)

    sp = sub.add_parser("setup-git", help="register the INDEX.md merge driver in this clone")
    sp.set_defaults(fn=cmd_setup_git)

    sp = sub.add_parser("log", help="append a dated entry to an issue's ## Log (text on stdin)")
    sp.add_argument("slug")
    sp.add_argument("text", nargs="?", help="short entry; omit to read the entry from stdin")
    sp.add_argument("--body-file", metavar="PATH", help="read the entry from a file, or `-` for stdin")
    sp.set_defaults(fn=cmd_log)

    sp = sub.add_parser("threads", help="per-thread status counts")
    sp.set_defaults(fn=cmd_threads)

    sp = sub.add_parser("check", help="lint: dangling links/blocked-by, stale index")
    sp.set_defaults(fn=cmd_check)

    sp = sub.add_parser("serve", help="read-only web viewer (list, areas, link graph)")
    sp.add_argument("--port", type=int, default=8765)
    sp.add_argument("--host", default="127.0.0.1")
    sp.add_argument("--open", action="store_true", help="open a browser tab")
    sp.set_defaults(fn=cmd_serve)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()

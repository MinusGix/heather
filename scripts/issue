#!/usr/bin/env python3
"""Repo-local issue tracker over issues/*.md with YAML-ish frontmatter.

Stdlib only. See issues/README.md for the file convention.
"""

import argparse
import datetime
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
ISSUES = ROOT / "issues"
# Name of the index file when someone writes one with `index -o` (gitignored,
# never committed); skipped like README.md so it is never read as an issue.
INDEX = ISSUES / "INDEX.md"

STATUSES = ["open", "blocked", "closed"]

# `milestone: [none]` spells "intentionally unplaced": a decision that the
# issue serves no milestone, as opposed to nobody having placed it yet
# (docs/agent-policy.md §7). It stands alone in the list.
UNPLACED = "none"

# The areas and milestones an issue's `area:`/`milestone:` may name, and their
# importance order, live in two tables of the roadmap (docs/roadmap.md owns
# them; this script only reads them).
ROADMAP = ROOT / "docs" / "roadmap.md"


def parse_list(val: str):
    val = val.strip()
    if val.startswith("[") and val.endswith("]"):
        val = val[1:-1]
    return [x.strip() for x in val.split(",") if x.strip()]


def parse_issue(path: Path):
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.DOTALL)
    if not m:
        return None
    meta = {"slug": path.stem, "path": path}
    for line in m.group(1).splitlines():
        if ":" not in line:
            continue
        key, _, val = line.partition(":")
        key, val = key.strip(), val.strip()
        if key in ("labels", "blocked-by", "milestone"):
            meta[key] = parse_list(val)
        else:
            if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
                val = val[1:-1]
            meta[key] = val
    meta.setdefault("title", meta["slug"])
    meta.setdefault("status", "open")
    meta.setdefault("labels", [])
    meta.setdefault("blocked-by", [])
    meta.setdefault("milestone", [])
    meta.setdefault("area", "")
    meta["body"] = m.group(2)
    return meta


def load_all():
    issues = []
    for path in sorted(ISSUES.glob("*.md")):
        if path.name in ("README.md", "INDEX.md"):
            continue
        meta = parse_issue(path)
        if meta is None:
            print(f"warning: {path.name} has no frontmatter, skipping", file=sys.stderr)
            continue
        issues.append(meta)
    return issues


def roadmap_table(name: str):
    """Rows of the table between `<!-- name -->` and `<!-- /name -->` in the
    roadmap, header and separator dropped, backticks stripped from cells."""
    text = ROADMAP.read_text() if ROADMAP.exists() else ""
    m = re.search(rf"<!-- {name} -->\n(.*?)<!-- /{name} -->", text, re.DOTALL)
    if not m:
        return []
    rows = []
    for line in m.group(1).splitlines():
        if not line.startswith("|"):
            continue
        cells = [c.strip().strip("`") for c in line.strip().strip("|").split("|")]
        if all(set(c) <= set("-: ") for c in cells):
            continue
        rows.append(cells)
    return rows[1:]


def load_roadmap():
    """(areas, milestones) in roadmap order, as lists of dicts."""
    areas = [dict(rank=r[0], area=r[1], tier=r[2], name=r[3], direction=r[4])
             for r in roadmap_table("areas") if len(r) >= 5]
    milestones = [dict(milestone=r[0], area=r[1], status=r[2], done=r[3],
                       parent=r[4] if len(r) > 4 else "")
                  for r in roadmap_table("milestones") if len(r) >= 4]
    return areas, milestones


def set_field(path: Path, key: str, value: str):
    text = path.read_text()
    m = re.match(r"^---\n(.*?)\n---\n?(.*)$", text, re.DOTALL)
    if not m:
        sys.exit(f"error: {path.name} has no frontmatter")
    front = m.group(1)
    pattern = re.compile(rf"^{re.escape(key)}:.*$", re.MULTILINE)
    if pattern.search(front):
        front = pattern.sub(f"{key}: {value}", front)
    else:
        front += f"\n{key}: {value}"
    path.write_text(f"---\n{front}\n---\n{m.group(2)}")


def today():
    return datetime.date.today().isoformat()


def read_prose(text, body_file, what: str, default_stdin: bool):
    """Prose for a log entry or a new issue's body.

    Prose here is markdown with `code spans`, so it must not travel through
    argv — a shell expands backticks inside a double-quoted argument and one
    entry was silently mangled that way ([[issue-log-text-through-stdin]]).
    A file or stdin is the safe path; the positional/--body form stays for
    short entries that are genuinely free of shell metacharacters.
    """
    if body_file is not None:
        if text is not None:
            sys.exit(f"error: give the {what} either inline or with --body-file, not both")
        return (sys.stdin.read() if body_file == "-" else Path(body_file).read_text())
    if text is not None:
        return text
    if not default_stdin:
        return None
    if sys.stdin.isatty():
        sys.exit(
            f"error: no {what} given. Write it on stdin (heredoc or `< entry.md`),\n"
            "       or pass --body-file <path>. Inline text is only safe without "
            "backticks."
        )
    return sys.stdin.read()


def as_log_entry(text: str) -> str:
    """`- <date>: <first line>` with continuation lines indented into the item.

    Everything after the first line is indented two spaces so that a multi-line
    entry — the normal shape once prose arrives on stdin — stays inside the list
    item, fenced blocks included.
    """
    if not text.strip():
        sys.exit("error: empty log entry")
    lines = text.strip("\n").rstrip().split("\n")
    head, rest = lines[0].strip(), lines[1:]
    return "\n".join([f"- {today()}: {head}"] + [("  " + l if l.strip() else "") for l in rest])


def index_entries(issues):
    """{slug: (status, line)}: one index line per issue, from its frontmatter alone."""
    entries = {}
    for m in issues:
        tags = " ".join(
            ([f"`{m['thread']}`"] if m.get("thread") else [])
            + ([f"**{m['area']}**"] if m["area"] else [])
            + [f"`{l}`" for l in m["labels"]]
        )
        blocked = (
            " — blocked by " + ", ".join(f"[[{b}]]" for b in m["blocked-by"])
            if m["blocked-by"]
            else ""
        )
        entries[m["slug"]] = (m["status"], f"- [{m['title']}]({m['slug']}.md) {tags}{blocked}")
    return entries


def render_entries(entries):
    lines = ["# Issue Index", "", "Generated by `scripts/issue index` from issues/*.md — not tracked.", ""]
    for status in STATUSES:
        group = sorted(slug for slug, (s, _) in entries.items() if s == status)
        if not group:
            continue
        lines.append(f"## {status} ({len(group)})")
        lines.append("")
        lines += [entries[slug][1] for slug in group]
        lines.append("")
    return "\n".join(lines)


def render_index(issues):
    return render_entries(index_entries(issues))


def cmd_list(args):
    issues = load_all()
    if args.status:
        issues = [m for m in issues if m["status"] == args.status]
    if args.thread:
        issues = [m for m in issues if m.get("thread") == args.thread]
    if args.label:
        issues = [m for m in issues if args.label in m["labels"]]
    if args.area:
        issues = [m for m in issues if m["area"] == ("" if args.area == "none" else args.area)]
    if args.milestone:
        issues = [m for m in issues if args.milestone in m["milestone"]]
    if not issues:
        print("no issues match")
        return
    order = {s: i for i, s in enumerate(STATUSES)}
    issues.sort(key=lambda m: (order.get(m["status"], 99), m["slug"]))
    wslug = max(len(m["slug"]) for m in issues)
    warea = max(len(m["area"]) for m in issues)
    for m in issues:
        thread = m.get("thread", "")
        labels = ",".join(m["labels"])
        print(f"{m['status']:<8} {m['slug']:<{wslug}}  {thread:<4} {m['area']:<{warea}}  {m['title']}" + (f"  [{labels}]" if labels else ""))


def find(slug: str) -> Path:
    path = ISSUES / f"{slug}.md"
    if not path.exists():
        matches = [p for p in ISSUES.glob("*.md") if slug in p.stem and p.name not in ("README.md", "INDEX.md")]
        if len(matches) == 1:
            return matches[0]
        sys.exit(f"error: no issue '{slug}'" + (f" (ambiguous: {', '.join(p.stem for p in matches)})" if matches else ""))
    return path


def backlinks(slug: str):
    """Issues whose body links [[slug]] or whose blocked-by names it.

    An issue's body should assert only what it owns and link everything else,
    so this is the list that has to be re-read when this issue moves.
    """
    out = []
    for m in load_all():
        if m["slug"] == slug:
            continue
        if slug in m["blocked-by"]:
            out.append((m, "blocked-by"))
        elif f"[[{slug}]]" in m["body"]:
            out.append((m, m["status"]))
    return sorted(out, key=lambda r: r[0]["slug"])


def print_backlinks(slug: str, header: str):
    refs = backlinks(slug)
    if not refs:
        return
    print(f"\n{header}")
    for m, why in refs:
        print(f"  {m['slug']:<40}  {why}")


def cmd_show(args):
    print(find(args.slug).read_text(), end="")
    print_backlinks(find(args.slug).stem, "Referenced by:")


def cmd_new(args):
    path = ISSUES / f"{args.slug}.md"
    if path.exists():
        sys.exit(f"error: {path.name} already exists")
    date = today()
    front = [f"title: {args.title}", "status: open"]
    if args.thread:
        front.append(f"thread: {args.thread}")
    if args.labels:
        front.append(f"labels: [{args.labels}]")
    if args.area:
        front.append(f"area: {args.area}")
    if args.milestone:
        front.append(f"milestone: [{args.milestone}]")
    front += [f"created: {date}", f"updated: {date}"]
    text = read_prose(args.body, args.body_file, "body", default_stdin=False)
    body = text.strip("\n") + "\n" if text and text.strip() else "\n"
    path.write_text("---\n" + "\n".join(front) + "\n---\n\n" + body)
    print(f"created issues/{path.name}")


def _set_status(slug: str, status: str):
    path = find(slug)
    set_field(path, "status", status)
    set_field(path, "updated", today())
    print(f"{path.stem}: status -> {status}")
    print_backlinks(path.stem, "Assumes something about this — re-read before moving on:")


def cmd_close(args):
    _set_status(args.slug, "closed")


def cmd_reopen(args):
    _set_status(args.slug, "open")


def cmd_index(args):
    text = render_index(load_all())
    if args.out:
        Path(args.out).write_text(text)
        print(f"wrote {args.out}")
    else:
        print(text, end="")


def append_log(path: Path, entry: str):
    """Append a rendered entry under the issue's `## Log`, creating it."""
    text = path.read_text().rstrip("\n")
    if "\n## Log" not in text:
        text += "\n\n## Log"
    sep = "\n\n" if text.endswith("## Log") else "\n"
    text += sep + entry
    path.write_text(text + "\n")


def cmd_log(args):
    entry = as_log_entry(read_prose(args.text, args.body_file, "entry", default_stdin=True))
    path = find(args.slug)
    append_log(path, entry)
    set_field(path, "updated", today())
    print(f"{path.stem}: logged")
    print_backlinks(path.stem, "Assumes something about this — re-read before moving on:")


def cmd_tag(args):
    """Set an issue's area and/or milestones. Leaves `updated:` alone: a tag
    is bookkeeping about the issue, not progress on it, and bumping it would
    reorder every "last updated" view after a retagging sweep."""
    if args.area is None and args.milestone is None:
        sys.exit("error: give --area and/or --milestone")
    areas, milestones = load_roadmap()
    if args.area is not None and args.area not in {a["area"] for a in areas}:
        sys.exit(f"error: unknown area '{args.area}' (see docs/roadmap.md)")
    ms = parse_list(args.milestone or "")
    if UNPLACED in ms and len(ms) > 1:
        sys.exit(f"error: milestone '{UNPLACED}' (intentionally unplaced) stands alone")
    unknown = [x for x in ms if x not in {m["milestone"] for m in milestones} | {UNPLACED}]
    if unknown:
        sys.exit(f"error: unknown milestone(s) {', '.join(unknown)} (see docs/roadmap.md)")
    for slug in args.slugs:
        path = find(slug)
        if args.area is not None:
            set_field(path, "area", args.area)
        if args.milestone is not None:
            set_field(path, "milestone", f"[{', '.join(ms)}]")
        print(f"{path.stem}: tagged")


def cmd_areas(_args):
    """The roadmap's areas in priority order, with issue counts, and each
    milestone with the open issues that name it, submilestones nested under
    their parent."""
    areas, milestones = load_roadmap()
    issues = load_all()
    live = lambda m: m["status"] != "closed"
    wname = max([len(a["area"]) for a in areas] + [9])
    # unplaced: open, no milestone yet (awaiting a placement); none: open and
    # deliberately serving no milestone (`milestone: [none]`).
    print(f"{'pri':>4}  {'area':<{wname}}  {'tier':<9} open  unplaced  none  closed")
    for a in areas:
        ms = [m for m in issues if m["area"] == a["area"]]
        op = [m for m in ms if live(m)]
        unplaced = sum(1 for m in op if not m["milestone"])
        none = sum(1 for m in op if m["milestone"] == [UNPLACED])
        print(f"{a['rank']:>4}  {a['area']:<{wname}}  {a['tier']:<9} {len(op):>4}  {unplaced:>8}  {none:>4}  {len(ms) - len(op):>6}")
        mine = [x for x in milestones if x["area"] == a["area"]]
        for mi in [x for x in mine if not x["parent"]] + [x for x in mine if x["parent"] and x["parent"] not in {y["milestone"] for y in mine}]:
            for depth, x in [(0, mi)] + [(1, c) for c in mine if c["parent"] == mi["milestone"]]:
                serving = sorted(m["slug"] for m in issues if x["milestone"] in m["milestone"] and live(m))
                print(f"{'':>4}    {'  ' * depth}- {x['milestone']} ({x['status']}): {len(serving)} open"
                      + (f": {', '.join(serving)}" if serving else ""))
    op = [m for m in issues if live(m)]
    print(f"\n{len(op)} open: {sum(1 for m in op if not m['milestone'])} unplaced, "
          f"{sum(1 for m in op if m['milestone'] == [UNPLACED])} intentionally unplaced (milestone: [{UNPLACED}])")
    untagged = [m for m in issues if not m["area"] and live(m)]
    if untagged:
        print(f"\n{len(untagged)} open issue(s) with no area: scripts/issue list --area none --status open")


def cmd_threads(_args):
    issues = load_all()
    threads = {}
    for m in issues:
        threads.setdefault(m.get("thread", "(none)"), []).append(m["status"])
    def sort_key(t):
        m = re.fullmatch(r"T(\d+)([a-z]?)", t)
        return (0, int(m.group(1)), m.group(2)) if m else (1, 0, t)
    width = max(len(t) for t in threads)
    print(f"{'thread':<{width}}  open  blocked  closed")
    for t in sorted(threads, key=sort_key):
        s = threads[t]
        print(f"{t:<{width}}  {s.count('open'):>4}  {s.count('blocked'):>7}  {s.count('closed'):>6}")


def cmd_check(_args):
    issues = load_all()
    slugs = {m["slug"] for m in issues}
    areas, milestones = load_roadmap()
    area_names = {a["area"] for a in areas}
    milestone_names = {mi["milestone"] for mi in milestones}
    problems = []
    for m in issues:
        for b in m["blocked-by"]:
            if b not in slugs:
                problems.append(f"{m['slug']}: blocked-by '{b}' does not exist")
        for link in re.findall(r"\[\[([^\]]+)\]\]", m["body"]):
            if link not in slugs:
                problems.append(f"{m['slug']}: [[{link}]] does not resolve")
        if m["status"] not in STATUSES:
            problems.append(f"{m['slug']}: unknown status '{m['status']}'")
        if m["area"] and m["area"] not in area_names:
            problems.append(f"{m['slug']}: unknown area '{m['area']}' (docs/roadmap.md)")
        if UNPLACED in m["milestone"] and len(m["milestone"]) > 1:
            problems.append(f"{m['slug']}: milestone '{UNPLACED}' (intentionally unplaced) must stand alone")
        for x in m["milestone"]:
            if x not in milestone_names and x != UNPLACED:
                problems.append(f"{m['slug']}: unknown milestone '{x}' (docs/roadmap.md)")
    by_ms = {mi["milestone"]: mi for mi in milestones}
    for mi in milestones:
        if mi["area"] not in area_names:
            problems.append(f"roadmap: milestone '{mi['milestone']}' names unknown area '{mi['area']}'")
        parent = by_ms.get(mi["parent"]) if mi["parent"] else None
        if mi["parent"] and (parent is None or parent["area"] != mi["area"] or parent["parent"]):
            problems.append(f"roadmap: submilestone '{mi['milestone']}' needs a top-level parent in its own area, not '{mi['parent']}'")

    # Warnings, not errors: judgement calls the README's ownership rules ask
    # for, which were both live in the tracker on 2026-07-27.
    warnings = []
    for m in landed_but_open(issues):
        warnings.append(f"{m['slug']}: open, but its last log entry says it landed (README rule 3)")
    for m in unlinked(issues):
        warnings.append(f"{m['slug']}: open and nothing links to it — unfindable (README rule 1)")

    untagged = [m for m in issues if m["status"] != "closed" and not m["area"]]
    if untagged:
        warnings.append(f"{len(untagged)} open issue(s) have no area: scripts/issue list --area none --status open")

    for p in problems:
        print(p)
    for w in warnings:
        print(f"warning: {w}")
    if problems:
        sys.exit(1)
    print(f"ok: {len(issues)} issues, no dangling links"
          + (f" ({len(warnings)} warning(s))" if warnings else ""))


# ---------------------------------------------------------------- garden
#
# The deterministic half of the tracker gardener (docs/agent-policy.md §7,
# [[tracker-gardener]]). It reports; `--apply` performs only what §7 lets the
# gardener do on its own (links, a single-fit area), and every proposal
# (closing, milestones, `wanted`) is left to a person or a thread.

WIKI = re.compile(r"\[\[([^\]]+)\]\]")
LOG_ENTRY = re.compile(r"^- \d{4}-\d\d-\d\d: .*", re.M)
LANDED_WORDS = re.compile(r"\b(landed|done|closed|merged|complete|implemented)\b", re.I)
# A repository path an issue cites, in its body or `code:`; stops at `:line`.
CITED = re.compile(r"(?<![\w/.-])((?:crates|lib|docs|scripts|perf|probes)/[A-Za-z0-9_./-]*[A-Za-z0-9_])")
GARDENER = "gardener"


def last_log_entry(m):
    """The last log entry a person or a round wrote: the gardener's own link
    lines say nothing about the issue's progress, and cite file names that
    would match the landed words (`docs/closed-…`)."""
    entries = [e for e in LOG_ENTRY.findall(m["body"]) if not e[14:].startswith(f"{GARDENER}:")]
    return entries[-1] if entries else ""


def landed_but_open(issues):
    """README rule 3's hand check: open issues whose last log entry says the
    work landed (or is done, closed, merged). A candidate list for a reader:
    "done" also matches "not done yet"."""
    return [m for m in issues if m["status"] == "open" and LANDED_WORDS.search(last_log_entry(m))]


def unlinked(issues):
    """README rule 1's hand check: open issues no issue links to (body
    `[[…]]` or `blocked-by`) and the roadmap does not name."""
    linked = set()
    for m in issues:
        linked |= {x for x in WIKI.findall(m["body"]) if x != m["slug"]} | set(m["blocked-by"])
    if ROADMAP.exists():
        linked |= set(re.findall(r"issues/([a-z0-9-]+)\.md", ROADMAP.read_text()))
    return [m for m in issues if m["status"] == "open" and m["slug"] not in linked]


def cited_files(m):
    """Files (not directories) the issue cites in `code:` or its body."""
    text = m.get("code", "") + "\n" + m["body"]
    return {p.rstrip(".") for p in CITED.findall(text) if "." in p.rstrip(".").rsplit("/", 1)[-1]}


def links_between(a, b):
    return (f"[[{b['slug']}]]" in a["body"] or f"[[{a['slug']}]]" in b["body"]
            or a["slug"] in b["blocked-by"] or b["slug"] in a["blocked-by"])


def link_candidates(issues, max_sharers):
    """{(a, b): [files]} for open issues a < b that cite a common file and do
    not link each other. A file cited by more than `max_sharers` open issues
    is a hotspot (the elaborator core, the roadmap), not evidence of a
    relation, and is skipped."""
    open_ = {m["slug"]: m for m in issues if m["status"] == "open"}
    by_file = {}
    for m in open_.values():
        for f in cited_files(m):
            by_file.setdefault(f, set()).add(m["slug"])
    pairs = {}
    for f, slugs in sorted(by_file.items()):
        if not 2 <= len(slugs) <= max_sharers:
            continue
        slugs = sorted(slugs)
        for i, a in enumerate(slugs):
            for b in slugs[i + 1:]:
                if not links_between(open_[a], open_[b]):
                    pairs.setdefault((a, b), []).append(f)
    return pairs


def lane_footprints():
    """[(area, regex)] from the roadmap's Parallel lanes table, for lanes that
    name exactly one area (in backticks, or as the lane's name). Only the
    backticked paths before a `;` count: what follows is commentary
    ("shared with `language`", "reads … at most in comments")."""
    if not ROADMAP.exists():
        return []
    text = ROADMAP.read_text()
    m = re.search(r"^\| lane \| main footprint \|\n\|[-| ]+\|\n((?:\|.*\n)+)", text, re.M)
    if not m:
        return []
    names = {a["area"] for a in load_roadmap()[0]}
    out = []
    for line in m.group(1).splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) < 2:
            continue
        lane, foot = cells[0], cells[1]
        named = [x for x in re.findall(r"`([^`]+)`", lane) if x in names]
        if not named and "," not in lane:
            slug = lane.strip().lower().replace(" ", "-")
            named = [slug] if slug in names else []
        if len(named) != 1:
            continue
        for pat in re.findall(r"`([^`]+)`", foot.split(";")[0]):
            rx = re.escape(pat).replace(r"\*", "[^/]*")
            rx = re.sub(r"\\\{(.*?)\\\}", lambda g: "(?:" + g.group(1).replace(",", "|") + ")", rx)
            rx = ("^" if "/" in pat else "(?:^|/)") + rx + ("" if pat.endswith(("/", "*")) else "$")
            out.append((named[0], re.compile(rx)))
    return out


def single_fit_area(m, lanes):
    """The one area whose lanes cover every code file (`crates/`, `lib/`)
    the issue cites, or None when none or several fit, or a file falls
    outside every lane."""
    files = [f for f in cited_files(m) if f.startswith(("crates/", "lib/"))]
    if not files:
        return None
    fits = set()
    for f in files:
        hit = {area for area, rx in lanes if rx.search(f)}
        if len(hit) != 1:
            return None
        fits |= hit
    return fits.pop() if len(fits) == 1 else None


def cmd_garden(args):
    issues = load_all()
    by_slug = {m["slug"]: m for m in issues}
    landed = landed_but_open(issues)
    orphans = unlinked(issues)
    pairs = link_candidates(issues, args.max_sharers)
    lanes = lane_footprints()
    areas = {m["slug"]: a for m in issues
             if m["status"] == "open" and not m["area"] and (a := single_fit_area(m, lanes))}

    def section(title, rows):
        print(f"## {title} ({len(rows)})\n")
        for r in rows:
            print(f"- {r}")
        print()

    section("Open, last log says landed (README rule 3: close, or file residue first)",
            [f"{m['slug']}: {last_log_entry(m)[2:][:160]}" for m in landed])
    section("Open, nothing links to it (README rule 1)", [m["slug"] for m in orphans])
    section(f"Candidate links: open issues citing a common file (≤{args.max_sharers} citers)",
            [f"[[{a}]] ↔ [[{b}]]: " + ", ".join(f"`{f}`" for f in fs) for (a, b), fs in sorted(pairs.items())])
    section("Single-fit area for an open issue with none (roadmap Parallel lanes)",
            [f"{s}: {a}" for s, a in sorted(areas.items())])

    if not args.apply:
        print("dry run: `scripts/issue garden --apply` adds the links and areas above, "
              "one log line per touched issue, `updated:` left alone")
        return

    # One entry per touched issue, whatever it gained.
    notes = {}
    for (a, b), fs in sorted(pairs.items()):
        files = ", ".join(f"`{f}`" for f in fs)
        notes.setdefault(a, []).append(f"[[{b}]] ({files})")
        notes.setdefault(b, []).append(f"[[{a}]] ({files})")
    entries = {s: f"{GARDENER}: cites a file it shares with " + "; ".join(xs) + "." for s, xs in notes.items()}
    for s, area in areas.items():
        set_field(by_slug[s]["path"], "area", area)
        line = f"area set to `{area}`: every code file it cites is in that lane's footprint."
        entries[s] = entries[s] + " " + line[0].upper() + line[1:] if s in entries else f"{GARDENER}: {line}"
    for s, text in sorted(entries.items()):
        append_log(by_slug[s]["path"], f"- {today()}: {text}")
    print(f"applied: {len(pairs)} link(s), {len(areas)} area(s); logged on {len(entries)} issue(s)")


WEB = Path(__file__).resolve().parent / "issue-web.html"


def stamp():
    """Changes whenever an issue file is added, removed, or edited."""
    paths = [p for p in ISSUES.glob("*.md") if p.name not in ("README.md", "INDEX.md")]
    paths += [ROADMAP] if ROADMAP.exists() else []
    return f"{len(paths)}:{max((p.stat().st_mtime_ns for p in paths), default=0)}"


def issues_json():
    import json
    issues = load_all()
    slugs = {m["slug"] for m in issues}
    out = []
    for m in issues:
        links = []
        for link in re.findall(r"\[\[([^\]]+)\]\]", m["body"]):
            if link in slugs and link != m["slug"] and link not in links:
                links.append(link)
        out.append({
            "slug": m["slug"],
            "title": m["title"],
            "status": m["status"],
            "labels": m["labels"],
            "area": m["area"],
            "milestones": m["milestone"],
            "blockedBy": [b for b in m["blocked-by"] if b in slugs],
            "thread": m.get("thread", ""),
            "code": m.get("code", ""),
            "created": m.get("created", ""),
            "updated": m.get("updated", ""),
            "links": links,
            "body": m["body"],
        })
    areas, milestones = load_roadmap()
    return json.dumps({"stamp": stamp(), "today": today(), "issues": out,
                       "areas": areas, "milestones": milestones})


def cmd_serve(args):
    """Read-only web viewer. Every request re-reads issues/, so edits made
    while it runs show up (the page polls /api/stamp and refetches)."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def send(self, body: bytes, ctype: str):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path in ("/", "/index.html"):
                self.send(WEB.read_bytes(), "text/html; charset=utf-8")
            elif path == "/api/issues":
                self.send(issues_json().encode(), "application/json")
            elif path == "/api/stamp":
                self.send(stamp().encode(), "text/plain")
            else:
                self.send_error(404)

        def log_message(self, *_):
            pass

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{server.server_address[1]}/"
    print(f"serving issues at {url} (read-only; Ctrl-C to stop)", flush=True)
    if args.open:
        import webbrowser
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def cmd_export(args):
    """Static snapshot of the web viewer: the page plus the two files it
    fetches, under the same relative paths `serve` answers, so any static host
    (or a file server) serves it unchanged. The stamp only changes between
    exports, so an open page reloads itself once a new export is published."""
    out = Path(args.dir)
    (out / "api").mkdir(parents=True, exist_ok=True)
    (out / "index.html").write_bytes(WEB.read_bytes())
    (out / "api" / "issues").write_text(issues_json())
    (out / "api" / "stamp").write_text(stamp())
    print(f"exported {out}/index.html, {out}/api/issues, {out}/api/stamp")


def main():
    p = argparse.ArgumentParser(prog="issue", description="repo-local issue tracker")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("list", help="list issues")
    sp.add_argument("--status", choices=STATUSES)
    sp.add_argument("--thread")
    sp.add_argument("--label")
    sp.add_argument("--area", help="an area from docs/roadmap.md, or `none` for untagged")
    sp.add_argument("--milestone")
    sp.set_defaults(fn=cmd_list)

    sp = sub.add_parser("show", help="print one issue")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_show)

    sp = sub.add_parser("new", help="create an issue")
    sp.add_argument("slug")
    sp.add_argument("--title", required=True)
    sp.add_argument("--thread")
    sp.add_argument("--labels", help="comma-separated")
    sp.add_argument("--area", help="an area from docs/roadmap.md")
    sp.add_argument("--milestone", help="comma-separated milestones from docs/roadmap.md")
    sp.add_argument("--body", help="short body; unsafe for prose with `code spans`")
    sp.add_argument("--body-file", metavar="PATH", help="read the body from a file, or `-` for stdin")
    sp.set_defaults(fn=cmd_new)

    sp = sub.add_parser("close", help="mark closed")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_close)

    sp = sub.add_parser("reopen", help="mark open")
    sp.add_argument("slug")
    sp.set_defaults(fn=cmd_reopen)

    sp = sub.add_parser("index", help="print the markdown index (grouped by status) to stdout")
    sp.add_argument("-o", "--out", metavar="PATH", help="write it to PATH instead")
    sp.set_defaults(fn=cmd_index)

    sp = sub.add_parser("log", help="append a dated entry to an issue's ## Log (text on stdin)")
    sp.add_argument("slug")
    sp.add_argument("text", nargs="?", help="short entry; omit to read the entry from stdin")
    sp.add_argument("--body-file", metavar="PATH", help="read the entry from a file, or `-` for stdin")
    sp.set_defaults(fn=cmd_log)

    sp = sub.add_parser("tag", help="set area and/or milestones (does not bump updated:)")
    sp.add_argument("slugs", nargs="+")
    sp.add_argument("--area")
    sp.add_argument("--milestone", help="comma-separated; empty string clears")
    sp.set_defaults(fn=cmd_tag)

    sp = sub.add_parser("areas", help="roadmap areas in priority order, with counts and milestones")
    sp.set_defaults(fn=cmd_areas)

    sp = sub.add_parser("threads", help="per-thread status counts")
    sp.set_defaults(fn=cmd_threads)

    sp = sub.add_parser("check", help="lint: dangling links/blocked-by")
    sp.set_defaults(fn=cmd_check)

    sp = sub.add_parser("garden", help="tracker gardener checks: landed-but-open, unlinked, candidate links, single-fit areas")
    sp.add_argument("--apply", action="store_true",
                    help="add the candidate links and single-fit areas (one log line per issue; updated: untouched)")
    sp.add_argument("--max-sharers", type=int, default=3, metavar="N",
                    help="ignore files cited by more than N open issues (hotspots); default 3")
    sp.set_defaults(fn=cmd_garden)

    sp = sub.add_parser("serve", help="read-only web viewer (list, areas, link graph)")
    sp.add_argument("--port", type=int, default=8765)
    sp.add_argument("--host", default="127.0.0.1")
    sp.add_argument("--open", action="store_true", help="open a browser tab")
    sp.set_defaults(fn=cmd_serve)

    sp = sub.add_parser("export", help="write the web viewer as static files (for a static host)")
    sp.add_argument("dir", help="output directory, created if missing")
    sp.set_defaults(fn=cmd_export)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()

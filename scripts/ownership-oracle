# Claims that a test never refuses alone (§23.21 B: `returns`' AcOwn test
# stands in for an invariant): the copy without it must accept exactly the
# programs the checker does. `calibrate --claims` compares the counts.
CLAIMS = {
    "returns_param_acown": ("CSt::returns' AcOwn test at OParam never refuses a function whose signature is Sig::ok (§23.21 B)",
        [("checker.hthr", "OParam(i) => match s.role(l) { KHold(o, a) => o.same(i) && (match a { AcOwn => True, AcRead => False, AcWrite => False }), _ => False },",
          "OParam(i) => match s.role(l) { KHold(o, a) => o.same(i), _ => False },")]),
}


def mutant_dir(name):
    d = WORK / name
    d.mkdir(parents=True, exist_ok=True)
    shutil.copy(SEARCH, d / "oracle_search.hthr")
    texts = {"checker.hthr": (LIB / "checker.hthr").read_text()}
    for f, old, new in {**MUTANTS, **CLAIMS}[name][1]:
        if f not in texts:
            texts[f] = (LIB / f).read_text()
        n = texts[f].count(old)
        if n != 1:
            sys.exit(f"mutant {name}: `{old[:60]}…` occurs {n} times in {f}, not once (the checker moved: update the mutant)")
        texts[f] = texts[f].replace(old, new)
    for f, t in texts.items():
        (d / f).write_text(t)
    return d / "oracle_search.hthr"


def heather_eval(path, term, timeout=3600):
    cmd = [str(HEATHER), "eval", "--limits", "dev,cpu=3000", "--cache", "--limit", "4000000", str(path), term]
    r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True, timeout=timeout)
    out = r.stdout.strip()
    if r.returncode != 0 or not out.startswith("["):
        raise RuntimeError(f"`{term}` on {path}: exit {r.returncode}\n{r.stderr[-2000:]}\n{out[-500:]}")
    return [int(x) for x in out.strip("[]").replace("…", "").split(",") if x.strip()]


# --------------------------------------------------------------------------
# Decoding (oracle.hthr's `enc_*`)

class Rd:
    def __init__(self, xs):
        self.xs, self.i = xs, 0

    def n(self):
        x = self.xs[self.i]
        self.i += 1
        return x

    def many(self, f):
        return [f() for _ in range(self.n())]


SHAPES = {0: "Pt", 1: "L", 2: "QPt"}
MODES = {0: "take", 1: "read", 2: "write"}
CLAUSES = {1: "stuck", 2: "not done from its need", 3: "ReadAll (results against the meaning)", 4: "Value::Written",
           5: "Heap::Frame", 6: "Heap::Kept", 7: "Value::Views", 8: "Value::OwnedApart", 9: "the results coded"}


def shape(r):
    t = r.n()
    if t == 0:
        w = r.n()
        return "N" if w == 0 else f"u{r.n()}"
    return SHAPES.get(r.n(), "?")


def atom(r):
    t, v = r.n(), r.n()
    return str(v) if t == 0 else f"w{v}"


def step(r):
    t = r.n()
    if t == 0:
        return f".{'xy'[r.n()] if True else ''}"
    if t == 1:
        return f"[{atom(r)}]"
    if t == 2:
        lo = atom(r)
        return f"[{lo}..+{atom(r)}]"
    if t == 3:
        a = atom(r)
        return f"{{{a},{atom(r)}}}"
    return f"#{r.n()}"


def var(r):
    t, v = r.n(), r.n()
    return f"a{v}" if t == 0 else f"l{v}"


def place(r):
    v = var(r)
    return v + "".join(r.many(lambda: step(r)))


def stmt(r):
    t = r.n()
    if t == 0:
        o = "+-*"[r.n()]
        a = var(r)
        return f"{a} {o} {var(r)}"
    if t == 1:
        w = r.n()
        if w == 1:
            r.n()
        return f"lit {r.n()}"
    if t == 2:
        return f"read {place(r)}"
    if t == 3:
        p = place(r)
        return f"write {p} := {var(r)}"
    if t == 4:
        p = place(r)
        return f"view {p} to {'write' if r.n() else 'read'}"
    if t == 5:
        return f"take {place(r)}"
    if t == 6:
        c = shape(r)
        n = var(r)
        return f"fresh {c}({n} × {var(r)})"
    if t == 7:
        g = r.n()
        args = r.many(lambda: var(r))
        return f"call {CALLEES.get(g, f'f{g}')}({', '.join(args)}) binding {r.n()}"
    if t == 8:
        return f"death {place(r)}"
    if t == 9:
        p = place(r)
        return f"back {p} := {var(r)}"
    p = place(r)
    w = r.n()
    return f"len {p}" + (f" as u{r.n()}" if w == 1 else "")


def test(r):
    t = r.n()
    a = var(r)
    return f"{a} {'<' if t == 0 else '<='} {var(r)}"


def body(r, ind, binds):
    t = r.n()
    pad = "    " * ind
    if t in (0, 1, 4):
        xs = r.many(lambda: var(r))
        return [pad + {0: "ret", 1: "yield", 4: "jump"}[t] + f" [{', '.join(xs)}]"]
    if t == 2:
        s = stmt(r)
        return [pad + s] + body(r, ind, binds)
    tst = test(r)
    out = [pad + f"if {tst} {{"] + body(r, ind + 1, binds) + [pad + "} else {"] + body(r, ind + 1, binds) + [pad + "}"]
    return out + body(r, ind, binds)


def origin(r):
    t = r.n()
    if t == 0:
        return "fresh"
    if t == 1:
        return f"param {r.n()}"
    i = r.n()
    return f"view of {i}" + "".join(r.many(lambda: step(r)))


def func(r):
    ps = r.many(lambda: f"{shape(r)} {MODES[r.n()]}")
    rs = r.many(lambda: f"{shape(r)} {origin(r)}")
    head = f"fn ({', '.join(f'a{i}: {p}' for i, p in enumerate(ps))}) → ({', '.join(rs)})"
    return [head] + body(r, 1, 0)


def sel(r):
    t = r.n()
    if t == 0:
        return f".{'xy'[r.n()]}"
    if t in (1, 2):
        def ix():
            k = r.n()
            v = r.n() if k == 0 else (r.n(), r.n())[1]
            return str(v)
        if t == 1:
            return f"[{ix()}]"
        lo = ix()
        return f"[{lo}..+{ix()}]"
    if t == 3:
        return "{key}"
    return f"#{r.n()}"


def dyn(r, c):
    if c == "N":
        return str(r.n())
    if c in ("Pt", "QPt"):
        x = r.n()
        return f"{c}({x}, {r.n()})"
    if c == "L":
        return "[" + ", ".join(str(x) for x in r.many(r.n)) + "]"
    return "?"


def value(r):
    t = r.n()
    if t == 0:
        return dyn(r, shape(r))
    b = r.n()
    return f"&b{b}" + "".join(r.many(lambda: sel(r)))


def finding(r):
    c = r.n()
    fuel = r.n()
    f = func(r)
    vs = r.many(lambda: value(r))
    return c, fuel, f, vs


# oracle_search.hthr's `cat()`, at indices 1 to 8 (8 the primitive).
CALLEES = {0: "self", 1: "elem_view(L read, N take → N view of 0[a1])", 2: "front_view(L read → L view of 0[0..+1])",
           3: "set_elem(L write, N take)", 4: "set_x(Pt write, N take)", 5: "keep(L take → L param 0)",
           6: "make(N take, N take → L fresh)", 7: "get_y(Pt read → N fresh)", 8: "len(L read → N fresh, primitive)"}

HEAP = "b0 = Pt(1, 2), b1 = Pt(3, 4), b2 = L[1, 2], b3 = L[7], b4 = QPt(8, 9)"


def run_search(path, np, k, jobs, cap, fl=0, ka=0, kb=0):
    total = sum(N_PARAMS ** i for i in range(np + 1))
    chunk = max(1, total // (jobs * 3))
    parts = [(lo, min(chunk, total - lo)) for lo in range(0, total, chunk)]
    t0 = time.time()
    with ThreadPoolExecutor(jobs) as ex:
        res = list(ex.map(lambda p: heather_eval(path, f"search_stream({fl}, {np}, {k}, {ka}, {kb}, {p[0]}, {p[1]})"), parts))
    dt = time.time() - t0
    counts = [0] * 5
    found = []
    for xs in res:
        r = Rd(xs)
        while r.i < len(xs):
            counts[0] += 1
            for i in (1, 2, 3):
                counts[i] += r.n()
            fs = r.many(lambda: finding(r))
            counts[4] += len(fs)
            found += fs
    return counts, found, dt


GROUPS = ["wf", "agree", "sync", "cells", "apart", "likes", "heap"]
KINDS = {1: "op", 2: "lit", 4: "read", 8: "write", 16: "back", 32: "len", 64: "view-read", 128: "view-write", 256: "take",
         512: "fresh", 1024: "call", 2048: "call-prim", 4096: "death", 8192: "join", 16384: "jump", 32768: "ret-in-arm"}


def numbered(fr):
    """A function decoded with its body's nodes numbered in pre-order (oracle_walk's `Body::walk` labels)."""
    ps = fr.many(lambda: f"{shape(fr)} {MODES[fr.n()]}")
    rs = fr.many(lambda: f"{shape(fr)} {origin(fr)}")
    head = f"fn ({', '.join(f'a{i}: {p}' for i, p in enumerate(ps))}) → ({', '.join(rs)})"
    lines, labels, prev = [head], {}, {}
    ctr = [0]

    def go(ind, before):
        i = ctr[0]
        ctr[0] += 1
        prev[i] = before
        t = fr.n()
        pad = "    " * ind
        if t in (0, 1, 4):
            xs = fr.many(lambda: var(fr))
            txt = {0: "ret", 1: "yield", 4: "jump"}[t] + f" [{', '.join(xs)}]"
            lines.append(f"{i:>3} {pad}{txt}")
            labels[i] = txt
            return
        if t == 2:
            txt = stmt(fr)
            lines.append(f"{i:>3} {pad}{txt}")
            labels[i] = txt
            go(ind, i)
            return
        tst = test(fr)
        txt = f"if {tst}"
        lines.append(f"{i:>3} {pad}{txt} {{")
        labels[i] = txt
        go(ind + 1, i)
        lines.append(f"    {pad}}} else {{")
        go(ind + 1, i)
        lines.append(f"    {pad}}}")
        go(ind, i)

    go(1, None)
    return lines, labels, prev


def run_walk(path, ctl, np, k, jobs, fl=0, ka=0, kb=0, lo0=0, n0=None):
    total = sum(N_PARAMS ** i for i in range(np + 1))
    end = total if n0 is None else min(total, lo0 + n0)
    chunk = max(1, (end - lo0) // (jobs * 3))
    parts = [(lo, min(chunk, end - lo)) for lo in range(lo0, end, chunk)]
    t0 = time.time()
    with ThreadPoolExecutor(jobs) as ex:
        res = list(ex.map(lambda p: heather_eval(path, f"walk_stream({ctl}, {fl}, {np}, {k}, {ka}, {kb}, {p[0]}, {p[1]})"), parts))
    dt = time.time() - t0
    keys = ["programs", "tried", "owed", "walked", "states", "halted_run", "halted_join", "halted_checker", "byref", "byval", "failing_programs", "failing_inputs"]
    c = dict.fromkeys(keys, 0)
    kinds = {}
    fails = []
    for xs in res:
        r = Rd(xs)
        while r.i < len(xs):
            c["programs"] += 1
            for key in keys[1:10]:
                c[key] += r.n()
            for kd in set(r.many(r.n)):
                kinds[kd] = kinds.get(kd, 0) + 1
            if r.n():
                lines, labels, prev = numbered(r)
                fs = r.many(lambda: (r.n(), r.n(), r.n(), r.many(lambda: value(r))))
                c["failing_programs"] += 1
                c["failing_inputs"] += len(fs)
                fails.append((lines, labels, prev, fs))
    return c, kinds, fails, dt


def show_walk(c, kinds, fails, dt, cap):
    print(f"programs {c['programs']}, inputs tried {c['tried']}, walked {c['walked']}, states {c['states']}, "
          f"halted (run {c['halted_run']}, join {c['halted_join']}, checker {c['halted_checker']}), "
          f"walked inputs with a named value by reference {c['byref']}, by value {c['byval']}, "
          f"failing programs {c['failing_programs']}, failing inputs {c['failing_inputs']} ({dt:.1f}s)")
    print("statement kinds (programs holding each): " + ", ".join(f"{KINDS.get(kd, kd)} {n}" for kd, n in sorted(kinds.items())))
    fails = sorted(fails, key=lambda f: len(f[0]))
    for lines, labels, prev, fs in fails[:cap]:
        node, at, groups, vs = fs[0]
        gs = [g for b, g in enumerate(GROUPS) if groups >> b & 1]
        p = prev.get(node)
        after = "the entry state" if p is None else f"node {p} ({labels[p]})"
        print(f"\n-- {', '.join(gs)} false at state {at}, before node {node} ({labels[node]}), after {after}; "
              f"arguments ({', '.join(vs)}) over {HEAP}; {len(fs)} failing input(s)")
        print("\n".join(lines))


def show(counts, found, dt, cap):
    progs, tried, owed, due, nfound = counts
    print(f"checked programs {progs}, inputs tried {tried}, owed {owed}, verdict held {due}, findings {nfound} ({dt:.1f}s, {progs / dt:.0f} programs/s)")
    seen = set()
    for c, fuel, f, vs in found:
        key = "\n".join(f)
        if key in seen:
            continue
        seen.add(key)
        print(f"\n-- breaks {CLAUSES.get(c, c)} at fuel {fuel}, arguments ({', '.join(vs)}) over {HEAP}")
        print("\n".join(f))
        if len(seen) >= cap:
            break


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("search")
    s.add_argument("--np", type=int, default=1)
    s.add_argument("--k", type=int, default=2)
    s.add_argument("--mutant")
    s.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
    s.add_argument("--cap", type=int, default=3)
    s.add_argument("--flags", type=int, default=0, help="bits: 1 calls, 2 joins, 4 Jump, 8 signatures fixed first (arms may return)")
    s.add_argument("--ka", type=int, default=1, help="a join's yes arm: at most this many statements")
    s.add_argument("--kb", type=int, default=0, help="a join's no arm")
    c = sub.add_parser("calibrate")
    c.add_argument("--only")
    c.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
    c.add_argument("--claims", action="store_true", help="check the claims instead: each copy accepts what the checker does")
    sub.add_parser("mutants")
    w = sub.add_parser("walk")
    w.add_argument("--np", type=int, default=1)
    w.add_argument("--k", type=int, default=1)
    w.add_argument("--flags", type=int, default=0)
    w.add_argument("--ka", type=int, default=1)
    w.add_argument("--kb", type=int, default=0)
    w.add_argument("--control", type=int, default=0, help="0 the invariant; 1 agreement whole; 2 sync of every entry to write; 3 a grown entry heap")
    w.add_argument("--jobs", type=int, default=os.cpu_count() or 4)
    w.add_argument("--cap", type=int, default=3)
    w.add_argument("--lo", type=int, default=0, help="the first parameter list (in `gen_param_lists` order) walked")
    w.add_argument("--n", type=int, help="how many parameter lists from --lo")
    a = ap.parse_args()
    if not HEATHER.exists():
        sys.exit("build the release binary first: cargo build --release -p heather-cli --bin heather")
    if a.cmd == "mutants":
        for n, (why, _) in MUTANTS.items():
            print(f"{n}: {why}")
        for n, (why, _) in CLAIMS.items():
            print(f"(claim) {n}: {why}")
        return
    if a.cmd == "walk":
        c, kinds, fails, dt = run_walk(WALK, a.control, a.np, a.k, a.jobs, a.flags, a.ka, a.kb, a.lo, a.n)
        show_walk(c, kinds, fails, dt, a.cap)
        sys.exit(1 if fails and not a.control else 0)
    if a.cmd == "search":
        path = mutant_dir(a.mutant) if a.mutant else SEARCH
        counts, found, dt = run_search(path, a.np, a.k, a.jobs, a.cap, a.flags, a.ka, a.kb)
        show(counts, found, dt, a.cap)
        sys.exit(1 if counts[4] and not a.mutant else 0)
    if a.cmd == "calibrate" and a.claims:
        bad = []
        for n, (why, _) in CLAIMS.items():
            path = mutant_dir(n)
            for np, k, fl in SIZES:
                real, _, _ = run_search(SEARCH, np, k, a.jobs, 0, fl, 1, 0)
                alt, _, _ = run_search(path, np, k, a.jobs, 0, fl, 1, 0)
                same = real[0] == alt[0]
                print(f"{n} at ({np}, {k}, flags {fl}): checker accepts {real[0]}, without the test {alt[0]}{'' if same else '  <- the claim fails'}", flush=True)
                if not same:
                    bad.append(n)
                    break
        sys.exit(1 if bad else 0)
    if a.cmd == "calibrate":
        names = [a.only] if a.only else list(MUTANTS)
        missed = []
        print("| mutant | found at (params, items, flags) | programs checked at that size | findings | first |")
        print("|---|---|---|---|---|")
        for n in names:
            path = mutant_dir(n)
            hit = None
            for np, k, fl in SIZES:
                counts, found, dt = run_search(path, np, k, a.jobs, 1, fl, 1, 0)
                if counts[4]:
                    hit = (np, k, fl, counts, found)
                    break
            if hit:
                np, k, fl, counts, found = hit
                c, fuel, f, vs = found[0]
                print(f"| {n} | ({np}, {k}, flags {fl}) | {counts[0]} | {counts[4]} | {CLAUSES.get(c, c)}: `{' ; '.join(x.strip() for x in f)}` at ({', '.join(vs)}) |", flush=True)
            else:
                print(f"| {n} | missed | | |", flush=True)
                missed.append(n)
        sys.exit(1 if missed else 0)


if __name__ == "__main__":
    main()

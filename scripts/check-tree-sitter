#!/usr/bin/env bash
# Verify the generated parser, shared fixtures, queries, and lexical drift.
set -euo pipefail
cd "$(dirname "$0")/.."

grammar=tree-sitter-heather
cli="$grammar/node_modules/.bin/tree-sitter"

if [[ ! -x "$cli" ]]; then
  echo "error: $cli is missing; run 'npm install' in $grammar" >&2
  exit 2
fi

node scripts/check-tree-sitter-inventory.js

for query in highlights brackets indents outline textobjects; do
  cmp "$grammar/queries/$query.scm" "editors/zed/languages/heather/$query.scm"
done

(
  cd "$grammar"
  "$OLDPWD/$cli" generate
  XDG_CACHE_HOME="${TMPDIR:-/tmp}/heather-tree-sitter-cache" \
    "$OLDPWD/$cli" test
  XDG_CACHE_HOME="${TMPDIR:-/tmp}/heather-tree-sitter-cache" \
    "$OLDPWD/$cli" parse test/fixtures/positive/*.hthr --quiet
  XDG_CACHE_HOME="${TMPDIR:-/tmp}/heather-tree-sitter-cache" \
    "$OLDPWD/$cli" parse ../docs/showcase/calc.hthr --quiet
  rg --files ../lib ../crates -g '*.hthr' |
    XDG_CACHE_HOME="${TMPDIR:-/tmp}/heather-tree-sitter-cache" \
      "$OLDPWD/$cli" parse --paths /dev/stdin --quiet
  for query in queries/*.scm; do
    XDG_CACHE_HOME="${TMPDIR:-/tmp}/heather-tree-sitter-cache" \
      "$OLDPWD/$cli" query "$query" test/fixtures/positive/basic.hthr >/dev/null
  done
)

cargo test -p heather-syntax --test editor_corpus --quiet

# A developer who has installed the Zed dev extension has a *snapshot* of the
# grammar under editors/zed/.dev, while its queries are symlinked live. A
# grammar node added here and referenced from a query therefore breaks
# highlighting silently until the snapshot is refreshed by hand — which is how
# `decreases` dark-loaded the extension for two weeks. Refresh it here, so the
# check the README already tells you to run keeps the snapshot honest. Zed
# still needs a **Rebuild** on the extension to recompile the new revision.
if [[ -d editors/zed/.dev ]]; then
  scripts/zed-dev-extension
fi

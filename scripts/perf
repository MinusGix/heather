#!/usr/bin/env python3
"""Perf snapshots and the dashboard that reads them.

Where the numbers in a round come from is one question (`scripts/bench --check`,
`issues/perf-tracking-consistent-environment.md`); *what is slow right now, and
where it comes from* is another, and it had no answer that did not start with
"re-measure first". This script owns the second question.

    scripts/perf snapshot [--corpus quick|full] [--env NAME] ...   # measure, write perf/snapshots/<stamp>-<env>.json
    scripts/perf report [SNAPSHOT] [--against prev|SNAPSHOT]       # what is slow, where it comes from, what moved
    scripts/perf list                                              # snapshots on record
    scripts/perf serve [--port N] [--open]                         # the dashboard (scripts/perf-web.html)
    scripts/perf ab [--base REV | --patch FILE] [--marker COL] [--samples N]  # is this change faster? did anything else move?
    scripts/perf ab --source-patch FILE [--samples N]              # the same question for a change to lib/ or a showcase: one binary, two source trees

A snapshot records three things, each keyed by the environment that produced
it (`local` is the desktop, `furnace` the cloud box; they differ by a roughly
uniform constant, so a family that departs from that constant is the signal):

  1. the suite: the latest run per lane of `target/test-target-timings-<lane>.tsv`
     (written by scripts/test), so the slow test binaries are on record;
  2. the corpus: each file checked three ways through the release CLI —
     **cold** (an empty cache: every module elaborated and gated), **warm**
     (nothing changed: every module replayed from its image), and **edit**
     (one trivial declaration appended: imports replayed, the root
     re-elaborated with the declaration cache) — each with `--timings`, so a
     wall number always has its phase split beside it;
  3. the attribution: from those `--timings` tables, the run row's every
     phase and counter, the module rows, and the heaviest declarations.

The numbers are a dated diary (docs carry shape claims, not numbers —
`issues/perf-tracking-consistent-environment.md` 2026-08-12). Counts (queries,
misses, steps) are exact on one tree and comparable across machines; seconds
are not, and are read against the same environment only.

Stdlib only, like `scripts/issue` and `scripts/timings`.
"""

import argparse
import json
import os
import platform
import resource
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from contextlib import nullcontext
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SNAPSHOTS = ROOT / "perf" / "snapshots"
WEB = ROOT / "scripts" / "perf-web.html"
SCHEMA = 1

def showcase(name):
    """One corpus entry for a showcase, with its `-L` dirs from the manifest.

    `docs/showcase/showcases.tsv` is the single source of truth for which
    showcase is checked against what; this corpus used to carry its own copy,
    which is three copies of one list counting the two test harnesses
    (issues/showcase-harness.md). A file resolves imports beside itself first,
    then the `-L` dirs — which is why no showcase gets `docs/showcase` on its
    path (its own `parser_core` would clash with the library's).
    """
    manifest = ROOT / "docs" / "showcase" / "showcases.tsv"
    for line in manifest.read_text().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        row, search, _tier, _note = (c.strip() for c in line.split("\t"))
        if row == name:
            return (f"docs/showcase/{name}.hthr", [] if search == "-" else search.split(","))
    sys.exit(f"error: no `{name}` row in {manifest}")


# The corpus: (path, search dirs). `quick` is the inner-loop set; `full` is
# everything the CLI can check by path. The x86 arch modules are named by
# the tests, not by their stems, so they are checked here under their stems.
CORPUS = {
    "quick": [
        ("lib/std/omega.hthr", []),
        ("lib/std/nat.hthr", []),
        showcase("calc_parser"),
    ],
    "full": [
        ("lib/std/omega.hthr", []),
        ("lib/std/nat.hthr", []),
        ("lib/std/int.hthr", []),
        ("lib/std/list.hthr", []),
        ("lib/std/bitvec.hthr", []),
        ("lib/std/algebra.hthr", []),
        showcase("calc_parser"),
        ("lib/ir_v1.hthr", ["lib/std"]),
        ("lib/function_ir.hthr", ["lib/std"]),
        ("lib/std/arch/x86_64/model.hthr", ["lib/std"]),
        # lib/certgen_code.hthr is not in the corpus: it has no imports and
        # elaborates only after a test-only support prelude and ir_v1 in
        # process (crates/elab/tests/certgen_cert.rs), so the CLI refuses it
        # with 83 errors on any machine (2026-09-17). Its cost is the
        # certgen_* rows of the suite section.
    ],
}

# What the edit mode appends: a declaration that needs no import and costs
# nothing to check, so the run measures the module's re-elaboration and not
# the probe.
EDIT_PROBE = "\n\nfn perf_probe_edit<A>(a: A) → A { a }\n"

# The item columns a snapshot keeps per heavy declaration. Everything else on
# an item row is in the raw TSV the snapshot points at.
ITEM_KEEP = ["total_ns", "kernel_gate_ns", "decl_type_ns", "decl_body_ns", "decl_emit_ns",
             "elab_whnf_ns", "diag_note_ns", "lower_ns", "conv_misses", "eval_steps",
             "conv_shortcut_hits", "conv_memo_hits", "shift_global_nodes", "delta_body_rescopes",
             "global_ref_rescopes"]
# Items whose kernel gate costs this many times the file's median per
# evaluator step are listed on their own: their seconds are in what a step
# touches, not in how many there are (issues/refl-theorem-step-cost.md —
# fourteen refl theorems at a hundred times the ordinary step, invisible in
# a table sorted by total).
OUTLIER_FACTOR = 10
OUTLIER_MIN_STEPS = 100
TOP_ITEMS = 25


def now_stamp():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sh(*cmd, default=""):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT, check=False).stdout.strip() or default
    except OSError:
        return default


def guess_source():
    if str(ROOT).startswith("/work"):
        return "furnace"
    if socket.gethostname() == "minus-desktop":
        return "local"
    return socket.gethostname()


def cpu_model():
    try:
        for line in Path("/proc/cpuinfo").read_text().splitlines():
            if line.startswith("model name"):
                return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return platform.processor() or "unknown"


def environment(args):
    workers = args.kernel_workers or 1
    try:
        load = [float(x) for x in Path("/proc/loadavg").read_text().split()[:3]]
    except (OSError, ValueError):
        load = []
    return {
        "source": args.env or guess_source(),
        "host": socket.gethostname(),
        "cpu": cpu_model(),
        "nproc": os.cpu_count(),
        "rustc": sh("rustc", "--version"),
        "profile": "release",
        "kernel_workers": workers,
        "wait_workers": args.wait_workers,
        "loadavg": load,
    }


# ---------------------------------------------------------------- suite

def target_dir():
    return Path(os.environ.get("CARGO_TARGET_DIR", ROOT / "target"))


def suite_history_dirs():
    """Where scripts/test's history may be: this checkout's target dir, and —
    from a worktree — the main checkout's, which is where the suite usually
    ran. A worktree's own `target/` is normally a fresh build with no history."""
    dirs = [target_dir()]
    common = sh("git", "rev-parse", "--git-common-dir")
    if common:
        main = (ROOT / common).resolve().parent / "target"
        if main not in dirs:
            dirs.append(main)
    return dirs


def suite_timings():
    """Latest run per lane of the runner's append-only history. Rows are
    `run\\tseconds\\tlabel\\tcpu` (cpu = user+sys seconds, empty when the
    wrapper could not report it; absent before 2026-09-17); rows from before
    the run column (`seconds\\tlabel`) count as one undated run."""
    out = {}
    for lane in ("full", "fast"):
        path = next((d / f"test-target-timings-{lane}.tsv" for d in suite_history_dirs()
                     if (d / f"test-target-timings-{lane}.tsv").is_file()), None)
        if path is None:
            continue
        runs = {}
        for line in path.read_text().splitlines():
            cells = line.split("\t")
            cpu = None
            if len(cells) == 4:
                run, secs, label, cpu = cells
            elif len(cells) == 3:
                run, secs, label = cells
            elif len(cells) == 2:
                run, (secs, label) = "undated", cells
            else:
                continue
            try:
                runs.setdefault(run, []).append([label, float(secs), float(cpu) if cpu else None])
            except ValueError:
                continue
        if not runs:
            continue
        dated = [k for k in runs if k != "undated"]
        latest = max(dated) if dated else "undated"
        # Undated rows are several runs on top of each other: the last row
        # per target is the latest run's.
        by_label = {label: (secs, cpu) for label, secs, cpu in runs[latest]}
        targets = sorted(([l, s, c] for l, (s, c) in by_label.items()), key=lambda r: -r[1])
        cpus = [c for _, _, c in targets if c is not None]
        out[lane] = {
            "run": latest,
            "runs_on_file": len(runs),
            "targets": targets,
            "sum_s": round(sum(s for _, s, _ in targets), 2),
            "cpu_sum_s": round(sum(cpus), 2) if cpus else None,
            "source": str(path),
            "note": "seconds per test binary at kernel width one under the suite's parallel scheduler; "
                    "the third cell is the binary's CPU seconds (user+sys) against the runner's 300 s rail",
        }
    return out


# ---------------------------------------------------------------- corpus

class Timings:
    """A `--timings` TSV by column name (the reader discipline of scripts/timings)."""

    def __init__(self, path: Path):
        lines = path.read_text().splitlines()
        self.columns = lines[0].split("\t")
        self.rows = [l.split("\t") for l in lines[1:]]
        self.rows = [r for r in self.rows if len(r) == len(self.columns)]
        self.ix = {c: i for i, c in enumerate(self.columns)}

    def cell(self, row, col):
        raw = row[self.ix[col]].strip() if col in self.ix else ""
        return int(raw) if raw.lstrip("-").isdigit() else 0

    def scoped(self, kind):
        i = self.ix["scope"]
        return [r for r in self.rows if r[i] == kind]

    def numeric_columns(self):
        return [c for c in self.columns if c not in ("scope", "module", "item")]

    def name(self, row):
        m, i = row[self.ix["module"]], row[self.ix["item"]]
        return f"{m}::{i}" if m and i else (i or m)


def summarize(tsv: Path):
    t = Timings(tsv)
    runs = t.scoped("run")
    run = {c: t.cell(runs[0], c) for c in t.numeric_columns()} if runs else {}
    modules = []
    items = t.scoped("item")
    per_module = {}
    for r in items:
        per_module[r[t.ix["module"]]] = per_module.get(r[t.ix["module"]], 0) + 1
    for r in t.scoped("module"):
        name = r[t.ix["module"]]
        modules.append({
            "name": name,
            "total_ns": t.cell(r, "total_ns"),
            "kernel_gate_ns": t.cell(r, "kernel_gate_ns"),
            "image_decode_ns": t.cell(r, "image_decode_ns"),
            "image_recheck_ns": t.cell(r, "image_recheck_ns"),
            "image_publish_ns": t.cell(r, "image_publish_ns"),
            "items": per_module.get(name, 0),
        })
    totals = sorted(t.cell(r, "total_ns") for r in items)
    top = sorted(items, key=lambda r: -t.cell(r, "total_ns"))[:TOP_ITEMS]
    # Gate nanoseconds per evaluator step, over every item that stepped at
    # least OUTLIER_MIN_STEPS times (a three-step item's ratio is noise): the
    # median is the file's ordinary step, and `outliers` keeps the items
    # farthest above it whether or not their totals reach `top`.
    stepped = [r for r in items if t.cell(r, "eval_steps") >= OUTLIER_MIN_STEPS]
    per_step = sorted(t.cell(r, "kernel_gate_ns") / t.cell(r, "eval_steps") for r in stepped)
    median = per_step[len(per_step) // 2] if per_step else 0
    outliers = sorted(stepped, key=lambda r: -t.cell(r, "kernel_gate_ns") / t.cell(r, "eval_steps"))[:TOP_ITEMS]

    def pct(p):
        return totals[min(len(totals) - 1, int(len(totals) * p))] if totals else 0

    return {
        "run": run,
        "modules": modules,
        "items": {
            "count": len(totals),
            "sum_total_ns": sum(totals),
            "p50_total_ns": pct(0.5),
            "p90_total_ns": pct(0.9),
            "max_total_ns": totals[-1] if totals else 0,
            "top": [dict(name=t.name(r), **{c: t.cell(r, c) for c in ITEM_KEEP}) for r in top],
            "per_step_median_ns": median,
            "outliers": [dict(name=t.name(r), **{c: t.cell(r, c) for c in ITEM_KEEP}) for r in outliers],
        },
    }


def run_check(args, heather: Path, file: str, search, cache: Path, tsv: Path, workers: int):
    """One capped release `heather check`; wall, CPU and peak RSS from wait4."""
    cmd = [str(heather), "check"]
    for d in search:
        cmd += ["-L", d]
    cmd += ["--cache-dir", str(cache), "--kernel-workers", str(workers), "--timings", str(tsv), file]

    def limits():
        resource.setrlimit(resource.RLIMIT_AS, (args.mem_gib << 30, args.mem_gib << 30))
        resource.setrlimit(resource.RLIMIT_CPU, (args.cpu_secs, args.cpu_secs))

    env = dict(os.environ)
    env.pop("HEATHER_TIMINGS", None)
    t0 = time.perf_counter()
    p = subprocess.Popen(cmd, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, preexec_fn=limits, env=env)
    output = p.stdout.read()
    _, status, ru = os.wait4(p.pid, 0)
    p.returncode = os.waitstatus_to_exitcode(status)
    wall = time.perf_counter() - t0
    lines = [l for l in output.splitlines() if l.strip()]
    summary = next((l for l in reversed(lines) if ": ok" in l or "error" in l.lower()), lines[-1] if lines else "")
    mode = {
        "wall_s": round(wall, 3),
        "cpu_s": round(ru.ru_utime + ru.ru_stime, 3),
        "max_rss_mb": round(ru.ru_maxrss / 1024, 1),
        "exit": p.returncode,
        "summary": summary[:300],
    }
    if p.returncode == 0 and tsv.is_file():
        mode.update(summarize(tsv))
    else:
        mode["output_tail"] = lines[-8:]
    return mode


def measure_file(args, heather, file, search, raw_dir: Path):
    path = ROOT / file
    stem = path.stem
    cache = Path(tempfile.mkdtemp(prefix=f"heather-perf-{stem}-"))
    entry = {"path": file, "search": search}
    original = path.read_bytes()
    try:
        # `wait` is the cold check at the CLI's default gate width — the
        # number a person sits through. The three attributed modes run at
        # width one, where the run row's phases are honest (a worker's gate
        # time is not on the main thread's clock) and comparable with the
        # suite's width-one timings. `wait` goes first so that the cold
        # run publishes into an empty cache too.
        modes = [("wait", args.wait_workers), ("cold", args.kernel_workers_effective),
                 ("warm", args.kernel_workers_effective), ("edit", args.kernel_workers_effective)]
        if args.wait_workers == args.kernel_workers_effective:
            modes = modes[1:]
        for mode, workers in modes:
            if mode == "edit":
                path.write_bytes(original + EDIT_PROBE.encode())
            if mode == "cold":
                shutil.rmtree(cache, ignore_errors=True)
                cache.mkdir()
            tsv = raw_dir / f"{stem}-{mode}.tsv"
            print(f"  {file} {mode} (width {workers}) …", end="", flush=True)
            entry[mode] = run_check(args, heather, file, search, cache, tsv, workers)
            entry[mode]["kernel_workers"] = workers
            entry[mode]["raw"] = str(tsv.relative_to(ROOT)) if tsv.is_relative_to(ROOT) else str(tsv)
            m = entry[mode]
            print(f" {m['wall_s']:.2f}s wall, {m['cpu_s']:.1f}s cpu, {m['max_rss_mb']:.0f} MB"
                  + ("" if m["exit"] == 0 else f"  EXIT {m['exit']}: {m['summary']}"), flush=True)
            if mode == "edit":
                path.write_bytes(original)
    finally:
        path.write_bytes(original)
        shutil.rmtree(cache, ignore_errors=True)
    return entry


def find_heather(args):
    if args.heather:
        return Path(args.heather)
    p = target_dir() / "release" / "heather"
    if not p.is_file():
        sys.exit(f"error: no release binary at {p}; build with `cargo build --release -p heather-cli` "
                 f"(outside any ulimit — mold needs the address space) or pass --heather")
    return p


def cmd_snapshot(args):
    heather = find_heather(args)
    env = environment(args)
    args.kernel_workers_effective = env["kernel_workers"]
    if args.no_wait:
        args.wait_workers = env["kernel_workers"]
    stamp = now_stamp()
    snap = {
        "schema": SCHEMA,
        "stamp": stamp,
        "label": args.label or "",
        "commit": sh("git", "rev-parse", "--short", "HEAD"),
        "commit_full": sh("git", "rev-parse", "HEAD"),
        "dirty": bool(sh("git", "status", "--porcelain", "--untracked-files=no")),
        "env": env,
        "tests": {} if args.no_tests else suite_timings(),
        "files": [],
    }
    print(f"snapshot {stamp} env={env['source']} host={env['host']} commit={snap['commit']}"
          f"{' (dirty)' if snap['dirty'] else ''} workers={env['kernel_workers']} load={env['loadavg']}")
    for lane, t in snap["tests"].items():
        print(f"  suite {lane}: run {t['run']}, {len(t['targets'])} targets, {t['sum_s']:.0f}s summed")
    if not args.no_files:
        corpus = list(CORPUS[args.corpus])
        for spec in args.file or []:
            path, _, dirs = spec.partition(":")
            corpus.append((path, [d for d in dirs.split(",") if d]))
        if args.only:
            corpus = [c for c in corpus if any(o in c[0] for o in args.only)]
        raw_dir = target_dir() / "perf" / stamp.replace(":", "")
        raw_dir.mkdir(parents=True, exist_ok=True)
        for file, search in corpus:
            snap["files"].append(measure_file(args, heather, file, search, raw_dir))
    SNAPSHOTS.mkdir(parents=True, exist_ok=True)
    out = SNAPSHOTS / f"{stamp.replace(':', '')}-{env['source']}.json"
    out.write_text(json.dumps(snap, indent=1) + "\n")
    print(f"wrote {out.relative_to(ROOT)}")
    args.snapshot = out.name
    args.against = "prev"
    args.top = 10
    cmd_report(args)


# ---------------------------------------------------------------- report

def load_all():
    snaps = []
    for p in sorted(SNAPSHOTS.glob("*.json")):
        try:
            s = json.loads(p.read_text())
        except json.JSONDecodeError as e:
            print(f"warning: {p}: {e}", file=sys.stderr)
            continue
        s["_path"] = p
        snaps.append(s)
    return snaps


def pick(snaps, spec):
    if not snaps:
        sys.exit("error: no snapshots in perf/snapshots; run `scripts/perf snapshot`")
    if not spec or spec == "latest":
        return snaps[-1]
    for s in reversed(snaps):
        if spec in s["_path"].name or spec == s["stamp"] or spec == s.get("commit"):
            return s
    sys.exit(f"error: no snapshot matches {spec}")


def previous(snaps, snap):
    """The snapshot before `snap` from the same environment: seconds compare
    only within one environment."""
    before = [s for s in snaps if s["stamp"] < snap["stamp"] and s["env"]["source"] == snap["env"]["source"]]
    return before[-1] if before else None


def secs(ns):
    return ns / 1e9


def fmt_s(v):
    return f"{v:7.2f}s"


def delta(a, b, is_time):
    if a is None or b is None or a == 0:
        return ""
    d = (b - a) / a * 100
    # Seconds repeat to a few percent on one box; counts are exact.
    if is_time and abs(d) < 10:
        return "   ≈"
    return f"{d:+5.0f}%"


def phase_totals(snap, mode="cold"):
    """Self-time per phase summed over the corpus' run rows. `other_ns` is
    the run row's own unattributed remainder."""
    tot = {}
    for f in snap["files"]:
        run = f.get(mode, {}).get("run") or {}
        for c, v in run.items():
            if c.endswith("_ns") and c != "total_ns":
                tot[c] = tot.get(c, 0) + v
    return dict(sorted(tot.items(), key=lambda kv: -kv[1]))


def cmd_report(args):
    snaps = load_all()
    snap = pick(snaps, getattr(args, "snapshot", None))
    against = None
    if getattr(args, "against", None):
        against = previous(snaps, snap) if args.against == "prev" else pick(snaps, args.against)
    e = snap["env"]
    print(f"== {snap['stamp']}  {e['source']}  {e['host']}  {e['cpu']}  {e['nproc']} cpus  "
          f"workers {e['kernel_workers']}  commit {snap['commit']}{' (dirty)' if snap['dirty'] else ''}"
          f"{'  ' + snap['label'] if snap.get('label') else ''}")
    if against:
        print(f"   against {against['stamp']}  {against['env']['source']}  commit {against['commit']}")
    top = args.top

    # --- suite
    for lane, t in snap.get("tests", {}).items():
        cpu_sum = t.get("cpu_sum_s")
        cpu_note = f", {cpu_sum:.0f} CPU-s" if cpu_sum is not None else ""
        print(f"\n-- suite ({lane} lane, run {t['run']}): {len(t['targets'])} targets, "
              f"{t['sum_s']:.0f}s summed at width one{cpu_note}")
        prev = {}
        if against and lane in against.get("tests", {}):
            prev = {row[0]: row[1] for row in against["tests"][lane]["targets"]}
        # Rows are [label, seconds] before 2026-09-17 and [label, seconds, cpu] after.
        for row in t["targets"][:top]:
            label, s = row[0], row[1]
            cpu = row[2] if len(row) > 2 else None
            cpu_cell = f"{cpu:7.1f} CPU-s" if cpu is not None else " " * 13
            print(f"   {fmt_s(s)} {delta(prev.get(label), s, True):>6} {cpu_cell}  {label}")
        rest = t["targets"][top:]
        if rest:
            print(f"   {fmt_s(sum(row[1] for row in rest))}                       … {len(rest)} more")

    # --- files
    if snap["files"]:
        print(f"\n-- corpus: wall seconds through the release CLI (wait = cold at width {e.get('wait_workers', '?')}; "
              f"at width {e['kernel_workers']}: cold = empty cache, warm = images replayed, edit = one declaration appended)")
        print(f"   {'file':34} {'wait':>7} {'cold':>8} {'':>6} {'warm':>8} {'edit':>8} {'':>6} | {'gate%':>5} {'decls':>5} "
              f"{'misses':>8} {'':>6} {'queries':>10} {'steps':>10} {'rescope':>11} {'rss MB':>7}")
        prev_files = {f["path"]: f for f in (against or {}).get("files", [])}
        for f in snap["files"]:
            c, w, ed = f.get("cold", {}), f.get("warm", {}), f.get("edit", {})
            pf = prev_files.get(f["path"], {})
            run = c.get("run", {})
            q = run.get("conv_shortcut_hits", 0) + run.get("conv_memo_hits", 0) + run.get("conv_misses", 0)
            prun = pf.get("cold", {}).get("run", {})
            pq = prun.get("conv_shortcut_hits", 0) + prun.get("conv_memo_hits", 0) + prun.get("conv_misses", 0)
            gate = run.get("kernel_gate_ns", 0) / max(run.get("total_ns", 1), 1) * 100
            bad = "".join(f"  {m} EXIT {f[m]['exit']}" for m in ("cold", "warm", "edit") if f.get(m, {}).get("exit", 0) != 0)
            wait = f.get("wait", {}).get("wall_s")
            print(f"   {f['path']:34} {wait if wait is not None else float('nan'):7.2f} {c.get('wall_s', 0):8.2f} {delta(pf.get('cold', {}).get('wall_s'), c.get('wall_s'), True):>6} "
                  f"{w.get('wall_s', 0):8.2f} {ed.get('wall_s', 0):8.2f} {delta(pf.get('edit', {}).get('wall_s'), ed.get('wall_s'), True):>6} | "
                  f"{gate:5.0f} {c.get('items', {}).get('count', 0):5d} {run.get('conv_misses', 0):8,d} "
                  f"{delta(prun.get('conv_misses'), run.get('conv_misses'), False):>6} {q:10,d} {run.get('eval_steps', 0):10,d} "
                  f"{run.get('shift_global_nodes', 0):11,d} {c.get('max_rss_mb', 0):7.0f}{bad}")

        # --- phases
        tot = phase_totals(snap)
        total = sum(tot.values()) or 1
        print("\n-- where cold time goes (self time per phase, summed over the corpus' run rows)")
        line = []
        for c, v in tot.items():
            if v / total < 0.005:
                break
            line.append(f"{c[:-3]} {v / total * 100:.0f}%")
        print("   " + ", ".join(line))
        # Per file, the phases that do not fit the gate story.
        print("   per file, the largest non-gate phase:")
        for f in snap["files"]:
            run = f.get("cold", {}).get("run") or {}
            phases = sorted(((c, v) for c, v in run.items() if c.endswith("_ns") and c not in ("total_ns", "kernel_gate_ns")),
                            key=lambda kv: -kv[1])
            if phases and run.get("total_ns"):
                c, v = phases[0]
                print(f"   {f['path']:34} {c[:-3]:14} {v / run['total_ns'] * 100:4.0f}% of {secs(run['total_ns']):.1f}s")

        # --- concentration and heaviest declarations
        print("\n-- concentration: how much of a file is its heaviest declaration (cold, item total)")
        for f in snap["files"]:
            it = f.get("cold", {}).get("items")
            if not it or not it["count"]:
                continue
            top5 = sum(i["total_ns"] for i in it["top"][:5])
            print(f"   {f['path']:34} top1 {it['max_total_ns'] / max(it['sum_total_ns'], 1) * 100:3.0f}%  "
                  f"top5 {top5 / max(it['sum_total_ns'], 1) * 100:3.0f}%  p50 {it['p50_total_ns'] / 1e6:7.1f}ms  "
                  f"p90 {it['p90_total_ns'] / 1e6:7.1f}ms  max {it['max_total_ns'] / 1e6:8.1f}ms  ({it['count']} items)")
        # A module in two closures (omega under omega and under calc_parser)
        # has its items twice; the first, largest reading stands for it.
        allitems, seen = [], set()
        for f in snap["files"]:
            for i in f.get("cold", {}).get("items", {}).get("top", []):
                allitems.append((f["path"], i))
        allitems.sort(key=lambda fi: -fi[1]["total_ns"])
        allitems = [fi for fi in allitems if not (fi[1]["name"] in seen or seen.add(fi[1]["name"]))]
        print(f"\n-- heaviest declarations across the corpus (cold; ms, gate share, misses, steps, gate µs per step, "
              f"nodes rescoped by shift_global; one reading per declaration)")
        for path, i in allitems[:top]:
            print(f"   {item_line(i)}  {Path(path).stem}: {i['name']}")

        # --- per-step outliers: the family a total-sorted table hides
        print(f"\n-- per-step outliers: gate µs per evaluator step at least {OUTLIER_FACTOR}× the file's median "
              f"(what each step touches, not how many; rescope = nodes copied rescoping globals)")
        found = False
        for f in snap["files"]:
            it = f.get("cold", {}).get("items", {})
            # Snapshots before 2026-09-18 kept no outlier list; fall back to
            # the top-by-total items, whose median is then a heavy one.
            rows = [i for i in it.get("outliers", it.get("top", [])) if i.get("eval_steps", 0) >= OUTLIER_MIN_STEPS]
            if not rows:
                continue
            median = it.get("per_step_median_ns") or sorted(i["kernel_gate_ns"] / i["eval_steps"] for i in rows)[len(rows) // 2]
            for i in sorted(rows, key=lambda i: -i["kernel_gate_ns"] / i["eval_steps"]):
                if i["kernel_gate_ns"] / i["eval_steps"] < OUTLIER_FACTOR * median:
                    break
                found = True
                print(f"   {item_line(i)}  {Path(f['path']).stem}: {i['name']}   (file median {median / 1e3:.1f} µs/step)")
        if not found:
            print("   none among the kept items")
    print()


def item_line(i):
    """One heaviest-declaration row: total, gate share, the largest
    elaborator phase, misses, steps, gate µs per step, rescoped nodes. Keys a
    snapshot predates read as zero."""
    gate = i["kernel_gate_ns"] / max(i["total_ns"], 1) * 100
    phases = ("decl_body_ns", "decl_type_ns", "decl_emit_ns", "elab_whnf_ns", "lower_ns")
    elab_name = max(phases, key=lambda k: i.get(k, 0))
    elab = i.get(elab_name, 0)
    steps = i.get("eval_steps", 0)
    per_step = i["kernel_gate_ns"] / steps / 1e3 if steps else float("nan")
    return (f"{i['total_ns'] / 1e6:9.1f}ms  gate {gate:3.0f}%  {elab_name[:-3]:9} {elab / max(i['total_ns'], 1) * 100:3.0f}%  "
            f"misses {i.get('conv_misses', 0):7,d}  steps {steps:10,d}  {per_step:7.1f} µs/step  "
            f"rescope {i.get('shift_global_nodes', 0):11,d}")


def cmd_list(args):
    for s in load_all():
        e = s["env"]
        files = ", ".join(Path(f["path"]).stem for f in s["files"])
        lanes = "/".join(s.get("tests", {}).keys()) or "-"
        print(f"{s['stamp']}  {e['source']:8} {s['commit']:8} {'dirty' if s['dirty'] else '     '}  "
              f"suite {lanes:9} files {len(s['files']):2d}  {files[:60]}{'  ' + s['label'] if s.get('label') else ''}")


def cmd_serve(args):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    def payload():
        snaps = load_all()
        for s in snaps:
            s["_path"] = s["_path"].name
        return json.dumps(snaps).encode()

    class Handler(BaseHTTPRequestHandler):
        def send(self, body, ctype):
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path in ("/", "/index.html"):
                self.send(WEB.read_bytes(), "text/html; charset=utf-8")
            elif path == "/api/snapshots":
                self.send(payload(), "application/json")
            else:
                self.send_error(404)

        def log_message(self, *_):
            pass

    server = ThreadingHTTPServer((args.host, args.port), Handler)
    url = f"http://{args.host}:{server.server_address[1]}/"
    print(f"serving the perf dashboard at {url} (read-only; Ctrl-C to stop)", flush=True)
    if args.open:
        import webbrowser
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------- A/B

# Where built binaries and their before-trees are parked. A binary is *copied*
# here the moment it is built: `cargo build` writes one path, and an A/B run
# builds twice, so measuring `target/release/heather` directly would measure
# the second build twice over.
AB_DIR = "perf-ab"
# The file an A/B run probes to read a binary's `--timings` header. Small
# enough that two runs of it cost nothing, real enough to produce every
# column.
AB_PROBE_FILE = "lib/std/nat.hthr"


def sha256_file(path: Path):
    import hashlib
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def run_or_die(cmd, cwd, what, env=None):
    p = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True,
                       env={**os.environ, **(env or {})})
    if p.returncode != 0:
        tail = "\n".join((p.stdout + p.stderr).splitlines()[-15:])
        sys.exit(f"error: {what} failed ({' '.join(map(str, cmd))}):\n{tail}")
    return p.stdout


def build_binary(tree: Path, target: Path, label: str, touch: bool):
    """One release build of `tree` into `target`, parked under AB_DIR as
    `heather-<label>`.

    `touch` exists for the furnace: a checkout there is an rsync of the
    working tree, so source mtimes are the *local* ones, and `target/` lives
    on a volume that survives instances. Against a newer target dir cargo
    judges a reverted tree fresh and hands back the binary it already had —
    two builds across a revert then produce byte-identical binaries and an
    A/B that compares one binary with itself. The caller does not get to
    forget this: `cmd_ab` compares the two hashes and refuses if they match.
    """
    if touch:
        for p in (tree / "crates").rglob("*.rs"):
            p.touch()
    print(f"  building {label} in {tree} (target {target}) …", end="", flush=True)
    t0 = time.perf_counter()
    run_or_die(["cargo", "build", "--release", "-p", "heather-cli", "--bin", "heather"],
               cwd=tree, what=f"the {label} build", env={"CARGO_TARGET_DIR": str(target)})
    built = target / "release" / "heather"
    if not built.is_file():
        sys.exit(f"error: the {label} build left no binary at {built}")
    parked = target_dir() / AB_DIR / f"heather-{label}"
    parked.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(built, parked)
    print(f" {time.perf_counter() - t0:.0f}s", flush=True)
    return parked


def before_tree_from_base(base: str):
    """A git worktree at `base`, reused across runs and keyed by its commit so
    the expensive cold build is paid once. Needs `.git`, which a furnace
    checkout does not have — use `--patch` there."""
    if not sh("git", "rev-parse", "--git-dir"):
        sys.exit("error: --base needs a git checkout; on a furnace box (a plain copy, no .git) "
                 "use --patch with a diff of the change instead")
    sha = sh("git", "rev-parse", base)
    if not sha:
        sys.exit(f"error: --base {base} does not resolve to a commit")
    root = target_dir() / AB_DIR / sha[:12]
    tree = root / "tree"
    if not (tree / "Cargo.toml").is_file():
        shutil.rmtree(tree, ignore_errors=True)
        tree.parent.mkdir(parents=True, exist_ok=True)
        print(f"  checking out {base} ({sha[:12]}) at {tree}")
        run_or_die(["git", "worktree", "add", "--detach", str(tree), sha], cwd=ROOT,
                   what="git worktree add")
    return tree, root / "target", sha[:12]


class ReversePatch:
    """The before tree as *this* tree with the change taken out, for boxes
    without git. Restores on the way out and verifies it did: every file the
    patch touches is hashed before and re-hashed after, because a half-applied
    restore leaves the working tree silently wrong and nothing else here would
    notice."""

    def __init__(self, patch: Path):
        self.patch = patch
        self.files = []
        for line in patch.read_text(errors="replace").splitlines():
            if line.startswith("+++ b/"):
                self.files.append(line[6:].split("\t")[0])
        self.before = {f: self._hash(f) for f in self.files}

    def _hash(self, rel):
        p = ROOT / rel
        return sha256_file(p) if p.is_file() else None

    def _patch(self, reverse):
        cmd = ["patch", "-p1", "--batch", "--forward"] + (["-R"] if reverse else [])
        p = subprocess.run(cmd, cwd=ROOT, text=True, capture_output=True,
                           input=self.patch.read_text(errors="replace"))
        if p.returncode != 0:
            # `--forward` *skips* a hunk that looks already-applied (or, under
            # `-R`, already-reversed) and still exits nonzero, so a patch whose
            # change is simply not in this tree fails exactly like a conflict
            # does. Worth naming: it is the likeliest cause on the reverse pass,
            # and it means nothing was touched rather than half of it.
            hint = ("\n  on the reverse pass this is most often a change that is not in this tree "
                    "at all — `patch` skips a hunk it reads as already-reversed and exits nonzero "
                    "just as it does for a conflict, so check whether the diff is against the tree "
                    "you think" if reverse else "")
            sys.exit(f"error: `{' '.join(cmd)}` failed; the working tree may be half-patched — "
                     f"check `git status` before doing anything else:{hint}\n{p.stdout}{p.stderr}")

    def __enter__(self):
        print(f"  reverting {len(self.files)} file(s) with {self.patch.name}")
        self._patch(reverse=True)
        return ROOT

    def reverted_hashes(self):
        """The patch-touched files as they are with the change taken *out*.

        The source-patch mode's provenance check needs these: its assertion is
        "the two source trees differ", the mirror of the binary mode's "the two
        binaries differ", and there is no hash of the reverted tree until the
        tree has been reverted once.
        """
        with self:
            return {f: self._hash(f) for f in self.files}

    def __exit__(self, *_):
        self._patch(reverse=False)
        bad = [f for f in self.files if self._hash(f) != self.before[f]]
        if bad:
            sys.exit("error: restoring the working tree did not reproduce it; these files differ "
                     "from how this run found them: " + ", ".join(bad))
        print(f"  working tree restored and verified ({len(self.files)} file(s))")
        return False


def source_patch_setup(args):
    """The provenance check, inverted, for a change to `lib/` or a showcase.

    A binary A/B asserts that the two binaries differ over one source tree.
    A *source* round is the other way round — one binary over two source trees
    — and the assertion has to be inverted with it, or the mode silently
    measures one tree against itself, which is the exact failure the binary
    mode's hash check exists to catch.

    Two refusals, both mirrors of that check:

    - a patch that names no files, or whose reversal leaves every file it names
      byte-identical: the two source trees are the same one;
    - a patch that touches code the **binary** is built from, which breaks the
      mode's premise that the binary is fixed. That case is what `--patch` is
      for, and it rebuilds the before side.
    """
    if args.marker:
        sys.exit("error: --marker asserts a `--timings` column the *after binary* adds, and "
                 "--source-patch measures one binary on both sides; drop it")
    picked = [f for f, v in (("--patch", args.patch), ("--before", args.before),
                             ("--after", args.after)) if v]
    if picked or args.base != "HEAD":
        sys.exit("error: --source-patch is the one-binary mode; "
                 + ", ".join(picked + (["--base"] if args.base != "HEAD" else []))
                 + " selects binaries and cannot be combined with it. Use --heather to skip the build.")
    patch = Path(args.source_patch)
    if not patch.is_file():
        sys.exit(f"error: no patch at {patch}")
    rp = ReversePatch(patch)
    if not rp.files:
        sys.exit(f"error: {patch.name} names no files (no `+++ b/` lines), so there is nothing to "
                 f"reverse. A `git diff` of the change is what this wants.")
    built = [f for f in rp.files if f.startswith("crates/") or f.startswith("Cargo.")]
    if built:
        sys.exit("error: --source-patch holds the binary fixed, but this patch changes code the binary "
                 "is built from: " + ", ".join(built[:5]) +
                 ". Use --patch (or --base), which rebuilds the before side, for a compiler change.")
    reverted = rp.reverted_hashes()
    moved = [f for f in rp.files if reverted[f] != rp.before[f]]
    if not moved:
        sys.exit(f"error: reversing {patch.name} leaves every file it names byte-identical, so this "
                 f"would compare one source tree with itself. The patch is probably already reversed "
                 f"in this tree, or is a diff against something else.")
    return rp, moved


def side(source, which):
    """The context a sample runs in: for `--source-patch`, the `before` side is
    measured with the change reversed and the `after` side as the tree stands.
    Re-entered per sample so the two sides stay *interleaved* — the property
    the whole harness is built around — rather than measured in two blocks."""
    return source if (source is not None and which == "before") else nullcontext()


def timing_columns(args, heather: Path, raw_dir: Path, label: str):
    """A binary's `--timings` header, as a behavioural fingerprint.

    Hashes say two binaries differ; they do not say *which* is which. A round
    that adds a counter can be identified by the column it emits, and that
    check costs one run of the smallest corpus file.
    """
    tsv = raw_dir / f"probe-{label}.tsv"
    cache = Path(tempfile.mkdtemp(prefix=f"heather-ab-probe-{label}-"))
    try:
        run_check(args, heather, AB_PROBE_FILE, [], cache, tsv, 1)
    finally:
        shutil.rmtree(cache, ignore_errors=True)
    if not tsv.is_file():
        return []
    return tsv.read_text().splitlines()[0].split("\t")


def ab_sample(args, heather, file, search, raw_dir, label, i):
    """One cold check: a fresh cache dir, so the run elaborates and gates
    everything rather than replaying somebody's images."""
    cache = Path(tempfile.mkdtemp(prefix=f"heather-ab-{label}-"))
    tsv = raw_dir / f"{Path(file).stem}-{label}-{i}.tsv"
    try:
        if args.mode != "cold":
            # warm/edit need a seeded cache: one throwaway run first.
            run_check(args, heather, file, search, cache, raw_dir / f"seed-{label}-{i}.tsv", args.workers)
        path = ROOT / file
        original = path.read_bytes()
        try:
            if args.mode == "edit":
                path.write_bytes(original + EDIT_PROBE.encode())
            out = run_check(args, heather, file, search, cache, tsv, args.workers)
        finally:
            path.write_bytes(original)
    finally:
        shutil.rmtree(cache, ignore_errors=True)
    if out["exit"] != 0:
        sys.exit(f"error: the {label} binary failed on {file}: {out['summary']}\n"
                 + "\n".join(out.get("output_tail", [])))
    out["columns"] = Timings(tsv).columns if tsv.is_file() else []
    return out


def med(xs):
    xs = sorted(xs)
    return xs[len(xs) // 2] if xs else 0


# An item has to be worth this much before an A/B ranks it: a 0.4 ms
# declaration separates cleanly on two samples through scheduling alone, and a
# table of ±30 % on sub-millisecond items buries the one row that matters.
AB_ITEM_FLOOR_NS = 5_000_000
# A delta below this is reported as no change however cleanly the samples
# separate — disjointness answers "did it move", not "does it matter".
AB_EPSILON_PCT = 1.0


def spread_verdict(a, b):
    """Whether the samples actually separate. A median delta smaller than the
    per-sample spread is not a result, and saying so is the whole point of
    running more than one sample: a desktop under load once read a −8.9 %
    kernel-gate win as −2.9 % and invented a +35 % per-item regression that a
    quiet box puts at −1.3 % (issues/signature-rescope-multiplicity.md)."""
    if len(a) < 2 or len(b) < 2:
        return "one sample"
    ma, mb = med(a), med(b)
    if ma and abs((mb - ma) / ma * 100) < AB_EPSILON_PCT:
        return "no change"
    if max(b) < min(a) or max(a) < min(b):
        return "disjoint"
    return "OVERLAPPING"


def fmt_count(v):
    return f"{v:,}" if isinstance(v, int) else str(v)


def pct(a, b):
    return f"{(b - a) / a * 100:+.1f}%" if a else ("new" if b else "—")


def cmd_ab(args):
    args.workers = args.kernel_workers
    args.source_mode = False
    if args.replay:
        path = Path(args.replay) if args.replay != "last" else target_dir() / AB_DIR / "last.json"
        if not path.is_file():
            sys.exit(f"error: no A/B record at {path}; run `scripts/perf ab` first")
        rec = json.loads(path.read_text())
        args.source_mode = rec.get("source", False)
        print(f"\n== A/B (replayed from {path}): {rec['label']} ==")
        for line in rec["header"]:
            print(line)
        for file, runs in rec["files"]:
            print(f"\n-- {file} (replayed; no re-measurement) --")
            args.samples = len(runs["before"])
            report_ab(args, runs)
        return
    raw_dir = target_dir() / AB_DIR / "raw"
    shutil.rmtree(raw_dir, ignore_errors=True)
    raw_dir.mkdir(parents=True, exist_ok=True)

    # --- what is held fixed and what varies: two binaries over one source
    # tree, or (--source-patch) one binary over two source trees
    provenance = {}
    source = None
    if args.source_patch:
        source, moved_files = source_patch_setup(args)
        args.source_mode = True
        before_bin = after_bin = (Path(args.heather) if args.heather
                                  else build_binary(ROOT, target_dir(), "fixed", args.touch))
        provenance["before"] = f"this tree with {source.patch.name} reversed"
        provenance["after"] = "this working tree"
    elif args.before and args.after:
        before_bin, after_bin = Path(args.before), Path(args.after)
        provenance["before"] = f"given: {before_bin}"
        provenance["after"] = f"given: {after_bin}"
    else:
        after_bin = build_binary(ROOT, target_dir(), "after", args.touch)
        provenance["after"] = f"this working tree ({sh('git', 'rev-parse', '--short', 'HEAD') or '?'}"\
                              f"{'+dirty' if sh('git', 'status', '--porcelain', '--untracked-files=no') else ''})"
        if args.patch:
            with ReversePatch(Path(args.patch)):
                before_bin = build_binary(ROOT, target_dir(), "before", True)
            provenance["before"] = f"this tree with {Path(args.patch).name} reversed"
        else:
            tree, target, sha = before_tree_from_base(args.base)
            before_bin = build_binary(tree, target, "before", args.touch)
            provenance["before"] = f"worktree at {args.base} ({sha})"

    hb, ha = sha256_file(before_bin), sha256_file(after_bin)
    e = environment(args)
    label = args.label or (f"{source.patch.name} (source) → working tree" if source else
                           f"{Path(args.patch).name if args.patch else args.base} → working tree")
    header = []

    def say(line):
        header.append(line)
        print(line, flush=True)

    print(f"\n== A/B: {label} ==")
    say(f"   before  {hb[:12]}  {provenance['before']}")
    say(f"   after   {ha[:12]}  {provenance['after']}")
    if source:
        # The provenance assertion, mirrored: here the binary is *supposed* to
        # be the same on both sides, and it is the two source trees that have
        # to differ. `source_patch_setup` has already refused a patch that
        # leaves every file it names byte-identical, and one that touches code
        # the binary is built from.
        say(f"   provenance: one binary ({'given: ' + args.heather if args.heather else 'built from '
            'this working tree'}), {len(moved_files)} source file(s) differ between the sides "
            f"({', '.join(moved_files[:4])}{', …' if len(moved_files) > 4 else ''})")
    else:
        if hb == ha:
            sys.exit("error: the two binaries are byte-identical, so this would compare one binary with "
                     "itself. Either the change does not affect the built code, or a build was skipped as "
                     "fresh — pass --touch (and see `build_binary` on why a furnace checkout needs it). "
                     "For a change to `lib/` or a showcase, which is one binary over two source trees, "
                     "use --source-patch.")

        cols_b = timing_columns(args, before_bin, raw_dir, "before")
        cols_a = timing_columns(args, after_bin, raw_dir, "after")
        gained, lost = [c for c in cols_a if c not in cols_b], [c for c in cols_b if c not in cols_a]
        fingerprint = "identical `--timings` columns"
        if gained or lost:
            fingerprint = ("after adds " + ", ".join(gained) if gained else "") + \
                          ("; " if gained and lost else "") + \
                          ("after drops " + ", ".join(lost) if lost else "")
        say(f"   provenance: binaries differ, {fingerprint}")
        if args.marker:
            if args.marker not in cols_a or args.marker in cols_b:
                sys.exit(f"error: --marker {args.marker} should appear in the after binary's --timings "
                         f"header and not the before one; got after={args.marker in cols_a} "
                         f"before={args.marker in cols_b}. The binaries are not the trees you think.")
            say(f"   marker {args.marker}: in after only, as asserted")
    load = e["loadavg"][0] if e["loadavg"] else 0.0
    say(f"   {e['source']} {e['host']} {e['cpu']} {e['nproc']} cpus, width {args.workers}, "
        f"mode {args.mode}, {args.samples} interleaved samples, loadavg {e['loadavg']}")
    if load > max(1.0, e["nproc"] * 0.25):
        say(f"   WARNING: 1-minute load average {load:.1f} on {e['nproc']} cpus. Seconds from this "
            f"run are not trustworthy; counters still are. Re-run on a quiet box before quoting a "
            f"time delta or believing a per-item regression.")

    # --- the corpus
    only = args.only if args.only is not None else ["calc_parser"]
    if source and args.only is None and not args.file:
        # A source round is about the files the patch touched, so measuring the
        # default showcase would be measuring something else. Where a patched
        # file is in the corpus, that is the corpus; where none is, the change
        # reaches the corpus only through an import and the report says so,
        # because "no change" would otherwise read as a finding.
        hit = [c for c in CORPUS[args.corpus] if c[0] in moved_files]
        if hit:
            only = [c[0] for c in hit]
            say(f"   corpus: the patched file(s) in it — {', '.join(only)}")
        else:
            say(f"   NOTE: no file this patch touches is in the `{args.corpus}` corpus, so it is "
                f"measured only through whatever imports it. Name the consumer with "
                f"`--file PATH[:DIR,DIR]` — `docs/showcase/calc_text.hthr` is not in the corpus "
                f"— it is 4:24 a check; `scripts/showcase check calc_text -- --timings F.tsv` "
                f"is how it is measured by hand.")
    corpus = [c for c in CORPUS[args.corpus] if any(o in c[0] for o in only)]
    for spec in args.file or []:
        path, _, dirs = spec.partition(":")
        corpus.append((path, [d for d in dirs.split(",") if d]))
    if not corpus and not args.file:
        sys.exit(f"error: no corpus file matches {only}")

    record = {"label": label, "header": header, "stamp": now_stamp(), "env": e,
              "source": bool(source),
              "before": {"sha256": hb, "from": provenance["before"]},
              "after": {"sha256": ha, "from": provenance["after"]}, "files": []}
    for file, search in corpus:
        runs = {"before": [], "after": []}
        print(f"\n-- {file} --")
        for i in range(1, args.samples + 1):
            for which, binary in (("before", before_bin), ("after", after_bin)):
                with side(source, which):
                    out = ab_sample(args, binary, file, search, raw_dir, which, i)
                runs[which].append(out)
                print(f"   sample {i} {which:6} {out['wall_s']:7.2f}s wall  "
                      f"{secs(out['run'].get('kernel_gate_ns', 0)):6.2f}s gate  "
                      f"{out['max_rss_mb']:.0f} MB", flush=True)
        report_ab(args, runs)
        record["files"].append([file, runs])

    out = target_dir() / AB_DIR / "last.json"
    out.write_text(json.dumps(record, indent=1) + "\n")
    print(f"\n   raw `--timings` tables in {raw_dir}; this report is replayable with "
          f"`scripts/perf ab --replay` ({out})")


def report_ab(args, runs):
    """Counters first and seconds second, because they answer different
    questions. A counter that moved is exact on one tree; seconds are the claim
    that needs the spread beside it.

    What a moved counter *means* depends on which mode this is, and that is the
    one thing source mode changes here. For two binaries over one source tree a
    move is a **behaviour** change — the round was about speed and something
    else shifted. For one binary over two source trees the move is the
    **result**: term growth is what a source round trades for readability, so
    the moved columns are ranked by how far they moved instead of listed
    alphabetically as an anomaly."""
    source = getattr(args, "source_mode", False)
    rb = [r["run"] for r in runs["before"]]
    ra = [r["run"] for r in runs["after"]]
    counters = [c for c in rb[0] if not c.endswith("_ns")]

    same, moved = [], []
    for c in sorted(set(counters) | {c for c in ra[0] if not c.endswith("_ns")}):
        vb = {r.get(c, 0) for r in rb}
        va = {r.get(c, 0) for r in ra}
        if len(vb) > 1 or len(va) > 1:
            moved.append((c, f"unstable within one binary: before {sorted(vb)} after {sorted(va)}"))
            continue
        b, a = vb.pop(), va.pop()
        (same if b == a else moved).append((c, (b, a)))

    if source:
        print("\n   counters (exact on one tree; for a source change a move here is the RESULT — "
              "term growth is what the round traded, ranked by how far it moved)")
        moved.sort(key=lambda m: (0, 0.0) if isinstance(m[1], str) else
                   (1, -(abs(m[1][1] - m[1][0]) / m[1][0] if m[1][0] else float("inf"))))
    else:
        print("\n   counters (exact on one tree; a move here is a behaviour change, not a speed one)")
    if moved:
        for c, v in moved:
            if isinstance(v, str):
                print(f"     {c:24} {v}")
            else:
                print(f"     {c:24} {fmt_count(v[0]):>15} → {fmt_count(v[1]):>15}  {pct(*v)}")
    else:
        print("     nothing moved")
    print(f"     identical across both binaries and every sample: {len(same)} columns "
          f"({', '.join(c for c, _ in same[:6])}{', …' if len(same) > 6 else ''})")

    print("\n   seconds (noisy; the verdict is whether the samples separate at all)")
    print(f"     {'metric':14}{'before samples':>26}{'after samples':>26}{'median':>9}  verdict")
    rows = [("wall", [r["wall_s"] for r in runs["before"]], [r["wall_s"] for r in runs["after"]])]
    for phase in ("kernel_gate_ns", "total_ns"):
        rows.append((phase[:-3],
                     [secs(r["run"].get(phase, 0)) for r in runs["before"]],
                     [secs(r["run"].get(phase, 0)) for r in runs["after"]]))
    rows.append(("max_rss_mb", [r["max_rss_mb"] for r in runs["before"]],
                 [r["max_rss_mb"] for r in runs["after"]]))
    for name, b, a in rows:
        v = spread_verdict(b, a)
        note = {"disjoint": "separate", "OVERLAPPING": "SPREAD EXCEEDS THE DELTA — not a result",
                "one sample": "one sample — no verdict", "no change": "no change"}[v]
        print(f"     {name:14}{' '.join(f'{x:7.2f}' for x in b):>26}"
              f"{' '.join(f'{x:7.2f}' for x in a):>26}{pct(med(b), med(a)):>9}  {note}")

    # --- per item, by the metric the round is about
    def items(rs, key):
        """One value per item per sample. A snapshot keeps the heaviest items
        *and* the per-step outliers, and a heavy item with an expensive step is
        in both lists — counted twice it would look like a sample reported it
        twice and be dropped as incomplete below."""
        out = {}
        for r in rs:
            for name, v in {it["name"]: it.get(key, 0)
                            for it in r["items"]["top"] + r["items"]["outliers"]}.items():
                out.setdefault(name, []).append(v)
        return out

    ib, ia = items(runs["before"], args.item_metric), items(runs["after"], args.item_metric)
    # Only items every sample on both sides reported: a snapshot keeps the
    # heaviest N items and the per-step outliers, so an item near that cut
    # enters and leaves the list between samples and its "delta" is really
    # the cut moving.
    n_each = len(runs["before"])
    shared = [n for n in ib if n in ia and len(ib[n]) == n_each and len(ia[n]) == n_each]
    partial = len([n for n in ib if n in ia]) - len(shared)
    floor = AB_ITEM_FLOOR_NS if args.item_metric.endswith("_ns") else 0
    ranked = [n for n in shared if max(med(ib[n]), med(ia[n])) >= floor]
    small = len(shared) - len(ranked)
    ranked = sorted(ranked, key=lambda n: -abs(med(ia[n]) - med(ib[n])))[:args.top]
    unit = "s" if args.item_metric.endswith("_ns") else ""
    print(f"\n   per item, by |Δ {args.item_metric}| (median of {n_each}; of the heaviest items a "
          f"snapshot keeps)")
    if not ranked:
        print(f"     nothing above the floor of {floor / 1e6:.0f} ms" if floor else "     nothing to rank")
        return
    for n in ranked:
        b, a = med(ib[n]), med(ia[n])
        cell = (f"{secs(b):8.3f}{unit} → {secs(a):8.3f}{unit}" if unit
                else f"{fmt_count(int(b)):>13} → {fmt_count(int(a)):>13}")
        print(f"     {n[-52:]:53}{cell}  {pct(b, a):>8}  "
              f"{spread_verdict(ib[n], ia[n]).replace('disjoint', 'separate')}")
    skipped = []
    if small:
        skipped.append(f"{small} under the {floor / 1e6:.0f} ms floor")
    if partial:
        skipped.append(f"{partial} reported by only some samples (the kept-items cut moved)")
    if skipped:
        print("     not ranked: " + ", ".join(skipped))



# ---------------------------------------------------------------- selftest

def cmd_ab_selftest(_args):
    """Assertions over the A/B report's pure logic.

    Not in `scripts/test`: there is no python test lane in this repo (the only
    tested script is the node runner, `scripts/test-target-runner.test.mjs`).
    Run it by hand after touching `report_ab`. Both cases below are bugs this
    report actually shipped with for an afternoon.
    """
    import io
    import contextlib

    fails = []

    def check(name, cond, detail=""):
        print(f"  {'ok  ' if cond else 'FAIL'} {name}{'' if cond else ': ' + detail}")
        if not cond:
            fails.append(name)

    check("a delta inside the spread is not a result",
          spread_verdict([10.0, 12.0], [11.0, 13.0]) == "OVERLAPPING")
    check("disjoint sample sets separate",
          spread_verdict([10.0, 10.2], [9.0, 9.1]) == "disjoint")
    check("a disjoint but tiny delta is no change",
          spread_verdict([100.0, 100.1], [100.4, 100.5]) == "no change")
    check("one sample yields no verdict", spread_verdict([1.0], [2.0]) == "one sample")
    check("pct names a new counter", pct(0, 7) == "new")
    check("pct on zero-to-zero is neither", pct(0, 0) == "—")

    # A synthetic pair of runs: one heavy item that improved, one heavy item in
    # *both* the top and the outlier list (the dedupe bug: counted twice, it
    # looked like a sample had reported it twice and was dropped as
    # incomplete), and one sub-millisecond item that separates on noise (the
    # floor bug: ranked at ±30 % above the item that mattered).
    def run(gate_heavy, gate_both, gate_tiny, counters):
        heavy = {"name": "m::heavy", "kernel_gate_ns": gate_heavy}
        both = {"name": "m::both", "kernel_gate_ns": gate_both}
        tiny = {"name": "m::tiny", "kernel_gate_ns": gate_tiny}
        return {"wall_s": 1.0, "max_rss_mb": 1.0,
                "run": dict(kernel_gate_ns=gate_heavy + gate_both, total_ns=0, **counters),
                "items": {"top": [heavy, both, tiny], "outliers": [both]}}

    runs = {
        "before": [run(900_000_000, 500_000_000, 400_000, dict(conv_misses=7, moved_counter=10)),
                   run(910_000_000, 505_000_000, 300_000, dict(conv_misses=7, moved_counter=10))],
        "after": [run(700_000_000, 400_000_000, 500_000, dict(conv_misses=7, moved_counter=4)),
                  run(710_000_000, 405_000_000, 600_000, dict(conv_misses=7, moved_counter=4))],
    }

    class A:
        item_metric, top, samples = "kernel_gate_ns", 10, 2

    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        report_ab(A(), runs)
    out = buf.getvalue()

    check("an item in both the top and outlier lists is still ranked", "m::both" in out,
          "the dedupe in `items()` regressed")
    check("a sub-millisecond item is below the floor", "m::tiny" not in out,
          "AB_ITEM_FLOOR_NS is not being applied")
    check("the heavy item is ranked", "m::heavy" in out)
    check("a moved counter is reported", "moved_counter" in out)
    check("an unmoved counter is not listed as moved",
          "conv_misses" not in out.split("seconds (noisy")[0].split("identical across")[0])
    check("the unmoved count is reported", "identical across both binaries" in out)

    # Source mode reads the same table the other way up: the binary is fixed,
    # the sources differ, and a moved counter is the round's result rather than
    # an alarm — so the heading says so and the moved columns are ranked by how
    # far they moved (the readability-for-term-growth trade a showcase round
    # makes: issues/perf-ab-source-patch.md).
    def src_run(small_move, big_move):
        r = run(900_000_000, 500_000_000, 400_000,
                dict(small_counter=small_move, big_counter=big_move))
        return r

    src = {"before": [src_run(100, 10), src_run(100, 10)],
           "after": [src_run(110, 40), src_run(110, 40)]}

    class S:
        item_metric, top, samples, source_mode = "kernel_gate_ns", 10, 2, True

    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        report_ab(S(), src)
    sout = buf.getvalue()
    counters_block = sout.split("seconds (noisy")[0]

    check("source mode says a moved counter is the result", "is the RESULT" in counters_block,
          "the source-mode counter heading regressed")
    check("binary mode still says a moved counter is a behaviour change",
          "behaviour change" in out.split("seconds (noisy")[0])
    check("source mode ranks the furthest-moved counter first",
          counters_block.index("big_counter") < counters_block.index("small_counter"),
          "moved counters are not sorted by relative move in source mode")

    print(f"\n{len(fails)} failed" if fails else "\nall ok")
    sys.exit(1 if fails else 0)


def main():
    p = argparse.ArgumentParser(prog="perf", description="perf snapshots and the dashboard that reads them")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("snapshot", help="measure the suite history and the corpus; write one JSON")
    sp.add_argument("--corpus", choices=CORPUS, default="quick")
    sp.add_argument("--file", action="append", metavar="PATH[:DIR,DIR]", help="extra corpus file with its -L dirs")
    sp.add_argument("--only", action="append", metavar="SUBSTR", help="restrict the corpus to matching paths")
    sp.add_argument("--no-tests", action="store_true", help="skip the suite history")
    sp.add_argument("--no-files", action="store_true", help="skip the corpus")
    sp.add_argument("--env", help="environment name (default: local on the desktop, furnace under /work)")
    sp.add_argument("--label", help="a few words about why this snapshot was taken")
    sp.add_argument("--kernel-workers", type=int, help="gate width for the attributed runs (default 1: honest phases, comparable to the suite)")
    sp.add_argument("--wait-workers", type=int, default=int(os.environ.get("HEATHER_KERNEL_WORKERS", "8")),
                    help="gate width for the `wait` cold run — what a person sits through (default: HEATHER_KERNEL_WORKERS or the CLI's 8)")
    sp.add_argument("--no-wait", action="store_true", help="skip the `wait` run")
    sp.add_argument("--heather", help="release binary (default: $CARGO_TARGET_DIR/release/heather)")
    sp.add_argument("--mem-gib", type=int, default=8, help="address-space cap per check (default 8)")
    sp.add_argument("--cpu-secs", type=int, default=600, help="CPU cap per check (default 600)")
    sp.set_defaults(fn=cmd_snapshot)

    sp = sub.add_parser("report", help="what is slow and where it comes from; deltas against the previous snapshot")
    sp.add_argument("snapshot", nargs="?", help="stamp, file name fragment or commit (default: latest)")
    sp.add_argument("--against", metavar="prev|SNAPSHOT", default="prev",
                    help="compare against the previous same-environment snapshot (default) or a named one; `none` for no deltas")
    sp.add_argument("--top", type=int, default=12)
    sp.set_defaults(fn=lambda a: (setattr(a, "against", None if a.against == "none" else a.against), cmd_report(a)))

    sp = sub.add_parser("ab-selftest", help="assertions over the A/B report's pure logic (run by hand)")
    sp.set_defaults(fn=cmd_ab_selftest)

    sp = sub.add_parser("list", help="snapshots on record")
    sp.set_defaults(fn=cmd_list)

    sp = sub.add_parser("serve", help="the dashboard")
    sp.add_argument("--host", default="127.0.0.1")
    sp.add_argument("--port", type=int, default=8766)
    sp.add_argument("--open", action="store_true")
    sp.set_defaults(fn=cmd_serve)

    sp = sub.add_parser("ab", help="two binaries, interleaved, with their provenance asserted")
    sp.add_argument("--base", default="HEAD",
                    help="commit the `before` binary is built from, in a reused git worktree (default HEAD, "
                         "i.e. this tree's uncommitted change is the `after`)")
    sp.add_argument("--patch", metavar="FILE",
                    help="instead of a worktree, build `before` by reversing this diff in place and "
                         "restoring it afterwards — for a checkout without git, which is what a furnace box is")
    sp.add_argument("--source-patch", metavar="FILE",
                    help="the other A/B: hold the BINARY fixed and reverse this diff over the *sources* "
                         "between samples — for a change to `lib/` or a showcase, where the two trees "
                         "differ and the binary does not. Refuses a patch that touches `crates/` (that "
                         "is --patch) or one whose reversal changes nothing. A moved counter is then the "
                         "result, not an alarm")
    sp.add_argument("--heather", metavar="BIN",
                    help="with --source-patch: the fixed binary to measure, instead of building one")
    sp.add_argument("--before", metavar="BIN", help="skip building: measure this binary as `before`")
    sp.add_argument("--after", metavar="BIN", help="skip building: measure this binary as `after`")
    sp.add_argument("--marker", metavar="COLUMN",
                    help="assert this `--timings` column is emitted by the after binary and not the before one; "
                         "the strongest provenance check there is, when the round adds a counter")
    sp.add_argument("--touch", action="store_true",
                    help="touch every crate source before each build, so cargo cannot judge a tree fresh that "
                         "it has already built newer artifacts for (always do this on furnace)")
    sp.add_argument("--samples", type=int, default=3, help="interleaved before/after pairs (default 3)")
    sp.add_argument("--mode", choices=("cold", "warm", "edit"), default="cold")
    sp.add_argument("--corpus", choices=CORPUS, default="quick")
    sp.add_argument("--only", action="append", metavar="SUBSTR",
                    help="restrict the corpus to matching paths (default: the showcase alone — an A/B "
                         "is usually about one workload, and every file costs two binaries times --samples)")
    sp.add_argument("--file", action="append", metavar="PATH[:DIR,DIR]", help="extra file with its -L dirs")
    sp.add_argument("--item-metric", default="kernel_gate_ns", help="what the per-item table ranks by")
    sp.add_argument("--top", type=int, default=12)
    sp.add_argument("--label", help="a few words about what this A/B is testing")
    sp.add_argument("--env", help="environment name (default: local on the desktop, furnace under /work)")
    sp.add_argument("--kernel-workers", type=int, default=1,
                    help="gate width (default 1: item timings are only comparable at one width)")
    sp.add_argument("--wait-workers", type=int, default=1, help=argparse.SUPPRESS)
    sp.add_argument("--mem-gib", type=int, default=12, help="address-space cap per check (default 12)")
    sp.add_argument("--cpu-secs", type=int, default=900, help="CPU cap per check (default 900)")
    sp.add_argument("--replay", nargs="?", const="last", metavar="PATH",
                    help="re-render the last A/B's report (or a saved one) without measuring anything")
    sp.set_defaults(fn=cmd_ab)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()

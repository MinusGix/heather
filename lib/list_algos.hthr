// `list_algos` — small list algorithms with real proof content, written to
// rank the surface (issues/list-algorithms-exercise.md).
//
// Revised (2026-08-05) onto the round's three features: receiver-reached
// members (`xs.nth(i)`), call-site over-application (`plusl(n, m)`,
// `nth_append_l(t, ys, k, a, p)`), and the empty proof block (`{}`). The
// before/after of each proof is recorded in
// issues/list-algorithms-exercise.md.
//
// Revised again (2026-08-17): the insertion-sort half went PROPOSITIONAL, and
// the `Bool` kit it rested on is gone. That section carries its own
// before/after, because it is the measurement issues/decide-class.md was
// filed to take.
//
// Emptied out from the top the same day (issues/std-list-api.md): `len`, `rev`
// and its two laws, `cong_append_l` and the two `nth`/`append` lemmas were
// list facts sitting in the algorithm file, and they are now `std/list`'s —
// the move `cong_cons` and the append laws made on 2026-08-07, finished. The
// private `plusl` did not move; it is GONE, because `nth_append_r`'s index
// only ever needed writing as `add(i, xs.len())` rather than
// `plusl(xs.len(), i)` for `nat::add` to step where `append` steps. What is
// left below is the algorithms: insertion sort, its sortedness proof, and
// nothing that any other file would want.
//
// Wave L3 (2026-08-17, issues/std-list-mem-and-perm.md) finished the
// specification: `count` and the permutation half. `Mem` went to `std/list`
// because it is polymorphic; `count` stayed here because it is not, and the
// reason it is not is a live language gap — see §the other half below.

import list;
import nat;
import option;
import logic;

// ---------------------------------------------------------------------------
// insertion sort, and the proof that it sorts.
//
// Sortedness is DECLARED, not decided (restated 2026-08-17,
// issues/decide-class.md's acceptance). It used to be a `Bool` — `sortedb` —
// with every statement in the section reading `sortedb(xs) = True`, matching
// the `leb(n, m) = True` spelling `std/nat` used before its order went
// propositional. Both halves are retired by issues/class-ops-prop-vs-bool.md:
// no `Bool` in a specification and no `= True` anywhere.
//
// What that cost and what it bought is the measurement this section exists to
// record, and it is one-sided. GONE: `andb`, `le_head`, `sortedb`, `ins_pick`,
// the four `cong_*` congruences, the three `andb_true*` lemmas, and
// `leb_false_flip` — thirteen declarations. ARRIVED: `LeHead` and `Sorted`,
// two recursions into `Type`, plus one line in `std/nat` (`le_of_not_le`).
// The proofs below lost every `j`, every `trans`, and every congruence: the
// decided branch is reached by a `match` whose motive names the scrutinee, so
// there is no equation to rewrite along and nothing to transport.

// `LeHead(x, xs)` — `x` is below `xs`'s head, vacuously at `Nil`. The `True`
// here is the kernel's `Unit^0`, so the vacuous case is proof-irrelevant for
// free and `trivial` closes it.
fn LeHead(x: Nat, xs: List<Nat>) → Type {
    match xs { Nil => True, Cons(h, t) => x.Le(h) }
}

// Sortedness as a conjunction rather than an `andb`. `And` is a record, so its
// elimination is field access — which is precisely what retires `andb_true_l`
// and `andb_true_r`: `hs.left` and `hs.right` are the same two facts with no
// lemma between them.
fn Sorted(xs: List<Nat>) → Type {
    match xs { Nil => True, Cons(h, t) => And<LeHead(h, t), Sorted(t)> }
}

// `insert` branches through `logic::or_pick`, and needs no hoisted `ins_pick`
// of its own any more. The reason the old one existed — a `match` on a stuck
// `Bool` scrutinee is unreachable from the goal, so every lemma needed a
// convoy — is answered generically by `or_pick`, whose consumers reach the
// branch by a motive that names the scrutinee directly.
//
// `or_pick(d, x, y)` picks `y` on `Inl`, so the proved side (`Le(x, h)`, i.e.
// `x` belongs first) is the second value.
//
// The decision is reached by **resolution** and not by naming `le_dec`
// (2026-08-17, issues/value-generic-instances.md): `decide<Le(x, h)>()` states
// the proposition and lets the class find the decider, at an `x` and an `h`
// that are open. That was unspellable until an instance could be generic over a
// value — `std/nat`'s `instance(n, m: Nat) Decide<Le(n, m)>` is the one this
// resolves to, and the whole difference here is that no declaration below
// mentions a decision procedure by name.
fn insert(x: Nat, xs: List<Nat>) → List<Nat> {
    match xs {
        Nil => Cons(x, Nil),
        Cons(h, t) =>
            or_pick(decide<x.Le(h)>(), Cons(h, insert(x, t)), Cons(x, Cons(h, t))),
    }
}

fn isort(xs: List<Nat>) → List<Nat> {
    match xs { Nil => Nil, Cons(h, t) => insert(h, isort(t)) }
}

// Inserting below a head keeps the head below everything. Two case splits and
// no recursion — and the second is on the DECISION, so each arm's goal has
// already reduced to the branch that arm picked. Both arms are a hypothesis
// handed back unchanged. The motive that used to restate `or_pick(d, …, …)` is
// gone here and at the four other decision splits in this file: synthesis
// reduces the goal and abstracts the decision it is stuck on
// (issues/goal-motive-by-scrutinee-abstraction.md, closed 2026-08-17).
theorem le_head_insert(h: Nat, x: Nat, t: List<Nat>):
    h.Le(x) → LeHead(h, t) → LeHead(h, insert(x, t))
{
    match t {
        Nil => λ hx ht => hx,
        Cons(h2, t2) => λ hx ht =>
            match decide<x.Le(h2)>() {
                Inl(good) => hx,
                Inr(bad) => ht,
            },
    }
}

// The main lemma. `hs.left` and `hs.right` replace the two `andb_true_*`
// projections; `le_of_not_le` replaces `leb_false_flip`; and `And(…, …)`
// replaces `andb_true`. The refuting branch is the only one that works, and
// what it does is assemble the conjunction the goal already asks for.
theorem insert_sorted(x: Nat, xs: List<Nat>): Sorted(xs) → Sorted(insert(x, xs)) {
    match xs {
        Nil => λ hs => And(trivial, trivial),
        Cons(h, t) => λ hs =>
            match decide<x.Le(h)>() {
                Inl(good) => And(good, hs),
                Inr(bad) => And(
                    le_head_insert(h, x, t, Nat::le_of_not_le(x, h, bad), hs.left),
                    insert_sorted(x, t, hs.right)),
            },
    }
}

theorem isort_sorted(xs: List<Nat>): Sorted(isort(xs)) {
    match xs {
        Nil => trivial,
        Cons(h, t) => insert_sorted(h, isort(t), isort_sorted(t)),
    }
}

// ---------------------------------------------------------------------------
// the other half of the specification: the output is a REARRANGEMENT of the
// input (wave L3, issues/std-list-mem-and-perm.md).
//
// "It sorts" is half a spec — `λ xs => Nil` satisfies `isort_sorted` — and the
// half above says nothing about the elements. Two statements say the rest, and
// they are not equally strong:
//
//   `count_isort` — for every `a`, `isort(xs)` and `xs` contain `a` the same
//   NUMBER of times. This is multiset equality, i.e. permutation, stated
//   extensionally over the element rather than as a relation.
//   `mem_isort` — `isort(xs)` contains nothing new. Strictly weaker (it cannot
//   see multiplicity), and here because it is what `std/list`'s `Mem` kit is
//   for and it is three lines on top of `mem_insert`.
//
// **Why `count` and not a `Perm` relation.** issues/std-api-waves.md records
// the fork: a `Perm` relation is inductively defined over two lists at once,
// which is an indexed family (issues/indexed-families.md) and therefore wave
// L4's, while `count` needs only a decidable equation and is writable today.
// The count route was taken, and it is not a workaround for the relation — it
// is the *extensional* statement of the same fact, and it computes: at closed
// lists both sides reduce to numerals and the theorem is `refl`. What L4 would
// buy is a permutation fact that can be TRANSPORTED (composed, inverted, used
// to move any other predicate across), which an equality of counts at each `a`
// cannot do.
//
// **What it cost.** `count` is at `Nat` and not polymorphic, and that is the
// language boundary rather than a choice: it must decide `a = h`, an equation
// has no head to key an instance on (issues/decidable-equation-carrier.md), so
// `decide<a = h>()` — the spelling `insert` above uses for `Le` — has no
// instance to find and `nat::eq_dec` is called by name. The polymorphic `count`
// wants a class keyed on that equation; the dictionary-passing spelling (take
// the decider as an argument and thread it through every call site) is an
// encoding around a missing feature and was not written.

// Counting with a named decider. `or_pick(d, x, y)` takes `y` on `Inl`, so the
// equal case is the `Succ`.
fn count(a: Nat, xs: List<Nat>) → Nat {
    match xs {
        Nil => 0,
        Cons(h, t) => or_pick(a.eq_dec(h), count(a, t), Succ(count(a, t))),
    }
}

// The one lemma the permutation proof needs, and it is about neither lists nor
// sorting: two independent decisions each of which may add one commute. It
// lives here rather than in `std/logic` because it mentions `Succ`, and `logic`
// is below `nat`.
//
// Four cases, all `refl`, and only ONE match needs to be written: substituting
// `Inr` for the outer decision makes both sides the same term, so the inner
// split is needed only on the `Inl` side.
theorem pick_succ_comm<P, Q, R, S>(d1: Or<P, Q>, d2: Or<R, S>, n: Nat):
    or_pick(d1, or_pick(d2, n, Succ(n)), Succ(or_pick(d2, n, Succ(n))))
        = or_pick(d2, or_pick(d1, n, Succ(n)), Succ(or_pick(d1, n, Succ(n))))
{
    match d1 as λ z =>
        or_pick(z, or_pick(d2, n, Succ(n)), Succ(or_pick(d2, n, Succ(n))))
            = or_pick(d2, or_pick(z, n, Succ(n)), Succ(or_pick(z, n, Succ(n))))
    {
        Inl(p) =>
            match d2 as λ w =>
                Succ(or_pick(w, n, Succ(n))) = or_pick(w, Succ(n), Succ(Succ(n)))
            {
                Inl(r) => refl,
                Inr(s) => refl,
            },
        Inr(q) => refl,
    }
}

// Inserting is consing, as far as counting can tell. The `Inl` arm — `x` goes
// in front — is `refl`, because there the two sides are the same list; all the
// work is in the arm where `x` sinks past `h`, and it is exactly the commuting
// lemma above with the IH rewritten in underneath it.
theorem count_insert(x: Nat, xs: List<Nat>, a: Nat):
    count(a, insert(x, xs)) = count(a, Cons(x, xs))
{
    match xs {
        Nil => {},
        Cons(h, t) =>
            match decide<x.Le(h)>() {
                Inl(good) => refl,
                Inr(bad) =>
                    trans(cong_fn(λ (n: Nat) => or_pick(a.eq_dec(h), n, Succ(n)),
                                  count_insert(x, t, a)),
                          pick_succ_comm(a.eq_dec(h), a.eq_dec(x), count(a, t))),
            },
    }
}

// The permutation half. `count_insert` at the recursive result, then the IH
// under the same one-place context — `std/list`'s `cong_fn` is what carries it,
// with the context written out as a lambda because it has to be
// (issues/congruence-by-anti-unification.md).
theorem count_isort(xs: List<Nat>, a: Nat): count(a, isort(xs)) = count(a, xs) {
    match xs {
        Nil => {},
        Cons(h, t) =>
            trans(count_insert(h, isort(t), a),
                  cong_fn(λ (n: Nat) => or_pick(a.eq_dec(h), n, Succ(n)),
                          count_isort(t, a))),
    }
}

// Length, which permutation implies but not by any proof this file can write —
// summing `count` over the elements is a fold this library does not have. Two
// recursions, both `cong_succ` over the tail.
theorem len_insert(x: Nat, xs: List<Nat>): insert(x, xs).len() = Succ(xs.len()) {
    match xs {
        Nil => {},
        Cons(h, t) =>
            match decide<x.Le(h)>() {
                Inl(good) => refl,
                Inr(bad) => Nat::cong_succ(len_insert(x, t)),
            },
    }
}

theorem len_isort(xs: List<Nat>): isort(xs).len() = xs.len() {
    match xs {
        Nil => {},
        Cons(h, t) => trans(len_insert(h, isort(t)), Nat::cong_succ(len_isort(t))),
    }
}

// The membership half, on `std/list`'s `Mem`. Weaker than `count_isort` and
// much cheaper; kept because it is the polymorphic statement of the same idea
// and because it is what a caller who only wants "nothing was invented" will
// cite.
theorem mem_insert(x: Nat, xs: List<Nat>, a: Nat):
    Mem(a, insert(x, xs)) → Mem(a, Cons(x, xs))
{
    match xs {
        Nil => λ m => m,
        Cons(h, t) =>
            match decide<x.Le(h)>() {
                Inl(good) => λ m => m,
                Inr(bad) => λ m => match m {
                    Inl(e) => Inr(Inl(e)),
                    Inr(m2) => match mem_insert(x, t, a, m2) {
                        Inl(e) => Inl(e),
                        Inr(mt) => Inr(Inr(mt)),
                    },
                },
            },
    }
}

theorem mem_isort(xs: List<Nat>, a: Nat): Mem(a, isort(xs)) → Mem(a, xs) {
    match xs {
        Nil => λ m => m,
        Cons(h, t) => λ m =>
            match mem_insert(h, isort(t), a, m) {
                Inl(e) => Inl(e),
                Inr(mt) => Inr(mem_isort(t, a, mt)),
            },
    }
}

// Both halves in one statement, which is the point of the wave: this is the
// first specification in the library that is a CONJUNCTION of a relation and an
// extensional equality, and it is the theorem a caller should cite.
theorem isort_correct(xs: List<Nat>):
    And<Sorted(isort(xs)), (a: Nat) → count(a, isort(xs)) = count(a, xs)>
{
    And(isort_sorted(xs), λ a => count_isort(xs, a))
}

// A bounded loop's machine trace against loop_run, by induction on the budget
// (docs/native-bounded-loops-design.md §4). A compilation supplies two local
// obligations over open states, one guard and one body iteration; the
// induction and the outcome case analysis are here, once.
import function_ir_loop;
import function_ir_loop_x86;
import function_ir_x86_support;
import bitvec_nat;
import x86_64;
import x86_64_block;
import x86_64_structured_block;
import x86_64_data_read;
import x86_64_access_code;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// The guard's decision in loop_run's order: end of input first, then budget.
fn loop_continues_from(ended: Bool, budget: Nat) → Bool {
    match ended { True => False, False => Nat::leb(1, budget) }
}
fn loop_continues(length, cursor, budget: Nat) → Bool {
    loop_continues_from(length.leb(cursor), budget)
}

// A Bool held in a register as the lowering places one-bit values.
fn loop_bit(bit: Bool) → BitVec(64) { BitVec::ofBool(bit).zero_extend(63) }

theorem loop_bit_zf<M>(register: Gpr, state: MachineState<M>, bit: Bool,
    placed: read_gpr(register, state.gprs) = loop_bit(bit)):
    structured_test(register, state).flags.zf = bit.not() {
    trans(j(placed, λ word _ => structured_test(register, state).flags.zf = test_flags(word, word, False).zf, refl),
        test_zero_extended_bool(bit))
}

// A Bool sits in its register as a placed bit (`loop_bit`), a Nat as its word
// (`LoopWord`, docs/native-bounded-loops-design.md §9a); the loop generator
// states each state's placement from these. Reading a Nat back needs a bound,
// which the counting invariant keeps: the count and the remaining budget
// together fit in a word, so no count can wrap. A step keeps it when it
// advances by at most one (LoopAdvancesByAtMostOne, function_ir_loop).
fn loop_fits(cursor, budget, carry: Nat) → Type { carry + budget < Nat::pow(2, 64) }

theorem loop_fits_bound(cursor, budget, carry: Nat, fits: loop_fits(cursor, budget, carry)):
    carry < Nat::pow(2, 64) {
    Succ(carry).le_trans(Succ(carry + budget), Nat::pow(2, 64), carry.le_add_l(budget), fits)
}

theorem loop_fits_step(cursor, rest, carry, next: Nat, fits: loop_fits(cursor, Succ(rest), carry),
    advance: next <= Succ(carry)):
    loop_fits(Succ(cursor), rest, next) {
    let grown = Nat::add_le_mono_r(rest, next, Succ(carry), advance);
    let shifted = j(Nat::add_succ_left(carry, rest), λ total _ => next + rest <= total, grown);
    Succ(next + rest).le_trans(Succ(carry + Succ(rest)), Nat::pow(2, 64), shifted, fits)
}

// A count that grew by at most the bytes read from zero fits a loop over the
// next `budget` bytes while the two are shorter than 2^64.
theorem loop_fits_from(carry, start, seen, budget: Nat, grown: carry <= start + seen, zero: start = 0,
    room: seen + budget < Nat::pow(2, 64)): loop_fits(0, budget, carry) {
    let moved = Nat::add_le_mono_r(budget, carry, start + seen, grown);
    let started = j(zero, λ s _ => carry + budget <= (s + seen) + budget, moved);
    let shifted = j(Nat::add_left_zero(seen), λ s _ => carry + budget <= s + budget, started);
    Succ(carry + budget).le_trans(Succ(seen + budget), Nat::pow(2, 64), shifted, room)
}

// The typed certificate's Nat premise from the head's word, and the head's
// word from the certificate's result under the bound.
theorem loop_nat_placed(word: BitVec(64), count: Nat, placed: LoopWord(64, word, count)):
    bitvec_nat::word_of_nat(64, count) = word {
    trans(sym(j(placed, λ value _ => bitvec_nat::word_of_nat(64, word.toNat()) = bitvec_nat::word_of_nat(64, value), refl)),
        bitvec_nat::word_of_nat_toNat(64, word))
}
theorem loop_nat_word(word: BitVec(64), count: Nat, computed: word = bitvec_nat::word_of_nat(64, count),
    bounded: count < Nat::pow(2, 64)):
    LoopWord(64, word, count) {
    j(sym(computed), λ found _ => found.toNat() = count, bitvec_nat::toNat_word_of_nat(64, count, bounded))
}

// Where a loop keeps its values. `flag` is the guard's result and survives
// the body, so at the exit it tells a Break from the other outcomes; `step`
// is the body's Continue/Break discriminator. `carry` names the state's first
// register; a state's placement is `rep`, over the register file
// (docs/native-wc-design.md §4.2), so a record's fields sit in several.
record LoopPlacement {
    base: Gpr, length: Gpr, needle: Gpr, cursor: Gpr, budget: Gpr, carry: Gpr, flag: Gpr, step: Gpr,
}

// The invariant at the loop's head. `rep` says how a carry sits in the
// registers; memory agreement is restated each iteration because execution
// preserves it.
record LoopHead<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), state: MachineState<M>, cursor, budget: Nat, carry: C) {
    base_placed: LoopWord(64, read_gpr(p.base, state.gprs), buffer.base),
    length_placed: LoopWord(64, read_gpr(p.length, state.gprs), buffer.length),
    needle_placed: read_gpr(p.needle, state.gprs) = needle.zero_extend(56),
    cursor_placed: LoopWord(64, read_gpr(p.cursor, state.gprs), cursor),
    budget_placed: LoopWord(64, read_gpr(p.budget, state.gprs), budget),
    carry_placed: rep(state.gprs, carry),
    inside: LoopBounds(buffer, cursor),
    memory_agrees: (word: BitVec(64)) → access.read(state.memory, word) = buffer.read(word.toNat()),
}

// A step that kept the five head registers, the carry's placement and memory
// keeps the invariant.
theorem loop_head_transport<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), before, after: MachineState<M>, cursor, budget: Nat, carry: C,
    head: LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, budget, carry),
    base: read_gpr(p.base, after.gprs) = read_gpr(p.base, before.gprs),
    length: read_gpr(p.length, after.gprs) = read_gpr(p.length, before.gprs),
    needle_kept: read_gpr(p.needle, after.gprs) = read_gpr(p.needle, before.gprs),
    cursor_kept: read_gpr(p.cursor, after.gprs) = read_gpr(p.cursor, before.gprs),
    budget_kept: read_gpr(p.budget, after.gprs) = read_gpr(p.budget, before.gprs),
    carry_kept: rep(after.gprs, carry),
    memory: after.memory = before.memory):
    LoopHead<M, C>(p, rep, access, buffer, needle, after, cursor, budget, carry) {
    let value = λ (word: BitVec(64)) => word.toNat();
    LoopHead(
        base_placed := trans(cong_fn(value, base), head.base_placed),
        length_placed := trans(cong_fn(value, length), head.length_placed),
        needle_placed := trans(needle_kept, head.needle_placed),
        cursor_placed := trans(cong_fn(value, cursor_kept), head.cursor_placed),
        budget_placed := trans(cong_fn(value, budget_kept), head.budget_placed),
        carry_placed := carry_kept,
        inside := head.inside,
        memory_agrees := λ word => trans(cong_fn(λ (state: M) => access.read(state, word), memory),
            head.memory_agrees(word)))
}

// The invariant one iteration later: the fixed registers kept, the counters
// and carry at their new words, memory unchanged.
theorem loop_head_advance<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), before, after: MachineState<M>, cursor, budget, rest: Nat, carry, next: C,
    head: LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, budget, carry),
    base: read_gpr(p.base, after.gprs) = read_gpr(p.base, before.gprs),
    length: read_gpr(p.length, after.gprs) = read_gpr(p.length, before.gprs),
    needle_kept: read_gpr(p.needle, after.gprs) = read_gpr(p.needle, before.gprs),
    cursor_next: LoopWord(64, read_gpr(p.cursor, after.gprs), Succ(cursor)),
    budget_next: LoopWord(64, read_gpr(p.budget, after.gprs), rest),
    carry_next: rep(after.gprs, next),
    open: buffer.length.leb(cursor) = False,
    memory: after.memory = before.memory):
    LoopHead<M, C>(p, rep, access, buffer, needle, after, Succ(cursor), rest, next) {
    let value = λ (word: BitVec(64)) => word.toNat();
    LoopHead(
        base_placed := trans(cong_fn(value, base), head.base_placed),
        length_placed := trans(cong_fn(value, length), head.length_placed),
        needle_placed := trans(needle_kept, head.needle_placed),
        cursor_placed := cursor_next,
        budget_placed := budget_next,
        carry_placed := carry_next,
        inside := loop_open_inside(buffer, cursor, open),
        memory_agrees := λ word => trans(cong_fn(λ (state: M) => access.read(state, word), memory),
            head.memory_agrees(word)))
}

// The two per-iteration obligations a compilation discharges (design §4).
fn LoopGuardStep<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), guard: AccessCode) → Type {
    (before: MachineState<M>) → (cursor, budget: Nat) → (carry: C) →
    LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, budget, carry) →
    Exists<MachineState<M>>(λ tested => ExecuteAccess(access, guard, before, tested) ∧
        ((read_gpr(p.flag, tested.gprs) = loop_bit(loop_continues(buffer.length, cursor, budget))) ∧
        LoopHead<M, C>(p, rep, access, buffer, needle, tested, cursor, budget, carry)))
}

fn LoopStepped<M, C>(p: LoopPlacement, rep: Gprs → C → Type, Inv: Nat → Nat → C → Type,
    access: ByteReadAccess<M>, buffer: ReadonlyBytes, needle: BitVec(8), before, done: MachineState<M>,
    cursor, rest: Nat, step: LoopStep<C>) → Type {
    (read_gpr(p.flag, done.gprs) = read_gpr(p.flag, before.gprs)) ∧
    match step as λ _ => Type {
        Continue(next) => (read_gpr(p.step, done.gprs) = loop_bit(False)) ∧
            (LoopHead<M, C>(p, rep, access, buffer, needle, done, Succ(cursor), rest, next) ∧ Inv(Succ(cursor), rest, next)),
        Break(result) => (read_gpr(p.step, done.gprs) = loop_bit(True)) ∧
            LoopHead<M, C>(p, rep, access, buffer, needle, done, Succ(cursor), rest, result),
    }
}

// LoopStepped from the body's two observed ports, whichever the step was.
theorem loop_stepped<M, C>(p: LoopPlacement, rep: Gprs → C → Type, Inv: Nat → Nat → C → Type,
    access: ByteReadAccess<M>, buffer: ReadonlyBytes, needle: BitVec(8), before, done: MachineState<M>,
    cursor, rest: Nat, kept: read_gpr(p.flag, done.gprs) = read_gpr(p.flag, before.gprs)):
    (step: LoopStep<C>) → read_gpr(p.step, done.gprs) = loop_bit(loop_step_breaks(step)) →
    LoopHead<M, C>(p, rep, access, buffer, needle, done, Succ(cursor), rest, loop_step_payload(step)) →
    Inv(Succ(cursor), rest, loop_step_payload(step)) →
    LoopStepped<M, C>(p, rep, Inv, access, buffer, needle, before, done, cursor, rest, step) {
    λ step => match step as λ s => read_gpr(p.step, done.gprs) = loop_bit(loop_step_breaks(s)) →
            LoopHead<M, C>(p, rep, access, buffer, needle, done, Succ(cursor), rest, loop_step_payload(s)) →
            Inv(Succ(cursor), rest, loop_step_payload(s)) →
            LoopStepped<M, C>(p, rep, Inv, access, buffer, needle, before, done, cursor, rest, s) {
        Continue(_) => λ stepped head inv => ⟨kept, ⟨stepped, ⟨head, inv⟩⟩⟩,
        Break(_) => λ stepped head _ => ⟨kept, ⟨stepped, head⟩⟩,
    }
}

fn LoopBodyStep<M, C>(p: LoopPlacement, rep: Gprs → C → Type, Inv: Nat → Nat → C → Type,
    access: ByteReadAccess<M>, buffer: ReadonlyBytes, needle: BitVec(8), region: ReadonlyLoop<C>,
    body: AccessCode) → Type {
    (before: MachineState<M>) → (cursor, rest: Nat) → (carry: C) → (byte: BitVec(8)) →
    LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, Succ(rest), carry) →
    Inv(cursor, Succ(rest), carry) → buffer.length.leb(cursor) = False → ReadsByte(buffer, cursor, byte) →
    Exists<MachineState<M>>(λ done => ExecuteAccess(access, body, before, done) ∧
        LoopStepped<M, C>(p, rep, Inv, access, buffer, needle, before, done, cursor, rest,
            region.body(needle, cursor, byte, carry)))
}

// The exit interface (design §2). `flag` is set only after a Break; End and
// Exhausted are told apart by cursor against length, as loop_run orders them.
// Denied has no machine exit: LoopReadable rules it out.
fn LoopExitRegisters<M, C>(p: LoopPlacement, rep: Gprs → C → Type, state: MachineState<M>,
    broke: Bool, cursor, remaining: Nat, carry: C) → Type {
    (read_gpr(p.flag, state.gprs) = loop_bit(broke)) ∧
    (LoopWord(64, read_gpr(p.cursor, state.gprs), cursor) ∧
    (LoopWord(64, read_gpr(p.budget, state.gprs), remaining) ∧ rep(state.gprs, carry)))
}

fn LoopObserved<M, C>(p: LoopPlacement, rep: Gprs → C → Type, state: MachineState<M>,
    outcome: LoopOutcome<C>) → Type {
    match outcome {
        End(cursor, remaining, carry) => LoopExitRegisters<M, C>(p, rep, state, False, cursor, remaining, carry),
        Exhausted(cursor, carry) => LoopExitRegisters<M, C>(p, rep, state, False, cursor, 0, carry),
        Denied(_, _, _) => False,
        Early(cursor, remaining, result) => LoopExitRegisters<M, C>(p, rep, state, True, cursor, remaining, result),
    }
}

theorem loop_exit_registers<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), state: MachineState<M>, cursor, budget: Nat, carry: C, broke: Bool,
    head: LoopHead<M, C>(p, rep, access, buffer, needle, state, cursor, budget, carry),
    flag: read_gpr(p.flag, state.gprs) = loop_bit(broke)):
    LoopExitRegisters<M, C>(p, rep, state, broke, cursor, budget, carry) {
    ⟨flag, ⟨head.cursor_placed, ⟨head.budget_placed, head.carry_placed⟩⟩⟩
}

// The loop's execution relation, as AccessLoop gives it.
fn LoopExecutes<M>(access: ByteReadAccess<M>, guard: AccessCode, flag: Gpr, exit: BitVec(32),
    body: AccessCode, step: Gpr, back: BitVec(32), before, after: MachineState<M>) → Type {
    ExecuteAccess(access, AccessLoop(guard, flag, exit, body, step, back), before, after)
}

// Every iteration runs the guard; this is the path out through its edge.
theorem loop_trace_stop<M, C>(p: LoopPlacement, rep: Gprs → C → Type, access: ByteReadAccess<M>,
    buffer: ReadonlyBytes, needle: BitVec(8), guard, body: AccessCode, exit, back: BitVec(32),
    before, tested: MachineState<M>, cursor, budget: Nat, carry: C, outcome: LoopOutcome<C>,
    checked: ExecuteAccess(access, guard, before, tested),
    stopped: read_gpr(p.flag, tested.gprs) = loop_bit(False),
    head: LoopHead<M, C>(p, rep, access, buffer, needle, tested, cursor, budget, carry),
    observed: LoopExitRegisters<M, C>(p, rep, tested, False, cursor, budget, carry) →
        LoopObserved<M, C>(p, rep, tested, outcome)):
    Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
        LoopObserved<M, C>(p, rep, after, outcome)) {
    Exists(loop_edge(p.flag, exit, tested), ⟨
        Exists(0, loop_runs_exit(ExecuteAccess(access, guard), ExecuteAccess(access, body), p.flag, exit, p.step, back,
            before, tested, checked, loop_bit_zf(p.flag, tested, False, stopped))),
        observed(loop_exit_registers(p, rep, access, buffer, needle, tested, cursor, budget, carry, False, head, stopped))⟩)
}

theorem loop_trace<M, C>(p: LoopPlacement, rep: Gprs → C → Type, Inv: Nat → Nat → C → Type,
    access: ByteReadAccess<M>, buffer: ReadonlyBytes, needle: BitVec(8), region: ReadonlyLoop<C>,
    guard, body: AccessCode, exit, back: BitVec(32),
    guard_step: LoopGuardStep<M, C>(p, rep, access, buffer, needle, guard),
    body_step: LoopBodyStep<M, C>(p, rep, Inv, access, buffer, needle, region, body)):
    (budget: Nat) → (before: MachineState<M>) → (cursor: Nat) → (carry: C) →
    LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, budget, carry) → Inv(cursor, budget, carry) →
    LoopReadable(budget, region, buffer, needle, cursor, carry) →
    Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
        LoopObserved<M, C>(p, rep, after, loop_run(budget, region, buffer, needle, cursor, carry))) {
    λ budget => match budget as λ b => (before: MachineState<M>) → (cursor: Nat) → (carry: C) →
            LoopHead<M, C>(p, rep, access, buffer, needle, before, cursor, b, carry) → Inv(cursor, b, carry) →
            LoopReadable(b, region, buffer, needle, cursor, carry) →
            Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
                LoopObserved<M, C>(p, rep, after, loop_run(b, region, buffer, needle, cursor, carry))) {
        Zero => λ before cursor carry head inv readable => {
            let guarded = guard_step(before, cursor, 0, carry, head);
            let tested = guarded.witness;
            let flag = guarded.proof.right.left;
            (match buffer.length.leb(cursor) as λ e => (buffer.length.leb(cursor) = e) →
                    Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
                        LoopObserved<M, C>(p, rep, after, loop_run(0, region, buffer, needle, cursor, carry))) {
                True => λ ended => loop_trace_stop(p, rep, access, buffer, needle, guard, body, exit, back, before, tested,
                    cursor, 0, carry, loop_run(0, region, buffer, needle, cursor, carry), guarded.proof.left,
                    trans(flag, cong_fn(loop_bit, j(sym(ended), λ e _ => loop_continues_from(e, 0) = False, refl))),
                    guarded.proof.right.right,
                    λ regs => j(sym(loop_run_end(region, buffer, needle, cursor, carry, ended, 0)),
                        λ outcome _ => LoopObserved<M, C>(p, rep, tested, outcome), regs)),
                False => λ open => loop_trace_stop(p, rep, access, buffer, needle, guard, body, exit, back, before, tested,
                    cursor, 0, carry, loop_run(0, region, buffer, needle, cursor, carry), guarded.proof.left,
                    trans(flag, cong_fn(loop_bit, j(sym(open), λ e _ => loop_continues_from(e, 0) = False, refl))),
                    guarded.proof.right.right,
                    λ regs => j(sym(loop_run_exhausted(region, buffer, needle, cursor, carry, open)),
                        λ outcome _ => LoopObserved<M, C>(p, rep, tested, outcome), regs)),
            })(refl)
        },
        Succ(rest, ih) => λ before cursor carry head inv readable => {
            let guarded = guard_step(before, cursor, Succ(rest), carry, head);
            let tested = guarded.witness;
            let flag = guarded.proof.right.left;
            (match buffer.length.leb(cursor) as λ e => (buffer.length.leb(cursor) = e) →
                    Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
                        LoopObserved<M, C>(p, rep, after, loop_run(Succ(rest), region, buffer, needle, cursor, carry))) {
                True => λ ended => loop_trace_stop(p, rep, access, buffer, needle, guard, body, exit, back, before, tested,
                    cursor, Succ(rest), carry, loop_run(Succ(rest), region, buffer, needle, cursor, carry), guarded.proof.left,
                    trans(flag, cong_fn(loop_bit, j(sym(ended), λ e _ => loop_continues_from(e, Succ(rest)) = False, refl))),
                    guarded.proof.right.right,
                    λ regs => j(sym(loop_run_end(region, buffer, needle, cursor, carry, ended, Succ(rest))),
                        λ outcome _ => LoopObserved<M, C>(p, rep, tested, outcome), regs)),
                False => λ open => {
                    let entered = trans(flag, cong_fn(loop_bit,
                        j(sym(open), λ e _ => loop_continues_from(e, Succ(rest)) = True, refl)));
                    let entry = loop_edge(p.flag, exit, tested);
                    let found = loop_readable_byte(rest, region, buffer, needle, cursor, carry, open, readable);
                    let byte = found.witness;
                    let stepped = body_step(entry, cursor, rest, carry, byte, guarded.proof.right.right, inv, open, found.proof);
                    let done = stepped.witness;
                    (match region.body(needle, cursor, byte, carry) as λ chosen =>
                            (region.body(needle, cursor, byte, carry) = chosen) →
                            Exists<MachineState<M>>(λ after => LoopExecutes(access, guard, p.flag, exit, body, p.step, back, before, after) ∧
                                LoopObserved<M, C>(p, rep, after, loop_run(Succ(rest), region, buffer, needle, cursor, carry))) {
                        Continue(next) => λ chose => {
                            let local = j(chose, λ chosen _ => LoopStepped<M, C>(p, rep, Inv, access, buffer, needle, entry, done,
                                cursor, rest, chosen), stepped.proof.right);
                            let outcome = loop_run_step(rest, region, buffer, needle, cursor, carry, byte, Continue(next),
                                open, found.proof, chose);
                            let later = ih(loop_edge(p.step, back, done), Succ(cursor), next, local.right.right.left,
                                local.right.right.right,
                                j(outcome, λ o _ => LoopFinishedNormally(o), readable));
                            let runs = later.proof.left;
                            Exists(later.witness, ⟨
                                Exists(Succ(runs.witness), loop_runs_continue(ExecuteAccess(access, guard), ExecuteAccess(access, body),
                                    p.flag, exit, p.step, back, runs.witness, before, tested, done, later.witness,
                                    guarded.proof.left, loop_bit_zf(p.flag, tested, True, entered), stepped.proof.left,
                                    loop_bit_zf(p.step, done, False, local.right.left), runs.proof)),
                                j(sym(outcome), λ o _ => LoopObserved<M, C>(p, rep, later.witness, o), later.proof.right)⟩)
                        },
                        Break(result) => λ chose => {
                            let local = j(chose, λ chosen _ => LoopStepped<M, C>(p, rep, Inv, access, buffer, needle, entry, done,
                                cursor, rest, chosen), stepped.proof.right);
                            let outcome = loop_run_step(rest, region, buffer, needle, cursor, carry, byte, Break(result),
                                open, found.proof, chose);
                            let regs = loop_exit_registers(p, rep, access, buffer, needle, done, Succ(cursor), rest, result, True,
                                local.right.right, trans(local.left, entered));
                            Exists(loop_edge(p.step, back, done), ⟨
                                Exists(0, loop_runs_break(ExecuteAccess(access, guard), ExecuteAccess(access, body),
                                    p.flag, exit, p.step, back, before, tested, done,
                                    guarded.proof.left, loop_bit_zf(p.flag, tested, True, entered), stepped.proof.left,
                                    loop_bit_zf(p.step, done, True, local.right.left))),
                                j(sym(outcome), λ o _ => LoopObserved<M, C>(p, rep, loop_edge(p.step, back, done), o), regs)⟩)
                        },
                    })(refl)
                },
            })(refl)
        },
    }
}

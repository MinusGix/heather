// `algebra` — the library's first classes, and the instances the other
// `std` modules' carriers earn (docs/traits-design.md, issues/traits.md).
//
// Everything here is sugar over records and globals: a `class` is the record
// its fields describe, an `instance` is a namespace of ordinary declarations
// with the record assembled at the end. Nothing new reaches the kernel.
//
// The operation is an INDEX, not a field
// (docs/operation-indexed-classes-design.md): `Monoid<Bool>(and)` and
// `Monoid<Bool>(or)` are different types, so both register as equals and
// nothing here has to nominate one. That deletes the coherence essay this
// file carried until 2026-08-09, and with it the additive hierarchy
// (`AddSemigroup` → `AddMonoid` → `AddCommMonoid`) that existed only to say
// "the other monoid" under different field names.

import bool;
import nat;
import list;
import option;

// ---------------------------------------------------------------------------
// The classes.

// A monoid: an associative operation with a two-sided unit. `op` is the
// class's index, so `A` and `op` together identify the structure, and the
// unit — determined by the operation, definitionally at every concrete
// instance — stays a field (design §2.1).
class Semigroup<A>(op: A -> A -> A) {
    assoc: (x: A) -> (y: A) -> (z: A) -> op(op(x, y), z) = op(x, op(y, z)),
}

class Monoid<A>(op: A -> A -> A) extends Semigroup<A>(op) {
    unit: A,
    unit_l: (x: A) -> op(unit, x) = x,
    unit_r: (x: A) -> op(x, unit) = x,
}

// The commutative monoid: one chain, at every operation. This is what the
// additive hierarchy was, with the operation moved out of the field list —
// which is why there is only one of it now.
class CommMonoid<A>(op: A -> A -> A) extends Monoid<A>(op) {
    comm: (x: A) -> (y: A) -> op(x, y) = op(y, x),
}

// A value every type of the class has. No laws: `Default` is the class that
// exists to be *found*, which is the whole content of `or_default`.
class Default<A> {
    default: A,
}

// A decided order: a `Bool`-valued comparison, reflexive in the shape
// `std/nat` states its order in (`Le(n, m)` is `leb(n)(m) = True`, so a
// `Nat` proof of either shape is a proof of the other and `nat::le_refl`
// fills `le_refl` verbatim).
//
// The field is `le` and NOT `leb`, which is what `std/nat` calls the function
// filling it. A class field that shares a name with a global in scope can
// never be reached by a receiver: `x.leb(y)` is ambiguous between the member
// and the bare call, and the elaborator says so by name rather than picking
// (which is right — the two are different functions at the same spelling).
// Naming a field is therefore a *library* decision about the ambient
// namespace, not a local one. See issues/traits.md's log for the finding.
//
// `Cmp` and `Default` take no index: their structure is identified by the
// carrier alone, and indexing is opt-in per class (design §2.1).
class Cmp<A> {
    le: A -> A -> Bool,
    le_refl: (x: A) -> le(x)(x) = True,
}

// ---------------------------------------------------------------------------
// Instances at the library's carriers.
//
// Every one of these is written in LITERAL form — `field := global` — because
// every fact it needs was already proved in the module that owns the carrier.
// That is the form's purpose (docs/traits-design.md §3): assembling an
// instance out of the library's own names, rather than moving definitions
// into a block and leaving every existing caller of `append_assoc` to find it
// under a new one. Where a field is a one-liner nobody would name (`unit_r`
// for `add`, which is `refl`), it is written inline.
//
// Both `Bool` monoids register, as equals. Neither is "the" one, because no
// goal with an unpinned operation ever reaches the registry (design §5).

instance CommMonoid<Nat>(add) {
    unit := 0,
    assoc := add_assoc,
    unit_l := add_left_zero,
    unit_r := λ (x: Nat) => refl,
    comm := add_comm,
}

instance CommMonoid<Bool>(and) {
    unit := True,
    assoc := and_assoc,
    unit_l := and_true_l,
    unit_r := and_true_r,
    comm := and_comm,
}

instance CommMonoid<Bool>(or) {
    unit := False,
    assoc := or_assoc,
    unit_l := or_false_l,
    unit_r := or_false_r,
    comm := or_comm,
}

// The generic instance: one declaration, an instance at every element type.
// Not commutative, and it does not have to be — the chain is one class per
// law, and `append` stops at `Monoid`.
instance<A> Monoid<List<A>>(append) {
    unit := Nil,
    assoc := append_assoc,
    unit_l := λ (xs: List<A>) => refl,
    unit_r := append_nil,
}

instance Default<Nat> { default := 0 }
instance Default<Bool> { default := False }
instance<A> Default<List<A>> { default := Nil }
instance<A> Default<Option<A>> { default := None }

instance Cmp<Nat> { le := leb, le_refl := le_refl }
instance Cmp<Bool> { le := leb_bool, le_refl := leb_bool_refl }

// ---------------------------------------------------------------------------
// The consumers: written once against a class, used at every carrier.

// The fold every monoid is for, in the LINKED form (design §4.1): the
// operation is a written parameter and the constraint's index slot says it is
// the same one, so callers choose the structure positionally and nothing is
// searched for. `op` is an ordinary variable in the body; `A.unit` is answered
// by the binder in scope, which is the value-slot ladder's step 2.
fn mconcat<A: Monoid(op)>(op: A -> A -> A, xs: List<A>) -> A {
    match xs {
        Nil => A.unit,
        Cons(h, t) => op(h, mconcat(op, t)),
    }
}

// Proved once against the class. Its uses below are at unrelated carriers and
// neither re-proves anything. `A.unit_r` is a **proof** field projected from
// the type, which needs nothing of its own: a type projection is an ordinary
// field projection, so an operation and a law are the same move.
theorem mconcat_single<A: Monoid(op)>(op: A -> A -> A, x: A):
    mconcat(op, Cons(x, Nil)) = x
{
    A.unit_r(x)
}

// The order consumer: the class's `le` decides which of two values to keep.
// The branch is a separate `fn` for the reason `list_algos`'s `ins_pick` is
// one — a `match` on a stuck `Bool` is a scrutinee no equation can reach, and
// hoisting it makes one `j` enough. A class projection is exactly such a
// scrutinee, so the pattern is the same one, not a new one.
fn cmp_pick<A>(b: Bool, x: A, y: A) -> A { match b { False => x, True => y } }

// Written in the INLINE constraint form (issues/requires-placement-syntax.md
// §R2-A): none of these names the dictionary — `x.le(y)` dispatches from the
// receiver and `A.le_refl(x)` projects from the type — so there is nothing for
// a binder name to do, and `<A: Cmp>` says the whole of what is true about `A`.
//
// `A.le_refl` is also where the *other-reading* rule earns its keep:
// `std/nat`'s `le_refl` is an ambient global, and `x.le_refl()` on a receiver
// would be ambiguous against it. On a **type** subject it is not, because the
// desugaring would put a type in `le_refl`'s `Nat` slot — a reading the
// declaration refuses (docs/traits-type-projection-design.md §4).
fn max_of<A: Cmp>(x: A, y: A) -> A { cmp_pick(x.le(y), x, y) }

theorem max_of_true<A: Cmp>(x: A, y: A, p: x.le(y) = True):
    max_of(x, y) = y
{
    j(sym(p), λ z q => cmp_pick(z, x, y) = y, refl)
}

theorem max_of_self<A: Cmp>(x: A): max_of(x, x) = x {
    max_of_true(x, x, A.le_refl(x))
}

// `Default` earns its keep here: the caller of `or_default` names no
// dictionary and no fallback value. Spelled `:= infer` rather than
// `requires`, which is the same mechanism (docs/traits-layer2-design.md) with
// the binder where a defaulted argument goes.
fn or_default<A>(o: Option<A>, d: Default<A> := infer) -> A {
    unwrap_or(o, d.default)
}

// The chain's generic consequence: a right unit follows from commutativity and
// the left one, so `Monoid`'s `unit_r` is redundant *for a commutative
// monoid*. Written in the EMPTY-slot form (design §4.1's style rule: programs
// link their index, theory leaves the slot empty), so `op` is the binder's own
// index and every corollary below pins it by unification from its own
// statement — one proof, three structures, two of them on one carrier.
theorem op_unit_of_comm<A: CommMonoid>(x: A): op(x, A.unit) = x {
    trans(A.comm(x, A.unit), A.unit_l(x))
}

// ---------------------------------------------------------------------------
// The specializations, one per way an instance can be found.

// The index, spelled positionally: `sum` and `all_of` and `any_of` are the
// same fold at three structures, and each says which. `any_of` used to
// `let`-shadow the registry, because there was no other way to reach Bool's
// second monoid; now it is one word.
fn sum(ns: List<Nat>) -> Nat { mconcat(add, ns) }

fn all_of(bs: List<Bool>) -> Bool { mconcat(and, bs) }

fn any_of(bs: List<Bool>) -> Bool { mconcat(or, bs) }

// The GENERIC instance, at an **open** element type: the goal is
// `Monoid<List<A>>(append)` with `A` this function's own parameter, so it is
// answered by backchaining through `instance<A> Monoid<List<A>>(append)` and
// not by any declared value.
fn concat<A>(xss: List<List<A>>) -> List<A> { mconcat(append, xss) }

// The class lemma at two carriers. Neither of these re-proves anything: they
// are `mconcat_single` with the dictionary found — at `Nat` through the
// registry, at `Bool` likewise, and the two folds are different functions.
//
// The third carrier, `List<A>`, is NOT here: `mconcat_single` instantiated at
// a list carrier exhausts the kernel's conversion fuel, whichever way round
// the statement is written (issues/class-lemma-instantiation-fuel.md, with
// the twenty-line reproducer and the three probes that place the cost). The
// *uses* — `concat` above — are unaffected and cheap; it is the generic
// lemma's instantiation that dies. Nothing here works around it: the missing
// theorem is left missing so that the issue closing restores it.
theorem sum_single(n: Nat): sum(Cons(n, Nil)) = n { mconcat_single(add, n) }

theorem all_of_single(b: Bool): all_of(Cons(b, Nil)) = b { mconcat_single(and, b) }

theorem any_of_single(b: Bool): any_of(Cons(b, Nil)) = b { mconcat_single(or, b) }

// The generic law, spent three times. Each goal names its operation — that is
// what a law is — so unification pins the index and the ground goal hits the
// registry key. Two of the three are the same carrier, which is the sentence
// the additive hierarchy existed to fail to say.
theorem nat_add_zero(x: Nat): add(x, 0) = x { op_unit_of_comm(x) }

theorem bool_and_true(x: Bool): and(x, True) = x { op_unit_of_comm(x) }

theorem bool_or_false(x: Bool): or(x, False) = x { op_unit_of_comm(x) }

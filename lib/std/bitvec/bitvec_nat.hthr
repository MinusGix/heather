// Unsigned word/Nat bridges. Two halves: the modular one first, where a word
// is its value modulo `2^n` and every equation holds at every width; then the
// no-overflow facts, which read a word's value as the Nat itself under a
// bound, and are the modular ones with `Nat::mod_of_lt`.
import bitvec;
import bool;
import logic;
import nat;
import int;

// ---------------------------------------------------------------------------
// The modular half (issues/machine-words-modular-ring.md): `BitVec(n)` is
// ℤ/2ⁿ. `ofNat` reads its argument modulo `2^n` at every width
// (`toNat_ofNat_mod`), every operation is `ofNat` of the Nat operation on its
// operands' values (`add_eq_ofNat`, `sub_eq_ofNat`, `neg_eq_ofNat`, `mul` by
// definition), and so `ofNat` is a semiring homomorphism at every width
// (`ofNat_add`, `ofNat_mul`, `ofNat_pow`). No bound anywhere; the
// no-overflow facts after this section are these with `Nat::mod_of_lt`.

// A word is its value: equal values are equal words.
theorem BitVec::toNat_inj(n: Nat, {a, b: BitVec(n)}, p: a.toNat() = b.toNat()): a = b {
    trans(sym(BitVec::ofNat_toNat(n, a)), trans(BitVec::ofNat_cong(n, p), BitVec::ofNat_toNat(n, b)))
}

// Equality of words is equality of their values.
theorem BitVec::eq_bit_nat(n: Nat, a, b: BitVec(n)): a.eq_bit(b) = a.toNat().same(b.toNat()) {
    match e: a.eq_bit(b) {
        True => sym(rewrite(BitVec::eq_of_eq_bit(n, a, b, e), b.toNat().same_self())),
        False => match s: a.toNat().same(b.toNat()) {
            False => refl,
            True => {
                let same: (a.eq_bit(b) = True) = rewrite(BitVec::toNat_inj(n, a.toNat().same_sound(b.toNat(), s)), BitVec::eq_bit_self(n, b));
                absurd(trans(sym(e), same))
            },
        },
    }
}

// `ofNat` keeps the low `n` digits: its value is the argument modulo `2^n`.
// The recursion is `ofNat`'s, on the width; the step is `div_mod_unique` at
// the low bit plus twice the induction hypothesis.
theorem BitVec::toNat_ofNat_mod(n: Nat): (x: Nat) → BitVec::ofNat(x, n := n).toNat() = x.mod(Nat::pow(2, n)) {
    match n {
        Zero => λ x => sym(x.mod_one()),
        Succ(k, ih) => λ x => {
            let p = Nat::pow(2, k);
            let h = Nat::half(x);
            let o = Nat::of_bit(BitVec::odd_bit(x));
            let s = h.mod(p);
            let parts: (h.div(p) * Nat::pow(2, k + 1) + (o + s.twice()) = x) = calc {
                h.div(p) * Nat::pow(2, k + 1) + (o + s.twice())
                    = h.div(p) * p.twice() + (o + s.twice()) := prelude::cong(BitVec::pow_two_succ_twice(k)),
                    = (h.div(p) * p).twice() + (o + s.twice()) := prelude::cong(h.div(p).mul_twice(p)),
                    = o + ((h.div(p) * p).twice() + s.twice()) := (h.div(p) * p).twice().add_left_comm(o, s.twice()),
                    = o + (h.div(p) * p + s).twice() := prelude::cong(sym((h.div(p) * p).twice_add(s))),
                    = o + h.twice() := prelude::cong(h.div_mul_add_mod(p)),
                    = x := BitVec::odd_bit_add_twice_half(x),
            };
            let below: (o + s.twice() < Nat::pow(2, k + 1)) =
                rewrite(BitVec::pow_two_succ_twice(k), BitVec::bit_twice_lt(BitVec::odd_bit(x), s, p, h.mod_lt(p)));
            trans(Nat::cong(λ (w: Nat) => o + w.twice(), ih(h)),
                sym(x.div_mod_unique(Nat::pow(2, k + 1), h.div(p), o + s.twice(), parts, below).right))
        },
    }
}

// So it is at most the argument: a length kept as a word bounds no more
// than the length.
theorem BitVec::toNat_ofNat_le(n: Nat, x: Nat): BitVec::ofNat(x, n := n).toNat() <= x {
    let m = Nat::pow(2, n);
    let below: (x.mod(m) <= x) = j(Nat::div_mul_add_mod(x, m), λ t _ => x.mod(m) <= t, Nat::le_add_r(x.div(m) * m, x.mod(m)));
    j(sym(BitVec::toNat_ofNat_mod(n, x)), λ v _ => v <= x, below)
}

// A word under a mask is at most the mask, and at most the word: a bit of
// `x & y` is set only where both are. So `x & 15` indexes a ring of sixteen
// words (issues/bv-omega-masked-word-bound.md); `bv_omega` states the right
// one for every `&` it meets.
theorem BitVec::of_bit_and_le(a, b: Bool): Nat::of_bit(a && b) <= Nat::of_bit(a) {
    match a {
        False => trivial,
        True => match b { False => trivial, True => trivial },
    }
}

theorem BitVec::toNat_band_le_left(n: Nat): (x, y: BitVec(n)) → x.band(y).toNat() <= x.toNat() {
    match n {
        Zero => λ x y => trivial,
        Succ(_, ih) => λ x y => Nat::add_le_mono(Nat::of_bit(x.head_bit() && y.head_bit()), Nat::of_bit(x.head_bit()),
            x.tail_bits().band(y.tail_bits()).toNat().twice(), x.tail_bits().toNat().twice(),
            BitVec::of_bit_and_le(x.head_bit(), y.head_bit()),
            Nat::twice_le_twice_iff(x.tail_bits().band(y.tail_bits()).toNat(), x.tail_bits().toNat()).mpr(ih(x.tail_bits(), y.tail_bits()))),
    }
}

theorem BitVec::toNat_band_le_right(n: Nat, x, y: BitVec(n)): x.band(y).toNat() <= y.toNat() {
    j(sym(BitVec::band_comm(n, x, y)), λ w _ => w.toNat() <= y.toNat(), BitVec::toNat_band_le_left(n, y, x))
}

// An or is at most its operands added: a bit of `x | y` is set where one of
// them has it, and where both do the sum carries. Exact where no bit is
// set in both, which is what bytes joined by shifts are.
theorem BitVec::of_bit_or_le(a, b: Bool): Nat::of_bit(a || b) <= Nat::of_bit(a) + Nat::of_bit(b) {
    match a {
        False => match b { False => trivial, True => trivial },
        True => match b { False => trivial, True => trivial },
    }
}

theorem BitVec::toNat_bor_le_add(n: Nat): (x, y: BitVec(n)) → x.bor(y).toNat() <= x.toNat() + y.toNat() {
    match n {
        Zero => λ x y => trivial,
        Succ(_, ih) => λ x y => {
            let t = x.tail_bits().bor(y.tail_bits()).toNat();
            let u = x.tail_bits().toNat();
            let v = y.tail_bits().toNat();
            let tails: (t.twice() <= u.twice() + v.twice()) =
                j(Nat::twice_add(u, v), λ w _ => t.twice() <= w, Nat::twice_le_twice_iff(t, u + v).mpr(ih(x.tail_bits(), y.tail_bits())));
            j(Nat::add_swap_middle(Nat::of_bit(x.head_bit()), Nat::of_bit(y.head_bit()), u.twice(), v.twice()),
                λ w _ => Nat::of_bit(x.head_bit() || y.head_bit()) + t.twice() <= w,
                Nat::add_le_mono(Nat::of_bit(x.head_bit() || y.head_bit()), Nat::of_bit(x.head_bit()) + Nat::of_bit(y.head_bit()),
                    t.twice(), u.twice() + v.twice(), BitVec::of_bit_or_le(x.head_bit(), y.head_bit()), tails))
        },
    }
}

// With the mask a numeral: `(x & 15).toNat() <= 15`, the form `bv_omega`
// states, the literal's value read past the width (`toNat_ofNat_le`).
theorem BitVec::toNat_band_ofNat_le(n: Nat, x: BitVec(n), m: Nat): x.band(BitVec::ofNat(m)).toNat() <= m {
    Nat::le_trans(x.band(BitVec::ofNat(m)).toNat(), BitVec::ofNat(m, n := n).toNat(), m,
        BitVec::toNat_band_le_right(n, x, BitVec::ofNat(m)), BitVec::toNat_ofNat_le(n, m))
}

theorem BitVec::ofNat_mod(n, x: Nat): BitVec::ofNat(x.mod(Nat::pow(2, n)), n := n) = BitVec::ofNat(x) {
    trans(BitVec::ofNat_cong(n, sym(BitVec::toNat_ofNat_mod(n, x))), BitVec::ofNat_toNat(n, BitVec::ofNat(x)))
}

// Congruent naturals are the same word.
theorem BitVec::ofNat_modeq(n: Nat, {a, b: Nat}, h: Nat::ModEq(Nat::pow(2, n), a, b)):
    BitVec::ofNat(a, n := n) = BitVec::ofNat(b)
{
    trans(sym(BitVec::ofNat_mod(n, a)), trans(BitVec::ofNat_cong(n, h), BitVec::ofNat_mod(n, b)))
}

// The words of `0` and of `2^n` are one word.
theorem BitVec::ofNat_pow_two(n: Nat): BitVec::ofNat(Nat::pow(2, n), n := n) = BitVec::ofNat(0) {
    BitVec::ofNat_modeq(n, Nat::pow(2, n).mod_self())
}

theorem BitVec::iterate_increment_ofNat(n, x, count: Nat):
    BitVec::ofNat(x, n := n).iterate_increment(count) = BitVec::ofNat(x + count)
{
    match count {
        Zero => refl,
        Succ(c) => {
            let prev: (BitVec::ofNat(x, n := n).iterate_increment(c) = BitVec::ofNat(x + c)) = BitVec::iterate_increment_ofNat(n, x, c);
            trans(@cong(λ (w: BitVec(n)) => w.increment(), BitVec::ofNat(x, n := n).iterate_increment(c), BitVec::ofNat(x + c), prev),
                BitVec::increment_ofNat(n, x + c))
        },
    }
}

theorem BitVec::iterate_decrement_ofNat(n, x, count: Nat):
    BitVec::ofNat(x + count, n := n).iterate_decrement(count) = BitVec::ofNat(x)
{
    match count {
        Zero => refl,
        Succ(c) => {
            let prev: (BitVec::ofNat(x + c, n := n).iterate_decrement(c) = BitVec::ofNat(x)) = BitVec::iterate_decrement_ofNat(n, x, c);
            let back: (BitVec::ofNat(x + c + 1, n := n).decrement() = BitVec::ofNat(x + c)) =
                trans(@cong(λ (w: BitVec(n)) => w.decrement(), BitVec::ofNat(x + c + 1, n := n), BitVec::ofNat(x + c).increment(),
                    sym(BitVec::increment_ofNat(n, x + c))),
                    BitVec::decrement_increment(n, BitVec::ofNat(x + c)));
            trans(BitVec::cong_iterate_decrement(n, c, back), prev)
        },
    }
}

// The operations, each `ofNat` of the Nat operation on the values.
theorem BitVec::add_eq_ofNat(n: Nat, a, b: BitVec(n)): a.add(b) = BitVec::ofNat(a.toNat() + b.toNat()) {
    trans(sym(BitVec::iter_add_eq_add(n, a, b)),
        trans(@cong(λ (w: BitVec(n)) => w.iterate_increment(b.toNat()), a, BitVec::ofNat(a.toNat()), sym(BitVec::ofNat_toNat(n, a))),
            BitVec::iterate_increment_ofNat(n, a.toNat(), b.toNat())))
}

// `a - b` is `a + 2^n - b`: the borrow out of the top is the `2^n` added.
theorem BitVec::sub_eq_ofNat(n: Nat, a, b: BitVec(n)): a.sub(b) = BitVec::ofNat(a.toNat() + Nat::pow(2, n) - b.toNat()) {
    let w = Nat::pow(2, n);
    let d = a.toNat() + w - b.toNat();
    let fits: (b.toNat() <= a.toNat() + w) =
        b.toNat().le_trans(w, a.toNat() + w, Nat::le_of_lt(b.toNat(), w, BitVec::toNat_lt_pow(n, b)), a.toNat().le_add_r(w));
    let wrapped: (BitVec::ofNat(d + b.toNat(), n := n) = a) =
        trans(BitVec::ofNat_cong(n, b.toNat().sub_add_cancel(a.toNat() + w, fits)),
        trans(BitVec::ofNat_modeq(n, trans(Nat::cong(λ (y: Nat) => (a.toNat() + y).mod(w), sym(w.mul_left_one())), a.toNat().modeq_add_mul(w, 1))),
            BitVec::ofNat_toNat(n, a)));
    trans(sym(BitVec::iter_sub_eq_sub(n, a, b)),
        trans(BitVec::cong_iterate_decrement(n, b.toNat(), sym(wrapped)), BitVec::iterate_decrement_ofNat(n, d, b.toNat())))
}

theorem BitVec::neg_eq_ofNat(n: Nat, a: BitVec(n)): a.neg() = BitVec::ofNat(Nat::pow(2, n) - a.toNat()) {
    trans(sym(BitVec::iter_neg_eq_neg(n, a)),
        trans(BitVec::iter_sub_eq_sub(n, BitVec::zero(), a),
        trans(BitVec::sub_eq_ofNat(n, BitVec::zero(), a),
            BitVec::ofNat_cong(n, Nat::cong(λ (y: Nat) => y - a.toNat(),
                trans(Nat::cong(λ (y: Nat) => y + Nat::pow(2, n), BitVec::zero_toNat(n)), Nat::pow(2, n).add_left_zero()))))))
}

// The values, modulo `2^n` (P6 of docs/surveys/native-mathematics-survey.md).
theorem BitVec::toNat_add_mod(n: Nat, a, b: BitVec(n)): a.add(b).toNat() = (a.toNat() + b.toNat()).mod(Nat::pow(2, n)) {
    trans(@cong(λ (w: BitVec(n)) => w.toNat(), a.add(b), BitVec::ofNat(a.toNat() + b.toNat()), BitVec::add_eq_ofNat(n, a, b)),
        BitVec::toNat_ofNat_mod(n, a.toNat() + b.toNat()))
}

theorem BitVec::toNat_mul_mod(n: Nat, a, b: BitVec(n)): a.mul(b).toNat() = (a.toNat() * b.toNat()).mod(Nat::pow(2, n)) {
    BitVec::toNat_ofNat_mod(n, a.toNat() * b.toNat())
}

// A sum that does not wrap is the sum of the numbers.
theorem BitVec::toNat_add_of_lt(n: Nat, a, b: BitVec(n), fits: a.toNat() + b.toNat() < Nat::pow(2, n)): a.add(b).toNat() = a.toNat() + b.toNat() {
    trans(BitVec::toNat_add_mod(n, a, b), (a.toNat() + b.toNat()).mod_of_lt(Nat::pow(2, n), fits))
}

theorem BitVec::toNat_sub_mod(n: Nat, a, b: BitVec(n)):
    a.sub(b).toNat() = (a.toNat() + Nat::pow(2, n) - b.toNat()).mod(Nat::pow(2, n))
{
    trans(@cong(λ (w: BitVec(n)) => w.toNat(), a.sub(b), BitVec::ofNat(a.toNat() + Nat::pow(2, n) - b.toNat()), BitVec::sub_eq_ofNat(n, a, b)),
        BitVec::toNat_ofNat_mod(n, a.toNat() + Nat::pow(2, n) - b.toNat()))
}

theorem BitVec::toNat_neg_mod(n: Nat, a: BitVec(n)): a.neg().toNat() = (Nat::pow(2, n) - a.toNat()).mod(Nat::pow(2, n)) {
    trans(@cong(λ (w: BitVec(n)) => w.toNat(), a.neg(), BitVec::ofNat(Nat::pow(2, n) - a.toNat()), BitVec::neg_eq_ofNat(n, a)),
        BitVec::toNat_ofNat_mod(n, Nat::pow(2, n) - a.toNat()))
}

// `ofNat` is a semiring homomorphism at every width (P3): what a constant
// fold proves once for all widths.
theorem BitVec::ofNat_add(n, x, y: Nat): BitVec::ofNat(x, n := n).add(BitVec::ofNat(y)) = BitVec::ofNat(x + y) {
    let w = Nat::pow(2, n);
    trans(BitVec::add_eq_ofNat(n, BitVec::ofNat(x), BitVec::ofNat(y)),
        BitVec::ofNat_modeq(n, calc {
            (BitVec::ofNat(x, n := n).toNat() + BitVec::ofNat(y, n := n).toNat()).mod(w)
                = (x.mod(w) + BitVec::ofNat(y, n := n).toNat()).mod(w) := Nat::cong(λ (v: Nat) => (v + BitVec::ofNat(y, n := n).toNat()).mod(w), BitVec::toNat_ofNat_mod(n, x)),
                = (x.mod(w) + y.mod(w)).mod(w) := Nat::cong(λ (v: Nat) => (x.mod(w) + v).mod(w), BitVec::toNat_ofNat_mod(n, y)),
                = (x + y).mod(w) := sym(x.add_mod(y, w)),
        }))
}

// The same read off two words known to be `ofNat`s: `add_words` with no
// bound, its equation at the word rather than its value.
theorem BitVec::ofNat_add_of(n: Nat, {a, b: BitVec(n)}, {left, right: Nat}, a_word: a = BitVec::ofNat(left), b_word: b = BitVec::ofNat(right)):
    a.add(b) = BitVec::ofNat(left + right) {
    trans(@cong(λ (x: BitVec(n)) => x.add(b), a, BitVec::ofNat(left), a_word),
    trans(@cong(λ (y: BitVec(n)) => BitVec::ofNat(left, n := n).add(y), b, BitVec::ofNat(right), b_word), BitVec::ofNat_add(n, left, right)))
}

theorem BitVec::ofNat_mul(n, x, y: Nat): BitVec::ofNat(x, n := n).mul(BitVec::ofNat(y)) = BitVec::ofNat(x * y) {
    let w = Nat::pow(2, n);
    BitVec::ofNat_modeq(n, calc {
        (BitVec::ofNat(x, n := n).toNat() * BitVec::ofNat(y, n := n).toNat()).mod(w)
            = (x.mod(w) * BitVec::ofNat(y, n := n).toNat()).mod(w) := Nat::cong(λ (v: Nat) => (v * BitVec::ofNat(y, n := n).toNat()).mod(w), BitVec::toNat_ofNat_mod(n, x)),
                = (x.mod(w) * y.mod(w)).mod(w) := Nat::cong(λ (v: Nat) => (x.mod(w) * v).mod(w), BitVec::toNat_ofNat_mod(n, y)),
            = (x * y).mod(w) := sym(x.mul_mod(y, w)),
    })
}

theorem BitVec::ofNat_pow(n, x, k: Nat): BitVec::ofNat(x, n := n).pow(k) = BitVec::ofNat(x.pow(k)) {
    match k {
        Zero => refl,
        Succ(j) => {
            let prev: (BitVec::ofNat(x, n := n).pow(j) = BitVec::ofNat(x.pow(j))) = BitVec::ofNat_pow(n, x, j);
            trans(@cong(λ (w: BitVec(n)) => w.mul(BitVec::ofNat(x)), BitVec::ofNat(x, n := n).pow(j), BitVec::ofNat(x.pow(j)), prev),
                BitVec::ofNat_mul(n, x.pow(j), x))
        },
    }
}

// A difference that does not go below zero, at every width.
theorem BitVec::ofNat_sub(n, x, y: Nat, fits: y <= x): BitVec::ofNat(x, n := n).sub(BitVec::ofNat(y)) = BitVec::ofNat(x - y) {
    let parts: (BitVec::ofNat(x, n := n) = BitVec::ofNat(x - y).add(BitVec::ofNat(y))) =
        trans(BitVec::ofNat_cong(n, sym(y.sub_add_cancel(x, fits))), sym(BitVec::ofNat_add(n, x - y, y)));
    trans(@cong(λ (w: BitVec(n)) => w.sub(BitVec::ofNat(y)), BitVec::ofNat(x), BitVec::ofNat(x - y).add(BitVec::ofNat(y)), parts),
        BitVec::add_sub_cancel(n, BitVec::ofNat(x - y), BitVec::ofNat(y)))
}

// An operand written as its word: what the ring laws are proved through.
theorem BitVec::add_ofNat_l(n, x: Nat, b: BitVec(n)): BitVec::ofNat(x, n := n).add(b) = BitVec::ofNat(x + b.toNat()) {
    trans(@cong(λ (w: BitVec(n)) => BitVec::ofNat(x, n := n).add(w), b, BitVec::ofNat(b.toNat()), sym(BitVec::ofNat_toNat(n, b))),
        BitVec::ofNat_add(n, x, b.toNat()))
}

theorem BitVec::add_ofNat_r(n: Nat, a: BitVec(n), y: Nat): a.add(BitVec::ofNat(y)) = BitVec::ofNat(a.toNat() + y) {
    trans(@cong(λ (w: BitVec(n)) => w.add(BitVec::ofNat(y)), a, BitVec::ofNat(a.toNat()), sym(BitVec::ofNat_toNat(n, a))),
        BitVec::ofNat_add(n, a.toNat(), y))
}

theorem BitVec::mul_ofNat_l(n, x: Nat, b: BitVec(n)): BitVec::ofNat(x, n := n).mul(b) = BitVec::ofNat(x * b.toNat()) {
    trans(@cong(λ (w: BitVec(n)) => BitVec::ofNat(x, n := n).mul(w), b, BitVec::ofNat(b.toNat()), sym(BitVec::ofNat_toNat(n, b))),
        BitVec::ofNat_mul(n, x, b.toNat()))
}

theorem BitVec::mul_ofNat_r(n: Nat, a: BitVec(n), y: Nat): a.mul(BitVec::ofNat(y)) = BitVec::ofNat(a.toNat() * y) {
    trans(@cong(λ (w: BitVec(n)) => w.mul(BitVec::ofNat(y)), a, BitVec::ofNat(a.toNat()), sym(BitVec::ofNat_toNat(n, a))),
        BitVec::ofNat_mul(n, a.toNat(), y))
}

// Truncation is a ring homomorphism: the low `n` bits of a value at a wider
// width are its low `n` bits (`Nat::mod_pow_mod`).
theorem BitVec::truncate_ofNat(n, extra, x: Nat): BitVec::ofNat(x, n := extra + n).truncate(n, extra) = BitVec::ofNat(x) {
    trans(sym(BitVec::ofNat_toNat_truncate(n, extra, BitVec::ofNat(x))),
        BitVec::ofNat_modeq(n, trans(Nat::cong(λ (y: Nat) => y.mod(Nat::pow(2, n)), BitVec::toNat_ofNat_mod(extra + n, x)),
            x.mod_pow_mod(2, n, extra))))
}

theorem BitVec::truncate_eq_ofNat(n, extra: Nat, x: BitVec(extra + n)): x.truncate(n, extra) = BitVec::ofNat(x.toNat()) {
    sym(BitVec::ofNat_toNat_truncate(n, extra, x))
}

theorem BitVec::truncate_add(n, extra: Nat, x, y: BitVec(extra + n)):
    x.add(y).truncate(n, extra) = x.truncate(n, extra).add(y.truncate(n, extra))
{
    trans(@cong(λ (w: BitVec(extra + n)) => w.truncate(n, extra), x.add(y), BitVec::ofNat(x.toNat() + y.toNat()), BitVec::add_eq_ofNat(extra + n, x, y)),
    trans(BitVec::truncate_ofNat(n, extra, x.toNat() + y.toNat()),
    trans(sym(BitVec::ofNat_add(n, x.toNat(), y.toNat())),
    trans(@cong(λ (w: BitVec(n)) => w.add(BitVec::ofNat(y.toNat())), BitVec::ofNat(x.toNat()), x.truncate(n, extra), sym(BitVec::truncate_eq_ofNat(n, extra, x))),
        @cong(λ (w: BitVec(n)) => x.truncate(n, extra).add(w), BitVec::ofNat(y.toNat()), y.truncate(n, extra), sym(BitVec::truncate_eq_ofNat(n, extra, y)))))))
}

theorem BitVec::truncate_mul(n, extra: Nat, x, y: BitVec(extra + n)):
    x.mul(y).truncate(n, extra) = x.truncate(n, extra).mul(y.truncate(n, extra))
{
    trans(BitVec::truncate_ofNat(n, extra, x.toNat() * y.toNat()),
    trans(sym(BitVec::ofNat_mul(n, x.toNat(), y.toNat())),
    trans(@cong(λ (w: BitVec(n)) => w.mul(BitVec::ofNat(y.toNat())), BitVec::ofNat(x.toNat()), x.truncate(n, extra), sym(BitVec::truncate_eq_ofNat(n, extra, x))),
        @cong(λ (w: BitVec(n)) => x.truncate(n, extra).mul(w), BitVec::ofNat(y.toNat()), y.truncate(n, extra), sym(BitVec::truncate_eq_ofNat(n, extra, y))))))
}

// The signed reading is the unsigned one modulo `2^n`: they differ by `2^n`
// exactly when the sign bit is set.
theorem BitVec::toInt_modeq(n: Nat, x: BitVec(n)): Int::ModEq(Nat::pow(2, n), x.toInt(), OfNat(x.toNat())) {
    let w = OfNat(Nat::pow(2, n));
    let both: (s: Bool) → Int::ModEq(Nat::pow(2, n), (match s as λ _ => Int {
            False => OfNat(x.toNat()),
            True => OfNat(x.toNat()).sub(w),
        }), OfNat(x.toNat())) =
        λ s => match s {
            False => Int::modeq_refl(Nat::pow(2, n), OfNat(x.toNat())),
            True => Exists(NegSucc(0), Int::cong(λ (y: Int) => OfNat(x.toNat()) + y, trans(sym(w.mul_neg_one()), w.mul_comm(NegSucc(0))))),
        };
    both(x.sign_bit())
}

// Below `2^n` nothing wraps: the no-overflow half.

theorem add_ofNat_sum(n: Nat, a, b: BitVec(n),
    bounded: a.toNat() + b.toNat() < Nat::pow(2, n)):
    a.add(b) = BitVec::ofNat(a.toNat() + b.toNat()) {
    BitVec::add_eq_ofNat(n, a, b)
}

theorem toNat_add(n: Nat, a, b: BitVec(n),
    bounded: a.toNat() + b.toNat() < Nat::pow(2, n)):
    a.add(b).toNat() = a.toNat() + b.toNat() {
    trans(BitVec::toNat_add_mod(n, a, b), (a.toNat() + b.toNat()).mod_of_lt(Nat::pow(2, n), bounded))
}

// A literal added to a word that stays below another word does not wrap.
theorem BitVec::toNat_add_below(n: Nat, a, bound: BitVec(n), k: Nat, inside: a.toNat() + k < bound.toNat()): a.add(BitVec::ofNat(k)).toNat() = a.toNat() + k {
    let top: (a.toNat() + k < Nat::pow(2, n)) = Nat::lt_trans(a.toNat() + k, bound.toNat(), Nat::pow(2, n), inside, BitVec::toNat_lt_pow(n, bound));
    let small: (k < Nat::pow(2, n)) = Nat::le_trans(k + 1, a.toNat() + k + 1, Nat::pow(2, n), a.toNat().le_add_r(k), top);
    let literal: (BitVec::ofNat(k, n := n).toNat() = k) = BitVec::toNat_ofNat(n, k, small);
    trans(toNat_add(n, a, BitVec::ofNat(k), rewrite(literal, top)), rewrite(literal, refl))
}

// The machine's unsigned test decides the same strict bound as Nat.
theorem unsigned_lt_nat(n: Nat, a, b: BitVec(n)):
    a.unsigned_lt_bit(b) = (a.toNat() + 1).leb(b.toNat()) {
    match yes: a.unsigned_lt_bit(b) {
        True => sym(bool::eq_true_of_is_true((a.toNat() + 1).leb(b.toNat()), (a.toNat() + 1).leb_complete(b.toNat(), BitVec::borrow_sub_of_bit_true(n, a, b, yes)))),
        False => match same: (a.toNat() + 1).leb(b.toNat()) {
            False => refl,
            True => absurd(trans(sym(yes), BitVec::borrow_sub_bit_of_borrow(n, a, b,
                (a.toNat() + 1).leb_sound(b.toNat(), rewrite(same, trivial))))),
        },
    }
}

// Two words of any widths compared by value, as the bit-blaster compares
// them: each read from bit 0 at a common width `w` that holds both.
theorem BitVec::lt_bits_nat(m, n, w: Nat, x: BitVec(m), y: BitVec(n), hm: m <= w, hn: n <= w):
    x.bits_from(0, n := w).unsigned_lt_bit(y.bits_from(0, n := w)) = Succ(x.toNat()).leb(y.toNat()) {
    rewrite(unsigned_lt_nat(w, x.bits_from(0, n := w), y.bits_from(0, n := w)),
        BitVec::bits_from_zero_toNat(m, w, x, hm), BitVec::bits_from_zero_toNat(n, w, y, hn), refl)
}

theorem BitVec::le_bits_nat(m, n, w: Nat, x: BitVec(m), y: BitVec(n), hm: m <= w, hn: n <= w):
    !y.bits_from(0, n := w).unsigned_lt_bit(x.bits_from(0, n := w)) = x.toNat().leb(y.toNat()) {
    rewrite(BitVec::lt_bits_nat(n, m, w, y, x, hn, hm), sym(x.toNat().leb_flip(y.toNat())))
}

theorem BitVec::eq_bits_nat(m, n, w: Nat, x: BitVec(m), y: BitVec(n), hm: m <= w, hn: n <= w):
    x.bits_from(0, n := w).eq_bit(y.bits_from(0, n := w)) = x.toNat().same(y.toNat()) {
    rewrite(BitVec::eq_bit_nat(w, x.bits_from(0, n := w), y.bits_from(0, n := w)),
        BitVec::bits_from_zero_toNat(m, w, x, hm), BitVec::bits_from_zero_toNat(n, w, y, hn), refl)
}

theorem strict_complement(n: Nat): (m: Nat) → (n + 1).leb(m) = m.leb(n).not() {
    match n {
        Zero => λ m => match m { Zero => refl, Succ(_) => refl },
        Succ(_, ih) => λ m => match m { Zero => refl, Succ(l) => ih(l) },
    }
}

theorem add_words(n: Nat, a, b: BitVec(n), left, right: Nat,
    a_word: a.toNat() = left, b_word: b.toNat() = right,
    bounded: left + right < Nat::pow(2, n)):
    a.add(b).toNat() = left + right {
    let same = j(a_word, λ x _ => a.toNat() + b.toNat() = x + right,
        rewrite(sym(b_word), refl));
    trans(toNat_add(n, a, b, rewrite(same, bounded)), same)
}

// The modular image of a Nat at a width: `value` increments from zero. It is
// how typed machine certificates carry a Nat (docs/archive/native-bounded-loops-design.md
// §9a): every equality about it is unconditional, and a bound is needed only
// to read the word back as the Nat (`toNat_word_of_nat`).
fn word_of_nat(n: Nat, value: Nat) → BitVec(n) { BitVec::zero().iterate_increment(value) }

theorem word_of_nat_succ(value: Nat):
    word_of_nat(64, value + 1) = word_of_nat(64, value).add(BitVec::ofNat(1)) {
    BitVec::iter_add_eq_add(64, word_of_nat(64, value), BitVec::ofNat(1))
}

// It is `ofNat`, at every width and count.
theorem word_of_nat_eq_ofNat(n, value: Nat): word_of_nat(n, value) = BitVec::ofNat(value) { BitVec::zero_iterate_increment(n, value) }

theorem word_of_nat_toNat(n: Nat, word: BitVec(n)): word_of_nat(n, word.toNat()) = word {
    BitVec::iterate_increment_toNat(n, word)
}

theorem toNat_word_of_nat(n, value: Nat, bounded: value < Nat::pow(2, n)): word_of_nat(n, value).toNat() = value {
    let same = trans(BitVec::cong_iterate_increment_count(n, BitVec::zero(), sym(BitVec::toNat_ofNat(n, value, bounded))),
        BitVec::iterate_increment_toNat(n, BitVec::ofNat(value)));
    j(sym(same), λ word _ => word.toNat() = value, BitVec::toNat_ofNat(n, value, bounded))
}

// Subtraction that does not borrow reads back as Nat subtraction.
theorem toNat_sub(n: Nat, a, b: BitVec(n), fits: b.toNat() <= a.toNat()):
    a.sub(b).toNat() = a.toNat() - b.toNat() {
    let d = a.toNat() - b.toNat();
    let d_below: (d < Nat::pow(2, n)) = Nat::le_trans(d + 1, a.toNat() + 1, Nat::pow(2, n),
        Nat::le_succ_succ(d, a.toNat(), Nat::sub_le(a.toNat(), b.toNat())), BitVec::toNat_lt_pow(n, a));
    let c = BitVec::ofNat(d, n := n);
    let c_value: (c.toNat() = d) = BitVec::toNat_ofNat(n, d, d_below);
    let total: (c.toNat() + b.toNat() = a.toNat()) =
        trans(@cong(λ (x: Nat) => x + b.toNat(), c.toNat(), d, c_value), Nat::sub_add_cancel(b.toNat(), a.toNat(), fits));
    let fits_sum: (c.toNat() + b.toNat() < Nat::pow(2, n)) =
        rewrite(total, BitVec::toNat_lt_pow(n, a));
    let back: (c.add(b) = a) = trans(add_ofNat_sum(n, c, b, fits_sum),
        trans(@cong(λ (t: Nat) => BitVec::ofNat(t, n := n), c.toNat() + b.toNat(), a.toNat(), total), BitVec::ofNat_toNat(n, a)));
    let same: (a.sub(b) = c) = trans(@cong(λ (x: BitVec(n)) => x.sub(b), a, c.add(b), sym(back)), BitVec::add_sub_cancel(n, c, b));
    trans(@cong(λ (x: BitVec(n)) => x.toNat(), a.sub(b), c, same), c_value)
}

// A word that is not zero, less one, is below it: the step of a recursion
// counting a word down, `decreases x.toNat()`.
theorem toNat_sub_one_lt(x: BitVec(64), nonzero: x.eq_bit(BitVec::ofNat(0)) = False): x.sub(BitVec::ofNat(1)).toNat() < x.toNat() {
    let one: (BitVec::ofNat(1, n := 64).toNat() = 1) = refl;
    let positive: (0 < x.toNat()) = match x.toNat() as λ m => (x.toNat() = m) → 0 < m {
        Zero => λ (z: x.toNat() = 0) => {
            let back: (x = BitVec::ofNat(0)) = trans(sym(BitVec::ofNat_toNat(64, x)), @cong(λ (t: Nat) => BitVec::ofNat(t, n := 64), x.toNat(), 0, z));
            false_elim(BitVec::ne_of_eq_bit(64, x, BitVec::ofNat(0), nonzero, back))
        },
        Succ(_) => λ _ => trivial,
    }(refl);
    let fits: (BitVec::ofNat(1, n := 64).toNat() <= x.toNat()) = rewrite(sym(one), positive);
    rewrite(toNat_sub(64, x, BitVec::ofNat(1), fits), rewrite(one, x.toNat().sub_lt_of_pos(1, trivial, positive)))
}

// `(p * 2) * d` is `p * d` twice: the step from one width to the next.
theorem scale_twice(p, d: Nat): (p * 2) * d = (p * d).twice() {
    trans(Nat::mul_assoc(p, 2, d),
        trans(@cong(λ (x: Nat) => p * x, 2 * d, d + d, trans(Nat::mul_succ_left(1, d), @cong(λ (x: Nat) => d + x, 1 * d, d, Nat::mul_left_one(d)))),
        trans(Nat::mul_add_distr(p, d, d), sym(Nat::twice_add_self(p * d)))))
}

// A value splits at its low `n` bits: how the bytes of a word read back.
theorem toNat_take_drop(n: Nat): (m: Nat) → (x: BitVec(m + n)) →
    x.toNat() = x.take_low(n, m).toNat() + Nat::pow(2, n) * x.drop_low(n, m).toNat() {
    match n {
        Zero => λ m x => sym(trans(Nat::add_left_zero(1 * x.toNat()), Nat::mul_left_one(x.toNat()))),
        Succ(k, ih) => λ m x => {
            let tail = x.tail_bits();
            let t = tail.take_low(k, m).toNat();
            let d = tail.drop_low(k, m).toNat();
            let p = Nat::pow(2, k);
            let bit = Nat::of_bit(x.head_bit());
            let doubled: (tail.toNat().twice() = t.twice() + (p * 2) * d) =
                trans(@cong(λ (v: Nat) => v.twice(), tail.toNat(), t + p * d, ih(m, tail)),
                trans(Nat::twice_add(t, p * d), @cong(λ (v: Nat) => t.twice() + v, (p * d).twice(), (p * 2) * d, sym(scale_twice(p, d)))));
            trans(@cong(λ (v: Nat) => bit + v, tail.toNat().twice(), t.twice() + (p * 2) * d, doubled),
                sym(Nat::add_assoc(bit, t.twice(), (p * 2) * d)))
        },
    }
}

// Words as bytes. Endianness is a packing choice made here, never a property
// of memory: memory holds cells at addresses (`lib/std/machine/memory.hthr`), and a
// word becomes cells only through one of these. A `k`-byte word is a
// `BitVec(8 * k)` and its bytes a `[BitVec(8); k]`, so both round trips are
// stated without a cast: `8 * Succ(k)` is `8 * k + 8`, `concat`'s index for
// one low byte below `k` more.
//
// Little-endian puts the low byte first, big-endian the high byte first; the
// big-endian forms are the little-endian ones read through `reverse`.

import bitvec;
import bitvec_resize;
import bool;
import list;
import logic;
import nat;
import option;
import vector;

fn BitVec::bytes_le(k: Nat, self w: BitVec(8 * k)) → [BitVec(8); k] {
    match k {
        Zero => [],
        Succ(j, ih) => cons(w.take_low(8, 8 * j), ih(w.drop_low(8, 8 * j))),
    }
}

fn BitVec::of_bytes_le({k: Nat}, bytes: [BitVec(8); k]) → BitVec(8 * k) {
    match k {
        Zero => BitVec::nil(),
        Succ(_, ih) => head(bytes).concat(ih(tail(bytes))),
    }
}

fn BitVec::bytes_be(k: Nat, self w: BitVec(8 * k)) → [BitVec(8); k] { reverse(w.bytes_le(k)) }

fn BitVec::of_bytes_be({k: Nat}, bytes: [BitVec(8); k]) → BitVec(8 * k) { BitVec::of_bytes_le(reverse(bytes)) }

theorem BitVec::of_bytes_le_bytes_le(k: Nat): (w: BitVec(8 * k)) → BitVec::of_bytes_le(w.bytes_le(k)) = w {
    match k {
        Zero => λ w => refl,
        Succ(j, ih) => λ w => {
            let rest: (w.take_low(8, 8 * j).concat(BitVec::of_bytes_le(w.drop_low(8, 8 * j).bytes_le(j))) =
                w.take_low(8, 8 * j).concat(w.drop_low(8, 8 * j))) = rewrite(ih(w.drop_low(8, 8 * j)), refl);
            trans(rest, BitVec::concat_split(8, 8 * j, w))
        },
    }
}

theorem BitVec::bytes_le_of_bytes_le(k: Nat): (bytes: [BitVec(8); k]) → BitVec::of_bytes_le(bytes).bytes_le(k) = bytes {
    match k {
        Zero => λ bytes => refl,
        Succ(j, ih) => λ bytes => {
            let word = head(bytes).concat(BitVec::of_bytes_le(tail(bytes)));
            let low: (word.take_low(8, 8 * j) = head(bytes)) =
                BitVec::split_concat_low(8, 8 * j, head(bytes), BitVec::of_bytes_le(tail(bytes)));
            let high: (word.drop_low(8, 8 * j) = BitVec::of_bytes_le(tail(bytes))) =
                BitVec::split_concat_high(8, 8 * j, head(bytes), BitVec::of_bytes_le(tail(bytes)));
            let step: (cons(word.take_low(8, 8 * j), word.drop_low(8, 8 * j).bytes_le(j)) =
                cons(head(bytes), BitVec::of_bytes_le(tail(bytes)).bytes_le(j))) = rewrite(low, high, refl);
            let inner: (cons(head(bytes), BitVec::of_bytes_le(tail(bytes)).bytes_le(j)) = cons(head(bytes), tail(bytes))) =
                rewrite(ih(tail(bytes)), refl);
            trans(step, inner)
        },
    }
}

theorem BitVec::of_bytes_be_bytes_be(k: Nat, w: BitVec(8 * k)): BitVec::of_bytes_be(w.bytes_be(k)) = w {
    trans(rewrite(reverse_reverse(k, w.bytes_le(k)), refl), BitVec::of_bytes_le_bytes_le(k, w))
}

theorem BitVec::bytes_be_of_bytes_be(k: Nat, bytes: [BitVec(8); k]): BitVec::of_bytes_be(bytes).bytes_be(k) = bytes {
    trans(rewrite(BitVec::bytes_le_of_bytes_le(k, reverse(bytes)), refl), reverse_reverse(k, bytes))
}

// A word with its byte `r` replaced, byte 0 the most significant: the
// word of its bytes with that one changed, and the word where it has no
// such byte.
fn BitVec::with_byte_be(k: Nat, self w: BitVec(8 * k), r: Nat, b: u8) → BitVec(8 * k) { BitVec::of_bytes_be(vector_update(w.bytes_be(k), r, b)) }

// ---------------------------------------------------------------------------
// Bytes joined and split by shifts, as compiled code does both

// Four bytes joined by shifts, the first the most significant, as
// compiled code joins them, are the big-endian word of them.
theorem BitVec::be_join_32(b0, b1, b2, b3: u8):
    (b0.zero_extend(56) << 24 | b1.zero_extend(56) << 16 | b2.zero_extend(56) << 8 | b3.zero_extend(56))
        = BitVec::of_bytes_be([b0, b1, b2, b3]).zero_extend(32) {
    let w0: BitVec(40) = b0.concat(BitVec::zero(n := 32));
    let w1: BitVec(48) = b1.concat(w0);
    let w2: BitVec(56) = b2.concat(w1);
    let s1: ((b0.zero_extend(56) << 24 | b1.zero_extend(56) << 16) = BitVec::concat(BitVec::zero(), w1, n := 16, m := 48)) = BitVec::bor_concat_above(16, 8, 40, b1, w0);
    let s2: ((BitVec::concat(BitVec::zero(), w1, n := 16, m := 48) | b2.zero_extend(56) << 8) = BitVec::concat(BitVec::zero(), w2, n := 8, m := 56)) = BitVec::bor_concat_above(8, 8, 48, b2, w1);
    let s3: ((BitVec::concat(BitVec::zero(), w2, n := 8, m := 56) | b3.zero_extend(56)) = BitVec::concat(b3, w2, n := 8, m := 56)) = BitVec::bor_concat_above(0, 8, 56, b3, w2);
    trans(cong_fn<u64, u64>(λ t => t | b2.zero_extend(56) << 8 | b3.zero_extend(56), s1),
        trans(cong_fn<u64, u64>(λ t => t | b3.zero_extend(56), s2), s3))
}

// A word's low four bytes, the most significant first, are its shifts
// truncated.
theorem BitVec::be_split_32(word: u64): vector_entries(word.truncate(32, 32).bytes_be(4))
    = [(word >> 24).truncate(8, 56), (word >> 16).truncate(8, 56), (word >> 8).truncate(8, 56), word.truncate(8, 56)] { refl }

// Two big-endian halves, the first shifted up, are the whole.
theorem BitVec::be_join_64(b0, b1, b2, b3, b4, b5, b6, b7: u8):
    (BitVec::of_bytes_be([b0, b1, b2, b3]).zero_extend(32) << 32 | BitVec::of_bytes_be([b4, b5, b6, b7]).zero_extend(32))
        = BitVec::of_bytes_be([b0, b1, b2, b3, b4, b5, b6, b7]) {
    BitVec::bor_concat_above(0, 32, 32, BitVec::of_bytes_be([b4, b5, b6, b7]), BitVec::of_bytes_be([b0, b1, b2, b3]))
}

// ---------------------------------------------------------------------------
// A word's bytes reversed

// The bytes of a `k`-byte word in the other order: its big-endian bytes
// read as little-endian, as `BSWAP` does to a register.
fn BitVec::byte_swap(k: Nat, self w: BitVec(8 * k)) → BitVec(8 * k) { BitVec::of_bytes_le(w.bytes_be(k)) }

// Swapping twice gives the word back.
theorem BitVec::byte_swap_byte_swap(k: Nat, w: BitVec(8 * k)): w.byte_swap(k).byte_swap(k) = w {
    let bytes = w.bytes_le(k);
    let swapped: (w.byte_swap(k).byte_swap(k) = BitVec::of_bytes_le(reverse(reverse(bytes)))) =
        cong_fn(λ (v: [BitVec(8); k]) => BitVec::of_bytes_le(reverse(v)), BitVec::bytes_le_of_bytes_le(k, reverse(bytes)));
    trans(swapped, trans(cong_fn(λ (v: [BitVec(8); k]) => BitVec::of_bytes_le(v), reverse_reverse(k, bytes)), BitVec::of_bytes_le_bytes_le(k, w)))
}

// The little-endian word of some bytes, swapped, is their big-endian word,
// and the other way round.
theorem BitVec::byte_swap_of_bytes_le(k: Nat, bytes: [BitVec(8); k]): BitVec::of_bytes_le(bytes).byte_swap(k) = BitVec::of_bytes_be(bytes) {
    cong_fn(λ (v: [BitVec(8); k]) => BitVec::of_bytes_le(reverse(v)), BitVec::bytes_le_of_bytes_le(k, bytes))
}

theorem BitVec::byte_swap_of_bytes_be(k: Nat, bytes: [BitVec(8); k]): BitVec::of_bytes_be(bytes).byte_swap(k) = BitVec::of_bytes_le(bytes) {
    trans(cong_fn(λ (v: [BitVec(8); k]) => BitVec::of_bytes_le(reverse(v)), BitVec::bytes_le_of_bytes_le(k, reverse(bytes))),
        cong_fn(λ (v: [BitVec(8); k]) => BitVec::of_bytes_le(v), reverse_reverse(k, bytes)))
}

// Four bytes joined by shifts, the first the most significant, are the
// swap of the word that holds them low byte first: one load of the four
// and a `BSWAP` read what compiled code reads a byte at a time.
theorem BitVec::be_join_32_swap(b0, b1, b2, b3: u8):
    (b0.zero_extend(56) << 24 | b1.zero_extend(56) << 16 | b2.zero_extend(56) << 8 | b3.zero_extend(56))
        = BitVec::of_bytes_le([b0, b1, b2, b3]).byte_swap(4).zero_extend(32) {
    trans(BitVec::be_join_32(b0, b1, b2, b3), sym(cong_fn<u32, u64>(λ x => x.zero_extend(32), BitVec::byte_swap_of_bytes_le(4, [b0, b1, b2, b3]))))
}

// A word of any width with its whole bytes reversed: the `ByteSwap` node's
// meaning, at the widths it lowers (32 and 64) the swap above.
fn BitVec::swap_bytes({n: Nat}, self w: BitVec(n)) → BitVec(n) { w.resize(8 * (n / 8)).byte_swap(n / 8).resize(n) }

theorem BitVec::swap_bytes_32(w: u32): w.swap_bytes() = w.byte_swap(4) {
    trans(BitVec::resize_self(32, w.resize(32).byte_swap(4)), cong_fn(λ (x: u32) => x.byte_swap(4), BitVec::resize_self(32, w)))
}

theorem BitVec::swap_bytes_64(w: u64): w.swap_bytes() = w.byte_swap(8) {
    trans(BitVec::resize_self(64, w.resize(64).byte_swap(8)), cong_fn(λ (x: u64) => x.byte_swap(8), BitVec::resize_self(64, w)))
}

// Fixed-width bitvectors. A `BitVec(n)` is a kernel vector of `n` Booleans,
// least-significant bit first: index zero has weight one. Consequently
// `BitVec(0)` has exactly the single value `[]`; operations at width zero are
// total and discard all input information. Equality is ordinary vector
// equality, so no quotient or proof field is hidden in the carrier.
//
// Arithmetic interpretation is explicit. `toNat` is unsigned and `toInt` is
// two's-complement signed. `add`, `sub`, and `neg` are ripple-carry: their
// reduction cost is the width, not the operands' magnitude
// (`docs/bitvec-width-bounded-defaults-design.md`); the iterated spellings
// remain as `iter_add`/`iter_sub`/`iter_neg` for `toNat`-counted reasoning.
// Construction and arithmetic reduce modulo `2^n`; bitwise operations,
// slicing, and extension agree pointwise with those interpretations. Shift
// counts are mathematical counts and are never masked to an
// instruction-set-specific width.

import bool;
import logic;
import nat;
import int;
import pair;
import algebra;

record BitVec(n: Nat) { bits: [Bool; n] }

fn BitVec::nil() → BitVec(0) { BitVec([]) }

fn BitVec::from_bits({n: Nat}, bits: [Bool; n]) → BitVec(n) { BitVec(bits) }

theorem BitVec::nil_eq_from_bits(): BitVec::nil() = BitVec::from_bits([]) { refl }

fn BitVec::cons_bit({n: Nat}, b: Bool, self x: BitVec(n)) → BitVec(Succ(n)) {
    BitVec::from_bits(cons(b, x.bits))
}

fn BitVec::head_bit({n: Nat}, self x: BitVec(Succ(n))) → Bool { head(x.bits) }

fn BitVec::tail_bits({n: Nat}, self x: BitVec(Succ(n))) → BitVec(n) {
    BitVec::from_bits(tail(x.bits))
}

// ---------------------------------------------------------------------------
// Bits and constructors

fn BitVec::repeat_bit({n: Nat}, b: Bool) → BitVec(n) {
    match n as λ k => BitVec(k) {
        Zero => BitVec::nil(),
        Succ(_, ih) => ih.cons_bit(b),
    }
}

// All zeroes
fn BitVec::zero({n: Nat}) → BitVec(n) { BitVec::repeat_bit(False) }
// All ones
fn BitVec::all_ones({n: Nat}) → BitVec(n) { BitVec::repeat_bit(True) }

// `BitVec::one(0)` is `BitVec::zero(0)`; at a positive width its sole set bit is index zero.
fn BitVec::one({n: Nat}) → BitVec(n) {
    match n as λ k => BitVec(k) {
        Zero => BitVec::nil(),
        Succ(_) => BitVec::zero().cons_bit(True),
    }
}

fn BitVec::ofBool(value: Bool) → BitVec(1) { BitVec::from_bits([value]) }

fn BitVec::get({n: Nat}, self x: BitVec(n), i: Fin(n)) → Bool { x.bits[i] }

fn BitVec::set({n: Nat}, self x: BitVec(n), i: Fin(n), b: Bool) → BitVec(n) {
    (match n as λ k => BitVec(k) → Fin(k) → Bool → BitVec(k) {
        Zero => λ x i b => match i { },
        Succ(_, ih) => λ x i b => match i {
            FZ => x.tail_bits().cons_bit(b),
            FS(j) => ih(x.tail_bits(), j, b).cons_bit(x.head_bit()),
        },
    })(x, i, b)
}

// ---------------------------------------------------------------------------
// Pointwise logic

fn BitVec::complement({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_, ih) => λ x => ih(x.tail_bits()).cons_bit(!x.head_bit()),
    })(x)
}

fn BitVec::band({n: Nat}, self x, y: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => BitVec::nil(),
        Succ(_, ih) => λ x y =>
            ih(x.tail_bits(), y.tail_bits()).cons_bit(x.head_bit() && y.head_bit()),
    })(x, y)
}

fn BitVec::bor({n: Nat}, self x, y: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => BitVec::nil(),
        Succ(_, ih) => λ x y =>
            ih(x.tail_bits(), y.tail_bits()).cons_bit(x.head_bit() || y.head_bit()),
    })(x, y)
}

fn BitVec::bxor({n: Nat}, self x, y: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => BitVec::nil(),
        Succ(_, ih) => λ x y =>
            ih(x.tail_bits(), y.tail_bits()).cons_bit(x.head_bit().xor(y.head_bit())),
    })(x, y)
}

// ---------------------------------------------------------------------------
// Shape operations. `lo.concat(hi)` keeps the little-endian convention:
// the `n` low bits precede the `m` high bits. `Nat::add` recurses on its second
// argument, hence the result index is written `m + n` so this computes while
// recursing over `lo` at an open width.

fn BitVec::concat({n, m: Nat}, self lo: BitVec(n), hi: BitVec(m)) → BitVec(m + n) {
    (match n as λ k => (m: Nat) → BitVec(k) → BitVec(m) → BitVec(m + k) {
        Zero => λ m lo hi => hi,
        Succ(_, ih) => λ m lo hi => ih(m, lo.tail_bits(), hi).cons_bit(lo.head_bit()),
    })(m, lo, hi)
}

fn BitVec::take_low(n, m: Nat, self x: BitVec(m + n)) → BitVec(n) {
    (match n as λ k => (m: Nat) → BitVec(m + k) → BitVec(k) {
        Zero => λ m x => BitVec::nil(),
        Succ(_, ih) => λ m x =>
            ih(m, x.tail_bits()).cons_bit(x.head_bit()),
    })(m, x)
}

fn BitVec::drop_low(n, m: Nat, self x: BitVec(m + n)) → BitVec(m) {
    (match n as λ k => (m: Nat) → BitVec(m + k) → BitVec(m) {
        Zero => λ m x => x,
        Succ(_, ih) => λ m x => ih(m, x.tail_bits()),
    })(m, x)
}

fn BitVec::split(n, m: Nat, self x: BitVec(m + n)) → Pair<BitVec(n), BitVec(m)> {
    Pair(x.take_low(n, m), x.drop_low(n, m))
}

// A bounded slice: discard `skip` low bits and return the next `width` bits;
// `rest` makes the required input bound structural rather than propositional.
fn BitVec::slice(skip, width, rest: Nat,
    self x: BitVec((rest + width) + skip)) → BitVec(width) {
    x.drop_low(skip, rest + width).take_low(width, rest)
}

fn BitVec::truncate(n, extra: Nat, self x: BitVec(extra + n)) → BitVec(n) {
    x.take_low(n, extra)
}

fn BitVec::zero_extend({n: Nat}, extra: Nat, self x: BitVec(n)) → BitVec(extra + n) {
    x.concat(BitVec::zero())
}

// Sign extension is defined separately at width zero because an empty vector
// has no sign bit. The canonical policy maps it to zero at every larger width.
fn BitVec::sign_extend_zero(extra: Nat, self x: BitVec(0)) → BitVec(extra) {
    BitVec::zero()
}

fn BitVec::last_index(n: Nat) → Fin(Succ(n)) {
    match n as λ k => Fin(Succ(k)) {
        Zero => FZ,
        Succ(_, ih) => FS(ih),
    }
}

fn BitVec::sign_extend({n: Nat}, extra: Nat, self x: BitVec(Succ(n))) → BitVec(extra + Succ(n)) {
    x.concat(BitVec::repeat_bit(x.get(BitVec::last_index(n))))
}

// ---------------------------------------------------------------------------
// Unsigned and signed interpretation

fn BitVec::toNat({n: Nat}, self x: BitVec(n)) → Nat {
    (match n as λ k => BitVec(k) → Nat {
        Zero => λ x => 0,
        Succ(_, ih) => λ x => Nat::of_bit(x.head_bit()) + ih(x.tail_bits()).twice(),
    })(x)
}

// Construction from a natural, in work bounded by the WIDTH rather than the
// magnitude (issues/bitvec-ofnat-large-literals.md): the recursion is on the
// width, taking the argument's low bit and continuing at `Nat::half`.
//
// That is width-bounded, and not the naive peeling it looks like, because
// neither window walks the argument. `odd_bit` and `Nat::half` are the same
// two-successor course-of-values fold, which the kernel classifies as a
// permutation iterated by exponentiation rather than one successor at a time
// (`crates/kernel/DESIGN.md`, the acceleration policy). So each of the `n`
// steps costs one iteration whatever the magnitude — measured flat from `0`
// to `2^60` and five times cheaper than reading the bits from the top,
// `docs/bitvector-literal-entry-design.md` §4.3. The dependence is real: if
// that classification is ever narrowed this definition reverts to costing the
// magnitude, which is what the top-down spelling was written for in the first
// place.
//
// Truncation is definitional. `BitVec::ofNat(x): BitVec(n)` is the low `n`
// bits of `x` for
// every `x` by construction, as `mul` and the module header require — no
// reduction below `2^n` first, and so no `2^n` built at all.

// The low bit of `x`. Its window is `half`'s (`lib/std/num/nat.hthr`), which is
// what keeps `ofNat` bounded by the width; a one-successor parity recursion
// through `Bool::not` would not be.
fn BitVec::odd_bit(x: Nat) → Bool {
    match x {
        Zero => False,
        Succ(k) => match k { Zero => True, Succ(l) => BitVec::odd_bit(l) },
    }
}

fn BitVec::ofNat({n: Nat}, x: Nat) → BitVec(n) {
    (match n as λ k => Nat → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_, ih) => λ x => ih(x.half()).cons_bit(BitVec::odd_bit(x)),
    })(x)
}

fn BitVec::sign_bit({n: Nat}, self x: BitVec(n)) → Bool {
    (match n as λ k => BitVec(k) → Bool {
        Zero => λ x => False,
        Succ(k) => λ x => x.get(BitVec::last_index(k)),
    })(x)
}

fn BitVec::toInt({n: Nat}, self x: BitVec(n)) → Int {
    match x.sign_bit() {
        False => OfNat(x.toNat()),
        True => OfNat(x.toNat()).sub(OfNat(Nat::pow(2, n))),
    }
}

fn BitVec::unsigned_le({n: Nat}, self a, b: BitVec(n)) → Type { a.toNat() <= b.toNat() }
fn BitVec::unsigned_lt({n: Nat}, self a, b: BitVec(n)) → Type { a.toNat() < b.toNat() }
fn BitVec::signed_le({n: Nat}, self a, b: BitVec(n)) → Type { a.toInt().Le(b.toInt()) }
fn BitVec::signed_lt({n: Nat}, self a, b: BitVec(n)) → Type { a.toInt().Lt(b.toInt()) }

// ---------------------------------------------------------------------------
// Modular arithmetic and reusable ALU predicates

fn BitVec::increment({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_, ih) => λ x => match x.head_bit() {
            False => x.tail_bits().cons_bit(True),
            True => ih(x.tail_bits()).cons_bit(False),
        },
    })(x)
}

fn BitVec::decrement({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_, ih) => λ x => match x.head_bit() {
            False => ih(x.tail_bits()).cons_bit(True),
            True => x.tail_bits().cons_bit(False),
        },
    })(x)
}

fn BitVec::iterate_increment({n: Nat}, self x: BitVec(n), count: Nat) → BitVec(n) {
    match count {
        Zero => x,
        Succ(k) => x.iterate_increment(k).increment(),
    }
}

fn BitVec::iterate_decrement({n: Nat}, count: Nat, self x: BitVec(n)) → BitVec(n) {
    match count { Zero => x, Succ(k) => x.decrement().iterate_decrement(k) }
}

// The iterated forms. One increment or decrement per unit of the second
// operand's unsigned value, so a machine-width operand asks for up to `2^n`
// steps; they are kept because `toNat`-counted reasoning is stated over them
// (`iter_add_comm`, `iter_add_sub_cancel`, the `iterate_increment_*` lemmas),
// and `iter_add_eq_add` and its siblings connect them to the operations below.
fn BitVec::iter_add({n: Nat}, self a, b: BitVec(n)) → BitVec(n) {
    a.iterate_increment(b.toNat())
}

fn BitVec::iter_sub({n: Nat}, self a, b: BitVec(n)) → BitVec(n) {
    a.iterate_decrement(b.toNat())
}

fn BitVec::iter_neg({n: Nat}, self a: BitVec(n)) → BitVec(n) {
    BitVec::zero().iter_sub(a)
}

// ---------------------------------------------------------------------------
// Ripple-carry addition and subtraction, and the canonical operations
// (docs/bitvec-width-bounded-defaults-design.md). The ripples run the carry
// and borrow `carry_bits` and `borrow_bits` already use and keep each column's
// sum bit, so the work is one column per bit of width whatever the operands
// are. `add`, `sub`, and `neg` *are* those ripples; the iterated forms above
// are proved equal to them at every width and every operand, open ones
// included.
//
// The incoming carry or borrow is part of the induction. Its meaning is the
// unsigned count the column adds or removes: `a.add_bits(b, c)` is
// `a.iterate_increment(b.toNat() + Nat::of_bit(c))` (`add_bits_spec`), and
// `a.sub_bits(b, c)` is `a.iterate_decrement(b.toNat() + Nat::of_bit(c))`
// (`sub_bits_spec`).

fn BitVec::sum_bit(a, b, carry: Bool) → Bool { a.xor(b.xor(carry)) }

fn BitVec::carry_majority(a, b, carry: Bool) → Bool {
    (a && b) || ((a && carry) || (b && carry))
}

fn BitVec::borrow_next(a, b, borrow: Bool) → Bool {
    (!a && b) || (!(a.xor(b)) && borrow)
}

fn BitVec::add_bits_next({n: Nat}, a, b: BitVec(n), carry: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → BitVec(n)) → BitVec(n)
{
    match carry {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

// Ripple-carry addition with an incoming carry. The carry passed on is the
// majority `carry_bits` uses, forced before the recursive call for the reason
// given there.
fn BitVec::add_bits({n: Nat}, self a, b: BitVec(n), carry: Bool) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) → Bool → BitVec(k) {
        Zero => λ a b carry => BitVec::nil(),
        Succ(_, ih) => λ a b carry =>
            BitVec::add_bits_next(a.tail_bits(), b.tail_bits(),
                BitVec::carry_majority(a.head_bit(), b.head_bit(), carry), ih)
                .cons_bit(BitVec::sum_bit(a.head_bit(), b.head_bit(), carry)),
    })(a, b, carry)
}

fn BitVec::ripple_add({n: Nat}, self a, b: BitVec(n)) → BitVec(n) { a.add_bits(b, False) }

fn BitVec::sub_bits_next({n: Nat}, a, b: BitVec(n), borrow: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → BitVec(n)) → BitVec(n)
{
    match borrow {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

// Ripple-borrow subtraction with an incoming borrow; the borrow passed on is
// the one `borrow_bits` uses.
fn BitVec::sub_bits({n: Nat}, self a, b: BitVec(n), borrow: Bool) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) → Bool → BitVec(k) {
        Zero => λ a b borrow => BitVec::nil(),
        Succ(_, ih) => λ a b borrow =>
            BitVec::sub_bits_next(a.tail_bits(), b.tail_bits(),
                BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow), ih)
                .cons_bit(BitVec::sum_bit(a.head_bit(), b.head_bit(), borrow)),
    })(a, b, borrow)
}

fn BitVec::ripple_sub({n: Nat}, self a, b: BitVec(n)) → BitVec(n) { a.sub_bits(b, False) }

fn BitVec::ripple_neg({n: Nat}, self a: BitVec(n)) → BitVec(n) {
    BitVec::zero().ripple_sub(a)
}

// The canonical operations. `ripple_add` and `add` are the same definition
// under two names; the `ripple_*` spelling stays because proofs and emitted
// certificates name it.
fn BitVec::add({n: Nat}, self a, b: BitVec(n)) → BitVec(n) { a.ripple_add(b) }

fn BitVec::sub({n: Nat}, self a, b: BitVec(n)) → BitVec(n) { a.ripple_sub(b) }

fn BitVec::neg({n: Nat}, self a: BitVec(n)) → BitVec(n) { a.ripple_neg() }

// `mul` still routes through `ofNat` above `2^n`; see the design doc for why
// it is left. Its truncation is no longer a loop over the quotient — `ofNat`
// takes the low `n` bits by construction — so what this costs is the product
// and the width.
fn BitVec::mul({n: Nat}, self a, b: BitVec(n)) → BitVec(n) {
    BitVec::ofNat(a.toNat() * b.toNat())
}

fn BitVec::carry_add({n: Nat}, self a, b: BitVec(n)) → Type {
    Nat::pow(2, n) <= a.toNat() + b.toNat()
}

// Executable carry view. `carry_add` above is the arithmetic proposition used
// by proofs; instruction semantics and other evaluators need the same fact as
// a Boolean without deciding an open comparison involving `2^n`. This ripple
// runs structurally over the bits and therefore remains linear at width 64.
// The column function itself is `carry_majority`, defined with the ripples
// above.
fn BitVec::carry_bits_next({n: Nat}, a, b: BitVec(n), carry: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → Bool) → Bool
{
    match carry {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

fn BitVec::carry_bits({n: Nat}, self a, b: BitVec(n), carry: Bool) → Bool {
    (match n as λ k => BitVec(k) → BitVec(k) → Bool → Bool {
        Zero => λ a b carry => carry,
        // Force the next accumulator before recurring. Leaving this as the
        // third argument expression builds a chain of suspended majority
        // computations whose environments retain every preceding vector
        // projection; a machine-width closed computation then has quadratic
        // reduction work and pathological retained state despite the ripple
        // algorithm itself being linear.
        Succ(_, ih) => λ a b carry => BitVec::carry_bits_next(
            a.tail_bits(), b.tail_bits(),
            BitVec::carry_majority(a.head_bit(), b.head_bit(), carry), ih),
    })(a, b, carry)
}

fn BitVec::carry_add_bit({n: Nat}, self a, b: BitVec(n)) → Bool {
    a.carry_bits(b, False)
}

// ---------------------------------------------------------------------------
// Structural carry agrees with the unsigned arithmetic characterization.

fn BitVec::carry_weight(a, b, carry: Bool) → Nat {
    (Nat::of_bit(a) + Nat::of_bit(b)) + Nat::of_bit(carry)
}

theorem BitVec::carry_sum_normalize(x, y, z, a, b: Nat):
    (x + Nat::twice(a)) + (y + Nat::twice(b)) + z =
    Nat::twice(a + b) + ((x + y) + z)
{
    calc {
        (x + Nat::twice(a)) + (y + Nat::twice(b)) + z
            = ((x + y) + (Nat::twice(a) + Nat::twice(b))) + z :=
                Nat::cong(λ (q: Nat) => q + z,
                    Nat::add_swap_middle(x, Nat::twice(a), y, Nat::twice(b))),
            = ((Nat::twice(a) + Nat::twice(b)) + (x + y)) + z :=
                Nat::cong(λ (q: Nat) => q + z,
                    Nat::add_comm(x + y, Nat::twice(a) + Nat::twice(b))),
            = (Nat::twice(a) + Nat::twice(b)) + ((x + y) + z) :=
                Nat::add_assoc(Nat::twice(a) + Nat::twice(b), x + y, z),
            = Nat::twice(a + b) + ((x + y) + z) :=
                Nat::cong(λ (q: Nat) => q + ((x + y) + z),
                    sym(Nat::twice_add(a, b))),
    }
}

theorem BitVec::pow_two_succ_twice(n: Nat):
    Nat::pow(2, Succ(n)) = Nat::twice(Nat::pow(2, n))
{
    let p = Nat::pow(2, n);
    calc {
        Nat::pow(2, Succ(n))
            = (0 + p) + p := refl,
            = p + p := Nat::cong(λ (q: Nat) => q + p, Nat::add_left_zero(p)),
            = Nat::twice(p) := sym(Nat::twice_add_self(p)),
    }
}

theorem BitVec::carry_threshold(a, b, carry: Bool, power, tail_sum: Nat):
    (Nat::twice(power) <= Nat::twice(tail_sum) + BitVec::carry_weight(a, b, carry)) ↔
    (power <= tail_sum + Nat::of_bit(BitVec::carry_majority(a, b, carry)))
{
    match a {
        False => match b {
            False => match carry {
                False => Nat::twice_le_twice_iff(power, tail_sum),
                True => Nat::twice_le_succ_twice_iff(power, tail_sum),
            },
            True => match carry {
                False => Nat::twice_le_succ_twice_iff(power, tail_sum),
                True => Nat::twice_le_twice_iff(power, Succ(tail_sum)),
            },
        },
        True => match b {
            False => match carry {
                False => Nat::twice_le_succ_twice_iff(power, tail_sum),
                True => Nat::twice_le_twice_iff(power, Succ(tail_sum)),
            },
            True => match carry {
                False => Nat::twice_le_twice_iff(power, Succ(tail_sum)),
                True => Nat::twice_le_succ_twice_iff(power, Succ(tail_sum)),
            },
        },
    }
}

fn BitVec::CarryBitTrue({n: Nat}, a, b: BitVec(n), carry: Bool) → Type {
    a.carry_bits(b, carry) = True
}

fn BitVec::CarryArithmetic({n: Nat}, a, b: BitVec(n), carry: Bool) → Type {
    Nat::pow(2, n) <= a.toNat() + b.toNat() + Nat::of_bit(carry)
}

theorem BitVec::carry_bits_step(n: Nat, a, b: BitVec(Succ(n)), carry: Bool):
    BitVec::CarryBitTrue(a, b, carry) ↔
    BitVec::CarryBitTrue(a.tail_bits(), b.tail_bits(), BitVec::carry_majority(a.head_bit(), b.head_bit(), carry))
{
    match BitVec::carry_majority(a.head_bit(), b.head_bit(), carry)
        as λ next =>
            (BitVec::carry_bits_next(a.tail_bits(), b.tail_bits(), next, λ x y c => x.carry_bits(y, c)) = True) ↔
            BitVec::CarryBitTrue(a.tail_bits(), b.tail_bits(), next)
    {
        False => Iff(mp := λ h => h, mpr := λ h => h),
        True => Iff(mp := λ h => h, mpr := λ h => h),
    }
}

theorem BitVec::carry_arithmetic_step(n: Nat, a, b: BitVec(Succ(n)), carry: Bool):
    BitVec::CarryArithmetic(a, b, carry) ↔
    BitVec::CarryArithmetic(a.tail_bits(), b.tail_bits(), BitVec::carry_majority(a.head_bit(), b.head_bit(), carry))
{
    let left = (a.tail_bits()).toNat();
    let right = (b.tail_bits()).toNat();
    iff_trans(
        Nat::le_congr_iff(
            Nat::pow(2, Succ(n)), Nat::twice(Nat::pow(2, n)),
            a.toNat() + b.toNat() + Nat::of_bit(carry),
            Nat::twice(left + right) +
                BitVec::carry_weight(a.head_bit(), b.head_bit(), carry),
            BitVec::pow_two_succ_twice(n),
            BitVec::carry_sum_normalize(
                Nat::of_bit(a.head_bit()), Nat::of_bit(b.head_bit()),
                Nat::of_bit(carry), left, right)),
        BitVec::carry_threshold(a.head_bit(), b.head_bit(), carry,
            Nat::pow(2, n), left + right))
}

theorem BitVec::carry_bits_true_iff_arithmetic(n: Nat):
    (a, b: BitVec(n)) → (carry: Bool) →
    (BitVec::CarryBitTrue(a, b, carry) ↔ BitVec::CarryArithmetic(a, b, carry))
{
    match n as λ k => (a, b: BitVec(k)) → (carry: Bool) →
        (BitVec::CarryBitTrue(a, b, carry) ↔ BitVec::CarryArithmetic(a, b, carry)) {
        Zero => λ a b carry => match carry {
            False => Iff(
                mp := λ bad => absurd(bad),
                mpr := λ bad => false_elim(bad)),
            True => Iff(mp := λ h => trivial, mpr := λ h => refl),
        },
        Succ(k, ih) => λ a b carry => iff_trans(
            BitVec::carry_bits_step(k, a, b, carry),
            iff_trans(
                ih(a.tail_bits(), b.tail_bits(),
                    BitVec::carry_majority(a.head_bit(), b.head_bit(), carry)),
                iff_sym(BitVec::carry_arithmetic_step(k, a, b, carry)))),
    }
}

theorem BitVec::carry_add_bit_true_iff(n: Nat, a, b: BitVec(n)):
    (a.carry_add_bit(b) = True) ↔ a.carry_add(b)
{
    BitVec::carry_bits_true_iff_arithmetic(n, a, b, False)
}

theorem BitVec::carry_add_of_bit_true(n: Nat, a, b: BitVec(n),
    h: a.carry_add_bit(b) = True): a.carry_add(b)
{
    BitVec::carry_add_bit_true_iff(n, a, b).mp(h)
}

theorem BitVec::carry_add_bit_of_carry(n: Nat, a, b: BitVec(n),
    h: a.carry_add(b)): a.carry_add_bit(b) = True
{
    BitVec::carry_add_bit_true_iff(n, a, b).mpr(h)
}

fn BitVec::borrow_sub({n: Nat}, self a, b: BitVec(n)) → Type { a.toNat() < b.toNat() }

// Executable ripple-borrow view for subtraction. Like `carry_add_bit`, this
// runs over the vector structure rather than deciding an open Nat comparison.
// The column function itself is `borrow_next`, defined with the ripples above.
fn BitVec::borrow_bits_next({n: Nat}, a, b: BitVec(n), borrow: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → Bool) → Bool
{
    match borrow {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

fn BitVec::borrow_bits({n: Nat}, self a, b: BitVec(n), borrow: Bool) → Bool {
    (match n as λ k => BitVec(k) → BitVec(k) → Bool → Bool {
        Zero => λ a b borrow => borrow,
        Succ(_, ih) => λ a b borrow => BitVec::borrow_bits_next(
            a.tail_bits(), b.tail_bits(),
            BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow), ih),
    })(a, b, borrow)
}

fn BitVec::borrow_sub_bit({n: Nat}, self a, b: BitVec(n)) → Bool {
    a.borrow_bits(b, False)
}

// ---------------------------------------------------------------------------
// Structural borrow agrees with the unsigned arithmetic characterization.

fn BitVec::bit_with_tail(bit: Bool, tail: Nat) → Nat {
    match bit { False => tail.twice(), True => Succ(tail.twice()) }
}

theorem BitVec::bit_with_tail_normalize(bit: Bool, tail: Nat):
    Nat::of_bit(bit) + Nat::twice(tail) = BitVec::bit_with_tail(bit, tail)
{
    match bit {
        False => Nat::add_left_zero(Nat::twice(tail)),
        True => trans(Nat::add_succ_left(0, Nat::twice(tail)),
            Nat::cong_succ(Nat::add_left_zero(Nat::twice(tail)))),
    }
}

fn BitVec::borrow_right_value(bit, borrow: Bool, tail: Nat) → Nat {
    match bit {
        False => match borrow {
            False => Nat::twice(tail),
            True => Succ(Nat::twice(tail)),
        },
        True => match borrow {
            False => Succ(Nat::twice(tail)),
            True => Nat::twice(Succ(tail)),
        },
    }
}

theorem BitVec::borrow_right_normalize(bit, borrow: Bool, tail: Nat):
    Nat::of_bit(bit) + Nat::twice(tail) + Nat::of_bit(borrow) =
        BitVec::borrow_right_value(bit, borrow, tail)
{
    match bit {
        False => match borrow {
            False => Nat::add_left_zero(Nat::twice(tail)),
            True => Nat::cong_succ(Nat::add_left_zero(Nat::twice(tail))),
        },
        True => match borrow {
            False => trans(Nat::add_succ_left(0, Nat::twice(tail)),
                Nat::cong_succ(Nat::add_left_zero(Nat::twice(tail)))),
            True => Nat::cong_succ(trans(Nat::add_succ_left(0, Nat::twice(tail)),
                Nat::cong_succ(Nat::add_left_zero(Nat::twice(tail))))),
        },
    }
}

theorem BitVec::borrow_threshold(a, b, borrow: Bool, left, right: Nat):
    (BitVec::bit_with_tail(a, left) < BitVec::borrow_right_value(b, borrow, right)) ↔
    (left < right + Nat::of_bit(BitVec::borrow_next(a, b, borrow)))
{
    match a {
        False => match b {
            False => match borrow {
                False => Nat::twice_lt_twice_iff(left, right),
                True => Nat::twice_lt_succ_twice_iff(left, right),
            },
            True => match borrow {
                False => Nat::twice_lt_succ_twice_iff(left, right),
                True => Nat::twice_lt_twice_iff(left, Succ(right)),
            },
        },
        True => match b {
            False => match borrow {
                False => Nat::twice_le_twice_iff(Succ(left), right),
                True => Nat::twice_lt_twice_iff(left, right),
            },
            True => match borrow {
                False => Nat::twice_lt_twice_iff(left, right),
                True => Nat::twice_le_twice_iff(Succ(left), Succ(right)),
            },
        },
    }
}

fn BitVec::BorrowBitTrue({n: Nat}, a, b: BitVec(n), borrow: Bool) → Type {
    a.borrow_bits(b, borrow) = True
}

fn BitVec::BorrowArithmetic({n: Nat}, a, b: BitVec(n), borrow: Bool) → Type {
    a.toNat() < b.toNat() + Nat::of_bit(borrow)
}

theorem BitVec::borrow_bits_step(n: Nat, a, b: BitVec(Succ(n)), borrow: Bool):
    BitVec::BorrowBitTrue(a, b, borrow) ↔
    BitVec::BorrowBitTrue(a.tail_bits(), b.tail_bits(), BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow))
{
    match BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow)
        as λ next =>
            (BitVec::borrow_bits_next(a.tail_bits(), b.tail_bits(), next, λ x y c => x.borrow_bits(y, c)) = True) ↔
            BitVec::BorrowBitTrue(a.tail_bits(), b.tail_bits(), next)
    {
        False => Iff(mp := λ h => h, mpr := λ h => h),
        True => Iff(mp := λ h => h, mpr := λ h => h),
    }
}

theorem BitVec::borrow_arithmetic_step(n: Nat, a, b: BitVec(Succ(n)), borrow: Bool):
    BitVec::BorrowArithmetic(a, b, borrow) ↔
    BitVec::BorrowArithmetic(a.tail_bits(), b.tail_bits(), BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow))
{
    let left = (a.tail_bits()).toNat();
    let right = (b.tail_bits()).toNat();
    iff_trans(
        Nat::lt_congr_iff(
            a.toNat(), BitVec::bit_with_tail(a.head_bit(), left),
            b.toNat() + Nat::of_bit(borrow),
            BitVec::borrow_right_value(b.head_bit(), borrow, right),
            BitVec::bit_with_tail_normalize(a.head_bit(), left),
            BitVec::borrow_right_normalize(b.head_bit(), borrow, right)),
        BitVec::borrow_threshold(a.head_bit(), b.head_bit(), borrow, left, right))
}

theorem BitVec::borrow_bits_true_iff_arithmetic(n: Nat):
    (a, b: BitVec(n)) → (borrow: Bool) →
    (BitVec::BorrowBitTrue(a, b, borrow) ↔ BitVec::BorrowArithmetic(a, b, borrow))
{
    match n as λ k => (a, b: BitVec(k)) → (borrow: Bool) →
        (BitVec::BorrowBitTrue(a, b, borrow) ↔ BitVec::BorrowArithmetic(a, b, borrow)) {
        Zero => λ a b borrow => match borrow {
            False => Iff(
                mp := λ bad => absurd(bad),
                mpr := λ bad => false_elim(bad)),
            True => Iff(mp := λ h => trivial, mpr := λ h => refl),
        },
        Succ(k, ih) => λ a b borrow => iff_trans(
            BitVec::borrow_bits_step(k, a, b, borrow),
            iff_trans(
                ih(a.tail_bits(), b.tail_bits(),
                    BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow)),
                iff_sym(BitVec::borrow_arithmetic_step(k, a, b, borrow)))),
    }
}

theorem BitVec::borrow_sub_bit_true_iff(n: Nat, a, b: BitVec(n)):
    (a.borrow_sub_bit(b) = True) ↔ a.borrow_sub(b)
{
    BitVec::borrow_bits_true_iff_arithmetic(n, a, b, False)
}

theorem BitVec::borrow_sub_of_bit_true(n: Nat, a, b: BitVec(n),
    h: a.borrow_sub_bit(b) = True): a.borrow_sub(b)
{
    BitVec::borrow_sub_bit_true_iff(n, a, b).mp(h)
}

theorem BitVec::borrow_sub_bit_of_borrow(n: Nat, a, b: BitVec(n),
    h: a.borrow_sub(b)): a.borrow_sub_bit(b) = True
{
    BitVec::borrow_sub_bit_true_iff(n, a, b).mpr(h)
}

fn BitVec::bool_eq(a, b: Bool) → Bool {
    match a { False => !b, True => b }
}

fn BitVec::signed_overflow_add({n: Nat}, self a, b: BitVec(n)) → Bool {
    BitVec::bool_eq(a.sign_bit(), b.sign_bit()) &&
    !BitVec::bool_eq(a.add(b).sign_bit(), a.sign_bit())
}

fn BitVec::signed_overflow_sub({n: Nat}, self a, b: BitVec(n)) → Bool {
    !BitVec::bool_eq(a.sign_bit(), b.sign_bit()) &&
    !BitVec::bool_eq(a.sub(b).sign_bit(), a.sign_bit())
}

// Executable comparison results used by instruction semantics and IRs. The
// proposition-valued interpretations above remain the proof-facing boundary.
fn BitVec::unsigned_lt_bit({n: Nat}, self a, b: BitVec(n)) → Bool {
    a.borrow_sub_bit(b)
}

fn BitVec::signed_lt_bit({n: Nat}, self a, b: BitVec(n)) → Bool {
    a.sub(b).sign_bit().xor(a.signed_overflow_sub(b))
}

fn BitVec::unsigned_le_bit({n: Nat}, self a, b: BitVec(n)) → Bool { !b.unsigned_lt_bit(a) }

// Equality as a bit: every pair of bits agrees. Structural over the width,
// so a closed comparison costs the width and never the operands' magnitude
// (docs/native-programs-read-like-programs-design.md §3, S3).
fn BitVec::eq_bit({n: Nat}, self a, b: BitVec(n)) → Bool {
    (match n as λ k => BitVec(k) → BitVec(k) → Bool {
        Zero => λ x y => True,
        Succ(_, ih) => λ x y => BitVec::bool_eq(x.head_bit(), y.head_bit()) && ih(x.tail_bits(), y.tail_bits()),
    })(a, b)
}

// ---------------------------------------------------------------------------
// Decision instances (issues/reflection-through-decide-instances.md). The
// specification stays the notion at every proof site — `a.unsigned_lt(b)`
// is `a.toNat() < b.toNat()` and nothing here changes that — and the
// instance is where the *procedure* is chosen: the unsigned orders decide by
// the ripple borrow, transported through `borrow_sub_bit_true_iff`, so a
// closed fact costs the width and never the operands' magnitude; the signed
// orders decide through `toInt` and `Int::le_dec`, which is one synchronous
// descent since `toInt`'s negative branch stopped costing the magnitude
// (issues/int-arithmetic-over-nat-primitives.md), so no bridge to
// `signed_lt_bit` is needed for cost. Keyed at the specification's own head,
// the instance is the one resolution tries first
// (docs/reflection-through-decide-instances-design.md §3), so the derived
// `Nat::Le` decision — which also fits, by unfolding `unsigned_lt` — is never
// built for these goals.
//
// `fn`s and not `theorem`s, for `Nat::le_dec`'s reason: a decision has to
// unfold in conversion, or `decide` has nothing to run.

fn BitVec::unsigned_lt_dec({n: Nat}, self a, b: BitVec(n)) → a.unsigned_lt(b) ∨ ¬a.unsigned_lt(b) {
    match a.unsigned_lt_bit(b) as λ c =>
        (a.unsigned_lt_bit(b) = c) → (a.unsigned_lt(b) ∨ ¬a.unsigned_lt(b)) {
        True => λ h => Inl(BitVec::borrow_sub_bit_true_iff(n, a, b).mp(h)),
        False => λ h => Inr(λ p => absurd(trans(sym(h),
            BitVec::borrow_sub_bit_true_iff(n, a, b).mpr(p)))),
    }(refl)
}

// `a <= b` is `¬(b < a)`, so the same bit read the other way round; the
// `False` arm is trichotomy with the `b < a` case refuted by the bit.
fn BitVec::unsigned_le_dec({n: Nat}, self a, b: BitVec(n)) → a.unsigned_le(b) ∨ ¬a.unsigned_le(b) {
    match b.unsigned_lt_bit(a) as λ c =>
        (b.unsigned_lt_bit(a) = c) → (a.unsigned_le(b) ∨ ¬a.unsigned_le(b)) {
        True => λ h => Inr(λ p => Nat::lt_irrefl(b.toNat(), Nat::le_trans(
            Succ(b.toNat()), a.toNat(), b.toNat(),
            BitVec::borrow_sub_bit_true_iff(n, b, a).mp(h), p))),
        False => λ h => Inl(match Nat::lt_trichotomy(a.toNat(), b.toNat()) {
            Inl(lt) => Nat::le_of_lt(a.toNat())(b.toNat())(lt),
            Inr(rest) => match rest {
                Inl(eq) => rewrite(sym(eq), a.toNat().le_refl()),
                Inr(gt) => absurd(trans(sym(h),
                    BitVec::borrow_sub_bit_true_iff(n, b, a).mpr(gt))),
            },
        }),
    }(refl)
}

fn BitVec::signed_lt_dec({n: Nat}, self a, b: BitVec(n)) → a.signed_lt(b) ∨ ¬a.signed_lt(b) {
    Int::le_dec(a.toInt().isucc(), b.toInt())
}

fn BitVec::signed_le_dec({n: Nat}, self a, b: BitVec(n)) → a.signed_le(b) ∨ ¬a.signed_le(b) {
    Int::le_dec(a.toInt(), b.toInt())
}

// The unsigned orders' bits are the borrow a step branches on: `a < b` is
// `a.unsigned_lt_bit(b)`, and `a <= b` is `!b.unsigned_lt_bit(a)`, which is how
// its decision reads it.
theorem BitVec::reflects_lt(n: Nat, a, b: BitVec(n)): Reflects(a.unsigned_lt(b), a.unsigned_lt_bit(b)) {
    And(λ e => BitVec::borrow_sub_bit_true_iff(n, a, b).mp(e),
        λ e p => absurd(trans(sym(e), BitVec::borrow_sub_bit_true_iff(n, a, b).mpr(p))))
}

theorem BitVec::reflects_le(n: Nat, a, b: BitVec(n)): Reflects(a.unsigned_le(b), !b.unsigned_lt_bit(a)) {
    And(λ e => match b.unsigned_lt_bit(a) as λ c => (b.unsigned_lt_bit(a) = c) → (!c = True) → a.unsigned_le(b) {
            True => λ _ no => absurd(no),
            False => λ h _ => match Nat::lt_trichotomy(a.toNat(), b.toNat()) {
                Inl(lt) => Nat::le_of_lt(a.toNat())(b.toNat())(lt),
                Inr(rest) => match rest {
                    Inl(eq) => rewrite(sym(eq), a.toNat().le_refl()),
                    Inr(gt) => absurd(trans(sym(h), BitVec::borrow_sub_bit_true_iff(n, b, a).mpr(gt))),
                },
            },
        }(refl, e),
        λ e p => match b.unsigned_lt_bit(a) as λ c => (b.unsigned_lt_bit(a) = c) → (!c = False) → False {
            True => λ h _ => Nat::lt_irrefl(b.toNat(), Nat::le_trans(Succ(b.toNat()), a.toNat(), b.toNat(),
                BitVec::borrow_sub_bit_true_iff(n, b, a).mp(h), p)),
            False => λ _ no => absurd(no),
        }(refl, e))
}

instance(n: Nat, a, b: BitVec(n)) Decide<BitVec::unsigned_lt(a, b)> {
    dec := a.unsigned_lt_dec(b),
    bit := a.unsigned_lt_bit(b),
    reflects := BitVec::reflects_lt(n, a, b),
}
instance(n: Nat, a, b: BitVec(n)) Decide<BitVec::unsigned_le(a, b)> {
    dec := a.unsigned_le_dec(b),
    bit := !b.unsigned_lt_bit(a),
    reflects := BitVec::reflects_le(n, a, b),
}
instance(n: Nat, a, b: BitVec(n)) Decide<BitVec::signed_lt(a, b)> {
    dec := a.signed_lt_dec(b),
    bit := or_bit(a.signed_lt_dec(b)),
    reflects := or_bit_reflects(a.signed_lt_dec(b)),
}
instance(n: Nat, a, b: BitVec(n)) Decide<BitVec::signed_le(a, b)> {
    dec := a.signed_le_dec(b),
    bit := or_bit(a.signed_le_dec(b)),
    reflects := or_bit_reflects(a.signed_le_dec(b)),
}

// ---------------------------------------------------------------------------
// Shifts. Vacated bits are zero except for arithmetic right shift.

fn BitVec::init({n: Nat}, self x: BitVec(Succ(n))) → BitVec(n) {
    (match n as λ k => BitVec(Succ(k)) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_, ih) => λ x => ih(x.tail_bits()).cons_bit(x.head_bit()),
    })(x)
}

fn BitVec::snoc({n: Nat}, self x: BitVec(n), b: Bool) → BitVec(Succ(n)) {
    (match n as λ k => BitVec(k) → Bool → BitVec(Succ(k)) {
        Zero => λ x b => BitVec::from_bits([b]),
        Succ(_, ih) => λ x b => ih(x.tail_bits(), b).cons_bit(x.head_bit()),
    })(x, b)
}

fn BitVec::shift_left_one({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_) => λ x => x.init().cons_bit(False),
    })(x)
}

fn BitVec::shift_right_one({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_) => λ x => x.tail_bits().snoc(False),
    })(x)
}

fn BitVec::arithmetic_shift_right_one({n: Nat}, self x: BitVec(n)) → BitVec(n) {
    (match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => BitVec::nil(),
        Succ(_) => λ x => x.tail_bits().snoc(x.sign_bit()),
    })(x)
}

fn BitVec::shift_left({n: Nat}, self x: BitVec(n), count: Nat) → BitVec(n) {
    match count { Zero => x, Succ(k) => x.shift_left(k).shift_left_one() }
}

fn BitVec::shift_right({n: Nat}, self x: BitVec(n), count: Nat) → BitVec(n) {
    match count { Zero => x, Succ(k) => x.shift_right(k).shift_right_one() }
}

fn BitVec::arithmetic_shift_right({n: Nat}, self x: BitVec(n), count: Nat) → BitVec(n) {
    match count {
        Zero => x,
        Succ(k) => x.arithmetic_shift_right(k).arithmetic_shift_right_one(),
    }
}

// ---------------------------------------------------------------------------
// Core pointwise laws. More arithmetic laws are stated through the explicit
// `toNat`/`toInt` boundary above; no theorem silently treats wrapped arithmetic
// as unbounded arithmetic.

theorem BitVec::xor_bit_self(b: Bool): Bool::xor(b, b) = False {
    match b { False => refl, True => refl }
}

theorem BitVec::xor_bit_comm(a, b: Bool): Bool::xor(a, b) = Bool::xor(b, a) {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

theorem BitVec::cons_bit_cong(n: Nat, {a, b: Bool}, {xs, ys: BitVec(n)},
                      ph: a = b, pt: xs = ys): xs.cons_bit(a) = ys.cons_bit(b) {
    rewrite(sym(ph), sym(pt), refl)
}

theorem BitVec::extensionality(n: Nat): (x, y: BitVec(n)) →
        ((i: Fin(n)) → x.get(i) = y.get(i)) → x = y {
    match n as λ k => (x, y: BitVec(k)) →
            ((i: Fin(k)) → x.get(i) = y.get(i)) → x = y {
        Zero => λ x y at => refl,
        Succ(k, ih) => λ x y at =>
            BitVec::cons_bit_cong(k, at(FZ),
                ih(x.tail_bits(), y.tail_bits(), λ j => at(FS(j)))),
    }
}

theorem BitVec::band_comm(n: Nat): (x, y: BitVec(n)) → x.band(y) = y.band(x) {
    match n as λ k => (x, y: BitVec(k)) → x.band(y) = y.band(x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => BitVec::cons_bit_cong(k,
            Bool::and_comm(x.head_bit(), y.head_bit()),
            ih(x.tail_bits(), y.tail_bits())),
    }
}

theorem BitVec::bor_comm(n: Nat): (x, y: BitVec(n)) → x.bor(y) = y.bor(x) {
    match n as λ k => (x, y: BitVec(k)) → x.bor(y) = y.bor(x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => BitVec::cons_bit_cong(k,
            Bool::or_comm(x.head_bit(), y.head_bit()),
            ih(x.tail_bits(), y.tail_bits())),
    }
}

theorem BitVec::bxor_comm(n: Nat): (x, y: BitVec(n)) → x.bxor(y) = y.bxor(x) {
    match n as λ k => (x, y: BitVec(k)) → x.bxor(y) = y.bxor(x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => BitVec::cons_bit_cong(k,
            BitVec::xor_bit_comm(x.head_bit(), y.head_bit()),
            ih(x.tail_bits(), y.tail_bits())),
    }
}

theorem BitVec::cong_increment(n: Nat, {x, y: BitVec(n)}, p: x = y):
        x.increment() = y.increment() {
    rewrite(p, refl)
}

theorem BitVec::cong_iterate_increment(n, count: Nat, {x, y: BitVec(n)}, p: x = y):
        x.iterate_increment(count) = y.iterate_increment(count) {
    rewrite(p, refl)
}

theorem BitVec::cong_iterate_increment_count(n: Nat, x: BitVec(n), {a, b: Nat}, p: a = b):
        x.iterate_increment(a) = x.iterate_increment(b) {
    rewrite(p, refl)
}

// Iteration is an action of Nat addition. The orientation follows `Nat::add`,
// which recurses on its second argument, and keeps each proof step definitional.
theorem BitVec::iterate_increment_compose(n: Nat, x: BitVec(n), first, second: Nat):
        (x.iterate_increment(first)).iterate_increment(second) =
        x.iterate_increment(first + second) {
    match second {
        Zero => refl,
        Succ(k) => BitVec::cong_increment(n,
            BitVec::iterate_increment_compose(n, x, first, k)),
    }
}

// At a positive width, two low-bit increments advance the tail once. This is
// the structural bridge between the unary iterator used by `add` and the
// little-endian binary interpretation used by `toNat`.
theorem BitVec::iterate_increment_twice(n: Nat, x: BitVec(n), count: Nat):
        (x.cons_bit(False)).iterate_increment(Nat::twice(count)) =
        (x.iterate_increment(count)).cons_bit(False) {
    match count {
        Zero => refl,
        Succ(k) => trans(
            BitVec::cong_increment(Succ(n), BitVec::cong_increment(Succ(n),
                BitVec::iterate_increment_twice(n, x, k))),
            refl),
    }
}

theorem BitVec::iterate_increment_succ_twice(n: Nat, x: BitVec(n), count: Nat):
        (x.cons_bit(False)).iterate_increment(Succ(Nat::twice(count))) =
        (x.iterate_increment(count)).cons_bit(True) {
    BitVec::cong_increment(Succ(n), BitVec::iterate_increment_twice(n, x, count))
}

theorem BitVec::cons_head_tail(n: Nat, x: BitVec(Succ(n))):
        (x.tail_bits()).cons_bit(x.head_bit()) = x {
    BitVec::extensionality(Succ(n),
        (x.tail_bits()).cons_bit(x.head_bit()), x,
        λ i => match i { FZ => refl, FS(_) => refl })
}

theorem BitVec::one_bit_eq_ofBool(x: BitVec(1)):
    x = BitVec::ofBool(x.head_bit())
{
    sym(BitVec::cons_head_tail(0, x))
}

theorem BitVec::iterate_increment_toNat_cons(n: Nat, bit: Bool, x: BitVec(n),
        tail_law: BitVec::iterate_increment(BitVec::zero(), x.toNat()) = x):
        BitVec::iterate_increment(BitVec::zero(), (x.cons_bit(bit)).toNat()) = x.cons_bit(bit) {
    match bit {
        False => calc {
            BitVec::zero(n := Succ(n)).iterate_increment(0 + Nat::twice(x.toNat()))
                = BitVec::zero(n := Succ(n)).iterate_increment(Nat::twice(x.toNat())) :=
                    BitVec::cong_iterate_increment_count(Succ(n), BitVec::zero(),
                        Nat::add_left_zero(Nat::twice(x.toNat()))),
                = BitVec::zero(n := n).iterate_increment(x.toNat()).cons_bit(False) :=
                    BitVec::iterate_increment_twice(n, BitVec::zero(), x.toNat()),
                = x.cons_bit(False) := BitVec::cons_bit_cong(n, refl, tail_law),
        },
        True => calc {
            BitVec::zero(n := Succ(n)).iterate_increment(1 + Nat::twice(x.toNat()))
                = BitVec::zero(n := Succ(n)).iterate_increment(Succ(Nat::twice(x.toNat()))) :=
                    BitVec::cong_iterate_increment_count(Succ(n), BitVec::zero(),
                        trans(Nat::add_succ_left(0, Nat::twice(x.toNat())),
                            Nat::cong_succ(Nat::add_left_zero(Nat::twice(x.toNat()))))),
                = BitVec::zero(n := n).iterate_increment(x.toNat()).cons_bit(True) :=
                    BitVec::iterate_increment_succ_twice(n, BitVec::zero(), x.toNat()),
                = x.cons_bit(True) := BitVec::cons_bit_cong(n, refl, tail_law),
        },
    }
}

// Every vector is exactly the initial segment of the cyclic increment orbit
// selected by its unsigned interpretation. No arithmetic bound or quotient is
// needed: the proof follows one bit and one doubled tail count at a time.
theorem BitVec::iterate_increment_toNat(n: Nat): (x: BitVec(n)) →
        BitVec::iterate_increment(BitVec::zero(), x.toNat()) = x {
    match n as λ k => (x: BitVec(k)) →
            BitVec::iterate_increment(BitVec::zero(), x.toNat()) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => trans(
            BitVec::iterate_increment_toNat_cons(k, x.head_bit(), x.tail_bits(),
                ih(x.tail_bits())),
            BitVec::cons_head_tail(k, x)),
    }
}

// The orbit closes after `2^n` increments: zero first, one doubled tail at a
// time, then any vector by its place in zero's orbit. A backward branch's
// target is this identity (`near_branch_returns` in x86_64_block).
theorem BitVec::zero_iterate_period(n: Nat):
        BitVec::zero(n := n).iterate_increment(Nat::pow(2, n)) = BitVec::zero() {
    match n as λ k => BitVec::zero(n := k).iterate_increment(Nat::pow(2, k)) = BitVec::zero() {
        Zero => refl,
        Succ(k, ih) => trans(
            BitVec::cong_iterate_increment_count(Succ(k), BitVec::zero(), BitVec::pow_two_succ_twice(k)),
            trans(BitVec::iterate_increment_twice(k, BitVec::zero(), Nat::pow(2, k)),
                BitVec::cons_bit_cong(k, refl, ih, a := False, b := False))),
    }
}

theorem BitVec::iterate_increment_period(n: Nat, x: BitVec(n)):
        x.iterate_increment(Nat::pow(2, n)) = x {
    let v = x.toNat();
    let p = Nat::pow(2, n);
    calc {
        x.iterate_increment(p)
            = BitVec::zero(n := n).iterate_increment(v).iterate_increment(p) :=
                BitVec::cong_iterate_increment(n, p, sym(BitVec::iterate_increment_toNat(n, x))),
            = BitVec::zero(n := n).iterate_increment(v + p) :=
                BitVec::iterate_increment_compose(n, BitVec::zero(), v, p),
            = BitVec::zero(n := n).iterate_increment(p + v) :=
                BitVec::cong_iterate_increment_count(n, BitVec::zero(), v.add_comm(p)),
            = BitVec::zero(n := n).iterate_increment(p).iterate_increment(v) :=
                sym(BitVec::iterate_increment_compose(n, BitVec::zero(), p, v)),
            = BitVec::zero(n := n).iterate_increment(v) :=
                BitVec::cong_iterate_increment(n, v, BitVec::zero_iterate_period(n)),
            = x := BitVec::iterate_increment_toNat(n, x),
    }
}

// Commutativity of the iterated form, by the `toNat` count. `add_comm` for the
// canonical operation is this transported along `iter_add_eq_add`, below.
theorem BitVec::iter_add_comm(n: Nat, left, right: BitVec(n)):
        left.iter_add(right) = right.iter_add(left) {
    calc {
        left.iter_add(right)
            = BitVec::zero(n := n).iterate_increment(left.toNat()).iterate_increment(right.toNat()) :=
                BitVec::cong_iterate_increment(n, right.toNat(),
                    sym(BitVec::iterate_increment_toNat(n, left))),
            = BitVec::zero(n := n).iterate_increment(left.toNat() + right.toNat()) :=
                BitVec::iterate_increment_compose(n, BitVec::zero(),
                    left.toNat(), right.toNat()),
            = BitVec::zero(n := n).iterate_increment(right.toNat() + left.toNat()) :=
                BitVec::cong_iterate_increment_count(n, BitVec::zero(),
                    Nat::add_comm(left.toNat(), right.toNat())),
            = BitVec::zero(n := n).iterate_increment(right.toNat()).iterate_increment(left.toNat()) :=
                sym(BitVec::iterate_increment_compose(n, BitVec::zero(),
                    right.toNat(), left.toNat())),
            = right.iter_add(left) :=
                BitVec::cong_iterate_increment(n, left.toNat(),
                    BitVec::iterate_increment_toNat(n, right)),
    }
}

fn BitVec::eq_dec({n: Nat}, self x, y: BitVec(n)) → x = y ∨ x ≠ y {
    (match n as λ k => (x, y: BitVec(k)) → x = y ∨ x ≠ y {
        Zero => λ x y => Inl(refl),
        Succ(k, ih) => λ x y =>
            match Bool::eq_dec(x.head_bit(), y.head_bit()) {
                Inl(head_eq) =>
                    match ih(x.tail_bits(), y.tail_bits()) {
                        Inl(tail_eq) => Inl(BitVec::cons_bit_cong(k, head_eq, tail_eq)),
                        Inr(tail_ne) => Inr(λ (bad: x = y) =>
                            tail_ne(rewrite(bad, refl))),
                    },
                Inr(head_ne) => Inr(λ (bad: x = y) =>
                    head_ne(rewrite(bad, refl))),
            },
    })(x, y)
}

// `eq_bit` is equality (S3 of docs/native-programs-read-like-programs-design.md).
theorem BitVec::bool_eq_self(a: Bool): BitVec::bool_eq(a, a) = True { match a { False => refl, True => refl } }

theorem BitVec::bool_eq_true(a: Bool): (b: Bool) → BitVec::bool_eq(a, b) = True → a = b {
    match a as λ x => (b: Bool) → BitVec::bool_eq(x, b) = True → x = b {
        False => λ b => match b as λ y => BitVec::bool_eq(bool::False, y) = True → bool::False = y {
            False => λ _ => refl,
            True => λ no => absurd(no),
        },
        True => λ b => match b as λ y => BitVec::bool_eq(bool::True, y) = True → bool::True = y {
            False => λ no => absurd(no),
            True => λ _ => refl,
        },
    }
}

theorem BitVec::and_true_left(a: Bool): (b: Bool) → a && b = True → a = True {
    match a as λ x => (b: Bool) → x && b = True → x = bool::True { False => λ b no => no, True => λ b _ => refl }
}

theorem BitVec::and_true_right(a: Bool): (b: Bool) → a && b = True → b = True {
    match a as λ x => (b: Bool) → x && b = True → b = True { False => λ b no => absurd(no), True => λ b yes => yes }
}

theorem BitVec::eq_bit_self(n: Nat): (x: BitVec(n)) → x.eq_bit(x) = True {
    match n as λ k => (x: BitVec(k)) → x.eq_bit(x) = True {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => j(sym(BitVec::bool_eq_self(x.head_bit())),
            λ h _ => h && x.tail_bits().eq_bit(x.tail_bits()) = True, ih(x.tail_bits())),
    }
}

theorem BitVec::eq_of_eq_bit(n: Nat): (x, y: BitVec(n)) → x.eq_bit(y) = True → x = y {
    match n as λ k => (x, y: BitVec(k)) → x.eq_bit(y) = True → x = y {
        Zero => λ x y _ => refl,
        Succ(k, ih) => λ x y same => {
            let heads = BitVec::and_true_left(BitVec::bool_eq(x.head_bit(), y.head_bit()), x.tail_bits().eq_bit(y.tail_bits()), same);
            let tails = BitVec::and_true_right(BitVec::bool_eq(x.head_bit(), y.head_bit()), x.tail_bits().eq_bit(y.tail_bits()), same);
            BitVec::cons_bit_cong(k, BitVec::bool_eq_true(x.head_bit(), y.head_bit(), heads), ih(x.tail_bits(), y.tail_bits(), tails))
        },
    }
}

// The bit is the proposition: `True` exactly at equal words.
theorem BitVec::eq_bit_of_eq(n: Nat, x, y: BitVec(n), same: x = y): x.eq_bit(y) = True {
    rewrite(sym(same), BitVec::eq_bit_self(n, x))
}
theorem BitVec::ne_of_eq_bit(n: Nat, x, y: BitVec(n), differ: x.eq_bit(y) = False): x ≠ y {
    λ same => absurd(trans(sym(differ), BitVec::eq_bit_of_eq(n, x, y, same)))
}

// Equality decides by `eq_bit`, the bit a step branches on, the way the
// orders above decide by the borrow.
fn BitVec::eq_bit_dec({n: Nat}, self a, b: BitVec(n)) → a = b ∨ a ≠ b {
    match a.eq_bit(b) as λ c => (a.eq_bit(b) = c) → (a = b ∨ a ≠ b) {
        True => λ h => Inl(BitVec::eq_of_eq_bit(n, a, b, h)),
        False => λ h => Inr(BitVec::ne_of_eq_bit(n, a, b, h)),
    }(refl)
}

instance(n: Nat, a, b: BitVec(n)) Decide<a = b> {
    dec := a.eq_bit_dec(b),
    bit := a.eq_bit(b),
    reflects := And(λ e => BitVec::eq_of_eq_bit(n, a, b, e), λ e => BitVec::ne_of_eq_bit(n, a, b, e)),
}

// What a step writes about bytes (docs/native-programs-read-like-programs-design.md
// §3, S3): `b < 32` and `'\t' <= b` are the unsigned orders, as Lean reads
// `<` at a bit vector; a numeral at a word is its `ofNat` (a character at a
// byte is, too: lib/std/bitvec/byte.hthr).
designation <= at BitVec(n) := BitVec::unsigned_le
designation < at BitVec(n) := BitVec::unsigned_lt
instance(n: Nat) Numeral<BitVec(n)> { ofNat := λ (k: Nat) => BitVec::ofNat(k) }

theorem BitVec::decrement_increment_step(n: Nat, b: Bool, x: BitVec(n),
        tail_law: (x.increment()).decrement() = x):
        ((x.cons_bit(b)).increment()).decrement() = x.cons_bit(b) {
    match b {
        False => refl,
        True => BitVec::cons_bit_cong(n, refl, tail_law, a := True, b := True),
    }
}

theorem BitVec::decrement_increment(n: Nat): (x: BitVec(n)) →
        (x.increment()).decrement() = x {
    match n as λ k => (x: BitVec(k)) → (x.increment()).decrement() = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            BitVec::decrement_increment_step(k, x.head_bit(), x.tail_bits(),
                ih(x.tail_bits())),
    }
}

theorem BitVec::cong_iterate_decrement(n, count: Nat, {x, y: BitVec(n)}, p: x = y):
        x.iterate_decrement(count) = y.iterate_decrement(count) {
    rewrite(p, refl)
}

theorem BitVec::iterate_add_sub_cancel(n: Nat, count: Nat): (x: BitVec(n)) →
        (x.iterate_increment(count)).iterate_decrement(count) = x {
    match count as λ k => (x: BitVec(n)) →
            (x.iterate_increment(k)).iterate_decrement(k) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            trans(BitVec::cong_iterate_decrement(n, k,
                      BitVec::decrement_increment(n, x.iterate_increment(k))), ih(x)),
    }
}

// The other order: decrementing then incrementing is the identity too, so a
// subtraction undoes by counting back up (CMP's ZF law in x86_64 needs it).
theorem BitVec::increment_decrement_step(n: Nat, b: Bool, x: BitVec(n),
        tail_law: (x.decrement()).increment() = x):
        ((x.cons_bit(b)).decrement()).increment() = x.cons_bit(b) {
    match b {
        False => BitVec::cons_bit_cong(n, refl, tail_law, a := False, b := False),
        True => refl,
    }
}

theorem BitVec::increment_decrement(n: Nat): (x: BitVec(n)) → (x.decrement()).increment() = x {
    match n as λ k => (x: BitVec(k)) → (x.decrement()).increment() = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => trans(BitVec::increment_decrement_step(k, x.head_bit(), x.tail_bits(), ih(x.tail_bits())),
            BitVec::cons_head_tail(k, x)),
    }
}

theorem BitVec::iterate_sub_add(n: Nat, count: Nat): (x: BitVec(n)) →
        (x.iterate_decrement(count)).iterate_increment(count) = x {
    match count as λ c => (x: BitVec(n)) → (x.iterate_decrement(c)).iterate_increment(c) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => trans(rewrite(sym(ih(x.decrement())), refl),
            BitVec::increment_decrement(n, x)),
    }
}

theorem BitVec::iter_add_sub_cancel(n: Nat, a, b: BitVec(n)):
        (a.iter_add(b)).iter_sub(b) = a {
    BitVec::iterate_add_sub_cancel(n, b.toNat(), a)
}

theorem BitVec::xor_self(n: Nat): (x: BitVec(n)) → x.bxor(x) = BitVec::zero() {
    match n as λ k => (x: BitVec(k)) → x.bxor(x) = BitVec::zero() {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            BitVec::cons_bit_cong(k, BitVec::xor_bit_self(x.head_bit()), ih(x.tail_bits())),
    }
}

theorem BitVec::get_set_same(n: Nat): (x: BitVec(n)) → (i: Fin(n)) → (b: Bool) →
                     (x.set(i, b)).get(i) = b {
    match n as λ k => (x: BitVec(k)) → (i: Fin(k)) → (b: Bool) →
                           (x.set(i, b)).get(i) = b {
        Zero => λ x i b => match i { },
        Succ(k, ih) => λ x i b => match i {
            FZ => refl,
            FS(j) => ih(x.tail_bits(), j, b),
        },
    }
}

theorem BitVec::split_concat_low(n: Nat): (m: Nat) → (lo: BitVec(n)) →
                         (hi: BitVec(m)) → BitVec::take_low(n, m, lo.concat(hi)) = lo {
    match n as λ k => (m: Nat) → (lo: BitVec(k)) → (hi: BitVec(m)) →
                           BitVec::take_low(k, m, lo.concat(hi)) = lo {
        Zero => λ m lo hi => refl,
        Succ(k, ih) => λ m lo hi =>
            BitVec::cons_bit_cong(k, refl, ih(m, lo.tail_bits(), hi),
                a := lo.head_bit(), b := lo.head_bit()),
    }
}

theorem BitVec::split_concat_high(n: Nat): (m: Nat) → (lo: BitVec(n)) →
                          (hi: BitVec(m)) → BitVec::drop_low(n, m, lo.concat(hi)) = hi {
    match n as λ k => (m: Nat) → (lo: BitVec(k)) → (hi: BitVec(m)) →
                           BitVec::drop_low(k, m, lo.concat(hi)) = hi {
        Zero => λ m lo hi => refl,
        Succ(k, ih) => λ m lo hi => ih(m, lo.tail_bits(), hi),
    }
}

// Splitting a vector at any width and joining the two pieces again is the
// identity.  This is the converse used by byte-oriented encoders: they may
// expose a word as little-endian chunks without changing its typed value.
theorem BitVec::concat_split(n: Nat): (m: Nat) → (x: BitVec(m + n)) →
        BitVec::concat(BitVec::take_low(n, m, x), BitVec::drop_low(n, m, x)) = x {
    match n as λ k => (m: Nat) → (x: BitVec(m + k)) →
            BitVec::take_low(k, m, x).concat(BitVec::drop_low(k, m, x)) = x {
        Zero => λ m x => refl,
        Succ(k, ih) => λ m x => trans(
            BitVec::cons_bit_cong(m + k, refl, ih(m, x.tail_bits()),
                a := x.head_bit(), b := x.head_bit()),
            BitVec::cons_head_tail(m + k, x)),
    }
}

theorem BitVec::truncate_zero_extend(n, extra: Nat, x: BitVec(n)):
        BitVec::truncate(n, extra, x.zero_extend(extra)) = x {
    BitVec::split_concat_low(n, extra, x, BitVec::zero())
}

theorem BitVec::truncate_sign_extend(n, extra: Nat, x: BitVec(Succ(n))):
        BitVec::truncate(Succ(n), extra, x.sign_extend(extra)) = x {
    BitVec::split_concat_low(Succ(n), extra, x,
        BitVec::repeat_bit(x.get(BitVec::last_index(n))))
}

// ---------------------------------------------------------------------------
// The ripples are equal to the iterated forms
// (issues/bitvec-bounded-add-sub.md). The definitions live above, next to
// `add`; what follows is the induction that identifies them with
// `iterate_increment` and `iterate_decrement` over `toNat`, and the transports
// between the two spellings.

theorem BitVec::cons_bit_tail_cong(n: Nat, b: Bool, {xs, ys: BitVec(n)}, pt: xs = ys):
    xs.cons_bit(b) = ys.cons_bit(b)
{
    rewrite(pt, refl)
}

// Two increments at a positive width advance the tail once and restore the
// low bit, whatever it was; `iterate_increment_twice` is the low-bit-zero
// instance.
theorem BitVec::increment_increment_cons(n: Nat, b: Bool, x: BitVec(n)):
    ((x.cons_bit(b)).increment()).increment() =
    (x.increment()).cons_bit(b)
{
    match b { False => refl, True => refl }
}

theorem BitVec::iterate_increment_twice_cons(n: Nat, b: Bool, x: BitVec(n), count: Nat):
    (x.cons_bit(b)).iterate_increment(Nat::twice(count)) =
    (x.iterate_increment(count)).cons_bit(b)
{
    match count {
        Zero => refl,
        Succ(k) => trans(
            BitVec::cong_increment(Succ(n), BitVec::cong_increment(Succ(n),
                BitVec::iterate_increment_twice_cons(n, b, x, k))),
            BitVec::increment_increment_cons(n, b, x.iterate_increment(k))),
    }
}

// One column of the addition, at fully cased bits. The count is first put in
// the `borrow_right_value` normal form (`Nat::twice(t)`, `Succ(Nat::twice(t))` or
// `Nat::twice(Succ(t))` by the two low weights), after which every case is the
// doubled-tail law above followed by zero, one or two low-bit increments.
theorem BitVec::add_bits_cons_leaf(k: Nat, ha, hb, carry: Bool, ta, tb: BitVec(k)):
    (ta.iterate_increment(tb.toNat() + Nat::of_bit(BitVec::carry_majority(ha, hb, carry))) =
        ta.add_bits(tb, BitVec::carry_majority(ha, hb, carry))) →
    (ta.cons_bit(ha)).iterate_increment(BitVec::borrow_right_value(hb, carry, tb.toNat())) =
    (ta.cons_bit(ha)).add_bits(tb.cons_bit(hb), carry)
{
    match hb {
        False => match carry {
            False => match ha {
                False => λ tail_law => trans(
                    BitVec::iterate_increment_twice_cons(k, False, ta, tb.toNat()),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
                True => λ tail_law => trans(
                    BitVec::iterate_increment_twice_cons(k, True, ta, tb.toNat()),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
            },
            True => match ha {
                False => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, False, ta, tb.toNat())),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
                True => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, True, ta, tb.toNat())),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
            },
        },
        True => match carry {
            False => match ha {
                False => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, False, ta, tb.toNat())),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
                True => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, True, ta, tb.toNat())),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
            },
            True => match ha {
                False => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k), BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, False, ta, tb.toNat()))),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
                True => λ tail_law => trans(
                    BitVec::cong_increment(Succ(k), BitVec::cong_increment(Succ(k),
                        BitVec::iterate_increment_twice_cons(k, True, ta, tb.toNat()))),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
            },
        },
    }
}

theorem BitVec::add_bits_cons(k: Nat, ha, hb, carry: Bool, ta, tb: BitVec(k),
    tail_law: ta.iterate_increment(tb.toNat() + Nat::of_bit(BitVec::carry_majority(ha, hb, carry))) =
        ta.add_bits(tb, BitVec::carry_majority(ha, hb, carry))):
    (ta.cons_bit(ha)).iterate_increment((tb.cons_bit(hb)).toNat() + Nat::of_bit(carry)) =
    (ta.cons_bit(ha)).add_bits(tb.cons_bit(hb), carry)
{
    trans(
        BitVec::cong_iterate_increment_count(Succ(k), ta.cons_bit(ha),
            BitVec::borrow_right_normalize(hb, carry, tb.toNat())),
        BitVec::add_bits_cons_leaf(k, ha, hb, carry, ta, tb, tail_law))
}

theorem BitVec::iterate_increment_add_bits(n: Nat): (a, b: BitVec(n)) → (carry: Bool) →
    a.iterate_increment(b.toNat() + Nat::of_bit(carry)) = a.add_bits(b, carry)
{
    match n as λ k => (a, b: BitVec(k)) → (carry: Bool) →
        a.iterate_increment(b.toNat() + Nat::of_bit(carry)) = a.add_bits(b, carry) {
        Zero => λ a b carry => match carry { False => refl, True => refl },
        Succ(k, ih) => λ a b carry => trans(
            BitVec::cong_iterate_increment(Succ(k), b.toNat() + Nat::of_bit(carry),
                sym(BitVec::cons_head_tail(k, a))),
            BitVec::add_bits_cons(k, a.head_bit(), b.head_bit(), carry,
                a.tail_bits(), b.tail_bits(),
                ih(a.tail_bits(), b.tail_bits(),
                    BitVec::carry_majority(a.head_bit(), b.head_bit(), carry)))),
    }
}

// The meaning of the incoming carry, and the public equation.
theorem BitVec::add_bits_spec(n: Nat, a, b: BitVec(n), carry: Bool):
    a.add_bits(b, carry) =
    a.iterate_increment(b.toNat() + Nat::of_bit(carry))
{
    sym(BitVec::iterate_increment_add_bits(n, a, b, carry))
}

// The iterated form agrees with `add` at every width and every operand. This
// is the equation the swap of definitions turned around: `add` is the ripple,
// so `ripple_add_eq_add` is `refl` and this carries the induction's content.
theorem BitVec::iter_add_eq_add(n: Nat, a, b: BitVec(n)):
    a.iter_add(b) = a.add(b)
{
    BitVec::iterate_increment_add_bits(n, a, b, False)
}

theorem BitVec::ripple_add_eq_add(n: Nat, a, b: BitVec(n)):
    a.ripple_add(b) = a.add(b)
{
    refl
}

// Two decrements at a positive width retreat the tail once and restore the
// low bit.
theorem BitVec::decrement_decrement_cons(n: Nat, b: Bool, x: BitVec(n)):
    ((x.cons_bit(b)).decrement()).decrement() =
    (x.decrement()).cons_bit(b)
{
    match b { False => refl, True => refl }
}

theorem BitVec::iterate_decrement_twice_cons(n: Nat, b: Bool, count: Nat): (x: BitVec(n)) →
    (x.cons_bit(b)).iterate_decrement(Nat::twice(count)) =
    (x.iterate_decrement(count)).cons_bit(b)
{
    match count as λ c => (x: BitVec(n)) →
        (x.cons_bit(b)).iterate_decrement(Nat::twice(c)) =
        (x.iterate_decrement(c)).cons_bit(b) {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => trans(
            BitVec::cong_iterate_decrement(Succ(n), Nat::twice(k),
                BitVec::decrement_decrement_cons(n, b, x)),
            ih(x.decrement())),
    }
}

// One column of the subtraction. `iterate_decrement` applies its decrements
// innermost first, so a low weight of one or two is one or two decrements of
// the cons before the doubled-tail law applies.
theorem BitVec::sub_bits_cons_leaf(k: Nat, ha, hb, borrow: Bool, ta, tb: BitVec(k)):
    (ta.iterate_decrement(tb.toNat() + Nat::of_bit(BitVec::borrow_next(ha, hb, borrow))) =
        ta.sub_bits(tb, BitVec::borrow_next(ha, hb, borrow))) →
    (ta.cons_bit(ha)).iterate_decrement(BitVec::borrow_right_value(hb, borrow, tb.toNat())) =
    (ta.cons_bit(ha)).sub_bits(tb.cons_bit(hb), borrow)
{
    match hb {
        False => match borrow {
            False => match ha {
                False => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, False, tb.toNat(), ta),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
                True => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, True, tb.toNat(), ta),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
            },
            True => match ha {
                False => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, True, tb.toNat(),
                        ta.decrement()),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
                True => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, False, tb.toNat(), ta),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
            },
        },
        True => match borrow {
            False => match ha {
                False => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, True, tb.toNat(),
                        ta.decrement()),
                    BitVec::cons_bit_tail_cong(k, True, tail_law)),
                True => λ tail_law => trans(
                    BitVec::iterate_decrement_twice_cons(k, False, tb.toNat(), ta),
                    BitVec::cons_bit_tail_cong(k, False, tail_law)),
            },
            True => match ha {
                False => λ tail_law => trans(
                    BitVec::cong_iterate_decrement(Succ(k), Nat::twice(tb.toNat()),
                        BitVec::decrement_decrement_cons(k, False, ta)),
                    trans(
                        BitVec::iterate_decrement_twice_cons(k, False, tb.toNat(),
                            ta.decrement()),
                        BitVec::cons_bit_tail_cong(k, False, tail_law))),
                True => λ tail_law => trans(
                    BitVec::cong_iterate_decrement(Succ(k), Nat::twice(tb.toNat()),
                        BitVec::decrement_decrement_cons(k, True, ta)),
                    trans(
                        BitVec::iterate_decrement_twice_cons(k, True, tb.toNat(),
                            ta.decrement()),
                        BitVec::cons_bit_tail_cong(k, True, tail_law))),
            },
        },
    }
}

theorem BitVec::cong_iterate_decrement_count(n: Nat, x: BitVec(n), {a, b: Nat}, p: a = b):
    x.iterate_decrement(a) = x.iterate_decrement(b)
{
    rewrite(p, refl)
}

theorem BitVec::sub_bits_cons(k: Nat, ha, hb, borrow: Bool, ta, tb: BitVec(k),
    tail_law: ta.iterate_decrement(tb.toNat() + Nat::of_bit(BitVec::borrow_next(ha, hb, borrow))) =
        ta.sub_bits(tb, BitVec::borrow_next(ha, hb, borrow))):
    (ta.cons_bit(ha)).iterate_decrement((tb.cons_bit(hb)).toNat() + Nat::of_bit(borrow)) =
    (ta.cons_bit(ha)).sub_bits(tb.cons_bit(hb), borrow)
{
    trans(
        BitVec::cong_iterate_decrement_count(Succ(k), ta.cons_bit(ha),
            BitVec::borrow_right_normalize(hb, borrow, tb.toNat())),
        BitVec::sub_bits_cons_leaf(k, ha, hb, borrow, ta, tb, tail_law))
}

theorem BitVec::iterate_decrement_sub_bits(n: Nat): (a, b: BitVec(n)) → (borrow: Bool) →
    a.iterate_decrement(b.toNat() + Nat::of_bit(borrow)) = a.sub_bits(b, borrow)
{
    match n as λ k => (a, b: BitVec(k)) → (borrow: Bool) →
        a.iterate_decrement(b.toNat() + Nat::of_bit(borrow)) = a.sub_bits(b, borrow) {
        Zero => λ a b borrow => match borrow { False => refl, True => refl },
        Succ(k, ih) => λ a b borrow => trans(
            BitVec::cong_iterate_decrement(Succ(k), b.toNat() + Nat::of_bit(borrow),
                sym(BitVec::cons_head_tail(k, a))),
            BitVec::sub_bits_cons(k, a.head_bit(), b.head_bit(), borrow,
                a.tail_bits(), b.tail_bits(),
                ih(a.tail_bits(), b.tail_bits(),
                    BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow)))),
    }
}

theorem BitVec::sub_bits_spec(n: Nat, a, b: BitVec(n), borrow: Bool):
    a.sub_bits(b, borrow) =
    a.iterate_decrement(b.toNat() + Nat::of_bit(borrow))
{
    sym(BitVec::iterate_decrement_sub_bits(n, a, b, borrow))
}

theorem BitVec::iter_sub_eq_sub(n: Nat, a, b: BitVec(n)):
    a.iter_sub(b) = a.sub(b)
{
    BitVec::iterate_decrement_sub_bits(n, a, b, False)
}

theorem BitVec::iter_neg_eq_neg(n: Nat, a: BitVec(n)): a.iter_neg() = a.neg() {
    BitVec::iter_sub_eq_sub(n, BitVec::zero(), a)
}

theorem BitVec::ripple_sub_eq_sub(n: Nat, a, b: BitVec(n)):
    a.ripple_sub(b) = a.sub(b)
{
    refl
}

theorem BitVec::ripple_neg_eq_neg(n: Nat, a: BitVec(n)): a.ripple_neg() = a.neg() {
    refl
}

// Transport between the iterated and canonical spellings. A closed `iter_add`
// at machine width is up to `2^64` increments, so a proof that wants the count
// works with `iter_add`/`iter_sub` and restates its result in `add`/`sub`
// through these; the ripple direction below is definitional.
theorem BitVec::add_eq_of_iter_add(n: Nat, a, b, r: BitVec(n),
    h: a.iter_add(b) = r): a.add(b) = r
{
    trans(sym(BitVec::iter_add_eq_add(n, a, b)), h)
}

theorem BitVec::iter_add_eq_of_add(n: Nat, a, b, r: BitVec(n),
    h: a.add(b) = r): a.iter_add(b) = r
{
    trans(BitVec::iter_add_eq_add(n, a, b), h)
}

theorem BitVec::sub_eq_of_iter_sub(n: Nat, a, b, r: BitVec(n),
    h: a.iter_sub(b) = r): a.sub(b) = r
{
    trans(sym(BitVec::iter_sub_eq_sub(n, a, b)), h)
}

theorem BitVec::iter_sub_eq_of_sub(n: Nat, a, b, r: BitVec(n),
    h: a.sub(b) = r): a.iter_sub(b) = r
{
    trans(BitVec::iter_sub_eq_sub(n, a, b), h)
}

theorem BitVec::neg_eq_of_iter_neg(n: Nat, a, r: BitVec(n),
    h: a.iter_neg() = r): a.neg() = r
{
    trans(sym(BitVec::iter_neg_eq_neg(n, a)), h)
}

// The ripple transports kept for the generators and proofs that name them.
// Since `add` *is* `ripple_add`, each is now the identity on its hypothesis.
theorem BitVec::add_eq_of_ripple_add(n: Nat, a, b, r: BitVec(n),
    h: a.ripple_add(b) = r): a.add(b) = r
{
    trans(sym(BitVec::ripple_add_eq_add(n, a, b)), h)
}

theorem BitVec::ripple_add_eq_of_add(n: Nat, a, b, r: BitVec(n),
    h: a.add(b) = r): a.ripple_add(b) = r
{
    trans(BitVec::ripple_add_eq_add(n, a, b), h)
}

theorem BitVec::sub_eq_of_ripple_sub(n: Nat, a, b, r: BitVec(n),
    h: a.ripple_sub(b) = r): a.sub(b) = r
{
    trans(sym(BitVec::ripple_sub_eq_sub(n, a, b)), h)
}

theorem BitVec::ripple_sub_eq_of_sub(n: Nat, a, b, r: BitVec(n),
    h: a.sub(b) = r): a.ripple_sub(b) = r
{
    trans(BitVec::ripple_sub_eq_sub(n, a, b), h)
}

theorem BitVec::neg_eq_of_ripple_neg(n: Nat, a, r: BitVec(n),
    h: a.ripple_neg() = r): a.neg() = r
{
    trans(sym(BitVec::ripple_neg_eq_neg(n, a)), h)
}

theorem BitVec::cong_ripple_add(n: Nat, {a, b, c, d: BitVec(n)}, pa: a = b, pc: c = d):
    a.ripple_add(c) = b.ripple_add(d)
{
    rewrite(sym(pa), sym(pc), refl)
}

theorem BitVec::cong_ripple_sub(n: Nat, {a, b, c, d: BitVec(n)}, pa: a = b, pc: c = d):
    a.ripple_sub(c) = b.ripple_sub(d)
{
    rewrite(sym(pa), sym(pc), refl)
}

// The `toNat`-counted laws transfer to the canonical operations across the
// equations. Their statements are the ones they always had.
theorem BitVec::add_comm(n: Nat, a, b: BitVec(n)): a.add(b) = b.add(a) {
    trans(sym(BitVec::iter_add_eq_add(n, a, b)),
        trans(BitVec::iter_add_comm(n, a, b), BitVec::iter_add_eq_add(n, b, a)))
}

theorem BitVec::add_sub_cancel(n: Nat, a, b: BitVec(n)): (a.add(b)).sub(b) = a {
    trans(sym(BitVec::iter_sub_eq_sub(n, a.add(b), b)),
        trans(BitVec::cong_iterate_decrement(n, b.toNat(),
                sym(BitVec::iter_add_eq_add(n, a, b))),
            BitVec::iter_add_sub_cancel(n, a, b)))
}

// The iterated form absorbed a zero second operand definitionally; the ripple
// does not, because it runs its columns whatever the operands are. Customers
// that added a literal zero offset — a byte-offset idiom with the offset zero,
// say — need this instead of `refl`.
theorem BitVec::add_of_toNat_zero(n: Nat, a, b: BitVec(n), zero_count: b.toNat() = 0):
    a.add(b) = a
{
    trans(sym(BitVec::iter_add_eq_add(n, a, b)),
        BitVec::cong_iterate_increment_count(n, a, zero_count))
}

theorem BitVec::ripple_add_comm(n: Nat, a, b: BitVec(n)):
    a.ripple_add(b) = b.ripple_add(a)
{
    BitVec::add_comm(n, a, b)
}

theorem BitVec::ripple_add_sub_cancel(n: Nat, a, b: BitVec(n)):
    (a.ripple_add(b)).ripple_sub(b) = a
{
    BitVec::add_sub_cancel(n, a, b)
}

// ---------------------------------------------------------------------------
// `ofNat` is a section of `toNat` below the width's bound.

// The digit equation `ofNat` and `toNat` are two halves of: the low bit plus
// twice the rest is the number. Two steps on `x`, so that `odd_bit` and
// `Nat::half` take one step each per level.
theorem BitVec::odd_bit_add_twice_half(x: Nat): Nat::of_bit(BitVec::odd_bit(x)) + Nat::twice(Nat::half(x)) = x {
    match x {
        Zero => refl,
        Succ(k) => match k {
            Zero => refl,
            Succ(l) => Nat::cong_succ(Nat::cong_succ(BitVec::odd_bit_add_twice_half(l))),
        },
    }
}

// Round-tripping a natural below `2^n` through the width-`n` vector. The
// bound is necessary and not bookkeeping: `ofNat` truncates, so above it the
// result is the argument's low `n` bits and nothing more.
//
// The recursion is on the WIDTH, matching `ofNat`'s own; the induction
// hypothesis applies at `Nat::half(x)`, whose bound is the argument's halved
// by `Nat::half_lt_of_lt_double`, and the step is then the digit equation
// above.
theorem BitVec::toNat_ofNat(n: Nat): (x: Nat) → x < Nat::pow(2, n) → BitVec::ofNat(x, n := n).toNat() = x {
    match n as λ k => (x: Nat) → x < Nat::pow(2, k) → BitVec::ofNat(x, n := k).toNat() = x {
        Zero => λ x h => sym(Nat::le_antisym(x, 0, h, x.nonneg())),
        Succ(k, ih) => λ x h => {
            let p = Nat::pow(2, k);
            let bound = x.half_lt_of_lt_double(p,
                rewrite(sym(trans(BitVec::pow_two_succ_twice(k), Nat::twice_add_self(p))), h));
            trans(Nat::cong(λ (w: Nat) => Nat::of_bit(BitVec::odd_bit(x)) + Nat::twice(w),
                    ih(Nat::half(x), bound)),
                BitVec::odd_bit_add_twice_half(x))
        },
    }
}

// ---------------------------------------------------------------------------
// `toNat` is a section of `ofNat` on every vector, and bounded by the width.
// The two together are what lets a decoder that read a payload's VALUE be
// undone: the value re-enters the payload (`ofNat_toNat`), and its range test
// is the payload's width (`toNat_lt_pow`).

// The digit equation read backwards, one half at a time: a bit under twice a
// number is that bit, and that number. Two-successor inductions, as
// `odd_bit_add_twice_half` is.
theorem BitVec::odd_bit_twice(m: Nat): BitVec::odd_bit(Nat::twice(m)) = False {
    match m { Zero => refl, Succ(k) => BitVec::odd_bit_twice(k) }
}

theorem BitVec::odd_bit_succ_twice(m: Nat): BitVec::odd_bit(Succ(Nat::twice(m))) = True {
    match m { Zero => refl, Succ(k) => BitVec::odd_bit_succ_twice(k) }
}

theorem BitVec::half_twice(m: Nat): Nat::half(Nat::twice(m)) = m {
    match m { Zero => refl, Succ(k) => Nat::cong_succ(BitVec::half_twice(k)) }
}

theorem BitVec::half_succ_twice(m: Nat): Nat::half(Succ(Nat::twice(m))) = m {
    match m { Zero => refl, Succ(k) => Nat::cong_succ(BitVec::half_succ_twice(k)) }
}

// `Nat::add` recurses on its second argument, so a bit on the left of a stuck
// `twice` needs the two left-unit laws to step.
theorem BitVec::one_add(x: Nat): 1 + x = Succ(x) {
    trans(Nat::add_succ_left(0, x), Nat::cong_succ(Nat::add_left_zero(x)))
}

theorem BitVec::odd_bit_digit(b: Bool, m: Nat): BitVec::odd_bit(Nat::of_bit(b) + Nat::twice(m)) = b {
    match b as λ x => BitVec::odd_bit(Nat::of_bit(x) + Nat::twice(m)) = x {
        False => rewrite(Nat::add_left_zero(Nat::twice(m)), BitVec::odd_bit_twice(m)),
        True => rewrite(BitVec::one_add(Nat::twice(m)), BitVec::odd_bit_succ_twice(m)),
    }
}

theorem BitVec::half_digit(b: Bool, m: Nat): Nat::half(Nat::of_bit(b) + Nat::twice(m)) = m {
    match b as λ x => Nat::half(Nat::of_bit(x) + Nat::twice(m)) = m {
        False => rewrite(Nat::add_left_zero(Nat::twice(m)), BitVec::half_twice(m)),
        True => rewrite(BitVec::one_add(Nat::twice(m)), BitVec::half_succ_twice(m)),
    }
}

// Reading a vector's value and writing it back at the same width is the
// identity — no bound this way, since a vector never exceeds its width. The
// recursion is on the width like `ofNat`'s: the head is the digit's low bit
// and the tail is the induction hypothesis at the digit's half.
theorem BitVec::ofNat_toNat(n: Nat): (x: BitVec(n)) → BitVec::ofNat(x.toNat()) = x {
    match n as λ k => (x: BitVec(k)) → BitVec::ofNat(x.toNat()) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => {
            let h = x.head_bit();
            let m = (x.tail_bits()).toNat();
            trans(
                BitVec::cons_bit_cong(k, BitVec::odd_bit_digit(h, m),
                    trans(j(BitVec::half_digit(h, m),
                            λ y _ => BitVec::ofNat(Nat::half(Nat::of_bit(h) + Nat::twice(m)), n := k)
                                = BitVec::ofNat(y), refl),
                        ih(x.tail_bits())),
                    a := BitVec::odd_bit(Nat::of_bit(h) + Nat::twice(m)), b := h),
                BitVec::cons_head_tail(k, x))
        },
    }
}

// A bit under twice a bounded number stays under twice the bound: the
// successor the bit may add is absorbed by doubling the strict inequality.
theorem BitVec::bit_twice_lt(b: Bool, m, p: Nat, h: m < p): Nat::of_bit(b) + Nat::twice(m) < Nat::twice(p) {
    match b as λ x => Nat::of_bit(x) + Nat::twice(m) < Nat::twice(p) {
        False => rewrite(Nat::add_left_zero(Nat::twice(m)),
            Nat::twice_lt_twice_iff(m, p).mpr(h)),
        True => rewrite(BitVec::one_add(Nat::twice(m)),
            Nat::twice_le_twice_iff(Succ(m), p).mpr(h)),
    }
}

// A vector's value is below `2^n` at width `n`: the range test a decoder
// makes on a reassembled payload is the width bound, for free.
theorem BitVec::toNat_lt_pow(n: Nat): (x: BitVec(n)) → x.toNat() < Nat::pow(2, n) {
    match n as λ k => (x: BitVec(k)) → x.toNat() < Nat::pow(2, k) {
        Zero => λ x => trivial,
        Succ(k, ih) => λ x => rewrite(BitVec::pow_two_succ_twice(k),
            BitVec::bit_twice_lt(x.head_bit(), (x.tail_bits()).toNat(), Nat::pow(2, k),
                ih(x.tail_bits()))),
    }
}

theorem BitVec::zero_toNat(n: Nat): BitVec::zero(n := n).toNat() = 0 {
    match n as λ k => BitVec::zero(n := k).toNat() = 0 {
        Zero => refl,
        Succ(k, ih) => trans(BitVec::zero(n := k).toNat().twice().add_left_zero(),
            j(sym(ih), λ v _ => v.twice() = 0, refl)),
    }
}

// Below the period, counting up from zero is `ofNat`.
theorem BitVec::zero_iterate_increment(n, m: Nat, lt: m < Nat::pow(2, n)):
    BitVec::zero(n := n).iterate_increment(m) = BitVec::ofNat(m, n := n) {
    trans(BitVec::cong_iterate_increment_count(n, BitVec::zero(), sym(BitVec::toNat_ofNat(n, m, lt))),
        BitVec::iterate_increment_toNat(n, BitVec::ofNat(m, n := n)))
}

// A nonzero vector is one past its decrement.
theorem BitVec::toNat_decrement(n: Nat, x: BitVec(n), nonzero: 0 < x.toNat()): Succ(x.decrement().toNat()) = x.toNat() {
    let y = x.decrement();
    let k = y.toNat();
    let back: (BitVec::zero(n := n).iterate_increment(Succ(k)) = x) =
        trans(BitVec::cong_increment(n, BitVec::iterate_increment_toNat(n, y)), BitVec::increment_decrement(n, x));
    match Succ(k).eq_dec(Nat::pow(2, n)) {
        Inl(full) => {
            let wrapped: (x = BitVec::zero(n := n)) = trans(sym(back),
                trans(BitVec::cong_iterate_increment_count(n, BitVec::zero(), full), BitVec::iterate_increment_period(n, BitVec::zero())));
            let none: (x.toNat() = 0) = trans(j(wrapped, λ z _ => x.toNat() = z.toNat(), refl), BitVec::zero_toNat(n));
            let bad: False = j(none, λ t _ => 0 < t, nonzero);
            false_elim(bad)
        },
        Inr(short) => {
            let fits: (Succ(k) < Nat::pow(2, n)) = Succ(k).lt_of_le_of_ne(Nat::pow(2, n), BitVec::toNat_lt_pow(n, y), short);
            let counted = BitVec::zero_iterate_increment(n, Succ(k), fits);
            sym(trans(j(sym(back), λ z _ => x.toNat() = z.toNat(), refl),
                trans(j(counted, λ z _ => BitVec::zero(n := n).iterate_increment(Succ(k)).toNat() = z.toNat(), refl),
                    BitVec::toNat_ofNat(n, Succ(k), fits))))
        },
    }
}

// Zeros above a vector add nothing to its value: zero extension keeps it.
theorem BitVec::concat_zero_toNat(n: Nat): (m: Nat) → (lo: BitVec(n)) → (lo.concat(BitVec::zero(n := m))).toNat() = lo.toNat() {
    match n as λ k => (m: Nat) → (lo: BitVec(k)) → (lo.concat(BitVec::zero(n := m))).toNat() = lo.toNat() {
        Zero => λ m lo => BitVec::zero_toNat(m),
        Succ(k, ih) => λ m lo => j(sym(ih(m, lo.tail_bits())),
            λ v _ => Nat::of_bit(lo.head_bit()) + v.twice() = Nat::of_bit(lo.head_bit()) + (lo.tail_bits()).toNat().twice(), refl),
    }
}

// Sign extension of a vector whose sign bit is clear is zero extension, so
// it keeps the value (a small positive displacement reads as itself).
theorem BitVec::sign_extend_clear_toNat(n, extra: Nat, x: BitVec(Succ(n)), clear: x.sign_bit() = False):
    (x.sign_extend(extra)).toNat() = x.toNat() {
    j(sym(clear), λ b _ => (x.concat(BitVec::repeat_bit(b, n := extra))).toNat() = x.toNat(),
        BitVec::concat_zero_toNat(Succ(n), extra, x))
}

theorem BitVec::ofNat_zero(n: Nat): BitVec::ofNat(0, n := n) = BitVec::zero() {
    match n as λ k => BitVec::ofNat(0, n := k) = BitVec::zero() {
        Zero => refl,
        Succ(k, ih) => BitVec::cons_bit_cong(k, refl, ih, a := False, b := False),
    }
}

// A value below `2^n` has nothing above its low `n` bits. With n = 47 this is
// how a Nat bound on an address becomes the machine's low-canonical premise.
theorem BitVec::drop_low_zero_of_lt(n: Nat): (m: Nat) → (x: BitVec(m + n)) →
        x.toNat() < Nat::pow(2, n) → x.drop_low(n, m) = BitVec::zero() {
    match n as λ k => (m: Nat) → (x: BitVec(m + k)) → x.toNat() < Nat::pow(2, k) →
            x.drop_low(k, m) = BitVec::zero() {
        Zero => λ m x h => {
            let none = Nat::le_antisym(x.toNat(), 0, h, (x.toNat()).nonneg());
            trans(sym(BitVec::ofNat_toNat(m, x)),
                trans(rewrite(none, refl),
                    BitVec::ofNat_zero(m)))
        },
        Succ(k, ih) => λ m x h => {
            let tail = (x.tail_bits()).toNat();
            let p = Nat::pow(2, k);
            let under = rewrite(BitVec::pow_two_succ_twice(k), in := h);
            let twice = Succ(Nat::twice(tail)).le_trans(Succ(Nat::of_bit(x.head_bit()) + Nat::twice(tail)), Nat::twice(p),
                Nat::le_add_r(Nat::of_bit(x.head_bit()), Nat::twice(tail)), under);
            ih(m, x.tail_bits(), Nat::twice_lt_twice_iff(tail, p).mp(twice))
        },
    }
}

// Zero high columns preserve an incoming borrow, so unsigned comparison can
// use a wider physical word without changing the narrow logical result.
theorem BitVec::borrow_zero_columns(n: Nat): (borrow: Bool) →
    BitVec::zero(n := n).borrow_bits(BitVec::zero(), borrow) = borrow {
    match n as λ k => (borrow: Bool) → BitVec::zero(n := k).borrow_bits(BitVec::zero(), borrow) = borrow {
        Zero => λ borrow => refl,
        Succ(_, ih) => λ borrow => match borrow { False => ih(False), True => ih(True) },
    }
}

theorem BitVec::borrow_zero_extend(n: Nat): (extra: Nat) → (a, b: BitVec(n)) → (borrow: Bool) →
    (a.zero_extend(extra)).borrow_bits(b.zero_extend(extra), borrow) =
        a.borrow_bits(b, borrow) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) → (borrow: Bool) →
        (a.zero_extend(extra)).borrow_bits(b.zero_extend(extra), borrow) =
            a.borrow_bits(b, borrow) {
        Zero => λ extra a b borrow => BitVec::borrow_zero_columns(extra, borrow),
        Succ(k, ih) => λ extra a b borrow =>
            match BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow) as λ next =>
                BitVec::borrow_bits_next((a.tail_bits()).zero_extend(extra), (b.tail_bits()).zero_extend(extra), next, λ x y c => x.borrow_bits(y, c)) =
                BitVec::borrow_bits_next(a.tail_bits(), b.tail_bits(), next, λ x y c => x.borrow_bits(y, c)) {
                False => ih(extra, a.tail_bits(), b.tail_bits(), False),
                True => ih(extra, a.tail_bits(), b.tail_bits(), True),
            },
    }
}

theorem BitVec::unsigned_lt_zero_extend(n, extra: Nat, a, b: BitVec(n)):
    (a.zero_extend(extra)).unsigned_lt_bit(b.zero_extend(extra)) =
        a.unsigned_lt_bit(b) {
    BitVec::borrow_zero_extend(n, extra, a, b, False)
}

// Zero extension is injective (`truncate_zero_extend`), so a narrow equality
// may be compared in the wide register.
theorem BitVec::eq_bit_zero_extend(n, extra: Nat, a, b: BitVec(n)):
        (a.zero_extend(extra)).eq_bit(b.zero_extend(extra)) = a.eq_bit(b) {
    match a.eq_bit(b) as λ c => (a.eq_bit(b) = c) → (a.zero_extend(extra)).eq_bit(b.zero_extend(extra)) = c {
        True => λ same => BitVec::eq_bit_of_eq(extra + n, a.zero_extend(extra), b.zero_extend(extra),
            rewrite(sym(BitVec::eq_of_eq_bit(n, a, b, same)), refl)),
        False => λ differ => match (a.zero_extend(extra)).eq_bit(b.zero_extend(extra)) as λ d =>
                ((a.zero_extend(extra)).eq_bit(b.zero_extend(extra)) = d) → d = False {
            False => λ _ => refl,
            True => λ wide => {
                let narrow: (a = b) = trans(sym(BitVec::truncate_zero_extend(n, extra, a)),
                    trans(rewrite(sym(BitVec::eq_of_eq_bit(extra + n, a.zero_extend(extra), b.zero_extend(extra), wide)),
                        refl), BitVec::truncate_zero_extend(n, extra, b)));
                absurd(trans(sym(differ), BitVec::eq_bit_of_eq(n, a, b, narrow)))
            },
        }(refl),
    }(refl)
}

theorem BitVec::band_zero_columns(n: Nat): BitVec::zero(n := n).band(BitVec::zero()) = BitVec::zero() {
    match n as λ k => BitVec::zero(n := k).band(BitVec::zero()) = BitVec::zero() {
        Zero => refl,
        Succ(k, ih) => BitVec::cons_bit_cong(k, refl, ih, a := False, b := False),
    }
}

theorem BitVec::band_zero_extend(n: Nat): (extra: Nat) → (a, b: BitVec(n)) →
    (a.zero_extend(extra)).band(b.zero_extend(extra)) =
        (a.band(b)).zero_extend(extra) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) →
        (a.zero_extend(extra)).band(b.zero_extend(extra)) =
            (a.band(b)).zero_extend(extra) {
        Zero => λ extra a b => BitVec::band_zero_columns(extra),
        Succ(k, ih) => λ extra a b => BitVec::cons_bit_cong(extra + k, refl,
            ih(extra, a.tail_bits(), b.tail_bits()),
            a := (a.band(b)).head_bit(), b := (a.band(b)).head_bit()),
    }
}

theorem BitVec::bor_zero_columns(n: Nat): BitVec::zero(n := n).bor(BitVec::zero()) = BitVec::zero() {
    match n as λ k => BitVec::zero(n := k).bor(BitVec::zero()) = BitVec::zero() {
        Zero => refl,
        Succ(k, ih) => BitVec::cons_bit_cong(k, refl, ih, a := False, b := False),
    }
}

theorem BitVec::bor_zero_extend(n: Nat): (extra: Nat) → (a, b: BitVec(n)) →
    (a.zero_extend(extra)).bor(b.zero_extend(extra)) =
        (a.bor(b)).zero_extend(extra) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) →
        (a.zero_extend(extra)).bor(b.zero_extend(extra)) =
            (a.bor(b)).zero_extend(extra) {
        Zero => λ extra a b => BitVec::bor_zero_columns(extra),
        Succ(k, ih) => λ extra a b => BitVec::cons_bit_cong(extra + k, refl,
            ih(extra, a.tail_bits(), b.tail_bits()),
            a := (a.bor(b)).head_bit(), b := (a.bor(b)).head_bit()),
    }
}

theorem BitVec::bxor_zero_columns(n: Nat): BitVec::zero(n := n).bxor(BitVec::zero()) = BitVec::zero() {
    match n as λ k => BitVec::zero(n := k).bxor(BitVec::zero()) = BitVec::zero() {
        Zero => refl,
        Succ(k, ih) => BitVec::cons_bit_cong(k, refl, ih, a := False, b := False),
    }
}

theorem BitVec::bxor_zero_extend(n: Nat): (extra: Nat) → (a, b: BitVec(n)) →
    (a.zero_extend(extra)).bxor(b.zero_extend(extra)) =
        (a.bxor(b)).zero_extend(extra) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) →
        (a.zero_extend(extra)).bxor(b.zero_extend(extra)) =
            (a.bxor(b)).zero_extend(extra) {
        Zero => λ extra a b => BitVec::bxor_zero_columns(extra),
        Succ(k, ih) => λ extra a b => BitVec::cons_bit_cong(extra + k, refl,
            ih(extra, a.tail_bits(), b.tail_bits()),
            a := (a.bxor(b)).head_bit(), b := (a.bxor(b)).head_bit()),
    }
}

// Narrow sums and differences on a wider word: the word's result, masked to
// the narrow width, is the narrow result zero-extended. The carry or borrow
// out of the low columns lands in the high ones, which the mask clears.
theorem BitVec::band_zero_r(n: Nat): (x: BitVec(n)) → x.band(BitVec::zero()) = BitVec::zero() {
    match n as λ k => (x: BitVec(k)) → x.band(BitVec::zero()) = BitVec::zero() {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => BitVec::cons_bit_cong(k, match x.head_bit() as λ h => (h && False) = False { False => refl, True => refl },
            ih(x.tail_bits())),
    }
}

theorem BitVec::add_bits_zero_extend_mask(n: Nat): (extra: Nat) → (a, b: BitVec(n)) → (carry: Bool) →
    ((a.zero_extend(extra)).add_bits(b.zero_extend(extra), carry)).band(BitVec::all_ones(n := n).zero_extend(extra)) =
        (a.add_bits(b, carry)).zero_extend(extra) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) → (carry: Bool) →
        ((a.zero_extend(extra)).add_bits(b.zero_extend(extra), carry)).band(BitVec::all_ones(n := k).zero_extend(extra)) =
            (a.add_bits(b, carry)).zero_extend(extra) {
        Zero => λ extra a b carry => BitVec::band_zero_r(extra, (a.zero_extend(extra)).add_bits(b.zero_extend(extra), carry)),
        Succ(k, ih) => λ extra a b carry => BitVec::cons_bit_cong(extra + k,
            Bool::and_true_r(BitVec::sum_bit(a.head_bit(), b.head_bit(), carry)),
            match BitVec::carry_majority(a.head_bit(), b.head_bit(), carry) as λ next =>
                (BitVec::add_bits_next((a.tail_bits()).zero_extend(extra), (b.tail_bits()).zero_extend(extra), next,
                    λ x y c => x.add_bits(y, c))).band(BitVec::all_ones(n := k).zero_extend(extra)) =
                (BitVec::add_bits_next(a.tail_bits(), b.tail_bits(), next, λ x y c => x.add_bits(y, c))).zero_extend(extra) {
                False => ih(extra, a.tail_bits(), b.tail_bits(), False),
                True => ih(extra, a.tail_bits(), b.tail_bits(), True),
            }),
    }
}

theorem BitVec::sub_bits_zero_extend_mask(n: Nat): (extra: Nat) → (a, b: BitVec(n)) → (borrow: Bool) →
    ((a.zero_extend(extra)).sub_bits(b.zero_extend(extra), borrow)).band(BitVec::all_ones(n := n).zero_extend(extra)) =
        (a.sub_bits(b, borrow)).zero_extend(extra) {
    match n as λ k => (extra: Nat) → (a, b: BitVec(k)) → (borrow: Bool) →
        ((a.zero_extend(extra)).sub_bits(b.zero_extend(extra), borrow)).band(BitVec::all_ones(n := k).zero_extend(extra)) =
            (a.sub_bits(b, borrow)).zero_extend(extra) {
        Zero => λ extra a b borrow => BitVec::band_zero_r(extra, (a.zero_extend(extra)).sub_bits(b.zero_extend(extra), borrow)),
        Succ(k, ih) => λ extra a b borrow => BitVec::cons_bit_cong(extra + k,
            Bool::and_true_r(BitVec::sum_bit(a.head_bit(), b.head_bit(), borrow)),
            match BitVec::borrow_next(a.head_bit(), b.head_bit(), borrow) as λ next =>
                (BitVec::sub_bits_next((a.tail_bits()).zero_extend(extra), (b.tail_bits()).zero_extend(extra), next,
                    λ x y c => x.sub_bits(y, c))).band(BitVec::all_ones(n := k).zero_extend(extra)) =
                (BitVec::sub_bits_next(a.tail_bits(), b.tail_bits(), next, λ x y c => x.sub_bits(y, c))).zero_extend(extra) {
                False => ih(extra, a.tail_bits(), b.tail_bits(), False),
                True => ih(extra, a.tail_bits(), b.tail_bits(), True),
            }),
    }
}

theorem BitVec::add_zero_extend_mask(n, extra: Nat, a, b: BitVec(n)):
    ((a.zero_extend(extra)).add(b.zero_extend(extra))).band(BitVec::all_ones(n := n).zero_extend(extra)) = (a.add(b)).zero_extend(extra) {
    BitVec::add_bits_zero_extend_mask(n, extra, a, b, False)
}
theorem BitVec::sub_zero_extend_mask(n, extra: Nat, a, b: BitVec(n)):
    ((a.zero_extend(extra)).sub(b.zero_extend(extra))).band(BitVec::all_ones(n := n).zero_extend(extra)) = (a.sub(b)).zero_extend(extra) {
    BitVec::sub_bits_zero_extend_mask(n, extra, a, b, False)
}

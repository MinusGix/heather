// Mathematical order structure, separate from executable comparison.
//
// Every class is indexed by its relation: a carrier may support several
// orders, and none is nominated as "the" order. `LinearOrder` supplies
// propositional totality only. It has no decider and does not make `Cmp` a
// parent; algorithms that branch on an order belong to the separate
// decidable-comparison layer.

import logic;
import nat;
import pair;
import relation;
import relation_props;
import int;

class Preorder<A>(R: A → A → Type)
    extends Reflexive<A>(R), Transitive<A>(R)
{}

class PartialOrder<A>(R: A → A → Type)
    extends Preorder<A>(R), Antisymmetric<A>(R)
{}

class LinearOrder<A>(R: A → A → Type)
    extends PartialOrder<A>(R), Total<A>(R)
{}

// A total preorder: every pair comparable, ties allowed. What a sort key's
// order is (`List::Lex` over a total preorder is one, and a stable sort
// orders by one), and `LinearOrder` without antisymmetry.
class TotalPreorder<A>(R: A → A → Type)
    extends Preorder<A>(R), Total<A>(R)
{}

// The existing carrier-owned kits fill the complete child dictionary once.
// Canonical parent instances are synthesized from it, so generic preorder and
// partial-order consumers do not need duplicate registrations.
instance LinearOrder<Nat>(Nat::Le) {
    rel_refl := Nat::le_refl,
    rel_trans := Nat::le_trans,
    rel_antisym := Nat::le_antisym,
    rel_total := Nat::le_total,
}

instance LinearOrder<Int>(Int::Le) {
    rel_refl := Int::le_refl,
    rel_trans := Int::le_trans,
    rel_antisym := Int::le_antisym,
    rel_total := Int::le_total,
}

instance DecidableRel<Nat>(Nat::Le) { rel_dec := Nat::le_dec }
instance DecidableRel<Int>(Int::Le) { rel_dec := Int::le_dec }

// The strict orders' transitivity and the two mixed pairs, so `calc` chains
// `<=` and `<` steps at both carriers. `Nat`'s `n < m` is `Succ(n) <= m`,
// which is why its pairs are `<=` transitivity once the left side is shifted.
instance Transitive<Nat>(Nat::Lt) {
    rel_trans := Nat::lt_trans,
}

instance Trans<Nat>(Nat::Lt, Nat::Le, Nat::Lt) {
    rel_chain := λ x y z hxy hyz => Succ(x).le_trans(y, z, hxy, hyz),
}

instance Trans<Nat>(Nat::Le, Nat::Lt, Nat::Lt) {
    rel_chain := λ x y z hxy hyz => Succ(x).le_trans(Succ(y), z, x.le_succ_succ(y, hxy), hyz),
}

instance Transitive<Int>(Int::Lt) {
    rel_trans := Int::lt_trans,
}

instance Trans<Int>(Int::Lt, Int::Le, Int::Lt) {
    rel_chain := Int::lt_of_lt_of_le,
}

instance Trans<Int>(Int::Le, Int::Lt, Int::Lt) {
    rel_chain := Int::lt_of_le_of_lt,
}

// Identity, the setoid both carriers are ordered over (`RelId`), chains with
// either order by transport. A strict order's class holds these pairs
// (`StrictOrder`'s `same_lt` and its siblings, `ordered_field`), so a generic
// `calc` mixes `≈` with `<` and `≤`; at `Nat` and `Int` they are filled from
// here.
instance Trans<Nat>(RelId<Nat>, Nat::Lt, Nat::Lt) { rel_chain := λ x y z h1 h2 => subst(sym(h1), h2) }
instance Trans<Nat>(Nat::Lt, RelId<Nat>, Nat::Lt) { rel_chain := λ x y z h1 h2 => subst(h2, h1) }
instance Trans<Nat>(RelId<Nat>, Nat::Le, Nat::Le) { rel_chain := λ x y z h1 h2 => subst(sym(h1), h2) }
instance Trans<Nat>(Nat::Le, RelId<Nat>, Nat::Le) { rel_chain := λ x y z h1 h2 => subst(h2, h1) }
instance Trans<Int>(RelId<Int>, Int::Lt, Int::Lt) { rel_chain := λ x y z h1 h2 => subst(sym(h1), h2) }
instance Trans<Int>(Int::Lt, RelId<Int>, Int::Lt) { rel_chain := λ x y z h1 h2 => subst(h2, h1) }
instance Trans<Int>(RelId<Int>, Int::Le, Int::Le) { rel_chain := λ x y z h1 h2 => subst(sym(h1), h2) }
instance Trans<Int>(Int::Le, RelId<Int>, Int::Le) { rel_chain := λ x y z h1 h2 => subst(h2, h1) }

// Componentwise products preserve preorders and partial orders. They do not
// preserve linearity: `(a1,b2)` and `(a2,b1)` may be incomparable. Keeping the
// constructor at the precise layer is the first forcing case for a hierarchy
// with a genuinely useful weaker intermediate structure.
fn ProductOrder<A, B>(RA: A → A → Type, RB: B → B → Type)
    → Pair<A, B> → Pair<A, B> → Type
{
    λ x y => RA(x.fst, y.fst) ∧ RB(x.snd, y.snd)
}

fn product_preorder<A: Preorder(RA), B: Preorder(RB)>(
    RA: A → A → Type, RB: B → B → Type)
    → Preorder<Pair<A, B>>(ProductOrder(RA, RB))
{
    Preorder(
        λ x => And(A.rel_refl(x.fst), B.rel_refl(x.snd)),
        λ x y z hxy hyz => And(
            A.rel_trans(x.fst, y.fst, z.fst, hxy.left, hyz.left),
            B.rel_trans(x.snd, y.snd, z.snd, hxy.right, hyz.right)))
}

fn product_partial_order<A: PartialOrder(RA), B: PartialOrder(RB)>(
    RA: A → A → Type, RB: B → B → Type)
    → PartialOrder<Pair<A, B>>(ProductOrder(RA, RB))
{
    PartialOrder(
        λ x => And(A.rel_refl(x.fst), B.rel_refl(x.snd)),
        λ x y z hxy hyz => And(
            A.rel_trans(x.fst, y.fst, z.fst, hxy.left, hyz.left),
            B.rel_trans(x.snd, y.snd, z.snd, hxy.right, hyz.right)),
        λ x y hxy hyx => Pair::ext(x, y,
            A.rel_antisym(x.fst, y.fst, hxy.left, hyx.left),
            B.rel_antisym(x.snd, y.snd, hxy.right, hyx.right)))
}

// Pullback always preserves a preorder. Antisymmetry additionally needs the
// map to be injective; making that hypothesis visible prevents a convenient
// relation constructor from silently claiming more structure than it has.
fn pullback_preorder<A, B: Preorder(R)>(f: A → B, R: B → B → Type)
    → Preorder<A>(Pullback(f, R))
{
    Preorder(
        λ x => B.rel_refl(f(x)),
        λ x y z hxy hyz => B.rel_trans(f(x), f(y), f(z), hxy, hyz))
}

fn pullback_partial_order<A, B: PartialOrder(R)>(f: A → B,
    R: B → B → Type, injective: Injective(f))
    → PartialOrder<A>(Pullback(f, R))
{
    PartialOrder(
        λ x => B.rel_refl(f(x)),
        λ x y z hxy hyz => B.rel_trans(f(x), f(y), f(z), hxy, hyz),
        λ x y hxy hyx => injective(x, y,
            B.rel_antisym(f(x), f(y), hxy, hyx)))
}

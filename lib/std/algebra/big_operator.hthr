// Finite sums and products over a monoid modulo its relation
// (issues/finite-sums-and-products.md; docs/library/analysis-foundations-design.md §4).
//
// One fold, the range sum `MonoidRel::range(op, n, f)` = `f(0) ∙ … ∙ f(n-1)`,
// by recursion on `n` and built at the end, as `Series::sum` is. It is a sum
// at `+` and a product at `*`: a semiring's product is its `multiplicative`
// monoid, so every law below serves `∑` and `∏` alike. Every other domain is
// a range sum: a list through `List::range` (`range_fold`), a rectangle as
// a range of ranges, the antidiagonal `i + j = n` as `antidiag`, a triangle
// as a range of antidiagonals. Each law about a domain is then a reindexing
// lemma about range sums.
//
// The layers, each with the laws that need no more:
//
// - `MonoidRel(≈, ∙)`: congruence under termwise `≈` below the bound, the
//   split `m + n`, peeling the first term, a sum of units, a sum with one
//   non-unit term, and the list bridge.
// - `+ Commutative`: termwise products split, rectangle Fubini
//   (`range_swap`), permutation invariance along a bijection given with its
//   inverse (`range_perm`, through Fubini and the Kronecker delta `at`),
//   reversal, and the triangle-to-antidiagonal exchange.
// - `Semiring(≈, +, *)`: a factor out of a sum on either side, two sums
//   multiplied out to a rectangle, and the Cauchy-product triangle.
// - `LocatedAddGroup(≈, <, ≤, +)`: monotonicity, nonnegativity, and the
//   triangle inequality as a bound stated rather than computed (`AbsLe`).
//   `≤` is added through cotransitivity, which an `OrderedAddGroup` lacks.
//
// Spelling. `∑ k < n, e` and `∏ k < n, e` are this fold at `+` and `*`
// (the parser's big-operator production): a sum is the call
// `MonoidRel::range(+, n, λ (k: Nat) => e)`, its carrier read off the body,
// so the laws below apply to it as written. The sections over an arbitrary
// `op` spell the call; the ones over `+` write `∑`.

import logic;
import nat;
import int;
import omega;
import list;
import relation;
import relation_props;
import order;
import algebra_rel;
import semiring;
import ordered_field;
import mono_laws;

section<A: MonoidRel(≈, op)>(op as ∙: A → A → A) {

fn MonoidRel::range(n: Nat, f: Nat → A) → A {
    match n { Zero => A.unit, Succ(m) => MonoidRel::range(op, m, f) ∙ f(m) }
}

theorem MonoidRel::range_one(f: Nat → A): MonoidRel::range(op, 1, f) ≈ f(0) { A.unit_l(f(0)) }

theorem MonoidRel::range_cong(n: Nat, f, g: Nat → A):
    ((k: Nat) → k < n → f(k) ≈ g(k)) → MonoidRel::range(op, n, f) ≈ MonoidRel::range(op, n, g)
{
    match n {
        Zero => λ h => A.rel_refl(A.unit),
        Succ(m) => λ h => calc {
            MonoidRel::range(op, m, f) ∙ f(m)
                ≈ MonoidRel::range(op, m, g) ∙ f(m)
                    := rel_cong(MonoidRel::range_cong(op, m, f, g, λ k hk => h(k, omega(hk)))),
                ≈ MonoidRel::range(op, m, g) ∙ g(m) := rel_cong(h(m, m.lt_succ_self())),
        },
    }
}

// A sum respects its summand pointwise along `=` as well: a theorem about
// `range`, by induction, since there is no function extensionality.
theorem MonoidRel::range_ext(n: Nat, f, g: Nat → A, h: (k: Nat) → f(k) = g(k)): MonoidRel::range(op, n, f) = MonoidRel::range(op, n, g) {
    match n {
        Zero => refl,
        Succ(m) => simp_only(MonoidRel::range_ext(op, m, f, g, h), h(m)),
    }
}

theorem MonoidRel::range_eq(n, n2: Nat, f: Nat → A, e: n = n2):
    MonoidRel::range(op, n, f) ≈ MonoidRel::range(op, n2, f)
{
    j(e, λ w _ => MonoidRel::range(op, n, f) ≈ MonoidRel::range(op, w, f), A.rel_refl(MonoidRel::range(op, n, f)))
}

theorem MonoidRel::range_unit(n: Nat, f: Nat → A):
    ((k: Nat) → k < n → f(k) ≈ A.unit) → MonoidRel::range(op, n, f) ≈ A.unit
{
    match n {
        Zero => λ h => A.rel_refl(A.unit),
        Succ(m) => λ h => calc {
            MonoidRel::range(op, m, f) ∙ f(m)
                ≈ A.unit ∙ f(m) := rel_cong(MonoidRel::range_unit(op, m, f, λ k hk => h(k, omega(hk)))),
                ≈ A.unit ∙ A.unit := rel_cong(h(m, m.lt_succ_self())),
                ≈ A.unit := A.unit_l(A.unit),
        },
    }
}

theorem MonoidRel::range_add(m, n: Nat, f: Nat → A):
    MonoidRel::range(op, m + n, f) ≈ MonoidRel::range(op, m, f) ∙ MonoidRel::range(op, n, λ k => f(m + k))
{
    match n {
        Zero => A.rel_sym(MonoidRel::range(op, m, f) ∙ A.unit, MonoidRel::range(op, m, f), A.unit_r(MonoidRel::range(op, m, f))),
        Succ(p) => calc {
            MonoidRel::range(op, m + p, f) ∙ f(m + p)
                ≈ (MonoidRel::range(op, m, f) ∙ MonoidRel::range(op, p, λ k => f(m + k))) ∙ f(m + p)
                    := rel_cong(MonoidRel::range_add(op, m, p, f)),
                ≈ MonoidRel::range(op, m, f) ∙ (MonoidRel::range(op, p, λ k => f(m + k)) ∙ f(m + p))
                    := A.assoc(MonoidRel::range(op, m, f), MonoidRel::range(op, p, λ k => f(m + k)), f(m + p)),
        },
    }
}

theorem MonoidRel::range_succ_l(n: Nat, f: Nat → A):
    MonoidRel::range(op, n + 1, f) ≈ f(0) ∙ MonoidRel::range(op, n, λ k => f(k + 1))
{
    match n {
        Zero => calc {
            A.unit ∙ f(0)
                ≈ f(0) := A.unit_l(f(0)),
                ≈ f(0) ∙ A.unit := A.rel_sym(f(0) ∙ A.unit, f(0), A.unit_r(f(0))),
        },
        Succ(p) => calc {
            MonoidRel::range(op, p + 1, f) ∙ f(p + 1)
                ≈ (f(0) ∙ MonoidRel::range(op, p, λ k => f(k + 1))) ∙ f(p + 1)
                    := rel_cong(MonoidRel::range_succ_l(op, p, f)),
                ≈ f(0) ∙ (MonoidRel::range(op, p, λ k => f(k + 1)) ∙ f(p + 1))
                    := A.assoc(f(0), MonoidRel::range(op, p, λ k => f(k + 1)), f(p + 1)),
        },
    }
}

// The range sum is the fold of the list of its indices.
theorem MonoidRel::range_fold(n: Nat, f: Nat → A):
    MonoidRel::range(op, n, f) ≈ MonoidRel::fold(op, List::range(n).map(f))
{
    match n {
        Zero => A.rel_refl(A.unit),
        Succ(m) => calc {
            MonoidRel::range(op, m, f) ∙ f(m)
                ≈ MonoidRel::fold(op, List::range(m).map(f)) ∙ f(m) := rel_cong(MonoidRel::range_fold(op, m, f)),
                ≈ MonoidRel::fold(op, List::range(m).map(f)) ∙ (f(m) ∙ A.unit) := rel_cong(A.rel_sym(f(m) ∙ A.unit, f(m), A.unit_r(f(m)))),
                ≈ MonoidRel::fold(op, List::range(m).map(f) ++ [f(m)])
                    := A.rel_sym(MonoidRel::fold(op, List::range(m).map(f) ++ [f(m)]),
                        MonoidRel::fold(op, List::range(m).map(f)) ∙ (f(m) ∙ A.unit),
                        MonoidRel::fold_append(op, List::range(m).map(f), [f(m)])),
                ≈ MonoidRel::fold(op, (List::range(m) ++ [m]).map(f))
                    := j(sym(List::range(m).map_append([m], f)),
                        λ w _ => MonoidRel::fold(op, List::range(m).map(f) ++ [f(m)]) ≈ MonoidRel::fold(op, w),
                        A.rel_refl(MonoidRel::fold(op, List::range(m).map(f) ++ [f(m)]))),
        },
    }
}

// A sum whose terms are units except at one index is that term.
theorem MonoidRel::range_single(n: Nat, f: Nat → A, p: Nat):
    p < n → ((k: Nat) → k < n → k ≠ p → f(k) ≈ A.unit) → MonoidRel::range(op, n, f) ≈ f(p)
{
    match n {
        Zero => λ hp h => false_elim(omega(hp)),
        Succ(m) => λ hp h => match Nat::eq_dec(p, m) {
            Inl(e) => calc {
                MonoidRel::range(op, m, f) ∙ f(m)
                    ≈ A.unit ∙ f(m) := rel_cong(MonoidRel::range_unit(op, m, f,
                        λ k hk => h(k, omega(hk), λ kp => omega(hk, kp, e)))),
                    ≈ f(m) := A.unit_l(f(m)),
                    ≈ f(p) := j(sym(e), λ w _ => f(m) ≈ f(w), A.rel_refl(f(m))),
            },
            Inr(ne) => calc {
                MonoidRel::range(op, m, f) ∙ f(m)
                    ≈ f(p) ∙ f(m) := rel_cong(MonoidRel::range_single(op, m, f, p, omega(hp, ne),
                        λ k hk kp => h(k, omega(hk), kp))),
                    ≈ f(p) ∙ A.unit := rel_cong(h(m, m.lt_succ_self(), λ mp => ne(sym(mp)))),
                    ≈ f(p) := A.unit_r(f(p)),
            },
        },
    }
}

// The antidiagonal `i + j = n`, as the range over its first coordinate.
fn MonoidRel::antidiag(n: Nat, f: Nat → Nat → A) → A { MonoidRel::range(op, n + 1, λ i => f(i, n - i)) }

// `x` at index `j` when reading index `i`, the unit elsewhere: the
// Kronecker delta of a monoid.
fn MonoidRel::at(i, k: Nat, x: A) → A { or_pick(Nat::eq_dec(i, k), A.unit, x) }

theorem MonoidRel::at_same(i: Nat, x: A): MonoidRel::at(op, i, i, x) ≈ x {
    j(sym(or_pick_dec(Nat::eq_dec(i, i), A.unit, x, refl)), λ w _ => w ≈ x, A.rel_refl(x))
}

theorem MonoidRel::at_other(i, k: Nat, x: A, ne: i ≠ k): MonoidRel::at(op, i, k, x) ≈ A.unit {
    j(sym(or_pick_dec_not(Nat::eq_dec(i, k), A.unit, x, ne)), λ w _ => w ≈ A.unit, A.rel_refl(A.unit))
}

}

// The sum respects its terms pointwise: the evidence a relation `rewrite`
// crosses the binder of `∑`/`∏` by (docs/tactics/equation-rewrite-design.md §10).
// Outside the section, every parameter in braces: an evidence rule is applied
// by search, which fills each one from the goal, the dictionary among them.
// `range_cong`'s bound `k < n` goes unused, as the rewrite has no use for it.
evidence theorem MonoidRel::range_pointwise<A>({R: A → A → Type}, {op: A → A → A}, {d: MonoidRel<A>(R, op)},
    {n: Nat}): PreservesRelation(Pointwise<Nat, A>(R), R, λ f => MonoidRel::range(op, n, f))
{
    λ f g h => MonoidRel::range_cong(op, n, f, g, λ k _ => h(k))
}

// Along `=` as well, for a sum under an equation: `range_ext`.
evidence theorem MonoidRel::range_pointwise_eq<A>({R: A → A → Type}, {op: A → A → A}, {d: MonoidRel<A>(R, op)},
    {n: Nat}): PreservesRelation(Pointwise<Nat, A>(RelId<A>), RelId<A>, λ f => MonoidRel::range(op, n, f))
{
    λ f g h => MonoidRel::range_ext(op, n, f, g, h)
}

// The antidiagonal's two binders, crossed at once.
evidence theorem MonoidRel::antidiag_pointwise<A>({R: A → A → Type}, {op: A → A → A}, {d: MonoidRel<A>(R, op)},
    {n: Nat}): PreservesRelation(Pointwise<Nat, Nat → A>(Pointwise<Nat, A>(R)), R, λ f => MonoidRel::antidiag(op, n, f))
{
    λ f g h => MonoidRel::range_cong(op, Succ(n), λ i => f(i, n - i), λ i => g(i, n - i), λ i _ => h(i, n - i))
}

section<A: MonoidRel(same, op) + Commutative(same, op)>(same as ≈: A → A → Type, op as ∙: A → A → A) {

theorem CommMonoidRel::range_op(n: Nat, f, g: Nat → A):
    MonoidRel::range(op, n, λ k => f(k) ∙ g(k)) ≈ MonoidRel::range(op, n, f) ∙ MonoidRel::range(op, n, g)
{
    match n {
        Zero => A.rel_sym(A.unit ∙ A.unit, A.unit, A.unit_l(A.unit)),
        Succ(m) => calc {
            MonoidRel::range(op, m, λ k => f(k) ∙ g(k)) ∙ (f(m) ∙ g(m))
                ≈ (MonoidRel::range(op, m, f) ∙ MonoidRel::range(op, m, g)) ∙ (f(m) ∙ g(m))
                    := rel_cong(CommMonoidRel::range_op(same, op, m, f, g)),
                ≈ (MonoidRel::range(op, m, f) ∙ f(m)) ∙ (MonoidRel::range(op, m, g) ∙ g(m))
                    := CommMonoidRel::interchange(same, op, MonoidRel::range(op, m, f), MonoidRel::range(op, m, g), f(m), g(m)),
        },
    }
}

theorem CommMonoidRel::range_swap(m, n: Nat, f: Nat → Nat → A):
    MonoidRel::range(op, m, λ i => MonoidRel::range(op, n, λ k => f(i, k)))
        ≈ MonoidRel::range(op, n, λ k => MonoidRel::range(op, m, λ i => f(i, k)))
{
    match m {
        Zero => A.rel_sym(MonoidRel::range(op, n, λ k => A.unit), A.unit,
            MonoidRel::range_unit(op, n, λ k => A.unit, λ k hk => A.rel_refl(A.unit))),
        Succ(p) => calc {
            MonoidRel::range(op, p, λ i => MonoidRel::range(op, n, λ k => f(i, k))) ∙ MonoidRel::range(op, n, λ k => f(p, k))
                ≈ MonoidRel::range(op, n, λ k => MonoidRel::range(op, p, λ i => f(i, k))) ∙ MonoidRel::range(op, n, λ k => f(p, k))
                    := rel_cong(CommMonoidRel::range_swap(same, op, p, n, f)),
                ≈ MonoidRel::range(op, n, λ k => MonoidRel::range(op, p, λ i => f(i, k)) ∙ f(p, k))
                    := A.rel_sym(MonoidRel::range(op, n, λ k => MonoidRel::range(op, p, λ i => f(i, k)) ∙ f(p, k)),
                        MonoidRel::range(op, n, λ k => MonoidRel::range(op, p, λ i => f(i, k))) ∙ MonoidRel::range(op, n, λ k => f(p, k)),
                        CommMonoidRel::range_op(same, op, n, λ k => MonoidRel::range(op, p, λ i => f(i, k)), λ k => f(p, k))),
        },
    }
}

// Reindexing along a bijection of the indices below `n`, given with its
// inverse. Each term is spread over a row by `at`, the rectangle is summed
// the other way, and each column holds one term.
theorem CommMonoidRel::range_perm(n: Nat, f: Nat → A, s, t: Nat → Nat,
    hs: (k: Nat) → k < n → s(k) < n, ht: (k: Nat) → k < n → t(k) < n,
    st: (k: Nat) → k < n → s(t(k)) = k, ts: (k: Nat) → k < n → t(s(k)) = k):
    MonoidRel::range(op, n, λ k => f(s(k))) ≈ MonoidRel::range(op, n, f)
{
    calc {
        MonoidRel::range(op, n, λ k => f(s(k)))
            ≈ MonoidRel::range(op, n, λ k => MonoidRel::range(op, n, λ i => MonoidRel::at(op, s(k), i, f(i))))
                := MonoidRel::range_cong(op, n, λ k => f(s(k)), λ k => MonoidRel::range(op, n, λ i => MonoidRel::at(op, s(k), i, f(i))),
                    λ k hk => A.rel_sym(MonoidRel::range(op, n, λ i => MonoidRel::at(op, s(k), i, f(i))), f(s(k)), A.rel_trans(
                        MonoidRel::range(op, n, λ i => MonoidRel::at(op, s(k), i, f(i))), MonoidRel::at(op, s(k), s(k), f(s(k))), f(s(k)),
                        MonoidRel::range_single(op, n, λ i => MonoidRel::at(op, s(k), i, f(i)), s(k), hs(k, hk),
                            λ i hi ne => MonoidRel::at_other(op, s(k), i, f(i), λ e => ne(sym(e)))),
                        MonoidRel::at_same(op, s(k), f(s(k)))))),
            ≈ MonoidRel::range(op, n, λ i => MonoidRel::range(op, n, λ k => MonoidRel::at(op, s(k), i, f(i))))
                := CommMonoidRel::range_swap(same, op, n, n, λ k i => MonoidRel::at(op, s(k), i, f(i))),
            ≈ MonoidRel::range(op, n, f)
                := MonoidRel::range_cong(op, n, λ i => MonoidRel::range(op, n, λ k => MonoidRel::at(op, s(k), i, f(i))), f,
                    λ i hi => A.rel_trans(
                        MonoidRel::range(op, n, λ k => MonoidRel::at(op, s(k), i, f(i))), MonoidRel::at(op, s(t(i)), i, f(i)), f(i),
                        MonoidRel::range_single(op, n, λ k => MonoidRel::at(op, s(k), i, f(i)), t(i), ht(i, hi),
                            λ k hk ne => MonoidRel::at_other(op, s(k), i, f(i),
                                λ e => ne(trans(sym(ts(k, hk)), j(e, λ w _ => t(s(k)) = t(w), refl))))),
                        j(sym(st(i, hi)), λ w _ => MonoidRel::at(op, w, i, f(i)) ≈ f(i), MonoidRel::at_same(op, i, f(i))))),
    }
}

// Reversal: `k ↦ n - 1 - k`, its own inverse.
theorem CommMonoidRel::range_reverse(n: Nat, f: Nat → A):
    MonoidRel::range(op, n, λ k => f(n - (k + 1))) ≈ MonoidRel::range(op, n, f)
{
    CommMonoidRel::range_perm(same, op, n, f, λ k => n - (k + 1), λ k => n - (k + 1),
        λ k hk => n.sub_succ_lt(k, hk), λ k hk => n.sub_succ_lt(k, hk),
        λ k hk => n.sub_succ_sub_succ(k, hk), λ k hk => n.sub_succ_sub_succ(k, hk))
}

// The triangle `i + j < N`, summed by antidiagonals or by rows: the exchange
// behind Cauchy products.
theorem CommMonoidRel::range_antidiag(N: Nat, f: Nat → Nat → A):
    MonoidRel::range(op, N, λ n => MonoidRel::antidiag(op, n, f))
        ≈ MonoidRel::range(op, N, λ i => MonoidRel::range(op, N - i, λ k => f(i, k)))
{
    match N {
        Zero => A.rel_refl(A.unit),
        Succ(M) => {
            let rows = MonoidRel::range(op, M, λ i => MonoidRel::range(op, M - i, λ k => f(i, k)));
            let last: (rows ∙ MonoidRel::range(op, M - M, λ k => f(M, k)) ≈ rows ∙ MonoidRel::range(op, 0, λ k => f(M, k)))
                = rel_cong(MonoidRel::range_eq(op, M - M, 0, λ k => f(M, k), M.sub_self()));
            let drop: (rows ∙ MonoidRel::range(op, 0, λ k => f(M, k)) ≈ rows) = A.unit_r(rows);
            A.rel_sym(
            MonoidRel::range(op, M + 1, λ i => MonoidRel::range(op, M + 1 - i, λ k => f(i, k))),
            MonoidRel::range(op, M, λ n => MonoidRel::antidiag(op, n, f)) ∙ MonoidRel::antidiag(op, M, f),
            calc {
                MonoidRel::range(op, M + 1, λ i => MonoidRel::range(op, M + 1 - i, λ k => f(i, k)))
                    ≈ MonoidRel::range(op, M + 1, λ i => MonoidRel::range(op, M - i, λ k => f(i, k)) ∙ f(i, M - i))
                        := MonoidRel::range_cong(op, M + 1, λ i => MonoidRel::range(op, M + 1 - i, λ k => f(i, k)),
                            λ i => MonoidRel::range(op, M - i, λ k => f(i, k)) ∙ f(i, M - i),
                            λ i hi => MonoidRel::range_eq(op, M + 1 - i, M - i + 1, λ k => f(i, k), omega(i.le_add(M, hi), i.le_add(M + 1, omega(hi))))),
                    ≈ MonoidRel::range(op, M + 1, λ i => MonoidRel::range(op, M - i, λ k => f(i, k))) ∙ MonoidRel::antidiag(op, M, f)
                        := CommMonoidRel::range_op(same, op, M + 1, λ i => MonoidRel::range(op, M - i, λ k => f(i, k)), λ i => f(i, M - i)),
                    ≈ (rows ∙ MonoidRel::range(op, M - M, λ k => f(M, k))) ∙ MonoidRel::antidiag(op, M, f)
                        := A.rel_refl((rows ∙ MonoidRel::range(op, M - M, λ k => f(M, k))) ∙ MonoidRel::antidiag(op, M, f)),
                    ≈ (rows ∙ MonoidRel::range(op, 0, λ k => f(M, k))) ∙ MonoidRel::antidiag(op, M, f) := rel_cong(last),
                    ≈ rows ∙ MonoidRel::antidiag(op, M, f) := rel_cong(drop),
                    ≈ MonoidRel::range(op, M, λ n => MonoidRel::antidiag(op, n, f)) ∙ MonoidRel::antidiag(op, M, f)
                        := rel_cong(A.rel_sym(MonoidRel::range(op, M, λ n => MonoidRel::antidiag(op, n, f)),
                            MonoidRel::range(op, M, λ i => MonoidRel::range(op, M - i, λ k => f(i, k))),
                            CommMonoidRel::range_antidiag(same, op, M, f))),
            })
        },
    }
}

}

section<A: Semiring(≈, +, *)> {

theorem Semiring::mul_range_l(c: A, n: Nat, f: Nat → A): c * ∑ k < n, f(k) ≈ ∑ k < n, c * f(k) {
    match n {
        Zero => A.mul_zero(c),
        Succ(m) => calc {
            c * ((∑ k < m, f(k)) + f(m))
                ≈ c * (∑ k < m, f(k)) + c * f(m) := A.distrib_l(c, ∑ k < m, f(k), f(m)),
                ≈ (∑ k < m, c * f(k)) + c * f(m) := rel_cong(Semiring::mul_range_l(c, m, f)),
        },
    }
}

theorem Semiring::range_mul_r(n: Nat, f: Nat → A, c: A): (∑ k < n, f(k)) * c ≈ ∑ k < n, f(k) * c {
    match n {
        Zero => A.zero_mul(c),
        Succ(m) => calc {
            ((∑ k < m, f(k)) + f(m)) * c
                ≈ (∑ k < m, f(k)) * c + f(m) * c := A.distrib_r(∑ k < m, f(k), f(m), c),
                ≈ (∑ k < m, f(k) * c) + f(m) * c := rel_cong(Semiring::range_mul_r(m, f, c)),
        },
    }
}

// Two sums multiply out to the sum over their rectangle.
theorem Semiring::range_mul_range(m, n: Nat, f, g: Nat → A):
    (∑ i < m, f(i)) * (∑ k < n, g(k)) ≈ ∑ i < m, ∑ k < n, f(i) * g(k)
{
    rewrite(Semiring::range_mul_r, Semiring::mul_range_l, A.rel_refl(∑ i < m, ∑ k < n, f(i) * g(k)))
}

// The first `N` coefficients of a Cauchy product, `c(n) = ∑_{i+j=n} a(i) b(j)`,
// sum to the triangle `∑_{i<N} a(i) ∑_{j<N-i} b(j)`.
theorem Semiring::range_cauchy(N: Nat, a, b: Nat → A):
    ∑ n < N, MonoidRel::antidiag(+, n, λ i k => a(i) * b(k)) ≈ ∑ i < N, a(i) * ∑ k < N - i, b(k)
{
    rewrite(Semiring::mul_range_l, CommMonoidRel::range_antidiag(≈, +, N, λ i k => a(i) * b(k)))
}

}

section<A: LocatedAddMonoid(≈, <, <=, +)> {

// Monotonicity and the sign are stated over the terms `f` themselves
// rather than `∑ k < n, f(k)`, its η-expansion: a tactic matching the
// conclusion against `∑ k < n, f(k) + c` then reads the terms off as they
// are (`mono`; the two convert).
theorem LocatedAddMonoid::range_le(n: Nat, f, g: Nat → A):
    ((k: Nat) → Nat::Lt(k, n) → f(k) <= g(k)) → MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g)
{
    match n {
        Zero => λ h => StrictOrder::le_refl(A.unit),
        Succ(m) => λ h => LocatedAddMonoid::add_le_mono(∑ k < m, f(k), ∑ k < m, g(k), f(m), g(m),
            LocatedAddMonoid::range_le(m, f, g, λ k hk => h(k, omega(hk))), h(m, m.lt_succ_self())),
    }
}

theorem LocatedAddMonoid::range_nonneg(n: Nat, f: Nat → A):
    ((k: Nat) → Nat::Lt(k, n) → A.unit <= f(k)) → A.unit <= MonoidRel::range(+, n, f)
{
    λ h => StrictOrder::le_respects(∑ k < n, A.unit, A.unit, ∑ k < n, f(k), ∑ k < n, f(k),
        MonoidRel::range_unit(+, n, λ k => A.unit, λ k hk => A.rel_refl(A.unit)), A.rel_refl(∑ k < n, f(k)),
        LocatedAddMonoid::range_le(n, λ k => A.unit, f, h))
}

}

section<A: LocatedAddGroup(≈, <, <=, +)> {

// The triangle inequality, with the bound stated rather than computed:
// termwise `|f(k)| <= g(k)` gives `|∑ f| <= ∑ g`.
theorem LocatedAddGroup::range_abs_le(n: Nat, f, g: Nat → A):
    ((k: Nat) → Nat::Lt(k, n) → AbsLe(f(k), g(k))) → AbsLe(∑ k < n, f(k), ∑ k < n, g(k))
{
    match n {
        Zero => λ h => And(StrictOrder::le_of_same(A.inv(A.unit), A.unit, OrderedAddGroup::neg_zero()), StrictOrder::le_refl(A.unit)),
        Succ(m) => λ h => LocatedAddGroup::abs_le_add(∑ k < m, f(k), f(m), ∑ k < m, g(k), g(m),
            LocatedAddGroup::range_abs_le(m, f, g, λ k hk => h(k, omega(hk))), h(m, m.lt_succ_self())),
    }
}

}

// Monotonicity at `Nat` and `Int` by name: the generic theorem at their
// instances (`ordered_field`), what `mono`'s carrier tables cite.
theorem Nat::range_le(n: Nat, f, g: Nat → Nat): ((k: Nat) → k < n → f(k) <= g(k)) → MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g) {
    λ h => LocatedAddMonoid::range_le(n, f, g, h)
}

theorem Int::range_le(n: Nat, f, g: Nat → Int): ((k: Nat) → k < n → f(k) <= g(k)) → MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g) {
    λ h => LocatedAddMonoid::range_le(n, f, g, h)
}

// ---------------------------------------------------------------------------
// `mono`'s laws for sums (lib/std/tactic/mono_laws.hthr): a sum's terms move
// termwise, at the carriers whose own rules live below this module and at
// every located class.

register def mono_nat_range: MonoEntry = MonoRules(name_of(Nat::Le), [
    mono_law(False, name_of(MonoidRel::range), [2], name_of(Nat::range_le)),
], []);

register def mono_int_range: MonoEntry = MonoRules(name_of(Int::Le), [
    mono_law(False, name_of(MonoidRel::range), [2], name_of(Int::range_le)),
], []);

register def mono_located_range: MonoEntry = MonoClassRules(name_of(LocatedAddMonoid), [
    class_law(False, Named(name_of(MonoidRel::range)), [2], name_of(LocatedAddMonoid::range_le)),
], [
    class_sign(False, Named(name_of(MonoidRel::range)), name_of(LocatedAddMonoid::range_nonneg)),
]);

register def mono_located_group_range: MonoEntry = MonoClassRules(name_of(LocatedAddGroup), [
    class_law(False, Named(name_of(MonoidRel::range)), [2], name_of(LocatedAddMonoid::range_le)),
], [
    class_sign(False, Named(name_of(MonoidRel::range)), name_of(LocatedAddMonoid::range_nonneg)),
]);

register def mono_ordered_semiring_range: MonoEntry = MonoClassRules(name_of(OrderedSemiring), [
    class_law(False, Named(name_of(MonoidRel::range)), [2], name_of(LocatedAddMonoid::range_le)),
], [
    class_sign(False, Named(name_of(MonoidRel::range)), name_of(LocatedAddMonoid::range_nonneg)),
]);

register def mono_ordered_ring_range: MonoEntry = MonoClassRules(name_of(OrderedRing), [
    class_law(False, Named(name_of(MonoidRel::range)), [2], name_of(LocatedAddMonoid::range_le)),
], [
    class_sign(False, Named(name_of(MonoidRel::range)), name_of(LocatedAddMonoid::range_nonneg)),
]);

register def mono_ordered_field_range: MonoEntry = MonoClassRules(name_of(OrderedField), [
    class_law(False, Named(name_of(MonoidRel::range)), [2], name_of(LocatedAddMonoid::range_le)),
], [
    class_sign(False, Named(name_of(MonoidRel::range)), name_of(LocatedAddMonoid::range_nonneg)),
]);

// ---------------------------------------------------------------------------
// `mono`'s laws at `Int` (lib/std/tactic/mono_laws.hthr): registered here
// and not in `int`, which is below the tactics and `string`.

register def mono_int_order: MonoEntry = MonoOrder(name_of(Int::Le), name_of(Int::Lt), name_of(Int::le_refl), name_of(Int::le_of_lt), None);

register def mono_int_rules: MonoEntry = MonoRules(name_of(Int::Le), [
    mono_law(False, name_of(Int::add), [1], name_of(Int::add_le_mono_l)),
    mono_law(False, name_of(Int::add), [0], name_of(Int::add_le_mono_r)),
    mono_law(False, name_of(Int::add), [0, 1], name_of(Int::add_le_mono)),
    mono_law(False, name_of(Int::mul), [1], name_of(Int::mul_le_mono_l)),
    mono_law(False, name_of(Int::mul), [0], name_of(Int::mul_le_mono_r)),
    mono_law(True, name_of(Int::mul), [0], name_of(Int::mul_lt_mono_r)),
], [
    mono_sign(False, name_of(Int::abs), name_of(Int::abs_nonneg)),
]);

register def mono_int_unsub: MonoEntry = MonoUnsub(name_of(Int::sub), name_of(Int::add), name_of(Int::neg));

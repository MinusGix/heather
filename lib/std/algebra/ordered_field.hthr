// Order meeting `+` and `*`, from a strict order up to the constructive
// ordered field, as layers of classes over a setoid
// (issues/constructive-ordered-field-interface.md,
// issues/ordered-algebra-api.md; docs/constructive-ordered-field-design.md,
// docs/ordered-algebra-design.md).
//
// Nothing here decides anything. Equality is a setoid `≈`, never `=`; the
// strict order `<` is primitive (at the reals it is positive data, a gap);
// `≤` is an index characterised as `¬(y < x)`, Bishop's, so a carrier may
// keep its own spelling of it; apartness is `x < y ∨ y < x`; and the
// inverse takes an apartness proof instead of returning a junk value at zero.
// No layer has trichotomy, decidable `≈`, or decidable `≤`. Carriers that do
// decide (`Nat`, `Int`, `Dyadic`) fill the same layers.
//
// The layers, weakest first, each with the theorems that need no more:
//
// - `StrictOrder(≈, <, ≤)`: a tight strict order respecting a setoid. Open
//   intervals, apartness's irreflexivity, symmetry and tightness, and `≤`'s
//   reflexivity and antisymmetry live here.
// - `Cotransitive(<)`, the separate capability, and `PseudoOrder`, the two
//   together. Cotransitivity is locatedness: every point is placed on one
//   side or the other of every gap. Transitivity of `≤`, the mixed `<`/`≤`
//   steps and every closed-interval lemma need it.
// - `OrderedAddMonoid(≈, <, ≤, +)`: a strict order and a commutative monoid
//   under `+` whose translation keeps and reflects `<`; `LocatedAddMonoid`
//   adds locatedness. Sums, termwise monotonicity of `∑` and the signs of
//   sums live here, so they hold at `Nat`.
// - `OrderedAddGroup` and `LocatedAddGroup`: the monoids whose `+` is a
//   group (`algebra_rel`'s `GroupRel`). Negation, subtraction and the
//   absolute-value bounds, stated as predicates (`AbsLt(x, e)` is the open
//   interval `(-e, e)`) so that no carrier has to compute an absolute value.
// - `OrderedSemiring(≈, <, ≤, +, *)`: a located monoid that is a commutative
//   semiring, with `0 < 1` and a positive factor keeping and reflecting `<`.
//   Products' signs and monotonicity by nonnegative factors live here.
// - `OrderedRing`: an ordered semiring whose `+` is a located group, with
//   nothing new; a square's sign and nonpositive factors live here.
// - `OrderedField`: an ordered ring with a reciprocal on elements apart from
//   zero and the Archimedean property over an embedding of `Nat`. The
//   reciprocal's sign, the order reversal of inversion and the Archimedean
//   property's reciprocal form (`archimedean_recip`) are derived here.
//
// Carriers: `Nat` is an ordered semiring, `Int` and `Dyadic` ordered rings
// (the first two at the end of this module, `Dyadic` beside its type), and
// `Rat` and `CReal` ordered fields.
//
// The algebra is the ring layers', not restated: zero is `A.unit`, negation
// `A.inv`, one `A.multiplicative.unit`, and every `GroupRel`, `Ring` and
// `Semiring` theorem applies to these layers
// (issues/ordered-field-over-comm-ring.md).
//
// Points are explicit arguments: a generic theorem's indices are filled from
// its carrier, and the carrier is read off the first point. Theorems are
// owned by the weakest class they need (`StrictOrder::le_antisymm`,
// `PseudoOrder::le_trans`), so the name says which structure a client must
// have.

import logic;
import nat;
import int;
import relation;
import relation_props;
import algebra_rel;
import semiring;
import omega;
import order;

// ---------------------------------------------------------------------------
// Relations built from the strict order.

// Apartness: one is strictly below the other. Positive information, never
// `¬(x ≈ y)`.
fn ApartBy<A>(lt: A → A → Type, x, y: A) → Type { lt(x, y) ∨ lt(y, x) }

// The open interval (a, b) and the closed interval [a, b].
fn Between<A>(lt: A → A → Type, a, x, b: A) → Type { lt(a, x) ∧ lt(x, b) }

fn Within<A>(le: A → A → Type, a, x, b: A) → Type { le(a, x) ∧ le(x, b) }

// ---------------------------------------------------------------------------
// The strict order.

// A strict order modulo `≈`: irreflexive, transitive, invariant under `≈` on
// both sides, and tight (two points neither of which is below the other are
// the same). `≤` is whatever the carrier calls it, provided it means
// `¬(y < x)`. The `<` laws are fields of their own rather than the
// `Irreflexive`/`Transitive` parents: those would put `Transitive` at two
// indices (`≈`'s and `<`'s) into one dictionary.
//
// Both relations are indices, and the class presents what they are as
// relations (docs/strict-order-presentation-design.md): `<` is a
// `Transitive` relation, and `≈` chains with either order, as tagged parents.
// They are what lets a `calc` inside `section<A: StrictOrder(…)>` step through
// `<`, `≈` and `≤`. A carrier with those instances registered (`Rat`, `CReal`,
// `Dyadic`, `Nat`, `Int`) fills them by reference; a parameterized one
// (`Finite(F)`) writes them. Until a class can fill an inherited field from
// its own (issues/class-inherited-field-implementations.md), they are the
// carrier's to supply although they follow from the fields below.
class StrictOrder<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type)
    extends Equivalence<A>(same), Transitive<A>(lt) as lt_transitive,
        Trans<A>(same, lt, lt) as same_lt, Trans<A>(lt, same, lt) as lt_same,
        Trans<A>(same, le, le) as same_le, Trans<A>(le, same, le) as le_same
{
    lt_irrefl: (x: A) → ¬(x < x),
    lt_trans: (x, y, z: A) → x < y → y < z → x < z,
    lt_respects: (x, x2, y, y2: A) → x ≈ x2 → y ≈ y2 → x < y → x2 < y2,
    lt_tight: (x, y: A) → ¬(x < y) → ¬(y < x) → x ≈ y,
    le_of_not_lt: (x, y: A) → ¬(y < x) → x <= y,
    not_lt_of_le: (x, y: A) → x <= y → ¬(y < x),
}

section<A: StrictOrder(≈, <, <=)> {

theorem StrictOrder::lt_asymm(x, y: A, h: x < y): ¬(y < x) {
    λ back => A.lt_irrefl(x, A.lt_trans(x, y, x, h, back))
}

theorem StrictOrder::lt_respects_l(x, x2, y: A, hx: x ≈ x2, h: x < y): x2 < y {
    A.lt_respects(x, x2, y, y, hx, A.rel_refl(y), h)
}

theorem StrictOrder::lt_respects_r(x, y, y2: A, hy: y ≈ y2, h: x < y): x < y2 {
    A.lt_respects(x, x, y, y2, A.rel_refl(x), hy, h)
}

theorem StrictOrder::le_refl(x: A): x <= x {
    A.le_of_not_lt(x, x, A.lt_irrefl(x))
}

theorem StrictOrder::le_of_lt(x, y: A, h: x < y): x <= y {
    A.le_of_not_lt(x, y, StrictOrder::lt_asymm(x, y, h))
}

theorem StrictOrder::le_of_same(x, y: A, h: x ≈ y): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.lt_irrefl(x, StrictOrder::lt_respects_l(y, x, x, A.rel_sym(x, y, h), yx)))
}

theorem StrictOrder::le_respects(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2, h: x <= y):
    x2 <= y2
{
    A.le_of_not_lt(x2, y2, λ back => A.not_lt_of_le(x, y, h,
        A.lt_respects(y2, y, x2, x, A.rel_sym(y, y2, hy), A.rel_sym(x, x2, hx), back)))
}

// A side replaced by one it is `≈` to, the moved side named in between:
// what `mono` reads a cast through at a class carrier
// (lib/std/tactic/mono.hthr, `mono_push_left`), the shape of
// `Rat::le_of_same_of_le` and its siblings.
theorem StrictOrder::le_of_same_l(x, y, z: A, e: x ≈ y, h: y <= z): x <= z {
    StrictOrder::le_respects(y, x, z, z, A.rel_sym(x, y, e), A.rel_refl(z), h)
}

theorem StrictOrder::le_of_same_r(x, y, z: A, e: z ≈ y, h: x <= y): x <= z {
    StrictOrder::le_respects(x, x, y, z, A.rel_refl(x), A.rel_sym(z, y, e), h)
}

// A `≤` is a refutation, so a proof of one may split on `y < z` inside it:
// nothing is decided and no locatedness is used. `CReal::le_by_sign` is this
// at `z = 0`.
theorem StrictOrder::le_by_cases(u, v, y, z: A, below: y < z → u <= v, above: z <= y → u <= v): u <= v {
    A.le_of_not_lt(u, v, λ back => A.not_lt_of_le(u, v, above(A.le_of_not_lt(z, y, λ yz => A.not_lt_of_le(u, v, below(yz), back))), back))
}

theorem StrictOrder::lt_of_same_l(x, y, z: A, e: x ≈ y, h: y < z): x < z {
    A.lt_respects(y, x, z, z, A.rel_sym(x, y, e), A.rel_refl(z), h)
}

theorem StrictOrder::lt_of_same_r(x, y, z: A, e: z ≈ y, h: x < y): x < z {
    A.lt_respects(x, x, y, z, A.rel_refl(x), A.rel_sym(z, y, e), h)
}

// Antisymmetry of `≤` modulo `≈` is tightness: it never yields `=`.
theorem StrictOrder::le_antisymm(x, y: A, hxy: x <= y, hyx: y <= x): x ≈ y {
    A.lt_tight(x, y, A.not_lt_of_le(y, x, hyx), A.not_lt_of_le(x, y, hxy))
}

theorem StrictOrder::apart_irrefl(x: A): ¬(ApartBy(<, x, x)) {
    λ h => match h {
        Inl(l) => A.lt_irrefl(x, l),
        Inr(r) => A.lt_irrefl(x, r),
    }
}

theorem StrictOrder::apart_sym(x, y: A, h: ApartBy(<, x, y)): ApartBy(<, y, x) {
    match h {
        Inl(l) => Inr(l),
        Inr(r) => Inl(r),
    }
}

theorem StrictOrder::apart_respects(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2,
    h: ApartBy(<, x, y)): ApartBy(<, x2, y2)
{
    match h {
        Inl(l) => Inl(A.lt_respects(x, x2, y, y2, hx, hy, l)),
        Inr(r) => Inr(A.lt_respects(y, y2, x, x2, hy, hx, r)),
    }
}

// Tightness in apartness's words: what is not apart is the same.
theorem StrictOrder::same_of_not_apart(x, y: A, h: ¬(ApartBy(<, x, y))): x ≈ y {
    A.lt_tight(x, y, λ l => h(Inl(l)), λ r => h(Inr(r)))
}

theorem StrictOrder::not_apart_of_same(x, y: A, h: x ≈ y): ¬(ApartBy(<, x, y)) {
    λ a => StrictOrder::apart_irrefl(x, StrictOrder::apart_respects(x, x, y, x, A.rel_refl(x), A.rel_sym(x, y, h), a))
}

// An open interval with a point in it is nonempty in the order: a < b.
theorem StrictOrder::between_lt(a, x, b: A, h: Between(<, a, x, b)): a < b {
    A.lt_trans(a, x, b, h.left, h.right)
}

theorem StrictOrder::between_respects(a, x, b, x2: A, hx: x ≈ x2,
    h: Between(<, a, x, b)): Between(<, a, x2, b)
{
    And(StrictOrder::lt_respects_r(a, x, x2, hx, h.left), StrictOrder::lt_respects_l(x, x2, b, hx, h.right))
}

// Widening an open interval by strict steps needs only transitivity; by `≤`
// steps it needs locatedness (`PseudoOrder::between_widen_le`).
theorem StrictOrder::between_widen(a, x, b, a2, b2: A, ha: a2 < a, hb: b < b2,
    h: Between(<, a, x, b)): Between(<, a2, x, b2)
{
    And(A.lt_trans(a2, a, x, ha, h.left), A.lt_trans(x, b, b2, h.right, hb))
}

theorem StrictOrder::within_of_between(a, x, b: A, h: Between(<, a, x, b)):
    Within(<=, a, x, b)
{
    And(StrictOrder::le_of_lt(a, x, h.left), StrictOrder::le_of_lt(x, b, h.right))
}

// A point strictly below an open interval is apart from every point in it.
theorem StrictOrder::apart_of_lt_between(y, a, x, b: A, ya: y < a,
    h: Between(<, a, x, b)): ApartBy(<, y, x)
{
    Inl(A.lt_trans(y, a, x, ya, h.left))
}

}

// ---------------------------------------------------------------------------
// Locatedness.

// Cotransitivity: a gap x < y places every z, below y or above x. At the
// Cauchy reals this is where approximations are consulted; at the rationals
// it is a decision. It is a capability of its own because a strict order
// can lack it (the Dedekind reals without located cuts), and every theorem
// above was proved without it.
class Cotransitive<A>(R: A → A → Type) {
    rel_cotrans: (x, y, z: A) → R(x, y) → R(x, z) ∨ R(z, y),
}

// A located strict order. Its `≤` is a preorder and chains with `<` both ways
// round, tagged like `StrictOrder`'s views and for the same reason: both
// need cotransitivity (`PseudoOrder::le_trans`, `lt_of_lt_of_le`).
class PseudoOrder<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type)
    extends StrictOrder<A>(same, lt, le), Cotransitive<A>(lt), Preorder<A>(le) as le_preorder,
        Trans<A>(lt, le, lt) as lt_le, Trans<A>(le, lt, lt) as le_lt
{}

section<A: PseudoOrder(≈, <, <=)> {

// The located reading of a gap: every point is below its top or above its
// bottom.
theorem PseudoOrder::locate(a, b, x: A, h: a < b): a < x ∨ x < b {
    A.rel_cotrans(a, b, x, h)
}

theorem PseudoOrder::lt_of_lt_of_le(x, y, z: A, h1: x < y, h2: y <= z): x < z {
    match A.rel_cotrans(x, y, z, h1) {
        Inl(xz) => xz,
        Inr(zy) => false_elim(A.not_lt_of_le(y, z, h2, zy)),
    }
}

theorem PseudoOrder::lt_of_le_of_lt(x, y, z: A, h1: x <= y, h2: y < z): x < z {
    match A.rel_cotrans(y, z, x, h2) {
        Inl(yx) => false_elim(A.not_lt_of_le(x, y, h1, yx)),
        Inr(xz) => xz,
    }
}

theorem PseudoOrder::le_trans(x, y, z: A, hxy: x <= y, hyz: y <= z): x <= z {
    A.le_of_not_lt(x, z, λ zx => match A.rel_cotrans(z, x, y, zx) {
        Inl(zy) => A.not_lt_of_le(y, z, hyz, zy),
        Inr(yx) => A.not_lt_of_le(x, y, hxy, yx),
    })
}

theorem PseudoOrder::apart_cotrans(x, y, z: A, h: ApartBy(<, x, y)):
    ApartBy(<, x, z) ∨ ApartBy(<, z, y)
{
    match h {
        Inl(xy) => match A.rel_cotrans(x, y, z, xy) {
            Inl(xz) => Inl(Inl(xz)),
            Inr(zy) => Inr(Inl(zy)),
        },
        Inr(yx) => match A.rel_cotrans(y, x, z, yx) {
            Inl(yz) => Inr(Inr(yz)),
            Inr(zx) => Inl(Inr(zx)),
        },
    }
}

theorem PseudoOrder::within_le(a, x, b: A, h: Within(<=, a, x, b)): a <= b {
    PseudoOrder::le_trans(a, x, b, h.left, h.right)
}

theorem PseudoOrder::within_widen(a, x, b, a2, b2: A, ha: a2 <= a, hb: b <= b2,
    h: Within(<=, a, x, b)): Within(<=, a2, x, b2)
{
    And(PseudoOrder::le_trans(a2, a, x, ha, h.left), PseudoOrder::le_trans(x, b, b2, h.right, hb))
}

theorem PseudoOrder::between_widen_le(a, x, b, a2, b2: A, ha: a2 <= a, hb: b <= b2,
    h: Between(<, a, x, b)): Between(<, a2, x, b2)
{
    And(PseudoOrder::lt_of_le_of_lt(a2, a, x, ha, h.left), PseudoOrder::lt_of_lt_of_le(x, b, b2, h.right, hb))
}

// A closed interval sits inside any open one around it.
theorem PseudoOrder::between_of_within(a, x, b, a2, b2: A, ha: a2 < a, hb: b < b2,
    h: Within(<=, a, x, b)): Between(<, a2, x, b2)
{
    And(PseudoOrder::lt_of_lt_of_le(a2, a, x, ha, h.left), PseudoOrder::lt_of_le_of_lt(x, b, b2, h.right, hb))
}

}

// ---------------------------------------------------------------------------
// The ordered additive monoid.

// A commutative monoid under `+` modulo `≈` (`algebra_rel`'s
// `CommMonoidRel`, untagged, so zero is `A.unit`) whose strict order
// translation both keeps and reflects. In a group the reflection follows
// from the keeping, by adding the inverse; a monoid such as `Nat` has no
// inverse to add, so there it is a law of its own. Everything about sums
// that needs no negation is proved here, and so holds at `Nat` as at the
// fields.
class OrderedAddMonoid<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends StrictOrder<A>(same, lt, le), CommMonoidRel<A>(same, add)
{
    add_lt_mono_r: (x, y, z: A) → x < y → x + z < y + z,
    add_lt_reflect_r: (x, y, z: A) → x + z < y + z → x < y,
}

section<A: OrderedAddMonoid(≈, <, <=, +)> {

theorem OrderedAddMonoid::add_respects(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2):
    x + y ≈ x2 + y2
{
    A.rel_trans(x + y, x2 + y, x2 + y2, rel_cong(hx), rel_cong(hy))
}

theorem OrderedAddMonoid::add_lt_mono_l(x, y, z: A, h: x < y): z + x < z + y {
    A.lt_respects(x + z, z + x, y + z, z + y, A.comm(x, z), A.comm(y, z), A.add_lt_mono_r(x, y, z, h))
}

theorem OrderedAddMonoid::add_lt_mono(x, x2, y, y2: A, hx: x < x2, hy: y < y2):
    x + y < x2 + y2
{
    calc {
        x + y < x2 + y := A.add_lt_mono_r(x, x2, y, hx),
        < x2 + y2 := OrderedAddMonoid::add_lt_mono_l(y, y2, x2, hy),
    }
}

// The reflection law, as a theorem a tactic can look up by name.
theorem OrderedAddMonoid::add_lt_cancel_r(x, y, z: A, h: x + z < y + z): x < y {
    A.add_lt_reflect_r(x, y, z, h)
}

theorem OrderedAddMonoid::add_lt_cancel_l(x, y, z: A, h: z + x < z + y): x < y {
    OrderedAddMonoid::add_lt_cancel_r(x, y, z, A.lt_respects(z + x, x + z, z + y, y + z, A.comm(z, x), A.comm(z, y), h))
}

// `≤` is translation-invariant without locatedness: a refutation of `<`
// moves along a refutation of the cancelled `<`.
theorem OrderedAddMonoid::add_le_mono_r(x, y, z: A, h: x <= y): x + z <= y + z {
    A.le_of_not_lt(x + z, y + z, λ back => A.not_lt_of_le(x, y, h, OrderedAddMonoid::add_lt_cancel_r(y, x, z, back)))
}

theorem OrderedAddMonoid::add_le_mono_l(x, y, z: A, h: x <= y): z + x <= z + y {
    A.le_of_not_lt(z + x, z + y, λ back => A.not_lt_of_le(x, y, h, OrderedAddMonoid::add_lt_cancel_l(y, x, z, back)))
}

// Cancellation (issues/cancellative-algebra-api.md). Addition cancels with
// no side condition: an ordered additive monoid is cancellative, because a
// gap between the summands would survive translation and contradict the
// equation. This is the unconditional kind; multiplication's, which needs a
// positive or apart factor, is at the semiring and the ring below. Every
// group cancels as well (`GroupRel` laws), so with these two every carrier
// here has its additive cancellation without a class of its own.
theorem OrderedAddMonoid::add_cancel_r(x, y, z: A, h: x + z ≈ y + z): x ≈ y {
    A.lt_tight(x, y,
        λ l => StrictOrder::not_apart_of_same(x + z, y + z, h, Inl(A.add_lt_mono_r(x, y, z, l))),
        λ g => StrictOrder::not_apart_of_same(x + z, y + z, h, Inr(A.add_lt_mono_r(y, x, z, g))))
}

theorem OrderedAddMonoid::add_cancel_l(x, y, z: A, h: z + x ≈ z + y): x ≈ y {
    OrderedAddMonoid::add_cancel_r(x, y, z,
        A.rel_trans(x + z, z + x, y + z, A.comm(x, z), A.rel_trans(z + x, z + y, y + z, h, A.comm(z, y))))
}

theorem OrderedAddMonoid::add_le_cancel_r(x, y, z: A, h: x + z <= y + z): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.not_lt_of_le(x + z, y + z, h, A.add_lt_mono_r(y, x, z, yx)))
}

theorem OrderedAddMonoid::add_le_cancel_l(x, y, z: A, h: z + x <= z + y): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.not_lt_of_le(z + x, z + y, h, OrderedAddMonoid::add_lt_mono_l(y, x, z, yx)))
}

// A sum of positives is positive.
theorem OrderedAddMonoid::add_pos(x, y: A, hx: A.unit < x, hy: A.unit < y): A.unit < x + y {
    calc {
        A.unit ≈ A.unit + A.unit := A.rel_sym(A.unit + A.unit, A.unit, A.unit_r(A.unit)),
        < x + y := OrderedAddMonoid::add_lt_mono(A.unit, x, A.unit, y, hx, hy),
    }
}

}

// ---------------------------------------------------------------------------
// The located monoid: a sum's order from both summands at once, and the sign
// of a sum.

class LocatedAddMonoid<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends OrderedAddMonoid<A>(same, lt, le, add), PseudoOrder<A>(same, lt, le)
{}

section<A: LocatedAddMonoid(≈, <, <=, +)> {

// A gap between sums is a gap between one pair of summands: the strong
// extensionality of `+`, read off cotransitivity.
theorem LocatedAddMonoid::add_lt_cancel(x, x2, y, y2: A, h: x + y < x2 + y2):
    x < x2 ∨ y < y2
{
    match A.rel_cotrans(x + y, x2 + y2, x2 + y, h) {
        Inl(l) => Inl(OrderedAddMonoid::add_lt_cancel_r(x, x2, y, l)),
        Inr(r) => Inr(OrderedAddMonoid::add_lt_cancel_l(y, y2, x2, r)),
    }
}

theorem LocatedAddMonoid::pos_of_add_pos(x, y: A, h: A.unit < x + y):
    A.unit < x ∨ A.unit < y
{
    LocatedAddMonoid::add_lt_cancel(A.unit, x, A.unit, y, StrictOrder::lt_respects_l(A.unit, A.unit + A.unit, x + y,
        A.rel_sym(A.unit + A.unit, A.unit, A.unit_r(A.unit)), h))
}

theorem LocatedAddMonoid::add_le_mono(x, x2, y, y2: A, hx: x <= x2, hy: y <= y2):
    x + y <= x2 + y2
{
    calc {
        x + y <= x2 + y := OrderedAddMonoid::add_le_mono_r(x, x2, y, hx),
        <= x2 + y2 := OrderedAddMonoid::add_le_mono_l(y, y2, x2, hy),
    }
}

// A strict bound and a weak one add to a strict one.
theorem LocatedAddMonoid::add_lt_le_mono(x, x2, y, y2: A, hx: x < x2, hy: y <= y2): x + y < x2 + y2 {
    calc {
        x + y < x2 + y := A.add_lt_mono_r(x, x2, y, hx),
        <= x2 + y2 := OrderedAddMonoid::add_le_mono_l(y, y2, x2, hy),
    }
}

theorem LocatedAddMonoid::add_le_lt_mono(x, x2, y, y2: A, hx: x <= x2, hy: y < y2): x + y < x2 + y2 {
    calc {
        x + y <= x2 + y := OrderedAddMonoid::add_le_mono_r(x, x2, y, hx),
        < x2 + y2 := OrderedAddMonoid::add_lt_mono_l(y, y2, x2, hy),
    }
}

// A sum of nonnegatives is nonnegative.
theorem LocatedAddMonoid::add_nonneg(x, y: A, hx: A.unit <= x, hy: A.unit <= y): A.unit <= x + y {
    calc {
        A.unit ≈ A.unit + A.unit := A.rel_sym(A.unit + A.unit, A.unit, A.unit_r(A.unit)),
        <= x + y := LocatedAddMonoid::add_le_mono(A.unit, x, A.unit, y, hx, hy),
    }
}

}

// ---------------------------------------------------------------------------
// The ordered additive group.

// An ordered monoid whose `+` is an abelian group (`algebra_rel`'s
// `GroupRel`, untagged, so negation is `A.inv` and every `GroupRel` theorem
// applies here). Nothing is new but the inverse; what it adds is
// subtraction, the sign of a negation and the absolute-value bounds.
class OrderedAddGroup<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends OrderedAddMonoid<A>(same, lt, le, add), GroupRel<A>(same, add)
{}

section<A: OrderedAddGroup(≈, <, <=, +)> {

// |x| < e and |x| ≤ e, as the intervals (-e, e) and [-e, e]. Stating the
// bound rather than computing |x| keeps these at carriers with no `abs`.
fn AbsLt(x, e: A) → Type { Between(<, A.inv(e), x, e) }

fn AbsLe(x, e: A) → Type { Within(<=, A.inv(e), x, e) }

// x and y are within e of each other: |x - y| < e.
fn Close(x, y, e: A) → Type { AbsLt(x + A.inv(y), e) }

// Cancelling a pair inside a sum, on either side of the pair.
theorem OrderedAddGroup::add_neg_add(x, z: A): x + (A.inv(x) + z) ≈ z {
    calc {
        x + (A.inv(x) + z) ≈ (x + A.inv(x)) + z := A.rel_sym((x + A.inv(x)) + z, x + (A.inv(x) + z), A.assoc(x, A.inv(x), z)),
        ≈ A.unit + z := OrderedAddMonoid::add_respects(x + A.inv(x), A.unit, z, z, A.inv_r(x), A.rel_refl(z)),
        ≈ z := A.unit_l(z),
    }
}

theorem OrderedAddGroup::neg_add_add(x, z: A): A.inv(x) + (x + z) ≈ z {
    calc {
        A.inv(x) + (x + z) ≈ (A.inv(x) + x) + z := A.rel_sym((A.inv(x) + x) + z, A.inv(x) + (x + z), A.assoc(A.inv(x), x, z)),
        ≈ A.unit + z := OrderedAddMonoid::add_respects(A.inv(x) + x, A.unit, z, z, A.inv_l(x), A.rel_refl(z)),
        ≈ z := A.unit_l(z),
    }
}

theorem OrderedAddGroup::add_neg_cancel_r(x, y: A): (x + y) + A.inv(y) ≈ x {
    calc {
        (x + y) + A.inv(y) ≈ x + (y + A.inv(y)) := A.assoc(x, y, A.inv(y)),
        ≈ x + A.unit := OrderedAddMonoid::add_respects(x, x, y + A.inv(y), A.unit, A.rel_refl(x), A.inv_r(y)),
        ≈ x := A.unit_r(x),
    }
}

theorem OrderedAddGroup::sub_add_cancel(x, y: A): (x + A.inv(y)) + y ≈ x {
    calc {
        (x + A.inv(y)) + y ≈ x + (A.inv(y) + y) := A.assoc(x, A.inv(y), y),
        ≈ x + A.unit := OrderedAddMonoid::add_respects(x, x, A.inv(y) + y, A.unit, A.rel_refl(x), A.inv_l(y)),
        ≈ x := A.unit_r(x),
    }
}

theorem OrderedAddGroup::neg_zero(): A.inv(A.unit) ≈ A.unit {
    A.rel_sym(A.unit, A.inv(A.unit), GroupRel::inv_unique(+, A.unit, A.unit, A.unit_r(A.unit)))
}

theorem OrderedAddGroup::neg_add(x, y: A): A.inv(x + y) ≈ A.inv(x) + A.inv(y) {
    let cancels = calc {
        (x + y) + (A.inv(x) + A.inv(y)) ≈ (x + A.inv(x)) + (y + A.inv(y)) := CommMonoidRel::interchange(≈, +, x, y, A.inv(x), A.inv(y)),
        ≈ A.unit + A.unit := OrderedAddMonoid::add_respects(x + A.inv(x), A.unit, y + A.inv(y), A.unit, A.inv_r(x), A.inv_r(y)),
        ≈ A.unit := A.unit_r(A.unit),
    };
    A.rel_sym(A.inv(x) + A.inv(y), A.inv(x + y), GroupRel::inv_unique(+, x + y, A.inv(x) + A.inv(y), cancels))
}

// (x - y) + (y - z) ≈ x - z.
theorem OrderedAddGroup::sub_add_sub(x, y, z: A):
    (x + A.inv(y)) + (y + A.inv(z)) ≈ x + A.inv(z)
{
    A.rel_trans((x + A.inv(y)) + (y + A.inv(z)), x + (A.inv(y) + (y + A.inv(z))), x + A.inv(z),
        A.assoc(x, A.inv(y), y + A.inv(z)),
        OrderedAddMonoid::add_respects(x, x, A.inv(y) + (y + A.inv(z)), A.inv(z), A.rel_refl(x),
            OrderedAddGroup::neg_add_add(y, A.inv(z))))
}

// -(x - y) ≈ y - x.
theorem OrderedAddGroup::neg_sub(x, y: A): A.inv(x + A.inv(y)) ≈ y + A.inv(x) {
    calc {
        A.inv(x + A.inv(y)) ≈ A.inv(x) + A.inv(A.inv(y)) := OrderedAddGroup::neg_add(x, A.inv(y)),
        ≈ A.inv(x) + y := OrderedAddMonoid::add_respects(A.inv(x), A.inv(x), A.inv(A.inv(y)), y, A.rel_refl(A.inv(x)), GroupRel::inv_inv(+, y)),
        ≈ y + A.inv(x) := A.comm(A.inv(x), y),
    }
}

// Order and translation.

// x < y gives -y < -x: add -x + -y to both sides.
theorem OrderedAddGroup::neg_lt(x, y: A, h: x < y): A.inv(y) < A.inv(x) {
    let shifted: (x + (A.inv(x) + A.inv(y)) < y + (A.inv(x) + A.inv(y))) =
        A.add_lt_mono_r(x, y, A.inv(x) + A.inv(y), h);
    let right = calc {
        y + (A.inv(x) + A.inv(y)) ≈ y + (A.inv(y) + A.inv(x)) := OrderedAddMonoid::add_respects(y, y,
            A.inv(x) + A.inv(y), A.inv(y) + A.inv(x), A.rel_refl(y), A.comm(A.inv(x), A.inv(y))),
        ≈ A.inv(x) := OrderedAddGroup::add_neg_add(y, A.inv(x)),
    };
    A.lt_respects(x + (A.inv(x) + A.inv(y)), A.inv(y), y + (A.inv(x) + A.inv(y)), A.inv(x),
        OrderedAddGroup::add_neg_add(x, A.inv(y)), right, shifted)
}

// Negation swaps the sides of zero.
theorem OrderedAddGroup::neg_pos(x: A, h: x < A.unit): A.unit < A.inv(x) {
    StrictOrder::lt_respects_l(A.inv(A.unit), A.unit, A.inv(x), OrderedAddGroup::neg_zero(), OrderedAddGroup::neg_lt(x, A.unit, h))
}

theorem OrderedAddGroup::neg_of_neg_pos(x: A, h: A.unit < A.inv(x)): x < A.unit {
    A.lt_respects(A.inv(A.inv(x)), x, A.inv(A.unit), A.unit, GroupRel::inv_inv(+, x), OrderedAddGroup::neg_zero(),
        OrderedAddGroup::neg_lt(A.unit, A.inv(x), h))
}

theorem OrderedAddGroup::sub_pos(x, y: A, h: x < y): A.unit < y + A.inv(x) {
    StrictOrder::lt_respects_l(x + A.inv(x), A.unit, y + A.inv(x), A.inv_r(x), A.add_lt_mono_r(x, y, A.inv(x), h))
}

theorem OrderedAddGroup::lt_of_sub_pos(x, y: A, h: A.unit < y + A.inv(x)): x < y {
    A.lt_respects(A.unit + x, x, (y + A.inv(x)) + x, y, A.unit_l(x), OrderedAddGroup::sub_add_cancel(y, x),
        A.add_lt_mono_r(A.unit, y + A.inv(x), x, h))
}

theorem OrderedAddGroup::between_add(a, x, b, c: A, h: Between(<, a, x, b)):
    Between(<, a + c, x + c, b + c)
{
    And(A.add_lt_mono_r(a, x, c, h.left), A.add_lt_mono_r(x, b, c, h.right))
}

// Absolute-value bounds.

theorem OrderedAddGroup::abs_lt_respects(x, x2, e, e2: A, hx: x ≈ x2, he: e ≈ e2,
    h: AbsLt(x, e)): AbsLt(x2, e2)
{
    And(A.lt_respects(A.inv(e), A.inv(e2), x, x2, A.inv_respects(e, e2, he), hx, h.left),
        A.lt_respects(x, x2, e, e2, hx, he, h.right))
}

theorem OrderedAddGroup::abs_lt_mono(x, e, d: A, h: AbsLt(x, e), ed: e < d): AbsLt(x, d) {
    StrictOrder::between_widen(A.inv(e), x, e, A.inv(d), d, OrderedAddGroup::neg_lt(e, d, ed), ed, h)
}

theorem OrderedAddGroup::abs_lt_neg(x, e: A, h: AbsLt(x, e)): AbsLt(A.inv(x), e) {
    And(OrderedAddGroup::neg_lt(x, e, h.right),
        StrictOrder::lt_respects_r(A.inv(x), A.inv(A.inv(e)), e, GroupRel::inv_inv(+, e), OrderedAddGroup::neg_lt(A.inv(e), x, h.left)))
}

// The triangle inequality: bounds add.
theorem OrderedAddGroup::abs_lt_add(x, y, e, d: A, hx: AbsLt(x, e), hy: AbsLt(y, d)):
    AbsLt(x + y, e + d)
{
    And(StrictOrder::lt_respects_l(A.inv(e) + A.inv(d), A.inv(e + d), x + y,
            A.rel_sym(A.inv(e + d), A.inv(e) + A.inv(d), OrderedAddGroup::neg_add(e, d)),
            OrderedAddMonoid::add_lt_mono(A.inv(e), x, A.inv(d), y, hx.left, hy.left)),
        OrderedAddMonoid::add_lt_mono(x, e, y, d, hx.right, hy.right))
}

// A point within every positive bound of zero is zero. Tightness, not
// locatedness: x > 0 fails the bound x, and x < 0 fails the bound -x.
theorem OrderedAddGroup::same_zero_of_abs_lt(x: A,
    all: (e: A) → A.unit < e → AbsLt(x, e)): x ≈ A.unit
{
    A.lt_tight(x, A.unit,
        λ neg => {
            let pos: (A.unit < A.inv(x)) = StrictOrder::lt_respects_l(A.inv(A.unit), A.unit, A.inv(x),
                OrderedAddGroup::neg_zero(), OrderedAddGroup::neg_lt(x, A.unit, neg));
            A.lt_irrefl(x, StrictOrder::lt_respects_l(A.inv(A.inv(x)), x, x, GroupRel::inv_inv(+, x), all(A.inv(x), pos).left))
        },
        λ pos => A.lt_irrefl(x, all(x, pos).right))
}

theorem OrderedAddGroup::close_sym(x, y, e: A, h: Close(x, y, e)): Close(y, x, e) {
    OrderedAddGroup::abs_lt_respects(A.inv(x + A.inv(y)), y + A.inv(x), e, e, OrderedAddGroup::neg_sub(x, y), A.rel_refl(e),
        OrderedAddGroup::abs_lt_neg(x + A.inv(y), e, h))
}

theorem OrderedAddGroup::close_triangle(x, y, z, e, d: A, hxy: Close(x, y, e),
    hyz: Close(y, z, d)): Close(x, z, e + d)
{
    OrderedAddGroup::abs_lt_respects((x + A.inv(y)) + (y + A.inv(z)), x + A.inv(z), e + d, e + d,
        OrderedAddGroup::sub_add_sub(x, y, z), A.rel_refl(e + d),
        OrderedAddGroup::abs_lt_add(x + A.inv(y), y + A.inv(z), e, d, hxy, hyz))
}

// Points within every positive distance of each other are the same.
theorem OrderedAddGroup::same_of_close(x, y: A,
    all: (e: A) → A.unit < e → Close(x, y, e)): x ≈ y
{
    calc {
        x ≈ (x + A.inv(y)) + y := A.rel_sym((x + A.inv(y)) + y, x, OrderedAddGroup::sub_add_cancel(x, y)),
        ≈ A.unit + y := OrderedAddMonoid::add_respects(x + A.inv(y), A.unit, y, y,
            OrderedAddGroup::same_zero_of_abs_lt(x + A.inv(y), all), A.rel_refl(y)),
        ≈ y := A.unit_l(y),
    }
}

}

// ---------------------------------------------------------------------------
// The located group.

class LocatedAddGroup<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends OrderedAddGroup<A>(same, lt, le, add), LocatedAddMonoid<A>(same, lt, le, add)
{}

section<A: LocatedAddGroup(≈, <, <=, +)> {

// A bound with a point under it is positive. This one needs locatedness:
// -e < e places zero, and zero below -e makes e positive by negation.
theorem LocatedAddGroup::abs_lt_pos(x, e: A, h: AbsLt(x, e)): A.unit < e {
    match A.rel_cotrans(A.inv(e), e, A.unit, StrictOrder::between_lt(A.inv(e), x, e, h)) {
        Inl(below) => A.lt_respects(A.inv(A.unit), A.unit, A.inv(A.inv(e)), e,
            OrderedAddGroup::neg_zero(), GroupRel::inv_inv(+, e), OrderedAddGroup::neg_lt(A.inv(e), A.unit, below)),
        Inr(above) => above,
    }
}

theorem LocatedAddGroup::neg_le(x, y: A, h: x <= y): A.inv(y) <= A.inv(x) {
    A.le_of_not_lt(A.inv(y), A.inv(x), λ back => A.not_lt_of_le(x, y, h,
        A.lt_respects(A.inv(A.inv(y)), y, A.inv(A.inv(x)), x, GroupRel::inv_inv(+, y), GroupRel::inv_inv(+, x),
            OrderedAddGroup::neg_lt(A.inv(x), A.inv(y), back))))
}

theorem LocatedAddGroup::abs_le_of_abs_lt(x, e: A, h: AbsLt(x, e)): AbsLe(x, e) {
    StrictOrder::within_of_between(A.inv(e), x, e, h)
}

theorem LocatedAddGroup::abs_le_add(x, y, e, d: A, hx: AbsLe(x, e), hy: AbsLe(y, d)):
    AbsLe(x + y, e + d)
{
    And(StrictOrder::le_respects(A.inv(e) + A.inv(d), A.inv(e + d), x + y, x + y,
            A.rel_sym(A.inv(e + d), A.inv(e) + A.inv(d), OrderedAddGroup::neg_add(e, d)), A.rel_refl(x + y),
            LocatedAddMonoid::add_le_mono(A.inv(e), x, A.inv(d), y, hx.left, hy.left)),
        LocatedAddMonoid::add_le_mono(x, e, y, d, hx.right, hy.right))
}

// A non-strict bound inside a strict one is strict.
theorem LocatedAddGroup::abs_lt_of_abs_le(x, e, d: A, h: AbsLe(x, e), ed: e < d):
    AbsLt(x, d)
{
    PseudoOrder::between_of_within(A.inv(e), x, e, A.inv(d), d, OrderedAddGroup::neg_lt(e, d, ed), ed, h)
}

}

// ---------------------------------------------------------------------------
// The ordered semiring.

// A located monoid whose `+` is the additive monoid of a commutative
// semiring (`semiring`'s `CommSemiring`), with `0 < 1` and multiplication by
// a positive factor keeping and reflecting `<`. These are the forms `Nat`
// has: with no subtraction, `mul_pos` alone does not give monotonicity, so
// the monotone forms are the laws and the signs of products are theorems.
// The reflection is strong extensionality of `*` at a positive factor, a
// constructive law of its own: the other laws only refute `y ≤ x`, which is
// not a gap. The product's laws are reached through the `multiplicative`
// and `commutative` tags; one is `A.multiplicative.unit`.
//
// The class is commutative and located, as every carrier here is; no
// consumer has asked for a weaker one.
class OrderedSemiring<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A, mul as *: A → A → A)
    extends LocatedAddMonoid<A>(same, lt, le, add), CommSemiring<A>(same, add, mul)
{
    zero_lt_one: unit < multiplicative.unit,
    mul_lt_l: (x, y, z: A) → x < y → unit < z → z * x < z * y,
    mul_lt_reflect_l: (x, y, z: A) → unit < z → z * x < z * y → x < y,
}

section<A: OrderedSemiring(≈, <, <=, +, *)> {

// Products respect `≈` on both sides: the multiplicative semigroup's
// `Respects2`, reached through the tag.
theorem OrderedSemiring::mul_respects(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2):
    x * y ≈ x2 * y2
{
    A.multiplicative.respects2(x, x2, hx, y, y2, hy)
}

theorem OrderedSemiring::one_apart_zero(): ApartBy(<, A.multiplicative.unit, A.unit) {
    Inr(A.zero_lt_one)
}

// The class's laws as theorems a tactic can look up by name, and their
// right-hand forms by commutativity.
theorem OrderedSemiring::mul_lt_mono_l(x, y, z: A, h: x < y, hz: A.unit < z): z * x < z * y {
    A.mul_lt_l(x, y, z, h, hz)
}

theorem OrderedSemiring::mul_lt_mono_r(x, y, z: A, h: x < y, hz: A.unit < z): x * z < y * z {
    A.lt_respects(z * x, x * z, z * y, y * z, A.commutative.comm(z, x), A.commutative.comm(z, y), A.mul_lt_l(x, y, z, h, hz))
}

theorem OrderedSemiring::mul_lt_cancel_l(x, y, z: A, hz: A.unit < z, h: z * x < z * y): x < y {
    A.mul_lt_reflect_l(x, y, z, hz, h)
}

theorem OrderedSemiring::mul_lt_cancel_r(x, y, z: A, hz: A.unit < z, h: x * z < y * z): x < y {
    A.mul_lt_reflect_l(x, y, z, hz, A.lt_respects(x * z, z * x, y * z, z * y, A.commutative.comm(x, z), A.commutative.comm(y, z), h))
}

// Cancelling a positive factor (issues/cancellative-algebra-api.md). The
// side condition is a hypothesis, never a class: a semiring with zero is not
// cancellative, and what licenses the step is the factor's sign. The proof
// is the reflection law read twice: a gap between `x` and `y` would scale to
// a gap between the products, which the equation denies.
theorem OrderedSemiring::mul_cancel_pos_l(x, y, z: A, hz: A.unit < z, h: z * x ≈ z * y): x ≈ y {
    A.lt_tight(x, y,
        λ l => StrictOrder::not_apart_of_same(z * x, z * y, h, Inl(A.mul_lt_l(x, y, z, l, hz))),
        λ g => StrictOrder::not_apart_of_same(z * x, z * y, h, Inr(A.mul_lt_l(y, x, z, g, hz))))
}

theorem OrderedSemiring::mul_cancel_pos_r(x, y, z: A, hz: A.unit < z, h: x * z ≈ y * z): x ≈ y {
    OrderedSemiring::mul_cancel_pos_l(x, y, z, hz,
        A.rel_trans(z * x, x * z, z * y, A.commutative.comm(z, x), A.rel_trans(x * z, y * z, z * y, h, A.commutative.comm(y, z))))
}

theorem OrderedSemiring::mul_le_cancel_pos_l(x, y, z: A, hz: A.unit < z, h: z * x <= z * y): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.not_lt_of_le(z * x, z * y, h, A.mul_lt_l(y, x, z, yx, hz)))
}

theorem OrderedSemiring::mul_le_cancel_pos_r(x, y, z: A, hz: A.unit < z, h: x * z <= y * z): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.not_lt_of_le(x * z, y * z, h, OrderedSemiring::mul_lt_mono_r(y, x, z, yx, hz)))
}

// Cross-multiplication is transitive through a positive middle factor, the
// forcing customer of the cancellation kit: `a/b ≈ c/d` and `c/d ≈ e/f`
// (each `≈` read as `a·d ≈ c·b`) give `a/b ≈ e/f` once `d` is positive.
// Multiply the goal by `d`; the two hypotheses rearrange each side into the
// other; cancel `d`. `Rat::same_trans` is this at `Int`.
theorem OrderedSemiring::cross_same_trans(a, b, c, d, e, f: A, hd: A.unit < d,
    h1: a * d ≈ c * b, h2: c * f ≈ e * d): a * f ≈ e * b
{
    let m = A.multiplicative;
    let swap = λ (u: A) (v: A) => A.commutative.comm(u, v);
    let scaled: (d * (a * f) ≈ d * (e * b)) = calc {
        d * (a * f) ≈ (d * a) * f := A.rel_sym((d * a) * f, d * (a * f), m.assoc(d, a, f)),
        ≈ (a * d) * f := OrderedSemiring::mul_respects(d * a, a * d, f, f, swap(d, a), A.rel_refl(f)),
        ≈ (c * b) * f := OrderedSemiring::mul_respects(a * d, c * b, f, f, h1, A.rel_refl(f)),
        ≈ (b * c) * f := OrderedSemiring::mul_respects(c * b, b * c, f, f, swap(c, b), A.rel_refl(f)),
        ≈ b * (c * f) := m.assoc(b, c, f),
        ≈ b * (e * d) := OrderedSemiring::mul_respects(b, b, c * f, e * d, A.rel_refl(b), h2),
        ≈ b * (d * e) := OrderedSemiring::mul_respects(b, b, e * d, d * e, A.rel_refl(b), swap(e, d)),
        ≈ (b * d) * e := A.rel_sym((b * d) * e, b * (d * e), m.assoc(b, d, e)),
        ≈ (d * b) * e := OrderedSemiring::mul_respects(b * d, d * b, e, e, swap(b, d), A.rel_refl(e)),
        ≈ d * (b * e) := m.assoc(d, b, e),
        ≈ d * (e * b) := OrderedSemiring::mul_respects(d, d, b * e, e * b, A.rel_refl(d), swap(b, e)),
    };
    OrderedSemiring::mul_cancel_pos_l(a * f, e * b, d, hd, scaled)
}

// A product of positives is positive: x·0 < x·y.
theorem OrderedSemiring::mul_pos(x, y: A, hx: A.unit < x, hy: A.unit < y): A.unit < x * y {
    StrictOrder::lt_respects_l(x * A.unit, A.unit, x * y, A.mul_zero(x), A.mul_lt_l(A.unit, y, x, hy, hx))
}

// A positive factor reflects the product's sign: x·0 < x·y.
theorem OrderedSemiring::pos_of_mul_pos(x, y: A, hx: A.unit < x, h: A.unit < x * y): A.unit < y {
    A.mul_lt_reflect_l(A.unit, y, x, hx, StrictOrder::lt_respects_l(A.unit, x * A.unit, x * y, A.rel_sym(x * A.unit, A.unit, A.mul_zero(x)), h))
}

// A negative product with a positive factor has a negative other factor:
// z·e < 0·e.
theorem OrderedSemiring::neg_of_mul_neg(z, e: A, he: A.unit < e, h: z * e < A.unit): z < A.unit {
    OrderedSemiring::mul_lt_cancel_r(z, A.unit, e, he, StrictOrder::lt_respects_r(z * e, A.unit, A.unit * e, A.rel_sym(A.unit * e, A.unit, A.zero_mul(e)), h))
}

// Multiplying by a nonnegative keeps a weak inequality. Were `z·y < z·x`, a
// positive `z` would reflect it to `y < x`, so `z` is not positive; nor is
// it negative, so it is zero by tightness, and then both products are zero.
// The conclusion is a refutation, so nothing about `z` is decided.
theorem OrderedSemiring::mul_le_mono_l(x, y, z: A, h: x <= y, hz: A.unit <= z): z * x <= z * y {
    A.le_of_not_lt(z * x, z * y, λ back => {
        let not_pos: ¬(A.unit < z) = λ pz => A.not_lt_of_le(x, y, h, A.mul_lt_reflect_l(y, x, z, pz, back));
        let zero: (z ≈ A.unit) = A.lt_tight(z, A.unit, A.not_lt_of_le(A.unit, z, hz), not_pos);
        let vanish = λ (w: A) => A.rel_trans(z * w, A.unit * w, A.unit,
            OrderedSemiring::mul_respects(z, A.unit, w, w, zero, A.rel_refl(w)), A.zero_mul(w));
        A.lt_irrefl(A.unit, A.lt_respects(z * y, A.unit, z * x, A.unit, vanish(y), vanish(x), back))
    })
}

theorem OrderedSemiring::mul_le_mono_r(x, y, z: A, h: x <= y, hz: A.unit <= z): x * z <= y * z {
    StrictOrder::le_respects(z * x, x * z, z * y, y * z, A.commutative.comm(z, x), A.commutative.comm(z, y), OrderedSemiring::mul_le_mono_l(x, y, z, h, hz))
}

// A product of nonnegatives is nonnegative.
theorem OrderedSemiring::mul_nonneg(x, y: A, hx: A.unit <= x, hy: A.unit <= y): A.unit <= x * y {
    StrictOrder::le_respects(x * A.unit, A.unit, x * y, x * y, A.mul_zero(x), A.rel_refl(x * y), OrderedSemiring::mul_le_mono_l(A.unit, y, x, hy, hx))
}

// Both factors moved, both nonnegative below.
theorem OrderedSemiring::mul_le_mul(a, b, c, d: A, h1: a <= b, h2: c <= d, ha: A.unit <= a, hc: A.unit <= c): a * c <= b * d {
    PseudoOrder::le_trans(a * c, b * c, b * d, OrderedSemiring::mul_le_mono_r(a, b, c, h1, hc),
        OrderedSemiring::mul_le_mono_l(c, d, b, h2, PseudoOrder::le_trans(A.unit, a, b, ha, h1)))
}

// A nonnegative factor of a positive product makes the other factor
// positive. The reflection law asks for a positive factor; a nonnegative
// one is placed by cotransitivity: either (z + 1)·d is positive too, and
// z + 1 is, or z·d + d < z·d puts d below zero, and then z·d ≤ z·0.
theorem OrderedSemiring::pos_of_mul_pos_nonneg(z, d: A, hz: A.unit <= z, h: A.unit < z * d): A.unit < d {
    match A.rel_cotrans(A.unit, z * d, z * d + d, h) {
        Inl(above) => {
            let spread = calc {
                (z + A.multiplicative.unit) * d ≈ z * d + A.multiplicative.unit * d := A.distrib_r(z, A.multiplicative.unit, d),
                ≈ z * d + d := OrderedAddMonoid::add_respects(z * d, z * d, A.multiplicative.unit * d, d, A.rel_refl(z * d), A.multiplicative.unit_l(d)),
            };
            let shifted: (A.unit < z + A.multiplicative.unit) = PseudoOrder::lt_of_lt_of_le(A.unit, A.multiplicative.unit, z + A.multiplicative.unit, A.zero_lt_one,
                StrictOrder::le_respects(A.unit + A.multiplicative.unit, A.multiplicative.unit, z + A.multiplicative.unit, z + A.multiplicative.unit,
                    A.unit_l(A.multiplicative.unit), A.rel_refl(z + A.multiplicative.unit), OrderedAddMonoid::add_le_mono_r(A.unit, z, A.multiplicative.unit, hz)));
            OrderedSemiring::pos_of_mul_pos(z + A.multiplicative.unit, d, shifted,
                StrictOrder::lt_respects_r(A.unit, z * d + d, (z + A.multiplicative.unit) * d, A.rel_sym((z + A.multiplicative.unit) * d, z * d + d, spread), above))
        },
        Inr(below) => {
            let negative: (d < A.unit) = OrderedAddMonoid::add_lt_cancel_l(d, A.unit, z * d,
                StrictOrder::lt_respects_r(z * d + d, z * d, z * d + A.unit, A.rel_sym(z * d + A.unit, z * d, A.unit_r(z * d)), below));
            let capped: (z * d <= A.unit) = StrictOrder::le_respects(z * d, z * d, z * A.unit, A.unit, A.rel_refl(z * d), A.mul_zero(z),
                OrderedSemiring::mul_le_mono_l(d, A.unit, z, StrictOrder::le_of_lt(d, A.unit, negative), hz));
            false_elim(A.not_lt_of_le(z * d, A.unit, capped, h))
        },
    }
}

}

// ---------------------------------------------------------------------------
// The ordered ring.

// An ordered semiring whose `+` is a group: the semiring and the located
// group together, with nothing new. What negation adds is the sign of a
// square and multiplication by a nonpositive factor.
class OrderedRing<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A, mul as *: A → A → A)
    extends OrderedSemiring<A>(same, lt, le, add, mul), LocatedAddGroup<A>(same, lt, le, add), CommRing<A>(same, add, mul)
{}

section<A: OrderedRing(≈, <, <=, +, *)> {

// Multiplying by a nonpositive reverses a weak inequality: negate the
// factor, multiply, and negate back.
theorem OrderedRing::mul_le_mono_l_nonpos(x, y, z: A, h: x <= y, hz: z <= A.unit): z * y <= z * x {
    let nz: (A.unit <= A.inv(z)) = StrictOrder::le_of_same_l(A.unit, A.inv(A.unit), A.inv(z), A.rel_sym(A.inv(A.unit), A.unit, OrderedAddGroup::neg_zero()), LocatedAddGroup::neg_le(z, A.unit, hz));
    let flipped: (A.inv(A.inv(z) * y) <= A.inv(A.inv(z) * x)) = LocatedAddGroup::neg_le(A.inv(z) * x, A.inv(z) * y, OrderedSemiring::mul_le_mono_l(x, y, A.inv(z), h, nz));
    let back = λ (w: A) => A.rel_trans(A.inv(A.inv(z) * w), A.inv(A.inv(z * w)), z * w,
        A.inv_respects(A.inv(z) * w, A.inv(z * w), Ring::neg_mul(z, w)), GroupRel::inv_inv(+, z * w));
    StrictOrder::le_respects(A.inv(A.inv(z) * y), z * y, A.inv(A.inv(z) * x), z * x, back(y), back(x), flipped)
}

theorem OrderedRing::mul_le_mono_r_nonpos(x, y, z: A, h: x <= y, hz: z <= A.unit): y * z <= x * z {
    StrictOrder::le_respects(z * y, y * z, z * x, x * z, A.commutative.comm(z, y), A.commutative.comm(z, x), OrderedRing::mul_le_mono_l_nonpos(x, y, z, h, hz))
}

// Cancelling a factor apart from zero, the constructive "nonzero": a
// negative factor is a positive one negated, so its products are the
// positive one's negated, and negation cancels. `¬(z ≈ 0)` would not do at
// the reals, which cannot turn it into a sign; at a decidable carrier the two
// agree, and `Int::mul_cancel_l` takes `z ≠ 0` there.
theorem OrderedRing::mul_cancel_apart_l(x, y, z: A, hz: ApartBy(<, z, A.unit), h: z * x ≈ z * y): x ≈ y {
    match hz {
        Inl(neg) => {
            let nz = A.inv(z);
            let flipped: (nz * x ≈ nz * y) = calc {
                nz * x ≈ A.inv(z * x) := Ring::neg_mul(z, x),
                ≈ A.inv(z * y) := A.inv_respects(z * x, z * y, h),
                ≈ nz * y := A.rel_sym(nz * y, A.inv(z * y), Ring::neg_mul(z, y)),
            };
            OrderedSemiring::mul_cancel_pos_l(x, y, nz, OrderedAddGroup::neg_pos(z, neg), flipped)
        },
        Inr(pos) => OrderedSemiring::mul_cancel_pos_l(x, y, z, pos, h),
    }
}

theorem OrderedRing::mul_cancel_apart_r(x, y, z: A, hz: ApartBy(<, z, A.unit), h: x * z ≈ y * z): x ≈ y {
    OrderedRing::mul_cancel_apart_l(x, y, z, hz,
        A.rel_trans(z * x, x * z, z * y, A.commutative.comm(z, x), A.rel_trans(x * z, y * z, z * y, h, A.commutative.comm(y, z))))
}

// A square is nonnegative, with no decision on the sign of `x`: were `x·x`
// negative, `x < 0` would make it the positive `(-x)·(-x)`, so `0 ≤ x`, and
// then `x·x` is a product of nonnegatives after all.
theorem OrderedRing::sq_nonneg(x: A): A.unit <= x * x {
    A.le_of_not_lt(A.unit, x * x, λ neg => {
        let not_below: ¬(x < A.unit) = λ below => {
            let flipped: (A.unit < A.inv(x) * A.inv(x)) =
                OrderedSemiring::mul_pos(A.inv(x), A.inv(x), OrderedAddGroup::neg_pos(x, below), OrderedAddGroup::neg_pos(x, below));
            A.lt_irrefl(A.unit, A.lt_trans(A.unit, x * x, A.unit,
                StrictOrder::lt_respects_r(A.unit, A.inv(x) * A.inv(x), x * x, Ring::neg_mul_neg(x, x), flipped), neg))
        };
        let up: (A.unit <= x) = A.le_of_not_lt(A.unit, x, not_below);
        A.not_lt_of_le(A.unit, x * x, OrderedSemiring::mul_nonneg(x, x, up, up), neg)
    })
}

}

// ---------------------------------------------------------------------------
// The field.

// An ordered ring with a reciprocal on exactly the elements apart from zero
// and the Archimedean property: every element is below some natural number.
// The ring's laws and the order's are its parents', so every `Ring` and
// `OrderedRing` theorem applies to an ordered field.
//
// The reciprocal is `recip`, not `inv`: `inv` is the additive group's
// negation, inherited untagged. The reciprocal's sign and the Archimedean
// property's reciprocal form follow from the semiring's reflection law.
// `of_nat` is a field, with its two defining laws, so a carrier keeps its own
// embedding (`Rat::ofInt`, `CReal::ofRat`) and the law speaks of it.
class OrderedField<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A, mul as *: A → A → A)
    extends OrderedRing<A>(same, lt, le, add, mul)
{
    of_nat: Nat → A,
    recip: (x: A) → ApartBy(lt, x, unit) → A,
    mul_recip: (x: A) → (h: ApartBy(lt, x, unit)) → x * recip(x, h) ≈ multiplicative.unit,
    of_nat_zero: of_nat(Zero) ≈ unit,
    of_nat_succ: (n: Nat) → of_nat(Succ(n)) ≈ of_nat(n) + multiplicative.unit,
    archimedean: (x: A) → ∃ n: Nat, x < of_nat(n),
}

section<A: OrderedField(≈, <, <=, +, *)> {

// The inverse is unique, whichever apartness proof built it.
theorem OrderedField::recip_unique(x: A, h: ApartBy(<, x, A.unit), u: A, hu: x * u ≈ A.multiplicative.unit):
    u ≈ A.recip(x, h)
{
    calc {
        u ≈ u * A.multiplicative.unit := A.rel_sym(u * A.multiplicative.unit, u, A.multiplicative.unit_r(u)),
        ≈ u * (x * A.recip(x, h)) := OrderedSemiring::mul_respects(u, u, A.multiplicative.unit, x * A.recip(x, h), A.rel_refl(u),
            A.rel_sym(x * A.recip(x, h), A.multiplicative.unit, A.mul_recip(x, h))),
        ≈ (u * x) * A.recip(x, h) := A.rel_sym((u * x) * A.recip(x, h), u * (x * A.recip(x, h)), A.multiplicative.assoc(u, x, A.recip(x, h))),
        ≈ (x * u) * A.recip(x, h) := OrderedSemiring::mul_respects(u * x, x * u, A.recip(x, h), A.recip(x, h), A.commutative.comm(u, x), A.rel_refl(A.recip(x, h))),
        ≈ A.multiplicative.unit * A.recip(x, h) := OrderedSemiring::mul_respects(x * u, A.multiplicative.unit, A.recip(x, h), A.recip(x, h), hu, A.rel_refl(A.recip(x, h))),
        ≈ A.recip(x, h) := A.multiplicative.unit_l(A.recip(x, h)),
    }
}

theorem OrderedField::recip_respects(x, x2: A, h: ApartBy(<, x, A.unit), h2: ApartBy(<, x2, A.unit),
    hx: x ≈ x2): A.recip(x, h) ≈ A.recip(x2, h2)
{
    OrderedField::recip_unique(x2, h2, A.recip(x, h), A.rel_trans(x2 * A.recip(x, h), x * A.recip(x, h), A.multiplicative.unit,
        OrderedSemiring::mul_respects(x2, x, A.recip(x, h), A.recip(x, h), A.rel_sym(x, x2, hx), A.rel_refl(A.recip(x, h))),
        A.mul_recip(x, h)))
}

theorem OrderedField::recip_mul(x: A, h: ApartBy(<, x, A.unit)): A.recip(x, h) * x ≈ A.multiplicative.unit {
    A.rel_trans(A.recip(x, h) * x, x * A.recip(x, h), A.multiplicative.unit, A.commutative.comm(A.recip(x, h), x), A.mul_recip(x, h))
}

// The embedded naturals climb by one at each step.
theorem OrderedField::of_nat_lt_succ(n: Nat): A.of_nat(n) < A.of_nat(Succ(n)) {
    A.lt_respects(A.of_nat(n) + A.unit, A.of_nat(n), A.of_nat(n) + A.multiplicative.unit, A.of_nat(Succ(n)),
        A.unit_r(A.of_nat(n)), A.rel_sym(A.of_nat(Succ(n)), A.of_nat(n) + A.multiplicative.unit, A.of_nat_succ(n)),
        OrderedAddMonoid::add_lt_mono_l(A.unit, A.multiplicative.unit, A.of_nat(n), A.zero_lt_one))
}

theorem OrderedField::of_nat_pos(n: Nat): A.unit < A.of_nat(Succ(n)) {
    match n {
        Zero => StrictOrder::lt_respects_l(A.of_nat(Zero), A.unit, A.of_nat(Succ(Zero)), A.of_nat_zero, OrderedField::of_nat_lt_succ(Zero)),
        Succ(m) => A.lt_trans(A.unit, A.of_nat(Succ(m)), A.of_nat(Succ(Succ(m))), OrderedField::of_nat_pos(m),
            OrderedField::of_nat_lt_succ(Succ(m))),
    }
}

// ---------------------------------------------------------------------------
// The inverse's sign, from the reflection law: x · x⁻¹ ≈ 1 is positive, so
// x⁻¹ has the sign of x.

theorem OrderedField::recip_pos(x: A, h: ApartBy(<, x, A.unit), hx: A.unit < x):
    A.unit < A.recip(x, h)
{
    OrderedSemiring::pos_of_mul_pos(x, A.recip(x, h), hx, StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, x * A.recip(x, h),
        A.rel_sym(x * A.recip(x, h), A.multiplicative.unit, A.mul_recip(x, h)), A.zero_lt_one))
}

// A negative x: -x is positive and (-x) · (-x⁻¹) ≈ 1, so -x⁻¹ is positive.
theorem OrderedField::recip_neg(x: A, h: ApartBy(<, x, A.unit), hx: x < A.unit):
    A.recip(x, h) < A.unit
{
    let u = A.recip(x, h);
    let one: (A.inv(x) * A.inv(u) ≈ A.multiplicative.unit) = A.rel_trans(A.inv(x) * A.inv(u), x * u, A.multiplicative.unit,
        Ring::neg_mul_neg(x, u), A.mul_recip(x, h));
    let product: (A.unit < A.inv(x) * A.inv(u)) = StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, A.inv(x) * A.inv(u),
        A.rel_sym(A.inv(x) * A.inv(u), A.multiplicative.unit, one), A.zero_lt_one);
    OrderedAddGroup::neg_of_neg_pos(u, OrderedSemiring::pos_of_mul_pos(A.inv(x), A.inv(u), OrderedAddGroup::neg_pos(x, hx), product))
}

// The inverse undoes itself, at any proofs of the two apartnesses.
theorem OrderedField::recip_recip(x: A, h: ApartBy(<, x, A.unit), h2: ApartBy(<, A.recip(x, h), A.unit)):
    A.recip(A.recip(x, h), h2) ≈ x
{
    A.rel_sym(x, A.recip(A.recip(x, h), h2), OrderedField::recip_unique(A.recip(x, h), h2, x, OrderedField::recip_mul(x, h)))
}

// Inversion reverses the order of positives: multiply x < y by the positive
// x⁻¹ · y⁻¹, and each side cancels to the other's inverse.
theorem OrderedField::recip_lt_recip(x, y: A, hx: ApartBy(<, x, A.unit), hy: ApartBy(<, y, A.unit),
    px: A.unit < x, h: x < y): A.recip(y, hy) < A.recip(x, hx)
{
    let u = A.recip(x, hx);
    let v = A.recip(y, hy);
    let w = u * v;
    let pw: (A.unit < w) = OrderedSemiring::mul_pos(u, v, OrderedField::recip_pos(x, hx, px),
        OrderedField::recip_pos(y, hy, A.lt_trans(A.unit, x, y, px, h)));
    let left = calc {
        x * w ≈ (x * u) * v := A.rel_sym((x * u) * v, x * w, A.multiplicative.assoc(x, u, v)),
        ≈ A.multiplicative.unit * v := OrderedSemiring::mul_respects(x * u, A.multiplicative.unit, v, v, A.mul_recip(x, hx), A.rel_refl(v)),
        ≈ v := A.multiplicative.unit_l(v),
    };
    let right = calc {
        y * w ≈ y * (v * u) := OrderedSemiring::mul_respects(y, y, w, v * u, A.rel_refl(y), A.commutative.comm(u, v)),
        ≈ (y * v) * u := A.rel_sym((y * v) * u, y * (v * u), A.multiplicative.assoc(y, v, u)),
        ≈ A.multiplicative.unit * u := OrderedSemiring::mul_respects(y * v, A.multiplicative.unit, u, u, A.mul_recip(y, hy), A.rel_refl(u)),
        ≈ u := A.multiplicative.unit_l(u),
    };
    A.lt_respects(x * w, v, y * w, u, left, right, OrderedSemiring::mul_lt_mono_r(x, y, w, h, pw))
}

// The Archimedean property's inverse form: a positive x is above some
// 1/(n+1). Its inverse is below some natural n, so below n + 1, and
// inverting reverses that.
theorem OrderedField::archimedean_recip(x: A, hx: A.unit < x):
    ∃ n: Nat, A.recip(A.of_nat(Succ(n)), Inr(OrderedField::of_nat_pos(n))) < x
{
    let h: ApartBy(<, x, A.unit) = Inr(hx);
    let u = A.recip(x, h);
    let pu: (A.unit < u) = OrderedField::recip_pos(x, h, hx);
    match A.archimedean(u) {
        Exists(n, below) => {
            let big = A.of_nat(Succ(n));
            let pbig: (A.unit < big) = OrderedField::of_nat_pos(n);
            let flipped: (A.recip(big, Inr(pbig)) < A.recip(u, Inr(pu))) = OrderedField::recip_lt_recip(u, big, Inr(pu), Inr(pbig), pu,
                A.lt_trans(u, A.of_nat(n), big, below, OrderedField::of_nat_lt_succ(n)));
            Exists(n, StrictOrder::lt_respects_r(A.recip(big, Inr(pbig)), A.recip(u, Inr(pu)), x, OrderedField::recip_recip(x, h, Inr(pu)), flipped))
        },
    }
}

}

// ---------------------------------------------------------------------------
// The integers every ring has (semiring's `Ring::int_cast`), named at an
// ordered field: what `linarith` puts in scope at a class carrier
// (`section<K: OrderedField(…)>`) with no carrier instance
// (issues/cast-reading-at-class-carrier.md). The certificate lemmas'
// constraint, `OrderedField(…) + CommRingOfInt(…)`, is one dictionary
// assembled from this and the section's own
// (issues/constraints-sharing-indices.md). Here rather than as
// `CommRing::with_ints<K>()` at the call so that the call's implicit
// arguments name the field's `≈`, `<` and `<=` as the section binds them.
section<A: OrderedField(≈, <, <=, +, *)> {

fn OrderedField::with_ints() → CommRingOfInt<A>(≈, +, *) {
    CommRing::with_ints()
}

}

// ---------------------------------------------------------------------------
// The integers and the naturals.

// `Nat` is an ordered semiring and `Int` an ordered ring, at `RelId` (their
// `≈`, as in `semiring`). Both decide their orders, so each law is a case
// split or `omega`; the products' laws are the carriers' own
// (`Nat::mul_lt_mono_l`, `Int::lt_of_mul_lt_mul_l`). Every theorem above
// that stops short of the field reads at both, `LocatedAddMonoid::range_le`
// and `OrderedSemiring::mul_le_mul` among them.

instance StrictOrder<Nat>(RelId<Nat>, Nat::Lt, Nat::Le) {
    lt_irrefl := Nat::lt_irrefl,
    lt_trans := Nat::lt_trans,
    lt_respects := λ x x2 y y2 hx hy h => subst(hx, subst(hy, h)),
    lt_tight := λ x y h1 h2 => match x.lt_trichotomy(y) {
        Inl(l) => false_elim(h1(l)),
        Inr(r) => match r { Inl(e) => e, Inr(g) => false_elim(h2(g)) },
    },
    le_of_not_lt := λ x y h => Nat::le_of_not_lt(y, x, h),
    not_lt_of_le := λ x y h back => y.lt_irrefl(Nat::lt_of_lt_of_le(y, x, y, back, h)),
}

instance Cotransitive<Nat>(Nat::Lt) {
    rel_cotrans := λ x y z h => match x.lt_or_ge(z) {
        Inl(l) => Inl(l),
        Inr(ge) => Inr(omega(ge, h)),
    },
}

instance OrderedAddMonoid<Nat>(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add) {
    add_lt_mono_r := λ x y z h => omega(h),
    add_lt_reflect_r := λ x y z h => omega(h),
}

instance LocatedAddMonoid<Nat>(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add) {}

instance OrderedSemiring<Nat>(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add, Nat::mul) {
    zero_lt_one := Nat::lt_succ_self(0),
    mul_lt_l := λ x y z h hz => z.mul_lt_mono_l(x, y, hz, h),
    mul_lt_reflect_l := λ x y z hz h => z.lt_of_mul_lt_mul_l(x, y, h),
}

instance StrictOrder<Int>(RelId<Int>, Int::Lt, Int::Le) {
    lt_irrefl := Int::lt_irrefl,
    lt_trans := Int::lt_trans,
    lt_respects := λ x x2 y y2 hx hy h => subst(hx, subst(hy, h)),
    lt_tight := λ x y h1 h2 => match x.lt_trichotomy(y) {
        Inl(l) => false_elim(h1(l)),
        Inr(r) => match r { Inl(e) => e, Inr(g) => false_elim(h2(g)) },
    },
    le_of_not_lt := λ x y h => Int::le_of_not_lt(y, x, h),
    not_lt_of_le := Int::not_lt_of_ge,
}

instance Cotransitive<Int>(Int::Lt) {
    rel_cotrans := λ x y z h => match x.lt_trichotomy(z) {
        Inl(l) => Inl(l),
        Inr(r) => Inr(omega(r, h)),
    },
}

instance OrderedAddGroup<Int>(RelId<Int>, Int::Lt, Int::Le, Int::add) {
    add_lt_mono_r := λ x y z h => omega(h),
    add_lt_reflect_r := λ x y z h => omega(h),
}

instance LocatedAddGroup<Int>(RelId<Int>, Int::Lt, Int::Le, Int::add) {}

instance OrderedRing<Int>(RelId<Int>, Int::Lt, Int::Le, Int::add, Int::mul) {
    zero_lt_one := OfNat(0).lt_isucc_self(),
    mul_lt_l := λ x y z h hz => x.mul_lt_mono_l(y, z, h, hz),
    mul_lt_reflect_l := λ x y z hz h => x.lt_of_mul_lt_mul_l(y, z, hz, h),
}

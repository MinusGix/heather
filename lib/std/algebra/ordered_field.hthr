// The constructive ordered field, as layers of classes over a setoid
// (issues/constructive-ordered-field-interface.md;
// docs/constructive-ordered-field-design.md).
//
// Nothing here decides anything. Equality is a setoid `≈`, never `=`; the
// strict order `<` is primitive (at both carriers it is positive data, a
// gap); `≤` is an index characterised as `¬(y < x)`, Bishop's, so a carrier
// may keep its own spelling of it; apartness is `x < y ∨ y < x`; and the
// inverse takes an apartness proof instead of returning a junk value at zero.
// No layer has trichotomy, decidable `≈`, or decidable `≤`.
//
// The layers, weakest first, each with the theorems that need no more:
//
// - `StrictOrder(≈, <, ≤)`: a tight strict order respecting a setoid. Open
//   intervals, apartness's irreflexivity, symmetry and tightness, and `≤`'s
//   reflexivity and antisymmetry live here.
// - `Cotransitive(<)`, the separate capability, and `PseudoOrder`, the two
//   together. Cotransitivity is locatedness: every point is placed on one
//   side or the other of every gap. Transitivity of `≤`, the mixed `<`/`≤`
//   steps and every closed-interval lemma need it.
// - `OrderedAddGroup(≈, <, ≤, +)`: a strict order and an abelian group under
//   `+` (modulo `≈`, `algebra_rel`'s `GroupRel`) with translation-invariant
//   `<`. Absolute-value bounds are stated as predicates (`AbsLt(x, e)` is the
//   open interval `(-e, e)`), so no carrier has to compute an absolute value
//   or a maximum.
// - `LocatedAddGroup`, the two above together: positivity of a bound, a sum
//   splitting a gap between its summands, and the `≤` forms of the bounds.
// - `OrderedField(≈, <, ≤, +, *)`: a located group that is a commutative
//   ring (`semiring`'s `CommRing`), with a reciprocal on elements apart from
//   zero, products of positives positive, a positive factor reflecting a
//   product's sign, and the Archimedean property over an embedding of `Nat`.
//   The reciprocal's sign, the order reversal of inversion and the
//   Archimedean property's reciprocal form (`archimedean_recip`) are derived
//   here.
//
// The algebra is the ring layers', not restated: zero is `A.unit`, negation
// `A.inv`, one `A.multiplicative.unit`, and every `GroupRel`, `Ring` and
// `Semiring` theorem applies to these layers
// (issues/ordered-field-over-comm-ring.md).
//
// Points are explicit arguments: a generic theorem's indices are filled from
// its carrier, and the carrier is read off the first point. Theorems are
// owned by the weakest class they need (`StrictOrder::le_antisymm`,
// `PseudoOrder::le_trans`), so the name says which structure a client must
// have.

import logic;
import nat;
import relation_props;
import algebra_rel;
import semiring;

// ---------------------------------------------------------------------------
// Relations built from the strict order.

// Apartness: one is strictly below the other. Positive information, never
// `¬(x ≈ y)`.
fn ApartBy<A>(lt: A → A → Type, x, y: A) → Type { lt(x, y) ∨ lt(y, x) }

// The open interval (a, b) and the closed interval [a, b].
fn Between<A>(lt: A → A → Type, a, x, b: A) → Type { lt(a, x) ∧ lt(x, b) }

fn Within<A>(le: A → A → Type, a, x, b: A) → Type { le(a, x) ∧ le(x, b) }

// ---------------------------------------------------------------------------
// The strict order.

// A strict order modulo `≈`: irreflexive, transitive, invariant under `≈` on
// both sides, and tight (two points neither of which is below the other are
// the same). `≤` is whatever the carrier calls it, provided it means
// `¬(y < x)`. The `<` laws are fields of their own rather than the
// `Irreflexive`/`Transitive` parents: those would put `Transitive` at two
// indices (`≈`'s and `<`'s) into one dictionary.
class StrictOrder<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type)
    extends Equivalence<A>(same)
{
    lt_irrefl: (x: A) → ¬(x < x),
    lt_trans: (x, y, z: A) → x < y → y < z → x < z,
    lt_respects: (x, x2, y, y2: A) → x ≈ x2 → y ≈ y2 → x < y → x2 < y2,
    lt_tight: (x, y: A) → ¬(x < y) → ¬(y < x) → x ≈ y,
    le_of_not_lt: (x, y: A) → ¬(y < x) → x <= y,
    not_lt_of_le: (x, y: A) → x <= y → ¬(y < x),
}

theorem StrictOrder::lt_asymm<A: StrictOrder(≈, <, <=)>(x, y: A, h: x < y): ¬(y < x) {
    λ back => A.lt_irrefl(x, A.lt_trans(x, y, x, h, back))
}

theorem StrictOrder::lt_respects_l<A: StrictOrder(≈, <, <=)>(x, x2, y: A, hx: x ≈ x2, h: x < y): x2 < y {
    A.lt_respects(x, x2, y, y, hx, A.rel_refl(y), h)
}

theorem StrictOrder::lt_respects_r<A: StrictOrder(≈, <, <=)>(x, y, y2: A, hy: y ≈ y2, h: x < y): x < y2 {
    A.lt_respects(x, x, y, y2, A.rel_refl(x), hy, h)
}

theorem StrictOrder::le_refl<A: StrictOrder(≈, <, <=)>(x: A): x <= x {
    A.le_of_not_lt(x, x, A.lt_irrefl(x))
}

theorem StrictOrder::le_of_lt<A: StrictOrder(≈, <, <=)>(x, y: A, h: x < y): x <= y {
    A.le_of_not_lt(x, y, StrictOrder::lt_asymm(x, y, h))
}

theorem StrictOrder::le_of_same<A: StrictOrder(≈, <, <=)>(x, y: A, h: x ≈ y): x <= y {
    A.le_of_not_lt(x, y, λ yx => A.lt_irrefl(x, StrictOrder::lt_respects_l(y, x, x, A.rel_sym(x, y, h), yx)))
}

theorem StrictOrder::le_respects<A: StrictOrder(≈, <, <=)>(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2, h: x <= y):
    x2 <= y2
{
    A.le_of_not_lt(x2, y2, λ back => A.not_lt_of_le(x, y, h,
        A.lt_respects(y2, y, x2, x, A.rel_sym(y, y2, hy), A.rel_sym(x, x2, hx), back)))
}

// Antisymmetry of `≤` modulo `≈` is tightness: it never yields `=`.
theorem StrictOrder::le_antisymm<A: StrictOrder(≈, <, <=)>(x, y: A, hxy: x <= y, hyx: y <= x): x ≈ y {
    A.lt_tight(x, y, A.not_lt_of_le(y, x, hyx), A.not_lt_of_le(x, y, hxy))
}

theorem StrictOrder::apart_irrefl<A: StrictOrder(≈, <, <=)>(x: A): ¬(ApartBy(<, x, x)) {
    λ h => match h {
        Inl(l) => A.lt_irrefl(x, l),
        Inr(r) => A.lt_irrefl(x, r),
    }
}

theorem StrictOrder::apart_sym<A: StrictOrder(≈, <, <=)>(x, y: A, h: ApartBy(<, x, y)): ApartBy(<, y, x) {
    match h {
        Inl(l) => Inr(l),
        Inr(r) => Inl(r),
    }
}

theorem StrictOrder::apart_respects<A: StrictOrder(≈, <, <=)>(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2,
    h: ApartBy(<, x, y)): ApartBy(<, x2, y2)
{
    match h {
        Inl(l) => Inl(A.lt_respects(x, x2, y, y2, hx, hy, l)),
        Inr(r) => Inr(A.lt_respects(y, y2, x, x2, hy, hx, r)),
    }
}

// Tightness in apartness's words: what is not apart is the same.
theorem StrictOrder::same_of_not_apart<A: StrictOrder(≈, <, <=)>(x, y: A, h: ¬(ApartBy(<, x, y))): x ≈ y {
    A.lt_tight(x, y, λ l => h(Inl(l)), λ r => h(Inr(r)))
}

theorem StrictOrder::not_apart_of_same<A: StrictOrder(≈, <, <=)>(x, y: A, h: x ≈ y): ¬(ApartBy(<, x, y)) {
    λ a => StrictOrder::apart_irrefl(x, StrictOrder::apart_respects(x, x, y, x, A.rel_refl(x), A.rel_sym(x, y, h), a))
}

// An open interval with a point in it is nonempty in the order: a < b.
theorem StrictOrder::between_lt<A: StrictOrder(≈, <, <=)>(a, x, b: A, h: Between(<, a, x, b)): a < b {
    A.lt_trans(a, x, b, h.left, h.right)
}

theorem StrictOrder::between_respects<A: StrictOrder(≈, <, <=)>(a, x, b, x2: A, hx: x ≈ x2,
    h: Between(<, a, x, b)): Between(<, a, x2, b)
{
    And(StrictOrder::lt_respects_r(a, x, x2, hx, h.left), StrictOrder::lt_respects_l(x, x2, b, hx, h.right))
}

// Widening an open interval by strict steps needs only transitivity; by `≤`
// steps it needs locatedness (`PseudoOrder::between_widen_le`).
theorem StrictOrder::between_widen<A: StrictOrder(≈, <, <=)>(a, x, b, a2, b2: A, ha: a2 < a, hb: b < b2,
    h: Between(<, a, x, b)): Between(<, a2, x, b2)
{
    And(A.lt_trans(a2, a, x, ha, h.left), A.lt_trans(x, b, b2, h.right, hb))
}

theorem StrictOrder::within_of_between<A: StrictOrder(≈, <, <=)>(a, x, b: A, h: Between(<, a, x, b)):
    Within(<=, a, x, b)
{
    And(StrictOrder::le_of_lt(a, x, h.left), StrictOrder::le_of_lt(x, b, h.right))
}

// A point strictly below an open interval is apart from every point in it.
theorem StrictOrder::apart_of_lt_between<A: StrictOrder(≈, <, <=)>(y, a, x, b: A, ya: y < a,
    h: Between(<, a, x, b)): ApartBy(<, y, x)
{
    Inl(A.lt_trans(y, a, x, ya, h.left))
}

// ---------------------------------------------------------------------------
// Locatedness.

// Cotransitivity: a gap x < y places every z, below y or above x. At the
// Cauchy reals this is where approximations are consulted; at the rationals
// it is a decision. It is a capability of its own because a strict order
// can lack it (the Dedekind reals without located cuts), and every theorem
// above was proved without it.
class Cotransitive<A>(R: A → A → Type) {
    rel_cotrans: (x, y, z: A) → R(x, y) → R(x, z) ∨ R(z, y),
}

class PseudoOrder<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type)
    extends StrictOrder<A>(same, lt, le), Cotransitive<A>(lt)
{}

// The located reading of a gap: every point is below its top or above its
// bottom.
theorem PseudoOrder::locate<A: PseudoOrder(≈, <, <=)>(a, b, x: A, h: a < b): a < x ∨ x < b {
    A.rel_cotrans(a, b, x, h)
}

theorem PseudoOrder::lt_of_lt_of_le<A: PseudoOrder(≈, <, <=)>(x, y, z: A, h1: x < y, h2: y <= z): x < z {
    match A.rel_cotrans(x, y, z, h1) {
        Inl(xz) => xz,
        Inr(zy) => false_elim(A.not_lt_of_le(y, z, h2, zy)),
    }
}

theorem PseudoOrder::lt_of_le_of_lt<A: PseudoOrder(≈, <, <=)>(x, y, z: A, h1: x <= y, h2: y < z): x < z {
    match A.rel_cotrans(y, z, x, h2) {
        Inl(yx) => false_elim(A.not_lt_of_le(x, y, h1, yx)),
        Inr(xz) => xz,
    }
}

theorem PseudoOrder::le_trans<A: PseudoOrder(≈, <, <=)>(x, y, z: A, hxy: x <= y, hyz: y <= z): x <= z {
    A.le_of_not_lt(x, z, λ zx => match A.rel_cotrans(z, x, y, zx) {
        Inl(zy) => A.not_lt_of_le(y, z, hyz, zy),
        Inr(yx) => A.not_lt_of_le(x, y, hxy, yx),
    })
}

theorem PseudoOrder::apart_cotrans<A: PseudoOrder(≈, <, <=)>(x, y, z: A, h: ApartBy(<, x, y)):
    ApartBy(<, x, z) ∨ ApartBy(<, z, y)
{
    match h {
        Inl(xy) => match A.rel_cotrans(x, y, z, xy) {
            Inl(xz) => Inl(Inl(xz)),
            Inr(zy) => Inr(Inl(zy)),
        },
        Inr(yx) => match A.rel_cotrans(y, x, z, yx) {
            Inl(yz) => Inr(Inr(yz)),
            Inr(zx) => Inl(Inr(zx)),
        },
    }
}

theorem PseudoOrder::within_le<A: PseudoOrder(≈, <, <=)>(a, x, b: A, h: Within(<=, a, x, b)): a <= b {
    PseudoOrder::le_trans(a, x, b, h.left, h.right)
}

theorem PseudoOrder::within_widen<A: PseudoOrder(≈, <, <=)>(a, x, b, a2, b2: A, ha: a2 <= a, hb: b <= b2,
    h: Within(<=, a, x, b)): Within(<=, a2, x, b2)
{
    And(PseudoOrder::le_trans(a2, a, x, ha, h.left), PseudoOrder::le_trans(x, b, b2, h.right, hb))
}

theorem PseudoOrder::between_widen_le<A: PseudoOrder(≈, <, <=)>(a, x, b, a2, b2: A, ha: a2 <= a, hb: b <= b2,
    h: Between(<, a, x, b)): Between(<, a2, x, b2)
{
    And(PseudoOrder::lt_of_le_of_lt(a2, a, x, ha, h.left), PseudoOrder::lt_of_lt_of_le(x, b, b2, h.right, hb))
}

// A closed interval sits inside any open one around it.
theorem PseudoOrder::between_of_within<A: PseudoOrder(≈, <, <=)>(a, x, b, a2, b2: A, ha: a2 < a, hb: b < b2,
    h: Within(<=, a, x, b)): Between(<, a2, x, b2)
{
    And(PseudoOrder::lt_of_lt_of_le(a2, a, x, ha, h.left), PseudoOrder::lt_of_le_of_lt(x, b, b2, h.right, hb))
}

// ---------------------------------------------------------------------------
// The ordered additive group.

// An abelian group under `+` modulo `≈` whose strict order is invariant
// under translation. The group is `algebra_rel`'s `GroupRel` beside its
// `Commutative` law, untagged, so zero is `A.unit`, negation `A.inv`, and
// `rel_cong` reaches through `+`; every `GroupRel` theorem applies here, and
// only the order's law is new.
class OrderedAddGroup<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends StrictOrder<A>(same, lt, le), GroupRel<A>(same, add), Commutative<A>(same, add)
{
    add_lt_mono_r: (x, y, z: A) → x < y → x + z < y + z,
}

// |x| < e and |x| ≤ e, as the intervals (-e, e) and [-e, e]. Stating the
// bound rather than computing |x| keeps these at carriers with no `abs`.
fn AbsLt<A: OrderedAddGroup(≈, <, <=, +)>(x, e: A) → Type { Between(<, A.inv(e), x, e) }

fn AbsLe<A: OrderedAddGroup(≈, <, <=, +)>(x, e: A) → Type { Within(<=, A.inv(e), x, e) }

// x and y are within e of each other: |x - y| < e.
fn Close<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e: A) → Type { AbsLt(x + A.inv(y), e) }

theorem OrderedAddGroup::add_respects<A: OrderedAddGroup(≈, <, <=, +)>(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2):
    x + y ≈ x2 + y2
{
    A.rel_trans(x + y, x2 + y, x2 + y2, rel_cong(hx), rel_cong(hy))
}

// Cancelling a pair inside a sum, on either side of the pair.
theorem OrderedAddGroup::add_neg_add<A: OrderedAddGroup(≈, <, <=, +)>(x, z: A): x + (A.inv(x) + z) ≈ z {
    calc {
        x + (A.inv(x) + z) ≈ (x + A.inv(x)) + z := A.rel_sym((x + A.inv(x)) + z, x + (A.inv(x) + z), A.assoc(x, A.inv(x), z)),
        ≈ A.unit + z := OrderedAddGroup::add_respects(x + A.inv(x), A.unit, z, z, A.inv_r(x), A.rel_refl(z)),
        ≈ z := A.unit_l(z),
    }
}

theorem OrderedAddGroup::neg_add_add<A: OrderedAddGroup(≈, <, <=, +)>(x, z: A): A.inv(x) + (x + z) ≈ z {
    calc {
        A.inv(x) + (x + z) ≈ (A.inv(x) + x) + z := A.rel_sym((A.inv(x) + x) + z, A.inv(x) + (x + z), A.assoc(A.inv(x), x, z)),
        ≈ A.unit + z := OrderedAddGroup::add_respects(A.inv(x) + x, A.unit, z, z, A.inv_l(x), A.rel_refl(z)),
        ≈ z := A.unit_l(z),
    }
}

theorem OrderedAddGroup::add_neg_cancel_r<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A): (x + y) + A.inv(y) ≈ x {
    calc {
        (x + y) + A.inv(y) ≈ x + (y + A.inv(y)) := A.assoc(x, y, A.inv(y)),
        ≈ x + A.unit := OrderedAddGroup::add_respects(x, x, y + A.inv(y), A.unit, A.rel_refl(x), A.inv_r(y)),
        ≈ x := A.unit_r(x),
    }
}

theorem OrderedAddGroup::sub_add_cancel<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A): (x + A.inv(y)) + y ≈ x {
    calc {
        (x + A.inv(y)) + y ≈ x + (A.inv(y) + y) := A.assoc(x, A.inv(y), y),
        ≈ x + A.unit := OrderedAddGroup::add_respects(x, x, A.inv(y) + y, A.unit, A.rel_refl(x), A.inv_l(y)),
        ≈ x := A.unit_r(x),
    }
}

theorem OrderedAddGroup::neg_zero<A: OrderedAddGroup(≈, <, <=, +)>(x: A): A.inv(A.unit) ≈ A.unit {
    A.rel_sym(A.unit, A.inv(A.unit), GroupRel::inv_unique(+, A.unit, A.unit, A.unit_r(A.unit)))
}

theorem OrderedAddGroup::neg_add<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A): A.inv(x + y) ≈ A.inv(x) + A.inv(y) {
    let cancels = calc {
        (x + y) + (A.inv(x) + A.inv(y)) ≈ (x + A.inv(x)) + (y + A.inv(y)) := CommMonoidRel::interchange(≈, +, x, y, A.inv(x), A.inv(y)),
        ≈ A.unit + A.unit := OrderedAddGroup::add_respects(x + A.inv(x), A.unit, y + A.inv(y), A.unit, A.inv_r(x), A.inv_r(y)),
        ≈ A.unit := A.unit_r(A.unit),
    };
    A.rel_sym(A.inv(x) + A.inv(y), A.inv(x + y), GroupRel::inv_unique(+, x + y, A.inv(x) + A.inv(y), cancels))
}

// (x - y) + (y - z) ≈ x - z.
theorem OrderedAddGroup::sub_add_sub<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A):
    (x + A.inv(y)) + (y + A.inv(z)) ≈ x + A.inv(z)
{
    A.rel_trans((x + A.inv(y)) + (y + A.inv(z)), x + (A.inv(y) + (y + A.inv(z))), x + A.inv(z),
        A.assoc(x, A.inv(y), y + A.inv(z)),
        OrderedAddGroup::add_respects(x, x, A.inv(y) + (y + A.inv(z)), A.inv(z), A.rel_refl(x),
            OrderedAddGroup::neg_add_add(y, A.inv(z))))
}

// -(x - y) ≈ y - x.
theorem OrderedAddGroup::neg_sub<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A): A.inv(x + A.inv(y)) ≈ y + A.inv(x) {
    calc {
        A.inv(x + A.inv(y)) ≈ A.inv(x) + A.inv(A.inv(y)) := OrderedAddGroup::neg_add(x, A.inv(y)),
        ≈ A.inv(x) + y := OrderedAddGroup::add_respects(A.inv(x), A.inv(x), A.inv(A.inv(y)), y, A.rel_refl(A.inv(x)), GroupRel::inv_inv(+, y)),
        ≈ y + A.inv(x) := A.comm(A.inv(x), y),
    }
}

// Order and translation.

theorem OrderedAddGroup::add_lt_mono_l<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A, h: x < y): z + x < z + y {
    A.lt_respects(x + z, z + x, y + z, z + y, A.comm(x, z), A.comm(y, z), A.add_lt_mono_r(x, y, z, h))
}

theorem OrderedAddGroup::add_lt_mono<A: OrderedAddGroup(≈, <, <=, +)>(x, x2, y, y2: A, hx: x < x2, hy: y < y2):
    x + y < x2 + y2
{
    A.lt_trans(x + y, x2 + y, x2 + y2, A.add_lt_mono_r(x, x2, y, hx), OrderedAddGroup::add_lt_mono_l(y, y2, x2, hy))
}

theorem OrderedAddGroup::add_lt_cancel_r<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A, h: x + z < y + z): x < y {
    A.lt_respects((x + z) + A.inv(z), x, (y + z) + A.inv(z), y,
        OrderedAddGroup::add_neg_cancel_r(x, z), OrderedAddGroup::add_neg_cancel_r(y, z),
        A.add_lt_mono_r(x + z, y + z, A.inv(z), h))
}

theorem OrderedAddGroup::add_lt_cancel_l<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A, h: z + x < z + y): x < y {
    OrderedAddGroup::add_lt_cancel_r(x, y, z, A.lt_respects(z + x, x + z, z + y, y + z, A.comm(z, x), A.comm(z, y), h))
}

// `≤` is translation-invariant without locatedness: a refutation of `<`
// moves along a refutation of the cancelled `<`.
theorem OrderedAddGroup::add_le_mono_r<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A, h: x <= y): x + z <= y + z {
    A.le_of_not_lt(x + z, y + z, λ back => A.not_lt_of_le(x, y, h, OrderedAddGroup::add_lt_cancel_r(y, x, z, back)))
}

theorem OrderedAddGroup::add_le_mono_l<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z: A, h: x <= y): z + x <= z + y {
    A.le_of_not_lt(z + x, z + y, λ back => A.not_lt_of_le(x, y, h, OrderedAddGroup::add_lt_cancel_l(y, x, z, back)))
}

// x < y gives -y < -x: add -x + -y to both sides.
theorem OrderedAddGroup::neg_lt<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A, h: x < y): A.inv(y) < A.inv(x) {
    let shifted: (x + (A.inv(x) + A.inv(y)) < y + (A.inv(x) + A.inv(y))) =
        A.add_lt_mono_r(x, y, A.inv(x) + A.inv(y), h);
    let right = calc {
        y + (A.inv(x) + A.inv(y)) ≈ y + (A.inv(y) + A.inv(x)) := OrderedAddGroup::add_respects(y, y,
            A.inv(x) + A.inv(y), A.inv(y) + A.inv(x), A.rel_refl(y), A.comm(A.inv(x), A.inv(y))),
        ≈ A.inv(x) := OrderedAddGroup::add_neg_add(y, A.inv(x)),
    };
    A.lt_respects(x + (A.inv(x) + A.inv(y)), A.inv(y), y + (A.inv(x) + A.inv(y)), A.inv(x),
        OrderedAddGroup::add_neg_add(x, A.inv(y)), right, shifted)
}

// Negation swaps the sides of zero.
theorem OrderedAddGroup::neg_pos<A: OrderedAddGroup(≈, <, <=, +)>(x: A, h: x < A.unit): A.unit < A.inv(x) {
    StrictOrder::lt_respects_l(A.inv(A.unit), A.unit, A.inv(x), OrderedAddGroup::neg_zero(x), OrderedAddGroup::neg_lt(x, A.unit, h))
}

theorem OrderedAddGroup::neg_of_neg_pos<A: OrderedAddGroup(≈, <, <=, +)>(x: A, h: A.unit < A.inv(x)): x < A.unit {
    A.lt_respects(A.inv(A.inv(x)), x, A.inv(A.unit), A.unit, GroupRel::inv_inv(+, x), OrderedAddGroup::neg_zero(x),
        OrderedAddGroup::neg_lt(A.unit, A.inv(x), h))
}

theorem OrderedAddGroup::sub_pos<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A, h: x < y): A.unit < y + A.inv(x) {
    StrictOrder::lt_respects_l(x + A.inv(x), A.unit, y + A.inv(x), A.inv_r(x), A.add_lt_mono_r(x, y, A.inv(x), h))
}

theorem OrderedAddGroup::lt_of_sub_pos<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A, h: A.unit < y + A.inv(x)): x < y {
    A.lt_respects(A.unit + x, x, (y + A.inv(x)) + x, y, A.unit_l(x), OrderedAddGroup::sub_add_cancel(y, x),
        A.add_lt_mono_r(A.unit, y + A.inv(x), x, h))
}

theorem OrderedAddGroup::between_add<A: OrderedAddGroup(≈, <, <=, +)>(a, x, b, c: A, h: Between(<, a, x, b)):
    Between(<, a + c, x + c, b + c)
{
    And(A.add_lt_mono_r(a, x, c, h.left), A.add_lt_mono_r(x, b, c, h.right))
}

// Absolute-value bounds.

theorem OrderedAddGroup::abs_lt_respects<A: OrderedAddGroup(≈, <, <=, +)>(x, x2, e, e2: A, hx: x ≈ x2, he: e ≈ e2,
    h: AbsLt(x, e)): AbsLt(x2, e2)
{
    And(A.lt_respects(A.inv(e), A.inv(e2), x, x2, A.inv_respects(e, e2, he), hx, h.left),
        A.lt_respects(x, x2, e, e2, hx, he, h.right))
}

theorem OrderedAddGroup::abs_lt_mono<A: OrderedAddGroup(≈, <, <=, +)>(x, e, d: A, h: AbsLt(x, e), ed: e < d): AbsLt(x, d) {
    StrictOrder::between_widen(A.inv(e), x, e, A.inv(d), d, OrderedAddGroup::neg_lt(e, d, ed), ed, h)
}

theorem OrderedAddGroup::abs_lt_neg<A: OrderedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): AbsLt(A.inv(x), e) {
    And(OrderedAddGroup::neg_lt(x, e, h.right),
        StrictOrder::lt_respects_r(A.inv(x), A.inv(A.inv(e)), e, GroupRel::inv_inv(+, e), OrderedAddGroup::neg_lt(A.inv(e), x, h.left)))
}

// The triangle inequality: bounds add.
theorem OrderedAddGroup::abs_lt_add<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e, d: A, hx: AbsLt(x, e), hy: AbsLt(y, d)):
    AbsLt(x + y, e + d)
{
    And(StrictOrder::lt_respects_l(A.inv(e) + A.inv(d), A.inv(e + d), x + y,
            A.rel_sym(A.inv(e + d), A.inv(e) + A.inv(d), OrderedAddGroup::neg_add(e, d)),
            OrderedAddGroup::add_lt_mono(A.inv(e), x, A.inv(d), y, hx.left, hy.left)),
        OrderedAddGroup::add_lt_mono(x, e, y, d, hx.right, hy.right))
}

// A point within every positive bound of zero is zero. Tightness, not
// locatedness: x > 0 fails the bound x, and x < 0 fails the bound -x.
theorem OrderedAddGroup::same_zero_of_abs_lt<A: OrderedAddGroup(≈, <, <=, +)>(x: A,
    all: (e: A) → A.unit < e → AbsLt(x, e)): x ≈ A.unit
{
    A.lt_tight(x, A.unit,
        λ neg => {
            let pos: (A.unit < A.inv(x)) = StrictOrder::lt_respects_l(A.inv(A.unit), A.unit, A.inv(x),
                OrderedAddGroup::neg_zero(x), OrderedAddGroup::neg_lt(x, A.unit, neg));
            A.lt_irrefl(x, StrictOrder::lt_respects_l(A.inv(A.inv(x)), x, x, GroupRel::inv_inv(+, x), all(A.inv(x), pos).left))
        },
        λ pos => A.lt_irrefl(x, all(x, pos).right))
}

theorem OrderedAddGroup::close_sym<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e: A, h: Close(x, y, e)): Close(y, x, e) {
    OrderedAddGroup::abs_lt_respects(A.inv(x + A.inv(y)), y + A.inv(x), e, e, OrderedAddGroup::neg_sub(x, y), A.rel_refl(e),
        OrderedAddGroup::abs_lt_neg(x + A.inv(y), e, h))
}

theorem OrderedAddGroup::close_triangle<A: OrderedAddGroup(≈, <, <=, +)>(x, y, z, e, d: A, hxy: Close(x, y, e),
    hyz: Close(y, z, d)): Close(x, z, e + d)
{
    OrderedAddGroup::abs_lt_respects((x + A.inv(y)) + (y + A.inv(z)), x + A.inv(z), e + d, e + d,
        OrderedAddGroup::sub_add_sub(x, y, z), A.rel_refl(e + d),
        OrderedAddGroup::abs_lt_add(x + A.inv(y), y + A.inv(z), e, d, hxy, hyz))
}

// Points within every positive distance of each other are the same.
theorem OrderedAddGroup::same_of_close<A: OrderedAddGroup(≈, <, <=, +)>(x, y: A,
    all: (e: A) → A.unit < e → Close(x, y, e)): x ≈ y
{
    calc {
        x ≈ (x + A.inv(y)) + y := A.rel_sym((x + A.inv(y)) + y, x, OrderedAddGroup::sub_add_cancel(x, y)),
        ≈ A.unit + y := OrderedAddGroup::add_respects(x + A.inv(y), A.unit, y, y,
            OrderedAddGroup::same_zero_of_abs_lt(x + A.inv(y), all), A.rel_refl(y)),
        ≈ y := A.unit_l(y),
    }
}

// ---------------------------------------------------------------------------
// The located group.

class LocatedAddGroup<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A)
    extends OrderedAddGroup<A>(same, lt, le, add), PseudoOrder<A>(same, lt, le)
{}

// A gap between sums is a gap between one pair of summands: the strong
// extensionality of `+`, read off cotransitivity.
theorem LocatedAddGroup::add_lt_cancel<A: LocatedAddGroup(≈, <, <=, +)>(x, x2, y, y2: A, h: x + y < x2 + y2):
    x < x2 ∨ y < y2
{
    match A.rel_cotrans(x + y, x2 + y2, x2 + y, h) {
        Inl(l) => Inl(OrderedAddGroup::add_lt_cancel_r(x, x2, y, l)),
        Inr(r) => Inr(OrderedAddGroup::add_lt_cancel_l(y, y2, x2, r)),
    }
}

theorem LocatedAddGroup::pos_of_add_pos<A: LocatedAddGroup(≈, <, <=, +)>(x, y: A, h: A.unit < x + y):
    A.unit < x ∨ A.unit < y
{
    LocatedAddGroup::add_lt_cancel(A.unit, x, A.unit, y, StrictOrder::lt_respects_l(A.unit, A.unit + A.unit, x + y,
        A.rel_sym(A.unit + A.unit, A.unit, A.unit_r(A.unit)), h))
}

// A bound with a point under it is positive. This one needs locatedness:
// -e < e places zero, and zero below -e makes e positive by negation.
theorem LocatedAddGroup::abs_lt_pos<A: LocatedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): A.unit < e {
    match A.rel_cotrans(A.inv(e), e, A.unit, StrictOrder::between_lt(A.inv(e), x, e, h)) {
        Inl(below) => A.lt_respects(A.inv(A.unit), A.unit, A.inv(A.inv(e)), e,
            OrderedAddGroup::neg_zero(x), GroupRel::inv_inv(+, e), OrderedAddGroup::neg_lt(A.inv(e), A.unit, below)),
        Inr(above) => above,
    }
}

theorem LocatedAddGroup::add_le_mono<A: LocatedAddGroup(≈, <, <=, +)>(x, x2, y, y2: A, hx: x <= x2, hy: y <= y2):
    x + y <= x2 + y2
{
    PseudoOrder::le_trans(x + y, x2 + y, x2 + y2, OrderedAddGroup::add_le_mono_r(x, x2, y, hx), OrderedAddGroup::add_le_mono_l(y, y2, x2, hy))
}

theorem LocatedAddGroup::neg_le<A: LocatedAddGroup(≈, <, <=, +)>(x, y: A, h: x <= y): A.inv(y) <= A.inv(x) {
    A.le_of_not_lt(A.inv(y), A.inv(x), λ back => A.not_lt_of_le(x, y, h,
        A.lt_respects(A.inv(A.inv(y)), y, A.inv(A.inv(x)), x, GroupRel::inv_inv(+, y), GroupRel::inv_inv(+, x),
            OrderedAddGroup::neg_lt(A.inv(x), A.inv(y), back))))
}

theorem LocatedAddGroup::abs_le_of_abs_lt<A: LocatedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): AbsLe(x, e) {
    StrictOrder::within_of_between(A.inv(e), x, e, h)
}

theorem LocatedAddGroup::abs_le_add<A: LocatedAddGroup(≈, <, <=, +)>(x, y, e, d: A, hx: AbsLe(x, e), hy: AbsLe(y, d)):
    AbsLe(x + y, e + d)
{
    And(StrictOrder::le_respects(A.inv(e) + A.inv(d), A.inv(e + d), x + y, x + y,
            A.rel_sym(A.inv(e + d), A.inv(e) + A.inv(d), OrderedAddGroup::neg_add(e, d)), A.rel_refl(x + y),
            LocatedAddGroup::add_le_mono(A.inv(e), x, A.inv(d), y, hx.left, hy.left)),
        LocatedAddGroup::add_le_mono(x, e, y, d, hx.right, hy.right))
}

// A non-strict bound inside a strict one is strict.
theorem LocatedAddGroup::abs_lt_of_abs_le<A: LocatedAddGroup(≈, <, <=, +)>(x, e, d: A, h: AbsLe(x, e), ed: e < d):
    AbsLt(x, d)
{
    PseudoOrder::between_of_within(A.inv(e), x, e, A.inv(d), d, OrderedAddGroup::neg_lt(e, d, ed), ed, h)
}

// ---------------------------------------------------------------------------
// The field.

// A located group whose `+` is the additive group of a commutative ring
// (`semiring`'s `CommRing`), with `0 < 1`, products of positives positive, a
// positive factor reflecting the product's sign, a reciprocal on exactly the
// elements apart from zero, and the Archimedean property: every element is
// below some natural number. The ring's laws are its parent's, so every
// `Ring` theorem applies to an ordered field: one is
// `A.multiplicative.unit`, and the product's laws are reached through the
// `multiplicative` and `commutative` tags.
//
// The reciprocal is `recip`, not `inv`: `inv` is the additive group's
// negation, inherited untagged.
//
// The reflection (`0 < x` and `0 < x * y` give `0 < y`) is strong
// extensionality of `*` at zero, a constructive axiom of its own: the ring
// laws and `mul_pos` only refute `y ≤ 0`, which is not a gap. It is what the
// reciprocal's sign and the Archimedean property's reciprocal form need.
// `of_nat` is a field, with its two defining laws, so a carrier keeps its own
// embedding (`Rat::ofInt`, `CReal::ofRat`) and the law speaks of it.
class OrderedField<A>(same as ≈: A → A → Type, lt as <: A → A → Type, le as <=: A → A → Type,
    add as +: A → A → A, mul as *: A → A → A)
    extends LocatedAddGroup<A>(same, lt, le, add), CommRing<A>(same, add, mul)
{
    of_nat: Nat → A,
    recip: (x: A) → ApartBy(lt, x, unit) → A,
    mul_recip: (x: A) → (h: ApartBy(lt, x, unit)) → x * recip(x, h) ≈ multiplicative.unit,
    zero_lt_one: unit < multiplicative.unit,
    mul_pos: (x, y: A) → unit < x → unit < y → unit < x * y,
    pos_of_mul_pos: (x, y: A) → unit < x → unit < x * y → unit < y,
    of_nat_zero: of_nat(Zero) ≈ unit,
    of_nat_succ: (n: Nat) → of_nat(Succ(n)) ≈ of_nat(n) + multiplicative.unit,
    archimedean: (x: A) → ∃ n: Nat, x < of_nat(n),
}

// Products respect `≈` on both sides: the multiplicative semigroup's
// `Respects2`, reached through the tag.
theorem OrderedField::mul_respects<A: OrderedField(≈, <, <=, +, *)>(x, x2, y, y2: A, hx: x ≈ x2, hy: y ≈ y2):
    x * y ≈ x2 * y2
{
    A.multiplicative.respects2(x, x2, hx, y, y2, hy)
}

theorem OrderedField::one_apart_zero<A: OrderedField(≈, <, <=, +, *)>(x: A): ApartBy(<, A.multiplicative.unit, A.unit) {
    Inr(A.zero_lt_one)
}

// Multiplying by a positive keeps a strict inequality: the gap times the
// factor is positive, and distributivity turns it back into a gap.
theorem OrderedField::mul_lt_mono_l<A: OrderedField(≈, <, <=, +, *)>(x, y, z: A, h: x < y, hz: A.unit < z): z * x < z * y {
    let product: (A.unit < z * (y + A.inv(x))) = A.mul_pos(z, y + A.inv(x), hz, OrderedAddGroup::sub_pos(x, y, h));
    let spread = calc {
        z * (y + A.inv(x)) ≈ z * y + z * A.inv(x) := A.distrib_l(z, y, A.inv(x)),
        ≈ z * y + A.inv(z * x) := OrderedAddGroup::add_respects(z * y, z * y, z * A.inv(x), A.inv(z * x),
            A.rel_refl(z * y), Ring::mul_neg(z, x)),
    };
    OrderedAddGroup::lt_of_sub_pos(z * x, z * y, StrictOrder::lt_respects_r(A.unit, z * (y + A.inv(x)), z * y + A.inv(z * x), spread, product))
}

theorem OrderedField::mul_lt_mono_r<A: OrderedField(≈, <, <=, +, *)>(x, y, z: A, h: x < y, hz: A.unit < z): x * z < y * z {
    A.lt_respects(z * x, x * z, z * y, y * z, A.commutative.comm(z, x), A.commutative.comm(z, y), OrderedField::mul_lt_mono_l(x, y, z, h, hz))
}

// The inverse is unique, whichever apartness proof built it.
theorem OrderedField::recip_unique<A: OrderedField(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit), u: A, hu: x * u ≈ A.multiplicative.unit):
    u ≈ A.recip(x, h)
{
    calc {
        u ≈ u * A.multiplicative.unit := A.rel_sym(u * A.multiplicative.unit, u, A.multiplicative.unit_r(u)),
        ≈ u * (x * A.recip(x, h)) := OrderedField::mul_respects(u, u, A.multiplicative.unit, x * A.recip(x, h), A.rel_refl(u),
            A.rel_sym(x * A.recip(x, h), A.multiplicative.unit, A.mul_recip(x, h))),
        ≈ (u * x) * A.recip(x, h) := A.rel_sym((u * x) * A.recip(x, h), u * (x * A.recip(x, h)), A.multiplicative.assoc(u, x, A.recip(x, h))),
        ≈ (x * u) * A.recip(x, h) := OrderedField::mul_respects(u * x, x * u, A.recip(x, h), A.recip(x, h), A.commutative.comm(u, x), A.rel_refl(A.recip(x, h))),
        ≈ A.multiplicative.unit * A.recip(x, h) := OrderedField::mul_respects(x * u, A.multiplicative.unit, A.recip(x, h), A.recip(x, h), hu, A.rel_refl(A.recip(x, h))),
        ≈ A.recip(x, h) := A.multiplicative.unit_l(A.recip(x, h)),
    }
}

theorem OrderedField::recip_respects<A: OrderedField(≈, <, <=, +, *)>(x, x2: A, h: ApartBy(<, x, A.unit), h2: ApartBy(<, x2, A.unit),
    hx: x ≈ x2): A.recip(x, h) ≈ A.recip(x2, h2)
{
    OrderedField::recip_unique(x2, h2, A.recip(x, h), A.rel_trans(x2 * A.recip(x, h), x * A.recip(x, h), A.multiplicative.unit,
        OrderedField::mul_respects(x2, x, A.recip(x, h), A.recip(x, h), A.rel_sym(x, x2, hx), A.rel_refl(A.recip(x, h))),
        A.mul_recip(x, h)))
}

theorem OrderedField::recip_mul<A: OrderedField(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit)): A.recip(x, h) * x ≈ A.multiplicative.unit {
    A.rel_trans(A.recip(x, h) * x, x * A.recip(x, h), A.multiplicative.unit, A.commutative.comm(A.recip(x, h), x), A.mul_recip(x, h))
}

// The embedded naturals climb by one at each step.
theorem OrderedField::of_nat_lt_succ<A: OrderedField(≈, <, <=, +, *)>(x: A, n: Nat): A.of_nat(n) < A.of_nat(Succ(n)) {
    A.lt_respects(A.of_nat(n) + A.unit, A.of_nat(n), A.of_nat(n) + A.multiplicative.unit, A.of_nat(Succ(n)),
        A.unit_r(A.of_nat(n)), A.rel_sym(A.of_nat(Succ(n)), A.of_nat(n) + A.multiplicative.unit, A.of_nat_succ(n)),
        OrderedAddGroup::add_lt_mono_l(A.unit, A.multiplicative.unit, A.of_nat(n), A.zero_lt_one))
}

theorem OrderedField::of_nat_pos<A: OrderedField(≈, <, <=, +, *)>(x: A, n: Nat): A.unit < A.of_nat(Succ(n)) {
    match n {
        Zero => StrictOrder::lt_respects_l(A.of_nat(Zero), A.unit, A.of_nat(Succ(Zero)), A.of_nat_zero, OrderedField::of_nat_lt_succ(x, Zero)),
        Succ(m) => A.lt_trans(A.unit, A.of_nat(Succ(m)), A.of_nat(Succ(Succ(m))), OrderedField::of_nat_pos(x, m),
            OrderedField::of_nat_lt_succ(x, Succ(m))),
    }
}

// ---------------------------------------------------------------------------
// The inverse's sign, from the reflection law: x · x⁻¹ ≈ 1 is positive, so
// x⁻¹ has the sign of x.

theorem OrderedField::recip_pos<A: OrderedField(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit), hx: A.unit < x):
    A.unit < A.recip(x, h)
{
    A.pos_of_mul_pos(x, A.recip(x, h), hx, StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, x * A.recip(x, h),
        A.rel_sym(x * A.recip(x, h), A.multiplicative.unit, A.mul_recip(x, h)), A.zero_lt_one))
}

// A negative x: -x is positive and (-x) · (-x⁻¹) ≈ 1, so -x⁻¹ is positive.
theorem OrderedField::recip_neg<A: OrderedField(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit), hx: x < A.unit):
    A.recip(x, h) < A.unit
{
    let u = A.recip(x, h);
    let one: (A.inv(x) * A.inv(u) ≈ A.multiplicative.unit) = A.rel_trans(A.inv(x) * A.inv(u), x * u, A.multiplicative.unit,
        Ring::neg_mul_neg(x, u), A.mul_recip(x, h));
    let product: (A.unit < A.inv(x) * A.inv(u)) = StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, A.inv(x) * A.inv(u),
        A.rel_sym(A.inv(x) * A.inv(u), A.multiplicative.unit, one), A.zero_lt_one);
    OrderedAddGroup::neg_of_neg_pos(u, A.pos_of_mul_pos(A.inv(x), A.inv(u), OrderedAddGroup::neg_pos(x, hx), product))
}

// The inverse undoes itself, at any proofs of the two apartnesses.
theorem OrderedField::recip_recip<A: OrderedField(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit), h2: ApartBy(<, A.recip(x, h), A.unit)):
    A.recip(A.recip(x, h), h2) ≈ x
{
    A.rel_sym(x, A.recip(A.recip(x, h), h2), OrderedField::recip_unique(A.recip(x, h), h2, x, OrderedField::recip_mul(x, h)))
}

// Inversion reverses the order of positives: multiply x < y by the positive
// x⁻¹ · y⁻¹, and each side cancels to the other's inverse.
theorem OrderedField::recip_lt_recip<A: OrderedField(≈, <, <=, +, *)>(x, y: A, hx: ApartBy(<, x, A.unit), hy: ApartBy(<, y, A.unit),
    px: A.unit < x, h: x < y): A.recip(y, hy) < A.recip(x, hx)
{
    let u = A.recip(x, hx);
    let v = A.recip(y, hy);
    let w = u * v;
    let pw: (A.unit < w) = A.mul_pos(u, v, OrderedField::recip_pos(x, hx, px),
        OrderedField::recip_pos(y, hy, A.lt_trans(A.unit, x, y, px, h)));
    let left = calc {
        x * w ≈ (x * u) * v := A.rel_sym((x * u) * v, x * w, A.multiplicative.assoc(x, u, v)),
        ≈ A.multiplicative.unit * v := OrderedField::mul_respects(x * u, A.multiplicative.unit, v, v, A.mul_recip(x, hx), A.rel_refl(v)),
        ≈ v := A.multiplicative.unit_l(v),
    };
    let right = calc {
        y * w ≈ y * (v * u) := OrderedField::mul_respects(y, y, w, v * u, A.rel_refl(y), A.commutative.comm(u, v)),
        ≈ (y * v) * u := A.rel_sym((y * v) * u, y * (v * u), A.multiplicative.assoc(y, v, u)),
        ≈ A.multiplicative.unit * u := OrderedField::mul_respects(y * v, A.multiplicative.unit, u, u, A.mul_recip(y, hy), A.rel_refl(u)),
        ≈ u := A.multiplicative.unit_l(u),
    };
    A.lt_respects(x * w, v, y * w, u, left, right, OrderedField::mul_lt_mono_r(x, y, w, h, pw))
}

// The Archimedean property's inverse form: a positive x is above some
// 1/(n+1). Its inverse is below some natural n, so below n + 1, and
// inverting reverses that.
theorem OrderedField::archimedean_recip<A: OrderedField(≈, <, <=, +, *)>(x: A, hx: A.unit < x):
    ∃ n: Nat, A.recip(A.of_nat(Succ(n)), Inr(OrderedField::of_nat_pos(x, n))) < x
{
    let h: ApartBy(<, x, A.unit) = Inr(hx);
    let u = A.recip(x, h);
    let pu: (A.unit < u) = OrderedField::recip_pos(x, h, hx);
    match A.archimedean(u) {
        Exists(n, below) => {
            let big = A.of_nat(Succ(n));
            let pbig: (A.unit < big) = OrderedField::of_nat_pos(x, n);
            let flipped: (A.recip(big, Inr(pbig)) < A.recip(u, Inr(pu))) = OrderedField::recip_lt_recip(u, big, Inr(pu), Inr(pbig), pu,
                A.lt_trans(u, A.of_nat(n), big, below, OrderedField::of_nat_lt_succ(x, n)));
            Exists(n, StrictOrder::lt_respects_r(A.recip(big, Inr(pbig)), A.recip(u, Inr(pu)), x, OrderedField::recip_recip(x, h, Inr(pu)), flipped))
        },
    }
}

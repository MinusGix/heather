// Rationals as unreduced fractions: the first serious setoid customer
// (issues/positive-naturals-and-rationals.md, issues/setoid-core-api.md;
// docs/setoid-rationals-round.md).
//
// A rational is an integer numerator over a positive `Nat` denominator
// (`den: Pos<Nat>`: the number `den` and the fact `den_pos: 0 < den`, read
// through the rule `Rat::den_positive`; docs/positivity-evidence-design.md
// §11). Nothing is
// ever reduced: no gcd, no normal form, no non-structural recursion. The
// mathematical equality is `Rat::Same`, cross-multiplication, written `≈`;
// representation identity `=` stays available and is strictly finer (1/2 and
// 2/4 are `≈` but not `=`; it also compares the denominators' positivity
// proofs). Every operation is defined on representatives and
// then proved to respect `≈`, and every law is stated modulo `≈`, so clients
// rewrite with `calc { … ≈ … }` and `rel_cong` exactly as over finite sets.
//
// Calling convention: a lemma whose every `Rat` is named by one of its
// hypotheses takes those endpoints implicitly (`Rat::le_trans(h1, h2)`); any
// other lemma takes its first `Rat` as `self` (`x.add_comm(y)`).

import logic;
import nat;
import int;
import omega;
import ring;
import relation_props;
import algebra_rel;
import order;
import bool;

record Rat { num: Int, den: Pos<Nat> }

fn Rat::Same(x, y: Rat) → Type { x.num * y.den.int() = y.num * x.den.int() }

designation ≈ at Rat := Rat::Same

theorem Rat::same_refl(self x: Rat): x ≈ x { refl }

theorem Rat::same_sym({x, y: Rat}, h: x ≈ y): y ≈ x { sym(h) }

// a/p ≈ b/q and b/q ≈ c/r give a/p ≈ c/r: multiply the goal by q, which
// the two hypotheses rearrange into each other, and cancel q (positive by
// `y.den_pos`).
theorem Rat::same_trans({x, y, z: Rat}, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    let scaled: ((x.num * z.den.int()) * y.den.int() = (z.num * x.den.int()) * y.den.int()) = ring(hxy, hyz);
    (x.num * z.den.int()).mul_cancel_pos_r(z.num * x.den.int(), y.den.int(), scaled, p_pos := y.den_pos)
}

instance Equivalence<Rat>(Rat::Same) {
    rel_refl := Rat::same_refl,
    rel_sym := λ x y h => Rat::same_sym(h),
    rel_trans := λ x y z hxy hyz => Rat::same_trans(hxy, hyz),
}

// Two representations with the same numerator and the same denominator value
// are the same number; this is the bridge every identity-shaped law crosses.
theorem Rat::same_of_parts(self x, y: Rat, num: x.num = y.num, den: x.den = y.den):
    x ≈ y
{
    calc {
        x.num * y.den.int()
            = y.num * y.den.int() := cong(num),
            = y.num * x.den.int() := cong(sym(den)),
    }
}

// ---------------------------------------------------------------------------
// Arithmetic. Each operation is defined on representatives and then shown to
// respect `≈`; nothing reduces a fraction.

fn Rat::ofInt(n: Int) → Rat { Rat(n, 1) }
fn Rat::zero() → Rat { Rat::ofInt(OfNat(0)) }
fn Rat::one() → Rat { Rat::ofInt(OfNat(1)) }

fn Rat::add(self x, y: Rat) → Rat {
    Rat(x.num * y.den.int() + y.num * x.den.int(), x.den * y.den)
}

fn Rat::mul(self x, y: Rat) → Rat { Rat(x.num * y.num, x.den * y.den) }

fn Rat::neg(self x: Rat) → Rat { Rat(-x.num, x.den) }

designation + at Rat := Rat::add
designation * at Rat := Rat::mul
designation prefix - at Rat := Rat::neg

// The denominator of a sum or product, read into `Int`, as `ring` needs it:
// the product of the operands' denominators.
theorem Rat::den_add(self x, y: Rat): (x + y).den.int() = x.den.int() * y.den.int() { refl }
theorem Rat::den_mul(self x, y: Rat): (x * y).den.int() = x.den.int() * y.den.int() { refl }

theorem Rat::neg_respects({x, x2: Rat}, hx: x ≈ x2): -x ≈ -x2 {
    calc {
        (-x.num) * x2.den.int()
            = -(x.num * x2.den.int()) := x.num.mul_neg_l(x2.den.int()),
            = -(x2.num * x.den.int()) := cong(hx),
            = (-x2.num) * x.den.int() := sym(x2.num.mul_neg_l(x.den.int())),
    }
}

// Cross-multiplication respects both operations: `ring` combines the two
// hypotheses (scaled by the other fraction's denominators) once the
// denominators of the products are read as products of denominators.
theorem Rat::mul_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x * y ≈ x2 * y2 {
    ring(hx, hy, x.den_mul(y), x2.den_mul(y2))
}

theorem Rat::add_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x + y ≈ x2 + y2 {
    ring(hx, hy, x.den_add(y), x2.den_add(y2))
}

instance Respects2<Rat, Rat, Rat>(Rat::Same, Rat::Same, Rat::Same, Rat::add) {
    respects2 := λ x x2 hx y y2 hy => Rat::add_respects(hx, hy),
}

instance Respects2<Rat, Rat, Rat>(Rat::Same, Rat::Same, Rat::Same, Rat::mul) {
    respects2 := λ x x2 hx y y2 hy => Rat::mul_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The field-facing laws, modulo `≈`. Identity-shaped laws cross
// `same_of_parts`; distributivity is the one that needs cross-multiplication.

theorem Rat::add_comm(self x, y: Rat): x + y ≈ y + x {
    (x + y).same_of_parts(y + x, (x.num * y.den.int()).add_comm(y.num * x.den.int()), x.den.mul_comm(y.den))
}

theorem Rat::mul_comm(self x, y: Rat): x * y ≈ y * x {
    (x * y).same_of_parts(y * x, x.num.mul_comm(y.num), x.den.mul_comm(y.den))
}

theorem Rat::mul_assoc(self x, y, z: Rat): (x * y) * z ≈ x * (y * z) {
    ((x * y) * z).same_of_parts(x * (y * z), x.num.mul_assoc(y.num, z.num), x.den.mul_assoc(y.den, z.den))
}

theorem Rat::add_assoc(self x, y, z: Rat): (x + y) + z ≈ x + (y + z) {
    ring(x.den_add(y), y.den_add(z), (x + y).den_add(z), x.den_add(y + z))
}

theorem Rat::add_zero(self x: Rat): x + Rat::zero() ≈ x { (x + Rat::zero()).same_of_parts(x, omega, omega) }

theorem Rat::mul_one(self x: Rat): x * Rat::one() ≈ x { (x * Rat::one()).same_of_parts(x, omega, omega) }

theorem Rat::add_neg(self x: Rat): x + -x ≈ Rat::zero() { ring }

theorem Rat::mul_add_distr(self x, y, z: Rat): x * (y + z) ≈ x * y + x * z {
    ring(x.den_mul(y + z), y.den_add(z), (x * y).den_add(x * z), x.den_mul(y), x.den_mul(z))
}

instance Semigroup<Rat>(Rat::Same, Rat::add) {
    assoc := Rat::add_assoc,
}

instance Commutative<Rat>(Rat::Same, Rat::add) {
    comm := Rat::add_comm,
}

instance Semigroup<Rat>(Rat::Same, Rat::mul) {
    assoc := Rat::mul_assoc,
}

instance Commutative<Rat>(Rat::Same, Rat::mul) {
    comm := Rat::mul_comm,
}

// ---------------------------------------------------------------------------
// Order

fn Rat::Le(x, y: Rat) → Type { x.num * y.den.int() <= y.num * x.den.int() }

designation <= at Rat := Rat::Le

theorem Rat::le_of_same({x, y: Rat}, h: x ≈ y): x <= y {
    j(h, λ right q => x.num * y.den.int() <= right, (x.num * y.den.int()).le_refl())
}

theorem Rat::le_refl(self x: Rat): x <= x { Rat::le_of_same(x.same_refl()) }

theorem Rat::le_trans({x, y, z: Rat}, hxy: x <= y, hyz: y <= z): x <= z {
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let first = (x.num * q).mul_le_mono_r(y.num * p, r, hxy, trivial);
    let second = (y.num * r).mul_le_mono_r(z.num * q, p, hyz, trivial);
    let m1 = x.num.mul_right_comm(r, q);
    let m2 = y.num.mul_right_comm(p, r);
    let m3 = z.num.mul_right_comm(q, p);
    (x.num * r).mul_le_cancel_pos_r(z.num * p, q, omega, p_pos := y.den_pos)
}

theorem Rat::le_antisymm({x, y: Rat}, hxy: x <= y, hyx: y <= x): x ≈ y {
    (x.num * y.den.int()).le_antisym(y.num * x.den.int(), hxy, hyx)
}

theorem Rat::le_total(self x, y: Rat): x <= y ∨ y <= x {
    (x.num * y.den.int()).le_total(y.num * x.den.int())
}

theorem Rat::le_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2, h: x <= y): x2 <= y2 {
    Rat::le_trans(Rat::le_trans(Rat::le_of_same(Rat::same_sym(hx)), h), Rat::le_of_same(hy))
}

// Adding on the right preserves order. Both sides expand to two monomials;
// the z-terms agree outright and the x/y terms compare by `h` scaled by r·r.
theorem Rat::add_le_mono_r(self x, y, z: Rat, h: x <= y): x + z <= y + z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let pr = x.den_add(z);
    let qr = y.den_add(z);
    let scaled = (a * q).mul_le_mono_r(c * p, r * r, h, trivial);
    let left = (a * r).add_mul_distr(e * p, q * r);
    let right = (c * r).add_mul_distr(e * q, p * r);
    let ml = a.mul_shuffle(r, q, r);
    let mr = c.mul_shuffle(r, p, r);
    let ez = e.mul_shuffle(p, q, r);
    let gl: ((a * r + e * p) * (y + z).den.int() = (a * r + e * p) * (q * r)) = cong(qr);
    let gr: ((c * r + e * q) * (x + z).den.int() = (c * r + e * q) * (p * r)) = cong(pr);
    omega
}

theorem Rat::mul_nonneg({x, y: Rat}, hx: Rat::zero() <= x, hy: Rat::zero() <= y): Rat::zero() <= x * y {
    let zx = Int::zero_mul(x.den.int());
    let zy = Int::zero_mul(y.den.int());
    let ha: (OfNat(0) <= x.num) = omega;
    let hb: (OfNat(0) <= y.num) = omega;
    let prod = OfNat(0).mul_le_mono_r(x.num, y.num, ha, hb);
    let zero = Int::zero_mul(y.num);
    omega
}

// ---------------------------------------------------------------------------
// The integers inside the rationals.

theorem Rat::ofInt_add(m, n: Int): Rat::ofInt(m + n) ≈ Rat::ofInt(m) + Rat::ofInt(n) { omega }

theorem Rat::ofInt_mul(m, n: Int): Rat::ofInt(m * n) ≈ Rat::ofInt(m) * Rat::ofInt(n) { refl }

theorem Rat::ofInt_inj(m, n: Int, h: Rat::ofInt(m) ≈ Rat::ofInt(n)): m = n { omega }

theorem Rat::ofInt_le(m, n: Int, h: m <= n): Rat::ofInt(m) <= Rat::ofInt(n) { omega }

// ---------------------------------------------------------------------------
// Inverse. Total, with 0⁻¹ = 0; the field law asks for a nonzero argument.
// The numerator's sign moves to the new numerator, its magnitude becomes the
// new (positive) denominator.

fn Rat::inv_parts(a: Int, d: Pos<Nat>) → Rat {
    match a {
        OfNat(n) => match n {
            Zero => Rat::zero(),
            Succ(k) => Rat(d.int(), Succ(k)),
        },
        NegSucc(k) => Rat(-d.int(), Succ(k)),
    }
}

fn Rat::inv(self x: Rat) → Rat { Rat::inv_parts(x.num, x.den) }

theorem Rat::mul_inv_parts(a: Int, d: Pos<Nat>):
    ¬(Rat(a, d) ≈ Rat::zero()) → Rat(a, d) * Rat::inv_parts(a, d) ≈ Rat::one()
{
    match a {
        OfNat(n) => match n {
            Zero => λ nonzero => false_elim(nonzero(sym(Int::zero_mul(d.int())))),
            Succ(k) => λ nonzero => {
                let den = d.int_mul(Succ(k));
                let swap = OfNat(Succ(k)).mul_comm(d.int());
                omega
            },
        },
        NegSucc(k) => λ nonzero => {
            let den = d.int_mul(Succ(k));
            let flip = NegSucc(k).mul_neg_r(d.int());
            let sign = OfNat(Succ(k)).mul_neg_l(d.int());
            let swap = OfNat(Succ(k)).mul_comm(d.int());
            omega
        },
    }
}

theorem Rat::mul_inv(self x: Rat, nonzero: ¬(x ≈ Rat::zero())): x * x.inv() ≈ Rat::one() {
    Rat::mul_inv_parts(x.num, x.den, nonzero)
}

// Equal fractions have numerators of one sign: cross-multiplying by a
// positive denominator keeps each numerator's sign.
theorem Rat::num_pos_of_same({x, y: Rat}, h: x ≈ y, hx: OfNat(0) < x.num): OfNat(0) < y.num {
    let scaled = x.num.mul_pos(y.den.int(), hx, p_pos := y.den_pos);
    y.num.pos_of_mul_pos(x.den.int(), omega, p_pos := x.den_pos)
}

theorem Rat::num_neg_of_same({x, y: Rat}, h: x ≈ y, hx: x.num < OfNat(0)): y.num < OfNat(0) {
    let scaled = x.num.mul_neg(y.den.int(), hx, p_pos := y.den_pos);
    y.num.neg_of_mul_neg(x.den.int(), omega, p_pos := x.den_pos)
}

// Equal fractions with positive numerators have equal reciprocals.
theorem Rat::same_recip(a, p, c, q: Pos<Nat>, h: Rat(a.int(), p) ≈ Rat(c.int(), q)): Rat(p.int(), a) ≈ Rat(q.int(), c) {
    ring(h)
}

// Inverse respects `≈`. A sign mismatch contradicts the numerators' common
// sign; zero inverts to zero; a positive pair is `same_recip`, and a negative
// pair is the positive one under negation.
theorem Rat::inv_parts_respects(a: Int, p: Pos<Nat>, c: Int, q: Pos<Nat>):
    Rat(a, p) ≈ Rat(c, q) → Rat::inv_parts(a, p) ≈ Rat::inv_parts(c, q)
{
    match a {
        OfNat(n) => match n {
            Zero => match c {
                OfNat(m) => match m {
                    Zero => λ h => refl,
                    Succ(_) => λ h => false_elim(Rat::num_pos_of_same(Rat::same_sym(h), trivial)),
                },
                NegSucc(j) => λ h => false_elim(Rat::num_neg_of_same(Rat::same_sym(h), Int::negsucc_lt_ofnat(j, 0))),
            },
            Succ(k) => match c {
                OfNat(m) => match m {
                    Zero => λ h => false_elim(Rat::num_pos_of_same(h, trivial)),
                    Succ(j) => λ h => Rat::same_recip(Succ(k), p, Succ(j), q, h),
                },
                NegSucc(_) => λ h => false_elim(Rat::num_pos_of_same(h, trivial)),
            },
        },
        NegSucc(k) => match c {
            OfNat(_) => λ h => false_elim(Rat::num_neg_of_same(h, Int::negsucc_lt_ofnat(k, 0))),
            NegSucc(j) => λ h => Rat::neg_respects(Rat::same_recip(Succ(k), p, Succ(j), q, Rat::neg_respects(h))),
        },
    }
}

theorem Rat::inv_respects({x, x2: Rat}, hx: x ≈ x2): x.inv() ≈ x2.inv() {
    Rat::inv_parts_respects(x.num, x.den, x2.num, x2.den, hx)
}

// ---------------------------------------------------------------------------
// Strict order: the positive-difference form, `x.num·q < y.num·p`. It is
// the cross-multiplied `<` of `Int`, so it carries data omega reads directly,
// and it agrees with `¬(y ≤ x)` because the integer order decides.

fn Rat::Lt(x, y: Rat) → Type { x.num * y.den.int() < y.num * x.den.int() }

designation < at Rat := Rat::Lt

// A decision rather than a theorem: `lt_cotrans` branches on it and the
// `Decide` instance computes with it.
fn Rat::le_dec(self x, y: Rat) → x <= y ∨ ¬(x <= y) { Int::le_dec(x.num * y.den.int(), y.num * x.den.int()) }

theorem Rat::le_of_lt({x, y: Rat}, h: x < y): x <= y { omega }

theorem Rat::lt_irrefl(self x: Rat): ¬(x < x) { λ h => omega }

theorem Rat::not_le_of_lt({x, y: Rat}, h: x < y): ¬(y <= x) { λ le => omega }

theorem Rat::lt_of_not_le({x, y: Rat}, h: ¬(y <= x)): x < y { omega }

theorem Rat::le_of_not_lt({x, y: Rat}, h: ¬(y < x)): x <= y { omega }

theorem Rat::lt_trichotomy(self x, y: Rat): x < y ∨ x ≈ y ∨ y < x {
    (x.num * y.den.int()).lt_trichotomy(y.num * x.den.int())
}

theorem Rat::lt_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2, h: x < y): x2 < y2 {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h, Rat::le_respects(Rat::same_sym(hy), Rat::same_sym(hx), back)))
}

// The mixed transitivities go through `¬(… ≤ …)`: a counterexample to the
// conclusion would chain back into a counterexample to the strict premise.
theorem Rat::lt_of_lt_of_le({x, y, z: Rat}, h1: x < y, h2: y <= z): x < z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h1, Rat::le_trans(h2, back)))
}

theorem Rat::lt_of_le_of_lt({x, y, z: Rat}, h1: x <= y, h2: y < z): x < z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h2, Rat::le_trans(back, h1)))
}

theorem Rat::lt_trans({x, y, z: Rat}, h1: x < y, h2: y < z): x < z { Rat::lt_of_lt_of_le(h1, Rat::le_of_lt(h2)) }

// Cotransitivity, the constructive reals' replacement for trichotomy: a gap
// x < y puts any z above x or below y. At `Rat` the order decides, so z is
// placed by comparing it with x.
theorem Rat::lt_cotrans(self x, y, z: Rat, h: x < y): x < z ∨ z < y {
    match z.le_dec(x) {
        Inl(below) => Inr(Rat::lt_of_le_of_lt(below, h)),
        Inr(above) => Inl(Rat::lt_of_not_le(above)),
    }
}

// Two rationals neither of which is below the other are equal: tightness.
theorem Rat::same_of_not_lt({x, y: Rat}, h1: ¬(x < y), h2: ¬(y < x)): x ≈ y {
    Rat::le_antisymm(Rat::le_of_not_lt(h2), Rat::le_of_not_lt(h1))
}

instance Preorder<Rat>(Rat::Le) {
    rel_refl := Rat::le_refl,
    rel_trans := λ x y z hxy hyz => Rat::le_trans(hxy, hyz),
}

instance Total<Rat>(Rat::Le) {
    rel_total := Rat::le_total,
}

instance Irreflexive<Rat>(Rat::Lt) {
    rel_irrefl := Rat::lt_irrefl,
}

instance Transitive<Rat>(Rat::Lt) {
    rel_trans := λ x y z hxy hyz => Rat::lt_trans(hxy, hyz),
}

// The mixed pairs a `calc` chain composes: `<` absorbs `<=` on either side,
// and `≈` is absorbed by either order.
instance Trans<Rat>(Rat::Le, Rat::Lt, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_le_of_lt(hxy, hyz),
}

instance Trans<Rat>(Rat::Lt, Rat::Le, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_lt_of_le(hxy, hyz),
}

instance Trans<Rat>(Rat::Same, Rat::Le, Rat::Le) {
    rel_chain := λ x y z hxy hyz => Rat::le_trans(Rat::le_of_same(hxy), hyz),
}

instance Trans<Rat>(Rat::Le, Rat::Same, Rat::Le) {
    rel_chain := λ x y z hxy hyz => Rat::le_trans(hxy, Rat::le_of_same(hyz)),
}

instance Trans<Rat>(Rat::Same, Rat::Lt, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_le_of_lt(Rat::le_of_same(hxy), hyz),
}

instance Trans<Rat>(Rat::Lt, Rat::Same, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_lt_of_le(hxy, Rat::le_of_same(hyz)),
}

// ---------------------------------------------------------------------------
// Order and the additive structure.

fn Rat::sub(self x, y: Rat) → Rat { x + -y }

designation - at Rat := Rat::sub

theorem Rat::sub_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x -y ≈ x2 -y2 {
    Rat::add_respects(hx, Rat::neg_respects(hy))
}

theorem Rat::neg_neg(self x: Rat): -(-x) ≈ x { (-(-x)).same_of_parts(x, x.num.neg_neg(), refl) }

theorem Rat::neg_add(self x, y: Rat): -(x + y) ≈ -x + -y {
    (-(x + y)).same_of_parts(-x + -y,
        calc {
            -(x.num * y.den.int() + y.num * x.den.int())
                = -(x.num * y.den.int()) + -(y.num * x.den.int()) := Int::neg_add(x.num * y.den.int(), y.num * x.den.int()),
                = (-x.num) * y.den.int() + (-y.num) * x.den.int() := ring,
        },
        refl)
}

theorem Rat::add_neg_cancel_r(self x, y: Rat): (x + y) + -y ≈ x {
    calc {
        (x + y) + -y ≈ x + (y + -y) := x.add_assoc(y, -y),
        ≈ x + Rat::zero() := rel_cong(y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

theorem Rat::neg_le({x, y: Rat}, h: x <= y): -y <= -x {
    let left = y.num.mul_neg_l(x.den.int());
    let right = x.num.mul_neg_l(y.den.int());
    omega
}

theorem Rat::neg_lt({x, y: Rat}, h: x < y): -y < -x {
    let left = y.num.mul_neg_l(x.den.int());
    let right = x.num.mul_neg_l(y.den.int());
    omega
}

theorem Rat::add_le_mono_l(self x, y, z: Rat, h: x <= y): z + x <= z + y {
    Rat::le_respects(x.add_comm(z), y.add_comm(z), x.add_le_mono_r(y, z, h))
}

theorem Rat::add_le_mono({x, y, z, w: Rat}, h1: x <= y, h2: z <= w): x + z <= y + w {
    Rat::le_trans(x.add_le_mono_r(y, z, h1), z.add_le_mono_l(w, y, h2))
}

// Adding then subtracting z undoes the addition, so order cancels on the right.
theorem Rat::add_le_cancel_r(self x, y, z: Rat, h: x + z <= y + z): x <= y {
    Rat::le_respects(x.add_neg_cancel_r(z), y.add_neg_cancel_r(z), (x + z).add_le_mono_r(y + z, -z, h))
}

theorem Rat::add_lt_mono_r(self x, y, z: Rat, h: x < y): x + z < y + z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h, y.add_le_cancel_r(x, z, back)))
}

theorem Rat::add_lt_mono_l(self x, y, z: Rat, h: x < y): z + x < z + y {
    Rat::lt_respects(x.add_comm(z), y.add_comm(z), x.add_lt_mono_r(y, z, h))
}

theorem Rat::add_lt_mono({x, y, z, w: Rat}, h1: x < y, h2: z <= w): x + z < y + w {
    Rat::lt_of_lt_of_le(x.add_lt_mono_r(y, z, h1), z.add_le_mono_l(w, y, h2))
}

theorem Rat::sub_nonneg({x, y: Rat}, h: y <= x): Rat::zero() <= x -y {
    Rat::le_respects(y.add_neg(), (x -y).same_refl(), y.add_le_mono_r(x, -y, h))
}

theorem Rat::sub_pos({x, y: Rat}, h: y < x): Rat::zero() < x -y {
    Rat::lt_respects(y.add_neg(), (x -y).same_refl(), y.add_lt_mono_r(x, -y, h))
}

// ---------------------------------------------------------------------------
// Absolute value: the numerator's, over the same denominator.

fn Rat::abs(self x: Rat) → Rat { Rat(x.num.abs(), x.den) }

theorem Rat::abs_respects({x, x2: Rat}, hx: x ≈ x2): x.abs() ≈ x2.abs() {
    let q = x2.den.int();
    let p = x.den.int();
    calc {
        x.num.abs() * q
            = x.num.abs() * q.abs() := cong(sym(q.abs_of_nonneg(trivial))),
            = (x.num * q).abs() := sym(x.num.abs_mul(q)),
            = (x2.num * p).abs() := cong(hx),
            = x2.num.abs() * p.abs() := x2.num.abs_mul(p),
            = x2.num.abs() * p := cong(p.abs_of_nonneg(trivial)),
    }
}

theorem Rat::abs_nonneg(self x: Rat): Rat::zero() <= x.abs() {
    let positive = x.num.abs_nonneg();
    let zero = Int::zero_mul(x.den.int());
    omega
}

theorem Rat::le_abs(self x: Rat): x <= x.abs() { x.num.mul_le_mono_r(x.num.abs(), x.den.int(), x.num.le_abs(), trivial) }

theorem Rat::neg_le_abs(self x: Rat): -x <= x.abs() { (-x.num).mul_le_mono_r(x.num.abs(), x.den.int(), x.num.neg_le_abs(), trivial) }

theorem Rat::abs_neg(self x: Rat): (-x).abs() ≈ x.abs() { (-x).abs().same_of_parts(x.abs(), x.num.abs_neg(), refl) }

theorem Rat::abs_mul(self x, y: Rat): (x * y).abs() ≈ x.abs() * y.abs() {
    (x * y).abs().same_of_parts(x.abs() * y.abs(), x.num.abs_mul(y.num), refl)
}

// A non-negative rational is its own absolute value, a negative one its
// negation; between them they cover every rational.
theorem Rat::abs_cases(self x: Rat): (Rat::zero() <= x ∧ x.abs() ≈ x) ∨ (x < Rat::zero() ∧ x.abs() ≈ -x) {
    let zero = Int::zero_mul(x.den.int());
    match x.num.abs_cases() {
        Inl(c) => {
            let s = c.left;
            Inl(And(omega, x.abs().same_of_parts(x, c.right, refl)))
        },
        Inr(c) => {
            let s = c.left;
            Inr(And(omega, x.abs().same_of_parts(-x, c.right, refl)))
        },
    }
}

// |x| ≤ y from both bounds on x.
theorem Rat::abs_le({x, y: Rat}, lower: -y <= x, upper: x <= y): x.abs() <= y {
    match x.abs_cases() {
        Inl(c) => Rat::le_respects(Rat::same_sym(c.right), y.same_refl(), upper),
        Inr(c) => Rat::le_respects(Rat::same_sym(c.right), y.neg_neg(), Rat::neg_le(lower)),
    }
}

theorem Rat::neg_abs_le(self x: Rat): -x.abs() <= x {
    Rat::le_respects((-x.abs()).same_refl(), x.neg_neg(), Rat::neg_le(x.neg_le_abs()))
}

theorem Rat::abs_triangle(self x, y: Rat): (x + y).abs() <= x.abs() + y.abs() {
    let upper = Rat::add_le_mono(x.le_abs(), y.le_abs());
    let lower = Rat::add_le_mono(x.neg_abs_le(), y.neg_abs_le());
    let below = calc {
        -(x.abs() + y.abs()) ≈ -x.abs() + -y.abs() := x.abs().neg_add(y.abs()),
        <= x + y := lower,
    };
    Rat::abs_le(below, upper)
}

// ---------------------------------------------------------------------------
// Products and order. Scaling by z = e/r multiplies the cross-multiplied
// inequality by e·r; `ring` regroups each side so that omega sees the scaled
// premise and the goal over the same product atoms.

theorem Rat::zero_mul(self x: Rat): Rat::zero() * x ≈ Rat::zero() { ring }

theorem Rat::mul_le_mono_r({x, y, z: Rat}, h: x <= y, hz: Rat::zero() <= z): x * z <= y * z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let zr = Int::zero_mul(r);
    let he: (OfNat(0) <= e) = omega;
    let her = Int::mul_le_mono_r(OfNat(0), e, r, he, trivial);
    let scaled = Int::mul_le_mono_r(a * q, c * p, e * r, h, omega);
    let left: ((a * e) * (y * z).den.int() = (a * q) * (e * r)) = ring(y.den_mul(z));
    let right: ((c * e) * (x * z).den.int() = (c * p) * (e * r)) = ring(x.den_mul(z));
    omega
}

theorem Rat::mul_lt_mono_r({x, y, z: Rat}, h: x < y, hz: Rat::zero() < z): x * z < y * z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let zr = Int::zero_mul(r);
    let he: (OfNat(0) < e) = omega;
    let rp = z.den_pos;
    let her = Int::mul_lt_mono_r(OfNat(0), e, r, he, omega);
    let scaled = Int::mul_lt_mono_r(a * q, c * p, e * r, h, omega);
    let left: ((a * e) * (y * z).den.int() = (a * q) * (e * r)) = ring(y.den_mul(z));
    let right: ((c * e) * (x * z).den.int() = (c * p) * (e * r)) = ring(x.den_mul(z));
    omega
}

theorem Rat::mul_le_mono_l({x, y, z: Rat}, h: x <= y, hz: Rat::zero() <= z): z * x <= z * y {
    Rat::le_respects(x.mul_comm(z), y.mul_comm(z), Rat::mul_le_mono_r(h, hz))
}

theorem Rat::mul_lt_mono_l({x, y, z: Rat}, h: x < y, hz: Rat::zero() < z): z * x < z * y {
    Rat::lt_respects(x.mul_comm(z), y.mul_comm(z), Rat::mul_lt_mono_r(h, hz))
}

theorem Rat::mul_pos({x, y: Rat}, hx: Rat::zero() < x, hy: Rat::zero() < y): Rat::zero() < x * y {
    Rat::lt_respects(y.zero_mul(), (x * y).same_refl(), Rat::mul_lt_mono_r(hx, hy))
}

// ---------------------------------------------------------------------------
// Archimedean facts. `inv_succ(n)` is 1/(n+1), the step size the regular
// Cauchy-sequence probes measure distances in; its denominator is a `Succ`,
// so its positivity computes and no side condition rides along.

fn Rat::inv_succ(n: Nat) → Rat { Rat(OfNat(1), Succ(n)) }

theorem Rat::inv_succ_pos(n: Nat): Rat::zero() < Rat::inv_succ(n) { omega }

theorem Rat::inv_succ_le_one(n: Nat): Rat::inv_succ(n) <= Rat::one() { omega }

theorem Rat::inv_succ_antitone(m, n: Nat, h: m <= n): Rat::inv_succ(n) <= Rat::inv_succ(m) { omega }

// Two halves of 1/(n+1): 1/(2n+2) + 1/(2n+2) ≈ 1/(n+1).
theorem Rat::inv_succ_half(n: Nat): Rat::inv_succ(n + n + 1) + Rat::inv_succ(n + n + 1) ≈ Rat::inv_succ(n) {
    let half = Rat::inv_succ(n + n + 1).den;
    let whole: (Rat::inv_succ(n).den.int() = OfNat(n) + OfNat(1)) = refl;
    let part: (half.int() = OfNat(n) + OfNat(n) + OfNat(2)) = refl;
    ring(whole, part, half.int_mul(half))
}

// Every rational is below some integer: x = a/p < |a| + 1, because p ≥ 1.
fn Rat::archimedean(self x: Rat) → ∃ n: Nat, x < Rat::ofInt(OfNat(n)) {
    let a = x.num;
    let p = x.den.int();
    let above = a.le_abs();
    let pp = x.den_pos;
    let scaled = OfNat(1).mul_le_mono_l(p, OfNat(Succ(a.natAbs())), omega, trivial);
    Exists(Succ(a.natAbs()), omega)
}

// Every positive rational is above some 1/(n+1): with ε = e/r and e ≥ 1,
// 1/(r+1) < e/r because r < e·(r+1).
fn Rat::archimedean_inv(self eps: Rat, h: Rat::zero() < eps) → ∃ n: Nat, Rat::inv_succ(n) < eps {
    let e = eps.num;
    let r = eps.den.int();
    let zr = Int::zero_mul(r);
    let he: (OfNat(1) <= e) = omega;
    let scaled = OfNat(1).mul_le_mono_r(e, OfNat(Succ(eps.den)), he, trivial);
    Exists(eps.den, omega)
}

// ---------------------------------------------------------------------------
// Distances: |x - y| is symmetric and obeys the triangle inequality, the two
// facts a modulus-of-convergence estimate chains.

theorem Rat::neg_sub(self x, y: Rat): -(x -y) ≈ y -x {
    calc {
        -(x -y) ≈ -x + -(-y) := x.neg_add(-y),
        ≈ -x + y := rel_cong(y.neg_neg()),
        ≈ y + -x := (-x).add_comm(y),
    }
}

theorem Rat::abs_sub_comm(self x, y: Rat): (x -y).abs() ≈ (y -x).abs() {
    calc {
        (x -y).abs() ≈ (-(x -y)).abs() := Rat::same_sym((x -y).abs_neg()),
        ≈ (y -x).abs() := Rat::abs_respects(x.neg_sub(y)),
    }
}

theorem Rat::sub_add_sub(self x, y, z: Rat): (x -y) + (y -z) ≈ x -z {
    calc {
        (x -y) + (y -z) ≈ x + (-y + (y + -z)) := x.add_assoc(-y, y -z),
        ≈ x + ((-y + y) + -z) := rel_cong(Rat::same_sym((-y).add_assoc(y, -z))),
        ≈ x + ((y + -y) + -z) := rel_cong((-y).add_comm(y)),
        ≈ x + (Rat::zero() + -z) := rel_cong(y.add_neg()),
        ≈ x + (-z + Rat::zero()) := rel_cong(Rat::zero().add_comm(-z)),
        ≈ x + -z := rel_cong((-z).add_zero()),
    }
}

theorem Rat::dist_triangle(self x, y, z: Rat): (x -z).abs() <= (x -y).abs() + (y -z).abs() {
    calc {
        (x -z).abs() ≈ ((x -y) + (y -z)).abs() := Rat::abs_respects(Rat::same_sym(x.sub_add_sub(y, z))),
        <= (x -y).abs() + (y -z).abs() := (x -y).abs_triangle(y -z),
    }
}

// The facts the regular Cauchy reals (`std/creal`) chain: a point's distance
// to itself, negation and sums moved through a distance, and tightness read
// off distances.

theorem Rat::abs_sub_self(self x: Rat): (x -x).abs() ≈ Rat::zero() {
    calc {
        (x -x).abs() ≈ Rat::zero().abs() := Rat::abs_respects(x.add_neg()),
        ≈ Rat::zero() := refl,
    }
}

theorem Rat::neg_sub_neg(self x, y: Rat): (-x) -(-y) ≈ -(x -y) { Rat::same_sym(x.neg_add(-y)) }

theorem Rat::abs_neg_sub_neg(self x, y: Rat): ((-x) -(-y)).abs() ≈ (x -y).abs() {
    calc {
        ((-x) -(-y)).abs() ≈ (-(x -y)).abs() := Rat::abs_respects(x.neg_sub_neg(y)),
        ≈ (x -y).abs() := (x -y).abs_neg(),
    }
}

theorem Rat::add_add_add_comm(self a, b, c, d: Rat): (a + b) + (c + d) ≈ (a + c) + (b + d) {
    ring(a.den_add(b), c.den_add(d), (a + b).den_add(c + d), a.den_add(c), b.den_add(d), (a + c).den_add(b + d))
}

theorem Rat::add_sub_add(self a, b, c, d: Rat): (a + b) -(c + d) ≈ (a -c) + (b -d) {
    calc {
        (a + b) -(c + d) ≈ (a + b) + (-c + -d) := Rat::add_respects((a + b).same_refl(), c.neg_add(d)),
        ≈ (a -c) + (b -d) := a.add_add_add_comm(b, -c, -d),
    }
}

// Two sums are as close as their summands' distances added.
theorem Rat::dist_add_le({a, b, c, d, u, v: Rat}, h1: (a -c).abs() <= u, h2: (b -d).abs() <= v):
    ((a + b) -(c + d)).abs() <= u + v
{
    calc {
        ((a + b) -(c + d)).abs() ≈ ((a -c) + (b -d)).abs() := Rat::abs_respects(a.add_sub_add(b, c, d)),
        <= (a -c).abs() + (b -d).abs() := (a -c).abs_triangle(b -d),
        <= u + v := Rat::add_le_mono(h1, h2),
    }
}

theorem Rat::sub_add_cancel(self a, b: Rat): (a -b) + b ≈ a { ring(a.den_add(-b), (a -b).den_add(b)) }

theorem Rat::add_sub_cancel_l(self a, b: Rat): (a + b) -a ≈ b { ring(a.den_add(b), (a + b).den_add(-a)) }

theorem Rat::add_sub_self(self a, b: Rat): a + (b -a) ≈ b { ring(b.den_add(-a), a.den_add(b -a)) }

theorem Rat::le_add_nonneg(self a, e: Rat, h: Rat::zero() <= e): a <= a + e {
    calc {
        a ≈ a + Rat::zero() := Rat::same_sym(a.add_zero()),
        <= a + e := Rat::zero().add_le_mono_l(e, a, h),
    }
}

// A distance bound as two one-sided bounds, and back.
theorem Rat::le_add_of_dist({a, b, e: Rat}, h: (a -b).abs() <= e): a <= b + e {
    calc {
        a ≈ (a -b) + b := Rat::same_sym(a.sub_add_cancel(b)),
        <= e + b := (a -b).add_le_mono_r(e, b, Rat::le_trans((a -b).le_abs(), h)),
        ≈ b + e := e.add_comm(b),
    }
}

theorem Rat::sub_le_of_le_add({a, b, c: Rat}, h: a <= b + c): a -b <= c {
    calc {
        a -b <= (b + c) -b := a.add_le_mono_r(b + c, -b, h),
        ≈ c := b.add_sub_cancel_l(c),
    }
}

theorem Rat::dist_le_of_le_add({a, b, c: Rat}, h1: a <= b + c, h2: b <= a + c): (a -b).abs() <= c {
    let below = calc {
        -c <= -(b -a) := Rat::neg_le(Rat::sub_le_of_le_add(h2)),
        ≈ a -b := b.neg_sub(a),
    };
    Rat::abs_le(below, Rat::sub_le_of_le_add(h1))
}

// A gap of q + 2e between a and b survives moving a up and b down by e
// each: the step a strict order on the reals takes whenever it compares
// terms at two indices, or of two `≈` sequences.
theorem Rat::le_of_close_gap({a, a2, b, b2, e, q: Rat}, ha: a2 <= a + e, hb: b <= b2 + e, gap: a + (q + (e + e)) <= b):
    a2 + q <= b2
{
    let shifted = calc {
        (a2 + q) + e <= ((a + e) + q) + e := (a2 + q).add_le_mono_r((a + e) + q, e, a2.add_le_mono_r(a + e, q, ha)),
        ≈ a + (q + (e + e)) := ring(a.den_add(e), (a + e).den_add(q), ((a + e) + q).den_add(e), e.den_add(e), q.den_add(e + e), a.den_add(q + (e + e))),
        <= b := gap,
        <= b2 + e := hb,
    };
    (a2 + q).add_le_cancel_r(b2, e, shifted)
}

// Two rationals within every 1/(k+1) of each other are the same number: a
// positive distance would sit above some 1/(k+1) (`archimedean_inv`).
theorem Rat::same_of_close(self x, y: Rat, close: (k: Nat) → (x -y).abs() <= Rat::inv_succ(k)): x ≈ y {
    let d = x -y;
    let small: (d.abs() <= Rat::zero()) = Rat::le_of_not_lt(λ positive => {
        match d.abs().archimedean_inv(positive) {
            Exists(k, gap) => {
                let below: (Rat::inv_succ(k) < d.abs()) = gap;
                Rat::not_le_of_lt(below, close(k))
            },
        }
    });
    let above = d.num.le_abs();
    let below = d.num.neg_le_abs();
    let zero = Int::zero_mul(d.den.int());
    let flip = y.num.mul_neg_l(x.den.int());
    let gap: (d.num = x.num * y.den.int() + (-y.num) * x.den.int()) = refl;
    let mag: (d.abs().num = d.num.abs()) = refl;
    let den: (d.abs().den = d.den) = refl;
    omega
}

instance(x, y: Rat) Decide<Rat::Le(x, y)> {
    dec := x.le_dec(y),
    bit := or_bit(x.le_dec(y)),
    reflects := or_bit_reflects(x.le_dec(y)),
}

// Strings as sequences of Unicode scalar values. A `String` is a one-field
// record over `List<Char>` and not an alias, so it owns its own instance keys
// — the literal class, decidable equality, a designated `++` — while every
// law about it is the corresponding list law lifted through one projection
// (docs/string-char-design.md §2).
//
// UTF-8 is a *representation* of this type and not its definition; encoding,
// decoding and the byte-level `Utf8` spec type are a later round's work.

import logic;
import nat;
import list;
import char;

record String { chars: List<Char> }

fn append(s, t: String) → String { String(s.chars ++ t.chars) }

designation ++ at String := append

// The receiver form delegates, `bounded_list`'s dodge: a `String::len` whose
// body reached `List::len` through a receiver would make the bare name `len`
// ambiguous with the member being declared.
fn string_len(s: String) → Nat { s.chars.len() }

fn String::len(self s: String) → Nat { string_len(s) }

// ---------------------------------------------------------------------------
// Indexing. `nth` takes a `Fin(s.len())`, so no partial index appears in the
// specification at all: out of range is unwritable rather than an `Option`.
//
// The index is eliminated by recursing on the *list* and letting the motive
// instantiate the length — `Fin` has no eliminator of its own, and at a
// neutral length there is no canonical index to match on
// (docs/surface-fin-indexing-design.md §1.2).
fn chars_nth(xs: List<Char>) → (i: Fin(xs.len())) → Char {
    match xs {
        Nil => λ (i: Fin(0)) => match i {},
        Cons(head, tail) => λ (i: Fin(Succ(tail.len()))) =>
            match i { FZ => head, FS(j) => chars_nth(tail, j) },
    }
}

fn String::nth(self s: String, i: Fin(s.len())) → Char { chars_nth(s.chars, i) }

fn take(s: String, n: Nat) → String { String(list::take(s.chars, n)) }

fn drop(s: String, n: Nat) → String { String(list::drop(s.chars, n)) }

// ---------------------------------------------------------------------------
// The laws. Each is its list counterpart through `chars_injective` or through
// the projection alone; nothing here re-proves a list theorem.

theorem chars_injective(s, t: String, p: s.chars = t.chars): s = t {
    j(p, λ y q => s = String(chars := y), refl)
}

theorem cong_chars(s, t: String, p: s = t): s.chars = t.chars {
    j(p, λ y q => s.chars = y.chars, refl)
}

theorem take_drop(s: String, n: Nat): take(s, n) ++ drop(s, n) = s {
    chars_injective(take(s, n) ++ drop(s, n), s, take_append_drop(s.chars, n))
}

theorem len_append(s, t: String): (s ++ t).len() = s.len() + t.len() {
    list::len_append(s.chars, t.chars)
}

theorem len_nil(): String(chars := Nil<Char>).len() = 0 {}

// ---------------------------------------------------------------------------
// Decidable equality. The character list is compared structurally, so this
// section first needs what `list` does not yet export: a `Nil`/`Cons`
// discriminator and the two projections congruence goes through. They are
// stated over `Char` rather than at an open element type because that is all
// this module needs; if a second client wants them they move to `list`.

fn is_nil(xs: List<Char>) → Type { match xs { Nil => True, Cons(_, _) => False } }

fn head_or(fallback: Char, xs: List<Char>) → Char {
    match xs { Nil => fallback, Cons(head, _) => head }
}

fn tail_or(xs: List<Char>) → List<Char> {
    match xs { Nil => Nil, Cons(_, tail) => tail }
}

theorem nil_ne_cons(head: Char, tail: List<Char>): ¬(Nil<Char> = Cons(head, tail)) {
    λ (p: (Nil<Char> = Cons(head, tail))) => j(p, λ y q => is_nil(y), trivial)
}

theorem cons_ne_nil(head: Char, tail: List<Char>): ¬(Cons(head, tail) = Nil<Char>) {
    λ (p: (Cons(head, tail) = Nil<Char>)) => nil_ne_cons(head, tail, sym(p))
}

theorem cong_head(fallback: Char, {xs, ys: List<Char>}, p: xs = ys):
    head_or(fallback, xs) = head_or(fallback, ys)
{
    j(p, λ y q => head_or(fallback, xs) = head_or(fallback, y), refl)
}

theorem cong_tail({xs, ys: List<Char>}, p: xs = ys): tail_or(xs) = tail_or(ys) {
    j(p, λ y q => tail_or(xs) = tail_or(y), refl)
}

theorem cons_eq(head1, head2: Char, tail1, tail2: List<Char>,
    ph: head1 = head2, pt: tail1 = tail2): Cons(head1, tail1) = Cons(head2, tail2)
{
    j(ph, λ y q => Cons(head1, tail1) = Cons(y, tail2), cong_cons(head1, pt))
}

// A `fn` and not a `theorem`: a decision has to reduce, or nothing downstream
// of `Decide<s = t>` is `refl` any more (`nat::eq_dec` carries the same note).
fn chars_eq_dec(xs: List<Char>) → (ys: List<Char>) → xs = ys ∨ ¬(xs = ys) {
    match xs {
        Nil => λ ys =>
            match ys {
                Nil => Inl(refl),
                Cons(head2, tail2) => Inr(nil_ne_cons(head2, tail2)),
            },
        Cons(head1, tail1) => λ ys =>
            match ys {
                Nil => Inr(cons_ne_nil(head1, tail1)),
                Cons(head2, tail2) =>
                    match char_eq_dec(head1, head2) {
                        Inr(head_ne) => Inr(λ (p: (Cons(head1, tail1) = Cons(head2, tail2))) =>
                            head_ne(cong_head(head1, p))),
                        Inl(head_eq) =>
                            match chars_eq_dec(tail1, tail2) {
                                Inl(tail_eq) => Inl(cons_eq(head1, head2, tail1, tail2,
                                    head_eq, tail_eq)),
                                Inr(tail_ne) =>
                                    Inr(λ (p: (Cons(head1, tail1) = Cons(head2, tail2))) =>
                                        tail_ne(cong_tail(p))),
                            },
                    },
            },
    }
}

fn string_eq_dec(s, t: String) → s = t ∨ ¬(s = t) {
    match chars_eq_dec(s.chars, t.chars) {
        Inl(p) => Inl(chars_injective(s, t, p)),
        Inr(np) => Inr(λ (h: s = t) => np(cong_chars(s, t, h))),
    }
}

instance(s, t: String) Decide<s = t> { dec := string_eq_dec(s, t) }

// ---------------------------------------------------------------------------
// The literal class, `char`'s `CharLiteral` at the sequence level: at any
// carrier that is not `String` itself a `"…"` literal resolves this and
// applies `ofString`. Declared here for the reason `CharLiteral` is declared
// in `char` — its field mentions `String`.
class StringLiteral<A> { ofString: String → A }

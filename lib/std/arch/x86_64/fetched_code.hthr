// Fetched execution of emitted code (docs/native-first-program-design.md §3).
// One step fetches the bytes at RIP and runs them as one of the forms the
// compiler emits; a run is a count of such steps. The bridges below turn the
// structural relations (`structured_after`, `ExecuteAccess`) into fetched
// runs, given layout and code resident at the start. Execution never writes
// memory, so residency proved at the start holds on every later state.
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_structured_block;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// The forms the compiler emits. Each executes by its existing relation; a
// fetched step adds only the fetch of its exact canonical bytes. Calls join
// as another case when a fetched program first needs them.
inductive EmittedInstruction {
    EmitOrdinary(instruction: Instruction),
    EmitLoad(load: ByteLoad),
    EmitShort(control: ShortControl),
    EmitNear(control: NearControl),
}
fn emitted_bytes(emitted: EmittedInstruction) → List<BitVec(8)> {
    match emitted {
        EmitOrdinary(instruction) => canonical_bytes(instruction),
        EmitLoad(load) => byte_load_bytes(load),
        EmitShort(control) => short_control_bytes(control),
        EmitNear(control) => near_control_bytes(control),
    }
}
fn EmittedExecutes<M>(data: ByteReadAccess<M>, emitted: EmittedInstruction,
    before, after: MachineState<M>) → Type {
    match emitted {
        EmitOrdinary(instruction) => ExecuteAt(encoded_at(before.rip, instruction),
            decoded_canonical(instruction), before, Returned(after)),
        EmitLoad(load) => Exists<BitVec(8)>(λ byte => ByteLoadStep<M>(data, load, byte, before, after)),
        EmitShort(control) => after = execute_short_control(control, before),
        EmitNear(control) => after = execute_near_control(control, before),
    }
}

theorem emitted_exec_same_defined<M>(data: ByteReadAccess<M>, emitted: EmittedInstruction,
    before, first, second: MachineState<M>,
    left: EmittedExecutes(data, emitted, before, first),
    right: EmittedExecutes(data, emitted, before, second)):
    SameDefinedState<M>(first, second) {
    (match emitted as λ form => (a, b: MachineState<M>) →
        EmittedExecutes(data, form, before, a) → EmittedExecutes(data, form, before, b) →
        SameDefinedState<M>(a, b) {
        EmitOrdinary(instruction) => λ a b p q =>
            execute_pair_same_defined(instruction, canonical_length(instruction),
                squash(canonical_length_valid(instruction)), before, a, b,
                p.right.right, q.right.right),
        EmitLoad(load) => λ a b p q => same_defined_of_equal(a, b,
            byte_load_same(data, load, before, a, b, p.witness, q.witness,
                p.proof, q.proof)),
        EmitShort(control) => λ a b p q => same_defined_of_equal(a, b, trans(p, sym(q))),
        EmitNear(control) => λ a b p q => same_defined_of_equal(a, b, trans(p, sym(q))),
    })(first, second, left, right)
}

theorem emitted_exec_respects_defined<M>(data: ByteReadAccess<M>, emitted: EmittedInstruction,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left: EmittedExecutes(data, emitted, before_left, after_left),
    right: EmittedExecutes(data, emitted, before_right, after_right)):
    SameDefinedState<M>(after_left, after_right) {
    (match emitted as λ form => (a, b: MachineState<M>) →
        SameDefinedState<M>(a, b) → (x, y: MachineState<M>) →
        EmittedExecutes(data, form, a, x) → EmittedExecutes(data, form, b, y) →
        SameDefinedState<M>(x, y) {
        EmitOrdinary(instruction) => λ a b same x y p q =>
            execute_canonical_respects_defined(instruction, a, b, x, y, same,
                p.right.right, q.right.right),
        EmitLoad(load) => λ a b same x y p q =>
            byte_load_respects_defined(data, load, a, b, x, y,
                p.witness, q.witness, same, p.proof, q.proof),
        EmitShort(control) => λ a b same x y p q =>
            same_defined_trans(x, execute_short_control(control, a), y,
                same_defined_of_equal(x, execute_short_control(control, a), p),
                same_defined_trans(execute_short_control(control, a),
                    execute_short_control(control, b), y,
                    short_control_respects_defined(control, a, b, same),
                    same_defined_of_equal(execute_short_control(control, b), y, sym(q)))),
        EmitNear(control) => λ a b same x y p q =>
            same_defined_trans(x, execute_near_control(control, a), y,
                same_defined_of_equal(x, execute_near_control(control, a), p),
                same_defined_trans(execute_near_control(control, a),
                    execute_near_control(control, b), y,
                    near_control_respects_defined(control, a, b, same),
                    same_defined_of_equal(execute_near_control(control, b), y, sym(q)))),
    })(before_left, before_right, before_same, after_left, after_right, left, right)
}
fn FetchedStep<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, before, after: MachineState<M>) → Type {
    Exists<EmittedInstruction>(λ emitted =>
        FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, emitted_bytes(emitted))) ∧
        EmittedExecutes(data, emitted, before, after))
}

theorem fetched_step_respects_same_witness<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left: FetchedStep(fetch, data, before_left, after_left),
    right: FetchedStep(fetch, data, before_right, after_right),
    same_emitted: left.witness = right.witness):
    SameDefinedState<M>(after_left, after_right) {
    let runner: (candidate: EmittedInstruction) → (left.witness = candidate) →
        (FetchedFrom(fetch, before_right.memory,
            InstructionBytes(before_right.rip, emitted_bytes(candidate))) ∧
         EmittedExecutes(data, candidate, before_right, after_right)) →
        SameDefinedState<M>(after_left, after_right) =
        λ candidate same evidence =>
            j(same, λ actual _ =>
                (FetchedFrom(fetch, before_right.memory,
                    InstructionBytes(before_right.rip, emitted_bytes(actual))) ∧
                 EmittedExecutes(data, actual, before_right, after_right)) →
                SameDefinedState<M>(after_left, after_right),
                λ agreed => emitted_exec_respects_defined(data, left.witness,
                    before_left, before_right, after_left, after_right, before_same,
                    left.proof.right, agreed.right))(evidence);
    runner(right.witness, same_emitted, right.proof)
}

// Equal-length canonical ordinary spans identify one instruction even when
// their starting states differ in TEST's undefined AF.
theorem ordinary_fetched_respects_defined<M>(fetch: FetchAccess<M>,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left, right: Instruction,
    left_fetch: FetchedFrom(fetch, before_left.memory,
        InstructionBytes(before_left.rip, canonical_bytes(left))),
    right_fetch: FetchedFrom(fetch, before_right.memory,
        InstructionBytes(before_right.rip, canonical_bytes(right))),
    length: canonical_bytes(left).len() = canonical_bytes(right).len(),
    left_exec: ExecuteAt(encoded_at(before_left.rip, left), decoded_canonical(left), before_left, Returned(after_left)),
    right_exec: ExecuteAt(encoded_at(before_right.rip, right), decoded_canonical(right), before_right, Returned(after_right))):
    SameDefinedState<M>(after_left, after_right) {
    let bytes = fetched_bytes_same_length_related(fetch, before_left, before_right, before_same,
        canonical_bytes(left), canonical_bytes(right), left_fetch, right_fetch, length);
    let instruction = canonical_bytes_unique(left, right, bytes);
    let runner: (candidate: Instruction) → (left = candidate) →
        ExecuteAt(encoded_at(before_right.rip, candidate), decoded_canonical(candidate),
            before_right, Returned(after_right)) → SameDefinedState<M>(after_left, after_right) =
        λ candidate same execution =>
            j(same, λ actual _ =>
                ExecuteAt(encoded_at(before_right.rip, actual), decoded_canonical(actual),
                    before_right, Returned(after_right)) → SameDefinedState<M>(after_left, after_right),
                λ agreed => execute_canonical_respects_defined(left,
                    before_left, before_right, after_left, after_right, before_same,
                    left_exec.right.right, agreed.right.right))(execution);
    runner(right, instruction, right_exec)
}

theorem short_fetched_respects_defined<M>(fetch: FetchAccess<M>,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left, right: ShortControl,
    left_fetch: FetchedFrom(fetch, before_left.memory,
        InstructionBytes(before_left.rip, short_control_bytes(left))),
    right_fetch: FetchedFrom(fetch, before_right.memory,
        InstructionBytes(before_right.rip, short_control_bytes(right))),
    left_exec: after_left = execute_short_control(left, before_left),
    right_exec: after_right = execute_short_control(right, before_right)):
    SameDefinedState<M>(after_left, after_right) {
    let bytes = fetched_bytes_same_length_related(fetch, before_left, before_right, before_same,
        short_control_bytes(left), short_control_bytes(right), left_fetch, right_fetch,
        trans(short_control_bytes_length(left), sym(short_control_bytes_length(right))));
    let control = short_control_bytes_unique(left, right, bytes);
    let runner: (candidate: ShortControl) → (left = candidate) →
        (after_right = execute_short_control(candidate, before_right)) →
        SameDefinedState<M>(after_left, after_right) =
        λ candidate same execution =>
            j(same, λ actual _ =>
                (after_right = execute_short_control(actual, before_right)) →
                SameDefinedState<M>(after_left, after_right),
                λ agreed => same_defined_trans(after_left, execute_short_control(left, before_left),
                    after_right, same_defined_of_equal(after_left, execute_short_control(left, before_left), left_exec),
                    same_defined_trans(execute_short_control(left, before_left),
                        execute_short_control(left, before_right), after_right,
                        short_control_respects_defined(left, before_left, before_right, before_same),
                        same_defined_of_equal(execute_short_control(left, before_right), after_right, sym(agreed)))))(execution);
    runner(right, control, right_exec)
}

theorem near_fetched_respects_defined<M>(fetch: FetchAccess<M>,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left, right: NearControl,
    left_fetch: FetchedFrom(fetch, before_left.memory,
        InstructionBytes(before_left.rip, near_control_bytes(left))),
    right_fetch: FetchedFrom(fetch, before_right.memory,
        InstructionBytes(before_right.rip, near_control_bytes(right))),
    length: near_control_bytes(left).len() = near_control_bytes(right).len(),
    left_exec: after_left = execute_near_control(left, before_left),
    right_exec: after_right = execute_near_control(right, before_right)):
    SameDefinedState<M>(after_left, after_right) {
    let bytes = fetched_bytes_same_length_related(fetch, before_left, before_right, before_same,
        near_control_bytes(left), near_control_bytes(right), left_fetch, right_fetch, length);
    let control = near_control_bytes_unique(left, right, bytes);
    let runner: (candidate: NearControl) → (left = candidate) →
        (after_right = execute_near_control(candidate, before_right)) →
        SameDefinedState<M>(after_left, after_right) =
        λ candidate same execution =>
            j(same, λ actual _ =>
                (after_right = execute_near_control(actual, before_right)) →
                SameDefinedState<M>(after_left, after_right),
                λ agreed => same_defined_trans(after_left, execute_near_control(left, before_left),
                    after_right, same_defined_of_equal(after_left, execute_near_control(left, before_left), left_exec),
                    same_defined_trans(execute_near_control(left, before_left),
                        execute_near_control(left, before_right), after_right,
                        near_control_respects_defined(left, before_left, before_right, before_same),
                        same_defined_of_equal(execute_near_control(left, before_right), after_right, sym(agreed)))))(execution);
    runner(right, control, right_exec)
}
// `n` fetched steps, and a run of any length. Counting keeps concatenation a
// plain induction, as LoopRuns does for iterations.
fn FetchedRuns<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, n: Nat) →
    MachineState<M> → MachineState<M> → Type {
    match n {
        Zero => λ before after => before = after,
        Succ(k) => λ before after => Exists<MachineState<M>>(λ middle =>
            FetchedStep(fetch, data, before, middle) ∧ FetchedRuns(fetch, data, k, middle, after)),
    }
}
fn FetchedSteps<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, before, after: MachineState<M>) → Type {
    Exists<Nat>(λ n => FetchedRuns(fetch, data, n, before, after))
}

theorem fetched_steps_refl<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, state: MachineState<M>):
    FetchedSteps(fetch, data, state, state) { Exists(Zero, refl) }

theorem fetched_steps_cons<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, before, middle, after: MachineState<M>,
    step: FetchedStep(fetch, data, before, middle), rest: FetchedSteps(fetch, data, middle, after)):
    FetchedSteps(fetch, data, before, after) {
    Exists(Succ(rest.witness), Exists(middle, ⟨step, rest.proof⟩))
}

theorem fetched_runs_append<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, n: Nat):
    (before, middle, after: MachineState<M>) → FetchedRuns(fetch, data, n, before, middle) →
    FetchedSteps(fetch, data, middle, after) → FetchedSteps(fetch, data, before, after) {
    match n {
        Zero => λ before middle after same rest =>
            j(sym(same), λ state _ => FetchedSteps(fetch, data, state, after), rest),
        Succ(k) => λ before middle after runs rest =>
            fetched_steps_cons(fetch, data, before, runs.witness, after, runs.proof.left,
                fetched_runs_append(fetch, data, k, runs.witness, middle, after, runs.proof.right, rest)),
    }
}
theorem fetched_steps_trans<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, before, middle, after: MachineState<M>,
    first: FetchedSteps(fetch, data, before, middle), second: FetchedSteps(fetch, data, middle, after)):
    FetchedSteps(fetch, data, before, after) {
    fetched_runs_append(fetch, data, first.witness, before, middle, after, first.proof, second)
}

// Residency: every byte reads back, is executable, and the address after it
// does not wrap. The uniform tail makes append splitting a plain induction.
fn CodeResident<M>(fetch: FetchAccess<M>, memory: M, bytes: List<BitVec(8)>) → BitVec(64) → Type {
    match bytes {
        Nil => λ start => True,
        Cons(byte, rest) => λ start =>
            fetch.executable(memory, start) = True ∧
            (fetch.read_byte(memory, start) = Some(byte) ∧
            (start.carry_add_bit(BitVec::ofNat(1)) = False ∧
            CodeResident(fetch, memory, rest, next_rip(start, 1)))),
    }
}

theorem one_add(k: Nat): 1 + k = Succ(k) {
    trans(Nat::add_succ_left(0, k), Nat::cong_succ(Nat::add_left_zero(k)))
}

theorem resident_split<M>(fetch: FetchAccess<M>, memory: M, prefix, tail: List<BitVec(8)>):
    (start: BitVec(64)) → CodeResident(fetch, memory, prefix ++ tail, start) →
    CodeResident(fetch, memory, prefix, start) ∧
    CodeResident(fetch, memory, tail, next_rip(start, prefix.len())) {
    match prefix {
        Nil => λ start resident => ⟨trivial, resident⟩,
        Cons(_, rest) => λ start resident => {
            let inner = resident_split(fetch, memory, rest, tail, next_rip(start, 1), resident.right.right.right);
            ⟨⟨resident.left, ⟨resident.right.left, ⟨resident.right.right.left, inner.left⟩⟩⟩,
             j(trans(BitVec::iterate_increment_compose(64, start, 1, rest.len()),
                    BitVec::cong_iterate_increment_count(64, start, one_add(rest.len()))),
                λ address _ => CodeResident(fetch, memory, tail, address), inner.right)⟩
        },
    }
}

// A resident span is readable in the sense `FetchedFrom` states.
theorem resident_readable<M>(fetch: FetchAccess<M>, memory: M, bytes: List<BitVec(8)>):
    (start: BitVec(64)) → CodeResident(fetch, memory, bytes, start) →
    ReadableBytes(fetch, memory, bytes, start) {
    match bytes {
        Nil => λ start resident => trivial,
        Cons(_, rest) => λ start resident => {
            let inner = resident_readable(fetch, memory, rest, next_rip(start, 1), resident.right.right.right);
            ⟨resident.left, ⟨resident.right.left,
                match rest as λ remaining => match remaining as λ _ => Type {
                    Nil => True,
                    Cons(_, _) => start.carry_add_bit(BitVec::ofNat(1)) = False ∧
                        ReadableBytes(fetch, memory, rest, next_rip(start, 1)),
                } {
                    Nil => trivial,
                    Cons(_, _) => ⟨resident.right.right.left, inner⟩,
                }⟩⟩
        },
    }
}

// One canonical instruction, resident at the state's rip, is a fetched step.
theorem ordinary_fetched_step<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, instruction: Instruction,
    before: MachineState<M>, resident: CodeResident(fetch, before.memory, canonical_bytes(instruction), before.rip)):
    FetchedStep(fetch, data, before, execute_normal(decoded_canonical(instruction), before)) {
    Exists(EmitOrdinary(instruction),
        ⟨FetchedFrom(resident_readable(fetch, before.memory, canonical_bytes(instruction), before.rip, resident)),
         canonical_encoding_executes(instruction, before)⟩)
}

theorem resident_state<M>(fetch: FetchAccess<M>, bytes: List<BitVec(8)>, memory: M, address: BitVec(64),
    state: MachineState<M>, memory_same: state.memory = memory, rip_same: state.rip = address,
    resident: CodeResident(fetch, memory, bytes, address)): CodeResident(fetch, state.memory, bytes, state.rip) {
    j(sym(memory_same), λ current _ => CodeResident(fetch, current, bytes, state.rip),
        j(sym(rip_same), λ current _ => CodeResident(fetch, memory, bytes, current), resident))
}
theorem rip_compose(start: BitVec(64), first, second: Nat):
    next_rip(next_rip(start, first), second) = next_rip(start, first + second) {
    BitVec::iterate_increment_compose(64, start, first, second)
}
theorem rip_count(start: BitVec(64), {first, second: Nat}, same: first = second):
    next_rip(start, first) = next_rip(start, second) {
    BitVec::cong_iterate_increment_count(64, start, same)
}
theorem short_fetched_step<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, control: ShortControl,
    before: MachineState<M>, resident: CodeResident(fetch, before.memory, short_control_bytes(control), before.rip)):
    FetchedStep(fetch, data, before, execute_short_control(control, before)) {
    Exists(EmitShort(control),
        ⟨FetchedFrom(resident_readable(fetch, before.memory, short_control_bytes(control), before.rip, resident)), refl⟩)
}
theorem near_fetched_step<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, control: NearControl,
    before: MachineState<M>, resident: CodeResident(fetch, before.memory, near_control_bytes(control), before.rip)):
    FetchedStep(fetch, data, before, execute_near_control(control, before)) {
    Exists(EmitNear(control),
        ⟨FetchedFrom(resident_readable(fetch, before.memory, near_control_bytes(control), before.rip, resident)), refl⟩)
}
theorem fetched_steps_one<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, before, after: MachineState<M>,
    step: FetchedStep(fetch, data, before, after)): FetchedSteps(fetch, data, before, after) {
    fetched_steps_cons(fetch, data, before, after, after, step, fetched_steps_refl(fetch, data, after))
}

theorem resident_split_at<M>(fetch: FetchAccess<M>, memory: M, prefix, tail: List<BitVec(8)>, origin: BitVec(64), offset: Nat,
    resident: CodeResident(fetch, memory, prefix ++ tail, next_rip(origin, offset))):
    CodeResident(fetch, memory, prefix, next_rip(origin, offset)) ∧
    CodeResident(fetch, memory, tail, next_rip(origin, offset + prefix.len())) {
    let parts = resident_split(fetch, memory, prefix, tail, next_rip(origin, offset), resident);
    ⟨parts.left, j(rip_compose(origin, offset, prefix.len()), λ address _ => CodeResident(fetch, memory, tail, address), parts.right)⟩
}
// TEST of a register with itself sets ZF exactly when its value is zero: the
// test a loop over syscall returns makes of RAX.
theorem test_self_zero(n: Nat): (x: BitVec(n)) → x.toNat() = 0 → is_zero_bits(n, x.band(x)) = True {
    match n as λ k => (x: BitVec(k)) → x.toNat() = 0 → is_zero_bits(k, x.band(x)) = True {
        Zero => λ x zero => refl,
        Succ(k, ih) => λ x zero => {
            let t = x.tail_bits();
            (match x.head_bit() as λ h => Nat::of_bit(h) + t.toNat().twice() = 0 →
                    (h && h).not() && is_zero_bits(k, t.band(t)) = True {
                False => λ sum => {
                    let doubled: (t.toNat() + t.toNat() = 0) =
                        trans(sym(Nat::twice_add_self(t.toNat())), trans(sym(Nat::add_left_zero(t.toNat().twice())), sum));
                    let none: (t.toNat() = 0) = omega;
                    ih(t, none)
                },
                // `omega` keeps a closed `of_bit(True)` as an atom: spelled as 1.
                True => λ sum => {
                    let one: (1 + t.toNat().twice() = 0) = sum;
                    let bad: False = omega;
                    false_elim(bad)
                },
            })(zero)
        },
    }
}
theorem test_self_nonzero(n: Nat): (x: BitVec(n)) → 0 < x.toNat() → is_zero_bits(n, x.band(x)) = False {
    match n as λ k => (x: BitVec(k)) → 0 < x.toNat() → is_zero_bits(k, x.band(x)) = False {
        Zero => λ x some => { let bad: False = omega; false_elim(bad) },
        Succ(k, ih) => λ x some => {
            let t = x.tail_bits();
            (match x.head_bit() as λ h => 0 < Nat::of_bit(h) + t.toNat().twice() →
                    (h && h).not() && is_zero_bits(k, t.band(t)) = False {
                False => λ sum => {
                    let s0: (0 < t.toNat().twice()) = j(Nat::add_left_zero(t.toNat().twice()), λ v _ => 0 < v, sum);
                    let doubled: (0 < t.toNat() + t.toNat()) = j(Nat::twice_add_self(t.toNat()), λ v _ => 0 < v, s0);
                    let part: (0 < t.toNat()) = omega;
                    ih(t, part)
                },
                True => λ sum => refl,
            })(some)
        },
    }
}

// ZF reads a word's value: set exactly at zero.
theorem zero_bits_of_zero(n: Nat): (x: BitVec(n)) → x.toNat() = 0 → is_zero_bits(n, x) = True {
    match n as λ k => (x: BitVec(k)) → x.toNat() = 0 → is_zero_bits(k, x) = True {
        Zero => λ x zero => refl,
        Succ(k, ih) => λ x zero => {
            let t = x.tail_bits();
            (match x.head_bit() as λ h => Nat::of_bit(h) + t.toNat().twice() = 0 → h.not() && is_zero_bits(k, t) = True {
                False => λ sum => {
                    let two: (t.toNat().twice() = t.toNat() + t.toNat()) = Nat::twice_add_self(t.toNat());
                    let none: (t.toNat() = 0) = { let s: (0 + t.toNat().twice() = 0) = sum; omega };
                    ih(t, none)
                },
                True => λ sum => false_elim({ let one: (1 + t.toNat().twice() = 0) = sum; omega }),
            })(zero)
        },
    }
}
theorem zero_bits_of_pos(n: Nat): (x: BitVec(n)) → 0 < x.toNat() → is_zero_bits(n, x) = False {
    match n as λ k => (x: BitVec(k)) → 0 < x.toNat() → is_zero_bits(k, x) = False {
        Zero => λ x some => false_elim({ let z: (0 < 0) = some; omega }),
        Succ(k, ih) => λ x some => {
            let t = x.tail_bits();
            (match x.head_bit() as λ h => 0 < Nat::of_bit(h) + t.toNat().twice() → h.not() && is_zero_bits(k, t) = False {
                False => λ sum => {
                    let two: (t.toNat().twice() = t.toNat() + t.toNat()) = Nat::twice_add_self(t.toNat());
                    ih(t, { let s: (0 < 0 + t.toNat().twice()) = sum; omega })
                },
                True => λ sum => refl,
            })(some)
        },
    }
}

// SF reads a word's value: set exactly in the top half of its range, which
// is where a syscall's negated errno lands and a count never does.
theorem bit_value_le_one(b: Bool): Nat::of_bit(b) <= 1 {
    match b as λ c => Nat::of_bit(c) <= 1 { False => { omega }, True => { omega } }
}
theorem sign_bit_small(k: Nat): (x: BitVec(Succ(k))) → x.toNat() < Nat::pow(2, k) → x.sign_bit() = False {
    match k as λ j => (x: BitVec(Succ(j))) → x.toNat() < Nat::pow(2, j) → x.sign_bit() = False {
        Zero => λ x small => (match x.head_bit() as λ h => Nat::of_bit(h) + 0 < 1 → h = False {
            False => λ _ => refl,
            True => λ over => false_elim({ let one: (1 + 0 < 1) = over; omega }),
        })(small),
        Succ(j, ih) => λ x small => {
            let t = x.tail_bits();
            let pow: (Nat::pow(2, Succ(j)) = Nat::twice(Nat::pow(2, j))) = BitVec::pow_two_succ_twice(j);
            let sum: (Nat::of_bit(x.head_bit()) + t.toNat().twice() < Nat::pow(2, Succ(j))) = small;
            let bit: (Nat::of_bit(x.head_bit()) <= 1) = bit_value_le_one(x.head_bit());
            let two: (t.toNat().twice() = t.toNat() + t.toNat()) = Nat::twice_add_self(t.toNat());
            let ptwo: (Nat::twice(Nat::pow(2, j)) = Nat::pow(2, j) + Nat::pow(2, j)) = Nat::twice_add_self(Nat::pow(2, j));
            ih(t, { omega })
        },
    }
}
theorem sign_bit_large(k: Nat): (x: BitVec(Succ(k))) → Nat::pow(2, k) <= x.toNat() → x.sign_bit() = True {
    match k as λ j => (x: BitVec(Succ(j))) → Nat::pow(2, j) <= x.toNat() → x.sign_bit() = True {
        Zero => λ x large => (match x.head_bit() as λ h => 1 <= Nat::of_bit(h) + 0 → h = True {
            True => λ _ => refl,
            False => λ under => false_elim({ let zero: (1 <= 0 + 0) = under; omega }),
        })(large),
        Succ(j, ih) => λ x large => {
            let t = x.tail_bits();
            let pow: (Nat::pow(2, Succ(j)) = Nat::twice(Nat::pow(2, j))) = BitVec::pow_two_succ_twice(j);
            let sum: (Nat::pow(2, Succ(j)) <= Nat::of_bit(x.head_bit()) + t.toNat().twice()) = large;
            let bit: (Nat::of_bit(x.head_bit()) <= 1) = bit_value_le_one(x.head_bit());
            let two: (t.toNat().twice() = t.toNat() + t.toNat()) = Nat::twice_add_self(t.toNat());
            let ptwo: (Nat::twice(Nat::pow(2, j)) = Nat::pow(2, j) + Nat::pow(2, j)) = Nat::twice_add_self(Nat::pow(2, j));
            ih(t, { omega })
        },
    }
}
theorem band_self_value(n: Nat): (x: BitVec(n)) → x.band(x).toNat() = x.toNat() {
    match n as λ k => (x: BitVec(k)) → x.band(x).toNat() = x.toNat() {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => {
            let t = x.tail_bits();
            let same: (Nat::of_bit(x.head_bit() && x.head_bit()) = Nat::of_bit(x.head_bit())) =
                match x.head_bit() as λ h => Nat::of_bit(h && h) = Nat::of_bit(h) { False => refl, True => refl };
            let rest: (t.band(t).toNat() = t.toNat()) = ih(t);
            let two: (t.toNat().twice() = t.toNat() + t.toNat()) = Nat::twice_add_self(t.toNat());
            let two_and: (t.band(t).toNat().twice() = t.band(t).toNat() + t.band(t).toNat()) = Nat::twice_add_self(t.band(t).toNat());
            let goal: (Nat::of_bit(x.head_bit() && x.head_bit()) + t.band(t).toNat().twice() =
                Nat::of_bit(x.head_bit()) + t.toNat().twice()) = { omega };
            goal
        },
    }
}
// TEST of a register with itself: SF is the value's top-half test.
theorem test_self_negative(x: BitVec(64), large: Nat::pow(2, 63) <= x.toNat()): x.band(x).sign_bit() = True {
    sign_bit_large(63, x.band(x), j(sym(band_self_value(64, x)), λ v _ => Nat::pow(2, 63) <= v, large))
}
theorem test_self_nonnegative(x: BitVec(64), small: x.toNat() < Nat::pow(2, 63)): x.band(x).sign_bit() = False {
    sign_bit_small(63, x.band(x), j(sym(band_self_value(64, x)), λ v _ => v < Nat::pow(2, 63), small))
}

theorem near_sign_taken_rip<M>(displacement: BitVec(32), state: MachineState<M>, selected: state.flags.sf = True):
    execute_near_control(JumpSignNear(displacement), state).rip = near_branch_target(state.rip, 6, displacement) {
    j(sym(selected), λ sf _ => (match sf { False => next_rip(state.rip, 6), True => near_branch_target(state.rip, 6, displacement) }) =
        near_branch_target(state.rip, 6, displacement), refl)
}
theorem near_sign_not_taken_rip<M>(displacement: BitVec(32), state: MachineState<M>, selected: state.flags.sf = False):
    execute_near_control(JumpSignNear(displacement), state).rip = next_rip(state.rip, 6) {
    j(sym(selected), λ sf _ => (match sf { False => next_rip(state.rip, 6), True => near_branch_target(state.rip, 6, displacement) }) =
        next_rip(state.rip, 6), refl)
}

// A rip reached as `next_rip(origin, a)` and then advanced by `b`.
theorem rip_advance(origin, address: BitVec(64), a, b: Nat, at: address = next_rip(origin, a)):
    next_rip(address, b) = next_rip(origin, a + b) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ current => next_rip(current, b), at), rip_compose(origin, a, b))
}

// A conditional's bytes: TEST, JZ over the true arm, the true arm, JMP over
// the false arm, the false arm. StructuredCode and AccessCode spell theirs
// this way, so both use the lemmas below with their children's bytes.
fn branch_bytes(register: Gpr, fd, jd: BitVec(8), yes, no: List<BitVec(8)>) → List<BitVec(8)> {
    canonical_bytes(TestRR(register, register)) ++ (short_control_bytes(JumpZero(fd)) ++
        (yes ++ (short_control_bytes(Jump(jd)) ++ no)))
}
theorem branch_bytes_len(register: Gpr, fd, jd: BitVec(8), yes, no: List<BitVec(8)>):
    branch_bytes(register, fd, jd, yes, no).len() = 3 + (2 + (yes.len() + (2 + no.len()))) {
    let tail = short_control_bytes(Jump(jd)) ++ no;
    let body = yes ++ tail;
    let rest = short_control_bytes(JumpZero(fd)) ++ body;
    trans(List::len_append(canonical_bytes(TestRR(register, register)), rest),
        cong_fn<Nat, Nat>(λ n => 3 + n, trans(List::len_append(short_control_bytes(JumpZero(fd)), body),
            cong_fn<Nat, Nat>(λ n => 2 + n, trans(List::len_append(yes, tail),
                cong_fn<Nat, Nat>(λ n => yes.len() + n, List::len_append(short_control_bytes(Jump(jd)), no)))))))
}
theorem branch_count_fallthrough(y, n: Nat): ((3 + 2) + y) + (2 + n) = 3 + (2 + (y + (2 + n))) { omega }
theorem branch_count_taken(y, n: Nat): (3 + (2 + (y + 2))) + n = 3 + (2 + (y + (2 + n))) { omega }

// Where each piece of a conditional starts, from the state before its TEST.
fn branch_yes_at<M>(register: Gpr, before: MachineState<M>) → BitVec(64) {
    next_rip(structured_test(register, before).rip, 2)
}
fn branch_jump_at<M>(register: Gpr, yes: List<BitVec(8)>, before: MachineState<M>) → BitVec(64) {
    next_rip(branch_yes_at(register, before), yes.len())
}
fn branch_no_at<M>(register: Gpr, yes: List<BitVec(8)>, before: MachineState<M>) → BitVec(64) {
    next_rip(branch_jump_at(register, yes, before), 2)
}

// TEST and JZ run fetched, and each remaining piece is resident where it starts.
theorem branch_entry_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(8),
    yes, no: List<BitVec(8)>, before: MachineState<M>,
    resident: CodeResident(fetch, before.memory, branch_bytes(register, fd, jd, yes, no), before.rip)):
    FetchedSteps(fetch, data, before, structured_branch_entry(register, fd, before)) ∧
    (CodeResident(fetch, before.memory, yes, branch_yes_at(register, before)) ∧
    (CodeResident(fetch, before.memory, short_control_bytes(Jump(jd)), branch_jump_at(register, yes, before)) ∧
    CodeResident(fetch, before.memory, no, branch_no_at(register, yes, before)))) {
    let test_bytes = canonical_bytes(TestRR(register, register));
    let jz = short_control_bytes(JumpZero(fd));
    let jmp = short_control_bytes(Jump(jd));
    let r0 = resident_split(fetch, before.memory, test_bytes, jz ++ (yes ++ (jmp ++ no)), before.rip, resident);
    let tested = structured_test(register, before);
    let r1 = resident_split(fetch, before.memory, jz, yes ++ (jmp ++ no), tested.rip, r0.right);
    let r2 = resident_split(fetch, before.memory, yes, jmp ++ no, next_rip(tested.rip, 2), r1.right);
    let r3 = resident_split(fetch, before.memory, jmp, no, next_rip(next_rip(tested.rip, 2), yes.len()), r2.right);
    let entry = structured_branch_entry(register, fd, before);
    ⟨fetched_steps_cons(fetch, data, before, tested, entry,
        ordinary_fetched_step(fetch, data, TestRR(register, register), before, r0.left),
        fetched_steps_one(fetch, data, tested, entry, short_fetched_step(fetch, data, JumpZero(fd), tested, r1.left))),
     ⟨r2.left, ⟨r3.left, r3.right⟩⟩⟩
}

theorem branch_taken_entry<M>(register: Gpr, fd: BitVec(8), yes: List<BitVec(8)>, before: MachineState<M>,
    over: (start: BitVec(64)) → short_branch_target(start, fd) = next_rip(start, 2 + (yes.len() + 2)),
    taken: structured_test(register, before).flags.zf = True):
    structured_branch_entry(register, fd, before).rip = branch_no_at(register, yes, before) {
    let tested = structured_test(register, before);
    trans(jump_zero_taken_rip(tested.flags.zf, tested.rip, fd, taken),
        trans(over(tested.rip), sym(trans(rip_compose(next_rip(tested.rip, 2), yes.len(), 2),
            rip_compose(tested.rip, 2, yes.len() + 2)))))
}

// The true arm ran from its start to `done`; the JMP to the join closes it.
theorem branch_fallthrough_close<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(8),
    yes, no: List<BitVec(8)>, join: (start: BitVec(64)) → short_branch_target(start, jd) = next_rip(start, 2 + no.len()),
    before, done: MachineState<M>,
    entry_steps: FetchedSteps(fetch, data, before, structured_branch_entry(register, fd, before)),
    arm_steps: FetchedSteps(fetch, data, structured_branch_entry(register, fd, before), done),
    jump_resident: CodeResident(fetch, before.memory, short_control_bytes(Jump(jd)), branch_jump_at(register, yes, before)),
    done_memory: done.memory = before.memory, done_rip: done.rip = branch_jump_at(register, yes, before)):
    FetchedSteps(fetch, data, before, execute_short_control(Jump(jd), done)) ∧
    execute_short_control(Jump(jd), done).rip = next_rip(before.rip, branch_bytes(register, fd, jd, yes, no).len()) {
    let entry = structured_branch_entry(register, fd, before);
    let after = execute_short_control(Jump(jd), done);
    let y = yes.len();
    let n = no.len();
    let jump = short_fetched_step(fetch, data, Jump(jd), done,
        resident_state(fetch, short_control_bytes(Jump(jd)), before.memory, branch_jump_at(register, yes, before), done,
            done_memory, done_rip, jump_resident));
    ⟨fetched_steps_trans(fetch, data, before, entry, after, entry_steps,
        fetched_steps_trans(fetch, data, entry, done, after, arm_steps, fetched_steps_one(fetch, data, done, after, jump))),
     trans(join(done.rip),
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, 2 + n), done_rip),
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, 2 + n),
                trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, y), rip_compose(before.rip, 3, 2)),
                    rip_compose(before.rip, 3 + 2, y))),
        trans(rip_compose(before.rip, (3 + 2) + y, 2 + n),
            trans(rip_count(before.rip, branch_count_fallthrough(y, n)),
                rip_count(before.rip, sym(branch_bytes_len(register, fd, jd, yes, no))))))))⟩
}

// The false arm ran from its start to `after`, which is the join.
theorem branch_taken_close<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(8),
    yes, no: List<BitVec(8)>, before, after: MachineState<M>,
    entry_steps: FetchedSteps(fetch, data, before, structured_branch_entry(register, fd, before)),
    arm_steps: FetchedSteps(fetch, data, structured_branch_entry(register, fd, before), after),
    after_rip: after.rip = next_rip(branch_no_at(register, yes, before), no.len())):
    FetchedSteps(fetch, data, before, after) ∧
    after.rip = next_rip(before.rip, branch_bytes(register, fd, jd, yes, no).len()) {
    let y = yes.len();
    let n = no.len();
    let tested = structured_test(register, before);
    ⟨fetched_steps_trans(fetch, data, before, structured_branch_entry(register, fd, before), after, entry_steps, arm_steps),
     trans(after_rip,
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, n),
            trans(rip_compose(next_rip(tested.rip, 2), y, 2), trans(rip_compose(tested.rip, 2, y + 2),
                rip_compose(before.rip, 3, 2 + (y + 2))))),
        trans(rip_compose(before.rip, 3 + (2 + (y + 2)), n),
            trans(rip_count(before.rip, branch_count_taken(y, n)),
                rip_count(before.rip, sym(branch_bytes_len(register, fd, jd, yes, no)))))))⟩
}

// The near conditional's pieces: TEST, JZ rel32, the true arm, JMP rel32, the
// false arm; the same lemmas at lengths 6 and 5.
fn branch_near_bytes(register: Gpr, fd, jd: BitVec(32), yes, no: List<BitVec(8)>) → List<BitVec(8)> {
    canonical_bytes(TestRR(register, register)) ++ (near_control_bytes(JumpZeroNear(fd)) ++
        (yes ++ (near_control_bytes(JumpNear(jd)) ++ no)))
}
theorem branch_near_bytes_len(register: Gpr, fd, jd: BitVec(32), yes, no: List<BitVec(8)>):
    branch_near_bytes(register, fd, jd, yes, no).len() = 3 + (6 + (yes.len() + (5 + no.len()))) {
    let tail = near_control_bytes(JumpNear(jd)) ++ no;
    let body = yes ++ tail;
    let rest = near_control_bytes(JumpZeroNear(fd)) ++ body;
    trans(List::len_append(canonical_bytes(TestRR(register, register)), rest),
        cong_fn<Nat, Nat>(λ n => 3 + n, trans(List::len_append(near_control_bytes(JumpZeroNear(fd)), body),
            cong_fn<Nat, Nat>(λ n => 6 + n, trans(List::len_append(yes, tail),
                cong_fn<Nat, Nat>(λ n => yes.len() + n, List::len_append(near_control_bytes(JumpNear(jd)), no)))))))
}
theorem branch_near_count_fallthrough(y, n: Nat): ((3 + 6) + y) + (5 + n) = 3 + (6 + (y + (5 + n))) { omega }
theorem branch_near_count_taken(y, n: Nat): (3 + (6 + (y + 5))) + n = 3 + (6 + (y + (5 + n))) { omega }

fn branch_near_yes_at<M>(register: Gpr, before: MachineState<M>) → BitVec(64) {
    next_rip(structured_test(register, before).rip, 6)
}
fn branch_near_jump_at<M>(register: Gpr, yes: List<BitVec(8)>, before: MachineState<M>) → BitVec(64) {
    next_rip(branch_near_yes_at(register, before), yes.len())
}
fn branch_near_no_at<M>(register: Gpr, yes: List<BitVec(8)>, before: MachineState<M>) → BitVec(64) {
    next_rip(branch_near_jump_at(register, yes, before), 5)
}

theorem branch_near_entry_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(32),
    yes, no: List<BitVec(8)>, before: MachineState<M>,
    resident: CodeResident(fetch, before.memory, branch_near_bytes(register, fd, jd, yes, no), before.rip)):
    FetchedSteps(fetch, data, before, structured_near_entry(register, fd, before)) ∧
    (CodeResident(fetch, before.memory, yes, branch_near_yes_at(register, before)) ∧
    (CodeResident(fetch, before.memory, near_control_bytes(JumpNear(jd)), branch_near_jump_at(register, yes, before)) ∧
    CodeResident(fetch, before.memory, no, branch_near_no_at(register, yes, before)))) {
    let test_bytes = canonical_bytes(TestRR(register, register));
    let jz = near_control_bytes(JumpZeroNear(fd));
    let jmp = near_control_bytes(JumpNear(jd));
    let r0 = resident_split(fetch, before.memory, test_bytes, jz ++ (yes ++ (jmp ++ no)), before.rip, resident);
    let tested = structured_test(register, before);
    let r1 = resident_split(fetch, before.memory, jz, yes ++ (jmp ++ no), tested.rip, r0.right);
    let r2 = resident_split(fetch, before.memory, yes, jmp ++ no, next_rip(tested.rip, 6), r1.right);
    let r3 = resident_split(fetch, before.memory, jmp, no, next_rip(next_rip(tested.rip, 6), yes.len()), r2.right);
    let entry = structured_near_entry(register, fd, before);
    ⟨fetched_steps_cons(fetch, data, before, tested, entry,
        ordinary_fetched_step(fetch, data, TestRR(register, register), before, r0.left),
        fetched_steps_one(fetch, data, tested, entry, near_fetched_step(fetch, data, JumpZeroNear(fd), tested, r1.left))),
     ⟨r2.left, ⟨r3.left, r3.right⟩⟩⟩
}

theorem branch_near_taken_entry<M>(register: Gpr, fd: BitVec(32), yes: List<BitVec(8)>, before: MachineState<M>,
    over: (start: BitVec(64)) → near_branch_target(start, 6, fd) = next_rip(start, 6 + (yes.len() + 5)),
    taken: structured_test(register, before).flags.zf = True):
    structured_near_entry(register, fd, before).rip = branch_near_no_at(register, yes, before) {
    let tested = structured_test(register, before);
    trans(near_taken_rip(fd, tested, taken),
        trans(over(tested.rip), sym(trans(rip_compose(next_rip(tested.rip, 6), yes.len(), 5),
            rip_compose(tested.rip, 6, yes.len() + 5)))))
}

theorem branch_near_fallthrough_close<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(32),
    yes, no: List<BitVec(8)>, join: (start: BitVec(64)) → near_branch_target(start, 5, jd) = next_rip(start, 5 + no.len()),
    before, done: MachineState<M>,
    entry_steps: FetchedSteps(fetch, data, before, structured_near_entry(register, fd, before)),
    arm_steps: FetchedSteps(fetch, data, structured_near_entry(register, fd, before), done),
    jump_resident: CodeResident(fetch, before.memory, near_control_bytes(JumpNear(jd)), branch_near_jump_at(register, yes, before)),
    done_memory: done.memory = before.memory, done_rip: done.rip = branch_near_jump_at(register, yes, before)):
    FetchedSteps(fetch, data, before, execute_near_control(JumpNear(jd), done)) ∧
    execute_near_control(JumpNear(jd), done).rip = next_rip(before.rip, branch_near_bytes(register, fd, jd, yes, no).len()) {
    let entry = structured_near_entry(register, fd, before);
    let after = execute_near_control(JumpNear(jd), done);
    let y = yes.len();
    let n = no.len();
    let jump = near_fetched_step(fetch, data, JumpNear(jd), done,
        resident_state(fetch, near_control_bytes(JumpNear(jd)), before.memory, branch_near_jump_at(register, yes, before), done,
            done_memory, done_rip, jump_resident));
    ⟨fetched_steps_trans(fetch, data, before, entry, after, entry_steps,
        fetched_steps_trans(fetch, data, entry, done, after, arm_steps, fetched_steps_one(fetch, data, done, after, jump))),
     trans(join(done.rip),
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, 5 + n), done_rip),
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, 5 + n),
                trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, y), rip_compose(before.rip, 3, 6)),
                    rip_compose(before.rip, 3 + 6, y))),
        trans(rip_compose(before.rip, (3 + 6) + y, 5 + n),
            trans(rip_count(before.rip, branch_near_count_fallthrough(y, n)),
                rip_count(before.rip, sym(branch_near_bytes_len(register, fd, jd, yes, no))))))))⟩
}

theorem branch_near_taken_close<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, register: Gpr, fd, jd: BitVec(32),
    yes, no: List<BitVec(8)>, before, after: MachineState<M>,
    entry_steps: FetchedSteps(fetch, data, before, structured_near_entry(register, fd, before)),
    arm_steps: FetchedSteps(fetch, data, structured_near_entry(register, fd, before), after),
    after_rip: after.rip = next_rip(branch_near_no_at(register, yes, before), no.len())):
    FetchedSteps(fetch, data, before, after) ∧
    after.rip = next_rip(before.rip, branch_near_bytes(register, fd, jd, yes, no).len()) {
    let y = yes.len();
    let n = no.len();
    let tested = structured_test(register, before);
    ⟨fetched_steps_trans(fetch, data, before, structured_near_entry(register, fd, before), after, entry_steps, arm_steps),
     trans(after_rip,
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, n),
            trans(rip_compose(next_rip(tested.rip, 6), y, 5), trans(rip_compose(tested.rip, 6, y + 5),
                rip_compose(before.rip, 3, 6 + (y + 5))))),
        trans(rip_compose(before.rip, 3 + (6 + (y + 5)), n),
            trans(rip_count(before.rip, branch_near_count_taken(y, n)),
                rip_count(before.rip, sym(branch_near_bytes_len(register, fd, jd, yes, no)))))))⟩
}

// ---- StructuredCode ----

// A pure tree runs fetched from its start to `structured_after`, ending just
// past its bytes.
fn StructuredFetches<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, code: StructuredCode) → Type {
    (before: MachineState<M>) → StructuredLayout(code) →
    CodeResident(fetch, before.memory, structured_bytes(code), before.rip) →
    FetchedSteps(fetch, data, before, structured_after(code, before)) ∧
    structured_after(code, before).rip = next_rip(before.rip, structured_bytes(code).len())
}

theorem block_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, instructions: List<Instruction>):
    StructuredFetches(fetch, data, CodeBlock(instructions)) {
    match instructions {
        Nil => λ before layout resident => ⟨fetched_steps_refl(fetch, data, before), refl⟩,
        Cons(instruction, rest) => λ before layout resident => {
            let middle = execute_normal(decoded_canonical(instruction), before);
            let parts = resident_split(fetch, before.memory, canonical_bytes(instruction),
                canonical_block_bytes(rest), before.rip, resident);
            let advanced: (next_rip(before.rip, canonical_bytes(instruction).len()) = middle.rip) =
                trans(rip_count(before.rip, canonical_bytes_length(instruction)),
                    sym(execute_normal_advances_rip(decoded_canonical(instruction), before)));
            let tail = block_fetched(fetch, data, rest, middle, trivial,
                j(advanced, λ address _ => CodeResident(fetch, before.memory, canonical_block_bytes(rest), address), parts.right));
            ⟨fetched_steps_cons(fetch, data, before, middle, execute_block_normal(rest, middle),
                ordinary_fetched_step(fetch, data, instruction, before, parts.left), tail.left),
             trans(tail.right, trans(
                cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, canonical_block_bytes(rest).len()), sym(advanced)),
                trans(rip_compose(before.rip, canonical_bytes(instruction).len(), canonical_block_bytes(rest).len()),
                    rip_count(before.rip, sym(List::len_append(canonical_bytes(instruction), canonical_block_bytes(rest)))))))⟩
        },
    }
}

theorem structured_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, code: StructuredCode):
    StructuredFetches(fetch, data, code) {
    match code {
        CodeBlock(instructions) => block_fetched(fetch, data, instructions),
        CodeSequence(prefix, tail) => λ before layout resident => {
            let parts = resident_split(fetch, before.memory, structured_bytes(prefix), structured_bytes(tail), before.rip, resident);
            let first = structured_fetched(fetch, data, prefix, before, layout.left, parts.left);
            let middle = structured_after(prefix, before);
            let second = structured_fetched(fetch, data, tail, middle, layout.right,
                resident_state(fetch, structured_bytes(tail), before.memory, next_rip(before.rip, structured_bytes(prefix).len()),
                    middle, pure_structured_memory(prefix, before), first.right, parts.right));
            ⟨fetched_steps_trans(fetch, data, before, middle, structured_after(tail, middle), first.left, second.left),
             trans(second.right, trans(rip_advance(before.rip, middle.rip, structured_bytes(prefix).len(), structured_bytes(tail).len(), first.right),
                rip_count(before.rip, sym(List::len_append(structured_bytes(prefix), structured_bytes(tail))))))⟩
        },
        CodeBranch(register, fd, jd, yes, no) => λ before layout resident => {
            let parts = branch_entry_fetched(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), before, resident);
            let entry = structured_branch_entry(register, fd, before);
            let tested = structured_test(register, before);
            structured_branch_cases(register, fd, jd, yes, no, before,
                λ state => FetchedSteps(fetch, data, before, state) ∧
                    state.rip = next_rip(before.rip, structured_bytes(CodeBranch(register, fd, jd, yes, no)).len()),
                λ not_taken => {
                    let entry_rip: (entry.rip = branch_yes_at(register, before)) =
                        jump_zero_not_taken_rip(tested.flags.zf, tested.rip, fd, not_taken);
                    let arm = structured_fetched(fetch, data, yes, entry, layout.right.right.left,
                        resident_state(fetch, structured_bytes(yes), before.memory, branch_yes_at(register, before), entry, refl, entry_rip, parts.right.left));
                    branch_fallthrough_close(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), layout.right.left,
                        before, structured_after(yes, entry), parts.left, arm.left, parts.right.right.left,
                        pure_structured_memory(yes, entry),
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, structured_bytes(yes).len()), entry_rip)))
                },
                λ taken => {
                    let entry_rip = branch_taken_entry(register, fd, structured_bytes(yes), before, layout.left, taken);
                    let arm = structured_fetched(fetch, data, no, entry, layout.right.right.right,
                        resident_state(fetch, structured_bytes(no), before.memory, branch_no_at(register, structured_bytes(yes), before),
                            entry, refl, entry_rip, parts.right.right.right));
                    branch_taken_close(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), before,
                        structured_after(no, entry), parts.left, arm.left,
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, structured_bytes(no).len()), entry_rip)))
                })
        },
        CodeBranchNear(register, fd, jd, yes, no) => λ before layout resident => {
            let parts = branch_near_entry_fetched(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), before, resident);
            let entry = structured_near_entry(register, fd, before);
            let tested = structured_test(register, before);
            structured_near_branch_cases(register, fd, jd, yes, no, before,
                λ state => FetchedSteps(fetch, data, before, state) ∧
                    state.rip = next_rip(before.rip, structured_bytes(CodeBranchNear(register, fd, jd, yes, no)).len()),
                λ not_taken => {
                    let entry_rip: (entry.rip = branch_near_yes_at(register, before)) = near_not_taken_rip(fd, tested, not_taken);
                    let arm = structured_fetched(fetch, data, yes, entry, layout.right.right.left,
                        resident_state(fetch, structured_bytes(yes), before.memory, branch_near_yes_at(register, before), entry, refl, entry_rip, parts.right.left));
                    branch_near_fallthrough_close(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), layout.right.left,
                        before, structured_after(yes, entry), parts.left, arm.left, parts.right.right.left,
                        pure_structured_memory(yes, entry),
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, structured_bytes(yes).len()), entry_rip)))
                },
                λ taken => {
                    let entry_rip = branch_near_taken_entry(register, fd, structured_bytes(yes), before, layout.left, taken);
                    let arm = structured_fetched(fetch, data, no, entry, layout.right.right.right,
                        resident_state(fetch, structured_bytes(no), before.memory, branch_near_no_at(register, structured_bytes(yes), before),
                            entry, refl, entry_rip, parts.right.right.right));
                    branch_near_taken_close(fetch, data, register, fd, jd, structured_bytes(yes), structured_bytes(no), before,
                        structured_after(no, entry), parts.left, arm.left,
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, structured_bytes(no).len()), entry_rip)))
                })
        },
    }
}

// ---- AccessCode ----

// The same for an effectful tree: any structural execution is a fetched run.
fn AccessFetches<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, code: AccessCode) → Type {
    (before, after: MachineState<M>) → AccessLayout(code) →
    CodeResident(fetch, before.memory, access_bytes(code), before.rip) →
    ExecuteAccess(data, code, before, after) →
    FetchedSteps(fetch, data, before, after) ∧ after.rip = next_rip(before.rip, access_bytes(code).len())
}
// ---- the loop ----

theorem loop_count_exit(g, b: Nat): (g + 3) + (6 + (b + 9)) = g + (3 + (6 + (b + (3 + 6)))) { omega }
theorem loop_count_break(g, b: Nat): ((((g + 3) + 6) + b) + 3) + 6 = g + (3 + (6 + (b + (3 + 6)))) { omega }
theorem loop_count_back(g, b: Nat): (((g + 3) + 6) + b) + 3 = ((g + 9) + b) + 3 { omega }

// The loop's six pieces, resident at their offsets from the loop's start.
record LoopResident<M>(fetch: FetchAccess<M>, memory: M, start: BitVec(64), guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32)) {
    guard_at: CodeResident(fetch, memory, access_bytes(guard), start),
    test_at: CodeResident(fetch, memory, canonical_bytes(TestRR(flag, flag)), next_rip(start, access_bytes(guard).len())),
    exit_at: CodeResident(fetch, memory, near_control_bytes(JumpZeroNear(ed)), next_rip(start, access_bytes(guard).len() + 3)),
    body_at: CodeResident(fetch, memory, access_bytes(body), next_rip(start, (access_bytes(guard).len() + 3) + 6)),
    step_at: CodeResident(fetch, memory, canonical_bytes(TestRR(step, step)),
        next_rip(start, ((access_bytes(guard).len() + 3) + 6) + access_bytes(body).len())),
    back_at: CodeResident(fetch, memory, near_control_bytes(JumpZeroNear(bd)),
        next_rip(start, (((access_bytes(guard).len() + 3) + 6) + access_bytes(body).len()) + 3)),
}
theorem loop_resident<M>(fetch: FetchAccess<M>, memory: M, start: BitVec(64), guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32),
    resident: CodeResident(fetch, memory, access_bytes(AccessLoop(guard, flag, ed, body, step, bd)), start)):
    LoopResident<M>(fetch, memory, start, guard, flag, ed, body, step, bd) {
    let t1 = canonical_bytes(TestRR(flag, flag));
    let j1 = near_control_bytes(JumpZeroNear(ed));
    let t2 = canonical_bytes(TestRR(step, step));
    let j2 = near_control_bytes(JumpZeroNear(bd));
    let g = access_bytes(guard);
    let b = access_bytes(body);
    let r0 = resident_split_at(fetch, memory, g, t1 ++ (j1 ++ (b ++ (t2 ++ j2))), start, 0, resident);
    let r1 = resident_split_at(fetch, memory, t1, j1 ++ (b ++ (t2 ++ j2)), start, 0 + g.len(), r0.right);
    let r2 = resident_split_at(fetch, memory, j1, b ++ (t2 ++ j2), start, (0 + g.len()) + 3, r1.right);
    let r3 = resident_split_at(fetch, memory, b, t2 ++ j2, start, ((0 + g.len()) + 3) + 6, r2.right);
    let r4 = resident_split_at(fetch, memory, t2, j2, start, (((0 + g.len()) + 3) + 6) + b.len(), r3.right);
    let z = Nat::add_left_zero(g.len());
    LoopResident(r0.left,
        j(z, λ k _ => CodeResident(fetch, memory, t1, next_rip(start, k)), r1.left),
        j(z, λ k _ => CodeResident(fetch, memory, j1, next_rip(start, k + 3)), r2.left),
        j(z, λ k _ => CodeResident(fetch, memory, b, next_rip(start, (k + 3) + 6)), r3.left),
        j(z, λ k _ => CodeResident(fetch, memory, t2, next_rip(start, ((k + 3) + 6) + b.len())), r4.left),
        j(z, λ k _ => CodeResident(fetch, memory, j2, next_rip(start, (((k + 3) + 6) + b.len()) + 3)), r4.right))
}

theorem loop_bytes_len(guard: AccessCode, flag: Gpr, ed: BitVec(32), body: AccessCode, step: Gpr, bd: BitVec(32)):
    access_bytes(AccessLoop(guard, flag, ed, body, step, bd)).len() =
        access_bytes(guard).len() + (3 + (6 + (access_bytes(body).len() + (3 + 6)))) {
    let t1 = canonical_bytes(TestRR(flag, flag));
    let j1 = near_control_bytes(JumpZeroNear(ed));
    let t2 = canonical_bytes(TestRR(step, step));
    let j2 = near_control_bytes(JumpZeroNear(bd));
    let g = access_bytes(guard);
    let b = access_bytes(body);
    trans(List::len_append(g, t1 ++ (j1 ++ (b ++ (t2 ++ j2)))),
        cong_fn<Nat, Nat>(λ k => g.len() + k, trans(List::len_append(t1, j1 ++ (b ++ (t2 ++ j2))),
            cong_fn<Nat, Nat>(λ k => 3 + k, trans(List::len_append(j1, b ++ (t2 ++ j2)),
                cong_fn<Nat, Nat>(λ k => 6 + k, trans(List::len_append(b, t2 ++ j2),
                    cong_fn<Nat, Nat>(λ k => b.len() + k, List::len_append(t2, j2)))))))))
}

// One pass through the guard, its TEST and the forward JZ; `tested` is the
// state the edge decides from.
theorem loop_head_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32), guard_ih: AccessFetches(fetch, data, guard), guard_layout: AccessLayout(guard),
    memory: M, start: BitVec(64), pieces: LoopResident<M>(fetch, memory, start, guard, flag, ed, body, step, bd),
    before, tested: MachineState<M>, before_memory: before.memory = memory, before_rip: before.rip = start,
    checked: ExecuteAccess(data, guard, before, tested)):
    FetchedSteps(fetch, data, before, loop_edge(flag, ed, tested)) ∧
    (tested.memory = memory ∧ structured_test(flag, tested).rip = next_rip(start, access_bytes(guard).len() + 3)) {
    let g = access_bytes(guard).len();
    let ran = guard_ih(before, tested, guard_layout,
        resident_state(fetch, access_bytes(guard), memory, start, before, before_memory, before_rip, pieces.guard_at), checked);
    let tested_memory: (tested.memory = memory) = trans(access_memory(data, guard, before, tested, checked), before_memory);
    let tested_rip: (tested.rip = next_rip(start, g)) =
        trans(ran.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, g), before_rip));
    let t1 = structured_test(flag, tested);
    let edge = loop_edge(flag, ed, tested);
    let t1_rip: (t1.rip = next_rip(start, g + 3)) = rip_advance(start, tested.rip, g, 3, tested_rip);
    let test = ordinary_fetched_step(fetch, data, TestRR(flag, flag), tested,
        resident_state(fetch, canonical_bytes(TestRR(flag, flag)), memory, next_rip(start, g), tested, tested_memory, tested_rip, pieces.test_at));
    let jump = near_fetched_step(fetch, data, JumpZeroNear(ed), t1,
        resident_state(fetch, near_control_bytes(JumpZeroNear(ed)), memory, next_rip(start, g + 3), t1, tested_memory, t1_rip, pieces.exit_at));
    ⟨fetched_steps_trans(fetch, data, before, tested, edge, ran.left,
        fetched_steps_cons(fetch, data, tested, t1, edge, test, fetched_steps_one(fetch, data, t1, edge, jump))),
     ⟨tested_memory, t1_rip⟩⟩
}

// One pass through the body, its TEST and the backward JZ.
theorem loop_body_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32), body_ih: AccessFetches(fetch, data, body), body_layout: AccessLayout(body),
    memory: M, start: BitVec(64), pieces: LoopResident<M>(fetch, memory, start, guard, flag, ed, body, step, bd),
    entry, done: MachineState<M>, entry_memory: entry.memory = memory,
    entry_rip: entry.rip = next_rip(start, (access_bytes(guard).len() + 3) + 6),
    checked: ExecuteAccess(data, body, entry, done)):
    FetchedSteps(fetch, data, entry, loop_edge(step, bd, done)) ∧
    (done.memory = memory ∧ structured_test(step, done).rip =
        next_rip(start, (((access_bytes(guard).len() + 3) + 6) + access_bytes(body).len()) + 3)) {
    let at_body = (access_bytes(guard).len() + 3) + 6;
    let b = access_bytes(body).len();
    let ran = body_ih(entry, done, body_layout,
        resident_state(fetch, access_bytes(body), memory, next_rip(start, at_body), entry, entry_memory, entry_rip, pieces.body_at), checked);
    let done_memory: (done.memory = memory) = trans(access_memory(data, body, entry, done, checked), entry_memory);
    let done_rip: (done.rip = next_rip(start, at_body + b)) = trans(ran.right, rip_advance(start, entry.rip, at_body, b, entry_rip));
    let t2 = structured_test(step, done);
    let edge = loop_edge(step, bd, done);
    let t2_rip: (t2.rip = next_rip(start, (at_body + b) + 3)) = rip_advance(start, done.rip, at_body + b, 3, done_rip);
    let test = ordinary_fetched_step(fetch, data, TestRR(step, step), done,
        resident_state(fetch, canonical_bytes(TestRR(step, step)), memory, next_rip(start, at_body + b), done, done_memory, done_rip, pieces.step_at));
    let jump = near_fetched_step(fetch, data, JumpZeroNear(bd), t2,
        resident_state(fetch, near_control_bytes(JumpZeroNear(bd)), memory, next_rip(start, (at_body + b) + 3), t2, done_memory, t2_rip, pieces.back_at));
    ⟨fetched_steps_trans(fetch, data, entry, done, edge, ran.left,
        fetched_steps_cons(fetch, data, done, t2, edge, test, fetched_steps_one(fetch, data, t2, edge, jump))),
     ⟨done_memory, t2_rip⟩⟩
}

fn LoopFetchedResult<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32), start: BitVec(64), before, after: MachineState<M>) → Type {
    FetchedSteps(fetch, data, before, after) ∧
    after.rip = next_rip(start, access_bytes(AccessLoop(guard, flag, ed, body, step, bd)).len())
}

// By induction on the iterations that jump back. Every iteration starts at
// the loop's own start with the same memory; the back edge's layout clause
// is what returns it there.
theorem loop_runs_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, guard: AccessCode, flag: Gpr, ed: BitVec(32),
    body: AccessCode, step: Gpr, bd: BitVec(32), guard_ih: AccessFetches(fetch, data, guard),
    body_ih: AccessFetches(fetch, data, body), layout: AccessLayout(AccessLoop(guard, flag, ed, body, step, bd)),
    memory: M, start: BitVec(64), pieces: LoopResident<M>(fetch, memory, start, guard, flag, ed, body, step, bd), n: Nat):
    (before, after: MachineState<M>) → before.memory = memory → before.rip = start →
    LoopRuns(ExecuteAccess(data, guard), ExecuteAccess(data, body), flag, ed, step, bd, n, before, after) →
    LoopFetchedResult(fetch, data, guard, flag, ed, body, step, bd, start, before, after) {
    let g = access_bytes(guard).len();
    let b = access_bytes(body).len();
    let total = loop_bytes_len(guard, flag, ed, body, step, bd);
    match n {
        Zero => λ before after before_memory before_rip runs => {
            let tested = runs.witness;
            let head = loop_head_fetched(fetch, data, guard, flag, ed, body, step, bd, guard_ih, layout.right.right.left,
                memory, start, pieces, before, tested, before_memory, before_rip, runs.proof.left);
            let t1 = structured_test(flag, tested);
            let edge = loop_edge(flag, ed, tested);
            (match t1.flags.zf as λ zf => (t1.flags.zf = zf) →
                (match zf {
                    True => after = edge,
                    False => Exists<MachineState<M>>(λ done => ExecuteAccess(data, body, edge, done) ∧
                        ((structured_test(step, done).flags.zf = False) ∧ (after = loop_edge(step, bd, done)))),
                }) → LoopFetchedResult(fetch, data, guard, flag, ed, body, step, bd, start, before, after) {
                True => λ selected exited => ⟨j(sym(exited), λ state _ => FetchedSteps(fetch, data, before, state), head.left),
                    trans(cong_fn<MachineState<M>, BitVec(64)>(λ state => state.rip, exited),
                    trans(near_taken_rip(ed, t1, selected),
                    trans(layout.left(t1.rip),
                    trans(rip_advance(start, t1.rip, g + 3, 6 + (b + 9), head.right.right),
                    trans(rip_count(start, loop_count_exit(g, b)), rip_count(start, sym(total)))))))⟩,
                False => λ selected stepped => {
                    let done = stepped.witness;
                    let entry_rip: (edge.rip = next_rip(start, (g + 3) + 6)) =
                        trans(near_not_taken_rip(ed, t1, selected), rip_advance(start, t1.rip, g + 3, 6, head.right.right));
                    let inner = loop_body_fetched(fetch, data, guard, flag, ed, body, step, bd, body_ih, layout.right.right.right,
                        memory, start, pieces, edge, done, head.right.left, entry_rip, stepped.proof.left);
                    let t2 = structured_test(step, done);
                    let back = loop_edge(step, bd, done);
                    let exited = stepped.proof.right.right;
                    ⟨j(sym(exited), λ state _ => FetchedSteps(fetch, data, before, state),
                        fetched_steps_trans(fetch, data, before, edge, back, head.left, inner.left)),
                     trans(cong_fn<MachineState<M>, BitVec(64)>(λ state => state.rip, exited),
                     trans(near_not_taken_rip(bd, t2, stepped.proof.right.left),
                     trans(rip_advance(start, t2.rip, (((g + 3) + 6) + b) + 3, 6, inner.right.right),
                     trans(rip_count(start, loop_count_break(g, b)), rip_count(start, sym(total))))))⟩
                },
            })(refl, runs.proof.right)
        },
        Succ(k) => λ before after before_memory before_rip runs => {
            let tested = runs.witness;
            let head = loop_head_fetched(fetch, data, guard, flag, ed, body, step, bd, guard_ih, layout.right.right.left,
                memory, start, pieces, before, tested, before_memory, before_rip, runs.proof.left);
            let t1 = structured_test(flag, tested);
            let edge = loop_edge(flag, ed, tested);
            let stepped = runs.proof.right.right;
            let done = stepped.witness;
            let entry_rip: (edge.rip = next_rip(start, (g + 3) + 6)) =
                trans(near_not_taken_rip(ed, t1, runs.proof.right.left), rip_advance(start, t1.rip, g + 3, 6, head.right.right));
            let inner = loop_body_fetched(fetch, data, guard, flag, ed, body, step, bd, body_ih, layout.right.right.right,
                memory, start, pieces, edge, done, head.right.left, entry_rip, stepped.proof.left);
            let t2 = structured_test(step, done);
            let back = loop_edge(step, bd, done);
            let back_rip: (back.rip = start) =
                trans(near_taken_rip(bd, t2, stepped.proof.right.left),
                trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, bd),
                    trans(inner.right.right, rip_count(start, loop_count_back(g, b)))),
                layout.right.left(start)));
            let rest = loop_runs_fetched(fetch, data, guard, flag, ed, body, step, bd, guard_ih, body_ih, layout, memory, start, pieces, k,
                back, after, inner.right.left, back_rip, stepped.proof.right.right);
            ⟨fetched_steps_trans(fetch, data, before, edge, after, head.left,
                fetched_steps_trans(fetch, data, edge, back, after, inner.left, rest.left)), rest.right⟩
        },
    }
}

theorem access_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, code: AccessCode):
    AccessFetches(fetch, data, code) {
    match code {
        AccessPure(pure) => λ before after layout resident ran =>
            j(sym(ran), λ state _ => FetchedSteps(fetch, data, before, state) ∧
                state.rip = next_rip(before.rip, structured_bytes(pure).len()),
                structured_fetched(fetch, data, pure, before, layout, resident)),
        AccessRead(load) => λ before after layout resident ran =>
            ⟨fetched_steps_one(fetch, data, before, after, Exists(EmitLoad(load),
                ⟨FetchedFrom(resident_readable(fetch, before.memory, byte_load_bytes(load), before.rip, resident)), ran⟩)),
             cong_fn<MachineState<M>, BitVec(64)>(λ state => state.rip, ran.proof.execution)⟩,
        AccessSequence(prefix, tail) => λ before after layout resident ran => {
            let middle = ran.witness;
            let parts = resident_split(fetch, before.memory, access_bytes(prefix), access_bytes(tail), before.rip, resident);
            let first = access_fetched(fetch, data, prefix, before, middle, layout.left, parts.left, ran.proof.left);
            let second = access_fetched(fetch, data, tail, middle, after, layout.right,
                resident_state(fetch, access_bytes(tail), before.memory, next_rip(before.rip, access_bytes(prefix).len()),
                    middle, access_memory(data, prefix, before, middle, ran.proof.left), first.right, parts.right),
                ran.proof.right);
            ⟨fetched_steps_trans(fetch, data, before, middle, after, first.left, second.left),
             trans(second.right, trans(rip_advance(before.rip, middle.rip, access_bytes(prefix).len(), access_bytes(tail).len(), first.right),
                rip_count(before.rip, sym(List::len_append(access_bytes(prefix), access_bytes(tail))))))⟩
        },
        AccessBranch(register, fd, jd, yes, no) => λ before after layout resident => {
            let parts = branch_entry_fetched(fetch, data, register, fd, jd, access_bytes(yes), access_bytes(no), before, resident);
            let entry = structured_branch_entry(register, fd, before);
            let tested = structured_test(register, before);
            (match tested.flags.zf as λ zf => (tested.flags.zf = zf) →
                (match zf {
                    False => Exists<MachineState<M>>(λ middle => ExecuteAccess(data, yes, entry, middle) ∧
                        (after = execute_short_control(Jump(jd), middle))),
                    True => ExecuteAccess(data, no, entry, after),
                }) → FetchedSteps(fetch, data, before, after) ∧
                    after.rip = next_rip(before.rip, access_bytes(AccessBranch(register, fd, jd, yes, no)).len()) {
                False => λ not_taken ran => {
                    let done = ran.witness;
                    let entry_rip: (entry.rip = branch_yes_at(register, before)) =
                        jump_zero_not_taken_rip(tested.flags.zf, tested.rip, fd, not_taken);
                    let arm = access_fetched(fetch, data, yes, entry, done, layout.right.right.left,
                        resident_state(fetch, access_bytes(yes), before.memory, branch_yes_at(register, before), entry, refl, entry_rip, parts.right.left),
                        ran.proof.left);
                    let closed = branch_fallthrough_close(fetch, data, register, fd, jd, access_bytes(yes), access_bytes(no), layout.right.left,
                        before, done, parts.left, arm.left, parts.right.right.left,
                        access_memory(data, yes, entry, done, ran.proof.left),
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, access_bytes(yes).len()), entry_rip)));
                    j(sym(ran.proof.right), λ state _ => FetchedSteps(fetch, data, before, state) ∧
                        state.rip = next_rip(before.rip, access_bytes(AccessBranch(register, fd, jd, yes, no)).len()), closed)
                },
                True => λ taken ran => {
                    let entry_rip = branch_taken_entry(register, fd, access_bytes(yes), before, layout.left, taken);
                    let arm = access_fetched(fetch, data, no, entry, after, layout.right.right.right,
                        resident_state(fetch, access_bytes(no), before.memory, branch_no_at(register, access_bytes(yes), before),
                            entry, refl, entry_rip, parts.right.right.right), ran);
                    branch_taken_close(fetch, data, register, fd, jd, access_bytes(yes), access_bytes(no), before, after,
                        parts.left, arm.left,
                        trans(arm.right, cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, access_bytes(no).len()), entry_rip)))
                },
            })(refl)
        },
        AccessLoop(guard, flag, ed, body, step, bd) => λ before after layout resident ran =>
            loop_runs_fetched(fetch, data, guard, flag, ed, body, step, bd,
                access_fetched(fetch, data, guard), access_fetched(fetch, data, body), layout,
                before.memory, before.rip, loop_resident(fetch, before.memory, before.rip, guard, flag, ed, body, step, bd, resident),
                ran.witness, before, after, refl, refl, ran.proof),
    }
}

// A published artifact runs fetched wherever its bytes are resident: what a
// generated certificate composes with, one line per loop or branch.
theorem access_artifact_fetched<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, code: AccessCode,
    bytes: List<BitVec(8)>, before, after: MachineState<M>, artifact: AccessArtifact<M>(data, code, bytes, before, after),
    resident: CodeResident(fetch, before.memory, bytes, before.rip)):
    FetchedSteps(fetch, data, before, after) ∧ after.rip = next_rip(before.rip, bytes.len()) {
    let ran = access_fetched(fetch, data, code, before, after, artifact.layout,
        j(artifact.encoding, λ spelled _ => CodeResident(fetch, before.memory, spelled, before.rip), resident), artifact.execution);
    ⟨ran.left, trans(ran.right, rip_count(before.rip, cong_fn<List<BitVec(8)>, Nat>(λ spelled => spelled.len(), sym(artifact.encoding))))⟩
}

// Runs of the machine over a label program (issues/function-ir-verified-
// lowering.md, round 3): round 2's `Site::Runs` with the stack. From one
// offset of a program resident at its origin to another, a state satisfying
// `pre` takes machine steps (fetched steps, stores, and the stack forms) to
// one satisfying `post`, the program still resident. Conditions are on the
// whole state, so a frame (registers kept, the caller's stack words
// unchanged) is stated against a ghost state the caller quantifies over.
//
// A pure run is a machine run (`moves_of_runs`), so round 2's lemmas and
// theorem carry over unchanged; the lemmas here are the stack forms': a word
// spilled and reloaded at a frame slot, a CALL against its callee's
// contract (`Site::Returns`), and RET closing a function into one.
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import memory;
import bitvec_shift_nat;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// From `s`, a machine run to offset `to`, the program still resident, the
// state satisfying `post`.
fn Site::Arrives<M>(self site: Site<M>, writes: ByteWrites<M>, s: MachineState<M>, to: Nat, post: MachineState<M> → Type) → Type {
    Exists<MachineState<M>>(λ t => MachineSteps(site.fetch, site.data, writes, s, t) ∧
        (t.rip = next_rip(site.origin, to) ∧ (site.Resident(t.memory) ∧ post(t))))
}

// Every state at offset `from`, the program resident, satisfying `pre`,
// arrives at `to` satisfying `post`.
fn Site::Moves<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post: MachineState<M> → Type) → Type {
    (s: MachineState<M>) → s.rip = next_rip(site.origin, from) → site.Resident(s.memory) → pre(s) →
        site.Arrives(writes, s, to, post)
}

theorem Site::arrives_after<M>(self site: Site<M>, writes: ByteWrites<M>, s, t: MachineState<M>, to: Nat, post: MachineState<M> → Type,
    steps: MachineSteps(site.fetch, site.data, writes, s, t), rest: site.Arrives(writes, t, to, post)): site.Arrives(writes, s, to, post) {
    Exists(rest.witness, ⟨machine_steps_trans(site.fetch, site.data, writes, s, t, rest.witness, steps, rest.proof.left), rest.proof.right⟩)
}

theorem Site::moves_trans<M>(self site: Site<M>, writes: ByteWrites<M>, from, middle, to: Nat, pre, between, post: MachineState<M> → Type,
    first: site.Moves(writes, from, middle, pre, between), second: site.Moves(writes, middle, to, between, post)):
    site.Moves(writes, from, to, pre, post) {
    λ s here resident holds => {
        let one = first(s, here, resident, holds);
        site.arrives_after(writes, s, one.witness, to, post, one.proof.left,
            second(one.witness, one.proof.right.left, one.proof.right.right.left, one.proof.right.right.right))
    }
}

theorem Site::moves_weaken<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post, entry, exit: MachineState<M> → Type,
    moves: site.Moves(writes, from, to, pre, post), into: (s: MachineState<M>) → entry(s) → pre(s),
    out: (t: MachineState<M>) → post(t) → exit(t)): site.Moves(writes, from, to, entry, exit) {
    λ s here resident holds => {
        let reached = moves(s, here, resident, into(s, holds));
        Exists(reached.witness, ⟨reached.proof.left, ⟨reached.proof.right.left, ⟨reached.proof.right.right.left,
            out(reached.witness, reached.proof.right.right.right)⟩⟩⟩)
    }
}

// A pure run is a machine run: memory untouched, whatever held of it still
// does.
theorem Site::moves_of_runs<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post: Gprs → Type, frame: M → Type,
    runs: site.Runs(from, to, pre, post)):
    site.Moves(writes, from, to, λ (s: MachineState<M>) => pre(s.gprs) ∧ frame(s.memory),
        λ (t: MachineState<M>) => post(t.gprs) ∧ frame(t.memory)) {
    λ s here resident holds => {
        let reached = runs(s, here, resident, holds.left);
        let t = reached.witness;
        let same: (t.memory = s.memory) = reached.proof.right.right.left;
        Exists(t, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, t, reached.proof.left),
            ⟨reached.proof.right.left, ⟨j(sym(same), λ memory _ => site.Resident(memory), resident),
                ⟨reached.proof.right.right.right, j(sym(same), λ memory _ => frame(memory), holds.right)⟩⟩⟩⟩)
    }
}

theorem Site::moves_refl<M>(self site: Site<M>, writes: ByteWrites<M>, at: Nat, pre, post: MachineState<M> → Type,
    holds: (s: MachineState<M>) → pre(s) → post(s)): site.Moves(writes, at, at, pre, post) {
    λ s here resident held => Exists(s, ⟨machine_steps_refl(site.fetch, site.data, writes, s), ⟨here, ⟨resident, holds(s, held)⟩⟩⟩)
}

// Facts the run does not touch hold after it.
theorem Site::moves_carry<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post: MachineState<M> → Type, facts: Type,
    moves: site.Moves(writes, from, to, pre, post)):
    site.Moves(writes, from, to, λ (s: MachineState<M>) => pre(s) ∧ facts, λ (t: MachineState<M>) => post(t) ∧ facts) {
    λ s here resident holds => {
        let reached = moves(s, here, resident, holds.left);
        Exists(reached.witness, ⟨reached.proof.left, ⟨reached.proof.right.left, ⟨reached.proof.right.right.left,
            ⟨reached.proof.right.right.right, holds.right⟩⟩⟩⟩)
    }
}

// A pure run of an item at a label, its condition on registers and memory
// together: memory is untouched, so the condition reads it as it was.
theorem Site::moves_of_pure<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post: Gprs → M → Type,
    runs: (memory: M) → site.Runs(from, to, λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory))):
    site.Moves(writes, from, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    λ s here resident holds => {
        let reached = runs(s.memory, s, here, resident, holds);
        let t = reached.witness;
        let same: (t.memory = s.memory) = reached.proof.right.right.left;
        Exists(t, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, t, reached.proof.left),
            ⟨reached.proof.right.left, ⟨j(sym(same), λ memory _ => site.Resident(memory), resident),
                j(sym(same), λ memory _ => post(t.gprs, memory), reached.proof.right.right.right)⟩⟩⟩)
    }
}

// A pure block at a label, its condition on registers and memory together.
theorem Site::moves_block<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, instructions: List<Instruction>, at: asm_back(site.program, k) = At(before, name, Block(instructions)),
    reads: block_reads(instructions, DefinedFlags::none()) = True,
    pre, post: Gprs → M → Type,
    step: (s: MachineState<M>) → (memory: M) → pre(s.gprs, memory) → post(execute_block_normal(instructions, s).gprs, memory)):
    site.Moves(writes, prog_len(before), prog_len(before) + block_length(instructions),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    site.moves_of_pure(writes, prog_len(before), prog_len(before) + block_length(instructions), pre, post,
        λ memory => site.runs_block(fits, k, before, name, instructions, at, reads, λ (g: Gprs) => pre(g, memory),
            λ (g: Gprs) => post(g, memory), λ s held => step(s, memory, held)))
}

// A near JMP at a label, ahead or behind.
theorem Site::moves_jump<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name, target: Nat, at: asm_back(site.program, k) = At(before, name, Jmp(target)), to: Nat,
    lands: NearLands(prog_len(before), asm_jump_of(asm_labels(site.program), prog_len(before), Jmp(target)), to),
    pre: Gprs → M → Type):
    site.Moves(writes, prog_len(before), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => pre(t.gprs, t.memory)) {
    site.moves_of_pure(writes, prog_len(before), to, pre, pre,
        λ memory => site.runs_jump(fits, k, before, name, target, at, to, lands, λ (g: Gprs) => pre(g, memory)))
}

// A JMP item, near or short.
theorem Site::moves_jump_item<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, short: Bool, target: Nat, at: asm_back(site.program, k) = At(before, name, jmp_item(short, target)), to: Nat,
    lands: JmpLands(asm_labels(site.program), prog_len(before), short, target, to),
    pre: Gprs → M → Type):
    site.Moves(writes, prog_len(before), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => pre(t.gprs, t.memory)) {
    site.moves_of_pure(writes, prog_len(before), to, pre, pre,
        λ memory => site.runs_jump_item(fits, k, before, name, short, target, at, to, lands, λ (g: Gprs) => pre(g, memory)))
}

// No state satisfies `pre`.
theorem Site::moves_absurd<M>(self site: Site<M>, writes: ByteWrites<M>, from, to: Nat, pre, post: MachineState<M> → Type,
    never: (s: MachineState<M>) → pre(s) → False): site.Moves(writes, from, to, pre, post) {
    λ s here resident holds => false_elim(never(s, holds))
}

// The same with the JCC near or short, as a hint chose.
theorem Site::moves_test_by<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, test: Test, else_name: Nat, short: Bool,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.tested(test),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branched_by(test, else_name, short),
    else_to: Nat, else_lands: JccLands(asm_labels(site.program), prog_len(start.tested(test)), short, test.cc(), else_name, else_to),
    to: Nat, pre: Gprs → M → Type, post: MachineState<M> → Type,
    yes: site.Moves(writes, prog_len(start.branched_by(test, else_name, short)), to,
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False, post),
    no: site.Moves(writes, else_to, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True, post)):
    site.Moves(writes, prog_len(start), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), post) {
    λ s here resident holds => {
        let instruction = test.instruction();
        let tested = start.tested(test);
        let labels = asm_labels(site.program);
        let item = site.item_resident(fits, s.memory, resident, test_k, start, 0, Block([instruction]), test_at);
        let ran = block_steps(site.fetch, site.data, [instruction], s,
            j(sym(here), λ address _ => CodeResident(site.fetch, s.memory, canonical_block_bytes([instruction]), address), item),
            test.reads(s));
        let u = execute_block_normal([instruction], s);
        let stepped = test.steps<M>(s);
        let u_rip: (u.rip = next_rip(site.origin, prog_len(tested))) = trans(ran.right.left, trans(
            cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, block_length([instruction])), here),
            rip_compose(site.origin, prog_len(start), block_length([instruction]))));
        let u_memory: (u.memory = s.memory) = ran.right.right;
        let jumped = site.jcc_item_steps(fits, branch_k, tested, 0, short, test.cc(), else_name, branch_at, else_to, else_lands, u, u_rip,
            j(sym(u_memory), λ memory _ => site.Resident(memory), resident), test.jcc_reads(s));
        let v = jcc_after(labels, prog_len(tested), short, test.cc(), else_name, u);
        let entry = machine_steps_of_fetched(site.fetch, site.data, writes, s, v,
            fetched_steps_trans(site.fetch, site.data, s, u, v, ran.left, fetched_steps_one(site.fetch, site.data, u, v, jumped.left)));
        let v_gprs: (v.gprs = s.gprs) = trans(jcc_after_gprs(labels, prog_len(tested), short, test.cc(), else_name, u), stepped.left);
        let v_memory: (v.memory = s.memory) = trans(jcc_after_memory(labels, prog_len(tested), short, test.cc(), else_name, u), u_memory);
        let v_resident = j(sym(v_memory), λ memory _ => site.Resident(memory), resident);
        let kept = λ (b: Bool) (taken: test.taken(s.gprs) = b) =>
            j(sym(v_gprs), λ g _ => pre(g, v.memory) ∧ test.taken(g) = b,
                ⟨j(sym(v_memory), λ memory _ => pre(s.gprs, memory), holds), taken⟩);
        match nonzero: test.taken(s.gprs) {
            False => site.arrives_after(writes, s, v, to, post, entry,
                yes(v, jumped.right.left(trans(stepped.right, nonzero)), v_resident, kept(False, nonzero))),
            True => site.arrives_after(writes, s, v, to, post, entry,
                no(v, jumped.right.right(trans(stepped.right, nonzero)), v_resident, kept(True, nonzero))),
        }
    }
}

// A test and its JCC, each way to `to`: falling through where the JCC is
// not taken, from the jump's target where it is.
theorem Site::moves_test_on<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, test: Test, else_name: Nat,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.tested(test),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branched(test, else_name),
    else_to: Nat, else_lands: JumpsForward(prog_len(start.tested(test)), 6,
        asm_jump_of(asm_labels(site.program), prog_len(start.tested(test)), Jcc(test.cc(), else_name)), else_to),
    to: Nat, pre: Gprs → M → Type, post: MachineState<M> → Type,
    yes: site.Moves(writes, prog_len(start.branched(test, else_name)), to,
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False, post),
    no: site.Moves(writes, else_to, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True, post)):
    site.Moves(writes, prog_len(start), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), post) {
    site.moves_test_by(writes, fits, start, test, else_name, False, test_k, test_at, branch_k, branch_at, else_to, else_lands, to, pre, post, yes, no)
}

// TEST of a register with itself and JE, each way to `to`: falling through
// where the register is nonzero, from the jump's target where it is zero.
theorem Site::moves_test<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, register: Gpr, else_name: Nat,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.test_label(register),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branch_label(register, else_name),
    else_to: Nat, else_lands: JumpsForward(prog_len(start.test_label(register)), 6,
        asm_jump_of(asm_labels(site.program), prog_len(start.test_label(register)), Jcc(E, else_name)), else_to),
    to: Nat, pre: Gprs → M → Type, post: MachineState<M> → Type,
    yes: site.Moves(writes, prog_len(start.branch_label(register, else_name)), to,
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ register.tests_zero(s.gprs) = False, post),
    no: site.Moves(writes, else_to, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ register.tests_zero(s.gprs) = True, post)):
    site.Moves(writes, prog_len(start), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), post) {
    site.moves_test_on(writes, fits, start, Nonzero(register), else_name, test_k, test_at, branch_k, branch_at, else_to, else_lands,
        to, pre, post, yes, no)
}

// The same with each jump near or short, as a hint chose: the JCC to the
// second arm and the first arm's JMP to the join.
theorem Site::moves_branch_by<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, test: Test, else_name, join_name: Nat, short_jcc, short_jmp: Bool, yes_end, no_end: Prog,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.tested(test),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branched_by(test, else_name, short_jcc),
    jump_k: Nat, jump_at: asm_back(site.program, jump_k) = At(yes_end, 0, jmp_item(short_jmp, join_name)),
    else_lands: JccLands(asm_labels(site.program), prog_len(start.tested(test)), short_jcc, test.cc(), else_name,
        prog_len(yes_end) + asm_len(jmp_item(short_jmp, join_name))),
    join_lands: JmpLands(asm_labels(site.program), prog_len(yes_end), short_jmp, join_name, prog_len(no_end)),
    pre, post: Gprs → M → Type,
    yes: site.Moves(writes, prog_len(start.branched_by(test, else_name, short_jcc)), prog_len(yes_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False, λ (t: MachineState<M>) => post(t.gprs, t.memory)),
    no: site.Moves(writes, prog_len(yes_end) + asm_len(jmp_item(short_jmp, join_name)), prog_len(no_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True, λ (t: MachineState<M>) => post(t.gprs, t.memory))):
    site.Moves(writes, prog_len(start), prog_len(no_end), λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    let post_s = λ (t: MachineState<M>) => post(t.gprs, t.memory);
    let yes_pre = λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False;
    site.moves_test_by(writes, fits, start, test, else_name, short_jcc, test_k, test_at, branch_k, branch_at,
        prog_len(yes_end) + asm_len(jmp_item(short_jmp, join_name)), else_lands, prog_len(no_end), pre, post_s,
        site.moves_trans(writes, prog_len(start.branched_by(test, else_name, short_jcc)), prog_len(yes_end), prog_len(no_end), yes_pre, post_s, post_s,
            yes, site.moves_jump_item(writes, fits, jump_k, yes_end, 0, short_jmp, join_name, jump_at, prog_len(no_end), join_lands, post)),
        no)
}

// Round 2's branch with machine-run arms.
theorem Site::moves_branch_on<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, test: Test, else_name, join_name: Nat, yes_end, no_end: Prog,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.tested(test),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branched(test, else_name),
    jump_k: Nat, jump_at: asm_back(site.program, jump_k) = At(yes_end, 0, Jmp(join_name)),
    else_lands: JumpsForward(prog_len(start.tested(test)), 6,
        asm_jump_of(asm_labels(site.program), prog_len(start.tested(test)), Jcc(test.cc(), else_name)), prog_len(yes_end) + 5),
    join_lands: NearLands(prog_len(yes_end), asm_jump_of(asm_labels(site.program), prog_len(yes_end), Jmp(join_name)),
        prog_len(no_end)),
    pre, post: Gprs → M → Type,
    yes: site.Moves(writes, prog_len(start.branched(test, else_name)), prog_len(yes_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False, λ (t: MachineState<M>) => post(t.gprs, t.memory)),
    no: site.Moves(writes, prog_len(yes_end) + 5, prog_len(no_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True, λ (t: MachineState<M>) => post(t.gprs, t.memory))):
    site.Moves(writes, prog_len(start), prog_len(no_end), λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    site.moves_branch_by(writes, fits, start, test, else_name, join_name, False, False, yes_end, no_end, test_k, test_at, branch_k, branch_at,
        jump_k, jump_at, else_lands, join_lands, pre, post, yes, no)
}

theorem Site::moves_branch<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()),
    start: Prog, register: Gpr, else_name, join_name: Nat, yes_end, no_end: Prog,
    test_k: Nat, test_at: asm_back(site.program, test_k) = start.test_label(register),
    branch_k: Nat, branch_at: asm_back(site.program, branch_k) = start.branch_label(register, else_name),
    jump_k: Nat, jump_at: asm_back(site.program, jump_k) = At(yes_end, 0, Jmp(join_name)),
    else_lands: JumpsForward(prog_len(start.test_label(register)), 6,
        asm_jump_of(asm_labels(site.program), prog_len(start.test_label(register)), Jcc(E, else_name)), prog_len(yes_end) + 5),
    join_lands: NearLands(prog_len(yes_end), asm_jump_of(asm_labels(site.program), prog_len(yes_end), Jmp(join_name)),
        prog_len(no_end)),
    pre, post: Gprs → M → Type,
    yes: site.Moves(writes, prog_len(start.branch_label(register, else_name)), prog_len(yes_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ register.tests_zero(s.gprs) = False, λ (t: MachineState<M>) => post(t.gprs, t.memory)),
    no: site.Moves(writes, prog_len(yes_end) + 5, prog_len(no_end),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ register.tests_zero(s.gprs) = True, λ (t: MachineState<M>) => post(t.gprs, t.memory))):
    site.Moves(writes, prog_len(start), prog_len(no_end), λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    site.moves_branch_on(writes, fits, start, Nonzero(register), else_name, join_name, yes_end, no_end, test_k, test_at,
        branch_k, branch_at, jump_k, jump_at, else_lands, join_lands, pre, post, yes, no)
}

// The item at a label, fetched at the state's RIP.
theorem Site::item_fetched<M>(self site: Site<M>, fits: FillsFit(site.program, no_fills()), s: MachineState<M>,
    resident: site.Resident(s.memory), k: Nat, before: Prog, name: Nat, item: Asm,
    at: asm_back(site.program, k) = At(before, name, item), here: s.rip = next_rip(site.origin, prog_len(before))):
    FetchedFrom(site.fetch, s.memory, InstructionBytes(s.rip, asm_bytes(no_fills(), asm_labels(site.program), prog_len(before), item))) {
    let bytes = asm_bytes(no_fills(), asm_labels(site.program), prog_len(before), item);
    FetchedFrom(resident_readable(site.fetch, s.memory, bytes, s.rip,
        j(sym(here), λ address _ => CodeResident(site.fetch, s.memory, bytes, address),
            site.item_resident(fits, s.memory, resident, k, before, name, item, at))))
}

theorem Site::rip_after<M>(self site: Site<M>, s: MachineState<M>, from, length: Nat, here: s.rip = next_rip(site.origin, from)):
    next_rip(s.rip, length) = next_rip(site.origin, from + length) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => next_rip(address, length), here), rip_compose(site.origin, from, length))
}

// ---------------------------------------------------------------------------
// A frame slot

// A word spilled where the stack has room: the store stays off the code.
theorem Site::moves_spill<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    k: Nat, before: Prog, name: Nat, store: StackStore, at: asm_back(site.program, k) = At(before, name, Spill(store)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → Exists<Nat>(λ i => (stack_address(s.gprs, store.offset) = stack.at(i)) ∧
        (i + 8 <= stack.size ∧ post(store.after(stack.writes, s))))):
    site.Moves(stack.writes, prog_len(before), prog_len(before) + 5, pre, post) {
    λ s here resident holds => {
        let found = step(s, holds);
        let i = found.witness;
        let address: (stack_address(s.gprs, store.offset) = stack.at(i)) = found.proof.left;
        let room: (i + 8 <= stack.size) = found.proof.right.left;
        let word = read_gpr(store.source, s.gprs);
        let after = store.after(stack.writes, s);
        let executes: SpillWord(store).Executes(site.data, stack.writes, s, after) =
            ⟨j(sym(address), λ a _ => WordCanonical(a), stack.canonical(i, room)),
             ⟨j(sym(address), λ a _ => stack.writes.writable(s.memory, a, 8), stack.writable(s.memory, i, room)), refl⟩⟩;
        Exists(after, ⟨stack_step_machine(site.fetch, site.data, stack.writes, SpillWord(store), s, after,
                site.item_fetched(fits, s, resident, k, before, name, Spill(store), at, here), executes),
            ⟨site.rip_after(s, prog_len(before), 5, here),
             ⟨j(sym(address), λ a _ => site.Resident(stack.writes.store(s.memory, a, word_bytes(word))),
                stack.keeps_code(s.memory, i, room, word, assemble(no_fills(), site.program, site.last), next_rip(site.origin, 0), resident)),
              found.proof.right.right⟩⟩⟩)
    }
}

// A word reloaded from where it reads.
theorem Site::moves_reload<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    k: Nat, before: Prog, name: Nat, load: StackLoad, at: asm_back(site.program, k) = At(before, name, Reload(load)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → Exists<Nat>(λ i => (stack_address(s.gprs, load.offset) = stack.at(i)) ∧
        (i + 8 <= stack.size ∧ Exists<BitVec(64)>(λ word => (read_word(site.data, s.memory, stack.at(i)) = Some(word)) ∧
            post(load.after(word, s)))))):
    site.Moves(stack.writes, prog_len(before), prog_len(before) + 5, pre, post) {
    λ s here resident holds => {
        let found = step(s, holds);
        let i = found.witness;
        let address: (stack_address(s.gprs, load.offset) = stack.at(i)) = found.proof.left;
        let room: (i + 8 <= stack.size) = found.proof.right.left;
        let read = found.proof.right.right;
        let after = load.after(read.witness, s);
        let executes: ReloadWord(load).Executes(site.data, stack.writes, s, after) =
            ⟨j(sym(address), λ a _ => WordCanonical(a), stack.canonical(i, room)),
             Exists(read.witness, ⟨j(sym(address), λ a _ => read_word(site.data, s.memory, a) = Some(read.witness), read.proof.left), refl⟩)⟩;
        Exists(after, ⟨stack_step_machine(site.fetch, site.data, stack.writes, ReloadWord(load), s, after,
                site.item_fetched(fits, s, resident, k, before, name, Reload(load), at, here), executes),
            ⟨site.rip_after(s, prog_len(before), 5, here), ⟨resident, read.proof.right⟩⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// A byte read

// A byte loaded at a label, zero-extended, from a canonical address that
// reads one.
theorem Site::moves_load_byte<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, load: ByteLoad, at: asm_back(site.program, k) = At(before, name, LoadByte(load)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → Exists<BitVec(8)>(λ byte =>
        (read_gpr(load.base, s.gprs).toNat() < Nat::pow(2, 47)) ∧
        ((site.data.read(s.memory, read_gpr(load.base, s.gprs)) = Some(byte)) ∧ post(byte_load_after(load, byte, s))))):
    site.Moves(writes, prog_len(before), prog_len(before) + byte_load_bytes(load).len(), pre, post) {
    λ s here resident holds => {
        let found = step(s, holds);
        let after = byte_load_after(load, found.witness, s);
        let one: FetchedStep(site.fetch, site.data, s, after) = Exists(EmitLoad(load),
            ⟨site.item_fetched(fits, s, resident, k, before, name, LoadByte(load), at, here),
             Exists(found.witness, ByteLoadStep(canonical := BitVec::drop_low_zero_of_lt(47, 17, read_gpr(load.base, s.gprs), found.proof.left),
                present := found.proof.right.left, execution := refl))⟩);
        Exists(after, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, after, fetched_steps_one(site.fetch, site.data, s, after, one)),
            ⟨site.rip_after(s, prog_len(before), byte_load_bytes(load).len(), here), ⟨resident, found.proof.right.right⟩⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// An address formed from the code's own

// LEA of label `target`'s address: a piece whose displacement is the
// distance from its own end to the label, as a jump's is. A label at the
// program's end names the bytes after it (`Site.last`), where a constant
// table lies (issues/rt-fixed-arrays-and-tables.md).
fn asm_lea(destination: Gpr, target: Nat) → Asm {
    Refer(λ labels here => lea_rip_bytes(LeaRip(destination := destination, displacement := near_rel(here + 7, labels(target)))),
        7, λ labels here => refl)
}

// The displacement `asm_lea` takes at `here`.
fn asm_lea_displacement(labels: Nat → Nat, here, target: Nat) → BitVec(32) { near_rel(here + 7, labels(target)) }

// LEA at a label. Where its displacement lands on `to` (`JumpsForward`, the
// producer's by evaluation or by a bound), the register holds the code's
// address at `to` after it.
theorem Site::moves_lea<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, destination: Gpr, target: Nat, at: asm_back(site.program, k) = At(before, name, asm_lea(destination, target)),
    post: MachineState<M> → Type):
    site.Moves(writes, prog_len(before), prog_len(before) + 7,
        λ s => post(lea_rip_after(LeaRip(destination := destination,
            displacement := asm_lea_displacement(asm_labels(site.program), prog_len(before), target)), s)), post) {
    λ s here resident holds => {
        let lea = LeaRip(destination := destination, displacement := asm_lea_displacement(asm_labels(site.program), prog_len(before), target));
        let after = lea_rip_after(lea, s);
        let one: FetchedStep(site.fetch, site.data, s, after) = Exists(EmitLeaRip(lea),
            ⟨site.item_fetched(fits, s, resident, k, before, name, asm_lea(destination, target), at, here), refl⟩);
        Exists(after, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, after, fetched_steps_one(site.fetch, site.data, s, after, one)),
            ⟨site.rip_after(s, prog_len(before), 7, here), ⟨resident, holds⟩⟩⟩)
    }
}

// What the register holds after LEA at `from`, its displacement landing on
// `to`: the code's address at `to`.
theorem Site::lea_lands<M>(self site: Site<M>, s: MachineState<M>, from: Nat, lea: LeaRip, to: Nat,
    here: s.rip = next_rip(site.origin, from), lands: JumpsForward(from, 7, lea.displacement, to)):
    read_gpr(lea.destination, lea_rip_after(lea, s).gprs) = next_rip(site.origin, to) {
    trans(lea_rip_result(lea, s),
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 7, lea.displacement), here),
            jumps_forward(site.origin, from, 7, lea.displacement, to, lands)))
}

// Eight resident code bytes read as their word through a data access that
// sees code (`Stack.sees_code`), below the canonical boundary: a word of a
// constant table placed in the code.
theorem Stack::code_word<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), memory: M,
    b0, b1, b2, b3, b4, b5, b6, b7: BitVec(8), rest: List<BitVec(8)>, start: BitVec(64),
    resident: CodeResident(fetch, memory, Cons(b0, Cons(b1, Cons(b2, Cons(b3, Cons(b4, Cons(b5, Cons(b6, Cons(b7, rest)))))))), start)):
    (start.toNat() + 8 <= Nat::pow(2, 47)) ∧ (read_word(data, memory, start) = Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7))) {
    let r1 = resident.right.right.right;
    let r2 = r1.right.right.right;
    let r3 = r2.right.right.right;
    let r4 = r3.right.right.right;
    let r5 = r4.right.right.right;
    let r6 = r5.right.right.right;
    let r7 = r6.right.right.right;
    let s0 = stack.sees_code(memory, start, resident.left);
    let s7 = stack.sees_code(memory, next_rip(start, 7), r7.left);
    let e0: (data.read(memory, next_rip(start, 0)) = Some(b0)) = trans(s0.left, resident.right.left);
    let e1: (data.read(memory, next_rip(start, 1)) = Some(b1)) = trans(stack.sees_code(memory, next_rip(start, 1), r1.left).left, r1.right.left);
    let e2: (data.read(memory, next_rip(start, 2)) = Some(b2)) = trans(stack.sees_code(memory, next_rip(start, 2), r2.left).left, r2.right.left);
    let e3: (data.read(memory, next_rip(start, 3)) = Some(b3)) = trans(stack.sees_code(memory, next_rip(start, 3), r3.left).left, r3.right.left);
    let e4: (data.read(memory, next_rip(start, 4)) = Some(b4)) = trans(stack.sees_code(memory, next_rip(start, 4), r4.left).left, r4.right.left);
    let e5: (data.read(memory, next_rip(start, 5)) = Some(b5)) = trans(stack.sees_code(memory, next_rip(start, 5), r5.left).left, r5.right.left);
    let e6: (data.read(memory, next_rip(start, 6)) = Some(b6)) = trans(stack.sees_code(memory, next_rip(start, 6), r6.left).left, r6.right.left);
    let e7: (data.read(memory, next_rip(start, 7)) = Some(b7)) = trans(s7.left, r7.right.left);
    let top: (Succ(Nat::pow(2, 47)) <= Nat::pow(2, 64)) = Nat::leb_sound(Succ(Nat::pow(2, 47)), Nat::pow(2, 64), trivial);
    let low = s0.right;
    let last: (next_rip(start, 7).toNat() = start.toNat() + 7) = BitVec::offset_toNat(64, start, 7, omega(low, top));
    let high = s7.right;
    ⟨omega(last, high), word_of_eight(data.read(memory, next_rip(start, 0)), data.read(memory, next_rip(start, 1)),
        data.read(memory, next_rip(start, 2)), data.read(memory, next_rip(start, 3)), data.read(memory, next_rip(start, 4)),
        data.read(memory, next_rip(start, 5)), data.read(memory, next_rip(start, 6)), data.read(memory, next_rip(start, 7)),
        b0, b1, b2, b3, b4, b5, b6, b7, e0, e1, e2, e3, e4, e5, e6, e7)⟩
}

// A table of words laid out in the code, little-endian, entry by entry,
// and its entry `index` as the load reads it (zero past the end, where a
// read is never placed).
fn table_bytes(entries: List<Nat>) → List<BitVec(8)> {
    match entries { Nil => [], Cons(entry, rest) => word_bytes(BitVec::ofNat(entry)) ++ table_bytes(rest) }
}
fn table_word(entries: List<Nat>, index: Nat) → BitVec(64) {
    BitVec::ofNat(match entries.nth(index) { None => 0, Some(entry) => entry })
}
theorem table_bytes_length(entries: List<Nat>): table_bytes(entries).len() = 8 * entries.len() {
    match entries {
        Nil => refl,
        Cons(entry, rest) => {
            let inner = table_bytes_length(rest);
            trans(List::len_append(word_bytes(BitVec::ofNat(entry)), table_bytes(rest)), omega(inner))
        },
    }
}

// Entry `index` of a resident table reads as its word, below the canonical
// boundary.
theorem Stack::table_word_at<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), memory: M,
    entries: List<Nat>): (index: Nat) → (start: BitVec(64)) → CodeResident(fetch, memory, table_bytes(entries), start) → index < entries.len() →
    (next_rip(start, 8 * index).toNat() + 8 <= Nat::pow(2, 47)) ∧
        (read_word(data, memory, next_rip(start, 8 * index)) = Some(table_word(entries, index))) {
    match entries {
        Nil => λ index start resident inside => { let bad: False = omega(inside); false_elim(bad) },
        Cons(entry, rest) => λ index start resident inside => {
            let w = BitVec::ofNat(entry, n := 64);
            let parts = resident_split(fetch, memory, word_bytes(w), table_bytes(rest), start, resident);
            match index {
                Zero => {
                    let got = stack.code_word(memory, imm_byte0(w), imm_byte1(w), imm_byte2(w), imm_byte3(w), imm_byte4(w), imm_byte5(w),
                        imm_byte6(w), imm_byte7(w), table_bytes(rest), start, resident);
                    ⟨got.left, trans(got.right, cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x), immediate_bytes_roundtrip(w)))⟩
                },
                Succ(k) => {
                    let later = stack.table_word_at(memory, rest, k, next_rip(start, 8), parts.right, omega(inside));
                    let moved: (next_rip(next_rip(start, 8), 8 * k) = next_rip(start, 8 * Succ(k))) =
                        trans(rip_compose(start, 8, 8 * k), rip_count(start, omega));
                    j(moved, λ a _ => (a.toNat() + 8 <= Nat::pow(2, 47)) ∧ (read_word(data, memory, a) = Some(table_word(rest, k))), later)
                },
            }
        },
    }
}

// The indexed address is `index` words past the base, when eight times the
// index does not wrap.
theorem indexed_address_at(load: IndexedWordLoad, gprs: Gprs, start: BitVec(64), index: Nat,
    base_at: read_gpr(load.base.gpr(), gprs) = start, index_at: read_gpr(load.index.gpr(), gprs).toNat() = index,
    small: index * 8 < Nat::pow(2, 64)): indexed_address(load, gprs) = next_rip(start, 8 * index) {
    let x = read_gpr(load.index.gpr(), gprs);
    let fits: (x.toNat() * Nat::pow(2, 3) < Nat::pow(2, 64)) = j(sym(index_at), λ v _ => v * Nat::pow(2, 3) < Nat::pow(2, 64), small);
    let shifted: (x.shift_left(3).toNat() = 8 * index) = trans(BitVec::toNat_shift_left(64, x, 3, fits), omega(index_at));
    trans(sym(BitVec::iter_add_eq_add(64, read_gpr(load.base.gpr(), gprs), x.shift_left(3))),
        trans(BitVec::cong_iterate_increment_count(64, read_gpr(load.base.gpr(), gprs), shifted),
            BitVec::cong_iterate_increment(64, 8 * index, base_at)))
}

// The word at entry `index` of a table at `base` (`IndexedWordLoad`), as a
// piece: no `Asm` constructor of its own.
fn asm_indexed_load(load: IndexedWordLoad) → Asm { Asm::piece(indexed_word_load_bytes(load), 4, indexed_word_load_length(load)) }

// The indexed load at a label: the eight bytes at the address read as a
// word, below the canonical boundary.
theorem Site::moves_indexed_load<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, load: IndexedWordLoad, at: asm_back(site.program, k) = At(before, name, asm_indexed_load(load)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → Exists<BitVec(64)>(λ word =>
        (indexed_address(load, s.gprs).toNat() + 8 <= Nat::pow(2, 47)) ∧
        ((read_word(site.data, s.memory, indexed_address(load, s.gprs)) = Some(word)) ∧ post(indexed_word_load_after(load, word, s))))):
    site.Moves(writes, prog_len(before), prog_len(before) + 4, pre, post) {
    λ s here resident holds => {
        let found = step(s, holds);
        let after = indexed_word_load_after(load, found.witness, s);
        let one: FetchedStep(site.fetch, site.data, s, after) = Exists(EmitIndexedWordLoad(load),
            ⟨site.item_fetched(fits, s, resident, k, before, name, asm_indexed_load(load), at, here),
             Exists(found.witness, IndexedWordLoadStep(canonical := found.proof.left, present := found.proof.right.left, execution := refl))⟩);
        Exists(after, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, after, fetched_steps_one(site.fetch, site.data, s, after, one)),
            ⟨site.rip_after(s, prog_len(before), 4, here), ⟨resident, found.proof.right.right⟩⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// A constant table read in place

// A table read where it is used: LEA of the table's address, which is the
// bytes after the jump that skips them, the jump, the table, and the load
// of its entry at the index register into the register the LEA wrote. No
// label is named, so the program's labels say nothing of it.
fn table_lea(destination: Gpr) → Asm {
    Asm::piece(lea_rip_bytes(LeaRip(destination := destination, displacement := BitVec::ofNat(5))), 7,
        lea_rip_length(LeaRip(destination := destination, displacement := BitVec::ofNat(5))))
}
fn table_jump(length: Nat) → Asm { Asm::piece(near_control_bytes(JumpNear(BitVec::ofNat(length))), 5, refl) }
fn table_piece(entries: List<Nat>) → Asm { Asm::piece(table_bytes(entries), 8 * entries.len(), table_bytes_length(entries)) }
fn table_read_load(base: SibBase, index: SibIndex) → IndexedWordLoad { IndexedWordLoad(destination := base.gpr(), base := base, index := index) }
fn table_read_prog(prog: Prog, base: SibBase, index: SibIndex, entries: List<Nat>) → Prog {
    At(At(At(At(prog, 0, table_lea(base.gpr())), 0, table_jump(8 * entries.len())), 0, table_piece(entries)), 0,
        asm_indexed_load(table_read_load(base, index)))
}

// The table read at a label: from registers `g` whose index register holds
// an index inside the table, the base register ends holding the entry,
// having held the table's address, and nothing else changes. The jump's
// displacement must read back as the table's length (`jump`, checked by
// whoever emits it).
theorem Site::moves_table_read<M>(self site: Site<M>, writes: ByteWrites<M>, stack: Stack<M>(site.fetch, site.data),
    fits: FillsFit(site.program, no_fills()), k: Nat, prog: Prog, base: SibBase, index: SibIndex, entries: List<Nat>,
    at: asm_back(site.program, k) = table_read_prog(prog, base, index, entries),
    jump: BitVec::ofNat(8 * entries.len(), n := 32).sign_extend(32).toNat() = 8 * entries.len(),
    apart: (!base.gpr().same(index.gpr())).IsTrue(),
    pre, post: Gprs → M → Type,
    step: (g: Gprs) → (m: M) → pre(g, m) → (read_gpr(index.gpr(), g).toNat() < entries.len()) ∧
        post(write_gpr(base.gpr(), table_word(entries, read_gpr(index.gpr(), g).toNat()),
            write_gpr(base.gpr(), next_rip(site.origin, prog_len(prog) + 12), g)), m)):
    site.Moves(writes, prog_len(prog), prog_len(table_read_prog(prog, base, index, entries)),
        λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory)) {
    λ s0 here resident holds => {
        let p = prog_len(prog);
        let n = entries.len();
        let d = base.gpr();
        let lea = LeaRip(destination := d, displacement := BitVec::ofNat(5));
        let control = JumpNear(BitVec::ofNat(8 * n));
        let load = table_read_load(base, index);
        let with_lea = At(prog, 0, table_lea(d));
        let with_jump = At(with_lea, 0, table_jump(8 * n));
        let with_table = At(with_jump, 0, table_piece(entries));
        let back = λ (j: Nat) => trans(sym(asm_back_back(k, site.program, j)), cong_fn<Prog, Prog>(λ q => asm_back(q, j), at));
        let at_lea: (asm_back(site.program, 3 + k) = with_lea) = back(3);
        let at_jump: (asm_back(site.program, 2 + k) = with_jump) = back(2);
        let at_table: (asm_back(site.program, 1 + k) = with_table) = back(1);
        // The LEA: the table's address, 5 past its end.
        let s1 = lea_rip_after(lea, s0);
        let five: (BitVec::ofNat(5, n := 32).sign_extend(32).toNat() = 5) = refl;
        let address: (near_branch_target(s0.rip, 7, BitVec::ofNat(5)) = next_rip(site.origin, p + 12)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 7, BitVec::ofNat(5)), here),
                jumps_forward(site.origin, p, 7, BitVec::ofNat(5), p + 12, omega(five)));
        let one: FetchedStep(site.fetch, site.data, s0, s1) = Exists(EmitLeaRip(lea),
            ⟨site.item_fetched(fits, s0, resident, 3 + k, prog, 0, table_lea(d), at_lea, here), refl⟩);
        let here1: (s1.rip = next_rip(site.origin, p + 7)) = site.rip_after(s0, p, 7, here);
        // The jump over the table.
        let s2 = execute_near_control(control, s1);
        let two: FetchedStep(site.fetch, site.data, s1, s2) = Exists(EmitNear(control),
            ⟨site.item_fetched(fits, s1, resident, 2 + k, with_lea, 0, table_jump(8 * n), at_jump, here1), ⟨refl, refl⟩⟩);
        let here2: (s2.rip = next_rip(site.origin, (p + 12) + 8 * n)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 5, BitVec::ofNat(8 * n)), here1),
                jumps_forward(site.origin, p + 7, 5, BitVec::ofNat(8 * n), (p + 12) + 8 * n, omega(jump)));
        // The load of the entry.
        let g = s0.gprs;
        let got = step(g, s0.memory, holds);
        let i = read_gpr(index.gpr(), g).toNat();
        let table_at = site.item_resident(fits, s0.memory, resident, 1 + k, with_jump, 0, table_piece(entries), at_table);
        let word = stack.table_word_at(s0.memory, entries, i, next_rip(site.origin, p + 12), table_at, got.left);
        let base_at: (read_gpr(d, s2.gprs) = next_rip(site.origin, p + 12)) =
            trans(read_gpr_after_write(d, near_branch_target(s0.rip, 7, BitVec::ofNat(5)), g), address);
        let index_at: (read_gpr(index.gpr(), s2.gprs).toNat() = i) =
            cong_fn<BitVec(64), Nat>(λ x => x.toNat(), write_spares(d, index.gpr(), near_branch_target(s0.rip, 7, BitVec::ofNat(5)), g, apart));
        let small: (i * 8 < Nat::pow(2, 64)) = {
            let wide = BitVec::toNat_lt_pow(64, BitVec::ofNat(8 * n, n := 32).sign_extend(32));
            omega(got.left, jump, wide)
        };
        let at_address: (indexed_address(load, s2.gprs) = next_rip(next_rip(site.origin, p + 12), 8 * i)) =
            indexed_address_at(load, s2.gprs, next_rip(site.origin, p + 12), i, base_at, index_at, small);
        let s3 = indexed_word_load_after(load, table_word(entries, i), s2);
        let three: FetchedStep(site.fetch, site.data, s2, s3) = Exists(EmitIndexedWordLoad(load),
            ⟨site.item_fetched(fits, s2, resident, k, with_table, 0, asm_indexed_load(load), at, here2),
             Exists(table_word(entries, i), IndexedWordLoadStep(
                canonical := j(sym(at_address), λ a _ => a.toNat() + 8 <= Nat::pow(2, 47), word.left),
                present := j(sym(at_address), λ a _ => read_word(site.data, s0.memory, a) = Some(table_word(entries, i)), word.right),
                execution := refl))⟩);
        let steps = machine_steps_trans(site.fetch, site.data, writes, s0, s1, s3,
            machine_steps_of_fetched(site.fetch, site.data, writes, s0, s1, fetched_steps_one(site.fetch, site.data, s0, s1, one)),
            machine_steps_trans(site.fetch, site.data, writes, s1, s2, s3,
                machine_steps_of_fetched(site.fetch, site.data, writes, s1, s2, fetched_steps_one(site.fetch, site.data, s1, s2, two)),
                machine_steps_of_fetched(site.fetch, site.data, writes, s2, s3, fetched_steps_one(site.fetch, site.data, s2, s3, three))));
        let rewritten = j(sym(address), λ a _ => post(write_gpr(d, table_word(entries, i), write_gpr(d, a, g)), s0.memory), got.right);
        Exists(s3, ⟨steps, ⟨site.rip_after(s2, (p + 12) + 8 * n, 4, here2), ⟨resident, rewritten⟩⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// A byte stored

// A register's low byte stored at a label, through a plain base, to a
// writable byte that keeps the code, which is resident when it is stored.
theorem Site::moves_store_byte<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, store: ByteStore, at: asm_back(site.program, k) = At(before, name, StoreByte(store)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → site.Resident(s.memory) → (store_base_plain(store.base) = True) ∧
        (writes.writable(s.memory, read_gpr(store.base, s.gprs), 1) ∧
        (site.Resident(byte_store_after(writes, store, s).memory) ∧ post(byte_store_after(writes, store, s))))):
    site.Moves(writes, prog_len(before), prog_len(before) + 3, pre, post) {
    λ s here resident holds => {
        let got = step(s, holds, resident);
        let after = byte_store_after(writes, store, s);
        Exists(after, ⟨machine_steps_one(site.fetch, site.data, writes, s, after, Inr(Inl(byte_store_step(site.fetch, writes, store, s, got.left,
                site.item_fetched(fits, s, resident, k, before, name, StoreByte(store), at, here), got.right.left)))),
            ⟨site.rip_after(s, prog_len(before), 3, here), got.right.right⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// A doubleword read and stored

// MOV r32, [base] and MOV [base], r32 as pieces: neither needs its own
// `Asm` item, since what a run over one does is the theorem below.
fn asm_dword_load(load: DwordLoad) → Asm { Asm::piece(dword_load_bytes(load), dword_load_bytes(load).len(), refl) }
fn asm_dword_store(store: DwordStore) → Asm { Asm::piece(dword_store_bytes(store), 3, refl) }

// The doubleword load at a label: the four bytes at the base read low
// first, below the canonical boundary, the destination's upper half cleared.
theorem Site::moves_dword_load<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, load: DwordLoad, at: asm_back(site.program, k) = At(before, name, asm_dword_load(load)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → Exists<BitVec(32)>(λ dword =>
        (read_gpr(load.base, s.gprs).toNat() + 4 <= Nat::pow(2, 47)) ∧
        ((read_dword(site.data, s.memory, read_gpr(load.base, s.gprs)) = Some(dword)) ∧ post(dword_load_after(load, dword, s))))):
    site.Moves(writes, prog_len(before), prog_len(before) + dword_load_bytes(load).len(), pre, post) {
    λ s here resident holds => {
        let found = step(s, holds);
        let after = dword_load_after(load, found.witness, s);
        let one: FetchedStep(site.fetch, site.data, s, after) = Exists(EmitDwordLoad(load),
            ⟨site.item_fetched(fits, s, resident, k, before, name, asm_dword_load(load), at, here),
             Exists(found.witness, DwordLoadStep(canonical := found.proof.left, present := found.proof.right.left, execution := refl))⟩);
        Exists(after, ⟨machine_steps_of_fetched(site.fetch, site.data, writes, s, after, fetched_steps_one(site.fetch, site.data, s, after, one)),
            ⟨site.rip_after(s, prog_len(before), dword_load_bytes(load).len(), here), ⟨resident, found.proof.right.right⟩⟩⟩)
    }
}

// A register's low four bytes stored at a label, through a plain base, to
// four writable bytes that keep the code.
theorem Site::moves_dword_store<M>(self site: Site<M>, writes: ByteWrites<M>, fits: FillsFit(site.program, no_fills()), k: Nat,
    before: Prog, name: Nat, store: DwordStore, at: asm_back(site.program, k) = At(before, name, asm_dword_store(store)),
    pre, post: MachineState<M> → Type,
    step: (s: MachineState<M>) → pre(s) → site.Resident(s.memory) → (store_base_plain(store.base) = True) ∧
        (writes.writable(s.memory, read_gpr(store.base, s.gprs), 4) ∧
        (site.Resident(dword_store_after(writes, store, s).memory) ∧ post(dword_store_after(writes, store, s))))):
    site.Moves(writes, prog_len(before), prog_len(before) + 3, pre, post) {
    λ s here resident holds => {
        let got = step(s, holds, resident);
        let after = dword_store_after(writes, store, s);
        Exists(after, ⟨machine_steps_one(site.fetch, site.data, writes, s, after, Inr(Inl(dword_store_step(site.fetch, writes, store, s, got.left,
                site.item_fetched(fits, s, resident, k, before, name, asm_dword_store(store), at, here), got.right.left)))),
            ⟨site.rip_after(s, prog_len(before), 3, here), got.right.right⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// Calls

// A function at offset `entry`: entered with the stack pointer at offset `i`
// of the stack, the return address there, and `pre`, it runs to that
// address, the program still resident, the stack pointer just above it, and
// `post` relating where it was entered to where it returned. A callee's frame
// (registers kept, its caller's words unchanged) is part of its `post`, and
// the room it needs below `i` part of its `pre`.
fn Site::Returns<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), entry: Nat, pre: Nat → MachineState<M> → Type,
    post: Nat → MachineState<M> → MachineState<M> → Type) → Type {
    (s: MachineState<M>) → s.rip = next_rip(site.origin, entry) → site.Resident(s.memory) →
    (i: Nat) → read_gpr(Rsp, s.gprs) = stack.at(i) → i + 8 <= stack.size → pre(i, s) →
    (ret: BitVec(64)) → read_word(site.data, s.memory, stack.at(i)) = Some(ret) →
    Exists<MachineState<M>>(λ t => MachineSteps(site.fetch, site.data, stack.writes, s, t) ∧
        (t.rip = ret ∧ (site.Resident(t.memory) ∧ ((read_gpr(Rsp, t.gprs) = stack.at(i + 8)) ∧ post(i, s, t)))))
}

theorem Site::returns_weaken<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), entry: Nat,
    pre, weaker: Nat → MachineState<M> → Type, post: Nat → MachineState<M> → MachineState<M> → Type,
    returns: site.Returns(stack, entry, pre, post), implies: (i: Nat) → (s: MachineState<M>) → weaker(i, s) → pre(i, s)):
    site.Returns(stack, entry, weaker, post) {
    λ s at resident i rsp room held ret saved => returns(s, at, resident, i, rsp, room, implies(i, s, held), ret, saved)
}

// A weaker promise, from the stronger one and the room it was entered with.
theorem Site::returns_implies<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), entry: Nat,
    pre: Nat → MachineState<M> → Type, post, weaker: Nat → MachineState<M> → MachineState<M> → Type,
    returns: site.Returns(stack, entry, pre, post),
    implies: (i: Nat) → (s, t: MachineState<M>) → i + 8 <= stack.size → post(i, s, t) → weaker(i, s, t)):
    site.Returns(stack, entry, pre, weaker) {
    λ s at resident i rsp room held ret saved => {
        let ran = returns(s, at, resident, i, rsp, room, held, ret, saved);
        Exists(ran.witness, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨ran.proof.right.right.left,
            ⟨ran.proof.right.right.right.left, implies(i, s, ran.witness, room, ran.proof.right.right.right.right)⟩⟩⟩⟩)
    }
}

// A CALL at a label, its callee's contract given: from the call to the item
// after it. The stack has room for the return address below the stack
// pointer, at offset `index(s)`; after the call the stack pointer is back.
theorem Site::moves_call<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    k: Nat, before: Prog, name, target: Nat, at: asm_back(site.program, k) = At(before, name, CallTo(target)),
    entry: Nat, lands: NearLands(prog_len(before), asm_jump_of(asm_labels(site.program), prog_len(before), CallTo(target)), entry),
    callee_pre: Nat → MachineState<M> → Type, callee_post: Nat → MachineState<M> → MachineState<M> → Type,
    callee: site.Returns(stack, entry, callee_pre, callee_post),
    pre, post: MachineState<M> → Type, index: MachineState<M> → Nat,
    enter: (s: MachineState<M>) → pre(s) → (read_gpr(Rsp, s.gprs) = stack.at(index(s) + 8)) ∧ (index(s) + 8 <= stack.size ∧
        callee_pre(index(s), call_near_after(stack.writes, asm_jump_of(asm_labels(site.program), prog_len(before), CallTo(target)), s))),
    leave: (s, t: MachineState<M>) → pre(s) → read_gpr(Rsp, t.gprs) = stack.at(index(s) + 8) →
        callee_post(index(s), call_near_after(stack.writes, asm_jump_of(asm_labels(site.program), prog_len(before), CallTo(target)), s), t) →
        post(t)):
    site.Moves(stack.writes, prog_len(before), prog_len(before) + 5, pre, post) {
    λ s here resident holds => {
        let displacement = asm_jump_of(asm_labels(site.program), prog_len(before), CallTo(target));
        let found = enter(s, holds);
        let i = index(s);
        let rsp: (read_gpr(Rsp, s.gprs) = stack.at(i + 8)) = found.left;
        let room: (i + 8 <= stack.size) = found.right.left;
        let pushed: (push_address(s.gprs) = stack.at(i)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.sub(BitVec::ofNat(8)), rsp), push_at(stack.low, i));
        let ret = next_rip(s.rip, 5);
        let u = call_near_after(stack.writes, displacement, s);
        let executes: CallNear(displacement).Executes(site.data, stack.writes, s, u) =
            ⟨j(sym(pushed), λ a _ => WordCanonical(a), stack.canonical(i, room)),
             ⟨j(sym(pushed), λ a _ => stack.writes.writable(s.memory, a, 8), stack.writable(s.memory, i, room)), refl⟩⟩;
        let call = stack_step_machine(site.fetch, site.data, stack.writes, CallNear(displacement), s, u,
            site.item_fetched(fits, s, resident, k, before, name, CallTo(target), at, here), executes);
        let u_rip: (u.rip = next_rip(site.origin, entry)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 5, displacement), here),
                near_lands_target(site.origin, prog_len(before), displacement, entry, lands));
        let u_resident: site.Resident(u.memory) =
            j(sym(pushed), λ a _ => site.Resident(stack.writes.store(s.memory, a, word_bytes(ret))),
                stack.keeps_code(s.memory, i, room, ret, assemble(no_fills(), site.program, site.last), next_rip(site.origin, 0), resident));
        let u_rsp: (read_gpr(Rsp, u.gprs) = stack.at(i)) =
            trans(read_gpr_after_write(Rsp, push_address(s.gprs), s.gprs), pushed);
        let u_ret: (read_word(site.data, u.memory, stack.at(i)) = Some(ret)) =
            j(sym(pushed), λ a _ => read_word(site.data, stack.writes.store(s.memory, a, word_bytes(ret)), stack.at(i)) = Some(ret),
                stack.stored(s.memory, i, room, ret));
        let returned = callee(u, u_rip, u_resident, i, u_rsp, room, found.right.right, ret, u_ret);
        let t = returned.witness;
        Exists(t, ⟨machine_steps_trans(site.fetch, site.data, stack.writes, s, u, t, call, returned.proof.left),
            ⟨trans(returned.proof.right.left, site.rip_after(s, prog_len(before), 5, here)),
             ⟨returned.proof.right.right.left,
                leave(s, t, holds, returned.proof.right.right.right.left, returned.proof.right.right.right.right)⟩⟩⟩)
    }
}

// A function closed by RET: its body runs from its entry to the RET with
// the stack pointer back where it entered and the return address still
// there, and `post` holds of where it returns.
theorem Site::returns_by<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    entry: Nat, k: Nat, before: Prog, name: Nat, at: asm_back(site.program, k) = At(before, name, Ret),
    pre: Nat → MachineState<M> → Type, post: Nat → MachineState<M> → MachineState<M> → Type,
    body: (s0: MachineState<M>) → (i: Nat) → (ret: BitVec(64)) → site.Moves(stack.writes, entry, prog_len(before),
        λ (s: MachineState<M>) => (s = s0) ∧ ((read_gpr(Rsp, s0.gprs) = stack.at(i)) ∧ (i + 8 <= stack.size ∧
            (pre(i, s0) ∧ read_word(site.data, s0.memory, stack.at(i)) = Some(ret)))),
        λ (t: MachineState<M>) => (read_gpr(Rsp, t.gprs) = stack.at(i)) ∧
            ((read_word(site.data, t.memory, stack.at(i)) = Some(ret)) ∧ post(i, s0, return_near_after(ret, t))))):
    site.Returns(stack, entry, pre, post) {
    λ s here resident i rsp room holds ret read => {
        let ran = body(s, i, ret, s, here, resident, ⟨refl, ⟨rsp, ⟨room, ⟨holds, read⟩⟩⟩⟩);
        let t = ran.witness;
        let done = ran.proof.right.right.right;
        let t_rsp: (read_gpr(Rsp, t.gprs) = stack.at(i)) = done.left;
        let r = return_near_after(ret, t);
        let executes: ReturnNear.Executes(site.data, stack.writes, t, r) =
            ⟨j(sym(t_rsp), λ a _ => WordCanonical(a), stack.canonical(i, room)),
             Exists(ret, ⟨j(sym(t_rsp), λ a _ => read_word(site.data, t.memory, a) = Some(ret), done.right.left), refl⟩)⟩;
        let step = stack_step_machine(site.fetch, site.data, stack.writes, ReturnNear, t, r,
            site.item_fetched(fits, t, ran.proof.right.right.left, k, before, name, Ret, at, ran.proof.right.left), executes);
        Exists(r, ⟨machine_steps_trans(site.fetch, site.data, stack.writes, s, t, r, ran.proof.left, step),
            ⟨refl, ⟨ran.proof.right.right.left,
                ⟨trans(read_gpr_after_write(Rsp, read_gpr(Rsp, t.gprs).add(BitVec::ofNat(8)), t.gprs),
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(BitVec::ofNat(8)), t_rsp), pop_at(stack.low, i))),
                 done.right.right⟩⟩⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// Saving registers in a frame and restoring them

// Spills of `registers` into the slots `k`, `k + 1`, … of the frame the
// stack pointer marks, and the reloads back.
fn List::spills(self registers: List<Gpr>, prog: Prog, k: Nat) → Prog {
    match registers {
        Nil => prog,
        Cons(register, rest) => rest.spills(At(prog, 0, Spill(StackStore(register, slot_offset(k)))), Succ(k)),
    }
}
fn List::reloads(self registers: List<Gpr>, prog: Prog, k: Nat) → Prog {
    match registers {
        Nil => prog,
        Cons(register, rest) => rest.reloads(At(prog, 0, Reload(StackLoad(register, slot_offset(k)))), Succ(k)),
    }
}

theorem Prog::within_spills(registers: List<Gpr>): (prog: Prog) → (k: Nat) → prog.Within(registers.spills(prog, k)) {
    match registers {
        Nil => λ prog k => prog.within_self(),
        Cons(register, rest) => λ prog k => {
            let item = At(prog, 0, Spill(StackStore(register, slot_offset(k))));
            prog.within_trans(item, rest.spills(item, Succ(k)), prog.within_then(0, Spill(StackStore(register, slot_offset(k)))),
                Prog::within_spills(rest, item, Succ(k)))
        },
    }
}
theorem Prog::within_reloads(registers: List<Gpr>): (prog: Prog) → (k: Nat) → prog.Within(registers.reloads(prog, k)) {
    match registers {
        Nil => λ prog k => prog.within_self(),
        Cons(register, rest) => λ prog k => {
            let item = At(prog, 0, Reload(StackLoad(register, slot_offset(k))));
            prog.within_trans(item, rest.reloads(item, Succ(k)), prog.within_then(0, Reload(StackLoad(register, slot_offset(k)))),
                Prog::within_reloads(rest, item, Succ(k)))
        },
    }
}

// The slots from `k` hold the registers' words in `gprs`.
fn Stack::Saved<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    registers: List<Gpr>) → Nat → Gprs → M → Type {
    match registers {
        Nil => λ _ _ _ => True,
        Cons(register, rest) => λ k gprs memory => (read_word(data, memory, stack.at(d + 8 * k)) = Some(read_gpr(register, gprs))) ∧
            stack.Saved(d, rest, Succ(k), gprs, memory),
    }
}

// The slots are stable under a word stored below `from`, when they lie at
// or above it: what a body keeps of its saved registers across its own
// stores and its callees' (`Stack::wrote_frame`).
theorem Stack::stable_saved<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), from, d: Nat,
    gprs: Gprs, registers: List<Gpr>): (k: Nat) → from <= d + 8 * k → d + 8 * (k + registers.len()) <= stack.size →
    stack.Stable(from, λ (m: M) => stack.Saved(d, registers, k, gprs, m)) {
    match registers {
        Nil => λ k _ _ memory own below word held => trivial,
        Cons(register, rest) => λ k above room =>
            stack.stable_and(from, stack.stable_word(from, d + 8 * k, above, { omega }, Some(read_gpr(register, gprs))),
                stack.stable_saved(from, d, gprs, rest, Succ(k), { omega }, { omega })),
    }
}

// The registers' words restored over `gprs` from `saved`, in order.
fn restore(registers: List<Gpr>, saved, gprs: Gprs) → Gprs {
    match registers {
        Nil => gprs,
        Cons(register, rest) => restore(rest, saved, write_gpr(register, read_gpr(register, saved), gprs)),
    }
}

// Slot `k` of the frame at offset `d`, the stack pointer there.
theorem Stack::slot_address<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, k: Nat,
    gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d), small: k < 16):
    stack_address(gprs, slot_offset(k)) = stack.at(d + 8 * k) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(slot_offset(k).sign_extend(56)), rsp), slot_at(stack.low, d, k, small))
}

// The spills run with the registers as they are, each word landing in its
// slot; whatever `frame` says of memory survives stores to the slots.
theorem Site::moves_spills<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    d: Nat, gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d), registers: List<Gpr>):
    (prog: Prog) → (k: Nat) → k + registers.len() <= 16 → d + 8 * (k + registers.len()) <= stack.size →
    (frame: M → Type) →
    ((memory: M) → (i: Nat) → d + 8 * k <= i → i + 8 <= d + 8 * (k + registers.len()) → (word: BitVec(64)) →
        frame(memory) → frame(stack.writes.store(memory, stack.at(i), word_bytes(word)))) →
    registers.spills(prog, k).Within(site.program) →
    site.Moves(stack.writes, prog_len(prog), prog_len(registers.spills(prog, k)),
        λ (s: MachineState<M>) => (s.gprs = gprs) ∧ frame(s.memory),
        λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (frame(t.memory) ∧ stack.Saved(d, registers, k, gprs, t.memory))) {
    match registers {
        Nil => λ prog k _ _ frame _ _ => site.moves_refl(stack.writes, prog_len(prog),
            λ (s: MachineState<M>) => (s.gprs = gprs) ∧ frame(s.memory),
            λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (frame(t.memory) ∧ True),
            λ s held => ⟨held.left, ⟨held.right, trivial⟩⟩),
        Cons(register, rest) => λ prog k small room frame stable within => {
            let store = StackStore(register, slot_offset(k));
            let item = At(prog, 0, Spill(store));
            let i = d + 8 * k;
            let slot_small: (k < 16) = { omega };
            let slot_room: (i + 8 <= stack.size) = { omega };
            let kept = λ (memory: M) => frame(memory) ∧ (read_word(site.data, memory, stack.at(i)) = Some(read_gpr(register, gprs)));
            let item_in = item.within_trans(rest.spills(item, Succ(k)), site.program, Prog::within_spills(rest, item, Succ(k)), within);
            let first = site.moves_spill(stack, fits, item_in.witness, prog, 0, store, item_in.proof,
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ frame(s.memory),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ kept(s.memory),
                λ s held => {
                    let address: (stack_address(s.gprs, slot_offset(k)) = stack.at(i)) =
                        j(sym(held.left), λ g _ => stack_address(g, slot_offset(k)) = stack.at(i),
                            stack.slot_address(d, k, gprs, rsp, slot_small));
                    let word = read_gpr(register, s.gprs);
                    let same_word: (word = read_gpr(register, gprs)) = cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(register, g), held.left);
                    let here: kept(stack.writes.store(s.memory, stack.at(i), word_bytes(word))) =
                        ⟨stable(s.memory, i, { omega }, { omega }, word, held.right),
                         trans(stack.stored(s.memory, i, slot_room, word), cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), same_word))⟩;
                    Exists(i, ⟨address, ⟨slot_room, ⟨held.left,
                        j(sym(address), λ a _ => kept(stack.writes.store(s.memory, a, word_bytes(word))), here)⟩⟩⟩)
                });
            let later = Site::moves_spills(site, stack, fits, d, gprs, rsp, rest, item, Succ(k), { omega }, { omega }, kept,
                λ memory n low high w held => ⟨stable(memory, n, { omega }, { omega }, w, held.left),
                    trans(stack.apart(memory, n, i, { omega }, slot_room, Inr({ omega }), w), held.right)⟩,
                within);
            site.moves_trans(stack.writes, prog_len(prog), prog_len(item), prog_len(rest.spills(item, Succ(k))),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ frame(s.memory),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ kept(s.memory),
                λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (frame(t.memory) ∧ stack.Saved(d, Cons(register, rest), k, gprs, t.memory)),
                first,
                site.moves_weaken(stack.writes, prog_len(item), prog_len(rest.spills(item, Succ(k))),
                    λ (s: MachineState<M>) => (s.gprs = gprs) ∧ kept(s.memory),
                    λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (kept(t.memory) ∧ stack.Saved(d, rest, Succ(k), gprs, t.memory)),
                    λ (s: MachineState<M>) => (s.gprs = gprs) ∧ kept(s.memory),
                    λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (frame(t.memory) ∧ stack.Saved(d, Cons(register, rest), k, gprs, t.memory)),
                    later, λ s held => held,
                    λ t held => ⟨held.left, ⟨held.right.left.left, ⟨held.right.left.right, held.right.right⟩⟩⟩))
        },
    }
}

// The reloads leave the registers restored from the slots and memory as
// it was.
theorem Site::moves_reloads<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    d: Nat, saved: Gprs, registers: List<Gpr>):
    (prog: Prog) → (k: Nat) → (gprs: Gprs) → k + registers.len() <= 16 → d + 8 * (k + registers.len()) <= stack.size →
    registers.spare(Rsp).IsTrue() → read_gpr(Rsp, gprs) = stack.at(d) → (frame: M → Type) →
    registers.reloads(prog, k).Within(site.program) →
    site.Moves(stack.writes, prog_len(prog), prog_len(registers.reloads(prog, k)),
        λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (frame(s.memory) ∧ stack.Saved(d, registers, k, saved, s.memory)),
        λ (t: MachineState<M>) => (t.gprs = restore(registers, saved, gprs)) ∧ frame(t.memory)) {
    match registers {
        Nil => λ prog k gprs _ _ _ _ frame _ => site.moves_refl(stack.writes, prog_len(prog),
            λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (frame(s.memory) ∧ True),
            λ (t: MachineState<M>) => (t.gprs = gprs) ∧ frame(t.memory),
            λ s held => ⟨held.left, held.right.left⟩),
        Cons(register, rest) => λ prog k gprs small room spare rsp frame within => {
            let load = StackLoad(register, slot_offset(k));
            let item = At(prog, 0, Reload(load));
            let i = d + 8 * k;
            let slot_small: (k < 16) = { omega };
            let slot_room: (i + 8 <= stack.size) = { omega };
            let word = read_gpr(register, saved);
            let next = write_gpr(register, word, gprs);
            let spares = Bool::is_true_and(!register.same(Rsp), rest.spare(Rsp), spare);
            let item_in = item.within_trans(rest.reloads(item, Succ(k)), site.program, Prog::within_reloads(rest, item, Succ(k)), within);
            let first = site.moves_reload(stack, fits, item_in.witness, prog, 0, load, item_in.proof,
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (frame(s.memory) ∧ stack.Saved(d, Cons(register, rest), k, saved, s.memory)),
                λ (s: MachineState<M>) => (s.gprs = next) ∧ (frame(s.memory) ∧ stack.Saved(d, rest, Succ(k), saved, s.memory)),
                λ s held => Exists(i, ⟨j(sym(held.left), λ g _ => stack_address(g, slot_offset(k)) = stack.at(i),
                        stack.slot_address(d, k, gprs, rsp, slot_small)),
                    ⟨slot_room, Exists(word, ⟨held.right.right.left,
                        ⟨cong_fn<Gprs, Gprs>(λ g => write_gpr(register, word, g), held.left), ⟨held.right.left, held.right.right.right⟩⟩⟩)⟩⟩));
            let later = Site::moves_reloads(site, stack, fits, d, saved, rest, item, Succ(k), next, { omega }, { omega }, spares.right,
                trans(write_spares(register, Rsp, word, gprs, spares.left), rsp), frame, within);
            site.moves_trans(stack.writes, prog_len(prog), prog_len(item), prog_len(rest.reloads(item, Succ(k))),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (frame(s.memory) ∧ stack.Saved(d, Cons(register, rest), k, saved, s.memory)),
                λ (s: MachineState<M>) => (s.gprs = next) ∧ (frame(s.memory) ∧ stack.Saved(d, rest, Succ(k), saved, s.memory)),
                λ (t: MachineState<M>) => (t.gprs = restore(rest, saved, next)) ∧ frame(t.memory),
                first, later)
        },
    }
}

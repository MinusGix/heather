// The stores the compiler emits (docs/native-first-program-design.md §10,
// docs/native-tr-design.md §3.1): `mov qword [base], source`, and
// `mov byte [base], source` for the source's low byte, each for a base that
// needs neither a SIB byte nor a displacement. A store writes its bytes, low
// first, through a write model the profile supplies; the model says which
// spans are writable and what memory looks like after. `FetchedStep` stays
// the read-only relation the loop and branch bridges run on; a profile whose
// programs store adds this step beside it.
import x86_64;
import x86_64_fetch;
import bitvec;
import bool;
import list;
import logic;
import nat;
import relation_props;

record WordStore { base: Gpr, source: Gpr }

// A ModRM `rm` of 100 means a SIB byte follows, and 101 with mod 00 means a
// displacement: those bases are not this encoding.
fn store_base_plain(base: Gpr) → Bool {
    match base {
        Rsp => False, Rbp => False, R12 => False, R13 => False,
        Rax => True, Rcx => True, Rdx => True, Rbx => True, Rsi => True, Rdi => True,
        R8 => True, R9 => True, R10 => True, R11 => True, R14 => True, R15 => True,
    }
}

fn word_store_bytes(store: WordStore) → List<BitVec(8)> {
    [rex_w_rr(store.base, store.source), BitVec::ofNat(0x89),
     byte_from_fields(gpr_bit0(store.base), gpr_bit1(store.base), gpr_bit2(store.base),
        gpr_bit0(store.source), gpr_bit1(store.source), gpr_bit2(store.source), False, False)]
}

// The bytes a word occupies in memory, low first.
fn word_bytes(value: BitVec(64)) → List<BitVec(8)> {
    [imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value),
     imm_byte4(value), imm_byte5(value), imm_byte6(value), imm_byte7(value)]
}

// The byte store always carries a REX, without W, so the low byte of every
// register is encodable (SIL and DIL need one; AH to BH are never meant).
record ByteStore { base: Gpr, source: Gpr }

fn byte_store_bytes(store: ByteStore) → List<BitVec(8)> {
    [rex_plain_rr(store.base, store.source), BitVec::ofNat(0x88),
     byte_from_fields(gpr_bit0(store.base), gpr_bit1(store.base), gpr_bit2(store.base),
        gpr_bit0(store.source), gpr_bit1(store.source), gpr_bit2(store.source), False, False)]
}

// MOV dword [base], source (89 /r without REX.W, Intel SDM Vol. 2B, MOV):
// the source's low four bytes, low first. Its REX is always written, as
// the byte store's is, so it is three bytes for every register.
record DwordStore { base: Gpr, source: Gpr }

fn dword_store_bytes(store: DwordStore) → List<BitVec(8)> {
    [rex_plain_rr(store.base, store.source), BitVec::ofNat(0x89),
     byte_from_fields(gpr_bit0(store.base), gpr_bit1(store.base), gpr_bit2(store.base),
        gpr_bit0(store.source), gpr_bit1(store.source), gpr_bit2(store.source), False, False)]
}

// The bytes a word's low half occupies in memory, low first.
fn dword_bytes(value: BitVec(64)) → List<BitVec(8)> {
    [imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value)]
}

inductive MemoryStore {
    StoreWord(store: WordStore),
    StoreByte(store: ByteStore),
    StoreDword(store: DwordStore),
}
fn memory_store_bytes(store: MemoryStore) → List<BitVec(8)> {
    match store { StoreWord(word) => word_store_bytes(word), StoreByte(byte) => byte_store_bytes(byte), StoreDword(dword) => dword_store_bytes(dword) }
}
fn memory_store_base(store: MemoryStore) → Gpr {
    match store { StoreWord(word) => word.base, StoreByte(byte) => byte.base, StoreDword(dword) => dword.base }
}
fn memory_store_width(store: MemoryStore) → Nat {
    match store { StoreWord(_) => 8, StoreByte(_) => 1, StoreDword(_) => 4 }
}
// What a store writes: the source's eight bytes, or its low one.
fn memory_store_data(store: MemoryStore, gprs: Gprs) → List<BitVec(8)> {
    match store {
        StoreWord(word) => word_bytes(read_gpr(word.source, gprs)),
        StoreByte(byte) => [imm_byte0(read_gpr(byte.source, gprs))],
        StoreDword(dword) => dword_bytes(read_gpr(dword.source, gprs)),
    }
}

record ByteWrites<M> {
    writable: M → BitVec(64) → Nat → Type,
    store: M → BitVec(64) → List<BitVec(8)> → M,
}

fn memory_store_after<M>(writes: ByteWrites<M>, store: MemoryStore, before: MachineState<M>) → MachineState<M> {
    MachineState(before.gprs, before.flags, next_rip(before.rip, 3),
        writes.store(before.memory, read_gpr(memory_store_base(store), before.gprs), memory_store_data(store, before.gprs)))
}
fn word_store_after<M>(writes: ByteWrites<M>, store: WordStore, before: MachineState<M>) → MachineState<M> {
    memory_store_after(writes, StoreWord(store), before)
}
fn byte_store_after<M>(writes: ByteWrites<M>, store: ByteStore, before: MachineState<M>) → MachineState<M> {
    memory_store_after(writes, StoreByte(store), before)
}
fn dword_store_after<M>(writes: ByteWrites<M>, store: DwordStore, before: MachineState<M>) → MachineState<M> {
    memory_store_after(writes, StoreDword(store), before)
}

evidence theorem memory_store_respects_defined<M>({writes: ByteWrites<M>}, {store: MemoryStore}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, memory_store_after<M>(writes, store)) {
    same_defined_respects(memory_store_after<M>(writes, store), λ state => refl)
}

// One fetched store: the exact bytes at RIP, a plain base, a writable span.
fn StoreStep<M>(fetch: FetchAccess<M>, writes: ByteWrites<M>, before, after: MachineState<M>) → Type {
    Exists<MemoryStore>(λ store => (store_base_plain(memory_store_base(store)) = True) ∧
        (FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, memory_store_bytes(store))) ∧
        (writes.writable(before.memory, read_gpr(memory_store_base(store), before.gprs), memory_store_width(store)) ∧
        after = memory_store_after(writes, store, before))))
}

theorem store_step_respects_same_witness<M>(fetch: FetchAccess<M>, writes: ByteWrites<M>,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left: StoreStep(fetch, writes, before_left, after_left),
    right: StoreStep(fetch, writes, before_right, after_right),
    same_store: left.witness = right.witness):
    SameDefinedState<M>(after_left, after_right) {
    let runner: (candidate: MemoryStore) → (left.witness = candidate) →
        ((store_base_plain(memory_store_base(candidate)) = True) ∧
         (FetchedFrom(fetch, before_right.memory, InstructionBytes(before_right.rip, memory_store_bytes(candidate))) ∧
         (writes.writable(before_right.memory, read_gpr(memory_store_base(candidate), before_right.gprs), memory_store_width(candidate)) ∧
          after_right = memory_store_after(writes, candidate, before_right)))) →
        SameDefinedState<M>(after_left, after_right) =
        λ candidate same evidence =>
            j(same, λ actual _ =>
                ((store_base_plain(memory_store_base(actual)) = True) ∧
                 (FetchedFrom(fetch, before_right.memory, InstructionBytes(before_right.rip, memory_store_bytes(actual))) ∧
                 (writes.writable(before_right.memory, read_gpr(memory_store_base(actual), before_right.gprs), memory_store_width(actual)) ∧
                  after_right = memory_store_after(writes, actual, before_right)))) →
                SameDefinedState<M>(after_left, after_right),
                λ agreed => calc {
                    after_left ≈ memory_store_after(writes, left.witness, before_left) :=
                        SameDefinedState::of_equal(left.proof.right.right.right),
                    ≈ memory_store_after(writes, left.witness, before_right) := rel_cong(before_same),
                    ≈ after_right := SameDefinedState::of_equal(sym(agreed.right.right.right)),
                })(evidence);
    runner(right.witness, same_store, right.proof)
}

theorem store_step<M>(fetch: FetchAccess<M>, writes: ByteWrites<M>, store: WordStore, before: MachineState<M>,
    plain: store_base_plain(store.base) = True,
    fetched: FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, word_store_bytes(store))),
    writable: writes.writable(before.memory, read_gpr(store.base, before.gprs), 8)):
    StoreStep(fetch, writes, before, word_store_after(writes, store, before)) {
    Exists(StoreWord(store), ⟨plain, ⟨fetched, ⟨writable, refl⟩⟩⟩)
}

theorem byte_store_step<M>(fetch: FetchAccess<M>, writes: ByteWrites<M>, store: ByteStore, before: MachineState<M>,
    plain: store_base_plain(store.base) = True,
    fetched: FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, byte_store_bytes(store))),
    writable: writes.writable(before.memory, read_gpr(store.base, before.gprs), 1)):
    StoreStep(fetch, writes, before, byte_store_after(writes, store, before)) {
    Exists(StoreByte(store), ⟨plain, ⟨fetched, ⟨writable, refl⟩⟩⟩)
}

theorem dword_store_step<M>(fetch: FetchAccess<M>, writes: ByteWrites<M>, store: DwordStore, before: MachineState<M>,
    plain: store_base_plain(store.base) = True,
    fetched: FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, dword_store_bytes(store))),
    writable: writes.writable(before.memory, read_gpr(store.base, before.gprs), 4)):
    StoreStep(fetch, writes, before, dword_store_after(writes, store, before)) {
    Exists(StoreDword(store), ⟨plain, ⟨fetched, ⟨writable, refl⟩⟩⟩)
}

// The call contract (docs/language/ownership-design.md §17.2, §18.1, §18.2;
// issues/bytes-level-on-the-contract.md): what a routine's meaning answers,
// and what that asks of its code at the machine (`Site::Meets`).
//
// - A value is a word or a reference (`Value`: a block and a byte offset),
//   lowered to a word by where the blocks lie (`Value::lower`: a reference
//   is its target's address). An answer is the values, the heap
//   (x86_64_memory_contract's `Heap`) and the world (linux_world's `Io`).
//   A run at some fuel comes to one of four outcomes (`Ran`): done with a
//   value, exited with a status and the world, still going with the world
//   so far, or stuck where it has no meaning, with the world it was stuck
//   in. Every outcome carries a history (`Ran::past`): the exchanges made by
//   then, newest first.
// - `Site::Meets`: a meaning over fuel (`Calls()` at each fuel, the bytes
//   level's `run`), met by the code at its labels, over one lending for the
//   whole run, with the world in the machine's state as in the meaning's.
//   Entered with the arguments passed, the heap injected and the world `io`,
//   at every fuel: where the meaning is done, the code returns with the
//   answer's words in place, the kept registers kept, its stores inside the
//   lending, the answer's heap injected and the answer's world; where it has
//   exited, the code makes the exit call with that status and world; and
//   every world the code reaches before it returns or exits is a prefix of a
//   history the meaning reaches. The machine's world is the Linux model's
//   (linux_x86_64_io: a step of the machine between system calls, and at
//   one, the request `LinuxRequests` reads, answered by the world, every
//   resumption `linux_answered` allows).
//
// This is the contract's second module and not part of the first because
// FunctionIR's lowering imports the first and spells FunctionIR's own
// `Word` and `Answer` bare: the meaning's names here would be ambiguous
// there. Only the bytes level and its lowering import this one.
import x86_64_memory_contract;
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import linux_calls;
import linux_world;
import linux_x86_64_io;
import linux_x86_64_determinism;
import x86_64_step_forms;
import transition;
import bitvec;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Values, answers, outcomes

inductive Value { Word(word: BitVec(64)), Ref(loc: Loc) }

// A value as the machine holds it: a word as itself, a reference as its
// target's address.
fn Value::lower(self value: Value, spans: Spans) → BitVec(64) { match value { Word(word) => word, Ref(loc) => loc.address(spans) } }

fn lower_values(spans: Spans, values: List<Value>) → List<BitVec(64)> {
    match values { Nil => Nil, Cons(v, rest) => Cons(v.lower(spans), lower_values(spans, rest)) }
}

// What a call answers: its values, the heap and the world.
record Answer { words: List<Value>, heap: Heap, io: Io }

// What a run comes to at some fuel: done with a value, exited with a status,
// still going with the world so far, or stuck where it has no meaning, with
// the world it got stuck in.
inductive Ran<T> { Done(value: T), Exited(status: BitVec(64), io: Io), Going(io: Io), Stuck(io: Io) }

fn Ran::then<T, U>(self r: Ran<T>, k: T → Ran<U>) → Ran<U> {
    match r { Done(v) => k(v), Exited(status, io) => Exited(status, io), Going(io) => Going(io), Stuck(io) => Stuck(io) }
}

// A partial step at the world `io`: stuck there where it has no meaning.
fn Ran::of<T>(o: Option<T>, io: Io) → Ran<T> { match o { None => Stuck(io), Some(v) => Done(v) } }

// What a program's routines answer at one fuel: routine `f` on values, a
// heap and the world.
fn Calls() → Type { Nat → List<Value> → Heap → Io → Ran<Answer> }

// The world after one exchange.
fn Io::exchanged(self io: Io, cmd: LinuxCmd<Nat>, answer: cmd.Resp()) → Io { Io(io.world, Cons(Exchange(cmd, answer), io.past)) }

// The exchanges a run has made by where it is, stuck or not,
fn Ran::past(self r: Ran<Answer>) → List<Exchange> {
    match r { Done(a) => a.io.past, Exited(_, io) => io.past, Going(io) => io.past, Stuck(io) => io.past }
}

// those of a run that has a meaning there,
fn history(r: Ran<Answer>) → Option<List<Exchange>> {
    match r { Done(a) => Some(a.io.past), Exited(_, io) => Some(io.past), Going(io) => Some(io.past), Stuck(_) => None }
}

// and those a run got stuck after.
fn stuck_after(r: Ran<Answer>) → Option<List<Exchange>> {
    match r { Done(_) => None, Exited(_, _) => None, Going(_) => None, Stuck(io) => Some(io.past) }
}

// `later` is `earlier` with more exchanges after it (newest first).
fn Extends(later, earlier: List<Exchange>) → Type { Exists<List<Exchange>>(λ extra => later = extra ++ earlier) }

theorem extends_refl(h: List<Exchange>): Extends(h, h) { Exists(Nil, refl) }

theorem extends_trans(a, b, c: List<Exchange>, ab: Extends(a, b), bc: Extends(b, c)): Extends(a, c) {
    Exists(ab.witness ++ bc.witness, trans(ab.proof, trans(cong_fn<List<Exchange>, List<Exchange>>(λ l => ab.witness ++ l, bc.proof),
        sym(ab.witness.append_assoc(bc.witness, c)))))
}

// A world whose every answer is one Linux may give.
fn Io::Answerable(self io: Io) → Type { (past: List<Exchange>) → (c: LinuxCmd<Nat>) → c.Answers(io.world(past, c)) }

// ---------------------------------------------------------------------------
// The machine with the world

// The machine's state and the world, as the meaning's configuration has
// it, is x86_64_stack_runs' `Running<M, Io>`: what the code has asked so
// far is `io.past`.

// Linux's model of the process at a site: its fetch and data, and the
// stack's writes (linux_x86_64_io's `LinuxIo`).
fn Site::linux<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data)) → LinuxIo<M> {
    LinuxIo(site.fetch, site.data, stack.writes.writable, stack.writes.store)
}

// The world's answer to `c`.
fn Io::answer(self io: Io, c: LinuxCmd<Nat>) → c.Resp() { io.world(io.past, c) }

// At `at` the code makes the system call `c` the Linux model reads off its
// registers and memory, with its buffers writable, and the world answers as
// Linux may.
fn Site::Asks<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), at: Running<M, Io>, c: LinuxCmd<Nat>) → Type {
    LinuxSyscallAt(site.linux(stack), at.state) ∧ (LinuxRequests(site.linux(stack), at.state, c) ∧ c.Answers(at.io.answer(c)))
}

// One step of the machine and the world: a step of the code (a fetched
// step, a store, a stack form), the world unchanged; or a system call the
// world answers, the process resumed as Linux may (whatever a failed call
// leaves and RCX and R11) and the exchange recorded.
fn Site::Step<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), before, after: Running<M, Io>) → Type {
    (MachineStep(site.fetch, site.data, stack.writes, before.state, after.state) ∧ (after.io = before.io)) ∨
        Exists<LinuxCmd<Nat>>(λ c => site.Asks(stack, before, c) ∧ ((after.io = before.io.exchanged(c, before.io.answer(c))) ∧
            Exists<List<BitVec(8)>>(λ junk => LinuxLeaves(c, before.io.answer(c), junk) ∧ Exists<BitVec(64)>(λ rcx => Exists<BitVec(64)>(λ r11 =>
                after.state = linux_answered(site.linux(stack), before.state, c, before.io.answer(c), junk, rcx, r11))))))
}

// Linux as the claims' kernel: at `r` the code makes a system call `c` the
// world answers, and from every state Linux may resume it in, the exchange
// recorded, `P` (`LinuxResumes`, as `RunsAs` reads it).
fn Site::linux_resumes<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), r: Running<M, Io>, P: Running<M, Io> → Type) → Type {
    Exists<LinuxCmd<Nat>>(λ c => site.Asks(stack, r, c) ∧
        LinuxResumes(site.linux(stack), r.state, c, r.io.answer(c), λ u => P(Running(u, r.io.exchanged(c, r.io.answer(c))))))
}

fn Site::linux_kernel<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data)) → Kernel<M, Io> {
    Kernel(λ r P => site.linux_resumes(stack, r, P),
        λ r P Q implies called => Exists(called.witness, ⟨called.proof.left, λ junk leaves rcx r11 =>
            implies(Running(linux_answered(site.linux(stack), r.state, called.witness, r.io.answer(called.witness), junk, rcx, r11),
                r.io.exchanged(called.witness, r.io.answer(called.witness))), called.proof.right(junk, leaves, rcx, r11))⟩))
}

// The code performs `goal` from a state, making at most `calls` system
// calls, its machine steps at least `least` in number: x86_64_stack_runs'
// claim at Linux.
fn Site::LinuxPerforms<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), goal: Running<M, Io> → Type, calls, least: Nat) →
    Running<M, Io> → Type {
    site.Performs(stack.writes, site.linux_kernel(stack), goal, calls, least)
}

// And with an escape `esc`, reached under no step bound
// (x86_64_stack_runs' `PerformsOr`).
fn Site::LinuxPerformsOr<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), goal, esc: Running<M, Io> → Type, calls, least: Nat) →
    Running<M, Io> → Type {
    site.PerformsOr(stack.writes, site.linux_kernel(stack), goal, esc, calls, least)
}

// ---------------------------------------------------------------------------
// Counting system calls by the world

// Each exchange is one more in the history.
theorem exchanged_len(io: Io, c: LinuxCmd<Nat>, a: c.Resp()): io.exchanged(c, a).past.len() = io.past.len() + 1 { refl }

// A claim at Linux whose goal fixes the world at `o` reaches it from a
// start whose history is no longer.
theorem Site::linux_performs_grows<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), goal: Running<M, Io> → Type, o: Io,
    pins: (t: Running<M, Io>) → goal(t) → t.io = o, calls: Nat):
    (least: Nat) → (from: Running<M, Io>) → site.LinuxPerforms(stack, goal, calls, least, from) → from.io.past.len() <= o.past.len() {
    match calls {
        Zero => λ least from p => j(pins(Running(p.witness, from.io),
            reach_goal<M, Io>(goal, least, p.proof.witness, Running(p.witness, from.io), p.proof.proof.right).right), λ w _ => from.io.past.len() <= w.past.len(),
            from.io.past.len().le_refl()),
        Succ(more) => λ least from p => match p.proof.proof.right {
            Inl(reach) => j(pins(Running(p.witness, from.io), reach_goal<M, Io>(goal, least, p.proof.witness, Running(p.witness, from.io), reach).right),
                λ w _ => from.io.past.len() <= w.past.len(), from.io.past.len().le_refl()),
            Inr(called) => {
                let c = called.witness;
                let a = from.io.answer(c);
                let zero = BitVec::zero(n := 64);
                let u = linux_answered(site.linux(stack), p.witness, c, a, Nil, zero, zero);
                let later = called.proof.right(Nil, linux_leaves_nil(c, a), zero, zero);
                let grown = site.linux_performs_grows(stack, goal, o, pins, more, least - p.proof.witness, Running(u, from.io.exchanged(c, a)), later);
                let e = exchanged_len(from.io, c, a);
                { omega }
            },
        },
    }
}

// And makes exactly as many system calls as `o` has exchanges past the
// start: each records one. So a count proved any way can be read off the
// worlds (a loop's passes, whose number is the run's, need it).
theorem Site::linux_performs_exact<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), goal: Running<M, Io> → Type, o: Io,
    pins: (t: Running<M, Io>) → goal(t) → t.io = o, calls: Nat):
    (least: Nat) → (from: Running<M, Io>) → (k: Nat) → o.past.len() = k + from.io.past.len() → site.LinuxPerforms(stack, goal, calls, least, from) →
    site.LinuxPerforms(stack, goal, k, least, from) {
    match calls {
        Zero => λ least from k e p => {
            let same: (from.io = o) = pins(Running(p.witness, from.io),
                reach_goal<M, Io>(goal, least, p.proof.witness, Running(p.witness, from.io), p.proof.proof.right).right);
            let lens: (from.io.past.len() = o.past.len()) = cong_fn<Io, Nat>(λ w => w.past.len(), same);
            (match k as λ k2 => o.past.len() = k2 + from.io.past.len() → site.LinuxPerforms(stack, goal, k2, least, from) {
                Zero => λ _ => p,
                Succ(k2) => λ e2 => false_elim({ omega }),
            })(e)
        },
        Succ(more) => λ least from k e p => {
            let t = p.witness;
            let n = p.proof.witness;
            match p.proof.proof.right {
                Inl(reached) => {
                    let same: (from.io = o) = pins(Running(t, from.io), reach_goal<M, Io>(goal, least, n, Running(t, from.io), reached).right);
                    let lens: (from.io.past.len() = o.past.len()) = cong_fn<Io, Nat>(λ w => w.past.len(), same);
                    (match k as λ k2 => o.past.len() = k2 + from.io.past.len() → site.LinuxPerforms(stack, goal, k2, least, from) {
                        Zero => λ _ => Exists(t, Exists(n, ⟨p.proof.proof.left, reached⟩)),
                        Succ(k2) => λ e2 => false_elim({ omega }),
                    })(e)
                },
                Inr(called) => {
                    let c = called.witness;
                    let a = from.io.answer(c);
                    let after = from.io.exchanged(c, a);
                    let grown_len = exchanged_len(from.io, c, a);
                    (match k as λ k2 => o.past.len() = k2 + from.io.past.len() → site.LinuxPerforms(stack, goal, k2, least, from) {
                        Zero => λ e2 => {
                            let zero = BitVec::zero(n := 64);
                            let grown = site.linux_performs_grows(stack, goal, o, pins, more, least - n,
                                Running(linux_answered(site.linux(stack), t, c, a, Nil, zero, zero), after),
                                called.proof.right(Nil, linux_leaves_nil(c, a), zero, zero));
                            false_elim({ omega })
                        },
                        Succ(k2) => λ e2 => Exists(t, Exists(n, ⟨p.proof.proof.left, Inr(Exists(c, ⟨called.proof.left, λ junk leaves rcx r11 =>
                            site.linux_performs_exact(stack, goal, o, pins, more, least - n,
                                Running(linux_answered(site.linux(stack), t, c, a, junk, rcx, r11), after), k2, { omega },
                                called.proof.right(junk, leaves, rcx, r11))⟩))⟩)),
                    })(e)
                },
            }
        },
    }
}

// ---------------------------------------------------------------------------
// The contract (docs/language/ownership-design.md §17.7, §17.9, §17.10)

// The reserved status of the out-of-room stop, and the register a program
// that guards its calls keeps the stack's floor in: RBP, the last a
// placement saves, so a program with no guard places as it would without
// it (this layer's choice: the machine model has no load a data word could
// use, §17.10).
fn spent_status() → Nat { 139 }

fn floor_register() → Gpr { Rbp }

// Routine `f` entered at stack offset `i`, as every clause takes it, under
// one lending for the whole run: the stack and the spans lent under the
// lending laws (`Loan`) and the meaning's own law of what it may write
// against them (`lent`: the bytes level's `blocks.Lent(spans)`); at its
// label, the program resident, the stack pointer at `i` with room for the
// return address `ret` there, the arguments passed as words, the lending's
// words above (`top`), the heap injected, and, where the code reads a
// floor (`floored`), the floor register holding the stack's lowest
// address. What the clause asks of room is the clause's.
fn Site::Entering<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, floored: Bool, bound: Nat,
    clause: Nat → List<Value> → Heap → Io → MachineState<M> → Nat → BitVec(64) → Type) → Type {
    Loan<M>(site.fetch, site.data, stack, top, spans) → lent →
    (f: Nat) → f + 1 <= bound → (args: List<Value>) → (heap: Heap) → (io: Io) →
    (s: MachineState<M>) → s.rip = next_rip(site.origin, asm_labels(site.program)(f + 1)) → site.Resident(s.memory) →
    (i: Nat) → read_gpr(Rsp, s.gprs) = stack.at(i) → i + 8 <= stack.size →
    stack.Passed(lower_values(spans, args), i, s) → i + 8 <= top → Injected<M>(site.data, spans, heap, s.memory) →
    (ret: BitVec(64)) → read_word(site.data, s.memory, stack.at(i)) = Some(ret) →
    (floored.IsTrue() → read_gpr(floor_register(), s.gprs) = stack.low) → clause(f, args, heap, io, s, i, ret)
}

// Returned with `a`: at the return address, the program resident, the stack
// pointer just above it, the answer's words lowered in RAX and
// `answer_registers()`, the callee-saved registers kept, its stores inside
// the lending, the answer's heap injected, and the answer's world.
fn Site::Returned<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat, ret: BitVec(64),
    a: Answer, r: Running<M, Io>) → Type {
    ((r.state.rip = ret) ∧ (site.Resident(r.state.memory) ∧ (read_gpr(Rsp, r.state.gprs) = stack.at(i + 8)))) ∧
    ((ArgsIn(lower_values(spans, a.words), Cons(Rax, answer_registers()), r.state.gprs) ∧ Kept(callee_kept(), s.gprs, r.state.gprs)) ∧
        ((stack.WroteIn(i, spans, s.memory, r.state.memory) ∧ Injected<M>(site.data, spans, a.heap, r.state.memory)) ∧ (r.io = a.io)))
}

// The state the code performs at a fuel, read off the meaning's outcome
// there: done, returned with the answer; exited, at the exit call with its
// status in its world; going, a state in the world so far; stuck, nothing.
fn Site::Reached<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat, ret: BitVec(64),
    outcome: Ran<Answer>) → Running<M, Io> → Type {
    match outcome {
        Done(a) => λ r => site.Returned(stack, spans, s, i, ret, a, r),
        Exited(status, o) => λ r => (LinuxSyscallAt(site.linux(stack), r.state) ∧ LinuxExits(r.state, status)) ∧ (r.io = o),
        Going(o) => λ r => r.io = o,
        Stuck(_) => λ r => True,
    }
}

// The machine steps the code has taken by then: going at fuel `n`, the
// chain of turns and calls the fuel paid for, less one, because the first
// counted step is the caller's `CALL`, before `Site::Entering`'s state (a
// body at fuel `m` gives at least `m`); otherwise none counted. The
// predecessor is deliberate: the meaning's fuel is not shifted to match.
fn going_least(n: Nat, outcome: Ran<Answer>) → Nat {
    match outcome { Done(_) => 0, Exited(_, _) => 0, Going(_) => n - 1, Stuck(_) => 0 }
}

// From the entry, the code performs the state read off `outcome`, its
// steps counted as `going_least` asks, or reaches the escape `esc`.
fn Site::Tracked<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat, ret: BitVec(64), io: Io,
    n: Nat, outcome: Ran<Answer>, esc: Running<M, Io> → Type) → Type {
    Exists<Nat>(λ calls => site.LinuxPerformsOr(stack, site.Reached(stack, spans, s, i, ret, outcome), esc, calls, going_least(n, outcome),
        Running(s, io)))
}

// A world's history is a prefix of one the meaning reaches at some fuel,
// or the meaning gets stuck at some fuel.
fn MeaningPrefix(meaning: Nat → Calls(), f: Nat, args: List<Value>, heap: Heap, io: Io, past: List<Exchange>) → Type {
    Exists<Nat>(λ m => Exists<List<Exchange>>(λ h => (history(meaning(m, f, args, heap, io)) = Some(h)) ∧ Extends(h, past))) ∨
        Exists<Nat>(λ m => Exists<Io>(λ o => meaning(m, f, args, heap, io) = Stuck(o)))
}

theorem meaning_prefix_extends(meaning: Nat → Calls(), f: Nat, args: List<Value>, heap: Heap, io: Io, later, earlier: List<Exchange>,
    prefix: MeaningPrefix(meaning, f, args, heap, io, later), grown: Extends(later, earlier)): MeaningPrefix(meaning, f, args, heap, io, earlier) {
    match prefix {
        Inl(seen) => Inl(Exists(seen.witness, Exists(seen.proof.witness, ⟨seen.proof.proof.left,
            extends_trans(seen.proof.witness, later, earlier, seen.proof.proof.right, grown)⟩))),
        Inr(stuck) => Inr(stuck),
    }
}

// Spent at `r` (§17.9): at the exit call with the reserved status, in a
// world whose history is a prefix of one the meaning reaches
// (`MeaningPrefix`): a run out of room, like one out of fuel, did a prefix
// of what the meaning does and nothing else.
fn Site::SpentAt<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), meaning: Nat → Calls(), f: Nat, args: List<Value>, heap: Heap,
    io: Io) → Running<M, Io> → Type {
    λ r => (LinuxSyscallAt(site.linux(stack), r.state) ∧ LinuxExits(r.state, BitVec::ofNat(spent_status()))) ∧
        MeaningPrefix(meaning, f, args, heap, io, r.io.past)
}

// The escape `Tracks` admits at fuel `n`: the run's deepest chain of calls
// there (`peak`, the meaning's own) has not its room by depth (`room`), and
// the code is spent.
fn Site::OutOfRoom<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), room: Nat → Nat → Nat,
    peak: Nat → Nat → List<Value> → Heap → Io → Nat, meaning: Nat → Calls(), f: Nat, args: List<Value>, heap: Heap, io: Io, i, n: Nat) →
    Running<M, Io> → Type {
    λ r => ¬(room(f, peak(n, f, args, heap, io)) <= i) ∧ site.SpentAt(stack, meaning, f, args, heap, io, r)
}

// The one clause a lowering proves: entered with its room by routine
// (`rooms(f) <= i`, a table by routine alone), at every fuel, in a world
// whose every answer is one Linux may give, from the entry, the code
// performs the state read off the meaning there, or escapes out of room
// (`OutOfRoom`). The escape sits inside the claim: which end a run comes to
// can rest on how Linux resumes it, and the stop can come after fewer
// counted steps than the fuel's.
fn Site::Tracks<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls()) → Type {
    site.Entering(stack, spans, top, lent, floored, bound, λ f args heap io s i ret => rooms(f) <= i → (n: Nat) → io.Answerable() →
        site.Tracked(stack, spans, s, i, ret, io, n, meaning(n, f, args, heap, io), site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n)))
}

// `Tracks` read under the room by depth: there the code tracks the meaning,
// with no escape.
fn Site::TracksAt<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, floored: Bool,
    room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls()) → Type {
    site.Entering(stack, spans, top, lent, floored, bound, λ f args heap io s i ret => (n: Nat) → room(f, peak(n, f, args, heap, io)) <= i →
        io.Answerable() → site.Tracked(stack, spans, s, i, ret, io, n, meaning(n, f, args, heap, io), λ (_: Running<M, Io>) => False))
}

// At every table by depth at least the table by routine, the escape is
// closed there.
theorem Site::tracks_at<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type,
    rooms: Nat → Nat, floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls(),
    over: (f: Nat) → (p: Nat) → rooms(f) <= room(f, p),
    tracks: site.Tracks(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning)):
    site.TracksAt(stack, spans, top, lent, floored, room, peak, bound, meaning) {
    λ loan law f below args heap io s here resident i rsp inside passed high injected ret saved floor n roomy answerable => {
        let q = peak(n, f, args, heap, io);
        let least: (rooms(f) <= i) = Nat::le_trans(rooms(f), room(f, q), i, over(f, q), roomy);
        let outcome = meaning(n, f, args, heap, io);
        let tracked = tracks(loan, law, f, below, args, heap, io, s, here, resident, i, rsp, inside, passed, high, injected, ret, saved, floor, least,
            n, answerable);
        Exists(tracked.witness, site.performs_or_weaken(stack.writes, site.linux_kernel(stack), site.Reached(stack, spans, s, i, ret, outcome),
            site.Reached(stack, spans, s, i, ret, outcome), site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n),
            λ (_: Running<M, Io>) => False, λ r g => g, λ r out => out.left(roomy), tracked.witness, going_least(n, outcome), Running(s, io),
            tracked.proof))
    }
}

// Done: `Tracks` read where the meaning is done.
fn Site::MeetsDone<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls()) → Type {
    site.Entering(stack, spans, top, lent, floored, bound, λ f args heap io s i ret => rooms(f) <= i → (n: Nat) → io.Answerable() → (a: Answer) →
        meaning(n, f, args, heap, io) = Done(a) →
        site.Tracked(stack, spans, s, i, ret, io, n, Done(a), site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n)))
}

// Exited: `Tracks` read where the meaning exits.
fn Site::MeetsExited<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls()) → Type {
    site.Entering(stack, spans, top, lent, floored, bound, λ f args heap io s i ret => rooms(f) <= i → (n: Nat) → io.Answerable() →
        (status: BitVec(64)) → (o: Io) → meaning(n, f, args, heap, io) = Exited(status, o) →
        site.Tracked(stack, spans, s, i, ret, io, n, Exited(status, o), site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n)))
}

theorem Site::tracks_done<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls(),
    tracks: site.Tracks(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning)):
    site.MeetsDone(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning) {
    λ loan law f below args heap io s here resident i rsp inside passed high injected ret saved floor roomy n answerable a ran =>
        j(ran, λ x _ => site.Tracked(stack, spans, s, i, ret, io, n, x, site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n)),
            tracks(loan, law, f, below, args, heap, io, s, here, resident, i, rsp, inside, passed, high, injected, ret, saved, floor, roomy, n, answerable))
}

theorem Site::tracks_exited<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls(),
    tracks: site.Tracks(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning)):
    site.MeetsExited(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning) {
    λ loan law f below args heap io s here resident i rsp inside passed high injected ret saved floor roomy n answerable status o ran =>
        j(ran, λ x _ => site.Tracked(stack, spans, s, i, ret, io, n, x, site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n)),
            tracks(loan, law, f, below, args, heap, io, s, here, resident, i, rsp, inside, passed, high, injected, ret, saved, floor, roomy, n, answerable))
}

// The code has not yet returned to `ret`.
fn Site::Before<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), r: Running<M, Io>) → Type {
    ¬((r.state.rip = ret) ∧ (read_gpr(Rsp, r.state.gprs) = stack.at(i + 8)))
}

// Going: every world the code reaches in `j` steps before it returns or
// exits is a prefix of a history the meaning reaches, or the meaning gets
// stuck at some fuel. Room or none: a run out of room stopped spent, at a
// prefix too. (An exit resumes nothing, so no step leaves it.)
fn Site::MeetsGoing<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, bound: Nat, meaning: Nat → Calls()) → Type {
    site.Entering(stack, spans, top, lent, floored, bound, λ f args heap io s i ret => rooms(f) <= i → io.Answerable() → (j: Nat) →
        (r: Running<M, Io>) → StarN(λ (a: Running<M, Io>) (b: Running<M, Io>) => site.Before(stack, i, ret, a) ∧ site.Step(stack, a, b), j, Running(s, io), r) →
        MeaningPrefix(meaning, f, args, heap, io, r.io.past))
}

// The contract, over one lending for the whole run, for every routine
// below `bound` and every fuel: done, exited, going. That the code left
// alone what it was not lent is not said here: the injection after the call
// pins every byte of every block, so it is a fact about the answer's heap.
fn Site::Meets<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls()) → Type {
    site.MeetsDone(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning) ∧
        (site.MeetsExited(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning) ∧
            site.MeetsGoing(stack, spans, top, lent, rooms, floored, bound, meaning))
}

// ---------------------------------------------------------------------------
// The kernel's writes, from the loan (§17.7)
//
// What a claim's end conclusions need across a system call: the code stays
// resident through the kernel's store of a read into a lent window, and the
// process resumes past the SYSCALL. Not a law of the memory clause: a
// system call's region re-establishes its own clause.

// The window a call stores into: a read's, inside a written span at RSI;
// a write's, none. Nothing else is asked yet.
fn Spans::Window<M>(self spans: Spans, at: MachineState<M>, c: LinuxCmd<Nat>) → Type {
    match c {
        ReadCmd(_, max) => Exists<Nat>(λ b => Exists<Nat>(λ k => (spans.written(b) = True) ∧ ((k < spans.size(b)) ∧ ((k + max <= spans.size(b)) ∧
            (read_gpr(Rsi, at.gprs) = spans.byte(b, k)))))),
        WriteCmd(_, _) => True,
        OpenCmd(_) => False,
        CloseCmd(_) => False,
        StatCmd(_) => False,
    }
}

// Bytes the kernel stores into a lent window, no more than it holds, keep
// the code resident.
theorem Site::window_keeps_code<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), memory: M, b, k, max: Nat, written: spans.written(b) = True, inside: k < spans.size(b),
    fits: k + max <= spans.size(b), bytes: List<BitVec(8)>, few: bytes.len() <= max, resident: site.Resident(memory)):
    site.Resident(stack.writes.store(memory, spans.byte(b, k), bytes)) {
    loan.keeps_code(memory, b, k, written, inside, bytes, { omega }, assemble(no_fills(), site.program, site.last), next_rip(site.origin, 0), resident)
}

// Every resumption of a call into its window: past the SYSCALL, the code
// still resident.
theorem Site::resumes_resident<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, spans: Spans,
    loan: Loan<M>(site.fetch, site.data, stack, top, spans), at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(), answers: c.Answers(a),
    window: spans.Window(at, c), resident: site.Resident(at.memory)):
    LinuxResumes(site.linux(stack), at, c, a, λ u => (u.rip = next_rip(at.rip, 2)) ∧ site.Resident(u.memory)) {
    (match c as λ c0 => (a0: c0.Resp()) → c0.Answers(a0) → spans.Window(at, c0) →
        LinuxResumes(site.linux(stack), at, c0, a0, λ u => (u.rip = next_rip(at.rip, 2)) ∧ site.Resident(u.memory)) {
        ReadCmd(fd, max) => λ r answered win junk leaves rcx r11 => {
            let b = win.witness;
            let k = win.proof.witness;
            let w = win.proof.proof;
            let stored = λ (bytes: List<BitVec(8)>) (few: bytes.len() <= max) =>
                j(sym(w.right.right.right), λ address _ => site.Resident(stack.writes.store(at.memory, address, bytes)),
                    site.window_keeps_code(stack, top, spans, loan, at.memory, b, k, max, w.left, w.right.left, w.right.right.left, bytes, few, resident));
            (match r as λ r0 => (ReadCmd(fd, max)).Answers(r0) → LinuxLeaves(ReadCmd(fd, max), r0, junk) →
                (linux_answered(site.linux(stack), at, ReadCmd(fd, max), r0, junk, rcx, r11).rip = next_rip(at.rip, 2)) ∧
                site.Resident(linux_answered(site.linux(stack), at, ReadCmd(fd, max), r0, junk, rcx, r11).memory) {
                ReadBytes(bytes) => λ few _ => ⟨refl, stored(bytes, few)⟩,
                ReadFailed(errno) => λ _ few => ⟨refl, stored(junk, few)⟩,
            })(answered, leaves)
        },
        WriteCmd(fd, bytes) => λ r answered win junk leaves rcx r11 => match r {
            Wrote(count) => ⟨refl, resident⟩,
            WriteFailed(errno) => ⟨refl, resident⟩,
        },
        OpenCmd(_) => λ r answered never => false_elim(never),
        CloseCmd(_) => λ r answered never => false_elim(never),
        StatCmd(_) => λ r answered never => false_elim(never),
    })(a, answers, window)
}

// ---------------------------------------------------------------------------
// The going clause from `Tracks`, once (§17.7)
//
// A state the code reaches in `j` steps lies, on its own branch of
// resumptions, at or before the state `Tracks` performs at fuel `j + 1`:
// going there, the claim's machine steps number at least `j`; done, the
// returned state is not before the return; exited, no step leaves an exit.
// Between system calls the machine is a function of the state's defined
// components (`step_respects_defined`, `syscall_excludes_step`), at a system
// call the request is (`asks_meet`) and so is each resumption
// (`linux_answered_respects`), and the world only grows along a branch.

// A step of the code before it returns to `ret`.
fn Site::Onward<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64)) → Running<M, Io> → Running<M, Io> → Type {
    λ a b => site.Before(stack, i, ret, a) ∧ site.Step(stack, a, b)
}

// Machine steps from a state alike to where a path of the code starts: the
// path either ends within them, the world unchanged, or passes a state
// alike to where they end, from which it has a step still to take.
theorem Site::steps_meet<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), n: Nat):
    (k: Nat) → (x, t: MachineState<M>) → (start, r: Running<M, Io>) → x ≈ start.state →
    MachineRuns(site.fetch, site.data, stack.writes, n, x, t) → StarN(site.Onward(stack, i, ret), k, start, r) →
    ((k <= n) ∧ (r.io = start.io)) ∨ Exists<Running<M, Io>>(λ mid => Exists<Nat>(λ k2 => (k = n + (k2 + 1)) ∧
        ((mid.state ≈ t) ∧ ((mid.io = start.io) ∧ StarN(site.Onward(stack, i, ret), k2 + 1, mid, r))))) {
    match n {
        Zero => λ k x t start r same run path => match k {
            Zero => Inl(⟨trivial, cong_fn<Running<M, Io>, Io>(λ y => y.io, sym(path))⟩),
            Succ(k2) => Inr(Exists(start, Exists(k2, ⟨{ omega }, ⟨j(run, λ y _ => start.state ≈ y, sym(same)), ⟨refl, path⟩⟩⟩))),
        },
        Succ(n2) => λ k x t start r same run path => match k {
            Zero => Inl(⟨trivial, cong_fn<Running<M, Io>, Io>(λ y => y.io, sym(path))⟩),
            Succ(k1) => {
                let x1 = run.witness;
                let r1 = path.witness;
                let onward = path.proof.left;
                match onward.right {
                    Inl(machine) => {
                        let same1: (x1 ≈ r1.state) = step_respects_defined(site.fetch, site.data, stack.writes, x, start.state, x1, r1.state, same,
                            run.proof.left, machine.left);
                        match site.steps_meet(stack, i, ret, n2, k1, x1, t, r1, r, same1, run.proof.right, path.proof.right) {
                            Inl(within) => Inl(⟨within.left, trans(within.right, machine.right)⟩),
                            Inr(passed) => Inr(Exists(passed.witness, Exists(passed.proof.witness, ⟨{ let e = passed.proof.proof.left; omega },
                                ⟨passed.proof.proof.right.left, ⟨trans(passed.proof.proof.right.right.left, machine.right), passed.proof.proof.right.right.right⟩⟩⟩))),
                        }
                    },
                    Inr(called) => false_elim(syscall_excludes_step(site.fetch, site.data, stack.writes, start.state, x, x1, sym(same),
                        called.proof.left.left, run.proof.left)),
                }
            },
        },
    }
}

// Linux leaves nothing besides an answer, always allowed.
theorem leaves_nothing(c: LinuxCmd<Nat>): (a: c.Resp()) → LinuxLeaves(c, a, []) {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) => match r { ReadBytes(_) => refl, ReadFailed(_) => trivial },
        WriteCmd(_, _) => λ _ => refl,
        OpenCmd(_) => λ _ => refl,
        CloseCmd(_) => λ _ => refl,
        StatCmd(_) => λ (r: StatResult) => match r { Stated(_) => refl, StatFailed(_) => trivial },
    }
}

// A goal state the path's end is at or before, on its branch: its world a
// prefix of that state's.
fn Ahead<M>(goal: Running<M, Io> → Type, r: Running<M, Io>) → Type { Exists<Running<M, Io>>(λ g => goal(g) ∧ Extends(g.io.past, r.io.past)) }

// A goal state the path passes before its end: alike to a state from which
// it has a step still to take.
fn Site::Passes<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal: Running<M, Io> → Type,
    r: Running<M, Io>) → Type {
    Exists<Running<M, Io>>(λ g => Exists<Running<M, Io>>(λ mid => Exists<Nat>(λ k2 => goal(g) ∧
        ((g.state ≈ mid.state) ∧ StarN(site.Onward(stack, i, ret), k2 + 1, mid, r)))))
}

// Where a path of `k` steps meets a claim's goal under the lower bound
// `least`: ahead of it, or past it after more steps than the bound.
fn Site::Meet<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal: Running<M, Io> → Type, least, k: Nat,
    r: Running<M, Io>) → Type {
    Ahead(goal, r) ∨ ((least < k) ∧ site.Passes(stack, i, ret, goal, r))
}

// Ahead of a state, ahead of every state whose history it extends.
theorem ahead_extends<M>(goal: Running<M, Io> → Type, r, r2: Running<M, Io>, ahead: Ahead(goal, r), grown: Extends(r.io.past, r2.io.past)):
    Ahead(goal, r2) {
    Exists(ahead.witness, ⟨ahead.proof.left, extends_trans(ahead.witness.io.past, r.io.past, r2.io.past, ahead.proof.right, grown)⟩)
}

// A goal or escape reached where a claim stops is ahead of where it
// stopped.
theorem reach_ahead<M>(goal, esc: Running<M, Io> → Type, least, n: Nat, t: Running<M, Io>, reach: ((least <= n) ∧ goal(t)) ∨ esc(t)):
    Ahead(goal, t) ∨ Ahead(esc, t) {
    match reach {
        Inl(reached) => Inl(Exists(t, ⟨reached.right, extends_refl(t.io.past)⟩)),
        Inr(escaped) => Inr(Exists(t, ⟨escaped, extends_refl(t.io.past)⟩)),
    }
}

// A claim at Linux reaches its goal or its escape on some branch, in a
// world that extends the one it started in.
theorem Site::performs_or_reaches<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), goal, esc: Running<M, Io> → Type, calls: Nat):
    (least: Nat) → (x: Running<M, Io>) → site.LinuxPerformsOr(stack, goal, esc, calls, least, x) → Ahead(goal, x) ∨ Ahead(esc, x) {
    match calls {
        Zero => λ least x p => reach_ahead<M>(goal, esc, least, p.proof.witness, Running<M, Io>(p.witness, x.io), p.proof.proof.right),
        Succ(more) => λ least x p => match p.proof.proof.right {
            Inl(reach) => reach_ahead<M>(goal, esc, least, p.proof.witness, Running<M, Io>(p.witness, x.io), reach),
            Inr(called) => {
                let c = called.witness;
                let a = x.io.answer(c);
                let next = Running<M, Io>(linux_answered(site.linux(stack), p.witness, c, a, [], BitVec::zero(), BitVec::zero()), x.io.exchanged(c, a));
                let grown: Extends(next.io.past, x.io.past) = Exists([Exchange(c, a)], refl);
                match site.performs_or_reaches(stack, goal, esc, more, least - p.proof.witness,
                    Running<M, Io>(linux_answered(site.linux(stack), p.witness, c, a, [], BitVec::zero(), BitVec::zero()), x.io.exchanged(c, a)),
                    called.proof.right([], leaves_nothing(c, a), BitVec::zero(), BitVec::zero())) {
                    Inl(ahead) => Inl(ahead_extends<M>(goal, next, x, ahead, grown)),
                    Inr(ahead) => Inr(ahead_extends<M>(esc, next, x, ahead, grown)),
                }
            },
        },
    }
}

// Machine steps to a goal state, from a state alike to a path's start.
theorem Site::goal_meets<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal: Running<M, Io> → Type,
    least, k, n: Nat, x, start, r: Running<M, Io>, t: MachineState<M>, same: x.state ≈ start.state, world: x.io = start.io,
    run: MachineRuns(site.fetch, site.data, stack.writes, n, x.state, t), low: least <= n, path: StarN(site.Onward(stack, i, ret), k, start, r),
    at: goal(Running<M, Io>(t, x.io))): site.Meet(stack, i, ret, goal, least, k, r) {
    match site.steps_meet(stack, i, ret, n, k, x.state, t, start, r, same, run, path) {
        Inl(within) => Inl(Exists(Running<M, Io>(t, x.io), ⟨at, j(trans(world, sym(within.right)), λ w _ => Extends(x.io.past, w.past),
            extends_refl(x.io.past))⟩)),
        Inr(passed) => {
            let k2 = passed.proof.witness;
            let e: (k = n + (k2 + 1)) = passed.proof.proof.left;
            Inr(⟨{ omega }, Exists(Running<M, Io>(t, x.io), Exists(passed.witness, Exists(k2, ⟨at,
                ⟨sym(passed.proof.proof.right.left), passed.proof.proof.right.right.right⟩⟩)))⟩)
        },
    }
}

// A meet seen from `n` steps later: the bound and the path both longer.
theorem Site::meet_later<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal: Running<M, Io> → Type,
    least, n, k, k2: Nat, r: Running<M, Io>, e: k = n + (k2 + 1), meet: site.Meet(stack, i, ret, goal, least - n, k2, r)):
    site.Meet(stack, i, ret, goal, least, k, r) {
    match meet {
        Inl(ahead) => Inl(ahead),
        Inr(past) => { let lt: (least - n < k2) = past.left; Inr(⟨{ omega }, past.right⟩) },
    }
}

// Where a claim stops, reached, meets the path from a state alike to its
// start: the goal under its bound, the escape under none.
theorem Site::reach_meets<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal, esc: Running<M, Io> → Type,
    least, k, n: Nat, x, start, r: Running<M, Io>, t: MachineState<M>, same: x.state ≈ start.state, world: x.io = start.io,
    run: MachineRuns(site.fetch, site.data, stack.writes, n, x.state, t), path: StarN(site.Onward(stack, i, ret), k, start, r),
    reach: ((least <= n) ∧ goal(Running<M, Io>(t, x.io))) ∨ esc(Running<M, Io>(t, x.io))):
    site.Meet(stack, i, ret, goal, least, k, r) ∨ site.Meet(stack, i, ret, esc, 0, k, r) {
    match reach {
        Inl(reached) => Inl(site.goal_meets(stack, i, ret, goal, least, k, n, x, start, r, t, same, world, run, reached.left, path, reached.right)),
        Inr(escaped) => Inr(site.goal_meets(stack, i, ret, esc, 0, k, n, x, start, r, t, same, world, run, trivial, path, escaped)),
    }
}

// A claim at Linux from a state alike to where a path of the code starts:
// the path meets the goal (`Meet`, under the claim's bound) or the escape
// (under none).
theorem Site::performs_or_meet<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), goal, esc: Running<M, Io> → Type,
    calls: Nat): (least, k: Nat) → (x, start, r: Running<M, Io>) → x.state ≈ start.state → x.io = start.io →
    site.LinuxPerformsOr(stack, goal, esc, calls, least, x) → StarN(site.Onward(stack, i, ret), k, start, r) →
    site.Meet(stack, i, ret, goal, least, k, r) ∨ site.Meet(stack, i, ret, esc, 0, k, r) {
    match calls {
        Zero => λ least k x start r same world p path =>
            site.reach_meets(stack, i, ret, goal, esc, least, k, p.proof.witness, x, start, r, p.witness, same, world, p.proof.proof.left, path,
                p.proof.proof.right),
        Succ(more) => λ least k x start r same world p path => {
            let t = p.witness;
            let n = p.proof.witness;
            match p.proof.proof.right {
                Inl(reach) => site.reach_meets(stack, i, ret, goal, esc, least, k, n, x, start, r, t, same, world, p.proof.proof.left, path, reach),
                Inr(called) => {
                    let c = called.witness;
                    let asks = called.proof.left;
                    match site.steps_meet(stack, i, ret, n, k, x.state, t, start, r, same, p.proof.proof.left, path) {
                        Inl(within) => {
                            let same_world: (x.io = r.io) = trans(world, sym(within.right));
                            let grown: Extends(x.io.past, r.io.past) = j(same_world, λ w _ => Extends(x.io.past, w.past), extends_refl(x.io.past));
                            match site.performs_or_reaches(stack, goal, esc, Succ(more), least, x, p) {
                                Inl(ahead) => Inl(Inl(ahead_extends<M>(goal, x, r, ahead, grown))),
                                Inr(ahead) => Inr(Inl(ahead_extends<M>(esc, x, r, ahead, grown))),
                            }
                        },
                        Inr(passed) => {
                            let mid = passed.witness;
                            let k2 = passed.proof.witness;
                            let e: (k = n + (k2 + 1)) = passed.proof.proof.left;
                            let mid_t: (mid.state ≈ t) = passed.proof.proof.right.left;
                            let mid_io: (mid.io = x.io) = trans(passed.proof.proof.right.right.left, sym(world));
                            let onward = passed.proof.proof.right.right.right;
                            let r1 = onward.witness;
                            match onward.proof.left.right {
                                Inl(machine) => false_elim(syscall_excludes_step(site.fetch, site.data, stack.writes, t, mid.state, r1.state,
                                    sym(mid_t), asks.left, machine.left)),
                                Inr(stepped) => {
                                    let c2 = stepped.witness;
                                    let same_c: (c2 = c) = asks_meet(site.linux(stack), mid.state, t, mid_t, c2, c, stepped.proof.left.right.left.left,
                                        asks.right.left.left);
                                    let resumed = stepped.proof.right.right;
                                    let junk = resumed.witness;
                                    let rcx = resumed.proof.right.witness;
                                    let r11 = resumed.proof.right.proof.witness;
                                    let landed: (r1.state = linux_answered(site.linux(stack), mid.state, c2, mid.io.answer(c2), junk, rcx, r11)) =
                                        resumed.proof.right.proof.proof;
                                    let leaves: LinuxLeaves(c2, mid.io.answer(c2), junk) = resumed.proof.left;
                                    // The request and the answer are the claim's.
                                    let Here = λ (d: LinuxCmd<Nat>) => (r1.state = linux_answered(site.linux(stack), mid.state, d, x.io.answer(d), junk, rcx, r11)) ∧
                                        ((r1.io = x.io.exchanged(d, x.io.answer(d))) ∧ LinuxLeaves(d, x.io.answer(d), junk));
                                    let here: Here(c) = j(same_c, λ d _ => Here(d), j(mid_io, λ w _ =>
                                        (r1.state = linux_answered(site.linux(stack), mid.state, c2, w.answer(c2), junk, rcx, r11)) ∧
                                        ((r1.io = w.exchanged(c2, w.answer(c2))) ∧ LinuxLeaves(c2, w.answer(c2), junk)),
                                        ⟨landed, ⟨stepped.proof.right.left, leaves⟩⟩));
                                    let u = linux_answered(site.linux(stack), t, c, x.io.answer(c), junk, rcx, r11);
                                    let alike: (u ≈ r1.state) = j(sym(here.left), λ y _ => u ≈ y,
                                        linux_answered_respects<M>(site.linux(stack), c, x.io.answer(c), junk, rcx, r11, t, mid.state,
                                            sym(mid_t)));
                                    let zero: (0 - n = 0) = { omega };
                                    match site.performs_or_meet(stack, i, ret, goal, esc, more, least - n, k2, Running<M, Io>(u, x.io.exchanged(c, x.io.answer(c))),
                                        r1, r, alike, sym(here.right.left), called.proof.right(junk, here.right.right, rcx, r11), onward.proof.right) {
                                        Inl(met) => Inl(site.meet_later(stack, i, ret, goal, least, n, k, k2, r, e, met)),
                                        Inr(met) => Inr(site.meet_later(stack, i, ret, esc, 0, n, k, k2, r, e,
                                            j(sym(zero), λ b _ => site.Meet(stack, i, ret, esc, b, k2, r), met))),
                                    }
                                },
                            }
                        },
                    }
                },
            }
        },
    }
}

// No step leaves an exit: a path does not pass one.
theorem Site::exit_not_passed<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), i: Nat, ret: BitVec(64), g, mid, r: Running<M, Io>,
    k2: Nat, status: BitVec(64), exit_at: LinuxSyscallAt(site.linux(stack), g.state) ∧ LinuxExits(g.state, status), same: g.state ≈ mid.state,
    path: StarN(site.Onward(stack, i, ret), k2 + 1, mid, r)): False {
    let r1 = path.witness;
    match path.proof.left.right {
        Inl(machine) => syscall_excludes_step(site.fetch, site.data, stack.writes, g.state, mid.state, r1.state, same, exit_at.left, machine.left),
        Inr(stepped) => exits_not_asks(site.linux(stack), g.state, mid.state, same, status, stepped.witness, exit_at.right,
            stepped.proof.left.right.left.left),
    }
}

// A goal passed before the path's end: not a return (the path's next step
// is before it), and not an exit.
theorem Site::passed_not_reached<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat,
    ret: BitVec(64), outcome: Ran<Answer>, g, mid, r: Running<M, Io>, k2: Nat, at: site.Reached(stack, spans, s, i, ret, outcome, g),
    same: g.state ≈ mid.state, path: StarN(site.Onward(stack, i, ret), k2 + 1, mid, r)):
    (Exists<Answer>(λ a => outcome = Done(a)) ∨ Exists<BitVec(64)>(λ status => Exists<Io>(λ o => outcome = Exited(status, o)))) → False {
    λ which => match which {
        Inl(done) => {
            let returned: site.Returned(stack, spans, s, i, ret, done.witness, g) = j(done.proof, λ x _ => site.Reached(stack, spans, s, i, ret, x, g), at);
            path.proof.left.left(⟨trans(sym(SameDefinedState::rip(same)), returned.left.left),
                trans(cong_fn<Gprs, BitVec(64)>(λ h => read_gpr(Rsp, h), sym(SameDefinedState::gprs(same))), returned.left.right.right)⟩)
        },
        Inr(exited) => {
            let status = exited.witness;
            let exit_at: (LinuxSyscallAt(site.linux(stack), g.state) ∧ LinuxExits(g.state, status)) ∧ (g.io = exited.proof.witness) =
                j(exited.proof.proof, λ x _ => site.Reached(stack, spans, s, i, ret, x, g), at);
            site.exit_not_passed(stack, i, ret, g, mid, r, k2, status, exit_at.left, same, path)
        },
    }
}

// What the code performs at a fuel, read off the meaning: its world a
// history the meaning reaches there.
theorem Site::reached_history<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat, ret: BitVec(64),
    outcome: Ran<Answer>, g: Running<M, Io>, at: site.Reached(stack, spans, s, i, ret, outcome, g)):
    (history(outcome) = Some(g.io.past)) ∨ Exists<Io>(λ o => outcome = Stuck(o)) {
    (match outcome as λ x => site.Reached(stack, spans, s, i, ret, x, g) → (history(x) = Some(g.io.past)) ∨ Exists<Io>(λ o => x = Stuck(o)) {
        Done(a) => λ returned => Inl(cong_fn<Io, Option<List<Exchange>>>(λ w => Some(w.past), sym(returned.right.right.right))),
        Exited(status, o) => λ exited => Inl(cong_fn<Io, Option<List<Exchange>>>(λ w => Some(w.past), sym(exited.right))),
        Going(o) => λ going => Inl(cong_fn<Io, Option<List<Exchange>>>(λ w => Some(w.past), sym(going))),
        Stuck(o) => λ _ => Inr(Exists(o, refl)),
    })(at)
}

// A path of the code from where a claim of an outcome starts, fewer steps
// than the claim's lower bound where the outcome is going: its world is a
// prefix of the outcome's history, or the outcome is stuck, or it is at or
// before an escape on its branch, where the escapes are exits.
theorem Site::tracked_prefix<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, s: MachineState<M>, i: Nat,
    ret: BitVec(64), io: Io, n: Nat, outcome: Ran<Answer>, esc: Running<M, Io> → Type,
    exits: (g: Running<M, Io>) → esc(g) → Exists<BitVec(64)>(λ status => LinuxSyscallAt(site.linux(stack), g.state) ∧ LinuxExits(g.state, status)),
    k: Nat, r: Running<M, Io>, tracked: site.Tracked(stack, spans, s, i, ret, io, n, outcome, esc),
    path: StarN(site.Onward(stack, i, ret), k, Running<M, Io>(s, io), r), short: (o: Io) → outcome = Going(o) → k <= n - 1):
    (Exists<List<Exchange>>(λ h => (history(outcome) = Some(h)) ∧ Extends(h, r.io.past)) ∨ Exists<Io>(λ o => outcome = Stuck(o))) ∨ Ahead(esc, r) {
    let Goal = site.Reached(stack, spans, s, i, ret, outcome);
    match site.performs_or_meet(stack, i, ret, Goal, esc, tracked.witness, going_least(n, outcome), k, Running<M, Io>(s, io), Running<M, Io>(s, io), r,
        refl, refl, tracked.proof, path) {
        Inl(met) => Inl(match met {
            Inl(ahead) => {
                let g = ahead.witness;
                match site.reached_history(stack, spans, s, i, ret, outcome, g, ahead.proof.left) {
                    Inl(seen) => Inl(Exists(g.io.past, ⟨seen, ahead.proof.right⟩)),
                    Inr(stuck) => Inr(stuck),
                }
            },
            Inr(passed_goal) => {
                let g = passed_goal.right.witness;
                let mid = passed_goal.right.proof.witness;
                let k2 = passed_goal.right.proof.proof.witness;
                let facts = passed_goal.right.proof.proof.proof;
                (match outcome as λ x => going_least(n, x) < k → site.Reached(stack, spans, s, i, ret, x, g) →
                    (Exists<Answer>(λ a => x = Done(a)) ∨ Exists<BitVec(64)>(λ status => Exists<Io>(λ o => x = Exited(status, o))) → False) →
                    ((o: Io) → x = Going(o) → k <= n - 1) →
                    Exists<List<Exchange>>(λ h => (history(x) = Some(h)) ∧ Extends(h, r.io.past)) ∨ Exists<Io>(λ o => x = Stuck(o)) {
                    Done(a) => λ _ _ never _ => false_elim(never(Inl(Exists(a, refl)))),
                    Exited(status, o) => λ _ _ never _ => false_elim(never(Inr(Exists(status, Exists(o, refl))))),
                    Going(o) => λ (lt: n - 1 < k) _ _ within => { let le = within(o, refl); false_elim({ omega }) },
                    Stuck(o) => λ _ _ _ _ => Inr(Exists(o, refl)),
                })(passed_goal.left, facts.left,
                    site.passed_not_reached(stack, spans, s, i, ret, outcome, g, mid, r, k2, facts.left, facts.right.left, facts.right.right), short)
            },
        }),
        Inr(met) => match met {
            Inl(ahead) => Inr(ahead),
            Inr(passed_esc) => {
                let g = passed_esc.right.witness;
                let facts = passed_esc.right.proof.proof.proof;
                let exit = exits(g, facts.left);
                false_elim(site.exit_not_passed(stack, i, ret, g, passed_esc.right.proof.witness, r, passed_esc.right.proof.proof.witness,
                    exit.witness, exit.proof, facts.right.left, facts.right.right))
            },
        },
    }
}

// The going clause, from `Tracks`: proved once. At fuel `j + 1` the claim's
// steps number at least `j` where the meaning is going; a path at or before
// the spent stop has a world its prefix, and the stop is an exit, which no
// path passes.
theorem Site::tracks_going<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls(),
    tracks: site.Tracks(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning)):
    site.MeetsGoing(stack, spans, top, lent, rooms, floored, bound, meaning) {
    λ loan law f below args heap io s here resident i rsp inside passed high injected ret saved floor roomy answerable k r path => {
        let n = k + 1;
        let esc = site.OutOfRoom(stack, room, peak, meaning, f, args, heap, io, i, n);
        match site.tracked_prefix(stack, spans, s, i, ret, io, n, meaning(n, f, args, heap, io), esc,
            λ g out => Exists(BitVec::ofNat(spent_status()), out.right.left), k, r,
            tracks(loan, law, f, below, args, heap, io, s, here, resident, i, rsp, inside, passed, high, injected, ret, saved, floor, roomy, n,
                answerable), path, λ o _ => { omega }) {
            Inl(tracked) => match tracked {
                Inl(seen) => Inl(Exists(n, seen)),
                Inr(stuck) => Inr(Exists(n, stuck)),
            },
            Inr(ahead) => meaning_prefix_extends(meaning, f, args, heap, io, ahead.witness.io.past, r.io.past, ahead.proof.left.right.right,
                ahead.proof.right),
        }
    }
}

// `Tracks` is the contract.
theorem Site::tracks_meets<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, lent: Type, rooms: Nat → Nat,
    floored: Bool, room: Nat → Nat → Nat, peak: Nat → Nat → List<Value> → Heap → Io → Nat, bound: Nat, meaning: Nat → Calls(),
    tracks: site.Tracks(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning)):
    site.Meets(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning) {
    ⟨site.tracks_done(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning, tracks),
     ⟨site.tracks_exited(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning, tracks),
      site.tracks_going(stack, spans, top, lent, rooms, floored, room, peak, bound, meaning, tracks)⟩⟩
}

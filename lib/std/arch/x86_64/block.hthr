// Typed x86 instruction blocks. This layer composes the existing canonical
// single-instruction encoder, decoder boundary, and relational execution
// without introducing fetch or a complete ABI function model.

import x86_64;
import bitvec;
import bool;
import list;
import logic;
import relation;

fn canonical_block_bytes(instructions: List<Instruction>) → List<BitVec(8)> {
    match instructions {
        Nil => Nil,
        Cons(instruction, rest) =>
            canonical_bytes(instruction) ++ canonical_block_bytes(rest),
    }
}

// The stored instruction list determines a placed layout by advancing each
// successor span from the preceding instruction's canonical decoded length.
fn CanonicalBlockDecodes(instructions: List<Instruction>) → BitVec(64) → Type {
    match instructions {
        Nil => λ start => True,
        Cons(instruction, rest) => λ start =>
            DecodedAt(encoded_at(start, instruction),
                decoded_canonical(instruction)) ∧
            CanonicalBlockDecodes(rest,
                next_rip(start, canonical_length(instruction))),
    }
}

theorem canonical_block_decodes(instructions: List<Instruction>):
    (start: BitVec(64)) → CanonicalBlockDecodes(instructions, start)
{
    match instructions {
        Nil => start ⊢ trivial,
        Cons(instruction, rest) => start ⊢ ⟨
            canonical_encoding_decodes(start, instruction),
            canonical_block_decodes(rest,
                next_rip(start, canonical_length(instruction)))⟩,
    }
}

// Functional execution is a convenient representative for deterministic
// clients. `ExecuteBlock` below is authoritative and retains the nondeterminism
// of instructions such as TEST. The generic command trace in `relation`
// keeps the recursive proof independent of the large x86 step semantics.
fn execute_block_normal<M>(instructions: List<Instruction>) →
    MachineState<M> → MachineState<M>
{
    execute_steps(
        λ instruction before => execute_normal(decoded_canonical(instruction), before),
        instructions)
}

fn ExecuteBlock<M>(instructions: List<Instruction>) →
    MachineState<M> → MachineState<M> → Type
{
    ExecuteSteps(λ instruction before after =>
        Execute(decoded_canonical(instruction), before, Returned(after)),
        instructions)
}

// One-step certificate composition avoids asking the kernel to discover a
// recursive proof for an arbitrary instruction list. A selector emits one
// application per selected instruction, while sharing this constructor and
// the leaf proof across every lowering rule.
theorem execute_block_nil<M>(state: MachineState<M>):
    ExecuteBlock([], state, state)
{
    execute_steps_nil<Instruction, MachineState<M>>(λ instruction before after =>
        Execute(decoded_canonical(instruction), before, Returned(after)), state)
}

theorem canonical_execute_block_cons<M>(instruction: Instruction,
    rest: List<Instruction>, before, after: MachineState<M>,
    tail: ExecuteBlock(rest,
        execute_normal(decoded_canonical(instruction), before), after)):
    ExecuteBlock(Cons(instruction, rest), before, after)
{
    execute_steps_cons<Instruction, MachineState<M>>(
        λ current state result =>
            Execute(decoded_canonical(current), state, Returned(result)),
        instruction, rest, before,
        execute_normal(decoded_canonical(instruction), before), after,
        canonical_execute_normal_is_allowed(instruction, before), tail)
}

theorem canonical_block_executes_normal<M>(instructions: List<Instruction>):
    (before: MachineState<M>) → ExecuteBlock(instructions, before,
        execute_block_normal(instructions, before))
{
    execute_steps_are_allowed(
        λ instruction state => execute_normal(decoded_canonical(instruction), state),
        λ instruction state after =>
            Execute(decoded_canonical(instruction), state, Returned(after)),
        canonical_execute_normal_is_allowed<M>, instructions)
}

// Common boundary for a certified straight-line leaf block. It deliberately
// observes only one result register, memory, RIP, and a caller-selected frame;
// flags and clobbered registers remain unobservable.
record BlockArtifact<M>(instructions: List<Instruction>,
    before: MachineState<M>, result_register: Gpr, result: BitVec(64),
    protected: Gpr → Type, final_rip: BitVec(64))
{
    after: MachineState<M>,
    execution: ExecuteBlock(instructions, before, after),
    result_correct: read_gpr(result_register, after.gprs) = result,
    memory_preserved: after.memory = before.memory,
    rip_correct: after.rip = final_rip,
    registers_preserved: (register: Gpr) → protected(register) →
        read_gpr(register, after.gprs) = read_gpr(register, before.gprs),
}

// A structured machine control-flow node. The branch bodies remain ordinary
// canonical instruction blocks; the linker-facing Jcc/Jmp byte layout is a
// separate boundary, just as block placement is separate from ExecuteBlock.
// Reading the materialized low bit makes selection a property of machine
// state rather than an oracle supplied by the compiler proof.
record ConditionalBlock {
    condition_register: Gpr,
    when_true: List<Instruction>,
    when_false: List<Instruction>,
}

fn machine_condition<M>(register: Gpr, state: MachineState<M>) → Bool {
    bitvec::head_bit(63, read_gpr(register, state.gprs))
}

fn ExecuteSelectedBlock<M>(selected: Bool, block: ConditionalBlock,
    before, after: MachineState<M>) → Type
{
    match selected {
        False => ExecuteBlock(block.when_false, before, after),
        True => ExecuteBlock(block.when_true, before, after),
    }
}

fn selected_block_after<M>(selected: Bool,
    when_true, when_false: MachineState<M>) → MachineState<M>
{
    match selected {
        False => when_false,
        True => when_true,
    }
}

fn ExecuteConditionalBlock<M>(block: ConditionalBlock) →
    MachineState<M> → MachineState<M> → Type
{
    λ before after => ExecuteSelectedBlock(
        machine_condition(block.condition_register, before), block, before, after)
}

fn conditional_block_after<M>(block: ConditionalBlock,
    before, when_true, when_false: MachineState<M>) → MachineState<M>
{
    selected_block_after(machine_condition(block.condition_register, before),
        when_true, when_false)
}

theorem execute_conditional_false<M>(block: ConditionalBlock,
    before, after: MachineState<M>,
    condition: machine_condition(block.condition_register, before) = False,
    branch: ExecuteBlock(block.when_false, before, after)):
    ExecuteConditionalBlock(block, before, after)
{
    j(sym(condition),
        λ actual _ => match actual {
            False => ExecuteBlock(block.when_false, before, after),
            True => ExecuteBlock(block.when_true, before, after),
        }, branch)
}

theorem execute_conditional_true<M>(block: ConditionalBlock,
    before, after: MachineState<M>,
    condition: machine_condition(block.condition_register, before) = True,
    branch: ExecuteBlock(block.when_true, before, after)):
    ExecuteConditionalBlock(block, before, after)
{
    j(sym(condition),
        λ actual _ => match actual {
            False => ExecuteBlock(block.when_false, before, after),
            True => ExecuteBlock(block.when_true, before, after),
        }, branch)
}

theorem execute_conditional_selected<M>(block: ConditionalBlock,
    before, when_true, when_false: MachineState<M>,
    true_branch: ExecuteBlock(block.when_true, before, when_true),
    false_branch: ExecuteBlock(block.when_false, before, when_false)):
    ExecuteConditionalBlock(block, before,
        conditional_block_after(block, before, when_true, when_false))
{
    match machine_condition(block.condition_register, before) as λ selected =>
        ExecuteSelectedBlock(selected, block, before,
            selected_block_after(selected, when_true, when_false))
    {
        False => false_branch,
        True => true_branch,
    }
}

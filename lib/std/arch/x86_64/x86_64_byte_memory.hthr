// x86_64's memory as the byte model (issues/memory-model-machine-instances.md;
// docs/byte-memory-design.md §6): the machine's access records instantiated
// from `lib/std/machine/memory.hthr`, and a process stack built from a data region
// by proof instead of assumed.
//
// A machine memory (`X86Memory(x)`) is cells and permissions, and a proof
// that the permissions are what the run relies on: the profile `x` names
// that reliance (`relies`). The space is `BitVec::space(64)`. `Stack<M>` and
// the views state their laws for every memory of their type, and a memory
// whose permissions are arbitrary would falsify them (one with none is not
// writable anywhere); a memory of the profile cannot be one of those. A
// store keeps the permissions, so it keeps the proof as it is. A step that
// changes permissions (mmap, mprotect, allocation; design §7) builds a new
// memory and proves the reliance again, for the regions the run relies on
// and nothing else.
//
// - `fetch`/`data` read through the model's `read` as an `Option`, and an
//   address is executable by its execute bit. `writes` asks
//   `Allows(Perm::writes, …)` and stores a list as `set_span` of its vector.
// - The canonical-address rule is in the model's permissions: at or above
//   `2^47` (the user half) an address has none (`X86Profile::perm`),
//   whatever the memory's permissions say. A word load's own canonical
//   premise (`WordCanonical`) stays the machine's.
// - `DataRegion::stack` is a `Stack` whose laws come from `get_set_span`,
//   `get_set_span_apart`, `get_set_span_outside` and the space's non-wrap
//   lemmas, given `size` bytes from `low` below `2^47` that the profile
//   relies on having the data permission (read, write, no execute). That
//   the region never executes is what keeps code where it was.
// - `DataRegion::loan` is a `Loan` (x86_64_lending) of spans inside the
//   region, above the offset the borrower's stack words lie below: the laws
//   a call lent those spans is owed, from the same lemmas.
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_stack;
import x86_64_lending;
import memory;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;
import result;

// ---------------------------------------------------------------------------
// Profiles, memories and their access records

// What a run relies on of the permissions.
record X86Profile { relies: (BitVec(64) → Perm) → Type }

record X86Memory(x: X86Profile) {
    cells: BitVec(64) → BitVec(8),
    perms: BitVec(64) → Perm,
    relied: x.relies(perms),
}

// The canonical-address rule: only the user half has permissions.
fn X86Profile::perm(self x: X86Profile, m: X86Memory(x), a: BitVec(64)) → Perm {
    match Succ(a.toNat()).leb(Nat::pow(2, 47)) { True => m.perms(a), False => Perm::none() }
}

// The memory as one of the model.
fn X86Profile::at(self x: X86Profile, m: X86Memory(x)) → Memory<BitVec(64), BitVec(8)> {
    Memory<BitVec(64), BitVec(8)>(BitVec::space(64), m.cells, λ (a: BitVec(64)) => x.perm(m, a))
}

// A checked read, its fault forgotten: what the access records' `Option`
// is.
fn X86Profile::read(self x: X86Profile, m: X86Memory(x), a: BitVec(64)) → Option<BitVec(8)> {
    match x.at(m).read(a) { Ok(byte) => Some(byte), Err(_) => None }
}

// A store changes the cells only, so the memory keeps its proof.
fn X86Profile::store(self x: X86Profile, m: X86Memory(x), a: BitVec(64), bytes: List<BitVec(8)>) → X86Memory(x) {
    X86Memory(cells := x.at(m).set_span(a, bytes.to_vector()).cells, perms := m.perms, relied := m.relied)
}

fn X86Profile::fetch(self x: X86Profile) → FetchAccess<X86Memory(x)> {
    FetchAccess(λ (m: X86Memory(x)) (a: BitVec(64)) => x.read(m, a), λ (m: X86Memory(x)) (a: BitVec(64)) => x.at(m).perms(a).execute)
}

fn X86Profile::data(self x: X86Profile) → ByteReadAccess<X86Memory(x)> {
    ByteReadAccess(λ (m: X86Memory(x)) (a: BitVec(64)) => x.read(m, a))
}

fn X86Profile::writes(self x: X86Profile) → ByteWrites<X86Memory(x)> {
    ByteWrites(λ (m: X86Memory(x)) (a: BitVec(64)) (k: Nat) => x.at(m).Allows(Perm::writes, a, k),
        λ (m: X86Memory(x)) (a: BitVec(64)) (bytes: List<BitVec(8)>) => x.store(m, a, bytes))
}

// ---------------------------------------------------------------------------
// Reads

theorem X86Profile::perm_canonical(self x: X86Profile, m: X86Memory(x), a: BitVec(64), low: a.toNat() < Nat::pow(2, 47)):
    x.perm(m, a) = m.perms(a) {
    let below: (Succ(a.toNat()).leb(Nat::pow(2, 47)) = True) =
        bool::eq_true_of_is_true(Succ(a.toNat()).leb(Nat::pow(2, 47)), Succ(a.toNat()).leb_complete(Nat::pow(2, 47), low));
    j(sym(below), λ s _ => (match s { True => m.perms(a), False => Perm::none() }) = m.perms(a), refl)
}

theorem X86Profile::read_at(self x: X86Profile, m: X86Memory(x), a: BitVec(64), readable: x.perm(m, a).read = True):
    x.read(m, a) = Some(m.cells(a)) {
    j(sym(x.at(m).read_allowed(a, readable)), λ r _ =>
        (match r { Ok(byte) => Some(byte), Err(_) => None }) = Some<BitVec(8)>(m.cells(a)), refl)
}

// A read sees the cell and the permission, nothing else: memories with the
// same permissions whose cell agrees there read alike.
theorem X86Profile::read_agree(self x: X86Profile, m: X86Memory(x), cells: BitVec(64) → BitVec(8), a: BitVec(64), same: cells(a) = m.cells(a)):
    x.read(X86Memory(cells := cells, perms := m.perms, relied := m.relied), a) = x.read(m, a) {
    let other: X86Memory(x) = X86Memory(cells := cells, perms := m.perms, relied := m.relied);
    match readable: x.perm(m, a).read {
        True => trans(x.read_at(other, a, readable),
            trans(cong_fn<BitVec(8), Option<BitVec(8)>>(λ b => Some(b), same), sym(x.read_at(m, a, readable)))),
        False => {
            let none: ((n: X86Memory(x)) → x.perm(n, a).read = False → x.read(n, a) = None<BitVec(8)>) = λ n readable =>
                j(sym(x.at(n).read_refused(a, readable)), λ r _ =>
                    (match r { Ok(byte) => Some(byte), Err(_) => None }) = None<BitVec(8)>, refl);
            trans(none(other, readable), sym(none(m, readable)))
        },
    }
}

// Eight reads that agree read the same word.
theorem read_word_agree<M>(access: ByteReadAccess<M>, m, n: M, a: BitVec(64),
    same: (t: Nat) → t < 8 → access.read(m, next_rip(a, t)) = access.read(n, next_rip(a, t))):
    read_word(access, m, a) = read_word(access, n, a) {
    let r = λ (memory: M) (t: Nat) => access.read(memory, next_rip(a, t));
    j(same(0, trivial), λ x _ => read_word(access, m, a) = word_of_reads(x, r(n, 1), r(n, 2), r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(1, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), x, r(n, 2), r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(2, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), x, r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(3, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), x, r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(4, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), x, r(n, 5), r(n, 6), r(n, 7)),
    j(same(5, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), x, r(n, 6), r(n, 7)),
    j(same(6, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), r(m, 5), x, r(n, 7)),
    j(same(7, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), r(m, 5), r(m, 6), x),
        refl))))))))
}

// ---------------------------------------------------------------------------
// Stores

// A store leaves every cell outside its span.
theorem X86Profile::store_outside(self x: X86Profile, m: X86Memory(x), a: BitVec(64), bytes: List<BitVec(8)>, y: BitVec(64),
    outside: (p: Nat) → p < bytes.len() → BitVec::space(64).same(next_rip(a, p), y) = False): x.store(m, a, bytes).cells(y) = m.cells(y) {
    x.at(m).get_set_span_outside(a, bytes.to_vector(), y, outside)
}

// A store that executes nowhere keeps the code resident wherever it is.
theorem X86Profile::store_keeps_code(self x: X86Profile, m: X86Memory(x), a: BitVec(64), stored: List<BitVec(8)>,
    data: (p: Nat) → p < stored.len() → x.perm(m, next_rip(a, p)).execute = False, bytes: List<BitVec(8)>):
    (at: BitVec(64)) → CodeResident(x.fetch(), m, bytes, at) → CodeResident(x.fetch(), x.store(m, a, stored), bytes, at) {
    match bytes {
        Nil => λ at _ => trivial,
        Cons(byte, rest) => λ at resident => {
            let outside: ((p: Nat) → p < stored.len() → BitVec::space(64).same(next_rip(a, p), at) = False) = λ p inside =>
                BitVec::space_laws(64).same_false(BitVec::space(64), next_rip(a, p), at, λ same =>
                    absurd(trans(sym(j(same, λ y _ => x.perm(m, y).execute = False, data(p, inside))), resident.left)));
            let read: (x.read(x.store(m, a, stored), at) = Some(byte)) =
                trans(x.read_agree(m, x.store(m, a, stored).cells, at, x.store_outside(m, a, stored, at, outside)), resident.right.left);
            ⟨resident.left, ⟨read, ⟨resident.right.right.left,
                x.store_keeps_code(m, a, stored, data, rest, next_rip(at, 1), resident.right.right.right)⟩⟩⟩
        },
    }
}

// ---------------------------------------------------------------------------
// A data region: readable and writable, never executed, below the canonical
// boundary, in every memory of its profile

record DataRegion {
    profile: X86Profile,
    low: BitVec(64),
    size: Nat,
    canonical: low.toNat() + size <= Nat::pow(2, 47),
    data: (perms: BitVec(64) → Perm) → profile.relies(perms) → (i: Nat) → i < size → perms(next_rip(low, i)) = Perm::data(),
}

theorem canonical_below_top(): Succ(Nat::pow(2, 47)) <= Nat::pow(2, 64) {
    Nat::leb_sound(Succ(Nat::pow(2, 47)), Nat::pow(2, 64), trivial)
}

// Inside the region an offset is plain addition.
theorem DataRegion::toNat_at(self r: DataRegion, i: Nat, inside: i <= r.size):
    next_rip(r.low, i).toNat() = r.low.toNat() + i {
    let top = canonical_below_top();
    let fits: (r.low.toNat() + i < Nat::pow(2, 64)) = omega(r.canonical, inside, top);
    BitVec::offset_toNat(64, r.low, i, fits)
}

theorem DataRegion::perm_at(self r: DataRegion, m: X86Memory(r.profile), i: Nat, inside: i < r.size):
    r.profile.perm(m, next_rip(r.low, i)) = Perm::data() {
    let value = r.toNat_at(i, omega(inside));
    trans(r.profile.perm_canonical(m, next_rip(r.low, i), omega(value, r.canonical, inside)), r.data(m.perms, m.relied, i, inside))
}

// `p` bytes past offset `i`, as the span forms count.
theorem DataRegion::perm_from(self r: DataRegion, m: X86Memory(r.profile), i, p: Nat, inside: i + p < r.size):
    r.profile.perm(m, next_rip(next_rip(r.low, i), p)) = Perm::data() {
    trans(cong_fn<BitVec(64), Perm>(λ y => r.profile.perm(m, y), rip_compose(r.low, i, p)), r.perm_at(m, i + p, inside))
}

// A span from offset `i` inside the region, in any memory of the profile, has
// every bit the data permission sets.
theorem DataRegion::allows(self r: DataRegion, allowed: Perm → Bool, set: allowed(Perm::data()) = True,
    m: X86Memory(r.profile), i, k: Nat, fits: i + k <= r.size): r.profile.at(m).Allows(allowed, next_rip(r.low, i), k) {
    λ p inside => j(sym(r.perm_from(m, i, p, omega(inside, fits))), λ q _ => allowed(q) = True, set)
}

theorem DataRegion::not_executed(self r: DataRegion, m: X86Memory(r.profile), i, k: Nat, fits: i + k <= r.size):
    (p: Nat) → p < k → r.profile.perm(m, next_rip(next_rip(r.low, i), p)).execute = False {
    λ p inside => j(sym(r.perm_from(m, i, p, omega(inside, fits))), λ q _ => q.execute = False, refl)
}

// A span inside the region does not overlap itself.
theorem DataRegion::distinct(self r: DataRegion, i, k: Nat, fits: i + k <= r.size):
    BitVec::space(64).Distinct(next_rip(r.low, i), k) {
    let value = r.toNat_at(i, omega(fits));
    let top = canonical_below_top();
    BitVec::space_distinct(64, next_rip(r.low, i), k, omega(value, fits, r.canonical, top))
}

// Two spans inside the region, one wholly below the other, share no address.
theorem DataRegion::apart(self r: DataRegion, i, k, l, n: Nat, fi: i + k <= r.size, fl: l + n <= r.size,
    ordered: (i + k <= l) ∨ (l + n <= i)): BitVec::space(64).Apart(next_rip(r.low, i), k, next_rip(r.low, l), n) {
    let at_i = r.toNat_at(i, omega(fi));
    let at_l = r.toNat_at(l, omega(fl));
    let top = canonical_below_top();
    match ordered {
        Inl(below) => BitVec::space_apart(64, next_rip(r.low, i), k, next_rip(r.low, l), n, omega(at_i, at_l, below),
            omega(at_l, fl, r.canonical, top)),
        Inr(above) => BitVec::space_apart_above(64, next_rip(r.low, i), k, next_rip(r.low, l), n, omega(at_i, at_l, above),
            omega(at_i, fi, r.canonical, top)),
    }
}

// A list stored from offset `i` reads back, byte by byte.
theorem DataRegion::read_stored(self r: DataRegion, m: X86Memory(r.profile), i: Nat, bytes: List<BitVec(8)>,
    fits: i + bytes.len() <= r.size, p: Nat, byte: BitVec(8), found: bytes.nth(p) = Some(byte)):
    r.profile.read(r.profile.store(m, next_rip(r.low, i), bytes), next_rip(next_rip(r.low, i), p)) = Some(byte) {
    let inside: (p < bytes.len()) = match p.lt_or_ge(bytes.len()) {
        Inl(below) => below,
        Inr(past) => absurd(trans(sym(found), bytes.nth_past_end(p, past))),
    };
    let after = r.profile.store(m, next_rip(r.low, i), bytes);
    let readable: (r.profile.perm(after, next_rip(next_rip(r.low, i), p)).read = True) =
        cong_fn<Perm, Bool>(λ q => q.read, r.perm_from(after, i, p, omega(inside, fits)));
    let cell: (after.cells(next_rip(next_rip(r.low, i), p)) = byte) =
        r.profile.at(m).get_set_span_list(BitVec::space_laws(64), next_rip(r.low, i), bytes, p, byte, found, r.distinct(i, bytes.len(), fits));
    trans(r.profile.read_at(after, next_rip(next_rip(r.low, i), p), readable), cong_fn<BitVec(8), Option<BitVec(8)>>(λ b => Some(b), cell))
}

// ---------------------------------------------------------------------------
// The stack a process gives its program, its laws proved from the model

fn DataRegion::stack(self r: DataRegion) → Stack<X86Memory(r.profile)>(r.profile.fetch(), r.profile.data()) {
    Stack(
        writes := r.profile.writes(),
        low := r.low,
        size := r.size,
        canonical := λ i fits => {
            let value = r.toNat_at(i, omega(fits));
            omega(value, fits, r.canonical)
        },
        writable := λ m i fits => r.allows(Perm::writes, refl, m, i, 8, fits),
        stored := λ m i fits word => {
            let a = next_rip(r.low, i);
            let after = r.profile.store(m, a, word_bytes(word));
            let o = λ (t: Nat) => r.profile.read(after, next_rip(a, t));
            let b = λ (t: Nat) (byte: BitVec(8)) (found: word_bytes(word).nth(t) = Some(byte)) =>
                r.read_stored(m, i, word_bytes(word), fits, t, byte, found);
            trans(word_of_eight(o(0), o(1), o(2), o(3), o(4), o(5), o(6), o(7),
                    imm_byte0(word), imm_byte1(word), imm_byte2(word), imm_byte3(word),
                    imm_byte4(word), imm_byte5(word), imm_byte6(word), imm_byte7(word),
                    b(0, imm_byte0(word), refl), b(1, imm_byte1(word), refl), b(2, imm_byte2(word), refl), b(3, imm_byte3(word), refl),
                    b(4, imm_byte4(word), refl), b(5, imm_byte5(word), refl), b(6, imm_byte6(word), refl), b(7, imm_byte7(word), refl)),
                cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), immediate_bytes_roundtrip(word)))
        },
        apart := λ m i k fi fk ordered word => {
            let a = next_rip(r.low, i);
            let after = r.profile.store(m, a, word_bytes(word));
            let apart = r.apart(i, 8, k, 8, fi, fk, ordered);
            read_word_agree(r.profile.data(), after, m, next_rip(r.low, k), λ t inside =>
                r.profile.read_agree(m, after.cells, next_rip(next_rip(r.low, k), t),
                    r.profile.store_outside(m, a, word_bytes(word), next_rip(next_rip(r.low, k), t), λ p below => apart(p, t, below, inside))))
        },
        keeps_code := λ m i fits word bytes at resident =>
            r.profile.store_keeps_code(m, next_rip(r.low, i), word_bytes(word), r.not_executed(m, i, 8, fits), bytes, at, resident),
    )
}

// ---------------------------------------------------------------------------
// Spans lent inside the region (docs/native-one-compiler-design.md §2.6)

// A store inside the region leaves a byte it does not cover. Both
// addresses are spelled as a span's offset and a byte within it.
theorem DataRegion::store_apart(self r: DataRegion, m: X86Memory(r.profile), i, s: Nat, bytes: List<BitVec(8)>, l, t: Nat,
    fi: i + s + bytes.len() <= r.size, fl: l + t < r.size, ordered: (i + s + bytes.len() <= l + t) ∨ (l + t + 1 <= i + s)):
    r.profile.read(r.profile.store(m, next_rip(next_rip(r.low, i), s), bytes), next_rip(next_rip(r.low, l), t)) =
        r.profile.read(m, next_rip(next_rip(r.low, l), t)) {
    let apart = r.apart(i + s, bytes.len(), l + t, 1, fi, omega(fl), ordered);
    let flat: (r.profile.read(r.profile.store(m, next_rip(r.low, i + s), bytes), next_rip(r.low, l + t)) = r.profile.read(m, next_rip(r.low, l + t))) =
        r.profile.read_agree(m, r.profile.store(m, next_rip(r.low, i + s), bytes).cells, next_rip(r.low, l + t),
            r.profile.store_outside(m, next_rip(r.low, i + s), bytes, next_rip(r.low, l + t), λ p below => apart(p, 0, below, trivial)));
    j(sym(rip_compose(r.low, i, s)), λ a _ => r.profile.read(r.profile.store(m, a, bytes), next_rip(next_rip(r.low, l), t)) =
            r.profile.read(m, next_rip(next_rip(r.low, l), t)),
        j(sym(rip_compose(r.low, l, t)), λ y _ => r.profile.read(r.profile.store(m, next_rip(r.low, i + s), bytes), y) = r.profile.read(m, y), flat))
}

// One byte of a span inside the region: writable, read back once stored,
// and stored without moving code.
theorem DataRegion::byte_writable(self r: DataRegion, m: X86Memory(r.profile), i, s: Nat, fits: i + s < r.size):
    r.profile.at(m).Allows(Perm::writes, next_rip(next_rip(r.low, i), s), 1) {
    j(sym(rip_compose(r.low, i, s)), λ a _ => r.profile.at(m).Allows(Perm::writes, a, 1), r.allows(Perm::writes, refl, m, i + s, 1, omega(fits)))
}

theorem DataRegion::byte_stored(self r: DataRegion, m: X86Memory(r.profile), i, s: Nat, byte: BitVec(8), fits: i + s < r.size):
    r.profile.read(r.profile.store(m, next_rip(next_rip(r.low, i), s), [byte]), next_rip(next_rip(r.low, i), s)) = Some(byte) {
    let one: (i + s + 1 <= r.size) = omega(fits);
    j(sym(rip_compose(r.low, i, s)), λ a _ => r.profile.read(r.profile.store(m, a, [byte]), a) = Some(byte),
        r.read_stored(m, i + s, [byte], one, 0, byte, refl))
}

theorem DataRegion::byte_keeps_code(self r: DataRegion, m: X86Memory(r.profile), i, s: Nat, byte: BitVec(8), fits: i + s < r.size,
    bytes: List<BitVec(8)>, at: BitVec(64), resident: CodeResident(r.profile.fetch(), m, bytes, at)):
    CodeResident(r.profile.fetch(), r.profile.store(m, next_rip(next_rip(r.low, i), s), [byte]), bytes, at) {
    let one: (i + s + 1 <= r.size) = omega(fits);
    j(sym(rip_compose(r.low, i, s)), λ a _ => CodeResident(r.profile.fetch(), r.profile.store(m, a, [byte]), bytes, at),
        r.profile.store_keeps_code(m, next_rip(r.low, i + s), [byte], r.not_executed(m, i + s, 1, one), bytes, at, resident))
}

// Spans inside the region are lent under its stack (`DataRegion::stack`)
// wherever each lies at or above `top`, at the offset `offset` gives it,
// and a span that may be written shares no byte with another. A span of no
// bytes may lie anywhere canonical: a buffer nobody named an address for.
theorem DataRegion::loan(self r: DataRegion, top: Nat, spans: Spans, offset: Nat → Nat, room: top <= r.size,
    placed: (b: Nat) → 0 < spans.size(b) →
        (spans.at(b) = next_rip(r.low, offset(b))) ∧ ((top <= offset(b)) ∧ (offset(b) + spans.size(b) <= r.size)),
    empty: (b: Nat) → spans.size(b) = 0 → spans.at(b).toNat() <= Nat::pow(2, 47),
    apart: (b, c: Nat) → spans.written(b) = True → b ≠ c → 0 < spans.size(b) → 0 < spans.size(c) →
        (offset(b) + spans.size(b) <= offset(c)) ∨ (offset(c) + spans.size(c) <= offset(b))):
    Loan<X86Memory(r.profile)>(r.profile.fetch(), r.profile.data(), r.stack(), top, spans) {
    Loan(
        room := room,
        canonical := λ b => match Nat::lt_or_ge(0, spans.size(b)) {
            Inl(some) => {
                let here = placed(b, some);
                let value = r.toNat_at(offset(b), omega(here.right.right));
                j(sym(here.left), λ a _ => a.toNat() + spans.size(b) <= Nat::pow(2, 47), omega(value, here.right.right, r.canonical))
            },
            Inr(none) => omega(empty(b, omega(none)), none),
        },
        under := λ m k below word b j inside => {
            let here = placed(b, omega(inside));
            let fits: (k + 0 + 8 <= r.size) = omega(below, room);
            let order: (k + 0 + 8 <= offset(b) + j) = omega(below, here.right.left);
            j(sym(here.left), λ a _ => r.profile.read(r.profile.store(m, next_rip(r.low, k), word_bytes(word)), next_rip(a, j)) =
                    r.profile.read(m, next_rip(a, j)),
                r.store_apart(m, k, 0, word_bytes(word), offset(b), j, fits, omega(inside, here.right.right), Inl(order)))
        },
        writable := λ m b k written inside => {
            let here = placed(b, omega(inside));
            j(sym(here.left), λ a _ => r.profile.at(m).Allows(Perm::writes, next_rip(a, k), 1),
                r.byte_writable(m, offset(b), k, omega(inside, here.right.right)))
        },
        stored := λ m b k written inside byte => {
            let here = placed(b, omega(inside));
            j(sym(here.left), λ a _ => r.profile.read(r.profile.store(m, next_rip(a, k), [byte]), next_rip(a, k)) = Some(byte),
                r.byte_stored(m, offset(b), k, byte, omega(inside, here.right.right)))
        },
        apart := λ m b k written inside byte c j short other => {
            let here = placed(b, omega(inside));
            let there = placed(c, omega(short));
            let one: (offset(b) + k + 1 <= r.size) = omega(inside, here.right.right);
            let order: ((offset(b) + k + 1 <= offset(c) + j) ∨ (offset(c) + j + 1 <= offset(b) + k)) = match b.eq_dec(c) {
                Inl(same) => match other {
                    Inl(differs) => false_elim(differs(same)),
                    Inr(differs) => {
                        let same_offset: (offset(b) = offset(c)) = cong_fn<Nat, Nat>(λ n => offset(n), same);
                        match k.lt_or_ge(j) {
                            Inl(lt) => Inl(omega(lt, same_offset)),
                            Inr(ge) => match j.lt_or_ge(k) {
                                Inl(lt) => Inr(omega(lt, same_offset)),
                                Inr(le) => {
                                    let equal: (k = j) = omega(ge, le);
                                    false_elim(differs(equal))
                                },
                            },
                        }
                    },
                },
                Inr(differs) => match apart(b, c, written, differs, omega(inside), omega(short)) {
                    Inl(below) => Inl(omega(below, inside)),
                    Inr(above) => Inr(omega(above, short)),
                },
            };
            j(sym(here.left), λ a _ => r.profile.read(r.profile.store(m, next_rip(a, k), [byte]), next_rip(spans.at(c), j)) =
                    r.profile.read(m, next_rip(spans.at(c), j)),
                j(sym(there.left), λ y _ => r.profile.read(r.profile.store(m, next_rip(next_rip(r.low, offset(b)), k), [byte]), next_rip(y, j)) =
                        r.profile.read(m, next_rip(y, j)),
                    r.store_apart(m, offset(b), k, [byte], offset(c), j, one, omega(short, there.right.right), order)))
        },
        keeps := λ m b k written inside byte j below => {
            let here = placed(b, omega(inside));
            let one: (offset(b) + k + 1 <= r.size) = omega(inside, here.right.right);
            j(sym(here.left), λ a _ => read_word(r.profile.data(), r.profile.store(m, next_rip(a, k), [byte]), next_rip(r.low, j)) =
                    read_word(r.profile.data(), m, next_rip(r.low, j)),
                read_word_agree(r.profile.data(), r.profile.store(m, next_rip(next_rip(r.low, offset(b)), k), [byte]), m, next_rip(r.low, j),
                    λ t within => r.store_apart(m, offset(b), k, [byte], j, t, one, omega(within, below, room),
                        Inr(omega(within, below, here.right.left)))))
        },
        keeps_code := λ m b k written inside byte bytes at resident => {
            let here = placed(b, omega(inside));
            j(sym(here.left), λ a _ => CodeResident(r.profile.fetch(), r.profile.store(m, next_rip(a, k), [byte]), bytes, at),
                r.byte_keeps_code(m, offset(b), k, byte, omega(inside, here.right.right), bytes, at, resident))
        },
    )
}

// Branch-span facts for physically linked x86 conditional blocks.

import x86_64_block;
import x86_64;
import bitvec;
import bool;
import logic;

record LinkedConditionalSpans<M>(block: LinkedConditionalBlock,
    before: MachineState<M>)
{
    true_reaches_join:
        linked_test_after(block, before).flags.zf = False →
        linked_true_jump_after(block, before).rip =
            linked_join_start(block, before.rip),
    false_reaches_join:
        linked_test_after(block, before).flags.zf = True →
        linked_false_after(block, before).rip =
            linked_join_start(block, before.rip),
}

theorem linked_conditional_reaches_join<M>(block: LinkedConditionalBlock,
    before: MachineState<M>,
    spans: LinkedConditionalSpans<M>(block, before)):
    linked_conditional_after(block, before).rip =
        linked_join_start(block, before.rip)
{
    trans(linked_conditional_rip(block, before),
      selected_rip_reaches(
        linked_test_after(block, before).flags.zf,
        linked_true_jump_after(block, before).rip,
        linked_false_after(block, before).rip,
        linked_join_start(block, before.rip),
        λ selected => spans.true_reaches_join(selected),
        λ selected => spans.false_reaches_join(selected)))
}

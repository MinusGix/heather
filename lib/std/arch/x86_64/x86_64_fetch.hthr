// Exact instruction-span fetch from a supplied memory and access policy.
// This is an adapter to the canonical x86 decoder/execution relation, not a
// loader or a second machine semantics. Addresses advance without wrapping.
import x86_64;
import bitvec;
import bool;
import nat;
import option;
import list;
import logic;
import relation;

record FetchAccess<M> {
    read_byte: M → BitVec(64) → Option<BitVec(8)>,
    executable: M → BitVec(64) → Bool,
}

inductive InstructionFetch {
    FetchedBytes(bytes: List<BitVec(8)>),
    FetchDenied(address: BitVec(64)),
    FetchMissing(address: BitVec(64)),
    FetchAddressWrap,
}

fn prepend_fetched(byte: BitVec(8), rest: InstructionFetch) → InstructionFetch {
    match rest {
        FetchedBytes(bytes) => FetchedBytes(Cons(byte, bytes)),
        FetchDenied(address) => FetchDenied(address),
        FetchMissing(address) => FetchMissing(address),
        FetchAddressWrap => FetchAddressWrap,
    }
}

// A shared decision boundary lets certificates compose independently checked
// byte reads without reducing a complete instruction span in one proof.
fn fetch_with_byte(start: BitVec(64), allowed: Bool, read: Option<BitVec(8)>,
    continuation: BitVec(8) → InstructionFetch) → InstructionFetch
{
    match allowed {
        False => FetchDenied(start),
        True => match read {
            None => FetchMissing(start),
            Some(byte) => continuation(byte),
        },
    }
}

theorem fetch_with_byte_success(start: BitVec(64), allowed: Bool,
    read: Option<BitVec(8)>, continuation: BitVec(8) → InstructionFetch,
    byte: BitVec(8), permission: allowed = True, present: read = Some(byte)):
    fetch_with_byte(start, allowed, read, continuation) = continuation(byte)
{
    trans(cong_fn<Bool, InstructionFetch>(λ actual => fetch_with_byte(start, actual, read, continuation), permission),
        cong_fn<Option<BitVec(8)>, InstructionFetch>(λ actual => fetch_with_byte(start, True, actual, continuation), present))
}

// The caller supplies the exact span length. This does not speculatively read
// 15 bytes across a page boundary. DecodedAt separately validates the length
// and encoding. Permission is checked before reading each requested byte.
fn fetch_instruction_bytes<M>(access: FetchAccess<M>, memory: M, count: Nat) →
    BitVec(64) → InstructionFetch
{
    match count {
        Zero => start ⊢ FetchedBytes(Nil),
        Succ(rest, ih) => start ⊢ fetch_with_byte(start,
            access.executable(memory, start), access.read_byte(memory, start),
            λ byte => match rest {
                Zero => FetchedBytes(Cons(byte, Nil)),
                Succ(_) => match start.carry_add_bit(BitVec::ofNat(1)) {
                    True => FetchAddressWrap,
                    False => prepend_fetched(byte, ih(next_rip(start, 1))),
                },
            }),
    }
}

// A structural witness keeps individual reads explicit. Its correspondence
// with the executable reader is proved below; composing witnesses does not
// normalize the entire fetch merely to compare equality propositions.
fn ReadableBytes<M>(access: FetchAccess<M>, memory: M, bytes: List<BitVec(8)>) →
    BitVec(64) → Type
{
    match bytes {
        Nil => start ⊢ True,
        Cons(byte, rest) => start ⊢
            access.executable(memory, start) = True ∧
            access.read_byte(memory, start) = Some(byte) ∧
            match rest as λ remaining => Type {
                Nil => True,
                Cons(_, _) => start.carry_add_bit(BitVec::ofNat(1)) = False ∧
                    ReadableBytes(access, memory, rest, next_rip(start, 1)),
            },
    }
}

record FetchedFrom<M>(access: FetchAccess<M>, memory: M, span: InstructionBytes) {
    reads: ReadableBytes(access, memory, span.bytes, span.start),
}

theorem readable_tail<M>(access: FetchAccess<M>, memory: M, start: BitVec(64),
    byte: BitVec(8), rest: List<BitVec(8)>,
    reads: ReadableBytes(access, memory, Cons(byte, rest), start)):
    ReadableBytes(access, memory, rest, next_rip(start, 1)) {
    match rest {
        Nil => trivial,
        Cons(_, _) => reads.right.right.right,
    }
}

theorem readable_head_same<M>(access: FetchAccess<M>, memory: M, start: BitVec(64),
    left, right: BitVec(8), left_tail, right_tail: List<BitVec(8)>,
    first: ReadableBytes(access, memory, Cons(left, left_tail), start),
    second: ReadableBytes(access, memory, Cons(right, right_tail), start)):
    left = right {
    Option::some_inj(left, right, trans(sym(first.right.left), second.right.left))
}

// Memory comes from the same before-state used by ExecuteAt. Fetch failure,
// unsupported decoding, and architectural execution outcomes remain distinct.
fn ExecuteFetched<M>(access: FetchAccess<M>, span: InstructionBytes,
    decoded: DecodedInstruction, before: MachineState<M>,
    outcome: SemanticOutcome<MachineState<M>, Exception>) → Type
{
    FetchedFrom(access, before.memory, span) ∧ ExecuteAt(span, decoded, before, outcome)
}

theorem execute_fetched_from_execute_at<M>(access: FetchAccess<M>,
    span: InstructionBytes, decoded: DecodedInstruction, before: MachineState<M>,
    outcome: SemanticOutcome<MachineState<M>, Exception>,
    fetched: FetchedFrom(access, before.memory, span),
    execution: ExecuteAt(span, decoded, before, outcome)):
    ExecuteFetched(access, span, decoded, before, outcome)
{ ⟨fetched, execution⟩ }

theorem fetch_one_byte<M>(access: FetchAccess<M>, memory: M, start: BitVec(64),
    byte: BitVec(8), permission: access.executable(memory, start) = True,
    present: access.read_byte(memory, start) = Some(byte)):
    fetch_instruction_bytes(access, memory, 1, start) = FetchedBytes([byte])
{
    fetch_with_byte_success(start, access.executable(memory, start),
        access.read_byte(memory, start), λ found => FetchedBytes([found]),
        byte, permission, present)
}

theorem fetch_more_bytes<M>(access: FetchAccess<M>, memory: M, start: BitVec(64),
    byte: BitVec(8), rest_count: Nat, rest: List<BitVec(8)>,
    permission: access.executable(memory, start) = True,
    present: access.read_byte(memory, start) = Some(byte),
    no_wrap: start.carry_add_bit(BitVec::ofNat(1)) = False,
    tail: fetch_instruction_bytes(access, memory, rest_count + 1, next_rip(start, 1))
        = FetchedBytes(rest)):
    fetch_instruction_bytes(access, memory, rest_count + 2, start)
        = FetchedBytes(Cons(byte, rest))
{
    trans(fetch_with_byte_success(start, access.executable(memory, start),
        access.read_byte(memory, start), λ found =>
            match start.carry_add_bit(BitVec::ofNat(1)) {
                True => FetchAddressWrap,
                False => prepend_fetched(found,
                    fetch_instruction_bytes(access, memory, rest_count + 1, next_rip(start, 1))),
            }, byte, permission, present),
        trans(cong_fn<Bool, InstructionFetch>(λ carry => match carry {
            True => FetchAddressWrap,
            False => prepend_fetched(byte,
                fetch_instruction_bytes(access, memory, rest_count + 1, next_rip(start, 1))),
        }, no_wrap), cong_fn<InstructionFetch, InstructionFetch>(λ fetched => prepend_fetched(byte, fetched), tail)))
}

// Name the next address explicitly, with a checked advancement equation.
// This keeps a tail certificate's statement identical at its definition and
// use sites instead of normalizing its memory reads to compare two addresses.
theorem fetch_span_more<M>(access: FetchAccess<M>, memory: M,
    start, next_start: BitVec(64), byte, next_byte: BitVec(8), rest: List<BitVec(8)>,
    permission: access.executable(memory, start) = True,
    present: access.read_byte(memory, start) = Some(byte),
    no_wrap: start.carry_add_bit(BitVec::ofNat(1)) = False,
    next_correct: next_rip(start, 1) = next_start,
    tail: FetchedFrom(access, memory, InstructionBytes(next_start, Cons(next_byte, rest)))):
    FetchedFrom(access, memory, InstructionBytes(start, Cons(byte, Cons(next_byte, rest))))
{
    FetchedFrom(⟨permission, ⟨present, ⟨no_wrap,
        j(sym(next_correct), λ address _ =>
            ReadableBytes(access, memory, Cons(next_byte, rest), address), tail.reads)⟩⟩⟩)
}

theorem fetch_span_one<M>(access: FetchAccess<M>, memory: M, start: BitVec(64),
    byte: BitVec(8), permission: access.executable(memory, start) = True,
    present: access.read_byte(memory, start) = Some(byte)):
    FetchedFrom(access, memory, InstructionBytes(start, [byte]))
{
    FetchedFrom(⟨permission, ⟨present, trivial⟩⟩)
}

theorem readable_cons_fetch<M>(access: FetchAccess<M>, memory: M,
    byte: BitVec(8), rest: List<BitVec(8)>):
    ((start: BitVec(64)) → ReadableBytes(access, memory, rest, start) →
        fetch_instruction_bytes(access, memory, rest.len(), start) = FetchedBytes(rest)) →
    (start: BitVec(64)) → ReadableBytes(access, memory, Cons(byte, rest), start) →
        fetch_instruction_bytes(access, memory, Cons(byte, rest).len(), start)
            = FetchedBytes(Cons(byte, rest))
{
    match rest {
        Nil => tail_proof start evidence ⊢
            fetch_one_byte(access, memory, start, byte, evidence.left, evidence.right.left),
        Cons(next_byte, remaining) => tail_proof start evidence ⊢
            fetch_more_bytes(access, memory, start, byte, remaining.len(), Cons(next_byte, remaining),
                evidence.left, evidence.right.left, evidence.right.right.left,
                tail_proof(next_rip(start, 1), evidence.right.right.right)),
    }
}

theorem readable_bytes_fetch<M>(access: FetchAccess<M>, memory: M,
    bytes: List<BitVec(8)>): (start: BitVec(64)) → ReadableBytes(access, memory, bytes, start) →
    fetch_instruction_bytes(access, memory, bytes.len(), start) = FetchedBytes(bytes)
{
    match bytes {
        Nil => start evidence ⊢ refl,
        Cons(byte, rest) => readable_cons_fetch(access, memory, byte, rest,
            readable_bytes_fetch(access, memory, rest)),
    }
}

theorem fetched_result<M>(access: FetchAccess<M>, memory: M, span: InstructionBytes,
    certificate: FetchedFrom(access, memory, span)):
    fetch_instruction_bytes(access, memory, span.bytes.len(), span.start) = FetchedBytes(span.bytes)
{
    readable_bytes_fetch(access, memory, span.bytes, span.start, certificate.reads)
}

// Fetching a fixed number of bytes from one memory and address has one result.
// This is the byte-level premise of uniqueness for emitted instructions.
theorem fetched_bytes_same_length<M>(access: FetchAccess<M>, memory: M,
    start: BitVec(64), left, right: List<BitVec(8)>,
    left_read: FetchedFrom(access, memory, InstructionBytes(start, left)),
    right_read: FetchedFrom(access, memory, InstructionBytes(start, right)),
    length: left.len() = right.len()): left = right {
    let first = fetched_result(access, memory, InstructionBytes(start, left), left_read);
    let second = fetched_result(access, memory, InstructionBytes(start, right), right_read);
    let equal_fetches: (FetchedBytes(left) = FetchedBytes(right)) =
        trans(sym(first),
            trans(cong_fn(λ count => fetch_instruction_bytes(access, memory, count, start), length), second));
    Option::some_inj(left, right,
        cong_fn(λ result => match result {
            FetchedBytes(bytes) => Some(bytes),
            FetchDenied(_) => None<List<BitVec(8)>>,
            FetchMissing(_) => None<List<BitVec(8)>>,
            FetchAddressWrap => None<List<BitVec(8)>>,
        }, equal_fetches))
}

theorem fetched_bytes_same_length_related<M>(access: FetchAccess<M>,
    before_left, before_right: MachineState<M>,
    same: SameDefinedState<M>(before_left, before_right),
    left, right: List<BitVec(8)>,
    left_read: FetchedFrom(access, before_left.memory, InstructionBytes(before_left.rip, left)),
    right_read: FetchedFrom(access, before_right.memory, InstructionBytes(before_right.rip, right)),
    length: left.len() = right.len()): left = right {
    let first = fetched_result(access, before_left.memory,
        InstructionBytes(before_left.rip, left), left_read);
    let second = fetched_result(access, before_right.memory,
        InstructionBytes(before_right.rip, right), right_read);
    let same_fetch = trans(
        cong_fn(λ (memory: M) => fetch_instruction_bytes(access, memory, left.len(), before_left.rip),
            SameDefinedState::memory(same)),
        trans(cong_fn(λ (start: BitVec(64)) => fetch_instruction_bytes(access, before_right.memory,
                left.len(), start), SameDefinedState::rip(same)),
            cong_fn(λ (count: Nat) => fetch_instruction_bytes(access, before_right.memory,
                count, before_right.rip), length)));
    Option::some_inj(left, right,
        cong_fn(λ result => match result {
            FetchedBytes(bytes) => Some(bytes),
            FetchDenied(_) => None<List<BitVec(8)>>,
            FetchMissing(_) => None<List<BitVec(8)>>,
            FetchAddressWrap => None<List<BitVec(8)>>,
        }, trans(sym(first), trans(same_fetch, second))))
}

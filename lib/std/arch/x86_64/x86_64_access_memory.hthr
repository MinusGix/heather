import x86_64;
import x86_64_block;
import x86_64_structured_block;
import x86_64_data_read;
import bitvec;
import bool;
import list;
import logic;
import nat;
import x86_64_access_code;

// Read-only effects are an intrinsic consequence of execution, not a caller
// promise. Pure leaves retain the existing evaluator unchanged.
theorem pure_block_memory<M>(instructions: List<Instruction>): (before: MachineState<M>) →
    execute_block_normal(instructions, before).memory = before.memory {
    match instructions {
        Nil => λ before => refl,
        Cons(instruction, rest) => λ before => pure_block_memory(rest, execute_normal(decoded_canonical(instruction), before)),
    }
}
theorem pure_structured_memory<M>(code: StructuredCode): (before: MachineState<M>) →
    structured_after(code, before).memory = before.memory {
    match code {
        CodeBlock(instructions) => pure_block_memory(instructions),
        CodeSequence(prefix, tail) => λ before => trans(pure_structured_memory(tail, structured_after(prefix, before)), pure_structured_memory(prefix, before)),
        CodeBranch(test, fd, jd, yes, no) => λ before =>
            structured_branch_property(test, fd, jd, yes, no, before, λ after => after.memory = before.memory,
                pure_structured_memory(yes, structured_branch_entry(test, fd, before)), pure_structured_memory(no, structured_branch_entry(test, fd, before))),
        CodeBranchNear(test, fd, jd, yes, no) => λ before =>
            structured_near_branch_property(test, fd, jd, yes, no, before, λ after => after.memory = before.memory,
                pure_structured_memory(yes, structured_near_entry(test, fd, before)), pure_structured_memory(no, structured_near_entry(test, fd, before))),
        CodeWhen(test, d, body) => λ before =>
            structured_when_property(test, d, body, before, λ after => after.memory = before.memory,
                pure_structured_memory(body, structured_branch_entry(test, d, before)), refl),
    }
}
// Memory through any number of iterations, from the children's own laws.
// Both edges are TEST and a jump, which touch neither memory nor registers.
theorem loop_runs_memory<M>(guard, body: MachineState<M> → MachineState<M> → Type, flag: Gpr,
    exit: BitVec(32), step: Gpr, back: BitVec(32),
    guard_memory: (before, after: MachineState<M>) → guard(before, after) → after.memory = before.memory,
    body_memory: (before, after: MachineState<M>) → body(before, after) → after.memory = before.memory):
    (n: Nat) → (before, after: MachineState<M>) → LoopRuns(guard, body, flag, exit, step, back, n, before, after) →
        after.memory = before.memory {
    λ n => match n as λ k => (before, after: MachineState<M>) → LoopRuns(guard, body, flag, exit, step, back, k, before, after) →
            after.memory = before.memory {
        Zero => λ before after runs => {
            let tested = runs.witness;
            let checked = guard_memory(before, tested, runs.proof.left);
            (match structured_test(flag, tested).flags.zf as λ zf =>
                (match zf {
                    True => after = loop_edge(flag, exit, tested),
                    False => Exists<MachineState<M>>(λ done => body(loop_edge(flag, exit, tested), done) ∧
                        ((structured_test(step, done).flags.zf = False) ∧ (after = loop_edge(step, back, done)))),
                }) → after.memory = before.memory {
                True => λ left => trans(j(sym(left), λ state _ => state.memory = tested.memory, refl), checked),
                False => λ stepped => trans(j(sym(stepped.proof.right.right), λ state _ => state.memory = tested.memory,
                    body_memory(loop_edge(flag, exit, tested), stepped.witness, stepped.proof.left)), checked),
            })(runs.proof.right)
        },
        Succ(k, ih) => λ before after runs => {
            let tested = runs.witness;
            let stepped = runs.proof.right.right;
            trans(ih(loop_edge(step, back, stepped.witness), after, stepped.proof.right.right),
                trans(body_memory(loop_edge(flag, exit, tested), stepped.witness, stepped.proof.left),
                    guard_memory(before, tested, runs.proof.left)))
        },
    }
}

theorem access_memory<M>(access: ByteReadAccess<M>, code: AccessCode):
    (before, after: MachineState<M>) → ExecuteAccess(access, code, before, after) → after.memory = before.memory {
    match code {
        AccessPure(pure) => λ before after step =>
            j(sym(step), λ state _ => state.memory = before.memory, pure_structured_memory(pure, before)),
        AccessRead(load) => λ before after step =>
            j(sym(step.proof.execution), λ state _ => state.memory = before.memory, refl),
        AccessSequence(prefix, tail) => λ before after step =>
            trans(access_memory(access, tail, step.witness, after, step.proof.right), access_memory(access, prefix, before, step.witness, step.proof.left)),
        AccessBranch(register, fd, jd, yes, no) => λ before after =>
            (match structured_test(register, before).flags.zf as λ flag =>
                (match flag {
                    False => Exists<MachineState<M>>(λ middle => ExecuteAccess(access, yes, structured_branch_entry(NonZero(register), fd, before), middle) ∧
                        (after = execute_short_control(Jump(jd), middle))),
                    True => ExecuteAccess(access, no, structured_branch_entry(NonZero(register), fd, before), after),
                }) → after.memory = before.memory {
                False => λ step => j(sym(step.proof.right), λ state _ => state.memory = before.memory,
                    access_memory(access, yes, structured_branch_entry(NonZero(register), fd, before), step.witness, step.proof.left)),
                True => λ step => access_memory(access, no, structured_branch_entry(NonZero(register), fd, before), after, step),
            }),
        AccessLoop(guard, flag, ed, body, step, bd) => λ before after runs =>
            loop_runs_memory(ExecuteAccess(access, guard), ExecuteAccess(access, body), flag, ed, step, bd,
                access_memory(access, guard), access_memory(access, body), runs.witness, before, after, runs.proof),
    }
}

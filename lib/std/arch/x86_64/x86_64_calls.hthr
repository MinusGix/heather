// Long-mode near CALL rel32 and RET, with explicit byte-memory access premises.
// Normal-path subset: low canonical addresses, no CET/shadow stack, no interrupts.
// Intel SDM Vol. 2, CALL and RET. Ordinary instructions reuse x86_64::Execute.
import x86_64;
import x86_64_fetch;
import bitvec;
import bool;
import list;
import logic;
import relation;

record StackAccess<M> {
    read: M → BitVec(64) → BitVec(8),
    write: M → BitVec(64) → BitVec(8) → M,
    readable: BitVec(64) → Bool,
    writable: BitVec(64) → Bool,
}

fn LowCanonical(address: BitVec(64)) → Type {
    address.drop_low(47, 17) = BitVec::zero()
}
fn word_bytes(value: BitVec(64)) → List<BitVec(8)> {
    [imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value),
     imm_byte4(value), imm_byte5(value), imm_byte6(value), imm_byte7(value)]
}
fn next_byte(address: BitVec(64)) → BitVec(64) { address.add(BitVec::ofNat(1)) }
fn StackReadsAllowed<M>(access: StackAccess<M>, count: Nat) → BitVec(64) → Type {
    match count {
        Zero => λ address => True,
        Succ(rest, ih) => λ address =>
            access.readable(address) = True ∧ LowCanonical(address) ∧
            address.carry_add_bit(BitVec::ofNat(1)) = False ∧
            ih(next_byte(address)),
    }
}
fn stack_word<M>(access: StackAccess<M>, memory: M, address: BitVec(64)) → BitVec(64) {
    immediate_from_bytes(access.read(memory, address),
        access.read(memory, address.add(BitVec::ofNat(1))),
        access.read(memory, address.add(BitVec::ofNat(2))),
        access.read(memory, address.add(BitVec::ofNat(3))),
        access.read(memory, address.add(BitVec::ofNat(4))),
        access.read(memory, address.add(BitVec::ofNat(5))),
        access.read(memory, address.add(BitVec::ofNat(6))),
        access.read(memory, address.add(BitVec::ofNat(7))))
}
fn word_write_0<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    memory
}
fn word_write_1<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_0(access, value, memory, address), address.add(BitVec::ofNat(0)), imm_byte0(value))
}
fn word_write_2<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_1(access, value, memory, address), address.add(BitVec::ofNat(1)), imm_byte1(value))
}
fn word_write_3<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_2(access, value, memory, address), address.add(BitVec::ofNat(2)), imm_byte2(value))
}
fn word_write_4<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_3(access, value, memory, address), address.add(BitVec::ofNat(3)), imm_byte3(value))
}
fn word_write_5<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_4(access, value, memory, address), address.add(BitVec::ofNat(4)), imm_byte4(value))
}
fn word_write_6<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_5(access, value, memory, address), address.add(BitVec::ofNat(5)), imm_byte5(value))
}
fn word_write_7<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_6(access, value, memory, address), address.add(BitVec::ofNat(6)), imm_byte6(value))
}
fn word_write_8<M>(access: StackAccess<M>, value: BitVec(64), memory: M, address: BitVec(64)) → M {
    access.write(word_write_7(access, value, memory, address), address.add(BitVec::ofNat(7)), imm_byte7(value))
}
record WordWritesAllowed<M>(access: StackAccess<M>, address: BitVec(64)) {
    canonical: LowCanonical(address),
    end_canonical: LowCanonical(address.add(BitVec::ofNat(7))),
    no_wrap: address.carry_add_bit(BitVec::ofNat(8)) = False,
    byte0: access.writable(address.add(BitVec::ofNat(0))) = True,
    byte1: access.writable(address.add(BitVec::ofNat(1))) = True,
    byte2: access.writable(address.add(BitVec::ofNat(2))) = True,
    byte3: access.writable(address.add(BitVec::ofNat(3))) = True,
    byte4: access.writable(address.add(BitVec::ofNat(4))) = True,
    byte5: access.writable(address.add(BitVec::ofNat(5))) = True,
    byte6: access.writable(address.add(BitVec::ofNat(6))) = True,
    byte7: access.writable(address.add(BitVec::ofNat(7))) = True,
}
fn call_return_address<M>(before: MachineState<M>) → BitVec(64) {
    before.rip.add(BitVec::ofNat(5))
}
fn call_target(start: BitVec(64), displacement: BitVec(32)) → BitVec(64) {
    start.add(BitVec::ofNat(5)).add(
        displacement.sign_extend(32))
}
fn call_after<M>(access: StackAccess<M>, displacement: BitVec(32), before: MachineState<M>) → MachineState<M> {
    let stack = read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8));
    MachineState(write_gpr(Rsp, stack, before.gprs), before.flags,
        call_target(before.rip, displacement),
        word_write_8(access, call_return_address(before), before.memory, stack))
}
fn return_after<M>(access: StackAccess<M>, before: MachineState<M>) → MachineState<M> {
    let stack = read_gpr(Rsp, before.gprs);
    MachineState(write_gpr(Rsp, stack.add(BitVec::ofNat(8)), before.gprs),
        before.flags, stack_word(access, before.memory, stack), before.memory)
}
fn stack_store_after<M>(access: StackAccess<M>, register: Gpr, before: MachineState<M>) → MachineState<M> {
    MachineState(before.gprs, before.flags, next_rip(before.rip, 4),
        word_write_8(access, read_gpr(register, before.gprs), before.memory, read_gpr(Rsp, before.gprs)))
}
fn stack_load_after<M>(access: StackAccess<M>, register: Gpr, before: MachineState<M>) → MachineState<M> {
    MachineState(write_gpr(register, stack_word(access, before.memory, read_gpr(Rsp, before.gprs)), before.gprs),
        before.flags, next_rip(before.rip, 4), before.memory)
}
fn stack_register_bytes(opcode: Nat, register: Gpr) → List<BitVec(8)> {
    [rex_w_rr(Rsp, register), BitVec::ofNat(opcode),
     byte_from_fields(False, False, True, gpr_bit0(register), gpr_bit1(register), gpr_bit2(register), False, False),
     BitVec::ofNat(0x24)]
}
inductive CallInstruction { Ordinary(instruction: Instruction), CallRelative(displacement: BitVec(32)), NearReturn, StoreStack64(register: Gpr), LoadStack64(register: Gpr) }
fn call_instruction_bytes(instruction: CallInstruction) → List<BitVec(8)> {
    match instruction {
        Ordinary(ordinary) => canonical_bytes(ordinary),
        CallRelative(displacement) => {
            let extended = displacement.zero_extend(32);
            [BitVec::ofNat(0xe8), imm_byte0(extended), imm_byte1(extended), imm_byte2(extended), imm_byte3(extended)]
        },
        NearReturn => [BitVec::ofNat(0xc3)],
        StoreStack64(register) => stack_register_bytes(0x89, register),
        LoadStack64(register) => stack_register_bytes(0x8b, register),
    }
}
fn CallStep<M>(access: StackAccess<M>, instruction: CallInstruction, before, after: MachineState<M>) → Type {
    match instruction {
        Ordinary(ordinary) => Execute(decoded_canonical(ordinary), before, Returned(after)),
        StoreStack64(register) => WordWritesAllowed<M>(access, read_gpr(Rsp, before.gprs)) ∧
            after = stack_store_after(access, register, before),
        LoadStack64(register) => StackReadsAllowed(access, 8, read_gpr(Rsp, before.gprs)) ∧
            after = stack_load_after(access, register, before),
        CallRelative(displacement) =>
            read_gpr(Rsp, before.gprs).borrow_sub_bit(BitVec::ofNat(8)) = False ∧
            LowCanonical(call_return_address(before)) ∧ LowCanonical(call_target(before.rip, displacement)) ∧
            WordWritesAllowed<M>(access,
                read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8))) ∧
            after = call_after(access, displacement, before),
        NearReturn =>
            read_gpr(Rsp, before.gprs).carry_add_bit(BitVec::ofNat(8)) = False ∧
            LowCanonical(stack_word(access, before.memory, read_gpr(Rsp, before.gprs))) ∧
            StackReadsAllowed(access, 8, read_gpr(Rsp, before.gprs)) ∧
            after = return_after(access, before),
    }
}
fn FetchedCallStep<M>(fetch: FetchAccess<M>, access: StackAccess<M>, instruction: CallInstruction,
    before, after: MachineState<M>) → Type {
    FetchedFrom(fetch, before.memory, InstructionBytes(before.rip, call_instruction_bytes(instruction))) ∧
    CallStep(access, instruction, before, after)
}
fn FetchedCallTrace<M>(fetch: FetchAccess<M>, access: StackAccess<M>, instructions: List<CallInstruction>) →
    MachineState<M> → MachineState<M> → Type {
    ExecuteSteps(λ instruction before after => FetchedCallStep(fetch, access, instruction, before, after), instructions)
}
theorem call_trace_cons<M>(fetch: FetchAccess<M>, access: StackAccess<M>, instruction: CallInstruction,
    rest: List<CallInstruction>, before, middle, after: MachineState<M>,
    head: FetchedCallStep(fetch, access, instruction, before, middle),
    tail: FetchedCallTrace(fetch, access, rest, middle, after)):
    FetchedCallTrace(fetch, access, Cons(instruction, rest), before, after)
{ ⟨middle, ⟨head, tail⟩⟩ }

theorem ordinary_call_step<M>(access: StackAccess<M>, instruction: Instruction,
    before, after: MachineState<M>, successor: after = execute_normal(decoded_canonical(instruction), before)):
    CallStep(access, Ordinary(instruction), before, after)
{
    j(sym(successor), λ state _ => CallStep(access, Ordinary(instruction), before, state),
        canonical_execute_normal_is_allowed(instruction, before))
}

theorem stack_reads_cons<M>(access: StackAccess<M>, count: Nat, address, next: BitVec(64),
    permission: access.readable(address) = True, canonical: LowCanonical(address),
    nowrap: address.carry_add_bit(BitVec::ofNat(1)) = False,
    advanced: next_byte(address) = next, tail: StackReadsAllowed(access, count, next)):
    StackReadsAllowed(access, Succ(count), address)
{
    ⟨permission, ⟨canonical, ⟨nowrap,
        j(sym(advanced), λ actual _ => StackReadsAllowed(access, count, actual), tail)⟩⟩⟩
}

theorem stack_reads_at<M>(access: StackAccess<M>, count: Nat,
    address, expected_address: BitVec(64), at: address = expected_address,
    allowed: StackReadsAllowed(access, count, address)):
    StackReadsAllowed(access, count, expected_address)
{ j(at, λ actual _ => StackReadsAllowed(access, count, actual), allowed) }

theorem machine_readdress<M>(state: MachineState<M>, address: BitVec(64), same: address = state.rip):
    MachineState(state.gprs, state.flags, address, state.memory) = state
{
    j(sym(same), λ actual _ => MachineState(state.gprs, state.flags, actual, state.memory) = state, refl)
}

theorem call_after_target<M>(access: StackAccess<M>, displacement: BitVec(32), before: MachineState<M>):
    call_after(access, displacement, before).rip = call_target(before.rip, displacement)
{ refl }
theorem return_after_target<M>(access: StackAccess<M>, before: MachineState<M>):
    return_after(access, before).rip = stack_word(access, before.memory, read_gpr(Rsp, before.gprs))
{ refl }

theorem call_after_rsp<M>(access: StackAccess<M>, displacement: BitVec(32), before: MachineState<M>):
    read_gpr(Rsp, call_after(access, displacement, before).gprs) =
        read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8))
{ read_gpr_after_write(Rsp, read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)), before.gprs) }
theorem return_after_rsp<M>(access: StackAccess<M>, before: MachineState<M>):
    read_gpr(Rsp, return_after(access, before).gprs) =
        read_gpr(Rsp, before.gprs).add(BitVec::ofNat(8))
{ read_gpr_after_write(Rsp, read_gpr(Rsp, before.gprs).add(BitVec::ofNat(8)), before.gprs) }
theorem word_writes_at<M>(access: StackAccess<M>,
    address, actual: BitVec(64), same: address = actual, allowed: WordWritesAllowed<M>(access, address)):
    WordWritesAllowed<M>(access, actual)
{ j(same, λ pointer _ => WordWritesAllowed<M>(access, pointer), allowed) }

theorem call_after_memory<M>(access: StackAccess<M>, displacement: BitVec(32), before: MachineState<M>):
    call_after(access, displacement, before).memory = word_write_8(access, call_return_address(before),
        before.memory, read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)))
{ refl }
theorem normal_memory<M>(instruction: Instruction, before: MachineState<M>):
    execute_normal(decoded_canonical(instruction), before).memory = before.memory
{ refl }
theorem return_memory<M>(access: StackAccess<M>, before: MachineState<M>):
    return_after(access, before).memory = before.memory
{ refl }
theorem machine_rebuild<M>(state: MachineState<M>, address: BitVec(64), memory: M,
    same_rip: address = state.rip, same_memory: memory = state.memory):
    MachineState(state.gprs, state.flags, address, memory) = state
{
    j(sym(same_memory), λ actual _ => MachineState(state.gprs, state.flags, address, actual) = state,
        machine_readdress(state, address, same_rip))
}

record StackWordReads<M>(access: StackAccess<M>, memory: M, address, value: BitVec(64)) {
    byte0: access.read(memory, address) = imm_byte0(value),
    byte1: access.read(memory, address.add(BitVec::ofNat(1))) = imm_byte1(value),
    byte2: access.read(memory, address.add(BitVec::ofNat(2))) = imm_byte2(value),
    byte3: access.read(memory, address.add(BitVec::ofNat(3))) = imm_byte3(value),
    byte4: access.read(memory, address.add(BitVec::ofNat(4))) = imm_byte4(value),
    byte5: access.read(memory, address.add(BitVec::ofNat(5))) = imm_byte5(value),
    byte6: access.read(memory, address.add(BitVec::ofNat(6))) = imm_byte6(value),
    byte7: access.read(memory, address.add(BitVec::ofNat(7))) = imm_byte7(value),
}
theorem stack_word_matches<M>(access: StackAccess<M>, memory: M, address, value: BitVec(64),
    reads: StackWordReads(access, memory, address, value)):
    stack_word(access, memory, address) = value
{
    trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(byte, access.read(memory, address.add(BitVec::ofNat(1))), access.read(memory, address.add(BitVec::ofNat(2))), access.read(memory, address.add(BitVec::ofNat(3))), access.read(memory, address.add(BitVec::ofNat(4))), access.read(memory, address.add(BitVec::ofNat(5))), access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte0),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), byte, access.read(memory, address.add(BitVec::ofNat(2))), access.read(memory, address.add(BitVec::ofNat(3))), access.read(memory, address.add(BitVec::ofNat(4))), access.read(memory, address.add(BitVec::ofNat(5))), access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte1),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), byte, access.read(memory, address.add(BitVec::ofNat(3))), access.read(memory, address.add(BitVec::ofNat(4))), access.read(memory, address.add(BitVec::ofNat(5))), access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte2),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), imm_byte2(value), byte, access.read(memory, address.add(BitVec::ofNat(4))), access.read(memory, address.add(BitVec::ofNat(5))), access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte3),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value), byte, access.read(memory, address.add(BitVec::ofNat(5))), access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte4),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value), imm_byte4(value), byte, access.read(memory, address.add(BitVec::ofNat(6))), access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte5),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value), imm_byte4(value), imm_byte5(value), byte, access.read(memory, address.add(BitVec::ofNat(7)))), reads.byte6),
        trans(cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(imm_byte0(value), imm_byte1(value), imm_byte2(value), imm_byte3(value), imm_byte4(value), imm_byte5(value), imm_byte6(value), byte), reads.byte7),
        immediate_bytes_roundtrip(value)))))))))
}

// A backward rel32 must not normalize addition by an enormous unsigned count.
// These laws keep the canonical modular-add semantics and certify the small
// subtraction used to calculate the proposed target.
theorem increments_decrement(n, count: Nat): (value: BitVec(n)) →
    value.decrement().iterate_increment(count) = value.iterate_increment(count).decrement()
{
    match count as λ steps => (value: BitVec(n)) →
        value.decrement().iterate_increment(steps) = value.iterate_increment(steps).decrement() {
        Zero => λ value => refl,
        Succ(steps, ih) => λ value => trans(BitVec::cong_increment(n, ih(value)),
            trans(BitVec::increment_decrement(n, value.iterate_increment(steps)),
                sym(BitVec::decrement_increment(n, value.iterate_increment(steps))))),
    }
}
theorem increments_decrements(n, downs, ups: Nat): (value: BitVec(n)) →
    value.iterate_decrement(downs).iterate_increment(ups) =
        value.iterate_increment(ups).iterate_decrement(downs)
{
    match downs as λ steps => (value: BitVec(n)) →
        value.iterate_decrement(steps).iterate_increment(ups) =
            value.iterate_increment(ups).iterate_decrement(steps) {
        Zero => λ value => refl,
        Succ(steps, ih) => λ value => trans(ih(value.decrement()),
            BitVec::cong_iterate_decrement(n, steps, increments_decrement(n, ups, value))),
    }
}
theorem add_negative(n: Nat, value, magnitude: BitVec(n)):
    value.add(BitVec::sub(BitVec::zero(), magnitude)) = BitVec::sub(value, magnitude)
{
    // `add` and `sub` are the ripples now, so the increment/decrement
    // bookkeeping below is stated over `iter_add`/`iter_sub` and transported
    // back (docs/bitvec-width-bounded-defaults-design.md).
    trans(BitVec::cong_ripple_add(n, refl, sym(BitVec::iter_sub_eq_sub(n, BitVec::zero(), magnitude)),
            a := value, b := value,
            c := BitVec::sub(BitVec::zero(), magnitude), d := BitVec::iter_sub(BitVec::zero(), magnitude)),
        trans(sym(BitVec::iter_add_eq_add(n, value, BitVec::iter_sub(BitVec::zero(), magnitude))),
            trans(trans(BitVec::iter_add_comm(n, value, BitVec::iter_sub(BitVec::zero(), magnitude)),
                    trans(increments_decrements(n, magnitude.toNat(),
                            value.toNat(), BitVec::zero()),
                        BitVec::cong_iterate_decrement(n, magnitude.toNat(),
                            BitVec::iterate_increment_toNat(n, value)))),
                BitVec::iter_sub_eq_sub(n, value, magnitude))))
}

theorem call_after_flat<M>(access: StackAccess<M>, displacement: BitVec(32), before: MachineState<M>,
    pointer, rip: BitVec(64), memory: M,
    pointer_same: pointer = read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)),
    rip_same: rip = call_target(before.rip, displacement),
    memory_same: memory = word_write_8(access, call_return_address(before), before.memory,
        read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)))):
    MachineState(write_gpr(Rsp, pointer, before.gprs), before.flags, rip, memory) = call_after(access, displacement, before)
{
    j(sym(pointer_same), λ actual _ => MachineState(write_gpr(Rsp, actual, before.gprs), before.flags, rip, memory) = call_after(access, displacement, before),
      j(sym(rip_same), λ actual _ => MachineState(write_gpr(Rsp, read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)), before.gprs), before.flags, actual, memory) = call_after(access, displacement, before),
        j(sym(memory_same), λ actual _ => MachineState(write_gpr(Rsp, read_gpr(Rsp, before.gprs).sub(BitVec::ofNat(8)), before.gprs), before.flags, call_target(before.rip, displacement), actual) = call_after(access, displacement, before), refl)))
}
theorem return_after_flat<M>(access: StackAccess<M>, before: MachineState<M>, pointer, rip: BitVec(64),
    pointer_same: pointer = read_gpr(Rsp, before.gprs).add(BitVec::ofNat(8)),
    rip_same: rip = stack_word(access, before.memory, read_gpr(Rsp, before.gprs))):
    MachineState(write_gpr(Rsp, pointer, before.gprs), before.flags, rip, before.memory) = return_after(access, before)
{
    j(sym(pointer_same), λ actual _ => MachineState(write_gpr(Rsp, actual, before.gprs), before.flags, rip, before.memory) = return_after(access, before),
      j(sym(rip_same), λ actual _ => MachineState(write_gpr(Rsp, read_gpr(Rsp, before.gprs).add(BitVec::ofNat(8)), before.gprs), before.flags, actual, before.memory) = return_after(access, before), refl))
}

theorem stack_store_memory<M>(access: StackAccess<M>, register: Gpr, before: MachineState<M>):
    stack_store_after(access, register, before).memory =
        word_write_8(access, read_gpr(register, before.gprs), before.memory, read_gpr(Rsp, before.gprs)) { refl }
theorem stack_load_flat<M>(access: StackAccess<M>, register: Gpr, before: MachineState<M>,
    value, rip: BitVec(64), value_same: value = stack_word(access, before.memory, read_gpr(Rsp, before.gprs)),
    rip_same: rip = next_rip(before.rip, 4)):
    MachineState(write_gpr(register, value, before.gprs), before.flags, rip, before.memory) = stack_load_after(access, register, before) {
    j(sym(value_same), λ actual _ => MachineState(write_gpr(register, actual, before.gprs), before.flags, rip, before.memory) = stack_load_after(access, register, before),
        j(sym(rip_same), λ actual _ => MachineState(write_gpr(register, stack_word(access, before.memory, read_gpr(Rsp, before.gprs)), before.gprs), before.flags, actual, before.memory) = stack_load_after(access, register, before), refl))
}

theorem xor_r11_preserves_rax<M>(before: MachineState<M>):
    read_gpr(Rax, execute_normal(decoded_canonical(XorRR(R11, R11)), before).gprs) = read_gpr(Rax, before.gprs) { refl }

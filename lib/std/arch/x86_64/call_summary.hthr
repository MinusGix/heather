    advanced: address = next_rip(before.rip, decoded_canonical(OrRR(destination, source)).length)):
    MachineState(write_gpr(destination, bitvec::bor(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), logic_flags(bitvec::bor(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs))), address, before.memory) = execute_normal(decoded_canonical(OrRR(destination, source)), before) {
    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, bitvec::bor(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), logic_flags(bitvec::bor(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs))), address, before.memory) = execute_normal(decoded_canonical(OrRR(destination, source)), before), refl)

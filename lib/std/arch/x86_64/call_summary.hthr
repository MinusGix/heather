    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, bitvec::sub(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), sub_flags(read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), address, before.memory) = execute_normal(decoded_canonical(SubRR(destination, source)), before), refl)
}

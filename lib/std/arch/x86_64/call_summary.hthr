    advanced: address = next_rip(before.rip, decoded_canonical(AndRR(destination, source)).length)):
    MachineState(write_gpr(destination, bitvec::band(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), logic_flags(bitvec::band(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs))), address, before.memory) = execute_normal(decoded_canonical(AndRR(destination, source)), before) {
    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, bitvec::band(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), logic_flags(bitvec::band(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs))), address, before.memory) = execute_normal(decoded_canonical(AndRR(destination, source)), before), refl)
}

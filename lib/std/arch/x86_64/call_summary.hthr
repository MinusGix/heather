// Reusable execution summaries. The code and postcondition are part of the
// summary's type; each placement still supplies actual fetch/access evidence.
import x86_64;
import x86_64_calls;
import x86_64_fetch;
import bitvec;
import bool;
import list;
import logic;
import relation;

theorem read_gpr_after_other_write(query, register: Gpr, value: BitVec(64), registers: Gprs,
    different: nat_same(gpr_index(register), gpr_index(query)) = False):
    read_gpr(query, write_gpr(register, value, registers)) = read_gpr(query, registers) {
    j(sym(different), λ decision _ =>
        (match decision { False => read_gpr(query, registers), True => value }) = read_gpr(query, registers), refl)
}

// Check each ordinary field layout over an arbitrary state once.
theorem call_mov_rr_flat<M>(destination, source: Gpr, before: MachineState<M>, address: BitVec(64),
    advanced: address = next_rip(before.rip, decoded_canonical(MovRR(destination, source)).length)):
    MachineState(write_gpr(destination, read_gpr(source, before.gprs), before.gprs), before.flags, address, before.memory) = execute_normal(decoded_canonical(MovRR(destination, source)), before) {
    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, read_gpr(source, before.gprs), before.gprs), before.flags, address, before.memory) = execute_normal(decoded_canonical(MovRR(destination, source)), before), refl)
}
theorem call_mov_ri_flat<M>(destination: Gpr, immediate: BitVec(64), before: MachineState<M>, address: BitVec(64),
    advanced: address = next_rip(before.rip, decoded_canonical(MovRI(destination, immediate)).length)):
    MachineState(write_gpr(destination, immediate, before.gprs), before.flags, address, before.memory) = execute_normal(decoded_canonical(MovRI(destination, immediate)), before) {
    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, immediate, before.gprs), before.flags, address, before.memory) = execute_normal(decoded_canonical(MovRI(destination, immediate)), before), refl)
}
theorem call_add_rr_flat<M>(destination, source: Gpr, before: MachineState<M>, address: BitVec(64),
    advanced: address = next_rip(before.rip, decoded_canonical(AddRR(destination, source)).length)):
    MachineState(write_gpr(destination, bitvec::add(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), add_flags(read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), address, before.memory) = execute_normal(decoded_canonical(AddRR(destination, source)), before) {
    j(sym(advanced), λ address _ => MachineState(write_gpr(destination, bitvec::add(64, read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), before.gprs), add_flags(read_gpr(destination, before.gprs), read_gpr(source, before.gprs)), address, before.memory) = execute_normal(decoded_canonical(AddRR(destination, source)), before), refl)
}

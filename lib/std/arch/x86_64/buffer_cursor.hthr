// Restricted read-only buffer instruction boundary. MOVZX is the REX.W
// 0F B6 /r form with ModRM/SIB [RDI + RDX], destination RDI. JNB is 73 cb.
// Intel SDM vol. 2B, MOVZX; vol. 2A, Jcc. No faults, segments, or concurrent
// mutation: readable low-canonical nonwrapping addresses are explicit premises.
import x86_64;
import x86_64_block;
import x86_64_calls;
import byte_cursor;
import bitvec;
import bool;
import list;
import logic;
import nat;

record BufferAccess<M> {
    read: M -> BitVec(64) -> BitVec(8),
    readable: BitVec(64) -> Bool,
}

fn byte_address<M>(before: MachineState<M>) -> BitVec(64) {
    bitvec::add(64, read_gpr(Rdi, before.gprs), read_gpr(Rdx, before.gprs))
}
record ByteReadAllowed<M>(access: BufferAccess<M>, before: MachineState<M>) {
    canonical: LowCanonical(byte_address(before)),
    no_wrap: bitvec::carry_add_bit(64, read_gpr(Rdi, before.gprs), read_gpr(Rdx, before.gprs)) = False,
    readable: access.readable(byte_address(before)) = True,
}
fn load_cursor_byte_bytes() -> List<BitVec(8)> {
    [bitvec::ofNat(8, 0x48), bitvec::ofNat(8, 0x0f), bitvec::ofNat(8, 0xb6),
     bitvec::ofNat(8, 0x3c), bitvec::ofNat(8, 0x17)]
}
fn load_cursor_byte<M>(access: BufferAccess<M>, before: MachineState<M>) -> MachineState<M> {
    MachineState(write_gpr(Rdi, bitvec::zero_extend(8, 56,
        access.read(before.memory, byte_address(before))), before.gprs),
        before.flags, next_rip(before.rip, 5), before.memory)
}
fn ExecuteCursorLoad<M>(access: BufferAccess<M>, before, after: MachineState<M>) -> Type {
    ByteReadAllowed<M>(access, before) ∧ after = load_cursor_byte(access, before)
}
fn jump_not_below_bytes(displacement: BitVec(8)) -> List<BitVec(8)> {
    [bitvec::ofNat(8, 0x73), displacement]
}
fn jump_not_below<M>(displacement: BitVec(8), before: MachineState<M>) -> MachineState<M> {
    with_rip(before, match before.flags.cf {
        False => short_branch_target(before.rip, displacement),
        True => next_rip(before.rip, 2),
    })
}
fn cursor_guard() -> List<Instruction> { [CmpRR(Rdx, Rsi)] }
fn cursor_prepare() -> List<Instruction> { [MovRR(Rsi, Rdx)] }
fn cursor_test() -> List<Instruction> { [TestRR(Rax, Rax)] }
fn cursor_hit() -> List<Instruction> {
    [MovRI(Rax, bitvec::ofNat(64, 0)), MovRI(Rcx, bitvec::ofNat(64, 1)), AddRR(Rdx, Rcx)]
}
fn cursor_miss() -> List<Instruction> { [MovRI(Rax, bitvec::ofNat(64, 1))] }
fn cursor_empty() -> List<Instruction> { [MovRI(Rax, bitvec::ofNat(64, 2))] }
fn cursor_observe<M>(state: MachineState<M>) -> CursorReply {
    CursorReply(read_gpr(Rax, state.gprs), read_gpr(Rdx, state.gprs))
}
fn classifier_accepts(value: BitVec(64)) -> Bool {
    is_zero_bits(64, bitvec::band(64, value, value))
}

// All addresses that the guard may expose are valid. No readable byte is
// required for the empty path, including an empty buffer at a null pointer.
fn BufferReadable<M>(access: BufferAccess<M>, before: MachineState<M>) -> Type {
    bitvec::unsigned_lt_bit(64, read_gpr(Rdx, before.gprs), read_gpr(Rsi, before.gprs)) = True ->
        ByteReadAllowed<M>(access, before)
}

theorem cursor_guard_condition<M>(before: MachineState<M>):
    (execute_block_normal(cursor_guard(), before)).flags.cf =
        bitvec::unsigned_lt_bit(64, read_gpr(Rdx, before.gprs), read_gpr(Rsi, before.gprs)) { refl }

theorem cursor_hit_observation<M>(before: MachineState<M>):
    cursor_observe(execute_block_normal(cursor_hit(), before)) =
        CursorReply(bitvec::ofNat(64, 0), bitvec::add(64, read_gpr(Rdx, before.gprs), bitvec::ofNat(64, 1))) { refl }

theorem cursor_miss_observation<M>(before: MachineState<M>):
    cursor_observe(execute_block_normal(cursor_miss(), before)) =
        CursorReply(bitvec::ofNat(64, 1), read_gpr(Rdx, before.gprs)) { refl }

theorem cursor_empty_observation<M>(before: MachineState<M>):
    cursor_observe(execute_block_normal(cursor_empty(), before)) =
        CursorReply(bitvec::ofNat(64, 2), read_gpr(Rdx, before.gprs)) { refl }

fn cursor_tail_test<M>(before: MachineState<M>) -> MachineState<M> {
    execute_block_normal(cursor_test(), before)
}
fn cursor_tail_branch_selected<M>(selected: Bool, before: MachineState<M>) -> MachineState<M> {
    with_rip(cursor_tail_test(before), jump_zero_rip(selected, (cursor_tail_test(before)).rip, bitvec::ofNat(8, 12)))
}
fn cursor_tail_selected<M>(selected: Bool, before: MachineState<M>) -> MachineState<M> {
    match selected {
        False => execute_short_control(Jump(bitvec::ofNat(8, 35)),
            execute_block_normal(cursor_miss(), cursor_tail_branch_selected(selected, before))),
        True => execute_short_control(Jump(bitvec::ofNat(8, 10)),
            execute_block_normal(cursor_hit(), cursor_tail_branch_selected(selected, before))),
    }
}

fn cursor_tail_branch<M>(before: MachineState<M>) -> MachineState<M> {
    cursor_tail_branch_selected((cursor_tail_test(before)).flags.zf, before)
}
fn cursor_tail<M>(before: MachineState<M>) -> MachineState<M> {
    cursor_tail_selected((cursor_tail_test(before)).flags.zf, before)
}
theorem cursor_tail_selected_observation<M>(selected: Bool, before: MachineState<M>):
    cursor_observe(cursor_tail_selected(selected, before)) =
        recognized(selected, read_gpr(Rdx, before.gprs)) {
    match selected { False => refl, True => refl }
}
theorem cursor_tail_observation<M>(before: MachineState<M>):
    cursor_observe(cursor_tail(before)) =
        recognized(classifier_accepts(read_gpr(Rax, before.gprs)), read_gpr(Rdx, before.gprs)) {
    cursor_tail_selected_observation(classifier_accepts(read_gpr(Rax, before.gprs)), before)
}
theorem cursor_tail_selected_memory<M>(selected: Bool, before: MachineState<M>):
    (cursor_tail_selected(selected, before)).memory = before.memory {
    match selected { False => refl, True => refl }
}
theorem cursor_tail_memory<M>(before: MachineState<M>):
    (cursor_tail(before)).memory = before.memory {
    cursor_tail_selected_memory(classifier_accepts(read_gpr(Rax, before.gprs)), before)
}

// Selection is factored over a neutral flag so proofs cover both paths without
// requiring the checker to evaluate a comparison on runtime input.
fn cursor_select<M>(selected: Bool, present, empty: MachineState<M>) -> MachineState<M> {
    match selected { False => empty, True => present }
}
theorem cursor_selection_observation<M>(selected: Bool, present, empty: MachineState<M>,
    wanted: CursorReply, cursor: BitVec(64),
    yes: cursor_observe(present) = wanted,
    no: cursor_observe(empty) = CursorReply(bitvec::ofNat(64, 2), cursor)):
    cursor_observe(cursor_select(selected, present, empty)) =
        match selected { False => CursorReply(bitvec::ofNat(64, 2), cursor), True => wanted } {
    match selected { False => no, True => yes }
}
theorem cursor_selection_preserves<M, A>(selected: Bool, present, empty: MachineState<M>,
    observe: MachineState<M> -> A, wanted: A,
    yes: observe(present) = wanted, no: observe(empty) = wanted):
    observe(cursor_select(selected, present, empty)) = wanted {
    match selected { False => no, True => yes }
}

theorem cursor_forward_target(start: BitVec(64), offset: Nat,
    displacement: BitVec(8), count: Nat,
    forward: bitvec::toNat(64, bitvec::sign_extend(7, 56, displacement)) = count):
    short_branch_target(next_rip(start, offset), displacement) =
        next_rip(start, (offset + 2) + count) {
    trans(sym(bitvec::iter_add_eq_add(64, next_rip(next_rip(start, offset), 2),
        bitvec::sign_extend(7, 56, displacement))),
        trans(bitvec::cong_iterate_increment_count(64, next_rip(next_rip(start, offset), 2), forward),
            trans(bitvec::cong_iterate_increment(64, count,
                bitvec::iterate_increment_compose(64, start, offset, 2)),
                bitvec::iterate_increment_compose(64, start, offset + 2, count))))
}

fn CursorTailProtected(register: Gpr) -> Type {
    match register { Rax => False, Rcx => False, Rdx => False, _ => True }
}
theorem cursor_tail_selected_register<M>(selected: Bool, before: MachineState<M>, register: Gpr):
    CursorTailProtected(register) ->
    read_gpr(register, (cursor_tail_selected(selected, before)).gprs) = read_gpr(register, before.gprs) {
    match selected {
        False => match register { Rax => p ⊢ false_elim(p), Rcx => p ⊢ false_elim(p), Rdx => p ⊢ false_elim(p), _ => p ⊢ refl },
        True => match register { Rax => p ⊢ false_elim(p), Rcx => p ⊢ false_elim(p), Rdx => p ⊢ false_elim(p), _ => p ⊢ refl },
    }
}
theorem cursor_tail_register<M>(before: MachineState<M>, register: Gpr, protected: CursorTailProtected(register)):
    read_gpr(register, (cursor_tail(before)).gprs) = read_gpr(register, before.gprs) {
    cursor_tail_selected_register(classifier_accepts(read_gpr(Rax, before.gprs)), before, register, protected)
}

fn CursorTailPath<M>(selected: Bool, before, after: MachineState<M>) -> Type {
    match selected {
        False => ExecuteBlock(cursor_miss(), cursor_tail_branch_selected(selected, before),
            execute_block_normal(cursor_miss(), cursor_tail_branch_selected(selected, before))) ∧
            ExecuteShortControl(Jump(bitvec::ofNat(8, 35)),
                execute_block_normal(cursor_miss(), cursor_tail_branch_selected(selected, before)), after),
        True => ExecuteBlock(cursor_hit(), cursor_tail_branch_selected(selected, before),
            execute_block_normal(cursor_hit(), cursor_tail_branch_selected(selected, before))) ∧
            ExecuteShortControl(Jump(bitvec::ofNat(8, 10)),
                execute_block_normal(cursor_hit(), cursor_tail_branch_selected(selected, before)), after),
    }
}
theorem cursor_tail_path<M>(selected: Bool, before: MachineState<M>):
    CursorTailPath(selected, before, cursor_tail_selected(selected, before)) {
    match selected {
        False => ⟨canonical_block_executes_normal(cursor_miss(), cursor_tail_branch_selected(False, before)), refl⟩,
        True => ⟨canonical_block_executes_normal(cursor_hit(), cursor_tail_branch_selected(True, before)), refl⟩,
    }
}
fn CursorTailTrace<M>(before, after: MachineState<M>) -> Type {
    ExecuteBlock(cursor_test(), before, cursor_tail_test(before)) ∧
    (ExecuteShortControl(JumpZero(bitvec::ofNat(8, 12)), cursor_tail_test(before), cursor_tail_branch(before)) ∧
    CursorTailPath((cursor_tail_test(before)).flags.zf, before, after))
}
theorem cursor_tail_trace<M>(before: MachineState<M>): CursorTailTrace(before, cursor_tail(before)) {
    ⟨canonical_block_executes_normal(cursor_test(), before),
        ⟨refl, cursor_tail_path((cursor_tail_test(before)).flags.zf, before)⟩⟩
}
fn cursor_guarded<M>(displacement: BitVec(8), before: MachineState<M>) -> MachineState<M> {
    jump_not_below(displacement, execute_block_normal(cursor_guard(), before))
}
fn cursor_body_entry<M>(access: BufferAccess<M>, displacement: BitVec(8), before: MachineState<M>) -> MachineState<M> {
    execute_block_normal(cursor_prepare(), load_cursor_byte(access, cursor_guarded(displacement, before)))
}

// Path-sensitive instruction execution: the sole memory-read premise occurs
// only on the in-bounds edge. Code fetch, host calling convention and RET retain
// the ordinary assembly export's external boundary.
record CursorExecution<M>(access: BufferAccess<M>, code: List<Instruction>,
    displacement: BitVec(8), before, after: MachineState<M>) {
    middle: MachineState<M>,
    guard: ExecuteBlock(cursor_guard(), before, execute_block_normal(cursor_guard(), before)),
    load: (selected: (execute_block_normal(cursor_guard(), before)).flags.cf = True) ->
        ExecuteCursorLoad(access, cursor_guarded(displacement, before),
            load_cursor_byte(access, cursor_guarded(displacement, before))),
    prepare: ExecuteBlock(cursor_prepare(), load_cursor_byte(access, cursor_guarded(displacement, before)),
        cursor_body_entry(access, displacement, before)),
    body: ExecuteBlock(code, cursor_body_entry(access, displacement, before), middle),
    tail: CursorTailTrace(middle, cursor_tail(middle)),
    empty: ExecuteBlock(cursor_empty(), cursor_guarded(displacement, before),
        execute_block_normal(cursor_empty(), cursor_guarded(displacement, before))),
    selected: after = cursor_select((execute_block_normal(cursor_guard(), before)).flags.cf,
        cursor_tail(middle), execute_block_normal(cursor_empty(), cursor_guarded(displacement, before))),
}

fn cursor_block_end(code: List<Instruction>) -> BitVec(64) -> BitVec(64) {
    match code {
        Nil => λ start => start,
        Cons(instruction, rest) => λ start => cursor_block_end(rest, next_rip(start, canonical_length(instruction))),
    }
}
theorem cursor_block_rip<M>(code: List<Instruction>): (before: MachineState<M>) ->
    (execute_block_normal(code, before)).rip = cursor_block_end(code, before.rip) {
    match code {
        Nil => before ⊢ refl,
        Cons(instruction, rest) => before ⊢ trans(
            cursor_block_rip(rest, execute_normal(decoded_canonical(instruction), before)),
            cong_fn<BitVec(64), BitVec(64)>(λ start => cursor_block_end(rest, start),
                execute_normal_advances_rip(decoded_canonical(instruction), before))),
    }
}
theorem cursor_miss_rip<M>(before: MachineState<M>):
    (execute_block_normal(cursor_miss(), before)).rip = next_rip(before.rip, 10) { refl }
theorem cursor_hit_rip<M>(before: MachineState<M>):
    (execute_block_normal(cursor_hit(), before)).rip = next_rip(before.rip, 23) {
    trans(cursor_block_rip(cursor_hit(), before),
        trans(bitvec::cong_iterate_increment(64, 3, bitvec::iterate_increment_compose(64, before.rip, 10, 10)),
            bitvec::iterate_increment_compose(64, before.rip, 20, 3)))
}
theorem cursor_true_branch_rip<M>(before: MachineState<M>):
    (cursor_tail_branch_selected(True, before)).rip = next_rip(before.rip, 17) {
    cursor_forward_target(before.rip, 3, bitvec::ofNat(8, 12), 12, refl)
}
theorem cursor_tail_false_rip<M>(before: MachineState<M>):
    (cursor_tail_selected(False, before)).rip = next_rip(before.rip, 52) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => short_branch_target(address, bitvec::ofNat(8, 35)),
        cursor_miss_rip(cursor_tail_branch_selected(False, before))),
        cursor_forward_target(before.rip, 15, bitvec::ofNat(8, 35), 35, refl))
}
theorem cursor_tail_true_rip<M>(before: MachineState<M>):
    (cursor_tail_selected(True, before)).rip = next_rip(before.rip, 52) {
    let advanced: ((execute_block_normal(cursor_hit(), cursor_tail_branch_selected(True, before))).rip = next_rip(before.rip, 40)) =
        trans(cursor_hit_rip(cursor_tail_branch_selected(True, before)),
            trans(bitvec::cong_iterate_increment(64, 23, cursor_true_branch_rip(before)),
                bitvec::iterate_increment_compose(64, before.rip, 17, 23)));
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => short_branch_target(address, bitvec::ofNat(8, 10)), advanced),
        cursor_forward_target(before.rip, 40, bitvec::ofNat(8, 10), 10, refl))
}
theorem cursor_tail_selected_rip<M>(selected: Bool, before: MachineState<M>):
    (cursor_tail_selected(selected, before)).rip = next_rip(before.rip, 52) {
    match selected {
        False => cursor_tail_false_rip(before),
        True => cursor_tail_true_rip(before),
    }
}
theorem cursor_tail_rip<M>(before: MachineState<M>):
    (cursor_tail(before)).rip = next_rip(before.rip, 52) {
    cursor_tail_selected_rip((cursor_tail_test(before)).flags.zf, before)
}
fn cursor_guarded_selected<M>(selected: Bool, displacement: BitVec(8), before: MachineState<M>) -> MachineState<M> {
    let guarded = execute_block_normal(cursor_guard(), before);
    with_rip(guarded, match selected {
        False => short_branch_target(guarded.rip, displacement),
        True => next_rip(guarded.rip, 2),
    })
}
theorem cursor_selection_guarded<M, A>(selected: Bool, present, empty: MachineState<M>,
    observe: MachineState<M> -> A, wanted: A):
    (selected = True -> observe(present) = wanted) ->
    (selected = False -> observe(empty) = wanted) ->
    observe(cursor_select(selected, present, empty)) = wanted {
    match selected { False => yes no ⊢ no(refl), True => yes no ⊢ yes(refl) }
}

fn cursor_ready_selected<M>(access: BufferAccess<M>, selected: Bool,
    displacement: BitVec(8), before: MachineState<M>) -> MachineState<M> {
    execute_block_normal(cursor_prepare(), load_cursor_byte(access,
        cursor_guarded_selected(selected, displacement, before)))
}
theorem cursor_guarded_true_rip<M>(displacement: BitVec(8), before: MachineState<M>):
    (cursor_guarded_selected(True, displacement, before)).rip = next_rip(before.rip, 5) {
    bitvec::iterate_increment_compose(64, before.rip, 3, 2)
}
theorem cursor_ready_true_rip<M>(access: BufferAccess<M>, displacement: BitVec(8), before: MachineState<M>):
    (cursor_ready_selected(access, True, displacement, before)).rip = next_rip(before.rip, 13) {
    trans(cursor_block_rip(cursor_prepare(), load_cursor_byte(access, cursor_guarded_selected(True, displacement, before))),
        trans(bitvec::cong_iterate_increment(64, 3,
            trans(bitvec::cong_iterate_increment(64, 5, cursor_guarded_true_rip(displacement, before)),
                bitvec::iterate_increment_compose(64, before.rip, 5, 5))),
            bitvec::iterate_increment_compose(64, before.rip, 10, 3)))
}

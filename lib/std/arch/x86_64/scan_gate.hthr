// One physical loop-head traversal, from the bounds CMP through MOVZX.
// Near branches use signed rel32 displacements. Fetch, faults, RET, and the
// full repeated-loop invariant are separate obligations.
import x86_64_scan_body;
import x86_64_buffer_cursor;
import x86_64_calls;
import x86_64;
import x86_64_block;
import bitvec;
import bool;
import logic;
import nat;
import list;

fn scan_address<M>(before: MachineState<M>) -> BitVec(64) {
    bitvec::add(64, read_gpr(R8, before.gprs), read_gpr(R10, before.gprs))
}
record ScanReadAllowed<M>(access: BufferAccess<M>, before: MachineState<M>) {
    canonical: LowCanonical(scan_address(before)),
    no_wrap: bitvec::carry_add_bit(64, read_gpr(R8, before.gprs), read_gpr(R10, before.gprs)) = False,
    readable: access.readable(scan_address(before)) = True,
}
fn scan_load<M>(access: BufferAccess<M>, before: MachineState<M>) -> MachineState<M> {
    MachineState(write_gpr(Rdi, bitvec::zero_extend(8, 56,
        access.read(before.memory, scan_address(before))), before.gprs),
        before.flags, next_rip(before.rip, 5), before.memory)
}
fn ExecuteScanLoad<M>(access: BufferAccess<M>, before, after: MachineState<M>) -> Type {
    ScanReadAllowed<M>(access, before) ∧ after = scan_load(access, before)
}
fn scan_near_rip(taken: Bool, displacement: BitVec(32), start: BitVec(64)) -> BitVec(64) {
    match taken {
        False => next_rip(start, 6),
        True => bitvec::add(64, next_rip(start, 6), bitvec::sign_extend(31, 32, displacement)),
    }
}
fn scan_near<M>(taken: Bool, displacement: BitVec(32), before: MachineState<M>) -> MachineState<M> {
    with_rip(before, scan_near_rip(taken, displacement, before.rip))
}
fn scan_bounds<M>(before: MachineState<M>) -> Bool {
    (execute_block_normal(scan_bounds_check(), before)).flags.cf
}
fn scan_empty_fuel<M>(before: MachineState<M>) -> Bool {
    (execute_block_normal(scan_fuel_check(), before)).flags.zf
}
theorem scan_bounds_word<M>(before: MachineState<M>):
    scan_bounds(before) = bitvec::unsigned_lt_bit(64, read_gpr(R10, before.gprs), read_gpr(R9, before.gprs)) { refl }
theorem scan_empty_fuel_word<M>(before: MachineState<M>):
    scan_empty_fuel(before) = is_zero_bits(64, read_gpr(R11, before.gprs)) {
    cong_fn<BitVec(64), Bool>(λ value => is_zero_bits(64, value),
        sym(bitvec::iter_sub_eq_sub(64, read_gpr(R11, before.gprs), bitvec::zero(64))))
}
fn scan_bounds_edge<M>(inside: Bool, done: BitVec(32), before: MachineState<M>) -> MachineState<M> {
    scan_near(bool::not(inside), done, execute_block_normal(scan_bounds_check(), before))
}
fn scan_fuel_edge<M>(empty: Bool, limit: BitVec(32), before: MachineState<M>) -> MachineState<M> {
    scan_near(empty, limit, execute_block_normal(scan_fuel_check(), before))
}

inductive ScanGate<M> {
    ScanEnd(MachineState<M>),
    ScanLimit(MachineState<M>),
    ScanReady(MachineState<M>),
}
fn scan_gate_selected<M>(access: BufferAccess<M>, inside, empty: Bool,
    done, limit: BitVec(32), before: MachineState<M>) -> ScanGate<M> {
    match inside {
        False => ScanEnd(scan_bounds_edge(False, done, before)),
        True => match empty {
            True => ScanLimit(scan_fuel_edge(True, limit, scan_bounds_edge(True, done, before))),
            False => ScanReady(scan_load(access, scan_fuel_edge(False, limit, scan_bounds_edge(True, done, before)))),
        },
    }
}
fn scan_gate<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>) -> ScanGate<M> {
    scan_gate_selected(access, scan_bounds(before), scan_empty_fuel(before), done, limit, before)
}

// Neither an exhausted cursor nor exhausted fuel asks the caller for a byte.
fn ScanGateReadable<M>(access: BufferAccess<M>, before: MachineState<M>) -> Type {
    scan_bounds(before) = True -> scan_empty_fuel(before) = False -> ScanReadAllowed<M>(access, before)
}
fn ScanGatePath<M>(access: BufferAccess<M>, inside, empty: Bool,
    done, limit: BitVec(32), before: MachineState<M>, after: ScanGate<M>) -> Type {
    match inside {
        False => after = ScanEnd(scan_bounds_edge(False, done, before)),
        True => {
            let bounded = scan_bounds_edge(True, done, before);
            ExecuteBlock(scan_fuel_check(), bounded, execute_block_normal(scan_fuel_check(), bounded)) ∧
            match empty as λ _ => Type {
                True => after = ScanLimit(scan_fuel_edge(True, limit, bounded)),
                False => ExecuteScanLoad(access, scan_fuel_edge(False, limit, bounded),
                    scan_load(access, scan_fuel_edge(False, limit, bounded))) ∧
                    after = ScanReady(scan_load(access, scan_fuel_edge(False, limit, bounded))),
            }
        },
    }
}
record ScanGateExecution<M>(access: BufferAccess<M>, done, limit: BitVec(32),
    before: MachineState<M>, after: ScanGate<M>) {
    guard: ExecuteBlock(scan_bounds_check(), before, execute_block_normal(scan_bounds_check(), before)),
    fuel_flag: scan_empty_fuel(scan_bounds_edge(True, done, before)) = scan_empty_fuel(before),
    path: ScanGatePath(access, scan_bounds(before), scan_empty_fuel(before), done, limit, before, after),
}
theorem scan_gate_selected_safe<M>(access: BufferAccess<M>, inside, empty: Bool,
    done, limit: BitVec(32), before: MachineState<M>):
    (inside = True -> empty = False -> ScanReadAllowed<M>(access, before)) ->
    ScanGatePath(access, inside, empty, done, limit, before,
        scan_gate_selected(access, inside, empty, done, limit, before)) {
    match inside {
        False => allowed ⊢ refl,
        True => match empty {
            True => allowed ⊢ ⟨canonical_block_executes_normal(scan_fuel_check(), scan_bounds_edge(True, done, before)), refl⟩,
            False => allowed ⊢ ⟨canonical_block_executes_normal(scan_fuel_check(), scan_bounds_edge(True, done, before)),
                ⟨⟨allowed(refl, refl), refl⟩, refl⟩⟩,
        },
    }
}
theorem scan_gate_safe<M>(access: BufferAccess<M>, done, limit: BitVec(32),
    before: MachineState<M>, allowed: ScanGateReadable(access, before)):
    ScanGateExecution<M>(access, done, limit, before, scan_gate(access, done, limit, before)) {
    ScanGateExecution(canonical_block_executes_normal(scan_bounds_check(), before), refl,
        scan_gate_selected_safe(access, scan_bounds(before), scan_empty_fuel(before), done, limit, before, allowed))
}

theorem scan_load_byte<M>(access: BufferAccess<M>, before: MachineState<M>):
    read_gpr(Rdi, (scan_load(access, before)).gprs) =
        bitvec::zero_extend(8, 56, access.read(before.memory, scan_address(before))) { refl }
theorem scan_ready_byte<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>):
    read_gpr(Rdi, (scan_load(access, scan_fuel_edge(False, limit, scan_bounds_edge(True, done, before)))).gprs) =
        bitvec::zero_extend(8, 56, access.read(before.memory, scan_address(before))) { refl }

fn scan_gate_state<M>(gate: ScanGate<M>) -> MachineState<M> {
    match gate { ScanEnd(state) => state, ScanLimit(state) => state, ScanReady(state) => state }
}
// Preserve loop state, memory, and callee-saved registers on all three paths.
// RDI is the loaded byte on Ready; RAX and flags are guard scratch.
fn ScanGateFrame<M>(before, after: MachineState<M>) -> Type {
    after.memory = before.memory ∧
    read_gpr(Rsi, after.gprs) = read_gpr(Rsi, before.gprs) ∧
    read_gpr(R8, after.gprs) = read_gpr(R8, before.gprs) ∧
    read_gpr(R9, after.gprs) = read_gpr(R9, before.gprs) ∧
    read_gpr(R10, after.gprs) = read_gpr(R10, before.gprs) ∧
    read_gpr(R11, after.gprs) = read_gpr(R11, before.gprs) ∧
    read_gpr(Rbx, after.gprs) = read_gpr(Rbx, before.gprs) ∧
    read_gpr(Rbp, after.gprs) = read_gpr(Rbp, before.gprs) ∧
    read_gpr(Rsp, after.gprs) = read_gpr(Rsp, before.gprs) ∧
    read_gpr(R12, after.gprs) = read_gpr(R12, before.gprs) ∧
    read_gpr(R13, after.gprs) = read_gpr(R13, before.gprs) ∧
    read_gpr(R14, after.gprs) = read_gpr(R14, before.gprs) ∧
    read_gpr(R15, after.gprs) = read_gpr(R15, before.gprs)
}
theorem scan_gate_selected_frame<M>(access: BufferAccess<M>, inside, empty: Bool,
    done, limit: BitVec(32), before: MachineState<M>):
    ScanGateFrame(before, scan_gate_state(scan_gate_selected(access, inside, empty, done, limit, before))) {
    match inside {
        False => ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩,
        True => match empty {
            True => ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩,
            False => ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩,
        },
    }
}
theorem scan_gate_frame<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>):
    ScanGateFrame(before, scan_gate_state(scan_gate(access, done, limit, before))) {
    scan_gate_selected_frame(access, scan_bounds(before), scan_empty_fuel(before), done, limit, before)
}

// RIP is accounted for by physical instruction lengths, not by assigning a
// desired absolute label to the output state.
theorem scan_bounds_fallthrough_rip<M>(done: BitVec(32), before: MachineState<M>):
    (scan_bounds_edge(True, done, before)).rip = next_rip(before.rip, 9) {
    bitvec::iterate_increment_compose(64, before.rip, 3, 6)
}
theorem scan_fuel_check_rip<M>(before: MachineState<M>):
    (execute_block_normal(scan_fuel_check(), before)).rip = next_rip(before.rip, 13) {
    bitvec::iterate_increment_compose(64, before.rip, 10, 3)
}
theorem scan_fuel_fallthrough_rip<M>(limit: BitVec(32), before: MachineState<M>):
    (scan_fuel_edge(False, limit, before)).rip = next_rip(before.rip, 19) {
    trans(bitvec::cong_iterate_increment(64, 6, scan_fuel_check_rip(before)),
        bitvec::iterate_increment_compose(64, before.rip, 13, 6))
}
theorem scan_ready_rip<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>):
    (scan_load(access, scan_fuel_edge(False, limit, scan_bounds_edge(True, done, before)))).rip =
        next_rip(before.rip, 33) {
    trans(bitvec::cong_iterate_increment(64, 5,
        trans(scan_fuel_fallthrough_rip(limit, scan_bounds_edge(True, done, before)),
            trans(bitvec::cong_iterate_increment(64, 19, scan_bounds_fallthrough_rip(done, before)),
                bitvec::iterate_increment_compose(64, before.rip, 9, 19)))),
        bitvec::iterate_increment_compose(64, before.rip, 28, 5))
}
theorem scan_near_forward(start: BitVec(64), offset: Nat, displacement: BitVec(32), count: Nat,
    forward: bitvec::toNat(64, bitvec::sign_extend(31, 32, displacement)) = count):
    scan_near_rip(True, displacement, next_rip(start, offset)) = next_rip(start, (offset + 6) + count) {
    trans(sym(bitvec::iter_add_eq_add(64, next_rip(next_rip(start, offset), 6),
        bitvec::sign_extend(31, 32, displacement))),
        trans(bitvec::cong_iterate_increment_count(64, next_rip(next_rip(start, offset), 6), forward),
            trans(bitvec::cong_iterate_increment(64, count,
                bitvec::iterate_increment_compose(64, start, offset, 6)),
                bitvec::iterate_increment_compose(64, start, offset + 6, count))))
}
theorem scan_end_rip<M>(done: BitVec(32), count: Nat,
    forward: bitvec::toNat(64, bitvec::sign_extend(31, 32, done)) = count, before: MachineState<M>):
    (scan_bounds_edge(False, done, before)).rip = next_rip(before.rip, 9 + count) {
    scan_near_forward(before.rip, 3, done, count, forward)
}
theorem scan_limit_rip<M>(done, limit: BitVec(32), count: Nat,
    forward: bitvec::toNat(64, bitvec::sign_extend(31, 32, limit)) = count, before: MachineState<M>):
    (scan_fuel_edge(True, limit, scan_bounds_edge(True, done, before))).rip = next_rip(before.rip, 28 + count) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => scan_near_rip(True, limit, address),
        trans(scan_fuel_check_rip(scan_bounds_edge(True, done, before)),
            trans(bitvec::cong_iterate_increment(64, 13, scan_bounds_fallthrough_rip(done, before)),
                bitvec::iterate_increment_compose(64, before.rip, 9, 13)))),
        scan_near_forward(before.rip, 22, limit, count, forward))
}

// These equalities expose which physical path runs. The two early exits have
// no permission argument and their resulting state does not depend on read.
theorem scan_gate_end<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>,
    outside: scan_bounds(before) = False):
    scan_gate(access, done, limit, before) = ScanEnd(scan_bounds_edge(False, done, before)) {
    cong_fn<Bool, ScanGate<M>>(λ inside => scan_gate_selected(access, inside, scan_empty_fuel(before), done, limit, before), outside)
}
theorem scan_gate_limit<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>,
    inside: scan_bounds(before) = True, empty: scan_empty_fuel(before) = True):
    scan_gate(access, done, limit, before) = ScanLimit(scan_fuel_edge(True, limit, scan_bounds_edge(True, done, before))) {
    trans(cong_fn<Bool, ScanGate<M>>(λ selected => scan_gate_selected(access, selected, scan_empty_fuel(before), done, limit, before), inside),
        cong_fn<Bool, ScanGate<M>>(λ selected => scan_gate_selected(access, True, selected, done, limit, before), empty))
}
theorem scan_gate_ready<M>(access: BufferAccess<M>, done, limit: BitVec(32), before: MachineState<M>,
    inside: scan_bounds(before) = True, available: scan_empty_fuel(before) = False):
    scan_gate(access, done, limit, before) = ScanReady(scan_load(access, scan_fuel_edge(False, limit, scan_bounds_edge(True, done, before)))) {
    trans(cong_fn<Bool, ScanGate<M>>(λ selected => scan_gate_selected(access, selected, scan_empty_fuel(before), done, limit, before), inside),
        cong_fn<Bool, ScanGate<M>>(λ selected => scan_gate_selected(access, True, selected, done, limit, before), available))
}

// The x86 memory contract, stated once (issues/x86-memory-contract.md;
// docs/language/ownership-design.md §17.2; docs/native/native-one-compiler-design.md §2.7).
//
// What a call is lent of memory, what it may store there, what a caller
// keeps across it, how a heap of blocks lies in memory, and what a call
// promises at its label. Every older statement of these
// (x86_64_memory_tiers) is an instance of one here.
//
// - `Spans` and `Loan`: the spans a call is lent, by number, and the laws a
//   store obeys over them, relative to a stack offset `top` the call's own
//   words lie below. The instance for spans inside a data region is
//   `DataRegion::loan` (x86_64_byte_memory); a lending of no bytes is
//   `Stack::loan_none`.
// - `Stack::WroteIn(i, spans, before, after)`: what a call entered at `i`
//   may have done to memory, stores of words in its own room
//   (`Stack::Own`, x86_64_stack) and of bytes into the spans it may write
//   (`Stack::Put`), one after another. Its order is one lemma,
//   `Stack::wrote_in_widen`: deeper and over spans that write less
//   (`Spans::Within`) is less. A call that writes no span is the case
//   `Spans::none()`.
// - The frame rule: what held before a call's stores and is stable under
//   one (`Stack::StableIn`) holds after them (`Stack::wrote_in_frame`).
//   Stable under a loan: the caller's words up to `top`, the code, a span
//   nobody was lent to write, and a heap's injection (`Loan::stable_injected`).
// - `Sub(spans, pieces)`: each piece a part of a span, a written piece part
//   of a written span and apart from every other piece of it. A loan of the
//   spans is a loan of the pieces (`Loan::sub`), and what was stored through
//   the pieces was stored through the spans (`Stack::wrote_in_up`). Lending a
//   callee a view, renumbering spans, narrowing what may be written and
//   carving a block from a supply are all `Sub`.
// - `Heap` and `Injected`: blocks of bytes with a shadow of references
//   (`Pointer`: eight bytes of a block that hold a reference to a `Loc`)
//   and a set of undefined bytes, block `b` lying at span `b`. A byte is
//   plain, part of a reference, or undefined. Injected: each block as long
//   as its span, a plain byte reads its byte, a pointer's eight bytes read
//   its target's address, and an undefined byte reads anything
//   (`Injected::undefined_change`); a store defines what it stores. One lemma per memory operation:
//   `Loan::store_injected` for a store of any width, the pointer store
//   `Loan::store_ref_injected` (the same store, the shadow telling), and
//   `Injected::reads` for a load of any width with its cases at the
//   machine's (`byte_read`, `dword_read`, `word_read`, `ref_read`). The
//   heap is canonical: the bytes under a pointer are zero, since a pointer
//   store zeroes them (`Heap::store_ref`), and every store keeps that
//   (`Heap::canonical_store`, `Heap::canonical_store_ref`).
// - `Site::Meets`: the call contract over one lending for a whole run. A
//   callee's meaning answers words and a heap for arguments and a heap
//   (`Returned`); entered with the arguments passed and the heap injected,
//   it returns with the words in place, the kept registers kept, its stores
//   inside the lending, and the answer's heap injected.
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import memory;
import bitvec;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;
import omega;
import relation;
import transition;

// ---------------------------------------------------------------------------
// Spans and their laws

// The spans a call is lent, by number: span `b` is `size(b)` bytes from
// `at(b)`, and the call may store into it when `written(b)`.
record Spans { at: Nat → BitVec(64), size: Nat → Nat, written: Nat → Bool }

// Where byte `k` of span `b` lies.
fn Spans::byte(self spans: Spans, b, k: Nat) → BitVec(64) { next_rip(spans.at(b), k) }

// No span has a byte, and none may be written.
fn Spans::none() → Spans { Spans(λ (_: Nat) => BitVec::zero(), λ (_: Nat) => 0, λ (_: Nat) => False) }

// A span nobody writes may overlap another such; a written span is apart
// from every other, because its law says a byte stored there leaves them. A
// store is of any number of bytes from a byte inside a written span, as far
// as the span goes: the laws are stated of the store the machine makes (a
// 4-byte `MOV` is one store, not four), and one byte is the case `[byte]`.
record Loan<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, stack: Stack<M>(fetch, data), top: Nat, spans: Spans) {
    room: top <= stack.size,
    canonical: (b: Nat) → spans.at(b).toNat() + spans.size(b) <= Nat::pow(2, 47),
    // A word stored below `top` leaves every span's bytes.
    under: (memory: M) → (k: Nat) → k + 8 <= top → (word: BitVec(64)) → (b, j: Nat) → j < spans.size(b) →
        data.read(stack.writes.store(memory, next_rip(stack.low, k), word_bytes(word)), spans.byte(b, j)) = data.read(memory, spans.byte(b, j)),
    // Bytes from byte `k` of a written span, inside it, are writable; stored
    // there they read back, and leave every other byte of every span, the
    // stack's words below `top`, and the code.
    writable: (memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → stack.writes.writable(memory, spans.byte(b, k), bytes.len()),
    stored: (memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → (t: Nat) → t < bytes.len() →
        data.read(stack.writes.store(memory, spans.byte(b, k), bytes), spans.byte(b, k + t)) = bytes.nth(t),
    apart: (memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → (c, j: Nat) → j < spans.size(c) → (b ≠ c) ∨ ((j < k) ∨ (k + bytes.len() <= j)) →
        data.read(stack.writes.store(memory, spans.byte(b, k), bytes), spans.byte(c, j)) = data.read(memory, spans.byte(c, j)),
    keeps: (memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → (j: Nat) → j + 8 <= top →
        read_word(data, stack.writes.store(memory, spans.byte(b, k), bytes), next_rip(stack.low, j)) = read_word(data, memory, next_rip(stack.low, j)),
    keeps_code: (memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → (code: List<BitVec(8)>) → (at: BitVec(64)) → CodeResident(fetch, memory, code, at) →
        CodeResident(fetch, stack.writes.store(memory, spans.byte(b, k), bytes), code, at),
}

// `n` bytes from byte `k` of a span, inside it, lie below the canonical
// boundary.
theorem Loan::canonical_at<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), b, k, n: Nat, fits: k + n <= spans.size(b)):
    spans.byte(b, k).toNat() + n <= Nat::pow(2, 47) {
    let room = loan.canonical(b);
    let wide: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 47) + 1, Nat::pow(2, 64), trivial);
    let value: (spans.byte(b, k).toNat() = spans.at(b).toNat() + k) = BitVec::offset_toNat(64, spans.at(b), k, omega(room, fits, wide));
    omega(value, room, fits)
}

// Spans of no bytes, none of them to write, are lent under any stack: there
// is no byte to keep apart from a store. A program that reads no buffer
// meets the laws this way.
theorem Stack::loan_none<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    room: top <= stack.size, spans: Spans, empty: (b: Nat) → spans.size(b) = 0,
    canonical: (b: Nat) → spans.at(b).toNat() <= Nat::pow(2, 47), none: (b: Nat) → spans.written(b) = False):
    Loan<M>(fetch, data, stack, top, spans) {
    Loan(
        room := room,
        canonical := λ b => omega(empty(b), canonical(b)),
        under := λ memory k below word b j inside => false_elim(omega(inside, empty(b))),
        writable := λ memory b k written inside bytes fits => absurd(trans(sym(written), none(b))),
        stored := λ memory b k written inside bytes fits t short => absurd(trans(sym(written), none(b))),
        apart := λ memory b k written inside bytes fits c j short other => absurd(trans(sym(written), none(b))),
        keeps := λ memory b k written inside bytes fits j below => absurd(trans(sym(written), none(b))),
        keeps_code := λ memory b k written inside bytes fits code at resident => absurd(trans(sym(written), none(b))),
    )
}

// ---------------------------------------------------------------------------
// What a call may store

// Bytes stored into a span the call may write, from a byte inside it.
fn Stack::Put<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), spans: Spans, before, after: M) → Type {
    Exists<Nat>(λ b => Exists<Nat>(λ k => ((spans.written(b) = True) ∧ (k < spans.size(b))) ∧
        Exists<List<BitVec(8)>>(λ bytes => (k + bytes.len() <= spans.size(b)) ∧ (after = stack.writes.store(before, spans.byte(b, k), bytes)))))
}

// One store a call entered at `i` and lent `spans` may make.
fn Stack::Stores<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    before, after: M) → Type {
    stack.Own(i, before, after) ∨ stack.Put(spans, before, after)
}

// What the call may have done to memory: such stores, one after another.
fn Stack::WroteIn<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    before, after: M) → Type {
    Star(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), before, after)
}

theorem Stack::wrote_in_refl<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    memory: M): stack.WroteIn(i, spans, memory, memory) {
    Star::refl(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), memory)
}

theorem Stack::wrote_in_trans<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    a, b, c: M, first: stack.WroteIn(i, spans, a, b), second: stack.WroteIn(i, spans, b, c)): stack.WroteIn(i, spans, a, c) {
    Star::trans(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), a, b, c, first, second)
}

// A word stored wholly below `i`.
theorem Stack::wrote_in_word<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    memory: M, k: Nat, below: k + 8 <= i, word: BitVec(64)): stack.WroteIn(i, spans, memory, stack.writes.store(memory, stack.at(k), word_bytes(word))) {
    Star::one(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), memory, stack.writes.store(memory, stack.at(k), word_bytes(word)),
        Inl(Exists(k, ⟨below, Exists(word, refl)⟩)))
}

// Bytes stored into a span it may write.
theorem Stack::wrote_in_store<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    memory: M, b, k: Nat, written: spans.written(b) = True, inside: k < spans.size(b), bytes: List<BitVec(8)>, fits: k + bytes.len() <= spans.size(b)):
    stack.WroteIn(i, spans, memory, stack.writes.store(memory, spans.byte(b, k), bytes)) {
    Star::one(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), memory, stack.writes.store(memory, spans.byte(b, k), bytes),
        Inr(Exists(b, Exists(k, ⟨⟨written, inside⟩, Exists(bytes, ⟨fits, refl⟩)⟩))))
}

// What `inner` lets be written, `outer` does: every run of bytes inside a
// written span of `inner` lies at a run inside a written span of `outer`.
fn Spans::Within(self inner: Spans, outer: Spans) → Type {
    (b, k: Nat) → inner.written(b) = True → k < inner.size(b) → (n: Nat) → k + n <= inner.size(b) →
        Exists<Nat>(λ c => Exists<Nat>(λ j => ((outer.written(c) = True) ∧ (j < outer.size(c))) ∧
            ((j + n <= outer.size(c)) ∧ (inner.byte(b, k) = outer.byte(c, j)))))
}

theorem Spans::within_self(self spans: Spans): spans.Within(spans) {
    λ b k written inside n fits => Exists(b, Exists(k, ⟨⟨written, inside⟩, ⟨fits, refl⟩⟩))
}

// Nothing to write is within anything,
theorem Spans::none_within(outer: Spans): Spans::none().Within(outer) {
    λ b k written inside n fits => absurd(sym(written))
}

// and spans none of which may be written are within nothing.
theorem Spans::within_none(self spans: Spans, none: (b: Nat) → spans.written(b) = False): spans.Within(Spans::none()) {
    λ b k written inside n fits => absurd(trans(sym(written), none(b)))
}

// The order: what a call entered lower may store over spans within others,
// one entered higher may store over the others. A callee's callee stores
// less, and so does a callee lent less.
theorem Stack::wrote_in_widen<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, i: Nat, le: d <= i,
    inner, outer: Spans, within: inner.Within(outer), before, after: M, wrote: stack.WroteIn(d, inner, before, after)):
    stack.WroteIn(i, outer, before, after) {
    Star::monotone(λ (m: M) (n: M) => stack.Stores(d, inner, m, n), λ (m: M) (n: M) => stack.Stores(i, outer, m, n),
        λ m n step => match step {
            Inl(own) => Inl(Exists(own.witness, ⟨omega(own.proof.left, le), own.proof.right⟩)),
            Inr(put) => {
                let bytes = put.proof.proof.right.witness;
                let there = within(put.witness, put.proof.witness, put.proof.proof.left.left, put.proof.proof.left.right, bytes.len(),
                    put.proof.proof.right.proof.left);
                let facts = there.proof.proof;
                Inr(Exists(there.witness, Exists(there.proof.witness, ⟨facts.left, Exists(bytes, ⟨facts.right.left,
                    trans(put.proof.proof.right.proof.right, cong_fn<BitVec(64), M>(λ a => stack.writes.store(m, a, bytes), facts.right.right))⟩)⟩)))
            },
        }, before, after, wrote)
}

// ---------------------------------------------------------------------------
// The frame rule (issues/compiled-call-frame-rule.md)

// `P` is stable under a store the call may make: a word of its own room
// (`Stack::Stable`, x86_64_stack), and bytes stored into a span it may
// write, from a byte inside it and as far as the span goes.
fn Stack::StableIn<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    P: M → Type) → Type {
    stack.Stable(i, P) ∧ ((memory: M) → (b, k: Nat) → spans.written(b) = True → k < spans.size(b) → (bytes: List<BitVec(8)>) →
        k + bytes.len() <= spans.size(b) → P(memory) → P(stack.writes.store(memory, spans.byte(b, k), bytes)))
}

// The rule: what held before the call's stores and is stable under one
// holds after them. The predicate is read off the proof it is stable.
theorem Stack::wrote_in_frame<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    {P: M → Type}, stable: stack.StableIn(i, spans, P), before, after: M, wrote: stack.WroteIn(i, spans, before, after), held: P(before)):
    P(after) {
    Star::invariant(λ (m: M) (n: M) => stack.Stores(i, spans, m, n), P,
        λ m n was step => match step {
            Inl(own) => j(sym(own.proof.right.proof), λ x _ => P(x),
                stable.left(m, own.witness, own.proof.left, own.proof.right.witness, was)),
            Inr(put) => j(sym(put.proof.proof.right.proof.right), λ x _ => P(x),
                stable.right(m, put.witness, put.proof.witness, put.proof.proof.left.left, put.proof.proof.left.right,
                    put.proof.proof.right.witness, put.proof.proof.right.proof.left, was)),
        }, before, after, held, wrote)
}

theorem Stack::stable_in_and<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    {P, Q: M → Type}, first: stack.StableIn(i, spans, P), second: stack.StableIn(i, spans, Q)):
    stack.StableIn(i, spans, λ (m: M) => P(m) ∧ Q(m)) {
    ⟨stack.stable_and(i, first.left, second.left),
     λ memory b k written inside bytes fits held => ⟨first.right(memory, b, k, written, inside, bytes, fits, held.left),
        second.right(memory, b, k, written, inside, bytes, fits, held.right)⟩⟩
}

theorem Stack::stable_in_given<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    {A: Type}, {P: M → Type}, stable: A → stack.StableIn(i, spans, P)): stack.StableIn(i, spans, λ (m: M) => A ∧ P(m)) {
    ⟨stack.stable_given(i, λ (a: A) => stable(a).left),
     λ memory b k written inside bytes fits held => ⟨held.left, stable(held.left).right(memory, b, k, written, inside, bytes, fits, held.right)⟩⟩
}

// With no span to write, stable under the call's own stores is all.
theorem Stack::stable_in_none<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans: Spans,
    none: (b: Nat) → spans.written(b) = False, {P: M → Type}, stable: stack.Stable(i, P)): stack.StableIn(i, spans, P) {
    ⟨stable, λ memory b k written inside bytes fits held => absurd(trans(sym(written), none(b)))⟩
}

// ---------------------------------------------------------------------------
// What a span reads along the way

// A span's byte at an index word inside it: where it lies is canonical,
// and it reads the span's byte.
theorem readable_at<M>(data: ByteReadAccess<M>, memory: M, a: BitVec(64), xs: List<BitVec(8)>, reads: Readable(data, memory, a, xs),
    index: BitVec(64), inside: index.toNat() < xs.len()):
    (a.add(index) = next_rip(a, index.toNat())) ∧
        ((a.add(index).toNat() < Nat::pow(2, 47)) ∧ (data.read(memory, a.add(index)) = xs.nth(index.toNat()))) {
    let address: (a.add(index) = next_rip(a, index.toNat())) = sym(BitVec::iter_add_eq_add(64, a, index));
    let top: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 47) + 1, Nat::pow(2, 64), trivial);
    let value: (next_rip(a, index.toNat()).toNat() = a.toNat() + index.toNat()) =
        BitVec::offset_toNat(64, a, index.toNat(), omega(reads.left, inside, top));
    ⟨address, ⟨j(sym(address), λ x _ => x.toNat() < Nat::pow(2, 47), omega(value, reads.left, inside)),
        j(sym(address), λ x _ => data.read(memory, x) = xs.nth(index.toNat()), reads.right(index.toNat(), inside))⟩⟩
}

// A word stored below `top` leaves what a span reads,
theorem Loan::own_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), memory: M, k: Nat, below: k + 8 <= top, word: BitVec(64), c: Nat,
    ys: List<BitVec(8)>, fits: ys.len() <= spans.size(c), reads: Readable(data, memory, spans.at(c), ys)):
    Readable(data, stack.writes.store(memory, stack.at(k), word_bytes(word)), spans.at(c), ys) {
    ⟨reads.left, λ t short => trans(loan.under(memory, k, below, word, c, t, omega(short, fits)), reads.right(t, short))⟩
}

// so what a span reads is stable under the own stores of a call entered at
// or below `top`.
theorem Loan::stable_span<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, c: Nat, ys: List<BitVec(8)>,
    fits: ys.len() <= spans.size(c)): stack.Stable(i, λ (m: M) => Readable(data, m, spans.at(c), ys)) {
    λ memory k below word held => loan.own_reads(memory, k, omega(below, low), word, c, ys, fits, held)
}

// A window of the bytes a span reads is read at the window's start.
theorem readable_window<M>(data: ByteReadAccess<M>, memory: M, a: BitVec(64), xs: List<BitVec(8)>, reads: Readable(data, memory, a, xs),
    start, end: Nat, low: start <= end, high: end <= xs.len()): Readable(data, memory, next_rip(a, start), xs.window(start, end)) {
    let wide: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 47) + 1, Nat::pow(2, 64), trivial);
    let value: (next_rip(a, start).toNat() = a.toNat() + start) = BitVec::offset_toNat(64, a, start, omega(reads.left, low, high, wide));
    let len: (xs.window(start, end).len() = end - start) = xs.len_window(start, end, low, high);
    ⟨omega(value, len, reads.left, low, high),
     λ k short => {
        let inside: (k < end - start) = j(len, λ n _ => k < n, short);
        let swap: (start + k = k + start) = omega();
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ at => data.read(memory, at), rip_compose(a, start, k)),
            trans(reads.right(start + k, omega(inside, high)),
                trans(cong_fn<Nat, Option<BitVec(8)>>(λ n => xs.nth(n), swap), sym(xs.nth_window(start, end, k, inside)))))
     }⟩
}

// A span whose bytes read `xs` before, whose window from `start` reads
// `ys` now, and whose bytes outside the window read as before, reads `xs`
// with the window replaced.
theorem readable_put_window<M>(data: ByteReadAccess<M>, before, after: M, a: BitVec(64), xs, ys: List<BitVec(8)>, start: Nat,
    fits: ys.len() + start <= xs.len(), was: Readable(data, before, a, xs), now: Readable(data, after, next_rip(a, start), ys),
    kept: (t: Nat) → t < xs.len() → (t < start) ∨ (ys.len() + start <= t) → data.read(after, next_rip(a, t)) = data.read(before, next_rip(a, t))):
    Readable(data, after, a, xs.put_window(start, ys)) {
    let len: (xs.put_window(start, ys).len() = xs.len()) = xs.len_put_window(start, ys, fits);
    ⟨j(sym(len), λ n _ => a.toNat() + n <= Nat::pow(2, 47), was.left),
     λ t short => {
        let in_xs: (t < xs.len()) = j(len, λ n _ => t < n, short);
        match t.lt_or_ge(start) {
            Inl(below) => trans(kept(t, in_xs, Inl(below)),
                trans(was.right(t, in_xs), sym(xs.nth_put_window_before(start, ys, t, below, omega(fits))))),
            Inr(from) => match t.lt_or_ge(ys.len() + start) {
                Inl(inside) => {
                    let parts: (t = (t - start) + start) = omega(from);
                    let swap: (start + (t - start) = t) = omega(from);
                    j(sym(parts), λ u _ => data.read(after, next_rip(a, t)) = xs.put_window(start, ys).nth(u),
                        trans(cong_fn<Nat, Option<BitVec(8)>>(λ n => data.read(after, next_rip(a, n)), sym(swap)),
                            trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ at => data.read(after, at), sym(rip_compose(a, start, t - start))),
                                trans(now.right(t - start, omega(from, inside)),
                                    sym(xs.nth_put_window_inside(start, ys, t - start, omega(from, inside), omega(fits)))))))
                },
                Inr(past) => {
                    let parts: (t = (t - (ys.len() + start)) + (ys.len() + start)) = omega(past);
                    trans(kept(t, in_xs, Inr(past)),
                        trans(was.right(t, in_xs),
                            j(sym(parts), λ u _ => xs.nth(u) = xs.put_window(start, ys).nth(u),
                                sym(xs.nth_put_window_after(start, ys, t - (ys.len() + start), omega(fits))))))
                },
            },
        }
     }⟩
}

// Bytes stored into a span from byte `k`: it reads its bytes with theirs
// written over from `k`,
theorem Loan::store_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), memory: M, b, k: Nat, written: spans.written(b) = True, inside: k < spans.size(b),
    bytes: List<BitVec(8)>, fits: k + bytes.len() <= spans.size(b), xs: List<BitVec(8)>, whole: xs.len() = spans.size(b),
    reads: Readable(data, memory, spans.at(b), xs)):
    Readable(data, stack.writes.store(memory, spans.byte(b, k), bytes), spans.at(b), xs.put_window(k, bytes)) {
    let after = stack.writes.store(memory, spans.byte(b, k), bytes);
    let now: Readable(data, after, next_rip(spans.at(b), k), bytes) =
        ⟨loan.canonical_at(b, k, bytes.len(), fits),
         λ t short => trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ y => data.read(after, y), rip_compose(spans.at(b), k, t)),
            loan.stored(memory, b, k, written, inside, bytes, fits, t, short))⟩;
    readable_put_window(data, memory, after, spans.at(b), xs, bytes, k, omega(fits, whole), reads, now,
        λ t short out => loan.apart(memory, b, k, written, inside, bytes, fits, b, t, j(whole, λ n _ => t < n, short),
            Inr(match out {
                Inl(below) => Inl(below),
                Inr(past) => Inr(omega(past)),
            })))
}

// and every other span reads what it did.
theorem Loan::store_keeps<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), memory: M, b, k: Nat, written: spans.written(b) = True, inside: k < spans.size(b),
    bytes: List<BitVec(8)>, stored: k + bytes.len() <= spans.size(b), c: Nat, differs: b ≠ c, ys: List<BitVec(8)>, fits: ys.len() <= spans.size(c),
    reads: Readable(data, memory, spans.at(c), ys)): Readable(data, stack.writes.store(memory, spans.byte(b, k), bytes), spans.at(c), ys) {
    ⟨reads.left, λ t short => trans(loan.apart(memory, b, k, written, inside, bytes, stored, c, t, omega(short, fits), Inl(differs)), reads.right(t, short))⟩
}

// ---------------------------------------------------------------------------
// What a caller keeps

// The stack's words from `from` up to `top` read in `after` as in `before`.
fn Stack::UnchangedTo<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), from, top: Nat,
    before, after: M) → Type {
    (k: Nat) → from <= k → k + 8 <= top → read_word(data, after, stack.at(k)) = read_word(data, before, stack.at(k))
}

// What a caller keeps, as stable predicates: a word of the stack from `i` up
// to `top`, the return address among them,
theorem Loan::stable_word<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i, k: Nat, above: i <= k, fits: k + 8 <= top, value: Option<BitVec(64)>):
    stack.StableIn(i, spans, λ (m: M) => read_word(data, m, stack.at(k)) = value) {
    ⟨stack.stable_word(i, k, above, omega(fits, loan.room), value),
     λ memory b at written inside bytes stored held => trans(loan.keeps(memory, b, at, written, inside, bytes, stored, k, fits), held)⟩
}

// code where it lies,
theorem Loan::stable_resident<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, bytes: List<BitVec(8)>, at: BitVec(64)):
    stack.StableIn(i, spans, λ (m: M) => CodeResident(fetch, m, bytes, at)) {
    ⟨stack.stable_resident(i, omega(low, loan.room), bytes, at),
     λ memory b k written inside stored fits held => loan.keeps_code(memory, b, k, written, inside, stored, fits, bytes, at, held)⟩
}

// and the bytes of a span the call was not lent to write.
theorem Loan::stable_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, c: Nat, only_read: spans.written(c) = False,
    ys: List<BitVec(8)>, fits: ys.len() <= spans.size(c)): stack.StableIn(i, spans, λ (m: M) => Readable(data, m, spans.at(c), ys)) {
    ⟨loan.stable_span(i, low, c, ys, fits),
     λ memory b k written inside bytes stored held => loan.store_keeps(memory, b, k, written, inside, bytes, stored, c,
        λ same => absurd(trans(sym(j(same, λ u _ => spans.written(u) = True, written)), only_read)), ys, fits, held)⟩
}

// The same across the stores of a call, by the rule. A span the call was
// not lent to write reads what it did.
theorem Loan::unwritten_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, c: Nat, only_read: spans.written(c) = False,
    ys: List<BitVec(8)>, fits: ys.len() <= spans.size(c), before, after: M, wrote: stack.WroteIn(i, spans, before, after),
    reads: Readable(data, before, spans.at(c), ys)): Readable(data, after, spans.at(c), ys) {
    stack.wrote_in_frame(i, spans, loan.stable_reads(i, low, c, only_read, ys, fits), before, after, wrote, reads)
}

// The caller's words from `i` up to `top`, the return address among them,
// are as they were.
theorem Loan::unchanged<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, before, after: M, wrote: stack.WroteIn(i, spans, before, after)):
    stack.UnchangedTo(i, top, before, after) {
    λ k above fits => stack.wrote_in_frame(i, spans, loan.stable_word(i, k, above, fits, read_word(data, before, stack.at(k))),
        before, after, wrote, refl)
}

// Code stays where it was.
theorem Loan::resident<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, bytes: List<BitVec(8)>, at: BitVec(64), before, after: M,
    wrote: stack.WroteIn(i, spans, before, after), resident: CodeResident(fetch, before, bytes, at)): CodeResident(fetch, after, bytes, at) {
    stack.wrote_in_frame(i, spans, loan.stable_resident(i, low, bytes, at), before, after, wrote, resident)
}

// ---------------------------------------------------------------------------
// Parts of spans (docs/native/native-library-exports-design.md §3.1)

// Each of `pieces` lies at `offset(b)` of span `parent(b)`, inside it,
// wherever it has a byte; one lent to write is a piece of one lent to
// write, and apart from every other piece of its parent that has a byte.
// Two pieces only read may overlap, and two halves of one span may be lent
// apart, one of them to write.
record Sub(spans, pieces: Spans) {
    parent: Nat → Nat,
    offset: Nat → Nat,
    at: (b: Nat) → 0 < pieces.size(b) → pieces.at(b) = spans.byte(parent(b), offset(b)),
    inside: (b: Nat) → offset(b) + pieces.size(b) <= spans.size(parent(b)),
    written: (b: Nat) → pieces.written(b) = True → spans.written(parent(b)) = True,
    apart: (b, c: Nat) → pieces.written(b) = True → b ≠ c → 0 < pieces.size(b) → 0 < pieces.size(c) → parent(b) = parent(c) →
        (offset(b) + pieces.size(b) <= offset(c)) ∨ (offset(c) + pieces.size(c) <= offset(b)),
}

// Byte `k` of a piece is byte `offset + k` of its parent.
theorem Sub::byte({spans, pieces: Spans}, self sub: Sub(spans, pieces), b, k: Nat, short: k < pieces.size(b)):
    pieces.byte(b, k) = spans.byte(sub.parent(b), sub.offset(b) + k) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => next_rip(a, k), sub.at(b, omega(short))), rip_compose(spans.at(sub.parent(b)), sub.offset(b), k))
}

theorem Sub::byte_from({spans, pieces: Spans}, self sub: Sub(spans, pieces), b, k, t: Nat, short: k + t < pieces.size(b)):
    pieces.byte(b, k + t) = spans.byte(sub.parent(b), sub.offset(b) + k + t) {
    trans(sub.byte(b, k + t, short), cong_fn<Nat, BitVec(64)>(λ n => spans.byte(sub.parent(b), n), omega()))
}

// What the pieces let be written, the spans do,
theorem Sub::within({spans, pieces: Spans}, self sub: Sub(spans, pieces)): pieces.Within(spans) {
    λ b k written inside n fits => Exists(sub.parent(b), Exists(sub.offset(b) + k,
        ⟨⟨sub.written(b, written), omega(inside, sub.inside(b))⟩, ⟨omega(fits, sub.inside(b)), sub.byte(b, k, inside)⟩⟩))
}

// so what was stored through the pieces was stored through the spans: the
// footprint stays the one stated at entry.
theorem Stack::wrote_in_up<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, spans, pieces: Spans,
    sub: Sub(spans, pieces), before, after: M, wrote: stack.WroteIn(i, pieces, before, after)): stack.WroteIn(i, spans, before, after) {
    stack.wrote_in_widen(i, i, omega(), pieces, spans, sub.within(), before, after, wrote)
}

// A loan of the spans is a loan of the pieces, given that each lies below
// the canonical boundary (which a piece with a byte does,
// `Loan::canonical_at`).
theorem Loan::sub<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), pieces: Spans, sub: Sub(spans, pieces),
    canonical: (b: Nat) → pieces.at(b).toNat() + pieces.size(b) <= Nat::pow(2, 47)): Loan<M>(fetch, data, stack, top, pieces) {
    let p = sub.parent;
    let o = sub.offset;
    Loan(
        room := loan.room,
        canonical := canonical,
        under := λ memory k below word b i short =>
            j(sym(sub.byte(b, i, short)), λ a _ => data.read(stack.writes.store(memory, next_rip(stack.low, k), word_bytes(word)), a) = data.read(memory, a),
                loan.under(memory, k, below, word, p(b), o(b) + i, omega(short, sub.inside(b)))),
        writable := λ memory b k written inside bytes fits =>
            j(sym(sub.byte(b, k, inside)), λ a _ => stack.writes.writable(memory, a, bytes.len()),
                loan.writable(memory, p(b), o(b) + k, sub.written(b, written), omega(inside, sub.inside(b)), bytes, omega(fits, sub.inside(b)))),
        stored := λ memory b k written inside bytes fits t short =>
            j(sym(sub.byte(b, k, inside)), λ a _ => data.read(stack.writes.store(memory, a, bytes), pieces.byte(b, k + t)) = bytes.nth(t),
                j(sym(sub.byte_from(b, k, t, omega(fits, short))),
                    λ y _ => data.read(stack.writes.store(memory, spans.byte(p(b), o(b) + k), bytes), y) = bytes.nth(t),
                    loan.stored(memory, p(b), o(b) + k, sub.written(b, written), omega(inside, sub.inside(b)), bytes, omega(fits, sub.inside(b)),
                        t, short))),
        apart := λ memory b k written inside bytes fits c i short other => {
            let order: ((p(b) ≠ p(c)) ∨ ((o(c) + i < o(b) + k) ∨ (o(b) + k + bytes.len() <= o(c) + i))) = match p(b).eq_dec(p(c)) {
                Inr(differs) => Inl(differs),
                Inl(same_parent) => match b.eq_dec(c) {
                    Inl(same) => {
                        let same_offset: (o(b) = o(c)) = cong_fn<Nat, Nat>(λ n => o(n), same);
                        match other {
                            Inl(differs) => false_elim(differs(same)),
                            Inr(side) => match side {
                                Inl(below) => Inr(Inl(omega(below, same_offset))),
                                Inr(above) => Inr(Inr(omega(above, same_offset))),
                            },
                        }
                    },
                    Inr(differs) => match sub.apart(b, c, written, differs, omega(inside), omega(short), same_parent) {
                        Inl(below) => Inr(Inr(omega(below, fits))),
                        Inr(above) => Inr(Inl(omega(above, short))),
                    },
                },
            };
            j(sym(sub.byte(b, k, inside)), λ a _ => data.read(stack.writes.store(memory, a, bytes), pieces.byte(c, i)) = data.read(memory, pieces.byte(c, i)),
                j(sym(sub.byte(c, i, short)), λ y _ => data.read(stack.writes.store(memory, spans.byte(p(b), o(b) + k), bytes), y) = data.read(memory, y),
                    loan.apart(memory, p(b), o(b) + k, sub.written(b, written), omega(inside, sub.inside(b)), bytes, omega(fits, sub.inside(b)),
                        p(c), o(c) + i, omega(short, sub.inside(c)), order)))
        },
        keeps := λ memory b k written inside bytes fits i below =>
            j(sym(sub.byte(b, k, inside)), λ a _ => read_word(data, stack.writes.store(memory, a, bytes), next_rip(stack.low, i)) =
                    read_word(data, memory, next_rip(stack.low, i)),
                loan.keeps(memory, p(b), o(b) + k, sub.written(b, written), omega(inside, sub.inside(b)), bytes, omega(fits, sub.inside(b)), i, below)),
        keeps_code := λ memory b k written inside bytes fits code at resident =>
            j(sym(sub.byte(b, k, inside)), λ a _ => CodeResident(fetch, stack.writes.store(memory, a, bytes), code, at),
                loan.keeps_code(memory, p(b), o(b) + k, sub.written(b, written), omega(inside, sub.inside(b)), bytes, omega(fits, sub.inside(b)),
                    code, at, resident)),
    )
}

// The same spans under other numbers, no longer, written only where they
// are, and at the same place wherever they have a byte.
fn Sub::same(spans, other: Spans, size: (b: Nat) → other.size(b) <= spans.size(b),
    written: (b: Nat) → other.written(b) = True → spans.written(b) = True, at: (b: Nat) → 0 < other.size(b) → other.at(b) = spans.at(b)) →
    Sub(spans, other) {
    Sub(
        parent := λ (b: Nat) => b,
        offset := λ (_: Nat) => 0,
        at := at,
        inside := λ b => j(sym(other.size(b).add_left_zero()), λ n _ => n <= spans.size(b), size(b)),
        written := written,
        apart := λ b c marked differ _ _ same => false_elim(differ(same)),
    )
}

// A byte of the spans that no piece to write covers reads what it did,
// whatever was stored through the pieces.
theorem Loan::sub_outside<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), pieces: Spans, sub: Sub(spans, pieces), i: Nat, low: i <= top, c, t: Nat,
    short: t < spans.size(c),
    outside: (v: Nat) → pieces.written(v) = True → 0 < pieces.size(v) → sub.parent(v) = c →
        (t < sub.offset(v)) ∨ (sub.offset(v) + pieces.size(v) <= t),
    before, after: M, wrote: stack.WroteIn(i, pieces, before, after)):
    data.read(after, spans.byte(c, t)) = data.read(before, spans.byte(c, t)) {
    Star::invariant(λ (m: M) (n: M) => stack.Stores(i, pieces, m, n), λ (m: M) => data.read(m, spans.byte(c, t)) = data.read(before, spans.byte(c, t)),
        λ m n held step => match step {
            Inl(own) => j(sym(own.proof.right.proof), λ x _ => data.read(x, spans.byte(c, t)) = data.read(before, spans.byte(c, t)),
                trans(loan.under(m, own.witness, omega(own.proof.left, low), own.proof.right.witness, c, t, short), held)),
            Inr(put) => {
                let v = put.witness;
                let k = put.proof.witness;
                let written = put.proof.proof.left.left;
                let inside: (k < pieces.size(v)) = put.proof.proof.left.right;
                let bytes = put.proof.proof.right.witness;
                let fits: (k + bytes.len() <= pieces.size(v)) = put.proof.proof.right.proof.left;
                let differ: ((sub.parent(v) ≠ c) ∨ ((t < sub.offset(v) + k) ∨ (sub.offset(v) + k + bytes.len() <= t))) =
                    match sub.parent(v).eq_dec(c) {
                        Inl(same) => Inr(match outside(v, written, omega(inside), same) {
                            Inl(below) => Inl(omega(below)),
                            Inr(above) => Inr(omega(above, fits)),
                        }),
                        Inr(other) => Inl(other),
                    };
                j(sym(put.proof.proof.right.proof.right), λ x _ => data.read(x, spans.byte(c, t)) = data.read(before, spans.byte(c, t)),
                    j(sym(sub.byte(v, k, inside)),
                        λ a _ => data.read(stack.writes.store(m, a, bytes), spans.byte(c, t)) = data.read(before, spans.byte(c, t)),
                        trans(loan.apart(m, sub.parent(v), sub.offset(v) + k, sub.written(v, written), omega(inside, sub.inside(v)),
                            bytes, omega(fits, sub.inside(v)), c, t, short, differ), held)))
            },
        }, before, after, refl, wrote)
}

// A span no piece to write is of reads what it did.
theorem Loan::sub_unwritten_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat},
    {spans: Spans}, self loan: Loan<M>(fetch, data, stack, top, spans), pieces: Spans, sub: Sub(spans, pieces), i: Nat, low: i <= top,
    c: Nat, unviewed: (v: Nat) → pieces.written(v) = True → sub.parent(v) ≠ c, ys: List<BitVec(8)>, fits: ys.len() <= spans.size(c),
    before, after: M, wrote: stack.WroteIn(i, pieces, before, after), reads: Readable(data, before, spans.at(c), ys)):
    Readable(data, after, spans.at(c), ys) {
    ⟨reads.left, λ t short => trans(loan.sub_outside(pieces, sub, i, low, c, t, omega(short, fits),
        λ v written _ same => false_elim(unviewed(v, written, same)), before, after, wrote), reads.right(t, short))⟩
}

// A span one piece to write is of, and no other: after the stores it reads
// its bytes with the piece's replaced by what the piece reads, where it
// lies in the span.
theorem Loan::sub_written_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat},
    {spans: Spans}, self loan: Loan<M>(fetch, data, stack, top, spans), pieces: Spans, sub: Sub(spans, pieces), i: Nat, low: i <= top,
    v: Nat, only: (u: Nat) → pieces.written(u) = True → sub.parent(u) = sub.parent(v) → u = v, xs, ys: List<BitVec(8)>,
    whole: xs.len() = spans.size(sub.parent(v)), same_len: ys.len() = pieces.size(v), before, after: M,
    wrote: stack.WroteIn(i, pieces, before, after), was: Readable(data, before, spans.at(sub.parent(v)), xs),
    now: Readable(data, after, spans.byte(sub.parent(v), sub.offset(v)), ys)):
    Readable(data, after, spans.at(sub.parent(v)), xs.put_window(sub.offset(v), ys)) {
    readable_put_window(data, before, after, spans.at(sub.parent(v)), xs, ys, sub.offset(v), omega(whole, same_len, sub.inside(v)), was, now,
        λ t short out => loan.sub_outside(pieces, sub, i, low, sub.parent(v), t, j(whole, λ n _ => t < n, short),
            λ u written _ same => j(sym(only(u, written, same)), λ w _ => (t < sub.offset(w)) ∨ (sub.offset(w) + pieces.size(w) <= t),
                match out {
                    Inl(below) => Inl(below),
                    Inr(past) => Inr(omega(past, same_len)),
                }), before, after, wrote))
}

// A byte `t` of span `c` after the stores, as the list `zs` says it: a
// piece to write of `c` covers it and `zs` has what that piece reads now
// (`ys(v)`), or no piece to write of `c` covers it and `zs` has what the
// span read before (`xs`).
fn SubCovers(pieces: Spans, parent, offset: Nat → Nat, c, t: Nat, ys: Nat → List<BitVec(8)>, xs, zs: List<BitVec(8)>) → Type {
    Exists<Nat>(λ v => (pieces.written(v) = True ∧ parent(v) = c) ∧
        ((offset(v) <= t ∧ t < offset(v) + ys(v).len()) ∧ zs.nth(t) = ys(v).nth(t - offset(v)))) ∨
    (((v: Nat) → pieces.written(v) = True → parent(v) = c → (t < offset(v)) ∨ (offset(v) + pieces.size(v) <= t)) ∧
        zs.nth(t) = xs.nth(t))
}

// A span any number of pieces to write are of: after the stores it reads
// the list that has, at each byte, what the piece covering it reads now,
// or what the span read before where none covers it. (The pieces to write
// of one span lie apart, `Sub.apart`, so one piece covers a byte.)
theorem Loan::sub_windows_reads<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat},
    {spans: Spans}, self loan: Loan<M>(fetch, data, stack, top, spans), pieces: Spans, sub: Sub(spans, pieces), i: Nat, low: i <= top,
    c: Nat, xs, zs: List<BitVec(8)>, ys: Nat → List<BitVec(8)>, same_len: zs.len() = xs.len(), fits: xs.len() <= spans.size(c),
    before, after: M, wrote: stack.WroteIn(i, pieces, before, after), was: Readable(data, before, spans.at(c), xs),
    now: (v: Nat) → pieces.written(v) = True → sub.parent(v) = c → Readable(data, after, spans.byte(sub.parent(v), sub.offset(v)), ys(v)),
    covers: (t: Nat) → t < xs.len() → SubCovers(pieces, sub.parent, sub.offset, c, t, ys, xs, zs)): Readable(data, after, spans.at(c), zs) {
    ⟨j(sym(same_len), λ n _ => spans.at(c).toNat() + n <= Nat::pow(2, 47), was.left),
     λ t short => {
        let in_xs: (t < xs.len()) = j(same_len, λ n _ => t < n, short);
        match covers(t, in_xs) {
            Inl(found) => {
                let v = found.witness;
                let from: (sub.offset(v) <= t) = found.proof.right.left.left;
                let inside: (t < sub.offset(v) + ys(v).len()) = found.proof.right.left.right;
                let parts: (sub.offset(v) + (t - sub.offset(v)) = t) = omega(from);
                let reads: (data.read(after, next_rip(spans.byte(sub.parent(v), sub.offset(v)), t - sub.offset(v))) = ys(v).nth(t - sub.offset(v))) =
                    now(v, found.proof.left.left, found.proof.left.right).right(t - sub.offset(v), omega(from, inside));
                let at: (next_rip(spans.byte(sub.parent(v), sub.offset(v)), t - sub.offset(v)) = next_rip(spans.at(c), t)) =
                    trans(rip_compose(spans.at(sub.parent(v)), sub.offset(v), t - sub.offset(v)),
                        trans(cong_fn<Nat, BitVec(64)>(λ n => next_rip(spans.at(sub.parent(v)), n), parts),
                            cong_fn<Nat, BitVec(64)>(λ b => next_rip(spans.at(b), t), found.proof.left.right)));
                trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ a => data.read(after, a), sym(at)), trans(reads, sym(found.proof.right.right)))
            },
            Inr(outside) => trans(loan.sub_outside(pieces, sub, i, low, c, t, omega(in_xs, fits), λ v written _ of => outside.left(v, written, of),
                    before, after, wrote),
                trans(was.right(t, in_xs), sym(outside.right))),
        }
     }⟩
}

// ---------------------------------------------------------------------------
// Blocks with a shadow of references

// A place in a heap: a block and a byte offset.
record Loc { block: Nat, offset: Nat }

fn Loc::plus(self loc: Loc, t: Nat) → Loc { Loc(loc.block, loc.offset + t) }

// Where a place lies: block `b` lies at span `b`.
fn Loc::address(self loc: Loc, spans: Spans) → BitVec(64) { spans.byte(loc.block, loc.offset) }

// The eight bytes of block `block` from byte `at` hold a reference to
// `target`.
record Pointer { block: Nat, at: Nat, target: Loc }

// Byte `j` of block `b` is one of the pointer's.
fn Pointer::covers(self e: Pointer, b, j: Nat) → Bool { e.block.same(b) && (e.at.leb(j) && (j + 1).leb(e.at + 8)) }

// The `n` bytes of block `b` from `k` share a byte with the pointer's.
fn Pointer::overlaps(self e: Pointer, b, k, n: Nat) → Bool { e.block.same(b) && ((e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8)) }

// They share a byte and are not the pointer's eight: a store there would
// leave part of a reference.
fn Pointer::cuts(self e: Pointer, b, k, n: Nat) → Bool { e.overlaps(b, k, n) && !(e.at.same(k) && n.same(8)) }

fn Pointer::exactly(self e: Pointer, b, k: Nat) → Bool { e.block.same(b) && e.at.same(k) }

fn covered(shadow: List<Pointer>, b, j: Nat) → Bool {
    match shadow { Nil => False, Cons(e, rest) => e.covers(b, j) || covered(rest, b, j) }
}

fn touched(shadow: List<Pointer>, b, k, n: Nat) → Bool {
    match shadow { Nil => False, Cons(e, rest) => e.overlaps(b, k, n) || touched(rest, b, k, n) }
}

fn cut(shadow: List<Pointer>, b, k, n: Nat) → Bool {
    match shadow { Nil => False, Cons(e, rest) => e.cuts(b, k, n) || cut(rest, b, k, n) }
}

// The reference held at the eight bytes of block `b` from `k`.
fn found(shadow: List<Pointer>, b, k: Nat) → Option<Loc> {
    match shadow {
        Nil => None,
        Cons(e, rest) => match e.exactly(b, k) { True => Some(e.target), False => found(rest, b, k) },
    }
}

// The shadow without the pointers a store of `n` bytes at `k` overlaps.
fn cleared(shadow: List<Pointer>, b, k, n: Nat) → List<Pointer> {
    match shadow {
        Nil => Nil,
        Cons(e, rest) => match e.overlaps(b, k, n) { True => cleared(rest, b, k, n), False => Cons(e, cleared(rest, b, k, n)) },
    }
}

// Each block's bytes, by number, which eight-byte slots hold a reference,
// and which bytes are undefined: a byte is plain, part of a reference, or
// undefined (a fresh block, a dead one, a window a failed `read` may have
// left junk in), and the injection says nothing of an undefined byte.
// FunctionIR's buffers are a heap with an empty shadow and nothing
// undefined (`Heap::of`, function_ir_lower_calls).
//
// The blocks are lists, by block number: each block's bytes, and its
// undefined flags (a flag past the list's end is defined), so a store
// updates a list and evaluating a run of stores is linear in it, where a
// closure layered per store made it quadratic. A block past the end of
// `blocks` reads as empty. The heap is used through `bytes` and
// `undefined`, never its fields.
record Heap { blocks: List<List<BitVec(8)>>, shadow: List<Pointer>, flags: List<List<Bool>> }

fn Heap::bytes(self heap: Heap, b: Nat) → List<BitVec(8)> { match heap.blocks.nth(b) { None => [], Some(bytes) => bytes } }

fn undefined_at(flags: List<Bool>, j: Nat) → Bool { match flags.nth(j) { None => False, Some(flag) => flag } }

fn Heap::undefined(self heap: Heap, b, j: Nat) → Bool { match heap.flags.nth(b) { None => False, Some(flags) => undefined_at(flags, j) } }

// The flags with the `n` from `k` cleared, the first of them at `i`.
fn clear_from(flags: List<Bool>, i, k, n: Nat) → List<Bool> {
    match flags { Nil => Nil, Cons(flag, rest) => Cons(flag && !(k.leb(i) && (i + 1).leb(k + n)), clear_from(rest, i + 1, k, n)) }
}

// No byte of the `n` from `k` of block `b` is undefined.
fn Heap::defined(self heap: Heap, b, k, n: Nat) → Bool {
    match n { Zero => True, Succ(m) => !heap.undefined(b, k + m) && heap.defined(b, k, m) }
}

// Byte `j` of block `b` is one of the `n` from `k`.
fn within(b, k, n, c, j: Nat) → Bool { c.same(b) && (k.leb(j) && (j + 1).leb(k + n)) }

fn set_block(bytes: Nat → List<BitVec(8)>, b: Nat, now: List<BitVec(8)>) → Nat → List<BitVec(8)> {
    λ (c: Nat) => match c.same(b) { True => now, False => bytes(c) }
}

// The byte at `loc`, zero past its block.
fn Heap::byte(self heap: Heap, loc: Loc) → BitVec(8) {
    match heap.bytes(loc.block).nth(loc.offset) { None => BitVec::zero(), Some(byte) => byte }
}

// The four and the eight bytes from `loc`, low first, as `MOV` reads them.
fn Heap::dword(self heap: Heap, loc: Loc) → BitVec(32) {
    imm32_from_bytes(heap.byte(loc.plus(0)), heap.byte(loc.plus(1)), heap.byte(loc.plus(2)), heap.byte(loc.plus(3)))
}

fn Heap::word(self heap: Heap, loc: Loc) → BitVec(64) {
    immediate_from_bytes(heap.byte(loc.plus(0)), heap.byte(loc.plus(1)), heap.byte(loc.plus(2)), heap.byte(loc.plus(3)),
        heap.byte(loc.plus(4)), heap.byte(loc.plus(5)), heap.byte(loc.plus(6)), heap.byte(loc.plus(7)))
}

// `n` bytes at `loc` lie in its block and cut no reference: they may be
// stored (eight over exactly a pointer replace it).
fn Heap::fits(self heap: Heap, loc: Loc, n: Nat) → Bool {
    (loc.offset + n).leb(heap.bytes(loc.block).len()) && !cut(heap.shadow, loc.block, loc.offset, n)
}

// `n` bytes at `loc` lie in its block and hold no part of a reference:
// they may be read as bytes.
fn Heap::plain(self heap: Heap, loc: Loc, n: Nat) → Bool {
    (loc.offset + n).leb(heap.bytes(loc.block).len()) && (!touched(heap.shadow, loc.block, loc.offset, n) && heap.defined(loc.block, loc.offset, n))
}

// Bytes stored at `loc`: the pointers they overlap are gone, and the bytes
// are defined.
fn Heap::store(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>) → Heap {
    Heap(heap.blocks.update(loc.block, λ (xs: List<BitVec(8)>) => xs.put_window(loc.offset, bytes)),
        cleared(heap.shadow, loc.block, loc.offset, bytes.len()),
        heap.flags.update(loc.block, λ (flags: List<Bool>) => clear_from(flags, 0, loc.offset, bytes.len())))
}

fn Heap::store_word(self heap: Heap, loc: Loc, word: BitVec(64)) → Heap { heap.store(loc, word_bytes(word)) }

// A reference stored: its eight bytes zero, the shadow saying what is
// there.
fn Heap::store_ref(self heap: Heap, loc, target: Loc) → Heap {
    Heap(heap.store_word(loc, BitVec::zero()).blocks, Cons(Pointer(loc.block, loc.offset, target), heap.store_word(loc, BitVec::zero()).shadow),
        heap.store_word(loc, BitVec::zero()).flags)
}

// ---------------------------------------------------------------------------
// Small facts

theorem Nat::leb_eq_true(a, b: Nat, le: a <= b): a.leb(b) = True { eq_true_of_is_true(a.leb(b), a.leb_complete(b, le)) }

theorem Nat::le_of_leb_eq(a, b: Nat, h: a.leb(b) = True): a <= b { a.leb_sound(b, Bool::is_true_of_eq(h)) }

theorem Bool::false_of_not_true({b: Bool}, h: !b = True): b = False {
    (match b as λ v => !v = True → v = False { True => λ never => absurd(never), False => λ _ => refl })(h)
}

theorem Nat::same_false_of(self a: Nat, b: Nat, differs: a ≠ b): a.same(b) = False {
    (match a.same(b) as λ v => a.same(b) = v → v = False {
        True => λ same => false_elim(differs(a.same_sound(b, same))),
        False => λ _ => refl,
    })(refl)
}

theorem Nat::same_of_eq(self a: Nat, b: Nat, equal: a = b): a.same(b) = True {
    j(equal, λ x _ => a.same(x) = True, a.same_self())
}

theorem set_block_here(bytes: Nat → List<BitVec(8)>, b: Nat, now: List<BitVec(8)>): set_block(bytes, b, now, b) = now {
    j(sym(b.same_self()), λ v _ => (match v { True => now, False => bytes(b) }) = now, refl)
}

theorem set_block_other(bytes: Nat → List<BitVec(8)>, b: Nat, now: List<BitVec(8)>, c: Nat, differs: c ≠ b):
    set_block(bytes, b, now, c) = bytes(c) {
    j(sym(c.same_false_of(b, differs)), λ v _ => (match v { True => now, False => bytes(c) }) = bytes(c), refl)
}

// An update at `i` reads, at `i`, what was there updated.
theorem List::nth_update_map<A>(self xs: List<A>): (i: Nat) → (f: A → A) → xs.update(i, f).nth(i) = xs.nth(i).map(f) {
    match xs {
        Nil => λ i f => refl,
        Cons(h, t) => λ i => match i { Zero => λ f => refl, Succ(k) => λ f => t.nth_update_map(k, f) },
    }
}

// A store into a block that has the byte it starts at: the block is its
// bytes with the stored ones written over them, every other block as it
// was.
theorem Heap::store_bytes(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, inside: loc.offset < heap.bytes(loc.block).len(), c: Nat):
    heap.store(loc, bytes).bytes(c) = set_block(λ (d: Nat) => heap.bytes(d), loc.block, heap.bytes(loc.block).put_window(loc.offset, bytes), c) {
    let f = λ (xs: List<BitVec(8)>) => xs.put_window(loc.offset, bytes);
    let read = λ (o: Option<List<BitVec(8)>>) => match o { None => [], Some(xs) => xs };
    match c.eq_dec(loc.block) {
        Inr(differs) => trans(cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(read, heap.blocks.nth_update_other(loc.block, f, c, differs)),
            sym(set_block_other(λ (d: Nat) => heap.bytes(d), loc.block, f(heap.bytes(loc.block)), c, differs))),
        Inl(same) => j(sym(same), λ x _ => heap.store(loc, bytes).bytes(x) = set_block(λ (d: Nat) => heap.bytes(d), loc.block, f(heap.bytes(loc.block)), x),
            trans((match heap.blocks.nth(loc.block) as λ o => heap.blocks.nth(loc.block) = o → loc.offset < read(o).len() →
                    read(heap.blocks.update(loc.block, f).nth(loc.block)) = f(read(o)) {
                    None => λ _ short => false_elim(short),
                    Some(xs) => λ here _ => cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(read, heap.blocks.nth_update_here(loc.block, f, xs, here)),
                })(refl, inside),
                sym(set_block_here(λ (d: Nat) => heap.bytes(d), loc.block, f(heap.bytes(loc.block)))))),
    }
}

// Clearing flags: a flag is the old one and not within the cleared bytes.
theorem clear_from_at(flags: List<Bool>, i, k, n, j: Nat):
    undefined_at(clear_from(flags, i, k, n), j) = undefined_at(flags, j) && !(k.leb(i + j) && (i + j + 1).leb(k + n)) {
    match flags {
        Nil => refl,
        Cons(flag, rest) => match j {
            Zero => refl,
            Succ(m) => trans(clear_from_at(rest, i + 1, k, n, m),
                cong_fn<Nat, Bool>(λ x => undefined_at(rest, m) && !(k.leb(x) && (x + 1).leb(k + n)), i.add_succ_left(m))),
        },
    }
}

// What a store leaves undefined: what was, outside the stored bytes.
theorem Heap::store_undefined(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, c, j: Nat):
    heap.store(loc, bytes).undefined(c, j) = heap.undefined(c, j) && !within(loc.block, loc.offset, bytes.len(), c, j) {
    let f = λ (flags: List<Bool>) => clear_from(flags, 0, loc.offset, bytes.len());
    let read = λ (o: Option<List<Bool>>) => match o { None => False, Some(flags) => undefined_at(flags, j) };
    match c.eq_dec(loc.block) {
        Inr(differs) => trans(cong_fn<Option<List<Bool>>, Bool>(read, heap.flags.nth_update_other(loc.block, f, c, differs)),
            sym(trans(cong_fn<Bool, Bool>(λ v => heap.undefined(c, j) && !(v && (loc.offset.leb(j) && (j + 1).leb(loc.offset + bytes.len()))),
                c.same_false_of(loc.block, differs)), Bool::and_true_r(heap.undefined(c, j))))),
        Inl(same) => j(sym(same), λ x _ => heap.store(loc, bytes).undefined(x, j) = heap.undefined(x, j) && !within(loc.block, loc.offset, bytes.len(), x, j),
            trans(cong_fn<Option<List<Bool>>, Bool>(read, heap.flags.nth_update_map(loc.block, f)),
                trans((match heap.flags.nth(loc.block) as λ o => read(o.map(f)) = read(o) && !(loc.offset.leb(0 + j) && (0 + j + 1).leb(loc.offset + bytes.len())) {
                        None => refl,
                        Some(flags) => clear_from_at(flags, 0, loc.offset, bytes.len(), j),
                    }),
                    cong_fn<Bool, Bool>(λ v => read(heap.flags.nth(loc.block)) && !v,
                        trans(cong_fn<Nat, Bool>(λ x => loc.offset.leb(x) && (x + 1).leb(loc.offset + bytes.len()), j.add_left_zero()),
                            sym(trans(cong_fn<Bool, Bool>(λ t => t && (loc.offset.leb(j) && (j + 1).leb(loc.offset + bytes.len())), loc.block.same_self()),
                                Bool::and_true_l(loc.offset.leb(j) && (j + 1).leb(loc.offset + bytes.len()))))))))),
    }
}

// The byte at a place inside its block is present.
theorem Heap::nth_byte(self heap: Heap, loc: Loc, inside: loc.offset < heap.bytes(loc.block).len()):
    heap.bytes(loc.block).nth(loc.offset) = Some(heap.byte(loc)) {
    let present = heap.bytes(loc.block).nth_present(loc.offset, inside);
    j(sym(present.proof), λ o _ => o = Some(match o { None => BitVec::zero(), Some(byte) => byte }), refl)
}

// A store's bytes are as long as before, block for block.
theorem Heap::store_len(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, fits: loc.offset + bytes.len() <= heap.bytes(loc.block).len(),
    inside: loc.offset < heap.bytes(loc.block).len(), c: Nat): heap.store(loc, bytes).bytes(c).len() = heap.bytes(c).len() {
    let now = heap.bytes(loc.block).put_window(loc.offset, bytes);
    trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), heap.store_bytes(loc, bytes, inside, c)), match c.eq_dec(loc.block) {
        Inl(same) => j(sym(same), λ x _ => set_block(λ (d: Nat) => heap.bytes(d), loc.block, now, x).len() = heap.bytes(x).len(),
            trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), set_block_here(λ (d: Nat) => heap.bytes(d), loc.block, now)),
                heap.bytes(loc.block).len_put_window(loc.offset, bytes, omega(fits)))),
        Inr(differs) => cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), set_block_other(λ (d: Nat) => heap.bytes(d), loc.block, now, c, differs)),
    })
}

// Outside the stored bytes, a store leaves a block's bytes.
theorem Heap::store_outside(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, fits: loc.offset + bytes.len() <= heap.bytes(loc.block).len(),
    inside: loc.offset < heap.bytes(loc.block).len(), c, i: Nat, outside: (loc.block ≠ c) ∨ ((i < loc.offset) ∨ (loc.offset + bytes.len() <= i))):
    heap.store(loc, bytes).bytes(c).nth(i) = heap.bytes(c).nth(i) {
    let xs = heap.bytes(loc.block);
    let now = xs.put_window(loc.offset, bytes);
    trans(cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(i), heap.store_bytes(loc, bytes, inside, c)), match c.eq_dec(loc.block) {
        Inr(differs) => cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(i), set_block_other(λ (d: Nat) => heap.bytes(d), loc.block, now, c, differs)),
        Inl(same) => {
            let side: ((i < loc.offset) ∨ (loc.offset + bytes.len() <= i)) = match outside {
                Inl(differs) => false_elim(differs(sym(same))),
                Inr(side) => side,
            };
            let here: (xs.put_window(loc.offset, bytes).nth(i) = xs.nth(i)) = match side {
                Inl(below) => xs.nth_put_window_before(loc.offset, bytes, i, below, omega(fits)),
                Inr(past) => {
                    let at: (i - (bytes.len() + loc.offset) + (bytes.len() + loc.offset) = i) = omega(past);
                    j(at, λ y _ => xs.put_window(loc.offset, bytes).nth(y) = xs.nth(y),
                        xs.nth_put_window_after(loc.offset, bytes, i - (bytes.len() + loc.offset), omega(fits)))
                },
            };
            j(sym(same), λ x _ => set_block(λ (d: Nat) => heap.bytes(d), loc.block, now, x).nth(i) = heap.bytes(x).nth(i),
                trans(cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(i), set_block_here(λ (d: Nat) => heap.bytes(d), loc.block, now)), here))
        },
    })
}

// Inside them, it reads them.
theorem Heap::store_inside(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, fits: loc.offset + bytes.len() <= heap.bytes(loc.block).len(),
    t: Nat, short: t < bytes.len()): heap.store(loc, bytes).bytes(loc.block).nth(loc.offset + t) = bytes.nth(t) {
    let xs = heap.bytes(loc.block);
    let window: (xs.put_window(loc.offset, bytes).nth(t + loc.offset) = bytes.nth(t)) =
        xs.nth_put_window_inside(loc.offset, bytes, t, short, omega(fits));
    trans(cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(loc.offset + t), heap.store_bytes(loc, bytes, omega(short, fits), loc.block)),
    trans(cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(loc.offset + t), set_block_here(λ (d: Nat) => heap.bytes(d), loc.block, xs.put_window(loc.offset, bytes))),
        trans(cong_fn<Nat, Option<BitVec(8)>>(λ y => xs.put_window(loc.offset, bytes).nth(y), omega()), window)))
}

// A byte not within `n` from `loc` is outside them.
theorem Heap::outside_within(self heap: Heap, loc: Loc, n, c, j: Nat, none: within(loc.block, loc.offset, n, c, j) = False):
    (loc.block ≠ c) ∨ ((j < loc.offset) ∨ (loc.offset + n <= j)) {
    match c.eq_dec(loc.block) {
        Inr(differs) => Inl(λ same => differs(sym(same))),
        Inl(same) => match j.lt_or_ge(loc.offset) {
            Inl(below) => Inr(Inl(below)),
            Inr(from) => match j.lt_or_ge(loc.offset + n) {
                Inr(past) => Inr(Inr(past)),
                Inl(inside) => absurd(trans(sym(Bool::and_true_of(c.same(loc.block), loc.offset.leb(j) && (j + 1).leb(loc.offset + n),
                        c.same_of_eq(loc.block, same),
                        Bool::and_true_of(loc.offset.leb(j), (j + 1).leb(loc.offset + n), Nat::leb_eq_true(loc.offset, j, from),
                            Nat::leb_eq_true(j + 1, loc.offset + n, omega(inside))))), none)),
            },
        },
    }
}

// A byte outside them is not within them.
theorem within_false(b, k, n, c, j: Nat, outside: (b ≠ c) ∨ ((j < k) ∨ (k + n <= j))): within(b, k, n, c, j) = False {
    (match within(b, k, n, c, j) as λ v => within(b, k, n, c, j) = v → v = False {
        False => λ _ => refl,
        True => λ inside => {
            let parts = Bool::and_true_parts(c.same(b), k.leb(j) && (j + 1).leb(k + n), inside);
            let block: (c = b) = c.same_sound(b, parts.left);
            let range = Bool::and_true_parts(k.leb(j), (j + 1).leb(k + n), parts.right);
            let low = Nat::le_of_leb_eq(k, j, range.left);
            let high = Nat::le_of_leb_eq(j + 1, k + n, range.right);
            match outside {
                Inl(differs) => false_elim(differs(sym(block))),
                Inr(side) => match side { Inl(below) => false_elim(omega(below, low)), Inr(past) => false_elim(omega(past, high)) },
            }
        },
    })(refl)
}

// A store leaves which bytes outside it are undefined.
theorem Heap::store_undefined_outside(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, c, j: Nat,
    outside: (loc.block ≠ c) ∨ ((j < loc.offset) ∨ (loc.offset + bytes.len() <= j))):
    heap.store(loc, bytes).undefined(c, j) = heap.undefined(c, j) {
    trans(heap.store_undefined(loc, bytes, c, j),
        trans(cong_fn<Bool, Bool>(λ v => heap.undefined(c, j) && !v, within_false(loc.block, loc.offset, bytes.len(), c, j, outside)),
            Bool::and_true_r(heap.undefined(c, j))))
}

// Defined bytes, one at a time.
theorem Heap::defined_at(self heap: Heap, b, k, n: Nat): heap.defined(b, k, n) = True → (t: Nat) → t < n → heap.undefined(b, k + t) = False {
    match n {
        Zero => λ _ t short => false_elim(short),
        Succ(m) => λ all t short => {
            let parts = Bool::and_true_parts(!heap.undefined(b, k + m), heap.defined(b, k, m), all);
            match t.eq_dec(m) {
                Inl(here) => j(sym(here), λ u _ => heap.undefined(b, k + u) = False, Bool::false_of_not_true(parts.left)),
                Inr(other) => heap.defined_at(b, k, m, parts.right, t, omega(short, other)),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// The shadow, pointer by pointer

// Every pointer of the shadow has `P`.
fn Every(shadow: List<Pointer>, P: Pointer → Type) → Type {
    match shadow { Nil => True, Cons(e, rest) => P(e) ∧ Every(rest, P) }
}

// A pointer the store does not overlap is kept.
theorem every_cleared(P: Pointer → Type, b, k, n: Nat, shadow: List<Pointer>): Every(shadow, P) → Every(cleared(shadow, b, k, n), P) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ all => (match e.overlaps(b, k, n) as λ v =>
                Every(match v { True => cleared(rest, b, k, n), False => Cons(e, cleared(rest, b, k, n)) }, P) {
            True => every_cleared(P, b, k, n, rest, all.right),
            False => ⟨all.left, every_cleared(P, b, k, n, rest, all.right)⟩,
        }),
    }
}

// Every pointer left by the clearing is apart from the stored bytes.
theorem every_cleared_apart(b, k, n: Nat, shadow: List<Pointer>): Every(cleared(shadow, b, k, n), λ (e: Pointer) => e.overlaps(b, k, n) = False) {
    match shadow {
        Nil => trivial,
        Cons(e, rest) => (match e.overlaps(b, k, n) as λ v => e.overlaps(b, k, n) = v →
                Every(match v { True => cleared(rest, b, k, n), False => Cons(e, cleared(rest, b, k, n)) }, λ (d: Pointer) => d.overlaps(b, k, n) = False) {
            True => λ _ => every_cleared_apart(b, k, n, rest),
            False => λ apart => ⟨apart, every_cleared_apart(b, k, n, rest)⟩,
        })(refl),
    }
}

// The reference `found` names is a pointer's.
theorem every_found(P: Pointer → Type, b, k: Nat, target: Loc, shadow: List<Pointer>): Every(shadow, P) → found(shadow, b, k) = Some(target) →
    P(Pointer(b, k, target)) {
    match shadow {
        Nil => λ _ none => absurd(none),
        Cons(e, rest) => λ all => (match e.exactly(b, k) as λ v => e.exactly(b, k) = v →
                (match v { True => Some(e.target), False => found(rest, b, k) }) = Some(target) → P(Pointer(b, k, target)) {
            True => λ exact here => {
                let parts = Bool::and_true_parts(e.block.same(b), e.at.same(k), exact);
                let block: (e.block = b) = e.block.same_sound(b, parts.left);
                let at: (e.at = k) = e.at.same_sound(k, parts.right);
                let aimed: (e.target = target) = Option::some_inj(e.target, target, here);
                j(block, λ x _ => P(Pointer(x, k, target)), j(at, λ y _ => P(Pointer(e.block, y, target)), j(aimed, λ t _ => P(Pointer(e.block, e.at, t)), all.left)))
            },
            False => λ _ there => every_found(P, b, k, target, rest, all.right, there),
        })(refl),
    }
}

theorem every_untouched(b, k, n: Nat, shadow: List<Pointer>): touched(shadow, b, k, n) = False →
    Every(shadow, λ (e: Pointer) => e.overlaps(b, k, n) = False) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ none => {
            let parts = Bool::or_false_parts(e.overlaps(b, k, n), touched(rest, b, k, n), none);
            ⟨parts.left, every_untouched(b, k, n, rest, parts.right)⟩
        },
    }
}

theorem every_uncut(b, k, n: Nat, shadow: List<Pointer>): cut(shadow, b, k, n) = False → Every(shadow, λ (e: Pointer) => e.cuts(b, k, n) = False) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ none => {
            let parts = Bool::or_false_parts(e.cuts(b, k, n), cut(rest, b, k, n), none);
            ⟨parts.left, every_uncut(b, k, n, rest, parts.right)⟩
        },
    }
}

// A byte no pointer covers, one at a time, is not covered.
theorem every_covered_of(b, j: Nat, shadow: List<Pointer>): Every(shadow, λ (e: Pointer) => e.covers(b, j) = False) → covered(shadow, b, j) = False {
    match shadow {
        Nil => λ _ => refl,
        Cons(e, rest) => λ all => Bool::or_false_of(e.covers(b, j), covered(rest, b, j), all.left, every_covered_of(b, j, rest, all.right)),
    }
}

// `P` follows pointer by pointer.
theorem every_map(P, Q: Pointer → Type, f: (e: Pointer) → P(e) → Q(e), shadow: List<Pointer>): Every(shadow, P) → Every(shadow, Q) {
    match shadow {
        Nil => λ _ => trivial,
        Cons(e, rest) => λ all => ⟨f(e, all.left), every_map(P, Q, f, rest, all.right)⟩,
    }
}

theorem every_both(P, Q: Pointer → Type, shadow: List<Pointer>): Every(shadow, P) → Every(shadow, Q) → Every(shadow, λ (e: Pointer) => P(e) ∧ Q(e)) {
    match shadow {
        Nil => λ _ _ => trivial,
        Cons(_, rest) => λ p q => ⟨⟨p.left, q.left⟩, every_both(P, Q, rest, p.right, q.right)⟩,
    }
}

// A store the pointer does not overlap lies apart from it.
theorem Pointer::apart_of(self e: Pointer, b, k, n: Nat, apart: e.overlaps(b, k, n) = False): (b ≠ e.block) ∨ ((e.at + 8 <= k) ∨ (k + n <= e.at)) {
    match e.block.eq_dec(b) {
        Inr(differs) => Inl(λ same => differs(sym(same))),
        Inl(same) => match (e.at + 7).lt_or_ge(k) {
            Inl(below) => Inr(Inl(omega(below))),
            Inr(ge) => match (k + n).lt_or_ge(e.at + 1) {
                Inl(below) => Inr(Inr(omega(below))),
                Inr(ge2) => absurd(trans(sym(Bool::and_true_of(e.block.same(b), (e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8),
                        e.block.same_of_eq(b, same),
                        Bool::and_true_of((e.at + 1).leb(k + n), (k + 1).leb(e.at + 8), Nat::leb_eq_true(e.at + 1, k + n, omega(ge2)),
                            Nat::leb_eq_true(k + 1, e.at + 8, omega(ge))))), apart)),
            },
        },
    }
}

// A byte a pointer does not cover lies outside its eight.
theorem Pointer::uncovers(self e: Pointer, c, j: Nat, none: e.covers(c, j) = False): (e.block ≠ c) ∨ ((j < e.at) ∨ (e.at + 8 <= j)) {
    match e.block.eq_dec(c) {
        Inr(differs) => Inl(differs),
        Inl(same) => match j.lt_or_ge(e.at) {
            Inl(below) => Inr(Inl(below)),
            Inr(ge) => match j.lt_or_ge(e.at + 8) {
                Inl(inside) => absurd(trans(sym(Bool::and_true_of(e.block.same(c), e.at.leb(j) && (j + 1).leb(e.at + 8),
                        e.block.same_of_eq(c, same),
                        Bool::and_true_of(e.at.leb(j), (j + 1).leb(e.at + 8), Nat::leb_eq_true(e.at, j, ge),
                            Nat::leb_eq_true(j + 1, e.at + 8, omega(inside))))), none)),
                Inr(above) => Inr(Inr(above)),
            },
        },
    }
}

// A pointer covering a byte of `n` overlaps the `n`.
theorem Pointer::covers_overlaps(self e: Pointer, b, k, n, t: Nat, short: t < n, here: e.covers(b, k + t) = True): e.overlaps(b, k, n) = True {
    let parts = Bool::and_true_parts(e.block.same(b), e.at.leb(k + t) && (k + t + 1).leb(e.at + 8), here);
    let range = Bool::and_true_parts(e.at.leb(k + t), (k + t + 1).leb(e.at + 8), parts.right);
    let low = Nat::le_of_leb_eq(e.at, k + t, range.left);
    let high = Nat::le_of_leb_eq(k + t + 1, e.at + 8, range.right);
    Bool::and_true_of(e.block.same(b), (e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8), parts.left,
        Bool::and_true_of((e.at + 1).leb(k + n), (k + 1).leb(e.at + 8), Nat::leb_eq_true(e.at + 1, k + n, omega(low, short)),
            Nat::leb_eq_true(k + 1, e.at + 8, omega(high))))
}

// `n` bytes no pointer overlaps: none of them is covered.
theorem untouched_uncovered(b, k, n, t: Nat, short: t < n, shadow: List<Pointer>, none: touched(shadow, b, k, n) = False):
    covered(shadow, b, k + t) = False {
    every_covered_of(b, k + t, shadow, every_map(λ (e: Pointer) => e.overlaps(b, k, n) = False, λ (e: Pointer) => e.covers(b, k + t) = False,
        λ e apart => (match e.covers(b, k + t) as λ v => e.covers(b, k + t) = v → v = False {
            True => λ here => absurd(trans(sym(e.covers_overlaps(b, k, n, t, short, here)), apart)),
            False => λ _ => refl,
        })(refl), shadow, every_untouched(b, k, n, shadow, none)))
}

// What the cleared shadow covers, the shadow covered, but for the stored
// bytes: a pointer the store overlaps and does not cut lies on them.
theorem Pointer::covers_stored(self e: Pointer, b, k, n, c, j: Nat, uncut: e.cuts(b, k, n) = False, overlap: e.overlaps(b, k, n) = True,
    here: e.covers(c, j) = True): (c = b) ∧ ((k <= j) ∧ (j < k + n)) {
    let o = Bool::and_true_parts(e.block.same(b), (e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8), overlap);
    let block: (e.block = b) = e.block.same_sound(b, o.left);
    let h = Bool::and_true_parts(e.block.same(c), e.at.leb(j) && (j + 1).leb(e.at + 8), here);
    let hc: (e.block = c) = e.block.same_sound(c, h.left);
    let range = h.right;
    let both: ((e.at.same(k) && n.same(8)) = True) = (match e.at.same(k) && n.same(8) as λ v => (e.at.same(k) && n.same(8)) = v → v = True {
        True => λ _ => refl,
        False => λ differs => absurd(trans(sym(uncut), j(sym(overlap), λ o _ => (o && !(e.at.same(k) && n.same(8))) = True,
            j(sym(differs), λ v _ => (True && !v) = True, refl)))),
    })(refl);
    let parts = Bool::and_true_parts(e.at.same(k), n.same(8), both);
    let at: (e.at = k) = e.at.same_sound(k, parts.left);
    let eight: (n = 8) = n.same_sound(8, parts.right);
    ⟨trans(sym(hc), block), omega(range, at, eight)⟩
}

theorem uncovered_after_clearing(b, k, n, c, j: Nat, shadow: List<Pointer>): Every(shadow, λ (e: Pointer) => e.cuts(b, k, n) = False) →
    covered(cleared(shadow, b, k, n), c, j) = False → ((c = b) ∧ ((k <= j) ∧ (j < k + n))) ∨ (covered(shadow, c, j) = False) {
    match shadow {
        Nil => λ _ _ => Inr(refl),
        Cons(e, rest) => λ uncut => (match e.overlaps(b, k, n) as λ v => e.overlaps(b, k, n) = v →
                covered(match v { True => cleared(rest, b, k, n), False => Cons(e, cleared(rest, b, k, n)) }, c, j) = False →
                ((c = b) ∧ ((k <= j) ∧ (j < k + n))) ∨ (covered(Cons(e, rest), c, j) = False) {
            True => λ overlap none => match uncovered_after_clearing(b, k, n, c, j, rest, uncut.right, none) {
                Inl(stored) => Inl(stored),
                Inr(rest_none) => (match e.covers(c, j) as λ v => e.covers(c, j) = v →
                        ((c = b) ∧ ((k <= j) ∧ (j < k + n))) ∨ ((v || covered(rest, c, j)) = False) {
                    True => λ here => Inl(e.covers_stored(b, k, n, c, j, uncut.left, overlap, here)),
                    False => λ _ => Inr(rest_none),
                })(refl),
            },
            False => λ _ none => {
                let parts = Bool::or_false_parts(e.covers(c, j), covered(cleared(rest, b, k, n), c, j), none);
                match uncovered_after_clearing(b, k, n, c, j, rest, uncut.right, parts.right) {
                    Inl(stored) => Inl(stored),
                    Inr(rest_none) => Inr(Bool::or_false_of(e.covers(c, j), covered(rest, c, j), parts.left, rest_none)),
                }
            },
        })(refl),
    }
}

// ---------------------------------------------------------------------------
// The heap canonical

// Canonical: under every pointer, inside its block, a zero word's eight
// bytes, and every undefined byte zero.
fn Heap::Canonical(self heap: Heap) → Type {
    Every(heap.shadow, λ (e: Pointer) => (e.at + 8 <= heap.bytes(e.block).len()) ∧
        ((t: Nat) → t < 8 → heap.bytes(e.block).nth(e.at + t) = word_bytes(BitVec::zero()).nth(t))) ∧
    ((b, j: Nat) → heap.undefined(b, j) = True → j < heap.bytes(b).len() → heap.bytes(b).nth(j) = Some(BitVec::zero()))
}

// A pointer the store does not overlap keeps its eight bytes.
theorem Heap::canonical_kept(self heap: Heap, loc: Loc, bytes: List<BitVec(8)>, fits: loc.offset + bytes.len() <= heap.bytes(loc.block).len(),
    inside: loc.offset < heap.bytes(loc.block).len(),
    e: Pointer, apart: e.overlaps(loc.block, loc.offset, bytes.len()) = False,
    zero: (e.at + 8 <= heap.bytes(e.block).len()) ∧ ((t: Nat) → t < 8 → heap.bytes(e.block).nth(e.at + t) = word_bytes(BitVec::zero()).nth(t))):
    (e.at + 8 <= heap.store(loc, bytes).bytes(e.block).len()) ∧
        ((t: Nat) → t < 8 → heap.store(loc, bytes).bytes(e.block).nth(e.at + t) = word_bytes(BitVec::zero()).nth(t)) {
    let side = e.apart_of(loc.block, loc.offset, bytes.len(), apart);
    ⟨j(sym(heap.store_len(loc, bytes, fits, inside, e.block)), λ l _ => e.at + 8 <= l, zero.left),
     λ t short => trans(heap.store_outside(loc, bytes, fits, inside, e.block, e.at + t, match side {
            Inl(differs) => Inl(differs),
            Inr(order) => Inr(match order { Inl(below) => Inl(omega(below, short)), Inr(above) => Inr(omega(above)) }),
        }), zero.right(t, short))⟩
}

// Every store keeps the heap canonical,
theorem Heap::canonical_store(self heap: Heap, canonical: heap.Canonical(), loc: Loc, bytes: List<BitVec(8)>,
    fits: loc.offset + bytes.len() <= heap.bytes(loc.block).len(), inside: loc.offset < heap.bytes(loc.block).len()): heap.store(loc, bytes).Canonical() {
    let b = loc.block;
    let k = loc.offset;
    let n = bytes.len();
    let P = λ (e: Pointer) => (e.at + 8 <= heap.bytes(e.block).len()) ∧ ((t: Nat) → t < 8 → heap.bytes(e.block).nth(e.at + t) = word_bytes(BitVec::zero()).nth(t));
    ⟨every_map(λ (e: Pointer) => P(e) ∧ (e.overlaps(b, k, n) = False),
        λ (e: Pointer) => (e.at + 8 <= heap.store(loc, bytes).bytes(e.block).len()) ∧
            ((t: Nat) → t < 8 → heap.store(loc, bytes).bytes(e.block).nth(e.at + t) = word_bytes(BitVec::zero()).nth(t)),
        λ e both => heap.canonical_kept(loc, bytes, fits, inside, e, both.right, both.left),
        cleared(heap.shadow, b, k, n),
        every_both(P, λ (e: Pointer) => e.overlaps(b, k, n) = False, cleared(heap.shadow, b, k, n),
            every_cleared(P, b, k, n, heap.shadow, canonical.left), every_cleared_apart(b, k, n, heap.shadow))),
     λ c j undefined short => {
        let parts = Bool::and_true_parts(heap.undefined(c, j), !within(b, k, n, c, j), trans(sym(heap.store_undefined(loc, bytes, c, j)), undefined));
        let outside = heap.outside_within(loc, n, c, j, Bool::false_of_not_true(parts.right));
        let len: (heap.store(loc, bytes).bytes(c).len() = heap.bytes(c).len()) = heap.store_len(loc, bytes, fits, inside, c);
        trans(heap.store_outside(loc, bytes, fits, inside, c, j, outside), canonical.right(c, j, parts.left, omega(short, len)))
     }⟩
}

// and so does a pointer stored, over its zeroed bytes.
theorem Heap::canonical_store_ref(self heap: Heap, canonical: heap.Canonical(), loc, target: Loc,
    fits: loc.offset + 8 <= heap.bytes(loc.block).len()): heap.store_ref(loc, target).Canonical() {
    let zeroed = heap.store_word(loc, BitVec::zero());
    let len: (heap.store_ref(loc, target).bytes(loc.block).len() = heap.bytes(loc.block).len()) = heap.store_len(loc, word_bytes(BitVec::zero()), fits, omega(fits), loc.block);
    let zero = heap.canonical_store(canonical, loc, word_bytes(BitVec::zero()), fits, omega(fits));
    ⟨⟨⟨omega(len, fits), λ t short => heap.store_inside(loc, word_bytes(BitVec::zero()), fits, t, short)⟩, zero.left⟩, zero.right⟩
}

// ---------------------------------------------------------------------------
// The injection

// The pointer's eight bytes lie in its block and read its target's address.
fn Pointer::Held<M>(self e: Pointer, data: ByteReadAccess<M>, spans: Spans, memory: M) → Type {
    (e.at + 8 <= spans.size(e.block)) ∧ (read_word(data, memory, spans.byte(e.block, e.at)) = Some(e.target.address(spans)))
}

// The heap lies in memory: block `b` at span `b`, as long as it; a defined
// byte no pointer covers reads the block's byte; a pointer reads its
// target's address; an undefined byte reads anything.
record Injected<M>(data: ByteReadAccess<M>, spans: Spans, heap: Heap, memory: M) {
    sizes: (b: Nat) → heap.bytes(b).len() = spans.size(b),
    bytes: (b, k: Nat) → k < spans.size(b) → covered(heap.shadow, b, k) = False → heap.undefined(b, k) = False →
        data.read(memory, spans.byte(b, k)) = heap.bytes(b).nth(k),
    refs: Every(heap.shadow, λ (e: Pointer) => e.Held(data, spans, memory)),
}

// An injection depends on a heap's bytes block by block.
theorem Injected::same_bytes<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    other: Heap, same: (b: Nat) → other.bytes(b) = heap.bytes(b), shadow: other.shadow = heap.shadow,
    undefined: (b, k: Nat) → other.undefined(b, k) = heap.undefined(b, k)): Injected<M>(data, spans, other, memory) {
    Injected(
        sizes := λ b => trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), same(b)), inj.sizes(b)),
        bytes := λ b k inside none defined => trans(inj.bytes(b, k, inside, trans(cong_fn<List<Pointer>, Bool>(λ sh => covered(sh, b, k), sym(shadow)), none),
                trans(sym(undefined(b, k)), defined)),
            cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ l => l.nth(k), sym(same(b)))),
        refs := j(sym(shadow), λ sh _ => Every(sh, λ (e: Pointer) => e.Held(data, spans, memory)), inj.refs),
    )
}

// Eight bytes that read a word's bytes read the word.
theorem read_word_of_bytes<M>(data: ByteReadAccess<M>, memory: M, a: BitVec(64), word: BitVec(64),
    reads: (t: Nat) → t < 8 → data.read(memory, next_rip(a, t)) = word_bytes(word).nth(t)): read_word(data, memory, a) = Some(word) {
    let o = λ (t: Nat) => data.read(memory, next_rip(a, t));
    trans(word_of_eight(o(0), o(1), o(2), o(3), o(4), o(5), o(6), o(7),
            imm_byte0(word), imm_byte1(word), imm_byte2(word), imm_byte3(word),
            imm_byte4(word), imm_byte5(word), imm_byte6(word), imm_byte7(word),
            reads(0, trivial), reads(1, trivial), reads(2, trivial), reads(3, trivial),
            reads(4, trivial), reads(5, trivial), reads(6, trivial), reads(7, trivial)),
        cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), immediate_bytes_roundtrip(word)))
}

// A word stored into a written span reads back.
theorem Loan::word_stored<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), memory: M, b, k: Nat, written: spans.written(b) = True, fits: k + 8 <= spans.size(b),
    word: BitVec(64)): read_word(data, stack.writes.store(memory, spans.byte(b, k), word_bytes(word)), spans.byte(b, k)) = Some(word) {
    let after = stack.writes.store(memory, spans.byte(b, k), word_bytes(word));
    read_word_of_bytes(data, after, spans.byte(b, k), word, λ t short =>
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ y => data.read(after, y), rip_compose(spans.at(b), k, t)),
            loan.stored(memory, b, k, written, omega(fits), word_bytes(word), fits, t, short)))
}

// What a pointer held, a store apart from it keeps.
theorem Loan::held_kept<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), memory: M, b, k: Nat, written: spans.written(b) = True, inside: k < spans.size(b),
    bytes: List<BitVec(8)>, fits: k + bytes.len() <= spans.size(b), shadow: List<Pointer>,
    refs: Every(shadow, λ (e: Pointer) => e.Held(data, spans, memory))):
    Every(cleared(shadow, b, k, bytes.len()), λ (e: Pointer) => e.Held(data, spans, stack.writes.store(memory, spans.byte(b, k), bytes))) {
    let after = stack.writes.store(memory, spans.byte(b, k), bytes);
    every_map(λ (e: Pointer) => e.Held(data, spans, memory) ∧ (e.overlaps(b, k, bytes.len()) = False),
        λ (e: Pointer) => e.Held(data, spans, after),
        λ e both => {
            let side = e.apart_of(b, k, bytes.len(), both.right);
            ⟨both.left.left, trans(read_word_agree(data, after, memory, spans.byte(e.block, e.at), λ t short =>
                j(sym(rip_compose(spans.at(e.block), e.at, t)), λ y _ => data.read(after, y) = data.read(memory, y),
                    loan.apart(memory, b, k, written, inside, bytes, fits, e.block, e.at + t, omega(short, both.left.left), match side {
                        Inl(differs) => Inl(differs),
                        Inr(order) => Inr(match order { Inl(below) => Inl(omega(below, short)), Inr(above) => Inr(omega(above)) }),
                    }))), both.left.right)⟩
        },
        cleared(shadow, b, k, bytes.len()),
        every_both(λ (e: Pointer) => e.Held(data, spans, memory), λ (e: Pointer) => e.overlaps(b, k, bytes.len()) = False, cleared(shadow, b, k, bytes.len()),
            every_cleared(λ (e: Pointer) => e.Held(data, spans, memory), b, k, bytes.len(), shadow, refs), every_cleared_apart(b, k, bytes.len(), shadow)))
}

// ---------------------------------------------------------------------------
// Each store keeps the injection

// Bytes stored at `loc`, of any width, where they cut no reference: the heap
// with them stored is injected.
theorem Loan::store_injected<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, written: spans.written(loc.block) = True, inside: loc.offset < spans.size(loc.block), bytes: List<BitVec(8)>,
    ok: heap.fits(loc, bytes.len()) = True):
    Injected<M>(data, spans, heap.store(loc, bytes), stack.writes.store(memory, loc.address(spans), bytes)) {
    let b = loc.block;
    let k = loc.offset;
    let n = bytes.len();
    let parts = Bool::and_true_parts((k + n).leb(heap.bytes(b).len()), !cut(heap.shadow, b, k, n), ok);
    let fits: (k + n <= heap.bytes(b).len()) = Nat::le_of_leb_eq(k + n, heap.bytes(b).len(), parts.left);
    let uncut = every_uncut(b, k, n, heap.shadow, Bool::false_of_not_true(parts.right));
    let span_fits: (k + n <= spans.size(b)) = omega(fits, inj.sizes(b));
    let after = stack.writes.store(memory, spans.byte(b, k), bytes);
    Injected(
        sizes := λ c => trans(heap.store_len(loc, bytes, fits, omega(inside, inj.sizes(b)), c), inj.sizes(c)),
        bytes := λ c i short none defined => {
            let kept = λ (outside: (b ≠ c) ∨ ((i < k) ∨ (k + n <= i))) => {
                let old: (covered(heap.shadow, c, i) = False) = match uncovered_after_clearing(b, k, n, c, i, heap.shadow, uncut, none) {
                    Inl(stored) => match outside {
                        Inl(differs) => false_elim(differs(sym(stored.left))),
                        Inr(side) => match side {
                            Inl(below) => false_elim(omega(below, stored.right)),
                            Inr(above) => false_elim(omega(above, stored.right)),
                        },
                    },
                    Inr(old) => old,
                };
                trans(loan.apart(memory, b, k, written, inside, bytes, span_fits, c, i, short, outside),
                    trans(inj.bytes(c, i, short, old, trans(sym(heap.store_undefined_outside(loc, bytes, c, i, outside)), defined)),
                        sym(heap.store_outside(loc, bytes, fits, omega(inside, inj.sizes(b)), c, i, outside))))
            };
            match b.eq_dec(c) {
                Inr(differs) => kept(Inl(differs)),
                Inl(same) => match i.lt_or_ge(k) {
                    Inl(below) => kept(Inr(Inl(below))),
                    Inr(from) => match i.lt_or_ge(k + n) {
                        Inr(past) => kept(Inr(Inr(past))),
                        Inl(within) => {
                            let t = i - k;
                            let at: (k + t = i) = omega(from);
                            j(same, λ x _ => data.read(after, spans.byte(x, i)) = heap.store(loc, bytes).bytes(x).nth(i),
                                j(at, λ y _ => data.read(after, spans.byte(b, y)) = heap.store(loc, bytes).bytes(b).nth(y),
                                    trans(loan.stored(memory, b, k, written, inside, bytes, span_fits, t, omega(from, within)),
                                        sym(heap.store_inside(loc, bytes, fits, t, omega(from, within))))))
                        },
                    },
                },
            }
        },
        refs := loan.held_kept(memory, b, k, written, inside, bytes, span_fits, heap.shadow, inj.refs),
    )
}

// A word, eight bytes at `loc`.
theorem Loan::store_word_injected<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, written: spans.written(loc.block) = True, ok: heap.fits(loc, 8) = True, word: BitVec(64)):
    Injected<M>(data, spans, heap.store_word(loc, word), stack.writes.store(memory, loc.address(spans), word_bytes(word))) {
    let parts = Bool::and_true_parts((loc.offset + 8).leb(heap.bytes(loc.block).len()), !cut(heap.shadow, loc.block, loc.offset, 8), ok);
    let fits: (loc.offset + 8 <= heap.bytes(loc.block).len()) = Nat::le_of_leb_eq(loc.offset + 8, heap.bytes(loc.block).len(), parts.left);
    loan.store_injected(heap, memory, inj, loc, written, omega(fits, inj.sizes(loc.block)), word_bytes(word), ok)
}

// A reference: the machine stores its target's address, the same store as
// a word's, and the heap its zero bytes and a pointer. Outside the pointer
// the two heaps agree, and the pointer reads the address.
theorem Loan::store_ref_injected<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, written: spans.written(loc.block) = True, ok: heap.fits(loc, 8) = True, target: Loc):
    Injected<M>(data, spans, heap.store_ref(loc, target), stack.writes.store(memory, loc.address(spans), word_bytes(target.address(spans)))) {
    let b = loc.block;
    let k = loc.offset;
    let word = target.address(spans);
    let parts = Bool::and_true_parts((k + 8).leb(heap.bytes(b).len()), !cut(heap.shadow, b, k, 8), ok);
    let fits: (k + 8 <= heap.bytes(b).len()) = Nat::le_of_leb_eq(k + 8, heap.bytes(b).len(), parts.left);
    let span_fits: (k + 8 <= spans.size(b)) = omega(fits, inj.sizes(b));
    let stored = loan.store_word_injected(heap, memory, inj, loc, written, ok, word);
    let pointer = Pointer(b, k, target);
    Injected(
        sizes := λ c => trans(heap.store_len(loc, word_bytes(BitVec::zero()), fits, omega(fits), c), inj.sizes(c)),
        bytes := λ c i short none defined => {
            let halves = Bool::or_false_parts(pointer.covers(c, i), covered(cleared(heap.shadow, b, k, 8), c, i), none);
            let outside: ((b ≠ c) ∨ ((i < k) ∨ (k + 8 <= i))) = pointer.uncovers(c, i, halves.left);
            trans(stored.bytes(c, i, short, halves.right,
                    trans(heap.store_undefined_outside(loc, word_bytes(word), c, i, outside),
                        trans(sym(heap.store_undefined_outside(loc, word_bytes(BitVec::zero()), c, i, outside)), defined))),
                trans(heap.store_outside(loc, word_bytes(word), fits, omega(fits), c, i, outside),
                    sym(heap.store_outside(loc, word_bytes(BitVec::zero()), fits, omega(fits), c, i, outside))))
        },
        refs := ⟨⟨span_fits, loan.word_stored(memory, b, k, written, span_fits, word)⟩, stored.refs⟩,
    )
}

// A word stored below `top` leaves the injection,
theorem Loan::injected_own<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), heap: Heap, memory: M, inj: Injected<M>(data, spans, heap, memory),
    k: Nat, below: k + 8 <= top, word: BitVec(64)): Injected<M>(data, spans, heap, stack.writes.store(memory, stack.at(k), word_bytes(word))) {
    let after = stack.writes.store(memory, stack.at(k), word_bytes(word));
    Injected(
        sizes := inj.sizes,
        bytes := λ b j inside none defined => trans(loan.under(memory, k, below, word, b, j, inside), inj.bytes(b, j, inside, none, defined)),
        refs := every_map(λ (e: Pointer) => e.Held(data, spans, memory), λ (e: Pointer) => e.Held(data, spans, after),
            λ e held => ⟨held.left, trans(read_word_agree(data, after, memory, spans.byte(e.block, e.at), λ t short =>
                j(sym(rip_compose(spans.at(e.block), e.at, t)), λ y _ => data.read(after, y) = data.read(memory, y),
                    loan.under(memory, k, below, word, e.block, e.at + t, omega(short, held.left)))), held.right)⟩,
            heap.shadow, inj.refs),
    )
}

// so it is stable under the own stores of a call entered at or below `top`.
theorem Loan::stable_injected<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), i: Nat, low: i <= top, heap: Heap):
    stack.Stable(i, λ (m: M) => Injected<M>(data, spans, heap, m)) {
    λ memory k below word held => loan.injected_own(heap, memory, held, k, omega(below, low), word)
}

theorem Bool::or_with_true(self a: Bool): (a || True) = True { match a { True => refl, False => refl } }

// A pointer covers its own eight bytes.
theorem every_covers_own(shadow: List<Pointer>): Every(shadow, λ (e: Pointer) => (t: Nat) → t < 8 → covered(shadow, e.block, e.at + t) = True) {
    match shadow {
        Nil => trivial,
        Cons(e, rest) => ⟨λ t short => {
                let here: (e.covers(e.block, e.at + t) = True) = Bool::and_true_of(e.block.same(e.block), e.at.leb(e.at + t) && (e.at + t + 1).leb(e.at + 8),
                    e.block.same_self(), Bool::and_true_of(e.at.leb(e.at + t), (e.at + t + 1).leb(e.at + 8), Nat::leb_eq_true(e.at, e.at + t, omega()),
                        Nat::leb_eq_true(e.at + t + 1, e.at + 8, omega(short))));
                j(sym(here), λ v _ => (v || covered(rest, e.block, e.at + t)) = True, refl)
            },
            every_map(λ (d: Pointer) => (t: Nat) → t < 8 → covered(rest, d.block, d.at + t) = True,
                λ (d: Pointer) => (t: Nat) → t < 8 → covered(Cons(e, rest), d.block, d.at + t) = True,
                λ d inner t short => {
                    let later = inner(t, short);
                    trans(cong_fn<Bool, Bool>(λ v => e.covers(d.block, d.at + t) || v, later), e.covers(d.block, d.at + t).or_with_true())
                }, rest, every_covers_own(rest))⟩,
    }
}

// The injection says nothing of an undefined byte: memory that reads the
// same everywhere else, at any covered or defined byte, injects the heap
// as well. A failed `read` that left junk in an undefined window keeps it.
theorem Injected::undefined_change<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M},
    self inj: Injected<M>(data, spans, heap, memory), other: M,
    same: (b, k: Nat) → k < spans.size(b) → (covered(heap.shadow, b, k) = True) ∨ (heap.undefined(b, k) = False) →
        data.read(other, spans.byte(b, k)) = data.read(memory, spans.byte(b, k))): Injected<M>(data, spans, heap, other) {
    Injected(
        sizes := inj.sizes,
        bytes := λ b k inside none defined => trans(same(b, k, inside, Inr(defined)), inj.bytes(b, k, inside, none, defined)),
        refs := every_map(λ (e: Pointer) => e.Held(data, spans, memory) ∧ ((t: Nat) → t < 8 → covered(heap.shadow, e.block, e.at + t) = True),
            λ (e: Pointer) => e.Held(data, spans, other),
            λ e both => ⟨both.left.left, trans(read_word_agree(data, other, memory, spans.byte(e.block, e.at), λ t short =>
                j(sym(rip_compose(spans.at(e.block), e.at, t)), λ y _ => data.read(other, y) = data.read(memory, y),
                    same(e.block, e.at + t, omega(short, both.left.left), Inl(both.right(t, short))))), both.left.right)⟩,
            heap.shadow, every_both(λ (e: Pointer) => e.Held(data, spans, memory),
                λ (e: Pointer) => (t: Nat) → t < 8 → covered(heap.shadow, e.block, e.at + t) = True, heap.shadow, inj.refs, every_covers_own(heap.shadow))),
    )
}

// ---------------------------------------------------------------------------
// What each load reads

// `n` bytes at `loc` no pointer touches read the block's bytes, inside its
// span.
theorem Injected::reads<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, n: Nat, ok: heap.plain(loc, n) = True):
    (loc.offset + n <= spans.size(loc.block)) ∧
        ((t: Nat) → t < n → data.read(memory, next_rip(loc.address(spans), t)) = Some(heap.byte(loc.plus(t)))) {
    let b = loc.block;
    let k = loc.offset;
    let parts = Bool::and_true_parts((k + n).leb(heap.bytes(b).len()), !touched(heap.shadow, b, k, n) && heap.defined(b, k, n), ok);
    let fits: (k + n <= heap.bytes(b).len()) = Nat::le_of_leb_eq(k + n, heap.bytes(b).len(), parts.left);
    let rest = Bool::and_true_parts(!touched(heap.shadow, b, k, n), heap.defined(b, k, n), parts.right);
    let none = Bool::false_of_not_true(rest.left);
    ⟨omega(fits, inj.sizes(b)), λ t short =>
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ y => data.read(memory, y), rip_compose(spans.at(b), k, t)),
            trans(inj.bytes(b, k + t, omega(short, fits, inj.sizes(b)), untouched_uncovered(b, k, n, t, short, heap.shadow, none),
                    heap.defined_at(b, k, n, rest.right, t, short)),
                heap.nth_byte(loc.plus(t), omega(short, fits))))⟩
}

// At each width the machine loads: a byte,
theorem Injected::byte_read<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, ok: heap.plain(loc, 1) = True):
    (loc.offset + 1 <= spans.size(loc.block)) ∧ (data.read(memory, loc.address(spans)) = Some(heap.byte(loc))) {
    let read = inj.reads(loc, 1, ok);
    let zero: (loc.offset + 0 = loc.offset) = omega();
    ⟨read.left, trans(read.right(0, trivial), cong_fn<Nat, Option<BitVec(8)>>(λ y => Some(heap.byte(Loc(loc.block, y))), zero))⟩
}

// a doubleword,
theorem Injected::dword_read<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, ok: heap.plain(loc, 4) = True):
    (loc.offset + 4 <= spans.size(loc.block)) ∧ (read_dword(data, memory, loc.address(spans)) = Some(heap.dword(loc))) {
    let read = inj.reads(loc, 4, ok);
    let o = λ (t: Nat) => data.read(memory, next_rip(loc.address(spans), t));
    ⟨read.left, dword_of_four(o(0), o(1), o(2), o(3), heap.byte(loc.plus(0)), heap.byte(loc.plus(1)), heap.byte(loc.plus(2)), heap.byte(loc.plus(3)),
        read.right(0, trivial), read.right(1, trivial), read.right(2, trivial), read.right(3, trivial))⟩
}

// and a word.
theorem Injected::word_read<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    loc: Loc, ok: heap.plain(loc, 8) = True):
    (loc.offset + 8 <= spans.size(loc.block)) ∧ (read_word(data, memory, loc.address(spans)) = Some(heap.word(loc))) {
    let read = inj.reads(loc, 8, ok);
    let o = λ (t: Nat) => data.read(memory, next_rip(loc.address(spans), t));
    ⟨read.left, word_of_eight(o(0), o(1), o(2), o(3), o(4), o(5), o(6), o(7),
        heap.byte(loc.plus(0)), heap.byte(loc.plus(1)), heap.byte(loc.plus(2)), heap.byte(loc.plus(3)),
        heap.byte(loc.plus(4)), heap.byte(loc.plus(5)), heap.byte(loc.plus(6)), heap.byte(loc.plus(7)),
        read.right(0, trivial), read.right(1, trivial), read.right(2, trivial), read.right(3, trivial),
        read.right(4, trivial), read.right(5, trivial), read.right(6, trivial), read.right(7, trivial))⟩
}

// A reference is loaded as a word: its target's address.
theorem Injected::ref_read<M>({data: ByteReadAccess<M>}, {spans: Spans}, {heap: Heap}, {memory: M}, self inj: Injected<M>(data, spans, heap, memory),
    loc, target: Loc, here: found(heap.shadow, loc.block, loc.offset) = Some(target)):
    (loc.offset + 8 <= spans.size(loc.block)) ∧ (read_word(data, memory, loc.address(spans)) = Some(target.address(spans))) {
    every_found(λ (e: Pointer) => e.Held(data, spans, memory), loc.block, loc.offset, target, heap.shadow, inj.refs, here)
}

// ---------------------------------------------------------------------------
// The call (docs/language/ownership-design.md §17.2)

// The System V convention: the first six words in these registers, the
// rest on the stack above the return address; these kept across a call;
// an answer's first word in RAX and the rest in these.
fn argument_registers() → List<Gpr> { [Rdi, Rsi, Rdx, Rcx, R8, R9] }
fn callee_kept() → List<Gpr> { [Rbx, Rbp, R12, R13, R14, R15] }
fn answer_registers() → List<Gpr> { [Rdx, Rcx, Rsi, Rdi, R8, R9, R10, R11] }

// The words in the registers, one each.
fn ArgsIn(words: List<BitVec(64)>) → List<Gpr> → Gprs → Type {
    match words {
        Nil => λ _ _ => True,
        Cons(word, rest) => λ registers gprs => match registers {
            Nil => False,
            Cons(register, later) => (read_gpr(register, gprs) = word) ∧ ArgsIn(rest, later, gprs),
        },
    }
}

// The words passed: in `registers` while there are some, then on the stack
// from offset `at` up.
fn Stack::Passes<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>) → List<Gpr> → Nat → Gprs → M → Type {
    match words {
        Nil => λ _ _ _ _ => True,
        Cons(word, rest) => λ registers at gprs memory => match registers {
            Nil => ((at + 8 <= stack.size) ∧ (read_word(data, memory, stack.at(at)) = Some(word))) ∧
                stack.Passes(rest, Nil, at + 8, gprs, memory),
            Cons(register, later) => (read_gpr(register, gprs) = word) ∧ stack.Passes(rest, later, at, gprs, memory),
        },
    }
}

// As a call entered at stack offset `i` finds them.
fn Stack::Passed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), words: List<BitVec(64)>,
    i: Nat, s: MachineState<M>) → Type {
    stack.Passes(words, argument_registers(), i + 8, s.gprs, s.memory)
}

// What a callee answers: its words and its heap.
record Returned { words: List<BitVec(64)>, heap: Heap }

// The contract, over one lending for the whole run: every function below
// `bound` that its meaning (`calls`) answers for some arguments and a
// heap, entered at stack offset `i` with the arguments passed, room for
// its frames below (`rooms(f)`) and the lending's words above (`top`), and
// the heap injected, returns with the answer's words in RAX and
// `answer_registers()`, the callee-saved registers kept, its stores inside
// the lending, and the answer's heap injected. That it left alone what it
// was not lent is not said here: the injection after the call pins every
// byte of every block, so it is a fact about the answer's heap.
//
// Provisional: this is the clause for a run that answers. A clause for a
// run still going (the history performed so far) and the world's place
// join it when the bytes level's `run` exists
// (issues/bytes-level-language.md); nothing builds on its exact shape yet.
fn Site::Meets<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), spans: Spans, top: Nat, rooms: Nat → Nat, bound: Nat,
    calls: Nat → List<BitVec(64)> → Heap → Option<Returned>) → Type {
    (f: Nat) → f + 1 <= bound → (arguments: List<BitVec(64)>) → (heap: Heap) → (answer: Returned) → calls(f, arguments, heap) = Some(answer) →
        site.Returns(stack, asm_labels(site.program)(f + 1),
            λ i s => (stack.Passed(arguments, i, s) ∧ ((rooms(f) <= i) ∧ (i + 8 <= top))) ∧ Injected<M>(site.data, spans, heap, s.memory),
            λ i s t => (ArgsIn(answer.words, Cons(Rax, answer_registers()), t.gprs) ∧ Kept(callee_kept(), s.gprs, t.gprs)) ∧
                (stack.WroteIn(i, spans, s.memory, t.memory) ∧ Injected<M>(site.data, spans, answer.heap, t.memory)))
}

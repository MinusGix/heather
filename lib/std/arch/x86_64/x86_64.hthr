    decode_instruction(setcc_bytes(0x94, destination)) =
        Some(decoded_canonical(SetEqual(destination)))
{
    match destination {
        Al => refl, Cl => refl, Dl => refl, Bl => refl, Bpl => refl, Sil => refl, Dil => refl,
        R8b => refl, R9b => refl, R10b => refl, R11b => refl, R12b => refl, R13b => refl, R14b => refl, R15b => refl,
    }
}

theorem decode_add_ri8_complete(destination: Gpr, immediate: BitVec(8)):
    decode_instruction(add_ri8_bytes(destination, immediate)) =
        Some(decoded_canonical(AddRI8(destination, immediate)))
{
    match destination {
        Rax => refl,
        Rcx => refl,
        Rdx => refl,
        Rbx => refl,
        Rsp => refl,
        Rbp => refl,
        Rsi => refl,
        Rdi => refl,
        R8 => refl,
        R9 => refl,
        R10 => refl,
        R11 => refl,
        R12 => refl,
        R13 => refl,
        R14 => refl,
        R15 => refl,
    }
}

theorem decode_shift_one_complete(op: ShiftOp, destination: Gpr):
    decode_instruction(shift_one_bytes(op, destination)) =
        Some(decoded_canonical(ShiftOne(op, destination)))
{
    match op {
        OpShl => match destination {
            Rax => refl,
            Rcx => refl,
            Rdx => refl,
            Rbx => refl,
            Rsp => refl,
            Rbp => refl,
            Rsi => refl,
            Rdi => refl,
            R8 => refl,
            R9 => refl,
            R10 => refl,
            R11 => refl,
            R12 => refl,
            R13 => refl,
            R14 => refl,
            R15 => refl,
        },
        OpShr => match destination {
            Rax => refl,
            Rcx => refl,
            Rdx => refl,
            Rbx => refl,
            Rsp => refl,
            Rbp => refl,
            Rsi => refl,
            Rdi => refl,
            R8 => refl,
            R9 => refl,
            R10 => refl,
            R11 => refl,
            R12 => refl,
            R13 => refl,
            R14 => refl,
            R15 => refl,
        },
        OpSar => match destination {
            Rax => refl,
            Rcx => refl,
            Rdx => refl,
            Rbx => refl,
            Rsp => refl,
            Rbp => refl,
            Rsi => refl,
            Rdi => refl,
            R8 => refl,
            R9 => refl,
            R10 => refl,
            R11 => refl,
            R12 => refl,
            R13 => refl,
            R14 => refl,
            R15 => refl,
        },
    }
}

theorem decode_add_ri32_complete(destination: Gpr, immediate: BitVec(32)):
    decode_instruction(add_ri32_bytes(destination, immediate)) =
        Some(decoded_canonical(AddRI32(destination, immediate)))
{
    match destination {
        Rax => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rax, value))), imm32_bytes_roundtrip(immediate)),
        Rcx => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rcx, value))), imm32_bytes_roundtrip(immediate)),
        Rdx => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rdx, value))), imm32_bytes_roundtrip(immediate)),
        Rbx => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rbx, value))), imm32_bytes_roundtrip(immediate)),
        Rsp => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rsp, value))), imm32_bytes_roundtrip(immediate)),
        Rbp => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rbp, value))), imm32_bytes_roundtrip(immediate)),
        Rsi => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rsi, value))), imm32_bytes_roundtrip(immediate)),
        Rdi => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(Rdi, value))), imm32_bytes_roundtrip(immediate)),
        R8 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R8, value))), imm32_bytes_roundtrip(immediate)),
        R9 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R9, value))), imm32_bytes_roundtrip(immediate)),
        R10 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R10, value))), imm32_bytes_roundtrip(immediate)),
        R11 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R11, value))), imm32_bytes_roundtrip(immediate)),
        R12 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R12, value))), imm32_bytes_roundtrip(immediate)),
        R13 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R13, value))), imm32_bytes_roundtrip(immediate)),
        R14 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R14, value))), imm32_bytes_roundtrip(immediate)),
        R15 => cong_fn(λ (value: BitVec(32)) => Some(decoded_canonical(AddRI32(R15, value))), imm32_bytes_roundtrip(immediate)),
    }
}

theorem decode_instruction_of_setcc_encoding(bytes: List<BitVec(8)>,
    opcode: Nat, destination: LowByteGpr, instruction: Instruction,
    encoding: SetccEncoding(bytes, opcode, destination),
    generated: decode_instruction(setcc_bytes(opcode, destination)) =
        Some(decoded_canonical(instruction))):
    decode_instruction(bytes) = Some(decoded_canonical(instruction))
{
    j(sym(encoding), λ actual q => decode_instruction(actual) =
        Some(decoded_canonical(instruction)), generated)
}

theorem decode_instruction_complete(bytes: List<BitVec(8)>,
    instruction: Instruction,
    decoding: DecodesInstruction(bytes, instruction)):
    decode_instruction(bytes) = Some(decoded_canonical(instruction))
{
    match instruction as λ actual => DecodesInstruction(bytes, actual) →
            decode_instruction(bytes) = Some(decoded_canonical(actual)) {
        MovRR(destination, source) => λ evidence => match evidence {
            Inl(encoding) => decode_instruction_of_rr_encoding(bytes, 0x89,
                destination, source, MovRR(destination, source), encoding,
                decode_instruction_rr_complete(MovRmReg,
                    destination, source)),
            Inr(encoding) => decode_instruction_of_rr_encoding(bytes, 0x8b,
                source, destination, MovRR(destination, source), encoding,
                decode_instruction_rr_complete(MovRegRm,
                    source, destination)),
        },
        MovRI(destination, immediate) => λ encoding =>
            decode_instruction_of_mov_ri_encoding(bytes, destination,
                immediate, encoding),
        AddRR(destination, source) => λ evidence => match evidence {
            Inl(encoding) => decode_instruction_of_rr_encoding(bytes, 1,
                destination, source, AddRR(destination, source), encoding,
                decode_instruction_rr_complete(AddRmReg,
                    destination, source)),
            Inr(encoding) => decode_instruction_of_rr_encoding(bytes, 3,
                source, destination, AddRR(destination, source), encoding,
                decode_instruction_rr_complete(AddRegRm,
                    source, destination)),
        },
        SubRR(destination, source) => λ evidence => match evidence {
            Inl(encoding) => decode_instruction_of_rr_encoding(bytes, 0x29,
                destination, source, SubRR(destination, source), encoding,
                decode_instruction_rr_complete(SubRmReg,
                    destination, source)),
            Inr(encoding) => decode_instruction_of_rr_encoding(bytes, 0x2b,
                source, destination, SubRR(destination, source), encoding,
                decode_instruction_rr_complete(SubRegRm,
                    source, destination)),
        },
        AndRR(destination, source) => λ encoding =>
            decode_instruction_of_rr_encoding(bytes, 0x21, destination, source,
                AndRR(destination, source), encoding,
                decode_instruction_rr_complete(AndRmReg,
                    destination, source)),
        OrRR(destination, source) => λ encoding =>
            decode_instruction_of_rr_encoding(bytes, 0x09, destination, source,
                OrRR(destination, source), encoding,
                decode_instruction_rr_complete(OrRmReg,
                    destination, source)),
        XorRR(destination, source) => λ encoding =>
            decode_instruction_of_rr_encoding(bytes, 0x31, destination, source,
                XorRR(destination, source), encoding,
                decode_instruction_rr_complete(XorRmReg,
                    destination, source)),
        CmpRR(left, right) => λ evidence => match evidence {
            Inl(encoding) => decode_instruction_of_rr_encoding(bytes, 0x39,
                left, right, CmpRR(left, right), encoding,
                decode_instruction_rr_complete(CmpRmReg, left, right)),
            Inr(encoding) => decode_instruction_of_rr_encoding(bytes, 0x3b,
                right, left, CmpRR(left, right), encoding,
                decode_instruction_rr_complete(CmpRegRm, right, left)),
        },
        SetBelow(destination) => λ encoding =>
            decode_instruction_of_setcc_encoding(bytes, 0x92, destination,
                SetBelow(destination), encoding,
                decode_set_below_complete(destination)),
        SetLess(destination) => λ encoding =>
            decode_instruction_of_setcc_encoding(bytes, 0x9c, destination,
                SetLess(destination), encoding,
                decode_set_less_complete(destination)),
        SetEqual(destination) => λ encoding =>
            decode_instruction_of_setcc_encoding(bytes, 0x94, destination,
                SetEqual(destination), encoding,
                decode_set_equal_complete(destination)),
        TestRR(left, right) => λ encoding =>
            decode_instruction_of_rr_encoding(bytes, 0x85, left, right,
                TestRR(left, right), encoding,
                decode_instruction_rr_complete(TestRmReg, left, right)),
        AddRI8(destination, immediate) => λ encoding =>
            j(sym(encoding), λ actual q => decode_instruction(actual) =
                Some(decoded_canonical(AddRI8(destination, immediate))),
                decode_add_ri8_complete(destination, immediate)),
        AddRI32(destination, immediate) => λ encoding =>
            j(sym(encoding), λ actual q => decode_instruction(actual) =
                Some(decoded_canonical(AddRI32(destination, immediate))),
                decode_add_ri32_complete(destination, immediate)),
        ShiftOne(op, destination) => λ encoding =>
            j(sym(encoding), λ actual q => decode_instruction(actual) =
                Some(decoded_canonical(ShiftOne(op, destination))),
                decode_shift_one_complete(op, destination)),
    }(decoding)
}

theorem direct_agrees_with_successful_reference(bytes: List<BitVec(8)>,
    result: ByteDecode(bytes),
    success: decode_bytes_reference(bytes) = Some(result)):
    decode_instruction(bytes) = decode_instruction_reference(bytes)
{
    trans(decode_instruction_complete(bytes, result.instruction,
            result.decoding),
        sym(cong_fn(
            λ (decoded: Option<ByteDecode(bytes)>) =>
                erase_byte_decode(bytes, decoded),
            success)))
}

theorem decode_bytes_sound(bytes: List<BitVec(8)>, result: ByteDecode(bytes),
    success: decode_bytes(bytes) = Some(result)):
    DecodesInstruction(bytes, result.instruction)
{
    result.decoding
}

fn DecodedAt(span: InstructionBytes, decoded: DecodedInstruction) → Type {
    DecodesInstruction(span.bytes, decoded.instruction)
        ∧ decoded.length = canonical_length(decoded.instruction)
}

fn encoded_at(start: BitVec(64), instruction: Instruction) → InstructionBytes {
    InstructionBytes(start := start, bytes := canonical_bytes(instruction))
}

theorem decoded_canonical_length(instruction: Instruction):
    decoded_canonical(instruction).length = canonical_length(instruction)
{
    match instruction {
        MovRR(_, _) => refl, MovRI(_, _) => refl,
        AddRR(_, _) => refl, SubRR(_, _) => refl,
        AndRR(_, _) => refl, OrRR(_, _) => refl, XorRR(_, _) => refl,
        CmpRR(_, _) => refl, SetBelow(_) => refl, SetLess(_) => refl, SetEqual(_) => refl,
        TestRR(_, _) => refl, AddRI8(_, _) => refl, AddRI32(_, _) => refl,
        ShiftOne(_, _) => refl,
    }
}

theorem canonical_mov_ri_encoding_decodes(start: BitVec(64), destination: Gpr,
    immediate: BitVec(64)):
    DecodedAt(encoded_at(start, MovRI(destination, immediate)),
        decoded_canonical(MovRI(destination, immediate)))
{
    And(refl, refl)
}

theorem canonical_encoding_decodes(start: BitVec(64), instruction: Instruction):
    DecodedAt(encoded_at(start, instruction), decoded_canonical(instruction))
{
    match instruction {
        MovRR(_, _) => And(Inl(And(refl, And(refl, refl))), refl),
        MovRI(_, _) => And(refl, refl),
        AddRR(_, _) => And(Inl(And(refl, And(refl, refl))), refl),
        SubRR(_, _) => And(Inl(And(refl, And(refl, refl))), refl),
        AndRR(_, _) => And(And(refl, And(refl, refl)), refl),
        OrRR(_, _) => And(And(refl, And(refl, refl)), refl),
        XorRR(_, _) => And(And(refl, And(refl, refl)), refl),
        CmpRR(_, _) => And(Inl(And(refl, And(refl, refl))), refl),
        SetBelow(_) => And(refl, refl),
        SetLess(_) => And(refl, refl),
        SetEqual(_) => And(refl, refl),
        TestRR(_, _) => And(And(refl, And(refl, refl)), refl),
        AddRI8(_, _) => And(refl, refl),
        AddRI32(_, _) => And(refl, refl),
        ShiftOne(_, _) => And(refl, refl),
    }
}

// The direct decoder is a function. Two canonical encodings of the same
// bytes therefore name the same instruction, including alternate register
// operand spellings that DecodesInstruction also accepts.
theorem canonical_bytes_unique(left, right: Instruction,
    same: canonical_bytes(left) = canonical_bytes(right)): left = right {
    let decoded_left = decode_instruction_complete(canonical_bytes(left), left,
        canonical_encoding_decodes(BitVec::zero(), left).left);
    let decoded_right = decode_instruction_complete(canonical_bytes(right), right,
        canonical_encoding_decodes(BitVec::zero(), right).left);
    let equal_results: (Some(decoded_canonical(left)) = Some(decoded_canonical(right))) =
        trans(sym(decoded_left),
            trans(cong_fn(λ bytes => decode_instruction(bytes), same), decoded_right));
    cong_fn(λ decoded => decoded.instruction,
        Option::some_inj(decoded_canonical(left), decoded_canonical(right), equal_results))
}

theorem external_bytes_decode(span: InstructionBytes,
    decoded: DecodedInstruction,
    bytes_decode: DecodesInstruction(span.bytes, decoded.instruction),
    length: decoded.length = canonical_length(decoded.instruction)):
    DecodedAt(span, decoded)
{
    And(bytes_decode, length)
}

theorem decoded_byte_result_at(start: BitVec(64), bytes: List<BitVec(8)>,
    result: ByteDecode(bytes)):
    DecodedAt(
        InstructionBytes(start := start, bytes := bytes),
        decoded_canonical(result.instruction))
{
    And(result.decoding, decoded_canonical_length(result.instruction))
}

theorem decoded_at_bytes(span: InstructionBytes,
    decoded: DecodedInstruction, evidence: DecodedAt(span, decoded)):
    DecodesInstruction(span.bytes, decoded.instruction)
{
    evidence.left
}

theorem alternate_mov_encoding_decodes(start: BitVec(64),
    destination, source: Gpr):
    DecodedAt(
        InstructionBytes(start := start,
            bytes := alternate_mov_bytes(destination, source)),
        decoded_rr(MovRR(destination, source)))
{
    And(Inr(And(refl, And(refl, refl))), refl)
}

theorem alternate_add_encoding_decodes(start: BitVec(64),
    destination, source: Gpr):
    DecodedAt(
        InstructionBytes(start := start,
            bytes := alternate_add_bytes(destination, source)),
        decoded_rr(AddRR(destination, source)))
{
    And(Inr(And(refl, And(refl, refl))), refl)
}

theorem alternate_sub_encoding_decodes(start: BitVec(64),
    destination, source: Gpr):
    DecodedAt(
        InstructionBytes(start := start,
            bytes := alternate_sub_bytes(destination, source)),
        decoded_rr(SubRR(destination, source)))
{
    And(Inr(And(refl, And(refl, refl))), refl)
}

theorem alternate_cmp_encoding_decodes(start: BitVec(64), left, right: Gpr):
    DecodedAt(
        InstructionBytes(start := start,
            bytes := alternate_cmp_bytes(left, right)),
        decoded_rr(CmpRR(left, right)))
{
    And(Inr(And(refl, And(refl, refl))), refl)
}

theorem decoded_at_length(span: InstructionBytes,
    decoded: DecodedInstruction, evidence: DecodedAt(span, decoded)):
    decoded.length = canonical_length(decoded.instruction)
{
    evidence.right
}

theorem setcc_bytes_length(opcode: Nat, destination: LowByteGpr):
    setcc_bytes(opcode, destination).len() = setcc_length(destination)
{
    match destination {
        Al => refl, Cl => refl, Dl => refl, Bl => refl, Bpl => refl, Sil => refl, Dil => refl,
        R8b => refl, R9b => refl, R10b => refl, R11b => refl, R12b => refl, R13b => refl, R14b => refl, R15b => refl,
    }
}

theorem canonical_bytes_length(instruction: Instruction):
    canonical_bytes(instruction).len() = canonical_length(instruction)
{
    match instruction {
        MovRR(_, _) => refl,
        MovRI(_, _) => refl,
        AddRR(_, _) => refl,
        SubRR(_, _) => refl,
        AndRR(_, _) => refl,
        OrRR(_, _) => refl,
        XorRR(_, _) => refl,
        CmpRR(_, _) => refl,
        SetBelow(destination) => setcc_bytes_length(0x92, destination),
        SetLess(destination) => setcc_bytes_length(0x9c, destination),
        SetEqual(destination) => setcc_bytes_length(0x94, destination),
        TestRR(_, _) => refl,
        AddRI8(_, _) => refl,
        AddRI32(_, _) => refl,
        ShiftOne(_, _) => refl,
    }
}

fn next_rip(current: BitVec(64), length: Nat) → BitVec(64) {
    // Decoded instruction lengths are bounded by 15. Advancing by structural
    // iteration is exactly modular addition at width 64, while preserving the
    // composition shape needed by block-layout proofs instead of rebuilding a
    // binary literal and asking conversion to rediscover that shape.
    current.iterate_increment(length)
}

fn xor_bits(n: Nat) → BitVec(n) → Bool {
    match n {
        Zero => λ x => False,
        Succ(k, ih) => λ x => x.head_bit().xor(ih(x.tail_bits())),
    }
}

fn is_zero_bits(n: Nat) → BitVec(n) → Bool {
    match n {
        Zero => λ x => True,
        Succ(k, ih) => λ x =>
            x.head_bit().not() && ih(x.tail_bits()),
    }
}

fn add_flags(left, right: BitVec(64)) → Flags {
    let result = left.add(right);
    let low_left = left.take_low(4, 60);
    let low_right = right.take_low(4, 60);
    Flags(
        cf := left.carry_add_bit(right),
        pf := xor_bits(8, result.take_low(8, 56)).not(),
        af := low_left.carry_add_bit(low_right),
        zf := is_zero_bits(64, result),
        sf := result.sign_bit(),
        of := left.signed_overflow_add(right),
    )
}

fn sub_flags(left, right: BitVec(64)) → Flags {
    let result = left.sub(right);
    let low_left = left.take_low(4, 60);
    let low_right = right.take_low(4, 60);
    Flags(
        cf := left.borrow_sub_bit(right),
        pf := xor_bits(8, result.take_low(8, 56)).not(),
        af := low_left.borrow_sub_bit(low_right),
        zf := is_zero_bits(64, result),
        sf := result.sign_bit(),
        of := left.signed_overflow_sub(right),
    )
}

// CMP's ZF is the library's equality: `is_zero_bits(n, a.sub(b))` is
// `a.eq_bit(b)` at every width, with no borrow law, because a zero
// difference counts back up to the subtrahend (`iterate_sub_add`).
theorem zero_bits_zero(n: Nat): is_zero_bits(n, BitVec::zero(n := n)) = True {
    match n { Zero => refl, Succ(_, ih) => ih }
}

theorem zero_of_zero_bits(n: Nat): (x: BitVec(n)) → is_zero_bits(n, x) = True → x = BitVec::zero() {
    match n {
        Zero => λ x _ => refl,
        Succ(k, ih) => λ x zero => {
            let rest = is_zero_bits(k, x.tail_bits());
            let low: (x.head_bit() = False) = (match x.head_bit() as λ h => h.not() = True → h = bool::False {
                False => λ _ => refl,
                True => λ no => absurd(no),
            })(BitVec::and_true_left(x.head_bit().not(), rest, zero));
            trans(sym(BitVec::cons_head_tail(k, x)),
                BitVec::cons_bit_cong(k, low, ih(x.tail_bits(), BitVec::and_true_right(x.head_bit().not(), rest, zero))))
        },
    }
}

theorem zero_bits_sub_self(n: Nat, a: BitVec(n)): is_zero_bits(n, a.sub(a)) = True {
    let v = a.toNat();
    let spec: (a.sub(a) = a.iterate_decrement(v)) = BitVec::sub_bits_spec(n, a, a, False);
    let back: ((BitVec::zero(n := n).iterate_increment(v)).iterate_decrement(v) = BitVec::zero()) = BitVec::iterate_add_sub_cancel(n, v, BitVec::zero());
    let from: (BitVec::zero(n := n).iterate_increment(v) = a) = BitVec::iterate_increment_toNat(n, a);
    let at_a: (a.iterate_decrement(v) = BitVec::zero()) = rewrite(from, in := back);
    j(sym(trans(spec, at_a)), λ y _ => is_zero_bits(n, y) = True, zero_bits_zero(n))
}

theorem eq_of_zero_bits_sub(n: Nat, a, b: BitVec(n), zf: is_zero_bits(n, a.sub(b)) = True): a = b {
    let v = b.toNat();
    let is_zero: (BitVec::zero(n := n) = a.sub(b)) = sym(zero_of_zero_bits(n, a.sub(b), zf));
    let spec: (a.sub(b) = a.iterate_decrement(v)) = BitVec::sub_bits_spec(n, a, b, False);
    let undo: ((a.iterate_decrement(v)).iterate_increment(v) = a) = BitVec::iterate_sub_add(n, v, a);
    let via: (BitVec::zero(n := n).iterate_increment(v) = a) = rewrite(sym(trans(is_zero, spec)), in := undo);
    trans(sym(via), BitVec::iterate_increment_toNat(n, b))
}

theorem zero_bits_sub(n: Nat, a, b: BitVec(n)): is_zero_bits(n, a.sub(b)) = a.eq_bit(b) {
    match a.eq_bit(b) as λ c => (a.eq_bit(b) = c) → is_zero_bits(n, a.sub(b)) = c {
        True => λ same => j(BitVec::eq_of_eq_bit(n, a, b, same), λ y _ => is_zero_bits(n, a.sub(y)) = True, zero_bits_sub_self(n, a)),
        False => λ differ => match is_zero_bits(n, a.sub(b)) as λ d => (is_zero_bits(n, a.sub(b)) = d) → d = False {
            False => λ _ => refl,
            True => λ zf => absurd(trans(sym(differ), BitVec::eq_bit_of_eq(n, a, b, eq_of_zero_bits_sub(n, a, b, zf)))),
        }(refl),
    }(refl)
}

// SETE's word after `MOV r, 0`, as a materialised comparison states it.
theorem zero_bits_sub_word(a, b: BitVec(64)):
    BitVec::ofBool(is_zero_bits(64, a.sub(b))).zero_extend(63) = BitVec::ofBool(a.eq_bit(b)).zero_extend(63) {
    j(zero_bits_sub(64, a, b), λ c _ => BitVec::ofBool(is_zero_bits(64, a.sub(b))).zero_extend(63) = BitVec::ofBool(c).zero_extend(63), refl)
}

// TEST defines five arithmetic flags from the discarded AND result. AF is
// architecturally undefined and is therefore supplied by the relation rather
// than silently fixed by this helper.
fn test_flags(left, right: BitVec(64), af: Bool) → Flags {
    let result = left.band(right);
    Flags(
        cf := False,
        pf := xor_bits(8, result.take_low(8, 56)).not(),
        af := af,
        zf := is_zero_bits(64, result),
        sf := result.sign_bit(),
        of := False,
    )
}

record RegisterEffect { gprs: Gprs, flags: Flags }

fn ShiftOp::apply(self op: ShiftOp, x: BitVec(64)) → BitVec(64) {
    match op {
        OpShl => x.shift_left_one(),
        OpShr => x.shift_right_one(),
        OpSar => x.arithmetic_shift_right_one(),
    }
}

// CF is the bit shifted out; OF, defined for a count of one, is whether SHL
// changed the sign, SHR's original sign, and clear for SAR.
fn ShiftOp::carry(self op: ShiftOp, x: BitVec(64)) → Bool {
    match op { OpShl => x.sign_bit(), OpShr => x.get(FZ), OpSar => x.get(FZ) }
}

fn ShiftOp::overflow(self op: ShiftOp, x: BitVec(64)) → Bool {
    match op {
        OpShl => x.shift_left_one().sign_bit().xor(x.sign_bit()),
        OpShr => x.sign_bit(),
        OpSar => False,
    }
}

// AF after a shift by a nonzero count is undefined, so it is supplied, as
// TEST's is.
fn shift_flags(op: ShiftOp, x: BitVec(64), af: Bool) → Flags {
    let result = op.apply(x);
    Flags(
        cf := op.carry(x),
        pf := xor_bits(8, result.take_low(8, 56)).not(),
        af := af,
        zf := is_zero_bits(64, result),
        sf := result.sign_bit(),
        of := op.overflow(x),
    )
}

fn execute_shift_one(op: ShiftOp, destination: Gpr, before: Gprs, af: Bool) → RegisterEffect {
    let x = read_gpr(destination, before);
    RegisterEffect(
        gprs := write_gpr(destination, op.apply(x), before),
        flags := shift_flags(op, x, af),
    )
}

fn execute_add(destination, source: Gpr, before: Gprs) → RegisterEffect
{
    let left = read_gpr(destination, before);
    let right = read_gpr(source, before);
    RegisterEffect(
        gprs := write_gpr(destination, left.add(right), before),
        flags := add_flags(left, right),
    )
}

fn execute_sub(destination, source: Gpr, before: Gprs) → RegisterEffect
{
    let left = read_gpr(destination, before);
    let right = read_gpr(source, before);
    RegisterEffect(
        gprs := write_gpr(destination, left.sub(right), before),
        flags := sub_flags(left, right),
    )
}

theorem execute_sub_writes_difference(destination, source: Gpr, before: Gprs):
    read_gpr(destination, execute_sub(destination, source, before).gprs) =
        read_gpr(destination, before).sub(
            read_gpr(source, before))
{
    read_gpr_after_write(destination,
        read_gpr(destination, before).sub(
            read_gpr(source, before)), before)
}

fn logic_flags(result: BitVec(64)) → Flags {
    Flags(
        cf := False,
        pf := xor_bits(8, result.take_low(8, 56)).not(),
        af := False,
        zf := is_zero_bits(64, result),
        sf := result.sign_bit(),
        of := False,
    )
}

fn execute_and(destination, source: Gpr, before: Gprs) → RegisterEffect {
    let result =
        read_gpr(destination, before).band(read_gpr(source, before));
    RegisterEffect(
        gprs := write_gpr(destination, result, before),
        flags := logic_flags(result))
}

fn execute_or(destination, source: Gpr, before: Gprs) → RegisterEffect {
    let result =
        read_gpr(destination, before).bor(read_gpr(source, before));
    RegisterEffect(
        gprs := write_gpr(destination, result, before),
        flags := logic_flags(result))
}

fn execute_xor(destination, source: Gpr, before: Gprs) → RegisterEffect {
    let result =
        read_gpr(destination, before).bxor(read_gpr(source, before));
    RegisterEffect(
        gprs := write_gpr(destination, result, before),
        flags := logic_flags(result))
}

fn execute_cmp(left, right: Gpr, before: Gprs) → RegisterEffect
{
    RegisterEffect(
        gprs := before,
        flags := sub_flags(read_gpr(left, before), read_gpr(right, before)),
    )
}

fn condition_byte(condition: Bool) → BitVec(8) {
    BitVec::ofBool(condition).zero_extend(7)
}

fn write_low_byte(destination: LowByteGpr, condition: Bool,
    before: Gprs) → Gprs
{
    let register = low_byte_gpr(destination);
    write_gpr(register,
        condition_byte(condition).concat(
            read_gpr(register, before).drop_low(8, 56)), before)
}

fn execute_set_below(destination: LowByteGpr, before: Gprs,
    flags: Flags) → RegisterEffect
{
    RegisterEffect(gprs := write_low_byte(destination, flags.cf, before),
        flags := flags)
}

fn execute_set_less(destination: LowByteGpr, before: Gprs,
    flags: Flags) → RegisterEffect
{
    RegisterEffect(gprs := write_low_byte(destination,
        flags.sf.xor(flags.of), before), flags := flags)
}

fn execute_set_equal(destination: LowByteGpr, before: Gprs,
    flags: Flags) → RegisterEffect
{
    RegisterEffect(gprs := write_low_byte(destination, flags.zf, before),
        flags := flags)
}

// ADD of an immediate already extended to 64 bits.
fn execute_add_immediate(destination: Gpr, immediate: BitVec(64), before: Gprs) → RegisterEffect
{
    let left = read_gpr(destination, before);
    RegisterEffect(
        gprs := write_gpr(destination, left.add(immediate), before),
        flags := add_flags(left, immediate),
    )
}

fn execute_register(instruction: Instruction, before: Gprs, flags: Flags) →
    RegisterEffect
{
    match instruction {
        MovRR(destination, source) => RegisterEffect(
            gprs := write_gpr(destination, read_gpr(source, before), before),
            flags := flags,
        ),
        MovRI(destination, immediate) => RegisterEffect(
            gprs := write_gpr(destination, immediate, before),
            flags := flags,
        ),
        AddRR(destination, source) => execute_add(destination, source, before),
        SubRR(destination, source) => execute_sub(destination, source, before),
        AndRR(destination, source) => execute_and(destination, source, before),
        OrRR(destination, source) => execute_or(destination, source, before),
        XorRR(destination, source) => execute_xor(destination, source, before),
        CmpRR(left, right) => execute_cmp(left, right, before),
        SetBelow(destination) => execute_set_below(destination, before, flags),
        SetLess(destination) => execute_set_less(destination, before, flags),
        SetEqual(destination) => execute_set_equal(destination, before, flags),
        // Canonical representative for functional clients. `Execute` below
        // is authoritative and admits both values of undefined AF.
        TestRR(left, right) => RegisterEffect(
            gprs := before,
            flags := test_flags(read_gpr(left, before), read_gpr(right, before), False),
        ),
        AddRI8(destination, immediate) =>
            execute_add_immediate(destination, immediate.sign_extend(56), before),
        AddRI32(destination, immediate) =>
            execute_add_immediate(destination, immediate.sign_extend(32), before),
        // Canonical representative; `Execute` admits both values of AF.
        ShiftOne(op, destination) => execute_shift_one(op, destination, before, False),
    }
}

fn execute_normal<M>(decoded: DecodedInstruction, before: MachineState<M>) →
    MachineState<M>
{
    let effect = execute_register(decoded.instruction, before.gprs, before.flags);
    MachineState<M>(
        gprs := effect.gprs,
        flags := effect.flags,
        rip := next_rip(before.rip, decoded.length),
        memory := before.memory,
    )
}

inductive Exception { }

fn execute_shift<M>(op: ShiftOp, destination: Gpr, length: Nat, before: MachineState<M>,
    af: Bool) → MachineState<M>
{
    let effect = execute_shift_one(op, destination, before.gprs, af);
    MachineState<M>(
        gprs := effect.gprs,
        flags := effect.flags,
        rip := next_rip(before.rip, length),
        memory := before.memory,
    )
}

fn execute_test<M>(left, right: Gpr, length: Nat, before: MachineState<M>,
    af: Bool) → MachineState<M>
{
    MachineState<M>(
        gprs := before.gprs,
        flags := test_flags(read_gpr(left, before.gprs),
            read_gpr(right, before.gprs), af),
        rip := next_rip(before.rip, length),
        memory := before.memory,
    )
}

// AF after TEST is undefined. The two permitted outcomes still agree on
// every register, RIP, memory, and every flag a later instruction reads:
// they are equal once AF is erased.
fn erase_af<M>(state: MachineState<M>) → MachineState<M> {
    MachineState(
        gprs := state.gprs,
        flags := Flags(state.flags.cf, state.flags.pf, False,
            state.flags.zf, state.flags.sf, state.flags.of),
        rip := state.rip,
        memory := state.memory)
}

// States the same where defined: the pullback of `=` along `erase_af`
// (`SameDefinedState::pullback`), so its equivalence is `pullback_equivalence`'s
// and a function respects it as soon as it commutes with erasing
// (`same_defined_respects`). Proofs may still use `refl`, `sym` and `trans`
// on it directly: it is an equality of erased states.
fn SameDefinedState<M>(left, right: MachineState<M>) → Type {
    erase_af(left) = erase_af(right)
}

theorem SameDefinedState::pullback<M>(left, right: MachineState<M>):
    SameDefinedState<M>(left, right) = Pullback(erase_af<M>, RelId<MachineState<M>>, left, right) {
    refl
}

instance<M> Equivalence<MachineState<M>>(SameDefinedState<M>) {
    rel_refl := pullback_equivalence(erase_af<M>, RelId<MachineState<M>>, relid_equivalence()).rel_refl,
    rel_sym := pullback_equivalence(erase_af<M>, RelId<MachineState<M>>, relid_equivalence()).rel_sym,
    rel_trans := pullback_equivalence(erase_af<M>, RelId<MachineState<M>>, relid_equivalence()).rel_trans,
}

designation ≈ at MachineState := SameDefinedState

theorem SameDefinedState::of_equal<M>({left, right: MachineState<M>}, same: left = right): left ≈ right {
    cong_fn(erase_af<M>, same)
}

// The defined components, read back.
theorem SameDefinedState::gprs<M>({left, right: MachineState<M>}, same: left ≈ right): left.gprs = right.gprs {
    cong_fn(λ (state: MachineState<M>) => state.gprs, same)
}
theorem SameDefinedState::rip<M>({left, right: MachineState<M>}, same: left ≈ right): left.rip = right.rip {
    cong_fn(λ (state: MachineState<M>) => state.rip, same)
}
theorem SameDefinedState::memory<M>({left, right: MachineState<M>}, same: left ≈ right): left.memory = right.memory {
    cong_fn(λ (state: MachineState<M>) => state.memory, same)
}

// Commuting with the quotient map is respecting the relation.
theorem same_defined_respects<M>(f: MachineState<M> → MachineState<M>,
    commute: (state: MachineState<M>) → erase_af(f(state)) = erase_af(f(erase_af(state)))):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, f) {
    λ left right same => trans(commute(left),
        trans(cong_fn(λ (state: MachineState<M>) => erase_af(f(state)), same), sym(commute(right))))
}

theorem erase_af_normal_commute<M>(instruction: Instruction, before: MachineState<M>):
    erase_af(execute_normal(decoded_canonical(instruction), before)) =
    erase_af(execute_normal(decoded_canonical(instruction), erase_af(before))) {
    match instruction {
        MovRR(_, _) => refl, MovRI(_, _) => refl,
        AddRR(_, _) => refl, SubRR(_, _) => refl,
        AndRR(_, _) => refl, OrRR(_, _) => refl, XorRR(_, _) => refl,
        CmpRR(_, _) => refl, SetBelow(_) => refl, SetLess(_) => refl, SetEqual(_) => refl,
        TestRR(_, _) => refl, AddRI8(_, _) => refl, AddRI32(_, _) => refl,
        ShiftOne(_, _) => refl,
    }
}

evidence theorem execute_normal_respects_defined<M>({instruction: Instruction}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, execute_normal<M>(decoded_canonical(instruction))) {
    same_defined_respects(execute_normal<M>(decoded_canonical(instruction)),
        λ state => erase_af_normal_commute(instruction, state))
}

theorem returned_machine_inj<M>(left, right: MachineState<M>,
    same: Returned<MachineState<M>, Exception>(left) = Returned(right)):
    left = right {
    Option::some_inj(left, right,
        cong_fn(λ outcome => match outcome {
            Returned(state) => Some(state),
            Faulted(_) => None<MachineState<M>>,
        }, same))
}

theorem execute_test_same_defined<M>(left, right: Gpr, length: Nat,
    before: MachineState<M>, first, second: Bool):
    SameDefinedState<M>(execute_test(left, right, length, before, first),
        execute_test(left, right, length, before, second)) {
    refl
}

theorem execute_shift_same_defined<M>(op: ShiftOp, destination: Gpr, length: Nat,
    before: MachineState<M>, first, second: Bool):
    SameDefinedState<M>(execute_shift(op, destination, length, before, first),
        execute_shift(op, destination, length, before, second)) {
    refl
}

fn Execute<M>(decoded: DecodedInstruction, before: MachineState<M>,
    outcome: SemanticOutcome<MachineState<M>, Exception>) → Type
{
    match decoded.instruction {
        MovRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        MovRI(_, _) => outcome = Returned(execute_normal(decoded, before)),
        AddRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        SubRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        AndRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        OrRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        XorRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        CmpRR(_, _) => outcome = Returned(execute_normal(decoded, before)),
        SetBelow(_) => outcome = Returned(execute_normal(decoded, before)),
        SetLess(_) => outcome = Returned(execute_normal(decoded, before)),
        SetEqual(_) => outcome = Returned(execute_normal(decoded, before)),
        TestRR(left, right) => ∃ af: Bool,
            outcome = Returned(execute_test(left, right, decoded.length, before, af)),
        AddRI8(_, _) => outcome = Returned(execute_normal(decoded, before)),
        AddRI32(_, _) => outcome = Returned(execute_normal(decoded, before)),
        ShiftOne(op, destination) => ∃ af: Bool,
            outcome = Returned(execute_shift(op, destination, decoded.length, before, af)),
    }
}

theorem execute_fixed_same_defined<M>(form: Instruction, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before, after: MachineState<M>,
    proof: Returned<MachineState<M>, Exception>(after) =
        Returned(execute_normal(DecodedInstruction(form, length, valid), before))):
    SameDefinedState<M>(after, execute_normal(DecodedInstruction(form, length, valid), before)) {
    SameDefinedState::of_equal(returned_machine_inj(after, execute_normal(DecodedInstruction(form, length, valid), before), proof))
}

// An ordinary instruction has one result; TEST's only choice is AF.
theorem execute_same_defined<M>(instruction: Instruction, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before, after: MachineState<M>,
    executed: Execute(DecodedInstruction(instruction, length, valid), before, Returned(after))):
    SameDefinedState<M>(after,
        execute_normal(DecodedInstruction(instruction, length, valid), before)) {
    (match instruction as λ form => (result: MachineState<M>) →
        Execute(DecodedInstruction(form, length, valid), before, Returned(result)) →
        SameDefinedState<M>(result, execute_normal(DecodedInstruction(form, length, valid), before)) {
        MovRR(d, s) => λ result proof => execute_fixed_same_defined(MovRR(d, s), length, valid, before, result, proof),
        MovRI(d, value) => λ result proof => execute_fixed_same_defined(MovRI(d, value), length, valid, before, result, proof),
        AddRR(d, s) => λ result proof => execute_fixed_same_defined(AddRR(d, s), length, valid, before, result, proof),
        SubRR(d, s) => λ result proof => execute_fixed_same_defined(SubRR(d, s), length, valid, before, result, proof),
        AndRR(d, s) => λ result proof => execute_fixed_same_defined(AndRR(d, s), length, valid, before, result, proof),
        OrRR(d, s) => λ result proof => execute_fixed_same_defined(OrRR(d, s), length, valid, before, result, proof),
        XorRR(d, s) => λ result proof => execute_fixed_same_defined(XorRR(d, s), length, valid, before, result, proof),
        CmpRR(d, s) => λ result proof => execute_fixed_same_defined(CmpRR(d, s), length, valid, before, result, proof),
        SetBelow(d) => λ result proof => execute_fixed_same_defined(SetBelow(d), length, valid, before, result, proof),
        SetLess(d) => λ result proof => execute_fixed_same_defined(SetLess(d), length, valid, before, result, proof),
        SetEqual(d) => λ result proof => execute_fixed_same_defined(SetEqual(d), length, valid, before, result, proof),
        AddRI8(d, value) => λ result proof => execute_fixed_same_defined(AddRI8(d, value), length, valid, before, result, proof),
        AddRI32(d, value) => λ result proof => execute_fixed_same_defined(AddRI32(d, value), length, valid, before, result, proof),
        TestRR(left, right) => λ result proof =>
            j(sym(returned_machine_inj(result,
                execute_test(left, right, length, before, proof.witness), proof.proof)),
                λ state _ => SameDefinedState<M>(state,
                    execute_normal(DecodedInstruction(TestRR(left, right), length, valid), before)),
                execute_test_same_defined(left, right, length, before, proof.witness, False)),
        ShiftOne(op, d) => λ result proof =>
            j(sym(returned_machine_inj(result,
                execute_shift(op, d, length, before, proof.witness), proof.proof)),
                λ state _ => SameDefinedState<M>(state,
                    execute_normal(DecodedInstruction(ShiftOne(op, d), length, valid), before)),
                execute_shift_same_defined(op, d, length, before, proof.witness, False)),
    })(after, executed)
}

theorem execute_pair_same_defined<M>(instruction: Instruction, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before, first, second: MachineState<M>,
    left: Execute(DecodedInstruction(instruction, length, valid), before, Returned(first)),
    right: Execute(DecodedInstruction(instruction, length, valid), before, Returned(second))):
    SameDefinedState<M>(first, second) {
    trans(execute_same_defined(instruction, length, valid, before, first, left),
        sym(execute_same_defined(instruction, length, valid, before, second, right)))
}

theorem execute_canonical_respects_defined<M>(instruction: Instruction,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: SameDefinedState<M>(before_left, before_right),
    left: Execute(decoded_canonical(instruction), before_left, Returned(after_left)),
    right: Execute(decoded_canonical(instruction), before_right, Returned(after_right))):
    SameDefinedState<M>(after_left, after_right) {
    let valid = squash(canonical_length_valid(instruction));
    calc {
        after_left ≈ execute_normal(decoded_canonical(instruction), before_left) :=
            execute_same_defined(instruction, canonical_length(instruction), valid, before_left, after_left, left),
        ≈ execute_normal(decoded_canonical(instruction), before_right) := rel_cong(before_same),
        ≈ after_right := sym(execute_same_defined(instruction, canonical_length(instruction), valid,
            before_right, after_right, right)),
    }
}

// This is the byte/typed execution composition for the current no-fetch-fault
// slice. The start-address equality is kept explicit because `InstructionBytes`
// is also useful for relocated compiler output before it is placed at RIP.
fn ExecuteAt<M>(span: InstructionBytes, decoded: DecodedInstruction,
    before: MachineState<M>, outcome: SemanticOutcome<MachineState<M>, Exception>) → Type
{
    span.start = before.rip ∧ DecodedAt(span, decoded)
        ∧ Execute(decoded, before, outcome)
}

theorem canonical_execute_normal_is_allowed<M>(instruction: Instruction,
    before: MachineState<M>):
    Execute(decoded_canonical(instruction), before,
        Returned(execute_normal(decoded_canonical(instruction), before)))
{
    match instruction {
        MovRR(_, _) => refl,
        MovRI(_, _) => refl,
        AddRR(_, _) => refl,
        SubRR(_, _) => refl,
        AndRR(_, _) => refl,
        OrRR(_, _) => refl,
        XorRR(_, _) => refl,
        CmpRR(_, _) => refl,
        SetBelow(_) => refl,
        SetLess(_) => refl,
        SetEqual(_) => refl,
        TestRR(_, _) => Exists(False, refl),
        AddRI8(_, _) => refl,
        AddRI32(_, _) => refl,
        ShiftOne(_, _) => Exists(False, refl),
    }
}

theorem canonical_encoding_executes<M>(instruction: Instruction,
    before: MachineState<M>):
    ExecuteAt(encoded_at(before.rip, instruction),
        decoded_canonical(instruction), before,
        Returned(execute_normal(decoded_canonical(instruction), before)))
{
    And(refl, And(canonical_encoding_decodes(before.rip, instruction),
        canonical_execute_normal_is_allowed(instruction, before)))
}

theorem decoded_byte_result_executes<M>(bytes: List<BitVec(8)>,
    result: ByteDecode(bytes), before: MachineState<M>):
    ExecuteAt(
        InstructionBytes(start := before.rip, bytes := bytes),
        decoded_canonical(result.instruction), before,
        Returned(execute_normal(decoded_canonical(result.instruction), before)))
{
    And(refl, And(decoded_byte_result_at(before.rip, bytes, result),
        canonical_execute_normal_is_allowed(result.instruction, before)))
}

theorem alternate_mov_encoding_executes<M>(destination, source: Gpr,
    before: MachineState<M>):
    ExecuteAt(
        InstructionBytes(start := before.rip,
            bytes := alternate_mov_bytes(destination, source)),
        decoded_rr(MovRR(destination, source)), before,
        Returned(execute_normal(decoded_rr(MovRR(destination, source)), before)))
{
    And(refl, And(
        alternate_mov_encoding_decodes(before.rip, destination, source),
        canonical_execute_normal_is_allowed(MovRR(destination, source), before)))
}

theorem alternate_add_encoding_executes<M>(destination, source: Gpr,
    before: MachineState<M>):
    ExecuteAt(
        InstructionBytes(start := before.rip,
            bytes := alternate_add_bytes(destination, source)),
        decoded_rr(AddRR(destination, source)), before,
        Returned(execute_normal(decoded_rr(AddRR(destination, source)), before)))
{
    And(refl, And(
        alternate_add_encoding_decodes(before.rip, destination, source),
        canonical_execute_normal_is_allowed(AddRR(destination, source), before)))
}

theorem alternate_sub_encoding_executes<M>(destination, source: Gpr,
    before: MachineState<M>):
    ExecuteAt(
        InstructionBytes(start := before.rip,
            bytes := alternate_sub_bytes(destination, source)),
        decoded_rr(SubRR(destination, source)), before,
        Returned(execute_normal(decoded_rr(SubRR(destination, source)), before)))
{
    And(refl, And(
        alternate_sub_encoding_decodes(before.rip, destination, source),
        canonical_execute_normal_is_allowed(SubRR(destination, source), before)))
}

theorem alternate_cmp_encoding_executes<M>(left, right: Gpr,
    before: MachineState<M>):
    ExecuteAt(
        InstructionBytes(start := before.rip,
            bytes := alternate_cmp_bytes(left, right)),
        decoded_rr(CmpRR(left, right)), before,
        Returned(execute_normal(decoded_rr(CmpRR(left, right)), before)))
{
    And(refl, And(alternate_cmp_encoding_decodes(before.rip, left, right),
        canonical_execute_normal_is_allowed(CmpRR(left, right), before)))
}

theorem external_decoding_executes<M>(span: InstructionBytes,
    decoded: DecodedInstruction, before: MachineState<M>,
    outcome: SemanticOutcome<MachineState<M>, Exception>,
    at_rip: span.start = before.rip, decoding: DecodedAt(span, decoded),
    execution: Execute(decoded, before, outcome)):
    ExecuteAt(span, decoded, before, outcome)
{
    And(at_rip, And(decoding, execution))
}

theorem test_allows_af<M>(left, right: Gpr, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before: MachineState<M>, af: Bool):
    Execute(
        DecodedInstruction(instruction := TestRR(left, right),
            length := length, valid_length := valid),
        before, Returned(execute_test(left, right, length, before, af)))
{
    Exists(af, refl)
}

theorem test_flags_spec(left, right: BitVec(64), af: Bool):
    test_flags(left, right, af) =
        Flags(
            cf := False,
            pf := xor_bits(8,
                left.band(right).take_low(8, 56)).not(),
            af := af,
            zf := is_zero_bits(64, left.band(right)),
            sf := left.band(right).sign_bit(),
            of := False)
{}

theorem sub_flags_spec(left, right: BitVec(64)):
    sub_flags(left, right) =
        Flags(
            cf := left.borrow_sub_bit(right),
            pf := xor_bits(8,
                left.sub(right).take_low(8, 56)).not(),
            af := left.take_low(4, 60).borrow_sub_bit(
                right.take_low(4, 60)),
            zf := is_zero_bits(64, left.sub(right)),
            sf := left.sub(right).sign_bit(),
            of := left.signed_overflow_sub(right))
{}

theorem execute_cmp_frames<M>(left, right: Gpr, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before: MachineState<M>):
    execute_normal(
        DecodedInstruction(instruction := CmpRR(left, right),
            length := length, valid_length := valid), before).gprs = before.gprs
    ∧ execute_normal(
        DecodedInstruction(instruction := CmpRR(left, right),
            length := length, valid_length := valid), before).memory = before.memory
    ∧ execute_normal(
        DecodedInstruction(instruction := CmpRR(left, right),
            length := length, valid_length := valid), before).rip =
        next_rip(before.rip, length)
{
    And(refl, And(refl, refl))
}

theorem execute_test_frames<M>(left, right: Gpr, length: Nat,
    before: MachineState<M>, af: Bool):
    execute_test(left, right, length, before, af).gprs = before.gprs
    ∧ execute_test(left, right, length, before, af).memory = before.memory
    ∧ execute_test(left, right, length, before, af).rip =
        next_rip(before.rip, length)
{
    And(refl, And(refl, refl))
}

theorem execute_normal_test_is_allowed<M>(left, right: Gpr, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before: MachineState<M>):
    Execute(
        DecodedInstruction(instruction := TestRR(left, right),
            length := length, valid_length := valid),
        before,
        Returned(execute_normal(
            DecodedInstruction(instruction := TestRR(left, right),
                length := length, valid_length := valid), before)))
{
    Exists(False, refl)
}

inductive CoverageStatus { SemanticsDefined, SemanticsMissing }

fn coverage(instruction: Instruction) → CoverageStatus { SemanticsDefined }

theorem mov_preserves_flags<M>(destination, source: Gpr, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before: MachineState<M>):
    execute_normal(
        DecodedInstruction(instruction := MovRR(destination, source),
            length := length, valid_length := valid), before).flags = before.flags
{}

theorem mov_preserves_memory<M>(destination, source: Gpr, length: Nat,
    valid: ∥1 <= length ∧ length <= 15∥, before: MachineState<M>):
    execute_normal(
        DecodedInstruction(instruction := MovRR(destination, source),
            length := length, valid_length := valid), before).memory = before.memory
{}

theorem mov_ri_writes_immediate<M>(destination: Gpr, immediate: BitVec(64),
    before: MachineState<M>):
    read_gpr(destination,
        execute_normal(decoded_canonical(MovRI(destination, immediate)),
            before).gprs) = immediate
{
    read_gpr_after_write(destination, immediate, before.gprs)
}

theorem mov_ri_preserves_flags<M>(destination: Gpr, immediate: BitVec(64),
    before: MachineState<M>):
    execute_normal(decoded_canonical(MovRI(destination, immediate)),
        before).flags = before.flags
{}

theorem mov_ri_preserves_memory<M>(destination: Gpr, immediate: BitVec(64),
    before: MachineState<M>):
    execute_normal(decoded_canonical(MovRI(destination, immediate)),
        before).memory = before.memory
{}

theorem execute_normal_advances_rip<M>(decoded: DecodedInstruction,
    before: MachineState<M>):
    execute_normal(decoded, before).rip =
        next_rip(before.rip, decoded.length)
{
    match decoded.instruction {
        MovRR(_, _) => refl,
        MovRI(_, _) => refl,
        AddRR(_, _) => refl,
        SubRR(_, _) => refl,
        AndRR(_, _) => refl,
        OrRR(_, _) => refl,
        XorRR(_, _) => refl,
        CmpRR(_, _) => refl,
        SetBelow(_) => refl,
        SetLess(_) => refl,
        SetEqual(_) => refl,
        TestRR(_, _) => refl,
        AddRI8(_, _) => refl,
        AddRI32(_, _) => refl,
        ShiftOne(_, _) => refl,
    }
}

theorem decoded_execution_advances_by_consumed_length<M>(span: InstructionBytes,
    decoded: DecodedInstruction, before: MachineState<M>,
    decoding: DecodedAt(span, decoded)):
    execute_normal(decoded, before).rip =
        next_rip(before.rip, canonical_length(decoded.instruction))
{
    apply trans;
    give execute_normal_advances_rip(decoded, before);
    cong_fn(λ (length: Nat) => next_rip(before.rip, length), decoding.right)
}

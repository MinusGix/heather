// Fetched straight-line traces reuse the canonical instruction relation.
import x86_64;
import x86_64_fetch;
import bitvec;
import list;
import logic;
import relation;

fn ExecuteFetchedBlock<M>(access: FetchAccess<M>, instructions: List<Instruction>) →
    MachineState<M> → MachineState<M> → Type
{
    ExecuteSteps(λ instruction before after =>
        ExecuteFetched(access, encoded_at(before.rip, instruction),
            decoded_canonical(instruction), before, Returned(after)), instructions)
}

// The selector proposes flattened successor states and supplies their checked
// equality to the canonical step. Keeping this equality separate prevents
// trace composition from expanding preceding register computations in reads.
theorem canonical_fetched_step<M>(access: FetchAccess<M>, instruction: Instruction,
    before, after: MachineState<M>,
    fetched: FetchedFrom(access, before.memory, encoded_at(before.rip, instruction)),
    successor: after = execute_normal(decoded_canonical(instruction), before)):
    ExecuteFetched(access, encoded_at(before.rip, instruction),
        decoded_canonical(instruction), before, Returned(after))
{
    j(sym(successor), λ state _ => ExecuteFetched(access,
        encoded_at(before.rip, instruction), decoded_canonical(instruction), before, Returned(state)),
        ⟨fetched, canonical_encoding_executes(instruction, before)⟩)
}

theorem fetched_block_nil<M>(access: FetchAccess<M>, state: MachineState<M>):
    ExecuteFetchedBlock(access, [], state, state)
{ refl }

theorem fetched_block_cons<M>(access: FetchAccess<M>, instruction: Instruction,
    rest: List<Instruction>, before, middle, after: MachineState<M>,
    head: ExecuteFetched(access, encoded_at(before.rip, instruction),
        decoded_canonical(instruction), before, Returned(middle)),
    tail: ExecuteFetchedBlock(access, rest, middle, after)):
    ExecuteFetchedBlock(access, Cons(instruction, rest), before, after)
{ ⟨middle, ⟨head, tail⟩⟩ }

theorem fetched_encoding_at_state<M>(access: FetchAccess<M>, memory: M,
    start: BitVec(64), bytes: List<BitVec(8)>, instruction: Instruction,
    before: MachineState<M>, memory_correct: memory = before.memory,
    start_correct: start = before.rip, encoding: bytes = canonical_bytes(instruction),
    fetched: FetchedFrom(access, memory, InstructionBytes(start, bytes))):
    FetchedFrom(access, before.memory, encoded_at(before.rip, instruction))
{
    j(memory_correct, λ actual _ =>
        FetchedFrom(access, actual, encoded_at(before.rip, instruction)),
        j(start_correct, λ actual _ =>
            FetchedFrom(access, memory, encoded_at(actual, instruction)),
            j(encoding, λ actual _ =>
                FetchedFrom(access, memory, InstructionBytes(start, actual)), fetched)))
}

theorem fetched_block_instructions_cong<M>(access: FetchAccess<M>,
    left, right: List<Instruction>, before, after: MachineState<M>, same: left = right,
    execution: ExecuteFetchedBlock(access, left, before, after)):
    ExecuteFetchedBlock(access, right, before, after)
{
    j(same, λ instructions _ => ExecuteFetchedBlock(access, instructions, before, after), execution)
}

theorem fetched_span_at_state<M>(access: FetchAccess<M>, memory: M,
    start: BitVec(64), bytes, expected: List<BitVec(8)>, before: MachineState<M>,
    memory_correct: memory = before.memory, start_correct: start = before.rip,
    bytes_correct: bytes = expected,
    fetched: FetchedFrom(access, memory, InstructionBytes(start, bytes))):
    FetchedFrom(access, before.memory, InstructionBytes(before.rip, expected))
{
    j(memory_correct, λ actual _ => FetchedFrom(access, actual, InstructionBytes(before.rip, expected)),
        j(start_correct, λ actual _ => FetchedFrom(access, memory, InstructionBytes(actual, expected)),
            j(bytes_correct, λ actual _ => FetchedFrom(access, memory, InstructionBytes(start, actual)), fetched)))
}

theorem canonical_successor_cong<M>(instruction: Instruction,
    before_left, before_right, after_left, after_right: MachineState<M>,
    before_same: before_left = before_right,
    left_step: after_left = execute_normal(decoded_canonical(instruction), before_left),
    right_step: after_right = execute_normal(decoded_canonical(instruction), before_right)):
    after_left = after_right
{
    trans(left_step, trans(cong_fn<MachineState<M>, MachineState<M>>(
        λ state => execute_normal(decoded_canonical(instruction), state), before_same), sym(right_step)))
}

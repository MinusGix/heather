// Normal-path MOVZX r64, byte [base], followed by existing structured code.
// Intel SDM Vol. 2B, MOVZX: REX.W + 0F B6 /r. The canonical subset uses
// zero displacement, no index/segment override, and low canonical addresses.
// A Some result grants an actual byte read; absent/denied accesses have no
// normal step. This is neither a page-table model nor an instruction fetch.
import x86_64;
import x86_64_structured_block;
import bitvec;
import bool;
import list;
import logic;
import option;
import nat;

record ByteReadAccess<M> { read: M → BitVec(64) → Option<BitVec(8)> }
record ByteLoad { destination: Gpr, base: Gpr }

fn byte_load_displaced(base: Gpr) → Bool {
    match base { Rbp => True, R13 => True, _ => False }
}
fn byte_load_sib(base: Gpr) → Bool {
    match base { Rsp => True, R12 => True, _ => False }
}
fn byte_load_bytes(load: ByteLoad) → List<BitVec(8)> {
    list::append<BitVec(8)>([rex_w_rr(load.base, load.destination), bitvec::ofNat(8, 0x0f), bitvec::ofNat(8, 0xb6),
        byte_from_fields(gpr_bit0(load.base), gpr_bit1(load.base), gpr_bit2(load.base),
            gpr_bit0(load.destination), gpr_bit1(load.destination), gpr_bit2(load.destination),
            byte_load_displaced(load.base), False)],
        list::append<BitVec(8)>(
            match byte_load_sib(load.base) { True => [bitvec::ofNat(8, 0x24)], False => [] },
            match byte_load_displaced(load.base) { True => [bitvec::ofNat(8, 0)], False => [] }))
}
// Exact canonical decoding coverage. Other memory operand encodings are not
// claimed; corrupt prefixes, ModRM/SIB bytes, or lengths fail this equality.
fn ByteLoadDecodes(bytes: List<BitVec(8)>, load: ByteLoad) → Type {
    bytes = byte_load_bytes(load)
}
fn byte_load_after<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>) → MachineState<M> {
    MachineState(gprs := write_gpr(load.destination, bitvec::zero_extend(8, 56, byte), before.gprs),
        flags := before.flags, rip := next_rip(before.rip, byte_load_bytes(load).len()), memory := before.memory)
}
record ByteLoadStep<M>(access: ByteReadAccess<M>, load: ByteLoad, byte: BitVec(8),
    before, after: MachineState<M>) {
    canonical: bitvec::drop_low(47, 17, read_gpr(load.base, before.gprs)) = bitvec::zero(17),
    present: access.read(before.memory, read_gpr(load.base, before.gprs)) = Some(byte),
    execution: after = byte_load_after(load, byte, before),
}

theorem byte_load_result<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>):
    read_gpr(load.destination, byte_load_after(load, byte, before).gprs) = bitvec::zero_extend(8, 56, byte) {
    read_gpr_after_write(load.destination, bitvec::zero_extend(8, 56, byte), before.gprs)
}
theorem byte_load_preserves<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>, register: Gpr,
    distinct: nat_same(gpr_index(load.destination), gpr_index(register)) = False):
    read_gpr(register, byte_load_after(load, byte, before).gprs) = read_gpr(register, before.gprs) {
    cong_fn<Bool, BitVec(64)>(λ same => match same {
        False => read_gpr(register, before.gprs), True => bitvec::zero_extend(8, 56, byte),
    }, distinct)
}
fn ReadThenProtected(load: ByteLoad, protected: Gpr → Type, register: Gpr) → Type {
    (nat_same(gpr_index(load.destination), gpr_index(register)) = False) ∧ protected(register)
}
record ReadThenArtifact<M>(access: ByteReadAccess<M>, load: ByteLoad, byte: BitVec(8),
    code: StructuredCode, bytes: List<BitVec(8)>, before: MachineState<M>,
    output: Gpr, result: BitVec(64), protected: Gpr → Type) {
    load_step: ByteLoadStep<M>(access, load, byte, before, byte_load_after(load, byte, before)),
    encoding: bytes = byte_load_bytes(load) ++ structured_bytes(code),
    continuation: StructuredArtifact<M>(code, byte_load_after(load, byte, before), output, result, protected),
    memory_preserved: continuation.after.memory = before.memory,
    rip_correct: continuation.after.rip = next_rip(before.rip, byte_load_bytes(load).len() + structured_bytes(code).len()),
    registers_preserved: (register: Gpr) → ReadThenProtected(load, protected, register) →
        read_gpr(register, continuation.after.gprs) = read_gpr(register, before.gprs),
}
theorem read_then_artifact<M>(access: ByteReadAccess<M>, load: ByteLoad, byte: BitVec(8),
    code: StructuredCode, before: MachineState<M>, output: Gpr, result: BitVec(64), protected: Gpr → Type,
    step: ByteLoadStep<M>(access, load, byte, before, byte_load_after(load, byte, before)),
    body: StructuredArtifact<M>(code, byte_load_after(load, byte, before), output, result, protected)):
    ReadThenArtifact<M>(access, load, byte, code, byte_load_bytes(load) ++ structured_bytes(code), before, output, result, protected) {
    ReadThenArtifact(load_step := step, encoding := refl, continuation := body,
        memory_preserved := body.memory_preserved,
        rip_correct := trans(body.rip_correct, bitvec::iterate_increment_compose(64, before.rip,
            byte_load_bytes(load).len(), structured_bytes(code).len())),
        registers_preserved := λ register preserved => trans(body.registers_preserved(register, preserved.right),
            byte_load_preserves(load, byte, before, register, preserved.left)))
}

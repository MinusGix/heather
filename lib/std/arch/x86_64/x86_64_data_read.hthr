// Normal-path MOVZX r64, byte [base], and MOV r64, [base].
// Intel SDM Vol. 2B, MOVZX: REX.W + 0F B6 /r. The canonical subset uses
// zero displacement, no index/segment override, and low canonical addresses.
// A Some result grants an actual byte read; absent/denied accesses have no
// normal step. This is neither a page-table model nor an instruction fetch.
import x86_64;
import bitvec;
import bool;
import list;
import logic;
import option;
import nat;
import relation_props;

record ByteReadAccess<M> { read: M → BitVec(64) → Option<BitVec(8)> }
record ByteLoad { destination: Gpr, base: Gpr }

fn byte_load_displaced(base: Gpr) → Bool {
    match base { Rbp => True, R13 => True, _ => False }
}
fn byte_load_sib(base: Gpr) → Bool {
    match base { Rsp => True, R12 => True, _ => False }
}
fn byte_load_bytes(load: ByteLoad) → List<BitVec(8)> {
    List::append<BitVec(8)>([rex_w_rr(load.base, load.destination), BitVec::ofNat(0x0f), BitVec::ofNat(0xb6),
        byte_from_fields(gpr_bit0(load.base), gpr_bit1(load.base), gpr_bit2(load.base),
            gpr_bit0(load.destination), gpr_bit1(load.destination), gpr_bit2(load.destination),
            byte_load_displaced(load.base), False)],
        List::append<BitVec(8)>(
            match byte_load_sib(load.base) { True => [BitVec::ofNat(0x24)], False => [] },
            match byte_load_displaced(load.base) { True => [BitVec::ofNat(0)], False => [] }))
}
// Exact canonical decoding coverage. Other memory operand encodings are not
// claimed; corrupt prefixes, ModRM/SIB bytes, or lengths fail this equality.
fn ByteLoadDecodes(bytes: List<BitVec(8)>, load: ByteLoad) → Type {
    bytes = byte_load_bytes(load)
}
fn byte_load_after<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>) → MachineState<M> {
    MachineState(gprs := write_gpr(load.destination, byte.zero_extend(56), before.gprs),
        flags := before.flags, rip := next_rip(before.rip, byte_load_bytes(load).len()), memory := before.memory)
}
record ByteLoadStep<M>(access: ByteReadAccess<M>, load: ByteLoad, byte: BitVec(8),
    before, after: MachineState<M>) {
    canonical: read_gpr(load.base, before.gprs).drop_low(47, 17) = BitVec::zero(),
    present: access.read(before.memory, read_gpr(load.base, before.gprs)) = Some(byte),
    execution: after = byte_load_after(load, byte, before),
}

theorem byte_load_same<M>(access: ByteReadAccess<M>, load: ByteLoad,
    before, first, second: MachineState<M>, left, right: BitVec(8),
    left_step: ByteLoadStep<M>(access, load, left, before, first),
    right_step: ByteLoadStep<M>(access, load, right, before, second)):
    first = second {
    let byte = Option::some_inj(left, right,
        trans(sym(left_step.present), right_step.present));
    trans(left_step.execution,
        trans(cong_fn(λ value => byte_load_after(load, value, before), byte),
            sym(right_step.execution)))
}

evidence theorem byte_load_after_respects_defined<M>({load: ByteLoad}, {byte: BitVec(8)}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, byte_load_after<M>(load, byte)) {
    same_defined_respects(byte_load_after<M>(load, byte), λ state => refl)
}

theorem byte_load_respects_defined<M>(access: ByteReadAccess<M>, load: ByteLoad,
    before_left, before_right, after_left, after_right: MachineState<M>,
    left_byte, right_byte: BitVec(8), before_same: SameDefinedState<M>(before_left, before_right),
    left: ByteLoadStep<M>(access, load, left_byte, before_left, after_left),
    right: ByteLoadStep<M>(access, load, right_byte, before_right, after_right)):
    SameDefinedState<M>(after_left, after_right) {
    let address = cong_fn(λ (gprs: Gprs) => read_gpr(load.base, gprs), SameDefinedState::gprs(before_same));
    let read_same = trans(
        cong_fn(λ (memory: M) => access.read(memory, read_gpr(load.base, before_left.gprs)), SameDefinedState::memory(before_same)),
        cong_fn(λ (at: BitVec(64)) => access.read(before_right.memory, at), address));
    let byte = Option::some_inj(left_byte, right_byte,
        trans(sym(left.present), trans(read_same, right.present)));
    calc {
        after_left ≈ byte_load_after(load, left_byte, before_left) := SameDefinedState::of_equal(left.execution),
        ≈ byte_load_after(load, left_byte, before_right) := rel_cong(before_same),
        ≈ byte_load_after(load, right_byte, before_right) :=
            SameDefinedState::of_equal(cong_fn(λ value => byte_load_after(load, value, before_right), byte)),
        ≈ after_right := SameDefinedState::of_equal(sym(right.execution)),
    }
}

theorem byte_load_result<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>):
    read_gpr(load.destination, byte_load_after(load, byte, before).gprs) = byte.zero_extend(56) {
    read_gpr_after_write(load.destination, byte.zero_extend(56), before.gprs)
}
theorem byte_load_preserves<M>(load: ByteLoad, byte: BitVec(8), before: MachineState<M>, register: Gpr,
    distinct: load.destination.same(register) = False):
    read_gpr(register, byte_load_after(load, byte, before).gprs) = read_gpr(register, before.gprs) {
    trans(read_gpr_write(load.destination, register, byte.zero_extend(56), before.gprs),
        cong_fn<Bool, BitVec(64)>(λ same => match same {
            False => read_gpr(register, before.gprs), True => byte.zero_extend(56),
        }, distinct))
}
// Normal-path MOV r64, qword [base] (Intel SDM Vol. 2B, MOV: REX.W + 8B /r),
// over the same canonical ModRM/SIB/displacement subset as the byte load. Its
// eight bytes are read low first, each through the profile's byte access; a
// word that any byte of is absent has no normal step.
record WordLoad { destination: Gpr, base: Gpr }

fn word_load_bytes(load: WordLoad) → List<BitVec(8)> {
    List::append<BitVec(8)>([rex_w_rr(load.base, load.destination), BitVec::ofNat(0x8b),
        byte_from_fields(gpr_bit0(load.base), gpr_bit1(load.base), gpr_bit2(load.base),
            gpr_bit0(load.destination), gpr_bit1(load.destination), gpr_bit2(load.destination),
            byte_load_displaced(load.base), False)],
        List::append<BitVec(8)>(
            match byte_load_sib(load.base) { True => [BitVec::ofNat(0x24)], False => [] },
            match byte_load_displaced(load.base) { True => [BitVec::ofNat(0)], False => [] }))
}
fn word_of_reads(o0, o1, o2, o3, o4, o5, o6, o7: Option<BitVec(8)>) → Option<BitVec(64)> {
    match o0 { None => None, Some(b0) => match o1 { None => None, Some(b1) => match o2 { None => None, Some(b2) =>
    match o3 { None => None, Some(b3) => match o4 { None => None, Some(b4) => match o5 { None => None, Some(b5) =>
    match o6 { None => None, Some(b6) => match o7 { None => None, Some(b7) =>
        Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7)) } } } } } } } }
}
fn read_word<M>(access: ByteReadAccess<M>, memory: M, address: BitVec(64)) → Option<BitVec(64)> {
    word_of_reads(access.read(memory, address), access.read(memory, next_rip(address, 1)),
        access.read(memory, next_rip(address, 2)), access.read(memory, next_rip(address, 3)),
        access.read(memory, next_rip(address, 4)), access.read(memory, next_rip(address, 5)),
        access.read(memory, next_rip(address, 6)), access.read(memory, next_rip(address, 7)))
}
// Eight bytes present read as their word.
theorem word_of_eight(o0, o1, o2, o3, o4, o5, o6, o7: Option<BitVec(8)>, b0, b1, b2, b3, b4, b5, b6, b7: BitVec(8),
    e0: o0 = Some(b0), e1: o1 = Some(b1), e2: o2 = Some(b2), e3: o3 = Some(b3), e4: o4 = Some(b4), e5: o5 = Some(b5),
    e6: o6 = Some(b6), e7: o7 = Some(b7)):
    word_of_reads(o0, o1, o2, o3, o4, o5, o6, o7) = Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7)) {
    let goal = Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7));
    j(sym(e0), λ x _ => word_of_reads(x, o1, o2, o3, o4, o5, o6, o7) = goal,
    j(sym(e1), λ x _ => word_of_reads(Some(b0), x, o2, o3, o4, o5, o6, o7) = goal,
    j(sym(e2), λ x _ => word_of_reads(Some(b0), Some(b1), x, o3, o4, o5, o6, o7) = goal,
    j(sym(e3), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), x, o4, o5, o6, o7) = goal,
    j(sym(e4), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), x, o5, o6, o7) = goal,
    j(sym(e5), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), x, o6, o7) = goal,
    j(sym(e6), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), Some(b5), x, o7) = goal,
    j(sym(e7), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), Some(b5), Some(b6), x) = goal, refl))))))))
}

// Eight reads that agree read the same word.
theorem read_word_agree<M>(access: ByteReadAccess<M>, m, n: M, a: BitVec(64),
    same: (t: Nat) → t < 8 → access.read(m, next_rip(a, t)) = access.read(n, next_rip(a, t))):
    read_word(access, m, a) = read_word(access, n, a) {
    let r = λ (memory: M) (t: Nat) => access.read(memory, next_rip(a, t));
    j(same(0, trivial), λ x _ => read_word(access, m, a) = word_of_reads(x, r(n, 1), r(n, 2), r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(1, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), x, r(n, 2), r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(2, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), x, r(n, 3), r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(3, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), x, r(n, 4), r(n, 5), r(n, 6), r(n, 7)),
    j(same(4, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), x, r(n, 5), r(n, 6), r(n, 7)),
    j(same(5, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), x, r(n, 6), r(n, 7)),
    j(same(6, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), r(m, 5), x, r(n, 7)),
    j(same(7, trivial), λ x _ => read_word(access, m, a) = word_of_reads(r(m, 0), r(m, 1), r(m, 2), r(m, 3), r(m, 4), r(m, 5), r(m, 6), x),
        refl))))))))
}
fn word_load_after<M>(load: WordLoad, word: BitVec(64), before: MachineState<M>) → MachineState<M> {
    MachineState(gprs := write_gpr(load.destination, word, before.gprs),
        flags := before.flags, rip := next_rip(before.rip, word_load_bytes(load).len()), memory := before.memory)
}
// All eight bytes lie below the canonical boundary, so none wraps.
record WordLoadStep<M>(access: ByteReadAccess<M>, load: WordLoad, word: BitVec(64),
    before, after: MachineState<M>) {
    canonical: read_gpr(load.base, before.gprs).toNat() + 8 <= Nat::pow(2, 47),
    present: read_word(access, before.memory, read_gpr(load.base, before.gprs)) = Some(word),
    execution: after = word_load_after(load, word, before),
}

theorem word_load_same<M>(access: ByteReadAccess<M>, load: WordLoad,
    before, first, second: MachineState<M>, left, right: BitVec(64),
    left_step: WordLoadStep<M>(access, load, left, before, first),
    right_step: WordLoadStep<M>(access, load, right, before, second)):
    first = second {
    let word = Option::some_inj(left, right,
        trans(sym(left_step.present), right_step.present));
    trans(left_step.execution,
        trans(cong_fn(λ value => word_load_after(load, value, before), word),
            sym(right_step.execution)))
}

evidence theorem word_load_after_respects_defined<M>({load: WordLoad}, {word: BitVec(64)}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, word_load_after<M>(load, word)) {
    same_defined_respects(word_load_after<M>(load, word), λ state => refl)
}

theorem word_load_respects_defined<M>(access: ByteReadAccess<M>, load: WordLoad,
    before_left, before_right, after_left, after_right: MachineState<M>,
    left_word, right_word: BitVec(64), before_same: SameDefinedState<M>(before_left, before_right),
    left: WordLoadStep<M>(access, load, left_word, before_left, after_left),
    right: WordLoadStep<M>(access, load, right_word, before_right, after_right)):
    SameDefinedState<M>(after_left, after_right) {
    let address = cong_fn(λ (gprs: Gprs) => read_gpr(load.base, gprs), SameDefinedState::gprs(before_same));
    let read_same = trans(
        cong_fn(λ (memory: M) => read_word(access, memory, read_gpr(load.base, before_left.gprs)), SameDefinedState::memory(before_same)),
        cong_fn(λ (at: BitVec(64)) => read_word(access, before_right.memory, at), address));
    let word = Option::some_inj(left_word, right_word,
        trans(sym(left.present), trans(read_same, right.present)));
    calc {
        after_left ≈ word_load_after(load, left_word, before_left) := SameDefinedState::of_equal(left.execution),
        ≈ word_load_after(load, left_word, before_right) := rel_cong(before_same),
        ≈ word_load_after(load, right_word, before_right) :=
            SameDefinedState::of_equal(cong_fn(λ value => word_load_after(load, value, before_right), word)),
        ≈ after_right := SameDefinedState::of_equal(sym(right.execution)),
    }
}

theorem word_load_result<M>(load: WordLoad, word: BitVec(64), before: MachineState<M>):
    read_gpr(load.destination, word_load_after(load, word, before).gprs) = word {
    read_gpr_after_write(load.destination, word, before.gprs)
}
// Normal-path MOV r32, dword [base] (Intel SDM Vol. 2B, MOV: 8B /r without
// REX.W), over the word load's ModRM/SIB/displacement subset. Its four
// bytes are read low first, and the 32-bit destination's upper half is
// cleared (Vol. 1 §3.4.1.1: a 32-bit operand's result is zero-extended into
// the 64-bit register). A REX without W is always written, as the byte
// store's is, so the length depends only on the base.
record DwordLoad { destination: Gpr, base: Gpr }

fn dword_load_bytes(load: DwordLoad) → List<BitVec(8)> {
    List::append<BitVec(8)>([rex_plain_rr(load.base, load.destination), BitVec::ofNat(0x8b),
        byte_from_fields(gpr_bit0(load.base), gpr_bit1(load.base), gpr_bit2(load.base),
            gpr_bit0(load.destination), gpr_bit1(load.destination), gpr_bit2(load.destination),
            byte_load_displaced(load.base), False)],
        List::append<BitVec(8)>(
            match byte_load_sib(load.base) { True => [BitVec::ofNat(0x24)], False => [] },
            match byte_load_displaced(load.base) { True => [BitVec::ofNat(0)], False => [] }))
}
fn dword_of_reads(o0, o1, o2, o3: Option<BitVec(8)>) → Option<BitVec(32)> {
    match o0 { None => None, Some(b0) => match o1 { None => None, Some(b1) => match o2 { None => None, Some(b2) =>
    match o3 { None => None, Some(b3) => Some(imm32_from_bytes(b0, b1, b2, b3)) } } } }
}
fn read_dword<M>(access: ByteReadAccess<M>, memory: M, address: BitVec(64)) → Option<BitVec(32)> {
    dword_of_reads(access.read(memory, address), access.read(memory, next_rip(address, 1)),
        access.read(memory, next_rip(address, 2)), access.read(memory, next_rip(address, 3)))
}
// Four bytes present read as their doubleword.
theorem dword_of_four(o0, o1, o2, o3: Option<BitVec(8)>, b0, b1, b2, b3: BitVec(8),
    e0: o0 = Some(b0), e1: o1 = Some(b1), e2: o2 = Some(b2), e3: o3 = Some(b3)):
    dword_of_reads(o0, o1, o2, o3) = Some(imm32_from_bytes(b0, b1, b2, b3)) {
    let goal = Some(imm32_from_bytes(b0, b1, b2, b3));
    j(sym(e0), λ x _ => dword_of_reads(x, o1, o2, o3) = goal,
    j(sym(e1), λ x _ => dword_of_reads(Some(b0), x, o2, o3) = goal,
    j(sym(e2), λ x _ => dword_of_reads(Some(b0), Some(b1), x, o3) = goal,
    j(sym(e3), λ x _ => dword_of_reads(Some(b0), Some(b1), Some(b2), x) = goal, refl))))
}
fn dword_load_after<M>(load: DwordLoad, dword: BitVec(32), before: MachineState<M>) → MachineState<M> {
    MachineState(gprs := write_gpr(load.destination, dword.zero_extend(32), before.gprs),
        flags := before.flags, rip := next_rip(before.rip, dword_load_bytes(load).len()), memory := before.memory)
}
// All four bytes lie below the canonical boundary, so none wraps.
record DwordLoadStep<M>(access: ByteReadAccess<M>, load: DwordLoad, dword: BitVec(32),
    before, after: MachineState<M>) {
    canonical: read_gpr(load.base, before.gprs).toNat() + 4 <= Nat::pow(2, 47),
    present: read_dword(access, before.memory, read_gpr(load.base, before.gprs)) = Some(dword),
    execution: after = dword_load_after(load, dword, before),
}

theorem dword_load_same<M>(access: ByteReadAccess<M>, load: DwordLoad,
    before, first, second: MachineState<M>, left, right: BitVec(32),
    left_step: DwordLoadStep<M>(access, load, left, before, first),
    right_step: DwordLoadStep<M>(access, load, right, before, second)):
    first = second {
    let dword = Option::some_inj(left, right, trans(sym(left_step.present), right_step.present));
    trans(left_step.execution,
        trans(cong_fn(λ value => dword_load_after(load, value, before), dword), sym(right_step.execution)))
}

evidence theorem dword_load_after_respects_defined<M>({load: DwordLoad}, {dword: BitVec(32)}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, dword_load_after<M>(load, dword)) {
    same_defined_respects(dword_load_after<M>(load, dword), λ state => refl)
}

theorem dword_load_respects_defined<M>(access: ByteReadAccess<M>, load: DwordLoad,
    before_left, before_right, after_left, after_right: MachineState<M>,
    left_dword, right_dword: BitVec(32), before_same: SameDefinedState<M>(before_left, before_right),
    left: DwordLoadStep<M>(access, load, left_dword, before_left, after_left),
    right: DwordLoadStep<M>(access, load, right_dword, before_right, after_right)):
    SameDefinedState<M>(after_left, after_right) {
    let address = cong_fn(λ (gprs: Gprs) => read_gpr(load.base, gprs), SameDefinedState::gprs(before_same));
    let read_same = trans(
        cong_fn(λ (memory: M) => read_dword(access, memory, read_gpr(load.base, before_left.gprs)), SameDefinedState::memory(before_same)),
        cong_fn(λ (at: BitVec(64)) => read_dword(access, before_right.memory, at), address));
    let dword = Option::some_inj(left_dword, right_dword, trans(sym(left.present), trans(read_same, right.present)));
    calc {
        after_left ≈ dword_load_after(load, left_dword, before_left) := SameDefinedState::of_equal(left.execution),
        ≈ dword_load_after(load, left_dword, before_right) := rel_cong(before_same),
        ≈ dword_load_after(load, right_dword, before_right) :=
            SameDefinedState::of_equal(cong_fn(λ value => dword_load_after(load, value, before_right), dword)),
        ≈ after_right := SameDefinedState::of_equal(sym(right.execution)),
    }
}

theorem dword_load_result<M>(load: DwordLoad, dword: BitVec(32), before: MachineState<M>):
    read_gpr(load.destination, dword_load_after(load, dword, before).gprs) = dword.zero_extend(32) {
    read_gpr_after_write(load.destination, dword.zero_extend(32), before.gprs)
}
// Normal-path MOV r64, qword [base + index*8] (REX.W 8B /r, ModRM mod 00
// r/m 100, SIB scale 11): the word at entry `index` of a table of words at
// `base`, as a constant table is read (issues/rt-fixed-arrays-and-tables.md).
// Its registers are the ones this encoding can name: under mod 00 a SIB base
// of 101 is a 32-bit absolute address rather than RBP or R13, and an index
// of 100 without REX.X is no index rather than RSP, so neither is a
// register of the form.
inductive SibBase { BRax, BRcx, BRdx, BRbx, BRsp, BRsi, BRdi, BR8, BR9, BR10, BR11, BR12, BR14, BR15 }
inductive SibIndex { XRax, XRcx, XRdx, XRbx, XRbp, XRsi, XRdi, XR8, XR9, XR10, XR11, XR12, XR13, XR14, XR15 }

fn SibBase::gpr(self base: SibBase) → Gpr {
    match base {
        BRax => Rax, BRcx => Rcx, BRdx => Rdx, BRbx => Rbx, BRsp => Rsp, BRsi => Rsi, BRdi => Rdi,
        BR8 => R8, BR9 => R9, BR10 => R10, BR11 => R11, BR12 => R12, BR14 => R14, BR15 => R15,
    }
}
fn SibIndex::gpr(self index: SibIndex) → Gpr {
    match index {
        XRax => Rax, XRcx => Rcx, XRdx => Rdx, XRbx => Rbx, XRbp => Rbp, XRsi => Rsi, XRdi => Rdi,
        XR8 => R8, XR9 => R9, XR10 => R10, XR11 => R11, XR12 => R12, XR13 => R13, XR14 => R14, XR15 => R15,
    }
}
// A register as a SIB base or index, where the form can name it.
fn Gpr::sib_base(self register: Gpr) → Option<SibBase> {
    match register {
        Rax => Some(BRax), Rcx => Some(BRcx), Rdx => Some(BRdx), Rbx => Some(BRbx), Rsp => Some(BRsp), Rbp => None,
        Rsi => Some(BRsi), Rdi => Some(BRdi), R8 => Some(BR8), R9 => Some(BR9), R10 => Some(BR10), R11 => Some(BR11),
        R12 => Some(BR12), R13 => None, R14 => Some(BR14), R15 => Some(BR15),
    }
}
fn Gpr::sib_index(self register: Gpr) → Option<SibIndex> {
    match register {
        Rax => Some(XRax), Rcx => Some(XRcx), Rdx => Some(XRdx), Rbx => Some(XRbx), Rsp => None, Rbp => Some(XRbp),
        Rsi => Some(XRsi), Rdi => Some(XRdi), R8 => Some(XR8), R9 => Some(XR9), R10 => Some(XR10), R11 => Some(XR11),
        R12 => Some(XR12), R13 => Some(XR13), R14 => Some(XR14), R15 => Some(XR15),
    }
}
theorem SibBase::back(self base: SibBase): base.gpr().sib_base() = Some(base) {
    match base {
        BRax => refl, BRcx => refl, BRdx => refl, BRbx => refl, BRsp => refl, BRsi => refl, BRdi => refl,
        BR8 => refl, BR9 => refl, BR10 => refl, BR11 => refl, BR12 => refl, BR14 => refl, BR15 => refl,
    }
}
theorem SibIndex::back(self index: SibIndex): index.gpr().sib_index() = Some(index) {
    match index {
        XRax => refl, XRcx => refl, XRdx => refl, XRbx => refl, XRbp => refl, XRsi => refl, XRdi => refl,
        XR8 => refl, XR9 => refl, XR10 => refl, XR11 => refl, XR12 => refl, XR13 => refl, XR14 => refl, XR15 => refl,
    }
}

record IndexedWordLoad { destination: Gpr, base: SibBase, index: SibIndex }

fn indexed_word_load_bytes(load: IndexedWordLoad) → List<BitVec(8)> {
    let base = load.base.gpr();
    let index = load.index.gpr();
    [byte_from_fields(gpr_extended(base), gpr_extended(index), gpr_extended(load.destination), True,
            False, False, True, False),
        BitVec::ofNat(0x8b),
        byte_from_fields(False, False, True,
            gpr_bit0(load.destination), gpr_bit1(load.destination), gpr_bit2(load.destination), False, False),
        byte_from_fields(gpr_bit0(base), gpr_bit1(base), gpr_bit2(base),
            gpr_bit0(index), gpr_bit1(index), gpr_bit2(index), True, True)]
}
theorem indexed_word_load_length(load: IndexedWordLoad): indexed_word_load_bytes(load).len() = 4 { refl }

// The address read: `base` plus eight times `index`, wrapping as the
// machine's address arithmetic does.
fn indexed_address(load: IndexedWordLoad, gprs: Gprs) → BitVec(64) {
    read_gpr(load.base.gpr(), gprs).add(read_gpr(load.index.gpr(), gprs).shift_left(3))
}

fn indexed_word_load_after<M>(load: IndexedWordLoad, word: BitVec(64), before: MachineState<M>) → MachineState<M> {
    MachineState(gprs := write_gpr(load.destination, word, before.gprs),
        flags := before.flags, rip := next_rip(before.rip, 4), memory := before.memory)
}

// As `WordLoadStep`, at the indexed address.
record IndexedWordLoadStep<M>(access: ByteReadAccess<M>, load: IndexedWordLoad, word: BitVec(64),
    before, after: MachineState<M>) {
    canonical: indexed_address(load, before.gprs).toNat() + 8 <= Nat::pow(2, 47),
    present: read_word(access, before.memory, indexed_address(load, before.gprs)) = Some(word),
    execution: after = indexed_word_load_after(load, word, before),
}

theorem indexed_word_load_same<M>(access: ByteReadAccess<M>, load: IndexedWordLoad,
    before, first, second: MachineState<M>, left, right: BitVec(64),
    left_step: IndexedWordLoadStep<M>(access, load, left, before, first),
    right_step: IndexedWordLoadStep<M>(access, load, right, before, second)):
    first = second {
    let word = Option::some_inj(left, right, trans(sym(left_step.present), right_step.present));
    trans(left_step.execution,
        trans(cong_fn(λ value => indexed_word_load_after(load, value, before), word), sym(right_step.execution)))
}

evidence theorem indexed_word_load_after_respects_defined<M>({load: IndexedWordLoad}, {word: BitVec(64)}):
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, indexed_word_load_after<M>(load, word)) {
    same_defined_respects(indexed_word_load_after<M>(load, word), λ state => refl)
}

theorem indexed_word_load_respects_defined<M>(access: ByteReadAccess<M>, load: IndexedWordLoad,
    before_left, before_right, after_left, after_right: MachineState<M>,
    left_word, right_word: BitVec(64), before_same: SameDefinedState<M>(before_left, before_right),
    left: IndexedWordLoadStep<M>(access, load, left_word, before_left, after_left),
    right: IndexedWordLoadStep<M>(access, load, right_word, before_right, after_right)):
    SameDefinedState<M>(after_left, after_right) {
    let address = cong_fn(λ (gprs: Gprs) => indexed_address(load, gprs), SameDefinedState::gprs(before_same));
    let read_same = trans(
        cong_fn(λ (memory: M) => read_word(access, memory, indexed_address(load, before_left.gprs)), SameDefinedState::memory(before_same)),
        cong_fn(λ (at: BitVec(64)) => read_word(access, before_right.memory, at), address));
    let word = Option::some_inj(left_word, right_word, trans(sym(left.present), trans(read_same, right.present)));
    calc {
        after_left ≈ indexed_word_load_after(load, left_word, before_left) := SameDefinedState::of_equal(left.execution),
        ≈ indexed_word_load_after(load, left_word, before_right) := rel_cong(before_same),
        ≈ indexed_word_load_after(load, right_word, before_right) :=
            SameDefinedState::of_equal(cong_fn(λ value => indexed_word_load_after(load, value, before_right), word)),
        ≈ after_right := SameDefinedState::of_equal(sym(right.execution)),
    }
}

theorem indexed_word_load_result<M>(load: IndexedWordLoad, word: BitVec(64), before: MachineState<M>):
    read_gpr(load.destination, indexed_word_load_after(load, word, before).gprs) = word {
    read_gpr_after_write(load.destination, word, before.gprs)
}

theorem word_load_preserves<M>(load: WordLoad, word: BitVec(64), before: MachineState<M>, register: Gpr,
    distinct: load.destination.same(register) = False):
    read_gpr(register, word_load_after(load, word, before).gprs) = read_gpr(register, before.gprs) {
    trans(read_gpr_write(load.destination, register, word, before.gprs),
        cong_fn<Bool, BitVec(64)>(λ same => match same {
            False => read_gpr(register, before.gprs), True => word,
        }, distinct))
}

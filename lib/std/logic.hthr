// Propositional connectives. Propositions are ordinary, proof-relevant types;
// there is no
// `Prop` sort and this module does not want one: relevance is the default
// ontology, `SProp` stays opt-in for evidence that should be invisible
// (issues/sprop-strict-prop.md), and erasure is the compiler's business
// (datarepr / `Compile`) rather than the type system's. A connective here is
// therefore just a record or an inductive, and nothing in it is special.
//
// `True` is the always-in-scope surface name for the kernel's `Unit^0`, with
// `trivial` as its inhabitant. Declaring an `inductive True` here
// would throw away the whole point — the kernel's η rule makes every
// inhabitant of `Unit` convertible, i.e. `True` is *judgmentally* proof
// irrelevant, which a one-constructor inductive is not.

// ---------------------------------------------------------------------------
// Falsity. Zero constructors, so a `match` on it has zero arms and proves
// anything — which is the elimination rule, spelled with no special form.
//
// The name coexists with the `bool::False` constructor: a type position never
// considers a constructor a candidate,
// and an expected type that is an inductive never considers a type name one.
// Both are shrinks rather than choices — neither dropped reading could have
// checked where it was dropped — so `and(False, True)` and `h: False` mean
// different declarations in one line and neither shadows the other.

inductive False {}

// The goal is a type parameter rather than a value parameter of type `Type`.
// An absurd arm's goal is whatever the match's motive says
// at that constructor — `or_pick(Inr(bad), x, y) = y`, say — and a value
// parameter makes the writer spell it, which is both long and, where the
// spelling needs a type argument nothing determines, sometimes impossible.
// A type parameter is filled from the checking position the arm already is in,
// so `elim(bad(p))` writes.
theorem false_elim<P>(h: False): P { match h {} }

// ---------------------------------------------------------------------------
// Negation. A `fn` into `Type`, not a declaration: `¬P` is `P → False` and
// wants to stay definitionally so, so that a proof of `¬P` is *applied* like
// the function it is rather than unwrapped first.

fn Not(P: Type) → Type { P → False }

theorem not_intro(P: Type, k: P → False): ¬P { k }

// From `P` and `¬P`, anything. The workhorse: this is what a refuted branch
// calls, and it is why the absurd cases of a recursive predicate need no
// special form.
theorem absurd_of<P, Q>(p: P, np: ¬P): Q { false_elim(np(p)) }

theorem not_not_intro(P: Type, p: P): ¬¬P { λ (k: ¬P) => k(p) }

// Modus tollens. Stated with the implication first, matching the order it is
// usually applied in.
theorem mt(P: Type, Q: Type, f: P → Q, nq: ¬Q): ¬P {
    λ (p: P) => nq(f(p))
}

// ---------------------------------------------------------------------------
// Conjunction, as the record it is: a non-dependent Σ. `And(p, q)` builds one
// and `h.left` / `h.right` project, so the elimination rule is field access
// and needs no lemma.
//
// Type parameters rather than value parameters of type `Type`: parameters are
// monomorphized per instantiation (docs/inductive-tier0-lowering.md §2), which
// is exactly right for a connective — `And<P, Q>` at each pair of propositions
// is its own record, and none of them is level-inflated by carrying a `Type`.

record And<P, Q> { left: P, right: Q }

// The two fields are *transposed*, and at `P = Q` no type would catch a
// mistake — so the argument names say which is which
// (docs/named-arguments-design.md).
theorem and_swap<P, Q>(h: P ∧ Q): Q ∧ P { And(left := h.right, right := h.left) }

theorem and_curry<P, Q, R>(f: P ∧ Q → R): P → Q → R {
    λ (p: P) (q: Q) => f(And(p, q))
}

theorem and_uncurry<P, Q, R>(f: P → Q → R): P ∧ Q → R {
    λ (h: P ∧ Q) => f(h.left, h.right)
}

// ---------------------------------------------------------------------------
// Disjunction. Two constructors, so its elimination is an ordinary `match` and
// this module owes it no eliminator either.
//
// `Inl`/`Inr` are capitalized because every constructor in this library is
// (`Nil`, `Cons`, `Some`, `Zero`), and a connective is not the place to start
// a second convention.

inductive Or<P, Q> { Inl(p: P), Inr(q: Q) }

theorem or_swap<P, Q>(h: P ∨ Q): Q ∨ P {
    match h { Inl(p) => Inr(p), Inr(q) => Inl(q) }
}

theorem or_elim<P, Q, R>(h: P ∨ Q, f: P → R, g: Q → R): R {
    match h { Inl(p) => f(p), Inr(q) => g(q) }
}

// A disjunction whose right side is refuted collapses to its left side. The
// shape a decided predicate is consumed in.
theorem or_resolve<P, Q>(h: P ∨ Q, nq: ¬Q): P {
    match h { Inl(p) => p, Inr(q) => absurd_of(q, nq) }
}

// Branching on a disjunction to pick a *value* — the `Or` counterpart of
// `list_algos`'s old `ins_pick` and the successor to `algebra`'s `cmp_pick`, which
// picked on a `Bool`. It is a `fn` and NOT a `theorem` for a reason that is
// easy to lose: a `theorem` is opaque, so `or_elim` above — which computes the
// same thing — never unfolds in conversion, and `max_of(2, 5) = 5` would stop
// being `refl`. Deciding is computation, so its eliminator has to be a `fn`.
//
// The right side is the FIRST result and the left the second, matching
// `cmp_pick`'s `False => x, True => y` so that `Inl` (the relation holds)
// keeps `y` exactly as `True` did.
fn or_pick<P, Q, A>(d: P ∨ Q, x, y: A) → A {
    match d { Inl(p) => y, Inr(q) => x }
}

// A decided disjunction whose left side is proved picks the left value — the
// lemma every `max_of`-shaped consumer needs, and the reason the decider is
// allowed to be a stuck term at open arguments. There is no equation to
// rewrite by and none is wanted: the match's own motive reaches the scrutinee,
// and the refuting branch is closed by the proof the caller already holds.
theorem or_pick_dec<P, A>(d: P ∨ ¬P, x, y: A, p: P): or_pick(d, x, y) = y {
    match d as λ z => or_pick(z, x, y) = y {
        Inl(good) => refl,
        Inr(bad) => false_elim(bad(p)),
    }
}

// ---------------------------------------------------------------------------
// Bi-implication, as a record with NAMED directions rather than as
// `And<P → Q, Q → P>`. Two reasons, both about use: `h.mp(p)` and
// `h.mpr(q)` say which way they go where `h.left`/`h.right` do not, and an
// `Iff` is applied far more often than it is taken apart generically.

record Iff<P, Q> { mp: P → Q, mpr: Q → P }

// Every `Iff` below names its two directions. `iff_refl`'s two fields have the
// *same* type, so a swap there would typecheck; `iff_sym`'s are transposed on
// purpose; and `iff_trans`'s are two lambdas long enough that "which one is
// `mp`" stops being obvious from position alone.
theorem iff_refl<P>(): P ↔ P { Iff(mp := λ (p: P) => p, mpr := λ (p: P) => p) }

theorem iff_sym<P, Q>(h: P ↔ Q): Q ↔ P { Iff(mp := h.mpr, mpr := h.mp) }

theorem iff_trans<P, Q, R>(h1: P ↔ Q, h2: Q ↔ R): P ↔ R {
    Iff(mp := λ (p: P) => h2.mp(h1.mp(p)), mpr := λ (r: R) => h1.mpr(h2.mpr(r)))
}

// ---------------------------------------------------------------------------
// The existential: a record whose second field's type depends on its first,
// with the predicate arriving as a value parameter
// (docs/surface-value-parameters.md, issues/surface-existential.md — the same
// shape `lib/ir_v1.hthr`'s `Converges` is written in, generalized).
//
// The type argument infers from the predicate's binder, so
// `Exists(λ (k: Nat) => …)` writes; `Exists<Nat>(…)` remains available when
// explicitness helps. Introduction takes the argument from its expected type.

record Exists<A>(P: A → Type) { witness: A, proof: P(witness) }

// ---------------------------------------------------------------------------
// Decidability (issues/decide-class.md). One field, because `Decide<P>` already
// IS the Bool with its evidence attached — there is no sort boundary to cross
// and no second object, since Heather keeps proof relevance and a `match` on
// `dec` eliminates straight into `Type`.
//
// The content of the class is *"this disjunction reduces"*. A classical
// `lem : (P: Type) → P ∨ ¬P` would make every consumer below typecheck and
// then compute nothing, because `lem(…)` is a neutral constant with no
// reduction rule. That difference is the whole reason the class exists.

class Decide<P> { dec: P ∨ ¬P }

// The two constants. `True` is the kernel's `Unit^0`, so `Inl(trivial)` is the
// only inhabitant there is; `False`'s refutation is the identity, exactly as
// `not_succ_le_zero` is over in `nat`.
instance Decide<True> { dec := Inl(trivial) }
instance Decide<False> { dec := Inr(λ (h: False) => h) }

// The composition instances — what earns this a class rather than a naming
// convention. Resolution assembles them: a goal at `¬(P ∧ Q)` backchains
// through `Not`, then `And`, then whatever decides `P` and `Q`, and no writer
// names an intermediate.
//
// `¬P` can key an instance because canonical names may be attached to a type
// former as well as to a declared type. `Not` remains a function into `Type`,
// keeping negation definitionally equal to `P → False`.

instance<P: Decide, Q: Decide> Decide<P ∧ Q> {
    dec := match P.dec {
        Inl(p) => match Q.dec {
            Inl(q) => Inl(And(p, q)),
            Inr(nq) => Inr(λ (h: P ∧ Q) => nq(h.right)),
        },
        Inr(np) => Inr(λ (h: P ∧ Q) => np(h.left)),
    },
}

instance<P: Decide, Q: Decide> Decide<P ∨ Q> {
    dec := match P.dec {
        Inl(p) => Inl(Inl(p)),
        Inr(np) => match Q.dec {
            Inl(q) => Inl(Inr(q)),
            Inr(nq) => Inr(λ (h: P ∨ Q) =>
                match h { Inl(p) => np(p), Inr(q) => nq(q) }),
        },
    },
}

instance<P: Decide> Decide<¬P> {
    dec := match P.dec {
        Inl(p) => Inr(λ (np: ¬P) => np(p)),
        Inr(np) => Inl(np),
    },
}

// The consumers. `decide` is the projection a caller reaches for when it wants
// the disjunction and will `match` on it itself; `decide_pick` is the same
// branch made a value, and is `or_pick` with the dictionary found rather than
// passed.
//
// A `fn` and not a `theorem`, both of them, for the reason `or_pick` carries:
// a `theorem` is opaque, so a decision spelled as one never unfolds in
// conversion and nothing downstream of it is `refl` any more.
fn decide<P: Decide>() → P ∨ ¬P { P.dec }

fn decide_pick<P: Decide, A>(x, y: A) → A { or_pick(P.dec, x, y) }

// The `or_pick_dec` lemma with the dictionary resolved — a proof of `P` makes
// the decided branch compute, whichever way the decider happened to go.
theorem decide_pick_yes<P: Decide, A>(x, y: A, p: P): decide_pick<P, A>(x, y) = y {
    or_pick_dec(P.dec, x, y, p)
}

// Coinductive trees against the fuelled programs of the finite library
// (docs/itrees/coitree-design.md §8; issues/coitree-program-bridge.md, milestone
// `it-coinductive`).
//
// A coinductive tree is a program through its approximations
// (`CoTree::program`), and the finite library builds programs out of fuel
// (`Program::iter`, `Program::bind`). Here the two meet: they produce the
// same traces, so each refines the other.
//
// - A finite tree embeds as a coinductive one (`CoTree::of_tree`), a `Cut`
//   becoming `spin`: neither answers anything, so the embedding has exactly
//   the tree's traces.
// - A fuel-free loop over a finite body is the fuelled loop over that body.
//   Fuel counts passes, depth counts constructors, and every pass costs at
//   least one constructor (the `Tau` before the next one), so depth `n`
//   needs no more than `n` passes; the other way, a trace is reached at a
//   depth read off the trace's own derivation.
// - `bind` of trees is `Program::bind` of their programs, for any trees:
//   depth `n` of the bind is within `n` of each side, and `n` of each side
//   is within `n + n` of the bind.
//
// Fuel stays out of every statement here, as in the rest of the library:
// each result is a `Program::Refines`.

import logic;
import nat;
import itree;
import itree_trace;
import coitree;
import coitree_eutt;

// ---------------------------------------------------------------------------
// Finite trees as coinductive ones

// The tree, constructor for constructor; a `Cut` is `spin`.
fn CoTree::of_tree<R>(E: Events, t: ITree<R>(E)) → CoTree<R>(E) {
    match t {
        Ret(r) => CRet(r),
        Tau(s) => CTau(CoTree::of_tree(E, s)),
        Vis(c, k) => CVis(c, λ a => CoTree::of_tree(E, k(a))),
        Cut => CoTree::spin(E),
    }
}

// A finite tree as a program: itself at every fuel.
fn Program::tree<R>(E: Events, t: ITree<R>(E)) → Program<R>(E) {
    Program(λ n => t, λ n => ITree::below_refl(E, t))
}

// `spin`'s approximations have no trace a `Cut` lacks.
theorem CoTree::spin_cut<R>(E: Events, n: Nat, tr: Trace<R>(E)):
    IsTrace(E, CoTree::approx(E, n, CoTree::spin<R>(E)), tr) → IsTrace<R>(E, Cut, tr)
{
    match n {
        Zero => λ it => it,
        Succ(m) => λ it => CoTree::spin_cut(E, m, tr, it),
    }
}

// Every trace of an approximation of the embedding is one of the tree.
theorem CoTree::of_tree_traces<R>(E: Events, n: Nat, t: ITree<R>(E), tr: Trace<R>(E)):
    IsTrace(E, CoTree::approx(E, n, CoTree::of_tree(E, t)), tr) → IsTrace(E, t, tr)
{
    match n {
        Zero => λ (it: CutTrace<R>(E, tr)) =>
            j(@sym<Trace<R>(E)>(tr, TEnd, CutTrace::ended(E, tr, it)), λ y q => IsTrace(E, t, y), IsTrace::nil(E, t)),
        Succ(m) => match t {
            Ret(_) => λ it => it,
            Tau(s) => λ it => CoTree::of_tree_traces(E, m, s, tr, it),
            Vis(c, k) => λ it => VisTrace::map(E, c, tr,
                λ a rest => IsTrace(E, CoTree::approx(E, m, CoTree::of_tree(E, k(a))), rest),
                λ a rest => IsTrace(E, k(a), rest),
                λ a rest sub => CoTree::of_tree_traces(E, m, k(a), rest, sub), it),
            Cut => λ it => CoTree::spin_cut(E, m + 1, tr, it),
        },
    }
}

// …and every trace of the tree is one of some approximation.
theorem CoTree::of_tree_converges<R>(E: Events, t: ITree<R>(E), tr: Trace<R>(E)):
    IsTrace(E, t, tr) → Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, t)), tr)
{
    match t {
        Ret(_) => λ it => Converges(1, it),
        Tau(s) => λ it => {
            let c: Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, s)), tr) = CoTree::of_tree_converges(E, s, tr, it);
            Converges(c.n + 1, c.h)
        },
        Vis(c, k) => λ (it: VisTrace<R>(E, c, tr, λ a rest => IsTrace(E, k(a), rest))) => match it {
            Prefix(at) => CoTree::converges_nil(E, CoTree::of_tree(E, Vis(c, k)), tr, at),
            Pending(at) => j(sym(at), λ y q => Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, Vis(c, k))), y),
                Converges(1, Pending(refl))),
            Answered(a, rest, at, sub) => {
                let c1: Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, k(a))), rest) =
                    CoTree::of_tree_converges(E, k(a), rest, sub);
                j(sym(at), λ y q => Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, Vis(c, k))), y),
                    Converges(c1.n + 1, Answered(a, rest, refl, c1.h)))
            },
        },
        Cut => λ (it: CutTrace<R>(E, tr)) => CoTree::converges_nil(E, CoTree::of_tree<R>(E, Cut), tr, CutTrace::ended(E, tr, it)),
    }
}

// The embedding and the tree are programs that refine each other.
theorem CoTree::of_tree_refines<R>(E: Events, t: ITree<R>(E)):
    Program::Refines(E, CoTree::program(E, CoTree::of_tree(E, t)), Program::tree(E, t))
{
    λ tr (c: Converges<R>(E, λ n => CoTree::approx(E, n, CoTree::of_tree(E, t)), tr)) =>
        Converges(c.n, CoTree::of_tree_traces(E, c.n, t, tr, c.h))
}

theorem CoTree::of_tree_refined<R>(E: Events, t: ITree<R>(E)):
    Program::Refines(E, Program::tree(E, t), CoTree::program(E, CoTree::of_tree(E, t)))
{
    λ tr (c: Converges<R>(E, λ n => t, tr)) => CoTree::of_tree_converges(E, t, tr, c.h)
}

// ---------------------------------------------------------------------------
// Loops: no fuel against fuel
//
// Both loops are read from the middle of a pass: `t` is what is left of the
// body's tree, the fuelled loop continues it with `n` more passes
// (`ITree::iter_rest`), and the fuel-free one goes on for as long as the body
// says (`CoTree::iter_rest`). A whole loop is the pass `body(a)`.

fn ITree::iter_rest<A, B>(E: Events, n: Nat, body: A → ITree<Step<A, B>>(E), t: ITree<Step<A, B>>(E)) → ITree<B>(E) {
    ITree::bind<Step<A, B>, B>(E, t, λ x => ITree::iter_next(E, n, body, x))
}

fn CoTree::iter_rest<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), t: ITree<Step<A, B>>(E)) → CoTree<B>(E) {
    CoTree::iter_obs(E, λ a => CoTree::of_tree(E, body(a)), CoTree::obs(E, CoTree::of_tree(E, t)))
}

// A trace at depth `n` is one at `n` more passes. A pass's silent steps and
// calls spend depth and no fuel, so the fuel left over is grown back with
// `ITree::iter_pass_grows`.
theorem CoTree::iter_traces<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), n: Nat, t: ITree<Step<A, B>>(E),
    tr: Trace<B>(E)):
    IsTrace(E, CoTree::approx(E, n, CoTree::iter_rest(E, body, t)), tr) → IsTrace(E, ITree::iter_rest(E, n, body, t), tr)
{
    match n {
        Zero => λ (it: CutTrace<B>(E, tr)) =>
            j(@sym<Trace<B>(E)>(tr, TEnd, CutTrace::ended(E, tr, it)), λ y q => IsTrace(E, ITree::iter_rest(E, Zero, body, t), y),
                IsTrace::nil(E, ITree::iter_rest(E, Zero, body, t))),
        Succ(m) => {
            let grow: (s: ITree<Step<A, B>>(E)) → (tr1: Trace<B>(E)) → IsTrace(E, ITree::iter_rest(E, m, body, s), tr1) →
                IsTrace(E, ITree::iter_rest(E, m + 1, body, s), tr1) =
                λ s tr1 it1 => IsTrace::of_below(E, ITree::iter_rest(E, m, body, s), ITree::iter_rest(E, m + 1, body, s), tr1,
                    ITree::iter_pass_grows(E, m, body, λ a2 => ITree::iter_grows(E, m, body, a2), s), it1);
            match t {
                Ret(x) => match x {
                    Continue(a2) => λ it => CoTree::iter_traces(E, body, m, body(a2), tr, it),
                    Break(_) => λ it => it,
                },
                Tau(s) => λ it => grow(s, tr, CoTree::iter_traces(E, body, m, s, tr, it)),
                Vis(c, k) => λ it => VisTrace::map(E, c, tr,
                    λ a rest => IsTrace(E, CoTree::approx(E, m, CoTree::iter_rest(E, body, k(a))), rest),
                    λ a rest => IsTrace(E, ITree::iter_rest(E, m + 1, body, k(a)), rest),
                    λ a rest sub => grow(k(a), rest, CoTree::iter_traces(E, body, m, k(a), rest, sub)), it),
                Cut => λ it => CoTree::iter_traces(E, body, m, Cut, tr, it),
            }
        },
    }
}

// What the fuelled loop at `n` passes produces from each state, the
// fuel-free one produces at some depth.
fn CoTree::IterFrom<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), n: Nat) → Type {
    (a: A) → (tr: Trace<B>(E)) → IsTrace(E, ITree::iter(E, n, body, a), tr) →
        Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a)), tr)
}

// One pass the other way, by induction on what is left of it, with the
// passes after it by `next`.
theorem CoTree::iter_pass_converges<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), n: Nat,
    next: CoTree::IterFrom(E, body, n), t: ITree<Step<A, B>>(E), tr: Trace<B>(E)):
    IsTrace(E, ITree::iter_rest(E, n, body, t), tr) →
    Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::iter_rest(E, body, t)), tr)
{
    match t {
        Ret(x) => match x {
            Continue(a2) => λ it => {
                let c: Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::iter(E, λ a3 => CoTree::of_tree(E, body(a3)), a2)), tr) =
                    next(a2, tr, it);
                Converges(c.n + 1, c.h)
            },
            Break(_) => λ it => Converges(1, it),
        },
        Tau(s) => λ it => {
            let c: Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::iter_rest(E, body, s)), tr) =
                CoTree::iter_pass_converges(E, body, n, next, s, tr, it);
            Converges(c.n + 1, c.h)
        },
        Vis(c, k) => λ (it: VisTrace<B>(E, c, tr, λ a rest => IsTrace(E, ITree::iter_rest(E, n, body, k(a)), rest))) => match it {
            Prefix(at) => CoTree::converges_nil(E, CoTree::iter_rest(E, body, Vis(c, k)), tr, at),
            Pending(at) => j(sym(at), λ y q => Converges<B>(E, λ k2 => CoTree::approx(E, k2, CoTree::iter_rest(E, body, Vis(c, k))), y),
                Converges(1, Pending(refl))),
            Answered(a, rest, at, sub) => {
                let c1: Converges<B>(E, λ k2 => CoTree::approx(E, k2, CoTree::iter_rest(E, body, k(a))), rest) =
                    CoTree::iter_pass_converges(E, body, n, next, k(a), rest, sub);
                j(sym(at), λ y q => Converges<B>(E, λ k2 => CoTree::approx(E, k2, CoTree::iter_rest(E, body, Vis(c, k))), y),
                    Converges(c1.n + 1, Answered(a, rest, refl, c1.h)))
            },
        },
        Cut => λ (it: CutTrace<B>(E, tr)) =>
            CoTree::converges_nil(E, CoTree::iter_rest<A, B>(E, body, Cut), tr, CutTrace::ended(E, tr, it)),
    }
}

// Every pass count, by induction on it.
theorem CoTree::iter_converges<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), n: Nat): CoTree::IterFrom(E, body, n) {
    match n {
        Zero => λ a tr (it: CutTrace<B>(E, tr)) =>
            CoTree::converges_nil(E, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a), tr, CutTrace::ended(E, tr, it)),
        Succ(m) => λ a tr it => CoTree::iter_pass_converges(E, body, m, CoTree::iter_converges(E, body, m), body(a), tr, it),
    }
}

// The fuel-free loop over a finite body and the fuelled loop over it are
// programs that refine each other.
theorem CoTree::iter_refines<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), a: A):
    Program::Refines(E, CoTree::program(E, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a)), Program::iter(E, body, a))
{
    Program::refines_of_families(E, CoTree::program(E, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a)),
        Program::iter(E, body, a), λ n tr it => Converges(n + 1, CoTree::iter_traces(E, body, n, body(a), tr, it)))
}

theorem CoTree::iter_refined<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), a: A):
    Program::Refines(E, Program::iter(E, body, a), CoTree::program(E, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a)))
{
    Program::refines_of_families(E, Program::iter(E, body, a),
        CoTree::program(E, CoTree::iter(E, λ a2 => CoTree::of_tree(E, body(a2)), a)),
        λ n tr it => CoTree::iter_converges(E, body, n, a, tr, it))
}

// ---------------------------------------------------------------------------
// Sequencing: the program of a bind is the bind of the programs

// The hypotheses [`CoTree::bind_traces`] and [`CoTree::bind_converges`] carry
// one depth down.
fn CoTree::BindTracesAt<A, B>(E: Events, h: A → CoTree<B>(E), m: Nat) → Type {
    (s: CoTree<A>(E)) → (tr: Trace<B>(E)) → IsTrace(E, CoTree::approx(E, m, CoTree::bind(E, s, h)), tr) →
        IsTrace(E, ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, m, h(r))), tr)
}

fn CoTree::BindConvergesAt<A, B>(E: Events, h: A → CoTree<B>(E), k: Nat, m: Nat) → Type {
    (s: CoTree<A>(E)) → (tr: Trace<B>(E)) → IsTrace(E, ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, k, h(r))), tr) →
        IsTrace(E, CoTree::approx(E, k + m, CoTree::bind(E, s, h)), tr)
}

// One level of [`CoTree::bind_traces`], at what `t` observes. Past a silent
// step or a call the continuation is cut one deeper than the bind's own
// depth allows, and grown back.
theorem CoTree::bind_traces_obs<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E), m: Nat, tr: Trace<B>(E),
    ih: CoTree::BindTracesAt(E, h, m)):
    (o: Obs<A>(E)) → CoTree::obs(E, t) = o → IsTrace(E, CoTree::approx(E, m + 1, CoTree::bind(E, t, h)), tr) →
    IsTrace(E, ITree::bind(E, CoTree::approx(E, m + 1, t), λ r => CoTree::approx(E, m + 1, h(r))), tr)
{
    let hs: (r: A) → ITree::Below(E, CoTree::approx(E, m, h(r)), CoTree::approx(E, m + 1, h(r))) =
        λ r => CoTree::approx_grows(E, h(r), m);
    λ o => match o {
        ORet(r) => λ h0 it => j(sym(h0),
            λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r2 => CoTree::approx(E, m + 1, h(r2))), tr),
            j(CoTree::obs_bind_at(E, t, h, ORet(r), h0), λ y q => IsTrace(E, CoTree::approx_obs(E, m + 1, y), tr), it)),
        OTau(s) => λ h0 it => {
            let it1: IsTrace(E, CoTree::approx(E, m, CoTree::bind(E, s, h)), tr) =
                j(CoTree::obs_bind_at(E, t, h, OTau(s), h0), λ y q => IsTrace(E, CoTree::approx_obs(E, m + 1, y), tr), it);
            let it2: IsTrace(E, ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, m + 1, h(r))), tr) =
                IsTrace::of_below(E, ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, m, h(r))),
                    ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, m + 1, h(r))), tr,
                    ITree::below_bind(E, CoTree::approx(E, m, s), CoTree::approx(E, m, s), λ r => CoTree::approx(E, m, h(r)),
                        λ r => CoTree::approx(E, m + 1, h(r)), ITree::below_refl(E, CoTree::approx(E, m, s)), hs),
                    ih(s, tr, it1));
            j(sym(h0), λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r => CoTree::approx(E, m + 1, h(r))), tr),
                it2)
        },
        OVis(c, k) => λ h0 it => {
            let it1: VisTrace<B>(E, c, tr, λ a rest => IsTrace(E, CoTree::approx(E, m, CoTree::bind(E, k(a), h)), rest)) =
                j(CoTree::obs_bind_at(E, t, h, OVis(c, k), h0), λ y q => IsTrace(E, CoTree::approx_obs(E, m + 1, y), tr), it);
            let it2: VisTrace<B>(E, c, tr,
                λ a rest => IsTrace(E, ITree::bind(E, CoTree::approx(E, m, k(a)), λ r => CoTree::approx(E, m + 1, h(r))), rest)) =
                VisTrace::map(E, c, tr, λ a rest => IsTrace(E, CoTree::approx(E, m, CoTree::bind(E, k(a), h)), rest),
                    λ a rest => IsTrace(E, ITree::bind(E, CoTree::approx(E, m, k(a)), λ r => CoTree::approx(E, m + 1, h(r))), rest),
                    λ a rest sub => IsTrace::of_below(E, ITree::bind(E, CoTree::approx(E, m, k(a)), λ r => CoTree::approx(E, m, h(r))),
                        ITree::bind(E, CoTree::approx(E, m, k(a)), λ r => CoTree::approx(E, m + 1, h(r))), rest,
                        ITree::below_bind(E, CoTree::approx(E, m, k(a)), CoTree::approx(E, m, k(a)), λ r => CoTree::approx(E, m, h(r)),
                            λ r => CoTree::approx(E, m + 1, h(r)), ITree::below_refl(E, CoTree::approx(E, m, k(a))), hs),
                        ih(k(a), rest, sub)),
                    it1);
            j(sym(h0), λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r => CoTree::approx(E, m + 1, h(r))), tr),
                it2)
        },
    }
}

// Every trace of the bind at depth `n` is one of the sides bound at `n`.
theorem CoTree::bind_traces<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E), n: Nat, tr: Trace<B>(E)):
    IsTrace(E, CoTree::approx(E, n, CoTree::bind(E, t, h)), tr) →
    IsTrace(E, ITree::bind(E, CoTree::approx(E, n, t), λ r => CoTree::approx(E, n, h(r))), tr)
{
    match n {
        Zero => λ (it: CutTrace<B>(E, tr)) => it,
        Succ(m) => λ it => CoTree::bind_traces_obs(E, t, h, m, tr, λ s tr1 => CoTree::bind_traces(E, s, h, m, tr1),
            CoTree::obs(E, t), refl, it),
    }
}

// One level of [`CoTree::bind_converges`], at what `t` observes. At a leaf
// the continuation's depth `k` is raised to the bind's.
theorem CoTree::bind_converges_obs<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E), k: Nat, m: Nat, tr: Trace<B>(E),
    ih: CoTree::BindConvergesAt(E, h, k, m)):
    (o: Obs<A>(E)) → CoTree::obs(E, t) = o →
    IsTrace(E, ITree::bind(E, CoTree::approx(E, m + 1, t), λ r => CoTree::approx(E, k, h(r))), tr) →
    IsTrace(E, CoTree::approx(E, k + (m + 1), CoTree::bind(E, t, h)), tr)
{
    λ o => match o {
        ORet(r) => λ h0 it => {
            let it1: IsTrace(E, CoTree::approx(E, k, h(r)), tr) =
                j(h0, λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r2 => CoTree::approx(E, k, h(r2))), tr), it);
            j(sym(CoTree::obs_bind_at(E, t, h, ORet(r), h0)), λ y q => IsTrace(E, CoTree::approx_obs(E, k + (m + 1), y), tr),
                IsTrace::up(E, λ n => CoTree::approx(E, n, h(r)), CoTree::approx_grows(E, h(r)), k, m + 1, tr, it1))
        },
        OTau(s) => λ h0 it => {
            let it1: IsTrace(E, ITree::bind(E, CoTree::approx(E, m, s), λ r => CoTree::approx(E, k, h(r))), tr) =
                j(h0, λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r => CoTree::approx(E, k, h(r))), tr), it);
            let it2: IsTrace(E, CoTree::approx(E, k + m, CoTree::bind(E, s, h)), tr) = ih(s, tr, it1);
            j(sym(CoTree::obs_bind_at(E, t, h, OTau(s), h0)), λ y q => IsTrace(E, CoTree::approx_obs(E, k + (m + 1), y), tr), it2)
        },
        OVis(c, k1) => λ h0 it => {
            let it1: VisTrace<B>(E, c, tr,
                λ a rest => IsTrace(E, ITree::bind(E, CoTree::approx(E, m, k1(a)), λ r => CoTree::approx(E, k, h(r))), rest)) =
                j(h0, λ y q => IsTrace(E, ITree::bind(E, CoTree::approx_obs(E, m + 1, y), λ r => CoTree::approx(E, k, h(r))), tr), it);
            let it2: VisTrace<B>(E, c, tr, λ a rest => IsTrace(E, CoTree::approx(E, k + m, CoTree::bind(E, k1(a), h)), rest)) =
                VisTrace::map(E, c, tr,
                    λ a rest => IsTrace(E, ITree::bind(E, CoTree::approx(E, m, k1(a)), λ r => CoTree::approx(E, k, h(r))), rest),
                    λ a rest => IsTrace(E, CoTree::approx(E, k + m, CoTree::bind(E, k1(a), h)), rest),
                    λ a rest sub => ih(k1(a), rest, sub), it1);
            j(sym(CoTree::obs_bind_at(E, t, h, OVis(c, k1), h0)), λ y q => IsTrace(E, CoTree::approx_obs(E, k + (m + 1), y), tr), it2)
        },
    }
}

// Every trace of the sides bound at `n` and `k` is one of the bind at
// `k + n`: depth spent in `t` and depth spent in `h` add up.
theorem CoTree::bind_converges<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E), k: Nat, n: Nat, tr: Trace<B>(E)):
    IsTrace(E, ITree::bind(E, CoTree::approx(E, n, t), λ r => CoTree::approx(E, k, h(r))), tr) →
    IsTrace(E, CoTree::approx(E, k + n, CoTree::bind(E, t, h)), tr)
{
    match n {
        Zero => λ (it: CutTrace<B>(E, tr)) =>
            j(@sym<Trace<B>(E)>(tr, TEnd, CutTrace::ended(E, tr, it)),
                λ y q => IsTrace(E, CoTree::approx(E, k + Zero, CoTree::bind(E, t, h)), y),
                IsTrace::nil(E, CoTree::approx(E, k + Zero, CoTree::bind(E, t, h)))),
        Succ(m) => λ it => CoTree::bind_converges_obs(E, t, h, k, m, tr, λ s tr1 => CoTree::bind_converges(E, s, h, k, m, tr1),
            CoTree::obs(E, t), refl, it),
    }
}

// The tree of a bind and the bind of the trees' programs refine each other.
theorem CoTree::bind_refines<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E)):
    Program::Refines(E, CoTree::program(E, CoTree::bind(E, t, h)),
        Program::bind(E, CoTree::program(E, t), λ r => CoTree::program(E, h(r))))
{
    Program::refines_of_families(E, CoTree::program(E, CoTree::bind(E, t, h)),
        Program::bind(E, CoTree::program(E, t), λ r => CoTree::program(E, h(r))),
        λ n tr it => Converges(n, CoTree::bind_traces(E, t, h, n, tr, it)))
}

theorem CoTree::bind_refined<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E)):
    Program::Refines(E, Program::bind(E, CoTree::program(E, t), λ r => CoTree::program(E, h(r))),
        CoTree::program(E, CoTree::bind(E, t, h)))
{
    Program::refines_of_families(E, Program::bind(E, CoTree::program(E, t), λ r => CoTree::program(E, h(r))),
        CoTree::program(E, CoTree::bind(E, t, h)),
        λ n tr it => Converges(n + n, CoTree::bind_converges(E, t, h, n, n, tr, it)))
}

// ---------------------------------------------------------------------------
// A finite tree inside a coinductive one, trace by trace
//
// `ITree::Into(t, c)`: every trace of the finite tree `t` is one of `c` at
// some depth. A denotation given twice, once at a fuel and once with none,
// is related this way at every fuel, construct by construct: the
// constructors, `bind` (through `IsTrace::split_bind`), and a loop over
// bodies so related (`ITree::into_iter`), with the fuelled loop's fuel and
// its body's free to differ.

fn ITree::Into<R>(E: Events, t: ITree<R>(E), c: CoTree<R>(E)) → Type {
    (tr: Trace<R>(E)) → IsTrace(E, t, tr) → Converges<R>(E, λ k => CoTree::approx(E, k, c), tr)
}

theorem ITree::into_ret<R>(E: Events, r: R): ITree::Into<R>(E, Ret(r), CRet(r)) {
    λ tr it => Converges(1, it)
}

theorem ITree::into_tau<R>(E: Events, t: ITree<R>(E), c: CoTree<R>(E), h: ITree::Into(E, t, c)):
    ITree::Into(E, Tau(t), CTau(c))
{
    λ tr it => {
        let d: Converges<R>(E, λ k => CoTree::approx(E, k, c), tr) = h(tr, it);
        Converges(d.n + 1, d.h)
    }
}

theorem ITree::into_vis<R>(E: Events, c: E.Cmd, k: E.Resp(c) → ITree<R>(E), kc: E.Resp(c) → CoTree<R>(E),
    h: (a: E.Resp(c)) → ITree::Into(E, k(a), kc(a))): ITree::Into(E, Vis(c, k), CVis(c, kc))
{
    λ tr (it: VisTrace<R>(E, c, tr, λ a rest => IsTrace(E, k(a), rest))) => match it {
        Prefix(at) => CoTree::converges_nil(E, CVis(c, kc), tr, at),
        Pending(at) => j(sym(at), λ y q => Converges<R>(E, λ k2 => CoTree::approx(E, k2, CVis(c, kc)), y),
            Converges(1, Pending(refl))),
        Answered(a, rest, at, sub) => {
            let d: Converges<R>(E, λ k2 => CoTree::approx(E, k2, kc(a)), rest) = h(a, rest, sub);
            j(sym(at), λ y q => Converges<R>(E, λ k2 => CoTree::approx(E, k2, CVis(c, kc)), y),
                Converges(d.n + 1, Answered(a, rest, refl, d.h)))
        },
    }
}

theorem ITree::into_cut<R>(E: Events, c: CoTree<R>(E)): ITree::Into(E, Cut, c) {
    λ tr (it: CutTrace<R>(E, tr)) => CoTree::converges_nil(E, c, tr, CutTrace::ended(E, tr, it))
}

// Into a tree equivalent up to taus.
theorem ITree::into_eutt<R>(E: Events, t: ITree<R>(E), c: CoTree<R>(E), u: CoTree<R>(E), h: ITree::Into(E, t, c),
    e: Eutt<R>(E, c, u)): ITree::Into(E, t, u)
{
    λ tr it => Eutt::refines(E, c, u, e, tr, h(tr, it))
}

theorem ITree::into_bisim<R>(E: Events, t: ITree<R>(E), c: CoTree<R>(E), u: CoTree<R>(E), h: ITree::Into(E, t, c),
    b: Bisim<R>(E, c, u)): ITree::Into(E, t, u)
{
    λ tr it => Bisim::refines(E, c, u, b, tr, h(tr, it))
}

// Sequencing: split the trace of the bind, find each part at a depth, and
// bind the approximations at those depths (`CoTree::bind_converges`).
theorem ITree::into_bind<A, B>(E: Events, t: ITree<A>(E), c: CoTree<A>(E), h: A → ITree<B>(E), d: A → CoTree<B>(E),
    ht: ITree::Into(E, t, c), hh: (r: A) → ITree::Into(E, h(r), d(r))):
    ITree::Into(E, ITree::bind(E, t, h), CoTree::bind(E, c, d))
{
    λ tr it => {
        let sp: BindSplit<A, B>(E, t, h, tr) = IsTrace::split_bind(E, t, h, tr, it);
        match sp {
            Inside(first, i, u, at) => {
                let c1: Converges<A>(E, λ k => CoTree::approx(E, k, c), first) = ht(first, i);
                let inner: IsTrace(E, ITree::bind(E, CoTree::approx(E, c1.n, c), λ r => CoTree::approx(E, Zero, d(r))),
                        Trace::seq(E, first, λ _ => TEnd)) =
                    IsTrace::bind_at(E, CoTree::approx(E, c1.n, c), λ r => CoTree::approx(E, Zero, d(r)), first, λ _ => TEnd, c1.h,
                        λ r ret => false_elim(u(Trace::returns_of_with(E, first, r, ret))));
                j(sym(at), λ y q => Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::bind(E, c, d)), y),
                    Converges(Zero + c1.n, CoTree::bind_converges(E, c, d, Zero, c1.n, Trace::seq(E, first, λ _ => TEnd), inner)))
            },
            Past(first, r, i, ret, rest, sub, at) => {
                let c1: Converges<A>(E, λ k => CoTree::approx(E, k, c), first) = ht(first, i);
                let c2: Converges<B>(E, λ k => CoTree::approx(E, k, d(r)), rest) = hh(r, rest, sub);
                let inner: IsTrace(E, ITree::bind(E, CoTree::approx(E, c1.n, c), λ r2 => CoTree::approx(E, c2.n, d(r2))),
                        Trace::seq(E, first, λ _ => rest)) =
                    IsTrace::bind_at(E, CoTree::approx(E, c1.n, c), λ r2 => CoTree::approx(E, c2.n, d(r2)), first, λ _ => rest, c1.h,
                        λ r2 ret2 => j(Trace::returns_with_unique(E, first, r, r2, ret, ret2),
                            λ y q => IsTrace(E, CoTree::approx(E, c2.n, d(y)), rest), c2.h));
                j(sym(at), λ y q => Converges<B>(E, λ k => CoTree::approx(E, k, CoTree::bind(E, c, d)), y),
                    Converges(c2.n + c1.n, CoTree::bind_converges(E, c, d, c2.n, c1.n, Trace::seq(E, first, λ _ => rest), inner)))
            },
        }
    }
}

theorem ITree::into_map<A, B>(E: Events, t: ITree<A>(E), c: CoTree<A>(E), f: A → B, h: ITree::Into(E, t, c)):
    ITree::Into(E, ITree::map(E, t, f), CoTree::map(E, c, f))
{
    ITree::into_bind(E, t, c, λ r => Ret(f(r)), λ r => CRet(f(r)), h, λ r => ITree::into_ret(E, f(r)))
}

// A loop: the fuelled loop at any fuel, over bodies each inside the
// fuel-free loop's body, is inside the fuel-free loop. By induction on the
// fuel, one pass at a time through `CoTree::iter_unfold`.
theorem ITree::into_iter<A, B>(E: Events, body: A → ITree<Step<A, B>>(E), cbody: A → CoTree<Step<A, B>>(E),
    hb: (a: A) → ITree::Into(E, body(a), cbody(a)), n: Nat): (a: A) →
    ITree::Into(E, ITree::iter(E, n, body, a), CoTree::iter(E, cbody, a))
{
    match n {
        Zero => λ a => ITree::into_cut(E, CoTree::iter(E, cbody, a)),
        Succ(m) => λ a => {
            let next: (x: Step<A, B>) → ITree::Into(E, ITree::iter_next(E, m, body, x),
                    CoTree::iter_next(E, cbody, x)) =
                λ x => match x as λ y => ITree::Into(E, ITree::iter_next(E, m, body, y),
                        CoTree::iter_next(E, cbody, y)) {
                    Continue(a2) => ITree::into_tau(E, ITree::iter(E, m, body, a2), CoTree::iter(E, cbody, a2), ITree::into_iter(E, body, cbody, hb, m, a2)),
                    Break(b) => ITree::into_ret(E, b),
                };
            ITree::into_bisim(E, ITree::iter(E, m + 1, body, a),
                CoTree::bind(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x)), CoTree::iter(E, cbody, a),
                ITree::into_bind(E, body(a), cbody(a), λ x => ITree::iter_next(E, m, body, x),
                    λ x => CoTree::iter_next(E, cbody, x), hb(a), next),
                Bisim::sym(E, CoTree::iter(E, cbody, a), CoTree::bind(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x)),
                    CoTree::iter_unfold(E, cbody, a)))
        },
    }
}

// ---------------------------------------------------------------------------
// A coinductive tree inside a family of finite ones, trace by trace
//
// The other way: `CoTree::Onto(c, p)` says every trace of `c` at some depth
// is one of the family `p` at some fuel. A family is a fuelled
// denotation, which grows with its fuel, so the fuels each part of a trace
// needs are raised to their sum (`IsTrace::fuel_monotone`). The loop case
// is `CoTree::iter_refines` for a body that is itself a family in the fuel:
// induction on the depth, one pass at a time.

fn CoTree::Onto<R>(E: Events, c: CoTree<R>(E), p: Nat → ITree<R>(E)) → Type {
    (k: Nat) → (tr: Trace<R>(E)) → IsTrace(E, CoTree::approx(E, k, c), tr) → Converges<R>(E, p, tr)
}

theorem CoTree::onto_ret<R>(E: Events, r: R): CoTree::Onto<R>(E, CRet(r), λ n => Ret(r)) {
    λ k => match k {
        Zero => λ tr (it: CutTrace<R>(E, tr)) => j(sym(CutTrace::ended(E, tr, it)), λ y q => Converges<R>(E, λ n => Ret(r), y),
            Converges(Zero, IsTrace::nil(E, Ret(r)))),
        Succ(_) => λ tr it => Converges(Zero, it),
    }
}

theorem CoTree::onto_vis<R>(E: Events, c: E.Cmd, kc: E.Resp(c) → CoTree<R>(E), p: E.Resp(c) → Nat → ITree<R>(E),
    h: (a: E.Resp(c)) → CoTree::Onto(E, kc(a), p(a))): CoTree::Onto<R>(E, CVis(c, kc), λ n => Vis(c, λ a => p(a, n)))
{
    λ k => match k {
        Zero => λ tr (it: CutTrace<R>(E, tr)) => j(sym(CutTrace::ended(E, tr, it)), λ y q => Converges<R>(E, λ n => Vis(c, λ a => p(a, n)), y),
            Converges(Zero, Prefix(refl))),
        Succ(m) => λ tr (it: VisTrace<R>(E, c, tr, λ a rest => IsTrace(E, CoTree::approx(E, m, kc(a)), rest))) => match it {
            Prefix(at) => j(sym(at), λ y q => Converges<R>(E, λ n => Vis(c, λ a => p(a, n)), y), Converges(Zero, Prefix(refl))),
            Pending(at) => j(sym(at), λ y q => Converges<R>(E, λ n => Vis(c, λ a => p(a, n)), y), Converges(Zero, Pending(refl))),
            Answered(a, rest, at, sub) => {
                let d: Converges<R>(E, p(a), rest) = h(a, m, rest, sub);
                j(sym(at), λ y q => Converges<R>(E, λ n => Vis(c, λ a2 => p(a2, n)), y), Converges(d.n, Answered(a, rest, refl, d.h)))
            },
        },
    }
}

// From a bisimilar tree: the approximations are the same.
theorem CoTree::onto_bisim<R>(E: Events, c: CoTree<R>(E), u: CoTree<R>(E), p: Nat → ITree<R>(E), b: Bisim<R>(E, c, u),
    h: CoTree::Onto(E, u, p)): CoTree::Onto(E, c, p)
{
    λ k tr it => h(k, tr, IsTrace::of_same(E, CoTree::approx(E, k, c), CoTree::approx(E, k, u), tr, Bisim::approx(E, k, c, u, b), it))
}

// Sequencing: split the trace of the bound approximations
// (`CoTree::bind_traces`, `IsTrace::split_bind`), find each part at a fuel,
// and raise both to their sum.
theorem CoTree::onto_bind<A, B>(E: Events, c: CoTree<A>(E), p: Nat → ITree<A>(E), gp: ITree::Grows(E, p),
    d: A → CoTree<B>(E), q: A → Nat → ITree<B>(E), gq: (r: A) → ITree::Grows(E, q(r)),
    hc: CoTree::Onto(E, c, p), hd: (r: A) → CoTree::Onto(E, d(r), q(r))):
    CoTree::Onto<B>(E, CoTree::bind(E, c, d), λ n => ITree::bind(E, p(n), λ r => q(r, n)))
{
    λ k tr it => {
        let sp: BindSplit<A, B>(E, CoTree::approx(E, k, c), λ r => CoTree::approx(E, k, d(r)), tr) =
            IsTrace::split_bind(E, CoTree::approx(E, k, c), λ r => CoTree::approx(E, k, d(r)), tr, CoTree::bind_traces(E, c, d, k, tr, it));
        match sp {
            Inside(first, i, u, at) => {
                let c1: Converges<A>(E, p, first) = hc(k, first, i);
                let inner: IsTrace(E, ITree::bind(E, p(c1.n), λ r => q(r, c1.n)), Trace::seq(E, first, λ _ => TEnd)) =
                    IsTrace::bind_at(E, p(c1.n), λ r => q(r, c1.n), first, λ _ => TEnd, c1.h,
                        λ r ret => false_elim(u(Trace::returns_of_with(E, first, r, ret))));
                j(sym(at), λ y q2 => Converges<B>(E, λ n => ITree::bind(E, p(n), λ r => q(r, n)), y), Converges(c1.n, inner))
            },
            Past(first, r, i, ret, rest, sub, at) => {
                let c1: Converges<A>(E, p, first) = hc(k, first, i);
                let c2: Converges<B>(E, q(r), rest) = hd(r, k, rest, sub);
                let lifted: IsTrace(E, q(r, c1.n + c2.n), rest) =
                    IsTrace::fuel_monotone(E, q(r), gq(r), c2.n, c1.n + c2.n, Nat::le_add_r(c1.n, c2.n), rest, c2.h);
                let inner: IsTrace(E, ITree::bind(E, p(c1.n + c2.n), λ r2 => q(r2, c1.n + c2.n)), Trace::seq(E, first, λ _ => rest)) =
                    IsTrace::bind_at(E, p(c1.n + c2.n), λ r2 => q(r2, c1.n + c2.n), first, λ _ => rest,
                        IsTrace::fuel_monotone(E, p, gp, c1.n, c1.n + c2.n, Nat::le_add_l(c1.n, c2.n), first, c1.h),
                        λ r2 ret2 => j(Trace::returns_with_unique(E, first, r, r2, ret, ret2),
                            λ y q2 => IsTrace(E, q(y, c1.n + c2.n), rest), lifted));
                j(sym(at), λ y q2 => Converges<B>(E, λ n => ITree::bind(E, p(n), λ r2 => q(r2, n)), y), Converges(c1.n + c2.n, inner))
            },
        }
    }
}

theorem CoTree::onto_map<A, B>(E: Events, c: CoTree<A>(E), p: Nat → ITree<A>(E), gp: ITree::Grows(E, p), f: A → B,
    h: CoTree::Onto(E, c, p)): CoTree::Onto<B>(E, CoTree::map(E, c, f), λ n => ITree::map(E, p(n), f))
{
    CoTree::onto_bind(E, c, p, gp, λ r => CRet(f(r)), λ r n => Ret(f(r)), λ r n => refl, h, λ r => CoTree::onto_ret(E, f(r)))
}

// What is left of the fuelled loop after a pass returned `x`, at every fuel
// from some on: the depth's induction carries it.
record IterRestAt<A, B>(E: Events, body: Nat → A → ITree<Step<A, B>>(E), x: Step<A, B>, rest: Trace<B>(E)) {
    n: Nat,
    at: (m: Nat) → n <= m → IsTrace(E, ITree::iter_next(E, m, body(Succ(m)), x), rest),
}

// A loop: the fuel-free loop over bodies each inside a family of fuelled
// bodies is inside the fuelled loop whose body is that family at the same
// fuel. By induction on the depth.
theorem CoTree::onto_iter<A, B>(E: Events, body: Nat → A → ITree<Step<A, B>>(E),
    grows: (n: Nat) → (a: A) → ITree::Below(E, body(n, a), body(n + 1, a)),
    cbody: A → CoTree<Step<A, B>>(E), hb: (a: A) → CoTree::Onto(E, cbody(a), λ n => body(n, a)), k: Nat):
    (a: A) → (tr: Trace<B>(E)) → IsTrace(E, CoTree::approx(E, k, CoTree::iter(E, cbody, a)), tr) →
    Converges<B>(E, λ n => ITree::iter(E, n, body(n), a), tr)
{
    match k {
        Zero => λ a tr (it: CutTrace<B>(E, tr)) => j(sym(CutTrace::ended(E, tr, it)),
            λ y q => Converges<B>(E, λ n => ITree::iter(E, n, body(n), a), y), Converges(Zero, Ended(refl))),
        Succ(m) => λ a tr it => {
            let unfolded: IsTrace(E, CoTree::approx(E, m + 1, CoTree::bind(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x))), tr) =
                IsTrace::of_same(E, CoTree::approx(E, m + 1, CoTree::iter(E, cbody, a)),
                    CoTree::approx(E, m + 1, CoTree::bind(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x))), tr,
                    Bisim::approx(E, m + 1, CoTree::iter(E, cbody, a), CoTree::bind(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x)),
                        CoTree::iter_unfold(E, cbody, a)), it);
            let sp: BindSplit<Step<A, B>, B>(E, CoTree::approx(E, m + 1, cbody(a)), λ x => CoTree::approx(E, m + 1, CoTree::iter_next(E, cbody, x)), tr) =
                IsTrace::split_bind(E, CoTree::approx(E, m + 1, cbody(a)), λ x => CoTree::approx(E, m + 1, CoTree::iter_next(E, cbody, x)), tr,
                    CoTree::bind_traces(E, cbody(a), λ x => CoTree::iter_next(E, cbody, x), m + 1, tr, unfolded));
            let gb: (a2: A) → ITree::Grows(E, λ n => body(n, a2)) = λ a2 n => grows(n, a2);
            let next: (x: Step<A, B>) → (rest: Trace<B>(E)) → IsTrace(E, CoTree::approx(E, m + 1, CoTree::iter_next(E, cbody, x)), rest) →
                    IterRestAt<A, B>(E, body, x, rest) =
                λ x => match x as λ y => (rest: Trace<B>(E)) → IsTrace(E, CoTree::approx(E, m + 1, CoTree::iter_next(E, cbody, y)), rest) →
                        IterRestAt<A, B>(E, body, y, rest) {
                    Continue(a2) => λ rest sub => {
                        let c2: Converges<B>(E, λ n => ITree::iter(E, n, body(n), a2), rest) = CoTree::onto_iter(E, body, grows, cbody, hb, m, a2, rest, sub);
                        IterRestAt(c2.n, λ m2 le => IsTrace::of_below(E, ITree::iter(E, m2, body(m2), a2), ITree::iter(E, m2, body(m2 + 1), a2), rest,
                            ITree::iter_body_below(E, m2, body(m2), body(m2 + 1), λ a3 => grows(m2, a3), a2),
                            IsTrace::fuel_monotone(E, λ n => ITree::iter(E, n, body(n), a2),
                                λ n => ITree::iter_below(E, n, body(n), body(n + 1), λ a3 => grows(n, a3), a2), c2.n, m2, le, rest, c2.h)))
                    },
                    Break(b) => λ rest sub => IterRestAt(Zero, λ m2 le => sub),
                };
            match sp {
                Inside(first, i, u, at) => {
                    let c1: Converges<Step<A, B>>(E, λ n => body(n, a), first) = hb(a, m + 1, first, i);
                    let inner: IsTrace(E, ITree::bind(E, body(c1.n + 1, a), λ x => ITree::iter_next(E, c1.n, body(c1.n + 1), x)),
                            Trace::seq(E, first, λ _ => TEnd)) =
                        IsTrace::bind_at(E, body(c1.n + 1, a), λ x => ITree::iter_next(E, c1.n, body(c1.n + 1), x), first, λ _ => TEnd,
                            IsTrace::of_below(E, body(c1.n, a), body(c1.n + 1, a), first, grows(c1.n, a), c1.h),
                            λ r ret => false_elim(u(Trace::returns_of_with(E, first, r, ret))));
                    j(sym(at), λ y q => Converges<B>(E, λ n => ITree::iter(E, n, body(n), a), y), Converges(c1.n + 1, inner))
                },
                Past(first, x, i, ret, rest, sub, at) => {
                    let c1: Converges<Step<A, B>>(E, λ n => body(n, a), first) = hb(a, m + 1, first, i);
                    let w: IterRestAt<A, B>(E, body, x, rest) = next(x, rest, sub);
                    let inner: IsTrace(E, ITree::bind(E, body(c1.n + w.n + 1, a), λ y => ITree::iter_next(E, c1.n + w.n, body(c1.n + w.n + 1), y)),
                            Trace::seq(E, first, λ _ => rest)) =
                        IsTrace::bind_at(E, body(c1.n + w.n + 1, a), λ y => ITree::iter_next(E, c1.n + w.n, body(c1.n + w.n + 1), y), first, λ _ => rest,
                            IsTrace::fuel_monotone(E, λ n => body(n, a), gb(a), c1.n, c1.n + w.n + 1,
                                Nat::le_succ_r(c1.n, c1.n + w.n, Nat::le_add_l(c1.n, w.n)), first, c1.h),
                            λ r2 ret2 => j(Trace::returns_with_unique(E, first, x, r2, ret, ret2),
                                λ y q => IsTrace(E, ITree::iter_next(E, c1.n + w.n, body(c1.n + w.n + 1), y), rest),
                                w.at(c1.n + w.n, Nat::le_add_r(c1.n, w.n))));
                    j(sym(at), λ y q => Converges<B>(E, λ n => ITree::iter(E, n, body(n), a), y), Converges(c1.n + w.n + 1, inner))
                },
            }
        },
    }
}

// Recursive lists and their core API: elimination, transformation, folds,
// slicing, zipping, membership, and indexing, together with their principal
// laws. `List<A>` lowers through the tier-1 well-founded encoding.

import logic;
import nat;
import option;
import bool;
import pair;

inductive List<A> { Nil, Cons(head: A, tail: List<A>) }

// The dependent companion to `ListAlg` below. An ordinary algebra replaces a
// recursive tail by one result in a fixed carrier `B`; an elimination algebra
// keeps the original tail and pairs it with a result in the motive at that
// tail. Packaging the two constructor-local obligations as a record makes a
// proof by induction an ordinary first-class value.
//
// `P` is a value parameter whose value is the result type family.
record ListElim<A>(P: List<A> -> Type) {
    nil: P(Nil),
    cons: (head: A) -> (tail: List<A>) -> P(tail) -> P(Cons(head, tail)),
}

fn list_elim<A>(P: List<A> -> Type, alg: ListElim<A>(P), xs: List<A>) -> P(xs) {
    match xs {
        Nil => alg.nil,
        Cons(head, tail) => alg.cons(head, tail, list_elim(P, alg, tail)),
    }
}

theorem list_elim_nil<A>(P: List<A> -> Type, alg: ListElim<A>(P)):
    list_elim(P, alg, Nil) = alg.nil
{}

theorem list_elim_cons<A>(P: List<A> -> Type, alg: ListElim<A>(P),
    head: A, tail: List<A>):
    list_elim(P, alg, Cons(head, tail)) =
        alg.cons(head, tail, list_elim(P, alg, tail))
{}

// ---------------------------------------------------------------------------
// append, its laws, and the two congruences the file proves with.
//
// `std/algebra` assembles `Monoid<List<A>>` from `append`, `Nil` and exactly
// these two theorems, in literal form, so a monoid law that lives in a file
// the class cannot import is a law the instance would have to re-prove.
//
// `append` recurses on its first argument, so `append(Nil, ys)` is `ys`
// definitionally and it is the *right* unit that costs an induction.

fn append<A>(xs, ys: List<A>) -> List<A> {
    match xs {
        Nil => ys,
        Cons(h, t) => Cons(h, append(t, ys)),
    }
}

designation<A> ++ at List<A> := append

theorem cong_cons<A>(h: A, {a, b: List<A>}, p: a = b):
    Cons(h, a) = Cons(h, b)
{
    j(p, λ y q => Cons(h, a) = Cons(h, y), refl)
}

theorem cong_append_l<A>({a: List<A>}, {b: List<A>}, zs: List<A>, p: a = b):
    a ++ zs = b ++ zs
{
    j(p, λ y q => a ++ zs = y ++ zs, refl)
}

// `append_nil` is the first existing library theorem expressed by filling a
// dependent elimination algebra. The recursive proof is no longer named or
// called here: `list_elim` supplies it to the Cons obligation as `ih`.
fn append_nil_elim<A>() -> ListElim<A>(λ (xs: List<A>) => xs ++ Nil = xs) {
    ListElim {
        nil: refl,
        cons: λ (h: A) (t: List<A>) ih => cong_cons(h, ih),
    }
}

theorem append_nil<A>(xs: List<A>): xs ++ Nil = xs {
    list_elim(λ (ys: List<A>) => ys ++ Nil = ys, append_nil_elim(), xs)
}

theorem append_assoc<A>(xs, ys, zs: List<A>):
    (xs ++ ys) ++ zs = xs ++ (ys ++ zs)
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_cons(h, append_assoc(t, ys, zs)),
    }
}

// ---------------------------------------------------------------------------
// length.
//
// `len_append` is where the file first has to reach into `std/nat`'s kit
// rather than compute, and it pays at BOTH ends: `append` peels its FIRST
// argument while `add` recurses on its SECOND, so `add(0, n)` is stuck at the
// base (`add_left_zero`) and the two sides are one `Succ` out of phase at the
// step (`add_succ_left`). Stated the other way round — `add(len(ys), len(xs))`
// — both arms are `{}`, and every call site reads backwards. The cost of the
// readable spelling is these two rewrites, and it is worth it.

fn len<A>(xs: List<A>) -> Nat {
    match xs { Nil => 0, Cons(h, t) => Succ(len(t)) }
}

theorem len_append<A>(xs, ys: List<A>):
    len(xs ++ ys) = len(xs) + len(ys)
{
    match xs {
        Nil => sym(add_left_zero(len(ys))),
        Cons(h, t) =>
            trans(cong_succ(len_append(t, ys)),
                  sym(add_succ_left(len(t), len(ys)))),
    }
}

// ---------------------------------------------------------------------------
// map, and the four laws it had none of.
//
// The first higher-order arguments in the library: `map_id` and `map_map`
// state their functions as literal lambdas in the goal, so what is being
// tested is whether an equation between *functions applied pointwise* goes
// through by the same recursion as everything else. It does — every proof here
// is `cong_cons` over the tail, exactly like the append laws.

fn map<A, B>(xs: List<A>, f: A -> B) -> List<B> {
    match xs {
        Nil => Nil,
        Cons(h, t) => Cons(f(h), map(t, f)),
    }
}

theorem map_id<A>(xs: List<A>): map(xs, λ (a: A) => a) = xs {
    match xs {
        Nil => {},
        Cons(h, t) => cong_cons(h, map_id(t)),
    }
}

theorem map_map<A, B, C>(xs: List<A>, f: A -> B, g: B -> C):
    map(map(xs, f), g) = map(xs, λ (a: A) => g(f(a)))
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_cons(g(f(h)), map_map(t, f, g)),
    }
}

theorem map_append<A, B>(xs, ys: List<A>, f: A -> B):
    map(xs ++ ys, f) = map(xs, f) ++ map(ys, f)
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_cons(f(h), map_append(t, ys, f)),
    }
}

theorem len_map<A, B>(xs: List<A>, f: A -> B): len(map(xs, f)) = len(xs) {
    match xs {
        Nil => {},
        Cons(h, t) => cong_succ(len_map(t, f)),
    }
}

// ---------------------------------------------------------------------------
// reverse, and the laws that rest on append's.

fn rev<A>(xs: List<A>) -> List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => append(rev(t), Cons(h, Nil)),
    }
}

theorem rev_append<A>(xs: List<A>, ys: List<A>):
    rev(xs ++ ys) = rev(ys) ++ rev(xs)
{
    match xs {
        Nil => sym(append_nil(rev(ys))),
        Cons(h, t) =>
            trans(
                cong_append_l(Cons(h, Nil), rev_append(t, ys)),
                append_assoc(rev(ys), rev(t), Cons(h, Nil))),
    }
}

theorem rev_involutive<A>(xs: List<A>): rev(rev(xs)) = xs {
    match xs {
        Nil => {},
        Cons(h, t) =>
            trans(rev_append(rev(t), Cons(h, Nil)),
                  cong_cons(h, rev_involutive(t))),
    }
}

// `add(n, 1)` is `Succ(n)` by computation — `add` recurses on its second
// argument — so unlike `len_append` this one needs no `add_succ_left` and the
// singleton's length never has to be named.
theorem rev_len<A>(xs: List<A>): len(rev(xs)) = len(xs) {
    match xs {
        Nil => {},
        Cons(h, t) =>
            trans(len_append(rev(t), Cons(h, Nil)),
                  cong_succ(rev_len(t))),
    }
}

// ---------------------------------------------------------------------------
// the folds.
//
// `foldr` recurses with its function and seed FIXED, so it is uncurried.
// `foldl` cannot be: its accumulator changes at every step, and the guard
// wants the descending argument with the rest unchanged
// (issues/ih-generalization.md), so the seed is returned as a function.
// Over-application means call sites still write `foldl(xs, f, z)`.

fn foldr<A, B>(xs: List<A>, f: A -> B -> B, z: B) -> B {
    match xs {
        Nil => z,
        Cons(h, t) => f(h, foldr(t, f, z)),
    }
}

fn foldl<A, B>(xs: List<A>, f: B -> A -> B) -> B -> B {
    match xs {
        Nil => λ (z: B) => z,
        Cons(h, t) => λ (z: B) => foldl(t, f, f(z, h)),
    }
}

// The congruence the fold law needs, and the first one in the library at an
// OPEN function type: `cong_nat` is `nat`'s and is monomorphic, `cong_cons`
// and `cong_append_l` are each one shape. Here the function is a parameter of
// the theorem it is used in, which is what `j` wants anyway — a general `cong`
// is unusable only when the function has to be *inferred*
// (issues/congruence-by-anti-unification.md).
theorem cong_fn<A, B>(g: A -> B, {a, b: A}, p: a = b): g(a) = g(b) {
    j(p, λ y q => g(a) = g(y), refl)
}

theorem foldr_append<A, B>(xs, ys: List<A>, f: A -> B -> B, z: B):
    foldr(xs ++ ys, f, z) = foldr(xs, f, foldr(ys, f, z))
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_fn(f(h), foldr_append(t, ys, f, z)),
    }
}

// ---------------------------------------------------------------------------
// The fold as a first-class algebra.
//
// `foldr` takes its two clauses as separate arguments. `ListAlg` packages the
// same data into an ordinary value, so an algebra can be passed around,
// compared through its laws, and eventually generated from the datatype
// declaration without giving the kernel a new eliminator. The result carrier
// `B` and the element carrier `A` are both open on purpose: a Nat-only version
// would miss exactly the level and scoping pressure this experiment is for
// (issues/datatype-container-algebras.md).

record ListAlg<A, B> {
    nil: B,
    cons: A -> B -> B,
}

fn list_fold<A, B>(alg: ListAlg<A, B>, xs: List<A>) -> B {
    match xs {
        Nil => alg.nil,
        Cons(h, t) => alg.cons(h, list_fold(alg, t)),
    }
}

// These equations are the public computational face of the fold. They are
// theorems for callers, but their proofs are empty because `list_fold` is only
// the ordinary structural eliminator with its clauses projected from a value.
theorem list_fold_nil<A, B>(alg: ListAlg<A, B>): list_fold(alg, Nil) = alg.nil {}

theorem list_fold_cons<A, B>(alg: ListAlg<A, B>, h: A, t: List<A>):
    list_fold(alg, Cons(h, t)) = alg.cons(h, list_fold(alg, t))
{}

// Pointwise uniqueness is the form available without function
// extensionality: any `g` satisfying the same two equations agrees with the
// fold at every list. The Cons law receives the original tail as well as its
// folded result; that makes this a characterization of this fold, not a
// restriction to functions whose clause forgot the substructure.
theorem list_fold_unique<A, B>(alg: ListAlg<A, B>, g: List<A> -> B,
    nil_law: g(Nil) = alg.nil,
    cons_law: (h: A) -> (t: List<A>) -> g(Cons(h, t)) = alg.cons(h, g(t)),
    xs: List<A>): g(xs) = list_fold(alg, xs)
{
    match xs {
        Nil => nil_law,
        Cons(h, t) =>
            trans(cons_law(h, t), cong_fn(alg.cons(h), list_fold_unique(alg, g, nil_law, cons_law, t))),
    }
}

// An algebra homomorphism commutes with the fold. This is the usable,
// pointwise fusion law; stating equality between the two resulting functions
// would add a funext premise without strengthening what clients can apply.
theorem list_fold_fusion<A, B, C>(src: ListAlg<A, B>, dst: ListAlg<A, C>,
    hom: B -> C,
    nil_comm: hom(src.nil) = dst.nil,
    cons_comm: (a: A) -> (b: B) -> hom(src.cons(a, b)) = dst.cons(a, hom(b)),
    xs: List<A>): hom(list_fold(src, xs)) = list_fold(dst, xs)
{
    match xs {
        Nil => nil_comm,
        Cons(h, t) =>
            trans(cons_comm(h, list_fold(src, t)),
                  cong_fn(dst.cons(h), list_fold_fusion(src, dst, hom, nil_comm, cons_comm, t))),
    }
}

// The old API and the first-class one are not competing folds. Packaging
// `foldr`'s arguments gives the same computation at every list.
theorem list_fold_is_foldr<A, B>(f: A -> B -> B, z: B, xs: List<A>):
    list_fold(ListAlg<A, B> { nil: z, cons: f }, xs) = foldr(xs, f, z)
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_fn(f(h), list_fold_is_foldr(f, z, t)),
    }
}

// `foldl`'s laws (wave L2′, issues/std-list-l2-prime-laws.md). L2 left `foldl`
// with none, and the reason is visible in every statement below: the
// accumulator changes at each step, so a law about `foldl` is never a law about
// one accumulator. Each one is stated as `(z: B) -> …` and each proof applies
// its IH at a DIFFERENT `z` — the higher-order face of
// issues/ih-generalization.md, which the L1/L2 round could only rank from the
// definition's shape because it proved nothing about it.
//
// That the definition is already curried is what makes this free: `foldl`'s own
// spelling forced the workaround, and the workaround is exactly the shape the
// laws want.

theorem foldl_append<A, B>(xs, ys: List<A>, f: B -> A -> B):
    (z: B) -> foldl(xs ++ ys, f, z) = foldl(ys, f, foldl(xs, f, z))
{
    match xs {
        Nil => λ z => {},
        Cons(h, t) => λ z => foldl_append(t, ys, f, f(z, h)),
    }
}

// The two folds meet: `foldl` down a reversed list is `foldr` with its function
// flipped. This is the one law in the file that needs ANOTHER law of the same
// function to prove it — `foldl_append` at the singleton — because `rev` is
// defined by `append` and `foldl` has nothing to say about `append` by
// computation.
theorem foldl_rev<A, B>(xs: List<A>, f: B -> A -> B):
    (z: B) -> foldl(rev(xs), f, z) = foldr(xs, λ (a: A) (b: B) => f(b, a), z)
{
    match xs {
        Nil => λ z => {},
        Cons(h, t) => λ z =>
            trans(foldl_append(rev(t), Cons(h, Nil), f, z),
                  cong_fn(λ (w: B) => f(w, h), foldl_rev(t, f, z))),
    }
}

// `foldl` counts. Stated at a generalized accumulator it is not `len` but
// `add(z, len(xs))`, and then the proof pays `std/nat`'s phase tax once, the
// same way `len_append` does: the IH lands on `add(Succ(z), len(t))` and the
// goal wants `Succ(add(z, len(t)))`.
theorem foldl_len<A>(xs: List<A>):
    (z: Nat) -> foldl(xs, λ (k: Nat) (a: A) => Succ(k), z) = z + len(xs)
{
    match xs {
        Nil => λ z => {},
        Cons(h, t) => λ z =>
            trans(foldl_len(t, Succ(z)), add_succ_left(z, len(t))),
    }
}

// ---------------------------------------------------------------------------
// filter, and the prefix/suffix pair.
//
// `filter`'s predicate is a `Bool` and that is not a lapse from
// issues/class-ops-prop-vs-bool.md: that doctrine bans `Bool` from
// SPECIFICATIONS, and `filter` is a program. A `Decide`-valued predicate is
// the other spelling and would make `filter` proof-relevant in its argument;
// nothing in the library wants that yet, and when something does it is a
// second function, not a replacement.
//
// `take`/`drop` are curried for the reason `nth` is: the index descends
// alongside the list.

fn filter<A>(xs: List<A>, p: A -> Bool) -> List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => match p(h) {
            True => Cons(h, filter(t, p)),
            False => filter(t, p),
        },
    }
}

fn take<A>(xs: List<A>) -> Nat -> List<A> {
    match xs {
        Nil => λ (n: Nat) => Nil,
        Cons(h, t) => λ (n: Nat) => match n {
            Zero => Nil,
            Succ(k) => Cons(h, take(t, k)),
        },
    }
}

fn drop<A>(xs: List<A>) -> Nat -> List<A> {
    match xs {
        Nil => λ (n: Nat) => Nil,
        Cons(h, t) => λ (n: Nat) => match n {
            Zero => Cons(h, t),
            Succ(k) => drop(t, k),
        },
    }
}

theorem take_append_drop<A>(xs: List<A>):
    (n: Nat) -> take(xs, n) ++ drop(xs, n) = xs
{
    match xs {
        Nil => λ n => {},
        Cons(h, t) => λ n => match n {
            Zero => {},
            Succ(k) => cong_cons(h, take_append_drop(t, k)),
        },
    }
}

// Filtering cannot increase length. Both inner branches return `List<A>`, so
// the match needs no written motive.
theorem len_filter<A>(xs: List<A>, p: A -> Bool): len(filter(xs, p)) <= len(xs) {
    match xs {
        Nil => trivial,
        Cons(h, t) => match p(h) {
            True => len_filter(t, p),
            False => le_succ_r(len(filter(t, p)), len(t), len_filter(t, p)),
        },
    }
}

// The three principal filter laws differ by whether the other side of the
// equation branches on the same scrutinee.
//
// For `filter_append` and `filter_map` it does, and then the inner motive is
// enough — each arm's goal reduces on both sides at once. For `filter_filter`
// it does not: the right-hand side is `filter(xs, p)` with nothing to reduce,
// while the left has a SECOND stuck `p(h)` that the motive cannot reach, so the
// arm needs the equation `p(h) = b` and has to rewrite by it. `match e : p(h)`
// binds that equation, so
// the convoy costs one token and not a `-> Goal` in the motive plus a trailing
// `(refl)`; what it does NOT do is use it, and the `j` in the `True` arm is
// three lines of hand-written motive for a rewrite under a `match` context
// (issues/congruence-by-anti-unification.md).

theorem filter_append<A>(xs, ys: List<A>, p: A -> Bool):
    filter(xs ++ ys, p) = filter(xs, p) ++ filter(ys, p)
{
    match xs {
        Nil => {},
        Cons(h, t) => match p(h) {
            True => cong_cons(h, filter_append(t, ys, p)),
            False => filter_append(t, ys, p),
        },
    }
}

// Idempotence, and the one proof in the file that needs the scrutinee's own
// equation. `match e : p(h)` is the convoy, one token; the `j` inside the
// `True` arm is what the convoy is FOR — it moves the goal's second,
// unreachable `p(h)` to `True` so that `filter` steps there too. The two
// features compose with nothing to say to each other: the equation binding
// decorates whatever motive synthesis hands it
// (docs/goal-motive-synthesis-design.md §6).
theorem filter_filter<A>(xs: List<A>, p: A -> Bool):
    filter(filter(xs, p), p) = filter(xs, p)
{
    match xs {
        Nil => {},
        Cons(h, t) => match e : p(h) {
            True =>
                j(sym(e),
                  λ y q =>
                    (match y {
                        True => Cons(h, filter(filter(t, p), p)),
                        False => filter(filter(t, p), p),
                    }) = Cons(h, filter(t, p)),
                  cong_cons(h, filter_filter(t, p))),
            False => filter_filter(t, p),
        },
    }
}

// Filtering a mapped list is mapping a filtered one, with the predicate pulled
// back through `f`. Both sides branch on `p(f(h))` — the right one after a beta
// step, since the pulled-back predicate is a literal lambda — so no convoy.
theorem filter_map<A, B>(xs: List<A>, f: A -> B, p: B -> Bool):
    filter(map(xs, f), p) = map(filter(xs, λ (a: A) => p(f(a))), f)
{
    match xs {
        Nil => {},
        Cons(h, t) => match p(f(h)) {
            True => cong_cons(f(h), filter_map(t, f, p)),
            False => filter_map(t, f, p),
        },
    }
}

// ---------------------------------------------------------------------------
// replicate and zip.
//
// `replicate` recurses on the count with the element fixed, so it needs no
// currying; `zip` walks both lists at once and therefore does.
//
// Write `zip(xs, ys)`: over-application lets the second list determine the
// curried tail's element type. A deliberately partial `zip<A, B>(xs)` still
// needs both type arguments because the second list is not present to infer B.

fn replicate<A>(x: A, n: Nat) -> List<A> {
    match n {
        Zero => Nil,
        Succ(k) => Cons(x, replicate(x, k)),
    }
}

theorem len_replicate<A>(x: A, n: Nat): len(replicate(x, n)) = n {
    match n {
        Zero => {},
        Succ(k) => cong_succ(len_replicate(x, k)),
    }
}

fn zip<A, B>(xs: List<A>) -> List<B> -> List<Pair<A, B>> {
    match xs {
        Nil => λ (ys: List<B>) => Nil,
        Cons(h, t) => λ (ys: List<B>) => match ys {
            Nil => Nil,
            Cons(h2, t2) => Cons(Pair(h, h2), zip(t, t2)),
        },
    }
}

// `zip`'s laws (wave L2′). L2 left `zip` pinned only by the computation test,
// and the interaction the wave list asked for is with `len`: zipping truncates,
// so the length is the `min`. That is the first law in the library to reach for
// `std/nat`'s `min` rather than `add`, and it costs nothing — `min` descends on
// both arguments exactly as `zip` descends on both lists, so all three arms are
// definitional.
//
// The other two say what the pairs CONTAIN, which `len_zip` cannot: projecting
// a zip is taking a prefix, and swapping it is zipping the other way round.
// `take` appears here for the first time outside its own law, and it lines up
// for the same reason `min` does.

theorem len_zip<A, B>(xs: List<A>):
    (ys: List<B>) -> len(zip(xs, ys)) = min(len(xs), len(ys))
{
    match xs {
        Nil => λ ys => {},
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => cong_succ(len_zip(t, t2)),
        },
    }
}

theorem zip_map_fst<A, B>(xs: List<A>):
    (ys: List<B>) -> map(zip(xs, ys), λ (q: Pair<A, B>) => q.fst) = take(xs, len(ys))
{
    match xs {
        Nil => λ ys => {},
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => cong_cons(h, zip_map_fst(t, t2)),
        },
    }
}

// The `Nil` arm splits `ys` and both `zip`'s do not, which is not symmetry
// lost: at `xs = Nil` the goal is `Nil = take(ys, 0)`, and `take` is curried in
// its index (issues/ih-generalization.md), so it steps only once its LIST is a
// constructor. The same shape is why `zip_swap`'s `Nil` arm splits too.
theorem zip_map_snd<A, B>(xs: List<A>):
    (ys: List<B>) -> map(zip(xs, ys), λ (q: Pair<A, B>) => q.snd) = take(ys, len(xs))
{
    match xs {
        Nil => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => {},
        },
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => cong_cons(h2, zip_map_snd(t, t2)),
        },
    }
}

// `std/pair`'s `swap` gets its first law here, and it is not applied by name:
// `swap` is polymorphic, so as a first-class argument it would have to spell
// its type arguments, and the η-expanded `λ q => swap(q)` is shorter than
// `swap<A, B>`. Nothing is lost — it is the same function.
theorem zip_swap<A, B>(xs: List<A>):
    (ys: List<B>) -> map(zip(xs, ys), λ (q: Pair<A, B>) => swap(q)) = zip(ys, xs)
{
    match xs {
        Nil => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => {},
        },
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => cong_cons(Pair(h2, h), zip_swap(t, t2)),
        },
    }
}

// ---------------------------------------------------------------------------
// membership (wave L3, issues/std-list-mem-and-perm.md).
//
// A recursion into `Type`, like `nat::Le` and `list_algos`'s `Sorted`, and for
// the same three reasons: it REDUCES at closed lists (so `Mem(2, [1,2])` is
// `Inr(Inl(refl))` and needs no search), it has no inversion machinery (the
// `Nil` case IS `False`, so refuting it is handing the hypothesis back), and it
// needs no indexed family (issues/indexed-families.md), which the derivation-
// shaped spelling would.
//
// **`Mem` is polymorphic and `list_algos`'s `count` is not**, and that line is
// the sharpest thing this wave found: membership needs only `=`, which every
// type has, while counting needs to DECIDE an equation, and a class cannot be
// keyed on one (issues/decidable-equation-carrier.md). The same algorithm's two
// specifications sit on opposite sides of a live language gap.
//
// Every lemma below takes its hypothesis AFTER the arrow rather than as a
// parameter, because a parameter whose type mentions `xs` cannot survive
// `match xs` without being convoyed through it. That is the ordinary shape in
// this repo (`nth_append_l`, `le_succ_r`), stated once here for the section.

fn Mem<A>(a: A, xs: List<A>) -> Type {
    match xs {
        Nil => False,
        Cons(h, t) => a = h ∨ Mem(a, t),
    }
}

theorem not_mem_nil<A>(a: A): ¬ Mem(a, Nil) { λ (h: Mem(a, Nil)) => h }

theorem mem_head<A>(a: A, xs: List<A>): Mem(a, Cons(a, xs)) { Inl(refl) }

theorem mem_cons<A>(a, h: A, xs: List<A>, m: Mem(a, xs)): Mem(a, Cons(h, xs)) { Inr(m) }

theorem mem_append_l<A>(xs, ys: List<A>, a: A): Mem(a, xs) -> Mem(a, xs ++ ys) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m => match m {
            Inl(e) => Inl(e),
            Inr(m2) => Inr(mem_append_l(t, ys, a, m2)),
        },
    }
}

theorem mem_append_r<A>(xs, ys: List<A>, a: A): Mem(a, ys) -> Mem(a, xs ++ ys) {
    match xs {
        Nil => λ m => m,
        Cons(h, t) => λ m => Inr(mem_append_r(t, ys, a, m)),
    }
}

theorem mem_append<A>(xs, ys: List<A>, a: A):
    Mem(a, xs ++ ys) -> Mem(a, xs) ∨ Mem(a, ys)
{
    match xs {
        Nil => λ m => Inr(m),
        Cons(h, t) => λ m => match m {
            Inl(e) => Inl(Inl(e)),
            Inr(m2) => match mem_append(t, ys, a, m2) {
                Inl(mt) => Inl(Inr(mt)),
                Inr(my) => Inr(my),
            },
        },
    }
}

// The `Iff` exists to be cited; the three lemmas above are what get applied.
theorem mem_append_iff<A>(xs, ys: List<A>, a: A):
    Mem(a, xs ++ ys) ↔ Mem(a, xs) ∨ Mem(a, ys)
{
    Iff(mp := mem_append(xs, ys, a),
        mpr := λ (h: Mem(a, xs) ∨ Mem(a, ys)) =>
            or_elim(h, mem_append_l(xs, ys, a), mem_append_r(xs, ys, a)))
}

theorem mem_map<A, B>(xs: List<A>, a: A, f: A -> B): Mem(a, xs) -> Mem(f(a), map(xs, f)) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m => match m {
            Inl(e) => Inl(cong_fn(f, e)),
            Inr(m2) => Inr(mem_map(t, a, f, m2)),
        },
    }
}

// Only ONE direction, and the missing one is a decision the API already made:
// the converse needs `p(a)` as a hypothesis, and `filter`'s predicate is a
// `Bool`, so the only spelling available is `p(a) = True` — which
// issues/class-ops-prop-vs-bool.md bans from a specification. The
// `Decide`-valued `filter` that issues/std-list-api.md called "a second
// function, not a replacement" is what would state it, and this is its first
// customer. Not encoded around: the fact is left unstated.
theorem mem_filter<A>(xs: List<A>, a: A, p: A -> Bool):
    Mem(a, filter(xs, p)) -> Mem(a, xs)
{
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => match p(h) {
            True => λ m => match m {
                Inl(e) => Inl(e),
                Inr(m2) => Inr(mem_filter(t, a, p, m2)),
            },
            False => λ m => Inr(mem_filter(t, a, p, m)),
        },
    }
}

// Reversing preserves membership, and this is the lemma that shows the kit
// working as one: `rev` is defined by `append`, so the proof is `mem_append`
// followed by refuting the singleton's tail.
theorem mem_rev<A>(xs: List<A>, a: A): Mem(a, rev(xs)) -> Mem(a, xs) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m =>
            match mem_append(rev(t), Cons(h, Nil), a, m) {
                Inl(mr) => Inr(mem_rev(t, a, mr)),
                Inr(mh) => match mh {
                    Inl(e) => Inl(e),
                    Inr(bad) => false_elim(bad),
                },
            },
    }
}

// ---------------------------------------------------------------------------
// the type's own namespace: the accessors and `nth`.
//
// `head` and `last` are the library's first PARTIAL functions, and they are
// written total, into `Option<A>`. That is the only spelling available today;
// the alternative — a `head` that demands a non-empty list and gets its
// `Option` face by adapter — is issues/guarded-to-option-adapter.md, which has
// no customer until this one.
//
// All four are type-owned members and not ambient names, which for `head` and
// `tail` is forced rather than chosen: `Cons`'s own fields are called `head`
// and `tail`.

fn List::head<A>(self xs: List<A>) -> Option<A> {
    match xs {
        Nil => None,
        Cons(h, t) => Some(h),
    }
}

fn List::tail<A>(self xs: List<A>) -> List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => t,
    }
}

fn List::last<A>(self xs: List<A>) -> Option<A> {
    match xs {
        Nil => None,
        Cons(h, t) => match t {
            Nil => Some(h),
            Cons(h2, t2) => last(t),
        },
    }
}

// Curried in the index for the reason every two-argument recursion in this
// repo is: the termination checker wants one decreasing argument with the
// rest fixed, so the argument that varies with the recursion is returned as a
// function instead. Call sites write `xs.nth(i)`: the receiver reaches the
// member through the type and the index spills into the curried tail
// (issues/type-owned-members-receiver-slice.md,
// issues/call-site-overapplication.md).
fn List::nth<A>(self xs: List<A>) -> Nat -> Option<A> {
    match xs {
        Nil => λ (i: Nat) => None,
        Cons(h, t) => λ (i: Nat) => match i { Zero => Some(h), Succ(k) => nth(t, k) },
    }
}

// Inside `xs`, `append` changes nothing. The index varies with the recursion,
// so the statement is a function of it and every use is an over-application
// (issues/ih-generalization.md's workaround).
theorem nth_append_l<A>(xs: List<A>, ys: List<A>):
    (i: Nat, a: A) -> xs.nth(i) = Some(a) -> (xs ++ ys).nth(i) = Some(a)
{
    match xs {
        Nil => λ i a p => absurd(p),
        Cons(h, t) => λ i a =>
            match i {
                Zero => λ p => p,
                Succ(k) => λ p => nth_append_l(t, ys, k, a, p),
            },
    }
}

// Past the whole of `xs`, `nth` reads out of `ys`. The index is written
// `add(i, len(xs))` and not `add(len(xs), i)`, which is what retires
// `list_algos`'s private `plusl` (2026-08-17): that function existed only
// because the sum had to peel a `Succ` as `xs` was peeled, and `nat::add`
// recurses on its second argument. Written this way round `add` steps exactly
// when `append` does, and the proof is the bare recursion.
theorem nth_append_r<A>(xs: List<A>, ys: List<A>, i: Nat):
    (xs ++ ys).nth(i + len(xs)) = ys.nth(i)
{
    match xs {
        Nil => {},
        Cons(h, t) => nth_append_r(t, ys, i),
    }
}

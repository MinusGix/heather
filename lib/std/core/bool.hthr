// Booleans, their logical operations, and the propositional order
// `False <= True`. Conjunction and disjunction are both commutative monoids;
// the corresponding instances live in `std/algebra`.

import logic;

inductive Bool { False, True }

fn Bool::not(self b: Bool) → Bool { match b { False => True, True => False } }

designation prefix ! at Bool := Bool::not

fn Bool::and(self a, b: Bool) → Bool { match a { False => False, True => b } }

designation && at Bool := Bool::and

fn Bool::or(self a, b: Bool) → Bool { match a { False => b, True => True } }

designation || at Bool := Bool::or

fn Bool::xor(self a, b: Bool) → Bool { match a { False => b, True => !b } }

// TODO: xor theorems

// Two bits whose exclusive or is clear are one bit.
theorem Bool::eq_of_not_xor(a, b: Bool, same: !(a.xor(b)) = True): a = b {
    match a { False => match b { False => refl, True => absurd(same) }, True => match b { False => absurd(same), True => refl } }
}

theorem Bool::and_assoc(self a, b, c: Bool): (a && b) && c = a && (b && c) {
    match a { False => refl, True => refl }
}

theorem Bool::and_true_l(self a: Bool): True && a = a { refl }

theorem Bool::and_true_r(self a: Bool): a && True = a {
    match a { False => refl, True => refl }
}

theorem Bool::and_comm(self a, b: Bool): a && b = b && a {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

theorem Bool::and_false_r(self a: Bool): a && False = False {
    match a { False => refl, True => refl }
}

theorem Bool::or_assoc(self a, b, c: Bool): (a || b) || c = a || (b || c) {
    match a { False => refl, True => refl }
}

theorem Bool::or_false_l(self a: Bool): False || a = a { refl }

theorem Bool::or_false_r(self a: Bool): a || False = a {
    match a { False => refl, True => refl }
}

theorem Bool::or_comm(self a, b: Bool): a || b = b || a {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

// ---------------------------------------------------------------------------
// Decidability (issues/decide-class.md). `Decide<P>` is the Bool with its
// evidence attached: there is no sort boundary to cross and no second object,
// since Heather keeps proof relevance and a `match` on `dec` eliminates
// straight into `Type`.
//
// The content of the class is *"this disjunction reduces"*. A classical
// `lem : (P: Type) → P ∨ ¬P` would make every consumer below typecheck and
// then compute nothing, because `lem(…)` is a neutral constant with no
// reduction rule. That difference is the whole reason the class exists.
//
// A decision also carries its bit (issues/native-frontend-decided-matches.md):
// `bit` is `True` exactly when `P` holds, and `reflects` says so. An `if P`
// without an evidence binder is `match decide_bit<P>()`, so a decision built
// from a comparison is a match on that comparison's bit, the way code
// branches on it. An `if h: P` matches on the bit too, its `h` read from
// `reflects` (`decide_true`, `decide_false`). `dec` stays for every consumer
// that wants the evidence as a disjunction. The class lives here, beside `Bool`, because its bit is one.

// `bit` decides `P`: it is `True` exactly when `P` holds.
fn Reflects(P: Type, bit: Bool) → Type { ((bit = True) → P) ∧ ((bit = False) → ¬P) }

class Decide<P> { dec: P ∨ ¬P, bit: Bool, reflects: Reflects(P, bit) }

// The bit of a decision that has none of its own: the side it took. An
// instance over a `_dec` function spells its bit and reflection with these.
fn or_bit<P, Q>(d: P ∨ Q) → Bool { match d { Inl(_) => True, Inr(_) => False } }

theorem or_bit_reflects<P>(d: P ∨ ¬P): Reflects(P, or_bit(d)) {
    match d {
        Inl(p) => And(λ _ => p, λ (no: True = False) => absurd(no)),
        Inr(np) => And(λ (no: False = True) => absurd(no), λ _ => np),
    }
}

// The connectives' bits reflect the connectives.
theorem reflects_and({P, Q: Type}, {x, y: Bool}, p: Reflects(P, x), q: Reflects(Q, y)): Reflects(P ∧ Q, x && y) {
    And(λ e => (match x as λ c => (x = c) → (c && y = True) → P ∧ Q {
            True => λ hx hy => And(p.left(hx), q.left(hy)),
            False => λ _ no => absurd(no),
        })(refl, e),
     λ e both => (match x as λ c => (x = c) → (c && y = False) → False {
            True => λ _ hy => q.right(hy)(both.right),
            False => λ hx _ => p.right(hx)(both.left),
        })(refl, e))
}

theorem reflects_or({P, Q: Type}, {x, y: Bool}, p: Reflects(P, x), q: Reflects(Q, y)): Reflects(P ∨ Q, x || y) {
    And(λ e => (match x as λ c => (x = c) → (c || y = True) → P ∨ Q {
            True => λ hx _ => Inl(p.left(hx)),
            False => λ _ hy => Inr(q.left(hy)),
        })(refl, e),
     λ e either => (match x as λ c => (x = c) → (c || y = False) → False {
            True => λ _ no => absurd(no),
            False => λ hx hy => match either { Inl(a) => p.right(hx)(a), Inr(b) => q.right(hy)(b) },
        })(refl, e))
}

theorem reflects_not({P: Type}, {x: Bool}, p: Reflects(P, x)): Reflects(¬P, !x) {
    And(λ e => (match x as λ c => (x = c) → (!c = True) → ¬P {
            True => λ _ no => absurd(no),
            False => λ hx _ => p.right(hx),
        })(refl, e),
     λ e notp => (match x as λ c => (x = c) → (!c = False) → False {
            True => λ hx _ => notp(p.left(hx)),
            False => λ _ no => absurd(no),
        })(refl, e))
}

// Implication's bit is `!x || y`: `Q` is tested only where `P` holds.
theorem reflects_imp({P, Q: Type}, {x, y: Bool}, p: Reflects(P, x), q: Reflects(Q, y)): Reflects(P → Q, !x || y) {
    And(λ e => (match x as λ c => (x = c) → (!c || y = True) → P → Q {
            True => λ _ hy _ => q.left(hy),
            False => λ hx _ a => false_elim(p.right(hx)(a)),
        })(refl, e),
     λ e f => (match x as λ c => (x = c) → (!c || y = False) → False {
            True => λ hx hy => q.right(hy)(f(p.left(hx))),
            False => λ _ no => absurd(no),
        })(refl, e))
}

// The two constants. `True` is the kernel's `Unit^0`, so `Inl(trivial)` is the
// only inhabitant there is; `False`'s refutation is the identity, exactly as
// `not_succ_le_zero` is over in `nat`.
instance Decide<True> {
    dec := Inl(trivial),
    bit := True,
    reflects := And(λ _ => trivial, λ (no: True = False) => absurd(no)),
}
instance Decide<False> {
    dec := Inr(λ (h: False) => h),
    bit := False,
    reflects := And(λ (no: False = True) => absurd(no), λ _ (h: False) => h),
}

// The composition instances — what earns this a class rather than a naming
// convention. Resolution assembles them: a goal at `¬(P ∧ Q)` backchains
// through `Not`, then `And`, then whatever decides `P` and `Q`, and no writer
// names an intermediate.
//
// `¬P` can key an instance because canonical names may be attached to a type
// former as well as to a declared type. `Not` remains a function into `Type`,
// keeping negation definitionally equal to `P → False`.
//
// Their bits are the Bool connectives, which test the second operand only
// where the first did not settle it: a native step lowers a match on one as
// branches, an operand at a time.

instance<P: Decide, Q: Decide> Decide<P ∧ Q> {
    dec := match P.dec {
        Inl(p) => match Q.dec {
            Inl(q) => Inl(And(p, q)),
            Inr(nq) => Inr(λ (h: P ∧ Q) => nq(h.right)),
        },
        Inr(np) => Inr(λ (h: P ∧ Q) => np(h.left)),
    },
    bit := P.bit && Q.bit,
    reflects := reflects_and(P.reflects, Q.reflects),
}

instance<P: Decide, Q: Decide> Decide<P ∨ Q> {
    dec := match P.dec {
        Inl(p) => Inl(Inl(p)),
        Inr(np) => match Q.dec {
            Inl(q) => Inl(Inr(q)),
            Inr(nq) => Inr(λ (h: P ∨ Q) =>
                match h { Inl(p) => np(p), Inr(q) => nq(q) }),
        },
    },
    bit := P.bit || Q.bit,
    reflects := reflects_or(P.reflects, Q.reflects),
}

instance<P: Decide> Decide<¬P> {
    dec := match P.dec {
        Inl(p) => Inr(λ (np: ¬P) => np(p)),
        Inr(np) => Inl(np),
    },
    bit := !P.bit,
    reflects := reflects_not(P.reflects),
}

// Implication, so a guard's side condition (`rt → sp → room`) decides as
// written rather than as the `¬(rt ∧ sp ∧ ¬room)` a program tests.
instance<P: Decide, Q: Decide> Decide<P → Q> {
    dec := match P.dec {
        Inl(p) => match Q.dec {
            Inl(q) => Inl(λ (_: P) => q),
            Inr(nq) => Inr(λ (f: P → Q) => nq(f(p))),
        },
        Inr(np) => Inl(λ (p: P) => false_elim(np(p))),
    },
    bit := !P.bit || Q.bit,
    reflects := reflects_imp(P.reflects, Q.reflects),
}

// The consumers. `decide` is the projection a caller reaches for when it wants
// the disjunction and will `match` on it itself; `decide_pick` is the same
// branch made a value, and is `or_pick` with the dictionary found rather than
// passed. `decide_bit` is the bit, which an `if` without evidence matches on
// and which a specification passes where a Bool predicate is wanted
// (`bytes.filter(λ b => decide_bit<b = '\n'>())`).
//
// A `fn` and not a `theorem`, all of them, for the reason `or_pick` carries:
// a `theorem` is opaque, so a decision spelled as one never unfolds in
// conversion and nothing downstream of it is `refl` any more.
fn decide<P: Decide>() → P ∨ ¬P { P.dec }

fn decide_bit<P: Decide>() → Bool { P.bit }

// An `if h: P`'s evidence: the `if` matches on `decide_bit<P>()`, and each
// branch has `P` or `¬P` from the bit's equation.
fn decide_true<P: Decide>(e: decide_bit<P>() = True) → P { P.reflects.left(e) }

fn decide_false<P: Decide>(e: decide_bit<P>() = False) → ¬P { P.reflects.right(e) }

fn decide_pick<P: Decide, A>(x, y: A) → A { or_pick(P.dec, x, y) }

// The `or_pick_dec` lemma with the dictionary resolved — a proof of `P` makes
// the decided branch compute, whichever way the decider happened to go.
theorem decide_pick_yes<P: Decide, A>(x, y: A, p: P): decide_pick<P, A>(x, y) = y {
    or_pick_dec(P.dec, x, y, p)
}

// What a decided bit says: `P` where it is `True`, `¬P` where it is `False`.
theorem decide_bit_true<P: Decide>(h: decide_bit<P>() = True): P { P.reflects.left(h) }
theorem decide_bit_false<P: Decide>(h: decide_bit<P>() = False): ¬P { P.reflects.right(h) }

// Case analysis on a decided bit, with what each side says as evidence: the
// proof shape for a function an evidence-free `if` defines.
theorem decide_bit_split<P: Decide>(M: Bool → Type, yes: P → M(True), no: ¬P → M(False)): M(decide_bit<P>()) {
    match e: decide_bit<P>() {
        True => yes(decide_bit_true<P>(e)),
        False => no(decide_bit_false<P>(e)),
    }
}

// A decided bit from what it decides: the converses of `decide_bit_true`
// and `decide_bit_false`. A step equation (`f_step`, `f_done`) takes the
// proposition and reads the bit's equation back with these.
theorem decide_bit_of<P: Decide>(p: P): decide_bit<P>() = True {
    (match decide_bit<P>() as λ c => (decide_bit<P>() = c) → c = True {
        True => λ _ => refl,
        False => λ e => absurd_of(p, decide_bit_false<P>(e)),
    })(refl)
}

theorem decide_bit_of_not<P: Decide>(n: ¬P): decide_bit<P>() = False {
    (match decide_bit<P>() as λ c => (decide_bit<P>() = c) → c = False {
        True => λ e => absurd_of(decide_bit_true<P>(e), n),
        False => λ _ => refl,
    })(refl)
}

// Reflection (issues/reflection-through-decide-instances.md): a closed
// decided proposition is *proved* by running its decision and reading the
// side it took. `or_index` is that reading (a `Nat`: it was written when the
// class lived below `bool`), and `or_of_index_zero` is the elimination back
// into `P`. `decide_yes` is the whole of what the `decide` goal combinator
// writes: `decide_yes(refl)` at the goal, with the kernel judging the `refl`
// by reducing the instance's `dec`. Nothing else is trusted, and the decision
// procedure never appears at the proof site.
fn or_index<P, Q>(d: P ∨ Q) → Nat { match d { Inl(_) => 0, Inr(_) => 1 } }

theorem or_of_index_zero<P, Q>(d: P ∨ Q, h: or_index(d) = 0): P {
    match d as λ x => or_index(x) = 0 → P {
        Inl(p) => λ _ => p,
        Inr(_) => λ bad => absurd(bad),
    }(h)
}

theorem decide_yes<P: Decide>(h: or_index(P.dec) = 0): P { or_of_index_zero(P.dec, h) }

// ---------------------------------------------------------------------------
// Reflection into `Type`. `IsTrue(b)` is the proposition "`b` is `True`",

fn Bool::IsTrue(self b: Bool) → Type { match b { False => False, True => True } }

// A verdict written `b = True` (the shape `refl` proves) as the proposition.
theorem Bool::is_true_of_eq({b: Bool}, h: b = True): b.IsTrue() { j(sym(h), λ w _ => w.IsTrue(), trivial) }

theorem Bool::is_true_unique(self b: Bool, p, q: b.IsTrue()): p = q {
    match b as λ x => (u, v: x.IsTrue()) → u = v {
        False => λ u v => false_elim(u),
        True => λ u v => refl,
    }(p, q)
}

fn Bool::is_true_dec(self b: Bool) → b.IsTrue() ∨ ¬b.IsTrue() {
    match b { False => Inr(·), True => Inl(trivial) }
}

instance(b: Bool) Decide<Bool::IsTrue(b)> {
    dec := b.is_true_dec(),
    bit := b,
    reflects := And(λ e => rewrite(e, trivial), λ e => rewrite(e, λ (u: False) => u)),
}

// The two rewrites a consumer of a reflected guard needs: a proved guard IS
// `True`, and its decision DID go the `Inl` way. Both are what turns a stuck
// `match` on a guard at an open argument into its taken branch.
theorem eq_true_of_is_true(b: Bool, p: b.IsTrue()): b = True {
    match b as λ x => x.IsTrue() → x = True {
        False => λ u => false_elim(u),
        True => λ u => refl,
    }(p)
}

theorem eq_false_of_not_is_true(b: Bool, no: ¬b.IsTrue()): b = False {
    match b { False => refl, True => false_elim(no(trivial)) }
}

// A conjunction's verdict and its parts' verdicts.
theorem Bool::and_true_parts(self a, b: Bool): (a && b) = True → a = True ∧ b = True {
    match a { True => λ h => ⟨refl, h⟩, False => λ h => absurd(h) }
}

theorem Bool::and_true_of(self a, b: Bool): a = True → b = True → (a && b) = True {
    match a { True => λ ha hb => hb, False => λ ha hb => absurd(ha) }
}

// A disjunction's verdict is one of its parts'.
theorem Bool::or_true_parts(self a, b: Bool): (a || b) = True → a = True ∨ b = True {
    match a { True => λ _ => Inl(refl), False => λ right => Inr(right) }
}

theorem Bool::or_false_parts(self a, b: Bool): (a || b) = False → a = False ∧ b = False {
    match a { False => λ h => ⟨refl, h⟩, True => λ h => absurd(h) }
}

theorem Bool::or_false_of(self a, b: Bool): a = False → b = False → (a || b) = False {
    match a { False => λ ha hb => hb, True => λ ha hb => absurd(ha) }
}

// What `a` is, from the verdict of `a.xor(b)`.
theorem Bool::xor_true_value(self a, b: Bool): a.xor(b) = True → a = !b {
    match a {
        False => match b { False => λ t => absurd(sym(t)), True => λ t => refl },
        True => match b { False => λ t => refl, True => λ t => absurd(sym(t)) },
    }
}

theorem Bool::xor_false_value(self a, b: Bool): a.xor(b) = False → a = b {
    match a {
        False => match b { False => λ t => refl, True => λ t => absurd(t) },
        True => match b { False => λ t => absurd(t), True => λ t => refl },
    }
}

theorem is_true_dec_yes(b: Bool, p: b.IsTrue()): b.is_true_dec() = Inl(p) {
    match b as λ x => (u: x.IsTrue()) → x.is_true_dec() = Inl(u) {
        False => λ u => false_elim(u),
        True => λ u => refl,
    }(p)
}

// Reflection read at `IsTrue`, the form a Bool guard is carried in. A
// guard built from comparisons and connectives is proved by assembling its
// `Reflects` from the parts' (`reflects_and`, `Nat::leb_reflects`, …),
// mapping it onto the statement wanted with `reflects_iff`, and reading it
// either way: `reflects_intro` proves the guard from the proposition and
// `reflects_elim` the proposition from the guard.
theorem reflects_of_is_true({P: Type}, {b: Bool}, sound: b.IsTrue() → P, complete: P → b.IsTrue()): Reflects(P, b) {
    And(λ e => sound(rewrite(e, trivial)), λ e p => j(e, λ c _ => c.IsTrue(), complete(p)))
}

theorem reflects_iff({P, Q: Type}, {b: Bool}, r: Reflects(P, b), pq: P → Q, qp: Q → P): Reflects(Q, b) {
    And(λ e => pq(r.left(e)), λ e q => r.right(e)(qp(q)))
}

theorem reflects_elim({P: Type}, {b: Bool}, r: Reflects(P, b), h: b.IsTrue()): P { r.left(eq_true_of_is_true(b, h)) }

theorem reflects_intro({P: Type}, {b: Bool}, r: Reflects(P, b), p: P): b.IsTrue() {
    match b as λ c => Reflects(P, c) → c.IsTrue() {
        False => λ no => no.right(refl)(p),
        True => λ _ => trivial,
    }(r)
}

// The same two readings at a decision: a Bool guard that is
// `decide_bit<P>()` is proved from `P` and read back into it, with the
// instance's reflection doing what a hand-built `*_reflects` lemma did.
theorem decide_intro<P: Decide>(p: P): decide_bit<P>().IsTrue() { reflects_intro(P.reflects, p) }
theorem decide_elim<P: Decide>(h: decide_bit<P>().IsTrue()): P { reflects_elim(P.reflects, h) }

// A Bool reflects its own truth.
theorem Bool::is_true_reflects(self b: Bool): Reflects(b.IsTrue(), b) { reflects_of_is_true(λ h => h, λ h => h) }

theorem Bool::is_true_and(self a: Bool): (b: Bool) → (a && b).IsTrue() → a.IsTrue() ∧ b.IsTrue() {
    match a {
        False => λ b h => false_elim(h),
        True => λ b h => And(trivial, h),
    }
}

theorem Bool::is_true_or(self a: Bool): (b: Bool) → (a || b).IsTrue() → a.IsTrue() ∨ b.IsTrue() {
    match a {
        False => λ b h => Inr(h),
        True => λ b h => Inl(trivial),
    }
}

theorem Bool::is_true_or_l(self a: Bool): (b: Bool) → a.IsTrue() → (a || b).IsTrue() {
    match a {
        False => λ b h => false_elim(h),
        True => λ b h => trivial,
    }
}

theorem Bool::is_true_or_r(self a: Bool): (b: Bool) → b.IsTrue() → (a || b).IsTrue() {
    match a {
        False => λ b h => h,
        True => λ b h => trivial,
    }
}

theorem Bool::is_true_and_intro(self a: Bool): (b: Bool) → a.IsTrue() → b.IsTrue() → (a && b).IsTrue() {
    match a {
        False => λ b p q => false_elim(p),
        True => λ b p q => q,
    }
}

// A conjunction with one side weakened.
theorem Bool::and_left_map(a, b, c: Bool, f: a.IsTrue() → c.IsTrue()): (a && b).IsTrue() → (c && b).IsTrue() {
    λ ok => Bool::is_true_and_intro(c, b, f(Bool::is_true_and(a, b, ok).left), Bool::is_true_and(a, b, ok).right)
}

theorem Bool::and_right_map(a, b, c: Bool, f: b.IsTrue() → c.IsTrue()): (a && b).IsTrue() → (a && c).IsTrue() {
    λ ok => Bool::is_true_and_intro(a, c, Bool::is_true_and(a, b, ok).left, f(Bool::is_true_and(a, b, ok).right))
}

theorem Bool::is_true_not(self b: Bool): b.not().IsTrue() → ¬b.IsTrue() {
    match b {
        False => λ h p => p,
        True => λ h p => h,
    }
}

theorem Bool::is_true_not_intro(self b: Bool): ¬b.IsTrue() → b.not().IsTrue() {
    match b {
        False => λ h => trivial,
        True => λ h => h(trivial),
    }
}

theorem Bool::or_cong({a, b, c, d: Bool}, ab: a = b, cd: c = d): a || c = b || d {
    j(ab, λ x _ => a || c = x || d, j(cd, λ y _ => a || c = a || y, refl))
}

// Two Booleans true together are equal: a Boolean identity is two
// implications, each one `omega` over the guards' atoms.
theorem Bool::eq_of_is_true_iff(self a: Bool): (b: Bool) → (a.IsTrue() → b.IsTrue()) → (b.IsTrue() → a.IsTrue()) → a = b {
    match a {
        True => λ b => match b {
            True => λ _ _ => refl,
            False => λ ab _ => false_elim(ab(trivial)),
        },
        False => λ b => match b {
            True => λ _ ba => false_elim(ba(trivial)),
            False => λ _ _ => refl,
        },
    }
}

fn Bool::eq_dec(self a, b: Bool) → a = b ∨ a ≠ b {
    match a {
        False => match b {
            False => Inl(refl),
            True => Inr(λ (bad: False = True) => absurd(bad)),
        },
        True => match b {
            False => Inr(λ (bad: True = False) => absurd(bad)),
            True => Inl(refl),
        },
    }
}

instance(a, b: Bool) Decide<a = b> { dec := a.eq_dec(b), bit := or_bit(a.eq_dec(b)), reflects := or_bit_reflects(a.eq_dec(b)) }

instance DecEq<Bool> { eq_dec := Bool::eq_dec }

fn Bool::leb(self a: Bool) → Bool → Bool {
    match a { False => λ (b: Bool) => True, True => λ (b: Bool) => b }
}

theorem Bool::leb_refl(self a: Bool): a.leb(a) = True {
    match a { False => refl, True => refl }
}

fn Bool::Le(self a: Bool) → Bool → Type {
    match a {
        False => λ (b: Bool) => True,
        True => λ (b: Bool) => match b { False => False, True => True },
    }
}

designation <= at Bool := Bool::Le

theorem Bool::le_refl(self a: Bool): a <= a {
    match a { False => trivial, True => trivial }
}

fn Bool::le_dec(self a, b: Bool) → a <= b ∨ ¬(a <= b) {
    match a {
        False => Inl(trivial),
        True => match b {
            False => Inr(·),
            True => Inl(trivial),
        },
    }
}

instance(a, b: Bool) Decide<Bool::Le(a, b)> { dec := a.le_dec(b), bit := or_bit(a.le_dec(b)), reflects := or_bit_reflects(a.le_dec(b)) }

// A `match h:` on a bit whose
// value is known takes that arm, at the proof it was given. Each arm is a
// slot: `f` and `g` are read off the `match` the goal holds — a `decreases`
// function's unfolding at its `if h:` test, say
// (issues/unify-through-match-arms.md) — so a step is
// `trans(f_unfold(x), Bool::taken_true(c, e))` with only the test's
// verdict written.
theorem Bool::taken_true<A>(b: Bool, {f: (b = True) → A}, {g: (b = False) → A}, e: b = True):
    (match h: b { True => f(h), False => g(h) }) = f(e) {
    j(e, λ w q => (match h: b { True => f(h), False => g(h) }) = (match w as λ c => (b = c) → A { True => λ h => f(h), False => λ h => g(h) })(q), refl)
}

theorem Bool::taken_false<A>(b: Bool, {f: (b = True) → A}, {g: (b = False) → A}, e: b = False):
    (match h: b { True => f(h), False => g(h) }) = g(e) {
    j(e, λ w q => (match h: b { True => f(h), False => g(h) }) = (match w as λ c => (b = c) → A { True => λ h => f(h), False => λ h => g(h) })(q), refl)
}

// The same with the arms given rather than read off the goal: the
// convoy a test with an equation lowers to (`if h: P`, `match h: b`) at a
// bit a hypothesis gives is the arm it picks, applied to that hypothesis.
// The step equations of a `decreases` function (`f::step`, `f::done`) are
// `f_unfold` followed by one of these (issues/loop-invariant-rules.md).
theorem Bool::convoy_true<A>(b: Bool, yes: (b = True) → A, no: (b = False) → A, e: b = True):
    ((match b as λ c => (b = c) → A { True => yes, False => no })(refl)) = yes(e) {
    Bool::taken_true(b, e, f := yes, g := no)
}

theorem Bool::convoy_false<A>(b: Bool, yes: (b = True) → A, no: (b = False) → A, e: b = False):
    ((match b as λ c => (b = c) → A { True => yes, False => no })(refl)) = no(e) {
    Bool::taken_false(b, e, f := yes, g := no)
}

// A test without an equation (`if P`, `match b`) at a bit a hypothesis
// gives is the arm it picks. A definition's branch equations (`f::True`,
// `f::False`) are these, one per test on the way to the branch
// (issues/definition-branch-equations.md).
theorem Bool::picked_true<A>(b: Bool, yes, no: A, e: b = True): (match b { True => yes, False => no }) = yes {
    j(e, λ w _ => (match b { True => yes, False => no }) = (match w { True => yes, False => no }), refl)
}

theorem Bool::picked_false<A>(b: Bool, yes, no: A, e: b = False): (match b { True => yes, False => no }) = no {
    j(e, λ w _ => (match b { True => yes, False => no }) = (match w { True => yes, False => no }), refl)
}

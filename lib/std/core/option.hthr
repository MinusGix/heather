// `Option<A>` and its basic transformation, chaining, and fallback operations.

import logic;
import bool;

inductive Option<A> { None, Some(v: A) }

fn Option::map<A, B>(self o: Option<A>, f: A → B) → Option<B> {
    match o {
        None => None,
        Some(v) => Some(f(v)),
    }
}

fn Option::and_then<A, B>(self o: Option<A>, f: A → Option<B>) → Option<B> {
    match o {
        None => None,
        Some(v) => f(v),
    }
}

// `Option` is a carrier of binding statements: `let x <- o;` exits with
// `None` (docs/language/sequencing-surface-design.md §2.3).
instance Bind<Option> { bind := Option::and_then }
instance Pointed<Option> { pure := λ {A} a => Some(a) }

fn Option::unwrap_or<A>(self o: Option<A>, d: A) → A {
    if let Some(v) = o { v } else { d }
}

theorem Option::some_inj<A>(a, b: A, p: Some(a) = Some(b)): a = b {
    j(p, λ y q => a = y.unwrap_or(a), refl)
}

// `None` is not `Some`: from such an equation anything follows.
theorem Option::none_ne_some<A>(a: A, p: None<A>() = Some(a), T: Type): T {
    j(sym(p), λ y q => match y as λ _ => Type { None => T, Some(_) => A }, a)
}

// A statement about a chained option: it holds of `None`, and of what the
// chain gives for every value the option holds.
theorem Option::and_then_elim<A, B>(P: Option<B> → Type, none: P(None), o: Option<A>, f: A → Option<B>,
    some: (v: A) → o = Some(v) → P(f(v))): P(o.and_then(f)) {
    match o { None => none, Some(v) => some(v, refl) }
}

// A chain that gave a value went through one.
theorem Option::and_then_some<A, B>(o: Option<A>, f: A → Option<B>, b: B): o.and_then(f) = Some(b) →
    Exists<A>(λ a => (o = Some(a)) ∧ (f(a) = Some(b))) {
    match o { None => λ h => absurd(h), Some(a) => λ h => Exists(a, ⟨refl, h⟩) }
}

// A check in a chain: `next` where the check passed, nothing where it did
// not.
fn Bool::then<A>(self ok: Bool, next: Option<A>) → Option<A> { match ok { True => next, False => None } }

theorem Bool::then_some<A>(self ok: Bool, next: Option<A>, a: A): ok.then(next) = Some(a) → (ok = True) ∧ (next = Some(a)) {
    match ok { True => λ h => ⟨refl, h⟩, False => λ h => absurd(h) }
}

// Two continuations that answer alike give one chain.
theorem Option::and_then_ext<A, B>(o: Option<A>, f, g: A → Option<B>, same: (v: A) → f(v) = g(v)): o.and_then(f) = o.and_then(g) {
    match o { None => refl, Some(v) => same(v) }
}

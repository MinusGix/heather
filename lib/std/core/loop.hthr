// One loop combinator (docs/language/loop-combinator-design.md).
//
// A loop is a state `S`, a measure `m` on it, and a step that, at each
// state, either goes round again at a state the measure puts lower, or
// leaves with an answer. `Loop::run` is that loop; it has one unfolding
// equation, `Loop::run_unfold`, and one rule, `Loop::rule`: an invariant
// that every pass keeps goes in, and what every exit establishes comes out.
//
// The state is whatever the loop needs, facts included: a loop whose body
// reads `s[j - 1]` under `0 < j` and `j <= i` carries `∥j <= i∥` in its
// state, so its step is a total function of states where the fact holds and
// never has to answer at a state where it fails. A fact is squashed, so it
// costs nothing at run time and two states differing only in its proof are
// one state.
//
// The decrease is the step's: `Again` carries `∥m(next) < m(s)∥`, found
// where the step is written, under the tests that lead to it. That is what
// lets `Loop::run` be defined once, for every step, by `decreases m(s)`.
import logic;
import bool;
import nat;

// A state below `s` by the measure `m`.
record Lower<S>(m: S → Nat, s: S) { next: S, less: ∥m(next) < m(s)∥ }

// One pass at state `s`: round again at `next`, below `s` by the measure,
// or leave with `r`.
inductive Pass<S, R>(m: S → Nat, s: S) {
    Again(next: Lower<S>(m, s)),
    Done(r: R),
}

// A loop over states `S` answering `R`: its measure and its step.
record Loop<S, R> { measure: S → Nat, step: (s: S) → Pass<S, R>(measure, s) }

// The loop from `s` with at most `k` passes left, which the measure
// bounds. Structural on `k`: each pass's decrease is what lets it go on.
fn Loop::within<S, R>(self l: Loop<S, R>, k: Nat, s: S, h: l.measure(s) < k) → R {
    match k as λ k2 => l.measure(s) < k2 → R {
        Zero => λ h0 => false_elim(Nat::not_succ_le_zero(l.measure(s), h0)),
        Succ(j) => λ hj => match l.step(s) {
            Again(b) => l.within(j, b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j, b.less.recover(), hj)),
            Done(r) => r,
        },
    }(h)
}

// The loop from `s`: its passes until one leaves.
fn Loop::run<S, R>(self l: Loop<S, R>, s: S) → R { l.within(l.measure(s) + 1, s, Nat::lt_succ_self(l.measure(s))) }

// How many passes are allowed does not matter, as long as the measure
// bounds them.
theorem Loop::within_irrel<S, R>(self l: Loop<S, R>, k: Nat): (k2: Nat) → (s: S) → (h: l.measure(s) < k) → (h2: l.measure(s) < k2) →
    l.within(k, s, h) = l.within(k2, s, h2)
{
    match k {
        Zero => λ k2 s h h2 => false_elim(Nat::not_succ_le_zero(l.measure(s), h)),
        Succ(j) => λ k2 => match k2 {
            Zero => λ s h h2 => false_elim(Nat::not_succ_le_zero(l.measure(s), h2)),
            Succ(j2) => λ s h h2 => match l.step(s) as λ p =>
                (match p {
                    Again(b) => l.within(j, b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j, b.less.recover(), h)),
                    Done(r) => r,
                }) = (match p {
                    Again(b) => l.within(j2, b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j2, b.less.recover(), h2)),
                    Done(r) => r,
                }) {
                Again(b) => Loop::within_irrel(l, j, j2, b.next,
                    Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j, b.less.recover(), h),
                    Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j2, b.less.recover(), h2)),
                Done(_) => refl,
            },
        },
    }
}

// The loop's one equation: a pass, then the loop again or the answer.
theorem Loop::run_unfold<S, R>(self l: Loop<S, R>, s: S):
    l.run(s) = (match l.step(s) { Again(b) => l.run(b.next), Done(r) => r })
{
    let h = Nat::lt_succ_self(l.measure(s));
    match l.step(s) as λ p =>
        (match p {
            Again(b) => l.within(l.measure(s), b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), l.measure(s), b.less.recover(), h)),
            Done(r) => r,
        }) = (match p { Again(b) => l.run(b.next), Done(r) => r }) {
        Again(b) => l.within_irrel(l.measure(s), l.measure(b.next) + 1, b.next,
            Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), l.measure(s), b.less.recover(), h), Nat::lt_succ_self(l.measure(b.next))),
        Done(_) => refl,
    }
}

// What a pass hands on: the invariant at the next state, the
// postcondition at the answer.
fn Pass::Keeps<S, R>(m: S → Nat, s: S, self p: Pass<S, R>(m, s), I: S → Type, Q: R → Type) → Type {
    match p { Again(b) => I(b.next), Done(r) => Q(r) }
}

// The loop rule at a number of passes.
theorem Loop::rule_within<S, R>(self l: Loop<S, R>, I: S → Type, Q: R → Type,
    keeps: (s: S) → I(s) → Pass::Keeps(l.measure, s, l.step(s), I, Q), k: Nat): (s: S) → (h: l.measure(s) < k) → I(s) → Q(l.within(k, s, h))
{
    match k {
        Zero => λ s h start => false_elim(Nat::not_succ_le_zero(l.measure(s), h)),
        Succ(j) => λ s h start => match l.step(s) as λ p => Pass::Keeps(l.measure, s, p, I, Q) →
            Q(match p {
                Again(b) => l.within(j, b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j, b.less.recover(), h)),
                Done(r) => r,
            }) {
            Again(b) => λ (held: I(b.next)) => Loop::rule_within(l, I, Q, keeps, j, b.next,
                Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j, b.less.recover(), h), held),
            Done(r) => λ (done: Q(r)) => done,
        }(keeps(s, start)),
    }
}

// The loop rule: an invariant that holds at the start, and that each pass
// from a state where it holds either keeps or turns into the
// postcondition, gives the postcondition at the loop's answer. Proved once,
// here.
theorem Loop::rule<S, R>(self l: Loop<S, R>, I: S → Type, Q: R → Type,
    keeps: (s: S) → I(s) → Pass::Keeps(l.measure, s, l.step(s), I, Q), s: S, start: I(s)): Q(l.run(s))
{
    l.rule_within(I, Q, keeps, l.measure(s) + 1, s, Nat::lt_succ_self(l.measure(s)), start)
}

// ---------------------------------------------------------------------------
// Uniqueness of a well-founded fixpoint
// (docs/language/loop-combinator-design.md §6.5).
//
// A recursion over `A` with measure `m` is a step `F`: its answer at `a`,
// given an answer at every argument whose measure is below `a`'s. Two
// functions that each satisfy the step's equation are equal at every
// argument, provided the step reads its recursion only at its values
// (`FixpointExt`; there is no funext). This is how a function defined by
// recursion is pinned to its compiled code: the code's meaning and the
// function satisfy the same equation. A loop is its case (`Loop::unique`).

// The step reads its recursion only at its values below the measure.
fn FixpointExt<A, B>(m: A → Nat, F: (a: A) → ((b: A) → m(b) < m(a) → B) → B) → Type {
    (a: A) → (h1, h2: (b: A) → m(b) < m(a) → B) → ((b: A) → (p: m(b) < m(a)) → h1(b, p) = h2(b, p)) → F(a, h1) = F(a, h2)
}

// Below a bound on the measure.
theorem fixpoint_unique_within<A, B>(m: A → Nat, F: (a: A) → ((b: A) → m(b) < m(a) → B) → B, ext: FixpointExt(m, F), f, g: A → B,
    fe: (a: A) → f(a) = F(a, λ b _ => f(b)), ge: (a: A) → g(a) = F(a, λ b _ => g(b)), k: Nat): (a: A) → m(a) < k → f(a) = g(a)
{
    match k {
        Zero => λ a h => false_elim(Nat::not_succ_le_zero(m(a), h)),
        Succ(j) => λ a h => trans(fe(a), trans(ext(a, λ b _ => f(b), λ b _ => g(b),
            λ b p => fixpoint_unique_within(m, F, ext, f, g, fe, ge, j, b, Nat::lt_of_lt_of_le(m(b), m(a), j, p, h))), sym(ge(a)))),
    }
}

// Two fixpoints of one step are equal at every argument.
theorem fixpoint_unique<A, B>(m: A → Nat, F: (a: A) → ((b: A) → m(b) < m(a) → B) → B, ext: FixpointExt(m, F), f, g: A → B,
    fe: (a: A) → f(a) = F(a, λ b _ => f(b)), ge: (a: A) → g(a) = F(a, λ b _ => g(b)), a: A): f(a) = g(a)
{
    fixpoint_unique_within(m, F, ext, f, g, fe, ge, m(a) + 1, a, Nat::lt_succ_self(m(a)))
}

// A loop's step as a recursion's: a pass that goes round answers with the
// recursion at the next state, which its `less` puts below.
fn Loop::fix<S, R>(self l: Loop<S, R>) → (s: S) → ((t: S) → l.measure(t) < l.measure(s) → R) → R {
    λ s rec => match l.step(s) { Again(b) => rec(b.next, b.less.recover()), Done(r) => r }
}

theorem Loop::fix_ext<S, R>(self l: Loop<S, R>): FixpointExt(l.measure, l.fix()) {
    λ s h1 h2 same => match l.step(s) as λ p =>
        (match p { Again(b) => h1(b.next, b.less.recover()), Done(r) => r }) = (match p { Again(b) => h2(b.next, b.less.recover()), Done(r) => r }) {
        Again(b) => same(b.next, b.less.recover()),
        Done(_) => refl,
    }
}

// A function that answers as the loop does at every pass is the loop: how
// a recursion that calls itself last is read as a loop, from its own
// unfolding equation. The case of `fixpoint_unique` at the loop's step.
theorem Loop::unique<S, R>(self l: Loop<S, R>, g: S → R,
    same: (s: S) → g(s) = (match l.step(s) { Again(b) => g(b.next), Done(r) => r }), s: S): g(s) = l.run(s)
{
    fixpoint_unique(l.measure, l.fix(), l.fix_ext(), g, λ t => l.run(t), same, λ t => l.run_unfold(t), s)
}

// ---------------------------------------------------------------------------
// The same loop with its proofs taken out, as a `runtime fn` runs it
// (docs/language/loop-combinator-design.md §6.2): a pass goes round at the
// next state or stops at one, and the passes are counted by a fuel instead
// of bounded by the measure. Running out answers the state it got to, so no
// value is invented. `Loop::steps_stays` is why the fuel never runs out
// where the measure is at most it.

inductive Step<S> {
    Next(s: S),
    Stop(s: S),
}

// A `while` loop's pass: while `go` holds, round again at `next`, which
// may read that it does (an index the test bounds); else stop at the state
// `s` itself. The `match` is the one a `match h: go` writes, so a step the
// elaborator spells that way is this by conversion.
fn Step::turn<S>(go: Bool, next: (go = True) → S, s: S) → Step<S> {
    (match go as λ b => (go = b) → Step<S> { False => λ _ => Stop(s), True => λ e => Next(next(e)) })(refl)
}

// A turn whose next state does not read the test's equation.
fn Step::when<S>(go: Bool, next: S, s: S) → Step<S> { Step::turn(go, λ _ => next, s) }

// A step that stops stops where it is.
fn Step::Stays<S>(s: S, q: Step<S>) → Type {
    match q { Next(_) => True, Stop(r) => r = s }
}

// How many passes a `while` loop is given: `2^64 - 1`, the most a 64-bit
// count reaches, and at least every measure that is a 64-bit word's
// `toNat`. A name, not a numeral: two loops given it compare at their
// `Loop::steps` without either being unrolled pass by pass, which a
// numeral's would be wherever a field read forces the loop's state.
fn Loop::passes() → Nat { 18446744073709551615 }

// `Step::turn` stops where it is.
theorem Step::turn_stays<S>(go: Bool, next: (go = True) → S, s: S): Step::Stays(s, Step::turn(go, next, s)) {
    (match go as λ b => (e: go = b) → Step::Stays(s, (match b as λ b2 => (go = b2) → Step<S> { False => λ _ => Stop(s), True => λ e2 => Next(next(e2)) })(e))
    { False => λ _ => refl, True => λ _ => trivial })(refl)
}

fn Loop::steps<S>(fuel: Nat, step: S → Step<S>, s: S) → S {
    match fuel {
        Zero => s,
        Succ(k) => match step(s) { Next(t) => Loop::steps(k, step, t), Stop(r) => r },
    }
}

// Two steps that agree at every state iterate alike: what lets a loop's
// meaning ignore what its step does not read.
theorem Loop::steps_ext<S>(f1, f2: S → Step<S>, same: (s: S) → f1(s) = f2(s), k: Nat): (s: S) → Loop::steps(k, f1, s) = Loop::steps(k, f2, s) {
    match k {
        Zero => λ s => refl,
        Succ(i) => λ s => {
            let ran = λ (q: Step<S>) => match q { Next(t) => Loop::steps(i, f1, t), Stop(r) => r };
            trans(j(same(s), λ q _ => ran(f1(s)) = ran(q), refl),
            match f2(s) as λ q => ran(q) = (match q { Next(t) => Loop::steps(i, f2, t), Stop(r) => r }) {
                Next(t) => Loop::steps_ext(f1, f2, same, i, t),
                Stop(_) => refl,
            })
        },
    }
}

// A pass of a loop read without its proofs.
fn Pass::step<S>(m: S → Nat, s: S, self p: Pass<S, S>(m, s)) → Step<S> {
    match p { Again(b) => Next(b.next), Done(r) => Stop(r) }
}

// A pass split on one test: round again where it holds, with the next
// state and its decrease found under it, else leave where it is. What a
// `while` over a span is stepped by (crates/elab/src/loops.rs,
// `lift_steps_over`): its body's found proofs read the test's equation,
// so the pass and the loop's `Step::turn` are one split, proved once here.
fn Pass::of_turn<S>(m: S → Nat, s: S, go: Bool, next: (go = True) → Lower<S>(m, s)) → Pass<S, S>(m, s) {
    (match go as λ b => (go = b) → Pass<S, S>(m, s) { False => λ _ => Done(s), True => λ e => Again(next(e)) })(refl)
}

theorem Pass::step_of_turn<S>(m: S → Nat, s: S, go: Bool, next: (go = True) → Lower<S>(m, s)):
    Pass::step(m, s, Pass::of_turn(m, s, go, next)) = Step::turn(go, λ e => next(e).next, s) {
    (match go as λ b => (e: go = b) →
        Pass::step(m, s, (match b as λ b2 => (go = b2) → Pass<S, S>(m, s) { False => λ _ => Done(s), True => λ e2 => Again(next(e2)) })(e))
            = (match b as λ b2 => (go = b2) → Step<S> { False => λ _ => Stop(s), True => λ e2 => Next(next(e2).next) })(e)
    { False => λ _ => refl, True => λ _ => refl })(refl)
}

// A loop whose stops are where it is needs no pass past its measure: with
// the measure at most the fuel, the passes that go round are at most the
// fuel, and the one that stops answers the state it was given, as running
// out does. What a `while` loop is rewritten by (`Loop::passes()` is the
// most a 64-bit count reaches, and a measure that is a word's `toNat` is at
// most it).
theorem Loop::steps_stays<S>(self l: Loop<S, S>, step: S → Step<S>, same: (s: S) → Pass::step(l.measure, s, l.step(s)) = step(s),
    stays: (s: S) → Step::Stays(s, step(s)), k: Nat): (s: S) → l.measure(s) <= k → Loop::steps(k, step, s) = l.run(s) {
    match k {
        Zero => λ s h => trans((match l.step(s) as λ p => Step::Stays(s, Pass::step(l.measure, s, p)) →
                s = (match p { Again(b) => l.run(b.next), Done(r) => r }) {
                Again(b) => λ _ => false_elim(Nat::not_succ_le_zero(l.measure(b.next), Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), 0, b.less.recover(), h))),
                Done(r) => λ e => sym(e),
            })(j(sym(same(s)), λ q _ => Step::Stays(s, q), stays(s))), sym(l.run_unfold(s))),
        Succ(j) => λ s h => {
            let ran = λ (q: Step<S>) => match q { Next(t) => Loop::steps(j, step, t), Stop(r) => r };
            trans(rewrite(sym(same(s)), refl), trans(match l.step(s) as λ p =>
                ran(Pass::step(l.measure, s, p)) = (match p { Again(b) => l.run(b.next), Done(r) => r }) {
                Again(b) => Loop::steps_stays(l, step, same, stays, j, b.next, Nat::lt_of_lt_of_le(l.measure(b.next), l.measure(s), j + 1, b.less.recover(), h)),
                Done(_) => refl,
            }, sym(l.run_unfold(s))))
        },
    }
}

// A step's state read through `f`.
fn Step::map<S, T>(f: S → T, self q: Step<S>) → Step<T> {
    match q { Next(s) => Next(f(s)), Stop(s) => Stop(f(s)) }
}

// A `while` pass read through `f` is the pass over the states `f` reads,
// where the two go round to states `f` relates.
theorem Step::turn_map<S, T>(f: S → T, go: Bool, next1: (go = True) → S, next2: (go = True) → T,
    same: (e: go = True) → f(next1(e)) = next2(e), s: S): Step::turn(go, next1, s).map(f) = Step::turn(go, next2, f(s)) {
    (match go as λ b => (e: go = b) →
        Step::map(f, (match b as λ b2 => (go = b2) → Step<S> { False => λ _ => Stop(s), True => λ e2 => Next(next1(e2)) })(e)) =
        (match b as λ b2 => (go = b2) → Step<T> { False => λ _ => Stop(f(s)), True => λ e2 => Next(next2(e2)) })(e)
    { False => λ _ => refl, True => λ e => j(same(e), λ t _ => Step::Next(f(next1(e))) = Step::Next(t), refl) })(refl)
}

// A loop simulated through `f`: where each pass read through `f` is the
// other loop's pass at the state `f` reads, the two iterate alike. What a
// loop's second meaning (over a record, forgetting facts) is proved by,
// once.
theorem Loop::steps_map<S, T>(f: S → T, s1: S → Step<S>, s2: T → Step<T>, commute: (s: S) → s1(s).map(f) = s2(f(s)), k: Nat):
    (s: S) → f(Loop::steps(k, s1, s)) = Loop::steps(k, s2, f(s)) {
    match k {
        Zero => λ s => refl,
        Succ(i) => λ s => {
            let ran2 = λ (q: Step<T>) => match q { Next(t) => Loop::steps(i, s2, t), Stop(r) => r };
            trans(match s1(s) as λ q => f(match q { Next(t) => Loop::steps(i, s1, t), Stop(r) => r }) = ran2(q.map(f)) {
                    Next(t) => Loop::steps_map(f, s1, s2, commute, i, t),
                    Stop(_) => refl,
                }, j(commute(s), λ q _ => ran2(s1(s).map(f)) = ran2(q), refl))
        },
    }
}

// What a loop that threads a span goes on with: its span and its state,
// handed to `k`. A name of its own so that a loop's written continuation
// and a meaning's are one application, compared without reading the
// loop's run as a pair, which would run it.
fn Loop::after<S, R, T>(m: Mutated<S, R>, k: S → R → T) → T { k(m.after, m.value) }

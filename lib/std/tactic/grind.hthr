// `grind`: congruence closure over the goal's equations and the lemmas it
// instantiates, with a certified proof when it closes the goal and the state
// it built when it does not (issues/grind-port.md, docs/grind-design.md).
//
// `by grind()` proves an equation `l = r` from the equations among the goal's
// locals; `by grind_with([e, …])` adds the equations the terms `e` prove
// (a lemma at its instance, `List::append_nil(xs)`, or a local's
// consequence, `h(3)`), and `by grind_using(["List::append_assoc"], [e, …])`
// adds lemmas by name. The tactic builds an e-graph: every term the
// equations and the goal mention, its subterms, and their classes under the
// equations closed by congruence (`f(a) = g(b)` once `f = g` and `a = b`).
// An equation under binders (a local, a hint or a named lemma) is a lemma:
// one side is read as a pattern, and each of its matches among the graph's
// terms, up to the classes, adds the lemma at that instance, in rounds,
// until the goal closes or no new instance turns up (e-matching,
// docs/grind-design.md §9). Every side of a lemma that can be a pattern is
// one, and a pattern's argument may match up to a definitional step: where
// `a + isucc(b)` meets `a + OfNat(Succ(k))`, `Defeq` finds `b := OfNat(k)`
// among the graph's terms, and the instance comes with the edge
// `isucc(OfNat(k)) = OfNat(Succ(k))` by `refl` (§13). Several binders the
// argument alone binds are asked about with holes, and their solutions
// looked up among the graph's nodes (`Cons(?x, ?ys)` against `[a] ++ xs`,
// §13.4). `grind_report` also
// says, on success, which hints the proof cites.
//
// Terms are read as the kernel has them, a head applied to arguments
// (`Spine`): an argument the function's type is dependent at (a type
// argument) is part of the head and compared as it is, every other one is a
// position congruence reads. A constructor value is read as its constructor
// applied to its fields. A term read no further is an atom, and two atoms
// are one node when they are the same global, local or literal, or are
// definitionally equal (`Defeq`).
//
// When the two sides land in one class, the proof is the path between them in
// the graph: each step is an equation it was given (or its `sym`) or a
// congruence (`cong`, `congr_fun`, `congr` below, over the explanations of
// the steps' parts), joined by `trans`. The kernel checks the term at the
// `by`; the graph is never trusted. The graph is the e-graph library's
// (`lib/std/data/egraph.hthr`) over grind's operators, and the proof its
// explanation folded through `proof_alg`.
//
// When they do not, the failure is the graph itself: the class of each side,
// every class of more than one term with its members, which locals were
// read as equations and which were not, and each lemma's matches. One
// equation between a member of each side's class closes the goal; the
// report is there so a reader (a person, or a model at the hint interface)
// can name it and rerun with it as a hint.
//
// A lemma's binder neither side binds and nothing depends on is a premise
// (`hit: same(a, x) = True`, `h: i < n`), proved at each instance: an
// equation by the graph, any premise by a local or a hint that is no
// equation (`Defeq`), or by the instance search (`Synth`); an instance whose
// premise is not proved waits and is tried again after later rounds
// (docs/grind-design.md §11).
//
// Not yet: case splits, constructor injectivity and disjointness,
// disequalities, and relations other than `=`. Each is a later round of
// docs/grind-design.md §6.

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;
import tactic;
import derive;
import pair;
import egraph;

// Congruence of an application in both places, and in the function alone.
// (`cong`, the prelude's, is the argument alone.)
theorem congr<A, B>({f: A → B}, {g: A → B}, {a: A}, {b: A}, hf: f = g, ha: a = b): f(a) = g(b) {
    j(hf, λ h q => f(a) = h(b), j(ha, λ y q => f(a) = f(y), refl))
}

theorem congr_fun<A, B>({f: A → B}, {g: A → B}, {a: A}, hf: f = g): f(a) = g(a) {
    j(hf, λ h q => f(a) = h(a), refl)
}

// Any equation from a contradiction, its sides given; anything from one;
// and the successor's injectivity. grind's own, so that a module using
// grind need not import the modules that state them (a law is resolved
// where the `by` is).
theorem exfalso<A>(x: A, y: A, h: False): x = y { false_elim(h) }

theorem elim_false<P>(h: False): P { false_elim(h) }

theorem succ_inj(n: Nat, m: Nat, h: Succ(n) = Succ(m)): n = m { Nat::succ_inj(n, m, h) }

// ---------------------------------------------------------------------------
// The graph: an e-graph of the library (`lib/std/data/egraph.hthr`) over
// grind's operators, with what grind keeps beside each node.

// How an atom is compared: by the global, local or literal it is (decided
// here), or, for a constructor function and any other term, by `Defeq`
// against the atoms of the same key. `KSucc` is `Nat`'s successor, by the
// reference `Lookup("Succ")` answers: the graph's first atom, `succ_fn`,
// which a `Succ(n)` is read as applied to `n` (§14).
inductive AtomKey { KGlobal(id: Nat), KLocal(id: Nat), KLit(n: Nat), KCtor(ty: Nat, i: Nat), KSucc(id: Nat), KOther }

// The operators: atom number `n` (atoms are told apart here, so the graph
// sees each as an operator of its own); a function applied to an argument,
// the node's two children; and a function applied to an argument its type
// is dependent at, which is part of the operator (`arg`, a node) so that
// congruence reads only the function.
inductive GOp { GAtomOp(n: Nat), GAppOp, GDepOp(arg: Nat) }

fn gop_same(a: GOp, b: GOp) → Bool {
    match a {
        GAtomOp(n) => match b { GAtomOp(m) => n.same(m), _ => False },
        GAppOp => match b { GAppOp => True, _ => False },
        GDepOp(x) => match b { GDepOp(y) => x.same(y), _ => False },
    }
}

// The operators of a lemma's pattern: an atom of a key (a global, local,
// literal or constructor; a term compared only by `Defeq` is a wildcard in
// a pattern), an application, and an application to a dependent argument,
// whose argument (part of the graph's operator) binds variable `v`.
inductive GQ { QKey(key: AtomKey), QApp, QDep(v: Nat) }

// An equation given: its proof, its name for the report, and the names the
// proofs of its premises cite (a lemma's instance; `[]` for any other).
record Fact { proof: Expr, name: String, uses: List<String> }

// Beside each node: the term as a tactic cites it, and whether it is a term
// the equations or the goal mention (a partial application inside one is
// not, and is left out of the report).
record GInfo { expr: Expr, whole: Bool }

// An atom: how it is compared, its handle, and its node.
record AtomEntry { key: AtomKey, h: Handle, node: Nat }

record Graph { eg: EGraph<GOp, Fact>, info: List<GInfo>, atoms: List<AtomEntry> }

record Interned { g: Graph, node: Nat }

// One side of a lemma read as a pattern (its variables the binders, then
// one wildcard per subterm the pattern does not read): whether it is the
// left side, each item's subterm where it is a whole one, and which items a
// near match may leave to `Defeq` (an application in an argument position).
record LPat { pat: Pattern<GQ>, left: Bool, terms: List<Option<Handle>>, slack: List<Bool> }

// A near match tried (docs/grind-design.md §13): the pattern, the item left
// and the node it met, the nodes the binders met, how many of the graph's
// nodes were tried as the item's one free binder, and whether the item was
// asked about with holes at its free binders (§13.4). `Defeq` reads terms,
// not classes, so a question that failed fails again.
record NearTried { pat: Nat, item: Nat, node: Nat, args: List<Option<Nat>>, upto: Nat, asked: Bool }

// A lemma: an equation under binders, its proof, the patterns its instances
// are found by (each side that binds every binder something depends on),
// and its binders' locals (the patterns' terms are under them). A binder a
// pattern does not bind is a premise, proved at each instance. `matched`,
// `added` and `defined` count its matches, the instances added and the ones
// of those found up to a definitional step, for the report; `tried` is the
// near matches tried.
record Lemma { name: String, proof: Expr, binders: Nat, premises: Nat, pats: List<LPat>, refs: List<LocalRef>, matched: Nat, added: Nat, defined: Nat, tried: List<NearTried> }

// Where an instance found by a near match meets the node it was matched
// against by `Defeq`: the instance's side the pattern is (`left`), the path
// from that side's node down to the item left, and the node.
record DefAt { left: Bool, path: List<Nat>, node: Nat }

// An instance tried: the lemma's number, the nodes its binders met (`None`
// at a premise), and, for one a near match found, its definitional step.
record Inst { lemma: Nat, args: List<Option<Nat>>, def: Option<DefAt> }

// An instance waiting on a premise not proved yet, and the note that says
// which: it is tried again after each round that adds instances, since an
// equation the graph did not have may be there by then.
record Pend { inst: Inst, note: Note }

// A hint that is no equation: a fact a premise may be (`i < n`, or a
// derived `Succ(a).le_trans(b, c, first, bc)`), by its proof, name and type.
record Given { proof: Expr, name: String, ty: Handle }

// Two nodes: a disequality's sides, or two constructor values of one class.
record Node2 { a: Nat, b: Nat }

// A disequality read (`h: a ≠ b`, `h: a = b → False`): its proof, its
// name, its two sides as written and their nodes. Two members of one class
// that a disequality separates are a contradiction (docs/grind-design.md
// §14).
record Diseq { proof: Expr, name: String, lhs: Handle, rhs: Handle, sides: Node2 }

// What constructors and disequalities have given (docs/grind-design.md §14):
// the type `False`, `Succ`'s reference, the goal a disjointness proves (under the binders the
// goal opened), the disequalities read, the pairs of constructor values of
// one class already taken apart by injectivity or asked about for
// disjointness (each a host question), how many field equations
// injectivity added, and the contradiction found: its proof, the names it
// cites, and whether it proves `False` (a disequality's) or the goal
// (`absurd`'s).
record Contra { proof: Expr, uses: List<String>, of_false: Bool }

record CState { fals: GlobalRef, succ: Nat, target: Handle, diseqs: List<Diseq>, done: List<Node2>, injected: Nat, contra: Option<Contra> }

fn cstate_empty(fals: GlobalRef, succ: Nat, target: Handle) → CState { CState(fals, succ, target, [], [], 0, None) }

// The graph with the facts read: a note for each equation read or set aside,
// the names of the locals that are no equation, the lemmas to instantiate,
// the instances tried, the names of the hints given (for the report of
// which ones the proof used), the goal's locals and the hints that are no
// equation (a premise may be one), and the instances waiting on a premise.
record Facts { g: Graph, read: List<Note>, skipped: List<String>, lemmas: List<Lemma>, seen: List<Inst>, offered: List<String>, locals: List<LocalInfo>, givens: List<Given>, pending: List<Pend>, cf: CState }

fn with_graph(fs: Facts, g: Graph) → Facts { Facts(g, fs.read, fs.skipped, fs.lemmas, fs.seen, fs.offered, fs.locals, fs.givens, fs.pending, fs.cf) }

fn with_cf(fs: Facts, cf: CState) → Facts { Facts(fs.g, fs.read, fs.skipped, fs.lemmas, fs.seen, fs.offered, fs.locals, fs.givens, fs.pending, cf) }

fn with_pending(fs: Facts, ps: List<Pend>) → Facts { Facts(fs.g, fs.read, fs.skipped, fs.lemmas, fs.seen, fs.offered, fs.locals, fs.givens, ps, fs.cf) }

fn graph_empty() → Graph { Graph(EGraph::empty<GOp, Fact>(), [], []) }

// `Nat`'s successor as a function, so that `Succ(n)` is an application the
// graph closes under congruence and takes apart by injectivity (§14).
fn succ_fn(n: Nat) → Nat { Succ(n) }

fn class_of(g: Graph, i: Nat) → Nat { g.eg.find(i) }

fn expr_at(g: Graph, i: Nat) → Expr {
    match g.info.nth(i) { Some(n) => n.expr, None => NatLit(0) }
}

// Mark node `i` as the term `h`, mentioned whole: the report and the proof
// cite it by `h`, as it was written, rather than by the node's structure.
fn mark_whole(g: Graph, i: Nat, h: Handle) → Graph {
    Graph(g.eg, g.info.update(i, λ n => GInfo(Hd(h), True)), g.atoms)
}

// The graph after an `add`: a new node gets its information.
fn with_added(g: Graph, a: Added<GOp, Fact>, e: Expr) → Interned {
    match a.id.same(g.info.len()) {
        True => Interned(Graph(a.g, g.info ++ [GInfo(e, False)], g.atoms), a.id),
        False => Interned(Graph(a.g, g.info, g.atoms), a.id),
    }
}

// The node of `f` applied to `a`, made once.
fn app_node(g: Graph, f: Nat, a: Nat, dependent: Bool) → Interned {
    let e = App(expr_at(g, f), expr_at(g, a));
    match dependent {
        False => with_added(g, g.eg.add(gop_same, GAppOp, [f, a]), e),
        True => with_added(g, g.eg.add(gop_same, GDepOp(a), [f]), e),
    }
}

fn new_atom(g: Graph, h: Handle, key: AtomKey) → Interned {
    let a = g.eg.fresh(GAtomOp(g.atoms.len()), []);
    Interned(Graph(a.g, g.info ++ [GInfo(Hd(h), False)], g.atoms ++ [AtomEntry(key, h, a.id)]), a.id)
}

// The graph a run starts from: `succ_fn` (handle `sh`) its first atom, for
// `Succ`, whose reference is `succ`.
fn graph_seeded(succ: Nat, sh: Handle) → Graph { new_atom(graph_empty(), sh, KSucc(succ)).g }

// The node of `succ_fn`, when `v` is `Succ(p)`: the first atom.
fn succ_node(g: Graph, v: Head) → Option<Pair<Nat, Handle>> {
    match v {
        HGlobal(r, _, args) => match args {
            Cons(p, rest) => match rest {
                Cons(_, _) => None,
                Nil => match g.atoms.nth(0) {
                    None => None,
                    Some(e) => match e.key { KSucc(id) => match id.same(r.id) { True => Some(Pair(e.node, p)), False => None }, _ => None },
                },
            },
            Nil => None,
        },
        _ => None,
    }
}

// Two keys: `Some(b)` when the keys decide whether the atoms are one, `None`
// when `Defeq` does.
fn key_decides(a: AtomKey, b: AtomKey) → Option<Bool> {
    match a {
        KGlobal(x) => match b { KGlobal(y) => Some(x.same(y)), _ => Some(False) },
        KLocal(x) => match b { KLocal(y) => Some(x.same(y)), _ => Some(False) },
        KLit(x) => match b { KLit(y) => Some(x.same(y)), _ => Some(False) },
        KCtor(t, i) => match b { KCtor(u, k) => match t.same(u).and(i.same(k)) { True => None, False => Some(False) }, _ => Some(False) },
        KSucc(x) => match b { KSucc(y) => Some(x.same(y)), _ => Some(False) },
        KOther => match b { KOther => None, _ => Some(False) },
    }
}

// The atom an atom of `key` is decided to be, and the atoms `Defeq` has to
// compare it with.
record AtomSearch { found: Option<Nat>, ask: List<Nat> }

fn atom_search(es: List<AtomEntry>, key: AtomKey, h: Handle, ask: List<Nat>) → AtomSearch {
    match es {
        Nil => AtomSearch(None, ask),
        Cons(e, rest) => match key_decides(key, e.key) {
            Some(b) => match b {
                True => AtomSearch(Some(e.node), []),
                False => atom_search(rest, key, h, ask),
            },
            None => match h.id.same(e.h.id) {
                True => AtomSearch(Some(e.node), []),
                False => atom_search(rest, key, h, ask ++ [e.node]),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Proofs: the library's explanation, folded into terms.

// The lemmas a proof cites.
record GrindLaws { trans: GlobalRef, sym: GlobalRef, cong: GlobalRef, congr: GlobalRef, congr_fun: GlobalRef, rfl: GlobalRef, defn: GlobalRef, fals: GlobalRef, false_elim: GlobalRef, exfalso: GlobalRef, succ_inj: GlobalRef }

fn sym_of(l: GrindLaws, p: Expr) → Expr { apps(Global(l.sym), [Blank, Blank, Blank, p]) }

fn trans_of(l: GrindLaws, p: Expr, q: Expr) → Expr { apps(Global(l.trans), [Blank, Blank, Blank, Blank, p, q]) }

fn rfl_of(l: GrindLaws, e: Expr) → Expr { apps(Global(l.rfl), [Blank, e]) }

// `x = y` where the two are one by computation: `refl`, at that type.
fn defn_of(l: GrindLaws, x: Expr, y: Expr) → Expr { apps(Global(l.defn), [Blank, x, y, rfl_of(l, x)]) }

// `p`, a proof of an equation between terms convertible with `x` and `y`,
// stated as `x = y`.
fn cast_of(l: GrindLaws, x: Expr, y: Expr, p: Expr) → Expr { apps(Global(l.defn), [Blank, x, y, p]) }

fn given_of(l: GrindLaws, f: Fact, forward: Bool) → Expr {
    match forward { True => f.proof, False => sym_of(l, f.proof) }
}

// Congruence of node `from` and node `to` from their children's evidence:
// `cong` when the functions are one node, `congr_fun` when the arguments
// are (or the argument is part of the operator), `congr` otherwise. The
// functions and arguments are passed explicitly: as holes, an equation
// between partial applications does not unify (docs/grind-design.md §7).
fn cong_of(l: GrindLaws, g: Graph, from: Nat, ks: List<KidProof<Expr>>) → Expr {
    match ks {
        Nil => NatLit(0),
        Cons(kf, rest) => match rest {
            Nil => match g.eg.node(from) {
                Some(n) => match n.op {
                    GDepOp(x) => apps(Global(l.congr_fun), [Blank, Blank, expr_at(g, kf.from), expr_at(g, kf.to), expr_at(g, x), kf.proof]),
                    _ => NatLit(0),
                },
                None => NatLit(0),
            },
            Cons(ka, _) => match kf.from.same(kf.to) {
                True => apps(Global(l.cong), [Blank, Blank, expr_at(g, kf.from), Blank, Blank, ka.proof]),
                False => match ka.from.same(ka.to) {
                    True => apps(Global(l.congr_fun), [Blank, Blank, expr_at(g, kf.from), expr_at(g, kf.to), expr_at(g, ka.from), kf.proof]),
                    False => apps(Global(l.congr), [Blank, Blank, expr_at(g, kf.from), expr_at(g, kf.to), expr_at(g, ka.from), expr_at(g, ka.to), kf.proof, ka.proof]),
                },
            },
        },
    }
}

fn proof_alg(l: GrindLaws, g: Graph) → PathAlg<Fact, Expr> {
    PathAlg(λ n => rfl_of(l, expr_at(g, n)), λ f fwd => given_of(l, f, fwd), λ from _ ks => cong_of(l, g, from, ks), λ p q => trans_of(l, p, q))
}

// ---------------------------------------------------------------------------
// The report when the sides are not in one class.

fn grind_num(n: Nat) → String { "#" ++ decimal_name(Succ(n), n) }

// The whole terms among nodes `ms`, as cited.
fn whole_of(g: Graph, ms: List<Nat>) → List<Expr> {
    match ms {
        Nil => [],
        Cons(m, rest) => match g.info.nth(m) {
            Some(n) => match n.whole { True => Cons(n.expr, whole_of(g, rest)), False => whole_of(g, rest) },
            None => whole_of(g, rest),
        },
    }
}

fn member_notes(es: List<Expr>, c: String) → List<Note> {
    match es {
        Nil => [],
        Cons(e, rest) => Cons(Under(At(e, Tried("member", "of class " ++ c))), member_notes(rest, c)),
    }
}

fn exprs_count(es: List<Expr>) → Nat { match es { Nil => 0, Cons(_, rest) => Succ(exprs_count(rest)) } }

// Every class of more than one whole term, by its representative, from the
// graph's class table (`rows`, class `c` first): one pass, where reading
// each class's members off the class list would be cubic in the nodes.
fn class_notes(g: Graph, rows: List<List<Nat>>, c: Nat) → List<Note> {
    match rows {
        Nil => [],
        Cons(ms, rest) => {
            let ws = whole_of(g, ms);
            let n = exprs_count(ws);
            match n {
                Zero => class_notes(g, rest, Succ(c)),
                Succ(k) => match k {
                    Zero => class_notes(g, rest, Succ(c)),
                    Succ(_) => Cons(Tried("class " ++ grind_num(c), decimal_name(Succ(n), n) ++ " terms"), member_notes(ws, grind_num(c)))
                        ++ class_notes(g, rest, Succ(c)),
                },
            }
        },
    }
}

// The names of the locals that are not equations, as one line.
fn names_line(ns: List<String>) → String {
    match ns {
        Nil => "",
        Cons(n, rest) => match rest { Nil => n, Cons(_, _) => n ++ ", " ++ names_line(rest) },
    }
}

fn stuck_notes(g: Graph, l: Nat, r: Nat, fs: Facts) → List<Note> {
    let cl = grind_num(class_of(g, l));
    let cr = grind_num(class_of(g, r));
    let skipped: List<Note> = match fs.skipped { Nil => [], Cons(_, _) => [Tried("not equations, not read", names_line(fs.skipped))] };
    Cons(At(expr_at(g, l), Tried("the left side", "in class " ++ cl)),
    Cons(At(expr_at(g, r), Tried("the right side", "in class " ++ cr)),
        class_notes(g, g.eg.class_table(), 0) ++ fs.read ++ skipped
            ++ [Tried("to close it", "one more equation between a member of " ++ cl ++ " and a member of " ++ cr ++ ", as a hint: `grind_with([…])`")]))
}

// ---------------------------------------------------------------------------
// Reading terms into the graph.

fn atom_key(v: Head) → AtomKey {
    match v {
        HGlobal(g, _, args) => match args { Nil => KGlobal(g.id), Cons(_, _) => KOther },
        HLocal(x, args) => match args { Nil => KLocal(x.id), Cons(_, _) => KOther },
        HLit(n) => KLit(n),
        _ => KOther,
    }
}

// The first of `ask` that `Defeq` finds is `h`.
fn atom_among(g: Graph, h: Handle, ask: List<Nat>) → Tac<Option<Nat>> {
    match ask {
        Nil => Pure(None),
        Cons(i, rest) => defeq(Hd(h), expr_at(g, i)).bind(λ same => match same {
            True => Pure(Some(i)),
            False => atom_among(g, h, rest),
        }),
    }
}

// The atom node of `h`, read under `key`.
fn atom(g: Graph, h: Handle, key: AtomKey) → Tac<Interned> {
    let s = atom_search(g.atoms, key, h, []);
    match s.found {
        Some(i) => Pure(Interned(g, i)),
        None => atom_among(g, h, s.ask).bind(λ o => match o {
            Some(i) => Pure(Interned(g, i)),
            None => Pure(new_atom(g, h, key)),
        }),
    }
}

// The fields of a constructor value, as arguments of its function.
fn field_args(hs: List<Handle>) → List<SpineArg> {
    match hs { Nil => [], Cons(h, rest) => Cons(SpineArg(h, False), field_args(rest)) }
}

// A term read, marked as one the equations or the goal mention.
fn whole(h: Handle, t: Tac<Interned>) → Tac<Interned> { t.bind(λ r => Pure(Interned(mark_whole(r.g, r.node, h), r.node))) }

fn then(t: Tac<Interned>, k: Interned → Tac<Interned>) → Tac<Interned> { t.bind(k) }

// A term; a term read by its spine, which, when `reduce`, is put in head
// normal form if it would otherwise be an atom compared only by `Defeq`
// (§14.3); or the arguments still to apply to node `at`.
inductive Intern { ITerm(h: Handle), ISpine(h: Handle, reduce: Bool), IArgs(at: Nat, args: List<SpineArg>) }

// A constructor value's function, when `Ctors` builds one.
fn ctor_fn(cs: List<CtorInfo>, i: Nat) → Option<Handle> {
    match cs.nth(i) { None => None, Some(c) => c.ctor }
}

// How a term whose spine has no arguments is read: as its constructor's
// function applied to its fields, or as an atom.
inductive Leaf { LCtor(ty: Nat, i: Nat, fields: List<Handle>), LAtom(key: AtomKey) }

fn leaf_of(v: Head) → Leaf {
    match v {
        HCtor(ty, i, _, fields) => match fields { Nil => LAtom(KCtor(ty.id, i)), Cons(_, _) => LCtor(ty.id, i, fields) },
        _ => LAtom(atom_key(v)),
    }
}

fn ctor_leaf(g: Graph, h: Handle, ty: Nat, i: Nat) → Tac<Option<Interned>> {
    infer(Hd(h)).bind(λ c => match c {
        Refused(_) => Pure(None),
        Accepted(t) => ctors(t).bind(λ cs => match cs {
            Refused(_) => Pure(None),
            Accepted(infos) => match ctor_fn(infos, i) {
                None => Pure(None),
                Some(fh) => atom(g, fh, KCtor(ty, i)).bind(λ a => Pure(Some(a))),
            },
        }),
    })
}

fn intern(fuel: Nat, g: Graph, t: Intern) → Tac<Interned> {
    match fuel {
        Zero => fail("grind: a term nests deeper than the reader's fuel", []),
        Succ(f) => match t {
            ITerm(h) => whole(h, intern(f, g, ISpine(h, True))),
            ISpine(h, reduce) => spine(h).bind(λ c => match c {
                Accepted(sp) => match sp.args {
                    Cons(_, _) => view(sp.head).bind(λ v => atom(g, sp.head, atom_key(v))).bind(λ hd => intern(f, hd.g, IArgs(hd.node, sp.args))),
                    Nil => view(h).bind(λ v => match succ_node(g, v) {
                        Some(sp) => intern(f, g, IArgs(sp.fst, [SpineArg(sp.snd, False)])),
                        None => match leaf_of(v) {
                            LAtom(key) => match key {
                                KOther => match reduce {
                                    False => atom(g, h, KOther),
                                    True => whnf(h).bind(λ w => match w {
                                        Refused(_) => atom(g, h, KOther),
                                        Accepted(wh) => intern(f, g, ISpine(wh, False)),
                                    }),
                                },
                                _ => atom(g, h, key),
                            },
                            LCtor(ty, i, fields) => ctor_leaf(g, h, ty, i).bind(λ o => match o {
                                None => atom(g, h, KOther),
                                Some(fnode) => intern(f, fnode.g, IArgs(fnode.node, field_args(fields))),
                            }),
                        },
                    }),
                },
                Refused(_) => atom(g, h, KOther),
            }),
            IArgs(at, args) => match args {
                Nil => Pure(Interned(g, at)),
                Cons(a, rest) => then(match a.dependent {
                    True => view(a.arg).bind(λ v => atom(g, a.arg, atom_key(v))),
                    False => intern(f, g, ITerm(a.arg)),
                }, λ x => {
                    let n = app_node(x.g, at, x.node, a.dependent);
                    intern(f, n.g, IArgs(n.node, rest))
                }),
            },
        },
    }
}

fn read_term(g: Graph, h: Handle) → Tac<Interned> { intern(4096, g, ITerm(h)) }

// Is `ty` an equation under binders (`(n: Nat) → f(n) = n`)?
fn concludes_equation(fuel: Nat, ty: Handle) → Tac<Bool> {
    match fuel {
        Zero => Pure(False),
        Succ(f) => view(ty).bind(λ v => match v {
            HEq(_, _) => Pure(True),
            HPi(_) => open(ty, "_").bind(λ c => match c {
                Refused(_) => Pure(False),
                Accepted(o) => concludes_equation(f, o.body),
            }),
            _ => Pure(False),
        }),
    }
}

// The two sides of an equation, as written or once in head normal form.
fn sides_of(ty: Handle) → Tac<Option<Pair<Handle, Handle>>> {
    view(ty).bind(λ v => match v {
        HEq(l, r) => Pure(Some(Pair(l, r))),
        _ => whnf(ty).bind(λ c => match c {
            Refused(_) => Pure(None),
            Accepted(w) => view(w).bind(λ wv => match wv {
                HEq(l, r) => Pure(Some(Pair(l, r))),
                _ => Pure(None),
            }),
        }),
    })
}

// ---------------------------------------------------------------------------
// Lemmas: equations under binders, instantiated by e-matching.
//
// A lemma's type is opened binder by binder, and one side of its equation is
// read as a pattern (`Pattern<GQ>`, the e-graph library's) the way a term is
// read into the graph: a binder is a variable, a global, local, literal or
// constructor is an atom of its key, an application is `QApp` or `QDep`,
// and a term only `Defeq` could compare (a λ, a type built from a binder) is
// a wildcard. Its matches are the graph's terms that are instances of that
// side up to the classes; each new one is the lemma applied to the nodes
// its binders met, an equation like any other once the kernel's type of it
// is read.

// Does a pattern's atom of key `a` match the graph's atom of key `b`? A
// constructor matches at any instance of its type's parameters (they are
// bound elsewhere in the pattern, or by the instance's type).
fn key_same(a: AtomKey, b: AtomKey) → Bool {
    match a {
        KCtor(t, i) => match b { KCtor(u, k) => t.same(u).and(i.same(k)), _ => False },
        _ => match key_decides(a, b) { Some(x) => x, None => False },
    }
}

// Does pattern operator `q` match the graph's operator `op`?
fn gq_test(g: Graph, q: GQ, op: GOp, s: Subst) → Option<Subst> {
    match q {
        QKey(k) => match op {
            GAtomOp(n) => match g.atoms.nth(n) {
                None => None,
                Some(e) => match key_same(k, e.key) { True => Some(s), False => None },
            },
            _ => None,
        },
        QApp => match op { GAppOp => Some(s), _ => None },
        QDep(v) => match op { GDepOp(x) => g.eg.bind(s, v, x), _ => None },
    }
}

// A pattern being read: its items, its variables so far (the binders come
// first), the item just read, and, for each item that is a whole subterm
// of the side, that subterm (under the lemma's opened binders).
record PB { items: List<PItem<GQ>>, vars: Nat, at: Nat, terms: List<Option<Handle>> }

fn pb_push(b: PB, it: PItem<GQ>) → PB { PB(b.items ++ [it], b.vars, b.items.len(), b.terms ++ [None]) }

// A variable no binder is: what the pattern does not read.
fn pb_wild(b: PB) → PB { PB(b.items ++ [PVar(b.vars)], Succ(b.vars), b.items.len(), b.terms ++ [None]) }

// The item just read is the whole term `h`.
fn pb_term(b: PB, h: Handle) → PB { PB(b.items, b.vars, b.at, b.terms.update(b.at, λ _ => Some(h))) }

fn binder_index(xs: List<Nat>, id: Nat, i: Nat) → Option<Nat> {
    match xs { Nil => None, Cons(x, rest) => match x.same(id) { True => Some(i), False => binder_index(rest, id, Succ(i)) } }
}

fn pb_key(b: PB, k: AtomKey) → PB {
    match k { KOther => pb_wild(b), _ => pb_push(b, POp(QKey(k), [])) }
}

// A term with no arguments, read as a pattern item.
fn pat_leaf(b: PB, binders: List<Nat>, v: Head) → PB {
    match v {
        HLocal(x, args) => match args {
            Nil => match binder_index(binders, x.id, 0) { Some(k) => pb_push(b, PVar(k)), None => pb_key(b, KLocal(x.id)) },
            Cons(_, _) => pb_wild(b),
        },
        HCtor(ty, i, _, _) => pb_key(b, KCtor(ty.id, i)),
        _ => pb_key(b, atom_key(v)),
    }
}

// The variable a dependent argument binds: its binder's, or a wildcard.
record DepVar { b: PB, v: Nat }

fn dep_var(b: PB, binders: List<Nat>, v: Head) → DepVar {
    let wild = DepVar(PB(b.items, Succ(b.vars), b.at, b.terms), b.vars);
    match v {
        HLocal(x, args) => match args {
            Nil => match binder_index(binders, x.id, 0) { Some(k) => DepVar(b, k), None => wild },
            Cons(_, _) => wild,
        },
        _ => wild,
    }
}

// A term, or the arguments still to apply to the item just read.
inductive PRead { PTerm(h: Handle), PArgs(args: List<SpineArg>) }

fn pat_then(t: Tac<PB>, k: PB → Tac<PB>) → Tac<PB> { t.bind(k) }

fn pat_read(fuel: Nat, sc: Nat, binders: List<Nat>, b: PB, t: PRead) → Tac<PB> {
    match fuel {
        Zero => Pure(pb_wild(b)),
        Succ(f) => match t {
            PTerm(h) => pat_then(spine(h).bind(λ c => match c {
                Refused(_) => Pure(pb_wild(b)),
                Accepted(sp) => match sp.args {
                    Cons(_, _) => view(sp.head).bind(λ v => pat_read(f, sc, binders, pat_leaf(b, binders, v), PArgs(sp.args))),
                    Nil => view(h).bind(λ v => match v {
                        HCtor(ty, i, _, fields) => match fields {
                            Nil => Pure(pb_key(b, KCtor(ty.id, i))),
                            Cons(_, _) => pat_read(f, sc, binders, pb_key(b, KCtor(ty.id, i)), PArgs(field_args(fields))),
                        },
                        HGlobal(r, _, args) => match r.id.same(sc).and(args.len().same(1)) {
                            True => pat_read(f, sc, binders, pb_key(b, KSucc(sc)), PArgs(field_args(args))),
                            False => Pure(pat_leaf(b, binders, v)),
                        },
                        _ => Pure(pat_leaf(b, binders, v)),
                    }),
                },
            }), λ x => Pure(pb_term(x, h))),
            PArgs(args) => match args {
                Nil => Pure(b),
                Cons(a, rest) => {
                    let hd = b.at;
                    match a.dependent {
                        True => view(a.arg).bind(λ v => {
                            let d = dep_var(b, binders, v);
                            pat_read(f, sc, binders, pb_push(d.b, POp(QDep(d.v), [hd])), PArgs(rest))
                        }),
                        False => pat_then(pat_read(f, sc, binders, b, PTerm(a.arg)), λ x => pat_read(f, sc, binders, pb_push(x, POp(QApp, [hd, x.at])), PArgs(rest))),
                    }
                },
            },
        },
    }
}

// Does item list `is` bind variable `v`?
fn binds(is: List<PItem<GQ>>, v: Nat) → Bool {
    match is {
        Nil => False,
        Cons(it, rest) => match it {
            PVar(w) => w.same(v).or(binds(rest, v)),
            POp(q, _) => match q { QDep(w) => w.same(v).or(binds(rest, v)), _ => binds(rest, v) },
        },
    }
}

fn binds_below(is: List<PItem<GQ>>, n: Nat) → Bool {
    match n { Zero => True, Succ(k) => binds(is, k).and(binds_below(is, k)) }
}

// Does item list `is` bind every binder from number `k` on that something
// after it depends on (`deps`, one flag per binder)? One nothing depends on
// is a premise (`h: i < n`, `hit: same(a, x) = True`): it is proved at the
// instance rather than matched. A binder only a premise mentions (`∃`-like)
// is depended on and unbound, so the side is no pattern.
fn binds_needed(is: List<PItem<GQ>>, deps: List<Bool>, k: Nat) → Bool {
    match deps { Nil => True, Cons(d, rest) => d.not().or(binds(is, k)).and(binds_needed(is, rest, Succ(k))) }
}

// How many of the first `n` binders the items leave unbound: the premises.
fn unbound_count(is: List<PItem<GQ>>, n: Nat) → Nat {
    match n { Zero => 0, Succ(k) => match binds(is, k) { True => unbound_count(is, k), False => Succ(unbound_count(is, k)) } }
}

// A side is a pattern when it binds every binder something depends on and
// is more than one.
fn usable(b: PB, deps: List<Bool>) → Bool {
    let bare: Bool = match b.items.nth(b.at) { Some(it) => match it { PVar(_) => True, POp(_, _) => False }, None => True };
    bare.not().and(binds_needed(b.items, deps, 0))
}

// A lemma's binders opened, whether something after each depends on it, and
// the statement under them.
record Tele { ids: List<Nat>, deps: List<Bool>, body: Handle, refs: List<LocalRef> }

fn open_binders(fuel: Nat, ty: Handle, ids: List<Nat>, deps: List<Bool>, refs: List<LocalRef>) → Tac<Tele> {
    match fuel {
        Zero => Pure(Tele(ids, deps, ty, refs)),
        Succ(f) => view(ty).bind(λ v => match v {
            HPi(_) => open(ty, "x").bind(λ c => match c {
                Refused(_) => Pure(Tele(ids, deps, ty, refs)),
                Accepted(o) => open_binders(f, o.body, ids ++ [o.local.ref.id], deps ++ [o.dependent], refs ++ [o.local.ref]),
            }),
            _ => Pure(Tele(ids, deps, ty, refs)),
        }),
    }
}

fn read_pattern(sc: Nat, binders: List<Nat>, side: Handle) → Tac<PB> {
    pat_read(1024, sc, binders, PB([], binders.len(), 0, []), PTerm(side))
}

// The items that are arguments of an application.
fn arg_items(is: List<PItem<GQ>>) → List<Nat> {
    match is {
        Nil => [],
        Cons(it, rest) => match it {
            POp(q, ks) => match q {
                QApp => match ks.nth(1) { Some(a) => Cons(a, arg_items(rest)), None => arg_items(rest) },
                _ => arg_items(rest),
            },
            PVar(_) => arg_items(rest),
        },
    }
}

fn nat_in(xs: List<Nat>, n: Nat) → Bool { match xs { Nil => False, Cons(x, rest) => x.same(n).or(nat_in(rest, n)) } }

fn is_app_item(o: Option<PItem<GQ>>) → Bool {
    match o { Some(it) => match it { POp(q, _) => match q { QApp => True, _ => False }, PVar(_) => False }, None => False }
}

fn is_some_handle(o: Option<Option<Handle>>) → Bool { match o { Some(x) => match x { Some(_) => True, None => False }, None => False } }

// The items a near match may leave: whole applications in argument
// positions (`isucc(b)` in `a + isucc(b)`), never the root or a function.
fn slack_items(b: PB) → List<Bool> {
    let args = arg_items(b.items);
    List::range(b.items.len()).map(λ i => nat_in(args, i).and(is_app_item(b.items.nth(i))).and(is_some_handle(b.terms.nth(i))))
}

fn lpat_of(b: PB, left: Bool) → LPat { LPat(Pattern(b.items, b.at, b.vars), left, b.terms, slack_items(b)) }

fn lemma_at(name: String, proof: Expr, t: Tele, b: PB, ps: List<LPat>) → Lemma {
    Lemma(name, proof, t.ids.len(), unbound_count(b.items, t.ids.len()), ps, t.refs, 0, 0, 0, [])
}

// The lemma `proof : ty`, its patterns the sides that are one (`usable`):
// both, when both are, so that an instance is found from whichever side the
// graph holds (docs/grind-design.md §13); the binders the first leaves are
// its premises. `None` when neither side is a pattern.
fn lemma_of(sc: Nat, name: String, proof: Expr, ty: Handle) → Tac<Option<Lemma>> {
    open_binders(64, ty, [], [], []).bind(λ t => sides_of(t.body).bind(λ o => match o {
        None => Pure(None),
        Some(p) => read_pattern(sc, t.ids, p.fst).bind(λ lb => read_pattern(sc, t.ids, p.snd).bind(λ rb => Pure(match usable(lb, t.deps) {
            True => match usable(rb, t.deps) {
                True => Some(lemma_at(name, proof, t, lb, [lpat_of(lb, True), lpat_of(rb, False)])),
                False => Some(lemma_at(name, proof, t, lb, [lpat_of(lb, True)])),
            },
            False => match usable(rb, t.deps) {
                True => Some(lemma_at(name, proof, t, rb, [lpat_of(rb, False)])),
                False => None,
            },
        }))),
    }))
}

// ---------------------------------------------------------------------------
// Reading the facts.

fn facts_note(acc: Facts, n: Note) → Facts { Facts(acc.g, acc.read ++ [n], acc.skipped, acc.lemmas, acc.seen, acc.offered, acc.locals, acc.givens, acc.pending, acc.cf) }

// `n` things, as a count with its noun.
fn counted(n: Nat, one: String, many: String) → String {
    decimal_name(Succ(n), n) ++ " " ++ match n { Succ(Zero) => one, _ => many }
}

fn lemma_read(lm: Lemma) → String {
    match lm.premises {
        Zero => "a lemma, instantiated by matching",
        Succ(Zero) => "a lemma, instantiated by matching, its premise proved at each instance",
        Succ(_) => "a lemma, instantiated by matching, its " ++ decimal_name(Succ(lm.premises), lm.premises) ++ " premises proved at each instance",
    }
}

fn with_givens(fs: Facts, gs: List<Given>) → Facts { Facts(fs.g, fs.read, fs.skipped, fs.lemmas, fs.seen, fs.offered, fs.locals, gs, fs.pending, fs.cf) }

fn is_false_view(fals: GlobalRef, v: Head) → Bool {
    match v {
        HGlobal(g, _, args) => g.id.same(fals.id).and(match args { Nil => True, Cons(_, _) => False }),
        _ => False,
    }
}

// Is `h` the type `False`, as written or once in head normal form (a
// `Not(P)` exposes its codomain as a code)?
fn is_false(fals: GlobalRef, h: Handle) → Tac<Bool> {
    view(h).bind(λ v => match is_false_view(fals, v) {
        True => Pure(True),
        False => whnf(h).bind(λ c => match c {
            Refused(_) => Pure(False),
            Accepted(w) => view(w).bind(λ wv => Pure(is_false_view(fals, wv))),
        }),
    })
}

// The sides of `ty` when it is a disequality: `a = b → False`, as written
// or once in head normal form (`a ≠ b`, `Not(a = b)`).
fn negated(fals: GlobalRef, ty: Handle) → Tac<Option<Pair<Handle, Handle>>> {
    whnf(ty).bind(λ c => match c {
        Refused(_) => Pure(None),
        Accepted(w) => view(w).bind(λ v => match v {
            HPi(d) => sides_of(d).bind(λ o => match o {
                None => Pure(None),
                Some(p) => open(w, "_").bind(λ oc => match oc {
                    Refused(_) => Pure(None),
                    Accepted(op) => match op.dependent {
                        True => Pure(None),
                        False => is_false(fals, op.body).bind(λ f => Pure(match f { True => Some(p), False => None })),
                    },
                }),
            }),
            _ => Pure(None),
        }),
    })
}

// A disequality, its sides read into the graph and kept: two members of one
// class it separates are a contradiction. `None` for any other statement.
fn read_diseq(acc: Facts, proof: Expr, name: String, ty: Handle) → Tac<Option<Facts>> {
    negated(acc.cf.fals, ty).bind(λ o => match o {
        None => Pure(None),
        Some(p) => read_term(acc.g, p.fst).bind(λ x => read_term(x.g, p.snd).bind(λ y => {
            let cf = acc.cf;
            let d = Diseq(proof, name, p.fst, p.snd, Node2(x.node, y.node));
            Pure(Some(with_cf(facts_note(with_graph(acc, y.g), Tried(name, "read as a disequality")),
                CState(cf.fals, cf.succ, cf.target, cf.diseqs ++ [d], cf.done, cf.injected, cf.contra))))
        })),
    })
}

// One fact read alone: `proof` of the statement `ty`, called `name`: an
// equation, read into the graph; an equation under binders, a lemma to
// instantiate; anything else, `None`.
fn read_one(acc: Facts, proof: Expr, name: String, ty: Handle) → Tac<Option<Facts>> {
    sides_of(ty).bind(λ o => match o {
        None => concludes_equation(64, ty).bind(λ q => match q {
            True => lemma_of(acc.cf.succ, name, proof, ty).bind(λ ol => match ol {
                None => Pure(Some(facts_note(acc, Tried(name, "an equation under binders, not instantiated: neither side mentions every binder the rest of the statement depends on")))),
                Some(lm) => Pure(Some(Facts(acc.g, acc.read ++ [Tried(name, lemma_read(lm))], acc.skipped, acc.lemmas ++ [lm], acc.seen, acc.offered, acc.locals, acc.givens, acc.pending, acc.cf))),
            }),
            False => read_diseq(acc, proof, name, ty),
        }),
        Some(p) => read_term(acc.g, p.fst).bind(λ x => read_term(x.g, p.snd).bind(λ y =>
            Pure(Some(Facts(Graph(y.g.eg.union(x.node, y.node, Fact(proof, name, [])), y.g.info, y.g.atoms), acc.read ++ [Tried(name, "read as an equation")], acc.skipped, acc.lemmas, acc.seen, acc.offered, acc.locals, acc.givens, acc.pending, acc.cf))))),
    })
}

// A fact read as nothing: a local is named in the report's last line, and a
// hint has a line of its own and is kept for the premises (a local is one
// already).
fn not_read(acc: Facts, proof: Expr, name: String, ty: Handle, local: Bool) → Facts {
    match local {
        True => Facts(acc.g, acc.read, acc.skipped ++ [name], acc.lemmas, acc.seen, acc.offered, acc.locals, acc.givens, acc.pending, acc.cf),
        False => Facts(acc.g, acc.read ++ [Tried(name, "not an equation: kept for the premises")], acc.skipped, acc.lemmas, acc.seen, acc.offered, acc.locals, acc.givens ++ [Given(proof, name, ty)], acc.pending, acc.cf),
    }
}

fn field_facts(name: String, fs: List<FieldProj>) → Tac<List<Given>> {
    match fs {
        Nil => Pure([]),
        Cons(f, rest) => infer(Hd(f.term)).bind(λ c => field_facts(name, rest).bind(λ gs => Pure(match c {
            Refused(_) => gs,
            Accepted(ty) => Cons(Given(Hd(f.term), name ++ "." ++ f.name, ty), gs),
        }))),
    }
}

// Is `r` the type `Iff` names where the `by` is?
fn is_iff(r: GlobalRef) → Tac<Bool> {
    lookup("Iff").bind(λ c => match c {
        Accepted(i) => Pure(i.id.same(r.id)),
        Refused(_) => Pure(False),
    })
}

// The fields of the fact `g` (`Fields`), each a fact `g.field` proved by
// its projection, when its type is a non-indexed inductive with one
// constructor other than `↔`: `P ↔ Q` is kept whole, its directions
// implications between propositions rather than equations between terms
// (issue grind-read-conjunctions). `None` for any other type; `Fields`
// refuses `∃`, whose proof is about its witness.
fn expand(g: Given) → Tac<Option<List<Given>>> {
    fields(g.proof).bind(λ c => match c {
        Refused(_) => Pure(None),
        Accepted(p) => is_iff(p.ty).bind(λ iff => match iff {
            True => Pure(None),
            False => field_facts(g.name, p.fields).bind(λ gs => Pure(Some(gs))),
        }),
    })
}

// Does `read_one` read a fact of type `ty`: is it an equation, or one
// under binders?
fn reads_alone(ty: Handle) → Tac<Bool> {
    sides_of(ty).bind(λ o => match o {
        Some(_) => Pure(True),
        None => concludes_equation(64, ty),
    })
}

// How deep fields of fields are read: as deep as `concludes_equation` reads
// binders. And how many facts one fact's fields may come to.
fn grind_field_depth() → Nat { 64 }
fn grind_field_fuel() → Nat { 4096 }

// The facts under `todo` (each with the field depth left), fields of fields
// expanded in place, into `out`, in order: a fact that reads alone is not
// expanded.
fn leaves(fuel: Nat, todo: List<Pair<Nat, Given>>, out: List<Given>) → Tac<List<Given>> {
    match fuel {
        Zero => Pure(out ++ todo.map(λ p => p.snd)),
        Succ(f) => match todo {
            Nil => Pure(out),
            Cons(p, rest) => match p.fst {
                Zero => leaves(f, rest, out ++ [p.snd]),
                Succ(d) => reads_alone(p.snd.ty).bind(λ alone => match alone {
                    True => leaves(f, rest, out ++ [p.snd]),
                    False => expand(p.snd).bind(λ o => match o {
                        None => leaves(f, rest, out ++ [p.snd]),
                        Some(gs) => leaves(f, gs.map(λ x => Pair(d, x)) ++ rest, out),
                    }),
                }),
            },
        },
    }
}

// Each field fact read alone; one that is nothing is kept for the premises
// with no line of its own.
fn read_leaves(acc: Facts, ls: List<Given>) → Tac<Facts> {
    match ls {
        Nil => Pure(acc),
        Cons(l, rest) => read_one(acc, l.proof, l.name, l.ty).bind(λ o => read_leaves(match o { Some(a) => a, None => with_givens(acc, acc.givens ++ [l]) }, rest)),
    }
}

// One fact: read alone (`read_one`), or else, when it is a one-constructor
// value (`k: a = b ∧ b = c`, a record of equations), by its fields, each a
// fact of its own (`k.left`, `k.right`), fields of fields read the same way.
// A fact none of whose fields reads as anything is read as nothing: for a
// local, named only in the report's last line (a hint that is no equation
// has a line of its own).
fn read_fact(acc: Facts, proof: Expr, name: String, ty: Handle, local: Bool) → Tac<Facts> {
    read_one(acc, proof, name, ty).bind(λ o => match o {
        Some(a) => Pure(a),
        None => expand(Given(proof, name, ty)).bind(λ e => match e {
            None => Pure(not_read(acc, proof, name, ty, local)),
            Some(gs) => leaves(grind_field_fuel(), gs.map(λ x => Pair(grind_field_depth(), x)), []).bind(λ ls => read_leaves(acc, ls).bind(λ a =>
                Pure(match a.read.len().same(acc.read.len()) {
                    True => not_read(with_givens(acc, a.givens), proof, name, ty, local),
                    False => match local { True => a, False => with_givens(a, a.givens ++ [Given(proof, name, ty)]) },
                }))),
        }),
    })
}

fn read_locals(acc: Facts, ls: List<LocalInfo>) → Tac<Facts> {
    match ls {
        Nil => Pure(acc),
        Cons(l, rest) => read_fact(acc, Local(l.ref), l.name, l.ty, True).bind(λ a => read_locals(a, rest)),
    }
}

fn offer(acc: Facts, name: String) → Facts { Facts(acc.g, acc.read, acc.skipped, acc.lemmas, acc.seen, acc.offered ++ [name], acc.locals, acc.givens, acc.pending, acc.cf) }

fn read_hints(acc: Facts, hs: List<Expr>, k: Nat) → Tac<Facts> {
    match hs {
        Nil => Pure(acc),
        Cons(e, rest) => {
            let name = "hint " ++ decimal_name(Succ(k), k);
            infer(e).bind(λ c => match c {
                Refused(why) => fail("grind: " ++ name ++ " does not elaborate: " ++ why, []),
                Accepted(ty) => read_fact(offer(acc, name), e, name, ty, False).bind(λ a => read_hints(a, rest, Succ(k))),
            })
        },
    }
}

// Lemmas by name, resolved where the `by` is.
fn read_names(acc: Facts, ns: List<String>) → Tac<Facts> {
    match ns {
        Nil => Pure(acc),
        Cons(n, rest) => resolve(n).bind(λ c => match c {
            Refused(why) => fail("grind: `" ++ n ++ "` does not resolve: " ++ why, []),
            Accepted(h) => infer(Hd(h)).bind(λ t => match t {
                Refused(why) => fail("grind: `" ++ n ++ "` has no type: " ++ why, []),
                Accepted(ty) => read_fact(offer(acc, n), Hd(h), n, ty, False).bind(λ a => read_names(a, rest)),
            }),
        }),
    }
}

// ---------------------------------------------------------------------------
// Instantiating: rounds of matching every lemma against the closed graph.

// How many rounds of matching, and how many new instances one round adds.
fn grind_rounds() → Nat { 8 }

fn grind_round_cap() → Nat { 64 }

fn known(g: Graph, seen: List<Inst>, k: Nat, a: List<Option<Nat>>) → Bool {
    match seen {
        Nil => False,
        Cons(i, rest) => match i.lemma.same(k).and(g.eg.subst_same(i.args, a)) { True => True, False => known(g, rest, k, a) },
    }
}

// The matches of lemma `k` not seen before (up to the classes of what its
// binders met).
fn new_insts(g: Graph, k: Nat, n: Nat, ms: List<Subst>, seen: List<Inst>) → List<Inst> {
    match ms {
        Nil => [],
        Cons(m, rest) => {
            let a = m.at.take(n);
            match known(g, seen, k, a) {
                True => new_insts(g, k, n, rest, seen),
                False => Cons(Inst(k, a, None), new_insts(g, k, n, rest, Cons(Inst(k, a, None), seen))),
            }
        },
    }
}

// A near match of lemma `lemma`'s pattern number `pat`: the node its root
// met, what it binds, and the item it left and the node that item met.
record Near { lemma: Nat, pat: Nat, root: Nat, s: Subst, slack: Slack }

fn strict_of(ms: List<LooseMatched>) → List<Subst> {
    match ms {
        Nil => [],
        Cons(m, rest) => match m.l.slack { None => Cons(m.l.s, strict_of(rest)), Some(_) => strict_of(rest) },
    }
}

fn opts_same(a: List<Option<Nat>>, b: List<Option<Nat>>) → Bool {
    match a {
        Nil => match b { Nil => True, Cons(_, _) => False },
        Cons(x, ar) => match b {
            Nil => False,
            Cons(y, br) => match x {
                None => match y { None => opts_same(ar, br), Some(_) => False },
                Some(m) => match y { None => False, Some(k) => m.same(k).and(opts_same(ar, br)) },
            },
        },
    }
}

fn same_near(n: Nat, a: Near, b: Near) → Bool {
    a.slack.item.same(b.slack.item).and(a.slack.node.same(b.slack.node)).and(opts_same(a.s.at.take(n), b.s.at.take(n)))
}

fn near_in(n: Nat, ns: List<Near>, x: Near) → Bool {
    match ns { Nil => False, Cons(y, rest) => same_near(n, y, x).or(near_in(n, rest, x)) }
}

// The near matches of pattern `j` of lemma `k` (of `n` binders), each once
// by the nodes its binders and its item met: `Defeq` reads terms.
fn nears_of(k: Nat, j: Nat, n: Nat, ms: List<LooseMatched>, seen: List<Near>) → List<Near> {
    match ms {
        Nil => [],
        Cons(m, rest) => match m.l.slack {
            None => nears_of(k, j, n, rest, seen),
            Some(sl) => {
                let x = Near(k, j, m.root, m.l.s, sl);
                match near_in(n, seen, x) {
                    True => nears_of(k, j, n, rest, seen),
                    False => Cons(x, nears_of(k, j, n, rest, Cons(x, seen))),
                }
            },
        },
    }
}

fn flag_at(fs: List<Bool>, i: Nat) → Bool { match fs.nth(i) { Some(b) => b, None => False } }

record Found { insts: List<Inst>, lemmas: List<Lemma>, nears: List<Near> }

// Continue with `t` once `n` is computed. The host gives the evaluation
// between two requests a fixed fuel, and a round's pure work (closing the
// graph, matching every lemma against every node) outgrows it on a graph of
// a few dozen terms; asking about `n`, a number that depends on one piece of
// that work, makes the piece its own evaluation.
fn settled<A>(n: Nat, t: Tac<A>) → Tac<A> { defeq(NatLit(n), NatLit(n)).bind(λ _ => t) }

// What one lemma's patterns found: new instances, matches, near matches.
record PatFound { insts: List<Inst>, matched: Nat, nears: List<Near> }

// Pattern `lp` (number `j` of lemma `k`, of `n` binders) matched root by
// root, each root its own evaluation (`settled`): its new instances (at
// most `cap`), its matches, and its near matches, each once.
fn root_insts(g: Graph, table: List<List<Nat>>, k: Nat, n: Nat, lp: LPat, j: Nat, roots: List<Nat>, seen: List<Inst>, cap: Nat, acc: PatFound) → Tac<PatFound> {
    match roots {
        Nil => Pure(acc),
        Cons(r, rest) => {
            let ms = g.eg.ematch_loose_at(λ q op s => gq_test(g, q, op, s), λ i => flag_at(lp.slack, i), table, lp.pat, r);
            let strict = strict_of(ms);
            let fresh = new_insts(g, k, n, strict, seen).take(cap);
            let nears = nears_of(k, j, n, ms, acc.nears);
            settled(strict.len() + fresh.len() + nears.len(), root_insts(g, table, k, n, lp, j, rest, seen ++ fresh, cap.sub(fresh.len()), PatFound(acc.insts ++ fresh, acc.matched + strict.len(), acc.nears ++ nears)))
        },
    }
}

fn on_pat<A>(t: Tac<PatFound>, k: PatFound → Tac<A>) → Tac<A> { t.bind(k) }

fn pats_insts(g: Graph, table: List<List<Nat>>, k: Nat, n: Nat, ps: List<LPat>, j: Nat, seen: List<Inst>, cap: Nat) → Tac<PatFound> {
    match ps {
        Nil => Pure(PatFound([], 0, [])),
        Cons(lp, rest) => on_pat(root_insts(g, table, k, n, lp, j, List::range(g.eg.size()), seen, cap, PatFound([], 0, [])), λ here =>
            on_pat(pats_insts(g, table, k, n, rest, Succ(j), seen ++ here.insts, cap.sub(here.insts.len())), λ tail =>
                Pure(PatFound(here.insts ++ tail.insts, here.matched + tail.matched, here.nears ++ tail.nears)))),
    }
}

fn with_matched(lm: Lemma, n: Nat) → Lemma { Lemma(lm.name, lm.proof, lm.binders, lm.premises, lm.pats, lm.refs, lm.matched + n, lm.added, lm.defined, lm.tried) }

fn with_tried(lm: Lemma, t: NearTried) → Lemma { Lemma(lm.name, lm.proof, lm.binders, lm.premises, lm.pats, lm.refs, lm.matched, lm.added, lm.defined, Cons(t, lm.tried)) }

fn round_insts(g: Graph, table: List<List<Nat>>, ls: List<Lemma>, k: Nat, seen: List<Inst>, cap: Nat) → Tac<Found> {
    match ls {
        Nil => Pure(Found([], [], [])),
        Cons(lm, rest) => pats_insts(g, table, k, lm.binders, lm.pats, 0, seen, cap).bind(λ pf =>
            round_insts(g, table, rest, Succ(k), seen ++ pf.insts, cap.sub(pf.insts.len())).bind(λ tail =>
                Pure(Found(pf.insts ++ tail.insts, Cons(with_matched(lm, pf.matched), tail.lemmas), pf.nears ++ tail.nears)))),
    }
}

fn bump_added(lm: Lemma, def: Bool) → Lemma {
    Lemma(lm.name, lm.proof, lm.binders, lm.premises, lm.pats, lm.refs, lm.matched, Succ(lm.added), match def { True => Succ(lm.defined), False => lm.defined }, lm.tried)
}

// ---------------------------------------------------------------------------
// Near matches: a lemma's instance up to a definitional step
// (docs/grind-design.md §13, issues/grind-definitional-equalities.md).
//
// A near match left one item of a pattern, an application in an argument
// position (`isucc(b)` in `a + isucc(b)`), at a node no member of whose
// class the item matches (`OfNat(Succ(k))`). It is an instance when the
// item, at what the match bound, is that node by `Defeq`. The binders only
// the item binds are holes first: `Defeq` solves what the comparison
// determines (`Cons(?x, ?ys)` against `[a] ++ xs`), and each solution is
// looked up among the graph's nodes. Where that leaves the one free binder
// undetermined, it is drawn from the graph's terms, as e-matching draws
// every binder (`b := OfNat(k)`, which `isucc(?b)` does not determine). The
// instance is then added as any other, with one more edge: the item's
// instance and the node, by `defn` below, whose `refl` the kernel checks by
// computation. A round asks at most `grind_defeq_budget()` such questions.

theorem defn<A>(x: A, y: A, h: x = y): x = y { h }

fn grind_defeq_budget() → Nat { 256 }

// The variables an item and the items below it bind.
fn item_vars(is: List<PItem<GQ>>, fuel: Nat, i: Nat) → List<Nat> {
    match fuel {
        Zero => [],
        Succ(f) => match is.nth(i) {
            None => [],
            Some(it) => match it {
                PVar(v) => [v],
                POp(q, ks) => match q {
                    QDep(v) => Cons(v, concat_map(ks, λ c => item_vars(is, f, c))),
                    _ => concat_map(ks, λ c => item_vars(is, f, c)),
                },
            },
        },
    }
}

// Items to visit, each with the kid positions that lead to it.
fn kids_with(ks: List<Nat>, j: Nat, path: List<Nat>) → List<Pair<Nat, List<Nat>>> {
    match ks { Nil => [], Cons(c, rest) => Cons(Pair(c, path ++ [j]), kids_with(rest, Succ(j), path)) }
}

// The kid positions from an item in `todo` down to item `to`.
fn path_to(is: List<PItem<GQ>>, fuel: Nat, todo: List<Pair<Nat, List<Nat>>>, to: Nat) → Option<List<Nat>> {
    match fuel {
        Zero => None,
        Succ(f) => match todo {
            Nil => None,
            Cons(p, rest) => match p.fst.same(to) {
                True => Some(p.snd),
                False => match is.nth(p.fst) {
                    Some(it) => match it {
                        POp(_, ks) => path_to(is, f, rest ++ kids_with(ks, 0, p.snd), to),
                        PVar(_) => path_to(is, f, rest, to),
                    },
                    None => path_to(is, f, rest, to),
                },
            },
        },
    }
}

// The node a path of kid positions leads to from node `n`.
fn walk(g: EGraph<GOp, Fact>, n: Nat, path: List<Nat>) → Option<Nat> {
    match path {
        Nil => Some(n),
        Cons(j, rest) => match g.node(n) {
            None => None,
            Some(nd) => match nd.kids.nth(j) { None => None, Some(c) => walk(g, c, rest) },
        },
    }
}

fn lams(rs: List<LocalRef>, body: Expr) → Expr { match rs { Nil => body, Cons(r, rest) => Lam(r, lams(rest, body)) } }

// Binder `i`'s argument: the node it met, the candidate `c` at binder `u`,
// and a hole at a binder neither (a premise; the item does not mention it).
fn arg_expr(g: Graph, s: Subst, u: Nat, c: Expr, i: Nat) → Expr {
    match s.get(i) {
        Some(n) => expr_at(g, n),
        None => match i.same(u) { True => c, False => Blank },
    }
}

// The item's subterm `h` (under the lemma's binders) at what the match
// bound, and `c` at binder `u`.
fn sub_instance(g: Graph, lm: Lemma, h: Handle, s: Subst, u: Nat, c: Expr) → Expr {
    apps(lams(lm.refs, Hd(h)), List::range(lm.binders).map(λ i => arg_expr(g, s, u, c, i)))
}

// `Defeq`, its solutions forgotten: the question is asked, not answered by
// solving a hole the item's premises left.
fn defeq_undone(a: Expr, b: Expr) → Tac<Bool> {
    mark().bind(λ m => defeq(a, b).bind(λ same => restore(m).bind(λ _ => Pure(same))))
}

// The first of the candidates `cs` at which the item is the node, the
// budget left, and how far the candidates were tried.
record Pick { found: Option<Nat>, left: Nat, upto: Nat }

fn pick_candidate(g: Graph, lm: Lemma, h: Handle, s: Subst, u: Nat, target: Expr, cs: List<Nat>, budget: Nat, upto: Nat) → Tac<Pick> {
    match cs {
        Nil => Pure(Pick(None, budget, upto)),
        Cons(c, rest) => match budget {
            Zero => Pure(Pick(None, 0, c)),
            Succ(b) => defeq_undone(sub_instance(g, lm, h, s, u, expr_at(g, c)), target).bind(λ same => match same {
                True => Pure(Pick(Some(c), b, Succ(c))),
                False => pick_candidate(g, lm, h, s, u, target, rest, b, Succ(c)),
            }),
        },
    }
}

fn is_whole(g: Graph, i: Nat) → Bool { match g.info.nth(i) { Some(n) => n.whole, None => False } }

// What was tried of this near match before, if it was.
fn tried_at(ts: List<NearTried>, j: Nat, item: Nat, node: Nat, args: List<Option<Nat>>) → Option<NearTried> {
    match ts {
        Nil => None,
        Cons(t, rest) => match t.pat.same(j).and(t.item.same(item)).and(t.node.same(node)).and(opts_same(t.args, args)) {
            True => Some(t),
            False => tried_at(rest, j, item, node, args),
        },
    }
}

fn upto_of(o: Option<NearTried>) → Nat { match o { None => 0, Some(t) => t.upto } }

fn asked_of(o: Option<NearTried>) → Bool { match o { None => False, Some(t) => t.asked } }

// Binder `i`'s argument when the item is asked about with holes: the node
// the match bound it to, else its hole.
fn hole_arg(g: Graph, s: Subst, hs: List<Handle>, i: Nat) → Expr {
    match s.get(i) {
        Some(n) => expr_at(g, n),
        None => match hs.nth(i) { Some(x) => Hd(x), None => Blank },
    }
}

// The item's subterm `h` at the binders' nodes `a`, a hole at a premise.
fn inst_expr(g: Graph, lm: Lemma, h: Handle, a: List<Option<Nat>>) → Expr {
    apps(lams(lm.refs, Hd(h)), List::range(lm.binders).map(λ i => match a.nth(i) {
        Some(o) => match o { Some(n) => expr_at(g, n), None => Blank },
        None => Blank,
    }))
}

// The nodes a hole's solution is looked up among: the whole terms, in
// order, then the atoms that are not (a type argument, read as part of an
// operator).
fn solution_candidates(g: Graph) → List<Nat> {
    List::append(List::range(g.info.len()).filter(λ c => is_whole(g, c)), g.atoms.map(λ a => a.node).filter(λ c => is_whole(g, c).not()))
}

// The first of the nodes `cs` the solved hole `x` is, by `Defeq` (each
// question undone), and the budget left.
record Solved { node: Option<Nat>, left: Nat }

fn node_of(g: Graph, x: Handle, cs: List<Nat>, budget: Nat) → Tac<Solved> {
    match cs {
        Nil => Pure(Solved(None, budget)),
        Cons(c, rest) => match budget {
            Zero => Pure(Solved(None, 0)),
            Succ(b) => defeq_undone(Hd(x), expr_at(g, c)).bind(λ same => match same {
                True => Pure(Solved(Some(c), b)),
                False => node_of(g, x, rest, b),
            }),
        },
    }
}

// The binders' nodes `args` with each free binder's solution looked up,
// while the budget lasts: `None` once a hole is left unsolved or no node is
// its solution.
record Solutions { args: Option<List<Option<Nat>>>, left: Nat }

fn solutions(g: Graph, hs: List<Handle>, free: List<Nat>, cs: List<Nat>, args: List<Option<Nat>>, budget: Nat) → Tac<Solutions> {
    match free {
        Nil => Pure(Solutions(Some(args), budget)),
        Cons(u, rest) => match hs.nth(u) {
            None => Pure(Solutions(None, budget)),
            Some(x) => view(x).bind(λ v => match v {
                HHole => Pure(Solutions(None, budget)),
                _ => node_of(g, x, cs, budget).bind(λ sv => match sv.node {
                    None => Pure(Solutions(None, sv.left)),
                    Some(c) => solutions(g, hs, rest, cs, args.update(u, λ _ => Some(c)), sv.left),
                }),
            }),
        },
    }
}

// The item asked about with a hole at each binder the match left free
// (`Holes` at the lemma's proof, so each hole has its binder's type at the
// arguments before it): where `Defeq` solves them (`Cons(?x, ?ys)` against
// `[a] ++ xs` gives `?x := a`, `?ys := [] ++ xs`), each solution is looked
// up among the graph's nodes (`xs`), the holes are forgotten, and the
// instance at those nodes is asked once more with none, the question its
// definitional edge stands for.
fn by_holes(g: Graph, lm: Lemma, h: Handle, s: Subst, args: List<Option<Nat>>, free: List<Nat>, target: Expr, budget: Nat) → Tac<Solutions> {
    match budget {
        Zero => Pure(Solutions(None, 0)),
        Succ(b) => mark().bind(λ m => holes(lm.proof, lm.binders).bind(λ c => match c {
            Refused(_) => restore(m).bind(λ _ => Pure(Solutions(None, Succ(b)))),
            Accepted(hs) => defeq(apps(lams(lm.refs, Hd(h)), List::range(lm.binders).map(λ i => hole_arg(g, s, hs, i))), target).bind(λ same => match same {
                False => restore(m).bind(λ _ => Pure(Solutions(None, b))),
                True => solutions(g, hs, free, solution_candidates(g), args, b).bind(λ sol => restore(m).bind(λ _ => match sol.args {
                    None => Pure(sol),
                    Some(a) => match sol.left {
                        Zero => Pure(Solutions(None, 0)),
                        Succ(b2) => defeq_undone(inst_expr(g, lm, h, a), target).bind(λ ok => Pure(Solutions(match ok { True => Some(a), False => None }, b2))),
                    },
                })),
            }),
        })),
    }
}

fn nats_once(xs: List<Nat>, seen: List<Nat>) → List<Nat> {
    match xs {
        Nil => [],
        Cons(x, rest) => match nat_in(seen, x) { True => nats_once(rest, seen), False => Cons(x, nats_once(rest, Cons(x, seen))) },
    }
}

// The instance a near match found at the binders' nodes `a`. One like it
// may have been added already (from the other side's pattern): it is added
// again for its definitional edge, which is new, and reading it again adds
// no term. A near match is resolved once (`NearTried`), so this repeats
// nothing.
fn near_inst(nr: Near, lp: LPat, path: List<Nat>, a: List<Option<Nat>>) → Option<Inst> {
    Some(Inst(nr.lemma, a, Some(DefAt(lp.left, path, nr.slack.node))))
}

// What resolving a near match gives: the instance, if any, the lemma with
// the near match recorded as tried, and the budget left.
record Resolved { inst: Option<Inst>, lemma: Lemma, left: Nat }

// The one free binder `u` drawn from the graph's whole terms from node
// `from` on.
fn draw_one(g: Graph, lm: Lemma, nr: Near, lp: LPat, h: Handle, path: List<Nat>, u: Nat, from: Nat, asked: Bool, budget: Nat) → Tac<Resolved> {
    let item = nr.slack.item;
    let node = nr.slack.node;
    let args = nr.s.at.take(lm.binders);
    let cs = List::range(g.info.len()).filter(λ c => from.leb(c).and(is_whole(g, c)));
    let tried = λ (upto: Nat) => with_tried(lm, NearTried(nr.pat, item, node, args, upto, asked));
    match cs {
        Nil => Pure(Resolved(None, match asked { True => tried(from), False => lm }, budget)),
        Cons(_, _) => pick_candidate(g, lm, h, nr.s, u, expr_at(g, node), cs, budget, g.info.len()).bind(λ pk =>
            Pure(Resolved(match pk.found {
                None => None,
                Some(c) => near_inst(nr, lp, path, args.update(u, λ _ => Some(c))),
            }, tried(pk.upto), pk.left))),
    }
}

fn resolve_at(g: Graph, lm: Lemma, nr: Near, lp: LPat, h: Handle, path: List<Nat>, seen: List<Inst>, budget: Nat) → Tac<Resolved> {
    let item = nr.slack.item;
    let node = nr.slack.node;
    let args = nr.s.at.take(lm.binders);
    let vars = nats_once(item_vars(lp.pat.items, Succ(lp.pat.items.len()), item), []);
    let free = vars.filter(λ v => Succ(v).leb(lm.binders).and(match nr.s.get(v) { None => True, Some(_) => False }));
    let before = tried_at(lm.tried, nr.pat, item, node, args);
    let from = upto_of(before);
    let skip: Tac<Resolved> = Pure(Resolved(None, lm, budget));
    let target = expr_at(g, node);
    match free {
        Nil => match from {
            Succ(_) => skip,
            Zero => match budget {
                Zero => skip,
                Succ(b) => defeq_undone(sub_instance(g, lm, h, nr.s, lm.binders, Blank), target).bind(λ same =>
                    Pure(Resolved(match same { True => near_inst(nr, lp, path, args), False => None }, with_tried(lm, NearTried(nr.pat, item, node, args, 1, False)), b))),
            },
        },
        Cons(u, more) => {
            let one = match more { Nil => True, Cons(_, _) => False };
            match asked_of(before) {
                True => match one { True => draw_one(g, lm, nr, lp, h, path, u, from, True, budget), False => skip },
                False => by_holes(g, lm, h, nr.s, args, free, target, budget).bind(λ sol => match sol.args {
                    Some(a) => Pure(Resolved(near_inst(nr, lp, path, a), with_tried(lm, NearTried(nr.pat, item, node, args, from, True)), sol.left)),
                    // Out of budget: asked again next round.
                    None => match sol.left {
                        Zero => skip,
                        Succ(_) => match one {
                            True => draw_one(g, lm, nr, lp, h, path, u, from, True, sol.left),
                            False => Pure(Resolved(None, with_tried(lm, NearTried(nr.pat, item, node, args, from, True)), sol.left)),
                        },
                    },
                }),
            }
        },
    }
}

fn opt_handle(o: Option<Option<Handle>>) → Option<Handle> { match o { Some(x) => x, None => None } }

fn resolve_near(g: Graph, lm: Lemma, nr: Near, seen: List<Inst>, budget: Nat) → Tac<Resolved> {
    match lm.pats.nth(nr.pat) {
        None => Pure(Resolved(None, lm, budget)),
        Some(lp) => match opt_handle(lp.terms.nth(nr.slack.item)) {
            None => Pure(Resolved(None, lm, budget)),
            Some(h) => match path_to(lp.pat.items, Succ(lp.pat.items.len()), [Pair(lp.pat.root, [])], nr.slack.item) {
                None => Pure(Resolved(None, lm, budget)),
                Some(path) => resolve_at(g, lm, nr, lp, h, path, seen, budget),
            },
        },
    }
}

fn on_resolved<A>(t: Tac<Resolved>, k: Resolved → Tac<A>) → Tac<A> { t.bind(k) }

// Each near match resolved, in order, while the budget lasts: the instances
// found, and the lemmas with what was tried.
fn resolve_nears(g: Graph, ls: List<Lemma>, ns: List<Near>, seen: List<Inst>, budget: Nat, out: List<Inst>) → Tac<Found> {
    match ns {
        Nil => Pure(Found(out, ls, [])),
        Cons(nr, rest) => match budget {
            Zero => Pure(Found(out, ls, [])),
            Succ(b) => match ls.nth(nr.lemma) {
                None => resolve_nears(g, ls, rest, seen, Succ(b), out),
                Some(lm) => on_resolved(settled(rest.len(), resolve_near(g, lm, nr, seen, Succ(b))), λ r => {
                    let ls2 = ls.update(nr.lemma, λ _ => r.lemma);
                    match r.inst {
                        None => resolve_nears(g, ls2, rest, seen, r.left, out),
                        Some(i) => resolve_nears(g, ls2, rest, Cons(i, seen), r.left, out ++ [i]),
                    }
                }),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Concluding.

fn law(name: String) → Tac<GlobalRef> { lookup(name).or_fail("grind: `" ++ name ++ "`: ") }

fn grind_laws() → Tac<GrindLaws> {
    law("trans").bind(λ t => law("sym").bind(λ s => law("cong").bind(λ c =>
    law("grind::congr").bind(λ cr => law("grind::congr_fun").bind(λ cf => law("tactic::rfl").bind(λ r => law("grind::defn").bind(λ d =>
    law("False").bind(λ f => law("grind::elim_false").bind(λ fe => law("grind::exfalso").bind(λ ex => law("grind::succ_inj").bind(λ si =>
    Pure(GrindLaws(t, s, c, cr, cf, r, d, f, fe, ex, si)))))))))))))
}

// The names of the facts a path cites, by the same explanation the proof is.
fn cited_alg() → PathAlg<Fact, List<String>> {
    PathAlg(λ _ => [], λ f _ => Cons(f.name, f.uses), λ _ _ ks => concat_map(ks, λ k => k.proof), λ p q => p ++ q)
}

fn chars_same(xs: List<Char>, ys: List<Char>) → Bool {
    match xs {
        Nil => match ys { Nil => True, Cons(_, _) => False },
        Cons(x, xr) => match ys { Nil => False, Cons(y, yr) => x.code.same(y.code).and(chars_same(xr, yr)) },
    }
}

fn name_in(ns: List<String>, n: String) → Bool {
    match ns { Nil => False, Cons(m, rest) => chars_same(m.chars, n.chars).or(name_in(rest, n)) }
}

fn names_once(ns: List<String>, done: List<String>) → List<String> {
    match ns {
        Nil => [],
        Cons(n, rest) => match name_in(done, n) {
            False => Cons(n, names_once(rest, Cons(n, done))),
            True => names_once(rest, done),
        },
    }
}

// How many instances a near match found, up to a definitional step.
fn defined_note(n: Nat) → String {
    match n { Zero => "", Succ(_) => ", " ++ decimal_name(Succ(n), n) ++ " of them up to a definitional step" }
}

fn lemma_notes(ls: List<Lemma>) → List<Note> {
    match ls {
        Nil => [],
        Cons(lm, rest) => Cons(match lm.matched + lm.added {
            Zero => Tried(lm.name, "its patterns never matched a term of the graph"),
            Succ(_) => Tried(lm.name, decimal_name(Succ(lm.matched), lm.matched) ++ " matches, " ++ decimal_name(Succ(lm.added), lm.added) ++ " instances added" ++ defined_note(lm.defined)),
        }, lemma_notes(rest)),
    }
}

// What `grind_report` says: the hints and named lemmas the proof cites,
// the locals it cites, and the hints it does not, so the call can be
// narrowed to the ones it used.
fn say_used(fs: Facts, used0: List<String>) → Tac<True> {
    let used = used0.filter(λ n => match n.chars { Nil => False, Cons(_, _) => True });
    let cited = fs.offered.filter(λ n => name_in(used, n));
    let unused = fs.offered.filter(λ n => name_in(used, n).not());
    let locals = used.filter(λ n => name_in(fs.offered, n).not());
    let hints: String = match cited { Nil => "none of the hints", Cons(_, _) => names_line(cited) };
    let rest: String = match locals { Nil => "", Cons(_, _) => ", and the locals " ++ names_line(locals) };
    let not: String = match unused { Nil => "", Cons(_, _) => "; not used: " ++ names_line(unused) };
    say("grind: the proof uses " ++ hints ++ rest ++ not, [])
}

fn finish_with(report: Bool, fs: Facts, used: List<String>, p: Expr) → Tac<Expr> {
    match report {
        False => Pure(p),
        True => Tac::bind(say_used(fs, used), λ _ => Pure(p)),
    }
}

// The instances waiting on a premise, the first few by the premise each
// is missing.
fn pending_notes(ps: List<Pend>) → List<Note> {
    match ps {
        Nil => [],
        Cons(_, _) => {
            let n = ps.len();
            let shown = ps.take(4).map(λ p => p.note);
            let more: List<Note> = match n.sub(4) { Zero => [], Succ(k) => [Tried("premises", "and " ++ counted(Succ(k), "more instance", "more instances") ++ " waiting on one")] };
            Cons(Tried("premises", counted(n, "instance", "instances") ++ " not added: a premise was not proved"), shown ++ more)
        },
    }
}

// The goal, as grind proves it: the equation's sides' nodes (`None` for a
// goal that is no equation, proved only by a contradiction), the statement
// under the binders it opened (`a ≠ b` is `a = b → False`), and those
// binders' locals, which the proof abstracts.
record GoalAt { sides: Option<Node2>, target: Handle, intros: List<LocalRef> }

fn injected_notes(cf: CState) → List<Note> {
    match cf.injected {
        Zero => [],
        Succ(_) => [Tried("constructors", counted(cf.injected, "field equation", "field equations") ++ " by injectivity")],
    }
}

fn stuck(g: Graph, fs: Facts, gt: GoalAt, why: String) → Tac<Expr> {
    let lemmas: List<Note> = match fs.lemmas { Nil => [], Cons(_, _) => lemma_notes(fs.lemmas) ++ pending_notes(fs.pending) ++ [Tried("matching", why)] };
    let fs2 = Facts(fs.g, fs.read ++ injected_notes(fs.cf) ++ lemmas, fs.skipped, fs.lemmas, fs.seen, fs.offered, fs.locals, fs.givens, fs.pending, fs.cf);
    match gt.sides {
        Some(p) => fail("grind: the two sides are not in one class", stuck_notes(g, p.a, p.b, fs2)),
        None => {
            let skipped: List<Note> = match fs.skipped { Nil => [], Cons(_, _) => [Tried("not equations, not read", names_line(fs.skipped))] };
            fail("grind: the goal is not an equation, and the facts hold no contradiction",
                Cons(At(Hd(gt.target), Tried("the goal", "not an equation: proved only from a contradiction")),
                    class_notes(g, g.eg.class_table(), 0) ++ fs2.read ++ skipped
                        ++ [Tried("to close it", "two different constructors in one class, or both sides of a disequality")]))
        },
    }
}

// The graph closed under congruence, one pass per evaluation (`settled`):
// a pass compares every node's signature with the earlier ones, and the
// passes of a graph of a few dozen terms outgrow one evaluation's fuel
// together.
fn close_passes(eg: EGraph<GOp, Fact>, fuel: Nat) → Tac<EGraph<GOp, Fact>> {
    match fuel {
        Zero => Pure(eg),
        Succ(f) => {
            let g2 = eg.congruence_pass(gop_same, sigs_from(eg, eg.nodes, 0), []);
            settled(g2.edges.len(), match g2.edges.len().same(eg.edges.len()) { True => Pure(g2), False => close_passes(g2, f) })
        },
    }
}

fn closed(fs: Facts) → Tac<Facts> {
    close_passes(fs.g.eg, Succ(fs.g.eg.size())).bind(λ eg => Pure(with_graph(fs, Graph(eg, fs.g.info, fs.g.atoms))))
}

fn on_closed<A>(t: Tac<Facts>, k: Facts → Tac<A>) → Tac<A> { t.bind(k) }

// ---------------------------------------------------------------------------
// Constructors and disequalities (docs/grind-design.md §14,
// issues/grind-constructor-facts.md).
//
// A class holding two values of one constructor (`Cons(a, as)`,
// `Cons(b, bs)`) holds their fields pairwise: each field equation is `Inj`
// of the explanation of the two values' equation, an edge like a given
// equation's. A class holding values of two different constructors
// (`True`, `False`) is a contradiction, `Absurd` of the explanation; so is
// a class holding both sides of a disequality, the disequality applied to
// the explanation. Either proves any goal, by `false_elim`. The host builds
// `inj` and `absurd` as the surface forms are, and refuses where they would
// (a dependent field, sides that are no constructors' values); the graph
// only proposes.

// A constructor value's node: the constructor's atom it bottoms out at, the
// atom's key (`KCtor`, or a literal), and its fields' nodes in order.
record CtorNode { node: Nat, head: Nat, key: AtomKey, fields: List<Nat> }

fn ctor_node(g: Graph, fuel: Nat, n: Nat, fields: List<Nat>, top: Nat) → Option<CtorNode> {
    match fuel {
        Zero => None,
        Succ(f) => match g.eg.node(n) {
            None => None,
            Some(nd) => match nd.op {
                GAppOp => match nd.kids {
                    Nil => None,
                    Cons(fk, rest) => match rest { Nil => None, Cons(a, _) => ctor_node(g, f, fk, Cons(a, fields), top) },
                },
                GAtomOp(k) => match g.atoms.nth(k) {
                    None => None,
                    Some(e) => match e.key {
                        KCtor(_, _) => Some(CtorNode(top, n, e.key, fields)),
                        KSucc(_) => Some(CtorNode(top, n, e.key, fields)),
                        KLit(_) => match fields { Nil => Some(CtorNode(top, n, e.key, [])), Cons(_, _) => None },
                        _ => None,
                    },
                },
                GDepOp(_) => None,
            },
        },
    }
}

fn ctor_nodes(g: Graph, ms: List<Nat>) → List<CtorNode> {
    match ms {
        Nil => [],
        Cons(m, rest) => match ctor_node(g, 64, m, [], m) {
            Some(c) => Cons(c, ctor_nodes(g, rest)),
            None => ctor_nodes(g, rest),
        },
    }
}

// Are two constructor values of one constructor: the same atom, or atoms of
// one constructor of one type (its function at parameters `Defeq` told
// apart), with as many fields?
fn one_ctor(a: CtorNode, b: CtorNode) → Bool {
    let keyed: Bool = match a.key {
        KCtor(t, i) => match b.key { KCtor(u, k) => t.same(u).and(i.same(k)), _ => False },
        _ => False,
    };
    a.head.same(b.head).or(keyed).and(a.fields.len().same(b.fields.len()))
}

// Could two constructor values of one class be different constructors?
// Different constructors of one type, two literals, or a literal and a
// successor (`0` and `Succ(n)`; `3` and `Succ(n)` are not, and the host
// says so); the host decides.
fn two_ctors(a: CtorNode, b: CtorNode) → Bool {
    match a.key {
        KCtor(t, i) => match b.key { KCtor(u, k) => t.same(u).and(i.same(k).not()), _ => False },
        KSucc(_) => match b.key { KLit(_) => True, _ => False },
        KLit(x) => match b.key { KLit(y) => x.same(y).not(), KSucc(_) => True, _ => False },
        _ => False,
    }
}

fn node2_in(ps: List<Node2>, a: Nat, b: Nat) → Bool {
    match ps { Nil => False, Cons(p, rest) => p.a.same(a).and(p.b.same(b)).or(node2_in(rest, a, b)) }
}

// The pairs of constructor values to look at in one class: its first value
// with each other one, each pair once.
record CPair { a: CtorNode, b: CtorNode }

fn class_pairs(cs: List<CtorNode>, done: List<Node2>) → List<CPair> {
    match cs {
        Nil => [],
        Cons(c0, rest) => rest.filter(λ c => node2_in(done, c0.node, c.node).not()).map(λ c => CPair(c0, c)),
    }
}

fn table_pairs(g: Graph, rows: List<List<Nat>>, done: List<Node2>) → List<CPair> {
    match rows {
        Nil => [],
        Cons(ms, rest) => match ms {
            Nil => table_pairs(g, rest, done),
            Cons(_, more) => match more {
                Nil => table_pairs(g, rest, done),
                Cons(_, _) => class_pairs(ctor_nodes(g, ms), done) ++ table_pairs(g, rest, done),
            },
        },
    }
}

fn with_done(cf: CState, p: CPair) → CState { CState(cf.fals, cf.succ, cf.target, cf.diseqs, cf.done ++ [Node2(p.a.node, p.b.node)], cf.injected, cf.contra) }

// The names the explanation of `a = b` cites.
fn cited_between(g: Graph, a: Nat, b: Nat) → List<String> {
    match g.eg.explain(cited_alg(), a, b) { None => [], Some(ns) => ns }
}

// The field equations of two values of one constructor, field `k` on, by
// `Inj` of `pf`, their equation, each added as an edge citing what `pf`
// cites. A field already in its partner's class is not asked about.
fn inject_fields(l: GrindLaws, fs: Facts, pf: Expr, uses: List<String>, xs: List<Nat>, ys: List<Nat>, k: Nat) → Tac<Facts> {
    match xs {
        Nil => Pure(fs),
        Cons(x, xr) => match ys {
            Nil => Pure(fs),
            Cons(y, yr) => match fs.g.eg.same_class(x, y) {
                True => inject_fields(l, fs, pf, uses, xr, yr, Succ(k)),
                False => inj_field(pf, k).bind(λ c => match c {
                    Refused(_) => inject_fields(l, fs, pf, uses, xr, yr, Succ(k)),
                    Accepted(h) => {
                        let g = fs.g;
                        let cf = fs.cf;
                        let g2 = Graph(g.eg.union(x, y, Fact(cast_of(l, expr_at(g, x), expr_at(g, y), Hd(h)), "", uses)), g.info, g.atoms);
                        inject_fields(l, with_cf(with_graph(fs, g2), CState(cf.fals, cf.succ, cf.target, cf.diseqs, cf.done, Succ(cf.injected), cf.contra)), pf, uses, xr, yr, Succ(k))
                    },
                }),
            },
        },
    }
}

// `Succ(x)` and `Succ(y)` of one class: `x = y` by `grind::succ_inj` of `pf`,
// their equation (the kernel's `Nat` is no declared inductive, so `Inj`
// does not take it apart).
fn inject_succ(l: GrindLaws, fs: Facts, pf: Expr, uses: List<String>, xs: List<Nat>, ys: List<Nat>) → Facts {
    match xs {
        Nil => fs,
        Cons(x, _) => match ys {
            Nil => fs,
            Cons(y, _) => match fs.g.eg.same_class(x, y) {
                True => fs,
                False => {
                    let g = fs.g;
                    let cf = fs.cf;
                    let g2 = Graph(g.eg.union(x, y, Fact(apps(Global(l.succ_inj), [expr_at(g, x), expr_at(g, y), pf]), "", uses)), g.info, g.atoms);
                    with_cf(with_graph(fs, g2), CState(cf.fals, cf.succ, cf.target, cf.diseqs, cf.done, Succ(cf.injected), cf.contra))
                },
            },
        },
    }
}

// One pair of constructor values of one class: taken apart if one
// constructor, asked about as a contradiction if two.
fn ctor_pair(l: GrindLaws, fs: Facts, p: CPair) → Tac<Facts> {
    let fs1 = with_cf(fs, with_done(fs.cf, p));
    match fs1.g.eg.explain(proof_alg(l, fs1.g), p.a.node, p.b.node) {
        None => Pure(fs1),
        Some(pf) => {
            let uses = cited_between(fs1.g, p.a.node, p.b.node);
            match one_ctor(p.a, p.b) {
                True => match p.a.key {
                    KSucc(_) => Pure(inject_succ(l, fs1, pf, uses, p.a.fields, p.b.fields)),
                    _ => inject_fields(l, fs1, pf, uses, p.a.fields, p.b.fields, 0),
                },
                False => match two_ctors(p.a, p.b) {
                    False => Pure(fs1),
                    True => absurd_at(pf, fs1.cf.target).bind(λ c => match c {
                        Refused(_) => Pure(fs1),
                        Accepted(h) => {
                            let cf = fs1.cf;
                            Pure(with_cf(fs1, CState(cf.fals, cf.succ, cf.target, cf.diseqs, cf.done, cf.injected, Some(Contra(Hd(h), uses, False)))))
                        },
                    }),
                },
            }
        },
    }
}

fn ctor_pairs(l: GrindLaws, fs: Facts, ps: List<CPair>) → Tac<Facts> {
    match ps {
        Nil => Pure(fs),
        Cons(p, rest) => match fs.cf.contra {
            Some(_) => Pure(fs),
            None => ctor_pair(l, fs, p).bind(λ f2 => ctor_pairs(l, f2, rest)),
        },
    }
}

// The first disequality whose sides are in one class, as a contradiction.
fn diseq_contra(l: GrindLaws, g: Graph, ds: List<Diseq>) → Option<Contra> {
    match ds {
        Nil => None,
        Cons(d, rest) => match g.eg.same_class(d.sides.a, d.sides.b) {
            False => diseq_contra(l, g, rest),
            True => match g.eg.explain(proof_alg(l, g), d.sides.a, d.sides.b) {
                None => diseq_contra(l, g, rest),
                Some(pf) => Some(Contra(App(d.proof, cast_of(l, Hd(d.lhs), Hd(d.rhs), pf)), Cons(d.name, cited_between(g, d.sides.a, d.sides.b)), True)),
            },
        },
    }
}

fn with_diseq_contra(l: GrindLaws, fs: Facts) → Facts {
    let cf = fs.cf;
    match cf.contra {
        Some(_) => fs,
        None => match diseq_contra(l, fs.g, cf.diseqs) {
            None => fs,
            Some(c) => with_cf(fs, CState(cf.fals, cf.succ, cf.target, cf.diseqs, cf.done, cf.injected, Some(c))),
        },
    }
}

// How many times one closing takes constructor values apart and closes
// again.
fn grind_ctor_fuel() → Nat { 16 }

// The graph closed under congruence and constructors: closed, its new pairs
// of constructor values of one class taken apart or asked about, and closed
// again while that adds an edge; then the disequalities checked.
fn ctor_closed(l: GrindLaws, fs0: Facts, fuel: Nat) → Tac<Facts> {
    on_closed(closed(fs0), λ fs => {
        let ps = table_pairs(fs.g, fs.g.eg.class_table(), fs.cf.done);
        settled(ps.len(), match ps {
            Nil => Pure(with_diseq_contra(l, fs)),
            Cons(_, _) => ctor_pairs(l, fs, ps).bind(λ f2 => match fuel {
                Zero => Pure(with_diseq_contra(l, f2)),
                Succ(f) => match f2.cf.contra {
                    Some(_) => Pure(f2),
                    None => match f2.g.eg.edges.len().same(fs.g.eg.edges.len()) {
                        True => Pure(with_diseq_contra(l, f2)),
                        False => ctor_closed(l, f2, f),
                    },
                },
            }),
        })
    })
}

// ---------------------------------------------------------------------------
// Instances: a lemma applied to the nodes its binders met, each premise
// proved in order.
//
// A premise is proved at the instance, where it mentions only the matched
// terms: an equation by the graph (its sides read in, the graph closed, and
// the explanation if they meet), and any premise by a local whose type it is
// up to `Defeq` (a branch's `hit: same(a, x) = True`, whose `same` may be
// spelled over another memory with the same space) or by `Synth`, the
// `:= infer` search (instances, computation, facts-on-demand's evidence
// rules). Nothing is trusted: the instance is `infer`red, and the kernel
// checks the proof it ends up in.

// A premise's proof, the names it cites, and the facts after reading it.
record Premised { fs: Facts, proof: Option<Expr>, uses: List<String> }

fn by_graph(l: GrindLaws, fs: Facts, ty: Handle) → Tac<Premised> {
    sides_of(ty).bind(λ o => match o {
        None => Pure(Premised(fs, None, [])),
        Some(p) => read_term(fs.g, p.fst).bind(λ x => read_term(x.g, p.snd).bind(λ y => {
            on_closed(closed(with_graph(fs, y.g)), λ c => {
                let cx = class_of(c.g, x.node);
                let cy = class_of(c.g, y.node);
                settled(cx + cy, match cx.same(cy) {
                    False => Pure(Premised(c, None, [])),
                    True => match c.g.eg.explain(proof_alg(l, c.g), x.node, y.node) {
                        None => Pure(Premised(c, None, [])),
                        Some(pf) => Pure(Premised(c, Some(pf), match c.g.eg.explain(cited_alg(), x.node, y.node) { None => [], Some(ns) => ns })),
                    },
                })
            })
        })),
    })
}

fn by_local(ty: Handle, ls: List<Given>) → Tac<Option<Given>> {
    match ls {
        Nil => Pure(None),
        Cons(lo, rest) => defeq(Hd(ty), Hd(lo.ty)).bind(λ same => match same { True => Pure(Some(lo)), False => by_local(ty, rest) }),
    }
}

fn on_premised(t: Tac<Premised>, k: Premised → Tac<Premised>) → Tac<Premised> { t.bind(k) }

// The premise `ty`: by the graph, by a local, or by `Synth`.
fn prove_premise(l: GrindLaws, fs: Facts, ty: Handle) → Tac<Premised> {
    on_premised(by_graph(l, fs, ty), λ pg => match pg.proof {
        Some(_) => Pure(pg),
        None => by_local(ty, pg.fs.locals.map(λ lo => Given(Local(lo.ref), lo.name, lo.ty)) ++ pg.fs.givens).bind(λ ol => match ol {
            Some(gv) => Pure(Premised(pg.fs, Some(gv.proof), [gv.name])),
            None => synth(ty).bind(λ c => match c {
                Accepted(h) => Pure(Premised(pg.fs, Some(Hd(h)), [])),
                Refused(_) => Pure(Premised(pg.fs, None, [])),
            }),
        }),
    })
}

// The domain of a function type, as written or once in head normal form.
fn pi_domain(ty: Handle) → Tac<Option<Handle>> {
    view(ty).bind(λ v => match v {
        HPi(d) => Pure(Some(d)),
        _ => whnf(ty).bind(λ c => match c {
            Refused(_) => Pure(None),
            Accepted(w) => view(w).bind(λ wv => match wv { HPi(d) => Pure(Some(d)), _ => Pure(None) }),
        }),
    })
}

// What instantiating gives: the instance's proof and the names its
// premises' proofs cite; a premise not proved, by a note that says which;
// or nothing, where the match is ill-typed (through a wildcard).
inductive Built { BProof(proof: Expr, uses: List<String>), BMiss(note: Note), BDrop }

record Building { fs: Facts, b: Built }

fn premise_name(name: String, k: Nat) → String { name ++ ", premise " ++ decimal_name(Succ(Succ(k)), Succ(k)) }

// `pr` applied to the rest of an instance's arguments: a matched node's
// term, or a premise's proof (the `k`th premise next).
fn build(l: GrindLaws, fs: Facts, name: String, pr: Expr, uses: List<String>, as: List<Option<Nat>>, k: Nat) → Tac<Building> {
    match as {
        Nil => Pure(Building(fs, BProof(pr, uses))),
        Cons(o, rest) => match o {
            Some(n) => build(l, fs, name, App(pr, expr_at(fs.g, n)), uses, rest, k),
            None => infer(pr).bind(λ c => match c {
                Refused(_) => Pure(Building(fs, BDrop)),
                Accepted(ty) => pi_domain(ty).bind(λ od => match od {
                    None => Pure(Building(fs, BDrop)),
                    Some(dom) => prove_premise(l, fs, dom).bind(λ pm => match pm.proof {
                        None => Pure(Building(pm.fs, BMiss(At(Hd(dom), Tried(premise_name(name, k), "not proved: its sides are not in one class, no local or hint is it, and the instance search finds none"))))),
                        Some(pp) => build(l, pm.fs, name, App(pr, pp), uses ++ pm.uses, rest, Succ(k)),
                    }),
                }),
            }),
        },
    }
}

// Add the instance's equation, or set it aside to wait on its premise; one
// the kernel's type of does not make an equation of is left out.
fn is_def(o: Option<DefAt>) → Bool { match o { Some(_) => True, None => False } }

// The definitional edge of an instance a near match found: from the node
// the path leads to under the instance's side (`left` or `right`) to the
// node the item met, by `defn`, which the kernel checks by computation.
fn with_definition(l: GrindLaws, g: Graph, i: Inst, name: String, left: Nat, right: Nat) → Graph {
    match i.def {
        None => g,
        Some(d) => match walk(g.eg, match d.left { True => left, False => right }, d.path) {
            None => g,
            Some(m) => Graph(g.eg.union(m, d.node, Fact(defn_of(l, expr_at(g, m), expr_at(g, d.node)), name, [])), g.info, g.atoms),
        },
    }
}

fn on_built(l: GrindLaws, bd: Building, i: Inst, lm: Lemma) → Tac<Facts> {
    let fs = bd.fs;
    match bd.b {
        BDrop => Pure(fs),
        BMiss(n) => Pure(with_pending(fs, fs.pending ++ [Pend(i, n)])),
        BProof(pr, uses) => infer(pr).bind(λ c => match c {
            Refused(_) => Pure(fs),
            Accepted(ty) => sides_of(ty).bind(λ o => match o {
                None => Pure(fs),
                Some(p) => read_term(fs.g, p.fst).bind(λ x => read_term(x.g, p.snd).bind(λ y =>
                    Pure(Facts(with_definition(l, Graph(y.g.eg.union(x.node, y.node, Fact(pr, lm.name, uses)), y.g.info, y.g.atoms), i, lm.name, x.node, y.node), fs.read, fs.skipped, fs.lemmas.update(i.lemma, λ m => bump_added(m, is_def(i.def))), fs.seen, fs.offered, fs.locals, fs.givens, fs.pending, fs.cf)))),
            }),
        }),
    }
}

fn add_insts(l: GrindLaws, fs: Facts, is: List<Inst>) → Tac<Facts> {
    match is {
        Nil => Pure(fs),
        Cons(i, rest) => match fs.lemmas.nth(i.lemma) {
            None => add_insts(l, fs, rest),
            Some(lm) => build(l, fs, lm.name, lm.proof, [], i.args, 0).bind(λ bd => on_built(l, bd, i, lm)).bind(λ f2 => add_insts(l, f2, rest)),
        },
    }
}

// The proof of `l = r` from a closed graph whose classes hold both sides.
fn proved(report: Bool, l: GrindLaws, fs: Facts, lhs: Nat, rhs: Nat) → Tac<Expr> {
    match fs.g.eg.explain(proof_alg(l, fs.g), lhs, rhs) {
        None => fail("grind: the two sides are in one class, but no path between them was found", []),
        Some(p) => finish_with(report, fs, names_once(match fs.g.eg.explain(cited_alg(), lhs, rhs) { None => [], Some(ns) => ns }, []), p),
    }
}

// The goal from a contradiction: `absurd`'s proof is of it; a
// disequality's is of `False`, which is the goal, or `exfalso` takes to an
// equation goal (its sides spelled: under the binders the goal opened, the
// proof is inferred, not checked), or `elim_false` to any other.
fn by_contra(report: Bool, l: GrindLaws, fs: Facts, gt: GoalAt, c: Contra) → Tac<Expr> {
    is_false(l.fals, gt.target).bind(λ f => finish_with(report, fs, names_once(c.uses, []), match c.of_false {
        False => c.proof,
        True => match f {
            True => c.proof,
            False => match gt.sides {
                Some(p) => apps(Global(l.exfalso), [Blank, expr_at(fs.g, p.a), expr_at(fs.g, p.b), c.proof]),
                None => apps(Global(l.false_elim), [Blank, c.proof]),
            },
        },
    }))
}

// Do the goal's sides meet?
fn meets(g: Graph, gt: GoalAt) → Option<Node2> {
    match gt.sides {
        None => None,
        Some(p) => match class_of(g, p.a).same(class_of(g, p.b)) { True => Some(p), False => None },
    }
}

// A closed graph: proved (the sides meet, or a contradiction), or not.
fn concluded(report: Bool, l: GrindLaws, fs: Facts, gt: GoalAt) → Option<Tac<Expr>> {
    match meets(fs.g, gt) {
        Some(p) => Some(proved(report, l, fs, p.a, p.b)),
        None => match fs.cf.contra {
            Some(c) => Some(by_contra(report, l, fs, gt, c)),
            None => None,
        },
    }
}

// A closed graph: proved, or stuck for the reason `why`.
fn settle(report: Bool, l: GrindLaws, fs: Facts, gt: GoalAt, why: String) → Tac<Expr> {
    match concluded(report, l, fs, gt) {
        Some(t) => t,
        None => stuck(fs.g, fs, gt, why),
    }
}

fn on_found(t: Tac<Found>, k: Found → Tac<Expr>) → Tac<Expr> { t.bind(k) }

// Close the graph; prove `l = r` from it, or instantiate the lemmas once
// more (at most `rounds` times), or fail with what it holds.
fn saturate(rounds: Nat, done: Nat, report: Bool, l: GrindLaws, fs0: Facts, gt: GoalAt) → Tac<Expr> {
    match rounds {
        Zero => on_closed(ctor_closed(l, fs0, grind_ctor_fuel()), λ fs => settle(report, l, fs, gt, "stopped after " ++ decimal_name(Succ(done), done) ++ " rounds")),
        Succ(r) => on_closed(ctor_closed(l, fs0, grind_ctor_fuel()), λ fs => {
            let g = fs.g;
            match concluded(report, l, fs, gt) {
                Some(t) => t,
                None => match fs.lemmas {
                    Nil => stuck(g, fs, gt, ""),
                    Cons(_, _) => {
                        let table = g.eg.class_table();
                        settled(table.len() + g.eg.edges.len(), on_found(round_insts(g, table, fs.lemmas, 0, fs.seen, grind_round_cap()), λ strict =>
                            on_found(resolve_nears(g, strict.lemmas, strict.nears, fs.seen ++ strict.insts, grind_defeq_budget(), []), λ near => {
                            let insts = strict.insts ++ near.insts;
                            let next = Facts(g, fs.read, fs.skipped, near.lemmas, fs.seen ++ insts, fs.offered, fs.locals, fs.givens, fs.pending, fs.cf);
                            match insts {
                                Nil => stuck(g, next, gt, match done { Zero => "no instance in the graph", Succ(_) => "no new instance after " ++ decimal_name(Succ(done), done) ++ " rounds" }),
                                Cons(_, _) => add_insts(l, with_pending(next, []), insts ++ next.pending.map(λ p => p.inst)).bind(λ fs2 => saturate(r, Succ(done), report, l, fs2, gt)),
                            }
                        })))
                    },
                },
            }
        }),
    }
}

// The goal with its binders opened (`a ≠ b`, `(n: Nat) → f(n) = n`): the
// statement under them, its sides if it is an equation, and the binders'
// locals in order.
record Opening { target: Handle, sides: Option<Pair<Handle, Handle>>, opened: List<LocalInfo> }

fn open_goal(fuel: Nat, ty: Handle, opened: List<LocalInfo>) → Tac<Opening> {
    sides_of(ty).bind(λ o => match o {
        Some(p) => Pure(Opening(ty, Some(p), opened)),
        None => match fuel {
            Zero => Pure(Opening(ty, None, opened)),
            Succ(f) => whnf(ty).bind(λ c => match c {
                Refused(_) => Pure(Opening(ty, None, opened)),
                Accepted(w) => view(w).bind(λ v => match v {
                    HPi(_) => open(w, "h").bind(λ oc => match oc {
                        Refused(_) => Pure(Opening(ty, None, opened)),
                        Accepted(op) => open_goal(f, op.body, opened ++ [op.local]),
                    }),
                    _ => Pure(Opening(ty, None, opened)),
                }),
            }),
        },
    })
}

// The goal's sides read into the graph, when it is an equation.
record GoalRead { g: Graph, sides: Option<Node2> }

fn read_goal(g: Graph, o: Option<Pair<Handle, Handle>>) → Tac<GoalRead> {
    match o {
        None => Pure(GoalRead(g, None)),
        Some(p) => read_term(g, p.fst).bind(λ x => read_term(x.g, p.snd).bind(λ y => Pure(GoalRead(y.g, Some(Node2(x.node, y.node)))))),
    }
}

// `grind_run`: the goal, its binders opened, its locals and the opened
// binders', the lemmas `names` names and the facts `hints` prove,
// saturated.
fn grind_run(names: List<String>, hints: List<Expr>, report: Bool) → Tac<Expr> {
    goal().bind(λ gl => grind_laws().bind(λ l => law("Succ").bind(λ sr => resolve("grind::succ_fn").bind(λ sc => match sc {
        Refused(why) => fail("grind: `grind::succ_fn`: " ++ why, []),
        Accepted(sh) => open_goal(64, gl.target, []).bind(λ og => read_goal(graph_seeded(sr.id, sh), og.sides).bind(λ gr => {
            let locals = gl.locals ++ og.opened;
            let gt = GoalAt(gr.sides, og.target, og.opened.map(λ lo => lo.ref));
            read_locals(Facts(gr.g, [], [], [], [], [], locals, [], [], cstate_empty(l.fals, sr.id, og.target)), locals).bind(λ fs => read_hints(fs, hints, 0).bind(λ fs2 =>
            read_names(fs2, names).bind(λ fs3 =>
            saturate(grind_rounds(), 0, report, l, fs3, gt).bind(λ p => Pure(lams(gt.intros, p))))))
        })),
    }))))
}

// `grind_using(names, hints)`: prove the goal, an equation, from the
// equations among its locals, the lemmas `names` names (resolved where the
// `by` is: `"List::append_assoc"`) and the facts `hints` prove, closed under
// congruence. An equation under binders, among any of them, is a lemma: its
// instances are found by matching one side against the graph's terms, in
// rounds, until the goal closes or no new instance turns up.
fn grind_using(names: List<String>, hints: List<Expr>) → Tac<Expr> { grind_run(names, hints, False) }

// `grind_report(names, hints)`: `grind_using`, which on success also says
// which of the hints and named lemmas its proof cites and which it does not
// (a `tactic-report` warning), so the call can be narrowed to those it used.
fn grind_report(names: List<String>, hints: List<Expr>) → Tac<Expr> { grind_run(names, hints, True) }

// `grind_with(hints)`: `grind_using` with no lemma named.
fn grind_with(hints: List<Expr>) → Tac<Expr> { grind_run([], hints, False) }

// `grind()`: from the goal's locals alone.
fn grind() → Tac<Expr> { grind_run([], [], False) }

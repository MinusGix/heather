// What `simp` (lib/std/tactic/simp.hthr) reads: its sets of laws.
//
// A set is a registered value (`register def …: SimpSet = …;`,
// docs/registered-values-design.md) written in the module that owns the
// facts, with each law named by `name_of`, so a name is checked where the
// lemma is in scope and the set's contents are one declaration to read
// (docs/simp-design.md §3). A set registered as a type's default is used by
// `by simp()` at every goal that has a value of that type, and at no other
// (§3.1): the laws a call gets are a function of the goal's types, not of
// what the module happens to import.
//
// This module holds the set type and the defaults of the carriers below
// the tactics (`Nat`, `List`, `[A; n]`, `BitVec`), whose own modules cannot
// import `string`. A carrier above it (`Stored`, `Valuation`) registers its
// set in its own module.

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;
import list_window;
import vector;
import bitvec;
import bitvec_nat;
import bitvec_concat;
import bitvec_shift_nat;

// `name`: what a report calls the set. `default_for`: the types (by
// `name_of`) whose goals get the set without naming it. `laws`: proofs of
// equations, of a designated relation's instances or of `P ↔ Q` between
// statements, under any hypotheses, each used left to right.
record SimpSet { name: String, default_for: List<String>, laws: List<String> }

// A set a call names: `by simp([S])`.
fn simp_set(name: String, laws: List<String>) → SimpSet { SimpSet(name, [], laws) }

// A type's default set.
fn simp_default(name: String, ty: String, laws: List<String>) → SimpSet { SimpSet(name, [ty], laws) }

// `Nat`: units and zeros on the left (the right ones compute), sums and
// products nested to the right.
register def simp_nat_arith: SimpSet = simp_default("Nat::arith", name_of(Nat), [
    name_of(Nat::add_left_zero),
    name_of(Nat::mul_left_zero),
    name_of(Nat::mul_left_one),
    name_of(Nat::sub_zero),
    name_of(Nat::sub_self),
    name_of(Nat::add_assoc),
    name_of(Nat::mul_assoc),
]);

// `List`: appends nested to the right with no empty operand, `len` and
// `map` pushed to the leaves, membership in an append as a disjunction,
// and a window of count 0 gone: `take` and `drop` recurse on the list
// first, so `xs.take(0)` and `xs.drop(0)` are stuck at a neutral `xs`
// (recursing on the count first instead breaks every list-induction proof
// of a `take`/`drop` law at its `Nil` arm; measured 2026-11-14).
register def simp_list_shape: SimpSet = simp_default("List::shape", name_of(List), [
    name_of(List::take_zero),
    name_of(List::drop_zero),
    name_of(List::append_nil),
    name_of(List::append_assoc),
    name_of(List::len_append),
    name_of(List::len_map),
    name_of(List::map_append),
    name_of(List::map_map),
    name_of(List::mem_append_iff),
]);

// `List` windows: a prefix or suffix of a known length, of an append at
// its seam, of an update; lengths of each. What a proof about a buffer
// read in blocks rewrites by (lib/native/crypto/sha256_stream_agreement.hthr).
// A law with a hypothesis fires where the call's discharger proves it.
register def simp_list_windows: SimpSet = simp_default("List::windows", name_of(List), [
    name_of(List::take_len),
    name_of(List::drop_len),
    name_of(List::take_append_len),
    name_of(List::drop_append_len),
    name_of(List::drop_drop),
    name_of(List::len_take),
    name_of(List::len_drop),
    name_of(List::len_update),
    name_of(List::take_update_snoc),
    name_of(List::joined_snoc),
]);

// `[A; n]`: a vector's entries are a list, and an update or a `snoc` is the
// list's.
register def simp_vector_entries: SimpSet = simp_default("Vec::entries", "Vec", [
    name_of(vector_entries_len),
    name_of(vector_entries_update),
    name_of(vector_entries_snoc),
]);

// `BitVec`: a word read as its number. Conversions cancel (the number's
// bound is the hypothesis), and a concatenation, a right shift and a low
// mask are their arithmetic.
register def simp_bitvec_nat: SimpSet = simp_default("BitVec::nat", name_of(BitVec), [
    name_of(BitVec::ofNat_toNat),
    name_of(BitVec::toNat_ofNat),
    name_of(BitVec::toNat_concat),
    name_of(BitVec::toNat_shift_right),
    name_of(BitVec::toNat_band_low_mask),
    name_of(BitVec::eq_bit_self),
]);

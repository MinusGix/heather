// `sets`: prove a membership goal over lists read as sets, from the
// membership facts in scope, by a truth table
// (issues/finite-set-membership-solver.md,
// docs/native-mathematics-survey.md §1).
//
// The goal, after its `→`s and `(i: A) →`s are introduced (an inclusion
// such as `a.Inside(m)` unfolds to them) and a conjunction or a record of
// facts is split field by field, is `Mem(x, s)`, a Boolean spelling of it
// known `True` or `False` (`absent(x, s).IsTrue()`, `ids.holds(x) = True`),
// `False`, which is tried at each element a hypothesis is about, or a
// registered relation between two sets known true (`a.within(b)`,
// `disjoint(xs, ys)`), proved through its intro law from the function type
// the law takes, which is then proved as any other goal.
//
// Every hypothesis about the same element is read as a fact: `Mem(x, s)`,
// `¬Mem(x, s)` (or `Mem(x, s) → False`), a spelling known `True` or
// `False`, `x = e` and `¬(x = e)` either way round, each half of a
// conjunction, and every function type that, applied to `x`, is
// `Mem(x, a) → C` (an inclusion, or a definition that unfolds to one),
// `C` being `Mem(x, b)`, `¬Mem(x, b)` or a spelling of either; a registered
// relation known true is read through its elim law as such a function
// type. A fact about an element `x` is known equal to is moved to `x`.
// Hypotheses of any other shape are skipped.
//
// Each set is read into a `SetExpr`: `Nil` and `Cons(e, s)` by their
// constructors, `s.filter(p)` as a filter, an operation registered as a
// `SetOpEntry` (`++` in lib/std/data/set/set_ops.hthr; a module adds its
// own beside their laws, as native_alloc does `union` and `minus`) as that
// operation, a call of anything else through its definition when that is a
// call again, and otherwise as an atom; atoms, elements and predicates are
// told apart up to definitional equality, and an element convertible to `x`
// is the fact `x ∈ [e]`. A spelling is a registered `SetBitEntry` (native's
// `absent`), `!` of one, or a call whose definition is one. A relation is a
// registered `SetRelEntry` (native's `within`, `disjoint`).
//
// A client module needs only `import set_tactic;`: `by` finds the tactic
// protocol through the import closure, so `tactic`'s short names (`pure`,
// `open`, `goal`) need not be in the client's scope.
//
// The tactic evaluates the truth table itself first: when the facts do not
// imply the goal it fails with an assignment that falsifies it, naming each
// atom, element and predicate and whether `x` is in, equal to, or passes it.
// When they do, it returns `set_solve(…)` with the verdict proved by `refl`,
// so the kernel evaluates the same table once more.

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;
import tactic;
import set_solve;
import set_ops;

// ---------------------------------------------------------------------------
// What the tactic names

record SetOpHead { f: GlobalRef, conn: SetConn, law: GlobalRef, implicits: Nat }

record SetBitHead { f: GlobalRef, law: GlobalRef, negated: Bool, implicits: Nat }

record SetRelHead { f: GlobalRef, elim: GlobalRef, intro: GlobalRef, implicits: Nat }

// The lemmas that move between a spelling, membership and an element's
// equations (lib/std/data/set/set_solve.hthr), and the globals that tell a
// spelling apart.
record SetLemmas {
    not_g: GlobalRef, is_true: GlobalRef, bool_ty: GlobalRef, and_ty: GlobalRef,
    spell_true: GlobalRef, spell_false: GlobalRef, spell_is_true: GlobalRef, spell_is_false: GlobalRef,
    not_not: GlobalRef, not_of_true: GlobalRef, not_of_false: GlobalRef,
    true_of_not_false: GlobalRef, false_of_not_true: GlobalRef, eq_true_of_is: GlobalRef, is_of_eq_true: GlobalRef,
    mem_of_eq: GlobalRef, mem_of_eq_sym: GlobalRef, mem_transport: GlobalRef, not_transport: GlobalRef, eq_sym: GlobalRef,
    comp: GlobalRef, fapart: GlobalRef,
}

record SetHeads {
    mem: GlobalRef, false_ty: GlobalRef, filter: GlobalRef, dec_eq: GlobalRef, rfl: GlobalRef,
    solve: GlobalRef, env: GlobalRef, op: GlobalRef, nil: GlobalRef, cons: GlobalRef,
    or: GlobalRef, and: GlobalRef, diff: GlobalRef,
    atom: GlobalRef, snil: GlobalRef, scons: GlobalRef, sfilter: GlobalRef, sop: GlobalRef,
    fmem: GlobalRef, fnot: GlobalRef, fsub: GlobalRef, gmem: GlobalRef, gnot: GlobalRef, gfalse: GlobalRef,
    held_nil: GlobalRef, held_cons: GlobalRef, mem_self: GlobalRef, not_single: GlobalRef, not_single_sym: GlobalRef,
    list_ty: GlobalRef, pred_ty: GlobalRef, op_ty: GlobalRef, fact_ty: GlobalRef,
    ops: List<SetOpHead>,
    lem: SetLemmas,
    bits: List<SetBitHead>,
    rels: List<SetRelHead>,
}

fn sets_global(name: String) → Tac<GlobalRef> {
    lookup(name).bind(λ c => match c { Accepted(g) => pure(g), Refused(why) => fail("sets: " ++ why, []) })
}

fn sets_op_heads(es: List<SetOpEntry>) → Tac<List<SetOpHead>> {
    match es {
        Nil => pure(Nil),
        Cons(e, rest) => lookup(e.op).bind(λ c => match c {
            Refused(_) => sets_op_heads(rest),
            Accepted(f) => sets_global(e.law).bind(λ law => sets_op_heads(rest).bind(λ hs => pure(Cons(SetOpHead(f, e.conn, law, e.implicits), hs)))),
        }),
    }
}

fn sets_bit_heads(es: List<SetBitEntry>) → Tac<List<SetBitHead>> {
    match es {
        Nil => pure(Nil),
        Cons(e, rest) => lookup(e.op).bind(λ c => match c {
            Refused(_) => sets_bit_heads(rest),
            Accepted(f) => sets_global(e.law).bind(λ law => sets_bit_heads(rest).bind(λ hs => pure(Cons(SetBitHead(f, law, e.negated, e.implicits), hs)))),
        }),
    }
}

fn sets_rel_heads(es: List<SetRelEntry>) → Tac<List<SetRelHead>> {
    match es {
        Nil => pure(Nil),
        Cons(e, rest) => lookup(e.op).bind(λ c => match c {
            Refused(_) => sets_rel_heads(rest),
            Accepted(f) => sets_global(e.elim).bind(λ elim => sets_global(e.intro).bind(λ intro =>
                sets_rel_heads(rest).bind(λ hs => pure(Cons(SetRelHead(f, elim, intro, e.implicits), hs))))),
        }),
    }
}

fn sets_lemmas() → Tac<SetLemmas> {
    let not_g <- sets_global("bool::Bool::not");
    let is_true <- sets_global("bool::Bool::IsTrue");
    let bool_ty <- sets_global("Bool");
    let and_ty <- sets_global("logic::And");
    let spell_true <- sets_global("set_solve::set_spell_true");
    let spell_false <- sets_global("set_solve::set_spell_false");
    let spell_is_true <- sets_global("set_solve::set_spell_is_true");
    let spell_is_false <- sets_global("set_solve::set_spell_is_false");
    let not_not <- sets_global("set_solve::set_reflects_not_not");
    let not_of_true <- sets_global("set_solve::set_not_of_true");
    let not_of_false <- sets_global("set_solve::set_not_of_false");
    let true_of_not_false <- sets_global("set_solve::set_true_of_not_false");
    let false_of_not_true <- sets_global("set_solve::set_false_of_not_true");
    let eq_true_of_is <- sets_global("set_solve::set_eq_true_of_is");
    let is_of_eq_true <- sets_global("set_solve::set_is_of_eq_true");
    let mem_of_eq <- sets_global("set_solve::set_mem_of_eq");
    let mem_of_eq_sym <- sets_global("set_solve::set_mem_of_eq_sym");
    let mem_transport <- sets_global("set_solve::set_mem_transport");
    let not_transport <- sets_global("set_solve::set_not_transport");
    let eq_sym <- sets_global("set_solve::set_eq_sym");
    let comp <- sets_global("set_solve::set_comp");
    let fapart <- sets_global("set_solve::set_fact_apart");
    pure(SetLemmas(not_g, is_true, bool_ty, and_ty, spell_true, spell_false, spell_is_true, spell_is_false,
        not_not, not_of_true, not_of_false, true_of_not_false, false_of_not_true, eq_true_of_is, is_of_eq_true,
        mem_of_eq, mem_of_eq_sym, mem_transport, not_transport, eq_sym, comp, fapart))
}

fn sets_heads(entries: List<SetOpEntry>, bit_entries: List<SetBitEntry>, rel_entries: List<SetRelEntry>) → Tac<SetHeads> {
    let mem <- sets_global("list::Mem");
    let false_ty <- sets_global("False");
    let filter <- sets_global("list::List::filter");
    let dec_eq <- sets_global("set_solve::set_dec_eq_type");
    let rfl <- sets_global("tactic::rfl");
    let solve <- sets_global("set_solve::set_solve");
    let env <- sets_global("set_solve::set_env");
    let op <- sets_global("set_solve::set_op");
    let nil <- sets_global("set_solve::set_list_nil");
    let cons <- sets_global("set_solve::set_list_cons");
    let or <- sets_global("set_solve::set_or");
    let and <- sets_global("set_solve::set_and");
    let diff <- sets_global("set_solve::set_diff");
    let atom <- sets_global("set_solve::set_atom_e");
    let snil <- sets_global("set_solve::set_nil_e");
    let scons <- sets_global("set_solve::set_cons_e");
    let sfilter <- sets_global("set_solve::set_filter_e");
    let sop <- sets_global("set_solve::set_op_e");
    let fmem <- sets_global("set_solve::set_fact_mem");
    let fnot <- sets_global("set_solve::set_fact_not");
    let fsub <- sets_global("set_solve::set_fact_imp");
    let gmem <- sets_global("set_solve::set_goal_mem");
    let gnot <- sets_global("set_solve::set_goal_not");
    let gfalse <- sets_global("set_solve::set_goal_false");
    let held_nil <- sets_global("set_solve::set_held_nil");
    let held_cons <- sets_global("set_solve::set_held_cons");
    let mem_self <- sets_global("set_solve::set_mem_self");
    let not_single <- sets_global("set_solve::set_not_single");
    let not_single_sym <- sets_global("set_solve::set_not_single_sym");
    let list_ty <- sets_global("set_solve::set_list_type");
    let pred_ty <- sets_global("set_solve::set_pred_type");
    let op_ty <- sets_global("set_solve::set_op_type");
    let fact_ty <- sets_global("set_solve::set_fact_type");
    let ops <- sets_op_heads(entries);
    let lem <- sets_lemmas();
    let bits <- sets_bit_heads(bit_entries);
    let rels <- sets_rel_heads(rel_entries);
    pure(SetHeads(mem, false_ty, filter, dec_eq, rfl, solve, env, op, nil, cons, or, and, diff,
        atom, snil, scons, sfilter, sop, fmem, fnot, fsub, gmem, gnot, gfalse, held_nil, held_cons, mem_self, not_single, not_single_sym, list_ty, pred_ty, op_ty, fact_ty, ops, lem, bits, rels))
}

// ---------------------------------------------------------------------------
// Reading sets

// The leaves found so far, each list in index order.
record SetLeaves { sets: List<Handle>, elts: List<Handle>, preds: List<Handle>, ops: List<SetOpHead> }

record SetRead { leaves: SetLeaves, e: SetExpr }

record SetInterned { all: List<Handle>, k: Nat }

fn sets_find(hs: List<Handle>, h: Handle, k: Nat) → Tac<Option<Nat>> {
    match hs {
        Nil => pure(None),
        Cons(g, rest) => defeq(Hd(g), Hd(h)).bind(λ same => match same {
            True => pure(Some(k)),
            False => sets_find(rest, h, Succ(k)),
        }),
    }
}

fn sets_intern(hs: List<Handle>, h: Handle) → Tac<SetInterned> {
    sets_find(hs, h, 0).bind(λ o => match o {
        Some(k) => pure(SetInterned(hs, k)),
        None => pure(SetInterned(hs ++ [h], hs.len())),
    })
}

fn sets_op_head(ops: List<SetOpHead>, g: GlobalRef) → Option<SetOpHead> {
    match ops { Nil => None, Cons(o, rest) => match g.id.same(o.f.id) { True => Some(o), False => sets_op_head(rest, g) } }
}

fn sets_op_index(ops: List<SetOpHead>, o: SetOpHead, k: Nat) → Option<Nat> {
    match ops { Nil => None, Cons(p, rest) => match o.f.id.same(p.f.id) { True => Some(k), False => sets_op_index(rest, o, Succ(k)) } }
}

fn sets_atom(L: SetLeaves, h: Handle) → Tac<SetRead> {
    sets_intern(L.sets, h).bind(λ i => pure(SetRead(SetLeaves(i.all, L.elts, L.preds, L.ops), SAtom(i.k))))
}

// How deep `sets_read` follows operations before reading a set as an atom.
def sets_fuel: Nat = 256;

fn sets_read(H: SetHeads, L: SetLeaves, h: Handle, fuel: Nat) → Tac<SetRead> {
    match fuel {
    Zero => sets_atom(L, h),
    Succ(n) => view(h).bind(λ v => match v {
        HGlobal(g, _, args) => match sets_op_head(H.ops, g) {
            Some(o) => match args {
                Cons(a, Cons(b, Nil)) => sets_read(H, L, a, n).bind(λ ra => sets_read(H, ra.leaves, b, n).bind(λ rb => {
                    let M = rb.leaves;
                    match sets_op_index(M.ops, o, 0) {
                        Some(i) => pure(SetRead(M, SOp(i, ra.e, rb.e))),
                        None => pure(SetRead(SetLeaves(M.sets, M.elts, M.preds, M.ops ++ [o]), SOp(M.ops.len(), ra.e, rb.e))),
                    }
                })),
                _ => sets_atom(L, h),
            },
            None => match g.id.same(H.filter.id) {
                True => match args {
                    Cons(s, Cons(p, Nil)) => sets_read(H, L, s, n).bind(λ rs => {
                        let M = rs.leaves;
                        sets_intern(M.preds, p).bind(λ i => pure(SetRead(SetLeaves(M.sets, M.elts, i.all, M.ops), SFilter(i.k, rs.e))))
                    }),
                    _ => sets_atom(L, h),
                },
                // A call of no operation known here: read through its
                // definition when that is a call again (`live_before(r, w,
                // out)` is a `union`), else an atom as written. A definition
                // that is a `match` or a literal would only add leaves, and
                // every leaf doubles the table.
                False => unfold(h).bind(λ c => match c {
                    Refused(_) => sets_atom(L, h),
                    Accepted(u) => view(u).bind(λ uv => match uv {
                        HGlobal(_, _, _) => sets_read(H, L, u, n),
                        _ => sets_atom(L, h),
                    }),
                }),
            },
        },
        HCtor(_, _, name, fields) => match string_eq_dec(name, "Nil") {
            Inl(_) => pure(SetRead(L, SNil)),
            Inr(_) => match string_eq_dec(name, "Cons") {
                Inl(_) => match fields {
                    Cons(e, Cons(t, Nil)) => sets_read(H, L, t, n).bind(λ rt => {
                        let M = rt.leaves;
                        sets_intern(M.elts, e).bind(λ i => pure(SetRead(SetLeaves(M.sets, i.all, M.preds, M.ops), SCons(i.k, rt.e))))
                    }),
                    _ => sets_atom(L, h),
                },
                Inr(_) => sets_atom(L, h),
            },
        },
        _ => sets_atom(L, h),
    }),
    }
}

// ---------------------------------------------------------------------------
// Building terms

fn apps(f: Expr, args: List<Expr>) → Expr { match args { Nil => f, Cons(a, rest) => apps(App(f, a), rest) } }

fn sets_app(f: GlobalRef, args: List<Expr>) → Expr {
    apps(Global(f), args)
}

// `f` applied to `k` arguments left to inference.
fn sets_blanks(f: Expr, k: Nat) → Expr { match k { Zero => f, Succ(j) => sets_blanks(App(f, Blank), j) } }

// A list literal of elements of type `ty`.
fn sets_list(H: SetHeads, ty: Expr, es: List<Expr>) → Expr {
    match es { Nil => App(Global(H.nil), ty), Cons(e, rest) => sets_app(H.cons, [ty, e, sets_list(H, ty, rest)]) }
}

fn sets_handles(hs: List<Handle>) → List<Expr> { match hs { Nil => Nil, Cons(h, rest) => Cons(Hd(h), sets_handles(rest)) } }

fn sets_conn(H: SetHeads, c: SetConn) → Expr {
    match c { SetOr => Global(H.or), SetAnd => Global(H.and), SetDiff => Global(H.diff) }
}

fn sets_ops(H: SetHeads, t: Expr, os: List<SetOpHead>) → List<Expr> {
    match os { Nil => Nil, Cons(o, rest) => Cons(sets_app(H.op, [t, sets_blanks(Global(o.f), o.implicits), sets_conn(H, o.conn), sets_blanks(Global(o.law), o.implicits)]), sets_ops(H, t, rest)) }
}

fn sets_quote(H: SetHeads, e: SetExpr) → Expr {
    match e {
        SAtom(k) => sets_app(H.atom, [NatLit(k)]),
        SNil => Global(H.snil),
        SCons(j, rest) => sets_app(H.scons, [NatLit(j), sets_quote(H, rest)]),
        SFilter(k, s) => sets_app(H.sfilter, [NatLit(k), sets_quote(H, s)]),
        SOp(i, a, b) => sets_app(H.sop, [NatLit(i), sets_quote(H, a), sets_quote(H, b)]),
    }
}

fn sets_quote_fact(H: SetHeads, f: SetFact) → Expr {
    match f {
        FMem(e) => sets_app(H.fmem, [sets_quote(H, e)]),
        FNot(e) => sets_app(H.fnot, [sets_quote(H, e)]),
        FImp(a, b) => sets_app(H.fsub, [sets_quote(H, a), sets_quote(H, b)]),
        FApart(a, b) => sets_app(H.lem.fapart, [sets_quote(H, a), sets_quote(H, b)]),
    }
}

fn sets_quote_facts(H: SetHeads, fs: List<SetFact>) → List<Expr> {
    match fs { Nil => Nil, Cons(f, rest) => Cons(sets_quote_fact(H, f), sets_quote_facts(H, rest)) }
}

fn sets_held(H: SetHeads, ps: List<Expr>) → Expr {
    match ps { Nil => Global(H.held_nil), Cons(p, rest) => sets_app(H.held_cons, [Blank, Blank, p, sets_held(H, rest)]) }
}

fn sets_quote_goal(H: SetHeads, g: SetGoal) → Expr {
    match g {
        GMem(e) => sets_app(H.gmem, [sets_quote(H, e)]),
        GNot(e) => sets_app(H.gnot, [sets_quote(H, e)]),
        GFalse => Global(H.gfalse),
    }
}

fn sets_conns(os: List<SetOpHead>) → List<SetConn> { match os { Nil => Nil, Cons(o, rest) => Cons(o.conn, sets_conns(rest)) } }

// ---------------------------------------------------------------------------
// Reading statements

// `Mem(y, s)`, as its element and set.
record SetMem { elt: Handle, set: Handle }

fn sets_mem_of(H: SetHeads, v: Head) → Option<SetMem> {
    match v {
        HGlobal(g, _, args) => match g.id.same(H.mem.id) {
            True => match args { Cons(y, Cons(s, Nil)) => Some(SetMem(y, s)), _ => None },
            False => None,
        },
        _ => None,
    }
}

fn sets_is_false(H: SetHeads, v: Head) → Bool {
    match v { HGlobal(g, _, _) => g.id.same(H.false_ty.id), _ => False }
}

fn sets_is_global(v: Head, g: GlobalRef) → Bool {
    match v { HGlobal(f, _, _) => f.id.same(g.id), _ => False }
}

// `True` or `False` of `Bool`, as written.
fn sets_bool_value(H: SetHeads, v: Head) → Option<Bool> {
    match v {
        HCtor(ty, _, name, fields) => match fields {
            Nil => match ty.id.same(H.lem.bool_ty.id) {
                True => match string_eq_dec(name, "True") { Inl(_) => Some(True), Inr(_) => Some(False) },
                False => None,
            },
            _ => None,
        },
        _ => None,
    }
}

// One layer of `h`, past a definition or a substitution the view does not
// present (the body of an unfolded `¬P` is one).
fn sets_view(h: Handle) → Tac<Head> {
    view(h).bind(λ v => match v {
        HOther => whnf(h).bind(λ c => match c { Accepted(w) => view(w), Refused(_) => pure(v) }),
        _ => pure(v),
    })
}

// A Boolean that spells `elt ∈ set`: `r` proves `Reflects(Mem(elt, set),
// c)` where `c` is the Boolean `b` itself, or `!b` when `neg`.
record SetBit { elt: Handle, set: Handle, neg: Bool, r: Expr, b: Handle }

fn sets_bit_head(bs: List<SetBitHead>, g: GlobalRef) → Option<SetBitHead> {
    match bs { Nil => None, Cons(e, rest) => match g.id.same(e.f.id) { True => Some(e), False => sets_bit_head(rest, g) } }
}

// `b` read as a spelling: a registered spelling applied to an element and
// a set, `!` of a spelling, or a call whose definition is one of these
// (`ids.holds(x)` is `!absent(x, ids)`).
fn sets_bit(H: SetHeads, b: Handle, fuel: Nat) → Tac<Option<SetBit>> {
    match fuel {
        Zero => pure(None),
        Succ(n) => view(b).bind(λ v => match v {
            HGlobal(g, _, args) => match g.id.same(H.lem.not_g.id) {
                True => match args {
                    Cons(u, Nil) => sets_bit(H, u, n).bind(λ o => match o {
                        None => pure(None),
                        Some(l) => match l.neg {
                            True => pure(Some(SetBit(l.elt, l.set, False, l.r, b))),
                            False => infer(Hd(l.elt)).bind(λ c => match c {
                                Refused(_) => pure(None),
                                Accepted(t) => pure(Some(SetBit(l.elt, l.set, True,
                                    sets_app(H.lem.not_not, [Hd(t), Hd(l.elt), Hd(l.set), Hd(l.b), l.r]), b))),
                            }),
                        },
                    }),
                    _ => pure(None),
                },
                False => match sets_bit_head(H.bits, g) {
                    Some(e) => match args {
                        Cons(y, Cons(s, Nil)) => pure(Some(SetBit(y, s, e.negated, apps(sets_blanks(Global(e.law), e.implicits), [Hd(y), Hd(s)]), b))),
                        _ => pure(None),
                    },
                    None => unfold(b).bind(λ c => match c {
                        Refused(_) => pure(None),
                        Accepted(u) => view(u).bind(λ uv => match uv {
                            HGlobal(_, _, _) => sets_bit(H, u, n).bind(λ o => match o {
                                None => pure(None),
                                Some(l) => pure(Some(SetBit(l.elt, l.set, l.neg, l.r, b))),
                            }),
                            _ => pure(None),
                        }),
                    }),
                },
            },
            _ => pure(None),
        }),
    }
}

// The spelled `b` known to be `v`, as a membership literal: the element,
// the set, whether the element is in it, and the lemmas (each applied to
// the last's result) that turn a proof of `b = v` into one of it.
record SetConv { elt: Handle, set: Handle, holds: Bool, steps: List<Expr> }

fn sets_bit_conv(H: SetHeads, l: SetBit, v: Bool) → Tac<Option<SetConv>> {
    infer(Hd(l.elt)).bind(λ c => match c {
        Refused(_) => pure(None),
        Accepted(t) => {
            let T = Hd(t);
            let x = Hd(l.elt);
            let s = Hd(l.set);
            let b = Hd(l.b);
            let nb = App(Global(H.lem.not_g), b);
            let M = H.lem;
            pure(Some(match l.neg {
                False => match v {
                    True => SetConv(l.elt, l.set, True, [sets_app(M.spell_true, [T, x, s, b, l.r])]),
                    False => SetConv(l.elt, l.set, False, [sets_app(M.spell_false, [T, x, s, b, l.r])]),
                },
                True => match v {
                    True => SetConv(l.elt, l.set, False, [App(Global(M.not_of_true), b), sets_app(M.spell_false, [T, x, s, nb, l.r])]),
                    False => SetConv(l.elt, l.set, True, [App(Global(M.not_of_false), b), sets_app(M.spell_true, [T, x, s, nb, l.r])]),
                },
            }))
        },
    })
}

// The steps applied to a proof, and composed after a function.
fn sets_steps_apply(steps: List<Expr>, p: Expr) → Expr {
    match steps { Nil => p, Cons(f, rest) => sets_steps_apply(rest, App(f, p)) }
}

fn sets_steps_after(H: SetHeads, steps: List<Expr>, g: Expr) → Expr {
    match steps { Nil => g, Cons(f, rest) => sets_steps_after(H, rest, apps(Global(H.lem.comp), [Blank, Blank, Blank, f, g])) }
}

record SetLit { elt: Handle, set: Handle, holds: Bool, proof: Expr }

fn sets_bit_lit(H: SetHeads, l: SetBit, v: Bool, hb: Expr) → Tac<Option<SetLit>> {
    sets_bit_conv(H, l, v).bind(λ o => match o {
        None => pure(None),
        Some(cv) => pure(Some(SetLit(cv.elt, cv.set, cv.holds, sets_steps_apply(cv.steps, hb)))),
    })
}

// A registered relation between two sets applied to them.
record SetRel { head: SetRelHead, a: Handle, b: Handle }

fn sets_rel_head(rs: List<SetRelHead>, g: GlobalRef) → Option<SetRelHead> {
    match rs { Nil => None, Cons(e, rest) => match g.id.same(e.f.id) { True => Some(e), False => sets_rel_head(rest, g) } }
}

fn sets_rel(H: SetHeads, b: Handle) → Tac<Option<SetRel>> {
    view(b).bind(λ v => match v {
        HGlobal(g, _, args) => match sets_rel_head(H.rels, g) {
            Some(e) => match args { Cons(a, Cons(c, Nil)) => pure(Some(SetRel(e, a, c))), _ => pure(None) },
            None => pure(None),
        },
        _ => pure(None),
    })
}

// `h: f(a, b).IsTrue()` read through the relation's `elim`.
fn sets_rel_elim(r: SetRel, h: Expr) → Expr {
    apps(sets_blanks(Global(r.head.elim), r.head.implicits), [Hd(r.a), Hd(r.b), h])
}

// `f(a, b).IsTrue()` proved through the relation's `intro`, its premise by
// `solve` (the tactic itself, on that premise).
fn sets_rel_intro(r: SetRel, ls: List<LocalInfo>, solve: Tac<Expr>) → Tac<Expr> {
    let intro = apps(sets_blanks(Global(r.head.intro), r.head.implicits), [Hd(r.a), Hd(r.b)]);
    let t <- infer(intro).or_fail("sets: ");
    let v <- sets_view(t);
    match v {
        HPi(dom) => focus(GoalInfo(dom, ls), solve).bind(λ p => pure(App(intro, p))),
        _ => fail("sets: a relation's intro law does not take the premise to prove", [At(intro, Tried("the law", "not a function"))]),
    }
}

// A hypothesis: its proof, its name for messages, and its statement.
record SetGiven { proof: Expr, name: String, ty: Handle }

fn sets_givens_of(ls: List<LocalInfo>) → List<SetGiven> {
    match ls { Nil => Nil, Cons(l, rest) => Cons(SetGiven(Local(l.ref), l.name, l.ty), sets_givens_of(rest)) }
}

// What a hypothesis says, before it is read at an element: a membership
// literal (`Mem`, `¬Mem`, or a spelling known `True` or `False`), an
// equation or disequation between elements, a function type whose
// conclusion is about its argument (an inclusion, read once the element is
// known; a registered relation known true is read through its `elim` as
// one), a conjunction, or none of these.
inductive SetShape {
    ShapeLit(l: SetLit),
    ShapeEq(l: Handle, r: Handle, holds: Bool, proof: Expr),
    ShapeAll(proof: Expr),
    ShapeAnd,
    ShapeOther,
}

fn sets_lit_shape(o: Option<SetLit>) → SetShape { match o { None => ShapeOther, Some(l) => ShapeLit(l) } }

fn sets_pi_shape(H: SetHeads, gv: SetGiven, ty: Handle) → Tac<SetShape> {
    open(ty, "i").bind(λ c => match c {
        Refused(_) => pure(ShapeOther),
        Accepted(o) => match o.dependent {
            True => pure(ShapeAll(gv.proof)),
            False => sets_view(o.body).bind(λ bv => match sets_is_false(H, bv) {
                False => pure(ShapeAll(gv.proof)),
                True => sets_view(o.local.ty).bind(λ dv => match sets_mem_of(H, dv) {
                    Some(m) => pure(ShapeLit(SetLit(m.elt, m.set, False, gv.proof))),
                    None => match dv { HEq(l, r) => pure(ShapeEq(l, r, False, gv.proof)), _ => pure(ShapeOther) },
                }),
            }),
        },
    })
}

fn sets_shape_once(H: SetHeads, gv: SetGiven, ty: Handle) → Tac<SetShape> {
    view(ty).bind(λ v => match sets_mem_of(H, v) {
        Some(m) => pure(ShapeLit(SetLit(m.elt, m.set, True, gv.proof))),
        None => match v {
            HPi(_) => sets_pi_shape(H, gv, ty),
            HEq(l, r) => view(r).bind(λ rv => match sets_bool_value(H, rv) {
                Some(val) => sets_bit(H, l, sets_fuel).bind(λ o => match o {
                    None => match val {
                        False => pure(ShapeOther),
                        True => sets_rel(H, l).bind(λ orl => match orl {
                            None => pure(ShapeOther),
                            Some(rl) => pure(ShapeAll(sets_rel_elim(rl, sets_app(H.lem.is_of_eq_true, [Hd(l), gv.proof])))),
                        }),
                    },
                    Some(bit) => sets_bit_lit(H, bit, val, gv.proof).bind(λ ol => pure(sets_lit_shape(ol))),
                }),
                None => pure(ShapeEq(l, r, True, gv.proof)),
            }),
            HGlobal(g, _, args) => match g.id.same(H.lem.is_true.id) {
                True => match args {
                    Cons(b, Nil) => sets_bit(H, b, sets_fuel).bind(λ o => match o {
                        None => sets_rel(H, b).bind(λ orl => match orl {
                            None => pure(ShapeOther),
                            Some(rl) => pure(ShapeAll(sets_rel_elim(rl, gv.proof))),
                        }),
                        Some(bit) => sets_bit_lit(H, bit, True, sets_app(H.lem.eq_true_of_is, [Hd(b), gv.proof])).bind(λ ol => pure(sets_lit_shape(ol))),
                    }),
                    _ => pure(ShapeOther),
                },
                False => match g.id.same(H.lem.and_ty.id) { True => pure(ShapeAnd), False => pure(ShapeOther) },
            },
            _ => pure(ShapeOther),
        },
    })
}

// The shape as written, else as its head normal form (a subset predicate
// unfolds to its function type, `¬P` to `P → False`).
fn sets_shape(H: SetHeads, gv: SetGiven) → Tac<SetShape> {
    sets_shape_once(H, gv, gv.ty).bind(λ s => match s {
        ShapeOther => whnf(gv.ty).bind(λ c => match c { Accepted(w) => sets_shape_once(H, gv, w), Refused(_) => pure(ShapeOther) }),
        _ => pure(s),
    })
}

fn sets_field_givens(name: String, fs: List<FieldProj>) → Tac<List<SetGiven>> {
    match fs {
        Nil => pure(Nil),
        Cons(f, rest) => infer(Hd(f.term)).bind(λ c => sets_field_givens(name, rest).bind(λ more => match c {
            Refused(_) => pure(more),
            Accepted(ty) => pure(Cons(SetGiven(Hd(f.term), name ++ "." ++ f.name, ty), more)),
        })),
    }
}

// A conjunction's two halves, as hypotheses.
fn sets_halves(gv: SetGiven) → Tac<List<SetGiven>> {
    fields(gv.proof).bind(λ c => match c {
        Refused(_) => pure(Nil),
        Accepted(p) => sets_field_givens(gv.name, p.fields),
    })
}

// The facts read at `x`, with their proofs, in the order of the hypotheses.
record SetFacts { leaves: SetLeaves, facts: List<SetFact>, proofs: List<Expr>, read: List<Note> }

fn sets_same_elt(a, b: Handle) → Tac<Bool> { defeq(Hd(a), Hd(b)) }

fn SetFacts::add(self acc: SetFacts, L: SetLeaves, f: SetFact, proof: Expr, note: Note) → SetFacts {
    SetFacts(L, acc.facts ++ [f], acc.proofs ++ [proof], acc.read ++ [note])
}

// `Mem(y, s)` at `x`: `s` read, when `y` is `x`.
fn sets_mem_at(H: SetHeads, L: SetLeaves, x: Handle, v: Head) → Tac<Option<SetRead>> {
    match sets_mem_of(H, v) {
        None => pure(None),
        Some(m) => sets_same_elt(m.elt, x).bind(λ same => match same {
            False => pure(None),
            True => sets_read(H, L, m.set, sets_fuel).bind(λ r => pure(Some(r))),
        }),
    }
}

// A conclusion about an element: `Mem(y, s)`, `¬Mem(y, s)`, or a spelling
// known `True` or `False`, with the steps that turn a proof of it into
// membership or its negation.
fn sets_concl_once(H: SetHeads, ty: Handle) → Tac<Option<SetConv>> {
    sets_view(ty).bind(λ v => match sets_mem_of(H, v) {
        Some(m) => pure(Some(SetConv(m.elt, m.set, True, Nil))),
        None => match v {
            HPi(_) => open(ty, "m").bind(λ c => match c {
                Refused(_) => pure(None),
                Accepted(o) => match o.dependent {
                    True => pure(None),
                    False => sets_view(o.body).bind(λ bv => match sets_is_false(H, bv) {
                        False => pure(None),
                        True => sets_view(o.local.ty).bind(λ dv => match sets_mem_of(H, dv) {
                            Some(m) => pure(Some(SetConv(m.elt, m.set, False, Nil))),
                            None => pure(None),
                        }),
                    }),
                },
            }),
            HEq(l, r) => view(r).bind(λ rv => match sets_bool_value(H, rv) {
                None => pure(None),
                Some(val) => sets_bit(H, l, sets_fuel).bind(λ o => match o { None => pure(None), Some(bit) => sets_bit_conv(H, bit, val) }),
            }),
            HGlobal(g, _, args) => match g.id.same(H.lem.is_true.id) {
                False => pure(None),
                True => match args {
                    Cons(b, Nil) => sets_bit(H, b, sets_fuel).bind(λ o => match o {
                        None => pure(None),
                        Some(bit) => sets_bit_conv(H, bit, True).bind(λ oc => match oc {
                            None => pure(None),
                            Some(cv) => pure(Some(SetConv(cv.elt, cv.set, cv.holds, Cons(App(Global(H.lem.eq_true_of_is), Hd(b)), cv.steps)))),
                        }),
                    }),
                    _ => pure(None),
                },
            },
            _ => pure(None),
        },
    })
}

// As written, else as its head normal form (`¬P` unfolds to `P → False`).
fn sets_concl(H: SetHeads, ty: Handle) → Tac<Option<SetConv>> {
    sets_concl_once(H, ty).bind(λ o => match o {
        Some(_) => pure(o),
        None => whnf(ty).bind(λ c => match c { Accepted(w) => sets_concl_once(H, w), Refused(_) => pure(None) }),
    })
}

// `proof: Mem(x, a) → C` (its type `ty`), `C` a conclusion about `x`: the
// fact `FImp` when `C` says `x` is in `b`, `FApart` when it says `x` is not.
// The conclusion is read off `proof` applied to a hole, so that its handle
// lives where the goal does rather than under the binder.
fn sets_imp_at(H: SetHeads, x: Handle, acc: SetFacts, name: String, proof: Expr, ty: Handle) → Tac<Option<SetFacts>> {
    sets_view(ty).bind(λ tv => match tv {
        HPi(dom) => sets_view(dom).bind(λ dv => sets_mem_at(H, acc.leaves, x, dv).bind(λ oa => match oa {
            None => pure(None),
            Some(ra) => holes(proof, 1).bind(λ c => match c {
                Accepted(Cons(hh, Nil)) => infer(App(proof, Hd(hh))).bind(λ c2 => match c2 {
                    Refused(_) => pure(None),
                    Accepted(cod) => sets_concl(H, cod).bind(λ ocv => match ocv {
                        None => pure(None),
                        Some(cv) => sets_same_elt(cv.elt, x).bind(λ same => match same {
                            False => pure(None),
                            True => sets_read(H, ra.leaves, cv.set, sets_fuel).bind(λ rb => {
                                let p = sets_steps_after(H, cv.steps, proof);
                                pure(Some(match cv.holds {
                                    True => acc.add(rb.leaves, FImp(ra.e, rb.e), p, Tried(name, "an inclusion, at x")),
                                    False => acc.add(rb.leaves, FApart(ra.e, rb.e), p, Tried(name, "sets apart, at x")),
                                }))
                            }),
                        }),
                    }),
                }),
                _ => pure(None),
            }),
        })),
        _ => pure(None),
    })
}

// `proof: (i: A) → … → Mem(i, a) → C`, applied to `x`.
fn sets_all_at(H: SetHeads, x: Handle, acc: SetFacts, name: String, all: Expr) → Tac<Option<SetFacts>> {
    let proof = App(all, Hd(x));
    infer(proof).bind(λ c => match c {
        Refused(_) => pure(None),
        Accepted(ty) => sets_imp_at(H, x, acc, name, proof, ty),
    })
}

// `proof: x = e` (`holds`) or `¬(x = e)`, as `x ∈ [e]` or `x ∉ [e]`; the
// equation's other way round by the `_sym` lemmas.
fn sets_eq_fact(H: SetHeads, T: Expr, x: Handle, acc: SetFacts, name: String, e: Handle, holds: Bool, flipped: Bool, proof: Expr) → Tac<SetFacts> {
    let L = acc.leaves;
    let law: GlobalRef = match holds {
        True => match flipped { False => H.lem.mem_of_eq, True => H.lem.mem_of_eq_sym },
        False => match flipped { False => H.not_single, True => H.not_single_sym },
    };
    sets_intern(L.elts, e).bind(λ i => {
        let f: SetFact = match holds { True => FMem(SCons(i.k, SNil)), False => FNot(SCons(i.k, SNil)) };
        let note: String = match holds { True => "x is this element", False => "x is not this element" };
        pure(acc.add(SetLeaves(L.sets, i.all, L.preds, L.ops), f, sets_app(law, [T, Hd(x), Hd(e), proof]), Tried(name, note)))
    })
}

// An element `x` is known equal to: `e` proves `x = y`.
record SetAlias { y: Handle, e: Expr }

fn sets_aliases(H: SetHeads, T: Expr, x: Handle, gs: List<SetGiven>, acc: List<SetAlias>, fuel: Nat) → Tac<List<SetAlias>> {
    match fuel {
        Zero => pure(acc),
        Succ(n) => match gs {
            Nil => pure(acc),
            Cons(gv, rest) => sets_shape(H, gv).bind(λ s => match s {
                ShapeEq(a, b, holds, proof) => match holds {
                    False => sets_aliases(H, T, x, rest, acc, n),
                    True => sets_same_elt(a, x).bind(λ left => match left {
                        True => sets_aliases(H, T, x, rest, acc ++ [SetAlias(b, proof)], n),
                        False => sets_same_elt(b, x).bind(λ right => match right {
                            True => sets_aliases(H, T, x, rest, acc ++ [SetAlias(a, sets_app(H.lem.eq_sym, [T, Hd(x), Hd(a), proof]))], n),
                            False => sets_aliases(H, T, x, rest, acc, n),
                        }),
                    }),
                },
                ShapeAnd => sets_halves(gv).bind(λ hs => sets_aliases(H, T, x, hs ++ rest, acc, n)),
                _ => sets_aliases(H, T, x, rest, acc, n),
            }),
        },
    }
}

fn sets_alias_of(als: List<SetAlias>, y: Handle) → Tac<Option<SetAlias>> {
    match als {
        Nil => pure(None),
        Cons(a, rest) => sets_same_elt(a.y, y).bind(λ same => match same { True => pure(Some(a)), False => sets_alias_of(rest, y) }),
    }
}

// A literal about `x`, or about an element `x` equals, moved to `x`: its
// proof at `x`, or nothing.
fn sets_lit_at(H: SetHeads, T: Expr, x: Handle, als: List<SetAlias>, l: SetLit) → Tac<Option<Expr>> {
    sets_same_elt(l.elt, x).bind(λ same => match same {
        True => pure(Some(l.proof)),
        False => sets_alias_of(als, l.elt).bind(λ o => match o {
            None => pure(None),
            Some(a) => pure(Some(sets_app(match l.holds { True => H.lem.mem_transport, False => H.lem.not_transport },
                [T, Hd(x), Hd(a.y), Hd(l.set), a.e, l.proof]))),
        }),
    })
}

// How many hypotheses, conjunctions' halves included, a run reads.
def sets_given_fuel: Nat = 1024;

fn sets_facts(H: SetHeads, T: Expr, x: Handle, als: List<SetAlias>, gs: List<SetGiven>, acc: SetFacts, fuel: Nat) → Tac<SetFacts> {
    match fuel {
        Zero => pure(acc),
        Succ(n) => match gs {
            Nil => pure(acc),
            Cons(gv, rest) => sets_shape(H, gv).bind(λ s => match s {
                ShapeLit(l) => sets_lit_at(H, T, x, als, l).bind(λ o => match o {
                    None => sets_facts(H, T, x, als, rest, acc, n),
                    Some(proof) => sets_read(H, acc.leaves, l.set, sets_fuel).bind(λ r => {
                        let f: SetFact = match l.holds { True => FMem(r.e), False => FNot(r.e) };
                        let note: String = match l.holds { True => "x is in it", False => "x is not in it" };
                        sets_facts(H, T, x, als, rest, acc.add(r.leaves, f, proof, Tried(gv.name, note)), n)
                    }),
                }),
                ShapeEq(a, b, holds, proof) => sets_same_elt(a, x).bind(λ left => match left {
                    True => sets_eq_fact(H, T, x, acc, gv.name, b, holds, False, proof).bind(λ acc2 => sets_facts(H, T, x, als, rest, acc2, n)),
                    False => sets_same_elt(b, x).bind(λ right => match right {
                        True => sets_eq_fact(H, T, x, acc, gv.name, a, holds, True, proof).bind(λ acc2 => sets_facts(H, T, x, als, rest, acc2, n)),
                        False => sets_facts(H, T, x, als, rest, acc, n),
                    }),
                }),
                ShapeAll(all) => sets_all_at(H, x, acc, gv.name, all).bind(λ o => match o {
                    None => sets_facts(H, T, x, als, rest, acc, n),
                    Some(acc2) => sets_facts(H, T, x, als, rest, acc2, n),
                }),
                ShapeAnd => sets_halves(gv).bind(λ hs => sets_facts(H, T, x, als, hs ++ rest, acc, n)),
                ShapeOther => sets_facts(H, T, x, als, rest, acc, n),
            }),
        },
    }
}

// The elements read that are `x` itself, by conversion, as the facts `x ∈ [e]`.
fn sets_self_facts(H: SetHeads, T: Expr, x: Handle, es: List<Handle>, k: Nat, acc: SetFacts) → Tac<SetFacts> {
    match es {
        Nil => pure(acc),
        Cons(e, rest) => sets_same_elt(e, x).bind(λ same => match same {
            False => sets_self_facts(H, T, x, rest, Succ(k), acc),
            True => sets_self_facts(H, T, x, rest, Succ(k),
                acc.add(acc.leaves, FMem(SCons(k, SNil)), sets_app(H.mem_self, [T, Hd(x)]), At(Hd(e), Tried("an element", "x is it")))),
        }),
    }
}

// The elements a `False` goal may be about: those of the membership
// literals first, then those of the equations, each once.
record SetElts { lits: List<Handle>, eqs: List<Handle> }

fn sets_elts(H: SetHeads, gs: List<SetGiven>, acc: SetElts, fuel: Nat) → Tac<SetElts> {
    match fuel {
        Zero => pure(acc),
        Succ(n) => match gs {
            Nil => pure(acc),
            Cons(gv, rest) => sets_shape(H, gv).bind(λ s => match s {
                ShapeLit(l) => sets_intern(acc.lits, l.elt).bind(λ i => sets_elts(H, rest, SetElts(i.all, acc.eqs), n)),
                ShapeEq(a, b, _, _) => sets_intern(acc.eqs, a).bind(λ i => sets_intern(i.all, b).bind(λ j =>
                    sets_elts(H, rest, SetElts(acc.lits, j.all), n))),
                ShapeAnd => sets_halves(gv).bind(λ hs => sets_elts(H, hs ++ rest, acc, n)),
                _ => sets_elts(H, rest, acc, n),
            }),
        },
    }
}

// ---------------------------------------------------------------------------
// The table, run here first

fn sets_counter_q(q: Nat, f: List<Bool> → Bool) → Option<List<Bool>> {
    match q {
        Zero => match f(Nil) { True => None, False => Some(Nil) },
        Succ(k) => match sets_counter_q(k, λ (bs: List<Bool>) => f(Cons(True, bs))) {
            Some(bs) => Some(Cons(True, bs)),
            None => match sets_counter_q(k, λ (bs: List<Bool>) => f(Cons(False, bs))) { Some(bs) => Some(Cons(False, bs)), None => None },
        },
    }
}

fn sets_counter(n, m, q: Nat, conns: List<SetConn>, facts: List<SetFact>, goal: SetGoal) → Option<SetBits> {
    let ok = λ (b: SetBits) => !set_facts_bit(facts, b) || goal.bit(b);
    match sets_counter_q(n, λ (vs: List<Bool>) => set_all_bits(m, λ (ws: List<Bool>) => set_all_bits(q, λ (ps: List<Bool>) => ok(SetBits(vs, ws, ps, conns))))) {
        None => None,
        Some(vs) => match sets_counter_q(m, λ (ws: List<Bool>) => set_all_bits(q, λ (ps: List<Bool>) => ok(SetBits(vs, ws, ps, conns)))) {
            None => None,
            Some(ws) => match sets_counter_q(q, λ (ps: List<Bool>) => ok(SetBits(vs, ws, ps, conns))) {
                None => None,
                Some(ps) => Some(SetBits(vs, ws, ps, conns)),
            },
        },
    }
}

fn sets_notes(hs: List<Handle>, bs: List<Bool>, what, yes, no: String) → List<Note> {
    match hs {
        Nil => Nil,
        Cons(h, rest) => match bs {
            Nil => Nil,
            Cons(b, more) => Cons(At(Hd(h), Tried(what, match b { True => yes, False => no })), sets_notes(rest, more, what, yes, no)),
        },
    }
}

// ---------------------------------------------------------------------------
// The proof

// What the core proof proves at `x`: `x ∈ s`, `x ∉ s`, or `False`.
inductive SetWant { WMem(s: Handle), WNot(s: Handle), WFalse }

// Prove `want` at `x` from the hypotheses' facts at `x`.
fn sets_prove(H: SetHeads, gs: List<SetGiven>, x: Handle, want: SetWant) → Tac<Expr> {
    let elt_ty <- infer(Hd(x)).or_fail("sets: ");
    let T = Hd(elt_ty);
    let als <- sets_aliases(H, T, x, gs, Nil, sets_given_fuel);
    let read <- sets_facts(H, T, x, als, gs, SetFacts(SetLeaves(Nil, Nil, Nil, Nil), Nil, Nil, Nil), sets_given_fuel);
    let goal_read <- match want {
        WFalse => pure(SetRead(read.leaves, SNil)),
        WMem(s) => sets_read(H, read.leaves, s, sets_fuel),
        WNot(s) => sets_read(H, read.leaves, s, sets_fuel),
    };
    let found <- sets_self_facts(H, T, x, goal_read.leaves.elts, 0,
        SetFacts(goal_read.leaves, read.facts, read.proofs, read.read));
    let L = found.leaves;
    let goal: SetGoal = match want { WFalse => GFalse, WMem(_) => GMem(goal_read.e), WNot(_) => GNot(goal_read.e) };
    let conns = sets_conns(L.ops);
    match set_taut(L.sets.len(), L.elts.len(), L.preds.len(), conns, found.facts, goal) {
        False => {
            let why: List<Note> = match sets_counter(L.sets.len(), L.elts.len(), L.preds.len(), conns, found.facts, goal) {
                None => Nil,
                Some(b) => sets_notes(L.sets, b.sets, "an atom", "x in it", "x not in it") ++
                    sets_notes(L.elts, b.elts, "an element", "x is it", "x is not it") ++
                    sets_notes(L.preds, b.preds, "a filter's predicate", "true at x", "false at x"),
            };
            fail("sets: the goal does not follow from the membership facts in scope; at this assignment every fact holds and the goal does not",
                Cons(At(Hd(x), Tried("x", "the element read at")), found.read ++ why))
        },
        True => {
            let dict_fn <- as_type(App(Global(H.dec_eq), T)).or_fail("sets: ");
            let dict_ty <- whnf(dict_fn).or_fail("sets: ");
            let dict <- synth(dict_ty).or_fail("sets: no decidable equality at the element type: ");
            let env = sets_app(H.env, [T, sets_list(H, App(Global(H.list_ty), T), sets_handles(L.sets)), sets_list(H, T, sets_handles(L.elts)),
                sets_list(H, App(Global(H.pred_ty), T), sets_handles(L.preds)), sets_list(H, App(Global(H.op_ty), T), sets_ops(H, T, L.ops))]);
            pure(sets_app(H.solve, [T, Hd(dict), env, Hd(x), sets_list(H, Global(H.fact_ty), sets_quote_facts(H, found.facts)), sets_quote_goal(H, goal),
                App(App(Global(H.rfl), Blank), Blank), sets_held(H, found.proofs)]))
        },
    }
}

// `False`, at the first element it follows at.
fn sets_false_at(H: SetHeads, gs: List<SetGiven>, xs: List<Handle>, first: Option<Outcome<Expr>>) → Tac<Expr> {
    match xs {
        Nil => match first {
            Some(Failed(msg, notes)) => fail(msg, notes),
            _ => fail("sets: the goal is `False` and no hypothesis is a membership or an equation to read it at", []),
        },
        Cons(x, rest) => attempt(sets_prove(H, gs, x, WFalse)).bind(λ o => match o {
            Done(p) => pure(p),
            Failed(_, _) => sets_false_at(H, gs, rest, match first { None => Some(o), Some(_) => first }),
        }),
    }
}

// A spelled goal: `b = v`, `b` read as `l`; the core goal is membership or
// its negation, as `v` and the spelling's sense say.
fn sets_spelled(H: SetHeads, gs: List<SetGiven>, l: SetBit, v: Bool) → Tac<Expr> {
    let t <- infer(Hd(l.elt)).or_fail("sets: ");
    let T = Hd(t);
    let x = Hd(l.elt);
    let s = Hd(l.set);
    let b = Hd(l.b);
    let nb = App(Global(H.lem.not_g), b);
    let M = H.lem;
    match l.neg {
        False => match v {
            True => sets_prove(H, gs, l.elt, WMem(l.set)).bind(λ p => pure(sets_app(M.spell_is_true, [T, x, s, b, l.r, p]))),
            False => sets_prove(H, gs, l.elt, WNot(l.set)).bind(λ p => pure(sets_app(M.spell_is_false, [T, x, s, b, l.r, p]))),
        },
        True => match v {
            True => sets_prove(H, gs, l.elt, WNot(l.set)).bind(λ p =>
                pure(sets_app(M.true_of_not_false, [b, sets_app(M.spell_is_false, [T, x, s, nb, l.r, p])]))),
            False => sets_prove(H, gs, l.elt, WMem(l.set)).bind(λ p =>
                pure(sets_app(M.false_of_not_true, [b, sets_app(M.spell_is_true, [T, x, s, nb, l.r, p])]))),
        },
    }
}

def sets_not_read: String = "sets: the goal is not a membership, a spelling of one, a registered relation between sets, `False`, a conjunction of these, or a function type ending in one";

fn sets_go(H: SetHeads, fuel: Nat) → Tac<Expr> {
    match fuel {
        Zero => fail(sets_not_read, []),
        Succ(k) => goal().bind(λ g => sets_view(g.target).bind(λ v => {
            let gs = sets_givens_of(g.locals);
            // A function type, by its head normal form (an inclusion like
            // `a.Inside(m)` unfolds to one), is introduced; a conjunction or
            // a record of facts is split, each part proved alone.
            let other: Tac<Expr> = open(g.target, "x").bind(λ c => match c {
                Accepted(_) => intro_as("x", sets_go(H, k)),
                Refused(_) => constructor(g.target).bind(λ c2 => match c2 {
                    Accepted(sp) => close_by(sp, g.locals, sets_go(H, k)),
                    Refused(_) => fail(sets_not_read, [At(Hd(g.target), Tried("the goal", "not read"))]),
                }),
            });
            match sets_mem_of(H, v) {
                Some(m) => sets_prove(H, gs, m.elt, WMem(m.set)),
                None => match sets_is_false(H, v) {
                    True => sets_elts(H, gs, SetElts(Nil, Nil), sets_given_fuel).bind(λ es => sets_false_at(H, gs, es.lits ++ es.eqs, None)),
                    False => match v {
                        HEq(l, r) => view(r).bind(λ rv => match sets_bool_value(H, rv) {
                            None => other,
                            Some(val) => sets_bit(H, l, sets_fuel).bind(λ o => match o {
                                None => match val {
                                    False => other,
                                    True => sets_rel(H, l).bind(λ orl => match orl {
                                        None => other,
                                        Some(rl) => sets_rel_intro(rl, g.locals, sets_go(H, k)).bind(λ p =>
                                            pure(sets_app(H.lem.eq_true_of_is, [Hd(l), p]))),
                                    }),
                                },
                                Some(bit) => sets_spelled(H, gs, bit, val),
                            }),
                        }),
                        HGlobal(f, _, args) => match f.id.same(H.lem.and_ty.id) {
                            True => match args {
                                Cons(P, Cons(Q, Nil)) => focus(GoalInfo(P, g.locals), sets_go(H, k)).bind(λ p =>
                                    focus(GoalInfo(Q, g.locals), sets_go(H, k)).bind(λ q => pure(sets_app(H.held_cons, [Blank, Blank, p, q])))),
                                _ => other,
                            },
                            False => match f.id.same(H.lem.is_true.id) {
                            True => match args {
                                Cons(b, Nil) => sets_bit(H, b, sets_fuel).bind(λ o => match o {
                                    None => sets_rel(H, b).bind(λ orl => match orl {
                                        None => other,
                                        Some(rl) => sets_rel_intro(rl, g.locals, sets_go(H, k)),
                                    }),
                                    Some(bit) => sets_spelled(H, gs, bit, True).bind(λ p => pure(sets_app(H.lem.is_of_eq_true, [Hd(b), p]))),
                                }),
                                _ => other,
                            },
                            False => other,
                        },
                        },
                        _ => other,
                    },
                },
            }
        })),
    }
}

// `sets()`: prove the goal from the membership facts in scope. The
// operations and spellings it reads are `entries` and `bits`, by default
// every `SetOpEntry` and `SetBitEntry` registered where the call is.
fn sets(entries: List<SetOpEntry> := registered(SetOpEntry), bits: List<SetBitEntry> := registered(SetBitEntry),
    rels: List<SetRelEntry> := registered(SetRelEntry)) → Tac<Expr> {
    sets_heads(entries, bits, rels).bind(λ H => sets_go(H, 16))
}

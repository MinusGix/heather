// `linarith`: linear arithmetic at an ordered field, read at the field's
// setoid equality (issues/linarith-ordered-fields.md;
// docs/linarith-design.md).
//
// The tactic (crates/elab/src/linarith.rs) reads the goal and the given
// facts as linear forms over `ring`'s monomials, finds a nonnegative
// combination by Fourier–Motzkin elimination, and writes a proof from the
// lemmas below. Each lemma is generic over an ordered field that names its
// integers, so the same certificate is checked at `Rat` and at `CReal`
// through the class laws, never by unfolding a carrier's representation.
// The one identity a certificate rests on, `k·(b - a) ≈ s`, is `ring`'s
// (`RingExpr::sound_rel`): this file only turns facts into nonnegative
// parts, adds them up, and reads the goal back off the scaled difference.
//
// Nothing here decides an order. A certificate for `a <= b` is a direct
// proof that `b - a` is a nonnegative combination, which at `CReal` is a
// refutation of `b < a` assembled from the instance's laws.
//
// Points are explicit (`ordered_field`'s convention); `num_pos` and
// `zero_le` take a point only so a caller's carrier pins `A`.

import logic;
import nat;
import int;
import relation_props;
import algebra_rel;
import semiring;
import ordered_field;
import ring;

section<A: OrderedFieldOfInt(≈, <, <=, +, *)> {

// ---------------------------------------------------------------------------
// Coefficients: the carrier's positive numerals.

theorem lin_one_pos(x: A): A.unit < A.of_int(OfNat(1)) {
    StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, A.of_int(OfNat(1)),
        A.rel_sym(A.of_int(OfNat(1)), A.multiplicative.unit, A.of_int_one), A.zero_lt_one)
}

theorem lin_num_pos(x: A, n: Nat): A.unit < A.of_int(OfNat(Succ(n))) {
    match n {
        Zero => lin_one_pos(x),
        Succ(m) => StrictOrder::lt_respects_r(A.unit, A.of_int(OfNat(Succ(m))) + A.of_int(OfNat(1)), A.of_int(OfNat(Succ(Succ(m)))),
            A.rel_sym(A.of_int(OfNat(Succ(Succ(m)))), A.of_int(OfNat(Succ(m))) + A.of_int(OfNat(1)), A.of_int_add(OfNat(Succ(m)), OfNat(1))),
            OrderedAddGroup::add_pos(A.of_int(OfNat(Succ(m))), A.of_int(OfNat(1)), lin_num_pos(x, m), lin_one_pos(x))),
    }
}

theorem lin_num_nonneg(x: A, n: Nat): A.unit <= A.of_int(OfNat(Succ(n))) {
    StrictOrder::le_of_lt(A.unit, A.of_int(OfNat(Succ(n))), lin_num_pos(x, n))
}

theorem lin_zero_le(x: A): A.unit <= A.unit { StrictOrder::le_refl(A.unit) }

// ---------------------------------------------------------------------------
// Facts as nonnegative parts: `a R b` gives `b - a` on the right side of zero.

theorem lin_le_part(a, b: A, h: a <= b): A.unit <= b + A.inv(a) {
    StrictOrder::le_respects(a + A.inv(a), A.unit, b + A.inv(a), b + A.inv(a), A.inv_r(a), A.rel_refl(b + A.inv(a)),
        OrderedAddGroup::add_le_mono_r(a, b, A.inv(a), h))
}

theorem lin_lt_part(a, b: A, h: a < b): A.unit < b + A.inv(a) { OrderedAddGroup::sub_pos(a, b, h) }

// `¬(b < a)` is `a <= b` by the class's characterisation of `≤`.
theorem lin_not_lt_part(a, b: A, h: ¬(b < a)): A.unit <= b + A.inv(a) {
    lin_le_part(a, b, A.le_of_not_lt(a, b, h))
}

// An equation is two parts, one each way.
theorem lin_same_part(a, b: A, h: a ≈ b): A.unit <= b + A.inv(a) {
    lin_le_part(a, b, StrictOrder::le_of_same(a, b, h))
}

theorem lin_same_part_rev(a, b: A, h: a ≈ b): A.unit <= a + A.inv(b) {
    lin_le_part(b, a, StrictOrder::le_of_same(b, a, A.rel_sym(a, b, h)))
}

// A part scaled by a positive coefficient.
theorem lin_scale_le(k, x: A, hk: A.unit < k, hx: A.unit <= x): A.unit <= k * x {
    OrderedField::mul_nonneg(k, x, StrictOrder::le_of_lt(A.unit, k, hk), hx)
}

theorem lin_scale_lt(k, x: A, hk: A.unit < k, hx: A.unit < x): A.unit < k * x { A.mul_pos(k, x, hk, hx) }

// ---------------------------------------------------------------------------
// Sums of parts: strict as soon as one summand is.

theorem lin_add_le_le(x, y: A, hx: A.unit <= x, hy: A.unit <= y): A.unit <= x + y {
    LocatedAddGroup::add_nonneg(x, y, hx, hy)
}

theorem lin_add_lt_le(x, y: A, hx: A.unit < x, hy: A.unit <= y): A.unit < x + y {
    StrictOrder::lt_respects_l(A.unit + A.unit, A.unit, x + y, A.unit_r(A.unit), LocatedAddGroup::add_lt_le_mono(A.unit, x, A.unit, y, hx, hy))
}

theorem lin_add_le_lt(x, y: A, hx: A.unit <= x, hy: A.unit < y): A.unit < x + y {
    StrictOrder::lt_respects_l(A.unit + A.unit, A.unit, x + y, A.unit_r(A.unit), LocatedAddGroup::add_le_lt_mono(A.unit, x, A.unit, y, hx, hy))
}

theorem lin_add_lt_lt(x, y: A, hx: A.unit < x, hy: A.unit < y): A.unit < x + y {
    OrderedAddGroup::add_pos(x, y, hx, hy)
}

theorem lin_weaken(s: A, h: A.unit < s): A.unit <= s { StrictOrder::le_of_lt(A.unit, s, h) }

// ---------------------------------------------------------------------------
// Reading the goal back: `k·(b - a) ≈ s` with `k` positive and `s` a sum of
// parts.

theorem lin_le_of_sub_nonneg(a, b: A, h: A.unit <= b + A.inv(a)): a <= b {
    StrictOrder::le_respects(A.unit + a, a, (b + A.inv(a)) + a, b, A.unit_l(a), OrderedAddGroup::sub_add_cancel(b, a),
        OrderedAddGroup::add_le_mono_r(A.unit, b + A.inv(a), a, h))
}

theorem lin_finish_le(a, b, k, s: A, hk: A.unit < k, hs: A.unit <= s, e: k * (b + A.inv(a)) ≈ s): a <= b {
    let scaled: (A.unit <= k * (b + A.inv(a))) =
        StrictOrder::le_respects(A.unit, A.unit, s, k * (b + A.inv(a)), A.rel_refl(A.unit), A.rel_sym(k * (b + A.inv(a)), s, e), hs);
    lin_le_of_sub_nonneg(a, b, A.le_of_not_lt(A.unit, b + A.inv(a), λ below => A.not_lt_of_le(A.unit, k * (b + A.inv(a)), scaled,
        StrictOrder::lt_respects_r(k * (b + A.inv(a)), k * A.unit, A.unit, A.mul_zero(k),
            OrderedField::mul_lt_mono_l(b + A.inv(a), A.unit, k, below, hk)))))
}

theorem lin_finish_lt(a, b, k, s: A, hk: A.unit < k, hs: A.unit < s, e: k * (b + A.inv(a)) ≈ s): a < b {
    OrderedAddGroup::lt_of_sub_pos(a, b, A.pos_of_mul_pos(k, b + A.inv(a), hk,
        StrictOrder::lt_respects_r(A.unit, s, k * (b + A.inv(a)), A.rel_sym(k * (b + A.inv(a)), s, e), hs)))
}

// The facts alone are contradictory: a positive sum of parts that is zero.
theorem lin_finish_false(s: A, hs: A.unit < s, e: s ≈ A.unit): False {
    A.lt_irrefl(A.unit, StrictOrder::lt_respects_r(A.unit, s, A.unit, e, hs))
}

theorem lin_same_of_le(a, b: A, hab: a <= b, hba: b <= a): a ≈ b { StrictOrder::le_antisymm(a, b, hab, hba) }

theorem lin_not_lt_of_le(a, b: A, h: b <= a): ¬(a < b) { A.not_lt_of_le(b, a, h) }

}

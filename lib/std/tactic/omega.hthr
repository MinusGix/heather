// Kernel-checked certificate algebra for the Rust Omega searcher. The searcher
// is untrusted: it supplies concrete coefficient lists and applications of
// these lemmas, while ordinary Heather elaboration and the kernel check every
// equality and order step.

import int;
import list;
import logic;
import nat;

// TODO: various of these should get their own module perhaps, but having it in omega makes it easier to isolate dependency graph.
//
// Coefficient rows are deliberately ordinary lists. `dot` stops at the first
// exhausted list, so generated certificates need no separate length witness;
// the Rust reifier always emits equally sized rows and atom lists.
fn dot(coeffs: List<Int>) → List<Int> → Int {
    match coeffs {
        Nil => λ atoms => OfNat(0),
        Cons(c, cs) => λ atoms => match atoms {
            Nil => OfNat(0),
            Cons(x, xs) => c * x + dot(cs, xs),
        },
    }
}

fn scale(k: Int, coeffs: List<Int>) → List<Int> {
    match coeffs {
        Nil => Nil,
        Cons(c, cs) => Cons(k * c, scale(k, cs)),
    }
}

fn add_coeffs(left: List<Int>) → List<Int> → List<Int> {
    match left {
        Nil => λ right => right,
        Cons(a, as) => λ right => match right {
            Nil => Cons(a, as),
            Cons(b, bs) => Cons(a + b, add_coeffs(as, bs)),
        },
    }
}

fn combo(a: Int, left: List<Int>, b: Int, right: List<Int>) → List<Int> {
    add_coeffs(scale(a, left), scale(b, right))
}

fn zeros(atoms: List<Int>) → List<Int> {
    match atoms { Nil => Nil, Cons(_, xs) => Cons(OfNat(0), zeros(xs)) }
}

fn basis(index: Nat) → List<Int> → List<Int> {
    match index {
        Zero => λ atoms => match atoms {
            Nil => Nil,
            Cons(_, xs) => Cons(OfNat(1), zeros(xs)),
        },
        Succ(i) => λ atoms => match atoms {
            Nil => Nil,
            Cons(_, xs) => Cons(OfNat(0), basis(i, xs)),
        },
    }
}

fn nth0(index: Nat) → List<Int> → Int {
    match index {
        Zero => λ atoms => match atoms { Nil => OfNat(0), Cons(x, _) => x },
        Succ(i) => λ atoms => match atoms { Nil => OfNat(0), Cons(_, xs) => nth0(i, xs) },
    }
}

theorem cong_dot(atoms: List<Int>, {left, right: List<Int>},
    equality: left = right): dot(left, atoms) = dot(right, atoms)
{
    rewrite(equality, refl)
}

// The four-term additive permutation used by `dot_add`. Keeping it here pays
// the associativity/commutativity proof once for every generated certificate.
theorem Int::int_add_swap_middle(a, b, c, d: Int):
    (a + b) + (c + d) = (a + c) + (b + d)
{
    apply trans;
    give a.add_assoc(b, c + d);
    apply trans;
    give Int::cong(λ (q: Int) => a + q,
        trans(sym(b.add_assoc(c, d)),
            trans(Int::cong(λ (q: Int) => q + d, b.add_comm(c)), c.add_assoc(b, d))));
    sym(a.add_assoc(c, b + d))
}

theorem dot_scale(k: Int, coeffs: List<Int>): (atoms: List<Int>) →
    dot(scale(k, coeffs), atoms) = k * dot(coeffs, atoms)
{
    match coeffs {
        Nil => λ atoms => sym(k.mul_zero()),
        Cons(c, cs) => λ atoms => match atoms {
            Nil => sym(k.mul_zero()),
            Cons(x, xs) =>
                apply trans;
                give Int::cong(λ (q: Int) => (k * c) * x + q,
                    dot_scale(k, cs, xs));
                apply trans;
                give Int::cong(λ (q: Int) => q + k * dot(cs, xs),
                    k.mul_assoc(c, x));
                sym(k.mul_add_distr(c * x, dot(cs, xs))),
        },
    }
}

theorem dot_add(left: List<Int>): (right, atoms: List<Int>) →
    dot(add_coeffs(left, right), atoms) = dot(left, atoms) + dot(right, atoms)
{
    match left {
        Nil => λ right atoms => sym(dot(right, atoms).zero_add()),
        Cons(a, as) => λ right atoms => match right {
            Nil => sym(dot(Cons(a, as), atoms).add_zero()),
            Cons(b, bs) => match atoms {
                Nil => sym(OfNat(0).add_zero()),
                Cons(x, xs) =>
                    apply trans;
                    give Int::cong(λ (q: Int) => (a + b) * x + q,
                        dot_add(as, bs, xs));
                    apply trans;
                    give Int::cong(λ (q: Int) => q + (dot(as, xs) + dot(bs, xs)),
                        a.add_mul_distr(b, x));
                    Int::int_add_swap_middle(a * x, b * x, dot(as, xs), dot(bs, xs)),
            },
        },
    }
}

theorem dot_combo(a: Int, left: List<Int>, b: Int, right, atoms: List<Int>):
    dot(combo(a, left, b, right), atoms) =
        a * dot(left, atoms) + b * dot(right, atoms)
{
    apply trans;
    give dot_add(scale(a, left), scale(b, right), atoms);
    apply trans;
    give Int::cong(λ (q: Int) => q + dot(scale(b, right), atoms), dot_scale(a, left, atoms));
    Int::cong(λ (q: Int) => a * dot(left, atoms) + q, dot_scale(b, right, atoms))
}

theorem dot_zeros(atoms: List<Int>): dot(zeros(atoms), atoms) = OfNat(0) {
    match atoms {
        Nil => refl,
        Cons(x, xs) =>
            apply trans;
            give Int::cong(λ (q: Int) => OfNat(0) * x + q, dot_zeros(xs));
            apply trans;
            give (OfNat(0) * x).add_zero();
            x.zero_mul(),
    }
}

theorem impossible_constant_lower(row, atoms: List<Int>, lower: Int,
    bound: lower <= dot(row, atoms), zero: dot(row, atoms) = OfNat(0),
    positive: OfNat(0) < lower): False
{
    lower.not_lt_of_ge(OfNat(0), rewrite(sym(zero), bound), positive)
}

theorem impossible_constant_upper(row, atoms: List<Int>, upper: Int,
    bound: dot(row, atoms) <= upper, zero: dot(row, atoms) = OfNat(0),
    negative: upper < OfNat(0)): False
{
    OfNat(0).not_lt_of_ge(upper, rewrite(sym(zero), bound), negative)
}

theorem dot_basis(index: Nat): (atoms: List<Int>) →
    dot(basis(index, atoms), atoms) = nth0(index, atoms)
{
    match index {
        Zero => λ atoms => match atoms {
            Nil => refl,
            Cons(x, xs) =>
                apply trans;
                give Int::cong(λ (q: Int) => OfNat(1) * x + q, dot_zeros(xs));
                apply trans;
                give (OfNat(1) * x).add_zero();
                x.one_mul(),
        },
        Succ(i) => λ atoms => match atoms {
            Nil => refl,
            Cons(x, xs) =>
                apply trans;
                give Int::cong(λ (q: Int) => OfNat(0) * x + q, dot_basis(i, xs));
                apply trans;
                give Int::cong(λ (q: Int) => q + nth0(i, xs), x.zero_mul());
                nth0(i, xs).zero_add(),
        },
    }
}

theorem normalize_const(c: Int, atoms: List<Int>):
    c = c + dot(zeros(atoms), atoms)
{
    sym(trans(Int::cong(λ (q: Int) => c + q, dot_zeros(atoms)), c.add_zero()))
}

theorem normalize_atom(index: Nat, atoms: List<Int>):
    nth0(index, atoms) = OfNat(0) + dot(basis(index, atoms), atoms)
{
    apply trans;
    give sym(dot_basis(index, atoms));
    sym(dot(basis(index, atoms), atoms).zero_add())
}

theorem normalize_add(x, y, cx, cy: Int, left, right, atoms: List<Int>,
    hx: x = cx + dot(left, atoms), hy: y = cy + dot(right, atoms)):
    x + y = (cx + cy) + dot(add_coeffs(left, right), atoms)
{
    apply trans;
    give Int::cong(λ (q: Int) => q + y, hx);
    apply trans;
    give Int::cong(λ (q: Int) => (cx + dot(left, atoms)) + q, hy);
    apply trans;
    give Int::int_add_swap_middle(cx, dot(left, atoms), cy, dot(right, atoms));
    Int::cong(λ (q: Int) => (cx + cy) + q, sym(dot_add(left, right, atoms)))
}

theorem normalize_nat_add(x, y: Nat, cx, cy: Int,
    left, right, atoms: List<Int>,
    hx: OfNat(x) = cx + dot(left, atoms),
    hy: OfNat(y) = cy + dot(right, atoms)):
    OfNat(x + y) = (cx + cy) + dot(add_coeffs(left, right), atoms)
{
    trans(Int::ofNat_add(x, y),
        normalize_add(OfNat(x), OfNat(y), cx, cy,
            left, right, atoms, hx, hy))
}

theorem normalize_scale(k, x, c: Int, row, atoms: List<Int>,
    hx: x = c + dot(row, atoms)):
    k * x = (k * c) + dot(scale(k, row), atoms)
{
    apply trans;
    give Int::cong(λ (q: Int) => k * q, hx);
    apply trans;
    give k.mul_add_distr(c, dot(row, atoms));
    Int::cong(λ (q: Int) => k * c + q, sym(dot_scale(k, row, atoms)))
}

theorem normalize_scale_right(x, k, c: Int, row, atoms: List<Int>,
    hx: x = c + dot(row, atoms)):
    x * k = (k * c) + dot(scale(k, row), atoms)
{
    trans(x.mul_comm(k), normalize_scale(k, x, c, row, atoms, hx))
}

theorem normalize_nat_scale_left(k, x: Nat, c: Int, row, atoms: List<Int>,
    hx: OfNat(x) = c + dot(row, atoms)):
    OfNat(k * x) = (OfNat(k) * c) + dot(scale(OfNat(k), row), atoms)
{
    trans(Int::ofNat_mul(k, x),
        normalize_scale(OfNat(k), OfNat(x), c, row, atoms, hx))
}

theorem normalize_nat_scale_right(x, k: Nat, c: Int, row, atoms: List<Int>,
    hx: OfNat(x) = c + dot(row, atoms)):
    OfNat(x * k) = (OfNat(k) * c) + dot(scale(OfNat(k), row), atoms)
{
    trans(Int::ofNat_mul(x, k),
        normalize_scale_right(OfNat(x), OfNat(k), c, row, atoms, hx))
}

theorem nat_le_to_int(m, n: Nat, h: m <= n): OfNat(m) <= OfNat(n) { h }

theorem nat_lt_to_int(m, n: Nat, h: m < n): OfNat(m) < OfNat(n) { h }

theorem nat_lt_of_not_le(a, b: Nat, h: ¬(a <= b)): b < a {
    match a.lt_trichotomy(b) {
        Inl(forward) => false_elim(h(a.le_of_lt(b, forward))),
        Inr(rest) => match rest {
            Inl(eq) => false_elim(h(rewrite(sym(eq), a.le_refl()))),
            Inr(back) => back,
        },
    }
}

theorem nat_le_of_not_lt(a, b: Nat, h: ¬(a < b)): b <= a {
    match a.lt_trichotomy(b) {
        Inl(forward) => false_elim(h(forward)),
        Inr(rest) => match rest {
            Inl(eq) => rewrite(sym(eq), a.le_refl()),
            Inr(back) => b.le_of_lt(a, back),
        },
    }
}

theorem nat_le_of_not_not_le(a, b: Nat, h: ¬¬(a <= b)): a <= b {
    match a.le_dec(b) { Inl(proof) => proof, Inr(refute) => false_elim(h(refute)) }
}

theorem nat_lt_of_not_not_lt(a, b: Nat, h: ¬¬(a < b)): a < b {
    match Succ(a).le_dec(b) {
        Inl(proof) => proof,
        Inr(refute) => false_elim(h(refute)),
    }
}

theorem normalize_neg(x, c: Int, row, atoms: List<Int>,
    hx: x = c + dot(row, atoms)):
    -x = (-c) + dot(scale(NegSucc(0), row), atoms)
{
    apply trans;
    give sym(trans(OfNat(1).mul_neg_l(x), Int::cong(Int::neg, x.one_mul())));
    apply trans;
    give normalize_scale(NegSucc(0), x, c, row, atoms, hx);
    Int::cong(λ (q: Int) => q + dot(scale(NegSucc(0), row), atoms),
        trans(OfNat(1).mul_neg_l(c), Int::cong(Int::neg, c.one_mul())))
}

// Transport helpers keep generated terms small and make their direction
// explicit. They are ordinary equality elimination, not trusted casts.
theorem le_transport(a, b, c, d: Int, left: a = b, right: c = d, h: a <= c):
    b <= d
{
    rewrite(sym(right), sym(left), h)
}

theorem sub_le_sub_constants(cx, dx, cy, dy: Int,
    h: cx + dx <= cy + dy): dx + (-dy) <= cy + (-cx)
{
    let shifted =
        (cx + dx).add_le_mono_r(cy + dy, (-cx) + (-dy), h);
    let left = trans(
        Int::int_add_swap_middle(cx, dx, -cx, -dy),
        trans(Int::cong(λ (q: Int) => q + (dx + (-dy)), cx.add_neg()),
            (dx + (-dy)).zero_add()));
    let right = trans(
        Int::int_add_swap_middle(cy, dy, -cx, -dy),
        trans(Int::cong(λ (q: Int) => (cy + (-cx)) + q, dy.add_neg()),
            (cy + (-cx)).add_zero()));
    le_transport(
        (cx + dx) + ((-cx) + (-dy)), dx + (-dy),
        (cy + dy) + ((-cx) + (-dy)), cy + (-cx),
        left, right, shifted)
}

theorem neg_one_mul(x: Int): NegSucc(0) * x = -x {
    trans(OfNat(1).mul_neg_l(x), Int::cong(Int::neg, x.one_mul()))
}

fn sub_coeffs(left, right: List<Int>) → List<Int> {
    combo(OfNat(1), left, NegSucc(0), right)
}

theorem dot_sub(left, right, atoms: List<Int>):
    dot(sub_coeffs(left, right), atoms) = dot(left, atoms) + (-dot(right, atoms))
{
    apply trans;
    give dot_combo(OfNat(1), left, NegSucc(0), right, atoms);
    apply trans;
    give Int::cong(λ (q: Int) => q + NegSucc(0) * dot(right, atoms),
        dot(left, atoms).one_mul());
    Int::cong(λ (q: Int) => dot(left, atoms) + q,
        neg_one_mul(dot(right, atoms)))
}

theorem sub_eq_sub_constants(cx, dx, cy, dy: Int,
    h: cx + dx = cy + dy): dx + (-dy) = cy + (-cx)
{
    let shifted = Int::cong(λ (q: Int) => q + ((-cx) + (-dy)), h);
    let left = trans(
        Int::int_add_swap_middle(cx, dx, -cx, -dy),
        trans(Int::cong(λ (q: Int) => q + (dx + (-dy)), cx.add_neg()),
            (dx + (-dy)).zero_add()));
    let right = trans(
        Int::int_add_swap_middle(cy, dy, -cx, -dy),
        trans(Int::cong(λ (q: Int) => (cy + (-cx)) + q, dy.add_neg()),
            (cy + (-cx)).add_zero()));
    trans(sym(left), trans(shifted, right))
}

theorem normalized_eq_value(x, y, cx, cy: Int, left, right, atoms: List<Int>,
    hx: x = cx + dot(left, atoms), hy: y = cy + dot(right, atoms), h: x = y):
    dot(sub_coeffs(left, right), atoms) = cy + (-cx)
{
    let normalized = trans(sym(hx), trans(h, hy));
    trans(dot_sub(left, right, atoms),
        sub_eq_sub_constants(
            cx, dot(left, atoms), cy, dot(right, atoms), normalized))
}

theorem lower_of_eq(row, atoms: List<Int>, value: Int,
    h: dot(row, atoms) = value): value <= dot(row, atoms)
{
    rewrite(sym(h), dot(row, atoms).le_refl())
}

theorem upper_of_eq(row, atoms: List<Int>, value: Int,
    h: dot(row, atoms) = value): dot(row, atoms) <= value
{
    rewrite(sym(h), dot(row, atoms).le_refl())
}

fn IsPositiveOfNat(value: Int) → Type {
    match value { OfNat(n) => n.IsSucc(), NegSucc(_) => False }
}

fn IsNegative(value: Int) → Type {
    match value { OfNat(_) => False, NegSucc(_) => True }
}

theorem positive_int_nonzero(k: Nat): OfNat(Succ(k)) ≠ OfNat(0) {
    (h: OfNat(Succ(k)) = OfNat(0)) ⊢
        j(h, λ y _ => IsPositiveOfNat(y), trivial)
}

theorem negative_int_nonzero(k: Nat): NegSucc(k) ≠ OfNat(0) {
    (h: NegSucc(k) = OfNat(0)) ⊢ j(h, λ y _ => IsNegative(y), trivial)
}

theorem add_lt_mono_l(a, b, c: Int, h: a < b): c + a < c + b {
    j(c.add_isucc(a),
      λ y _ => y <= c + b,
      a.isucc().add_le_mono_l(b, c, h))
}

theorem div_lower_nonzero(dividend, divisor: Int,
    nonzero: divisor ≠ OfNat(0)):
    dividend.div(divisor) * divisor <= dividend
{
    let product = dividend.div(divisor) * divisor;
    let remainder = dividend.mod(divisor);
    rewrite(sym(product.add_zero()),
      j(Int::div_mul_add_mod(dividend, divisor),
        λ right _ => product + OfNat(0) <= right,

            OfNat(0).add_le_mono_l(remainder, product,
            dividend.mod_nonneg(divisor, nonzero))))
}

theorem div_upper_nonzero(dividend, divisor: Int,
    nonzero: divisor ≠ OfNat(0)):
    dividend < dividend.div(divisor) * divisor + divisor.abs()
{
    let product = dividend.div(divisor) * divisor;
    let remainder = dividend.mod(divisor);
    j(Int::div_mul_add_mod(dividend, divisor),
      λ right _ => right < product + divisor.abs(),
      add_lt_mono_l(
          remainder,
          divisor.abs(),
          product,
          dividend.mod_lt_abs(divisor, nonzero)))
}

theorem div_lower(dividend: Int, divisor_pred: Nat):
    dividend.div(OfNat(Succ(divisor_pred))) * OfNat(Succ(divisor_pred))
        <= dividend
{
    div_lower_nonzero(
        dividend,
        OfNat(Succ(divisor_pred)),
        positive_int_nonzero(divisor_pred))
}

theorem div_upper(dividend: Int, divisor_pred: Nat):
    dividend <
        dividend.div(OfNat(Succ(divisor_pred))) * OfNat(Succ(divisor_pred)) +
            OfNat(Succ(divisor_pred))
{
    div_upper_nonzero(
        dividend,
        OfNat(Succ(divisor_pred)),
        positive_int_nonzero(divisor_pred))
}

theorem mod_expand(dividend, divisor: Int):
    dividend.mod(divisor) =
        dividend + (dividend.div(divisor) * divisor).neg()
{
    let product = dividend.div(divisor) * divisor;
    let remainder = dividend.mod(divisor);
    calc {
        remainder = OfNat(0) + remainder := sym(remainder.zero_add()),
        = (product.neg() + product) + remainder :=
            Int::cong(λ (x: Int) => x + remainder,
                     sym(Int::neg_add_self(product))),
        = product.neg() + (product + remainder) :=
            product.neg().add_assoc(product, remainder),
        = product.neg() + dividend :=
            Int::cong(λ (x: Int) => product.neg() + x,
                     Int::div_mul_add_mod(dividend, divisor)),
        = dividend + product.neg() :=
            product.neg().add_comm(dividend),
    }
}

theorem normalize_mod(dividend, divisor, constant: Int,
    row, atoms: List<Int>,
    expanded: dividend + (dividend.div(divisor) * divisor).neg() =
        constant + dot(row, atoms)):
    dividend.mod(divisor) = constant + dot(row, atoms)
{
    trans(mod_expand(dividend, divisor), expanded)
}

theorem normalize_div_zero(dividend: Int, atoms: List<Int>):
    dividend.div(OfNat(0)) = OfNat(0) + dot(zeros(atoms), atoms)
{
    trans(dividend.div_zero(), normalize_const(OfNat(0), atoms))
}

theorem normalize_mod_zero(dividend, constant: Int, row, atoms: List<Int>,
    h: dividend = constant + dot(row, atoms)):
    dividend.mod(OfNat(0)) = constant + dot(row, atoms)
{
    trans(int::mod_zero(dividend), h)
}

theorem nat_div_lower(dividend, divisor_pred: Nat):
    OfNat(dividend.div(Succ(divisor_pred))) * OfNat(Succ(divisor_pred))
        <= OfNat(dividend)
{
    let quotient = dividend.div(Succ(divisor_pred));
    let product = dividend.div(Succ(divisor_pred)) * Succ(divisor_pred);
    let remainder = dividend.mod(Succ(divisor_pred));
    rewrite(sym(Int::ofNat_mul(quotient, Succ(divisor_pred))),
      nat_le_to_int(
          product,
          dividend,
          j(dividend.div_mul_add_mod(Succ(divisor_pred)),
            λ right _ => product <= right,
            product.le_add_l(remainder))))
}

theorem nat_div_upper(dividend, divisor_pred: Nat):
    OfNat(dividend) <
        OfNat(dividend.div(Succ(divisor_pred))) *
            OfNat(Succ(divisor_pred)) + OfNat(Succ(divisor_pred))
{
    let quotient = dividend.div(Succ(divisor_pred));
    let product = quotient * Succ(divisor_pred);
    let remainder = dividend.mod(Succ(divisor_pred));
    rewrite(Int::ofNat_mul_add(
          quotient, Succ(divisor_pred), Succ(divisor_pred)),
      nat_lt_to_int(
          dividend,
          product + Succ(divisor_pred),
          j(dividend.div_mul_add_mod(Succ(divisor_pred)),
            λ right _ => right < product + Succ(divisor_pred),

                product.add_le_mono_l(
                Succ(remainder),
                Succ(divisor_pred),
                dividend.mod_lt(Succ(divisor_pred))))))
}

theorem nat_mod_expand(dividend, divisor: Nat):
    OfNat(dividend.mod(divisor)) =
        OfNat(dividend) +
            (OfNat(dividend.div(divisor)) * OfNat(divisor)).neg()
{
    let product = OfNat(dividend.div(divisor)) * OfNat(divisor);
    let remainder = OfNat(dividend.mod(divisor));
    let reconstruct = trans(
        Int::ofNat_mul_add(
            dividend.div(divisor), divisor, dividend.mod(divisor)),
        Int::cong_ofnat(dividend.div_mul_add_mod(divisor)));
    calc {
        remainder = OfNat(0) + remainder := sym(remainder.zero_add()),
        = (product.neg() + product) + remainder :=
            Int::cong(λ (x: Int) => x + remainder,
                     sym(Int::neg_add_self(product))),
        = product.neg() + (product + remainder) :=
            product.neg().add_assoc(product, remainder),
        = product.neg() + OfNat(dividend) :=
            Int::cong(λ (x: Int) => product.neg() + x, reconstruct),
        = OfNat(dividend) + product.neg() :=
            product.neg().add_comm(OfNat(dividend)),
    }
}

theorem normalize_nat_mod(dividend, divisor: Nat, constant: Int,
    row, atoms: List<Int>,
    expanded: OfNat(dividend) +
        (OfNat(dividend.div(divisor)) * OfNat(divisor)).neg() =
            constant + dot(row, atoms)):
    OfNat(dividend.mod(divisor)) = constant + dot(row, atoms)
{
    trans(nat_mod_expand(dividend, divisor), expanded)
}

theorem normalize_nat_div_zero(dividend: Nat, atoms: List<Int>):
    OfNat(dividend.div(0)) = OfNat(0) + dot(zeros(atoms), atoms)
{
    trans(Int::cong_ofnat(dividend.div_zero()),
          normalize_const(OfNat(0), atoms))
}

theorem normalize_nat_mod_zero(dividend: Nat, constant: Int,
    row, atoms: List<Int>, h: OfNat(dividend) = constant + dot(row, atoms)):
    OfNat(dividend.mod(0)) = constant + dot(row, atoms)
{
    trans(Int::cong_ofnat(Nat::mod_zero(dividend)), h)
}

theorem eq_of_bounds(row, atoms: List<Int>, value: Int,
    lower: value <= dot(row, atoms), upper: dot(row, atoms) <= value):
    dot(row, atoms) = value
{
    dot(row, atoms).le_antisym(value, upper, lower)
}

theorem exact_combo(a, b: Int, left, right, atoms: List<Int>, l, r: Int,
    left_eq: dot(left, atoms) = l, right_eq: dot(right, atoms) = r):
    dot(combo(a, left, b, right), atoms) = a * l + b * r
{
    calc {
        dot(combo(a, left, b, right), atoms)
            = a * dot(left, atoms) + b * dot(right, atoms) :=
                dot_combo(a, left, b, right, atoms),
            = a * l + b * dot(right, atoms) :=
                Int::cong(λ (x: Int) => a * x + b * dot(right, atoms), left_eq),
            = a * l + b * r :=
                Int::cong(λ (x: Int) => a * l + b * x, right_eq),
    }
}

theorem normalized_le_upper(x, y, cx, cy: Int, left, right, atoms: List<Int>,
    hx: x = cx + dot(left, atoms), hy: y = cy + dot(right, atoms), h: x <= y):
    dot(sub_coeffs(left, right), atoms) <= cy + (-cx)
{
    let normalized = le_transport(
        x, cx + dot(left, atoms), y, cy + dot(right, atoms), hx, hy, h);
    le_transport(
        dot(left, atoms) + (-dot(right, atoms)),
        dot(sub_coeffs(left, right), atoms),
        cy + (-cx), cy + (-cx),
        sym(dot_sub(left, right, atoms)), refl,
        sub_le_sub_constants(
            cx, dot(left, atoms), cy, dot(right, atoms), normalized))
}

theorem upper_to_negated_lower(row, atoms: List<Int>, upper: Int,
    h: dot(row, atoms) <= upper):
    -upper <= dot(scale(NegSucc(0), row), atoms)
{
    let reversed = dot(row, atoms).le_neg(upper, h);
    let scaled = trans(
        dot_scale(NegSucc(0), row, atoms),
        neg_one_mul(dot(row, atoms)));
    le_transport(-upper, -upper, -dot(row, atoms),
        dot(scale(NegSucc(0), row), atoms), refl, sym(scaled), reversed)
}

theorem lower_to_negated_upper(row, atoms: List<Int>, lower: Int,
    h: lower <= dot(row, atoms)):
    dot(scale(NegSucc(0), row), atoms) <= -lower
{
    let reversed = lower.le_neg(dot(row, atoms), h);
    let scaled = trans(
        dot_scale(NegSucc(0), row, atoms),
        neg_one_mul(dot(row, atoms)));
    le_transport(dot(scale(NegSucc(0), row), atoms),
        dot(scale(NegSucc(0), row), atoms),
        -lower, -lower, refl, refl,
        rewrite(scaled, reversed))
}

theorem lower_transport(coeffs, atoms: List<Int>, lower, value: Int,
    hvalue: lower <= value, value_eq: value = dot(coeffs, atoms)):
    lower <= dot(coeffs, atoms)
{
    rewrite(sym(value_eq), hvalue)
}

theorem atom_nonnegative(index: Nat, atoms: List<Int>,
    h: OfNat(0) <= nth0(index, atoms)):
    OfNat(0) <= dot(basis(index, atoms), atoms)
{
    lower_transport(basis(index, atoms), atoms, OfNat(0),
        nth0(index, atoms), h, sym(dot_basis(index, atoms)))
}

theorem upper_transport(coeffs, atoms: List<Int>, upper, value: Int,
    hvalue: value <= upper, value_eq: value = dot(coeffs, atoms)):
    dot(coeffs, atoms) <= upper
{
    rewrite(sym(value_eq), hvalue)
}

// GCD normalization only divides concrete coefficient rows and computes the
// rounded bound in Rust. These lemmas certify those closed floor/ceiling
// choices using order alone; executable integer division is not part of the
// proof interface.
theorem divide_upper(row, reduced, atoms: List<Int>, divisor, upper, rounded: Int,
    decomp: row = scale(divisor, reduced),
    nonnegative: OfNat(0) <= divisor,
    threshold: upper < divisor * rounded.isucc(),
    bound: dot(row, atoms) <= upper):
    dot(reduced, atoms) <= rounded
{
    let scaled: (dot(row, atoms) = divisor * dot(reduced, atoms)) =
        trans(cong_dot(atoms, decomp),
            dot_scale(divisor, reduced, atoms));
    let normalized: (divisor * dot(reduced, atoms) <= upper) =
        le_transport(dot(row, atoms), divisor * dot(reduced, atoms),
            upper, upper, scaled, refl, bound);
    match dot(reduced, atoms).le_dec(rounded) {
        Inl(proof) => proof,
        Inr(denied) => {
            let next_le: (rounded.isucc() <= dot(reduced, atoms)) =
                rounded.lt_of_not_le(dot(reduced, atoms), denied);
            let multiplied =
                rounded.isucc().mul_le_mono_l(dot(reduced, atoms), divisor,
                next_le, nonnegative);
            false_elim(
                (divisor * rounded.isucc()).not_lt_of_ge(upper,
                (divisor * rounded.isucc()).le_trans(
                    divisor * dot(reduced, atoms), upper,
                    multiplied, normalized), threshold))
        },
    }
}

theorem divide_lower(row, reduced, atoms: List<Int>, divisor, lower, rounded: Int,
    decomp: row = scale(divisor, reduced),
    nonnegative: OfNat(0) <= divisor,
    threshold: divisor * rounded.ipred() < lower,
    bound: lower <= dot(row, atoms)):
    rounded <= dot(reduced, atoms)
{
    let scaled: (dot(row, atoms) = divisor * dot(reduced, atoms)) =
        trans(cong_dot(atoms, decomp),
            dot_scale(divisor, reduced, atoms));
    let normalized: (lower <= divisor * dot(reduced, atoms)) =
        le_transport(lower, lower, dot(row, atoms),
            divisor * dot(reduced, atoms), refl, scaled, bound);
    match rounded.le_dec(dot(reduced, atoms)) {
        Inl(proof) => proof,
        Inr(denied) => {
            let below: (dot(reduced, atoms).isucc() <= rounded) =
                dot(reduced, atoms).lt_of_not_le(rounded, denied);
            let predecessor =
                dot(reduced, atoms).isucc().le_ipred(rounded, below);
            let before: (dot(reduced, atoms) <= rounded.ipred()) =
                rewrite(sym(dot(reduced, atoms).ipred_isucc()), predecessor);
            let multiplied =
                dot(reduced, atoms).mul_le_mono_l(rounded.ipred(), divisor,
                before, nonnegative);
            false_elim(
                lower.not_lt_of_ge(divisor * rounded.ipred(),
                lower.le_trans(divisor * dot(reduced, atoms),
                    divisor * rounded.ipred(), normalized, multiplied), threshold))
        },
    }
}

// A positive multiple of a lower bound remains a lower bound.
theorem lower_scale(k, lower, value: Int,
    hk: OfNat(0) <= k, h: lower <= value):
    k * lower <= k * value
{
    lower.mul_le_mono_l(value, k, h, hk)
}

theorem upper_scale(k, value, upper: Int,
    hk: OfNat(0) <= k, h: value <= upper):
    k * value <= k * upper
{
    value.mul_le_mono_l(upper, k, h, hk)
}

theorem upper_neg_scale(k, value, upper: Int,
    hk: OfNat(0) <= k, h: value <= upper):
    (-k) * upper <= (-k) * value
{
    let scaled = value.mul_le_mono_l(upper, k, h, hk);
    le_transport(
        -(k * upper), (-k) * upper,
        -(k * value), (-k) * value,
        sym(k.mul_neg_l(upper)),
        sym(k.mul_neg_l(value)),
        (k * value).le_neg(k * upper, scaled))
}

theorem lower_neg_scale(k, lower, value: Int,
    hk: OfNat(0) <= k, h: lower <= value):
    (-k) * value <= (-k) * lower
{
    let scaled = lower.mul_le_mono_l(value, k, h, hk);
    le_transport(
        -(k * value), (-k) * value,
        -(k * lower), (-k) * lower,
        sym(k.mul_neg_l(value)),
        sym(k.mul_neg_l(lower)),
        (k * lower).le_neg(k * value, scaled))
}

// Combining two certified lower bounds is the common nonnegative-certificate
// step. Fourier--Motzkin's mixed lower/upper step is added with the frontend;
// this theorem already covers equality substitution and same-direction rows.
theorem lower_combo(a, b: Int, left, right, atoms: List<Int>, l, r: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: l <= dot(left, atoms), hr: r <= dot(right, atoms)):
    a * l + b * r <= dot(combo(a, left, b, right), atoms)
{
    let summed =
        (a * l).add_le_mono(a * dot(left, atoms),
        b * r, b * dot(right, atoms),
        lower_scale(a, l, dot(left, atoms), ha, hl),
        lower_scale(b, r, dot(right, atoms), hb, hr));
    rewrite(dot_combo(a, left, b, right, atoms), summed)
}

theorem upper_combo(a, b: Int, left, right, atoms: List<Int>, l, r: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: dot(left, atoms) <= l, hr: dot(right, atoms) <= r):
    dot(combo(a, left, b, right), atoms) <= a * l + b * r
{
    let summed =
        (a * dot(left, atoms)).add_le_mono(a * l,
        b * dot(right, atoms), b * r,
        upper_scale(a, dot(left, atoms), l, ha, hl),
        upper_scale(b, dot(right, atoms), r, hb, hr));
    rewrite(dot_combo(a, left, b, right, atoms), summed)
}

theorem lower_neg_combo(a, b: Int, left, right, atoms: List<Int>, l, r: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: dot(left, atoms) <= l, hr: dot(right, atoms) <= r):
    (-a) * l + (-b) * r <= dot(combo(-a, left, -b, right), atoms)
{
    let summed =
        ((-a) * l).add_le_mono((-a) * dot(left, atoms),
        (-b) * r, (-b) * dot(right, atoms),
        upper_neg_scale(a, dot(left, atoms), l, ha, hl),
        upper_neg_scale(b, dot(right, atoms), r, hb, hr));
    rewrite(dot_combo(-a, left, -b, right, atoms), summed)
}

theorem upper_neg_combo(a, b: Int, left, right, atoms: List<Int>, l, r: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: l <= dot(left, atoms), hr: r <= dot(right, atoms)):
    dot(combo(-a, left, -b, right), atoms) <= (-a) * l + (-b) * r
{
    let summed =
        ((-a) * dot(left, atoms)).add_le_mono((-a) * l,
        (-b) * dot(right, atoms), (-b) * r,
        lower_neg_scale(a, l, dot(left, atoms), ha, hl),
        lower_neg_scale(b, r, dot(right, atoms), hb, hr));
    rewrite(dot_combo(-a, left, -b, right, atoms), summed)
}

// Fourier--Motzkin combines a lower row with an upper row using positive
// magnitudes `a` and `b`; the upper row is multiplied by `-b`, reversing it.
theorem lower_upper_combo(a, b: Int, left, right, atoms: List<Int>, l, u: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: l <= dot(left, atoms), hu: dot(right, atoms) <= u):
    a * l + (-b) * u <= dot(combo(a, left, -b, right), atoms)
{
    let summed =
        (a * l).add_le_mono(a * dot(left, atoms),
        (-b) * u, (-b) * dot(right, atoms),
        lower_scale(a, l, dot(left, atoms), ha, hl),
        upper_neg_scale(b, dot(right, atoms), u, hb, hu));
    rewrite(dot_combo(a, left, -b, right, atoms), summed)
}

theorem upper_lower_combo(a, b: Int, left, right, atoms: List<Int>, l, u: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hl: l <= dot(left, atoms), hu: dot(right, atoms) <= u):
    dot(combo(-a, left, b, right), atoms) <= (-a) * l + b * u
{
    let summed =
        ((-a) * dot(left, atoms)).add_le_mono((-a) * l,
        b * dot(right, atoms), b * u,
        lower_neg_scale(a, l, dot(left, atoms), ha, hl),
        upper_scale(b, dot(right, atoms), u, hb, hu));
    rewrite(dot_combo(-a, left, b, right, atoms), summed)
}

theorem upper_lower_lower_combo(a, b: Int,
    left, right, atoms: List<Int>, l, u: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hu: dot(left, atoms) <= u, hl: l <= dot(right, atoms)):
    (-a) * u + b * l <= dot(combo(-a, left, b, right), atoms)
{
    let summed =
        ((-a) * u).add_le_mono((-a) * dot(left, atoms),
        b * l, b * dot(right, atoms),
        upper_neg_scale(a, dot(left, atoms), u, ha, hu),
        lower_scale(b, l, dot(right, atoms), hb, hl));
    rewrite(dot_combo(-a, left, b, right, atoms), summed)
}

theorem lower_upper_upper_combo(a, b: Int,
    left, right, atoms: List<Int>, l, u: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b,
    hu: dot(left, atoms) <= u, hl: l <= dot(right, atoms)):
    dot(combo(a, left, -b, right), atoms) <= a * u + (-b) * l
{
    let summed =
        (a * dot(left, atoms)).add_le_mono(a * u,
        (-b) * dot(right, atoms), (-b) * l,
        upper_scale(a, dot(left, atoms), u, ha, hu),
        lower_neg_scale(b, l, dot(right, atoms), hb, hl));
    rewrite(dot_combo(a, left, -b, right, atoms), summed)
}

theorem nat_diseq_elim(x, y: Nat, different: x ≠ y,
    left: x < y → False, right: y < x → False): False
{
    match x.lt_trichotomy(y) {
        Inl(h) => left(h),
        Inr(rest) => match rest {
            Inl(eq) => false_elim(different(eq)),
            Inr(h) => right(h),
        },
    }
}

theorem diseq_elim(x, y: Int, different: x ≠ y,
    left: x < y → False, right: y < x → False): False
{
    match x.lt_trichotomy(y) {
        Inl(h) => left(h),
        Inr(rest) => match rest {
            Inl(eq) => false_elim(different(eq)),
            Inr(h) => right(h),
        },
    }
}

theorem and_elim_false<P, Q>(h: P ∧ Q, k: P → Q → False): False {
    k(h.left, h.right)
}

theorem or_elim_false<P, Q>(h: P ∨ Q,
    left: P → False, right: Q → False): False
{
    or_elim(h, left, right)
}

// ---------------------------------------------------------------------------
// CutSat's certificate rules (crates/elab/src/cutsat.rs, cutsat_cert.rs).
//
// CutSat's search is untrusted. Each constraint it learns is a closed row fact
// over the certificate's atom list -- `dot(row, atoms) <= bound`,
// `cut_dvd(d, dot(row, atoms) + c)` or `dot(row, atoms) + c ≠ 0` -- and each
// rule below concludes one from its premises, leaving the closed row
// arithmetic of its side conditions (`refl`, `trivial`) to the kernel's
// evaluation. Divisibility is an existential equation rather than
// `int::mod`. Cooper's step is the one genuinely integer rule: it splits on
// the remainder of the lower bound's slack, and its cases arrive as a
// `Below` chain the certificate enumerates.

fn cut_dvd(divisor, value: Int) → Type {
    Exists<Int>(λ (witness: Int) => value = divisor * witness)
}

theorem cutsat_div_nonnegative(dividend: Int, divisor_pred: Nat,
    h: OfNat(0) <= dividend):
    OfNat(0) <= dividend.div(OfNat(Succ(divisor_pred)))
{
    match dividend as λ d => OfNat(0) <= d →
        OfNat(0) <= d.div(OfNat(Succ(divisor_pred))) {
        OfNat(_) => λ _ => trivial,
        NegSucc(_) => λ bad => false_elim(bad),
    }(h)
}

theorem cutsat_remainder_le_gap(gap, quotient, divisor, remainder: Int,
    quotient_product_nonnegative: OfNat(0) <= quotient * divisor,
    reconstruct: quotient * divisor + remainder = gap): remainder <= gap
{
    omega
}

theorem cutsat_quotient_product_nonnegative(quotient: Int, divisor_pred: Nat,
    quotient_nonnegative: OfNat(0) <= quotient):
    OfNat(0) <= quotient * OfNat(Succ(divisor_pred))
{
    rewrite(sym(OfNat(Succ(divisor_pred)).zero_mul()),

            OfNat(0).mul_le_mono_r(quotient, OfNat(Succ(divisor_pred)),
            quotient_nonnegative, Int::zero_le_ofNat(Succ(divisor_pred))))
}

theorem cut_cooper_core(a_pred, period_pred: Nat, b, d, c, x, p, q, s: Int,
    hb: OfNat(0) <= b,
    period_a: cut_dvd(OfNat(Succ(a_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(a_pred)) * d, c * OfNat(Succ(period_pred))),
    lower: p <= OfNat(Succ(a_pred)) * x,
    upper: b * x + q <= OfNat(0),
    carried: cut_dvd(d, c * x + s),
    close: (k: Int) → OfNat(0) <= k → k < OfNat(Succ(period_pred)) →
        b * p + OfNat(Succ(a_pred)) * q + b * k <= OfNat(0) →
        cut_dvd(OfNat(Succ(a_pred)), p + k) →
        cut_dvd(OfNat(Succ(a_pred)) * d,
            c * p + OfNat(Succ(a_pred)) * s + c * k) → False): False
{
    let A = OfNat(Succ(a_pred));
    let M = OfNat(Succ(period_pred));
    let gap = A * x + -p;
    let k = gap.mod(M);
    let t = gap.div(M);
    have gap_nonneg: (OfNat(0) <= gap) = omega(lower);
    have rec: (t * M + k = gap) = Int::div_mul_add_mod(gap, M);
    have k_nonneg: (OfNat(0) <= k) =
        gap.mod_nonneg(M, positive_int_nonzero(period_pred));
    have k_lt: (k < M) =
        gap.mod_lt_abs(M, positive_int_nonzero(period_pred));
    have t_nonneg: (OfNat(0) <= t) =
        cutsat_div_nonnegative(gap, period_pred, gap_nonneg);
    have tm_nonneg: (OfNat(0) <= t * M) =
        cutsat_quotient_product_nonnegative(t, period_pred, t_nonneg);
    have k_le: (k <= gap) =
        cutsat_remainder_le_gap(gap, t, M, k, tm_nonneg, rec);
    // The cut: b·(p + k) <= b·(a·x) = a·(b·x) <= a·(-q).
    have pk_le: (p + k <= A * x) = omega(k_le);
    have scaled_lower: (b * (p + k) <= b * (A * x)) =
        (p + k).mul_le_mono_l(A * x, b, pk_le, hb);
    have upper_x: (b * x <= -q) = omega(upper);
    have scaled_upper: (A * (b * x) <= A * (-q)) =
        (b * x).mul_le_mono_l(-q, A, upper_x, Int::zero_le_ofNat(Succ(a_pred)));
    have commute: (b * (A * x) = A * (b * x)) = calc {
        b * (A * x) = (b * A) * x := sym(b.mul_assoc(A, x)),
                    = (A * b) * x := Int::cong(λ (z: Int) => z * x, b.mul_comm(A)),
                    = A * (b * x) := A.mul_assoc(b, x),
    };
    have spread: (b * (p + k) = b * p + b * k) = b.mul_add_distr(p, k);
    have negated: (A * (-q) = -(A * q)) = A.mul_neg_r(q);
    have cut: (b * p + A * q + b * k <= OfNat(0)) =
        omega(scaled_lower, scaled_upper, commute, spread, negated);
    // a ∣ p + k: the slack's quotient part is a multiple of the period.
    have slack: (p + k = A * x + -(t * M)) = omega(rec);
    have period_multiple: (t * M = A * (t * period_a.witness)) = calc {
        t * M = t * (A * period_a.witness) := Int::cong(λ (z: Int) => t * z, period_a.proof),
              = (t * A) * period_a.witness := sym(t.mul_assoc(A, period_a.witness)),
              = (A * t) * period_a.witness :=
                    Int::cong(λ (z: Int) => z * period_a.witness, t.mul_comm(A)),
              = A * (t * period_a.witness) := A.mul_assoc(t, period_a.witness),
    };
    have selected: cut_dvd(A, p + k) =
        Exists(witness := x + -(t * period_a.witness), proof := calc {
            p + k = A * x + -(t * M) := slack,
                  = A * x + -(A * (t * period_a.witness)) :=
                        Int::cong(λ (z: Int) => A * x + -z, period_multiple),
                  = A * x + A * -(t * period_a.witness) :=
                        Int::cong(λ (z: Int) => A * x + z,
                            sym(A.mul_neg_r(t * period_a.witness))),
                  = A * (x + -(t * period_a.witness)) :=
                        sym(A.mul_add_distr(x, -(t * period_a.witness))),
        });
    // a·d ∣ c·p + a·s + c·k: c·(p + k) + a·s = a·(c·x + s) − c·t·period.
    let ad = A * d;
    let w = carried.witness;
    let m = period_c.witness;
    have e_a: (c * (p + k) = c * p + c * k) = c.mul_add_distr(p, k);
    have e_b: (c * (p + k) = c * (A * x) + -(c * (t * M))) = calc {
        c * (p + k) = c * (A * x + -(t * M)) := Int::cong(λ (z: Int) => c * z, slack),
                    = c * (A * x) + c * -(t * M) := c.mul_add_distr(A * x, -(t * M)),
                    = c * (A * x) + -(c * (t * M)) :=
                        Int::cong(λ (z: Int) => c * (A * x) + z, c.mul_neg_r(t * M)),
    };
    have e_c: (c * (A * x) = A * (c * x)) = calc {
        c * (A * x) = (c * A) * x := sym(c.mul_assoc(A, x)),
                    = (A * c) * x := Int::cong(λ (z: Int) => z * x, c.mul_comm(A)),
                    = A * (c * x) := A.mul_assoc(c, x),
    };
    have e_d: (c * (t * M) = ad * (t * m)) = calc {
        c * (t * M) = (c * t) * M := sym(c.mul_assoc(t, M)),
                    = (t * c) * M := Int::cong(λ (z: Int) => z * M, c.mul_comm(t)),
                    = t * (c * M) := t.mul_assoc(c, M),
                    = t * (ad * m) := Int::cong(λ (z: Int) => t * z, period_c.proof),
                    = (t * ad) * m := sym(t.mul_assoc(ad, m)),
                    = (ad * t) * m := Int::cong(λ (z: Int) => z * m, t.mul_comm(ad)),
                    = ad * (t * m) := ad.mul_assoc(t, m),
    };
    have e_e: (A * (c * x) + A * s = ad * w) = calc {
        A * (c * x) + A * s = A * (c * x + s) := sym(A.mul_add_distr(c * x, s)),
                            = A * (d * w) := Int::cong(λ (z: Int) => A * z, carried.proof),
                            = ad * w := sym(A.mul_assoc(d, w)),
    };
    have e_f: (ad * (w + -(t * m)) = ad * w + -(ad * (t * m))) = calc {
        ad * (w + -(t * m)) = ad * w + ad * -(t * m) := ad.mul_add_distr(w, -(t * m)),
                            = ad * w + -(ad * (t * m)) :=
                                Int::cong(λ (z: Int) => ad * w + z, ad.mul_neg_r(t * m)),
    };
    have carried_out: cut_dvd(ad, c * p + A * s + c * k) =
        Exists(witness := w + -(t * m), proof := omega(e_a, e_b, e_c, e_d, e_e, e_f));
    close(k, k_nonneg, k_lt, cut, selected, carried_out)
}

theorem cut_cooper_right_core(b_pred, period_pred: Nat, a, d, c, x, p, q, s: Int,
    ha: OfNat(0) <= a,
    period_b: cut_dvd(OfNat(Succ(b_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(b_pred)) * d, (-c) * OfNat(Succ(period_pred))),
    lower: p <= a * x,
    upper: OfNat(Succ(b_pred)) * x + q <= OfNat(0),
    carried: cut_dvd(d, c * x + s),
    close: (k: Int) → OfNat(0) <= k → k < OfNat(Succ(period_pred)) →
        a * q + OfNat(Succ(b_pred)) * p + a * k <= OfNat(0) →
        cut_dvd(OfNat(Succ(b_pred)), q + k) →
        cut_dvd(OfNat(Succ(b_pred)) * d,
            (-c) * q + OfNat(Succ(b_pred)) * s + (-c) * k) → False): False
{
    let B = OfNat(Succ(b_pred));
    have flip_b: (B * -x = -(B * x)) = B.mul_neg_r(x);
    have flip_a: (a * -x = -(a * x)) = a.mul_neg_r(x);
    have mirrored_lower: (q <= B * -x) = omega(upper, flip_b);
    have mirrored_upper: (a * -x + p <= OfNat(0)) = omega(lower, flip_a);
    have mirrored_carried: cut_dvd(d, (-c) * -x + s) =
        Exists(witness := carried.witness, proof := calc {
            (-c) * -x + s = -(-c * x) + s :=
                    Int::cong(λ (z: Int) => z + s, (-c).mul_neg_r(x)),
                = -(-(c * x)) + s :=
                    Int::cong(λ (z: Int) => -z + s, c.mul_neg_l(x)),
                = c * x + s := Int::cong(λ (z: Int) => z + s, (c * x).neg_neg()),
                = d * carried.witness := carried.proof,
        });
    cut_cooper_core(b_pred, period_pred, a, d, -c, -x, q, p, s, ha,
        period_b, period_c, mirrored_lower, mirrored_upper, mirrored_carried, close)
}

fn Below(n: Nat, P: Int → Type) → Type {
    (k: Int) → OfNat(0) <= k → k < OfNat(n) → P(k)
}

theorem below_zero({P: Int → Type}): Below(0, P) {
    λ k low high => false_elim(omega(low, high))
}

theorem below_succ(n: Nat, {P: Int → Type}, rest: Below(n, P), last: P(OfNat(n))):
    Below(Succ(n), P)
{
    λ k low high => match k.lt_trichotomy(OfNat(n)) {
        Inl(below) => rest(k, low, below),
        Inr(other) => match other {
            Inl(same) => j(sym(same), λ value _ => P(value), last),
            Inr(above) => false_elim(omega(high, above)),
        },
    }
}

theorem dot_pivot(rest: List<Int>, coefficient: Int, index: Nat, atoms: List<Int>):
    dot(add_coeffs(rest, scale(coefficient, basis(index, atoms))), atoms)
        = dot(rest, atoms) + coefficient * nth0(index, atoms)
{
    calc {
        dot(add_coeffs(rest, scale(coefficient, basis(index, atoms))), atoms)
            = dot(rest, atoms) + dot(scale(coefficient, basis(index, atoms)), atoms) :=
                dot_add(rest, scale(coefficient, basis(index, atoms)), atoms),
            = dot(rest, atoms) + coefficient * dot(basis(index, atoms), atoms) :=
                Int::cong(λ (z: Int) => dot(rest, atoms) + z,
                    dot_scale(coefficient, basis(index, atoms), atoms)),
            = dot(rest, atoms) + coefficient * nth0(index, atoms) :=
                Int::cong(λ (z: Int) => dot(rest, atoms) + coefficient * z,
                    dot_basis(index, atoms)),
    }
}

// A Cooper step over the values of its rows: `vl`, `vu` and `vc` are the
// pivot rows (lower, upper, carried divisibility) and `rl`, `ru`, `rc` the
// same rows without the pivot variable `x`.
theorem cut_cooper_left_values(a_pred, b_pred, period_pred: Nat,
    d, c, x, rl, ru, rc, vl, vu, vc, vcut, vout,
    lower_bound, upper_bound, carried_constant,
    cut_bound, selected_constant, carried_divisor, carried_out_constant: Int,
    lower_split: vl = rl + NegSucc(a_pred) * x,
    upper_split: vu = ru + OfNat(Succ(b_pred)) * x,
    carried_split: vc = rc + c * x,
    cut_split: vcut = OfNat(Succ(b_pred)) * rl + OfNat(Succ(a_pred)) * ru,
    carried_out_split: vout = c * rl + OfNat(Succ(a_pred)) * rc,
    cut_bound_eq: cut_bound = OfNat(Succ(b_pred)) * lower_bound + OfNat(Succ(a_pred)) * upper_bound,
    selected_eq: selected_constant = -lower_bound,
    carried_divisor_eq: carried_divisor = OfNat(Succ(a_pred)) * d,
    carried_out_constant_eq:
        carried_out_constant = c * -lower_bound + OfNat(Succ(a_pred)) * carried_constant,
    period_a: cut_dvd(OfNat(Succ(a_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(a_pred)) * d, c * OfNat(Succ(period_pred))),
    lower: vl <= lower_bound,
    upper: vu <= upper_bound,
    carried: cut_dvd(d, vc + carried_constant),
    close: Below(Succ(period_pred), λ (k: Int) =>
        vcut <= cut_bound + -OfNat(Succ(b_pred)) * k →
        cut_dvd(OfNat(Succ(a_pred)), rl + (selected_constant + k)) →
        cut_dvd(carried_divisor, vout + (carried_out_constant + c * k)) → False)): False
{
    let A = OfNat(Succ(a_pred));
    let B = OfNat(Succ(b_pred));
    let p = rl + -lower_bound;
    let q = ru + -upper_bound;
    let s = rc + carried_constant;
    have negative: (NegSucc(a_pred) * x = -(A * x)) = A.mul_neg_l(x);
    have core_lower: (p <= A * x) = omega(lower, lower_split, negative);
    have core_upper: (B * x + q <= OfNat(0)) = omega(upper, upper_split);
    have core_carried: cut_dvd(d, c * x + s) =
        Exists(witness := carried.witness, proof := {
            have known: (vc + carried_constant = d * carried.witness) = carried.proof;
            omega(carried_split, known)
        });
    cut_cooper_core(a_pred, period_pred, B, d, c, x, p, q, s,
        Int::zero_le_ofNat(Succ(b_pred)), period_a, period_c, core_lower, core_upper, core_carried,
        λ k low high cut selected carried_out => {
            have e_p: (B * p = B * rl + B * -lower_bound) = B.mul_add_distr(rl, -lower_bound);
            have e_q: (A * q = A * ru + A * -upper_bound) = A.mul_add_distr(ru, -upper_bound);
            have e_pl: (B * -lower_bound = -(B * lower_bound)) = B.mul_neg_r(lower_bound);
            have e_qu: (A * -upper_bound = -(A * upper_bound)) = A.mul_neg_r(upper_bound);
            have e_k: (-B * k = -(B * k)) = B.mul_neg_l(k);
            have row_cut: (vcut <= cut_bound + -B * k) =
                omega(cut, cut_split, e_p, e_q, e_pl, e_qu, e_k, cut_bound_eq);
            have row_selected: cut_dvd(A, rl + (selected_constant + k)) =
                Exists(witness := selected.witness, proof := {
                    have known: (p + k = A * selected.witness) = selected.proof;
                    omega(known, selected_eq)
                });
            have e_cp: (c * p = c * rl + c * -lower_bound) = c.mul_add_distr(rl, -lower_bound);
            have e_as: (A * s = A * rc + A * carried_constant) = A.mul_add_distr(rc, carried_constant);
            have row_carried: cut_dvd(carried_divisor, vout + (carried_out_constant + c * k)) =
                Exists(witness := carried_out.witness, proof := {
                    have known: (c * p + A * s + c * k = (A * d) * carried_out.witness) =
                        carried_out.proof;
                    have scaled: (carried_divisor * carried_out.witness
                        = (A * d) * carried_out.witness) =
                        Int::cong(λ (z: Int) => z * carried_out.witness, carried_divisor_eq);
                    omega(known, carried_out_split, e_cp, e_as, carried_out_constant_eq, scaled)
                });
            close(k, low, high, row_cut, row_selected, row_carried)
        })
}

theorem cut_cooper_right_values(a_pred, b_pred, period_pred: Nat,
    d, c, x, rl, ru, rc, vl, vu, vc, vcut, vout,
    lower_bound, upper_bound, carried_constant,
    cut_bound, selected_constant, carried_divisor, carried_out_constant: Int,
    lower_split: vl = rl + NegSucc(a_pred) * x,
    upper_split: vu = ru + OfNat(Succ(b_pred)) * x,
    carried_split: vc = rc + c * x,
    cut_split: vcut = OfNat(Succ(b_pred)) * rl + OfNat(Succ(a_pred)) * ru,
    carried_out_split: vout = (-c) * ru + OfNat(Succ(b_pred)) * rc,
    cut_bound_eq: cut_bound = OfNat(Succ(b_pred)) * lower_bound + OfNat(Succ(a_pred)) * upper_bound,
    selected_eq: selected_constant = -upper_bound,
    carried_divisor_eq: carried_divisor = OfNat(Succ(b_pred)) * d,
    carried_out_constant_eq:
        carried_out_constant = (-c) * -upper_bound + OfNat(Succ(b_pred)) * carried_constant,
    period_b: cut_dvd(OfNat(Succ(b_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(b_pred)) * d, (-c) * OfNat(Succ(period_pred))),
    lower: vl <= lower_bound,
    upper: vu <= upper_bound,
    carried: cut_dvd(d, vc + carried_constant),
    close: Below(Succ(period_pred), λ (k: Int) =>
        vcut <= cut_bound + -OfNat(Succ(a_pred)) * k →
        cut_dvd(OfNat(Succ(b_pred)), ru + (selected_constant + k)) →
        cut_dvd(carried_divisor, vout + (carried_out_constant + (-c) * k)) → False)): False
{
    let A = OfNat(Succ(a_pred));
    let B = OfNat(Succ(b_pred));
    let p = rl + -lower_bound;
    let q = ru + -upper_bound;
    let s = rc + carried_constant;
    have negative: (NegSucc(a_pred) * x = -(A * x)) = A.mul_neg_l(x);
    have core_lower: (p <= A * x) = omega(lower, lower_split, negative);
    have core_upper: (B * x + q <= OfNat(0)) = omega(upper, upper_split);
    have core_carried: cut_dvd(d, c * x + s) =
        Exists(witness := carried.witness, proof := {
            have known: (vc + carried_constant = d * carried.witness) = carried.proof;
            omega(carried_split, known)
        });
    cut_cooper_right_core(b_pred, period_pred, A, d, c, x, p, q, s,
        Int::zero_le_ofNat(Succ(a_pred)), period_b, period_c, core_lower, core_upper, core_carried,
        λ k low high cut selected carried_out => {
            have e_p: (B * p = B * rl + B * -lower_bound) = B.mul_add_distr(rl, -lower_bound);
            have e_q: (A * q = A * ru + A * -upper_bound) = A.mul_add_distr(ru, -upper_bound);
            have e_pl: (B * -lower_bound = -(B * lower_bound)) = B.mul_neg_r(lower_bound);
            have e_qu: (A * -upper_bound = -(A * upper_bound)) = A.mul_neg_r(upper_bound);
            have e_k: (-A * k = -(A * k)) = A.mul_neg_l(k);
            have row_cut: (vcut <= cut_bound + -A * k) =
                omega(cut, cut_split, e_p, e_q, e_pl, e_qu, e_k, cut_bound_eq);
            have row_selected: cut_dvd(B, ru + (selected_constant + k)) =
                Exists(witness := selected.witness, proof := {
                    have known: (q + k = B * selected.witness) = selected.proof;
                    omega(known, selected_eq)
                });
            have e_cq: ((-c) * q = (-c) * ru + (-c) * -upper_bound) =
                (-c).mul_add_distr(ru, -upper_bound);
            have e_bs: (B * s = B * rc + B * carried_constant) = B.mul_add_distr(rc, carried_constant);
            have row_carried: cut_dvd(carried_divisor, vout + (carried_out_constant + (-c) * k)) =
                Exists(witness := carried_out.witness, proof := {
                    have known: ((-c) * q + B * s + (-c) * k = (B * d) * carried_out.witness) =
                        carried_out.proof;
                    have scaled: (carried_divisor * carried_out.witness
                        = (B * d) * carried_out.witness) =
                        Int::cong(λ (z: Int) => z * carried_out.witness, carried_divisor_eq);
                    omega(known, carried_out_split, e_cq, e_bs, carried_out_constant_eq, scaled)
                });
            close(k, low, high, row_cut, row_selected, row_carried)
        })
}

// The row-level Cooper steps: each pivot row is its rest plus the pivot
// coefficient times the variable's basis row, checked by evaluation.
theorem cut_cooper_left(index: Nat, atoms, lower_row, upper_row, carried_row,
    lower_rest, upper_rest, carried_rest, cut_row, carried_out_row: List<Int>,
    a_pred, b_pred, period_pred: Nat,
    d, c, lower_bound, upper_bound, carried_constant,
    cut_bound, selected_constant, carried_divisor, carried_out_constant: Int,
    lower_split: lower_row = add_coeffs(lower_rest,
        scale(NegSucc(a_pred), basis(index, atoms))),
    upper_split: upper_row = add_coeffs(upper_rest,
        scale(OfNat(Succ(b_pred)), basis(index, atoms))),
    carried_split: carried_row = add_coeffs(carried_rest,
        scale(c, basis(index, atoms))),
    cut_row_eq: cut_row = combo(OfNat(Succ(b_pred)), lower_rest, OfNat(Succ(a_pred)), upper_rest),
    carried_out_row_eq: carried_out_row = combo(c, lower_rest, OfNat(Succ(a_pred)), carried_rest),
    cut_bound_eq: cut_bound = OfNat(Succ(b_pred)) * lower_bound + OfNat(Succ(a_pred)) * upper_bound,
    selected_eq: selected_constant = -lower_bound,
    carried_divisor_eq: carried_divisor = OfNat(Succ(a_pred)) * d,
    carried_out_constant_eq:
        carried_out_constant = c * -lower_bound + OfNat(Succ(a_pred)) * carried_constant,
    period_a: cut_dvd(OfNat(Succ(a_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(a_pred)) * d, c * OfNat(Succ(period_pred))),
    lower: dot(lower_row, atoms) <= lower_bound,
    upper: dot(upper_row, atoms) <= upper_bound,
    carried: cut_dvd(d, dot(carried_row, atoms) + carried_constant),
    close: Below(Succ(period_pred), λ (k: Int) =>
        dot(cut_row, atoms) <= cut_bound + -OfNat(Succ(b_pred)) * k →
        cut_dvd(OfNat(Succ(a_pred)), dot(lower_rest, atoms) + (selected_constant + k)) →
        cut_dvd(carried_divisor,
            dot(carried_out_row, atoms) + (carried_out_constant + c * k)) → False)): False
{
    cut_cooper_left_values(a_pred, b_pred, period_pred, d, c, nth0(index, atoms),
        dot(lower_rest, atoms), dot(upper_rest, atoms), dot(carried_rest, atoms),
        dot(lower_row, atoms), dot(upper_row, atoms), dot(carried_row, atoms),
        dot(cut_row, atoms), dot(carried_out_row, atoms),
        lower_bound, upper_bound, carried_constant,
        cut_bound, selected_constant, carried_divisor, carried_out_constant,
        trans(cong_dot(atoms, lower_split), dot_pivot(lower_rest, NegSucc(a_pred), index, atoms)),
        trans(cong_dot(atoms, upper_split), dot_pivot(upper_rest, OfNat(Succ(b_pred)), index, atoms)),
        trans(cong_dot(atoms, carried_split), dot_pivot(carried_rest, c, index, atoms)),
        trans(cong_dot(atoms, cut_row_eq),
            dot_combo(OfNat(Succ(b_pred)), lower_rest, OfNat(Succ(a_pred)), upper_rest, atoms)),
        trans(cong_dot(atoms, carried_out_row_eq),
            dot_combo(c, lower_rest, OfNat(Succ(a_pred)), carried_rest, atoms)),
        cut_bound_eq, selected_eq, carried_divisor_eq, carried_out_constant_eq,
        period_a, period_c, lower, upper, carried, close)
}

theorem cut_cooper_right(index: Nat, atoms, lower_row, upper_row, carried_row,
    lower_rest, upper_rest, carried_rest, cut_row, carried_out_row: List<Int>,
    a_pred, b_pred, period_pred: Nat,
    d, c, lower_bound, upper_bound, carried_constant,
    cut_bound, selected_constant, carried_divisor, carried_out_constant: Int,
    lower_split: lower_row = add_coeffs(lower_rest,
        scale(NegSucc(a_pred), basis(index, atoms))),
    upper_split: upper_row = add_coeffs(upper_rest,
        scale(OfNat(Succ(b_pred)), basis(index, atoms))),
    carried_split: carried_row = add_coeffs(carried_rest,
        scale(c, basis(index, atoms))),
    cut_row_eq: cut_row = combo(OfNat(Succ(b_pred)), lower_rest, OfNat(Succ(a_pred)), upper_rest),
    carried_out_row_eq: carried_out_row = combo(-c, upper_rest, OfNat(Succ(b_pred)), carried_rest),
    cut_bound_eq: cut_bound = OfNat(Succ(b_pred)) * lower_bound + OfNat(Succ(a_pred)) * upper_bound,
    selected_eq: selected_constant = -upper_bound,
    carried_divisor_eq: carried_divisor = OfNat(Succ(b_pred)) * d,
    carried_out_constant_eq:
        carried_out_constant = (-c) * -upper_bound + OfNat(Succ(b_pred)) * carried_constant,
    period_b: cut_dvd(OfNat(Succ(b_pred)), OfNat(Succ(period_pred))),
    period_c: cut_dvd(OfNat(Succ(b_pred)) * d, (-c) * OfNat(Succ(period_pred))),
    lower: dot(lower_row, atoms) <= lower_bound,
    upper: dot(upper_row, atoms) <= upper_bound,
    carried: cut_dvd(d, dot(carried_row, atoms) + carried_constant),
    close: Below(Succ(period_pred), λ (k: Int) =>
        dot(cut_row, atoms) <= cut_bound + -OfNat(Succ(a_pred)) * k →
        cut_dvd(OfNat(Succ(b_pred)), dot(upper_rest, atoms) + (selected_constant + k)) →
        cut_dvd(carried_divisor,
            dot(carried_out_row, atoms) + (carried_out_constant + (-c) * k)) → False)): False
{
    cut_cooper_right_values(a_pred, b_pred, period_pred, d, c, nth0(index, atoms),
        dot(lower_rest, atoms), dot(upper_rest, atoms), dot(carried_rest, atoms),
        dot(lower_row, atoms), dot(upper_row, atoms), dot(carried_row, atoms),
        dot(cut_row, atoms), dot(carried_out_row, atoms),
        lower_bound, upper_bound, carried_constant,
        cut_bound, selected_constant, carried_divisor, carried_out_constant,
        trans(cong_dot(atoms, lower_split), dot_pivot(lower_rest, NegSucc(a_pred), index, atoms)),
        trans(cong_dot(atoms, upper_split), dot_pivot(upper_rest, OfNat(Succ(b_pred)), index, atoms)),
        trans(cong_dot(atoms, carried_split), dot_pivot(carried_rest, c, index, atoms)),
        trans(cong_dot(atoms, cut_row_eq),
            dot_combo(OfNat(Succ(b_pred)), lower_rest, OfNat(Succ(a_pred)), upper_rest, atoms)),
        trans(cong_dot(atoms, carried_out_row_eq),
            dot_combo(-c, upper_rest, OfNat(Succ(b_pred)), carried_rest, atoms)),
        cut_bound_eq, selected_eq, carried_divisor_eq, carried_out_constant_eq,
        period_b, period_c, lower, upper, carried, close)
}

// Resolution: `a·left + b·right`, divided by `g` with the bound rounded down.
theorem cut_resolve(a, b, g, bound: Int, left, right, reduced, atoms: List<Int>, l, u: Int,
    ha: OfNat(0) <= a, hb: OfNat(0) <= b, hg: OfNat(0) <= g,
    decomp: combo(a, left, b, right) = scale(g, reduced),
    threshold: a * l + b * u < g * bound.isucc(),
    hl: dot(left, atoms) <= l, hu: dot(right, atoms) <= u):
    dot(reduced, atoms) <= bound
{
    divide_upper(combo(a, left, b, right), reduced, atoms, g, a * l + b * u, bound,
        decomp, hg, threshold, upper_combo(a, b, left, right, atoms, l, u, ha, hb, hl, hu))
}

theorem cut_constant_upper(row, atoms: List<Int>, bound: Int,
    zero: row = zeros(atoms), negative: bound < OfNat(0),
    h: dot(row, atoms) <= bound): False
{
    impossible_constant_upper(row, atoms, bound, h,
        trans(cong_dot(atoms, zero), dot_zeros(atoms)), negative)
}

// `d ∣ c` is false for a constant strictly between two multiples of `d`.
theorem cut_constant_dvd(d_pred: Nat, c, quotient: Int, row, atoms: List<Int>,
    zero: row = zeros(atoms),
    below: OfNat(Succ(d_pred)) * quotient < c,
    above: c < OfNat(Succ(d_pred)) * quotient.isucc(),
    h: cut_dvd(OfNat(Succ(d_pred)), dot(row, atoms) + c)): False
{
    let D = OfNat(Succ(d_pred));
    have vanished: (dot(row, atoms) = OfNat(0)) =
        trans(cong_dot(atoms, zero), dot_zeros(atoms));
    have known: (dot(row, atoms) + c = D * h.witness) = h.proof;
    have value: (c = D * h.witness) = omega(vanished, known);
    match h.witness.le_dec(quotient) {
        Inl(small) => {
            have scaled: (D * h.witness <= D * quotient) =
                h.witness.mul_le_mono_l(quotient, D, small, Int::zero_le_ofNat(Succ(d_pred)));
            omega(scaled, value, below)
        },
        Inr(large) => {
            have next: (quotient.isucc() <= h.witness) = quotient.lt_of_not_le(h.witness, large);
            have scaled: (D * quotient.isucc() <= D * h.witness) =
                quotient.isucc().mul_le_mono_l(h.witness, D, next, Int::zero_le_ofNat(Succ(d_pred)));
            omega(scaled, value, above)
        },
    }
}

theorem cut_dvd_one(value: Int): cut_dvd(OfNat(1), value) {
    Exists(witness := value, proof := sym(value.one_mul()))
}

// Two divisibility facts combined: `s1·(left) + s2·(right)` is a multiple of
// `d` whenever `d` divides `s1·d1` and `s2·d2`.
theorem cut_dvd_combo(d1, d2, d, s1, s2, m1, m2, c1, c2, c: Int,
    left, right, row, atoms: List<Int>,
    row_eq: row = combo(s1, left, s2, right),
    constant_eq: c = s1 * c1 + s2 * c2,
    first: s1 * d1 = d * m1, second: s2 * d2 = d * m2,
    h1: cut_dvd(d1, dot(left, atoms) + c1),
    h2: cut_dvd(d2, dot(right, atoms) + c2)):
    cut_dvd(d, dot(row, atoms) + c)
{
    let v1 = dot(left, atoms) + c1;
    let v2 = dot(right, atoms) + c2;
    have value_eq: (dot(row, atoms) + c = s1 * v1 + s2 * v2) = {
        have spread: (dot(row, atoms)
            = s1 * dot(left, atoms) + s2 * dot(right, atoms)) =
            trans(cong_dot(atoms, row_eq), dot_combo(s1, left, s2, right, atoms));
        have e1: (s1 * v1 = s1 * dot(left, atoms) + s1 * c1) =
            s1.mul_add_distr(dot(left, atoms), c1);
        have e2: (s2 * v2 = s2 * dot(right, atoms) + s2 * c2) =
            s2.mul_add_distr(dot(right, atoms), c2);
        omega(spread, e1, e2, constant_eq)
    };
    Exists(witness := m1 * h1.witness + m2 * h2.witness, proof := calc {
        dot(row, atoms) + c = s1 * v1 + s2 * v2 := value_eq,
          = s1 * (d1 * h1.witness) + s2 * (d2 * h2.witness) :=
                Int::cong(λ (z: Int) => s1 * z + s2 * v2, h1.proof)
                .trans(Int::cong(λ (z: Int) => s1 * (d1 * h1.witness) + s2 * z, h2.proof)),
          = (s1 * d1) * h1.witness + (s2 * d2) * h2.witness :=
                sym(Int::cong(λ (z: Int) => z + (s2 * d2) * h2.witness,
                        s1.mul_assoc(d1, h1.witness))
                    .trans(Int::cong(λ (z: Int) => s1 * (d1 * h1.witness) + z,
                        s2.mul_assoc(d2, h2.witness)))),
          = (d * m1) * h1.witness + (d * m2) * h2.witness :=
                Int::cong(λ (z: Int) => z * h1.witness + (s2 * d2) * h2.witness, first)
                .trans(Int::cong(λ (z: Int) => (d * m1) * h1.witness + z * h2.witness, second)),
          = d * (m1 * h1.witness) + d * (m2 * h2.witness) :=
                Int::cong(λ (z: Int) => z + (d * m2) * h2.witness, d.mul_assoc(m1, h1.witness))
                .trans(Int::cong(λ (z: Int) => d * (m1 * h1.witness) + z,
                    d.mul_assoc(m2, h2.witness))),
          = d * (m1 * h1.witness + m2 * h2.witness) :=
                sym(d.mul_add_distr(m1 * h1.witness, m2 * h2.witness)),
    })
}

// Dropping a variable whose coefficient `g·quotient` is a multiple of the
// new divisor `g`, which divides the old one.
theorem cut_dvd_drop(index: Nat, d, g, m, quotient, c: Int, row, rest, atoms: List<Int>,
    divisor_eq: d = g * m,
    row_split: row = add_coeffs(rest,
        scale(g * quotient, basis(index, atoms))),
    h: cut_dvd(d, dot(row, atoms) + c)):
    cut_dvd(g, dot(rest, atoms) + c)
{
    let x = nth0(index, atoms);
    have spread: (dot(row, atoms) = dot(rest, atoms) + (g * quotient) * x) =
        trans(cong_dot(atoms, row_split), dot_pivot(rest, g * quotient, index, atoms));
    have known: (dot(row, atoms) + c = d * h.witness) = h.proof;
    have e1: (d * h.witness = g * (m * h.witness)) = calc {
        d * h.witness = (g * m) * h.witness := Int::cong(λ (z: Int) => z * h.witness, divisor_eq),
                      = g * (m * h.witness) := g.mul_assoc(m, h.witness),
    };
    have e2: ((g * quotient) * x = g * (quotient * x)) = g.mul_assoc(quotient, x);
    have e3: (g * (m * h.witness + -(quotient * x)) = g * (m * h.witness) + -(g * (quotient * x))) = calc {
        g * (m * h.witness + -(quotient * x))
            = g * (m * h.witness) + g * -(quotient * x) := g.mul_add_distr(m * h.witness, -(quotient * x)),
            = g * (m * h.witness) + -(g * (quotient * x)) :=
                Int::cong(λ (z: Int) => g * (m * h.witness) + z, g.mul_neg_r(quotient * x)),
    };
    Exists(witness := m * h.witness + -(quotient * x), proof := omega(spread, known, e1, e2, e3))
}

theorem cut_diseq_below(v, c, below_bound: Int,
    below_eq: below_bound = -c + NegSucc(0), negative: v + c < OfNat(0)): v <= below_bound
{
    omega(negative, below_eq)
}

theorem cut_diseq_above(v, w, c, above_bound: Int,
    w_eq: w = -v, above_eq: above_bound = c + NegSucc(0), positive: OfNat(0) < v + c):
    w <= above_bound
{
    omega(positive, w_eq, above_eq)
}

theorem cut_diseq_values(v, w, c, below_bound, above_bound: Int,
    w_eq: w = -v, below_eq: below_bound = -c + NegSucc(0), above_eq: above_bound = c + NegSucc(0),
    h: v + c ≠ OfNat(0), below: v <= below_bound → False, above: w <= above_bound → False): False
{
    match (v + c).lt_trichotomy(OfNat(0)) {
        Inl(negative) => below(cut_diseq_below(v, c, below_bound, below_eq, negative)),
        Inr(other) => match other {
            Inl(zero) => h(zero),
            Inr(positive) => above(cut_diseq_above(v, w, c, above_bound, w_eq, above_eq, positive)),
        },
    }
}

// `p ≠ 0` splits into `p + 1 <= 0` and `-p + 1 <= 0`.
theorem cut_diseq(row, negated, atoms: List<Int>, c, below_bound, above_bound: Int,
    negated_eq: negated = scale(NegSucc(0), row),
    below_eq: below_bound = -c + NegSucc(0), above_eq: above_bound = c + NegSucc(0),
    h: dot(row, atoms) + c ≠ OfNat(0),
    below: dot(row, atoms) <= below_bound → False,
    above: dot(negated, atoms) <= above_bound → False): False
{
    cut_diseq_values(dot(row, atoms), dot(negated, atoms), c, below_bound, above_bound,
        trans(cong_dot(atoms, negated_eq),
            trans(dot_scale(NegSucc(0), row, atoms), neg_one_mul(dot(row, atoms)))),
        below_eq, above_eq, h, below, above)
}

theorem cut_constant_diseq(row, atoms: List<Int>, zero: row = zeros(atoms),
    h: dot(row, atoms) + OfNat(0) ≠ OfNat(0)): False
{
    h(trans(dot(row, atoms).add_zero(),
        trans(cong_dot(atoms, zero), dot_zeros(atoms))))
}

// A disequality's normal form, as CutSat reads it: `dot(row) + c ≠ 0`.
// The arithmetic is over abstract values, since Omega reads `dot` terms.
theorem normalized_ne_values(x, y, cx, cy, dl, dr, ds: Int,
    hx: x = cx + dl, hy: y = cy + dr, hs: ds = dl + (-dr),
    e: ds + (cx + (-cy)) = OfNat(0)): x = y
{ omega }

theorem normalized_ne_value(x, y, cx, cy: Int, left, right, atoms: List<Int>,
    hx: x = cx + dot(left, atoms), hy: y = cy + dot(right, atoms), h: x ≠ y):
    dot(sub_coeffs(left, right), atoms) + (cx + (-cy)) ≠ OfNat(0)
{
    λ (e: dot(sub_coeffs(left, right), atoms) + (cx + (-cy)) = OfNat(0)) =>
        h(normalized_ne_values(x, y, cx, cy, dot(left, atoms), dot(right, atoms),
            dot(sub_coeffs(left, right), atoms), hx, hy, dot_sub(left, right, atoms), e))
}

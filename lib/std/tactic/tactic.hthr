// Tactics written in Heather, as request trees
// (docs/host-elaboration-interface-design.md).
//
// A tactic is an ordinary value of type `Tac<A>`: either a result, or a
// request to the elaborator with a continuation that receives the answer.
// `by t` in a proof position runs `t : Tac<Expr>` against the goal. The
// elaborator answers each request, and the `Expr` the tactic finally returns
// is checked at the goal like any other proof, so a tactic is never trusted:
// a wrong one is refused at its `by`.
//
// A tactic's argument that expects an `Expr` may be any term of the goal's
// context: `by exact(h)` with `h` a hypothesis hands the tactic a handle to
// `h`. Everything else about a tactic's arguments is closed; a tactic reaches
// the goal's locals through `Goal`.
//
// Importing this module imports the *protocol*, never an implementation.
// What answers is the elaborator running the build; a Heather handler for the
// same requests is an ordinary function over `Tac<A>` (the probe in
// crates/elab/tests/tactic_request_tree.rs runs one by `refl`).

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;

// ---------------------------------------------------------------------------
// Terms, as a tactic holds them.
//
// A tactic never holds a kernel term. It holds an `Expr`: a handle to a term
// or type the elaborator has, a local of the goal's context, or structure it
// built itself. Handles and local references are numbers the elaborator
// issued during this run; it validates every one it is given, so forging one
// is an error at the `by`, never a soundness question.
//
// A local is either one of the goal's or one `Open` introduced; `Lam(x, b)`
// abstracts an introduced `x` out of `b`. The elaborator keeps track of which
// binder each handle and local lives under, and refuses an `Expr` that uses
// one outside it.
//
// A `GlobalRef` is a global as the elaborator identifies it: `View` and
// `Lookup` hand one out, the same number for the same global throughout a
// run, so a tactic compares heads by identity rather than by name.
// `Global(g)` is that global as a term, with its whole type.

record Handle { id: Nat }
record LocalRef { id: Nat }
record GlobalRef { id: Nat }

inductive Expr {
    Hd(h: Handle),
    Local(x: LocalRef),
    App(f: Expr, a: Expr),
    NatLit(n: Nat),
    Lam(x: LocalRef, body: Expr),
    Global(g: GlobalRef),
}

// One local of the goal's context: how to refer to it, its name for
// messages, and its type. A block's `let` is one too, and `Local` of it is
// its value.
record LocalInfo { ref: LocalRef, name: String, ty: Handle }

// The goal: its statement, and its locals, the most recent first.
record GoalInfo { target: Handle, locals: List<LocalInfo> }

// One layer of a term or type, as `View` presents it: the head the
// diagnostics would print, with its children as handles again. Nothing is
// reduced (`Whnf` does that), and a form the view does not present is
// `HOther`.
inductive Head {
    // A function type, by its domain; `Open` reaches its body.
    HPi(dom: Handle),
    // An equation, by its two sides.
    HEq(lhs: Handle, rhs: Handle),
    // A named global or type applied: `Nat::le(n, m)`, `List<Nat>`. Only the
    // arguments a call writes are listed, implicit ones left out.
    HGlobal(g: GlobalRef, name: String, args: List<Handle>),
    // A local, applied to arguments.
    HLocal(x: LocalRef, args: List<Handle>),
    // A field read of a record whose declaration registers no projection
    // definition, applied: a class dictionary's `d.inv(x)` or `d.unit`, by
    // the record, the field's name and the arguments. (A field with a
    // projection definition is that global's `HGlobal`.)
    HField(of: Handle, name: String, args: List<Handle>),
    HLit(n: Nat),
    // A `match` stuck on its scrutinee: a term that only reduces once
    // `scrut` is a constructor.
    HMatch(scrut: Handle),
    // A hole nothing has solved yet.
    HHole,
    HOther,
}

// One line of a failure's search state. `Under` marks a note about a
// sub-search, shown one level deeper; `At` is a note about a term, which the
// elaborator spells the way its own diagnostics do.
inductive Note { Tried(what: String, verdict: String), Under(n: Note), At(e: Expr, n: Note) }

// The answer to a request that may be refused, with the reason.
inductive Checked<A> { Accepted(a: A), Refused(why: String) }

// A binder `Open` introduced: the new local, the binder's body, which lives
// under it, and whether the body mentions the local (a dependent function
// type, rather than an implication).
record Opened { local: LocalInfo, body: Handle, dependent: Bool }

// One branch of a split: the locals it adds to the context, the most recent
// first, and the statement its proof proves there.
record Branch { locals: List<LocalInfo>, goal: Handle }

// A split of a goal into branches (`Cases`, `Constructor`). `Close` turns one
// proof per branch into a proof of the goal.
record Split { id: Nat, branches: List<Branch> }

// ---------------------------------------------------------------------------
// The requests, and the request tree.

inductive Req {
    // The goal and its local context.
    Goal,
    // Are the two definitionally equal, at the goal's context?
    Defeq(a: Expr, b: Expr),
    // End the run: the invocation fails with the message and the notes.
    Fail(msg: String, notes: List<Note>),
    // The type of a term.
    Infer(e: Expr),
    // Introduce the binder of a function type, by its head normal form: a
    // fresh local of its domain, and its body under that local.
    Open(h: Handle, name: String),
    // A name, resolved and elaborated where the `by` is (not where the
    // tactic is declared), as a handle to the term.
    Resolve(name: String),
    // One layer of a handle (see `Head`).
    View(h: Handle),
    // A handle to the head normal form of a type or term.
    Whnf(h: Handle),
    // Match the conclusion of the function type `ty` against `target`,
    // treating its leading parameters as unknowns: for the fewest parameters
    // that make it match, each one's value where the match determines it, and
    // `None` where it is left for the caller to prove.
    Match(ty: Handle, target: Handle),
    // A hole of type `ty`: a term not known yet, which the requests that
    // compare terms solve (`Defeq`, and checking an `Expr`'s applications).
    // A run's result may mention holes only once they are solved.
    Hole(ty: Handle),
    // The holes' solutions so far, as a mark to come back to.
    Mark,
    // Forget every solution found since `mark`.
    Restore(mark: Nat),
    // A name, resolved where the `by` is, as the global it denotes.
    Lookup(name: String),
    // Split `goal` by cases on `e`, whose type is an inductive with no
    // recursive field and no index: the elaborator's own `match`, one branch
    // per constructor. A branch's locals are the constructor's fields and an
    // equation `e = C(fields)`; its goal is `goal` with `e`, and what reaches
    // `e` through a definition, replaced by `C(fields)`.
    Cases(e: Expr, goal: Handle),
    // Split a goal whose type is an inductive with one constructor into one
    // branch per field (`P ∧ Q` into `P` and `Q`). A field whose type
    // mentions an earlier one is refused.
    Constructor(goal: Handle),
    // The proof of a split's goal, from one proof per branch, in order.
    Close(id: Nat, proofs: List<Expr>),
}

inductive Never {}

// What each request is answered with. `Fail` is answered in the empty type,
// so a failure has no continuation by type.
fn Resp(r: Req) → Type {
    match r {
        Goal => GoalInfo,
        Defeq(_, _) => Bool,
        Fail(_, _) => Never,
        Infer(_) => Checked<Handle>,
        Open(_, _) => Checked<Opened>,
        Resolve(_) => Checked<Handle>,
        View(_) => Head,
        Whnf(_) => Checked<Handle>,
        Match(_, _) => Checked<List<Option<Handle>>>,
        Hole(_) => Checked<Handle>,
        Mark => Nat,
        Restore(_) => True,
        Lookup(_) => Checked<GlobalRef>,
        Cases(_, _) => Checked<Split>,
        Constructor(_) => Checked<Split>,
        Close(_, _) => Checked<Handle>,
    }
}

inductive Tac<A> { Pure(a: A), Ask(r: Req, k: Resp(r) → Tac<A>) }

fn Tac::bind<A, B>(self t: Tac<A>, f: A → Tac<B>) → Tac<B> {
    match t { Pure(a) => f(a), Ask(r, k) => Ask(r, λ x => k(x).bind(f)) }
}

fn goal() → Tac<GoalInfo> { Ask(Goal, λ g => Pure(g)) }

fn defeq(a: Expr, b: Expr) → Tac<Bool> { Ask(Defeq(a, b), λ same => Pure(same)) }

fn fail<A>(msg: String, notes: List<Note>) → Tac<A> {
    Ask(Fail(msg, notes), λ never => match never {})
}

fn infer(e: Expr) → Tac<Checked<Handle>> { Ask(Infer(e), λ c => Pure(c)) }

fn open(h: Handle, name: String) → Tac<Checked<Opened>> { Ask(Open(h, name), λ c => Pure(c)) }

fn resolve(name: String) → Tac<Checked<Handle>> { Ask(Resolve(name), λ c => Pure(c)) }

fn view(h: Handle) → Tac<Head> { Ask(View(h), λ v => Pure(v)) }

fn whnf(h: Handle) → Tac<Checked<Handle>> { Ask(Whnf(h), λ c => Pure(c)) }

fn match_conclusion(ty: Handle, target: Handle) → Tac<Checked<List<Option<Handle>>>> { Ask(Match(ty, target), λ c => Pure(c)) }

fn hole(ty: Handle) → Tac<Checked<Handle>> { Ask(Hole(ty), λ c => Pure(c)) }

fn mark() → Tac<Nat> { Ask(Mark, λ m => Pure(m)) }

fn restore(m: Nat) → Tac<True> { Ask(Restore(m), λ u => Pure(u)) }

fn lookup(name: String) → Tac<Checked<GlobalRef>> { Ask(Lookup(name), λ c => Pure(c)) }

fn cases(e: Expr, goal: Handle) → Tac<Checked<Split>> { Ask(Cases(e, goal), λ c => Pure(c)) }

fn constructor(goal: Handle) → Tac<Checked<Split>> { Ask(Constructor(goal), λ c => Pure(c)) }

fn close(id: Nat, proofs: List<Expr>) → Tac<Checked<Handle>> { Ask(Close(id, proofs), λ c => Pure(c)) }

// An answer of any kind, as the elaborator builds one, and the answer at a
// request's own type. A `match` on the request would not refine the
// continuation's domain, so the dependent answer is computed by `fit`
// (design §9).
inductive Answer {
    AGoal(g: GoalInfo),
    ABool(b: Bool),
    AHandle(c: Checked<Handle>),
    AOpened(c: Checked<Opened>),
    AHead(h: Head),
    AMatch(c: Checked<List<Option<Handle>>>),
    ANat(n: Nat),
    AUnit,
    AGlobal(c: Checked<GlobalRef>),
    ASplit(c: Checked<Split>),
}

inductive Fit<R> { Mismatch, Fits(a: R) }

fn fit(r: Req, a: Answer) → Fit<Resp(r)> {
    match r {
        Goal => match a { AGoal(g) => Fits(g), _ => Mismatch },
        Defeq(_, _) => match a { ABool(b) => Fits(b), _ => Mismatch },
        Fail(_, _) => Mismatch,
        Infer(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        Open(_, _) => match a { AOpened(c) => Fits(c), _ => Mismatch },
        Resolve(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        View(_) => match a { AHead(h) => Fits(h), _ => Mismatch },
        Whnf(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        Match(_, _) => match a { AMatch(c) => Fits(c), _ => Mismatch },
        Hole(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        Mark => match a { ANat(n) => Fits(n), _ => Mismatch },
        Restore(_) => match a { AUnit => Fits(trivial), _ => Mismatch },
        Lookup(_) => match a { AGlobal(c) => Fits(c), _ => Mismatch },
        Cases(_, _) => match a { ASplit(c) => Fits(c), _ => Mismatch },
        Constructor(_) => match a { ASplit(c) => Fits(c), _ => Mismatch },
        Close(_, _) => match a { AHandle(c) => Fits(c), _ => Mismatch },
    }
}

// ---------------------------------------------------------------------------
// Handlers: tactics that run other tactics.
//
// Each is an ordinary function over the request tree that answers some of
// its requests itself and passes the rest on, so the elaborator never knows
// about them.

// Run `t` against `g`: its `Goal` requests are answered with `g`, and every
// other request goes to the elaborator. This is how a tactic works on a
// subgoal, such as the body of a binder it opened.
fn focus<A>(g: GoalInfo, t: Tac<A>) → Tac<A> {
    match t {
        Pure(a) => Pure(a),
        Ask(r, k) => match fit(r, AGoal(g)) {
            Fits(x) => focus(g, k(x)),
            Mismatch => Ask(r, λ x => focus(g, k(x))),
        },
    }
}

inductive Outcome<A> { Done(a: A), Failed(msg: String, notes: List<Note>) }

fn attempt_from<A>(m: Nat, t: Tac<A>) → Tac<Outcome<A>> {
    match t {
        Pure(a) => Pure(Done(a)),
        Ask(r, k) => match r {
            Fail(msg, notes) => restore(m).bind(λ _ => Pure(Failed(msg, notes))),
            _ => Ask(r, λ x => attempt_from(m, k(x))),
        },
    }
}

// Run `t`, catching its failure. Solving holes is the only state a request
// changes, so when `t` fails its solutions are forgotten and the next thing
// tried starts where `t` did.
fn attempt<A>(t: Tac<A>) → Tac<Outcome<A>> { mark().bind(λ m => attempt_from(m, t)) }

fn under_all(ns: List<Note>) → List<Note> {
    match ns { Nil => [], Cons(n, rest) => Cons(Under(n), under_all(rest)) }
}

fn first_of_among<A>(ts: List<Tac<A>>, tried: List<Note>) → Tac<A> {
    match ts {
        Nil => fail("no alternative succeeded", tried),
        Cons(t, rest) => attempt(t).bind(λ o => match o {
            Done(a) => Pure(a),
            Failed(msg, notes) => first_of_among(rest, (tried ++ [Tried("an alternative", msg)]) ++ under_all(notes)),
        }),
    }
}

// The first of `ts` that succeeds. A failure lists every alternative's
// failure, with its own notes beneath it.
fn first_of<A>(ts: List<Tac<A>>) → Tac<A> { first_of_among(ts, []) }

// ---------------------------------------------------------------------------
// Tactics.

// `assumption`: a local whose type is the goal, up to definitional equality.
// The most recent local is tried first; a failure lists every local tried.
fn assumption_among(target: Handle, ls: List<LocalInfo>, tried: List<Note>) → Tac<Expr> {
    match ls {
        Nil => fail("no local's type is the goal", tried),
        Cons(l, rest) => defeq(Hd(l.ty), Hd(target)).bind(λ same => match same {
            True => Pure(Local(l.ref)),
            False => assumption_among(target, rest, tried ++ [Tried(l.name, "its type is not the goal")]),
        }),
    }
}

fn assumption() → Tac<Expr> {
    goal().bind(λ g => assumption_among(g.target, g.locals, []))
}

// `exact(e)`: `e` itself, if its type is the goal.
fn exact(e: Expr) → Tac<Expr> {
    goal().bind(λ g => infer(e).bind(λ c => match c {
        Refused(why) => fail("exact: " ++ why, []),
        Accepted(ty) => defeq(Hd(ty), Hd(g.target)).bind(λ same => match same {
            True => Pure(e),
            False => fail("exact: the term's type is not the goal", []),
        }),
    }))
}

// `intro_as(name, t)`: open the goal's binder as a local called `name`,
// prove the body with `t`, and abstract the local again. The name is for
// messages; nothing resolves it.
fn intro_as(name: String, t: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => open(g.target, name).bind(λ c => match c {
        Refused(why) => fail("intro: " ++ why, []),
        Accepted(o) => focus(GoalInfo(o.body, Cons(o.local, g.locals)), t).bind(λ e => Pure(Lam(o.local.ref, e))),
    }))
}

// `intro(t)`: `intro_as` with the local called `x`.
fn intro(t: Tac<Expr>) → Tac<Expr> { intro_as("x", t) }

// The holes `apply` left for later parameters to determine: each one still
// unsolved is proved by `premise` at its type, and the proof is its solution.
fn apply_holes(holes: List<Handle>, e: Expr, locals: List<LocalInfo>, premise: Tac<Expr>) → Tac<Expr> {
    match holes {
        Nil => Pure(e),
        Cons(h, rest) => view(h).bind(λ v => match v {
            HHole => infer(Hd(h)).bind(λ c => match c {
                Refused(why) => fail("apply: " ++ why, []),
                Accepted(ty) => focus(GoalInfo(ty, locals), premise).bind(λ p => defeq(Hd(h), p).bind(λ same => match same {
                    True => apply_holes(rest, e, locals, premise),
                    False => fail("apply: the proof of a postponed argument is not of its type", []),
                })),
            }),
            _ => apply_holes(rest, e, locals, premise),
        }),
    }
}

// One argument of `apply`, and the hole it is if it is one.
record Argument { a: Expr, holes: List<Handle> }

// The argument for one slot of a match, at the function type `ty`.
fn argument(s: Option<Handle>, ty: Handle, locals: List<LocalInfo>, premise: Tac<Expr>) → Tac<Argument> {
    match s {
        Some(h) => Pure(Argument(Hd(h), [])),
        None => open(ty, "_").bind(λ c => match c {
            Refused(why) => fail("apply: " ++ why, []),
            Accepted(o) => match o.dependent {
                True => hole(o.local.ty).bind(λ c2 => match c2 {
                    Refused(why) => fail("apply: " ++ why, []),
                    Accepted(h) => Pure(Argument(Hd(h), [h])),
                }),
                False => focus(GoalInfo(o.local.ty, locals), premise).bind(λ a => Pure(Argument(a, []))),
            },
        }),
    }
}

// `f`, whose type is `ty`, applied to one argument per slot. A slot the match
// determined is that value. An open one that later parameters depend on is a
// hole, which proving them may solve; any other open one is proved by
// `premise` at the parameter's type, which by then mentions the arguments
// before it. Holes still open at the end are proved last.
fn apply_slots(slots: List<Option<Handle>>, f: Expr, ty: Handle, locals: List<LocalInfo>, premise: Tac<Expr>, holes: List<Handle>) → Tac<Expr> {
    match slots {
        Nil => apply_holes(holes, f, locals, premise),
        Cons(s, rest) => argument(s, ty, locals, premise).bind(λ arg => infer(App(f, arg.a)).bind(λ c => match c {
            Refused(why) => fail("apply: " ++ why, []),
            Accepted(ty2) => apply_slots(rest, App(f, arg.a), ty2, locals, premise, holes ++ arg.holes),
        })),
    }
}

// `apply(f, premise)`: use `f` backwards. Its conclusion is matched against
// the goal with its parameters as unknowns, as few of them as it takes;
// those the match determines are filled in, implicit ones included. The
// premises are proved left to right by `premise`, and a parameter only a
// premise determines (`trans`'s middle point) is a hole that proving that
// premise solves.
fn apply(f: Expr, premise: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => infer(f).bind(λ c => match c {
        Refused(why) => fail("apply: " ++ why, []),
        Accepted(ty) => match_conclusion(ty, g.target).bind(λ m => match m {
            Refused(why) => fail("apply: " ++ why, []),
            Accepted(slots) => apply_slots(slots, f, ty, g.locals, premise, []),
        }),
    }))
}

// A handle's head normal form, or the handle itself where it has none.
fn whnf_or(h: Handle) → Tac<Handle> {
    whnf(h).bind(λ c => match c { Accepted(w) => Pure(w), Refused(_) => Pure(h) })
}

// `x = x`, for `reflexivity` to apply: a run's result is an `Expr`, and
// `refl` is a form of the surface, not a term a tactic can hold.
theorem rfl<A>({x: A}): x = x { refl }

// `reflexivity`: an equation whose two sides are definitionally equal. The
// goal is read in head normal form, so a statement a definition unfolds to an
// equation is one.
fn reflexivity() → Tac<Expr> {
    goal().bind(λ g => whnf(g.target).bind(λ c => match c {
        Refused(why) => fail("reflexivity: " ++ why, []),
        Accepted(w) => view(w).bind(λ v => match v {
            HEq(l, r) => defeq(Hd(l), Hd(r)).bind(λ same => match same {
                False => whnf_or(l).bind(λ wl => whnf_or(r).bind(λ wr =>
                    fail("reflexivity: the two sides differ", [At(Hd(wl), Tried("the left side", "against the right")), At(Hd(wr), Tried("the right side", "against the left"))]))),
                True => lookup("tactic::rfl").bind(λ c2 => match c2 {
                    Refused(why) => fail("reflexivity: " ++ why, []),
                    Accepted(rf) => focus(GoalInfo(w, g.locals), apply(Global(rf), fail("reflexivity: `rfl` has no premise", []))),
                }),
            }),
            _ => fail("reflexivity: the goal is not an equation", [At(Hd(w), Tried("the goal", "not an equation"))]),
        }),
    }))
}

// ---------------------------------------------------------------------------
// Splitting goals.

// Each branch of a split proved by `t`, with the branch's locals in front of
// `locals`.
fn prove_branches(bs: List<Branch>, locals: List<LocalInfo>, t: Tac<Expr>) → Tac<List<Expr>> {
    match bs {
        Nil => Pure([]),
        Cons(b, rest) => focus(GoalInfo(b.goal, b.locals ++ locals), t).bind(λ p =>
            prove_branches(rest, locals, t).bind(λ ps => Pure(Cons(p, ps)))),
    }
}

// The proof of a split's goal, its branches proved by `t`.
fn close_by(s: Split, locals: List<LocalInfo>, t: Tac<Expr>) → Tac<Expr> {
    prove_branches(s.branches, locals, t).bind(λ ps => close(s.id, ps).bind(λ c => match c {
        Refused(why) => fail("close: " ++ why, []),
        Accepted(h) => Pure(Hd(h)),
    }))
}

// `cases_on(e, t)`: split the goal by cases on `e` and prove every branch
// with `t`.
fn cases_on(e: Expr, t: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => cases(e, g.target).bind(λ c => match c {
        Refused(why) => fail("cases: " ++ why, [At(e, Tried("the scrutinee", "not split"))]),
        Accepted(s) => close_by(s, g.locals, t),
    }))
}

// Does a split have other than one branch? Splitting a record adds no case.
fn branches_many(bs: List<Branch>) → Bool {
    match bs { Nil => True, Cons(_, rest) => match rest { Nil => False, Cons(_, _) => True } }
}

// A name no source can write: a `match`'s own binders are `#…`.
fn unwritten(name: String) → Bool {
    match name.chars { Nil => False, Cons(c, _) => c.code.same(35) }
}

// Split the goal by cases on each local of `ls` whose type has more than one
// constructor and none recursive, then run `t` in every branch.
fn split_locals(ls: List<LocalInfo>, t: Tac<Expr>) → Tac<Expr> {
    match ls {
        Nil => t,
        Cons(l, rest) => match unwritten(l.name) {
            True => split_locals(rest, t),
            False => goal().bind(λ g => cases(Local(l.ref), g.target).bind(λ c => match c {
                Refused(_) => split_locals(rest, t),
                Accepted(s) => match branches_many(s.branches) {
                    False => split_locals(rest, t),
                    True => close_by(s, g.locals, split_locals(rest, t)),
                },
            })),
        },
    }
}

// The first blocker `blocker` finds among `hs`.
fn blocker_among(hs: List<Handle>, blocker: Handle → Tac<Option<Handle>>) → Tac<Option<Handle>> {
    match hs {
        Nil => Pure(None),
        Cons(h, rest) => blocker(h).bind(λ o => match o {
            Some(x) => Pure(Some(x)),
            None => blocker_among(rest, blocker),
        }),
    }
}

// A call's arguments, as `View` lists them; a field read's record first.
fn head_args(v: Head) → List<Handle> {
    match v { HGlobal(_, _, args) => args, HLocal(_, args) => args, HField(r, _, args) => Cons(r, args), _ => [] }
}

// What blocks a term: the scrutinee of the `match` its head normal form is
// stuck on. A call's arguments are searched first, and a scrutinee's own
// blocker comes before it, so the deepest one is split first.
fn blocker(fuel: Nat, t: Handle) → Tac<Option<Handle>> {
    match fuel {
        Zero => Pure(None),
        Succ(f) => view(t).bind(λ v => blocker_among(head_args(v), λ h => blocker(f, h)).bind(λ inside => match inside {
            Some(x) => Pure(Some(x)),
            None => whnf(t).bind(λ c => match c {
                Refused(_) => Pure(None),
                Accepted(w) => view(w).bind(λ wv => match wv {
                    HMatch(s) => blocker(f, s).bind(λ o => match o {
                        Some(x) => Pure(Some(x)),
                        None => Pure(Some(s)),
                    }),
                    _ => Pure(None),
                }),
            }),
        })),
    }
}

// One step of `split_all` at the goal in hand: introduce a binder and split
// it, prove a conjunction one side at a time, split the `match` an equation's
// side is stuck on, or hand the goal to `leaf`.
fn split_step(fuel: Nat, leaf: Tac<Expr>) → Tac<Expr> {
    match fuel {
        Zero => leaf,
        Succ(f) => goal().bind(λ g => whnf(g.target).bind(λ c => match c {
            Refused(_) => leaf,
            Accepted(w) => view(w).bind(λ v => match v {
                HPi(_) => open(g.target, "x").bind(λ o => match o {
                    Refused(_) => leaf,
                    Accepted(op) => focus(GoalInfo(op.body, Cons(op.local, g.locals)), split_locals([op.local], split_step(f, leaf)))
                        .bind(λ e => Pure(Lam(op.local.ref, e))),
                }),
                HGlobal(r, _, _) => lookup("And").bind(λ a => match a {
                    Refused(_) => leaf,
                    Accepted(and) => match r.id.same(and.id) {
                        False => leaf,
                        True => constructor(w).bind(λ s => match s {
                            Refused(_) => leaf,
                            Accepted(sp) => close_by(sp, g.locals, split_step(f, leaf)),
                        }),
                    },
                }),
                HEq(l, r) => blocker_among([l, r], λ h => blocker(64, h)).bind(λ found => match found {
                    None => leaf,
                    Some(s) => cases(Hd(s), w).bind(λ sc => match sc {
                        Refused(_) => leaf,
                        Accepted(sp) => close_by(sp, g.locals, split_step(f, leaf)),
                    }),
                }),
                _ => leaf,
            }),
        })),
    }
}

// `split_all(leaf)`: split the goal into one goal per case and prove each with
// `leaf`. Every local of a finite type is split first; then binders are
// introduced (and split when finite), conjunctions are proved one side at a
// time, and an equation is split on the `match` that blocks one of its
// sides, deepest first, until none does. Each split is the elaborator's own
// `match`, so the proof is an ordinary term.
fn split_all(leaf: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => split_locals(g.locals, split_step(64, leaf)))
}

// ---------------------------------------------------------------------------
// The host's side of the protocol.
//
// The elaborator runs a `Tac<Expr>` through these functions instead of
// decoding the lowered encodings by hand: each one asks a single question of
// the tree, and its answer is a numeral, an `Expr` or a `String`. They are
// part of the protocol's definition, not of any tactic, and a tactic has no
// reason to call them.

// 0: a result. 1: `Goal`. 2: `Defeq`. 3: `Fail`. 4: `Infer`. 5: `Open`.
// 6: `Resolve`. 7: `View`. 8: `Whnf`. 9: `Match`. 10: `Hole`. 11: `Mark`.
// 12: `Restore`. 13: `Lookup`. 14: `Cases`. 15: `Constructor`. 16: `Close`.
fn host_tag(t: Tac<Expr>) → Nat {
    match t {
        Pure(_) => 0,
        Ask(r, _) => match r {
            Goal => 1,
            Defeq(_, _) => 2,
            Fail(_, _) => 3,
            Infer(_) => 4,
            Open(_, _) => 5,
            Resolve(_) => 6,
            View(_) => 7,
            Whnf(_) => 8,
            Match(_, _) => 9,
            Hole(_) => 10,
            Mark => 11,
            Restore(_) => 12,
            Lookup(_) => 13,
            Cases(_, _) => 14,
            Constructor(_) => 15,
            Close(_, _) => 16,
        },
    }
}

fn host_result(t: Tac<Expr>) → Expr {
    match t { Pure(e) => e, Ask(_, _) => NatLit(0) }
}

fn host_lhs(t: Tac<Expr>) → Expr {
    match t {
        Pure(e) => e,
        Ask(r, _) => match r { Defeq(a, _) => a, Infer(e) => e, Cases(e, _) => e, _ => NatLit(0) },
    }
}

fn host_rhs(t: Tac<Expr>) → Expr {
    match t {
        Pure(e) => e,
        Ask(r, _) => match r { Defeq(_, b) => b, _ => NatLit(0) },
    }
}

// The handle `Open`, `View`, `Whnf` and `Hole` are about; `Match`'s function
// type; the goal `Cases` and `Constructor` split.
fn host_handle(t: Tac<Expr>) → Nat {
    match t {
        Pure(_) => 0,
        Ask(r, _) => match r {
            Open(h, _) => h.id,
            View(h) => h.id,
            Whnf(h) => h.id,
            Match(ty, _) => ty.id,
            Hole(ty) => ty.id,
            Cases(_, goal) => goal.id,
            Constructor(goal) => goal.id,
            _ => 0,
        },
    }
}

// `Restore`'s mark.
fn host_mark(t: Tac<Expr>) → Nat {
    match t { Pure(_) => 0, Ask(r, _) => match r { Restore(m) => m, _ => 0 } }
}

// `Close`'s split.
fn host_split_id(t: Tac<Expr>) → Nat {
    match t { Pure(_) => 0, Ask(r, _) => match r { Close(s, _) => s, _ => 0 } }
}

// `Close`'s proofs, read one at a time.
fn host_proofs(t: Tac<Expr>) → List<Expr> {
    match t { Pure(_) => [], Ask(r, _) => match r { Close(_, proofs) => proofs, _ => [] } }
}

fn exprs_len(es: List<Expr>) → Nat { match es { Nil => 0, Cons(_, rest) => Succ(exprs_len(rest)) } }

fn exprs_at(es: List<Expr>, i: Nat) → Expr {
    match es {
        Nil => NatLit(0),
        Cons(e, rest) => match i { Zero => e, Succ(j) => exprs_at(rest, j) },
    }
}

fn host_proof_count(t: Tac<Expr>) → Nat { exprs_len(host_proofs(t)) }

fn host_proof(t: Tac<Expr>, i: Nat) → Expr { exprs_at(host_proofs(t), i) }

// `Match`'s target.
fn host_target(t: Tac<Expr>) → Nat {
    match t { Pure(_) => 0, Ask(r, _) => match r { Match(_, target) => target.id, _ => 0 } }
}

// `Open`'s, `Resolve`'s or `Lookup`'s name.
fn host_name(t: Tac<Expr>) → String {
    match t {
        Pure(_) => "",
        Ask(r, _) => match r { Open(_, name) => name, Resolve(name) => name, Lookup(name) => name, _ => "" },
    }
}

// A failure's message. Its notes are read one at a time, and the elaborator
// renders them, since an `At` note's term is spelled by its diagnostics.
fn host_failure(t: Tac<Expr>) → String {
    match t {
        Pure(_) => "",
        Ask(r, _) => match r { Fail(msg, _) => msg, _ => "" },
    }
}

fn host_notes(t: Tac<Expr>) → List<Note> {
    match t { Pure(_) => [], Ask(r, _) => match r { Fail(_, notes) => notes, _ => [] } }
}

fn notes_len(ns: List<Note>) → Nat { match ns { Nil => 0, Cons(_, rest) => Succ(notes_len(rest)) } }

fn notes_at(ns: List<Note>, i: Nat) → Note {
    match ns {
        Nil => Tried("", ""),
        Cons(n, rest) => match i { Zero => n, Succ(j) => notes_at(rest, j) },
    }
}

fn host_note_count(t: Tac<Expr>) → Nat { notes_len(host_notes(t)) }

fn host_note(t: Tac<Expr>, i: Nat) → Note { notes_at(host_notes(t), i) }

// 0: `Tried`. 1: `Under`. 2: `At`.
fn note_tag(n: Note) → Nat { match n { Tried(_, _) => 0, Under(_) => 1, At(_, _) => 2 } }

fn note_what(n: Note) → String { match n { Tried(what, _) => what, _ => "" } }

fn note_verdict(n: Note) → String { match n { Tried(_, verdict) => verdict, _ => "" } }

// The note an `Under` or an `At` is about.
fn note_inner(n: Note) → Note { match n { Under(m) => m, At(_, m) => m, _ => n } }

fn note_expr(n: Note) → Expr { match n { At(e, _) => e, _ => NatLit(0) } }

// The tree after its request is answered with `a`. An answer of the wrong
// kind leaves the tree as it is, which the host reports as its own error.
fn host_resume(t: Tac<Expr>, a: Answer) → Tac<Expr> {
    match t {
        Pure(e) => Pure(e),
        Ask(r, k) => match fit(r, a) { Mismatch => Ask(r, k), Fits(x) => k(x) },
    }
}

// 0: `Hd`. 1: `Local`. 2: `App`. 3: `NatLit`. 4: `Lam`. 5: `Global`.
fn expr_tag(e: Expr) → Nat {
    match e { Hd(_) => 0, Local(_) => 1, App(_, _) => 2, NatLit(_) => 3, Lam(_, _) => 4, Global(_) => 5 }
}

// The number a leaf carries: a handle, a local, a literal or a global;
// `Lam`'s local.
fn expr_nat(e: Expr) → Nat {
    match e { Hd(h) => h.id, Local(x) => x.id, App(_, _) => 0, NatLit(n) => n, Lam(x, _) => x.id, Global(g) => g.id }
}

fn expr_fn(e: Expr) → Expr { match e { App(f, _) => f, _ => e } }

// `App`'s argument; `Lam`'s body.
fn expr_arg(e: Expr) → Expr { match e { App(_, a) => a, Lam(_, b) => b, _ => e } }

fn chars_len(cs: List<Char>) → Nat { match cs { Nil => 0, Cons(_, rest) => Succ(chars_len(rest)) } }

fn chars_code(cs: List<Char>, i: Nat) → Nat {
    match cs {
        Nil => 0,
        Cons(c, rest) => match i { Zero => c.code, Succ(j) => chars_code(rest, j) },
    }
}

fn str_len(s: String) → Nat { chars_len(s.chars) }

fn str_code(s: String, i: Nat) → Nat { chars_code(s.chars, i) }

// Answers, built by the host from numerals: a goal is its target and then
// one local at a time, the most recent first.
fn host_goal(target: Nat) → Answer { AGoal(GoalInfo(Handle(target), [])) }

fn host_goal_local(a: Answer, ref: Nat, name: String, ty: Nat) → Answer {
    match a {
        AGoal(g) => AGoal(GoalInfo(g.target, g.locals ++ [LocalInfo(LocalRef(ref), name, Handle(ty))])),
        _ => a,
    }
}

// 0 is `False`, anything else `True`.
fn bool_of(n: Nat) → Bool { match n { Zero => False, Succ(_) => True } }

fn host_bool(n: Nat) → Answer { ABool(bool_of(n)) }

fn host_accepted(h: Nat) → Answer { AHandle(Accepted(Handle(h))) }

fn host_refused(why: String) → Answer { AHandle(Refused(why)) }

fn host_opened(ref: Nat, name: String, ty: Nat, body: Nat, dependent: Nat) → Answer {
    AOpened(Accepted(Opened(LocalInfo(LocalRef(ref), name, Handle(ty)), Handle(body), bool_of(dependent))))
}

fn host_not_opened(why: String) → Answer { AOpened(Refused(why)) }

fn host_head_pi(dom: Nat) → Answer { AHead(HPi(Handle(dom))) }

fn host_head_eq(lhs: Nat, rhs: Nat) → Answer { AHead(HEq(Handle(lhs), Handle(rhs))) }

fn host_head_global(g: Nat, name: String) → Answer { AHead(HGlobal(GlobalRef(g), name, [])) }

fn host_head_local(x: Nat) → Answer { AHead(HLocal(LocalRef(x), [])) }

fn host_head_field(r: Nat, name: String) → Answer { AHead(HField(Handle(r), name, [])) }

fn host_head_lit(n: Nat) → Answer { AHead(HLit(n)) }

fn host_head_match(scrut: Nat) → Answer { AHead(HMatch(Handle(scrut))) }

fn host_head_hole() → Answer { AHead(HHole) }

fn host_head_other() → Answer { AHead(HOther) }

// One more argument of a `HGlobal`, `HLocal` or `HField` head.
fn host_head_arg(a: Answer, h: Nat) → Answer {
    match a {
        AHead(v) => match v {
            HGlobal(g, name, args) => AHead(HGlobal(g, name, args ++ [Handle(h)])),
            HLocal(x, args) => AHead(HLocal(x, args ++ [Handle(h)])),
            HField(r, name, args) => AHead(HField(r, name, args ++ [Handle(h)])),
            _ => a,
        },
        _ => a,
    }
}

fn host_matched() → Answer { AMatch(Accepted([])) }

// One more slot of a match: determined (`Some`) or left open.
fn host_slot(a: Answer, h: Nat) → Answer {
    match a {
        AMatch(c) => match c { Accepted(slots) => AMatch(Accepted(slots ++ [Some(Handle(h))])), Refused(_) => a },
        _ => a,
    }
}

fn host_open_slot(a: Answer) → Answer {
    match a {
        AMatch(c) => match c { Accepted(slots) => AMatch(Accepted(slots ++ [None])), Refused(_) => a },
        _ => a,
    }
}

fn host_not_matched(why: String) → Answer { AMatch(Refused(why)) }

fn host_nat(n: Nat) → Answer { ANat(n) }

fn host_unit() → Answer { AUnit }

fn host_global(g: Nat) → Answer { AGlobal(Accepted(GlobalRef(g))) }

fn host_no_global(why: String) → Answer { AGlobal(Refused(why)) }

// A split is its number, then one branch at a time, each followed by its
// locals, oldest first.
fn host_split(id: Nat) → Answer { ASplit(Accepted(Split(id, []))) }

fn host_branch(a: Answer, goal: Nat) → Answer {
    match a {
        ASplit(c) => match c { Accepted(s) => ASplit(Accepted(Split(s.id, s.branches ++ [Branch([], Handle(goal))]))), Refused(_) => a },
        _ => a,
    }
}

// The branches with `l` added to the last one's locals, as its most recent.
fn branches_local(bs: List<Branch>, l: LocalInfo) → List<Branch> {
    match bs {
        Nil => [],
        Cons(b, rest) => match rest {
            Nil => [Branch(Cons(l, b.locals), b.goal)],
            Cons(_, _) => Cons(b, branches_local(rest, l)),
        },
    }
}

fn host_branch_local(a: Answer, ref: Nat, name: String, ty: Nat) → Answer {
    match a {
        ASplit(c) => match c {
            Accepted(s) => ASplit(Accepted(Split(s.id, branches_local(s.branches, LocalInfo(LocalRef(ref), name, Handle(ty)))))),
            Refused(_) => a,
        },
        _ => a,
    }
}

fn host_split_refused(why: String) → Answer { ASplit(Refused(why)) }

// A term of the goal's context, quoted where a tactic's argument expects an
// `Expr`.
fn host_quote(h: Nat) → Expr { Hd(Handle(h)) }

// A character from its code; the host only sends scalar values, and anything
// else becomes U+FFFD.
fn char_of_code(code: Nat) → Char {
    match is_scalar(code).is_true_dec() { Inl(p) => ofNat(code, p), Inr(_) => '\u{FFFD}' }
}

fn str_empty() → String { String([]) }

fn str_push(s: String, code: Nat) → String { String(s.chars ++ [char_of_code(code)]) }

// Declarations a generator writes from a type's shape (design §19).
//
// `generate congruences(T);` declares, for each constructor `C` of the
// inductive `T` with fields and no field whose type mentions an earlier one,
//
//     theorem T::cong_C({a1 … : A}, {a2 … : A}, a_eq: a1 = a2, …): C(a1, …) = C(a2, …)
//
// the x's before the y's, both implicit, then one equation per field. Its
// proof rewrites one field at a time with `cong`, joined by `trans`; the
// generator only builds it, and the host checks it as the same theorem
// written by hand would be. A field without a name is `x0`, `x1`, … by
// position. A constructor without fields has nothing to state and is
// skipped; a type with a dependent field is refused, naming the constructor.

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;
import tactic;

// `n` in decimal.
fn decimal_name(fuel: Nat, n: Nat) → String {
    match fuel {
        Zero => "",
        Succ(f) => match n.div(10) {
            Zero => "0123456789".drop(n).take(1),
            Succ(_) => decimal_name(f, n.div(10)) ++ "0123456789".drop(n.mod(10)).take(1),
        },
    }
}

// A field's name, or `x{i}` for the `i`th field when it has none.
fn field_name(f: FieldInfo, i: Nat) → String {
    match f.name.chars {
        Nil => "x" ++ decimal_name(i + 1, i),
        Cons(_, _) => f.name,
    }
}

// The fields' names and types, from the `i`th on; `None` if one is dependent.
record Fields { names: List<String>, tys: List<Handle> }

fn fields_from(fs: List<FieldInfo>, i: Nat) → Option<Fields> {
    match fs {
        Nil => Some(Fields([], [])),
        Cons(f, rest) => match f.ty {
            None => None,
            Some(ty) => match fields_from(rest, i + 1) {
                None => None,
                Some(r) => Some(Fields(Cons(field_name(f, i), r.names), Cons(ty, r.tys))),
            },
        },
    }
}

// One parameter to introduce: its type and its name.
record Hyp { ty: Expr, name: String }

fn hyps_of(names: List<String>, tys: List<Handle>, suffix: String) → List<Hyp> {
    match names {
        Nil => [],
        Cons(n, ns) => match tys {
            Nil => [],
            Cons(t, ts) => Cons(Hyp(Hd(t), n ++ suffix), hyps_of(ns, ts, suffix)),
        },
    }
}

fn eq_hyps(names: List<String>, xs: List<LocalRef>, ys: List<LocalRef>) → List<Hyp> {
    match names {
        Nil => [],
        Cons(n, ns) => match xs {
            Nil => [],
            Cons(x, xr) => match ys {
                Nil => [],
                Cons(y, yr) => Cons(Hyp(Equation(Local(x), Local(y)), n ++ "_eq"), eq_hyps(ns, xr, yr)),
            },
        },
    }
}

fn assumed(c: Checked<LocalInfo>) → Tac<LocalRef> {
    match c {
        Refused(why) => fail("congruences: " ++ why, []),
        Accepted(l) => pure(l.ref),
    }
}

// Introduce `hs` in order, each under the one before, the first under
// `under`.
fn assume_chain(hs: List<Hyp>, under: Option<LocalRef>) → Tac<List<LocalRef>> {
    match hs {
        Nil => pure([]),
        Cons(h, rest) => assume(h.ty, h.name, under).bind(λ c => assumed(c)).bind(λ x =>
            assume_chain(rest, Some(x)).bind(λ xs => pure(Cons(x, xs)))),
    }
}

// Introduce `hs` each directly under `under`: binders for the proof's
// lambdas, not parameters.
fn assume_beside(hs: List<Hyp>, under: Option<LocalRef>) → Tac<List<LocalRef>> {
    match hs {
        Nil => pure([]),
        Cons(h, rest) => assume(h.ty, h.name, under).bind(λ c => assumed(c)).bind(λ x =>
            assume_beside(rest, under).bind(λ xs => pure(Cons(x, xs)))),
    }
}

fn last_ref(under: Option<LocalRef>, xs: List<LocalRef>) → Option<LocalRef> {
    match xs {
        Nil => under,
        Cons(x, rest) => last_ref(Some(x), rest),
    }
}

fn locals_of(xs: List<LocalRef>) → List<Expr> {
    match xs {
        Nil => [],
        Cons(x, rest) => Cons(Local(x), locals_of(rest)),
    }
}

fn apps(f: Expr, args: List<Expr>) → Expr {
    match args {
        Nil => f,
        Cons(a, rest) => apps(App(f, a), rest),
    }
}

// The step that rewrites field `i`: `cong(λ z => C(y<i, z, x>i), p_i)`, from
// `C(y<i, x_i, x>i)` to `C(y<i, y_i, x>i)`.
fn step(cong: GlobalRef, c: Expr, xs: List<Expr>, ys: List<Expr>, i: Nat, z: LocalRef, p: LocalRef) → Expr {
    let f = Lam(z, apps(c, ys.take(i) ++ Cons(Local(z), xs.drop(i + 1))));
    apps(Global(cong), [Blank, Blank, f, Blank, Blank, Local(p)])
}

fn steps(cong: GlobalRef, c: Expr, xs: List<Expr>, ys: List<Expr>, i: Nat, zs: List<LocalRef>, ps: List<LocalRef>) → List<Expr> {
    match zs {
        Nil => [],
        Cons(z, zr) => match ps {
            Nil => [],
            Cons(p, pr) => Cons(step(cong, c, xs, ys, i, z, p), steps(cong, c, xs, ys, i + 1, zr, pr)),
        },
    }
}

// The steps joined by `trans`, left to right.
fn chain(trans: GlobalRef, ss: List<Expr>) → Expr {
    match ss {
        Nil => NatLit(0),
        Cons(s, rest) => match rest {
            Nil => s,
            Cons(_, _) => apps(Global(trans), [Blank, Blank, Blank, Blank, s, chain(trans, rest)]),
        },
    }
}

fn implicit_params(xs: List<LocalRef>) → List<Param> {
    match xs {
        Nil => [],
        Cons(x, rest) => Cons(Param(x, True), implicit_params(rest)),
    }
}

fn explicit_params(xs: List<LocalRef>) → List<Param> {
    match xs {
        Nil => [],
        Cons(x, rest) => Cons(Param(x, False), explicit_params(rest)),
    }
}

// What every constructor's lemma shares: the type's name and the two
// prelude laws.
record Laws { ty: String, cong: GlobalRef, trans: GlobalRef }

// The lemma for one constructor whose fields are `fs` and whose function is
// `c`.
fn congruence(laws: Laws, name: String, fs: Fields, c: Expr) → Tac<Decl> {
    assume_chain(hyps_of(fs.names, fs.tys, "1"), None).bind(λ xs =>
    assume_chain(hyps_of(fs.names, fs.tys, "2"), last_ref(None, xs)).bind(λ ys =>
    assume_chain(eq_hyps(fs.names, xs, ys), last_ref(None, ys)).bind(λ ps =>
    assume_beside(hyps_of(fs.names, fs.tys, "_z"), last_ref(None, ps)).bind(λ zs => {
        let xe = locals_of(xs);
        let ye = locals_of(ys);
        let stmt = Equation(apps(c, xe), apps(c, ye));
        let body = chain(laws.trans, steps(laws.cong, c, xe, ye, 0, zs, ps));
        let params = implicit_params(xs) ++ implicit_params(ys) ++ explicit_params(ps);
        pure(Decl(AsTheorem, laws.ty ++ "::cong_" ++ name, params, stmt, body))
    }))))
}

fn congruence_of(laws: Laws, info: CtorInfo) → Tac<List<Decl>> {
    match info.fields {
        Nil => pure([]),
        Cons(_, _) => match fields_from(info.fields, 0) {
            None => fail("congruences: a field of `" ++ info.name ++ "` mentions an earlier field", []),
            Some(fs) => match info.ctor {
                None => fail("congruences: `" ++ info.name ++ "` is not a function of its fields", []),
                Some(c) => congruence(laws, info.name, fs, Hd(c)).bind(λ d => pure([d])),
            },
        },
    }
}

fn congruences_of(laws: Laws, cs: List<CtorInfo>) → Tac<List<Decl>> {
    match cs {
        Nil => pure([]),
        Cons(c, rest) => congruence_of(laws, c).bind(λ ds => congruences_of(laws, rest).bind(λ es => pure(ds ++ es))),
    }
}

fn global_named(name: String) → Tac<GlobalRef> {
    lookup(name).bind(λ c => match c {
        Refused(why) => fail("congruences: `" ++ name ++ "`: " ++ why, []),
        Accepted(g) => pure(g),
    })
}

fn type_named(h: Handle) → Tac<String> {
    view(h).bind(λ v => match v {
        HGlobal(_, name, _) => pure(name),
        _ => fail("congruences: the type is not a named inductive", []),
    })
}

fn checked_handle(what: String, c: Checked<Handle>) → Tac<Handle> {
    match c {
        Refused(why) => fail("congruences: " ++ what ++ ": " ++ why, []),
        Accepted(h) => pure(h),
    }
}

fn checked_ctors(c: Checked<List<CtorInfo>>) → Tac<List<CtorInfo>> {
    match c {
        Refused(why) => fail("congruences: " ++ why, []),
        Accepted(cs) => pure(cs),
    }
}

// `generate congruences(T);`: `T::cong_C` for each constructor `C` of `T`.
fn congruences(t: Expr) → Tac<List<Decl>> {
    as_type(t).bind(λ c => checked_handle("not a type", c)).bind(λ h =>
    type_named(h).bind(λ name =>
    global_named("cong").bind(λ cong =>
    global_named("trans").bind(λ trans =>
    ctors(h).bind(λ c => checked_ctors(c)).bind(λ cs =>
    congruences_of(Laws(name, cong, trans), cs))))))
}

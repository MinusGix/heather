// `bv_decide`: a claim about fixed-width words and Booleans, decided by a SAT
// solver and proved by the kernel (docs/tactics/bv-decide-design.md).
//
//     theorem add_comm8(x, y: u8): x + y = y + x { by bv_decide() }
//
// The tactic reads the goal into a `BVPred` (`lib/std/tactic/bitblast.hthr`)
// over its atoms: each local word and each local Boolean the claim mentions,
// laid into one bit stream, words first. A definition the reader does not
// know is unfolded once and read again. The predicate is normalized
// (`lib/std/tactic/bv_normalize.hthr`: chains sorted and merged, so
// `x + y = y + x` is a constant), and its clauses go to the solver (`sat`,
// the `Sat` request); its refutation comes back as a proof the kernel
// replays, and `BVPred::norm_unsat_sound` turns it into the predicate at
// the laid-out atoms. Each word atom is then read back from its window of the
// stream (`window_lay_here`, `window_lay_past`) and put in place of the window
// by congruence, one atom at a time, over the claim's sides abstracted over
// the atoms (`abstract_over`). A Boolean atom reads back by evaluation.
//
// A satisfiable predicate is a counterexample: the tactic fails naming the
// atoms' values that make the claim false.
//
// Read: `+ - *`, negation, `& | ^`, complement, shifts by a numeral,
// `zero_extend`, `truncate`, `take_low`, `drop_low`, `sign_extend`, `concat`,
// numerals, and at the Boolean level `&& || !`, `xor`, `bool_eq`, `eq_bit`,
// `unsigned_lt_bit`, `signed_lt_bit`, `bit_at` at a numeral, `head_bit`.
//
// A claim (`BVClaim`) is `a = b` between words, `p = q` between Booleans,
// `p = True`, or `a < b`, `a <= b`, `a ≠ b` between words. The goal is one,
// and so is each hypothesis the tactic can read; the rest are passed over.
// The predicate refuted is `¬h₁ ∨ … ∨ ¬hₖ ∨ goal`, and the read-back peels
// one hypothesis at a time (`layout_imp`), each discharged by its own proof
// carried to the layout (`layout_*_hyp`).
import tactic;
import list;
import bool;
import nat;
import bitvec;
import lrat;
import bitblast;
import bv_normalize;

// ---------------------------------------------------------------------------
// Spellings of the predicate's constructors the tactic can name: a
// constructor is not a global a tactic resolves, so each is a function here.

fn bvq_var(o, w: Nat) → BVExpr { BVar(o, w) }
fn bvq_const(x: Nat) → BVExpr { BConst(x) }
fn bvq_not(a: BVExpr) → BVExpr { BNot(a) }
fn bvq_and(a, b: BVExpr) → BVExpr { BAnd(a, b) }
fn bvq_or(a, b: BVExpr) → BVExpr { BOr(a, b) }
fn bvq_xor(a, b: BVExpr) → BVExpr { BXor(a, b) }
fn bvq_add(a, b: BVExpr) → BVExpr { BAdd(a, b) }
fn bvq_shl(a: BVExpr, k: Nat) → BVExpr { BShl(a, k) }
fn bvq_shr(a: BVExpr, k: Nat) → BVExpr { BShr(a, k) }
fn bvq_sub(a, b: BVExpr) → BVExpr { BSub(a, b) }
fn bvq_neg(a: BVExpr) → BVExpr { BNeg(a) }
fn bvq_mul(a, b: BVExpr) → BVExpr { BMul(a, b) }
fn bvq_from(a: BVExpr, m, skip: Nat) → BVExpr { BFrom(a, m, skip) }
fn bvq_sext(a: BVExpr, m: Nat) → BVExpr { BSext(a, m) }
fn bvq_concat(lo: BVExpr, m1: Nat, hi: BVExpr, m2: Nat) → BVExpr { BConcat(lo, m1, hi, m2) }

fn bvq_pconst(b: Bool) → BVPred { PConst(b) }
fn bvq_eq(n: Nat, a, b: BVExpr) → BVPred { PEq(n, a, b) }
fn bvq_ult(n: Nat, a, b: BVExpr) → BVPred { PUlt(n, a, b) }
fn bvq_pnot(p: BVPred) → BVPred { PNot(p) }
fn bvq_pand(p, q: BVPred) → BVPred { PAnd(p, q) }
fn bvq_por(p, q: BVPred) → BVPred { POr(p, q) }
fn bvq_iff(p, q: BVPred) → BVPred { PIff(p, q) }
fn bvq_slt(n: Nat, a, b: BVExpr) → BVPred { PSlt(n, a, b) }
fn bvq_bit(n: Nat, a: BVExpr, k: Nat) → BVPred { PBit(n, a, k) }
fn bvq_pvar(o: Nat) → BVPred { PVar(o) }
fn bvq_pxor(p, q: BVPred) → BVPred { PXor(p, q) }
fn bvq_natle(m: Nat, a: BVExpr, n: Nat, b: BVExpr) → BVPred { PNatLe(m, a, n, b) }
fn bvq_natlt(m: Nat, a: BVExpr, n: Nat, b: BVExpr) → BVPred { PNatLt(m, a, n, b) }
fn bvq_nateq(m: Nat, a: BVExpr, n: Nat, b: BVExpr) → BVPred { PNatEq(m, a, n, b) }

// ---------------------------------------------------------------------------
// What the reader recognizes, by reference.

record BVOps {
    word: Nat, add: Nat, sub: Nat, mul: Nat, neg: Nat, band: Nat, bor: Nat, bxor: Nat, compl: Nat,
    shl: Nat, shr: Nat, of_nat: Nat, zext: Nat, trunc: Nat, sext: Nat, concat: Nat,
    eq_bit: Nat, ult: Nat, slt: Nat, bit_at: Nat, and: Nat, or: Nat, not: Nat, iff: Nat, bool: Nat,
    take: Nat, drop: Nat, head: Nat, xor: Nat, lt: Nat, le: Nat, not_p: Nat,
    nat: Nat, to_nat: Nat, leb: Nat, same: Nat, succ: Nat, nat_le: Nat, nat_lt: Nat, false_ty: Nat, nat_add: Nat,
    and_p: Nat, or_p: Nat, iff_p: Nat,
}

fn bv_ref(name: String) → Tac<Nat> {
    let r <- lookup(name).or_fail("bv_decide: ");
    pure(r.id)
}

fn bv_ops() → Tac<BVOps> {
    let word <- bv_ref("bitvec::BitVec");
    let add <- bv_ref("bitvec::BitVec::add");
    let sub <- bv_ref("bitvec::BitVec::sub");
    let mul <- bv_ref("bitvec::BitVec::mul");
    let neg <- bv_ref("bitvec::BitVec::neg");
    let band <- bv_ref("bitvec::BitVec::band");
    let bor <- bv_ref("bitvec::BitVec::bor");
    let bxor <- bv_ref("bitvec::BitVec::bxor");
    let compl <- bv_ref("bitvec::BitVec::complement");
    let shl <- bv_ref("bitvec::BitVec::shift_left");
    let shr <- bv_ref("bitvec::BitVec::shift_right");
    let of_nat <- bv_ref("bitvec::BitVec::ofNat");
    let zext <- bv_ref("bitvec::BitVec::zero_extend");
    let trunc <- bv_ref("bitvec::BitVec::truncate");
    let sext <- bv_ref("bitvec::BitVec::sign_extend");
    let concat <- bv_ref("bitvec::BitVec::concat");
    let eq_bit <- bv_ref("bitvec::BitVec::eq_bit");
    let ult <- bv_ref("bitvec::BitVec::unsigned_lt_bit");
    let slt <- bv_ref("bitvec::BitVec::signed_lt_bit");
    let bit_at <- bv_ref("bitvec::BitVec::bit_at");
    let and <- bv_ref("bool::Bool::and");
    let or <- bv_ref("bool::Bool::or");
    let not <- bv_ref("bool::Bool::not");
    let iff <- bv_ref("bitvec::BitVec::bool_eq");
    let bool <- bv_ref("bool::Bool");
    let take <- bv_ref("bitvec::BitVec::take_low");
    let drop <- bv_ref("bitvec::BitVec::drop_low");
    let head <- bv_ref("bitvec::BitVec::head_bit");
    let xor <- bv_ref("bool::Bool::xor");
    let lt <- bv_ref("bitvec::BitVec::unsigned_lt");
    let le <- bv_ref("bitvec::BitVec::unsigned_le");
    let not_p <- bv_ref("logic::Not");
    let nat <- bv_ref("Nat");
    let to_nat <- bv_ref("bitvec::BitVec::toNat");
    let leb <- bv_ref("nat::Nat::leb");
    let same <- bv_ref("nat::Nat::same");
    let succ <- bv_ref("Succ");
    let nat_le <- bv_ref("nat::Nat::Le");
    let nat_lt <- bv_ref("nat::Nat::Lt");
    let false_ty <- bv_ref("False");
    let nat_add <- bv_ref("nat::Nat::add");
    let and_p <- bv_ref("logic::And");
    let or_p <- bv_ref("logic::Or");
    let iff_p <- bv_ref("logic::Iff");
    pure(BVOps(word, add, sub, mul, neg, band, bor, bxor, compl, shl, shr, of_nat, zext, trunc, sext, concat, eq_bit, ult, slt, bit_at, and, or, not, iff, bool,
        take, drop, head, xor, lt, le, not_p, nat, to_nat, leb, same, succ, nat_le, nat_lt, false_ty, nat_add, and_p, or_p, iff_p))
}

// ---------------------------------------------------------------------------
// The atoms, in order of first appearance: words with their widths, then
// Booleans. The reader numbers them; the layout gives them offsets.

record BVWord { x: LocalRef, w: Nat }
record BVAtoms { words: List<BVWord>, bools: List<LocalRef> }

fn bv_word_index(ws: List<BVWord>, x: LocalRef, i: Nat) → Option<Nat> {
    match ws {
        Nil => None,
        Cons(a, rest) => match a.x.id.same(x.id) { True => Some(i), False => bv_word_index(rest, x, i + 1) },
    }
}

fn bv_bool_index(bs: List<LocalRef>, x: LocalRef, i: Nat) → Option<Nat> {
    match bs {
        Nil => None,
        Cons(b, rest) => match b.id.same(x.id) { True => Some(i), False => bv_bool_index(rest, x, i + 1) },
    }
}

// What a reading is after (a word at a width, or a Boolean) and what it found.
inductive BVWant { WWord(n: Nat), WBool }
inductive BVOut { OWord(e: BVExpr), OBool(p: BVPred) }
record BVRead { out: BVOut, st: BVAtoms }

fn BVRead::word(self r: BVRead) → BVExpr { match r.out { OWord(e) => e, OBool(_) => BConst(0) } }
fn BVRead::bool(self r: BVRead) → BVPred { match r.out { OBool(p) => p, OWord(_) => PConst(False) } }

// The width of a word, read off its type.
fn bv_width(ops: BVOps, h: Handle) → Tac<Option<Nat>> {
    let c <- infer(Hd(h));
    match c {
        Refused(_) => pure(None),
        Accepted(ty) => {
            let t <- whnf_or(ty);
            let v <- view(t);
            match v {
                HGlobal(g, _, args) => match g.id.same(ops.word) {
                    False => pure(None),
                    True => match args.nth(0) {
                        Some(n) => {
                            let k <- numeral(Hd(n));
                            match k { Accepted(k) => pure(Some(k)), Refused(_) => pure(None) }
                        },
                        None => pure(None),
                    },
                },
                _ => pure(None),
            }
        },
    }
}

fn bv_numeral(h: Handle, what: String) → Tac<Nat> {
    numeral(Hd(h)).or_fail("bv_decide: " ++ what ++ " is not a numeral: ")
}

fn bv_unread<A>(h: Handle, why: String) → Tac<A> {
    fail("bv_decide: " ++ why, [At(Hd(h), Tried("reading it", "not a word or Boolean operation bv_decide knows"))])
}

fn bv_arg(args: List<Handle>, i: Nat) → Handle { match args.nth(i) { Some(h) => h, None => Handle(0) } }

// Reading one layer; `rec` reads a part.
fn bv_two(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, want: BVWant, st: BVAtoms, k: BVOut → BVOut → BVOut) → Tac<BVRead> {
    let ra <- rec(a, want, st);
    let rb <- rec(b, want, ra.st);
    pure(BVRead(k(ra.out, rb.out), rb.st))
}

fn bv_word_op(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, n: Nat, st: BVAtoms, k: BVExpr → BVExpr → BVExpr) → Tac<BVRead> {
    bv_two(rec, a, b, WWord(n), st, λ x y => OWord(k(BVRead(x, st).word(), BVRead(y, st).word())))
}

fn bv_test_op(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, st: BVAtoms, k: BVPred → BVPred → BVPred) → Tac<BVRead> {
    bv_two(rec, a, b, WBool, st, λ x y => OBool(k(BVRead(x, st).bool(), BVRead(y, st).bool())))
}

// `a` at its own width `m`, then `k(a, m)`.
fn bv_at_width(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a: Handle, st: BVAtoms, k: Nat → BVRead → BVRead) → Tac<BVRead> {
    let m <- bv_width(ops, a);
    match m {
        None => bv_unread(a, "a word whose width is not a numeral"),
        Some(m) => {
            let ra <- rec(a, WWord(m), st);
            pure(k(m, ra))
        },
    }
}

// An arm's body, under the binder an encoded constructor's payload is.
fn bv_arm_body(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, body: Handle, want: BVWant, st: BVAtoms) → Tac<BVRead> {
    let v <- view(body);
    match v {
        HLam(_) => {
            let o <- open(body, "_");
            match o {
                Accepted(op) => match op.dependent {
                    False => rec(op.body, want, st),
                    True => bv_unread(body, "an arm that reads its constructor's fields"),
                },
                Refused(_) => bv_unread(body, "an arm that reads its constructor's fields"),
            }
        },
        _ => rec(body, want, st),
    }
}

// A `match` a split has decided (`match False { … }`, an `if` the goal was
// split on), read as the arm it selects.
fn bv_decided(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, want: BVWant, st: BVAtoms) → Tac<BVRead> {
    let a <- arms(h);
    match a {
        Accepted(mi) => match mi.args.len().same(0) && mi.path.len().same(0) {
            True => {
                let vs <- view(mi.scrut);
                match vs {
                    // The arms in the constructors' order.
                    HCtor(_, i, _, Nil) => match mi.arms.nth(i) {
                        Some(arm) => bv_arm_body(rec, arm.body, want, st),
                        None => bv_unread(h, "a term it cannot read"),
                    },
                    _ => bv_unread(h, "a term it cannot read"),
                }
            },
            False => bv_unread(h, "a term it cannot read"),
        },
        Refused(_) => bv_unread(h, "a term it cannot read"),
    }
}

fn bv_unfolded(rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, want: BVWant, st: BVAtoms) → Tac<BVRead> {
    let u <- unfold(h);
    match u {
        Accepted(h2) => rec(h2, want, st),
        Refused(_) => {
            let v <- view(h);
            match v {
                HMatch(_) => bv_decided(rec, h, want, st),
                _ => bv_unread(h, "a term it cannot read"),
            }
        },
    }
}

fn bv_read_word_call(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, g: Nat, args: List<Handle>, n: Nat, st: BVAtoms) → Tac<BVRead> {
    let a = bv_arg(args, 0);
    let b = bv_arg(args, 1);
    let arity = args.len();
    if arity.same(2) && g.same(ops.add) { bv_word_op(rec, a, b, n, st, λ x y => BAdd(x, y)) }
    else if arity.same(2) && g.same(ops.sub) { bv_word_op(rec, a, b, n, st, λ x y => BSub(x, y)) }
    else if arity.same(2) && g.same(ops.mul) { bv_word_op(rec, a, b, n, st, λ x y => BMul(x, y)) }
    else if arity.same(2) && g.same(ops.band) { bv_word_op(rec, a, b, n, st, λ x y => BAnd(x, y)) }
    else if arity.same(2) && g.same(ops.bor) { bv_word_op(rec, a, b, n, st, λ x y => BOr(x, y)) }
    else if arity.same(2) && g.same(ops.bxor) { bv_word_op(rec, a, b, n, st, λ x y => BXor(x, y)) }
    else if arity.same(2) && g.same(ops.shl) {
        let k <- bv_numeral(b, "a shift count");
        let ra <- rec(a, WWord(n), st);
        pure(BVRead(OWord(BShl(ra.word(), k)), ra.st))
    }
    else if arity.same(2) && g.same(ops.shr) {
        let k <- bv_numeral(b, "a shift count");
        let ra <- rec(a, WWord(n), st);
        pure(BVRead(OWord(BShr(ra.word(), k)), ra.st))
    }
    else if arity.same(2) && g.same(ops.zext) { bv_at_width(ops, rec, b, st, λ m r => BVRead(OWord(BFrom(r.word(), m, 0)), r.st)) }
    else if arity.same(2) && g.same(ops.sext) { bv_at_width(ops, rec, b, st, λ m r => BVRead(OWord(BSext(r.word(), m)), r.st)) }
    else if arity.same(2) && g.same(ops.concat) {
        let lo <- bv_at_width(ops, rec, a, st, λ m r => BVRead(OWord(BFrom(r.word(), m, 0)), r.st));
        let m1 <- bv_width(ops, a);
        let m2 <- bv_width(ops, b);
        match lo.word() {
            BFrom(x, _, _) => match m1 {
                Some(m1) => match m2 {
                    Some(m2) => {
                        let hi <- rec(b, WWord(m2), lo.st);
                        pure(BVRead(OWord(BConcat(x, m1, hi.word(), m2)), hi.st))
                    },
                    None => bv_unread(b, "a word whose width is not a numeral"),
                },
                None => bv_unread(a, "a word whose width is not a numeral"),
            },
            _ => bv_unread(h, "a concatenation"),
        }
    }
    else if arity.same(1) && g.same(ops.neg) { let ra <- rec(a, WWord(n), st); pure(BVRead(OWord(BNeg(ra.word())), ra.st)) }
    else if arity.same(1) && g.same(ops.compl) { let ra <- rec(a, WWord(n), st); pure(BVRead(OWord(BNot(ra.word())), ra.st)) }
    else if g.same(ops.of_nat) && (arity.same(1) || arity.same(2)) { let v <- bv_numeral(bv_arg(args, arity - 1), "a word's value"); pure(BVRead(OWord(BConst(v)), st)) }
    else if arity.same(3) && g.same(ops.trunc) { bv_at_width(ops, rec, bv_arg(args, 2), st, λ m r => BVRead(OWord(BFrom(r.word(), m, 0)), r.st)) }
    else if arity.same(3) && g.same(ops.take) { bv_at_width(ops, rec, bv_arg(args, 2), st, λ m r => BVRead(OWord(BFrom(r.word(), m, 0)), r.st)) }
    else if arity.same(3) && g.same(ops.drop) {
        let skip <- bv_numeral(a, "a count of dropped bits");
        bv_at_width(ops, rec, bv_arg(args, 2), st, λ m r => BVRead(OWord(BFrom(r.word(), m, skip)), r.st))
    }
    else { bv_unfolded(rec, h, WWord(n), st) }
}

// A comparison of two words at their width.
fn bv_compare(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, st: BVAtoms, k: Nat → BVExpr → BVExpr → BVPred) → Tac<BVRead> {
    let n <- bv_width(ops, a);
    match n {
        None => bv_unread(a, "a word whose width is not a numeral"),
        Some(n) => {
            let ra <- rec(a, WWord(n), st);
            let rb <- rec(b, WWord(n), ra.st);
            pure(BVRead(OBool(k(n, ra.word(), rb.word())), rb.st))
        },
    }
}

// A natural the reader compares: a numeral, at the least width that holds
// it, or a word's value `x.toNat()`, at the word's width. Anything else is
// unfolded and read again.
record BVNat { w: Nat, e: BVExpr, st: BVAtoms }

fn bv_bits_of(k, fuel: Nat) → Nat {
    match fuel { Zero => 0, Succ(f) => match k { Zero => 0, Succ(_) => Succ(bv_bits_of(k.half(), f)) } }
}

fn bv_numeral_width(k: Nat) → Nat { match bv_bits_of(k, 1024) { Zero => 1, Succ(w) => Succ(w) } }

fn bv_nat_again(h: Handle, k: Handle → Tac<BVNat>) → Tac<BVNat> {
    let u <- unfold(h);
    match u {
        Accepted(h2) => k(h2),
        Refused(_) => bv_unread(h, "a natural that is not a numeral or a word's value"),
    }
}

fn bv_nat_side(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, st: BVAtoms, fuel: Nat) → Tac<BVNat> {
    match fuel {
        Zero => bv_unread(h, "a natural that is not a numeral or a word's value"),
        Succ(f) => {
            let v <- view(h);
            match v {
                HLit(k) => pure(BVNat(bv_numeral_width(k), BConst(k), st)),
                HGlobal(g, _, args) => match g.id.same(ops.to_nat) && args.len().same(1) {
                    True => {
                        let x = bv_arg(args, 0);
                        let m <- bv_width(ops, x);
                        match m {
                            None => bv_unread(x, "a word whose width is not a numeral"),
                            Some(m) => {
                                let r <- rec(x, WWord(m), st);
                                pure(BVNat(m, r.word(), r.st))
                            },
                        }
                    },
                    False => bv_nat_again(h, λ h2 => bv_nat_side(ops, rec, h2, st, f)),
                },
                _ => bv_nat_again(h, λ h2 => bv_nat_side(ops, rec, h2, st, f)),
            }
        },
    }
}

// Two naturals compared by value.
fn bv_nat_compare(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, st: BVAtoms, k: Nat → BVExpr → Nat → BVExpr → BVPred) → Tac<BVRead> {
    let ra <- bv_nat_side(ops, rec, a, st, 64);
    let rb <- bv_nat_side(ops, rec, b, ra.st, 64);
    pure(BVRead(OBool(k(ra.w, ra.e, rb.w, rb.e)), rb.st))
}

// `x` when a natural is `Succ(x)` or `x + 1`, which is `Succ(x)` by
// computation.
fn bv_pred_of(ops: BVOps, a: Handle) → Tac<Option<Handle>> {
    let va <- view(a);
    match va {
        HGlobal(s, _, sargs) =>
            if s.id.same(ops.succ) && sargs.len().same(1) { pure(Some(bv_arg(sargs, 0))) }
            else if s.id.same(ops.nat_add) && sargs.len().same(2) {
                let one <- view(bv_arg(sargs, 1));
                match one { HLit(k) => pure(if k.same(1) { Some(bv_arg(sargs, 0)) } else { None }), _ => pure(None) }
            }
            else { pure(None) },
        _ => pure(None),
    }
}

// `a.leb(b)`, or `Succ(a).leb(b)` (or `(a + 1).leb(b)`): `a <= b`, or `a < b`.
fn bv_nat_leb(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, a, b: Handle, st: BVAtoms) → Tac<BVRead> {
    let p <- bv_pred_of(ops, a);
    match p {
        Some(x) => bv_nat_compare(ops, rec, x, b, st, λ m x n y => PNatLt(m, x, n, y)),
        None => bv_nat_compare(ops, rec, a, b, st, λ m x n y => PNatLe(m, x, n, y)),
    }
}

fn bv_read_test_call(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, g: Nat, args: List<Handle>, st: BVAtoms) → Tac<BVRead> {
    let a = bv_arg(args, 0);
    let b = bv_arg(args, 1);
    let arity = args.len();
    if arity.same(2) && g.same(ops.and) { bv_test_op(rec, a, b, st, λ p q => PAnd(p, q)) }
    else if arity.same(2) && g.same(ops.or) { bv_test_op(rec, a, b, st, λ p q => POr(p, q)) }
    else if arity.same(2) && g.same(ops.iff) { bv_test_op(rec, a, b, st, λ p q => PIff(p, q)) }
    else if arity.same(2) && g.same(ops.eq_bit) { bv_compare(ops, rec, a, b, st, λ n x y => PEq(n, x, y)) }
    else if arity.same(2) && g.same(ops.ult) { bv_compare(ops, rec, a, b, st, λ n x y => PUlt(n, x, y)) }
    else if arity.same(2) && g.same(ops.slt) { bv_compare(ops, rec, a, b, st, λ n x y => PSlt(n, x, y)) }
    else if arity.same(2) && g.same(ops.bit_at) {
        let k <- bv_numeral(b, "a bit index");
        bv_at_width(ops, rec, a, st, λ n r => BVRead(OBool(PBit(n, r.word(), k)), r.st))
    }
    else if arity.same(2) && g.same(ops.xor) { bv_test_op(rec, a, b, st, λ p q => PXor(p, q)) }
    else if arity.same(1) && g.same(ops.head) { bv_at_width(ops, rec, a, st, λ n r => BVRead(OBool(PBit(n, r.word(), 0)), r.st)) }
    else if arity.same(1) && g.same(ops.not) { let ra <- rec(a, WBool, st); pure(BVRead(OBool(PNot(ra.bool())), ra.st)) }
    else if arity.same(2) && g.same(ops.leb) { bv_nat_leb(ops, rec, a, b, st) }
    else if arity.same(2) && g.same(ops.same) { bv_nat_compare(ops, rec, a, b, st, λ m x n y => PNatEq(m, x, n, y)) }
    else { bv_unfolded(rec, h, WBool, st) }
}

fn bv_read_step(ops: BVOps, rec: Handle → BVWant → BVAtoms → Tac<BVRead>, h: Handle, want: BVWant, st: BVAtoms) → Tac<BVRead> {
    let v <- view(h);
    match v {
        HLocal(x, Nil) => match want {
            WWord(n) => match bv_word_index(st.words, x, 0) {
                Some(i) => pure(BVRead(OWord(BVar(i, n)), st)),
                None => pure(BVRead(OWord(BVar(st.words.len(), n)), BVAtoms(st.words ++ [BVWord(x, n)], st.bools))),
            },
            WBool => match bv_bool_index(st.bools, x, 0) {
                Some(i) => pure(BVRead(OBool(PVar(i)), st)),
                None => pure(BVRead(OBool(PVar(st.bools.len())), BVAtoms(st.words, st.bools ++ [x]))),
            },
        },
        HCtor(ty, i, _, Nil) => match want {
            WBool => match ty.id.same(ops.bool) {
                True => pure(BVRead(OBool(PConst(match i { Zero => False, Succ(_) => True })), st)),
                False => bv_unfolded(rec, h, want, st),
            },
            WWord(_) => bv_unfolded(rec, h, want, st),
        },
        HGlobal(g, _, args) => match want {
            WWord(n) => bv_read_word_call(ops, rec, h, g.id, args, n, st),
            WBool => bv_read_test_call(ops, rec, h, g.id, args, st),
        },
        _ => bv_unfolded(rec, h, want, st),
    }
}

// `fuel` bounds the reading's depth, unfoldings included.
fn bv_read(ops: BVOps, h: Handle, want: BVWant, st: BVAtoms, fuel: Nat) → Tac<BVRead> {
    match fuel {
        Zero => bv_unread(h, "the claim is too deep"),
        Succ(d) => bv_read_step(ops, λ h2 w2 st2 => bv_read(ops, h2, w2, st2, d), h, want, st),
    }
}

// ---------------------------------------------------------------------------
// Offsets: word `i` at the sum of the widths before it, Boolean `j` past
// every word.

fn bv_offsets(ws: List<BVWord>, at: Nat) → List<Nat> {
    match ws { Nil => [], Cons(w, rest) => Cons(at, bv_offsets(rest, at + w.w)) }
}

fn bv_word_bits(ws: List<BVWord>) → Nat {
    match ws { Nil => 0, Cons(w, rest) => w.w + bv_word_bits(rest) }
}

fn bv_place(offs: List<Nat>, i: Nat) → Nat { match offs.nth(i) { Some(o) => o, None => 0 } }

fn BVExpr::placed(self e: BVExpr, offs: List<Nat>) → BVExpr {
    match e {
        BVar(i, w) => BVar(bv_place(offs, i), w),
        BConst(x) => BConst(x),
        BNot(a) => BNot(a.placed(offs)),
        BAnd(a, b) => BAnd(a.placed(offs), b.placed(offs)),
        BOr(a, b) => BOr(a.placed(offs), b.placed(offs)),
        BXor(a, b) => BXor(a.placed(offs), b.placed(offs)),
        BAdd(a, b) => BAdd(a.placed(offs), b.placed(offs)),
        BShl(a, k) => BShl(a.placed(offs), k),
        BShr(a, k) => BShr(a.placed(offs), k),
        BSub(a, b) => BSub(a.placed(offs), b.placed(offs)),
        BNeg(a) => BNeg(a.placed(offs)),
        BMul(a, b) => BMul(a.placed(offs), b.placed(offs)),
        BFrom(a, m, skip) => BFrom(a.placed(offs), m, skip),
        BSext(a, m) => BSext(a.placed(offs), m),
        BConcat(lo, m1, hi, m2) => BConcat(lo.placed(offs), m1, hi.placed(offs), m2),
    }
}

fn BVPred::placed(self p: BVPred, offs: List<Nat>, bools: Nat) → BVPred {
    match p {
        PConst(b) => PConst(b),
        PEq(n, a, b) => PEq(n, a.placed(offs), b.placed(offs)),
        PUlt(n, a, b) => PUlt(n, a.placed(offs), b.placed(offs)),
        PNot(q) => PNot(q.placed(offs, bools)),
        PAnd(q, r) => PAnd(q.placed(offs, bools), r.placed(offs, bools)),
        POr(q, r) => POr(q.placed(offs, bools), r.placed(offs, bools)),
        PIff(q, r) => PIff(q.placed(offs, bools), r.placed(offs, bools)),
        PSlt(n, a, b) => PSlt(n, a.placed(offs), b.placed(offs)),
        PBit(n, a, k) => PBit(n, a.placed(offs), k),
        PVar(j) => PVar(bools + j),
        PXor(q, r) => PXor(q.placed(offs, bools), r.placed(offs, bools)),
        PNatLe(m, a, n, b) => PNatLe(m, a.placed(offs), n, b.placed(offs)),
        PNatLt(m, a, n, b) => PNatLt(m, a.placed(offs), n, b.placed(offs)),
        PNatEq(m, a, n, b) => PNatEq(m, a.placed(offs), n, b.placed(offs)),
    }
}

// ---------------------------------------------------------------------------
// Quoting: the predicate as an `Expr` over the spellings above.

record BVQuote {
    var: Handle, cnst: Handle, not: Handle, and: Handle, or: Handle, xor: Handle, add: Handle, shl: Handle, shr: Handle,
    sub: Handle, neg: Handle, mul: Handle, from: Handle, sext: Handle, concat: Handle,
    pconst: Handle, eq: Handle, ult: Handle, pnot: Handle, pand: Handle, por: Handle, iff: Handle, slt: Handle, bit: Handle, pvar: Handle, pxor: Handle,
    natle: Handle, natlt: Handle, nateq: Handle, tru: Handle, fls: Handle,
}

fn bv_resolve(name: String) → Tac<Handle> { resolve(name).or_fail("bv_decide: ") }

fn bv_quotes() → Tac<BVQuote> {
    let var <- bv_resolve("bv_decide::bvq_var");
    let cnst <- bv_resolve("bv_decide::bvq_const");
    let not <- bv_resolve("bv_decide::bvq_not");
    let and <- bv_resolve("bv_decide::bvq_and");
    let or <- bv_resolve("bv_decide::bvq_or");
    let xor <- bv_resolve("bv_decide::bvq_xor");
    let add <- bv_resolve("bv_decide::bvq_add");
    let shl <- bv_resolve("bv_decide::bvq_shl");
    let shr <- bv_resolve("bv_decide::bvq_shr");
    let sub <- bv_resolve("bv_decide::bvq_sub");
    let neg <- bv_resolve("bv_decide::bvq_neg");
    let mul <- bv_resolve("bv_decide::bvq_mul");
    let from <- bv_resolve("bv_decide::bvq_from");
    let sext <- bv_resolve("bv_decide::bvq_sext");
    let concat <- bv_resolve("bv_decide::bvq_concat");
    let pconst <- bv_resolve("bv_decide::bvq_pconst");
    let eq <- bv_resolve("bv_decide::bvq_eq");
    let ult <- bv_resolve("bv_decide::bvq_ult");
    let pnot <- bv_resolve("bv_decide::bvq_pnot");
    let pand <- bv_resolve("bv_decide::bvq_pand");
    let por <- bv_resolve("bv_decide::bvq_por");
    let iff <- bv_resolve("bv_decide::bvq_iff");
    let slt <- bv_resolve("bv_decide::bvq_slt");
    let bit <- bv_resolve("bv_decide::bvq_bit");
    let pvar <- bv_resolve("bv_decide::bvq_pvar");
    let pxor <- bv_resolve("bv_decide::bvq_pxor");
    let natle <- bv_resolve("bv_decide::bvq_natle");
    let natlt <- bv_resolve("bv_decide::bvq_natlt");
    let nateq <- bv_resolve("bv_decide::bvq_nateq");
    let tru <- bv_resolve("bv_decide::bv_true");
    let fls <- bv_resolve("bv_decide::bv_false");
    pure(BVQuote(var, cnst, not, and, or, xor, add, shl, shr, sub, neg, mul, from, sext, concat,
        pconst, eq, ult, pnot, pand, por, iff, slt, bit, pvar, pxor, natle, natlt, nateq, tru, fls))
}

fn bv_true() → Bool { True }
fn bv_false() → Bool { False }

fn bv_apply(f: Expr, args: List<Expr>) → Expr {
    match args { Nil => f, Cons(a, rest) => bv_apply(App(f, a), rest) }
}

fn bv_app(f: Handle, args: List<Expr>) → Expr { bv_apply(Hd(f), args) }

fn BVExpr::quote(self e: BVExpr, q: BVQuote) → Expr {
    match e {
        BVar(o, w) => bv_app(q.var, [NatLit(o), NatLit(w)]),
        BConst(x) => bv_app(q.cnst, [NatLit(x)]),
        BNot(a) => bv_app(q.not, [a.quote(q)]),
        BAnd(a, b) => bv_app(q.and, [a.quote(q), b.quote(q)]),
        BOr(a, b) => bv_app(q.or, [a.quote(q), b.quote(q)]),
        BXor(a, b) => bv_app(q.xor, [a.quote(q), b.quote(q)]),
        BAdd(a, b) => bv_app(q.add, [a.quote(q), b.quote(q)]),
        BShl(a, k) => bv_app(q.shl, [a.quote(q), NatLit(k)]),
        BShr(a, k) => bv_app(q.shr, [a.quote(q), NatLit(k)]),
        BSub(a, b) => bv_app(q.sub, [a.quote(q), b.quote(q)]),
        BNeg(a) => bv_app(q.neg, [a.quote(q)]),
        BMul(a, b) => bv_app(q.mul, [a.quote(q), b.quote(q)]),
        BFrom(a, m, skip) => bv_app(q.from, [a.quote(q), NatLit(m), NatLit(skip)]),
        BSext(a, m) => bv_app(q.sext, [a.quote(q), NatLit(m)]),
        BConcat(lo, m1, hi, m2) => bv_app(q.concat, [lo.quote(q), NatLit(m1), hi.quote(q), NatLit(m2)]),
    }
}

fn BVPred::quote(self p: BVPred, q: BVQuote) → Expr {
    match p {
        PConst(b) => bv_app(q.pconst, [match b { True => Hd(q.tru), False => Hd(q.fls) }]),
        PEq(n, a, b) => bv_app(q.eq, [NatLit(n), a.quote(q), b.quote(q)]),
        PUlt(n, a, b) => bv_app(q.ult, [NatLit(n), a.quote(q), b.quote(q)]),
        PNot(r) => bv_app(q.pnot, [r.quote(q)]),
        PAnd(r, s) => bv_app(q.pand, [r.quote(q), s.quote(q)]),
        POr(r, s) => bv_app(q.por, [r.quote(q), s.quote(q)]),
        PIff(r, s) => bv_app(q.iff, [r.quote(q), s.quote(q)]),
        PSlt(n, a, b) => bv_app(q.slt, [NatLit(n), a.quote(q), b.quote(q)]),
        PBit(n, a, k) => bv_app(q.bit, [NatLit(n), a.quote(q), NatLit(k)]),
        PVar(o) => bv_app(q.pvar, [NatLit(o)]),
        PXor(r, s) => bv_app(q.pxor, [r.quote(q), s.quote(q)]),
        PNatLe(m, a, n, b) => bv_app(q.natle, [NatLit(m), a.quote(q), NatLit(n), b.quote(q)]),
        PNatLt(m, a, n, b) => bv_app(q.natlt, [NatLit(m), a.quote(q), NatLit(n), b.quote(q)]),
        PNatEq(m, a, n, b) => bv_app(q.nateq, [NatLit(m), a.quote(q), NatLit(n), b.quote(q)]),
    }
}

// ---------------------------------------------------------------------------
// The layout and the proof.

record BVLemmas {
    clauses: Handle, norm: Handle, unsat: Handle, lay_word: Handle, lay_bool: Handle, no_bits: Handle,
    here: Handle, past: Handle, ok: Handle, trans: Handle, cong: Handle, congr: Handle, same: Handle,
    eq: Handle, iff: Handle, tru: Handle, lt: Handle, le: Handle, ne: Handle,
    eq_hyp: Handle, iff_hyp: Handle, tru_hyp: Handle, lt_hyp: Handle, le_hyp: Handle, ne_hyp: Handle, imp: Handle,
    nat_le: Handle, nat_lt: Handle, nat_eq: Handle, nat_ne: Handle, nat_le_hyp: Handle, nat_lt_hyp: Handle, nat_eq_hyp: Handle, nat_ne_hyp: Handle,
    nlt: Handle, nle: Handle, nat_nlt: Handle, nat_nle: Handle, nlt_hyp: Handle, nle_hyp: Handle, nat_nlt_hyp: Handle, nat_nle_hyp: Handle,
}

fn bv_lemmas() → Tac<BVLemmas> {
    let clauses <- bv_resolve("bitblast::BVPred::clauses");
    let norm <- bv_resolve("bv_normalize::BVPred::norm");
    let unsat <- bv_resolve("bv_normalize::BVPred::norm_unsat_sound");
    let lay_word <- bv_resolve("bitblast::lay_word");
    let lay_bool <- bv_resolve("bitblast::lay_bool");
    let no_bits <- bv_resolve("bitblast::no_bits");
    let here <- bv_resolve("bitblast::window_lay_here");
    let past <- bv_resolve("bitblast::window_lay_past");
    let ok <- bv_resolve("bitblast::layout_ok");
    let trans <- bv_resolve("bitblast::layout_trans");
    let cong <- bv_resolve("bitblast::layout_cong");
    let congr <- bv_resolve("bitblast::layout_congr");
    let same <- bv_resolve("bitblast::layout_same");
    let eq <- bv_resolve("bitblast::layout_eq");
    let iff <- bv_resolve("bitblast::layout_iff");
    let tru <- bv_resolve("bitblast::layout_true");
    let lt <- bv_resolve("bitblast::layout_lt");
    let le <- bv_resolve("bitblast::layout_le");
    let ne <- bv_resolve("bitblast::layout_ne");
    let eq_hyp <- bv_resolve("bitblast::layout_eq_hyp");
    let iff_hyp <- bv_resolve("bitblast::layout_iff_hyp");
    let tru_hyp <- bv_resolve("bitblast::layout_true_hyp");
    let lt_hyp <- bv_resolve("bitblast::layout_lt_hyp");
    let le_hyp <- bv_resolve("bitblast::layout_le_hyp");
    let ne_hyp <- bv_resolve("bitblast::layout_ne_hyp");
    let imp <- bv_resolve("bitblast::layout_imp");
    let nat_le <- bv_resolve("bitblast::layout_nat_le");
    let nat_lt <- bv_resolve("bitblast::layout_nat_lt");
    let nat_eq <- bv_resolve("bitblast::layout_nat_eq");
    let nat_ne <- bv_resolve("bitblast::layout_nat_ne");
    let nat_le_hyp <- bv_resolve("bitblast::layout_nat_le_hyp");
    let nat_lt_hyp <- bv_resolve("bitblast::layout_nat_lt_hyp");
    let nat_eq_hyp <- bv_resolve("bitblast::layout_nat_eq_hyp");
    let nat_ne_hyp <- bv_resolve("bitblast::layout_nat_ne_hyp");
    let nlt <- bv_resolve("bitblast::layout_nlt");
    let nle <- bv_resolve("bitblast::layout_nle");
    let nat_nlt <- bv_resolve("bitblast::layout_nat_nlt");
    let nat_nle <- bv_resolve("bitblast::layout_nat_nle");
    let nlt_hyp <- bv_resolve("bitblast::layout_nlt_hyp");
    let nle_hyp <- bv_resolve("bitblast::layout_nle_hyp");
    let nat_nlt_hyp <- bv_resolve("bitblast::layout_nat_nlt_hyp");
    let nat_nle_hyp <- bv_resolve("bitblast::layout_nat_nle_hyp");
    pure(BVLemmas(clauses, norm, unsat, lay_word, lay_bool, no_bits, here, past, ok, trans, cong, congr, same, eq, iff, tru, lt, le, ne,
        eq_hyp, iff_hyp, tru_hyp, lt_hyp, le_hyp, ne_hyp, imp, nat_le, nat_lt, nat_eq, nat_ne, nat_le_hyp, nat_lt_hyp, nat_eq_hyp, nat_ne_hyp,
        nlt, nle, nat_nlt, nat_nle, nlt_hyp, nle_hyp, nat_nlt_hyp, nat_nle_hyp))
}

// The stream from Boolean `j` on.
fn bv_lay_bools(l: BVLemmas, bs: List<LocalRef>, o: Nat) → Expr {
    match bs {
        Nil => Hd(l.no_bits),
        Cons(b, rest) => bv_app(l.lay_bool, [Local(b), NatLit(o), bv_lay_bools(l, rest, o + 1)]),
    }
}

// The stream from word `i` on, its offset `o`.
fn bv_lay(l: BVLemmas, ws: List<BVWord>, o: Nat, bools: Expr) → Expr {
    match ws {
        Nil => bools,
        Cons(w, rest) => bv_app(l.lay_word, [NatLit(w.w), Local(w.x), NatLit(o), bv_lay(l, rest, o + w.w, bools)]),
    }
}

// Word `x` (width `w`, offset `o`) read back from the stream `ws` lays out
// from offset `at`: `window(…, o, w) = x`.
fn bv_read_back(l: BVLemmas, k: Nat, ws: List<BVWord>, at: Nat, bools: Expr, x: LocalRef, w: Nat, o: Nat) → Expr {
    match ws {
        Nil => Blank,
        Cons(a, rest) => {
            let tail = bv_lay(l, rest, at + a.w, bools);
            match a.x.id.same(x.id) {
                True => bv_app(l.here, [NatLit(k), NatLit(w), Local(x), NatLit(o), tail, Hd(l.ok)]),
                False => bv_app(l.trans, [Blank, Blank, Blank, Blank,
                    bv_app(l.past, [NatLit(k), NatLit(a.w), Local(a.x), NatLit(at), tail, NatLit(w), NatLit(o), Hd(l.ok)]),
                    bv_read_back(l, k, rest, at + a.w, bools, x, w, o)]),
            }
        },
    }
}

// `f` abstracted over the words, the first outermost.
fn bv_abstracted(t: Handle, ws: List<BVWord>) → Tac<Handle> {
    match ws {
        Nil => pure(t),
        Cons(w, rest) => {
            let inner <- bv_abstracted(t, rest);
            abstract_over(inner, Local(w.x)).or_fail("bv_decide: the claim over an atom: ")
        },
    }
}

fn bv_replaced_from(l: BVLemmas, k: Nat, all, ws: List<BVWord>, o: Nat, bools: Expr, f: Expr, acc: Option<Expr>, side: Handle) → Expr {
    match ws {
        Nil => match acc { None => bv_app(l.same, [Blank, Hd(side)]), Some(e) => e },
        Cons(w, rest) => {
            let back = bv_read_back(l, k, all, 0, bools, w.x, w.w, o);
            let next = match acc {
                None => bv_app(l.cong, [Blank, Blank, f, Blank, Blank, back]),
                Some(e) => bv_app(l.congr, [Blank, Blank, Blank, Blank, Blank, Blank, e, back]),
            };
            bv_replaced_from(l, k, all, rest, o + w.w, bools, f, Some(next), side)
        },
    }
}

// `side[windows] = side`, by congruence one word at a time.
fn bv_replaced(l: BVLemmas, k: Nat, all: List<BVWord>, bools: Expr, f: Handle, side: Handle) → Expr {
    bv_replaced_from(l, k, all, all, 0, bools, Hd(f), None, side)
}

// ---------------------------------------------------------------------------
// Counterexamples.

fn bv_decimal(fuel, n: Nat) → String {
    match fuel {
        Zero => "",
        Succ(f) => match n.div(10) {
            Zero => "0123456789".drop(n).take(1),
            Succ(_) => bv_decimal(f, n.div(10)) ++ "0123456789".drop(n.mod(10)).take(1),
        },
    }
}

fn bv_model_bit(model: List<Bool>, k: Nat) → Bool { match model.nth(k + 1) { Some(b) => b, None => False } }

fn bv_model_word(model: List<Bool>, o, w: Nat) → Nat {
    match w { Zero => 0, Succ(r) => (match bv_model_bit(model, o) { True => 1, False => 0 }) + 2 * bv_model_word(model, o + 1, r) }
}

fn bv_name(locals: List<LocalInfo>, x: LocalRef) → String {
    match locals {
        Nil => "?",
        Cons(l, rest) => match l.ref.id.same(x.id) { True => l.name, False => bv_name(rest, x) },
    }
}

fn bv_show_words(locals: List<LocalInfo>, ws: List<BVWord>, o: Nat, model: List<Bool>) → List<String> {
    match ws {
        Nil => [],
        Cons(w, rest) => Cons(bv_name(locals, w.x) ++ " = " ++ bv_decimal(40, bv_model_word(model, o, w.w)), bv_show_words(locals, rest, o + w.w, model)),
    }
}

fn bv_show_bools(locals: List<LocalInfo>, bs: List<LocalRef>, o: Nat, model: List<Bool>) → List<String> {
    match bs {
        Nil => [],
        Cons(b, rest) => Cons(bv_name(locals, b) ++ " = " ++ (match bv_model_bit(model, o) { True => "True", False => "False" }), bv_show_bools(locals, rest, o + 1, model)),
    }
}

fn bv_joined(parts: List<String>) → String {
    match parts {
        Nil => "",
        Cons(a, rest) => match rest { Nil => a, Cons(_, _) => a ++ ", " ++ bv_joined(rest) },
    }
}

// What the solver's model says the atoms are, or that the claim is false
// outright when it has none.
fn bv_counterexample(locals: List<LocalInfo>, ws: List<BVWord>, bs: List<LocalRef>, wbits: Nat, model: List<Bool>) → String {
    match bv_show_words(locals, ws, 0, model) ++ bv_show_bools(locals, bs, wbits, model) {
        Nil => "bv_decide: the claim is false",
        Cons(a, rest) => "bv_decide: the claim is false at " ++ bv_joined(Cons(a, rest)),
    }
}

// ---------------------------------------------------------------------------
// The tactic.

// A claim, the goal's or a hypothesis's: an equation between words of width
// `n`, between Booleans, a Boolean that is `True`, or `a < b`, `a <= b`,
// `a ≠ b` between words.
inductive BVClaim {
    CWords(n: Nat, a: Handle, b: Handle),
    CBools(p: Handle, q: Handle),
    CTrue(p: Handle),
    CLt(n: Nat, a: Handle, b: Handle),
    CLe(n: Nat, a: Handle, b: Handle),
    CNe(n: Nat, a: Handle, b: Handle),
    // Naturals: numerals and words' values, `toNat`.
    CNatLe(a: Handle, b: Handle),
    CNatLt(a: Handle, b: Handle),
    CNatEq(a: Handle, b: Handle),
    CNatNe(a: Handle, b: Handle),
    // Refuted comparisons, `¬(a < b)` and `¬(a <= b)`: a test's `False`
    // branch.
    CNLt(n: Nat, a: Handle, b: Handle),
    CNLe(n: Nat, a: Handle, b: Handle),
    CNatNLt(a: Handle, b: Handle),
    CNatNLe(a: Handle, b: Handle),
}

// Whether `h` is a natural, by its type.
fn bv_is_nat(ops: BVOps, h: Handle) → Tac<Bool> {
    let c <- infer(Hd(h));
    match c {
        Refused(_) => pure(False),
        Accepted(ty) => {
            let t <- whnf_or(ty);
            let v <- view(t);
            match v { HGlobal(g, _, _) => pure(g.id.same(ops.nat)), _ => pure(False) }
        },
    }
}

fn bv_word_claim(ops: BVOps, a, b: Handle, k: Nat → Handle → Handle → BVClaim) → Tac<BVClaim> {
    let n <- bv_width(ops, a);
    match n {
        Some(n) => pure(k(n, a, b)),
        None => fail("bv_decide: the sides are not words", []),
    }
}

fn bv_pair(args: List<Handle>, k: Handle → Handle → Tac<BVClaim>) → Tac<BVClaim> {
    match args {
        Cons(a, rest) => match rest {
            Cons(b, Nil) => k(a, b),
            _ => fail("bv_decide: the comparison is not of two words", []),
        },
        Nil => fail("bv_decide: the comparison is not of two words", []),
    }
}

// The claim `¬p`, for `p` an equation or a comparison.
fn bv_negated(ops: BVOps, p: Handle) → Tac<BVClaim> {
    let vp <- view(p);
    match vp {
        HEq(a, b) => {
            let nat <- bv_is_nat(ops, a);
            match nat {
                True => pure(CNatNe(a, b)),
                False => bv_word_claim(ops, a, b, λ n x y => CNe(n, x, y)),
            }
        },
        HGlobal(g, _, args) => match g.id.same(ops.nat_le) || g.id.same(ops.nat_lt) {
            True => bv_pair(args, λ a b => pure(match g.id.same(ops.nat_le) { True => CNatNLe(a, b), False => CNatNLt(a, b) })),
            False => match g.id.same(ops.lt) || g.id.same(ops.le) {
                True => bv_pair(args, λ a b => bv_word_claim(ops, a, b, λ n x y => match g.id.same(ops.lt) { True => CNLt(n, x, y), False => CNLe(n, x, y) })),
                False => fail("bv_decide: a negation of something other than an equation or comparison", []),
            },
        },
        _ => fail("bv_decide: a negation of something other than an equation or comparison", []),
    }
}

fn bv_claim(ops: BVOps, t: Handle) → Tac<BVClaim> {
    let v <- view(t);
    match v {
        HEq(a, b) => {
            let n <- bv_width(ops, a);
            match n {
                Some(n) => pure(CWords(n, a, b)),
                None => {
                    let nat <- bv_is_nat(ops, a);
                    match nat {
                        True => pure(CNatEq(a, b)),
                        False => {
                            let vb <- view(b);
                            match vb {
                                HCtor(ty, i, _, Nil) => match ty.id.same(ops.bool) && i.same(1) { True => pure(CTrue(a)), False => pure(CBools(a, b)) },
                                _ => pure(CBools(a, b)),
                            }
                        },
                    }
                },
            }
        },
        HGlobal(g, _, args) => match g.id.same(ops.nat_le) || g.id.same(ops.nat_lt) {
            True => bv_pair(args, λ a b => pure(match g.id.same(ops.nat_le) { True => CNatLe(a, b), False => CNatLt(a, b) })),
            False => match g.id.same(ops.lt) {
            True => bv_pair(args, λ a b => bv_word_claim(ops, a, b, λ n x y => CLt(n, x, y))),
            False => match g.id.same(ops.le) {
                True => bv_pair(args, λ a b => bv_word_claim(ops, a, b, λ n x y => CLe(n, x, y))),
                False => match g.id.same(ops.not_p) {
                    True => match args {
                        Cons(p, Nil) => bv_negated(ops, p),
                        _ => fail("bv_decide: the claim is not one bv_decide reads", []),
                    },
                    False => fail("bv_decide: the goal is not an equation or comparison between words or Booleans", []),
                },
            },
            },
        },
        // `P → False`, the form a refuted test takes in an `induct` arm.
        HPi(p) => {
            let o <- open(t, "_");
            match o {
                Accepted(op) => {
                    let vb <- view(op.body);
                    match vb {
                        HGlobal(f, _, Nil) => match f.id.same(ops.false_ty) && !op.dependent {
                            True => bv_negated(ops, p),
                            False => fail("bv_decide: the goal is a function type", []),
                        },
                        _ => fail("bv_decide: the goal is a function type", []),
                    }
                },
                Refused(_) => fail("bv_decide: the goal is a function type", []),
            }
        },
        _ => fail("bv_decide: the goal is not an equation or comparison between words or Booleans", []),
    }
}

fn bv_read_words(ops: BVOps, n: Nat, a, b: Handle, st: BVAtoms, k: BVExpr → BVExpr → BVPred) → Tac<BVRead> {
    let ra <- bv_read(ops, a, WWord(n), st, 4096);
    let rb <- bv_read(ops, b, WWord(n), ra.st, 4096);
    pure(BVRead(OBool(k(ra.word(), rb.word())), rb.st))
}

fn bv_read_nats(ops: BVOps, a, b: Handle, st: BVAtoms, k: Nat → BVExpr → Nat → BVExpr → BVPred) → Tac<BVRead> {
    bv_nat_compare(ops, λ h w st2 => bv_read(ops, h, w, st2, 4096), a, b, st, k)
}

// The claim's predicate, its atoms added to `st`.
fn bv_read_claim(ops: BVOps, c: BVClaim, st: BVAtoms) → Tac<BVRead> {
    match c {
        CWords(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PEq(n, x, y)),
        CBools(p, q) => {
            let rp <- bv_read(ops, p, WBool, st, 4096);
            let rq <- bv_read(ops, q, WBool, rp.st, 4096);
            pure(BVRead(OBool(PIff(rp.bool(), rq.bool())), rq.st))
        },
        CTrue(p) => bv_read(ops, p, WBool, st, 4096),
        CLt(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PUlt(n, x, y)),
        CLe(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PNot(PUlt(n, y, x))),
        CNe(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PNot(PEq(n, x, y))),
        CNatLe(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNatLe(m, x, n, y)),
        CNatLt(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNatLt(m, x, n, y)),
        CNatEq(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNatEq(m, x, n, y)),
        CNatNe(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNot(PNatEq(m, x, n, y))),
        CNLt(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PNot(PUlt(n, x, y))),
        CNLe(n, a, b) => bv_read_words(ops, n, a, b, st, λ x y => PUlt(n, y, x)),
        CNatNLt(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNatLe(n, y, m, x)),
        CNatNLe(a, b) => bv_read_nats(ops, a, b, st, λ m x n y => PNatLt(n, y, m, x)),
    }
}

// ---------------------------------------------------------------------------
// Statements: claims joined by `∧ ∨ ↔ ¬`, and `False`. Each part keeps its
// own statement (`ta`, `tb`), the binder type of a bridge that takes a
// proof of it.

inductive BVStmt {
    SClaim(c: BVClaim, p: BVPred),
    SAnd(a: BVStmt, b: BVStmt, ta: Handle, tb: Handle),
    SOr(a: BVStmt, b: BVStmt, ta: Handle, tb: Handle),
    SNot(a: BVStmt, ta: Handle),
    SIff(a: BVStmt, b: BVStmt, ta: Handle, tb: Handle),
    SFalse,
}

fn BVStmt::pred(self s: BVStmt) → BVPred {
    match s {
        SClaim(_, p) => p,
        SAnd(a, b, _, _) => PAnd(a.pred(), b.pred()),
        SOr(a, b, _, _) => POr(a.pred(), b.pred()),
        SNot(a, _) => PNot(a.pred()),
        SIff(a, b, _, _) => PIff(a.pred(), b.pred()),
        SFalse => PConst(False),
    }
}

fn bv_stmt_claim(ops: BVOps, t: Handle, st: BVAtoms) → Tac<Pair<BVStmt, BVAtoms>> {
    let c <- bv_claim(ops, t);
    let r <- bv_read_claim(ops, c, st);
    pure(Pair(SClaim(c, r.bool()), r.st))
}

// `¬p`'s claim, when `bv_negated` reads one (a refuted comparison).
fn bv_stmt_refuted(ops: BVOps, p: Handle, st: BVAtoms) → Tac<Option<Pair<BVStmt, BVAtoms>>> {
    let tried <- attempt(bv_negated(ops, p));
    match tried {
        Done(c) => bv_read_claim(ops, c, st).bind(λ r => pure(Some(Pair(SClaim(c, r.bool()), r.st)))),
        Failed(_, _) => pure(None),
    }
}

// The negation `t` of `p`, or `t` as a claim: `inner` reads it.
fn bv_stmt_negation(ops: BVOps, t: Handle, p: Option<Handle>, st: BVAtoms, inner: Handle → BVAtoms → Tac<Pair<BVStmt, BVAtoms>>) → Tac<Pair<BVStmt, BVAtoms>> {
    match p {
        None => bv_stmt_claim(ops, t, st),
        Some(p) => bv_stmt_refuted(ops, p, st).bind(λ r => match r {
            Some(done) => pure(done),
            None => inner(p, st).bind(λ ri => pure(Pair(SNot(ri.fst, p), ri.snd))),
        }),
    }
}

// The negated statement of `t`, `¬p` or `p → False`.
fn bv_negand(ops: BVOps, t: Handle) → Tac<Option<Handle>> {
    let v <- view(t);
    match v {
        HGlobal(g, _, args) => match args {
            // `Not(P)`'s `P` is a type held as a term: read as the type.
            Cons(p, Nil) => match g.id.same(ops.not_p) {
                True => as_type(Hd(p)).bind(λ c => match c { Accepted(ty) => pure(Some(ty)), Refused(_) => pure(Some(p)) }),
                False => pure(None),
            },
            _ => pure(None),
        },
        HPi(p) => {
            let o <- open(t, "_");
            match o {
                Accepted(op) => view(op.body).bind(λ vb => match vb {
                    HGlobal(f, _, Nil) => pure(match f.id.same(ops.false_ty) && !op.dependent { True => Some(p), False => None }),
                    _ => pure(None),
                }),
                Refused(_) => pure(None),
            }
        },
        _ => pure(None),
    }
}

// Which connective `t` is, with its two parts: 0 for `∧`, 1 `∨`, 2 `↔`.
fn bv_connective(ops: BVOps, t: Handle) → Tac<Option<Pair<Nat, Pair<Handle, Handle>>>> {
    let v <- view(t);
    match v {
        HGlobal(g, _, args) => match args {
            Cons(a, rest) => match rest {
                Cons(b, Nil) => pure(match g.id.same(ops.and_p) {
                    True => Some(Pair(0, Pair(a, b))),
                    False => match g.id.same(ops.or_p) {
                        True => Some(Pair(1, Pair(a, b))),
                        False => match g.id.same(ops.iff_p) { True => Some(Pair(2, Pair(a, b))), False => None },
                    },
                }),
                _ => pure(None),
            },
            Nil => pure(None),
        },
        _ => pure(None),
    }
}

fn bv_is_false(ops: BVOps, t: Handle) → Tac<Bool> {
    let v <- view(t);
    match v { HGlobal(g, _, Nil) => pure(g.id.same(ops.false_ty)), _ => pure(False) }
}

// The statement `t`, its atoms added to `st`. `fuel` bounds its depth.
fn bv_stmt(ops: BVOps, t: Handle, st: BVAtoms, fuel: Nat) → Tac<Pair<BVStmt, BVAtoms>> {
    match fuel {
        Zero => bv_stmt_claim(ops, t, st),
        Succ(f) => {
            let conn <- bv_connective(ops, t);
            match conn {
                Some(c) => {
                    let a = c.snd.fst;
                    let b = c.snd.snd;
                    let ra <- bv_stmt(ops, a, st, f);
                    let rb <- bv_stmt(ops, b, ra.snd, f);
                    pure(Pair(match c.fst { Zero => SAnd(ra.fst, rb.fst, a, b), Succ(i) => match i { Zero => SOr(ra.fst, rb.fst, a, b), Succ(_) => SIff(ra.fst, rb.fst, a, b) } }, rb.snd))
                },
                None => {
                    let falsum <- bv_is_false(ops, t);
                    match falsum {
                        True => pure(Pair(SFalse, st)),
                        False => {
                            let p <- bv_negand(ops, t);
                            bv_stmt_negation(ops, t, p, st, λ q st2 => bv_stmt(ops, q, st2, f))
                        },
                    }
                },
            }
        },
    }
}

// A hypothesis the tactic reads: its proof and its statement.
record BVHyp { proof: LocalRef, stmt: BVStmt }

// The hypotheses among `locals` that read as statements, their atoms added
// to `st`; the others are left out.
fn bv_hyps(ops: BVOps, locals: List<LocalInfo>, st: BVAtoms) → Tac<Pair<List<BVHyp>, BVAtoms>> {
    match locals {
        Nil => pure(Pair([], st)),
        Cons(h, rest) => {
            let tried <- attempt(bv_stmt(ops, h.ty, st, 16));
            match tried {
                Done(r) => {
                    let more <- bv_hyps(ops, rest, r.snd);
                    pure(Pair(Cons(BVHyp(h.ref, r.fst), more.fst), more.snd))
                },
                Failed(_, _) => bv_hyps(ops, rest, st),
            }
        },
    }
}

// The claim under its hypotheses: `¬h₁ ∨ (¬h₂ ∨ … goal)`.
fn bv_under(hs: List<BVHyp>, goal: BVPred) → BVPred {
    match hs {
        Nil => goal,
        Cons(h, rest) => POr(PNot(h.stmt.pred()), bv_under(rest, goal)),
    }
}

// The claim from its predicate at the laid-out atoms (`last`, as the goal),
// or its predicate there from the claim's proof (`last`, as a hypothesis).
fn bv_bridge(l: BVLemmas, k: Nat, ws: List<BVWord>, bools: Expr, c: BVClaim, as_goal: Bool, last: Expr) → Tac<Expr> {
    let words = λ (n: Nat) (a: Handle) (b: Handle) (goal: Handle) (hyp: Handle) => bv_abstracted(a, ws).bind(λ fa => bv_abstracted(b, ws).bind(λ fb =>
        pure(bv_app(as_goal.select(goal, hyp), [NatLit(n), Blank, Blank, Hd(a), Hd(b), bv_replaced(l, k, ws, bools, fa, a), bv_replaced(l, k, ws, bools, fb, b), last]))));
    let nats = λ (a: Handle) (b: Handle) (goal: Handle) (hyp: Handle) => bv_abstracted(a, ws).bind(λ fa => bv_abstracted(b, ws).bind(λ fb =>
        pure(bv_app(as_goal.select(goal, hyp), [Blank, Blank, Hd(a), Hd(b), bv_replaced(l, k, ws, bools, fa, a), bv_replaced(l, k, ws, bools, fb, b), last]))));
    match c {
        CWords(n, a, b) => words(n, a, b, l.eq, l.eq_hyp),
        CBools(p, q) => {
            let fp <- bv_abstracted(p, ws);
            let fq <- bv_abstracted(q, ws);
            pure(bv_app(as_goal.select(l.iff, l.iff_hyp), [Blank, Blank, Hd(p), Hd(q), bv_replaced(l, k, ws, bools, fp, p), bv_replaced(l, k, ws, bools, fq, q), last]))
        },
        CTrue(p) => {
            let fp <- bv_abstracted(p, ws);
            pure(bv_app(as_goal.select(l.tru, l.tru_hyp), [Blank, Hd(p), bv_replaced(l, k, ws, bools, fp, p), last]))
        },
        CLt(n, a, b) => words(n, a, b, l.lt, l.lt_hyp),
        CLe(n, a, b) => words(n, a, b, l.le, l.le_hyp),
        CNe(n, a, b) => words(n, a, b, l.ne, l.ne_hyp),
        CNatLe(a, b) => nats(a, b, l.nat_le, l.nat_le_hyp),
        CNatLt(a, b) => nats(a, b, l.nat_lt, l.nat_lt_hyp),
        CNatEq(a, b) => nats(a, b, l.nat_eq, l.nat_eq_hyp),
        CNatNe(a, b) => nats(a, b, l.nat_ne, l.nat_ne_hyp),
        CNLt(n, a, b) => words(n, a, b, l.nlt, l.nlt_hyp),
        CNLe(n, a, b) => words(n, a, b, l.nle, l.nle_hyp),
        CNatNLt(a, b) => nats(a, b, l.nat_nlt, l.nat_nlt_hyp),
        CNatNLe(a, b) => nats(a, b, l.nat_nle, l.nat_nle_hyp),
    }
}

// What a statement's bridges need: the layout, how a part's predicate is
// placed and quoted, and the bit stream the predicate is true at (`bits`,
// read off the refutation's statement).
record BVCx {
    l: BVLemmas, q: BVQuote, k: Nat, ws: List<BVWord>, bools: Expr, offs: List<Nat>, wbits: Nat, bits: Handle,
    eval: Handle, and_i: Handle, and_l: Handle, and_r: Handle, band_l: Handle, band_r: Handle, band: Handle,
    or_g: Handle, or_h: Handle, not_g: Handle, not_h: Handle, iff_g: Handle, iff_h: Handle, false_g: Handle, false_h: Handle,
}

// A part's verdict: its placed predicate at the stream.
fn BVCx::verdict(self cx: BVCx, s: BVStmt) → Expr {
    bv_app(cx.eval, [s.pred().placed(cx.offs, cx.wbits).quote(cx.q), Hd(cx.bits)])
}

// `λ (x: ty) => body(x)`, its binder under `under` (an enclosing
// part's λ, whose body this one is in).
fn bv_lam(ty: Expr, under: Option<LocalRef>, body: LocalRef → Tac<Expr>) → Tac<Expr> {
    let a <- assume(ty, "_", under);
    match a {
        Accepted(x) => body(x.ref).bind(λ e => pure(Lam(x.ref, e))),
        Refused(_) => fail("bv_decide: a part's bridge", []),
    }
}

// As the goal (`as_goal`), the statement from `e`, its predicate's verdict
// `True` at the stream; as a hypothesis, that verdict from `e`, the
// statement's proof. A part's bridge is a function: `to` from its verdict
// to the part, `from` back.
fn BVCx::bridge(self cx: BVCx, s: BVStmt, as_goal: Bool, e: Expr, under: Option<LocalRef>) → Tac<Expr> {
    match s {
        SClaim(c, _) => bv_bridge(cx.l, cx.k, cx.ws, cx.bools, c, as_goal, e),
        SAnd(a, b, ta, tb) => match as_goal {
            True => {
                let ga <- cx.bridge(a, True, bv_app(cx.band_l, [cx.verdict(a), cx.verdict(b), e]), under);
                let gb <- cx.bridge(b, True, bv_app(cx.band_r, [cx.verdict(a), cx.verdict(b), e]), under);
                pure(bv_app(cx.and_i, [Hd(ta), Hd(tb), ga, gb]))
            },
            False => {
                let ha <- cx.bridge(a, False, bv_app(cx.and_l, [Hd(ta), Hd(tb), e]), under);
                let hb <- cx.bridge(b, False, bv_app(cx.and_r, [Hd(ta), Hd(tb), e]), under);
                pure(bv_app(cx.band, [cx.verdict(a), cx.verdict(b), ha, hb]))
            },
        },
        SOr(a, b, ta, tb) => match as_goal {
            True => {
                let fa <- bv_lam(Equation(cx.verdict(a), Hd(cx.q.tru)), under, λ v => cx.bridge(a, True, Local(v), Some(v)));
                let fb <- bv_lam(Equation(cx.verdict(b), Hd(cx.q.tru)), under, λ v => cx.bridge(b, True, Local(v), Some(v)));
                pure(bv_app(cx.or_g, [cx.verdict(a), cx.verdict(b), Hd(ta), Hd(tb), fa, fb, e]))
            },
            False => {
                let ga <- bv_lam(Hd(ta), under, λ v => cx.bridge(a, False, Local(v), Some(v)));
                let gb <- bv_lam(Hd(tb), under, λ v => cx.bridge(b, False, Local(v), Some(v)));
                pure(bv_app(cx.or_h, [cx.verdict(a), cx.verdict(b), Hd(ta), Hd(tb), ga, gb, e]))
            },
        },
        SNot(a, ta) => match as_goal {
            True => bv_lam(Hd(ta), under, λ v => cx.bridge(a, False, Local(v), Some(v))).bind(λ ga => pure(bv_app(cx.not_g, [cx.verdict(a), Hd(ta), ga, e]))),
            False => bv_lam(Equation(cx.verdict(a), Hd(cx.q.tru)), under, λ v => cx.bridge(a, True, Local(v), Some(v))).bind(λ fa => pure(bv_app(cx.not_h, [cx.verdict(a), Hd(ta), fa, e]))),
        },
        SIff(a, b, ta, tb) => {
            let fa <- bv_lam(Equation(cx.verdict(a), Hd(cx.q.tru)), under, λ v => cx.bridge(a, True, Local(v), Some(v)));
            let ga <- bv_lam(Hd(ta), under, λ v => cx.bridge(a, False, Local(v), Some(v)));
            let fb <- bv_lam(Equation(cx.verdict(b), Hd(cx.q.tru)), under, λ v => cx.bridge(b, True, Local(v), Some(v)));
            let gb <- bv_lam(Hd(tb), under, λ v => cx.bridge(b, False, Local(v), Some(v)));
            pure(bv_app(as_goal.select(cx.iff_g, cx.iff_h), [cx.verdict(a), cx.verdict(b), Hd(ta), Hd(tb), fa, ga, fb, gb, e]))
        },
        SFalse => pure(bv_app(as_goal.select(cx.false_g, cx.false_h), [e])),
    }
}

// From the whole predicate at the stream (`holds`), each hypothesis
// discharged in turn (`layout_imp`), to the goal's predicate there. `p` is
// the placed predicate, `¬h ∨ rest` once per hypothesis.
fn bv_discharge(cx: BVCx, hs: List<BVHyp>, p: BVPred, holds: Expr) → Tac<Expr> {
    match hs {
        Nil => pure(holds),
        Cons(h, rest) => match p {
            POr(nh, r) => match nh {
                PNot(hp) => {
                    let hh <- cx.bridge(h.stmt, False, Local(h.proof), None);
                    bv_discharge(cx, rest, r, bv_app(cx.l.imp, [hp.quote(cx.q), r.quote(cx.q), Blank, holds, hh]))
                },
                _ => fail("bv_decide: the hypotheses' layout", []),
            },
            _ => fail("bv_decide: the hypotheses' layout", []),
        },
    }
}

// The stream a refutation's statement `p.eval(bits) = True` holds at.
fn bv_stream_of(holds: Expr) → Tac<Handle> {
    let ty <- infer(holds).or_fail("bv_decide: the refutation's statement: ");
    let v <- view(ty);
    match v {
        HEq(lhs, _) => view(lhs).bind(λ lv => match head_args(lv).last() {
            Some(bits) => pure(bits),
            None => fail("bv_decide: the refutation's statement is not a verdict", []),
        }),
        _ => fail("bv_decide: the refutation's statement is not an equation", []),
    }
}

fn bv_cx(l: BVLemmas, q: BVQuote, k: Nat, ws: List<BVWord>, bools: Expr, offs: List<Nat>, wbits: Nat, bits: Handle) → Tac<BVCx> {
    let eval <- bv_resolve("bitblast::BVPred::eval");
    let and_i <- bv_resolve("bitblast::layout_and");
    let and_l <- bv_resolve("bitblast::layout_and_l");
    let and_r <- bv_resolve("bitblast::layout_and_r");
    let band_l <- bv_resolve("bitblast::layout_bool_and_l");
    let band_r <- bv_resolve("bitblast::layout_bool_and_r");
    let band <- bv_resolve("bitblast::layout_bool_and");
    let or_g <- bv_resolve("bitblast::layout_or");
    let or_h <- bv_resolve("bitblast::layout_or_hyp");
    let not_g <- bv_resolve("bitblast::layout_not");
    let not_h <- bv_resolve("bitblast::layout_not_hyp");
    let iff_g <- bv_resolve("bitblast::layout_iff_p");
    let iff_h <- bv_resolve("bitblast::layout_iff_p_hyp");
    let false_g <- bv_resolve("bitblast::layout_false");
    let false_h <- bv_resolve("bitblast::layout_false_hyp");
    pure(BVCx(l, q, k, ws, bools, offs, wbits, bits, eval, and_i, and_l, and_r, band_l, band_r, band, or_g, or_h, not_g, not_h, iff_g, iff_h, false_g, false_h))
}

fn bv_decide_once() → Tac<Expr> {
    let g <- goal();
    let ops <- bv_ops();
    let read <- bv_stmt(ops, g.target, BVAtoms([], []), 16);
    let under <- bv_hyps(ops, g.locals, read.snd);
    let hs = under.fst;
    let ws = under.snd.words;
    let bs = under.snd.bools;
    let wbits = bv_word_bits(ws);
    let k = wbits + bs.len();
    let offs = bv_offsets(ws, 0);
    let pred = bv_under(hs, read.fst.pred()).placed(offs, wbits);
    let q <- bv_quotes();
    let l <- bv_lemmas();
    let pe = pred.quote(q);
    let verdict <- sat(bv_app(l.clauses, [bv_app(l.norm, [pe]), NatLit(k)]), k + 1).or_fail("bv_decide: ");
    match verdict {
        Satisfiable(model) => fail(bv_counterexample(g.locals, ws, bs, wbits, model), []),
        Unsatisfiable(r) => {
            let bools = bv_lay_bools(l, bs, wbits);
            let lay = bv_lay(l, ws, 0, bools);
            let all = bv_app(l.unsat, [pe, NatLit(k), Hd(r), lay]);
            let bits <- bv_stream_of(all);
            let cx <- bv_cx(l, q, k, ws, bools, offs, wbits, bits);
            let holds <- bv_discharge(cx, hs, pred, all);
            cx.bridge(read.fst, True, holds, None)
        },
    }
}

// An arm's body under the binder an encoded constructor's payload is, when
// it does not read it.
fn bv_arm_opened(body: Handle) → Tac<Option<Handle>> {
    let v <- view(body);
    match v {
        HLam(_) => {
            let o <- open(body, "_");
            match o {
                Accepted(op) => match op.dependent { False => pure(Some(op.body)), True => pure(None) },
                Refused(_) => pure(None),
            }
        },
        _ => pure(Some(body)),
    }
}

// A term unfolded as the reader unfolds it, one definition at a time, until
// it unfolds no further: the host's `whnf` would go on into the match's
// test, where the word's own representation is spelled out.
fn bv_unfolded_all(fuel: Nat, h: Handle) → Tac<Handle> {
    match fuel {
        Zero => pure(h),
        Succ(f) => unfold(h).bind(λ u => match u { Accepted(h2) => bv_unfolded_all(f, h2), Refused(_) => pure(h) }),
    }
}

fn bv_is_bool(ops: BVOps, h: Handle) → Tac<Bool> {
    let c <- infer(Hd(h));
    match c {
        Refused(_) => pure(False),
        Accepted(ty) => {
            let t <- whnf_or(ty);
            let v <- view(t);
            match v { HGlobal(g, _, _) => pure(g.id.same(ops.bool)), _ => pure(False) }
        },
    }
}

// A word the reader cannot read because a `match` chooses it (a word-valued
// `if`, as `utf8_two` is): the test it is stuck on. A call's arguments are
// searched first, so the innermost such word is split first.
fn bv_word_blocker(ops: BVOps, fuel: Nat, t: Handle) → Tac<Option<Handle>> {
    match fuel {
        Zero => pure(None),
        Succ(f) => view(t).bind(λ v => blocker_among(head_args(v), λ h => bv_word_blocker(ops, f, h)).bind(λ inside => match inside {
            Some(x) => pure(Some(x)),
            None => bv_width(ops, t).bind(λ w => match w {
                None => pure(None),
                Some(_) => bv_unfolded_all(16, t).bind(λ wt => view(wt).bind(λ wv => match wv {
                        HMatch(sc) => view(sc).bind(λ sv => match sv {
                            // A match a split decided: the arm it selects.
                            HCtor(_, i, _, Nil) => arms(wt).bind(λ a => match a {
                                Accepted(mi) => match mi.arms.nth(i) {
                                    Some(arm) => bv_arm_opened(arm.body).bind(λ body => match body {
                                        Some(bh) => bv_word_blocker(ops, f, bh),
                                        None => pure(None),
                                    }),
                                    None => pure(None),
                                },
                                Refused(_) => pure(None),
                            }),
                            // Only an `if`'s test: a match on a word's own
                            // representation (`zero_extend` at a neutral
                            // byte) is the reader's to read, not a case.
                            _ => bv_is_bool(ops, sc).bind(λ b => match b { True => pure(Some(sc)), False => pure(None) }),
                        }),
                        _ => pure(None),
                    })),
            }),
        })),
    }
}

fn bv_goal_sides(v: Head) → List<Handle> {
    match v { HEq(l, r) => [l, r], _ => head_args(v) }
}

// `bv_decide`, and where the claim has a word chosen by a `match` (which
// the reader does not read), the goal split on that match's test, each
// case decided under the test's outcome. `fuel` bounds the splits along a
// path.
fn bv_decide_split(fuel: Nat) → Tac<Expr> {
    let g <- goal();
    let tried <- attempt(bv_decide_once());
    match tried {
        Done(e) => pure(e),
        Failed(msg, notes) => match fuel {
            Zero => fail(msg, notes),
            Succ(f) => {
                let ops <- bv_ops();
                let v <- view(g.target);
                let found <- blocker_among(bv_goal_sides(v), λ h => bv_word_blocker(ops, 64, h));
                match found {
                    None => fail(msg, notes ++ [Tried("a word chosen by a match", "none found")]),
                    Some(sc) => {
                        let c <- cases(Hd(sc), g.target);
                        match c {
                            Refused(why) => fail(msg, notes ++ [At(Hd(sc), Tried("splitting on it", why))]),
                            // A case's failure says which test it is a case of.
                            Accepted(sp) => close_by(sp, g.locals, attempt(bv_decide_split(f)).bind(λ t => match t {
                                Done(e) => pure(e),
                                Failed(m, ns) => fail(m, ns ++ [At(Hd(sc), Tried("deciding a case of it", "failed as above"))]),
                            })),
                        }
                    },
                }
            },
        },
    }
}

fn bv_decide() → Tac<Expr> { bv_decide_split(8) }

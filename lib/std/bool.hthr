// Booleans, their logical operations, and the propositional order
// `False <= True`. Conjunction and disjunction are both commutative monoids;
// the corresponding instances live in `std/algebra`.

import logic;

inductive Bool { False, True }

fn not(b: Bool) -> Bool { match b { False => True, True => False } }

fn and(a, b: Bool) -> Bool { match a { False => False, True => b } }

designation && at Bool := and

fn or(a, b: Bool) -> Bool { match a { False => b, True => True } }

designation || at Bool := or

// `and` is the conjunction monoid: unit `True`, and — because `and` recurses
// on its *first* argument — `and(True, x)` is `x` definitionally while
// `and(x, True) = x` is the case split.

theorem and_assoc(a, b, c: Bool): (a && b) && c = a && (b && c) {
    match a { False => refl, True => refl }
}

theorem and_true_l(a: Bool): True && a = a { refl }

theorem and_true_r(a: Bool): a && True = a {
    match a { False => refl, True => refl }
}

theorem and_comm(a, b: Bool): a && b = b && a {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

// `or` is the disjunction monoid: unit `False`. Same shape, dual.

theorem or_assoc(a, b, c: Bool): (a || b) || c = a || (b || c) {
    match a { False => refl, True => refl }
}

theorem or_false_l(a: Bool): False || a = a { refl }

theorem or_false_r(a: Bool): a || False = a {
    match a { False => refl, True => refl }
}

theorem or_comm(a, b: Bool): a || b = b || a {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

// Equality is a separate decision from the propositional order below. It is
// stated directly over constructor identity, and registers at Bool's equality
// carrier without colliding with Nat's corresponding instance.
fn eq_dec(a, b: Bool) -> a = b ∨ ¬ (a = b) {
    match a as λ x => x = b ∨ ¬ (x = b) {
        False => match b as λ y => False = y ∨ ¬ (False = y) {
            False => Inl(refl),
            True => Inr(λ (bad: False = True) => absurd(bad)),
        },
        True => match b as λ y => True = y ∨ ¬ (True = y) {
            False => Inr(λ (bad: True = False) => absurd(bad)),
            True => Inl(refl),
        },
    }
}

instance(a, b: Bool) Decide<a = b> { dec := eq_dec(a, b) }

// The decided order on `Bool`. `False <= True` is the reading, so the relation
// is implication.
//
// `leb` is the Bool-valued decision and `Le` the PROPOSITION, in the shape
// `nat`'s order took on 2026-08-16 (docs/nat-order-design.md): the
// specification is a recursion into `Type` with no `= True` in it, and the
// decision procedure is a separate function nothing above mentions. This
// module needs both for the reason `nat` does — `Bool` is where Booleans are
// genuinely the subject.
//
// The names carry no `_bool` suffix as of 2026-08-17
// (docs/instance-resolved-key-design.md §6). They used to: an instance was
// keyed on its carrier head's *written* name, so `Le` here would have collided
// with `nat::Le` in the registry and this module paid a suffix to stay
// registrable. The key is a resolved declaration reference now, `nat::Le` and
// `bool::Le` are two carriers, and the suffix bought nothing — a module is
// already a namespace. A file that sees both writes `nat::Le` and `bool::Le`,
// which is what qualification is for.
fn leb(a: Bool) -> Bool -> Bool {
    match a { False => λ (b: Bool) => True, True => λ (b: Bool) => b }
}

theorem leb_refl(a: Bool): leb(a, a) = True {
    match a { False => refl, True => refl }
}

// Two constructors and no recursion, so all four cases are immediate: only
// `True <= False` is refuted. `logic::False` is the falsity and `bool::False`
// the constructor, one line apart and neither qualified
// (issues/false-collides-with-bools-constructor.md).
fn Le(a: Bool) -> Bool -> Type {
    match a {
        False => λ (b: Bool) => True,
        True => λ (b: Bool) => match b { False => False, True => True },
    }
}

designation <= at Bool := Le

theorem le_refl(a: Bool): a <= a {
    match a { False => trivial, True => trivial }
}

// A `fn`, not a `theorem`: a decision has to unfold in conversion
// (docs/nat-order-design.md §2).
fn le_dec(a, b: Bool) -> a <= b ∨ ¬ (a <= b) {
    match a as λ z => z <= b ∨ ¬ (z <= b) {
        False => Inl(trivial),
        True => match b as λ y => True <= y ∨ ¬ (True <= y) {
            False => Inr(λ (bad: True <= False) => bad),
            True => Inl(trivial),
        },
    }
}

// The order's `Decide` instance, generic in both operands — the same row
// `std/nat` and `std/int` carry at their own orders
// (docs/value-generic-instances-design.md). All three register: the key is
// (`logic::Decide`, `bool::Le`) here, `nat::Le` there, `int::Le` there.
instance(a, b: Bool) Decide<Le(a, b)> { dec := le_dec(a, b) }

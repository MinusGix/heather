// `bool` — the two-constructor tier-0 declaration, and the two monoid
// structures it carries.
//
// Moved out of `nat` (2026-08-05), where it lived because `leb` needed it.
// The module's own header asked for `not`/`and` and their laws; the traits
// adoption round (2026-08-07) is what finally wanted them, because `Bool` is
// the carrier that makes the "two structures on one carrier" story concrete:
// conjunction and disjunction are both monoids on it, and the algebra module
// registers exactly one of them (`std/algebra`, and its header for why).
//
// Every law here is a case split and nothing else: `match` on two Bools is
// four `refl`s. That is the point of proving them at this carrier — the
// generic consumers over in `algebra` are exercised at a carrier whose laws
// cost nothing, beside `Nat`, whose laws cost induction.

// `logic` for the connectives the propositional order below is stated with.
// It imports nothing, so this is a leaf-to-leaf edge and not a cycle.
import logic;

inductive Bool { False, True }

fn not(b: Bool) -> Bool { match b { False => True, True => False } }

fn and(a, b: Bool) -> Bool { match a { False => False, True => b } }

fn or(a, b: Bool) -> Bool { match a { False => b, True => True } }

// `and` is the conjunction monoid: unit `True`, and — because `and` recurses
// on its *first* argument — `and(True, x)` is `x` definitionally while
// `and(x, True) = x` is the case split.

theorem and_assoc(a, b, c: Bool): and(and(a, b), c) = and(a, and(b, c)) {
    match a { False => refl, True => refl }
}

theorem and_true_l(a: Bool): and(True, a) = a { refl }

theorem and_true_r(a: Bool): and(a, True) = a {
    match a { False => refl, True => refl }
}

theorem and_comm(a, b: Bool): and(a, b) = and(b, a) {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

// `or` is the disjunction monoid: unit `False`. Same shape, dual.

theorem or_assoc(a, b, c: Bool): or(or(a, b), c) = or(a, or(b, c)) {
    match a { False => refl, True => refl }
}

theorem or_false_l(a: Bool): or(False, a) = a { refl }

theorem or_false_r(a: Bool): or(a, False) = a {
    match a { False => refl, True => refl }
}

theorem or_comm(a, b: Bool): or(a, b) = or(b, a) {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

// The decided order on `Bool`. `False <= True` is the reading, so the relation
// is implication.
//
// `leb_bool` is the Bool-valued decision and `Le_bool` the PROPOSITION, in the
// shape `nat`'s order took on 2026-08-16 (docs/nat-order-design.md): the
// specification is a recursion into `Type` with no `= True` in it, and the
// decision procedure is a separate function nothing above mentions. This
// module needs both for the reason `nat` does — `Bool` is where Booleans are
// genuinely the subject.
fn leb_bool(a: Bool) -> Bool -> Bool {
    match a { False => λ (b: Bool) => True, True => λ (b: Bool) => b }
}

theorem leb_bool_refl(a: Bool): leb_bool(a)(a) = True {
    match a { False => refl, True => refl }
}

// Two constructors and no recursion, so all four cases are immediate: only
// `True <= False` is refuted. `logic::False` is the falsity and `bool::False`
// the constructor, one line apart and neither qualified
// (issues/false-collides-with-bools-constructor.md).
fn Le_bool(a: Bool) -> Bool -> Type {
    match a {
        False => λ (b: Bool) => True,
        True => λ (b: Bool) => match b { False => False, True => True },
    }
}

theorem le_bool_refl(a: Bool): Le_bool(a)(a) {
    match a { False => trivial, True => trivial }
}

// A `fn`, not a `theorem`: a decision has to unfold in conversion
// (docs/nat-order-design.md §2).
fn le_bool_dec(a, b: Bool) -> Or<Le_bool(a)(b), ¬ Le_bool(a)(b)> {
    match a as λ z => Or<Le_bool(z)(b), Not(Le_bool(z)(b))> {
        False => Inl(trivial),
        True => match b as λ y => Or<Le_bool(True)(y), Not(Le_bool(True)(y))> {
            False => Inr(λ (bad: Le_bool(True)(False)) => bad),
            True => Inl(trivial),
        },
    }
}

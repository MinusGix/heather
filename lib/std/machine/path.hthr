// Paths: the meaning of a live borrow (docs/language/ownership-design.md
// §10.4, §10.6). A path names a part of an owner, with a partial read and a
// partial write: a lens held as data, which `Location` (location.hthr) is
// where it is total. Reading through it is `p.get(owner)`, writing is
// `owner := p.set(owner, v)`.
//
// - `PathLaws` is the certification, as `LocationLaws` is for a location:
//   a write through a valid path is read back, writing back what was read
//   changes nothing, the second of two writes is what stays, and a write
//   through an invalid path changes nothing (so `set` is total and every
//   law holds at every owner, valid or not).
// - `Valid(owner)` is "the partial read answers" (`Path::Valid`), with a
//   decider (`valid_dec`). It is the obligation at each use of a path.
// - A location is a path that always answers (`Path::of_location`), and a
//   path that always answers is a location (`Path::location`), each with
//   its laws carried across.
// - Paths compose (`Path::then`): a part of a part, valid where both
//   steps are, with lawful steps composing to a lawful path.
// - `Apart(p, q)` is the partial `Disjoint`: each write leaves what the
//   other reads, and the writes commute. Two locations disjoint are apart
//   as paths (`Apart::of_disjoint`), and two total paths apart are
//   disjoint as locations (`Apart::disjoint`).
// - What an operation keeps: `p.Keeps(before, after)` says every value `p`
//   read in `before` it reads in `after`, so it keeps `p` valid
//   (`keeps_valid`). A write through a path apart keeps it (`Apart::keeps`).
//
// Paths into a list (an element, a window) and the decider that finds two
// of them apart from their spans are `list_path.hthr`; the word map's slot
// for a key is `word_map_paths.hthr`, the arena vector's elements
// `arena_paths.hthr`.

import logic;
import option;
import list;
import location;

// A part of an `S` that is a `V`, which may be absent: what it reads, and
// the owner with it written.
record Path<S, V> { get: S → Option<V>, set: S → V → S }

record PathLaws<S, V>(p: Path<S, V>) {
    set_get: (s: S) → (a, v: V) → p.get(s) = Some(a) → p.get(p.set(s, v)) = Some(v),
    get_set: (s: S) → (a: V) → p.get(s) = Some(a) → p.set(s, a) = s,
    set_set: (s: S) → (v, w: V) → p.set(p.set(s, v), w) = p.set(s, w),
    set_none: (s: S) → (v: V) → p.get(s) = None → p.set(s, v) = s,
}

// ---------------------------------------------------------------------------
// Validity

// The path is valid in `s`: its read answers.
fn Path::Valid<S, V>(self p: Path<S, V>, s: S) → Type { Exists<V>(λ a => p.get(s) = Some(a)) }

// The verdict, and that it decides `Valid` both ways.
fn Path::valid<S, V>(self p: Path<S, V>, s: S) → Bool { p.get(s).is_some() }

theorem Path::valid_of<S, V>(self p: Path<S, V>, s: S): (o: Option<V>) → p.get(s) = o → Or<p.Valid(s), ¬p.Valid(s)> {
    λ o => match o {
        Some(a) => λ e => Inl(Exists(a, e)),
        None => λ e => Inr(λ v => absurd(trans(sym(e), v.proof))),
    }
}

theorem Path::valid_dec<S, V>(self p: Path<S, V>, s: S): Or<p.Valid(s), ¬p.Valid(s)> { p.valid_of(s, p.get(s), refl) }

theorem Path::valid_sound_of<S, V>(self p: Path<S, V>, s: S): (o: Option<V>) → p.get(s) = o → o.is_some().IsTrue() → p.Valid(s) {
    λ o => match o {
        Some(a) => λ e _ => Exists(a, e),
        None => λ e no => false_elim(no),
    }
}

theorem Path::valid_sound<S, V>(self p: Path<S, V>, s: S, h: p.valid(s).IsTrue()): p.Valid(s) { p.valid_sound_of(s, p.get(s), refl, h) }

theorem Path::valid_complete<S, V>(self p: Path<S, V>, s: S, v: p.Valid(s)): p.valid(s).IsTrue() {
    j(sym(v.proof), λ o _ => o.is_some().IsTrue(), trivial)
}

// A path that is not valid reads nothing.
theorem Path::none_of_invalid<S, V>(self p: Path<S, V>, s: S): (o: Option<V>) → p.get(s) = o → ¬p.Valid(s) → p.get(s) = None {
    λ o => match o {
        Some(a) => λ e no => false_elim(no(Exists(a, e))),
        None => λ e _ => e,
    }
}

// The laws under validity: a valid path's write is read back and keeps it
// valid.
theorem PathLaws::valid_set<S, V>({p: Path<S, V>}, self laws: PathLaws<S, V>(p), s: S, v: V, valid: p.Valid(s)): p.Valid(p.set(s, v)) {
    Exists(v, laws.set_get(s, valid.witness, v, valid.proof))
}

// A write through an invalid path changes nothing.
theorem PathLaws::set_invalid<S, V>({p: Path<S, V>}, self laws: PathLaws<S, V>(p), s: S, v: V, invalid: ¬p.Valid(s)): p.set(s, v) = s {
    laws.set_none(s, v, p.none_of_invalid(s, p.get(s), refl, invalid))
}

// ---------------------------------------------------------------------------
// Locations: the paths that always answer

fn Path::of_location<S, A>(l: Location<S, A>) → Path<S, A> {
    Path<S, A>(get := λ (s: S) => Some(l.read(s)), set := l.write)
}

theorem Path::of_location_laws<S, A>(l: Location<S, A>, laws: LocationLaws<S, A>(l)): PathLaws<S, A>(Path::of_location(l)) {
    PathLaws(
        λ s a v _ => cong_fn(λ (x: A) => Some(x), laws.put_get(s, v)),
        λ s a h => trans(cong_fn(λ (x: A) => l.write(s, x), sym(Option::some_inj(l.read(s), a, h))), laws.get_put(s)),
        λ s v w => laws.put_put(s, v, w),
        λ s v h => absurd(h),
    )
}

theorem Path::of_location_valid<S, A>(l: Location<S, A>, s: S): Path::of_location(l).Valid(s) { Exists(l.read(s), refl) }

// Lawful locations compose to a lawful location: the composition of law
// records `location.hthr` leaves to this layer.
theorem compose_location_laws<S, A, B>(outer: Location<S, A>, inner: Location<A, B>, ol: LocationLaws<S, A>(outer), il: LocationLaws<A, B>(inner)):
    LocationLaws<S, B>(compose_location(outer, inner))
{
    LocationLaws(
        λ s => trans(cong_fn(λ (a: A) => outer.write(s, a), il.get_put(outer.read(s))), ol.get_put(s)),
        λ s b => trans(cong_fn(λ (a: A) => inner.read(a), ol.put_get(s, inner.write(outer.read(s), b))), il.put_get(outer.read(s), b)),
        λ s b1 b2 => {
            let a = outer.read(s);
            let s1 = outer.write(s, inner.write(a, b1));
            let read1: (outer.read(s1) = inner.write(a, b1)) = ol.put_get(s, inner.write(a, b1));
            trans(cong_fn(λ (x: A) => outer.write(s1, inner.write(x, b2)), read1),
                trans(cong_fn(λ (x: A) => outer.write(s1, x), il.put_put(a, b1, b2)), ol.put_put(s, inner.write(a, b1), inner.write(a, b2))))
        },
    )
}

// A path that answers at every owner, and what it answers.
record PathTotal<S, V>(p: Path<S, V>) { read: S → V, reads: (s: S) → p.get(s) = Some(read(s)) }

fn Path::location<S, V>(self p: Path<S, V>, total: PathTotal<S, V>(p)) → Location<S, V> {
    Location<S, V>(read := total.read, write := p.set)
}

theorem Path::location_laws<S, V>(self p: Path<S, V>, laws: PathLaws<S, V>(p), total: PathTotal<S, V>(p)): LocationLaws<S, V>(p.location(total)) {
    LocationLaws(
        λ s => laws.get_set(s, total.read(s), total.reads(s)),
        λ s v => Option::some_inj(total.read(p.set(s, v)), v,
            trans(sym(total.reads(p.set(s, v))), laws.set_get(s, total.read(s), v, total.reads(s)))),
        λ s v w => laws.set_set(s, v, w),
    )
}

fn Path::of_location_total<S, A>(l: Location<S, A>) → PathTotal<S, A>(Path::of_location(l)) {
    PathTotal(l.read, λ s => refl)
}

// ---------------------------------------------------------------------------
// Composition: a part of a part

// The write of `then`, at what the outer path read.
fn Path::then_set<S, A, B>(p: Path<S, A>, q: Path<A, B>, s: S, o: Option<A>, b: B) → S {
    match o { Some(a) => p.set(s, q.set(a, b)), None => s }
}

fn Path::then<S, A, B>(self p: Path<S, A>, q: Path<A, B>) → Path<S, B> {
    Path<S, B>(
        get := λ (s: S) => p.get(s).and_then(q.get),
        set := λ (s: S) => λ (b: B) => Path::then_set(p, q, s, p.get(s), b),
    )
}

// Through an outer part that reads `a`, the composed path is the inner one
// at `a`.
theorem Path::then_get_at<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S, a: A, at: p.get(s) = Some(a)):
    p.then(q).get(s) = q.get(a)
{
    cong_fn(λ (o: Option<A>) => o.and_then(q.get), at)
}

theorem Path::then_set_at<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S, a: A, at: p.get(s) = Some(a), b: B):
    p.then(q).set(s, b) = p.set(s, q.set(a, b))
{
    cong_fn(λ (o: Option<A>) => Path::then_set(p, q, s, o, b), at)
}

theorem Path::then_get_none<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S, none: p.get(s) = None): p.then(q).get(s) = None {
    cong_fn(λ (o: Option<A>) => o.and_then(q.get), none)
}

theorem Path::then_set_none<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S, none: p.get(s) = None, b: B): p.then(q).set(s, b) = s {
    cong_fn(λ (o: Option<A>) => Path::then_set(p, q, s, o, b), none)
}

// The composed path is valid exactly where both steps are.
theorem Path::then_valid<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S, a: A, at: p.get(s) = Some(a), inner: q.Valid(a)): p.then(q).Valid(s) {
    Exists(inner.witness, trans(p.then_get_at(q, s, a, at), inner.proof))
}

theorem Path::then_valid_outer<S, A, B>(self p: Path<S, A>, q: Path<A, B>, s: S): (o: Option<A>) → p.get(s) = o → p.then(q).Valid(s) → p.Valid(s) {
    λ o => match o {
        Some(a) => λ e _ => Exists(a, e),
        None => λ e v => absurd(trans(sym(p.then_get_none(q, s, e)), v.proof)),
    }
}

// The laws, case by case on what the outer path reads.
theorem Path::then_set_get_of<S, A, B>(self p: Path<S, A>, q: Path<A, B>, pl: PathLaws<S, A>(p), ql: PathLaws<A, B>(q), s: S, c, b: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = Some(c) → p.then(q).get(p.then(q).set(s, b)) = Some(b)
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = Some(c)) = trans(sym(p.then_get_at(q, s, a, e)), h);
            let after: (p.get(p.set(s, q.set(a, b))) = Some(q.set(a, b))) = pl.set_get(s, a, q.set(a, b), e);
            let written: (p.then(q).set(s, b) = p.set(s, q.set(a, b))) = p.then_set_at(q, s, a, e, b);
            j(sym(written), λ t _ => p.then(q).get(t) = Some(b),
                trans(p.then_get_at(q, p.set(s, q.set(a, b)), q.set(a, b), after), ql.set_get(a, c, b, inner)))
        },
        None => λ e h => absurd(trans(sym(p.then_get_none(q, s, e)), h)),
    }
}

theorem Path::then_get_set_of<S, A, B>(self p: Path<S, A>, q: Path<A, B>, pl: PathLaws<S, A>(p), ql: PathLaws<A, B>(q), s: S, c: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = Some(c) → p.then(q).set(s, c) = s
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = Some(c)) = trans(sym(p.then_get_at(q, s, a, e)), h);
            trans(p.then_set_at(q, s, a, e, c), trans(cong_fn(λ (x: A) => p.set(s, x), ql.get_set(a, c, inner)), pl.get_set(s, a, e)))
        },
        None => λ e h => absurd(trans(sym(p.then_get_none(q, s, e)), h)),
    }
}

theorem Path::then_set_set_of<S, A, B>(self p: Path<S, A>, q: Path<A, B>, pl: PathLaws<S, A>(p), ql: PathLaws<A, B>(q), s: S, v, w: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(p.then(q).set(s, v), w) = p.then(q).set(s, w)
{
    λ o => match o {
        Some(a) => λ e => {
            let s1 = p.set(s, q.set(a, v));
            let first: (p.then(q).set(s, v) = s1) = p.then_set_at(q, s, a, e, v);
            let read1: (p.get(s1) = Some(q.set(a, v))) = pl.set_get(s, a, q.set(a, v), e);
            let second: (p.then(q).set(s1, w) = p.set(s1, q.set(q.set(a, v), w))) = p.then_set_at(q, s1, q.set(a, v), read1, w);
            let inner: (p.set(s1, q.set(q.set(a, v), w)) = p.set(s1, q.set(a, w))) = cong_fn(λ (x: A) => p.set(s1, x), ql.set_set(a, v, w));
            let outer: (p.set(s1, q.set(a, w)) = p.set(s, q.set(a, w))) = pl.set_set(s, q.set(a, v), q.set(a, w));
            trans(cong_fn(λ (t: S) => p.then(q).set(t, w), first),
                trans(second, trans(inner, trans(outer, sym(p.then_set_at(q, s, a, e, w))))))
        },
        None => λ e => {
            let first: (p.then(q).set(s, v) = s) = p.then_set_none(q, s, e, v);
            cong_fn(λ (t: S) => p.then(q).set(t, w), first)
        },
    }
}

theorem Path::then_set_none_of<S, A, B>(self p: Path<S, A>, q: Path<A, B>, pl: PathLaws<S, A>(p), ql: PathLaws<A, B>(q), s: S, v: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = None → p.then(q).set(s, v) = s
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = None) = trans(sym(p.then_get_at(q, s, a, e)), h);
            trans(p.then_set_at(q, s, a, e, v), trans(cong_fn(λ (x: A) => p.set(s, x), ql.set_none(a, v, inner)), pl.get_set(s, a, e)))
        },
        None => λ e h => p.then_set_none(q, s, e, v),
    }
}

// Lawful steps compose to a lawful path.
theorem Path::then_laws<S, A, B>(self p: Path<S, A>, q: Path<A, B>, pl: PathLaws<S, A>(p), ql: PathLaws<A, B>(q)): PathLaws<S, B>(p.then(q)) {
    PathLaws(
        λ s c b h => p.then_set_get_of(q, pl, ql, s, c, b, p.get(s), refl, h),
        λ s c h => p.then_get_set_of(q, pl, ql, s, c, p.get(s), refl, h),
        λ s v w => p.then_set_set_of(q, pl, ql, s, v, w, p.get(s), refl),
        λ s v h => p.then_set_none_of(q, pl, ql, s, v, p.get(s), refl, h),
    )
}

// A location after a location is the composed location (`compose_location`)
// read as a path.
theorem Path::then_of_location_get<S, A, B>(outer: Location<S, A>, inner: Location<A, B>, s: S):
    Path::of_location(outer).then(Path::of_location(inner)).get(s) = Path::of_location(compose_location(outer, inner)).get(s)
{ refl }

theorem Path::then_of_location_set<S, A, B>(outer: Location<S, A>, inner: Location<A, B>, s: S, b: B):
    Path::of_location(outer).then(Path::of_location(inner)).set(s, b) = Path::of_location(compose_location(outer, inner)).set(s, b)
{ refl }

// ---------------------------------------------------------------------------
// Apart: two paths whose writes do not meet

// Each write leaves what the other reads, and the two writes commute: the
// partial `Disjoint`.
record Apart<S, A, B>(left: Path<S, A>, right: Path<S, B>) {
    left_after_right: (s: S) → (v: B) → left.get(right.set(s, v)) = left.get(s),
    right_after_left: (s: S) → (v: A) → right.get(left.set(s, v)) = right.get(s),
    writes_commute: (s: S) → (a: A) → (b: B) → left.set(right.set(s, b), a) = right.set(left.set(s, a), b),
}

theorem Apart::symm<S, A, B>({p: Path<S, A>}, {q: Path<S, B>}, self apart: Apart<S, A, B>(p, q)): Apart<S, B, A>(q, p) {
    Apart(
        apart.right_after_left,
        apart.left_after_right,
        λ s b a => sym(apart.writes_commute(s, a, b)),
    )
}

// Two disjoint locations are apart as paths.
theorem Apart::of_disjoint<S, A, B>(l: Location<S, A>, r: Location<S, B>, d: Disjoint<S, A, B>(l, r)):
    Apart<S, A, B>(Path::of_location(l), Path::of_location(r))
{
    Apart(
        λ s v => cong_fn(λ (x: A) => Some(x), d.left_after_right(s, v)),
        λ s v => cong_fn(λ (x: B) => Some(x), d.right_after_left(s, v)),
        d.writes_commute,
    )
}

// Two total paths apart are disjoint as locations.
theorem Apart::disjoint<S, A, B>({p: Path<S, A>}, {q: Path<S, B>}, self apart: Apart<S, A, B>(p, q), tp: PathTotal<S, A>(p), tq: PathTotal<S, B>(q)):
    Disjoint<S, A, B>(p.location(tp), q.location(tq))
{
    Disjoint(
        λ s v => Option::some_inj(tp.read(q.set(s, v)), tp.read(s),
            trans(sym(tp.reads(q.set(s, v))), trans(apart.left_after_right(s, v), tp.reads(s)))),
        λ s v => Option::some_inj(tq.read(p.set(s, v)), tq.read(s),
            trans(sym(tq.reads(p.set(s, v))), trans(apart.right_after_left(s, v), tq.reads(s)))),
        apart.writes_commute,
    )
}

// Apart paths' writes in either order give one owner, which reads back both
// values where both paths were valid.
theorem Apart::both_read<S, A, B>({p: Path<S, A>}, {q: Path<S, B>}, self apart: Apart<S, A, B>(p, q),
    pl: PathLaws<S, A>(p), ql: PathLaws<S, B>(q), s: S, vp: p.Valid(s), vq: q.Valid(s), a: A, b: B):
    And<p.get(q.set(p.set(s, a), b)) = Some(a), q.get(q.set(p.set(s, a), b)) = Some(b)>
{
    let s1 = p.set(s, a);
    let read_p: (p.get(s1) = Some(a)) = pl.set_get(s, vp.witness, a, vp.proof);
    let still_q: (q.get(s1) = Some(vq.witness)) = trans(apart.right_after_left(s, a), vq.proof);
    And(trans(apart.left_after_right(s1, b), read_p), ql.set_get(s1, vq.witness, b, still_q))
}

// Two parts apart inside one part are apart in the owner: two fields of one
// element, a field of a field beside another.
theorem Apart::under_read<S, A, B, C>(p: Path<S, A>, pl: PathLaws<S, A>(p), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r), s: S, v: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(p.then(r).set(s, v)) = p.then(q).get(s)
{
    λ o => match o {
        Some(a) => λ e => {
            let written: (p.then(r).set(s, v) = p.set(s, r.set(a, v))) = p.then_set_at(r, s, a, e, v);
            let read: (p.get(p.set(s, r.set(a, v))) = Some(r.set(a, v))) = pl.set_get(s, a, r.set(a, v), e);
            trans(cong_fn(λ (t: S) => p.then(q).get(t), written),
                trans(p.then_get_at(q, p.set(s, r.set(a, v)), r.set(a, v), read), trans(inner.left_after_right(a, v), sym(p.then_get_at(q, s, a, e)))))
        },
        None => λ e => cong_fn(λ (t: S) => p.then(q).get(t), p.then_set_none(r, s, e, v)),
    }
}

theorem Apart::under_commute<S, A, B, C>(p: Path<S, A>, pl: PathLaws<S, A>(p), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r), s: S, b: B, c: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(p.then(r).set(s, c), b) = p.then(r).set(p.then(q).set(s, b), c)
{
    λ o => match o {
        Some(a) => λ e => {
            let sr = p.set(s, r.set(a, c));
            let sq = p.set(s, q.set(a, b));
            let read_r: (p.get(sr) = Some(r.set(a, c))) = pl.set_get(s, a, r.set(a, c), e);
            let read_q: (p.get(sq) = Some(q.set(a, b))) = pl.set_get(s, a, q.set(a, b), e);
            let left: (p.then(q).set(p.then(r).set(s, c), b) = p.set(s, q.set(r.set(a, c), b))) =
                trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_at(r, s, a, e, c)),
                    trans(p.then_set_at(q, sr, r.set(a, c), read_r, b), pl.set_set(s, r.set(a, c), q.set(r.set(a, c), b))));
            let right: (p.then(r).set(p.then(q).set(s, b), c) = p.set(s, r.set(q.set(a, b), c))) =
                trans(cong_fn(λ (t: S) => p.then(r).set(t, c), p.then_set_at(q, s, a, e, b)),
                    trans(p.then_set_at(r, sq, q.set(a, b), read_q, c), pl.set_set(s, q.set(a, b), r.set(q.set(a, b), c))));
            trans(left, trans(cong_fn(λ (x: A) => p.set(s, x), inner.writes_commute(a, b, c)), sym(right)))
        },
        None => λ e => trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_none(r, s, e, c)),
            trans(p.then_set_none(q, s, e, b), trans(sym(p.then_set_none(r, s, e, c)), cong_fn(λ (t: S) => p.then(r).set(t, c), sym(p.then_set_none(q, s, e, b)))))),
    }
}

theorem Apart::under<S, A, B, C>(p: Path<S, A>, pl: PathLaws<S, A>(p), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r)):
    Apart<S, B, C>(p.then(q), p.then(r))
{
    Apart(
        λ s v => Apart::under_read(p, pl, inner, s, v, p.get(s), refl),
        λ s v => Apart::under_read(p, pl, Apart::symm(inner), s, v, p.get(s), refl),
        λ s b c => Apart::under_commute(p, pl, inner, s, b, c, p.get(s), refl),
    )
}

// ---------------------------------------------------------------------------
// What an operation keeps

// `after` keeps the path `p` of `before`: every value `p` reads in `before`
// it reads in `after`.
fn Path::Keeps<S, V>(self p: Path<S, V>, before, after: S) → Type { (a: V) → p.get(before) = Some(a) → p.get(after) = Some(a) }

// What keeps a path keeps it valid.
theorem Path::keeps_valid<S, V>(self p: Path<S, V>, before, after: S, keeps: p.Keeps(before, after), valid: p.Valid(before)): p.Valid(after) {
    Exists(valid.witness, keeps(valid.witness, valid.proof))
}

theorem Path::keeps_refl<S, V>(self p: Path<S, V>, s: S): p.Keeps(s, s) { λ a h => h }

theorem Path::keeps_trans<S, V>(self p: Path<S, V>, s, t, u: S, st: p.Keeps(s, t), tu: p.Keeps(t, u)): p.Keeps(s, u) {
    λ a h => tu(a, st(a, h))
}

// An owner that reads alike through the path keeps it.
theorem Path::keeps_of_get<S, V>(self p: Path<S, V>, before, after: S, same: p.get(after) = p.get(before)): p.Keeps(before, after) {
    λ a h => trans(same, h)
}

// A write through a path apart keeps it.
theorem Apart::keeps<S, A, B>({p: Path<S, A>}, {q: Path<S, B>}, self apart: Apart<S, A, B>(p, q), s: S, v: B): p.Keeps(s, q.set(s, v)) {
    p.keeps_of_get(s, q.set(s, v), apart.left_after_right(s, v))
}

// A path that is not kept valid is not kept.
theorem Path::not_keeps<S, V>(self p: Path<S, V>, before, after: S, valid: p.Valid(before), lost: ¬p.Valid(after)): ¬p.Keeps(before, after) {
    λ keeps => lost(p.keeps_valid(before, after, keeps, valid))
}

// ---------------------------------------------------------------------------
// Two spellings of one path

// `p` and `q` read and write alike at every owner: one path, spelled twice
// (a composition regrouped, a step written through a guard). Laws,
// validity, `Apart` and footprints carry across it (`PathLaws::respects`,
// `Path::valid_respects`, `Apart::respects`); it is an equivalence
// (`PathSame::same`, `symm`, `then`).
record PathSame<S, V>(p, q: Path<S, V>) {
    gets: (s: S) → p.get(s) = q.get(s),
    sets: (s: S) → (v: V) → p.set(s, v) = q.set(s, v),
}

theorem PathSame::same<S, V>(p: Path<S, V>): PathSame<S, V>(p, p) { PathSame(λ s => refl, λ s v => refl) }

theorem PathSame::symm<S, V>({p, q: Path<S, V>}, self e: PathSame<S, V>(p, q)): PathSame<S, V>(q, p) {
    PathSame(λ s => sym(e.gets(s)), λ s v => sym(e.sets(s, v)))
}

theorem PathSame::then<S, V>({p, q, r: Path<S, V>}, self e: PathSame<S, V>(p, q), f: PathSame<S, V>(q, r)): PathSame<S, V>(p, r) {
    PathSame(λ s => trans(e.gets(s), f.gets(s)), λ s v => trans(e.sets(s, v), f.sets(s, v)))
}

theorem PathLaws::respects<S, V>({p, q: Path<S, V>}, self laws: PathLaws<S, V>(p), e: PathSame<S, V>(p, q)): PathLaws<S, V>(q) {
    PathLaws(
        λ s a v h => trans(sym(cong_fn(λ (t: S) => q.get(t), e.sets(s, v))),
            trans(sym(e.gets(p.set(s, v))), laws.set_get(s, a, v, trans(e.gets(s), h)))),
        λ s a h => trans(sym(e.sets(s, a)), laws.get_set(s, a, trans(e.gets(s), h))),
        λ s v w => trans(sym(cong_fn(λ (t: S) => q.set(t, w), e.sets(s, v))),
            trans(sym(e.sets(p.set(s, v), w)), trans(laws.set_set(s, v, w), e.sets(s, w)))),
        λ s v h => trans(sym(e.sets(s, v)), laws.set_none(s, v, trans(e.gets(s), h))),
    )
}

theorem Path::valid_respects<S, V>({p, q: Path<S, V>}, e: PathSame<S, V>(p, q), s: S, valid: p.Valid(s)): q.Valid(s) {
    Exists(valid.witness, trans(sym(e.gets(s)), valid.proof))
}

// `Apart` is a fact about what the paths do, so it holds of any spelling.
theorem Apart::respects<S, A, B>({p, p2: Path<S, A>}, {q, q2: Path<S, B>}, self apart: Apart<S, A, B>(p, q),
    ep: PathSame<S, A>(p, p2), eq: PathSame<S, B>(q, q2)): Apart<S, A, B>(p2, q2)
{
    Apart(
        λ s v => trans(sym(ep.gets(q2.set(s, v))),
            trans(cong_fn(λ (t: S) => p.get(t), sym(eq.sets(s, v))), trans(apart.left_after_right(s, v), ep.gets(s)))),
        λ s v => trans(sym(eq.gets(p2.set(s, v))),
            trans(cong_fn(λ (t: S) => q.get(t), sym(ep.sets(s, v))), trans(apart.right_after_left(s, v), eq.gets(s)))),
        λ s a b => {
            let left: (p2.set(q2.set(s, b), a) = p.set(q.set(s, b), a)) =
                trans(cong_fn(λ (t: S) => p2.set(t, a), sym(eq.sets(s, b))), sym(ep.sets(q.set(s, b), a)));
            let right: (q2.set(p2.set(s, a), b) = q.set(p.set(s, a), b)) =
                trans(cong_fn(λ (t: S) => q2.set(t, b), sym(ep.sets(s, a))), sym(eq.sets(p.set(s, a), b)));
            trans(left, trans(apart.writes_commute(s, a, b), sym(right)))
        },
    )
}

// ---------------------------------------------------------------------------
// Parts of parts apart

// Under two parts apart, any parts are apart: a field of what one key
// names beside a field of what another names, an element of one window
// beside an element of another. (`Apart::under` is the other half: two
// parts apart inside one part.) Nothing about the steps' laws is used.
theorem Apart::then_read<S, A, B, C, D>({p: Path<S, A>}, {q: Path<S, B>}, apart: Apart<S, A, B>(p, q), r: Path<A, C>, t: Path<B, D>, s: S, v: D):
    (o: Option<B>) → q.get(s) = o → p.then(r).get(q.then(t).set(s, v)) = p.then(r).get(s)
{
    λ o => match o {
        Some(b) => λ e => trans(cong_fn(λ (u: S) => p.then(r).get(u), q.then_set_at(t, s, b, e, v)),
            cong_fn(λ (x: Option<A>) => x.and_then(r.get), apart.left_after_right(s, t.set(b, v)))),
        None => λ e => cong_fn(λ (u: S) => p.then(r).get(u), q.then_set_none(t, s, e, v)),
    }
}

theorem Apart::then_commute<S, A, B, C, D>({p: Path<S, A>}, {q: Path<S, B>}, apart: Apart<S, A, B>(p, q), r: Path<A, C>, t: Path<B, D>, s: S, c: C, d: D):
    (op: Option<A>) → p.get(s) = op → (oq: Option<B>) → q.get(s) = oq →
    p.then(r).set(q.then(t).set(s, d), c) = q.then(t).set(p.then(r).set(s, c), d)
{
    λ op => match op {
        Some(x) => λ ep oq => match oq {
            Some(y) => λ eq => {
                let s1 = q.set(s, t.set(y, d));
                let s2 = p.set(s, r.set(x, c));
                let p1: (p.get(s1) = Some(x)) = trans(apart.left_after_right(s, t.set(y, d)), ep);
                let q2: (q.get(s2) = Some(y)) = trans(apart.right_after_left(s, r.set(x, c)), eq);
                let left: (p.then(r).set(q.then(t).set(s, d), c) = p.set(s1, r.set(x, c))) =
                    trans(cong_fn(λ (u: S) => p.then(r).set(u, c), q.then_set_at(t, s, y, eq, d)), p.then_set_at(r, s1, x, p1, c));
                let right: (q.then(t).set(p.then(r).set(s, c), d) = q.set(s2, t.set(y, d))) =
                    trans(cong_fn(λ (u: S) => q.then(t).set(u, d), p.then_set_at(r, s, x, ep, c)), q.then_set_at(t, s2, y, q2, d));
                trans(left, trans(apart.writes_commute(s, r.set(x, c), t.set(y, d)), sym(right)))
            },
            None => λ eq => {
                let s2 = p.set(s, r.set(x, c));
                let q2: (q.get(s2) = None) = trans(apart.right_after_left(s, r.set(x, c)), eq);
                let left: (p.then(r).set(q.then(t).set(s, d), c) = s2) =
                    trans(cong_fn(λ (u: S) => p.then(r).set(u, c), q.then_set_none(t, s, eq, d)), p.then_set_at(r, s, x, ep, c));
                let right: (q.then(t).set(p.then(r).set(s, c), d) = s2) =
                    trans(cong_fn(λ (u: S) => q.then(t).set(u, d), p.then_set_at(r, s, x, ep, c)), q.then_set_none(t, s2, q2, d));
                trans(left, sym(right))
            },
        },
        None => λ ep oq => match oq {
            Some(y) => λ eq => {
                let s1 = q.set(s, t.set(y, d));
                let p1: (p.get(s1) = None) = trans(apart.left_after_right(s, t.set(y, d)), ep);
                let left: (p.then(r).set(q.then(t).set(s, d), c) = s1) =
                    trans(cong_fn(λ (u: S) => p.then(r).set(u, c), q.then_set_at(t, s, y, eq, d)), p.then_set_none(r, s1, p1, c));
                let right: (q.then(t).set(p.then(r).set(s, c), d) = s1) =
                    trans(cong_fn(λ (u: S) => q.then(t).set(u, d), p.then_set_none(r, s, ep, c)), q.then_set_at(t, s, y, eq, d));
                trans(left, sym(right))
            },
            None => λ eq => trans(cong_fn(λ (u: S) => p.then(r).set(u, c), q.then_set_none(t, s, eq, d)),
                trans(p.then_set_none(r, s, ep, c), sym(trans(cong_fn(λ (u: S) => q.then(t).set(u, d), p.then_set_none(r, s, ep, c)), q.then_set_none(t, s, eq, d))))),
        },
    }
}

theorem Apart::then_both<S, A, B, C, D>({p: Path<S, A>}, {q: Path<S, B>}, self apart: Apart<S, A, B>(p, q), r: Path<A, C>, t: Path<B, D>):
    Apart<S, C, D>(p.then(r), q.then(t))
{
    Apart(
        λ s v => Apart::then_read(apart, r, t, s, v, q.get(s), refl),
        λ s v => Apart::then_read(Apart::symm(apart), t, r, s, v, p.get(s), refl),
        λ s c d => Apart::then_commute(apart, r, t, s, c, d, p.get(s), refl, q.get(s), refl),
    )
}

// ---------------------------------------------------------------------------
// Regrouping a composition

theorem Path::then_assoc_get<S, A, B, C>(p: Path<S, A>, q: Path<A, B>, r: Path<B, C>, s: S):
    (o: Option<A>) → p.get(s) = o → p.then(q).then(r).get(s) = p.then(q.then(r)).get(s)
{
    λ o => match o {
        Some(_) => λ e => trans(cong_fn(λ (x: Option<A>) => x.and_then(q.get).and_then(r.get), e), sym(cong_fn(λ (x: Option<A>) => x.and_then(q.then(r).get), e))),
        None => λ e => trans(cong_fn(λ (x: Option<A>) => x.and_then(q.get).and_then(r.get), e), sym(cong_fn(λ (x: Option<A>) => x.and_then(q.then(r).get), e))),
    }
}

theorem Path::then_assoc_set<S, A, B, C>(p: Path<S, A>, q: Path<A, B>, r: Path<B, C>, pl: PathLaws<S, A>(p), s: S, c: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).then(r).set(s, c) = p.then(q.then(r)).set(s, c)
{
    λ o => match o {
        Some(a) => λ e => {
            let right: (p.then(q.then(r)).set(s, c) = p.set(s, q.then(r).set(a, c))) = p.then_set_at(q.then(r), s, a, e, c);
            match ob: q.get(a) {
                Some(b) => {
                    let mid: (p.then(q).get(s) = Some(b)) = trans(p.then_get_at(q, s, a, e), ob);
                    trans(p.then(q).then_set_at(r, s, b, mid, c), trans(p.then_set_at(q, s, a, e, r.set(b, c)),
                        trans(cong_fn(λ (x: A) => p.set(s, x), sym(q.then_set_at(r, a, b, ob, c))), sym(right))))
                },
                None => {
                    let mid: (p.then(q).get(s) = None) = trans(p.then_get_at(q, s, a, e), ob);
                    trans(p.then(q).then_set_none(r, s, mid, c), trans(sym(pl.get_set(s, a, e)),
                        trans(cong_fn(λ (x: A) => p.set(s, x), sym(q.then_set_none(r, a, ob, c))), sym(right))))
                },
            }
        },
        None => λ e => trans(p.then(q).then_set_none(r, s, p.then_get_none(q, s, e), c), sym(p.then_set_none(q.then(r), s, e, c))),
    }
}

// A part of a part of a part is one path, however it is grouped (where the
// outer step writes back what it read unchanged).
theorem Path::then_assoc<S, A, B, C>(p: Path<S, A>, q: Path<A, B>, r: Path<B, C>, pl: PathLaws<S, A>(p)):
    PathSame<S, C>(p.then(q).then(r), p.then(q.then(r)))
{
    PathSame(λ s => Path::then_assoc_get(p, q, r, s, p.get(s), refl), λ s c => Path::then_assoc_set(p, q, r, pl, s, c, p.get(s), refl))
}

// ---------------------------------------------------------------------------
// A path behind a test

// The read and the write where the test `c` passes, nothing where it fails.
fn Path::gate_get<V>(c: Bool, o: Option<V>) → Option<V> { match c { True => o, False => None } }

fn Path::gate_set<S>(c: Bool, s, t: S) → S { match c { True => t, False => s } }

// `p` where `ok` holds of the owner: a handle's path behind the check that
// its key still names it.
fn Path::guard<S, V>(ok: S → Bool, p: Path<S, V>) → Path<S, V> {
    Path<S, V>(get := λ (s: S) => Path::gate_get(ok(s), p.get(s)), set := λ (s: S) => λ (v: V) => Path::gate_set(ok(s), s, p.set(s, v)))
}

// A write through `q` does not change the test.
fn Path::Stable<S, W>(ok: S → Bool, q: Path<S, W>) → Type { (s: S) → (w: W) → ok(q.set(s, w)) = ok(s) }

theorem Path::guard_get_on<S, V>(ok: S → Bool, p: Path<S, V>, s: S, on: ok(s) = True): Path::guard(ok, p).get(s) = p.get(s) {
    cong_fn(λ (c: Bool) => Path::gate_get(c, p.get(s)), on)
}

theorem Path::guard_set_on<S, V>(ok: S → Bool, p: Path<S, V>, s: S, on: ok(s) = True, v: V): Path::guard(ok, p).set(s, v) = p.set(s, v) {
    cong_fn(λ (c: Bool) => Path::gate_set(c, s, p.set(s, v)), on)
}

theorem Path::guard_get_off<S, V>(ok: S → Bool, p: Path<S, V>, s: S, off: ok(s) = False): Path::guard(ok, p).get(s) = None {
    cong_fn(λ (c: Bool) => Path::gate_get(c, p.get(s)), off)
}

theorem Path::guard_set_off<S, V>(ok: S → Bool, p: Path<S, V>, s: S, off: ok(s) = False, v: V): Path::guard(ok, p).set(s, v) = s {
    cong_fn(λ (c: Bool) => Path::gate_set(c, s, p.set(s, v)), off)
}

// A guarded read that answers passed its test.
theorem Path::guard_on_of<S, V>(ok: S → Bool, p: Path<S, V>, s: S, a: V): (c: Bool) → ok(s) = c → Path::guard(ok, p).get(s) = Some(a) → ok(s) = True {
    λ c => match c {
        True => λ e _ => e,
        False => λ e h => absurd(trans(sym(Path::guard_get_off(ok, p, s, e)), h)),
    }
}

theorem Path::guard_set_set_of<S, V>(ok: S → Bool, p: Path<S, V>, pl: PathLaws<S, V>(p), stable: Path::Stable(ok, p), s: S, v, w: V):
    (c: Bool) → ok(s) = c → Path::guard(ok, p).set(Path::guard(ok, p).set(s, v), w) = Path::guard(ok, p).set(s, w)
{
    λ c => match c {
        True => λ on => trans(cong_fn(λ (t: S) => Path::guard(ok, p).set(t, w), Path::guard_set_on(ok, p, s, on, v)),
            trans(Path::guard_set_on(ok, p, p.set(s, v), trans(stable(s, v), on), w), trans(pl.set_set(s, v, w), sym(Path::guard_set_on(ok, p, s, on, w))))),
        False => λ off => cong_fn(λ (t: S) => Path::guard(ok, p).set(t, w), Path::guard_set_off(ok, p, s, off, v)),
    }
}

theorem Path::guard_set_none_of<S, V>(ok: S → Bool, p: Path<S, V>, pl: PathLaws<S, V>(p), s: S, v: V):
    (c: Bool) → ok(s) = c → Path::guard(ok, p).get(s) = None → Path::guard(ok, p).set(s, v) = s
{
    λ c => match c {
        True => λ on h => trans(Path::guard_set_on(ok, p, s, on, v), pl.set_none(s, v, trans(sym(Path::guard_get_on(ok, p, s, on)), h))),
        False => λ off h => Path::guard_set_off(ok, p, s, off, v),
    }
}

theorem Path::guard_laws<S, V>(ok: S → Bool, p: Path<S, V>, pl: PathLaws<S, V>(p), stable: Path::Stable(ok, p)): PathLaws<S, V>(Path::guard(ok, p)) {
    PathLaws(
        λ s a v h => {
            let on: (ok(s) = True) = Path::guard_on_of(ok, p, s, a, ok(s), refl, h);
            trans(cong_fn(λ (t: S) => Path::guard(ok, p).get(t), Path::guard_set_on(ok, p, s, on, v)),
                trans(Path::guard_get_on(ok, p, p.set(s, v), trans(stable(s, v), on)), pl.set_get(s, a, v, trans(sym(Path::guard_get_on(ok, p, s, on)), h))))
        },
        λ s a h => {
            let on: (ok(s) = True) = Path::guard_on_of(ok, p, s, a, ok(s), refl, h);
            trans(Path::guard_set_on(ok, p, s, on, a), pl.get_set(s, a, trans(sym(Path::guard_get_on(ok, p, s, on)), h)))
        },
        λ s v w => Path::guard_set_set_of(ok, p, pl, stable, s, v, w, ok(s), refl),
        λ s v h => Path::guard_set_none_of(ok, p, pl, s, v, ok(s), refl, h),
    )
}

// Valid behind the test: the test passes and the path is valid.
theorem Path::guard_valid<S, V>(ok: S → Bool, p: Path<S, V>, s: S, on: ok(s) = True, valid: p.Valid(s)): Path::guard(ok, p).Valid(s) {
    Exists(valid.witness, trans(Path::guard_get_on(ok, p, s, on), valid.proof))
}

theorem Path::guard_valid_on<S, V>(ok: S → Bool, p: Path<S, V>, s: S, valid: Path::guard(ok, p).Valid(s)): ok(s) = True {
    Path::guard_on_of(ok, p, s, valid.witness, ok(s), refl, valid.proof)
}

theorem Path::guard_valid_inner<S, V>(ok: S → Bool, p: Path<S, V>, s: S, valid: Path::guard(ok, p).Valid(s)): p.Valid(s) {
    Exists(valid.witness, trans(sym(Path::guard_get_on(ok, p, s, Path::guard_valid_on(ok, p, s, valid))), valid.proof))
}

// A composition after a guard is the guarded composition.
theorem Path::guard_then_get<S, A, B>(ok: S → Bool, p: Path<S, A>, q: Path<A, B>, s: S):
    (c: Bool) → ok(s) = c → Path::guard(ok, p).then(q).get(s) = Path::guard(ok, p.then(q)).get(s)
{
    λ c => match c {
        True => λ on => trans(cong_fn(λ (o: Option<A>) => o.and_then(q.get), Path::guard_get_on(ok, p, s, on)), sym(Path::guard_get_on(ok, p.then(q), s, on))),
        False => λ off => trans(cong_fn(λ (o: Option<A>) => o.and_then(q.get), Path::guard_get_off(ok, p, s, off)), sym(Path::guard_get_off(ok, p.then(q), s, off))),
    }
}

theorem Path::guard_then_set_on<S, A, B>(ok: S → Bool, p: Path<S, A>, q: Path<A, B>, s: S, b: B, on: ok(s) = True):
    (o: Option<A>) → p.get(s) = o → Path::guard(ok, p).then(q).set(s, b) = Path::guard(ok, p.then(q)).set(s, b)
{
    λ o => match o {
        Some(a) => λ oa => trans(Path::guard(ok, p).then_set_at(q, s, a, trans(Path::guard_get_on(ok, p, s, on), oa), b),
            trans(Path::guard_set_on(ok, p, s, on, q.set(a, b)), trans(sym(p.then_set_at(q, s, a, oa, b)), sym(Path::guard_set_on(ok, p.then(q), s, on, b))))),
        None => λ oa => trans(Path::guard(ok, p).then_set_none(q, s, trans(Path::guard_get_on(ok, p, s, on), oa), b),
            trans(sym(p.then_set_none(q, s, oa, b)), sym(Path::guard_set_on(ok, p.then(q), s, on, b)))),
    }
}

theorem Path::guard_then_set<S, A, B>(ok: S → Bool, p: Path<S, A>, q: Path<A, B>, s: S, b: B):
    (c: Bool) → ok(s) = c → Path::guard(ok, p).then(q).set(s, b) = Path::guard(ok, p.then(q)).set(s, b)
{
    λ c => match c {
        True => λ on => Path::guard_then_set_on(ok, p, q, s, b, on, p.get(s), refl),
        False => λ off => trans(Path::guard(ok, p).then_set_none(q, s, Path::guard_get_off(ok, p, s, off), b), sym(Path::guard_set_off(ok, p.then(q), s, off, b))),
    }
}

theorem Path::guard_then<S, A, B>(ok: S → Bool, p: Path<S, A>, q: Path<A, B>): PathSame<S, B>(Path::guard(ok, p).then(q), Path::guard(ok, p.then(q))) {
    PathSame(λ s => Path::guard_then_get(ok, p, q, s, ok(s), refl), λ s b => Path::guard_then_set(ok, p, q, s, b, ok(s), refl))
}

// Two guarded paths are apart where the paths are and neither one's write
// changes the other's test.
theorem Path::guard_read<S, A, B>(ok1: S → Bool, ok2: S → Bool, {p: Path<S, A>}, {q: Path<S, B>}, apart: Apart<S, A, B>(p, q), s1: Path::Stable(ok1, q), s: S, v: B):
    (c: Bool) → ok2(s) = c → Path::guard(ok1, p).get(Path::guard(ok2, q).set(s, v)) = Path::guard(ok1, p).get(s)
{
    λ c => match c {
        True => λ on => trans(cong_fn(λ (t: S) => Path::guard(ok1, p).get(t), Path::guard_set_on(ok2, q, s, on, v)),
            cong_args(λ (d: Bool) => λ (o: Option<A>) => Path::gate_get(d, o), s1(s, v), apart.left_after_right(s, v))),
        False => λ off => cong_fn(λ (t: S) => Path::guard(ok1, p).get(t), Path::guard_set_off(ok2, q, s, off, v)),
    }
}

theorem Path::guard_commute<S, A, B>(ok1: S → Bool, ok2: S → Bool, {p: Path<S, A>}, {q: Path<S, B>}, apart: Apart<S, A, B>(p, q),
    s1: Path::Stable(ok1, q), s2: Path::Stable(ok2, p), s: S, a: A, b: B):
    (c1: Bool) → ok1(s) = c1 → (c2: Bool) → ok2(s) = c2 →
    Path::guard(ok1, p).set(Path::guard(ok2, q).set(s, b), a) = Path::guard(ok2, q).set(Path::guard(ok1, p).set(s, a), b)
{
    let g1 = Path::guard(ok1, p);
    let g2 = Path::guard(ok2, q);
    λ c1 => match c1 {
        True => λ on1 c2 => match c2 {
            True => λ on2 => trans(cong_fn(λ (t: S) => g1.set(t, a), Path::guard_set_on(ok2, q, s, on2, b)),
                trans(Path::guard_set_on(ok1, p, q.set(s, b), trans(s1(s, b), on1), a),
                    trans(apart.writes_commute(s, a, b), sym(trans(cong_fn(λ (t: S) => g2.set(t, b), Path::guard_set_on(ok1, p, s, on1, a)),
                        Path::guard_set_on(ok2, q, p.set(s, a), trans(s2(s, a), on2), b)))))),
            False => λ off2 => trans(cong_fn(λ (t: S) => g1.set(t, a), Path::guard_set_off(ok2, q, s, off2, b)),
                trans(Path::guard_set_on(ok1, p, s, on1, a), sym(trans(cong_fn(λ (t: S) => g2.set(t, b), Path::guard_set_on(ok1, p, s, on1, a)),
                    Path::guard_set_off(ok2, q, p.set(s, a), trans(s2(s, a), off2), b))))),
        },
        False => λ off1 c2 => match c2 {
            True => λ on2 => trans(cong_fn(λ (t: S) => g1.set(t, a), Path::guard_set_on(ok2, q, s, on2, b)),
                trans(Path::guard_set_off(ok1, p, q.set(s, b), trans(s1(s, b), off1), a),
                    sym(trans(cong_fn(λ (t: S) => g2.set(t, b), Path::guard_set_off(ok1, p, s, off1, a)), Path::guard_set_on(ok2, q, s, on2, b))))),
            False => λ off2 => trans(cong_fn(λ (t: S) => g1.set(t, a), Path::guard_set_off(ok2, q, s, off2, b)),
                trans(Path::guard_set_off(ok1, p, s, off1, a), sym(trans(cong_fn(λ (t: S) => g2.set(t, b), Path::guard_set_off(ok1, p, s, off1, a)),
                    Path::guard_set_off(ok2, q, s, off2, b))))),
        },
    }
}

theorem Path::guard_apart<S, A, B>(ok1: S → Bool, ok2: S → Bool, {p: Path<S, A>}, {q: Path<S, B>}, apart: Apart<S, A, B>(p, q),
    s1: Path::Stable(ok1, q), s2: Path::Stable(ok2, p)): Apart<S, A, B>(Path::guard(ok1, p), Path::guard(ok2, q))
{
    Apart(
        λ s v => Path::guard_read(ok1, ok2, apart, s1, s, v, ok2(s), refl),
        λ s v => Path::guard_read(ok2, ok1, Apart::symm(apart), s2, s, v, ok1(s), refl),
        λ s a b => Path::guard_commute(ok1, ok2, apart, s1, s2, s, a, b, ok1(s), refl, ok2(s), refl),
    )
}

// Spellings carried through a guard and through a step taken first.
theorem PathSame::guard<S, V>(ok: S → Bool, {p, q: Path<S, V>}, self e: PathSame<S, V>(p, q)): PathSame<S, V>(Path::guard(ok, p), Path::guard(ok, q)) {
    PathSame(λ s => cong_fn(λ (o: Option<V>) => Path::gate_get(ok(s), o), e.gets(s)), λ s v => cong_fn(λ (t: S) => Path::gate_set(ok(s), s, t), e.sets(s, v)))
}

theorem PathSame::after_get<S, A, B>(p: Path<S, A>, {q, r: Path<A, B>}, e: PathSame<A, B>(q, r), s: S):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = p.then(r).get(s)
{
    λ o => match o {
        Some(a) => λ at => trans(p.then_get_at(q, s, a, at), trans(e.gets(a), sym(p.then_get_at(r, s, a, at)))),
        None => λ at => trans(p.then_get_none(q, s, at), sym(p.then_get_none(r, s, at))),
    }
}

theorem PathSame::after_set<S, A, B>(p: Path<S, A>, {q, r: Path<A, B>}, e: PathSame<A, B>(q, r), s: S, b: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(s, b) = p.then(r).set(s, b)
{
    λ o => match o {
        Some(a) => λ at => trans(p.then_set_at(q, s, a, at, b), trans(cong_fn(λ (x: A) => p.set(s, x), e.sets(a, b)), sym(p.then_set_at(r, s, a, at, b)))),
        None => λ at => trans(p.then_set_none(q, s, at, b), sym(p.then_set_none(r, s, at, b))),
    }
}

theorem PathSame::after<S, A, B>(p: Path<S, A>, {q, r: Path<A, B>}, e: PathSame<A, B>(q, r)): PathSame<S, B>(p.then(q), p.then(r)) {
    PathSame(λ s => PathSame::after_get(p, e, s, p.get(s), refl), λ s b => PathSame::after_set(p, e, s, b, p.get(s), refl))
}

// ---------------------------------------------------------------------------
// Laws where what is written fits
//
// A step whose value is one shape of a wider type (a window's elements read
// as one value of a universe in which a sequence of any length is a value)
// reads back a write only where the written value has that shape. Its laws
// hold where `fits` does, and what it reads fits. A part of a part is lawful
// so where the outer step is lawful and the inner one lawful where it fits
// (`Path::then_laws_on`), and two parts apart under such a step are apart in
// the owner where the inner writes keep the fit (`Apart::under_on`, which is
// `Apart::under` with `fits` everywhere true).

record PathLawsOn<S, V>(p: Path<S, V>, fits: V → Bool) {
    set_get: (s: S) → (a, v: V) → p.get(s) = Some(a) → fits(v) = True → p.get(p.set(s, v)) = Some(v),
    get_set: (s: S) → (a: V) → p.get(s) = Some(a) → p.set(s, a) = s,
    set_set: (s: S) → (v, w: V) → fits(v) = True → fits(w) = True → p.set(p.set(s, v), w) = p.set(s, w),
    set_none: (s: S) → (v: V) → p.get(s) = None → p.set(s, v) = s,
    reads_fit: (s: S) → (a: V) → p.get(s) = Some(a) → fits(a) = True,
}

// A write through `q` keeps a fitting owner fitting.
fn Path::KeepsFit<S, V>(q: Path<S, V>, fits: S → Bool) → Type { (s: S) → fits(s) = True → (v: V) → fits(q.set(s, v)) = True }

// Lawful is lawful where everything fits.
theorem PathLaws::on<S, V>({p: Path<S, V>}, self laws: PathLaws<S, V>(p)): PathLawsOn<S, V>(p, λ _ => True) {
    PathLawsOn(λ s a v h _ => laws.set_get(s, a, v, h), laws.get_set, λ s v w _ _ => laws.set_set(s, v, w), laws.set_none, λ s a h => refl)
}

// Every write keeps an owner that always fits.
theorem Path::keeps_fit_true<S, V>(q: Path<S, V>): Path::KeepsFit(q, λ (_: S) => True) { λ s h v => refl }

theorem Path::then_set_get_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, pl: PathLaws<S, A>(p), ql: PathLawsOn<A, B>(q, fits), s: S, c, b: B, fb: fits(b) = True):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = Some(c) → p.then(q).get(p.then(q).set(s, b)) = Some(b)
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = Some(c)) = trans(sym(p.then_get_at(q, s, a, e)), h);
            let after: (p.get(p.set(s, q.set(a, b))) = Some(q.set(a, b))) = pl.set_get(s, a, q.set(a, b), e);
            let written: (p.then(q).set(s, b) = p.set(s, q.set(a, b))) = p.then_set_at(q, s, a, e, b);
            j(sym(written), λ t _ => p.then(q).get(t) = Some(b),
                trans(p.then_get_at(q, p.set(s, q.set(a, b)), q.set(a, b), after), ql.set_get(a, c, b, inner, fb)))
        },
        None => λ e h => absurd(trans(sym(p.then_get_none(q, s, e)), h)),
    }
}

theorem Path::then_get_set_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, pl: PathLaws<S, A>(p), ql: PathLawsOn<A, B>(q, fits), s: S, c: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = Some(c) → p.then(q).set(s, c) = s
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = Some(c)) = trans(sym(p.then_get_at(q, s, a, e)), h);
            trans(p.then_set_at(q, s, a, e, c), trans(cong_fn(λ (x: A) => p.set(s, x), ql.get_set(a, c, inner)), pl.get_set(s, a, e)))
        },
        None => λ e h => absurd(trans(sym(p.then_get_none(q, s, e)), h)),
    }
}

theorem Path::then_set_set_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, pl: PathLaws<S, A>(p), ql: PathLawsOn<A, B>(q, fits), s: S, v, w: B,
    fv: fits(v) = True, fw: fits(w) = True):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(p.then(q).set(s, v), w) = p.then(q).set(s, w)
{
    λ o => match o {
        Some(a) => λ e => {
            let s1 = p.set(s, q.set(a, v));
            let first: (p.then(q).set(s, v) = s1) = p.then_set_at(q, s, a, e, v);
            let read1: (p.get(s1) = Some(q.set(a, v))) = pl.set_get(s, a, q.set(a, v), e);
            let second: (p.then(q).set(s1, w) = p.set(s1, q.set(q.set(a, v), w))) = p.then_set_at(q, s1, q.set(a, v), read1, w);
            let inner: (p.set(s1, q.set(q.set(a, v), w)) = p.set(s1, q.set(a, w))) = cong_fn(λ (x: A) => p.set(s1, x), ql.set_set(a, v, w, fv, fw));
            let outer: (p.set(s1, q.set(a, w)) = p.set(s, q.set(a, w))) = pl.set_set(s, q.set(a, v), q.set(a, w));
            trans(cong_fn(λ (t: S) => p.then(q).set(t, w), first),
                trans(second, trans(inner, trans(outer, sym(p.then_set_at(q, s, a, e, w))))))
        },
        None => λ e => {
            let first: (p.then(q).set(s, v) = s) = p.then_set_none(q, s, e, v);
            cong_fn(λ (t: S) => p.then(q).set(t, w), first)
        },
    }
}

theorem Path::then_set_none_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, pl: PathLaws<S, A>(p), ql: PathLawsOn<A, B>(q, fits), s: S, v: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = None → p.then(q).set(s, v) = s
{
    λ o => match o {
        Some(a) => λ e h => {
            let inner: (q.get(a) = None) = trans(sym(p.then_get_at(q, s, a, e)), h);
            trans(p.then_set_at(q, s, a, e, v), trans(cong_fn(λ (x: A) => p.set(s, x), ql.set_none(a, v, inner)), pl.get_set(s, a, e)))
        },
        None => λ e h => p.then_set_none(q, s, e, v),
    }
}

theorem Path::then_reads_fit_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, ql: PathLawsOn<A, B>(q, fits), s: S, c: B):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(s) = Some(c) → fits(c) = True
{
    λ o => match o {
        Some(a) => λ e h => ql.reads_fit(a, c, trans(sym(p.then_get_at(q, s, a, e)), h)),
        None => λ e h => absurd(trans(sym(p.then_get_none(q, s, e)), h)),
    }
}

// A lawful step, then one lawful where it fits, is lawful where it fits.
theorem Path::then_laws_on<S, A, B>(self p: Path<S, A>, q: Path<A, B>, fits: B → Bool, pl: PathLaws<S, A>(p), ql: PathLawsOn<A, B>(q, fits)): PathLawsOn<S, B>(p.then(q), fits) {
    PathLawsOn(
        λ s c b h fb => p.then_set_get_on(q, fits, pl, ql, s, c, b, fb, p.get(s), refl, h),
        λ s c h => p.then_get_set_on(q, fits, pl, ql, s, c, p.get(s), refl, h),
        λ s v w fv fw => p.then_set_set_on(q, fits, pl, ql, s, v, w, fv, fw, p.get(s), refl),
        λ s v h => p.then_set_none_on(q, fits, pl, ql, s, v, p.get(s), refl, h),
        λ s c h => p.then_reads_fit_on(q, fits, ql, s, c, p.get(s), refl, h),
    )
}

theorem Apart::under_read_on<S, A, B, C>(p: Path<S, A>, fits: A → Bool, pl: PathLawsOn<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kr: Path::KeepsFit(r, fits), s: S, v: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(p.then(r).set(s, v)) = p.then(q).get(s)
{
    λ o => match o {
        Some(a) => λ e => {
            let written: (p.then(r).set(s, v) = p.set(s, r.set(a, v))) = p.then_set_at(r, s, a, e, v);
            let read: (p.get(p.set(s, r.set(a, v))) = Some(r.set(a, v))) = pl.set_get(s, a, r.set(a, v), e, kr(a, pl.reads_fit(s, a, e), v));
            trans(cong_fn(λ (t: S) => p.then(q).get(t), written),
                trans(p.then_get_at(q, p.set(s, r.set(a, v)), r.set(a, v), read), trans(inner.left_after_right(a, v), sym(p.then_get_at(q, s, a, e)))))
        },
        None => λ e => cong_fn(λ (t: S) => p.then(q).get(t), p.then_set_none(r, s, e, v)),
    }
}

theorem Apart::under_commute_on<S, A, B, C>(p: Path<S, A>, fits: A → Bool, pl: PathLawsOn<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kq: Path::KeepsFit(q, fits), kr: Path::KeepsFit(r, fits), s: S, b: B, c: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(p.then(r).set(s, c), b) = p.then(r).set(p.then(q).set(s, b), c)
{
    λ o => match o {
        Some(a) => λ e => {
            let fa: (fits(a) = True) = pl.reads_fit(s, a, e);
            let fr: (fits(r.set(a, c)) = True) = kr(a, fa, c);
            let fq: (fits(q.set(a, b)) = True) = kq(a, fa, b);
            let sr = p.set(s, r.set(a, c));
            let sq = p.set(s, q.set(a, b));
            let read_r: (p.get(sr) = Some(r.set(a, c))) = pl.set_get(s, a, r.set(a, c), e, fr);
            let read_q: (p.get(sq) = Some(q.set(a, b))) = pl.set_get(s, a, q.set(a, b), e, fq);
            let left: (p.then(q).set(p.then(r).set(s, c), b) = p.set(s, q.set(r.set(a, c), b))) =
                trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_at(r, s, a, e, c)),
                    trans(p.then_set_at(q, sr, r.set(a, c), read_r, b), pl.set_set(s, r.set(a, c), q.set(r.set(a, c), b), fr, kq(r.set(a, c), fr, b))));
            let right: (p.then(r).set(p.then(q).set(s, b), c) = p.set(s, r.set(q.set(a, b), c))) =
                trans(cong_fn(λ (t: S) => p.then(r).set(t, c), p.then_set_at(q, s, a, e, b)),
                    trans(p.then_set_at(r, sq, q.set(a, b), read_q, c), pl.set_set(s, q.set(a, b), r.set(q.set(a, b), c), fq, kr(q.set(a, b), fq, c))));
            trans(left, trans(cong_fn(λ (x: A) => p.set(s, x), inner.writes_commute(a, b, c)), sym(right)))
        },
        None => λ e => trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_none(r, s, e, c)),
            trans(p.then_set_none(q, s, e, b), trans(sym(p.then_set_none(r, s, e, c)), cong_fn(λ (t: S) => p.then(r).set(t, c), sym(p.then_set_none(q, s, e, b)))))),
    }
}

// Two parts apart inside one part lawful where it fits, each written only
// in ways that keep the fit, are apart in the owner.
theorem Apart::under_on<S, A, B, C>(p: Path<S, A>, fits: A → Bool, pl: PathLawsOn<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kq: Path::KeepsFit(q, fits), kr: Path::KeepsFit(r, fits)): Apart<S, B, C>(p.then(q), p.then(r))
{
    Apart(
        λ s v => Apart::under_read_on(p, fits, pl, inner, kr, s, v, p.get(s), refl),
        λ s v => Apart::under_read_on(p, fits, pl, Apart::symm(inner), kq, s, v, p.get(s), refl),
        λ s b c => Apart::under_commute_on(p, fits, pl, inner, kq, kr, s, b, c, p.get(s), refl),
    )
}

// A part of a part writes only through its outer step, so it keeps what
// that step keeps.
theorem Path::then_keeps_fit<S, A, B>(p: Path<S, A>, q: Path<A, B>, fits: S → Bool, kp: Path::KeepsFit(p, fits)): Path::KeepsFit(p.then(q), fits) {
    λ s fs b => (match p.get(s) as λ o => p.get(s) = o → fits(p.then(q).set(s, b)) = True {
        Some(a) => λ e => j(sym(p.then_set_at(q, s, a, e, b)), λ t _ => fits(t) = True, kp(s, fs, q.set(a, b))),
        None => λ e => j(sym(p.then_set_none(q, s, e, b)), λ t _ => fits(t) = True, fs),
    })(refl)
}

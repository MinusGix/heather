// `option` — the generic `Option<A>` and the three functions every use of it
// wanted (docs/modules-design.md §7, issues/prelude-option-and-friends.md).
//
// Type parameters are monomorphized at each instantiation (§2 of
// docs/inductive-tier0-lowering.md), so `Option<Nat>` and `Option<Bool>` are
// unrelated kernel types — which is exactly what makes this declaration
// re-usable without a functor: each importer's uses lower to their own.

inductive Option<A> { None, Some(v: A) }

fn map<A, B>(o: Option<A>, f: A -> B) -> Option<B> {
    match o {
        None => None,
        Some(v) => Some(f(v)),
    }
}

fn and_then<A, B>(o: Option<A>, f: A -> Option<B>) -> Option<B> {
    match o {
        None => None,
        Some(v) => f(v),
    }
}

fn unwrap_or<A>(o: Option<A>, d: A) -> A {
    if let Some(v) = o { v } else { d }
}

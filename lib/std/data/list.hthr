// Recursive lists and their core API: elimination, transformation, folds,
// slicing, zipping, membership, and indexing, together with their principal
// laws. `List<A>` lowers through the tier-1 well-founded encoding.

import logic;
import nat;
import option;
import bool;
import pair;

inductive List<A> { Nil, Cons(head: A, tail: List<A>) }

// The dependent companion to `ListAlg` below. An ordinary algebra replaces a
// recursive tail by one result in a fixed carrier `B`; an elimination algebra
// keeps the original tail and pairs it with a result in the motive at that
// tail. Packaging the two constructor-local obligations as a record makes a
// proof by induction an ordinary first-class value.
//
// `P` is a value parameter whose value is the result type family.
record ListElim<A>(P: List<A> → Type) {
    nil: P(Nil),
    cons: (head: A) → (tail: List<A>) → P(tail) → P(Cons(head, tail)),
}

fn List::list_elim<A>(P: List<A> → Type, alg: ListElim<A>(P), xs: List<A>) → P(xs) {
    match xs {
        Nil => alg.nil,
        Cons(head, tail) => alg.cons(head, tail, list_elim(P, alg, tail)),
    }
}

theorem List::list_elim_nil<A>(P: List<A> → Type, alg: ListElim<A>(P)):
    List::list_elim(P, alg, Nil) = alg.nil
{}

theorem List::list_elim_cons<A>(P: List<A> → Type, alg: ListElim<A>(P),
    head: A, tail: List<A>):
    List::list_elim(P, alg, Cons(head, tail)) =
        alg.cons(head, tail, List::list_elim(P, alg, tail))
{}

// ---------------------------------------------------------------------------

fn List::append<A>(self xs, ys: List<A>) → List<A> {
    match xs {
        Nil => ys,
        Cons(h, t) => Cons(h, t.append(ys)),
    }
}

designation<A> ++ at List<A> := List::append

theorem List::cong_cons<A>(h: A, {a, b: List<A>}, p: a = b):
    Cons(h, a) = Cons(h, b)
{
    rewrite(p, refl)
}

theorem List::cong_append_l<A>({a: List<A>}, {b: List<A>}, zs: List<A>, p: a = b):
    a ++ zs = b ++ zs
{
    rewrite(p, refl)
}

fn ListElim::append_nil_elim<A>() → ListElim<A>(λ (xs: List<A>) => xs ++ Nil = xs) {
    ListElim {
        nil: refl,
        cons: λ (h: A) (t: List<A>) ih => List::cong_cons(h, ih),
    }
}

theorem List::cong_append_r<A>(self xs: List<A>, {a: List<A>}, {b: List<A>}, p: a = b):
        xs ++ a = xs ++ b {
    rewrite(p, refl)
}

theorem List::append_nil<A>(self xs: List<A>): xs ++ Nil = xs {
    List::list_elim(λ (ys: List<A>) => ys ++ Nil = ys, ListElim::append_nil_elim(), xs)
}

theorem List::append_assoc<A>(self xs, ys, zs: List<A>):
    (xs ++ ys) ++ zs = xs ++ (ys ++ zs)
{
    match xs {
        Nil => {},
        Cons(h, t) => List::cong_cons(h, t.append_assoc(ys, zs)),
    }
}

// ---------------------------------------------------------------------------.

fn List::len<A>(self xs: List<A>) → Nat {
    match xs { Nil => 0, Cons(_, t) => Succ(t.len()) }
}

theorem List::len_append<A>(self xs, ys: List<A>):
    (xs ++ ys).len() = xs.len() + ys.len()
{
    match xs {
        Nil => sym(ys.len().add_left_zero()),
        Cons(_, t) =>
            apply trans;
            give Nat::cong_succ(t.len_append(ys));
            sym(t.len().add_succ_left(ys.len())),
    }
}

// ---------------------------------------------------------------------------

fn List::map<A, B>(self xs: List<A>, f: A → B) → List<B> {
    match xs {
        Nil => Nil,
        Cons(h, t) => Cons(f(h), List::map(t, f)),
    }
}

theorem List::map_id<A>(self xs: List<A>): xs.map(λ (a: A) => a) = xs {
    match xs {
        Nil => {},
        Cons(h, t) => List::cong_cons(h, t.map_id()),
    }
}

theorem List::map_map<A, B, C>(self xs: List<A>, f: A → B, g: B → C):
    xs.map(f).map(g) = xs.map(λ (a: A) => g(f(a)))
{
    match xs {
        Nil => {},
        Cons(h, t) => List::cong_cons(g(f(h)), t.map_map(f, g)),
    }
}

theorem List::map_append<A, B>(self xs, ys: List<A>, f: A → B):
    (xs ++ ys).map(f) = xs.map(f) ++ ys.map(f)
{
    match xs {
        Nil => {},
        Cons(h, t) => List::cong_cons(f(h), t.map_append(ys, f)),
    }
}

theorem List::len_map<A, B>(self xs: List<A>, f: A → B): xs.map(f).len() = xs.len() {
    match xs {
        Nil => {},
        Cons(_, t) => Nat::cong_succ(t.len_map(f)),
    }
}

// ---------------------------------------------------------------------------

fn List::rev<A>(self xs: List<A>) → List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => t.rev().append(Cons(h, Nil)),
    }
}

theorem List::rev_append<A>(self xs: List<A>, ys: List<A>):
    (xs ++ ys).rev() = ys.rev() ++ xs.rev()
{
    match xs {
        Nil => sym(ys.rev().append_nil()),
        Cons(h, t) =>
            apply trans;
            give List::cong_append_l(Cons(h, Nil), t.rev_append(ys));
            ys.rev().append_assoc(t.rev(), Cons(h, Nil)),
    }
}

theorem List::rev_involutive<A>(self xs: List<A>): xs.rev().rev() = xs {
    match xs {
        Nil => {},
        Cons(h, t) =>
            apply trans;
            give t.rev().rev_append(Cons(h, Nil));
            List::cong_cons(h, t.rev_involutive()),
    }
}

theorem List::rev_len<A>(self xs: List<A>): xs.rev().len() = xs.len() {
    match xs {
        Nil => {},
        Cons(h, t) =>
            apply trans;
            give t.rev().len_append(Cons(h, Nil));
            Nat::cong_succ(t.rev_len()),
    }
}

// ---------------------------------------------------------------------------

fn List::foldr<A, B>(self xs: List<A>, f: A → B → B, z: B) → B {
    match xs {
        Nil => z,
        Cons(h, t) => f(h, t.foldr(f, z)),
    }
}

fn List::foldl<A, B>(self xs: List<A>, f: B → A → B, z: B) → B {
    match xs {
        Nil => z,
        Cons(h, t) => t.foldl(f, f(z, h)),
    }
}

// One step of a loop that may exit early (docs/sequencing-surface-design.md
// §5.2): go on with the state, stop the loop with it, or leave the function
// with its value. A `for` whose body has `break`, `continue` or `return`
// lowers to `List::for_in` over a step returning this.
inductive ForStep<S, R> { Next(s: S), Break(s: S), Return(r: R) }

// The state a loop continues with after a `Next` or `Break`, `d` after a
// `Return` (which leaves the function, so nothing reads it).
fn ForStep::state<S, R>(self f: ForStep<S, R>, d: S) → S {
    match f { Next(s) => s, Break(s) => s, Return(_) => d }
}

// `foldl` that stops at the first `Break` or `Return`.
fn List::for_in<A, S, R>(self xs: List<A>, step: S → A → ForStep<S, R>, s: S) → ForStep<S, R> {
    match xs {
        Nil => Next(s),
        Cons(h, t) => match step(s, h) {
            Next(u) => t.for_in(step, u),
            Break(u) => Break(u),
            Return(r) => Return(r),
        },
    }
}

// A left fold whose step is a computation in a carrier `M`: the binding
// counterpart of `foldl`, and what a `for` loop in a carrier block lowers to
// (docs/sequencing-surface-design.md §6.1). Each step runs after the
// previous one, in list order.
fn List::for_m<A, S>(self xs: List<A>, {M: Type → Type}, s: S, step: S → A → M(S),
    b: Bind<M> := infer, p: Pointed<M> := infer) → M(S) {
    match xs {
        Nil => p.pure(s),
        Cons(h, t) => b.bind(step(s, h), λ next => t.for_m(next, step)),
    }
}

// Run `f` at every element in order and collect the results.
fn List::traverse<A, B>(self xs: List<A>, {M: Type → Type}, f: A → M(B),
    b: Bind<M> := infer, p: Pointed<M> := infer) → M(List<B>) {
    match xs {
        Nil => p.pure(Nil),
        Cons(h, t) => b.bind(f(h), λ y => b.bind(t.traverse(f), λ ys => p.pure(Cons(y, ys)))),
    }
}

// TODO: this should go in general file
theorem cong_fn<A, B>(g: A → B, {a, b: A}, p: a = b): g(a) = g(b) {
    rewrite(p, refl)
}

theorem List::foldr_append<A, B>(self xs, ys: List<A>, f: A → B → B, z: B):
    (xs ++ ys).foldr(f, z) = xs.foldr(f, ys.foldr(f, z))
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_fn(f(h), t.foldr_append(ys, f, z)),
    }
}

// ---------------------------------------------------------------------------

record ListAlg<A, B> {
    nil: B,
    cons: A → B → B,
}

fn ListAlg::list_fold<A, B>(self alg: ListAlg<A, B>, xs: List<A>) → B {
    match xs {
        Nil => alg.nil,
        Cons(h, t) => alg.cons(h, alg.list_fold(t)),
    }
}

theorem ListAlg::list_fold_nil<A, B>(self alg: ListAlg<A, B>): alg.list_fold(Nil) = alg.nil {}

theorem ListAlg::list_fold_cons<A, B>(self alg: ListAlg<A, B>, h: A, t: List<A>):
    alg.list_fold(Cons(h, t)) = alg.cons(h, alg.list_fold(t))
{}

theorem ListAlg::list_fold_unique<A, B>(self alg: ListAlg<A, B>, g: List<A> → B,
    nil_law: g(Nil) = alg.nil,
    cons_law: (h: A) → (t: List<A>) → g(Cons(h, t)) = alg.cons(h, g(t)),
    xs: List<A>): g(xs) = alg.list_fold(xs)
{
    match xs {
        Nil => nil_law,
        Cons(h, t) =>
            apply trans;
            give cons_law(h, t);
            cong_fn(alg.cons(h), alg.list_fold_unique(g, nil_law, cons_law, t)),
    }
}

theorem ListAlg::list_fold_fusion<A, B, C>(self src: ListAlg<A, B>, dst: ListAlg<A, C>,
    hom: B → C,
    nil_comm: hom(src.nil) = dst.nil,
    cons_comm: (a: A) → (b: B) → hom(src.cons(a, b)) = dst.cons(a, hom(b)),
    xs: List<A>): hom(src.list_fold(xs)) = dst.list_fold(xs)
{
    match xs {
        Nil => nil_comm,
        Cons(h, t) =>
            apply trans;
            give cons_comm(h, src.list_fold(t));
            cong_fn(dst.cons(h), ListAlg::list_fold_fusion(src, dst, hom, nil_comm, cons_comm, t)),
    }
}

theorem ListAlg::list_fold_is_foldr<A, B>(f: A → B → B, z: B, xs: List<A>):
    ListAlg::list_fold(ListAlg<A, B> { nil: z, cons: f }, xs) = xs.foldr(f, z)
{
    match xs {
        Nil => {},
        Cons(h, t) => cong_fn(f(h), ListAlg::list_fold_is_foldr(f, z, t)),
    }
}

theorem List::foldl_append<A, B>(self xs, ys: List<A>, f: B → A → B):
    (z: B) → (xs ++ ys).foldl(f, z) = ys.foldl(f, xs.foldl(f, z))
{
    match xs {
        Nil => λ z => {},
        Cons(h, t) => λ z => t.foldl_append(ys, f, f(z, h)),
    }
}

theorem List::foldl_rev<A, B>(self xs: List<A>, f: B → A → B):
    (z: B) → xs.rev().foldl(f, z) = xs.foldr(λ (a: A) (b: B) => f(b, a), z)
{
    match xs {
        Nil => λ z => {},
        Cons(h, t) => z ⊢
            apply trans;
            give t.rev().foldl_append(Cons(h, Nil), f, z);
            cong_fn(λ (w: B) => f(w, h), t.foldl_rev(f, z)),
    }
}

theorem List::foldl_len<A>(self xs: List<A>):
    (z: Nat) → xs.foldl(λ (k: Nat) (a: A) => Succ(k), z) = z + xs.len()
{
    match xs {
        Nil => λ z => {},
        Cons(_, t) => z ⊢
            apply trans;
            give t.foldl_len(Succ(z));
            z.add_succ_left(t.len()),
    }
}

// ---------------------------------------------------------------------------

fn List::filter<A>(self xs: List<A>, p: A → Bool) → List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => match p(h) {
            True => Cons(h, t.filter(p)),
            False => t.filter(p),
        },
    }
}

fn List::take<A>(self xs: List<A>, n: Nat) → List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => match n {
            Zero => Nil,
            Succ(k) => Cons(h, t.take(k)),
        },
    }
}

fn List::drop<A>(self xs: List<A>, n: Nat) → List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => match n {
            Zero => Cons(h, t),
            Succ(k) => t.drop(k),
        },
    }
}

theorem List::take_append_drop<A>(self xs: List<A>):
    (n: Nat) → xs.take(n) ++ xs.drop(n) = xs
{
    match xs {
        Nil => λ n => {},
        Cons(h, t) => λ n => match n {
            Zero => {},
            Succ(k) => List::cong_cons(h, t.take_append_drop(k)),
        },
    }
}

theorem List::drop_succ<A>(self xs: List<A>, n: Nat): xs.drop(n + 1) = xs.drop(n).drop(1) {
    match xs {
        Nil => {},
        Cons(_, t) => match n {
            Zero => {},
            Succ(k) => t.drop_succ(k),
        },
    }
}

theorem List::take_zero<A>(self xs: List<A>): xs.take(0) = Nil { match xs { Nil => refl, Cons(_, _) => refl } }

theorem List::drop_zero<A>(self xs: List<A>): xs.drop(0) = xs { match xs { Nil => refl, Cons(_, _) => refl } }

// As many as asked for, when there are that many.
theorem List::len_take<A>(self xs: List<A>): (n: Nat) → n <= xs.len() → xs.take(n).len() = n {
    match xs {
        Nil => λ n => match n { Zero => λ _ => refl, Succ(_) => λ (h: False) => false_elim(h) },
        Cons(_, t) => λ n => match n {
            Zero => λ _ => refl,
            Succ(k) => λ h => Nat::cong(λ m => Succ(m), t.len_take(k, h)),
        },
    }
}

theorem List::len_drop<A>(self xs: List<A>): (n: Nat) → xs.drop(n).len() = xs.len() - n {
    match xs {
        Nil => λ n => refl,
        Cons(_, t) => λ n => match n { Zero => refl, Succ(k) => t.len_drop(k) },
    }
}

// Dropping from a prefix is taking from the dropped list.
theorem List::drop_take<A>(self xs: List<A>): (n, k: Nat) → xs.take(n).drop(k) = xs.drop(k).take(n - k) {
    match xs {
        Nil => λ n k => refl,
        Cons(h, t) => λ n k => match n {
            Zero => sym((Cons(h, t)).drop(k).take_zero()),
            Succ(m) => match k {
                Zero => refl,
                Succ(j) => t.drop_take(m, j),
            },
        },
    }
}

// Dropping twice is dropping the sum. (`+` recurses on its second argument,
// so the first drop's count is on the right.)
theorem List::drop_drop<A>(self xs: List<A>): (j, k: Nat) → xs.drop(j).drop(k) = xs.drop(k + j) {
    match xs {
        Nil => λ j k => refl,
        Cons(h, t) => λ j k => match j {
            Zero => @cong<List<A>, List<A>>(λ ys => ys.drop(k), (Cons(h, t)).drop(0), Cons(h, t), refl),
            Succ(i) => t.drop_drop(i, k),
        },
    }
}

theorem List::take_take<A>(self xs: List<A>): (n, m: Nat) → m <= n → xs.take(n).take(m) = xs.take(m) {
    match xs {
        Nil => λ n m h => refl,
        Cons(h, t) => λ n m => match m {
            Zero => λ _ => (Cons(h, t)).take(n).take_zero(),
            Succ(i) => match n {
                Zero => λ (no: False) => false_elim(no),
                Succ(l) => λ le => List::cong_cons(h, t.take_take(l, i, le)),
            },
        },
    }
}

// A list is the prefix of its length of anything it starts.
theorem List::take_append_len<A>(self xs: List<A>, ys: List<A>): (xs ++ ys).take(xs.len()) = xs {
    match xs {
        Nil => ys.take_zero(),
        Cons(h, t) => List::cong_cons(h, t.take_append_len(ys)),
    }
}

theorem List::len_filter<A>(self xs: List<A>, p: A → Bool): xs.filter(p).len() <= xs.len() {
    match xs {
        Nil => trivial,
        Cons(h, t) => match p(h) {
            True => t.len_filter(p),
            False => t.filter(p).len().le_succ_r(t.len(), t.len_filter(p)),
        },
    }
}

theorem List::filter_append<A>(self xs, ys: List<A>, p: A → Bool):
    (xs ++ ys).filter(p) = xs.filter(p) ++ ys.filter(p)
{
    match xs {
        Nil => {},
        Cons(h, t) => match p(h) {
            True => List::cong_cons(h, t.filter_append(ys, p)),
            False => t.filter_append(ys, p),
        },
    }
}

theorem List::filter_filter<A>(self xs: List<A>, p: A → Bool):
    xs.filter(p).filter(p) = xs.filter(p)
{
    match xs {
        Nil => {},
        Cons(h, t) => match e: p(h) {
            True =>
                j(sym(e),
                  λ y q =>
                    (match y {
                        True => Cons(h, t.filter(p).filter(p)),
                        False => t.filter(p).filter(p),
                    }) = Cons(h, t.filter(p)),
                  List::cong_cons(h, t.filter_filter(p))),
            False => t.filter_filter(p),
        },
    }
}

theorem List::filter_map<A, B>(self xs: List<A>, f: A → B, p: B → Bool):
    xs.map(f).filter(p) = xs.filter(λ (a: A) => p(f(a))).map(f)
{
    match xs {
        Nil => {},
        Cons(h, t) => match p(f(h)) {
            True => List::cong_cons(f(h), t.filter_map(f, p)),
            False => t.filter_map(f, p),
        },
    }
}

// Filtering a list that starts with `h` keeps `h` exactly when `p` holds of
// it: one more than the tail's, or as many.
theorem List::len_filter_cons<A>(h: A, t: List<A>, p: A → Bool):
    Cons(h, t).filter(p).len() = t.filter(p).len() + Nat::of_bit(p(h)) {
    match p(h) as λ b => (match b { True => Cons(h, t.filter(p)), False => t.filter(p) }).len() = t.filter(p).len() + Nat::of_bit(b) {
        True => refl,
        False => refl,
    }
}

// ---------------------------------------------------------------------------
// Counting (issues/list-count-and-lines.md): the elements `p` holds of.

fn List::count<A>(self xs: List<A>, p: A → Bool) → Nat {
    match xs { Nil => 0, Cons(h, t) => t.count(p) + Nat::of_bit(p(h)) }
}

theorem List::count_nil<A>(p: A → Bool): List::count(Nil<A>, p) = 0 { refl }

// One more than the tail's when `p` holds of the head, or as many.
theorem List::count_cons<A>(h: A, t: List<A>, p: A → Bool): Cons(h, t).count(p) = t.count(p) + Nat::of_bit(p(h)) { refl }

theorem List::count_append<A>(self xs, ys: List<A>, p: A → Bool):
    (xs ++ ys).count(p) = xs.count(p) + ys.count(p)
{
    match xs {
        Nil => sym(ys.count(p).add_left_zero()),
        Cons(h, t) => match p(h) as λ c => (t ++ ys).count(p) + Nat::of_bit(c) = (t.count(p) + Nat::of_bit(c)) + ys.count(p) {
            True => trans(Nat::cong_succ(t.count_append(ys, p)), sym(t.count(p).add_succ_left(ys.count(p)))),
            False => t.count_append(ys, p),
        },
    }
}

// A count is the length of the filter: specs and proofs written over
// `filter(p).len()` meet ones written over `count(p)` here.
theorem List::count_eq_len_filter<A>(self xs: List<A>, p: A → Bool): xs.count(p) = xs.filter(p).len() {
    match xs {
        Nil => refl,
        Cons(h, t) => trans(cong_fn<Nat, Nat>(λ n => n + Nat::of_bit(p(h)), t.count_eq_len_filter(p)), sym(List::len_filter_cons(h, t, p))),
    }
}

// ---------------------------------------------------------------------------
// Splitting at separators (issues/list-split-by.md)

// `x` put at the front of the first piece.
fn List::onto_first<A>(x: A, pieces: List<List<A>>) → List<List<A>> {
    match pieces { Nil => Cons(Cons(x, Nil), Nil), Cons(piece, rest) => Cons(Cons(x, piece), rest) }
}

// One element's place among the pieces after it: a separator starts a new,
// empty piece in front; any other element joins the first piece.
fn List::split_onto<A>(cut: Bool, x: A, pieces: List<List<A>>) → List<List<A>> {
    match cut { True => Cons(Nil, pieces), False => List::onto_first(x, pieces) }
}

// The pieces between the elements `sep` holds of, in order and without the
// separators: `n` separators cut a list into `n + 1` pieces, some of them
// empty (Rust's `split`, Haskell's `splitWhen`).
fn List::split_by<A>(self xs: List<A>, sep: A → Bool) → List<List<A>> {
    match xs {
        Nil => Cons(Nil, Nil),
        Cons(x, rest) => List::split_onto(sep(x), x, rest.split_by(sep)),
    }
}

fn List::non_empty<A>(self xs: List<A>) → Bool { match xs { Nil => False, Cons(_, _) => True } }

// ---------------------------------------------------------------------------

fn List::replicate<A>(x: A, n: Nat) → List<A> {
    match n {
        Zero => Nil,
        Succ(k) => Cons(x, List::replicate(x, k)),
    }
}

theorem List::len_replicate<A>(x: A, n: Nat): List::replicate(x, n).len() = n {
    match n {
        Zero => {},
        Succ(k) => Nat::cong_succ(List::len_replicate(x, k)),
    }
}

// The indices below `n`, ascending: `[0, 1, …, n - 1]`. Built at the end,
// as big_operator's range sum is, so the two agree step by step.
fn List::range(n: Nat) → List<Nat> {
    match n {
        Zero => Nil,
        Succ(k) => List::range(k) ++ Cons(k, Nil),
    }
}

theorem List::len_range(n: Nat): List::range(n).len() = n {
    match n {
        Zero => {},
        Succ(k) => trans(List::range(k).len_append(Cons(k, Nil)), Nat::cong_succ(List::len_range(k))),
    }
}

// `[a, a + 1, …, a + n - 1]`, built at the end as `range` is: `a..b` in a
// `for` header is `List::range_from(a, b - a)`
// (docs/sequencing-surface-design.md §5.2).
fn List::range_from(a, n: Nat) → List<Nat> {
    match n {
        Zero => Nil,
        Succ(k) => List::range_from(a, k) ++ Cons(a + k, Nil),
    }
}

theorem List::len_range_from(a, n: Nat): List::range_from(a, n).len() = n {
    match n {
        Zero => {},
        Succ(k) => trans(List::range_from(a, k).len_append(Cons(a + k, Nil)), Nat::cong_succ(List::len_range_from(a, k))),
    }
}

// `[a, a + 1, …, a + n - 1]` again, built from the front, for a loop that
// walks it: walking `range_from` passes through every append below it, so
// a walk of `n` costs `n²`, while each step here costs one cell. Each
// number is `a + i` by addition, a literal when `a` is one.
fn List::count_from(a, n: Nat) → List<Nat> {
    match n {
        Zero => Nil,
        Succ(k) => Cons(a, List::count_from(a + 1, k)),
    }
}

theorem List::len_count_from(a, n: Nat): List::count_from(a, n).len() = n {
    match n {
        Zero => {},
        Succ(k) => Nat::cong_succ(List::len_count_from(a + 1, k)),
    }
}

fn List::zip<A, B>(self xs: List<A>) → List<B> → List<Pair<A, B>> {
    match xs {
        Nil => λ (ys: List<B>) => Nil,
        Cons(h, t) => λ (ys: List<B>) => match ys {
            Nil => Nil,
            Cons(h2, t2) => Cons(Pair(h, h2), t.zip(t2)),
        },
    }
}

theorem List::len_zip<A, B>(self xs: List<A>):
    (ys: List<B>) → xs.zip(ys).len() = xs.len().min(ys.len())
{
    match xs {
        Nil => λ ys => {},
        Cons(_, t) => λ ys => match ys {
            Nil => {},
            Cons(_, t2) => Nat::cong_succ(t.len_zip(t2)),
        },
    }
}

theorem List::zip_map_fst<A, B>(self xs: List<A>):
    (ys: List<B>) → xs.zip(ys).map(λ (q: Pair<A, B>) => q.fst) = xs.take(ys.len())
{
    match xs {
        Nil => λ ys => {},
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(_, t2) => List::cong_cons(h, t.zip_map_fst(t2)),
        },
    }
}

theorem List::zip_map_snd<A, B>(self xs: List<A>):
    (ys: List<B>) → xs.zip(ys).map(λ (q: Pair<A, B>) => q.snd) = ys.take(xs.len())
{
    match xs {
        Nil => λ ys => match ys {
            Nil => {},
            Cons(_, _) => {},
        },
        Cons(_, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => List::cong_cons(h2, t.zip_map_snd(t2)),
        },
    }
}

theorem List::zip_swap<A, B>(self xs: List<A>):
    (ys: List<B>) → xs.zip(ys).map(Pair::swap) = ys.zip(xs)
{
    match xs {
        Nil => λ ys => match ys {
            Nil => {},
            Cons(_, _) => {},
        },
        Cons(h, t) => λ ys => match ys {
            Nil => {},
            Cons(h2, t2) => List::cong_cons(Pair(h2, h), t.zip_swap(t2)),
        },
    }
}

// ---------------------------------------------------------------------------

fn Mem<A>(a: A, self xs: List<A>) → Type {
    match xs {
        Nil => False,
        Cons(h, t) => a = h ∨ Mem(a, t),
    }
}

// TODO: how should we namespace these?
theorem not_mem_nil<A>(a: A): ¬Mem(a, Nil) { (h: Mem(a, Nil)) ⊢ h }

theorem mem_head<A>(a: A, xs: List<A>): Mem(a, Cons(a, xs)) { Inl(refl) }

theorem List::mem_cons<A>(a, h: A, self xs: List<A>, m: Mem(a, xs)): Mem(a, Cons(h, xs)) { Inr(m) }

theorem List::mem_append_l<A>(self xs, ys: List<A>, a: A): Mem(a, xs) → Mem(a, xs ++ ys) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(_, t) => λ m => match m {
            Inl(e) => Inl(e),
            Inr(m2) => Inr(t.mem_append_l(ys, a, m2)),
        },
    }
}

theorem List::mem_append_r<A>(self xs, ys: List<A>, a: A): Mem(a, ys) → Mem(a, xs ++ ys) {
    match xs {
        Nil => λ m => m,
        Cons(_, t) => λ m => Inr(t.mem_append_r(ys, a, m)),
    }
}

theorem List::mem_append<A>(self xs, ys: List<A>, a: A):
    Mem(a, xs ++ ys) → Mem(a, xs) ∨ Mem(a, ys)
{
    match xs {
        Nil => λ m => Inr(m),
        Cons(_, t) => λ m => match m {
            Inl(e) => Inl(Inl(e)),
            Inr(m2) => match t.mem_append(ys, a, m2) {
                Inl(mt) => Inl(Inr(mt)),
                Inr(my) => Inr(my),
            },
        },
    }
}

theorem List::mem_append_iff<A>(self xs, ys: List<A>, a: A):
    Mem(a, xs ++ ys) ↔ Mem(a, xs) ∨ Mem(a, ys)
{
    Iff(mp := xs.mem_append(ys, a),
        mpr := λ (h: Mem(a, xs) ∨ Mem(a, ys)) =>
            or_elim(h, xs.mem_append_l(ys, a), xs.mem_append_r(ys, a)))
}

theorem List::mem_map<A, B>(self xs: List<A>, a: A, f: A → B): Mem(a, xs) → Mem(f(a), xs.map(f)) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(_, t) => λ m => match m {
            Inl(e) => Inl(cong_fn(f, e)),
            Inr(m2) => Inr(t.mem_map(a, f, m2)),
        },
    }
}

theorem List::mem_filter<A>(self xs: List<A>, a: A, p: A → Bool):
    Mem(a, xs.filter(p)) → Mem(a, xs)
{
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => match p(h) {
            True => λ m => match m {
                Inl(e) => Inl(e),
                Inr(m2) => Inr(t.mem_filter(a, p, m2)),
            },
            False => λ m => Inr(t.mem_filter(a, p, m)),
        },
    }
}

// What the filter keeps passes it.
theorem List::mem_filter_holds<A>(self xs: List<A>, a: A, p: A → Bool): Mem(a, xs.filter(p)) → p(a) = True {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => (match kept: p(h) {
            True => λ m => match m {
                Inl(e) => trans(cong_fn(p, e), kept),
                Inr(m2) => t.mem_filter_holds(a, p, m2),
            },
            False => λ m => t.mem_filter_holds(a, p, m),
        }),
    }
}

theorem List::mem_take<A>(self xs: List<A>, a: A): (n: Nat) → Mem(a, xs.take(n)) → Mem(a, xs) {
    match xs {
        Nil => λ n m => false_elim(m),
        Cons(_, t) => λ n => match n {
            Zero => λ m => false_elim(m),
            Succ(k) => λ m => match m {
                Inl(e) => Inl(e),
                Inr(m2) => Inr(t.mem_take(a, k, m2)),
            },
        },
    }
}

theorem List::mem_drop<A>(self xs: List<A>, a: A): (n: Nat) → Mem(a, xs.drop(n)) → Mem(a, xs) {
    match xs {
        Nil => λ n m => false_elim(m),
        Cons(_, t) => λ n => match n {
            Zero => λ m => m,
            Succ(k) => λ m => Inr(t.mem_drop(a, k, m)),
        },
    }
}

theorem List::mem_rev<A>(self xs: List<A>, a: A): Mem(a, xs.rev()) → Mem(a, xs) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m =>
            match t.rev().mem_append(Cons(h, Nil), a, m) {
                Inl(mr) => Inr(t.mem_rev(a, mr)),
                Inr(mh) => match mh {
                    Inl(e) => Inl(e),
                    Inr(bad) => false_elim(bad),
                },
            },
    }
}

// ---------------------------------------------------------------------------

fn List::head<A>(self xs: List<A>) → Option<A> {
    match xs {
        Nil => None,
        Cons(h, _) => Some(h),
    }
}

fn List::tail<A>(self xs: List<A>) → List<A> {
    match xs {
        Nil => Nil,
        Cons(_, t) => t,
    }
}

fn List::last<A>(self xs: List<A>) → Option<A> {
    match xs {
        Nil => None,
        Cons(h, t) => match t {
            Nil => Some(h),
            Cons(_, _) => t.last(),
        },
    }
}

// The index varies with the recursion on the list and is generalized into
// the motive (docs/ih-generalization-design.md). Call sites write
// `xs.nth(i)`: the receiver reaches the member through the type
// (issues/type-owned-members-receiver-slice.md).
fn List::nth<A>(self xs: List<A>, i: Nat) → Option<A> {
    match xs {
        Nil => None,
        Cons(h, t) => match i { Zero => Some(h), Succ(k) => t.nth(k) },
    }
}

theorem List::nth_replicate<A>(x: A, n: Nat): (i: Nat) → i < n → List::replicate(x, n).nth(i) = Some(x) {
    match n {
        Zero => λ i never => false_elim(never),
        Succ(k) => λ i => match i {
            Zero => λ _ => refl,
            Succ(l) => λ below => List::nth_replicate(x, k, l, below),
        },
    }
}

theorem List::nth_append_l<A>(self xs: List<A>, ys: List<A>):
    (i: Nat, a: A) → xs.nth(i) = Some(a) → (xs ++ ys).nth(i) = Some(a)
{
    match xs {
        Nil => λ i a p => absurd(p),
        Cons(_, t) => λ i a =>
            match i {
                Zero => λ p => p,
                Succ(k) => λ p => t.nth_append_l(ys, k, a, p),
            },
    }
}

theorem List::nth_append_r<A>(self xs: List<A>, ys: List<A>, i: Nat):
    (xs ++ ys).nth(i + xs.len()) = ys.nth(i)
{
    match xs {
        Nil => {},
        Cons(_, t) => t.nth_append_r(ys, i),
    }
}

theorem List::nth_past_end<A>(self xs: List<A>): (i: Nat) → xs.len() <= i → xs.nth(i) = None {
    match xs {
        Nil => λ _ _ => refl,
        Cons(_, t) => λ i => match i {
            Zero => λ h => false_elim(h),
            Succ(k) => λ h => t.nth_past_end(k, h),
        },
    }
}

theorem List::nth_drop<A>(self xs: List<A>, n: Nat): xs.nth(n) = xs.drop(n).nth(0) {
    match xs {
        Nil => {},
        Cons(_, t) => match n {
            Zero => {},
            Succ(k) => t.nth_drop(k),
        },
    }
}

// An index with an element is below the length.
theorem List::nth_some_below<A>(self xs: List<A>, i: Nat, x: A, present: xs.nth(i) = Some(x)): i < xs.len() {
    Nat::lt_of_not_le(i, xs.len(), λ past => absurd(trans(sym(present), xs.nth_past_end(i, past))))
}

// Below its length a list has an element at every index.
theorem List::nth_present<A>(self xs: List<A>): (i: Nat) → i < xs.len() → Exists<A>(λ c => xs.nth(i) = Some(c)) {
    match xs {
        Nil => λ i below => false_elim(below),
        Cons(h, t) => λ i => match i {
            Zero => λ _ => Exists(h, refl),
            Succ(k) => λ below => t.nth_present(k, below),
        },
    }
}

// The element at an index of a list mapped is the element there, mapped.
theorem List::nth_map_some<A, B>(self xs: List<A>, f: A → B): (i: Nat) → (x: A) → xs.nth(i) = Some(x) → xs.map(f).nth(i) = Some(f(x)) {
    match xs {
        Nil => λ i x none => absurd(none),
        Cons(h, t) => λ i => match i {
            Zero => λ x some => cong_fn<A, Option<B>>(λ a => Some(f(a)), Option::some_inj(h, x, some)),
            Succ(k) => λ x some => t.nth_map_some(f, k, x, some),
        },
    }
}

// The list with `f` applied to its element at `i`; past its end, the list.
fn List::update<A>(self xs: List<A>, i: Nat, f: A → A) → List<A> {
    match xs {
        Nil => Nil,
        Cons(h, t) => match i { Zero => Cons(f(h), t), Succ(k) => Cons(h, t.update(k, f)) },
    }
}

theorem List::len_update<A>(self xs: List<A>): (i: Nat) → (f: A → A) → xs.update(i, f).len() = xs.len() {
    match xs {
        Nil => λ i f => refl,
        Cons(_, t) => λ i => match i {
            Zero => λ f => refl,
            Succ(k) => λ f => cong_fn<Nat, Nat>(λ n => Succ(n), t.len_update(k, f)),
        },
    }
}

theorem List::nth_update_here<A>(self xs: List<A>): (i: Nat) → (f: A → A) → (x: A) → xs.nth(i) = Some(x) →
    xs.update(i, f).nth(i) = Some(f(x)) {
    match xs {
        Nil => λ i f x none => absurd(none),
        Cons(h, t) => λ i => match i {
            Zero => λ f x some => cong_fn<A, Option<A>>(λ a => Some(f(a)), Option::some_inj(h, x, some)),
            Succ(k) => λ f x some => t.nth_update_here(k, f, x, some),
        },
    }
}

theorem List::nth_update_other<A>(self xs: List<A>): (i: Nat) → (f: A → A) → (k: Nat) → k ≠ i → xs.update(i, f).nth(k) = xs.nth(k) {
    match xs {
        Nil => λ i f k _ => refl,
        Cons(_, t) => λ i => match i {
            Zero => λ f k => match k { Zero => λ ne => false_elim(ne(refl)), Succ(_) => λ _ => refl },
            Succ(m) => λ f k => match k {
                Zero => λ _ => refl,
                Succ(l) => λ ne => t.nth_update_other(m, f, l, λ same => ne(cong_fn<Nat, Nat>(λ n => Succ(n), same))),
            },
        },
    }
}

// Where there is no element, there is none after an update either.
theorem List::nth_update_none<A>(self xs: List<A>): (i: Nat) → (f: A → A) → xs.nth(i) = None → xs.update(i, f).nth(i) = None {
    match xs {
        Nil => λ i f _ => refl,
        Cons(_, t) => λ i => match i {
            Zero => λ f some => absurd(some),
            Succ(k) => λ f none => t.nth_update_none(k, f, none),
        },
    }
}

// Past its end, an update leaves the list as it was.
theorem List::update_past<A>(self xs: List<A>): (i: Nat) → (f: A → A) → xs.len() <= i → xs.update(i, f) = xs {
    match xs {
        Nil => λ i f _ => refl,
        Cons(h, t) => λ i => match i {
            Zero => λ f past => false_elim(past),
            Succ(k) => λ f past => cong_fn<List<A>, List<A>>(λ r => Cons(h, r), t.update_past(k, f, past)),
        },
    }
}

// The list as a vector of its length, in order: what a store of a list's
// bytes stores (`Memory::set_span`, lib/std/machine/memory.hthr).
fn List::to_vector<A>(self xs: List<A>) → [A; xs.len()] {
    match xs {
        Nil => {
            let empty: [A; 0] = [];
            empty
        },
        Cons(h, t) => cons(h, t.to_vector()),
    }
}

instance<A>(n: Nat) CollectionLiteral<List<A>>(n) {
    element := A,
    fromLiteral := λ (xs: [A; n]) => xs.fold(Nil<A>, λ (head: A) (tail: List<A>) => Cons(head, tail)),
}

// ---------------------------------------------------------------------------

fn List::is_nil<A>(self xs: List<A>) → Type { match xs { Nil => True, Cons(_, _) => False } }

fn List::nonempty<A>(self xs: List<A>) → Type {
    match xs { Nil => False, Cons(_, _) => True }
}

fn List::all<A>(self xs: List<A>, p: A → Bool) → Type {
    match xs { Nil => True, Cons(c, r) => p(c).IsTrue() ∧ r.all(p) }
}

fn List::head_or<A>(self xs: List<A>, fallback: A) → A {
    match xs {
        Nil => fallback,
        Cons(h, _) => h,
    }
}

theorem List::nil_ne_cons<A>(tail: List<A>, head: A): ¬(Nil<A> = Cons(head, tail)) {
    λ (p: (Nil<A> = Cons(head, tail))) => j(p, λ y q => y.is_nil(), trivial)
}

theorem List::cons_ne_nil<A>(tail: List<A>, head: A): ¬(Cons(head, tail) = Nil<A>) {
    λ (p: (Cons(head, tail) = Nil<A>)) => tail.nil_ne_cons(head, sym(p))
}

theorem List::cong_head<A>({xs, ys: List<A>}, fallback: A, p: xs = ys):
    xs.head_or(fallback) = ys.head_or(fallback)
{
    rewrite(p, refl)
}

theorem List::cong_tail<A>({xs, ys: List<A>}, p: xs = ys): xs.tail() = ys.tail() {
    rewrite(p, refl)
}

theorem List::cons_eq<A>(tail1, tail2: List<A>, head1, head2: A,
    ph: head1 = head2, pt: tail1 = tail2): Cons(head1, tail1) = Cons(head2, tail2)
{
    rewrite(sym(ph), List::cong_cons(head1, pt))
}

fn List::list_eq_dec<A: DecEq>(self xs: List<A>) → (ys: List<A>) → xs = ys ∨ ¬(xs = ys) {
    match xs {
        Nil => λ ys =>
            match ys {
                Nil => Inl(refl),
                Cons(head2, tail2) => Inr(tail2.nil_ne_cons(head2)),
            },
        Cons(head1, tail1) => λ ys =>
            match ys {
                Nil => Inr(tail1.cons_ne_nil(head1)),
                Cons(head2, tail2) =>
                    match A.eq_dec(head1, head2) {
                        Inr(head_ne) => Inr(λ (p: (Cons(head1, tail1) = Cons(head2, tail2))) =>
                            head_ne(List::cong_head(head1, p))),
                        Inl(head_eq) =>
                            match tail1.list_eq_dec(tail2) {
                                Inl(tail_eq) => Inl(List::cons_eq(tail1, tail2, head1, head2, head_eq, tail_eq)),
                                Inr(tail_ne) =>
                                    Inr(λ (p: (Cons(head1, tail1) = Cons(head2, tail2))) =>
                                        tail_ne(List::cong_tail(p))),
                            },
                    },
            },
    }
}

instance<A: DecEq> DecEq<List<A>> { eq_dec := List::list_eq_dec }

instance<A: DecEq>(xs, ys: List<A>) Decide<xs = ys> { dec := List::list_eq_dec(xs, ys), bit := or_bit(List::list_eq_dec(xs, ys)), reflects := or_bit_reflects(List::list_eq_dec(xs, ys)) }

// ---------------------------------------------------------------------------

fn List::at<A>(self xs: List<A>, i: Fin(xs.len())) → A {
    match xs {
        Nil => match i {},
        Cons(head, tail) => match i { FZ => head, FS(k) => tail.at(k) },
    }
}

// ---------------------------------------------------------------------------
// Membership through `map`, duplicate-freedom, Bool quantifiers and products:
// what an enumeration of a finite type is made of (lib/std/data/fintype.hthr).

// A value of a mapped list is the image of a member.
theorem List::mem_map_inv<A, B>(self xs: List<A>, f: A → B, b: B):
    Mem(b, xs.map(f)) → Exists(λ (a: A) => Mem(a, xs) ∧ f(a) = b)
{
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m => match m {
            Inl(e) => Exists(h, And(Inl(refl), sym(e))),
            Inr(m2) => match t.mem_map_inv(f, b, m2) {
                Exists(a, w) => Exists(a, And(Inr(w.left), w.right)),
            },
        },
    }
}

// No element occurs twice. Stated by recursion, as `Mem` is, so a closed list's
// evidence is a tuple of refuted equations.
fn List::NoDup<A>(self xs: List<A>) → Type {
    match xs { Nil => True, Cons(h, t) => ¬Mem(h, t) ∧ t.NoDup() }
}

// An injective map keeps a list duplicate-free.
theorem List::nodup_map<A, B>(self xs: List<A>, f: A → B,
    inj: (a, b: A) → f(a) = f(b) → a = b): xs.NoDup() → xs.map(f).NoDup()
{
    match xs {
        Nil => λ d => trivial,
        Cons(h, t) => λ d => And(
            λ (m: Mem(f(h), t.map(f))) => match t.mem_map_inv(f, f(h), m) {
                Exists(a, w) => d.left(rewrite(sym(inj(a, h, w.right)), w.left)),
            },
            t.nodup_map(f, inj, d.right)),
    }
}

// Two duplicate-free lists with no common member append to one.
theorem List::nodup_append<A>(self xs, ys: List<A>,
    apart: (a: A) → Mem(a, xs) → Mem(a, ys) → False): xs.NoDup() → ys.NoDup() → (xs ++ ys).NoDup()
{
    match xs {
        Nil => λ dx dy => dy,
        Cons(h, t) => λ dx dy => And(
            λ (m: Mem(h, t ++ ys)) => match t.mem_append(ys, h, m) {
                Inl(mt) => dx.left(mt),
                Inr(my) => apart(h, Inl(refl), my),
            },
            t.nodup_append(ys, λ a ma mb => apart(a, Inr(ma), mb), dx.right, dy)),
    }
}

// A Bool predicate over every element, and over some element, as one Bool: a
// closed claim about a list's elements is `xs.all_bit(p) = True` by `refl`
// (docs/proof-patterns.md, closed verdicts). The refuting directions compute
// their witness.
fn List::all_bit<A>(self xs: List<A>, p: A → Bool) → Bool {
    match xs { Nil => True, Cons(h, t) => p(h) && t.all_bit(p) }
}

fn List::any_bit<A>(self xs: List<A>, p: A → Bool) → Bool {
    match xs { Nil => False, Cons(h, t) => p(h) || t.any_bit(p) }
}

theorem List::all_bit_sound<A>(self xs: List<A>, p: A → Bool):
    xs.all_bit(p) = True → (a: A) → Mem(a, xs) → p(a) = True
{
    match xs {
        Nil => λ e a m => false_elim(m),
        Cons(h, t) => (match hd: p(h) {
            True => λ e a m => match m {
                Inl(q) => trans(cong_fn(p, q), hd),
                Inr(m2) => t.all_bit_sound(p, e, a, m2),
            },
            False => λ e a m => absurd(e),
        }),
    }
}

theorem List::all_bit_refute<A>(self xs: List<A>, p: A → Bool):
    xs.all_bit(p) = False → Exists(λ (a: A) => Mem(a, xs) ∧ p(a) = False)
{
    match xs {
        Nil => λ e => absurd(e),
        Cons(h, t) => (match hd: p(h) {
            True => λ e => match t.all_bit_refute(p, e) {
                Exists(a, w) => Exists(a, And(Inr(w.left), w.right)),
            },
            False => λ e => Exists(h, And(Inl(refl), hd)),
        }),
    }
}

theorem List::any_bit_sound<A>(self xs: List<A>, p: A → Bool):
    xs.any_bit(p) = True → Exists(λ (a: A) => Mem(a, xs) ∧ p(a) = True)
{
    match xs {
        Nil => λ e => absurd(e),
        Cons(h, t) => (match hd: p(h) {
            True => λ e => Exists(h, And(Inl(refl), hd)),
            False => λ e => match t.any_bit_sound(p, e) {
                Exists(a, w) => Exists(a, And(Inr(w.left), w.right)),
            },
        }),
    }
}

theorem List::any_bit_refute<A>(self xs: List<A>, p: A → Bool):
    xs.any_bit(p) = False → (a: A) → Mem(a, xs) → p(a) = False
{
    match xs {
        Nil => λ e a m => false_elim(m),
        Cons(h, t) => (match hd: p(h) {
            True => λ e a m => absurd(e),
            False => λ e a m => match m {
                Inl(q) => trans(cong_fn(p, q), hd),
                Inr(m2) => t.any_bit_refute(p, e, a, m2),
            },
        }),
    }
}

// The first element a predicate holds of. A function, so the witness of a
// closed search evaluates.
fn List::find<A>(self xs: List<A>, p: A → Bool) → Option<A> {
    match xs { Nil => None, Cons(h, t) => match p(h) { True => Some(h), False => t.find(p) } }
}

theorem List::find_sound<A>(self xs: List<A>, p: A → Bool, a: A):
    xs.find(p) = Some(a) → Mem(a, xs) ∧ p(a) = True
{
    match xs {
        Nil => λ e => Option::none_ne_some(a, e, Mem(a, Nil<A>) ∧ p(a) = True),
        Cons(h, t) => (match hd: p(h) {
            True => λ e => And(Inl(sym(Option::some_inj(h, a, e))), rewrite(sym(Option::some_inj(h, a, e)), hd)),
            False => λ e => { let r = t.find_sound(p, a, e); And(Inr(r.left), r.right) },
        }),
    }
}

theorem List::find_none<A>(self xs: List<A>, p: A → Bool):
    xs.find(p) = None → (a: A) → Mem(a, xs) → p(a) = False
{
    match xs {
        Nil => λ e a m => false_elim(m),
        Cons(h, t) => (match hd: p(h) {
            True => λ e a m => Option::none_ne_some(h, sym(e), p(a) = False),
            False => λ e a m => match m {
                Inl(q) => trans(cong_fn(p, q), hd),
                Inr(m2) => t.find_none(p, e, a, m2),
            },
        }),
    }
}

// Every pair of one element from each list, the first list's order outermost.
fn List::product<A, B>(self xs: List<A>, ys: List<B>) → List<Pair<A, B>> {
    match xs { Nil => Nil, Cons(h, t) => ys.map(λ (b: B) => Pair(h, b)) ++ t.product(ys) }
}

theorem List::mem_product<A, B>(self xs: List<A>, ys: List<B>, a: A, b: B):
    Mem(a, xs) → Mem(b, ys) → Mem(Pair(a, b), xs.product(ys))
{
    match xs {
        Nil => λ ma mb => false_elim(ma),
        Cons(h, t) => λ ma mb => match ma {
            Inl(e) => (ys.map(λ (b: B) => Pair(h, b))).mem_append_l(t.product(ys), Pair(a, b),
                rewrite(e, ys.mem_map(b, λ (b: B) => Pair(h, b), mb))),
            Inr(m2) => (ys.map(λ (b: B) => Pair(h, b))).mem_append_r(t.product(ys), Pair(a, b), t.mem_product(ys, a, b, m2, mb)),
        },
    }
}

theorem List::mem_product_fst<A, B>(self xs: List<A>, ys: List<B>, q: Pair<A, B>):
    Mem(q, xs.product(ys)) → Mem(q.fst, xs)
{
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m => match (ys.map(λ (b: B) => Pair(h, b))).mem_append(t.product(ys), q, m) {
            Inl(mh) => match ys.mem_map_inv(λ (b: B) => Pair(h, b), q, mh) {
                Exists(_, w) => Inl(rewrite(sym(w.right), refl)),
            },
            Inr(mt) => Inr(t.mem_product_fst(ys, q, mt)),
        },
    }
}

theorem List::nodup_product<A, B>(self xs: List<A>, ys: List<B>):
    xs.NoDup() → ys.NoDup() → xs.product(ys).NoDup()
{
    match xs {
        Nil => λ dx dy => trivial,
        Cons(h, t) => λ dx dy => (ys.map(λ (b: B) => Pair(h, b))).nodup_append(t.product(ys),
            λ q mh mt => match ys.mem_map_inv(λ (b: B) => Pair(h, b), q, mh) {
                Exists(_, w) => dx.left(rewrite(cong_fn(λ (r: Pair<A, B>) => r.fst, w.right), t.mem_product_fst(ys, q, mt))),
            },
            ys.nodup_map(λ (b: B) => Pair(h, b), λ b1 b2 e => cong_fn(λ (q: Pair<A, B>) => q.snd, e), dy),
            t.nodup_product(ys, dx.right, dy)),
    }
}

// ---------------------------------------------------------------------------
// Repeats: the failure of `NoDup` as data, its decision, and the search for
// two elements with one image (pigeonhole's witness, fintype_card.hthr).

// A repeated element, as data: the first position whose element occurs again.
fn List::Dup<A>(self xs: List<A>) → Type {
    match xs { Nil => False, Cons(h, t) => Mem(h, t) ∨ t.Dup() }
}

theorem List::not_dup_of_nodup<A>(self xs: List<A>): xs.NoDup() → ¬xs.Dup() {
    match xs {
        Nil => λ d u => u,
        Cons(_, t) => λ d u => match u { Inl(m) => d.left(m), Inr(u2) => t.not_dup_of_nodup(d.right, u2) },
    }
}

// Membership and duplicate-freedom decide at a carrier with decidable equality.
fn List::mem_dec<A: DecEq>(a: A, self xs: List<A>) → Mem(a, xs) ∨ ¬Mem(a, xs) {
    match xs {
        Nil => Inr(λ m => m),
        Cons(h, t) => match A.eq_dec(a, h) {
            Inl(e) => Inl(Inl(e)),
            Inr(ne) => match t.mem_dec(a) {
                Inl(m) => Inl(Inr(m)),
                Inr(nm) => Inr(λ m => match m { Inl(e) => ne(e), Inr(m2) => nm(m2) }),
            },
        },
    }
}

fn List::nodup_dec<A: DecEq>(self xs: List<A>) → xs.NoDup() ∨ xs.Dup() {
    match xs {
        Nil => Inl(trivial),
        Cons(h, t) => match t.mem_dec(h) {
            Inl(m) => Inr(Inl(m)),
            Inr(nm) => match t.nodup_dec() {
                Inl(d) => Inl(And(nm, d)),
                Inr(u) => Inr(Inr(u)),
            },
        },
    }
}

// A repeat among the images of a duplicate-free list is two different
// elements with one image.
theorem List::dup_map<A, B>(self xs: List<A>, f: A → B): xs.NoDup() → xs.map(f).Dup() →
    Exists(λ (q: Pair<A, A>) => ¬(q.fst = q.snd) ∧ f(q.fst) = f(q.snd))
{
    match xs {
        Nil => λ d u => false_elim(u),
        Cons(h, t) => λ d u => match u {
            Inl(m) => match t.mem_map_inv(f, f(h), m) {
                Exists(a, w) => Exists(Pair(h, a), And(λ e => d.left(rewrite(e, w.left)), sym(w.right))),
            },
            Inr(u2) => t.dup_map(f, d.right, u2),
        },
    }
}

theorem List::len_product<A, B>(self xs: List<A>, ys: List<B>): xs.product(ys).len() = xs.len() * ys.len() {
    match xs {
        Nil => sym(Nat::mul_left_zero(ys.len())),
        Cons(h, t) => trans(
            (ys.map(λ (b: B) => Pair(h, b))).len_append(t.product(ys)),
            trans(rewrite(ys.len_map(λ (b: B) => Pair(h, b)), rewrite(t.len_product(ys), refl)),
                trans(Nat::add_comm(ys.len(), t.len() * ys.len()),
                    trans(cong_fn(λ (n: Nat) => n + ys.len(), Nat::mul_comm(t.len(), ys.len())),
                        Nat::mul_comm(ys.len(), Succ(t.len())))))),
    }
}

// The first two elements of a list with one image, searched for.
fn List::collision<A, B: DecEq>(self xs: List<A>, f: A → B) → Option<Pair<A, A>> {
    match xs {
        Nil => None,
        Cons(h, t) => match t.find(λ (a: A) => or_bit(B.eq_dec(f(h), f(a)))) {
            Some(a) => Some(Pair(h, a)),
            None => t.collision(f),
        },
    }
}

theorem List::collision_sound<A, B: DecEq>(self xs: List<A>, f: A → B, q: Pair<A, A>):
    xs.NoDup() → xs.collision(f) = Some(q) → ¬(q.fst = q.snd) ∧ f(q.fst) = f(q.snd)
{
    match xs {
        Nil => λ d e => Option::none_ne_some(q, e, ¬(q.fst = q.snd) ∧ f(q.fst) = f(q.snd)),
        Cons(h, t) => λ d => (match fd: t.find(λ (a: A) => or_bit(B.eq_dec(f(h), f(a)))) {
            Some(a) => λ e => {
                let found = t.find_sound(λ (a: A) => or_bit(B.eq_dec(f(h), f(a))), a, fd);
                j(Option::some_inj(Pair(h, a), q, e), λ r _ => ¬(r.fst = r.snd) ∧ f(r.fst) = f(r.snd),
                    And(λ same => d.left(rewrite(same, found.left)), or_bit_reflects(B.eq_dec(f(h), f(a))).left(found.right)))
            },
            None => λ e => t.collision_sound(f, q, d.right, e),
        }),
    }
}

// The lists of a list, one after another.
fn List::concat<A>(self xss: List<List<A>>) → List<A> {
    match xss { Nil => Nil, Cons(h, t) => h ++ t.concat() }
}

// Only two empty lists append to the empty list.
theorem List::append_nil_parts<A>(self u: List<A>): (v: List<A>) → u ++ v = Nil → u = Nil ∧ v = Nil {
    match u {
        Nil => λ v e => And(refl, e),
        Cons(h, t) => λ v e => false_elim((t ++ v).cons_ne_nil(h, e)),
    }
}

// Membership in finite-set expressions, decided by a truth table
// (issues/finite-set-membership-solver.md, docs/native-mathematics-survey.md §1).
//
// Sets here are lists read as sets: `Mem(x, xs)` is membership, and an
// operation is anything whose membership is a Boolean combination of its
// arguments' (`++` is "or", a union is "or", a difference "and not", a
// filter "and" with the predicate's bit). So whether `x` is in a set
// expression is a Boolean function of whether `x` is in each atom, equals
// each listed element, and passes each filter's predicate, and a goal that
// follows from its hypotheses for every assignment of those bits follows
// for the real one. `set_solve` is that argument proved once: the caller
// reifies the goal and hypotheses into `SetExpr`s over an environment of
// atoms (`SetEnv`), and the verdict `set_taut(…) = True` is closed (it reads
// only the expressions' shapes and the operations' connectives), so it is
// proved by `refl`, by evaluation.
//
// The assignment is enumerated whole, so the verdict costs 2^k evaluations
// of the formula for k atoms, elements and predicates together. The goals
// it is for (liveness, ports, register pools) have a handful.

import logic;
import bool;
import nat;
import list;
import option;

// ---------------------------------------------------------------------------
// Connectives and operations

// How an operation's membership combines its arguments'.
inductive SetConn { SetOr, SetAnd, SetDiff }

fn SetConn::bit(self c: SetConn, a, b: Bool) → Bool {
    match c { SetOr => a || b, SetAnd => a && b, SetDiff => a && !b }
}

fn SetConn::Holds(self c: SetConn, P, Q: Type) → Type {
    match c { SetOr => P ∨ Q, SetAnd => P ∧ Q, SetDiff => P ∧ ¬Q }
}

theorem SetConn::reflects(self c: SetConn, {P, Q: Type}, {x, y: Bool}, p: Reflects(P, x), q: Reflects(Q, y)):
    Reflects(c.Holds(P, Q), c.bit(x, y)) {
    match c {
        SetOr => reflects_or(p, q),
        SetAnd => reflects_and(p, q),
        SetDiff => reflects_and(p, reflects_not(q)),
    }
}

// An operation on sets with its membership law.
fn SetLaw<A>(f: List<A> → List<A> → List<A>, c: SetConn) → Type {
    (x: A) → (a, b: List<A>) → (Mem(x, f(a, b)) ↔ c.Holds(Mem(x, a), Mem(x, b)))
}

record SetOp<A> { f: List<A> → List<A> → List<A>, conn: SetConn, law: SetLaw(f, conn) }

theorem set_append_law<A>(): SetLaw<A>(List::append, SetOr) {
    λ x a b => a.mem_append_iff(b, x)
}

// ---------------------------------------------------------------------------
// Membership as a bit

fn set_eq_bit<A>(d: DecEq<A>, x, y: A) → Bool { or_bit(d.eq_dec(x, y)) }

fn set_mem_bit<A>(d: DecEq<A>, x: A, xs: List<A>) → Bool {
    match xs { Nil => False, Cons(h, t) => set_eq_bit(d, x, h) || set_mem_bit(d, x, t) }
}

theorem set_false_reflects(): Reflects(False, False) {
    And(λ (no: False = True) => absurd(no), λ _ (m: False) => m)
}

theorem set_mem_reflects<A>(d: DecEq<A>, x: A, xs: List<A>): Reflects(Mem(x, xs), set_mem_bit(d, x, xs)) {
    match xs {
        Nil => set_false_reflects(),
        Cons(h, t) => reflects_or(or_bit_reflects(d.eq_dec(x, h)), set_mem_reflects(d, x, t)),
    }
}

// A Boolean as the proposition that it is `True`.
theorem set_bit_reflects(b: Bool): Reflects(b = True, b) {
    And(λ h => h, λ (hf: b = False) (ht: b = True) => absurd(trans(sym(hf), ht)))
}

theorem set_mem_filter_intro<A>(xs: List<A>, x: A, p: A → Bool, px: p(x) = True): Mem(x, xs) → Mem(x, xs.filter(p)) {
    match xs {
        Nil => λ m => m,
        Cons(h, t) => λ m => match m {
            Inl(e) => {
                let ph: (p(h) = True) = trans(cong_fn(p, sym(e)), px);
                j(sym(ph), λ b _ => Mem(x, match b { True => Cons(h, t.filter(p)), False => t.filter(p) }), Inl(e))
            },
            Inr(r) => {
                let rest: Mem(x, t.filter(p)) = set_mem_filter_intro(t, x, p, px, r);
                match ph: p(h) {
                    True => Inr(rest),
                    False => rest,
                }
            },
        },
    }
}

theorem set_filter_reflects<A>(xs: List<A>, x: A, p: A → Bool, {y: Bool}, r: Reflects(Mem(x, xs), y)):
    Reflects(Mem(x, xs.filter(p)), p(x) && y) {
    reflects_iff(reflects_and(set_bit_reflects(p(x)), r),
        λ (both: (p(x) = True) ∧ Mem(x, xs)) => set_mem_filter_intro(xs, x, p, both.left, both.right),
        λ (m: Mem(x, xs.filter(p))) => And(xs.mem_filter_holds(x, p, m), xs.mem_filter(x, p, m)))
}

// ---------------------------------------------------------------------------
// Expressions, their environment, and their two readings

// A set expression over indexed leaves: the `k`th atom, the `j`th element
// consed on, the `k`th predicate's filter, the `i`th operation.
inductive SetExpr {
    SAtom(k: Nat),
    SNil,
    SCons(j: Nat, rest: SetExpr),
    SFilter(k: Nat, s: SetExpr),
    SOp(i: Nat, a: SetExpr, b: SetExpr),
}

record SetEnv<A> { sets: List<List<A>>, elts: List<A>, preds: List<A → Bool>, ops: List<SetOp<A>> }

// The leaves' readings, a missing index read as empty (so the two readings
// below agree on it).
fn set_atom<A>(ss: List<List<A>>, k: Nat) → List<A> {
    match ss.nth(k) { None => Nil, Some(s) => s }
}

fn set_cons_at<A>(es: List<A>, j: Nat, rest: List<A>) → List<A> {
    match es.nth(j) { None => rest, Some(a) => Cons(a, rest) }
}

fn set_filter_at<A>(ps: List<A → Bool>, k: Nat, s: List<A>) → List<A> {
    match ps.nth(k) { None => Nil, Some(p) => s.filter(p) }
}

fn set_op_at<A>(os: List<SetOp<A>>, i: Nat, a, b: List<A>) → List<A> {
    match os.nth(i) { None => Nil, Some(o) => o.f(a, b) }
}

fn SetExpr::denote<A>(self e: SetExpr, env: SetEnv<A>) → List<A> {
    match e {
        SAtom(k) => set_atom(env.sets, k),
        SNil => Nil,
        SCons(j, rest) => set_cons_at(env.elts, j, rest.denote(env)),
        SFilter(k, s) => set_filter_at(env.preds, k, s.denote(env)),
        SOp(i, a, b) => set_op_at(env.ops, i, a.denote(env), b.denote(env)),
    }
}

// One assignment of the leaves' bits, and the operations' connectives.
record SetBits { sets: List<Bool>, elts: List<Bool>, preds: List<Bool>, conns: List<SetConn> }

fn set_bit_at(bs: List<Bool>, k: Nat) → Bool {
    match bs.nth(k) { None => False, Some(b) => b }
}

fn set_conn_at(cs: List<SetConn>, i: Nat, a, b: Bool) → Bool {
    match cs.nth(i) { None => False, Some(c) => c.bit(a, b) }
}

fn SetExpr::eval(self e: SetExpr, v: SetBits) → Bool {
    match e {
        SAtom(k) => set_bit_at(v.sets, k),
        SNil => False,
        SCons(j, rest) => set_bit_at(v.elts, j) || rest.eval(v),
        SFilter(k, s) => set_bit_at(v.preds, k) && s.eval(v),
        SOp(i, a, b) => set_conn_at(v.conns, i, a.eval(v), b.eval(v)),
    }
}

// The bits of the element `x`: the real assignment.
fn SetEnv::bits<A>(self env: SetEnv<A>, d: DecEq<A>, x: A) → SetBits {
    SetBits(env.sets.map(λ (s: List<A>) => set_mem_bit(d, x, s)),
        env.elts.map(λ (a: A) => set_eq_bit(d, x, a)),
        env.preds.map(λ (p: A → Bool) => p(x)),
        env.ops.map(λ (o: SetOp<A>) => o.conn))
}

// ---------------------------------------------------------------------------
// At the real assignment, the bit reflects membership

theorem set_atom_reflects<A>(d: DecEq<A>, x: A, ss: List<List<A>>): (k: Nat) →
    Reflects(Mem(x, set_atom(ss, k)), set_bit_at(ss.map(λ (s: List<A>) => set_mem_bit(d, x, s)), k)) {
    match ss {
        Nil => λ k => set_false_reflects(),
        Cons(s, rest) => λ k => match k {
            Zero => set_mem_reflects(d, x, s),
            Succ(i) => set_atom_reflects(d, x, rest, i),
        },
    }
}

theorem set_cons_reflects<A>(d: DecEq<A>, x: A, es: List<A>, ys: List<A>, {y: Bool}, r: Reflects(Mem(x, ys), y)): (j: Nat) →
    Reflects(Mem(x, set_cons_at(es, j, ys)), set_bit_at(es.map(λ (a: A) => set_eq_bit(d, x, a)), j) || y) {
    match es {
        Nil => λ j => r,
        Cons(a, rest) => λ j => match j {
            Zero => reflects_or(or_bit_reflects(d.eq_dec(x, a)), r),
            Succ(i) => set_cons_reflects(d, x, rest, ys, r, i),
        },
    }
}

theorem set_filter_at_reflects<A>(x: A, ps: List<A → Bool>, ys: List<A>, {y: Bool}, r: Reflects(Mem(x, ys), y)): (k: Nat) →
    Reflects(Mem(x, set_filter_at(ps, k, ys)), set_bit_at(ps.map(λ (p: A → Bool) => p(x)), k) && y) {
    match ps {
        Nil => λ k => set_false_reflects(),
        Cons(p, rest) => λ k => match k {
            Zero => set_filter_reflects(ys, x, p, r),
            Succ(i) => set_filter_at_reflects(x, rest, ys, r, i),
        },
    }
}

theorem set_op_reflects<A>(x: A, os: List<SetOp<A>>, as, bs: List<A>, {a, b: Bool}, ra: Reflects(Mem(x, as), a), rb: Reflects(Mem(x, bs), b)):
    (i: Nat) → Reflects(Mem(x, set_op_at(os, i, as, bs)), set_conn_at(os.map(λ (o: SetOp<A>) => o.conn), i, a, b)) {
    match os {
        Nil => λ i => set_false_reflects(),
        Cons(o, rest) => λ i => match i {
            Zero => reflects_iff(o.conn.reflects(ra, rb), (o.law(x, as, bs)).mpr, (o.law(x, as, bs)).mp),
            Succ(k) => set_op_reflects(x, rest, as, bs, ra, rb, k),
        },
    }
}

theorem SetExpr::reflects<A>(self e: SetExpr, env: SetEnv<A>, d: DecEq<A>, x: A):
    Reflects(Mem(x, e.denote(env)), e.eval(env.bits(d, x))) {
    match e {
        SAtom(k) => set_atom_reflects(d, x, env.sets, k),
        SNil => set_false_reflects(),
        SCons(j, rest) => set_cons_reflects(d, x, env.elts, rest.denote(env), rest.reflects(env, d, x), j),
        SFilter(k, s) => set_filter_at_reflects(x, env.preds, s.denote(env), s.reflects(env, d, x), k),
        SOp(i, a, b) => set_op_reflects(x, env.ops, a.denote(env), b.denote(env), a.reflects(env, d, x), b.reflects(env, d, x), i),
    }
}

// ---------------------------------------------------------------------------
// Facts and goals

// A hypothesis at `x`: `x` is in `e`, `x` is not in `e`, or if `x` is in
// `a` then it is in `b` (an inclusion `(i: A) → i ∈ a → i ∈ b` applied to
// `x`, so sets that mention the bound element are read too), or if `x` is
// in `a` then it is not in `b` (`a` and `b` apart at `x`).
inductive SetFact { FMem(e: SetExpr), FNot(e: SetExpr), FImp(a: SetExpr, b: SetExpr), FApart(a: SetExpr, b: SetExpr) }

fn SetFact::Holds<A>(self f: SetFact, env: SetEnv<A>, x: A) → Type {
    match f {
        FMem(e) => Mem(x, e.denote(env)),
        FNot(e) => ¬Mem(x, e.denote(env)),
        FImp(a, b) => Mem(x, a.denote(env)) → Mem(x, b.denote(env)),
        FApart(a, b) => Mem(x, a.denote(env)) → ¬Mem(x, b.denote(env)),
    }
}

fn SetFact::bit(self f: SetFact, v: SetBits) → Bool {
    match f { FMem(e) => e.eval(v), FNot(e) => !e.eval(v), FImp(a, b) => !a.eval(v) || b.eval(v), FApart(a, b) => !a.eval(v) || !b.eval(v) }
}

theorem set_true_of({P: Type}, {b: Bool}, r: Reflects(P, b), p: P): b = True { bool::eq_true_of_is_true(b, reflects_intro(r, p)) }

theorem SetFact::bit_of<A>(self f: SetFact, env: SetEnv<A>, d: DecEq<A>, x: A, h: f.Holds(env, x)): f.bit(env.bits(d, x)) = True {
    match f {
        FMem(e) => set_true_of(e.reflects(env, d, x), h),
        FNot(e) => set_true_of(reflects_not(e.reflects(env, d, x)), h),
        FImp(a, b) => set_true_of(reflects_imp(a.reflects(env, d, x), b.reflects(env, d, x)), h),
        FApart(a, b) => set_true_of(reflects_imp(a.reflects(env, d, x), reflects_not(b.reflects(env, d, x))), h),
    }
}

fn set_facts_hold<A>(fs: List<SetFact>, env: SetEnv<A>, x: A) → Type {
    match fs { Nil => True, Cons(f, rest) => f.Holds(env, x) ∧ set_facts_hold(rest, env, x) }
}

fn set_facts_bit(fs: List<SetFact>, v: SetBits) → Bool {
    match fs { Nil => True, Cons(f, rest) => f.bit(v) && set_facts_bit(rest, v) }
}

theorem set_facts_bit_of<A>(env: SetEnv<A>, d: DecEq<A>, x: A, fs: List<SetFact>): set_facts_hold(fs, env, x) → set_facts_bit(fs, env.bits(d, x)) = True {
    match fs {
        Nil => λ _ => refl,
        Cons(f, rest) => λ h => {
            let first: (f.bit(env.bits(d, x)) = True) = f.bit_of(env, d, x, h.left);
            let later: (set_facts_bit(rest, env.bits(d, x)) = True) = set_facts_bit_of(env, d, x, rest, h.right);
            j(sym(first), λ b _ => (b && set_facts_bit(rest, env.bits(d, x))) = True, later)
        },
    }
}

// The goal: `x` is in `e`, is not in `e`, or nothing (the hypotheses
// contradict each other).
inductive SetGoal { GMem(e: SetExpr), GNot(e: SetExpr), GFalse }

fn SetGoal::Holds<A>(self g: SetGoal, env: SetEnv<A>, x: A) → Type {
    match g { GMem(e) => Mem(x, e.denote(env)), GNot(e) => ¬Mem(x, e.denote(env)), GFalse => False }
}

fn SetGoal::bit(self g: SetGoal, v: SetBits) → Bool {
    match g { GMem(e) => e.eval(v), GNot(e) => !e.eval(v), GFalse => False }
}

theorem SetGoal::holds_of<A>(self g: SetGoal, env: SetEnv<A>, d: DecEq<A>, x: A, h: g.bit(env.bits(d, x)) = True): g.Holds(env, x) {
    match g {
        GMem(e) => e.reflects(env, d, x).left(h),
        GNot(e) => reflects_not(e.reflects(env, d, x)).left(h),
        GFalse => absurd(h),
    }
}

// ---------------------------------------------------------------------------
// Every assignment

fn set_all_bits(n: Nat, f: List<Bool> → Bool) → Bool {
    match n {
        Zero => f(Nil),
        Succ(k) => set_all_bits(k, λ (bs: List<Bool>) => f(Cons(True, bs))) && set_all_bits(k, λ (bs: List<Bool>) => f(Cons(False, bs))),
    }
}

theorem set_and_left({a, b: Bool}): (a && b) = True → a = True {
    match a { True => λ _ => refl, False => λ h => absurd(h) }
}

theorem set_and_right({a, b: Bool}): (a && b) = True → b = True {
    match a { True => λ h => h, False => λ h => absurd(h) }
}

theorem set_all_bits_sound(n: Nat): (f: List<Bool> → Bool) → set_all_bits(n, f) = True → (bs: List<Bool>) → bs.len() = n → f(bs) = True {
    match n {
        Zero => λ f h bs len => match bs {
            Nil => h,
            Cons(_, _) => absurd(len),
        },
        Succ(k) => λ f h bs len => match bs {
            Nil => absurd(len),
            Cons(b, rest) => {
                let tail: (rest.len() = k) = Nat::succ_inj(rest.len(), k, len);
                match hb: b {
                    True => set_all_bits_sound(k, λ (bs: List<Bool>) => f(Cons(True, bs)), set_and_left(h), rest, tail),
                    False => set_all_bits_sound(k, λ (bs: List<Bool>) => f(Cons(False, bs)), set_and_right(h), rest, tail),
                }
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The verdict, and the theorem

// For every assignment of the leaves' bits: the facts imply the goal. Closed
// in everything it reads, so `= True` is proved by `refl`.
fn set_taut(n, m, q: Nat, conns: List<SetConn>, facts: List<SetFact>, goal: SetGoal) → Bool {
    set_all_bits(n, λ (vs: List<Bool>) => set_all_bits(m, λ (ws: List<Bool>) => set_all_bits(q, λ (ps: List<Bool>) =>
        !set_facts_bit(facts, SetBits(vs, ws, ps, conns)) || goal.bit(SetBits(vs, ws, ps, conns)))))
}

theorem set_solve<A>(d: DecEq<A>, env: SetEnv<A>, x: A, facts: List<SetFact>, goal: SetGoal,
    verdict: set_taut(env.sets.len(), env.elts.len(), env.preds.len(), env.ops.map(λ (o: SetOp<A>) => o.conn), facts, goal) = True,
    held: set_facts_hold(facts, env, x)): goal.Holds(env, x) {
    let v: SetBits = env.bits(d, x);
    let conns: List<SetConn> = env.ops.map(λ (o: SetOp<A>) => o.conn);
    let at_v: ((!set_facts_bit(facts, v) || goal.bit(v)) = True) =
        set_all_bits_sound(env.preds.len(), λ (ps: List<Bool>) => !set_facts_bit(facts, SetBits(v.sets, v.elts, ps, conns)) || goal.bit(SetBits(v.sets, v.elts, ps, conns)),
            set_all_bits_sound(env.elts.len(), λ (ws: List<Bool>) => set_all_bits(env.preds.len(), λ (ps: List<Bool>) =>
                    !set_facts_bit(facts, SetBits(v.sets, ws, ps, conns)) || goal.bit(SetBits(v.sets, ws, ps, conns))),
                set_all_bits_sound(env.sets.len(), λ (vs: List<Bool>) => set_all_bits(env.elts.len(), λ (ws: List<Bool>) => set_all_bits(env.preds.len(), λ (ps: List<Bool>) =>
                        !set_facts_bit(facts, SetBits(vs, ws, ps, conns)) || goal.bit(SetBits(vs, ws, ps, conns)))),
                    verdict, v.sets, env.sets.len_map(λ (s: List<A>) => set_mem_bit(d, x, s))),
                v.elts, env.elts.len_map(λ (a: A) => set_eq_bit(d, x, a))),
            v.preds, env.preds.len_map(λ (p: A → Bool) => p(x)));
    let facts_true: (set_facts_bit(facts, v) = True) = set_facts_bit_of(env, d, x, facts, held);
    let goal_true: (goal.bit(v) = True) = j(facts_true, λ b _ => (!b || goal.bit(v)) = True, at_v);
    goal.holds_of(env, d, x, goal_true)
}

// The membership hypothesis/goal helpers a tactic names as globals: lists
// and the facts' proofs (`Lookup` names functions, not constructors).
fn set_list_nil<B>() → List<B> { Nil }
fn set_list_cons<B>(h: B, t: List<B>) → List<B> { Cons(h, t) }
fn set_env<A>(sets: List<List<A>>, elts: List<A>, preds: List<A → Bool>, ops: List<SetOp<A>>) → SetEnv<A> { SetEnv(sets, elts, preds, ops) }
fn set_op<A>(f: List<A> → List<A> → List<A>, conn: SetConn, law: SetLaw(f, conn)) → SetOp<A> { SetOp(f, conn, law) }
fn set_or() → SetConn { SetOr }
fn set_and() → SetConn { SetAnd }
fn set_diff() → SetConn { SetDiff }
fn set_atom_e(k: Nat) → SetExpr { SAtom(k) }
fn set_nil_e() → SetExpr { SNil }
fn set_cons_e(j: Nat, rest: SetExpr) → SetExpr { SCons(j, rest) }
fn set_filter_e(k: Nat, s: SetExpr) → SetExpr { SFilter(k, s) }
fn set_op_e(i: Nat, a, b: SetExpr) → SetExpr { SOp(i, a, b) }
fn set_fact_mem(e: SetExpr) → SetFact { FMem(e) }
fn set_fact_not(e: SetExpr) → SetFact { FNot(e) }
fn set_fact_imp(a, b: SetExpr) → SetFact { FImp(a, b) }
fn set_fact_apart(a, b: SetExpr) → SetFact { FApart(a, b) }
fn set_goal_mem(e: SetExpr) → SetGoal { GMem(e) }
fn set_goal_not(e: SetExpr) → SetGoal { GNot(e) }
fn set_goal_false() → SetGoal { GFalse }
// The dictionary type the tactic asks `Synth` for: a class is not a term
// a tactic can quote, a function returning its instance type is.
fn set_dec_eq_type(A: Type) → Type { DecEq<A> }
// The element types of the environment's lists, for the same reason.
fn set_list_type(A: Type) → Type { List<A> }
fn set_pred_type(A: Type) → Type { A → Bool }
fn set_op_type(A: Type) → Type { SetOp<A> }
fn set_fact_type() → Type { SetFact }

theorem set_held_nil(): True { trivial }
// An element the tactic finds equal to `x` by conversion is the fact
// `x ∈ [e]`; a hypothesis `¬(x = e)` is the fact `x ∉ [e]`.
theorem set_mem_self<A>(x: A): Mem(x, [x]) { Inl(refl) }
theorem set_not_single<A>(x, y: A, n: ¬(x = y)): ¬Mem(x, [y]) {
    λ (m: Mem(x, [y])) => match m { Inl(e) => n(e), Inr(f) => f }
}
theorem set_not_single_sym<A>(x, y: A, n: ¬(y = x)): ¬Mem(x, [y]) {
    λ (m: Mem(x, [y])) => match m { Inl(e) => n(sym(e)), Inr(f) => f }
}
theorem set_held_cons({P, Q: Type}, p: P, q: Q): P ∧ Q { And(p, q) }
theorem set_mem_of_eq<A>(x, y: A, h: x = y): Mem(x, [y]) { Inl(h) }
theorem set_mem_of_eq_sym<A>(x, y: A, h: y = x): Mem(x, [y]) { Inl(sym(h)) }

// ---------------------------------------------------------------------------
// Membership spelled as a Boolean

// A Boolean spelling of membership: `f(x, s)` reflects `x ∈ s`, or, when
// `negated`, `!f(x, s)` does (`absent(x, s)` is `x ∉ s`). A module that
// spells membership so registers the law (`SetBitEntry`,
// lib/std/data/set/set_ops.hthr), and the `sets` tactic reads `f(x, s) =
// True`, `= False` and `.IsTrue()` through it, as hypotheses and as goals.
fn SetBitLaw<A>(f: A → List<A> → Bool, negated: Bool) → Type {
    (x: A) → (s: List<A>) → Reflects(Mem(x, s), match negated { False => f(x, s), True => !f(x, s) })
}

// From a spelling to membership, `b` being the spelled bit read as `x ∈ s`.
theorem set_spell_true<A>(x: A, s: List<A>, b: Bool, r: Reflects(Mem(x, s), b), h: b = True): Mem(x, s) { r.left(h) }
theorem set_spell_false<A>(x: A, s: List<A>, b: Bool, r: Reflects(Mem(x, s), b), h: b = False): ¬Mem(x, s) { r.right(h) }

// From membership to the spelling.
theorem set_spell_is_true<A>(x: A, s: List<A>, b: Bool, r: Reflects(Mem(x, s), b), p: Mem(x, s)): b = True { set_true_of(r, p) }
theorem set_spell_is_false<A>(x: A, s: List<A>, b: Bool, r: Reflects(Mem(x, s), b), np: ¬Mem(x, s)): b = False {
    (match b as λ c => Reflects(Mem(x, s), c) → c = False {
        False => λ _ => refl,
        True => λ (r2: Reflects(Mem(x, s), True)) => false_elim(np(r2.left(refl))),
    })(r)
}

// A negation read through: `!!u` reflects what `u` does.
theorem set_reflects_not_not<A>(x: A, s: List<A>, u: Bool, r: Reflects(Mem(x, s), u)): Reflects(Mem(x, s), !!u) {
    (match u as λ c => Reflects(Mem(x, s), c) → Reflects(Mem(x, s), !!c) {
        False => λ r2 => r2,
        True => λ r2 => r2,
    })(r)
}

// The bit facts the tactic moves between.
theorem set_not_of_true(b: Bool, h: b = True): !b = False { j(sym(h), λ c _ => !c = False, refl) }
theorem set_not_of_false(b: Bool, h: b = False): !b = True { j(sym(h), λ c _ => !c = True, refl) }
theorem set_true_of_not_false(b: Bool, h: !b = False): b = True {
    (match b as λ c => !c = False → c = True { True => λ _ => refl, False => λ bad => absurd(bad) })(h)
}
theorem set_false_of_not_true(b: Bool, h: !b = True): b = False {
    (match b as λ c => !c = True → c = False { False => λ _ => refl, True => λ bad => absurd(bad) })(h)
}
theorem set_eq_true_of_is(b: Bool, h: b.IsTrue()): b = True { bool::eq_true_of_is_true(b, h) }
theorem set_is_of_eq_true(b: Bool, h: b = True): b.IsTrue() { j(sym(h), λ c _ => c.IsTrue(), trivial) }

// A fact about an element `x` is equal to, moved to `x`.
theorem set_mem_transport<A>(x, y: A, s: List<A>, e: x = y, h: Mem(y, s)): Mem(x, s) { j(sym(e), λ z _ => Mem(z, s), h) }
theorem set_not_transport<A>(x, y: A, s: List<A>, e: x = y, h: ¬Mem(y, s)): ¬Mem(x, s) { j(sym(e), λ z _ => ¬Mem(z, s), h) }
theorem set_eq_sym<A>(x, y: A, e: y = x): x = y { sym(e) }

// An inclusion whose conclusion is a spelling, read as membership: the
// spelling's conversion after the inclusion.
theorem set_comp({P, Q, R: Type}, f: Q → R, g: P → Q): P → R { λ (p: P) => f(g(p)) }

// The spellings the `sets` tactic (lib/std/tactic/set_tactic.hthr) reads
// beside the carriers and operations it finds by instance
// (lib/std/data/set/dec_set.hthr): its registry entries
// (docs/registered-values-design.md) for Boolean spellings of list
// membership that are not a carrier's own `has`, relations between two sets,
// and equalities between elements. Only the entry types live here, so a
// theory module can import this without the tactic.

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;
import set_solve;

// A Boolean spelling of list membership by name, its law (a `SetBitLaw`, by
// `name_of`), whether the law reads the negation, and `implicits`, the
// implicit parameters the function and its law both open with (an element
// type, say), which the tactic leaves to inference; the law takes nothing
// else.
record SetBitEntry { op: String, law: String, negated: Bool, implicits: Nat }

// A Boolean spelling of a relation between two sets (`a.within(b)`,
// `disjoint(xs, ys)`) by name, with its two laws by `name_of`: `elim(a, b,
// h: f(a, b).IsTrue())` proves a function type the tactic reads at each
// element (an inclusion, or one whose conclusion is a non-membership or a
// spelling), and `intro(a, b, h)` proves `f(a, b).IsTrue()` from that same
// function type. `implicits` is as for `SetBitEntry`.
record SetRelEntry { op: String, elim: String, intro: String, implicits: Nat }

// A Boolean spelling of equality between two elements by name, its law (a
// `SetEqLaw`, by `name_of`), whether the law reads the negation, and the
// implicit parameters, as for `SetBitEntry`.
record SetEqEntry { op: String, law: String, negated: Bool, implicits: Nat }

// `Fin(n)`, the kernel's type of indices below `n`: its successor as a
// function, the constructors' injectivity and apartness, and the list of all
// its elements. `Fin(n)` reduces to `Empty` or `Unit + Fin(k)`, so a `match`
// on an index is written under a `match` on the length
// (docs/surface-fin-indexing-design.md §1.2); every recursion here is on `n`.

import logic;
import nat;
import list;

// `FS` needs an expected type; this is the function a `map` takes.
fn Fin::succ({n: Nat}, i: Fin(n)) → Fin(Succ(n)) { FS(i) }

fn Fin::pred_or({n: Nat}, i: Fin(Succ(n)), d: Fin(n)) → Fin(n) { match i { FZ => d, FS(k) => k } }

fn Fin::is_zero({n: Nat}, i: Fin(Succ(n))) → Type { match i { FZ => True, FS(_) => False } }

// Injectivity by a predecessor with a default, apartness by a type-valued
// test: neither needs a `match` on an equation.
theorem Fin::succ_inj({n: Nat}, a, b: Fin(n), e: Fin::succ(a) = Fin::succ(b)): a = b {
    cong_fn(λ (i: Fin(Succ(n))) => Fin::pred_or(i, a), e)
}

theorem Fin::zero_ne_succ({n: Nat}, a: Fin(n)): ¬(FZ = Fin::succ(a)) {
    λ (p: (FZ = Fin::succ(a))) => j(p, λ y q => Fin::is_zero(y), trivial)
}

// Every index below `n`, in increasing order.
fn Fin::all(n: Nat) → List<Fin(n)> {
    match n { Zero => Nil, Succ(k) => Cons(FZ, Fin::all(k).map(λ (i: Fin(k)) => Fin::succ(i))) }
}

theorem Fin::all_complete(n: Nat): (i: Fin(n)) → Mem(i, Fin::all(n)) {
    match n {
        Zero => λ i => match i {},
        Succ(k) => λ i => match i {
            FZ => Inl(refl),
            FS(j) => Inr(Fin::all(k).mem_map(j, λ (i: Fin(k)) => Fin::succ(i), Fin::all_complete(k, j))),
        },
    }
}

theorem Fin::all_nodup(n: Nat): Fin::all(n).NoDup() {
    match n {
        Zero => trivial,
        Succ(k) => And(
            λ m => match Fin::all(k).mem_map_inv(λ (i: Fin(k)) => Fin::succ(i), FZ, m) {
                Exists(a, w) => Fin::zero_ne_succ(a, sym(w.right)),
            },
            Fin::all(k).nodup_map(λ (i: Fin(k)) => Fin::succ(i), λ a b e => Fin::succ_inj(a, b, e), Fin::all_nodup(k))),
    }
}

theorem Fin::len_all(n: Nat): Fin::all(n).len() = n {
    match n {
        Zero => refl,
        Succ(k) => cong_fn(λ (m: Nat) => Succ(m), trans(Fin::all(k).len_map(λ (i: Fin(k)) => Fin::succ(i)), Fin::len_all(k))),
    }
}

// Equality of indices decides, by recursion on the length.
fn Fin::eq_dec(n: Nat) → (a, b: Fin(n)) → a = b ∨ ¬(a = b) {
    match n {
        Zero => λ a b => match a {},
        Succ(k) => λ a b => match a {
            FZ => match b {
                FZ => Inl(refl),
                FS(j) => Inr(Fin::zero_ne_succ(j)),
            },
            FS(i) => match b {
                FZ => Inr(λ e => Fin::zero_ne_succ(i, sym(e))),
                FS(j) => match Fin::eq_dec(k, i, j) {
                    Inl(e) => Inl(cong_fn(λ (x: Fin(k)) => Fin::succ(x), e)),
                    Inr(ne) => Inr(λ e => ne(Fin::succ_inj(i, j, e))),
                },
            },
        },
    }
}

instance(n: Nat) DecEq<Fin(n)> { eq_dec := Fin::eq_dec(n) }

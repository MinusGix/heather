// Public parser interface. Implementations and proofs live in parser/.
export parser_core::{
    Cursor, rest, Success, Retry,
    Failure, ErrorView, Reply, Parser,
    observe, initial_rest, CachedCursor, cache, cached_rest,
    drop_length_le, drop_length_strict, drop_add
};
export parser_combinators::{
    pure_at, pure, map_at, map, rebase,
    bind_at, bind, Dep, bindD, map_identity,
    map_composition, then, before, choice_at, choice,
    optional, lookahead_at, lookahead, map_bound, map_consumes,
    lookahead_zero, map_post, map_sound, or_at, PureSpec,
    pure_sound, rebase_post, bind_post, bind_sound, add_progress,
    rebase_bound, bind_bound, bind_consumes, choice_bound, choice_consumes,
    rebase_same, rebase_associativity, bind_left_unit, bind_right_unit, bind_rebase,
    bind_associativity, choice_post, choice_sound, certified_map_at, certified_finish_at,
    certified_finish_forget, certified_map_forget
};
export parser_contracts::{
    Bound, Consumes, bound_on_success, Post, Sound,
    post_on_success, weaken_bound, weaken_consumes, Certified, certify_at,
    zero_bound, consumes_zero, forget_at, forget_post, CompleteSpec
};
export parser_diagnostics::{
    committed, commit_offsets, commit_after, attempt_at, attempt,
    commit_at, commit, insert_expected, merge_expected, merge_error,
    attempt_bound, attempt_consumes, attempt_idempotent, commit_same, commit_later,
    commit_not_later, commit_absorbs, no_total_progress, commit_chain, commit_bound,
    commit_consumes
};
export parser_primitives::{
    fail_at, fail, recognize_at, recognize, token,
    eof_at, eof, complete, recognize_bound, recognize_consumes,
    token_consumes, Selects, Recognized, recognize_post, recognize_sound,
    fail_consumes, SelectedHead, selected_head, RecognizedHead, recognized_head,
    complete_post, complete_sound, recognize_certified, recognized_progress
};
export parser_recursion::{
    guarded, progress_after, extend_at, after_at
};
export parser_repetition::{
    many_at, many, some, Counted, repeat_at,
    repeatN, some_consumes
};

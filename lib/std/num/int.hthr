import nat;
import logic;
import bool;
import relation;
import relation_props;
import algebra_rel;
import algebra;
import morphism;

inductive Int { OfNat(n: Nat), NegSucc(n: Nat) }

// Congruence helpers for the two relevant arrows and the two constructors.
// They remain explicit where the surrounding chain does not determine the
// one-place context (issues/congruence-by-anti-unification.md).
theorem Int::cong(f: Int → Int, {a, b: Int}, p: a = b): f(a) = f(b) {
    rewrite(p, refl)
}

theorem Int::cong_of(f: Nat → Int, {a, b: Nat}, p: a = b): f(a) = f(b) {
    rewrite(p, refl)
}

theorem Int::cong_ofnat({a, b: Nat}, p: a = b): OfNat(a) = OfNat(b) {
    rewrite(p, refl)
}

theorem Int::cong_negsucc({a, b: Nat}, p: a = b): NegSucc(a) = NegSucc(b) {
    rewrite(p, refl)
}

// ---------------------------------------------------------------------------
// Negation, and the embedding of `Nat`.
//
// `negOfNat` is `-n` written as an integer, and it is the function `neg` is
// defined by rather than a helper beside it: `neg(OfNat(n))` IS `negOfNat(n)`,
// so a `NegSucc` in any statement below can be read as a negated `OfNat`
// without a lemma.

fn Int::negOfNat(n: Nat) → Int { match n { Zero => OfNat(0), Succ(k) => NegSucc(k) } }

fn Int::neg(self a: Int) → Int {
    match a {
        OfNat(n) => Int::negOfNat(n),
        NegSucc(n) => OfNat(Succ(n)),
    }
}

designation prefix - at Int := Int::neg

// Truncated, exactly as `nat::sub` is: the integers below zero have no `Nat`,
// so they land on `0` and the embedding lemma below carries the hypothesis that
// says when that is lossless.
fn Int::toNat(self a: Int) → Nat { match a { OfNat(n) => n, NegSucc(_) => 0 } }

// An integer as the difference of two naturals, at most one of them nonzero:
// `a = a.pos_part() - a.neg_part()` (`Int::pos_sub_neg`). Unlike `toNat`
// and `-a`, the split needs no case analysis by its client, and the Nat
// halves are atoms that `omega` reasons about through that equation.
fn Int::pos_part(self a: Int) → Nat { a.toNat() }

fn Int::neg_part(self a: Int) → Nat { match a { OfNat(_) => 0, NegSucc(k) => Succ(k) } }

theorem Int::toNat_ofNat(n: Nat): OfNat(n).toNat() = n { refl }

theorem Int::neg_negOfNat(n: Nat): -Int::negOfNat(n) = OfNat(n) {
    match n { Zero => refl, Succ(_) => refl }
}

// Involutive by case analysis on the integer and, for `OfNat`, its payload.
theorem Int::neg_neg(self a: Int): -(-a) = a {
    match a {
        OfNat(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
        NegSucc(_) => refl,
    }
}

theorem Int::neg_ofNat_succ(n: Nat): -OfNat(Succ(n)) = NegSucc(n) { refl }

// ---------------------------------------------------------------------------

// TODO(minus) rename to succ/pred as we only used isucc/ipred due to nat
fn Int::isucc(self a: Int) → Int {
    match a {
        OfNat(n) => OfNat(Succ(n)),
        NegSucc(n) => match n { Zero => OfNat(0), Succ(k) => NegSucc(k) },
    }
}

fn Int::ipred(self a: Int) → Int {
    match a {
        OfNat(n) => match n { Zero => NegSucc(0), Succ(k) => OfNat(k) },
        NegSucc(n) => NegSucc(Succ(n)),
    }
}

theorem Int::isucc_ipred(self a: Int): a.ipred().isucc() = a {
    match a {
        OfNat(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
        NegSucc(_) => refl,
    }
}

theorem Int::ipred_isucc(self a: Int): a.isucc().ipred() = a {
    match a {
        OfNat(_) => refl,
        NegSucc(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
    }
}

theorem Int::ipred_negOfNat(self n: Nat): Int::negOfNat(n).ipred() = NegSucc(n) {
    match n { Zero => refl, Succ(_) => refl }
}

theorem Int::neg_isucc(self a: Int): -a.isucc() = (-a).ipred() {
    match a {
        OfNat(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
        NegSucc(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
    }
}

theorem Int::neg_ipred(self a: Int): -a.ipred() = (-a).isucc() {
    match a {
        OfNat(n) => match n {
            Zero => refl,
            Succ(_) => refl,
        },
        NegSucc(_) => refl,
    }
}

// ---------------------------------------------------------------------------

fn Int::subNatNat(m, n: Nat) → Int {
    match m {
        Zero => Int::negOfNat(n),
        Succ(k) => match n { Zero => OfNat(Succ(k)), Succ(l) => Int::subNatNat(k, l) },
    }
}

fn Int::add(self a: Int, b: Int) → Int {
    match a {
        OfNat(m) => match b {
            OfNat(n) => OfNat(m + n),
            NegSucc(n) => Int::subNatNat(m, Succ(n)),
        },
        NegSucc(m) => match b {
            OfNat(n) => Int::subNatNat(n, Succ(m)),
            NegSucc(n) => NegSucc(Succ(m + n)),
        },
    }
}

designation + at Int := Int::add

fn Int::sub(self a: Int, b: Int) → Int { a + -b }

designation - at Int := Int::sub

// `subNatNat`'s own facts: the right zero, `isucc`/`ipred` moving a `Succ`
// between the payloads, and the diagonal. The synchronized spelling asks for
// an induction on `m` with `n` generalized, and the `Succ`/`Succ` arm of each
// is the hypothesis by computation.

theorem Int::subNatNat_zero(m: Nat): Int::subNatNat(m, 0) = OfNat(m) {
    match m { Zero => refl, Succ(_) => refl }
}

theorem Int::isucc_subNatNat(m: Nat): (n: Nat) → Int::subNatNat(m, Succ(n)).isucc() = Int::subNatNat(m, n) {
    match m {
        Zero => λ n => match n { Zero => refl, Succ(_) => refl },
        Succ(k, ih) => λ n =>
            match n {
                Zero => Int::cong(Int::isucc, Int::subNatNat_zero(k)),
                Succ(l) => ih(l),
            },
    }
}

theorem Int::ipred_subNatNat(m: Nat): (n: Nat) → Int::subNatNat(m, n).ipred() = Int::subNatNat(m, Succ(n)) {
    match m {
        Zero => λ n => Int::ipred_negOfNat(n),
        Succ(k, ih) => λ n =>
            match n {
                Zero => sym(Int::subNatNat_zero(k)),
                Succ(l) => ih(l),
            },
    }
}

theorem Int::subNatNat_self(n: Nat): Int::subNatNat(n, n) = OfNat(0) {
    match n { Zero => refl, Succ(k) => Int::subNatNat_self(k) }
}

theorem Int::add_zero(self a: Int): a + OfNat(0) = a {
    match a { OfNat(_) => refl, NegSucc(_) => refl }
}

theorem Int::zero_add(self a: Int): OfNat(0) + a = a {
    match a { OfNat(n) => Int::cong_ofnat(n.add_left_zero()), NegSucc(_) => refl }
}

theorem Int::add_ofnat_ofnat(m, n: Nat): OfNat(m) + OfNat(n) = OfNat(m + n) { refl }

theorem Int::add_isucc(self a, b: Int): a + b.isucc() = (a + b).isucc() {
    match a {
        OfNat(m) => match b {
            OfNat(_) => refl,
            NegSucc(n) => match n {
                Zero => sym(trans(Int::isucc_subNatNat(m, 0), Int::subNatNat_zero(m))),
                Succ(l) => sym(Int::isucc_subNatNat(m, Succ(l))),
            },
        },
        NegSucc(m) => match b {
            OfNat(n) => sym(Int::isucc_subNatNat(n, m)),
            NegSucc(n) => match n { Zero => refl, Succ(_) => refl },
        },
    }
}

theorem Int::add_ipred(self a, b: Int): a + b.ipred() = (a + b).ipred() {
    match a {
        OfNat(m) => match b {
            OfNat(n) => match n {
                Zero => sym(trans(Int::cong(Int::ipred, sym(Int::subNatNat_zero(m))), Int::ipred_subNatNat(m, 0))),
                Succ(_) => refl,
            },
            NegSucc(n) => sym(Int::ipred_subNatNat(m, Succ(n))),
        },
        NegSucc(m) => match b {
            OfNat(n) => match n {
                Zero => refl,
                Succ(l) => sym(Int::ipred_subNatNat(l, m)),
            },
            NegSucc(_) => refl,
        },
    }
}

theorem Int::add_comm(self a, b: Int): a + b = b + a {
    match a {
        OfNat(m) => match b {
            OfNat(n) => Int::cong_ofnat(m.add_comm(n)),
            NegSucc(_) => refl,
        },
        NegSucc(m) => match b {
            OfNat(_) => refl,
            NegSucc(n) => Int::cong_negsucc(Nat::cong_succ(m.add_comm(n))),
        },
    }
}

theorem Int::isucc_add(self a, b: Int): a.isucc() + b = (a + b).isucc() {
    apply trans;
    give a.isucc().add_comm(b);
    apply trans;
    give b.add_isucc(a);
    Int::cong(Int::isucc, b.add_comm(a))
}

theorem Int::ipred_add(self a, b: Int): a.ipred() + b = (a + b).ipred() {
    apply trans;
    give a.ipred().add_comm(b);
    apply trans;
    give b.add_ipred(a);
    Int::cong(Int::ipred, b.add_comm(a))
}

theorem Int::add_one(self a: Int): a + OfNat(1) = a.isucc() {
    trans(a.add_isucc(OfNat(0)), Int::cong(Int::isucc, a.add_zero()))
}

theorem Int::add_neg_one(self a: Int): a + NegSucc(0) = a.ipred() {
    trans(a.add_ipred(OfNat(0)), Int::cong(Int::ipred, a.add_zero()))
}
// ---------------------------------------------------------------------------
// The induction principle. `Int` has no structural recursion of its own — it is
// a two-constructor NON-recursive declaration whose payloads are `Nat`s — so
// the recursion that proves anything about every integer descends on a payload,
// and the guard rightly refuses to call that a descent on the integer.
// The motive is a value parameter (`P: Int → Type`), so every use spells it.
// That is one line per law and it is also the documentation of what the
// induction is over, which is why nothing here tries to infer it.

theorem Int::ofnat_part(P: Int → Type, z: P(OfNat(0)),
                   up: (k: Nat) → P(OfNat(k)) → P(OfNat(Succ(k))), n: Nat): P(OfNat(n)) {
    match n {
        Zero => z,
        Succ(k) => up(k, Int::ofnat_part(P, z, up, k)),
    }
}

theorem Int::negsucc_part(P: Int → Type, d: P(NegSucc(0)),
                     dn: (k: Nat) → P(NegSucc(k)) → P(NegSucc(Succ(k))), n: Nat): P(NegSucc(n)) {
    match n {
        Zero => d,
        Succ(k) => dn(k, Int::negsucc_part(P, d, dn, k)),
    }
}

// `z`/`up` climb the non-negative half from `0`; `d`/`dn` descend the negative
// half from `-1`. Two base cases rather than one, because the two halves of the
// encoding are two constructors and neither reaches the other by a step.
theorem Int::ind(P: Int → Type,
                z: P(OfNat(0)),
                up: (k: Nat) → P(OfNat(k)) → P(OfNat(Succ(k))),
                d: P(NegSucc(0)),
                dn: (k: Nat) → P(NegSucc(k)) → P(NegSucc(Succ(k))),
                a: Int): P(a) {
    match a {
        OfNat(n) => Int::ofnat_part(P, z, up, n),
        NegSucc(n) => Int::negsucc_part(P, d, dn, n),
    }
}

// ---------------------------------------------------------------------------

theorem Int::add_assoc(self a, b, c: Int): (a + b) + c = a + (b + c) {
    Int::ind(λ (z: Int) => (a + b) + z = a + (b + z),
        trans((a + b).add_zero(), sym(Int::cong(λ (w: Int) => a + w, b.add_zero()))),
        (k: Nat) (ih: (a + b) + OfNat(k) = a + (b + OfNat(k))) ⊢
            apply trans;
            give (a + b).add_isucc(OfNat(k));
            apply trans;
            give Int::cong(Int::isucc, ih);
            apply trans;
            give sym(a.add_isucc(b + OfNat(k)));
            Int::cong(λ (w: Int) => a + w, sym(b.add_isucc(OfNat(k)))),
        apply trans;
        give (a + b).add_neg_one();
        apply trans;
        give sym(a.add_ipred(b));
        Int::cong(λ (w: Int) => a + w, sym(b.add_neg_one())),
        (k: Nat) (ih: (a + b) + NegSucc(k) = a + (b + NegSucc(k))) ⊢
            apply trans;
            give (a + b).add_ipred(NegSucc(k));
            apply trans;
            give Int::cong(Int::ipred, ih);
            apply trans;
            give sym(a.add_ipred(b + NegSucc(k)));
            Int::cong(λ (w: Int) => a + w, sym(b.add_ipred(NegSucc(k)))),
        c)
}

theorem Int::add_neg(self a: Int): a + -a = OfNat(0) {
    match a {
        OfNat(n) => match n {
            Zero => refl,
            Succ(k) => Int::subNatNat_self(k),
        },
        NegSucc(n) => Int::subNatNat_self(n),
    }
}

theorem Int::neg_add_self(a: Int): -a + a = OfNat(0) {
    trans((-a).add_comm(a), a.add_neg())
}

theorem Int::neg_add(self a, b: Int): -(a + b) = -a + -b {
    Int::ind(λ (z: Int) => -(a + z) = -a + -z,
        trans(Int::cong(Int::neg, a.add_zero()), sym((-a).add_zero())),
        λ (k: Nat) (ih: -(a + OfNat(k)) = -(a) + -(OfNat(k))) =>
            calc {
                -(a + OfNat(Succ(k)))
                    = -(a + OfNat(k)).isucc()      := Int::cong(Int::neg, a.add_isucc(OfNat(k))),
                    = (-(a + OfNat(k))).ipred()      := (a + OfNat(k)).neg_isucc(),
                    = (-a + -OfNat(k)).ipred() := prelude::cong(ih),
                    = -a + Int::negOfNat(k).ipred()   := sym((-a).add_ipred(Int::negOfNat(k))),
                    = -a + NegSucc(k)           := prelude::cong(Int::ipred_negOfNat(k)),
            },
        apply trans;
        give Int::cong(Int::neg, a.add_neg_one());
        apply trans;
        give a.neg_ipred();
        sym((-a).add_one()),
        (k: Nat) (ih: -(a + NegSucc(k)) = -a + -NegSucc(k)) ⊢
            apply trans;
            give Int::cong(Int::neg, a.add_ipred(NegSucc(k)));
            apply trans;
            give (a + NegSucc(k)).neg_ipred();
            apply trans;
            give Int::cong(Int::isucc, ih);
            sym((-a).add_isucc(OfNat(Succ(k)))),
        b)
}

theorem Int::sub_self(self a: Int): a - a = OfNat(0) { a.add_neg() }

theorem Int::sub_zero(self a: Int): a - OfNat(0) = a { a.add_zero() }

// ---------------------------------------------------------------------------

fn Int::mul(self a: Int, b: Int) → Int {
    match a {
        OfNat(m) => match b {
            OfNat(n) => OfNat(m * n),
            NegSucc(n) => Int::negOfNat(m * Succ(n)),
        },
        NegSucc(m) => match b {
            OfNat(n) => Int::negOfNat(Succ(m) * n),
            NegSucc(n) => OfNat(Succ(m) * Succ(n)),
        },
    }
}

designation * at Int := Int::mul

// ---------------------------------------------------------------------------
// Euclidean division.  A nonzero divisor uses its positive magnitude, so the
// remainder is always non-negative and strictly below that magnitude.  The
// sign of the divisor changes only the quotient.  At zero we use the same
// total convention as `Nat`: quotient zero, remainder the dividend.  The
// magnitudes divide by long division (`Nat::ldiv`), one step per quotient
// bit, so a quotient of a wide numerator evaluates (a 60-bit real's term is
// one).

inductive DivMod { MkIntDivMod(quotient: Int, remainder: Int) }

fn Int::divmod_nonneg(dividend: Nat, divisor_pred: Nat) → DivMod {
    match dividend.ldiv(Succ(divisor_pred)) {
        MkDivMod(quotient, remainder) =>
            MkIntDivMod(OfNat(quotient), OfNat(remainder)),
    }
}

fn Int::divmod_negative(dividend_pred: Nat, divisor_pred: Nat) → DivMod {
    match Succ(dividend_pred).ldiv(Succ(divisor_pred)) {
        MkDivMod(quotient, remainder) => match remainder {
            Zero => MkIntDivMod(Int::negOfNat(quotient), OfNat(0)),
            Succ(_) => MkIntDivMod(
                NegSucc(quotient),
                OfNat(Succ(divisor_pred) - remainder),
            ),
        },
    }
}

fn Int::divmod_positive(self dividend: Int, divisor_pred: Nat) → DivMod {
    match dividend {
        OfNat(n) => Int::divmod_nonneg(n, divisor_pred),
        NegSucc(n) => Int::divmod_negative(n, divisor_pred),
    }
}

fn DivMod::negate_divmod_quotient(self state: DivMod) → DivMod {
    match state {
        MkIntDivMod(quotient, remainder) => MkIntDivMod(-quotient, remainder),
    }
}

fn Int::divmod(self dividend: Int, divisor: Int) → DivMod {
    match divisor {
        OfNat(n) => match n {
            Zero => MkIntDivMod(OfNat(0), dividend),
            Succ(k) => Int::divmod_positive(dividend, k),
        },
        NegSucc(k) => Int::divmod_positive(dividend, k).negate_divmod_quotient(),
    }
}

fn Int::div(self dividend: Int, divisor: Int) → Int {
    match dividend.divmod(divisor) { MkIntDivMod(quotient, _) => quotient }
}

fn Int::mod(self dividend: Int, divisor: Int) → Int {
    match dividend.divmod(divisor) { MkIntDivMod(_, remainder) => remainder }
}

fn Int::natAbs(self a: Int) → Nat {
    match a { OfNat(n) => n, NegSucc(n) => Succ(n) }
}

fn Int::abs(self a: Int) → Int { OfNat(a.natAbs()) }

// `OfNat` is injective: `natAbs` reads the payload back.
theorem Int::ofnat_inj({a, b: Nat}, p: OfNat(a) = OfNat(b)): a = b {
    let read: (a = OfNat(b).natAbs()) = rewrite(sym(p), refl);
    read
}

theorem Int::ofnat_ne({a, b: Nat}, h: a ≠ b): OfNat(a) ≠ OfNat(b) {
    λ (p: OfNat(a) = OfNat(b)) => h(Int::ofnat_inj(p))
}

fn DivModEquation(dividend, divisor: Int, state: DivMod) → Type {
    match state {
        MkIntDivMod(quotient, remainder) =>
            quotient * divisor + remainder = dividend,
    }
}

theorem Int::mul_comm(self a, b: Int): a * b = b * a {
    match a {
        OfNat(m) => match b {
            OfNat(n) => Int::cong_ofnat(m.mul_comm(n)),
            NegSucc(n) => Int::cong_of(Int::negOfNat, m.mul_comm(Succ(n))),
        },
        NegSucc(m) => match b {
            OfNat(n) => Int::cong_of(Int::negOfNat, Succ(m).mul_comm(n)),
            NegSucc(n) => Int::cong_ofnat(Succ(m).mul_comm(Succ(n))),
        },
    }
}

theorem Int::mul_zero(self a: Int): a * OfNat(0) = OfNat(0) {
    match a { OfNat(_) => refl, NegSucc(_) => refl }
}

theorem Int::zero_mul(self a: Int): OfNat(0) * a = OfNat(0) {
    trans(OfNat(0).mul_comm(a), a.mul_zero())
}

theorem Int::mul_one(self a: Int): a * OfNat(1) = a {
    match a {
        OfNat(m) => Int::cong_ofnat(m.add_left_zero()),
        NegSucc(m) => Int::cong_of(Int::negOfNat, Succ(m).add_left_zero()),
    }
}

theorem Int::one_mul(self a: Int): OfNat(1) * a = a {
    trans(OfNat(1).mul_comm(a), a.mul_one())
}

theorem Int::mul_neg_r(self a, b: Int): a * -b = -(a * b) {
    match a {
        OfNat(m) => match b {
            OfNat(n) =>
                match n {
                    Zero => refl,
                    Succ(_) => refl,
                },
            NegSucc(n) => sym(Int::neg_negOfNat(m * Succ(n))),
        },
        NegSucc(m) => match b {
            OfNat(n) =>
                match n {
                    Zero => refl,
                    Succ(k) => sym(Int::neg_negOfNat(Succ(m) * Succ(k))),
                },
            NegSucc(_) => refl,
        },
    }
}

theorem Int::mul_neg_l(self a, b: Int): -a * b = -(a * b) {
    calc {
        -a * b
            = b * -a := (-a).mul_comm(b),
            = -(b * a) := b.mul_neg_r(a),
            = -(a * b) := prelude::cong(b.mul_comm(a)),
    }
}

theorem Int::mul_assoc(self a, b, c: Int): (a * b) * c = a * (b * c) {
    match a {
        OfNat(m) => match b {
            OfNat(n) => match c {
                OfNat(p) => Int::cong_ofnat(m.mul_assoc(n, p)),
                NegSucc(p) =>
                    apply trans;
                    give Int::cong_of(Int::negOfNat, m.mul_assoc(n, Succ(p)));
                    sym(OfNat(m).mul_neg_r(OfNat(n * Succ(p)))),
            },
            NegSucc(n) => match c {
                OfNat(p) => calc {
                    (OfNat(m) * NegSucc(n)) * OfNat(p)
                        = -OfNat((m * Succ(n)) * p)
                            := OfNat(m * Succ(n)).mul_neg_l(OfNat(p)),
                        = -OfNat(m * (Succ(n) * p))
                            := Int::cong(Int::neg, Int::cong_ofnat(m.mul_assoc(Succ(n), p))),
                        = OfNat(m) * (NegSucc(n) * OfNat(p))
                            := sym(OfNat(m).mul_neg_r(OfNat(Succ(n) * p))),
                },
                NegSucc(p) =>
                    apply trans;
                    give OfNat(m * Succ(n)).mul_neg_l(NegSucc(p));
                    apply trans;
                    give Int::neg_negOfNat(m * Succ(n) * Succ(p));
                    Int::cong_ofnat(m.mul_assoc(Succ(n), Succ(p))),
            },
        },
        NegSucc(m) => match b {
            OfNat(n) => match c {
                OfNat(p) =>
                    apply trans;
                    give OfNat(Succ(m) * n).mul_neg_l(OfNat(p));
                    Int::cong(Int::neg, Int::cong_ofnat(Succ(m).mul_assoc(n, p))),
                NegSucc(p) => calc {
                    (NegSucc(m) * OfNat(n)) * NegSucc(p)
                        = -(OfNat(Succ(m) * n) * NegSucc(p))
                            := OfNat(Succ(m) * n).mul_neg_l(NegSucc(p)),
                        = OfNat((Succ(m) * n) * Succ(p))
                            := Int::neg_negOfNat((Succ(m) * n) * Succ(p)),
                        = OfNat(Succ(m) * (n * Succ(p)))
                            := Int::cong_ofnat(Succ(m).mul_assoc(n, Succ(p))),
                        = -Int::negOfNat(Succ(m) * (n * Succ(p)))
                            := sym(Int::neg_negOfNat(Succ(m) * (n * Succ(p)))),
                        = NegSucc(m) * (OfNat(n) * NegSucc(p))
                            := sym(NegSucc(m).mul_neg_r(OfNat(n * Succ(p)))),
                },
            },
            NegSucc(n) => match c {
                OfNat(p) =>
                    apply trans;
                    give Int::cong_ofnat(Succ(m).mul_assoc(Succ(n), p));
                    apply sym;
                    apply trans;
                    give NegSucc(m).mul_neg_r(OfNat(Succ(n) * p));
                    Int::neg_negOfNat(Succ(m) * (Succ(n) * p)),
                NegSucc(p) =>
                    Int::cong_of(Int::negOfNat, Succ(m).mul_assoc(Succ(n), Succ(p))),
            },
        },
    }
}

// The two rearrangements cross-multiplication keeps needing (`std/rat`);
// `Nat::mul_shuffle` is the second one's natural-number twin.
theorem Int::mul_right_comm(self a, b, c: Int): (a * b) * c = (a * c) * b {
    calc {
        (a * b) * c
            = a * (b * c) := a.mul_assoc(b, c),
            = a * (c * b) := prelude::cong(b.mul_comm(c)),
            = (a * c) * b := sym(a.mul_assoc(c, b)),
    }
}

theorem Int::mul_shuffle(self a, b, c, d: Int): (a * b) * (c * d) = (a * c) * (b * d) {
    calc {
        (a * b) * (c * d)
            = a * (b * (c * d)) := a.mul_assoc(b, c * d),
            = a * ((b * c) * d) := prelude::cong(sym(b.mul_assoc(c, d))),
            = a * ((c * b) * d) := prelude::cong(b.mul_comm(c)),
            = a * (c * (b * d)) := prelude::cong(c.mul_assoc(b, d)),
            = (a * c) * (b * d) := sym(a.mul_assoc(c, b * d)),
    }
}

// ---------------------------------------------------------------------------

theorem Int::ofNat_add(m, n: Nat): OfNat(m + n) = OfNat(m) + OfNat(n) {
    sym(Int::add_ofnat_ofnat(m, n))
}

theorem Int::ofNat_mul(m, n: Nat): OfNat(m * n) = OfNat(m) * OfNat(n) { refl }

// A `Nat` read as an `Int`, as a call rather than the bare constructor:
// `ring` and `omega` meet `n.int()` as one atom per `n`, which conversion
// relates across spellings (`(-x).den.int()` is `x.den.int()`), and read one
// whose value computes as its numeral. Neither does either for `OfNat(e)`.
fn Nat::int(self n: Nat) → Int { OfNat(n) }

theorem Nat::int_mul(self a, b: Nat): (a * b).int() = a.int() * b.int() { refl }

theorem Nat::int_pow_add(self a: Nat, b, c: Nat): a.pow(b + c).int() = a.pow(b).int() * a.pow(c).int() {
    Int::cong_ofnat(a.pow_add(b, c))
}

theorem Int::pos_sub_neg(self a: Int): a = a.pos_part().int() - a.neg_part().int() {
    match a { OfNat(_) => refl, NegSucc(_) => refl }
}

theorem Int::mul_neg_one(self a: Int): a * NegSucc(0) = -a {
    apply trans;
    give a.mul_neg_r(OfNat(1));
    prelude::cong(a.mul_one())
}

theorem Int::add_neg_cancel_r(self x, y: Int): (x + y) + -y = x {
    apply trans;
    give x.add_assoc(y, -y);
    apply trans;
    give Int::cong(λ (w: Int) => x + w, y.add_neg());
    x.add_zero()
}

theorem Int::add_neg_cancel_l(self x, y: Int): (x + -y) + y = x {
    apply trans;
    give x.add_assoc(-y, y);
    apply trans;
    give Int::cong(λ (w: Int) => x + w, y.neg_add_self());
    x.add_zero()
}

theorem Int::mul_ofnat_succ(self a: Int, n: Nat): a * OfNat(Succ(n)) = a * OfNat(n) + a {
    match a {
        OfNat(m) => sym(Int::add_ofnat_ofnat(m * n, m)),
        NegSucc(m) =>
            apply sym;
            apply trans;
            give sym(OfNat(Succ(m) * n).neg_add(OfNat(Succ(m))));
            Int::cong(Int::neg, Int::add_ofnat_ofnat(Succ(m) * n, Succ(m))),
    }
}

theorem Int::mul_isucc(self a, x: Int): a * x.isucc() = a * x + a {
    match x {
        OfNat(n) => a.mul_ofnat_succ(n),
        NegSucc(n) =>
            match n {
                Zero =>
                    apply trans;
                    give a.mul_zero();
                    apply sym;
                    apply trans;
                    give Int::cong(λ (w: Int) => w + a, a.mul_neg_one());
                    a.neg_add_self(),
                Succ(j) =>
                    apply trans;
                    give a.mul_neg_r(OfNat(Succ(j)));
                    apply sym;
                    apply trans;
                    give
                        apply Int::cong;
                        give λ (w: Int) => w + a;
                        apply trans;
                        give a.mul_neg_r(OfNat(Succ(Succ(j))));
                        apply trans;
                        give Int::cong(Int::neg, a.mul_ofnat_succ(Succ(j)));
                        (a * OfNat(Succ(j))).neg_add(a);
                    (-(a * OfNat(Succ(j)))).add_neg_cancel_l(a),
            },
    }
}

theorem Int::mul_ipred(self a, x: Int): a * x.ipred() = a * x + -a {
    apply sym;
    apply trans;
    give
        apply Int::cong;
        give λ (w: Int) => w + -a;
        apply trans;
        give sym(Int::cong(λ (w: Int) => a * w, x.isucc_ipred()));
        a.mul_isucc(x.ipred());
    (a * x.ipred()).add_neg_cancel_r(a)
}

theorem Int::mul_add_distr(self a, b, c: Int): a * (b + c) = a * b + a * c {
    Int::ind(λ (z: Int) => a * (b + z) = (a * b) + (a * z),
        apply trans;
        give Int::cong(λ (w: Int) => a * w, b.add_zero());
        apply trans;
        give sym((a * b).add_zero());
        sym(Int::cong(λ (w: Int) => (a * b) + w, a.mul_zero())),
        (k: Nat) (ih: a * (b + OfNat(k)) = (a * b) + (a * OfNat(k))) ⊢
            apply trans;
            give Int::cong(λ (w: Int) => a * w, b.add_isucc(OfNat(k)));
            apply trans;
            give a.mul_isucc(b + OfNat(k));
            apply trans;
            give Int::cong(λ (w: Int) => w + a, ih);
            apply trans;
            give (a * b).add_assoc(a * OfNat(k), a);
            sym(Int::cong(λ (w: Int) => (a * b) + w, a.mul_ofnat_succ(k))),
        apply trans;
        give Int::cong(λ (w: Int) => a * w, b.add_neg_one());
        apply trans;
        give a.mul_ipred(b);
        sym(Int::cong(λ (w: Int) => (a * b) + w, a.mul_neg_one())),
        (k: Nat) (ih: a * (b + NegSucc(k)) = (a * b) + (a * NegSucc(k))) ⊢
            apply trans;
            give Int::cong(λ (w: Int) => a * w, b.add_ipred(NegSucc(k)));
            apply trans;
            give a.mul_ipred(b + NegSucc(k));
            apply trans;
            give Int::cong(λ (w: Int) => w + -a, ih);
            apply trans;
            give (a * b).add_assoc(a * NegSucc(k), -a);
            sym(Int::cong(λ (w: Int) => (a * b) + w, a.mul_ipred(NegSucc(k)))),
        c)
}

theorem Int::add_mul_distr(self a, b, c: Int): (a + b) * c = a * c + b * c {
    apply trans;
    give (a + b).mul_comm(c);
    apply trans;
    give c.mul_add_distr(a, b);
    apply trans;
    give Int::cong(λ (w: Int) => w + (c * b), c.mul_comm(a));
    Int::cong(λ (w: Int) => (a * c) + w, c.mul_comm(b))
}

// ---------------------------------------------------------------------------

// Equality as a named relation, for where a relation is an index: a
// morphism out of `Int` (`Rat::ofInt_hom`) states its laws at `Int::Same`,
// and a λ there would be β-reduced out of the record's field types, leaving
// nothing to infer it from (lib/std/algebra/morphism.hthr).
fn Int::Same(self a, b: Int) → Type { a = b }

fn Int::Le(self a, b: Int) → Type {
    match a {
        OfNat(m) => match b { OfNat(n) => m <= n, NegSucc(_) => False },
        NegSucc(m) => match b { OfNat(_) => True, NegSucc(n) => n <= m },
    }
}

fn Int::Lt(self a, b: Int) → Type { a.isucc().Le(b) }

designation <= at Int := Int::Le
designation < at Int := Int::Lt

fn DivModBounds(divisor: Int, state: DivMod) → Type {
    match state {
        MkIntDivMod(_, remainder) =>
            (OfNat(0) <= remainder) ∧ (remainder < divisor.abs()),
    }
}

theorem Int::le_refl(self a: Int): a <= a {
    match a { OfNat(m) => m.le_refl(), NegSucc(m) => m.le_refl() }
}

theorem Int::le_trans(self a: Int): (b: Int) → (c: Int) → a <= b → b <= c → a <= c {
    match a {
        OfNat(m) => λ b c =>
            match b {
                OfNat(n) => λ p =>
                    match c {
                        OfNat(r) => λ q2 => m.le_trans(n, r, p, q2),
                        NegSucc(_) => λ q2 => false_elim(q2),
                    },
                NegSucc(_) => λ p q => false_elim(p),
            },
        NegSucc(m) => λ b c =>
            match b {
                OfNat(_) => λ p =>
                    match c {
                        OfNat(_) => λ q2 => trivial,
                        NegSucc(_) => λ q2 => false_elim(q2),
                    },
                NegSucc(n) => λ p =>
                    match c {
                        OfNat(_) => λ q2 => trivial,
                        NegSucc(r) => λ q2 => r.le_trans(n, m, q2, p),
                    },
            },
    }
}

theorem Int::le_antisym(self a: Int): (b: Int) → a <= b → b <= a → a = b {
    match a {
        OfNat(m) => λ b =>
            match b {
                OfNat(n) => λ p q => Int::cong_ofnat(m.le_antisym(n, p, q)),
                NegSucc(_) => λ p q => false_elim(p),
            },
        NegSucc(m) => λ b =>
            match b {
                OfNat(_) => λ p q => false_elim(q),
                NegSucc(n) => λ p q => Int::cong_negsucc(sym(n.le_antisym(m, p, q))),
            },
    }
}

theorem Int::le_total(self a, b: Int): a <= b ∨ b <= a {
    match a {
        OfNat(m) => match b {
            OfNat(n) => m.le_total(n),
            NegSucc(_) => Inr(trivial),
        },
        NegSucc(m) => match b {
            OfNat(_) => Inl(trivial),
            NegSucc(n) => n.le_total(m),
        },
    }
}

fn Int::le_dec(self a, b: Int) → a <= b ∨ ¬(a <= b) {
    match a {
        OfNat(m) => match b {
            OfNat(n) => m.le_dec(n),
            NegSucc(_) => Inr(·),
        },
        NegSucc(m) => match b {
            OfNat(_) => Inl(trivial),
            NegSucc(n) => n.le_dec(m),
        },
    }
}

// Closed facts by evaluation (`norm_num`, docs/numeral-normalisation-design.md):
// equality and order as `Bool`s through `Nat`'s `same` and `leb`, which the
// kernel runs on numerals of any size, so a closed comparison is computed
// rather than converted.
fn Int::same(self a, b: Int) → Bool {
    match a {
        OfNat(m) => match b { OfNat(n) => m.same(n), NegSucc(_) => False },
        NegSucc(m) => match b { OfNat(_) => False, NegSucc(n) => m.same(n) },
    }
}

fn Int::leb(self a, b: Int) → Bool {
    match a {
        OfNat(m) => match b { OfNat(n) => m.leb(n), NegSucc(_) => False },
        NegSucc(m) => match b { OfNat(_) => True, NegSucc(n) => n.leb(m) },
    }
}

theorem Int::same_self(self a: Int): a.same(a) = True {
    match a { OfNat(m) => m.same_self(), NegSucc(m) => m.same_self() }
}

theorem Int::same_sound(self a: Int): (b: Int) → a.same(b) = True → a = b {
    match a {
        OfNat(m) => λ b => match b {
            OfNat(n) => λ h => Int::cong_ofnat(m.same_sound(n, h)),
            NegSucc(_) => λ h => absurd(h),
        },
        NegSucc(m) => λ b => match b {
            OfNat(_) => λ h => absurd(h),
            NegSucc(n) => λ h => j(m.same_sound(n, h), λ k _ => NegSucc(m) = NegSucc(k), refl),
        },
    }
}

theorem Int::ne_of_same(self a, b: Int, h: a.same(b) = False): a ≠ b { λ e => absurd(trans(sym(h), j(e, λ c _ => a.same(c) = True, a.same_self()))) }

theorem Int::le_of_leb(self a: Int): (b: Int) → a.leb(b) = True → a <= b {
    match a {
        OfNat(m) => λ b => match b {
            OfNat(n) => λ h => m.le_of_leb(n, h),
            NegSucc(_) => λ h => absurd(h),
        },
        NegSucc(m) => λ b => match b {
            OfNat(_) => λ h => trivial,
            NegSucc(n) => λ h => n.le_of_leb(m, h),
        },
    }
}

theorem Int::not_le_of_leb(self a: Int): (b: Int) → a.leb(b) = False → ¬(a <= b) {
    match a {
        OfNat(m) => λ b => match b {
            OfNat(n) => λ h => m.not_le_of_leb(n, h),
            NegSucc(_) => λ h le => le,
        },
        NegSucc(m) => λ b => match b {
            OfNat(_) => λ h => absurd(h),
            NegSucc(n) => λ h => n.not_le_of_leb(m, h),
        },
    }
}

// The order's decision. Its bit is `leb`, the comparison a program writes,
// so a decided `<=` is that comparison (issues/decide-bit-is-the-comparison.md).
instance(a, b: Int) Decide<Int::Le(a, b)> { dec := Int::le_dec(a, b), bit := a.leb(b), reflects := And(a.le_of_leb(b), a.not_le_of_leb(b)) }

theorem Int::le_of_not_le(self a, b: Int, h: ¬(a <= b)): b <= a {
    or_resolve(or_swap(a.le_total(b)), h)
}

theorem Int::lt_isucc_self(self a: Int): a < a.isucc() { a.isucc().le_refl() }

theorem Int::lt_irrefl(self a: Int): ¬(a < a) {
    match a {
        OfNat(m) => m.lt_irrefl(),
        NegSucc(m) => match m {
            Zero => ·,
            Succ(j) => j.lt_irrefl(),
        },
    }
}

theorem Int::le_of_lt(self a: Int): (b: Int) → a < b → a <= b {
    match a {
        OfNat(m) => λ b =>
            match b {
                OfNat(n) => m.le_of_lt(n, ·),
                NegSucc(_) => false_elim(·),
            },
        NegSucc(m) => λ b =>
            match b {
                OfNat(_) => λ p => trivial,
                NegSucc(n) =>
                    match m {
                        Zero => λ p2 => false_elim(p2),
                        Succ(j) => λ p2 => n.le_succ_r(j, p2),
                    },
            },
    }
}

theorem Int::negsucc_lt_ofnat(m, n: Nat): NegSucc(m) < OfNat(n) {
    match m { Zero => trivial, Succ(_) => trivial }
}

theorem Int::negsucc_lt_of_lt(m, n: Nat, h: n < m): NegSucc(m) < NegSucc(n) {
    match m as λ z => n < z → NegSucc(z) < NegSucc(n) {
        Zero => bad ⊢ false_elim(bad),
        Succ(_) => good ⊢ good,
    }(h)
}

theorem Int::lt_trichotomy(self a, b: Int): a < b ∨ a = b ∨ b < a {
    match a {
        OfNat(m) => match b {
            OfNat(n) => match m.lt_trichotomy(n) {
                Inl(h) => Inl(h),
                Inr(rest) => match rest {
                    Inl(eq) => Inr(Inl(Int::cong_ofnat(eq))),
                    Inr(h) => Inr(Inr(h)),
                },
            },
            NegSucc(n) => Inr(Inr(Int::negsucc_lt_ofnat(n, m))),
        },
        NegSucc(m) => match b {
            OfNat(n) => Inl(Int::negsucc_lt_ofnat(m, n)),
            NegSucc(n) => match m.lt_trichotomy(n) {
                Inl(h) => Inr(Inr(Int::negsucc_lt_of_lt(n, m, h))),
                Inr(rest) => match rest {
                    Inl(eq) => Inr(Inl(Int::cong_negsucc(eq))),
                    Inr(h) => Inl(Int::negsucc_lt_of_lt(m, n, h)),
                },
            },
        },
    }
}

theorem Int::lt_trans(self a, b, c: Int, h1: a < b, h2: b < c): a < c {
    a.isucc().le_trans(b, c, h1, b.le_of_lt(c, h2))
}

theorem Int::lt_of_lt_of_le(self a, b, c: Int, h1: a < b, h2: b <= c): a < c {
    a.isucc().le_trans(b, c, h1, h2)
}

theorem Int::lt_of_le_of_ne(self a, b: Int, hle: a <= b, hne: a ≠ b): a < b {
    match a.lt_trichotomy(b) {
        Inl(h) => h,
        Inr(rest) => match rest {
            Inl(eq) => false_elim(hne(eq)),
            Inr(back) =>
                false_elim(hne(a.le_antisym(b, hle, b.le_of_lt(a, back)))),
        },
    }
}

theorem Int::le_of_not_lt(self a, b: Int, h: ¬(a < b)): b <= a {
    match a.lt_trichotomy(b) {
        Inl(forward) => false_elim(h(forward)),
        Inr(rest) => match rest {
            Inl(eq) => rewrite(sym(eq), a.le_refl()),
            Inr(back) => b.le_of_lt(a, back),
        },
    }
}

theorem Int::lt_of_not_le(self a, b: Int, h: ¬(b <= a)): a < b {
    match a.lt_trichotomy(b) {
        Inl(forward) => forward,
        Inr(rest) => match rest {
            Inl(eq) => false_elim(h(rewrite(sym(eq), a.le_refl()))),
            Inr(back) => false_elim(h(b.le_of_lt(a, back))),
        },
    }
}

// ---------------------------------------------------------------------------

theorem Int::le_isucc(self a: Int): (b: Int) → a <= b → a.isucc() <= b.isucc() {
    match a {
        OfNat(_) => λ b =>
            match b {
                OfNat(_) => λ p => p,
                NegSucc(_) => λ p => false_elim(p),
            },
        NegSucc(m) => λ b =>
            match b {
                OfNat(_) => λ p =>
                    match m {
                        Zero => trivial,
                        Succ(_) => trivial,
                    },
                NegSucc(n) =>
                    match m {
                        Zero =>
                            match n {
                                Zero => λ p3 => trivial,
                                Succ(_) => λ p3 => false_elim(p3),
                            },
                        Succ(_) =>
                            match n {
                                Zero => λ p3 => trivial,
                                Succ(_) => λ p3 => p3,
                            },
                    },
            },
    }
}

theorem Int::lt_of_le_of_lt(self a, b, c: Int, h1: a <= b, h2: b < c): a < c {
    a.isucc().le_trans(b.isucc(), c, a.le_isucc(b, h1), h2)
}

theorem Int::not_lt_of_ge(self a, b: Int, h: a <= b): ¬(b < a) {
    (back: b < a) ⊢ a.lt_irrefl(a.lt_of_le_of_lt(b, a, h, back))
}

theorem Int::lt_asymm(self a, b: Int, h: a < b): ¬(b < a) {
    a.not_lt_of_ge(b, a.le_of_lt(b, h))
}

theorem Int::le_ipred(self a: Int): (b: Int) → a <= b → a.ipred() <= b.ipred() {
    match a {
        OfNat(m) => λ b =>
            match b {
                OfNat(n) =>
                    match m {
                        Zero => λ p2 =>
                            match n {
                                Zero => trivial,
                                Succ(_) => trivial,
                            },
                        Succ(_) =>
                            match n {
                                Zero => λ p3 => false_elim(p3),
                                Succ(_) => λ p3 => p3,
                            },
                    },
                NegSucc(_) => λ p => false_elim(p),
            },
        NegSucc(_) => λ b =>
            match b {
                OfNat(n) => λ p =>
                    match n {
                        Zero => trivial,
                        Succ(_) => trivial,
                    },
                NegSucc(_) => λ p => p,
            },
    }
}

theorem Int::add_le_mono_r(self a, b, c: Int, h: a <= b): a + c <= b + c {
    Int::ind(λ (z: Int) => a + z <= b + z,
        j(sym(a.add_zero()), λ y q => y <= b + OfNat(0),
          rewrite(b.add_zero(), h)),
        λ (k: Nat) (ih: a + OfNat(k) <= b + OfNat(k)) =>
            j(sym(a.add_isucc(OfNat(k))), λ y q => y <= b + OfNat(Succ(k)),
              rewrite(b.add_isucc(OfNat(k)),
              (a + OfNat(k)).le_isucc(b + OfNat(k), ih))),
        j(sym(a.add_neg_one()), λ y q => y <= b + NegSucc(0),
          rewrite(b.add_neg_one(), a.le_ipred(b, h))),
        λ (k: Nat) (ih: a + NegSucc(k) <= b + NegSucc(k)) =>
            j(sym(a.add_ipred(NegSucc(k))), λ y q => y <= b + NegSucc(Succ(k)),
              rewrite(b.add_ipred(Int::NegSucc(k)),
                (a + NegSucc(k)).le_ipred(b + NegSucc(k), ih))),
        c)
}

theorem Int::add_le_mono_l(self a, b, c: Int, h: a <= b): c + a <= c + b {
    rewrite(c.add_comm(a), c.add_comm(b), a.add_le_mono_r(b, c, h))
}

theorem Int::add_le_mono(self a, b, c, d: Int, h1: a <= b, h2: c <= d): a + c <= b + d {
    (a + c).le_trans(b + c, b + d,
        a.add_le_mono_r(b, c, h1),
        c.add_le_mono_l(d, b, h2))
}

theorem Int::mul_le_mono_r(self a, b, k: Int, h: a <= b, hk: OfNat(0) <= k): a * k <= b * k {
    Int::ind(
        λ (z: Int) => OfNat(0) <= z → a <= b → a * z <= b * z,
        λ hz hab =>
            rewrite(a.mul_zero(), b.mul_zero(), OfNat(0).le_refl()),
        λ (n: Nat)
          (ih: OfNat(0) <= OfNat(n) → a <= b → a * OfNat(n) <= b * OfNat(n))
          hz hab =>
            rewrite(a.mul_ofnat_succ(n), b.mul_ofnat_succ(n),
                (a * OfNat(n)).add_le_mono(b * OfNat(n), a, b,
                    ih(trivial, hab), hab)),
        λ hz hab => false_elim(hz),
        λ (n: Nat)
          (ih: OfNat(0) <= NegSucc(n) → a <= b → a * NegSucc(n) <= b * NegSucc(n))
          hz hab => false_elim(hz),
        k, hk, h)
}

// A product of nonnegatives is nonnegative: `0 ≤ a` scaled by `b`.
theorem Int::mul_nonneg(self a, b: Int, ha: OfNat(0) <= a, hb: OfNat(0) <= b): OfNat(0) <= a * b {
    rewrite(sym(b.zero_mul()), OfNat(0).mul_le_mono_r(a, b, ha, hb))
}

theorem Int::mul_le_mono_l(self a, b, k: Int, h: a <= b, hk: OfNat(0) <= k): k * a <= k * b {
    rewrite(k.mul_comm(a), k.mul_comm(b),
        a.mul_le_mono_r(b, k, h, hk))
}

// a < b scaled by a positive k: (a + 1)·k ≤ b·k, and (a + 1)·k is a·k + k,
// which the extra k puts above a·k.
theorem Int::mul_lt_mono_r(self a, b, k: Int, h: a < b, hk: OfNat(0) < k): a * k < b * k {
    let grown = a.isucc().mul_le_mono_r(b, k, h, OfNat(0).le_of_lt(k, hk));
    let expand = calc {
        a * k + k
            = k * a + k := prelude::cong(a.mul_comm(k)),
            = k * a.isucc() := sym(k.mul_isucc(a)),
            = a.isucc() * k := k.mul_comm(a.isucc()),
    };
    let step = rewrite((a * k).add_one(), in := OfNat(1).add_le_mono_l(k, a * k, hk));
    (a * k).isucc().le_trans(a.isucc() * k, b * k, rewrite(sym(expand), step), grown)
}

theorem Int::mul_lt_mono_l(self a, b, k: Int, h: a < b, hk: OfNat(0) < k): k * a < k * b {
    rewrite(k.mul_comm(a), k.mul_comm(b), a.mul_lt_mono_r(b, k, h, hk))
}

// A positive left factor cancels from a strict comparison: were b ≤ a, the
// products would be ordered the same way.
theorem Int::lt_of_mul_lt_mul_l(self a, b, k: Int, hk: OfNat(0) < k, h: k * a < k * b): a < b {
    a.lt_of_not_le(b, λ le => (k * b).not_lt_of_ge(k * a, b.mul_le_mono_l(a, k, le, OfNat(0).le_of_lt(k, hk)), h))
}

theorem Int::le_neg(self a: Int): (b: Int) → a <= b → -b <= -a {
    match a {
        OfNat(m) => λ b =>
            match b {
                OfNat(n) =>
                    match m {
                        Zero => λ p2 =>
                            match n {
                                Zero => trivial,
                                Succ(_) => trivial,
                            },
                        Succ(_) =>
                            match n {
                                Zero => λ p3 => false_elim(p3),
                                Succ(_) => λ p3 => p3,
                            },
                    },
                NegSucc(_) => λ p => false_elim(p),
            },
        NegSucc(_) => λ b =>
            match b {
                OfNat(n) => λ p =>
                    match n {
                        Zero => trivial,
                        Succ(_) => trivial,
                    },
                NegSucc(_) => λ p => p,
            },
    }
}

// A square is nonnegative: a nonpositive `a` squares as `(-a)·(-a)`.
theorem Int::sq_nonneg(self a: Int): OfNat(0) <= a * a {
    match OfNat(0).le_total(a) {
        Inl(up) => a.mul_nonneg(a, up, up),
        Inr(down) => {
            let flipped: (OfNat(0) <= -a) = a.le_neg(OfNat(0), down);
            let same = calc {
                -a * -a = -(a * -a) := a.mul_neg_l(-a),
                    = -(-(a * a)) := prelude::cong(a.mul_neg_r(a)),
                    = a * a := (a * a).neg_neg(),
            };
            rewrite(sym(same), (-a).mul_nonneg(-a, flipped, flipped))
        },
    }
}

// ---------------------------------------------------------------------------

fn Int::max(self a, b: Int) → Int { if a <= b { b } else { a } }

fn Int::min(self a, b: Int) → Int { if a <= b { a } else { b } }

theorem Int::le_max_l(self a, b: Int): a <= a.max(b) {
    decide_bit_split<a <= b>(λ c => a <= match c { True => b, False => a }, λ h => h, λ _ => a.le_refl())
}

theorem Int::le_max_r(self a, b: Int): b <= a.max(b) {
    decide_bit_split<a <= b>(λ c => b <= match c { True => b, False => a }, λ _ => b.le_refl(), λ h => a.le_of_not_le(b, h))
}

theorem Int::min_le_l(self a, b: Int): a.min(b) <= a {
    decide_bit_split<a <= b>(λ c => match c { True => a, False => b } <= a, λ _ => a.le_refl(), λ h => a.le_of_not_le(b, h))
}

theorem Int::min_le_r(self a, b: Int): a.min(b) <= b {
    decide_bit_split<a <= b>(λ c => match c { True => a, False => b } <= b, λ h => h, λ _ => b.le_refl())
}

theorem Int::max_le(self a, b, c: Int, h1: a <= c, h2: b <= c): a.max(b) <= c {
    if a <= b { h2 } else { h1 }
}

theorem Int::le_min(self a, b, c: Int, h1: c <= a, h2: c <= b): c <= a.min(b) {
    decide_bit_split<a <= b>(λ x => c <= match x { True => a, False => b }, λ _ => h1, λ _ => h2)
}

theorem Int::max_eq_r(self a, b: Int, h: a <= b): a.max(b) = b {
    decide_bit_split<a <= b>(λ c => match c { True => b, False => a } = b, λ _ => refl, λ no => absurd_of(h, no))
}

theorem Int::min_eq_l(a, b: Int, h: a <= b): a.min(b) = a {
    decide_bit_split<a <= b>(λ c => match c { True => a, False => b } = a, λ _ => refl, λ no => absurd_of(h, no))
}

theorem Int::max_eq_l(self a, b: Int, h: b <= a): a.max(b) = a {
    decide_bit_split<a <= b>(λ c => match c { True => b, False => a } = a, λ forward => sym(a.le_antisym(b, forward, h)), λ _ => refl)
}

theorem Int::min_eq_r(self a, b: Int, h: b <= a): a.min(b) = b {
    decide_bit_split<a <= b>(λ c => match c { True => a, False => b } = b, λ forward => a.le_antisym(b, forward, h), λ _ => refl)
}

// ---------------------------------------------------------------------------

theorem Int::ofNat_le_iff(m, n: Nat): m <= n ↔ OfNat(m) <= OfNat(n) {
    Iff(λ (h: m <= n) => h, λ (h: OfNat(m) <= OfNat(n)) => h)
}

theorem Int::ofNat_lt_iff(m, n: Nat): m < n ↔ OfNat(m) < OfNat(n) {
    Iff(λ (h: m < n) => h, λ (h: OfNat(m) < OfNat(n)) => h)
}

// `Int` modulo `Int::Same` (which is `=`), as the cast tactics read a
// carrier: its laws and the congruences of its operations
// (lib/std/tactic/cast.hthr).
theorem Int::same_refl(self a: Int): Int::Same(a, a) { refl }
theorem Int::same_sym({a, b: Int}, h: Int::Same(a, b)): Int::Same(b, a) { sym(h) }
theorem Int::same_trans({a, b, c: Int}, hab: Int::Same(a, b), hbc: Int::Same(b, c)): Int::Same(a, c) { trans(hab, hbc) }
theorem Int::add_respects({a, a2, b, b2: Int}, ha: Int::Same(a, a2), hb: Int::Same(b, b2)): Int::Same(a + b, a2 + b2) {
    trans(Int::cong(λ (w: Int) => w + b, ha), Int::cong(λ (w: Int) => a2 + w, hb))
}
theorem Int::mul_respects({a, a2, b, b2: Int}, ha: Int::Same(a, a2), hb: Int::Same(b, b2)): Int::Same(a * b, a2 * b2) {
    trans(Int::cong(λ (w: Int) => w * b, ha), Int::cong(λ (w: Int) => a2 * w, hb))
}
theorem Int::neg_respects({a, a2: Int}, ha: Int::Same(a, a2)): Int::Same(-a, -a2) { Int::cong(λ (w: Int) => -w, ha) }
theorem Int::le_respects({a, a2, b, b2: Int}, ha: Int::Same(a, a2), hb: Int::Same(b, b2), h: a <= b): a2 <= b2 { subst(ha, subst(hb, h)) }
theorem Int::lt_respects({a, a2, b, b2: Int}, ha: Int::Same(a, a2), hb: Int::Same(b, b2), h: a < b): a2 < b2 { subst(ha, subst(hb, h)) }

// The `Nat → Int` cast edge (docs/casting-design.md §12): `n.int()`, which
// is `OfNat(n)`. Its laws hold by computation: `Int::add` and `Int::mul` on
// two `OfNat`s are `OfNat` of the `Nat` operation, and the orders agree.
fn Int::ofNat_hom() → OrderedSemiringHom<Nat, Int>(Nat::int,
        Nat::Same, Nat::Lt, Nat::Le, Nat::add, Nat::mul, 0, 1,
        Int::Same, Int::Lt, Int::Le, Int::add, Int::mul, OfNat(0), OfNat(1)) {
    OrderedSemiringHom {
        map_respects: λ m n h => Int::cong_ofnat(h),
        map_zero: refl,
        map_one: refl,
        map_add: λ m n => Int::ofNat_add(m, n),
        map_mul: λ m n => refl,
        map_le: λ m n h => h,
        map_lt: λ m n h => h,
        le_of_map: λ m n h => h,
        lt_of_map: λ m n h => h,
    }
}

// The `Nat → Int` edge for `↑` (lib/std/algebra/morphism.hthr): `↑n` is
// `OfNat(n)`, one spelling for every cast into `Int`.
instance Cast<Nat, Int>(OfNat) { }

theorem Int::zero_le_ofNat(n: Nat): OfNat(0) <= OfNat(n) { trivial }

theorem Int::negsucc_le_ofNat(m, n: Nat): NegSucc(m) <= OfNat(n) { trivial }

// `toNat` is a left inverse exactly where the integer is non-negative, and the
// hypothesis is convoyed rather than assumed: at a negative argument the
// hypothesis IS `False`, which is the same economy `nat`'s order kit has.
theorem Int::ofNat_toNat(self a: Int): OfNat(0) <= a → OfNat(a.toNat()) = a {
    match a {
        OfNat(_) => λ h => refl,
        NegSucc(_) => false_elim(·),
    }
}

// ---------------------------------------------------------------------------
// Absolute value.

theorem Int::abs_cases(self a: Int): (OfNat(0) <= a ∧ a.abs() = a) ∨ (a < OfNat(0) ∧ a.abs() = -a) {
    match a {
        OfNat(_) => Inl(And(trivial, refl)),
        NegSucc(n) => Inr(And(Int::negsucc_lt_ofnat(n, 0), refl)),
    }
}

theorem Int::abs_nonneg(self a: Int): OfNat(0) <= a.abs() { trivial }

theorem Int::le_abs(self a: Int): a <= a.abs() {
    match a { OfNat(n) => OfNat(n).le_refl(), NegSucc(_) => trivial }
}

theorem Int::neg_le_abs(self a: Int): -a <= a.abs() {
    match a {
        OfNat(n) => match n { Zero => trivial, Succ(_) => trivial },
        NegSucc(n) => OfNat(Succ(n)).le_refl(),
    }
}

theorem Int::abs_of_nonneg(self a: Int): OfNat(0) <= a → a.abs() = a {
    match a {
        OfNat(_) => λ h => refl,
        NegSucc(_) => false_elim(·),
    }
}

theorem Int::natAbs_negOfNat(n: Nat): Int::negOfNat(n).natAbs() = n {
    match n { Zero => refl, Succ(_) => refl }
}

theorem Int::natAbs_neg(self a: Int): (-a).natAbs() = a.natAbs() {
    match a { OfNat(n) => Int::natAbs_negOfNat(n), NegSucc(_) => refl }
}

theorem Int::natAbs_mul(self a, b: Int): (a * b).natAbs() = a.natAbs() * b.natAbs() {
    match a {
        OfNat(m) => match b {
            OfNat(_) => refl,
            NegSucc(n) => Int::natAbs_negOfNat(m * Succ(n)),
        },
        NegSucc(m) => match b {
            OfNat(n) => Int::natAbs_negOfNat(Succ(m) * n),
            NegSucc(_) => refl,
        },
    }
}

theorem Int::abs_mul(self a, b: Int): (a * b).abs() = a.abs() * b.abs() { Int::cong_ofnat(a.natAbs_mul(b)) }

theorem Int::abs_neg(self a: Int): (-a).abs() = a.abs() { Int::cong_ofnat(a.natAbs_neg()) }

// ---------------------------------------------------------------------------
// The identity structures (`algebra`), each `algebra_rel`'s at `RelId`. The
// setoid lives here, before them, so the order structures (`order`,
// `lattice`) and the ring (`semiring`) over `RelId<Int>` all find this one
// dictionary rather than minting copies.

instance Equivalence<Int>(RelId<Int>) {
    rel_refl := λ x => refl,
    rel_sym := λ x y h => sym(h),
    rel_trans := λ x y z hxy hyz => trans(hxy, hyz),
}

instance Respects2<Int, Int, Int>(RelId<Int>, RelId<Int>, RelId<Int>, Int::add) { respects2 := respects2_relid(Int::add) }
instance Respects2<Int, Int, Int>(RelId<Int>, RelId<Int>, RelId<Int>, Int::mul) { respects2 := respects2_relid(Int::mul) }

instance CommMonoid<Int>(Int::add) {
    unit := OfNat(0),
    assoc := Int::add_assoc,
    unit_l := Int::zero_add,
    unit_r := Int::add_zero,
    comm := Int::add_comm,
}

instance CommMonoid<Int>(Int::mul) {
    unit := OfNat(1),
    assoc := Int::mul_assoc,
    unit_l := Int::one_mul,
    unit_r := Int::mul_one,
    comm := Int::mul_comm,
}

instance Group<Int>(Int::add) {
    inv := Int::neg,
    inv_l := Int::neg_add_self,
    inv_r := Int::add_neg,
    inv_respects := λ x y h => cong(h),
}

theorem Int::neg_unique(self x, y: Int, h: x + y = OfNat(0)): y = -x {
    op_inv_unique(x, y, h)
}

theorem Int::neg_add_left_of_add_eq(self a, b, c: Int, h: b + c = a):
    -a + b = -c
{
    calc {
        -a + b
            = -(b + c) + b :=
                Int::cong(λ (x: Int) => -x + b, sym(h)),
            = (-b + -c) + b :=
                Int::cong(λ (x: Int) => x + b, b.neg_add(c)),
            = -b + (-c + b) := (-b).add_assoc(-c, b),
            = -b + (b + -c) :=
                Int::cong(λ (x: Int) => -b + x, (-c).add_comm(b)),
            = (-b + b) + -c := sym((-b).add_assoc(b, -c)),
            = OfNat(0) + -c :=
                Int::cong(λ (x: Int) => x + -c, b.neg_add_self()),
            = -c := (-c).zero_add(),
    }
}

theorem Int::ofNat_mul_add(m, n, r: Nat):
    OfNat(m) * OfNat(n) + OfNat(r) = OfNat(m * n + r)
{
    calc {
        OfNat(m) * OfNat(n) + OfNat(r)
            = OfNat(m * n) + OfNat(r) :=
                Int::cong(λ (x: Int) => x + OfNat(r), Int::ofNat_mul(m, n)),
            = OfNat(m * n + r) := Int::add_ofnat_ofnat(m * n, r),
    }
}

// TODO: should this in nat file?
theorem complement_reconstruct(q, divisor, remainder, dividend: Nat,
                               reconstruct: q * divisor + remainder = dividend,
                               bounded: remainder <= divisor):
    (divisor - remainder) + dividend = Succ(q) * divisor
{
    calc {
        (divisor - remainder) + dividend
            = (divisor - remainder) + (q * divisor + remainder) :=
                Nat::cong(
                    λ (x: Nat) => (divisor - remainder) + x,
                    sym(reconstruct)),
            = ((divisor - remainder) + q * divisor) + remainder :=
                sym(Nat::add_assoc(
                    (divisor - remainder), q * divisor, remainder)),
            = (q * divisor + (divisor - remainder)) + remainder :=
                Nat::cong(
                    λ (x: Nat) => x + remainder,
                    (divisor - remainder).add_comm(q * divisor)),
            = q * divisor + ((divisor - remainder) + remainder) :=
                (q * divisor).add_assoc(divisor - remainder, remainder),
            = q * divisor + divisor :=
                Nat::cong(
                    λ (x: Nat) => q * divisor + x,
                    remainder.sub_add_cancel(divisor, bounded)),
            = divisor + q * divisor := (q * divisor).add_comm(divisor),
            = Succ(q) * divisor := sym(q.mul_succ_left(divisor)),
    }
}

theorem Int::divmod_nonneg_reconstruct(dividend, divisor_pred: Nat):
    DivModEquation(
        OfNat(dividend), OfNat(Succ(divisor_pred)),
        Int::divmod_nonneg(dividend, divisor_pred))
{
    match dividend.ldiv(Succ(divisor_pred)) as λ state =>
        DivMod::Spec(dividend, Succ(divisor_pred), state) →
        DivModEquation(
            OfNat(dividend), OfNat(Succ(divisor_pred)),
            match state {
                MkDivMod(quotient, remainder) =>
                    MkIntDivMod(OfNat(quotient), OfNat(remainder)),
            })
    {
        MkDivMod(quotient, remainder) => λ spec =>
            trans(
                Int::ofNat_mul_add(quotient, Succ(divisor_pred), remainder),
                Int::cong_ofnat(spec.left)),
    }(Nat::ldiv_spec(dividend, Succ(divisor_pred)))
}

theorem Int::divmod_negative_reconstruct(dividend_pred, divisor_pred: Nat):
    DivModEquation(
        NegSucc(dividend_pred), OfNat(Succ(divisor_pred)),
        Int::divmod_negative(dividend_pred, divisor_pred))
{
    match Succ(dividend_pred).ldiv(Succ(divisor_pred)) as λ state =>
        DivMod::Spec(Succ(dividend_pred), Succ(divisor_pred), state) →
        DivModEquation(
            NegSucc(dividend_pred), OfNat(Succ(divisor_pred)),
            match state {
                MkDivMod(quotient, remainder) => match remainder {
                    Zero => MkIntDivMod(Int::negOfNat(quotient), OfNat(0)),
                    Succ(_) => MkIntDivMod(
                        NegSucc(quotient),
                        OfNat(Succ(divisor_pred) - remainder)),
                },
            })
    {
        MkDivMod(quotient, remainder) => λ spec => match remainder as λ r =>
            (quotient * Succ(divisor_pred) + r = Succ(dividend_pred)) →
            (Succ(divisor_pred) <= 0 ∨ r < Succ(divisor_pred)) →
            DivModEquation(
                NegSucc(dividend_pred), OfNat(Succ(divisor_pred)),
                match r {
                    Zero => MkIntDivMod(Int::negOfNat(quotient), OfNat(0)),
                    Succ(_) => MkIntDivMod(
                        NegSucc(quotient),
                        OfNat(Succ(divisor_pred) - r)),
                })
        {
            Zero => λ reconstruct alternatives => calc {
                Int::negOfNat(quotient) * OfNat(Succ(divisor_pred)) + OfNat(0)
                    = Int::negOfNat(quotient) * OfNat(Succ(divisor_pred)) :=
                        (Int::negOfNat(quotient) * OfNat(Succ(divisor_pred))).add_zero(),
                    = -(OfNat(quotient) * OfNat(Succ(divisor_pred))) :=
                        OfNat(quotient).mul_neg_l(OfNat(Succ(divisor_pred))),
                    = -(OfNat(quotient * Succ(divisor_pred))) :=
                        Int::cong(Int::neg, sym(Int::ofNat_mul(quotient, Succ(divisor_pred)))),
                    = -(OfNat(Succ(dividend_pred))) :=
                        Int::cong(Int::neg, Int::cong_ofnat(reconstruct)),
                    = NegSucc(dividend_pred) := refl,
            },
            Succ(remainder_pred) => λ reconstruct alternatives =>
                match alternatives {
                    Inl(impossible) => false_elim(impossible),
                    Inr(bounded) => calc {
                        NegSucc(quotient) * OfNat(Succ(divisor_pred)) +
                                OfNat(Succ(divisor_pred) - Succ(remainder_pred))
                            = -(OfNat(Succ(quotient)) * OfNat(Succ(divisor_pred))) +
                                OfNat(Succ(divisor_pred) - Succ(remainder_pred)) :=
                                    Int::cong(
                                        λ (x: Int) => x + OfNat(Succ(divisor_pred) - Succ(remainder_pred)),
                                        OfNat(Succ(quotient)).mul_neg_l(OfNat(Succ(divisor_pred)))),
                            = -(OfNat(Succ(quotient) * Succ(divisor_pred))) +
                                OfNat(Succ(divisor_pred) - Succ(remainder_pred)) :=
                                    Int::cong(
                                        λ (x: Int) => -x + OfNat(Succ(divisor_pred) - Succ(remainder_pred)),
                                        sym(Int::ofNat_mul(Succ(quotient), Succ(divisor_pred)))),
                            = -(OfNat(Succ(dividend_pred))) :=
                                (OfNat(Succ(quotient) * Succ(divisor_pred))).neg_add_left_of_add_eq(
                                    OfNat(Succ(divisor_pred) - Succ(remainder_pred)),
                                    OfNat(Succ(dividend_pred)),
                                    trans(
                                        Int::add_ofnat_ofnat(Succ(divisor_pred) - Succ(remainder_pred),
                                            Succ(dividend_pred)),
                                        Int::cong_ofnat(complement_reconstruct(
                                            quotient,
                                            Succ(divisor_pred),
                                            Succ(remainder_pred),
                                            Succ(dividend_pred),
                                            reconstruct,
                                            Succ(remainder_pred).le_of_lt(Succ(divisor_pred), bounded))))),
                            = NegSucc(dividend_pred) := refl,
                    },
                },
        }(spec.left, spec.right),
    }(Nat::ldiv_spec(Succ(dividend_pred), Succ(divisor_pred)))
}

theorem Int::divmod_positive_reconstruct(dividend: Int, divisor_pred: Nat):
    DivModEquation(
        dividend, OfNat(Succ(divisor_pred)),
        Int::divmod_positive(dividend, divisor_pred))
{
    match dividend {
        OfNat(n) => Int::divmod_nonneg_reconstruct(n, divisor_pred),
        NegSucc(n) => Int::divmod_negative_reconstruct(n, divisor_pred),
    }
}

theorem Int::negate_divisor_reconstruct(dividend, positive_divisor: Int,
                                   state: DivMod,
                                   h: DivModEquation(
                                       dividend, positive_divisor, state)):
    DivModEquation(dividend, -positive_divisor, state.negate_divmod_quotient())
{
    match state as λ s =>
        DivModEquation(dividend, positive_divisor, s) →
        DivModEquation(dividend, -positive_divisor, s.negate_divmod_quotient())
    {
        MkIntDivMod(quotient, remainder) => λ reconstruct => calc {
            -quotient * -positive_divisor + remainder
                = -(-quotient * positive_divisor) + remainder :=
                    Int::cong(
                        λ (x: Int) => x + remainder,
                        (-quotient).mul_neg_r(positive_divisor)),
                = -(-(quotient * positive_divisor)) + remainder :=
                    Int::cong(
                        λ (x: Int) => -x + remainder,
                        quotient.mul_neg_l(positive_divisor)),
                = quotient * positive_divisor + remainder :=
                    Int::cong(λ (x: Int) => x + remainder, (quotient * positive_divisor).neg_neg()),
                = dividend := reconstruct,
        },
    }(h)
}

theorem Int::divmod_reconstruct(dividend, divisor: Int):
    DivModEquation(dividend, divisor, dividend.divmod(divisor))
{
    match divisor {
        OfNat(n) => match n {
            Zero => dividend.zero_add(),
            Succ(k) => Int::divmod_positive_reconstruct(dividend, k),
        },
        NegSucc(k) => Int::negate_divisor_reconstruct(
            dividend,
            OfNat(Succ(k)),
            Int::divmod_positive(dividend, k),
            Int::divmod_positive_reconstruct(dividend, k)),
    }
}

theorem Int::div_mul_add_mod(dividend, divisor: Int):
    dividend.div(divisor) * divisor + dividend.mod(divisor) = dividend
{
    match dividend.divmod(divisor) as λ state =>
        DivModEquation(dividend, divisor, state) →
        match state as λ _ => Type {
            MkIntDivMod(quotient, remainder) =>
                quotient * divisor + remainder = dividend,
        }
    {
        MkIntDivMod(_, _) => λ reconstruct => reconstruct,
    }(Int::divmod_reconstruct(dividend, divisor))
}

theorem Int::divmod_nonneg_bounds(dividend, divisor_pred: Nat):
    DivModBounds(
        OfNat(Succ(divisor_pred)), Int::divmod_nonneg(dividend, divisor_pred))
{
    match dividend.ldiv(Succ(divisor_pred)) as λ state =>
        DivMod::Spec(dividend, Succ(divisor_pred), state) →
        DivModBounds(
            OfNat(Succ(divisor_pred)),
            match state {
                MkDivMod(quotient, remainder) =>
                    MkIntDivMod(OfNat(quotient), OfNat(remainder)),
            })
    {
        MkDivMod(_, _) => λ spec => match spec.right {
            Inl(impossible) => false_elim(impossible),
            Inr(bounded) => And(trivial, bounded),
        },
    }(Nat::ldiv_spec(dividend, Succ(divisor_pred)))
}

theorem Int::divmod_negative_bounds(dividend_pred, divisor_pred: Nat):
    DivModBounds(OfNat(Succ(divisor_pred)), Int::divmod_negative(dividend_pred, divisor_pred))
{
    match Succ(dividend_pred).ldiv(Succ(divisor_pred)) as λ state =>
        DivMod::Spec(Succ(dividend_pred), Succ(divisor_pred), state) →
        DivModBounds(
            OfNat(Succ(divisor_pred)),
            match state {
                MkDivMod(quotient, remainder) => match remainder {
                    Zero => MkIntDivMod(Int::negOfNat(quotient), OfNat(0)),
                    Succ(_) => MkIntDivMod(
                        NegSucc(quotient),
                        OfNat(Succ(divisor_pred) - remainder)),
                },
            })
    {
        MkDivMod(quotient, remainder) => λ spec => match remainder as λ r =>
            (Succ(divisor_pred) <= 0 ∨ r < Succ(divisor_pred)) →
            DivModBounds(
                OfNat(Succ(divisor_pred)),
                match r {
                    Zero => MkIntDivMod(Int::negOfNat(quotient), OfNat(0)),
                    Succ(_) => MkIntDivMod(
                        NegSucc(quotient),
                        OfNat(Succ(divisor_pred) - r)),
                })
        {
            Zero => λ alternatives => And(trivial, trivial),
            Succ(remainder_pred) => λ alternatives => match alternatives {
                Inl(impossible) => false_elim(impossible),
                Inr(bounded) => And(
                    trivial,
                    Succ(divisor_pred).sub_lt_of_pos(
                        Succ(remainder_pred),
                        trivial,
                        Succ(remainder_pred).le_of_lt(Succ(divisor_pred), bounded)),
                ),
            },
        }(spec.right),
    }(Nat::ldiv_spec(Succ(dividend_pred), Succ(divisor_pred)))
}

theorem Int::divmod_positive_bounds(dividend: Int, divisor_pred: Nat):
    DivModBounds(OfNat(Succ(divisor_pred)), Int::divmod_positive(dividend, divisor_pred))
{
    match dividend {
        OfNat(n) => Int::divmod_nonneg_bounds(n, divisor_pred),
        NegSucc(n) => Int::divmod_negative_bounds(n, divisor_pred),
    }
}

theorem Int::negate_divmod_bounds(positive_divisor: Int, state: DivMod,
                             h: DivModBounds(positive_divisor, state),
                             // TODO: we shouldn't need this!
                             same_abs: (-positive_divisor).abs() = positive_divisor.abs()):
    DivModBounds(-positive_divisor, state.negate_divmod_quotient())
{
    match state as λ s =>
        DivModBounds(positive_divisor, s) →
        DivModBounds(-positive_divisor, s.negate_divmod_quotient())
    {
        MkIntDivMod(_, _) => λ bounds => And(
            bounds.left,
            rewrite(same_abs,
              bounds.right)),
    }(h)
}

theorem Int::divmod_bounds(dividend, divisor: Int, nonzero: divisor ≠ OfNat(0)):
    DivModBounds(divisor, dividend.divmod(divisor))
{
    match divisor as λ d =>
        d ≠ OfNat(0) → DivModBounds(d, dividend.divmod(d))
    {
        OfNat(n) => match n {
            Zero => λ different => false_elim(different(refl)),
            Succ(k) => λ different => Int::divmod_positive_bounds(dividend, k),
        },
        NegSucc(k) => λ different => Int::negate_divmod_bounds(
            OfNat(Succ(k)),
            Int::divmod_positive(dividend, k),
            Int::divmod_positive_bounds(dividend, k),
            refl),
    }(nonzero)
}

theorem Int::mod_nonneg(self dividend, divisor: Int, nonzero: divisor ≠ OfNat(0)):
    OfNat(0) <= dividend.mod(divisor)
{
    match dividend.divmod(divisor) as λ state =>
        DivModBounds(divisor, state) →
        match state as λ _ => Type {
            MkIntDivMod(_, remainder) => OfNat(0) <= remainder,
        }
    {
        MkIntDivMod(_, _) => λ bounds => bounds.left,
    }(Int::divmod_bounds(dividend, divisor, nonzero))
}

theorem Int::mod_lt_abs(self dividend, divisor: Int, nonzero: divisor ≠ OfNat(0)):
    dividend.mod(divisor) < divisor.abs()
{
    match dividend.divmod(divisor) as λ state =>
        DivModBounds(divisor, state) →
        match state as λ _ => Type {
            MkIntDivMod(_, remainder) => remainder < divisor.abs(),
        }
    {
        MkIntDivMod(_, _) => λ bounds => bounds.right,
    }(Int::divmod_bounds(dividend, divisor, nonzero))
}

theorem Int::div_zero(self dividend: Int): dividend.div(OfNat(0)) = OfNat(0) { refl }

theorem mod_zero(dividend: Int): dividend.mod(OfNat(0)) = dividend { refl }

fn Int::Divides(self divisor, dividend: Int) → Type {
    dividend.mod(divisor) = OfNat(0)
}

instance Default<Int> { default := OfNat(0) }
instance Numeral<Int> { ofNat := OfNat }

instance Cmp<Int> { le := Int::Le, le_refl := Int::le_refl, le_dec := Int::le_dec }

// ---------------------------------------------------------------------------
// Cancelling a positive factor (issues/cancellative-algebra-api.md): either
// order of x and y would scale to a strict inequality the hypothesis denies.

theorem Int::mul_cancel_pos_r(self x, y: Int, p: Pos<Int>, h: x * p = y * p): x = y {
    match x.lt_trichotomy(y) {
        Inl(lt) => false_elim((x * p).lt_irrefl()(j(sym(h), λ right q => x * p < right, x.mul_lt_mono_r(y, p, lt, p_pos)))),
        Inr(rest) => match rest {
            Inl(eq) => eq,
            Inr(gt) => false_elim((y * p).lt_irrefl()(j(h, λ right q => y * p < right, y.mul_lt_mono_r(x, p, gt, p_pos)))),
        },
    }
}

theorem Int::mul_le_cancel_pos_r(self a, b: Int, p: Pos<Int>, h: a * p <= b * p): a <= b {
    Int::le_of_not_lt(b, a, λ lt => (a * p).not_lt_of_ge(b * p, h)(b.mul_lt_mono_r(a, p, lt, p_pos)))
}

// The same with the factor on the left and its sign a plain hypothesis.
theorem Int::mul_cancel_pos_l(self k, a, b: Int, hk: OfNat(0) < k, h: k * a = k * b): a = b {
    match a.lt_trichotomy(b) {
        Inl(lt) => false_elim((k * a).lt_irrefl()(j(sym(h), λ right q => k * a < right, a.mul_lt_mono_l(b, k, lt, hk)))),
        Inr(rest) => match rest {
            Inl(eq) => eq,
            Inr(gt) => false_elim((k * b).lt_irrefl()(j(h, λ right q => k * b < right, b.mul_lt_mono_l(a, k, gt, hk)))),
        },
    }
}

// A nonzero factor cancels: a negative one is a positive one negated, and
// negation cancels from both products. The generic form at an ordered ring
// takes the factor apart from zero (`OrderedRing::mul_cancel_apart_l`); at
// `Int` the decision turns `≠ 0` into that.
theorem Int::mul_cancel_l(self k, a, b: Int, hk: ¬(k = OfNat(0)), h: k * a = k * b): a = b {
    match k as λ k => ¬(k = OfNat(0)) → k * a = k * b → a = b {
        OfNat(n) => match n {
            Zero => λ hk h => false_elim(hk(refl)),
            Succ(m) => λ hk h => OfNat(Succ(m)).mul_cancel_pos_l(a, b, trivial, h),
        },
        NegSucc(m) => λ hk h => OfNat(Succ(m)).mul_cancel_pos_l(a, b, trivial,
            trans(NegSucc(m).mul_neg_l(a), trans(prelude::cong(h), sym(NegSucc(m).mul_neg_l(b))))),
    }(hk, h)
}

theorem Int::mul_cancel_r(self a, b, k: Int, hk: ¬(k = OfNat(0)), h: a * k = b * k): a = b {
    k.mul_cancel_l(a, b, hk, trans(sym(a.mul_comm(k)), trans(h, b.mul_comm(k))))
}

// ---------------------------------------------------------------------------
// Signs of a product with a positive factor: the product has the other
// factor's sign, and the other factor has the product's.

theorem Int::mul_pos(self a: Int, p: Pos<Int>, ha: OfNat(0) < a): OfNat(0) < a * p {
    rewrite(sym(p.zero_mul()), OfNat(0).mul_lt_mono_r(a, p, ha, p_pos))
}

theorem Int::mul_neg(self a: Int, p: Pos<Int>, ha: a < OfNat(0)): a * p < OfNat(0) {
    rewrite(sym(p.zero_mul()), a.mul_lt_mono_r(OfNat(0), p, ha, p_pos))
}

theorem Int::pos_of_mul_pos(self a: Int, p: Pos<Int>, h: OfNat(0) < a * p): OfNat(0) < a {
    OfNat(0).lt_of_not_le(a, λ le => (a * p).not_lt_of_ge(OfNat(0),
        rewrite(sym(p.zero_mul()), a.mul_le_mono_r(OfNat(0), p, le, OfNat(0).le_of_lt(p, p_pos))))(h))
}

theorem Int::neg_of_mul_neg(self a: Int, p: Pos<Int>, h: a * p < OfNat(0)): a < OfNat(0) {
    a.lt_of_not_le(OfNat(0), λ le => OfNat(0).not_lt_of_ge(a * p,
        rewrite(sym(p.zero_mul()), OfNat(0).mul_le_mono_r(a, p, le, OfNat(0).le_of_lt(p, p_pos))))(h))
}

// ---------------------------------------------------------------------------
// The arithmetic shift: `⌊a / 2^k⌋`, toward `-∞` at either sign. A negative
// `NegSucc(n)` is `-(n + 1)`, and `⌊-(n + 1) / 2^k⌋ = -(⌊n / 2^k⌋ + 1)`, so
// the shift moves only the magnitude it stores.

fn Int::shr(self a: Int, k: Nat) → Int { match a { OfNat(n) => OfNat(n.shr(k)), NegSucc(n) => NegSucc(n.shr(k)) } }

theorem Int::negOfNat_le_negsucc(x, n: Nat, h: Succ(n) <= x): Int::negOfNat(x) <= NegSucc(n) {
    match x as λ y => Succ(n) <= y → Int::negOfNat(y) <= NegSucc(n) { Zero => λ no => false_elim(no), Succ(_) => λ le => le }(h)
}

// Shifting down and back up never overshoots: `⌊a / 2^k⌋ · 2^k <= a`.
theorem Int::shr_mul_le(self a: Int, k: Nat): a.shr(k) * Nat::pow(2, k).int() <= a {
    match a {
        OfNat(n) => Nat::shr_mul_le(k, n),
        NegSucc(n) => Int::negOfNat_le_negsucc(Succ(n.shr(k)) * Nat::pow(2, k), n, Nat::lt_succ_shr_mul(k, n)),
    }
}

// ---------------------------------------------------------------------------
// A nonzero integer has a positive magnitude.

theorem Int::natAbs_pos_of_ne(self a: Int, h: ¬(a = OfNat(0))): 0 < a.natAbs() {
    match a {
        OfNat(n) => match n as λ m => ¬(OfNat(m) = OfNat(0)) → 0 < m { Zero => λ no => false_elim(no(refl)), Succ(_) => λ _ => trivial }(h),
        NegSucc(_) => trivial,
    }
}

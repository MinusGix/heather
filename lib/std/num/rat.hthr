// Rationals as unreduced fractions: the first serious setoid customer
// (issues/positive-naturals-and-rationals.md, issues/setoid-core-api.md;
// docs/setoid-rationals-round.md).
//
// A rational is an integer numerator over a positive `Nat` denominator
// (`den: Pos<Nat>`: the number `den` and the fact `den_pos: 0 < den`, read
// through the rule `Rat::den_positive`; docs/positivity-evidence-design.md
// §11). Nothing is
// ever reduced: no gcd, no normal form, no non-structural recursion. The
// mathematical equality is `Rat::Same`, cross-multiplication, written `≈`;
// representation identity `=` stays available and is strictly finer (1/2 and
// 2/4 are `≈` but not `=`; it also compares the denominators' positivity
// proofs). Every operation is defined on representatives and
// then proved to respect `≈`, and every law is stated modulo `≈`, so clients
// rewrite with `calc { … ≈ … }` and `rel_cong` exactly as over finite sets,
// or with `rewrite(h, …)` along `≈` itself (docs/equation-rewrite-design.md §9).
//
// Calling convention: a lemma whose every `Rat` is named by one of its
// hypotheses takes those endpoints implicitly (`Rat::le_trans(h1, h2)`); any
// other lemma takes its first `Rat` as `self` (`x.add_comm(y)`).

import logic;
import nat;
import int;
import omega;
import ring;
import relation_props;
import algebra;
import algebra_rel;
import order;
import bool;
import semiring;
import ordered_field;
import morphism;
import big_operator;
import linarith;
export algebra::{Numeral};

record Rat { num: Int, den: Pos<Nat> }

fn Rat::Same(x, y: Rat) → Type { x.num * y.den.int() = y.num * x.den.int() }

designation ≈ at Rat := Rat::Same

theorem Rat::same_refl(self x: Rat): x ≈ x { refl }

theorem Rat::same_sym({x, y: Rat}, h: x ≈ y): y ≈ x { sym(h) }

// a/p ≈ b/q and b/q ≈ c/r give a/p ≈ c/r: multiply the goal by q, which
// the two hypotheses rearrange into each other, and cancel q (positive by
// `y.den_pos`).
theorem Rat::same_trans({x, y, z: Rat}, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    let scaled: ((x.num * z.den.int()) * y.den.int() = (z.num * x.den.int()) * y.den.int()) = ring(hxy, hyz);
    (x.num * z.den.int()).mul_cancel_pos_r(z.num * x.den.int(), y.den.int(), scaled, p_pos := y.den_pos)
}

instance Equivalence<Rat>(Rat::Same) {
    rel_refl := Rat::same_refl,
    rel_sym := λ x y h => Rat::same_sym(h),
    rel_trans := λ x y z hxy hyz => Rat::same_trans(hxy, hyz),
}

// Two representations with the same numerator and the same denominator value
// are the same number; this is the bridge every identity-shaped law crosses.
theorem Rat::same_of_parts(self x, y: Rat, num: x.num = y.num, den: x.den = y.den):
    x ≈ y
{
    calc {
        x.num * y.den.int()
            = y.num * y.den.int() := cong(num),
            = y.num * x.den.int() := cong(sym(den)),
    }
}

// ---------------------------------------------------------------------------
// Arithmetic. Each operation is defined on representatives and then shown to
// respect `≈`; nothing reduces a fraction.

fn Rat::ofInt(n: Int) → Rat { Rat(n, 1) }

// A numeral at `Rat` is the integer over 1: `0`, `1`, `2 * x`, `2⁻¹`. It is
// the only spelling of a constant: `0` elaborates to `Rat::ofInt(OfNat(0))`,
// and evidence search and `rel_cong` compare spellings, not values, so a
// second spelling (a `Rat::zero()` call) would make `x.Apart(Rat::zero())`
// miss every rule stated at `x.Apart(0)`. `Numeral` is exported above so a
// client of `rat` writes numerals without importing `algebra`.
instance Numeral<Rat> { ofNat := λ (n: Nat) => Rat::ofInt(OfNat(n)) }

// ---------------------------------------------------------------------------
// Literals with a point or an exponent (docs/floating-point-design.md §15):
// `1.5` and `1e-3` are `Decimal`s, `0x1.8p3` a `HexFloat`, each its
// mantissa and exponent as written. At another carrier a literal resolves
// `DecimalLiteral` or `HexLiteral`, the way a numeral resolves `Numeral`; in
// inference position it is the `Rat` it denotes.

// `mant · base^exp`.
fn Rat::scaled(base: Nat, bp: 1 <= base, mant: Nat, exp: Int) → Rat {
    Rat((mant * Nat::pow(base, exp.pos_part())).int(), Nat::pow(base, exp.neg_part()))
}

record Decimal { mant: Nat, exp: Int }

// The literal's parts as the elaborator writes them: the exponent is
// `up - down`, one of them zero.
fn Decimal::lit(mant, up, down: Nat) → Decimal { Decimal(mant, up.int() - down.int()) }

fn Decimal::rat(self d: Decimal) → Rat { Rat::scaled(10, trivial, d.mant, d.exp) }

record HexFloat { mant: Nat, exp: Int }

fn HexFloat::lit(mant, up, down: Nat) → HexFloat { HexFloat(mant, up.int() - down.int()) }

fn HexFloat::rat(self h: HexFloat) → Rat { Rat::scaled(2, trivial, h.mant, h.exp) }

// A carrier of decimal literals. `exact` says whether the carrier holds the
// literal's value; the elaborator runs it and warns when it says `False`.
class DecimalLiteral<A> { ofDecimal: Decimal → A, exact: Decimal → Bool }

// The `exact` bit of a rounded literal, which the elaborator compares
// against: named here so a client needs no `import bool;` to be warned.
fn Decimal::inexact() → Bool { False }

// A carrier of hex float literals, which must be exact: `ofHex` takes a proof
// of `Ok`, which the elaborator writes as `trivial`, so a hex float the
// carrier cannot hold is refused.
class HexLiteral<A> { Ok: HexFloat → Type, ofHex: (h: HexFloat) → Ok(h) → A }

instance DecimalLiteral<Rat> { ofDecimal := Decimal::rat, exact := λ (_: Decimal) => True }

instance HexLiteral<Rat> { Ok := λ (_: HexFloat) => True, ofHex := λ (h: HexFloat) (_: True) => h.rat() }

fn Rat::add(self x, y: Rat) → Rat {
    Rat(x.num * y.den.int() + y.num * x.den.int(), x.den * y.den)
}

fn Rat::mul(self x, y: Rat) → Rat { Rat(x.num * y.num, x.den * y.den) }

fn Rat::neg(self x: Rat) → Rat { Rat(-x.num, x.den) }

designation + at Rat := Rat::add
designation * at Rat := Rat::mul
designation prefix - at Rat := Rat::neg

// The denominator of a sum or product, read into `Int`, as `ring` needs it:
// the product of the operands' denominators.
theorem Rat::den_add(self x, y: Rat): (x + y).den.int() = x.den.int() * y.den.int() { refl }
theorem Rat::den_mul(self x, y: Rat): (x * y).den.int() = x.den.int() * y.den.int() { refl }

theorem Rat::neg_respects({x, x2: Rat}, hx: x ≈ x2): -x ≈ -x2 {
    calc {
        (-x.num) * x2.den.int()
            = -(x.num * x2.den.int()) := x.num.mul_neg_l(x2.den.int()),
            = -(x2.num * x.den.int()) := cong(hx),
            = (-x2.num) * x.den.int() := sym(x2.num.mul_neg_l(x.den.int())),
    }
}

// Cross-multiplication respects both operations: `ring` combines the two
// hypotheses (scaled by the other fraction's denominators) once the
// denominators of the products are read as products of denominators.
theorem Rat::mul_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x * y ≈ x2 * y2 {
    ring(hx, hy, x.den_mul(y), x2.den_mul(y2))
}

theorem Rat::add_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x + y ≈ x2 + y2 {
    ring(hx, hy, x.den_add(y), x2.den_add(y2))
}

instance Respects2<Rat, Rat, Rat>(Rat::Same, Rat::Same, Rat::Same, Rat::add) {
    respects2 := λ x x2 hx y y2 hy => Rat::add_respects(hx, hy),
}

instance Respects2<Rat, Rat, Rat>(Rat::Same, Rat::Same, Rat::Same, Rat::mul) {
    respects2 := λ x x2 hx y y2 hy => Rat::mul_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The field-facing laws, modulo `≈`. Identity-shaped laws cross
// `same_of_parts`; distributivity is the one that needs cross-multiplication.

theorem Rat::add_comm(self x, y: Rat): x + y ≈ y + x {
    (x + y).same_of_parts(y + x, (x.num * y.den.int()).add_comm(y.num * x.den.int()), x.den.mul_comm(y.den))
}

theorem Rat::mul_comm(self x, y: Rat): x * y ≈ y * x {
    (x * y).same_of_parts(y * x, x.num.mul_comm(y.num), x.den.mul_comm(y.den))
}

theorem Rat::mul_assoc(self x, y, z: Rat): (x * y) * z ≈ x * (y * z) {
    ((x * y) * z).same_of_parts(x * (y * z), x.num.mul_assoc(y.num, z.num), x.den.mul_assoc(y.den, z.den))
}

theorem Rat::add_assoc(self x, y, z: Rat): (x + y) + z ≈ x + (y + z) {
    ring(x.den_add(y), y.den_add(z), (x + y).den_add(z), x.den_add(y + z))
}

theorem Rat::add_zero(self x: Rat): x + 0 ≈ x { (x + 0).same_of_parts(x, omega, omega) }

theorem Rat::zero_add(self x: Rat): 0 + x ≈ x { Rat::same_trans(Rat::add_comm(0, x), x.add_zero()) }

theorem Rat::mul_one(self x: Rat): x * 1 ≈ x { (x * 1).same_of_parts(x, omega, omega) }

theorem Rat::add_neg(self x: Rat): x + -x ≈ 0 { ring }

theorem Rat::mul_add_distr(self x, y, z: Rat): x * (y + z) ≈ x * y + x * z {
    ring(x.den_mul(y + z), y.den_add(z), (x * y).den_add(x * z), x.den_mul(y), x.den_mul(z))
}

instance SemigroupRel<Rat>(Rat::Same, Rat::add) {
    assoc := Rat::add_assoc,
}

instance Commutative<Rat>(Rat::Same, Rat::add) {
    comm := Rat::add_comm,
}

instance SemigroupRel<Rat>(Rat::Same, Rat::mul) {
    assoc := Rat::mul_assoc,
}

instance Commutative<Rat>(Rat::Same, Rat::mul) {
    comm := Rat::mul_comm,
}

// ---------------------------------------------------------------------------
// Order

fn Rat::Le(x, y: Rat) → Type { x.num * y.den.int() <= y.num * x.den.int() }

designation <= at Rat := Rat::Le

theorem Rat::le_of_same({x, y: Rat}, h: x ≈ y): x <= y {
    rewrite(sym(h), (x.num * y.den.int()).le_refl())
}

theorem Rat::le_refl(self x: Rat): x <= x { Rat::le_of_same(x.same_refl()) }

theorem Rat::le_trans({x, y, z: Rat}, hxy: x <= y, hyz: y <= z): x <= z {
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let first = (x.num * q).mul_le_mono_r(y.num * p, r, hxy, trivial);
    let second = (y.num * r).mul_le_mono_r(z.num * q, p, hyz, trivial);
    (x.num * r).mul_le_cancel_pos_r(z.num * p, q,
        omega(first, second, x.num.mul_right_comm(r, q), y.num.mul_right_comm(p, r), z.num.mul_right_comm(q, p)),
        p_pos := y.den_pos)
}

theorem Rat::le_antisymm({x, y: Rat}, hxy: x <= y, hyx: y <= x): x ≈ y {
    (x.num * y.den.int()).le_antisym(y.num * x.den.int(), hxy, hyx)
}

theorem Rat::le_total(self x, y: Rat): x <= y ∨ y <= x {
    (x.num * y.den.int()).le_total(y.num * x.den.int())
}

theorem Rat::le_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2, h: x <= y): x2 <= y2 {
    Rat::le_trans(Rat::le_trans(Rat::le_of_same(Rat::same_sym(hx)), h), Rat::le_of_same(hy))
}

// One side moved along `≈`, the other kept: the `calc` step `≈ … <=` as one
// call, with nothing to fill on the side that does not move.
theorem Rat::le_of_same_of_le({x, y, z: Rat}, hxy: x ≈ y, hyz: y <= z): x <= z { Rat::le_trans(Rat::le_of_same(hxy), hyz) }

theorem Rat::le_of_le_of_same({x, y, z: Rat}, hxy: x <= y, hyz: y ≈ z): x <= z { Rat::le_trans(hxy, Rat::le_of_same(hyz)) }

// Adding on the right preserves order. Both sides expand to two monomials;
// the z-terms agree outright and the x/y terms compare by `h` scaled by r·r.
theorem Rat::add_le_mono_r(self x, y, z: Rat, h: x <= y): x + z <= y + z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let scaled = (a * q).mul_le_mono_r(c * p, r * r, h, trivial);
    let gl: ((a * r + e * p) * (y + z).den.int() = (a * r + e * p) * (q * r)) = cong(y.den_add(z));
    let gr: ((c * r + e * q) * (x + z).den.int() = (c * r + e * q) * (p * r)) = cong(x.den_add(z));
    omega(scaled, gl, gr, (a * r).add_mul_distr(e * p, q * r), (c * r).add_mul_distr(e * q, p * r),
        a.mul_shuffle(r, q, r), c.mul_shuffle(r, p, r), e.mul_shuffle(p, q, r))
}

theorem Rat::mul_nonneg({x, y: Rat}, hx: 0 <= x, hy: 0 <= y): 0 <= x * y {
    let ha: (0 <= x.num) = omega(Int::zero_mul(x.den.int()));
    let hb: (0 <= y.num) = omega(Int::zero_mul(y.den.int()));
    nlinarith(ha, hb)
}

// ---------------------------------------------------------------------------
// The integers inside the rationals.

theorem Rat::ofInt_add(m, n: Int): Rat::ofInt(m + n) ≈ Rat::ofInt(m) + Rat::ofInt(n) { omega }

theorem Rat::ofInt_mul(m, n: Int): Rat::ofInt(m * n) ≈ Rat::ofInt(m) * Rat::ofInt(n) { refl }

theorem Rat::ofInt_inj(m, n: Int, h: Rat::ofInt(m) ≈ Rat::ofInt(n)): m = n { omega }

theorem Rat::ofInt_le(m, n: Int, h: m <= n): Rat::ofInt(m) <= Rat::ofInt(n) { omega }

theorem Rat::ofInt_neg(n: Int): Rat::ofInt(-n) ≈ -Rat::ofInt(n) { refl }

theorem Rat::ofInt_respects(m, n: Int, h: m = n): Rat::ofInt(m) ≈ Rat::ofInt(n) { omega }

// ---------------------------------------------------------------------------
// The reciprocal of a fraction, as raw arithmetic: total, with 0 sent to 0,
// so its law asks for a nonzero argument. This is not the inverse `x⁻¹`,
// which takes apartness from zero and so has no value at 0 (below, and
// docs/inverse-power-notation-design.md); it is what that inverse computes,
// and what a real's inverse reads term by term at indices whose gap from
// zero it tracks itself. The numerator's sign moves to the new numerator,
// its magnitude becomes the new (positive) denominator.

fn Rat::recip_parts(a: Int, d: Pos<Nat>) → Rat {
    match a {
        OfNat(n) => match n {
            Zero => 0,
            Succ(k) => Rat(d.int(), Succ(k)),
        },
        NegSucc(k) => Rat(-d.int(), Succ(k)),
    }
}

fn Rat::recip(self x: Rat) → Rat { Rat::recip_parts(x.num, x.den) }

theorem Rat::mul_recip_parts(a: Int, d: Pos<Nat>):
    ¬(Rat(a, d) ≈ 0) → Rat(a, d) * Rat::recip_parts(a, d) ≈ 1
{
    match a {
        OfNat(n) => match n {
            Zero => λ nonzero => false_elim(nonzero(sym(Int::zero_mul(d.int())))),
            Succ(k) => λ nonzero => omega(d.int_mul(Succ(k)), OfNat(Succ(k)).mul_comm(d.int())),
        },
        NegSucc(k) => λ nonzero => {
            omega(d.int_mul(Succ(k)), NegSucc(k).mul_neg_r(d.int()), OfNat(Succ(k)).mul_neg_l(d.int()),
                OfNat(Succ(k)).mul_comm(d.int()))
        },
    }
}

theorem Rat::mul_recip(self x: Rat, nonzero: ¬(x ≈ 0)): x * x.recip() ≈ 1 {
    Rat::mul_recip_parts(x.num, x.den, nonzero)
}

// Equal fractions have numerators of one sign: cross-multiplying by a
// positive denominator keeps each numerator's sign.
theorem Rat::num_pos_of_same({x, y: Rat}, h: x ≈ y, hx: 0 < x.num): 0 < y.num {
    let scaled = x.num.mul_pos(y.den.int(), hx, p_pos := y.den_pos);
    y.num.pos_of_mul_pos(x.den.int(), omega(scaled), p_pos := x.den_pos)
}

theorem Rat::num_neg_of_same({x, y: Rat}, h: x ≈ y, hx: x.num < 0): y.num < 0 {
    let scaled = x.num.mul_neg(y.den.int(), hx, p_pos := y.den_pos);
    y.num.neg_of_mul_neg(x.den.int(), omega(scaled), p_pos := x.den_pos)
}

// Equal fractions with positive numerators have equal reciprocals.
theorem Rat::same_recip(a, p, c, q: Pos<Nat>, h: Rat(a.int(), p) ≈ Rat(c.int(), q)): Rat(p.int(), a) ≈ Rat(q.int(), c) {
    ring(h)
}

// Inverse respects `≈`. A sign mismatch contradicts the numerators' common
// sign; zero inverts to zero; a positive pair is `same_recip`, and a negative
// pair is the positive one under negation.
theorem Rat::recip_parts_respects(a: Int, p: Pos<Nat>, c: Int, q: Pos<Nat>):
    Rat(a, p) ≈ Rat(c, q) → Rat::recip_parts(a, p) ≈ Rat::recip_parts(c, q)
{
    match a {
        OfNat(n) => match n {
            Zero => match c {
                OfNat(m) => match m {
                    Zero => λ h => refl,
                    Succ(_) => λ h => false_elim(Rat::num_pos_of_same(Rat::same_sym(h), trivial)),
                },
                NegSucc(j) => λ h => false_elim(Rat::num_neg_of_same(Rat::same_sym(h), Int::negsucc_lt_ofnat(j, 0))),
            },
            Succ(k) => match c {
                OfNat(m) => match m {
                    Zero => λ h => false_elim(Rat::num_pos_of_same(h, trivial)),
                    Succ(j) => λ h => Rat::same_recip(Succ(k), p, Succ(j), q, h),
                },
                NegSucc(_) => λ h => false_elim(Rat::num_pos_of_same(h, trivial)),
            },
        },
        NegSucc(k) => match c {
            OfNat(_) => λ h => false_elim(Rat::num_neg_of_same(h, Int::negsucc_lt_ofnat(k, 0))),
            NegSucc(j) => λ h => Rat::neg_respects(Rat::same_recip(Succ(k), p, Succ(j), q, Rat::neg_respects(h))),
        },
    }
}

theorem Rat::recip_respects({x, x2: Rat}, hx: x ≈ x2): x.recip() ≈ x2.recip() {
    Rat::recip_parts_respects(x.num, x.den, x2.num, x2.den, hx)
}

// Products and reciprocals keep the sign rule.
theorem Rat::mul_nonpos_l({x, y: Rat}, hx: x <= 0, hy: 0 <= y): x * y <= 0 {
    let ha: (x.num <= 0) = omega(Int::zero_mul(x.den.int()));
    let hb: (0 <= y.num) = omega(Int::zero_mul(y.den.int()));
    nlinarith(ha, hb)
}

theorem Rat::mul_nonpos_r({x, y: Rat}, hx: 0 <= x, hy: y <= 0): x * y <= 0 {
    let ha: (0 <= x.num) = omega(Int::zero_mul(x.den.int()));
    let hb: (y.num <= 0) = omega(Int::zero_mul(y.den.int()));
    nlinarith(ha, hb)
}

theorem Rat::mul_nonneg_of_nonpos({x, y: Rat}, hx: x <= 0, hy: y <= 0): 0 <= x * y {
    let ha: (x.num <= 0) = omega(Int::zero_mul(x.den.int()));
    let hb: (y.num <= 0) = omega(Int::zero_mul(y.den.int()));
    nlinarith(ha, hb)
}

theorem Rat::recip_parts_nonneg(a: Int, d: Pos<Nat>, h: 0 <= a): 0 <= Rat::recip_parts(a, d) {
    match a as λ v => 0 <= v → 0 <= Rat::recip_parts(v, d) {
        OfNat(n) => match n as λ k => 0 <= OfNat(k) → 0 <= Rat::recip_parts(OfNat(k), d) {
            Zero => λ _ => Rat::le_refl(0),
            Succ(k) => λ _ => {
                let num: ((Rat(d.int(), Succ(k))).num = d.int()) = refl;
                omega(num, Int::zero_mul((Succ(k)).int()))
            },
        },
        NegSucc(k) => λ bad => false_elim(omega(bad, Int::negsucc_lt_ofnat(k, 0))),
    }(h)
}

theorem Rat::recip_parts_nonpos(a: Int, d: Pos<Nat>, h: a <= 0): Rat::recip_parts(a, d) <= 0 {
    match a as λ v => v <= 0 → Rat::recip_parts(v, d) <= 0 {
        OfNat(n) => match n as λ k => OfNat(k) <= 0 → Rat::recip_parts(OfNat(k), d) <= 0 {
            Zero => λ _ => Rat::le_refl(0),
            Succ(_) => λ bad => false_elim(omega(bad)),
        },
        NegSucc(k) => λ _ => {
            let num: ((Rat(-d.int(), Succ(k))).num = -d.int()) = refl;
            omega(num, Int::zero_mul((Succ(k)).int()))
        },
    }(h)
}

theorem Rat::recip_nonneg({x: Rat}, h: 0 <= x): 0 <= x.recip() {
    Rat::recip_parts_nonneg(x.num, x.den, omega(h, Int::zero_mul(x.den.int())))
}

theorem Rat::recip_nonpos({x: Rat}, h: x <= 0): x.recip() <= 0 {
    Rat::recip_parts_nonpos(x.num, x.den, omega(h, Int::zero_mul(x.den.int())))
}

// ---------------------------------------------------------------------------
// Strict order: the positive-difference form, `x.num·q < y.num·p`. It is
// the cross-multiplied `<` of `Int`, so it carries data omega reads directly,
// and it agrees with `¬(y ≤ x)` because the integer order decides.

fn Rat::Lt(x, y: Rat) → Type { x.num * y.den.int() < y.num * x.den.int() }

designation < at Rat := Rat::Lt

// A decision rather than a theorem: `lt_cotrans` branches on it and the
// `Decide` instance computes with it.
fn Rat::le_dec(self x, y: Rat) → x <= y ∨ ¬(x <= y) { Int::le_dec(x.num * y.den.int(), y.num * x.den.int()) }

fn Rat::same_dec(self x, y: Rat) → x ≈ y ∨ ¬(x ≈ y) {
    match x.le_dec(y) {
        Inl(a) => match y.le_dec(x) { Inl(b) => Inl(Rat::le_antisymm(a, b)), Inr(nb) => Inr(λ e => nb(Rat::le_of_same(Rat::same_sym(e)))) },
        Inr(na) => Inr(λ e => na(Rat::le_of_same(e))),
    }
}

theorem Rat::le_of_lt({x, y: Rat}, h: x < y): x <= y { omega }

theorem Rat::lt_irrefl(self x: Rat): ¬(x < x) { λ h => omega }

theorem Rat::not_le_of_lt({x, y: Rat}, h: x < y): ¬(y <= x) { λ le => omega }

theorem Rat::lt_of_not_le({x, y: Rat}, h: ¬(y <= x)): x < y { omega }

theorem Rat::le_of_not_lt({x, y: Rat}, h: ¬(y < x)): x <= y { omega }

theorem Rat::not_lt_of_le({x, y: Rat}, h: x <= y): ¬(y < x) { λ lt => omega }

theorem Rat::ofInt_lt(m, n: Int, h: m < n): Rat::ofInt(m) < Rat::ofInt(n) { omega }

theorem Rat::le_of_ofInt_le(m, n: Int, h: Rat::ofInt(m) <= Rat::ofInt(n)): m <= n { omega }

theorem Rat::lt_of_ofInt_lt(m, n: Int, h: Rat::ofInt(m) < Rat::ofInt(n)): m < n { omega }

// The integers inside the rationals, as a cast edge (docs/casting-design.md
// §5.6). `Int`'s `≈` is equality.
fn Rat::ofInt_hom() → OrderedRingHom<Int, Rat>(Rat::ofInt,
        Int::Same, Int::Lt, Int::Le, Int::add, Int::mul, Int::neg, 0, 1,
        Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul, Rat::neg, 0, 1) {
    OrderedRingHom {
        map_respects: λ m n h => Rat::ofInt_respects(m, n, h),
        map_zero: Rat::same_refl(0),
        map_one: Rat::same_refl(1),
        map_add: λ m n => Rat::ofInt_add(m, n),
        map_mul: λ m n => Rat::ofInt_mul(m, n),
        map_neg: λ n => Rat::ofInt_neg(n),
        map_le: λ m n h => Rat::ofInt_le(m, n, h),
        map_lt: λ m n h => Rat::ofInt_lt(m, n, h),
        le_of_map: λ m n h => Rat::le_of_ofInt_le(m, n, h),
        lt_of_map: λ m n h => Rat::lt_of_ofInt_lt(m, n, h),
    }
}

instance Cast<Int, Rat>(Rat::ofInt) { }

// The identity, as a morphism: what generic code over a field with the
// rationals inside it (`section<K: OrderedField(…)>(…, hom:
// OrderedRingHom<Rat, K>(…))`) is read at `Rat` with. Its map is named, not
// `λ q => q`: with an anonymous map the readings' types fail to convert.
fn Rat::id(self q: Rat) → Rat { q }

fn Rat::id_hom() → OrderedRingHom<Rat, Rat>(Rat::id,
        Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul, Rat::neg, 0, 1,
        Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul, Rat::neg, 0, 1) {
    OrderedRingHom {
        map_respects: λ p q h => h,
        map_zero: Rat::same_refl(0),
        map_one: Rat::same_refl(1),
        map_add: λ p q => Rat::same_refl(p + q),
        map_mul: λ p q => Rat::same_refl(p * q),
        map_neg: λ q => Rat::same_refl(-q),
        map_le: λ p q h => h,
        map_lt: λ p q h => h,
        le_of_map: λ p q h => h,
        lt_of_map: λ p q h => h,
    }
}

theorem Rat::lt_trichotomy(self x, y: Rat): x < y ∨ x ≈ y ∨ y < x {
    (x.num * y.den.int()).lt_trichotomy(y.num * x.den.int())
}

theorem Rat::lt_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2, h: x < y): x2 < y2 {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h, Rat::le_respects(Rat::same_sym(hy), Rat::same_sym(hx), back)))
}

// One side replaced by one it is `≈` to, the `≈` premise first: the shape a
// tactic applies when it knows the replacement before the order (`mono`'s
// cast step, lib/std/tactic/mono.hthr). The left `<=` one is
// `Rat::le_of_same_of_le`.
theorem Rat::le_of_same_r({x, y, z: Rat}, e: z ≈ y, h: x <= y): x <= z { Rat::le_respects(x.same_refl(), Rat::same_sym(e), h) }

theorem Rat::lt_of_same_l({x, y, z: Rat}, e: x ≈ y, h: y < z): x < z { Rat::lt_respects(Rat::same_sym(e), z.same_refl(), h) }

theorem Rat::lt_of_same_r({x, y, z: Rat}, e: z ≈ y, h: x < y): x < z { Rat::lt_respects(x.same_refl(), Rat::same_sym(e), h) }

// The mixed transitivities go through `¬(… ≤ …)`: a counterexample to the
// conclusion would chain back into a counterexample to the strict premise.
theorem Rat::lt_of_lt_of_le({x, y, z: Rat}, h1: x < y, h2: y <= z): x < z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h1, Rat::le_trans(h2, back)))
}

theorem Rat::lt_of_le_of_lt({x, y, z: Rat}, h1: x <= y, h2: y < z): x < z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h2, Rat::le_trans(back, h1)))
}

theorem Rat::lt_trans({x, y, z: Rat}, h1: x < y, h2: y < z): x < z { Rat::lt_of_lt_of_le(h1, Rat::le_of_lt(h2)) }

// Cotransitivity, the constructive reals' replacement for trichotomy: a gap
// x < y puts any z above x or below y. At `Rat` the order decides, so z is
// placed by comparing it with x.
theorem Rat::lt_cotrans(self x, y, z: Rat, h: x < y): x < z ∨ z < y {
    match z.le_dec(x) {
        Inl(below) => Inr(Rat::lt_of_le_of_lt(below, h)),
        Inr(above) => Inl(Rat::lt_of_not_le(above)),
    }
}

// Two rationals neither of which is below the other are equal: tightness.
theorem Rat::same_of_not_lt({x, y: Rat}, h1: ¬(x < y), h2: ¬(y < x)): x ≈ y {
    Rat::le_antisymm(Rat::le_of_not_lt(h2), Rat::le_of_not_lt(h1))
}

instance Preorder<Rat>(Rat::Le) {
    rel_refl := Rat::le_refl,
    rel_trans := λ x y z hxy hyz => Rat::le_trans(hxy, hyz),
}

instance Total<Rat>(Rat::Le) {
    rel_total := Rat::le_total,
}

instance Irreflexive<Rat>(Rat::Lt) {
    rel_irrefl := Rat::lt_irrefl,
}

instance Transitive<Rat>(Rat::Lt) {
    rel_trans := λ x y z hxy hyz => Rat::lt_trans(hxy, hyz),
}

// The mixed pairs a `calc` chain composes: `<` absorbs `<=` on either side,
// and `≈` is absorbed by either order.
instance Trans<Rat>(Rat::Le, Rat::Lt, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_le_of_lt(hxy, hyz),
}

instance Trans<Rat>(Rat::Lt, Rat::Le, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_lt_of_le(hxy, hyz),
}

instance Trans<Rat>(Rat::Same, Rat::Le, Rat::Le) {
    rel_chain := λ x y z hxy hyz => Rat::le_trans(Rat::le_of_same(hxy), hyz),
}

instance Trans<Rat>(Rat::Le, Rat::Same, Rat::Le) {
    rel_chain := λ x y z hxy hyz => Rat::le_trans(hxy, Rat::le_of_same(hyz)),
}

instance Trans<Rat>(Rat::Same, Rat::Lt, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_le_of_lt(Rat::le_of_same(hxy), hyz),
}

instance Trans<Rat>(Rat::Lt, Rat::Same, Rat::Lt) {
    rel_chain := λ x y z hxy hyz => Rat::lt_of_lt_of_le(hxy, Rat::le_of_same(hyz)),
}

// ---------------------------------------------------------------------------
// Order and the additive structure.

fn Rat::sub(self x, y: Rat) → Rat { x + -y }

designation - at Rat := Rat::sub

theorem Rat::sub_respects({x, x2, y, y2: Rat}, hx: x ≈ x2, hy: y ≈ y2): x - y ≈ x2 - y2 {
    Rat::add_respects(hx, Rat::neg_respects(hy))
}

theorem Rat::neg_neg(self x: Rat): -(-x) ≈ x { (-(-x)).same_of_parts(x, x.num.neg_neg(), refl) }

theorem Rat::neg_add(self x, y: Rat): -(x + y) ≈ -x + -y {
    (-(x + y)).same_of_parts(-x + -y,
        calc {
            -(x.num * y.den.int() + y.num * x.den.int())
                = -(x.num * y.den.int()) + -(y.num * x.den.int()) := Int::neg_add(x.num * y.den.int(), y.num * x.den.int()),
                = (-x.num) * y.den.int() + (-y.num) * x.den.int() := ring,
        },
        refl)
}

theorem Rat::add_neg_cancel_r(self x, y: Rat): (x + y) + -y ≈ x {
    rewrite(x.add_assoc(y, -y), y.add_neg(), x.add_zero(), refl)
}

theorem Rat::neg_le({x, y: Rat}, h: x <= y): -y <= -x {
    omega(y.num.mul_neg_l(x.den.int()), x.num.mul_neg_l(y.den.int()))
}

theorem Rat::neg_lt({x, y: Rat}, h: x < y): -y < -x {
    omega(y.num.mul_neg_l(x.den.int()), x.num.mul_neg_l(y.den.int()))
}

theorem Rat::add_le_mono_l(self x, y, z: Rat, h: x <= y): z + x <= z + y {
    Rat::le_respects(x.add_comm(z), y.add_comm(z), x.add_le_mono_r(y, z, h))
}

theorem Rat::add_le_mono({x, y, z, w: Rat}, h1: x <= y, h2: z <= w): x + z <= y + w {
    Rat::le_trans(x.add_le_mono_r(y, z, h1), z.add_le_mono_l(w, y, h2))
}

// Adding then subtracting z undoes the addition, so order cancels on the right.
theorem Rat::add_le_cancel_r(self x, y, z: Rat, h: x + z <= y + z): x <= y {
    Rat::le_respects(x.add_neg_cancel_r(z), y.add_neg_cancel_r(z), (x + z).add_le_mono_r(y + z, -z, h))
}

theorem Rat::add_lt_mono_r(self x, y, z: Rat, h: x < y): x + z < y + z {
    Rat::lt_of_not_le(λ back => Rat::not_le_of_lt(h, y.add_le_cancel_r(x, z, back)))
}

theorem Rat::add_lt_mono_l(self x, y, z: Rat, h: x < y): z + x < z + y {
    Rat::lt_respects(x.add_comm(z), y.add_comm(z), x.add_lt_mono_r(y, z, h))
}

theorem Rat::add_lt_mono({x, y, z, w: Rat}, h1: x < y, h2: z <= w): x + z < y + w {
    Rat::lt_of_lt_of_le(x.add_lt_mono_r(y, z, h1), z.add_le_mono_l(w, y, h2))
}

theorem Rat::add_nonneg({x, y: Rat}, hx: 0 <= x, hy: 0 <= y): 0 <= x + y {
    Rat::le_respects(Rat::zero_add(0), (x + y).same_refl(), Rat::add_le_mono(hx, hy))
}

theorem Rat::add_pos({x, y: Rat}, hx: 0 < x, hy: 0 < y): 0 < x + y {
    Rat::lt_respects(Rat::zero_add(0), (x + y).same_refl(), Rat::add_lt_mono(hx, Rat::le_of_lt(hy)))
}

theorem Rat::sub_nonneg({x, y: Rat}, h: y <= x): 0 <= x - y {
    Rat::le_respects(y.add_neg(), (x - y).same_refl(), y.add_le_mono_r(x, -y, h))
}

theorem Rat::sub_pos({x, y: Rat}, h: y < x): 0 < x - y {
    Rat::lt_respects(y.add_neg(), (x - y).same_refl(), y.add_lt_mono_r(x, -y, h))
}

// ---------------------------------------------------------------------------
// Absolute value: the numerator's, over the same denominator.

fn Rat::abs(self x: Rat) → Rat { Rat(x.num.abs(), x.den) }

theorem Rat::abs_respects({x, x2: Rat}, hx: x ≈ x2): x.abs() ≈ x2.abs() {
    let q = x2.den.int();
    let p = x.den.int();
    calc {
        x.num.abs() * q
            = x.num.abs() * q.abs() := cong(sym(q.abs_of_nonneg(trivial))),
            = (x.num * q).abs() := sym(x.num.abs_mul(q)),
            = (x2.num * p).abs() := cong(hx),
            = x2.num.abs() * p.abs() := x2.num.abs_mul(p),
            = x2.num.abs() * p := cong(p.abs_of_nonneg(trivial)),
    }
}

theorem Rat::abs_nonneg(self x: Rat): 0 <= x.abs() {
    omega(x.num.abs_nonneg(), Int::zero_mul(x.den.int()))
}

theorem Rat::le_abs(self x: Rat): x <= x.abs() { x.num.mul_le_mono_r(x.num.abs(), x.den.int(), x.num.le_abs(), trivial) }

theorem Rat::neg_le_abs(self x: Rat): -x <= x.abs() { (-x.num).mul_le_mono_r(x.num.abs(), x.den.int(), x.num.neg_le_abs(), trivial) }

theorem Rat::abs_neg(self x: Rat): (-x).abs() ≈ x.abs() { (-x).abs().same_of_parts(x.abs(), x.num.abs_neg(), refl) }

theorem Rat::abs_mul(self x, y: Rat): (x * y).abs() ≈ x.abs() * y.abs() {
    (x * y).abs().same_of_parts(x.abs() * y.abs(), x.num.abs_mul(y.num), refl)
}

// A non-negative rational is its own absolute value, a negative one its
// negation; between them they cover every rational.
theorem Rat::abs_cases(self x: Rat): (0 <= x ∧ x.abs() ≈ x) ∨ (x < 0 ∧ x.abs() ≈ -x) {
    let zero = Int::zero_mul(x.den.int());
    match x.num.abs_cases() {
        Inl(c) => Inl(And(omega(zero, c.left), x.abs().same_of_parts(x, c.right, refl))),
        Inr(c) => Inr(And(omega(zero, c.left), x.abs().same_of_parts(-x, c.right, refl))),
    }
}

// |x| ≤ y from both bounds on x.
theorem Rat::abs_le({x, y: Rat}, lower: -y <= x, upper: x <= y): x.abs() <= y {
    match x.abs_cases() {
        Inl(c) => Rat::le_respects(Rat::same_sym(c.right), y.same_refl(), upper),
        Inr(c) => Rat::le_respects(Rat::same_sym(c.right), y.neg_neg(), Rat::neg_le(lower)),
    }
}

theorem Rat::neg_abs_le(self x: Rat): -x.abs() <= x {
    Rat::le_respects((-x.abs()).same_refl(), x.neg_neg(), Rat::neg_le(x.neg_le_abs()))
}

theorem Rat::abs_triangle(self x, y: Rat): (x + y).abs() <= x.abs() + y.abs() {
    let upper = Rat::add_le_mono(x.le_abs(), y.le_abs());
    let lower = Rat::add_le_mono(x.neg_abs_le(), y.neg_abs_le());
    let below = calc {
        -(x.abs() + y.abs()) ≈ -x.abs() + -y.abs() := x.abs().neg_add(y.abs()),
        <= x + y := lower,
    };
    Rat::abs_le(below, upper)
}

// ---------------------------------------------------------------------------
// Products and order. Scaling by z = e/r multiplies the cross-multiplied
// inequality by e·r; `ring` regroups each side so that omega sees the scaled
// premise and the goal over the same product atoms.

theorem Rat::zero_mul(self x: Rat): 0 * x ≈ 0 { ring }

theorem Rat::mul_le_mono_r({x, y, z: Rat}, h: x <= y, hz: 0 <= z): x * z <= y * z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let zr = Int::zero_mul(r);
    let he: (0 <= e) = omega(zr);
    let scaled = (a * q).mul_le_mono_r(c * p, e * r, h, omega(zr, Int::mul_le_mono_r(0, e, r, he, trivial)));
    linarith(scaled, y.den_mul(z), x.den_mul(z))
}

theorem Rat::mul_lt_mono_r({x, y, z: Rat}, h: x < y, hz: 0 < z): x * z < y * z {
    let a = x.num;
    let c = y.num;
    let e = z.num;
    let p = x.den.int();
    let q = y.den.int();
    let r = z.den.int();
    let zr = Int::zero_mul(r);
    let he: (0 < e) = omega(zr);
    let her = Int::mul_lt_mono_r(0, e, r, he, omega(z.den_pos));
    let scaled = (a * q).mul_lt_mono_r(c * p, e * r, h, omega(zr, her));
    linarith(scaled, y.den_mul(z), x.den_mul(z))
}

theorem Rat::mul_le_mono_l({x, y, z: Rat}, h: x <= y, hz: 0 <= z): z * x <= z * y {
    Rat::le_respects(x.mul_comm(z), y.mul_comm(z), Rat::mul_le_mono_r(h, hz))
}

theorem Rat::mul_lt_mono_l({x, y, z: Rat}, h: x < y, hz: 0 < z): z * x < z * y {
    Rat::lt_respects(x.mul_comm(z), y.mul_comm(z), Rat::mul_lt_mono_r(h, hz))
}

theorem Rat::mul_pos({x, y: Rat}, hx: 0 < x, hy: 0 < y): 0 < x * y {
    Rat::lt_respects(y.zero_mul(), (x * y).same_refl(), Rat::mul_lt_mono_r(hx, hy))
}

// Both factors grow: the bound a product of approximations is kept under.
theorem Rat::mul_le_mul({a, b, c, d: Rat}, h1: a <= b, h2: c <= d, ha: 0 <= a, hc: 0 <= c):
    a * c <= b * d
{
    Rat::le_trans(Rat::mul_le_mono_r(h1, hc), Rat::mul_le_mono_l(h2, Rat::le_trans(ha, h1)))
}

// A positive factor reflects the product's sign: were y ≤ 0, the product
// would be at most 0 · x. The rationals decide `≤`, so refuting it is
// enough.
theorem Rat::pos_of_mul_pos({x, y: Rat}, hx: 0 < x, h: 0 < x * y): 0 < y {
    Rat::lt_of_not_le(λ le => Rat::not_le_of_lt(h, Rat::le_respects(y.mul_comm(x), x.zero_mul(), Rat::mul_le_mono_r(le, Rat::le_of_lt(hx)))))
}

// A factor at most zero reverses the order: `x ≤ y` gives `y·z ≤ x·z`. It is
// the nonnegative case at `-z`, with the sign moved out of each product.
theorem Rat::mul_le_mono_r_nonpos({x, y, z: Rat}, h: x <= y, hz: z <= 0): y * z <= x * z {
    let flipped = Rat::mul_le_mono_r(x := x, y := y, z := -z, h := h, hz := omega(hz, Int::zero_mul(z.den.int())));
    linarith(flipped)
}

theorem Rat::mul_le_mono_l_nonpos({x, y, z: Rat}, h: x <= y, hz: z <= 0): z * y <= z * x {
    Rat::le_respects(y.mul_comm(z), x.mul_comm(z), Rat::mul_le_mono_r_nonpos(h, hz))
}

// ---------------------------------------------------------------------------
// Reciprocals and order. Below a positive `y`, `x ≤ 1/y` is `x·y ≤ 1`: scale
// by `1/y`, which is nonnegative. The enclosures of `interval.hthr` bound a
// reciprocal through these two, and order reciprocals by the third.

theorem Rat::nonzero_of_pos({y: Rat}, hy: 0 < y): ¬(y ≈ 0) { λ e => omega(hy, e, Int::zero_mul(y.den.int())) }

theorem Rat::le_recip_of_mul_le({x, y: Rat}, hy: 0 < y, h: x * y <= 1): x <= y.recip() {
    let r = y.recip();
    let rn = Rat::recip_nonneg(x := y, h := Rat::le_of_lt(hy));
    let unit: ((x * y) * r ≈ x) = Rat::same_trans(x.mul_assoc(y, r),
        Rat::same_trans(Rat::mul_respects(x.same_refl(), y.mul_recip(Rat::nonzero_of_pos(hy))), x.mul_one()));
    Rat::le_respects(unit, Rat::same_trans(Rat::mul_comm(1, r), r.mul_one()), Rat::mul_le_mono_r(h, rn))
}

theorem Rat::recip_le_of_one_le_mul({x, y: Rat}, hy: 0 < y, h: 1 <= x * y): y.recip() <= x {
    let r = y.recip();
    let rn = Rat::recip_nonneg(x := y, h := Rat::le_of_lt(hy));
    let unit: ((x * y) * r ≈ x) = Rat::same_trans(x.mul_assoc(y, r),
        Rat::same_trans(Rat::mul_respects(x.same_refl(), y.mul_recip(Rat::nonzero_of_pos(hy))), x.mul_one()));
    Rat::le_respects(Rat::same_trans(Rat::mul_comm(1, r), r.mul_one()), unit, Rat::mul_le_mono_r(h, rn))
}

// On the positives the reciprocal reverses the order.
theorem Rat::recip_le_recip({x, y: Rat}, hx: 0 < x, h: x <= y): y.recip() <= x.recip() {
    let hy = Rat::lt_of_lt_of_le(hx, h);
    let r = y.recip();
    let rn = Rat::recip_nonneg(x := y, h := Rat::le_of_lt(hy));
    let scaled: (r * x <= r * y) = Rat::mul_le_mono_l(h, rn);
    let one: (r * y ≈ 1) = Rat::same_trans(r.mul_comm(y), y.mul_recip(Rat::nonzero_of_pos(hy)));
    Rat::le_recip_of_mul_le(hx, Rat::le_trans(scaled, Rat::le_of_same(one)))
}

// The reciprocal is odd: the numerator's sign moves to the new numerator.
theorem Rat::recip_neg(self x: Rat): (-x).recip() ≈ -x.recip() {
    match x.num as λ a => Rat::recip_parts(-a, x.den) ≈ -Rat::recip_parts(a, x.den) {
        OfNat(n) => match n as λ k => Rat::recip_parts(-OfNat(k), x.den) ≈ -Rat::recip_parts(OfNat(k), x.den) {
            Zero => refl,
            Succ(_) => refl,
        },
        NegSucc(k) => Rat(x.den.int(), Succ(k)).same_of_parts(-Rat(-x.den.int(), Succ(k)), sym(x.den.int().neg_neg()), refl),
    }
}

// ---------------------------------------------------------------------------
// Archimedean facts. `inv_succ(n)` is 1/(n+1), the step size the regular
// Cauchy-sequence probes measure distances in; its denominator is a `Succ`,
// so its positivity computes and no side condition rides along.

fn Rat::inv_succ(n: Nat) → Rat { Rat(1, Succ(n)) }

// What `ring` clears `inv_succ(n)` with: it is the reciprocal of `n + 1`
// (docs/ring-normalization-design.md §9).
theorem Rat::inv_succ_cancel(n: Nat): Rat::inv_succ(n) * (Rat::ofInt(OfNat(n)) + 1) ≈ 1 {
    let a = Rat::inv_succ(n);
    let b = Rat::ofInt(OfNat(n)) + 1;
    let da: (a.den.int() = OfNat(n) + 1) = refl;
    let db: (b.den.int() = OfNat(1)) = refl;
    ring(a.den_mul(b), da, db)
}

theorem Rat::inv_succ_pos(n: Nat): 0 < Rat::inv_succ(n) { omega }

theorem Rat::inv_succ_le_one(n: Nat): Rat::inv_succ(n) <= 1 { omega }

theorem Rat::inv_succ_antitone(m, n: Nat, h: m <= n): Rat::inv_succ(n) <= Rat::inv_succ(m) { omega }

// Two halves of 1/(n+1): 1/(2n+2) + 1/(2n+2) ≈ 1/(n+1).
theorem Rat::inv_succ_half(n: Nat): Rat::inv_succ(n + n + 1) + Rat::inv_succ(n + n + 1) ≈ Rat::inv_succ(n) {
    let half = Rat::inv_succ(n + n + 1).den;
    let whole: (Rat::inv_succ(n).den.int() = OfNat(n) + 1) = refl;
    let part: (half.int() = OfNat(n) + OfNat(n) + 2) = refl;
    ring(whole, part, half.int_mul(half))
}

// Half a step is a smaller step, strictly.
theorem Rat::inv_succ_half_lt(n: Nat): Rat::inv_succ(n + n + 1) < Rat::inv_succ(n) { omega }

// Four steps of at most 1/(4j+4) are at most 1/(j+1): two halvings. The
// slack the completeness estimates (std/creal) leave over their main bound.
theorem Rat::quarters_le({f: Rat}, j: Nat, hf: f <= Rat::inv_succ((j + j + 1) + (j + j + 1) + 1)): (f + (f + f)) + f <= Rat::inv_succ(j) {
    let j2 = j + j + 1;
    let h = Rat::inv_succ(j2 + j2 + 1);
    calc {
        (f + (f + f)) + f ≈ ((f + f) + f) + f := Rat::add_respects(Rat::same_sym(f.add_assoc(f, f)), f.same_refl()),
        ≈ (f + f) + (f + f) := (f + f).add_assoc(f, f),
        <= (h + h) + (h + h) := Rat::add_le_mono(Rat::add_le_mono(hf, hf), Rat::add_le_mono(hf, hf)),
        ≈ Rat::inv_succ(j2) + Rat::inv_succ(j2) := Rat::add_respects(Rat::inv_succ_half(j2), Rat::inv_succ_half(j2)),
        ≈ Rat::inv_succ(j) := Rat::inv_succ_half(j),
    }
}

// A middle step within 1/(2k+2) between two steps within 1/(4k+4) each
// stays within 1/(k+1): the shape of a chain whose ends are roundings.
theorem Rat::sandwich_le({e, m: Rat}, k: Nat, he: e <= Rat::inv_succ((k + k + 1) + (k + k + 1) + 1), hm: m <= Rat::inv_succ(k + k + 1)):
    (e + m) + e <= Rat::inv_succ(k)
{
    let half = Rat::inv_succ(k + k + 1);
    let q = Rat::inv_succ((k + k + 1) + (k + k + 1) + 1);
    calc {
        (e + m) + e ≈ (m + e) + e := Rat::add_respects(e.add_comm(m), e.same_refl()),
        ≈ m + (e + e) := m.add_assoc(e, e),
        <= half + (q + q) := Rat::add_le_mono(hm, Rat::add_le_mono(he, he)),
        ≈ half + half := Rat::add_respects(half.same_refl(), Rat::inv_succ_half(k + k + 1)),
        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
    }
}

// A bound of l+1 against the step 1/((l+1)(k+1)) leaves 1/(k+1): the
// product reads its factors at index (l+1)(k+1) - 1 to keep the other
// factor's size inside the rate.
theorem Rat::scale_inv_succ(l, k: Nat): Rat::ofInt(OfNat(l + 1)) * Rat::inv_succ(l * (k + 1) + k) ≈ Rat::inv_succ(k) {
    let big = Rat::ofInt(OfNat(l + 1));
    let fine = Rat::inv_succ(l * (k + 1) + k);
    let whole: (Rat::inv_succ(k).den.int() = OfNat(k) + 1) = refl;
    let part: (fine.den.int() = OfNat(l) * (OfNat(k) + 1) + OfNat(k) + 1) = refl;
    let scale: (OfNat(l + 1) = OfNat(l) + 1) = Int::ofNat_add(l, 1);
    let unit: (big.den.int() = 1) = refl;
    let prod: ((big * fine).den.int() = fine.den.int()) = ring(big.den_mul(fine), unit);
    let both: ((big * fine).den.int() = OfNat(l + 1) * Rat::inv_succ(k).den.int()) = ring(prod, part, whole, scale);
    ring(both)
}

theorem Rat::scale_inv_succ_half(l, k: Nat):
    Rat::ofInt(OfNat(l + 1)) * Rat::inv_succ(l * (k + k + 1 + 1) + (k + k + 1))
        + Rat::ofInt(OfNat(l + 1)) * Rat::inv_succ(l * (k + k + 1 + 1) + (k + k + 1)) ≈ Rat::inv_succ(k)
{
    Rat::same_trans(Rat::add_respects(Rat::scale_inv_succ(l, k + k + 1), Rat::scale_inv_succ(l, k + k + 1)), Rat::inv_succ_half(k))
}

// Steps multiply: 1/(k+1) · 1/(l+1) = 1/((k+1)(l+1)), the gap a product of
// two positive reals keeps.
theorem Rat::inv_succ_mul(k, l: Nat): Rat::inv_succ(k) * Rat::inv_succ(l) ≈ Rat::inv_succ(k * (l + 1) + l) {
    let a = Rat::inv_succ(k);
    let b = Rat::inv_succ(l);
    let c = Rat::inv_succ(k * (l + 1) + l);
    let da: (a.den.int() = OfNat(k) + 1) = refl;
    let db: (b.den.int() = OfNat(l) + 1) = refl;
    let dc: (c.den.int() = OfNat(k) * (OfNat(l) + 1) + OfNat(l) + 1) = refl;
    let prod: ((a * b).den.int() = (OfNat(k) + 1) * (OfNat(l) + 1)) = ring(a.den_mul(b), da, db);
    ring(prod, dc)
}

// The quantitative form, for the reals' terms: a product at least 1/(j+1)
// whose first factor lies in (0, l+1] leaves the second factor at least
// 1/((l+1)(j+1)), since below that the product would fall under
// (l+1) · 1/((l+1)(j+1)) = 1/(j+1).
theorem Rat::le_of_mul_le_bounded({p, q: Rat}, j, l: Nat, hp: 0 < p, hb: p <= Rat::ofInt(OfNat(l + 1)),
    h: Rat::inv_succ(j) <= p * q): Rat::inv_succ(l * (j + 1) + j) <= q
{
    let c = Rat::inv_succ(l * (j + 1) + j);
    Rat::le_of_not_lt(λ lt => {
        let below = calc {
            p * q < p * c := Rat::mul_lt_mono_l(lt, hp),
            <= Rat::ofInt(OfNat(l + 1)) * c := Rat::mul_le_mono_r(hb, Rat::le_of_lt(Rat::inv_succ_pos(l * (j + 1) + j))),
            ≈ Rat::inv_succ(j) := Rat::scale_inv_succ(l, j),
        };
        Rat::not_le_of_lt(below, h)
    })
}

// `inv_pow2(n)` is 2^-n, the binary step: the rate of a real's n-th term
// (std/creal), so that the index counts bits. Its denominator is a power of
// two, positive by `Nat::pow_pos`.

fn Rat::inv_pow2(n: Nat) → Rat { Rat(1, Nat::pow(2, n)) }

theorem Rat::inv_pow2_pos(n: Nat): 0 < Rat::inv_pow2(n) { omega }

theorem Rat::inv_pow2_nonneg(n: Nat): 0 <= Rat::inv_pow2(n) { Rat::le_of_lt(Rat::inv_pow2_pos(n)) }

theorem Rat::inv_pow2_antitone(m, n: Nat, h: m <= n): Rat::inv_pow2(n) <= Rat::inv_pow2(m) {
    let grow: (Nat::pow(2, m) <= Nat::pow(2, n)) = Nat::pow_le_pow_r(2, m, n, trivial, h);
    omega(grow)
}

// Two halves of 2^-n: 2^-(n+1) + 2^-(n+1) ≈ 2^-n.
theorem Rat::inv_pow2_half(n: Nat): Rat::inv_pow2(n + 1) + Rat::inv_pow2(n + 1) ≈ Rat::inv_pow2(n) {
    let half = Rat::inv_pow2(n + 1).den;
    let p = Nat::pow(2, n);
    let whole: (Rat::inv_pow2(n).den.int() = p.int()) = refl;
    let part: (half.int() = p.int() * 2) = refl;
    ring(whole, part, half.int_mul(half))
}

// The binary step is at most the unary one, since n + 1 <= 2^n.
theorem Rat::inv_pow2_le_inv_succ(n: Nat): Rat::inv_pow2(n) <= Rat::inv_succ(n) {
    let big: (n < Nat::pow(2, n)) = n.lt_two_pow();
    omega(big)
}

theorem Rat::inv_pow2_le_one(n: Nat): Rat::inv_pow2(n) <= 1 { Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_le_one(n)) }

// A bound of 2^b against the step 2^-(n+b) leaves 2^-n: the product reads its
// factors b bits further out to keep the other factor's size inside the rate.
theorem Rat::scale_inv_pow2(b, n: Nat): Rat::ofInt(Nat::pow(2, b).int()) * Rat::inv_pow2(n + b) ≈ Rat::inv_pow2(n) {
    let big = Rat::ofInt(Nat::pow(2, b).int());
    let fine = Rat::inv_pow2(n + b);
    let parts: (Nat::pow(2, n + b) = Nat::pow(2, n) * Nat::pow(2, b)) = Nat::pow_add(2, n, b);
    let fd: (fine.den.int() = Nat::pow(2, n + b).int()) = refl;
    let part: (Nat::pow(2, n + b).int() = Nat::pow(2, n).int() * Nat::pow(2, b).int()) = rewrite(parts, refl);
    let whole: (Rat::inv_pow2(n).den.int() = Nat::pow(2, n).int()) = refl;
    let unit: (big.den.int() = 1) = refl;
    let prod: ((big * fine).den.int() = fine.den.int()) = ring(big.den_mul(fine), unit);
    ring(prod, fd, part, whole)
}

// Every rational is below some integer: x = a/p < |a| + 1, because p ≥ 1.
theorem Rat::archimedean(self x: Rat): ∃ n: Nat, x < Rat::ofInt(OfNat(n)) {
    let a = x.num;
    let p = x.den.int();
    let scaled = Int::mul_le_mono_l(1, p, OfNat(Succ(a.natAbs())), omega(x.den_pos), trivial);
    Exists(Succ(a.natAbs()), omega(scaled, a.le_abs()))
}

// Every positive rational is above some 1/(n+1): with ε = e/r and e ≥ 1,
// 1/(r+1) < e/r because r < e·(r+1).
theorem Rat::archimedean_inv(self eps: Rat, h: 0 < eps): ∃ n: Nat, Rat::inv_succ(n) < eps {
    let e = eps.num;
    let r = eps.den.int();
    let he: (1 <= e) = omega(Int::zero_mul(r));
    Exists(eps.den, omega(Int::mul_le_mono_r(1, e, OfNat(Succ(eps.den)), he, trivial)))
}

// Every positive rational is above some 2^-n.
theorem Rat::archimedean_inv_pow2(self eps: Rat, h: 0 < eps): ∃ n: Nat, Rat::inv_pow2(n) < eps {
    match eps.archimedean_inv(h) {
        Exists(n, small) => Exists(n, Rat::lt_of_le_of_lt(Rat::inv_pow2_le_inv_succ(n), small)),
    }
}

// A rational is at most its numerator in size, a/p with p ≥ 1; with the
// next lemma, the canonical bound of a regular Cauchy real.
theorem Rat::abs_le_natAbs(self x: Rat): x.abs() <= Rat::ofInt(OfNat(x.num.natAbs())) {
    let scaled = Int::mul_le_mono_l(1, x.den.int(), OfNat(x.num.natAbs()), omega(x.den_pos), trivial);
    omega(scaled)
}

// The least whole number above a rational's size, `⌊|num| / den⌋ + 1`: a
// bound on `|x|` that stays small when the numerator is large.
fn Rat::abs_ceil(self x: Rat) → Nat { Succ(x.num.natAbs().ldiv(x.den).quot()) }

theorem Rat::abs_le_abs_ceil(self x: Rat): x.abs() <= Rat::ofInt(OfNat(x.abs_ceil())) {
    let n = x.num.natAbs();
    let d: Nat = x.den;
    match n.ldiv(d) as λ st => DivMod::Spec(n, d, st) → x.abs() <= Rat::ofInt(OfNat(Succ(st.quot()))) {
        MkDivMod(q, r) => λ sp => {
            let parts: (q * d + r = n) = sp.left;
            let small: (r < d) = match sp.right { Inl(bad) => false_elim(omega(bad, x.den_pos)), Inr(lt) => lt };
            let succ: (d * Succ(q) = d * q + d) = refl;
            let comm: (q * d = d * q) = q.mul_comm(d);
            let flip: (Succ(q) * d = d * Succ(q)) = Succ(q).mul_comm(d);
            let bound: (x.abs() <= Rat::ofInt(OfNat(Succ(q)))) = omega(parts, small, succ, comm, flip);
            bound
        },
    }(n.ldiv_spec(d))
}

theorem Rat::two_add_ofNat(n: Nat): (1 + 1) + Rat::ofInt(OfNat(n)) ≈ Rat::ofInt(OfNat(n + 2)) {
    omega(Int::ofNat_add(n, 2))
}

// ---------------------------------------------------------------------------
// Distances: |x - y| is symmetric and obeys the triangle inequality, the two
// facts a modulus-of-convergence estimate chains.

theorem Rat::neg_sub(self x, y: Rat): -(x - y) ≈ y - x {
    calc {
        -(x - y) ≈ -x + -(-y) := x.neg_add(-y),
        ≈ -x + y := rel_cong(y.neg_neg()),
        ≈ y + -x := (-x).add_comm(y),
    }
}

theorem Rat::abs_sub_comm(self x, y: Rat): (x - y).abs() ≈ (y - x).abs() {
    calc {
        (x - y).abs() ≈ (-(x - y)).abs() := Rat::same_sym((x - y).abs_neg()),
        ≈ (y - x).abs() := Rat::abs_respects(x.neg_sub(y)),
    }
}

theorem Rat::sub_add_sub(self x, y, z: Rat): (x - y) + (y - z) ≈ x - z {
    calc {
        (x - y) + (y - z) ≈ x + (-y + (y + -z)) := x.add_assoc(-y, y - z),
        ≈ x + ((-y + y) + -z) := rel_cong(Rat::same_sym((-y).add_assoc(y, -z))),
        ≈ x + ((y + -y) + -z) := rel_cong((-y).add_comm(y)),
        ≈ x + (0 + -z) := rel_cong(y.add_neg()),
        ≈ x + (-z + 0) := rel_cong(Rat::add_comm(0, -z)),
        ≈ x + -z := rel_cong((-z).add_zero()),
    }
}

theorem Rat::dist_triangle(self x, y, z: Rat): (x - z).abs() <= (x - y).abs() + (y - z).abs() {
    calc {
        (x - z).abs() ≈ ((x - y) + (y - z)).abs() := Rat::abs_respects(Rat::same_sym(x.sub_add_sub(y, z))),
        <= (x - y).abs() + (y - z).abs() := (x - y).abs_triangle(y - z),
    }
}

// Three steps of a chain: a to b to c to d.
theorem Rat::dist_three({a, b, c, d, e1, e2, e3: Rat}, h1: (a - b).abs() <= e1, h2: (b - c).abs() <= e2, h3: (c - d).abs() <= e3):
    (a - d).abs() <= (e1 + e2) + e3
{
    calc {
        (a - d).abs() <= (a - c).abs() + (c - d).abs() := a.dist_triangle(c, d),
        <= ((a - b).abs() + (b - c).abs()) + (c - d).abs() := (a - c).abs().add_le_mono_r((a - b).abs() + (b - c).abs(), (c - d).abs(), a.dist_triangle(b, c)),
        <= (e1 + e2) + e3 := Rat::add_le_mono(Rat::add_le_mono(h1, h2), h3),
    }
}

// The facts the regular Cauchy reals (`std/creal`) chain: a point's distance
// to itself, negation and sums moved through a distance, and tightness read
// off distances.

theorem Rat::abs_sub_self(self x: Rat): (x - x).abs() ≈ 0 {
    calc {
        (x - x).abs() ≈ Rat::abs(0) := Rat::abs_respects(x.add_neg()),
        ≈ 0 := refl,
    }
}

theorem Rat::neg_sub_neg(self x, y: Rat): (-x) - (-y) ≈ -(x - y) { Rat::same_sym(x.neg_add(-y)) }

theorem Rat::abs_neg_sub_neg(self x, y: Rat): ((-x) - (-y)).abs() ≈ (x - y).abs() {
    calc {
        ((-x) - (-y)).abs() ≈ (-(x - y)).abs() := Rat::abs_respects(x.neg_sub_neg(y)),
        ≈ (x - y).abs() := (x - y).abs_neg(),
    }
}

theorem Rat::add_add_add_comm(self a, b, c, d: Rat): (a + b) + (c + d) ≈ (a + c) + (b + d) {
    ring(a.den_add(b), c.den_add(d), (a + b).den_add(c + d), a.den_add(c), b.den_add(d), (a + c).den_add(b + d))
}

theorem Rat::add_left_comm(self a, b, c: Rat): a + (b + c) ≈ b + (a + c) {
    ring(b.den_add(c), a.den_add(b + c), a.den_add(c), b.den_add(a + c))
}

// Three bounds, each a main part plus slack, regrouped into the main parts
// plus the slack.
theorem Rat::add_add_add_comm3(self a, b, c, d, e, f: Rat): ((a + b) + (c + d)) + (e + f) ≈ ((a + c) + e) + ((b + d) + f) {
    calc {
        ((a + b) + (c + d)) + (e + f) ≈ ((a + c) + (b + d)) + (e + f) := Rat::add_respects(a.add_add_add_comm(b, c, d), (e + f).same_refl()),
        ≈ ((a + c) + e) + ((b + d) + f) := (a + c).add_add_add_comm(b + d, e, f),
    }
}

theorem Rat::add_sub_add(self a, b, c, d: Rat): (a + b) - (c + d) ≈ (a - c) + (b - d) {
    calc {
        (a + b) - (c + d) ≈ (a + b) + (-c + -d) := Rat::add_respects((a + b).same_refl(), c.neg_add(d)),
        ≈ (a - c) + (b - d) := a.add_add_add_comm(b, -c, -d),
    }
}

// Two sums are as close as their summands' distances added.
theorem Rat::dist_add_le({a, b, c, d, u, v: Rat}, h1: (a - c).abs() <= u, h2: (b - d).abs() <= v):
    ((a + b) - (c + d)).abs() <= u + v
{
    calc {
        ((a + b) - (c + d)).abs() ≈ ((a - c) + (b - d)).abs() := Rat::abs_respects(a.add_sub_add(b, c, d)),
        <= (a - c).abs() + (b - d).abs() := (a - c).abs_triangle(b - d),
        <= u + v := Rat::add_le_mono(h1, h2),
    }
}

// Two products are as close as their factors, each distance weighted by the
// size of the other side's factor: ab - cd = a(b - d) + d(a - c).
theorem Rat::mul_sub_mul(self a, b, c, d: Rat): a * b - c * d ≈ a * (b - d) + d * (a - c) {
    ring(a.den_mul(b), c.den_mul(d), (a * b).den_add(-(c * d)), b.den_add(-d), a.den_mul(b - d), a.den_add(-c),
        d.den_mul(a - c), (a * (b - d)).den_add(d * (a - c)))
}

theorem Rat::dist_mul_le({a, b, c, d, m, e: Rat}, ha: a.abs() <= m, hd: d.abs() <= m,
    hbd: (b - d).abs() <= e, hac: (a - c).abs() <= e): (a * b - c * d).abs() <= m * e + m * e
{
    calc {
        (a * b - c * d).abs() ≈ (a * (b - d) + d * (a - c)).abs() := Rat::abs_respects(a.mul_sub_mul(b, c, d)),
        <= (a * (b - d)).abs() + (d * (a - c)).abs() := (a * (b - d)).abs_triangle(d * (a - c)),
        ≈ a.abs() * (b - d).abs() + d.abs() * (a - c).abs() := Rat::add_respects(a.abs_mul(b - d), d.abs_mul(a - c)),
        <= m * e + m * e := Rat::add_le_mono(
            Rat::mul_le_mul(ha, hbd, a.abs_nonneg(), (b - d).abs_nonneg()),
            Rat::mul_le_mul(hd, hac, d.abs_nonneg(), (a - c).abs_nonneg())),
    }
}

theorem Rat::mul_add_twice(self m, p, q: Rat): m * (p + q) + m * (p + q) ≈ (m * p + m * p) + (m * q + m * q) {
    calc {
        m * (p + q) + m * (p + q) ≈ (m * p + m * q) + (m * p + m * q) := Rat::add_respects(m.mul_add_distr(p, q), m.mul_add_distr(p, q)),
        ≈ (m * p + m * p) + (m * q + m * q) := (m * p).add_add_add_comm(m * q, m * p, m * q),
    }
}

theorem Rat::sub_add_cancel(self a, b: Rat): (a - b) + b ≈ a { ring(a.den_add(-b), (a - b).den_add(b)) }

theorem Rat::add_sub_cancel_l(self a, b: Rat): (a + b) - a ≈ b { ring(a.den_add(b), (a + b).den_add(-a)) }

theorem Rat::add_sub_self(self a, b: Rat): a + (b - a) ≈ b { ring(b.den_add(-a), a.den_add(b - a)) }

// ---------------------------------------------------------------------------
// Reciprocals away from zero: the estimates the inverse of a regular Cauchy
// real chains. A rational at least 1/(k+1) in size is nonzero, its
// reciprocal is at most k+1 in size, and two such reciprocals are within
// (k+1)(l+1) times the distance between what they invert.

theorem Rat::ofNat_nonneg(n: Nat): 0 <= Rat::ofInt(OfNat(n)) { omega }

theorem Rat::succ_mul_inv_succ(k: Nat): Rat::ofInt(OfNat(k + 1)) * Rat::inv_succ(k) ≈ 1 { omega }

// A factor m against a step at most 1/(m(n+1)+n+1) leaves at most 1/(n+1):
// `scale_inv_succ` with one more unit of slack, so that m need not be a
// successor.
theorem Rat::scale_inv_succ_le({e: Rat}, m, j, n: Nat, far: m * (n + 1) + n <= j, he: e <= Rat::inv_succ(j)):
    Rat::ofInt(OfNat(m)) * e <= Rat::inv_succ(n)
{
    let big = Rat::ofInt(OfNat(m));
    let fine = Rat::inv_succ(m * (n + 1) + n);
    let wider: (OfNat(m) <= OfNat(m + 1)) = omega;
    calc {
        big * e <= big * Rat::inv_succ(j) := Rat::mul_le_mono_l(he, Rat::ofNat_nonneg(m)),
        <= big * fine := Rat::mul_le_mono_l(Rat::inv_succ_antitone(m * (n + 1) + n, j, far), Rat::ofNat_nonneg(m)),
        <= Rat::ofInt(OfNat(m + 1)) * fine := Rat::mul_le_mono_r(Rat::ofInt_le(OfNat(m), OfNat(m + 1), wider),
            Rat::le_of_lt(Rat::inv_succ_pos(m * (n + 1) + n))),
        ≈ Rat::inv_succ(n) := Rat::scale_inv_succ(m, n),
    }
}

// A gap below zero, or above it, is a lower bound on the size.
theorem Rat::le_abs_of_add_le_zero({a, g: Rat}, h: a + g <= 0): g <= a.abs() {
    calc {
        g ≈ (a + g) - a := Rat::same_sym(a.add_sub_cancel_l(g)),
        <= 0 + -a := (a + g).add_le_mono_r(0, -a, h),
        ≈ -a + 0 := Rat::add_comm(0, -a),
        ≈ -a := (-a).add_zero(),
        <= a.abs() := a.neg_le_abs(),
    }
}

theorem Rat::le_abs_of_zero_add_le({a, g: Rat}, h: 0 + g <= a): g <= a.abs() {
    calc {
        g ≈ g + 0 := Rat::same_sym(g.add_zero()),
        ≈ 0 + g := g.add_comm(0),
        <= a := h,
        <= a.abs() := a.le_abs(),
    }
}

theorem Rat::nonzero_of_gap({a: Rat}, k: Nat, h: Rat::inv_succ(k) <= a.abs()): ¬(a ≈ 0) {
    λ zero => Rat::not_le_of_lt(Rat::inv_succ_pos(k), calc {
        Rat::inv_succ(k) <= a.abs() := h,
        ≈ Rat::abs(0) := Rat::abs_respects(zero),
        ≈ 0 := refl,
    })
}

// |a| ≥ 1/(k+1) bounds |1/a| by k+1: a larger reciprocal would make
// |a·(1/a)| = 1 larger than (1/(k+1))·(k+1) = 1.
theorem Rat::recip_abs_le({a: Rat}, k: Nat, h: Rat::inv_succ(k) <= a.abs()): a.recip().abs() <= Rat::ofInt(OfNat(k + 1)) {
    let u = a.recip();
    let big = Rat::ofInt(OfNat(k + 1));
    let g = Rat::inv_succ(k);
    Rat::le_of_not_lt(λ above => {
        let unit = calc {
            1 ≈ g * big := Rat::same_sym(Rat::same_trans(g.mul_comm(big), Rat::succ_mul_inv_succ(k))),
            < g * u.abs() := Rat::mul_lt_mono_l(above, Rat::inv_succ_pos(k)),
            <= a.abs() * u.abs() := Rat::mul_le_mono_r(h, u.abs_nonneg()),
            ≈ (a * u).abs() := Rat::same_sym(a.abs_mul(u)),
            ≈ Rat::abs(1) := Rat::abs_respects(a.mul_recip(Rat::nonzero_of_gap(k, h))),
            ≈ 1 := refl,
        };
        Rat::lt_irrefl(1, unit)
    })
}

// Differences of inverses: with a·u ≈ 1 and b·v ≈ 1, u - v ≈ uv(b - a), and
// a·u - 1 ≈ u(a - b) when b·u ≈ 1.
theorem Rat::sub_of_inverses({a, b, u, v: Rat}, hu: a * u ≈ 1, hv: b * v ≈ 1):
    u - v ≈ (u * v) * (b - a)
{
    let left = calc {
        u ≈ u * 1 := Rat::same_sym(u.mul_one()),
        ≈ u * (b * v) := Rat::mul_respects(u.same_refl(), Rat::same_sym(hv)),
    };
    let right = calc {
        v ≈ v * 1 := Rat::same_sym(v.mul_one()),
        ≈ v * (a * u) := Rat::mul_respects(v.same_refl(), Rat::same_sym(hu)),
        ≈ (a * u) * v := v.mul_comm(a * u),
    };
    calc {
        u - v ≈ u * (b * v) - (a * u) * v := Rat::sub_respects(left, right),
        ≈ (u * v) * (b - a) := ring(b.den_mul(v), u.den_mul(b * v), a.den_mul(u), (a * u).den_mul(v),
            (u * (b * v)).den_add(-((a * u) * v)), u.den_mul(v), b.den_add(-a), (u * v).den_mul(b - a)),
    }
}

theorem Rat::mul_sub_one_of_inverse({a, b, u: Rat}, hu: b * u ≈ 1): a * u - 1 ≈ u * (a - b) {
    calc {
        a * u - 1 ≈ a * u - b * u := Rat::sub_respects((a * u).same_refl(), Rat::same_sym(hu)),
        ≈ u * (a - b) := ring(a.den_mul(u), b.den_mul(u), (a * u).den_add(-(b * u)), a.den_add(-b), u.den_mul(a - b)),
    }
}

// Reciprocals of two rationals at least 1/(k+1) and 1/(l+1) in size are
// within (k+1)(l+1) times their distance.
theorem Rat::dist_recip_le({a, b: Rat}, k, l: Nat, ha: Rat::inv_succ(k) <= a.abs(), hb: Rat::inv_succ(l) <= b.abs()):
    (a.recip() - b.recip()).abs() <= Rat::ofInt(OfNat((k + 1) * (l + 1))) * (a - b).abs()
{
    let u = a.recip();
    let v = b.recip();
    let du = Rat::ofInt(OfNat(k + 1));
    let dv = Rat::ofInt(OfNat(l + 1));
    calc {
        (u - v).abs() ≈ ((u * v) * (b - a)).abs()
            := Rat::abs_respects(Rat::sub_of_inverses(a.mul_recip(Rat::nonzero_of_gap(k, ha)), b.mul_recip(Rat::nonzero_of_gap(l, hb)))),
        ≈ (u * v).abs() * (b - a).abs() := (u * v).abs_mul(b - a),
        ≈ (u.abs() * v.abs()) * (a - b).abs() := Rat::mul_respects(u.abs_mul(v), b.abs_sub_comm(a)),
        <= (du * dv) * (a - b).abs() := Rat::mul_le_mono_r(
            Rat::mul_le_mul(Rat::recip_abs_le(k, ha), Rat::recip_abs_le(l, hb), u.abs_nonneg(), v.abs_nonneg()), (a - b).abs_nonneg()),
        ≈ Rat::ofInt(OfNat((k + 1) * (l + 1))) * (a - b).abs()
            := Rat::mul_respects(Rat::same_sym(Rat::ofInt_mul(OfNat(k + 1), OfNat(l + 1))), (a - b).abs().same_refl()),
    }
}

theorem Rat::le_add_nonneg(self a, e: Rat, h: 0 <= e): a <= a + e {
    calc {
        a ≈ a + 0 := Rat::same_sym(a.add_zero()),
        <= a + e := Rat::add_le_mono_l(0, e, a, h),
    }
}

// Two factors that each fall short of zero by at most e, and are at most m
// in size, fall short as a product by at most m·e. If either factor is
// nonnegative, the product loses at most e times that factor's size; if
// both are negative, the product is positive. A product of approximations
// of nonnegative reals is nearly nonnegative this way.
theorem Rat::mul_nonneg_approx({p, q, e, m: Rat}, hp: 0 <= p + e, hq: 0 <= q + e,
    he: 0 <= e, sp: p.abs() <= m, sq: q.abs() <= m): 0 <= p * q + m * e
{
    let hm: (0 <= m) = Rat::le_trans(p.abs_nonneg(), sp);
    match Rat::le_total(0, p) {
        Inl(p_up) => calc {
            0 <= p * (q + e) := Rat::mul_nonneg(p_up, hq),
            ≈ p * q + p * e := p.mul_add_distr(q, e),
            <= p * q + m * e := (p * e).add_le_mono_l(m * e, p * q, Rat::mul_le_mono_r(Rat::le_trans(p.le_abs(), sp), he)),
        },
        Inr(p_down) => match Rat::le_total(0, q) {
            Inl(q_up) => calc {
                0 <= q * (p + e) := Rat::mul_nonneg(q_up, hp),
                ≈ q * p + q * e := q.mul_add_distr(p, e),
                <= q * p + m * e := (q * e).add_le_mono_l(m * e, q * p, Rat::mul_le_mono_r(Rat::le_trans(q.le_abs(), sq), he)),
                ≈ p * q + m * e := Rat::add_respects(q.mul_comm(p), (m * e).same_refl()),
            },
            Inr(q_down) => {
                let flat: (Rat::neg(0) ≈ 0) = refl;
                let np: (0 <= -p) = Rat::le_respects(flat, (-p).same_refl(), Rat::neg_le(p_down));
                let nq: (0 <= -q) = Rat::le_respects(flat, (-q).same_refl(), Rat::neg_le(q_down));
                let flip: ((-p) * (-q) ≈ p * q) = ring;
                calc {
                    0 <= (-p) * (-q) := Rat::mul_nonneg(np, nq),
                    ≈ p * q := flip,
                    <= p * q + m * e := (p * q).le_add_nonneg(m * e, Rat::mul_nonneg(hm, he)),
                }
            },
        },
    }
}

// A distance bound as two one-sided bounds, and back.
theorem Rat::le_add_of_dist({a, b, e: Rat}, h: (a - b).abs() <= e): a <= b + e {
    calc {
        a ≈ (a - b) + b := Rat::same_sym(a.sub_add_cancel(b)),
        <= e + b := (a - b).add_le_mono_r(e, b, Rat::le_trans((a - b).le_abs(), h)),
        ≈ b + e := e.add_comm(b),
    }
}

theorem Rat::sub_le_of_le_add({a, b, c: Rat}, h: a <= b + c): a - b <= c {
    calc {
        a - b <= (b + c) - b := a.add_le_mono_r(b + c, -b, h),
        ≈ c := b.add_sub_cancel_l(c),
    }
}

theorem Rat::dist_le_of_le_add({a, b, c: Rat}, h1: a <= b + c, h2: b <= a + c): (a - b).abs() <= c {
    let below = calc {
        -c <= -(b - a) := Rat::neg_le(Rat::sub_le_of_le_add(h2)),
        ≈ a - b := b.neg_sub(a),
    };
    Rat::abs_le(below, Rat::sub_le_of_le_add(h1))
}

// Sizes are no further apart than the numbers: the reverse triangle
// inequality, each size within the other's plus the distance.
theorem Rat::abs_sub_abs_le(self x, y: Rat): (x.abs() - y.abs()).abs() <= (x - y).abs() {
    let up = calc {
        x.abs() ≈ ((x - y) + y).abs() := Rat::abs_respects(Rat::same_sym(x.sub_add_cancel(y))),
        <= (x - y).abs() + y.abs() := (x - y).abs_triangle(y),
        ≈ y.abs() + (x - y).abs() := (x - y).abs().add_comm(y.abs()),
    };
    let down = calc {
        y.abs() ≈ ((y - x) + x).abs() := Rat::abs_respects(Rat::same_sym(y.sub_add_cancel(x))),
        <= (y - x).abs() + x.abs() := (y - x).abs_triangle(x),
        ≈ x.abs() + (y - x).abs() := (y - x).abs().add_comm(x.abs()),
        ≈ x.abs() + (x - y).abs() := Rat::add_respects(x.abs().same_refl(), y.abs_sub_comm(x)),
    };
    Rat::dist_le_of_le_add(up, down)
}

// A gap of q + 2e between a and b survives moving a up and b down by e
// each: the step a strict order on the reals takes whenever it compares
// terms at two indices, or of two `≈` sequences.
theorem Rat::le_of_close_gap({a, a2, b, b2, e, q: Rat}, ha: a2 <= a + e, hb: b <= b2 + e, gap: a + (q + (e + e)) <= b):
    a2 + q <= b2
{
    let shifted = calc {
        (a2 + q) + e <= ((a + e) + q) + e := (a2 + q).add_le_mono_r((a + e) + q, e, a2.add_le_mono_r(a + e, q, ha)),
        ≈ a + (q + (e + e)) := ring(a.den_add(e), (a + e).den_add(q), ((a + e) + q).den_add(e), e.den_add(e), q.den_add(e + e), a.den_add(q + (e + e))),
        <= b := gap,
        <= b2 + e := hb,
    };
    (a2 + q).add_le_cancel_r(b2, e, shifted)
}

// Two rationals within every 1/(k+1) of each other are the same number: a
// positive distance would sit above some 1/(k+1) (`archimedean_inv`).
theorem Rat::same_of_close(self x, y: Rat, close: (k: Nat) → (x - y).abs() <= Rat::inv_succ(k)): x ≈ y {
    let d = x - y;
    let small: (d.abs() <= 0) = Rat::le_of_not_lt(λ positive => {
        match d.abs().archimedean_inv(positive) {
            Exists(k, gap) => Rat::not_le_of_lt(gap, close(k)),
        }
    });
    let above = d.num.le_abs();
    let below = d.num.neg_le_abs();
    let zero = Int::zero_mul(d.den.int());
    let flip = y.num.mul_neg_l(x.den.int());
    let gap: (d.num = x.num * y.den.int() + (-y.num) * x.den.int()) = refl;
    let mag: (d.abs().num = d.num.abs()) = refl;
    let den: (d.abs().den = d.den) = refl;
    omega
}

// The one-sided form: a rational below b plus every 1/(k+1) is below b, since
// an excess over b would sit above some 1/(k+1).
theorem Rat::le_of_le_add_inv_succ({a, b: Rat}, close: (k: Nat) → a <= b + Rat::inv_succ(k)): a <= b {
    Rat::le_of_not_lt(λ above => {
        match (a - b).archimedean_inv(Rat::sub_pos(above)) {
            Exists(k, gap) => Rat::not_le_of_lt(gap, Rat::sub_le_of_le_add(close(k))),
        }
    })
}

// ---------------------------------------------------------------------------
// Apartness, the inverse, and integer powers
// (docs/inverse-power-notation-design.md). The inverse takes apartness from
// zero, as the reals' does, rather than giving 0 a junk value: `x⁻¹` is
// `x.inv(h)` with `h` searched at the call (`:= infer`), so it costs
// nothing where a hypothesis is in scope, a rule builds one, or `x` is a
// positive or negative literal. At `Rat` apartness and `¬(x ≈ 0)` are
// interchangeable (`apart_of_nonzero`, `nonzero_of_apart`), and the value
// never reads the proof.

fn Rat::Apart(x, y: Rat) → Type { x < y ∨ y < x }

// The sign premises of the rules below, as one-place predicates: `0 < x`
// has as many symbols as `x.Apart(0)`, so a rule from one to the other
// could not show the search terminates; `x.Positive()` has fewer. A local
// `h: 0 < x` is one by conversion.
fn Rat::Positive(self x: Rat) → Type { 0 < x }
fn Rat::Negative(self x: Rat) → Type { x < 0 }

evidence theorem Rat::apart_of_positive({x: Rat}, h: x.Positive() := infer): x.Apart(0) { Inr(h) }
evidence theorem Rat::apart_of_negative({x: Rat}, h: x.Negative() := infer): x.Apart(0) { Inl(h) }

theorem Rat::apart_sym({x, y: Rat}, h: x.Apart(y)): y.Apart(x) {
    match h {
        Inl(lt) => Inr(lt),
        Inr(gt) => Inl(gt),
    }
}

theorem Rat::apart_irrefl(self x: Rat): ¬(x.Apart(x)) {
    λ h => match h {
        Inl(lt) => x.lt_irrefl(lt),
        Inr(lt) => x.lt_irrefl(lt),
    }
}

// Closed facts by evaluation (`norm_num`, docs/numeral-normalisation-design.md):
// `≈` and the orders as `Bool`s over the cross products, through `Int`'s
// `same` and `leb`. A verdict computed to `True` proves the fact and one
// computed to `False` refutes it, so a closed comparison costs evaluating
// the two sides and never a conversion over their representation. `Lt` is
// `Int`'s, `a.isucc() <= b`, so its verdict is that `leb`.
fn Rat::same_bool(self x, y: Rat) → Bool { (x.num * y.den.int()).same(y.num * x.den.int()) }
fn Rat::le_bool(self x, y: Rat) → Bool { (x.num * y.den.int()).leb(y.num * x.den.int()) }
fn Rat::lt_bool(self x, y: Rat) → Bool { (x.num * y.den.int()).isucc().leb(y.num * x.den.int()) }

theorem Rat::same_of_bool(self x, y: Rat, h: x.same_bool(y) = True): x ≈ y { Int::same_sound(x.num * y.den.int(), y.num * x.den.int(), h) }
theorem Rat::not_same_of_bool(self x, y: Rat, h: x.same_bool(y) = False): ¬(x ≈ y) { Int::ne_of_same(x.num * y.den.int(), y.num * x.den.int(), h) }
theorem Rat::le_of_bool(self x, y: Rat, h: x.le_bool(y) = True): x <= y { Int::le_of_leb(x.num * y.den.int(), y.num * x.den.int(), h) }
theorem Rat::not_le_of_bool(self x, y: Rat, h: x.le_bool(y) = False): ¬(x <= y) { Int::not_le_of_leb(x.num * y.den.int(), y.num * x.den.int(), h) }
theorem Rat::lt_of_bool(self x, y: Rat, h: x.lt_bool(y) = True): x < y { Int::le_of_leb((x.num * y.den.int()).isucc(), y.num * x.den.int(), h) }
theorem Rat::not_lt_of_bool(self x, y: Rat, h: x.lt_bool(y) = False): ¬(x < y) { Int::not_le_of_leb((x.num * y.den.int()).isucc(), y.num * x.den.int(), h) }
// The order's decision. Its bit is `le_bool`, the cross-product comparison,
// so a decided `<=` evaluates as that comparison does
// (issues/decide-bit-is-the-comparison.md).
instance(x, y: Rat) Decide<Rat::Le(x, y)> {
    dec := x.le_dec(y),
    bit := x.le_bool(y),
    reflects := And(x.le_of_bool(y), x.not_le_of_bool(y)),
}

theorem Rat::apart_of_lt_bool(self x, y: Rat, h: x.lt_bool(y) = True): x.Apart(y) { Inl(x.lt_of_bool(y, h)) }
theorem Rat::apart_of_gt_bool(self x, y: Rat, h: y.lt_bool(x) = True): x.Apart(y) { Inr(y.lt_of_bool(x, h)) }
theorem Rat::not_apart_of_bool(self x, y: Rat, h1: x.lt_bool(y) = False, h2: y.lt_bool(x) = False): ¬(x.Apart(y)) {
    λ a => match a { Inl(lt) => x.not_lt_of_bool(y, h1, lt), Inr(gt) => y.not_lt_of_bool(x, h2, gt) }
}

theorem Rat::nonzero_of_apart({x: Rat}, h: x.Apart(0)): ¬(x ≈ 0) {
    λ zero => match h {
        Inl(lt) => Rat::lt_irrefl(0, Rat::lt_respects(zero, Rat::same_refl(0), lt)),
        Inr(gt) => Rat::lt_irrefl(0, Rat::lt_respects(Rat::same_refl(0), zero, gt)),
    }
}

theorem Rat::apart_of_nonzero({x: Rat}, h: ¬(x ≈ 0)): x.Apart(0) {
    match x.lt_trichotomy(0) {
        Inl(lt) => Inl(lt),
        Inr(rest) => match rest {
            Inl(same) => false_elim(h(same)),
            Inr(gt) => Inr(gt),
        },
    }
}

// A sign is the numerator's sign.
theorem Rat::num_pos({x: Rat}, h: 0 < x): 0 < x.num { omega }

theorem Rat::num_abs_pos(self q: Rat, pos: 0 < q): 0 < q.num.natAbs() {
    match q.num as λ z => 0 < z → 0 < z.natAbs() {
        OfNat(n) => λ h => { let k: (0 < n) = h; k },
        NegSucc(_) => λ (h: False) => false_elim(h),
    }(Rat::num_pos(pos))
}
theorem Rat::num_neg({x: Rat}, h: x < 0): x.num < 0 { omega }

// A product of numbers apart from zero is apart from zero: the sign of the
// product's numerator is the product of the signs.
evidence theorem Rat::apart_mul({x, y: Rat}, hx: x.Apart(0) := infer, hy: y.Apart(0) := infer):
    (x * y).Apart(0)
{
    let a = x.num;
    let b = y.num;
    let num: ((x * y).num = a * b) = refl;
    match hx {
        Inl(xn) => {
            let ha = Rat::num_neg(xn);
            match hy {
                Inl(yn) => {
                    let hb = Rat::num_neg(yn);
                    let pos = (-a).mul_pos(-b, omega, p_pos := omega);
                    let l = a.mul_neg_l(-b);
                    let r = a.mul_neg_r(b);
                    Inr(omega)
                },
                Inr(yp) => {
                    let neg = a.mul_neg(b, ha, p_pos := Rat::num_pos(yp));
                    Inl(omega)
                },
            }
        },
        Inr(xp) => {
            let ha = Rat::num_pos(xp);
            match hy {
                Inl(yn) => {
                    let neg = b.mul_neg(a, Rat::num_neg(yn), p_pos := ha);
                    let swap = a.mul_comm(b);
                    Inl(omega)
                },
                Inr(yp) => {
                    let pos = a.mul_pos(b, ha, p_pos := Rat::num_pos(yp));
                    Inr(omega)
                },
            }
        },
    }
}

// The inverse, at apartness from zero; `x⁻¹` is this with `h` searched.
fn Rat::inv(self x: Rat, h: x.Apart(0) := infer) → Rat { x.recip() }

designation postfix ⁻¹ at Rat := Rat::inv

// The value never reads the proof.
theorem Rat::inv_any_proof(self x: Rat, h, h2: x.Apart(0)): x.inv(h := h) = x.inv(h := h2) { refl }

theorem Rat::mul_inv(self x: Rat, h: x.Apart(0) := infer): x * x⁻¹ ≈ 1 {
    x.mul_recip(Rat::nonzero_of_apart(h))
}

theorem Rat::inv_mul(self x: Rat, h: x.Apart(0) := infer): x⁻¹ * x ≈ 1 {
    Rat::same_trans(x⁻¹.mul_comm(x), x.mul_inv())
}

theorem Rat::inv_respects({x, x2: Rat}, hx: x ≈ x2, h: x.Apart(0) := infer, h2: x2.Apart(0) := infer):
    x⁻¹ ≈ x2⁻¹
{
    Rat::recip_respects(hx)
}

// An inverse is unique: anything y multiplies to 1 is y⁻¹.
theorem Rat::inv_unique({y, u: Rat}, hu: y * u ≈ 1, h: y.Apart(0) := infer): u ≈ y⁻¹ {
    calc {
        u ≈ u * 1 := Rat::same_sym(u.mul_one()),
        ≈ u * (y * y⁻¹) := Rat::mul_respects(u.same_refl(), Rat::same_sym(y.mul_inv())),
        ≈ (u * y) * y⁻¹ := Rat::same_sym(u.mul_assoc(y, y⁻¹)),
        ≈ (y * u) * y⁻¹ := Rat::mul_respects(u.mul_comm(y), y⁻¹.same_refl()),
        ≈ 1 * y⁻¹ := Rat::mul_respects(hu, y⁻¹.same_refl()),
        ≈ y⁻¹ * 1 := Rat::mul_comm(1, y⁻¹),
        ≈ y⁻¹ := y⁻¹.mul_one(),
    }
}

// Powers at a natural exponent, recursing as `Nat::pow` does, with the
// recursive result on the left.
fn Rat::npow(self x: Rat, n: Nat) → Rat {
    match n {
        Zero => 1,
        Succ(k) => x.npow(k) * x,
    }
}

theorem Rat::npow_respects({x, x2: Rat}, hx: x ≈ x2, n: Nat): x.npow(n) ≈ x2.npow(n) {
    match n {
        Zero => Rat::same_refl(1),
        Succ(k) => Rat::mul_respects(Rat::npow_respects(hx, k), hx),
    }
}

theorem Rat::npow_add(self x: Rat, m, n: Nat): x.npow(m + n) ≈ x.npow(m) * x.npow(n) {
    match n {
        Zero => Rat::same_sym(x.npow(m).mul_one()),
        Succ(k) => calc {
            x.npow(m + Succ(k)) ≈ x.npow(m + k) * x := refl,
            ≈ (x.npow(m) * x.npow(k)) * x := Rat::mul_respects(x.npow_add(m, k), x.same_refl()),
            ≈ x.npow(m) * (x.npow(k) * x) := x.npow(m).mul_assoc(x.npow(k), x),
        },
    }
}

theorem Rat::mul_npow(self x, y: Rat, n: Nat): (x * y).npow(n) ≈ x.npow(n) * y.npow(n) {
    match n {
        Zero => Rat::same_sym(Rat::mul_one(1)),
        Succ(k) => {
            let p = x.npow(k);
            let q = y.npow(k);
            calc {
                (x * y).npow(Succ(k)) ≈ (x * y).npow(k) * (x * y) := refl,
                ≈ (p * q) * (x * y) := Rat::mul_respects(x.mul_npow(y, k), (x * y).same_refl()),
                ≈ (p * x) * (q * y) := ring(p.den_mul(q), x.den_mul(y), (p * q).den_mul(x * y), p.den_mul(x), q.den_mul(y), (p * x).den_mul(q * y)),
            }
        },
    }
}

theorem Rat::one_npow(n: Nat): Rat::npow(1, n) ≈ 1 {
    match n {
        Zero => Rat::same_refl(1),
        Succ(k) => Rat::same_trans(Rat::mul_respects(Rat::one_npow(k), Rat::same_refl(1)), Rat::mul_one(1)),
    }
}

theorem Rat::npow_apart(self x: Rat, n: Nat, h: x.Apart(0)): x.npow(n).Apart(0) {
    match n {
        Zero => Rat::apart_of_positive(),
        Succ(k) => Rat::apart_mul(hx := x.npow_apart(k, h), hy := h),
    }
}

evidence theorem Rat::apart_npow({x: Rat}, {n: Nat}, h: x.Apart(0) := infer): x.npow(n).Apart(0) {
    x.npow_apart(n, h)
}

theorem Rat::npow_nonneg({x: Rat}, n: Nat, hx: 0 <= x): 0 <= x.npow(n) {
    match n {
        Zero => trivial,
        Succ(k) => Rat::mul_nonneg(Rat::npow_nonneg(k, hx), hx),
    }
}

theorem Rat::npow_pos({x: Rat}, n: Nat, hx: 0 < x): 0 < x.npow(n) {
    match n {
        Zero => trivial,
        Succ(k) => Rat::mul_pos(Rat::npow_pos(k, hx), hx),
    }
}

// A power grows with a nonnegative base.
theorem Rat::npow_le_mono({x, y: Rat}, n: Nat, h: x <= y, hx: 0 <= x): x.npow(n) <= y.npow(n) {
    match n {
        Zero => Rat::le_refl(1),
        Succ(k) => Rat::mul_le_mul(Rat::npow_le_mono(k, h, hx), h, Rat::npow_nonneg(k, hx), hx),
    }
}

// An inverse is apart from zero: were it ≈ 0, x · x⁻¹ would be ≈ 0, not 1.
evidence theorem Rat::apart_inv({x: Rat}, {h: x.Apart(0)}): x.inv(h := h).Apart(0) {
    Rat::apart_of_nonzero(λ zero => {
        let bad: Rat::Same(1, 0) = calc {
            1 ≈ x * x⁻¹ := Rat::same_sym(x.mul_inv()),
            ≈ x * 0 := Rat::mul_respects(x.same_refl(), zero),
            ≈ 0 * x := x.mul_comm(0),
            ≈ 0 := x.zero_mul(),
        };
        omega
    })
}

// Powers at an integer exponent. The side condition depends on the
// exponent's sign: nothing at n ≥ 0, apartness from zero at n < 0, so
// `x ^ 2` asks for nothing and `x ^ (-1)` asks exactly what `x⁻¹` does. The
// condition computes, and the search reads what it computes to.
fn Rat::PowOk(x: Rat, n: Int) → Type {
    match n {
        OfNat(_) => True,
        NegSucc(_) => x.Apart(0),
    }
}

fn Rat::pow_parts(x: Rat, n: Int) → (x.PowOk(n) → Rat) {
    match n {
        OfNat(m) => λ _ => x.npow(m),
        NegSucc(k) => λ h => x.inv(h := h).npow(Succ(k)),
    }
}

fn Rat::pow(self x: Rat, n: Int, h: x.PowOk(n) := infer) → Rat { Rat::pow_parts(x, n, h) }

designation ^ at Rat := Rat::pow

theorem Rat::apart_pow_parts(x: Rat, n: Int, h: x.Apart(0)): (hn: x.PowOk(n)) → Rat::pow_parts(x, n, hn).Apart(0) {
    match n {
        OfNat(m) => λ _ => x.npow_apart(m, h),
        NegSucc(k) => λ hn => x.inv(h := hn).npow_apart(Succ(k), Rat::apart_inv()),
    }
}

evidence theorem Rat::apart_pow({x: Rat}, {n: Int}, {hn: x.PowOk(n)}, h: x.Apart(0) := infer):
    x.pow(n, h := hn).Apart(0)
{
    Rat::apart_pow_parts(x, n, h, hn)
}

theorem Rat::pow_ofNat(self x: Rat, n: Nat): x ^ OfNat(n) = x.npow(n) { refl }

theorem Rat::pow_negSucc(self x: Rat, k: Nat, h: x.Apart(0) := infer): x ^ NegSucc(k) = x⁻¹.npow(Succ(k)) { refl }

theorem Rat::pow_zero(self x: Rat): x ^ 0 ≈ 1 { refl }

theorem Rat::pow_one(self x: Rat): x ^ 1 ≈ x { Rat::same_trans(Rat::mul_comm(1, x), x.mul_one()) }

theorem Rat::pow_two(self x: Rat): x ^ 2 ≈ x * x { Rat::mul_respects(x.pow_one(), x.same_refl()) }

// The inverse is the power at -1.
theorem Rat::pow_neg_one(self x: Rat, h: x.Apart(0) := infer): x ^ (-1) ≈ x⁻¹ { x⁻¹.pow_one() }

// A negative power is the inverse of the positive one.
theorem Rat::pow_negSucc_inv(self x: Rat, k: Nat, h: x.Apart(0) := infer): x ^ NegSucc(k) ≈ (x ^ OfNat(Succ(k)))⁻¹ {
    let n = Succ(k);
    let unit = calc {
        x.npow(n) * x⁻¹.npow(n) ≈ (x * x⁻¹).npow(n) := Rat::same_sym(x.mul_npow(x⁻¹, n)),
        ≈ Rat::npow(1, n) := Rat::npow_respects(x.mul_inv(), n),
        ≈ 1 := Rat::one_npow(n),
    };
    Rat::inv_unique(unit)
}

// ---------------------------------------------------------------------------
// The commutative ring modulo `≈` (lib/std/algebra/semiring.hthr): the identity-free
// carrier of the semiring layers. The semigroups and commutativity above fill
// their parents; what is new is the units, the additive inverse, the second
// distributive law and zero's annihilation.

theorem Rat::one_mul(self x: Rat): 1 * x ≈ x { Rat::same_trans(Rat::mul_comm(1, x), x.mul_one()) }

theorem Rat::neg_add_self(self x: Rat): -x + x ≈ 0 { Rat::same_trans(Rat::add_comm(-x, x), x.add_neg()) }

theorem Rat::mul_zero(self x: Rat): x * 0 ≈ 0 { ring }

theorem Rat::add_mul_distr(self x, y, z: Rat): (x + y) * z ≈ x * z + y * z {
    ring((x + y).den_mul(z), x.den_add(y), (x * z).den_add(y * z), x.den_mul(z), y.den_mul(z))
}

instance CommMonoidRel<Rat>(Rat::Same, Rat::add) {
    unit := 0,
    unit_l := Rat::zero_add,
    unit_r := Rat::add_zero,
}

instance GroupRel<Rat>(Rat::Same, Rat::add) {
    inv := Rat::neg,
    inv_l := Rat::neg_add_self,
    inv_r := Rat::add_neg,
    inv_respects := λ x y h => Rat::neg_respects(h),
}

instance MonoidRel<Rat>(Rat::Same, Rat::mul) {
    unit := 1,
    unit_l := Rat::one_mul,
    unit_r := Rat::mul_one,
}

instance Distributes<Rat>(Rat::Same, Rat::add, Rat::mul) {
    distrib_l := Rat::mul_add_distr,
    distrib_r := Rat::add_mul_distr,
}

instance CommRing<Rat>(Rat::Same, Rat::add, Rat::mul) {
    zero_mul := Rat::zero_mul,
    mul_zero := Rat::mul_zero,
}

// The integers in `Rat` are its numerals, so `ring` normalizes a `≈` goal
// at `Rat` itself (std/ring's `RingExpr::sound_rel`) and its coefficients
// read back as `Rat` numerals.
instance CommRingOfInt<Rat>(Rat::Same, Rat::add, Rat::mul) {
    of_int := Rat::ofInt,
    of_int_zero := refl,
    of_int_one := refl,
    of_int_add := Rat::ofInt_add,
    of_int_mul := Rat::ofInt_mul,
}

// ---------------------------------------------------------------------------
// The ordered-field interface (std/ordered_field). Every layer is filled
// from the laws above, its algebra from the ring just registered; `≤` is the
// cross-multiplied one, which means `¬(y < x)`, and the reciprocal is `x⁻¹`
// at the same apartness proof.

theorem Rat::zero_lt_one(): Rat::Lt(0, 1) { omega }

instance StrictOrder<Rat>(Rat::Same, Rat::Lt, Rat::Le) {
    lt_irrefl := Rat::lt_irrefl,
    lt_trans := λ x y z h1 h2 => Rat::lt_trans(h1, h2),
    lt_respects := λ x x2 y y2 hx hy h => Rat::lt_respects(hx, hy, h),
    lt_tight := λ x y h1 h2 => Rat::same_of_not_lt(h1, h2),
    le_of_not_lt := λ x y h => Rat::le_of_not_lt(h),
    not_lt_of_le := λ x y h => Rat::not_lt_of_le(h),
}

instance Cotransitive<Rat>(Rat::Lt) {
    rel_cotrans := Rat::lt_cotrans,
}

instance PseudoOrder<Rat>(Rat::Same, Rat::Lt, Rat::Le) {}

instance OrderedAddGroup<Rat>(Rat::Same, Rat::Lt, Rat::Le, Rat::add) {
    add_lt_mono_r := Rat::add_lt_mono_r,
}

instance LocatedAddGroup<Rat>(Rat::Same, Rat::Lt, Rat::Le, Rat::add) {}

instance OrderedField<Rat>(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul) {
    of_nat := λ n => Rat::ofInt(OfNat(n)),
    recip := λ x h => x.inv(h := h),
    mul_recip := λ x h => x.mul_inv(h := h),
    zero_lt_one := Rat::zero_lt_one(),
    mul_pos := λ x y hx hy => Rat::mul_pos(hx, hy),
    pos_of_mul_pos := λ x y hx h => Rat::pos_of_mul_pos(hx, h),
    of_nat_zero := Rat::same_refl(0),
    of_nat_succ := λ n => omega,
    archimedean := Rat::archimedean,
}

// Its integers named too (std/ordered_field's `OrderedFieldOfInt`), which is
// what `linarith`'s certificates are checked against.
instance OrderedFieldOfInt<Rat>(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul) {}

// A square is nonnegative (`OrderedField::sq_nonneg`), named at the carrier
// so a hint can cite it: `nlinarith(Rat::sq_nonneg(a - b))`.
theorem Rat::sq_nonneg(self x: Rat): 0 <= x * x { OrderedField::sq_nonneg(x) }

// Subtraction is monotone in its left argument and antitone in its right,
// and both directions cancel.
theorem Rat::sub_le_sub_r(self x, a, b: Rat, h: a <= b): a - x <= b - x { a.add_le_mono_r(b, -x, h) }

theorem Rat::sub_lt_sub_r(self x, a, b: Rat, h: a < b): a - x < b - x { a.add_lt_mono_r(b, -x, h) }

theorem Rat::sub_le_sub_l(self x, a, b: Rat, h: a <= b): x - b <= x - a { (-b).add_le_mono_l(-a, x, Rat::neg_le(x := a, y := b, h := h)) }

theorem Rat::sub_lt_sub_l(self x, a, b: Rat, h: a < b): x - b < x - a { (-b).add_lt_mono_l(-a, x, Rat::neg_lt(x := a, y := b, h := h)) }

theorem Rat::sub_le_sub({a, b, c, d: Rat}, h1: a <= b, h2: c <= d): a - d <= b - c {
    Rat::le_trans(d.sub_le_sub_r(a, b, h1), b.sub_le_sub_l(c, d, h2))
}

theorem Rat::le_of_sub_le_sub_r(self x, a, b: Rat, h: a - x <= b - x): a <= b {
    match a.le_dec(b) as λ _ => a <= b {
        Inl(le) => le,
        Inr(no) => false_elim(Rat::not_le_of_lt(x := b - x, y := a - x, h := x.sub_lt_sub_r(b, a, Rat::lt_of_not_le(x := b, y := a, h := no)))(h)),
    }
}

theorem Rat::le_of_sub_le_sub_l(self x, a, b: Rat, h: x - b <= x - a): a <= b {
    match a.le_dec(b) as λ _ => a <= b {
        Inl(le) => le,
        Inr(no) => false_elim(Rat::not_le_of_lt(x := x - a, y := x - b, h := x.sub_lt_sub_l(b, a, Rat::lt_of_not_le(x := b, y := a, h := no)))(h)),
    }
}

theorem Rat::abs_of_nonneg(self a: Rat, h: 0 <= a): a.abs() ≈ a {
    match a.abs_cases() as λ _ => a.abs() ≈ a {
        Inl(c) => c.right,
        Inr(c) => false_elim(Rat::not_le_of_lt(x := a, y := 0, h := c.left)(h)),
    }
}

theorem Rat::abs_of_nonpos(self a: Rat, h: a <= 0): a.abs() ≈ -a {
    let nz: Rat::Same(Rat::neg(0), 0) = omega;
    let neg: (0 <= -a) = Rat::le_respects(nz, (-a).same_refl(), Rat::neg_le(x := a, y := 0, h := h));
    Rat::same_trans(Rat::same_sym(a.abs_neg()), (-a).abs_of_nonneg(neg))
}

// On one side of `x`, a point nearer `x` is no farther from it.
theorem Rat::dist_le_of_below(self x, a, b: Rat, ab: a <= b, bx: b <= x): (b - x).abs() <= (a - x).abs() {
    let ax: (a <= x) = Rat::le_trans(ab, bx);
    let db = Rat::same_trans(b.abs_sub_comm(x), (x - b).abs_of_nonneg(Rat::sub_nonneg(x := x, y := b, h := bx)));
    let da = Rat::same_trans(a.abs_sub_comm(x), (x - a).abs_of_nonneg(Rat::sub_nonneg(x := x, y := a, h := ax)));
    Rat::le_respects(Rat::same_sym(db), Rat::same_sym(da), x.sub_le_sub_l(a, b, ab))
}

theorem Rat::dist_le_of_above(self x, a, b: Rat, xb: x <= b, ba: b <= a): (b - x).abs() <= (a - x).abs() {
    let xa: (x <= a) = Rat::le_trans(xb, ba);
    let db = (b - x).abs_of_nonneg(Rat::sub_nonneg(x := b, y := x, h := xb));
    let da = (a - x).abs_of_nonneg(Rat::sub_nonneg(x := a, y := x, h := xa));
    Rat::le_respects(Rat::same_sym(db), Rat::same_sym(da), x.sub_le_sub_r(b, a, ba))
}

// And at no greater distance it is the same point.
theorem Rat::same_of_dist_below(self x, a, b: Rat, ab: a <= b, bx: b <= x, d: (a - x).abs() <= (b - x).abs()): a ≈ b {
    let ax: (a <= x) = Rat::le_trans(ab, bx);
    let db = Rat::same_trans(b.abs_sub_comm(x), (x - b).abs_of_nonneg(Rat::sub_nonneg(x := x, y := b, h := bx)));
    let da = Rat::same_trans(a.abs_sub_comm(x), (x - a).abs_of_nonneg(Rat::sub_nonneg(x := x, y := a, h := ax)));
    Rat::le_antisymm(ab, x.le_of_sub_le_sub_l(b, a, Rat::le_respects(da, db, d)))
}

theorem Rat::same_of_dist_above(self x, a, b: Rat, xb: x <= b, ba: b <= a, d: (a - x).abs() <= (b - x).abs()): a ≈ b {
    let xa: (x <= a) = Rat::le_trans(xb, ba);
    let db = (b - x).abs_of_nonneg(Rat::sub_nonneg(x := b, y := x, h := xb));
    let da = (a - x).abs_of_nonneg(Rat::sub_nonneg(x := a, y := x, h := xa));
    Rat::le_antisymm(x.le_of_sub_le_sub_r(a, b, Rat::le_respects(da, db, d)), ba)
}

theorem Rat::lt_of_add_lt_add_r(self x, y, z: Rat, h: x + z < y + z): x < y {
    match y.le_dec(x) as λ _ => x < y {
        Inl(le) => false_elim(Rat::not_le_of_lt(x := x + z, y := y + z, h := h)(y.add_le_mono_r(x, z, le))),
        Inr(no) => Rat::lt_of_not_le(x := x, y := y, h := no),
    }
}

// Comparing the distances from `x` to `a` and to `b` is comparing `x` with
// their midpoint `m`.
theorem Rat::sub_shift(self x, a, b: Rat): (x - a) + (a + x) ≈ x + x ∧ (b - x) + (a + x) ≈ a + b {
    And(ring, ring)
}

theorem Rat::sub_le_sub_of_le_mid({x, m, a, b: Rat}, h: x <= m, e: m + m ≈ a + b): x - a <= b - x {
    let s = x.sub_shift(a, b);
    let xx = Rat::le_respects((x + x).same_refl(), e, Rat::add_le_mono(h1 := h, h2 := h));
    (x - a).add_le_cancel_r(b - x, a + x, Rat::le_respects(Rat::same_sym(s.left), Rat::same_sym(s.right), xx))
}

theorem Rat::sub_le_sub_of_mid_le({x, m, a, b: Rat}, h: m <= x, e: m + m ≈ a + b): b - x <= x - a {
    let s = x.sub_shift(a, b);
    let xx = Rat::le_respects(e, (x + x).same_refl(), Rat::add_le_mono(h1 := h, h2 := h));
    (b - x).add_le_cancel_r(x - a, a + x, Rat::le_respects(Rat::same_sym(s.right), Rat::same_sym(s.left), xx))
}

theorem Rat::sub_lt_sub_of_lt_mid({x, m, a, b: Rat}, h: x < m, e: m + m ≈ a + b): x - a < b - x {
    let s = x.sub_shift(a, b);
    let xx = Rat::lt_respects((x + x).same_refl(), e, Rat::add_lt_mono(h1 := h, h2 := Rat::le_of_lt(h)));
    (x - a).lt_of_add_lt_add_r(b - x, a + x, Rat::lt_respects(Rat::same_sym(s.left), Rat::same_sym(s.right), xx))
}

theorem Rat::sub_lt_sub_of_mid_lt({x, m, a, b: Rat}, h: m < x, e: m + m ≈ a + b): b - x < x - a {
    let s = x.sub_shift(a, b);
    let xx = Rat::lt_respects(e, (x + x).same_refl(), Rat::add_lt_mono(h1 := h, h2 := Rat::le_of_lt(h)));
    (b - x).lt_of_add_lt_add_r(x - a, a + x, Rat::lt_respects(Rat::same_sym(s.right), Rat::same_sym(s.left), xx))
}

// The converses: a distance comparison places `x` against the midpoint.
theorem Rat::mid_le_of_sub_le({x, a, b: Rat}, h: x - a <= b - x): x + x <= a + b {
    let s = x.sub_shift(a, b);
    Rat::le_respects(s.left, s.right, (x - a).add_le_mono_r(b - x, a + x, h))
}

theorem Rat::le_mid_of_sub_le({x, a, b: Rat}, h: b - x <= x - a): a + b <= x + x {
    let s = x.sub_shift(a, b);
    Rat::le_respects(s.right, s.left, (b - x).add_le_mono_r(x - a, a + x, h))
}

// Halving an order between doubles.
theorem Rat::le_of_double_le({x, y: Rat}, h: x + x <= y + y): x <= y {
    Rat::le_of_not_lt(x := x, y := y, h := λ lt => Rat::not_le_of_lt(x := y + y, y := x + x, h := Rat::add_lt_mono(h1 := lt, h2 := Rat::le_of_lt(lt)))(h))
}

// For `g < f`: `x` at least as close to `f` as to `g` is at or above their
// midpoint, and `y` at least as close to `g` is at or below it.
theorem Rat::mid_le_of_dist({g, f, x: Rat}, lt: g < f, d: (f - x).abs() <= (g - x).abs()): g + f <= x + x {
    match f.le_total(x) as λ _ => g + f <= x + x {
        Inl(fx) => Rat::add_le_mono(h1 := Rat::le_of_lt(Rat::lt_of_lt_of_le(lt, fx)), h2 := fx),
        Inr(xf) => {
            let df = (f - x).abs_of_nonneg(Rat::sub_nonneg(x := f, y := x, h := xf));
            match g.le_total(x) as λ _ => g + f <= x + x {
                Inl(gx) => {
                    let dg = Rat::same_trans(g.abs_sub_comm(x), (x - g).abs_of_nonneg(Rat::sub_nonneg(x := x, y := g, h := gx)));
                    Rat::le_mid_of_sub_le(x := x, a := g, b := f, h := Rat::le_respects(df, dg, d))
                },
                Inr(xg) => {
                    let dg = (g - x).abs_of_nonneg(Rat::sub_nonneg(x := g, y := x, h := xg));
                    false_elim(Rat::not_le_of_lt(x := g, y := f, h := lt)(x.le_of_sub_le_sub_r(f, g, Rat::le_respects(df, dg, d))))
                },
            }
        },
    }
}

theorem Rat::le_mid_of_dist({g, f, y: Rat}, lt: g < f, d: (g - y).abs() <= (f - y).abs()): y + y <= g + f {
    match y.le_total(g) as λ _ => y + y <= g + f {
        Inl(yg) => Rat::add_le_mono(h1 := yg, h2 := Rat::le_of_lt(Rat::lt_of_le_of_lt(yg, lt))),
        Inr(gy) => {
            let dg = Rat::same_trans(g.abs_sub_comm(y), (y - g).abs_of_nonneg(Rat::sub_nonneg(x := y, y := g, h := gy)));
            match y.le_total(f) as λ _ => y + y <= g + f {
                Inl(yf) => {
                    let df = (f - y).abs_of_nonneg(Rat::sub_nonneg(x := f, y := y, h := yf));
                    Rat::mid_le_of_sub_le(x := y, a := g, b := f, h := Rat::le_respects(dg, df, d))
                },
                Inr(fy) => {
                    let df = Rat::same_trans(f.abs_sub_comm(y), (y - f).abs_of_nonneg(Rat::sub_nonneg(x := y, y := f, h := fy)));
                    false_elim(Rat::not_le_of_lt(x := g, y := f, h := lt)(y.le_of_sub_le_sub_l(f, g, Rat::le_respects(dg, df, d))))
                },
            }
        },
    }
}

// Dividing a bound through by a positive natural: `c·g <= y` puts `g` at most
// `y / c`.
theorem Rat::le_div_of_mul_le(c: Pos<Nat>, {g, y: Rat}, h: Rat::ofInt(c.int()) * g <= y): g <= Rat(1, c) * y {
    let dm = Rat(1, c).den_mul(Rat::ofInt(c.int()));
    let dc: (Rat(1, c).den.int() = c.int()) = refl;
    let d1: ((Rat::ofInt(c.int())).den.int() = 1) = refl;
    let one: (Rat(1, c) * Rat::ofInt(c.int()) ≈ 1) = omega;
    calc {
        g ≈ 1 * g := Rat::same_sym(g.one_mul()),
        ≈ (Rat(1, c) * Rat::ofInt(c.int())) * g := Rat::mul_respects(Rat::same_sym(one), g.same_refl()),
        ≈ Rat(1, c) * (Rat::ofInt(c.int()) * g) := Rat(1, c).mul_assoc(Rat::ofInt(c.int()), g),
        <= Rat(1, c) * y := Rat::mul_le_mono_l(h, omega),
    }
}

// The relative form of an error bound (Higham's standard model): if `y` is
// within `u·|x|` of a nonzero `x`, then `y = x·(1 + e)` with `|e| <= u`,
// taking `e = (y - x) / x`.
theorem Rat::rel_of_abs_le({x, y, u: Rat}, nz: ¬(x ≈ 0), h: (y - x).abs() <= u * x.abs()): ∃ e: Rat, e.abs() <= u ∧ y ≈ x * (1 + e) {
    let r = x.recip();
    let xr = x.mul_recip(nz);
    let size = calc {
        ((y - x) * r).abs() ≈ (y - x).abs() * r.abs() := (y - x).abs_mul(r),
        <= (u * x.abs()) * r.abs() := Rat::mul_le_mono_r(h, r.abs_nonneg()),
        ≈ u * (x.abs() * r.abs()) := u.mul_assoc(x.abs(), r.abs()),
        ≈ u * (x * r).abs() := Rat::mul_respects(u.same_refl(), Rat::same_sym(x.abs_mul(r))),
        ≈ u * Rat::abs(1) := Rat::mul_respects(u.same_refl(), Rat::abs_respects(xr)),
        ≈ u := u.mul_one(),
    };
    let back = calc {
        y ≈ x + (y - x) := Rat::same_sym(Rat::same_trans(x.add_comm(y - x), y.sub_add_cancel(x))),
        ≈ x * 1 + (y - x) * 1 := Rat::add_respects(Rat::same_sym(x.mul_one()), Rat::same_sym((y - x).mul_one())),
        ≈ x * 1 + (y - x) * (x * r) := Rat::add_respects((x * 1).same_refl(), Rat::mul_respects((y - x).same_refl(), Rat::same_sym(xr))),
        ≈ x * 1 + x * ((y - x) * r) := Rat::add_respects((x * 1).same_refl(), Rat::same_trans(Rat::same_sym((y - x).mul_assoc(x, r)),
            Rat::same_trans(Rat::mul_respects((y - x).mul_comm(x), r.same_refl()), x.mul_assoc(y - x, r)))),
        ≈ x * (1 + (y - x) * r) := Rat::same_sym(x.mul_add_distr(1, (y - x) * r)),
    };
    Exists((y - x) * r, And(size, back))
}

// Rearrangements the reals read termwise (std/creal's negation and the
// distance from a real to its terms).
theorem Rat::neg_gap({a, b, g: Rat}, h: a + g <= b): -b + g <= -a { linarith(h) }

theorem Rat::le_add_shift({a, q, e, r, f: Rat}, d: a <= q + (e + r), s: e <= f): a <= (q + r) + f { linarith(d, s) }

theorem Rat::sub_le_shift({a, q, e, r, f: Rat}, d: q <= a + (r + e), s: e <= f): q - r <= a + f { linarith(d, s) }

// ---------------------------------------------------------------------------
// Finite sums (std/big_operator).

// The triangle inequality, `|∑ f| <= ∑ |f|`.
theorem Rat::sum_abs_le(n: Nat, f: Nat → Rat): (∑ k < n, f(k)).abs() <= ∑ k < n, f(k).abs() {
    let h = LocatedAddGroup::range_abs_le(n, f, λ k => f(k).abs(), λ k hk => And(f(k).neg_abs_le(), f(k).le_abs()));
    Rat::abs_le(h.left, h.right)
}

// A sum's order and sign, termwise: the class laws at `Rat`, stated here
// for `mono` (lib/std/tactic/mono.hthr), whose `apply` reads a class
// lemma's dictionary off the scope, which a concrete carrier has none of.
theorem Rat::range_le(n: Nat, f, g: Nat → Rat, h: (k: Nat) → k < n → f(k) <= g(k)): MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g) {
    LocatedAddGroup::range_le(n, f, g, h)
}

theorem Rat::range_nonneg(n: Nat, f: Nat → Rat, h: (k: Nat) → k < n → 0 <= f(k)): 0 <= MonoidRel::range(+, n, f) {
    LocatedAddGroup::range_nonneg(n, f, h)
}

// `2^-j`, written `1/(ones(j) + 1)`, is the `j`-th power of a half.
theorem Rat::half_pow(j: Nat): ∏ i < j, Rat::inv_succ(1) ≈ Rat::inv_succ(j.ones()) {
    match j {
        Zero => Rat::same_refl(1),
        Succ(i) => calc {
            (∏ k < i, Rat::inv_succ(1)) * Rat::inv_succ(1)
                ≈ Rat::inv_succ(i.ones()) * Rat::inv_succ(1) := Rat::mul_respects(Rat::half_pow(i), Rat::inv_succ(1).same_refl()),
                ≈ Rat::inv_succ(Succ(i).ones()) := Rat::inv_succ_mul(i.ones(), 1),
        },
    }
}

// Products distribute over differences.
theorem Rat::sub_mul(self a, b, c: Rat): (a - b) * c ≈ a * c - b * c { ring }

theorem Rat::mul_sub(self a, b, c: Rat): a * (b - c) ≈ a * b - a * c { ring }

// ---------------------------------------------------------------------------
// Square roots from below (lib/std/num/float/float_real.hthr reads floats'
// roots through them). `root_floor(q, n)` is the integer root of
// `⌊|q|·4^n⌋` over `2^n`: at most `√|q|` and within `2^-n` of it, which is
// all `CReal::sqrt_rat` needs. Comparisons with a root are read through
// squares (`lt_of_sq_lt`, `le_of_sq_le`), and strictly inside a gap
// between two squares there is a rational on each side of the root
// (`root_above`, `root_below`).

theorem Rat::lt_of_sq_lt({a, c: Rat}, hc: 0 <= c, h: a * a < c * c): a < c { nlinarith(hc, h) }

theorem Rat::le_of_sq_le({a, c: Rat}, ha: 0 <= a, hc: 0 <= c, h: a * a <= c * c): a <= c { nlinarith(ha, hc, h) }

fn Rat::root_floor(self q: Rat, n: Nat) → Rat {
    Rat(OfNat(((q.num.natAbs() * (Nat::pow(2, n) * Nat::pow(2, n))).ldiv(q.den).quot()).isqrt()), Nat::pow(2, n))
}

// It is a root of `|q|` from below within `2^-n`.
theorem Rat::root_floor_spec(self q: Rat, n: Nat): q.root_floor(n) * q.root_floor(n) <= q.abs() ∧ q.abs() < (q.root_floor(n) + Rat::inv_pow2(n)) * (q.root_floor(n) + Rat::inv_pow2(n)) {
    let A = q.num.natAbs();
    let D = q.den;
    let P = Nat::pow(2, n);
    let N = (A * (P * P)).ldiv(D).quot();
    let m = (A * (P * P)).ldiv(D).rem();
    let k = N.isqrt();
    let parts: (N * D + m = A * (P * P)) = (A * (P * P)).ldiv_parts(D);
    let small: (m < D) = (A * (P * P)).ldiv_rem_lt(D);
    let root = N.isqrt_spec();
    let lo: ((k * k) * D <= N * D) = Nat::mul_le_mono_r(D, k * k, N, root.left);
    let hi: (Succ(N) * D <= (Succ(k) * Succ(k)) * D) = Nat::mul_le_mono_r(D, Succ(N), Succ(k) * Succ(k), root.right);
    let r = q.root_floor(n);
    let s = Rat(OfNat(Succ(k)), P);
    let c = Rat::inv_pow2(n);
    let rn: ((r + c).num = k.int() * P.int() + 1 * P.int()) = refl;
    let rd: ((r + c).den.int() = P.int() * P.int()) = refl;
    let sn: (s.num = k.int() + 1) = refl;
    let sd: (s.den.int() = P.int()) = refl;
    let e: ((r + c).num * s.den.int() = s.num * (r + c).den.int()) = ring(rn, rd, sn, sd);
    let up: (r + c ≈ s) = omega(e);
    let a0: ((k * k) * D <= A * (P * P)) = omega(lo, parts);
    let sN: (Succ(N) * D = N * D + D) = ring;
    let b0: (A * (P * P) < (Succ(k) * Succ(k)) * D) = omega(hi, parts, small, sN);
    let a: (r * r <= q.abs()) = a0;
    let b: (q.abs() < s * s) = b0;
    And(a, Rat::lt_respects(q.abs().same_refl(), Rat::mul_respects(Rat::same_sym(up), Rat::same_sym(up)), b))
}

theorem Rat::root_floor_nonneg(self q: Rat, n: Nat): 0 <= q.root_floor(n) { omega }

// Each root from below sits under every other plus that one's precision.
theorem Rat::root_floor_below(self q: Rat, m, n: Nat): q.root_floor(m) < q.root_floor(n) + Rat::inv_pow2(n) {
    let b = q.root_floor(n) + Rat::inv_pow2(n);
    let b_nn: (0 <= b) = linarith(q.root_floor_nonneg(n), Rat::inv_pow2_pos(n));
    Rat::lt_of_sq_lt(b_nn, Rat::lt_of_le_of_lt((q.root_floor_spec(m)).left, (q.root_floor_spec(n)).right))
}

// So the roots at n+1 bits are a regular sequence.
theorem Rat::root_floor_regular(self q: Rat, m, n: Nat): (q.root_floor(m + 1) - q.root_floor(n + 1)).abs() <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1) {
    let x = q.root_floor_below(m + 1, n + 1);
    let y = q.root_floor_below(n + 1, m + 1);
    Rat::abs_le(linarith(y, Rat::inv_pow2_pos(n + 1)), linarith(x, Rat::inv_pow2_pos(m + 1)))
}

// Above a square below `x` there is a rational whose square is still at most
// `x`: `g + d/(2g + 1 + d)` with `d = x - g²`, whose square exceeds `g²` by
// `δ·(2g + δ) <= δ·(2g + 1 + d) = d`.
theorem Rat::root_above({g, x: Rat}, nn: 0 <= g, lt: g * g < x): ∃ lo: Rat, g < lo ∧ lo * lo <= x {
    let t = (g + g + 1) + (x - g * g);
    let tpos: (0 < t) = linarith(nn, lt);
    let i = t.recip();
    let ti: (t * i ≈ 1) = t.mul_recip(λ z => Rat::lt_irrefl(0, Rat::lt_respects(Rat::same_refl(0), z, tpos)));
    let e = (x - g * g) * i;
    let et: (e * t ≈ x - g * g) = ring(ti);
    let e_nn: (0 <= e) = Rat::mul_nonneg(linarith(lt), Rat::recip_nonneg(Rat::le_of_lt(tpos)));
    let e_le: (e <= 1) = nlinarith(et, tpos);
    let e_pos: (0 < e) = nlinarith(et, lt, e_nn, tpos);
    Exists(g + e, And(linarith(e_pos), nlinarith(et, e_nn, e_le)))
}

// Below a square above `x` there is one whose square is still at least `x`:
// Newton's step `(g² + x)/(2g)`, whose square exceeds `x` by `(hi - g)²`.
theorem Rat::root_below({g, x: Rat}, nn: 0 <= x, pos: 0 < g, lt: x < g * g): ∃ hi: Rat, hi < g ∧ 0 <= hi ∧ x <= hi * hi {
    let t = g + g;
    let tpos: (0 < t) = linarith(pos);
    let i = t.recip();
    let ti: (t * i ≈ 1) = t.mul_recip(λ z => Rat::lt_irrefl(0, Rat::lt_respects(Rat::same_refl(0), z, tpos)));
    let hi = (g * g + x) * i;
    let ht: (hi * t ≈ g * g + x) = ring(ti);
    let sq: (0 <= (hi - g) * (hi - g)) = Rat::sq_nonneg(hi - g);
    let hi_nn: (0 <= hi) = Rat::mul_nonneg(nlinarith(nn, pos), Rat::recip_nonneg(Rat::le_of_lt(tpos)));
    Exists(hi, And(nlinarith(ht, lt, pos, hi_nn), And(hi_nn, nlinarith(ht, sq))))
}

// `|R - q| <= u·|q| + e` at a nonnegative `q`, as two affine bounds in `q`
// (lib/std/num/float/float_real.hthr reads them at a real through the
// interval around it).
theorem Rat::sides_of_abs({R, q, u, e: Rat}, nn: 0 <= q, h: (R - q).abs() <= u * q.abs() + e): R <= (1 + u) * q + e ∧ (1 - u) * q + -e <= R {
    let uq: (u * q.abs() ≈ u * q) = Rat::mul_respects(u.same_refl(), q.abs_of_nonneg(nn));
    And(linarith((R - q).le_abs(), h, uq), linarith((R - q).neg_le_abs(), h, uq))
}

// `|R - q| <= u·|q| + e` at a nonpositive `q`, as two affine bounds in `q`.
theorem Rat::sides_of_abs_nonpos({R, q, u, e: Rat}, np: q <= 0, h: (R - q).abs() <= u * q.abs() + e): R <= (1 - u) * q + e ∧ (1 + u) * q + -e <= R {
    let uq: (u * q.abs() ≈ u * -q) = Rat::mul_respects(u.same_refl(), q.abs_of_nonpos(np));
    And(linarith((R - q).le_abs(), h, uq), linarith((R - q).neg_le_abs(), h, uq))
}

// Their slopes `1 ± u` are nonnegative while `0 <= u <= 1`.
theorem Rat::slopes_nonneg({u: Rat}, u_nn: 0 <= u, u_le: u <= 1): 0 <= 1 - u ∧ 0 <= 1 + u { And(linarith(u_le), linarith(u_nn)) }

// Ranges below zero, read as absolute values.
theorem Rat::neg_nonpos_of_pos({m: Rat}, h: 0 < m): -m <= 0 { linarith(h) }

theorem Rat::abs_le_of_between({q, M: Rat}, lo: -M <= q, np: q <= 0): q.abs() <= M { linarith(q.abs_of_nonpos(np), lo) }

theorem Rat::abs_between_neg({q, m, M: Rat}, pos: 0 < m, lo: -M <= q, hi: q <= -m): m <= q.abs() ∧ q.abs() <= M {
    let e = q.abs_of_nonpos(linarith(hi, pos));
    And(linarith(e, hi), linarith(e, lo))
}

// The roots from below approach `|q|` from each side
// (lib/std/num/creal.hthr's `is_sqrt_sq`), and they move by at most `d`
// when their argument moves by `d²` (the real root, `CReal::sqrt`).

// Some 2^-n times `c` is under any positive `d`.
theorem Rat::inv_pow2_mul_lt(d, c: Rat, hd: 0 < d, hc: 0 <= c): ∃ n: Nat, Rat::inv_pow2(n) * c < d {
    let c1 = c + 1;
    let r = c1.recip();
    let one: (c1 * r ≈ 1) = c1.mul_recip(λ z => Rat::lt_irrefl(0, Rat::lt_respects(Rat::same_refl(0), z, linarith(hc))));
    let rn: (0 <= r) = Rat::recip_nonneg(x := c1, h := linarith(hc));
    let rpos: (0 < r) = nlinarith(one, hc, rn);
    let eps = d * r;
    let epos: (0 < eps) = Rat::mul_pos(hd, rpos);
    match eps.archimedean_inv_pow2(epos) {
        Exists(n, small) => {
            let e = Rat::inv_pow2(n);
            let a: (e * c1 < eps * c1) = Rat::mul_lt_mono_r(small, linarith(hc));
            let b: (eps * c1 ≈ d) = ring(one);
            let g: (e * c < d) = linarith(a, b, Rat::inv_pow2_pos(n));
            Exists(n, g)
        },
    }
}

// The roots from below get as close to `|q|` as wanted, from each side.
theorem Rat::root_floor_up(self q: Rat, r: Rat, h: q.abs() < r): ∃ n: Nat, (q.root_floor(n) + Rat::inv_pow2(n)) * (q.root_floor(n) + Rat::inv_pow2(n)) < r {
    let x = q.abs();
    let xn: (0 <= x) = q.abs_nonneg();
    match Rat::inv_pow2_mul_lt(r - x, x + x + 3, linarith(h), linarith(xn)) {
        Exists(n, small0) => {
            let f = q.root_floor(n);
            let e = Rat::inv_pow2(n);
            let sp = q.root_floor_spec(n);
            let fn0: (0 <= f) = q.root_floor_nonneg(n);
            let fb: (f <= x + 1) = nlinarith(sp.left, fn0, xn);
            let e1: (e <= 1) = Rat::inv_pow2_le_one(n);
            let en: (0 <= e) = Rat::inv_pow2_nonneg(n);
            let fe: (f * e <= (x + 1) * e) = Rat::mul_le_mono_r(fb, en);
            let ee: (e * e <= e) = nlinarith(e1, en);
            let small: (e * (x + x + 3) < r - x) = small0;
            let g: ((f + e) * (f + e) < r) = linarith(sp.left, fe, ee, small);
            Exists(n, g)
        },
    }
}

theorem Rat::root_floor_down(self q: Rat, r: Rat, h: r < q.abs()): ∃ n: Nat, r < q.root_floor(n) * q.root_floor(n) {
    let x = q.abs();
    let xn: (0 <= x) = q.abs_nonneg();
    match Rat::inv_pow2_mul_lt(x - r, x + x + 3, linarith(h), linarith(xn)) {
        Exists(n, small0) => {
            let f = q.root_floor(n);
            let e = Rat::inv_pow2(n);
            let sp = q.root_floor_spec(n);
            let fn0: (0 <= f) = q.root_floor_nonneg(n);
            let fb: (f <= x + 1) = nlinarith(sp.left, fn0, xn);
            let e1: (e <= 1) = Rat::inv_pow2_le_one(n);
            let en: (0 <= e) = Rat::inv_pow2_nonneg(n);
            let fe: (f * e <= (x + 1) * e) = Rat::mul_le_mono_r(fb, en);
            let ee: (e * e <= e) = nlinarith(e1, en);
            let small: (e * (x + x + 3) < x - r) = small0;
            let g: (r < f * f) = linarith(sp.right, fe, ee, small);
            Exists(n, g)
        },
    }
}

theorem Rat::inv_pow2_double(n: Nat): Rat::inv_pow2(n + n) ≈ Rat::inv_pow2(n) * Rat::inv_pow2(n) {
    let e: (Nat::pow(2, n + n) = Nat::pow(2, n) * Nat::pow(2, n)) = Nat::pow_add(2, n, n);
    omega(e)
}

// `p² <= |b| + d²` puts `p` under `b`'s root from below plus its precision
// plus `d`.
theorem Rat::lt_root_floor_add({p, d: Rat}, b: Rat, n: Nat, dn: 0 <= d, h: p * p <= b.abs() + d * d): p < b.root_floor(n) + Rat::inv_pow2(n) + d {
    let f = b.root_floor(n);
    let e = Rat::inv_pow2(n);
    let up: (b.abs() < (f + e) * (f + e)) = (b.root_floor_spec(n)).right;
    let fe: (0 <= f + e) = linarith(b.root_floor_nonneg(n), Rat::inv_pow2_pos(n));
    let cross: (0 <= d * (f + e)) = Rat::mul_nonneg(dn, fe);
    let g: (p * p < (f + e + d) * (f + e + d)) = linarith(h, up, cross);
    Rat::lt_of_sq_lt(linarith(fe, dn), g)
}

// `f² <= p² + d²` with `p, d >= 0` puts `f <= p + d`.
theorem Rat::le_add_of_sq_le({f, p, d: Rat}, pn: 0 <= p, dn: 0 <= d, h: f * f <= p * p + d * d): f <= p + d {
    let pd: (0 <= p * d) = Rat::mul_nonneg(pn, dn);
    match Rat::le_total(0, f) {
        Inl(fn0) => {
            let sq: (f * f <= (p + d) * (p + d)) = linarith(h, pd);
            Rat::le_of_sq_le(fn0, linarith(pn, dn), sq)
        },
        Inr(fneg) => linarith(fneg, pn, dn),
    }
}

// ---------------------------------------------------------------------------
// Small helpers for series limits and lattices (issues/exp-log-grid-gap.md).

// Multiply both sides of a `≈` on the right.
theorem Rat::mul_same_r({a, b, c: Rat}, h: a ≈ b): a * c ≈ b * c { Rat::mul_respects(h, c.same_refl()) }

// `|a|·e` below 2^-m once `e` is below 2^-(m + w), 2^w past `a`'s ceiling.
theorem Rat::scaled_small(a, e: Rat, m: Nat, h0: 0 <= e, he: e <= Rat::inv_pow2(m + a.abs_ceil().width())): a.abs() * e <= Rat::inv_pow2(m) {
    let w = a.abs_ceil().width();
    let big = Rat::ofInt(Nat::pow(2, w).int());
    let below: (a.abs_ceil() < Nat::pow(2, w)) = a.abs_ceil().lt_pow_width();
    let ab: (a.abs() <= big) = Rat::le_trans(a.abs_le_abs_ceil(), omega(below));
    calc {
        a.abs() * e <= big * Rat::inv_pow2(m + w) := Rat::mul_le_mul(ab, he, a.abs_nonneg(), h0),
        ≈ Rat::inv_pow2(m) := Rat::scale_inv_pow2(w, m),
    }
}

// A rational multiple of nu by an integer is 0 or at least nu away from 0.
theorem Rat::far_of_int(N: Int, nu: Rat, hnu: 0 <= nu, {b: Rat}, hb: b ≈ Rat::ofInt(N) * nu): N = 0 ∨ (nu <= b ∨ b <= -nu) {
    match N.lt_trichotomy(0) {
        Inl(neg) => {
            let c: (Rat::ofInt(N) <= Rat::ofInt(-1)) = Rat::ofInt_le(N, -1, omega(neg));
            let m: (Rat::ofInt(N) * nu <= Rat::ofInt(-1) * nu) = Rat::mul_le_mono_r(c, hnu);
            let r: (b <= -nu) = linarith(m, hb);
            Inr(Inr(r))
        },
        Inr(r) => match r {
            Inl(z) => Inl(z),
            Inr(pos) => {
                let c: (Rat::ofInt(1) <= Rat::ofInt(N)) = Rat::ofInt_le(1, N, omega(pos));
                let m: (Rat::ofInt(1) * nu <= Rat::ofInt(N) * nu) = Rat::mul_le_mono_r(c, hnu);
                let s: (nu <= b) = linarith(m, hb);
                Inr(Inl(s))
            },
        },
    }
}

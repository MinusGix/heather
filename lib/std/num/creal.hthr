// Regular Cauchy reals: the first computational presentation of the real
// numbers (issues/regular-cauchy-reals.md; docs/regular-cauchy-reals-round.md,
// docs/creal-dyadic-round.md).
//
// A real is a sequence of dyadic rationals with its rate of convergence
// written in: the n-th term is meant to be within 2^-n of the number, so any
// two terms m and n lie within 2^-m + 2^-n of each other. That bound is the
// `regular` field, Bishop's regular sequences at the binary rate. The index
// counts bits: asking for twenty more bits asks for a term twenty further
// out. Nothing is ever a limit: a real is its approximations, and asking for
// the n-th one computes it.
//
// Terms are `Dyadic`, and every proof reads them as rationals, `x.at(n)` (the
// term through `Dyadic::rat`), so the estimates are the rationals' lemma
// library. An operation whose exact term would not be dyadic, or would grow
// with every use, floors it to n+1 bits (`rounded`, `Dyadic::floor_rat`): half
// the rate pays for the rounding, and a term's size stays its precision
// whatever the depth of the expression that made it.
//
// Equality is a setoid, `CReal::Same`, written `≈`: two reals are the same
// when their terms become arbitrarily close, with the index from which they
// are within 1/(k+1) given as data. Nothing needs to ask a proof for that
// index: for regular sequences 2k+1 always serves (Bishop's form, below,
// `close_of_same`), so a result that must compute, like the start of a
// moved gap (`lt_respects`), reads closeness there. `≈`, `<` and `≤` measure
// closeness in steps 1/(k+1) and never mention the rate. Two sequences that
// differ in finitely many places, or approach the same number at different
// speeds, are `≈` and not `=`; the regularity proofs are never compared.
//
// Every operation is defined on sequences and shown to respect `≈`, and every
// law is stated modulo `≈`, as at `Rat`. Arithmetic reads its arguments
// further out to keep within the rate: a sum's n-th term adds the summands'
// (n+1)-th terms, each within 2^-(n+1), and the halves add to 2^-n. A product
// reads further out by the bit width of its factors' canonical bound, and an
// inverse by that of its argument's gap from zero, each then rounded. The
// reals are complete: a regular sequence of reals converges to its diagonal,
// a limit given as data (docs/creal-completeness-round.md).
//
// Calling convention: as at `Rat`, a lemma whose every `CReal` is named by
// one of its hypotheses takes them implicitly; any other takes the first as
// `self`.

import logic;
import nat;
import int;
import omega;
import ring;
import relation_props;
import algebra;
import algebra_rel;
import order;
import semiring;
import ordered_field;
import big_operator;
import linarith;
import rat;
import morphism;
import dyadic;
export algebra::{Numeral};

record CReal {
    seq: Nat → Dyadic,
    regular: (m, n: Nat) → (seq(m).rat() - seq(n).rat()).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n),
}

// The n-th term as a rational: what every estimate reads.
fn CReal::at(self x: CReal, n: Nat) → Rat { x.seq(n).rat() }

// The binary rate is at least as fine as the unary one, n + 1 <= 2^n, so
// every estimate made at 1/(n+1) holds of the terms too.
theorem CReal::unary(self x: CReal, m, n: Nat): (x.at(m) - x.at(n)).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n) {
    Rat::le_trans(x.regular(m, n), Rat::add_le_mono(Rat::inv_pow2_le_inv_succ(m), Rat::inv_pow2_le_inv_succ(n)))
}

fn CReal::Same(x, y: CReal) → Type {
    (k: Nat) → ∃ start: Nat, (n: Nat) → start <= n → (x.at(n) - y.at(n)).abs() <= Rat::inv_succ(k)
}

designation ≈ at CReal := CReal::Same

// Two terms of one real, both from index 2k+1 on, are within 1/(k+1): each
// is within 1/(2k+2) of the other's rate, and the halves add up.
theorem CReal::regular_close(self x: CReal, k, m, n: Nat, hm: k + k + 1 <= m, hn: k + k + 1 <= n):
    (x.at(m) - x.at(n)).abs() <= Rat::inv_succ(k)
{
    let half = Rat::inv_succ(k + k + 1);
    calc {
        (x.at(m) - x.at(n)).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n) := x.unary(m, n),
        <= half + half := Rat::add_le_mono(Rat::inv_succ_antitone(k + k + 1, m, hm), Rat::inv_succ_antitone(k + k + 1, n, hn)),
        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
    }
}

// The two ways most laws below are proved: termwise `≈` (closeness from
// index zero), or closeness within 1/(k+1) from index 2k+1 on.
theorem CReal::same_of_terms(self x, y: CReal, terms: (n: Nat) → x.at(n) ≈ y.at(n)): x ≈ y {
    λ k => Exists(0, λ n start => calc {
        (x.at(n) - y.at(n)).abs() ≈ (y.at(n) - y.at(n)).abs() := Rat::abs_respects(Rat::sub_respects(terms(n), y.at(n).same_refl())),
        ≈ 0 := y.at(n).abs_sub_self(),
        <= Rat::inv_succ(k) := Rat::le_of_lt(Rat::inv_succ_pos(k)),
    })
}

theorem CReal::same_of_close(self x, y: CReal,
    close: (k, n: Nat) → k + k + 1 <= n → (x.at(n) - y.at(n)).abs() <= Rat::inv_succ(k)): x ≈ y
{
    λ k => Exists(k + k + 1, close(k))
}

theorem CReal::same_refl(self x: CReal): x ≈ x { x.same_of_terms(x, λ n => x.at(n).same_refl()) }

theorem CReal::same_sym({x, y: CReal}, h: x ≈ y): y ≈ x {
    λ k => match h(k) {
        Exists(start, close) => Exists(start, λ n from => calc {
            (y.at(n) - x.at(n)).abs() ≈ (x.at(n) - y.at(n)).abs() := y.at(n).abs_sub_comm(x.at(n)),
            <= Rat::inv_succ(k) := close(n, from),
        }),
    }
}

// Within 1/(2k+2) of y from one index, y within 1/(2k+2) of z from another:
// from the later of the two, x is within 1/(k+1) of z.
theorem CReal::same_trans({x, y, z: CReal}, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    λ k => match hxy(k + k + 1) {
        Exists(i, first) => match hyz(k + k + 1) {
            Exists(j, second) => Exists(i.max(j), λ n from => {
                let half = Rat::inv_succ(k + k + 1);
                let a: ((x.at(n) - y.at(n)).abs() <= half) = first(n, i.le_trans(i.max(j), n, i.le_max_l(j), from));
                let b: ((y.at(n) - z.at(n)).abs() <= half) = second(n, j.le_trans(i.max(j), n, i.le_max_r(j), from));
                calc {
                    (x.at(n) - z.at(n)).abs() <= (x.at(n) - y.at(n)).abs() + (y.at(n) - z.at(n)).abs() := x.at(n).dist_triangle(y.at(n), z.at(n)),
                    <= half + half := Rat::add_le_mono(a, b),
                    ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                }
            }),
        },
    }
}

instance Equivalence<CReal>(CReal::Same) {
    rel_refl := CReal::same_refl,
    rel_sym := λ x y h => CReal::same_sym(h),
    rel_trans := λ x y z hxy hyz => CReal::same_trans(hxy, hyz),
}

// ---------------------------------------------------------------------------
// Bishop's equality. Bishop calls two regular sequences equal when their
// n-th terms are within twice the rate at every n, here 2^-n + 2^-n: a bound
// at each index, with no modulus. It is the same relation as `≈`. Pointwise
// closeness is within 1/(k+1) from index 2k+1 on. Conversely, compare the
// n-th terms through a far index m: regularity moves each side by
// 2^-n + 2^-m and `≈` crosses at m, so the excess over 2^-n + 2^-n is below
// every 1/(j+1), hence nothing (`Rat::le_of_le_add_inv_succ`).

fn CReal::BishopSame(x, y: CReal) → Type {
    (n: Nat) → (x.at(n) - y.at(n)).abs() <= Rat::inv_pow2(n) + Rat::inv_pow2(n)
}

theorem CReal::close_of_bishop({x, y: CReal}, h: x.BishopSame(y), k, n: Nat, from: k + k + 1 <= n):
    (x.at(n) - y.at(n)).abs() <= Rat::inv_succ(k)
{
    let fine = Rat::inv_pow2(n);
    let half = Rat::inv_succ(k + k + 1);
    let le_half: (fine <= half) = Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_antitone(k + k + 1, n, from));
    calc {
        (x.at(n) - y.at(n)).abs() <= fine + fine := h(n),
        <= half + half := Rat::add_le_mono(le_half, le_half),
        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
    }
}

theorem CReal::same_of_bishop({x, y: CReal}, h: x.BishopSame(y)): x ≈ y {
    x.same_of_close(y, λ k n from => CReal::close_of_bishop(h, k, n, from))
}

theorem CReal::bishop_of_same({x, y: CReal}, h: x ≈ y): x.BishopSame(y) {
    λ n => {
        let fine = Rat::inv_pow2(n);
        Rat::le_of_le_add_inv_succ(λ j => {
            let j2 = j + j + 1;
            let j4 = j2 + j2 + 1;
            let q = Rat::inv_succ(j4);
            let quarter = Rat::inv_succ(j2);
            match h(j4) {
                Exists(s, close) => {
                    let m = s.max(j4);
                    let at_s: (s <= m) = s.le_max_l(j4);
                    let em: (Rat::inv_pow2(m) <= q) = Rat::le_trans(Rat::inv_pow2_le_inv_succ(m), Rat::inv_succ_antitone(j4, m, s.le_max_r(j4)));
                    let dx: ((x.at(n) - x.at(m)).abs() <= fine + q) =
                        Rat::le_trans(x.regular(n, m), Rat::inv_pow2(m).add_le_mono_l(q, fine, em));
                    let dy: ((y.at(m) - y.at(n)).abs() <= q + fine) =
                        Rat::le_trans(y.regular(m, n), Rat::inv_pow2(m).add_le_mono_r(q, fine, em));
                    let near: ((x.at(n) - y.at(m)).abs() <= (fine + q) + q) = calc {
                        (x.at(n) - y.at(m)).abs() <= (x.at(n) - x.at(m)).abs() + (x.at(m) - y.at(m)).abs() := x.at(n).dist_triangle(x.at(m), y.at(m)),
                        <= (fine + q) + q := Rat::add_le_mono(dx, close(m, at_s)),
                    };
                    let spare: (q <= q + q) = q.le_add_nonneg(q, Rat::le_of_lt(Rat::inv_succ_pos(j4)));
                    calc {
                        (x.at(n) - y.at(n)).abs() <= (x.at(n) - y.at(m)).abs() + (y.at(m) - y.at(n)).abs() := x.at(n).dist_triangle(y.at(m), y.at(n)),
                        <= ((fine + q) + q) + (q + fine) := Rat::add_le_mono(near, dy),
                        ≈ (fine + fine) + ((q + q) + q) := ring,
                        <= (fine + fine) + ((q + q) + (q + q)) := ((q + q) + q).add_le_mono_l((q + q) + (q + q), fine + fine, q.add_le_mono_l(q + q, q + q, spare)),
                        ≈ (fine + fine) + Rat::inv_succ(j) := ring,
                    }
                },
            }
        })
    }
}

// `≈` read at one precision from the fixed index 2k+1, whatever modulus the
// proof carries: through Bishop's form, which has none.
theorem CReal::close_of_same({x, y: CReal}, h: x ≈ y, k, n: Nat, from: k + k + 1 <= n):
    (x.at(n) - y.at(n)).abs() <= Rat::inv_succ(k)
{
    CReal::close_of_bishop(CReal::bishop_of_same(h), k, n, from)
}

// ---------------------------------------------------------------------------
// Rounded sequences. A sequence of rationals whose terms are within
// 2^-(m+1) + 2^-(n+1) of each other is a real once each term is floored to
// n+1 bits: the two roundings cost the other halves of the rate. Every
// operation whose exact term is not a dyadic of bounded size is made this way.

theorem CReal::rounded_regular(f: Nat → Rat, reg: (m, n: Nat) → (f(m) - f(n)).abs() <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1), m, n: Nat):
    (Dyadic::floor_rat(f(m), m + 1).rat() - Dyadic::floor_rat(f(n), n + 1).rat()).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n)
{
    let u = Dyadic::floor_rat(f(m), m + 1).rat();
    let v = Dyadic::floor_rat(f(n), n + 1).rat();
    let hm = Rat::inv_pow2(m + 1);
    let hn = Rat::inv_pow2(n + 1);
    let dv: ((f(n) - v).abs() <= hn) = Rat::le_trans(Rat::le_of_same(f(n).abs_sub_comm(v)), Dyadic::floor_rat_close(f(n), n + 1));
    calc {
        (u - v).abs() <= (hm + (hm + hn)) + hn := Rat::dist_three(Dyadic::floor_rat_close(f(m), m + 1), reg(m, n), dv),
        ≈ ((hm + hm) + hn) + hn := Rat::add_respects(Rat::same_sym(hm.add_assoc(hm, hn)), hn.same_refl()),
        ≈ (hm + hm) + (hn + hn) := (hm + hm).add_assoc(hn, hn),
        ≈ Rat::inv_pow2(m) + Rat::inv_pow2(n) := Rat::add_respects(Rat::inv_pow2_half(m), Rat::inv_pow2_half(n)),
    }
}

fn CReal::rounded(f: Nat → Rat, reg: (m, n: Nat) → (f(m) - f(n)).abs() <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1)) → CReal {
    CReal(λ n => Dyadic::floor_rat(f(n), n + 1), λ m n => CReal::rounded_regular(f, reg, m, n))
}

theorem CReal::rounded_close(f: Nat → Rat, reg: (m, n: Nat) → (f(m) - f(n)).abs() <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1), n: Nat):
    (CReal::rounded(f, reg).at(n) - f(n)).abs() <= Rat::inv_pow2(n + 1)
{
    Dyadic::floor_rat_close(f(n), n + 1)
}

// Two roundings and a 1/(2k+2) fit in 1/(k+1) once n is past 2k+1.
theorem CReal::slack_le(n, k: Nat, far: k + k + 1 <= n):
    (Rat::inv_pow2(n + 1) + Rat::inv_succ(k + k + 1)) + Rat::inv_pow2(n + 1) <= Rat::inv_succ(k)
{
    let h = Rat::inv_pow2(n + 1);
    let half = Rat::inv_succ(k + k + 1);
    let edge: (h + h <= half) = Rat::le_trans(Rat::le_of_same(Rat::inv_pow2_half(n)),
        Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_antitone(k + k + 1, n, far)));
    calc {
        (h + half) + h ≈ (half + h) + h := Rat::add_respects(h.add_comm(half), h.same_refl()),
        ≈ half + (h + h) := half.add_assoc(h, h),
        <= half + half := (h + h).add_le_mono_l(half, half, edge),
        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
    }
}

// The ways laws about rounded terms are proved. Terms within 2^-n + 2^-n of
// each other everywhere are Bishop's equality at the binary rate. Terms
// each within a rounding of a rational sequence are `≈` when those
// sequences become close.
theorem CReal::same_of_near(self x, y: CReal, near: (n: Nat) → (x.at(n) - y.at(n)).abs() <= Rat::inv_pow2(n) + Rat::inv_pow2(n)): x ≈ y {
    CReal::same_of_bishop(near)
}

theorem CReal::same_of_approx(self x, y: CReal, f, g: Nat → Rat,
    hx: (n: Nat) → (x.at(n) - f(n)).abs() <= Rat::inv_pow2(n + 1),
    hy: (n: Nat) → (g(n) - y.at(n)).abs() <= Rat::inv_pow2(n + 1),
    close: (k: Nat) → ∃ start: Nat, (n: Nat) → start <= n → (f(n) - g(n)).abs() <= Rat::inv_succ(k)): x ≈ y
{
    λ k => {
        let k2 = k + k + 1;
        match close(k2) {
            Exists(s, c) => Exists(s.max(k2), λ n from => {
                let at_s: (s <= n) = s.le_trans(s.max(k2), n, s.le_max_l(k2), from);
                let at_k: (k2 <= n) = k2.le_trans(s.max(k2), n, s.le_max_r(k2), from);
                Rat::le_trans(Rat::dist_three(hx(n), c(n, at_s), hy(n)), CReal::slack_le(n, k, at_k))
            }),
        }
    }
}

// ---------------------------------------------------------------------------
// The rationals inside the reals: a rational floored at each precision.

theorem CReal::const_regular(q: Rat, m, n: Nat): (q - q).abs() <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1) {
    calc {
        (q - q).abs() ≈ 0 := q.abs_sub_self(),
        <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1) := Rat::le_respects(Rat::add_zero(0), (Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1)).same_refl(),
            Rat::add_le_mono(Rat::inv_pow2_nonneg(m + 1), Rat::inv_pow2_nonneg(n + 1))),
    }
}

fn CReal::ofRat(q: Rat) → CReal { CReal::rounded(λ n => q, λ m n => CReal::const_regular(q, m, n)) }

theorem CReal::ofRat_close(q: Rat, n: Nat): (CReal::ofRat(q).at(n) - q).abs() <= Rat::inv_pow2(n + 1) { Dyadic::floor_rat_close(q, n + 1) }

theorem CReal::ofRat_close_r(q: Rat, n: Nat): (q - CReal::ofRat(q).at(n)).abs() <= Rat::inv_pow2(n + 1) {
    Rat::le_trans(Rat::le_of_same(q.abs_sub_comm(CReal::ofRat(q).at(n))), CReal::ofRat_close(q, n))
}

// An integer floors to itself, so a numeral's terms are its value.
theorem CReal::ofInt_at(z: Int, n: Nat): CReal::ofRat(Rat::ofInt(z)).at(n) ≈ Rat::ofInt(z) { Dyadic::floor_rat_int(z, n + 1) }

// A numeral at `CReal` is the rational numeral embedded: `0`, `1`, `2 * x`.
// As at `Rat` it is the only spelling of a constant, since evidence search
// compares spellings (std/rat's note on `Numeral<Rat>`).
instance Numeral<CReal> { ofNat := λ (n: Nat) => CReal::ofRat(Rat::ofInt(OfNat(n))) }

theorem CReal::zero_at(n: Nat): CReal::at(0, n) ≈ 0 { CReal::ofInt_at(OfNat(0), n) }

theorem CReal::one_at(n: Nat): CReal::at(1, n) ≈ 1 { CReal::ofInt_at(OfNat(1), n) }

// Rationals' images are `≈` exactly when the rationals are.
theorem CReal::ofRat_approx({p, q: Rat}, f, g: Nat → Rat, hf: (n: Nat) → f(n) ≈ p, hg: (n: Nat) → g(n) ≈ q, h: p ≈ q):
    (k: Nat) → ∃ start: Nat, (n: Nat) → start <= n → (f(n) - g(n)).abs() <= Rat::inv_succ(k)
{
    λ k => Exists(0, λ n _ => calc {
        (f(n) - g(n)).abs() ≈ (q - q).abs() := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(hf(n), h), hg(n))),
        ≈ 0 := q.abs_sub_self(),
        <= Rat::inv_succ(k) := Rat::le_of_lt(Rat::inv_succ_pos(k)),
    })
}

theorem CReal::ofRat_respects({p, q: Rat}, h: p ≈ q): CReal::ofRat(p) ≈ CReal::ofRat(q) {
    CReal::ofRat(p).same_of_approx(CReal::ofRat(q), λ n => p, λ n => q, λ n => CReal::ofRat_close(p, n), λ n => CReal::ofRat_close_r(q, n),
        CReal::ofRat_approx(λ n => p, λ n => q, λ n => p.same_refl(), λ n => q.same_refl(), h))
}

// The embedding reflects `≈` too: rationals that become arbitrarily close
// are the same (`Rat::same_of_close`), and the images' terms are within a
// rounding of them.
theorem CReal::ofRat_inj({p, q: Rat}, h: CReal::ofRat(p) ≈ CReal::ofRat(q)): p ≈ q {
    p.same_of_close(q, λ k => {
        let k2 = k + k + 1;
        let n = k2 + k2 + 1;
        let far: (k2 <= n) = k2.le_add_l(k2 + 1);
        Rat::le_trans(Rat::dist_three(CReal::ofRat_close_r(p, n), CReal::close_of_same(h, k2, n, n.le_refl()), CReal::ofRat_close(q, n)),
            CReal::slack_le(n, k, far))
    })
}

// ---------------------------------------------------------------------------
// Arithmetic. Negation reads the same index; a sum reads index n+1 of both
// summands, so that the two rates of 2^-(n+1) add up to one of 2^-n. Both are
// exact on dyadics, so neither rounds.

theorem CReal::neg_regular(self x: CReal, m, n: Nat):
    ((-x.seq(m)).rat() - (-x.seq(n)).rat()).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n)
{
    calc {
        ((-x.seq(m)).rat() - (-x.seq(n)).rat()).abs() ≈ ((-x.at(m)) - (-x.at(n))).abs()
            := Rat::abs_respects(Rat::sub_respects(x.seq(m).rat_neg(), x.seq(n).rat_neg())),
        ≈ (x.at(m) - x.at(n)).abs() := x.at(m).abs_neg_sub_neg(x.at(n)),
        <= Rat::inv_pow2(m) + Rat::inv_pow2(n) := x.regular(m, n),
    }
}

fn CReal::neg(self x: CReal) → CReal { CReal(λ n => -x.seq(n), λ m n => x.neg_regular(m, n)) }

theorem CReal::add_regular(self x, y: CReal, m, n: Nat):
    ((x.seq(m + 1) + y.seq(m + 1)).rat() - (x.seq(n + 1) + y.seq(n + 1)).rat()).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n)
{
    let hm = Rat::inv_pow2(m + 1);
    let hn = Rat::inv_pow2(n + 1);
    calc {
        ((x.seq(m + 1) + y.seq(m + 1)).rat() - (x.seq(n + 1) + y.seq(n + 1)).rat()).abs()
            ≈ ((x.at(m + 1) + y.at(m + 1)) - (x.at(n + 1) + y.at(n + 1))).abs()
                := Rat::abs_respects(Rat::sub_respects(x.seq(m + 1).rat_add(y.seq(m + 1)), x.seq(n + 1).rat_add(y.seq(n + 1)))),
            <= (hm + hn) + (hm + hn) := Rat::dist_add_le(x.regular(m + 1, n + 1), y.regular(m + 1, n + 1)),
            ≈ (hm + hm) + (hn + hn) := hm.add_add_add_comm(hn, hm, hn),
            ≈ Rat::inv_pow2(m) + Rat::inv_pow2(n) := Rat::add_respects(Rat::inv_pow2_half(m), Rat::inv_pow2_half(n)),
    }
}

fn CReal::add(self x, y: CReal) → CReal {
    CReal(λ n => x.seq(n + 1) + y.seq(n + 1), λ m n => x.add_regular(y, m, n))
}

designation + at CReal := CReal::add
designation prefix - at CReal := CReal::neg

fn CReal::sub(self x, y: CReal) → CReal { x + -y }

designation - at CReal := CReal::sub

theorem CReal::neg_at(self x: CReal, n: Nat): (-x).at(n) ≈ -x.at(n) { x.seq(n).rat_neg() }

theorem CReal::add_at(self x, y: CReal, n: Nat): (x + y).at(n) ≈ x.at(n + 1) + y.at(n + 1) { x.seq(n + 1).rat_add(y.seq(n + 1)) }

theorem CReal::sub_at(self x, y: CReal, n: Nat): (x - y).at(n) ≈ x.at(n + 1) - y.at(n + 1) {
    Rat::same_trans(x.add_at(-y, n), Rat::add_respects(x.at(n + 1).same_refl(), y.neg_at(n + 1)))
}

theorem CReal::neg_respects({x, x2: CReal}, hx: x ≈ x2): -x ≈ -x2 {
    λ k => match hx(k) {
        Exists(start, close) => Exists(start, λ n from => calc {
            ((-x).at(n) - (-x2).at(n)).abs() ≈ ((-x.at(n)) - (-x2.at(n))).abs() := Rat::abs_respects(Rat::sub_respects(x.neg_at(n), x2.neg_at(n))),
            ≈ (x.at(n) - x2.at(n)).abs() := x.at(n).abs_neg_sub_neg(x2.at(n)),
            <= Rat::inv_succ(k) := close(n, from),
        }),
    }
}

// Each summand within 1/(2k+2) of its partner from index n+1 on, past both
// starts.
theorem CReal::add_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x + y ≈ x2 + y2 {
    λ k => match hx(k + k + 1) {
        Exists(i, cx) => match hy(k + k + 1) {
            Exists(j, cy) => Exists(i.max(j), λ n from => {
                let far: (n <= n + 1) = n.le_succ_r(n, n.le_refl());
                let at_x: (i <= n + 1) = i.le_trans(n, n + 1, i.le_trans(i.max(j), n, i.le_max_l(j), from), far);
                let at_y: (j <= n + 1) = j.le_trans(n, n + 1, j.le_trans(i.max(j), n, i.le_max_r(j), from), far);
                let half = Rat::inv_succ(k + k + 1);
                let a: ((x.at(n + 1) - x2.at(n + 1)).abs() <= half) = cx(n + 1, at_x);
                let b: ((y.at(n + 1) - y2.at(n + 1)).abs() <= half) = cy(n + 1, at_y);
                calc {
                    ((x + y).at(n) - (x2 + y2).at(n)).abs()
                        ≈ ((x.at(n + 1) + y.at(n + 1)) - (x2.at(n + 1) + y2.at(n + 1))).abs() := Rat::abs_respects(Rat::sub_respects(x.add_at(y, n), x2.add_at(y2, n))),
                        <= half + half := Rat::dist_add_le(a, b),
                        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                }
            }),
        },
    }
}

theorem CReal::sub_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x - y ≈ x2 - y2 {
    CReal::add_respects(hx, CReal::neg_respects(hy))
}

instance Respects2<CReal, CReal, CReal>(CReal::Same, CReal::Same, CReal::Same, CReal::add) {
    respects2 := λ x x2 hx y y2 hy => CReal::add_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The additive laws, modulo `≈`. Commutativity and inverses hold term by
// term; the identity and associativity compare terms at neighbouring
// indices, which regularity keeps within Bishop's binary bound.

theorem CReal::add_comm(self x, y: CReal): x + y ≈ y + x {
    (x + y).same_of_terms(y + x, λ n => calc {
        (x + y).at(n) ≈ x.at(n + 1) + y.at(n + 1) := x.add_at(y, n),
        ≈ y.at(n + 1) + x.at(n + 1) := x.at(n + 1).add_comm(y.at(n + 1)),
        ≈ (y + x).at(n) := Rat::same_sym(y.add_at(x, n)),
    })
}

theorem CReal::add_neg(self x: CReal): x + -x ≈ 0 {
    (x + -x).same_of_terms(0, λ n => calc {
        (x + -x).at(n) ≈ x.at(n + 1) + -x.at(n + 1) := Rat::same_trans(x.add_at(-x, n), Rat::add_respects(x.at(n + 1).same_refl(), x.neg_at(n + 1))),
        ≈ 0 := x.at(n + 1).add_neg(),
        ≈ CReal::at(0, n) := Rat::same_sym(CReal::zero_at(n)),
    })
}

theorem CReal::add_zero(self x: CReal): x + 0 ≈ x {
    (x + 0).same_of_near(x, λ n => {
        let h = Rat::inv_pow2(n + 1);
        let f = Rat::inv_pow2(n);
        let step: (h <= f) = Rat::inv_pow2_antitone(n, n + 1, n.le_succ_r(n, n.le_refl()));
        calc {
            ((x + 0).at(n) - x.at(n)).abs() ≈ (x.at(n + 1) - x.at(n)).abs()
                := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(x.add_at(0, n),
                    Rat::same_trans(Rat::add_respects(x.at(n + 1).same_refl(), CReal::zero_at(n + 1)), x.at(n + 1).add_zero())), x.at(n).same_refl())),
            <= h + f := x.regular(n + 1, n),
            <= f + f := h.add_le_mono_r(f, f, step),
        }
    })
}

// ((x + y) + z) reads x and y at n+2 and z at n+1; (x + (y + z)) reads x
// at n+1 and y and z at n+2. After reassociating, y's terms cancel and x's
// and z's two terms are within 2^-(n+2) + 2^-(n+1) each: three halves of
// 2^-n.
theorem CReal::add_assoc(self x, y, z: CReal): (x + y) + z ≈ x + (y + z) {
    ((x + y) + z).same_of_near(x + (y + z), λ n => {
        let i = n + 1;
        let j = i + 1;
        let h1 = Rat::inv_pow2(i);
        let h2 = Rat::inv_pow2(j);
        let f = Rat::inv_pow2(n);
        let lhs: (((x + y) + z).at(n) ≈ (x.at(j) + y.at(j)) + z.at(i)) =
            Rat::same_trans((x + y).add_at(z, n), Rat::add_respects(x.add_at(y, i), z.at(i).same_refl()));
        let rhs: ((x + (y + z)).at(n) ≈ x.at(i) + (y.at(j) + z.at(j))) =
            Rat::same_trans(x.add_at(y + z, n), Rat::add_respects(x.at(i).same_refl(), y.add_at(z, i)));
        let dx: ((x.at(j) - x.at(i)).abs() <= h2 + h1) = x.regular(j, i);
        let dz: ((z.at(i) - z.at(j)).abs() <= h2 + h1) = Rat::le_trans(Rat::le_of_same(z.at(i).abs_sub_comm(z.at(j))), z.regular(j, i));
        let dy: ((y.at(j) - y.at(j)).abs() <= 0) = Rat::le_of_same(y.at(j).abs_sub_self());
        let step: (h1 <= f) = Rat::inv_pow2_antitone(n, i, n.le_succ_r(n, n.le_refl()));
        calc {
            (((x + y) + z).at(n) - (x + (y + z)).at(n)).abs()
                ≈ ((x.at(j) + (y.at(j) + z.at(i))) - (x.at(i) + (y.at(j) + z.at(j)))).abs()
                    := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(lhs, x.at(j).add_assoc(y.at(j), z.at(i))), rhs)),
                <= (h2 + h1) + (0 + (h2 + h1)) := Rat::dist_add_le(dx, Rat::dist_add_le(dy, dz)),
                ≈ (h2 + h1) + (h2 + h1) := Rat::add_respects((h2 + h1).same_refl(), Rat::zero_add(h2 + h1)),
                ≈ (h2 + h2) + (h1 + h1) := h2.add_add_add_comm(h1, h2, h1),
                ≈ h1 + f := Rat::add_respects(Rat::inv_pow2_half(i), Rat::inv_pow2_half(n)),
                <= f + f := h1.add_le_mono_r(f, f, step),
        }
    })
}

instance SemigroupRel<CReal>(CReal::Same, CReal::add) {
    assoc := CReal::add_assoc,
}

instance Commutative<CReal>(CReal::Same, CReal::add) {
    comm := CReal::add_comm,
}

// The embedding is additive: both sides' terms are within 2^-n of the same
// rational.
theorem CReal::same_of_near_rat(self x, y: CReal, q: Rat, hx: (n: Nat) → (x.at(n) - q).abs() <= Rat::inv_pow2(n),
    hy: (n: Nat) → (q - y.at(n)).abs() <= Rat::inv_pow2(n)): x ≈ y
{
    x.same_of_near(y, λ n => Rat::le_trans(x.at(n).dist_triangle(q, y.at(n)), Rat::add_le_mono(hx(n), hy(n))))
}

theorem CReal::half_le(n: Nat): Rat::inv_pow2(n + 1) <= Rat::inv_pow2(n) { Rat::inv_pow2_antitone(n, n + 1, n.le_succ_r(n, n.le_refl())) }

theorem CReal::ofRat_neg(q: Rat): CReal::ofRat(-q) ≈ -CReal::ofRat(q) {
    CReal::ofRat(-q).same_of_near_rat(-CReal::ofRat(q), -q, λ n => Rat::le_trans(CReal::ofRat_close(-q, n), CReal::half_le(n)),
        λ n => calc {
            (-q - (-CReal::ofRat(q)).at(n)).abs() ≈ (-q - -CReal::ofRat(q).at(n)).abs() := Rat::abs_respects(Rat::sub_respects((-q).same_refl(), CReal::ofRat(q).neg_at(n))),
            ≈ (q - CReal::ofRat(q).at(n)).abs() := q.abs_neg_sub_neg(CReal::ofRat(q).at(n)),
            <= Rat::inv_pow2(n + 1) := CReal::ofRat_close_r(q, n),
            <= Rat::inv_pow2(n) := CReal::half_le(n),
        })
}

theorem CReal::ofRat_add(p, q: Rat): CReal::ofRat(p + q) ≈ CReal::ofRat(p) + CReal::ofRat(q) {
    CReal::ofRat(p + q).same_of_near_rat(CReal::ofRat(p) + CReal::ofRat(q), p + q, λ n => Rat::le_trans(CReal::ofRat_close(p + q, n), CReal::half_le(n)),
        λ n => {
            let h = Rat::inv_pow2(n + 1 + 1);
            calc {
                ((p + q) - (CReal::ofRat(p) + CReal::ofRat(q)).at(n)).abs()
                    ≈ ((p + q) - (CReal::ofRat(p).at(n + 1) + CReal::ofRat(q).at(n + 1))).abs()
                        := Rat::abs_respects(Rat::sub_respects((p + q).same_refl(), CReal::ofRat(p).add_at(CReal::ofRat(q), n))),
                    <= h + h := Rat::dist_add_le(CReal::ofRat_close_r(p, n + 1), CReal::ofRat_close_r(q, n + 1)),
                    ≈ Rat::inv_pow2(n + 1) := Rat::inv_pow2_half(n + 1),
                    <= Rat::inv_pow2(n) := CReal::half_le(n),
            }
        })
}

theorem CReal::ofRat_sub(p, q: Rat): CReal::ofRat(p - q) ≈ CReal::ofRat(p) - CReal::ofRat(q) {
    CReal::same_trans(CReal::ofRat_add(p, -q), CReal::add_respects(CReal::ofRat(p).same_refl(), CReal::ofRat_neg(q)))
}

// ---------------------------------------------------------------------------
// Multiplication. A product's error is each factor's error weighted by the
// other factor's size, so a product reads its factors further out the larger
// they are. Every real has a canonical bound, `bound`: |x_0| rounded up, plus
// 2, since every term is within 1 + 1 of x_0. The product of x and y reads
// both at index n + 2 + b, b the bit width of the larger bound, so 2^b is
// above both factors: each factor's error there is 2^-(n+2+b), the other
// factor's 2^b scales it back to 2^-(n+2) (`Rat::scale_inv_pow2`), the two
// halves make 2^-(n+1), and the rounding to n+1 bits takes the rest.
//
// The bound is a function of the representation, not of the real: two `≈`
// reals can have different bounds, so a product of `≈` factors reads them at
// different indices, and every law below compares terms across indices. One
// estimate, `mul_close`, does all of that work; `same_of_approx` absorbs the
// roundings.

fn CReal::bound(self x: CReal) → Nat { x.at(0).abs_ceil() + 2 }

theorem CReal::bound_le(self x: CReal, n: Nat): x.at(n).abs() <= Rat::ofInt(OfNat(x.bound())) {
    let a = x.at(0);
    let top = Rat::ofInt(OfNat(a.abs_ceil()));
    let two: Rat = 1 + 1;
    calc {
        x.at(n).abs() ≈ ((x.at(n) - a) + a).abs() := Rat::abs_respects(Rat::same_sym(x.at(n).sub_add_cancel(a))),
        <= (x.at(n) - a).abs() + a.abs() := (x.at(n) - a).abs_triangle(a),
        <= (Rat::inv_succ(n) + Rat::inv_succ(0)) + top := Rat::add_le_mono(x.unary(n, 0), a.abs_le_abs_ceil()),
        <= two + top := (Rat::inv_succ(n) + Rat::inv_succ(0)).add_le_mono_r(two, top,
            Rat::add_le_mono(Rat::inv_succ_le_one(n), Rat::inv_succ_le_one(0))),
        ≈ Rat::ofInt(OfNat(x.bound())) := Rat::two_add_ofNat(a.abs_ceil()),
    }
}

theorem CReal::bound_below(self x: CReal, n, m: Nat, h: x.bound() <= m): x.at(n).abs() <= Rat::ofInt(OfNat(m)) {
    Rat::le_trans(x.bound_le(n), Rat::ofInt_le(OfNat(x.bound()), OfNat(m), h))
}

// A term times something within 2^-j is within 1/(k+1) once j is far past
// the real's bound: the shape of a rounding inside a product.
theorem CReal::edge_le({u, d: Rat}, l, k, j: Nat, hu: u.abs() <= Rat::ofInt(OfNat(l)), far: l * (k + 1) + k <= j, hd: d.abs() <= Rat::inv_pow2(j)):
    (d * u).abs() <= Rat::inv_succ(k)
{
    let big = Rat::ofInt(OfNat(l));
    let e = Rat::inv_pow2(j);
    calc {
        (d * u).abs() ≈ d.abs() * u.abs() := d.abs_mul(u),
        <= e * big := Rat::mul_le_mul(hd, hu, d.abs_nonneg(), u.abs_nonneg()),
        ≈ big * e := e.mul_comm(big),
        <= Rat::inv_succ(k) := Rat::scale_inv_succ_le(l, j, k, far, Rat::inv_pow2_le_inv_succ(j)),
    }
}

// x ≈ x2 read at two far indices, not one: within 1/(2k+2) along x by
// regularity, then within 1/(2k+2) across to x2.
theorem CReal::same_close_far({x, x2: CReal}, h: x ≈ x2, k: Nat):
    ∃ start: Nat, (a, b: Nat) → start <= a → start <= b → (x.at(a) - x2.at(b)).abs() <= Rat::inv_succ(k)
{
    let k2 = k + k + 1;
    let far = k2 + k2 + 1;
    let half = Rat::inv_succ(k2);
    match h(k2) {
        Exists(i, close) => Exists(i.max(far), λ a b ha hb => {
            let reg_a: (far <= a) = far.le_trans(i.max(far), a, i.le_max_r(far), ha);
            let reg_b: (far <= b) = far.le_trans(i.max(far), b, i.le_max_r(far), hb);
            let at_b: (i <= b) = i.le_trans(i.max(far), b, i.le_max_l(far), hb);
            calc {
                (x.at(a) - x2.at(b)).abs() <= (x.at(a) - x.at(b)).abs() + (x.at(b) - x2.at(b)).abs() := x.at(a).dist_triangle(x.at(b), x2.at(b)),
                <= half + half := Rat::add_le_mono(x.regular_close(k2, a, b, reg_a, reg_b), close(b, at_b)),
                ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
            }
        }),
    }
}

// The estimate behind every product law: two products of `≈` factors, each
// factor read at its own index, are within 1/(k+1) once every index is far
// enough out. With both sides' factors under l+1 and each pair of factors
// within 1/((l+1)(2k+2)), `Rat::dist_mul_le` bounds the difference by two
// halves of 1/(k+1). Taking the four indices independently lets one lemma
// serve products read at different depths, as the laws' two sides are.
theorem CReal::mul_close({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, k: Nat):
    ∃ start: Nat, (a, b, c, d: Nat) → start <= a → start <= b → start <= c → start <= d →
        (x.at(a) * y.at(b) - x2.at(c) * y2.at(d)).abs() <= Rat::inv_succ(k)
{
    let l = x.bound() + y2.bound();
    let k2 = k + k + 1;
    let j = l * (k2 + 1) + k2;
    let big = Rat::ofInt(OfNat(l + 1));
    let e = Rat::inv_succ(j);
    match CReal::same_close_far(hx, j) {
        Exists(s, cx) => match CReal::same_close_far(hy, j) {
            Exists(t, cy) => Exists(s.max(t), λ a b c d ha hb hc hd => {
                let in_s = s.le_max_l(t);
                let in_t = s.le_max_r(t);
                let near_x: ((x.at(a) - x2.at(c)).abs() <= e) =
                    cx(a, c, s.le_trans(s.max(t), a, in_s, ha), s.le_trans(s.max(t), c, in_s, hc));
                let near_y: ((y.at(b) - y2.at(d)).abs() <= e) =
                    cy(b, d, t.le_trans(s.max(t), b, in_t, hb), t.le_trans(s.max(t), d, in_t, hd));
                let size_x: (x.at(a).abs() <= big) = x.bound_below(a, l + 1, x.bound().le_succ_r(l, x.bound().le_add_l(y2.bound())));
                let size_y: (y2.at(d).abs() <= big) = y2.bound_below(d, l + 1, y2.bound().le_succ_r(l, x.bound().le_add_r(y2.bound())));
                calc {
                    (x.at(a) * y.at(b) - x2.at(c) * y2.at(d)).abs() <= big * e + big * e := Rat::dist_mul_le(size_x, size_y, near_y, near_x),
                    ≈ Rat::inv_succ(k) := Rat::scale_inv_succ_half(l, k),
                }
            }),
        },
    }
}

// Where a product reads its factors: n + 2 + b, b the bit width of the
// larger bound.
fn CReal::mul_bits(self x, y: CReal) → Nat { x.bound().max(y.bound()).width() }

fn CReal::mul_at(self x, y: CReal, n: Nat) → Nat { (n + 1 + 1) + x.mul_bits(y) }

theorem CReal::mul_at_ge(self x, y: CReal, n: Nat): n <= x.mul_at(y, n) {
    n.le_trans(n + 1 + 1, x.mul_at(y, n), n.le_add_l(1 + 1), (n + 1 + 1).le_add_l(x.mul_bits(y)))
}

theorem CReal::bits_above(self x, y: CReal): x.bound().max(y.bound()) <= Nat::pow(2, x.mul_bits(y)) {
    x.bound().max(y.bound()).le_of_lt(Nat::pow(2, x.mul_bits(y)), x.bound().max(y.bound()).lt_pow_width())
}

theorem CReal::size_l(self x, y: CReal, n: Nat): x.at(n).abs() <= Rat::ofInt(OfNat(Nat::pow(2, x.mul_bits(y)))) {
    x.bound_below(n, Nat::pow(2, x.mul_bits(y)), x.bound().le_trans(x.bound().max(y.bound()), Nat::pow(2, x.mul_bits(y)), x.bound().le_max_l(y.bound()), x.bits_above(y)))
}

theorem CReal::size_r(self x, y: CReal, n: Nat): y.at(n).abs() <= Rat::ofInt(OfNat(Nat::pow(2, x.mul_bits(y)))) {
    y.bound_below(n, Nat::pow(2, x.mul_bits(y)), y.bound().le_trans(x.bound().max(y.bound()), Nat::pow(2, x.mul_bits(y)), x.bound().le_max_r(y.bound()), x.bits_above(y)))
}

// Both factors move by 2^-a + 2^-b between the two indices, and each
// movement is weighted by the other factor's 2^b.
theorem CReal::mul_regular(self x, y: CReal, m, n: Nat):
    (x.at(x.mul_at(y, m)) * y.at(x.mul_at(y, m)) - x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n))).abs()
        <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1)
{
    let w = x.mul_bits(y);
    let a = x.mul_at(y, m);
    let b = x.mul_at(y, n);
    let big = Rat::ofInt(OfNat(Nat::pow(2, w)));
    let fa = Rat::inv_pow2(a);
    let fb = Rat::inv_pow2(b);
    let half_m: (big * fa + big * fa ≈ Rat::inv_pow2(m + 1)) =
        Rat::same_trans(Rat::add_respects(Rat::scale_inv_pow2(w, m + 1 + 1), Rat::scale_inv_pow2(w, m + 1 + 1)), Rat::inv_pow2_half(m + 1));
    let half_n: (big * fb + big * fb ≈ Rat::inv_pow2(n + 1)) =
        Rat::same_trans(Rat::add_respects(Rat::scale_inv_pow2(w, n + 1 + 1), Rat::scale_inv_pow2(w, n + 1 + 1)), Rat::inv_pow2_half(n + 1));
    calc {
        (x.at(a) * y.at(a) - x.at(b) * y.at(b)).abs() <= big * (fa + fb) + big * (fa + fb)
            := Rat::dist_mul_le(x.size_l(y, a), x.size_r(y, b), y.regular(a, b), x.regular(a, b)),
        ≈ (big * fa + big * fa) + (big * fb + big * fb) := big.mul_add_twice(fa, fb),
        ≈ Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1) := Rat::add_respects(half_m, half_n),
    }
}

fn CReal::mul(self x, y: CReal) → CReal {
    CReal::rounded(λ n => x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)), λ m n => x.mul_regular(y, m, n))
}

designation * at CReal := CReal::mul

// A product's term is within a rounding of its factors' product.
theorem CReal::mul_term(self x, y: CReal, n: Nat): ((x * y).at(n) - x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n))).abs() <= Rat::inv_pow2(n + 1) {
    Dyadic::floor_rat_close(x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)), n + 1)
}

theorem CReal::mul_term_r(self x, y: CReal, n: Nat): (x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)) - (x * y).at(n)).abs() <= Rat::inv_pow2(n + 1) {
    Rat::le_trans(Rat::le_of_same((x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n))).abs_sub_comm((x * y).at(n))), x.mul_term(y, n))
}

theorem CReal::mul_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x * y ≈ x2 * y2 {
    (x * y).same_of_approx(x2 * y2, λ n => x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)), λ n => x2.at(x2.mul_at(y2, n)) * y2.at(x2.mul_at(y2, n)),
        λ n => x.mul_term(y, n), λ n => x2.mul_term_r(y2, n),
        λ k => match CReal::mul_close(hx, hy, k) {
            Exists(s, close) => Exists(s, λ n from => {
                let a = x.mul_at(y, n);
                let b = x2.mul_at(y2, n);
                let at_a: (s <= a) = s.le_trans(n, a, from, x.mul_at_ge(y, n));
                let at_b: (s <= b) = s.le_trans(n, b, from, x2.mul_at_ge(y2, n));
                close(a, a, b, b, at_a, at_a, at_b, at_b)
            }),
        })
}

instance Respects2<CReal, CReal, CReal>(CReal::Same, CReal::Same, CReal::Same, CReal::mul) {
    respects2 := λ x x2 hx y y2 hy => CReal::mul_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The multiplicative laws, modulo `≈`. Each side's term is a rounding of a
// product read at its own index (even commutativity, since
// `x.bound().max(y.bound())` and `y.bound().max(x.bound())` are equal
// numbers but not the same term), so they go through `same_of_approx` and
// `mul_close`.

theorem CReal::mul_comm(self x, y: CReal): x * y ≈ y * x {
    (x * y).same_of_approx(y * x, λ n => x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)), λ n => y.at(y.mul_at(x, n)) * x.at(y.mul_at(x, n)),
        λ n => x.mul_term(y, n), λ n => y.mul_term_r(x, n),
        λ k => match CReal::mul_close(x.same_refl(), y.same_refl(), k) {
            Exists(s, close) => Exists(s, λ n from => {
                let a = x.mul_at(y, n);
                let b = y.mul_at(x, n);
                let at_a: (s <= a) = s.le_trans(n, a, from, x.mul_at_ge(y, n));
                let at_b: (s <= b) = s.le_trans(n, b, from, y.mul_at_ge(x, n));
                calc {
                    (x.at(a) * y.at(a) - y.at(b) * x.at(b)).abs() ≈ (x.at(a) * y.at(a) - x.at(b) * y.at(b)).abs()
                        := Rat::abs_respects(Rat::sub_respects((x.at(a) * y.at(a)).same_refl(), y.at(b).mul_comm(x.at(b)))),
                    <= Rat::inv_succ(k) := close(a, a, b, b, at_a, at_a, at_b, at_b),
                }
            }),
        })
}

// The reassociated estimate: an x term times a y·z product against an x·y
// product times a z term, every index free past the start. `Rat::dist_mul_le`
// applies once, with the y·z terms bounded by the product of the bounds and
// their distance by `mul_close`.
theorem CReal::mul_assoc_close(self x, y, z: CReal, k: Nat):
    ∃ start: Nat, (a, a2, b, b2: Nat) → start <= a → start <= a2 → start <= b → start <= b2 →
        (x.at(a2) * (y.at(a2) * z.at(a)) - x.at(b) * (y.at(b2) * z.at(b2))).abs() <= Rat::inv_succ(k)
{
    let l = x.bound() + y.bound() * z.bound();
    let k2 = k + k + 1;
    let j = l * (k2 + 1) + k2;
    let big = Rat::ofInt(OfNat(l + 1));
    let e = Rat::inv_succ(j);
    match CReal::same_close_far(x.same_refl(), j) {
        Exists(s, cx) => match CReal::mul_close(y.same_refl(), z.same_refl(), j) {
            Exists(t, cyz) => Exists(s.max(t), λ a a2 b b2 ha ha2 hb hb2 => {
                let in_s = s.le_max_l(t);
                let in_t = s.le_max_r(t);
                let near_x: ((x.at(a2) - x.at(b)).abs() <= e) =
                    cx(a2, b, s.le_trans(s.max(t), a2, in_s, ha2), s.le_trans(s.max(t), b, in_s, hb));
                let near_yz: ((y.at(a2) * z.at(a) - y.at(b2) * z.at(b2)).abs() <= e) =
                    cyz(a2, a, b2, b2, t.le_trans(s.max(t), a2, in_t, ha2), t.le_trans(s.max(t), a, in_t, ha),
                        t.le_trans(s.max(t), b2, in_t, hb2), t.le_trans(s.max(t), b2, in_t, hb2));
                let size_x: (x.at(a2).abs() <= big) =
                    x.bound_below(a2, l + 1, x.bound().le_succ_r(l, x.bound().le_add_l(y.bound() * z.bound())));
                let yb = Rat::ofInt(OfNat(y.bound()));
                let zb = Rat::ofInt(OfNat(z.bound()));
                let size_yz: ((y.at(b2) * z.at(b2)).abs() <= big) = calc {
                    (y.at(b2) * z.at(b2)).abs() ≈ y.at(b2).abs() * z.at(b2).abs() := y.at(b2).abs_mul(z.at(b2)),
                    <= yb * zb := Rat::mul_le_mul(y.bound_le(b2), z.bound_le(b2), y.at(b2).abs_nonneg(), z.at(b2).abs_nonneg()),
                    ≈ Rat::ofInt(OfNat(y.bound() * z.bound())) := Rat::same_sym(Rat::ofInt_mul(OfNat(y.bound()), OfNat(z.bound()))),
                    <= big := Rat::ofInt_le(OfNat(y.bound() * z.bound()), OfNat(l + 1),
                        (y.bound() * z.bound()).le_succ_r(l, x.bound().le_add_r(y.bound() * z.bound()))),
                };
                calc {
                    (x.at(a2) * (y.at(a2) * z.at(a)) - x.at(b) * (y.at(b2) * z.at(b2))).abs()
                        <= big * e + big * e := Rat::dist_mul_le(size_x, size_yz, near_yz, near_x),
                        ≈ Rat::inv_succ(k) := Rat::scale_inv_succ_half(l, k),
                }
            }),
        },
    }
}

// ((x * y) * z) reads z at a and (x * y) there, a rounding of x and y at
// a2; (x * (y * z)) reads x at b and (y * z) there, a rounding of y and z at
// b2. The two roundings are each within 1/(4k+4) once the indices are past
// the bounds' scale (`edge_le`), and the reassociated products within
// 1/(2k+2) (`mul_assoc_close`).
theorem CReal::mul_assoc(self x, y, z: CReal): (x * y) * z ≈ x * (y * z) {
    let f = λ (n: Nat) => (x * y).at((x * y).mul_at(z, n)) * z.at((x * y).mul_at(z, n));
    let g = λ (n: Nat) => x.at(x.mul_at(y * z, n)) * (y * z).at(x.mul_at(y * z, n));
    ((x * y) * z).same_of_approx(x * (y * z), f, g, λ n => (x * y).mul_term(z, n), λ n => x.mul_term_r(y * z, n),
        λ k => {
            let k2 = k + k + 1;
            let k4 = k2 + k2 + 1;
            let l = x.bound() + z.bound();
            let edge = l * (k4 + 1) + k4;
            match x.mul_assoc_close(y, z, k2) {
                Exists(s, close) => Exists(s.max(edge), λ n from => {
                    let a = (x * y).mul_at(z, n);
                    let a2 = x.mul_at(y, a);
                    let b = x.mul_at(y * z, n);
                    let b2 = y.mul_at(z, b);
                    let at_a: (n <= a) = (x * y).mul_at_ge(z, n);
                    let at_a2: (n <= a2) = n.le_trans(a, a2, at_a, x.mul_at_ge(y, a));
                    let at_b: (n <= b) = x.mul_at_ge(y * z, n);
                    let at_b2: (n <= b2) = n.le_trans(b, b2, at_b, y.mul_at_ge(z, b));
                    let at_s: (s <= n) = s.le_trans(s.max(edge), n, s.le_max_l(edge), from);
                    let at_e: (edge <= n) = edge.le_trans(s.max(edge), n, s.le_max_r(edge), from);
                    let far_a: (edge <= a + 1) = edge.le_trans(n, a + 1, at_e, n.le_succ_r(a, at_a));
                    let far_b: (edge <= b + 1) = edge.le_trans(n, b + 1, at_e, n.le_succ_r(b, at_b));
                    let pa = x.at(a2) * y.at(a2);
                    let pb = y.at(b2) * z.at(b2);
                    let za: (z.at(a).abs() <= Rat::ofInt(OfNat(l))) = z.bound_below(a, l, x.bound().le_add_r(z.bound()));
                    let xb: (x.at(b).abs() <= Rat::ofInt(OfNat(l))) = x.bound_below(b, l, x.bound().le_add_l(z.bound()));
                    let ea: ((((x * y).at(a) - pa) * z.at(a)).abs() <= Rat::inv_succ(k4)) = CReal::edge_le(l, k4, a + 1, za, far_a, x.mul_term(y, a));
                    let eb: (((pb - (y * z).at(b)) * x.at(b)).abs() <= Rat::inv_succ(k4)) = CReal::edge_le(l, k4, b + 1, xb, far_b, y.mul_term_r(z, b));
                    let left: ((f(n) - pa * z.at(a)).abs() <= Rat::inv_succ(k4)) =
                        Rat::le_trans(Rat::le_of_same(Rat::abs_respects(Rat::same_sym(Rat::sub_mul((x * y).at(a), pa, z.at(a))))), ea);
                    let right: ((x.at(b) * pb - g(n)).abs() <= Rat::inv_succ(k4)) = Rat::le_trans(Rat::le_of_same(Rat::abs_respects(Rat::same_trans(
                        Rat::same_sym(Rat::mul_sub(x.at(b), pb, (y * z).at(b))), x.at(b).mul_comm(pb - (y * z).at(b))))), eb);
                    let mid: ((pa * z.at(a) - x.at(b) * pb).abs() <= Rat::inv_succ(k2)) =
                        Rat::le_trans(Rat::le_of_same(Rat::abs_respects(Rat::sub_respects(x.at(a2).mul_assoc(y.at(a2), z.at(a)), (x.at(b) * pb).same_refl()))),
                            close(a, a2, b, b2, s.le_trans(n, a, at_s, at_a), s.le_trans(n, a2, at_s, at_a2),
                                s.le_trans(n, b, at_s, at_b), s.le_trans(n, b2, at_s, at_b2)));
                    Rat::le_trans(Rat::dist_three(left, mid, right), Rat::sandwich_le(k, Rat::inv_succ(k4).le_refl(), Rat::inv_succ(k2).le_refl()))
                }),
            }
        })
}

// x * (y + z) reads y and z at a+1 beyond x's index a; x * y + x * z reads
// each product at its own index past n+1, each a rounding. After
// distributing the rational product, each pair of products is within
// 1/(2k+2) by `mul_close`.
theorem CReal::mul_add_distr(self x, y, z: CReal): x * (y + z) ≈ x * y + x * z {
    let f = λ (n: Nat) => x.at(x.mul_at(y + z, n)) * (y + z).at(x.mul_at(y + z, n));
    let g = λ (n: Nat) => x.at(x.mul_at(y, n + 1)) * y.at(x.mul_at(y, n + 1)) + x.at(x.mul_at(z, n + 1)) * z.at(x.mul_at(z, n + 1));
    (x * (y + z)).same_of_approx(x * y + x * z, f, g, λ n => x.mul_term(y + z, n),
        λ n => {
            let h = Rat::inv_pow2(n + 1 + 1);
            calc {
                (g(n) - (x * y + x * z).at(n)).abs() ≈ (g(n) - ((x * y).at(n + 1) + (x * z).at(n + 1))).abs()
                    := Rat::abs_respects(Rat::sub_respects(g(n).same_refl(), (x * y).add_at(x * z, n))),
                <= h + h := Rat::dist_add_le(x.mul_term_r(y, n + 1), x.mul_term_r(z, n + 1)),
                ≈ Rat::inv_pow2(n + 1) := Rat::inv_pow2_half(n + 1),
            }
        },
        λ k => {
            let k2 = k + k + 1;
            let half = Rat::inv_succ(k2);
            match CReal::mul_close(x.same_refl(), y.same_refl(), k2) {
                Exists(s, cy) => match CReal::mul_close(x.same_refl(), z.same_refl(), k2) {
                    Exists(t, cz) => Exists(s.max(t), λ n from => {
                        let a = x.mul_at(y + z, n);
                        let q = a + 1;
                        let p = n + 1;
                        let b = x.mul_at(y, p);
                        let c = x.mul_at(z, p);
                        let at_a: (n <= a) = x.mul_at_ge(y + z, n);
                        let at_q: (n <= q) = n.le_succ_r(a, at_a);
                        let at_p: (n <= p) = n.le_succ_r(n, n.le_refl());
                        let at_b: (n <= b) = n.le_trans(p, b, at_p, x.mul_at_ge(y, p));
                        let at_c: (n <= c) = n.le_trans(p, c, at_p, x.mul_at_ge(z, p));
                        let at_s: (s <= n) = s.le_trans(s.max(t), n, s.le_max_l(t), from);
                        let at_t: (t <= n) = t.le_trans(s.max(t), n, s.le_max_r(t), from);
                        let dy: ((x.at(a) * y.at(q) - x.at(b) * y.at(b)).abs() <= half) =
                            cy(a, q, b, b, s.le_trans(n, a, at_s, at_a), s.le_trans(n, q, at_s, at_q),
                                s.le_trans(n, b, at_s, at_b), s.le_trans(n, b, at_s, at_b));
                        let dz: ((x.at(a) * z.at(q) - x.at(c) * z.at(c)).abs() <= half) =
                            cz(a, q, c, c, t.le_trans(n, a, at_t, at_a), t.le_trans(n, q, at_t, at_q),
                                t.le_trans(n, c, at_t, at_c), t.le_trans(n, c, at_t, at_c));
                        calc {
                            (f(n) - g(n)).abs()
                                ≈ ((x.at(a) * y.at(q) + x.at(a) * z.at(q)) - g(n)).abs()
                                    := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(Rat::mul_respects(x.at(a).same_refl(), y.add_at(z, a)),
                                        x.at(a).mul_add_distr(y.at(q), z.at(q))), g(n).same_refl())),
                                <= half + half := Rat::dist_add_le(dy, dz),
                                ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                        }
                    }),
                },
            }
        })
}

// x * 1 reads x further out, within 1/(k+1) of x_n once n is past 2k+1.
theorem CReal::mul_one(self x: CReal): x * 1 ≈ x {
    (x * 1).same_of_approx(x, λ n => x.at(x.mul_at(1, n)) * CReal::at(1, x.mul_at(1, n)), λ n => x.at(n), λ n => x.mul_term(1, n),
        λ n => Rat::le_trans(Rat::le_of_same(x.at(n).abs_sub_self()), Rat::inv_pow2_nonneg(n + 1)),
        λ k => Exists(k + k + 1, λ n from => {
            let a = x.mul_at(1, n);
            let far: (k + k + 1 <= a) = (k + k + 1).le_trans(n, a, from, x.mul_at_ge(1, n));
            calc {
                (x.at(a) * CReal::at(1, a) - x.at(n)).abs() ≈ (x.at(a) - x.at(n)).abs()
                    := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(Rat::mul_respects(x.at(a).same_refl(), CReal::one_at(a)), x.at(a).mul_one()), x.at(n).same_refl())),
                <= Rat::inv_succ(k) := x.regular_close(k, a, n, far, from),
            }
        }))
}

theorem CReal::mul_zero(self x: CReal): x * 0 ≈ 0 {
    (x * 0).same_of_approx(0, λ n => x.at(x.mul_at(0, n)) * CReal::at(0, x.mul_at(0, n)), λ n => 0, λ n => x.mul_term(0, n),
        λ n => {
            let o: Rat = 0;
            calc {
                (o - CReal::at(0, n)).abs() ≈ (o - o).abs() := Rat::abs_respects(Rat::sub_respects(o.same_refl(), CReal::zero_at(n))),
                ≈ 0 := o.abs_sub_self(),
                <= Rat::inv_pow2(n + 1) := Rat::inv_pow2_nonneg(n + 1),
            }
        },
        λ k => Exists(0, λ n _ => {
            let t = x.at(x.mul_at(0, n));
            let o: Rat = 0;
            calc {
                (t * CReal::at(0, x.mul_at(0, n)) - o).abs() ≈ (o - o).abs()
                    := Rat::abs_respects(Rat::sub_respects(Rat::same_trans(Rat::mul_respects(t.same_refl(), CReal::zero_at(x.mul_at(0, n))), t.mul_zero()), o.same_refl())),
                ≈ 0 := o.abs_sub_self(),
                <= Rat::inv_succ(k) := Rat::le_of_lt(Rat::inv_succ_pos(k)),
            }
        }))
}

instance SemigroupRel<CReal>(CReal::Same, CReal::mul) {
    assoc := CReal::mul_assoc,
}

instance Commutative<CReal>(CReal::Same, CReal::mul) {
    comm := CReal::mul_comm,
}

// The embedding is multiplicative: the images' terms tend to the
// rationals, so their product tends to the product, as fast as the bounds
// allow.
theorem CReal::ofRat_mul(p, q: Rat): CReal::ofRat(p * q) ≈ CReal::ofRat(p) * CReal::ofRat(q) {
    let x = CReal::ofRat(p);
    let y = CReal::ofRat(q);
    CReal::ofRat(p * q).same_of_approx(x * y, λ n => p * q, λ n => x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)),
        λ n => CReal::ofRat_close(p * q, n), λ n => x.mul_term_r(y, n),
        λ k => {
            let k2 = k + k + 1;
            let l = p.abs_ceil() + y.bound();
            let start = (l + 1) * (k2 + 1) + k2;
            Exists(start, λ n from => {
                let a = x.mul_at(y, n);
                let big = Rat::ofInt(OfNat(l + 1));
                let e = Rat::inv_pow2(a + 1);
                let far: (start <= a + 1) = start.le_trans(n, a + 1, from, n.le_succ_r(a, x.mul_at_ge(y, n)));
                let sp: (p.abs() <= big) = Rat::le_trans(p.abs_le_abs_ceil(), Rat::ofInt_le(OfNat(p.abs_ceil()), OfNat(l + 1), p.abs_ceil().le_succ_r(l, p.abs_ceil().le_add_l(y.bound()))));
                let sy: (y.at(a).abs() <= big) = y.bound_below(a, l + 1, y.bound().le_succ_r(l, p.abs_ceil().le_add_r(y.bound())));
                let one: (big * e <= Rat::inv_succ(k2)) = Rat::scale_inv_succ_le(l + 1, a + 1, k2, far, Rat::inv_pow2_le_inv_succ(a + 1));
                calc {
                    (p * q - x.at(a) * y.at(a)).abs() <= big * e + big * e := Rat::dist_mul_le(sp, sy, CReal::ofRat_close_r(q, a), CReal::ofRat_close_r(p, a)),
                    <= Rat::inv_succ(k2) + Rat::inv_succ(k2) := Rat::add_le_mono(one, one),
                    ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                }
            })
        })
}

// ---------------------------------------------------------------------------
// Strict order and apartness. x < y when, from some index on, y's terms stay
// above x's by a fixed 1/(k+1): a positive gap given as data (the gap's size
// and where it starts), never a refutation of `≤`. No order on reals is ever
// decided; the rationals' order is consulted only term by term.

fn CReal::Lt(x, y: CReal) → Type {
    ∃ k: Nat, ∃ start: Nat, (n: Nat) → start <= n → x.at(n) + Rat::inv_succ(k) <= y.at(n)
}

designation < at CReal := CReal::Lt

// One index far enough out, where y's term clears x's by 1/(2k+2), is
// enough: from there on later terms of each move by at most 1/(8k+8), so a
// gap of 1/(4k+4) remains.
theorem CReal::lt_of_term(self x, y: CReal, k, n: Nat, far: 16 * k + 15 <= n,
    h: x.at(n) + Rat::inv_succ(k + k + 1) <= y.at(n)): x < y
{
    let k2 = k + k + 1;
    let k4 = k2 + k2 + 1;
    let k8 = k4 + k4 + 1;
    let q = Rat::inv_succ(k4);
    let e = Rat::inv_succ(k8);
    let at_n: (k8 + k8 + 1 <= n) = omega;
    let gap = calc {
        x.at(n) + (q + (e + e)) ≈ x.at(n) + Rat::inv_succ(k2) := Rat::add_respects(x.at(n).same_refl(), ring),
        <= y.at(n) := h,
    };
    Exists(k4, Exists(n, λ m from => {
        let at_m: (k8 + k8 + 1 <= m) = omega;
        let dx: ((x.at(m) - x.at(n)).abs() <= e) = x.regular_close(k8, m, n, at_m, at_n);
        let dy: ((y.at(n) - y.at(m)).abs() <= e) = y.regular_close(k8, n, m, at_n, at_m);
        Rat::le_of_close_gap(Rat::le_add_of_dist(dx), Rat::le_add_of_dist(dy), gap)
    }))
}

// Moving each side by 1/(4k+4) along `≈` costs half of a 1/(k+1) gap. The
// closeness is read from the fixed index 8k+7 (`close_of_same`), so the new
// start depends on the gap alone and computing it never opens the `≈`
// proofs.
theorem CReal::lt_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, h: x < y): x2 < y2 {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let k4 = k2 + k2 + 1;
                let far = k4 + k4 + 1;
                let half = Rat::inv_succ(k2);
                let e = Rat::inv_succ(k4);
                Exists(k2, Exists(s.max(far), λ n from => {
                    let at_s: (s <= n) = s.le_trans(s.max(far), n, s.le_max_l(far), from);
                    let at_far: (far <= n) = far.le_trans(s.max(far), n, s.le_max_r(far), from);
                    let dx: ((x2.at(n) - x.at(n)).abs() <= e) = calc {
                        (x2.at(n) - x.at(n)).abs() ≈ (x.at(n) - x2.at(n)).abs() := x2.at(n).abs_sub_comm(x.at(n)),
                        <= e := CReal::close_of_same(hx, k4, n, at_far),
                    };
                    let dy: ((y.at(n) - y2.at(n)).abs() <= e) = CReal::close_of_same(hy, k4, n, at_far);
                    let wide = calc {
                        x.at(n) + (half + (e + e)) ≈ x.at(n) + Rat::inv_succ(k) := Rat::add_respects(x.at(n).same_refl(), ring),
                        <= y.at(n) := gap(n, at_s),
                    };
                    Rat::le_of_close_gap(Rat::le_add_of_dist(dx), Rat::le_add_of_dist(dy), wide)
                }))
            },
        },
    }
}

theorem CReal::lt_irrefl(self x: CReal): ¬(x < x) {
    λ h => match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let a = x.at(s);
                let step = Rat::inv_succ(k);
                let swapped = calc {
                    step + a ≈ a + step := step.add_comm(a),
                    <= a := gap(s, s.le_refl()),
                    ≈ a + 0 := Rat::same_sym(a.add_zero()),
                    ≈ 0 + a := a.add_comm(0),
                };
                Rat::not_le_of_lt(Rat::inv_succ_pos(k), step.add_le_cancel_r(0, a, swapped))
            },
        },
    }
}

// The gaps add, so the first one survives.
theorem CReal::lt_trans({x, y, z: CReal}, h1: x < y, h2: y < z): x < z {
    match h1 {
        Exists(k, r1) => match r1 {
            Exists(s, g1) => match h2 {
                Exists(l, r2) => match r2 {
                    Exists(t, g2) => Exists(k, Exists(s.max(t), λ n from => {
                        let at_s: (s <= n) = s.le_trans(s.max(t), n, s.le_max_l(t), from);
                        let at_t: (t <= n) = t.le_trans(s.max(t), n, s.le_max_r(t), from);
                        calc {
                            x.at(n) + Rat::inv_succ(k) <= y.at(n) := g1(n, at_s),
                            <= y.at(n) + Rat::inv_succ(l) := y.at(n).le_add_nonneg(Rat::inv_succ(l), Rat::le_of_lt(Rat::inv_succ_pos(l))),
                            <= z.at(n) := g2(n, at_t),
                        }
                    })),
                },
            },
        },
    }
}

// Cotransitivity, the constructive replacement for trichotomy. Far enough
// out, compare z's term with the midpoint of x's and y's: the rationals
// decide that, and either side of the midpoint leaves half the gap.
theorem CReal::lt_cotrans(self x, y, z: CReal, h: x < y): x < z ∨ z < y {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let half = Rat::inv_succ(k + k + 1);
                let n = s.max(16 * k + 15);
                let at_s: (s <= n) = s.le_max_l(16 * k + 15);
                let far: (16 * k + 15 <= n) = s.le_max_r(16 * k + 15);
                match (x.at(n) + half).le_dec(z.at(n)) {
                    Inl(above) => Inl(x.lt_of_term(z, k, n, far, above)),
                    Inr(below) => {
                        let clear = calc {
                            z.at(n) + half < (x.at(n) + half) + half := z.at(n).add_lt_mono_r(x.at(n) + half, half, Rat::lt_of_not_le(below)),
                            ≈ x.at(n) + (half + half) := x.at(n).add_assoc(half, half),
                            ≈ x.at(n) + Rat::inv_succ(k) := Rat::add_respects(x.at(n).same_refl(), Rat::inv_succ_half(k)),
                            <= y.at(n) := gap(n, at_s),
                        };
                        Inr(z.lt_of_term(y, k, n, far, Rat::le_of_lt(clear)))
                    },
                }
            },
        },
    }
}

instance Irreflexive<CReal>(CReal::Lt) {
    rel_irrefl := CReal::lt_irrefl,
}

instance Transitive<CReal>(CReal::Lt) {
    rel_trans := λ x y z hxy hyz => CReal::lt_trans(hxy, hyz),
}

// The mixed pairs a `calc` chain composes: `≈` is absorbed by `<` on either
// side.
instance Trans<CReal>(CReal::Same, CReal::Lt, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_respects(CReal::same_sym(hxy), z.same_refl(), hyz),
}

instance Trans<CReal>(CReal::Lt, CReal::Same, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_respects(x.same_refl(), hyz, hxy),
}

// Apartness: one of the two is below the other, by a gap given as data.
fn CReal::Apart(x, y: CReal) → Type { x < y ∨ y < x }

theorem CReal::apart_irrefl(self x: CReal): ¬(x.Apart(x)) {
    λ h => match h {
        Inl(lt) => x.lt_irrefl(lt),
        Inr(lt) => x.lt_irrefl(lt),
    }
}

theorem CReal::apart_sym({x, y: CReal}, h: x.Apart(y)): y.Apart(x) {
    match h {
        Inl(lt) => Inr(lt),
        Inr(gt) => Inl(gt),
    }
}

theorem CReal::apart_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, h: x.Apart(y)): x2.Apart(y2) {
    match h {
        Inl(lt) => Inl(CReal::lt_respects(hx, hy, lt)),
        Inr(gt) => Inr(CReal::lt_respects(hy, hx, gt)),
    }
}

theorem CReal::not_same_of_apart({x, y: CReal}, h: x.Apart(y)): ¬(x ≈ y) {
    λ same => y.apart_irrefl(CReal::apart_respects(same, y.same_refl(), h))
}

theorem CReal::apart_cotrans(self x, y, z: CReal, h: x.Apart(y)): x.Apart(z) ∨ z.Apart(y) {
    match h {
        Inl(lt) => match x.lt_cotrans(y, z, lt) {
            Inl(xz) => Inl(Inl(xz)),
            Inr(zy) => Inr(Inl(zy)),
        },
        Inr(gt) => match y.lt_cotrans(x, z, gt) {
            Inl(yz) => Inr(Inr(yz)),
            Inr(zx) => Inl(Inr(zx)),
        },
    }
}

// Tightness: reals that are not apart are the same. Far enough out, a term
// of either more than 1/(2k+2) above the other's would start a gap; so the
// terms are within 1/(2k+2), hence within 1/(k+1). No decision on reals,
// and none on rationals either: `lt_of_not_le` is the integer order's.
theorem CReal::same_of_not_apart({x, y: CReal}, h: ¬(x.Apart(y))): x ≈ y {
    λ k => Exists(16 * k + 15, λ n far => {
        let half = Rat::inv_succ(k + k + 1);
        let not_above: ¬(y.at(n) + half <= x.at(n)) = λ le => h(Inr(y.lt_of_term(x, k, n, far, le)));
        let not_below: ¬(x.at(n) + half <= y.at(n)) = λ le => h(Inl(x.lt_of_term(y, k, n, far, le)));
        let close: ((x.at(n) - y.at(n)).abs() <= half) =
            Rat::dist_le_of_le_add(Rat::le_of_lt(Rat::lt_of_not_le(not_above)), Rat::le_of_lt(Rat::lt_of_not_le(not_below)));
        let finer: (k <= k + k + 1) = omega;
        Rat::le_trans(close, Rat::inv_succ_antitone(k, k + k + 1, finer))
    })
}

// Two roundings at index n fit in 1/(k+1) once n is past k.
theorem CReal::roundings_le(n, k: Nat, far: k <= n): Rat::inv_pow2(n + 1) + Rat::inv_pow2(n + 1) <= Rat::inv_succ(k) {
    Rat::le_trans(Rat::le_of_same(Rat::inv_pow2_half(n)), Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_antitone(k, n, far)))
}

// The embedding preserves and reflects the strict order: a rational gap
// q - p is above some 1/(k+1) (`Rat::archimedean_inv`), and the images'
// terms are within a rounding of p and q, which far enough out leaves half
// the gap (`lt_of_term`).
theorem CReal::ofRat_lt({p, q: Rat}, h: p < q): CReal::ofRat(p) < CReal::ofRat(q) {
    match (q - p).archimedean_inv(Rat::sub_pos(h)) {
        Exists(k, small) => {
            let k2 = k + k + 1;
            let n = 16 * k + 15;
            let e = Rat::inv_pow2(n + 1);
            let half = Rat::inv_succ(k2);
            let below: (Rat::inv_succ(k) < q - p) = small;
            let far: (k2 <= n) = omega;
            let wide = calc {
                p + (half + (e + e)) <= p + (half + half) := (half + (e + e)).add_le_mono_l(half + half, p, (e + e).add_le_mono_l(half, half, CReal::roundings_le(n, k2, far))),
                ≈ p + Rat::inv_succ(k) := Rat::add_respects(p.same_refl(), Rat::inv_succ_half(k)),
                <= p + (q - p) := Rat::inv_succ(k).add_le_mono_l(q - p, p, Rat::le_of_lt(below)),
                ≈ q := p.add_sub_self(q),
            };
            CReal::ofRat(p).lt_of_term(CReal::ofRat(q), k, n, n.le_refl(),
                Rat::le_of_close_gap(Rat::le_add_of_dist(CReal::ofRat_close(p, n)), Rat::le_add_of_dist(CReal::ofRat_close_r(q, n)), wide))
        },
    }
}

theorem CReal::lt_of_ofRat_lt({p, q: Rat}, h: CReal::ofRat(p) < CReal::ofRat(q)): p < q {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let n = s.max(k2);
                let a = CReal::ofRat(p).at(n);
                let b = CReal::ofRat(q).at(n);
                let e = Rat::inv_pow2(n + 1);
                let step = Rat::inv_succ(k);
                let half = Rat::inv_succ(k2);
                let strict: (half < step) = Rat::inv_succ_half_lt(k);
                let pa: (p <= a + e) = Rat::le_add_of_dist(CReal::ofRat_close_r(p, n));
                let bq: (b <= q + e) = Rat::le_add_of_dist(CReal::ofRat_close(q, n));
                let reach = calc {
                    p + step <= (a + e) + step := p.add_le_mono_r(a + e, step, pa),
                    ≈ (a + step) + e := Rat::same_trans(a.add_assoc(e, step), Rat::same_trans(Rat::add_respects(a.same_refl(), e.add_comm(step)), Rat::same_sym(a.add_assoc(step, e)))),
                    <= b + e := (a + step).add_le_mono_r(b, e, gap(n, s.le_max_l(k2))),
                    <= (q + e) + e := b.add_le_mono_r(q + e, e, bq),
                    ≈ q + (e + e) := q.add_assoc(e, e),
                    <= q + half := (e + e).add_le_mono_l(half, q, CReal::roundings_le(n, k2, s.le_max_r(k2))),
                };
                Rat::lt_of_not_le(λ qp => Rat::not_le_of_lt(calc {
                    q + half ≈ half + q := q.add_comm(half),
                    < step + p := Rat::add_lt_mono(strict, qp),
                    ≈ p + step := step.add_comm(p),
                }, reach))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The inverse of a real apart from zero. Apartness gives a gap: from some
// index `start` on, the terms are at least 1/(k+1) in size, on one side
// (`Away`). There a reciprocal moves by at most (k+1)² times what it inverts
// (`Rat::dist_recip_le`), so the inverse reads x at index (k+1)²(n+1) + n, or
// at `start` if that is later: the (k+1)² comes out of the rate there
// (`Rat::scale_inv_succ_le`). The gap is data, read off the apartness proof
// (`away_of_apart`), so the inverse computes; every law is proved for an
// arbitrary gap first (`inv_gap`), so two apartness proofs with different
// gaps give `≈` inverses.

fn CReal::Away(x: CReal, k, start: Nat) → Type {
    (n: Nat) → start <= n → Rat::inv_succ(k) <= x.at(n).abs()
}

theorem CReal::away_of_apart(self x: CReal, h: x.Apart(0)): ∃ k: Nat, ∃ start: Nat, x.Away(k, start) {
    match h {
        Inl(below) => match below {
            Exists(k, rest) => match rest {
                Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_abs_of_add_le_zero(Rat::le_trans(gap(n, from), Rat::le_of_same(CReal::zero_at(n)))))),
            },
        },
        Inr(above) => match above {
            Exists(k, rest) => match rest {
                Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_abs_of_zero_add_le(
                    Rat::le_respects(Rat::add_respects(CReal::zero_at(n), Rat::inv_succ(k).same_refl()), x.at(n).same_refl(), gap(n, from))))),
            },
        },
    }
}

// Where the inverse reads x: past the gap's start, and far enough out for
// the reciprocal's (k+1)² to fit inside 2^-(n+1): its bit width further.
fn CReal::inv_bits(k: Nat) → Nat { ((k + 1) * (k + 1)).width() }

fn CReal::inv_at(k, start, n: Nat) → Nat { start.max((n + 1) + CReal::inv_bits(k)) }

theorem CReal::inv_at_start(k, start, n: Nat): start <= CReal::inv_at(k, start, n) {
    start.le_max_l((n + 1) + CReal::inv_bits(k))
}

theorem CReal::inv_at_far(k, start, n: Nat): (n + 1) + CReal::inv_bits(k) <= CReal::inv_at(k, start, n) {
    start.le_max_r((n + 1) + CReal::inv_bits(k))
}

theorem CReal::inv_at_ge(k, start, n: Nat): n <= CReal::inv_at(k, start, n) {
    n.le_trans((n + 1) + CReal::inv_bits(k), CReal::inv_at(k, start, n),
        n.le_trans(n + 1, (n + 1) + CReal::inv_bits(k), n.le_succ_r(n, n.le_refl()), (n + 1).le_add_l(CReal::inv_bits(k))), CReal::inv_at_far(k, start, n))
}

// (k+1)² times a step at the inverse's index is at most 2^-(n+1).
theorem CReal::inv_scale(k, start, n: Nat): Rat::ofInt(OfNat((k + 1) * (k + 1))) * Rat::inv_pow2(CReal::inv_at(k, start, n)) <= Rat::inv_pow2(n + 1) {
    let w = CReal::inv_bits(k);
    let sq = (k + 1) * (k + 1);
    let top: (sq <= Nat::pow(2, w)) = sq.le_of_lt(Nat::pow(2, w), sq.lt_pow_width());
    calc {
        Rat::ofInt(OfNat(sq)) * Rat::inv_pow2(CReal::inv_at(k, start, n)) <= Rat::ofInt(Nat::pow(2, w).int()) * Rat::inv_pow2((n + 1) + w)
            := Rat::mul_le_mul(Rat::ofInt_le(OfNat(sq), OfNat(Nat::pow(2, w)), top), Rat::inv_pow2_antitone((n + 1) + w, CReal::inv_at(k, start, n), CReal::inv_at_far(k, start, n)),
                Rat::ofNat_nonneg(sq), Rat::inv_pow2_nonneg(CReal::inv_at(k, start, n))),
        ≈ Rat::inv_pow2(n + 1) := Rat::scale_inv_pow2(w, n + 1),
    }
}

// Both terms are past the gap's start, so their reciprocals are within (k+1)²
// times their distance, and each index pays for its own (k+1)².
theorem CReal::inv_regular(self x: CReal, k, start: Nat, gap: x.Away(k, start), m, n: Nat):
    (x.at(CReal::inv_at(k, start, m)).recip() - x.at(CReal::inv_at(k, start, n)).recip()).abs()
        <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1)
{
    let a = CReal::inv_at(k, start, m);
    let b = CReal::inv_at(k, start, n);
    let sq = (k + 1) * (k + 1);
    let big = Rat::ofInt(OfNat(sq));
    let fa = Rat::inv_pow2(a);
    let fb = Rat::inv_pow2(b);
    calc {
        (x.at(a).recip() - x.at(b).recip()).abs() <= big * (x.at(a) - x.at(b)).abs()
            := Rat::dist_recip_le(k, k, gap(a, CReal::inv_at_start(k, start, m)), gap(b, CReal::inv_at_start(k, start, n))),
        <= big * (fa + fb) := Rat::mul_le_mono_l(x.regular(a, b), Rat::ofNat_nonneg(sq)),
        ≈ big * fa + big * fb := big.mul_add_distr(fa, fb),
        <= Rat::inv_pow2(m + 1) + Rat::inv_pow2(n + 1) := Rat::add_le_mono(CReal::inv_scale(k, start, m), CReal::inv_scale(k, start, n)),
    }
}

fn CReal::inv_gap(self x: CReal, k, start: Nat, gap: x.Away(k, start)) → CReal {
    CReal::rounded(λ n => x.at(CReal::inv_at(k, start, n)).recip(), λ m n => x.inv_regular(k, start, gap, m, n))
}

theorem CReal::inv_term(self x: CReal, k, start: Nat, gap: x.Away(k, start), n: Nat):
    (x.inv_gap(k, start, gap).at(n) - x.at(CReal::inv_at(k, start, n)).recip()).abs() <= Rat::inv_pow2(n + 1)
{
    Dyadic::floor_rat_close(x.at(CReal::inv_at(k, start, n)).recip(), n + 1)
}

theorem CReal::inv_term_r(self x: CReal, k, start: Nat, gap: x.Away(k, start), n: Nat):
    (x.at(CReal::inv_at(k, start, n)).recip() - x.inv_gap(k, start, gap).at(n)).abs() <= Rat::inv_pow2(n + 1)
{
    Rat::le_trans(Rat::le_of_same(x.at(CReal::inv_at(k, start, n)).recip().abs_sub_comm(x.inv_gap(k, start, gap).at(n))), x.inv_term(k, start, gap, n))
}

// `x⁻¹` is this with `h` searched at the call
// (docs/inverse-power-notation-design.md): a local apartness, a local
// `0 < x` or `x < 0` (`apart_of_positive`), or a rational apart from zero
// (`ofRat_apart`).
fn CReal::inv(self x: CReal, h: x.Apart(0) := infer) → CReal {
    let g = x.away_of_apart(h);
    x.inv_gap(g.witness, g.proof.witness, g.proof.proof)
}

designation postfix ⁻¹ at CReal := CReal::inv

// `≈` reals with gaps (k, s) and (l, t): far enough out, the terms each
// inverse reads are within 1/((k+1)(l+1)(K+1)) of each other, wherever the
// two gaps put them, and the reciprocals within 1/(K+1).
theorem CReal::inv_gap_respects({x, x2: CReal}, hx: x ≈ x2, k, s: Nat, gap: x.Away(k, s), l, t: Nat, gap2: x2.Away(l, t)):
    x.inv_gap(k, s, gap) ≈ x2.inv_gap(l, t, gap2)
{
    x.inv_gap(k, s, gap).same_of_approx(x2.inv_gap(l, t, gap2), λ n => x.at(CReal::inv_at(k, s, n)).recip(), λ n => x2.at(CReal::inv_at(l, t, n)).recip(),
        λ n => x.inv_term(k, s, gap, n), λ n => x2.inv_term_r(l, t, gap2, n),
        λ K => {
            let p = (k + 1) * (l + 1);
            let j = p * (K + 1) + K;
            match CReal::same_close_far(hx, j) {
                Exists(r, close) => Exists(r, λ n from => {
                    let a = CReal::inv_at(k, s, n);
                    let b = CReal::inv_at(l, t, n);
                    let near: ((x.at(a) - x2.at(b)).abs() <= Rat::inv_succ(j)) =
                        close(a, b, r.le_trans(n, a, from, CReal::inv_at_ge(k, s, n)), r.le_trans(n, b, from, CReal::inv_at_ge(l, t, n)));
                    calc {
                        (x.at(a).recip() - x2.at(b).recip()).abs() <= Rat::ofInt(OfNat(p)) * (x.at(a) - x2.at(b)).abs()
                            := Rat::dist_recip_le(k, l, gap(a, CReal::inv_at_start(k, s, n)), gap2(b, CReal::inv_at_start(l, t, n))),
                        <= Rat::inv_succ(K) := Rat::scale_inv_succ_le(p, j, K, j.le_refl(), near),
                    }
                }),
            }
        })
}

// x * x⁻¹ reads x at a and the inverse at a, a rounding of the reciprocal
// of x at b further out. The term x_b · x_b⁻¹ is exactly 1, so the product's
// distance from 1 is x_b⁻¹ (at most k+1) times x_a - x_b, which regularity
// makes small, plus x_a times the rounding, which the bound makes small.
theorem CReal::mul_inv_gap(self x: CReal, k, s: Nat, gap: x.Away(k, s)): x * x.inv_gap(k, s, gap) ≈ 1 {
    let y = x.inv_gap(k, s, gap);
    (x * y).same_of_approx(1, λ n => x.at(x.mul_at(y, n)) * y.at(x.mul_at(y, n)), λ n => 1, λ n => x.mul_term(y, n),
        λ n => {
            let o: Rat = 1;
            calc {
                (o - CReal::at(1, n)).abs() ≈ (o - o).abs() := Rat::abs_respects(Rat::sub_respects(o.same_refl(), CReal::one_at(n))),
                ≈ 0 := o.abs_sub_self(),
                <= Rat::inv_pow2(n + 1) := Rat::inv_pow2_nonneg(n + 1),
            }
        },
        λ K => {
            let K2 = K + K + 1;
            let j = (k + 1) * (K2 + 1) + K2;
            let l = x.bound();
            let edge = l * (K2 + 1) + K2;
            let start = (j + j + 1).max(edge);
            Exists(start, λ n from => {
                let a = x.mul_at(y, n);
                let b = CReal::inv_at(k, s, a);
                let at_a: (start <= a) = start.le_trans(n, a, from, x.mul_at_ge(y, n));
                let at_j: (j + j + 1 <= a) = (j + j + 1).le_trans(start, a, (j + j + 1).le_max_l(edge), at_a);
                let at_b: (j + j + 1 <= b) = (j + j + 1).le_trans(a, b, at_j, CReal::inv_at_ge(k, s, a));
                let far: (edge <= a + 1) = edge.le_trans(a, a + 1, edge.le_trans(start, a, (j + j + 1).le_max_r(edge), at_a), a.le_succ_r(a, a.le_refl()));
                let away: (Rat::inv_succ(k) <= x.at(b).abs()) = gap(b, CReal::inv_at_start(k, s, a));
                let u = x.at(b).recip();
                let d = x.at(a) - x.at(b);
                let near: (d.abs() <= Rat::inv_succ(j)) = x.regular_close(j, a, b, at_j, at_b);
                let main: ((x.at(a) * u - 1).abs() <= Rat::inv_succ(K2)) = calc {
                    (x.at(a) * u - 1).abs() ≈ (u * d).abs()
                        := Rat::abs_respects(Rat::mul_sub_one_of_inverse(x.at(b).mul_recip(Rat::nonzero_of_gap(k, away)))),
                    ≈ u.abs() * d.abs() := u.abs_mul(d),
                    <= Rat::ofInt(OfNat(k + 1)) * d.abs() := Rat::mul_le_mono_r(Rat::recip_abs_le(k, away), d.abs_nonneg()),
                    <= Rat::inv_succ(K2) := Rat::scale_inv_succ_le(k + 1, j, K2, j.le_refl(), near),
                };
                let round: ((x.at(a) * y.at(a) - x.at(a) * u).abs() <= Rat::inv_succ(K2)) = Rat::le_trans(Rat::le_of_same(Rat::abs_respects(Rat::same_trans(
                    Rat::same_sym(Rat::mul_sub(x.at(a), y.at(a), u)), x.at(a).mul_comm(y.at(a) - u)))),
                    CReal::edge_le(l, K2, a + 1, x.bound_le(a), far, x.inv_term(k, s, gap, a)));
                calc {
                    (x.at(a) * y.at(a) - 1).abs() <= (x.at(a) * y.at(a) - x.at(a) * u).abs() + (x.at(a) * u - 1).abs() := (x.at(a) * y.at(a)).dist_triangle(x.at(a) * u, 1),
                    <= Rat::inv_succ(K2) + Rat::inv_succ(K2) := Rat::add_le_mono(round, main),
                    ≈ Rat::inv_succ(K) := Rat::inv_succ_half(K),
                }
            })
        })
}

// The laws at an apartness proof: whichever gaps the two proofs carry.
theorem CReal::inv_respects({x, x2: CReal}, hx: x ≈ x2, h: x.Apart(0) := infer, h2: x2.Apart(0) := infer):
    x⁻¹ ≈ x2⁻¹
{
    let g = x.away_of_apart(h);
    let g2 = x2.away_of_apart(h2);
    CReal::inv_gap_respects(hx, g.witness, g.proof.witness, g.proof.proof, g2.witness, g2.proof.witness, g2.proof.proof)
}

theorem CReal::mul_inv(self x: CReal, h: x.Apart(0) := infer): x * x⁻¹ ≈ 1 {
    let g = x.away_of_apart(h);
    x.mul_inv_gap(g.witness, g.proof.witness, g.proof.proof)
}

theorem CReal::inv_mul(self x: CReal, h: x.Apart(0) := infer): x⁻¹ * x ≈ 1 {
    CReal::same_trans(x⁻¹.mul_comm(x), x.mul_inv())
}

// A rational apart from zero is a real apart from zero.
evidence theorem CReal::ofRat_apart({q: Rat}, h: q.Apart(0) := infer): CReal::ofRat(q).Apart(0) {
    match h {
        Inl(lt) => Inl(CReal::ofRat_lt(lt)),
        Inr(gt) => Inr(CReal::ofRat_lt(gt)),
    }
}

// The embedding commutes with the inverse: ofRat(q⁻¹) is a right inverse of
// ofRat(q) (the embedding is multiplicative), and right inverses are the
// inverse.
theorem CReal::ofRat_inv(q: Rat, h: q.Apart(0) := infer): CReal::ofRat(q)⁻¹ ≈ CReal::ofRat(q⁻¹) {
    let x = CReal::ofRat(q);
    let y = CReal::ofRat(q⁻¹);
    let xy: (x * y ≈ 1) = CReal::same_trans(CReal::same_sym(CReal::ofRat_mul(q, q⁻¹)), CReal::ofRat_respects(q.mul_inv()));
    calc {
        x⁻¹ ≈ x⁻¹ * 1 := CReal::same_sym(x⁻¹.mul_one()),
        ≈ x⁻¹ * (x * y) := CReal::mul_respects(x⁻¹.same_refl(), CReal::same_sym(xy)),
        ≈ (x⁻¹ * x) * y := CReal::same_sym(x⁻¹.mul_assoc(x, y)),
        ≈ 1 * y := CReal::mul_respects(x.inv_mul(), y.same_refl()),
        ≈ y * 1 := CReal::mul_comm(1, y),
        ≈ y := y.mul_one(),
    }
}

// ---------------------------------------------------------------------------
// The non-strict order, Bishop's: x ≤ y when y < x is refuted. It carries no
// data and is defined from `<`, never the reverse. Its laws come from
// cotransitivity: a gap below x, placed against y, lands on one side of y or
// the other. Its antisymmetry modulo `≈` is tightness.

fn CReal::Le(x, y: CReal) → Type { ¬(y < x) }

designation <= at CReal := CReal::Le

theorem CReal::le_refl(self x: CReal): x <= x { x.lt_irrefl() }

theorem CReal::le_of_lt({x, y: CReal}, h: x < y): x <= y { λ back => x.lt_irrefl(CReal::lt_trans(h, back)) }

theorem CReal::le_of_same({x, y: CReal}, h: x ≈ y): x <= y {
    λ back => y.lt_irrefl(CReal::lt_respects(y.same_refl(), h, back))
}

// z < x places y: z < y or y < x, and each is refuted.
theorem CReal::le_trans({x, y, z: CReal}, hxy: x <= y, hyz: y <= z): x <= z {
    λ zx => match z.lt_cotrans(x, y, zx) {
        Inl(zy) => hyz(zy),
        Inr(yx) => hxy(yx),
    }
}

theorem CReal::lt_of_lt_of_le({x, y, z: CReal}, h1: x < y, h2: y <= z): x < z {
    match x.lt_cotrans(y, z, h1) {
        Inl(xz) => xz,
        Inr(zy) => absurd_of(zy, h2),
    }
}

theorem CReal::lt_of_le_of_lt({x, y, z: CReal}, h1: x <= y, h2: y < z): x < z {
    match y.lt_cotrans(z, x, h2) {
        Inl(yx) => absurd_of(yx, h1),
        Inr(xz) => xz,
    }
}

// Reals each below the other are not apart, so they are the same.
theorem CReal::le_antisymm({x, y: CReal}, hxy: x <= y, hyx: y <= x): x ≈ y {
    CReal::same_of_not_apart(λ apart => match apart {
        Inl(lt) => hyx(lt),
        Inr(gt) => hxy(gt),
    })
}

theorem CReal::le_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, h: x <= y): x2 <= y2 {
    λ back => h(CReal::lt_respects(CReal::same_sym(hy), CReal::same_sym(hx), back))
}

// One side replaced by one it is `≈` to, the `≈` premise first: the shape a
// tactic applies when it knows the replacement before the order (`mono`'s
// cast step, lib/std/tactic/mono.hthr).
theorem CReal::le_of_same_l({x, y, z: CReal}, e: x ≈ y, h: y <= z): x <= z { CReal::le_respects(CReal::same_sym(e), z.same_refl(), h) }

theorem CReal::le_of_same_r({x, y, z: CReal}, e: z ≈ y, h: x <= y): x <= z { CReal::le_respects(x.same_refl(), CReal::same_sym(e), h) }

theorem CReal::lt_of_same_l({x, y, z: CReal}, e: x ≈ y, h: y < z): x < z { CReal::lt_respects(CReal::same_sym(e), z.same_refl(), h) }

theorem CReal::lt_of_same_r({x, y, z: CReal}, e: z ≈ y, h: x < y): x < z { CReal::lt_respects(x.same_refl(), CReal::same_sym(e), h) }

// The embedding preserves and reflects `≤`, through `<` both ways.
theorem CReal::ofRat_le({p, q: Rat}, h: p <= q): CReal::ofRat(p) <= CReal::ofRat(q) {
    λ back => Rat::not_le_of_lt(CReal::lt_of_ofRat_lt(back), h)
}

theorem CReal::le_of_ofRat_le({p, q: Rat}, h: CReal::ofRat(p) <= CReal::ofRat(q)): p <= q {
    Rat::le_of_not_lt(λ below => h(CReal::ofRat_lt(below)))
}

// The rationals inside the reals, as a cast edge (docs/casting-design.md
// §5.6). A numeral at `CReal` is the rational numeral embedded, so `0` and
// `1` are preserved by reflexivity.
fn CReal::ofRat_hom() → OrderedRingHom<Rat, CReal>(CReal::ofRat,
        Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul, Rat::neg, 0, 1,
        CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul, CReal::neg, 0, 1) {
    OrderedRingHom {
        map_respects: λ p q h => CReal::ofRat_respects(h),
        map_zero: CReal::same_refl(0),
        map_one: CReal::same_refl(1),
        map_add: λ p q => CReal::ofRat_add(p, q),
        map_mul: λ p q => CReal::ofRat_mul(p, q),
        map_neg: λ q => CReal::ofRat_neg(q),
        map_le: λ p q h => CReal::ofRat_le(h),
        map_lt: λ p q h => CReal::ofRat_lt(h),
        le_of_map: λ p q h => CReal::le_of_ofRat_le(h),
        lt_of_map: λ p q h => CReal::lt_of_ofRat_lt(h),
    }
}

instance Cast<Rat, CReal>(CReal::ofRat) { }

instance Preorder<CReal>(CReal::Le) {
    rel_refl := CReal::le_refl,
    rel_trans := λ x y z hxy hyz => CReal::le_trans(hxy, hyz),
}

// `<` absorbs `≤` on either side, and `≈` is absorbed by `≤`, so a `calc`
// chain may mix all three.
instance Trans<CReal>(CReal::Le, CReal::Lt, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_of_le_of_lt(hxy, hyz),
}

instance Trans<CReal>(CReal::Lt, CReal::Le, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_of_lt_of_le(hxy, hyz),
}

instance Trans<CReal>(CReal::Same, CReal::Le, CReal::Le) {
    rel_chain := λ x y z hxy hyz => CReal::le_trans(CReal::le_of_same(hxy), hyz),
}

instance Trans<CReal>(CReal::Le, CReal::Same, CReal::Le) {
    rel_chain := λ x y z hxy hyz => CReal::le_trans(hxy, CReal::le_of_same(hyz)),
}

// ---------------------------------------------------------------------------
// Order and addition. A sum reads both summands at index n+1, so adding z
// to both sides of x < y adds the same rational to both terms there, and x's
// gap below y is the sums' gap from the same start. Cancellation adds -z,
// `≤` follows by refutation, and cotransitivity splits a gap between sums
// into a gap between one pair of summands (Bishop's form of "a sum is
// positive only if a summand is").

theorem CReal::add_lt_mono_r(self x, y, z: CReal, h: x < y): x + z < y + z {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => Exists(k, Exists(s, λ n from => {
                let i = n + 1;
                let at_i: (s <= i) = s.le_succ_r(n, from);
                let a = x.at(i);
                let c = z.at(i);
                let step = Rat::inv_succ(k);
                calc {
                    (x + z).at(n) + step ≈ (a + c) + step := Rat::add_respects(x.add_at(z, n), step.same_refl()),
                    ≈ a + (c + step) := a.add_assoc(c, step),
                    ≈ a + (step + c) := Rat::add_respects(a.same_refl(), c.add_comm(step)),
                    ≈ (a + step) + c := Rat::same_sym(a.add_assoc(step, c)),
                    <= y.at(i) + c := (a + step).add_le_mono_r(y.at(i), c, gap(i, at_i)),
                    ≈ (y + z).at(n) := Rat::same_sym(y.add_at(z, n)),
                }
            })),
        },
    }
}

theorem CReal::add_lt_mono_l(self x, y, z: CReal, h: x < y): z + x < z + y {
    calc {
        z + x ≈ x + z := z.add_comm(x),
        < y + z := x.add_lt_mono_r(y, z, h),
        ≈ z + y := y.add_comm(z),
    }
}

theorem CReal::add_lt_mono({x, x2, y, y2: CReal}, hx: x < x2, hy: y < y2): x + y < x2 + y2 {
    CReal::lt_trans(x.add_lt_mono_r(x2, y, hx), y.add_lt_mono_l(y2, x2, hy))
}

theorem CReal::add_neg_cancel_r(self x, y: CReal): (x + y) + -y ≈ x {
    calc {
        (x + y) + -y ≈ x + (y + -y) := x.add_assoc(y, -y),
        ≈ x + 0 := CReal::add_respects(x.same_refl(), y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

theorem CReal::add_lt_cancel_r(self x, y, z: CReal, h: x + z < y + z): x < y {
    calc {
        x ≈ (x + z) + -z := CReal::same_sym(x.add_neg_cancel_r(z)),
        < (y + z) + -z := (x + z).add_lt_mono_r(y + z, -z, h),
        ≈ y := y.add_neg_cancel_r(z),
    }
}

theorem CReal::add_lt_cancel_l(self x, y, z: CReal, h: z + x < z + y): x < y {
    x.add_lt_cancel_r(y, z, calc {
        x + z ≈ z + x := x.add_comm(z),
        < z + y := h,
        ≈ y + z := z.add_comm(y),
    })
}

theorem CReal::add_le_mono_r(self x, y, z: CReal, h: x <= y): x + z <= y + z {
    λ back => h(y.add_lt_cancel_r(x, z, back))
}

theorem CReal::add_le_mono_l(self x, y, z: CReal, h: x <= y): z + x <= z + y {
    λ back => h(y.add_lt_cancel_l(x, z, back))
}

theorem CReal::add_le_mono({x, x2, y, y2: CReal}, hx: x <= x2, hy: y <= y2): x + y <= x2 + y2 {
    CReal::le_trans(x.add_le_mono_r(x2, y, hx), y.add_le_mono_l(y2, x2, hy))
}

theorem CReal::add_lt_le_mono({x, x2, y, y2: CReal}, hx: x < x2, hy: y <= y2): x + y < x2 + y2 {
    CReal::lt_of_lt_of_le(x.add_lt_mono_r(x2, y, hx), y.add_le_mono_l(y2, x2, hy))
}

theorem CReal::add_le_lt_mono({x, x2, y, y2: CReal}, hx: x <= x2, hy: y < y2): x + y < x2 + y2 {
    CReal::lt_of_le_of_lt(x.add_le_mono_r(x2, y, hx), y.add_lt_mono_l(y2, x2, hy))
}

theorem CReal::add_lt_cancel({x, x2, y, y2: CReal}, h: x + y < x2 + y2): x < x2 ∨ y < y2 {
    match (x + y).lt_cotrans(x2 + y2, x2 + y, h) {
        Inl(left) => Inl(x.add_lt_cancel_r(x2, y, left)),
        Inr(right) => Inr(y.add_lt_cancel_l(y2, x2, right)),
    }
}

// Signs of a sum.
theorem CReal::zero_add_zero(): CReal::Same(0 + 0, 0) { CReal::add_zero(0) }

theorem CReal::add_pos({x, y: CReal}, hx: 0 < x, hy: 0 < y): 0 < x + y {
    CReal::lt_respects(CReal::zero_add_zero(), (x + y).same_refl(), CReal::add_lt_mono(hx, hy))
}

theorem CReal::add_pos_of_nonneg_of_pos({x, y: CReal}, hx: 0 <= x, hy: 0 < y): 0 < x + y {
    CReal::lt_respects(CReal::zero_add_zero(), (x + y).same_refl(), CReal::add_le_lt_mono(hx, hy))
}

theorem CReal::add_nonneg({x, y: CReal}, hx: 0 <= x, hy: 0 <= y): 0 <= x + y {
    CReal::le_respects(CReal::zero_add_zero(), (x + y).same_refl(), CReal::add_le_mono(hx, hy))
}

theorem CReal::pos_of_add_pos({x, y: CReal}, h: 0 < x + y): 0 < x ∨ 0 < y {
    CReal::add_lt_cancel(CReal::lt_respects(CReal::same_sym(CReal::zero_add_zero()), (x + y).same_refl(), h))
}

// ---------------------------------------------------------------------------
// Bishop's order. Bishop reads x ≤ y pointwise, as x_n ≤ y_n + twice the
// rate at every n, here 2^-n + 2^-n, and it agrees with `≤` as the
// refutation of `>`. A gap of 1/(k+1) with y below x would contradict the
// pointwise bound once twice the rate is under it. Conversely, x_n above
// y_n + 2^-n + 2^-n by some 1/(j+1) leaves a gap
// further out, after regularity moves both terms, and `lt_of_term` turns it
// into y < x; so every such excess is refuted and vanishes.

fn CReal::BishopLe(x, y: CReal) → Type {
    (n: Nat) → x.at(n) <= y.at(n) + (Rat::inv_pow2(n) + Rat::inv_pow2(n))
}

theorem CReal::le_of_bishop({x, y: CReal}, h: x.BishopLe(y)): x <= y {
    λ back => match back {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let k4 = k2 + k2 + 1;
                let n = s.max(k4);
                let a = y.at(n);
                let fine = Rat::inv_pow2(n);
                let step = Rat::inv_succ(k);
                let le_q: (fine <= Rat::inv_succ(k4)) = Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_antitone(k4, n, s.le_max_r(k4)));
                let strict: (Rat::inv_succ(k2) < step) = omega;
                let small: (fine + fine < step) = calc {
                    fine + fine <= Rat::inv_succ(k4) + Rat::inv_succ(k4) := Rat::add_le_mono(le_q, le_q),
                    ≈ Rat::inv_succ(k2) := Rat::inv_succ_half(k2),
                    < step := strict,
                };
                let swapped = calc {
                    step + a ≈ a + step := step.add_comm(a),
                    <= x.at(n) := gap(n, s.le_max_l(k4)),
                    <= a + (fine + fine) := h(n),
                    ≈ (fine + fine) + a := a.add_comm(fine + fine),
                };
                Rat::not_le_of_lt(small, step.add_le_cancel_r(fine + fine, a, swapped))
            },
        },
    }
}

theorem CReal::bishop_of_le({x, y: CReal}, h: x <= y): x.BishopLe(y) {
    λ n => {
        let fine = Rat::inv_pow2(n);
        let two = fine + fine;
        Rat::le_of_le_add_inv_succ(λ j => Rat::le_of_not_lt(λ above => {
            let j2 = j + j + 1;
            let k = j2;
            let q = Rat::inv_succ(k + k + 1);
            let m = 16 * k + 15;
            let at_m: (k + k + 1 <= m) = omega;
            let em: (Rat::inv_pow2(m) <= q) = Rat::le_trans(Rat::inv_pow2_le_inv_succ(m), Rat::inv_succ_antitone(k + k + 1, m, at_m));
            let e = fine + q;
            let ha: (y.at(m) <= y.at(n) + e) = Rat::le_add_of_dist(calc {
                (y.at(m) - y.at(n)).abs() ≈ (y.at(n) - y.at(m)).abs() := y.at(m).abs_sub_comm(y.at(n)),
                <= fine + Rat::inv_pow2(m) := y.regular(n, m),
                <= e := Rat::inv_pow2(m).add_le_mono_l(q, fine, em),
            });
            let hb: (x.at(n) <= x.at(m) + e) =
                Rat::le_add_of_dist(Rat::le_trans(x.regular(n, m), Rat::inv_pow2(m).add_le_mono_l(q, fine, em)));
            let spare: (q <= q + q) = q.le_add_nonneg(q, Rat::le_of_lt(Rat::inv_succ_pos(k + k + 1)));
            let a = y.at(n);
            let wide = calc {
                a + (q + (e + e)) ≈ a + (q + (two + (q + q))) := Rat::add_respects(a.same_refl(), Rat::add_respects(q.same_refl(), fine.add_add_add_comm(q, fine, q))),
                ≈ a + (two + (q + (q + q))) := Rat::add_respects(a.same_refl(), q.add_left_comm(two, q + q)),
                <= a + (two + ((q + q) + (q + q))) := (two + (q + (q + q))).add_le_mono_l(two + ((q + q) + (q + q)), a,
                    (q + (q + q)).add_le_mono_l((q + q) + (q + q), two, q.add_le_mono_r(q + q, q + q, spare))),
                ≈ a + (two + (Rat::inv_succ(j2) + Rat::inv_succ(j2))) := Rat::add_respects(a.same_refl(), Rat::add_respects(two.same_refl(), Rat::add_respects(Rat::inv_succ_half(k), Rat::inv_succ_half(k)))),
                ≈ a + (two + Rat::inv_succ(j)) := Rat::add_respects(a.same_refl(), Rat::add_respects(two.same_refl(), Rat::inv_succ_half(j))),
                ≈ (a + two) + Rat::inv_succ(j) := Rat::same_sym(a.add_assoc(two, Rat::inv_succ(j))),
                <= x.at(n) := Rat::le_of_lt(above),
            };
            h(y.lt_of_term(x, k, m, m.le_refl(), Rat::le_of_close_gap(ha, hb, wide)))
        }))
    }
}

// ---------------------------------------------------------------------------
// Signs, and integer powers (docs/inverse-power-notation-design.md), as at
// `Rat`. The sign predicates are the one-place premises of the apartness
// rules, so that the search through them shrinks its goal; a local
// `h: CReal::zero() < x` is one by conversion.

fn CReal::Positive(self x: CReal) → Type { 0 < x }
fn CReal::Negative(self x: CReal) → Type { x < 0 }

evidence theorem CReal::apart_of_positive({x: CReal}, h: x.Positive() := infer): x.Apart(0) { Inr(h) }
evidence theorem CReal::apart_of_negative({x: CReal}, h: x.Negative() := infer): x.Apart(0) { Inl(h) }

fn CReal::npow(self x: CReal, n: Nat) → CReal {
    match n {
        Zero => 1,
        Succ(k) => x.npow(k) * x,
    }
}

theorem CReal::npow_respects({x, x2: CReal}, hx: x ≈ x2, n: Nat): x.npow(n) ≈ x2.npow(n) {
    match n {
        Zero => CReal::same_refl(1),
        Succ(k) => CReal::mul_respects(CReal::npow_respects(hx, k), hx),
    }
}

theorem CReal::ofRat_npow(q: Rat, n: Nat): CReal::ofRat(q).npow(n) ≈ CReal::ofRat(q.npow(n)) {
    match n {
        Zero => CReal::same_refl(1),
        Succ(k) => CReal::same_trans(CReal::mul_respects(CReal::ofRat_npow(q, k), CReal::ofRat(q).same_refl()), CReal::same_sym(CReal::ofRat_mul(q.npow(k), q))),
    }
}

theorem CReal::npow_add(self x: CReal, m, n: Nat): x.npow(m + n) ≈ x.npow(m) * x.npow(n) {
    match n {
        Zero => CReal::same_sym(x.npow(m).mul_one()),
        Succ(k) => calc {
            x.npow(m + Succ(k)) ≈ x.npow(m + k) * x := (x.npow(m + k) * x).same_refl(),
            ≈ (x.npow(m) * x.npow(k)) * x := CReal::mul_respects(x.npow_add(m, k), x.same_refl()),
            ≈ x.npow(m) * (x.npow(k) * x) := x.npow(m).mul_assoc(x.npow(k), x),
        },
    }
}

// The side condition of an integer power: nothing at n ≥ 0, apartness from
// zero at n < 0. It computes, and the search reads what it computes to.
fn CReal::PowOk(x: CReal, n: Int) → Type {
    match n {
        OfNat(_) => True,
        NegSucc(_) => x.Apart(0),
    }
}

fn CReal::pow_parts(x: CReal, n: Int) → (x.PowOk(n) → CReal) {
    match n {
        OfNat(m) => λ _ => x.npow(m),
        NegSucc(k) => λ h => x.inv(h := h).npow(Succ(k)),
    }
}

fn CReal::pow(self x: CReal, n: Int, h: x.PowOk(n) := infer) → CReal { CReal::pow_parts(x, n, h) }

designation ^ at CReal := CReal::pow

theorem CReal::pow_ofNat(self x: CReal, n: Nat): x ^ OfNat(n) = x.npow(n) { refl }

theorem CReal::pow_negSucc(self x: CReal, k: Nat, h: x.Apart(0) := infer): x ^ NegSucc(k) = x⁻¹.npow(Succ(k)) { refl }

theorem CReal::pow_zero(self x: CReal): x ^ 0 ≈ 1 { CReal::same_refl(1) }

theorem CReal::pow_one(self x: CReal): x ^ 1 ≈ x { CReal::same_trans(CReal::mul_comm(1, x), x.mul_one()) }

theorem CReal::pow_two(self x: CReal): x ^ 2 ≈ x * x { CReal::mul_respects(x.pow_one(), x.same_refl()) }

// The inverse is the power at -1.
theorem CReal::pow_neg_one(self x: CReal, h: x.Apart(0) := infer): x ^ (-1) ≈ x⁻¹ { x⁻¹.pow_one() }

// ---------------------------------------------------------------------------
// Order and multiplication (docs/creal-mul-order-round.md). A product's
// term is its factors' product at one index a, at or past its own, within a
// rounding. A positive product needs no estimate beyond that: past both
// gaps' starts each factor is at least its gap, the product of the terms
// clears zero by the product of the gaps, and the rounding costs half of it
// once the index is far enough out. A nonnegative product goes through
// Bishop's form: each factor falls short of zero by at most 2^-a + 2^-a at
// the index a it is read at, and the shortfall of the product, scaled by the
// bound 2^b, is the 2^-(n+1) the product's index was chosen to absorb; with
// the rounding, 2^-n, too small for any gap below zero. The monotone forms
// are those two signs applied to the difference: y*z - x*z ≈ (y - x)*z.

// A sign read off `0 < x` or `x < 0` as a bound on x's own terms.
theorem CReal::pos_gap({x: CReal}, h: 0 < x): ∃ k: Nat, ∃ start: Nat, (n: Nat) → start <= n → Rat::inv_succ(k) <= x.at(n) {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_trans(
                Rat::le_of_same(Rat::same_sym(Rat::same_trans(Rat::add_respects(CReal::zero_at(n), Rat::inv_succ(k).same_refl()), Rat::zero_add(Rat::inv_succ(k))))),
                gap(n, from)))),
        },
    }
}

theorem CReal::neg_gap({x: CReal}, h: x < 0): ∃ k: Nat, ∃ start: Nat, (n: Nat) → start <= n → x.at(n) + Rat::inv_succ(k) <= 0 {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_trans(gap(n, from), Rat::le_of_same(CReal::zero_at(n))))),
        },
    }
}

// One term far enough out at least 1/(2k+2) makes a real positive.
theorem CReal::pos_of_term(self x: CReal, k, n: Nat, far: 16 * k + 15 <= n, h: Rat::inv_succ(k + k + 1) <= x.at(n)): 0 < x {
    let half = Rat::inv_succ(k + k + 1);
    CReal::lt_of_term(0, x, k, n, far, Rat::le_trans(
        Rat::le_of_same(Rat::same_trans(Rat::add_respects(CReal::zero_at(n), half.same_refl()), Rat::zero_add(half))), h))
}

// A rational at least 1/(j+1), within a rounding at a far index n of p,
// leaves p at least 1/(2j+2).
theorem CReal::half_below({p, r: Rat}, j, n: Nat, far: j + j + 1 <= n, hp: Rat::inv_succ(j) <= r, hr: (r - p).abs() <= Rat::inv_pow2(n + 1)):
    Rat::inv_succ(j + j + 1) <= p
{
    let half = Rat::inv_succ(j + j + 1);
    let e = Rat::inv_pow2(n + 1);
    let small: (e <= half) = Rat::le_trans(CReal::half_le(n), Rat::le_trans(Rat::inv_pow2_le_inv_succ(n), Rat::inv_succ_antitone(j + j + 1, n, far)));
    half.add_le_cancel_r(p, half, calc {
        half + half ≈ Rat::inv_succ(j) := Rat::inv_succ_half(j),
        <= r := hp,
        <= p + e := Rat::le_add_of_dist(hr),
        <= p + half := e.add_le_mono_l(half, p, small),
    })
}

theorem CReal::mul_pos({x, y: CReal}, hx: 0 < x, hy: 0 < y): 0 < x * y {
    match CReal::pos_gap(hx) {
        Exists(k, rx) => match rx {
            Exists(s, gx) => match CReal::pos_gap(hy) {
                Exists(l, ry) => match ry {
                    Exists(t, gy) => {
                        let m = k * (l + 1) + l;
                        let n = s.max(t).max(16 * m + 15);
                        let a = x.mul_at(y, n);
                        let far: (16 * m + 15 <= n) = s.max(t).le_max_r(16 * m + 15);
                        let near: (m + m + 1 <= n) = omega;
                        let at_a: (s.max(t) <= a) = s.max(t).le_trans(n, a, s.max(t).le_max_l(16 * m + 15), x.mul_at_ge(y, n));
                        let at_s: (s <= a) = s.le_trans(s.max(t), a, s.le_max_l(t), at_a);
                        let at_t: (t <= a) = t.le_trans(s.max(t), a, s.le_max_r(t), at_a);
                        let fk = Rat::inv_succ(k);
                        let fl = Rat::inv_succ(l);
                        let prod: (Rat::inv_succ(m) <= x.at(a) * y.at(a)) = Rat::le_trans(Rat::le_of_same(Rat::same_sym(Rat::inv_succ_mul(k, l))),
                            Rat::mul_le_mul(gx(a, at_s), gy(a, at_t), Rat::le_of_lt(Rat::inv_succ_pos(k)), Rat::le_of_lt(Rat::inv_succ_pos(l))));
                        (x * y).pos_of_term(m, n, far, CReal::half_below(m, n, near, prod, x.mul_term_r(y, n)))
                    },
                },
            },
        },
    }
}

// A positive factor reflects the product's sign. The product reads both
// factors at one index a; past both gaps' starts its term is at least
// 1/(j+1), so x_a · y_a is at least 1/(2j+2) after the rounding, and x_a
// lies in (0, l+1], l the bound of x, so y_a is at least 1/((l+1)(2j+2))
// (`Rat::le_of_mul_le_bounded`). That is one term, and a is chosen far
// enough out for one term to be enough (`pos_of_term`).
theorem CReal::pos_of_mul_pos({x, y: CReal}, hx: 0 < x, h: 0 < x * y): 0 < y {
    match CReal::pos_gap(hx) {
        Exists(k, rx) => match rx {
            Exists(s, gx) => match CReal::pos_gap(h) {
                Exists(j, rp) => match rp {
                    Exists(t, gp) => {
                        let l = x.bound();
                        let j2 = j + j + 1;
                        let m = l * (j2 + 1) + j2;
                        let start = s.max(t);
                        let n = start.max(16 * m + 15);
                        let a = x.mul_at(y, n);
                        let at_n: (n <= a) = x.mul_at_ge(y, n);
                        let at_start: (start <= n) = start.le_max_l(16 * m + 15);
                        let far_n: (16 * m + 15 <= n) = start.le_max_r(16 * m + 15);
                        let far: (16 * m + 15 <= a) = (16 * m + 15).le_trans(n, a, far_n, at_n);
                        let near: (j + j + 1 <= n) = omega;
                        let at_s: (s <= a) = s.le_trans(n, a, s.le_trans(start, n, s.le_max_l(t), at_start), at_n);
                        let at_t: (t <= n) = t.le_trans(start, n, s.le_max_r(t), at_start);
                        let fk = Rat::inv_succ(k);
                        let lx: (fk <= x.at(a)) = gx(a, at_s);
                        let px: (0 < x.at(a)) = Rat::lt_of_lt_of_le(Rat::inv_succ_pos(k), lx);
                        let bx: (x.at(a) <= Rat::ofInt(OfNat(l + 1))) =
                            Rat::le_trans(x.at(a).le_abs(), x.bound_below(a, l + 1, l.le_succ_r(l, l.le_refl())));
                        let lp: (Rat::inv_succ(j2) <= x.at(a) * y.at(a)) = CReal::half_below(j, n, near, gp(n, at_t), x.mul_term(y, n));
                        let ly: (Rat::inv_succ(m) <= y.at(a)) = Rat::le_of_mul_le_bounded(j2, l, px, bx, lp);
                        y.pos_of_term(m, a, far, Rat::le_trans(Rat::inv_succ_antitone(m, m + m + 1, m.le_add_l(m + 1)), ly))
                    },
                },
            },
        },
    }
}

theorem CReal::mul_nonneg({x, y: CReal}, hx: 0 <= x, hy: 0 <= y): 0 <= x * y {
    let bx = CReal::bishop_of_le(hx);
    let by = CReal::bishop_of_le(hy);
    λ back => match CReal::neg_gap(back) {
        Exists(j, rest) => match rest {
            Exists(s, gap) => {
                let n = s.max(j + 1);
                let past: (j + 1 <= n) = s.le_max_r(j + 1);
                let w = x.mul_bits(y);
                let a = x.mul_at(y, n);
                let big = Rat::ofInt(OfNat(Nat::pow(2, w)));
                let f = Rat::inv_pow2(a);
                let e = Rat::inv_pow2(n + 1);
                let p = x.at(a) * y.at(a);
                let t = (x * y).at(n);
                let g = Rat::inv_succ(j);
                let f_up: (0 <= f) = Rat::inv_pow2_nonneg(a);
                let pos_f: (0 <= f + f) = Rat::le_respects(Rat::add_zero(0), (f + f).same_refl(), Rat::add_le_mono(f_up, f_up));
                let lx: (0 <= x.at(a) + (f + f)) = Rat::le_trans(Rat::le_of_same(Rat::same_sym(CReal::zero_at(a))), bx(a));
                let ly: (0 <= y.at(a) + (f + f)) = Rat::le_trans(Rat::le_of_same(Rat::same_sym(CReal::zero_at(a))), by(a));
                let near = calc {
                    0 <= p + big * (f + f) := Rat::mul_nonneg_approx(lx, ly, pos_f, x.size_l(y, a), x.size_r(y, a)),
                    ≈ p + (big * f + big * f) := Rat::add_respects(p.same_refl(), big.mul_add_distr(f, f)),
                    ≈ p + e := Rat::add_respects(p.same_refl(),
                        Rat::same_trans(Rat::add_respects(Rat::scale_inv_pow2(w, n + 1 + 1), Rat::scale_inv_pow2(w, n + 1 + 1)), Rat::inv_pow2_half(n + 1))),
                };
                let top: (t + g <= 0) = gap(n, s.le_max_l(j + 1));
                let chain = calc {
                    g + p <= g + (t + e) := p.add_le_mono_l(t + e, g, Rat::le_add_of_dist(x.mul_term_r(y, n))),
                    ≈ (t + g) + e := ring,
                    <= 0 + e := (t + g).add_le_mono_r(0, e, top),
                    ≈ e := Rat::zero_add(e),
                };
                let sum = calc {
                    g ≈ g + 0 := Rat::same_sym(g.add_zero()),
                    <= g + (p + e) := Rat::add_le_mono_l(0, p + e, g, near),
                    ≈ (g + p) + e := Rat::same_sym(g.add_assoc(p, e)),
                    <= e + e := (g + p).add_le_mono_r(e, e, chain),
                };
                let next: (Rat::inv_succ(j + 1) < g) = omega;
                let strict: (Rat::inv_succ(n) < g) = Rat::lt_of_le_of_lt(Rat::inv_succ_antitone(j + 1, n, past), next);
                let small: (e + e < g) = Rat::lt_of_le_of_lt(Rat::le_trans(Rat::le_of_same(Rat::inv_pow2_half(n)), Rat::inv_pow2_le_inv_succ(n)), strict);
                Rat::not_le_of_lt(small, sum)
            },
        },
    }
}

theorem CReal::zero_add(self x: CReal): 0 + x ≈ x {
    CReal::same_trans(CReal::add_comm(0, x), x.add_zero())
}

theorem CReal::sub_add_cancel(self x, y: CReal): (x - y) + y ≈ x {
    calc {
        (x + -y) + y ≈ x + (-y + y) := x.add_assoc(-y, y),
        ≈ x + (y + -y) := CReal::add_respects(x.same_refl(), (-y).add_comm(y)),
        ≈ x + 0 := CReal::add_respects(x.same_refl(), y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

theorem CReal::add_mul_distr(self x, y, z: CReal): (x + y) * z ≈ x * z + y * z {
    calc {
        (x + y) * z ≈ z * (x + y) := (x + y).mul_comm(z),
        ≈ z * x + z * y := z.mul_add_distr(x, y),
        ≈ x * z + y * z := CReal::add_respects(z.mul_comm(x), z.mul_comm(y)),
    }
}

theorem CReal::sub_nonneg({x, y: CReal}, h: x <= y): 0 <= y - x {
    calc {
        0 ≈ x + -x := CReal::same_sym(x.add_neg()),
        <= y + -x := x.add_le_mono_r(y, -x, h),
    }
}

theorem CReal::sub_pos({x, y: CReal}, h: x < y): 0 < y - x {
    calc {
        0 ≈ x + -x := CReal::same_sym(x.add_neg()),
        < y + -x := x.add_lt_mono_r(y, -x, h),
    }
}

theorem CReal::mul_le_mono_r({x, y, z: CReal}, h: x <= y, hz: 0 <= z): x * z <= y * z {
    let d = y - x;
    calc {
        x * z ≈ 0 + x * z := CReal::same_sym((x * z).zero_add()),
        <= d * z + x * z := CReal::add_le_mono_r(0, d * z, x * z, CReal::mul_nonneg(CReal::sub_nonneg(h), hz)),
        ≈ (d + x) * z := CReal::same_sym(d.add_mul_distr(x, z)),
        ≈ y * z := CReal::mul_respects(y.sub_add_cancel(x), z.same_refl()),
    }
}

theorem CReal::mul_lt_mono_r({x, y, z: CReal}, h: x < y, hz: 0 < z): x * z < y * z {
    let d = y - x;
    calc {
        x * z ≈ 0 + x * z := CReal::same_sym((x * z).zero_add()),
        < d * z + x * z := CReal::add_lt_mono_r(0, d * z, x * z, CReal::mul_pos(CReal::sub_pos(h), hz)),
        ≈ (d + x) * z := CReal::same_sym(d.add_mul_distr(x, z)),
        ≈ y * z := CReal::mul_respects(y.sub_add_cancel(x), z.same_refl()),
    }
}

theorem CReal::mul_le_mono_l({x, y, z: CReal}, h: x <= y, hz: 0 <= z): z * x <= z * y {
    calc {
        z * x ≈ x * z := z.mul_comm(x),
        <= y * z := CReal::mul_le_mono_r(h, hz),
        ≈ z * y := y.mul_comm(z),
    }
}

theorem CReal::mul_lt_mono_l({x, y, z: CReal}, h: x < y, hz: 0 < z): z * x < z * y {
    calc {
        z * x ≈ x * z := z.mul_comm(x),
        < y * z := CReal::mul_lt_mono_r(h, hz),
        ≈ z * y := y.mul_comm(z),
    }
}

// ---------------------------------------------------------------------------
// The commutative ring modulo `≈` (lib/std/algebra/semiring.hthr). The semigroups
// and commutativity registered with `+` and `*` fill their parents; what is
// new is the units, the additive inverse, the second distributive law and
// zero's annihilation, each the law above read from the other side.

theorem CReal::one_mul(self x: CReal): 1 * x ≈ x { CReal::same_trans(CReal::mul_comm(1, x), x.mul_one()) }

theorem CReal::zero_mul(self x: CReal): 0 * x ≈ 0 { CReal::same_trans(CReal::mul_comm(0, x), x.mul_zero()) }

theorem CReal::neg_add_self(self x: CReal): -x + x ≈ 0 { CReal::same_trans(CReal::add_comm(-x, x), x.add_neg()) }

instance CommMonoidRel<CReal>(CReal::Same, CReal::add) {
    unit := 0,
    unit_l := CReal::zero_add,
    unit_r := CReal::add_zero,
}

instance GroupRel<CReal>(CReal::Same, CReal::add) {
    inv := CReal::neg,
    inv_l := CReal::neg_add_self,
    inv_r := CReal::add_neg,
    inv_respects := λ x y h => CReal::neg_respects(h),
}

instance MonoidRel<CReal>(CReal::Same, CReal::mul) {
    unit := 1,
    unit_l := CReal::one_mul,
    unit_r := CReal::mul_one,
}

instance Distributes<CReal>(CReal::Same, CReal::add, CReal::mul) {
    distrib_l := CReal::mul_add_distr,
    distrib_r := CReal::add_mul_distr,
}

instance CommRing<CReal>(CReal::Same, CReal::add, CReal::mul) {
    zero_mul := CReal::zero_mul,
    mul_zero := CReal::mul_zero,
}

// The integers in `CReal` are its numerals, the rational ones embedded, so
// `ring` normalizes a `≈` goal at `CReal` (std/ring's `RingExpr::sound_rel`).
theorem CReal::ofInt_add(a, b: Int):
    CReal::ofRat(Rat::ofInt(a + b)) ≈ CReal::ofRat(Rat::ofInt(a)) + CReal::ofRat(Rat::ofInt(b))
{
    CReal::same_trans(CReal::ofRat_respects(Rat::ofInt_add(a, b)), CReal::ofRat_add(Rat::ofInt(a), Rat::ofInt(b)))
}

theorem CReal::ofInt_mul(a, b: Int):
    CReal::ofRat(Rat::ofInt(a * b)) ≈ CReal::ofRat(Rat::ofInt(a)) * CReal::ofRat(Rat::ofInt(b))
{
    CReal::same_trans(CReal::ofRat_respects(Rat::ofInt_mul(a, b)), CReal::ofRat_mul(Rat::ofInt(a), Rat::ofInt(b)))
}

instance CommRingOfInt<CReal>(CReal::Same, CReal::add, CReal::mul) {
    of_int := λ (n: Int) => CReal::ofRat(Rat::ofInt(n)),
    of_int_zero := CReal::same_refl(0),
    of_int_one := CReal::same_refl(1),
    of_int_add := CReal::ofInt_add,
    of_int_mul := CReal::ofInt_mul,
}

// ---------------------------------------------------------------------------
// The Archimedean property and the ordered-field interface
// (std/ordered_field). A real is below the natural number one past its
// canonical bound: every term is at most the bound, so a gap of one holds
// from index zero.

theorem CReal::archimedean(self x: CReal): ∃ n: Nat, x < CReal::ofRat(Rat::ofInt(OfNat(n))) {
    let b = x.bound();
    Exists(b + 1, Exists(0, Exists(0, λ n from => calc {
        x.at(n) + Rat::inv_succ(0) <= x.at(n).abs() + Rat::inv_succ(0) := x.at(n).add_le_mono_r(x.at(n).abs(), Rat::inv_succ(0), x.at(n).le_abs()),
        <= Rat::ofInt(OfNat(b)) + Rat::inv_succ(0) := x.at(n).abs().add_le_mono_r(Rat::ofInt(OfNat(b)), Rat::inv_succ(0), x.bound_le(n)),
        ≈ Rat::ofInt(OfNat(b + 1)) := omega,
        ≈ CReal::ofRat(Rat::ofInt(OfNat(b + 1))).at(n) := Rat::same_sym(CReal::ofInt_at(OfNat(b + 1), n)),
    })))
}

theorem CReal::zero_lt_one(): CReal::Lt(0, 1) { CReal::ofRat_lt(Rat::zero_lt_one()) }

theorem CReal::ofNat_succ(n: Nat): CReal::ofRat(Rat::ofInt(OfNat(Succ(n)))) ≈ CReal::ofRat(Rat::ofInt(OfNat(n))) + 1 {
    CReal::same_trans(CReal::ofRat_respects(omega), CReal::ofRat_add(Rat::ofInt(OfNat(n)), 1))
}

// `≤` is `¬(y < x)` by definition here, so both of its laws are the identity.
instance StrictOrder<CReal>(CReal::Same, CReal::Lt, CReal::Le) {
    lt_irrefl := CReal::lt_irrefl,
    lt_trans := λ x y z h1 h2 => CReal::lt_trans(h1, h2),
    lt_respects := λ x x2 y y2 hx hy h => CReal::lt_respects(hx, hy, h),
    lt_tight := λ x y h1 h2 => CReal::same_of_not_apart(λ a => match a { Inl(l) => h1(l), Inr(r) => h2(r) }),
    le_of_not_lt := λ x y h => h,
    not_lt_of_le := λ x y h => h,
}

instance Cotransitive<CReal>(CReal::Lt) {
    rel_cotrans := CReal::lt_cotrans,
}

instance PseudoOrder<CReal>(CReal::Same, CReal::Lt, CReal::Le) {}

instance OrderedAddGroup<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add) {
    add_lt_mono_r := CReal::add_lt_mono_r,
}

instance LocatedAddGroup<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add) {}

// A sum's order and sign, termwise, as at `Rat` (`Rat::range_le`).
theorem CReal::range_le(n: Nat, f, g: Nat → CReal, h: (k: Nat) → k < n → f(k) <= g(k)): MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g) {
    LocatedAddGroup::range_le(n, f, g, h)
}

theorem CReal::range_nonneg(n: Nat, f: Nat → CReal, h: (k: Nat) → k < n → 0 <= f(k)): 0 <= MonoidRel::range(+, n, f) {
    LocatedAddGroup::range_nonneg(n, f, h)
}

instance OrderedField<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul) {
    of_nat := λ n => CReal::ofRat(Rat::ofInt(OfNat(n))),
    recip := λ x h => x.inv(h := h),
    mul_recip := λ x h => x.mul_inv(h := h),
    zero_lt_one := CReal::zero_lt_one(),
    mul_pos := λ x y hx hy => CReal::mul_pos(hx, hy),
    pos_of_mul_pos := λ x y hx h => CReal::pos_of_mul_pos(hx, h),
    of_nat_zero := CReal::same_refl(0),
    of_nat_succ := CReal::ofNat_succ,
    archimedean := CReal::archimedean,
}

// Its integers named too (std/ordered_field's `OrderedFieldOfInt`), which is
// what `linarith`'s certificates are checked against.
instance OrderedFieldOfInt<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul) {}

// A square is nonnegative (`OrderedField::sq_nonneg`), named at the carrier
// so a hint can cite it: `nlinarith(CReal::sq_nonneg(a - b))`.
theorem CReal::sq_nonneg(self x: CReal): 0 <= x * x { OrderedField::sq_nonneg(x) }

// ---------------------------------------------------------------------------
// Completeness (docs/creal-completeness-round.md). A sequence of reals is
// regular when its m-th and n-th reals are within 2^-m + 2^-n, the rate a
// real's own terms keep, and it converges to y at the same rate. Every
// regular sequence of reals has a limit, read off the diagonal: the limit's
// n-th term is the (n+1)-th term of the (n+1)-th real. Nothing is chosen;
// the limit is a function of the sequence, and its terms evaluate.
//
// Every estimate below is about terms. A bound `d.abs() <= ofRat(r)` between
// reals reads, at index i, as Bishop's: the terms at i+1 are within r plus
// a rounding and twice the rate (`dist_terms`). Back the other way, a real is
// below another when its terms are eventually below the other's plus any
// 1/(j+1) (`le_of_close`), which leaves the room every diagonal estimate
// needs; the slack is a few 2^-i, under 8·2^-i, below 1/(j+1) once i is
// 8(j+1)+j (`Rat::scale_inv_succ_le`).

theorem CReal::abs_regular(self x: CReal, m, n: Nat):
    (x.seq(m).abs().rat() - x.seq(n).abs().rat()).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n)
{
    Rat::le_respects(Rat::abs_respects(Rat::sub_respects(Rat::same_sym(x.seq(m).rat_abs()), Rat::same_sym(x.seq(n).rat_abs()))),
        (Rat::inv_pow2(m) + Rat::inv_pow2(n)).same_refl(),
        Rat::le_trans(x.at(m).abs_sub_abs_le(x.at(n)), x.regular(m, n)))
}

fn CReal::abs(self x: CReal) → CReal { CReal(λ n => x.seq(n).abs(), λ m n => x.abs_regular(m, n)) }

theorem CReal::abs_at(self x: CReal, n: Nat): x.abs().at(n) ≈ x.at(n).abs() { x.seq(n).rat_abs() }

theorem CReal::dist_at(self x, y: CReal, n: Nat): (x - y).abs().at(n) ≈ (x.at(n + 1) - y.at(n + 1)).abs() {
    Rat::same_trans((x - y).abs_at(n), Rat::abs_respects(x.sub_at(y, n)))
}

theorem CReal::abs_respects({x, x2: CReal}, hx: x ≈ x2): x.abs() ≈ x2.abs() {
    λ k => match hx(k) {
        Exists(start, close) => Exists(start, λ n from => Rat::le_respects(
            Rat::abs_respects(Rat::sub_respects(Rat::same_sym(x.abs_at(n)), Rat::same_sym(x2.abs_at(n)))), Rat::inv_succ(k).same_refl(),
            Rat::le_trans(x.at(n).abs_sub_abs_le(x2.at(n)), close(n, from)))),
    }
}

// |q|'s image and the absolute value of q's image are each within 2^-(n+1)
// of |q| at every n.
theorem CReal::ofRat_abs(q: Rat): CReal::ofRat(q).abs() ≈ CReal::ofRat(q.abs()) {
    CReal::ofRat(q).abs().same_of_near_rat(CReal::ofRat(q.abs()), q.abs(),
        λ n => Rat::le_trans(Rat::le_respects(Rat::abs_respects(Rat::sub_respects(Rat::same_sym(CReal::ofRat(q).abs_at(n)), q.abs().same_refl())), Rat::inv_pow2(n + 1).same_refl(),
            Rat::le_trans(CReal::ofRat(q).at(n).abs_sub_abs_le(q), CReal::ofRat_close(q, n))), CReal::half_le(n)),
        λ n => Rat::le_trans(CReal::ofRat_close_r(q.abs(), n), CReal::half_le(n)))
}

// x ≤ y when, for every j, x's terms are eventually below y's plus 1/(j+1):
// a gap of 1/(k+1) with y below x is refuted at 1/(2k+2).
theorem CReal::le_of_close({x, y: CReal},
    close: (j: Nat) → ∃ start: Nat, (n: Nat) → start <= n → x.at(n) <= y.at(n) + Rat::inv_succ(j)): x <= y
{
    λ back => match back {
        Exists(k, rest) => match rest {
            Exists(s, gap) => match close(k + k + 1) {
                Exists(t, near) => {
                    let n = s.max(t);
                    let a = y.at(n);
                    let step = Rat::inv_succ(k);
                    let small = Rat::inv_succ(k + k + 1);
                    let strict: (small < step) = Rat::inv_succ_half_lt(k);
                    let swapped = calc {
                        step + a ≈ a + step := step.add_comm(a),
                        <= x.at(n) := gap(n, s.le_max_l(t)),
                        <= a + small := near(n, s.le_max_r(t)),
                        ≈ small + a := a.add_comm(small),
                    };
                    Rat::not_le_of_lt(strict, step.add_le_cancel_r(small, a, swapped))
                },
            },
        },
    }
}

// Below a rational: x's terms eventually below r plus any 1/(j+1), or above
// it. The image's term is within a rounding of r, which far enough out is
// half of a 1/(j+1).
theorem CReal::le_ofRat_of_close({x: CReal}, r: Rat,
    close: (j: Nat) → ∃ start: Nat, (n: Nat) → start <= n → x.at(n) <= r + Rat::inv_succ(j)): x <= CReal::ofRat(r)
{
    CReal::le_of_close(λ j => {
        let j2 = j + j + 1;
        match close(j2) {
            Exists(s, c) => Exists(s.max(j2), λ i from => {
                let at_s: (s <= i) = s.le_trans(s.max(j2), i, s.le_max_l(j2), from);
                let at_j: (j2 <= i) = j2.le_trans(s.max(j2), i, s.le_max_r(j2), from);
                let e = Rat::inv_pow2(i + 1);
                let half = Rat::inv_succ(j2);
                let o = CReal::ofRat(r).at(i);
                let small: (e <= half) = Rat::le_trans(CReal::half_le(i), Rat::le_trans(Rat::inv_pow2_le_inv_succ(i), Rat::inv_succ_antitone(j2, i, at_j)));
                let ro: (r <= o + e) = Rat::le_add_of_dist(CReal::ofRat_close_r(r, i));
                calc {
                    x.at(i) <= r + half := c(i, at_s),
                    <= (o + e) + half := r.add_le_mono_r(o + e, half, ro),
                    ≈ o + (e + half) := o.add_assoc(e, half),
                    <= o + (half + half) := (e + half).add_le_mono_l(half + half, o, e.add_le_mono_r(half, half, small)),
                    ≈ o + Rat::inv_succ(j) := Rat::add_respects(o.same_refl(), Rat::inv_succ_half(j)),
                }
            }),
        }
    })
}

theorem CReal::ofRat_le_of_close({x: CReal}, r: Rat,
    close: (j: Nat) → ∃ start: Nat, (n: Nat) → start <= n → r <= x.at(n) + Rat::inv_succ(j)): CReal::ofRat(r) <= x
{
    CReal::le_of_close(λ j => {
        let j2 = j + j + 1;
        match close(j2) {
            Exists(s, c) => Exists(s.max(j2), λ i from => {
                let at_s: (s <= i) = s.le_trans(s.max(j2), i, s.le_max_l(j2), from);
                let at_j: (j2 <= i) = j2.le_trans(s.max(j2), i, s.le_max_r(j2), from);
                let e = Rat::inv_pow2(i + 1);
                let half = Rat::inv_succ(j2);
                let a = x.at(i);
                let small: (e <= half) = Rat::le_trans(CReal::half_le(i), Rat::le_trans(Rat::inv_pow2_le_inv_succ(i), Rat::inv_succ_antitone(j2, i, at_j)));
                calc {
                    CReal::ofRat(r).at(i) <= r + e := Rat::le_add_of_dist(CReal::ofRat_close(r, i)),
                    <= (a + half) + e := r.add_le_mono_r(a + half, e, c(i, at_s)),
                    ≈ a + (half + e) := a.add_assoc(half, e),
                    <= a + (half + half) := (half + e).add_le_mono_l(half + half, a, e.add_le_mono_l(half, half, small)),
                    ≈ a + Rat::inv_succ(j) := Rat::add_respects(a.same_refl(), Rat::inv_succ_half(j)),
                }
            }),
        }
    })
}

// A distance bound between reals, read at index i: the terms at i+1 are
// within the bound plus a rounding and Bishop's 2^-i + 2^-i.
theorem CReal::dist_terms(self x, y: CReal, r: Rat, h: (x - y).abs() <= CReal::ofRat(r), i: Nat):
    (x.at(i + 1) - y.at(i + 1)).abs() <= r + (Rat::inv_pow2(i + 1) + (Rat::inv_pow2(i) + Rat::inv_pow2(i)))
{
    let e = Rat::inv_pow2(i + 1);
    let ff = Rat::inv_pow2(i) + Rat::inv_pow2(i);
    let o = CReal::ofRat(r).at(i);
    calc {
        (x.at(i + 1) - y.at(i + 1)).abs() ≈ (x - y).abs().at(i) := Rat::same_sym(x.dist_at(y, i)),
        <= o + ff := CReal::bishop_of_le(h, i),
        <= (r + e) + ff := o.add_le_mono_r(r + e, ff, Rat::le_add_of_dist(CReal::ofRat_close(r, i))),
        ≈ r + (e + ff) := r.add_assoc(e, ff),
    }
}

// |a - b| and |c - d| differ by at most |a - c| + |d - b|.
theorem CReal::abs_sub_close({a, b, c, d, e: Rat}, ha: (a - c).abs() <= e, hb: (d - b).abs() <= e):
    ((a - b).abs() - (c - d).abs()).abs() <= e + e
{
    let r1: (a - c ≈ (a - b) - (c - b)) = ring;
    let r2: (d - b ≈ (c - b) - (c - d)) = ring;
    let s1: (((a - b) - (c - b)).abs() <= e) = Rat::le_respects(Rat::abs_respects(r1), e.same_refl(), ha);
    let s2: (((c - b) - (c - d)).abs() <= e) = Rat::le_respects(Rat::abs_respects(r2), e.same_refl(), hb);
    Rat::le_trans((a - b).abs_sub_abs_le(c - d), Rat::le_trans((a - b).dist_triangle(c - b, c - d), Rat::add_le_mono(s1, s2)))
}

fn CReal::Regular(xs: Nat → CReal) → Type {
    (m, n: Nat) → (xs(m) - xs(n)).abs() <= CReal::ofRat(Rat::inv_pow2(m) + Rat::inv_pow2(n))
}

fn CReal::Limit(xs: Nat → CReal, y: CReal) → Type {
    (n: Nat) → (xs(n) - y).abs() <= CReal::ofRat(Rat::inv_pow2(n))
}

// The diagonal's terms are regular. Between the (m+1)-th term of the
// (m+1)-th real and the (n+1)-th of the (n+1)-th, pass through both reals'
// terms at a far index p = i+1: regularity of each real moves by
// 2^-(m+1) + 2^-p and 2^-(n+1) + 2^-p, the sequence's regularity crosses at p
// for 2^-(m+1) + 2^-(n+1) plus `dist_terms`' slack, and the halves make
// 2^-m + 2^-n plus a slack under 8·2^-i, below any 1/(j+1) once i is
// 8(j+1)+j.
theorem CReal::lim_regular(xs: Nat → CReal, h: CReal::Regular(xs), m, n: Nat):
    (xs(m + 1).at(m + 1) - xs(n + 1).at(n + 1)).abs() <= Rat::inv_pow2(m) + Rat::inv_pow2(n)
{
    let mm = m + 1;
    let nn = n + 1;
    let x = xs(mm);
    let z = xs(nn);
    let a = Rat::inv_pow2(mm);
    let b = Rat::inv_pow2(nn);
    Rat::le_of_le_add_inv_succ(λ j => {
        let i = 8 * (j + 1) + j;
        let p = i + 1;
        let e = Rat::inv_pow2(p);
        let f = Rat::inv_pow2(i);
        let d1: ((x.at(mm) - x.at(p)).abs() <= a + e) = x.regular(mm, p);
        let d2: ((x.at(p) - z.at(p)).abs() <= (a + b) + (e + (f + f))) = x.dist_terms(z, a + b, h(mm, nn), i);
        let d3: ((z.at(p) - z.at(nn)).abs() <= b + e) = calc {
            (z.at(p) - z.at(nn)).abs() ≈ (z.at(nn) - z.at(p)).abs() := z.at(p).abs_sub_comm(z.at(nn)),
            <= b + e := z.regular(nn, p),
        };
        let he: (e <= f) = CReal::half_le(i);
        let f0: (0 <= f) = Rat::inv_pow2_nonneg(i);
        let eight: ((e + (e + (f + f))) + e <= 8 * f) = linarith(he, f0);
        let slack: ((e + (e + (f + f))) + e <= Rat::inv_succ(j)) =
            Rat::le_trans(eight, Rat::scale_inv_succ_le(8, i, j, i.le_refl(), Rat::inv_pow2_le_inv_succ(i)));
        let main = calc {
            (a + (a + b)) + b ≈ ((a + a) + b) + b := Rat::add_respects(Rat::same_sym(a.add_assoc(a, b)), b.same_refl()),
            ≈ (a + a) + (b + b) := (a + a).add_assoc(b, b),
            ≈ Rat::inv_pow2(m) + Rat::inv_pow2(n) := Rat::add_respects(Rat::inv_pow2_half(m), Rat::inv_pow2_half(n)),
        };
        let u = x.at(mm);
        let v = x.at(p);
        let w = z.at(p);
        let t = z.at(nn);
        let s = (e + (e + (f + f))) + e;
        calc {
            (u - t).abs() <= (u - w).abs() + (w - t).abs() := u.dist_triangle(w, t),
            <= ((u - v).abs() + (v - w).abs()) + (w - t).abs() := (u - w).abs().add_le_mono_r((u - v).abs() + (v - w).abs(), (w - t).abs(), u.dist_triangle(v, w)),
            <= ((a + e) + ((a + b) + (e + (f + f)))) + (b + e) := Rat::add_le_mono(Rat::add_le_mono(d1, d2), d3),
            ≈ ((a + (a + b)) + b) + s := a.add_add_add_comm3(e, a + b, e + (f + f), b, e),
            ≈ (Rat::inv_pow2(m) + Rat::inv_pow2(n)) + s := Rat::add_respects(main, s.same_refl()),
            <= (Rat::inv_pow2(m) + Rat::inv_pow2(n)) + Rat::inv_succ(j) := s.add_le_mono_l(Rat::inv_succ(j), Rat::inv_pow2(m) + Rat::inv_pow2(n), slack),
        }
    })
}

fn CReal::lim(xs: Nat → CReal, h: CReal::Regular(xs)) → CReal {
    CReal(λ n => xs(n + 1).seq(n + 1), λ m n => CReal::lim_regular(xs, h, m, n))
}

// The n-th real is within 2^-n of the limit. At index i the distance's term
// compares terms at p = i+1, and the limit's term there is the q-th term of
// the q-th real, q = p+1: the sequence's regularity crosses from the n-th
// real to the q-th at p for 2^-n + 2^-q plus `dist_terms`' slack, and the
// q-th real's regularity moves from p to q for 2^-p + 2^-q more. The slack
// is under 8·2^-i, below 1/(j+1) from i = 8(j+1)+j on.
theorem CReal::lim_converges(xs: Nat → CReal, h: CReal::Regular(xs)): CReal::Limit(xs, CReal::lim(xs, h)) {
    λ n => {
        let c = Rat::inv_pow2(n);
        CReal::le_ofRat_of_close(c, λ j => Exists(8 * (j + 1) + j, λ i from => {
            let p = i + 1;
            let q = p + 1;
            let fq = Rat::inv_pow2(q);
            let e = Rat::inv_pow2(p);
            let f = Rat::inv_pow2(i);
            let x = xs(n);
            let z = xs(q);
            let d2: ((x.at(p) - z.at(p)).abs() <= (c + fq) + (e + (f + f))) = x.dist_terms(z, c + fq, h(n, q), i);
            let d3: ((z.at(p) - z.at(q)).abs() <= e + fq) = z.regular(p, q);
            let hq: (fq <= e) = CReal::half_le(p);
            let he: (e <= f) = CReal::half_le(i);
            let f0: (0 <= f) = Rat::inv_pow2_nonneg(i);
            let s = (fq + (e + (f + f))) + (e + fq);
            let eight: (s <= 8 * f) = linarith(hq, he, f0);
            let slack: (s <= Rat::inv_succ(j)) = Rat::le_trans(eight, Rat::scale_inv_succ_le(8, i, j, from, Rat::inv_pow2_le_inv_succ(i)));
            let u = x.at(p);
            let w = z.at(p);
            let t = z.at(q);
            calc {
                (x - CReal::lim(xs, h)).abs().at(i) ≈ (u - t).abs() := x.dist_at(CReal::lim(xs, h), i),
                <= (u - w).abs() + (w - t).abs() := u.dist_triangle(w, t),
                <= ((c + fq) + (e + (f + f))) + (e + fq) := Rat::add_le_mono(d2, d3),
                ≈ (c + (fq + (e + (f + f)))) + (e + fq) := Rat::add_respects(c.add_assoc(fq, e + (f + f)), (e + fq).same_refl()),
                ≈ c + s := c.add_assoc(fq + (e + (f + f)), e + fq),
                <= c + Rat::inv_succ(j) := s.add_le_mono_l(Rat::inv_succ(j), c, slack),
            }
        }))
    }
}

// Cauchy completeness with the modulus written in: every regular sequence of
// reals converges, to a limit given as data.
theorem CReal::complete(xs: Nat → CReal, h: CReal::Regular(xs)): ∃ y: CReal, CReal::Limit(xs, y) {
    Exists(CReal::lim(xs, h), CReal::lim_converges(xs, h))
}

// Limits respect `≈`, of the reals in the sequence and of the limit.
theorem CReal::limit_respects({xs, ys: Nat → CReal}, {y, y2: CReal}, hs: (n: Nat) → xs(n) ≈ ys(n), hy: y ≈ y2,
    h: CReal::Limit(xs, y)): CReal::Limit(ys, y2)
{
    λ n => CReal::le_respects(CReal::abs_respects(CReal::sub_respects(hs(n), hy)), CReal::ofRat(Rat::inv_pow2(n)).same_refl(), h(n))
}

// Two limits of one sequence are the same. Were z below y by 1/(k+1), take
// the i-th real far out: at index i its terms at p = i+1 are within
// 2^-i plus `dist_terms`' slack of both limits', under 4·2^-i each, and
// twice that is under the gap.
theorem CReal::limit_le({xs: Nat → CReal}, {y, z: CReal}, hy: CReal::Limit(xs, y), hz: CReal::Limit(xs, z)): y <= z {
    λ back => match back {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let far = 8 * (k2 + 1) + k2;
                let i = s.max(far);
                let p = i + 1;
                let at_s: (s <= p) = s.le_succ_r(i, s.le_max_l(far));
                let step = Rat::inv_succ(k);
                let strict: (Rat::inv_succ(k2) < step) = Rat::inv_succ_half_lt(k);
                let e = Rat::inv_pow2(p);
                let f = Rat::inv_pow2(i);
                let a = f + (e + (f + f));
                let x = xs(i);
                let u = x.at(p);
                let dy: ((u - y.at(p)).abs() <= a) = x.dist_terms(y, f, hy(i), i);
                let dz: ((u - z.at(p)).abs() <= a) = x.dist_terms(z, f, hz(i), i);
                let he: (e <= f) = CReal::half_le(i);
                let f0: (0 <= f) = Rat::inv_pow2_nonneg(i);
                let eight: (a + a <= 8 * f) = linarith(he, f0);
                let small: (a + a < step) = Rat::lt_of_le_of_lt(
                    Rat::le_trans(eight, Rat::scale_inv_succ_le(8, i, k2, s.le_max_r(far), Rat::inv_pow2_le_inv_succ(i))), strict);
                let b = z.at(p);
                let swapped = calc {
                    step + b ≈ b + step := step.add_comm(b),
                    <= y.at(p) := gap(p, at_s),
                    <= u + a := Rat::le_add_of_dist(calc {
                        (y.at(p) - u).abs() ≈ (u - y.at(p)).abs() := y.at(p).abs_sub_comm(u),
                        <= a := dy,
                    }),
                    <= (b + a) + a := u.add_le_mono_r(b + a, a, Rat::le_add_of_dist(dz)),
                    ≈ b + (a + a) := b.add_assoc(a, a),
                    ≈ (a + a) + b := b.add_comm(a + a),
                };
                Rat::not_le_of_lt(small, step.add_le_cancel_r(a + a, b, swapped))
            },
        },
    }
}

theorem CReal::limit_unique({xs: Nat → CReal}, {y, z: CReal}, hy: CReal::Limit(xs, y), hz: CReal::Limit(xs, z)): y ≈ z {
    CReal::le_antisymm(CReal::limit_le(hy, hz), CReal::limit_le(hz, hy))
}

// So the diagonal limit does not depend on the representation: sequences
// of `≈` reals have `≈` limits.
theorem CReal::lim_respects({xs, ys: Nat → CReal}, hx: CReal::Regular(xs), hy: CReal::Regular(ys), hs: (n: Nat) → xs(n) ≈ ys(n)):
    CReal::lim(xs, hx) ≈ CReal::lim(ys, hy)
{
    CReal::limit_unique(CReal::limit_respects(hs, CReal::lim(xs, hx).same_refl(), CReal::lim_converges(xs, hx)), CReal::lim_converges(ys, hy))
}

// A constant sequence is regular and converges to its value.
theorem CReal::abs_sub_self(self x: CReal): (x - x).abs() ≈ 0 {
    (x - x).abs().same_of_terms(0, λ n => Rat::same_trans(x.dist_at(x, n), Rat::same_trans(x.at(n + 1).abs_sub_self(), Rat::same_sym(CReal::zero_at(n)))))
}

theorem CReal::regular_const(self x: CReal): CReal::Regular(λ n => x) {
    λ m n => {
        let rate: (0 <= Rat::inv_pow2(m) + Rat::inv_pow2(n)) =
            Rat::le_respects(Rat::add_zero(0), (Rat::inv_pow2(m) + Rat::inv_pow2(n)).same_refl(), Rat::add_le_mono(Rat::inv_pow2_nonneg(m), Rat::inv_pow2_nonneg(n)));
        CReal::le_respects(CReal::same_sym(x.abs_sub_self()), CReal::ofRat(Rat::inv_pow2(m) + Rat::inv_pow2(n)).same_refl(), CReal::ofRat_le(rate))
    }
}

theorem CReal::limit_const(self x: CReal): CReal::Limit(λ n => x, x) {
    λ n => CReal::le_respects(CReal::same_sym(x.abs_sub_self()), CReal::ofRat(Rat::inv_pow2(n)).same_refl(),
        CReal::ofRat_le(Rat::inv_pow2_nonneg(n)))
}

// The reals are the limits of rationals: a real's terms, embedded, form a
// regular sequence converging to it. At index i the n-th term is within
// 2^-n + 2^-(i+1) of the real's term at i+1, by regularity, and its image
// within a rounding of it.
theorem CReal::dist_ofRat(p, q: Rat): (CReal::ofRat(p) - CReal::ofRat(q)).abs() ≈ CReal::ofRat((p - q).abs()) {
    let d = (CReal::ofRat(p) - CReal::ofRat(q)).abs();
    let r = (p - q).abs();
    d.same_of_near_rat(CReal::ofRat(r), r,
        λ n => Rat::le_respects(Rat::abs_respects(Rat::sub_respects(Rat::same_sym(CReal::ofRat(p).dist_at(CReal::ofRat(q), n)), r.same_refl())), Rat::inv_pow2(n).same_refl(),
            Rat::le_trans(CReal::abs_sub_close(CReal::ofRat_close(p, n + 1), CReal::ofRat_close_r(q, n + 1)),
                Rat::le_trans(Rat::le_of_same(Rat::inv_pow2_half(n + 1)), CReal::half_le(n)))),
        λ n => Rat::le_trans(CReal::ofRat_close_r(r, n), CReal::half_le(n)))
}

theorem CReal::terms_regular(self x: CReal): CReal::Regular(λ n => CReal::ofRat(x.at(n))) {
    λ m n => CReal::le_respects(CReal::same_sym(CReal::dist_ofRat(x.at(m), x.at(n))),
        CReal::ofRat(Rat::inv_pow2(m) + Rat::inv_pow2(n)).same_refl(), CReal::ofRat_le(x.regular(m, n)))
}

theorem CReal::terms_converge(self x: CReal): CReal::Limit(λ n => CReal::ofRat(x.at(n)), x) {
    λ n => {
        let c = Rat::inv_pow2(n);
        let q = x.at(n);
        CReal::le_ofRat_of_close(c, λ j => Exists(8 * (j + 1) + j, λ i from => {
            let p = i + 1;
            let o = CReal::ofRat(q).at(p);
            let e2 = Rat::inv_pow2(p + 1);
            let e = Rat::inv_pow2(p);
            let f = Rat::inv_pow2(i);
            let d1: ((o - q).abs() <= e2) = CReal::ofRat_close(q, p);
            let d2: ((q - x.at(p)).abs() <= c + e) = x.regular(n, p);
            let h2: (e2 <= e) = CReal::half_le(p);
            let he: (e <= f) = CReal::half_le(i);
            let f0: (0 <= f) = Rat::inv_pow2_nonneg(i);
            let eight: (e2 + e <= 8 * f) = linarith(h2, he, f0);
            let slack: (e2 + e <= Rat::inv_succ(j)) = Rat::le_trans(eight, Rat::scale_inv_succ_le(8, i, j, from, Rat::inv_pow2_le_inv_succ(i)));
            calc {
                (CReal::ofRat(q) - x).abs().at(i) ≈ (o - x.at(p)).abs() := CReal::ofRat(q).dist_at(x, i),
                <= (o - q).abs() + (q - x.at(p)).abs() := o.dist_triangle(q, x.at(p)),
                <= e2 + (c + e) := Rat::add_le_mono(d1, d2),
                ≈ c + (e2 + e) := ring,
                <= c + Rat::inv_succ(j) := (e2 + e).add_le_mono_l(Rat::inv_succ(j), c, slack),
            }
        }))
    }
}

theorem CReal::lim_terms(self x: CReal): CReal::lim(λ n => CReal::ofRat(x.at(n)), x.terms_regular()) ≈ x {
    CReal::limit_unique(CReal::lim_converges(λ n => CReal::ofRat(x.at(n)), x.terms_regular()), x.terms_converge())
}

// ---------------------------------------------------------------------------
// Negation reverses the order, and a factor at most zero reverses a product's
// (the enclosures' arithmetic at `CReal`, docs/floating-point-design.md
// §16). A sign split of a real is never decided, but a `≤` is a
// refutation, and inside one the excluded middle on `y < 0` is free:
// `le_by_sign` takes one proof for each side.

theorem CReal::neg_neg(self x: CReal): -(-x) ≈ x {
    (-(-x)).same_of_terms(x, λ n => Rat::same_trans((-x).neg_at(n), Rat::same_trans(Rat::neg_respects(x.neg_at(n)), x.at(n).neg_neg())))
}

theorem CReal::neg_zero(): CReal::Same(-0, 0) {
    CReal::same_of_terms(-0, 0, λ n => Rat::same_trans(CReal::neg_at(0, n), Rat::same_trans(Rat::neg_respects(CReal::zero_at(n)), Rat::same_sym(CReal::zero_at(n)))))
}

theorem CReal::neg_lt({x, y: CReal}, h: x < y): -y < -x {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => Exists(k, Exists(s, λ n from => {
                let g: (x.at(n) + Rat::inv_succ(k) <= y.at(n)) = gap(n, from);
                Rat::le_respects(Rat::add_respects(Rat::same_sym(y.neg_at(n)), Rat::inv_succ(k).same_refl()), Rat::same_sym(x.neg_at(n)), Rat::neg_gap(g))
            })),
        },
    }
}

theorem CReal::neg_le({x, y: CReal}, h: x <= y): -y <= -x {
    λ back => h(CReal::lt_respects(y.neg_neg(), x.neg_neg(), CReal::neg_lt(back)))
}

theorem CReal::le_by_sign({u, v: CReal}, y: CReal, pos: 0 <= y → u <= v, neg: y <= 0 → u <= v): u <= v {
    λ back => (λ (nonneg: ¬(y < 0)) => pos(nonneg, back))(λ below => neg(CReal::le_of_lt(below), back))
}

theorem CReal::mul_le_mono_r_nonpos({x, y, z: CReal}, h: x <= y, hz: z <= 0): y * z <= x * z {
    let nz: (0 <= -z) = CReal::le_respects(CReal::neg_zero(), (-z).same_refl(), CReal::neg_le(hz));
    let flipped: (-(y * -z) <= -(x * -z)) = CReal::neg_le(CReal::mul_le_mono_r(h, nz));
    let back = λ (w: CReal) => CReal::same_trans(CReal::neg_respects(Ring::mul_neg(w, z)), (w * z).neg_neg());
    CReal::le_respects(back(y), back(x), flipped)
}

theorem CReal::mul_le_mono_l_nonpos({x, y, z: CReal}, h: x <= y, hz: z <= 0): z * y <= z * x {
    CReal::le_respects(y.mul_comm(z), x.mul_comm(z), CReal::mul_le_mono_r_nonpos(h, hz))
}

// A real is within 2^-n of its n-th term, on each side: regularity against
// every later term, with the later term's own 2^-i taken as the slack
// `le_of_close` allows.
theorem CReal::le_term_add(self x: CReal, n: Nat): x <= CReal::ofRat(x.at(n) + Rat::inv_pow2(n)) {
    let q = x.at(n);
    let r = Rat::inv_pow2(n);
    CReal::le_ofRat_of_close(q + r, λ j => Exists(j, λ i from => {
        let d: (x.at(i) <= q + (Rat::inv_pow2(i) + r)) = Rat::le_add_of_dist(x.regular(i, n));
        Rat::le_add_shift(d, Rat::le_trans(Rat::inv_pow2_le_inv_succ(i), Rat::inv_succ_antitone(j, i, from)))
    }))
}

theorem CReal::term_sub_le(self x: CReal, n: Nat): CReal::ofRat(x.at(n) - Rat::inv_pow2(n)) <= x {
    let q = x.at(n);
    let r = Rat::inv_pow2(n);
    CReal::ofRat_le_of_close(q - r, λ j => Exists(j, λ i from => {
        let d: (q <= x.at(i) + (r + Rat::inv_pow2(i))) = Rat::le_add_of_dist(x.regular(n, i));
        Rat::sub_le_shift(d, Rat::le_trans(Rat::inv_pow2_le_inv_succ(i), Rat::inv_succ_antitone(j, i, from)))
    }))
}

// Inversion reverses `≤` between positives, at any apartness proofs: a
// reversal `x⁻¹ < y⁻¹` inverted again is `y < x` (`OrderedField`'s strict
// form, read at `CReal`). An inverse of a negation is the inverse negated,
// by uniqueness.
theorem CReal::inv_le_inv({x, y: CReal}, hx: x.Apart(0), hy: y.Apart(0), px: 0 < x, h: x <= y): y.inv(h := hy) <= x.inv(h := hx) {
    λ back => {
        let ux: (x.inv(h := hx).Apart(0)) = Inr(OrderedField::recip_pos(x, hx, px));
        let uy: (y.inv(h := hy).Apart(0)) = Inr(OrderedField::recip_pos(y, hy, CReal::lt_of_lt_of_le(px, h)));
        let flipped = OrderedField::recip_lt_recip(x.inv(h := hx), y.inv(h := hy), ux, uy, OrderedField::recip_pos(x, hx, px), back);
        h(CReal::lt_respects(OrderedField::recip_recip(y, hy, uy), OrderedField::recip_recip(x, hx, ux), flipped))
    }
}

theorem CReal::inv_neg({x: CReal}, hx: x.Apart(0), hn: (-x).Apart(0)): (-x).inv(h := hn) ≈ -x.inv(h := hx) {
    let u = x.inv(h := hx);
    CReal::same_sym(OrderedField::recip_unique(-x, hn, -u, CReal::same_trans(Ring::neg_mul_neg(x, u), x.mul_inv(h := hx))))
}

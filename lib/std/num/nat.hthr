// Arithmetic and propositional order on the kernel `Nat` type. The relations
// reduce at closed arguments; `leb` remains available when a Boolean result is
// wanted, but is not the definition of `<=`.

import bool;
import logic;

// ---------------------------------------------------------------------------
// Addition and its two moving lemmas. `add` recurses on its SECOND argument,
// so the lemmas that matter are the ones that move a `Succ` — and a zero —
// across from the *left*.

fn Nat::add(self a: Nat, b: Nat) → Nat { match b { Zero => a, Succ(k) => Succ(a.add(k)) } }

// The public spelling belongs beside the operation, so the law kit below is
// written in the same surface a downstream proof uses.
designation + at Nat := Nat::add

theorem Nat::cong(f: Nat → Nat, {a, b: Nat}, p: a = b): f(a) = f(b) {
    rewrite(p, refl)
}

theorem Nat::add_left_zero(self x: Nat): 0 + x = x {
    match x { Zero => refl, Succ(k) => Nat::cong_succ(k.add_left_zero()) }
}

theorem Nat::add_succ_left(self a, b: Nat): a + 1 + b = a + b + 1 {
    match b { Zero => refl, Succ(k) => Nat::cong_succ(a.add_succ_left(k)) }
}

fn Nat::of_bit(b: Bool) → Nat { match b { False => 0, True => 1 } }

// The two laws that make `add` a commutative monoid — asked for by the traits
// adoption round (2026-08-07), which registers `AddCommMonoid<Nat>` in
// `std/algebra` and needs exactly these as its fields. Both recurse on the
// argument `add` itself recurses on, so both are three lines.

theorem Nat::add_assoc(self x, y, z: Nat): (x + y) + z = x + (y + z) {
    match z { Zero => refl, Succ(k) => Nat::cong_succ(x.add_assoc(y, k)) }
}

theorem Nat::add_comm(self x, y: Nat): x + y = y + x {
    match y {
        Zero => sym(x.add_left_zero()),
        Succ(k) =>
            apply trans;
            give Nat::cong_succ(x.add_comm(k));
            sym(k.add_succ_left(x)),
    }
}

// Structural doubling. `2 * n` is extensionally the same operation, but
// multiplication recurses on its second argument and is a poor normal form
// for proofs that consume one binary digit at a time. `twice` exposes two
// successors per input successor, so order cancellation remains structural.
fn Nat::twice(self n: Nat) → Nat {
    match n { Zero => 0, Succ(k) => Succ(Succ(k.twice())) }
}

theorem Nat::twice_add_self(self n: Nat): n.twice() = n + n {
    match n {
        Zero => refl,
        Succ(k) => calc {
            (k + 1).twice()
                = k.twice() + 2 := refl,
                = k + k + 2 := Nat::cong_succ(Nat::cong_succ(k.twice_add_self())),
                = k + 1 + k + 1 := Nat::cong_succ(sym(k.add_succ_left(k))),
                = k + 1 + (k + 1) := refl,
        },
    }
}

theorem Nat::twice_add(self a, b: Nat): (a + b).twice() = a.twice() + b.twice() {
    match b {
        Zero => refl,
        Succ(k) => Nat::cong_succ(Nat::cong_succ(a.twice_add(k))),
    }
}

// Swap the first two terms without rebuilding associativity and commutativity
// at every use. This is the right-associated form consumed by certifying AC
// reconstruction.
theorem Nat::add_left_comm(self a, b, c: Nat): a + (b + c) = b + (a + c) {
    calc {
        a + (b + c)
            = (a + b) + c := sym(a.add_assoc(b, c)),
            = (b + a) + c :=
                Nat::cong(λ (q: Nat) => q + c, a.add_comm(b)),
            = b + (a + c) := b.add_assoc(a, c),
    }
}

// Reorder the middle two elements of a four-term sum. Keeping this ordinary
// commutative-monoid consequence named avoids rebuilding a five-step calc in
// every binary-arithmetic proof.
theorem Nat::add_swap_middle(self a, b, c, d: Nat):
    (a + b) + (c + d) = (a + c) + (b + d)
{
    calc {
        (a + b) + (c + d)
            = a + (b + (c + d)) := a.add_assoc(b, c + d),
            = a + ((b + c) + d) :=
                Nat::cong(λ (q: Nat) => a + q, sym(b.add_assoc(c, d))),
            = a + ((c + b) + d) :=
                Nat::cong(λ (q: Nat) => a + (q + d), b.add_comm(c)),
            = a + (c + (b + d)) :=
                Nat::cong(λ (q: Nat) => a + q, c.add_assoc(b, d)),
            = (a + c) + (b + d) := sym(a.add_assoc(c, b + d)),
    }
}

// ---------------------------------------------------------------------------
// Multiplication and its kit. `mul` recurses on its SECOND argument, like
// `add`, and the step puts the recursive result on the LEFT of the `add` —
// `add(mul(a, k), a)`, not `add(a, mul(a, k))`. That is the whole economy of
// this section, and it is the same choice `add` made one paragraph up: put the
// step's `add` on the argument `add` itself descends on, so that the zero
// side stays *definitional*. `mul(a, 0)` reduces to `Zero` and `add(x, 0)` to
// `x` with no lemma, so `mul(0, x) = 0` and the zero arm of distributivity are
// a self-call and a `refl` respectively. Spelled the other way round every
// proof below pays an `add_left_zero` rewrite it does not otherwise need.
//
// (`crates/elab/tests/certgen*.rs` has a `viaadd` fixture that IS spelled the
// other way. That is deliberate and unrelated: it is a *generator* fixture,
// pinned byte-for-byte, and it wants the cross-function call shape rather than
// the cheap lemma kit. Two different programs, so two different names.)

fn Nat::mul(self a, b: Nat) → Nat { match b { Zero => Zero, Succ(k) => a.mul(k) + a } }

designation * at Nat := Nat::mul

// The right zero — `mul(x, 0) = 0` — needs no lemma. The left one does, and it
// is three lines because the step's `add(_, 0)` reduces away.
theorem Nat::mul_left_zero(self x: Nat): 0 * x = 0 {
    match x { Zero => refl, Succ(k) => k.mul_left_zero() }
}

// The unit on the left, for the same reason: `add(mul(1, k), 1)` reduces to
// `Succ(mul(1, k))` on its own, so this is `add_left_zero`'s shape exactly.
theorem Nat::mul_left_one(self x: Nat): 1 * x = x {
    match x { Zero => refl, Succ(k) => Nat::cong_succ(k.mul_left_one()) }
}

// `add_succ_left`'s counterpart: the lemma that moves a `Succ` across from the
// left. It is the one proof here that is not three lines, and every step of it
// is an `add` law — which is the point of proving `add`'s kit first.
theorem Nat::mul_succ_left(self a, b: Nat): (a + 1) * b = b + a * b {
    match b {
        Zero => refl,
        Succ(k) => calc {
            (a + 1) * (k + 1)
                = (a + 1) * k + a + 1   := refl,
                = (k + a * k) + a + 1   := prelude::cong(a.mul_succ_left(k)),
                = k + (a * k + a) + 1   := prelude::cong(k.add_assoc(a * k, a)),
                = k + 1 + a * (k + 1)   := sym(k.add_succ_left(a * k + a)),
        },
    }
}

// Distributivity over the argument both functions recurse on. It comes before
// `mul_assoc` because `mul_assoc` *is* an instance of it, not the other way
// round — the associativity step rebuilds `mul(x, mul(y, Succ(k)))` as a sum
// and needs this to take it apart.
theorem Nat::mul_add_distr(self a, b, c: Nat): a * (b + c) = a * b + a * c {
    match c {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w + a, a.mul_add_distr(b, k));
            (a * b).add_assoc(a * k, a),
    }
}

// The two laws `std/algebra` registers `CommMonoid<Nat>(mul)` from, in the
// shape its fields want.

theorem Nat::mul_assoc(self x, y, z: Nat): (x * y) * z = x * (y * z) {
    match z {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w + (x * y), x.mul_assoc(y, k));
            sym(x.mul_add_distr(y * k, y)),
    }
}

theorem Nat::mul_comm(self x, y: Nat): x * y = y * x {
    match y {
        Zero => sym(x.mul_left_zero()),
        Succ(k) => calc {
            x * (k + 1)
                = x * k + x := refl,
                = k * x + x := prelude::cong(x.mul_comm(k)),
                = x + k * x := (k * x).add_comm(x),
                = (k + 1) * x := sym(k.mul_succ_left(x)),
        },
    }
}

// ---------------------------------------------------------------------------
// The order, stated PROPOSITIONALLY (docs/library/nat-order-design.md §1). `<=` is
// surface notation for a call to `Le` and `<` for a call to `Lt`
// (issues/comparison-operators.md).
//
// The relation is a recursion into `Type`: `Le(3, 10)` reduces to `True`, so
// closed comparisons compute without routing the specification through Bool.
//
// Uncurried since 2026-09-05: the recursion is on `n` and the inner `match`
// varies `m`, which the elaborator now generalizes into the motive
// (docs/tactics/ih-generalization-design.md). `leb` and `sub` were curried for the
// same reason and are uncurried the same way. A partial application `Le(n)`
// still writes where a relation value is wanted.
//
// Falsity is `logic::False`, which coexists with `bool::False` the constructor
// (issues/false-collides-with-bools-constructor.md). Two lines of this file
// hold both readings and neither is qualified.

fn Nat::Le(self n, m: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => k.Le(l) },
    }
}

// Strict order, as a definition and not a second recursion. `Lt(n, m)` is
// `Le(Succ(n), m)`, so everything `Le` computes `Lt` computes, and the two
// facts a reader most wants — `lt_succ_iff_le` and `lt_succ_self` — are
// definitional (see below).
fn Nat::Lt(self n, m: Nat) → Type { Succ(n).Le(m) }

designation <= at Nat := Nat::Le
designation < at Nat := Nat::Lt

// Equality as a named relation, for where a relation is an index (a
// morphism out of `Nat`, `Int::ofNat_hom`; lib/std/algebra/morphism.hthr).
fn Nat::Same(self a, b: Nat) → Type { a = b }

// The decision procedure. It is NOT part of the order's specification —
// nothing above mentions it — but it is the order's decided bit: the `Decide`
// instance below carries `leb` as its `bit`, so `decide_bit<n <= m>()` is the
// guard a program writes (issues/decide-bit-is-the-comparison.md). Its other
// readers are `certgen_code`, where a Boolean is the subject rather than the
// statement, which is the role issues/class-ops-prop-vs-bool.md leaves `Bool`
// in, and closed-fact evaluation (`le_of_leb`, below).
fn Nat::leb(self n, m: Nat) → Bool {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => k.leb(l) },
    }
}

theorem Nat::leb_refl(self n: Nat): n.leb(n) = True {
    match n { Zero => refl, Succ(k) => k.leb_refl() }
}

// truncated subtraction; both arguments descend together, `n` generalized
// `n <= m` fails exactly when `m < n` holds, as Booleans.
theorem Nat::leb_flip(self n: Nat): (m: Nat) → n.leb(m) = !(m + 1).leb(n) {
    match n {
        Zero => λ m => refl,
        Succ(k) => λ m => match m { Zero => refl, Succ(l) => k.leb_flip(l) },
    }
}

// Equality as a `Bool`.
fn Nat::same(self n, m: Nat) → Bool {
    match n {
        Zero => match m { Zero => True, Succ(_) => False },
        Succ(k) => match m { Zero => False, Succ(l) => k.same(l) },
    }
}

theorem Nat::same_self(self n: Nat): n.same(n) = True {
    match n { Zero => refl, Succ(k) => k.same_self() }
}

theorem Nat::same_sound(self n: Nat): (m: Nat) → n.same(m) = True → n = m {
    match n {
        Zero => λ m => match m {
            Zero => λ h => refl,
            Succ(_) => λ h => absurd(h),
        },
        Succ(_, ih) => λ m => match m {
            Zero => λ h => absurd(h),
            Succ(l) => λ h => rewrite(ih(l, h), refl),
        },
    }
}

theorem Nat::ne_of_same(self n, m: Nat, h: n.same(m) = False): n ≠ m { λ e => absurd(trans(sym(h), j(e, λ k _ => n.same(k) = True, n.same_self()))) }

fn Nat::sub(self m, n: Nat) → Nat {
    match m {
        Zero => Zero,
        Succ(m2) => match n { Zero => Succ(m2), Succ(n2) => m2.sub(n2) },
    }
}

designation - at Nat := Nat::sub

theorem Nat::sub_zero(m: Nat): m - 0 = m {
    match m { Zero => refl, Succ(_) => refl }
}

// ---------------------------------------------------------------------------
// The order kit. Read the bodies for what the definition gives away free:
// every fact about `Zero` on the left is `trivial`, every fact that moves a
// `Succ` across BOTH sides is the identity, and every absurd case is a
// hypothesis that already *is* `False`. Those three together are why this
// section has no inversion lemmas and no no-confusion machinery.

theorem Nat::nonneg(self m: Nat): 0 <= m { trivial }

// Doubling reflects order; an extra odd successor on the right does not
// change the comparison. Both proofs are just the two-successor recursion of
// `twice` read alongside the one-successor recursion of `Le`.
fn Nat::TwiceLeTwice(self n, m: Nat) → Type { n.twice() <= m.twice() }
fn Nat::TwiceLeOdd(self n, m: Nat) → Type { n.twice() <= Succ(m.twice()) }

theorem Nat::twice_le_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLeTwice(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(),
            mpr := λ h => m.twice().nonneg()),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_le_twice_iff(self n, m: Nat):
    (n.twice() <= m.twice()) ↔ (n <= m)
{
    Nat::twice_le_twice_iff_curried(n, m)
}

theorem Nat::twice_le_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLeOdd(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(),
            mpr := λ h => (m.twice() + 1).nonneg()),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_le_succ_twice_iff(n, m: Nat):
    (n.twice() <= m.twice() + 1) ↔ (n <= m)
{
    Nat::twice_le_succ_twice_iff_curried(n, m)
}

fn Nat::TwiceLtTwice(self n, m: Nat) → Type { n.twice() < m.twice() }
fn Nat::TwiceLtOdd(self n, m: Nat) → Type { n.twice() < Succ(m.twice()) }

theorem Nat::twice_lt_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLtTwice(m) ↔ n < m)
{
    match n {
        Zero => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(_) => Iff(mp := λ h => trivial, mpr := λ h => trivial),
        },
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_lt_twice_iff(n, m: Nat):
    (n.twice() < m.twice()) ↔ (n < m)
{
    Nat::twice_lt_twice_iff_curried(n, m)
}

theorem Nat::twice_lt_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLtOdd(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(), mpr := λ h => trivial),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_lt_succ_twice_iff(n, m: Nat):
    (n.twice() < m.twice() + 1) ↔ (n <= m)
{
    Nat::twice_lt_succ_twice_iff_curried(n, m)
}

theorem Nat::le_refl(self n: Nat): n <= n { match n { Zero => trivial, Succ(k) => k.le_refl() } }

theorem Nat::not_succ_le_zero(self n: Nat, h: n + 1 <= 0): False { h }

// Both directions of the successor step, and both are the identity function —
// `Le(Succ n, Succ m)` and `Le(n, m)` are the same type. This is the
// definitional inversion the recursive definition is chosen for; stated as
// lemmas anyway, because the API is the kit and downstream never unfolds `Le`.
theorem Nat::le_succ_succ(self n, m: Nat, h: n <= m): n + 1 <= m + 1 { h }
theorem Nat::le_of_succ_succ(self n, m: Nat, h: n + 1 <= m + 1): n <= m { h }

theorem Nat::le_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a <= c) ↔ (b <= d)
{
    rewrite(sym(left), sym(right), iff_refl())
}

theorem Nat::lt_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a < c) ↔ (b < d)
{
    rewrite(sym(left), sym(right), iff_refl())
}

theorem Nat::le_succ_r(self n, m: Nat): n <= m → n <= m + 1 {
    match n {
        Zero => λ h => trivial,
        Succ(k) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢ k.le_succ_r(m2, good),
            },
    }
}

theorem Nat::le_trans(self n, m, l: Nat): n <= m → m <= l → n <= l {
    match n {
        Zero => λ h1 h2 => trivial,
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a =>
                    match l {
                        Zero => λ bad => false_elim(bad),
                        Succ(l2) => λ c => k.le_trans(m2, l2, a, c),
                    },
            },
    }
}

theorem Nat::le_antisym(self n, m: Nat): n <= m → m <= n → n = m {
    match n {
        Zero =>
            match m {
                Zero => λ a b => refl,
                Succ(_) => λ a bad => false_elim(bad),
            },
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a b => Nat::cong_succ(k.le_antisym(m2, a, b)),
            },
    }
}

theorem Nat::le_total(self n, m: Nat): n <= m ∨ m <= n {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(trivial),
                Succ(m2) => k.le_total(m2),
            },
    }
}

// A property symmetric in its two points holds everywhere once it holds
// where the first is the smaller: a case split on `le_total` whose two arms
// are one proof with the roles exchanged, proved once
// (issues/wlog-symmetric-cases.md). `by wlog(m, n, swap, le)`
// (tactic/wlog.hthr) reads `P` off the goal.
theorem Nat::wlog_le(P: Nat → Nat → Type, swap: (a, b: Nat) → P(a, b) → P(b, a),
    le: (a, b: Nat) → a <= b → P(a, b), m, n: Nat): P(m, n) {
    match m.le_total(n) {
        Inl(h) => le(m, n, h),
        Inr(h) => swap(n, m, le(n, m, h)),
    }
}

fn Nat::le_dec(self n, m: Nat) → n <= m ∨ ¬(n <= m) {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(·),
                Succ(m2) => k.le_dec(m2),
            },
    }
}

// Quotient and remainder are computed together while scanning the numerator.
// The state for `k + 1` increments the remainder from the state for `k`,
// carrying into the quotient exactly when it reaches a positive divisor.
// Thus termination is ordinary immediate-predecessor recursion, with no
// runtime fuel and no division-specific termination exception.
inductive DivMod { MkDivMod(quotient: Nat, remainder: Nat) }

fn Nat::divmod_step(divisor_pred: Nat, state: DivMod) → DivMod {
    match state {
        MkDivMod(quotient, remainder) =>
            match Succ(divisor_pred).le_dec(Succ(remainder)) {
                Inl(_) => MkDivMod(Succ(quotient), 0),
                Inr(_) => MkDivMod(quotient, Succ(remainder)),
            },
    }
}

fn Nat::divmod(self n: Nat) → Nat → DivMod {
    match n {
        Zero => λ divisor => MkDivMod(0, 0),
        Succ(k) => λ divisor => match divisor {
            Zero => MkDivMod(0, Succ(k)),
            Succ(d) => Nat::divmod_step(d, k.divmod(Succ(d))),
        },
    }
}

fn Nat::div(self n: Nat, divisor: Nat) → Nat {
    match n.divmod(divisor) { MkDivMod(quotient, _) => quotient }
}

fn Nat::mod(self n: Nat, divisor: Nat) → Nat {
    match n.divmod(divisor) { MkDivMod(_, remainder) => remainder }
}

// Floor division and its remainder, with `n / 0 = 0` and `n % 0 = n`.
designation / at Nat := Nat::div
designation % at Nat := Nat::mod

// The computation above maintains both Euclidean facts in one state.  The
// second field records either the zero-divisor convention (`divisor <= 0`) or
// the strict remainder bound.
fn DivMod::Spec(n, divisor: Nat, state: DivMod) → Type {
    match state {
        MkDivMod(quotient, remainder) =>
            (quotient * divisor + remainder = n) ∧
            (divisor <= 0 ∨ remainder < divisor),
    }
}

// ---------------------------------------------------------------------------
// The bridge between the Boolean decision and the propositional order. `leb`
// and `Le` are the same two-argument recursion written into `Bool` and into
// `Type`.

theorem Nat::leb_sound(self n: Nat): (m: Nat) → n.leb(m).IsTrue() → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

theorem Nat::leb_complete(self n: Nat): (m: Nat) → n <= m → n.leb(m).IsTrue() {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

// The two together: `leb` reflects `<=`, the piece a guard assembled from
// comparisons is reflected from (`bool`'s `reflects_and`, `reflects_iff`).
theorem Nat::leb_reflects(self n, m: Nat): Reflects(n <= m, n.leb(m)) { reflects_of_is_true(n.leb_sound(m), n.leb_complete(m)) }

// The order's `Decide` instance — generic in **both** of its values
// (docs/language/classes/value-generic-instances-design.md, 2026-08-17). Until value binders
// existed the only registrable spelling was `Decide<Le(2, 5)>` at fixed
// numerals, which is precisely the case elaboration-time computation already
// answered; the open one, which is the only one a caller with variables in hand
// has, had no spelling at all.
//
// `n` and `m` are recovered by unifying `Le(n, m)` against the goal, so a use
// site writes neither: `decide<Le(x, h)>()` at open `x` and `h` resolves here.
// This is what lets `list_algos`'s `insert` decide through the class instead of
// naming `le_dec`, which is the measurement issues/value-generic-instances.md
// was filed to take.
//
// Its bit is `leb` and not `or_bit(le_dec(n, m))`, so a decided `<=` is the
// comparison itself: an evidence-free `if n <= m` branches on `n.leb(m)`, and a
// Bool guard built from comparisons is a `decide_bit` of its proposition
// (`decide_intro` / `decide_elim` read it). Equality's bit is `same` the same
// way.
instance(n, m: Nat) Decide<Nat::Le(n, m)> { dec := Nat::le_dec(n, m), bit := n.leb(m), reflects := n.leb_reflects(m) }

// ---------------------------------------------------------------------------
// The strict order. Every one of these is `Le`'s kit read at `Succ(n)`; the
// section is short because `Lt` is a definition rather than a second relation.

theorem Nat::lt_succ_self(self n: Nat): n < n + 1 { n.le_refl() }

theorem Nat::lt_succ_iff_le(self n, m: Nat): n < m + 1 ↔ n <= m {
    Iff(mp := λ (h: n < m + 1) => h, mpr := λ (h: n <= m) => h)
}

theorem Nat::lt_irrefl(self n: Nat): ¬(n < n) {
    match n {
        Zero => λ (h: 0 < 0) => h,
        Succ(k, ih) => λ (h: k + 1 < k + 1) => ih(h),
    }
}

theorem Nat::ne_of_lt(self n, m: Nat, h: n < m): n ≠ m {
    λ equal => n.lt_irrefl(n.lt_congr_iff(n, m, n, refl, sym(equal)).mp(h))
}

theorem Nat::ne_of_gt(self n, m: Nat, h: m < n): n ≠ m {
    λ equal => m.ne_of_lt(n, h, sym(equal))
}

theorem Nat::le_of_lt(self n: Nat): (m: Nat) → n < m → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m =>
            match m {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good => ih(m2, good),
            },
    }
}

// Transitivity of `<` is transitivity of `<=` with one side weakened, and it
// is worth seeing why that is enough: `Lt(n, m)` IS `Le(Succ n, m)`, so the
// chain `Succ(n) <= m <= l` is already the goal.
theorem Nat::lt_trans(self n, m, l: Nat, h1: n < m, h2: m < l): n < l {
    (n + 1).le_trans(m, l, h1, m.le_of_lt(l, h2))
}

theorem Nat::lt_of_le_of_ne(self n: Nat): (m: Nat) → n <= m → n ≠ m → n < m {
    match n {
        Zero => λ m h =>
            match m {
                Zero => false_elim(·(refl)),
                Succ(_) => λ ne => trivial,
            },
        Succ(k, ih) => λ m =>
            match m {
                Zero => λ bad ne => false_elim(bad),
                Succ(m2) => λ a ne =>
                    ih(m2, a, λ (e: k = m2) => ne(Nat::cong_succ(e))),
            },
    }
}

theorem Nat::lt_trichotomy(self n: Nat): (m: Nat) → n < m ∨ n = m ∨ m < n {
    match n {
        Zero => λ m =>
            match m {
                Zero => Inr(Inl(refl)),
                Succ(_) => Inl(trivial),
            },
        Succ(_, ih) => λ m =>
            match m {
                Zero => Inr(Inr(trivial)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(a) => Inl(a),
                        Inr(r) => match r {
                            Inl(e) => Inr(Inl(Nat::cong_succ(e))),
                            Inr(b) => Inr(Inr(b)),
                        },
                    },
            },
    }
}

// Below, or at or above: trichotomy with its last two arms joined.
theorem Nat::lt_or_ge(self n, m: Nat): n < m ∨ m <= n {
    match n.lt_trichotomy(m) {
        Inl(below) => Inl(below),
        Inr(rest) => Inr(match rest {
            Inl(same) => j(same, λ y _ => y <= n, n.le_refl()),
            Inr(above) => m.le_of_lt(n, above),
        }),
    }
}

// A refuted comparison is the other one holding — totality, read backwards.
// This is the propositional successor of `list_algos`'s `leb_false_flip`, and
// the difference is the whole of what going propositional buys: that lemma was
// an induction on `x` with `y` generalized, ending in `leb(y, x) = True`;
// this one is `le_total` with the refuted side resolved away, and it is a line.
theorem Nat::le_of_not_le(n, m: Nat, h: ¬(n <= m)): m <= n {
    or_resolve(or_swap(n.le_total(m)), h)
}

// The strict counterpart is one successor stronger.  It is structural rather
// than a corollary of totality: `¬(m <= n)` computes to exactly the branch in
// which `Succ(n) <= m` holds.
theorem Nat::lt_of_not_le(n: Nat): (m: Nat) → ¬(m <= n) → n < m {
    match n {
        Zero => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(_) => λ h => trivial,
        },
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(k) => λ h => ih(k, h),
        },
    }
}

// Correctness follows the shared state, just like computation does.  Keeping
// the step lemma separate gives its dependent match the precise state it
// consumes and avoids duplicating quotient/remainder reasoning at the public
// projections.
theorem Nat::divmod_step_spec(n, divisor_pred: Nat, state: DivMod,
                         h: DivMod::Spec(n, divisor_pred + 1, state)):
    DivMod::Spec(n + 1, divisor_pred + 1, Nat::divmod_step(divisor_pred, state))
{
    match state as λ s =>
        DivMod::Spec(n, divisor_pred + 1, s) →
        DivMod::Spec(n + 1, divisor_pred + 1, Nat::divmod_step(divisor_pred, s))
    {
        MkDivMod(quotient, remainder) => λ spec => match spec {
            And(reconstruct, alternatives) => match alternatives {
                Inl(impossible) => false_elim(impossible),
                Inr(bounded) =>
                    match (divisor_pred + 1).le_dec(remainder + 1) as λ decision =>
                        DivMod::Spec(
                            n + 1,
                            divisor_pred + 1,
                            match decision {
                                Inl(_) => MkDivMod(quotient + 1, 0),
                                Inr(_) => MkDivMod(quotient, remainder + 1),
                            },
                        )
                    {
                        Inl(carry) => And(
                            calc {
                                (quotient + 1) * (divisor_pred + 1)
                                    = divisor_pred + 1 + quotient * (divisor_pred + 1) :=
                                        quotient.mul_succ_left(divisor_pred + 1),
                                    = quotient * (divisor_pred + 1) + (divisor_pred + 1) :=
                                        (divisor_pred + 1).add_comm(quotient * (divisor_pred + 1)),
                                    = quotient * (divisor_pred + 1) + (remainder + 1) :=
                                        Nat::cong(
                                            λ (x: Nat) =>
                                                quotient * (divisor_pred + 1) + (x + 1),
                                            divisor_pred.le_antisym(remainder, carry, bounded)),
                                    = quotient * (divisor_pred + 1) + remainder + 1 := refl,
                                    = n + 1 := Nat::cong_succ(reconstruct),
                            },
                            Inr(trivial),
                        ),
                        Inr(no_carry) => And(
                            Nat::cong_succ(reconstruct),
                            Inr(remainder.lt_of_not_le(divisor_pred, no_carry)),
                        ),
                    },
            },
        },
    }(h)
}

theorem Nat::divmod_spec(n: Nat): (divisor: Nat) →
    DivMod::Spec(n, divisor, n.divmod(divisor))
{
    match n {
        Zero => λ divisor => match divisor {
            Zero => And(refl, Inl(trivial)),
            Succ(d) => And((d + 1).mul_left_zero(), Inr(trivial)),
        },
        Succ(k, ih) => λ divisor => match divisor {
            Zero => And(Nat::cong_succ(k.add_left_zero()), Inl(trivial)),
            Succ(d) => Nat::divmod_step_spec(k, d, k.divmod(d + 1), ih(d + 1)),
        },
    }
}

// Public Euclidean laws.  Both projections below destruct the one shared
// state, so their `div` and `mod` occurrences are definitionally the same
// quotient and remainder certified by `divmod_spec`.
theorem Nat::div_mul_add_mod(self n, divisor: Nat):
    n.div(divisor) * divisor + n.mod(divisor) = n
{
    match n.divmod(divisor) as λ state =>
        DivMod::Spec(n, divisor, state) →
        match state as λ _ => Type {
            MkDivMod(quotient, remainder) =>
                quotient * divisor + remainder = n,
        }
    {
        MkDivMod(_, _) => λ spec => spec.left,
    }(Nat::divmod_spec(n, divisor))
}

theorem Nat::mod_lt(self n: Nat, divisor: Pos<Nat>):
    n.mod(divisor) < divisor
{
    match divisor as λ d => 0 < d → n.mod(d) < d {
        Zero => λ impossible => false_elim(impossible),
        Succ(d) => λ _ =>
            match n.divmod(d + 1) as λ state =>
                DivMod::Spec(n, d + 1, state) →
                match state as λ _ => Type {
                    MkDivMod(_, remainder) => remainder < d + 1,
                }
            {
                MkDivMod(_, _) => λ spec => match spec.right {
                    Inl(impossible) => false_elim(impossible),
                    Inr(bounded) => bounded,
                },
            }(n.divmod_spec(d + 1)),
    }(divisor_pos)
}

theorem Nat::div_zero(self n: Nat): n.div(0) = 0 {
    match n { Zero => refl, Succ(_) => refl }
}

theorem Nat::mod_zero(self n: Nat): n.mod(0) = n {
    match n { Zero => refl, Succ(_) => refl }
}

// Divisibility follows the executable Euclidean semantics directly. Keeping
// it definitionally equal to a zero-remainder proposition lets arithmetic
// automation consume positive and negated uses without an existential witness.
fn Nat::Divides(self divisor, n: Nat) → Type { n.mod(divisor) = 0 }

// ---------------------------------------------------------------------------
// The two no-confusion facts proved by RECURSION rather than by `inj`/`absurd`.
// Those two special forms want "an equation at a declared inductive type" but `Nat` is a *kernel* type
// so we have to write the injectivity by hand here.
//   - injectivity is `pred`, which undoes `Succ` definitionally, so `Nat::cong`
//     is the whole proof and the statement holds by conversion;
//   - disjointness is a predicate that *separates* the constructors, so
//     transporting its inhabitant along the absurd equation lands in `False`.

// predecessor of a natural, saturating at zero
fn Nat::pred(self n: Nat) → Nat { match n { Zero => 0, Succ(k) => k } }

theorem Nat::succ_inj(n, m: Nat, h: n + 1 = m + 1): n = m { Nat::cong(Nat::pred, h) }

theorem Nat::pred_le(self n: Nat): n.pred() <= n {
    match n { Zero => trivial, Succ(k) => k.le_succ_r(k, k.le_refl()) }
}

theorem Nat::pred_mono(self e: Nat): (d: Nat) → e <= d → e.pred() <= d.pred() {
    match e {
        Zero => λ d _ => trivial,
        Succ(_) => λ d => match d {
            Zero => λ never => false_elim(never),
            Succ(_) => λ le => le,
        },
    }
}

// `IsSucc(Succ k)` is `True` and `IsSucc(0)` is `False`, so the constructors
// are told apart by a type rather than by a generated no-confusion lemma.
fn Nat::IsSucc(self n: Nat) → Type { match n { Zero => False, Succ(_) => True } }

theorem Nat::succ_ne_zero(self n: Nat): n + 1 ≠ 0 {
    λ (h: n + 1 = 0) => j(h, λ y q => y.IsSucc(), trivial)
}

theorem Nat::zero_ne_succ(self n: Nat): 0 ≠ n + 1 {
    λ (h: 0 = n + 1) => n.succ_ne_zero(sym(h))
}

// The equality decider. A `fn` and not a `theorem`: it has to reduce.
//
// It decides by `same` and reads its proofs off `same`'s two laws. `same`
// is a fold the kernel iterates over runs, so at two numerals the decision
// costs their bits; the recursion on both numbers it was before built a
// proof at every successor on the way down, and a client that only asked
// which side it was on (a lookup by key, a register file's search by id)
// paid a number's whole height for it.
//
// Equality instances are keyed by the endpoints' inferred carrier, so this
// registers independently of equality at Bool and every other nominal type
// (docs/language/classes/decidable-equation-carrier-design.md). The generated canonical value
// is deliberately unwritable; ordinary uses reach it through `Decide<n = m>`.
fn Nat::eq_dec(self n: Nat) → (m: Nat) → n = m ∨ n ≠ m {
    λ m => (match n.same(m) as λ bit => n.same(m) = bit → n = m ∨ n ≠ m {
        True => λ equal => Inl(n.same_sound(m, equal)),
        False => λ differ => Inr(n.ne_of_same(m, differ)),
    })(refl)
}

// The equation when `n` and `m` are equal, as data: at two numerals
// it evaluates to `refl`, so a transport along it computes (`eq_dec`'s
// proofs are theorems and never unfold).
fn Nat::equation(self n: Nat) → (m: Nat) → (n = m) ∨ True {
    match n {
        Zero => λ m => match m { Zero => Inl(refl), Succ(_) => Inr(trivial) },
        Succ(k, ih) => λ m => match m {
            Zero => Inr(trivial),
            Succ(m2) => match ih(m2) { Inr(_) => Inr(trivial), Inl(e) => Inl(j(e, λ x _ => Succ(k) = Succ(x), refl)) },
        },
    }
}

// A number's equation with itself is `refl`, at an open number too: a
// transport along `n.equation(n)` computes away.
theorem Nat::equation_self(self n: Nat): n.equation(n) = Inl(refl) {
    match n {
        Zero => refl,
        Succ(k) => j(sym(k.equation_self()), λ d _ =>
            (match d as λ _ => (k + 1 = k + 1) ∨ True { Inr(_) => Inr(trivial), Inl(e) => Inl(j(e, λ x _ => k + 1 = x + 1, refl)) }) = Inl(refl), refl),
    }
}

instance(n, m: Nat) Decide<n = m> { dec := Nat::eq_dec(n, m), bit := n.same(m), reflects := And(n.same_sound(m), λ h => n.ne_of_same(m, h)) }

// The same decision as a property of the carrier, which is what a polymorphic
// container's decider requires of its element type (`logic::DecEq`).
instance DecEq<Nat> { eq_dec := Nat::eq_dec }

// ---------------------------------------------------------------------------
// The bridge to addition — route (c) of docs/library/nat-order-design.md §1, proved
// rather than chosen. `le_add` is the forward half and was already here.

// `Le(n, m)` gives the difference. Induction on `n` with `m` generalized —
// by the elaborator, since 2026-09-05.
theorem Nat::le_add(self n, m: Nat): n <= m → n + (m - n) = m {
    match n {
        Zero => hle ⊢
            apply trans;
            give Nat::cong(λ (x: Nat) => 0 + x, m.sub_zero());
            m.add_left_zero(),
        Succ(n2) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢
                    apply trans;
                    give n2.add_succ_left(m2 - n2);
                    Nat::cong_succ(n2.le_add(m2, good)),
            },
    }
}

// Two values compared by raising both to `n + m`, which is above each of them.

theorem Nat::le_add_l(self n, m: Nat): n <= n + m {
    match m { Zero => n.le_refl(), Succ(m2) => n.le_succ_r(n + m2, n.le_add_l(m2)) }
}

// `add` recurses on its second argument, so this one is the definitional side
theorem Nat::le_add_r(self n, m: Nat): m <= n + m {
    match m { Zero => trivial, Succ(m2) => n.le_add_r(m2) }
}

// The bridge itself: `n <= m` and `∃ k, n + k = m` are interchangeable. The
// forward direction is `le_add` with its witness named; the backward one is
// `le_add_l` transported along the caller's equation. Route (c) of the design
// is therefore available as a *view* at every call site, without being the
// definition — which is what makes the definition swappable later.
theorem Nat::le_iff_exists_add(self n, m: Nat): n <= m ↔ ∃ k: Nat, n + k = m {
    Iff(
        mp := λ (h: n <= m) => Exists(m - n, n.le_add(m, h)),
        mpr := λ (h: ∃ k: Nat, n + k = m) =>
            rewrite(sym(h.proof), n.le_add_l(h.witness)),
    )
}

// ---------------------------------------------------------------------------

theorem Nat::sub_self(self n: Nat): n - n = 0 {
    match n { Zero => refl, Succ(k) => k.sub_self() }
}

theorem Nat::add_sub_cancel(self n, m: Nat): (n + m) - m = n {
    match m { Zero => n.sub_zero(), Succ(k) => n.add_sub_cancel(k) }
}

theorem Nat::sub_add_cancel(self n, m: Nat, h: n <= m): (m - n) + n = m {
    trans((m - n).add_comm(n), n.le_add(m, h))
}

theorem Nat::sub_le(self m: Nat): (n: Nat) → m - n <= m {
    match m {
        Zero => λ n => trivial,
        Succ(m2, ih) => λ n =>
            match n {
                Zero => (m2 + 1).le_refl(),
                Succ(n2) => (m2 - n2).le_succ_r(m2, ih(n2)),
            },
    }
}

// Removing a positive amount from a value strictly lowers it, provided the
// amount was available rather than truncated away.
theorem Nat::sub_lt_of_pos(self m: Nat): (n: Nat) → 0 < n → n <= m → m - n < m {
    match m {
        Zero => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(_) => λ positive bounded => false_elim(bounded),
        },
        Succ(m2) => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(n2) => λ positive bounded => m2.sub_le(n2),
        },
    }
}

// Reversal of the indices below `n`, `k ↦ n - 1 - k`: it stays below `n`
// and is its own inverse (big_operator's `range_reverse`).
theorem Nat::sub_succ_lt(self n, k: Nat, hk: k < n): n - (k + 1) < n { n.sub_lt_of_pos(k + 1, trivial, hk) }

theorem Nat::sub_succ_sub_succ(self n, k: Nat): k < n → n - (n - (k + 1) + 1) = k {
    match n {
        Zero => λ bad => false_elim(bad),
        Succ(m) => λ hk => j(k.le_add(m, hk), λ w _ => w - (m - k) = k, k.add_sub_cancel(m - k)),
    }
}

// ---------------------------------------------------------------------------

theorem Nat::add_le_mono_r(self k: Nat): (n: Nat) → (m: Nat) → n <= m → n + k <= m + k {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem Nat::add_le_mono_l(self k, n, m: Nat, h: n <= m): k + n <= k + m {
    rewrite(k.add_comm(n), k.add_comm(m), k.add_le_mono_r(n, m, h))
}

theorem Nat::add_le_mono(self a, b, c, d: Nat, h1: a <= b, h2: c <= d): a + c <= b + d {
    (a + c).le_trans(b + c, b + d,
             c.add_le_mono_r(a, b, h1), b.add_le_mono_l(c, d, h2))
}

theorem Nat::le_of_add_le_add_r(self k: Nat): (n: Nat) → (m: Nat) → n + k <= m + k → n <= m {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem Nat::le_of_add_le_add_l(self k, n, m: Nat, h: k + n <= k + m): n <= m {
    k.le_of_add_le_add_r(n, m,
        rewrite(n.add_comm(k), m.add_comm(k), h))
}

theorem Nat::mul_le_mono_r(self k: Nat): (n: Nat) → (m: Nat) → n <= m → n * k <= m * k {
    match k {
        Zero => λ n m h => trivial,
        Succ(j, ih) => λ n m h =>
            (n * j).add_le_mono(m * j, n, m, ih(n, m, h), h),
    }
}

theorem Nat::mul_le_mono_l(self k, n, m: Nat, h: n <= m): k * n <= k * m {
    rewrite(k.mul_comm(n), k.mul_comm(m), k.mul_le_mono_r(n, m, h))
}

theorem Nat::mul_le_mono(self a, b, c, d: Nat, h1: a <= b, h2: c <= d): a * c <= b * d {
    (a * c).le_trans(b * c, b * d,
             c.mul_le_mono_r(a, b, h1), b.mul_le_mono_l(c, d, h2))
}

// Multiplying by a positive keeps a strict inequality: k·(n + 1) is k·n + k,
// already past k·n, and at most k·m.
theorem Nat::mul_lt_mono_l(self k, n, m: Nat, hk: 0 < k, h: n < m): k * n < k * m {
    (k * n + 1).le_trans(k * n + k, k * m, (k * n).add_le_mono_l(1, k, hk), k.mul_le_mono_l(n + 1, m, h))
}

// A common left factor cancels from a strict comparison.
theorem Nat::lt_of_mul_lt_mul_l(self k, n, m: Nat, h: k * n < k * m): n < m {
    Nat::lt_of_not_le(n, m, λ le => (k * n).lt_irrefl((k * n + 1).le_trans(k * m, k * n, h, k.mul_le_mono_l(m, n, le))))
}

// A nonzero left factor cancels from an equation
// (issues/cancellative-algebra-api.md): a gap between `n` and `m` would scale
// to one between the products. The generic positive-factor form is
// `OrderedSemiring::mul_cancel_pos_l`; at `Nat`, nonzero and positive agree
// (`Nat::pos_of_ne_zero`).
theorem Nat::pos_of_ne_zero(self k: Nat, h: ¬(k = 0)): 0 < k {
    match k as λ k => ¬(k = 0) → 0 < k {
        Zero => λ h => false_elim(h(refl)),
        Succ(_) => λ h => trivial,
    }(h)
}

theorem Nat::mul_cancel_l(self k, n, m: Nat, hk: ¬(k = 0), h: k * n = k * m): n = m {
    let pos: (0 < k) = k.pos_of_ne_zero(hk);
    match n.lt_trichotomy(m) {
        Inl(lt) => false_elim((k * n).lt_irrefl(j(sym(h), λ right q => k * n < right, k.mul_lt_mono_l(n, m, pos, lt)))),
        Inr(rest) => match rest {
            Inl(eq) => eq,
            Inr(gt) => false_elim((k * m).lt_irrefl(j(h, λ right q => k * m < right, k.mul_lt_mono_l(m, n, pos, gt)))),
        },
    }
}

theorem Nat::mul_cancel_r(self n, m, k: Nat, hk: ¬(k = 0), h: n * k = m * k): n = m {
    k.mul_cancel_l(n, m, hk, trans(sym(n.mul_comm(k)), trans(h, m.mul_comm(k))))
}

// A common right factor cancels from a strict comparison.
theorem Nat::lt_of_mul_lt_mul_r(self a, b, c: Nat, h: a * c < b * c): a < b {
    match b.le_dec(a) {
        Inl(le) => false_elim((a * c).lt_irrefl((a * c + 1).le_trans(b * c, a * c, h, Nat::mul_le_mono_r(c, b, a, le)))),
        Inr(no) => Nat::lt_of_not_le(a, b, no),
    }
}

// The lexicographic order on `(a, r)` flattened into `a * n + r` for `r < n`
// (docs/language/recursion/mutual-recursion-design.md §4): a smaller `a` wins whatever the ranks,
// and an unchanged-or-smaller `a` needs a smaller rank. A mutual `decreases`
// group closes every recursive call's scaled obligation with one of these.
theorem Nat::scaled_lt(self a, b, r, s, n: Nat, h: a < b, q: r < n): a * n + r < b * n + s {
    (a * n + r + 1).le_trans((a + 1) * n, b * n + s,
        rewrite(a.mul_succ_left(n), n.add_comm(a * n), (a * n).add_le_mono_l(r + 1, n, q)),
        ((a + 1) * n).le_trans(b * n, b * n + s,
            n.mul_le_mono_r(a + 1, b, h), (b * n).le_add_l(s)))
}

theorem Nat::scaled_le(self a, b, r, s, n: Nat, h: a <= b, q: r < s): a * n + r < b * n + s {
    (a * n + r + 1).le_trans(a * n + s, b * n + s,
        (a * n).add_le_mono_l(r + 1, s, q),
        s.add_le_mono_r(a * n, b * n, n.mul_le_mono_r(a, b, h)))
}

// ---------------------------------------------------------------------------
// The division kit. Everything here is `div_mod_unique` read at a
// decomposition it names, so a proof about digits or place values cites a
// lemma instead of asking `omega` to expand every `div` and `mod` into a
// quotient, a remainder and their bounds (issues/nat-div-mod-lemma-kit.md).

theorem Nat::add_mul_distr(self a, b, c: Nat): (a + b) * c = a * c + b * c {
    calc {
        (a + b) * c
            = c * (a + b)   := (a + b).mul_comm(c),
            = c * a + c * b := c.mul_add_distr(a, b),
            = a * c + c * b := prelude::cong(c.mul_comm(a)),
            = a * c + b * c := prelude::cong(c.mul_comm(b)),
    }
}

theorem Nat::add_left_cancel(self k, n, m: Nat, h: k + n = k + m): n = m {
    n.le_antisym(m,
        k.le_of_add_le_add_l(n, m, rewrite(sym(h), (k + n).le_refl())),
        k.le_of_add_le_add_l(m, n, rewrite(sym(h), (k + n).le_refl())))
}

// A quotient and remainder that rebuild `n`, with the remainder below the
// divisor, are `div` and `mod`: a larger or smaller quotient would put `n`
// strictly on one side of itself (`scaled_lt`).
theorem Nat::div_mod_unique(self n, divisor, q, r: Nat, parts: q * divisor + r = n, bound: r < divisor):
    (n.div(divisor) = q) ∧ (n.mod(divisor) = r)
{
    let whole: (n.div(divisor) * divisor + n.mod(divisor) = n) = n.div_mul_add_mod(divisor);
    let below: (n.mod(divisor) < divisor) = n.mod_lt(divisor, divisor_pos := (1).le_trans(r + 1, divisor, trivial, bound));
    let same: (n.div(divisor) = q) = match n.div(divisor).lt_trichotomy(q) {
        Inl(smaller) => false_elim(n.lt_irrefl(Nat::lt_congr_iff(
            n.div(divisor) * divisor + n.mod(divisor), n, q * divisor + r, n, whole, parts).mp(
                n.div(divisor).scaled_lt(q, n.mod(divisor), r, divisor, smaller, below)))),
        Inr(rest) => match rest {
            Inl(equal) => equal,
            Inr(larger) => false_elim(n.lt_irrefl(Nat::lt_congr_iff(
                q * divisor + r, n, n.div(divisor) * divisor + n.mod(divisor), n, parts, whole).mp(
                    q.scaled_lt(n.div(divisor), r, n.mod(divisor), divisor, larger, bound)))),
        },
    };
    And(same, (q * divisor).add_left_cancel(n.mod(divisor), r,
        trans(trans(sym(Nat::cong(λ (x: Nat) => x * divisor + n.mod(divisor), same)), whole), sym(parts))))
}

theorem Nat::div_of_lt(self n, divisor: Nat, h: n < divisor): n.div(divisor) = 0 {
    n.div_mod_unique(divisor, 0, n,
        trans(Nat::cong(λ (x: Nat) => x + n, divisor.mul_left_zero()), n.add_left_zero()), h).left
}

theorem Nat::mod_of_lt(self n, divisor: Nat, h: n < divisor): n.mod(divisor) = n {
    n.div_mod_unique(divisor, 0, n,
        trans(Nat::cong(λ (x: Nat) => x + n, divisor.mul_left_zero()), n.add_left_zero()), h).right
}

theorem Nat::div_one(self n: Nat): n.div(1) = n { n.div_mod_unique(1, n, 0, n.add_left_zero(), trivial).left }

theorem Nat::mod_one(self n: Nat): n.mod(1) = 0 { n.div_mod_unique(1, n, 0, n.add_left_zero(), trivial).right }

// A quotient bounded through its divisor: `n < d * k` leaves fewer than `k`
// whole `d`s in `n`. No positivity premise: at `d = 0` the bound is false.
theorem Nat::div_lt_of_lt_mul(self n, d, k: Nat, h: n < d * k): n.div(d) < k {
    match k.le_dec(n.div(d)) {
        Inl(enough) => false_elim(n.lt_irrefl((n + 1).le_trans(d * k, n, h,
            (d * k).le_trans(n.div(d) * d, n,
                rewrite(n.div(d).mul_comm(d), d.mul_le_mono_l(k, n.div(d), enough)),
                rewrite(sym(n.div_mul_add_mod(d)), (n.div(d) * d).le_add_l(n.mod(d)), at := 2))))),
        Inr(short) => n.div(d).lt_of_not_le(k, short),
    }
}

// The converse direction: `k` whole `d`s fit in `n` when `d * k` does.
theorem Nat::le_div_of_mul_le(self n: Nat, d: Pos<Nat>, k: Nat, h: d * k <= n): k <= n.div(d) {
    match k.le_dec(n.div(d)) {
        Inl(fits) => fits,
        Inr(short) => false_elim(n.lt_irrefl((n + 1).le_trans(d * (n.div(d) + 1), n,
            j(n.div_mul_add_mod(d), λ y _ => y + 1 <= d * n.div(d) + d,
                rewrite(sym(n.div(d).mul_comm(d)),
                    (n.div(d) * d).add_le_mono_l(n.mod(d) + 1, d, n.mod_lt(d)))),
            (d * (n.div(d) + 1)).le_trans(d * k, n, d.mul_le_mono_l(n.div(d) + 1, k, n.div(d).lt_of_not_le(k, short)), h)))),
    }
}

// Dividing by `a` and then by `b` is dividing by `a * b`, and what the
// larger divisor leaves is both remainders, the outer one scaled by `a`. The
// three nesting laws after it are this pair read one way each.
theorem Nat::div_mul_parts(self n: Nat, a, b: Pos<Nat>):
    (n.div(a * b) = n.div(a).div(b)) ∧ (n.mod(a * b) = n.div(a).mod(b) * a + n.mod(a))
{
    n.div_mod_unique(a * b, n.div(a).div(b), n.div(a).mod(b) * a + n.mod(a),
        calc {
            n.div(a).div(b) * (a * b) + (n.div(a).mod(b) * a + n.mod(a))
                = (n.div(a).div(b) * (a * b) + n.div(a).mod(b) * a) + n.mod(a) :=
                    sym((n.div(a).div(b) * (a * b)).add_assoc(n.div(a).mod(b) * a, n.mod(a))),
                = (n.div(a).div(b) * (b * a) + n.div(a).mod(b) * a) + n.mod(a) := prelude::cong(a.mul_comm(b)),
                = ((n.div(a).div(b) * b) * a + n.div(a).mod(b) * a) + n.mod(a) :=
                    prelude::cong(sym(n.div(a).div(b).mul_assoc(b, a))),
                = (n.div(a).div(b) * b + n.div(a).mod(b)) * a + n.mod(a) :=
                    prelude::cong(sym((n.div(a).div(b) * b).add_mul_distr(n.div(a).mod(b), a))),
                = n.div(a) * a + n.mod(a) := prelude::cong(n.div(a).div_mul_add_mod(b)),
                = n := n.div_mul_add_mod(a),
        },
        Nat::lt_congr_iff(n.div(a).mod(b) * a + n.mod(a), n.div(a).mod(b) * a + n.mod(a), b * a + 0, a * b,
            refl, b.mul_comm(a)).mp(
                n.div(a).mod(b).scaled_lt(b, n.mod(a), 0, a, n.div(a).mod_lt(b), n.mod_lt(a))))
}

theorem Nat::div_div(self n: Nat, a, b: Pos<Nat>): n.div(a).div(b) = n.div(a * b) {
    sym(n.div_mul_parts(a, b).left)
}

// Reducing modulo a multiple of `a` first changes nothing modulo `a`.
theorem Nat::mod_mul_mod(self n: Nat, a, b: Pos<Nat>): n.mod(a * b).mod(a) = n.mod(a) {
    trans(Nat::cong(λ (x: Nat) => x.mod(a), n.div_mul_parts(a, b).right),
        (n.div(a).mod(b) * a + n.mod(a)).div_mod_unique(a, n.div(a).mod(b), n.mod(a), refl, n.mod_lt(a)).right)
}

// A middle digit, read either end first.
theorem Nat::div_mod_eq_mod_div(self n: Nat, a, b: Pos<Nat>): n.div(a).mod(b) = n.mod(a * b).div(a) {
    sym(trans(Nat::cong(λ (x: Nat) => x.div(a), n.div_mul_parts(a, b).right),
        (n.div(a).mod(b) * a + n.mod(a)).div_mod_unique(a, n.div(a).mod(b), n.mod(a), refl, n.mod_lt(a)).left))
}

// Place value: the count of `c`s in `n` is `k` for every whole `c * k`, plus
// the `c`s in what is left of it.
theorem Nat::div_split(self n: Nat, c, k: Pos<Nat>): n.div(c) = n.div(c * k) * k + n.mod(c * k).div(c) {
    calc {
        n.div(c)
            = n.div(c).div(k) * k + n.div(c).mod(k) := sym(n.div(c).div_mul_add_mod(k)),
            = n.div(c * k) * k + n.div(c).mod(k) := prelude::cong(n.div_div(c, k)),
            = n.div(c * k) * k + n.mod(c * k).div(c) := prelude::cong(n.div_mod_eq_mod_div(c, k)),
    }
}

// ---------------------------------------------------------------------------
// Congruence modulo a divisor (issues/machine-words-modular-ring.md). A
// multiple of the divisor added anywhere changes no remainder
// (`add_mul_mod`), and every law here is that read at the decomposition
// `div_mul_add_mod` names: reduction commutes with `+`, `*` and powers.
// `ModEq(m, a, b)` is equality of remainders, so its compatibility laws are
// these, and machine words (`BitVec(n)`, ℤ/2ⁿ) are read through them.

theorem Nat::add_right_comm(self a, b, c: Nat): (a + b) + c = (a + c) + b {
    trans(a.add_assoc(b, c), trans(Nat::cong(λ (x: Nat) => a + x, b.add_comm(c)), sym(a.add_assoc(c, b))))
}

theorem Nat::add_mul_mod(self n: Nat, d: Pos<Nat>, k: Nat): (n + k * d).mod(d) = n.mod(d) {
    (n + k * d).div_mod_unique(d, n.div(d) + k, n.mod(d),
        calc {
            (n.div(d) + k) * d + n.mod(d)
                = (n.div(d) * d + k * d) + n.mod(d) := prelude::cong(n.div(d).add_mul_distr(k, d)),
                = (n.div(d) * d + n.mod(d)) + k * d := (n.div(d) * d).add_right_comm(k * d, n.mod(d)),
                = n + k * d := prelude::cong(n.div_mul_add_mod(d)),
        },
        n.mod_lt(d)).right
}

theorem Nat::mul_mod_self(self k: Nat, d: Pos<Nat>): (k * d).mod(d) = 0 {
    trans(Nat::cong(λ (x: Nat) => x.mod(d), sym((k * d).add_left_zero())), (0).add_mul_mod(d, k))
}

theorem Nat::mod_self(self d: Pos<Nat>): d.mod(d) = 0 {
    trans(Nat::cong(λ (x: Nat) => x.mod(d), sym(d.mul_left_one())), (1).mul_mod_self(d))
}

theorem Nat::mod_mod(self n: Nat, d: Pos<Nat>): n.mod(d).mod(d) = n.mod(d) {
    n.mod(d).mod_of_lt(d, n.mod_lt(d))
}

// Reducing one summand first changes nothing.
theorem Nat::mod_add_mod(self a, b: Nat, d: Pos<Nat>): (a.mod(d) + b).mod(d) = (a + b).mod(d) {
    let whole: (a.mod(d) + b + a.div(d) * d = a + b) = calc {
        a.mod(d) + b + a.div(d) * d
            = a.mod(d) + a.div(d) * d + b := a.mod(d).add_right_comm(b, a.div(d) * d),
            = a.div(d) * d + a.mod(d) + b := prelude::cong(a.mod(d).add_comm(a.div(d) * d)),
            = a + b := prelude::cong(a.div_mul_add_mod(d)),
    };
    trans(sym((a.mod(d) + b).add_mul_mod(d, a.div(d))), Nat::cong(λ (x: Nat) => x.mod(d), whole))
}

theorem Nat::add_mod_mod(self a, b: Nat, d: Pos<Nat>): (a + b.mod(d)).mod(d) = (a + b).mod(d) {
    trans(Nat::cong(λ (x: Nat) => x.mod(d), a.add_comm(b.mod(d))),
        trans(b.mod_add_mod(a, d), Nat::cong(λ (x: Nat) => x.mod(d), b.add_comm(a))))
}

theorem Nat::add_mod(self a, b: Nat, d: Pos<Nat>): (a + b).mod(d) = (a.mod(d) + b.mod(d)).mod(d) {
    sym(trans(a.mod_add_mod(b.mod(d), d), a.add_mod_mod(b, d)))
}

// The same for products. (`mod_mul_mod` above is the other law, about a
// divisor's multiple.)
theorem Nat::mul_mod_left(self a, b: Nat, d: Pos<Nat>): (a.mod(d) * b).mod(d) = (a * b).mod(d) {
    let whole: (a.mod(d) * b + (a.div(d) * b) * d = a * b) = calc {
        a.mod(d) * b + (a.div(d) * b) * d
            = a.mod(d) * b + a.div(d) * (b * d) := prelude::cong(a.div(d).mul_assoc(b, d)),
            = a.mod(d) * b + a.div(d) * (d * b) := prelude::cong(b.mul_comm(d)),
            = a.mod(d) * b + (a.div(d) * d) * b := prelude::cong(sym(a.div(d).mul_assoc(d, b))),
            = (a.div(d) * d) * b + a.mod(d) * b := (a.mod(d) * b).add_comm((a.div(d) * d) * b),
            = (a.div(d) * d + a.mod(d)) * b := sym((a.div(d) * d).add_mul_distr(a.mod(d), b)),
            = a * b := prelude::cong(a.div_mul_add_mod(d)),
    };
    trans(sym((a.mod(d) * b).add_mul_mod(d, a.div(d) * b)), Nat::cong(λ (x: Nat) => x.mod(d), whole))
}

theorem Nat::mul_mod_right(self a, b: Nat, d: Pos<Nat>): (a * b.mod(d)).mod(d) = (a * b).mod(d) {
    trans(Nat::cong(λ (x: Nat) => x.mod(d), a.mul_comm(b.mod(d))),
        trans(b.mul_mod_left(a, d), Nat::cong(λ (x: Nat) => x.mod(d), b.mul_comm(a))))
}

theorem Nat::mul_mod(self a, b: Nat, d: Pos<Nat>): (a * b).mod(d) = (a.mod(d) * b.mod(d)).mod(d) {
    sym(trans(a.mul_mod_left(b.mod(d), d), a.mul_mod_right(b, d)))
}

// What a divisor's multiple leaves, its divisor leaves too. No positivity
// for `k`: at `k = 0` both sides reduce modulo `m` alone.
theorem Nat::mod_mod_of_dvd(self x, k: Nat, m: Pos<Nat>, h: m.Divides(k)): x.mod(k).mod(m) = x.mod(m) {
    let c = k.div(m);
    let k_eq: (c * m = k) = j(h, λ y _ => c * m + y = k, k.div_mul_add_mod(m));
    let whole: (x.mod(k) + (x.div(k) * c) * m = x) = calc {
        x.mod(k) + (x.div(k) * c) * m
            = x.mod(k) + x.div(k) * (c * m) := prelude::cong(x.div(k).mul_assoc(c, m)),
            = x.mod(k) + x.div(k) * k := prelude::cong(k_eq),
            = x.div(k) * k + x.mod(k) := x.mod(k).add_comm(x.div(k) * k),
            = x := x.div_mul_add_mod(k),
    };
    trans(sym(x.mod(k).add_mul_mod(m, x.div(k) * c)), Nat::cong(λ (y: Nat) => y.mod(m), whole))
}

// Congruence modulo `m`: equal remainders. At `m = 0` it is equality.
fn Nat::ModEq(m, a, b: Nat) → Type { a.mod(m) = b.mod(m) }

theorem Nat::modeq_refl(m, a: Nat): Nat::ModEq(m, a, a) { refl }

theorem Nat::modeq_symm({m, a, b: Nat}, h: Nat::ModEq(m, a, b)): Nat::ModEq(m, b, a) { sym(h) }

theorem Nat::modeq_trans({m, a, b, c: Nat}, h1: Nat::ModEq(m, a, b), h2: Nat::ModEq(m, b, c)): Nat::ModEq(m, a, c) {
    trans(h1, h2)
}

// A number is congruent to its remainder.
theorem Nat::modeq_mod(self a: Nat, m: Pos<Nat>): Nat::ModEq(m, a.mod(m), a) { a.mod_mod(m) }

theorem Nat::modeq_add(m: Pos<Nat>, {a, b, c, d: Nat}, h1: Nat::ModEq(m, a, b), h2: Nat::ModEq(m, c, d)):
    Nat::ModEq(m, a + c, b + d)
{
    calc {
        (a + c).mod(m)
            = (a.mod(m) + c.mod(m)).mod(m) := a.add_mod(c, m),
            = (b.mod(m) + c.mod(m)).mod(m) := Nat::cong(λ (x: Nat) => (x + c.mod(m)).mod(m), h1),
            = (b.mod(m) + d.mod(m)).mod(m) := Nat::cong(λ (x: Nat) => (b.mod(m) + x).mod(m), h2),
            = (b + d).mod(m) := sym(b.add_mod(d, m)),
    }
}

theorem Nat::modeq_mul(m: Pos<Nat>, {a, b, c, d: Nat}, h1: Nat::ModEq(m, a, b), h2: Nat::ModEq(m, c, d)):
    Nat::ModEq(m, a * c, b * d)
{
    calc {
        (a * c).mod(m)
            = (a.mod(m) * c.mod(m)).mod(m) := a.mul_mod(c, m),
            = (b.mod(m) * c.mod(m)).mod(m) := Nat::cong(λ (x: Nat) => (x * c.mod(m)).mod(m), h1),
            = (b.mod(m) * d.mod(m)).mod(m) := Nat::cong(λ (x: Nat) => (b.mod(m) * x).mod(m), h2),
            = (b * d).mod(m) := sym(b.mul_mod(d, m)),
    }
}

// Adding a multiple of the modulus, on either side, is congruent.
theorem Nat::modeq_add_mul(self a: Nat, m: Pos<Nat>, k: Nat): Nat::ModEq(m, a + k * m, a) { a.add_mul_mod(m, k) }

// ---------------------------------------------------------------------------

fn Nat::max(self a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => b,
        Succ(k) => λ (b: Nat) => match b { Zero => Succ(k), Succ(l) => Succ(k.max(l)) },
    }
}

fn Nat::min(self a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => 0,
        Succ(k) => λ (b: Nat) => match b { Zero => 0, Succ(l) => Succ(k.min(l)) },
    }
}

// The bounds. Each is an induction on the left argument with the right one
// generalized, and each has one arm that is `trivial` because `Zero` is below
// everything and one that is the IH at the shed successor.

theorem Nat::le_max_l(self a: Nat): (b: Nat) → a <= a.max(b) {
    match a {
        Zero => λ b => trivial,
        Succ(k, ih) => λ b =>
            match b {
                Zero => (k + 1).le_refl(),
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::le_max_r(self a: Nat): (b: Nat) → b <= a.max(b) {
    match a {
        Zero => λ b => b.le_refl(),
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::min_le_l(self a: Nat): (b: Nat) → a.min(b) <= a {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::min_le_r(self a: Nat): (b: Nat) → a.min(b) <= b {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

// The universal properties, which are what make the two functions a *lattice*
// rather than two functions with bounds: `max` is the least upper bound and
// `min` the greatest lower one. Three case analyses each, because the goal
// mentions all three values and the hypotheses have to be convoyed past two of
// them; no arithmetic in any arm.

theorem Nat::max_le(self a: Nat): (b: Nat) → (c: Nat) → a <= c → b <= c → a.max(b) <= c {
    match a {
        Zero => λ b c h1 h2 => h2,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a1,
                Succ(l) =>
                    match c {
                        Zero => λ bad a2 => false_elim(bad),
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

theorem Nat::le_min(a: Nat): (b: Nat) → (c: Nat) → c <= a → c <= b → c <= a.min(b) {
    match a {
        Zero => λ b c h1 h2 => h1,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a2,
                Succ(l) =>
                    match c {
                        Zero => λ a1 a2 => trivial,
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

theorem Nat::max_eq_r(self a: Nat): (b: Nat) → a <= b → a.max(b) = b {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => Nat::cong_succ(ih(l, good)),
            },
    }
}

theorem Nat::max_eq_l(self a, b: Nat, above: b <= a): a.max(b) = a {
    Nat::le_antisym(a.max(b), a, a.max_le(b, a, a.le_refl(), above), a.le_max_l(b))
}

theorem Nat::min_eq_l(a: Nat): (b: Nat) → a <= b → a.min(b) = a {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => Nat::cong_succ(ih(l, good)),
            },
    }
}

theorem Nat::min_eq_r(a, b: Nat, below: b <= a): a.min(b) = b {
    Nat::le_antisym(a.min(b), b, a.min_le_r(b), Nat::le_min(a, b, b, below, b.le_refl()))
}

theorem Nat::sub_zero_of_le(self m: Nat): (n: Nat) → m <= n → m - n = 0 {
    match m {
        Zero => λ n _ => refl,
        Succ(k, ih) => λ n => match n {
            Zero => λ no => false_elim(k.not_succ_le_zero(no)),
            Succ(l) => λ below => ih(l, Nat::le_of_succ_succ(k, l, below)),
        },
    }
}

// Clamping to a bound and then counting what is left of it: the same as
// not clamping.
// Subtraction against an addition, in the two directions a bound needs.
theorem Nat::sub_sub_self(self n, m: Nat, h: m <= n): n - (n - m) = m {
    let k = n - m;
    let whole: (n = m + k) = sym(trans(m.add_comm(k), m.sub_add_cancel(n, h)));
    trans(Nat::cong(λ (y: Nat) => y - k, whole), m.add_sub_cancel(k))
}

theorem Nat::sub_le_of_le_add(self n, m, k: Nat, h: n <= k + m): n - m <= k {
    match n.lt_or_ge(m) {
        Inl(lt) => j(sym(n.sub_zero_of_le(m, Nat::le_of_lt(n, m, lt))), λ y _ => y <= k, trivial),
        Inr(ge) => m.le_of_add_le_add_r(n - m, k, j(sym(m.sub_add_cancel(n, ge)), λ y _ => y <= k + m, h)),
    }
}

theorem Nat::le_sub_of_add_le(self k, m, n: Nat, h: m + k <= n): k <= n - m {
    let fits: (m <= n) = Nat::le_trans(m, m + k, n, m.le_add_l(k), h);
    m.le_of_add_le_add_r(k, n - m,
        j(sym(m.sub_add_cancel(n, fits)), λ y _ => k + m <= y, j(m.add_comm(k), λ y _ => y <= n, h)))
}

theorem Nat::sub_min(c, f: Nat): c - f.min(c) = c - f {
    match f.le_total(c) {
        Inl(below) => Nat::cong(λ (x: Nat) => c - x, Nat::min_eq_l(f, c, below)),
        Inr(above) => trans(Nat::cong(λ (x: Nat) => c - x, Nat::min_eq_r(f, c, above)),
            trans(c.sub_self(), sym(c.sub_zero_of_le(f, above)))),
    }
}

// Order through a sum and a difference, by steps rather than by `omega`:
// a proof over large closed terms cites these at the cost of a conversion
// of its own facts, where a decision procedure's certificate unfolds them.
theorem Nat::lt_of_lt_of_le(self a, b, c: Nat, h1: a < b, h2: b <= c): a < c { Nat::le_trans(a + 1, b, c, h1, h2) }

theorem Nat::lt_of_add_lt(self a, b, c: Nat, h: a + b < c): a < c {
    Nat::le_trans(a + 1, a + b + 1, c, Nat::le_succ_succ(a, a + b, a.le_add_l(b)), h)
}

theorem Nat::le_of_add_le(self a, b, c: Nat, h: a + b <= c): a <= c { Nat::le_trans(a, a + b, c, a.le_add_l(b), h) }

theorem Nat::add_lt_of_lt_sub(self a, b, c: Nat, h: b < c - a): a + b < c {
    match a.le_total(c) {
        Inl(fits) => j(a.le_add(c, fits), λ x _ => a + b + 1 <= x, a.add_le_mono_l(b + 1, c - a, h)),
        Inr(past) => false_elim(b.not_succ_le_zero(j(c.sub_zero_of_le(a, past), λ x _ => b + 1 <= x, h))),
    }
}

// ---------------------------------------------------------------------------
// Divisibility: the few closure facts, each from the remainder laws.

theorem Nat::dvd_refl(self a: Pos<Nat>): a.Divides(a) { a.mod_self() }

theorem Nat::dvd_zero(self a: Nat): a.Divides(0) { match a { Zero => refl, Succ(_) => refl } }

theorem Nat::dvd_mul_left(self a: Pos<Nat>, k: Nat): a.Divides(k * a) { k.mul_mod_self(a) }

// A multiple is its quotient times the divisor.
theorem Nat::div_mul_of_dvd(self n, a: Nat, h: a.Divides(n)): n.div(a) * a = n {
    j(h, λ r _ => n.div(a) * a + r = n, n.div_mul_add_mod(a))
}

theorem Nat::dvd_add(self a: Pos<Nat>, {n, m: Nat}, hn: a.Divides(n), hm: a.Divides(m)): a.Divides(n + m) {
    calc {
        (n + m).mod(a)
            = (n.mod(a) + m.mod(a)).mod(a) := n.add_mod(m, a),
            = (0 + m.mod(a)).mod(a) := Nat::cong(λ (r: Nat) => (r + m.mod(a)).mod(a), hn),
            = (0 + 0).mod(a) := Nat::cong(λ (r: Nat) => (0 + r).mod(a), hm),
            = 0 := (0).mod_of_lt(a, a_pos),
    }
}

theorem Nat::dvd_trans(self a: Pos<Nat>, {b, c: Nat}, hb: a.Divides(b), hc: b.Divides(c)): a.Divides(c) {
    calc {
        c.mod(a)
            = c.mod(b).mod(a) := sym(c.mod_mod_of_dvd(b, a, hb)),
            = (0).mod(a) := Nat::cong(λ (r: Nat) => r.mod(a), hc),
            = 0 := (0).mod_of_lt(a, a_pos),
    }
}

theorem Nat::dvd_mul_right(self a: Pos<Nat>, {n: Nat}, k: Nat, h: a.Divides(n)): a.Divides(k * n) {
    calc {
        (k * n).mod(a)
            = (k * n.mod(a)).mod(a) := sym(k.mul_mod_right(n, a)),
            = (k * 0).mod(a) := Nat::cong(λ (r: Nat) => (k * r).mod(a), h),
            = 0 := (0).mod_of_lt(a, a_pos),
    }
}

// Two multiples less than a divisor apart are in order.
theorem Nat::le_of_dvd_of_lt_add(self n, m: Nat, a: Pos<Nat>, hn: a.Divides(n), hm: a.Divides(m), near: n < m + a): n <= m {
    let scaled: n.div(a) * a < (m.div(a) + 1) * a = (Nat::lt_congr_iff(n, n.div(a) * a, m + a, (m.div(a) + 1) * a,
        sym(n.div_mul_of_dvd(a, hn)),
        calc {
            m + a
                = m.div(a) * a + a := Nat::cong(λ (x: Nat) => x + a, sym(m.div_mul_of_dvd(a, hm))),
                = a + m.div(a) * a := (m.div(a) * a).add_comm(a),
                = (m.div(a) + 1) * a := sym(m.div(a).mul_succ_left(a)),
        })).mp(near);
    let quotients: n.div(a) <= m.div(a) = n.div(a).lt_of_mul_lt_mul_r(m.div(a) + 1, a, scaled);
    (Nat::le_congr_iff(n.div(a) * a, n, m.div(a) * a, m, n.div_mul_of_dvd(a, hn), m.div_mul_of_dvd(a, hm)))
        .mp(a.mul_le_mono_r(n.div(a), m.div(a), quotients))
}

// ---------------------------------------------------------------------------
// Rounding up to a multiple.

// How far `n` is below the next multiple of `a`: what is added to `n` to
// align it. Nothing where `a` is zero.
fn Nat::padding(self n, a: Nat) → Nat { (a - n.mod(a)).mod(a) }

// The least multiple of `a` that is at least `n`.
fn Nat::round_up(self n, a: Nat) → Nat { n + n.padding(a) }

theorem Nat::padding_lt(self n: Nat, a: Pos<Nat>): n.padding(a) < a { (a - n.mod(a)).mod_lt(a) }

theorem Nat::padding_of_dvd(self n: Nat, a: Pos<Nat>, h: a.Divides(n)): n.padding(a) = 0 {
    calc {
        (a - n.mod(a)).mod(a)
            = (a - 0).mod(a) := Nat::cong(λ (r: Nat) => (a - r).mod(a), h),
            = a.mod(a) := Nat::cong(λ (x: Nat) => x.mod(a), Nat::sub_zero(a)),
            = 0 := a.mod_self(),
    }
}

theorem Nat::le_round_up(self n, a: Nat): n <= n.round_up(a) { n.le_add_l(n.padding(a)) }

theorem Nat::round_up_lt(self n: Nat, a: Pos<Nat>): n.round_up(a) < n + a {
    n.add_le_mono_l(n.padding(a) + 1, a, n.padding_lt(a))
}

theorem Nat::round_up_dvd(self n: Nat, a: Pos<Nat>): a.Divides(n.round_up(a)) {
    calc {
        (n + (a - n.mod(a)).mod(a)).mod(a)
            = (n + (a - n.mod(a))).mod(a) := n.add_mod_mod(a - n.mod(a), a),
            = (n.mod(a) + (a - n.mod(a))).mod(a) := sym(n.mod_add_mod(a - n.mod(a), a)),
            = a.mod(a) := Nat::cong(λ (x: Nat) => x.mod(a), n.mod(a).le_add(a, n.mod(a).le_of_lt(a, n.mod_lt(a)))),
            = 0 := a.mod_self(),
    }
}

theorem Nat::round_up_of_dvd(self n: Nat, a: Pos<Nat>, h: a.Divides(n)): n.round_up(a) = n {
    Nat::cong(λ (p: Nat) => n + p, n.padding_of_dvd(a, h))
}

// No multiple of `a` is between `n` and `n.round_up(a)`.
theorem Nat::round_up_least(self n: Nat, a: Pos<Nat>, {m: Nat}, hm: a.Divides(m), above: n <= m): n.round_up(a) <= m {
    n.round_up(a).le_of_dvd_of_lt_add(m, a, n.round_up_dvd(a), hm,
        n.round_up(a).lt_of_lt_of_le(n + a, m + a, n.round_up_lt(a), a.add_le_mono_r(n, m, above)))
}

theorem Nat::round_up_round_up(self n: Nat, a: Pos<Nat>): n.round_up(a).round_up(a) = n.round_up(a) {
    n.round_up(a).round_up_of_dvd(a, n.round_up_dvd(a))
}

theorem Nat::round_up_mono(self n: Nat, a: Pos<Nat>, {m: Nat}, h: n <= m): n.round_up(a) <= m.round_up(a) {
    n.round_up_least(a, m.round_up_dvd(a), n.le_trans(m, m.round_up(a), h, m.le_round_up(a)))
}

// ---------------------------------------------------------------------------

fn Nat::pow(self a: Nat, b: Nat) → Nat { match b { Zero => 1, Succ(k) => a.pow(k) * a } }
// `a ^ b`, the spelling a diagnostic shows a power by
// (issues/diagnostic-operator-resugaring.md).
designation ^ at Nat := Nat::pow

theorem Nat::pow_zero(self a: Nat): a.pow(0) = 1 { refl }
theorem Nat::pow_one(self a: Nat): a.pow(1) = a { a.mul_left_one() }

theorem Nat::one_pow(self n: Nat): (1).pow(n) = 1 {
    match n { Zero => refl, Succ(k) => Nat::cong(λ (w: Nat) => w * 1, k.one_pow()) }
}

theorem Nat::pow_add(self a: Nat, b, c: Nat): a.pow(b + c) = a.pow(b) * a.pow(c) {
    match c {
        Zero => sym(a.pow(b).add_left_zero()),
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w * a, a.pow_add(b, k));
            a.pow(b).mul_assoc(a.pow(k), a),
    }
}

theorem Nat::pow_mul(self a: Nat, b, c: Nat): a.pow(b * c) = a.pow(b).pow(c) {
    match c {
        Zero => refl,
        Succ(k) => calc {
            a.pow(b * (k + 1))
                = a.pow(b * k) * a.pow(b) := a.pow_add(b * k, b),
                = a.pow(b).pow(k) * a.pow(b) := prelude::cong(a.pow_mul(b, k)),
                = a.pow(b).pow(k + 1)           := refl,
        },
    }
}

theorem Nat::mul_shuffle(x, y, z, w: Nat): (x * y) * (z * w) = (x * z) * (y * w) {
    calc {
        (x * y) * (z * w)
            = (x * (y * (z * w))) := x.mul_assoc(y, z * w),
            = (x * ((y * z) * w)) := prelude::cong(sym(y.mul_assoc(z, w))),
            = (x * ((z * y) * w)) := prelude::cong(y.mul_comm(z)),
            = (x * (z * (y * w))) := prelude::cong(z.mul_assoc(y, w)),
            = ((x * z) * (y * w)) := sym(x.mul_assoc(z, y * w)),
    }
}

theorem Nat::mul_pow(self a, b, n: Nat): (a * b).pow(n) = a.pow(n) * b.pow(n) {
    match n {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w * (a * b), a.mul_pow(b, k));
            Nat::mul_shuffle(a.pow(k), b.pow(k), a, b),
    }
}

theorem Nat::one_le_pow(self a, n: Nat, h: 1 <= a): 1 <= a.pow(n) {
    match n {
        Zero => trivial,
        Succ(k) => (1).mul_le_mono(a.pow(k), 1, a, a.one_le_pow(k, h), h),
    }
}

// A positive power is at least its base.
theorem Nat::le_pow_self(self a, n: Nat, ha: 1 <= a, hn: 1 <= n): a <= a.pow(n) {
    match n as λ m => 1 <= m → a <= a.pow(m) {
        Zero => λ h => false_elim(h),
        Succ(k) => λ _ => j(a.mul_left_one(), λ y _ => y <= a.pow(k) * a,
            (1).mul_le_mono(a.pow(k), a, a, a.one_le_pow(k, ha), a.le_refl())),
    }(hn)
}

// Powers of a base at least one grow with the exponent.
theorem Nat::pow_le_pow_add(self a, i: Nat, ha: 1 <= a, d: Nat): a.pow(i) <= a.pow(i + d) {
    match d {
        Zero => a.pow(i).le_refl(),
        Succ(e) => {
            let ih: (a.pow(i) <= a.pow(i + e)) = a.pow_le_pow_add(i, ha, e);
            let grow: (a.pow(i + e) * 1 <= a.pow(i + e) * a) = a.pow(i + e).mul_le_mono_l(1, a, ha);
            let step: (a.pow(i + e) <= a.pow(i + e) * a) = j(a.pow(i + e).add_left_zero(), λ y _ => y <= a.pow(i + e) * a, grow);
            a.pow(i).le_trans(a.pow(i + e), a.pow(i + e) * a, ih, step)
        },
    }
}

theorem Nat::pow_le_pow_r(self a, i, k: Nat, ha: 1 <= a, h: i <= k): a.pow(i) <= a.pow(k) {
    j(i.le_add(k, h), λ y _ => a.pow(i) <= a.pow(y), a.pow_le_pow_add(i, ha, k - i))
}

fn Nat::fact(self n: Nat) → Nat { match n { Zero => 1, Succ(k) => Succ(k) * k.fact() } }

theorem Nat::fact_zero(): (0).fact() = 1 { refl }

theorem Nat::fact_pos(n: Nat): 0 < n.fact() {
    match n {
        Zero => trivial,
        Succ(k) => (1).mul_le_mono(k + 1, 1, k.fact(), trivial, k.fact_pos()),
    }
}

// Binomial coefficients, by Pascal's rule (issues/finite-difference-calculus.md).
// `Succ(m).choose(Succ(j)) = m.choose(j) + m.choose(Succ(j))` and
// `Succ(m).choose(0) = 1` hold by computation: the two equations every sum
// over binomial coefficients steps by (`difference::Semiring::pascal_range`).
// At an open `n`, `n.choose(0) = 1` is `choose_zero_r`.
fn Nat::choose(self n, k: Nat) → Nat {
    match n {
        Zero => match k { Zero => 1, Succ(_) => 0 },
        Succ(m) => match k { Zero => 1, Succ(j) => m.choose(j) + m.choose(Succ(j)) },
    }
}

theorem Nat::choose_zero_r(self n: Nat): n.choose(0) = 1 { match n { Zero => refl, Succ(_) => refl } }

theorem Nat::choose_pascal(self m, j: Nat): (m + 1).choose(j + 1) = m.choose(j) + m.choose(j + 1) { refl }

// Past the top the coefficient vanishes.
theorem Nat::choose_eq_zero(self n, k: Nat): n < k → n.choose(k) = 0 {
    match n {
        Zero => match k { Zero => λ h => false_elim(h), Succ(_) => λ h => refl },
        Succ(m) => match k {
            Zero => λ h => false_elim(h),
            Succ(j) => λ h => j(sym(m.choose_eq_zero(j + 1, (m + 1).le_succ_r(j, h))),
                λ w _ => m.choose(j) + w = 0, m.choose_eq_zero(j, h)),
        },
    }
}

theorem Nat::choose_self(self n: Nat): n.choose(n) = 1 {
    match n {
        Zero => refl,
        Succ(m) => j(sym(m.choose_eq_zero(m + 1, Nat::le_refl(m + 1))), λ w _ => m.choose(m) + w = 1, m.choose_self()),
    }
}

// Evidence rules (docs/library/positivity-evidence-design.md §6 A). A `:= infer`
// positivity premise with no proof in scope backchains through these, each
// premise searched the same way, so `0 < x * (y + 1)` is found from `0 < x`.
// A literal or `Succ` operand needs no rule: its goal computes to `True`.

evidence theorem Nat::mul_pos({a, b: Nat}, pa: 0 < a := infer, pb: 0 < b := infer): 0 < a * b {
    (1).mul_le_mono(a, 1, b, pa, pb)
}

evidence theorem Nat::add_pos_l({a, b: Nat}, pa: 0 < a := infer): 0 < a + b {
    (1).le_trans(a, a + b, pa, a.le_add_l(b))
}

evidence theorem Nat::add_pos_r({a, b: Nat}, pb: 0 < b := infer): 0 < a + b {
    (1).le_trans(b, a + b, pb, a.le_add_r(b))
}

// A power of a positive base is positive, so `Rat(n, Nat::pow(2, k))` finds its
// denominator's positivity with no argument.
evidence theorem Nat::pow_pos({a, n: Nat}, pa: 0 < a := infer): 0 < a.pow(n) { a.one_le_pow(n, pa) }

// Powers, and the power-of-two fact words truncate by, under congruence
// modulo a divisor (`add_mod` and the rest, above).
theorem Nat::pow_mod(self a: Nat, d: Pos<Nat>, k: Nat): a.mod(d).pow(k).mod(d) = a.pow(k).mod(d) {
    match k {
        Zero => refl,
        Succ(j) => calc {
            (a.mod(d).pow(j) * a.mod(d)).mod(d)
                = (a.mod(d).pow(j) * a).mod(d) := a.mod(d).pow(j).mul_mod_right(a, d),
                = (a.mod(d).pow(j).mod(d) * a).mod(d) := sym(a.mod(d).pow(j).mul_mod_left(a, d)),
                = (a.pow(j).mod(d) * a).mod(d) := Nat::cong(λ (x: Nat) => (x * a).mod(d), a.pow_mod(d, j)),
                = (a.pow(j) * a).mod(d) := a.pow(j).mul_mod_left(a, d),
        },
    }
}

theorem Nat::modeq_pow(m: Pos<Nat>, k: Nat, {a, b: Nat}, h: Nat::ModEq(m, a, b)): Nat::ModEq(m, a.pow(k), b.pow(k)) {
    trans(sym(a.pow_mod(m, k)), trans(Nat::cong(λ (x: Nat) => x.pow(k).mod(m), h), b.pow_mod(m, k)))
}

// A power divides every higher power of the same base.
theorem Nat::pow_dvd_pow_add(self b: Pos<Nat>, n, k: Nat): b.pow(n).Divides(b.pow(k + n)) {
    trans(Nat::cong(λ (x: Nat) => x.mod(b.pow(n)), b.pow_add(k, n)), b.pow(k).mul_mod_self(b.pow(n)))
}

// A power divides every later power of its base.
theorem Nat::pow_dvd_pow_of_le(self b: Pos<Nat>, {n, m: Nat}, h: n <= m): b.pow(n).Divides(b.pow(m)) {
    j(n.sub_add_cancel(m, h), λ e _ => b.pow(n).Divides(b.pow(e)), b.pow_dvd_pow_add(n, m - n))
}

// The power-of-two fact words truncate by: the low `n` digits of the low
// `k + n` digits are the low `n` digits.
theorem Nat::mod_pow_mod(self x: Nat, b: Pos<Nat>, n, k: Nat): x.mod(b.pow(k + n)).mod(b.pow(n)) = x.mod(b.pow(n)) {
    x.mod_mod_of_dvd(b.pow(k + n), b.pow(n), b.pow_dvd_pow_add(n, k))
}

theorem Nat::fact_le_succ(self n: Nat): n.fact() <= (n + 1).fact() {
    rewrite(sym(n.fact().mul_left_one()), n.fact().mul_le_mono_r(1, n + 1, trivial))
}

// ---------------------------------------------------------------------------

fn Nat::half(self n: Nat) → Nat {
    match n {
        Zero => 0,
        Succ(k) => match k { Zero => 0, Succ(l) => Succ(l.half()) },
    }
}

fn Nat::Even(n: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match k { Zero => False, Succ(l) => Nat::Even(l) },
    }
}

fn Nat::Odd(n: Nat) → Type {
    match n {
        Zero => False,
        Succ(k) => match k { Zero => True, Succ(l) => Nat::Odd(l) },
    }
}

// TODO: nat not even zero
// TODO: nat odd zero

theorem Nat::half_le(self n: Nat): n.half() <= n {
    match n {
        Zero => trivial,
        Succ(k) => match k { Zero => trivial, Succ(l) => l.half().le_succ_r(l, l.half_le()) },
    }
}

theorem Nat::half_double(self n: Nat): (n + n).half() = n {
    match n {
        Zero => refl,
        Succ(l) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => (w + 1).half(), l.add_succ_left(l));
            Nat::cong_succ(l.half_double()),
    }
}

// Halving loses at most one: `2·⌊n/2⌋ <= n <= 2·⌊n/2⌋ + 1`.
theorem Nat::half_add_le(self n: Nat): n.half() + n.half() <= n {
    match n {
        Zero => trivial,
        Succ(k) => match k {
            Zero => trivial,
            Succ(l) => {
                let ih: (l.half() + l.half() <= l) = l.half_add_le();
                j(sym(l.half().add_succ_left(l.half())), λ y _ => y <= l + 1, ih)
            },
        },
    }
}

theorem Nat::le_succ_half_add(self n: Nat): n <= n.half() + n.half() + 1 {
    match n {
        Zero => trivial,
        Succ(k) => match k {
            Zero => trivial,
            Succ(l) => {
                let ih: (l <= l.half() + l.half() + 1) = l.le_succ_half_add();
                j(sym(l.half().add_succ_left(l.half())), λ y _ => l <= y, ih)
            },
        },
    }
}

theorem Nat::mul_two(self n: Nat): n * 2 = n + n { Nat::cong(λ (w: Nat) => w + n, n.add_left_zero()) }

theorem Nat::mul_twice(self a, b: Nat): a * b.twice() = (a * b).twice() {
    trans(Nat::cong(λ (w: Nat) => a * w, b.twice_add_self()), trans(a.mul_add_distr(b, b), sym((a * b).twice_add_self())))
}

// `⌊n / 2^k⌋`, by halving `k` times: the shift a rounding takes.
fn Nat::shr(self n, k: Nat) → Nat { match k { Zero => n, Succ(i) => n.half().shr(i) } }

// The shift is the floor of the quotient: `⌊n/2^k⌋ · 2^k <= n < (⌊n/2^k⌋ + 1) · 2^k`.
theorem Nat::shr_mul_le(self k: Nat): (n: Nat) → n.shr(k) * Nat::pow(2, k) <= n {
    match k {
        Zero => λ n => j(sym(n.add_left_zero()), λ y _ => y <= n, n.le_refl()),
        Succ(i) => λ n => {
            let s = n.half().shr(i);
            let p = Nat::pow(2, i);
            let ih: (s * p <= n.half()) = Nat::shr_mul_le(i, n.half());
            let doubled: ((s * p) * 2 <= n.half() * 2) = Nat::mul_le_mono_r(2, s * p, n.half(), ih);
            let back: (n.half() * 2 <= n) = rewrite(sym(n.half().mul_two()), in := n.half_add_le());
            let assoc: ((s * p) * 2 = s * (p * 2)) = s.mul_assoc(p, 2);
            j(assoc, λ y _ => y <= n, ((s * p) * 2).le_trans(n.half() * 2, n, doubled, back))
        },
    }
}

theorem Nat::lt_succ_shr_mul(self k: Nat): (n: Nat) → n < (n.shr(k) + 1) * Nat::pow(2, k) {
    match k {
        Zero => λ n => j(sym(n.add_left_zero()), λ y _ => n <= y, n.le_refl()),
        Succ(i) => λ n => {
            let s = n.half().shr(i);
            let p = Nat::pow(2, i);
            let ih: (n.half() + 1 <= (s + 1) * p) = Nat::lt_succ_shr_mul(i, n.half());
            let doubled: ((n.half() + 1) * 2 <= ((s + 1) * p) * 2) = Nat::mul_le_mono_r(2, n.half() + 1, (s + 1) * p, ih);
            let two: ((n.half() + 1) * 2 = n.half() + n.half() + 2) =
                trans((n.half() + 1).mul_two(), Nat::cong_succ(n.half().add_succ_left(n.half())));
            let low: (n + 1 <= (n.half() + 1) * 2) = j(sym(two), λ y _ => n + 1 <= y, n.le_succ_half_add());
            let assoc: (((s + 1) * p) * 2 = (s + 1) * (p * 2)) = (s + 1).mul_assoc(p, 2);
            j(assoc, λ y _ => n + 1 <= y, (n + 1).le_trans((n.half() + 1) * 2, ((s + 1) * p) * 2, low, doubled))
        },
    }
}

// One more halving is the last one: a shift can be carried along a search
// that increments `k`, at one halving a step.
theorem Nat::shr_succ_half(self k: Nat): (n: Nat) → n.shr(k + 1) = n.shr(k).half() {
    match k {
        Zero => λ n => refl,
        Succ(i) => λ n => Nat::shr_succ_half(i, n.half()),
    }
}

// The number of binary digits: the least `w` with `n < 2^w`.
fn Nat::width_fuel(n, fuel: Nat) → Nat {
    match fuel { Zero => 0, Succ(f) => match n { Zero => 0, Succ(k) => Succ(Nat::width_fuel(Succ(k).half(), f)) } }
}

fn Nat::width(self n: Nat) → Nat { Nat::width_fuel(n, n) }

theorem Nat::even_double(self n: Nat): Nat::Even(n + n) {
    match n {
        Zero => trivial,
        Succ(l) => j(sym(l.add_succ_left(l)), λ y q => Nat::Even(y + 1), l.even_double()),
    }
}

theorem Nat::even_or_odd(self n: Nat): Nat::Even(n) ∨ Nat::Odd(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k { Zero => Inr(trivial), Succ(l) => l.even_or_odd() },
    }
}

theorem Nat::even_succ_of_odd(self n: Nat): Nat::Odd(n) → Nat::Even(n + 1) {
    match n {
        Zero => λ h => false_elim(h),
        Succ(k) => match k {
            Zero => λ _ => trivial,
            Succ(l) => { let ih = l.even_succ_of_odd(); λ h => ih(h) },
        },
    }
}

theorem Nat::even_succ_of_not_even(self n: Nat, h: ¬Nat::Even(n)): Nat::Even(n + 1) {
    match n.even_or_odd() { Inl(e) => false_elim(h(e)), Inr(o) => n.even_succ_of_odd(o) }
}

theorem Nat::not_even_succ_of_even(self n: Nat): Nat::Even(n) → ¬Nat::Even(n + 1) {
    match n {
        Zero => λ _ (b: Nat::Even(1)) => b,
        Succ(k) => match k {
            Zero => λ (h: Nat::Even(1)) _ => false_elim(h),
            Succ(l) => { let ih = l.not_even_succ_of_even(); λ h => ih(h) },
        },
    }
}

theorem Nat::even_pow_two(self k: Nat): Nat::Even(Nat::pow(2, k + 1)) {
    j(sym(Nat::pow(2, k).mul_two()), λ y _ => Nat::Even(y), Nat::pow(2, k).even_double())
}

theorem Nat::not_even_and_odd(self n: Nat): ¬(Nat::Even(n) ∧ Nat::Odd(n)) {
    match n {
        Zero => λ (h: Nat::Even(0) ∧ Nat::Odd(0)) => h.right,
        Succ(k) => match k {
            Zero => λ (h: Nat::Even(1) ∧ Nat::Odd(1)) => h.left,
            Succ(l) => not_even_and_odd(l),
        },
    }
}

// The tie between the two halves of this section, and the reason they are one
// issue rather than two: on an even argument, halving is exactly invertible.
// Curried, so that the recursion descends on `n` alone and the hypothesis
// rides along as an argument (issues/ih-generalization.md's shape).
theorem Nat::half_add_half(self n: Nat): Nat::Even(n) → n.half() + n.half() = n {
    match n {
        Zero => λ (h: Nat::Even(0)) => refl,
        Succ(k) => match k {
            Zero => λ (h: Nat::Even(1)) => false_elim(h),
            Succ(l) => (h: Nat::Even(l + 2)) ⊢
                apply trans;
                give Nat::cong_succ(l.half().add_succ_left(l.half()));
                Nat::cong_succ(Nat::cong_succ(l.half_add_half(h))),
        },
    }
}

theorem half_lt_of_lt_double(self x: Nat): (p: Nat) → x < p + p → x.half() < p {
    match x {
        Zero => λ p => match p {
            Zero => λ bad => false_elim(bad),
            Succ(_) => λ _ => trivial,
        },
        Succ(k) => match k {
            Zero => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(_) => λ _ => trivial,
            },
            Succ(l) => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(r) => λ h => l.half_lt_of_lt_double(r,
                    j(r.add_succ_left(r), λ y _ => l + 1 < y, h)),
            },
        },
    }
}

fn Nat::even_dec(self n: Nat) → Nat::Even(n) ∨ ¬Nat::Even(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k {
            Zero => Inr(λ (bad: Nat::Even(1)) => bad),
            Succ(l) => l.even_dec(),
        },
    }
}

instance(n: Nat) Decide<Nat::Even(n)> { dec := Nat::even_dec(n), bit := or_bit(Nat::even_dec(n)), reflects := or_bit_reflects(Nat::even_dec(n)) }

// ---------------------------------------------------------------------------
// Binary long division. `divmod` counts the quotient out one unit at a time,
// so under evaluation it costs the quotient itself; the kernel does not
// accelerate its state machine (`crates/kernel/DESIGN.md`, acceleration
// policy). `ldiv` divides `⌊n/2⌋` first and doubles: one halving, one
// multiplication, one subtraction and one comparison per quotient bit, each
// of which the kernel evaluates on numerals directly, so a quotient of `b`
// bits costs `b` steps. Its result is `divmod`'s at every positive divisor
// (`ldiv_div`, `ldiv_mod`); the numerator itself is the fuel, and the
// recursion stops when the numerator reaches zero.

fn DivMod::quot(self s: DivMod) → Nat { match s { MkDivMod(q, _) => q } }

fn DivMod::rem(self s: DivMod) → Nat { match s { MkDivMod(_, r) => r } }

// The next bit of the quotient: `r` is what is left of `n` after twice the
// quotient so far.
fn Nat::ldiv_pick(d, q, r: Nat, c: d <= r ∨ ¬(d <= r)) → DivMod {
    match c { Inl(_) => MkDivMod(Succ(q * 2), r - d), Inr(_) => MkDivMod(q * 2, r) }
}

// The bit halving drops: `n = 2·h + bit` when `h = ⌊n/2⌋`.
fn Nat::ldiv_bit(n, h: Nat) → Nat { match Succ(h + h).le_dec(n) { Inl(_) => 1, Inr(_) => 0 } }

// The low bit, by recursion two at a time as `half` is: the kernel runs a
// numeral through it in a few steps, where `n - 2·⌊n/2⌋` (`low_bit_sub`)
// paid for a halving, a product and a difference.
fn Nat::low_bit(self n: Nat) → Nat {
    match n {
        Zero => 0,
        Succ(k) => match k { Zero => 1, Succ(l) => l.low_bit() },
    }
}

// The low bit is what halving leaves: `n - 2·⌊n/2⌋`.
theorem Nat::low_bit_sub(self n: Nat): n.low_bit() = n - n.half() * 2 {
    match n {
        Zero => refl,
        Succ(k) => match k {
            Zero => refl,
            Succ(l) => {
                let h = l.half();
                let two: ((h + 1) * 2 = h * 2 + 2) = trans((h + 1).mul_two(), trans(h.add_succ_left(h + 1), Nat::cong(λ (w: Nat) => w + 2, sym(h.mul_two()))));
                trans(l.low_bit_sub(), Nat::cong(λ (w: Nat) => (l + 2) - w, sym(two)))
            },
        },
    }
}

// The remainder is doubled as `r * 2`, never `r + r`: a sum of a value with
// itself stays a composed run whose later comparison walks every fragment,
// which ran a 1050-bit division out of fuel (issues/nat-wide-evaluation.md).
fn Nat::ldiv_step(n, d: Nat, s: DivMod) → DivMod {
    match s {
        MkDivMod(q, r) => Nat::ldiv_pick(d, q, r * 2 + n.low_bit(), d.le_dec(r * 2 + n.low_bit())),
    }
}

fn Nat::ldiv_fuel(self n, d, fuel: Nat) → DivMod {
    match fuel {
        Zero => MkDivMod(0, n),
        Succ(f) => match n {
            Zero => MkDivMod(0, 0),
            Succ(k) => Nat::ldiv_step(Succ(k), d, Succ(k).half().ldiv_fuel(d, f)),
        },
    }
}

fn Nat::ldiv(self n, d: Nat) → DivMod { n.ldiv_fuel(d, n) }

theorem Nat::half_succ_le(self k: Nat): (k + 1).half() <= k { match k { Zero => trivial, Succ(l) => l.half_le() } }

// `2^j - 1`, the number with `j` one bits. Every `n` is at most the ones of
// its width, `n < 2^width(n)`, read without a subtraction: a halving loses at
// most one, and one more digit doubles the ones and adds one.
fn Nat::ones(self j: Nat) → Nat { match j { Zero => 0, Succ(i) => i.ones() * 2 + 1 } }

theorem Nat::le_ones_width_fuel(self fuel: Nat): (n: Nat) → n <= fuel → n <= Nat::width_fuel(n, fuel).ones() {
    match fuel {
        Zero => λ n le => le,
        Succ(f, ih) => λ n => match n {
            Zero => λ _ => trivial,
            Succ(k) => λ le => {
                let h = (k + 1).half();
                let w = Nat::width_fuel(h, f);
                let below: (h <= w.ones()) = ih(h, h.le_trans(k, f, k.half_succ_le(), le));
                let doubled: (h * 2 <= w.ones() * 2) = Nat::mul_le_mono_r(2, h, w.ones(), below);
                let halves: (k <= h + h) = (k + 1).le_succ_half_add();
                k.le_trans(h * 2, w.ones() * 2, j(sym(h.mul_two()), λ y _ => k <= y, halves), doubled)
            },
        },
    }
}

theorem Nat::le_ones_width(self n: Nat): n <= n.width().ones() { n.le_ones_width_fuel(n, n.le_refl()) }

theorem Nat::ldiv_bit_parts(self n: Nat): (n.half() + n.half()) + Nat::ldiv_bit(n, n.half()) = n ∧ Nat::ldiv_bit(n, n.half()) <= 1 {
    match (n.half() + n.half() + 1).le_dec(n) {
        Inl(le) => And((n.half() + n.half() + 1).le_antisym(n, le, n.le_succ_half_add()), trivial),
        Inr(nle) => And((n.half() + n.half()).le_antisym(n, n.half_add_le(), Nat::lt_of_not_le(n, n.half() + n.half() + 1, nle)), trivial),
    }
}

theorem Nat::low_bit_eq(self n: Nat): n.low_bit() = Nat::ldiv_bit(n, n.half()) {
    let parts = n.ldiv_bit_parts();
    let b = Nat::ldiv_bit(n, n.half());
    let h2 = n.half() * 2;
    calc {
        n.low_bit()
            = n - h2 := n.low_bit_sub(),
            = ((n.half() + n.half()) + b) - h2 := Nat::cong(λ (x: Nat) => x - h2, sym(parts.left)),
            = (h2 + b) - h2 := Nat::cong(λ (x: Nat) => (x + b) - h2, sym(n.half().mul_two())),
            = (b + h2) - h2 := Nat::cong(λ (x: Nat) => x - h2, h2.add_comm(b)),
            = b := b.add_sub_cancel(h2),
    }
}

theorem Nat::ldiv_pick_spec(n, d, q, r: Nat, c: d <= r ∨ ¬(d <= r), parts: (q * d + q * d) + r = n, bound: d <= 0 ∨ r < d + d):
    DivMod::Spec(n, d, Nat::ldiv_pick(d, q, r, c))
{
    let dbl: ((q * 2) * d = q * d + q * d) = trans(Nat::cong(λ (x: Nat) => x * d, q.mul_two()), q.add_mul_distr(q, d));
    match c {
        Inl(le) => {
            let back: ((r - d) + d = r) = d.sub_add_cancel(r, le);
            let sum = calc {
                (q * 2 + 1) * d + (r - d)
                    = (d + (q * 2) * d) + (r - d) := Nat::cong(λ (x: Nat) => x + (r - d), (q * 2).mul_succ_left(d)),
                    = ((q * 2) * d + d) + (r - d) := Nat::cong(λ (x: Nat) => x + (r - d), d.add_comm((q * 2) * d)),
                    = (q * 2) * d + (d + (r - d)) := ((q * 2) * d).add_assoc(d, r - d),
                    = (q * 2) * d + ((r - d) + d) := Nat::cong(λ (x: Nat) => (q * 2) * d + x, d.add_comm(r - d)),
                    = (q * 2) * d + r := Nat::cong(λ (x: Nat) => (q * 2) * d + x, back),
                    = (q * d + q * d) + r := Nat::cong(λ (x: Nat) => x + r, dbl),
                    = n := parts,
            };
            let lower: (d <= 0 ∨ r - d < d) = match bound {
                Inl(zero) => Inl(zero),
                Inr(lt) => {
                    let shifted: ((r - d) + d + 1 <= d + d) = j(sym(back), λ y _ => y + 1 <= d + d, lt);
                    Inr(d.le_of_add_le_add_r(r - d + 1, d, j(sym((r - d).add_succ_left(d)), λ y _ => y <= d + d, shifted)))
                },
            };
            And(sum, lower)
        },
        Inr(nle) => And(trans(Nat::cong(λ (x: Nat) => x + r, dbl), parts),
            match bound { Inl(zero) => Inl(zero), Inr(_) => Inr(Nat::lt_of_not_le(r, d, nle)) }),
    }
}

// Long division one binary digit at a time, read off a word
// (`BitVec::division_step`, lib/std/bitvec/bitvec_div.hthr): the dividend
// gains a low bit `b` and doubles, the trial remainder is `2·r + b`, and the
// quotient gains a digit, one exactly when the divisor fits under the trial
// remainder. Stated over `Nat::of_bit` and `twice`, a word's own reading of a
// bit pushed in at the low end.

// A bit under twice a bounded number stays under twice the bound.
theorem Nat::of_bit_twice_lt(b: Bool, m, p: Nat, h: m < p): Nat::of_bit(b) + m.twice() < p.twice() {
    match b {
        False => rewrite(m.twice().add_left_zero(), Nat::twice_lt_twice_iff(m, p).mpr(h)),
        True => rewrite(trans(Nat::add_succ_left(0, m.twice()), Nat::cong_succ(m.twice().add_left_zero())),
            Nat::twice_le_twice_iff(m + 1, p).mpr(h)),
    }
}

// And back: a bit pushed in below a doubled number is under a doubled bound
// only when the number is under the bound.
theorem Nat::lt_of_bit_twice_lt(b: Bool, m, p: Nat, h: Nat::of_bit(b) + m.twice() < p.twice()): m < p {
    let low: (m.twice() <= Nat::of_bit(b) + m.twice()) = Nat::le_add_r(Nat::of_bit(b), m.twice());
    Nat::twice_lt_twice_iff(m, p).mp(Nat::le_trans(m.twice() + 1, Nat::of_bit(b) + m.twice() + 1, p.twice(), low, h))
}

// A number is at most a bit pushed in below it.
theorem Nat::le_of_bit_twice(b: Bool, m: Nat): m <= Nat::of_bit(b) + m.twice() {
    Nat::le_trans(m, m.twice(), Nat::of_bit(b) + m.twice(),
        rewrite(m.twice_add_self(), m.le_add_l(m)), Nat::le_add_r(Nat::of_bit(b), m.twice()))
}

// A bit pushed in below a number, modulo twice a bound: the bit stays and the
// number is reduced modulo the bound. One digit of `mod 2^k`, what a word's
// low mask reads as (`BitVec::toNat_band_low_mask`).
theorem Nat::of_bit_twice_mod(b: Bool, t: Nat, p: Pos<Nat>):
    (Nat::of_bit(b) + t.twice()).mod(p.twice()) = Nat::of_bit(b) + t.mod(p).twice()
{
    let o = Nat::of_bit(b);
    let q = t.div(p);
    let s = t.mod(p);
    let parts: (q * p.twice() + (o + s.twice()) = o + t.twice()) = calc {
        q * p.twice() + (o + s.twice())
            = (q * p).twice() + (o + s.twice()) := prelude::cong(q.mul_twice(p)),
            = o + ((q * p).twice() + s.twice()) := (q * p).twice().add_left_comm(o, s.twice()),
            = o + (q * p + s).twice() := prelude::cong(sym((q * p).twice_add(s))),
            = o + t.twice() := prelude::cong(t.div_mul_add_mod(p)),
    };
    (o + t.twice()).div_mod_unique(p.twice(), q, o + s.twice(), parts, Nat::of_bit_twice_lt(b, s, p, t.mod_lt(p))).right
}

// Halving is the quotient by two, and so `shr` is the quotient by `2^k`:
// what a word's right shift reads as (`BitVec::toNat_shift_right`).
theorem Nat::half_eq_div_two(self n: Nat): n.half() = n.div(2) {
    let parts = n.ldiv_bit_parts();
    sym(n.div_mod_unique(2, n.half(), Nat::ldiv_bit(n, n.half()),
        trans(Nat::cong(λ (y: Nat) => y + Nat::ldiv_bit(n, n.half()), n.half().mul_two()), parts.left),
        parts.right).left)
}

theorem Nat::shr_eq_div(self k: Nat): (n: Nat) → n.shr(k) = n.div(Nat::pow(2, k)) {
    match k {
        Zero => λ n => sym(n.div_one()),
        Succ(i, ih) => λ n => calc {
            n.shr(i + 1)
                = n.shr(i).half() := Nat::shr_succ_half(i, n),
                = n.div(Nat::pow(2, i)).half() := prelude::cong(ih(n)),
                = n.div(Nat::pow(2, i)).div(2) := n.div(Nat::pow(2, i)).half_eq_div_two(),
                = n.div(Nat::pow(2, i) * 2) := n.div_div(Nat::pow(2, i), 2),
        },
    }
}

// Nothing divided by anything is nothing, remainder nothing.
theorem DivMod::spec_zero(d: Nat): DivMod::Spec(0, d, MkDivMod(0, 0)) {
    And(d.mul_left_zero(), match d { Zero => Inl(trivial), Succ(_) => Inr(trivial) })
}

// The remainder is at most the dividend, whatever the divisor.
theorem DivMod::rem_le(n, d, q, r: Nat, sp: DivMod::Spec(n, d, MkDivMod(q, r))): r <= n {
    rewrite(sym(sp.left), Nat::le_add_r(q * d, r))
}

// Away from a zero divisor the remainder is below it.
theorem DivMod::rem_lt(n, d, q, r: Nat, sp: DivMod::Spec(n, d, MkDivMod(q, r)), positive: 0 < d): r < d {
    match sp.right {
        Inl(zero) => false_elim(Nat::le_trans(1, d, 0, positive, zero)),
        Inr(lt) => lt,
    }
}

// By zero the remainder is the dividend.
theorem DivMod::rem_of_zero_divisor(n, q, r: Nat, sp: DivMod::Spec(n, 0, MkDivMod(q, r))): r = n {
    trans(sym(r.add_left_zero()), sp.left)
}

// Away from a zero divisor the quotient is at most the dividend.
theorem DivMod::quot_le(n, d, q, r: Nat, sp: DivMod::Spec(n, d, MkDivMod(q, r)), positive: 0 < d): q <= n {
    let scaled: (q <= q * d) = j(q.add_left_zero(), λ y _ => y <= q * d, q.mul_le_mono_l(1, d, positive));
    Nat::le_trans(q, q * d, n, scaled, rewrite(sym(sp.left), Nat::le_add_l(q * d, r)))
}

// A positive quotient as large as the dividend leaves the divisor at most one.
theorem DivMod::divisor_le_one(n, d, q, r: Nat, sp: DivMod::Spec(n, d, MkDivMod(q, r)), small: n <= q, positive: 0 < q): d <= 1 {
    let below: (q * d <= q) = Nat::le_trans(q * d, n, q, rewrite(sym(sp.left), Nat::le_add_l(q * d, r)), small);
    let twice: (q + 1 <= q * 2) = j(sym(q.mul_two()), λ y _ => q + 1 <= y, q.add_le_mono_l(1, q, positive));
    Nat::lt_of_mul_lt_mul_l(q, d, 2, Nat::le_trans(q * d + 1, q + 1, q * 2, below, twice))
}

// The digit's arithmetic: doubling `q·d + r = a` and pushing a bit in.
theorem DivMod::digit_parts(a, d, q, r: Nat, b: Bool, parts: q * d + r = a):
    (q * d + q * d) + (Nat::of_bit(b) + r.twice()) = Nat::of_bit(b) + a.twice()
{
    let c = Nat::of_bit(b);
    let p = q * d;
    calc {
        (p + p) + (c + r.twice())
            = (c + r.twice()) + (p + p) := (p + p).add_comm(c + r.twice()),
            = c + (r.twice() + (p + p)) := c.add_assoc(r.twice(), p + p),
            = c + ((p + p) + r.twice()) := Nat::cong(λ (x: Nat) => c + x, r.twice().add_comm(p + p)),
            = c + (p.twice() + r.twice()) := Nat::cong(λ (x: Nat) => c + (x + r.twice()), sym(p.twice_add_self())),
            = c + (p + r).twice() := Nat::cong(λ (x: Nat) => c + x, sym(p.twice_add(r))),
            = c + a.twice() := Nat::cong(λ (x: Nat) => c + x.twice(), parts),
    }
}

// The digit is zero: the divisor does not fit under the trial remainder.
theorem DivMod::digit_keep(a, d, q, r: Nat, b: Bool, sp: DivMod::Spec(a, d, MkDivMod(q, r)),
        lt: Nat::of_bit(b) + r.twice() < d):
    DivMod::Spec(Nat::of_bit(b) + a.twice(), d, MkDivMod(0 + q.twice(), Nat::of_bit(b) + r.twice()))
{
    let doubled: ((0 + q.twice()) * d = q * d + q * d) =
        trans(Nat::cong(λ (x: Nat) => x * d, trans(q.twice().add_left_zero(), q.twice_add_self())), q.add_mul_distr(q, d));
    And(trans(Nat::cong(λ (x: Nat) => x + (Nat::of_bit(b) + r.twice()), doubled), DivMod::digit_parts(a, d, q, r, b, sp.left)),
        Inr(lt))
}

// The digit is one: the divisor fits, and is taken off.
theorem DivMod::digit_take(a, d, q, r: Nat, b: Bool, sp: DivMod::Spec(a, d, MkDivMod(q, r)),
        fits: d <= Nat::of_bit(b) + r.twice()):
    DivMod::Spec(Nat::of_bit(b) + a.twice(), d, MkDivMod(1 + q.twice(), (Nat::of_bit(b) + r.twice()) - d))
{
    let t = Nat::of_bit(b) + r.twice();
    let bound: (d <= 0 ∨ t < d + d) = match sp.right {
        Inl(zero) => Inl(zero),
        Inr(lt) => Inr(rewrite(sym(d.twice_add_self()), Nat::of_bit_twice_lt(b, r, d, lt))),
    };
    let picked: (DivMod::Spec(Nat::of_bit(b) + a.twice(), d, MkDivMod(q * 2 + 1, t - d))) =
        Nat::ldiv_pick_spec(Nat::of_bit(b) + a.twice(), d, q, t, Inl(fits), DivMod::digit_parts(a, d, q, r, b, sp.left), bound);
    let digit: (q * 2 + 1 = 1 + q.twice()) =
        sym(trans(Nat::add_succ_left(0, q.twice()), Nat::cong_succ(trans(q.twice().add_left_zero(), trans(q.twice_add_self(), sym(q.mul_two()))))));
    j(digit, λ y _ => DivMod::Spec(Nat::of_bit(b) + a.twice(), d, MkDivMod(y, t - d)), picked)
}

theorem Nat::ldiv_step_spec(n, d: Nat, s: DivMod, h: DivMod::Spec(n.half(), d, s)): DivMod::Spec(n, d, Nat::ldiv_step(n, d, s)) {
    let bits = n.ldiv_bit_parts();
    let b = Nat::ldiv_bit(n, n.half());
    match s as λ ss => DivMod::Spec(n.half(), d, ss) → DivMod::Spec(n, d, Nat::ldiv_step(n, d, ss)) {
        MkDivMod(q, r0) => λ (sp: (q * d + r0 = n.half()) ∧ (d <= 0 ∨ r0 < d)) => {
            let parts = calc {
                (q * d + q * d) + ((r0 + r0) + b)
                    = ((q * d + q * d) + (r0 + r0)) + b := sym((q * d + q * d).add_assoc(r0 + r0, b)),
                    = ((q * d + r0) + (q * d + r0)) + b := Nat::cong(λ (x: Nat) => x + b, (q * d).add_swap_middle(q * d, r0, r0)),
                    = (n.half() + n.half()) + b := Nat::cong(λ (x: Nat) => (x + x) + b, sp.left),
                    = n := bits.left,
            };
            let bound: (d <= 0 ∨ (r0 + r0) + b < d + d) = match sp.right {
                Inl(zero) => Inl(zero),
                Inr(lt) => {
                    let low: ((r0 + r0) + b <= r0 + r0 + 1) = (r0 + r0).add_le_mono_l(b, 1, bits.right);
                    let two: (r0 + 1 + (r0 + 1) <= d + d) = (r0 + 1).add_le_mono(d, r0 + 1, d, lt, lt);
                    let top: (r0 + r0 + 2 <= d + d) = j(Nat::cong_succ(r0.add_succ_left(r0)), λ y _ => y <= d + d, two);
                    Inr(((r0 + r0) + b + 1).le_trans(r0 + r0 + 2, d + d, low, top))
                },
            };
            let e: (r0 * 2 + n.low_bit() = (r0 + r0) + b) =
                trans(Nat::cong(λ (x: Nat) => x + n.low_bit(), r0.mul_two()), Nat::cong(λ (x: Nat) => (r0 + r0) + x, n.low_bit_eq()));
            Nat::ldiv_pick_spec(n, d, q, r0 * 2 + n.low_bit(), d.le_dec(r0 * 2 + n.low_bit()),
                j(sym(e), λ y _ => (q * d + q * d) + y = n, parts), j(sym(e), λ y _ => d <= 0 ∨ y < d + d, bound))
        },
    }(h)
}

theorem Nat::ldiv_fuel_spec(self fuel: Nat): (n, d: Nat) → n <= fuel → DivMod::Spec(n, d, n.ldiv_fuel(d, fuel)) {
    match fuel {
        Zero => λ n d le => And(trans(Nat::cong(λ (x: Nat) => x + n, d.mul_left_zero()), n.add_left_zero()),
            match n as λ m => m <= 0 → (d <= 0 ∨ m < d) {
                Zero => λ _ => match d { Zero => Inl(trivial), Succ(_) => Inr(trivial) },
                Succ(_) => λ bad => false_elim(bad),
            }(le)),
        Succ(f, ih) => λ n d => match n {
            Zero => λ _ => And(d.mul_left_zero(), match d { Zero => Inl(trivial), Succ(_) => Inr(trivial) }),
            Succ(k) => λ le => Nat::ldiv_step_spec(k + 1, d, (k + 1).half().ldiv_fuel(d, f),
                ih((k + 1).half(), d, (k + 1).half().le_trans(k, f, k.half_succ_le(), le))),
        },
    }
}

theorem Nat::ldiv_spec(self n, d: Nat): DivMod::Spec(n, d, n.ldiv(d)) { n.ldiv_fuel_spec(n, d, n.le_refl()) }

// Fuel bounds the quotient's width, not the numerator's: when `n < d · 2^k`,
// `k` halvings leave less than `d`, so `k` steps divide. A caller that knows
// its quotient is narrow divides a wide numerator in that many steps.
theorem Nat::ldiv_fuel_bounded(self fuel: Nat): (n, d: Nat) → n < d * Nat::pow(2, fuel) → DivMod::Spec(n, d, n.ldiv_fuel(d, fuel)) {
    match fuel {
        Zero => λ n d lt => And(trans(Nat::cong(λ (x: Nat) => x + n, d.mul_left_zero()), n.add_left_zero()),
            Inr(j(d.add_left_zero(), λ y _ => n < y, lt))),
        Succ(f, ih) => λ n d => match n {
            Zero => λ _ => And(d.mul_left_zero(), match d { Zero => Inl(trivial), Succ(_) => Inr(trivial) }),
            Succ(k) => λ lt => {
                let p = Nat::pow(2, f);
                let lt2: (k + 1 < d * p + d * p) = j(trans(sym(d.mul_assoc(p, 2)), (d * p).mul_two()), λ y _ => k + 1 < y, lt);
                Nat::ldiv_step_spec(k + 1, d, (k + 1).half().ldiv_fuel(d, f), ih((k + 1).half(), d, (k + 1).half_lt_of_lt_double(d * p, lt2)))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Powers by squaring. `pow` multiplies once per unit of the exponent and
// re-enters the evaluator each time, so past an exponent of about 1024 it
// meets the kernel's depth budget; `pow_sq` halves the exponent, squares and
// multiplies by the low bit, one level per bit of the exponent.

fn Nat::pow_sq_step(a, s, b: Nat) → Nat { match b { Zero => s * s, Succ(_) => (s * s) * a } }

fn Nat::pow_sq_fuel(a, n, fuel: Nat) → Nat {
    match fuel {
        Zero => 1,
        Succ(f) => match n {
            Zero => 1,
            Succ(k) => Nat::pow_sq_step(a, Nat::pow_sq_fuel(a, Succ(k).half(), f), Succ(k).low_bit()),
        },
    }
}

fn Nat::pow_sq(self a, n: Nat) → Nat { Nat::pow_sq_fuel(a, n, n) }

theorem Nat::pow_sq_step_eq(a, h, b: Nat, hb: b <= 1): Nat::pow_sq_step(a, a.pow(h), b) = a.pow((h + h) + b) {
    match b as λ c => c <= 1 → Nat::pow_sq_step(a, a.pow(h), c) = a.pow((h + h) + c) {
        Zero => λ _ => sym(a.pow_add(h, h)),
        Succ(c) => match c {
            Zero => λ _ => Nat::cong(λ (x: Nat) => x * a, sym(a.pow_add(h, h))),
            Succ(_) => λ bad => false_elim(bad),
        },
    }(hb)
}

theorem Nat::pow_sq_fuel_eq(self fuel: Nat): (a, n: Nat) → n <= fuel → Nat::pow_sq_fuel(a, n, fuel) = a.pow(n) {
    match fuel {
        Zero => λ a n => match n { Zero => λ _ => refl, Succ(_) => λ bad => false_elim(bad) },
        Succ(f, ih) => λ a n => match n {
            Zero => λ _ => refl,
            Succ(k) => λ le => {
                let h = (k + 1).half();
                let b = Nat::ldiv_bit(k + 1, h);
                let parts = (k + 1).ldiv_bit_parts();
                let s_eq: (Nat::pow_sq_fuel(a, h, f) = a.pow(h)) = ih(a, h, h.le_trans(k, f, k.half_succ_le(), le));
                calc {
                    Nat::pow_sq_step(a, Nat::pow_sq_fuel(a, h, f), (k + 1).low_bit())
                        = Nat::pow_sq_step(a, a.pow(h), (k + 1).low_bit()) := Nat::cong(λ (x: Nat) => Nat::pow_sq_step(a, x, (k + 1).low_bit()), s_eq),
                        = Nat::pow_sq_step(a, a.pow(h), b) := Nat::cong(λ (x: Nat) => Nat::pow_sq_step(a, a.pow(h), x), (k + 1).low_bit_eq()),
                        = a.pow((h + h) + b) := Nat::pow_sq_step_eq(a, h, b, parts.right),
                        = a.pow(k + 1) := Nat::cong(λ (x: Nat) => a.pow(x), parts.left),
                }
            },
        },
    }
}

theorem Nat::pow_sq_eq(self a, n: Nat): a.pow_sq(n) = a.pow(n) { n.pow_sq_fuel_eq(a, n, n.le_refl()) }

theorem Nat::ldiv_parts(self n, d: Nat): n.ldiv(d).quot() * d + n.ldiv(d).rem() = n {
    match n.ldiv(d) as λ s => DivMod::Spec(n, d, s) → s.quot() * d + s.rem() = n { MkDivMod(_, _) => λ sp => sp.left }(n.ldiv_spec(d))
}

theorem Nat::ldiv_rem_lt(self n: Nat, d: Pos<Nat>): n.ldiv(d).rem() < d {
    match n.ldiv(d) as λ s => DivMod::Spec(n, d, s) → s.rem() < d {
        MkDivMod(_, _) => λ sp => match sp.right { Inl(zero) => false_elim(Nat::le_trans(1, d, 0, d_pos, zero)), Inr(lt) => lt },
    }(n.ldiv_spec(d))
}

theorem Nat::ldiv_div(self n: Nat, d: Pos<Nat>): n.ldiv(d).quot() = n.div(d) {
    sym(n.div_mod_unique(d, n.ldiv(d).quot(), n.ldiv(d).rem(), n.ldiv_parts(d), n.ldiv_rem_lt(d, d_pos := d_pos)).left)
}

theorem Nat::ldiv_mod(self n: Nat, d: Pos<Nat>): n.ldiv(d).rem() = n.mod(d) {
    sym(n.div_mod_unique(d, n.ldiv(d).quot(), n.ldiv(d).rem(), n.ldiv_parts(d), n.ldiv_rem_lt(d, d_pos := d_pos)).right)
}

// ---------------------------------------------------------------------------
// `2^K / d` for reciprocal bounds (issues/interval-evaluation-budget.md).
// `ldiv` halves all `K` bits of its numerator, a halving, a doubling, a
// subtraction, a decision and its proof per bit; at the `K` of a series
// ratio's reciprocal that was most of an interval enclosure's cost. A
// reciprocal needs only the quotient's bits, and needs them only as a guess
// that two comparisons can check.

// A division whose quotient was guessed: kept when `g·d <= n < (g + 1)·d`,
// which is two comparisons, and `ldiv` otherwise. Its parts are `ldiv`'s
// whichever way the check goes.
fn Nat::div_checked(n, d, g: Nat) → DivMod {
    match Nat::leb(g * d, n) {
        True => match Nat::leb(Succ(n - g * d), d) { True => MkDivMod(g, n - g * d), False => n.ldiv(d) },
        False => n.ldiv(d),
    }
}

theorem Nat::div_checked_parts(n, d, g: Nat): Nat::div_checked(n, d, g).quot() * d + Nat::div_checked(n, d, g).rem() = n {
    match Nat::leb(g * d, n) as λ c => Nat::leb(g * d, n) = c →
        (match c { True => match Nat::leb(n - g * d + 1, d) { True => MkDivMod(g, n - g * d), False => n.ldiv(d) }, False => n.ldiv(d) }).quot() * d
        + (match c { True => match Nat::leb(n - g * d + 1, d) { True => MkDivMod(g, n - g * d), False => n.ldiv(d) }, False => n.ldiv(d) }).rem() = n
    {
        True => λ le => match Nat::leb(n - g * d + 1, d) {
            True => trans((g * d).add_comm(n - g * d), (g * d).sub_add_cancel(n, (g * d).leb_sound(n, j(sym(le), λ c _ => c.IsTrue(), trivial)))),
            False => n.ldiv_parts(d),
        },
        False => λ _ => n.ldiv_parts(d),
    }(refl)
}

theorem Nat::div_checked_rem_lt(n: Nat, d: Pos<Nat>, g: Nat): Nat::div_checked(n, d, g).rem() < d {
    match Nat::leb(g * d, n) as λ c =>
        (match c { True => match Nat::leb(n - g * d + 1, d) { True => MkDivMod(g, n - g * d), False => n.ldiv(d) }, False => n.ldiv(d) }).rem() < d
    {
        True => match Nat::leb(n - g * d + 1, d) as λ c2 => Nat::leb(n - g * d + 1, d) = c2 →
            (match c2 { True => MkDivMod(g, n - g * d), False => n.ldiv(d) }).rem() < d
        {
            True => λ lt => (n - g * d + 1).leb_sound(d, j(sym(lt), λ c _ => c.IsTrue(), trivial)),
            False => λ _ => n.ldiv_rem_lt(d, d_pos := d_pos),
        }(refl),
        False => n.ldiv_rem_lt(d, d_pos := d_pos),
    }
}

// The guess for `⌊2^K / d⌋`: from `q·d + r = 2^j` with `r < d`, each step
// doubles `r` and takes one quotient bit, a doubling, a comparison and a
// subtraction. Starting at `2^j <= d` (`j = width(d) - 1`) leaves `K - j`
// steps, the quotient's own bits, where `ldiv` would halve all `K` bits of
// the numerator. The fuel goes on the comparisons, which the kernel charges
// by the length of the numbers compared.
fn Nat::recip_bits(d: Nat, s: DivMod, steps: Nat) → DivMod {
    match steps {
        Zero => s,
        Succ(k) => match s { MkDivMod(q, r) => Nat::recip_bits(d, match Nat::leb(d, r * 2) { True => MkDivMod(Succ(q * 2), r * 2 - d), False => MkDivMod(q * 2, r * 2) }, k) },
    }
}

fn Nat::pow2_div_start(d, P: Nat) → DivMod { match Nat::leb(d, P) { True => MkDivMod(1, P - d), False => MkDivMod(0, P) } }

fn Nat::pow2_div_from(K, d, j: Nat) → Nat { Nat::recip_bits(d, Nat::pow2_div_start(d, Nat::pow_sq(2, j)), K - j).quot() }

fn Nat::pow2_div_guess(K, d: Nat) → Nat { Nat::pow2_div_from(K, d, d.width() - 1) }

// `2^K` divided by `d`, with `ldiv`'s parts.
fn Nat::pow2_div(K, d: Nat) → DivMod { Nat::div_checked(Nat::pow_sq(2, K), d, Nat::pow2_div_guess(K, d)) }

theorem Nat::pow2_div_parts(K, d: Nat): Nat::pow2_div(K, d).quot() * d + Nat::pow2_div(K, d).rem() = Nat::pow(2, K) {
    j(Nat::pow_sq_eq(2, K), λ N _ => Nat::div_checked(Nat::pow_sq(2, K), d, Nat::pow2_div_guess(K, d)).quot() * d
        + Nat::div_checked(Nat::pow_sq(2, K), d, Nat::pow2_div_guess(K, d)).rem() = N,
        Nat::div_checked_parts(Nat::pow_sq(2, K), d, Nat::pow2_div_guess(K, d)))
}

theorem Nat::pow2_div_rem_lt(K: Nat, d: Pos<Nat>): Nat::pow2_div(K, d).rem() < d {
    Nat::div_checked_rem_lt(Nat::pow_sq(2, K), d, Nat::pow2_div_guess(K, d), d_pos := d_pos)
}

// ---------------------------------------------------------------------------
// Integer square root. `isqrt` takes the root `r` of `⌊n/4⌋` first; the root
// of `n` is then `2r` or `2r + 1`, and one comparison of `(2r + 1)²` with `n`
// picks it. A step is a multiplication and a comparison, which the kernel
// evaluates on numerals directly, so a root of `b` bits costs `b` steps, as
// `ldiv` costs one per quotient bit. The numerator is the fuel. The
// specification is `IsRoot`, `r² <= n < (r + 1)²` (`isqrt_spec`).

fn Nat::IsRoot(n, r: Nat) → Type { r * r <= n ∧ n < Succ(r) * Succ(r) }

fn Nat::quarter(self n: Nat) → Nat { n.half().half() }

fn Nat::isqrt_pick(n, r: Nat, c: (r * 2 + 1) * (r * 2 + 1) <= n ∨ ¬((r * 2 + 1) * (r * 2 + 1) <= n)) → Nat {
    match c { Inl(_) => Succ(r * 2), Inr(_) => r * 2 }
}

fn Nat::isqrt_step(n, r: Nat) → Nat { Nat::isqrt_pick(n, r, (Succ(r * 2) * Succ(r * 2)).le_dec(n)) }

fn Nat::isqrt_fuel(self n, fuel: Nat) → Nat {
    match fuel {
        Zero => 0,
        Succ(f) => match n {
            Zero => 0,
            Succ(k) => Nat::isqrt_step(Succ(k), Succ(k).quarter().isqrt_fuel(f)),
        },
    }
}

fn Nat::isqrt(self n: Nat) → Nat { n.isqrt_fuel(n) }

theorem Nat::mul_four(self q: Nat): q * 4 = (q + q) + (q + q) {
    calc {
        q * 4
            = (q * 2) * 2 := sym(q.mul_assoc(2, 2)),
            = (q * 2) + (q * 2) := (q * 2).mul_two(),
            = (q + q) + (q + q) := Nat::cong(λ (w: Nat) => w + w, q.mul_two()),
    }
}

theorem Nat::sq_double(self r: Nat): (r * 2) * (r * 2) = (r * r) * 4 { Nat::mul_shuffle(r, 2, r, 2) }

theorem Nat::succ_double(self r: Nat): r * 2 + 2 = (r + 1) * 2 {
    calc {
        r * 2 + 2
            = r + r + 2 := Nat::cong(λ (w: Nat) => w + 2, r.mul_two()),
            = r + 1 + (r + 1) := sym(Nat::cong_succ(r.add_succ_left(r))),
            = (r + 1) * 2 := sym((r + 1).mul_two()),
    }
}

// `n` lies in `[4q, 4q + 4)` for `q = ⌊n/4⌋`.
theorem Nat::quarter_mul_le(self n: Nat): n.quarter() * 4 <= n {
    let h = n.half();
    let q = h.half();
    let a: (q + q <= h) = h.half_add_le();
    let b: ((q + q) + (q + q) <= h + h) = (q + q).add_le_mono(h, q + q, h, a, a);
    j(sym(q.mul_four()), λ y _ => y <= n, ((q + q) + (q + q)).le_trans(h + h, n, b, n.half_add_le()))
}

theorem Nat::lt_succ_quarter_mul(self n: Nat): n < (n.quarter() + 1) * 4 {
    let h = n.half();
    let q = h.half();
    let A = q + q + 1;
    let a: (h <= A) = h.le_succ_half_add();
    let b: (h + h <= A + A) = h.add_le_mono(A, h, A, a, a);
    let c: (n <= A + A + 1) = n.le_trans(h + h + 1, A + A + 1, n.le_succ_half_add(), Nat::le_succ_succ(h + h, A + A, b));
    let e = calc {
        A + A + 2
            = A + 1 + (A + 1) := sym(Nat::cong_succ(A.add_succ_left(A))),
            = (q + 1 + (q + 1)) + (q + 1 + (q + 1)) := sym(Nat::cong(λ (w: Nat) => w + w, Nat::cong_succ(q.add_succ_left(q)))),
            = (q + 1) * 4 := sym((q + 1).mul_four()),
    };
    j(e, λ y _ => n + 1 <= y, Nat::le_succ_succ(n, A + A + 1, c))
}

theorem Nat::isqrt_pick_spec(n, r: Nat, c: (r * 2 + 1) * (r * 2 + 1) <= n ∨ ¬((r * 2 + 1) * (r * 2 + 1) <= n), ih: Nat::IsRoot(n.quarter(), r)):
    Nat::IsRoot(n, Nat::isqrt_pick(n, r, c))
{
    let q = n.quarter();
    let s = r + 1;
    match c {
        Inl(le) => {
            let up: ((q + 1) * 4 <= (s * s) * 4) = Nat::mul_le_mono_r(4, q + 1, s * s, ih.right);
            let lt: (n < (s * s) * 4) = n.lt_of_lt_of_le((q + 1) * 4, (s * s) * 4, n.lt_succ_quarter_mul(), up);
            let sq: (n < (s * 2) * (s * 2)) = j(sym(s.sq_double()), λ y _ => n < y, lt);
            And(le, j(sym(r.succ_double()), λ y _ => n < y * y, sq))
        },
        Inr(nle) => {
            let down: ((r * r) * 4 <= q * 4) = Nat::mul_le_mono_r(4, r * r, q, ih.left);
            let le: ((r * r) * 4 <= n) = ((r * r) * 4).le_trans(q * 4, n, down, n.quarter_mul_le());
            And(j(sym(r.sq_double()), λ y _ => y <= n, le), Nat::lt_of_not_le(n, (r * 2 + 1) * (r * 2 + 1), nle))
        },
    }
}

theorem Nat::isqrt_fuel_spec(self fuel: Nat): (n: Nat) → n <= fuel → Nat::IsRoot(n, n.isqrt_fuel(fuel)) {
    match fuel {
        Zero => λ n => match n {
            Zero => λ _ => And(trivial, trivial),
            Succ(_) => λ bad => false_elim(bad),
        },
        Succ(f, ih) => λ n => match n {
            Zero => λ _ => And(trivial, trivial),
            Succ(k) => λ le => {
                let toward: ((k + 1).quarter() <= k) = (k + 1).quarter().le_trans((k + 1).half(), k, (k + 1).half().half_le(), k.half_succ_le());
                let below: ((k + 1).quarter() <= f) = (k + 1).quarter().le_trans(k, f, toward, le);
                Nat::isqrt_pick_spec(k + 1, (k + 1).quarter().isqrt_fuel(f), (((k + 1).quarter().isqrt_fuel(f) * 2 + 1) * ((k + 1).quarter().isqrt_fuel(f) * 2 + 1)).le_dec(k + 1),
                    ih((k + 1).quarter(), below))
            },
        },
    }
}

theorem Nat::isqrt_spec(self n: Nat): Nat::IsRoot(n, n.isqrt()) { n.isqrt_fuel_spec(n, n.le_refl()) }

// The decision, evaluated at a known order.
theorem Nat::leb_true(self n, m: Nat, h: n <= m): n.leb(m) = True { eq_true_of_is_true(n.leb(m), n.leb_complete(m, h)) }
theorem Nat::leb_false(self n, m: Nat, h: m < n): n.leb(m) = False {
    match found: n.leb(m) {
        False => refl,
        True => false_elim(m.lt_irrefl((m + 1).le_trans(n, m, h, n.leb_sound(m, j(sym(found), λ d _ => d.IsTrue(), trivial))))),
    }
}

// The decision is transitive, as its verdicts.
theorem Nat::leb_trans(self a, b, c: Nat, p: a.leb(b) = True, q: b.leb(c) = True): a.leb(c) = True {
    a.leb_true(c, a.le_trans(b, c, a.leb_sound(b, Bool::is_true_of_eq(p)), b.leb_sound(c, Bool::is_true_of_eq(q))))
}

// Closed facts by evaluation (`norm_num`, docs/tactics/numeral-normalisation-design.md):
// a `Bool` computed to `True` or `False` proves the fact or refutes it, so
// a comparison of large numerals costs the accelerated `leb` / `same` and
// never a conversion over the numbers.
theorem Nat::le_of_leb(self n, m: Nat, h: n.leb(m) = True): n <= m { n.leb_sound(m, j(sym(h), λ d _ => d.IsTrue(), trivial)) }

theorem Nat::not_le_of_leb(self n, m: Nat, h: n.leb(m) = False): ¬(n <= m) { λ le => absurd(trans(sym(h), n.leb_true(m, le))) }

theorem Nat::le_of_not_lt(self n, m: Nat, h: ¬(n < m)): m <= n {
    or_resolve(m.le_dec(n), λ (k: ¬(m <= n)) => h(n.lt_of_not_le(m, k)))
}

// TODO: use symbol for not
theorem Nat::leb_not_lt(self n, m: Nat, h: (n + 1).leb(m).not().IsTrue()): m.leb(n).IsTrue() {
    m.leb_complete(n, n.le_of_not_lt(m,
        λ (k: n < m) => (n + 1).leb(m).is_true_not(h, (n + 1).leb_complete(m, k))))
}

theorem Nat::leb_lt_le_absurd(self n, m: Nat, lt: (n + 1).leb(m).IsTrue(), le: m.leb(n).IsTrue()): False {
    n.lt_irrefl((n + 1).le_trans(m, n, (n + 1).leb_sound(m, lt), m.leb_sound(n, le)))
}

// `ones(j)` is 2^j - 1, so a number is below two to its width.
theorem Nat::ones_succ_pow(self j: Nat): j.ones() + 1 = Nat::pow(2, j) {
    match j {
        Zero => refl,
        Succ(i) => {
            let o = i.ones();
            let ih: (o + 1 = Nat::pow(2, i)) = i.ones_succ_pow();
            let fwd: (0 + o + 1 + o = (0 + o) + o + 1) = (0 + o).add_succ_left(o);
            let back: ((0 + o) + o + 1 = 0 + o + 1 + o) = j(fwd, λ z _ => z = 0 + o + 1 + o, refl);
            let step: (o * 2 + 2 = (o + 1) * 2) = Nat::cong_succ(back);
            j(ih, λ y _ => o * 2 + 2 = y * 2, step)
        },
    }
}

theorem Nat::lt_pow_width(self n: Nat): n < Nat::pow(2, n.width()) {
    let w = n.width();
    let below: (n <= w.ones()) = n.le_ones_width();
    let top: (w.ones() + 1 = Nat::pow(2, w)) = w.ones_succ_pow();
    j(top, λ y _ => n < y, below)
}

// And from the other side: a positive `n` is at least half of `2^width(n)`,
// so `2^(width(n) - 1) <= n < 2^width(n)`. A halving step doubles both
// sides; at one the width is one.
theorem Nat::width_fuel_zero(self f: Nat): Nat::width_fuel(0, f) = 0 { match f { Zero => refl, Succ(_) => refl } }

theorem Nat::pow_width_le_fuel(self fuel: Nat): (n: Nat) → n <= fuel → 0 < n → Nat::pow(2, Nat::width_fuel(n, fuel)) <= n + n {
    match fuel {
        Zero => λ n le pos => false_elim(Nat::le_trans(1, n, 0, pos, le)),
        Succ(f, ih) => λ n => match n {
            Zero => λ _ (pos: False) => false_elim(pos),
            Succ(k) => λ le _ => {
                let kf: (k <= f) = le;
                let two: (2 <= k + 1 + (k + 1)) = Nat::le_trans(1, k + 1, k + 1 + k, trivial, (k + 1).le_add_l(k));
                match (k + 1).half() as λ y => y <= f → y + y <= k + 1 → Nat::pow(2, Nat::width_fuel(y, f) + 1) <= k + 1 + (k + 1) {
                    Zero => λ _ _ => j(sym(f.width_fuel_zero()), λ w _ => Nat::pow(2, w + 1) <= k + 1 + (k + 1), two),
                    Succ(l) => λ lf hh => {
                        let w = Nat::width_fuel(l + 1, f);
                        let below: (Nat::pow(2, w) <= k + 1) = Nat::le_trans(Nat::pow(2, w), l + 1 + (l + 1), k + 1, ih(l + 1, lf, trivial), hh);
                        j((k + 1).mul_two(), λ v _ => Nat::pow(2, w) * 2 <= v, Nat::mul_le_mono_r(2, Nat::pow(2, w), k + 1, below))
                    },
                }((k + 1).half().le_trans(k, f, k.half_succ_le(), kf), (k + 1).half_add_le())
            },
        },
    }
}

theorem Nat::pow_width_le(self n: Nat, pos: 0 < n): Nat::pow(2, n.width()) <= n + n { n.pow_width_le_fuel(n, n.le_refl(), pos) }

// A power of two outgrows its exponent: n < 2^n. The binary rate of a real's
// terms (std/creal) is at least as fine as the unary one.
theorem Nat::lt_two_pow(self n: Nat): n < Nat::pow(2, n) {
    match n {
        Zero => trivial,
        Succ(k) => {
            let p = Nat::pow(2, k);
            let ih: (k < p) = k.lt_two_pow();
            let one: (1 <= p) = Nat::one_le_pow(2, k, trivial);
            let sum: (k + 1 + 1 <= p + p) = Nat::add_le_mono(k + 1, p, 1, p, ih, one);
            j(p.mul_two(), λ y _ => k + 1 + 1 <= y → k + 1 < p * 2, λ h => h)(sum)
        },
    }
}

// Floats at the reals (docs/floating-point-design.md §6, §17; submilestone
// `float-reals`).
//
// A finite float's value is a rational, and its real is that rational's
// image (`Finite::real`). `RoundsToReal` (round_real.hthr) is `RoundsTo`
// at the reals: some rational interval around the real rounds to the float
// throughout. Every operation whose exact value is rational carries over
// with no new proof (`add_real` and the rest: the rational's image is the
// real's value up to `≈`).
//
// The square root does not have a rational value, which is why its theorem
// at `Rat` (arith.hthr, `Finite::sqrt_correct`) is stated at every rational
// in `√x`'s cell. At the reals it is the plain statement: the float root is
// a correct rounding of the real root, `RoundsToReal(F, mode, s, a.sqrt())`
// for any `s` with `s.IsSqrt(a.val())` (`Finite::sqrt_real`), such as
// `CReal::sqrt_rat(a.val())` (`Finite::sqrt_rounds_real`). The interval is
// read off the root's description: an exact root is a grid point `g`, and
// `s ≈ g`; an inexact one lies strictly between grid points `g < √x < g'`,
// and there are rationals `lo`, `hi` with `g < lo <= √x <= hi < g'`
// (`Rat::root_above`, `Rat::root_below`), between which every rational is
// in the cell.
//
// The error model carries over the same way, and is proved once over any
// ordered field with a morphism from `Rat` (§18.2): a rounding interval
// around `x` cut to lie in range has both ends rounding to `r`, the rational
// bound `|r - q| <= u·|q| + η` is two affine bounds with nonnegative slopes
// there, and an affine bound at both ends holds in between
// (`Rat::err_in_nonneg`, `_nonpos`). At `CReal` the sandwich reads as
// `|r - x| <= u·x + η` in range and `|r - x| <= u·x` in the normal range
// at every nonnegative real (`Format::real_error_nonneg`,
// `real_relative_nonneg`), in particular for the root
// (`Finite::sqrt_real_error`, `sqrt_real_relative`), and at a real of
// either sign (`Format::real_error`, `real_relative`) the sign is split
// inside the `≤`, which needs no decision. A faithful rounding has the
// directed modes' model (`Format::real_faithful_error`).
//
// The root of a real is `CReal::sqrt` (creal.hthr); at a float's real it is
// `sqrt_rat` of the value, so the float root rounds it
// (`Finite::sqrt_rounds_root`).

import logic;
import bool;
import nat;
import int;
import omega;
import ring;
import linarith;
import option;
import relation_props;
import algebra;
import algebra_rel;
import order;
import ordered_field;
import morphism;
import semiring;
import rat;
import creal;
import dyadic;
import float;
import round;
import window;
import literal;
import interval;
import creal_interval;
import arith;
import error;
import round_real;

// ---------------------------------------------------------------------------
// The real of a float, and the operations with rational exact values.

fn Finite::real({F: Format}, self f: Finite(F)) → CReal { CReal::ofRat(f.val()) }

// A rational's rounding is a real's when the real is its image.
theorem Format::rounds_real_of_same(self F: Format, mode: Mode, q: Rat, {x: CReal}, e: CReal::ofRat(q) ≈ x, r: Float(F), h: RoundsTo(F, mode, q, r)): RoundsToReal(F, mode, x, r) {
    F.rounds_real_respects(mode, e, r, F.rounds_real_of_rat(mode, q, r, h))
}

theorem Finite::add_real({F: Format}, a, b: Finite(F), mode: Mode): RoundsToReal(F, mode, a.real() + b.real(), a.add(b, mode := mode)) {
    F.rounds_real_of_same(mode, a.val() + b.val(), CReal::ofRat_add(a.val(), b.val()), a.add(b, mode := mode), Finite::add_correct(a, b, mode))
}

theorem Finite::sub_real({F: Format}, a, b: Finite(F), mode: Mode): RoundsToReal(F, mode, a.real() - b.real(), a.sub(b, mode := mode)) {
    F.rounds_real_of_same(mode, a.val() - b.val(), CReal::ofRat_sub(a.val(), b.val()), a.sub(b, mode := mode), Finite::sub_correct(a, b, mode))
}

theorem Finite::mul_real({F: Format}, a, b: Finite(F), mode: Mode): RoundsToReal(F, mode, a.real() * b.real(), a.mul(b, mode := mode)) {
    F.rounds_real_of_same(mode, a.val() * b.val(), CReal::ofRat_mul(a.val(), b.val()), a.mul(b, mode := mode), Finite::mul_correct(a, b, mode))
}

theorem Finite::fma_real({F: Format}, a, b, c: Finite(F), mode: Mode): RoundsToReal(F, mode, a.real() * b.real() + c.real(), a.fma(b, c, mode := mode)) {
    let e = CReal::same_trans(CReal::ofRat_add(a.val() * b.val(), c.val()), CReal::add_respects(CReal::ofRat_mul(a.val(), b.val()), c.real().same_refl()));
    F.rounds_real_of_same(mode, a.val() * b.val() + c.val(), e, a.fma(b, c, mode := mode), Finite::fma_correct(a, b, c, mode))
}

theorem Finite::convert_real({F: Format}, f: Finite(F), G: Format, mode: Mode): RoundsToReal(G, mode, f.real(), f.convert(G, mode := mode)) {
    G.rounds_real_of_rat(mode, f.val(), f.convert(G, mode := mode), Finite::convert_correct(f, G, mode))
}

// ---------------------------------------------------------------------------
// The square root.

// The value theorem: the root of a nonnegative float is a correct rounding
// of the real root of its value, in every mode.
theorem Finite::sqrt_real({F: Format}, a: Finite(F), mode: Mode, nan: F.specials.has_nan().IsTrue(), nn: 0 <= a.val(),
    s: CReal, root: s.IsSqrt(a.val())): RoundsToReal(F, mode, s, a.sqrt(mode := mode, nan := nan))
{
    let x = a.val();
    let h = a.sqrt_h();
    let r = a.sqrt(mode := mode, nan := nan);
    let g = F.grid(h.int());
    let g_nn: (0 <= g) = Rat::le_respects(F.grid_zero(), g.same_refl(), F.grid_le(0, h.int(), omega));
    match a.sqrt_st() as λ b => F.SqrtApprox(x, h, b) → ((q: Rat) → F.Approx(q, h, b) → RoundsTo(F, mode, q, r)) → RoundsToReal(F, mode, s, r) {
        False => λ (e: x ≈ F.grid_sq(h.int())) rd => {
            let up: (s <= CReal::ofRat(g)) = root.right(g, g_nn, Rat::le_of_same(e));
            let down: (CReal::ofRat(g) <= s) = root.left(g, g_nn, Rat::le_of_same(Rat::same_sym(e)));
            F.rounds_real_of_same(mode, g, CReal::le_antisymm(down, up), r, rd(g, g.same_refl()))
        },
        True => λ (bd: F.grid_sq(h.int()) < x ∧ x < F.grid_sq(h.int() + 1)) rd => {
            let g1 = F.grid(h.int() + 1);
            let g1_pos: (0 < g1) = Rat::lt_respects(F.grid_zero(), g1.same_refl(), F.grid_lt(0, h.int() + 1, omega));
            match Rat::root_above(g_nn, bd.left) {
                Exists(lo, lw) => match Rat::root_below(nn, g1_pos, bd.right) {
                    Exists(hi, hw) => {
                        let lo_nn: (0 <= lo) = Rat::le_of_lt(Rat::lt_of_le_of_lt(g_nn, lw.left));
                        Exists(lo, Exists(hi, And(root.left(lo, lo_nn, lw.right), And(root.right(hi, hw.right.left, hw.right.right),
                            λ q (l: lo <= q) (u: q <= hi) => rd(q, And(Rat::lt_of_lt_of_le(lw.left, l), Rat::lt_of_le_of_lt(u, hw.left)))))))
                    },
                },
            }
        },
    }(a.sqrt_approx(nn), λ q aq => Finite::sqrt_correct(a, mode, nan, nn, q, F.cell_of_approx(x, q, h, a.sqrt_st(), a.sqrt_approx(nn), aq)))
}

// At the constructed root.
theorem Finite::sqrt_rounds_real({F: Format}, a: Finite(F), mode: Mode, nan: F.specials.has_nan().IsTrue(), nn: 0 <= a.val()):
    RoundsToReal(F, mode, CReal::sqrt_rat(a.val()), a.sqrt(mode := mode, nan := nan))
{
    Finite::sqrt_real(a, mode, nan, nn, CReal::sqrt_rat(a.val()), CReal::is_sqrt_respects(a.val().abs_of_nonneg(nn), CReal::sqrt_rat_is_sqrt(a.val())))
}

// ---------------------------------------------------------------------------
// The error model over any ordered field (docs/floating-point-design.md
// §18.2).
//
// The rational bound `|r - q| <= u·|q| + η` (error.hthr) is two affine
// bounds in `q` (`Rat::sides_of_abs`), with slopes `1 ± u`, nonnegative when
// `0 <= u <= 1`. An affine bound with a nonnegative slope at a rational
// below `x` holds at `x` above it (`Rat::affine_up`), and one at a rational
// above `x` holds below it (`Rat::affine_down`). A rounding interval around
// `x` cut to lie in range (`Rat::around_above`, `around_below`) has both
// ends in range and rounding to `r`, so the two sides hold at `x`: the
// standard model as the sandwich `(1 - u)·x - η <= r <= (1 + u)·x + η` at a
// nonnegative `x`, with the slopes swapped at a nonpositive one. Nothing
// about `x` is decided and nothing beyond the field's laws and the
// morphism's is read, so the same proof serves `Rat`, `CReal`, and any
// other ordered field; the `CReal` theorems below are its readings.

// A faithful rounding is within the directed modes' bound (`u` and `η`
// doubled from nearest's).
theorem Format::faithful_error_bound(self F: Format, q: Rat, r: Finite(F), range: q.abs() <= (Finite::max_finite(F)).val(), h: F.Faithful(q, Fin(r))):
    (r.val() - q).abs() <= F.u(TowardNeg) * q.abs() + F.eta(TowardNeg)
{
    match h { Inl(d) => F.error_bound(TowardNeg, q, r, range, d), Inr(u) => F.error_bound(TowardPos, q, r, range, u) }
}

section<K: OrderedField(≈, <, <=, +, *)>({map: Rat → K},
        hom: OrderedRingHom<Rat, K>(map, Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul, Rat::neg, 0, 1,
            ≈, <, <=, +, *, K.inv, K.unit, K.multiplicative.unit)) {

// `R <= a·lo + b` with `0 <= a` and `lo` below `x`: `R <= a·x + b` at `x`.
theorem Rat::affine_up(x: K, lo, R, a, b: Rat, a_nn: 0 <= a, l: map(lo) <= x, at: R <= a * lo + b): map(R) <= map(a) * x + map(b) {
    let A = map(a);
    let L = a * lo + b;
    let e0: (map(L) ≈ A * map(lo) + map(b)) = K.rel_trans(map(L), map(a * lo) + map(b), A * map(lo) + map(b),
        hom.map_add(a * lo, b), OrderedAddMonoid::add_respects(map(a * lo), A * map(lo), map(b), map(b), hom.map_mul(a, lo), K.rel_refl(map(b))));
    let a0: (K.unit <= A) = StrictOrder::le_of_same_l(K.unit, map(0), A, K.rel_sym(map(0), K.unit, hom.map_zero), hom.map_le(0, a, a_nn));
    let m: (A * map(lo) + map(b) <= A * x + map(b)) = OrderedAddMonoid::add_le_mono_r(A * map(lo), A * x, map(b), OrderedSemiring::mul_le_mono_l(map(lo), x, A, l, a0));
    PseudoOrder::le_trans(map(R), A * map(lo) + map(b), A * x + map(b),
        StrictOrder::le_of_same_r(map(R), map(L), A * map(lo) + map(b), K.rel_sym(map(L), A * map(lo) + map(b), e0), hom.map_le(R, L, at)), m)
}

// `a·hi + b <= R` with `0 <= a` and `hi` above `x`: `a·x + b <= R` at `x`.
theorem Rat::affine_down(x: K, hi, R, a, b: Rat, a_nn: 0 <= a, h: x <= map(hi), at: a * hi + b <= R): map(a) * x + map(b) <= map(R) {
    let A = map(a);
    let H = a * hi + b;
    let e0: (map(H) ≈ A * map(hi) + map(b)) = K.rel_trans(map(H), map(a * hi) + map(b), A * map(hi) + map(b),
        hom.map_add(a * hi, b), OrderedAddMonoid::add_respects(map(a * hi), A * map(hi), map(b), map(b), hom.map_mul(a, hi), K.rel_refl(map(b))));
    let a0: (K.unit <= A) = StrictOrder::le_of_same_l(K.unit, map(0), A, K.rel_sym(map(0), K.unit, hom.map_zero), hom.map_le(0, a, a_nn));
    let m: (A * x + map(b) <= A * map(hi) + map(b)) = OrderedAddMonoid::add_le_mono_r(A * x, A * map(hi), map(b), OrderedSemiring::mul_le_mono_l(x, map(hi), A, h, a0));
    PseudoOrder::le_trans(A * x + map(b), A * map(hi) + map(b), map(R), m,
        StrictOrder::le_of_same_l(A * map(hi) + map(b), map(H), map(R), K.rel_sym(map(H), A * map(hi) + map(b), e0), hom.map_le(H, R, at)))
}

// The transfer at a nonnegative point: a bound `|R - q| <= u·|q| + e` at
// every rational of `[b, M]` with `P` (`0 <= b`) holds at every `x` in
// `[b, M]` that `P` holds around, as its two sides.
theorem Rat::err_in_nonneg(x: K, P: Rat → Type, R, u, e, b, M: Rat, u_nn: 0 <= u, u_le: u <= 1, b_nn: 0 <= b,
    low: map(b) <= x, range: x <= map(M), h: Rat::Around(hom, x, P),
    bound: (q: Rat) → b <= q → q <= M → P(q) → Rat::abs(R - q) <= u * Rat::abs(q) + e):
    map(1 - u) * x + map(-e) <= map(R) ∧ map(R) <= map(1 + u) * x + map(e)
{
    let slopes = Rat::slopes_nonneg(u_nn, u_le);
    let cut = Rat::around_below(hom, x, λ q => b <= q ∧ P(q), M, range, Rat::around_above(hom, x, P, b, low, h));
    match Rat::around_ends(hom, x, λ q => q <= M ∧ (b <= q ∧ P(q)), cut) {
        Exists(lo, rest) => match rest {
            Exists(hi, w) => {
                let pl = w.right.right.left;
                let ph = w.right.right.right;
                let at_lo = Rat::sides_of_abs(Rat::le_trans(b_nn, pl.right.left), bound(lo, pl.right.left, pl.left, pl.right.right));
                let at_hi = Rat::sides_of_abs(Rat::le_trans(b_nn, ph.right.left), bound(hi, ph.right.left, ph.left, ph.right.right));
                And(Rat::affine_down(hom, x, hi, R, 1 - u, -e, slopes.left, w.right.left, at_hi.right),
                    Rat::affine_up(hom, x, lo, R, 1 + u, e, slopes.right, w.left, at_lo.left))
            },
        },
    }
}

// At a nonpositive point the slopes swap: `[-M, c]` with `c <= 0`.
theorem Rat::err_in_nonpos(x: K, P: Rat → Type, R, u, e, c, M: Rat, u_nn: 0 <= u, u_le: u <= 1, c_np: c <= 0,
    high: x <= map(c), range: map(-M) <= x, h: Rat::Around(hom, x, P),
    bound: (q: Rat) → -M <= q → q <= c → P(q) → Rat::abs(R - q) <= u * Rat::abs(q) + e):
    map(1 + u) * x + map(-e) <= map(R) ∧ map(R) <= map(1 - u) * x + map(e)
{
    let slopes = Rat::slopes_nonneg(u_nn, u_le);
    let cut = Rat::around_below(hom, x, λ q => -M <= q ∧ P(q), c, high, Rat::around_above(hom, x, P, -M, range, h));
    match Rat::around_ends(hom, x, λ q => q <= c ∧ (-M <= q ∧ P(q)), cut) {
        Exists(lo, rest) => match rest {
            Exists(hi, w) => {
                let pl = w.right.right.left;
                let ph = w.right.right.right;
                let at_lo = Rat::sides_of_abs_nonpos(Rat::le_trans(pl.left, c_np), bound(lo, pl.right.left, pl.left, pl.right.right));
                let at_hi = Rat::sides_of_abs_nonpos(Rat::le_trans(ph.left, c_np), bound(hi, ph.right.left, ph.left, ph.right.right));
                And(Rat::affine_down(hom, x, hi, R, 1 + u, -e, slopes.right, w.right.left, at_hi.right),
                    Rat::affine_up(hom, x, lo, R, 1 - u, e, slopes.left, w.left, at_lo.left))
            },
        },
    }
}

// A zero intercept drops out.
theorem Rat::image_add_zero(y: K): y + map(0) ≈ y {
    K.rel_trans(y + map(0), y + K.unit, y, OrderedAddMonoid::add_respects(y, y, map(0), K.unit, K.rel_refl(y), hom.map_zero), K.unit_r(y))
}

theorem Rat::image_add_neg_zero(y: K): y + map(-0) ≈ y {
    K.rel_trans(y + map(-0), y + map(0), y, OrderedAddMonoid::add_respects(y, y, map(-0), map(0), K.rel_refl(y), hom.map_respects(-0, 0, refl)),
        Rat::image_add_zero(hom, y))
}

// The error model with underflow, at a nonnegative point in range.
theorem Format::error_in_nonneg(self F: Format, mode: Mode, x: K, r: Finite(F), nn: map(0) <= x, range: x <= map((Finite::max_finite(F)).val()),
    hr: F.RoundsIn(hom, mode, x, Fin(r))):
    map(1 - F.u(mode)) * x + map(-F.eta(mode)) <= map(r.val()) ∧ map(r.val()) <= map(1 + F.u(mode)) * x + map(F.eta(mode))
{
    let M = (Finite::max_finite(F)).val();
    Rat::err_in_nonneg(hom, x, λ q => RoundsTo(F, mode, q, Fin(r)), r.val(), F.u(mode), F.eta(mode), 0, M, Rat::le_of_lt(F.u_pos(mode)), F.u_le_one(mode), Rat::le_refl(0),
        nn, range, hr, λ q (q_nn: 0 <= q) (q_M: q <= M) hq => F.error_bound(mode, q, r, Rat::le_respects(Rat::same_sym(q.abs_of_nonneg(q_nn)), M.same_refl(), q_M), hq))
}

// The error model with underflow, at a nonpositive point in range.
theorem Format::error_in_nonpos(self F: Format, mode: Mode, x: K, r: Finite(F), np: x <= map(0), range: map(-(Finite::max_finite(F)).val()) <= x,
    hr: F.RoundsIn(hom, mode, x, Fin(r))):
    map(1 + F.u(mode)) * x + map(-F.eta(mode)) <= map(r.val()) ∧ map(r.val()) <= map(1 - F.u(mode)) * x + map(F.eta(mode))
{
    let M = (Finite::max_finite(F)).val();
    Rat::err_in_nonpos(hom, x, λ q => RoundsTo(F, mode, q, Fin(r)), r.val(), F.u(mode), F.eta(mode), 0, M, Rat::le_of_lt(F.u_pos(mode)), F.u_le_one(mode), Rat::le_refl(0),
        np, range, hr, λ q (q_M: -M <= q) (q_np: q <= 0) hq => F.error_bound(mode, q, r, Rat::abs_le_of_between(q_M, q_np), hq))
}

// The standard model in the normal range, at a nonnegative point:
// `(1 - u)·x <= r <= (1 + u)·x`.
theorem Format::relative_in_nonneg(self F: Format, mode: Mode, x: K, r: Finite(F), normal: map((Finite::min_normal(F)).val()) <= x,
    range: x <= map((Finite::max_finite(F)).val()), hr: F.RoundsIn(hom, mode, x, Fin(r))):
    map(1 - F.u(mode)) * x <= map(r.val()) ∧ map(r.val()) <= map(1 + F.u(mode)) * x
{
    let M = (Finite::max_finite(F)).val();
    let m = (Finite::min_normal(F)).val();
    let s = Rat::err_in_nonneg(hom, x, λ q => RoundsTo(F, mode, q, Fin(r)), r.val(), F.u(mode), 0, m, M, Rat::le_of_lt(F.u_pos(mode)), F.u_le_one(mode),
        Rat::le_of_lt(Finite::min_normal_pos(F)), normal, range, hr,
        λ q (q_m: m <= q) (q_M: q <= M) hq => {
            let ea = q.abs_of_nonneg(Rat::le_trans(Rat::le_of_lt(Finite::min_normal_pos(F)), q_m));
            let rel = F.relative_error(mode, q, r, Rat::le_respects(Rat::same_sym(ea), M.same_refl(), q_M), Rat::le_respects(m.same_refl(), Rat::same_sym(ea), q_m), hq);
            Rat::le_respects(Rat::same_refl(Rat::abs(r.val() - q)), Rat::same_sym(Rat::add_zero(F.u(mode) * Rat::abs(q))), rel)
        });
    let lo_x = map(1 - F.u(mode)) * x;
    let hi_x = map(1 + F.u(mode)) * x;
    And(StrictOrder::le_of_same_l(lo_x, lo_x + map(-0), map(r.val()), K.rel_sym(lo_x + map(-0), lo_x, Rat::image_add_neg_zero(hom, lo_x)), s.left),
        StrictOrder::le_of_same_r(map(r.val()), hi_x + map(0), hi_x, K.rel_sym(hi_x + map(0), hi_x, Rat::image_add_zero(hom, hi_x)), s.right))
}

// The standard model in the normal range, at a nonpositive point:
// `(1 + u)·x <= r <= (1 - u)·x`.
theorem Format::relative_in_nonpos(self F: Format, mode: Mode, x: K, r: Finite(F), normal: x <= map(-(Finite::min_normal(F)).val()),
    range: map(-(Finite::max_finite(F)).val()) <= x, hr: F.RoundsIn(hom, mode, x, Fin(r))):
    map(1 + F.u(mode)) * x <= map(r.val()) ∧ map(r.val()) <= map(1 - F.u(mode)) * x
{
    let M = (Finite::max_finite(F)).val();
    let m = (Finite::min_normal(F)).val();
    let s = Rat::err_in_nonpos(hom, x, λ q => RoundsTo(F, mode, q, Fin(r)), r.val(), F.u(mode), 0, -m, M, Rat::le_of_lt(F.u_pos(mode)), F.u_le_one(mode),
        Rat::neg_nonpos_of_pos(Finite::min_normal_pos(F)), normal, range, hr,
        λ q (q_M: -M <= q) (q_m: q <= -m) hq => {
            let ab = Rat::abs_between_neg(Finite::min_normal_pos(F), q_M, q_m);
            let rel = F.relative_error(mode, q, r, ab.right, ab.left, hq);
            Rat::le_respects(Rat::same_refl(Rat::abs(r.val() - q)), Rat::same_sym(Rat::add_zero(F.u(mode) * Rat::abs(q))), rel)
        });
    let lo_x = map(1 + F.u(mode)) * x;
    let hi_x = map(1 - F.u(mode)) * x;
    And(StrictOrder::le_of_same_l(lo_x, lo_x + map(-0), map(r.val()), K.rel_sym(lo_x + map(-0), lo_x, Rat::image_add_neg_zero(hom, lo_x)), s.left),
        StrictOrder::le_of_same_r(map(r.val()), hi_x + map(0), hi_x, K.rel_sym(hi_x + map(0), hi_x, Rat::image_add_zero(hom, hi_x)), s.right))
}

// A faithful rounding is within the directed modes' model, at a
// nonnegative point and at a nonpositive one.
theorem Format::faithful_error_in_nonneg(self F: Format, x: K, r: Finite(F), nn: map(0) <= x, range: x <= map((Finite::max_finite(F)).val()),
    hr: F.FaithfulIn(hom, x, Fin(r))):
    map(1 - F.u(TowardNeg)) * x + map(-F.eta(TowardNeg)) <= map(r.val()) ∧ map(r.val()) <= map(1 + F.u(TowardNeg)) * x + map(F.eta(TowardNeg))
{
    let M = (Finite::max_finite(F)).val();
    Rat::err_in_nonneg(hom, x, λ q => F.Faithful(q, Fin(r)), r.val(), F.u(TowardNeg), F.eta(TowardNeg), 0, M, Rat::le_of_lt(F.u_pos(TowardNeg)), F.u_le_one(TowardNeg), Rat::le_refl(0),
        nn, range, hr, λ q (q_nn: 0 <= q) (q_M: q <= M) hq => F.faithful_error_bound(q, r, Rat::le_respects(Rat::same_sym(q.abs_of_nonneg(q_nn)), M.same_refl(), q_M), hq))
}

theorem Format::faithful_error_in_nonpos(self F: Format, x: K, r: Finite(F), np: x <= map(0), range: map(-(Finite::max_finite(F)).val()) <= x,
    hr: F.FaithfulIn(hom, x, Fin(r))):
    map(1 + F.u(TowardNeg)) * x + map(-F.eta(TowardNeg)) <= map(r.val()) ∧ map(r.val()) <= map(1 - F.u(TowardNeg)) * x + map(F.eta(TowardNeg))
{
    let M = (Finite::max_finite(F)).val();
    Rat::err_in_nonpos(hom, x, λ q => F.Faithful(q, Fin(r)), r.val(), F.u(TowardNeg), F.eta(TowardNeg), 0, M, Rat::le_of_lt(F.u_pos(TowardNeg)), F.u_le_one(TowardNeg), Rat::le_refl(0),
        np, range, hr, λ q (q_M: -M <= q) (q_np: q <= 0) hq => F.faithful_error_bound(q, r, Rat::abs_le_of_between(q_M, q_np), hq))
}

}

// ---------------------------------------------------------------------------
// The error model at the reals: the readings at `CReal::ofRat_hom`, the
// sandwich restated as `|r - x| <= u·x + η`.

// The sandwich around a nonnegative real, as an absolute value.
theorem CReal::abs_of_sandwich({x, R: CReal}, u, e: Rat, lower: CReal::ofRat(1 - u) * x + CReal::ofRat(-e) <= R, upper: R <= CReal::ofRat(1 + u) * x + CReal::ofRat(e)):
    (R - x).abs() <= CReal::ofRat(u) * x + CReal::ofRat(e)
{
    let U = CReal::ofRat(u);
    let a: (CReal::ofRat(1 + u) * x ≈ (1 + U) * x) = CReal::mul_respects(CReal::ofRat_add(1, u), x.same_refl());
    let b: (CReal::ofRat(1 - u) * x ≈ (1 - U) * x) = CReal::mul_respects(CReal::ofRat_sub(1, u), x.same_refl());
    let c: (CReal::ofRat(-e) ≈ -CReal::ofRat(e)) = CReal::ofRat_neg(e);
    CReal::abs_le(linarith(lower, b, c), linarith(upper, a))
}

// The sandwich around a nonpositive real, as an absolute value.
theorem CReal::abs_of_sandwich_nonpos({x, R: CReal}, u, e: Rat, lower: CReal::ofRat(1 + u) * x + CReal::ofRat(-e) <= R, upper: R <= CReal::ofRat(1 - u) * x + CReal::ofRat(e)):
    (R - x).abs() <= CReal::ofRat(u) * -x + CReal::ofRat(e)
{
    let U = CReal::ofRat(u);
    let a: (CReal::ofRat(1 + u) * x ≈ (1 + U) * x) = CReal::mul_respects(CReal::ofRat_add(1, u), x.same_refl());
    let b: (CReal::ofRat(1 - u) * x ≈ (1 - U) * x) = CReal::mul_respects(CReal::ofRat_sub(1, u), x.same_refl());
    let c: (CReal::ofRat(-e) ≈ -CReal::ofRat(e)) = CReal::ofRat_neg(e);
    let un = Ring::mul_neg(U, x);
    CReal::abs_le(linarith(lower, a, c, un), linarith(upper, b, un))
}

// The error model with underflow at a nonnegative real in range:
// `|r - x| <= u·x + η`.
theorem Format::real_error_nonneg(self F: Format, mode: Mode, x: CReal, r: Finite(F), nn: 0 <= x,
    range: x <= CReal::ofRat((Finite::max_finite(F)).val()), hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * x + CReal::ofRat(F.eta(mode))
{
    let s = F.error_in_nonneg(CReal::ofRat_hom(), mode, x, r, nn, range, hr);
    CReal::abs_of_sandwich(F.u(mode), F.eta(mode), s.left, s.right)
}

// The relative error in the normal range: `|r - x| <= u·x`.
theorem Format::real_relative_nonneg(self F: Format, mode: Mode, x: CReal, r: Finite(F), normal: CReal::ofRat((Finite::min_normal(F)).val()) <= x,
    range: x <= CReal::ofRat((Finite::max_finite(F)).val()), hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * x
{
    let s = F.relative_in_nonneg(CReal::ofRat_hom(), mode, x, r, normal, range, hr);
    let U = CReal::ofRat(F.u(mode));
    let a: (CReal::ofRat(1 + F.u(mode)) * x ≈ (1 + U) * x) = CReal::mul_respects(CReal::ofRat_add(1, F.u(mode)), x.same_refl());
    let b: (CReal::ofRat(1 - F.u(mode)) * x ≈ (1 - U) * x) = CReal::mul_respects(CReal::ofRat_sub(1, F.u(mode)), x.same_refl());
    CReal::abs_le(linarith(s.left, b), linarith(s.right, a))
}

// The error model with underflow at a nonpositive real in range.
theorem Format::real_error_nonpos(self F: Format, mode: Mode, x: CReal, r: Finite(F), np: x <= 0,
    range: CReal::ofRat(-(Finite::max_finite(F)).val()) <= x, hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * -x + CReal::ofRat(F.eta(mode))
{
    let s = F.error_in_nonpos(CReal::ofRat_hom(), mode, x, r, np, range, hr);
    CReal::abs_of_sandwich_nonpos(F.u(mode), F.eta(mode), s.left, s.right)
}

// The relative error at a nonpositive real in the normal range.
theorem Format::real_relative_nonpos(self F: Format, mode: Mode, x: CReal, r: Finite(F), normal: x <= CReal::ofRat(-(Finite::min_normal(F)).val()),
    range: CReal::ofRat(-(Finite::max_finite(F)).val()) <= x, hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * -x
{
    let s = F.relative_in_nonpos(CReal::ofRat_hom(), mode, x, r, normal, range, hr);
    let U = CReal::ofRat(F.u(mode));
    let a: (CReal::ofRat(1 + F.u(mode)) * x ≈ (1 + U) * x) = CReal::mul_respects(CReal::ofRat_add(1, F.u(mode)), x.same_refl());
    let b: (CReal::ofRat(1 - F.u(mode)) * x ≈ (1 - U) * x) = CReal::mul_respects(CReal::ofRat_sub(1, F.u(mode)), x.same_refl());
    let un = Ring::mul_neg(U, x);
    CReal::abs_le(linarith(s.left, a, un), linarith(s.right, b, un))
}

// A faithful rounding of a real in range is within the directed modes'
// model: `|r - x| <= 2^(1-p)·|x| + 2^qmin` (`u`, `η` at `TowardNeg`).
theorem Format::real_faithful_error(self F: Format, x: CReal, r: Finite(F), range: x.abs() <= CReal::ofRat((Finite::max_finite(F)).val()),
    hr: FaithfulReal(F, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(TowardNeg)) * x.abs() + CReal::ofRat(F.eta(TowardNeg))
{
    let M = (Finite::max_finite(F)).val();
    let U = CReal::ofRat(F.u(TowardNeg));
    let u_nn: (0 <= U) = CReal::ofRat_le(Rat::le_of_lt(F.u_pos(TowardNeg)));
    CReal::le_by_sign(x,
        λ nn => {
            let s = F.faithful_error_in_nonneg(CReal::ofRat_hom(), x, r, nn, CReal::le_trans(x.le_abs(), range), hr);
            let b = CReal::abs_of_sandwich(F.u(TowardNeg), F.eta(TowardNeg), s.left, s.right);
            let m: (U * x <= U * x.abs()) = CReal::mul_le_mono_l(x.le_abs(), u_nn);
            linarith(b, m)
        },
        λ np => {
            let low: (CReal::ofRat(-M) <= x) = CReal::le_of_same_l(CReal::ofRat_neg(M), linarith(x.neg_le_abs(), range));
            let s = F.faithful_error_in_nonpos(CReal::ofRat_hom(), x, r, np, low, hr);
            let b = CReal::abs_of_sandwich_nonpos(F.u(TowardNeg), F.eta(TowardNeg), s.left, s.right);
            let m: (U * -x <= U * x.abs()) = CReal::mul_le_mono_l(x.neg_le_abs(), u_nn);
            linarith(b, m)
        })
}

// The root's error with underflow, `|r - √x| <= u·√x + η`, while `x <= M²`
// (`M` the largest finite float).
theorem Finite::sqrt_real_error({F: Format}, a: Finite(F), mode: Mode, nan: F.specials.has_nan().IsTrue(), nn: 0 <= a.val(),
    s: CReal, root: s.IsSqrt(a.val()), range: a.val() <= (Finite::max_finite(F)).val() * (Finite::max_finite(F)).val(),
    r: Finite(F), is: a.sqrt(mode := mode, nan := nan) = Fin(r)):
    (r.real() - s).abs() <= CReal::ofRat(F.u(mode)) * s + CReal::ofRat(F.eta(mode))
{
    let hr: RoundsToReal(F, mode, s, Fin(r)) = j(is, λ v _ => RoundsToReal(F, mode, s, v), Finite::sqrt_real(a, mode, nan, nn, s, root));
    F.real_error_nonneg(mode, s, r, CReal::is_sqrt_nonneg(nn, root), root.right((Finite::max_finite(F)).val(), Finite::max_finite_nonneg(F), range), hr)
}

// The standard model for the root, `|r - √x| <= u·√x`, while
// `m² <= x <= M²` (`m` the least normal).
theorem Finite::sqrt_real_relative({F: Format}, a: Finite(F), mode: Mode, nan: F.specials.has_nan().IsTrue(), nn: 0 <= a.val(),
    s: CReal, root: s.IsSqrt(a.val()), normal: (Finite::min_normal(F)).val() * (Finite::min_normal(F)).val() <= a.val(),
    range: a.val() <= (Finite::max_finite(F)).val() * (Finite::max_finite(F)).val(),
    r: Finite(F), is: a.sqrt(mode := mode, nan := nan) = Fin(r)):
    (r.real() - s).abs() <= CReal::ofRat(F.u(mode)) * s
{
    let hr: RoundsToReal(F, mode, s, Fin(r)) = j(is, λ v _ => RoundsToReal(F, mode, s, v), Finite::sqrt_real(a, mode, nan, nn, s, root));
    F.real_relative_nonneg(mode, s, r, root.left((Finite::min_normal(F)).val(), Rat::le_of_lt(Finite::min_normal_pos(F)), normal),
        root.right((Finite::max_finite(F)).val(), Finite::max_finite_nonneg(F), range), hr)
}

// ---------------------------------------------------------------------------
// The error model at a real of either sign. Whether `x >= 0` cannot be
// decided, but each conclusion is a `≤`, a negation at `CReal`, so
// `CReal::le_by_sign` splits on it inside.

// The model with underflow at every real in range, `|r - x| <= u·|x| + η`:
// the conclusion is a `≤`, so the sign of `x` is split inside it.
theorem Format::real_error(self F: Format, mode: Mode, x: CReal, r: Finite(F), range: x.abs() <= CReal::ofRat((Finite::max_finite(F)).val()),
    hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * x.abs() + CReal::ofRat(F.eta(mode))
{
    let M = (Finite::max_finite(F)).val();
    let U = CReal::ofRat(F.u(mode));
    let u_nn: (0 <= U) = CReal::ofRat_le(Rat::le_of_lt(F.u_pos(mode)));
    CReal::le_by_sign(x,
        λ nn => {
            let b = F.real_error_nonneg(mode, x, r, nn, CReal::le_trans(x.le_abs(), range), hr);
            let m: (U * x <= U * x.abs()) = CReal::mul_le_mono_l(x.le_abs(), u_nn);
            linarith(b, m)
        },
        λ np => {
            let low: (CReal::ofRat(-M) <= x) = CReal::le_of_same_l(CReal::ofRat_neg(M), linarith(x.neg_le_abs(), range));
            let b = F.real_error_nonpos(mode, x, r, np, low, hr);
            let m: (U * -x <= U * x.abs()) = CReal::mul_le_mono_l(x.neg_le_abs(), u_nn);
            linarith(b, m)
        })
}

// The standard model at every real in the normal range, `|r - x| <= u·|x|`.
// Being normal is stated as `m <= |x|`; the sign split happens inside the
// `≤`, where `m <= |x|` and `x <= 0` give `x <= -m` (`|x| ≈ -x` there).
theorem Format::real_relative(self F: Format, mode: Mode, x: CReal, r: Finite(F), normal: CReal::ofRat((Finite::min_normal(F)).val()) <= x.abs(),
    range: x.abs() <= CReal::ofRat((Finite::max_finite(F)).val()), hr: RoundsToReal(F, mode, x, Fin(r))):
    (r.real() - x).abs() <= CReal::ofRat(F.u(mode)) * x.abs()
{
    let M = (Finite::max_finite(F)).val();
    let m = (Finite::min_normal(F)).val();
    let U = CReal::ofRat(F.u(mode));
    let u_nn: (0 <= U) = CReal::ofRat_le(Rat::le_of_lt(F.u_pos(mode)));
    CReal::le_by_sign(x,
        λ nn => {
            let b = F.real_relative_nonneg(mode, x, r, CReal::le_trans(normal, CReal::le_of_same(x.abs_of_nonneg(nn))), CReal::le_trans(x.le_abs(), range), hr);
            let m1: (U * x <= U * x.abs()) = CReal::mul_le_mono_l(x.le_abs(), u_nn);
            linarith(b, m1)
        },
        λ np => {
            let low: (CReal::ofRat(-M) <= x) = CReal::le_of_same_l(CReal::ofRat_neg(M), linarith(x.neg_le_abs(), range));
            let high: (x <= CReal::ofRat(-m)) = CReal::le_of_same_r(CReal::ofRat_neg(m), linarith(normal, CReal::le_of_same(x.abs_of_nonpos(np))));
            let b = F.real_relative_nonpos(mode, x, r, high, low, hr);
            let m1: (U * -x <= U * x.abs()) = CReal::mul_le_mono_l(x.neg_le_abs(), u_nn);
            linarith(b, m1)
        })
}

// ---------------------------------------------------------------------------
// The root of a real (creal.hthr, `CReal::sqrt`): at a float's real it is
// `sqrt_rat` of its value, so the float root rounds it too.

// The float root is a correct rounding of the root of the float's real.
theorem Finite::sqrt_rounds_root({F: Format}, a: Finite(F), mode: Mode, nan: F.specials.has_nan().IsTrue(), nn: 0 <= a.val()):
    RoundsToReal(F, mode, a.real().sqrt(), a.sqrt(mode := mode, nan := nan))
{
    F.rounds_real_respects(mode, CReal::same_sym(CReal::sqrt_ofRat(a.val())), a.sqrt(mode := mode, nan := nan), Finite::sqrt_rounds_real(a, mode, nan, nn))
}

// Binary floating-point formats and their values
// (docs/library/floating-point-design.md §3–§4; roadmap submilestone `float-values`).
//
// A `Format` is data: a precision, an exponent range and a policy for the
// special values. Every float type is indexed by one, so `Finite(binary32())`
// and `Finite(e4m3())` are different types that can meet in one scope, and a
// conversion between them is an ordinary function.
//
// Representation. A finite float is a sign, an integer significand `mag` and
// a biased exponent `bexp`; its value is `±mag · 2^q` with the quantum exponent
// (the exponent of the significand's last bit) `q = qmin + bexp`. Storing the
// quantum exponent means no `e - prec + 1` anywhere, and biasing it from the
// format's least exponent makes the canonical-form condition a fact about
// naturals only. The canonical form is the IEEE one: the significand has at
// most `prec` bits, and only the least exponent holds significands below
// `2^(prec - 1)` (the subnormals and zero). It is a `Bool` computed from the
// parts, so a literal float's proof is `trivial`, and two finite floats with
// the same three parts are equal (`Finite::ext`): `IsTrue` proofs are unique.
//
// Precision is given by its fraction bits, `frac = prec - 1`, the trailing
// significand width IEEE calls `t` and the OCP formats call `M`. Then
// `2^prec` is `2^frac · 2` by computation, with no subtraction under a power.
//
// Equality and order (§4). `=` is structural, so `+0` and `-0` differ. `≈`
// is value sameness and `<` the value order, both read through the value as
// a `Dyadic`, so `Finite(F)` is a strict order like `Rat` and the
// `ordered_field` lemmas that need only that apply to it. The IEEE orders on
// `Float(F)` (quiet comparison, totalOrder) are named functions and come with
// the operations.
//
// Special values. `Float(F)` adds infinities and NaN to the finite floats.
// Its constructors carry evidence that the format has them, so a format with
// no infinity has no infinite value: a match dismisses that case by
// evaluation.

import logic;
import bool;
import nat;
import int;
import omega;
import ring;
import option;
import relation_props;
import algebra;
import algebra_rel;
import order;
import ordered_field;
import semiring;
import rat;
import dyadic;

// ---------------------------------------------------------------------------
// Formats.

// Which special values the format has. `Ieee`: infinities and NaN.
// `NanOnly`: NaN and no infinity (OCP E4M3, the P3109 finite formats).
// `FiniteOnly`: neither (OCP FP6 and FP4). Where the specials' codes sit, and
// so how much of the top binade they take, is the format's `cut`, not this.
inductive Specials { Ieee, NanOnly, FiniteOnly }

fn Specials::has_inf(self s: Specials) → Bool { match s { Ieee => True, NanOnly => False, FiniteOnly => False } }

fn Specials::has_nan(self s: Specials) → Bool { match s { Ieee => True, NanOnly => True, FiniteOnly => False } }

// A format with infinities has NaN too: an invalid operation on infinities
// has a value.
theorem Specials::nan_of_inf(self s: Specials, has: s.has_inf().IsTrue()): s.has_nan().IsTrue() {
    match s as λ t => t.has_inf().IsTrue() → t.has_nan().IsTrue() { Ieee => λ _ => trivial, NanOnly => λ _ => trivial, FiniteOnly => λ no => false_elim(no) }(has)
}

// `frac` fraction bits (precision `frac + 1`; `frac = 0` is P3109's
// precision one, where every nonzero value is a power of two); `emin` the
// least normal exponent, IEEE's emin; `span` the number of binades above it
// that hold finite values, so IEEE's emax is `emin + span`; `cut` the number
// of largest significands the top binade gives up to special values (E4M3's
// NaN, a P3109 format's infinity and NaN), at most all but its least normal
// one (docs/library/float-p3109-design.md D3).
record Format {
    frac: Nat,
    emin: Int,
    span: Nat,
    cut: Nat,
    cut_ok: cut + 1 <= Nat::pow(2, frac),
    specials: Specials,
}

fn Format::prec(self F: Format) → Nat { F.frac + 1 }

fn Format::emax(self F: Format) → Int { F.emin + F.span.int() }

// The quantum exponent of the least binade: subnormals are multiples of
// `2^qmin`.
fn Format::qmin(self F: Format) → Int { F.emin - F.frac.int() }

fn Format::qmax(self F: Format) → Int { F.qmin() + F.span.int() }

// `2^(prec - 1)`, the least normal significand, and `2^prec`, one past the
// largest.
fn Format::half(self F: Format) → Nat { Nat::pow(2, F.frac) }

fn Format::top(self F: Format) → Nat { Nat::pow(2, F.prec()) }

theorem Format::top_double(self F: Format): F.top() = F.half() * 2 { refl }

// Both are positive, as evidence, so `Rat(1, F.top())` finds its
// denominator's proof.
evidence theorem Format::half_pos({F: Format}): 0 < F.half() { Nat::pow_pos(a := 2, n := F.frac) }

evidence theorem Format::top_pos({F: Format}): 0 < F.top() { Nat::pow_pos(a := 2, n := F.prec()) }

// IEEE 754 interchange formats and bfloat16.
fn binary16() → Format { Format(10, -14, 29, 0, trivial, Ieee) }
fn binary32() → Format { Format(23, -126, 253, 0, trivial, Ieee) }
fn binary64() → Format { Format(52, -1022, 2045, 0, trivial, Ieee) }
fn bfloat16() → Format { Format(7, -126, 253, 0, trivial, Ieee) }

// OCP microscaling element formats (OCP MX v1.0). E8M0 is a scale with no
// significand and no zero, so it is not a `Format`.
fn e5m2() → Format { Format(2, -14, 29, 0, trivial, Ieee) }
fn e4m3() → Format { Format(3, -6, 14, 1, trivial, NanOnly) }
fn e3m2() → Format { Format(2, -2, 6, 0, trivial, FiniteOnly) }
fn e2m3() → Format { Format(3, 0, 2, 0, trivial, FiniteOnly) }
fn e2m1() → Format { Format(1, 0, 2, 0, trivial, FiniteOnly) }

// ---------------------------------------------------------------------------
// Canonical form.

// The significand fits in `prec` bits, the exponent is in range, only the
// least exponent holds significands below `2^(prec - 1)`, and the top binade
// stops `cut` significands short of the top.
// Stated as the proposition and computed as its decision, whose bit is the
// comparisons themselves (`leb`, `same`, `&&`, `||`, `!`;
// issues/decide-bit-is-the-comparison.md), so the proof field of a `Finite`
// is proof-irrelevant, a closed format decides it by `refl`, and the four
// conditions go in and out by `decide_intro` / `decide_elim`.
fn Format::canonical(self F: Format, mag, bexp: Nat) → Bool {
    decide_bit<mag + 1 <= F.top() ∧ bexp <= F.span ∧ (bexp = 0 ∨ F.half() <= mag)
        ∧ (F.span <= bexp → mag + F.cut + 1 <= F.top())>()
}

record Finite(F: Format) { neg: Bool, mag: Nat, bexp: Nat, ok: F.canonical(mag, bexp).IsTrue() }

// A finite float is its three parts: the canonical-form proof is unique.
theorem Finite::eta_parts({F: Format}, x: Finite(F), n: Bool, m, b: Nat, w: F.canonical(m, b).IsTrue(),
    hn: x.neg = n, hm: x.mag = m, hb: x.bexp = b): x = Finite(n, m, b, w)
{
    j(hn, λ n1 _ => (v: F.canonical(m, b).IsTrue()) → x = Finite(n1, m, b, v),
        j(hm, λ m1 _ => (v: F.canonical(m1, b).IsTrue()) → x = Finite(x.neg, m1, b, v),
            j(hb, λ b1 _ => (v: F.canonical(x.mag, b1).IsTrue()) → x = Finite(x.neg, x.mag, b1, v),
                λ (v: F.canonical(x.mag, x.bexp).IsTrue()) =>
                    j(F.canonical(x.mag, x.bexp).is_true_unique(x.ok, v),
                        λ z _ => x = Finite(x.neg, x.mag, x.bexp, z), refl))))(w)
}

theorem Finite::ext({F: Format}, x, y: Finite(F), neg: x.neg = y.neg, mag: x.mag = y.mag, bexp: x.bexp = y.bexp): x = y {
    Finite::eta_parts(x, y.neg, y.mag, y.bexp, y.ok, neg, mag, bexp)
}

// ---------------------------------------------------------------------------
// Values.

fn Finite::q({F: Format}, self x: Finite(F)) → Int { F.qmin() + x.bexp.int() }

fn Finite::signed({F: Format}, self x: Finite(F)) → Int { match x.neg { False => x.mag.int(), True => -x.mag.int() } }

// The exact value, `±mag · 2^q`.
fn Finite::dyadic({F: Format}, self x: Finite(F)) → Dyadic { Dyadic(x.signed(), x.q()) }

fn Finite::val({F: Format}, self x: Finite(F)) → Rat { x.dyadic().rat() }

fn Finite::Same({F: Format}, x, y: Finite(F)) → Type { x.dyadic() ≈ y.dyadic() }

fn Finite::Lt({F: Format}, x, y: Finite(F)) → Type { x.dyadic() < y.dyadic() }

fn Finite::Le({F: Format}, x, y: Finite(F)) → Type { x.dyadic() <= y.dyadic() }

designation ≈ at Finite(F) := Finite::Same
designation < at Finite(F) := Finite::Lt
designation <= at Finite(F) := Finite::Le

theorem Finite::same_refl({F: Format}, self x: Finite(F)): x ≈ x { x.dyadic().same_refl() }

theorem Finite::same_sym({F: Format}, {x, y: Finite(F)}, h: x ≈ y): y ≈ x { Dyadic::same_sym(a := x.dyadic(), b := y.dyadic(), h := h) }

theorem Finite::same_trans({F: Format}, {x, y, z: Finite(F)}, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    Dyadic::same_trans(a := x.dyadic(), b := y.dyadic(), c := z.dyadic(), hab := hxy, hbc := hyz)
}

instance(F: Format) Equivalence<Finite(F)>(Finite::Same) {
    rel_refl := Finite::same_refl,
    rel_sym := λ x y h => Finite::same_sym(h),
    rel_trans := λ x y z hxy hyz => Finite::same_trans(hxy, hyz),
}

theorem Finite::lt_irrefl({F: Format}, self x: Finite(F)): ¬(x < x) { x.dyadic().lt_irrefl() }

theorem Finite::lt_trans({F: Format}, {x, y, z: Finite(F)}, h1: x < y, h2: y < z): x < z {
    Dyadic::lt_trans(a := x.dyadic(), b := y.dyadic(), c := z.dyadic(), h1 := h1, h2 := h2)
}

theorem Finite::lt_respects({F: Format}, {x, x2, y, y2: Finite(F)}, hx: x ≈ x2, hy: y ≈ y2, h: x < y): x2 < y2 {
    Dyadic::lt_respects(a := x.dyadic(), a2 := x2.dyadic(), b := y.dyadic(), b2 := y2.dyadic(), ha := hx, hb := hy, h := h)
}

theorem Finite::same_of_not_lt({F: Format}, {x, y: Finite(F)}, h1: ¬(x < y), h2: ¬(y < x)): x ≈ y {
    Dyadic::same_of_not_lt(a := x.dyadic(), b := y.dyadic(), h1 := h1, h2 := h2)
}

theorem Finite::le_of_not_lt({F: Format}, {x, y: Finite(F)}, h: ¬(y < x)): x <= y {
    Dyadic::le_of_not_lt(a := x.dyadic(), b := y.dyadic(), h := h)
}

theorem Finite::not_lt_of_le({F: Format}, {x, y: Finite(F)}, h: x <= y): ¬(y < x) {
    Dyadic::not_lt_of_le(a := x.dyadic(), b := y.dyadic(), h := h)
}

theorem Finite::lt_cotrans({F: Format}, self x, y, z: Finite(F), h: x < y): x < z ∨ z < y {
    x.dyadic().lt_cotrans(y.dyadic(), z.dyadic(), h)
}

fn Finite::le_dec({F: Format}, self x, y: Finite(F)) → x <= y ∨ ¬(x <= y) { x.dyadic().le_dec(y.dyadic()) }

// The relation kit `calc` and `relation_step` resolve against.

theorem Finite::le_refl({F: Format}, self x: Finite(F)): x <= x { x.dyadic().le_refl() }

theorem Finite::le_of_same({F: Format}, {x, y: Finite(F)}, h: x ≈ y): x <= y { Dyadic::le_of_same(a := x.dyadic(), b := y.dyadic(), h := h) }

theorem Finite::le_of_lt({F: Format}, {x, y: Finite(F)}, h: x < y): x <= y { Dyadic::le_of_lt(a := x.dyadic(), b := y.dyadic(), h := h) }

theorem Finite::le_trans({F: Format}, {x, y, z: Finite(F)}, h1: x <= y, h2: y <= z): x <= z {
    Dyadic::le_trans(a := x.dyadic(), b := y.dyadic(), c := z.dyadic(), h1 := h1, h2 := h2)
}

theorem Finite::le_total({F: Format}, self x, y: Finite(F)): x <= y ∨ y <= x { x.dyadic().le_total(y.dyadic()) }

theorem Finite::lt_of_lt_of_le({F: Format}, {x, y, z: Finite(F)}, h1: x < y, h2: y <= z): x < z {
    Dyadic::lt_of_lt_of_le(a := x.dyadic(), b := y.dyadic(), c := z.dyadic(), h1 := h1, h2 := h2)
}

theorem Finite::lt_of_le_of_lt({F: Format}, {x, y, z: Finite(F)}, h1: x <= y, h2: y < z): x < z {
    Dyadic::lt_of_le_of_lt(a := x.dyadic(), b := y.dyadic(), c := z.dyadic(), h1 := h1, h2 := h2)
}

instance(F: Format) Preorder<Finite(F)>(Finite::Le) {
    rel_refl := Finite::le_refl,
    rel_trans := λ x y z h1 h2 => Finite::le_trans(h1, h2),
}

instance(F: Format) Total<Finite(F)>(Finite::Le) { rel_total := Finite::le_total }

instance(F: Format) Irreflexive<Finite(F)>(Finite::Lt) { rel_irrefl := Finite::lt_irrefl }

instance(F: Format) Transitive<Finite(F)>(Finite::Lt) { rel_trans := λ x y z h1 h2 => Finite::lt_trans(h1, h2) }

instance(F: Format) Trans<Finite(F)>(Finite::Le, Finite::Lt, Finite::Lt) { rel_chain := λ x y z h1 h2 => Finite::lt_of_le_of_lt(h1, h2) }
instance(F: Format) Trans<Finite(F)>(Finite::Lt, Finite::Le, Finite::Lt) { rel_chain := λ x y z h1 h2 => Finite::lt_of_lt_of_le(h1, h2) }
instance(F: Format) Trans<Finite(F)>(Finite::Same, Finite::Le, Finite::Le) { rel_chain := λ x y z h1 h2 => Finite::le_trans(Finite::le_of_same(h1), h2) }
instance(F: Format) Trans<Finite(F)>(Finite::Le, Finite::Same, Finite::Le) { rel_chain := λ x y z h1 h2 => Finite::le_trans(h1, Finite::le_of_same(h2)) }
instance(F: Format) Trans<Finite(F)>(Finite::Same, Finite::Lt, Finite::Lt) { rel_chain := λ x y z h1 h2 => Finite::lt_of_le_of_lt(Finite::le_of_same(h1), h2) }
instance(F: Format) Trans<Finite(F)>(Finite::Lt, Finite::Same, Finite::Lt) { rel_chain := λ x y z h1 h2 => Finite::lt_of_lt_of_le(h1, Finite::le_of_same(h2)) }

instance(F: Format) StrictOrder<Finite(F)>(Finite::Same, Finite::Lt, Finite::Le) {
    rel_refl := Finite::same_refl,
    rel_sym := λ x y h => Finite::same_sym(h),
    rel_trans := λ x y z hxy hyz => Finite::same_trans(hxy, hyz),
    lt_irrefl := Finite::lt_irrefl,
    lt_trans := λ x y z h1 h2 => Finite::lt_trans(h1, h2),
    lt_respects := λ x x2 y y2 hx hy h => Finite::lt_respects(hx, hy, h),
    lt_tight := λ x y h1 h2 => Finite::same_of_not_lt(h1, h2),
    le_of_not_lt := λ x y h => Finite::le_of_not_lt(h),
    not_lt_of_le := λ x y h => Finite::not_lt_of_le(h),
    lt_transitive := Transitive(λ x y z h1 h2 => Finite::lt_trans(h1, h2)),
    same_lt := Trans(λ x y z h1 h2 => Finite::lt_of_le_of_lt(Finite::le_of_same(h1), h2)),
    lt_same := Trans(λ x y z h1 h2 => Finite::lt_of_lt_of_le(h1, Finite::le_of_same(h2))),
    same_le := Trans(λ x y z h1 h2 => Finite::le_trans(Finite::le_of_same(h1), h2)),
    le_same := Trans(λ x y z h1 h2 => Finite::le_trans(h1, Finite::le_of_same(h2))),
}

instance(F: Format) Cotransitive<Finite(F)>(Finite::Lt) {
    rel_cotrans := Finite::lt_cotrans,
}

instance(F: Format) PseudoOrder<Finite(F)>(Finite::Same, Finite::Lt, Finite::Le) {
    rel_refl := Finite::same_refl,
    rel_sym := λ x y h => Finite::same_sym(h),
    rel_trans := λ x y z hxy hyz => Finite::same_trans(hxy, hyz),
    lt_irrefl := Finite::lt_irrefl,
    lt_trans := λ x y z h1 h2 => Finite::lt_trans(h1, h2),
    lt_respects := λ x x2 y y2 hx hy h => Finite::lt_respects(hx, hy, h),
    lt_tight := λ x y h1 h2 => Finite::same_of_not_lt(h1, h2),
    le_of_not_lt := λ x y h => Finite::le_of_not_lt(h),
    not_lt_of_le := λ x y h => Finite::not_lt_of_le(h),
    rel_cotrans := Finite::lt_cotrans,
    lt_transitive := Transitive(λ x y z h1 h2 => Finite::lt_trans(h1, h2)),
    same_lt := Trans(λ x y z h1 h2 => Finite::lt_of_le_of_lt(Finite::le_of_same(h1), h2)),
    lt_same := Trans(λ x y z h1 h2 => Finite::lt_of_lt_of_le(h1, Finite::le_of_same(h2))),
    same_le := Trans(λ x y z h1 h2 => Finite::le_trans(Finite::le_of_same(h1), h2)),
    le_same := Trans(λ x y z h1 h2 => Finite::le_trans(h1, Finite::le_of_same(h2))),
    le_preorder := Preorder(Finite::le_refl, λ x y z h1 h2 => Finite::le_trans(h1, h2)),
    lt_le := Trans(λ x y z h1 h2 => Finite::lt_of_lt_of_le(h1, h2)),
    le_lt := Trans(λ x y z h1 h2 => Finite::lt_of_le_of_lt(h1, h2)),
}

// Negation flips the sign bit and nothing else.
fn Finite::neg({F: Format}, self x: Finite(F)) → Finite(F) { Finite(!x.neg, x.mag, x.bexp, x.ok) }

designation prefix - at Finite(F) := Finite::neg

theorem Finite::neg_neg({F: Format}, self x: Finite(F)): -(-x) = x {
    Finite::ext(-(-x), x, match x.neg as λ s => !(!s) = s { False => refl, True => refl }, refl, refl)
}

theorem Finite::dyadic_neg({F: Format}, self x: Finite(F)): (-x).dyadic() ≈ -x.dyadic() {
    match x.neg {
        False => Dyadic(-x.mag.int(), x.q()).same_refl(),
        True => j(sym(x.mag.int().neg_neg()), λ m _ => Dyadic(x.mag.int(), x.q()) ≈ Dyadic(m, x.q()), Dyadic(x.mag.int(), x.q()).same_refl()),
    }
}

// ---------------------------------------------------------------------------
// Floats: the finite values with the infinities and NaN the format keeps.

inductive Float(F: Format) {
    Fin(x: Finite(F)),
    Inf(neg: Bool, has: F.specials.has_inf().IsTrue()),
    NaN(has: F.specials.has_nan().IsTrue()),
}

fn Float::is_finite({F: Format}, self x: Float(F)) → Bool { match x { Fin(_) => True, Inf(_, _) => False, NaN(_) => False } }

fn Float::is_nan({F: Format}, self x: Float(F)) → Bool { match x { Fin(_) => False, Inf(_, _) => False, NaN(_) => True } }

fn Float::is_inf({F: Format}, self x: Float(F)) → Bool { match x { Fin(_) => False, Inf(_, _) => True, NaN(_) => False } }

fn Float::finite({F: Format}, self x: Float(F)) → Option<Finite(F)> { match x { Fin(f) => Some(f), Inf(_, _) => None, NaN(_) => None } }

// Negation flips the sign of a finite or infinite float; NaN has none.
fn Float::neg({F: Format}, self x: Float(F)) → Float(F) { match x { Fin(f) => Fin(-f), Inf(n, has) => Inf(!n, has), NaN(has) => NaN(has) } }

designation prefix - at Float(F) := Float::neg

// A format without infinities has no infinite float, and one without NaN has
// no NaN: both by evaluation of the format's policy.
theorem Float::not_inf({F: Format}, self x: Float(F), none: F.specials.has_inf() = False): x.is_inf() = False {
    match x {
        Fin(_) => refl,
        Inf(_, has) => false_elim(j(none, λ b _ => b.IsTrue(), has)),
        NaN(_) => refl,
    }
}

theorem Float::not_nan({F: Format}, self x: Float(F), none: F.specials.has_nan() = False): x.is_nan() = False {
    match x {
        Fin(_) => refl,
        Inf(_, _) => refl,
        NaN(has) => false_elim(j(none, λ b _ => b.IsTrue(), has)),
    }
}

// ---------------------------------------------------------------------------
// Building canonical floats.

// `half` is at least one (two once there is a fraction bit), `top` twice it,
// and the reserved significands leave the top binade its least normal one.
theorem Format::one_le_half(self F: Format): 1 <= F.half() { Nat::pow_pos(a := 2, n := F.frac) }

theorem Format::two_le_top(self F: Format): 2 <= F.top() {
    let h = F.one_le_half();
    let t: (F.top() = F.half() * 2) = F.top_double();
    omega
}

theorem Format::cut_room(self F: Format): F.cut + 1 <= F.half() { F.cut_ok }

// With a fraction bit, `half` is even and at least two.
theorem Format::two_le_half(self F: Format, fr: 1 <= F.frac): 2 <= F.half() { Nat::le_pow_self(2, F.frac, trivial, fr) }

// The canonical form from its four conditions.
theorem Format::canonical_intro(self F: Format, mag, bexp: Nat,
    fits: mag + 1 <= F.top(),
    range: bexp <= F.span,
    normal: bexp = 0 ∨ F.half() <= mag,
    free: F.span <= bexp → mag + F.cut + 1 <= F.top()):
    F.canonical(mag, bexp).IsTrue()
{
    decide_intro(And(fits, And(range, And(normal, free))))
}

// The four conditions back out of the canonical form.
theorem Format::canonical_elim(self F: Format, mag, bexp: Nat, ok: F.canonical(mag, bexp).IsTrue()):
    mag + 1 <= F.top() ∧ bexp <= F.span ∧ (bexp = 0 ∨ F.half() <= mag)
        ∧ (F.span <= bexp → mag + F.cut + 1 <= F.top())
{
    decide_elim(ok)
}

// Any significand up to `half` fits at the least exponent, whatever the cut.
theorem Format::canonical_low(self F: Format, mag: Nat, le: mag <= F.half()): F.canonical(mag, 0).IsTrue() {
    let c = F.cut_room();
    let t: (F.top() = F.half() * 2) = F.top_double();
    let h = F.one_le_half();
    F.canonical_intro(mag, 0, omega, trivial, Inl(refl), λ _ => omega)
}

// Zero of either sign.
fn Finite::zero(F: Format, neg: Bool) → Finite(F) { Finite(neg, 0, 0, F.canonical_low(0, trivial)) }

// The two zeros are value-same (`zero_dyadic`) but not equal: they differ in
// the sign bit.
theorem Finite::zeros_differ(F: Format): ¬(Finite::zero(F, False) = Finite::zero(F, True)) {
    λ h => j(h, λ z _ => ¬(z.neg.IsTrue()), λ no => no)(trivial)
}

// The least positive value, `2^qmin`: a subnormal, or at precision one the
// least normal.
fn Finite::min_subnormal(F: Format) → Finite(F) { Finite(False, 1, 0, F.canonical_low(1, F.one_le_half())) }

// The least positive normal, `2^emin`.
fn Finite::min_normal(F: Format) → Finite(F) { Finite(False, F.half(), 0, F.canonical_low(F.half(), F.half().le_refl())) }

// The largest significand the top binade holds: all ones, less the reserved
// ones.
fn Format::max_mag(self F: Format) → Nat { F.top() - 1 - F.cut }

// Where the largest significand sits: at or above the least normal one, and
// `cut` below the last.
theorem Format::max_mag_bounds(self F: Format):
    F.half() <= F.max_mag() ∧ F.max_mag() + 1 <= F.top() ∧ F.max_mag() + F.cut + 1 = F.top()
{
    let c = F.cut_room();
    let t: (F.top() = F.half() * 2) = F.top_double();
    let m: (F.max_mag() = F.top() - 1 - F.cut) = refl;
    And(omega, And(omega, omega))
}

// The largest finite value, `max_mag · 2^qmax`.
fn Finite::max_finite(F: Format) → Finite(F) {
    let mb = F.max_mag_bounds();
    let ok = F.canonical_intro(F.max_mag(), F.span, mb.right.left, F.span.le_refl(), Inr(mb.left), λ _ => { let e = mb.right.right; omega });
    Finite(False, F.max_mag(), F.span, ok)
}

// The last bit of a float's code: the significand's when there are fraction
// bits, and when there are none (precision one) the biased exponent's, since
// `1 · 2^(qmin + b)` is code `b + 1` and zero is code 0
// (docs/library/float-p3109-design.md D4).
fn Format::lsb_at(frac, mag, bexp: Nat) → Nat { match frac { Zero => mag * Succ(bexp), Succ(_) => mag } }

fn Format::lsb(self F: Format, mag, bexp: Nat) → Nat { Format::lsb_at(F.frac, mag, bexp) }

// The two readings of `lsb`, with what each needs about `half`.
theorem Format::lsb_cases(self F: Format, m, e: Nat):
    (F.frac = 0 ∧ F.half() = 1 ∧ F.lsb(m, e) = m * Succ(e)) ∨ (1 <= F.frac ∧ F.lsb(m, e) = m)
{
    match F.frac as λ f => (f = 0 ∧ Nat::pow(2, f) = 1 ∧ Format::lsb_at(f, m, e) = m * Succ(e)) ∨ (1 <= f ∧ Format::lsb_at(f, m, e) = m) {
        Zero => Inl(And(refl, And(refl, refl))),
        Succ(k) => Inr(And(trivial, refl)),
    }
}

// Codes one apart have opposite parities.
theorem Format::parity_step(a, b: Nat, st: b = a + 1): (¬Nat::Even(a) → Nat::Even(b)) ∧ (Nat::Even(a) → ¬Nat::Even(b)) {
    And(λ odd => j(sym(st), λ v _ => Nat::Even(v), a.even_succ_of_not_even(odd)),
        λ ev eb => a.not_even_succ_of_even(ev)(j(st, λ v _ => Nat::Even(v), eb)))
}

// One significand step inside a binade moves the code by one.
theorem Format::lsb_step(self F: Format, m, e: Nat, room: m + 2 <= F.top(), normal: e = 0 ∨ F.half() <= m): F.lsb(m + 1, e) = F.lsb(m, e) + 1 {
    let t: (F.top() = F.half() * 2) = F.top_double();
    match F.lsb_cases(m + 1, e) {
        Inl(a) => match F.lsb_cases(m, e) {
            Inl(b) => {
                let hz: (F.half() = 1) = a.right.left;
                let ez: (e = 0) = match normal { Inl(z) => z, Inr(le) => false_elim(omega) };
                let pe: ((m + 1) * Succ(e) = Succ(e) + m * Succ(e)) = m.mul_succ_left(Succ(e));
                let la: (F.lsb(m + 1, e) = (m + 1) * Succ(e)) = a.right.right;
                let lb: (F.lsb(m, e) = m * Succ(e)) = b.right.right;
                omega
            },
            Inr(b) => { let z: (F.frac = 0) = a.left; let o: (1 <= F.frac) = b.left; false_elim(omega) },
        },
        Inr(a) => match F.lsb_cases(m, e) {
            Inl(b) => { let z: (F.frac = 0) = b.left; let o: (1 <= F.frac) = a.left; false_elim(omega) },
            Inr(b) => { let la: (F.lsb(m + 1, e) = m + 1) = a.right; let lb: (F.lsb(m, e) = m) = b.right; omega },
        },
    }
}

// The carry from the top significand of a binade to the least of the next
// flips the code's parity: with fraction bits the top is odd and the least
// even (`half`), and at precision one the two codes are consecutive.
theorem Format::lsb_carry(self F: Format, m, e: Nat, mt: m + 1 = F.top()):
    (¬Nat::Even(F.lsb(m, e)) → Nat::Even(F.lsb(F.half(), e + 1))) ∧ (Nat::Even(F.lsb(m, e)) → ¬Nat::Even(F.lsb(F.half(), e + 1)))
{
    let t: (F.top() = F.half() * 2) = F.top_double();
    match F.lsb_cases(F.half(), e + 1) {
        Inl(a) => {
            let hz: (F.half() = 1) = a.right.left;
            let b = match F.lsb_cases(m, e) { Inl(b) => b, Inr(b) => { let z: (F.frac = 0) = a.left; let o: (1 <= F.frac) = b.left; false_elim(omega) } };
            let m1: (m = 1) = omega;
            let la: (F.lsb(F.half(), e + 1) = 1 * Succ(e + 1)) = j(hz, λ v _ => F.lsb(F.half(), e + 1) = v * Succ(e + 1), a.right.right);
            let lb: (F.lsb(m, e) = 1 * Succ(e)) = j(m1, λ v _ => F.lsb(m, e) = v * Succ(e), b.right.right);
            Format::parity_step(F.lsb(m, e), F.lsb(F.half(), e + 1), omega)
        },
        Inr(a) => {
            let b = match F.lsb_cases(m, e) { Inr(b) => b, Inl(b) => { let z: (F.frac = 0) = b.left; let o: (1 <= F.frac) = a.left; false_elim(omega) } };
            let ev: Nat::Even(F.half()) = match F.frac as λ f => 1 <= f → Nat::Even(Nat::pow(2, f)) { Zero => λ bad => false_elim(bad), Succ(k) => λ _ => k.even_pow_two() }(a.left);
            let et: Nat::Even(F.half() + F.half()) = F.half().even_double();
            let mm: (F.half() + F.half() = m + 1) = omega;
            let odd: ¬Nat::Even(m) = λ em => m.not_even_succ_of_even(em)(j(mm, λ v _ => Nat::Even(v), et));
            let lb: (F.lsb(m, e) = m) = b.right;
            let la: (F.lsb(F.half(), e + 1) = F.half()) = a.right;
            And(λ _ => j(sym(la), λ v _ => Nat::Even(v), ev), λ el => false_elim(odd(j(lb, λ v _ => Nat::Even(v), el))))
        },
    }
}

// A float whose code is even: the one ties to even pick.
fn Finite::Even({F: Format}, self f: Finite(F)) → Type { Nat::Even(F.lsb(f.mag, f.bexp)) }

// Moving a float up `j` binades keeps its code's parity when there are
// fraction bits, or when `j` is even.
theorem Format::lsb_shift(self F: Format, m, b, j: Nat, par: 1 <= F.frac ∨ Nat::Even(j)):
    (Nat::Even(F.lsb(m, b)) → Nat::Even(F.lsb(m, b + j))) ∧ (¬Nat::Even(F.lsb(m, b)) → ¬Nat::Even(F.lsb(m, b + j)))
{
    match F.lsb_cases(m, b + j) {
        Inl(a) => {
            let c = match F.lsb_cases(m, b) { Inl(c) => c, Inr(c) => { let z: (F.frac = 0) = a.left; let o: (1 <= F.frac) = c.left; false_elim(omega) } };
            let ej: Nat::Even(j) = match par { Inr(e) => e, Inl(o) => { let z: (F.frac = 0) = a.left; false_elim(omega) } };
            let h = j.half();
            let hj: (h + h = j) = j.half_add_half(ej);
            let e1: (m * (h + h) = m * h + m * h) = ring;
            let mj: (m * j = m * h + m * h) = j(hj, λ v _ => m * v = m * h + m * h, e1);
            let even_mj: Nat::Even(m * j) = j(sym(mj), λ v _ => Nat::Even(v), (m * h).even_double());
            let sp: (m * Succ(b + j) = m * Succ(b) + m * j) = ring;
            let la: (F.lsb(m, b + j) = m * Succ(b) + m * j) = trans(a.right.right, sp);
            let lb: (F.lsb(m, b) = m * Succ(b)) = c.right.right;
            let p = (m * j).even_add_even(m * Succ(b))(even_mj);
            And(λ ev => j(sym(la), λ v _ => Nat::Even(v), p.left(j(lb, λ v _ => Nat::Even(v), ev))),
                λ od ev2 => p.right(λ e0 => od(j(sym(lb), λ v _ => Nat::Even(v), e0)))(j(la, λ v _ => Nat::Even(v), ev2)))
        },
        Inr(a) => {
            let c = match F.lsb_cases(m, b) { Inr(c) => c, Inl(c) => { let z: (F.frac = 0) = c.left; let o: (1 <= F.frac) = a.left; false_elim(omega) } };
            let e: (F.lsb(m, b) = F.lsb(m, b + j)) = trans(c.right, sym(a.right));
            And(λ ev => j(e, λ v _ => Nat::Even(v), ev), λ od ev2 => od(j(sym(e), λ v _ => Nat::Even(v), ev2)))
        },
    }
}

// Whether a window `j` binades up keeps code parity, decided.
fn Format::win_par(self F: Format, j: Nat) → (1 <= F.frac ∨ Nat::Even(j)) ∨ ¬(1 <= F.frac ∨ Nat::Even(j)) {
    match (1).le_dec(F.frac) {
        Inl(o) => Inl(Inl(o)),
        Inr(no) => match j.even_dec() {
            Inl(e) => Inl(Inr(e)),
            Inr(ne) => Inr(λ p => match p { Inl(o) => no(o), Inr(e) => ne(e) }),
        },
    }
}

// The largest finite float's code is even: then a nearest-even tie at the
// overflow threshold stays finite (D5).
fn Format::MaxEven(self F: Format) → Type { Nat::Even(F.lsb(F.max_mag(), F.span)) }

// One unit in the last place: the spacing of the floats at `x`'s exponent.
fn Finite::ulp({F: Format}, self x: Finite(F)) → Dyadic { Dyadic(1, x.q()) }

theorem Finite::zero_dyadic(F: Format, neg: Bool): (Finite::zero(F, neg)).dyadic() ≈ 0 {
    match neg {
        False => Dyadic::zero_mant(F.qmin() + OfNat(0)),
        True => Dyadic::zero_mant(F.qmin() + OfNat(0)),
    }
}

// The least normal is `2^emin`, read at the least exponent.
theorem Finite::min_normal_dyadic(F: Format): (Finite::min_normal(F)).dyadic() ≈ Dyadic(1, F.emin) {
    let shift = Dyadic::align(1, F.qmin() + OfNat(0), F.frac);
    let qd: (F.qmin() = F.emin - F.frac.int()) = refl;
    let exp: (F.qmin() + OfNat(0) + F.frac.int() = F.emin) = omega;
    let one: (OfNat(1) * F.half().int() = F.half().int()) = OfNat(F.half()).one_mul();
    Dyadic::same_trans(
        j(one, λ m _ => Dyadic(m, F.qmin() + OfNat(0)) ≈ Dyadic(1, F.qmin() + OfNat(0) + F.frac.int()), shift),
        j(exp, λ e _ => Dyadic(1, F.qmin() + OfNat(0) + F.frac.int()) ≈ Dyadic(1, e), Dyadic(1, F.qmin() + OfNat(0) + F.frac.int()).same_refl()))
}

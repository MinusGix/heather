// Dyadic rationals: an integer times a power of two
// (docs/floating-point-design.md §3.1; roadmap submilestone `float-values`).
//
// A `Dyadic` is `mant · 2^exp` with both parts integers. It is the carrier of
// every exact value the floating-point library rounds: a finite float's value,
// and the exact sum, difference and product of two of them. The operations
// are exact and computable, and there is no division.
//
// The carrier is unnormalised. `Dyadic(6, 0)` and `Dyadic(3, 1)` are the same
// number and different values, so equality is a setoid, `Dyadic::Same`,
// written `≈`, as at `Rat` and `CReal`. Normalising (odd mantissa) would make
// `=` value equality but cost a normalisation and its proof in every
// operation; finite floats are canonical by their format anyway.
//
// Every relation is read through the embedding into `Rat`, `Dyadic::rat`:
// `a ≈ b`, `a < b` and `a <= b` are the rationals' relations on the images.
// The embedding splits the exponent into its positive and negative halves
// (`Int::pos_part`, `Int::neg_part`), so it needs no case on the exponent's
// sign and no `Rat::pow`, and it evaluates. Each operation has a homomorphism
// lemma (`rat_add`, `rat_mul`, `rat_neg`), and each law is the rationals'
// law carried back through them. `rat_split` is the one fact about the
// embedding that the rest uses: any split of the exponent into a difference
// of naturals gives the same rational.
//
// Calling convention: as at `Rat`, a lemma whose every `Dyadic` is named by
// one of its hypotheses takes them implicitly; any other takes the first as
// `self`.

import logic;
import bool;
import nat;
import int;
import omega;
import ring;
import relation_props;
import algebra;
import algebra_rel;
import order;
import ordered_field;
import semiring;
import rat;
export algebra::{Numeral};

record Dyadic { mant: Int, exp: Int }

fn Dyadic::rat(self d: Dyadic) → Rat {
    Rat(d.mant * Nat::pow(2, d.exp.pos_part()).int(), Nat::pow(2, d.exp.neg_part()))
}

fn Dyadic::Same(a, b: Dyadic) → Type { a.rat() ≈ b.rat() }

designation ≈ at Dyadic := Dyadic::Same

fn Dyadic::Lt(a, b: Dyadic) → Type { a.rat() < b.rat() }

designation < at Dyadic := Dyadic::Lt

fn Dyadic::Le(a, b: Dyadic) → Type { a.rat() <= b.rat() }

designation <= at Dyadic := Dyadic::Le

theorem Dyadic::same_refl(self a: Dyadic): a ≈ a { a.rat().same_refl() }

theorem Dyadic::same_sym({a, b: Dyadic}, h: a ≈ b): b ≈ a { Rat::same_sym(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::same_trans({a, b, c: Dyadic}, hab: a ≈ b, hbc: b ≈ c): a ≈ c { Rat::same_trans(x := a.rat(), y := b.rat(), z := c.rat(), hxy := hab, hyz := hbc) }

instance Equivalence<Dyadic>(Dyadic::Same) {
    rel_refl := Dyadic::same_refl,
    rel_sym := λ a b h => Dyadic::same_sym(h),
    rel_trans := λ a b c hab hbc => Dyadic::same_trans(hab, hbc),
}

// Any split of the exponent into a difference of naturals gives the same
// rational: `m · 2^e` is `m · 2^p / 2^q` whenever `e = p - q`.
theorem Dyadic::rat_split(m, e: Int, p, q: Nat, h: e = p.int() - q.int()):
    Dyadic(m, e).rat() ≈ Rat(m * Nat::pow(2, p).int(), Nat::pow(2, q))
{
    let parts = e.pos_sub_neg();
    let same: (e.pos_part() + q = p + e.neg_part()) = omega;
    calc {
        (m * Nat::pow(2, e.pos_part()).int()) * Nat::pow(2, q).int()
            = m * (Nat::pow(2, e.pos_part()).int() * Nat::pow(2, q).int()) := m.mul_assoc(Nat::pow(2, e.pos_part()).int(), Nat::pow(2, q).int()),
            = m * Nat::pow(2, e.pos_part() + q).int() := cong(sym(Nat::int_pow_add(2, e.pos_part(), q))),
            = m * Nat::pow(2, p + e.neg_part()).int() := cong(same),
            = m * (Nat::pow(2, p).int() * Nat::pow(2, e.neg_part()).int()) := cong(Nat::int_pow_add(2, p, e.neg_part())),
            = (m * Nat::pow(2, p).int()) * Nat::pow(2, e.neg_part()).int() := sym(m.mul_assoc(Nat::pow(2, p).int(), Nat::pow(2, e.neg_part()).int())),
    }
}

// ---------------------------------------------------------------------------
// Operations. A sum aligns both mantissas to the smaller exponent: with
// `d = a.exp - b.exp` split as `d = up - down`, the common exponent is
// `a.exp - up = b.exp - down`, and no case on the sign of `d` is needed.

fn Dyadic::ofInt(n: Int) → Dyadic { Dyadic(n, 0) }

instance Numeral<Dyadic> { ofNat := λ (n: Nat) => Dyadic::ofInt(OfNat(n)) }

fn Dyadic::neg(self a: Dyadic) → Dyadic { Dyadic(-a.mant, a.exp) }

fn Dyadic::add(self a, b: Dyadic) → Dyadic {
    let d = a.exp - b.exp;
    Dyadic(a.mant * Nat::pow(2, d.pos_part()).int() + b.mant * Nat::pow(2, d.neg_part()).int(), a.exp - d.pos_part().int())
}

fn Dyadic::mul(self a, b: Dyadic) → Dyadic { Dyadic(a.mant * b.mant, a.exp + b.exp) }

designation + at Dyadic := Dyadic::add
designation * at Dyadic := Dyadic::mul
designation prefix - at Dyadic := Dyadic::neg

fn Dyadic::sub(self a, b: Dyadic) → Dyadic { a + -b }

designation - at Dyadic := Dyadic::sub

// Multiplying by `2^k` moves only the exponent.
fn Dyadic::shift(self a: Dyadic, k: Int) → Dyadic { Dyadic(a.mant, a.exp + k) }

// ---------------------------------------------------------------------------
// The embedding is a ring homomorphism.

theorem Dyadic::rat_neg(self a: Dyadic): (-a).rat() ≈ -a.rat() {
    (-a).rat().same_of_parts(-a.rat(), a.mant.mul_neg_l(Nat::pow(2, a.exp.pos_part()).int()), refl)
}

theorem Dyadic::rat_mul(self a, b: Dyadic): (a * b).rat() ≈ a.rat() * b.rat() {
    let pa = a.exp.pos_sub_neg();
    let pb = b.exp.pos_sub_neg();
    let p = a.exp.pos_part() + b.exp.pos_part();
    let q = a.exp.neg_part() + b.exp.neg_part();
    let prod = Dyadic::rat_split(a.mant * b.mant, a.exp + b.exp, p, q, omega);
    Rat::same_trans(prod, ring(Nat::int_pow_add(2, a.exp.pos_part(), b.exp.pos_part()),
        Nat::int_pow_add(2, a.exp.neg_part(), b.exp.neg_part()), a.rat().den_mul(b.rat())))
}

theorem Dyadic::rat_add(self a, b: Dyadic): (a + b).rat() ≈ a.rat() + b.rat() {
    let d = a.exp - b.exp;
    let c = a.exp - d.pos_part().int();
    let pd = d.pos_sub_neg();
    let pc = c.pos_sub_neg();
    let s = c.pos_part();
    let t = c.neg_part();
    let up = d.pos_part();
    let down = d.neg_part();
    let sum = Dyadic::rat_split(a.mant * Nat::pow(2, up).int() + b.mant * Nat::pow(2, down).int(), c, s, t, omega);
    let ra = Dyadic::rat_split(a.mant, a.exp, s + up, t, omega);
    let rb = Dyadic::rat_split(b.mant, b.exp, s + down, t, omega);
    let x = Rat(a.mant * Nat::pow(2, s + up).int(), Nat::pow(2, t));
    let y = Rat(b.mant * Nat::pow(2, s + down).int(), Nat::pow(2, t));
    let dx: (x.den.int() = Nat::pow(2, t).int()) = refl;
    let dy: (y.den.int() = Nat::pow(2, t).int()) = refl;
    let parts: Rat::Same(Rat((a.mant * Nat::pow(2, up).int() + b.mant * Nat::pow(2, down).int()) * Nat::pow(2, s).int(), Nat::pow(2, t)), x + y)
        = ring(Nat::int_pow_add(2, s, up), Nat::int_pow_add(2, s, down), x.den_add(y), dx, dy);
    Rat::same_trans(sum, Rat::same_trans(parts, Rat::add_respects(Rat::same_sym(ra), Rat::same_sym(rb))))
}

theorem Dyadic::rat_sub(self a, b: Dyadic): (a - b).rat() ≈ a.rat() - b.rat() {
    Rat::same_trans(a.rat_add(-b), Rat::add_respects(a.rat().same_refl(), b.rat_neg()))
}

theorem Dyadic::rat_ofInt(n: Int): Dyadic::ofInt(n).rat() ≈ Rat::ofInt(n) { omega }

// A law at `Dyadic` is the rationals' law between the images.
theorem Dyadic::same_via({a, b: Dyadic}, {p, q: Rat}, ha: a.rat() ≈ p, h: p ≈ q, hb: b.rat() ≈ q): a ≈ b {
    Rat::same_trans(ha, Rat::same_trans(h, Rat::same_sym(hb)))
}

theorem Dyadic::neg_respects({a, a2: Dyadic}, ha: a ≈ a2): -a ≈ -a2 {
    Dyadic::same_via(a.rat_neg(), Rat::neg_respects(x := a.rat(), x2 := a2.rat(), hx := ha), a2.rat_neg())
}

theorem Dyadic::add_respects({a, a2, b, b2: Dyadic}, ha: a ≈ a2, hb: b ≈ b2): a + b ≈ a2 + b2 {
    Dyadic::same_via(a.rat_add(b), Rat::add_respects(x := a.rat(), x2 := a2.rat(), y := b.rat(), y2 := b2.rat(), hx := ha, hy := hb), a2.rat_add(b2))
}

theorem Dyadic::mul_respects({a, a2, b, b2: Dyadic}, ha: a ≈ a2, hb: b ≈ b2): a * b ≈ a2 * b2 {
    Dyadic::same_via(a.rat_mul(b), Rat::mul_respects(x := a.rat(), x2 := a2.rat(), y := b.rat(), y2 := b2.rat(), hx := ha, hy := hb), a2.rat_mul(b2))
}

instance Respects2<Dyadic, Dyadic, Dyadic>(Dyadic::Same, Dyadic::Same, Dyadic::Same, Dyadic::add) {
    respects2 := λ a a2 ha b b2 hb => Dyadic::add_respects(ha, hb),
}

instance Respects2<Dyadic, Dyadic, Dyadic>(Dyadic::Same, Dyadic::Same, Dyadic::Same, Dyadic::mul) {
    respects2 := λ a a2 ha b b2 hb => Dyadic::mul_respects(ha, hb),
}

theorem Dyadic::rat_zero(): Dyadic::rat(0) ≈ 0 { Dyadic::rat_ofInt(0) }

theorem Dyadic::rat_one(): Dyadic::rat(1) ≈ 1 { Dyadic::rat_ofInt(1) }

theorem Dyadic::add_comm(self a, b: Dyadic): a + b ≈ b + a {
    Dyadic::same_via(a.rat_add(b), a.rat().add_comm(b.rat()), b.rat_add(a))
}

theorem Dyadic::mul_comm(self a, b: Dyadic): a * b ≈ b * a {
    Dyadic::same_via(a.rat_mul(b), a.rat().mul_comm(b.rat()), b.rat_mul(a))
}

theorem Dyadic::add_assoc(self a, b, c: Dyadic): (a + b) + c ≈ a + (b + c) {
    Dyadic::same_via(Rat::same_trans((a + b).rat_add(c), Rat::add_respects(a.rat_add(b), c.rat().same_refl())),
        a.rat().add_assoc(b.rat(), c.rat()),
        Rat::same_trans(a.rat_add(b + c), Rat::add_respects(a.rat().same_refl(), b.rat_add(c))))
}

theorem Dyadic::mul_assoc(self a, b, c: Dyadic): (a * b) * c ≈ a * (b * c) {
    Dyadic::same_via(Rat::same_trans((a * b).rat_mul(c), Rat::mul_respects(a.rat_mul(b), c.rat().same_refl())),
        a.rat().mul_assoc(b.rat(), c.rat()),
        Rat::same_trans(a.rat_mul(b * c), Rat::mul_respects(a.rat().same_refl(), b.rat_mul(c))))
}

theorem Dyadic::zero_add(self a: Dyadic): 0 + a ≈ a {
    Dyadic::same_via(Rat::same_trans(Dyadic::rat_add(0, a), Rat::add_respects(Dyadic::rat_zero(), a.rat().same_refl())),
        a.rat().zero_add(), a.rat().same_refl())
}

theorem Dyadic::add_zero(self a: Dyadic): a + 0 ≈ a { Dyadic::same_trans(a.add_comm(0), a.zero_add()) }

theorem Dyadic::one_mul(self a: Dyadic): 1 * a ≈ a {
    Dyadic::same_via(Rat::same_trans(Dyadic::rat_mul(1, a), Rat::mul_respects(Dyadic::rat_one(), a.rat().same_refl())),
        a.rat().one_mul(), a.rat().same_refl())
}

theorem Dyadic::mul_one(self a: Dyadic): a * 1 ≈ a { Dyadic::same_trans(a.mul_comm(1), a.one_mul()) }

theorem Dyadic::add_neg(self a: Dyadic): a + -a ≈ 0 {
    Dyadic::same_via(Rat::same_trans(a.rat_add(-a), Rat::add_respects(a.rat().same_refl(), a.rat_neg())),
        a.rat().add_neg(), Dyadic::rat_zero())
}

theorem Dyadic::neg_add_self(self a: Dyadic): -a + a ≈ 0 { Dyadic::same_trans((-a).add_comm(a), a.add_neg()) }

theorem Dyadic::mul_add_distr(self a, b, c: Dyadic): a * (b + c) ≈ a * b + a * c {
    Dyadic::same_via(Rat::same_trans(a.rat_mul(b + c), Rat::mul_respects(a.rat().same_refl(), b.rat_add(c))),
        a.rat().mul_add_distr(b.rat(), c.rat()),
        Rat::same_trans((a * b).rat_add(a * c), Rat::add_respects(a.rat_mul(b), a.rat_mul(c))))
}

theorem Dyadic::add_mul_distr(self a, b, c: Dyadic): (a + b) * c ≈ a * c + b * c {
    Dyadic::same_via(Rat::same_trans((a + b).rat_mul(c), Rat::mul_respects(a.rat_add(b), c.rat().same_refl())),
        a.rat().add_mul_distr(b.rat(), c.rat()),
        Rat::same_trans((a * c).rat_add(b * c), Rat::add_respects(a.rat_mul(c), b.rat_mul(c))))
}

theorem Dyadic::zero_mul(self a: Dyadic): 0 * a ≈ 0 {
    Dyadic::same_via(Rat::same_trans(Dyadic::rat_mul(0, a), Rat::mul_respects(Dyadic::rat_zero(), a.rat().same_refl())),
        a.rat().zero_mul(), Dyadic::rat_zero())
}

theorem Dyadic::mul_zero(self a: Dyadic): a * 0 ≈ 0 { Dyadic::same_trans(a.mul_comm(0), a.zero_mul()) }

instance SemigroupRel<Dyadic>(Dyadic::Same, Dyadic::add) { assoc := Dyadic::add_assoc }
instance Commutative<Dyadic>(Dyadic::Same, Dyadic::add) { comm := Dyadic::add_comm }
instance SemigroupRel<Dyadic>(Dyadic::Same, Dyadic::mul) { assoc := Dyadic::mul_assoc }
instance Commutative<Dyadic>(Dyadic::Same, Dyadic::mul) { comm := Dyadic::mul_comm }

instance CommMonoidRel<Dyadic>(Dyadic::Same, Dyadic::add) {
    unit := 0,
    unit_l := Dyadic::zero_add,
    unit_r := Dyadic::add_zero,
}

instance GroupRel<Dyadic>(Dyadic::Same, Dyadic::add) {
    inv := Dyadic::neg,
    inv_l := Dyadic::neg_add_self,
    inv_r := Dyadic::add_neg,
    inv_respects := λ a b h => Dyadic::neg_respects(h),
}

instance MonoidRel<Dyadic>(Dyadic::Same, Dyadic::mul) {
    unit := 1,
    unit_l := Dyadic::one_mul,
    unit_r := Dyadic::mul_one,
}

instance Distributes<Dyadic>(Dyadic::Same, Dyadic::add, Dyadic::mul) {
    distrib_l := Dyadic::mul_add_distr,
    distrib_r := Dyadic::add_mul_distr,
}

instance CommRing<Dyadic>(Dyadic::Same, Dyadic::add, Dyadic::mul) {
    zero_mul := Dyadic::zero_mul,
    mul_zero := Dyadic::mul_zero,
}

// ---------------------------------------------------------------------------
// Order: the rationals' order on the images, so `Dyadic` is a strict order
// with cotransitivity, and both comparisons are decided by integer
// arithmetic on the images' cross products.

theorem Dyadic::lt_irrefl(self a: Dyadic): ¬(a < a) { a.rat().lt_irrefl() }

theorem Dyadic::lt_trans({a, b, c: Dyadic}, h1: a < b, h2: b < c): a < c {
    Rat::lt_trans(x := a.rat(), y := b.rat(), z := c.rat(), h1 := h1, h2 := h2)
}

theorem Dyadic::le_trans({a, b, c: Dyadic}, h1: a <= b, h2: b <= c): a <= c {
    Rat::le_trans(x := a.rat(), y := b.rat(), z := c.rat(), hxy := h1, hyz := h2)
}

theorem Dyadic::lt_respects({a, a2, b, b2: Dyadic}, ha: a ≈ a2, hb: b ≈ b2, h: a < b): a2 < b2 {
    Rat::lt_respects(x := a.rat(), x2 := a2.rat(), y := b.rat(), y2 := b2.rat(), hx := ha, hy := hb, h := h)
}

theorem Dyadic::same_of_not_lt({a, b: Dyadic}, h1: ¬(a < b), h2: ¬(b < a)): a ≈ b {
    Rat::same_of_not_lt(x := a.rat(), y := b.rat(), h1 := h1, h2 := h2)
}

theorem Dyadic::le_of_not_lt({a, b: Dyadic}, h: ¬(b < a)): a <= b { Rat::le_of_not_lt(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::lt_of_not_le({a, b: Dyadic}, h: ¬(b <= a)): a < b { Rat::lt_of_not_le(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::not_lt_of_le({a, b: Dyadic}, h: a <= b): ¬(b < a) { Rat::not_lt_of_le(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::lt_cotrans(self a, b, c: Dyadic, h: a < b): a < c ∨ c < b { a.rat().lt_cotrans(b.rat(), c.rat(), h) }

// The relation kit `calc` and `relation_step` resolve against, as at `Rat`.

theorem Dyadic::le_refl(self a: Dyadic): a <= a { a.rat().le_refl() }

theorem Dyadic::le_of_same({a, b: Dyadic}, h: a ≈ b): a <= b { Rat::le_of_same(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::le_of_lt({a, b: Dyadic}, h: a < b): a <= b { Rat::le_of_lt(x := a.rat(), y := b.rat(), h := h) }

theorem Dyadic::le_total(self a, b: Dyadic): a <= b ∨ b <= a { a.rat().le_total(b.rat()) }

theorem Dyadic::lt_of_lt_of_le({a, b, c: Dyadic}, h1: a < b, h2: b <= c): a < c {
    Rat::lt_of_lt_of_le(x := a.rat(), y := b.rat(), z := c.rat(), h1 := h1, h2 := h2)
}

theorem Dyadic::lt_of_le_of_lt({a, b, c: Dyadic}, h1: a <= b, h2: b < c): a < c {
    Rat::lt_of_le_of_lt(x := a.rat(), y := b.rat(), z := c.rat(), h1 := h1, h2 := h2)
}

instance Preorder<Dyadic>(Dyadic::Le) {
    rel_refl := Dyadic::le_refl,
    rel_trans := λ a b c h1 h2 => Dyadic::le_trans(h1, h2),
}

instance Total<Dyadic>(Dyadic::Le) { rel_total := Dyadic::le_total }

instance Irreflexive<Dyadic>(Dyadic::Lt) { rel_irrefl := Dyadic::lt_irrefl }

instance Transitive<Dyadic>(Dyadic::Lt) { rel_trans := λ a b c h1 h2 => Dyadic::lt_trans(h1, h2) }

instance Trans<Dyadic>(Dyadic::Le, Dyadic::Lt, Dyadic::Lt) { rel_chain := λ a b c h1 h2 => Dyadic::lt_of_le_of_lt(h1, h2) }
instance Trans<Dyadic>(Dyadic::Lt, Dyadic::Le, Dyadic::Lt) { rel_chain := λ a b c h1 h2 => Dyadic::lt_of_lt_of_le(h1, h2) }
instance Trans<Dyadic>(Dyadic::Same, Dyadic::Le, Dyadic::Le) { rel_chain := λ a b c h1 h2 => Dyadic::le_trans(Dyadic::le_of_same(h1), h2) }
instance Trans<Dyadic>(Dyadic::Le, Dyadic::Same, Dyadic::Le) { rel_chain := λ a b c h1 h2 => Dyadic::le_trans(h1, Dyadic::le_of_same(h2)) }
instance Trans<Dyadic>(Dyadic::Same, Dyadic::Lt, Dyadic::Lt) { rel_chain := λ a b c h1 h2 => Dyadic::lt_of_le_of_lt(Dyadic::le_of_same(h1), h2) }
instance Trans<Dyadic>(Dyadic::Lt, Dyadic::Same, Dyadic::Lt) { rel_chain := λ a b c h1 h2 => Dyadic::lt_of_lt_of_le(h1, Dyadic::le_of_same(h2)) }

instance StrictOrder<Dyadic>(Dyadic::Same, Dyadic::Lt, Dyadic::Le) {
    lt_irrefl := Dyadic::lt_irrefl,
    lt_trans := λ a b c h1 h2 => Dyadic::lt_trans(h1, h2),
    lt_respects := λ a a2 b b2 ha hb h => Dyadic::lt_respects(ha, hb, h),
    lt_tight := λ a b h1 h2 => Dyadic::same_of_not_lt(h1, h2),
    le_of_not_lt := λ a b h => Dyadic::le_of_not_lt(h),
    not_lt_of_le := λ a b h => Dyadic::not_lt_of_le(h),
}

instance Cotransitive<Dyadic>(Dyadic::Lt) {
    rel_cotrans := Dyadic::lt_cotrans,
}

instance PseudoOrder<Dyadic>(Dyadic::Same, Dyadic::Lt, Dyadic::Le) {}

// ---------------------------------------------------------------------------
// Shifts and the integers.

theorem Dyadic::rat_shift_split(self a: Dyadic, k: Nat): a.shift(k.int()) ≈ Dyadic(a.mant * Nat::pow(2, k).int(), a.exp) {
    let pa = a.exp.pos_sub_neg();
    let p = a.exp.pos_part();
    let q = a.exp.neg_part();
    let lhs = Dyadic::rat_split(a.mant, a.exp + k.int(), p + k, q, omega);
    let num = calc {
        a.mant * Nat::pow(2, p + k).int()
            = a.mant * (Nat::pow(2, p).int() * Nat::pow(2, k).int()) := cong(Nat::int_pow_add(2, p, k)),
            = a.mant * (Nat::pow(2, k).int() * Nat::pow(2, p).int()) := cong(Nat::pow(2, p).int().mul_comm(Nat::pow(2, k).int())),
            = (a.mant * Nat::pow(2, k).int()) * Nat::pow(2, p).int() := sym(a.mant.mul_assoc(Nat::pow(2, k).int(), Nat::pow(2, p).int())),
    };
    let mid = Rat(a.mant * Nat::pow(2, p + k).int(), Nat::pow(2, q)).same_of_parts(Dyadic(a.mant * Nat::pow(2, k).int(), a.exp).rat(), num, refl);
    Rat::same_trans(lhs, mid)
}

// Aligning a mantissa to a lower exponent does not change the value: this is
// the step every comparison of two floats starts from.
theorem Dyadic::align(m, e: Int, k: Nat): Dyadic(m * Nat::pow(2, k).int(), e) ≈ Dyadic(m, e + k.int()) {
    Dyadic::same_sym(Dyadic(m, e).rat_shift_split(k))
}

theorem Dyadic::ofInt_le(m, n: Int, h: m <= n): Dyadic::ofInt(m) <= Dyadic::ofInt(n) { omega }

theorem Dyadic::ofInt_lt(m, n: Int, h: m < n): Dyadic::ofInt(m) < Dyadic::ofInt(n) { omega }

// At one exponent, the order is the mantissas' order.
theorem Dyadic::lt_of_mant_lt(m, n, e: Int, h: m < n): Dyadic(m, e) < Dyadic(n, e) {
    let p = Nat::pow(2, e.pos_part()).int();
    let q = Nat::pow(2, e.neg_part()).int();
    let pp: (OfNat(0) < p) = Nat::pow_pos(a := 2, n := e.pos_part());
    let qp: (OfNat(0) < q) = Nat::pow_pos(a := 2, n := e.neg_part());
    Int::mul_lt_mono_r(m * p, n * p, q, Int::mul_lt_mono_r(m, n, p, h, pp), qp)
}

theorem Dyadic::le_of_mant_le(m, n, e: Int, h: m <= n): Dyadic(m, e) <= Dyadic(n, e) {
    let p = Nat::pow(2, e.pos_part()).int();
    let q = Nat::pow(2, e.neg_part()).int();
    let pp: (OfNat(0) < p) = Nat::pow_pos(a := 2, n := e.pos_part());
    let qp: (OfNat(0) < q) = Nat::pow_pos(a := 2, n := e.neg_part());
    Int::mul_le_mono_r(m * p, n * p, q, Int::mul_le_mono_r(m, n, p, h, omega), omega)
}

theorem Dyadic::mant_le_of_le(m, n, e: Int, h: Dyadic(m, e) <= Dyadic(n, e)): m <= n {
    match m.le_dec(n) {
        Inl(yes) => yes,
        Inr(no) => false_elim(Rat::not_le_of_lt(x := Dyadic(n, e).rat(), y := Dyadic(m, e).rat(),
            h := Dyadic::lt_of_mant_lt(n, m, e, n.lt_of_not_le(m, no)))(h)),
    }
}

theorem Dyadic::mant_lt_of_lt(m, n, e: Int, h: Dyadic(m, e) < Dyadic(n, e)): m < n {
    match n.le_dec(m) {
        Inl(le) => false_elim(Rat::not_le_of_lt(x := Dyadic(m, e).rat(), y := Dyadic(n, e).rat(), h := h)(Dyadic::le_of_mant_le(n, m, e, le))),
        Inr(no) => m.lt_of_not_le(n, no),
    }
}

// The order decided on mantissas aligned to the smaller exponent, as a sum
// aligns them: `2^|a.exp - b.exp|` is the only power it computes, where the
// rationals' cross products would compute both images' powers.
theorem Dyadic::aligned(self a, b: Dyadic):
    Dyadic(a.mant * Nat::pow(2, (a.exp - b.exp).pos_part()).int(), a.exp - (a.exp - b.exp).pos_part().int()) ≈ a
    ∧ Dyadic(b.mant * Nat::pow(2, (a.exp - b.exp).neg_part()).int(), a.exp - (a.exp - b.exp).pos_part().int()) ≈ b
{
    let d = a.exp - b.exp;
    let up = d.pos_part();
    let down = d.neg_part();
    let c = a.exp - up.int();
    let pd = d.pos_sub_neg();
    let ea: (c + up.int() = a.exp) = omega;
    let eb: (c + down.int() = b.exp) = omega;
    And(j(ea, λ v _ => Dyadic(a.mant * Nat::pow(2, up).int(), c) ≈ Dyadic(a.mant, v), Dyadic::align(a.mant, c, up)),
        j(eb, λ v _ => Dyadic(b.mant * Nat::pow(2, down).int(), c) ≈ Dyadic(b.mant, v), Dyadic::align(b.mant, c, down)))
}

fn Dyadic::le_dec(self a, b: Dyadic) → a <= b ∨ ¬(a <= b) {
    let d = a.exp - b.exp;
    let c = a.exp - d.pos_part().int();
    let x = a.mant * Nat::pow(2, d.pos_part()).int();
    let y = b.mant * Nat::pow(2, d.neg_part()).int();
    let al = a.aligned(b);
    let X = Dyadic(x, c).rat();
    let Y = Dyadic(y, c).rat();
    match x.le_dec(y) {
        Inl(le) => Inl(Rat::le_respects(x := X, x2 := a.rat(), y := Y, y2 := b.rat(), hx := al.left, hy := al.right, h := Dyadic::le_of_mant_le(x, y, c, le))),
        Inr(no) => Inr(λ h => no(Dyadic::mant_le_of_le(x, y, c,
            Rat::le_respects(x := a.rat(), x2 := X, y := b.rat(), y2 := Y, hx := Dyadic::same_sym(al.left), hy := Dyadic::same_sym(al.right), h := h)))),
    }
}

// At one exponent the sum adds the mantissas.
theorem Dyadic::rat_add_exp(m, n, e: Int): Dyadic(m, e).rat() + Dyadic(n, e).rat() ≈ Dyadic(m + n, e).rat() {
    let x = Dyadic(m, e).rat();
    let y = Dyadic(n, e).rat();
    let z = Dyadic(m + n, e).rat();
    let nx: (x.num = m * Nat::pow(2, e.pos_part()).int()) = refl;
    let ny: (y.num = n * Nat::pow(2, e.pos_part()).int()) = refl;
    let nz: (z.num = (m + n) * Nat::pow(2, e.pos_part()).int()) = refl;
    let dx: (x.den.int() = Nat::pow(2, e.neg_part()).int()) = refl;
    let dy: (y.den.int() = Nat::pow(2, e.neg_part()).int()) = refl;
    let dz: (z.den.int() = Nat::pow(2, e.neg_part()).int()) = refl;
    ring(x.den_add(y), nx, ny, nz, dx, dy, dz)
}

// A zero mantissa is zero at every exponent.
theorem Dyadic::zero_mant(e: Int): Dyadic(0, e) ≈ 0 {
    let p = Nat::pow(2, e.pos_part());
    let q = Nat::pow(2, e.neg_part());
    let cross: ((OfNat(0) * p.int()) * OfNat(1) = OfNat(0) * q.int()) = omega;
    let mid: Rat::Same(Rat(OfNat(0) * p.int(), q), 0) = cross;
    Rat::same_trans(Dyadic::rat_split(0, e, e.pos_part(), e.neg_part(), e.pos_sub_neg()),
        Rat::same_trans(mid, Rat::same_sym(Dyadic::rat_zero())))
}

// A dyadic that is zero has a zero mantissa: `m · 2^p` vanishes only at
// `m = 0`.
theorem Dyadic::mant_zero(self d: Dyadic, h: d ≈ 0): d.mant = 0 {
    let p = Nat::pow(2, d.exp.pos_part()).int();
    let q = Nat::pow(2, d.exp.neg_part()).int();
    let pp: (OfNat(0) < p) = Nat::pow_pos(a := 2, n := d.exp.pos_part());
    let cross: ((d.mant * p) * OfNat(1) = OfNat(0) * q) = h;
    let eqn: (d.mant * p = OfNat(0)) = omega(cross, Int::zero_mul(q));
    match d.mant as λ m => m * p = OfNat(0) → m = OfNat(0) {
        OfNat(n) => match n as λ k => OfNat(k) * p = OfNat(0) → OfNat(k) = OfNat(0) {
            Zero => λ _ => refl,
            Succ(k) => λ e => false_elim(omega(e, OfNat(Succ(k)).mul_pos(p, trivial, p_pos := pp))),
        },
        NegSucc(k) => λ e => false_elim(omega(e, NegSucc(k).mul_neg(p, Int::negsucc_lt_ofnat(k, 0), p_pos := pp))),
    }(eqn)
}

// The sign of a dyadic as a sign bit, with `z` standing for zero's sign.
fn Dyadic::sign_or(self d: Dyadic, z: Bool) → Bool {
    match d.mant { OfNat(n) => match n { Zero => z, Succ(_) => False }, NegSucc(_) => True }
}

theorem Dyadic::sign_or_zero(self d: Dyadic, z: Bool, h: d ≈ 0): d.sign_or(z) = z {
    j(sym(d.mant_zero(h)), λ v _ => Dyadic(v, d.exp).sign_or(z) = z, refl)
}

// ---------------------------------------------------------------------------
// Directed rounding at a precision (issues/dyadic-interval-enclosures.md).
// `d.down(p)` keeps the top `p` bits of the mantissa and floors the rest
// away; `d.up(p)` rounds toward `+∞` by negation. The exponent is unbounded,
// so neither overflows, and both are exact when the mantissa already fits.
// Soundness holds at every shift (`shr_le`), so how many bits `cut` drops is
// a cost choice that needs no proof.

fn Dyadic::cut(self d: Dyadic, p: Nat) → Nat { d.mant.natAbs().width() - p }

fn Dyadic::shr(self d: Dyadic, k: Nat) → Dyadic { Dyadic(d.mant.shr(k), d.exp + k.int()) }

fn Dyadic::down(self d: Dyadic, p: Nat) → Dyadic { d.shr(d.cut(p)) }

fn Dyadic::up(self d: Dyadic, p: Nat) → Dyadic { -((-d).down(p)) }

theorem Dyadic::shr_le(self d: Dyadic, k: Nat): d.shr(k) <= d {
    let m = d.mant.shr(k);
    Dyadic::le_trans(Dyadic::le_of_same(Dyadic::same_sym(Dyadic::align(m, d.exp, k))),
        Dyadic::le_of_mant_le(m * Nat::pow(2, k).int(), d.mant, d.exp, d.mant.shr_mul_le(k)))
}

theorem Dyadic::neg_le({a, b: Dyadic}, h: a <= b): -b <= -a {
    Rat::le_respects(Rat::same_sym(b.rat_neg()), Rat::same_sym(a.rat_neg()), Rat::neg_le(x := a.rat(), y := b.rat(), h := h))
}

theorem Dyadic::neg_neg(self a: Dyadic): -(-a) ≈ a {
    Rat::same_trans((-a).rat_neg(), Rat::same_trans(Rat::neg_respects(x := (-a).rat(), x2 := -a.rat(), hx := a.rat_neg()), a.rat().neg_neg()))
}

theorem Dyadic::down_le(self d: Dyadic, p: Nat): d.down(p) <= d { d.shr_le(d.cut(p)) }

theorem Dyadic::le_up(self d: Dyadic, p: Nat): d <= d.up(p) {
    Dyadic::le_trans(Dyadic::le_of_same(Dyadic::same_sym(d.neg_neg())), Dyadic::neg_le((-d).down_le(p)))
}

// ---------------------------------------------------------------------------
// Reciprocal bounds. A positive `m · 2^e` has reciprocal `2^K / m · 2^(-e-K)`
// for any `K`; flooring the quotient gives a bound below and its successor
// one above. `K = p + width(m)` leaves at least `p` bits in the quotient.

fn Dyadic::recip_cut(self d: Dyadic, p: Nat) → Nat { p + d.mant.natAbs().width() }

fn Dyadic::recip_quot(self d: Dyadic, p: Nat) → Nat { Nat::pow(2, d.recip_cut(p)).ldiv(d.mant.natAbs()).quot() }

fn Dyadic::recip_down(self d: Dyadic, p: Nat) → Dyadic { Dyadic(d.recip_quot(p).int(), -d.exp - d.recip_cut(p).int()) }

fn Dyadic::recip_up(self d: Dyadic, p: Nat) → Dyadic { Dyadic(Succ(d.recip_quot(p)).int(), -d.exp - d.recip_cut(p).int()) }

// `c · 2^(-e-K)` times `m · 2^e` is `c·m / 2^K`.
theorem Dyadic::recip_scale(c, m, e: Int, K: Nat): (Dyadic(c, -e - K.int()) * Dyadic(m, e)).rat() ≈ Rat((c * m) * 1, Nat::pow(2, K)) {
    Dyadic::rat_split(c * m, (-e - K.int()) + e, 0, K, omega)
}

theorem Dyadic::pos_of_mant({m: Nat}, e: Int, hm: 0 < m): 0 < Dyadic(m.int(), e) {
    Dyadic::lt_respects(Dyadic::zero_mant(e), Dyadic(m.int(), e).same_refl(), Dyadic::lt_of_mant_lt(0, m.int(), e, hm))
}

theorem Dyadic::rat_pos({d: Dyadic}, h: 0 < d): 0 < d.rat() { Rat::lt_respects(Dyadic::rat_zero(), d.rat().same_refl(), h) }

theorem Dyadic::rat_nonneg({d: Dyadic}, h: 0 <= d): 0 <= d.rat() { Rat::le_respects(Dyadic::rat_zero(), d.rat().same_refl(), h) }

// Negation turns a negative bound into a positive one.
theorem Dyadic::neg_pos({d: Dyadic}, h: d < 0): 0 < -d {
    Rat::lt_respects(Rat::same_sym(Dyadic::rat_neg(0)), Rat::same_sym(d.rat_neg()), Rat::neg_lt(x := d.rat(), y := Dyadic::rat(0), h := h))
}

theorem Dyadic::recip_down_at(m: Nat, e: Int, p: Nat, hm: 0 < m):
    Dyadic(m.int(), e).recip_down(p).rat() <= Dyadic(m.int(), e).rat().recip()
{
    let d = Dyadic(m.int(), e);
    let K = p + m.width();
    let q = Nat::pow(2, K).ldiv(m).quot();
    let r = Nat::pow(2, K).ldiv(m).rem();
    let parts: (q * m + r = Nat::pow(2, K)) = Nat::pow(2, K).ldiv_parts(m);
    let lo = Dyadic(q.int(), -e - K.int());
    let scale: ((lo * d).rat() ≈ Rat((q.int() * m.int()) * 1, Nat::pow(2, K))) = Dyadic::recip_scale(q.int(), m.int(), e, K);
    let cross: ((q.int() * m.int()) * 1 * 1 <= 1 * Nat::pow(2, K).int()) = omega(parts, Nat::int_mul(q, m));
    let one: (Rat((q.int() * m.int()) * 1, Nat::pow(2, K)) <= 1) = cross;
    let prod: (lo.rat() * d.rat() <= 1) = Rat::le_trans(Rat::le_of_same(Rat::same_trans(Rat::same_sym(lo.rat_mul(d)), scale)), one);
    Rat::le_recip_of_mul_le(Dyadic::rat_pos(Dyadic::pos_of_mant(e, hm)), prod)
}

theorem Dyadic::recip_up_at(m: Nat, e: Int, p: Nat, hm: 0 < m):
    Dyadic(m.int(), e).rat().recip() <= Dyadic(m.int(), e).recip_up(p).rat()
{
    let d = Dyadic(m.int(), e);
    let K = p + m.width();
    let q = Nat::pow(2, K).ldiv(m).quot();
    let r = Nat::pow(2, K).ldiv(m).rem();
    let parts: (q * m + r = Nat::pow(2, K)) = Nat::pow(2, K).ldiv_parts(m);
    let rem: (r < m) = Nat::pow(2, K).ldiv_rem_lt(m, d_pos := hm);
    let hi = Dyadic(Succ(q).int(), -e - K.int());
    let scale: ((hi * d).rat() ≈ Rat((Succ(q).int() * m.int()) * 1, Nat::pow(2, K))) = Dyadic::recip_scale(Succ(q).int(), m.int(), e, K);
    let cross: (1 * Nat::pow(2, K).int() <= (Succ(q).int() * m.int()) * 1 * 1) = omega(parts, rem, Nat::int_mul(Succ(q), m), q.mul_succ_left(m));
    let one: (1 <= Rat((Succ(q).int() * m.int()) * 1, Nat::pow(2, K))) = cross;
    let prod: (1 <= hi.rat() * d.rat()) = Rat::le_trans(one, Rat::le_of_same(Rat::same_trans(Rat::same_sym(scale), hi.rat_mul(d))));
    Rat::recip_le_of_one_le_mul(Dyadic::rat_pos(Dyadic::pos_of_mant(e, hm)), prod)
}

// A positive dyadic has a positive mantissa, so both bounds hold at every
// positive `d`.
theorem Dyadic::recip_bounds(self d: Dyadic, p: Nat, pos: 0 < d):
    d.recip_down(p).rat() <= d.rat().recip() ∧ d.rat().recip() <= d.recip_up(p).rat()
{
    match d.mant as λ v => 0 < Dyadic(v, d.exp) →
        Dyadic(v, d.exp).recip_down(p).rat() <= Dyadic(v, d.exp).rat().recip() ∧ Dyadic(v, d.exp).rat().recip() <= Dyadic(v, d.exp).recip_up(p).rat()
    {
        OfNat(n) => match n as λ k => 0 < Dyadic(OfNat(k), d.exp) →
            Dyadic(OfNat(k), d.exp).recip_down(p).rat() <= Dyadic(OfNat(k), d.exp).rat().recip() ∧ Dyadic(OfNat(k), d.exp).rat().recip() <= Dyadic(OfNat(k), d.exp).recip_up(p).rat()
        {
            Zero => λ h => false_elim(Dyadic::lt_irrefl(0, Dyadic::lt_respects(Dyadic::same_refl(0), Dyadic::zero_mant(d.exp), h))),
            Succ(j) => λ _ => And(Dyadic::recip_down_at(Succ(j), d.exp, p, trivial), Dyadic::recip_up_at(Succ(j), d.exp, p, trivial)),
        },
        NegSucc(j) => λ h => false_elim(Dyadic::lt_irrefl(0, Dyadic::lt_trans(h,
            Dyadic::lt_respects(Dyadic(NegSucc(j), d.exp).same_refl(), Dyadic::zero_mant(d.exp), Dyadic::lt_of_mant_lt(NegSucc(j), 0, d.exp, Int::negsucc_lt_ofnat(j, 0)))))),
    }(pos)
}

// ---------------------------------------------------------------------------
// Least and greatest of two, and comparisons as verdicts.

fn Dyadic::min(self a, b: Dyadic) → Dyadic { match a.le_dec(b) { Inl(_) => a, Inr(_) => b } }

fn Dyadic::max(self a, b: Dyadic) → Dyadic { match a.le_dec(b) { Inl(_) => b, Inr(_) => a } }

// The smaller is below anything either one is below.
theorem Dyadic::min_le_of(self a, b: Dyadic, t: Rat, h: a.rat() <= t ∨ b.rat() <= t): a.min(b).rat() <= t {
    match a.le_dec(b) as λ c => (match c { Inl(_) => a, Inr(_) => b }).rat() <= t {
        Inl(ab) => match h { Inl(at) => at, Inr(bt) => Rat::le_trans(x := a.rat(), y := b.rat(), z := t, hxy := ab, hyz := bt) },
        Inr(no) => match h { Inl(at) => Rat::le_trans(Rat::le_of_lt(Rat::lt_of_not_le(x := b.rat(), y := a.rat(), h := no)), at), Inr(bt) => bt },
    }
}

theorem Dyadic::le_max_of(self a, b: Dyadic, t: Rat, h: t <= a.rat() ∨ t <= b.rat()): t <= a.max(b).rat() {
    match a.le_dec(b) as λ c => t <= (match c { Inl(_) => b, Inr(_) => a }).rat() {
        Inl(ab) => match h { Inl(at) => Rat::le_trans(x := t, y := a.rat(), z := b.rat(), hxy := at, hyz := ab), Inr(bt) => bt },
        Inr(no) => match h { Inl(at) => at, Inr(bt) => Rat::le_trans(bt, Rat::le_of_lt(Rat::lt_of_not_le(x := b.rat(), y := a.rat(), h := no))) },
    }
}

fn Dyadic::lt_bool(self a, b: Dyadic) → Bool { match b.le_dec(a) { Inl(_) => False, Inr(_) => True } }

fn Dyadic::le_bool(self a, b: Dyadic) → Bool { match a.le_dec(b) { Inl(_) => True, Inr(_) => False } }

theorem Dyadic::lt_of_lt_bool(self a, b: Dyadic, h: a.lt_bool(b).IsTrue()): a < b {
    match b.le_dec(a) as λ c => Bool::IsTrue(match c { Inl(_) => False, Inr(_) => True }) → a < b {
        Inl(_) => λ no => false_elim(no),
        Inr(no) => λ _ => Rat::lt_of_not_le(x := a.rat(), y := b.rat(), h := no),
    }(h)
}

theorem Dyadic::le_of_le_bool(self a, b: Dyadic, h: a.le_bool(b).IsTrue()): a <= b {
    match a.le_dec(b) as λ c => Bool::IsTrue(match c { Inl(_) => True, Inr(_) => False }) → a <= b {
        Inl(yes) => λ _ => yes,
        Inr(_) => λ no => false_elim(no),
    }(h)
}

// The sign read off the mantissa, with no comparison.
fn Dyadic::nonneg_dec(self d: Dyadic) → 0 <= d ∨ ¬(0 <= d) {
    match d.mant as λ v => 0 <= Dyadic(v, d.exp) ∨ ¬(0 <= Dyadic(v, d.exp)) {
        OfNat(n) => Inl(Rat::le_respects(x := Dyadic(0, d.exp).rat(), x2 := Dyadic::rat(0), y := Dyadic(OfNat(n), d.exp).rat(), y2 := Dyadic(OfNat(n), d.exp).rat(),
            hx := Dyadic::zero_mant(d.exp), hy := Rat::same_refl(Dyadic(OfNat(n), d.exp).rat()), h := Dyadic::le_of_mant_le(0, OfNat(n), d.exp, trivial))),
        NegSucc(n) => Inr(λ h => Dyadic::not_lt_of_le(h, Dyadic::lt_respects(Dyadic(NegSucc(n), d.exp).same_refl(), Dyadic::zero_mant(d.exp),
            Dyadic::lt_of_mant_lt(NegSucc(n), 0, d.exp, Int::negsucc_lt_ofnat(n, 0))))),
    }
}

// ---------------------------------------------------------------------------
// A rational floored to p bits: ⌊q · 2^p⌋ · 2^-p, within 2^-p of q. The real
// numbers (std/creal) keep their terms dyadic with it, so a term's size is its
// precision and not the history of the operations that made it.

fn Dyadic::floor_rat(q: Rat, p: Nat) → Dyadic { Dyadic((q.num * Nat::pow(2, p).int()).div(q.den.int()), -p.int()) }

theorem Dyadic::floor_rat_close(q: Rat, p: Nat): (Dyadic::floor_rat(q, p).rat() - q).abs() <= Rat::inv_pow2(p) {
    let P = Nat::pow(2, p).int();
    let D = q.den.int();
    let N = q.num * P;
    let d = N.div(D);
    let m = N.mod(D);
    let nz: (D ≠ OfNat(0)) = λ e => omega(q.den_pos, e);
    let parts: (d * D + m = N) = Int::div_mul_add_mod(N, D);
    let lo: (OfNat(0) <= m) = N.mod_nonneg(D, nz);
    let hi: (m < D) = N.mod_lt_abs(D, nz);
    let pnn: (OfNat(0) <= P) = trivial;
    let parts2: ((d * D + m) * P = N * P) = rewrite(parts, refl);
    let lo2: (OfNat(0) <= m * P) = m.mul_nonneg(P, lo, pnn);
    let hi2: (m * P <= D * P) = m.mul_le_mono_r(D, P, m.le_of_lt(D, hi), pnn);
    let r = Rat(d * Nat::pow(2, 0).int(), Nat::pow(2, p));
    let at: (Dyadic::floor_rat(q, p).rat() ≈ r) = Dyadic::rat_split(d, -p.int(), 0, p, omega);
    let c = Rat::inv_pow2(p);
    let one: (Nat::pow(2, 0).int() = 1) = refl;
    let dp: (OfNat(0) <= D * P) = D.mul_nonneg(P, trivial, pnn);
    let rn: (r.num = d * Nat::pow(2, 0).int()) = refl;
    let rd: (r.den.int() = P) = refl;
    let sd: ((q + c).den.int() = D * P) = refl;
    let sn: ((q + c).num = q.num * P + 1 * D) = refl;
    let td: ((r + c).den.int() = P * P) = refl;
    let tn: ((r + c).num = r.num * P + 1 * P) = refl;
    let ea: (r.num * (q + c).den.int() + m * P = (q.num * P) * P) = ring(rn, one, sd, parts2);
    let eb: ((q + c).num * r.den.int() = (q.num * P) * P + D * P) = ring(sn, rd);
    let ec: (q.num * (r + c).den.int() = (q.num * P) * P) = ring(td);
    let ed: ((r + c).num * q.den.int() + m * P = (q.num * P) * P + D * P) = ring(tn, rn, one, parts2);
    let up: (r <= q + c) = omega(ea, eb, lo2, dp);
    let down: (q <= r + c) = omega(ec, ed, hi2);
    let close: ((r - q).abs() <= c) = Rat::dist_le_of_le_add(up, down);
    Rat::le_respects(Rat::abs_respects(Rat::sub_respects(Rat::same_sym(at), q.same_refl())), Rat::inv_pow2(p).same_refl(), close)
}

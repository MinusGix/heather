// Interval enclosures of Cauchy reals, and comparisons of reals decided by
// evaluating them (issues/interval-creal-enclosures.md;
// docs/floating-point-design.md §16, "Enclosures of reals").
//
// `I.HasReal(x)` is `Interval::Has` read at `CReal` through the embedding:
// `lo <= x <= hi` with the bounds as constant reals. Every interval
// operation keeps containment at `CReal` as it does at `Rat`, by the same
// corner arguments with the order lemmas of `CReal` in place of `Rat`'s;
// the one step that differs is the sign of a real factor, which is never
// decided, and which a containment never needs decided: a `≤` between reals
// is a refutation, and `CReal::le_by_sign` splits on the sign inside it.
//
// A real is enclosed from its own terms: the n-th is within 1/(n+1) of it
// (`CReal::le_term_add`, `CReal::term_sub_le`), so `x.enclose(n, p)` rounds
// `[x_n - 1/(n+1), x_n + 1/(n+1)]` outward to `p` bits. A finer enclosure
// reads further out, and `RealExpr::lt_search` refines over the index as
// `IntervalExpr::lt_search` refines over the precision. Reciprocals are not
// here: a real's inverse needs a proof that it is apart from zero, which an
// expression tree does not carry.

import logic;
import bool;
import nat;
import int;
import relation_props;
import algebra;
import algebra_rel;
import order;
import ordered_field;
import semiring;
import rat;
import creal;
import dyadic;
import interval;

// A dyadic as a constant real is `CReal::ofRat(d.rat())`.

theorem Dyadic::real_neg(self a: Dyadic): CReal::ofRat((-a).rat()) ≈ -CReal::ofRat(a.rat()) { CReal::same_trans(CReal::ofRat_respects(a.rat_neg()), CReal::ofRat_neg(a.rat())) }

theorem Dyadic::real_add(self a, b: Dyadic): CReal::ofRat((a + b).rat()) ≈ CReal::ofRat(a.rat()) + CReal::ofRat(b.rat()) {
    CReal::same_trans(CReal::ofRat_respects(a.rat_add(b)), CReal::ofRat_add(a.rat(), b.rat()))
}

theorem Dyadic::real_mul(self a, b: Dyadic): CReal::ofRat((a * b).rat()) ≈ CReal::ofRat(a.rat()) * CReal::ofRat(b.rat()) {
    CReal::same_trans(CReal::ofRat_respects(a.rat_mul(b)), CReal::ofRat_mul(a.rat(), b.rat()))
}

theorem Dyadic::real_le({a, b: Dyadic}, h: a <= b): CReal::ofRat(a.rat()) <= CReal::ofRat(b.rat()) { CReal::ofRat_le(p := a.rat(), q := b.rat(), h := h) }

theorem Dyadic::real_lt({a, b: Dyadic}, h: a < b): CReal::ofRat(a.rat()) < CReal::ofRat(b.rat()) { CReal::ofRat_lt(p := a.rat(), q := b.rat(), h := h) }

theorem Dyadic::down_real(self d: Dyadic, p: Nat): CReal::ofRat(d.down(p).rat()) <= CReal::ofRat(d.rat()) { Dyadic::real_le(d.down_le(p)) }

theorem Dyadic::real_up(self d: Dyadic, p: Nat): CReal::ofRat(d.rat()) <= CReal::ofRat(d.up(p).rat()) { Dyadic::real_le(d.le_up(p)) }

fn Interval::HasReal(self I: Interval, x: CReal) → Type {
    match I { Bnd(lo, hi) => CReal::ofRat(lo.rat()) <= x ∧ x <= CReal::ofRat(hi.rat()), Whole => True }
}

theorem Interval::has_real_respects(I: Interval, {x, y: CReal}, e: x ≈ y, h: I.HasReal(x)): I.HasReal(y) {
    match I as λ K => K.HasReal(x) → K.HasReal(y) {
        Bnd(lo, hi) => λ k => And(CReal::le_respects(CReal::ofRat(lo.rat()).same_refl(), e, k.left), CReal::le_respects(e, CReal::ofRat(hi.rat()).same_refl(), k.right)),
        Whole => λ _ => trivial,
    }(h)
}

// A rational member is a member at `CReal`: the embedding keeps `≤`.
theorem Interval::has_real_of_has(I: Interval, {q: Rat}, h: I.Has(q)): I.HasReal(CReal::ofRat(q)) {
    match I as λ K => K.Has(q) → K.HasReal(CReal::ofRat(q)) {
        Bnd(_, _) => λ k => And(CReal::ofRat_le(k.left), CReal::ofRat_le(k.right)),
        Whole => λ _ => trivial,
    }(h)
}

theorem Interval::of_rat_has_real(q: Rat, p: Nat): Interval::of_rat(q, p).HasReal(CReal::ofRat(q)) {
    Interval::has_real_of_has(Interval::of_rat(q, p), Interval::of_rat_has(q, p))
}

// ---------------------------------------------------------------------------
// The operations, at `CReal`.

theorem Interval::neg_has_real(I: Interval, {x: CReal}, h: I.HasReal(x)): I.neg().HasReal(-x) {
    match I as λ K => K.HasReal(x) → K.neg().HasReal(-x) {
        Bnd(lo, hi) => λ k => And(CReal::le_respects(CReal::same_sym(hi.real_neg()), (-x).same_refl(), CReal::neg_le(k.right)),
            CReal::le_respects((-x).same_refl(), CReal::same_sym(lo.real_neg()), CReal::neg_le(k.left))),
        Whole => λ _ => trivial,
    }(h)
}

theorem Interval::add_bnd_has_real(a, b, c, d: Dyadic, p: Nat, {x, y: CReal}, hx: Bnd(a, b).HasReal(x), hy: Bnd(c, d).HasReal(y)):
    Bnd((a + c).down(p), (b + d).up(p)).HasReal(x + y)
{
    let low: (CReal::ofRat((a + c).rat()) <= x + y) = CReal::le_respects(CReal::same_sym(a.real_add(c)), (x + y).same_refl(), CReal::add_le_mono(hx.left, hy.left));
    let high: (x + y <= CReal::ofRat((b + d).rat())) = CReal::le_respects((x + y).same_refl(), CReal::same_sym(b.real_add(d)), CReal::add_le_mono(hx.right, hy.right));
    And(CReal::le_trans((a + c).down_real(p), low), CReal::le_trans(high, (b + d).real_up(p)))
}

theorem Interval::add_has_real(I, J: Interval, p: Nat, {x, y: CReal}, hx: I.HasReal(x), hy: J.HasReal(y)): I.add(J, p).HasReal(x + y) {
    match I as λ K => K.HasReal(x) → K.add(J, p).HasReal(x + y) {
        Bnd(a, b) => λ kx => match J as λ L => L.HasReal(y) → Bnd(a, b).add(L, p).HasReal(x + y) {
            Bnd(c, d) => λ ky => Interval::add_bnd_has_real(a, b, c, d, p, kx, ky),
            Whole => λ _ => trivial,
        }(hy),
        Whole => λ _ => trivial,
    }(hx)
}

theorem Interval::sub_has_real(I, J: Interval, p: Nat, {x, y: CReal}, hx: I.HasReal(x), hy: J.HasReal(y)): I.sub(J, p).HasReal(x - y) {
    Interval::add_has_real(I, J.neg(), p, hx, Interval::neg_has_real(J, hy))
}

// Products. With a dyadic factor `z`, `z·y` is between `z·c` and `z·d`, the
// rationals deciding which way; with a real factor `x` in `[a, b]`, `x·y`
// is above `a·y` or `b·y` by the sign of `y`, which `le_by_sign` splits on
// inside the refutation that a `≤` is.

theorem Interval::between_l_real(z, c, d: Dyadic, {y: CReal}, hy: Bnd(c, d).HasReal(y)):
    (CReal::ofRat((z * c).rat()) <= CReal::ofRat(z.rat()) * y ∨ CReal::ofRat((z * d).rat()) <= CReal::ofRat(z.rat()) * y) ∧ (CReal::ofRat(z.rat()) * y <= CReal::ofRat((z * c).rat()) ∨ CReal::ofRat(z.rat()) * y <= CReal::ofRat((z * d).rat()))
{
    let zy = CReal::ofRat(z.rat()) * y;
    match Rat::le_total(0, z.rat()) {
        Inl(pos) => {
            let hz: (0 <= CReal::ofRat(z.rat())) = CReal::ofRat_le(pos);
            And(Inl(CReal::le_respects(CReal::same_sym(z.real_mul(c)), zy.same_refl(), CReal::mul_le_mono_l(hy.left, hz))),
                Inr(CReal::le_respects(zy.same_refl(), CReal::same_sym(z.real_mul(d)), CReal::mul_le_mono_l(hy.right, hz))))
        },
        Inr(neg) => {
            let hz: (CReal::ofRat(z.rat()) <= 0) = CReal::ofRat_le(neg);
            And(Inr(CReal::le_respects(CReal::same_sym(z.real_mul(d)), zy.same_refl(), CReal::mul_le_mono_l_nonpos(hy.right, hz))),
                Inl(CReal::le_respects(zy.same_refl(), CReal::same_sym(z.real_mul(c)), CReal::mul_le_mono_l_nonpos(hy.left, hz))))
        },
    }
}

theorem Interval::corner_lo_real(a, c, d: Dyadic, s: CReal, h: CReal::ofRat((a * c).rat()) <= s ∨ CReal::ofRat((a * d).rat()) <= s): CReal::ofRat((a * c).min(a * d).rat()) <= s {
    match h {
        Inl(l) => CReal::le_trans(CReal::ofRat_le((a * c).min_le_of(a * d, (a * c).rat(), Inl((a * c).rat().le_refl()))), l),
        Inr(r) => CReal::le_trans(CReal::ofRat_le((a * c).min_le_of(a * d, (a * d).rat(), Inr((a * d).rat().le_refl()))), r),
    }
}

theorem Interval::corner_hi_real(a, c, d: Dyadic, s: CReal, h: s <= CReal::ofRat((a * c).rat()) ∨ s <= CReal::ofRat((a * d).rat())): s <= CReal::ofRat((a * c).max(a * d).rat()) {
    match h {
        Inl(l) => CReal::le_trans(l, CReal::ofRat_le((a * c).le_max_of(a * d, (a * c).rat(), Inl((a * c).rat().le_refl())))),
        Inr(r) => CReal::le_trans(r, CReal::ofRat_le((a * c).le_max_of(a * d, (a * d).rat(), Inr((a * d).rat().le_refl())))),
    }
}

theorem Interval::mul_box_has_real(a, b, c, d: Dyadic, p: Nat, {x, y: CReal}, hx: Bnd(a, b).HasReal(x), hy: Bnd(c, d).HasReal(y)):
    Interval::mul_box(a, b, c, d, p).HasReal(x * y)
{
    let lo = Interval::mul_lo(a, b, c, d);
    let hi = Interval::mul_hi(a, b, c, d);
    let la = (a * c).min(a * d);
    let lb = (b * c).min(b * d);
    let ha = (a * c).max(a * d);
    let hb = (b * c).max(b * d);
    let ba = Interval::between_l_real(a, c, d, hy);
    let bb = Interval::between_l_real(b, c, d, hy);
    let lo_a: (CReal::ofRat(lo.rat()) <= CReal::ofRat(a.rat()) * y) = CReal::le_trans(CReal::ofRat_le(la.min_le_of(lb, la.rat(), Inl(la.rat().le_refl()))), Interval::corner_lo_real(a, c, d, CReal::ofRat(a.rat()) * y, ba.left));
    let lo_b: (CReal::ofRat(lo.rat()) <= CReal::ofRat(b.rat()) * y) = CReal::le_trans(CReal::ofRat_le(la.min_le_of(lb, lb.rat(), Inr(lb.rat().le_refl()))), Interval::corner_lo_real(b, c, d, CReal::ofRat(b.rat()) * y, bb.left));
    let hi_a: (CReal::ofRat(a.rat()) * y <= CReal::ofRat(hi.rat())) = CReal::le_trans(Interval::corner_hi_real(a, c, d, CReal::ofRat(a.rat()) * y, ba.right), CReal::ofRat_le(ha.le_max_of(hb, ha.rat(), Inl(ha.rat().le_refl()))));
    let hi_b: (CReal::ofRat(b.rat()) * y <= CReal::ofRat(hi.rat())) = CReal::le_trans(Interval::corner_hi_real(b, c, d, CReal::ofRat(b.rat()) * y, bb.right), CReal::ofRat_le(ha.le_max_of(hb, hb.rat(), Inr(hb.rat().le_refl()))));
    let low: (CReal::ofRat(lo.rat()) <= x * y) = CReal::le_by_sign(y,
        λ pos => CReal::le_trans(lo_a, CReal::mul_le_mono_r(hx.left, pos)),
        λ neg => CReal::le_trans(lo_b, CReal::mul_le_mono_r_nonpos(hx.right, neg)));
    let high: (x * y <= CReal::ofRat(hi.rat())) = CReal::le_by_sign(y,
        λ pos => CReal::le_trans(CReal::mul_le_mono_r(hx.right, pos), hi_b),
        λ neg => CReal::le_trans(CReal::mul_le_mono_r_nonpos(hx.left, neg), hi_a));
    And(CReal::le_trans(lo.down_real(p), low), CReal::le_trans(high, hi.real_up(p)))
}

theorem Interval::mul_pos_has_real(a, b, c, d: Dyadic, p: Nat, ha: 0 <= a, hc: 0 <= c, {x, y: CReal}, hx: Bnd(a, b).HasReal(x), hy: Bnd(c, d).HasReal(y)):
    Bnd((a * c).down(p), (b * d).up(p)).HasReal(x * y)
{
    let ha0: (0 <= CReal::ofRat(a.rat())) = CReal::le_respects(CReal::ofRat_respects(Dyadic::rat_zero()), CReal::ofRat(a.rat()).same_refl(), Dyadic::real_le(ha));
    let hc0: (0 <= CReal::ofRat(c.rat())) = CReal::le_respects(CReal::ofRat_respects(Dyadic::rat_zero()), CReal::ofRat(c.rat()).same_refl(), Dyadic::real_le(hc));
    let y0: (0 <= y) = CReal::le_trans(hc0, hy.left);
    let b0: (0 <= CReal::ofRat(b.rat())) = CReal::le_trans(ha0, CReal::le_trans(hx.left, hx.right));
    let low: (CReal::ofRat((a * c).rat()) <= x * y) = CReal::le_respects(CReal::same_sym(a.real_mul(c)), (x * y).same_refl(),
        CReal::le_trans(CReal::mul_le_mono_l(hy.left, ha0), CReal::mul_le_mono_r(hx.left, y0)));
    let high: (x * y <= CReal::ofRat((b * d).rat())) = CReal::le_respects((x * y).same_refl(), CReal::same_sym(b.real_mul(d)),
        CReal::le_trans(CReal::mul_le_mono_r(hx.right, y0), CReal::mul_le_mono_l(hy.right, b0)));
    And(CReal::le_trans((a * c).down_real(p), low), CReal::le_trans(high, (b * d).real_up(p)))
}

theorem Interval::mul_bnd_has_real(a, b, c, d: Dyadic, p: Nat, {x, y: CReal}, hx: Bnd(a, b).HasReal(x), hy: Bnd(c, d).HasReal(y)): Interval::mul_bnd(a, b, c, d, p).HasReal(x * y) {
    match a.nonneg_dec() as λ s => (match s { Inl(_) => match c.nonneg_dec() { Inl(_) => Bnd((a * c).down(p), (b * d).up(p)), Inr(_) => Interval::mul_box(a, b, c, d, p) },
            Inr(_) => Interval::mul_box(a, b, c, d, p) }).HasReal(x * y) {
        Inl(ha) => match c.nonneg_dec() as λ s => (match s { Inl(_) => Bnd((a * c).down(p), (b * d).up(p)), Inr(_) => Interval::mul_box(a, b, c, d, p) }).HasReal(x * y) {
            Inl(hc) => Interval::mul_pos_has_real(a, b, c, d, p, ha, hc, hx, hy),
            Inr(_) => Interval::mul_box_has_real(a, b, c, d, p, hx, hy),
        },
        Inr(_) => Interval::mul_box_has_real(a, b, c, d, p, hx, hy),
    }
}

theorem Interval::mul_has_real(I, J: Interval, p: Nat, {x, y: CReal}, hx: I.HasReal(x), hy: J.HasReal(y)): I.mul(J, p).HasReal(x * y) {
    match I as λ K => K.HasReal(x) → K.mul(J, p).HasReal(x * y) {
        Bnd(a, b) => λ kx => match J as λ L => L.HasReal(y) → Bnd(a, b).mul(L, p).HasReal(x * y) {
            Bnd(c, d) => λ ky => Interval::mul_bnd_has_real(a, b, c, d, p, kx, ky),
            Whole => λ _ => trivial,
        }(hy),
        Whole => λ _ => trivial,
    }(hx)
}

// Powers, by the product chain and by squaring, as at `Rat`.

theorem Interval::one_has_real(): Interval::of_int(1).HasReal(1) {
    Interval::has_real_respects(Interval::of_int(1), CReal::ofRat_respects(Dyadic::rat_ofInt(1)), Interval::has_real_of_has(Interval::of_int(1), Interval::point_has(Dyadic(1, 0))))
}

theorem Interval::npow_has_real(I: Interval, n, p: Nat, {x: CReal}, h: I.HasReal(x)): I.npow(n, p).HasReal(x.npow(n)) {
    match n as λ k => I.npow(k, p).HasReal(x.npow(k)) {
        Zero => Interval::one_has_real(),
        Succ(k) => Interval::mul_has_real(I.npow(k, p), I, p, Interval::npow_has_real(I, k, p, h), h),
    }
}

theorem Interval::pow_step_has_real(I: Interval, n: Nat, H: Interval, p: Nat, {x: CReal}, hx: I.HasReal(x), hh: H.HasReal(x.npow(n.half()))):
    Interval::pow_step(I, n, H, p).HasReal(x.npow(n))
{
    let h = n.half();
    let sq: (H.mul(H, p).HasReal(x.npow(h + h))) = Interval::has_real_respects(H.mul(H, p), CReal::same_sym(x.npow_add(h, h)), Interval::mul_has_real(H, H, p, hh, hh));
    match Succ(h + h).le_dec(n) as λ c => (match c { Inl(_) => H.mul(H, p).mul(I, p), Inr(_) => H.mul(H, p) }).HasReal(x.npow(n)) {
        Inl(le) => j(Succ(h + h).le_antisym(n, le, n.le_succ_half_add()), λ m _ => H.mul(H, p).mul(I, p).HasReal(x.npow(m)), Interval::mul_has_real(H.mul(H, p), I, p, sq, hx)),
        Inr(nle) => j((h + h).le_antisym(n, n.half_add_le(), Nat::lt_of_not_le(n, Succ(h + h), nle)), λ m _ => H.mul(H, p).HasReal(x.npow(m)), sq),
    }
}

theorem Interval::pow_sq_has_real(I: Interval, fuel, p: Nat, {x: CReal}, hx: I.HasReal(x)): (n: Nat) → I.pow_sq(n, fuel, p).HasReal(x.npow(n)) {
    match fuel {
        Zero => λ n => Interval::npow_has_real(I, n, p, hx),
        Succ(f) => λ n => match n as λ m => (match m { Zero => Interval::of_int(1), Succ(k) => Interval::pow_step(I, Succ(k), I.pow_sq(Succ(k).half(), f, p), p) }).HasReal(x.npow(m)) {
            Zero => Interval::one_has_real(),
            Succ(k) => Interval::pow_step_has_real(I, Succ(k), I.pow_sq(Succ(k).half(), f, p), p, hx, Interval::pow_sq_has_real(I, f, p, hx, Succ(k).half())),
        },
    }
}

theorem Interval::pow_has_real(I: Interval, n, p: Nat, {x: CReal}, h: I.HasReal(x)): I.pow(n, p).HasReal(x.npow(n)) { Interval::pow_sq_has_real(I, n, p, h, n) }

// ---------------------------------------------------------------------------
// A real's enclosure from its terms. `span(lo, hi, p)` rounds a rational
// pair outward; its containment needs only `lo <= x <= hi` at `CReal`.

fn Interval::span(lo, hi: Rat, p: Nat) → Interval {
    match Interval::of_rat(lo, p) { Bnd(a, _) => match Interval::of_rat(hi, p) { Bnd(_, d) => Bnd(a, d), Whole => Whole }, Whole => Whole }
}

theorem Interval::span_has_real({lo, hi: Rat}, p: Nat, {x: CReal}, hl: CReal::ofRat(lo) <= x, hh: x <= CReal::ofRat(hi)): Interval::span(lo, hi, p).HasReal(x) {
    match Interval::of_rat(lo, p) as λ K => K.Has(lo) →
            (match K { Bnd(a, _) => match Interval::of_rat(hi, p) { Bnd(_, d) => Bnd(a, d), Whole => Whole }, Whole => Whole }).HasReal(x) {
        Bnd(a, _) => λ k => match Interval::of_rat(hi, p) as λ L => L.Has(hi) → (match L { Bnd(_, d) => Bnd(a, d), Whole => Whole }).HasReal(x) {
            Bnd(_, _) => λ l => And(CReal::le_trans(CReal::ofRat_le(k.left), hl), CReal::le_trans(hh, CReal::ofRat_le(l.right))),
            Whole => λ _ => trivial,
        }(Interval::of_rat_has(hi, p)),
        Whole => λ _ => trivial,
    }(Interval::of_rat_has(lo, p))
}

fn CReal::enclose(self x: CReal, n, p: Nat) → Interval { Interval::span(x.seq(n) - Rat::inv_succ(n), x.seq(n) + Rat::inv_succ(n), p) }

theorem CReal::enclose_has(self x: CReal, n, p: Nat): x.enclose(n, p).HasReal(x) { Interval::span_has_real(p, x.term_sub_le(n), x.le_term_add(n)) }

// ---------------------------------------------------------------------------
// Verdicts at `CReal`.

theorem Interval::lt_of_below_real(I, J: Interval, {x, y: CReal}, hx: I.HasReal(x), hy: J.HasReal(y), h: I.below(J).IsTrue()): x < y {
    match I as λ K => K.HasReal(x) → K.below(J).IsTrue() → x < y {
        Bnd(a, b) => λ kx => match J as λ L => L.HasReal(y) → Bnd(a, b).below(L).IsTrue() → x < y {
            Bnd(c, _) => λ ky v => CReal::lt_of_le_of_lt(kx.right, CReal::lt_of_lt_of_le(Dyadic::real_lt(b.lt_of_lt_bool(c, v)), ky.left)),
            Whole => λ _ no => false_elim(no),
        }(hy),
        Whole => λ _ no => false_elim(no),
    }(hx, h)
}

theorem Interval::le_of_below_eq_real(I, J: Interval, {x, y: CReal}, hx: I.HasReal(x), hy: J.HasReal(y), h: I.below_eq(J).IsTrue()): x <= y {
    match I as λ K => K.HasReal(x) → K.below_eq(J).IsTrue() → x <= y {
        Bnd(a, b) => λ kx => match J as λ L => L.HasReal(y) → Bnd(a, b).below_eq(L).IsTrue() → x <= y {
            Bnd(c, _) => λ ky v => CReal::le_trans(kx.right, CReal::le_trans(Dyadic::real_le(b.le_of_le_bool(c, v)), ky.left)),
            Whole => λ _ no => false_elim(no),
        }(hy),
        Whole => λ _ no => false_elim(no),
    }(hx, h)
}

theorem CReal::lt_of_enclose(self x, y: CReal, n, p: Nat, h: x.enclose(n, p).below(y.enclose(n, p)) = True): x < y {
    Interval::lt_of_below_real(x.enclose(n, p), y.enclose(n, p), x.enclose_has(n, p), y.enclose_has(n, p), j(sym(h), λ w _ => w.IsTrue(), trivial))
}

theorem CReal::le_of_enclose(self x, y: CReal, n, p: Nat, h: x.enclose(n, p).below_eq(y.enclose(n, p)) = True): x <= y {
    Interval::le_of_below_eq_real(x.enclose(n, p), y.enclose(n, p), x.enclose_has(n, p), y.enclose_has(n, p), j(sym(h), λ w _ => w.IsTrue(), trivial))
}

// ---------------------------------------------------------------------------
// The checker at `CReal`. A `RealExpr` names a real expression whose leaves
// are rationals (enclosed exactly, as `IntervalExpr`'s are) or reals
// (enclosed from their terms at index `n`). `eval` spells each node as the
// operation itself, so `a.eval() < b.eval()` converts to the goal written
// directly.

inductive RealExpr { RRat(q: Rat), RReal(x: CReal), RAdd(a: RealExpr, b: RealExpr), RSub(a: RealExpr, b: RealExpr), RNeg(a: RealExpr), RMul(a: RealExpr, b: RealExpr), RPow(a: RealExpr, n: Nat) }

fn RealExpr::eval(self e: RealExpr) → CReal {
    match e {
        RRat(q) => CReal::ofRat(q),
        RReal(x) => x,
        RAdd(a, b) => a.eval() + b.eval(),
        RSub(a, b) => a.eval() - b.eval(),
        RNeg(a) => -a.eval(),
        RMul(a, b) => a.eval() * b.eval(),
        RPow(a, k) => a.eval().npow(k),
    }
}

fn RealExpr::enclose(self e: RealExpr, n, p: Nat) → Interval {
    match e {
        RRat(q) => Interval::of_rat(q, p),
        RReal(x) => x.enclose(n, p),
        RAdd(a, b) => a.enclose(n, p).add(b.enclose(n, p), p),
        RSub(a, b) => a.enclose(n, p).sub(b.enclose(n, p), p),
        RNeg(a) => a.enclose(n, p).neg(),
        RMul(a, b) => a.enclose(n, p).mul(b.enclose(n, p), p),
        RPow(a, k) => a.enclose(n, p).pow(k, p),
    }
}

theorem RealExpr::enclose_has(self e: RealExpr, n, p: Nat): e.enclose(n, p).HasReal(e.eval()) {
    match e as λ f => f.enclose(n, p).HasReal(f.eval()) {
        RRat(q) => Interval::of_rat_has_real(q, p),
        RReal(x) => x.enclose_has(n, p),
        RAdd(a, b) => Interval::add_has_real(a.enclose(n, p), b.enclose(n, p), p, a.enclose_has(n, p), b.enclose_has(n, p)),
        RSub(a, b) => Interval::sub_has_real(a.enclose(n, p), b.enclose(n, p), p, a.enclose_has(n, p), b.enclose_has(n, p)),
        RNeg(a) => Interval::neg_has_real(a.enclose(n, p), a.enclose_has(n, p)),
        RMul(a, b) => Interval::mul_has_real(a.enclose(n, p), b.enclose(n, p), p, a.enclose_has(n, p), b.enclose_has(n, p)),
        RPow(a, k) => Interval::pow_has_real(a.enclose(n, p), k, p, a.enclose_has(n, p)),
    }
}

// Try index `n` at `p` bits; on a miss read twice as far out, one bit finer,
// `tries` times. A term's distance to its real halves with each step, and
// the extra bit keeps the rounding below it.
fn RealExpr::lt_search(self a, b: RealExpr, n, p, tries: Nat) → Bool {
    match tries { Zero => False, Succ(t) => match a.enclose(n, p).below(b.enclose(n, p)) { True => True, False => a.lt_search(b, n + n + 1, Succ(p), t) } }
}

fn RealExpr::le_search(self a, b: RealExpr, n, p, tries: Nat) → Bool {
    match tries { Zero => False, Succ(t) => match a.enclose(n, p).below_eq(b.enclose(n, p)) { True => True, False => a.le_search(b, n + n + 1, Succ(p), t) } }
}

theorem RealExpr::lt_of_search_from(self a, b: RealExpr, tries: Nat): (n, p: Nat) → a.lt_search(b, n, p, tries).IsTrue() → a.eval() < b.eval() {
    match tries {
        Zero => λ n p no => false_elim(no),
        Succ(t) => λ n p => match a.enclose(n, p).below(b.enclose(n, p)) as λ v => a.enclose(n, p).below(b.enclose(n, p)) = v →
                Bool::IsTrue(match v { True => True, False => a.lt_search(b, n + n + 1, Succ(p), t) }) → a.eval() < b.eval() {
            True => λ e _ => Interval::lt_of_below_real(a.enclose(n, p), b.enclose(n, p), a.enclose_has(n, p), b.enclose_has(n, p), j(sym(e), λ w _ => w.IsTrue(), trivial)),
            False => λ _ v => RealExpr::lt_of_search_from(a, b, t, n + n + 1, Succ(p), v),
        }(refl),
    }
}

theorem RealExpr::le_of_search_from(self a, b: RealExpr, tries: Nat): (n, p: Nat) → a.le_search(b, n, p, tries).IsTrue() → a.eval() <= b.eval() {
    match tries {
        Zero => λ n p no => false_elim(no),
        Succ(t) => λ n p => match a.enclose(n, p).below_eq(b.enclose(n, p)) as λ v => a.enclose(n, p).below_eq(b.enclose(n, p)) = v →
                Bool::IsTrue(match v { True => True, False => a.le_search(b, n + n + 1, Succ(p), t) }) → a.eval() <= b.eval() {
            True => λ e _ => Interval::le_of_below_eq_real(a.enclose(n, p), b.enclose(n, p), a.enclose_has(n, p), b.enclose_has(n, p), j(sym(e), λ w _ => w.IsTrue(), trivial)),
            False => λ _ v => RealExpr::le_of_search_from(a, b, t, n + n + 1, Succ(p), v),
        }(refl),
    }
}

theorem RealExpr::lt_of_search(self a, b: RealExpr, n, p, tries: Nat, h: a.lt_search(b, n, p, tries) = True): a.eval() < b.eval() {
    a.lt_of_search_from(b, tries, n, p, j(sym(h), λ w _ => w.IsTrue(), trivial))
}

theorem RealExpr::le_of_search(self a, b: RealExpr, n, p, tries: Nat, h: a.le_search(b, n, p, tries) = True): a.eval() <= b.eval() {
    a.le_of_search_from(b, tries, n, p, j(sym(h), λ w _ => w.IsTrue(), trivial))
}

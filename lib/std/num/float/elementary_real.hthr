// exp, sin and cos at real arguments, with their laws
// (issues/elementary-functions-at-reals.md).
//
// `CReal::exp(x)` is `CReal::exp_rat` extended by its Lipschitz bound on
// bounded sets (`RatLip::ext`, creal_lipschitz.hthr; the bound is
// `CReal::exp_rat_lip`, exp_law.hthr). Every law here reads the rational one
// at the terms of the arguments and closes the gap by a slack: a real within
// 2^-j of its j-th term has its exp within lip·2^-j of that term's
// (`RatLip::ext_dev`), and lip·2^-j falls below any 2^-m.
//
// - `exp_ofRat`: at a rational it is `exp_rat`;
// - `exp_add`: exp(x + y) ≈ exp(x)·exp(y), from the rational law and two
//   products bounded on bounded sets (`CReal::mul_dev`);
// - `exp_le`, `exp_lt`: increasing, strictly, and `exp_pos`;
// - `exp_dev`: the Lipschitz bound itself, between a real and a rational;
// - `exp_real_box`: the checker's leaf, the enclosures of exp at the two
//   ends of the argument's enclosure (`CReal::enclose`), which monotonicity
//   puts around exp(x). `by intervals()` reads `CReal::exp(x)` through it.
//
// sin and cos are `sin_rat`, `cos_rat` extended the same way, with one
// modulus `CReal::trig_lip` (trig_law.hthr): `sin_add`, `cos_add`,
// `sin_neg`, `cos_neg`, `sin_sq_add_cos_sq`, and the leaves `sin_real_box`,
// `cos_real_box`, which halve the argument below 1, pad the enclosure at
// its n-th term by the Lipschitz bound over the 2^-n to it, and double
// back by the addition laws (argument reduction, below).

import logic;
import bool;
import nat;
import int;
import relation_props;
import algebra;
import algebra_rel;
import order;
import ordered_field;
import semiring;
import rat;
import creal;
import creal_lipschitz;
import dyadic;
import interval;
import creal_interval;
import series;
import elementary;
import exp_law;
import trig_law;
import omega;
import tactic;
import linarith;
import ring;

fn CReal::exp_lipschitz() → RatLip {
    RatLip(λ q => CReal::exp_rat(q), λ B => CReal::exp_lip(B), λ B => CReal::exp_lip_nonneg(B), λ B a b ha hb => CReal::exp_rat_lip(B, a, b, ha, hb))
}

fn CReal::exp(self x: CReal) → CReal { CReal::exp_lipschitz().ext(x) }

theorem CReal::exp_ofRat(q: Rat): CReal::exp(CReal::ofRat(q)) ≈ CReal::exp_rat(q) { CReal::exp_lipschitz().ext_ofRat(q) }

theorem CReal::exp_respects({x, y: CReal}, h: x ≈ y): CReal::exp(x) ≈ CReal::exp(y) { CReal::exp_lipschitz().ext_respects(h) }

theorem CReal::exp_zero(): CReal::exp(0) ≈ 1 { CReal::same_trans(CReal::exp_ofRat(0), CReal::exp_rat_zero()) }

// The Lipschitz bound between a real and a rational inside `B`.
theorem CReal::exp_dev(x: CReal, q, e, B: Rat, hx: (i: Nat) → x.at(i).abs() <= B, hq: q.abs() <= B,
    lo: CReal::ofRat(q - e) <= x, hi: x <= CReal::ofRat(q + e)):
    CReal::ofRat(-(CReal::exp_lip(B) * e)) <= CReal::exp(x) - CReal::exp_rat(q) ∧ CReal::exp(x) - CReal::exp_rat(q) <= CReal::ofRat(CReal::exp_lip(B) * e)
{
    CReal::exp_lipschitz().ext_dev(x, q, e, B, hx, hq, lo, hi)
}

// ---------------------------------------------------------------------------
// Monotonicity and positivity.

theorem CReal::exp_le({x, y: CReal}, h: x <= y): CReal::exp(x) <= CReal::exp(y) {
    let B = x.bound_rat() + y.bound_rat() + 2;
    let L = CReal::exp_lip(B);
    let hL = CReal::exp_lip_nonneg(B);
    let rx = x.bound_rat_nonneg();
    let ry = y.bound_rat_nonneg();
    let hx = λ (i: Nat) => {
        let r: (x.at(i).abs() <= B) = linarith(x.bound_le(i), ry);
        r
    };
    let hy = λ (i: Nat) => {
        let r: (y.at(i).abs() <= B) = linarith(y.bound_le(i), rx);
        r
    };
    CReal::le_of_slack(λ m => {
        let j = (m + 2) + L.abs_ceil().width();
        let g = Rat::inv_pow2(j);
        let p = x.at(j);
        let q = y.at(j);
        let g1: (g <= 1) = Rat::inv_pow2_le_one(j);
        let g0: (0 <= g) = Rat::inv_pow2_nonneg(j);
        let xl: (CReal::ofRat(p - g) <= x) = x.term_sub_le(j);
        let xh: (x <= CReal::ofRat(p + g)) = x.le_term_add(j);
        let yl: (CReal::ofRat(q - g) <= y) = y.term_sub_le(j);
        let yh: (y <= CReal::ofRat(q + g)) = y.le_term_add(j);
        let pq0: (p - g <= q + g) = CReal::le_of_ofRat_le(CReal::le_trans(xl, CReal::le_trans(h, yh)));
        let pq: (p <= q + (g + g)) = linarith(pq0);
        let dx = CReal::exp_dev(x, p, g, B, hx, hx(j), xl, xh);
        let dy = CReal::exp_dev(y, q, g, B, hy, hy(j), yl, yh);
        let mono: (CReal::exp_rat(p) <= CReal::exp_rat(q + (g + g))) = CReal::exp_rat_le(pq);
        let qb: (q.abs() <= y.bound_rat()) = y.bound_le(j);
        let hq2: ((q + (g + g)).abs() <= B) = Rat::abs_le(linarith(qb, q.neg_le_abs(), g0, rx), linarith(qb, q.le_abs(), g1, rx));
        let d2: (((q + (g + g)) - q).abs() <= g + g) = Rat::abs_le(linarith(g0), linarith(g0));
        let lip = CReal::exp_rat_lip(B, q + (g + g), q, hq2, hy(j));
        let sc: (L * ((q + (g + g)) - q).abs() <= L * (g + g)) = Rat::mul_le_mono_l(d2, hL);
        let s: (L * g <= Rat::inv_pow2(m + 2)) = RatLip::scaled(L, hL, m + 2, j, omega);
        let h1 = Rat::inv_pow2_half(m + 1);
        let h0 = Rat::inv_pow2_half(m);
        let tot: (L * g + L * (g + g) + L * g <= Rat::inv_pow2(m)) = linarith(s, h1, h0, Rat::inv_pow2_pos(m + 2));
        let r: (CReal::exp(x) <= CReal::exp(y) + CReal::ofRat(Rat::inv_pow2(m))) =
            linarith(dx.right, dy.left, mono, lip.right, CReal::ofRat_le(sc), CReal::ofRat_le(tot));
        r
    })
}

theorem CReal::exp_lt({x, y: CReal}, h: x < y): CReal::exp(x) < CReal::exp(y) {
    match CReal::rat_between(h) {
        Exists(p, hp) => match CReal::rat_between(hp.right) {
            Exists(q, hq) => {
                let pq: (p < q) = CReal::lt_of_ofRat_lt(hq.left);
                let a: (CReal::exp(x) <= CReal::exp(CReal::ofRat(p))) = CReal::exp_le(CReal::le_of_lt(hp.left));
                let b: (CReal::exp(CReal::ofRat(q)) <= CReal::exp(y)) = CReal::exp_le(CReal::le_of_lt(hq.right));
                let c: (CReal::exp_rat(p) < CReal::exp_rat(q)) = CReal::exp_rat_lt(pq);
                let c2: (CReal::exp(CReal::ofRat(p)) < CReal::exp(CReal::ofRat(q))) =
                    CReal::lt_respects(CReal::same_sym(CReal::exp_ofRat(p)), CReal::same_sym(CReal::exp_ofRat(q)), c);
                CReal::lt_of_le_of_lt(a, CReal::lt_of_lt_of_le(c2, b))
            },
        },
    }
}

theorem CReal::exp_pos(self x: CReal): 0 < CReal::exp(x) {
    let q = x.at(0) - Rat::inv_pow2(0);
    let below: (CReal::exp(CReal::ofRat(q)) <= CReal::exp(x)) = CReal::exp_le(x.term_sub_le(0));
    let pos: (0 < CReal::exp(CReal::ofRat(q))) = CReal::lt_of_lt_of_le(CReal::exp_rat_pos(q), CReal::le_of_same(CReal::same_sym(CReal::exp_ofRat(q))));
    CReal::lt_of_lt_of_le(pos, below)
}

// ---------------------------------------------------------------------------
// The addition law. With p, q the j-th terms of x, y and g = 2^-j:
//
//     exp(x)exp(y) - exp(p)exp(q) = (exp(x) - exp(p))·exp(y) + (exp(y) - exp(q))·exp(p)
//
// each factor in brackets within L·g, exp(y) within K + L and exp(p)
// within K (`CReal::exp_rat_bound`), and exp(x + y) within 2L·g of
// exp(p + q) = exp(p)exp(q).

// The law at one index `j`, whose slack C·2^-j is below 2^-m.
theorem CReal::exp_add_at(x, y: CReal, B: Rat, hB: 0 <= B, hx: (i: Nat) → x.at(i).abs() <= B, hy: (i: Nat) → y.at(i).abs() <= B,
    hs: (i: Nat) → (x + y).at(i).abs() <= B, hpq: (j: Nat) → (x.at(j) + y.at(j)).abs() <= B, m, j: Nat,
    sc: (CReal::exp_lip(B) * ((1 + 1) + (CReal::exp_reach(B) + CReal::exp_lip(B)) + CReal::exp_reach(B))) * Rat::inv_pow2(j) <= Rat::inv_pow2(m)):
    CReal::exp(x + y) <= CReal::exp(x) * CReal::exp(y) + CReal::ofRat(Rat::inv_pow2(m)) ∧ CReal::exp(x) * CReal::exp(y) <= CReal::exp(x + y) + CReal::ofRat(Rat::inv_pow2(m))
{
    let s = x + y;
    let L = CReal::exp_lip(B);
    let hL = CReal::exp_lip_nonneg(B);
    let K = CReal::exp_reach(B);
    let hK: (0 <= K) = CReal::exp_reach_nonneg(B, hB);
    let g = Rat::inv_pow2(j);
    let p = x.at(j);
    let q = y.at(j);
    let g1: (g <= 1) = Rat::inv_pow2_le_one(j);
    let g0: (0 <= g) = Rat::inv_pow2_nonneg(j);
    let xl: (CReal::ofRat(p - g) <= x) = x.term_sub_le(j);
    let xh: (x <= CReal::ofRat(p + g)) = x.le_term_add(j);
    let yl: (CReal::ofRat(q - g) <= y) = y.term_sub_le(j);
    let yh: (y <= CReal::ofRat(q + g)) = y.le_term_add(j);
    let sl: (CReal::ofRat((p + q) - (g + g)) <= s) = linarith(xl, yl);
    let sh: (s <= CReal::ofRat((p + q) + (g + g))) = linarith(xh, yh);
    let dx = CReal::exp_dev(x, p, g, B, hx, hx(j), xl, xh);
    let dy = CReal::exp_dev(y, q, g, B, hy, hy(j), yl, yh);
    let ds = CReal::exp_dev(s, p + q, g + g, B, hs, hpq(j), sl, sh);
    let law = CReal::exp_rat_add(p, q);
    let bp = CReal::exp_rat_bound(p, B, hx(j));
    let bq = CReal::exp_rat_bound(q, B, hy(j));
    let Lg: (L * g <= L) = Rat::le_trans(Rat::mul_le_mono_l(g1, hL), Rat::le_of_same(L.mul_one()));
    let ey_lo: (CReal::ofRat(-(K + L)) <= CReal::exp(y)) = linarith(dy.left, bq.left, CReal::ofRat_le(Lg));
    let ey_hi: (CReal::exp(y) <= CReal::ofRat(K + L)) = linarith(dy.right, bq.right, CReal::ofRat_le(Lg));
    let e0: (0 <= L * g) = Rat::mul_nonneg(hL, g0);
    let m1 = CReal::mul_dev(L * g, K + L, e0, dx.left, dx.right, ey_lo, ey_hi);
    let m2 = CReal::mul_dev(L * g, K, e0, dy.left, dy.right, bp.left, bp.right);
    let tot: (L * (g + g) + (L * g) * (K + L) + (L * g) * K <= Rat::inv_pow2(m)) = linarith(sc);
    let ex = CReal::exp(x);
    let ey = CReal::exp(y);
    let up: (CReal::exp(s) <= ex * ey + CReal::ofRat(Rat::inv_pow2(m))) = linarith(ds.right, law, m1.left, m2.left, CReal::ofRat_le(tot));
    let dn: (ex * ey <= CReal::exp(s) + CReal::ofRat(Rat::inv_pow2(m))) = linarith(ds.left, law, m1.right, m2.right, CReal::ofRat_le(tot));
    And(up, dn)
}

theorem CReal::exp_add(self x, y: CReal): CReal::exp(x + y) ≈ CReal::exp(x) * CReal::exp(y) {
    let s = x + y;
    let B = x.bound_rat() + y.bound_rat() + s.bound_rat();
    let L = CReal::exp_lip(B);
    let hL = CReal::exp_lip_nonneg(B);
    let K = CReal::exp_reach(B);
    let rx = x.bound_rat_nonneg();
    let ry = y.bound_rat_nonneg();
    let rs = s.bound_rat_nonneg();
    let hB: (0 <= B) = linarith(rx, ry, rs);
    let hK: (0 <= K) = CReal::exp_reach_nonneg(B, hB);
    let C = L * ((1 + 1) + (K + L) + K);
    let hC: (0 <= C) = Rat::mul_nonneg(hL, linarith(hK, hL));
    let hx = λ (i: Nat) => {
        let r: (x.at(i).abs() <= B) = linarith(x.bound_le(i), ry, rs);
        r
    };
    let hy = λ (i: Nat) => {
        let r: (y.at(i).abs() <= B) = linarith(y.bound_le(i), rx, rs);
        r
    };
    let hs = λ (i: Nat) => {
        let r: (s.at(i).abs() <= B) = linarith(s.bound_le(i), rx, ry);
        r
    };
    let hpq = λ (j: Nat) => {
        let p = x.at(j);
        let q = y.at(j);
        let r: ((p + q).abs() <= B) = Rat::abs_le(linarith(x.bound_le(j), y.bound_le(j), p.neg_le_abs(), q.neg_le_abs(), rs),
            linarith(x.bound_le(j), y.bound_le(j), p.le_abs(), q.le_abs(), rs));
        r
    };
    let near = λ (m: Nat) => CReal::exp_add_at(x, y, B, hB, hx, hy, hs, hpq, m, m + C.abs_ceil().width(), RatLip::scaled(C, hC, m, m + C.abs_ceil().width(), omega));
    CReal::le_antisymm(CReal::le_of_slack(λ m => near(m).left), CReal::le_of_slack(λ m => near(m).right))
}

theorem CReal::exp_neg_mul(self x: CReal): CReal::exp(-x) * CReal::exp(x) ≈ 1 {
    let z: (-x + x ≈ 0) = x.neg_add_self();
    CReal::same_trans(CReal::same_sym(CReal::exp_add(-x, x)), CReal::same_trans(CReal::exp_respects(z), CReal::exp_zero()))
}

// ---------------------------------------------------------------------------
// The checker's leaf: exp is increasing, so exp at the two ends of the
// argument's n-th enclosure, each enclosed at `p` bits, holds exp(x).

fn Interval::span(I, J: Interval) → Interval {
    match I { Bnd(a, _) => match J { Bnd(_, d) => Bnd(a, d), Whole => Whole }, Whole => Whole }
}

theorem Interval::span_has(I, J: Interval, {u, v, z: CReal}, hu: I.HasReal(u), hv: J.HasReal(v), uz: u <= z, zv: z <= v): Interval::span(I, J).HasReal(z) {
    match I as λ K => K.HasReal(u) → Interval::span(K, J).HasReal(z) {
        Bnd(a, b) => λ ku => match J as λ M => M.HasReal(v) → Interval::span(Bnd(a, b), M).HasReal(z) {
            Bnd(_, _) => λ kv => And(CReal::le_trans(ku.left, uz), CReal::le_trans(zv, kv.right)),
            Whole => λ _ => trivial,
        }(hv),
        Whole => λ _ => trivial,
    }(hu)
}

fn CReal::exp_enclose(self x: CReal, n, p: Nat) → Interval {
    Interval::span((CReal::exp_box((x.seq(n) - CReal::radius(n)).rat())).at(n, p), (CReal::exp_box((x.seq(n) + CReal::radius(n)).rat())).at(n, p))
}

theorem CReal::exp_enclose_has(self x: CReal, n, p: Nat): x.exp_enclose(n, p).HasReal(CReal::exp(x)) {
    let lo = (x.seq(n) - CReal::radius(n)).rat();
    let hi = (x.seq(n) + CReal::radius(n)).rat();
    let e = x.enclose_has(n);
    let a: (CReal::exp_rat(lo) <= CReal::exp(x)) = CReal::le_trans(CReal::le_of_same(CReal::same_sym(CReal::exp_ofRat(lo))), CReal::exp_le(e.left));
    let b: (CReal::exp(x) <= CReal::exp_rat(hi)) = CReal::le_trans(CReal::exp_le(e.right), CReal::le_of_same(CReal::exp_ofRat(hi)));
    Interval::span_has((CReal::exp_box(lo)).at(n, p), (CReal::exp_box(hi)).at(n, p), (CReal::exp_box(lo)).has(n, p), (CReal::exp_box(hi)).has(n, p), a, b)
}

fn CReal::exp_real_box(x: CReal) → Enclosed { Enclosed(CReal::exp(x), λ n p => x.exp_enclose(n, p), λ n p => x.exp_enclose_has(n, p)) }

// ---------------------------------------------------------------------------
// sin and cos at real arguments: `CReal::sin_rat` and `CReal::cos_rat`
// extended by their shared Lipschitz bound (`CReal::trig_lip`,
// trig_law.hthr), with the addition laws, parity and sin² + cos² = 1.

fn CReal::sin_lipschitz() → RatLip {
    RatLip(λ q => CReal::sin_rat(q), λ B => CReal::trig_lip(B), λ B => CReal::trig_lip_nonneg(B), λ B a b ha hb => CReal::sin_rat_lip(B, a, b, ha, hb))
}

fn CReal::cos_lipschitz() → RatLip {
    RatLip(λ q => CReal::cos_rat(q), λ B => CReal::trig_lip(B), λ B => CReal::trig_lip_nonneg(B), λ B a b ha hb => CReal::cos_rat_lip(B, a, b, ha, hb))
}

fn CReal::sin(self x: CReal) → CReal { CReal::sin_lipschitz().ext(x) }

fn CReal::cos(self x: CReal) → CReal { CReal::cos_lipschitz().ext(x) }

theorem CReal::sin_ofRat(q: Rat): CReal::sin(CReal::ofRat(q)) ≈ CReal::sin_rat(q) { CReal::sin_lipschitz().ext_ofRat(q) }

theorem CReal::cos_ofRat(q: Rat): CReal::cos(CReal::ofRat(q)) ≈ CReal::cos_rat(q) { CReal::cos_lipschitz().ext_ofRat(q) }

theorem CReal::sin_respects({x, y: CReal}, h: x ≈ y): CReal::sin(x) ≈ CReal::sin(y) { CReal::sin_lipschitz().ext_respects(h) }

theorem CReal::cos_respects({x, y: CReal}, h: x ≈ y): CReal::cos(x) ≈ CReal::cos(y) { CReal::cos_lipschitz().ext_respects(h) }

theorem CReal::sin_zero(): CReal::sin(0) ≈ 0 { CReal::same_trans(CReal::sin_ofRat(0), CReal::sin_rat_zero()) }

theorem CReal::cos_zero(): CReal::cos(0) ≈ 1 { CReal::same_trans(CReal::cos_ofRat(0), CReal::cos_rat_zero()) }

theorem CReal::sin_neg(self x: CReal): CReal::sin(-x) ≈ -CReal::sin(x) { CReal::sin_lipschitz().ext_odd(λ q => CReal::sin_rat_neg(q), x) }

theorem CReal::cos_neg(self x: CReal): CReal::cos(-x) ≈ CReal::cos(x) { CReal::cos_lipschitz().ext_even(λ q => CReal::cos_rat_neg(q), x) }

theorem CReal::sin_dev(x: CReal, q, e, B: Rat, hx: (i: Nat) → x.at(i).abs() <= B, hq: q.abs() <= B,
    lo: CReal::ofRat(q - e) <= x, hi: x <= CReal::ofRat(q + e)):
    CReal::ofRat(-(CReal::trig_lip(B) * e)) <= CReal::sin(x) - CReal::sin_rat(q) ∧ CReal::sin(x) - CReal::sin_rat(q) <= CReal::ofRat(CReal::trig_lip(B) * e)
{
    CReal::sin_lipschitz().ext_dev(x, q, e, B, hx, hq, lo, hi)
}

theorem CReal::cos_dev(x: CReal, q, e, B: Rat, hx: (i: Nat) → x.at(i).abs() <= B, hq: q.abs() <= B,
    lo: CReal::ofRat(q - e) <= x, hi: x <= CReal::ofRat(q + e)):
    CReal::ofRat(-(CReal::trig_lip(B) * e)) <= CReal::cos(x) - CReal::cos_rat(q) ∧ CReal::cos(x) - CReal::cos_rat(q) <= CReal::ofRat(CReal::trig_lip(B) * e)
{
    CReal::cos_lipschitz().ext_dev(x, q, e, B, hx, hq, lo, hi)
}

// The addition laws, as exp's: with p, q the j-th terms of x, y and
// g = 2^-j, each product's change splits into two, e.g.
//
//     sin(x)cos(y) - sin(p)cos(q) = (sin(x) - sin(p))·cos(y) + (cos(y) - cos(q))·sin(p)
//
// with each bracket within L·g and each other factor bounded on the ball
// (`CReal::sin_rat_bound`, `CReal::cos_rat_bound`).

theorem CReal::trig_add_at(x, y: CReal, B: Rat, hx: (i: Nat) → x.at(i).abs() <= B, hy: (i: Nat) → y.at(i).abs() <= B,
    hs: (i: Nat) → (x + y).at(i).abs() <= B, hpq: (j: Nat) → (x.at(j) + y.at(j)).abs() <= B, m, j: Nat,
    sc: (CReal::trig_lip(B) * ((1 + 1) + (CReal::cos_reach(B) + CReal::trig_lip(B)) + CReal::sin_reach(B) + (CReal::sin_reach(B) + CReal::trig_lip(B)) + CReal::cos_reach(B))) * Rat::inv_pow2(j) <= Rat::inv_pow2(m)):
    (CReal::sin(x + y) <= CReal::sin(x) * CReal::cos(y) + CReal::cos(x) * CReal::sin(y) + CReal::ofRat(Rat::inv_pow2(m))
        ∧ CReal::sin(x) * CReal::cos(y) + CReal::cos(x) * CReal::sin(y) <= CReal::sin(x + y) + CReal::ofRat(Rat::inv_pow2(m)))
    ∧ (CReal::cos(x + y) <= CReal::cos(x) * CReal::cos(y) - CReal::sin(x) * CReal::sin(y) + CReal::ofRat(Rat::inv_pow2(m))
        ∧ CReal::cos(x) * CReal::cos(y) - CReal::sin(x) * CReal::sin(y) <= CReal::cos(x + y) + CReal::ofRat(Rat::inv_pow2(m)))
{
    let s = x + y;
    let L = CReal::trig_lip(B);
    let hL = CReal::trig_lip_nonneg(B);
    let Ks = CReal::sin_reach(B);
    let Kc = CReal::cos_reach(B);
    let g = Rat::inv_pow2(j);
    let p = x.at(j);
    let q = y.at(j);
    let g1: (g <= 1) = Rat::inv_pow2_le_one(j);
    let g0: (0 <= g) = Rat::inv_pow2_nonneg(j);
    let xl: (CReal::ofRat(p - g) <= x) = x.term_sub_le(j);
    let xh: (x <= CReal::ofRat(p + g)) = x.le_term_add(j);
    let yl: (CReal::ofRat(q - g) <= y) = y.term_sub_le(j);
    let yh: (y <= CReal::ofRat(q + g)) = y.le_term_add(j);
    let sl: (CReal::ofRat((p + q) - (g + g)) <= s) = linarith(xl, yl);
    let sh: (s <= CReal::ofRat((p + q) + (g + g))) = linarith(xh, yh);
    let xs = CReal::sin_dev(x, p, g, B, hx, hx(j), xl, xh);
    let xc = CReal::cos_dev(x, p, g, B, hx, hx(j), xl, xh);
    let ys = CReal::sin_dev(y, q, g, B, hy, hy(j), yl, yh);
    let yc = CReal::cos_dev(y, q, g, B, hy, hy(j), yl, yh);
    let ss = CReal::sin_dev(s, p + q, g + g, B, hs, hpq(j), sl, sh);
    let sc2 = CReal::cos_dev(s, p + q, g + g, B, hs, hpq(j), sl, sh);
    let lawS = CReal::sin_rat_add(p, q);
    let lawC = CReal::cos_rat_add(p, q);
    let bps = CReal::sin_rat_bound(p, B, hx(j));
    let bpc = CReal::cos_rat_bound(p, B, hx(j));
    let bqs = CReal::sin_rat_bound(q, B, hy(j));
    let bqc = CReal::cos_rat_bound(q, B, hy(j));
    let Lg: (L * g <= L) = Rat::le_trans(Rat::mul_le_mono_l(g1, hL), Rat::le_of_same(L.mul_one()));
    let ycl: (CReal::ofRat(-(Kc + L)) <= CReal::cos(y)) = linarith(yc.left, bqc.left, CReal::ofRat_le(Lg));
    let ych: (CReal::cos(y) <= CReal::ofRat(Kc + L)) = linarith(yc.right, bqc.right, CReal::ofRat_le(Lg));
    let ysl: (CReal::ofRat(-(Ks + L)) <= CReal::sin(y)) = linarith(ys.left, bqs.left, CReal::ofRat_le(Lg));
    let ysh: (CReal::sin(y) <= CReal::ofRat(Ks + L)) = linarith(ys.right, bqs.right, CReal::ofRat_le(Lg));
    let e0: (0 <= L * g) = Rat::mul_nonneg(hL, g0);
    let tot: (L * (g + g) + (L * g) * (Kc + L) + (L * g) * Ks + (L * g) * (Ks + L) + (L * g) * Kc <= Rat::inv_pow2(m)) = linarith(sc);
    let sx = CReal::sin(x);
    let cx = CReal::cos(x);
    let sy = CReal::sin(y);
    let cy = CReal::cos(y);
    // sin: (sin x - sin p)·cos y, (cos y - cos q)·sin p, (cos x - cos p)·sin y, (sin y - sin q)·cos p.
    let a1 = CReal::mul_dev(L * g, Kc + L, e0, xs.left, xs.right, ycl, ych);
    let a2 = CReal::mul_dev(L * g, Ks, e0, yc.left, yc.right, bps.left, bps.right);
    let a3 = CReal::mul_dev(L * g, Ks + L, e0, xc.left, xc.right, ysl, ysh);
    let a4 = CReal::mul_dev(L * g, Kc, e0, ys.left, ys.right, bpc.left, bpc.right);
    let sup: (CReal::sin(s) <= sx * cy + cx * sy + CReal::ofRat(Rat::inv_pow2(m))) =
        linarith(ss.right, lawS, a1.left, a2.left, a3.left, a4.left, CReal::ofRat_le(tot));
    let sdn: (sx * cy + cx * sy <= CReal::sin(s) + CReal::ofRat(Rat::inv_pow2(m))) =
        linarith(ss.left, lawS, a1.right, a2.right, a3.right, a4.right, CReal::ofRat_le(tot));
    // cos: (cos x - cos p)·cos y, (cos y - cos q)·cos p, (sin x - sin p)·sin y, (sin y - sin q)·sin p.
    let b1 = CReal::mul_dev(L * g, Kc + L, e0, xc.left, xc.right, ycl, ych);
    let b2 = CReal::mul_dev(L * g, Kc, e0, yc.left, yc.right, bpc.left, bpc.right);
    let b3 = CReal::mul_dev(L * g, Ks + L, e0, xs.left, xs.right, ysl, ysh);
    let b4 = CReal::mul_dev(L * g, Ks, e0, ys.left, ys.right, bps.left, bps.right);
    let cup: (CReal::cos(s) <= cx * cy - sx * sy + CReal::ofRat(Rat::inv_pow2(m))) =
        linarith(sc2.right, lawC, b1.left, b2.left, b3.right, b4.right, CReal::ofRat_le(tot));
    let cdn: (cx * cy - sx * sy <= CReal::cos(s) + CReal::ofRat(Rat::inv_pow2(m))) =
        linarith(sc2.left, lawC, b1.right, b2.right, b3.left, b4.left, CReal::ofRat_le(tot));
    And(And(sup, sdn), And(cup, cdn))
}

// Both laws at every slack.
theorem CReal::trig_add_near(self x, y: CReal, m: Nat):
    (CReal::sin(x + y) <= CReal::sin(x) * CReal::cos(y) + CReal::cos(x) * CReal::sin(y) + CReal::ofRat(Rat::inv_pow2(m))
        ∧ CReal::sin(x) * CReal::cos(y) + CReal::cos(x) * CReal::sin(y) <= CReal::sin(x + y) + CReal::ofRat(Rat::inv_pow2(m)))
    ∧ (CReal::cos(x + y) <= CReal::cos(x) * CReal::cos(y) - CReal::sin(x) * CReal::sin(y) + CReal::ofRat(Rat::inv_pow2(m))
        ∧ CReal::cos(x) * CReal::cos(y) - CReal::sin(x) * CReal::sin(y) <= CReal::cos(x + y) + CReal::ofRat(Rat::inv_pow2(m)))
{
    let s = x + y;
    let B = x.bound_rat() + y.bound_rat() + s.bound_rat();
    let L = CReal::trig_lip(B);
    let hL = CReal::trig_lip_nonneg(B);
    let Ks = CReal::sin_reach(B);
    let Kc = CReal::cos_reach(B);
    let hKs = CReal::sin_reach_nonneg(B);
    let ec: (Kc ≈ 1 + Ks) = Rat::same_refl(Kc);
    let rx = x.bound_rat_nonneg();
    let ry = y.bound_rat_nonneg();
    let rs = s.bound_rat_nonneg();
    let C = L * ((1 + 1) + (Kc + L) + Ks + (Ks + L) + Kc);
    let hC: (0 <= C) = Rat::mul_nonneg(hL, linarith(hKs, ec, hL));
    let hx = λ (i: Nat) => {
        let r: (x.at(i).abs() <= B) = linarith(x.bound_le(i), ry, rs);
        r
    };
    let hy = λ (i: Nat) => {
        let r: (y.at(i).abs() <= B) = linarith(y.bound_le(i), rx, rs);
        r
    };
    let hs = λ (i: Nat) => {
        let r: (s.at(i).abs() <= B) = linarith(s.bound_le(i), rx, ry);
        r
    };
    let hpq = λ (j: Nat) => {
        let p = x.at(j);
        let q = y.at(j);
        let r: ((p + q).abs() <= B) = Rat::abs_le(linarith(x.bound_le(j), y.bound_le(j), p.neg_le_abs(), q.neg_le_abs(), rs),
            linarith(x.bound_le(j), y.bound_le(j), p.le_abs(), q.le_abs(), rs));
        r
    };
    CReal::trig_add_at(x, y, B, hx, hy, hs, hpq, m, m + C.abs_ceil().width(), RatLip::scaled(C, hC, m, m + C.abs_ceil().width(), omega))
}

theorem CReal::sin_add(self x, y: CReal): CReal::sin(x + y) ≈ CReal::sin(x) * CReal::cos(y) + CReal::cos(x) * CReal::sin(y) {
    CReal::le_antisymm(CReal::le_of_slack(λ m => (x.trig_add_near(y, m)).left.left), CReal::le_of_slack(λ m => (x.trig_add_near(y, m)).left.right))
}

theorem CReal::cos_add(self x, y: CReal): CReal::cos(x + y) ≈ CReal::cos(x) * CReal::cos(y) - CReal::sin(x) * CReal::sin(y) {
    CReal::le_antisymm(CReal::le_of_slack(λ m => (x.trig_add_near(y, m)).right.left), CReal::le_of_slack(λ m => (x.trig_add_near(y, m)).right.right))
}

// cos(-x + x) = cos(0) = 1, read through the addition law and parity.
theorem CReal::sin_sq_add_cos_sq(self x: CReal): CReal::sin(x) * CReal::sin(x) + CReal::cos(x) * CReal::cos(x) ≈ 1 {
    let z: (-x + x ≈ 0) = x.neg_add_self();
    let one: (CReal::cos(-x + x) ≈ 1) = CReal::same_trans(CReal::cos_respects(z), CReal::cos_zero());
    let law = CReal::cos_add(-x, x);
    let c: (CReal::cos(-x) * CReal::cos(x) ≈ CReal::cos(x) * CReal::cos(x)) = CReal::mul_respects(x.cos_neg(), CReal::same_refl(CReal::cos(x)));
    let s: (CReal::sin(-x) * CReal::sin(x) ≈ (-CReal::sin(x)) * CReal::sin(x)) = CReal::mul_respects(x.sin_neg(), CReal::same_refl(CReal::sin(x)));
    linarith(one, law, c, s)
}

// ---------------------------------------------------------------------------
// The checker's leaves for sin and cos. Neither is monotone, so the leaf is
// the enclosure at the argument's n-th term q, widened by the Lipschitz
// bound over the 2^-n between q and x, rounded up to a dyadic.

fn Interval::pad(self I: Interval, W: Dyadic) → Interval { match I { Bnd(lo, hi) => Bnd(lo - W, hi + W), Whole => Whole } }

theorem Interval::pad_has(I: Interval, W: Dyadic, w: Rat, {y, z: CReal}, hW: w <= W.rat(), hy: I.HasReal(y),
    lo: CReal::ofRat(-w) <= z - y, hi: z - y <= CReal::ofRat(w)): I.pad(W).HasReal(z)
{
    match I as λ K => K.HasReal(y) → K.pad(W).HasReal(z) {
        Bnd(a, b) => λ k => {
            let ea: (CReal::ofRat((a - W).rat()) ≈ CReal::ofRat(a.rat() - W.rat())) = CReal::ofRat_respects(a.rat_sub(W));
            let eb: (CReal::ofRat((b + W).rat()) ≈ CReal::ofRat(b.rat() + W.rat())) = CReal::ofRat_respects(b.rat_add(W));
            let hw = CReal::ofRat_le(hW);
            let l: (CReal::ofRat((a - W).rat()) <= z) = linarith(k.left, lo, ea, hw);
            let h: (z <= CReal::ofRat((b + W).rat())) = linarith(k.right, hi, eb, hw);
            And(l, h)
        },
        Whole => λ _ => trivial,
    }(hy)
}

// The pad is `trig_lip`'s 2·exp_reach(1), at most 6: a literal, so the
// leaf never evaluates exp's series for it.
theorem CReal::exp_reach_one(): CReal::exp_reach(1) <= 3 { Rat::le_of_bool(CReal::exp_reach(1), 3, refl) }

fn CReal::trig_pad(self x: CReal, n, p: Nat) → Dyadic { Dyadic(6, 0) * CReal::radius(n) }

theorem CReal::trig_pad_le(self x: CReal, n, p: Nat): CReal::trig_lip(x.bound_rat()) * Rat::inv_pow2(n) <= (x.trig_pad(n, p)).rat() {
    let B = x.bound_rat();
    let g = Rat::inv_pow2(n);
    let eL: (CReal::trig_lip(B) ≈ CReal::exp_reach(1) + CReal::exp_reach(1)) = Rat::same_refl(CReal::trig_lip(B));
    let six: ((Dyadic(6, 0)).rat() ≈ 6) = Rat::same_refl(6);
    let L: (CReal::trig_lip(B) <= (Dyadic(6, 0)).rat()) = linarith(CReal::exp_reach_one(), eL, six);
    let Lg: (CReal::trig_lip(B) * g <= (Dyadic(6, 0)).rat() * g) = Rat::mul_le_mono_r(L, Rat::inv_pow2_nonneg(n));
    let eW: ((Dyadic(6, 0) * CReal::radius(n)).rat() ≈ (Dyadic(6, 0)).rat() * g) = Rat::same_trans((Dyadic(6, 0)).rat_mul(CReal::radius(n)),
        Rat::mul_respects((Dyadic(6, 0)).rat().same_refl(), CReal::radius_rat(n)));
    Rat::le_trans(Lg, Rat::le_of_same(Rat::same_sym(eW)))
}

// The series run at the term trimmed of its trailing zero bits
// (`Dyadic::trim`): a short argument read at `2^-n` costs its own bits, not n.
fn CReal::point(self x: CReal, n: Nat) → Rat { ((x.seq(n)).trim()).rat() }

theorem CReal::point_close(self x: CReal, n: Nat):
    (x.point(n)).abs() <= x.bound_rat() ∧ CReal::ofRat(x.point(n) - Rat::inv_pow2(n)) <= x ∧ x <= CReal::ofRat(x.point(n) + Rat::inv_pow2(n))
{
    let t: (x.point(n) ≈ x.at(n)) = (x.seq(n)).trim_same();
    let g = Rat::inv_pow2(n);
    let a = Rat::le_trans(Rat::le_of_same(Rat::abs_respects(t)), x.bound_le(n));
    let t1: (x.at(n) - g ≈ x.point(n) - g) = linarith(t);
    let t2: (x.at(n) + g ≈ x.point(n) + g) = linarith(t);
    And(a, And(CReal::le_respects(CReal::ofRat_respects(t1), CReal::same_refl(x), x.term_sub_le(n)),
        CReal::le_respects(CReal::same_refl(x), CReal::ofRat_respects(t2), x.le_term_add(n))))
}

fn CReal::sin_enclose(self x: CReal, n, p: Nat) → Interval { ((CReal::sin_box(x.point(n))).at(n, p)).pad(x.trig_pad(n, p)) }

fn CReal::cos_enclose(self x: CReal, n, p: Nat) → Interval { ((CReal::cos_box(x.point(n))).at(n, p)).pad(x.trig_pad(n, p)) }

theorem CReal::sin_enclose_has(self x: CReal, n, p: Nat): x.sin_enclose(n, p).HasReal(CReal::sin(x)) {
    let B = x.bound_rat();
    let q = x.point(n);
    let c = x.point_close(n);
    let d = CReal::sin_dev(x, q, Rat::inv_pow2(n), B, λ i => x.bound_le(i), c.left, c.right.left, c.right.right);
    Interval::pad_has((CReal::sin_box(q)).at(n, p), x.trig_pad(n, p), CReal::trig_lip(B) * Rat::inv_pow2(n), x.trig_pad_le(n, p), (CReal::sin_box(q)).has(n, p), d.left, d.right)
}

theorem CReal::cos_enclose_has(self x: CReal, n, p: Nat): x.cos_enclose(n, p).HasReal(CReal::cos(x)) {
    let B = x.bound_rat();
    let q = x.point(n);
    let c = x.point_close(n);
    let d = CReal::cos_dev(x, q, Rat::inv_pow2(n), B, λ i => x.bound_le(i), c.left, c.right.left, c.right.right);
    Interval::pad_has((CReal::cos_box(q)).at(n, p), x.trig_pad(n, p), CReal::trig_lip(B) * Rat::inv_pow2(n), x.trig_pad_le(n, p), (CReal::cos_box(q)).has(n, p), d.left, d.right)
}

// ---------------------------------------------------------------------------
// Argument reduction. The series at a large argument has large terms and
// loses its bits to cancellation, and costs more steps the larger the
// argument, past what the checker's evaluation affords. So the leaves halve the
// argument k times, until it is below 1, enclose sin and cos there, and
// double back k times:
//
//     sin(y + y) ≈ sin(y)cos(y) + cos(y)sin(y)
//     cos(y + y) ≈ cos(y)cos(y) - sin(y)sin(y)
//
// which are the addition laws at y = y, so each doubling is the checker's
// own products and sums, and needs no π. A doubling at most quadruples an
// enclosure's width, so the base reads the argument 2k + 16 bits finer, at
// 2k more bits of precision. The base argument is x·2^-k, one product:
// halving k times over nests k products, whose terms cost more than the
// checker's evaluation affords.

fn CReal::scaled(self x: CReal, e: Nat) → CReal { x * CReal::ofRat(Rat::inv_pow2(e)) }

// One step finer is half: x·2^-(e+1) + x·2^-(e+1) ≈ x·2^-e.
theorem CReal::scaled_twice(self x: CReal, e: Nat): x.scaled(e + 1) + x.scaled(e + 1) ≈ x.scaled(e) {
    let h = CReal::ofRat(Rat::inv_pow2(e + 1));
    let two: (h + h ≈ CReal::ofRat(Rat::inv_pow2(e))) = CReal::same_trans(CReal::same_sym(CReal::ofRat_add(Rat::inv_pow2(e + 1), Rat::inv_pow2(e + 1))), CReal::ofRat_respects(Rat::inv_pow2_half(e)));
    let d: (x * h + x * h ≈ x * (h + h)) = CReal::same_sym(x.mul_add_distr(h, h));
    CReal::same_trans(d, CReal::mul_respects(CReal::same_refl(x), two))
}

theorem CReal::scaled_zero(self x: CReal): x.scaled(0) ≈ x {
    let o: (CReal::ofRat(Rat::inv_pow2(0)) ≈ 1) = CReal::ofRat_respects(omega);
    CReal::same_trans(CReal::mul_respects(CReal::same_refl(x), o), x.mul_one())
}

record TrigBox { s: Interval, c: Interval }

fn TrigBox::double(self b: TrigBox, p: Nat) → TrigBox {
    TrigBox(b.s.mul(b.c, p).add(b.c.mul(b.s, p), p), b.c.mul(b.c, p).sub(b.s.mul(b.s, p), p))
}

// The enclosures at x·2^-e, from m doublings of those at x·2^-(e+m): the
// argument is scaled once, at the bottom, not halved m times over.
fn CReal::trig_reduced(self x: CReal, e, m, n, p: Nat) → TrigBox {
    match m { Zero => TrigBox((x.scaled(e)).sin_enclose(n, p), (x.scaled(e)).cos_enclose(n, p)), Succ(j) => (x.trig_reduced(e + 1, j, n, p)).double(p) }
}

theorem CReal::trig_reduced_has(self x: CReal, n, p, m: Nat): (e: Nat) →
    (x.trig_reduced(e, m, n, p)).s.HasReal(CReal::sin(x.scaled(e))) ∧ (x.trig_reduced(e, m, n, p)).c.HasReal(CReal::cos(x.scaled(e)))
{
    match m {
        Zero => λ e => And((x.scaled(e)).sin_enclose_has(n, p), (x.scaled(e)).cos_enclose_has(n, p)),
        Succ(j) => λ e => {
            let y = x.scaled(e + 1);
            let b = x.trig_reduced(e + 1, j, n, p);
            let ih = x.trig_reduced_has(n, p, j, e + 1);
            let hs: ((b.double(p)).s.HasReal(CReal::sin(y) * CReal::cos(y) + CReal::cos(y) * CReal::sin(y))) =
                Interval::add_has_real(b.s.mul(b.c, p), b.c.mul(b.s, p), p, Interval::mul_has_real(b.s, b.c, p, ih.left, ih.right), Interval::mul_has_real(b.c, b.s, p, ih.right, ih.left));
            let hc: ((b.double(p)).c.HasReal(CReal::cos(y) * CReal::cos(y) - CReal::sin(y) * CReal::sin(y))) =
                Interval::sub_has_real(b.c.mul(b.c, p), b.s.mul(b.s, p), p, Interval::mul_has_real(b.c, b.c, p, ih.right, ih.right), Interval::mul_has_real(b.s, b.s, p, ih.left, ih.left));
            let t = x.scaled_twice(e);
            let es: (CReal::sin(y) * CReal::cos(y) + CReal::cos(y) * CReal::sin(y) ≈ CReal::sin(x.scaled(e))) = CReal::same_trans(CReal::same_sym(y.sin_add(y)), CReal::sin_respects(t));
            let ec: (CReal::cos(y) * CReal::cos(y) - CReal::sin(y) * CReal::sin(y) ≈ CReal::cos(x.scaled(e))) = CReal::same_trans(CReal::same_sym(y.cos_add(y)), CReal::cos_respects(t));
            And(Interval::has_real_respects((b.double(p)).s, es, hs), Interval::has_real_respects((b.double(p)).c, ec, hc))
        },
    }
}

// Halvings enough to bring the argument's bound below 1.
fn CReal::trig_steps(self x: CReal) → Nat { x.bound().width() }

fn CReal::trig_at(self x: CReal, n, p: Nat) → TrigBox {
    let k = x.trig_steps();
    x.trig_reduced(0, k, (n + (k + k)) + 16, p + (k + k))
}

theorem CReal::trig_at_has(self x: CReal, n, p: Nat): (x.trig_at(n, p)).s.HasReal(CReal::sin(x)) ∧ (x.trig_at(n, p)).c.HasReal(CReal::cos(x)) {
    let k = x.trig_steps();
    let h = x.trig_reduced_has((n + (k + k)) + 16, p + (k + k), k, 0);
    let z = x.scaled_zero();
    And(Interval::has_real_respects((x.trig_at(n, p)).s, CReal::sin_respects(z), h.left), Interval::has_real_respects((x.trig_at(n, p)).c, CReal::cos_respects(z), h.right))
}

fn CReal::sin_real_box(x: CReal) → Enclosed { Enclosed(CReal::sin(x), λ n p => (x.trig_at(n, p)).s, λ n p => (x.trig_at_has(n, p)).left) }

fn CReal::cos_real_box(x: CReal) → Enclosed { Enclosed(CReal::cos(x), λ n p => (x.trig_at(n, p)).c, λ n p => (x.trig_at_has(n, p)).right) }

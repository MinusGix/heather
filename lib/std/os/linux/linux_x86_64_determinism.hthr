// The run is the run (docs/fetched-step-determinism-design.md): a process
// claim `LinuxRuns` states that a run with the claimed events exists, and
// every run from the same state that got the same answers from Linux
// produced those events. This module holds the facts about Linux that
// make it so: a step is a function of the state's defined components
// (x86_64_step_forms), no step runs where SYSCALL is fetched, so two runs
// meet at the same syscall (`linux_steps_meet`) with the same request
// (`asks_meet`, `call_meets`); the answer is Linux's, and what Linux leaves
// in RCX, R11 and a failed call's buffer the claim already quantifies over.
// The theorem itself, `linux_runs_determine`, is `call_system`'s generic
// `CallSystem::determined` at the process (`linux_x86_64_sim`'s
// `linux_meets`).
import linux_calls;
import linux_x86_64_io;
import linux_x86_64_entry;
import x86_64;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_step_forms;
import bitvec;
import bitvec_nat;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// A run, as it happened: at each syscall, one answer and one choice of what
// Linux left behind. Where `LinuxRuns` quantifies over RCX, R11 and junk, a
// run picks them. A run's call is what its registers ask (`LinuxAsks`);
// whether Linux could write its buffers is the claim's business.

fn Resumes(next: BitVec(64) → BitVec(64) → Type) → Type {
    Exists<BitVec(64)>(λ rcx => Exists<BitVec(64)>(λ r11 => next(rcx, r11)))
}

fn LinuxResumed<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(),
    next: MachineState<M> → Type) → Type {
    Exists<List<BitVec(8)>>(λ junk => LinuxLeaves(c, a, junk) ∧
        Resumes(λ rcx r11 => next(linux_answered(io, at, c, a, junk, rcx, r11))))
}

fn LinuxRun<M>(io: LinuxIo<M>, events: List<LinuxEvent>) → MachineState<M> → Type {
    match events {
        Nil => λ state => False,
        Cons(event, rest) => λ state => Exists<MachineState<M>>(λ at =>
            LinuxSteps(io, state, at) ∧ (LinuxSyscallAt(io, at) ∧
            match event as λ _ => Type {
                CallEvent(c, a) => LinuxAsks(io, at, c) ∧ LinuxResumed(io, at, c, a, LinuxRun(io, rest)),
                ExitEvent(status) => LinuxExits(at, status) ∧ (rest = Nil),
            })),
    }
}

// Two calls got the same answer: the same kind of call, answered alike.
// Requests are not compared; they are what is proved equal.
fn SameAnswer(c: LinuxCmd<Nat>) → c.Resp() → (d: LinuxCmd<Nat>) → d.Resp() → Type {
    match c {
        ReadCmd(_, _) => λ (result: ReadResult) d => match d {
            ReadCmd(_, _) => λ (other: ReadResult) => result = other, _ => λ _ => False },
        WriteCmd(_, _) => λ (result: WriteResult) d => match d {
            WriteCmd(_, _) => λ (other: WriteResult) => result = other, _ => λ _ => False },
        OpenCmd(_) => λ (result: OpenResult) d => match d {
            OpenCmd(_) => λ (other: OpenResult) => result = other, _ => λ _ => False },
        CloseCmd(_) => λ (result: CloseResult) d => match d {
            CloseCmd(_) => λ (other: CloseResult) => result = other, _ => λ _ => False },
        StatCmd(_) => λ (result: StatResult) d => match d {
            StatCmd(_) => λ (other: StatResult) => result = other, _ => λ _ => False },
    }
}

// Two event lists got the same answers: event by event, the same kind with
// the same answer.
fn SameResponse(claim, run: LinuxEvent) → Type {
    match claim {
        CallEvent(c, a) => match run { CallEvent(d, b) => SameAnswer(c, a, d, b), ExitEvent(_) => False },
        ExitEvent(_) => match run { ExitEvent(_) => True, CallEvent(_, _) => False },
    }
}
fn SameResponses(claim: List<LinuxEvent>) → List<LinuxEvent> → Type {
    match claim {
        Nil => λ run => run.is_nil(),
        Cons(event, rest) => λ run => match run {
            Nil => False,
            Cons(other, more) => SameResponse(event, other) ∧ SameResponses(rest, more),
        },
    }
}

theorem same_answer_refl(c: LinuxCmd<Nat>): (a: c.Resp()) → SameAnswer(c, a, c, a) {
    match c {
        ReadCmd(_, _) => λ _ => refl, WriteCmd(_, _) => λ _ => refl, OpenCmd(_) => λ _ => refl,
        CloseCmd(_) => λ _ => refl, StatCmd(_) => λ _ => refl,
    }
}
theorem same_response_refl(event: LinuxEvent): SameResponse(event, event) {
    match event { CallEvent(c, a) => same_answer_refl(c, a), ExitEvent(_) => trivial }
}
theorem same_responses_refl(events: List<LinuxEvent>): SameResponses(events, events) {
    match events {
        Nil => trivial,
        Cons(event, rest) => ⟨same_response_refl(event), same_responses_refl(rest)⟩,
    }
}

// ---------------------------------------------------------------------------
// Runs from related states meet at related syscalls.

theorem linux_steps_meet<M>(io: LinuxIo<M>, n: Nat): (m: Nat) → (left, right, left_at, right_at: MachineState<M>) →
    SameDefinedState<M>(left, right) → LinuxStepsN(io, n, left, left_at) → LinuxStepsN(io, m, right, right_at) →
    LinuxSyscallAt(io, left_at) → LinuxSyscallAt(io, right_at) → SameDefinedState<M>(left_at, right_at) {
    match n {
        Zero => λ m => match m {
            Zero => λ left right left_at right_at same here there _ _ =>
                j(there, λ state _ => SameDefinedState<M>(left_at, state),
                    j(here, λ state _ => SameDefinedState<M>(state, right), same)),
            Succ(_) => λ left right left_at right_at same here there call _ =>
                false_elim(syscall_excludes_step(io.fetch, io.data, linux_writes(io), left, right, there.witness, same,
                    j(sym(here), λ state _ => LinuxSyscallAt(io, state), call), there.proof.left)),
        },
        Succ(k) => λ m => match m {
            Zero => λ left right left_at right_at same here there _ call =>
                false_elim(syscall_excludes_step(io.fetch, io.data, linux_writes(io), right, left, here.witness,
                    sym(same),
                    j(sym(there), λ state _ => LinuxSyscallAt(io, state), call), here.proof.left)),
            Succ(k2) => λ left right left_at right_at same here there left_call right_call =>
                linux_steps_meet(io, k, k2, here.witness, there.witness, left_at, right_at,
                    step_respects_defined(io.fetch, io.data, linux_writes(io), left, right, here.witness, there.witness,
                        same, here.proof.left, there.proof.left),
                    here.proof.right, there.proof.right, left_call, right_call),
        },
    }
}

// Runs from related states pass through related states: a run of `taken`
// steps from one side is matched on the other, which still has the rest of
// its steps to its syscall to go.
theorem linux_steps_peel<M>(io: LinuxIo<M>, taken: Nat): (k: Nat) → (left, right, mid, at: MachineState<M>) →
    SameDefinedState<M>(left, right) → LinuxStepsN(io, taken, left, mid) → LinuxStepsN(io, k, right, at) →
    LinuxSyscallAt(io, at) →
    Exists<MachineState<M>>(λ r => SameDefinedState<M>(mid, r) ∧ Exists<Nat>(λ m => LinuxStepsN(io, m, r, at) ∧ (m + taken = k))) {
    match taken {
        Zero => λ k left right mid at same here there call =>
            Exists(right, ⟨j(here, λ state _ => SameDefinedState<M>(state, right), same), Exists(k, ⟨there, refl⟩)⟩),
        Succ(taken2) => λ k => match k {
            Zero => λ left right mid at same here there call =>
                false_elim(syscall_excludes_step(io.fetch, io.data, linux_writes(io), right, left, here.witness, sym(same),
                    j(sym(there), λ state _ => LinuxSyscallAt(io, state), call), here.proof.left)),
            Succ(k2) => λ left right mid at same here there call => {
                let rest = linux_steps_peel(io, taken2, k2, here.witness, there.witness, mid, at,
                    step_respects_defined(io.fetch, io.data, linux_writes(io), left, right, here.witness, there.witness,
                        same, here.proof.left, there.proof.left),
                    here.proof.right, there.proof.right, call);
                Exists(rest.witness, ⟨rest.proof.left, Exists(rest.proof.right.witness, ⟨rest.proof.right.proof.left,
                    cong_fn(λ (x: Nat) => Succ(x), rest.proof.right.proof.right)⟩)⟩)
            },
        },
    }
}

theorem register_related<M>(register: Gpr, left, right: MachineState<M>, same: SameDefinedState<M>(left, right)):
    read_gpr(register, left.gprs) = read_gpr(register, right.gprs) {
    cong_fn(λ (gprs: Gprs) => read_gpr(register, gprs), SameDefinedState::gprs(same))
}

// A list every index of which reads back from one source is that source's.
theorem lists_read_alike(source: Nat → Option<BitVec(8)>, left: List<BitVec(8)>): (right: List<BitVec(8)>) →
    left.len() = right.len() →
    ((i: Nat) → (byte: BitVec(8)) → left.nth(i) = Some(byte) → source(i) = Some(byte)) →
    ((i: Nat) → (byte: BitVec(8)) → right.nth(i) = Some(byte) → source(i) = Some(byte)) → left = right {
    match left {
        Nil => λ right => match right {
            Nil => λ _ _ _ => refl,
            Cons(_, ys) => λ length _ _ => false_elim(Nat::zero_ne_succ(ys.len(), length)),
        },
        Cons(x, xs) => λ right => match right {
            Nil => λ length _ _ => false_elim(Nat::succ_ne_zero(xs.len(), length)),
            Cons(y, ys) => λ length first second =>
                List::cons_eq(xs, ys, x, y,
                    Option::some_inj(x, y, trans(sym(first(Zero, x, refl)), second(Zero, y, refl))),
                    lists_read_alike(λ i => source(Succ(i)), xs, ys, Nat::succ_inj(xs.len(), ys.len(), length),
                        λ i byte found => first(Succ(i), byte, found), λ i byte found => second(Succ(i), byte, found))),
        },
    }
}

theorem writes_from_unique<M>(io: LinuxIo<M>, memory: M, buffer: BitVec(64), left, right: List<BitVec(8)>,
    length: left.len() = right.len(),
    first: LinuxWritesFrom(io, memory, buffer, left), second: LinuxWritesFrom(io, memory, buffer, right)): left = right {
    lists_read_alike(λ i => io.data.read(memory, bitvec_nat::word_of_nat(64, buffer.toNat() + i)), left, right,
        length, first, second)
}

// A C string is where its NUL is: two read from one source are one.
theorem c_strings_alike(left: List<BitVec(8)>): (right: List<BitVec(8)>) → (source: Nat → Option<BitVec(8)>) →
    CStringFrom(left, source) → CStringFrom(right, source) → left = right {
    match left {
        Nil => λ right source here there => match right {
            Nil => refl,
            Cons(y, ys) => false_elim(there.right.left(Option::some_inj(y, BitVec::ofNat(0), trans(sym(there.left), here)))),
        },
        Cons(x, xs) => λ right source here there => match right {
            Nil => false_elim(here.right.left(Option::some_inj(x, BitVec::ofNat(0), trans(sym(here.left), there)))),
            Cons(y, ys) => List::cons_eq(xs, ys, x, y, Option::some_inj(x, y, trans(sym(here.left), there.left)),
                    c_strings_alike(xs, ys, λ i => source(Succ(i)), here.right.right, there.right.right)),
        },
    }
}

// The path a related state names is this one's.
theorem paths_related<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    path, other: List<BitVec(8)>, here: CStringAt(io.data, left.memory, read_gpr(Rsi, left.gprs), path),
    there: CStringAt(io.data, right.memory, read_gpr(Rsi, right.gprs), other)): path = other {
    let moved: CStringAt(io.data, left.memory, read_gpr(Rsi, left.gprs), other) =
        j(sym(register_related(Rsi, left, right, same)), λ address _ => CStringAt(io.data, left.memory, address, other),
            j(sym(SameDefinedState::memory(same)), λ memory _ => CStringAt(io.data, memory, read_gpr(Rsi, right.gprs), other), there));
    c_strings_alike(path, other, λ i => io.data.read(left.memory, bitvec_nat::word_of_nat(64, read_gpr(Rsi, left.gprs).toNat() + i)),
        here, moved)
}

theorem stat_numbers_differ<M>(left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    here: read_gpr(Rax, left.gprs) = BitVec::ofNat(262), there: read_gpr(Rax, right.gprs) = BitVec::ofNat(5)): False {
    let equal: (BitVec::ofNat(262, n := 64) = BitVec::ofNat(5, n := 64)) =
        trans(sym(here), trans(register_related(Rax, left, right, same), there));
    absurd(cong_fn(λ (word: BitVec(64)) => byte_bit1(word.take_low(8, 56)), equal))
}

// A stat of a path and of a descriptor are told apart by their numbers.
theorem stat_targets_related<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    target: StatTarget): (other: StatTarget) → StatAsked(io, left, target) → StatAsked(io, right, other) → target = other {
    match target {
        StatPath(path) => λ other => match other {
            StatPath(path2) => λ here there => cong_fn(λ (p: List<BitVec(8)>) => StatPath(p),
                paths_related(io, left, right, same, path, path2, here.right.right.right, there.right.right.right)),
            StatFd(_) => λ here there => false_elim(stat_numbers_differ(left, right, same, here.left, there.left)),
        },
        StatFd(fd) => λ other => match other {
            StatPath(_) => λ here there => false_elim(stat_numbers_differ(right, left, sym(same), there.left, here.left)),
            StatFd(fd2) => λ here there => cong_fn(λ (f: BitVec(64)) => StatFd(f),
                trans(sym(here.right), trans(register_related(Rdi, left, right, same), there.right))),
        },
    }
}

// ---------------------------------------------------------------------------
// Without an answer to compare: the call two related states ask is one call,
// and a state that asks a call is not one that exits. RAX names the kind of
// call (`rax_kind`, a closed comparison per number), so calls of different
// kinds, and an exit, are told apart by evaluation.

// The descriptor two related states name is one.
theorem descriptors_related<M>(left, right: MachineState<M>, same: SameDefinedState<M>(left, right), fd, fd2: BitVec(64),
    here: read_gpr(Rdi, left.gprs) = fd, there: read_gpr(Rdi, right.gprs) = fd2): fd = fd2 {
    trans(sym(here), trans(register_related(Rdi, left, right, same), there))
}

fn LinuxCmd::kind<Size>(self c: LinuxCmd<Size>) → Nat {
    match c { ReadCmd(_, _) => 0, WriteCmd(_, _) => 1, OpenCmd(_) => 2, CloseCmd(_) => 3, StatCmd(_) => 4 }
}

// The kind of call a syscall number asks: read, write, openat, close,
// newfstatat or fstat; 5 for anything else, exit among it.
fn rax_kind(rax: BitVec(64)) → Nat {
    match rax.eq_bit(BitVec::ofNat(0)) {
        True => 0,
        False => match rax.eq_bit(BitVec::ofNat(1)) {
            True => 1,
            False => match rax.eq_bit(BitVec::ofNat(257)) {
                True => 2,
                False => match rax.eq_bit(BitVec::ofNat(3)) {
                    True => 3,
                    False => match rax.eq_bit(BitVec::ofNat(262)) {
                        True => 4,
                        False => match rax.eq_bit(BitVec::ofNat(5)) { True => 4, False => 5 },
                    },
                },
            },
        },
    }
}

theorem stat_kind<M>(io: LinuxIo<M>, at: MachineState<M>, target: StatTarget):
    StatAsked(io, at, target) → rax_kind(read_gpr(Rax, at.gprs)) = 4 {
    match target {
        StatPath(_) => λ asked => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asked.left),
        StatFd(_) => λ asked => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asked.left),
    }
}

theorem asks_kind<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>):
    LinuxAsks(io, at, c) → rax_kind(read_gpr(Rax, at.gprs)) = c.kind() {
    match c {
        ReadCmd(_, _) => λ asks => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asks.left),
        WriteCmd(_, _) => λ asks => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asks.left),
        OpenCmd(_) => λ asks => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asks.left),
        CloseCmd(_) => λ asks => cong_fn(λ (word: BitVec(64)) => rax_kind(word), asks.left),
        StatCmd(target) => λ asks => stat_kind(io, at, target, asks),
    }
}

theorem kinds_related<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    c, d: LinuxCmd<Nat>, here: LinuxAsks(io, left, c), there: LinuxAsks(io, right, d)): c.kind() = d.kind() {
    trans(sym(asks_kind(io, left, c, here)),
        trans(cong_fn(λ (word: BitVec(64)) => rax_kind(word), register_related(Rax, left, right, same)),
            asks_kind(io, right, d, there)))
}

theorem kind_not_exit(c: LinuxCmd<Nat>): c.kind() = 5 → False {
    match c {
        ReadCmd(_, _) => λ e => absurd(e), WriteCmd(_, _) => λ e => absurd(e), OpenCmd(_) => λ e => absurd(e),
        CloseCmd(_) => λ e => absurd(e), StatCmd(_) => λ e => absurd(e),
    }
}

// A state that exits does not ask a call of a related one.
theorem exits_not_asks<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    status: BitVec(64), c: LinuxCmd<Nat>, exits: LinuxExits(left, status), asks: LinuxAsks(io, right, c)): False {
    kind_not_exit(c, trans(sym(asks_kind(io, right, c, asks)),
        trans(cong_fn(λ (word: BitVec(64)) => rax_kind(word), sym(register_related(Rax, left, right, same))),
            cong_fn(λ (word: BitVec(64)) => rax_kind(word), exits.left))))
}

theorem asks_of_kind<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    c: LinuxCmd<Nat>): (d: LinuxCmd<Nat>) → c.kind() = d.kind() → LinuxAsks(io, left, c) → LinuxAsks(io, right, d) → c = d {
    match c {
        ReadCmd(fd, max) => λ d => match d {
            ReadCmd(fd2, max2) => λ _ here there => {
                let fds: (fd = fd2) = descriptors_related(left, right, same, fd, fd2, here.right.left, there.right.left);
                let maxes: (max = max2) = trans(sym(here.right.right),
                    trans(cong_fn(λ (word: BitVec(64)) => word.toNat(), register_related(Rdx, left, right, same)), there.right.right));
                trans(@cong<BitVec(64), LinuxCmd<Nat>>(λ f => ReadCmd(f, max), fd, fd2, fds),
                    @cong<Nat, LinuxCmd<Nat>>(λ m => ReadCmd(fd2, m), max, max2, maxes))
            },
            _ => λ kinds _ _ => absurd(kinds),
        },
        WriteCmd(fd, bytes) => λ d => match d {
            WriteCmd(fd2, bytes2) => λ _ here there => {
                let fds: (fd = fd2) = descriptors_related(left, right, same, fd, fd2, here.right.left, there.right.left);
                let length: (bytes.len() = bytes2.len()) = trans(sym(here.right.right.left),
                    trans(cong_fn(λ (word: BitVec(64)) => word.toNat(), register_related(Rdx, left, right, same)),
                        there.right.right.left));
                let sends: LinuxWritesFrom(io, left.memory, read_gpr(Rsi, left.gprs), bytes2) =
                    j(sym(register_related(Rsi, left, right, same)), λ buffer _ => LinuxWritesFrom(io, left.memory, buffer, bytes2),
                        j(sym(SameDefinedState::memory(same)), λ memory _ => LinuxWritesFrom(io, memory, read_gpr(Rsi, right.gprs), bytes2),
                            there.right.right.right));
                let sent: (bytes = bytes2) = writes_from_unique(io, left.memory, read_gpr(Rsi, left.gprs), bytes, bytes2,
                    length, here.right.right.right, sends);
                trans(@cong<BitVec(64), LinuxCmd<Nat>>(λ f => WriteCmd(f, bytes), fd, fd2, fds),
                    @cong<List<BitVec(8)>, LinuxCmd<Nat>>(λ b => WriteCmd(fd2, b), bytes, bytes2, sent))
            },
            _ => λ kinds _ _ => absurd(kinds),
        },
        OpenCmd(path) => λ d => match d {
            OpenCmd(path2) => λ _ here there =>
                @cong<List<BitVec(8)>, LinuxCmd<Nat>>(λ p => OpenCmd(p), path, path2,
                    paths_related(io, left, right, same, path, path2, here.right.right.right, there.right.right.right)),
            _ => λ kinds _ _ => absurd(kinds),
        },
        CloseCmd(fd) => λ d => match d {
            CloseCmd(fd2) => λ _ here there =>
                @cong<BitVec(64), LinuxCmd<Nat>>(λ f => CloseCmd(f), fd, fd2,
                    descriptors_related(left, right, same, fd, fd2, here.right, there.right)),
            _ => λ kinds _ _ => absurd(kinds),
        },
        StatCmd(target) => λ d => match d {
            StatCmd(target2) => λ _ here there =>
                @cong<StatTarget, LinuxCmd<Nat>>(λ t => StatCmd(t), target, target2,
                    stat_targets_related(io, left, right, same, target, target2, here, there)),
            _ => λ kinds _ _ => absurd(kinds),
        },
    }
}

// The call two related states ask is one call.
theorem asks_meet<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    c, d: LinuxCmd<Nat>, here: LinuxAsks(io, left, c), there: LinuxAsks(io, right, d)): c = d {
    asks_of_kind(io, left, right, same, c, d, kinds_related(io, left, right, same, c, d, here, there), here, there)
}

// ---------------------------------------------------------------------------
// One syscall. The claim's side of an event, as `LinuxRuns` spells it.

fn ClaimAt<M>(io: LinuxIo<M>, event: LinuxEvent, rest: List<LinuxEvent>, at: MachineState<M>) → Type {
    match event {
        CallEvent(c, a) => LinuxAnswered(io, at, c, a, LinuxRuns(io, rest)),
        ExitEvent(status) => LinuxExits(at, status) ∧ (rest = Nil),
    }
}
fn RunAt<M>(io: LinuxIo<M>, event: LinuxEvent, rest: List<LinuxEvent>, at: MachineState<M>) → Type {
    match event {
        CallEvent(c, a) => LinuxAsks(io, at, c) ∧ LinuxResumed(io, at, c, a, LinuxRun(io, rest)),
        ExitEvent(status) => LinuxExits(at, status) ∧ (rest = Nil),
    }
}

// The claim at one syscall, as `LinuxRuns` states it, is `ClaimAt`.
theorem claim_at<M>(io: LinuxIo<M>, event: LinuxEvent, rest: List<LinuxEvent>, start: MachineState<M>,
    claimed: LinuxRuns(io, Cons(event, rest), start)): ClaimAt(io, event, rest, claimed.witness) {
    claimed.proof.right.right
}
theorem run_at<M>(io: LinuxIo<M>, event: LinuxEvent, rest: List<LinuxEvent>, start: MachineState<M>,
    ran: LinuxRun(io, Cons(event, rest), start)): RunAt(io, event, rest, ran.witness) {
    ran.proof.right.right
}

// The call two related states ask is one call, and with the same answer one
// event: the request is read off the registers and memory they share.
theorem call_meets<M>(io: LinuxIo<M>, left, right: MachineState<M>, same: SameDefinedState<M>(left, right),
    c: LinuxCmd<Nat>): (a: c.Resp()) → (d: LinuxCmd<Nat>) → (b: d.Resp()) →
    LinuxAsks(io, left, c) → LinuxAsks(io, right, d) → SameAnswer(c, a, d, b) → CallEvent(c, a) = CallEvent(d, b) {
    match c {
        ReadCmd(fd, max) => λ (a: ReadResult) d => match d {
            ReadCmd(fd2, max2) => λ (b: ReadResult) here there (answer: a = b) => {
                let fds: (fd = fd2) = descriptors_related(left, right, same, fd, fd2, here.right.left, there.right.left);
                let maxes: (max = max2) = trans(sym(here.right.right),
                    trans(cong_fn(λ (word: BitVec(64)) => word.toNat(), register_related(Rdx, left, right, same)), there.right.right));
                trans(cong_fn(λ (f: BitVec(64)) => CallEvent(ReadCmd(f, max), a), fds),
                trans(cong_fn(λ (m: Nat) => CallEvent(ReadCmd(fd2, m), a), maxes),
                    cong_fn(λ (r: ReadResult) => CallEvent(ReadCmd(fd2, max2), r), answer)))
            },
            WriteCmd(_, _) => λ _ _ _ never => false_elim(never),
            OpenCmd(_) => λ _ _ _ never => false_elim(never),
            CloseCmd(_) => λ _ _ _ never => false_elim(never),
            StatCmd(_) => λ _ _ _ never => false_elim(never),
        },
        WriteCmd(fd, bytes) => λ (a: WriteResult) d => match d {
            WriteCmd(fd2, bytes2) => λ (b: WriteResult) here there (answer: a = b) => {
                let fds: (fd = fd2) = descriptors_related(left, right, same, fd, fd2, here.right.left, there.right.left);
                let length: (bytes.len() = bytes2.len()) = trans(sym(here.right.right.left),
                    trans(cong_fn(λ (word: BitVec(64)) => word.toNat(), register_related(Rdx, left, right, same)),
                        there.right.right.left));
                let sends: LinuxWritesFrom(io, left.memory, read_gpr(Rsi, left.gprs), bytes2) =
                    j(sym(register_related(Rsi, left, right, same)), λ buffer _ => LinuxWritesFrom(io, left.memory, buffer, bytes2),
                        j(sym(SameDefinedState::memory(same)), λ memory _ => LinuxWritesFrom(io, memory, read_gpr(Rsi, right.gprs), bytes2),
                            there.right.right.right));
                let requests: (bytes = bytes2) = writes_from_unique(io, left.memory, read_gpr(Rsi, left.gprs), bytes, bytes2,
                    length, here.right.right.right, sends);
                trans(cong_fn(λ (f: BitVec(64)) => CallEvent(WriteCmd(f, bytes), a), fds),
                trans(cong_fn(λ (sent: List<BitVec(8)>) => CallEvent(WriteCmd(fd2, sent), a), requests),
                    cong_fn(λ (r: WriteResult) => CallEvent(WriteCmd(fd2, bytes2), r), answer)))
            },
            ReadCmd(_, _) => λ _ _ _ never => false_elim(never),
            OpenCmd(_) => λ _ _ _ never => false_elim(never),
            CloseCmd(_) => λ _ _ _ never => false_elim(never),
            StatCmd(_) => λ _ _ _ never => false_elim(never),
        },
        OpenCmd(path) => λ (a: OpenResult) d => match d {
            OpenCmd(path2) => λ (b: OpenResult) here there (answer: a = b) => {
                let paths: (path = path2) = paths_related(io, left, right, same, path, path2,
                    here.right.right.right, there.right.right.right);
                trans(cong_fn(λ (p: List<BitVec(8)>) => CallEvent(OpenCmd(p), a), paths),
                    cong_fn(λ (r: OpenResult) => CallEvent(OpenCmd(path2), r), answer))
            },
            ReadCmd(_, _) => λ _ _ _ never => false_elim(never),
            WriteCmd(_, _) => λ _ _ _ never => false_elim(never),
            CloseCmd(_) => λ _ _ _ never => false_elim(never),
            StatCmd(_) => λ _ _ _ never => false_elim(never),
        },
        CloseCmd(fd) => λ (a: CloseResult) d => match d {
            CloseCmd(fd2) => λ (b: CloseResult) here there (answer: a = b) =>
                trans(cong_fn(λ (f: BitVec(64)) => CallEvent(CloseCmd(f), a), descriptors_related(left, right, same, fd, fd2, here.right, there.right)),
                    cong_fn(λ (r: CloseResult) => CallEvent(CloseCmd(fd2), r), answer)),
            ReadCmd(_, _) => λ _ _ _ never => false_elim(never),
            WriteCmd(_, _) => λ _ _ _ never => false_elim(never),
            OpenCmd(_) => λ _ _ _ never => false_elim(never),
            StatCmd(_) => λ _ _ _ never => false_elim(never),
        },
        StatCmd(target) => λ (a: StatResult) d => match d {
            StatCmd(target2) => λ (b: StatResult) here there (answer: a = b) =>
                trans(cong_fn(λ (t: StatTarget) => CallEvent(StatCmd(t), a),
                        stat_targets_related(io, left, right, same, target, target2, here, there)),
                    cong_fn(λ (r: StatResult) => CallEvent(StatCmd(target2), r), answer)),
            ReadCmd(_, _) => λ _ _ _ never => false_elim(never),
            WriteCmd(_, _) => λ _ _ _ never => false_elim(never),
            OpenCmd(_) => λ _ _ _ never => false_elim(never),
            CloseCmd(_) => λ _ _ _ never => false_elim(never),
        },
    }
}

// A claimed run is a run: Linux may leave anything in RCX, R11 and a failed
// call's buffer, the claim covers all of it, and zeros and an empty buffer
// are one choice. So the runs `linux_runs_every` speaks of exist.
theorem claim_is_run_at<M>(io: LinuxIo<M>, event: LinuxEvent, rest: List<LinuxEvent>, at: MachineState<M>,
    claimed: ClaimAt(io, event, rest, at), next: (state: MachineState<M>) → LinuxRuns(io, rest, state) → LinuxRun(io, rest, state)):
    RunAt(io, event, rest, at) {
    let zero: BitVec(64) = BitVec::zero();
    (match event as λ e => ClaimAt(io, e, rest, at) → RunAt(io, e, rest, at) {
        CallEvent(c, a) => λ cl => ⟨cl.left.left, Exists(Nil<BitVec(8)>, ⟨linux_leaves_nil(c, a), Exists(zero, Exists(zero,
            next(linux_answered(io, at, c, a, Nil, zero, zero), cl.right.right(Nil, linux_leaves_nil(c, a), zero, zero))))⟩)⟩,
        ExitEvent(_) => λ cl => cl,
    })(claimed)
}

theorem claim_is_run<M>(io: LinuxIo<M>, events: List<LinuxEvent>): (state: MachineState<M>) →
    LinuxRuns(io, events, state) → LinuxRun(io, events, state) {
    match events {
        Nil => λ state never => never,
        Cons(event, rest) => λ state claimed => Exists(claimed.witness, ⟨claimed.proof.left, ⟨claimed.proof.right.left,
            claim_is_run_at(io, event, rest, claimed.witness, claim_at(io, event, rest, state, claimed),
                λ next_state next_claim => claim_is_run(io, rest, next_state, next_claim))⟩⟩),
    }
}

// The machine meets a tree: `Sim` (docs/native-program-logic-design.md §5;
// issues/native-linux-spec.md).
//
// A trace of a tree over Linux's calls is a claim about the machine: from
// the state, Linux steps to a syscall whose request is the trace's call,
// Linux answers it with the trace's answer, and from every state Linux may
// resume in (whatever it leaves in RCX, R11 and a failed call's buffer) the
// rest of the trace holds again; a trace that returns ends at an exit with
// its status. `RunsAs` is that claim: `call_system`'s `CallSystem::Holds` at
// the process as a system of claims (`CallSystem::linux_claims`), and
// `RunsAlong` the same at the process as a system of runs. It reads the
// definitions `LinuxRuns` reads, so for a whole trace the two are one
// (`runs_as_linux_runs`, `linux_runs_runs_as`). `Sim(t)` is the claim of
// every trace of `t` Linux may produce: the history of answers is the
// trace's. With determinism, a run with the answers of a whole trace of `t`
// produced exactly that trace's events (`sim_every_run`). Conversely, every
// run of the machine is the tree's, up to where the tree is cut
// (`sim_run_of`, at the end).
//
// At a cut a tree has only the empty trace, so `Sim` says nothing past it: a
// program's claim is `Sim` at every fuel (`SimProgram`), which covers every
// finite trace. Liveness is what is lost. `Sim` is closed backward under
// `LinuxSteps`, and the rules `sim_ret`, `sim_vis`, `sim_cut` and
// `sim_of_next` build it one `next` of the tree at a time, which is how a
// program logic meets it.
import linux_calls;
import linux_x86_64_io;
import linux_x86_64_determinism;
import linux_trees;
import itree;
import itree_trace;
import call_system;
import transition;
import x86_64;
import x86_64_step_forms;
import bitvec;
import list;
import logic;
import nat;

// A process over Linux's calls as a `CallSystem` (call_system.hthr): it
// steps silently between syscalls, moves only at a syscall, returns at an
// exit, and asks the call its registers request with writable buffers.
// Linux answers; a claim covers every way Linux may resume (`LinuxAnswered`),
// a run picks one (`LinuxResumed`).
fn CallSystem::linux_claims<M>(io: LinuxIo<M>) → CallSystem<MachineState<M>, BitVec(64)>(Events::linux()) {
    CallSystem(λ s t => LinuxStep(io, s, t), λ at => LinuxSyscallAt(io, at), λ at status => LinuxExits(at, status),
        λ at c => LinuxRequests(io, at, c), λ at c a next => LinuxAnswered(io, at, c, a, next))
}

fn CallSystem::linux_runs<M>(io: LinuxIo<M>) → CallSystem<MachineState<M>, BitVec(64)>(Events::linux()) {
    CallSystem(λ s t => LinuxStep(io, s, t), λ at => LinuxSyscallAt(io, at), λ at status => LinuxExits(at, status),
        λ at c => LinuxAsks(io, at, c), λ at c a next => LinuxAsks(io, at, c) ∧ LinuxResumed(io, at, c, a, next))
}

// The claim a trace makes of the machine: `CallSystem::Holds` at the
// process.
fn RunsAs<M>(io: LinuxIo<M>, tr: Trace<BitVec(64)>(Events::linux())) → MachineState<M> → Type {
    CallSystem::Holds(Events::linux(), CallSystem::linux_claims(io), tr)
}

// A run of the machine along a trace, as it happened.
fn RunsAlong<M>(io: LinuxIo<M>, tr: Trace<BitVec(64)>(Events::linux())) → MachineState<M> → Type {
    CallSystem::Holds(Events::linux(), CallSystem::linux_runs(io), tr)
}

fn Sim<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux())) → MachineState<M> → Type {
    λ state => (tr: Trace<BitVec(64)>(Events::linux())) → IsTrace(Events::linux(), t, tr) →
        Trace::LinuxValid(tr) → RunsAs(io, tr, state)
}

// `Sim` is refinement of the tree, as a system, by the machine's claims.
theorem sim_refines<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state)): CallSystem::Refines(Events::linux(), CallSystem::tree<BitVec(64)>(Events::linux()),
    CallSystem::linux_claims(io), λ tr => Trace::LinuxValid(tr), t, state) {
    λ tr holds valid => sim(tr, CallSystem::tree_is_trace(Events::linux(), tr, t, holds), valid)
}

theorem refines_sim<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    refines: CallSystem::Refines(Events::linux(), CallSystem::tree<BitVec(64)>(Events::linux()),
        CallSystem::linux_claims(io), λ tr => Trace::LinuxValid(tr), t, state)): Sim(io, t, state) {
    λ tr it valid => refines(tr, IsTrace::holds(Events::linux(), t, tr, it), valid)
}

// A program meets its spec at every fuel.
fn SimProgram<M>(io: LinuxIo<M>, p: Program<BitVec(64)>(Events::linux())) → MachineState<M> → Type {
    λ state => (n: Nat) → Sim(io, p.at(n), state)
}

// ---------------------------------------------------------------------------
// Steps before a claim are part of it.

theorem runs_as_back<M>(io: LinuxIo<M>, tr: Trace<BitVec(64)>(Events::linux())): (before, after: MachineState<M>) →
    LinuxSteps(io, before, after) → RunsAs(io, tr, after) → RunsAs(io, tr, before) {
    match tr {
        TEnd => λ before after steps runs => trivial,
        TRet(_) => λ before after steps runs => Exists(runs.witness,
            ⟨linux_steps_trans(io, before, after, runs.witness, steps, runs.proof.left), runs.proof.right⟩),
        TCall(_) => λ before after steps runs => Exists(runs.witness,
            ⟨linux_steps_trans(io, before, after, runs.witness, steps, runs.proof.left), runs.proof.right⟩),
        TAns(_, _, _) => λ before after steps runs => Exists(runs.witness,
            ⟨linux_steps_trans(io, before, after, runs.witness, steps, runs.proof.left), runs.proof.right⟩),
    }
}

theorem sim_back<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), before, after: MachineState<M>,
    steps: LinuxSteps(io, before, after), sim: Sim(io, t, after)): Sim(io, t, before) {
    λ tr it valid => runs_as_back(io, tr, before, after, steps, sim(tr, it, valid))
}

// ---------------------------------------------------------------------------
// The rules: one constructor of the tree at a time

theorem sim_cut<M>(io: LinuxIo<M>, state: MachineState<M>): Sim<M>(io, Cut, state) {
    λ tr (w: CutTrace<BitVec(64)>(Events::linux(), tr)) valid =>
        j(sym(CutTrace::ended(Events::linux(), tr, w)), λ y _ => RunsAs(io, y, state), trivial)
}

theorem sim_tau<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state)): Sim<M>(io, Tau(t), state) {
    sim
}

// Linux steps to an exit with the tree's status.
theorem sim_ret<M>(io: LinuxIo<M>, status: BitVec(64), state, at: MachineState<M>,
    steps: LinuxSteps(io, state, at), syscall: LinuxSyscallAt(io, at), exits: LinuxExits(at, status)):
    Sim<M>(io, Ret(status), state) {
    λ tr (w: RetTrace<BitVec(64)>(Events::linux(), status, tr)) valid => match w {
        Stopped(e) => j(sym(e), λ y _ => RunsAs(io, y, state), trivial),
        Returned(e) => j(sym(e), λ y _ => RunsAs(io, y, state), Exists(at, ⟨steps, ⟨syscall, exits⟩⟩)),
    }
}

// Linux steps to a syscall that requests the tree's call, and every way it
// may answer and resume meets the tree's continuation at that answer.
//
// Of one trace, stated as a `VisTrace`. (Matched inside `sim_vis`'s λ, the
// binder must be annotated with that `VisTrace`: its expected type is
// `IsTrace` of the tree's `Vis`, and arms spelled off that cost the kernel
// twenty times the steps; issues/trace-match-under-computed-binder-cost.md.)
theorem sim_vis_trace<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()),
    state, at: MachineState<M>, steps: LinuxSteps(io, state, at), syscall: LinuxSyscallAt(io, at),
    requests: LinuxRequests(io, at, c),
    answers: (a: c.Resp()) → c.Answers(a) → LinuxResumes(io, at, c, a, Sim(io, k(a))),
    tr: Trace<BitVec(64)>(Events::linux()), w: VisTrace<BitVec(64)>(Events::linux(), c, tr, λ a rest => IsTrace(Events::linux(), k(a), rest)),
    valid: Trace::LinuxValid(tr)): RunsAs(io, tr, state) {
    match w {
        Prefix(e) => j(sym(e), λ y _ => RunsAs(io, y, state), trivial),
        Pending(e) => j(sym(e), λ y _ => RunsAs(io, y, state), Exists(at, ⟨steps, ⟨syscall, requests⟩⟩)),
        Answered(a, rest, e, sub) => {
            let moved: Trace::LinuxValid<BitVec(64)>(TAns(c, a, rest)) = rewrite(e, in := valid);
            j(sym(e), λ y _ => RunsAs(io, y, state), Exists(at, ⟨steps, ⟨syscall, ⟨requests, ⟨moved.left,
                linux_resumes_mono(io, at, c, a, Sim(io, k(a)), RunsAs(io, rest),
                    λ resumed sim => sim(rest, sub, moved.right), answers(a, moved.left))⟩⟩⟩⟩))
        },
    }
}
theorem sim_vis<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()),
    state, at: MachineState<M>, steps: LinuxSteps(io, state, at), syscall: LinuxSyscallAt(io, at),
    requests: LinuxRequests(io, at, c),
    answers: (a: c.Resp()) → c.Answers(a) → LinuxResumes(io, at, c, a, Sim(io, k(a)))):
    Sim<M>(io, Vis(c, k), state) {
    λ tr w valid => sim_vis_trace(io, c, k, state, at, steps, syscall, requests, answers, tr, w, valid)
}

// What `Sim` asks of the tree's next move: the exit, the call, or nothing at
// a cut. This is what a program logic evaluates.
fn SimNext<M>(io: LinuxIo<M>, n: Next<BitVec(64)>(Events::linux())) → MachineState<M> → Type {
    match n {
        Exits(status) => λ state => Exists<MachineState<M>>(λ at =>
            LinuxSteps(io, state, at) ∧ (LinuxSyscallAt(io, at) ∧ LinuxExits(at, status))),
        Calls(c, k) => λ state => Exists<MachineState<M>>(λ at =>
            LinuxSteps(io, state, at) ∧ (LinuxSyscallAt(io, at) ∧ (LinuxRequests(io, at, c) ∧
            ((a: c.Resp()) → c.Answers(a) → LinuxResumes(io, at, c, a, Sim(io, k(a))))))),
        Stops => λ state => True,
    }
}

theorem sim_of_next<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux())): (state: MachineState<M>) →
    SimNext(io, ITree::next(Events::linux(), t), state) → Sim(io, t, state) {
    match t {
        Ret(status) => λ state h => sim_ret(io, status, state, h.witness, h.proof.left, h.proof.right.left, h.proof.right.right),
        Tau(u) => λ state h => sim_of_next(io, u, state, h),
        Vis(c, k) => λ state h => sim_vis(io, c, k, state, h.witness, h.proof.left, h.proof.right.left,
            h.proof.right.right.left, h.proof.right.right.right),
        Cut => λ state h => sim_cut(io, state),
    }
}

// ---------------------------------------------------------------------------
// Fewer traces, fewer claims: `Sim` passes to a tree whose traces are
// among the tree's, so to one below it, or the `Same` one.

theorem sim_of_traces<M>(io: LinuxIo<M>, t, u: ITree<BitVec(64)>(Events::linux()),
    among: (tr: Trace<BitVec(64)>(Events::linux())) → IsTrace(Events::linux(), t, tr) → IsTrace(Events::linux(), u, tr),
    state: MachineState<M>, sim: Sim(io, u, state)): Sim(io, t, state) {
    λ tr it valid => sim(tr, among(tr, it), valid)
}

theorem sim_of_below<M>(io: LinuxIo<M>, t, u: ITree<BitVec(64)>(Events::linux()), below: ITree::Below(Events::linux(), t, u),
    state: MachineState<M>, sim: Sim(io, u, state)): Sim(io, t, state) {
    sim_of_traces(io, t, u, λ tr it => IsTrace::of_below(Events::linux(), t, u, tr, below, it), state, sim)
}

theorem sim_of_same<M>(io: LinuxIo<M>, t, u: ITree<BitVec(64)>(Events::linux()), same: ITree::Same(Events::linux(), t, u),
    state: MachineState<M>, sim: Sim(io, u, state)): Sim(io, t, state) {
    sim_of_traces(io, t, u, λ tr it => IsTrace::of_same(Events::linux(), t, u, tr, same, it), state, sim)
}

// A program's claim covers every trace it produces, at whatever fuel.
theorem Program::sim_produces<M>(io: LinuxIo<M>, p: Program<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: SimProgram(io, p, state), tr: Trace<BitVec(64)>(Events::linux()),
    produces: Program::Produces(Events::linux(), p, tr), valid: Trace::LinuxValid(tr)): RunsAs(io, tr, state) {
    sim(produces.n, tr, produces.h, valid)
}

// …so it passes to a program that refines it.
theorem Program::sim_refines<M>(io: LinuxIo<M>, p, q: Program<BitVec(64)>(Events::linux()),
    refines: Program::Refines(Events::linux(), p, q), state: MachineState<M>, sim: SimProgram(io, q, state)):
    SimProgram(io, p, state) {
    λ n tr it valid => Program::sim_produces(io, q, state, sim, tr, refines(tr, Converges(n, it)), valid)
}

// ---------------------------------------------------------------------------
// The bridge: a whole trace's claim is the run of its events.

theorem runs_as_linux_runs<M>(io: LinuxIo<M>, tr: Trace<BitVec(64)>(Events::linux())): (state: MachineState<M>) →
    Trace::Returns(Events::linux(), tr) → RunsAs(io, tr, state) → LinuxRuns(io, Trace::linux_events(tr), state) {
    match tr {
        TEnd => λ state never _ => false_elim(never),
        TRet(_) => λ state _ runs => Exists(runs.witness, ⟨runs.proof.left, ⟨runs.proof.right.left, ⟨runs.proof.right.right, refl⟩⟩⟩),
        TCall(_) => λ state never _ => false_elim(never),
        TAns(c, a, rest) => λ state returns runs => {
            let answered = runs.proof.right.right;
            Exists(runs.witness, ⟨runs.proof.left, ⟨runs.proof.right.left, ⟨answered.left, ⟨answered.right.left,
                linux_resumes_mono(io, runs.witness, c, a, RunsAs(io, rest), LinuxRuns(io, Trace::linux_events(rest)),
                    λ resumed claim => runs_as_linux_runs(io, rest, resumed, returns, claim), answered.right.right)⟩⟩⟩⟩)
        },
    }
}

theorem linux_runs_runs_as<M>(io: LinuxIo<M>, tr: Trace<BitVec(64)>(Events::linux())): (state: MachineState<M>) →
    LinuxRuns(io, Trace::linux_events(tr), state) → RunsAs(io, tr, state) {
    match tr {
        TEnd => λ state _ => trivial,
        TRet(_) => λ state runs => Exists(runs.witness, ⟨runs.proof.left, ⟨runs.proof.right.left, runs.proof.right.right.left⟩⟩),
        TCall(_) => λ state never => false_elim(never),
        TAns(c, a, rest) => λ state runs => {
            let answered = runs.proof.right.right;
            Exists(runs.witness, ⟨runs.proof.left, ⟨runs.proof.right.left, ⟨answered.left, ⟨answered.right.left,
                linux_resumes_mono(io, runs.witness, c, a, LinuxRuns(io, Trace::linux_events(rest)), RunsAs(io, rest),
                    λ resumed claim => linux_runs_runs_as(io, rest, resumed, claim), answered.right.right)⟩⟩⟩⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// Determinacy along traces: `CallSystem::determined` at the process. A
// claim and a run from related states meet at related syscalls, ask one
// call, and with the same answer resume in related states, since the claim
// covers whatever Linux left the run.

// An event as the first move of a trace.
fn LinuxEvent::then(self event: LinuxEvent, rest: Trace<BitVec(64)>(Events::linux())) → Trace<BitVec(64)>(Events::linux()) {
    match event { CallEvent(c, a) => TAns(c, a, rest), ExitEvent(status) => TRet(status) }
}

// How a run resumed after an event's call.
fn LinuxEvent::resumed<M>(self event: LinuxEvent, io: LinuxIo<M>, at: MachineState<M>, next: MachineState<M> → Type) → Type {
    match event { CallEvent(c, a) => LinuxResumed(io, at, c, a, next), ExitEvent(_) => True }
}

theorem linux_meets<M>(io: LinuxIo<M>): Meets<MachineState<M>, BitVec(64)>(Events::linux(), CallSystem::linux_claims(io),
    CallSystem::linux_runs(io), λ x y => SameDefinedState<M>(x, y), λ c a d b => SameAnswer(c, a, d, b)) {
    Meets(
        λ a a2 b b2 same left right =>
            step_respects_defined(io.fetch, io.data, linux_writes(io), a, a2, b, b2, same, left, right),
        λ a a2 b2 same stop step => syscall_excludes_step(io.fetch, io.data, linux_writes(io), a, a2, b2, same, stop, step),
        λ a a2 b same step stop =>
            syscall_excludes_step(io.fetch, io.data, linux_writes(io), a2, a, b, sym(same), stop, step),
        λ a a2 r r2 same _ _ (left: LinuxExits(a, r)) (right: LinuxExits(a2, r2)) =>
            trans(sym(left.right), trans(register_related(Rdi, a, a2, same), right.right)),
        λ a a2 c d same _ _ (left: LinuxRequests(io, a, c)) (right: LinuxAsks(io, a2, d)) =>
            asks_meet(io, a, a2, same, c, d, left.left, right),
        λ a a2 c d x y next next2 same _ _ (claim: LinuxAnswered(io, a, c, x, next))
            (run: LinuxAsks(io, a2, d) ∧ LinuxResumed(io, a2, d, y, next2)) alike => {
            let events: (CallEvent(c, x) = CallEvent(d, y)) = call_meets(io, a, a2, same, c, x, d, y, claim.left.left,
                run.left, alike);
            let moved: LinuxResumed(io, a2, c, x, next2) =
                j(sym(events), λ e _ => LinuxEvent::resumed(e, io, a2, next2), run.right);
            let junk = moved.witness;
            let rcx = moved.proof.right.witness;
            let r11 = moved.proof.right.proof.witness;
            ⟨λ rest => cong_fn(λ (e: LinuxEvent) => LinuxEvent::then(e, rest), events),
                Exists(linux_answered(io, a, c, x, junk, rcx, r11), Exists(linux_answered(io, a2, c, x, junk, rcx, r11),
                    ⟨linux_answered_respects<M>(io, c, x, junk, rcx, r11, a, a2, same),
                        ⟨claim.right.right(junk, moved.proof.left, rcx, r11), moved.proof.right.proof.proof⟩⟩))⟩
        })
}

// A claimed trace and a run along a trace from related states that got the
// same answers are one trace.
theorem runs_as_determined<M>(io: LinuxIo<M>, tr, other: Trace<BitVec(64)>(Events::linux()), left, right: MachineState<M>,
    same: SameDefinedState<M>(left, right), claim: RunsAs(io, tr, left), run: RunsAlong(io, other, right),
    agree: CallSystem::Agree(Events::linux(), λ c a d b => SameAnswer(c, a, d, b), tr, other)): tr = other {
    CallSystem::determined(Events::linux(), CallSystem::linux_claims(io), CallSystem::linux_runs(io),
        λ x y => SameDefinedState<M>(x, y), λ c a d b => SameAnswer(c, a, d, b), linux_meets(io), tr, other, left, right,
        same, claim, run, agree)
}

// ---------------------------------------------------------------------------
// Event lists as traces. `LinuxRuns` and `LinuxRun` list a whole run's
// events; as a trace they are its answered calls, then the return.

fn Trace::of_linux_events(events: List<LinuxEvent>) → Trace<BitVec(64)>(Events::linux()) {
    match events { Nil => TEnd, Cons(event, rest) => event.then(Trace::of_linux_events(rest)) }
}

theorem linux_run_along<M>(io: LinuxIo<M>, events: List<LinuxEvent>): (state: MachineState<M>) →
    LinuxRun(io, events, state) → RunsAlong(io, Trace::of_linux_events(events), state) {
    match events {
        Nil => λ state never => false_elim(never),
        Cons(event, rest) => λ state ran => {
            let at = ran.witness;
            (match event as λ e => RunAt(io, e, rest, at) → RunsAlong(io, Trace::of_linux_events(Cons(e, rest)), state) {
                CallEvent(c, a) => λ here => {
                    let resumed = here.right;
                    let rcx = resumed.proof.right.witness;
                    let r11 = resumed.proof.right.proof.witness;
                    Exists(at, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨here.left, Exists(resumed.witness,
                        ⟨resumed.proof.left, Exists(rcx, Exists(r11, linux_run_along(io, rest,
                            linux_answered(io, at, c, a, resumed.witness, rcx, r11), resumed.proof.right.proof.proof)))⟩)⟩⟩⟩)
                },
                ExitEvent(_) => λ here => Exists(at, ⟨ran.proof.left, ⟨ran.proof.right.left, here.left⟩⟩),
            })(run_at(io, event, rest, state, ran))
        },
    }
}

theorem linux_runs_claims<M>(io: LinuxIo<M>, events: List<LinuxEvent>): (state: MachineState<M>) →
    LinuxRuns(io, events, state) → RunsAs(io, Trace::of_linux_events(events), state) {
    match events {
        Nil => λ state never => false_elim(never),
        Cons(event, rest) => λ state claimed => {
            let at = claimed.witness;
            (match event as λ e => ClaimAt(io, e, rest, at) → RunsAs(io, Trace::of_linux_events(Cons(e, rest)), state) {
                CallEvent(c, a) => λ here => Exists(at, ⟨claimed.proof.left, ⟨claimed.proof.right.left, ⟨here.left,
                    ⟨here.right.left, linux_resumes_mono(io, at, c, a, LinuxRuns(io, rest), RunsAs(io, Trace::of_linux_events(rest)),
                        λ resumed claim => linux_runs_claims(io, rest, resumed, claim), here.right.right)⟩⟩⟩⟩),
                ExitEvent(_) => λ here => Exists(at, ⟨claimed.proof.left, ⟨claimed.proof.right.left, here.left⟩⟩),
            })(claim_at(io, event, rest, state, claimed))
        },
    }
}

// A run's events are its trace's: an exit ends the list.
theorem linux_run_events<M>(io: LinuxIo<M>, events: List<LinuxEvent>): (state: MachineState<M>) →
    LinuxRun(io, events, state) → Trace::linux_events(Trace::of_linux_events(events)) = events {
    match events {
        Nil => λ state never => false_elim(never),
        Cons(event, rest) => λ state ran => {
            let at = ran.witness;
            (match event as λ e => RunAt(io, e, rest, at) →
                Trace::linux_events(Trace::of_linux_events(Cons(e, rest))) = Cons(e, rest) {
                CallEvent(c, a) => λ here => {
                    let resumed = here.right;
                    let rcx = resumed.proof.right.witness;
                    let r11 = resumed.proof.right.proof.witness;
                    cong_fn(λ (more: List<LinuxEvent>) => Cons(CallEvent(c, a), more), linux_run_events(io, rest,
                        linux_answered(io, at, c, a, resumed.witness, rcx, r11), resumed.proof.right.proof.proof))
                },
                ExitEvent(status) => λ here =>
                    cong_fn(λ (more: List<LinuxEvent>) => Cons(ExitEvent(status), more), sym(here.right)),
            })(run_at(io, event, rest, state, ran))
        },
    }
}

// Lists that got the same answers are traces that agree move by move.
theorem same_responses_agree(claim: List<LinuxEvent>): (run: List<LinuxEvent>) → SameResponses(claim, run) →
    CallSystem::Agree(Events::linux(), λ c a d b => SameAnswer(c, a, d, b), Trace::of_linux_events(claim),
        Trace::of_linux_events(run)) {
    match claim {
        Nil => λ run => match run { Nil => λ _ => trivial, Cons(_, _) => λ never => false_elim(never) },
        Cons(event, rest) => λ run => match run {
            Nil => λ never => false_elim(never),
            Cons(other, more) => λ responses => (match event as λ e => SameResponse(e, other) →
                CallSystem::Agree(Events::linux(), λ c a d b => SameAnswer(c, a, d, b), e.then(Trace::of_linux_events(rest)),
                    other.then(Trace::of_linux_events(more))) {
                CallEvent(c, a) => match other as λ o => SameResponse(CallEvent(c, a), o) →
                    CallSystem::Agree(Events::linux(), λ c a d b => SameAnswer(c, a, d, b),
                        TAns(c, a, Trace::of_linux_events(rest)), o.then(Trace::of_linux_events(more))) {
                    CallEvent(_, _) => λ alike => ⟨alike, same_responses_agree(rest, more, responses.right)⟩,
                    ExitEvent(_) => λ never => false_elim(never),
                },
                ExitEvent(status) => match other as λ o => SameResponse(ExitEvent(status), o) →
                    CallSystem::Agree(Events::linux(), λ c a d b => SameAnswer(c, a, d, b),
                        Trace::returned<BitVec(64)>(Events::linux(), status), o.then(Trace::of_linux_events(more))) {
                    ExitEvent(_) => λ _ => trivial,
                    CallEvent(_, _) => λ never => false_elim(never),
                },
            })(responses.left),
        },
    }
}

// The run is the run (`linux_x86_64_determinism`), through the traces:
// from related states, a claimed run and any actual run that got the same
// answers produced the same events.
theorem linux_runs_determine<M>(io: LinuxIo<M>, claim, run: List<LinuxEvent>, left, right: MachineState<M>,
    same: SameDefinedState<M>(left, right), claimed: LinuxRuns(io, claim, left), ran: LinuxRun(io, run, right),
    responses: SameResponses(claim, run)): claim = run {
    let traces = runs_as_determined(io, Trace::of_linux_events(claim), Trace::of_linux_events(run), left, right, same,
        linux_runs_claims(io, claim, left, claimed), linux_run_along(io, run, right, ran),
        same_responses_agree(claim, run, responses));
    trans(sym(linux_run_events(io, claim, left, claim_is_run(io, claim, left, claimed))),
        trans(cong_fn(λ (tr: Trace<BitVec(64)>(Events::linux())) => Trace::linux_events(tr), traces),
            linux_run_events(io, run, right, ran)))
}

// From one state, the claim is every run with its answers.
theorem linux_runs_every<M>(io: LinuxIo<M>, claim, run: List<LinuxEvent>, start: MachineState<M>,
    claimed: LinuxRuns(io, claim, start), ran: LinuxRun(io, run, start), responses: SameResponses(claim, run)):
    run = claim {
    sym(linux_runs_determine(io, claim, run, start, start, refl, claimed, ran, responses))
}

// A whole trace of the tree is a run of the machine…
theorem sim_linux_runs<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state), tr: Trace<BitVec(64)>(Events::linux()), it: IsTrace(Events::linux(), t, tr),
    valid: Trace::LinuxValid(tr), returns: Trace::Returns(Events::linux(), tr)):
    LinuxRuns(io, Trace::linux_events(tr), state) {
    runs_as_linux_runs(io, tr, state, returns, sim(tr, it, valid))
}

// …and the only one: every run of the machine that got that trace's answers
// produced its events, so it sent what the trace sent.
theorem sim_every_run<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state), tr: Trace<BitVec(64)>(Events::linux()), it: IsTrace(Events::linux(), t, tr),
    valid: Trace::LinuxValid(tr), returns: Trace::Returns(Events::linux(), tr),
    run: List<LinuxEvent>, ran: LinuxRun(io, run, state), responses: SameResponses(Trace::linux_events(tr), run)):
    run = Trace::linux_events(tr) {
    linux_runs_every(io, Trace::linux_events(tr), run, state, sim_linux_runs(io, t, state, sim, tr, it, valid, returns),
        ran, responses)
}

theorem sim_run_sends<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state), tr: Trace<BitVec(64)>(Events::linux()), it: IsTrace(Events::linux(), t, tr),
    valid: Trace::LinuxValid(tr), returns: Trace::Returns(Events::linux(), tr),
    run: List<LinuxEvent>, ran: LinuxRun(io, run, state), responses: SameResponses(Trace::linux_events(tr), run),
    fd: BitVec(64)): sent_to(fd, run) = Trace::sent<Nat, BitVec(64)>(fd, tr) {
    trans(cong_fn(λ (events: List<LinuxEvent>) => sent_to(fd, events),
        sim_every_run(io, t, state, sim, tr, it, valid, returns, run, ran, responses)), Trace::sent_events(fd, tr))
}

// ---------------------------------------------------------------------------
// The converse (issues/linux-sim-every-machine-run.md): a machine that
// simulates a tree makes only the tree's traces. Walk a run against the
// tree: at each syscall the tree's claim and the run meet
// (`linux_steps_meet`), the call the run asks is the tree's (`asks_meet`),
// and the run's answer, one Linux may give, picks the tree's branch. So the
// run is the events of a whole trace of the tree, or the tree is cut after
// a prefix of them (`RunOf`, `sim_run_of`).
//
// The cut is all `Sim` can say: it is partial correctness, so a tree that
// is cut at every fuel along a run (a loop that goes round silently
// forever) is simulated by a machine that goes on and exits. Ruling that
// out is a statement about divergence: `linux_x86_64_sim_co`'s `LinuxSimCo`
// (issues/linux-sim-divergence.md).

// The answers of a run are ones Linux may give.
fn LinuxEvent::Valid(self event: LinuxEvent) → Type {
    match event { CallEvent(c, a) => c.Answers(a), ExitEvent(_) => True }
}
fn LinuxEventsValid(events: List<LinuxEvent>) → Type {
    match events { Nil => True, Cons(event, rest) => event.Valid() ∧ LinuxEventsValid(rest) }
}

// A claimed run's answers are: `LinuxAnswered` asks it of each.
theorem claim_valid<M>(io: LinuxIo<M>, rest: List<LinuxEvent>, at: MachineState<M>,
    next: (state: MachineState<M>) → LinuxRuns(io, rest, state) → LinuxEventsValid(rest), event: LinuxEvent):
    ClaimAt(io, event, rest, at) → LinuxEventsValid(Cons(event, rest)) {
    let zero: BitVec(64) = BitVec::zero();
    match event {
        CallEvent(c, a) => λ claimed => ⟨claimed.right.left, next(linux_answered(io, at, c, a, Nil, zero, zero),
            claimed.right.right(Nil, linux_leaves_nil(c, a), zero, zero))⟩,
        ExitEvent(_) => λ claimed => ⟨trivial, j(sym(claimed.right), λ y _ => LinuxEventsValid(y), trivial)⟩,
    }
}

theorem linux_runs_valid<M>(io: LinuxIo<M>, events: List<LinuxEvent>): (state: MachineState<M>) →
    LinuxRuns(io, events, state) → LinuxEventsValid(events) {
    match events {
        Nil => λ state never => false_elim(never),
        Cons(event, rest) => λ state claimed => claim_valid(io, rest, claimed.witness,
            λ next_state next_claim => linux_runs_valid(io, rest, next_state, next_claim), event,
            claim_at(io, event, rest, state, claimed)),
    }
}

// What the walk carries: each trace's claim holds from some state related to
// the run's. A step of the run and of the claim meet only up to
// `SameDefinedState`, and after an answer each trace's claim may be met at a
// state of its own.
fn SimRelated<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), right: MachineState<M>) → Type {
    (tr: Trace<BitVec(64)>(Events::linux())) → IsTrace(Events::linux(), t, tr) → Trace::LinuxValid(tr) →
        Exists<MachineState<M>>(λ left => SameDefinedState<M>(left, right) ∧ RunsAs(io, tr, left))
}

theorem sim_related<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state)): SimRelated(io, t, state) {
    λ tr it valid => Exists(state, ⟨refl, sim(tr, it, valid)⟩)
}

// A run of a tree: the events of a whole trace of it, or a prefix of them
// that ends where the tree is cut.
fn RunAlong(t: ITree<BitVec(64)>(Events::linux()), tr: Trace<BitVec(64)>(Events::linux()), run: List<LinuxEvent>) → Type {
    (IsTrace(Events::linux(), t, tr) ∧ (Trace::Returns(Events::linux(), tr) ∧ (Trace::linux_events(tr) = run))) ∨
    (IsCutTrace(Events::linux(), t, tr) ∧ Exists<List<LinuxEvent>>(λ more => Trace::linux_events(tr).append(more) = run))
}
fn RunOf(t: ITree<BitVec(64)>(Events::linux()), run: List<LinuxEvent>) → Type {
    Exists<Trace<BitVec(64)>(Events::linux())>(λ tr => RunAlong(t, tr, run))
}

theorem run_along_answered(c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()), a: c.Resp(),
    tr: Trace<BitVec(64)>(Events::linux()), more: List<LinuxEvent>, along: RunAlong(k(a), tr, more)):
    RunAlong(Vis(c, k), TAns(c, a, tr), Cons(CallEvent(c, a), more)) {
    match along {
        Inl(whole) => Inl(⟨Answered(a, tr, refl, whole.left), ⟨whole.right.left,
            cong_fn(λ (events: List<LinuxEvent>) => Cons(CallEvent(c, a), events), whole.right.right)⟩⟩),
        Inr(cut) => Inr(⟨AnsweredTrace(a, tr, refl, cut.left), Exists(cut.right.witness,
            cong_fn(λ (events: List<LinuxEvent>) => Cons(CallEvent(c, a), events), cut.right.proof))⟩),
    }
}

theorem run_of_answered(c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()), a: c.Resp(),
    more: List<LinuxEvent>, h: RunOf(k(a), more)): RunOf(Vis(c, k), Cons(CallEvent(c, a), more)) {
    Exists(TAns(c, a, h.witness), run_along_answered(c, k, a, h.witness, more, h.proof))
}

// At a return: the run's syscall is the exit, with the tree's status.
theorem ret_meets<M>(io: LinuxIo<M>, status: BitVec(64), more: List<LinuxEvent>, at, ran_at: MachineState<M>,
    same: SameDefinedState<M>(at, ran_at), exits: LinuxExits(at, status), event: LinuxEvent):
    RunAt(io, event, more, ran_at) → RunOf(Ret(status), Cons(event, more)) {
    match event {
        ExitEvent(status2) => λ ran => {
            let statuses: (status = status2) =
                trans(sym(exits.right), trans(register_related(Rdi, at, ran_at, same), ran.left.right));
            Exists(TRet(status), Inl(⟨Returned(refl), ⟨trivial, List::cons_eq(Nil, more, ExitEvent(status), ExitEvent(status2),
                cong_fn(λ (s: BitVec(64)) => ExitEvent(s), statuses), sym(ran.right))⟩⟩))
        },
        CallEvent(c, _) => λ ran => false_elim(exits_not_asks(io, at, ran_at, same, status, c, exits, ran.left)),
    }
}

theorem sim_ret_run<M>(io: LinuxIo<M>, status: BitVec(64), right: MachineState<M>, sim: SimRelated(io, Ret(status), right),
    run: List<LinuxEvent>): LinuxRun(io, run, right) → RunOf(Ret(status), run) {
    match run {
        Nil => λ never => false_elim(never),
        Cons(event, more) => λ ran => {
            let claim = sim(TRet(status), Returned(refl), trivial);
            let runs = claim.proof.right;
            let meet = linux_steps_meet(io, runs.proof.left.witness, ran.proof.left.witness, claim.witness, right,
                runs.witness, ran.witness, claim.proof.left, runs.proof.left.proof, ran.proof.left.proof,
                runs.proof.right.left, ran.proof.right.left);
            ret_meets(io, status, more, runs.witness, ran.witness, meet, runs.proof.right.right, event,
                run_at(io, event, more, right, ran))
        },
    }
}

// At a call answered as the tree asks: every trace past the answer is
// claimed from a state related to where Linux resumed the run.
theorem answered_meets<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()),
    right: MachineState<M>, sim: SimRelated(io, Vis(c, k), right),
    next: (a: c.Resp()) → (more: List<LinuxEvent>) → (resumed: MachineState<M>) → SimRelated(io, k(a), resumed) →
        LinuxRun(io, more, resumed) → LinuxEventsValid(more) → RunOf(k(a), more),
    more: List<LinuxEvent>, at: MachineState<M>, steps: LinuxSteps(io, right, at), syscall: LinuxSyscallAt(io, at),
    b: c.Resp(), resumed: LinuxResumed(io, at, c, b, LinuxRun(io, more)),
    valid: LinuxEventsValid(Cons(CallEvent(c, b), more))): RunOf(Vis(c, k), Cons(CallEvent(c, b), more)) {
    let junk = resumed.witness;
    let rcx = resumed.proof.right.witness;
    let r11 = resumed.proof.right.proof.witness;
    let related: SimRelated(io, k(b), linux_answered(io, at, c, b, junk, rcx, r11)) = λ rest it rest_valid => {
        let claim = sim(TAns(c, b, rest), Answered(b, rest, refl, it), ⟨valid.left, rest_valid⟩);
        let runs = claim.proof.right;
        let meet = linux_steps_meet(io, runs.proof.left.witness, steps.witness, claim.witness, right, runs.witness, at,
            claim.proof.left, runs.proof.left.proof, steps.proof, runs.proof.right.left, syscall);
        Exists(linux_answered(io, runs.witness, c, b, junk, rcx, r11),
            ⟨linux_answered_respects<M>(io, c, b, junk, rcx, r11, runs.witness, at, meet),
                runs.proof.right.right.right.right(junk, resumed.proof.left, rcx, r11)⟩)
    };
    run_of_answered(c, k, b, more, next(b, more, linux_answered(io, at, c, b, junk, rcx, r11), related,
        resumed.proof.right.proof.proof, valid.right))
}

// At a call: the run's syscall asks the tree's call, never an exit.
theorem vis_meets<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()),
    right: MachineState<M>, sim: SimRelated(io, Vis(c, k), right),
    next: (a: c.Resp()) → (more: List<LinuxEvent>) → (resumed: MachineState<M>) → SimRelated(io, k(a), resumed) →
        LinuxRun(io, more, resumed) → LinuxEventsValid(more) → RunOf(k(a), more),
    more: List<LinuxEvent>, at: MachineState<M>, steps: LinuxSteps(io, right, at), syscall: LinuxSyscallAt(io, at),
    claim_at: MachineState<M>, same: SameDefinedState<M>(claim_at, at), asks: LinuxAsks(io, claim_at, c),
    event: LinuxEvent): RunAt(io, event, more, at) → LinuxEventsValid(Cons(event, more)) → RunOf(Vis(c, k), Cons(event, more)) {
    match event {
        ExitEvent(status) => λ ran _ => false_elim(exits_not_asks(io, at, claim_at, sym(same), status, c, ran.left, asks)),
        CallEvent(d, b) => λ ran valid =>
            j(asks_meet(io, claim_at, at, same, c, d, asks, ran.left),
                λ x _ => (b: x.Resp()) → RunAt(io, CallEvent(x, b), more, at) → LinuxEventsValid(Cons(CallEvent(x, b), more)) →
                    RunOf(Vis(c, k), Cons(CallEvent(x, b), more)),
                λ b2 ran2 valid2 => answered_meets(io, c, k, right, sim, next, more, at, steps, syscall, b2, ran2.right, valid2))(b, ran, valid),
    }
}

theorem sim_vis_run<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>, k: c.Resp() → ITree<BitVec(64)>(Events::linux()),
    right: MachineState<M>, sim: SimRelated(io, Vis(c, k), right),
    next: (a: c.Resp()) → (more: List<LinuxEvent>) → (resumed: MachineState<M>) → SimRelated(io, k(a), resumed) →
        LinuxRun(io, more, resumed) → LinuxEventsValid(more) → RunOf(k(a), more),
    run: List<LinuxEvent>): LinuxRun(io, run, right) → LinuxEventsValid(run) → RunOf(Vis(c, k), run) {
    match run {
        Nil => λ never _ => false_elim(never),
        Cons(event, more) => λ ran valid => {
            let claim = sim(TCall(c), Pending(refl), trivial);
            let runs = claim.proof.right;
            let meet = linux_steps_meet(io, runs.proof.left.witness, ran.proof.left.witness, claim.witness, right,
                runs.witness, ran.witness, claim.proof.left, runs.proof.left.proof, ran.proof.left.proof,
                runs.proof.right.left, ran.proof.right.left);
            vis_meets(io, c, k, right, sim, next, more, ran.witness, ran.proof.left, ran.proof.right.left,
                runs.witness, meet, runs.proof.right.right.left, event, run_at(io, event, more, right, ran), valid)
        },
    }
}

theorem sim_related_run<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux())): (run: List<LinuxEvent>) →
    (right: MachineState<M>) → SimRelated(io, t, right) → LinuxRun(io, run, right) → LinuxEventsValid(run) → RunOf(t, run) {
    match t {
        Ret(status) => λ run right sim ran _ => sim_ret_run(io, status, right, sim, run, ran),
        Tau(s) => λ run right sim ran valid => sim_related_run(io, s, run, right, sim, ran, valid),
        Vis(c, k) => λ run right sim ran valid => sim_vis_run(io, c, k, right, sim,
            λ a more resumed related again again_valid => sim_related_run(io, k(a), more, resumed, related, again, again_valid),
            run, ran, valid),
        Cut => λ run right sim ran valid => Exists(TEnd, Inr(⟨refl, Exists(run, refl)⟩)),
    }
}

// Every run of a machine that simulates a tree, with answers Linux may give,
// is the tree's: the events of a whole trace, or a prefix of them up to a cut.
theorem sim_run_of<M>(io: LinuxIo<M>, t: ITree<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: Sim(io, t, state), run: List<LinuxEvent>, ran: LinuxRun(io, run, state), valid: LinuxEventsValid(run)):
    RunOf(t, run) {
    sim_related_run(io, t, run, state, sim_related(io, t, state, sim), ran, valid)
}

// …at every fuel of a program.
theorem Program::sim_run_at<M>(io: LinuxIo<M>, p: Program<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: SimProgram(io, p, state), run: List<LinuxEvent>, ran: LinuxRun(io, run, state), valid: LinuxEventsValid(run),
    n: Nat): RunOf(p.at(n), run) {
    sim_run_of(io, p.at(n), state, sim(n), run, ran, valid)
}

// …and every claimed run, as `LinuxRuns` states one: its answers are ones
// Linux may give, and it is a run.
theorem Program::sim_linux_runs_at<M>(io: LinuxIo<M>, p: Program<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: SimProgram(io, p, state), events: List<LinuxEvent>, runs: LinuxRuns(io, events, state), n: Nat):
    RunOf(p.at(n), events) {
    Program::sim_run_at(io, p, state, sim, events, claim_is_run(io, events, state, runs),
        linux_runs_valid(io, events, state, runs), n)
}

// Where the tree is not cut along the run, the run is exactly a whole trace's
// events: one the program produces.
fn CutBefore(t: ITree<BitVec(64)>(Events::linux()), run: List<LinuxEvent>) → Type {
    Exists<Trace<BitVec(64)>(Events::linux())>(λ tr => IsCutTrace(Events::linux(), t, tr) ∧
        Exists<List<LinuxEvent>>(λ more => Trace::linux_events(tr).append(more) = run))
}

theorem run_along_whole(t: ITree<BitVec(64)>(Events::linux()), tr: Trace<BitVec(64)>(Events::linux()),
    run: List<LinuxEvent>, along: RunAlong(t, tr, run), uncut: Not(CutBefore(t, run))):
    IsTrace(Events::linux(), t, tr) ∧ (Trace::Returns(Events::linux(), tr) ∧ (Trace::linux_events(tr) = run)) {
    match along {
        Inl(whole) => whole,
        Inr(cut) => false_elim(uncut(Exists(tr, cut))),
    }
}

theorem Program::sim_run_produces<M>(io: LinuxIo<M>, p: Program<BitVec(64)>(Events::linux()), state: MachineState<M>,
    sim: SimProgram(io, p, state), run: List<LinuxEvent>, ran: LinuxRun(io, run, state), valid: LinuxEventsValid(run),
    n: Nat, uncut: Not(CutBefore(p.at(n), run))):
    Exists<Trace<BitVec(64)>(Events::linux())>(λ tr => Program::Produces(Events::linux(), p, tr) ∧
        (Trace::Returns(Events::linux(), tr) ∧ (Trace::linux_events(tr) = run))) {
    let found = Program::sim_run_at(io, p, state, sim, run, ran, valid, n);
    let whole = run_along_whole(p.at(n), found.witness, run, found.proof, uncut);
    Exists(found.witness, ⟨Converges(n, whole.left), whole.right⟩)
}

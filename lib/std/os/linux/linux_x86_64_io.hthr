// The Linux trace (docs/archive/native-first-program-design.md §4, §10;
// docs/archive/native-syscall-failures-design.md §2): a run of a process is steps
// between syscalls, and each syscall is an event, a call of `linux_calls`
// together with Linux's answer. This module says how a process makes each
// call (its registers and memory), what Linux needs of it (the buffers it
// writes are writable), and the states Linux resumes it in; `LinuxRuns`
// reads those definitions, and so does `linux_x86_64_sim`'s `RunsAs`
// (docs/native/native-program-logic-design.md §5). The rest of the model is
// issues/linux-syscall-trace-model.md. Syscall delivery and Linux itself are
// environment assumptions, not theorems here.
import linux_calls;
import linux_x86_64_entry;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_stack;
import option;
import bool;
import bitvec;
import bitvec_nat;
import list;
import logic;
import nat;
import omega;
import relation_props;
import relation;
import transition;

fn errno_word(errno: Nat) → BitVec(64) { BitVec::ofNat(Nat::pow(2, 64) - errno) }
fn eintr() → Nat { 4 }

theorem errno_value(e: Nat, error: Errno(e)): errno_word(e).toNat() = Nat::pow(2, 64) - e {
    let low: (1 <= e) = error.left;
    let high: (e <= 4095) = error.right;
    BitVec::toNat_ofNat(64, Nat::pow(2, 64) - e, { omega })
}
// An errno word is in the top half of the range, so TEST sets SF; no count
// the rules return is.
theorem errno_negative(e: Nat, error: Errno(e)): Nat::pow(2, 63) <= errno_word(e).toNat() {
    let value = errno_value(e, error);
    let high: (e <= 4095) = error.right;
    omega
}
theorem errno_nonzero(e: Nat, error: Errno(e)): 0 < errno_word(e).toNat() {
    let large = errno_negative(e, error);
    omega
}

// Adding 4 to an errno word gives zero exactly at EINTR: the retry test.
theorem eintr_plus_four(): is_zero_bits(64, errno_word(eintr()).add(BitVec::ofNat(4))) = True { refl }
theorem other_errno_plus_four(e: Nat, error: Errno(e), other: Not(e = eintr())):
    is_zero_bits(64, errno_word(e).add(BitVec::ofNat(4))) = False {
    let large = λ (big: 5 <= e) => {
        let a = errno_word(e);
        let four: BitVec(64) = BitVec::ofNat(4);
        let value = errno_value(e, error);
        let high: (e <= 4095) = error.right;
        let four_value: (four.toNat() = 4) = BitVec::toNat_ofNat(64, 4, trivial);
        let sum: (a.add(four).toNat() = a.toNat() + four.toNat()) = bitvec_nat::toNat_add(64, a, four, { omega });
        zero_bits_of_pos(64, a.add(four), { omega })
    };
    (match e as λ k => (1 <= k) → Not(k = eintr()) → (5 <= k → is_zero_bits(64, errno_word(k).add(BitVec::ofNat(4))) = False) →
            is_zero_bits(64, errno_word(k).add(BitVec::ofNat(4))) = False {
        Zero => λ low _ _ => false_elim({ let z: (1 <= 0) = low; omega }),
        Succ(a) => match a {
            Zero => λ _ _ _ => refl,
            Succ(b) => match b {
                Zero => λ _ _ _ => refl,
                Succ(c) => match c {
                    Zero => λ _ _ _ => refl,
                    Succ(d) => λ _ not_eintr big => match d as λ k4 => Not(Succ(Succ(Succ(Succ(k4)))) = eintr()) →
                            (5 <= Succ(Succ(Succ(Succ(k4)))) → is_zero_bits(64, errno_word(Succ(Succ(Succ(Succ(k4))))).add(BitVec::ofNat(4))) = False) →
                            is_zero_bits(64, errno_word(Succ(Succ(Succ(Succ(k4))))).add(BitVec::ofNat(4))) = False {
                        Zero => λ is_not _ => false_elim(is_not(refl)),
                        Succ(f) => λ _ big => big({ omega }),
                    }(not_eintr, big),
                },
            },
        },
    })(error.left, other, large)
}

// What the environment needs to know about a memory: how code is fetched and
// data read, which spans the kernel may write, and what writing them does.
record LinuxIo<M> {
    fetch: FetchAccess<M>,
    data: ByteReadAccess<M>,
    writable: M → BitVec(64) → Nat → Type,
    store: M → BitVec(64) → List<BitVec(8)> → M,
}

// After a successful read: the bytes are stored at RSI, RAX holds their count,
// and RIP is past the SYSCALL. RCX and R11 hold whatever the rule was given:
// the rule quantifies over them, so a run can't depend on their values.
fn linux_read_return<M>(io: LinuxIo<M>, state: MachineState<M>, bytes: List<BitVec(8)>,
    rcx, r11: BitVec(64)) → MachineState<M> {
    MachineState(
        gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx,
            write_gpr(Rax, bitvec_nat::word_of_nat(64, bytes.len()), state.gprs))),
        flags := state.flags,
        rip := next_rip(state.rip, 2),
        memory := io.store(state.memory, read_gpr(Rsi, state.gprs), bytes))
}

// After a failed read: RAX holds the negated errno. Linux does not promise
// the buffer was left alone, so `junk`, which the rule quantifies over, is
// stored where the bytes would have gone.
fn linux_read_failed_return<M>(io: LinuxIo<M>, state: MachineState<M>, errno: Nat, junk: List<BitVec(8)>,
    rcx, r11: BitVec(64)) → MachineState<M> {
    MachineState(
        gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, errno_word(errno), state.gprs))),
        flags := state.flags,
        rip := next_rip(state.rip, 2),
        memory := io.store(state.memory, read_gpr(Rsi, state.gprs), junk))
}

// After a write, whole, short or failed: RAX holds the count sent or the
// negated errno, and RIP is past the SYSCALL; memory is unchanged. RCX and R11
// are quantified over, as for read.
fn linux_write_return<M>(state: MachineState<M>, rax, rcx, r11: BitVec(64)) → MachineState<M> {
    MachineState(
        gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, rax, state.gprs))),
        flags := state.flags,
        rip := next_rip(state.rip, 2),
        memory := state.memory)
}

// What a write sends: every byte of `bytes` reads back at its place from
// `buffer`, addresses counted by value.
fn LinuxWritesFrom<M>(io: LinuxIo<M>, memory: M, buffer: BitVec(64), bytes: List<BitVec(8)>) → Type {
    (i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) →
        io.data.read(memory, bitvec_nat::word_of_nat(64, buffer.toNat() + i)) = Some(byte)
}

// A NUL-terminated string read from `source`, with no NUL before its end:
// the bytes are `path`, the NUL is not.
fn CStringFrom(path: List<BitVec(8)>) → (Nat → Option<BitVec(8)>) → Type {
    match path {
        Nil => λ source => source(0) = Some(BitVec::ofNat(0)),
        Cons(byte, rest) => λ source => (source(0) = Some(byte)) ∧
            (Not(byte = BitVec::ofNat(0)) ∧ CStringFrom(rest, λ i => source(Succ(i)))),
    }
}
fn CStringAt<M>(data: ByteReadAccess<M>, memory: M, address: BitVec(64), path: List<BitVec(8)>) → Type {
    CStringFrom(path, λ i => data.read(memory, bitvec_nat::word_of_nat(64, address.toNat() + i)))
}

// The process's command line (docs/archive/native-wc-command-design.md §4.1): at the
// initial RSP, argc, then a pointer to each argument (argv[0] included), then
// a null word, as the x86-64 psABI lays them out; each argument a C string
// at a pointer that is not null, so the null word is the first null one.
// The k-th word is at RSP + 8k, its bytes read low first. The words and
// every string lie below the canonical boundary, so a word load or a byte
// load reaches them, and the words' addresses do not wrap. Envp and auxv
// are past the null word and not named.
fn WordAt<M>(data: ByteReadAccess<M>, memory: M, address, word: BitVec(64)) → Type {
    (address.toNat() + 8 <= Nat::pow(2, 47)) ∧ (read_word(data, memory, address) = Some(word))
}
fn WordBytesAt<M>(data: ByteReadAccess<M>, memory: M, address, word: BitVec(64)) → Type {
    (address.toNat() + 8 <= Nat::pow(2, 47)) ∧
    ((t: Nat) → (byte: BitVec(8)) → word_bytes(word).nth(t) = Some(byte) → data.read(memory, next_rip(address, t)) = Some(byte))
}
fn argv_slot(rsp: BitVec(64), k: Nat) → BitVec(64) { bitvec_nat::word_of_nat(64, rsp.toNat() + 8 * k) }
fn ArgvFrom<M>(data: ByteReadAccess<M>, memory: M, rsp: BitVec(64), args: List<List<BitVec(8)>>) → Nat → Type {
    match args {
        Nil => λ k => WordBytesAt(data, memory, argv_slot(rsp, k), BitVec::zero()),
        Cons(arg, rest) => λ k => Exists<BitVec(64)>(λ pointer => WordBytesAt(data, memory, argv_slot(rsp, k), pointer) ∧
            ((0 < pointer.toNat()) ∧ ((pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47)) ∧
            (CStringAt(data, memory, pointer, arg) ∧ ArgvFrom(data, memory, rsp, rest, Succ(k)))))),
    }
}
fn ArgvAt<M>(data: ByteReadAccess<M>, memory: M, rsp: BitVec(64), args: List<List<BitVec(8)>>) → Type {
    (rsp.toNat() + 8 * (args.len() + 2) <= Nat::pow(2, 47)) ∧
    (WordBytesAt(data, memory, rsp, bitvec_nat::word_of_nat(64, args.len())) ∧ ArgvFrom(data, memory, rsp, args, 1))
}

// An access that reads only at or above `floor`: the command line as
// something above a region a program writes sees it.
fn ByteReadAccess::above<M>(self data: ByteReadAccess<M>, floor: Nat) → ByteReadAccess<M> {
    ByteReadAccess(λ (memory: M) (a: BitVec(64)) => match floor.leb(a.toNat()) { True => data.read(memory, a), False => None })
}

theorem ByteReadAccess::above_read<M>(self data: ByteReadAccess<M>, floor: Nat, memory: M, a: BitVec(64), byte: BitVec(8),
    got: data.above(floor).read(memory, a) = Some(byte)): (floor <= a.toNat()) ∧ (data.read(memory, a) = Some(byte)) {
    (match floor.leb(a.toNat()) as λ b => floor.leb(a.toNat()) = b →
            (match b { True => data.read(memory, a), False => None }) = Some(byte) → (floor <= a.toNat()) ∧ (data.read(memory, a) = Some(byte)) {
        True => λ low read => ⟨floor.leb_sound(a.toNat(), j(sym(low), λ x _ => x.IsTrue(), trivial)), read⟩,
        False => λ _ none => absurd(none),
    })(refl, got)
}

// Every byte one access reads at one memory, another reads alike at
// another: the command line read through the first is read through the
// second.
fn ReadsKept<M>(data: ByteReadAccess<M>, memory: M, other: ByteReadAccess<M>, later: M) → Type {
    (a: BitVec(64)) → (byte: BitVec(8)) → data.read(memory, a) = Some(byte) → other.read(later, a) = Some(byte)
}

theorem word_bytes_at_kept<M>(data: ByteReadAccess<M>, memory: M, other: ByteReadAccess<M>, later: M, kept: ReadsKept(data, memory, other, later),
    address, word: BitVec(64), at: WordBytesAt(data, memory, address, word)): WordBytesAt(other, later, address, word) {
    ⟨at.left, λ t byte found => kept(next_rip(address, t), byte, at.right(t, byte, found))⟩
}

theorem cstring_from_kept(path: List<BitVec(8)>): (source, target: Nat → Option<BitVec(8)>) →
    ((i: Nat) → (byte: BitVec(8)) → source(i) = Some(byte) → target(i) = Some(byte)) → CStringFrom(path, source) → CStringFrom(path, target) {
    match path {
        Nil => λ source target kept at => kept(0, BitVec::ofNat(0), at),
        Cons(byte, rest) => λ source target kept at => ⟨kept(0, byte, at.left), ⟨at.right.left,
            cstring_from_kept(rest, λ i => source(Succ(i)), λ i => target(Succ(i)), λ i b got => kept(Succ(i), b, got), at.right.right)⟩⟩,
    }
}

theorem cstring_at_kept<M>(data: ByteReadAccess<M>, memory: M, other: ByteReadAccess<M>, later: M, kept: ReadsKept(data, memory, other, later),
    address: BitVec(64), path: List<BitVec(8)>, at: CStringAt(data, memory, address, path)): CStringAt(other, later, address, path) {
    cstring_from_kept(path, λ i => data.read(memory, bitvec_nat::word_of_nat(64, address.toNat() + i)),
        λ i => other.read(later, bitvec_nat::word_of_nat(64, address.toNat() + i)),
        λ i b got => kept(bitvec_nat::word_of_nat(64, address.toNat() + i), b, got), at)
}

theorem argv_from_kept<M>(data: ByteReadAccess<M>, memory: M, other: ByteReadAccess<M>, later: M, kept: ReadsKept(data, memory, other, later),
    rsp: BitVec(64), args: List<List<BitVec(8)>>): (k: Nat) → ArgvFrom(data, memory, rsp, args, k) → ArgvFrom(other, later, rsp, args, k) {
    match args {
        Nil => λ k at => word_bytes_at_kept(data, memory, other, later, kept, argv_slot(rsp, k), BitVec::zero(), at),
        Cons(arg, rest) => λ k at => Exists(at.witness, ⟨word_bytes_at_kept(data, memory, other, later, kept, argv_slot(rsp, k), at.witness, at.proof.left),
            ⟨at.proof.right.left, ⟨at.proof.right.right.left,
             ⟨cstring_at_kept(data, memory, other, later, kept, at.witness, arg, at.proof.right.right.right.left),
              argv_from_kept(data, memory, other, later, kept, rsp, rest, Succ(k), at.proof.right.right.right.right)⟩⟩⟩⟩),
    }
}

theorem argv_at_kept<M>(data: ByteReadAccess<M>, memory: M, other: ByteReadAccess<M>, later: M, kept: ReadsKept(data, memory, other, later),
    rsp: BitVec(64), args: List<List<BitVec(8)>>, at: ArgvAt(data, memory, rsp, args)): ArgvAt(other, later, rsp, args) {
    ⟨at.left, ⟨word_bytes_at_kept(data, memory, other, later, kept, rsp, bitvec_nat::word_of_nat(64, args.len()), at.right.left),
        argv_from_kept(data, memory, other, later, kept, rsp, args, 1, at.right.right)⟩⟩
}

// A word's eight bytes read as it.
theorem word_bytes_at_read<M>(data: ByteReadAccess<M>, memory: M, address, word: BitVec(64), at: WordBytesAt(data, memory, address, word)):
    WordAt(data, memory, address, word) {
    let b = λ (t: Nat) (c: BitVec(8)) (found: word_bytes(word).nth(t) = Some(c)) => at.right(t, c, found);
    ⟨at.left, trans(word_of_eight(data.read(memory, address), data.read(memory, next_rip(address, 1)), data.read(memory, next_rip(address, 2)),
            data.read(memory, next_rip(address, 3)), data.read(memory, next_rip(address, 4)), data.read(memory, next_rip(address, 5)),
            data.read(memory, next_rip(address, 6)), data.read(memory, next_rip(address, 7)),
            imm_byte0(word), imm_byte1(word), imm_byte2(word), imm_byte3(word), imm_byte4(word), imm_byte5(word), imm_byte6(word), imm_byte7(word),
            b(0, imm_byte0(word), refl),
            b(1, imm_byte1(word), refl), b(2, imm_byte2(word), refl), b(3, imm_byte3(word), refl),
            b(4, imm_byte4(word), refl), b(5, imm_byte5(word), refl), b(6, imm_byte6(word), refl), b(7, imm_byte7(word), refl)),
        cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), immediate_bytes_roundtrip(word)))⟩
}

// Argument `k`, from the slot `from + k`: its pointer, and its string there.
theorem argv_from_nth<M>(data: ByteReadAccess<M>, memory: M, rsp: BitVec(64), args: List<List<BitVec(8)>>): (from, k: Nat) → (arg: List<BitVec(8)>) →
    args.nth(k) = Some(arg) → ArgvFrom(data, memory, rsp, args, from) →
    Exists<BitVec(64)>(λ pointer => WordBytesAt(data, memory, argv_slot(rsp, from + k), pointer) ∧
        ((pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47)) ∧ CStringAt(data, memory, pointer, arg))) {
    match args {
        Nil => λ from k arg none _ => absurd(none),
        Cons(first, rest) => λ from k => match k {
            Zero => λ arg same at => {
                let is: (first = arg) = Option::some_inj(first, arg, same);
                j(is, λ x _ => Exists<BitVec(64)>(λ pointer => WordBytesAt(data, memory, argv_slot(rsp, from + 0), pointer) ∧
                        ((pointer.toNat() + x.len() + 1 <= Nat::pow(2, 47)) ∧ CStringAt(data, memory, pointer, x))),
                    Exists(at.witness, ⟨at.proof.left, ⟨at.proof.right.right.left, at.proof.right.right.right.left⟩⟩))
            },
            Succ(l) => λ arg found at => {
                let later = argv_from_nth(data, memory, rsp, rest, Succ(from), l, arg, found, at.proof.right.right.right.right);
                j(Nat::add_succ_left(from, l), λ i _ => Exists<BitVec(64)>(λ pointer => WordBytesAt(data, memory, argv_slot(rsp, i), pointer) ∧
                        ((pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47)) ∧ CStringAt(data, memory, pointer, arg))), later)
            },
        },
    }
}

// A string's byte `i`, not NUL, and the NUL after its last.
theorem cstring_byte(path: List<BitVec(8)>): (source: Nat → Option<BitVec(8)>) → CStringFrom(path, source) →
    (i: Nat) → (byte: BitVec(8)) → path.nth(i) = Some(byte) → (source(i) = Some(byte)) ∧ Not(byte = BitVec::ofNat(0)) {
    match path {
        Nil => λ source at i byte none => absurd(none),
        Cons(first, rest) => λ source at i => match i {
            Zero => λ byte same => j(Option::some_inj(first, byte, same), λ b _ => (source(0) = Some(b)) ∧ Not(b = BitVec::ofNat(0)),
                ⟨at.left, at.right.left⟩),
            Succ(l) => λ byte found => cstring_byte(rest, λ n => source(Succ(n)), at.right.right, l, byte, found),
        },
    }
}

theorem cstring_end(path: List<BitVec(8)>): (source: Nat → Option<BitVec(8)>) → CStringFrom(path, source) →
    source(path.len()) = Some(BitVec::ofNat(0)) {
    match path {
        Nil => λ source at => at,
        Cons(first, rest) => λ source at => cstring_end(rest, λ n => source(Succ(n)), at.right.right),
    }
}

// openat(AT_FDCWD, path, O_RDONLY) and close(fd) return in RAX, as a write
// does (`linux_write_return`): a descriptor, zero, or the negated errno.
fn at_fdcwd() → BitVec(64) { BitVec::ofNat(Nat::pow(2, 64) - 100) }
fn OpenRequest<M>(io: LinuxIo<M>, at: MachineState<M>, path: List<BitVec(8)>) → Type {
    (read_gpr(Rax, at.gprs) = BitVec::ofNat(257)) ∧ ((read_gpr(Rdi, at.gprs) = at_fdcwd()) ∧
    ((read_gpr(Rdx, at.gprs) = BitVec::ofNat(0)) ∧ CStringAt(io.data, at.memory, read_gpr(Rsi, at.gprs), path)))
}
fn open_rax(result: OpenResult) → BitVec(64) {
    match result { Opened(fd) => bitvec_nat::word_of_nat(64, fd), OpenFailed(errno) => errno_word(errno) }
}
fn close_rax(result: CloseResult) → BitVec(64) {
    match result { Closed => BitVec::ofNat(0), CloseFailed(errno) => errno_word(errno) }
}

// newfstatat(AT_FDCWD, path, buffer, 0) or fstat(fd, buffer): the buffer is
// RDX for the first and RSI for the second. Linux stores the stat there on
// success and, as for a failed read, may have stored anything on failure.
fn stat_buffer(target: StatTarget, gprs: Gprs) → BitVec(64) {
    match target { StatPath(_) => read_gpr(Rdx, gprs), StatFd(_) => read_gpr(Rsi, gprs) }
}
fn StatAsked<M>(io: LinuxIo<M>, at: MachineState<M>, target: StatTarget) → Type {
    match target {
        StatPath(path) => (read_gpr(Rax, at.gprs) = BitVec::ofNat(262)) ∧ ((read_gpr(Rdi, at.gprs) = at_fdcwd()) ∧
            ((read_gpr(R10, at.gprs) = BitVec::ofNat(0)) ∧ CStringAt(io.data, at.memory, read_gpr(Rsi, at.gprs), path))),
        StatFd(fd) => (read_gpr(Rax, at.gprs) = BitVec::ofNat(5)) ∧ (read_gpr(Rdi, at.gprs) = fd),
    }
}
fn linux_stat_return<M>(io: LinuxIo<M>, state: MachineState<M>, target: StatTarget, bytes: List<BitVec(8)>,
    rax, rcx, r11: BitVec(64)) → MachineState<M> {
    MachineState(
        gprs := write_gpr(R11, r11, write_gpr(Rcx, rcx, write_gpr(Rax, rax, state.gprs))),
        flags := state.flags,
        rip := next_rip(state.rip, 2),
        memory := io.store(state.memory, stat_buffer(target, state.gprs), bytes))
}

fn LinuxSyscallAt<M>(io: LinuxIo<M>, state: MachineState<M>) → Type {
    FetchedFrom(io.fetch, state.memory, InstructionBytes(state.rip, syscall_bytes()))
}

// ---------------------------------------------------------------------------
// Steps between syscalls: the fetched forms, or a word store through the
// profile's write model (x86_64_store).

fn linux_writes<M>(io: LinuxIo<M>) → ByteWrites<M> { ByteWrites(io.writable, io.store) }

// A step of the machine (x86_64_stack's `MachineStep`: a fetched step, a
// store, or a stack form) at the profile's accesses.
fn LinuxStep<M>(io: LinuxIo<M>, before, after: MachineState<M>) → Type {
    MachineStep(io.fetch, io.data, linux_writes(io), before, after)
}
// `StarN`, `Star` and `Plus` (transition.hthr) at `LinuxStep`.
fn LinuxStepsN<M>(io: LinuxIo<M>, n: Nat) → MachineState<M> → MachineState<M> → Type {
    StarN(λ before after => LinuxStep(io, before, after), n)
}
fn LinuxSteps<M>(io: LinuxIo<M>, before, after: MachineState<M>) → Type {
    Star(λ s t => LinuxStep(io, s, t), before, after)
}

theorem linux_steps_cons<M>(io: LinuxIo<M>, before, middle, after: MachineState<M>,
    step: LinuxStep(io, before, middle), rest: LinuxSteps(io, middle, after)): LinuxSteps(io, before, after) {
    Star::cons(λ s t => LinuxStep(io, s, t), before, middle, after, step, rest)
}

theorem linux_steps_n_append<M>(io: LinuxIo<M>, n: Nat, before, middle, after: MachineState<M>,
    first: LinuxStepsN(io, n, before, middle), second: LinuxSteps(io, middle, after)): LinuxSteps(io, before, after) {
    StarN::then_star(λ s t => LinuxStep(io, s, t), n, before, middle, after, first, second)
}

theorem linux_steps_trans<M>(io: LinuxIo<M>, before, middle, after: MachineState<M>,
    first: LinuxSteps(io, before, middle), second: LinuxSteps(io, middle, after)): LinuxSteps(io, before, after) {
    Star::trans(λ s t => LinuxStep(io, s, t), before, middle, after, first, second)
}

// At least one step: what a silent step of a tree costs the machine
// (`linux_x86_64_sim_paid`, `linux_x86_64_sim_co`).
fn LinuxPlus<M>(io: LinuxIo<M>, before, after: MachineState<M>) → Type {
    Plus(λ s t => LinuxStep(io, s, t), before, after)
}

theorem linux_plus_back<M>(io: LinuxIo<M>, n: Nat, before, middle, after: MachineState<M>,
    first: LinuxStepsN(io, n, before, middle), plus: LinuxPlus(io, middle, after)): LinuxPlus(io, before, after) {
    StarN::then_plus(λ s t => LinuxStep(io, s, t), n, before, middle, after, first, plus)
}

// The machine's steps at the profile's accesses are the profile's, and so
// are fetched steps: each inclusion of runs is `StarN::monotone`.
theorem linux_step_of_machine<M>(io: LinuxIo<M>):
    Included<MachineState<M>, MachineState<M>>(λ s t => MachineStep(io.fetch, io.data, linux_writes(io), s, t), λ s t => LinuxStep(io, s, t)) {
    λ s t step => step
}
theorem linux_step_of_fetched<M>(io: LinuxIo<M>):
    Included<MachineState<M>, MachineState<M>>(λ s t => FetchedStep(io.fetch, io.data, s, t), λ s t => LinuxStep(io, s, t)) {
    λ s t step => Inl(step)
}

theorem fetched_runs_linux<M>(io: LinuxIo<M>, n: Nat, before, after: MachineState<M>,
    runs: FetchedRuns(io.fetch, io.data, n, before, after)): LinuxStepsN(io, n, before, after) {
    StarN::monotone(λ s t => FetchedStep(io.fetch, io.data, s, t), λ s t => LinuxStep(io, s, t), linux_step_of_fetched(io), n, before, after, runs)
}

// Every fetched run is a run of the profile.
theorem linux_steps_of_fetched<M>(io: LinuxIo<M>, before, after: MachineState<M>,
    steps: FetchedSteps(io.fetch, io.data, before, after)): LinuxSteps(io, before, after) {
    Star::monotone(λ s t => FetchedStep(io.fetch, io.data, s, t), λ s t => LinuxStep(io, s, t), linux_step_of_fetched(io), before, after, steps)
}

theorem linux_steps_store<M>(io: LinuxIo<M>, before, after: MachineState<M>,
    stored: StoreStep(io.fetch, linux_writes(io), before, after)): LinuxSteps(io, before, after) {
    Star::one(λ s t => LinuxStep(io, s, t), before, after, Inr(Inl(stored)))
}

// A run of the machine at the profile's accesses is a run of the profile.
theorem machine_runs_linux<M>(io: LinuxIo<M>, n: Nat, before, after: MachineState<M>,
    runs: MachineRuns(io.fetch, io.data, linux_writes(io), n, before, after)): LinuxStepsN(io, n, before, after) {
    StarN::monotone(λ s t => MachineStep(io.fetch, io.data, linux_writes(io), s, t), λ s t => LinuxStep(io, s, t), linux_step_of_machine(io),
        n, before, after, runs)
}
theorem linux_steps_of_machine<M>(io: LinuxIo<M>, before, after: MachineState<M>,
    steps: MachineSteps(io.fetch, io.data, linux_writes(io), before, after)): LinuxSteps(io, before, after) {
    Star::monotone(λ s t => MachineStep(io.fetch, io.data, linux_writes(io), s, t), λ s t => LinuxStep(io, s, t), linux_step_of_machine(io),
        before, after, steps)
}

theorem linux_steps_stack<M>(io: LinuxIo<M>, before, after: MachineState<M>,
    stepped: StackStep(io.fetch, io.data, linux_writes(io), before, after)): LinuxSteps(io, before, after) {
    Star::one(λ s t => LinuxStep(io, s, t), before, after, Inr(Inr(stepped)))
}

// ---------------------------------------------------------------------------
// One call: what the process asks, what Linux needs, how it resumes.

// The registers and memory at a SYSCALL name the call: read(fd, RSI, max),
// write(fd, RSI, bytes), openat, close(fd), newfstatat or fstat.
fn LinuxAsks<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>) → Type {
    match c {
        ReadCmd(fd, max) =>
            (read_gpr(Rax, at.gprs) = BitVec::ofNat(0)) ∧
            ((read_gpr(Rdi, at.gprs) = fd) ∧ (read_gpr(Rdx, at.gprs).toNat() = max)),
        WriteCmd(fd, bytes) =>
            (read_gpr(Rax, at.gprs) = BitVec::ofNat(1)) ∧
            ((read_gpr(Rdi, at.gprs) = fd) ∧
            ((read_gpr(Rdx, at.gprs).toNat() = bytes.len()) ∧ LinuxWritesFrom(io, at.memory, read_gpr(Rsi, at.gprs), bytes))),
        OpenCmd(path) => OpenRequest(io, at, path),
        CloseCmd(fd) => (read_gpr(Rax, at.gprs) = BitVec::ofNat(3)) ∧ (read_gpr(Rdi, at.gprs) = fd),
        StatCmd(target) => StatAsked(io, at, target),
    }
}

// What Linux needs of the call to answer it as `Answers` says: the buffer a
// read or a stat may store into is writable, all of it, whatever comes back.
fn LinuxBuffers<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>) → Type {
    match c {
        ReadCmd(_, max) => io.writable(at.memory, read_gpr(Rsi, at.gprs), max),
        WriteCmd(_, _) => True,
        OpenCmd(_) => True,
        CloseCmd(_) => True,
        StatCmd(target) => io.writable(at.memory, stat_buffer(target, at.gprs), stat_length()),
    }
}

fn LinuxRequests<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>) → Type {
    LinuxAsks(io, at, c) ∧ LinuxBuffers(io, at, c)
}

// What Linux may leave in the buffer besides an answer: anything up to the
// buffer's length after a failed read or stat, nothing otherwise.
fn LinuxLeaves(c: LinuxCmd<Nat>) → c.Resp() → List<BitVec(8)> → Type {
    match c {
        ReadCmd(_, max) => λ (r: ReadResult) junk => match r {
            ReadBytes(_) => junk = Nil,
            ReadFailed(_) => junk.len() <= max,
        },
        WriteCmd(_, _) => λ _ junk => junk = Nil,
        OpenCmd(_) => λ _ junk => junk = Nil,
        CloseCmd(_) => λ _ junk => junk = Nil,
        StatCmd(_) => λ (r: StatResult) junk => match r {
            Stated(_) => junk = Nil,
            StatFailed(_) => junk.len() <= stat_length(),
        },
    }
}

// The state Linux resumes the process in after answering `a`, having left
// `junk` and the given RCX and R11.
fn linux_answered<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>) →
    c.Resp() → List<BitVec(8)> → BitVec(64) → BitVec(64) → MachineState<M> {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) junk rcx r11 => match r {
            ReadBytes(bytes) => linux_read_return(io, at, bytes, rcx, r11),
            ReadFailed(errno) => linux_read_failed_return(io, at, errno, junk, rcx, r11),
        },
        WriteCmd(_, _) => λ (r: WriteResult) junk rcx r11 => match r {
            Wrote(count) => linux_write_return(at, bitvec_nat::word_of_nat(64, count), rcx, r11),
            WriteFailed(errno) => linux_write_return(at, errno_word(errno), rcx, r11),
        },
        OpenCmd(_) => λ (r: OpenResult) junk rcx r11 => linux_write_return(at, open_rax(r), rcx, r11),
        CloseCmd(_) => λ (r: CloseResult) junk rcx r11 => linux_write_return(at, close_rax(r), rcx, r11),
        StatCmd(target) => λ (r: StatResult) junk rcx r11 => match r {
            Stated(st) => linux_stat_return(io, at, target, st, BitVec::ofNat(0), rcx, r11),
            StatFailed(errno) => linux_stat_return(io, at, target, junk, errno_word(errno), rcx, r11),
        },
    }
}

// Every way Linux may resume the process after answering `a` meets `next`:
// a claim cannot depend on what Linux leaves behind.
fn LinuxResumes<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(),
    next: MachineState<M> → Type) → Type {
    (junk: List<BitVec(8)>) → LinuxLeaves(c, a, junk) → (rcx, r11: BitVec(64)) →
        next(linux_answered(io, at, c, a, junk, rcx, r11))
}

// The call at `at` is `c`, Linux answered it with `a`, as it may, and every
// way it resumes the process meets `next`.
fn LinuxAnswered<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(),
    next: MachineState<M> → Type) → Type {
    LinuxRequests(io, at, c) ∧ (c.Answers(a) ∧ LinuxResumes(io, at, c, a, next))
}

fn LinuxExits<M>(at: MachineState<M>, status: BitVec(64)) → Type {
    (read_gpr(Rax, at.gprs) = BitVec::ofNat(60)) ∧ (read_gpr(Rdi, at.gprs) = status)
}

// Where Linux may store into the process on answering `c` (a read's buffer
// at RSI, a stat's), and what it stores there: the answer's bytes, or what a
// failure left behind. Every other call leaves memory as it was.
fn linux_buffer(c: LinuxCmd<Nat>, gprs: Gprs) → Option<BitVec(64)> {
    match c {
        ReadCmd(_, _) => Some(read_gpr(Rsi, gprs)),
        WriteCmd(_, _) => None,
        OpenCmd(_) => None,
        CloseCmd(_) => None,
        StatCmd(target) => Some(stat_buffer(target, gprs)),
    }
}
fn linux_stored(c: LinuxCmd<Nat>) → c.Resp() → List<BitVec(8)> → List<BitVec(8)> {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) junk => match r { ReadBytes(bytes) => bytes, ReadFailed(_) => junk },
        WriteCmd(_, _) => λ _ _ => Nil,
        OpenCmd(_) => λ _ _ => Nil,
        CloseCmd(_) => λ _ _ => Nil,
        StatCmd(_) => λ (r: StatResult) junk => match r { Stated(st) => st, StatFailed(_) => junk },
    }
}
fn linux_left<M>(io: LinuxIo<M>, memory: M, c: LinuxCmd<Nat>, gprs: Gprs, a: c.Resp(), junk: List<BitVec(8)>) → M {
    match linux_buffer(c, gprs) { None => memory, Some(buffer) => io.store(memory, buffer, linux_stored(c, a, junk)) }
}

// Every answer resumes past the SYSCALL, with that memory.
theorem linux_answered_memory<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>): (a: c.Resp()) →
    (junk: List<BitVec(8)>) → (rcx, r11: BitVec(64)) →
    linux_answered(io, at, c, a, junk, rcx, r11).memory = linux_left(io, at.memory, c, at.gprs, a, junk) {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) junk rcx r11 => match r { ReadBytes(_) => refl, ReadFailed(_) => refl },
        WriteCmd(_, _) => λ (r: WriteResult) junk rcx r11 => match r { Wrote(_) => refl, WriteFailed(_) => refl },
        OpenCmd(_) => λ _ junk rcx r11 => refl,
        CloseCmd(_) => λ _ junk rcx r11 => refl,
        StatCmd(_) => λ (r: StatResult) junk rcx r11 => match r { Stated(_) => refl, StatFailed(_) => refl },
    }
}
theorem linux_answered_rip<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>): (a: c.Resp()) →
    (junk: List<BitVec(8)>) → (rcx, r11: BitVec(64)) → linux_answered(io, at, c, a, junk, rcx, r11).rip = next_rip(at.rip, 2) {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) junk rcx r11 => match r { ReadBytes(_) => refl, ReadFailed(_) => refl },
        WriteCmd(_, _) => λ (r: WriteResult) junk rcx r11 => match r { Wrote(_) => refl, WriteFailed(_) => refl },
        OpenCmd(_) => λ _ junk rcx r11 => refl,
        CloseCmd(_) => λ _ junk rcx r11 => refl,
        StatCmd(_) => λ (r: StatResult) junk rcx r11 => match r { Stated(_) => refl, StatFailed(_) => refl },
    }
}

// Nothing left behind is always one choice.
theorem linux_leaves_nil(c: LinuxCmd<Nat>): (a: c.Resp()) → LinuxLeaves(c, a, Nil) {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) => match r { ReadBytes(_) => refl, ReadFailed(_) => trivial },
        WriteCmd(_, _) => λ _ => refl,
        OpenCmd(_) => λ _ => refl,
        CloseCmd(_) => λ _ => refl,
        StatCmd(_) => λ (r: StatResult) => match r { Stated(_) => refl, StatFailed(_) => trivial },
    }
}

// Resuming meets anything weaker than what it met.
theorem linux_resumes_mono<M>(io: LinuxIo<M>, at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(),
    next, more: MachineState<M> → Type, weaker: (state: MachineState<M>) → next(state) → more(state),
    resumes: LinuxResumes(io, at, c, a, next)): LinuxResumes(io, at, c, a, more) {
    λ junk leaves rcx r11 => weaker(linux_answered(io, at, c, a, junk, rcx, r11), resumes(junk, leaves, rcx, r11))
}

// Linux's answers read only defined components and keep the flags, so each
// commutes with erasing AF by `refl`.
theorem linux_answered_respects<M>(io: LinuxIo<M>, c: LinuxCmd<Nat>): (a: c.Resp()) → (junk: List<BitVec(8)>) →
    (rcx, r11: BitVec(64)) →
    PreservesRelation(SameDefinedState<M>, SameDefinedState<M>, λ state => linux_answered(io, state, c, a, junk, rcx, r11)) {
    match c {
        ReadCmd(_, _) => λ (r: ReadResult) junk rcx r11 => match r {
            ReadBytes(bytes) => same_defined_respects<M>(λ state => linux_read_return(io, state, bytes, rcx, r11), λ state => refl),
            ReadFailed(errno) =>
                same_defined_respects<M>(λ state => linux_read_failed_return(io, state, errno, junk, rcx, r11), λ state => refl),
        },
        WriteCmd(_, _) => λ (r: WriteResult) junk rcx r11 => match r {
            Wrote(count) => same_defined_respects<M>(
                λ state => linux_write_return(state, bitvec_nat::word_of_nat(64, count), rcx, r11), λ state => refl),
            WriteFailed(errno) =>
                same_defined_respects<M>(λ state => linux_write_return(state, errno_word(errno), rcx, r11), λ state => refl),
        },
        OpenCmd(_) => λ (r: OpenResult) junk rcx r11 =>
            same_defined_respects<M>(λ state => linux_write_return(state, open_rax(r), rcx, r11), λ state => refl),
        CloseCmd(_) => λ (r: CloseResult) junk rcx r11 =>
            same_defined_respects<M>(λ state => linux_write_return(state, close_rax(r), rcx, r11), λ state => refl),
        StatCmd(target) => λ (r: StatResult) junk rcx r11 => match r {
            Stated(st) => same_defined_respects<M>(
                λ state => linux_stat_return(io, state, target, st, BitVec::ofNat(0), rcx, r11), λ state => refl),
            StatFailed(errno) => same_defined_respects<M>(
                λ state => linux_stat_return(io, state, target, junk, errno_word(errno), rcx, r11), λ state => refl),
        },
    }
}

// A run producing exactly `events`, ending at an exit.
fn LinuxRuns<M>(io: LinuxIo<M>, events: List<LinuxEvent>) → MachineState<M> → Type {
    match events {
        Nil => λ state => False,
        Cons(event, rest) => λ state => Exists<MachineState<M>>(λ at =>
            LinuxSteps(io, state, at) ∧ (LinuxSyscallAt(io, at) ∧
            match event as λ _ => Type {
                CallEvent(c, a) => LinuxAnswered(io, at, c, a, LinuxRuns(io, rest)),
                ExitEvent(status) => LinuxExits(at, status) ∧ (rest = Nil),
            })),
    }
}

theorem linux_runs_after_linux_steps<M>(io: LinuxIo<M>, events: List<LinuxEvent>, before, middle: MachineState<M>,
    steps: LinuxSteps(io, before, middle), runs: LinuxRuns(io, events, middle)):
    LinuxRuns(io, events, before) {
    match events {
        Nil => runs,
        Cons(_, _) => Exists(runs.witness,
            ⟨linux_steps_trans(io, before, middle, runs.witness, steps, runs.proof.left), runs.proof.right⟩),
    }
}

theorem linux_runs_after_steps<M>(io: LinuxIo<M>, events: List<LinuxEvent>, before, middle: MachineState<M>,
    steps: FetchedSteps(io.fetch, io.data, before, middle), runs: LinuxRuns(io, events, middle)):
    LinuxRuns(io, events, before) {
    linux_runs_after_linux_steps(io, events, before, middle, linux_steps_of_fetched(io, before, middle, steps), runs)
}

theorem linux_runs_exit<M>(io: LinuxIo<M>, before, at: MachineState<M>, status: BitVec(64),
    steps: FetchedSteps(io.fetch, io.data, before, at), syscall: LinuxSyscallAt(io, at),
    number: read_gpr(Rax, at.gprs) = BitVec::ofNat(60), code: read_gpr(Rdi, at.gprs) = status):
    LinuxRuns(io, [ExitEvent(status)], before) {
    Exists(at, ⟨linux_steps_of_fetched(io, before, at, steps), ⟨syscall, ⟨⟨number, code⟩, refl⟩⟩⟩)
}

theorem linux_runs_call<M>(io: LinuxIo<M>, before, at: MachineState<M>, c: LinuxCmd<Nat>, a: c.Resp(),
    rest: List<LinuxEvent>, steps: LinuxSteps(io, before, at), syscall: LinuxSyscallAt(io, at),
    answered: LinuxAnswered(io, at, c, a, LinuxRuns(io, rest))):
    LinuxRuns(io, Cons(CallEvent(c, a), rest), before) {
    Exists(at, ⟨steps, ⟨syscall, answered⟩⟩)
}

// The exit-only profile's request is this relation's exit event.
theorem linux_exit_request_runs<M>(io: LinuxIo<M>, state: MachineState<M>, result: BitVec(64),
    syscall: LinuxSyscallAt(io, state), request: LinuxExitRequest<M>(state, result)):
    LinuxRuns(io, [ExitEvent(result)], state) {
    linux_runs_exit(io, state, state, result, fetched_steps_refl(io.fetch, io.data, state), syscall,
        request.number, request.status)
}

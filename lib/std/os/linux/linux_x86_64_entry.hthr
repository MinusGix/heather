// Register-only process entry and Linux exit-request setup. These use the
// canonical x86 model. The terminal SYSCALL is an explicit OS boundary,
// NOT a new case of the architecture's normal instruction execution relation.
import x86_64;
import x86_64_block;
import bitvec;
import list;
import logic;

fn linux_entry_instructions(left, right: BitVec(64)) → List<Instruction> {
    [MovRI(Rdi, left), MovRI(Rsi, right)]
}

fn linux_entry_state<M>(left, right: BitVec(64), before: MachineState<M>) →
    MachineState<M>
{
    execute_normal(decoded_canonical(MovRI(Rsi, right)),
        execute_normal(decoded_canonical(MovRI(Rdi, left)), before))
}

theorem linux_entry_left<M>(left, right: BitVec(64), before: MachineState<M>):
    read_gpr(Rdi, linux_entry_state(left, right, before).gprs) = left
{ refl }

theorem linux_entry_right<M>(left, right: BitVec(64), before: MachineState<M>):
    read_gpr(Rsi, linux_entry_state(left, right, before).gprs) = right
{ refl }

theorem linux_entry_executes<M>(left, right: BitVec(64), before: MachineState<M>):
    ExecuteBlock(linux_entry_instructions(left, right), before,
        linux_entry_state(left, right, before))
{ canonical_block_executes_normal(linux_entry_instructions(left, right), before, refl) }

fn linux_exit_instructions() → List<Instruction> {
    [MovRR(Rdi, Rax), MovRI(Rax, BitVec::ofNat(60))]
}

fn linux_exit_state<M>(before: MachineState<M>) → MachineState<M> {
    execute_normal(decoded_canonical(MovRI(Rax, BitVec::ofNat(60))),
        execute_normal(decoded_canonical(MovRR(Rdi, Rax)), before))
}

theorem linux_exit_executes<M>(before: MachineState<M>):
    ExecuteBlock(linux_exit_instructions(), before, linux_exit_state(before))
{ canonical_block_executes_normal(linux_exit_instructions(), before, refl) }

theorem linux_exit_number<M>(before: MachineState<M>):
    read_gpr(Rax, linux_exit_state(before).gprs) = BitVec::ofNat(60)
{ refl }

theorem linux_exit_value<M>(before: MachineState<M>):
    read_gpr(Rdi, linux_exit_state(before).gprs) = read_gpr(Rax, before.gprs)
{ refl }

// A request presented to Linux, before the SYSCALL transfer. The environment
// contract is that executing 0F 05 with this request terminates the initial
// thread and exposes the low eight status bits to the parent. No theorem
// here claims to verify Linux, its syscall entry, or architectural fetch.
record LinuxExitRequest<M>(state: MachineState<M>, result: BitVec(64)) {
    number: read_gpr(Rax, state.gprs) = BitVec::ofNat(60),
    status: read_gpr(Rdi, state.gprs) = result,
}

theorem linux_exit_request<M>(before: MachineState<M>):
    LinuxExitRequest<M>(linux_exit_state(before), read_gpr(Rax, before.gprs))
{ LinuxExitRequest(linux_exit_number(before), linux_exit_value(before)) }

// Composition stops immediately before the OS transfer, with every ordinary
// instruction covered by the existing ExecuteBlock relation.
record LinuxInlineTrace<M>(body: List<Instruction>, left, right: BitVec(64),
    before: MachineState<M>, result: BitVec(64))
{
    after_body: MachineState<M>,
    entry_execution: ExecuteBlock(linux_entry_instructions(left, right),
        before, linux_entry_state(left, right, before)),
    body_execution: ExecuteBlock(body, linux_entry_state(left, right, before), after_body),
    exit_execution: ExecuteBlock(linux_exit_instructions(), after_body, linux_exit_state(after_body)),
    request: LinuxExitRequest<M>(linux_exit_state(after_body), result),
}

// Fixed-width bitvectors. A `BitVec(n)` is a kernel vector of `n` Booleans,
// least-significant bit first: index zero has weight one. Consequently
// `BitVec(0)` has exactly the single value `[]`; operations at width zero are
// total and discard all input information. Equality is ordinary vector
// equality, so no quotient or proof field is hidden in the carrier.
//
// Arithmetic interpretation is explicit. `toNat` is unsigned and `toInt` is
// two's-complement signed. Construction and arithmetic reduce modulo `2^n`;
// bitwise operations, slicing, and extension agree pointwise with those
// interpretations. Shift counts are mathematical counts and are never masked
// to an instruction-set-specific width.

import bool;
import logic;
import nat;
import int;
import pair;

record BitVec(n: Nat) { bits: [Bool; n] }

fn from_bits(n: Nat, bits: [Bool; n]) → BitVec(n) { BitVec(bits) }

fn cons_bit(n: Nat, b: Bool, x: BitVec(n)) → BitVec(Succ(n)) {
    from_bits(Succ(n), cons(b, x.bits))
}

fn head_bit(n: Nat, x: BitVec(Succ(n))) → Bool { head(x.bits) }

fn tail_bits(n: Nat, x: BitVec(Succ(n))) → BitVec(n) {
    from_bits(n, tail(x.bits))
}

// ---------------------------------------------------------------------------
// Bits and constructors

fn xor_bit(a, b: Bool) → Bool {
    match a { False => b, True => bool::not(b) }
}

fn bit_value(b: Bool) → Nat { match b { False => 0, True => 1 } }

fn repeat_bit(n: Nat, b: Bool) → BitVec(n) {
    match n as λ k => BitVec(k) {
        Zero => from_bits(0, []),
        Succ(k, ih) => cons_bit(k, b, ih),
    }
}

fn zero(n: Nat) → BitVec(n) { repeat_bit(n, False) }
fn all_ones(n: Nat) → BitVec(n) { repeat_bit(n, True) }

// `one(0)` is `zero(0)`; at a positive width its sole set bit is index zero.
fn one(n: Nat) → BitVec(n) {
    match n as λ k => BitVec(k) {
        Zero => from_bits(0, []),
        Succ(k) => cons_bit(k, True, zero(k)),
    }
}

fn ofBool(value: Bool) → BitVec(1) { from_bits(1, [value]) }

fn get(n: Nat, x: BitVec(n), i: Fin(n)) → Bool { x.bits[i] }

fn set(n: Nat) → BitVec(n) → Fin(n) → Bool → BitVec(n) {
    match n as λ k => BitVec(k) → Fin(k) → Bool → BitVec(k) {
        Zero => λ x i b => match i { },
        Succ(k, ih) => λ x i b => match i {
            FZ => cons_bit(k, b, tail_bits(k, x)),
            FS(j) => cons_bit(k, head_bit(k, x), ih(tail_bits(k, x), j, b)),
        },
    }
}

// ---------------------------------------------------------------------------
// Pointwise logic

fn complement(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k, ih) => λ x => cons_bit(k, bool::not(head_bit(k, x)), ih(tail_bits(k, x))),
    }
}

fn band(n: Nat) → BitVec(n) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => from_bits(0, []),
        Succ(k, ih) => λ x y => cons_bit(k, head_bit(k, x) && head_bit(k, y), ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

fn bor(n: Nat) → BitVec(n) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => from_bits(0, []),
        Succ(k, ih) => λ x y => cons_bit(k, head_bit(k, x) || head_bit(k, y), ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

fn bxor(n: Nat) → BitVec(n) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) → BitVec(k) {
        Zero => λ x y => from_bits(0, []),
        Succ(k, ih) => λ x y => cons_bit(k, xor_bit(head_bit(k, x), head_bit(k, y)), ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

// ---------------------------------------------------------------------------
// Shape operations. `concat(n,m,lo,hi)` keeps the little-endian convention:
// the `n` low bits precede the `m` high bits. `nat::add` recurses on its second
// argument, hence the result index is written `m + n` so this computes while
// recursing over `lo` at an open width.

fn concat(n: Nat) → (m: Nat) → BitVec(n) → BitVec(m) → BitVec(m + n) {
    match n as λ k => (m: Nat) → BitVec(k) → BitVec(m) → BitVec(m + k) {
        Zero => λ m lo hi => hi,
        Succ(k, ih) => λ m lo hi => cons_bit(m + k, head_bit(k, lo), ih(m, tail_bits(k, lo), hi)),
    }
}

fn take_low(n: Nat) → (m: Nat) → BitVec(m + n) → BitVec(n) {
    match n as λ k => (m: Nat) → BitVec(m + k) → BitVec(k) {
        Zero => λ m x => from_bits(0, []),
        Succ(k, ih) => λ m x => cons_bit(k, head_bit(m + k, x), ih(m, tail_bits(m + k, x))),
    }
}

fn drop_low(n: Nat) → (m: Nat) → BitVec(m + n) → BitVec(m) {
    match n as λ k => (m: Nat) → BitVec(m + k) → BitVec(m) {
        Zero => λ m x => x,
        Succ(k, ih) => λ m x => ih(m, tail_bits(m + k, x)),
    }
}

fn split(n: Nat, m: Nat, x: BitVec(m + n)) → Pair<BitVec(n), BitVec(m)> {
    Pair(take_low(n, m, x), drop_low(n, m, x))
}

// A bounded slice: discard `skip` low bits and return the next `width` bits;
// `rest` makes the required input bound structural rather than propositional.
fn slice(skip, width, rest: Nat, x: BitVec((rest + width) + skip)) → BitVec(width) {
    take_low(width, rest, drop_low(skip, rest + width, x))
}

fn truncate(n, extra: Nat, x: BitVec(extra + n)) → BitVec(n) {
    take_low(n, extra, x)
}

fn zero_extend(n, extra: Nat, x: BitVec(n)) → BitVec(extra + n) {
    concat(n, extra, x, zero(extra))
}

// Sign extension is defined separately at width zero because an empty vector
// has no sign bit. The canonical policy maps it to zero at every larger width.
fn sign_extend_zero(extra: Nat, x: BitVec(0)) → BitVec(extra) { zero(extra) }

fn last_index(n: Nat) → Fin(Succ(n)) {
    match n as λ k => Fin(Succ(k)) {
        Zero => FZ,
        Succ(k, ih) => FS(ih),
    }
}

fn sign_extend(n, extra: Nat, x: BitVec(Succ(n))) → BitVec(extra + Succ(n)) {
    concat(Succ(n), extra, x, repeat_bit(extra, get(Succ(n), x, last_index(n))))
}

// ---------------------------------------------------------------------------
// Unsigned and signed interpretation

fn toNat(n: Nat) → BitVec(n) → Nat {
    match n as λ k => BitVec(k) → Nat {
        Zero => λ x => 0,
        Succ(k, ih) => λ x => bit_value(head_bit(k, x)) + twice(ih(tail_bits(k, x))),
    }
}

fn nat_bit(x: Nat) → Bool {
    match nat::even_dec(x) { Inl(_) => False, Inr(_) => True }
}

fn ofNat(n: Nat) → Nat → BitVec(n) {
    match n as λ k => Nat → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k, ih) => λ x => cons_bit(k, nat_bit(x), ih(nat::half(x))),
    }
}

fn sign_bit(n: Nat) → BitVec(n) → Bool {
    match n as λ k => BitVec(k) → Bool {
        Zero => λ x => False,
        Succ(k) => λ x => get(Succ(k), x, last_index(k)),
    }
}

fn toInt(n: Nat, x: BitVec(n)) → Int {
    match sign_bit(n, x) {
        False => OfNat(toNat(n, x)),
        True => int::sub(OfNat(toNat(n, x)), OfNat(nat::pow(2, n))),
    }
}

fn unsigned_le(n: Nat, a, b: BitVec(n)) → Type { toNat(n, a) <= toNat(n, b) }
fn unsigned_lt(n: Nat, a, b: BitVec(n)) → Type { toNat(n, a) < toNat(n, b) }
fn signed_le(n: Nat, a, b: BitVec(n)) → Type { int::Le(toInt(n, a), toInt(n, b)) }
fn signed_lt(n: Nat, a, b: BitVec(n)) → Type { int::Lt(toInt(n, a), toInt(n, b)) }

// ---------------------------------------------------------------------------
// Modular arithmetic and reusable ALU predicates

fn increment(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k, ih) => λ x => match head_bit(k, x) {
            False => cons_bit(k, True, tail_bits(k, x)),
            True => cons_bit(k, False, ih(tail_bits(k, x))),
        },
    }
}

fn decrement(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k, ih) => λ x => match head_bit(k, x) {
            False => cons_bit(k, True, ih(tail_bits(k, x))),
            True => cons_bit(k, False, tail_bits(k, x)),
        },
    }
}

fn iterate_increment(n: Nat, x: BitVec(n), count: Nat) → BitVec(n) {
    match count {
        Zero => x,
        Succ(k) => increment(n, iterate_increment(n, x, k)),
    }
}

fn iterate_decrement(n: Nat, count: Nat) → BitVec(n) → BitVec(n) {
    match count as λ k => BitVec(n) → BitVec(n) {
        Zero => λ x => x,
        Succ(k, ih) => λ x => ih(decrement(n, x)),
    }
}

fn add(n: Nat, a, b: BitVec(n)) → BitVec(n) {
    iterate_increment(n, a, toNat(n, b))
}

fn sub(n: Nat, a, b: BitVec(n)) → BitVec(n) {
    iterate_decrement(n, toNat(n, b), a)
}

fn neg(n: Nat, a: BitVec(n)) → BitVec(n) { sub(n, zero(n), a) }

fn mul(n: Nat, a, b: BitVec(n)) → BitVec(n) {
    ofNat(n, toNat(n, a) * toNat(n, b))
}

fn carry_add(n: Nat, a, b: BitVec(n)) → Type {
    nat::pow(2, n) <= toNat(n, a) + toNat(n, b)
}

// Executable carry view. `carry_add` above is the arithmetic proposition used
// by proofs; instruction semantics and other evaluators need the same fact as
// a Boolean without deciding an open comparison involving `2^n`. This ripple
// runs structurally over the bits and therefore remains linear at width 64.
fn carry_majority(a, b, carry: Bool) → Bool {
    (a && b) || ((a && carry) || (b && carry))
}

fn carry_bits_next(n: Nat, a, b: BitVec(n), carry: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → Bool) → Bool
{
    match carry {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

fn carry_bits(n: Nat) → BitVec(n) → BitVec(n) → Bool → Bool {
    match n as λ k => BitVec(k) → BitVec(k) → Bool → Bool {
        Zero => λ a b carry => carry,
        // Force the next accumulator before recurring. Leaving this as the
        // third argument expression builds a chain of suspended majority
        // computations whose environments retain every preceding vector
        // projection; a machine-width closed computation then has quadratic
        // reduction work and pathological retained state despite the ripple
        // algorithm itself being linear.
        Succ(k, ih) => λ a b carry => carry_bits_next(
            k, tail_bits(k, a), tail_bits(k, b),
            carry_majority(head_bit(k, a), head_bit(k, b), carry), ih),
    }
}

fn carry_add_bit(n: Nat, a, b: BitVec(n)) → Bool {
    carry_bits(n, a, b, False)
}

// ---------------------------------------------------------------------------
// Structural carry agrees with the unsigned arithmetic characterization.

fn carry_weight(a, b, carry: Bool) → Nat {
    (bit_value(a) + bit_value(b)) + bit_value(carry)
}

theorem carry_sum_normalize(x, y, z, a, b: Nat):
    (x + twice(a)) + (y + twice(b)) + z =
    twice(a + b) + ((x + y) + z)
{
    calc {
        (x + twice(a)) + (y + twice(b)) + z
            = ((x + y) + (twice(a) + twice(b))) + z :=
                cong_nat(λ (q: Nat) => q + z,
                    nat::add_swap_middle(x, twice(a), y, twice(b))),
            = ((twice(a) + twice(b)) + (x + y)) + z :=
                cong_nat(λ (q: Nat) => q + z,
                    nat::add_comm(x + y, twice(a) + twice(b))),
            = (twice(a) + twice(b)) + ((x + y) + z) :=
                nat::add_assoc(twice(a) + twice(b), x + y, z),
            = twice(a + b) + ((x + y) + z) :=
                cong_nat(λ (q: Nat) => q + ((x + y) + z),
                    sym(twice_add(a, b))),
    }
}

theorem pow_two_succ_twice(n: Nat):
    nat::pow(2, Succ(n)) = twice(nat::pow(2, n))
{
    let p = nat::pow(2, n);
    calc {
        nat::pow(2, Succ(n))
            = (0 + p) + p := refl,
            = p + p := cong_nat(λ (q: Nat) => q + p, nat::add_left_zero(p)),
            = twice(p) := sym(twice_add_self(p)),
    }
}

theorem carry_threshold(a, b, carry: Bool, power, tail_sum: Nat):
    (twice(power) <= twice(tail_sum) + carry_weight(a, b, carry)) ↔
    (power <= tail_sum + bit_value(carry_majority(a, b, carry)))
{
    match a {
        False => match b {
            False => match carry {
                False => twice_le_twice_iff(power, tail_sum),
                True => twice_le_succ_twice_iff(power, tail_sum),
            },
            True => match carry {
                False => twice_le_succ_twice_iff(power, tail_sum),
                True => twice_le_twice_iff(power, Succ(tail_sum)),
            },
        },
        True => match b {
            False => match carry {
                False => twice_le_succ_twice_iff(power, tail_sum),
                True => twice_le_twice_iff(power, Succ(tail_sum)),
            },
            True => match carry {
                False => twice_le_twice_iff(power, Succ(tail_sum)),
                True => twice_le_succ_twice_iff(power, Succ(tail_sum)),
            },
        },
    }
}

fn CarryBitTrue(n: Nat, a, b: BitVec(n), carry: Bool) → Type {
    carry_bits(n, a, b, carry) = True
}

fn CarryArithmetic(n: Nat, a, b: BitVec(n), carry: Bool) → Type {
    nat::pow(2, n) <= toNat(n, a) + toNat(n, b) + bit_value(carry)
}

theorem carry_bits_step(n: Nat, a, b: BitVec(Succ(n)), carry: Bool):
    CarryBitTrue(Succ(n), a, b, carry) ↔
    CarryBitTrue(n, tail_bits(n, a), tail_bits(n, b),
        carry_majority(head_bit(n, a), head_bit(n, b), carry))
{
    match carry_majority(head_bit(n, a), head_bit(n, b), carry)
        as λ next =>
            (carry_bits_next(n, tail_bits(n, a), tail_bits(n, b), next,
                carry_bits(n)) = True) ↔
            CarryBitTrue(n, tail_bits(n, a), tail_bits(n, b), next)
    {
        False => Iff(mp := λ h => h, mpr := λ h => h),
        True => Iff(mp := λ h => h, mpr := λ h => h),
    }
}

theorem carry_arithmetic_step(n: Nat, a, b: BitVec(Succ(n)), carry: Bool):
    CarryArithmetic(Succ(n), a, b, carry) ↔
    CarryArithmetic(n, tail_bits(n, a), tail_bits(n, b),
        carry_majority(head_bit(n, a), head_bit(n, b), carry))
{
    let left = toNat(n, tail_bits(n, a));
    let right = toNat(n, tail_bits(n, b));
    iff_trans(
        le_congr_iff(
            nat::pow(2, Succ(n)), twice(nat::pow(2, n)),
            toNat(Succ(n), a) + toNat(Succ(n), b) + bit_value(carry),
            twice(left + right) +
                carry_weight(head_bit(n, a), head_bit(n, b), carry),
            pow_two_succ_twice(n),
            carry_sum_normalize(
                bit_value(head_bit(n, a)), bit_value(head_bit(n, b)),
                bit_value(carry), left, right)),
        carry_threshold(head_bit(n, a), head_bit(n, b), carry,
            nat::pow(2, n), left + right))
}

theorem carry_bits_true_iff_arithmetic(n: Nat):
    (a, b: BitVec(n)) → (carry: Bool) →
    Iff<CarryBitTrue(n, a, b, carry), CarryArithmetic(n, a, b, carry)>
{
    match n as λ k => (a, b: BitVec(k)) → (carry: Bool) →
        Iff<CarryBitTrue(k, a, b, carry), CarryArithmetic(k, a, b, carry)> {
        Zero => λ a b carry => match carry {
            False => Iff(
                mp := λ bad => absurd(bad),
                mpr := λ bad => false_elim(bad)),
            True => Iff(mp := λ h => trivial, mpr := λ h => refl),
        },
        Succ(k, ih) => λ a b carry => iff_trans(
            carry_bits_step(k, a, b, carry),
            iff_trans(
                ih(tail_bits(k, a), tail_bits(k, b),
                    carry_majority(head_bit(k, a), head_bit(k, b), carry)),
                iff_sym(carry_arithmetic_step(k, a, b, carry)))),
    }
}

theorem carry_add_bit_true_iff(n: Nat, a, b: BitVec(n)):
    (carry_add_bit(n, a, b) = True) ↔ carry_add(n, a, b)
{
    carry_bits_true_iff_arithmetic(n, a, b, False)
}

theorem carry_add_of_bit_true(n: Nat, a, b: BitVec(n),
    h: carry_add_bit(n, a, b) = True): carry_add(n, a, b)
{
    carry_add_bit_true_iff(n, a, b).mp(h)
}

theorem carry_add_bit_of_carry(n: Nat, a, b: BitVec(n),
    h: carry_add(n, a, b)): carry_add_bit(n, a, b) = True
{
    carry_add_bit_true_iff(n, a, b).mpr(h)
}

fn borrow_sub(n: Nat, a, b: BitVec(n)) → Type { toNat(n, a) < toNat(n, b) }

// Executable ripple-borrow view for subtraction. Like `carry_add_bit`, this
// runs over the vector structure rather than deciding an open Nat comparison.
fn borrow_next(a, b, borrow: Bool) → Bool {
    (bool::not(a) && b) || (bool::not(xor_bit(a, b)) && borrow)
}

fn borrow_bits_next(n: Nat, a, b: BitVec(n), borrow: Bool,
    rest: BitVec(n) → BitVec(n) → Bool → Bool) → Bool
{
    match borrow {
        False => rest(a, b, False),
        True => rest(a, b, True),
    }
}

fn borrow_bits(n: Nat) → BitVec(n) → BitVec(n) → Bool → Bool {
    match n as λ k => BitVec(k) → BitVec(k) → Bool → Bool {
        Zero => λ a b borrow => borrow,
        Succ(k, ih) => λ a b borrow => borrow_bits_next(
            k, tail_bits(k, a), tail_bits(k, b),
            borrow_next(head_bit(k, a), head_bit(k, b), borrow), ih),
    }
}

fn borrow_sub_bit(n: Nat, a, b: BitVec(n)) → Bool {
    borrow_bits(n, a, b, False)
}

// ---------------------------------------------------------------------------
// Structural borrow agrees with the unsigned arithmetic characterization.

fn bit_with_tail(bit: Bool, tail: Nat) → Nat {
    match bit { False => twice(tail), True => Succ(twice(tail)) }
}

theorem bit_with_tail_normalize(bit: Bool, tail: Nat):
    bit_value(bit) + twice(tail) = bit_with_tail(bit, tail)
{
    match bit {
        False => nat::add_left_zero(twice(tail)),
        True => trans(nat::add_succ_left(0, twice(tail)),
            cong_succ(nat::add_left_zero(twice(tail)))),
    }
}

fn borrow_right_value(bit, borrow: Bool, tail: Nat) → Nat {
    match bit {
        False => match borrow {
            False => twice(tail),
            True => Succ(twice(tail)),
        },
        True => match borrow {
            False => Succ(twice(tail)),
            True => twice(Succ(tail)),
        },
    }
}

theorem borrow_right_normalize(bit, borrow: Bool, tail: Nat):
    bit_value(bit) + twice(tail) + bit_value(borrow) =
        borrow_right_value(bit, borrow, tail)
{
    match bit {
        False => match borrow {
            False => nat::add_left_zero(twice(tail)),
            True => cong_succ(nat::add_left_zero(twice(tail))),
        },
        True => match borrow {
            False => trans(nat::add_succ_left(0, twice(tail)),
                cong_succ(nat::add_left_zero(twice(tail)))),
            True => cong_succ(trans(nat::add_succ_left(0, twice(tail)),
                cong_succ(nat::add_left_zero(twice(tail))))),
        },
    }
}

theorem borrow_threshold(a, b, borrow: Bool, left, right: Nat):
    (bit_with_tail(a, left) < borrow_right_value(b, borrow, right)) ↔
    (left < right + bit_value(borrow_next(a, b, borrow)))
{
    match a {
        False => match b {
            False => match borrow {
                False => nat::twice_lt_twice_iff(left, right),
                True => nat::twice_lt_succ_twice_iff(left, right),
            },
            True => match borrow {
                False => nat::twice_lt_succ_twice_iff(left, right),
                True => nat::twice_lt_twice_iff(left, Succ(right)),
            },
        },
        True => match b {
            False => match borrow {
                False => nat::twice_le_twice_iff(Succ(left), right),
                True => nat::twice_lt_twice_iff(left, right),
            },
            True => match borrow {
                False => nat::twice_lt_twice_iff(left, right),
                True => nat::twice_le_twice_iff(Succ(left), Succ(right)),
            },
        },
    }
}

fn BorrowBitTrue(n: Nat, a, b: BitVec(n), borrow: Bool) → Type {
    borrow_bits(n, a, b, borrow) = True
}

fn BorrowArithmetic(n: Nat, a, b: BitVec(n), borrow: Bool) → Type {
    toNat(n, a) < toNat(n, b) + bit_value(borrow)
}

theorem borrow_bits_step(n: Nat, a, b: BitVec(Succ(n)), borrow: Bool):
    BorrowBitTrue(Succ(n), a, b, borrow) ↔
    BorrowBitTrue(n, tail_bits(n, a), tail_bits(n, b),
        borrow_next(head_bit(n, a), head_bit(n, b), borrow))
{
    match borrow_next(head_bit(n, a), head_bit(n, b), borrow)
        as λ next =>
            (borrow_bits_next(n, tail_bits(n, a), tail_bits(n, b), next,
                borrow_bits(n)) = True) ↔
            BorrowBitTrue(n, tail_bits(n, a), tail_bits(n, b), next)
    {
        False => Iff(mp := λ h => h, mpr := λ h => h),
        True => Iff(mp := λ h => h, mpr := λ h => h),
    }
}

theorem borrow_arithmetic_step(n: Nat, a, b: BitVec(Succ(n)), borrow: Bool):
    BorrowArithmetic(Succ(n), a, b, borrow) ↔
    BorrowArithmetic(n, tail_bits(n, a), tail_bits(n, b),
        borrow_next(head_bit(n, a), head_bit(n, b), borrow))
{
    let left = toNat(n, tail_bits(n, a));
    let right = toNat(n, tail_bits(n, b));
    iff_trans(
        nat::lt_congr_iff(
            toNat(Succ(n), a), bit_with_tail(head_bit(n, a), left),
            toNat(Succ(n), b) + bit_value(borrow),
            borrow_right_value(head_bit(n, b), borrow, right),
            bit_with_tail_normalize(head_bit(n, a), left),
            borrow_right_normalize(head_bit(n, b), borrow, right)),
        borrow_threshold(head_bit(n, a), head_bit(n, b), borrow, left, right))
}

theorem borrow_bits_true_iff_arithmetic(n: Nat):
    (a, b: BitVec(n)) → (borrow: Bool) →
    Iff<BorrowBitTrue(n, a, b, borrow), BorrowArithmetic(n, a, b, borrow)>
{
    match n as λ k => (a, b: BitVec(k)) → (borrow: Bool) →
        Iff<BorrowBitTrue(k, a, b, borrow), BorrowArithmetic(k, a, b, borrow)> {
        Zero => λ a b borrow => match borrow {
            False => Iff(
                mp := λ bad => absurd(bad),
                mpr := λ bad => false_elim(bad)),
            True => Iff(mp := λ h => trivial, mpr := λ h => refl),
        },
        Succ(k, ih) => λ a b borrow => iff_trans(
            borrow_bits_step(k, a, b, borrow),
            iff_trans(
                ih(tail_bits(k, a), tail_bits(k, b),
                    borrow_next(head_bit(k, a), head_bit(k, b), borrow)),
                iff_sym(borrow_arithmetic_step(k, a, b, borrow)))),
    }
}

theorem borrow_sub_bit_true_iff(n: Nat, a, b: BitVec(n)):
    (borrow_sub_bit(n, a, b) = True) ↔ borrow_sub(n, a, b)
{
    borrow_bits_true_iff_arithmetic(n, a, b, False)
}

theorem borrow_sub_of_bit_true(n: Nat, a, b: BitVec(n),
    h: borrow_sub_bit(n, a, b) = True): borrow_sub(n, a, b)
{
    borrow_sub_bit_true_iff(n, a, b).mp(h)
}

theorem borrow_sub_bit_of_borrow(n: Nat, a, b: BitVec(n),
    h: borrow_sub(n, a, b)): borrow_sub_bit(n, a, b) = True
{
    borrow_sub_bit_true_iff(n, a, b).mpr(h)
}

fn bool_eq(a, b: Bool) → Bool {
    match a { False => bool::not(b), True => b }
}

fn signed_overflow_add(n: Nat, a, b: BitVec(n)) → Bool {
    (bool_eq(sign_bit(n, a), sign_bit(n, b))) &&
    bool::not(bool_eq(sign_bit(n, add(n, a, b)), sign_bit(n, a)))
}

fn signed_overflow_sub(n: Nat, a, b: BitVec(n)) → Bool {
    bool::not(bool_eq(sign_bit(n, a), sign_bit(n, b))) &&
    bool::not(bool_eq(sign_bit(n, sub(n, a, b)), sign_bit(n, a)))
}

// Executable comparison results used by instruction semantics and IRs. The
// proposition-valued interpretations above remain the proof-facing boundary.
fn unsigned_lt_bit(n: Nat, a, b: BitVec(n)) → Bool {
    borrow_sub_bit(n, a, b)
}

fn signed_lt_bit(n: Nat, a, b: BitVec(n)) → Bool {
    xor_bit(sign_bit(n, sub(n, a, b)), signed_overflow_sub(n, a, b))
}

// ---------------------------------------------------------------------------
// Shifts. Vacated bits are zero except for arithmetic right shift.

fn init(n: Nat) → BitVec(Succ(n)) → BitVec(n) {
    match n as λ k => BitVec(Succ(k)) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k, ih) => λ x => cons_bit(k, head_bit(Succ(k), x), ih(tail_bits(Succ(k), x))),
    }
}

fn snoc(n: Nat) → BitVec(n) → Bool → BitVec(Succ(n)) {
    match n as λ k => BitVec(k) → Bool → BitVec(Succ(k)) {
        Zero => λ x b => from_bits(1, [b]),
        Succ(k, ih) => λ x b => cons_bit(Succ(k), head_bit(k, x), ih(tail_bits(k, x), b)),
    }
}

fn shift_left_one(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k) => λ x => cons_bit(k, False, init(k, x)),
    }
}

fn shift_right_one(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k) => λ x => snoc(k, tail_bits(k, x), False),
    }
}

fn arithmetic_shift_right_one(n: Nat) → BitVec(n) → BitVec(n) {
    match n as λ k => BitVec(k) → BitVec(k) {
        Zero => λ x => from_bits(0, []),
        Succ(k) => λ x => snoc(k, tail_bits(k, x), sign_bit(Succ(k), x)),
    }
}

fn shift_left(n: Nat, x: BitVec(n), count: Nat) → BitVec(n) {
    match count { Zero => x, Succ(k) => shift_left_one(n, shift_left(n, x, k)) }
}

fn shift_right(n: Nat, x: BitVec(n), count: Nat) → BitVec(n) {
    match count { Zero => x, Succ(k) => shift_right_one(n, shift_right(n, x, k)) }
}

fn arithmetic_shift_right(n: Nat, x: BitVec(n), count: Nat) → BitVec(n) {
    match count {
        Zero => x,
        Succ(k) => arithmetic_shift_right_one(n, arithmetic_shift_right(n, x, k)),
    }
}

// ---------------------------------------------------------------------------
// Core pointwise laws. More arithmetic laws are stated through the explicit
// `toNat`/`toInt` boundary above; no theorem silently treats wrapped arithmetic
// as unbounded arithmetic.

theorem xor_bit_self(b: Bool): xor_bit(b, b) = False {
    match b { False => refl, True => refl }
}

theorem xor_bit_comm(a, b: Bool): xor_bit(a, b) = xor_bit(b, a) {
    match a {
        False => match b { False => refl, True => refl },
        True => match b { False => refl, True => refl },
    }
}

theorem cons_bit_cong(n: Nat, {a, b: Bool}, {xs, ys: BitVec(n)},
                      ph: a = b, pt: xs = ys): cons_bit(n, a, xs) = cons_bit(n, b, ys) {
    j(ph, λ z p => cons_bit(n, a, xs) = cons_bit(n, z, ys),
      j(pt, λ zs q => cons_bit(n, a, xs) = cons_bit(n, a, zs), refl))
}

theorem extensionality(n: Nat): (x, y: BitVec(n)) →
        ((i: Fin(n)) → get(n, x, i) = get(n, y, i)) → x = y {
    match n as λ k => (x, y: BitVec(k)) →
            ((i: Fin(k)) → get(k, x, i) = get(k, y, i)) → x = y {
        Zero => λ x y at => refl,
        Succ(k, ih) => λ x y at =>
            cons_bit_cong(k, at(FZ),
                ih(tail_bits(k, x), tail_bits(k, y), λ j => at(FS(j)))),
    }
}

theorem band_comm(n: Nat): (x, y: BitVec(n)) → band(n, x, y) = band(n, y, x) {
    match n as λ k => (x, y: BitVec(k)) → band(k, x, y) = band(k, y, x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => cons_bit_cong(k,
            bool::and_comm(head_bit(k, x), head_bit(k, y)),
            ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

theorem bor_comm(n: Nat): (x, y: BitVec(n)) → bor(n, x, y) = bor(n, y, x) {
    match n as λ k => (x, y: BitVec(k)) → bor(k, x, y) = bor(k, y, x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => cons_bit_cong(k,
            bool::or_comm(head_bit(k, x), head_bit(k, y)),
            ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

theorem bxor_comm(n: Nat): (x, y: BitVec(n)) → bxor(n, x, y) = bxor(n, y, x) {
    match n as λ k => (x, y: BitVec(k)) → bxor(k, x, y) = bxor(k, y, x) {
        Zero => λ x y => refl,
        Succ(k, ih) => λ x y => cons_bit_cong(k,
            xor_bit_comm(head_bit(k, x), head_bit(k, y)),
            ih(tail_bits(k, x), tail_bits(k, y))),
    }
}

theorem cong_increment(n: Nat, {x, y: BitVec(n)}, p: x = y):
        increment(n, x) = increment(n, y) {
    j(p, λ z q => increment(n, x) = increment(n, z), refl)
}

theorem cong_iterate_increment(n, count: Nat, {x, y: BitVec(n)}, p: x = y):
        iterate_increment(n, x, count) = iterate_increment(n, y, count) {
    j(p, λ z q => iterate_increment(n, x, count) = iterate_increment(n, z, count), refl)
}

theorem cong_iterate_increment_count(n: Nat, x: BitVec(n), {a, b: Nat}, p: a = b):
        iterate_increment(n, x, a) = iterate_increment(n, x, b) {
    j(p, λ k q => iterate_increment(n, x, a) = iterate_increment(n, x, k), refl)
}

// Iteration is an action of Nat addition. The orientation follows `nat::add`,
// which recurses on its second argument, and keeps each proof step definitional.
theorem iterate_increment_compose(n: Nat, x: BitVec(n), first, second: Nat):
        iterate_increment(n, iterate_increment(n, x, first), second) =
        iterate_increment(n, x, first + second) {
    match second {
        Zero => refl,
        Succ(k) => cong_increment(n,
            iterate_increment_compose(n, x, first, k)),
    }
}

// At a positive width, two low-bit increments advance the tail once. This is
// the structural bridge between the unary iterator used by `add` and the
// little-endian binary interpretation used by `toNat`.
theorem iterate_increment_twice(n: Nat, x: BitVec(n), count: Nat):
        iterate_increment(Succ(n), cons_bit(n, False, x), twice(count)) =
        cons_bit(n, False, iterate_increment(n, x, count)) {
    match count {
        Zero => refl,
        Succ(k) => trans(
            cong_increment(Succ(n), cong_increment(Succ(n),
                iterate_increment_twice(n, x, k))),
            refl),
    }
}

theorem iterate_increment_succ_twice(n: Nat, x: BitVec(n), count: Nat):
        iterate_increment(Succ(n), cons_bit(n, False, x), Succ(twice(count))) =
        cons_bit(n, True, iterate_increment(n, x, count)) {
    cong_increment(Succ(n), iterate_increment_twice(n, x, count))
}

theorem cons_head_tail(n: Nat, x: BitVec(Succ(n))):
        cons_bit(n, head_bit(n, x), tail_bits(n, x)) = x {
    extensionality(Succ(n),
        cons_bit(n, head_bit(n, x), tail_bits(n, x)), x,
        λ i => match i { FZ => refl, FS(j) => refl })
}

theorem one_bit_eq_ofBool(x: BitVec(1)):
    x = ofBool(head_bit(0, x))
{
    sym(cons_head_tail(0, x))
}

theorem iterate_increment_toNat_cons(n: Nat, bit: Bool, x: BitVec(n),
        tail_law: iterate_increment(n, zero(n), toNat(n, x)) = x):
        iterate_increment(Succ(n), zero(Succ(n)),
            toNat(Succ(n), cons_bit(n, bit, x))) = cons_bit(n, bit, x) {
    match bit {
        False => calc {
            iterate_increment(Succ(n), zero(Succ(n)),
                0 + twice(toNat(n, x)))
                = iterate_increment(Succ(n), zero(Succ(n)), twice(toNat(n, x))) :=
                    cong_iterate_increment_count(Succ(n), zero(Succ(n)),
                        nat::add_left_zero(twice(toNat(n, x)))),
                = cons_bit(n, False,
                    iterate_increment(n, zero(n), toNat(n, x))) :=
                    iterate_increment_twice(n, zero(n), toNat(n, x)),
                = cons_bit(n, False, x) := cons_bit_cong(n, refl, tail_law),
        },
        True => calc {
            iterate_increment(Succ(n), zero(Succ(n)),
                1 + twice(toNat(n, x)))
                = iterate_increment(Succ(n), zero(Succ(n)),
                    Succ(twice(toNat(n, x)))) :=
                    cong_iterate_increment_count(Succ(n), zero(Succ(n)),
                        trans(nat::add_succ_left(0, twice(toNat(n, x))),
                            cong_succ(nat::add_left_zero(twice(toNat(n, x)))))),
                = cons_bit(n, True,
                    iterate_increment(n, zero(n), toNat(n, x))) :=
                    iterate_increment_succ_twice(n, zero(n), toNat(n, x)),
                = cons_bit(n, True, x) := cons_bit_cong(n, refl, tail_law),
        },
    }
}

// Every vector is exactly the initial segment of the cyclic increment orbit
// selected by its unsigned interpretation. No arithmetic bound or quotient is
// needed: the proof follows one bit and one doubled tail count at a time.
theorem iterate_increment_toNat(n: Nat): (x: BitVec(n)) →
        iterate_increment(n, zero(n), toNat(n, x)) = x {
    match n as λ k => (x: BitVec(k)) →
            iterate_increment(k, zero(k), toNat(k, x)) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x => trans(
            iterate_increment_toNat_cons(k, head_bit(k, x), tail_bits(k, x),
                ih(tail_bits(k, x))),
            cons_head_tail(k, x)),
    }
}

theorem add_comm(n: Nat, left, right: BitVec(n)):
        add(n, left, right) = add(n, right, left) {
    calc {
        add(n, left, right)
            = iterate_increment(n,
                iterate_increment(n, zero(n), toNat(n, left)),
                toNat(n, right)) :=
                cong_iterate_increment(n, toNat(n, right),
                    sym(iterate_increment_toNat(n, left))),
            = iterate_increment(n, zero(n),
                toNat(n, left) + toNat(n, right)) :=
                iterate_increment_compose(n, zero(n),
                    toNat(n, left), toNat(n, right)),
            = iterate_increment(n, zero(n),
                toNat(n, right) + toNat(n, left)) :=
                cong_iterate_increment_count(n, zero(n),
                    nat::add_comm(toNat(n, left), toNat(n, right))),
            = iterate_increment(n,
                iterate_increment(n, zero(n), toNat(n, right)),
                toNat(n, left)) :=
                sym(iterate_increment_compose(n, zero(n),
                    toNat(n, right), toNat(n, left))),
            = add(n, right, left) :=
                cong_iterate_increment(n, toNat(n, left),
                    iterate_increment_toNat(n, right)),
    }
}

fn eq_dec(n: Nat) → (x, y: BitVec(n)) → x = y ∨ x ≠ y {
    match n as λ k => (x, y: BitVec(k)) → x = y ∨ x ≠ y {
        Zero => λ x y => Inl(refl),
        Succ(k, ih) => λ x y =>
            match bool::eq_dec(head_bit(k, x), head_bit(k, y)) {
                Inl(head_eq) =>
                    match ih(tail_bits(k, x), tail_bits(k, y)) {
                        Inl(tail_eq) => Inl(cons_bit_cong(k, head_eq, tail_eq)),
                        Inr(tail_ne) => Inr(λ (bad: x = y) =>
                            tail_ne(j(bad,
                                λ z q => tail_bits(k, x) = tail_bits(k, z), refl))),
                    },
                Inr(head_ne) => Inr(λ (bad: x = y) =>
                    head_ne(j(bad,
                        λ z q => head_bit(k, x) = head_bit(k, z), refl))),
            },
    }
}

theorem decrement_increment_step(n: Nat, b: Bool, x: BitVec(n),
        tail_law: decrement(n, increment(n, x)) = x):
        decrement(Succ(n), increment(Succ(n), cons_bit(n, b, x))) = cons_bit(n, b, x) {
    match b {
        False => refl,
        True => @cons_bit_cong(n, True, True,
            decrement(n, increment(n, x)), x, refl, tail_law),
    }
}

theorem decrement_increment(n: Nat): (x: BitVec(n)) →
        decrement(n, increment(n, x)) = x {
    match n as λ k => (x: BitVec(k)) → decrement(k, increment(k, x)) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            decrement_increment_step(k, head_bit(k, x), tail_bits(k, x),
                ih(tail_bits(k, x))),
    }
}

theorem cong_iterate_decrement(n, count: Nat, {x, y: BitVec(n)}, p: x = y):
        iterate_decrement(n, count, x) = iterate_decrement(n, count, y) {
    j(p, λ z q => iterate_decrement(n, count, x) = iterate_decrement(n, count, z), refl)
}

theorem iterate_add_sub_cancel(n: Nat, count: Nat): (x: BitVec(n)) →
        iterate_decrement(n, count, iterate_increment(n, x, count)) = x {
    match count as λ k => (x: BitVec(n)) →
            iterate_decrement(n, k, iterate_increment(n, x, k)) = x {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            trans(cong_iterate_decrement(n, k,
                      decrement_increment(n, iterate_increment(n, x, k))), ih(x)),
    }
}

theorem add_sub_cancel(n: Nat, a, b: BitVec(n)): sub(n, add(n, a, b), b) = a {
    iterate_add_sub_cancel(n, toNat(n, b), a)
}

theorem xor_self(n: Nat): (x: BitVec(n)) → bxor(n, x, x) = zero(n) {
    match n as λ k => (x: BitVec(k)) → bxor(k, x, x) = zero(k) {
        Zero => λ x => refl,
        Succ(k, ih) => λ x =>
            cons_bit_cong(k, xor_bit_self(head_bit(k, x)), ih(tail_bits(k, x))),
    }
}

theorem get_set_same(n: Nat): (x: BitVec(n)) → (i: Fin(n)) → (b: Bool) →
                     get(n, set(n, x, i, b), i) = b {
    match n as λ k => (x: BitVec(k)) → (i: Fin(k)) → (b: Bool) →
                           get(k, set(k, x, i, b), i) = b {
        Zero => λ x i b => match i { },
        Succ(k, ih) => λ x i b => match i {
            FZ => refl,
            FS(j) => ih(tail_bits(k, x), j, b),
        },
    }
}

theorem split_concat_low(n: Nat): (m: Nat) → (lo: BitVec(n)) →
                         (hi: BitVec(m)) → take_low(n, m, concat(n, m, lo, hi)) = lo {
    match n as λ k => (m: Nat) → (lo: BitVec(k)) → (hi: BitVec(m)) →
                           take_low(k, m, concat(k, m, lo, hi)) = lo {
        Zero => λ m lo hi => refl,
        Succ(k, ih) => λ m lo hi =>
            @cons_bit_cong(k,
                head_bit(k, lo), head_bit(k, lo),
                take_low(k, m, concat(k, m, tail_bits(k, lo), hi)), tail_bits(k, lo),
                refl, ih(m, tail_bits(k, lo), hi)),
    }
}

theorem split_concat_high(n: Nat): (m: Nat) → (lo: BitVec(n)) →
                          (hi: BitVec(m)) → drop_low(n, m, concat(n, m, lo, hi)) = hi {
    match n as λ k => (m: Nat) → (lo: BitVec(k)) → (hi: BitVec(m)) →
                           drop_low(k, m, concat(k, m, lo, hi)) = hi {
        Zero => λ m lo hi => refl,
        Succ(k, ih) => λ m lo hi => ih(m, tail_bits(k, lo), hi),
    }
}

// Splitting a vector at any width and joining the two pieces again is the
// identity.  This is the converse used by byte-oriented encoders: they may
// expose a word as little-endian chunks without changing its typed value.
theorem concat_split(n: Nat): (m: Nat) → (x: BitVec(m + n)) →
        concat(n, m, take_low(n, m, x), drop_low(n, m, x)) = x {
    match n as λ k => (m: Nat) → (x: BitVec(m + k)) →
            concat(k, m, take_low(k, m, x), drop_low(k, m, x)) = x {
        Zero => λ m x => refl,
        Succ(k, ih) => λ m x => trans(
            @cons_bit_cong(m + k,
                head_bit(m + k, x), head_bit(m + k, x),
                concat(k, m, take_low(k, m, tail_bits(m + k, x)),
                    drop_low(k, m, tail_bits(m + k, x))),
                tail_bits(m + k, x), refl,
                ih(m, tail_bits(m + k, x))),
            cons_head_tail(m + k, x)),
    }
}

theorem truncate_zero_extend(n, extra: Nat, x: BitVec(n)):
        truncate(n, extra, zero_extend(n, extra, x)) = x {
    split_concat_low(n, extra, x, zero(extra))
}

theorem truncate_sign_extend(n, extra: Nat, x: BitVec(Succ(n))):
        truncate(Succ(n), extra, sign_extend(n, extra, x)) = x {
    split_concat_low(Succ(n), extra, x,
        repeat_bit(extra, get(Succ(n), x, last_index(n))))
}

// A non-dependent product. Unlike `logic::And`, this is data rather than a
// proposition and exposes the conventional `fst` and `snd` projections.

record Pair<A, B> { fst: A, snd: B }

fn swap<A, B>(p: Pair<A, B>) → Pair<B, A> { Pair(p.snd, p.fst) }

theorem pair_ext<A, B>(x, y: Pair<A, B>,
    fst_eq: x.fst = y.fst, snd_eq: x.snd = y.snd): x = y
{
    match x {
        Pair(a, b) => match y {
            Pair(c, d) =>
                j(fst_eq, λ c1 q => Pair(a, b) = Pair(c1, d),
                    j(snd_eq, λ d1 q => Pair(a, b) = Pair(a, d1), refl)),
        },
    }
}

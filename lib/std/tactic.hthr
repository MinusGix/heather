// Tactics written in Heather, as request trees
// (docs/host-elaboration-interface-design.md).
//
// A tactic is an ordinary value of type `Tac<A>`: either a result, or a
// request to the elaborator with a continuation that receives the answer.
// `by t` in a proof position runs `t : Tac<Expr>` against the goal. The
// elaborator answers each request, and the `Expr` the tactic finally returns
// is checked at the goal like any other proof, so a tactic is never trusted:
// a wrong one is refused at its `by`.
//
// A tactic's argument that expects an `Expr` may be any term of the goal's
// context: `by exact(h)` with `h` a hypothesis hands the tactic a handle to
// `h`. Everything else about a tactic's arguments is closed; a tactic reaches
// the goal's locals through `Goal`.
//
// Importing this module imports the *protocol*, never an implementation.
// What answers is the elaborator running the build; a Heather handler for the
// same requests is an ordinary function over `Tac<A>` (the probe in
// crates/elab/tests/tactic_request_tree.rs runs one by `refl`).

import logic;
import bool;
import nat;
import list;
import option;
import char;
import string;

// ---------------------------------------------------------------------------
// Terms, as a tactic holds them.
//
// A tactic never holds a kernel term. It holds an `Expr`: a handle to a term
// or type the elaborator has, a local of the goal's context, or structure it
// built itself. Handles and local references are numbers the elaborator
// issued during this run; it validates every one it is given, so forging one
// is an error at the `by`, never a soundness question.
//
// A local is either one of the goal's or one `Open` introduced; `Lam(x, b)`
// abstracts an introduced `x` out of `b`. The elaborator keeps track of which
// binder each handle and local lives under, and refuses an `Expr` that uses
// one outside it.

record Handle { id: Nat }
record LocalRef { id: Nat }

inductive Expr {
    Hd(h: Handle),
    Local(x: LocalRef),
    App(f: Expr, a: Expr),
    NatLit(n: Nat),
    Lam(x: LocalRef, body: Expr),
}

// One local of the goal's context: how to refer to it, its name for
// messages, and its type.
record LocalInfo { ref: LocalRef, name: String, ty: Handle }

// The goal: its statement, and its locals, the most recent first.
record GoalInfo { target: Handle, locals: List<LocalInfo> }

// One layer of a term or type, as `View` presents it: the head the
// diagnostics would print, with its children as handles again. Nothing is
// reduced (`Whnf` does that), and a form the view does not present is
// `HOther`.
inductive Head {
    // A function type, by its domain; `Open` reaches its body.
    HPi(dom: Handle),
    // An equation, by its two sides.
    HEq(lhs: Handle, rhs: Handle),
    // A named global or type applied: `Nat::le(n, m)`, `List<Nat>`. Only the
    // arguments a call writes are listed, implicit ones left out.
    HGlobal(name: String, args: List<Handle>),
    // A local, applied to arguments.
    HLocal(x: LocalRef, args: List<Handle>),
    HLit(n: Nat),
    HOther,
}

// One line of a failure's search state. `Under` marks a note about a
// sub-search, shown one level deeper.
inductive Note { Tried(what: String, verdict: String), Under(n: Note) }

// The answer to a request that may be refused, with the reason.
inductive Checked<A> { Accepted(a: A), Refused(why: String) }

// A binder `Open` introduced: the new local, and the binder's body, which
// lives under it.
record Opened { local: LocalInfo, body: Handle }

// ---------------------------------------------------------------------------
// The requests, and the request tree.

inductive Req {
    // The goal and its local context.
    Goal,
    // Are the two definitionally equal, at the goal's context?
    Defeq(a: Expr, b: Expr),
    // End the run: the invocation fails with the message and the notes.
    Fail(msg: String, notes: List<Note>),
    // The type of a term.
    Infer(e: Expr),
    // Introduce the binder of a function type, by its head normal form: a
    // fresh local of its domain, and its body under that local.
    Open(h: Handle, name: String),
    // A name, resolved and elaborated where the `by` is (not where the
    // tactic is declared), as a handle to the term.
    Resolve(name: String),
    // One layer of a handle (see `Head`).
    View(h: Handle),
    // A handle to the head normal form of a type or term.
    Whnf(h: Handle),
    // Match the conclusion of the function type `ty` against `target`,
    // treating its leading parameters as unknowns: for the fewest parameters
    // that make it match, each one's value where the match determines it, and
    // `None` where it is left for the caller to prove.
    Match(ty: Handle, target: Handle),
}

inductive Never {}

// What each request is answered with. `Fail` is answered in the empty type,
// so a failure has no continuation by type.
fn Resp(r: Req) → Type {
    match r {
        Goal => GoalInfo,
        Defeq(_, _) => Bool,
        Fail(_, _) => Never,
        Infer(_) => Checked<Handle>,
        Open(_, _) => Checked<Opened>,
        Resolve(_) => Checked<Handle>,
        View(_) => Head,
        Whnf(_) => Checked<Handle>,
        Match(_, _) => Checked<List<Option<Handle>>>,
    }
}

inductive Tac<A> { Pure(a: A), Ask(r: Req, k: Resp(r) → Tac<A>) }

fn Tac::bind<A, B>(self t: Tac<A>, f: A → Tac<B>) → Tac<B> {
    match t { Pure(a) => f(a), Ask(r, k) => Ask(r, λ x => k(x).bind(f)) }
}

fn goal() → Tac<GoalInfo> { Ask(Goal, λ g => Pure(g)) }

fn defeq(a: Expr, b: Expr) → Tac<Bool> { Ask(Defeq(a, b), λ same => Pure(same)) }

fn fail<A>(msg: String, notes: List<Note>) → Tac<A> {
    Ask(Fail(msg, notes), λ never => match never {})
}

fn infer(e: Expr) → Tac<Checked<Handle>> { Ask(Infer(e), λ c => Pure(c)) }

fn open(h: Handle, name: String) → Tac<Checked<Opened>> { Ask(Open(h, name), λ c => Pure(c)) }

fn resolve(name: String) → Tac<Checked<Handle>> { Ask(Resolve(name), λ c => Pure(c)) }

fn view(h: Handle) → Tac<Head> { Ask(View(h), λ v => Pure(v)) }

fn whnf(h: Handle) → Tac<Checked<Handle>> { Ask(Whnf(h), λ c => Pure(c)) }

fn match_conclusion(ty: Handle, target: Handle) → Tac<Checked<List<Option<Handle>>>> { Ask(Match(ty, target), λ c => Pure(c)) }

// An answer of any kind, as the elaborator builds one, and the answer at a
// request's own type. A `match` on the request would not refine the
// continuation's domain, so the dependent answer is computed by `fit`
// (design §9).
inductive Answer {
    AGoal(g: GoalInfo),
    ABool(b: Bool),
    AHandle(c: Checked<Handle>),
    AOpened(c: Checked<Opened>),
    AHead(h: Head),
    AMatch(c: Checked<List<Option<Handle>>>),
}

inductive Fit<R> { Mismatch, Fits(a: R) }

fn fit(r: Req, a: Answer) → Fit<Resp(r)> {
    match r {
        Goal => match a { AGoal(g) => Fits(g), _ => Mismatch },
        Defeq(_, _) => match a { ABool(b) => Fits(b), _ => Mismatch },
        Fail(_, _) => Mismatch,
        Infer(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        Open(_, _) => match a { AOpened(c) => Fits(c), _ => Mismatch },
        Resolve(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        View(_) => match a { AHead(h) => Fits(h), _ => Mismatch },
        Whnf(_) => match a { AHandle(c) => Fits(c), _ => Mismatch },
        Match(_, _) => match a { AMatch(c) => Fits(c), _ => Mismatch },
    }
}

// ---------------------------------------------------------------------------
// Handlers: tactics that run other tactics.
//
// Each is an ordinary function over the request tree that answers some of
// its requests itself and passes the rest on, so the elaborator never knows
// about them.

// Run `t` against `g`: its `Goal` requests are answered with `g`, and every
// other request goes to the elaborator. This is how a tactic works on a
// subgoal, such as the body of a binder it opened.
fn focus<A>(g: GoalInfo, t: Tac<A>) → Tac<A> {
    match t {
        Pure(a) => Pure(a),
        Ask(r, k) => match fit(r, AGoal(g)) {
            Fits(x) => focus(g, k(x)),
            Mismatch => Ask(r, λ x => focus(g, k(x))),
        },
    }
}

inductive Outcome<A> { Done(a: A), Failed(msg: String, notes: List<Note>) }

// Run `t`, catching its failure. Requests are side-effect free, so nothing
// needs undoing when `t` fails: the elaborator's state is what it was.
fn attempt<A>(t: Tac<A>) → Tac<Outcome<A>> {
    match t {
        Pure(a) => Pure(Done(a)),
        Ask(r, k) => match r {
            Fail(msg, notes) => Pure(Failed(msg, notes)),
            _ => Ask(r, λ x => attempt(k(x))),
        },
    }
}

fn under_all(ns: List<Note>) → List<Note> {
    match ns { Nil => [], Cons(n, rest) => Cons(Under(n), under_all(rest)) }
}

fn first_of_among<A>(ts: List<Tac<A>>, tried: List<Note>) → Tac<A> {
    match ts {
        Nil => fail("no alternative succeeded", tried),
        Cons(t, rest) => attempt(t).bind(λ o => match o {
            Done(a) => Pure(a),
            Failed(msg, notes) => first_of_among(rest, (tried ++ [Tried("an alternative", msg)]) ++ under_all(notes)),
        }),
    }
}

// The first of `ts` that succeeds. A failure lists every alternative's
// failure, with its own notes beneath it.
fn first_of<A>(ts: List<Tac<A>>) → Tac<A> { first_of_among(ts, []) }

// ---------------------------------------------------------------------------
// Tactics.

// `assumption`: a local whose type is the goal, up to definitional equality.
// The most recent local is tried first; a failure lists every local tried.
fn assumption_among(target: Handle, ls: List<LocalInfo>, tried: List<Note>) → Tac<Expr> {
    match ls {
        Nil => fail("no local's type is the goal", tried),
        Cons(l, rest) => defeq(Hd(l.ty), Hd(target)).bind(λ same => match same {
            True => Pure(Local(l.ref)),
            False => assumption_among(target, rest, tried ++ [Tried(l.name, "its type is not the goal")]),
        }),
    }
}

fn assumption() → Tac<Expr> {
    goal().bind(λ g => assumption_among(g.target, g.locals, []))
}

// `exact(e)`: `e` itself, if its type is the goal.
fn exact(e: Expr) → Tac<Expr> {
    goal().bind(λ g => infer(e).bind(λ c => match c {
        Refused(why) => fail("exact: " ++ why, []),
        Accepted(ty) => defeq(Hd(ty), Hd(g.target)).bind(λ same => match same {
            True => Pure(e),
            False => fail("exact: the term's type is not the goal", []),
        }),
    }))
}

// `intro_as(name, t)`: open the goal's binder as a local called `name`,
// prove the body with `t`, and abstract the local again. The name is for
// messages; nothing resolves it.
fn intro_as(name: String, t: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => open(g.target, name).bind(λ c => match c {
        Refused(why) => fail("intro: " ++ why, []),
        Accepted(o) => focus(GoalInfo(o.body, Cons(o.local, g.locals)), t).bind(λ e => Pure(Lam(o.local.ref, e))),
    }))
}

// `intro(t)`: `intro_as` with the local called `x`.
fn intro(t: Tac<Expr>) → Tac<Expr> { intro_as("x", t) }

// `f`, whose type is `ty`, applied to one argument per slot: a slot the match
// determined is that value, and an open one is proved by `premise` at the
// parameter's type, which by then mentions the arguments before it.
fn apply_slots(slots: List<Option<Handle>>, f: Expr, ty: Handle, locals: List<LocalInfo>, premise: Tac<Expr>) → Tac<Expr> {
    match slots {
        Nil => Pure(f),
        Cons(s, rest) => match s {
            Some(h) => infer(App(f, Hd(h))).bind(λ c => match c {
                Refused(why) => fail("apply: " ++ why, []),
                Accepted(ty2) => apply_slots(rest, App(f, Hd(h)), ty2, locals, premise),
            }),
            None => open(ty, "_").bind(λ c => match c {
                Refused(why) => fail("apply: " ++ why, []),
                Accepted(o) => focus(GoalInfo(o.local.ty, locals), premise).bind(λ a => infer(App(f, a)).bind(λ c2 => match c2 {
                    Refused(why) => fail("apply: " ++ why, []),
                    Accepted(ty2) => apply_slots(rest, App(f, a), ty2, locals, premise),
                })),
            }),
        },
    }
}

// `apply(f, premise)`: use `f` backwards. Its conclusion is matched against
// the goal with its parameters as unknowns, as few of them as it takes;
// those the match determines are filled in, implicit ones included, and the
// rest are proved left to right by `premise`.
fn apply(f: Expr, premise: Tac<Expr>) → Tac<Expr> {
    goal().bind(λ g => infer(f).bind(λ c => match c {
        Refused(why) => fail("apply: " ++ why, []),
        Accepted(ty) => match_conclusion(ty, g.target).bind(λ m => match m {
            Refused(why) => fail("apply: " ++ why, []),
            Accepted(slots) => apply_slots(slots, f, ty, g.locals, premise),
        }),
    }))
}

// ---------------------------------------------------------------------------
// The host's side of the protocol.
//
// The elaborator runs a `Tac<Expr>` through these functions instead of
// decoding the lowered encodings by hand: each one asks a single question of
// the tree, and its answer is a numeral, an `Expr` or a `String`. They are
// part of the protocol's definition, not of any tactic, and a tactic has no
// reason to call them.

// 0: a result. 1: `Goal`. 2: `Defeq`. 3: `Fail`. 4: `Infer`. 5: `Open`.
// 6: `Resolve`. 7: `View`. 8: `Whnf`. 9: `Match`.
fn host_tag(t: Tac<Expr>) → Nat {
    match t {
        Pure(_) => 0,
        Ask(r, _) => match r {
            Goal => 1,
            Defeq(_, _) => 2,
            Fail(_, _) => 3,
            Infer(_) => 4,
            Open(_, _) => 5,
            Resolve(_) => 6,
            View(_) => 7,
            Whnf(_) => 8,
            Match(_, _) => 9,
        },
    }
}

fn host_result(t: Tac<Expr>) → Expr {
    match t { Pure(e) => e, Ask(_, _) => NatLit(0) }
}

fn host_lhs(t: Tac<Expr>) → Expr {
    match t {
        Pure(e) => e,
        Ask(r, _) => match r { Defeq(a, _) => a, Infer(e) => e, _ => NatLit(0) },
    }
}

fn host_rhs(t: Tac<Expr>) → Expr {
    match t {
        Pure(e) => e,
        Ask(r, _) => match r { Defeq(_, b) => b, _ => NatLit(0) },
    }
}

// The handle `Open`, `View` and `Whnf` are about; `Match`'s function type.
fn host_handle(t: Tac<Expr>) → Nat {
    match t {
        Pure(_) => 0,
        Ask(r, _) => match r { Open(h, _) => h.id, View(h) => h.id, Whnf(h) => h.id, Match(ty, _) => ty.id, _ => 0 },
    }
}

// `Match`'s target.
fn host_target(t: Tac<Expr>) → Nat {
    match t { Pure(_) => 0, Ask(r, _) => match r { Match(_, target) => target.id, _ => 0 } }
}

// `Open`'s or `Resolve`'s name.
fn host_name(t: Tac<Expr>) → String {
    match t { Pure(_) => "", Ask(r, _) => match r { Open(_, name) => name, Resolve(name) => name, _ => "" } }
}

fn render_note(indent: String, n: Note) → String {
    match n {
        Tried(what, verdict) => "\n" ++ indent ++ "tried " ++ what ++ ": " ++ verdict,
        Under(m) => render_note(indent ++ "  ", m),
    }
}

fn render_notes(ns: List<Note>) → String {
    match ns { Nil => "", Cons(n, rest) => render_note("  ", n) ++ render_notes(rest) }
}

// A failure's message followed by its notes, one per line.
fn host_failure(t: Tac<Expr>) → String {
    match t {
        Pure(_) => "",
        Ask(r, _) => match r { Fail(msg, notes) => msg ++ render_notes(notes), _ => "" },
    }
}

// The tree after its request is answered with `a`. An answer of the wrong
// kind leaves the tree as it is, which the host reports as its own error.
fn host_resume(t: Tac<Expr>, a: Answer) → Tac<Expr> {
    match t {
        Pure(e) => Pure(e),
        Ask(r, k) => match fit(r, a) { Mismatch => Ask(r, k), Fits(x) => k(x) },
    }
}

// 0: `Hd`. 1: `Local`. 2: `App`. 3: `NatLit`. 4: `Lam`.
fn expr_tag(e: Expr) → Nat {
    match e { Hd(_) => 0, Local(_) => 1, App(_, _) => 2, NatLit(_) => 3, Lam(_, _) => 4 }
}

// The number a leaf carries: a handle, a local or a literal; `Lam`'s local.
fn expr_nat(e: Expr) → Nat {
    match e { Hd(h) => h.id, Local(x) => x.id, App(_, _) => 0, NatLit(n) => n, Lam(x, _) => x.id }
}

fn expr_fn(e: Expr) → Expr { match e { App(f, _) => f, _ => e } }

// `App`'s argument; `Lam`'s body.
fn expr_arg(e: Expr) → Expr { match e { App(_, a) => a, Lam(_, b) => b, _ => e } }

fn chars_len(cs: List<Char>) → Nat { match cs { Nil => 0, Cons(_, rest) => Succ(chars_len(rest)) } }

fn chars_code(cs: List<Char>, i: Nat) → Nat {
    match cs {
        Nil => 0,
        Cons(c, rest) => match i { Zero => c.code, Succ(j) => chars_code(rest, j) },
    }
}

fn str_len(s: String) → Nat { chars_len(s.chars) }

fn str_code(s: String, i: Nat) → Nat { chars_code(s.chars, i) }

// Answers, built by the host from numerals: a goal is its target and then
// one local at a time, the most recent first.
fn host_goal(target: Nat) → Answer { AGoal(GoalInfo(Handle(target), [])) }

fn host_goal_local(a: Answer, ref: Nat, name: String, ty: Nat) → Answer {
    match a {
        AGoal(g) => AGoal(GoalInfo(g.target, g.locals ++ [LocalInfo(LocalRef(ref), name, Handle(ty))])),
        _ => a,
    }
}

// 0 is `False`, anything else `True`.
fn host_bool(n: Nat) → Answer { match n { Zero => ABool(False), Succ(_) => ABool(True) } }

fn host_accepted(h: Nat) → Answer { AHandle(Accepted(Handle(h))) }

fn host_refused(why: String) → Answer { AHandle(Refused(why)) }

fn host_opened(ref: Nat, name: String, ty: Nat, body: Nat) → Answer {
    AOpened(Accepted(Opened(LocalInfo(LocalRef(ref), name, Handle(ty)), Handle(body))))
}

fn host_not_opened(why: String) → Answer { AOpened(Refused(why)) }

fn host_head_pi(dom: Nat) → Answer { AHead(HPi(Handle(dom))) }

fn host_head_eq(lhs: Nat, rhs: Nat) → Answer { AHead(HEq(Handle(lhs), Handle(rhs))) }

fn host_head_global(name: String) → Answer { AHead(HGlobal(name, [])) }

fn host_head_local(x: Nat) → Answer { AHead(HLocal(LocalRef(x), [])) }

fn host_head_lit(n: Nat) → Answer { AHead(HLit(n)) }

fn host_head_other() → Answer { AHead(HOther) }

// One more argument of a `HGlobal` or `HLocal` head.
fn host_head_arg(a: Answer, h: Nat) → Answer {
    match a {
        AHead(v) => match v {
            HGlobal(name, args) => AHead(HGlobal(name, args ++ [Handle(h)])),
            HLocal(x, args) => AHead(HLocal(x, args ++ [Handle(h)])),
            _ => a,
        },
        _ => a,
    }
}

fn host_matched() → Answer { AMatch(Accepted([])) }

// One more slot of a match: determined (`Some`) or left open.
fn host_slot(a: Answer, h: Nat) → Answer {
    match a {
        AMatch(c) => match c { Accepted(slots) => AMatch(Accepted(slots ++ [Some(Handle(h))])), Refused(_) => a },
        _ => a,
    }
}

fn host_open_slot(a: Answer) → Answer {
    match a {
        AMatch(c) => match c { Accepted(slots) => AMatch(Accepted(slots ++ [None])), Refused(_) => a },
        _ => a,
    }
}

fn host_not_matched(why: String) → Answer { AMatch(Refused(why)) }

// A term of the goal's context, quoted where a tactic's argument expects an
// `Expr`.
fn host_quote(h: Nat) → Expr { Hd(Handle(h)) }

// A character from its code; the host only sends scalar values, and anything
// else becomes U+FFFD.
fn char_of_code(code: Nat) → Char {
    match is_scalar(code).is_true_dec() { Inl(p) => ofNat(code, p), Inr(_) => '\u{FFFD}' }
}

fn str_empty() → String { String([]) }

fn str_push(s: String, code: Nat) → String { String(s.chars ++ [char_of_code(code)]) }

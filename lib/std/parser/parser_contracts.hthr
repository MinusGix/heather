// Checked parser library: contracts.
import logic;
import nat;
import list;
import pair;
import result;
import option;
import int;
import omega;
import parser::{Cursor, rest, Success, Failure, Reply, Parser, run};

// Proofs are indexed by the actual parser operation, not unchecked flags.
fn Bound<T,A>(source: List<T>, begin: Cursor<T>(source), amount: Nat, r: Reply<T,A>(source,begin)) -> Type {
    match r { Err(e) => True, Ok(s) => nat::Le(begin.offset + amount,s.end.offset) }
}

class Consumes<T,A>(p: Parser<T,A>, amount: Nat) {
    bound: (source: List<T>) -> (begin: Cursor<T>(source)) -> Bound(source,begin,amount,p.run(source,begin)),
}

theorem bound_on_success<T,A>(source: List<T>, begin: Cursor<T>(source), amount: Nat, r: Reply<T,A>(source,begin),
    bound: Bound(source,begin,amount,r), s: Success<T,A>(source,begin), shape: r = Ok(s)):
    nat::Le(begin.offset + amount,s.end.offset) {
    j(shape,λ answer q => Bound(source,begin,amount,answer),bound)
}

// Certificates for arbitrary source-span postconditions. False/unsupported
// refinements must be proved, not inferred from a parser's name.
fn Post<T,A>(source: List<T>, begin: Cursor<T>(source),
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    r: Reply<T,A>(source,begin)) -> Type {
    match r { Err(e) => True, Ok(s) => relation(source,begin,s.end,s.value) }
}

class Sound<T,A>(p: Parser<T,A>, relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type) {
    law: (source: List<T>) -> (begin: Cursor<T>(source)) -> Post(source,begin,relation,p.run(source,begin)),
}

theorem post_on_success<T,A>(source: List<T>, begin: Cursor<T>(source),
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    r: Reply<T,A>(source,begin), proof: Post(source,begin,relation,r), s: Success<T,A>(source,begin), shape: r = Ok(s)):
    relation(source,begin,s.end,s.value) { j(shape,λ answer q => Post(source,begin,relation,answer),proof) }

theorem weaken_bound<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin), small,big: Nat, order: nat::Le(small,big)):
    Bound(source,begin,big,r) -> Bound(source,begin,small,r) {
    match r { Err(e) => λ h => trivial, Ok(s) => λ h =>
        nat::le_trans(begin.offset + small,begin.offset + big,s.end.offset,nat::add_le_mono_l(begin.offset,small,big,order),h) }
}

fn weaken_consumes<T,A>(p: Parser<T,A>, small,big: Nat, order: nat::Le(small,big), proof: Consumes<T,A>(p,big)) -> Consumes<T,A>(p,small) {
    Consumes(λ source begin => weaken_bound(source,begin,p.run(source,begin),small,big,order,proof.bound(source,begin)))
}

record Certified<T,A>(source: List<T>, begin: Cursor<T>(source), relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type) {
    value: A,
    end: Cursor<T>(source),
    forward: nat::Le(begin.offset,end.offset),
    evidence: relation(source,begin,end,value),
}

fn certify_at<T,A>(p: Parser<T,A>, relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    proof: Sound<T,A>(p,relation), source: List<T>, begin: Cursor<T>(source)) -> Result<Certified<T,A>(source,begin,relation),Failure<T>(source)> {
    match shape : p.run(source,begin) {
        Err(e) => Err(e),
        Ok(s) => Ok(Certified(s.value,s.end,s.forward,post_on_success(source,begin,relation,p.run(source,begin),proof.law(source,begin),s,shape))),
    }
}

theorem zero_bound<T,A>(source: List<T>, begin: Cursor<T>(source), r: Reply<T,A>(source,begin)):
    Bound(source,begin,0,r) { match r { Err(e) => trivial, Ok(s) => s.forward } }

fn consumes_zero<T,A>(p: Parser<T,A>) -> Consumes<T,A>(p,0) {
    Consumes(λ source begin => zero_bound(source,begin,p.run(source,begin)))
}

// Proof-carrying replies let a recursive implementation establish its
// postcondition as it parses. Forgetting evidence recovers an ordinary reply.
fn forget_at<T,A>(source: List<T>, begin: Cursor<T>(source),
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    r: Result<Certified<T,A>(source,begin,relation),Failure<T>(source)>) -> Reply<T,A>(source,begin) {
    match r { Err(e) => Err(e), Ok(c) => Ok(Success(c.value,c.end,c.forward)) }
}

theorem forget_post<T,A>(source: List<T>, begin: Cursor<T>(source),
    relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    r: Result<Certified<T,A>(source,begin,relation),Failure<T>(source)>):
    Post(source,begin,relation,forget_at(source,begin,relation,r)) {
    match r { Err(e) => trivial, Ok(c) => c.evidence }
}

fn CompleteSpec<T,A>(relation: (source: List<T>) -> Cursor<T>(source) -> Cursor<T>(source) -> A -> Type,
    source: List<T>, begin,end: Cursor<T>(source), value: A) -> Type {
    And<relation(source,begin,end,value),rest(source,end) = Nil<T>>
}

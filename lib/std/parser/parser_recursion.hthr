// Checked parser library: recursion.
import logic;
import nat;
import list;
import pair;
import result;
import option;
import int;
import omega;
import parser_core::{Cursor, rest, Success, Reply, Parser, drop_length_strict};
import parser_contracts::{Consumes, bound_on_success};
import parser_combinators::{rebase};

// The recursive capability is only callable at a strictly later cursor.
// Its proof is translated once to the measure used by the well-founded lowering.
// For nested parentheses, consume the opening token before calling the recursive capability.
fn guarded<T, A>(source: List<T>,
    body: (begin: Cursor<T>(source)) →
        ((later: Cursor<T>(source)) → begin.offset.Lt(later.offset) → Reply<T, A>(source, later)) → Reply<T, A>(source, begin),
    begin: Cursor<T>(source)) → Reply<T, A>(source, begin) decreases rest(source, begin).len() {
    body(begin, λ (later: Cursor<T>(source)) (advance: begin.offset.Lt(later.offset)) => {
        let small = drop_length_strict(source, begin.offset, later.offset, advance, later.within);
        guarded(source, body, later) decreasing recur
    })
    on decreasing recur := small;
}

// Library-owned composition of prefix movement and a strict next step.
theorem progress_after<T>(source: List<T>, begin, middle, end: Cursor<T>(source),
    prefix: begin.offset.Le(middle.offset), step: middle.offset.Lt(end.offset)):
    rest(source, end).len().Lt(rest(source, begin).len()) {
    let moved: begin.offset.Lt(end.offset) = (begin.offset + 1).le_trans(middle.offset + 1, end.offset, prefix, step);
    drop_length_strict(source, begin.offset, end.offset, moved, end.within)
}

// Optional right-recursive grammar tail. The continuation gets exactly the
// decrease proof owed by a recursive call, without exposing rebasing arithmetic.
// For expression = factor ('+' expression)?, keep factor on retryable operator failure;
// after recognizing '+', parse the right expression with the supplied decrease proof.
fn extend_at<T, A, B>(source: List<T>, begin: Cursor<T>(source), left: Success<T, A>(source, begin),
    op: Parser<T, B>, progress: Consumes<T, B>(op, 1),
    next: (value: B) → (end: Cursor<T>(source)) → rest(source, end).len().Lt(rest(source, begin).len()) → Reply<T, A>(source, end)) → Reply<T, A>(source, begin) {
    match shape: op.run(source, left.end) {
        Err(e) => match e.retry { Retryable => Ok(left), Committed => Err(e) },
        Ok(s) => {
            let step = bound_on_success(source, left.end, 1, op.run(source, left.end), progress.bound(source, left.end), s, shape);
            let small = progress_after(source, begin, left.end, s.end, left.forward, step);
            rebase(source, begin, left.end, left.forward,
                rebase(source, left.end, s.end, s.forward, next(s.value, s.end, small)))
        },
    }
}

// Parse a consuming prefix, then invoke a continuation with its decrease proof.
// For parentheses, use the opening token as the prefix before parsing the inner expression.
fn after_at<T, A, B>(source: List<T>, begin: Cursor<T>(source), p: Parser<T, A>, progress: Consumes<T, A>(p, 1),
    next: (value: A) → (end: Cursor<T>(source)) → rest(source, end).len().Lt(rest(source, begin).len()) → Reply<T, B>(source, end)) → Reply<T, B>(source, begin) {
    match shape: p.run(source, begin) {
        Err(e) => Err(e),
        Ok(s) => {
            let step = bound_on_success(source, begin, 1, p.run(source, begin), progress.bound(source, begin), s, shape);
            let small = drop_length_strict(source, begin.offset, s.end.offset, step, s.end.within);
            rebase(source, begin, s.end, s.forward, next(s.value, s.end, small))
        },
    }
}

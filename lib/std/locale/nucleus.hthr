// Nuclei and sublocales (docs/library/frame-locale-design.md §5).
//
// A nucleus on a frame is a closure operator that preserves finite meets.
// Its fixed points are a frame, the opens of a sublocale, and every quotient
// of a frame arises this way, so a nucleus is how a frame is cut down by
// relations without forming a quotient type.
//
// The fixed points need no subtype here: the sublocale's frame keeps the
// carrier, the meets and the joins, and changes only the order, to
// `x ≤ c(y)`. Two opens with the same closure become the same (each is below
// the other), and every open is the same as its closure, so the preorder is
// the fixed-point frame up to its own equivalence, the reading every frame in
// `frame` has.

import logic;
import frame;

record Nucleus<A: Type<1>>(le: A → A → Type, meet: A → A → A, c: A → A) {
    mono: (x, y: A) → le(x, y) → le(c(x), c(y)),
    infl: (x: A) → le(x, c(x)),
    idem: (x: A) → le(c(c(x)), c(x)),
    meet_le: (x, y: A) → le(meet(c(x), c(y)), c(meet(x, y))),
}

// The sublocale's order: below the closure.
fn NucleusLe<A: Type<1>>(le: A → A → Type, c: A → A) → A → A → Type { λ x y => le(x, c(y)) }

// The opens of the sublocale: the same carrier, meets and joins, at the
// nucleus's order.
fn Nucleus::frame<A: Type<1> + Frame(le, meet, sup)>(le: A → A → Type, meet: A → A → A,
        sup: (I: Type) → (I → A) → A, {c: A → A}, n: Nucleus<A>(le, meet, c))
    → Frame<A>(NucleusLe(le, c), meet, sup)
{
    Frame {
        le_refl: n.infl,
        le_trans: λ x y z (h1: le(x, c(y))) (h2: le(y, c(z))) =>
            A.le_trans(x, c(y), c(z), h1, A.le_trans(c(y), c(c(z)), c(z), n.mono(y, c(z), h2), n.idem(z))),
        meet_le_l: λ x y => A.le_trans(meet(x, y), x, c(x), A.meet_le_l(x, y), n.infl(x)),
        meet_le_r: λ x y => A.le_trans(meet(x, y), y, c(y), A.meet_le_r(x, y), n.infl(y)),
        le_meet: λ x y z (hx: le(z, c(x))) (hy: le(z, c(y))) =>
            A.le_trans(z, meet(c(x), c(y)), c(meet(x, y)), A.le_meet(c(x), c(y), z, hx, hy), n.meet_le(x, y)),
        top: A.top,
        le_top: λ x => A.le_trans(x, A.top, c(A.top), A.le_top(x), n.infl(A.top)),
        le_sup: λ I f i => A.le_trans(f(i), sup(I, f), c(sup(I, f)), A.le_sup(I, f, i), n.infl(sup(I, f))),
        sup_le: λ I f z h => A.sup_le(I, f, c(z), h),
        meet_sup_le: λ x I f => A.le_trans(meet(x, sup(I, f)), sup(I, λ i => meet(x, f(i))),
            c(sup(I, λ i => meet(x, f(i)))), A.meet_sup_le(x, I, f), n.infl(sup(I, λ i => meet(x, f(i))))),
    }
}

// The sublocale's inclusion: a map of locales from the sublocale into the
// whole, whose inverse image is the identity on opens. That the identity is
// a frame homomorphism into the coarser order is the whole content of the
// nucleus laws.
fn Nucleus::inclusion<A: Type<1> + Frame(le, meet, sup)>(le: A → A → Type, meet: A → A → A,
        sup: (I: Type) → (I → A) → A, {c: A → A}, n: Nucleus<A>(le, meet, c))
    → LocaleMap<A, A>(NucleusLe(le, c), meet, A.top, sup, le, meet, A.top, sup)
{
    LocaleMap(λ x => x, FrameHom(
        λ x y h => A.le_trans(x, y, c(y), h, n.infl(y)),
        λ x y => n.infl(meet(x, y)),
        n.infl(A.top),
        λ I f => n.infl(sup(I, λ i => f(i)))))
}

// In the sublocale every open is the same as its closure: each is below the
// other at the sublocale's order. So the closure is the reflection of an
// open into the fixed points, and the preorder is the fixed-point frame.
theorem Nucleus::closure_same<A: Type<1> + Preorder1(le)>(le: A → A → Type, meet: A → A → A, {c: A → A},
        n: Nucleus<A>(le, meet, c), x: A): NucleusLe(le, c, x, c(x)) ∧ NucleusLe(le, c, c(x), x)
{
    And(A.le_trans(x, c(x), c(c(x)), n.infl(x), n.infl(c(x))), A.le_refl(c(x)))
}

// ---------------------------------------------------------------------------
// Double negation.

// `¬¬` is a nucleus on the truth values, and its sublocale is the Boolean
// one: the smallest dense sublocale of the point.
fn Omega::dn(p: Omega) → Omega { Omega(¬¬p.holds) }

fn Omega::dn_nucleus() → Nucleus<Omega>(Omega::Le, Omega::meet, Omega::dn) {
    Nucleus(
        λ p q (h: p.holds → q.holds) (np: ¬¬p.holds) (nq: ¬q.holds) => np(λ (x: p.holds) => nq(h(x))),
        λ p (x: p.holds) (n: ¬p.holds) => n(x),
        λ p (nnnn: ¬¬¬¬p.holds) (n: ¬p.holds) => nnnn(λ (k: ¬¬p.holds) => k(n)),
        λ p q (h: ¬¬p.holds ∧ ¬¬q.holds) (n: ¬(p.holds ∧ q.holds)) =>
            h.left(λ (x: p.holds) => h.right(λ (y: q.holds) => n(And(x, y)))))
}

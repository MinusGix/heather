// Formal topologies: frames presented by a small basis and a cover relation
// (docs/library/frame-locale-design.md §6).
//
// A formal topology is a small type `P` of basic opens with a preorder and a
// relation `a ◁ U` ("the basic open `a` is covered by the family `U`"). It is
// the predicative presentation of a locale (Sambin; Coquand, Sambin, Smith
// and Valentini): the frame of opens is built from families of basic opens,
// which are small, so nothing quantifies over a powerset, and the frame's
// large carrier (`Opens<P>`, at `Type<1>`) is only ever indexed by small
// types.
//
// The cover is axiomatic: any relation with the four rules below presents a
// frame (`FormalTopology::frame`). The usual way to present a particular
// locale, a small set of axioms whose cover is the least relation closed
// under the rules, is `Cover` below (docs/library/frame-locale-design.md §6.1).

import logic;
import relation_props;
import order;
import frame;

// The cover's four rules. `Opens::down_meet` is the formal meet of two families: the
// basic opens below something in each. Stated over the preorder `le_p` on
// the basis, whose own laws are not needed: reflexivity of the cover and
// `left` already give everything the frame uses.
fn Opens::down_meet<P>(le_p: P → P → Type, u, v: Opens<P>) → Opens<P> {
    Opens(λ a => Exists<P>(λ b => u.has(b) ∧ le_p(a, b)) ∧ Exists<P>(λ d => v.has(d) ∧ le_p(a, d)))
}

record FormalTopology(P: Type, le_p: P → P → Type, cov: P → Opens<P> → Type) {
    cov_refl: (a: P, u: Opens<P>) → u.has(a) → cov(a, u),
    cov_trans: (a: P, u, v: Opens<P>) → cov(a, u) → ((b: P) → u.has(b) → cov(b, v)) → cov(a, v),
    cov_left: (a, b: P, u: Opens<P>) → le_p(a, b) → cov(b, u) → cov(a, u),
    cov_meet: (a: P, u, v: Opens<P>) → cov(a, u) → cov(a, v) → cov(a, Opens::down_meet(le_p, u, v)),
}

// The order on opens: every basic open of `u` is covered by `v`.
fn FormalTopology::Le<P>(cov: P → Opens<P> → Type, u, v: Opens<P>) → Type { (a: P) → u.has(a) → cov(a, v) }

// The frame a formal topology presents. Joins are unions and need no rule:
// the union of a small family of families is a family.
fn FormalTopology::frame<P>({le_p: P → P → Type}, {cov: P → Opens<P> → Type}, t: FormalTopology(P, le_p, cov))
    → Frame<Opens<P>>(λ u v => FormalTopology::Le(cov, u, v), λ u v => Opens::down_meet(le_p, u, v), Opens::sup<P>)
{
    Frame {
        le_refl: λ u a h => t.cov_refl(a, u, h),
        le_trans: λ u v w h1 h2 a h => t.cov_trans(a, v, w, h1(a, h), h2),
        meet_le_l: λ u v a h => t.cov_left(a, h.left.witness, u, h.left.proof.right, t.cov_refl(h.left.witness, u, h.left.proof.left)),
        meet_le_r: λ u v a h => t.cov_left(a, h.right.witness, v, h.right.proof.right, t.cov_refl(h.right.witness, v, h.right.proof.left)),
        le_meet: λ u v w hu hv a h => t.cov_meet(a, u, v, hu(a, h), hv(a, h)),
        top: Opens::top<P>(),
        le_top: λ u a h => t.cov_refl(a, Opens::top<P>(), trivial),
        le_sup: λ I f i a h => t.cov_refl(a, Opens::sup(I, f), Exists(i, h)),
        sup_le: λ I f w h a e => h(e.witness, a, e.proof),
        meet_sup_le: λ u I f a h => t.cov_refl(a, Opens::sup(I, λ i => Opens::down_meet(le_p, u, f(i))),
            Exists(h.right.proof.left.witness, And(h.left,
                Exists(h.right.witness, And(h.right.proof.left.proof, h.right.proof.right))))),
    }
}

// The basic open `a` as an open: everything below it.
fn FormalTopology::basic<P>(le_p: P → P → Type, a: P) → Opens<P> { Opens(λ b => le_p(b, a)) }

// The presentation is a basis: every open is the join of the basic opens it
// contains, indexed by the small type of its members.
theorem FormalTopology::sup_basic<P: Preorder(le_p)>(le_p: P → P → Type, {cov: P → Opens<P> → Type},
        t: FormalTopology(P, le_p, cov), u: Opens<P>):
    FormalTopology::Le(cov, u, Opens::sup(Exists<P>(u.has), λ e => FormalTopology::basic(le_p, e.witness)))
        ∧ FormalTopology::Le(cov, Opens::sup(Exists<P>(u.has), λ e => FormalTopology::basic(le_p, e.witness)), u)
{
    And(
        λ a h => t.cov_refl(a, Opens::sup(Exists<P>(u.has), λ e => FormalTopology::basic(le_p, e.witness)),
            Exists(Exists(a, h), P.rel_refl(a))),
        λ b e => t.cov_left(b, e.witness.witness, u, e.proof, t.cov_refl(e.witness.witness, u, e.witness.proof)))
}

// ---------------------------------------------------------------------------
// The Alexandrov topology: no axioms.

// With no covering axioms, `a` is covered by `u` exactly when it lies below
// one of `u`'s members, and the frame is the down-sets of the preorder.
fn Opens::Below<P>(le_p: P → P → Type, a: P, u: Opens<P>) → Type { Exists<P>(λ b => u.has(b) ∧ le_p(a, b)) }

fn FormalTopology::alexandrov<P: Preorder(le_p)>(le_p: P → P → Type)
    → FormalTopology(P, le_p, λ a u => Opens::Below(le_p, a, u))
{
    FormalTopology(
        λ a u h => Exists(a, And(h, P.rel_refl(a))),
        λ a u v h k => Exists((k(h.witness, h.proof.left)).witness, And((k(h.witness, h.proof.left)).proof.left,
            P.rel_trans(a, h.witness, (k(h.witness, h.proof.left)).witness, h.proof.right, (k(h.witness, h.proof.left)).proof.right))),
        λ a b u hab h => Exists(h.witness, And(h.proof.left, P.rel_trans(a, b, h.witness, hab, h.proof.right))),
        λ a u v hu hv => Exists(a, And(And(hu, hv), P.rel_refl(a))))
}

// ---------------------------------------------------------------------------
// Covers generated by axioms (Coquand, Sambin, Smith and Valentini,
// "Inductively generated formal topologies").
//
// An axiom set gives each basic open `a` a small type `C(a)` of axioms, each
// an open `ax(a, k)` that is to cover `a`. The cover of `u` is the least
// family closed under reflexivity (`Here`), the `≤`-left rule (`Down`) and
// the axioms (`Axiom`, a child per member of the axiom's open): an indexed
// family over the basis with an infinitary premise, which is small.

inductive Cover<P>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>, u: Opens<P>): (a: P) → Type {
    Here(a: P, h: u.has(a)): Cover<P>(le_p, C, ax, u, a),
    Down(a: P, b: P, h: le_p(a, b), c: Cover<P>(le_p, C, ax, u, b)): Cover<P>(le_p, C, ax, u, a),
    Axiom(a: P, k: C(a), f: (e: Exists<P>((ax(a, k)).has)) → Cover<P>(le_p, C, ax, u, e.witness)): Cover<P>(le_p, C, ax, u, a),
}

// Transitivity, by induction on the first cover.
fn Cover::trans<P>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>, u, v: Opens<P>,
        a: P, c: Cover<P>(le_p, C, ax, u, a), h: (b: P) → u.has(b) → Cover<P>(le_p, C, ax, v, b))
    → Cover<P>(le_p, C, ax, v, a)
{
    match c {
        Here(a1, hu) => h(a1, hu),
        Down(a1, b, hab, c1) => Down(a1, b, hab, Cover::trans(le_p, C, ax, u, v, b, c1, h)),
        Axiom(a1, k, f) => Axiom(a1, k, λ e => Cover::trans(le_p, C, ax, u, v, e.witness, f(e), h)),
    }
}

// The localisation condition on an axiom set: below `a`, each axiom at `a`
// has an axiom at `b` refining it.
fn Cover::Localised<P>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>) → Type {
    (a, b: P, k: C(a)) → le_p(b, a)
        → Exists<C(b)>(λ k2 => (x: P) → (ax(b, k2)).has(x) → le_p(x, b) ∧ Exists<P>(λ y => (ax(a, k)).has(y) ∧ le_p(x, y)))
}

// Localisation, by a double induction: a cover of `a` by `u` and one of `b`
// by `v` give, below both, a cover by their formal meet. `meet_r` is the
// inner induction, on the second cover with the first at a member of `u`.
fn Cover::meet_r<P: Preorder(le_p)>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>,
        loc: Cover::Localised(le_p, C, ax), u, v: Opens<P>, a0: P, hu: u.has(a0),
        b: P, c: Cover<P>(le_p, C, ax, v, b), d: P, hda: le_p(d, a0), hdb: le_p(d, b))
    → Cover<P>(le_p, C, ax, Opens::down_meet(le_p, u, v), d)
{
    match c {
        Here(b1, hv) => Here(d, And(Exists(a0, And(hu, hda)), Exists(b1, And(hv, hdb)))),
        Down(b1, b2, h12, c1) =>
            Cover::meet_r(le_p, C, ax, loc, u, v, a0, hu, b2, c1, d, hda, P.rel_trans(d, b1, b2, hdb, h12)),
        Axiom(b1, k, f) => Axiom(d, (loc(b1, d, k, hdb)).witness, λ e =>
            Cover::meet_r(le_p, C, ax, loc, u, v, a0, hu,
                ((loc(b1, d, k, hdb)).proof(e.witness, e.proof)).right.witness,
                f(Exists(((loc(b1, d, k, hdb)).proof(e.witness, e.proof)).right.witness,
                    ((loc(b1, d, k, hdb)).proof(e.witness, e.proof)).right.proof.left)),
                e.witness,
                P.rel_trans(e.witness, d, a0, ((loc(b1, d, k, hdb)).proof(e.witness, e.proof)).left, hda),
                ((loc(b1, d, k, hdb)).proof(e.witness, e.proof)).right.proof.right)),
    }
}

fn Cover::meet_l<P: Preorder(le_p)>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>,
        loc: Cover::Localised(le_p, C, ax), u, v: Opens<P>, a: P, c: Cover<P>(le_p, C, ax, u, a),
        b: P, c2: Cover<P>(le_p, C, ax, v, b), d: P, hda: le_p(d, a), hdb: le_p(d, b))
    → Cover<P>(le_p, C, ax, Opens::down_meet(le_p, u, v), d)
{
    match c {
        Here(a1, hu) => Cover::meet_r(le_p, C, ax, loc, u, v, a1, hu, b, c2, d, hda, hdb),
        Down(a1, a2, h12, c1) =>
            Cover::meet_l(le_p, C, ax, loc, u, v, a2, c1, b, c2, d, P.rel_trans(d, a1, a2, hda, h12), hdb),
        Axiom(a1, k, f) => Axiom(d, (loc(a1, d, k, hda)).witness, λ e =>
            Cover::meet_l(le_p, C, ax, loc, u, v,
                ((loc(a1, d, k, hda)).proof(e.witness, e.proof)).right.witness,
                f(Exists(((loc(a1, d, k, hda)).proof(e.witness, e.proof)).right.witness,
                    ((loc(a1, d, k, hda)).proof(e.witness, e.proof)).right.proof.left)),
                b, c2, e.witness,
                ((loc(a1, d, k, hda)).proof(e.witness, e.proof)).right.proof.right,
                P.rel_trans(e.witness, d, b, ((loc(a1, d, k, hda)).proof(e.witness, e.proof)).left, hdb))),
    }
}

// An axiom set satisfying localisation generates a formal topology.
fn FormalTopology::inductive<P: Preorder(le_p)>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>,
        loc: Cover::Localised(le_p, C, ax))
    → FormalTopology(P, le_p, λ a u => Cover<P>(le_p, C, ax, u, a))
{
    FormalTopology(
        λ a u h => Here(a, h),
        λ a u v c h => Cover::trans(le_p, C, ax, u, v, a, c, h),
        λ a b u h c => Down(a, b, h, c),
        λ a u v cu cv => Cover::meet_l(le_p, C, ax, loc, u, v, a, cu, a, cv, a, P.rel_refl(a), P.rel_refl(a)))
}

// Its frame.
fn FormalTopology::inductive_frame<P: Preorder(le_p)>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>,
        loc: Cover::Localised(le_p, C, ax))
    → Frame<Opens<P>>(λ u v => FormalTopology::Le(λ a w => Cover<P>(le_p, C, ax, w, a), u, v),
        λ u v => Opens::down_meet(le_p, u, v), Opens::sup<P>)
{
    FormalTopology::frame(FormalTopology::inductive(le_p, C, ax, loc))
}

// Any axiom set, localised: an axiom at `a` is one at some `b` above it,
// cut down to `a`.
fn Cover::LocalAxiom<P>(le_p: P → P → Type, C: P → Type, a: P) → Type { Exists<P>(λ b => le_p(a, b) ∧ C(b)) }

fn Cover::local<P>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>, a: P,
        k: Cover::LocalAxiom(le_p, C, a)) → Opens<P>
{
    Opens::down_meet(le_p, FormalTopology::basic(le_p, a), ax(k.witness, k.proof.right))
}

theorem Cover::local_localised<P: Preorder(le_p)>(le_p: P → P → Type, C: P → Type, ax: (a: P) → C(a) → Opens<P>):
    Cover::Localised(le_p, λ a => Cover::LocalAxiom(le_p, C, a), λ a k => Cover::local(le_p, C, ax, a, k))
{
    λ a c k hca => Exists(Exists(k.witness, And(P.rel_trans(c, a, k.witness, hca, k.proof.left), k.proof.right)),
        λ x hx => And(
            P.rel_trans(x, hx.left.witness, c, hx.left.proof.right, hx.left.proof.left),
            Exists(x, And(
                And(Exists(c, And(hca, P.rel_trans(x, hx.left.witness, c, hx.left.proof.right, hx.left.proof.left))), hx.right),
                P.rel_refl(x)))))
}

// The Heyting implication of a presented frame: the join of the basic opens
// whose meet with `x` lies below `y`, a family indexed by the small basis.
fn FormalTopology::imp<P>(le_p: P → P → Type, cov: P → Opens<P> → Type, x, y: Opens<P>) → Opens<P> {
    Opens(λ a => FormalTopology::Le(cov, Opens::down_meet(le_p, FormalTopology::basic(le_p, a), x), y))
}

theorem FormalTopology::imp_intro<P: Preorder(le_p)>(le_p: P → P → Type, {cov: P → Opens<P> → Type},
        t: FormalTopology(P, le_p, cov), x, y, z: Opens<P>,
        h: FormalTopology::Le(cov, Opens::down_meet(le_p, z, x), y)):
    FormalTopology::Le(cov, z, FormalTopology::imp(le_p, cov, x, y))
{
    λ a ha => t.cov_refl(a, FormalTopology::imp(le_p, cov, x, y), λ c hc =>
        h(c, And(Exists(a, And(ha, P.rel_trans(c, hc.left.witness, a, hc.left.proof.right, hc.left.proof.left))), hc.right)))
}

theorem FormalTopology::imp_elim<P: Preorder(le_p)>(le_p: P → P → Type, {cov: P → Opens<P> → Type},
        t: FormalTopology(P, le_p, cov), x, y, z: Opens<P>,
        h: FormalTopology::Le(cov, z, FormalTopology::imp(le_p, cov, x, y))):
    FormalTopology::Le(cov, Opens::down_meet(le_p, z, x), y)
{
    λ c hc => t.cov_trans(c, Opens::down_meet(le_p, FormalTopology::imp(le_p, cov, x, y), x), y,
        t.cov_meet(c, FormalTopology::imp(le_p, cov, x, y), x,
            t.cov_left(c, hc.left.witness, FormalTopology::imp(le_p, cov, x, y), hc.left.proof.right,
                h(hc.left.witness, hc.left.proof.left)),
            t.cov_left(c, hc.right.witness, x, hc.right.proof.right, t.cov_refl(hc.right.witness, x, hc.right.proof.left))),
        λ e he => he.left.proof.left(e, And(Exists(e, And(he.left.proof.right, P.rel_refl(e))), he.right)))
}

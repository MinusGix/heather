// Regular Cauchy reals: the first computational presentation of the real
// numbers (issues/regular-cauchy-reals.md; docs/regular-cauchy-reals-round.md).
//
// A real is a sequence of rationals with its rate of convergence written in:
// the n-th term is meant to be within 1/(n+1) of the number, so any two terms
// m and n lie within 1/(m+1) + 1/(n+1) of each other. That bound is the
// `regular` field, Bishop's regular sequences indexed from zero. Nothing is
// ever a limit: a real is its approximations, and asking for the n-th one
// computes it.
//
// Equality is a setoid, `CReal::Same`, written `≈`: two reals are the same
// when their terms become arbitrarily close, with the index from which they
// are within 1/(k+1) given as data (`∃` is a record, so the modulus
// computes). Two sequences that differ in finitely many places, or approach
// the same number at different speeds, are `≈` and not `=`; the regularity
// proofs are never compared.
//
// Every operation is defined on sequences and shown to respect `≈`, and every
// law is stated modulo `≈`, as at `Rat`. Arithmetic reads its arguments
// further out to keep within the rate: a sum's n-th term adds the summands'
// (2n+1)-th terms, each within 1/(2n+2), and the halves add to 1/(n+1).
// A product reads further out still, by its factors' canonical bounds
// (docs/creal-multiplication-round.md), and an inverse by the size of its
// argument's gap from zero (docs/creal-inverse-round.md).
//
// Calling convention: as at `Rat`, a lemma whose every `CReal` is named by
// one of its hypotheses takes them implicitly; any other takes the first as
// `self`.

import logic;
import nat;
import int;
import omega;
import relation_props;
import algebra;
import algebra_rel::{Semigroup, Commutative};
import order;
import ordered_field;
import rat;

record CReal {
    seq: Nat → Rat,
    regular: (m, n: Nat) → (seq(m) -seq(n)).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n),
}

fn CReal::Same(x, y: CReal) → Type {
    (k: Nat) → ∃ start: Nat, (n: Nat) → start <= n → (x.seq(n) -y.seq(n)).abs() <= Rat::inv_succ(k)
}

designation ≈ at CReal := CReal::Same

// Two terms of one real, both from index 2k+1 on, are within 1/(k+1): each
// is within 1/(2k+2) of the other's rate, and the halves add up.
theorem CReal::regular_close(self x: CReal, k, m, n: Nat, hm: k + k + 1 <= m, hn: k + k + 1 <= n):
    (x.seq(m) -x.seq(n)).abs() <= Rat::inv_succ(k)
{
    let half = Rat::inv_succ(k + k + 1);
    calc {
        (x.seq(m) -x.seq(n)).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n) := x.regular(m, n),
        <= half + half := Rat::add_le_mono(Rat::inv_succ_antitone(k + k + 1, m, hm), Rat::inv_succ_antitone(k + k + 1, n, hn)),
        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
    }
}

// The two ways most laws below are proved: termwise `≈` (closeness from
// index zero), or closeness within 1/(k+1) from index 2k+1 on.
theorem CReal::same_of_terms(self x, y: CReal, terms: (n: Nat) → x.seq(n) ≈ y.seq(n)): x ≈ y {
    λ k => Exists(0, λ n start => calc {
        (x.seq(n) -y.seq(n)).abs() ≈ (y.seq(n) -y.seq(n)).abs() := Rat::abs_respects(Rat::sub_respects(terms(n), y.seq(n).same_refl())),
        ≈ Rat::zero() := y.seq(n).abs_sub_self(),
        <= Rat::inv_succ(k) := Rat::le_of_lt(Rat::inv_succ_pos(k)),
    })
}

theorem CReal::same_of_close(self x, y: CReal,
    close: (k, n: Nat) → k + k + 1 <= n → (x.seq(n) -y.seq(n)).abs() <= Rat::inv_succ(k)): x ≈ y
{
    λ k => Exists(k + k + 1, close(k))
}

theorem CReal::same_refl(self x: CReal): x ≈ x { x.same_of_terms(x, λ n => x.seq(n).same_refl()) }

theorem CReal::same_sym({x, y: CReal}, h: x ≈ y): y ≈ x {
    λ k => match h(k) {
        Exists(start, close) => Exists(start, λ n from => calc {
            (y.seq(n) -x.seq(n)).abs() ≈ (x.seq(n) -y.seq(n)).abs() := y.seq(n).abs_sub_comm(x.seq(n)),
            <= Rat::inv_succ(k) := close(n, from),
        }),
    }
}

// Within 1/(2k+2) of y from one index, y within 1/(2k+2) of z from another:
// from the later of the two, x is within 1/(k+1) of z.
theorem CReal::same_trans({x, y, z: CReal}, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    λ k => match hxy(k + k + 1) {
        Exists(i, first) => match hyz(k + k + 1) {
            Exists(j, second) => Exists(i.max(j), λ n from => {
                let half = Rat::inv_succ(k + k + 1);
                let a: ((x.seq(n) -y.seq(n)).abs() <= half) = first(n, i.le_trans(i.max(j), n, i.le_max_l(j), from));
                let b: ((y.seq(n) -z.seq(n)).abs() <= half) = second(n, j.le_trans(i.max(j), n, i.le_max_r(j), from));
                calc {
                    (x.seq(n) -z.seq(n)).abs() <= (x.seq(n) -y.seq(n)).abs() + (y.seq(n) -z.seq(n)).abs() := x.seq(n).dist_triangle(y.seq(n), z.seq(n)),
                    <= half + half := Rat::add_le_mono(a, b),
                    ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                }
            }),
        },
    }
}

instance Equivalence<CReal>(CReal::Same) {
    rel_refl := CReal::same_refl,
    rel_sym := λ x y h => CReal::same_sym(h),
    rel_trans := λ x y z hxy hyz => CReal::same_trans(hxy, hyz),
}

// ---------------------------------------------------------------------------
// Bishop's equality. Bishop calls two regular sequences equal when their
// n-th terms are within 2/(n+1) at every n: a bound at each index, with no
// modulus. It is the same relation as `≈`. Pointwise closeness is within
// 1/(k+1) from index 2k+1 on. Conversely, compare the n-th terms through a
// far index m: regularity moves each side by 1/(n+1) + 1/(m+1) and `≈`
// crosses at m, so the excess over 2/(n+1) is below every 1/(j+1), hence
// nothing (`Rat::le_of_le_add_inv_succ`).

fn CReal::BishopSame(x, y: CReal) → Type {
    (n: Nat) → (x.seq(n) -y.seq(n)).abs() <= Rat::inv_succ(n) + Rat::inv_succ(n)
}

theorem CReal::same_of_bishop({x, y: CReal}, h: x.BishopSame(y)): x ≈ y {
    x.same_of_close(y, λ k n from => {
        let fine = Rat::inv_succ(n);
        let half = Rat::inv_succ(k + k + 1);
        let le_half: (fine <= half) = Rat::inv_succ_antitone(k + k + 1, n, from);
        calc {
            (x.seq(n) -y.seq(n)).abs() <= fine + fine := h(n),
            <= half + half := Rat::add_le_mono(le_half, le_half),
            ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
        }
    })
}

theorem CReal::bishop_of_same({x, y: CReal}, h: x ≈ y): x.BishopSame(y) {
    λ n => {
        let fine = Rat::inv_succ(n);
        Rat::le_of_le_add_inv_succ(λ j => {
            let j2 = j + j + 1;
            let j4 = j2 + j2 + 1;
            let q = Rat::inv_succ(j4);
            let quarter = Rat::inv_succ(j2);
            match h(j4) {
                Exists(s, close) => {
                    let m = s.max(j4);
                    let at_s: (s <= m) = s.le_max_l(j4);
                    let em: (Rat::inv_succ(m) <= q) = Rat::inv_succ_antitone(j4, m, s.le_max_r(j4));
                    let dx: ((x.seq(n) -x.seq(m)).abs() <= fine + q) =
                        Rat::le_trans(x.regular(n, m), Rat::inv_succ(m).add_le_mono_l(q, fine, em));
                    let dy: ((y.seq(m) -y.seq(n)).abs() <= q + fine) =
                        Rat::le_trans(y.regular(m, n), Rat::inv_succ(m).add_le_mono_r(q, fine, em));
                    let near: ((x.seq(n) -y.seq(m)).abs() <= (fine + q) + q) = calc {
                        (x.seq(n) -y.seq(m)).abs() <= (x.seq(n) -x.seq(m)).abs() + (x.seq(m) -y.seq(m)).abs() := x.seq(n).dist_triangle(x.seq(m), y.seq(m)),
                        <= (fine + q) + q := Rat::add_le_mono(dx, close(m, at_s)),
                    };
                    let spare: (q <= q + q) = q.le_add_nonneg(q, Rat::le_of_lt(Rat::inv_succ_pos(j4)));
                    calc {
                        (x.seq(n) -y.seq(n)).abs() <= (x.seq(n) -y.seq(m)).abs() + (y.seq(m) -y.seq(n)).abs() := x.seq(n).dist_triangle(y.seq(m), y.seq(n)),
                        <= ((fine + q) + q) + (q + fine) := Rat::add_le_mono(near, dy),
                        ≈ (fine + (q + q)) + (q + fine) := Rat::add_respects(fine.add_assoc(q, q), (q + fine).same_refl()),
                        ≈ (fine + (q + q)) + (fine + q) := Rat::add_respects((fine + (q + q)).same_refl(), q.add_comm(fine)),
                        ≈ (fine + fine) + ((q + q) + q) := fine.add_add_add_comm(q + q, fine, q),
                        <= (fine + fine) + ((q + q) + (q + q)) := ((q + q) + q).add_le_mono_l((q + q) + (q + q), fine + fine, q.add_le_mono_l(q + q, q + q, spare)),
                        ≈ (fine + fine) + (quarter + quarter) := Rat::add_respects((fine + fine).same_refl(), Rat::add_respects(Rat::inv_succ_half(j2), Rat::inv_succ_half(j2))),
                        ≈ (fine + fine) + Rat::inv_succ(j) := Rat::add_respects((fine + fine).same_refl(), Rat::inv_succ_half(j)),
                    }
                },
            }
        })
    }
}

// ---------------------------------------------------------------------------
// The rationals inside the reals: constant sequences.

theorem CReal::const_regular(q: Rat, m, n: Nat): (q -q).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n) {
    calc {
        (q -q).abs() ≈ Rat::zero() := q.abs_sub_self(),
        <= Rat::inv_succ(m) + Rat::inv_succ(n) := omega,
    }
}

fn CReal::ofRat(q: Rat) → CReal { CReal(λ n => q, λ m n => CReal::const_regular(q, m, n)) }

fn CReal::zero() → CReal { CReal::ofRat(Rat::zero()) }
fn CReal::one() → CReal { CReal::ofRat(Rat::one()) }

theorem CReal::ofRat_respects({p, q: Rat}, h: p ≈ q): CReal::ofRat(p) ≈ CReal::ofRat(q) {
    CReal::ofRat(p).same_of_terms(CReal::ofRat(q), λ n => h)
}

// The embedding reflects `≈` too: rationals that become arbitrarily close
// are the same (`Rat::same_of_close`).
theorem CReal::ofRat_inj({p, q: Rat}, h: CReal::ofRat(p) ≈ CReal::ofRat(q)): p ≈ q {
    p.same_of_close(q, λ k => match h(k) {
        Exists(start, close) => close(start, start.le_refl()),
    })
}

// ---------------------------------------------------------------------------
// Arithmetic. Negation reads the same index; a sum reads index 2n+1 of both
// summands, so that the two rates of 1/(2n+2) add up to one of 1/(n+1).

theorem CReal::neg_regular(self x: CReal, m, n: Nat):
    ((-x.seq(m)) -(-x.seq(n))).abs() <= Rat::inv_succ(m) + Rat::inv_succ(n)
{
    calc {
        ((-x.seq(m)) -(-x.seq(n))).abs() ≈ (x.seq(m) -x.seq(n)).abs() := x.seq(m).abs_neg_sub_neg(x.seq(n)),
        <= Rat::inv_succ(m) + Rat::inv_succ(n) := x.regular(m, n),
    }
}

fn CReal::neg(self x: CReal) → CReal { CReal(λ n => -x.seq(n), λ m n => x.neg_regular(m, n)) }

theorem CReal::add_regular(self x, y: CReal, m, n: Nat):
    ((x.seq(m + m + 1) + y.seq(m + m + 1)) -(x.seq(n + n + 1) + y.seq(n + n + 1))).abs()
        <= Rat::inv_succ(m) + Rat::inv_succ(n)
{
    let hm = Rat::inv_succ(m + m + 1);
    let hn = Rat::inv_succ(n + n + 1);
    calc {
        ((x.seq(m + m + 1) + y.seq(m + m + 1)) -(x.seq(n + n + 1) + y.seq(n + n + 1))).abs()
            <= (hm + hn) + (hm + hn) := Rat::dist_add_le(x.regular(m + m + 1, n + n + 1), y.regular(m + m + 1, n + n + 1)),
            ≈ (hm + hm) + (hn + hn) := hm.add_add_add_comm(hn, hm, hn),
            ≈ Rat::inv_succ(m) + Rat::inv_succ(n) := Rat::add_respects(Rat::inv_succ_half(m), Rat::inv_succ_half(n)),
    }
}

fn CReal::add(self x, y: CReal) → CReal {
    CReal(λ n => x.seq(n + n + 1) + y.seq(n + n + 1), λ m n => x.add_regular(y, m, n))
}

designation + at CReal := CReal::add
designation prefix - at CReal := CReal::neg

fn CReal::sub(self x, y: CReal) → CReal { x + -y }

designation - at CReal := CReal::sub

theorem CReal::neg_respects({x, x2: CReal}, hx: x ≈ x2): -x ≈ -x2 {
    λ k => match hx(k) {
        Exists(start, close) => Exists(start, λ n from => calc {
            ((-x.seq(n)) -(-x2.seq(n))).abs() ≈ (x.seq(n) -x2.seq(n)).abs() := x.seq(n).abs_neg_sub_neg(x2.seq(n)),
            <= Rat::inv_succ(k) := close(n, from),
        }),
    }
}

// Each summand within 1/(2k+2) of its partner from index 2n+1 on; n is past
// both starts, so 2n+1 is too.
theorem CReal::add_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x + y ≈ x2 + y2 {
    λ k => match hx(k + k + 1) {
        Exists(i, cx) => match hy(k + k + 1) {
            Exists(j, cy) => Exists(i.max(j), λ n from => {
                let far: (n <= n + n + 1) = omega;
                let at_x: (i <= n + n + 1) = i.le_trans(n, n + n + 1, i.le_trans(i.max(j), n, i.le_max_l(j), from), far);
                let at_y: (j <= n + n + 1) = j.le_trans(n, n + n + 1, j.le_trans(i.max(j), n, i.le_max_r(j), from), far);
                let half = Rat::inv_succ(k + k + 1);
                let a: ((x.seq(n + n + 1) -x2.seq(n + n + 1)).abs() <= half) = cx(n + n + 1, at_x);
                let b: ((y.seq(n + n + 1) -y2.seq(n + n + 1)).abs() <= half) = cy(n + n + 1, at_y);
                calc {
                    ((x.seq(n + n + 1) + y.seq(n + n + 1)) -(x2.seq(n + n + 1) + y2.seq(n + n + 1))).abs()
                        <= half + half := Rat::dist_add_le(a, b),
                        ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                }
            }),
        },
    }
}

theorem CReal::sub_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x -y ≈ x2 -y2 {
    CReal::add_respects(hx, CReal::neg_respects(hy))
}

instance Respects2<CReal, CReal, CReal>(CReal::Same, CReal::Same, CReal::Same, CReal::add) {
    respects2 := λ x x2 hx y y2 hy => CReal::add_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The additive laws, modulo `≈`. Commutativity and inverses hold term by
// term; the identity and associativity compare terms at different indices,
// which regularity bounds.

theorem CReal::add_comm(self x, y: CReal): x + y ≈ y + x {
    (x + y).same_of_terms(y + x, λ n => x.seq(n + n + 1).add_comm(y.seq(n + n + 1)))
}

theorem CReal::add_neg(self x: CReal): x + -x ≈ CReal::zero() {
    (x + -x).same_of_terms(CReal::zero(), λ n => x.seq(n + n + 1).add_neg())
}

theorem CReal::add_zero(self x: CReal): x + CReal::zero() ≈ x {
    (x + CReal::zero()).same_of_close(x, λ k n from => {
        let far: (k + k + 1 <= n + n + 1) = omega;
        calc {
            ((x.seq(n + n + 1) + Rat::zero()) -x.seq(n)).abs()
                ≈ (x.seq(n + n + 1) -x.seq(n)).abs() := Rat::abs_respects(Rat::sub_respects(x.seq(n + n + 1).add_zero(), x.seq(n).same_refl())),
                <= Rat::inv_succ(k) := x.regular_close(k, n + n + 1, n, far, from),
        }
    })
}

// ((x + y) + z) reads x and y at 4n+3 and z at 2n+1; (x + (y + z)) reads x
// at 2n+1 and y and z at 4n+3. After reassociating, y's terms cancel and x's
// and z's two terms are within 1/(2k+2) each once n is past 2k+1.
theorem CReal::add_assoc(self x, y, z: CReal): (x + y) + z ≈ x + (y + z) {
    ((x + y) + z).same_of_close(x + (y + z), λ k n from => {
        let i = n + n + 1;
        let j = i + i + 1;
        let half = Rat::inv_succ(k + k + 1);
        let at_i: (k + k + 1 + (k + k + 1) + 1 <= i) = omega;
        let at_j: (k + k + 1 + (k + k + 1) + 1 <= j) = omega;
        let dx: ((x.seq(j) -x.seq(i)).abs() <= half) = x.regular_close(k + k + 1, j, i, at_j, at_i);
        let dz: ((z.seq(i) -z.seq(j)).abs() <= half) = z.regular_close(k + k + 1, i, j, at_i, at_j);
        let dy: ((y.seq(j) -y.seq(j)).abs() <= Rat::zero()) = Rat::le_of_same(y.seq(j).abs_sub_self());
        calc {
            (((x.seq(j) + y.seq(j)) + z.seq(i)) -(x.seq(i) + (y.seq(j) + z.seq(j)))).abs()
                ≈ ((x.seq(j) + (y.seq(j) + z.seq(i))) -(x.seq(i) + (y.seq(j) + z.seq(j)))).abs()
                    := Rat::abs_respects(Rat::sub_respects(x.seq(j).add_assoc(y.seq(j), z.seq(i)), (x.seq(i) + (y.seq(j) + z.seq(j))).same_refl())),
                <= half + (Rat::zero() + half) := Rat::dist_add_le(dx, Rat::dist_add_le(dy, dz)),
                ≈ half + (half + Rat::zero()) := Rat::add_respects(half.same_refl(), Rat::zero().add_comm(half)),
                ≈ half + half := Rat::add_respects(half.same_refl(), half.add_zero()),
                ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
        }
    })
}

instance Semigroup<CReal>(CReal::Same, CReal::add) {
    assoc := CReal::add_assoc,
}

instance Commutative<CReal>(CReal::Same, CReal::add) {
    comm := CReal::add_comm,
}

// The embedding is additive.
theorem CReal::ofRat_neg(q: Rat): CReal::ofRat(-q) ≈ -CReal::ofRat(q) {
    CReal::ofRat(-q).same_of_terms(-CReal::ofRat(q), λ n => (-q).same_refl())
}

theorem CReal::ofRat_add(p, q: Rat): CReal::ofRat(p + q) ≈ CReal::ofRat(p) + CReal::ofRat(q) {
    CReal::ofRat(p + q).same_of_terms(CReal::ofRat(p) + CReal::ofRat(q), λ n => (p + q).same_refl())
}

// ---------------------------------------------------------------------------
// Multiplication. A product's error is each factor's error weighted by the
// other factor's size, so a product reads its factors further out the larger
// they are. Every real has a canonical bound, `bound`: |x_0| rounded up, plus
// 2, since every term is within 1 + 1 of x_0. The product of x and y reads
// both at index (l+1)(2n+2) - 1, l the larger of the two bounds: each
// factor's error there is 1/((l+1)(2n+2)), the other factor's l+1 scales it
// back to 1/(2n+2) (`Rat::scale_inv_succ`), and the two halves make 1/(n+1).
//
// The bound is a function of the representation, not of the real: two `≈`
// reals can have different bounds, so a product of `≈` factors reads them at
// different indices, and every law below compares terms across indices. One
// estimate, `mul_close`, does all of that work.

fn CReal::bound(self x: CReal) → Nat { x.seq(0).num.natAbs() + 2 }

theorem CReal::bound_le(self x: CReal, n: Nat): x.seq(n).abs() <= Rat::ofInt(OfNat(x.bound())) {
    let a = x.seq(0);
    let top = Rat::ofInt(OfNat(a.num.natAbs()));
    let two = Rat::one() + Rat::one();
    calc {
        x.seq(n).abs() ≈ ((x.seq(n) -a) + a).abs() := Rat::abs_respects(Rat::same_sym(x.seq(n).sub_add_cancel(a))),
        <= (x.seq(n) -a).abs() + a.abs() := (x.seq(n) -a).abs_triangle(a),
        <= (Rat::inv_succ(n) + Rat::inv_succ(0)) + top := Rat::add_le_mono(x.regular(n, 0), a.abs_le_natAbs()),
        <= two + top := (Rat::inv_succ(n) + Rat::inv_succ(0)).add_le_mono_r(two, top,
            Rat::add_le_mono(Rat::inv_succ_le_one(n), Rat::inv_succ_le_one(0))),
        ≈ Rat::ofInt(OfNat(x.bound())) := Rat::two_add_ofNat(a.num.natAbs()),
    }
}

theorem CReal::bound_below(self x: CReal, n, m: Nat, h: x.bound() <= m): x.seq(n).abs() <= Rat::ofInt(OfNat(m)) {
    Rat::le_trans(x.bound_le(n), Rat::ofInt_le(OfNat(x.bound()), OfNat(m), h))
}

// x ≈ x2 read at two far indices, not one: within 1/(2k+2) along x by
// regularity, then within 1/(2k+2) across to x2.
theorem CReal::same_close_far({x, x2: CReal}, h: x ≈ x2, k: Nat):
    ∃ start: Nat, (a, b: Nat) → start <= a → start <= b → (x.seq(a) -x2.seq(b)).abs() <= Rat::inv_succ(k)
{
    let k2 = k + k + 1;
    let far = k2 + k2 + 1;
    let half = Rat::inv_succ(k2);
    match h(k2) {
        Exists(i, close) => Exists(i.max(far), λ a b ha hb => {
            let reg_a: (far <= a) = far.le_trans(i.max(far), a, i.le_max_r(far), ha);
            let reg_b: (far <= b) = far.le_trans(i.max(far), b, i.le_max_r(far), hb);
            let at_b: (i <= b) = i.le_trans(i.max(far), b, i.le_max_l(far), hb);
            calc {
                (x.seq(a) -x2.seq(b)).abs() <= (x.seq(a) -x.seq(b)).abs() + (x.seq(b) -x2.seq(b)).abs() := x.seq(a).dist_triangle(x.seq(b), x2.seq(b)),
                <= half + half := Rat::add_le_mono(x.regular_close(k2, a, b, reg_a, reg_b), close(b, at_b)),
                ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
            }
        }),
    }
}

// The estimate behind every product law: two products of `≈` factors, each
// factor read at its own index, are within 1/(k+1) once every index is far
// enough out. With both sides' factors under l+1 and each pair of factors
// within 1/((l+1)(2k+2)), `Rat::dist_mul_le` bounds the difference by two
// halves of 1/(k+1). Taking the four indices independently lets one lemma
// serve products read at different depths, as the laws' two sides are.
theorem CReal::mul_close({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, k: Nat):
    ∃ start: Nat, (a, b, c, d: Nat) → start <= a → start <= b → start <= c → start <= d →
        (x.seq(a) * y.seq(b) -x2.seq(c) * y2.seq(d)).abs() <= Rat::inv_succ(k)
{
    let l = x.bound() + y2.bound();
    let k2 = k + k + 1;
    let j = l * (k2 + 1) + k2;
    let big = Rat::ofInt(OfNat(l + 1));
    let e = Rat::inv_succ(j);
    match CReal::same_close_far(hx, j) {
        Exists(s, cx) => match CReal::same_close_far(hy, j) {
            Exists(t, cy) => Exists(s.max(t), λ a b c d ha hb hc hd => {
                let in_s = s.le_max_l(t);
                let in_t = s.le_max_r(t);
                let near_x: ((x.seq(a) -x2.seq(c)).abs() <= e) =
                    cx(a, c, s.le_trans(s.max(t), a, in_s, ha), s.le_trans(s.max(t), c, in_s, hc));
                let near_y: ((y.seq(b) -y2.seq(d)).abs() <= e) =
                    cy(b, d, t.le_trans(s.max(t), b, in_t, hb), t.le_trans(s.max(t), d, in_t, hd));
                let size_x: (x.seq(a).abs() <= big) = x.bound_below(a, l + 1, x.bound().le_succ_r(l, x.bound().le_add_l(y2.bound())));
                let size_y: (y2.seq(d).abs() <= big) = y2.bound_below(d, l + 1, y2.bound().le_succ_r(l, x.bound().le_add_r(y2.bound())));
                calc {
                    (x.seq(a) * y.seq(b) -x2.seq(c) * y2.seq(d)).abs() <= big * e + big * e := Rat::dist_mul_le(size_x, size_y, near_y, near_x),
                    ≈ Rat::inv_succ(k) := Rat::scale_inv_succ_half(l, k),
                }
            }),
        },
    }
}

// Where a product reads its factors: (l+1)(2n+2) - 1, at or past n.
fn CReal::mul_at(self x, y: CReal, n: Nat) → Nat { x.bound().max(y.bound()) * (n + n + 1 + 1) + (n + n + 1) }

theorem CReal::mul_at_ge(self x, y: CReal, n: Nat): n <= x.mul_at(y, n) {
    let l = x.bound().max(y.bound());
    n.le_trans(n + n + 1, x.mul_at(y, n), n.le_add_l(n + 1), (l * (n + n + 1 + 1)).le_add_r(n + n + 1))
}

// Both factors move by 1/(a+1) + 1/(b+1) between the two indices, and each
// movement is weighted by the other factor's bound.
theorem CReal::mul_regular(self x, y: CReal, m, n: Nat):
    (x.seq(x.mul_at(y, m)) * y.seq(x.mul_at(y, m)) -x.seq(x.mul_at(y, n)) * y.seq(x.mul_at(y, n))).abs()
        <= Rat::inv_succ(m) + Rat::inv_succ(n)
{
    let l = x.bound().max(y.bound());
    let a = x.mul_at(y, m);
    let b = x.mul_at(y, n);
    let big = Rat::ofInt(OfNat(l + 1));
    let fa = Rat::inv_succ(a);
    let fb = Rat::inv_succ(b);
    let size_x: (x.seq(a).abs() <= big) = x.bound_below(a, l + 1, x.bound().le_succ_r(l, x.bound().le_max_l(y.bound())));
    let size_y: (y.seq(b).abs() <= big) = y.bound_below(b, l + 1, y.bound().le_succ_r(l, x.bound().le_max_r(y.bound())));
    calc {
        (x.seq(a) * y.seq(a) -x.seq(b) * y.seq(b)).abs() <= big * (fa + fb) + big * (fa + fb)
            := Rat::dist_mul_le(size_x, size_y, y.regular(a, b), x.regular(a, b)),
        ≈ (big * fa + big * fa) + (big * fb + big * fb) := big.mul_add_twice(fa, fb),
        ≈ Rat::inv_succ(m) + Rat::inv_succ(n) := Rat::add_respects(Rat::scale_inv_succ_half(l, m), Rat::scale_inv_succ_half(l, n)),
    }
}

fn CReal::mul(self x, y: CReal) → CReal {
    CReal(λ n => x.seq(x.mul_at(y, n)) * y.seq(x.mul_at(y, n)), λ m n => x.mul_regular(y, m, n))
}

designation * at CReal := CReal::mul

theorem CReal::mul_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2): x * y ≈ x2 * y2 {
    λ k => match CReal::mul_close(hx, hy, k) {
        Exists(s, close) => Exists(s, λ n from => {
            let a = x.mul_at(y, n);
            let b = x2.mul_at(y2, n);
            let at_a: (s <= a) = s.le_trans(n, a, from, x.mul_at_ge(y, n));
            let at_b: (s <= b) = s.le_trans(n, b, from, x2.mul_at_ge(y2, n));
            close(a, a, b, b, at_a, at_a, at_b, at_b)
        }),
    }
}

instance Respects2<CReal, CReal, CReal>(CReal::Same, CReal::Same, CReal::Same, CReal::mul) {
    respects2 := λ x x2 hx y y2 hy => CReal::mul_respects(hx, hy),
}

// ---------------------------------------------------------------------------
// The multiplicative laws, modulo `≈`. Only `ofRat_mul` and `mul_zero` hold
// term by term; the others read their two sides at different indices (even
// commutativity, since `x.bound().max(y.bound())` and
// `y.bound().max(x.bound())` are equal numbers but not the same term), so
// they go through `mul_close` with reflexivity.

theorem CReal::mul_comm(self x, y: CReal): x * y ≈ y * x {
    λ k => match CReal::mul_close(x.same_refl(), y.same_refl(), k) {
        Exists(s, close) => Exists(s, λ n from => {
            let a = x.mul_at(y, n);
            let b = y.mul_at(x, n);
            let at_a: (s <= a) = s.le_trans(n, a, from, x.mul_at_ge(y, n));
            let at_b: (s <= b) = s.le_trans(n, b, from, y.mul_at_ge(x, n));
            calc {
                (x.seq(a) * y.seq(a) -y.seq(b) * x.seq(b)).abs() ≈ (x.seq(a) * y.seq(a) -x.seq(b) * y.seq(b)).abs()
                    := Rat::abs_respects(Rat::sub_respects((x.seq(a) * y.seq(a)).same_refl(), y.seq(b).mul_comm(x.seq(b)))),
                <= Rat::inv_succ(k) := close(a, a, b, b, at_a, at_a, at_b, at_b),
            }
        }),
    }
}

// ((x * y) * z) reads z at a and x and y at a2 further out; (x * (y * z))
// reads x at b and y and z at b2. Reassociated, both are a product of an x
// term with a y·z term, so `Rat::dist_mul_le` applies once more, with the
// y·z terms bounded by the product of the bounds and their distance by
// `mul_close`.
theorem CReal::mul_assoc(self x, y, z: CReal): (x * y) * z ≈ x * (y * z) {
    λ k => {
        let l = x.bound() + y.bound() * z.bound();
        let k2 = k + k + 1;
        let j = l * (k2 + 1) + k2;
        let big = Rat::ofInt(OfNat(l + 1));
        let e = Rat::inv_succ(j);
        match CReal::same_close_far(x.same_refl(), j) {
            Exists(s, cx) => match CReal::mul_close(y.same_refl(), z.same_refl(), j) {
                Exists(t, cyz) => Exists(s.max(t), λ n from => {
                    let a = (x * y).mul_at(z, n);
                    let a2 = x.mul_at(y, a);
                    let b = x.mul_at(y * z, n);
                    let b2 = y.mul_at(z, b);
                    let at_a: (n <= a) = (x * y).mul_at_ge(z, n);
                    let at_a2: (n <= a2) = n.le_trans(a, a2, at_a, x.mul_at_ge(y, a));
                    let at_b: (n <= b) = x.mul_at_ge(y * z, n);
                    let at_b2: (n <= b2) = n.le_trans(b, b2, at_b, y.mul_at_ge(z, b));
                    let at_s: (s <= n) = s.le_trans(s.max(t), n, s.le_max_l(t), from);
                    let at_t: (t <= n) = t.le_trans(s.max(t), n, s.le_max_r(t), from);
                    let near_x: ((x.seq(a2) -x.seq(b)).abs() <= e) =
                        cx(a2, b, s.le_trans(n, a2, at_s, at_a2), s.le_trans(n, b, at_s, at_b));
                    let near_yz: ((y.seq(a2) * z.seq(a) -y.seq(b2) * z.seq(b2)).abs() <= e) =
                        cyz(a2, a, b2, b2, t.le_trans(n, a2, at_t, at_a2), t.le_trans(n, a, at_t, at_a),
                            t.le_trans(n, b2, at_t, at_b2), t.le_trans(n, b2, at_t, at_b2));
                    let size_x: (x.seq(a2).abs() <= big) =
                        x.bound_below(a2, l + 1, x.bound().le_succ_r(l, x.bound().le_add_l(y.bound() * z.bound())));
                    let yb = Rat::ofInt(OfNat(y.bound()));
                    let zb = Rat::ofInt(OfNat(z.bound()));
                    let size_yz: ((y.seq(b2) * z.seq(b2)).abs() <= big) = calc {
                        (y.seq(b2) * z.seq(b2)).abs() ≈ y.seq(b2).abs() * z.seq(b2).abs() := y.seq(b2).abs_mul(z.seq(b2)),
                        <= yb * zb := Rat::mul_le_mul(y.bound_le(b2), z.bound_le(b2), y.seq(b2).abs_nonneg(), z.seq(b2).abs_nonneg()),
                        ≈ Rat::ofInt(OfNat(y.bound() * z.bound())) := Rat::same_sym(Rat::ofInt_mul(OfNat(y.bound()), OfNat(z.bound()))),
                        <= big := Rat::ofInt_le(OfNat(y.bound() * z.bound()), OfNat(l + 1),
                            (y.bound() * z.bound()).le_succ_r(l, x.bound().le_add_r(y.bound() * z.bound()))),
                    };
                    calc {
                        ((x.seq(a2) * y.seq(a2)) * z.seq(a) -x.seq(b) * (y.seq(b2) * z.seq(b2))).abs()
                            ≈ (x.seq(a2) * (y.seq(a2) * z.seq(a)) -x.seq(b) * (y.seq(b2) * z.seq(b2))).abs()
                                := Rat::abs_respects(Rat::sub_respects(x.seq(a2).mul_assoc(y.seq(a2), z.seq(a)),
                                    (x.seq(b) * (y.seq(b2) * z.seq(b2))).same_refl())),
                            <= big * e + big * e := Rat::dist_mul_le(size_x, size_yz, near_yz, near_x),
                            ≈ Rat::inv_succ(k) := Rat::scale_inv_succ_half(l, k),
                    }
                }),
            },
        }
    }
}

// x * (y + z) reads y and z at 2a+1 beyond x's index a; x * y + x * z reads
// each product at its own index past 2n+1. After distributing the rational
// product, each pair of products is within 1/(2k+2) by `mul_close`.
theorem CReal::mul_add_distr(self x, y, z: CReal): x * (y + z) ≈ x * y + x * z {
    λ k => {
        let k2 = k + k + 1;
        let half = Rat::inv_succ(k2);
        match CReal::mul_close(x.same_refl(), y.same_refl(), k2) {
            Exists(s, cy) => match CReal::mul_close(x.same_refl(), z.same_refl(), k2) {
                Exists(t, cz) => Exists(s.max(t), λ n from => {
                    let a = x.mul_at(y + z, n);
                    let q = a + a + 1;
                    let p = n + n + 1;
                    let b = x.mul_at(y, p);
                    let c = x.mul_at(z, p);
                    let at_a: (n <= a) = x.mul_at_ge(y + z, n);
                    let at_q: (n <= q) = n.le_trans(a, q, at_a, a.le_add_l(a + 1));
                    let at_p: (n <= p) = n.le_add_l(n + 1);
                    let at_b: (n <= b) = n.le_trans(p, b, at_p, x.mul_at_ge(y, p));
                    let at_c: (n <= c) = n.le_trans(p, c, at_p, x.mul_at_ge(z, p));
                    let at_s: (s <= n) = s.le_trans(s.max(t), n, s.le_max_l(t), from);
                    let at_t: (t <= n) = t.le_trans(s.max(t), n, s.le_max_r(t), from);
                    let dy: ((x.seq(a) * y.seq(q) -x.seq(b) * y.seq(b)).abs() <= half) =
                        cy(a, q, b, b, s.le_trans(n, a, at_s, at_a), s.le_trans(n, q, at_s, at_q),
                            s.le_trans(n, b, at_s, at_b), s.le_trans(n, b, at_s, at_b));
                    let dz: ((x.seq(a) * z.seq(q) -x.seq(c) * z.seq(c)).abs() <= half) =
                        cz(a, q, c, c, t.le_trans(n, a, at_t, at_a), t.le_trans(n, q, at_t, at_q),
                            t.le_trans(n, c, at_t, at_c), t.le_trans(n, c, at_t, at_c));
                    let other = x.seq(b) * y.seq(b) + x.seq(c) * z.seq(c);
                    calc {
                        (x.seq(a) * (y.seq(q) + z.seq(q)) -other).abs()
                            ≈ ((x.seq(a) * y.seq(q) + x.seq(a) * z.seq(q)) -other).abs()
                                := Rat::abs_respects(Rat::sub_respects(x.seq(a).mul_add_distr(y.seq(q), z.seq(q)), other.same_refl())),
                            <= half + half := Rat::dist_add_le(dy, dz),
                            ≈ Rat::inv_succ(k) := Rat::inv_succ_half(k),
                    }
                }),
            },
        }
    }
}

// x * 1 reads x further out, within 1/(k+1) of x_n once n is past 2k+1.
theorem CReal::mul_one(self x: CReal): x * CReal::one() ≈ x {
    (x * CReal::one()).same_of_close(x, λ k n from => {
        let a = x.mul_at(CReal::one(), n);
        let far: (k + k + 1 <= a) = (k + k + 1).le_trans(n, a, from, x.mul_at_ge(CReal::one(), n));
        calc {
            (x.seq(a) * Rat::one() -x.seq(n)).abs() ≈ (x.seq(a) -x.seq(n)).abs()
                := Rat::abs_respects(Rat::sub_respects(x.seq(a).mul_one(), x.seq(n).same_refl())),
            <= Rat::inv_succ(k) := x.regular_close(k, a, n, far, from),
        }
    })
}

theorem CReal::mul_zero(self x: CReal): x * CReal::zero() ≈ CReal::zero() {
    (x * CReal::zero()).same_of_terms(CReal::zero(), λ n => {
        let t = x.seq(x.mul_at(CReal::zero(), n));
        Rat::same_trans(t.mul_comm(Rat::zero()), t.zero_mul())
    })
}

instance Semigroup<CReal>(CReal::Same, CReal::mul) {
    assoc := CReal::mul_assoc,
}

instance Commutative<CReal>(CReal::Same, CReal::mul) {
    comm := CReal::mul_comm,
}

// The embedding is multiplicative, term by term: a constant sequence reads
// the same at every index.
theorem CReal::ofRat_mul(p, q: Rat): CReal::ofRat(p * q) ≈ CReal::ofRat(p) * CReal::ofRat(q) {
    CReal::ofRat(p * q).same_of_terms(CReal::ofRat(p) * CReal::ofRat(q), λ n => (p * q).same_refl())
}

// ---------------------------------------------------------------------------
// Strict order and apartness. x < y when, from some index on, y's terms stay
// above x's by a fixed 1/(k+1): a positive gap given as data (the gap's size
// and where it starts), never a refutation of `≤`. No order on reals is ever
// decided; the rationals' order is consulted only term by term.

fn CReal::Lt(x, y: CReal) → Type {
    ∃ k: Nat, ∃ start: Nat, (n: Nat) → start <= n → x.seq(n) + Rat::inv_succ(k) <= y.seq(n)
}

designation < at CReal := CReal::Lt

// One index far enough out, where y's term clears x's by 1/(2k+2), is
// enough: from there on later terms of each move by at most 1/(8k+8), so a
// gap of 1/(4k+4) remains.
theorem CReal::lt_of_term(self x, y: CReal, k, n: Nat, far: 16 * k + 15 <= n,
    h: x.seq(n) + Rat::inv_succ(k + k + 1) <= y.seq(n)): x < y
{
    let k2 = k + k + 1;
    let k4 = k2 + k2 + 1;
    let k8 = k4 + k4 + 1;
    let q = Rat::inv_succ(k4);
    let e = Rat::inv_succ(k8);
    let at_n: (k8 + k8 + 1 <= n) = omega;
    let gap = calc {
        x.seq(n) + (q + (e + e)) ≈ x.seq(n) + (q + q) := Rat::add_respects(x.seq(n).same_refl(), Rat::add_respects(q.same_refl(), Rat::inv_succ_half(k4))),
        ≈ x.seq(n) + Rat::inv_succ(k2) := Rat::add_respects(x.seq(n).same_refl(), Rat::inv_succ_half(k2)),
        <= y.seq(n) := h,
    };
    Exists(k4, Exists(n, λ m from => {
        let at_m: (k8 + k8 + 1 <= m) = omega;
        let dx: ((x.seq(m) -x.seq(n)).abs() <= e) = x.regular_close(k8, m, n, at_m, at_n);
        let dy: ((y.seq(n) -y.seq(m)).abs() <= e) = y.regular_close(k8, n, m, at_n, at_m);
        Rat::le_of_close_gap(Rat::le_add_of_dist(dx), Rat::le_add_of_dist(dy), gap)
    }))
}

// Moving each side by 1/(4k+4) along `≈` costs half of a 1/(k+1) gap.
theorem CReal::lt_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, h: x < y): x2 < y2 {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let k4 = k2 + k2 + 1;
                let half = Rat::inv_succ(k2);
                let e = Rat::inv_succ(k4);
                match hx(k4) {
                    Exists(i, cx) => match hy(k4) {
                        Exists(j, cy) => Exists(k2, Exists(s.max(i.max(j)), λ n from => {
                            let inner: (i.max(j) <= n) = i.max(j).le_trans(s.max(i.max(j)), n, s.le_max_r(i.max(j)), from);
                            let at_s: (s <= n) = s.le_trans(s.max(i.max(j)), n, s.le_max_l(i.max(j)), from);
                            let at_i: (i <= n) = i.le_trans(i.max(j), n, i.le_max_l(j), inner);
                            let at_j: (j <= n) = j.le_trans(i.max(j), n, i.le_max_r(j), inner);
                            let dx: ((x2.seq(n) -x.seq(n)).abs() <= e) = calc {
                                (x2.seq(n) -x.seq(n)).abs() ≈ (x.seq(n) -x2.seq(n)).abs() := x2.seq(n).abs_sub_comm(x.seq(n)),
                                <= e := cx(n, at_i),
                            };
                            let dy: ((y.seq(n) -y2.seq(n)).abs() <= e) = cy(n, at_j);
                            let wide = calc {
                                x.seq(n) + (half + (e + e)) ≈ x.seq(n) + (half + half) := Rat::add_respects(x.seq(n).same_refl(), Rat::add_respects(half.same_refl(), Rat::inv_succ_half(k2))),
                                ≈ x.seq(n) + Rat::inv_succ(k) := Rat::add_respects(x.seq(n).same_refl(), Rat::inv_succ_half(k)),
                                <= y.seq(n) := gap(n, at_s),
                            };
                            Rat::le_of_close_gap(Rat::le_add_of_dist(dx), Rat::le_add_of_dist(dy), wide)
                        })),
                    },
                }
            },
        },
    }
}

theorem CReal::lt_irrefl(self x: CReal): ¬(x < x) {
    λ h => match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let a = x.seq(s);
                let step = Rat::inv_succ(k);
                let swapped = calc {
                    step + a ≈ a + step := step.add_comm(a),
                    <= a := gap(s, s.le_refl()),
                    ≈ a + Rat::zero() := Rat::same_sym(a.add_zero()),
                    ≈ Rat::zero() + a := a.add_comm(Rat::zero()),
                };
                Rat::not_le_of_lt(Rat::inv_succ_pos(k), step.add_le_cancel_r(Rat::zero(), a, swapped))
            },
        },
    }
}

// The gaps add, so the first one survives.
theorem CReal::lt_trans({x, y, z: CReal}, h1: x < y, h2: y < z): x < z {
    match h1 {
        Exists(k, r1) => match r1 {
            Exists(s, g1) => match h2 {
                Exists(l, r2) => match r2 {
                    Exists(t, g2) => Exists(k, Exists(s.max(t), λ n from => {
                        let at_s: (s <= n) = s.le_trans(s.max(t), n, s.le_max_l(t), from);
                        let at_t: (t <= n) = t.le_trans(s.max(t), n, s.le_max_r(t), from);
                        calc {
                            x.seq(n) + Rat::inv_succ(k) <= y.seq(n) := g1(n, at_s),
                            <= y.seq(n) + Rat::inv_succ(l) := y.seq(n).le_add_nonneg(Rat::inv_succ(l), Rat::le_of_lt(Rat::inv_succ_pos(l))),
                            <= z.seq(n) := g2(n, at_t),
                        }
                    })),
                },
            },
        },
    }
}

// Cotransitivity, the constructive replacement for trichotomy. Far enough
// out, compare z's term with the midpoint of x's and y's: the rationals
// decide that, and either side of the midpoint leaves half the gap.
theorem CReal::lt_cotrans(self x, y, z: CReal, h: x < y): x < z ∨ z < y {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let half = Rat::inv_succ(k + k + 1);
                let n = s.max(16 * k + 15);
                let at_s: (s <= n) = s.le_max_l(16 * k + 15);
                let far: (16 * k + 15 <= n) = s.le_max_r(16 * k + 15);
                match (x.seq(n) + half).le_dec(z.seq(n)) {
                    Inl(above) => Inl(x.lt_of_term(z, k, n, far, above)),
                    Inr(below) => {
                        let clear = calc {
                            z.seq(n) + half < (x.seq(n) + half) + half := z.seq(n).add_lt_mono_r(x.seq(n) + half, half, Rat::lt_of_not_le(below)),
                            ≈ x.seq(n) + (half + half) := x.seq(n).add_assoc(half, half),
                            ≈ x.seq(n) + Rat::inv_succ(k) := Rat::add_respects(x.seq(n).same_refl(), Rat::inv_succ_half(k)),
                            <= y.seq(n) := gap(n, at_s),
                        };
                        Inr(z.lt_of_term(y, k, n, far, Rat::le_of_lt(clear)))
                    },
                }
            },
        },
    }
}

instance Irreflexive<CReal>(CReal::Lt) {
    rel_irrefl := CReal::lt_irrefl,
}

instance Transitive<CReal>(CReal::Lt) {
    rel_trans := λ x y z hxy hyz => CReal::lt_trans(hxy, hyz),
}

// The mixed pairs a `calc` chain composes: `≈` is absorbed by `<` on either
// side.
instance Trans<CReal>(CReal::Same, CReal::Lt, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_respects(CReal::same_sym(hxy), z.same_refl(), hyz),
}

instance Trans<CReal>(CReal::Lt, CReal::Same, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_respects(x.same_refl(), hyz, hxy),
}

// Apartness: one of the two is below the other, by a gap given as data.
fn CReal::Apart(x, y: CReal) → Type { x < y ∨ y < x }

theorem CReal::apart_irrefl(self x: CReal): ¬(x.Apart(x)) {
    λ h => match h {
        Inl(lt) => x.lt_irrefl(lt),
        Inr(lt) => x.lt_irrefl(lt),
    }
}

theorem CReal::apart_sym({x, y: CReal}, h: x.Apart(y)): y.Apart(x) {
    match h {
        Inl(lt) => Inr(lt),
        Inr(gt) => Inl(gt),
    }
}

theorem CReal::apart_cotrans(self x, y, z: CReal, h: x.Apart(y)): x.Apart(z) ∨ z.Apart(y) {
    match h {
        Inl(lt) => match x.lt_cotrans(y, z, lt) {
            Inl(xz) => Inl(Inl(xz)),
            Inr(zy) => Inr(Inl(zy)),
        },
        Inr(gt) => match y.lt_cotrans(x, z, gt) {
            Inl(yz) => Inr(Inr(yz)),
            Inr(zx) => Inl(Inr(zx)),
        },
    }
}

// Tightness: reals that are not apart are the same. Far enough out, a term
// of either more than 1/(2k+2) above the other's would start a gap; so the
// terms are within 1/(2k+2), hence within 1/(k+1). No decision on reals,
// and none on rationals either: `lt_of_not_le` is the integer order's.
theorem CReal::same_of_not_apart({x, y: CReal}, h: ¬(x.Apart(y))): x ≈ y {
    λ k => Exists(16 * k + 15, λ n far => {
        let half = Rat::inv_succ(k + k + 1);
        let not_above: ¬(y.seq(n) + half <= x.seq(n)) = λ le => h(Inr(y.lt_of_term(x, k, n, far, le)));
        let not_below: ¬(x.seq(n) + half <= y.seq(n)) = λ le => h(Inl(x.lt_of_term(y, k, n, far, le)));
        let close: ((x.seq(n) -y.seq(n)).abs() <= half) =
            Rat::dist_le_of_le_add(Rat::le_of_lt(Rat::lt_of_not_le(not_above)), Rat::le_of_lt(Rat::lt_of_not_le(not_below)));
        let finer: (k <= k + k + 1) = omega;
        Rat::le_trans(close, Rat::inv_succ_antitone(k, k + k + 1, finer))
    })
}

// The embedding preserves and reflects the strict order: a rational gap
// q - p is above some 1/(k+1) (`Rat::archimedean_inv`), and a real gap read
// at any index is a rational one.
theorem CReal::ofRat_lt({p, q: Rat}, h: p < q): CReal::ofRat(p) < CReal::ofRat(q) {
    match (q -p).archimedean_inv(Rat::sub_pos(h)) {
        Exists(k, small) => {
            let below: (Rat::inv_succ(k) < q -p) = small;
            let clear = calc {
                p + Rat::inv_succ(k) < p + (q -p) := Rat::inv_succ(k).add_lt_mono_l(q -p, p, below),
                ≈ q := p.add_sub_self(q),
            };
            Exists(k, Exists(0, λ n from => Rat::le_of_lt(clear)))
        },
    }
}

theorem CReal::lt_of_ofRat_lt({p, q: Rat}, h: CReal::ofRat(p) < CReal::ofRat(q)): p < q {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => calc {
                p ≈ p + Rat::zero() := Rat::same_sym(p.add_zero()),
                < p + Rat::inv_succ(k) := Rat::zero().add_lt_mono_l(Rat::inv_succ(k), p, Rat::inv_succ_pos(k)),
                <= q := gap(s, s.le_refl()),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The inverse of a real apart from zero. Apartness gives a gap: from some
// index `start` on, the terms are at least 1/(k+1) in size, on one side
// (`Away`). There a reciprocal moves by at most (k+1)² times what it inverts
// (`Rat::dist_recip_le`), so the inverse reads x at index (k+1)²(n+1) + n, or
// at `start` if that is later: the (k+1)² comes out of the rate there
// (`Rat::scale_inv_succ_le`). The gap is data, read off the apartness proof
// (`away_of_apart`), so the inverse computes; every law is proved for an
// arbitrary gap first (`inv_gap`), so two apartness proofs with different
// gaps give `≈` inverses.

fn CReal::Away(x: CReal, k, start: Nat) → Type {
    (n: Nat) → start <= n → Rat::inv_succ(k) <= x.seq(n).abs()
}

theorem CReal::away_of_apart(self x: CReal, h: x.Apart(CReal::zero())): ∃ k: Nat, ∃ start: Nat, x.Away(k, start) {
    match h {
        Inl(below) => match below {
            Exists(k, rest) => match rest {
                Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_abs_of_add_le_zero(gap(n, from)))),
            },
        },
        Inr(above) => match above {
            Exists(k, rest) => match rest {
                Exists(s, gap) => Exists(k, Exists(s, λ n from => Rat::le_abs_of_zero_add_le(gap(n, from)))),
            },
        },
    }
}

// Where the inverse reads x: past the gap's start, and far enough out for
// the reciprocal's (k+1)² to fit inside 1/(n+1).
fn CReal::inv_at(k, start, n: Nat) → Nat { start.max((k + 1) * (k + 1) * (n + 1) + n) }

theorem CReal::inv_at_start(k, start, n: Nat): start <= CReal::inv_at(k, start, n) {
    start.le_max_l((k + 1) * (k + 1) * (n + 1) + n)
}

theorem CReal::inv_at_far(k, start, n: Nat): (k + 1) * (k + 1) * (n + 1) + n <= CReal::inv_at(k, start, n) {
    start.le_max_r((k + 1) * (k + 1) * (n + 1) + n)
}

theorem CReal::inv_at_ge(k, start, n: Nat): n <= CReal::inv_at(k, start, n) {
    n.le_trans((k + 1) * (k + 1) * (n + 1) + n, CReal::inv_at(k, start, n),
        ((k + 1) * (k + 1) * (n + 1)).le_add_r(n), CReal::inv_at_far(k, start, n))
}

// Both terms are past the gap's start, so their reciprocals are within (k+1)²
// times their distance, and each index pays for its own (k+1)².
theorem CReal::inv_regular(self x: CReal, k, start: Nat, gap: x.Away(k, start), m, n: Nat):
    (x.seq(CReal::inv_at(k, start, m)).recip() -x.seq(CReal::inv_at(k, start, n)).recip()).abs()
        <= Rat::inv_succ(m) + Rat::inv_succ(n)
{
    let a = CReal::inv_at(k, start, m);
    let b = CReal::inv_at(k, start, n);
    let sq = (k + 1) * (k + 1);
    let big = Rat::ofInt(OfNat(sq));
    let fa = Rat::inv_succ(a);
    let fb = Rat::inv_succ(b);
    calc {
        (x.seq(a).recip() -x.seq(b).recip()).abs() <= big * (x.seq(a) -x.seq(b)).abs()
            := Rat::dist_recip_le(k, k, gap(a, CReal::inv_at_start(k, start, m)), gap(b, CReal::inv_at_start(k, start, n))),
        <= big * (fa + fb) := Rat::mul_le_mono_l(x.regular(a, b), Rat::ofNat_nonneg(sq)),
        ≈ big * fa + big * fb := big.mul_add_distr(fa, fb),
        <= Rat::inv_succ(m) + Rat::inv_succ(n) := Rat::add_le_mono(
            Rat::scale_inv_succ_le(sq, a, m, CReal::inv_at_far(k, start, m), fa.le_refl()),
            Rat::scale_inv_succ_le(sq, b, n, CReal::inv_at_far(k, start, n), fb.le_refl())),
    }
}

fn CReal::inv_gap(self x: CReal, k, start: Nat, gap: x.Away(k, start)) → CReal {
    CReal(λ n => x.seq(CReal::inv_at(k, start, n)).recip(), λ m n => x.inv_regular(k, start, gap, m, n))
}

// `x⁻¹` is this with `h` searched at the call
// (docs/inverse-power-notation-design.md): a local apartness, a local
// `0 < x` or `x < 0` (`apart_of_positive`), or a rational apart from zero
// (`ofRat_apart`).
fn CReal::inv(self x: CReal, h: x.Apart(CReal::zero()) := infer) → CReal {
    let g = x.away_of_apart(h);
    x.inv_gap(g.witness, g.proof.witness, g.proof.proof)
}

designation postfix ⁻¹ at CReal := CReal::inv

// `≈` reals with gaps (k, s) and (l, t): far enough out, the terms each
// inverse reads are within 1/((k+1)(l+1)(K+1)) of each other, wherever the
// two gaps put them, and the reciprocals within 1/(K+1).
theorem CReal::inv_gap_respects({x, x2: CReal}, hx: x ≈ x2, k, s: Nat, gap: x.Away(k, s), l, t: Nat, gap2: x2.Away(l, t)):
    x.inv_gap(k, s, gap) ≈ x2.inv_gap(l, t, gap2)
{
    λ K => {
        let p = (k + 1) * (l + 1);
        let j = p * (K + 1) + K;
        match CReal::same_close_far(hx, j) {
            Exists(r, close) => Exists(r, λ n from => {
                let a = CReal::inv_at(k, s, n);
                let b = CReal::inv_at(l, t, n);
                let near: ((x.seq(a) -x2.seq(b)).abs() <= Rat::inv_succ(j)) =
                    close(a, b, r.le_trans(n, a, from, CReal::inv_at_ge(k, s, n)), r.le_trans(n, b, from, CReal::inv_at_ge(l, t, n)));
                calc {
                    (x.seq(a).recip() -x2.seq(b).recip()).abs() <= Rat::ofInt(OfNat(p)) * (x.seq(a) -x2.seq(b)).abs()
                        := Rat::dist_recip_le(k, l, gap(a, CReal::inv_at_start(k, s, n)), gap2(b, CReal::inv_at_start(l, t, n))),
                    <= Rat::inv_succ(K) := Rat::scale_inv_succ_le(p, j, K, j.le_refl(), near),
                }
            }),
        }
    }
}

// x * x⁻¹ reads x at a and the inverse at a, which reads x at b further out.
// The term x_b · x_b⁻¹ is exactly 1, so the product's distance from 1 is
// x_b⁻¹ (at most k+1) times x_a - x_b, which regularity makes small.
theorem CReal::mul_inv_gap(self x: CReal, k, s: Nat, gap: x.Away(k, s)): x * x.inv_gap(k, s, gap) ≈ CReal::one() {
    let y = x.inv_gap(k, s, gap);
    λ K => {
        let j = (k + 1) * (K + 1) + K;
        Exists(j + j + 1, λ n from => {
            let a = x.mul_at(y, n);
            let b = CReal::inv_at(k, s, a);
            let at_a: (j + j + 1 <= a) = (j + j + 1).le_trans(n, a, from, x.mul_at_ge(y, n));
            let at_b: (j + j + 1 <= b) = (j + j + 1).le_trans(a, b, at_a, CReal::inv_at_ge(k, s, a));
            let away: (Rat::inv_succ(k) <= x.seq(b).abs()) = gap(b, CReal::inv_at_start(k, s, a));
            let u = x.seq(b).recip();
            let d = x.seq(a) -x.seq(b);
            let near: (d.abs() <= Rat::inv_succ(j)) = x.regular_close(j, a, b, at_a, at_b);
            calc {
                (x.seq(a) * u -Rat::one()).abs() ≈ (u * d).abs()
                    := Rat::abs_respects(Rat::mul_sub_one_of_inverse(x.seq(b).mul_recip(Rat::nonzero_of_gap(k, away)))),
                ≈ u.abs() * d.abs() := u.abs_mul(d),
                <= Rat::ofInt(OfNat(k + 1)) * d.abs() := Rat::mul_le_mono_r(Rat::recip_abs_le(k, away), d.abs_nonneg()),
                <= Rat::inv_succ(K) := Rat::scale_inv_succ_le(k + 1, j, K, j.le_refl(), near),
            }
        })
    }
}

// The laws at an apartness proof: whichever gaps the two proofs carry.
theorem CReal::inv_respects({x, x2: CReal}, hx: x ≈ x2, h: x.Apart(CReal::zero()) := infer, h2: x2.Apart(CReal::zero()) := infer):
    x⁻¹ ≈ x2⁻¹
{
    let g = x.away_of_apart(h);
    let g2 = x2.away_of_apart(h2);
    CReal::inv_gap_respects(hx, g.witness, g.proof.witness, g.proof.proof, g2.witness, g2.proof.witness, g2.proof.proof)
}

theorem CReal::mul_inv(self x: CReal, h: x.Apart(CReal::zero()) := infer): x * x⁻¹ ≈ CReal::one() {
    let g = x.away_of_apart(h);
    x.mul_inv_gap(g.witness, g.proof.witness, g.proof.proof)
}

theorem CReal::inv_mul(self x: CReal, h: x.Apart(CReal::zero()) := infer): x⁻¹ * x ≈ CReal::one() {
    CReal::same_trans(x⁻¹.mul_comm(x), x.mul_inv())
}

// A rational apart from zero is a real apart from zero.
evidence theorem CReal::ofRat_apart({q: Rat}, h: q.Apart(Rat::zero()) := infer): CReal::ofRat(q).Apart(CReal::zero()) {
    match h {
        Inl(lt) => Inl(CReal::ofRat_lt(lt)),
        Inr(gt) => Inr(CReal::ofRat_lt(gt)),
    }
}

// The embedding commutes with the inverse, term by term: a constant
// sequence reads the same wherever the gap sends it.
theorem CReal::ofRat_inv(q: Rat, h: q.Apart(Rat::zero()) := infer): CReal::ofRat(q)⁻¹ ≈ CReal::ofRat(q⁻¹) {
    CReal::ofRat(q)⁻¹.same_of_terms(CReal::ofRat(q⁻¹), λ n => q⁻¹.same_refl())
}

// ---------------------------------------------------------------------------
// The non-strict order, Bishop's: x ≤ y when y < x is refuted. It carries no
// data and is defined from `<`, never the reverse. Its laws come from
// cotransitivity: a gap below x, placed against y, lands on one side of y or
// the other. Its antisymmetry modulo `≈` is tightness.

fn CReal::Le(x, y: CReal) → Type { ¬(y < x) }

designation <= at CReal := CReal::Le

theorem CReal::le_refl(self x: CReal): x <= x { x.lt_irrefl() }

theorem CReal::le_of_lt({x, y: CReal}, h: x < y): x <= y { λ back => x.lt_irrefl(CReal::lt_trans(h, back)) }

theorem CReal::le_of_same({x, y: CReal}, h: x ≈ y): x <= y {
    λ back => y.lt_irrefl(CReal::lt_respects(y.same_refl(), h, back))
}

// z < x places y: z < y or y < x, and each is refuted.
theorem CReal::le_trans({x, y, z: CReal}, hxy: x <= y, hyz: y <= z): x <= z {
    λ zx => match z.lt_cotrans(x, y, zx) {
        Inl(zy) => hyz(zy),
        Inr(yx) => hxy(yx),
    }
}

theorem CReal::lt_of_lt_of_le({x, y, z: CReal}, h1: x < y, h2: y <= z): x < z {
    match x.lt_cotrans(y, z, h1) {
        Inl(xz) => xz,
        Inr(zy) => absurd_of(zy, h2),
    }
}

theorem CReal::lt_of_le_of_lt({x, y, z: CReal}, h1: x <= y, h2: y < z): x < z {
    match y.lt_cotrans(z, x, h2) {
        Inl(yx) => absurd_of(yx, h1),
        Inr(xz) => xz,
    }
}

// Reals each below the other are not apart, so they are the same.
theorem CReal::le_antisymm({x, y: CReal}, hxy: x <= y, hyx: y <= x): x ≈ y {
    CReal::same_of_not_apart(λ apart => match apart {
        Inl(lt) => hyx(lt),
        Inr(gt) => hxy(gt),
    })
}

theorem CReal::le_respects({x, x2, y, y2: CReal}, hx: x ≈ x2, hy: y ≈ y2, h: x <= y): x2 <= y2 {
    λ back => h(CReal::lt_respects(CReal::same_sym(hy), CReal::same_sym(hx), back))
}

// The embedding preserves and reflects `≤`, through `<` both ways.
theorem CReal::ofRat_le({p, q: Rat}, h: p <= q): CReal::ofRat(p) <= CReal::ofRat(q) {
    λ back => Rat::not_le_of_lt(CReal::lt_of_ofRat_lt(back), h)
}

theorem CReal::le_of_ofRat_le({p, q: Rat}, h: CReal::ofRat(p) <= CReal::ofRat(q)): p <= q {
    Rat::le_of_not_lt(λ below => h(CReal::ofRat_lt(below)))
}

instance Preorder<CReal>(CReal::Le) {
    rel_refl := CReal::le_refl,
    rel_trans := λ x y z hxy hyz => CReal::le_trans(hxy, hyz),
}

// `<` absorbs `≤` on either side, and `≈` is absorbed by `≤`, so a `calc`
// chain may mix all three.
instance Trans<CReal>(CReal::Le, CReal::Lt, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_of_le_of_lt(hxy, hyz),
}

instance Trans<CReal>(CReal::Lt, CReal::Le, CReal::Lt) {
    rel_chain := λ x y z hxy hyz => CReal::lt_of_lt_of_le(hxy, hyz),
}

instance Trans<CReal>(CReal::Same, CReal::Le, CReal::Le) {
    rel_chain := λ x y z hxy hyz => CReal::le_trans(CReal::le_of_same(hxy), hyz),
}

instance Trans<CReal>(CReal::Le, CReal::Same, CReal::Le) {
    rel_chain := λ x y z hxy hyz => CReal::le_trans(hxy, CReal::le_of_same(hyz)),
}

// ---------------------------------------------------------------------------
// Order and addition. A sum reads both summands at index 2n+1, so adding z
// to both sides of x < y adds the same rational to both terms there, and x's
// gap below y is the sums' gap from the same start. Cancellation adds -z,
// `≤` follows by refutation, and cotransitivity splits a gap between sums
// into a gap between one pair of summands (Bishop's form of "a sum is
// positive only if a summand is").

theorem CReal::add_lt_mono_r(self x, y, z: CReal, h: x < y): x + z < y + z {
    match h {
        Exists(k, rest) => match rest {
            Exists(s, gap) => Exists(k, Exists(s, λ n from => {
                let i = n + n + 1;
                let at_i: (s <= i) = s.le_trans(n, i, from, n.le_add_l(n + 1));
                let a = x.seq(i);
                let c = z.seq(i);
                let step = Rat::inv_succ(k);
                calc {
                    (a + c) + step ≈ a + (c + step) := a.add_assoc(c, step),
                    ≈ a + (step + c) := Rat::add_respects(a.same_refl(), c.add_comm(step)),
                    ≈ (a + step) + c := Rat::same_sym(a.add_assoc(step, c)),
                    <= y.seq(i) + c := (a + step).add_le_mono_r(y.seq(i), c, gap(i, at_i)),
                }
            })),
        },
    }
}

theorem CReal::add_lt_mono_l(self x, y, z: CReal, h: x < y): z + x < z + y {
    calc {
        z + x ≈ x + z := z.add_comm(x),
        < y + z := x.add_lt_mono_r(y, z, h),
        ≈ z + y := y.add_comm(z),
    }
}

theorem CReal::add_lt_mono({x, x2, y, y2: CReal}, hx: x < x2, hy: y < y2): x + y < x2 + y2 {
    CReal::lt_trans(x.add_lt_mono_r(x2, y, hx), y.add_lt_mono_l(y2, x2, hy))
}

theorem CReal::add_neg_cancel_r(self x, y: CReal): (x + y) + -y ≈ x {
    calc {
        (x + y) + -y ≈ x + (y + -y) := x.add_assoc(y, -y),
        ≈ x + CReal::zero() := CReal::add_respects(x.same_refl(), y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

theorem CReal::add_lt_cancel_r(self x, y, z: CReal, h: x + z < y + z): x < y {
    calc {
        x ≈ (x + z) + -z := CReal::same_sym(x.add_neg_cancel_r(z)),
        < (y + z) + -z := (x + z).add_lt_mono_r(y + z, -z, h),
        ≈ y := y.add_neg_cancel_r(z),
    }
}

theorem CReal::add_lt_cancel_l(self x, y, z: CReal, h: z + x < z + y): x < y {
    x.add_lt_cancel_r(y, z, calc {
        x + z ≈ z + x := x.add_comm(z),
        < z + y := h,
        ≈ y + z := z.add_comm(y),
    })
}

theorem CReal::add_le_mono_r(self x, y, z: CReal, h: x <= y): x + z <= y + z {
    λ back => h(y.add_lt_cancel_r(x, z, back))
}

theorem CReal::add_le_mono_l(self x, y, z: CReal, h: x <= y): z + x <= z + y {
    λ back => h(y.add_lt_cancel_l(x, z, back))
}

theorem CReal::add_le_mono({x, x2, y, y2: CReal}, hx: x <= x2, hy: y <= y2): x + y <= x2 + y2 {
    CReal::le_trans(x.add_le_mono_r(x2, y, hx), y.add_le_mono_l(y2, x2, hy))
}

theorem CReal::add_lt_le_mono({x, x2, y, y2: CReal}, hx: x < x2, hy: y <= y2): x + y < x2 + y2 {
    CReal::lt_of_lt_of_le(x.add_lt_mono_r(x2, y, hx), y.add_le_mono_l(y2, x2, hy))
}

theorem CReal::add_le_lt_mono({x, x2, y, y2: CReal}, hx: x <= x2, hy: y < y2): x + y < x2 + y2 {
    CReal::lt_of_le_of_lt(x.add_le_mono_r(x2, y, hx), y.add_lt_mono_l(y2, x2, hy))
}

theorem CReal::add_lt_cancel({x, x2, y, y2: CReal}, h: x + y < x2 + y2): x < x2 ∨ y < y2 {
    match (x + y).lt_cotrans(x2 + y2, x2 + y, h) {
        Inl(left) => Inl(x.add_lt_cancel_r(x2, y, left)),
        Inr(right) => Inr(y.add_lt_cancel_l(y2, x2, right)),
    }
}

// Signs of a sum.
theorem CReal::zero_add_zero(): CReal::zero() + CReal::zero() ≈ CReal::zero() { CReal::zero().add_zero() }

theorem CReal::add_pos({x, y: CReal}, hx: CReal::zero() < x, hy: CReal::zero() < y): CReal::zero() < x + y {
    calc {
        CReal::zero() ≈ CReal::zero() + CReal::zero() := CReal::same_sym(CReal::zero_add_zero()),
        < x + y := CReal::add_lt_mono(hx, hy),
    }
}

theorem CReal::add_pos_of_nonneg_of_pos({x, y: CReal}, hx: CReal::zero() <= x, hy: CReal::zero() < y): CReal::zero() < x + y {
    calc {
        CReal::zero() ≈ CReal::zero() + CReal::zero() := CReal::same_sym(CReal::zero_add_zero()),
        < x + y := CReal::add_le_lt_mono(hx, hy),
    }
}

theorem CReal::add_nonneg({x, y: CReal}, hx: CReal::zero() <= x, hy: CReal::zero() <= y): CReal::zero() <= x + y {
    calc {
        CReal::zero() ≈ CReal::zero() + CReal::zero() := CReal::same_sym(CReal::zero_add_zero()),
        <= x + y := CReal::add_le_mono(hx, hy),
    }
}

theorem CReal::pos_of_add_pos({x, y: CReal}, h: CReal::zero() < x + y): CReal::zero() < x ∨ CReal::zero() < y {
    CReal::add_lt_cancel(calc {
        CReal::zero() + CReal::zero() ≈ CReal::zero() := CReal::zero_add_zero(),
        < x + y := h,
    })
}

// ---------------------------------------------------------------------------
// Bishop's order. Bishop reads x ≤ y pointwise, as x_n ≤ y_n + 2/(n+1) at
// every n, and it agrees with `≤` as the refutation of `>`. A gap of 1/(k+1)
// with y below x would contradict the pointwise bound once 2/(n+1) is under
// it. Conversely, x_n above y_n + 2/(n+1) by some 1/(j+1) leaves a gap
// further out, after regularity moves both terms, and `lt_of_term` turns it
// into y < x; so every such excess is refuted and vanishes.

fn CReal::BishopLe(x, y: CReal) → Type {
    (n: Nat) → x.seq(n) <= y.seq(n) + (Rat::inv_succ(n) + Rat::inv_succ(n))
}

theorem CReal::le_of_bishop({x, y: CReal}, h: x.BishopLe(y)): x <= y {
    λ back => match back {
        Exists(k, rest) => match rest {
            Exists(s, gap) => {
                let k2 = k + k + 1;
                let k4 = k2 + k2 + 1;
                let n = s.max(k4);
                let a = y.seq(n);
                let fine = Rat::inv_succ(n);
                let step = Rat::inv_succ(k);
                let le_q: (fine <= Rat::inv_succ(k4)) = Rat::inv_succ_antitone(k4, n, s.le_max_r(k4));
                let strict: (Rat::inv_succ(k2) < step) = omega;
                let small: (fine + fine < step) = calc {
                    fine + fine <= Rat::inv_succ(k4) + Rat::inv_succ(k4) := Rat::add_le_mono(le_q, le_q),
                    ≈ Rat::inv_succ(k2) := Rat::inv_succ_half(k2),
                    < step := strict,
                };
                let swapped = calc {
                    step + a ≈ a + step := step.add_comm(a),
                    <= x.seq(n) := gap(n, s.le_max_l(k4)),
                    <= a + (fine + fine) := h(n),
                    ≈ (fine + fine) + a := a.add_comm(fine + fine),
                };
                Rat::not_le_of_lt(small, step.add_le_cancel_r(fine + fine, a, swapped))
            },
        },
    }
}

theorem CReal::bishop_of_le({x, y: CReal}, h: x <= y): x.BishopLe(y) {
    λ n => {
        let fine = Rat::inv_succ(n);
        let two = fine + fine;
        Rat::le_of_le_add_inv_succ(λ j => Rat::le_of_not_lt(λ above => {
            let j2 = j + j + 1;
            let k = j2;
            let q = Rat::inv_succ(k + k + 1);
            let m = 16 * k + 15;
            let at_m: (k + k + 1 <= m) = omega;
            let em: (Rat::inv_succ(m) <= q) = Rat::inv_succ_antitone(k + k + 1, m, at_m);
            let e = fine + q;
            let ha: (y.seq(m) <= y.seq(n) + e) = Rat::le_add_of_dist(calc {
                (y.seq(m) -y.seq(n)).abs() ≈ (y.seq(n) -y.seq(m)).abs() := y.seq(m).abs_sub_comm(y.seq(n)),
                <= fine + Rat::inv_succ(m) := y.regular(n, m),
                <= e := Rat::inv_succ(m).add_le_mono_l(q, fine, em),
            });
            let hb: (x.seq(n) <= x.seq(m) + e) =
                Rat::le_add_of_dist(Rat::le_trans(x.regular(n, m), Rat::inv_succ(m).add_le_mono_l(q, fine, em)));
            let spare: (q <= q + q) = q.le_add_nonneg(q, Rat::le_of_lt(Rat::inv_succ_pos(k + k + 1)));
            let a = y.seq(n);
            let wide = calc {
                a + (q + (e + e)) ≈ a + (q + (two + (q + q))) := Rat::add_respects(a.same_refl(), Rat::add_respects(q.same_refl(), fine.add_add_add_comm(q, fine, q))),
                ≈ a + (two + (q + (q + q))) := Rat::add_respects(a.same_refl(), q.add_left_comm(two, q + q)),
                <= a + (two + ((q + q) + (q + q))) := (two + (q + (q + q))).add_le_mono_l(two + ((q + q) + (q + q)), a,
                    (q + (q + q)).add_le_mono_l((q + q) + (q + q), two, q.add_le_mono_r(q + q, q + q, spare))),
                ≈ a + (two + (Rat::inv_succ(j2) + Rat::inv_succ(j2))) := Rat::add_respects(a.same_refl(), Rat::add_respects(two.same_refl(), Rat::add_respects(Rat::inv_succ_half(k), Rat::inv_succ_half(k)))),
                ≈ a + (two + Rat::inv_succ(j)) := Rat::add_respects(a.same_refl(), Rat::add_respects(two.same_refl(), Rat::inv_succ_half(j))),
                ≈ (a + two) + Rat::inv_succ(j) := Rat::same_sym(a.add_assoc(two, Rat::inv_succ(j))),
                <= x.seq(n) := Rat::le_of_lt(above),
            };
            h(y.lt_of_term(x, k, m, m.le_refl(), Rat::le_of_close_gap(ha, hb, wide)))
        }))
    }
}

// ---------------------------------------------------------------------------
// Signs, and integer powers (docs/inverse-power-notation-design.md), as at
// `Rat`. The sign predicates are the one-place premises of the apartness
// rules, so that the search through them shrinks its goal; a local
// `h: CReal::zero() < x` is one by conversion.

fn CReal::Positive(self x: CReal) → Type { CReal::zero() < x }
fn CReal::Negative(self x: CReal) → Type { x < CReal::zero() }

evidence theorem CReal::apart_of_positive({x: CReal}, h: x.Positive() := infer): x.Apart(CReal::zero()) { Inr(h) }
evidence theorem CReal::apart_of_negative({x: CReal}, h: x.Negative() := infer): x.Apart(CReal::zero()) { Inl(h) }

fn CReal::npow(self x: CReal, n: Nat) → CReal {
    match n {
        Zero => CReal::one(),
        Succ(k) => x.npow(k) * x,
    }
}

theorem CReal::npow_respects({x, x2: CReal}, hx: x ≈ x2, n: Nat): x.npow(n) ≈ x2.npow(n) {
    match n {
        Zero => CReal::one().same_refl(),
        Succ(k) => CReal::mul_respects(CReal::npow_respects(hx, k), hx),
    }
}

theorem CReal::npow_add(self x: CReal, m, n: Nat): x.npow(m + n) ≈ x.npow(m) * x.npow(n) {
    match n {
        Zero => CReal::same_sym(x.npow(m).mul_one()),
        Succ(k) => calc {
            x.npow(m + Succ(k)) ≈ x.npow(m + k) * x := (x.npow(m + k) * x).same_refl(),
            ≈ (x.npow(m) * x.npow(k)) * x := CReal::mul_respects(x.npow_add(m, k), x.same_refl()),
            ≈ x.npow(m) * (x.npow(k) * x) := x.npow(m).mul_assoc(x.npow(k), x),
        },
    }
}

// The side condition of an integer power: nothing at n ≥ 0, apartness from
// zero at n < 0. It computes, and the search reads what it computes to.
fn CReal::PowOk(x: CReal, n: Int) → Type {
    match n {
        OfNat(_) => True,
        NegSucc(_) => x.Apart(CReal::zero()),
    }
}

fn CReal::pow_parts(x: CReal, n: Int) → (x.PowOk(n) → CReal) {
    match n {
        OfNat(m) => λ _ => x.npow(m),
        NegSucc(k) => λ h => x.inv(h := h).npow(Succ(k)),
    }
}

fn CReal::pow(self x: CReal, n: Int, h: x.PowOk(n) := infer) → CReal { CReal::pow_parts(x, n, h) }

designation ^ at CReal := CReal::pow

theorem CReal::pow_ofNat(self x: CReal, n: Nat): x ^ OfNat(n) = x.npow(n) { refl }

theorem CReal::pow_negSucc(self x: CReal, k: Nat, h: x.Apart(CReal::zero()) := infer): x ^ NegSucc(k) = x⁻¹.npow(Succ(k)) { refl }

theorem CReal::pow_zero(self x: CReal): x ^ 0 ≈ CReal::one() { CReal::one().same_refl() }

theorem CReal::pow_one(self x: CReal): x ^ 1 ≈ x { CReal::same_trans(CReal::one().mul_comm(x), x.mul_one()) }

theorem CReal::pow_two(self x: CReal): x ^ 2 ≈ x * x { CReal::mul_respects(x.pow_one(), x.same_refl()) }

// The inverse is the power at -1.
theorem CReal::pow_neg_one(self x: CReal, h: x.Apart(CReal::zero()) := infer): x ^ (-1) ≈ x⁻¹ { x⁻¹.pow_one() }

// ---------------------------------------------------------------------------
// Order and multiplication (docs/creal-mul-order-round.md). A product reads
// both factors at one index, at or past its own, so a positive product needs
// no estimate: past both gaps' starts each factor is at least its gap, and
// the product of the terms clears zero by the product of the gaps. A
// nonnegative product goes through Bishop's form: each factor falls short of
// zero by at most 2/(a+1) at the index a it is read at, and the shortfall of
// the product, scaled by the bound l+1, is the 1/(n+1) the product's index
// was chosen to absorb, too small for any gap below zero. The monotone forms
// are those two signs applied to the difference: y*z - x*z ≈ (y -x)*z.

theorem CReal::mul_pos({x, y: CReal}, hx: CReal::zero() < x, hy: CReal::zero() < y): CReal::zero() < x * y {
    match hx {
        Exists(k, rx) => match rx {
            Exists(s, gx) => match hy {
                Exists(l, ry) => match ry {
                    Exists(t, gy) => Exists(k * (l + 1) + l, Exists(s.max(t), λ n from => {
                        let a = x.mul_at(y, n);
                        let at_a: (s.max(t) <= a) = s.max(t).le_trans(n, a, from, x.mul_at_ge(y, n));
                        let at_s: (s <= a) = s.le_trans(s.max(t), a, s.le_max_l(t), at_a);
                        let at_t: (t <= a) = t.le_trans(s.max(t), a, s.le_max_r(t), at_a);
                        let fk = Rat::inv_succ(k);
                        let fl = Rat::inv_succ(l);
                        let lx: (fk <= x.seq(a)) = Rat::le_trans(Rat::le_of_same(Rat::same_sym(Rat::zero_add(fk))), gx(a, at_s));
                        let ly: (fl <= y.seq(a)) = Rat::le_trans(Rat::le_of_same(Rat::same_sym(Rat::zero_add(fl))), gy(a, at_t));
                        let step = Rat::inv_succ(k * (l + 1) + l);
                        calc {
                            Rat::zero() + step ≈ step := Rat::zero_add(step),
                            ≈ fk * fl := Rat::same_sym(Rat::inv_succ_mul(k, l)),
                            <= x.seq(a) * y.seq(a) := Rat::mul_le_mul(lx, ly, Rat::le_of_lt(Rat::inv_succ_pos(k)), Rat::le_of_lt(Rat::inv_succ_pos(l))),
                        }
                    })),
                },
            },
        },
    }
}

theorem CReal::mul_nonneg({x, y: CReal}, hx: CReal::zero() <= x, hy: CReal::zero() <= y): CReal::zero() <= x * y {
    let bx = CReal::bishop_of_le(hx);
    let by = CReal::bishop_of_le(hy);
    λ back => match back {
        Exists(j, rest) => match rest {
            Exists(s, gap) => {
                let n = s.max(j + 1);
                let past: (j + 1 <= n) = s.le_max_r(j + 1);
                let l = x.bound().max(y.bound());
                let a = x.mul_at(y, n);
                let big = Rat::ofInt(OfNat(l + 1));
                let f = Rat::inv_succ(a);
                let p = x.seq(a) * y.seq(a);
                let size_x: (x.seq(a).abs() <= big) = x.bound_below(a, l + 1, x.bound().le_succ_r(l, x.bound().le_max_l(y.bound())));
                let size_y: (y.seq(a).abs() <= big) = y.bound_below(a, l + 1, y.bound().le_succ_r(l, x.bound().le_max_r(y.bound())));
                let f_up: (Rat::zero() <= f) = Rat::le_of_lt(Rat::inv_succ_pos(a));
                let pos_f = calc {
                    Rat::zero() ≈ Rat::zero() + Rat::zero() := Rat::same_sym(Rat::zero().add_zero()),
                    <= f + f := Rat::add_le_mono(f_up, f_up),
                };
                let near = calc {
                    Rat::zero() <= p + big * (f + f) := Rat::mul_nonneg_approx(bx(a), by(a), pos_f, size_x, size_y),
                    ≈ p + (big * f + big * f) := Rat::add_respects(p.same_refl(), big.mul_add_distr(f, f)),
                    ≈ p + Rat::inv_succ(n) := Rat::add_respects(p.same_refl(), Rat::scale_inv_succ_half(l, n)),
                };
                let g = Rat::inv_succ(j);
                let below = calc {
                    g + p ≈ p + g := g.add_comm(p),
                    <= Rat::zero() := gap(n, s.le_max_l(j + 1)),
                    <= p + Rat::inv_succ(n) := near,
                    ≈ Rat::inv_succ(n) + p := p.add_comm(Rat::inv_succ(n)),
                };
                let strict: (Rat::inv_succ(n) < g) = omega;
                Rat::not_le_of_lt(strict, g.add_le_cancel_r(Rat::inv_succ(n), p, below))
            },
        },
    }
}

theorem CReal::zero_add(self x: CReal): CReal::zero() + x ≈ x {
    CReal::same_trans(CReal::zero().add_comm(x), x.add_zero())
}

theorem CReal::sub_add_cancel(self x, y: CReal): (x -y) + y ≈ x {
    calc {
        (x + -y) + y ≈ x + (-y + y) := x.add_assoc(-y, y),
        ≈ x + (y + -y) := CReal::add_respects(x.same_refl(), (-y).add_comm(y)),
        ≈ x + CReal::zero() := CReal::add_respects(x.same_refl(), y.add_neg()),
        ≈ x := x.add_zero(),
    }
}

theorem CReal::add_mul_distr(self x, y, z: CReal): (x + y) * z ≈ x * z + y * z {
    calc {
        (x + y) * z ≈ z * (x + y) := (x + y).mul_comm(z),
        ≈ z * x + z * y := z.mul_add_distr(x, y),
        ≈ x * z + y * z := CReal::add_respects(z.mul_comm(x), z.mul_comm(y)),
    }
}

theorem CReal::sub_nonneg({x, y: CReal}, h: x <= y): CReal::zero() <= y -x {
    calc {
        CReal::zero() ≈ x + -x := CReal::same_sym(x.add_neg()),
        <= y + -x := x.add_le_mono_r(y, -x, h),
    }
}

theorem CReal::sub_pos({x, y: CReal}, h: x < y): CReal::zero() < y -x {
    calc {
        CReal::zero() ≈ x + -x := CReal::same_sym(x.add_neg()),
        < y + -x := x.add_lt_mono_r(y, -x, h),
    }
}

theorem CReal::mul_le_mono_r({x, y, z: CReal}, h: x <= y, hz: CReal::zero() <= z): x * z <= y * z {
    let d = y -x;
    calc {
        x * z ≈ CReal::zero() + x * z := CReal::same_sym((x * z).zero_add()),
        <= d * z + x * z := CReal::zero().add_le_mono_r(d * z, x * z, CReal::mul_nonneg(CReal::sub_nonneg(h), hz)),
        ≈ (d + x) * z := CReal::same_sym(d.add_mul_distr(x, z)),
        ≈ y * z := CReal::mul_respects(y.sub_add_cancel(x), z.same_refl()),
    }
}

theorem CReal::mul_lt_mono_r({x, y, z: CReal}, h: x < y, hz: CReal::zero() < z): x * z < y * z {
    let d = y -x;
    calc {
        x * z ≈ CReal::zero() + x * z := CReal::same_sym((x * z).zero_add()),
        < d * z + x * z := CReal::zero().add_lt_mono_r(d * z, x * z, CReal::mul_pos(CReal::sub_pos(h), hz)),
        ≈ (d + x) * z := CReal::same_sym(d.add_mul_distr(x, z)),
        ≈ y * z := CReal::mul_respects(y.sub_add_cancel(x), z.same_refl()),
    }
}

theorem CReal::mul_le_mono_l({x, y, z: CReal}, h: x <= y, hz: CReal::zero() <= z): z * x <= z * y {
    calc {
        z * x ≈ x * z := z.mul_comm(x),
        <= y * z := CReal::mul_le_mono_r(h, hz),
        ≈ z * y := y.mul_comm(z),
    }
}

theorem CReal::mul_lt_mono_l({x, y, z: CReal}, h: x < y, hz: CReal::zero() < z): z * x < z * y {
    calc {
        z * x ≈ x * z := z.mul_comm(x),
        < y * z := CReal::mul_lt_mono_r(h, hz),
        ≈ z * y := y.mul_comm(z),
    }
}

// ---------------------------------------------------------------------------
// The Archimedean property and the ordered-field interface
// (std/ordered_field). A real is below the natural number one past its
// canonical bound: every term is at most the bound, so a gap of one holds
// from index zero.

theorem CReal::archimedean(self x: CReal): ∃ n: Nat, x < CReal::ofRat(Rat::ofInt(OfNat(n))) {
    let b = x.bound();
    Exists(b + 1, Exists(0, Exists(0, λ n from => calc {
        x.seq(n) + Rat::inv_succ(0) <= x.seq(n).abs() + Rat::inv_succ(0) := x.seq(n).add_le_mono_r(x.seq(n).abs(), Rat::inv_succ(0), x.seq(n).le_abs()),
        <= Rat::ofInt(OfNat(b)) + Rat::inv_succ(0) := x.seq(n).abs().add_le_mono_r(Rat::ofInt(OfNat(b)), Rat::inv_succ(0), x.bound_le(n)),
        ≈ Rat::ofInt(OfNat(b + 1)) := omega,
    })))
}

theorem CReal::zero_lt_one(): CReal::zero() < CReal::one() { CReal::ofRat_lt(Rat::zero_lt_one()) }

theorem CReal::ofNat_succ(n: Nat): CReal::ofRat(Rat::ofInt(OfNat(Succ(n)))) ≈ CReal::ofRat(Rat::ofInt(OfNat(n))) + CReal::one() {
    CReal::same_trans(CReal::ofRat_respects(omega), CReal::ofRat_add(Rat::ofInt(OfNat(n)), Rat::one()))
}

// `≤` is `¬(y < x)` by definition here, so both of its laws are the identity.
instance StrictOrder<CReal>(CReal::Same, CReal::Lt, CReal::Le) {
    lt_irrefl := CReal::lt_irrefl,
    lt_trans := λ x y z h1 h2 => CReal::lt_trans(h1, h2),
    lt_respects := λ x x2 y y2 hx hy h => CReal::lt_respects(hx, hy, h),
    lt_tight := λ x y h1 h2 => CReal::same_of_not_apart(λ a => match a { Inl(l) => h1(l), Inr(r) => h2(r) }),
    le_of_not_lt := λ x y h => h,
    not_lt_of_le := λ x y h => h,
}

instance Cotransitive<CReal>(CReal::Lt) {
    rel_cotrans := CReal::lt_cotrans,
}

instance PseudoOrder<CReal>(CReal::Same, CReal::Lt, CReal::Le) {}

instance OrderedAddGroup<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add) {
    zero := CReal::zero(),
    neg := CReal::neg,
    add_zero := CReal::add_zero,
    add_neg := CReal::add_neg,
    neg_respects := λ x x2 h => CReal::neg_respects(h),
    add_lt_mono_r := CReal::add_lt_mono_r,
}

instance LocatedAddGroup<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add) {}

instance OrderedField<CReal>(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul) {
    one := CReal::one(),
    of_nat := λ n => CReal::ofRat(Rat::ofInt(OfNat(n))),
    inv := λ x h => x.inv(h := h),
    mul_respects := λ x x2 y y2 hx hy => CReal::mul_respects(hx, hy),
    mul_assoc := CReal::mul_assoc,
    mul_comm := CReal::mul_comm,
    mul_one := CReal::mul_one,
    mul_add_distr := CReal::mul_add_distr,
    mul_inv := λ x h => x.mul_inv(h := h),
    zero_lt_one := CReal::zero_lt_one(),
    mul_pos := λ x y hx hy => CReal::mul_pos(hx, hy),
    of_nat_zero := CReal::zero().same_refl(),
    of_nat_succ := CReal::ofNat_succ,
    archimedean := CReal::archimedean,
}

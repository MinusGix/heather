// SHA-2 as a specification (FIPS 180-4), one definition for the family
// (issues/sha2-specification.md).
//
// SHA-256 and SHA-512 are the same function at two word widths: the
// compression function, the message schedule and the padding differ only in
// the width, the rotation counts, the round constants and the initial hash
// value (§4.1.2 against §4.1.3, §4.2.2 against §4.2.3, §5.3). `Sha2` holds
// those, and everything below is over `BitVec(p.width)`. SHA-224, SHA-384,
// SHA-512/224 and SHA-512/256 are the same two functions from another
// initial value, with the output cut short (§6.3 to §6.7), which is what
// `output` is for.
//
// This file is the meaning: it is written to be read against the standard,
// a section at a time, and nothing here is shaped for a machine. Compiled
// code is proved against it (`lib/native/crypto/sha512_round.hthr` and
// `sha256_round.hthr`), and its own test is the standard's vectors
// (`lib/_tests/std/crypto/sha2_tests.hthr`).

import bitvec;
import bitvec_rotate;
import bool;
import list;
import logic;
import nat;
import option;

// §4.1.2, §4.1.3: Ch and Maj, the same at every width.
fn BitVec::ch({n: Nat}, self x, y, z: BitVec(n)) → BitVec(n) {
    x.band(y).bxor(x.complement().band(z))
}

fn BitVec::maj({n: Nat}, self x, y, z: BitVec(n)) → BitVec(n) {
    x.band(y).bxor(x.band(z)).bxor(y.band(z))
}

// Three counts: a Σ rotates by each, a σ rotates by two and shifts by the
// third.
record Sha2Counts { first: Nat, second: Nat, third: Nat }

fn Sha2Counts::big({n: Nat}, self r: Sha2Counts, x: BitVec(n)) → BitVec(n) {
    x.rotr(r.first).bxor(x.rotr(r.second)).bxor(x.rotr(r.third))
}

fn Sha2Counts::small({n: Nat}, self r: Sha2Counts, x: BitVec(n)) → BitVec(n) {
    x.rotr(r.first).bxor(x.rotr(r.second)).bxor(x.shift_right(r.third))
}

// One member of the family. `k` is the round constants (their count is the
// number of rounds), `initial` the eight words of H(0), `output` how many
// words of the final hash value the digest keeps.
record Sha2 {
    width: Nat,
    big0: Sha2Counts,
    big1: Sha2Counts,
    small0: Sha2Counts,
    small1: Sha2Counts,
    k: List<Nat>,
    initial: List<Nat>,
    output: Nat,
}

fn Sha2::rounds(self p: Sha2) → Nat { p.k.len() }
// A word in bytes, a block in bytes (sixteen words), and the length field
// that ends the padding (two words).
fn Sha2::word_bytes(self p: Sha2) → Nat { p.width / 8 }
fn Sha2::block_bytes(self p: Sha2) → Nat { 16 * p.word_bytes() }
fn Sha2::length_bytes(self p: Sha2) → Nat { 2 * p.word_bytes() }

// The working variables a to h (§6.2.2 step 2), and the hash value H(i)
// they are added into.
record Sha2State(n: Nat) {
    a: BitVec(n), b: BitVec(n), c: BitVec(n), d: BitVec(n),
    e: BitVec(n), f: BitVec(n), g: BitVec(n), h: BitVec(n),
}

fn Sha2State::plus({n: Nat}, self s, t: Sha2State(n)) → Sha2State(n) {
    Sha2State(s.a.add(t.a), s.b.add(t.b), s.c.add(t.c), s.d.add(t.d),
        s.e.add(t.e), s.f.add(t.f), s.g.add(t.g), s.h.add(t.h))
}

fn Sha2State::words({n: Nat}, self s: Sha2State(n)) → List<BitVec(n)> {
    [s.a, s.b, s.c, s.d, s.e, s.f, s.g, s.h]
}

fn Sha2::word(self p: Sha2, words: List<Nat>, i: Nat) → BitVec(p.width) {
    BitVec::ofNat(words.nth(i).unwrap_or(0))
}

fn Sha2::start(self p: Sha2) → Sha2State(p.width) {
    Sha2State(p.word(p.initial, 0), p.word(p.initial, 1), p.word(p.initial, 2), p.word(p.initial, 3),
        p.word(p.initial, 4), p.word(p.initial, 5), p.word(p.initial, 6), p.word(p.initial, 7))
}

// §6.2.2 step 3: one round, from the working variables, the round's
// constant and its schedule word.
fn Sha2::t1(self p: Sha2, s: Sha2State(p.width), k, w: BitVec(p.width)) → BitVec(p.width) {
    s.h.add(p.big1.big(s.e)).add(s.e.ch(s.f, s.g)).add(k).add(w)
}

fn Sha2::t2(self p: Sha2, s: Sha2State(p.width)) → BitVec(p.width) {
    p.big0.big(s.a).add(s.a.maj(s.b, s.c))
}

fn Sha2State::turn({n: Nat}, self s: Sha2State(n), t1, t2: BitVec(n)) → Sha2State(n) {
    Sha2State(t1.add(t2), s.a, s.b, s.c, s.d.add(t1), s.e, s.f, s.g)
}

fn Sha2::round(self p: Sha2, s: Sha2State(p.width), k, w: BitVec(p.width)) → Sha2State(p.width) {
    s.turn(p.t1(s, k, w), p.t2(s))
}

// §6.2.2 step 1: the message schedule. A window holds the words so far,
// newest first, so the four a new word reads are at fixed places:
// W(t) = σ1(W(t−2)) + W(t−7) + σ0(W(t−15)) + W(t−16).
fn Sha2::window_word(self p: Sha2, window: List<BitVec(p.width)>, back: Nat) → BitVec(p.width) {
    window.nth(back).unwrap_or(BitVec::zero())
}

fn Sha2::next_word(self p: Sha2, window: List<BitVec(p.width)>) → BitVec(p.width) {
    p.small1.small(p.window_word(window, 1)).add(p.window_word(window, 6))
        .add(p.small0.small(p.window_word(window, 14))).add(p.window_word(window, 15))
}

fn Sha2::push(self p: Sha2, window: List<BitVec(p.width)>) → List<BitVec(p.width)> {
    Cons(p.next_word(window), window)
}

// `count` more words onto a window.
fn Sha2::extend(self p: Sha2, count: Nat, window: List<BitVec(p.width)>) → List<BitVec(p.width)> {
    match count { Zero => window, Succ(k) => p.push(p.extend(k, window)) }
}

// The whole schedule of a block, W(0) first.
fn Sha2::schedule(self p: Sha2, block: List<BitVec(p.width)>) → List<BitVec(p.width)> {
    p.extend(p.rounds() - 16, block.rev()).rev()
}

// Rounds `from` up to `from + count` over a schedule.
fn Sha2::run(self p: Sha2, schedule: List<BitVec(p.width)>, from, count: Nat,
    s: Sha2State(p.width)) → Sha2State(p.width)
{
    match count {
        Zero => s,
        Succ(n) => p.round(p.run(schedule, from, n, s), p.word(p.k, from + n),
            p.window_word(schedule, from + n)),
    }
}

// §6.2.2: the compression function, H(i) from H(i−1) and a block.
fn Sha2::compress(self p: Sha2, hash: Sha2State(p.width), block: List<BitVec(p.width)>) → Sha2State(p.width) {
    hash.plus(p.run(p.schedule(block), 0, p.rounds(), hash))
}

// ---------------------------------------------------------------------------
// §5: bytes to blocks

// `count` bytes, most significant first.
fn Sha2::be_bytes(value, count: Nat) → List<BitVec(8)> {
    match count {
        Zero => [],
        Succ(k) => Sha2::be_bytes(value / 256, k).append([BitVec::ofNat(value % 256)]),
    }
}

// The number those bytes spell, most significant first.
fn Sha2::be_value(bytes: List<BitVec(8)>) → Nat {
    bytes.foldl(λ (acc: Nat) (b: BitVec(8)) => acc * 256 + b.toNat(), 0)
}

// `count` pieces of `size` each off the front of a list.
fn Sha2::pieces<A>(size, count: Nat, xs: List<A>) → List<List<A>> {
    match count {
        Zero => [],
        Succ(k) => Cons(xs.take(size), Sha2::pieces(size, k, xs.drop(size))),
    }
}

// §5.1: a `1` bit, zeros, and the message's length in bits, ending on a
// block boundary. Over bytes the `1` bit is the byte 0x80.
fn Sha2::zeros(self p: Sha2, length: Nat) → Nat {
    let block = p.block_bytes();
    (block - (length + 1 + p.length_bytes()) % block) % block
}

fn Sha2::pad(self p: Sha2, message: List<BitVec(8)>) → List<BitVec(8)> {
    message.append(Cons(BitVec::ofNat(0x80),
        List::replicate(BitVec::zero(), p.zeros(message.len()))
            .append(Sha2::be_bytes(8 * message.len(), p.length_bytes()))))
}

// §5.2: the padded message as blocks of sixteen big-endian words.
fn Sha2::words(self p: Sha2, bytes: List<BitVec(8)>) → List<BitVec(p.width)> {
    Sha2::pieces(p.word_bytes(), bytes.len() / p.word_bytes(), bytes)
        .map(λ (piece: List<BitVec(8)>) => BitVec::ofNat(Sha2::be_value(piece)))
}

fn Sha2::blocks(self p: Sha2, message: List<BitVec(8)>) → List<List<BitVec(p.width)>> {
    let padded = p.pad(message);
    Sha2::pieces(16, padded.len() / p.block_bytes(), p.words(padded))
}

// §6.2.2, §6.4.2: the hash value after every block, and the digest it
// spells: `output` words, each most significant byte first.
fn Sha2::hash(self p: Sha2, message: List<BitVec(8)>) → Sha2State(p.width) {
    p.blocks(message).foldl(λ (hash: Sha2State(p.width)) (block: List<BitVec(p.width)>) =>
        p.compress(hash, block), p.start())
}

// A word's `count` low bytes, most significant first, read off its bits: a
// word's `toNat` is a number in unary, which no digest should wait for.
fn Sha2::spell_word({n: Nat}, count: Nat, word: BitVec(n)) → List<BitVec(8)> {
    match count {
        Zero => [],
        Succ(k) => Sha2::spell_word(k, word.shift_right(8)).append([BitVec::widen_bits(8, n, word, False)]),
    }
}

fn Sha2::spell(self p: Sha2, hash: Sha2State(p.width)) → List<BitVec(8)> {
    hash.words().take(p.output).foldr(λ (word: BitVec(p.width)) (rest: List<BitVec(8)>) =>
        Sha2::spell_word(p.word_bytes(), word).append(rest), Nil)
}

fn Sha2::digest(self p: Sha2, message: List<BitVec(8)>) → List<BitVec(8)> {
    p.spell(p.hash(message))
}

// ---------------------------------------------------------------------------
// The family (§4.2.2, §4.2.3, §5.3)

fn Sha2::k256() → List<Nat> {
    [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
     0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,

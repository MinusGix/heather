}

fn Sha2::family256(initial: List<Nat>, output: Nat) → Sha2 {
    Sha2(width := 32,
        big0 := Sha2Counts(2, 13, 22), big1 := Sha2Counts(6, 11, 25),
        small0 := Sha2Counts(7, 18, 3), small1 := Sha2Counts(17, 19, 10),
        k := Sha2::k256(), initial := initial, output := output)
}

fn Sha2::family512(initial: List<Nat>, output: Nat) → Sha2 {
    Sha2(width := 64,
        big0 := Sha2Counts(28, 34, 39), big1 := Sha2Counts(14, 18, 41),
        small0 := Sha2Counts(1, 8, 7), small1 := Sha2Counts(19, 61, 6),
        k := Sha2::k512(), initial := initial, output := output)
}

fn Sha2::sha256() → Sha2 {
    Sha2::family256([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19], 8)
}

fn Sha2::sha224() → Sha2 {
    Sha2::family256([0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939,
        0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4], 7)
}

fn Sha2::sha512() → Sha2 {
    Sha2::family512([0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
        0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179], 8)
}

fn Sha2::sha384() → Sha2 {
    Sha2::family512([0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
        0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4], 6)
}

// ---------------------------------------------------------------------------
// What a proof by stages reads: each definition's one step, and the
// schedule and the rounds a piece at a time. A whole block evaluated in one
// declaration is past the kernel's fuel, so a vector is proved by pieces and
// these put the pieces together.

theorem Sha2::extend_add(self p: Sha2, first: Nat, window: List<BitVec(p.width)>):
    (second: Nat) → p.extend(first + second, window) = p.extend(second, p.extend(first, window))
{
    λ second => match second {
        Zero => refl,
        Succ(_, ih) => cong_fn(λ (w: List<BitVec(p.width)>) => p.push(w), ih),
    }
}

theorem Sha2::run_add(self p: Sha2, schedule: List<BitVec(p.width)>, from, first: Nat,
    s: Sha2State(p.width)):
    (second: Nat) → p.run(schedule, from, first + second, s) =
        p.run(schedule, from + first, second, p.run(schedule, from, first, s))
{
    λ second => match second {
        Zero => refl,
        Succ(k, ih) => {
            let at: (from + (first + k) = (from + first) + k) = sym(Nat::add_assoc(from, first, k));
            j(at, λ i _ => p.round(p.run(schedule, from, first + k, s), p.word(p.k, from + (first + k)),
                    p.window_word(schedule, from + (first + k))) =
                p.round(p.run(schedule, from + first, k, p.run(schedule, from, first, s)), p.word(p.k, i),
                    p.window_word(schedule, i)),
                cong_fn(λ (t: Sha2State(p.width)) => p.round(t, p.word(p.k, from + (first + k)),
                    p.window_word(schedule, from + (first + k))), ih))
        },
    }
}

// One step taken first: a word pushed before the rest are, a round run
// before the rest are. What a loop that goes forward reads; the
// definitions go back.
theorem Sha2::extend_shift(self p: Sha2, m: Nat): (window: List<BitVec(p.width)>) → p.extend(m + 1, window) = p.extend(m, p.push(window)) {
    match m {
        Zero => λ window => refl,
        Succ(_, ih) => λ window => cong_fn(λ (w: List<BitVec(p.width)>) => p.push(w), ih(window)),
    }
}

theorem Sha2::run_shift(self p: Sha2, schedule: List<BitVec(p.width)>, m: Nat):
    (s: Sha2State(p.width)) → (from: Nat) →
    p.run(schedule, from, m + 1, s) =
        p.run(schedule, from + 1, m, p.round(s, p.word(p.k, from), p.window_word(schedule, from)))
{
    match m {
        Zero => λ s from => refl,
        Succ(k, ih) => λ s from => {
            let first = p.round(s, p.word(p.k, from), p.window_word(schedule, from));
            j(sym(from.add_succ_left(k)), λ n _ => p.round(p.run(schedule, from, k + 1, s), p.word(p.k, from + (k + 1)),
                    p.window_word(schedule, from + (k + 1))) =
                p.round(p.run(schedule, from + 1, k, first), p.word(p.k, n), p.window_word(schedule, n)),
                cong_fn(λ (t: Sha2State(p.width)) => p.round(t, p.word(p.k, from + (k + 1)),
                    p.window_word(schedule, from + (k + 1))), ih(s, from)))
        },
    }
}

// Two stretches of the schedule, or of the rounds, end to end.
theorem Sha2::extend_then(self p: Sha2, first, second: Nat,
    start, middle, end: List<BitVec(p.width)>,
    one: p.extend(first, start) = middle, two: p.extend(second, middle) = end):
    p.extend(first + second, start) = end
{
    trans(p.extend_add(first, start, second),
        trans(cong_fn(λ (w: List<BitVec(p.width)>) => p.extend(second, w), one), two))
}

theorem Sha2::run_then(self p: Sha2, schedule: List<BitVec(p.width)>, from, first, second: Nat,
    s, middle, end: Sha2State(p.width),
    one: p.run(schedule, from, first, s) = middle,
    two: p.run(schedule, from + first, second, middle) = end):
    p.run(schedule, from, first + second, s) = end
{
    trans(p.run_add(schedule, from, first, s, second),
        trans(cong_fn(λ (t: Sha2State(p.width)) => p.run(schedule, from + first, second, t), one), two))
}

// The schedule from its window, the compression function from the schedule
// and the rounds, and a one-block message's hash from its block.
theorem Sha2::schedule_of(self p: Sha2, block, window: List<BitVec(p.width)>, count: Nat,
    more: p.rounds() - 16 = count, extended: p.extend(count, block.rev()) = window):
    p.schedule(block) = window.rev()
{
    trans(j(more, λ c _ => p.schedule(block) = p.extend(c, block.rev()).rev(), refl),
        cong_fn(λ (w: List<BitVec(p.width)>) => w.rev(), extended))
}

theorem Sha2::compress_of(self p: Sha2, hash, end: Sha2State(p.width),
    block, schedule: List<BitVec(p.width)>, count: Nat,
    scheduled: p.schedule(block) = schedule, rounds: p.rounds() = count,
    ran: p.run(schedule, 0, count, hash) = end):
    p.compress(hash, block) = hash.plus(end)
{
    let counted: (p.compress(hash, block) = hash.plus(p.run(p.schedule(block), 0, count, hash))) =
        j(rounds, λ c _ => p.compress(hash, block) = hash.plus(p.run(p.schedule(block), 0, c, hash)), refl);
    let read: (p.compress(hash, block) = hash.plus(p.run(schedule, 0, count, hash))) =
        j(scheduled, λ w _ => p.compress(hash, block) = hash.plus(p.run(w, 0, count, hash)), counted);
    trans(read, cong_fn(λ (t: Sha2State(p.width)) => hash.plus(t), ran))
}

theorem Sha2::hash_of_block(self p: Sha2, message: List<BitVec(8)>, block: List<BitVec(p.width)>,
    end: Sha2State(p.width),
    one: p.blocks(message) = [block], compressed: p.compress(p.start(), block) = end):
    p.hash(message) = end
{
    let folded: (p.hash(message) = p.compress(p.start(), block)) =
        cong_fn(λ (blocks: List<List<BitVec(p.width)>>) =>
            blocks.foldl(λ (hash: Sha2State(p.width)) (b: List<BitVec(p.width)>) => p.compress(hash, b), p.start()), one);
    trans(folded, compressed)
}

theorem Sha2::digest_of(self p: Sha2, message: List<BitVec(8)>, hash: Sha2State(p.width),
    hashed: p.hash(message) = hash): p.digest(message) = p.spell(hash)
{
    cong_fn(λ (h: Sha2State(p.width)) => p.spell(h), hashed)
}

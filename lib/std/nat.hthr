// Arithmetic and propositional order on the kernel `Nat` type. The relations
// reduce at closed arguments; `leb` remains available when a Boolean result is
// wanted, but is not the definition of `<=`.

import bool;
import logic;

// ---------------------------------------------------------------------------
// Addition and its two moving lemmas. `add` recurses on its SECOND argument,
// so the lemmas that matter are the ones that move a `Succ` — and a zero —
// across from the *left*.

fn Nat::add(self a: Nat, b: Nat) → Nat { match b { Zero => a, Succ(k) => Succ(a.add(k)) } }

// The public spelling belongs beside the operation, so the law kit below is
// written in the same surface a downstream proof uses.
designation + at Nat := Nat::add

theorem Nat::cong(f: Nat → Nat, {a, b: Nat}, p: a = b): f(a) = f(b) {
    rewrite(p, refl)
}

theorem Nat::add_left_zero(self x: Nat): 0 + x = x {
    match x { Zero => refl, Succ(k) => Nat::cong_succ(k.add_left_zero()) }
}

theorem Nat::add_succ_left(self a, b: Nat): Succ(a) + b = Succ(a + b) {
    match b { Zero => refl, Succ(k) => Nat::cong_succ(a.add_succ_left(k)) }
}

fn Nat::of_bit(b: Bool) → Nat { match b { False => 0, True => 1 } }

// The two laws that make `add` a commutative monoid — asked for by the traits
// adoption round (2026-08-07), which registers `AddCommMonoid<Nat>` in
// `std/algebra` and needs exactly these as its fields. Both recurse on the
// argument `add` itself recurses on, so both are three lines.

theorem Nat::add_assoc(self x, y, z: Nat): (x + y) + z = x + (y + z) {
    match z { Zero => refl, Succ(k) => Nat::cong_succ(x.add_assoc(y, k)) }
}

theorem Nat::add_comm(self x, y: Nat): x + y = y + x {
    match y {
        Zero => sym(x.add_left_zero()),
        Succ(k) =>
            apply trans;
            give Nat::cong_succ(x.add_comm(k));
            sym(k.add_succ_left(x)),
    }
}

// Structural doubling. `2 * n` is extensionally the same operation, but
// multiplication recurses on its second argument and is a poor normal form
// for proofs that consume one binary digit at a time. `twice` exposes two
// successors per input successor, so order cancellation remains structural.
fn Nat::twice(self n: Nat) → Nat {
    match n { Zero => 0, Succ(k) => Succ(Succ(k.twice())) }
}

theorem Nat::twice_add_self(self n: Nat): n.twice() = n + n {
    match n {
        Zero => refl,
        Succ(k) => calc {
            Succ(k).twice()
                = Succ(Succ(k.twice())) := refl,
                = Succ(Succ(k + k)) := Nat::cong_succ(Nat::cong_succ(k.twice_add_self())),
                = Succ(Succ(k) + k) := Nat::cong_succ(sym(k.add_succ_left(k))),
                = Succ(k) + Succ(k) := refl,
        },
    }
}

theorem Nat::twice_add(self a, b: Nat): (a + b).twice() = a.twice() + b.twice() {
    match b {
        Zero => refl,
        Succ(k) => Nat::cong_succ(Nat::cong_succ(a.twice_add(k))),
    }
}

// Swap the first two terms without rebuilding associativity and commutativity
// at every use. This is the right-associated form consumed by certifying AC
// reconstruction.
theorem Nat::add_left_comm(self a, b, c: Nat): a + (b + c) = b + (a + c) {
    calc {
        a + (b + c)
            = (a + b) + c := sym(a.add_assoc(b, c)),
            = (b + a) + c :=
                Nat::cong(λ (q: Nat) => q + c, a.add_comm(b)),
            = b + (a + c) := b.add_assoc(a, c),
    }
}

// Reorder the middle two elements of a four-term sum. Keeping this ordinary
// commutative-monoid consequence named avoids rebuilding a five-step calc in
// every binary-arithmetic proof.
theorem Nat::add_swap_middle(self a, b, c, d: Nat):
    (a + b) + (c + d) = (a + c) + (b + d)
{
    calc {
        (a + b) + (c + d)
            = a + (b + (c + d)) := a.add_assoc(b, c + d),
            = a + ((b + c) + d) :=
                Nat::cong(λ (q: Nat) => a + q, sym(b.add_assoc(c, d))),
            = a + ((c + b) + d) :=
                Nat::cong(λ (q: Nat) => a + (q + d), b.add_comm(c)),
            = a + (c + (b + d)) :=
                Nat::cong(λ (q: Nat) => a + q, c.add_assoc(b, d)),
            = (a + c) + (b + d) := sym(a.add_assoc(c, b + d)),
    }
}

// ---------------------------------------------------------------------------
// Multiplication and its kit. `mul` recurses on its SECOND argument, like
// `add`, and the step puts the recursive result on the LEFT of the `add` —
// `add(mul(a, k), a)`, not `add(a, mul(a, k))`. That is the whole economy of
// this section, and it is the same choice `add` made one paragraph up: put the
// step's `add` on the argument `add` itself descends on, so that the zero
// side stays *definitional*. `mul(a, 0)` reduces to `Zero` and `add(x, 0)` to
// `x` with no lemma, so `mul(0, x) = 0` and the zero arm of distributivity are
// a self-call and a `refl` respectively. Spelled the other way round every
// proof below pays an `add_left_zero` rewrite it does not otherwise need.
//
// (`crates/elab/tests/certgen*.rs` has a `viaadd` fixture that IS spelled the
// other way. That is deliberate and unrelated: it is a *generator* fixture,
// pinned byte-for-byte, and it wants the cross-function call shape rather than
// the cheap lemma kit. Two different programs, so two different names.)

fn Nat::mul(self a, b: Nat) → Nat { match b { Zero => Zero, Succ(k) => a.mul(k) + a } }

designation * at Nat := Nat::mul

// The right zero — `mul(x, 0) = 0` — needs no lemma. The left one does, and it
// is three lines because the step's `add(_, 0)` reduces away.
theorem Nat::mul_left_zero(self x: Nat): 0 * x = 0 {
    match x { Zero => refl, Succ(k) => k.mul_left_zero() }
}

// The unit on the left, for the same reason: `add(mul(1, k), 1)` reduces to
// `Succ(mul(1, k))` on its own, so this is `add_left_zero`'s shape exactly.
theorem Nat::mul_left_one(self x: Nat): 1 * x = x {
    match x { Zero => refl, Succ(k) => Nat::cong_succ(k.mul_left_one()) }
}

// `add_succ_left`'s counterpart: the lemma that moves a `Succ` across from the
// left. It is the one proof here that is not three lines, and every step of it
// is an `add` law — which is the point of proving `add`'s kit first.
theorem Nat::mul_succ_left(self a, b: Nat): Succ(a) * b = b + a * b {
    match b {
        Zero => refl,
        Succ(k) => calc {
            Succ(a) * Succ(k)
                = Succ(Succ(a) * k + a)   := refl,
                = Succ((k + a * k) + a)   := cong(a.mul_succ_left(k)),
                = Succ(k + (a * k + a))   := cong(k.add_assoc(a * k, a)),
                = Succ(k) + a * Succ(k)   := sym(k.add_succ_left(a * k + a)),
        },
    }
}

// Distributivity over the argument both functions recurse on. It comes before
// `mul_assoc` because `mul_assoc` *is* an instance of it, not the other way
// round — the associativity step rebuilds `mul(x, mul(y, Succ(k)))` as a sum
// and needs this to take it apart.
theorem Nat::mul_add_distr(self a, b, c: Nat): a * (b + c) = a * b + a * c {
    match c {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w + a, a.mul_add_distr(b, k));
            (a * b).add_assoc(a * k, a),
    }
}

// The two laws `std/algebra` registers `CommMonoid<Nat>(mul)` from, in the
// shape its fields want.

theorem Nat::mul_assoc(self x, y, z: Nat): (x * y) * z = x * (y * z) {
    match z {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w + (x * y), x.mul_assoc(y, k));
            sym(x.mul_add_distr(y * k, y)),
    }
}

theorem Nat::mul_comm(self x, y: Nat): x * y = y * x {
    match y {
        Zero => sym(x.mul_left_zero()),
        Succ(k) => calc {
            x * Succ(k)
                = x * k + x := refl,
                = k * x + x := cong(x.mul_comm(k)),
                = x + k * x := (k * x).add_comm(x),
                = Succ(k) * x := sym(k.mul_succ_left(x)),
        },
    }
}

// ---------------------------------------------------------------------------
// The order, stated PROPOSITIONALLY (docs/nat-order-design.md §1). `<=` is
// surface notation for a call to `Le` and `<` for a call to `Lt`
// (issues/comparison-operators.md).
//
// The relation is a recursion into `Type`: `Le(3, 10)` reduces to `True`, so
// closed comparisons compute without routing the specification through Bool.
//
// Uncurried since 2026-09-05: the recursion is on `n` and the inner `match`
// varies `m`, which the elaborator now generalizes into the motive
// (docs/ih-generalization-design.md). `leb` and `sub` were curried for the
// same reason and are uncurried the same way. A partial application `Le(n)`
// still writes where a relation value is wanted.
//
// Falsity is `logic::False`, which coexists with `bool::False` the constructor
// (issues/false-collides-with-bools-constructor.md). Two lines of this file
// hold both readings and neither is qualified.

fn Nat::Le(self n, m: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => k.Le(l) },
    }
}

// Strict order, as a definition and not a second recursion. `Lt(n, m)` is
// `Le(Succ(n), m)`, so everything `Le` computes `Lt` computes, and the two
// facts a reader most wants — `lt_succ_iff_le` and `lt_succ_self` — are
// definitional (see below).
fn Nat::Lt(self n, m: Nat) → Type { Succ(n).Le(m) }

designation <= at Nat := Nat::Le
designation < at Nat := Nat::Lt

// The decision procedure, kept. It is NOT part of the order's specification —
// nothing above mentions it and no lemma below is stated with it — and as of
// 2026-08-17 its last *specification* customer is gone too: `list_algos`'s
// insertion sort went propositional and decides with `le_dec`. What still reads
// `leb` is `certgen_code`, where a Boolean is the subject rather than the
// statement, which is exactly the role issues/class-ops-prop-vs-bool.md leaves
// `Bool` in.
fn Nat::leb(self n, m: Nat) → Bool {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => k.leb(l) },
    }
}

// truncated subtraction; both arguments descend together, `n` generalized
fn Nat::sub(self m, n: Nat) → Nat {
    match m {
        Zero => Zero,
        Succ(m2) => match n { Zero => Succ(m2), Succ(n2) => m2.sub(n2) },
    }
}

designation - at Nat := Nat::sub

theorem Nat::sub_zero(m: Nat): m -0 = m {
    match m { Zero => refl, Succ(_) => refl }
}

// ---------------------------------------------------------------------------
// The order kit. Read the bodies for what the definition gives away free:
// every fact about `Zero` on the left is `trivial`, every fact that moves a
// `Succ` across BOTH sides is the identity, and every absurd case is a
// hypothesis that already *is* `False`. Those three together are why this
// section has no inversion lemmas and no no-confusion machinery.

theorem Nat::nonneg(self m: Nat): 0 <= m { trivial }

// Doubling reflects order; an extra odd successor on the right does not
// change the comparison. Both proofs are just the two-successor recursion of
// `twice` read alongside the one-successor recursion of `Le`.
fn Nat::TwiceLeTwice(self n, m: Nat) → Type { n.twice() <= m.twice() }
fn Nat::TwiceLeOdd(self n, m: Nat) → Type { n.twice() <= Succ(m.twice()) }

theorem Nat::twice_le_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLeTwice(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(),
            mpr := λ h => m.twice().nonneg()),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_le_twice_iff(self n, m: Nat):
    (n.twice() <= m.twice()) ↔ (n <= m)
{
    Nat::twice_le_twice_iff_curried(n, m)
}

theorem Nat::twice_le_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLeOdd(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(),
            mpr := λ h => Succ(m.twice()).nonneg()),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_le_succ_twice_iff(n, m: Nat):
    (n.twice() <= Succ(m.twice())) ↔ (n <= m)
{
    Nat::twice_le_succ_twice_iff_curried(n, m)
}

fn Nat::TwiceLtTwice(self n, m: Nat) → Type { n.twice() < m.twice() }
fn Nat::TwiceLtOdd(self n, m: Nat) → Type { n.twice() < Succ(m.twice()) }

theorem Nat::twice_lt_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLtTwice(m) ↔ n < m)
{
    match n {
        Zero => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(_) => Iff(mp := λ h => trivial, mpr := λ h => trivial),
        },
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_lt_twice_iff(n, m: Nat):
    (n.twice() < m.twice()) ↔ (n < m)
{
    Nat::twice_lt_twice_iff_curried(n, m)
}

theorem Nat::twice_lt_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (n.TwiceLtOdd(m) ↔ n <= m)
{
    match n {
        Zero => λ m => Iff(mp := λ h => m.nonneg(), mpr := λ h => trivial),
        Succ(_, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem Nat::twice_lt_succ_twice_iff(n, m: Nat):
    (n.twice() < Succ(m.twice())) ↔ (n <= m)
{
    Nat::twice_lt_succ_twice_iff_curried(n, m)
}

theorem Nat::le_refl(self n: Nat): n <= n { match n { Zero => trivial, Succ(k) => k.le_refl() } }

theorem Nat::not_succ_le_zero(self n: Nat, h: Succ(n) <= 0): False { h }

// Both directions of the successor step, and both are the identity function —
// `Le(Succ n, Succ m)` and `Le(n, m)` are the same type. This is the
// definitional inversion the recursive definition is chosen for; stated as
// lemmas anyway, because the API is the kit and downstream never unfolds `Le`.
theorem Nat::le_succ_succ(self n, m: Nat, h: n <= m): Succ(n) <= Succ(m) { h }
theorem Nat::le_of_succ_succ(self n, m: Nat, h: Succ(n) <= Succ(m)): n <= m { h }

theorem Nat::le_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a <= c) ↔ (b <= d)
{
    rewrite(sym(left), sym(right), iff_refl())
}

theorem Nat::lt_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a < c) ↔ (b < d)
{
    rewrite(sym(left), sym(right), iff_refl())
}

theorem Nat::le_succ_r(self n, m: Nat): n <= m → n <= Succ(m) {
    match n {
        Zero => λ h => trivial,
        Succ(k) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢ k.le_succ_r(m2, good),
            },
    }
}

theorem Nat::le_trans(self n, m, l: Nat): n <= m → m <= l → n <= l {
    match n {
        Zero => λ h1 h2 => trivial,
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a =>
                    match l {
                        Zero => λ bad => false_elim(bad),
                        Succ(l2) => λ c => k.le_trans(m2, l2, a, c),
                    },
            },
    }
}

theorem Nat::le_antisym(self n, m: Nat): n <= m → m <= n → n = m {
    match n {
        Zero =>
            match m {
                Zero => λ a b => refl,
                Succ(_) => λ a bad => false_elim(bad),
            },
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a b => Nat::cong_succ(k.le_antisym(m2, a, b)),
            },
    }
}

theorem Nat::le_total(self n, m: Nat): n <= m ∨ m <= n {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(trivial),
                Succ(m2) => k.le_total(m2),
            },
    }
}

fn Nat::le_dec(self n, m: Nat) → n <= m ∨ ¬(n <= m) {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(·),
                Succ(m2) => k.le_dec(m2),
            },
    }
}

// Quotient and remainder are computed together while scanning the numerator.
// The state for `k + 1` increments the remainder from the state for `k`,
// carrying into the quotient exactly when it reaches a positive divisor.
// Thus termination is ordinary immediate-predecessor recursion, with no
// runtime fuel and no division-specific termination exception.
inductive DivMod { MkDivMod(quotient: Nat, remainder: Nat) }

fn Nat::divmod_step(divisor_pred: Nat, state: DivMod) → DivMod {
    match state {
        MkDivMod(quotient, remainder) =>
            match Succ(divisor_pred).le_dec(Succ(remainder)) {
                Inl(_) => MkDivMod(Succ(quotient), 0),
                Inr(_) => MkDivMod(quotient, Succ(remainder)),
            },
    }
}

fn Nat::divmod(self n: Nat) → Nat → DivMod {
    match n {
        Zero => λ divisor => MkDivMod(0, 0),
        Succ(k) => λ divisor => match divisor {
            Zero => MkDivMod(0, Succ(k)),
            Succ(d) => Nat::divmod_step(d, k.divmod(Succ(d))),
        },
    }
}

fn Nat::div(self n: Nat, divisor: Nat) → Nat {
    match n.divmod(divisor) { MkDivMod(quotient, _) => quotient }
}

fn Nat::mod(self n: Nat, divisor: Nat) → Nat {
    match n.divmod(divisor) { MkDivMod(_, remainder) => remainder }
}

// The computation above maintains both Euclidean facts in one state.  The
// second field records either the zero-divisor convention (`divisor <= 0`) or
// the strict remainder bound.
fn DivMod::Spec(n, divisor: Nat, state: DivMod) → Type {
    match state {
        MkDivMod(quotient, remainder) =>
            (quotient * divisor + remainder = n) ∧
            (divisor <= 0 ∨ remainder < divisor),
    }
}

// The order's `Decide` instance — generic in **both** of its values
// (docs/value-generic-instances-design.md, 2026-08-17). Until value binders
// existed the only registrable spelling was `Decide<Le(2, 5)>` at fixed
// numerals, which is precisely the case elaboration-time computation already
// answered; the open one, which is the only one a caller with variables in hand
// has, had no spelling at all.
//
// `n` and `m` are recovered by unifying `Le(n, m)` against the goal, so a use
// site writes neither: `decide<Le(x, h)>()` at open `x` and `h` resolves here.
// This is what lets `list_algos`'s `insert` decide through the class instead of
// naming `le_dec`, which is the measurement issues/value-generic-instances.md
// was filed to take.
instance(n, m: Nat) Decide<Nat::Le(n, m)> { dec := Nat::le_dec(n, m), bit := or_bit(Nat::le_dec(n, m)), reflects := or_bit_reflects(Nat::le_dec(n, m)) }

// ---------------------------------------------------------------------------
// The strict order. Every one of these is `Le`'s kit read at `Succ(n)`; the
// section is short because `Lt` is a definition rather than a second relation.

theorem Nat::lt_succ_self(self n: Nat): n < Succ(n) { n.le_refl() }

theorem Nat::lt_succ_iff_le(self n, m: Nat): n < Succ(m) ↔ n <= m {
    Iff(mp := λ (h: n < Succ(m)) => h, mpr := λ (h: n <= m) => h)
}

theorem Nat::lt_irrefl(self n: Nat): ¬(n < n) {
    match n {
        Zero => λ (h: 0 < 0) => h,
        Succ(k, ih) => λ (h: Succ(k) < Succ(k)) => ih(h),
    }
}

theorem Nat::ne_of_lt(self n, m: Nat, h: n < m): n ≠ m {
    λ equal => n.lt_irrefl(n.lt_congr_iff(n, m, n, refl, sym(equal)).mp(h))
}

theorem Nat::ne_of_gt(self n, m: Nat, h: m < n): n ≠ m {
    λ equal => m.ne_of_lt(n, h, sym(equal))
}

theorem Nat::le_of_lt(self n: Nat): (m: Nat) → n < m → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m =>
            match m {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good => ih(m2, good),
            },
    }
}

// Transitivity of `<` is transitivity of `<=` with one side weakened, and it
// is worth seeing why that is enough: `Lt(n, m)` IS `Le(Succ n, m)`, so the
// chain `Succ(n) <= m <= l` is already the goal.
theorem Nat::lt_trans(self n, m, l: Nat, h1: n < m, h2: m < l): n < l {
    Succ(n).le_trans(m, l, h1, m.le_of_lt(l, h2))
}

theorem Nat::lt_of_le_of_ne(self n: Nat): (m: Nat) → n <= m → n ≠ m → n < m {
    match n {
        Zero => λ m h =>
            match m {
                Zero => false_elim(·(refl)),
                Succ(_) => λ ne => trivial,
            },
        Succ(k, ih) => λ m =>
            match m {
                Zero => λ bad ne => false_elim(bad),
                Succ(m2) => λ a ne =>
                    ih(m2, a, λ (e: k = m2) => ne(Nat::cong_succ(e))),
            },
    }
}

theorem Nat::lt_trichotomy(self n: Nat): (m: Nat) → n < m ∨ n = m ∨ m < n {
    match n {
        Zero => λ m =>
            match m {
                Zero => Inr(Inl(refl)),
                Succ(_) => Inl(trivial),
            },
        Succ(_, ih) => λ m =>
            match m {
                Zero => Inr(Inr(trivial)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(a) => Inl(a),
                        Inr(r) => match r {
                            Inl(e) => Inr(Inl(Nat::cong_succ(e))),
                            Inr(b) => Inr(Inr(b)),
                        },
                    },
            },
    }
}

// A refuted comparison is the other one holding — totality, read backwards.
// This is the propositional successor of `list_algos`'s `leb_false_flip`, and
// the difference is the whole of what going propositional buys: that lemma was
// an induction on `x` with `y` generalized, ending in `leb(y, x) = True`;
// this one is `le_total` with the refuted side resolved away, and it is a line.
theorem Nat::le_of_not_le(n, m: Nat, h: ¬(n <= m)): m <= n {
    or_resolve(or_swap(n.le_total(m)), h)
}

// The strict counterpart is one successor stronger.  It is structural rather
// than a corollary of totality: `¬(m <= n)` computes to exactly the branch in
// which `Succ(n) <= m` holds.
theorem Nat::lt_of_not_le(n: Nat): (m: Nat) → ¬(m <= n) → n < m {
    match n {
        Zero => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(_) => λ h => trivial,
        },
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(k) => λ h => ih(k, h),
        },
    }
}

// Correctness follows the shared state, just like computation does.  Keeping
// the step lemma separate gives its dependent match the precise state it
// consumes and avoids duplicating quotient/remainder reasoning at the public
// projections.
theorem Nat::divmod_step_spec(n, divisor_pred: Nat, state: DivMod,
                         h: DivMod::Spec(n, Succ(divisor_pred), state)):
    DivMod::Spec(Succ(n), Succ(divisor_pred), Nat::divmod_step(divisor_pred, state))
{
    match state as λ s =>
        DivMod::Spec(n, Succ(divisor_pred), s) →
        DivMod::Spec(Succ(n), Succ(divisor_pred), Nat::divmod_step(divisor_pred, s))
    {
        MkDivMod(quotient, remainder) => λ spec => match spec {
            And(reconstruct, alternatives) => match alternatives {
                Inl(impossible) => false_elim(impossible),
                Inr(bounded) =>
                    match Succ(divisor_pred).le_dec(Succ(remainder)) as λ decision =>
                        DivMod::Spec(
                            Succ(n),
                            Succ(divisor_pred),
                            match decision {
                                Inl(_) => MkDivMod(Succ(quotient), 0),
                                Inr(_) => MkDivMod(quotient, Succ(remainder)),
                            },
                        )
                    {
                        Inl(carry) => And(
                            calc {
                                Succ(quotient) * Succ(divisor_pred)
                                    = Succ(divisor_pred) + quotient * Succ(divisor_pred) :=
                                        quotient.mul_succ_left(Succ(divisor_pred)),
                                    = quotient * Succ(divisor_pred) + Succ(divisor_pred) :=
                                        Succ(divisor_pred).add_comm(quotient * Succ(divisor_pred)),
                                    = quotient * Succ(divisor_pred) + Succ(remainder) :=
                                        Nat::cong(
                                            λ (x: Nat) =>
                                                quotient * Succ(divisor_pred) + Succ(x),
                                            divisor_pred.le_antisym(remainder, carry, bounded)),
                                    = Succ(quotient * Succ(divisor_pred) + remainder) := refl,
                                    = Succ(n) := Nat::cong_succ(reconstruct),
                            },
                            Inr(trivial),
                        ),
                        Inr(no_carry) => And(
                            Nat::cong_succ(reconstruct),
                            Inr(remainder.lt_of_not_le(divisor_pred, no_carry)),
                        ),
                    },
            },
        },
    }(h)
}

theorem Nat::divmod_spec(n: Nat): (divisor: Nat) →
    DivMod::Spec(n, divisor, n.divmod(divisor))
{
    match n {
        Zero => λ divisor => match divisor {
            Zero => And(refl, Inl(trivial)),
            Succ(d) => And(Succ(d).mul_left_zero(), Inr(trivial)),
        },
        Succ(k, ih) => λ divisor => match divisor {
            Zero => And(Nat::cong_succ(k.add_left_zero()), Inl(trivial)),
            Succ(d) => Nat::divmod_step_spec(k, d, k.divmod(Succ(d)), ih(Succ(d))),
        },
    }
}

// Public Euclidean laws.  Both projections below destruct the one shared
// state, so their `div` and `mod` occurrences are definitionally the same
// quotient and remainder certified by `divmod_spec`.
theorem Nat::div_mul_add_mod(self n, divisor: Nat):
    n.div(divisor) * divisor + n.mod(divisor) = n
{
    match n.divmod(divisor) as λ state =>
        DivMod::Spec(n, divisor, state) →
        match state as λ _ => Type {
            MkDivMod(quotient, remainder) =>
                quotient * divisor + remainder = n,
        }
    {
        MkDivMod(_, _) => λ spec => spec.left,
    }(Nat::divmod_spec(n, divisor))
}

theorem Nat::mod_lt(self n: Nat, divisor: Pos<Nat>):
    n.mod(divisor) < divisor
{
    match divisor as λ d => 0 < d → n.mod(d) < d {
        Zero => λ impossible => false_elim(impossible),
        Succ(d) => λ _ =>
            match n.divmod(Succ(d)) as λ state =>
                DivMod::Spec(n, Succ(d), state) →
                match state as λ _ => Type {
                    MkDivMod(_, remainder) => remainder < Succ(d),
                }
            {
                MkDivMod(_, _) => λ spec => match spec.right {
                    Inl(impossible) => false_elim(impossible),
                    Inr(bounded) => bounded,
                },
            }(n.divmod_spec(Succ(d))),
    }(divisor_pos)
}

theorem Nat::div_zero(self n: Nat): n.div(0) = 0 {
    match n { Zero => refl, Succ(_) => refl }
}

theorem Nat::mod_zero(self n: Nat): n.mod(0) = n {
    match n { Zero => refl, Succ(_) => refl }
}

// Divisibility follows the executable Euclidean semantics directly. Keeping
// it definitionally equal to a zero-remainder proposition lets arithmetic
// automation consume positive and negated uses without an existential witness.
fn Nat::Divides(self divisor, n: Nat) → Type { n.mod(divisor) = 0 }

// ---------------------------------------------------------------------------
// The two no-confusion facts proved by RECURSION rather than by `inj`/`absurd`.
// Those two special forms want "an equation at a declared inductive type" but `Nat` is a *kernel* type
// so we have to write the injectivity by hand here.
//   - injectivity is `pred`, which undoes `Succ` definitionally, so `Nat::cong`
//     is the whole proof and the statement holds by conversion;
//   - disjointness is a predicate that *separates* the constructors, so
//     transporting its inhabitant along the absurd equation lands in `False`.

// predecessor of a natural, saturating at zero
fn Nat::pred(self n: Nat) → Nat { match n { Zero => 0, Succ(k) => k } }

theorem Nat::succ_inj(n, m: Nat, h: Succ(n) = Succ(m)): n = m { Nat::cong(Nat::pred, h) }

// `IsSucc(Succ k)` is `True` and `IsSucc(0)` is `False`, so the constructors
// are told apart by a type rather than by a generated no-confusion lemma.
fn Nat::IsSucc(self n: Nat) → Type { match n { Zero => False, Succ(_) => True } }

theorem Nat::succ_ne_zero(self n: Nat): Succ(n) ≠ 0 {
    λ (h: Succ(n) = 0) => j(h, λ y q => y.IsSucc(), trivial)
}

theorem Nat::zero_ne_succ(self n: Nat): 0 ≠ Succ(n) {
    λ (h: 0 = Succ(n)) => n.succ_ne_zero(sym(h))
}

// The equality decider, mirroring `le_dec` exactly — same shape, same reason to
// be a `fn` rather than a `theorem` (it has to reduce), same curried spelling
// (both arguments descend together, so the guard refuses the uncurried one).
//
// Equality instances are keyed by the endpoints' inferred carrier, so this
// registers independently of equality at Bool and every other nominal type
// (docs/decidable-equation-carrier-design.md). The generated canonical value
// is deliberately unwritable; ordinary uses reach it through `Decide<n = m>`.
fn Nat::eq_dec(self n: Nat) → (m: Nat) → n = m ∨ n ≠ m {
    match n {
        Zero => λ m =>
            match m {
                Zero => Inl(refl),
                Succ(m2) => Inr(m2.zero_ne_succ()),
            },
        Succ(k, ih) => λ m =>
            match m {
                Zero => Inr(k.succ_ne_zero()),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(e) => Inl(Nat::cong_succ(e)),
                        Inr(ne) => Inr(λ (bad: Succ(k) = Succ(m2)) => ne(Nat::succ_inj(k, m2, bad))),
                    },
            },
    }
}

instance(n, m: Nat) Decide<n = m> { dec := Nat::eq_dec(n, m), bit := or_bit(Nat::eq_dec(n, m)), reflects := or_bit_reflects(Nat::eq_dec(n, m)) }

// The same decision as a property of the carrier, which is what a polymorphic
// container's decider requires of its element type (`logic::DecEq`).
instance DecEq<Nat> { eq_dec := Nat::eq_dec }

// ---------------------------------------------------------------------------
// The bridge to addition — route (c) of docs/nat-order-design.md §1, proved
// rather than chosen. `le_add` is the forward half and was already here.

// `Le(n, m)` gives the difference. Induction on `n` with `m` generalized —
// by the elaborator, since 2026-09-05.
theorem Nat::le_add(self n, m: Nat): n <= m → n + (m -n) = m {
    match n {
        Zero => hle ⊢
            apply trans;
            give Nat::cong(λ (x: Nat) => 0 + x, m.sub_zero());
            m.add_left_zero(),
        Succ(n2) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢
                    apply trans;
                    give n2.add_succ_left(m2 -n2);
                    Nat::cong_succ(n2.le_add(m2, good)),
            },
    }
}

// Two values compared by raising both to `n + m`, which is above each of them.

theorem Nat::le_add_l(self n, m: Nat): n <= n + m {
    match m { Zero => n.le_refl(), Succ(m2) => n.le_succ_r(n + m2, n.le_add_l(m2)) }
}

// `add` recurses on its second argument, so this one is the definitional side
theorem Nat::le_add_r(self n, m: Nat): m <= n + m {
    match m { Zero => trivial, Succ(m2) => n.le_add_r(m2) }
}

// The bridge itself: `n <= m` and `∃ k, n + k = m` are interchangeable. The
// forward direction is `le_add` with its witness named; the backward one is
// `le_add_l` transported along the caller's equation. Route (c) of the design
// is therefore available as a *view* at every call site, without being the
// definition — which is what makes the definition swappable later.
theorem Nat::le_iff_exists_add(self n, m: Nat): n <= m ↔ ∃ k: Nat, n + k = m {
    Iff(
        mp := λ (h: n <= m) => Exists(m -n, n.le_add(m, h)),
        mpr := λ (h: ∃ k: Nat, n + k = m) =>
            rewrite(sym(h.proof), n.le_add_l(h.witness)),
    )
}

// ---------------------------------------------------------------------------

theorem Nat::sub_self(self n: Nat): n -n = 0 {
    match n { Zero => refl, Succ(k) => k.sub_self() }
}

theorem Nat::add_sub_cancel(self n, m: Nat): (n + m) -m = n {
    match m { Zero => n.sub_zero(), Succ(k) => n.add_sub_cancel(k) }
}

theorem Nat::sub_add_cancel(self n, m: Nat, h: n <= m): (m -n) + n = m {
    trans((m -n).add_comm(n), n.le_add(m, h))
}

theorem Nat::sub_le(self m: Nat): (n: Nat) → m -n <= m {
    match m {
        Zero => λ n => trivial,
        Succ(m2, ih) => λ n =>
            match n {
                Zero => Succ(m2).le_refl(),
                Succ(n2) => (m2 -n2).le_succ_r(m2, ih(n2)),
            },
    }
}

// Removing a positive amount from a value strictly lowers it, provided the
// amount was available rather than truncated away.
theorem Nat::sub_lt_of_pos(self m: Nat): (n: Nat) → 0 < n → n <= m → m -n < m {
    match m {
        Zero => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(_) => λ positive bounded => false_elim(bounded),
        },
        Succ(m2) => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(n2) => λ positive bounded => m2.sub_le(n2),
        },
    }
}

// ---------------------------------------------------------------------------

theorem Nat::add_le_mono_r(self k: Nat): (n: Nat) → (m: Nat) → n <= m → n + k <= m + k {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem Nat::add_le_mono_l(self k, n, m: Nat, h: n <= m): k + n <= k + m {
    rewrite(k.add_comm(n), k.add_comm(m), k.add_le_mono_r(n, m, h))
}

theorem Nat::add_le_mono(self a, b, c, d: Nat, h1: a <= b, h2: c <= d): a + c <= b + d {
    (a + c).le_trans(b + c, b + d,
             c.add_le_mono_r(a, b, h1), b.add_le_mono_l(c, d, h2))
}

theorem Nat::le_of_add_le_add_r(self k: Nat): (n: Nat) → (m: Nat) → n + k <= m + k → n <= m {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem Nat::le_of_add_le_add_l(self k, n, m: Nat, h: k + n <= k + m): n <= m {
    k.le_of_add_le_add_r(n, m,
        rewrite(n.add_comm(k), m.add_comm(k), h))
}

theorem Nat::mul_le_mono_r(self k: Nat): (n: Nat) → (m: Nat) → n <= m → n * k <= m * k {
    match k {
        Zero => λ n m h => trivial,
        Succ(j, ih) => λ n m h =>
            (n * j).add_le_mono(m * j, n, m, ih(n, m, h), h),
    }
}

theorem Nat::mul_le_mono_l(self k, n, m: Nat, h: n <= m): k * n <= k * m {
    rewrite(k.mul_comm(n), k.mul_comm(m), k.mul_le_mono_r(n, m, h))
}

theorem Nat::mul_le_mono(self a, b, c, d: Nat, h1: a <= b, h2: c <= d): a * c <= b * d {
    (a * c).le_trans(b * c, b * d,
             c.mul_le_mono_r(a, b, h1), b.mul_le_mono_l(c, d, h2))
}

// The lexicographic order on `(a, r)` flattened into `a * n + r` for `r < n`
// (docs/mutual-recursion-design.md §4): a smaller `a` wins whatever the ranks,
// and an unchanged-or-smaller `a` needs a smaller rank. A mutual `decreases`
// group closes every recursive call's scaled obligation with one of these.
theorem Nat::scaled_lt(self a, b, r, s, n: Nat, h: a < b, q: r < n): a * n + r < b * n + s {
    Succ(a * n + r).le_trans(Succ(a) * n, b * n + s,
        rewrite(a.mul_succ_left(n), n.add_comm(a * n), (a * n).add_le_mono_l(Succ(r), n, q)),
        (Succ(a) * n).le_trans(b * n, b * n + s,
            n.mul_le_mono_r(Succ(a), b, h), (b * n).le_add_l(s)))
}

theorem Nat::scaled_le(self a, b, r, s, n: Nat, h: a <= b, q: r < s): a * n + r < b * n + s {
    Succ(a * n + r).le_trans(a * n + s, b * n + s,
        (a * n).add_le_mono_l(Succ(r), s, q),
        s.add_le_mono_r(a * n, b * n, n.mul_le_mono_r(a, b, h)))
}

// ---------------------------------------------------------------------------
// The division kit. Everything here is `div_mod_unique` read at a
// decomposition it names, so a proof about digits or place values cites a
// lemma instead of asking `omega` to expand every `div` and `mod` into a
// quotient, a remainder and their bounds (issues/nat-div-mod-lemma-kit.md).

theorem Nat::add_mul_distr(self a, b, c: Nat): (a + b) * c = a * c + b * c {
    calc {
        (a + b) * c
            = c * (a + b)   := (a + b).mul_comm(c),
            = c * a + c * b := c.mul_add_distr(a, b),
            = a * c + c * b := cong(c.mul_comm(a)),
            = a * c + b * c := cong(c.mul_comm(b)),
    }
}

theorem Nat::add_left_cancel(self k, n, m: Nat, h: k + n = k + m): n = m {
    n.le_antisym(m,
        k.le_of_add_le_add_l(n, m, rewrite(sym(h), (k + n).le_refl())),
        k.le_of_add_le_add_l(m, n, rewrite(sym(h), (k + n).le_refl())))
}

// A quotient and remainder that rebuild `n`, with the remainder below the
// divisor, are `div` and `mod`: a larger or smaller quotient would put `n`
// strictly on one side of itself (`scaled_lt`).
theorem Nat::div_mod_unique(self n, divisor, q, r: Nat, parts: q * divisor + r = n, bound: r < divisor):
    (n.div(divisor) = q) ∧ (n.mod(divisor) = r)
{
    let whole: (n.div(divisor) * divisor + n.mod(divisor) = n) = n.div_mul_add_mod(divisor);
    let below: (n.mod(divisor) < divisor) = n.mod_lt(divisor, divisor_pos := (1).le_trans(Succ(r), divisor, trivial, bound));
    let same: (n.div(divisor) = q) = match n.div(divisor).lt_trichotomy(q) {
        Inl(smaller) => false_elim(n.lt_irrefl(Nat::lt_congr_iff(
            n.div(divisor) * divisor + n.mod(divisor), n, q * divisor + r, n, whole, parts).mp(
                n.div(divisor).scaled_lt(q, n.mod(divisor), r, divisor, smaller, below)))),
        Inr(rest) => match rest {
            Inl(equal) => equal,
            Inr(larger) => false_elim(n.lt_irrefl(Nat::lt_congr_iff(
                q * divisor + r, n, n.div(divisor) * divisor + n.mod(divisor), n, parts, whole).mp(
                    q.scaled_lt(n.div(divisor), r, n.mod(divisor), divisor, larger, bound)))),
        },
    };
    And(same, (q * divisor).add_left_cancel(n.mod(divisor), r,
        trans(trans(sym(Nat::cong(λ (x: Nat) => x * divisor + n.mod(divisor), same)), whole), sym(parts))))
}

theorem Nat::div_of_lt(self n, divisor: Nat, h: n < divisor): n.div(divisor) = 0 {
    n.div_mod_unique(divisor, 0, n,
        trans(Nat::cong(λ (x: Nat) => x + n, divisor.mul_left_zero()), n.add_left_zero()), h).left
}

theorem Nat::mod_of_lt(self n, divisor: Nat, h: n < divisor): n.mod(divisor) = n {
    n.div_mod_unique(divisor, 0, n,
        trans(Nat::cong(λ (x: Nat) => x + n, divisor.mul_left_zero()), n.add_left_zero()), h).right
}

theorem Nat::div_one(self n: Nat): n.div(1) = n { n.div_mod_unique(1, n, 0, n.add_left_zero(), trivial).left }

theorem Nat::mod_one(self n: Nat): n.mod(1) = 0 { n.div_mod_unique(1, n, 0, n.add_left_zero(), trivial).right }

// A quotient bounded through its divisor: `n < d * k` leaves fewer than `k`
// whole `d`s in `n`. No positivity premise: at `d = 0` the bound is false.
theorem Nat::div_lt_of_lt_mul(self n, d, k: Nat, h: n < d * k): n.div(d) < k {
    match k.le_dec(n.div(d)) {
        Inl(enough) => false_elim(n.lt_irrefl(Succ(n).le_trans(d * k, n, h,
            (d * k).le_trans(n.div(d) * d, n,
                rewrite(n.div(d).mul_comm(d), d.mul_le_mono_l(k, n.div(d), enough)),
                rewrite(sym(n.div_mul_add_mod(d)), (n.div(d) * d).le_add_l(n.mod(d)), at := 2))))),
        Inr(short) => n.div(d).lt_of_not_le(k, short),
    }
}

// The converse direction: `k` whole `d`s fit in `n` when `d * k` does.
theorem Nat::le_div_of_mul_le(self n: Nat, d: Pos<Nat>, k: Nat, h: d * k <= n): k <= n.div(d) {
    match k.le_dec(n.div(d)) {
        Inl(fits) => fits,
        Inr(short) => false_elim(n.lt_irrefl(Succ(n).le_trans(d * Succ(n.div(d)), n,
            j(n.div_mul_add_mod(d), λ y _ => Succ(y) <= d * n.div(d) + d,
                j(n.div(d).mul_comm(d), λ y _ => Succ(n.div(d) * d + n.mod(d)) <= y + d,
                    (n.div(d) * d).add_le_mono_l(Succ(n.mod(d)), d, n.mod_lt(d)))),
            (d * Succ(n.div(d))).le_trans(d * k, n, d.mul_le_mono_l(Succ(n.div(d)), k, n.div(d).lt_of_not_le(k, short)), h)))),
    }
}

// Dividing by `a` and then by `b` is dividing by `a * b`, and what the
// larger divisor leaves is both remainders, the outer one scaled by `a`. The
// three nesting laws after it are this pair read one way each.
theorem Nat::div_mul_parts(self n: Nat, a, b: Pos<Nat>):
    (n.div(a * b) = n.div(a).div(b)) ∧ (n.mod(a * b) = n.div(a).mod(b) * a + n.mod(a))
{
    n.div_mod_unique(a * b, n.div(a).div(b), n.div(a).mod(b) * a + n.mod(a),
        calc {
            n.div(a).div(b) * (a * b) + (n.div(a).mod(b) * a + n.mod(a))
                = (n.div(a).div(b) * (a * b) + n.div(a).mod(b) * a) + n.mod(a) :=
                    sym((n.div(a).div(b) * (a * b)).add_assoc(n.div(a).mod(b) * a, n.mod(a))),
                = (n.div(a).div(b) * (b * a) + n.div(a).mod(b) * a) + n.mod(a) := cong(a.mul_comm(b)),
                = ((n.div(a).div(b) * b) * a + n.div(a).mod(b) * a) + n.mod(a) :=
                    cong(sym(n.div(a).div(b).mul_assoc(b, a))),
                = (n.div(a).div(b) * b + n.div(a).mod(b)) * a + n.mod(a) :=
                    cong(sym((n.div(a).div(b) * b).add_mul_distr(n.div(a).mod(b), a))),
                = n.div(a) * a + n.mod(a) := cong(n.div(a).div_mul_add_mod(b)),
                = n := n.div_mul_add_mod(a),
        },
        Nat::lt_congr_iff(n.div(a).mod(b) * a + n.mod(a), n.div(a).mod(b) * a + n.mod(a), b * a + 0, a * b,
            refl, b.mul_comm(a)).mp(
                n.div(a).mod(b).scaled_lt(b, n.mod(a), 0, a, n.div(a).mod_lt(b), n.mod_lt(a))))
}

theorem Nat::div_div(self n: Nat, a, b: Pos<Nat>): n.div(a).div(b) = n.div(a * b) {
    sym(n.div_mul_parts(a, b).left)
}

// Reducing modulo a multiple of `a` first changes nothing modulo `a`.
theorem Nat::mod_mul_mod(self n: Nat, a, b: Pos<Nat>): n.mod(a * b).mod(a) = n.mod(a) {
    trans(Nat::cong(λ (x: Nat) => x.mod(a), n.div_mul_parts(a, b).right),
        (n.div(a).mod(b) * a + n.mod(a)).div_mod_unique(a, n.div(a).mod(b), n.mod(a), refl, n.mod_lt(a)).right)
}

// A middle digit, read either end first.
theorem Nat::div_mod_eq_mod_div(self n: Nat, a, b: Pos<Nat>): n.div(a).mod(b) = n.mod(a * b).div(a) {
    sym(trans(Nat::cong(λ (x: Nat) => x.div(a), n.div_mul_parts(a, b).right),
        (n.div(a).mod(b) * a + n.mod(a)).div_mod_unique(a, n.div(a).mod(b), n.mod(a), refl, n.mod_lt(a)).left))
}

// Place value: the count of `c`s in `n` is `k` for every whole `c * k`, plus
// the `c`s in what is left of it.
theorem Nat::div_split(self n: Nat, c, k: Pos<Nat>): n.div(c) = n.div(c * k) * k + n.mod(c * k).div(c) {
    calc {
        n.div(c)
            = n.div(c).div(k) * k + n.div(c).mod(k) := sym(n.div(c).div_mul_add_mod(k)),
            = n.div(c * k) * k + n.div(c).mod(k) := cong(n.div_div(c, k)),
            = n.div(c * k) * k + n.mod(c * k).div(c) := cong(n.div_mod_eq_mod_div(c, k)),
    }
}

// ---------------------------------------------------------------------------

fn Nat::max(self a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => b,
        Succ(k) => λ (b: Nat) => match b { Zero => Succ(k), Succ(l) => Succ(k.max(l)) },
    }
}

fn Nat::min(self a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => 0,
        Succ(k) => λ (b: Nat) => match b { Zero => 0, Succ(l) => Succ(k.min(l)) },
    }
}

// The bounds. Each is an induction on the left argument with the right one
// generalized, and each has one arm that is `trivial` because `Zero` is below
// everything and one that is the IH at the shed successor.

theorem Nat::le_max_l(self a: Nat): (b: Nat) → a <= a.max(b) {
    match a {
        Zero => λ b => trivial,
        Succ(k, ih) => λ b =>
            match b {
                Zero => Succ(k).le_refl(),
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::le_max_r(self a: Nat): (b: Nat) → b <= a.max(b) {
    match a {
        Zero => λ b => b.le_refl(),
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::min_le_l(self a: Nat): (b: Nat) → a.min(b) <= a {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem Nat::min_le_r(self a: Nat): (b: Nat) → a.min(b) <= b {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

// The universal properties, which are what make the two functions a *lattice*
// rather than two functions with bounds: `max` is the least upper bound and
// `min` the greatest lower one. Three case analyses each, because the goal
// mentions all three values and the hypotheses have to be convoyed past two of
// them; no arithmetic in any arm.

theorem Nat::max_le(self a: Nat): (b: Nat) → (c: Nat) → a <= c → b <= c → a.max(b) <= c {
    match a {
        Zero => λ b c h1 h2 => h2,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a1,
                Succ(l) =>
                    match c {
                        Zero => λ bad a2 => false_elim(bad),
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

theorem Nat::le_min(a: Nat): (b: Nat) → (c: Nat) → c <= a → c <= b → c <= a.min(b) {
    match a {
        Zero => λ b c h1 h2 => h1,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a2,
                Succ(l) =>
                    match c {
                        Zero => λ a1 a2 => trivial,
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

theorem Nat::max_eq_r(self a: Nat): (b: Nat) → a <= b → a.max(b) = b {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => Nat::cong_succ(ih(l, good)),
            },
    }
}

theorem Nat::min_eq_l(a: Nat): (b: Nat) → a <= b → a.min(b) = a {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => Nat::cong_succ(ih(l, good)),
            },
    }
}

// ---------------------------------------------------------------------------

fn Nat::pow(self a: Nat, b: Nat) → Nat { match b { Zero => 1, Succ(k) => a.pow(k) * a } }

theorem Nat::pow_zero(self a: Nat): a.pow(0) = 1 { refl }
theorem Nat::pow_one(self a: Nat): a.pow(1) = a { a.mul_left_one() }

theorem Nat::one_pow(self n: Nat): (1).pow(n) = 1 {
    match n { Zero => refl, Succ(k) => Nat::cong(λ (w: Nat) => w * 1, k.one_pow()) }
}

theorem Nat::pow_add(self a: Nat, b, c: Nat): a.pow(b + c) = a.pow(b) * a.pow(c) {
    match c {
        Zero => sym(a.pow(b).add_left_zero()),
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w * a, a.pow_add(b, k));
            a.pow(b).mul_assoc(a.pow(k), a),
    }
}

theorem Nat::pow_mul(self a: Nat, b, c: Nat): a.pow(b * c) = a.pow(b).pow(c) {
    match c {
        Zero => refl,
        Succ(k) => calc {
            a.pow(b * Succ(k))
                = a.pow(b * k) * a.pow(b) := a.pow_add(b * k, b),
                = a.pow(b).pow(k) * a.pow(b) := cong(a.pow_mul(b, k)),
                = a.pow(b).pow(Succ(k))           := refl,
        },
    }
}

theorem Nat::mul_shuffle(x, y, z, w: Nat): (x * y) * (z * w) = (x * z) * (y * w) {
    calc {
        (x * y) * (z * w)
            = (x * (y * (z * w))) := x.mul_assoc(y, z * w),
            = (x * ((y * z) * w)) := cong(sym(y.mul_assoc(z, w))),
            = (x * ((z * y) * w)) := cong(y.mul_comm(z)),
            = (x * (z * (y * w))) := cong(z.mul_assoc(y, w)),
            = ((x * z) * (y * w)) := sym(x.mul_assoc(z, y * w)),
    }
}

theorem Nat::mul_pow(self a, b, n: Nat): (a * b).pow(n) = a.pow(n) * b.pow(n) {
    match n {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => w * (a * b), a.mul_pow(b, k));
            Nat::mul_shuffle(a.pow(k), b.pow(k), a, b),
    }
}

theorem Nat::one_le_pow(self a, n: Nat, h: 1 <= a): 1 <= a.pow(n) {
    match n {
        Zero => trivial,
        Succ(k) => (1).mul_le_mono(a.pow(k), 1, a, a.one_le_pow(k, h), h),
    }
}

// A positive power is at least its base.
theorem Nat::le_pow_self(self a, n: Nat, ha: 1 <= a, hn: 1 <= n): a <= a.pow(n) {
    match n as λ m => 1 <= m → a <= a.pow(m) {
        Zero => λ h => false_elim(h),
        Succ(k) => λ _ => j(a.mul_left_one(), λ y _ => y <= a.pow(k) * a,
            (1).mul_le_mono(a.pow(k), a, a, a.one_le_pow(k, ha), a.le_refl())),
    }(hn)
}

fn Nat::fact(self n: Nat) → Nat { match n { Zero => 1, Succ(k) => Succ(k) * k.fact() } }

theorem Nat::fact_zero(): (0).fact() = 1 { refl }

theorem Nat::fact_pos(n: Nat): 0 < n.fact() {
    match n {
        Zero => trivial,
        Succ(k) => (1).mul_le_mono(Succ(k), 1, k.fact(), trivial, k.fact_pos()),
    }
}

// Evidence rules (docs/positivity-evidence-design.md §6 A). A `:= infer`
// positivity premise with no proof in scope backchains through these, each
// premise searched the same way, so `0 < x * (y + 1)` is found from `0 < x`.
// A literal or `Succ` operand needs no rule: its goal computes to `True`.

evidence theorem Nat::mul_pos({a, b: Nat}, pa: 0 < a := infer, pb: 0 < b := infer): 0 < a * b {
    (1).mul_le_mono(a, 1, b, pa, pb)
}

evidence theorem Nat::add_pos_l({a, b: Nat}, pa: 0 < a := infer): 0 < a + b {
    (1).le_trans(a, a + b, pa, a.le_add_l(b))
}

evidence theorem Nat::add_pos_r({a, b: Nat}, pb: 0 < b := infer): 0 < a + b {
    (1).le_trans(b, a + b, pb, a.le_add_r(b))
}

// A power of a positive base is positive, so `Rat(n, Nat::pow(2, k))` finds its
// denominator's positivity with no argument.
evidence theorem Nat::pow_pos({a, n: Nat}, pa: 0 < a := infer): 0 < a.pow(n) { a.one_le_pow(n, pa) }

theorem Nat::fact_le_succ(self n: Nat): n.fact() <= Succ(n).fact() {
    rewrite(sym(n.fact().mul_left_one()), n.fact().mul_le_mono_r(1, Succ(n), trivial))
}

// ---------------------------------------------------------------------------

fn Nat::half(self n: Nat) → Nat {
    match n {
        Zero => 0,
        Succ(k) => match k { Zero => 0, Succ(l) => Succ(l.half()) },
    }
}

fn Nat::Even(n: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match k { Zero => False, Succ(l) => Nat::Even(l) },
    }
}

fn Nat::Odd(n: Nat) → Type {
    match n {
        Zero => False,
        Succ(k) => match k { Zero => True, Succ(l) => Nat::Odd(l) },
    }
}

// TODO: nat not even zero
// TODO: nat odd zero

theorem Nat::half_le(self n: Nat): n.half() <= n {
    match n {
        Zero => trivial,
        Succ(k) => match k { Zero => trivial, Succ(l) => l.half().le_succ_r(l, l.half_le()) },
    }
}

theorem Nat::half_double(self n: Nat): (n + n).half() = n {
    match n {
        Zero => refl,
        Succ(l) =>
            apply trans;
            give Nat::cong(λ (w: Nat) => Succ(w).half(), l.add_succ_left(l));
            Nat::cong_succ(l.half_double()),
    }
}

theorem Nat::even_double(self n: Nat): Nat::Even(n + n) {
    match n {
        Zero => trivial,
        Succ(l) => j(sym(l.add_succ_left(l)), λ y q => Nat::Even(Succ(y)), l.even_double()),
    }
}

theorem Nat::even_or_odd(self n: Nat): Nat::Even(n) ∨ Nat::Odd(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k { Zero => Inr(trivial), Succ(l) => l.even_or_odd() },
    }
}

theorem Nat::not_even_and_odd(self n: Nat): ¬(Nat::Even(n) ∧ Nat::Odd(n)) {
    match n {
        Zero => λ (h: Nat::Even(0) ∧ Nat::Odd(0)) => h.right,
        Succ(k) => match k {
            Zero => λ (h: Nat::Even(1) ∧ Nat::Odd(1)) => h.left,
            Succ(l) => not_even_and_odd(l),
        },
    }
}

// The tie between the two halves of this section, and the reason they are one
// issue rather than two: on an even argument, halving is exactly invertible.
// Curried, so that the recursion descends on `n` alone and the hypothesis
// rides along as an argument (issues/ih-generalization.md's shape).
theorem Nat::half_add_half(self n: Nat): Nat::Even(n) → n.half() + n.half() = n {
    match n {
        Zero => λ (h: Nat::Even(0)) => refl,
        Succ(k) => match k {
            Zero => λ (h: Nat::Even(1)) => false_elim(h),
            Succ(l) => (h: Nat::Even(Succ(Succ(l)))) ⊢
                apply trans;
                give Nat::cong_succ(l.half().add_succ_left(l.half()));
                Nat::cong_succ(Nat::cong_succ(l.half_add_half(h))),
        },
    }
}

theorem half_lt_of_lt_double(self x: Nat): (p: Nat) → x < p + p → x.half() < p {
    match x {
        Zero => λ p => match p {
            Zero => λ bad => false_elim(bad),
            Succ(_) => λ _ => trivial,
        },
        Succ(k) => match k {
            Zero => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(_) => λ _ => trivial,
            },
            Succ(l) => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(r) => λ h => l.half_lt_of_lt_double(r,
                    j(r.add_succ_left(r), λ y _ => Succ(l) < y, h)),
            },
        },
    }
}

fn Nat::even_dec(self n: Nat) → Nat::Even(n) ∨ ¬Nat::Even(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k {
            Zero => Inr(λ (bad: Nat::Even(1)) => bad),
            Succ(l) => l.even_dec(),
        },
    }
}

instance(n: Nat) Decide<Nat::Even(n)> { dec := Nat::even_dec(n), bit := or_bit(Nat::even_dec(n)), reflects := or_bit_reflects(Nat::even_dec(n)) }

// ---------------------------------------------------------------------------
// The bridge between the Boolean decision and the propositional order. `leb`
// and `Le` are the same two-argument recursion written into `Bool` and into
// `Type`.

// TODO: should "sound" / "complete" w.r.t. some proposition be a definition inofitself or a typeclass?
theorem Nat::leb_sound(self n: Nat): (m: Nat) → n.leb(m).IsTrue() → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

theorem Nat::leb_complete(self n: Nat): (m: Nat) → n <= m → n.leb(m).IsTrue() {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

theorem Nat::le_of_not_lt(self n, m: Nat, h: ¬(n < m)): m <= n {
    or_resolve(m.le_dec(n), λ (k: ¬(m <= n)) => h(n.lt_of_not_le(m, k)))
}

// TODO: use symbol for not
theorem Nat::leb_not_lt(self n, m: Nat, h: Succ(n).leb(m).not().IsTrue()): m.leb(n).IsTrue() {
    m.leb_complete(n, n.le_of_not_lt(m,
        λ (k: n < m) => Succ(n).leb(m).is_true_not(h, Succ(n).leb_complete(m, k))))
}

theorem Nat::leb_lt_le_absurd(self n, m: Nat, lt: Succ(n).leb(m).IsTrue(), le: m.leb(n).IsTrue()): False {
    n.lt_irrefl(Succ(n).le_trans(m, n, Succ(n).leb_sound(m, lt), m.leb_sound(n, le)))
}

// Arithmetic and propositional order on the kernel `Nat` type. The relations
// reduce at closed arguments; `leb` remains available when a Boolean result is
// wanted, but is not the definition of `<=`.

import bool;
import logic;

// ---------------------------------------------------------------------------
// Addition and its two moving lemmas. `add` recurses on its SECOND argument,
// so the lemmas that matter are the ones that move a `Succ` — and a zero —
// across from the *left*.

fn add(a, b: Nat) → Nat { match b { Zero => a, Succ(k) => Succ(add(a, k)) } }

// The public spelling belongs beside the operation, so the law kit below is
// written in the same surface a downstream proof uses.
designation + at Nat := add

theorem cong_nat(f: Nat → Nat, {a, b: Nat}, p: a = b): f(a) = f(b) {
    j(p, λ y q => f(a) = f(y), refl)
}

theorem add_left_zero(x: Nat): 0 + x = x {
    match x { Zero => refl, Succ(k) => cong_succ(add_left_zero(k)) }
}

theorem add_succ_left(a, b: Nat): Succ(a) + b = Succ(a + b) {
    match b { Zero => refl, Succ(k) => cong_succ(add_succ_left(a, k)) }
}

// The two laws that make `add` a commutative monoid — asked for by the traits
// adoption round (2026-08-07), which registers `AddCommMonoid<Nat>` in
// `std/algebra` and needs exactly these as its fields. Both recurse on the
// argument `add` itself recurses on, so both are three lines.

theorem add_assoc(x, y, z: Nat): (x + y) + z = x + (y + z) {
    match z { Zero => refl, Succ(k) => cong_succ(add_assoc(x, y, k)) }
}

theorem add_comm(x, y: Nat): x + y = y + x {
    match y {
        Zero => sym(add_left_zero(x)),
        Succ(k) =>
            apply trans;
            give cong_succ(add_comm(x, k));
            sym(add_succ_left(k, x)),
    }
}

// Structural doubling. `2 * n` is extensionally the same operation, but
// multiplication recurses on its second argument and is a poor normal form
// for proofs that consume one binary digit at a time. `twice` exposes two
// successors per input successor, so order cancellation remains structural.
fn twice(n: Nat) → Nat {
    match n { Zero => 0, Succ(k) => Succ(Succ(twice(k))) }
}

theorem twice_add_self(n: Nat): twice(n) = n + n {
    match n {
        Zero => refl,
        Succ(k) => calc {
            twice(Succ(k))
                = Succ(Succ(twice(k))) := refl,
                = Succ(Succ(k + k)) := cong_succ(cong_succ(twice_add_self(k))),
                = Succ(Succ(k) + k) := cong_succ(sym(add_succ_left(k, k))),
                = Succ(k) + Succ(k) := refl,
        },
    }
}

theorem twice_add(a, b: Nat): twice(a + b) = twice(a) + twice(b) {
    match b {
        Zero => refl,
        Succ(k) => cong_succ(cong_succ(twice_add(a, k))),
    }
}

// Swap the first two terms without rebuilding associativity and commutativity
// at every use. This is the right-associated form consumed by certifying AC
// reconstruction.
theorem add_left_comm(a, b, c: Nat): a + (b + c) = b + (a + c) {
    calc {
        a + (b + c)
            = (a + b) + c := sym(add_assoc(a, b, c)),
            = (b + a) + c :=
                cong_nat(fun (q: Nat) => q + c, add_comm(a, b)),
            = b + (a + c) := add_assoc(b, a, c),
    }
}

// Reorder the middle two elements of a four-term sum. Keeping this ordinary
// commutative-monoid consequence named avoids rebuilding a five-step calc in
// every binary-arithmetic proof.
theorem add_swap_middle(a, b, c, d: Nat):
    (a + b) + (c + d) = (a + c) + (b + d)
{
    calc {
        (a + b) + (c + d)
            = a + (b + (c + d)) := add_assoc(a, b, c + d),
            = a + ((b + c) + d) :=
                cong_nat(λ (q: Nat) => a + q, sym(add_assoc(b, c, d))),
            = a + ((c + b) + d) :=
                cong_nat(λ (q: Nat) => a + (q + d), add_comm(b, c)),
            = a + (c + (b + d)) :=
                cong_nat(λ (q: Nat) => a + q, add_assoc(c, b, d)),
            = (a + c) + (b + d) := sym(add_assoc(a, c, b + d)),
    }
}

// ---------------------------------------------------------------------------
// Multiplication and its kit. `mul` recurses on its SECOND argument, like
// `add`, and the step puts the recursive result on the LEFT of the `add` —
// `add(mul(a, k), a)`, not `add(a, mul(a, k))`. That is the whole economy of
// this section, and it is the same choice `add` made one paragraph up: put the
// step's `add` on the argument `add` itself descends on, so that the zero
// side stays *definitional*. `mul(a, 0)` reduces to `Zero` and `add(x, 0)` to
// `x` with no lemma, so `mul(0, x) = 0` and the zero arm of distributivity are
// a self-call and a `refl` respectively. Spelled the other way round every
// proof below pays an `add_left_zero` rewrite it does not otherwise need.
//
// (`crates/elab/tests/certgen*.rs` has a `viaadd` fixture that IS spelled the
// other way. That is deliberate and unrelated: it is a *generator* fixture,
// pinned byte-for-byte, and it wants the cross-function call shape rather than
// the cheap lemma kit. Two different programs, so two different names.)

fn mul(a, b: Nat) → Nat { match b { Zero => Zero, Succ(k) => add(mul(a, k), a) } }

designation * at Nat := mul

// The right zero — `mul(x, 0) = 0` — needs no lemma. The left one does, and it
// is three lines because the step's `add(_, 0)` reduces away.
theorem mul_left_zero(x: Nat): 0 * x = 0 {
    match x { Zero => refl, Succ(k) => mul_left_zero(k) }
}

// The unit on the left, for the same reason: `add(mul(1, k), 1)` reduces to
// `Succ(mul(1, k))` on its own, so this is `add_left_zero`'s shape exactly.
theorem mul_left_one(x: Nat): 1 * x = x {
    match x { Zero => refl, Succ(k) => cong_succ(mul_left_one(k)) }
}

// `add_succ_left`'s counterpart: the lemma that moves a `Succ` across from the
// left. It is the one proof here that is not three lines, and every step of it
// is an `add` law — which is the point of proving `add`'s kit first.
theorem mul_succ_left(a, b: Nat): Succ(a) * b = b + a * b {
    match b {
        Zero => refl,
        Succ(k) => calc {
            Succ(a) * Succ(k)
                = Succ(Succ(a) * k + a)   := refl,
                = Succ((k + a * k) + a)   := cong(mul_succ_left(a, k)),
                = Succ(k + (a * k + a))   := cong(add_assoc(k, a * k, a)),
                = Succ(k) + a * Succ(k)   := sym(add_succ_left(k, a * k + a)),
        },
    }
}

// Distributivity over the argument both functions recurse on. It comes before
// `mul_assoc` because `mul_assoc` *is* an instance of it, not the other way
// round — the associativity step rebuilds `mul(x, mul(y, Succ(k)))` as a sum
// and needs this to take it apart.
theorem mul_add_distr(a, b, c: Nat): a * (b + c) = a * b + a * c {
    match c {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give cong_nat(λ (w: Nat) => add(w, a), mul_add_distr(a, b, k));
            add_assoc(mul(a, b), mul(a, k), a),
    }
}

// The two laws `std/algebra` registers `CommMonoid<Nat>(mul)` from, in the
// shape its fields want.

theorem mul_assoc(x, y, z: Nat): (x * y) * z = x * (y * z) {
    match z {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give cong_nat(λ (w: Nat) => add(w, mul(x, y)), mul_assoc(x, y, k));
            sym(mul_add_distr(x, mul(y, k), y)),
    }
}

theorem mul_comm(x, y: Nat): x * y = y * x {
    match y {
        Zero => sym(mul_left_zero(x)),
        Succ(k) => calc {
            x * Succ(k)
                = x * k + x := refl,
                = k * x + x := cong(mul_comm(x, k)),
                = x + k * x := add_comm(k * x, x),
                = Succ(k) * x := sym(mul_succ_left(k, x)),
        },
    }
}

// ---------------------------------------------------------------------------
// The order, stated PROPOSITIONALLY (docs/nat-order-design.md §1). `<=` is
// surface notation for a call to `Le` and `<` for a call to `Lt`
// (issues/comparison-operators.md).
//
// The relation is a recursion into `Type`: `Le(3, 10)` reduces to `True`, so
// closed comparisons compute without routing the specification through Bool.
//
// Uncurried since 2026-09-05: the recursion is on `n` and the inner `match`
// varies `m`, which the elaborator now generalizes into the motive
// (docs/ih-generalization-design.md). `leb` and `sub` were curried for the
// same reason and are uncurried the same way. A partial application `Le(n)`
// still writes where a relation value is wanted.
//
// Falsity is `logic::False`, which coexists with `bool::False` the constructor
// (issues/false-collides-with-bools-constructor.md). Two lines of this file
// hold both readings and neither is qualified.

fn Le(n, m: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => Le(k, l) },
    }
}

// Strict order, as a definition and not a second recursion. `Lt(n, m)` is
// `Le(Succ(n), m)`, so everything `Le` computes `Lt` computes, and the two
// facts a reader most wants — `lt_succ_iff_le` and `lt_succ_self` — are
// definitional (see below).
fn Lt(n, m: Nat) → Type { Le(Succ(n), m) }

designation <= at Nat := Le
designation < at Nat := Lt

// The decision procedure, kept. It is NOT part of the order's specification —
// nothing above mentions it and no lemma below is stated with it — and as of
// 2026-08-17 its last *specification* customer is gone too: `list_algos`'s
// insertion sort went propositional and decides with `le_dec`. What still reads
// `leb` is `certgen_code`, where a Boolean is the subject rather than the
// statement, which is exactly the role issues/class-ops-prop-vs-bool.md leaves
// `Bool` in.
fn leb(n, m: Nat) → Bool {
    match n {
        Zero => True,
        Succ(k) => match m { Zero => False, Succ(l) => leb(k, l) },
    }
}

// truncated subtraction; both arguments descend together, `n` generalized
fn sub(m, n: Nat) → Nat {
    match m {
        Zero => Zero,
        Succ(m2) => match n { Zero => Succ(m2), Succ(n2) => sub(m2, n2) },
    }
}

theorem sub_zero(m: Nat): sub(m, 0) = m {
    match m { Zero => refl, Succ(_) => refl }
}

// ---------------------------------------------------------------------------
// The order kit. Read the bodies for what the definition gives away free:
// every fact about `Zero` on the left is `trivial`, every fact that moves a
// `Succ` across BOTH sides is the identity, and every absurd case is a
// hypothesis that already *is* `False`. Those three together are why this
// section has no inversion lemmas and no no-confusion machinery.

// `Zero` is below everything, by computation.
theorem zero_le(m: Nat): 0 <= m { trivial }

// Doubling reflects order; an extra odd successor on the right does not
// change the comparison. Both proofs are just the two-successor recursion of
// `twice` read alongside the one-successor recursion of `Le`.
fn TwiceLeTwice(n, m: Nat) → Type { twice(n) <= twice(m) }
fn TwiceLeOdd(n, m: Nat) → Type { twice(n) <= Succ(twice(m)) }

theorem twice_le_twice_iff_curried(n: Nat): (m: Nat) →
    (TwiceLeTwice(n, m) ↔ Le(n, m))
{
    match n {
        Zero => λ m => Iff(mp := λ h => zero_le(m),
            mpr := λ h => zero_le(twice(m))),
        Succ(k, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem twice_le_twice_iff(n, m: Nat):
    (twice(n) <= twice(m)) ↔ (n <= m)
{
    twice_le_twice_iff_curried(n, m)
}

theorem twice_le_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (TwiceLeOdd(n, m) ↔ Le(n, m))
{
    match n {
        Zero => λ m => Iff(mp := λ h => zero_le(m),
            mpr := λ h => zero_le(Succ(twice(m)))),
        Succ(k, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem twice_le_succ_twice_iff(n, m: Nat):
    (twice(n) <= Succ(twice(m))) ↔ (n <= m)
{
    twice_le_succ_twice_iff_curried(n, m)
}

fn TwiceLtTwice(n, m: Nat) → Type { twice(n) < twice(m) }
fn TwiceLtOdd(n, m: Nat) → Type { twice(n) < Succ(twice(m)) }

theorem twice_lt_twice_iff_curried(n: Nat): (m: Nat) →
    (TwiceLtTwice(n, m) ↔ Lt(n, m))
{
    match n {
        Zero => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(_) => Iff(mp := λ h => trivial, mpr := λ h => trivial),
        },
        Succ(k, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem twice_lt_twice_iff(n, m: Nat):
    (twice(n) < twice(m)) ↔ (n < m)
{
    twice_lt_twice_iff_curried(n, m)
}

theorem twice_lt_succ_twice_iff_curried(n: Nat): (m: Nat) →
    (TwiceLtOdd(n, m) ↔ Le(n, m))
{
    match n {
        Zero => λ m => Iff(mp := λ h => zero_le(m), mpr := λ h => trivial),
        Succ(k, ih) => λ m => match m {
            Zero => Iff(mp := λ bad => bad, mpr := λ bad => bad),
            Succ(l) => ih(l),
        },
    }
}

theorem twice_lt_succ_twice_iff(n, m: Nat):
    (twice(n) < Succ(twice(m))) ↔ (n <= m)
{
    twice_lt_succ_twice_iff_curried(n, m)
}

theorem le_refl(n: Nat): n <= n { match n { Zero => trivial, Succ(k) => le_refl(k) } }

// The one absurdity, and it is not proved so much as *named*: `Le(Succ n, 0)`
// unfolds to `False`, so the hypothesis is already the conclusion.
theorem not_succ_le_zero(n: Nat, h: Succ(n) <= 0): False { h }

// Both directions of the successor step, and both are the identity function —
// `Le(Succ n, Succ m)` and `Le(n, m)` are the same type. This is the
// definitional inversion the recursive definition is chosen for; stated as
// lemmas anyway, because the API is the kit and downstream never unfolds `Le`.
theorem le_succ_succ(n, m: Nat, h: n <= m): Succ(n) <= Succ(m) { h }
theorem le_of_succ_succ(n, m: Nat, h: Succ(n) <= Succ(m)): n <= m { h }

theorem le_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a <= c) ↔ (b <= d)
{
    j(left, λ y p => (a <= c) ↔ (y <= d),
      j(right, λ z q => (a <= c) ↔ (a <= z), iff_refl()))
}

theorem lt_congr_iff(a, b, c, d: Nat, left: a = b, right: c = d):
    (a < c) ↔ (b < d)
{
    j(left, λ y p => (a < c) ↔ (y < d),
      j(right, λ z q => (a < c) ↔ (a < z), iff_refl()))
}

theorem le_succ_r(n, m: Nat): n <= m → n <= Succ(m) {
    match n {
        Zero => λ h => trivial,
        Succ(k) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢ le_succ_r(k, m2, good),
            },
    }
}

// Transitivity. Three nested case analyses and no arithmetic: the recursion is
// on the leftmost argument, `m` and `l` are generalized into its motive
// (docs/ih-generalization-design.md), and the two inner `match`es exist only
// to expose the successors that make the hypotheses reducible. The hypotheses
// stay behind the arrows: a parameter is not refined by an inner `match`, a
// binder introduced after it is.
theorem le_trans(n, m, l: Nat): n <= m → m <= l → n <= l {
    match n {
        Zero => λ h1 h2 => trivial,
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a =>
                    match l {
                        Zero => λ bad => false_elim(bad),
                        Succ(l2) => λ c => le_trans(k, m2, l2, a, c),
                    },
            },
    }
}

theorem le_antisym(n, m: Nat): n <= m → m <= n → n = m {
    match n {
        Zero =>
            match m {
                Zero => λ a b => refl,
                Succ(_) => λ a bad => false_elim(bad),
            },
        Succ(k) =>
            match m {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a b => cong_succ(le_antisym(k, m2, a, b)),
            },
    }
}

// Totality, and the successor case is where the definition pays again: the
// goal `Succ(k) <= Succ(m2) ∨ Succ(m2) <= Succ(k)` and the IH's
// `k <= m2 ∨ m2 <= k` are the SAME type, so the step is `ih(m2)` with
// no repackaging.
theorem le_total(n, m: Nat): n <= m ∨ m <= n {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(trivial),
                Succ(m2) => le_total(k, m2),
            },
    }
}

// The decider, and the instance that puts it in the class. It returns
// `P ∨ ¬P` and nothing else — no `Bool`, no bridge lemma — and it REDUCES at
// closed arguments, which is what lets `algebra`'s `max_of` compute.
//
// A `fn` and NOT a `theorem`, for exactly that reason: a `theorem` is opaque,
// so a decision spelled as one never unfolds in conversion and
// `max_of(2, 5) = 5` stops being `refl`. Deciding is computation, whatever it
// returns. Found by the kernel rejecting that very `refl` rather than by
// reasoning; `logic::or_pick` carries the same note for the same reason.
fn le_dec(n, m: Nat) → n <= m ∨ ¬(n <= m) {
    match n {
        Zero => Inl(trivial),
        Succ(k) =>
            match m {
                Zero => Inr(·),
                Succ(m2) => le_dec(k, m2),
            },
    }
}

// Quotient and remainder are computed together while scanning the numerator.
// The state for `k + 1` increments the remainder from the state for `k`,
// carrying into the quotient exactly when it reaches a positive divisor.
// Thus termination is ordinary immediate-predecessor recursion, with no
// runtime fuel and no division-specific termination exception.
inductive DivMod { MkDivMod(quotient: Nat, remainder: Nat) }

fn divmod_step(divisor_pred: Nat, state: DivMod) → DivMod {
    match state {
        MkDivMod(quotient, remainder) =>
            match le_dec(Succ(divisor_pred), Succ(remainder)) {
                Inl(_) => MkDivMod(Succ(quotient), 0),
                Inr(_) => MkDivMod(quotient, Succ(remainder)),
            },
    }
}

fn divmod(n: Nat) → Nat → DivMod {
    match n {
        Zero => λ divisor => MkDivMod(0, 0),
        Succ(k) => λ divisor => match divisor {
            Zero => MkDivMod(0, Succ(k)),
            Succ(d) => divmod_step(d, divmod(k, Succ(d))),
        },
    }
}

fn div(n, divisor: Nat) → Nat {
    match divmod(n, divisor) { MkDivMod(quotient, _) => quotient }
}

fn mod(n, divisor: Nat) → Nat {
    match divmod(n, divisor) { MkDivMod(_, remainder) => remainder }
}

// The computation above maintains both Euclidean facts in one state.  The
// second field records either the zero-divisor convention (`divisor <= 0`) or
// the strict remainder bound.
fn DivModSpec(n, divisor: Nat, state: DivMod) → Type {
    match state {
        MkDivMod(quotient, remainder) =>
            (quotient * divisor + remainder = n) ∧
            (divisor <= 0 ∨ remainder < divisor),
    }
}

// The order's `Decide` instance — generic in **both** of its values
// (docs/value-generic-instances-design.md, 2026-08-17). Until value binders
// existed the only registrable spelling was `Decide<Le(2, 5)>` at fixed
// numerals, which is precisely the case elaboration-time computation already
// answered; the open one, which is the only one a caller with variables in hand
// has, had no spelling at all.
//
// `n` and `m` are recovered by unifying `Le(n, m)` against the goal, so a use
// site writes neither: `decide<Le(x, h)>()` at open `x` and `h` resolves here.
// This is what lets `list_algos`'s `insert` decide through the class instead of
// naming `le_dec`, which is the measurement issues/value-generic-instances.md
// was filed to take.
instance(n, m: Nat) Decide<Le(n, m)> { dec := le_dec(n, m) }

// ---------------------------------------------------------------------------
// The strict order. Every one of these is `Le`'s kit read at `Succ(n)`; the
// section is short because `Lt` is a definition rather than a second relation.

// `Lt(n, Succ n)` is `Le(Succ n, Succ n)` is `Le(n, n)`.
theorem lt_succ_self(n: Nat): n < Succ(n) { le_refl(n) }

// Both directions are the identity: `Lt(n, Succ m)` and `Le(n, m)` are one
// type. The `Iff` exists to be *cited*, not to do work.
theorem lt_succ_iff_le(n, m: Nat): n < Succ(m) ↔ n <= m {
    Iff(mp := λ (h: n < Succ(m)) => h, mpr := λ (h: n <= m) => h)
}

// Irreflexivity, which is `Le(Succ n, n) → False` and recurses to the base
// case `Le(1, 0)` — already `False`, so the whole proof is the recursion.
theorem lt_irrefl(n: Nat): ¬(n < n) {
    match n {
        Zero => λ (h: 0 < 0) => h,
        Succ(k, ih) => λ (h: Succ(k) < Succ(k)) => ih(h),
    }
}

theorem ne_of_lt(n, m: Nat, h: n < m): n ≠ m {
    λ equal => lt_irrefl(n,
        lt_congr_iff(n, n, m, n, refl, sym(equal)).mp(h))
}

theorem ne_of_gt(n, m: Nat, h: m < n): n ≠ m {
    λ equal => ne_of_lt(m, n, h, sym(equal))
}

theorem le_of_lt(n: Nat): (m: Nat) → n < m → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m =>
            match m {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good => ih(m2, good),
            },
    }
}

// Transitivity of `<` is transitivity of `<=` with one side weakened, and it
// is worth seeing why that is enough: `Lt(n, m)` IS `Le(Succ n, m)`, so the
// chain `Succ(n) <= m <= l` is already the goal.
theorem lt_trans(n, m, l: Nat, h1: n < m, h2: m < l): n < l {
    le_trans(Succ(n), m, l, h1, le_of_lt(m, l, h2))
}

theorem lt_of_le_of_ne(n: Nat): (m: Nat) → n <= m → n ≠ m → n < m {
    match n {
        Zero => λ m h =>
            match m {
                Zero => false_elim(·(refl)),
                Succ(_) => λ ne => trivial,
            },
        Succ(k, ih) => λ m =>
            match m {
                Zero => λ bad ne => false_elim(bad),
                Succ(m2) => λ a ne =>
                    ih(m2, a, λ (e: k = m2) => ne(cong_succ(e))),
            },
    }
}

// Trichotomy. Nested `Or` rather than a three-constructor inductive, because
// the connective is what `logic` gives and a bespoke type would need its own
// eliminator for no gain. The successor step is again a re-use of the IH at
// the same type, once for each of its three arms.
theorem lt_trichotomy(n: Nat): (m: Nat) → n < m ∨ n = m ∨ m < n {
    match n {
        Zero => λ m =>
            match m {
                Zero => Inr(Inl(refl)),
                Succ(_) => Inl(trivial),
            },
        Succ(_, ih) => λ m =>
            match m {
                Zero => Inr(Inr(trivial)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(a) => Inl(a),
                        Inr(r) => match r {
                            Inl(e) => Inr(Inl(cong_succ(e))),
                            Inr(b) => Inr(Inr(b)),
                        },
                    },
            },
    }
}

// A refuted comparison is the other one holding — totality, read backwards.
// This is the propositional successor of `list_algos`'s `leb_false_flip`, and
// the difference is the whole of what going propositional buys: that lemma was
// an induction on `x` with `y` generalized, ending in `leb(y, x) = True`;
// this one is `le_total` with the refuted side resolved away, and it is a line.
theorem le_of_not_le(n, m: Nat, h: ¬(n <= m)): m <= n {
    or_resolve(or_swap(le_total(n, m)), h)
}

// The strict counterpart is one successor stronger.  It is structural rather
// than a corollary of totality: `¬(m <= n)` computes to exactly the branch in
// which `Succ(n) <= m` holds.
theorem lt_of_not_le(n: Nat): (m: Nat) → ¬(m <= n) → n < m {
    match n {
        Zero => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(_) => λ h => trivial,
        },
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h(trivial)),
            Succ(k) => λ h => ih(k, h),
        },
    }
}

// Correctness follows the shared state, just like computation does.  Keeping
// the step lemma separate gives its dependent match the precise state it
// consumes and avoids duplicating quotient/remainder reasoning at the public
// projections.
theorem divmod_step_spec(n, divisor_pred: Nat, state: DivMod,
                         h: DivModSpec(n, Succ(divisor_pred), state)):
    DivModSpec(Succ(n), Succ(divisor_pred), divmod_step(divisor_pred, state))
{
    match state as λ s =>
        DivModSpec(n, Succ(divisor_pred), s) →
        DivModSpec(Succ(n), Succ(divisor_pred), divmod_step(divisor_pred, s))
    {
        MkDivMod(quotient, remainder) => λ spec => match spec {
            And(reconstruct, alternatives) => match alternatives {
                Inl(impossible) => false_elim(impossible),
                Inr(bounded) =>
                    match le_dec(Succ(divisor_pred), Succ(remainder)) as λ decision =>
                        DivModSpec(
                            Succ(n),
                            Succ(divisor_pred),
                            match decision {
                                Inl(_) => MkDivMod(Succ(quotient), 0),
                                Inr(_) => MkDivMod(quotient, Succ(remainder)),
                            },
                        )
                    {
                        Inl(carry) => And(
                            calc {
                                Succ(quotient) * Succ(divisor_pred)
                                    = Succ(divisor_pred) + quotient * Succ(divisor_pred) :=
                                        mul_succ_left(quotient, Succ(divisor_pred)),
                                    = quotient * Succ(divisor_pred) + Succ(divisor_pred) :=
                                        add_comm(
                                            Succ(divisor_pred),
                                            quotient * Succ(divisor_pred)),
                                    = quotient * Succ(divisor_pred) + Succ(remainder) :=
                                        cong_nat(
                                            λ (x: Nat) =>
                                                quotient * Succ(divisor_pred) + Succ(x),
                                            le_antisym(
                                                divisor_pred, remainder, carry, bounded)),
                                    = Succ(quotient * Succ(divisor_pred) + remainder) := refl,
                                    = Succ(n) := cong_succ(reconstruct),
                            },
                            Inr(trivial),
                        ),
                        Inr(no_carry) => And(
                            cong_succ(reconstruct),
                            Inr(lt_of_not_le(
                                remainder, divisor_pred, no_carry)),
                        ),
                    },
            },
        },
    }(h)
}

theorem divmod_spec(n: Nat): (divisor: Nat) →
    DivModSpec(n, divisor, divmod(n, divisor))
{
    match n {
        Zero => λ divisor => match divisor {
            Zero => And(refl, Inl(trivial)),
            Succ(d) => And(mul_left_zero(Succ(d)), Inr(trivial)),
        },
        Succ(k, ih) => λ divisor => match divisor {
            Zero => And(cong_succ(add_left_zero(k)), Inl(trivial)),
            Succ(d) => divmod_step_spec(k, d, divmod(k, Succ(d)), ih(Succ(d))),
        },
    }
}

// Public Euclidean laws.  Both projections below destruct the one shared
// state, so their `div` and `mod` occurrences are definitionally the same
// quotient and remainder certified by `divmod_spec`.
theorem div_mul_add_mod(n, divisor: Nat):
    div(n, divisor) * divisor + mod(n, divisor) = n
{
    match divmod(n, divisor) as λ state =>
        DivModSpec(n, divisor, state) →
        match state as λ _ => Type {
            MkDivMod(quotient, remainder) =>
                quotient * divisor + remainder = n,
        }
    {
        MkDivMod(_, _) => λ spec => spec.left,
    }(divmod_spec(n, divisor))
}

theorem mod_lt(n, divisor: Nat, positive: 0 < divisor):
    mod(n, divisor) < divisor
{
    match divisor as λ d => 0 < d → mod(n, d) < d {
        Zero => λ impossible => false_elim(impossible),
        Succ(d) => λ _ =>
            match divmod(n, Succ(d)) as λ state =>
                DivModSpec(n, Succ(d), state) →
                match state as λ _ => Type {
                    MkDivMod(_, remainder) => remainder < Succ(d),
                }
            {
                MkDivMod(_, _) => λ spec => match spec.right {
                    Inl(impossible) => false_elim(impossible),
                    Inr(bounded) => bounded,
                },
            }(divmod_spec(n, Succ(d))),
    }(positive)
}

theorem div_zero(n: Nat): div(n, 0) = 0 {
    match n { Zero => refl, Succ(_) => refl }
}

theorem mod_zero(n: Nat): mod(n, 0) = n {
    match n { Zero => refl, Succ(_) => refl }
}

// Divisibility follows the executable Euclidean semantics directly. Keeping
// it definitionally equal to a zero-remainder proposition lets arithmetic
// automation consume positive and negated uses without an existential witness.
fn Divides(divisor, n: Nat) → Type { mod(n, divisor) = 0 }

// ---------------------------------------------------------------------------
// Equality at `Nat`, and its decision (issues/std-api-waves.md wave 2).
//
// The two no-confusion facts first, and they are proved by RECURSION rather
// than by `inj`/`absurd`. Those two special forms want "an equation at a
// declared inductive type" and `Nat` is a *kernel* type with no declaration —
// so the constructor-injectivity and constructor-disjointness that every
// declared inductive gets generated for it have to be written by hand here,
// once. Each is one auxiliary function on `Nat` and a `j` along it:
//
//   - injectivity is `pred`, which undoes `Succ` definitionally, so `cong_nat`
//     is the whole proof and the statement holds by conversion;
//   - disjointness is a predicate that *separates* the constructors, so
//     transporting its inhabitant along the absurd equation lands in `False`.
//
// This is the small tax `Nat`-as-a-kernel-type charges, and it is worth naming
// because nothing else in the library pays it.

fn pred(n: Nat) → Nat { match n { Zero => 0, Succ(k) => k } }

theorem succ_inj(n, m: Nat, h: Succ(n) = Succ(m)): n = m { cong_nat(pred, h) }

// `IsSucc(Succ k)` is `True` and `IsSucc(0)` is `False`, so the constructors
// are told apart by a type rather than by a generated no-confusion lemma.
fn IsSucc(n: Nat) → Type { match n { Zero => False, Succ(_) => True } }

theorem succ_ne_zero(n: Nat): Succ(n) ≠ 0 {
    λ (h: Succ(n) = 0) => j(h, λ y q => IsSucc(y), trivial)
}

theorem zero_ne_succ(n: Nat): 0 ≠ Succ(n) {
    λ (h: 0 = Succ(n)) => succ_ne_zero(n, sym(h))
}

// The equality decider, mirroring `le_dec` exactly — same shape, same reason to
// be a `fn` rather than a `theorem` (it has to reduce), same curried spelling
// (both arguments descend together, so the guard refuses the uncurried one).
//
// Equality instances are keyed by the endpoints' inferred carrier, so this
// registers independently of equality at Bool and every other nominal type
// (docs/decidable-equation-carrier-design.md). The generated canonical value
// is deliberately unwritable; ordinary uses reach it through `Decide<n = m>`.
fn eq_dec(n: Nat) → (m: Nat) → n = m ∨ n ≠ m {
    match n {
        Zero => λ m =>
            match m {
                Zero => Inl(refl),
                Succ(m2) => Inr(zero_ne_succ(m2)),
            },
        Succ(k, ih) => λ m =>
            match m {
                Zero => Inr(succ_ne_zero(k)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(e) => Inl(cong_succ(e)),
                        Inr(ne) => Inr(λ (bad: Succ(k) = Succ(m2)) => ne(succ_inj(k, m2, bad))),
                    },
            },
    }
}

instance(n, m: Nat) Decide<n = m> { dec := eq_dec(n, m) }

// The same decision as a property of the carrier, which is what a polymorphic
// container's decider requires of its element type (`logic::DecEq`).
instance DecEq<Nat> { eq_dec := eq_dec }

// ---------------------------------------------------------------------------
// The bridge to addition — route (c) of docs/nat-order-design.md §1, proved
// rather than chosen. `le_add` is the forward half and was already here.

// `Le(n, m)` gives the difference. Induction on `n` with `m` generalized —
// by the elaborator, since 2026-09-05.
theorem le_add(n, m: Nat): n <= m → n + sub(m, n) = m {
    match n {
        Zero => hle ⊢
            apply trans;
            give cong_nat(λ (x: Nat) => add(0, x), sub_zero(m));
            add_left_zero(m),
        Succ(n2) =>
            match m {
                Zero => bad ⊢ false_elim(bad),
                Succ(m2) => good ⊢
                    apply trans;
                    give add_succ_left(n2, sub(m2, n2));
                    cong_succ(le_add(n2, m2, good)),
            },
    }
}

// Two values compared by raising both to `n + m`, which is above each of them.

theorem le_add_l(n, m: Nat): n <= n + m {
    match m { Zero => le_refl(n), Succ(m2) => le_succ_r(n, n + m2, le_add_l(n, m2)) }
}

// `add` recurses on its second argument, so this one is the definitional side
theorem le_add_r(n, m: Nat): m <= n + m {
    match m { Zero => trivial, Succ(m2) => le_add_r(n, m2) }
}

// Monotonicity, each on the argument its operation recurses on or across it.
// `add` recurses on the right, so moving the right operand is a walk down both
// successors and moving the left one is carried unchanged through them.
theorem add_mono_r(x, u, v: Nat): u <= v → x + u <= x + v {
    match u {
        Zero => λ h => le_add_l(x, v),
        Succ(u2) => match v {
            Zero => λ bad => false_elim(bad),
            Succ(v2) => λ h => add_mono_r(x, u2, v2, h),
        },
    }
}

theorem add_mono_l(x, y, u: Nat, h: x <= y): x + u <= y + u {
    match u { Zero => h, Succ(u2) => add_mono_l(x, y, u2, h) }
}

theorem mul_mono_l(a, b, n: Nat, h: a <= b): a * n <= b * n {
    match n {
        Zero => trivial,
        Succ(k) => le_trans(a * k + a, b * k + a, b * k + b,
            add_mono_l(a * k, b * k, a, mul_mono_l(a, b, k, h)),
            add_mono_r(b * k, a, b, h)),
    }
}

// The lexicographic order on `(a, r)` flattened into `a * n + r` for `r < n`
// (docs/mutual-recursion-design.md §4): a smaller `a` wins whatever the ranks,
// and an unchanged-or-smaller `a` needs a smaller rank. A mutual `decreases`
// group closes every recursive call's scaled obligation with one of these.
theorem scaled_lt(a, b, r, s, n: Nat, h: a < b, q: r < n): a * n + r < b * n + s {
    le_trans(Succ(a * n + r), Succ(a) * n, b * n + s,
        j(trans(add_comm(a * n, n), sym(mul_succ_left(a, n))),
          λ y p => Succ(a * n + r) <= y, add_mono_r(a * n, Succ(r), n, q)),
        le_trans(Succ(a) * n, b * n, b * n + s, mul_mono_l(Succ(a), b, n, h), le_add_l(b * n, s)))
}

theorem scaled_le(a, b, r, s, n: Nat, h: a <= b, q: r < s): a * n + r < b * n + s {
    le_trans(Succ(a * n + r), a * n + s, b * n + s,
        add_mono_r(a * n, Succ(r), s, q),
        add_mono_l(a * n, b * n, s, mul_mono_l(a, b, n, h)))
}

// The bridge itself: `n <= m` and `∃ k, n + k = m` are interchangeable. The
// forward direction is `le_add` with its witness named; the backward one is
// `le_add_l` transported along the caller's equation. Route (c) of the design
// is therefore available as a *view* at every call site, without being the
// definition — which is what makes the definition swappable later.
theorem le_iff_exists_add(n, m: Nat): n <= m ↔ ∃ k: Nat, n + k = m {
    Iff(
        mp := λ (h: n <= m) => Exists(sub(m, n), le_add(n, m, h)),
        mpr := λ (h: Exists(λ (k: Nat) => n + k = m)) =>
            j(h.proof, λ y q => n <= y, le_add_l(n, h.witness)),
    )
}

// ---------------------------------------------------------------------------
// The rest of the `sub` kit (issues/nat-arithmetic-kit.md). `sub` and
// `sub_zero` are up beside `leb`, where they were needed by `le_add`; these
// four are the facts that read the *order*, so they live down here where the
// order kit is in scope.
//
// The two cancellations are asymmetric, and the asymmetry is truncation's:
// `(n + m) - m = n` holds unconditionally, because the subtraction it undoes
// is the one that was just performed, while `(m - n) + n = m` needs `n <= m`
// — without it the difference was truncated to zero and the addition cannot
// put back what was never there.

theorem sub_self(n: Nat): sub(n, n) = 0 {
    match n { Zero => refl, Succ(k) => sub_self(k) }
}

// Unconditional, and definitional at every step: `add(n, Succ k)` reduces to
// `Succ(add(n, k))` and `sub(Succ(x), Succ(y))` to `sub(x, y)`, so each arm is
// exactly the recursive call with no rewrite between.
theorem add_sub_cancel(n, m: Nat): sub(n + m, m) = n {
    match m { Zero => sub_zero(n), Succ(k) => add_sub_cancel(n, k) }
}

// The conditional direction, and it is `le_add` commuted rather than a second
// induction — `le_add` already proved `n + (m - n) = m` under the hypothesis,
// and the only difference is which side the difference is written on.
theorem sub_add_cancel(n, m: Nat, h: n <= m): sub(m, n) + n = m {
    trans(add_comm(sub(m, n), n), le_add(n, m, h))
}

// Truncation is exactly why this needs no hypothesis: subtracting *more* than
// there is lands at `0`, which is below `m` like everything else.
theorem sub_le(m: Nat): (n: Nat) → sub(m, n) <= m {
    match m {
        Zero => λ n => trivial,
        Succ(m2, ih) => λ n =>
            match n {
                Zero => le_refl(Succ(m2)),
                Succ(n2) => le_succ_r(sub(m2, n2), m2, ih(n2)),
            },
    }
}

// Removing a positive amount from a value strictly lowers it, provided the
// amount was available rather than truncated away.
theorem sub_lt_of_pos(m: Nat): (n: Nat) → 0 < n → n <= m → sub(m, n) < m {
    match m {
        Zero => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(_) => λ positive bounded => false_elim(bounded),
        },
        Succ(m2) => λ n => match n {
            Zero => λ positive bounded => false_elim(positive),
            Succ(n2) => λ positive bounded => sub_le(m2, n2),
        },
    }
}

// ---------------------------------------------------------------------------
// Monotonicity and cancellation — the lemmas where the order meets the
// arithmetic (issues/nat-arithmetic-kit.md).
//
// Every one of them recurses on the argument that is *added on* rather than on
// either compared value, and that is what makes the bodies this short:
// `add(n, Succ j)` is `Succ(add(n, j))` and `Le(Succ x, Succ y)` is
// `Le(x, y)`, so a step of the induction is a step of *both* definitions
// cancelling, and the arm is the IH applied unchanged. The `_r` suffix names
// the side the operand is added on, as in `add(n, k) <= add(m, k)`.
//
// The `_l` halves are then `_r` read through commutativity, transported with
// `j` rather than reproved: `add` recurses on its second argument, so an
// induction on the left operand would pay `add_left_zero`/`add_succ_left` at
// every step to reach a shape the `_r` proof already has.

theorem add_le_mono_r(k: Nat): (n: Nat) → (m: Nat) → n <= m → n + k <= m + k {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem add_le_mono_l(k, n, m: Nat, h: n <= m): k + n <= k + m {
    j(add_comm(n, k), λ y q => y <= k + m,
      j(add_comm(m, k), λ y q => n + k <= y, add_le_mono_r(k, n, m, h)))
}

// Both sides at once, which is the two one-sided lemmas chained through
// transitivity at the mixed sum `b + c`.
theorem add_le_mono(a, b, c, d: Nat, h1: a <= b, h2: c <= d): a + c <= b + d {
    le_trans(a + c, b + c, b + d,
             add_le_mono_r(c, a, b, h1), add_le_mono_l(b, c, d, h2))
}

// Cancellation, and it is the *same* recursion as the monotonicity above with
// the implication turned round — which is worth seeing, because it says the
// two directions are not two facts: at each step both sides shed a `Succ`
// definitionally, and neither direction ever has anything to do.
theorem le_of_add_le_add_r(k: Nat): (n: Nat) → (m: Nat) → n + k <= m + k → n <= m {
    match k {
        Zero => λ n m h => h,
        Succ(_, ih) => λ n m h => ih(n, m, h),
    }
}

theorem le_of_add_le_add_l(k, n, m: Nat, h: k + n <= k + m): n <= m {
    le_of_add_le_add_r(k, n, m,
        j(add_comm(k, n), λ y q => y <= m + k,
          j(add_comm(k, m), λ y q => k + n <= y, h)))
}

// Multiplication is where the induction stops being free and starts *using*
// the section above: `mul(n, Succ j)` is `add(mul(n, j), n)`, so the step
// compares two sums and needs both of their sides moved — which is exactly
// `add_le_mono`, the IH on the left and the hypothesis on the right.
//
// Note what is NOT here: cancellation for `mul`. It is false at `k = 0`
// (`0 <= 0` says nothing about `n` and `m`) and so wants a `0 < k` hypothesis,
// which is a different lemma and not the mirror of this one.
theorem mul_le_mono_r(k: Nat): (n: Nat) → (m: Nat) → n <= m → n * k <= m * k {
    match k {
        Zero => λ n m h => trivial,
        Succ(j, ih) => λ n m h =>
            add_le_mono(mul(n, j), mul(m, j), n, m, ih(n, m, h), h),
    }
}

theorem mul_le_mono_l(k, n, m: Nat, h: n <= m): k * n <= k * m {
    j(mul_comm(n, k), λ y q => y <= k * m,
      j(mul_comm(m, k), λ y q => n * k <= y, mul_le_mono_r(k, n, m, h)))
}

theorem mul_le_mono(a, b, c, d: Nat, h1: a <= b, h2: c <= d): a * c <= b * d {
    le_trans(a * c, b * c, b * d,
             mul_le_mono_r(c, a, b, h1), mul_le_mono_l(b, c, d, h2))
}

// ---------------------------------------------------------------------------
// `min` and `max` at `Nat` — plain structural recursions, and the standing
// correction to the assumption that a "decided" function needs a decider
// (docs/nat-order-design.md §6). Neither mentions `Le`, `leb` or `le_dec`;
// both descend on both arguments at once and so are curried for the reason
// `Le` and `sub` are (issues/ih-generalization.md), and both **reduce**, so
// `max(2, 5) = 5` is `refl`.
//
// `std/algebra`'s `max_of` is a different thing wearing a similar name: it is
// the `Cmp`-generic pick, one call to a decider at whatever carrier the class
// was registered at. These two are `Nat`'s own, they compute without deciding
// anything, and nothing here is proved about the relationship between them —
// `algebra` imports `nat`, so a lemma bridging the two cannot be stated in
// this file at all.

fn max(a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => b,
        Succ(k) => λ (b: Nat) => match b { Zero => Succ(k), Succ(l) => Succ(max(k, l)) },
    }
}

fn min(a: Nat) → Nat → Nat {
    match a {
        Zero => λ (b: Nat) => 0,
        Succ(k) => λ (b: Nat) => match b { Zero => 0, Succ(l) => Succ(min(k, l)) },
    }
}

// The bounds. Each is an induction on the left argument with the right one
// generalized, and each has one arm that is `trivial` because `Zero` is below
// everything and one that is the IH at the shed successor.

theorem le_max_l(a: Nat): (b: Nat) → a <= max(a, b) {
    match a {
        Zero => λ b => trivial,
        Succ(k, ih) => λ b =>
            match b {
                Zero => le_refl(Succ(k)),
                Succ(l) => ih(l),
            },
    }
}

theorem le_max_r(a: Nat): (b: Nat) → b <= max(a, b) {
    match a {
        Zero => λ b => le_refl(b),
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem min_le_l(a: Nat): (b: Nat) → min(a, b) <= a {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

theorem min_le_r(a: Nat): (b: Nat) → min(a, b) <= b {
    match a {
        Zero => λ b => trivial,
        Succ(_, ih) => λ b =>
            match b {
                Zero => trivial,
                Succ(l) => ih(l),
            },
    }
}

// The universal properties, which are what make the two functions a *lattice*
// rather than two functions with bounds: `max` is the least upper bound and
// `min` the greatest lower one. Three case analyses each, because the goal
// mentions all three values and the hypotheses have to be convoyed past two of
// them; no arithmetic in any arm.

theorem max_le(a: Nat): (b: Nat) → (c: Nat) → a <= c → b <= c → max(a, b) <= c {
    match a {
        Zero => λ b c h1 h2 => h2,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a1,
                Succ(l) =>
                    match c {
                        Zero => λ bad a2 => false_elim(bad),
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

theorem le_min(a: Nat): (b: Nat) → (c: Nat) → c <= a → c <= b → c <= min(a, b) {
    match a {
        Zero => λ b c h1 h2 => h1,
        Succ(_, ih) => λ b c =>
            match b {
                Zero => λ a1 a2 => a2,
                Succ(l) =>
                    match c {
                        Zero => λ a1 a2 => trivial,
                        Succ(c2) => λ a1 a2 => ih(l, c2, a1, a2),
                    },
            },
    }
}

// What the order decides the functions to be, which is the pair of facts a
// caller with a comparison in hand actually wants. The absurd arm is the
// hypothesis itself, as everywhere else in this file.

theorem max_eq_r(a: Nat): (b: Nat) → a <= b → max(a, b) = b {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => cong_succ(ih(l, good)),
            },
    }
}

theorem min_eq_l(a: Nat): (b: Nat) → a <= b → min(a, b) = a {
    match a {
        Zero => λ b h => refl,
        Succ(_, ih) => λ b =>
            match b {
                Zero => λ bad => false_elim(bad),
                Succ(l) => λ good => cong_succ(ih(l, good)),
            },
    }
}

// ---------------------------------------------------------------------------
// Exponentiation and factorial (issues/nat-pow-and-fact.md) — the third step
// of the same progression, written the same way for the same reason. `pow`
// recurses on its second argument and puts the recursive result on the LEFT of
// the `mul`, exactly as `mul` does to `add`, so `pow(a, 0)` reduces to `1` and
// `mul(x, 1)` to `add(0, x)` with no lemma. Every law below is `mul`'s kit read
// one level up, and the resemblance is not a coincidence: `pow_add` is to
// `mul_assoc` what `mul_add_distr` is to `add_assoc`.
//
// They live at the END of the file, after the order, because two of their
// lemmas are order facts — `one_le_pow` and `one_le_fact` are `mul_le_mono`
// applied to themselves, and there is nowhere earlier they could be stated.

fn pow(a, b: Nat) → Nat { match b { Zero => 1, Succ(k) => mul(pow(a, k), a) } }

// Both small exponents, stated because the API is the kit — and they are not
// the same kind of fact, which is the thing to notice. Exponent zero is `refl`
// at open `a`; exponent one is not, because it is `mul(1, a)`, which descends
// on `a` and so is stuck there. The numeral is on the wrong side.
theorem pow_zero(a: Nat): pow(a, 0) = 1 { refl }
theorem pow_one(a: Nat): pow(a, 1) = a { mul_left_one(a) }

// The base one. `mul(w, 1)` reduces to `add(0, w)`, which is why the step is a
// single `cong_nat` with no arithmetic after it: rewriting the IH inside the
// `mul` lands on `mul(1, 1)`, and that is `1` by computation.
theorem one_pow(n: Nat): pow(1, n) = 1 {
    match n { Zero => refl, Succ(k) => cong_nat(λ (w: Nat) => mul(w, 1), one_pow(k)) }
}

// Exponents add. The zero arm is the one place the `mul`-shaped definition
// charges anything — `mul(x, 1)` is `add(0, x)` and not `x` — and it charges
// exactly one `add_left_zero`.
theorem pow_add(a, b, c: Nat): pow(a, b + c) = pow(a, b) * pow(a, c) {
    match c {
        Zero => sym(add_left_zero(pow(a, b))),
        Succ(k) =>
            apply trans;
            give cong_nat(λ (w: Nat) => mul(w, a), pow_add(a, b, k));
            mul_assoc(pow(a, b), pow(a, k), a),
    }
}

// Exponents multiply, and this one is `pow_add`'s customer rather than a
// second induction: `mul(b, Succ k)` is `add(mul(b, k), b)`, so the step is
// `pow_add` at that sum with the IH rewritten into the left factor.
theorem pow_mul(a, b, c: Nat): pow(a, b * c) = pow(pow(a, b), c) {
    match c {
        Zero => refl,
        Succ(k) => calc {
            pow(a, mul(b, Succ(k)))
                = mul(pow(a, mul(b, k)), pow(a, b)) := pow_add(a, mul(b, k), b),
                = mul(pow(pow(a, b), k), pow(a, b)) := cong(pow_mul(a, b, k)),
                = pow(pow(a, b), Succ(k))           := refl,
        },
    }
}

// The rearrangement `mul_pow` needs, factored out because it is about `mul`
// alone and a reader looking for it should not have to find it inside a `pow`
// proof. Middle-exchange: it is what commutativity and associativity say
// together, and the only lemma here that is pure monoid algebra.
theorem mul_shuffle(x, y, z, w: Nat): (x * y) * (z * w) = (x * z) * (y * w) {
    calc {
        mul(mul(x, y), mul(z, w))
            = mul(x, mul(y, mul(z, w))) := mul_assoc(x, y, mul(z, w)),
            = mul(x, mul(mul(y, z), w)) := cong(sym(mul_assoc(y, z, w))),
            = mul(x, mul(mul(z, y), w)) := cong(mul_comm(y, z)),
            = mul(x, mul(z, mul(y, w))) := cong(mul_assoc(z, y, w)),
            = mul(mul(x, z), mul(y, w)) := sym(mul_assoc(x, z, mul(y, w))),
    }
}

theorem mul_pow(a, b, n: Nat): pow(a * b, n) = pow(a, n) * pow(b, n) {
    match n {
        Zero => refl,
        Succ(k) =>
            apply trans;
            give cong_nat(λ (w: Nat) => mul(w, mul(a, b)), mul_pow(a, b, k));
            mul_shuffle(pow(a, k), pow(b, k), a, b),
    }
}

// The one order fact about `pow`, and it is `mul_le_mono` applied to the IH and
// the hypothesis — the same shape `mul_le_mono_r`'s own step has. `mul(1, 1)`
// is `1` by computation, so the conclusion needs no repackaging.
theorem one_le_pow(a, n: Nat, h: 1 <= a): 1 <= pow(a, n) {
    match n {
        Zero => trivial,
        Succ(k) => mul_le_mono(1, pow(a, k), 1, a, one_le_pow(a, k, h), h),
    }
}

// Factorial, which recurses on the argument itself rather than on a second
// one, and so is the shortest definition in this file.
fn fact(n: Nat) → Nat { match n { Zero => 1, Succ(k) => mul(Succ(k), fact(k)) } }

theorem fact_zero(): fact(0) = 1 { refl }

// Positivity — the fact everything else about `fact` eventually wants, since a
// factorial is never `0` and a proof that divides by one needs to know it.
// `1 <= Succ(k)` is `Le(0, k)` is `True`, hence the bare `trivial` in the
// middle of an otherwise ordinary application.
theorem one_le_fact(n: Nat): 1 <= fact(n) {
    match n {
        Zero => trivial,
        Succ(k) => mul_le_mono(1, Succ(k), 1, fact(k), trivial, one_le_fact(k)),
    }
}

// Monotone at a single step, which is monotonicity in the only form that needs
// no induction: `fact(Succ n)` is `fact(n)` multiplied by something at least
// `1`, and `mul_le_mono_r` says so once `fact(n)` is spelled as `mul(1, …)`.
theorem fact_le_succ(n: Nat): fact(n) <= fact(Succ(n)) {
    j(mul_left_one(fact(n)), λ y q => y <= Succ(n) * fact(n),
      mul_le_mono_r(fact(n), 1, Succ(n), trivial))
}

// ---------------------------------------------------------------------------
// Halving and parity (issues/nat-parity-and-half.md). The first declarations
// in this library whose recursion reads **two** past values rather than one:
// `half(Succ(Succ(l)))` is `Succ(half(l))`, and the `l` it descends to is the
// predecessor's predecessor. That shape had no lowering until
// issues/recursion-at-deeper-subterms.md, and the spelling below is the one it
// was built for — nothing here is encoded around the recursion.
//
// `Even`/`Odd` are propositional and REDUCING, like `Le`
// (docs/nat-order-design.md §1): `Even(4)` unfolds to `True`, so the proof is
// `trivial`, and `¬ Even(7)` is the hypothesis itself. No `Bool` appears in the
// statement of any of it. The decision comes at the end, as `even_dec` and the
// class instance over it, exactly as the order's does.
//
// `Even(n) := ∃k, add(k, k) = n` is the mathematical definition and would
// check today, with no feature. It is not the definition here because it does
// not reduce; it is `half_add_half` and `even_double` below, which is the
// right relationship between the two.

fn half(n: Nat) → Nat {
    match n {
        Zero => 0,
        Succ(k) => match k { Zero => 0, Succ(l) => Succ(half(l)) },
    }
}

fn Even(n: Nat) → Type {
    match n {
        Zero => True,
        Succ(k) => match k { Zero => False, Succ(l) => Even(l) },
    }
}

fn Odd(n: Nat) → Type {
    match n {
        Zero => False,
        Succ(k) => match k { Zero => True, Succ(l) => Odd(l) },
    }
}

// Halving is bounded by the argument. Two-step induction, and the step is the
// only place a lemma appears: the goal at `Succ(Succ(l))` reduces to
// `Le(half(l), Succ(l))` and the IH gives `Le(half(l), l)`.
theorem half_le(n: Nat): half(n) <= n {
    match n {
        Zero => trivial,
        Succ(k) => match k { Zero => trivial, Succ(l) => le_succ_r(half(l), l, half_le(l)) },
    }
}

// Halving undoes doubling, and this one recurses **one** step, not two: it
// descends on `n` while the doubling supplies the two `Succ`s that let `half`
// take a step. The rewrite is `add_succ_left`, which is what turns
// `add(Succ l, l)` into a visible successor for `half` to consume.
theorem half_double(n: Nat): half(n + n) = n {
    match n {
        Zero => refl,
        Succ(l) =>
            apply trans;
            give cong_nat(λ (w: Nat) => half(Succ(w)), add_succ_left(l, l));
            cong_succ(half_double(l)),
    }
}

// Doubling is even — the same rewrite as `half_double`, transported instead of
// composed, because the conclusion is a proposition rather than an equation.
theorem even_double(n: Nat): Even(n + n) {
    match n {
        Zero => trivial,
        Succ(l) => j(sym(add_succ_left(l, l)), λ y q => Even(Succ(y)), even_double(l)),
    }
}

// Parity is total, and the step needs no repackaging for the reason `le_total`
// gave: `Even(Succ(Succ(l)))` and `Even(l)` are the SAME type, so the goal at
// the step and the IH's type are literally equal and the arm is the self-call.
theorem even_or_odd(n: Nat): Even(n) ∨ Odd(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k { Zero => Inr(trivial), Succ(l) => even_or_odd(l) },
    }
}

// And exclusive. Both base arms are a projection out of the conjunction — at
// `0` the right half is already `False`, at `1` the left half is — which is
// the same "the absurd case is the hypothesis" economy the order kit has.
theorem not_even_and_odd(n: Nat): ¬(Even(n) ∧ Odd(n)) {
    match n {
        Zero => λ (h: Even(0) ∧ Odd(0)) => h.right,
        Succ(k) => match k {
            Zero => λ (h: Even(1) ∧ Odd(1)) => h.left,
            Succ(l) => not_even_and_odd(l),
        },
    }
}

// The tie between the two halves of this section, and the reason they are one
// issue rather than two: on an even argument, halving is exactly invertible.
// Curried, so that the recursion descends on `n` alone and the hypothesis
// rides along as an argument (issues/ih-generalization.md's shape).
theorem half_add_half(n: Nat): Even(n) → half(n) + half(n) = n {
    match n {
        Zero => λ (h: Even(0)) => refl,
        Succ(k) => match k {
            Zero => λ (h: Even(1)) => false_elim(h),
            Succ(l) => (h: Even(Succ(Succ(l)))) ⊢
                apply trans;
                give cong_succ(add_succ_left(half(l), half(l)));
                cong_succ(cong_succ(half_add_half(l, h))),
        },
    }
}

// Halving reflects a doubled bound, which is the step of every recursion that
// consumes one binary digit per level (`bitvec::toNat_ofNat`): the argument
// loses a bit and the bound loses a factor of two. Stated at `p + p` rather
// than at `2 * p` because `add` is what `Le` cancels against structurally.
//
// Two steps on `x` and one on `p`; the only rewrite is `add_succ_left`, which
// turns the doubled successor bound into a visible one for `Le` to strip.
theorem half_lt_of_lt_double(x: Nat): (p: Nat) → x < p + p → half(x) < p {
    match x {
        Zero => λ p => match p {
            Zero => λ bad => false_elim(bad),
            Succ(_) => λ _ => trivial,
        },
        Succ(k) => match k {
            Zero => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(_) => λ _ => trivial,
            },
            Succ(l) => λ p => match p {
                Zero => λ bad => false_elim(bad),
                Succ(r) => λ h => half_lt_of_lt_double(l, r,
                    j(add_succ_left(r, r), λ y _ => Succ(l) < y, h)),
            },
        },
    }
}

// The decider, and a `fn` rather than a `theorem` for the reason `le_dec`
// carries: a `theorem` is opaque, so a decision spelled as one never unfolds
// in conversion and nothing built on it computes. `Even(1)` is `False`, so the
// refutation at the odd base is the identity.
fn even_dec(n: Nat) → Even(n) ∨ ¬Even(n) {
    match n {
        Zero => Inl(trivial),
        Succ(k) => match k {
            Zero => Inr(λ (bad: Even(1)) => bad),
            Succ(l) => even_dec(l),
        },
    }
}

// Value-generic in `n`, like the order's instance
// (docs/value-generic-instances-design.md): `n` is recovered by unifying
// `Even(n)` against the goal, so a use site writes nothing.
instance(n: Nat) Decide<Even(n)> { dec := even_dec(n) }

// ---------------------------------------------------------------------------
// The bridge between the Boolean decision and the propositional order. `leb`
// and `Le` are the same two-argument recursion written into `Bool` and into
// `Type`, so each direction is that recursion read twice; there is no
// arithmetic in either proof.
//
// A client that seals a validity witness as `IsTrue(leb(…))` — `char::scalar`
// is the first — states its bounds this way rather than with `Le` directly,
// and reads them back through these.

theorem leb_sound(n: Nat): (m: Nat) → IsTrue(leb(n, m)) → n <= m {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

theorem leb_complete(n: Nat): (m: Nat) → n <= m → IsTrue(leb(n, m)) {
    match n {
        Zero => λ m h => trivial,
        Succ(_, ih) => λ m => match m {
            Zero => λ h => false_elim(h),
            Succ(l) => λ h => ih(l, h),
        },
    }
}

// The order is total, so refuting `n < m` gives `m <= n`. Stated separately
// from `le_of_not_le` because a Boolean guard refutes the STRICT comparison:
// the failing branch of a `leb(Succ(n), m)` test is exactly this hypothesis.
theorem le_of_not_lt(n, m: Nat, h: ¬(n < m)): m <= n {
    or_resolve(le_dec(m, n), λ (k: ¬(m <= n)) => h(lt_of_not_le(n, m, k)))
}

// The same flip with both sides Boolean, which is the shape an encoder's
// range ladder hands its next rung: `n < m` came out `False`, so `m <= n`
// comes out `True`.
theorem leb_not_lt(n, m: Nat, h: IsTrue(not(leb(Succ(n), m)))): IsTrue(leb(m, n)) {
    leb_complete(m, n, le_of_not_lt(n, m,
        λ (k: n < m) => is_true_not(leb(Succ(n), m), h, leb_complete(Succ(n), m, k))))
}

// A rung's own test and the previous rung's lower bound cannot both come out
// `True`: `n < m` and `m <= n` together put `n` below itself. This is what
// refutes the rungs a known class did NOT take, when a ladder is read
// backwards (`utf8::width_of_bounds`).
theorem leb_lt_le_absurd(n, m: Nat, lt: IsTrue(leb(Succ(n), m)), le: IsTrue(leb(m, n))): False {
    lt_irrefl(n, le_trans(Succ(n), m, n, leb_sound(Succ(n), m, lt), leb_sound(m, n, le)))
}

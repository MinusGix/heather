// `nat` — arithmetic and the decided order on `Nat`
// (docs/modules-design.md §7). Every declaration here was local to
// `lib/ir_v1.hthr` until modules existed; the text is that text, moved.
//
// `Nat` itself is a kernel type and needs no declaration. What needs one is
// everything *about* it: addition (the spec function the IR is measured
// against), multiplication, truncated subtraction, and the order.
//
// The order used to be **decided** rather than declared — `Le(n, m)` was
// `leb(n)(m) = True` — because the surface cannot declare an indexed family
// and an equation was the only way to say a non-equational thing. Neither half
// of that reasoning survives (docs/nat-order-design.md, 2026-08-16): the
// relation is a plain recursion into `Type`, which needs no family, and it
// reduces at closed arguments, which is the whole benefit the equation was
// there for. `leb` stays, as a decision procedure and not as a specification.

import bool;
import logic;

// ---------------------------------------------------------------------------
// Addition and its two moving lemmas. `add` recurses on its SECOND argument,
// so the lemmas that matter are the ones that move a `Succ` — and a zero —
// across from the *left*.

fn add(a, b: Nat) -> Nat { match b { Zero => a, Succ(k) => Succ(add(a, k)) } }

theorem cong_nat(f: Nat -> Nat, {a, b: Nat}, p: a = b): f(a) = f(b) {
    j(p, λ y q => f(a) = f(y), refl)
}

theorem add_left_zero(x: Nat): add(0, x) = x {
    match x { Zero => refl, Succ(k) => cong_succ(add_left_zero(k)) }
}

theorem add_succ_left(a, b: Nat): add(Succ(a), b) = Succ(add(a, b)) {
    match b { Zero => refl, Succ(k) => cong_succ(add_succ_left(a, k)) }
}

// The two laws that make `add` a commutative monoid — asked for by the traits
// adoption round (2026-08-07), which registers `AddCommMonoid<Nat>` in
// `std/algebra` and needs exactly these as its fields. Both recurse on the
// argument `add` itself recurses on, so both are three lines.

theorem add_assoc(x, y, z: Nat): add(add(x, y), z) = add(x, add(y, z)) {
    match z { Zero => refl, Succ(k) => cong_succ(add_assoc(x, y, k)) }
}

theorem add_comm(x, y: Nat): add(x, y) = add(y, x) {
    match y {
        Zero => sym(add_left_zero(x)),
        Succ(k) => trans(cong_succ(add_comm(x, k)), sym(add_succ_left(k, x))),
    }
}

// ---------------------------------------------------------------------------
// Multiplication and its kit. `mul` recurses on its SECOND argument, like
// `add`, and the step puts the recursive result on the LEFT of the `add` —
// `add(mul(a, k), a)`, not `add(a, mul(a, k))`. That is the whole economy of
// this section, and it is the same choice `add` made one paragraph up: put the
// step's `add` on the argument `add` itself descends on, so that the zero
// side stays *definitional*. `mul(a, 0)` reduces to `Zero` and `add(x, 0)` to
// `x` with no lemma, so `mul(0, x) = 0` and the zero arm of distributivity are
// a self-call and a `refl` respectively. Spelled the other way round every
// proof below pays an `add_left_zero` rewrite it does not otherwise need.
//
// (`crates/elab/tests/certgen*.rs` has a `viaadd` fixture that IS spelled the
// other way. That is deliberate and unrelated: it is a *generator* fixture,
// pinned byte-for-byte, and it wants the cross-function call shape rather than
// the cheap lemma kit. Two different programs, so two different names.)

fn mul(a, b: Nat) -> Nat { match b { Zero => Zero, Succ(k) => add(mul(a, k), a) } }

// The right zero — `mul(x, 0) = 0` — needs no lemma. The left one does, and it
// is three lines because the step's `add(_, 0)` reduces away.
theorem mul_left_zero(x: Nat): mul(0, x) = 0 {
    match x { Zero => refl, Succ(k) => mul_left_zero(k) }
}

// The unit on the left, for the same reason: `add(mul(1, k), 1)` reduces to
// `Succ(mul(1, k))` on its own, so this is `add_left_zero`'s shape exactly.
theorem mul_left_one(x: Nat): mul(1, x) = x {
    match x { Zero => refl, Succ(k) => cong_succ(mul_left_one(k)) }
}

// `add_succ_left`'s counterpart: the lemma that moves a `Succ` across from the
// left. It is the one proof here that is not three lines, and every step of it
// is an `add` law — which is the point of proving `add`'s kit first.
theorem mul_succ_left(a, b: Nat): mul(Succ(a), b) = add(b, mul(a, b)) {
    match b {
        Zero => refl,
        Succ(k) => trans(
            cong_succ(trans(
                cong_nat(λ (w: Nat) => add(w, a), mul_succ_left(a, k)),
                add_assoc(k, mul(a, k), a),
            )),
            sym(add_succ_left(k, add(mul(a, k), a))),
        ),
    }
}

// Distributivity over the argument both functions recurse on. It comes before
// `mul_assoc` because `mul_assoc` *is* an instance of it, not the other way
// round — the associativity step rebuilds `mul(x, mul(y, Succ(k)))` as a sum
// and needs this to take it apart.
theorem mul_add_distr(a, b, c: Nat): mul(a, add(b, c)) = add(mul(a, b), mul(a, c)) {
    match c {
        Zero => refl,
        Succ(k) => trans(
            cong_nat(λ (w: Nat) => add(w, a), mul_add_distr(a, b, k)),
            add_assoc(mul(a, b), mul(a, k), a),
        ),
    }
}

// The two laws `std/algebra` registers `CommMonoid<Nat>(mul)` from, in the
// shape its fields want.

theorem mul_assoc(x, y, z: Nat): mul(mul(x, y), z) = mul(x, mul(y, z)) {
    match z {
        Zero => refl,
        Succ(k) => trans(
            cong_nat(λ (w: Nat) => add(w, mul(x, y)), mul_assoc(x, y, k)),
            sym(mul_add_distr(x, mul(y, k), y)),
        ),
    }
}

theorem mul_comm(x, y: Nat): mul(x, y) = mul(y, x) {
    match y {
        Zero => sym(mul_left_zero(x)),
        Succ(k) => trans(
            trans(
                cong_nat(λ (w: Nat) => add(w, x), mul_comm(x, k)),
                add_comm(mul(k, x), x),
            ),
            sym(mul_succ_left(k, x)),
        ),
    }
}

// ---------------------------------------------------------------------------
// The order, stated PROPOSITIONALLY (docs/nat-order-design.md §1). `<=` is
// surface notation for a call to `Le` and `<` for a call to `Lt`
// (issues/comparison-operators.md).
//
// Until 2026-08-16 this said `fn Le(n, m: Nat) -> Type { leb(n)(m) = True }` —
// a *reflection* of the Bool decision below. That spelling is retired
// (issues/class-ops-prop-vs-bool.md): the relation is stated once, as a
// recursion into `Type`, and no `= True` appears in a specification anywhere.
// What the reflection bought is not lost, because the recursion has it
// outright — `Le(3, 10)` REDUCES to `True`, so the proof is `trivial` and the
// kernel decides it by computing rather than by walking a derivation.
//
// Curried, and not by preference: the uncurried spelling is refused, because
// the inner `match` makes the recursive call vary both arguments and the guard
// requires the descending one to pass unchanged (issues/ih-generalization.md).
// `leb` and `sub` are curried for exactly this reason. Over-application means
// `Le(n, m)` still writes at every call site, and does below.
//
// Falsity is `logic::False`, which coexists with `bool::False` the constructor
// (issues/false-collides-with-bools-constructor.md). Two lines of this file
// hold both readings and neither is qualified.

fn Le(n: Nat) -> Nat -> Type {
    match n {
        Zero => λ (m: Nat) => True,
        Succ(k) => λ (m: Nat) => match m { Zero => False, Succ(l) => Le(k)(l) },
    }
}

// Strict order, as a definition and not a second recursion. `Lt(n, m)` is
// `Le(Succ(n), m)`, so everything `Le` computes `Lt` computes, and the two
// facts a reader most wants — `lt_succ_iff_le` and `lt_succ_self` — are
// definitional (see below). It is uncurried because it is not recursive, so
// nothing forces the shape.
fn Lt(n, m: Nat) -> Type { Le(Succ(n), m) }

// The decision procedure, kept. It is NOT part of the order's specification —
// nothing above mentions it and no lemma below is stated with it — and as of
// 2026-08-17 its last *specification* customer is gone too: `list_algos`'s
// insertion sort went propositional and decides with `le_dec`. What still reads
// `leb` is `certgen_code`, where a Boolean is the subject rather than the
// statement, which is exactly the role issues/class-ops-prop-vs-bool.md leaves
// `Bool` in.
fn leb(n: Nat) -> Nat -> Bool {
    match n {
        Zero => λ (m: Nat) => True,
        Succ(k) => λ (m: Nat) => match m { Zero => False, Succ(l) => leb(k)(l) },
    }
}

// truncated subtraction, curried because both arguments descend together
fn sub(m: Nat) -> Nat -> Nat {
    match m {
        Zero => λ (n: Nat) => Zero,
        Succ(m2) => λ (n: Nat) => match n { Zero => Succ(m2), Succ(n2) => sub(m2)(n2) },
    }
}

theorem sub_zero(m: Nat): sub(m)(0) = m {
    match m { Zero => refl, Succ(m2) => refl }
}

// ---------------------------------------------------------------------------
// The order kit. Read the bodies for what the definition gives away free:
// every fact about `Zero` on the left is `trivial`, every fact that moves a
// `Succ` across BOTH sides is the identity, and every absurd case is a
// hypothesis that already *is* `False`. Those three together are why this
// section has no inversion lemmas and no no-confusion machinery.

// `Zero` is below everything, by computation.
theorem zero_le(m: Nat): 0 <= m { trivial }

theorem le_refl(n: Nat): n <= n { match n { Zero => trivial, Succ(k) => le_refl(k) } }

// The one absurdity, and it is not proved so much as *named*: `Le(Succ n, 0)`
// unfolds to `False`, so the hypothesis is already the conclusion.
theorem not_succ_le_zero(n: Nat, h: Succ(n) <= 0): False { h }

// Both directions of the successor step, and both are the identity function —
// `Le(Succ n, Succ m)` and `Le(n, m)` are the same type. This is the
// definitional inversion the recursive definition is chosen for; stated as
// lemmas anyway, because the API is the kit and downstream never unfolds `Le`.
theorem le_succ_succ(n, m: Nat, h: n <= m): Succ(n) <= Succ(m) { h }
theorem le_of_succ_succ(n, m: Nat, h: Succ(n) <= Succ(m)): n <= m { h }

theorem le_succ_r(n: Nat): (m: Nat) -> n <= m -> n <= Succ(m) {
    match n as λ z => (m: Nat) -> Le(z, m) -> Le(z, Succ(m)) {
        Zero => λ m h => trivial,
        Succ(k, ih) => λ m h =>
            match m as λ y => Le(Succ(k), y) -> Le(Succ(k), Succ(y)) {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good => ih(m2, good),
            }(h),
    }
}

// Transitivity. Three nested case analyses and no arithmetic: the recursion is
// on the leftmost argument, and the two inner `match`es exist only to expose
// the successors that make the hypotheses reducible. Both inner motives convoy
// their hypotheses through, since neither `m` nor `l` is the scrutinee of the
// recursion that carries the IH.
theorem le_trans(n: Nat): (m: Nat) -> (l: Nat) -> n <= m -> m <= l -> n <= l {
    match n as λ z => (m: Nat) -> (l: Nat) -> Le(z, m) -> Le(m, l) -> Le(z, l) {
        Zero => λ m l h1 h2 => trivial,
        Succ(k, ih) => λ m l h1 h2 =>
            match m as λ y => Le(Succ(k), y) -> Le(y, l) -> Le(Succ(k), l) {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a b =>
                    match l as λ w => Le(Succ(m2), w) -> Le(Succ(k), w) {
                        Zero => λ bad => false_elim(bad),
                        Succ(l2) => λ c => ih(m2, l2, a, c),
                    }(b),
            }(h1, h2),
    }
}

theorem le_antisym(n: Nat): (m: Nat) -> n <= m -> m <= n -> n = m {
    match n as λ z => (m: Nat) -> Le(z, m) -> Le(m, z) -> z = m {
        Zero => λ m h1 h2 =>
            match m as λ y => Le(0, y) -> Le(y, 0) -> 0 = y {
                Zero => λ a b => refl,
                Succ(m2) => λ a bad => false_elim(bad),
            }(h1, h2),
        Succ(k, ih) => λ m h1 h2 =>
            match m as λ y => Le(Succ(k), y) -> Le(y, Succ(k)) -> Succ(k) = y {
                Zero => λ bad b => false_elim(bad),
                Succ(m2) => λ a b => cong_succ(ih(m2, a, b)),
            }(h1, h2),
    }
}

// Totality, and the successor case is where the definition pays again: the
// goal `Or<Le(Succ k, Succ m2), Le(Succ m2, Succ k)>` and the IH's
// `Or<Le(k, m2), Le(m2, k)>` are the SAME type, so the step is `ih(m2)` with
// no repackaging.
theorem le_total(n: Nat): (m: Nat) -> Or<Le(n, m), Le(m, n)> {
    match n as λ z => (m: Nat) -> Or<Le(z, m), Le(m, z)> {
        Zero => λ m => Inl(trivial),
        Succ(k, ih) => λ m =>
            match m as λ y => Or<Le(Succ(k), y), Le(y, Succ(k))> {
                Zero => Inr(trivial),
                Succ(m2) => ih(m2),
            },
    }
}

// The decider, and the instance that puts it in the class. It returns
// `P ∨ ¬P` and nothing else — no `Bool`, no bridge lemma — and it REDUCES at
// closed arguments, which is what lets `algebra`'s `max_of` compute.
//
// A `fn` and NOT a `theorem`, for exactly that reason: a `theorem` is opaque,
// so a decision spelled as one never unfolds in conversion and
// `max_of(2, 5) = 5` stops being `refl`. Deciding is computation, whatever it
// returns. Found by the kernel rejecting that very `refl` rather than by
// reasoning; `logic::or_pick` carries the same note for the same reason.
fn le_dec(n: Nat) -> (m: Nat) -> Or<Le(n, m), ¬ Le(n, m)> {
    match n as λ z => (m: Nat) -> Or<Le(z, m), Not(Le(z, m))> {
        Zero => λ m => Inl(trivial),
        Succ(k, ih) => λ m =>
            match m as λ y => Or<Le(Succ(k), y), Not(Le(Succ(k), y))> {
                Zero => Inr(λ (bad: Le(Succ(k), 0)) => bad),
                Succ(m2) => ih(m2),
            },
    }
}

// The order's `Decide` instance — generic in **both** of its values
// (docs/value-generic-instances-design.md, 2026-08-17). Until value binders
// existed the only registrable spelling was `Decide<Le(2, 5)>` at fixed
// numerals, which is precisely the case elaboration-time computation already
// answered; the open one, which is the only one a caller with variables in hand
// has, had no spelling at all.
//
// `n` and `m` are recovered by unifying `Le(n, m)` against the goal, so a use
// site writes neither: `decide<Le(x, h)>()` at open `x` and `h` resolves here.
// This is what lets `list_algos`'s `insert` decide through the class instead of
// naming `le_dec`, which is the measurement issues/value-generic-instances.md
// was filed to take.
instance(n, m: Nat) Decide<Le(n, m)> { dec := le_dec(n)(m) }

// ---------------------------------------------------------------------------
// The strict order. Every one of these is `Le`'s kit read at `Succ(n)`; the
// section is short because `Lt` is a definition rather than a second relation.

// `Lt(n, Succ n)` is `Le(Succ n, Succ n)` is `Le(n, n)`.
theorem lt_succ_self(n: Nat): n < Succ(n) { le_refl(n) }

// Both directions are the identity: `Lt(n, Succ m)` and `Le(n, m)` are one
// type. The `Iff` exists to be *cited*, not to do work.
theorem lt_succ_iff_le(n, m: Nat): Iff<Lt(n, Succ(m)), Le(n, m)> {
    Iff(λ (h: Lt(n, Succ(m))) => h, λ (h: Le(n, m)) => h)
}

// Irreflexivity, which is `Le(Succ n, n) -> False` and recurses to the base
// case `Le(1, 0)` — already `False`, so the whole proof is the recursion.
theorem lt_irrefl(n: Nat): ¬ Lt(n, n) {
    match n as λ z => Not(Lt(z, z)) {
        Zero => λ (h: Lt(0, 0)) => h,
        Succ(k, ih) => λ (h: Lt(Succ(k), Succ(k))) => ih(h),
    }
}

theorem le_of_lt(n: Nat): (m: Nat) -> n < m -> n <= m {
    match n as λ z => (m: Nat) -> Lt(z, m) -> Le(z, m) {
        Zero => λ m h => trivial,
        Succ(k, ih) => λ m h =>
            match m as λ y => Lt(Succ(k), y) -> Le(Succ(k), y) {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good => ih(m2, good),
            }(h),
    }
}

// Transitivity of `<` is transitivity of `<=` with one side weakened, and it
// is worth seeing why that is enough: `Lt(n, m)` IS `Le(Succ n, m)`, so the
// chain `Succ(n) <= m <= l` is already the goal.
theorem lt_trans(n, m, l: Nat, h1: n < m, h2: m < l): n < l {
    le_trans(Succ(n))(m, l, h1, le_of_lt(m)(l, h2))
}

theorem lt_of_le_of_ne(n: Nat): (m: Nat) -> n <= m -> ¬ (n = m) -> n < m {
    match n as λ z => (m: Nat) -> Le(z, m) -> Not(z = m) -> Lt(z, m) {
        Zero => λ m h hne =>
            match m as λ y => Not(0 = y) -> Lt(0, y) {
                Zero => λ ne => false_elim(ne(refl)),
                Succ(m2) => λ ne => trivial,
            }(hne),
        Succ(k, ih) => λ m h hne =>
            match m as λ y => Le(Succ(k), y) -> Not(Succ(k) = y) -> Lt(Succ(k), y) {
                Zero => λ bad ne => false_elim(bad),
                Succ(m2) => λ a ne =>
                    ih(m2, a, λ (e: k = m2) => ne(cong_succ(e))),
            }(h, hne),
    }
}

// Trichotomy. Nested `Or` rather than a three-constructor inductive, because
// the connective is what `logic` gives and a bespoke type would need its own
// eliminator for no gain. The successor step is again a re-use of the IH at
// the same type, once for each of its three arms.
theorem lt_trichotomy(n: Nat): (m: Nat) -> Or<Lt(n, m), Or<n = m, Lt(m, n)>> {
    match n as λ z => (m: Nat) -> Or<Lt(z, m), Or<z = m, Lt(m, z)>> {
        Zero => λ m =>
            match m as λ y => Or<Lt(0, y), Or<0 = y, Lt(y, 0)>> {
                Zero => Inr(Inl(refl)),
                Succ(m2) => Inl(trivial),
            },
        Succ(k, ih) => λ m =>
            match m as λ y => Or<Lt(Succ(k), y), Or<Succ(k) = y, Lt(y, Succ(k))>> {
                Zero => Inr(Inr(trivial)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(a) => Inl(a),
                        Inr(r) => match r {
                            Inl(e) => Inr(Inl(cong_succ(e))),
                            Inr(b) => Inr(Inr(b)),
                        },
                    },
            },
    }
}

// A refuted comparison is the other one holding — totality, read backwards.
// This is the propositional successor of `list_algos`'s `leb_false_flip`, and
// the difference is the whole of what going propositional buys: that lemma was
// an induction on `x` with `y` generalized, ending in `leb(y, x) = True`;
// this one is `le_total` with the refuted side resolved away, and it is a line.
theorem le_of_not_le(n, m: Nat, h: ¬ Le(n, m)): Le(m, n) {
    or_resolve(or_swap(le_total(n)(m)), h)
}

// ---------------------------------------------------------------------------
// Equality at `Nat`, and its decision (issues/std-api-waves.md wave 2).
//
// The two no-confusion facts first, and they are proved by RECURSION rather
// than by `inj`/`absurd`. Those two special forms want "an equation at a
// declared inductive type" and `Nat` is a *kernel* type with no declaration —
// so the constructor-injectivity and constructor-disjointness that every
// declared inductive gets generated for it have to be written by hand here,
// once. Each is one auxiliary function on `Nat` and a `j` along it:
//
//   - injectivity is `pred`, which undoes `Succ` definitionally, so `cong_nat`
//     is the whole proof and the statement holds by conversion;
//   - disjointness is a predicate that *separates* the constructors, so
//     transporting its inhabitant along the absurd equation lands in `False`.
//
// This is the small tax `Nat`-as-a-kernel-type charges, and it is worth naming
// because nothing else in the library pays it.

fn pred(n: Nat) -> Nat { match n { Zero => 0, Succ(k) => k } }

theorem succ_inj(n, m: Nat, h: Succ(n) = Succ(m)): n = m { cong_nat(pred, h) }

// `IsSucc(Succ k)` is `True` and `IsSucc(0)` is `False`, so the constructors
// are told apart by a type rather than by a generated no-confusion lemma.
fn IsSucc(n: Nat) -> Type { match n { Zero => False, Succ(k) => True } }

theorem succ_ne_zero(n: Nat): ¬ (Succ(n) = 0) {
    λ (h: Succ(n) = 0) => j(h, λ y q => IsSucc(y), trivial)
}

theorem zero_ne_succ(n: Nat): ¬ (0 = Succ(n)) {
    λ (h: 0 = Succ(n)) => succ_ne_zero(n)(sym(h))
}

// The equality decider, mirroring `le_dec` exactly — same shape, same reason to
// be a `fn` rather than a `theorem` (it has to reduce), same curried spelling
// (both arguments descend together, so the guard refuses the uncurried one).
//
// It is NOT registered as a `Decide` instance, and that is a language boundary
// rather than a choice: an instance is keyed on its carrier's head, and an
// equation has no head to key on — one reserved key would collide `n = m` at
// `Nat` with every other type's equality. That is the one case of this round
// that genuinely wants layer 2's (class, carrier-syntax) key
// (issues/decidable-equation-carrier.md). Until then `eq_dec` is called by
// name, which is what every consumer here does anyway.
fn eq_dec(n: Nat) -> (m: Nat) -> Or<n = m, ¬ (n = m)> {
    match n as λ z => (m: Nat) -> Or<z = m, Not(z = m)> {
        Zero => λ m =>
            match m as λ y => Or<0 = y, Not(0 = y)> {
                Zero => Inl(refl),
                Succ(m2) => Inr(zero_ne_succ(m2)),
            },
        Succ(k, ih) => λ m =>
            match m as λ y => Or<Succ(k) = y, Not(Succ(k) = y)> {
                Zero => Inr(succ_ne_zero(k)),
                Succ(m2) =>
                    match ih(m2) {
                        Inl(e) => Inl(cong_succ(e)),
                        Inr(ne) => Inr(λ (bad: Succ(k) = Succ(m2)) => ne(succ_inj(k, m2, bad))),
                    },
            },
    }
}

// ---------------------------------------------------------------------------
// The bridge to addition — route (c) of docs/nat-order-design.md §1, proved
// rather than chosen. `le_add` is the forward half and was already here.

// `Le(n, m)` gives the difference. Induction on `n` with `m` generalized.
theorem le_add(n: Nat): (m: Nat) -> n <= m -> add(n, sub(m)(n)) = m {
    match n as λ z => (m: Nat) -> Le(z, m) -> add(z, sub(m)(z)) = m {
        Zero => λ m hle =>
            trans(cong_nat(λ (x: Nat) => add(0, x), sub_zero(m)), add_left_zero(m)),
        Succ(n2, ih) => λ m hle =>
            match m as λ y => Le(Succ(n2), y) -> add(Succ(n2), sub(y)(Succ(n2))) = y {
                Zero => λ bad => false_elim(bad),
                Succ(m2) => λ good =>
                    trans(add_succ_left(n2, sub(m2)(n2)), cong_succ(ih(m2, good))),
            }(hle),
    }
}

// Two values compared by raising both to `n + m`, which is above each of them.

theorem le_add_l(n, m: Nat): n <= add(n, m) {
    match m { Zero => le_refl(n), Succ(m2) => le_succ_r(n)(add(n, m2), le_add_l(n, m2)) }
}

// `add` recurses on its second argument, so this one is the definitional side
theorem le_add_r(n, m: Nat): m <= add(n, m) {
    match m { Zero => trivial, Succ(m2) => le_add_r(n, m2) }
}

// The bridge itself: `n <= m` and `∃ k, n + k = m` are interchangeable. The
// forward direction is `le_add` with its witness named; the backward one is
// `le_add_l` transported along the caller's equation. Route (c) of the design
// is therefore available as a *view* at every call site, without being the
// definition — which is what makes the definition swappable later.
theorem le_iff_exists_add(n, m: Nat): Iff<Le(n, m), Exists(λ (k: Nat) => add(n, k) = m)> {
    Iff(
        λ (h: Le(n, m)) => Exists(sub(m)(n), le_add(n)(m, h)),
        λ (h: Exists(λ (k: Nat) => add(n, k) = m)) =>
            j(h.proof, λ y q => Le(n, y), le_add_l(n, h.witness)),
    )
}

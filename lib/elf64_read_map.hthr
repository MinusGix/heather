// A read loop that writes (docs/native-tr-design.md): read stdin a page at a
// time, translate each chunk in place with a byte map, write it to stdout,
// and go back to the read; exit 0 at the empty read. Failed reads and writes
// are elf64_read_pieces's and elf64_write_loop's: EINTR retries, anything
// else exits 1. The byte map is the program's, a certified piece of
// structured code (`MapPiece`); the loop around it, the process and the
// claim are proved here once. Nothing is carried across chunks, so the claim
// has no bound on the input.
import elf64_write_loop;
import elf64_print_pieces;
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_structured_block;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The byte map: from its first byte with the byte in RAX, its code runs to
// its end with the mapped byte in RDX, memory untouched. It writes only its
// scratch, so the loop's five registers (RSI, RCX, R9–R11) are kept.

fn map_scratch() → List<Gpr> { [Rdx, Rbx, Rdi, R8] }
fn MapPiece(f: BitVec(8) → BitVec(8), code: StructuredCode) → Type {
    Computes<IoMemory, BitVec(8)>(code, λ b g => b.zero_extend(56) = read_gpr(Rax, g), Rdx, λ b => f(b).zero_extend(56), map_scratch())
}

// ---------------------------------------------------------------------------
// The code.

// After a read of n > 0 bytes: the cursor at the page, n to go, the page and
// n again for the write loop, and the step's 1.
fn map_setup_block() → List<Instruction> {
    [MovRI(Rsi, BitVec::ofNat(io_page_base())), MovRI(R9, BitVec::ofNat(io_page_base())), MovRR(Rcx, Rax), MovRR(R10, Rax),
     MovRI(R11, BitVec::ofNat(1))]
}
fn map_load() → ByteLoad { ByteLoad(destination := Rax, base := Rsi) }
fn map_store() → ByteStore { ByteStore(base := Rsi, source := Rdx) }
// The cursor on, one fewer to go; ZF says whether none is.
fn map_step_block() → List<Instruction> { [AddRR(Rsi, R11), SubRR(Rcx, R11)] }

fn map_setup_len() → Nat { canonical_block_bytes(map_setup_block()).len() }
fn map_load_len() → Nat { byte_load_bytes(map_load()).len() }
fn map_step_len() → Nat { canonical_block_bytes(map_step_block()).len() }

// The jumps: JZ to exit(0) at end of file, JS to the failure path, JNZ back
// to the next byte, JZ back to the read after EINTR.
record MapJumps { ed: BitVec(32), sd: BitVec(32), ld: BitVec(32), rd: BitVec(32) }

// The program: the read head (elf64_read_pieces), the setup, the loop over
// the chunk (load, map, store, step, JNZ), the write loop (whose end jumps
// back to the read and whose exit(0) ends the run), then the failure tail. A
// layout (x86_64_layout) whose byte map is measured by its length `p`.
fn map_parts(code: StructuredCode, jumps: MapJumps, pj: PrintJumps) → List<List<BitVec(8)>> {
    [read_head_code(jumps.ed, jumps.sd), canonical_block_bytes(map_setup_block()), byte_load_bytes(map_load()), structured_bytes(code),
     byte_store_bytes(map_store()), canonical_block_bytes(map_step_block()), near_control_bytes(JumpIfNear(NE, jumps.ld)), write_loop_code(pj)]
}
fn map_lens(p: Nat) → List<Nat> { [read_head_len(), map_setup_len(), map_load_len(), p, 3, map_step_len(), 6, write_loop_len()] }
fn map_code(code: StructuredCode, jumps: MapJumps, pj: PrintJumps) → List<BitVec(8)> {
    layout_code(map_parts(code, jumps, pj), fail_tail_code(jumps.rd))
}
theorem map_measured(code: StructuredCode, jumps: MapJumps, pj: PrintJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    LayoutMeasured(map_parts(code, jumps, pj), map_lens(p)) {
    ⟨read_head_code_len(jumps.ed, jumps.sd), ⟨refl, ⟨refl, ⟨p_is, ⟨refl, ⟨refl, ⟨refl, ⟨write_loop_code_len(pj), trivial⟩⟩⟩⟩⟩⟩⟩⟩
}
// The code's length from the byte map's, over open parts.
theorem map_code_len(code: StructuredCode, jumps: MapJumps, pj: PrintJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    map_code(code, jumps, pj).len() = layout_end(0, map_lens(p)) + fail_tail_len() {
    layout_len(map_parts(code, jumps, pj), fail_tail_code(jumps.rd), map_lens(p), map_measured(code, jumps, pj, p, p_is), fail_tail_len(),
        fail_tail_code_len(jumps.rd))
}

// Where each piece starts, from the entry, for a byte map `p` bytes long.
fn map_at(p, i: Nat) → Nat { layout_at(0, map_lens(p), i) }
fn map_at_read(p: Nat) → Nat { map_at(p, 0) }
fn map_at_setup(p: Nat) → Nat { map_at(p, 1) }
fn map_at_load(p: Nat) → Nat { map_at(p, 2) }
fn map_at_piece(p: Nat) → Nat { map_at(p, 3) }
fn map_at_store(p: Nat) → Nat { map_at(p, 4) }
fn map_at_step(p: Nat) → Nat { map_at(p, 5) }
fn map_at_jnz(p: Nat) → Nat { map_at(p, 6) }
fn map_at_write(p: Nat) → Nat { map_at(p, 7) }
fn map_at_failed(p: Nat) → Nat { map_at(p, 8) }
fn map_at_retry(p: Nat) → Nat { ft_at_jz(map_at_failed(p)) }

// ---------------------------------------------------------------------------
// One byte stored into the page.

theorem store_byte_here(memory: IoMemory, i: Nat, x: BitVec(8)): io_store_offset(memory, i, [x]).page(i) = x {
    let reached = eq_true_of_is_true(i.leb(i), Nat::leb_complete(i, i, i.le_refl()));
    j(sym(reached), λ c _ => (match c {
            False => memory.page(i),
            True => match List::nth<BitVec(8)>([x], i -i) { None => memory.page(i), Some(byte) => byte },
        }) = x,
        j(sym(Nat::sub_self(i)), λ d _ => (match List::nth<BitVec(8)>([x], d) { None => memory.page(i), Some(byte) => byte }) = x, refl))
}

theorem store_byte_other(memory: IoMemory, i: Nat, x: BitVec(8), k: Nat, other: Not(k = i)):
    io_store_offset(memory, i, [x]).page(k) = memory.page(k) {
    (match i.leb(k) as λ c => (i.leb(k) = c) → (match c {
            False => memory.page(k),
            True => match List::nth<BitVec(8)>([x], k -i) { None => memory.page(k), Some(byte) => byte },
        }) = memory.page(k) {
        False => λ _ => refl,
        True => λ below => {
            let le: (i <= k) = Nat::leb_sound(i, k, j(sym(below), λ c _ => c.IsTrue(), trivial));
            (match k -i as λ d => (k -i = d) → (match List::nth<BitVec(8)>([x], d) { None => memory.page(k), Some(byte) => byte }) = memory.page(k) {
                Zero => λ none => {
                    let back: ((k -i) + i = k) = Nat::sub_add_cancel(i, k, le);
                    false_elim(other({ omega }))
                },
                Succ(_) => λ _ => refl,
            })(refl)
        },
    })(refl)
}

// A byte store at the page's i-th byte is a store at offset i.
theorem store_at_offset(memory: IoMemory, address: BitVec(64), i: Nat, bytes: List<BitVec(8)>,
    at: address.toNat() = io_page_base() + i): io_store(memory, address, bytes) = io_store_offset(memory, i, bytes) {
    cong_fn<Nat, IoMemory>(λ offset => io_store_offset(memory, offset, bytes),
        trans(cong_fn<Nat, Nat>(λ a => a -io_page_base(), at),
            trans(cong_fn<Nat, Nat>(λ a => a -io_page_base(), Nat::add_comm(io_page_base(), i)), Nat::add_sub_cancel(i, io_page_base()))))
}

// The page read at an address in it.
theorem read_in_page(file: List<BitVec(8)>, page: Nat → BitVec(8), address: BitVec(64), i: Nat, inside: i < 4096,
    at: address.toNat() = io_page_base() + i): io_read(IoMemory(file, page), address) = Some(page(i)) {
    j(sym(trans(cong_fn<Nat, Option<Nat>>(λ a => io_offset_of(a), at), io_offset_in_page(i, inside))),
        λ found _ => (match found {
            Some(k) => Some(page(k)),
            None => io_file_read(file, address),
        }) = Some(page(i)), refl)
}

// The low byte of a zero-extended byte is the byte.
theorem low_of_extended(x: BitVec(8)): imm_byte0(x.zero_extend(56)) = x {
    BitVec::split_concat_low(8, 56, x, BitVec::zero())
}

// What a mapped list holds at `i`.
theorem nth_map_of<A, B>(f: A → B, xs: List<A>): (i: Nat) → (y: B) → xs.map(f).nth(i) = Some(y) →
    Exists<A>(λ x => (xs.nth(i) = Some(x)) ∧ (y = f(x))) {
    match xs as λ ys => (i: Nat) → (y: B) → ys.map(f).nth(i) = Some(y) → Exists<A>(λ x => (ys.nth(i) = Some(x)) ∧ (y = f(x))) {
        Nil => λ i y none => false_elim(j(none, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
        Cons(h, t) => λ i => match i as λ k => (y: B) → Cons(h, t).map(f).nth(k) = Some(y) →
                Exists<A>(λ x => (Cons(h, t).nth(k) = Some(x)) ∧ (y = f(x))) {
            Zero => λ y found => Exists(h, ⟨refl, sym(Option::some_inj(f(h), y, found))⟩),
            Succ(k) => λ y found => nth_map_of(f, t, k, y, found),
        },
    }
}

// ---------------------------------------------------------------------------
// The pieces, resident at their offsets.

record MapPieces(memory: IoMemory, code: StructuredCode, jumps: MapJumps, pj: PrintJumps) {
    head: ReadHead(memory, map_at_read(structured_bytes(code).len()), jumps.ed, jumps.sd),
    setup_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(map_setup_block()), eof_rip(map_at_setup(structured_bytes(code).len()))),
    load_at: CodeResident(io_fetch_access(), memory, byte_load_bytes(map_load()), eof_rip(map_at_load(structured_bytes(code).len()))),
    piece_at: CodeResident(io_fetch_access(), memory, structured_bytes(code), eof_rip(map_at_piece(structured_bytes(code).len()))),
    store_at: CodeResident(io_fetch_access(), memory, byte_store_bytes(map_store()), eof_rip(map_at_store(structured_bytes(code).len()))),
    step_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(map_step_block()), eof_rip(map_at_step(structured_bytes(code).len()))),
    jnz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpIfNear(NE, jumps.ld)), eof_rip(map_at_jnz(structured_bytes(code).len()))),
    write: WriteLoopResident(memory, map_at_write(structured_bytes(code).len()), pj),
    fail: FailTail(memory, map_at_failed(structured_bytes(code).len()), jumps.rd),
}

theorem map_pieces(memory: IoMemory, code: StructuredCode, jumps: MapJumps, pj: PrintJumps,
    resident: CodeResident(io_fetch_access(), memory, map_code(code, jumps, pj), io_entry())):
    MapPieces(memory, code, jumps, pj) {
    let p = structured_bytes(code).len();
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), fail_tail_code(jumps.rd), map_parts(code, jumps, pj), map_lens(p),
        map_measured(code, jumps, pj, p, refl), 0, resident);
    MapPieces(read_head(memory, map_at_read(p), jumps.ed, jumps.sd, piece(0)), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6),
        write_loop_resident(memory, map_at_write(p), pj, piece(7)), fail_tail(memory, map_at_failed(p), jumps.rd, piece(8)))
}

// ---------------------------------------------------------------------------
// The loop over one chunk.

// Some byte is at every index below the length.
theorem nth_below<A>(xs: List<A>): (i: Nat) → i < xs.len() → Exists<A>(λ x => xs.nth(i) = Some(x)) {
    match xs as λ ys => (i: Nat) → i < ys.len() → Exists<A>(λ x => ys.nth(i) = Some(x)) {
        Nil => λ i below => false_elim(below),
        Cons(h, t) => λ i => match i as λ k => k < Cons(h, t).len() → Exists<A>(λ x => Cons(h, t).nth(k) = Some(x)) {
            Zero => λ _ => Exists(h, refl),
            Succ(k) => λ below => nth_below(t, k, below),
        },
    }
}

// The arithmetic of one byte, over Nats.
theorem map_inside(i, rest, n: Nat, count: i + Succ(rest) = n, fits: n <= 4096): i < 4096 { omega }
theorem map_low(i: Nat, inside: i < 4096): io_page_base() + i < Nat::pow(2, 47) {
    let page: (io_page_base() + 4096 <= Nat::pow(2, 47)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial);
    omega
}
theorem map_word(i: Nat, inside: i < 4096): Succ(io_page_base() + i) < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}
theorem map_writable(i: Nat, inside: i < 4096):
    (io_page_base() <= io_page_base() + i) ∧ ((io_page_base() + i) + 1 <= io_page_base() + 4096) { ⟨omega, omega⟩ }
theorem map_count_left(c, i, rest, n: Nat, counted: c + i = n, count: i + Succ(rest) = n): 1 <= c { omega }
theorem map_count_next(c, d, i, rest, n: Nat, counted: c + i = n, count: i + Succ(rest) = n, less: d = c -1): (d = rest) ∧ (d + Succ(i) = n) {
    let back: ((c -1) + 1 = c) = Nat::sub_add_cancel(1, c, { omega });
    ⟨omega, omega⟩
}
theorem map_next_byte(j, i: Nat, below: j < Succ(i), other: Not(j = i)): j < i { Nat::lt_of_le_of_ne(j, i, { omega }, other) }
theorem map_past_byte(j, i: Nat, past: Succ(i) <= j): (i <= j) ∧ Not(j = i) {
    ⟨omega, λ same => { let x: (j = i) = same; let never: (Succ(j) <= j) = j(sym(x), λ k _ => Succ(k) <= j, past); false_elim(Nat::lt_irrefl(j, never)) }⟩
}

// At `at` with `i` bytes of the chunk mapped: the page holds their images
// and then the rest of the chunk, RSI is at byte `i`, RCX counts what is
// left, and R9, R10 and R11 hold what the write loop and the step need.
record MapAt(f: BitVec(8) → BitVec(8), file, bytes: List<BitVec(8)>, i, at: Nat, state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = eof_rip(at),
    mapped: (j: Nat) → (b: BitVec(8)) → bytes.nth(j) = Some(b) → j < i → page(j) = f(b),
    left: (j: Nat) → (b: BitVec(8)) → bytes.nth(j) = Some(b) → i <= j → page(j) = b,
    cursor: read_gpr(Rsi, state.gprs).toNat() = io_page_base() + i,
    count: read_gpr(Rcx, state.gprs).toNat() + i = bytes.len(),
    base: read_gpr(R9, state.gprs).toNat() = io_page_base(),
    length: read_gpr(R10, state.gprs).toNat() = bytes.len(),
    one: read_gpr(R11, state.gprs) = BitVec::ofNat(1),
}

// Byte `i` loaded and mapped: the image in RDX, memory untouched, the
// loop's registers kept, at the store.
record MapLoaded(f: BitVec(8) → BitVec(8), code: StructuredCode, byte: BitVec(8), state, loaded: MachineState<IoMemory>) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), state, loaded),
    memory_is: loaded.memory = state.memory,
    rip_is: loaded.rip = eof_rip(map_at_store(structured_bytes(code).len())),
    image: read_gpr(Rdx, loaded.gprs) = f(byte).zero_extend(56),
    rsi: read_gpr(Rsi, loaded.gprs) = read_gpr(Rsi, state.gprs),
    rcx: read_gpr(Rcx, loaded.gprs) = read_gpr(Rcx, state.gprs),
    r9: read_gpr(R9, loaded.gprs) = read_gpr(R9, state.gprs),
    r10: read_gpr(R10, loaded.gprs) = read_gpr(R10, state.gprs),
    r11: read_gpr(R11, loaded.gprs) = read_gpr(R11, state.gprs),
}

theorem map_fetched(f: BitVec(8) → BitVec(8), code: StructuredCode, piece: MapPiece(f, code),
    jumps: MapJumps, pj: PrintJumps, file, bytes: List<BitVec(8)>, i: Nat, inside: i < 4096, b: BitVec(8), at_byte: bytes.nth(i) = Some(b),
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    state: MachineState<IoMemory>, head: MapAt(f, file, bytes, i, map_at_load(structured_bytes(code).len()), state)):
    Exists<MachineState<IoMemory>>(λ loaded => MapLoaded(f, code, b, state, loaded)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let here = pieces(head.page);
    let rsi = read_gpr(Rsi, state.gprs);
    let loaded: (head.page(i) = b) = head.left(i, b, at_byte, i.le_refl());
    let present: (io_data_access().read(state.memory, rsi) = Some(b)) =
        j(sym(head.memory_is), λ m _ => io_read(m, rsi) = Some(b),
            trans(read_in_page(file, head.page, rsi, i, inside, head.cursor), cong_fn<BitVec(8), Option<BitVec(8)>>(λ x => Some(x), loaded)));
    let canonical: (rsi.drop_low(47, 17) = BitVec::zero()) =
        BitVec::drop_low_zero_of_lt(47, 17, rsi, j(sym(head.cursor), λ v _ => v < Nat::pow(2, 47), map_low(i, inside)));
    let s1 = byte_load_after(map_load(), b, state);
    let load_step: FetchedStep(fetch, data, state, s1) = Exists(EmitLoad(map_load()),
        ⟨FetchedFrom(resident_readable(fetch, state.memory, byte_load_bytes(map_load()), state.rip,
            resident_state(fetch, byte_load_bytes(map_load()), IoMemory(file, head.page), eof_rip(map_at_load(structured_bytes(code).len())), state, head.memory_is, head.rip_is,
                here.load_at))),
         Exists(b, ByteLoadStep(canonical := canonical, present := present, execution := refl))⟩);
    let s1_rip: (s1.rip = eof_rip(map_at_piece(structured_bytes(code).len()))) = rip_advance(entry, state.rip, map_at_load(structured_bytes(code).len()), map_load_len(), head.rip_is);
    have artifact = piece(s1, b, refl);
    let ran: PieceRan(IoMemory(file, head.page), map_at_store(structured_bytes(code).len()), s1, artifact.after) =
        piece_runs(artifact, IoMemory(file, head.page), map_at_piece(structured_bytes(code).len()), here.piece_at, head.memory_is, s1_rip);
    Exists(artifact.after, MapLoaded(
        steps := fetched_steps_cons(fetch, data, state, s1, artifact.after, load_step, ran.steps),
        memory_is := artifact.memory_preserved,
        rip_is := ran.rip,
        image := artifact.result_correct,
        rsi := artifact.registers_preserved(Rsi, trivial),
        rcx := artifact.registers_preserved(Rcx, trivial),
        r9 := artifact.registers_preserved(R9, trivial),
        r10 := artifact.registers_preserved(R10, trivial),
        r11 := artifact.registers_preserved(R11, trivial)))
}

// The image stored over byte `i`.
record MapStored(code: StructuredCode, file: List<BitVec(8)>, page: Nat → BitVec(8), loaded, stored: MachineState<IoMemory>) {
    step: StoreStep(io_fetch_access(), linux_writes(io_linux()), loaded, stored),
    memory_is: stored.memory = IoMemory(file, page),
    rip_is: stored.rip = eof_rip(map_at_step(structured_bytes(code).len())),
    gprs_is: stored.gprs = loaded.gprs,
    flags_is: stored.flags = loaded.flags,
}

theorem map_stored(f: BitVec(8) → BitVec(8), code: StructuredCode, jumps: MapJumps, pj: PrintJumps, file: List<BitVec(8)>,
    page: Nat → BitVec(8), i: Nat, inside: i < 4096, b: BitVec(8),
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    loaded: MachineState<IoMemory>, memory_is: loaded.memory = IoMemory(file, page), rip_is: loaded.rip = eof_rip(map_at_store(structured_bytes(code).len())),
    at: read_gpr(Rsi, loaded.gprs).toNat() = io_page_base() + i, image: read_gpr(Rdx, loaded.gprs) = f(b).zero_extend(56)):
    Exists<MachineState<IoMemory>>(λ stored => MapStored(code, file, io_store_offset(IoMemory(file, page), i, [f(b)]).page, loaded, stored)) {
    let fetch = io_fetch_access();
    let writes = linux_writes(io_linux());
    let entry = io_entry();
    let memory = IoMemory(file, page);
    let room = map_writable(i, inside);
    let writable: IoWritable(loaded.memory, read_gpr(Rsi, loaded.gprs), 1) =
        ⟨j(sym(at), λ v _ => io_page_base() <= v, room.left), j(sym(at), λ v _ => v + 1 <= io_page_base() + 4096, room.right)⟩;
    let stored = byte_store_after(writes, map_store(), loaded);
    let low: (imm_byte0(read_gpr(Rdx, loaded.gprs)) = f(b)) =
        trans(cong_fn<BitVec(64), BitVec(8)>(λ v => imm_byte0(v), image), low_of_extended(f(b)));
    Exists(stored, MapStored(
        step := byte_store_step(fetch, writes, map_store(), loaded, refl,
            FetchedFrom(resident_readable(fetch, loaded.memory, byte_store_bytes(map_store()), loaded.rip,
                resident_state(fetch, byte_store_bytes(map_store()), memory, eof_rip(map_at_store(structured_bytes(code).len())), loaded, memory_is, rip_is,
                    pieces(page).store_at))),
            writable),
        memory_is := trans(cong_fn<IoMemory, IoMemory>(λ m => io_store(m, read_gpr(Rsi, loaded.gprs), [imm_byte0(read_gpr(Rdx, loaded.gprs))]), memory_is),
            trans(cong_fn<BitVec(8), IoMemory>(λ x => io_store(memory, read_gpr(Rsi, loaded.gprs), [x]), low),
                store_at_offset(memory, read_gpr(Rsi, loaded.gprs), i, [f(b)], at))),
        rip_is := rip_advance(entry, loaded.rip, map_at_store(structured_bytes(code).len()), 3, rip_is),
        gprs_is := refl,
        flags_is := refl))
}

// The page after the store: byte `i`'s image, then the rest as before.
theorem map_page_mapped(f: BitVec(8) → BitVec(8), bytes: List<BitVec(8)>, memory: IoMemory, i: Nat, b: BitVec(8),
    at_byte: bytes.nth(i) = Some(b),
    mapped: (j: Nat) → (c: BitVec(8)) → bytes.nth(j) = Some(c) → j < i → memory.page(j) = f(c)):
    (j: Nat) → (c: BitVec(8)) → bytes.nth(j) = Some(c) → j < Succ(i) → io_store_offset(memory, i, [f(b)]).page(j) = f(c) {
    λ j c at_j below => (match Nat::eq_dec(j, i) as λ _ => io_store_offset(memory, i, [f(b)]).page(j) = f(c) {
        Inl(same) => {
            let same_byte: (c = b) = Option::some_inj(c, b, trans(sym(at_j), j(sym(same), λ k _ => bytes.nth(k) = Some(b), at_byte)));
            trans(j(sym(same), λ k _ => io_store_offset(memory, i, [f(b)]).page(k) = f(b), store_byte_here(memory, i, f(b))),
                cong_fn<BitVec(8), BitVec(8)>(λ x => f(x), sym(same_byte)))
        },
        Inr(other) => trans(store_byte_other(memory, i, f(b), j, other), mapped(j, c, at_j, map_next_byte(j, i, below, other))),
    })
}
theorem map_page_left(bytes: List<BitVec(8)>, memory: IoMemory, i: Nat, x: BitVec(8),
    left: (j: Nat) → (c: BitVec(8)) → bytes.nth(j) = Some(c) → i <= j → memory.page(j) = c):
    (j: Nat) → (c: BitVec(8)) → bytes.nth(j) = Some(c) → Succ(i) <= j → io_store_offset(memory, i, [x]).page(j) = c {
    λ j c at_j past => {
        let apart = map_past_byte(j, i, past);
        trans(store_byte_other(memory, i, x, j, apart.right), left(j, c, at_j, apart.left))
    }
}

// One byte: load it, map it, store the image over it, step. ZF says whether
// the chunk is done.
theorem map_byte(f: BitVec(8) → BitVec(8), code: StructuredCode, piece: MapPiece(f, code),
    jumps: MapJumps, pj: PrintJumps, file, bytes: List<BitVec(8)>, fits: bytes.len() <= 4096, i, rest: Nat,
    counting: i + Succ(rest) = bytes.len(),
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    state: MachineState<IoMemory>, head: MapAt(f, file, bytes, i, map_at_load(structured_bytes(code).len()), state)):
    Exists<MachineState<IoMemory>>(λ body => LinuxSteps(io_linux(), state, body) ∧
        (MapAt(f, file, bytes, Succ(i), map_at_jnz(structured_bytes(code).len()), body) ∧ (body.flags.zf = is_zero_bits(64, read_gpr(Rcx, body.gprs))))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let inside = map_inside(i, rest, bytes.len(), counting, fits);
    have found = nth_below(bytes, i, { omega });
    let b = found.witness;
    have fetched = map_fetched(f, code, piece, jumps, pj, file, bytes, i, inside, b, found.proof, pieces, state, head);
    let s2 = fetched.witness;
    let l = fetched.proof;
    let at_byte: (read_gpr(Rsi, s2.gprs).toNat() = io_page_base() + i) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), l.rsi), head.cursor);
    have stored = map_stored(f, code, jumps, pj, file, head.page, i, inside, b, pieces, s2, trans(l.memory_is, head.memory_is), l.rip_is,
        at_byte, l.image);
    let s3 = stored.witness;
    let st = stored.proof;
    let next = io_store_offset(IoMemory(file, head.page), i, [f(b)]).page;
    let stepped = block_fetched(fetch, data, map_step_block(), s3, trivial,
        resident_state(fetch, canonical_block_bytes(map_step_block()), IoMemory(file, next), eof_rip(map_at_step(structured_bytes(code).len())), s3, st.memory_is, st.rip_is,
            pieces(next).step_at));
    let s4 = execute_block_normal(map_step_block(), s3);
    let rsi3: (read_gpr(Rsi, s3.gprs) = read_gpr(Rsi, s2.gprs)) = cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsi, g), st.gprs_is);
    let rcx3: (read_gpr(Rcx, s3.gprs) = read_gpr(Rcx, s2.gprs)) = cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rcx, g), st.gprs_is);
    let one: (read_gpr(R11, s3.gprs) = BitVec::ofNat(1)) = trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(R11, g), st.gprs_is), trans(l.r11, head.one));
    let one_value: (read_gpr(R11, s3.gprs).toNat() = 1) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), one), BitVec::toNat_ofNat(64, 1, trivial));
    let at3: (read_gpr(Rsi, s3.gprs).toNat() = io_page_base() + i) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), rsi3), at_byte);
    let rsi4: (read_gpr(Rsi, s4.gprs).toNat() = io_page_base() + Succ(i)) =
        trans(bitvec_nat::toNat_add(64, read_gpr(Rsi, s3.gprs), read_gpr(R11, s3.gprs),
            j(sym(one_value), λ v _ => read_gpr(Rsi, s3.gprs).toNat() + v < Nat::pow(2, 64),
                j(sym(at3), λ v _ => v + 1 < Nat::pow(2, 64), map_word(i, inside)))),
            trans(cong_fn<Nat, Nat>(λ v => read_gpr(Rsi, s3.gprs).toNat() + v, one_value), cong_fn<Nat, Nat>(λ v => v + 1, at3)));
    let rcx_count: (read_gpr(Rcx, s3.gprs).toNat() + i = bytes.len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat() + i, trans(rcx3, l.rcx)), head.count);
    let some_left: (1 <= read_gpr(Rcx, s3.gprs).toNat()) = map_count_left(read_gpr(Rcx, s3.gprs).toNat(), i, rest, bytes.len(), rcx_count, counting);
    let rcx4_value: (read_gpr(Rcx, s4.gprs).toNat() = read_gpr(Rcx, s3.gprs).toNat() -1) =
        trans(bitvec_nat::toNat_sub(64, read_gpr(Rcx, s3.gprs), read_gpr(R11, s3.gprs),
                j(sym(one_value), λ v _ => v <= read_gpr(Rcx, s3.gprs).toNat(), some_left)),
            cong_fn<Nat, Nat>(λ v => read_gpr(Rcx, s3.gprs).toNat() -v, one_value));
    let counted = map_count_next(read_gpr(Rcx, s3.gprs).toNat(), read_gpr(Rcx, s4.gprs).toNat(), i, rest, bytes.len(), rcx_count, counting, rcx4_value);
    Exists(s4, ⟨linux_steps_trans(io_linux(), state, s2, s4, linux_steps_of_fetched(io_linux(), state, s2, l.steps),
            linux_steps_trans(io_linux(), s2, s3, s4, linux_steps_store(io_linux(), s2, s3, st.step),
                linux_steps_of_fetched(io_linux(), s3, s4, stepped.left))),
        ⟨MapAt(
            page := next,
            memory_is := trans(pure_block_memory(map_step_block(), s3), st.memory_is),
            rip_is := trans(stepped.right, rip_advance(entry, s3.rip, map_at_step(structured_bytes(code).len()), map_step_len(), st.rip_is)),
            mapped := map_page_mapped(f, bytes, IoMemory(file, head.page), i, b, found.proof, head.mapped),
            left := map_page_left(bytes, IoMemory(file, head.page), i, f(b), head.left),
            cursor := rsi4,
            count := counted.right,
            base := trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(R9, g), st.gprs_is), l.r9)), head.base),
            length := trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(R10, g), st.gprs_is), l.r10)),
                head.length),
            one := one),
         refl⟩⟩)
}

// The JNZ, taken while bytes are left.
theorem map_again(f: BitVec(8) → BitVec(8), code: StructuredCode, jumps: MapJumps, pj: PrintJumps, file, bytes: List<BitVec(8)>,
    loop_target: near_branch_target(eof_rip(map_at_jnz(structured_bytes(code).len())), 6, jumps.ld) = eof_rip(map_at_load(structured_bytes(code).len())),
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    i: Nat, state: MachineState<IoMemory>, body: MapAt(f, file, bytes, i, map_at_jnz(structured_bytes(code).len()), state),
    flag: state.flags.zf = False):
    Exists<MachineState<IoMemory>>(λ next => FetchedStep(io_fetch_access(), io_data_access(), state, next) ∧
        MapAt(f, file, bytes, i, map_at_load(structured_bytes(code).len()), next)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let jump = near_fetched_step(fetch, data, JumpIfNear(NE, jumps.ld), state,
        resident_state(fetch, near_control_bytes(JumpIfNear(NE, jumps.ld)), IoMemory(file, body.page), eof_rip(map_at_jnz(structured_bytes(code).len())), state,
            body.memory_is, body.rip_is, pieces(body.page).jnz_at));
    let next = execute_near_control(JumpIfNear(NE, jumps.ld), state);
    let taken: (condition_holds(NE, state.flags) = True) = cong_fn<Bool, Bool>(λ z => !z, flag);
    let next_rip_is: (next.rip = eof_rip(map_at_load(structured_bytes(code).len()))) =
        trans(near_if_taken_rip(NE, jumps.ld, state, taken),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.ld), body.rip_is), loop_target));
    Exists(next, ⟨jump, MapAt(page := body.page, memory_is := body.memory_is, rip_is := next_rip_is, mapped := body.mapped,
        left := body.left, cursor := body.cursor, count := body.count, base := body.base, length := body.length, one := body.one)⟩)
}

// The JNZ, falling through to the write loop once the chunk is done.
theorem map_done(f: BitVec(8) → BitVec(8), code: StructuredCode, jumps: MapJumps, pj: PrintJumps, file, bytes: List<BitVec(8)>,
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    i: Nat, state: MachineState<IoMemory>, body: MapAt(f, file, bytes, i, map_at_jnz(structured_bytes(code).len()), state),
    flag: state.flags.zf = True):
    Exists<MachineState<IoMemory>>(λ next => FetchedStep(io_fetch_access(), io_data_access(), state, next) ∧
        MapAt(f, file, bytes, i, map_at_write(structured_bytes(code).len()), next)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let jump = near_fetched_step(fetch, data, JumpIfNear(NE, jumps.ld), state,
        resident_state(fetch, near_control_bytes(JumpIfNear(NE, jumps.ld)), IoMemory(file, body.page), eof_rip(map_at_jnz(structured_bytes(code).len())), state,
            body.memory_is, body.rip_is, pieces(body.page).jnz_at));
    let next = execute_near_control(JumpIfNear(NE, jumps.ld), state);
    let passed: (condition_holds(NE, state.flags) = False) = cong_fn<Bool, Bool>(λ z => !z, flag);
    let next_rip_is: (next.rip = eof_rip(map_at_write(structured_bytes(code).len()))) =
        trans(near_if_not_taken_rip(NE, jumps.ld, state, passed), rip_advance(entry, state.rip, map_at_jnz(structured_bytes(code).len()), 6, body.rip_is));
    Exists(next, ⟨jump, MapAt(page := body.page, memory_is := body.memory_is, rip_is := next_rip_is, mapped := body.mapped,
        left := body.left, cursor := body.cursor, count := body.count, base := body.base, length := body.length, one := body.one)⟩)
}

theorem map_left_word(c, i, rest, n: Nat, counted: c + Succ(i) = n, count: i + Succ(rest) = n): c = rest { omega }
theorem map_next_count(i, r, n: Nat, count: i + Succ(Succ(r)) = n): Succ(i) + Succ(r) = n { omega }
theorem map_last_count(i, n: Nat, count: i + Succ(Zero) = n): Succ(i) = n { omega }

// The chunk, by recursion on the bytes left: every byte mapped in place, and
// the write loop reached.
theorem map_loop(f: BitVec(8) → BitVec(8), code: StructuredCode, piece: MapPiece(f, code),
    jumps: MapJumps, pj: PrintJumps,
    loop_target: near_branch_target(eof_rip(map_at_jnz(structured_bytes(code).len())), 6, jumps.ld) = eof_rip(map_at_load(structured_bytes(code).len())),
    file, bytes: List<BitVec(8)>, fits: bytes.len() <= 4096,
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj), rest: Nat):
    (i: Nat) → (state: MachineState<IoMemory>) → i + Succ(rest) = bytes.len() → MapAt(f, file, bytes, i, map_at_load(structured_bytes(code).len()), state) →
    Exists<MachineState<IoMemory>>(λ done => LinuxSteps(io_linux(), state, done) ∧ MapAt(f, file, bytes, bytes.len(), map_at_write(structured_bytes(code).len()), done)) {
    match rest as λ r => (i: Nat) → (state: MachineState<IoMemory>) → i + Succ(r) = bytes.len() → MapAt(f, file, bytes, i, map_at_load(structured_bytes(code).len()), state) →
            Exists<MachineState<IoMemory>>(λ done => LinuxSteps(io_linux(), state, done) ∧ MapAt(f, file, bytes, bytes.len(), map_at_write(structured_bytes(code).len()), done)) {
        Zero => λ i state count head => {
            have stepped = map_byte(f, code, piece, jumps, pj, file, bytes, fits, i, Zero, count, pieces, state, head);
            let body = stepped.witness;
            let at = stepped.proof.right.left;
            let none: (read_gpr(Rcx, body.gprs).toNat() = 0) = map_left_word(read_gpr(Rcx, body.gprs).toNat(), i, Zero, bytes.len(), at.count, count);
            have out = map_done(f, code, jumps, pj, file, bytes, pieces, Succ(i), body, at,
                trans(stepped.proof.right.right, zero_bits_of_zero(64, read_gpr(Rcx, body.gprs), none)));
            Exists(out.witness, ⟨linux_steps_trans(io_linux(), state, body, out.witness, stepped.proof.left,
                    linux_steps_of_fetched(io_linux(), body, out.witness, fetched_steps_one(io_fetch_access(), io_data_access(), body, out.witness, out.proof.left))),
                j(map_last_count(i, bytes.len(), count), λ k _ => MapAt(f, file, bytes, k, map_at_write(structured_bytes(code).len()), out.witness), out.proof.right)⟩)
        },
        Succ(r, ih) => λ i state count head => {
            have stepped = map_byte(f, code, piece, jumps, pj, file, bytes, fits, i, Succ(r), count, pieces, state, head);
            let body = stepped.witness;
            let at = stepped.proof.right.left;
            let some: (read_gpr(Rcx, body.gprs).toNat() = Succ(r)) =
                map_left_word(read_gpr(Rcx, body.gprs).toNat(), i, Succ(r), bytes.len(), at.count, count);
            have again = map_again(f, code, jumps, pj, file, bytes, loop_target, pieces, Succ(i), body, at,
                trans(stepped.proof.right.right, zero_bits_of_pos(64, read_gpr(Rcx, body.gprs), j(sym(some), λ v _ => 0 < v, trivial))));
            have later = ih(Succ(i), again.witness, map_next_count(i, r, bytes.len(), count), again.proof.right);
            Exists(later.witness, ⟨linux_steps_trans(io_linux(), state, body, later.witness, stepped.proof.left,
                    linux_steps_cons(io_linux(), body, again.witness, later.witness, Inl(again.proof.left), later.proof.left)),
                later.proof.right⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// One chunk: read, mapped in place, written.

// What the read left in the page, at an index of the chunk.
theorem stored_page_at(memory: IoMemory, bytes: List<BitVec(8)>, k: Nat, b: BitVec(8), present: bytes.nth(k) = Some(b)):
    io_store_offset(memory, 0, bytes).page(k) = b {
    j(sym(trans(cong_fn<Nat, Option<BitVec(8)>>(λ m => bytes.nth(m), Nat::sub_zero(k)), present)),
        λ found _ => (match found { None => memory.page(k), Some(x) => x }) = b, refl)
}

theorem map_first_count(n: Nat, some: 0 < n): 0 + Succ(n -1) = n {
    let back: ((n -1) + 1 = n) = Nat::sub_add_cancel(1, n, { omega });
    omega
}
theorem map_page_word(k: Nat, inside: k < 4096): io_page_base() + k < Nat::pow(2, 64) {
    let page: (io_page_base() + 4096 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 64), trivial);
    omega
}
theorem map_below_page(k, n: Nat, below: k < n, fits: n <= 4096): k < 4096 { omega }
theorem map_page_end(n: Nat, fits: n <= 4096): io_page_base() + n < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}

// Once the chunk is mapped, the page from R9 holds its image.
theorem map_sends_page(f: BitVec(8) → BitVec(8), file, bytes: List<BitVec(8)>, fits: bytes.len() <= 4096, page: Nat → BitVec(8),
    r9: BitVec(64), base: r9.toNat() = io_page_base(),
    mapped: (j: Nat) → (b: BitVec(8)) → bytes.nth(j) = Some(b) → j < bytes.len() → page(j) = f(b)):
    LinuxWritesFrom(io_linux(), IoMemory(file, page), r9, bytes.map(f)) {
    λ k y at_k => {
        let found = nth_map_of(f, bytes, k, y, at_k);
        let below: (k < bytes.len()) = nth_some_below(bytes, k, found.witness, found.proof.left);
        let inside = map_below_page(k, bytes.len(), below, fits);
        let value: (bitvec_nat::word_of_nat(64, r9.toNat() + k).toNat() = io_page_base() + k) =
            trans(bitvec_nat::toNat_word_of_nat(64, r9.toNat() + k, j(sym(base), λ v _ => v + k < Nat::pow(2, 64), map_page_word(k, inside))),
                cong_fn<Nat, Nat>(λ v => v + k, base));
        trans(read_in_page(file, page, bitvec_nat::word_of_nat(64, r9.toNat() + k), k, inside, value),
            cong_fn<BitVec(8), Option<BitVec(8)>>(λ x => Some(x), trans(mapped(k, found.witness, found.proof.left, below), sym(found.proof.right))))
    }
}

// One chunk, from past the head: the setup, the chunk mapped in place, then
// the write loop, whose end goes on from the read with `then`.
theorem map_chunk(f: BitVec(8) → BitVec(8), code: StructuredCode, piece: MapPiece(f, code),
    jumps: MapJumps, pj: PrintJumps,
    loop_target: near_branch_target(eof_rip(map_at_jnz(structured_bytes(code).len())), 6, jumps.ld) = eof_rip(map_at_load(structured_bytes(code).len())),
    targets: WriteLoopTargets(map_at_write(structured_bytes(code).len()), map_at_read(structured_bytes(code).len()), pj),
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj),
    page: Nat → BitVec(8), bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= 4096,
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(map_at_setup(structured_bytes(code).len())),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    after: List<LinuxEvent>, ending: WriteEnding, ending_ok: WriteEndingOk(ending),
    then: (next: Nat → BitVec(8)) → FinishedThen(ending, IoMemory(file, next), map_at_read(structured_bytes(code).len()), after),
    writes: List<WriteStep>, writes_ok: WriteSteps(writes, bytes.map(f))):
    LinuxRuns(io_linux(), write_events_then(bytes.map(f), writes, ending, after), going) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let n = bytes.len();
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let there = pieces(stored.page);
    let set = block_fetched(fetch, data, map_setup_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(map_setup_block()), stored, eof_rip(map_at_setup(structured_bytes(code).len())), going,
            memory_is, rip_is, there.setup_at));
    let ready = execute_block_normal(map_setup_block(), going);
    let ready_memory: (ready.memory = IoMemory(file, stored.page)) = trans(pure_block_memory(map_setup_block(), going), memory_is);
    let ready_rip: (ready.rip = eof_rip(map_at_load(structured_bytes(code).len()))) =
        trans(set.right, rip_advance(entry, going.rip, map_at_setup(structured_bytes(code).len()), map_setup_len(), rip_is));
    let counted: (read_gpr(Rax, going.gprs).toNat() = n) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, n, count_below_word(n, fits)));
    let page_value: (BitVec::ofNat(io_page_base(), n := 64).toNat() = io_page_base()) = BitVec::toNat_ofNat(64, io_page_base(), trivial);
    let head: MapAt(f, file, bytes, 0, map_at_load(structured_bytes(code).len()), ready) = MapAt(
        page := stored.page,
        memory_is := ready_memory,
        rip_is := ready_rip,
        mapped := λ j b _ past => false_elim(past),
        left := λ j b at_j _ => stored_page_at(IoMemory(file, page), bytes, j, b, at_j),
        cursor := page_value,
        count := counted,
        base := page_value,
        length := counted,
        one := refl);
    have done = map_loop(f, code, piece, jumps, pj, loop_target, file, bytes, fits, pieces, n -1,
        0, ready, map_first_count(n, some), head);
    let last = done.witness;
    let at = done.proof.right;
    let sends = map_sends_page(f, file, bytes, fits, at.page, read_gpr(R9, last.gprs), at.base,
        λ j b at_j below => at.mapped(j, b, at_j, below));
    let image_len: (bytes.map(f).len() = n) = List::len_map(bytes, f);
    have runs = wl_from_then(IoMemory(file, at.page), map_at_write(structured_bytes(code).len()), pj, map_at_read(structured_bytes(code).len()), pieces(at.page).write, targets,
        after, ending, ending_ok, then(at.page), writes,
        bytes.map(f), writes_ok, last, j(sym(image_len), λ v _ => 0 < v, some), j(sym(image_len), λ v _ => v <= 4096, fits),
        at.rip_is, at.memory_is, sends, trans(at.length, sym(image_len)),
        j(sym(image_len), λ v _ => read_gpr(R9, last.gprs).toNat() + v < Nat::pow(2, 64),
            j(sym(at.base), λ v _ => v + n < Nat::pow(2, 64), map_page_end(n, fits))));
    linux_runs_after_linux_steps(io_linux(), write_events_then(bytes.map(f), writes, ending, after), going, last,
        linux_steps_trans(io_linux(), going, ready, last, linux_steps_of_fetched(io_linux(), going, ready, set.left), done.proof.left),
        runs)
}

// ---------------------------------------------------------------------------
// The histories, and what the run sends.

// The driver's history (elf64_read_pieces's `EofStep` and `EofEnd`): each
// chunk carries how its image's writes went, all sent; a chunk may end the
// run in a failed write, with the writes before it and the errno.
record WriteFailure { writes: List<WriteStep>, errno: Nat }

// A chunk is read, then its image written; once all of it is sent, the next
// read follows. A failed write exits 1 before anything after it.
fn map_writes(f: BitVec(8) → BitVec(8)) → List<BitVec(8)> → List<WriteStep> → List<LinuxEvent> → List<LinuxEvent> {
    λ bytes writes after => write_events_then(bytes.map(f), writes, Finished, after)
}
fn map_failed_write(f: BitVec(8) → BitVec(8)) → List<BitVec(8)> → WriteFailure → List<LinuxEvent> {
    λ bytes failure => write_events_then(bytes.map(f), failure.writes, WriteFailedWith(failure.errno), Nil)
}
fn map_events(f: BitVec(8) → BitVec(8), steps: List<EofStep<List<WriteStep>>>, ending: EofEnd<WriteFailure>) → List<LinuxEvent> {
    eof_run(map_writes(f), map_failed_write(f), steps, ending, [ExitEvent(BitVec::ofNat(0))])
}
fn map_input(steps: List<EofStep<List<WriteStep>>>) → List<BitVec(8)> { eof_input(steps) }

// A chunk's writes are short ones of its image; a failed write is one of
// them, then an errno other than EINTR.
fn map_writes_ok(f: BitVec(8) → BitVec(8)) → List<BitVec(8)> → List<WriteStep> → Type {
    λ bytes writes => WriteSteps(writes, bytes.map(f))
}
fn map_failure_ok(f: BitVec(8) → BitVec(8)) → List<BitVec(8)> → WriteFailure → Type {
    λ bytes failure => WriteSteps(failure.writes, bytes.map(f)) ∧ (Errno(failure.errno) ∧ Not(failure.errno = eintr()))
}
fn MapSteps(f: BitVec(8) → BitVec(8), steps: List<EofStep<List<WriteStep>>>) → Type { EofSteps(map_writes_ok(f), steps) }
fn MapEndingOk(f: BitVec(8) → BitVec(8), ending: EofEnd<WriteFailure>) → Type { EofEndOk(map_failure_ok(f), ending) }

// On a run that ends at the empty read, stdout received the input's image.
theorem map_sends(f: BitVec(8) → BitVec(8), steps: List<EofStep<List<WriteStep>>>): MapSteps(f, steps) →
    sent_to(BitVec::ofNat(1), map_events(f, steps, AtEnd)) = map_input(steps).map(f) {
    match steps as λ ss => MapSteps(f, ss) → sent_to(BitVec::ofNat(1), map_events(f, ss, AtEnd)) = map_input(ss).map(f) {
        Nil => λ _ => refl,
        Cons(step, rest) => match step as λ st => MapSteps(f, Cons(st, rest)) →
                sent_to(BitVec::ofNat(1), map_events(f, Cons(st, rest), AtEnd)) = map_input(Cons(st, rest)).map(f) {
            Chunk(bytes, writes) => λ ok => trans(stdout_then(writes, map_events(f, rest, AtEnd), bytes.map(f), ok.right.right.left),
                trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => bytes.map(f) ++ tail, map_sends(f, rest, ok.right.right.right)),
                    sym(List::map_append(bytes, map_input(rest), f)))),
            Interrupted => λ ok => map_sends(f, rest, ok),
        },
    }
}

// ---------------------------------------------------------------------------
// The run.

// Where the jumps land.
record MapTargets(code: StructuredCode, jumps: MapJumps, pj: PrintJumps) {
    exit: near_branch_target(eof_rip(rh_at_jz(map_at_read(structured_bytes(code).len()))), 6, jumps.ed) =
        eof_rip(wl_at_exit(map_at_write(structured_bytes(code).len()))),
    fail: near_branch_target(eof_rip(rh_at_js(map_at_read(structured_bytes(code).len()))), 6, jumps.sd) =
        eof_rip(map_at_failed(structured_bytes(code).len())),
    again: near_branch_target(eof_rip(map_at_jnz(structured_bytes(code).len())), 6, jumps.ld) = eof_rip(map_at_load(structured_bytes(code).len())),
    retry: near_branch_target(eof_rip(map_at_retry(structured_bytes(code).len())), 6, jumps.rd) = eof_rip(map_at_read(structured_bytes(code).len())),
    write: WriteLoopTargets(map_at_write(structured_bytes(code).len()), map_at_read(structured_bytes(code).len()), pj),
}

// The process for the driver: no invariant beyond where the read is (the
// setup sets every register the chunk needs), a chunk mapped and written, a
// chunk whose write fails, and at end of file the write loop's exit(0).
theorem map_process(f: BitVec(8) → BitVec(8), code: StructuredCode, piece: MapPiece(f, code),
    jumps: MapJumps, pj: PrintJumps, targets: MapTargets(code, jumps, pj), file: List<BitVec(8)>,
    pieces: (page: Nat → BitVec(8)) → MapPieces(IoMemory(file, page), code, jumps, pj), input: List<BitVec(8)>):
    EofProcess<List<WriteStep>, WriteFailure>(file, map_at_read(structured_bytes(code).len()), wl_at_exit(map_at_write(structured_bytes(code).len())), λ _ _ => True, input,
        map_writes_ok(f), map_writes(f), map_failure_ok(f), map_failed_write(f), [ExitEvent(BitVec::ofNat(0))]) {
    EofProcess(
        framed := λ seen before after kept held => trivial,
        chunk := λ page seen bytes rest writes some fits writes_ok prefix going rip_is memory_is length_word held after next =>
            map_chunk(f, code, piece, jumps, pj, targets.again, targets.write, file, pieces, page, bytes, some, fits,
                going, memory_is, rip_is, length_word, after, Finished, trivial,
                λ next_page state at_read in_page => next(next_page, state, at_read, in_page, trivial), writes, writes_ok),
        ends := λ page seen bytes failure some fits failure_ok going rip_is memory_is length_word held =>
            map_chunk(f, code, piece, jumps, pj, targets.again, targets.write, file, pieces, page, bytes, some, fits,
                going, memory_is, rip_is, length_word, Nil, WriteFailedWith(failure.errno), failure_ok.right,
                λ _ => trivial, failure.writes, failure_ok.left),
        at_end := λ page state at_done in_page _ =>
            wl_exit(IoMemory(file, page), map_at_write(structured_bytes(code).len()), pj, pieces(page).write, state, at_done, in_page))
}

// ---------------------------------------------------------------------------
// The jumps' targets, from a closed fact about each displacement that the
// producer proves at the written bytes.

// The eight displacements, for a byte map `p` bytes long: the process's four,
// the write loop's own three, and the write loop's all-sent JZ back to the
// read.
record MapJumpFacts(p: Nat, jumps: MapJumps, pj: PrintJumps) {
    exit: JumpsForward(rh_at_jz(map_at_read(p)), 6, jumps.ed, wl_at_exit(map_at_write(p))),
    fail: JumpsForward(rh_at_js(map_at_read(p)), 6, jumps.sd, map_at_failed(p)),
    again: JumpsBack(map_at_jnz(p), 6, jumps.ld, map_at_load(p)),
    retry: JumpsBack(map_at_retry(p), 6, jumps.rd, map_at_read(p)),
    write: WriteJumpFacts(pj),
    write_read: JumpsBack(wl_at_wjz(map_at_write(p)), 6, pj.zd, map_at_read(p)),
}
theorem map_targets(code: StructuredCode, jumps: MapJumps, pj: PrintJumps, facts: MapJumpFacts(structured_bytes(code).len(), jumps, pj)):
    MapTargets(code, jumps, pj) {
    let p = structured_bytes(code).len();
    let entry = io_entry();
    MapTargets(
        exit := jumps_forward(entry, rh_at_jz(map_at_read(p)), 6, jumps.ed, wl_at_exit(map_at_write(p)), facts.exit),
        fail := jumps_forward(entry, rh_at_js(map_at_read(p)), 6, jumps.sd, map_at_failed(p), facts.fail),
        again := jumps_back(entry, map_at_jnz(p), 6, jumps.ld, map_at_load(p), facts.again),
        retry := jumps_back(entry, map_at_retry(p), 6, jumps.rd, map_at_read(p), facts.retry),
        write := write_targets_to(map_at_write(p), map_at_read(p), pj, facts.write,
            jumps_back(entry, wl_at_wjz(map_at_write(p)), 6, pj.zd, map_at_read(p), facts.write_read)))
}

// The byte map as the producer certifies it: its code and its certificate.
record MapByte(f: BitVec(8) → BitVec(8)) {
    code: StructuredCode,
    piece: MapPiece(f, code),
}

// The process claim: for every history of reads and writes (chunks and
// EINTRs, each chunk's short writes and EINTRs), ending at the empty read or
// at a failed read or write, the file has a run that reads each chunk and
// writes its image under `f`, then exits 0, or 1 at the failure. What
// stdout received on a run that ends well is `map_sends`'s.
theorem read_map_runs(file: List<BitVec(8)>, f: BitVec(8) → BitVec(8), byte: MapByte(f), jumps: MapJumps, pj: PrintJumps,
    facts: MapJumpFacts(structured_bytes(byte.code).len(), jumps, pj),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), map_code(byte.code, jumps, pj), io_entry()),
    steps: List<EofStep<List<WriteStep>>>, ok: MapSteps(f, steps), ending: EofEnd<WriteFailure>, ending_ok: MapEndingOk(f, ending),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), map_events(f, steps, ending), io_initial(file, page, gprs, flags)) {
    let p = structured_bytes(byte.code).len();
    let done = wl_at_exit(map_at_write(p));
    let pieces = λ (page: Nat → BitVec(8)) => map_pieces(IoMemory(file, page), byte.code, jumps, pj, resident(page));
    let targets = map_targets(byte.code, jumps, pj, facts);
    let layout: EofLayout(file, map_at_read(p), map_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd) =
        EofLayout(λ pg => pieces(pg).head, λ pg => pieces(pg).fail, targets.exit, targets.fail, targets.retry);
    eof_from(file, map_at_read(p), map_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd, layout, λ _ _ => True, eof_input(steps),
        map_writes_ok(f), map_writes(f), map_failure_ok(f), map_failed_write(f), [ExitEvent(BitVec::ofNat(0))],
        map_process(f, byte.code, byte.piece, jumps, pj, targets, file, pieces, eof_input(steps)),
        ending, ending_ok, steps)(ok, page, Nil, refl, io_initial(file, page, gprs, flags), refl, refl, trivial)
}

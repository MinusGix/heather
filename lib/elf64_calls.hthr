    writes_only_compose(call_memory_read, λ address => WordPrefixWrites(1, pointer, address), ByteWrite(pointer.add(BitVec::ofNat(1))), memory, word_write_1(call_stack_access(), value, memory, pointer), word_write_2(call_stack_access(), value, memory, pointer), word_memory_effect_1(memory, pointer, value), memory_write_effect(word_write_1(call_stack_access(), value, memory, pointer), pointer.add(BitVec::ofNat(1)), imm_byte1(value)))
}

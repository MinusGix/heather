}
// A stack-level footprint is the cheap thing to state: a caller that reads the
// stack through it never forces a file lookup. The full memory observation is
// still derivable, and this is where that is paid for — once, open, with the
// file untouched, instead of per byte read at a concrete address.
theorem memory_writes_of_stack_writes(before, after: CallMemory, writes: BitVec(64) → Type,
    files: after.file = before.file,
    effects: WritesOnly(stack_observation, writes, before, after)):
    WritesOnly(call_memory_read, writes, before, after) {
    λ address outside => trans<Option<BitVec(8)>>(
        cong_fn<BitVec(8), Option<BitVec(8)>>(λ byte =>
            call_read_choice(static_elf64_read(after.file, address), stack_page(address), byte),
            effects(address, outside)),
        cong_fn<List<BitVec(8)>, Option<BitVec(8)>>(λ file =>
            call_read_choice(static_elf64_read(file, address), stack_page(address), before.stack(address)),
            files))
}

record WordOutside(written, protected: BitVec(64)) {
    byte0: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(0))),
    byte1: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(1))),
    byte2: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(2))),
    byte3: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(3))),
    byte4: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(4))),
    byte5: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(5))),
    byte6: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(6))),
    byte7: ¬WordPrefixWrites(8, written, protected.add(BitVec::ofNat(7))),
}
theorem stack_word_agrees(access: StackAccess<CallMemory>, before, after: CallMemory, pointer: BitVec(64),
    byte0: access.read(after, pointer) = access.read(before, pointer),
    byte1: access.read(after, pointer.add(BitVec::ofNat(1))) = access.read(before, pointer.add(BitVec::ofNat(1))),
    byte2: access.read(after, pointer.add(BitVec::ofNat(2))) = access.read(before, pointer.add(BitVec::ofNat(2))),
    byte3: access.read(after, pointer.add(BitVec::ofNat(3))) = access.read(before, pointer.add(BitVec::ofNat(3))),
    byte4: access.read(after, pointer.add(BitVec::ofNat(4))) = access.read(before, pointer.add(BitVec::ofNat(4))),
    byte5: access.read(after, pointer.add(BitVec::ofNat(5))) = access.read(before, pointer.add(BitVec::ofNat(5))),
    byte6: access.read(after, pointer.add(BitVec::ofNat(6))) = access.read(before, pointer.add(BitVec::ofNat(6))),
    byte7: access.read(after, pointer.add(BitVec::ofNat(7))) = access.read(before, pointer.add(BitVec::ofNat(7)))):
    stack_word(access, after, pointer) = stack_word(access, before, pointer) {
    trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            byte,
            access.read(after, pointer.add(BitVec::ofNat(1))),
            access.read(after, pointer.add(BitVec::ofNat(2))),
            access.read(after, pointer.add(BitVec::ofNat(3))),
            access.read(after, pointer.add(BitVec::ofNat(4))),
            access.read(after, pointer.add(BitVec::ofNat(5))),
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte0), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer), byte,
            access.read(after, pointer.add(BitVec::ofNat(2))),
            access.read(after, pointer.add(BitVec::ofNat(3))),
            access.read(after, pointer.add(BitVec::ofNat(4))),
            access.read(after, pointer.add(BitVec::ofNat(5))),
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte1), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))), byte,
            access.read(after, pointer.add(BitVec::ofNat(3))),
            access.read(after, pointer.add(BitVec::ofNat(4))),
            access.read(after, pointer.add(BitVec::ofNat(5))),
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte2), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))),
            access.read(before, pointer.add(BitVec::ofNat(2))), byte,
            access.read(after, pointer.add(BitVec::ofNat(4))),
            access.read(after, pointer.add(BitVec::ofNat(5))),
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte3), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))),
            access.read(before, pointer.add(BitVec::ofNat(2))),
            access.read(before, pointer.add(BitVec::ofNat(3))), byte,
            access.read(after, pointer.add(BitVec::ofNat(5))),
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte4), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))),
            access.read(before, pointer.add(BitVec::ofNat(2))),
            access.read(before, pointer.add(BitVec::ofNat(3))),
            access.read(before, pointer.add(BitVec::ofNat(4))), byte,
            access.read(after, pointer.add(BitVec::ofNat(6))),
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte5), trans<BitVec(64)>(
        cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))),
            access.read(before, pointer.add(BitVec::ofNat(2))),
            access.read(before, pointer.add(BitVec::ofNat(3))),
            access.read(before, pointer.add(BitVec::ofNat(4))),
            access.read(before, pointer.add(BitVec::ofNat(5))), byte,
            access.read(after, pointer.add(BitVec::ofNat(7)))), byte6), cong_fn<BitVec(8), BitVec(64)>(λ byte => immediate_from_bytes(
            access.read(before, pointer),
            access.read(before, pointer.add(BitVec::ofNat(1))),
            access.read(before, pointer.add(BitVec::ofNat(2))),
            access.read(before, pointer.add(BitVec::ofNat(3))),
            access.read(before, pointer.add(BitVec::ofNat(4))),
            access.read(before, pointer.add(BitVec::ofNat(5))),
            access.read(before, pointer.add(BitVec::ofNat(6))), byte), byte7))))))))
}
theorem stored_word_preserves_return(memory: CallMemory, pointer, value, protected: BitVec(64), outside: WordOutside(pointer, protected)):
    stack_word(call_stack_access(), word_write_8(call_stack_access(), value, memory, pointer), protected) =
    stack_word(call_stack_access(), memory, protected) {
    // The zero offset is spelled out: `bitvec::add` is the ripple, which does
    // not absorb a zero second operand definitionally
    // (docs/bitvec-width-bounded-defaults-design.md).
    stack_word_agrees(call_stack_access(), memory, word_write_8(call_stack_access(), value, memory, pointer), protected,
        j(BitVec::add_of_toNat_zero(64, protected, BitVec::ofNat(0), refl),
            λ target _ =>
                call_stack_access().read(word_write_8(call_stack_access(), value, memory, pointer), target) =
                call_stack_access().read(memory, target),
            word_stack_effect_8(memory, pointer, value)(
                protected.add(BitVec::ofNat(0)), outside.byte0)),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(1)), outside.byte1),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(2)), outside.byte2),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(3)), outside.byte3),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(4)), outside.byte4),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(5)), outside.byte5),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(6)), outside.byte6),
        word_stack_effect_8(memory, pointer, value)(protected.add(BitVec::ofNat(7)), outside.byte7))
}

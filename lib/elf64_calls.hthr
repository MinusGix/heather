// Fixed call-executable profile: RX file at 0x400000 and a separate zero-filled
// RW, non-executable page at 0x401000. The producer starts RSP at 0x402000.
// Linux's PT_LOAD implementation remains an environment assumption.
import elf64;
import elf64_load;
import x86_64;
import x86_64_calls;
import x86_64_call_frame;
import x86_64_fetch;
import bitvec;
import bool;
import list;
import option;
import logic;
import nat;

fn call_elf_header(low, high: BitVec(8)) → List<BitVec(8)> {
    let base = static_elf64_header(low, high);
    List::append(base.take(24), List::append(word_bytes(BitVec::ofNat(0x4000e8)), List::append(base.drop(32).take(24), List::append([elf_byte(3), elf_byte(0)], List::append(base.drop(58), List::append([elf_byte(1), elf_byte(0), elf_byte(0), elf_byte(0), elf_byte(6), elf_byte(0), elf_byte(0), elf_byte(0)], List::append(word_bytes(BitVec::ofNat(0x1000)), List::append(word_bytes(BitVec::ofNat(0x401000)), List::append(word_bytes(BitVec::ofNat(0x401000)), List::append(word_bytes(BitVec::ofNat(0)), List::append(word_bytes(BitVec::ofNat(0x1000)), word_bytes(BitVec::ofNat(0x1000)))))))))))))
}
record CallElfImage(code: List<BitVec(8)>) {
    nonempty: 0 < code.len(),
    low: BitVec(8), high: BitVec(8),
    size_correct: 232 + code.len() = elf_size16(low, high),
    disjoint_stack: elf_size16(low, high) <= 4096,
}
fn call_elf_bytes(code: List<BitVec(8)>, image: CallElfImage(code)) → List<BitVec(8)> {
    List::append(call_elf_header(image.low, image.high), code)
}
// The read profile's image (elf64_io): the same header with its RW pages just
// past the file's 64-KiB window, so the code may fill the window: the page
// at 0x410000 and the frame at 0x411000, one zero-filled 8-KiB segment.
fn io_elf_header(low, high: BitVec(8)) → List<BitVec(8)> {
    let base = static_elf64_header(low, high);
    List::append(base.take(24), List::append(word_bytes(BitVec::ofNat(0x4000e8)), List::append(base.drop(32).take(24), List::append([elf_byte(3), elf_byte(0)], List::append(base.drop(58), List::append([elf_byte(1), elf_byte(0), elf_byte(0), elf_byte(0), elf_byte(6), elf_byte(0), elf_byte(0), elf_byte(0)], List::append(word_bytes(BitVec::ofNat(0x1000)), List::append(word_bytes(BitVec::ofNat(0x410000)), List::append(word_bytes(BitVec::ofNat(0x410000)), List::append(word_bytes(BitVec::ofNat(0)), List::append(word_bytes(BitVec::ofNat(0x2000)), word_bytes(BitVec::ofNat(0x1000)))))))))))))
}
record IoElfImage(code: List<BitVec(8)>) {
    nonempty: 0 < code.len(),
    low: BitVec(8), high: BitVec(8),
    size_correct: 232 + code.len() = elf_size16(low, high),
}
fn io_elf_bytes(code: List<BitVec(8)>, image: IoElfImage(code)) → List<BitVec(8)> {
    List::append(io_elf_header(image.low, image.high), code)
}
record CallMemory {
    file: List<BitVec(8)>,
    stack: BitVec(64) → BitVec(8),
}
fn stack_page(address: BitVec(64)) → Bool {
    is_zero_bits(52, address.drop_low(12, 52).bxor(BitVec::ofNat(0x401)))
}
fn call_read_choice(file_byte: Option<BitVec(8)>, stack_address: Bool, stack_byte: BitVec(8)) → Option<BitVec(8)> {
    match file_byte {
        Some(byte) => Some(byte),
        None => match stack_address { True => Some(stack_byte), False => None },
    }
}
fn call_memory_read(memory: CallMemory, address: BitVec(64)) → Option<BitVec(8)> {
    // Valid CallElfImage files end before the stack page.
    call_read_choice(static_elf64_read(memory.file, address), stack_page(address), memory.stack(address))
}
fn call_memory_write(memory: CallMemory, address: BitVec(64), byte: BitVec(8)) → CallMemory {
    CallMemory(memory.file, λ query =>
        match is_zero_bits(64, address.bxor(query)) {
            True => byte,
            False => memory.stack(query),
        })
}
fn stack_observation(memory: CallMemory, address: BitVec(64)) → BitVec(8) { memory.stack(address) }
fn call_stack_access() → StackAccess<CallMemory> {
    StackAccess(stack_observation, call_memory_write,
        stack_page, stack_page)
}
fn call_fetch_access() → FetchAccess<CallMemory> {
    FetchAccess(call_memory_read, λ memory address => static_elf64_executable(memory.file, address))
}
// A file-backed byte establishes both RX permission and the observable byte.
// Derive these together instead of reducing the same file lookup twice.
theorem call_file_observation(memory: CallMemory, address: BitVec(64), byte: BitVec(8),
    present: static_elf64_read(memory.file, address) = Some(byte)):
    call_fetch_access().executable(memory, address) = True ∧
    call_fetch_access().read_byte(memory, address) = Some(byte) {
    j(sym(present), λ value _ =>
        (match value as λ _ => Bool { None => False, Some(_) => True }) = True ∧
        call_read_choice(value, stack_page(address), memory.stack(address)) = Some(byte), ⟨refl, refl⟩)
}
theorem call_file_fetch_one(memory: CallMemory, address: BitVec(64), byte: BitVec(8),
    present: static_elf64_read(memory.file, address) = Some(byte)):
    FetchedFrom(call_fetch_access(), memory, InstructionBytes(address, [byte])) {
    let observed = call_file_observation(memory, address, byte, present);
    fetch_span_one(call_fetch_access(), memory, address, byte, observed.left, observed.right)
}
theorem call_file_fetch_more(memory: CallMemory, address, next: BitVec(64), byte, next_byte: BitVec(8), rest: List<BitVec(8)>,
    present: static_elf64_read(memory.file, address) = Some(byte),
    no_wrap: address.carry_add_bit(BitVec::ofNat(1)) = False,
    next_correct: next_rip(address, 1) = next,
    tail: FetchedFrom(call_fetch_access(), memory, InstructionBytes(next, Cons(next_byte, rest)))):
    FetchedFrom(call_fetch_access(), memory, InstructionBytes(address, Cons(byte, Cons(next_byte, rest)))) {
    let observed = call_file_observation(memory, address, byte, present);
    fetch_span_more(call_fetch_access(), memory, address, next, byte, next_byte, rest,
        observed.left, observed.right, no_wrap, next_correct, tail)
}

fn call_initial(file: List<BitVec(8)>, gprs: Gprs, flags: Flags,
    stack: BitVec(64) → BitVec(8)) → MachineState<CallMemory> {
    MachineState(gprs, flags, BitVec::ofNat(0x4000e8), CallMemory(file, stack))
}

// Join file packaging and fetched execution. The generated exit request and
// terminal syscall fetch use this same final state.
record CallImageExecution(file: List<BitVec(8)>, code: List<BitVec(8)>,
    instructions: List<CallInstruction>, before, after: MachineState<CallMemory>) {
    image: CallElfImage(code),
    file_correct: file = call_elf_bytes(code, image),
    initial_memory: before.memory.file = file,
    execution: FetchedCallTrace(call_fetch_access(), call_stack_access(), instructions, before, after),
}

theorem call_memory_write_cong(before, other: CallMemory, address, other_address: BitVec(64),
    byte, other_byte: BitVec(8), memory_same: before = other, address_same: address = other_address,
    byte_same: byte = other_byte):
    call_memory_write(before, address, byte) = call_memory_write(other, other_address, other_byte)
{
    trans(cong_fn<CallMemory, CallMemory>(λ memory => call_memory_write(memory, address, byte), memory_same),
        trans(cong_fn<BitVec(64), CallMemory>(λ pointer => call_memory_write(other, pointer, byte), address_same),
            cong_fn<BitVec(8), CallMemory>(λ value => call_memory_write(other, other_address, value), byte_same)))
}

// The byte footprint uses exactly the address test used by the store.
fn ByteWrite(pointer, address: BitVec(64)) → Type {
    is_zero_bits(64, pointer.bxor(address)) = True
}
theorem not_true_is_false(value: Bool): ¬(value = True) → value = False {
    match value as λ bit => ¬(bit = True) → bit = False {
        False => λ different => refl,
        True => λ different => false_elim(different(refl)),
    }
}
theorem stack_write_away(memory: CallMemory, pointer, address: BitVec(64), byte: BitVec(8),
    different: is_zero_bits(64, pointer.bxor(address)) = False):
    call_memory_write(memory, pointer, byte).stack(address) = memory.stack(address) {
    j(sym(different), λ decision _ =>
        (match decision { True => byte, False => memory.stack(address) }) = memory.stack(address), refl)
}
theorem stack_write_same(memory: CallMemory, pointer: BitVec(64), byte: BitVec(8)):
    call_memory_write(memory, pointer, byte).stack(pointer) = byte {
    let same: (is_zero_bits(64, pointer.bxor(pointer)) = True) = trans<Bool>(cong_fn<BitVec(64), Bool>(λ value => is_zero_bits(64, value), BitVec::xor_self(64, pointer)), refl);
    j(sym(same), λ decision _ => (match decision { True => byte, False => memory.stack(pointer) }) = byte, refl)
}
theorem memory_write_away(memory: CallMemory, pointer, address: BitVec(64), byte: BitVec(8),
    different: is_zero_bits(64, pointer.bxor(address)) = False):
    call_memory_read(call_memory_write(memory, pointer, byte), address) = call_memory_read(memory, address) {
    cong_fn<BitVec(8), Option<BitVec(8)>>(λ value =>
        call_read_choice(static_elf64_read(memory.file, address), stack_page(address), value),
        stack_write_away(memory, pointer, address, byte, different))
}
theorem memory_write_effect(memory: CallMemory, pointer: BitVec(64), byte: BitVec(8)):
    WritesOnly(call_memory_read, ByteWrite(pointer), memory, call_memory_write(memory, pointer, byte)) {
    λ address outside => memory_write_away(memory, pointer, address, byte,
        not_true_is_false(is_zero_bits(64, pointer.bxor(address)), outside))
}

fn call_read_value(byte: Option<BitVec(8)>) → BitVec(8) {
    match byte { Some(value) => value, None => BitVec::zero() }
}

// Exact byte footprint of a canonical little-endian word store.
fn WordPrefixWrites(count: Nat, pointer, address: BitVec(64)) → Type {
    match count {
        Zero => False,
        Succ(rest) => WordPrefixWrites(rest, pointer, address) ∨
            ByteWrite(pointer.add(BitVec::ofNat(rest)), address),
    }
}
theorem byte_write_excluded(pointer, address: BitVec(64),
    different: is_zero_bits(64, pointer.bxor(address)) = False): ¬ByteWrite(pointer, address) {
    λ hit => absurd(trans<Bool>(sym(hit), different))
}
theorem word_prefix_excluded(count: Nat, pointer, address: BitVec(64),
    previous: ¬WordPrefixWrites(count, pointer, address),
    last: ¬ByteWrite(pointer.add(BitVec::ofNat(count)), address)):
    ¬WordPrefixWrites(Succ(count), pointer, address) {
    λ hit => match hit { Inl(old) => previous(old), Inr(byte) => last(byte) }
}
theorem stack_byte_write_effect(memory: CallMemory, pointer: BitVec(64), byte: BitVec(8)):
    WritesOnly(stack_observation, ByteWrite(pointer), memory, call_memory_write(memory, pointer, byte)) {
    λ address outside => stack_write_away(memory, pointer, address, byte,
        not_true_is_false(is_zero_bits(64, pointer.bxor(address)), outside))
}
theorem word_memory_effect_0(memory: CallMemory, pointer, value: BitVec(64)):
    WritesOnly(call_memory_read, λ address => WordPrefixWrites(0, pointer, address), memory, word_write_0(call_stack_access(), value, memory, pointer)) {
    writes_only_equal(call_memory_read, λ address => WordPrefixWrites(0, pointer, address), memory, memory, refl)
}
theorem word_memory_effect_1(memory: CallMemory, pointer, value: BitVec(64)):
    WritesOnly(call_memory_read, λ address => WordPrefixWrites(1, pointer, address), memory, word_write_1(call_stack_access(), value, memory, pointer)) {
    writes_only_compose(call_memory_read, λ address => WordPrefixWrites(0, pointer, address), ByteWrite(pointer.add(BitVec::ofNat(0))), memory, word_write_0(call_stack_access(), value, memory, pointer), word_write_1(call_stack_access(), value, memory, pointer), word_memory_effect_0(memory, pointer, value), memory_write_effect(word_write_0(call_stack_access(), value, memory, pointer), pointer.add(BitVec::ofNat(0)), imm_byte0(value)))
}

// FunctionIR v1 and `simulate` — the load-bearing spec object of certifying
// compilation, written in Heather. Design: docs/ir-simulate-design.md;
// tracking issue: issues/ir-simulate-design.md. This is the first real
// Heather library file in the repo; deviations of this implementation from
// the design sketch are recorded in the doc's §13 (implementation notes).
//
// Shape summary (doc §2–3, adapted): term-form RVSDG in let-normal form.
// A region is a chain of Let* instructions ending in Ret; references are
// de-Bruijn-style distances into a cons-list environment (0 = most recent
// binding). Control flow exists only structurally: LetMatch (gamma) and
// LetLoop (theta). Multi-output is multi-slot binding: a sub-region's Out
// values are prepended onto the environment, most-significant first.
//
// Contents: the datatypes and `simulate` first; then the FUEL INTERFACE
// (doc §6) — `step_mono`, `fuel_monotone` in two shapes, `converges` and
// `refines` in BOTH the ∃-form and the bounded form, and `add_equiv`, a
// ∀-arguments certificate exported both ways.
//
// `converges` is now written as §6 states it — `record Converges(p, env, ir,
// vs) { n: Nat, h: eval(n, p)(env, ir) = Out(vs) }`, a value-parameterized
// record (docs/surface-value-parameters.md, issues/surface-existential.md
// route 1). The bound is genuinely hidden, so `refines_trans_conv` is
// implication chaining with no fuel map. The computed-bound form stays
// alongside it, additive: `refines_of_bounded` is the ∃-closure between them,
// proved rather than asserted, which is why nothing here was re-proved.
// Doc §13 note 7 records this amendment and the rest of the deviations.
//
// Scoping (doc §13): LetMatch arms are lexical — an arm sees the matched
// value's fields on top of the enclosing environment. LetLoop bodies and
// called functions are closed — a loop body sees only the carried slots,
// a function body only its arguments. LoopIter is simulate's internal
// re-entry form; builders never emit it (evaluating it directly is defined,
// it just re-enters the loop protocol).

// The Nat kit — `add`, `sub`, `leb`/`Le` and the order lemmas — is `lib/std/nat`
// now (docs/modules-design.md §7). It was declared here, verbatim, until
// modules existed; `import nat;` puts all of it in scope unqualified.
import nat;

// ---------------------------------------------------------------------------
// Values: untyped constructor trees (doc §4). One inductive doubles as the
// value form and the value-list form: a VCon's fields, an environment, and
// an Out payload are all VCons-chains. Junk (a VCon whose fields chain ends
// in a VCon) is representable and harmless: simulate answers Stuck.

inductive Val {
    VNil,
    VCons(head: Val, tail: Val),
    VCon(tag: Nat, fields: Val),
}

inductive OptVal { NoneV, SomeV(v: Val) }

// ---------------------------------------------------------------------------
// Syntax. References are Nats; argument lists are Refs-chains (in slot
// order); a Prog is a chain of function bodies, called by position.

inductive Refs { RNil, RCons(i: Nat, next: Refs) }

inductive Ir {
    // end a region: the listed slots, in order, are its outputs
    Ret(rs: Refs),
    // build VCon(tag, args); binds 1 slot
    LetCon(tag: Nat, args: Refs, rest: Ir),
    // gamma-as-match: scrutinize slot `scrut` (must be a VCon); run the
    // arm picked by its tag with the fields prepended; bind the arm
    // region's outputs; continue with `rest`
    LetMatch(scrut: Nat, arms: Ir, rest: Ir),
    // an arm-chain cell (arm for tag 0, then tag 1, ...); NoArm ends the
    // chain. Neither is an instruction: evaluated directly they are Stuck.
    Arm(body: Ir, next: Ir),
    NoArm,
    // theta: gather `init` as the carried slots; iterate `body` in a closed
    // environment of exactly the carried slots. The body's outputs are
    // VCons(flag, carried'): flag tag 0 stops (carried' are the loop's
    // outputs), tag 1 continues with carried'. Binds the final carried
    // slots; continues with `rest`.
    LetLoop(init: Refs, body: Ir, rest: Ir),
    // internal: one loop iteration, environment = carried slots only
    LoopIter(body: Ir),
    // call function `callee` of the Prog on the gathered `args` (closed);
    // bind the call's outputs; continue with `rest`
    LetCall(callee: Nat, args: Refs, rest: Ir),
}

inductive Prog { PNil, PFun(body: Ir, next: Prog) }

// simulate's result (doc §5): explicit stuckness and fuel exhaustion.
// Out carries the region's output slots as a VCons-chain.
inductive Res { Stuck, OutOfFuel, Out(vals: Val) }

// A non-recursive dispatch table for `Ir`. Unlike an algebra, recursive
// fields stay as `Ir`: a Cases value describes one layer of case analysis or
// open recursion, and a caller decides what recursive function (if any) its
// clauses close over. `step_cases` below is the real consumer — its clauses
// close over the fuel-indexed recursive call `ev`.
record IrCases<M> {
    ret: Refs -> M,
    letcon: Nat -> Refs -> Ir -> M,
    letmatch: Nat -> Ir -> Ir -> M,
    arm: Ir -> Ir -> M,
    noarm: M,
    letloop: Refs -> Ir -> Ir -> M,
    loopiter: Ir -> M,
    letcall: Nat -> Refs -> Ir -> M,
}

fn ir_cases<M>(cases: IrCases<M>, ir: Ir) -> M {
    match ir {
        Ret(rs) => cases.ret(rs),
        LetCon(tag, args, rest) => cases.letcon(tag, args, rest),
        LetMatch(scrut, arms, rest) => cases.letmatch(scrut, arms, rest),
        Arm(body, next) => cases.arm(body, next),
        NoArm => cases.noarm,
        LetLoop(init, body, rest) => cases.letloop(init, body, rest),
        LoopIter(body) => cases.loopiter(body),
        LetCall(callee, args, rest) => cases.letcall(callee, args, rest),
    }
}

// ---------------------------------------------------------------------------
// Environment helpers. The termination discipline shapes every signature
// here: a recursive fn must pass its non-decreasing parameters unchanged,
// so where two arguments vary together the varying one is returned as a
// function instead (lookup, pick_arm, find_fun).

// slot `i` of the environment, 0 = most recent
fn lookup(env: Val) -> Nat -> OptVal {
    match env {
        VNil => λ (i: Nat) => NoneV,
        VCon(tag, fs) => λ (i: Nat) => NoneV,
        VCons(h, t) => λ (i: Nat) => match i { Zero => SomeV(h), Succ(k) => lookup(t)(k) },
    }
}

// read the listed slots, in order; NoneV if any is out of range
fn gather(rs: Refs, env: Val) -> OptVal {
    match rs {
        RNil => SomeV(VNil),
        RCons(i, next) =>
            match lookup(env)(i) {
                NoneV => NoneV,
                SomeV(v) =>
                    match gather(next, env) {
                        NoneV => NoneV,
                        SomeV(vs) => SomeV(VCons(v, vs)),
                    },
            },
    }
}

// prepend the chain `a` onto `b` (a's head stays slot 0)
fn append(a: Val, b: Val) -> Val {
    match a {
        VNil => b,
        VCon(tag, fs) => b,
        VCons(h, t) => VCons(h, append(t, b)),
    }
}

// arm for `tag` out of an Arm-chain; NoArm when the chain is short
// The seven non-`Arm` constructors all answer `NoArm`, and the `_` arm is
// the sugar for exactly that (docs/nested-match-patterns-design.md §4). It is
// available in the *decreasing* position — this `match` is what installs the
// guard `pick_arm(next)` reads — because `_` binds nothing the guard looks at
// (§6.2). The body is elaborated once and shared across the seven expanded
// arms, since the motive here does not mention the scrutinee (§5).
fn pick_arm(arms: Ir) -> Nat -> Ir {
    match arms {
        Arm(body, next) => λ (tag: Nat) => match tag { Zero => body, Succ(t2) => pick_arm(next)(t2) },
        _ => λ (tag: Nat) => NoArm,
    }
}

// body of function `f` in the Prog chain; NoArm (which is Stuck to
// evaluate) when there is no such function
fn find_fun(prog: Prog) -> Nat -> Ir {
    match prog {
        PNil => λ (f: Nat) => NoArm,
        PFun(body, next) => λ (f: Nat) => match f { Zero => body, Succ(g) => find_fun(next)(g) },
    }
}

// ---------------------------------------------------------------------------
// simulate (doc §5). Structured as recursion on fuel alone: the termination
// checker wants a single decreasing argument with the rest fixed, so the
// varying state (environment, instruction) lives in a returned function and
// every recursive step spends one fuel. Fuel is therefore a step count in
// v1, not a theta/apply count — private to this definition either way; the
// stated interface is `converges` (doc §6).
//
// The recursion is factored so `eval(k, prog)` — the induction hypothesis,
// a large inlined eliminator term — occurs exactly ONCE per level, passed
// to a single dispatch function as the value `ev`; everything downstream
// copies a bound variable, not the term.
//
// This was a measured CLIFF and is now a measured constant. Measured then
// (chain-of-5-LetCons probe, release, 2026-07-31, term-rewriting
// conversion): each syntactic occurrence of the self-call cost ~50ms per
// fuel step — 0.24s with one occurrence, 13.7s with ~10, the doc §5
// cost-model warning made concrete. Measured now (same day, value-domain
// conversion, this whole file): inlining `step`'s dispatch into `eval` so
// the self-call occurs six times instead of once costs 1.28s → 1.58s,
// **1.24×**. Duplicating the ih no longer duplicates work, because a
// duplicated occurrence evaluates to a shared value instead of a copied
// term. The factoring stays — it is still free and still the clearer
// reading — but it is no longer load-bearing, and a library that wants a
// different shape is no longer paying orders of magnitude for it.

fn step_ret(env: Val, rs: Refs) -> Res {
    match gather(rs, env) { NoneV => Stuck, SomeV(vs) => Out(vs) }
}

fn step_letcon(ev: Val -> Ir -> Res, env: Val, tag: Nat, args: Refs, rest: Ir) -> Res {
    match gather(args, env) {
        NoneV => Stuck,
        SomeV(vs) => ev(VCons(VCon(tag, vs), env), rest),
    }
}

// The two-level tower written as one decision tree
// (docs/nested-match-patterns-design.md §3.2). The `_` row is the
// fallthrough for `VNil`/`VCons` *and* for `NoneV`; the inner `match` on the
// evaluation result stays written out, because its arms differ.
fn step_letmatch(ev: Val -> Ir -> Res, env: Val, scrut: Nat, arms: Ir, rest: Ir) -> Res {
    match lookup(env)(scrut) {
        SomeV(VCon(tag, fields)) =>
            match ev(append(fields, env), pick_arm(arms)(tag)) {
                Stuck => Stuck,
                OutOfFuel => OutOfFuel,
                Out(vs) => ev(append(vs, env), rest),
            },
        _ => Stuck,
    }
}

fn step_letloop(ev: Val -> Ir -> Res, env: Val, init: Refs, body: Ir, rest: Ir) -> Res {
    match gather(init, env) {
        NoneV => Stuck,
        SomeV(vs) =>
            match ev(vs, LoopIter(body)) {
                Stuck => Stuck,
                OutOfFuel => OutOfFuel,
                Out(fin) => ev(append(fin, env), rest),
            },
    }
}

// Three levels of tower as one decision tree, `ftag` included: the `Nat`
// column is split by the same machinery as the `Val` ones, and the two rows
// that reach it carry `carried` down past two splits
// (docs/nested-match-patterns-design.md §3.2).
fn step_loopiter(ev: Val -> Ir -> Res, env: Val, body: Ir) -> Res {
    match ev(env, body) {
        OutOfFuel => OutOfFuel,
        Out(VCons(VCon(Zero, ffields), carried)) => Out(carried),
        Out(VCons(VCon(Succ(f2), ffields), carried)) => ev(carried, LoopIter(body)),
        _ => Stuck,
    }
}

fn step_letcall(ev: Val -> Ir -> Res, prog: Prog, env: Val, callee: Nat, args: Refs, rest: Ir) -> Res {
    match gather(args, env) {
        NoneV => Stuck,
        SomeV(vs) =>
            match ev(vs, find_fun(prog)(callee)) {
                Stuck => Stuck,
                OutOfFuel => OutOfFuel,
                Out(outs) => ev(append(outs, env), rest),
            },
    }
}

// Reify the interpreter's clause table. `ev` is deliberately a captured
// value, not tied recursively here: eval supplies its one fuel-decreasing IH,
// while another consumer may supply a different open-recursion discipline.
fn step_cases(ev: Val -> Ir -> Res, prog: Prog, env: Val) -> IrCases<Res> {
    IrCases<Res> {
        ret: λ rs => step_ret(env, rs),
        letcon: λ tag args rest => step_letcon(ev, env, tag, args, rest),
        letmatch: λ scrut arms rest => step_letmatch(ev, env, scrut, arms, rest),
        arm: λ body next => Stuck,
        noarm: Stuck,
        letloop: λ init body rest => step_letloop(ev, env, init, body, rest),
        loopiter: λ body => step_loopiter(ev, env, body),
        letcall: λ callee args rest => step_letcall(ev, prog, env, callee, args, rest),
    }
}

// one step: select a clause from the first-class table
fn step(ev: Val -> Ir -> Res, prog: Prog, env: Val, ir: Ir) -> Res {
    ir_cases(step_cases(ev, prog, env), ir)
}

fn eval(fuel: Nat, prog: Prog) -> Val -> Ir -> Res {
    match fuel {
        Zero => λ (env: Val) (ir: Ir) => OutOfFuel,
        Succ(k) => λ (env: Val) (ir: Ir) => step(eval(k, prog), prog, env, ir),
    }
}

// ---------------------------------------------------------------------------
// Embedding (doc §4): spec Nat as a constructor tree. Zero is tag 0 with no
// fields, Succ is tag 1 with one field.

fn embed_nat(n: Nat) -> Val {
    match n {
        Zero => VCon(0, VNil),
        Succ(k) => VCon(1, VCons(embed_nat(k), VNil)),
    }
}

// ---------------------------------------------------------------------------
// The first program: addition as a theta loop (doc §11 item 2). Carried
// slots (n, acc), starting at (a, b); while n is a Succ, step to
// (pred, Succ(acc)). Loop-body slot map: [n, acc].

// Zero arm: env [n, acc]; emit stop flag; results (flag, n, acc)
fn add_arm_zero() -> Ir { LetCon(0, RNil, Ret(RCons(0, RCons(1, RCons(2, RNil))))) }

// Succ arm: env [pred, n, acc]; acc' = Succ(acc), flag = continue;
// results (flag, pred, acc')
fn add_arm_succ() -> Ir {
    LetCon(1, RCons(2, RNil),
        LetCon(1, RNil,
            Ret(RCons(0, RCons(2, RCons(1, RNil))))))
}

// loop body: match n; the arm's three outputs are rebound, then returned —
// exactly the VCons(flag, carried') chain LoopIter consumes
fn add_loop_body() -> Ir {
    LetMatch(0, Arm(add_arm_zero(), Arm(add_arm_succ(), NoArm)),
        Ret(RCons(0, RCons(1, RCons(2, RNil)))))
}

// function body: env [a, b]; loop from (a, b); final carried is
// [n_final, acc_final]; the answer is acc_final
fn add_body() -> Ir {
    LetLoop(RCons(0, RCons(1, RNil)), add_loop_body(),
        Ret(RCons(1, RNil)))
}

fn add_prog() -> Prog { PFun(add_body(), PNil) }

// a one-function Prog whose function returns its argument; LetCall is
// exercised against it at the cheapest possible depth. The *combined* path
// — calling into the add loop and back — is certified below, and it no
// longer needs a separate file: see the theorems' comment.
fn id_prog() -> Prog { PFun(Ret(RCons(0, RNil)), PNil) }

// ===========================================================================
// The fuel interface (doc §6). Continuation helpers first: each names one of
// `step`'s intermediate scrutinees as a function of the value being
// scrutinized, so a proof can case on that value with a SMALL motive
// (`λ o => k(ev1, …, o) = Out(vs) -> k(ev2, …, o) = Out(vs)`) instead of
// spelling the whole match inside the motive twice. They are definitionally
// equal to the corresponding fragment of `step_*`, so nothing in `simulate`
// changes and no theorem below has to be restated in terms of them.

// the shared tail of LetMatch / LetLoop / LetCall: a sub-region has answered,
// and its outputs are rebound before `rest` runs
fn k_bind(ev: Val -> Ir -> Res, env: Val, rest: Ir, r: Res) -> Res {
    match r {
        Stuck => Stuck,
        OutOfFuel => OutOfFuel,
        Out(ws) => ev(append(ws, env), rest),
    }
}

// `step_ret`'s match, as a function of the gathered slots — the same move as
// the others, wanted by the ∃-composition kit's `ret_conv` motive
fn k_ret(o: OptVal) -> Res {
    match o { NoneV => Stuck, SomeV(vs) => Out(vs) }
}

fn k_letcon(ev: Val -> Ir -> Res, env: Val, tag: Nat, rest: Ir, o: OptVal) -> Res {
    match o { NoneV => Stuck, SomeV(ws) => ev(VCons(VCon(tag, ws), env), rest) }
}

fn k_letmatch_v(ev: Val -> Ir -> Res, env: Val, arms: Ir, rest: Ir, v: Val) -> Res {
    match v {
        VNil => Stuck,
        VCons(h, t) => Stuck,
        VCon(tag, fields) =>
            k_bind(ev, env, rest, ev(append(fields, env), pick_arm(arms)(tag))),
    }
}

fn k_letmatch(ev: Val -> Ir -> Res, env: Val, arms: Ir, rest: Ir, o: OptVal) -> Res {
    match o { NoneV => Stuck, SomeV(v) => k_letmatch_v(ev, env, arms, rest, v) }
}

fn k_letloop(ev: Val -> Ir -> Res, env: Val, body: Ir, rest: Ir, o: OptVal) -> Res {
    match o {
        NoneV => Stuck,
        SomeV(ws) => k_bind(ev, env, rest, ev(ws, LoopIter(body))),
    }
}

fn k_letcall(ev: Val -> Ir -> Res, prog: Prog, env: Val, callee: Nat, rest: Ir, o: OptVal) -> Res {
    match o {
        NoneV => Stuck,
        SomeV(ws) => k_bind(ev, env, rest, ev(ws, find_fun(prog)(callee))),
    }
}

fn k_iter_tag(ev: Val -> Ir -> Res, body: Ir, carried: Val, ftag: Nat) -> Res {
    match ftag { Zero => Out(carried), Succ(f2) => ev(carried, LoopIter(body)) }
}

fn k_iter_flag(ev: Val -> Ir -> Res, body: Ir, carried: Val, flag: Val) -> Res {
    match flag {
        VNil => Stuck,
        VCons(h, t) => Stuck,
        VCon(ftag, ffields) => k_iter_tag(ev, body, carried, ftag),
    }
}

fn k_iter_vals(ev: Val -> Ir -> Res, body: Ir, ws: Val) -> Res {
    match ws {
        VNil => Stuck,
        VCon(tag, fields) => Stuck,
        VCons(flag, carried) => k_iter_flag(ev, body, carried, flag),
    }
}

fn k_iter(ev: Val -> Ir -> Res, body: Ir, r: Res) -> Res {
    match r {
        Stuck => Stuck,
        OutOfFuel => OutOfFuel,
        Out(ws) => k_iter_vals(ev, body, ws),
    }
}


// The order on Nat — `Bool`, `leb`, `Le`, `sub` — is `nat`'s
// (docs/modules-design.md §7). `<=` is surface notation for a call to `Le`
// (issues/comparison-operators.md), so the spellings below are unchanged by
// the move: `<=` where the order is being *stated*, and the explicit `Le`
// inside explicit motives, where an infix operator would read as one more
// thing to disentangle rather than one fewer.


// ---------------------------------------------------------------------------
// The refinement chain (doc §6 stress test): the same add function reached
// through zero, one and two levels of `LetCall`.
// the chain: fun 0 is the add loop, fun 1 calls fun 0
fn add_chain() -> Prog {
    PFun(add_body(),
        PFun(LetCall(0, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))), PNil))
}

fn ir_loop() -> Ir { add_body() }
fn ir_call1() -> Ir { LetCall(0, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))) }
fn ir_call2() -> Ir { LetCall(1, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))) }

fn plus2() -> Nat -> Nat { λ (n: Nat) => Succ(Succ(n)) }


// ---------------------------------------------------------------------------
// The first end-to-end certificate (doc §11 item 4): an `equiv`-shaped
// theorem for `add`, for ALL arguments, discharged at a COMPUTED fuel bound,
// with `fuel_monotone` bridging it to the stated form.
//
// `add` recurses on its second argument, so `add(k, 4)` is `k` under four
// successors and reduces at an open `k` — which is what lets a fuel bound be
// a term the interpreter can actually consume.

// succ applied `k` times, curried because the accumulator varies with the
// recursion (doc §13 note 2, the same reason `lookup` is curried)
fn bumps(k: Nat) -> Val -> Val {
    match k {
        Zero => λ (a: Val) => a,
        Succ(k2) => λ (a: Val) => bumps(k2)(VCon(1, VCons(a, VNil))),
    }
}


// ---------------------------------------------------------------------------
// Acceptance (doc §11 items 2 and 6): simulate discharges by conversion at
// literal fuel, against the embedded spec result.
//
// COST, and why the deep theorems are here now. This file's cost model was
// rewritten three times. It was 107s; 13.6s once substitution stopped
// visiting closed subtrees; ~2s once a `fn` became a Ψ-definition instead
// of a copy at every use site (issues/simulate-conversion-cost.md). All
// three left the real defect standing: cost was EXPONENTIAL in the nesting
// depth of scrutinee-position `ev(…)` calls, ~×22 per add-loop iteration in
// time and in resident memory alike, because reduction copied a branch
// bundle per level and nothing shared the copies
// (issues/whnf-sharing-term-growth.md). A combined `add(2,3)` through
// LetCall cost 20.9s and peaked at ~1.5 GB, and `add(3,·)` reached ~22 GB
// and would take the machine down — so the loop and the call were certified
// on separate short paths, and this comment used to say so.
//
// It no longer holds. Conversion now evaluates into a value domain where an
// eliminator's β extends an environment instead of copying a branch
// (issues/nbe-conversion-round.md), and the exponent is gone: measured
// 2026-07-31, release, under the rail, the whole file including the two
// combined theorems below checks in **1.25s at 14.4 MB peak** — 1.13s of
// which is the declarations. `add(2,3)` through LetCall went 20.9s → ~0.05s
// and `add(3,4)`, the shape that used to reach 22 GB, adds ~0.11s.
// What remains true: unused fuel is free and executed steps are not.
//
// UPDATED 2026-07-31, second round: the fuel interface below takes the file
// from 1.31s / 14.2 MB to **26.9s / 18.6 MB**, of which the declarations are
// still 1.07s. The added time is almost entirely `step_mono`
// (1.79s → 19.8s for that one theorem): its motive Π-quantifies nothing at
// all, but the eight-arm case tree it forces makes `step` unfold once per
// constructor with two interpreters in scope. That is the measured price of
// the manual explicit-motive route, and it is a term-SIZE price rather than
// a reduction one — memory barely moved (issues/ih-generalization.md).

// The public computational face of the Cases object. These are the exact
// datatype-shaped equations a future generator could emit; all are
// definitional because `ir_cases` is the ordinary non-recursive eliminator.
theorem ir_cases_ret<M>(cases: IrCases<M>, rs: Refs):
    ir_cases(cases, Ret(rs)) = cases.ret(rs)
{}

theorem ir_cases_letcon<M>(cases: IrCases<M>, tag: Nat, args: Refs, rest: Ir):
    ir_cases(cases, LetCon(tag, args, rest)) = cases.letcon(tag, args, rest)
{}

theorem ir_cases_letmatch<M>(cases: IrCases<M>, scrut: Nat, arms, rest: Ir):
    ir_cases(cases, LetMatch(scrut, arms, rest)) = cases.letmatch(scrut, arms, rest)
{}

theorem ir_cases_arm<M>(cases: IrCases<M>, body, next: Ir):
    ir_cases(cases, Arm(body, next)) = cases.arm(body, next)
{}

theorem ir_cases_noarm<M>(cases: IrCases<M>):
    ir_cases(cases, NoArm) = cases.noarm
{}

theorem ir_cases_letloop<M>(cases: IrCases<M>, init: Refs, body, rest: Ir):
    ir_cases(cases, LetLoop(init, body, rest)) = cases.letloop(init, body, rest)
{}

theorem ir_cases_loopiter<M>(cases: IrCases<M>, body: Ir):
    ir_cases(cases, LoopIter(body)) = cases.loopiter(body)
{}

theorem ir_cases_letcall<M>(cases: IrCases<M>, callee: Nat, args: Refs, rest: Ir):
    ir_cases(cases, LetCall(callee, args, rest)) = cases.letcall(callee, args, rest)
{}

theorem step_is_cases(ev: Val -> Ir -> Res, prog: Prog, env: Val, ir: Ir):
    step(ev, prog, env, ir) = ir_cases(step_cases(ev, prog, env), ir)
{}

// 1 + 1 = 2 through the loop: LetLoop/LoopIter, LetMatch with BOTH arms
// taken (Succ on iteration one, Zero on iteration two), LetCon,
// multi-slot rebinding, Ret
theorem add_one_one():
    eval(50, add_prog())(VCons(embed_nat(1), VCons(embed_nat(1), VNil)), add_body())
    = Out(VCons(embed_nat(2), VNil))
{ refl }

// a value survives a round-trip through LetCall: find_fun, the closed
// call environment, output rebinding
theorem call_identity():
    eval(9, id_prog())(VCons(VCon(4, VNil), VNil), LetCall(0, RCons(0, RNil), Ret(RCons(0, RNil))))
    = Out(VCons(VCon(4, VNil), VNil))
{ refl }

// the loop and the call on ONE path: LetCall into the add function, two
// loop iterations inside it, results rebound and returned through the
// caller's env. This is the theorem the cost comment above says was 20.9s
// and ~1.5 GB before the value domain.
theorem call_add_two_three():
    eval(50, add_prog())(VCons(embed_nat(2), VCons(embed_nat(3), VNil)),
        LetCall(0, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))))
    = Out(VCons(embed_nat(5), VNil))
{ refl }

// the same at three iterations — the shape that used to reach ~22 GB
theorem call_add_three_four():
    eval(80, add_prog())(VCons(embed_nat(3), VCons(embed_nat(4), VNil)),
        LetCall(0, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))))
    = Out(VCons(embed_nat(7), VNil))
{ refl }

// the endpoints agree with the spec function on the same literals
theorem spec_agrees(): add(1, 1) = 2 { refl }

// negative controls (doc §11 item 6):
// an out-of-range reference is Stuck, not an answer
theorem junk_ref_sticks():
    eval(5, PNil)(VNil, Ret(RCons(0, RNil))) = Stuck
{ refl }

// a tag with no arm is Stuck
theorem missing_arm_sticks():
    eval(9, PNil)(VCons(VCon(7, VNil), VNil), LetMatch(0, Arm(NoArm, NoArm), Ret(RNil)))
    = Stuck
{ refl }

// calling a function the Prog does not have is Stuck
theorem missing_fun_sticks():
    eval(9, PNil)(VCons(VNil, VNil), LetCall(0, RCons(0, RNil), Ret(RCons(0, RNil))))
    = Stuck
{ refl }

// insufficient fuel is OutOfFuel, not Stuck and not an answer
theorem short_fuel():
    eval(0, add_prog())(VNil, Ret(RNil)) = OutOfFuel
{ refl }

theorem short_fuel_mid_loop():
    eval(4, add_prog())(VCons(embed_nat(2), VCons(embed_nat(3), VNil)), add_body())
    = OutOfFuel
{ refl }
// sanity: each helper really is the fragment of `step` it claims to be, so
// the theorems below may move freely between the two spellings
theorem k_letcon_is_step(ev: Val -> Ir -> Res, env: Val, tag: Nat, args: Refs, rest: Ir):
    step_letcon(ev, env, tag, args, rest) = k_letcon(ev, env, tag, rest, gather(args, env))
{ refl }

theorem k_letmatch_is_step(ev: Val -> Ir -> Res, env: Val, scrut: Nat, arms: Ir, rest: Ir):
    step_letmatch(ev, env, scrut, arms, rest)
    = k_letmatch(ev, env, arms, rest, lookup(env)(scrut))
{ refl }

theorem k_letloop_is_step(ev: Val -> Ir -> Res, env: Val, init: Refs, body: Ir, rest: Ir):
    step_letloop(ev, env, init, body, rest)
    = k_letloop(ev, env, body, rest, gather(init, env))
{ refl }

theorem k_letcall_is_step(ev: Val -> Ir -> Res, prog: Prog, env: Val, callee: Nat, args: Refs, rest: Ir):
    step_letcall(ev, prog, env, callee, args, rest)
    = k_letcall(ev, prog, env, callee, rest, gather(args, env))
{ refl }

theorem k_iter_is_step(ev: Val -> Ir -> Res, env: Val, body: Ir):
    step_loopiter(ev, env, body) = k_iter(ev, body, ev(env, body))
{ refl }

// ---------------------------------------------------------------------------
// INVERSION for `k_bind`, as a value-parameterized record — the surface's
// value-indexed Σ (docs/surface-value-parameters.md; issues/surface-existential
// route 1). The statement is the existential the issue could not write:
//
//     k_bind(ev, env, rest, r) = Out(vs) -> ∃ ws. r = Out(ws) × ev(ws ++ env, rest) = Out(vs)
//
// A record with three fields IS that multi-witness Σ: the spine is
// right-nested internally and each field's type may mention the earlier ones,
// which is exactly what an iterated ∃ needs. The value parameters are what make
// it a *predicate* over this particular `r` and `vs` rather than a claim that
// some `k_bind` somewhere converged.
//
// `ev` is a function-valued parameter, which is fine: a record's field
// restriction keys on self-occurrence, not on shape. (`inj` on `BindInv` would
// not derive — it has dependent fields — and nothing needs it.)

record BindInv(ev: Val -> Ir -> Res, env: Val, rest: Ir, r: Res, vs: Val) {
    ws: Val,
    hr: r = Out(ws),
    hk: ev(append(ws, env), rest) = Out(vs),
}

// Proved ONCE, by casing on the answer with the *target* varying in the motive
// — so this does not even need the remember idiom that the inline convoys did:
// the conclusion's `r` is the scrutinee, so each arm's goal is already
// specialized.
theorem k_bind_inv(ev: Val -> Ir -> Res, env: Val, rest: Ir, r: Res, vs: Val,
                   h: k_bind(ev, env, rest, r) = Out(vs))
    : BindInv(ev, env, rest, r, vs)
{
    match r as λ y => k_bind(ev, env, rest, y) = Out(vs) -> BindInv(ev, env, rest, y, vs) {
        Stuck => λ q => absurd(q),
        OutOfFuel => λ q => absurd(q),
        Out(ws) => λ q => BindInv(ws, refl, q),
    }(h)
}

// …and the one consumer `step_mono` needs, three times over: a `k_bind` whose
// scrutinee is a recursive call is monotone in that call. Destructuring the
// inversion is a `let { }`, which is what replaces the convoy match.
theorem k_bind_mono(ev1: Val -> Ir -> Res, ev2: Val -> Ir -> Res,
                    hyp: (e: Val, i: Ir, w: Val) -> ev1(e, i) = Out(w) -> ev2(e, i) = Out(w),
                    env: Val, rest: Ir, e0: Val, i0: Ir, vs: Val,
                    q: k_bind(ev1, env, rest, ev1(e0, i0)) = Out(vs))
    : k_bind(ev2, env, rest, ev2(e0, i0)) = Out(vs)
{
    let { ws, hr, hk } = k_bind_inv(ev1, env, rest, ev1(e0, i0), vs, q);
    j(sym(hyp(e0, i0, ws, hr)),
      λ y p => k_bind(ev2, env, rest, y) = Out(vs),
      hyp(append(ws, env), rest, vs, hk))
}

// ---------------------------------------------------------------------------
// One step is monotone in its recursive call. This is the whole case analysis
// of `fuel_monotone`: everything about the IR happens here, and the induction
// on fuel below is two lines.
//
// Where a sub-region's answer is scrutinized, the arm needs the equation the
// match does not hand it. Three of the four such places are `k_bind` at a
// recursive call and are now one call to `k_bind_mono` above — the inversion
// record doing what four hand-rolled convoy motives used to. The fourth,
// `LoopIter`, scrutinizes through `k_iter` rather than `k_bind`, and it now
// says so in one token: `match h : ev1(env, lbody)` binds
// `h : ev1(env, lbody) = Out(ws)` in each arm and the elaborator writes the
// convoy motive and the `refl` it is applied to
// (docs/match-equation-split-design.md §3). Giving it its own inversion record
// as well is the same move as `k_bind_inv` and is left for a second consumer.

theorem step_mono(prog: Prog, ev1: Val -> Ir -> Res, ev2: Val -> Ir -> Res,
                  hyp: (e: Val, i: Ir, w: Val) -> ev1(e, i) = Out(w) -> ev2(e, i) = Out(w),
                  env: Val, ir: Ir, vs: Val)
    : step(ev1, prog, env, ir) = Out(vs) -> step(ev2, prog, env, ir) = Out(vs)
{
    match ir as λ z => step(ev1, prog, env, z) = Out(vs) -> step(ev2, prog, env, z) = Out(vs) {
        // no recursive call at all
        Ret(rs) => λ q => q,
        Arm(abody, anext) => λ q => q,
        NoArm => λ q => q,

        // one tail call, under a gather
        LetCon(tag, args, rest) =>
            match gather(args, env) as λ o =>
                k_letcon(ev1, env, tag, rest, o) = Out(vs)
                -> k_letcon(ev2, env, tag, rest, o) = Out(vs) {
                NoneV => λ q => q,
                SomeV(ws) => λ q => hyp(VCons(VCon(tag, ws), env), rest, vs, q),
            },

        // a sub-region, then a tail call
        LetMatch(scrut, arms, rest) =>
            match lookup(env)(scrut) as λ o =>
                k_letmatch(ev1, env, arms, rest, o) = Out(vs)
                -> k_letmatch(ev2, env, arms, rest, o) = Out(vs) {
                NoneV => λ q => q,
                SomeV(v) =>
                    match v as λ y =>
                        k_letmatch_v(ev1, env, arms, rest, y) = Out(vs)
                        -> k_letmatch_v(ev2, env, arms, rest, y) = Out(vs) {
                        VNil => λ q => q,
                        VCons(vh, vt) => λ q => q,
                        VCon(tag, fields) => λ q =>
                            k_bind_mono(ev1, ev2, hyp, env, rest,
                                        append(fields, env), pick_arm(arms)(tag), vs, q),
                    },
            },

        LetLoop(init, lbody, rest) =>
            match gather(init, env) as λ o =>
                k_letloop(ev1, env, lbody, rest, o) = Out(vs)
                -> k_letloop(ev2, env, lbody, rest, o) = Out(vs) {
                NoneV => λ q => q,
                SomeV(cs) => λ q =>
                    k_bind_mono(ev1, ev2, hyp, env, rest, cs, LoopIter(lbody), vs, q),
            },

        LetCall(callee, args, rest) =>
            match gather(args, env) as λ o =>
                k_letcall(ev1, prog, env, callee, rest, o) = Out(vs)
                -> k_letcall(ev2, prog, env, callee, rest, o) = Out(vs) {
                NoneV => λ q => q,
                SomeV(cs) => λ q =>
                    k_bind_mono(ev1, ev2, hyp, env, rest, cs, find_fun(prog)(callee), vs, q),
            },

        // the loop's own re-entry: a sub-region, then the protocol, then a
        // tail call at the continue flag
        LoopIter(lbody) =>
            match h : ev1(env, lbody) as λ r =>
                k_iter(ev1, lbody, r) = Out(vs)
                -> k_iter(ev2, lbody, ev2(env, lbody)) = Out(vs) {
                Stuck => λ q => absurd(q),
                OutOfFuel => λ q => absurd(q),
                Out(ws) => λ q =>
                    j(sym(hyp(env, lbody, ws, h)),
                      λ y p => k_iter(ev2, lbody, y) = Out(vs),
                      match ws as λ y =>
                          k_iter_vals(ev1, lbody, y) = Out(vs)
                          -> k_iter_vals(ev2, lbody, y) = Out(vs) {
                          VNil => λ q2 => q2,
                          VCon(t, f) => λ q2 => q2,
                          VCons(flag, carried) =>
                              match flag as λ g =>
                                  k_iter_flag(ev1, lbody, carried, g) = Out(vs)
                                  -> k_iter_flag(ev2, lbody, carried, g) = Out(vs) {
                                  VNil => λ q2 => q2,
                                  VCons(fh, ft) => λ q2 => q2,
                                  VCon(ftag, ffields) =>
                                      match ftag as λ n =>
                                          k_iter_tag(ev1, lbody, carried, n) = Out(vs)
                                          -> k_iter_tag(ev2, lbody, carried, n) = Out(vs) {
                                          Zero => λ q2 => q2,
                                          Succ(f2) => λ q2 => hyp(carried, LoopIter(lbody), vs, q2),
                                      },
                              },
                      }(q)),
            },
    }
}

// ---------------------------------------------------------------------------
// fuel_monotone (doc §6). The induction is on fuel with env, ir and the answer
// GENERALIZED — match-recursion's deferred case — so the motive is written out
// explicitly and the arms λ-wrap (issues/ih-generalization.md).

theorem eval_mono_succ(prog: Prog, n: Nat):
    (env: Val, ir: Ir, vs: Val)
    -> eval(n, prog)(env, ir) = Out(vs) -> eval(Succ(n), prog)(env, ir) = Out(vs)
{
    match n as λ z =>
        (env: Val, ir: Ir, vs: Val)
        -> eval(z, prog)(env, ir) = Out(vs) -> eval(Succ(z), prog)(env, ir) = Out(vs) {
        // no fuel answered nothing: OutOfFuel is not Out
        Zero => λ env ir vs h => absurd(h),
        Succ(k, ih) => λ env ir vs h =>
            step_mono(prog, eval(k, prog), eval(Succ(k), prog), ih, env, ir, vs, h),
    }
}

// the `+ k` shape: `add` recurses on its second argument, so `add(n, k)` is
// `n` with `k` successors on the outside and both arms are definitional
theorem eval_mono_plus(prog: Prog, n: Nat, env: Val, ir: Ir, vs: Val,
                       h: eval(n, prog)(env, ir) = Out(vs), k: Nat)
    : eval(add(n, k), prog)(env, ir) = Out(vs)
{
    match k {
        Zero => h,
        Succ(k2) =>
            eval_mono_succ(prog, add(n, k2))(env, ir, vs,
                eval_mono_plus(prog, n, env, ir, vs, h, k2)),
    }
}
// The arithmetic and order kit `le_add`, `le_refl`, `le_succ_r`, `le_add_l`
// and `le_add_r` — with `cong_nat`, `add_left_zero`, `add_succ_left` and
// `sub_zero` under them — is `nat`'s (docs/modules-design.md §7).

// doc §6, verbatim shape: `simulate(p, f, args, n) == Out(vs) -> n <= m ->
// simulate(p, f, args, m) == Out(vs)`, with `simulate` spelled as the landed
// `eval` — and `n <= m` now spelled `n <= m`.
theorem fuel_monotone(prog: Prog, env: Val, ir: Ir, vs: Val, n: Nat, m: Nat,
                      h: eval(n, prog)(env, ir) = Out(vs), hle: n <= m)
    : eval(m, prog)(env, ir) = Out(vs)
{
    j(le_add(n)(m, hle),
      λ y p => eval(y, prog)(env, ir) = Out(vs),
      eval_mono_plus(prog, n, env, ir, vs, h, sub(m)(n)))
}

// ---------------------------------------------------------------------------
// `converges` (doc §6), AS STATED — the ∃-closure, not the bounded image of
// it. This is the surface's value-indexed Σ: a record whose value parameters
// are the four things the predicate is *about*, and whose two fields are the
// witness and the equation over it (docs/surface-value-parameters.md;
// issues/surface-existential.md route 1).
//
//     converges(p, env, ir, vs)  :=  ∃ n. eval(n, p)(env, ir) = Out(vs)
//
// The bound is now genuinely hidden: `Converges(p, env, ir, vs)` names no
// fuel, which is what §6 wanted and what the bounded form could only
// approximate. Every landed bounded theorem below is the image of this one
// under the ∃-closure, so nothing there is restated or re-proved — the two
// live side by side and `converges_intro`/`conv_loosen` are the bridge.

record Converges(p: Prog, env: Val, ir: Ir, vs: Val) {
    n: Nat,
    h: eval(n, p)(env, ir) = Out(vs),
}

// introduction at a computed bound: the §6 discharge story verbatim
theorem converges_intro(p: Prog, env: Val, ir: Ir, vs: Val, n: Nat,
                        h: eval(n, p)(env, ir) = Out(vs))
    : Converges(p, env, ir, vs)
{ Converges(n, h) }

// `fuel_monotone` as a lemma ABOUT `Converges`: a bound may always be
// loosened, so the ∃-form is closed under adding fuel
theorem conv_loosen(p: Prog, env: Val, ir: Ir, vs: Val, m: Nat,
                    c: Converges(p, env, ir, vs), hle: c.n <= m)
    : eval(m, p)(env, ir) = Out(vs)
{ fuel_monotone(p, env, ir, vs, c.n, m, c.h, hle) }

// FUNCTIONALITY. `eval` is a function of its fuel, so two convergent runs of
// the same program on the same environment answer the same thing — the two
// fuels are raised to their sum, where the two equations meet and `inj` on
// `Out` finishes. This is what lets a refinement be discharged from two
// independent certificates rather than by relating the two executions
// step-by-step: the hypothesis's unknown `vs` is *identified* with the value
// the certificate names.
theorem eval_functional(prog: Prog, env: Val, ir: Ir, vs: Val, ws: Val, n: Nat, m: Nat,
                        h1: eval(n, prog)(env, ir) = Out(vs),
                        h2: eval(m, prog)(env, ir) = Out(ws))
    : vs = ws
{
    inj(trans(sym(fuel_monotone(prog, env, ir, vs, n, add(n, m), h1, le_add_l(n, m))),
              fuel_monotone(prog, env, ir, ws, m, add(n, m), h2, le_add_r(n, m))))
}

// …and the same at the ∃-level, where it is the statement a client wants:
// `Converges` is single-valued.
theorem conv_functional(p: Prog, env: Val, ir: Ir, vs: Val, ws: Val,
                        c1: Converges(p, env, ir, vs), c2: Converges(p, env, ir, ws))
    : vs = ws
{ eval_functional(p, env, ir, vs, ws, c1.n, c2.n, c1.h, c2.h) }

// ---------------------------------------------------------------------------
// The ∃-COMPOSITION KIT (certifying-generator v2; docs/certifying-generator-
// design.md §8 item 1). One `Converges`-introduction lemma per straight-line
// instruction: each takes its computation facts as equation premises (a
// `gather`/`lookup` result over a concrete-spine environment discharges by
// `refl`) and glues sub-certificates with `fuel_monotone`, raising the two
// hidden fuels to their sum. A generated proof is then a fold of these over
// the arm's instruction chain, and NO fuel bound appears in any statement —
// which is what lets a caller's certificate compose with a callee's whose
// bound depends on an open argument (a reducing bound spelling for that sum
// does not exist; the v1 lvl/c0 trick stops at one function).

theorem ret_conv(p: Prog, env: Val, rs: Refs, vs: Val,
                 hg: gather(rs, env) = SomeV(vs))
    : Converges(p, env, Ret(rs), vs)
{ Converges(1, j(sym(hg), λ o q => k_ret(o) = Out(vs), refl)) }

theorem letcon_conv(p: Prog, env: Val, tag: Nat, args: Refs, rest: Ir,
                    fs: Val, vs: Val,
                    hg: gather(args, env) = SomeV(fs),
                    hr: Converges(p, VCons(VCon(tag, fs), env), rest, vs))
    : Converges(p, env, LetCon(tag, args, rest), vs)
{
    Converges(Succ(hr.n),
        j(sym(hg),
          λ o q => k_letcon(eval(hr.n, p), env, tag, rest, o) = Out(vs),
          hr.h))
}

// The two rebinding instructions share their shape: raise the sub-run's
// certificate and the continuation's to the sum of their fuels, rewrite the
// scrutinized OptVal by the computation premise, rewrite the sub-run's
// answer by its raised certificate, and the raised continuation closes the
// k_bind.
theorem letcall_conv(p: Prog, env: Val, callee: Nat, args: Refs, rest: Ir,
                     cargs: Val, ws: Val, vs: Val,
                     hg: gather(args, env) = SomeV(cargs),
                     hc: Converges(p, cargs, find_fun(p)(callee), ws),
                     hr: Converges(p, append(ws, env), rest, vs))
    : Converges(p, env, LetCall(callee, args, rest), vs)
{
    let e1: (eval(add(hc.n, hr.n), p)(cargs, find_fun(p)(callee)) = Out(ws))
        = fuel_monotone(p, cargs, find_fun(p)(callee), ws,
                        hc.n, add(hc.n, hr.n), hc.h, le_add_l(hc.n, hr.n));
    let e2: (eval(add(hc.n, hr.n), p)(append(ws, env), rest) = Out(vs))
        = fuel_monotone(p, append(ws, env), rest, vs,
                        hr.n, add(hc.n, hr.n), hr.h, le_add_r(hc.n, hr.n));
    Converges(Succ(add(hc.n, hr.n)),
        j(sym(hg),
          λ o q => k_letcall(eval(add(hc.n, hr.n), p), p, env, callee, rest, o)
                   = Out(vs),
          j(sym(e1),
            λ r q2 => k_bind(eval(add(hc.n, hr.n), p), env, rest, r) = Out(vs),
            e2)))
}

theorem letmatch_conv(p: Prog, env: Val, scrut: Nat, arms: Ir, rest: Ir,
                      tag: Nat, fields: Val, ws: Val, vs: Val,
                      hl: lookup(env)(scrut) = SomeV(VCon(tag, fields)),
                      ha: Converges(p, append(fields, env), pick_arm(arms)(tag), ws),
                      hr: Converges(p, append(ws, env), rest, vs))
    : Converges(p, env, LetMatch(scrut, arms, rest), vs)
{
    let e1: (eval(add(ha.n, hr.n), p)(append(fields, env), pick_arm(arms)(tag)) = Out(ws))
        = fuel_monotone(p, append(fields, env), pick_arm(arms)(tag), ws,
                        ha.n, add(ha.n, hr.n), ha.h, le_add_l(ha.n, hr.n));
    let e2: (eval(add(ha.n, hr.n), p)(append(ws, env), rest) = Out(vs))
        = fuel_monotone(p, append(ws, env), rest, vs,
                        hr.n, add(ha.n, hr.n), hr.h, le_add_r(ha.n, hr.n));
    Converges(Succ(add(ha.n, hr.n)),
        j(sym(hl),
          λ o q => k_letmatch(eval(add(ha.n, hr.n), p), env, arms, rest, o)
                   = Out(vs),
          j(sym(e1),
            λ r q2 => k_bind(eval(add(ha.n, hr.n), p), env, rest, r) = Out(vs),
            e2)))
}

// ---------------------------------------------------------------------------
// `refines` (doc §6), in BOTH shapes.
//
// The ∃-shape first, since it is the one §6 asked for: IR₂ refines IR₁ when
// every convergence of IR₁ is a convergence of IR₂. No fuel map — the bound
// is inside the `Converges`, so composition is ordinary implication chaining
// and the bound arithmetic that `refines_trans` had to thread disappears.
//
// The relation now HAS A NAME. A type is an ordinary expression
// (docs/types-as-expressions.md), so `Refines` is an ordinary `fn` whose
// result type is `Type` and whose body is a function type; `Refines(…)` in
// type position is `El` of the call, and conversion sees through it by δ.
// This closes doc §13 note 7's "refines cannot be given a name"
// ([[type-definitions]]).

fn Refines(p1: Prog, i1: Ir, p2: Prog, i2: Ir) -> Type {
    (env, vs: Val) -> Converges(p1, env, i1, vs) -> Converges(p2, env, i2, vs)
}

theorem refines_refl_conv(prog: Prog, ir: Ir): Refines(prog, ir, prog, ir)
{ λ env vs c => c }

theorem refines_trans_conv(
    p1: Prog, i1: Ir, p2: Prog, i2: Ir, p3: Prog, i3: Ir,
    r1: Refines(p1, i1, p2, i2),
    r2: Refines(p2, i2, p3, i3))
    : Refines(p1, i1, p3, i3)
{ λ env vs c => r2(env, vs, r1(env, vs, c)) }

// The ∃-CLOSURE, proved rather than asserted: a bounded refinement at any
// fuel map is a refinement in the ∃-sense. This is why none of the bounded
// theorems below has to be re-proved — `b` is applied to the hidden witness
// and then forgotten again.
theorem refines_of_bounded(p1: Prog, i1: Ir, p2: Prog, i2: Ir, b: Nat -> Nat,
    r: (env, vs: Val, n: Nat)
       -> eval(n, p1)(env, i1) = Out(vs) -> eval(b(n), p2)(env, i2) = Out(vs))
    : Refines(p1, i1, p2, i2)
{ λ env vs c => Converges(b(c.n), r(env, vs, c.n, c.h)) }

// ---------------------------------------------------------------------------
// `refines` in the BOUNDED form, kept: a refinement carries a fuel map `b`,
// and composition is function composition of the bounds. This was the whole
// §6 stress test before the ∃-form was statable, `fuel_monotone` is what makes
// it robust, and `refines_of_bounded` above is the one-line bridge to the
// ∃-form — so it stays, additive rather than replaced.

theorem refines_refl(prog: Prog, ir: Ir):
    (env, vs: Val, n: Nat)
    -> eval(n, prog)(env, ir) = Out(vs) -> eval(n, prog)(env, ir) = Out(vs)
{ λ env vs n h => h }

theorem refines_trans(
    p1: Prog, i1: Ir, p2: Prog, i2: Ir, p3: Prog, i3: Ir,
    b1: Nat -> Nat, b2: Nat -> Nat,
    r1: (env, vs: Val, n: Nat)
        -> eval(n, p1)(env, i1) = Out(vs) -> eval(b1(n), p2)(env, i2) = Out(vs),
    r2: (env, vs: Val, n: Nat)
        -> eval(n, p2)(env, i2) = Out(vs) -> eval(b2(n), p3)(env, i3) = Out(vs))
    : (env, vs: Val, n: Nat)
      -> eval(n, p1)(env, i1) = Out(vs) -> eval(b2(b1(n)), p3)(env, i3) = Out(vs)
{ λ env vs n h => r2(env, vs, b1(n), r1(env, vs, n, h)) }

// ---------------------------------------------------------------------------
// A concrete refinement, and its composition across two hand-written IRs for
// the same function (doc §11 item 3's stress test).
//
// The family is the one a two-argument, one-result certificate lives in:
// environment `[x, y]`, answer `[v]`. Wrapping a body in a `LetCall` to it
// refines the body at bound `n ↦ n + 2` — one step for the call, one for the
// `Ret` that rebinds its answer — and the wrapping composes.

theorem call_refines(prog: Prog, callee: Nat, cbody: Ir,
                     hfind: find_fun(prog)(callee) = cbody,
                     x: Val, y: Val, v: Val, n: Nat,
                     h: eval(n, prog)(VCons(x, VCons(y, VNil)), cbody) = Out(VCons(v, VNil)))
    : eval(Succ(Succ(n)), prog)(VCons(x, VCons(y, VNil)),
          LetCall(callee, RCons(0, RCons(1, RNil)), Ret(RCons(0, RNil))))
      = Out(VCons(v, VNil))
{
    j(sym(hfind),
      λ w p => k_bind(eval(Succ(n), prog), VCons(x, VCons(y, VNil)), Ret(RCons(0, RNil)),
                      eval(Succ(n), prog)(VCons(x, VCons(y, VNil)), w))
               = Out(VCons(v, VNil)),
      j(sym(eval_mono_succ(prog, n)(VCons(x, VCons(y, VNil)), cbody, VCons(v, VNil), h)),
        λ r p => k_bind(eval(Succ(n), prog), VCons(x, VCons(y, VNil)), Ret(RCons(0, RNil)), r)
                 = Out(VCons(v, VNil)),
        refl))
}

// step one: the loop is refined by a call to it, at bound `n ↦ n + 2`
theorem loop_refined_by_call(x: Val, y: Val, v: Val, n: Nat,
    h: eval(n, add_chain())(VCons(x, VCons(y, VNil)), ir_loop()) = Out(VCons(v, VNil)))
    : eval(plus2()(n), add_chain())(VCons(x, VCons(y, VNil)), ir_call1()) = Out(VCons(v, VNil))
{ call_refines(add_chain(), 0, ir_loop(), refl, x, y, v, n, h) }

// step two: that call is in turn refined by a call to the function that makes
// it — the same lemma at a different callee, which is the point of taking the
// callee as an argument
theorem call_refined_by_call(x: Val, y: Val, v: Val, n: Nat,
    h: eval(n, add_chain())(VCons(x, VCons(y, VNil)), ir_call1()) = Out(VCons(v, VNil)))
    : eval(plus2()(n), add_chain())(VCons(x, VCons(y, VNil)), ir_call2()) = Out(VCons(v, VNil))
{ call_refines(add_chain(), 1, ir_call1(), refl, x, y, v, n, h) }

// …and they compose, bounds included: no fuel arithmetic leaks out of the
// chain, it is exactly `plus2 ∘ plus2`
theorem loop_refined_by_call2(x: Val, y: Val, v: Val, n: Nat,
    h: eval(n, add_chain())(VCons(x, VCons(y, VNil)), ir_loop()) = Out(VCons(v, VNil)))
    : eval(plus2()(plus2()(n)), add_chain())(VCons(x, VCons(y, VNil)), ir_call2())
      = Out(VCons(v, VNil))
{ call_refined_by_call(x, y, v, plus2()(n), loop_refined_by_call(x, y, v, n, h)) }

// the composite really computes: 1 + 1 = 2 two calls deep
theorem chain_add_one_one():
    eval(54, add_chain())(VCons(embed_nat(1), VCons(embed_nat(1), VNil)), ir_call2())
    = Out(VCons(embed_nat(2), VNil))
{ refl }
theorem cong_nat_val(f: Nat -> Val, {a: Nat}, {b: Nat}, p: a = b): f(a) = f(b) {
    j(p, λ y q => f(a) = f(y), refl)
}

// the embedding is a monoid map for the loop's accumulator: bumping an
// embedded numeral `a` times is embedding the sum. Induction on `a` with `b`
// generalized — the third explicit motive.
theorem bumps_embed(a: Nat): (b: Nat) -> bumps(a)(embed_nat(b)) = embed_nat(add(b, a)) {
    match a as λ z => (b: Nat) -> bumps(z)(embed_nat(b)) = embed_nat(add(b, z)) {
        Zero => λ b => refl,
        Succ(a2, ih) => λ b =>
            trans(ih(Succ(b)),
                  cong_nat_val(λ (x: Nat) => embed_nat(x), add_succ_left(b, a2))),
    }
}

// The loop invariant: from carried state `(k, acc)` the theta loop halts with
// `(0, succ^k(acc))`, at fuel `k + 4`. Induction on `k` with the accumulator
// generalized — the fourth explicit motive, and the one the round exists for:
// each iteration costs exactly one fuel at the LoopIter level, and the four
// constant steps are the sub-region the arm runs.
theorem add_loop_runs(prog: Prog, k: Nat):
    (acc: Val)
    -> eval(add(k, 4), prog)(VCons(embed_nat(k), VCons(acc, VNil)),
                                   LoopIter(add_loop_body()))
       = Out(VCons(embed_nat(0), VCons(bumps(k)(acc), VNil)))
{
    match k as λ z =>
        (acc: Val)
        -> eval(add(z, 4), prog)(VCons(embed_nat(z), VCons(acc, VNil)),
                                       LoopIter(add_loop_body()))
           = Out(VCons(embed_nat(0), VCons(bumps(z)(acc), VNil))) {
        Zero => λ acc => refl,
        Succ(k2, ih) => λ acc => ih(VCon(1, VCons(acc, VNil))),
    }
}

// …and the function body around it: gather the two arguments, run the loop,
// return the accumulator slot.
theorem add_ir_runs(prog: Prog, a: Nat, b: Nat):
    eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), VNil)), add_body())
    = Out(VCons(bumps(a)(embed_nat(b)), VNil))
{
    j(sym(add_loop_runs(prog, a)(embed_nat(b))),
      λ r p => k_bind(eval(add(a, 4), prog),
                      VCons(embed_nat(a), VCons(embed_nat(b), VNil)),
                      Ret(RCons(1, RNil)), r)
               = Out(VCons(bumps(a)(embed_nat(b)), VNil)),
      refl)
}

// THE CERTIFICATE. For every pair of spec arguments, the IR simulates to the
// embedded spec result. The loop counts `a` down onto `b`, so the function it
// implements is `λ a b. b + a` — `add(b, a)` in the spec's own spelling,
// which recurses on its second argument.
theorem add_equiv(prog: Prog, a: Nat, b: Nat):
    eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), VNil)), add_body())
    = Out(VCons(embed_nat(add(b, a)), VNil))
{
    j(bumps_embed(a)(b),
      λ w p => eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), VNil)),
                                           add_body())
               = Out(VCons(w, VNil)),
      add_ir_runs(prog, a, b))
}

// the stated form (doc §6): the certificate holds at EVERY fuel at least the
// computed bound, `fuel_monotone` doing the bridging. This is the shape a
// `Compile` instance will export, since a caller has no reason to know the
// bound the instance computed.
theorem add_equiv_at(prog: Prog, a: Nat, b: Nat, f: Nat, hle: add(a, 5) <= f):
    eval(f, prog)(VCons(embed_nat(a), VCons(embed_nat(b), VNil)), add_body())
    = Out(VCons(embed_nat(add(b, a)), VNil))
{
    fuel_monotone(prog, VCons(embed_nat(a), VCons(embed_nat(b), VNil)), add_body(),
                  VCons(embed_nat(add(b, a)), VNil), add(a, 5), f, add_equiv(prog, a, b), hle)
}

// THE SAME CERTIFICATE, exported as the ∃-form. This is the shape a `Compile`
// instance actually wants: the caller is told the IR converges to the spec's
// answer and is told nothing about the fuel, which is `add_equiv_at`'s stated
// intent finally written as a type rather than as a `∀ f ≥ bound` schema.
theorem add_converges(prog: Prog, a: Nat, b: Nat)
    : Converges(prog, VCons(embed_nat(a), VCons(embed_nat(b), VNil)), add_body(),
                VCons(embed_nat(add(b, a)), VNil))
{ Converges(add(a, 5), add_equiv(prog, a, b)) }

// …and the refinement chain in ∃-form: the bound `plus2 ∘ plus2` is applied
// to the hidden witness and hidden again, so the STATEMENT mentions no fuel
// at all. Compare `loop_refined_by_call2`, whose statement carries the whole
// composed bound.
theorem loop_refines_call2_conv(x: Val, y: Val, v: Val,
    c: Converges(add_chain(), VCons(x, VCons(y, VNil)), ir_loop(), VCons(v, VNil)))
    : Converges(add_chain(), VCons(x, VCons(y, VNil)), ir_call2(), VCons(v, VNil))
{ Converges(plus2()(plus2()(c.n)), loop_refined_by_call2(x, y, v, c.n, c.h)) }

theorem add_converges_through_calls(a: Nat, b: Nat)
    : Converges(add_chain(), VCons(embed_nat(a), VCons(embed_nat(b), VNil)), ir_call2(),
                VCons(embed_nat(add(b, a)), VNil))
{
    loop_refines_call2_conv(embed_nat(a), embed_nat(b), embed_nat(add(b, a)),
                            add_converges(add_chain(), a, b))
}

// and the certificate transports along the refinement chain: the same
// function, two calls deep, at the composed bound
theorem add_equiv_through_calls(a: Nat, b: Nat):
    eval(plus2()(plus2()(add(a, 5))), add_chain())(
        VCons(embed_nat(a), VCons(embed_nat(b), VNil)), ir_call2())
    = Out(VCons(embed_nat(add(b, a)), VNil))
{
    loop_refined_by_call2(embed_nat(a), embed_nat(b), embed_nat(add(b, a)), add(a, 5),
        add_equiv(add_chain(), a, b))
}

// ---------------------------------------------------------------------------
// `Compile` v1 (docs/compile-typeclass-design.md): the certificate is an
// ordinary record value. Per-signature and monomorphic — the value parameter
// couples the instance to its spec function, `prog`/`entry` are the IR
// production, and `cert` exports convergence to the embedded spec result in
// the ∃-form. No class machinery: resolution, coherence and `[target]`
// indexing are the operational layer and wait for a resolver (doc §5).

record CompileNat2(f: Nat -> Nat -> Nat) {
    prog: Prog,
    entry: Ir,
    cert: (a, b: Nat)
          -> Converges(prog, VCons(embed_nat(a), VCons(embed_nat(b), VNil)),
                       entry, VCons(embed_nat(f(a)(b)), VNil)),
}

// The spec, spelled the way the loop computes it: the theta-loop counts `a`
// down onto `b`, so the implemented function is `λ a b. add(b, a)`.
fn add_spec(a: Nat) -> Nat -> Nat { λ (b: Nat) => add(b, a) }

// THE MILESTONE (issues/end-to-end-compile-instance.md): one small pure
// function, a hand-written instance producing IR for it, and the certificate
// checked by the kernel. `cert`'s expected type asks conversion for
// `embed_nat(add_spec(a)(b)) ≡ embed_nat(add(b, a))` — δ then β.
fn add_instance() -> CompileNat2(add_spec) {
    CompileNat2 {
        prog: add_chain(),
        entry: ir_call2(),
        cert: λ (a: Nat) => λ (b: Nat) => add_converges_through_calls(a, b),
    }
}

// A SECOND instance for the same spec through a different IR — the loop body
// directly rather than two calls deep. Coherence is policy, not soundness:
// two values of one type, either usable, semantics pinned by both
// certificates (doc §7 item 4).
fn add_instance_loop() -> CompileNat2(add_spec) {
    CompileNat2 {
        prog: add_chain(),
        entry: ir_loop(),
        cert: λ (a: Nat) => λ (b: Nat) => add_converges(add_chain(), a, b),
    }
}

// ===========================================================================
// CROSS-IR REFINEMENT (issues/cross-ir-refinement.md; doc §6's stress test in
// full). The landed chain above relates ONE program reached through zero, one
// and two `LetCall` wrappers — structural composition. This section relates
// two programs that share no structure at all: the theta-loop `add`
// (`ir_loop`/`add_body`, a tail-recursive accumulator) and a recursive-`Apply`
// `add` (non-tail: the callee's answer is wrapped in a `Succ` on the way out).
// Different environments, different node alphabets, different fuel profiles;
// one refinement.

// The recursive IR. Function body, env [a, b]: match `a`; the Zero arm returns
// `b`; the Succ arm calls fun 0 on (pred, b) and wraps the answer.
//
// Slot maps, since they are where the two IRs stop agreeing: the loop's body
// runs CLOSED on its two carried slots, while this body's arms are LEXICAL —
// the Succ arm sees [pred, a, b, …caller's tail], so slot 2 is `b` and the
// caller's environment is still underneath. That is why the invariant below is
// stated over an arbitrary environment tail (env-independence) rather than
// transported slot-by-slot the way `add_loop_runs` does.

// Zero arm: env [a, b, …]; the answer is `b`
fn add_rec_arm_zero() -> Ir { Ret(RCons(1, RNil)) }

// Succ arm: env [pred, a, b, …]; call fun 0 on (pred, b), bind its answer at
// slot 0, wrap it in Succ, return it
fn add_rec_arm_succ() -> Ir {
    LetCall(0, RCons(0, RCons(2, RNil)),
        LetCon(1, RCons(0, RNil),
            Ret(RCons(0, RNil))))
}

fn add_rec_body() -> Ir {
    LetMatch(0, Arm(add_rec_arm_zero(), Arm(add_rec_arm_succ(), NoArm)),
        Ret(RCons(0, RNil)))
}

fn add_rec_prog() -> Prog { PFun(add_rec_body(), PNil) }

fn ir_rec() -> Ir { add_rec_body() }

// The fuel profile is the other place the two IRs differ. The loop costs
// `a + 5` (one step per iteration plus a constant); the recursion costs
// `2a + 2`, two steps of nesting per level — the `LetMatch` and the `LetCall`
// — so the bound is `add(dbl(a), 2)`. It has to be spelled so that it REDUCES
// at an open `a`: `add(x, 2)` is `Succ(Succ(x))` for any `x` (add recurses on
// its second argument), which is exactly the two `Succ`s the induction step
// peels.
fn dbl(n: Nat) -> Nat { match n { Zero => Zero, Succ(k) => Succ(Succ(dbl(k))) } }

// concrete fixtures, in the style of the loop's (doc §11 item 2), plus the
// negative control that the bound is EXACT and not merely sufficient
theorem rec_zero_three():
    eval(2, add_rec_prog())(VCons(embed_nat(0), VCons(embed_nat(3), VNil)), add_rec_body())
    = Out(VCons(embed_nat(3), VNil))
{ refl }

theorem rec_two_three():
    eval(6, add_rec_prog())(VCons(embed_nat(2), VCons(embed_nat(3), VNil)), add_rec_body())
    = Out(VCons(embed_nat(5), VNil))
{ refl }

theorem rec_two_three_short():
    eval(5, add_rec_prog())(VCons(embed_nat(2), VCons(embed_nat(3), VNil)), add_rec_body())
    = OutOfFuel
{ refl }

// THE ENV-INDEPENDENCE LEMMA, as the invariant that carries it: the recursive
// body's answer on [embed a, embed b, tail] does not mention `tail`. The
// quantifier over `tail` is what makes the induction go through at all — the
// recursive call builds a CLOSED environment [embed pred, embed b] (tail
// VNil) while the caller's environment has whatever tail the theorem was
// instantiated at, so a `tail`-fixed statement would not apply to its own
// induction hypothesis.
theorem add_rec_runs(a: Nat):
    (b: Nat, tail: Val)
    -> eval(add(dbl(a), 2), add_rec_prog())(
           VCons(embed_nat(a), VCons(embed_nat(b), tail)), add_rec_body())
       = Out(VCons(embed_nat(add(b, a)), VNil))
{
    match a as λ z =>
        (b: Nat, tail: Val)
        -> eval(add(dbl(z), 2), add_rec_prog())(
               VCons(embed_nat(z), VCons(embed_nat(b), tail)), add_rec_body())
           = Out(VCons(embed_nat(add(b, z)), VNil)) {
        Zero => λ b tail => refl,
        // the ih is used at tail = VNil (the call's closed environment); the
        // motive is the two nested `k_bind`s the step unfolds to — the outer
        // one is the LetMatch rebinding its arm's answer, the inner one is the
        // LetCall rebinding the callee's
        Succ(a2, ih) => λ b tail =>
            j(sym(ih(b, VNil)),
              λ r p =>
                k_bind(eval(add(dbl(a2), 3), add_rec_prog()),
                       VCons(embed_nat(Succ(a2)), VCons(embed_nat(b), tail)),
                       Ret(RCons(0, RNil)),
                       k_bind(eval(add(dbl(a2), 2), add_rec_prog()),
                              VCons(embed_nat(a2),
                                    VCons(embed_nat(Succ(a2)), VCons(embed_nat(b), tail))),
                              LetCon(1, RCons(0, RNil), Ret(RCons(0, RNil))),
                              r))
                = Out(VCons(embed_nat(add(b, Succ(a2))), VNil)),
              refl),
    }
}

// the loop side at an arbitrary tail too, so the two IRs are compared on the
// SAME family of environments. The loop needs no new induction:
// `add_loop_runs` is already about the closed carried environment, and the
// tail only ever sits under a `gather` of slots 0 and 1.
theorem add_ir_runs_env(prog: Prog, a: Nat, b: Nat, tail: Val):
    eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), tail)), add_body())
    = Out(VCons(bumps(a)(embed_nat(b)), VNil))
{
    j(sym(add_loop_runs(prog, a)(embed_nat(b))),
      λ r p => k_bind(eval(add(a, 4), prog),
                      VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                      Ret(RCons(1, RNil)), r)
               = Out(VCons(bumps(a)(embed_nat(b)), VNil)),
      refl)
}

theorem add_equiv_env(prog: Prog, a: Nat, b: Nat, tail: Val):
    eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), tail)), add_body())
    = Out(VCons(embed_nat(add(b, a)), VNil))
{
    j(bumps_embed(a)(b),
      λ w p => eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                                     add_body())
               = Out(VCons(w, VNil)),
      add_ir_runs_env(prog, a, b, tail))
}

// env-independence stated as such, for each IR: on this family the answer is
// stable under replacing the unused slots wholesale. (It is a corollary of the
// two invariants rather than a lemma feeding them — the induction needs the
// quantified form, and the equational form is what a reader wants to see.)
theorem add_rec_env_indep(a: Nat, b: Nat, t1: Val, t2: Val):
    eval(add(dbl(a), 2), add_rec_prog())(
        VCons(embed_nat(a), VCons(embed_nat(b), t1)), add_rec_body())
    = eval(add(dbl(a), 2), add_rec_prog())(
        VCons(embed_nat(a), VCons(embed_nat(b), t2)), add_rec_body())
{ trans(add_rec_runs(a)(b, t1), sym(add_rec_runs(a)(b, t2))) }

theorem add_loop_env_indep(prog: Prog, a: Nat, b: Nat, t1: Val, t2: Val):
    eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), t1)), add_body())
    = eval(add(a, 5), prog)(VCons(embed_nat(a), VCons(embed_nat(b), t2)), add_body())
{ trans(add_equiv_env(prog, a, b, t1), sym(add_equiv_env(prog, a, b, t2))) }

// the recursive IR's certificate, in the ∃-form, at any tail
theorem add_rec_converges(a: Nat, b: Nat, tail: Val)
    : Converges(add_rec_prog(), VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                add_rec_body(), VCons(embed_nat(add(b, a)), VNil))
{ Converges(add(dbl(a), 2), add_rec_runs(a)(b, tail)) }

// ---------------------------------------------------------------------------
// The relation. `Refines` itself is UNRESTRICTED — it quantifies over every
// environment, junk included — and between these two IRs it is FALSE, which is
// the round's first finding and is refuted below rather than asserted. What
// holds is the refinement on the family the certificates are about: two
// embedded `Nat` arguments over an arbitrary environment tail, the calling
// convention `CompileNat2` already fixes.
//
// This is `Refines` with its unrestricted `(env: Val)` guarded by a PREDICATE
// on the environment, said once and generally: `RefinesOn(dom, …)` takes the
// domain as a `Val -> Type` value. The family the certificates are about is
// then a record — `NatEnv(e)`, which packs the two embedded arguments, the
// tail, and the proof that `e` has that shape — and a record type applied to
// its value parameters IS a `Val -> Type` value
// (docs/record-type-values.md, [[record-types-as-type-valued-functions]]).
record NatEnv(e: Val) {
    a: Nat,
    b: Nat,
    tail: Val,
    shape: e = VCons(embed_nat(a), VCons(embed_nat(b), tail)),
}

fn RefinesOn(dom: Val -> Type, p1: Prog, i1: Ir, p2: Prog, i2: Ir) -> Type {
    (env: Val) -> dom(env) -> (vs: Val)
    -> Converges(p1, env, i1, vs) -> Converges(p2, env, i2, vs)
}

fn RefinesNat2(p1: Prog, i1: Ir, p2: Prog, i2: Ir) -> Type {
    RefinesOn(λ (e: Val) => NatEnv(e), p1, i1, p2, i2)
}

// THE CROSS-IR REFINEMENT. The proof is not a simulation diagram and not a
// slot-by-slot transport: the hypothesis hands over an unknown `vs`,
// `conv_functional` identifies it with the value the LOOP's certificate names,
// and the RECURSIVE IR's certificate — proved independently, over its own
// environments and its own fuel bound — supplies the conclusion. That is the
// shape every `translate`/pass certificate has when both sides are certified
// against one spec function.
//
// It is stated twice: first on an environment already IN the family's shape
// (`…_at`, where the proof lives), then at `RefinesNat2`, which is that plus
// one transport along `NatEnv`'s own shape proof. That transport is the whole
// price of taking the domain as a value instead of inlining its binders.
theorem loop_refines_rec_at(a: Nat, b: Nat, tail: Val, vs: Val,
    c: Converges(add_prog(), VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                 ir_loop(), vs))
    : Converges(add_rec_prog(), VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                ir_rec(), vs)
{
    j(sym(conv_functional(add_prog(),
              VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_loop(),
              vs, VCons(embed_nat(add(b, a)), VNil), c,
              converges_intro(add_prog(),
                  VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_loop(),
                  VCons(embed_nat(add(b, a)), VNil), add(a, 5),
                  add_equiv_env(add_prog(), a, b, tail)))),
      λ w p => Converges(add_rec_prog(),
                   VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_rec(), w),
      add_rec_converges(a, b, tail))
}

theorem loop_refines_rec(): RefinesNat2(add_prog(), ir_loop(), add_rec_prog(), ir_rec())
{
    λ env d vs =>
        j(sym(d.shape),
          λ z q => Converges(add_prog(), z, ir_loop(), vs)
                   -> Converges(add_rec_prog(), z, ir_rec(), vs),
          λ c => loop_refines_rec_at(d.a, d.b, d.tail, vs, c))
}

// …and back the other way, which costs one more theorem because both sides are
// certified: the refinement is an equivalence on this family, so either IR may
// stand for the other.
theorem rec_refines_loop_at(a: Nat, b: Nat, tail: Val, vs: Val,
    c: Converges(add_rec_prog(), VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                 ir_rec(), vs))
    : Converges(add_prog(), VCons(embed_nat(a), VCons(embed_nat(b), tail)),
                ir_loop(), vs)
{
    j(sym(conv_functional(add_rec_prog(),
              VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_rec(),
              vs, VCons(embed_nat(add(b, a)), VNil), c,
              add_rec_converges(a, b, tail))),
      λ w p => Converges(add_prog(),
                   VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_loop(), w),
      converges_intro(add_prog(),
          VCons(embed_nat(a), VCons(embed_nat(b), tail)), ir_loop(),
          VCons(embed_nat(add(b, a)), VNil), add(a, 5),
          add_equiv_env(add_prog(), a, b, tail)))
}

theorem rec_refines_loop(): RefinesNat2(add_rec_prog(), ir_rec(), add_prog(), ir_loop())
{
    λ env d vs =>
        j(sym(d.shape),
          λ z q => Converges(add_rec_prog(), z, ir_rec(), vs)
                   -> Converges(add_prog(), z, ir_loop(), vs),
          λ c => rec_refines_loop_at(d.a, d.b, d.tail, vs, c))
}

// ---------------------------------------------------------------------------
// WHY THE RESTRICTION IS NOT COWARDICE (doc §11 item 6's discipline, applied
// to a relation instead of a program): the unrestricted `Refines` between
// these two IRs is refutable, and here is the witness.
//
// Feed both IRs an environment whose first slot is junk — a tag-1 node whose
// field is a tag-0 node that itself carries a field. Neither IR sticks: the
// extra field simply shifts the arm's environment, and both keep computing.
// They disagree. The loop's accumulator is threaded THROUGH the carried slots,
// so the junk field displaces it and the final `Succ` is lost; the recursion
// wraps its `Succ` around the callee's answer on the way out, where nothing
// can displace it. Two IRs that agree on every well-formed input differ off
// it, which is exactly what makes `Refines`-the-unrestricted-relation the
// wrong statement for a certificate — and why the family belongs in the
// domain `RefinesNat2` hands to `RefinesOn`. `junk_env()` below is precisely
// an environment with no `NatEnv` inhabitant.

fn junk_u() -> Val { VCon(7, VNil) }
fn junk_q() -> Val { VCon(0, VCons(junk_u(), VNil)) }
fn junk_n() -> Val { VCon(1, VCons(junk_q(), VNil)) }
fn junk_env() -> Val { VCons(junk_n(), VCons(VCon(8, VNil), VNil)) }

theorem loop_on_junk():
    eval(30, add_prog())(junk_env(), ir_loop()) = Out(VCons(junk_q(), VNil))
{ refl }

theorem rec_on_junk():
    eval(30, add_rec_prog())(junk_env(), ir_rec())
    = Out(VCons(VCon(1, VCons(junk_q(), VNil)), VNil))
{ refl }

// the refutation: an unrestricted `Refines` would make the two answers above
// equal, and `inj` reads a false constructor equation off them
theorem no_full_refines(r: Refines(add_prog(), ir_loop(), add_rec_prog(), ir_rec()))
    : 0 = 1
{
    inj(inj(conv_functional(add_rec_prog(), junk_env(), ir_rec(),
        VCons(junk_q(), VNil), VCons(VCon(1, VCons(junk_q(), VNil)), VNil),
        r(junk_env(), VCons(junk_q(), VNil),
          converges_intro(add_prog(), junk_env(), ir_loop(),
                          VCons(junk_q(), VNil), 30, loop_on_junk())),
        converges_intro(add_rec_prog(), junk_env(), ir_rec(),
                        VCons(VCon(1, VCons(junk_q(), VNil)), VNil), 30, rec_on_junk()))))
}

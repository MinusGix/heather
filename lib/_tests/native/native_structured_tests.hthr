// Structured regions inside a leaf (issues/native-compile-wider-leaves.md):
// which the compile takes (native_structured's scope), and why it refuses
// the others.
import native_source;
import native_cat;
import native_compile;
import native_structured;
import native_alloc;
import function_ir;
import function_ir_eval;
import function_ir_state;
import linux_x86_64_image;
import bitvec;
import list;
import nat;
import option;

fn low() → BitVec(64) { io_data_low() }

fn refused(src: Source) → List<Nat> { src.refusal(low(), Homes::slots(src), SpillAll().frames(src)) }

fn leaf(nodes: List<Node>) → Region { Region(Ports([]), nodes, Ports([])) }

// tr's byte map as one bounded loop over buffer 0: each of the first `n`
// bytes (word 1) raised where it is a lower-case letter. Words: 2 the
// index on entry, 3 the parameter, 4 the count, 5 the exit bit, 6 the next
// index, 7 the index at the end, 8 the loop's bit; 10.. the body's.
fn upper_byte() → StructuredRegion {
    Sequence(leaf([BufferLoad(10, 0, 3), Const(64, 11, 97), Sub(64, 12, 10, 11), Const(64, 13, 26), UnsignedLessThan(64, 14, 12, 13),
            Const(64, 15, 1), Add(64, 6, 3, 15), Const(64, 5, 0)]),
        Conditional(Ports([]), 14, Ports([]), Ports([]),
            Dataflow(leaf([Const(64, 16, 32), Sub(64, 17, 10, 16), BufferStore(18, 0, 3, 17)])),
            Dataflow(leaf([]))))
}

fn byte_map() → StructuredRegion { Loop([2], 1, [3], 4, upper_byte(), 5, [6], [7], 8) }

fn tr_map(n: Nat) → Source { Source::of([Buffer(16)], Then(ops([Const(64, 1, n), Const(64, 2, 0)]), Then(Compute(byte_map()), Exit(7)))) }

theorem byte_map_scoped(): byte_map().scopes() = True { refl }
theorem tr_map_compiles(): refused(tr_map(5)) = [] { refl }

// `tr a-z A-Z` over one read of up to 16 bytes: the byte map's loop runs
// over what was read, the bytes are written back, and the exit status is
// the loop's index at its end, the count read. Words: 0 zero, 1 the count
// read, 9 the read's room, 19 standard output, 20 the write's result.
fn tr_upper() → Source {
    Source::of([Buffer(16)], Then(ops([Const(64, 0, 0), Const(64, 9, 16), Const(64, 19, 1)]),
        Then(Invoke(Reads(0, 0, 0, 9, 1)),
            Then(ops([Const(64, 2, 0)]),
                Then(Compute(byte_map()),
                    Then(Invoke(Writes(19, 0, 0, 1, 20)), Exit(7)))))))
}

// Refused, with the reason named: a loop counting with one of its own
// parameters is not in counted form (reason 0, kind 5); a loop whose
// parameter is read after it, so its moves would clobber a live word
// (reason 13).
fn uncounted() → Source {
    Source::of([Buffer(16)], Then(ops([Const(64, 1, 3), Const(64, 2, 0)]), Then(Compute(Loop([2], 1, [3], 3, upper_byte(), 5, [6], [7], 8)), Exit(7))))
}
fn clobbers() → Source { Source::of([Buffer(16)], Then(ops([Const(64, 1, 3), Const(64, 2, 0)]), Then(Compute(byte_map()), Exit(3)))) }

theorem uncounted_refused(): refused(uncounted()) = [2, 0, 0, 5, 0] { refl }
theorem clobbers_refused(): refused(clobbers()) = [2, 0, 13, 0, 0] { refl }

// An unbounded loop (`Until`, docs/language/loop-combinator-design.md
// §6.9): a word counted down to zero, with no count of the loop's own.
// Words: 1 the start, 3 the parameter, 5 the exit bit, 6 the next value,
// 7 the value at the end; 10 and 11 the body's.
fn count_down_body() → StructuredRegion { Dataflow(leaf([Const(64, 10, 1), Sub(64, 6, 3, 10), Const(64, 11, 0), Equal(64, 5, 6, 11)])) }
fn count_down() → StructuredRegion { Until([1], [3], count_down_body(), 5, [6], [7]) }

fn count_down_src(n: Nat) → Source { Source::of([], Then(ops([Const(64, 1, n)]), Then(Compute(count_down()), Exit(7)))) }

fn cd_homes() → Homes { Homes::slots(count_down_src(3)) }
fn cd_layout() → Layout { count_down_src(3).layout(low(), cd_homes(), SpillAll().frames(count_down_src(3))) }

fn Option::taken<A>(self o: Option<A>) → Bool { match o { None => False, Some(_) => True } }

// It scopes, its words are checked with its head's set (keyed by its
// exit), and its code is its body and the jump back.
theorem count_down_scoped(): count_down().scoped(Scope::all()).taken() = True { refl }
theorem count_down_checked(): cd_homes().region_checked(count_down(), [7]).taken() = True { refl }
theorem count_down_code(): count_down().code(Start, cd_layout(), [7], 0).taken() = True { refl }

// Its meaning from 3: three passes, the last leaving with 0, well within
// the passes the meaning gives it, so it ends (`until_run_defined`, what
// `StructuredRegion::until_halts` asks from every state).
fn cd_step() → Valuation() → Buffers() → State {
    λ (pass: Valuation()) (held: Buffers()) => count_down_body().run(Readers::quiet(λ _ _ _ => []), pass, held)
}
theorem count_down_ends(): until_run_defined(cd_step(), λ _ _ => True, [3], 5, [6], until_passes(), [BitVec::ofNat(3)], []) = True { refl }
theorem count_down_runs(): until_run(cd_step(), [3], 5, [6], until_passes(), [BitVec::ofNat(3)], []).end.state = [BitVec::ofNat(0)] { refl }

// A statement does not take it yet: its code runs as its meaning where it
// ends (`StructuredRegion::Ok`), and a statement's meaning has no place for
// one that does not (reason 0, kind 7).
theorem count_down_statement(): count_down().scopes() = False { refl }
theorem count_down_refused(): refused(count_down_src(3)) = [2, 0, 0, 7, 0] { refl }

// Negative controls: an exit that is one of its parameters, and a body
// that reads a word outside its pass (word 1), do not scope.
fn exit_moved() → StructuredRegion {
    Until([1], [5], Dataflow(leaf([Const(64, 10, 1), Sub(64, 6, 5, 10), Const(64, 11, 0), Equal(64, 5, 6, 11)])), 5, [6], [7])
}
fn reads_outside() → StructuredRegion {
    Until([1], [3], Dataflow(leaf([Sub(64, 6, 3, 1), Const(64, 11, 0), Equal(64, 5, 6, 11)])), 5, [6], [7])
}

theorem exit_moved_unscoped(): exit_moved().scoped(Scope::all()).taken() = False { refl }
theorem reads_outside_unscoped(): reads_outside().scoped(Scope::all()).taken() = False { refl }

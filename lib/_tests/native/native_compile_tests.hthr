// Sources `write-elf` writes or refuses (issues/native-elf-every-program.md),
// and why `Source::refusal` says the compile refuses the refused ones. The
// CLI's test (crates/cli/tests/native_cat.rs) writes `head10` and asks for
// the others; this file imports only what it uses, and `write-elf` brings
// in the modules its certificate needs.
import native_source;
import native_cat;
import native_compile;
import native_compile_correct;
import native_alloc;
import function_ir;
import function_ir_eval;
import function_ir_placeless;
import function_ir_rows;
import function_ir_lower_calls;
import function_ir_pass;
import itree;
import linux_trees;
import linux_x86_64_image;
import bitvec;
import list;
import nat;
import option;
import x86_64_asm;
import x86_64_asm_runs;

fn low() → BitVec(64) { io_data_low() }

// Why a source is refused, with every word in its slot: the compile is the
// same for any homes the check passes, and the greedy allocator is
// `write-elf`'s, evaluated on its fork, too costly beside a compile in one
// declaration's fuel.
fn refused(src: Source) → List<Nat> { src.refusal(low(), Homes::slots(src), SpillAll().frames(src)) }

// A source's layout with every word in its slot.
fn slotted(src: Source) → Layout { src.layout(low(), Homes::slots(src), SpillAll().frames(src)) }

// `head -c 10`: cat whose read length is a countdown word. Words as cat's;
// 2 the bytes still to copy, 20 and 21 scratch.
fn head_pass() → Stmt {
    Then(Invoke(Reads(0, 0, 16, 2, 3)),
        Then(ops([SignedLessThan(64, 7, 3, 16), Equal(64, 8, 3, 16)]),
            Branch(7, Exit(10),
                Branch(8, Exit(11),
                    Then(ops([Const(64, 4, 0), Move(64, 5, 3)]),
                        Then(Repeat(cat_write(), 14),
                            Branch(12, Exit(10),
                                Then(ops([Sub(64, 21, 2, 3)]),
                                    ops([Move(64, 2, 21), Equal(64, 20, 21, 16), BitXor(1, 15, 20, 19)])))))))))
}

fn head_c(n: Nat) → Source {
    Source::of([Buffer(512)], Then(Then(cat_setup(512), ops([Const(64, 2, n)])), Repeat(head_pass(), 15)))
}
fn head10() → Source { head_c(10) }

// A layout takes a slot for each word the source declares, each buffer at
// its capacity, a scratch range one byte longer than the largest, and the
// saved RSP and the count of calls: cat names twenty words.
theorem cat_words(): cat(1024).words = 20 { refl }
theorem cat_layout_size(): Layout::of(low(), cat(1024).words, cat(1024).capacities(), Homes([], [])).size() = 160 + 1024 + 1025 + 16 { refl }

// cat with a MiB buffer, and so a MiB scratch range: `write-elf` gives it a
// data segment of its layout in whole pages. One with a GiB buffer is past
// the profile's limit (`io_data_limit`), and refused.
fn mib_cat() → Source { cat(1048576) }
fn huge_cat() → Source { cat(0x40000000) }

theorem mib_cat_layout_size(): Layout::of(low(), mib_cat().words, mib_cat().capacities(), Homes([], [])).size() = 160 + 1048576 + 1048577 + 16 { refl }

// An `open` and a `close` compile; a `stat` is the call the compiler does
// not make yet.
fn opens() → Source { Source::of([Buffer(16)], Then(Invoke(Opens(0, 1, 2)), Invoke(Closes(2, 3)))) }
fn stats() → Source { Source::of([Buffer(16), Buffer(144)], Invoke(StatsPath(0, 1, 1, 2))) }

theorem opens_compiles(): refused(opens()) = [] { refl }
theorem stats_refused(): refused(stats()) = [1, 1, 7, 4, 0] { refl }

// Fifteen constants: one register each, more than the pool's fourteen, so
// S4 does not take the leaf whole and it compiles a node at a time.
fn wide_leaf() → Source {
    Source::of([], Then(ops([Const(64, 0, 0), Const(64, 1, 1), Const(64, 2, 2), Const(64, 3, 3),
        Const(64, 4, 4), Const(64, 5, 5), Const(64, 6, 6), Const(64, 7, 7), Const(64, 8, 8), Const(64, 9, 9), Const(64, 10, 10),
        Const(64, 11, 11), Const(64, 12, 12), Const(64, 13, 13), Const(64, 14, 14)]), Exit(14)))
}

theorem wide_leaf_compiles(): refused(wide_leaf()) = [] { refl }

// Forty nodes in one leaf: a running sum of twenty constants, each node
// reading what the one before wrote, and the sum read and written over its
// own slot (`Add(64, 1, 1, 0)`); it exits with 210.
fn sum_nodes(k: Nat) → List<Node> {
    match k { Zero => [], Succ(j) => Cons(Const(64, 0, Succ(j)), Cons(Add(64, 1, 1, 0), sum_nodes(j))) }
}
fn long_leaf() → Source { Source::of([], Then(ops(sum_nodes(20)), Exit(1))) }

theorem long_leaf_forty(): sum_nodes(20).len() = 40 { refl }
theorem long_leaf_compiles(): refused(long_leaf()) = [] { refl }

// The same narrowed: a node at width 32 keeps the leaf from going a node at
// a time, and S4 says why it does not take it whole: its 41 registers
// against the 12 no word lives in (the allocator gives words 0 and 1 two
// of the home pool).
fn narrow_long_leaf() → Source {
    Source::of([], Then(ops(Cons(Const(32, 1, 0), sum_nodes(20))), Exit(1)))
}

theorem narrow_long_leaf_refused(): narrow_long_leaf().refusal(low(), narrow_long_leaf().homes(), narrow_long_leaf().bodies()) = [1, 0, 1, 41, 12] { refl }

// The third statement exits with a word past the slots; the second, a loop,
// tests one; a write names a buffer the source does not have.
fn far_exit() → Source { Source(functions := [], buffers := [], words := 64, main := Then(ops([Const(64, 0, 3)]), Then(Exit(0), Exit(64)))) }
fn far_again() → Source { Source(functions := [], buffers := [], words := 64, main := Then(ops([Const(64, 0, 3)]), Repeat(Exit(0), 99))) }
fn no_buffer() → Source { Source::of([Buffer(8)], Invoke(Writes(0, 1, 2, 3, 4))) }

theorem far_exit_refused(): refused(far_exit()) = [3, 4, 4, 64, 64] { refl }
theorem far_again_refused(): refused(far_again()) = [2, 3, 4, 99, 64] { refl }
theorem no_buffer_refused(): refused(no_buffer()) = [1, 1, 8, 1, 1] { refl }

// A node that writes a word it reads: out of S3.0's evaluation order, so
// not S4's whole, but a node at a time it reads the word before it writes.
fn writes_input() → Source { Source::of([], ops([Add(64, 0, 0, 1)])) }

theorem writes_input_compiles(): refused(writes_input()) = [] { refl }

// Byte nodes mix with the rest of a leaf, alone in it or not.
fn mixed_leaf() → Source { Source::of([Buffer(4)], ops([Const(64, 0, 0), BufferLoad(1, 0, 0)])) }
fn byte_leaves() → Source {
    Source::of([Buffer(4, [BitVec::ofNat(7)])], Then(ops([Const(64, 0, 0)]), ops([BufferLoad(1, 0, 0)])))
}

theorem mixed_leaf_compiles(): refused(mixed_leaf()) = [] { refl }

// Up to eight bytes read, then one leaf: the first byte less 32 stored back
// (`a` to `A`) and the first four bytes summed into word 5, each loaded at
// the index word 3 is set to just before; the bytes read written back, and
// the sum the exit status. Words: 0 stdin, 1 the length asked for, 2 what
// the read returned, 3 an index, 4 a byte, 5 the sum, 6 the 32, 7 the byte
// stored, 8 stdout, 9 where the write starts, 10 what it returned.
fn mixed_bytes() → Source {
    Source::of([Buffer(8)], Then(ops([Const(64, 1, 8), Const(64, 8, 1)]),
        Then(Invoke(Reads(0, 0, 0, 1, 2)),
            Then(ops([Const(64, 3, 0), BufferLoad(4, 0, 3), Add(64, 5, 5, 4), Const(64, 6, 32), Sub(64, 4, 4, 6), BufferStore(7, 0, 3, 4),
                    Const(64, 3, 1), BufferLoad(4, 0, 3), Add(64, 5, 5, 4), Const(64, 3, 2), BufferLoad(4, 0, 3), Add(64, 5, 5, 4),
                    Const(64, 3, 3), BufferLoad(4, 0, 3), Add(64, 5, 5, 4)]),
                Then(Invoke(Writes(8, 0, 9, 2, 10)), Exit(5))))))
}

theorem mixed_bytes_compiles(): refused(mixed_bytes()) = [] { refl }
theorem byte_leaves_compile(): refused(byte_leaves()) = [] { refl }

// A byte node beside a node at width 1: refused, naming the narrow node; and
// a byte node whose buffer the source does not have. The exit reads the
// narrow node's word, so the leaf's pass (function_ir_pass) cannot drop it
// as dead.
fn narrow_mixed_leaf() → Source {
    Source::of([Buffer(4)], Then(ops([BufferLoad(1, 0, 0), BitXor(1, 2, 1, 1)]), Exit(2)))
}
fn missing_buffer_leaf() → Source { Source::of([Buffer(4)], ops([Const(64, 0, 0), BufferLoad(1, 3, 0)])) }

theorem narrow_mixed_leaf_refused(): refused(narrow_mixed_leaf()) = [1, 0, 10, 2, 0] { refl }
theorem missing_buffer_leaf_refused(): refused(missing_buffer_leaf()) = [1, 0, 8, 3, 1] { refl }

// A source that compiles has no refusal.
fn exit3() → Source { Source::of([], Then(ops([Const(64, 0, 3)]), Exit(0))) }

theorem exit3_compiles(): refused(exit3()) = [] { refl }

// How `write-elf` reads a program back a part at a time
// (crates/cli/src/native/emission.rs): the tree's shape, three numbers a
// node in reversed preorder, kind, label name at its start, and the name its
// first child starts at or a leaf's after it. A call or a byte node takes
// names, and a `Repeat` or `Branch` takes two before its children.
theorem exit3_shape(): exit3().shape() = [0, 0, 0, 0, 0, 0, 0, 0, 1] { refl }

fn read_then_exit() → Source { Source::of([Buffer(8)], Then(Invoke(Reads(0, 0, 0, 1, 2)), Exit(2))) }
theorem read_then_exit_shape(): read_then_exit().shape() = [4, 4, 0, 4, 0, 0, 0, 0, 1] { refl }

fn exit_unless() → Source { Source::of([], Repeat(Branch(0, Exit(1), Exit(2)), 0)) }
theorem exit_unless_shape(): exit_unless().shape() = [4, 4, 0, 4, 4, 0, 4, 2, 3, 2, 0, 2] { refl }

// A part read back is its emission at `Start`: the label name after it,
// then how many numbers its items are, the items, their lengths and their
// bytes, a jump's displacement not yet its own.
theorem exit3_exit_reading(): Exit(0).emission_reading(slotted(exit3()), [], [], 5) =
    Cons(5, Start.exits(slotted(exit3()), [], 0).reading() ++ Start.exits(slotted(exit3()), [], 0).unlinked()) { refl }
theorem unlinked_jump(): At(At(Start, 0, Jmp(7)), 7, Syscall).unlinked() = [233, 251, 255, 255, 255, 15, 5] { refl }
theorem far_exit_reads_nothing(): Exit(64).emission_reading(slotted(far_exit()), [], [], 0) = [] { refl }

// What a leaf leaves known: each word a constant ends in, newest first, and
// only a number its width holds (300 is not one byte, so the call after it
// reads that word from its home).
theorem leaves_known_constants(): List::leaves_known([Const(64, 0, 3), Const(8, 1, 7)]) = [Fact(1, 7), Fact(0, 3)] { refl }
theorem leaves_known_fits(): List::leaves_known([Const(8, 1, 300)]) = [] { refl }

// A leaf the call or exit after it reads known words from: the exit takes
// the 3 the leaf puts in word 0 as an immediate, and the leaf, with nothing
// then live after it, writes nothing (function_ir_pass, `Stmt::pair_known`).
theorem exit3_carries(): exit3().main.left().carried(exit3().main.right(), slotted(exit3()).homes, []) = [Fact(0, 3)] { refl }
theorem exit3_exits_known(): exit3().main.emit(Start, slotted(exit3()), [], 0) =
    Some(Compiled(Start.leaf(slotted(exit3()), [], []).unwrap_or(Start).exits(slotted(exit3()), [Fact(0, 3)], 0), 0)) { refl }

// The joins `write-elf` states a long emission with, each at the part it
// fits, in a checking position over a statement given by its parts' names;
// a `Then`'s first part with what its rest needs live given what it leaves
// known (nothing: the exit takes word 0 as an immediate), the rest with that.
theorem exit3_by_parts(): exit3().main.emits(Start, slotted(exit3()), [], [], 0) = exit3().main.right().emits(
        Start.leaf(slotted(exit3()), [], []).unwrap_or(Start), slotted(exit3()), [], [Fact(0, 3)], 0) {
    Stmt::emits_then_of(exit3().main, trivial, Start, slotted(exit3()), [], [], 0,
        Compiled(Start.leaf(slotted(exit3()), [], []).unwrap_or(Start), 0), refl)
}

// The loop around a branch, from its parts': each arm exits at its own
// start, and a `Repeat` and a `Branch` take label names 1 to 4.
fn eu_layout() → Layout { slotted(exit_unless()) }
fn eu_yes() → Prog { Start.label(1).tests(eu_layout(), 0, 3).exits(eu_layout(), [], 1) }
fn eu_no() → Prog { eu_yes().else_label(3, 4).exits(eu_layout(), [], 2) }
theorem exit_unless_by_parts(): exit_unless().main.emits(Start, eu_layout(), [], [], 0) =
    Some(Compiled(then(eu_no().join_label(4).tests(eu_layout(), 0, 2), Jmp(1)).label(2), 4)) {
    Stmt::emits_repeat_of(exit_unless().main, trivial, Start, eu_layout(), trivial, [], [], 0, Compiled(eu_no().join_label(4), 4),
        Stmt::emits_branch_of(exit_unless().main.left(), trivial, Start.label(1), eu_layout(), trivial,
            exit_unless().main.loop_out(eu_layout().homes, []), [], 2, Compiled(eu_yes(), 4), Compiled(eu_no(), 4), refl, refl))
}

// A byte node takes label names (its bounds check's), so the leaf after it
// starts past them.
theorem byte_leaves_shape(): byte_leaves().shape() = [1, 0, 0, 0, 0, 0, 0, 0, 1] { refl }

// The shape counts a leaf's names without emitting it: each kind of leaf
// that takes names counts what its emission takes, and a pure leaf none.
// The layout is byte_leaves' buffers with slots for the words below eight.
fn names_emitted(s: Stmt, names: Nat) → Nat {
    match s.emit(Start, Layout::of(low(), 8, byte_leaves().capacities(), Homes([], [])), [], names) { None => 0, Some(c) => c.names }
}
theorem read_names_counted(): names_emitted(Invoke(Reads(0, 0, 0, 1, 2)), 5) = Invoke(Reads(0, 0, 0, 1, 2)).leaf_names(5) { refl }
theorem write_names_counted(): names_emitted(Invoke(Writes(0, 0, 1, 2, 3)), 5) = Invoke(Writes(0, 0, 1, 2, 3)).leaf_names(5) { refl }
theorem load_names_counted(): names_emitted(ops([BufferLoad(1, 0, 0)]), 5) = ops([BufferLoad(1, 0, 0)]).leaf_names(5) { refl }
theorem store_names_counted(): names_emitted(ops([BufferStore(1, 0, 0, 2)]), 5) = ops([BufferStore(1, 0, 0, 2)]).leaf_names(5) { refl }
theorem pure_names_counted(): names_emitted(ops([Const(64, 0, 3), Add(64, 1, 0, 0)]), 5) = ops([Const(64, 0, 3), Add(64, 1, 0, 0)]).leaf_names(5) { refl }
theorem exit_names_counted(): names_emitted(Exit(0), 5) = Exit(0).leaf_names(5) { refl }
theorem wide_names_counted(): names_emitted(ops([Const(64, 0, 3), BufferLoad(1, 0, 0), Add(64, 2, 1, 0), BufferStore(3, 0, 0, 2)]), 5)
    = ops([Const(64, 0, 3), BufferLoad(1, 0, 0), Add(64, 2, 1, 0), BufferStore(3, 0, 0, 2)]).leaf_names(5) { refl }

// A byte node's code as it is laid out, after any program and at any
// layout: the index fetched and compared with the capacity, the jump over
// the access to the label placed after it, and the result kept. A store
// reads the byte back, under the next label.
theorem load_laid_out(p: Prog, layout: Layout, out: List<Nat>):
    p.byte(Emission(layout, [], out), BufferLoad(1, 0, 2), 4, 5).prog =
        At(At(At(At(At(p.word_to(layout, 2, Rcx), 0, Block([MovRI(Rdx, BitVec::ofNat(4)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)])), 0, Jcc(AE, 6)),
            0, Block([MovRI(Rbx, layout.buffer_at(0)), AddRR(Rbx, Rcx)])), 0, LoadByte(ByteLoad(Rax, Rbx))), 6, Block([])).word_from(layout, out, 1, Rax) { refl }

theorem store_laid_out(p: Prog, layout: Layout, out: List<Nat>):
    p.byte(Emission(layout, [], out), BufferStore(1, 0, 2, 3), 4, 5).prog =
        At(At(At(At(At(At(At(At(At(At(p.word_to(layout, 2, Rcx), 0, Block([MovRI(Rdx, BitVec::ofNat(4)), CmpRR(Rcx, Rdx)])), 0, Jcc(AE, 6)).word_to(layout, 3, Rax),
            0, Block([MovRI(Rbx, layout.buffer_at(0)), AddRR(Rbx, Rcx)])), 0, StoreByte(ByteStore(Rbx, Rax))), 6, Block([])).word_to(layout, 2, Rcx),
            0, Block([MovRI(Rdx, BitVec::ofNat(4)), MovRI(Rax, BitVec::ofNat(0)), CmpRR(Rcx, Rdx)])), 0, Jcc(AE, 7)),
            0, Block([MovRI(Rbx, layout.buffer_at(0)), AddRR(Rbx, Rcx)])), 0, LoadByte(ByteLoad(Rax, Rbx))), 7, Block([])).word_from(layout, out, 1, Rax) { refl }

// cat with its pass inlined k times in its loop: code grows with k while
// the tree keeps cat's shape. `cat_x8`, about twice cat's code eight times
// over, is the size the CLI's test builds and runs
// (issues/native-compile-capacity.md); perf/fixtures/native_sizes builds the
// others.
fn passes(k: Nat) → Stmt { match k { Zero => cat_pass(), Succ(j) => Then(cat_pass(), passes(j)) } }
fn cat_x(k: Nat) → Source {
    Source::of([Buffer(512)], Then(cat_setup(512), Repeat(passes(k), 15)))
}
fn cat_x2() → Source { cat_x(1) }
fn cat_x4() → Source { cat_x(3) }
fn cat_x8() → Source { cat_x(7) }
fn cat_x16() → Source { cat_x(15) }
fn cat_x60() → Source { cat_x(59) }

// Procedures (docs/native/native-procedures-design.md §4): a non-tail recursive
// sum of 0..n, called from two sites. Words: 0 the argument, 1 the
// parameter, 2 the result, 3 to 5 scratch, 6 the inner call's result, 7 and
// 8 the outer calls' results, 9 their sum.
fn sum_body() → Stmt {
    Then(ops([Const(64, 4, 0), Equal(64, 3, 1, 4)]),
        Branch(3,
            ops([Const(64, 2, 0)]),
            Then(ops([Const(64, 4, 1), Sub(64, 5, 1, 4)]),
                Then(Perform(0, [5], [6]), ops([Add(64, 2, 6, 1)])))))
}
fn sum() → Procedure { Procedure(params := [1], results := [2], body := sum_body()) }

// The sum of 0..n by one call from `main`, with `room` bytes of stack
// below `main`'s frame: the sum of 0..20 nests 21 calls of `sum`, each
// taking its level (`Frame::level`, under the homes `write-elf` compiles
// with), and `sum` reaches itself, so each checks at its entry that its own
// level and a return address are left. A level short, the innermost call
// is refused and the program exits 139 (`call_depth_status`). `summing`'s
// deeper sum nests four calls.
fn summing_to(n, room: Nat) → Source {
    Source(functions := [], buffers := [], words := 10,
        main := Then(ops([Const(64, 0, n)]), Then(Perform(0, [0], [7]), Exit(7))), procedures := [sum()], room := room)
}
fn Source::cost(self src: Source, p: Nat) → Nat { src.charges(src.homes(), src.bodies()).cost(p) }
fn sum_level() → Nat { summing_to(20, 0).cost(0) }
fn summing() → Source {
    Source(functions := [], buffers := [], words := 10,
        main := Then(ops([Const(64, 0, 2)]), Then(Perform(0, [0], [7]),
            Then(ops([Const(64, 0, 3)]), Then(Perform(0, [0], [8]), Then(ops([Add(64, 9, 7, 8)]), Exit(9)))))),
        procedures := [sum()], room := 4 * sum_level() + 8)
}
fn summing_twenty() → Source { summing_to(20, 21 * sum_level() + 8) }
fn summing_shallow() → Source { summing_to(20, 20 * sum_level() + 8) }
// The compiled program's meaning at fuel `n` (`Source::bounded`, charged
// as `Source::charges` says), under the homes `write-elf` compiles with.
fn compiled_next(src: Source, n: Nat) → Next<BitVec(64)>(Events::linux()) {
    ITree::next(Events::linux(), src.bounded_tree([], src.charges(src.homes(), src.bodies()), src.left(src.homes(), src.bodies()), n))
}
theorem summing_exits(): compiled_next(summing(), 8) = Exits(BitVec::ofNat(9)) { refl }
theorem summing_twenty_exits(): compiled_next(summing_twenty(), 24) = Exits(BitVec::ofNat(210)) { refl }
theorem summing_shallow_exits(): compiled_next(summing_shallow(), 24) = Exits(call_depth_status()) { refl }

// How many items of the program are named `name`, and how many call label
// `label`.
fn Prog::named(self p: Prog, name: Nat) → Nat {
    match p { Start => 0, At(before, m, _) => match m.same(name) { True => Succ(before.named(name)), False => before.named(name) } }
}
fn Prog::calls_of(self p: Prog, label: Nat) → Nat {
    match p {
        Start => 0,
        At(before, _, item) => match item {
            CallTo(l) => match l.same(label) { True => Succ(before.calls_of(label)), False => before.calls_of(label) },
            _ => before.calls_of(label),
        },
    }
}
fn compiled_or_start(src: Source) → Prog { match src.compile(low(), Homes::slots(src), SpillAll().frames(src)) { None => Start, Some(p) => p } }

// It compiles, with every word in its slot and with the allocator's homes;
// its body is emitted once, at its label, and called from three sites: the
// two in `main` and its own.
theorem summing_compiles(): refused(summing()) = [] { refl }
theorem summing_allocated(): summing().allocation_ok(summing().homes()) = True { refl }
theorem summing_one_body(): compiled_or_start(summing()).named(1) = 1 { refl }
theorem summing_three_calls(): compiled_or_start(summing()).calls_of(1) = 3 { refl }

// Three parameters and three results: the results come back in RAX, RDX
// and RCX, each to its own word. (20, 8, 5) goes to (12, 3, 25), and the
// status 12 - 3 + 25 + 25 is another number with any of the three, or of
// the arguments, in another's place. Words: 0 to 2 the arguments, 3 to 5
// the parameters, 6 to 8 the results, 10 to 12 the caller's, 13 the status.
fn spread() → Procedure {
    Procedure(params := [3, 4, 5], results := [6, 7, 8], body := ops([Sub(64, 6, 3, 4), Sub(64, 7, 4, 5), Add(64, 8, 3, 5)]))
}
fn spreading() → Source {
    Source(functions := [], buffers := [], words := 14,
        main := Then(ops([Const(64, 0, 20), Const(64, 1, 8), Const(64, 2, 5)]), Then(Perform(0, [0, 1, 2], [10, 11, 12]),
            Then(ops([Sub(64, 13, 10, 11), Add(64, 13, 13, 12), Add(64, 13, 13, 12)]), Exit(13)))),
        procedures := [spread()])
}
theorem spreading_compiles(): refused(spreading()) = [] { refl }
theorem spreading_allocated(): spreading().allocation_ok(spreading().homes()) = True { refl }
// The allocator's homes keep the three parameters apart, all live as the
// body starts and none written by it, so the procedure fits and the source
// compiles with them.
theorem spreading_fits(): spread().fits(spreading().layout(low(), spreading().homes(), spreading().bodies()).body(0)) = True { refl }
theorem spreading_homed(): spreading().refusal(low(), spreading().homes(), spreading().bodies()) = [] { refl }
theorem spreading_exits(): ITree::next(Events::linux(), spreading().tree([], 4)) = Exits(BitVec::ofNat(59)) { refl }

// Two procedures calling each other (docs/native/native-procedures-are-functions-design.md
// §2.5): `a(n) = b(n - 1) + n` and `b(n) = 2 * a(n - 1) + n`, both 0 at 0,
// written over the same words. Each keeps its parameter across its call of
// the other, in its own frame, and each is called through the one contract
// with the other's as its assumption. a(5) = 23 nests six calls; with either
// calling itself, or with a parameter lost to the callee, the status is
// another number. Words as in `sum_body`.
fn alternate_body(other: Nat, twice: Bool) → Stmt {
    Then(ops([Const(64, 4, 0), Equal(64, 3, 1, 4)]),
        Branch(3,
            ops([Const(64, 2, 0)]),
            Then(ops([Const(64, 4, 1), Sub(64, 5, 1, 4)]),
                Then(Perform(other, [5], [6]), match twice {
                    True => ops([Add(64, 2, 6, 6), Add(64, 2, 2, 1)]),
                    False => ops([Add(64, 2, 6, 1)]),
                }))))
}
fn alternating_to(n, room: Nat) → Source {
    Source(functions := [], buffers := [], words := 10,
        main := Then(ops([Const(64, 0, n)]), Then(Perform(0, [0], [7]), Exit(7))),
        procedures := [
            Procedure(params := [1], results := [2], body := alternate_body(1, False)),
            Procedure(params := [1], results := [2], body := alternate_body(0, True)),
        ], room := room)
}
// a(5) calls a, b, a, b, a and b: three levels of each, and the last
// call's check.
fn alternating() → Source { alternating_to(5, 3 * alternating_to(5, 0).cost(0) + 3 * alternating_to(5, 0).cost(1) + 8) }
fn alternating_shallow() → Source { alternating_to(5, 3 * alternating_to(5, 0).cost(0) + 2 * alternating_to(5, 0).cost(1) + 8) }
theorem alternating_compiles(): refused(alternating()) = [] { refl }
theorem alternating_allocated(): alternating().allocation_ok(alternating().homes()) = True { refl }
theorem alternating_homed(): alternating().refusal(low(), alternating().homes(), alternating().bodies()) = [] { refl }
theorem alternating_two_bodies(): compiled_or_start(alternating()).named(1) + compiled_or_start(alternating()).named(2) = 2 { refl }
theorem alternating_calls(): compiled_or_start(alternating()).calls_of(1) + compiled_or_start(alternating()).calls_of(2) = 3 { refl }
theorem alternating_exits(): ITree::next(Events::linux(), alternating().tree([], 8)) = Exits(BitVec::ofNat(23)) { refl }
theorem alternating_compiled_exits(): compiled_next(alternating(), 8) = Exits(BitVec::ofNat(23)) { refl }
// Both procedures reach themselves through the other, so both check.
theorem alternating_checks(): alternating().procedures.checks() = [True, True] { refl }
// The source with any room exits 23; the compiled program a level short
// refuses the sixth call.
theorem alternating_shallow_source_exits(): ITree::next(Events::linux(), alternating_shallow().tree([], 8)) = Exits(BitVec::ofNat(23)) { refl }
theorem alternating_shallow_exits(): compiled_next(alternating_shallow(), 8) = Exits(call_depth_status()) { refl }

// A call of no procedure, and one with an argument too many, are refused
// at the call; a procedure whose body reads a word not its parameter, at
// the program.
fn calls_missing() → Source {
    Source(functions := [], buffers := [], words := 10, main := Then(ops([Const(64, 0, 2)]), Perform(3, [0], [7])), procedures := [sum()])
}
fn calls_wide() → Source {
    Source(functions := [], buffers := [], words := 10, main := Then(ops([Const(64, 0, 2)]), Perform(0, [0, 0], [7])), procedures := [sum()])
}
fn reads_outside() → Procedure { Procedure(params := [1], results := [2], body := ops([Add(64, 2, 1, 3)])) }
fn calls_outside() → Source {
    Source(functions := [], buffers := [], words := 10, main := Then(ops([Const(64, 0, 2)]), Perform(0, [0], [7])), procedures := [reads_outside()])
}
theorem calls_missing_refused(): refused(calls_missing()) = [2, 7, 14, 3, 0] { refl }
theorem calls_wide_refused(): refused(calls_wide()) = [2, 7, 14, 0, 0] { refl }
theorem calls_outside_refused(): refused(calls_outside()) = [0, 5, 15, 0, 0] { refl }

// ---------------------------------------------------------------------------
// Functions that call over views (docs/native/native-library-exports-design.md §3.1)

// view_put(buffer, i, v): `v`'s low byte stored at `i` of its buffer,
// returning the byte then there, or 256 past the end.
fn view_put() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 4,
        body := Sequence(Region(Ports([]), [UnsignedLessThan(width := 64, output := 5, left := 2, right := 1)], Ports([])),
            Conditional(Ports([]), 5, Ports([]), Ports([Port(id := 4, width := 64)]),
                Dataflow(Region(Ports([]), [BufferStore(output := 4, buffer := 0, index := 2, value := 3)], Ports([]))),
                Dataflow(Region(Ports([]), [Const(width := 64, output := 4, value := 256)], Ports([]))))))
}

// view_lender(buffer, buffer, i, v): `view_put(i, v)` over the whole of
// its second buffer, lent as the callee's first, to write or to read.
fn view_lender(written: Bool) → Function {
    Function(parameters := [0, 1, 2, 3, 4, 5], lent := 2, result := 8,
        body := Sequence(Region(Ports([]), [Const(width := 64, output := 9, value := 0)], Ports([])),
            Lend([View(buffer := 1, home := 2, start := 9, end := 3, written := written, base := 6, length := 7)], 0, [4, 5], 8)))
}
fn view_functions(written: Bool) → List<Function> { [view_lender(written), view_put()] }

// A program whose statement calls the lender on its two buffers.
fn view_source(written: Bool) → Source {
    Source(functions := view_functions(written), buffers := [Buffer(3), Buffer(4)], words := 10,
        main := Then(ops([Const(64, 0, 3), Const(64, 1, 88)]), Then(Compute(Call(1, [0, 1], 2)), Exit(2))))
}

// Its functions' values where the function compiler's planner puts them.
fn view_refused(written: Bool) → List<Nat> {
    view_source(written).refusal(low(), Homes::slots(view_source(written)).placed(plan_program(view_functions(written))), SpillAll().frames(view_source(written)))
}

// The functions link: placeless, the view's base hidden, and with rows
// of marks that hold. The lender needs its second buffer written, the
// callee its first.
theorem view_functions_linkable(): program_linkable(view_functions(True)) = True { refl }
theorem view_functions_rows(): program_rows(view_functions(True)) = [[True], [False, True]] { refl }
theorem view_source_compiles(): view_refused(True) = [] { refl }

// The control: the view lent to read, and the callee stores through it.
// The functions are evaluable and placeless as before; no rows hold, so
// they do not link.
theorem view_functions_read_placeless(): (program_evaluable(view_functions(False)) && program_placeless(view_functions(False))) = True { refl }
theorem view_functions_read_unrowed(): program_rowed(view_functions(False)) = False { refl }
theorem view_source_read_refused(): view_refused(False) = [0, 5, 17, 0, 0] { refl }

// The two as programs `write-elf` is asked for
// (crates/cli/tests/native_cat.rs): the first exits with 88, the byte its
// callee stored through the view and read back.
fn view_program() → Source { view_source(True) }
fn view_program_read() → Source { view_source(False) }

// ---------------------------------------------------------------------------
// The stack a program needs (`Source::need`)

fn need_slotted(src: Source) → Nat { src.need(Homes::slots(src), SpillAll().frames(src)) }
// `main`'s frame, then the room the source asks for: five levels of `sum`,
// and the word the last check leaves.
theorem summing_need(): need_slotted(summing_to(20, 5 * 112 + 8)) = 80 + 5 * 112 + 8 { refl }
// With no room, the return address of `main`'s call: a recursive callee
// checks at its entry, so nothing more is asked below `main`.
theorem summing_need_no_room(): need_slotted(summing_to(20, 0)) = 88 { refl }

// The bound follows the calls a body makes: `main` performs only
// `double`, which performs nothing and so does not check, so the program
// needs one level of `double` whatever room is asked below it, and never a
// level of `sum`, which nothing reaches.
fn double() → Procedure { Procedure(params := [1], results := [2], body := ops([Add(64, 2, 1, 1)])) }
fn doubling(room: Nat) → Source {
    Source(functions := [], buffers := [], words := 10,
        main := Then(ops([Const(64, 0, 2)]), Then(Perform(0, [0], [7]), Exit(7))), procedures := [double(), sum()], room := room)
}
theorem doubling_compiles(): refused(doubling(0)) = [] { refl }
theorem doubling_performs(): doubling(0).main.performed() = [0] { refl }
// Here `sum`'s call of procedure 0 is `double`: nothing reaches itself.
theorem doubling_checks(): doubling(0).procedures.checks() = [False, False] { refl }
theorem doubling_need(): need_slotted(doubling(0)) = 88 + SpillAll().frames(doubling(0)).frame(0).level([]) { refl }
theorem doubling_need_small_room(): need_slotted(doubling(0)) = need_slotted(doubling(16)) { refl }

// A call of a procedure the running body's layout does not list is
// refused; a listed one fits where its callee checks, or ranks below the
// caller, and not where it does neither: an unchecked call is how a chain
// with no check could grow without end.
theorem unlisted_call_refused():
    Layout::tabled(low(), 10, 10, [], Homes::slots(summing()), [sum()], [], [], [], [], [True], [1], 1).call_fits([], 0, [0], [7]) = False { refl }
theorem listed_call_fits():
    Layout::tabled(low(), 10, 10, [], Homes::slots(summing()), [sum()], [], [], [0], [], [True], [1], 1).call_fits([], 0, [0], [7]) = True { refl }
theorem unchecked_call_ranked():
    Layout::tabled(low(), 10, 10, [], Homes::slots(summing()), [sum()], [], [], [0], [], [False], [0], 1).call_fits([], 0, [0], [7]) = True { refl }
theorem unchecked_call_unranked():
    Layout::tabled(low(), 10, 10, [], Homes::slots(summing()), [sum()], [], [], [0], [], [False], [1], 1).call_fits([], 0, [0], [7]) = False { refl }

// ---------------------------------------------------------------------------
// The functions' room table (`Homes.rooms`)

// The table the planner's placement asks for: `view_put` is a leaf that
// saves nothing and needs no stack below its return address, the lender
// its call of it. With no table chosen every function is taken to save six
// registers and to call with eight slots.
fn view_planned(written: Bool) → Homes {
    Homes::slots(view_source(written)).placed(plan_program(view_functions(written))).roomed(program_rooms_planned(view_functions(written)))
}
theorem view_rooms_planned(): program_rooms_planned(view_functions(True)) = [0, 24] { refl }
theorem view_rooms_default(): Homes::slots(view_source(True)).room_table(view_functions(True)) = [48, 184] { refl }
theorem view_planned_compiles(): view_source(True).refusal(low(), view_planned(True), []) = [] { refl }
// What `main`'s calls of functions take of the stack, under each table: it
// calls the lender only, so the leaf's room is not counted.
theorem view_main_calls(): view_source(True).main.called() = [1] { refl }
// A call of a function the running body's layout does not list is refused.
theorem view_unlisted_function_refused():
    Layout::tabled(low(), 10, 10, [3, 4], Homes::slots(view_source(True)), [], view_functions(True), [], [], [], [], [], 0).function_fits(1, [0, 1], 2) = False { refl }
theorem view_listed_function_fits():
    Layout::tabled(low(), 10, 10, [3, 4], Homes::slots(view_source(True)), [], view_functions(True), [], [], [1], [], [], 0).function_fits(1, [0, 1], 2) = True { refl }
theorem view_calls_room_planned(): view_source(True).main.called().functions_room(view_planned(True).room_table(view_functions(True))) = 32 { refl }
theorem view_calls_room_default():
    view_source(True).main.called().functions_room(Homes::slots(view_source(True)).room_table(view_functions(True))) = 192 { refl }
// A table is checked, not trusted: one too small for the lender's call is
// refused where the functions link.
theorem view_small_table_refused():
    view_source(True).refusal(low(), Homes::slots(view_source(True)).placed(plan_program(view_functions(True))).roomed([0, 8]), []) = [0, 5, 17, 0, 0] { refl }

// A procedure's frame is packed (`Greedy::frame`): `double`'s two words
// share a register and word 0 is a name it never uses, so its frame has no
// words, where every word in its slot takes one for each name.
theorem double_frame_packed(): Greedy::standard().frame([], double()).words = 0 { refl }
theorem double_frame_homes(): Greedy::standard().frame([], double()).of.homes_numbered() = [0, 1, 1] { refl }
theorem double_frame_slotted(): SpillAll().frames(doubling(5)).frame(0).words = 3 { refl }

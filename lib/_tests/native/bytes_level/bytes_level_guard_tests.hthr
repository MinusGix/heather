// Probes of the bytes level's out-of-room stop, before it is built on
// (docs/language/ownership-design.md §17.9's test,
// issues/bytes-level-out-of-room.md step 1).
//
// - The guarded emission (`Program::lower`, step 3): each guarded call's
//   guard at the call's start and the stop after the routines.
// - A machine to run the lowered items by evaluation (`mach_run`): not the
//   model's relation (`MachineStep` is not executable) but its register
//   semantics (`execute_register`), the stack as words by address, CALL,
//   RET, JCC and JMP by label, and Linux's exit and write. A store below
//   the floor is a fault, so a run that returns or stops without one never
//   wrote below the stack the model gives it.
// - `down` guarded: lowered, run at the room the table by depth gives its
//   peak (returns, no guard fires), and one frame short (stops with the
//   reserved status). A writing recursion stops after the writes its
//   meaning makes above that depth. A two-routine cycle whose rooms differ:
//   each guard checks its callee's room. Programs with no cycle lower to
//   the bytes they lower to today. And the finding: under the table by
//   depth as built (`depth_rooms`), a guard can fire where the room is
//   there (`downh`), so the stop is read against `stop_rooms`.
import bytes_level::{run};
import bytes_memory;
import bytes_level_lower;
import bytes_level_scope;
import bytes_level_routines;
import bytes_level_routines_tests;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import linux_world;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// The guarded emission is `Program::lower` (bytes_level_routines)

fn lowers_guarded(p: Program, placement: List<Place>) → Bool { p.lower(placement).is_some() }

// ---------------------------------------------------------------------------
// A machine over the lowered items, by evaluation

record Named { name: Nat, item: Asm }

fn prog_items(p: Prog, acc: List<Named>) → List<Named> { match p { Start => acc, At(before, name, item) => prog_items(before, Cons(Named(name, item), acc)) } }

fn label_index(items: List<Named>, name: Nat, k: Nat) → Option<Nat> {
    match items { Nil => None, Cons(it, rest) => match it.name.same(name) { True => Some(k), False => label_index(rest, name, k + 1) } }
}

record Cell { at: Nat, word: BitVec(64) }

fn cell_read(cells: List<Cell>, at: Nat) → Option<BitVec(64)> {
    match cells { Nil => None, Cons(c, rest) => match c.at.same(at) { True => Some(c.word), False => cell_read(rest, at) } }
}

// `out`: the counts written, newest last; `low`: the lowest address stored.
record Mach { gprs: Gprs, flags: Flags, pc: Nat, cells: List<Cell>, out: List<Nat>, low: Nat }

inductive Halt { Stopped(status: Nat, out: List<Nat>, low: Nat), Returned(rax: Nat, out: List<Nat>, low: Nat), Fault(pc: Nat, why: Nat), Steps }

inductive Next { Again(m: Mach), Over(h: Halt) }

fn sentinel() → Nat { 1000000 }

fn block_run(instrs: List<Instruction>, gprs: Gprs, flags: Flags) → RegisterEffect {
    match instrs { Nil => RegisterEffect(gprs, flags), Cons(i, rest) => { let e = execute_register(i, gprs, flags); block_run(rest, e.gprs, e.flags) } }
}

// A word stored at `at`; below the floor, a fault (why 1).
fn Mach::store(self m: Mach, floor, at: Nat, word: BitVec(64), pc: Nat) → Next {
    match floor.leb(at) {
        False => Over(Fault(m.pc, 1)),
        True => Again(Mach(m.gprs, m.flags, pc, Cons(Cell(at, word), m.cells), m.out, m.low.min(at))),
    }
}

fn Mach::jump(self m: Mach, items: List<Named>, target: Nat) → Next {
    match label_index(items, target, 0) { None => Over(Fault(m.pc, 2)), Some(k) => Again(Mach(m.gprs, m.flags, k, m.cells, m.out, m.low)) }
}

fn Mach::regs(self m: Mach, gprs: Gprs, flags: Flags) → Next { Again(Mach(gprs, flags, m.pc + 1, m.cells, m.out, m.low)) }

fn Mach::syscall(self m: Mach) → Next {
    match read_gpr(Rax, m.gprs).toNat() {
        Zero => Over(Fault(m.pc, 3)),
        Succ(k) => match k {
            Zero => Again(Mach(write_gpr(Rax, read_gpr(Rdx, m.gprs), m.gprs), m.flags, m.pc + 1, m.cells, m.out ++ [read_gpr(Rdx, m.gprs).toNat()], m.low)),
            Succ(_) => match read_gpr(Rax, m.gprs).toNat().same(60) {
                True => Over(Stopped(read_gpr(Rdi, m.gprs).toNat(), m.out, m.low)),
                False => Over(Fault(m.pc, 3)),
            },
        },
    }
}

fn mach_step(items: List<Named>, floor: Nat, m: Mach) → Next {
    match items.nth(m.pc) {
        None => Over(Fault(m.pc, 0)),
        Some(it) => match it.item {
            Block(instrs) => { let e = block_run(instrs, m.gprs, m.flags); m.regs(e.gprs, e.flags) },
            Guarded(instrs) => { let e = block_run(instrs, m.gprs, m.flags); m.regs(e.gprs, e.flags) },
            Spill(st) => m.store(floor, stack_address(m.gprs, st.offset).toNat(), read_gpr(st.source, m.gprs), m.pc + 1),
            Reload(ld) => match cell_read(m.cells, stack_address(m.gprs, ld.offset).toNat()) {
                None => Over(Fault(m.pc, 4)),
                Some(w) => m.regs(write_gpr(ld.destination, w, m.gprs), m.flags),
            },
            CallTo(target) => {
                let at = push_address(m.gprs).toNat();
                match m.store(floor, at, BitVec::ofNat(m.pc + 1), m.pc) {
                    Over(h) => Over(h),
                    Again(m2) => Mach(write_gpr(Rsp, push_address(m.gprs), m2.gprs), m2.flags, m2.pc, m2.cells, m2.out, m2.low).jump(items, target),
                }
            },
            Ret => match cell_read(m.cells, read_gpr(Rsp, m.gprs).toNat()) {
                None => Over(Fault(m.pc, 5)),
                Some(w) => match w.toNat().same(sentinel()) {
                    True => Over(Returned(read_gpr(Rax, m.gprs).toNat(), m.out, m.low)),
                    False => Again(Mach(write_gpr(Rsp, read_gpr(Rsp, m.gprs).add(BitVec::ofNat(8)), m.gprs), m.flags, w.toNat(), m.cells, m.out, m.low)),
                },
            },
            Jcc(cc, target) => match condition_holds(cc, m.flags) { True => m.jump(items, target), False => m.regs(m.gprs, m.flags) },
            JccShort(cc, target) => match condition_holds(cc, m.flags) { True => m.jump(items, target), False => m.regs(m.gprs, m.flags) },
            Jmp(target) => m.jump(items, target),
            JmpShort(target) => m.jump(items, target),
            Syscall => m.syscall(),
            Code(_) => Over(Fault(m.pc, 6)),
            Load(_) => Over(Fault(m.pc, 6)),
            Store(_) => Over(Fault(m.pc, 6)),
            LoadByte(_) => Over(Fault(m.pc, 6)),
            StoreByte(_) => Over(Fault(m.pc, 6)),
            Proved(_, _, _, _) => Over(Fault(m.pc, 6)),
            Piece(_, _, _) => Over(Fault(m.pc, 6)),
            Refer(_, _, _) => Over(Fault(m.pc, 6)),
            Hole(_, _) => Over(Fault(m.pc, 6)),
        },
    }
}

fn mach_go(items: List<Named>, floor, fuel: Nat, m: Mach) → Halt {
    match fuel { Zero => Steps, Succ(more) => match mach_step(items, floor, m) { Over(h) => h, Again(m2) => mach_go(items, floor, more, m2) } }
}

fn zero_gprs() → Gprs { let z = BitVec::zero(n := 64); Gprs(z, z, z, z, z, z, z, z, z, z, z, z, z, z, z, z) }

// Routine `f` of the lowered program entered with word arguments `args`
// (at most six), its return address at `floor + i`, RBP the floor.
fn mach_run(program: Prog, f: Nat, args: List<Nat>, floor, i, fuel: Nat) → Halt {
    let items = prog_items(program, []);
    let sp = BitVec::ofNat(floor + i, n := 64);
    let entry = write_gpr(Rbp, BitVec::ofNat(floor), write_gpr(Rsp, sp, load_words(argument_registers(), args.map(λ (a: Nat) => BitVec::ofNat(a)),
        zero_gprs())));
    match label_index(items, f + 1, 0) {
        None => Fault(0, 2),
        Some(k) => mach_go(items, floor, fuel, Mach(entry, clear_flags(), k, [Cell(floor + i, BitVec::ofNat(sentinel()))], [], floor + i)),
    }
}

fn run_lowered_by(p: Program, placement: List<Place>, f: Nat, args: List<Nat>, i, fuel: Nat) → Halt {
    match p.lower(placement) { None => Fault(0, 9), Some(program) => mach_run(program, f, args, 4096, i, fuel) }
}

fn run_lowered(p: Program, placement: List<Place>, f: Nat, args: List<Nat>, i: Nat) → Halt { run_lowered_by(p, placement, f, args, i, 2000) }

fn item_count(p: Program, placement: List<Place>) → Nat { match p.lower(placement) { None => 0, Some(program) => prog_items(program, []).len() } }

fn halt_returned(h: Halt) → Option<Nat> { match h { Stopped(_, _, _) => None, Returned(rax, _, _) => Some(rax), Fault(_, _) => None, Steps => None } }
fn halt_stopped(h: Halt) → Option<Nat> { match h { Stopped(status, _, _) => Some(status), Returned(_, _, _) => None, Fault(_, _) => None, Steps => None } }
fn halt_out(h: Halt) → List<Nat> { match h { Stopped(_, out, _) => out, Returned(_, out, _) => out, Fault(_, _) => [], Steps => [] } }

// A halt as numbers, for reading: [0, status, low] ++ out stopped; [1, rax, low] ++ out returned; [2, pc, why] a fault; [3] out of steps.
fn halt_code(h: Halt) → List<Nat> {
    match h { Stopped(status, out, low) => [0, status, low] ++ out, Returned(rax, out, low) => [1, rax, low] ++ out, Fault(pc, why) => [2, pc, why], Steps => [3] }
}

// ---------------------------------------------------------------------------
// The probes' programs

// `shout(buf, x)`: one byte of `buf` to fd 1, then zero where `x` is zero,
// else `shout(buf, x - 1)`: a recursion that writes at every depth.
fn shout() → Routine {
    Routine([ref_id(0), word_id(1)],
        Seq(Leaf([Compute(Const(64, 5, 0)), Compute(Sub(64, 10, 1, 5)), Compute(Const(64, 2, 1)), Compute(Const(64, 3, 1))]),
            Seq(Sys(Write(2, 0, 3, 4)),
                Seq(Leaf([Compute(Const(64, 11, 0)), Compute(Equal(64, 6, 10, 11))]),
                    Branch(6, Leaf([Compute(Const(64, 7, 0))]),
                        Seq(Leaf([Compute(Const(64, 8, 1)), Compute(Sub(64, 9, 10, 8))]), Call(0, [ref_id(0), word_id(9)], [word_id(7)])))))),
        [word_id(7)])
}

fn shout_program() → Program { Program([shout()]) }

fn shout_places() → List<Place> { into([Rcx, R8, Rax, Rdx, Rax, Rcx, Rax, Rax, Rcx, Rdx, Rax]) }

fn shout_run(fuel, k: Nat) → Ran<Answer> { run(shout_program(), world_blocks(), fuel, 0, [Ref(Loc(1, 0)), Word(BitVec::ofNat(k))], world_heap(), piped()) }

fn shout_sent(o: Ran<Answer>) → List<Nat> {
    match o { Done(a) => a.io.sent(BitVec::ofNat(1)).map(λ (b: BitVec(8)) => b.toNat()), Exited(_, _) => [], Going(io) => io.sent(BitVec::ofNat(1)).map(λ (b: BitVec(8)) => b.toNat()), Stuck(_) => [] }
}

fn try_places(p: Program, ps: List<List<Gpr>>) → List<Bool> { ps.map(λ (rs: List<Gpr>) => lowers(p, into(rs))) }

// A cycle of two routines whose rooms differ: `ping(x)` is zero at zero,
// else `pong(x - 1)`; `pong(x)` first calls the leaf `inc` (unguarded: it
// reaches neither), then is zero at zero, else `ping(x - 1)`. So pong's
// room holds inc's and ping's does not, and each guard checks its callee's.
fn inc() → Routine { Routine([word_id(0)], Leaf([Compute(Const(64, 1, 1)), Compute(Add(64, 2, 0, 1))]), [word_id(2)]) }

fn ping() → Routine {
    Routine([word_id(0)],
        Seq(Leaf([Compute(Const(64, 1, 0)), Compute(Equal(64, 2, 0, 1))]),
            Branch(2, Leaf([Compute(Const(64, 3, 0))]), Seq(Leaf([Compute(Const(64, 4, 1)), Compute(Sub(64, 5, 0, 4))]), Call(2, [word_id(5)], [word_id(3)])))),
        [word_id(3)])
}

fn pong() → Routine {
    Routine([word_id(0)],
        Seq(Call(0, [word_id(0)], [word_id(1)]),
            Seq(Leaf([Compute(Const(64, 2, 0)), Compute(Equal(64, 3, 0, 2))]),
                Branch(3, Leaf([Compute(Const(64, 4, 0))]), Seq(Leaf([Compute(Const(64, 5, 1)), Compute(Sub(64, 6, 0, 5))]), Call(1, [word_id(6)], [word_id(4)]))))),
        [word_id(4)])
}

fn pingpong_program() → Program { Program([inc(), ping(), pong()]) }

// The guards' immediates, by the routine whose code holds them: `[routine,
// need]` pairs, flattened.
fn guard_needs_from(items: List<Named>, here: Nat, bound: Nat) → List<Nat> {
    match items {
        Nil => [],
        Cons(it, rest) => {
            let now = match it.name.leb(bound) && (1).leb(it.name) { True => it.name - 1, False => here };
            match it.item {
                Block(instrs) => match instrs {
                    Cons(i, more) => match more {
                        Nil => match i { AddRI32(dest, imm) => match dest { Rsp => match (2147483648).leb(imm.toNat()) {
                                True => Cons(now, Cons(4294967296 - imm.toNat(), guard_needs_from(rest, now, bound))),
                                False => guard_needs_from(rest, now, bound) },
                            _ => guard_needs_from(rest, now, bound) }, _ => guard_needs_from(rest, now, bound) },
                        Cons(_, _) => guard_needs_from(rest, now, bound),
                    },
                    Nil => guard_needs_from(rest, now, bound),
                },
                _ => guard_needs_from(rest, now, bound),
            }
        },
    }
}

fn guard_needs(p: Program, placement: List<Place>) → List<Nat> {
    match p.lower(placement) { None => [], Some(program) => guard_needs_from(prog_items(program, []), 0, p.routines.len()) }
}

fn pingpong_places() → List<Place> { into([Rcx, Rax] ++ [Rax, Rcx, Rax, Rdx, Rsi, Rax] ++ [Rax, Rax, Rcx, Rax, Rdx, Rsi, Rax]) }

// The finding: `downh(x)` is zero at zero, else calls the leaf `inc`, then
// `downh(x - 1)`. From one its run is one call deep, and the table by
// depth as built (`depth_rooms`) gives it the room for that. But the
// guard before its self call asks the callee's room by routine, which
// holds `inc`'s, and the callee entered at depth zero was given less.
fn downh() → Routine {
    Routine([word_id(0)],
        Seq(Leaf([Compute(Const(64, 1, 0)), Compute(Equal(64, 2, 0, 1))]),
            Branch(2, Leaf([Compute(Const(64, 3, 0))]),
                Seq(Call(0, [word_id(0)], [word_id(4)]), Seq(Leaf([Compute(Const(64, 5, 1)), Compute(Sub(64, 6, 0, 5))]), Call(1, [word_id(6)], [word_id(3)]))))),
        [word_id(3)])
}

fn downh_program() → Program { Program([inc(), downh()]) }

fn downh_places(saves: Nat) → List<Place> { into([Rcx, Rax]) ++ Cons(Saving(saves), into([Rax, Rcx, Rax, Rax, Rdx, Rsi, Rax])) }

// ---------------------------------------------------------------------------
// A program with no cycle lowers to the bytes it lowers to today

fn nats_same(a, b: List<Nat>) → Bool {
    match a { Nil => match b { Nil => True, Cons(_, _) => False }, Cons(x, xs) => match b { Nil => False, Cons(y, ys) => x.same(y) && nats_same(xs, ys) } }
}

fn code_nats(o: Option<Prog>) → Option<List<Nat>> { match o { None => None, Some(q) => Some(assemble(no_fills(), q, []).map(λ (b: BitVec(8)) => b.toNat())) } }

fn same_lowering(p: Program, placement: List<Place>) → Bool {
    match code_nats(p.lower_plain(placement)) {
        None => match p.lower(placement) { None => True, Some(_) => False },
        Some(old) => match code_nats(p.lower(placement)) { None => False, Some(new) => nats_same(old, new) },
    }
}

// ---------------------------------------------------------------------------
// The verdicts

fn halt_is(h: Halt, code: List<Nat>) → Bool { nats_same(halt_code(h), code) }

// `down` calls itself guarded and lowers.
theorem down_guarded(): nats_same(guards_at(program_guards(down_program().routines), 0), [0]) = True { refl }

theorem down_guarded_lowers(): lowers_guarded(down_program(), down_places()) = True { refl }

// At the room the stop's table gives its peak (two calls deep from two),
// it returns zero, storing nothing below the floor.
theorem down_room_is(): stop_rooms(down_program().routines)(0, 2).same(408) = True { refl }

theorem down_returns_in_room(): halt_is(run_lowered(down_program(), down_places(), 0, [2], 408), [1, 0, 4360]) = True { refl }

// One frame of the table short, it stops with the reserved status at its
// second call; its code's frames are smaller than the table's largest, so
// the exact edge is lower: it returns at 280 and stops at 279.
theorem down_spent_short(): halt_is(run_lowered(down_program(), down_places(), 0, [2], 408 - 136), [0, 139, 4296]) = True { refl }

theorem down_returns_at_edge(): halt_is(run_lowered(down_program(), down_places(), 0, [2], 280), [1, 0, 4232]) = True { refl }

theorem down_spent_at_edge(): halt_is(run_lowered(down_program(), down_places(), 0, [2], 279), [0, 139, 4303]) = True { refl }

// The writing recursion: its meaning from three writes four bytes, three
// calls deep; in its room by depth the code writes four, and short of it
// the code stops after a prefix of them (two, one).
theorem shout_lowers(): lowers_guarded(shout_program(), shout_places()) = True { refl }

theorem shout_meaning(): nats_same(shout_sent(shout_run(10, 3)), [7, 7, 7, 7]) = True { refl }

theorem shout_depth(): run_peak(shout_program(), world_blocks(), 10, 0, [Ref(Loc(1, 0)), Word(BitVec::ofNat(3))], world_heap(), piped()).same(3) = True { refl }

theorem shout_room_is(): stop_rooms(shout_program().routines)(0, 3).same(544) = True { refl }

theorem shout_writes_all(): halt_is(run_lowered(shout_program(), shout_places(), 0, [65536, 3], 544), [1, 0, 4424, 1, 1, 1, 1]) = True { refl }

theorem shout_spent_after_two(): halt_is(run_lowered(shout_program(), shout_places(), 0, [65536, 3], 272), [0, 139, 4296, 1, 1]) = True { refl }

theorem shout_spent_after_one(): halt_is(run_lowered(shout_program(), shout_places(), 0, [65536, 3], 136), [0, 139, 4232, 1]) = True { refl }

// The cycle of two: each guard checks its callee's room (ping's, pong's
// 184 and the return address; pong's, ping's 136 and it), not its own.
theorem pingpong_guarded(): nats_same(guards_at(program_guards(pingpong_program().routines), 1), [2]) &&
    (nats_same(guards_at(program_guards(pingpong_program().routines), 2), [1]) && nats_same(guards_at(program_guards(pingpong_program().routines), 0), [])) = True {
    refl
}

theorem pingpong_needs(): nats_same(guard_needs(pingpong_program(), pingpong_places()), [1, 192, 2, 144]) = True { refl }

theorem pingpong_returns(): halt_is(run_lowered(pingpong_program(), pingpong_places(), 1, [3], 400), [1, 0, 4208]) = True { refl }

theorem pingpong_spent(): halt_is(run_lowered(pingpong_program(), pingpong_places(), 1, [3], 300), [0, 139, 4252]) = True { refl }

// The table by depth as §17.7 built it (`depth_rooms`, deleted since): at
// each depth its routines' largest frames and their callees' rooms one
// depth less.
fn depth_only(routines: List<Routine>, p: Nat) → Nat → Nat {
    match p {
        Zero => λ (f: Nat) => depth_room(routines, λ (g: Nat) => 0, f),
        Succ(q) => λ (f: Nat) => depth_room(routines, depth_only(routines, q), f),
    }
}

// The finding: at the room the table by depth as built gives `downh`'s
// run from one (one call deep), its guard fires where a placement saves
// five; at the stop's table it returns. So the stop is read against
// `stop_rooms`, at least the table by routine at every depth.
theorem downh_depth(): run_peak(downh_program(), Blocks(λ (b: Nat) => False), 5, 1, [Word(BitVec::ofNat(1))], down_heap(), down_io()).same(1) = True {
    refl
}

theorem downh_depth_room(): depth_only(downh_program().routines, 1)(1).same(272) && stop_rooms(downh_program().routines)(1, 1).same(320) = True { refl }

theorem downh_spent_in_depth_room(): halt_is(run_lowered(downh_program(), downh_places(5), 1, [1], 272), [0, 139, 4256]) = True { refl }

theorem downh_returns_in_stop_room(): halt_is(run_lowered(downh_program(), downh_places(5), 1, [1], 320), [1, 0, 4264]) = True { refl }

// The floor is RBP: a program that guards refuses a placement saving six;
// the plain lowering takes it.
theorem downh_six_refused(): lowers_guarded(downh_program(), downh_places(6)) = False { refl }

theorem downh_six_plain(): downh_program().lower_plain(downh_places(6)).is_some() = True { refl }

// No cycle, no guard: the same bytes as today.
theorem acyclic_same(): same_lowering(lend_program(3), lend_places()) && (same_lowering(both_program(8), both_places()) &&
    (same_lowering(countdown_program(), countdown_places()) && (same_lowering(exits_nested(), nested_places()) &&
        same_lowering(echo_program(2), echo_places())))) = True {
    refl
}

// Probes of the bytes level (lib/native/bytes_level;
// issues/bytes-level-language.md, issues/bytes-level-on-the-contract.md),
// each beside its control, on the machine contract's heap: the reference
// experiment's program in the real language, a window passed to a callee
// as a reference and a length, two windows of one block written by one
// callee, a word node reading a reference refused by validity, a store
// that cuts a reference answering nothing, undefined bytes, a read and a
// write of the world, an exit, a plain loop over fuel, placelessness at one
// renaming, and canonical heaps.
import bytes_level::{run};
import bytes_memory;
import bytes_level_renames;
import bytes_level_canonical;
import bytes_level_fuel;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import linux_calls;
import linux_world;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// Block 0: sixteen zero bytes, writable. Block 1: the bytes 7, 8, 9, 10,
// only read. Block 2: sixteen undefined bytes, writable.
fn zeros() → List<BitVec(8)> { List::replicate(BitVec::zero(), 16) }

fn small() → List<BitVec(8)> { [BitVec::ofNat(7), BitVec::ofNat(8), BitVec::ofNat(9), BitVec::ofNat(10)] }

fn memory() → Heap { Heap([zeros(), small(), zeros()], [], [[], [], List::replicate(True, 16)]) }

fn blocks() → Blocks { Blocks(λ (b: Nat) => b.same(0) || b.same(2)) }

// A terminal that takes every write, and a pipe holding "hi".
fn io() → Io { Io::of(World::piped([[BitVec::ofNat(104), BitVec::ofNat(105)]])) }

fn fuel() → Nat { 16 }

fn go(p: Program, f: Nat, args: List<Value>) → Ran<Answer> { run(p, blocks(), fuel(), f, args, memory(), io()) }

// Word `i` of an answer, if the run is done and it is a word.
fn answer_word(o: Ran<Answer>, i: Nat) → Option<Nat> {
    match o { Done(a) => match a.words.nth(i) { None => None, Some(v) => match v { Word(w) => Some(w.toNat()), Ref(_) => None } }, Exited(_, _) => None,
        Going(_) => None, Stuck(_) => None }
}

fn stuck(o: Ran<Answer>) → Bool { match o { Done(_) => False, Exited(_, _) => False, Going(_) => False, Stuck(_) => True } }

fn going(o: Ran<Answer>) → Bool { match o { Done(_) => False, Exited(_, _) => False, Going(_) => True, Stuck(_) => False } }

fn exited(o: Ran<Answer>) → Option<Nat> { match o { Done(_) => None, Exited(status, _) => Some(status.toNat()), Going(_) => None, Stuck(_) => None } }

// The bytes a done run has written to `fd`.
fn sent(o: Ran<Answer>, fd: Nat) → Option<List<BitVec(8)>> {
    match o { Done(a) => Some(a.io.sent(BitVec::ofNat(fd))), Exited(_, _) => None, Going(_) => None, Stuck(_) => None }
}

fn word(x: Nat) → Value { Word(BitVec::ofNat(x)) }

// ---------------------------------------------------------------------------
// The experiment's program: a reference stored at `place`, loaded back, and
// a byte read through it.

fn cells() → Routine {
    Routine([ref_id(0), ref_id(1)], Leaf([StoreRef(0, 1), LoadRef(2, 0), Load(1, 3, 2)]), [word_id(3)])
}

fn cells_program() → Program { Program([cells()]) }

fn cells_args() → List<Value> { [Ref(Loc(0, 0)), Ref(Loc(1, 2))] }

theorem cells_valid(): cells_program().valid() = True { refl }

// The reference to byte 2 of block 1 stored at byte 0 of block 0, and the
// byte read through it is 9.
theorem cells_read_nine(): answer_word(go(cells_program(), 0, cells_args()), 0) = Some(9) { refl }

// Control: the reference aims into its own eight bytes, so the byte load
// takes a byte a reference holds, and the run is stuck.
theorem cells_byte_of_reference(): stuck(go(cells_program(), 0, [Ref(Loc(0, 0)), Ref(Loc(0, 3))])) = True { refl }

// Beside them: a plain zero byte.
theorem cells_byte_beside(): answer_word(go(cells_program(), 0, [Ref(Loc(0, 0)), Ref(Loc(0, 8))]), 0) = Some(0) { refl }

// Control: block 1 may not be written, so a reference stored there has no
// meaning.
theorem cells_read_only(): stuck(go(cells_program(), 0, [Ref(Loc(1, 0)), Ref(Loc(0, 8))])) = True { refl }

// Control: arguments of the wrong kind bind nothing.
theorem cells_word_argument(): stuck(go(cells_program(), 0, [word(0), Ref(Loc(1, 2))])) = True { refl }

// Control: with no fuel, nothing is called yet.
theorem cells_no_fuel(): going(run(cells_program(), blocks(), 0, 0, cells_args(), memory(), io())) = True { refl }

// From the experiment's probes (issues/ownership-reference-cells-spike.md):
// the program at any eight bytes of block 0 that fit, and its control past
// the block's end;
theorem cells_read_nine_at_eight(): answer_word(go(cells_program(), 0, [Ref(Loc(0, 8)), Ref(Loc(1, 2))]), 0) = Some(9) { refl }

theorem cells_past_end(): stuck(go(cells_program(), 0, [Ref(Loc(0, 9)), Ref(Loc(1, 2))])) = True { refl }

// a word load of a reference's eight bytes has no meaning, and its control,
// the word stored over the whole of the reference, reads back;
fn word_of_reference() → Program { Program([Routine([ref_id(0), ref_id(1)], Leaf([StoreRef(0, 1), Load(8, 2, 0)]), [word_id(2)])]) }

theorem word_of_reference_stuck(): stuck(go(word_of_reference(), 0, cells_args())) = True { refl }

fn replacing() → Program {
    Program([Routine([ref_id(0), ref_id(1)], Leaf([StoreRef(0, 1), Compute(Const(64, 2, 5)), Store(8, 0, 2), Load(8, 3, 0)]), [word_id(3)])])
}

theorem replaced_reads_word(): answer_word(go(replacing(), 0, cells_args()), 0) = Some(5) { refl }

// and a reference's load where only bytes are has none.
fn reference_of_bytes() → Program { Program([Routine([ref_id(0)], Leaf([LoadRef(1, 0)]), [ref_id(1)])]) }

theorem reference_of_bytes_stuck(): stuck(go(reference_of_bytes(), 0, [Ref(Loc(0, 0))])) = True { refl }

// ---------------------------------------------------------------------------
// A window passed as a reference and a length to a callee that writes it

// Routine 0: 42 at the window's first byte and at its last.
fn fill() → Routine {
    Routine([ref_id(0), word_id(1)],
        Leaf([Compute(Const(64, 2, 42)), Store(1, 0, 2), Compute(Const(64, 3, 1)), Compute(Sub(64, 4, 1, 3)), Offset(5, 0, 4), Store(1, 5, 2)]),
        [])
}

// Routine 1: the window of `length` bytes from byte 4 of its block lent to
// `fill`, then bytes 4, 5 and 6 read back.
fn lend(length: Nat) → Routine {
    Routine([ref_id(0)],
        Seq(Leaf([Compute(Const(64, 1, 4)), Offset(2, 0, 1), Compute(Const(64, 3, length))]),
            Seq(Call(0, [ref_id(2), word_id(3)], []),
                Leaf([Load(1, 4, 2), Compute(Const(64, 5, 1)), Offset(6, 2, 5), Load(1, 7, 6), Compute(Const(64, 8, 2)), Offset(9, 2, 8),
                    Load(1, 10, 9)]))),
        [word_id(4), word_id(7), word_id(10)])
}

fn lend_program(length: Nat) → Program { Program([fill(), lend(length)]) }

theorem lend_valid(): lend_program(3).valid() = True { refl }

theorem lend_first(): answer_word(go(lend_program(3), 1, [Ref(Loc(0, 0))]), 0) = Some(42) { refl }

theorem lend_between(): answer_word(go(lend_program(3), 1, [Ref(Loc(0, 0))]), 1) = Some(0) { refl }

theorem lend_last(): answer_word(go(lend_program(3), 1, [Ref(Loc(0, 0))]), 2) = Some(42) { refl }

// Control: a window of thirteen bytes from byte 4 passes the block's end,
// and the callee's store at its last byte has no meaning.
theorem lend_past_end(): stuck(go(lend_program(13), 1, [Ref(Loc(0, 0))])) = True { refl }

// Twelve bytes reach the end exactly.
theorem lend_to_end(): answer_word(go(lend_program(12), 1, [Ref(Loc(0, 0))]), 0) = Some(42) { refl }

// ---------------------------------------------------------------------------
// Two windows of one block written by one callee

// Routine 0: 1 at its first window, then 2 at its second.
fn two() → Routine {
    Routine([ref_id(0), ref_id(1)], Leaf([Compute(Const(64, 2, 1)), Store(1, 0, 2), Compute(Const(64, 3, 2)), Store(1, 1, 3)]), [])
}

// Routine 1: windows at bytes 0 and `apart` of its block lent to `two`,
// then bytes 0 and `apart` read back.
fn both(apart: Nat) → Routine {
    Routine([ref_id(0)],
        Seq(Leaf([Compute(Const(64, 1, apart)), Offset(2, 0, 1)]), Seq(Call(0, [ref_id(0), ref_id(2)], []), Leaf([Load(1, 3, 0), Load(1, 4, 2)]))),
        [word_id(3), word_id(4)])
}

fn both_program(apart: Nat) → Program { Program([two(), both(apart)]) }

theorem both_valid(): both_program(8).valid() = True { refl }

theorem both_first(): answer_word(go(both_program(8), 1, [Ref(Loc(0, 0))]), 0) = Some(1) { refl }

theorem both_second(): answer_word(go(both_program(8), 1, [Ref(Loc(0, 0))]), 1) = Some(2) { refl }

// Control: the two windows are one place, and it holds what was stored
// last.
theorem both_aliased(): answer_word(go(both_program(0), 1, [Ref(Loc(0, 0))]), 0) = Some(2) { refl }

// ---------------------------------------------------------------------------
// Validity

fn adds(first: Typed) → Routine { Routine([first, word_id(1)], Leaf([Compute(Add(64, 2, 0, 1))]), [word_id(2)]) }

// A word node reading a reference,
theorem add_of_reference_invalid(): Program([adds(ref_id(0))]).valid() = False { refl }

// and its control: the same node over two words.
theorem add_of_words_valid(): Program([adds(word_id(0))]).valid() = True { refl }

// A call whose argument's kind is not its callee's parameter's.
fn calls_fill_with(kind: ValueKind) → Routine {
    Routine([Typed(0, kind)], Seq(Leaf([Compute(Const(64, 1, 2))]), Call(0, [Typed(0, kind), word_id(1)], [])), [])
}

theorem call_kind_invalid(): Program([fill(), calls_fill_with(WordKind)]).valid() = False { refl }

theorem call_kind_valid(): Program([fill(), calls_fill_with(RefKind)]).valid() = True { refl }

// A system call's descriptor must be a word, so no command carries a
// reference.
fn writes_through(fd: Typed) → Routine {
    Routine([fd, ref_id(1)], Seq(Leaf([Compute(Const(64, 2, 2))]), Sys(Write(0, 1, 2, 3))), [word_id(3)])
}

theorem write_reference_fd_invalid(): Program([writes_through(ref_id(0))]).valid() = False { refl }

theorem write_word_fd_valid(): Program([writes_through(word_id(0))]).valid() = True { refl }

// ---------------------------------------------------------------------------
// A store that cuts a reference

// A reference stored at byte 4 of block 0, then the word 5's `bytes` bytes
// stored at byte `at`, then the reference loaded back and its byte read.
fn cutting(bytes, at: Nat) → Routine {
    Routine([ref_id(0), ref_id(1)],
        Leaf([Compute(Const(64, 2, 4)), Offset(3, 0, 2), StoreRef(3, 1), Compute(Const(64, 4, at)), Offset(5, 0, 4), Compute(Const(64, 6, 5)),
            Store(bytes, 5, 6), LoadRef(7, 3), Load(1, 8, 7)]),
        [word_id(8)])
}

fn cut_run(bytes, at: Nat) → Ran<Answer> { go(Program([cutting(bytes, at)]), 0, cells_args()) }

// Eight bytes at 8 cut the reference at 4 to 11: no meaning.
theorem cut_store_refused(): stuck(cut_run(8, 8)) = True { refl }

// One byte at 11, its last byte: no meaning either.
theorem cut_byte_refused(): stuck(cut_run(1, 11)) = True { refl }

// Control: a byte at 12, beside it, leaves it to be read through.
theorem store_beside_kept(): answer_word(cut_run(1, 12), 0) = Some(9) { refl }

// Control: eight bytes at 4, the whole of it, replace it, so it cannot be
// loaded back.
theorem whole_store_replaces(): stuck(cut_run(8, 4)) = True { refl }

// A typed copy moves a reference with its bytes: the reference stored at 0
// copied to 8 reads through as the original does.
fn copying(length: Nat) → Routine {
    Routine([ref_id(0), ref_id(1)],
        Leaf([StoreRef(0, 1), Compute(Const(64, 2, 8)), Offset(3, 0, 2), Compute(Const(64, 4, length)), Copy(3, 0, 4), LoadRef(5, 3), Load(1, 6, 5)]),
        [word_id(6)])
}

fn copy_run(length: Nat) → Ran<Answer> { go(Program([copying(length)]), 0, cells_args()) }

theorem copy_moves_reference(): answer_word(copy_run(8), 0) = Some(9) { refl }

// Control: four bytes of it cut it, and the copy has no meaning.
theorem copy_cut_refused(): stuck(copy_run(4)) = True { refl }

// ---------------------------------------------------------------------------
// Undefined bytes

// A byte of block 2 loaded, after a store there when `store` is set.
fn fresh(store: Bool) → Routine {
    Routine([ref_id(0)],
        Leaf(match store { True => [Compute(Const(64, 1, 6)), Store(1, 0, 1), Load(1, 2, 0)], False => [Load(1, 2, 0)] }), [word_id(2)])
}

// A load of an undefined byte has no meaning,
theorem undefined_load_stuck(): stuck(go(Program([fresh(False)]), 0, [Ref(Loc(2, 3))])) = True { refl }

// and its control: a store defines it.
theorem stored_then_loaded(): answer_word(go(Program([fresh(True)]), 0, [Ref(Loc(2, 3))]), 0) = Some(6) { refl }

// ---------------------------------------------------------------------------
// The world

// Read up to `asked` bytes from fd 0 into block 2 at 0, then write `back`
// bytes of it to fd 1, answering the read's count and its first byte.
fn echo(asked, back: Nat) → Routine {
    Routine([ref_id(0)],
        Seq(Leaf([Compute(Const(64, 1, 0)), Compute(Const(64, 2, asked))]),
            Seq(Sys(Read(1, 0, 2, 3)),
                Seq(Leaf([Compute(Const(64, 4, 1)), Compute(Const(64, 5, back))]), Seq(Sys(Write(4, 0, 5, 6)), Leaf([Load(1, 7, 0)]))))),
        [word_id(3), word_id(7)])
}

fn echo_run(asked, back: Nat) → Ran<Answer> { go(Program([echo(asked, back)]), 0, [Ref(Loc(2, 0))]) }

theorem echo_valid(): Program([echo(4, 2)]).valid() = True { refl }

// The pipe's two bytes land, and are written back.
theorem echo_count(): answer_word(echo_run(4, 2), 0) = Some(2) { refl }

theorem echo_first(): answer_word(echo_run(4, 2), 1) = Some(104) { refl }

theorem echo_sent(): sent(echo_run(4, 2), 1) = Some([BitVec::ofNat(104), BitVec::ofNat(105)]) { refl }

// Control: writing a third byte, which the read did not define, has no
// meaning.
theorem echo_past_read_stuck(): stuck(echo_run(4, 3)) = True { refl }

// A world whose every call fails.
fn failing() → World() {
    λ past c => match c {
        ReadCmd(_, _) => ReadFailed(5),
        WriteCmd(_, _) => WriteFailed(5),
        OpenCmd(_) => OpenFailed(5),
        CloseCmd(_) => CloseFailed(5),
        StatCmd(_) => StatFailed(5),
    }
}

// Read into block 0 (defined zeros), then load its first byte.
fn read_then_load() → Routine {
    Routine([ref_id(0)], Seq(Leaf([Compute(Const(64, 1, 0)), Compute(Const(64, 2, 4))]), Seq(Sys(Read(1, 0, 2, 3)), Leaf([Load(1, 4, 0)]))),
        [word_id(3), word_id(4)])
}

// A failed read leaves its window undefined: the load after it has no
// meaning,
theorem failed_read_undefines(): stuck(run(Program([read_then_load()]), blocks(), fuel(), 0, [Ref(Loc(0, 0))], memory(), Io::of(failing()))) = True { refl }

// and its control: the same read answered lands its bytes.
theorem answered_read_defines(): answer_word(go(Program([read_then_load()]), 0, [Ref(Loc(0, 0))]), 1) = Some(104) { refl }

// An exit ends the run with its status.
theorem exits(): exited(go(Program([Routine([], Seq(Leaf([Compute(Const(64, 0, 3))]), Exit(0)), [])]), 0, [])) = Some(3) { refl }

// ---------------------------------------------------------------------------
// A plain loop, over fuel

// Count `start` down to zero, a pass at a time.
fn countdown() → Routine {
    Routine([word_id(0)],
        Loop([word_id(0)], [word_id(1)],
            Leaf([Compute(Const(64, 2, 1)), Compute(Sub(64, 3, 1, 2)), Compute(Const(64, 4, 0)), Compute(Equal(64, 5, 3, 4))]), 5, [word_id(3)],
            [word_id(6)]),
        [word_id(6)])
}

fn count(n, from: Nat) → Ran<Answer> { run(Program([countdown()]), blocks(), n, 0, [word(from)], memory(), io()) }

theorem countdown_valid(): Program([countdown()]).valid() = True { refl }

// Three passes need the call's fuel and one for each turn back, two: at
// two it is going,
theorem countdown_going(): going(count(2, 3)) = True { refl }

// and at three it is done with zero.
theorem countdown_done(): answer_word(count(3, 3), 0) = Some(0) { refl }

// The first pass runs at the loop's own fuel: one pass needs only the
// call's.
theorem countdown_one_pass(): answer_word(count(1, 1), 0) = Some(0) { refl }

// Done stays done with more fuel: the theorem, at this program.
theorem countdown_settled(more: Nat): count(3, 3).Below(count(3 + more, 3)) {
    run_settled(Program([countdown()]), blocks(), 3, 0, [word(3)], memory(), io(), more)
}

// ---------------------------------------------------------------------------
// Placelessness at one renaming: blocks 0 and 1 swapped

fn swap(b: Nat) → Nat { match b { Zero => 1, Succ(c) => match c { Zero => 0, Succ(_) => b } } }

theorem swap_swap(b: Nat): swap(swap(b)) = b {
    match b { Zero => refl, Succ(c) => match c { Zero => refl, Succ(_) => refl } }
}

fn swapping() → Renaming { Renaming(swap, swap, swap_swap, swap_swap) }

fn swapped() → Heap { Heap([small(), zeros(), zeros()], [], [[], [], List::replicate(True, 16)]) }

fn swapped_blocks() → Blocks { Blocks(λ (c: Nat) => blocks().written(swap(c))) }

theorem swapped_renamed(): HeapRenamed(swapping(), memory(), swapped()) {
    HeapRenamed(bytes := λ c => match c { Zero => refl, Succ(d) => match d { Zero => refl, Succ(_) => refl } }, shadow := refl,
        undefined := λ c i => match c { Zero => refl, Succ(d) => match d { Zero => refl, Succ(_) => refl } })
}

theorem swapped_blocks_renamed(): BlocksRenamed(swapping(), blocks(), swapped_blocks()) { BlocksRenamed(written := λ c => refl) }

// The theorem at the experiment's program: the swapped run shows the same,
theorem cells_words_alike():
    shown(run(cells_program(), swapped_blocks(), fuel(), 0, rename_values(swapping(), cells_args()), swapped(), io())) =
        shown(run(cells_program(), blocks(), fuel(), 0, cells_args(), memory(), io())) {
    bytes_level_renames::run_words_alike(swapping(), cells_program(), blocks(), swapped_blocks(), swapped_blocks_renamed(), fuel(), 0, cells_args(),
        memory(), swapped(), swapped_renamed(), io())
}

// and it does answer: its references aim at the swapped blocks.
theorem cells_swapped_reads_nine():
    answer_word(run(cells_program(), swapped_blocks(), fuel(), 0, rename_values(swapping(), cells_args()), swapped(), io()), 0) = Some(9) { refl }

// Control: a reference answered is renamed, not the same.
fn answers_reference() → Program {
    Program([Routine([ref_id(0), ref_id(1)], Leaf([StoreRef(0, 1), LoadRef(2, 0)]), [ref_id(2)])])
}

fn answer_block(o: Ran<Answer>) → Option<Nat> {
    match o { Done(a) => match a.words.nth(0) { None => None, Some(v) => match v { Word(_) => None, Ref(loc) => Some(loc.block) } }, Exited(_, _) => None,
        Going(_) => None, Stuck(_) => None }
}

theorem reference_answered(): answer_block(go(answers_reference(), 0, cells_args())) = Some(1) { refl }

theorem reference_answered_renamed():
    answer_block(run(answers_reference(), swapped_blocks(), fuel(), 0, rename_values(swapping(), cells_args()), swapped(), io())) = Some(0) { refl }

// ---------------------------------------------------------------------------
// Canonical heaps

// A heap of buffers with its undefined block zero is canonical, and the
// program's answer, which holds a reference, is canonical too.
theorem memory_canonical(): memory().Canonical() {
    ⟨trivial, λ c => match c as λ x => (i: Nat) → memory().undefined(x, i) = True → byte_at(memory().bytes(x), i) = BitVec::zero() {
        Zero => λ i never => absurd(never),
        Succ(d) => match d as λ y => (i: Nat) → memory().undefined(Succ(y), i) = True → byte_at(memory().bytes(Succ(y)), i) = BitVec::zero() {
            Zero => λ i never => absurd(never),
            Succ(e) => match e as λ z => (i: Nat) → memory().undefined(Succ(Succ(z)), i) = True → byte_at(memory().bytes(Succ(Succ(z))), i) = BitVec::zero() {
                Zero => λ i _ => byte_at_zeros(16, i),
                Succ(_) => λ i never => absurd(never),
            },
        },
    }⟩
}

theorem cells_answer_canonical(a: Answer, ran: go(cells_program(), 0, cells_args()) = Done(a)): a.heap.Canonical() {
    run_canonical(cells_program(), blocks(), fuel(), 0, cells_args(), memory(), io(), memory_canonical(), a, ran)
}

// Control: an entry over bytes that are not there (block 1 has four) is no
// canonical heap.
fn overlong() → Heap { Heap([zeros(), small()], [Pointer(1, 0, Loc(0, 0))], []) }

theorem overlong_not_canonical(): ¬overlong().Canonical() { λ canonical => omega(canonical.left.left.left) }

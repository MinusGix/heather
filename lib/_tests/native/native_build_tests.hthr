// What the builder lowers small tools to (issues/native-source-builder.md):
// the words numbered as their binders are met, temporaries past them, and
// leaves cut where the compiler would refuse to go on (`List::fits_leaf`).
// When wider leaves relax that predicate, these are the sources that change.
import native_build;
import native_source;
import native_compile;
import function_ir;
import list;

// An exit's status computed into a temporary, the first word.
theorem exit_three(): run(exit(num(3))).source() = Source(functions := [], buffers := [], main := Then(Stmt::leaf([Const(64, 0, 3)]), Exit(0))) {
    refl
}

// `x := x + 1` reads the word it writes, so its sum goes through a
// temporary and the move into `x` is a leaf of its own: a leaf may not
// write a word an earlier node of it reads.
fn bump() → Tool { run(local(num(5), λ x => x.set(x.get() + num(1)) ++ exit(x.get()))) }

theorem bump_lowered(): bump().source() = Source(functions := [], buffers := [],
    main := Then(Stmt::leaf([Const(64, 0, 5), Const(64, 2, 1), Add(64, 1, 0, 2)]), Then(Stmt::leaf([Move(64, 0, 1)]), Exit(0)))) {
    refl
}

// A byte node is a leaf alone, the constants before it one leaf.
fn copy_byte() → Tool { buffer(4, λ b => run(b.put(num(0), b.at(num(1))))) }

theorem copy_byte_lowered(): copy_byte().source() = Source(functions := [], buffers := [Buffer(4, [])],
    main := Then(Stmt::leaf([Const(64, 0, 0), Const(64, 2, 1)]), Then(Stmt::leaf([BufferLoad(1, 0, 2)]), Stmt::leaf([BufferStore(3, 0, 0, 1)])))) {
    refl
}

// A word's being nonzero is a bit: the word compared with zero, and that
// bit flipped at one bit, all in one leaf; the branch tests it.
fn either() → Tool { run(local(num(7), λ x => branch(x.get(), exit(num(1)), exit(num(2))))) }

theorem either_lowered(): either().source() = Source(functions := [], buffers := [],
    main := Then(Stmt::leaf([Const(64, 0, 7), Const(64, 3, 0), Equal(64, 2, 0, 3), Const(1, 4, 1), BitXor(1, 1, 2, 4)]),
        Branch(1, Then(Stmt::leaf([Const(64, 1, 1)]), Exit(1)), Then(Stmt::leaf([Const(64, 1, 2)]), Exit(1))))) {
    refl
}

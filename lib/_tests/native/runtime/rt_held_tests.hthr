// Probes for `lib/native/runtime/rt_held.hthr` and `rt_held_fields.hthr`:
// a function of a laid record pinned to the held meaning of a compiled
// function's terms by evaluation, the world's promises from the two
// field lemmas, and the record-level statement of the compiled
// function's run with nothing proved for the function.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import vector;
import bitvec_bytes;
import nat_map;
import list_window;
import layout;
import stored;
import part;
import laid;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import rt_file_reflect;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import function_ir_writes;
import function_ir_link;
import function_ir_placeless;
import function_ir_lower;
import function_ir_lower_calls;
import x86_64_asm;
import runtime;
import runtime_file;
import stored_words;
import stored_accessor;
import rt_held;
import rt_held_fields;

laid(endian := BigEndian) record Tally { count: u64, total: u64 }

// What the source says: a function of the record.
fn Tally::bump(self t: Tally) → Mutated<Tally, u64> { Mutated(t with { count = t.count + 1 }, t.count + 1) }

// A field's reader and its writer, each the codec's accessor where the
// field lies.
runtime fn tally_count(span: List<u8>, length: u64) → u64 { span.u64_be_within(length, Tally::count_at) }

runtime fn List::tally_put_count(mut self span: List<u8>, length, v: u64) → u64 { span.put_u64_be_within(length, Tally::count_at, v) }

// What is compiled: the same function over the span, each field access a
// call.
runtime fn List::tally_bump(mut self span: List<u8>, length: u64) → u64 { span.tally_put_count(length, tally_count(span, length) + 1) }

// Its world, with its two callees marked.
fn bump_world(rest: List<List<u8>>) → FWorld {
    FWorld::of(List::tally_bump::compile.world, List::tally_bump::compile.callees, List::tally_bump::compile.fsigs, List::tally_bump::compile.writers, rest)
}

fn bump_held(rest: List<List<u8>>) → HWorld<Tally> {
    HWorld(bump_world(rest), [Reads(64, λ (t: Tally) => t.count)], [Writes(64, λ (t: Tally) (v: u64) => t with { count = v })])
}

// The pin: the held meaning of the compiled function's terms is the
// function of the record, by evaluation, at every span.
theorem bump_pinned(rest: List<List<u8>>, own: List<u8>, t: Tally, place, length: u64):
    List::tally_bump::rt.body.held(bump_held(rest), [Word(64), Word(64)], Pair(length, Pair(place, trivial)), own, t) = Tally::bump(t) { refl }

// What the world owes: one application of a field lemma per mark.
theorem bump_sound(rest: List<List<u8>>): Sound<Tally>(bump_held(rest), Tally::stored()) {
    Sound(
        And(λ place length own a g env holds =>
            Stored::u64_be().held_read(Tally::count_part(), refl, Tally::count_at, refl, own, FTm::word(bump_held(rest).fw.w.tys, g, env, length), a, holds), trivial),
        And(λ place length v own a g env holds =>
            Stored::u64_be().held_write(Tally::count_part(), refl, Tally::count_at, refl, own, FTm::word(bump_held(rest).fw.w.tys, g, env, length), a,
                FTm::word(bump_held(rest).fw.w.tys, g, env, v), holds), trivial))
}

// That the terms are a held function's is a verdict, by evaluation.
theorem bump_kept(rest: List<List<u8>>): List::tally_bump::rt.body.kept(bump_held(rest), 0) = True { refl }

// The record-level statement, with nothing proved for `bump`: where the
// span, lent under its length word, holds a tally, the compiled function
// returns what the function of the record returns, and leaves the span
// holding the tally that function leaves. Three things by conversion and
// one theorem: the pin of the held meaning to the function of the record,
// the reflection's of the byte meaning to the compiled function, the
// verdict, and `FFun::held_runs`.
theorem bump_runs(own: List<u8>, t: Tally, length: u64, holds: Tally::stored().Holds(own, length, t)):
    Agrees<Tally, u64>(Tally::stored(), length, Tally::bump(t), List::tally_bump(own, length)) {
    Agrees::along(Tally::stored(), length,
        List::tally_bump::rt.body.held(bump_held(Nil), [Word(64), Word(64)], Pair(length, Pair(0, trivial)), own, t), Tally::bump(t),
        FFun::bytes(List::tally_bump::rt, bump_world(Nil), Pair(length, Pair(0, trivial)), own), List::tally_bump(own, length),
        refl, List::tally_bump::reflects(Nil, own, 0, length),
        List::tally_bump::rt.held_runs(bump_held(Nil), Tally::stored(), bump_sound(Nil), 0, trivial, refl, Pair(length, Pair(0, trivial)), own, t, holds))
}

// Read out: the word, and what the span holds after.
theorem bump_value(own: List<u8>, t: Tally, length: u64, holds: Tally::stored().Holds(own, length, t)): List::tally_bump(own, length).value = t.count + 1 {
    sym(bump_runs(own, t, length, holds).value)
}

theorem bump_after(own: List<u8>, t: Tally, length: u64, holds: Tally::stored().Holds(own, length, t)):
    Tally::stored().get(List::tally_bump(own, length).after, 0) = (t with { count = t.count + 1 }) {
    bump_runs(own, t, length, holds).holds.right.right
}

// And the program's run is the compiled function, as for every
// `runtime fn`: the two readers and two writers of an eight-byte word,
// the count's reader and writer, and `tally_bump` last.
theorem bump_program(rest: List<List<u8>>, own: List<u8>, place, length: u64):
    program_run(List::tally_bump::program, Cons(own, rest), 6, [place, length]) = FTm::end_of(rest, List::tally_bump(own, length)) {
    List::tally_bump::runs_over(own, rest, place, length)
}

// ---------------------------------------------------------------------------
// A branch, and an operand

// The count goes up only below a limit.
fn Tally::bump_to(self t: Tally, limit: u64) → Mutated<Tally, u64> {
    match t.count.unsigned_lt_bit(limit) {
        False => Mutated(t, limit),
        True => Mutated(t with { count = t.count + 1 }, t.count + 1),
    }
}

runtime fn List::tally_bump_to(mut self span: List<u8>, length, limit: u64) → u64 {
    if tally_count(span, length) < limit {
        span.tally_put_count(length, tally_count(span, length) + 1)
    } else {
        limit
    }
}

fn to_world(rest: List<List<u8>>) → FWorld {
    FWorld::of(List::tally_bump_to::compile.world, List::tally_bump_to::compile.callees, List::tally_bump_to::compile.fsigs, List::tally_bump_to::compile.writers, rest)
}

fn to_held(rest: List<List<u8>>) → HWorld<Tally> {
    HWorld(to_world(rest), [Reads(64, λ (t: Tally) => t.count)], [Writes(64, λ (t: Tally) (v: u64) => t with { count = v })])
}

theorem to_sound(rest: List<List<u8>>): Sound<Tally>(to_held(rest), Tally::stored()) {
    Sound(
        And(λ place length own a g env holds =>
            Stored::u64_be().held_read(Tally::count_part(), refl, Tally::count_at, refl, own, FTm::word(to_held(rest).fw.w.tys, g, env, length), a, holds), trivial),
        And(λ place length v own a g env holds =>
            Stored::u64_be().held_write(Tally::count_part(), refl, Tally::count_at, refl, own, FTm::word(to_held(rest).fw.w.tys, g, env, length), a,
                FTm::word(to_held(rest).fw.w.tys, g, env, v), holds), trivial))
}

// The function's own `match` is the terms': the pin is `refl` through
// the branch. The length word is the second variable from the last, the
// limit after it.
theorem to_runs(own: List<u8>, t: Tally, length, limit: u64, holds: Tally::stored().Holds(own, length, t)):
    Agrees<Tally, u64>(Tally::stored(), length, Tally::bump_to(t, limit), List::tally_bump_to(own, length, limit)) {
    Agrees::along(Tally::stored(), length,
        List::tally_bump_to::rt.body.held(to_held(Nil), [Word(64), Word(64), Word(64)], Pair(limit, Pair(length, Pair(0, trivial))), own, t), Tally::bump_to(t, limit),
        FFun::bytes(List::tally_bump_to::rt, to_world(Nil), Pair(limit, Pair(length, Pair(0, trivial))), own), List::tally_bump_to(own, length, limit),
        refl, List::tally_bump_to::reflects(Nil, own, 0, length, limit),
        List::tally_bump_to::rt.held_runs(to_held(Nil), Tally::stored(), to_sound(Nil), 1, trivial, refl, Pair(limit, Pair(length, Pair(0, trivial))), own, t, holds))
}

// ---------------------------------------------------------------------------
// What is not a held function's

// A world with no marks: the store is a call of a computation that is
// not a field's writer.
theorem unmarked_not_kept(rest: List<List<u8>>): List::tally_bump::rt.body.kept(HWorld<Tally>(bump_world(rest), [], []), 0) = False { refl }

// The length word named wrongly: every field access is then under a word
// that is not the span's.
theorem other_length_not_kept(rest: List<List<u8>>): List::tally_bump_to::rt.body.kept(to_held(rest), 0) = False { refl }

// A field read under a word the body made: under it the accessor is the
// codec's only if the record is inside it, which nothing says of such a
// word. (A store under one is refused by the reflector already.)
theorem made_length_not_kept(rest: List<List<u8>>): FTm::Let(Lit(Word(64), 16), Let(Call(0, [2, 0]), Pure(Var(0)))).kept(bump_held(rest), 0) = False { refl }

// A term that stores a byte itself.
theorem put_not_kept(rest: List<List<u8>>): FTm::Put(0, 0, 0, Pure(Lit(Word(64), 0))).kept(bump_held(rest), 0) = False { refl }

// The pin is to the held meaning and not to the byte meaning: the bytes
// a store leaves are not the record's by evaluation.
// expect-error(kernel)
theorem bump_bytes_are_not_the_record(own: List<u8>, t: Tally, length: u64):
    List::tally_bump(own, length).after = Tally::stored().put(own, 0, t with { count = t.count + 1 }) { refl }

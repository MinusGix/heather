// Probes of an export's return theorem at a span function's ending
// (`lib/native/runtime/rt_file_returns.hthr`).
import function_ir;
import function_ir_eval;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_calls;
import function_ir_compile;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_stack;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_asm_table;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import runtime;
import rt;
import function_ir_writes;
import function_ir_lower_reads;
import x86_64_memory_contract;
import x86_64_memory_tiers;
import function_ir_run;
import rt_file;
import rt_file_loop;
import function_ir_state;

import rt_file_returns;

// At a function that leaves `after` and answers `value`, the code's word is
// `value`, no words after it, and the file's first buffer `after`.
theorem written_at_a_result<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>, addresses: List<BitVec(64)>,
    marks: List<Bool>, program: Prog, lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program),
    evaluable: program_evaluable(functions).IsTrue(), within: program_stores_within(functions, marks).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    before: Buffers(), loan: Loan<M>(fetch, data, stack, top, Lending::writing(counts, addresses, before, marks).spans()),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(),
    defined: program_run_defined(functions, before, f, arguments).IsTrue(), rest: Buffers(), after: List<BitVec(8)>, value: BitVec(64),
    runs: program_run(functions, before, f, arguments) = FTm::end_of(rest, Mutated(after, value))):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program)(f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(Lending::writing(counts, addresses, before, marks), top, f, arguments, before)(i, s),
        stack.AnsweredBoth(Lending::writing(counts, addresses, before, marks), value, Nil, Cons(after, rest))) {
    Ending::returns_written<M>(functions, placement, rooms, counts, addresses, marks, program, lowered, evaluable, within, fetch, data, last, origin,
        stack, top, before, loan, f, below, arguments, fits, defined, rest, Mutated(after, value), runs)
}

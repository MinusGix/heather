// Programs that do their own I/O as `runtime fn`s (runtime_program,
// docs/native/io-programs-design.md §3): each one's `Source` and the
// theorem that it reads as the function. Tests, not library: nothing
// imports this module; `crates/cli/tests/native_tools.rs` writes `tr_upper`
// and holds it to GNU tr.

import logic;
import nat;
import list;
import option;
import pair;
import bitvec;
import itree;
import coitree;
import coitree_rec;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_io;
import rt_io_lower;
import rt_io_loop;
import linux_world_while;
import rt_reflect;
import rt_io_reflect;
import rt_io_reflect_loop;
import rt_io_bridge;
import rt_io_program;
import native_tool_spans;
import runtime_program;

// Echo: read up to 64 bytes, write them, while a read brings something.
runtime fn echo_all(mut io: Io, buf: ByteBuffer(64)) → Partial(Mutated<Io, BitVec(64)>) {
    let mut buf = buf;
    let mut n: BitVec(64) = BitVec::ofNat(1);
    while BitVec::ofNat(0).unsigned_lt_bit(n) {
        let r = io.read_into(Io::stdin(), buf, BitVec::ofNat(0), BitVec::ofNat(64));
        let w = io.write_from(Io::stdout(), r.buf, BitVec::ofNat(0), r.result);
        buf := r.buf;
        n := r.result;
    }
    Pointed::ret(Mutated(io, n))
}

// What the generator states, written out: the Source's tree, read against
// any world, is `echo_all` from a zeroed buffer of 64 bytes.
fn echo_whole() → Io::Reads<BitVec(64)>(echo_all::source.tree_co([], Charges::free(), 0, 0), λ io => echo_all(io, List::replicate(zero_byte(), 64))) { echo_all::reads }

// tr: read into the buffer, raise what came back in place (a `runtime fn`
// over a span, lent the buffer), write it; while a read brings something.
// A write that fails (stdout full) ends the loop, and the status is 1, as
// GNU tr's is; the end of the input is status 0.
runtime fn tr_upper(mut io: Io, buf: ByteBuffer(256)) → Partial(Mutated<Io, BitVec(64)>) {
    let mut buf = buf;
    let mut n: BitVec(64) = BitVec::ofNat(1);
    let mut status: BitVec(64) = BitVec::ofNat(0);
    while BitVec::ofNat(0).unsigned_lt_bit(n) {
        let r = io.read_into(Io::stdin(), buf, BitVec::ofNat(0), BitVec::ofNat(256));
        let m = raise_span(r.buf, BitVec::ofNat(r.buf.len()), r.result, BitVec::ofNat(0));
        let w = io.write_from(Io::stdout(), m.after, BitVec::ofNat(0), r.result);
        buf := m.after;
        n := r.result;
        if w.signed_lt_bit(BitVec::ofNat(0)) {
            n := BitVec::ofNat(0);
            status := BitVec::ofNat(1);
        }
    }
    Pointed::ret(Mutated(io, status))
}

fn tr_whole() → Io::Reads<BitVec(64)>(tr_upper::source.tree_co([], Charges::free(), 0, 0), λ io => tr_upper(io, List::replicate(zero_byte(), 256))) { tr_upper::reads }

// Its Source calls `raise_span`'s program, lent the buffer.
theorem tr_upper_functions(): tr_upper::source.functions = raise_span::program { refl }

// ---------------------------------------------------------------------------
// A whole input in one buffer, then a verdict on it: `ascii_check` reads
// standard input into its buffer at a growing offset until a read brings
// nothing, then lends the buffer to `ascii_status` (native_tool_spans) and exits with its
// answer. The shape of a validator's `main` (examples/utf8): a loop that
// threads three locals, then a lent call after the loop whose word is the
// exit status. `crates/cli/tests/native_tools.rs` builds it and holds it to
// a reference.

runtime fn ascii_check(mut io: Io, buf: ByteBuffer(4096)) → Partial(Mutated<Io, BitVec(64)>) {
    let mut buf = buf;
    let mut filled: BitVec(64) = BitVec::ofNat(0);
    let mut going: BitVec(64) = BitVec::ofNat(1);
    let mut failed: BitVec(64) = BitVec::ofNat(0);
    while BitVec::ofNat(0).unsigned_lt_bit(going) {
        let room = BitVec::ofNat(4096).sub(filled);
        let r = io.read_into(Io::stdin(), buf, filled, room);
        let bad = room.unsigned_lt_bit(r.result);
        buf := r.buf;
        failed := if bad { BitVec::ofNat(1) } else { BitVec::ofNat(0) };
        going := if bad { BitVec::ofNat(0) } else if r.result = BitVec::ofNat(0) { BitVec::ofNat(0) } else { BitVec::ofNat(1) };
        filled := if bad { filled } else { filled.add(r.result) };
    }
    let m = ascii_status(buf, BitVec::ofNat(buf.len()), filled, failed);
    Pointed::ret(Mutated(io, m.value))
}

fn ascii_whole() → Io::Reads<BitVec(64)>(ascii_check::source.tree_co([], Charges::free(), 0, 0), λ io => ascii_check(io, List::replicate(zero_byte(), 4096))) { ascii_check::reads }

// ---------------------------------------------------------------------------
// Byte strings a program writes (`b"…"`, docs/native/io-programs-design.md
// §5 D3): each is read as one more buffer parameter after the function's
// own, and the `Source` holds it in a buffer of its own that starts as its
// bytes. `ascii_say` is `ascii_check` that also says its verdict, one of
// two strings by an `if`; `crates/cli/tests/native_tools.rs` builds it and
// holds its output and status to a reference.

runtime fn ascii_say(mut io: Io, buf: ByteBuffer(4096)) → Partial(Mutated<Io, BitVec(64)>) {
    let mut buf = buf;
    let mut filled: BitVec(64) = BitVec::ofNat(0);
    let mut going: BitVec(64) = BitVec::ofNat(1);
    let mut failed: BitVec(64) = BitVec::ofNat(0);
    while BitVec::ofNat(0).unsigned_lt_bit(going) {
        let room = BitVec::ofNat(4096).sub(filled);
        let r = io.read_into(Io::stdin(), buf, filled, room);
        let bad = room.unsigned_lt_bit(r.result);
        buf := r.buf;
        failed := if bad { BitVec::ofNat(1) } else { BitVec::ofNat(0) };
        going := if bad { BitVec::ofNat(0) } else if r.result = BitVec::ofNat(0) { BitVec::ofNat(0) } else { BitVec::ofNat(1) };
        filled := if bad { filled } else { filled.add(r.result) };
    }
    let m = ascii_status(buf, BitVec::ofNat(buf.len()), filled, failed);
    let mut wrote: BitVec(64) = BitVec::ofNat(0);
    if m.value = BitVec::ofNat(0) {
        let w = io.write_from(Io::stdout(), b"ascii\n", BitVec::ofNat(0), BitVec::ofNat(6));
        wrote := w;
    } else {
        let w = io.write_from(Io::stdout(), b"not ascii\n", BitVec::ofNat(0), BitVec::ofNat(10));
        wrote := w;
    }
    Pointed::ret(Mutated(io, m.value))
}

// What the generator states: the program from a zeroed buffer, with no
// argument for the strings, which are the `Source`'s.
fn ascii_say_whole() → Io::Reads<BitVec(64)>(ascii_say::source.tree_co([], Charges::free(), 0, 0), λ io => ascii_say(io, List::replicate(zero_byte(), 4096))) { ascii_say::reads }

// The strings are buffers after the parameter's, in the order the
// reflector's walk meets them (an `if`'s `False` arm is its `match`'s
// first), each its own length and starting as its bytes; the parameter's
// starts empty, its capacity zeroed.
theorem ascii_say_buffers(): ascii_say::source.buffers.map(λ b => b.capacity) = [4096, 10, 6] { refl }
theorem ascii_say_said(): ascii_say::source.buffers.map(λ b => b.initial) = [[], b"not ascii\n", b"ascii\n"] { refl }

// A buffer as a local (docs/native/io-programs-design.md §5 D2): `ascii_check`
// with its buffer made in the body, `List::replicate(0, n)`, in place of a
// parameter. The reading takes it as a parameter after the function's own,
// as a byte string, and the `Source` starts it zeroed, so the program is
// stated with no argument.
runtime fn ascii_local(mut io: Io) → Partial(Mutated<Io, BitVec(64)>) {
    let mut buf: List<u8> = List::replicate(0, 4096);
    let mut filled: BitVec(64) = BitVec::ofNat(0);
    let mut going: BitVec(64) = BitVec::ofNat(1);
    let mut failed: BitVec(64) = BitVec::ofNat(0);
    while BitVec::ofNat(0).unsigned_lt_bit(going) {
        let room = BitVec::ofNat(4096).sub(filled);
        let r = io.read_into(Io::stdin(), buf, filled, room);
        let bad = room.unsigned_lt_bit(r.result);
        buf := r.buf;
        failed := if bad { BitVec::ofNat(1) } else { BitVec::ofNat(0) };
        going := if bad { BitVec::ofNat(0) } else if r.result = BitVec::ofNat(0) { BitVec::ofNat(0) } else { BitVec::ofNat(1) };
        filled := if bad { filled } else { filled.add(r.result) };
    }
    let m = ascii_status(buf, BitVec::ofNat(buf.len()), filled, failed);
    Pointed::ret(Mutated(io, m.value))
}

fn ascii_local_whole() → Io::Reads<BitVec(64)>(ascii_local::source.tree_co([], Charges::free(), 0, 0), λ io => ascii_local(io)) { ascii_local::reads }

// One buffer, the local's, zeroed at its capacity; the reading is
// `ascii_check`'s (the parameter and the local read alike).
theorem ascii_local_buffers(): ascii_local::source.buffers.map(λ b => b.capacity) = [4096] { refl }
theorem ascii_local_zeroed(): ascii_local::source.buffers.map(λ b => b.initial) = [[]] { refl }
theorem ascii_local_reads_as_check(): ascii_local::eloop = ascii_check::eloop { refl }

// Two locals are two buffers, each zeroed at its own capacity, in the order
// the body makes them, even where they start alike.
runtime fn two_locals(mut io: Io) → Partial(Mutated<Io, u64>) {
    let mut a: List<u8> = List::replicate(0, 8);
    let mut b: List<u8> = List::replicate(0, 16);
    let r = io.read_into(Io::stdin(), a, 0, 8);
    a := r.buf;
    let s = io.read_into(Io::stdin(), b, 0, 16);
    b := s.buf;
    Pointed::ret(Mutated(io, r.result + s.result))
}

theorem two_locals_buffers(): two_locals::source.buffers.map(λ b => b.capacity) = [8, 16] { refl }
fn two_locals_whole() → Io::Reads<u64>(two_locals::source.tree_co([], Charges::free(), 0, 0), λ io => two_locals(io)) { two_locals::reads }

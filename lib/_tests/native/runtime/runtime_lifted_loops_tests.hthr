// Probes for loops in `runtime fn`s over a span (docs/language/sequencing-surface-design.md
// §23, docs/language/loop-combinator-design.md §6.3): a `while` or a `for`
// over words whose state is the `mut self` receiver and words is written
// where it stands, as the library's `Loop::steps` over `Mutated<span, S>`,
// which the `runtime` generator reads as one loop node over the span; a
// loop in a loop is one node inside another, and a value the inner loop
// reads from outside it is bound before it. A loop whose state is not the
// receiver is compiled too. Nothing here is proved by hand: each theorem
// runs the function by evaluation.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import algebra;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;
import rt_file;
import runtime_file;
import relation_props;
import order;
import sorting;
import perm;
import bitvec_order;
import utf8;
import bitvec_concat;
import bitvec_shift_nat;
import ring;
import list_window;
import fintype;
import bitvec_fintype;
import derive;
import rt_reflect;
import rt_loop;
import rt_file_lower;
import rt_file_loop;
import rt_file_reflect;
import function_ir_state;
import function_ir_run;
import function_ir_writes;
import function_ir_link;
import function_ir_placeless;
import function_ir_lower;
import function_ir_lower_calls;
import x86_64_asm;

// ---------------------------------------------------------------------------
// A `while` over the span, moving a second local: the hole an insertion
// opens, as examples/sort's `sift` writes it by hand.

runtime fn List::open_hole(mut self s: List<u8>, n, i, key: u64) → u64 {
    let mut j = i;
    while 0 < j ∧ key < s.byte_within(n, j - 1).zero_extend(56) decreases j.toNat() {
        s.put_within(n, j, s.byte_within(n, j - 1));
        j := j - 1;
    }
    j
}

theorem open_hole_runs(): List::open_hole([1, 3, 5, 7, 0], 5, 4, 4) = Mutated([1, 3, 5, 5, 7], 2) { refl }

// ---------------------------------------------------------------------------
// Insertion sort as two loops: the `for` over the span is a method, and the
// `while` in it a method of that one.

runtime fn List::insertion(mut self s: List<u8>, n: u64) → u64 {
    for i in 0..n {
        let key: u64 = s.byte_within(n, i).zero_extend(56);
        let mut j = i;
        while 0 < j ∧ key < s.byte_within(n, j - 1).zero_extend(56) decreases j.toNat() {
            s.put_within(n, j, s.byte_within(n, j - 1));
            j := j - 1;
        }
        s.put_within(n, j, key.truncate(8, 56));
    }
    n
}

theorem insertion_sorts(): List::insertion([3, 1, 2, 0, 2], 5).after = [0, 1, 2, 2, 3] { refl }

// ---------------------------------------------------------------------------
// A loop whose state is not the receiver: compiled, and called.

runtime fn sum_below(n: u64) → u64 {
    let mut s: u64 = 0;
    for i in 0..n { s := s + i; }
    s
}

theorem sum_below_5(): sum_below(5) = 10 { refl }

// ---------------------------------------------------------------------------
// A span that carries its length (docs/native/span-record-design.md): an
// element is read and stored with a found proof that its index is inside,
// and a loop states what it keeps (`invariant`), which its body reads and
// the code after it reads at the loop's result; what a loop cannot change
// (an outer loop's test, a fact in scope) it is given without stating it.
// Not yet a `runtime fn`.

record Bytes(n: u64) { bytes: List<u8>, sized: bytes.len() = n.toNat() }

fn Bytes::len({n: u64}, self s: Bytes(n)) → u64 { n }

fn Bytes::at({n: u64}, self s: Bytes(n), i: u64, inside: ∥i < s.len()∥ := bv_omega) → u8 { s.bytes.byte_within(n, i) }

fn Bytes::put({n: u64}, self s: Bytes(n), i: u64, v: u8, inside: ∥i < s.len()∥ := bv_omega) → Bytes(n) {
    Bytes(s.bytes.with_byte_within(n, i, v), trans(s.bytes.len_with_byte_within(n, i, v), s.sized))
}

// The final store reads `j <= i` after the inner loop, and its reads in the
// test read `0 < j` before `s[j - 1]`.
fn Bytes::sort({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        let key: u8 = s[i];
        let mut j = i;
        while 0 < j && key < s[j - 1] invariant j <= i decreases j.toNat() {
            s[j] := s[j - 1];
            j := j - 1;
        }
        s[j] := key;
    }
    n
}

theorem sort_sorts(): Bytes::sort(Bytes([3, 1, 2, 0, 2], refl), n := 5).after.bytes = [0, 1, 2, 2, 3] { refl }

// Each byte plus all those before it, as they are when it is reached. The
// inner loop reads and stores `s[i]`, which is inside by the outer loop's
// test `i < s.len()`, and reads `s[j]`, by its own test `j < i` beside
// that one: a loop is given the facts it cannot change, with no
// `invariant` naming them.
fn Bytes::add_earlier({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        for j in 0..i {
            s[i] := s[i] + s[j];
        }
    }
    n
}

theorem add_earlier_runs(): Bytes::add_earlier(Bytes([1, 2, 3, 4], refl), n := 4).after.bytes = [1, 3, 7, 15] { refl }

// Each byte raised to the largest before it: a store under an `if` whose
// test reads the span. The test's reads are given their proofs once, as
// the store's are, rather than searched for again in each companion's
// copy of the body (issues/store-under-if-in-lifted-loop-cost.md).
fn Bytes::running_max({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        for j in 0..i {
            if s[i] < s[j] { s[i] := s[j]; }
        }
    }
    n
}

theorem running_max_runs(): Bytes::running_max(Bytes([1, 3, 2, 0, 5], refl), n := 5).after.bytes = [1, 3, 3, 3, 5] { refl }

// The outer loop has its unfolding and branch equations too. The inner
// loop's fact `i < s.len()` is passed as `found_fact<…>(fact := bv_omega)`,
// which the outer loop's lowering finds once as `#found_1`; a bare
// `bv_omega` there was searched again in every companion, and the decrease
// hypothesis naming the call held a search `bv_omega` could not spell, so
// the outer `#ext` was refused
// (issues/bv-omega-unspellable-fact-refuses-outer-loop-ext.md).
theorem running_max_outer_stops({n: u64}, s: Bytes(n), i: u64, h: ¬(i < s.len())):
    Bytes::running_max_loop(n, s, i) = Mutated(s, i)
{ Bytes::running_max_loop::done(n, s, i, h) }

// The same with the inner loop a `while`, which states that the outer
// loop's index stays inside.
fn Bytes::running_max_while({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        let mut j: u64 = 0;
        while j < i invariant i < s.len() decreases (i - j).toNat() {
            if s[i] < s[j] { s[i] := s[j]; }
            j := j + 1;
        }
    }
    n
}

theorem running_max_while_runs(): Bytes::running_max_while(Bytes([1, 3, 2, 0, 5], refl), n := 5).after.bytes = [1, 3, 3, 3, 5] { refl }

// Without `j <= i` kept, the store after the loop has no proof that `j` is
// inside.
// expect-error: did not give
fn Bytes::sort_unkept({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        let key: u8 = s[i];
        let mut j = i;
        while 0 < j && key < s[j - 1] invariant j <= i decreases j.toNat() {
            s[j] := s[j - 1];
            j := j - 1;
        }
        s[j + 1] := key;
    }
    n
}

// A test about a local the loop assigns is not passed on: `j < s.len()`
// holds where the loop starts, but only the loop can say that it keeps it.
// expect-error: did not give
fn Bytes::clear_below({n: u64}, mut self s: Bytes(n), k: u64) → u64 {
    let mut j = k;
    if j < s.len() {
        while 0 < j decreases j.toNat() { s[j] := 0; j := j - 1; }
    }
    j
}

fn Bytes::clear_below_kept({n: u64}, mut self s: Bytes(n), k: u64) → u64 {
    let mut j = k;
    if j < s.len() {
        while 0 < j invariant j < s.len() decreases j.toNat() { s[j] := 0; j := j - 1; }
    }
    j
}

theorem clear_below_runs(): Bytes::clear_below_kept(Bytes([1, 2, 3, 4], refl), 2, n := 4).after.bytes = [1, 0, 0, 4] { refl }

// A loop's state of two locals is a generated record, `f#State`, which the
// loop carries round as its two words (`Loop::steps`, §6.2).
runtime fn two_locals(i: u64) → u64 {
    let mut j = i;
    let mut c: u64 = 0;
    while 0 < j decreases j.toNat() {
        j := j - 1;
        c := c + 2;
    }
    c
}

theorem two_locals_runs(): two_locals(5) = 10 { refl }


// Probes of an enum whose constructors carry fields, built and matched in
// a `runtime fn`'s body (docs/native/runtime-fn-setups-design.md §16.16).
// Its value is held as its tag word and then its payload's slots, every
// constructor's fields in turn (`EnumInfo.slots`), a slot another
// constructor leaves at its default; a constructor applied to its fields
// is `Tm::Inject`, and an arm's read of a field `Tm::Slot`. Tests, not
// library: nothing imports this module.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import tactic;
import bitvec;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// ---------------------------------------------------------------------------
// One constructor with a field.

inductive Pocket { Empty, Holds(n: u64) }

runtime fn pocket_or(x: u64, y: u64) → u64 {
    let p = if x < y { Holds(x) } else { Empty };
    match p { Empty => y, Holds(n) => n + y }
}

theorem pocket_or_runs(): program_eval(pocket_or::program, 0, [BitVec::ofNat(2), BitVec::ofNat(5)]) = 7 ∧
    program_eval(pocket_or::program, 0, [BitVec::ofNat(9), BitVec::ofNat(5)]) = 5 {
    ⟨pocket_or::agrees(BitVec::ofNat(2), BitVec::ofNat(5)), pocket_or::agrees(BitVec::ofNat(9), BitVec::ofNat(5))⟩
}

theorem pocket_or_agrees(x, y: u64): program_eval(pocket_or::program, 0, [x, y]) = pocket_or(x, y) { pocket_or::agrees(x, y) }

// The enum's slots: one word, `Holds`'s.
theorem pocket_or_slots(): pocket_or::world.tys(0).alts.slots = [Word(64)] { refl }

// ---------------------------------------------------------------------------
// Constructors of no, one and two fields, each in slots of its own.

inductive Shape { Dot, Line(len: u64), Rect(w: u64, h: u64) }

runtime fn shape_area(k: u64, a: u64, b: u64) → u64 {
    let s = if k < 1 { Dot } else { if k < 2 { Line(a) } else { Rect(a, b) } };
    match s { Dot => 0, Line(l) => l, Rect(w, h) => w * h }
}

theorem shape_area_runs(): program_eval(shape_area::program, 0, [BitVec::ofNat(0), BitVec::ofNat(3), BitVec::ofNat(4)]) = 0 ∧
    program_eval(shape_area::program, 0, [BitVec::ofNat(1), BitVec::ofNat(3), BitVec::ofNat(4)]) = 3 ∧
    program_eval(shape_area::program, 0, [BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(4)]) = 12 {
    ⟨shape_area::agrees(BitVec::ofNat(0), BitVec::ofNat(3), BitVec::ofNat(4)),
        ⟨shape_area::agrees(BitVec::ofNat(1), BitVec::ofNat(3), BitVec::ofNat(4)), shape_area::agrees(BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(4))⟩⟩
}

theorem shape_area_slots(): shape_area::world.tys(0).alts.slots = [Word(64), Word(64), Word(64)] { refl }

// A `match h:` on it, an arm reading a field.
runtime fn shape_width(k: u64, a: u64) → u64 {
    let s = if k < 1 { Dot } else { Line(a) };
    match h: s { Dot => 1, Line(l) => l + 1, Rect(w, _) => w }
}

theorem shape_width_agrees(k, a: u64): program_eval(shape_width::program, 0, [k, a]) = shape_width(k, a) { shape_width::agrees(k, a) }

// ---------------------------------------------------------------------------
// An enum with one slot returned: its tag word in RAX and its slot beside
// it in RDX (`Ty::Out`, `RecInfo::enum_rest`, `f::agrees_also`), as a
// two-word record is.

runtime fn pocket_below(x: u64, y: u64) → Pocket { if x < y { Holds(y - x) } else { Empty } }

theorem pocket_below_runs(): program_eval(pocket_below::program, 0, [BitVec::ofNat(2), BitVec::ofNat(5)]) = 1 ∧
    program_eval_also(pocket_below::program, [BitVec::ofNat(2), BitVec::ofNat(5)]) = [BitVec::ofNat(3)] {
    ⟨pocket_below::agrees(BitVec::ofNat(2), BitVec::ofNat(5)), pocket_below::agrees_also(BitVec::ofNat(2), BitVec::ofNat(5))⟩
}

theorem pocket_below_agrees(x, y: u64):
    program_eval(pocket_below::program, 0, [x, y]) = RecInfo::enum_word(pocket_below::world.tys, 0, pocket_below(x, y)) ∧
    program_eval_also(pocket_below::program, [x, y]) = RecInfo::enum_rest(pocket_below::world.tys, 0, pocket_below(x, y)) {
    ⟨pocket_below::agrees(x, y), pocket_below::agrees_also(x, y)⟩
}

// The constructor without the field leaves its slot at the default.
theorem pocket_below_empty(): program_eval_also(pocket_below::program, [BitVec::ofNat(9), BitVec::ofNat(5)]) = [BitVec::ofNat(0)] {
    pocket_below::agrees_also(BitVec::ofNat(9), BitVec::ofNat(5))
}

// ---------------------------------------------------------------------------
// A field that is a bit: its slot holds the one-bit word.

inductive Flag { Off, On(b: Bool) }

runtime fn flag_of(x: u64) → u64 {
    let f: Flag = if x < 1 { Off } else { if x < 5 { On(True) } else { On(False) } };
    match f { Off => 0, On(b) => if b { 1 } else { 2 } }
}

theorem flag_of_runs(): program_eval(flag_of::program, 0, [BitVec::ofNat(3)]) = 1 ∧ program_eval(flag_of::program, 0, [BitVec::ofNat(9)]) = 2 {
    ⟨flag_of::agrees(BitVec::ofNat(3)), flag_of::agrees(BitVec::ofNat(9))⟩
}

theorem flag_of_slots(): flag_of::world.tys(0).alts.slots = [Bit] { refl }

// ---------------------------------------------------------------------------
// An enum with fields as a parameter: passed as its words, its tag word and
// then its payload's slots (`RecInfo::enum_words`), as C passes a structure
// `{ tag, slots… }` of integer words, one register each. The theorem is
// stated at the enum's values, so a tag past the last constructor is
// nothing the code is asked about.

runtime fn pocket_n(p: Pocket) → u64 { match p { Empty => 0, Holds(n) => n } }

theorem pocket_n_agrees(p: Pocket): program_eval(pocket_n::program, 0, RecInfo::enum_words(pocket_n::world.tys, 0, p)) = pocket_n(p) {
    pocket_n::agrees(p)
}

theorem pocket_n_runs(): program_eval(pocket_n::program, 0, [BitVec::ofNat(1), BitVec::ofNat(7)]) = 7 ∧
    program_eval(pocket_n::program, 0, [BitVec::ofNat(0), BitVec::ofNat(0)]) = 0 {
    ⟨pocket_n::agrees(Holds(BitVec::ofNat(7))), pocket_n::agrees(Empty)⟩
}

// Three slots and a word after them: five words.
runtime fn shape_scaled(s: Shape, k: u64) → u64 { match s { Dot => k, Line(l) => l * k, Rect(w, h) => w * h * k } }

theorem shape_scaled_agrees(s: Shape, k: u64):
    program_eval(shape_scaled::program, 0, RecInfo::enum_words(shape_scaled::world.tys, 0, s) ++ [k]) = shape_scaled(s, k) {
    shape_scaled::agrees(s, k)
}

theorem shape_scaled_runs(): program_eval(shape_scaled::program, 0, [BitVec::ofNat(2), BitVec::ofNat(0), BitVec::ofNat(3), BitVec::ofNat(4), BitVec::ofNat(5)]) = 60 {
    shape_scaled::agrees(Rect(BitVec::ofNat(3), BitVec::ofNat(4)), BitVec::ofNat(5))
}

// A word before it, and an enum both in and out: its words in, its tag
// word and slot out.
runtime fn pocket_add(x: u64, p: Pocket) → Pocket { match p { Empty => Holds(x), Holds(n) => Holds(n + x) } }

theorem pocket_add_agrees(x: u64, p: Pocket):
    program_eval(pocket_add::program, 0, Cons(x, RecInfo::enum_words(pocket_add::world.tys, 0, p))) = RecInfo::enum_word(pocket_add::world.tys, 0, pocket_add(x, p)) ∧
    program_eval_also(pocket_add::program, Cons(x, RecInfo::enum_words(pocket_add::world.tys, 0, p))) = RecInfo::enum_rest(pocket_add::world.tys, 0, pocket_add(x, p)) {
    ⟨pocket_add::agrees(x, p), pocket_add::agrees_also(x, p)⟩
}

theorem pocket_add_runs(): program_eval_also(pocket_add::program, [BitVec::ofNat(2), BitVec::ofNat(1), BitVec::ofNat(5)]) = [BitVec::ofNat(7)] {
    pocket_add::agrees_also(BitVec::ofNat(2), Holds(BitVec::ofNat(5)))
}

// ---------------------------------------------------------------------------
// Calls in several words (docs/native/runtime-fn-setups-design.md §16.17):
// an enum with a payload passed as its tag word and its slots, and one
// read back from a callee in its words (`Call.also`), then matched.

// A constructor built and passed, twice, at two sites.
runtime fn pocket_n_of(x: u64) → u64 { pocket_n(Holds(x)) + pocket_n(Empty) }

theorem pocket_n_of_runs(): program_eval(pocket_n_of::program, 1, [BitVec::ofNat(7)]) = 7 { pocket_n_of::agrees(BitVec::ofNat(7)) }

theorem pocket_n_of_agrees(x: u64): program_eval(pocket_n_of::program, 1, [x]) = pocket_n_of(x) { pocket_n_of::agrees(x) }

// A parameter passed on as it came, its words to the callee's.
runtime fn pocket_n_passed(p: Pocket, x: u64) → u64 { pocket_n(p) + x }

theorem pocket_n_passed_agrees(p: Pocket, x: u64):
    program_eval(pocket_n_passed::program, 1, RecInfo::enum_words(pocket_n_passed::world.tys, 0, p) ++ [x]) = pocket_n_passed(p, x) {
    pocket_n_passed::agrees(p, x)
}

// An enum read back from a call, its slot in the second word, and matched.
runtime fn pocket_of(x: u64) → Pocket { if x < 10 { Empty } else { Holds(x) } }

runtime fn pocket_called(x: u64) → u64 { match pocket_of(x) { Empty => 1, Holds(n) => n } }

theorem pocket_called_runs(): program_eval(pocket_called::program, 1, [BitVec::ofNat(12)]) = 12 ∧
    program_eval(pocket_called::program, 1, [BitVec::ofNat(3)]) = 1 {
    ⟨pocket_called::agrees(BitVec::ofNat(12)), pocket_called::agrees(BitVec::ofNat(3))⟩
}

theorem pocket_called_agrees(x: u64): program_eval(pocket_called::program, 1, [x]) = pocket_called(x) { pocket_called::agrees(x) }

// Both ways through one callee: what one call returns is passed to the
// next, an enum's words in and out each time.
runtime fn pocket_twice(x: u64) → Pocket { pocket_add(x, pocket_add(x, pocket_of(x))) }

theorem pocket_twice_runs(): program_eval_also(pocket_twice::program, [BitVec::ofNat(12)]) = [BitVec::ofNat(36)] ∧
    program_eval_also(pocket_twice::program, [BitVec::ofNat(3)]) = [BitVec::ofNat(6)] {
    ⟨pocket_twice::agrees_also(BitVec::ofNat(12)), pocket_twice::agrees_also(BitVec::ofNat(3))⟩
}

// An enum of three words (two slots) returned by a callee: past the two
// words a C caller is handed, but read back whole by a Heather caller.
inductive Span2 { None2, Both(a: u64, b: u64) }

runtime fn span2_of(x: u64) → Span2 { if x < 1 { None2 } else { Both(x, x + 1) } }

theorem span2_of_also(): span2_of::code.also.len() = 2 { refl }

runtime fn span2_sum(x: u64) → u64 { match span2_of(x) { None2 => 0, Both(a, b) => a + b } }

theorem span2_sum_runs(): program_eval(span2_sum::program, 1, [BitVec::ofNat(4)]) = 9 ∧
    program_eval(span2_sum::program, 1, [BitVec::ofNat(0)]) = 0 {
    ⟨span2_sum::agrees(BitVec::ofNat(4)), span2_sum::agrees(BitVec::ofNat(0))⟩
}

theorem span2_sum_agrees(x: u64): program_eval(span2_sum::program, 1, [x]) = span2_sum(x) { span2_sum::agrees(x) }

// A three-slot enum passed to a callee from a caller that builds it.
runtime fn shape_of_rect(w: u64, h: u64) → u64 { shape_scaled(Rect(w, h), 2) + shape_scaled(Dot, w) }

theorem shape_of_rect_runs(): program_eval(shape_of_rect::program, 1, [BitVec::ofNat(3), BitVec::ofNat(4)]) = 27 {
    shape_of_rect::agrees(BitVec::ofNat(3), BitVec::ofNat(4))
}

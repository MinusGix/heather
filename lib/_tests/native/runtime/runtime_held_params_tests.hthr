// Probes for laid records in the machine's byte order and laid records
// that take parameters, as functions of them are compiled
// (docs/native/rung2-spans-design.md §3, docs/native/layout-design.md
// §11). Nothing here is proved by hand: each theorem restates or reads
// what the generator published. Nothing imports this module.
import runtime_data;

fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

// ---------------------------------------------------------------------------
// The machine's byte order, `laid`'s default

// Two words, little-endian: what a Rust `&mut [u64; 2]` is.
laid record Pair64 { lo: u64, hi: u64 }

runtime fn Pair64::swap(mut self p: Pair64) → u64 {
    let t = p.lo;
    p.lo := p.hi;
    p.hi := t;
    t
}

// The span `u64::to_le_bytes(0x0123456789abcdef) ++ to_le_bytes(2)`.
fn PAIR() → List<u8> { [b(0xef), b(0xcd), b(0xab), b(0x89), b(0x67), b(0x45), b(0x23), b(0x01), b(2), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] }

// A word read from it is the word Rust's slice holds at that place, and
// the swap stores each back low byte first.
theorem pair_swap_runs(): Pair64::swap::bytes(PAIR(), w(16)).value = w(0x0123456789abcdef) ∧
    Pair64::swap::bytes(PAIR(), w(16)).after = [b(2), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(0xef), b(0xcd), b(0xab), b(0x89), b(0x67), b(0x45), b(0x23), b(0x01)] {
    ⟨refl, refl⟩
}

// What it publishes, at every span that holds a pair.
theorem pair_swap_held(own: List<u8>, p: Pair64, length: u64, holds: rt_held::Stored::Holds(Pair64::stored(), own, length, p)):
    Pair64::swap(p).value = Pair64::swap::bytes(own, length).value {
    Pair64::swap::runs_held(own, p, length, holds).value
}

// ---------------------------------------------------------------------------
// A parameter that does not reach the layout is erased

// `k` refines nothing the bytes hold: a tag a caller keeps apart.
laid record Tagged(k: u64) { x: u64, y: u64 }

runtime fn Tagged::sum({k: u64}, mut self t: Tagged(k), d: u64) → u64 {
    t.x := t.x + d;
    t.x + t.y
}

// The code takes the span, its length word and `d`, and no `k`: the same
// code at every tag.
theorem tagged_sum_runs(): Tagged::sum::bytes([1, 0, 0, 0, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0], w(16), w(5)).value = w(8) { refl }

// What it publishes holds at every value of `k`, a neutral one included.
theorem tagged_sum_held(k: u64, own: List<u8>, t: Tagged(k), length, d: u64, holds: rt_held::Stored::Holds(Tagged::stored(k), own, length, t)):
    Tagged::sum(t, d, k := k).value = Tagged::sum::bytes(own, length, d).value ∧
    rt_held::Stored::Holds(Tagged::stored(k), Tagged::sum::bytes(own, length, d).after, length, Tagged::sum(t, d, k := k).after) {
    let ran = Tagged::sum::runs_held(k, own, t, length, d, holds);
    ⟨ran.value, ran.holds⟩
}

// And at a literal one.
theorem tagged_sum_at_seven(own: List<u8>, t: Tagged(BitVec::ofNat(7)), length, d: u64, holds: rt_held::Stored::Holds(Tagged::stored(BitVec::ofNat(7)), own, length, t)):
    Tagged::sum(t, d, k := BitVec::ofNat(7)).value = Tagged::sum::bytes(own, length, d).value {
    Tagged::sum::runs_held(BitVec::ofNat(7), own, t, length, d, holds).value
}

// The code takes the span, its length word and `d`, and no word for `k`.
fn tagged_code() → (List<u8> → u64 → u64 → Mutated<List<u8>, u64>) { Tagged::sum::bytes }

// A body that reads the erased parameter's value needs it as a word the
// code takes, which an erased parameter is not.
// expect-error: a local that is not runtime data
runtime fn Tagged::tag({k: u64}, self t: Tagged(k)) → u64 { k }

// Probes for laid records in the machine's byte order and laid records
// that take parameters, as functions of them are compiled
// (docs/native/rung2-spans-design.md §3, docs/native/layout-design.md
// §11). Nothing here is proved by hand: each theorem restates or reads
// what the generator published. Nothing imports this module.
import runtime_data;

fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

// ---------------------------------------------------------------------------
// The machine's byte order, `laid`'s default

// Two words, little-endian: what a Rust `&mut [u64; 2]` is.
laid record Pair64 { lo: u64, hi: u64 }

runtime fn Pair64::swap(mut self p: Pair64) → u64 {
    let t = p.lo;
    p.lo := p.hi;
    p.hi := t;
    t
}

// The span `u64::to_le_bytes(0x0123456789abcdef) ++ to_le_bytes(2)`.
fn PAIR() → List<u8> { [b(0xef), b(0xcd), b(0xab), b(0x89), b(0x67), b(0x45), b(0x23), b(0x01), b(2), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] }

// A word read from it is the word Rust's slice holds at that place, and
// the swap stores each back low byte first.
theorem pair_swap_runs(): Pair64::swap::bytes(PAIR(), w(16)).value = w(0x0123456789abcdef) ∧
    Pair64::swap::bytes(PAIR(), w(16)).after = [b(2), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(0xef), b(0xcd), b(0xab), b(0x89), b(0x67), b(0x45), b(0x23), b(0x01)] {
    ⟨refl, refl⟩
}

// What it publishes, at every span that holds a pair.
theorem pair_swap_held(own: List<u8>, p: Pair64, length: u64, holds: rt_held::Stored::Holds(Pair64::stored(), own, length, p)):
    Pair64::swap(p).value = Pair64::swap::bytes(own, length).value {
    Pair64::swap::runs_held(own, p, length, holds).value
}

// ---------------------------------------------------------------------------
// A parameter that does not reach the layout is erased

// `k` refines nothing the bytes hold: a tag a caller keeps apart.
laid record Tagged(k: u64) { x: u64, y: u64 }

runtime fn Tagged::sum({k: u64}, mut self t: Tagged(k), d: u64) → u64 {
    t.x := t.x + d;
    t.x + t.y
}

// The code takes the span, its length word and `d`, and no `k`: the same
// code at every tag.
theorem tagged_sum_runs(): Tagged::sum::bytes([1, 0, 0, 0, 0, 0, 0, 0, 2, 0, 0, 0, 0, 0, 0, 0], w(16), w(5)).value = w(8) { refl }

// What it publishes holds at every value of `k`, a neutral one included.
theorem tagged_sum_held(k: u64, own: List<u8>, t: Tagged(k), length, d: u64, holds: rt_held::Stored::Holds(Tagged::stored(k), own, length, t)):
    Tagged::sum(t, d, k := k).value = Tagged::sum::bytes(own, length, d).value ∧
    rt_held::Stored::Holds(Tagged::stored(k), Tagged::sum::bytes(own, length, d).after, length, Tagged::sum(t, d, k := k).after) {
    let ran = Tagged::sum::runs_held(k, own, t, length, d, holds);
    ⟨ran.value, ran.holds⟩
}

// And at a literal one.
theorem tagged_sum_at_seven(own: List<u8>, t: Tagged(BitVec::ofNat(7)), length, d: u64, holds: rt_held::Stored::Holds(Tagged::stored(BitVec::ofNat(7)), own, length, t)):
    Tagged::sum(t, d, k := BitVec::ofNat(7)).value = Tagged::sum::bytes(own, length, d).value {
    Tagged::sum::runs_held(BitVec::ofNat(7), own, t, length, d, holds).value
}

// The code takes the span, its length word and `d`, and no word for `k`.
fn tagged_code() → (List<u8> → u64 → u64 → Mutated<List<u8>, u64>) { Tagged::sum::bytes }

// A body that reads the erased parameter's value needs it as a word the
// code takes, which an erased parameter is not.
// expect-error: a local that is not runtime data
runtime fn Tagged::tag({k: u64}, self t: Tagged(k)) → u64 { k }

// ---------------------------------------------------------------------------
// A parameter that counts an array is carried

// Limbs of a number, as `numeral`'s are: as many as the word `n` says,
// the machine's order, what a Rust `&mut [u64]` of length `n` is.
laid record Limbs(n: u64) { w: [u64; n.toNat()] }

// One step of a borrow walking up the limbs (`Numeral::pred`): limb `i`
// less the borrow, and the borrow out. The index is inside by the test.
runtime fn Limbs::dec_at({n: u64}, mut self l: Limbs(n), i, borrow: u64) → u64 {
    if h: i < n {
        let old = l.w.at(i);
        l.w := l.w.put(i, old - borrow);
        if old < borrow { 1 } else { 0 }
    } else { borrow }
}

// The code takes the span, its length word, `n` and the operands.
fn dec_code() → (List<u8> → u64 → u64 → u64 → u64 → Mutated<List<u8>, u64>) { Limbs::dec_at::bytes }

// Two limbs, 0 and 5: the first borrows and passes the borrow on.
fn TWO_LIMBS() → List<u8> { [b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(5), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] }

theorem dec_two_runs(): Limbs::dec_at::bytes(TWO_LIMBS(), w(16), w(2), w(0), w(1)).value = w(1) ∧
    Limbs::dec_at::bytes(TWO_LIMBS(), w(16), w(2), w(0), w(1)).after =
        [b(0xff), b(0xff), b(0xff), b(0xff), b(0xff), b(0xff), b(0xff), b(0xff), b(5), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] {
    ⟨refl, refl⟩
}

// Three limbs: the third, 7, takes the borrow and stops it.
fn THREE_LIMBS() → List<u8> { TWO_LIMBS() ++ [b(7), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] }

theorem dec_three_runs(): Limbs::dec_at::bytes(THREE_LIMBS(), w(24), w(3), w(2), w(1)).value = w(0) ∧
    Limbs::dec_at::bytes(THREE_LIMBS(), w(24), w(3), w(2), w(1)).after = TWO_LIMBS() ++ [b(6), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] {
    ⟨refl, refl⟩
}

// Past the count the code stores nothing: limb 2 of two limbs is not
// there, though the span is long enough to hold it.
theorem dec_past_count_runs(): Limbs::dec_at::bytes(THREE_LIMBS(), w(24), w(2), w(2), w(1)).after = THREE_LIMBS() { refl }

// What it publishes, at every count: where the span holds `n` limbs, the
// code answers what the function answers and leaves the limbs it leaves.
theorem dec_held(n: u64, own: List<u8>, l: Limbs(n), length, i, borrow: u64, holds: rt_held::Stored::Holds(Limbs::stored(n), own, length, l)):
    Limbs::dec_at(l, i, borrow, n := n).value = Limbs::dec_at::bytes(own, length, n, i, borrow).value ∧
    rt_held::Stored::Holds(Limbs::stored(n), Limbs::dec_at::bytes(own, length, n, i, borrow).after, length, Limbs::dec_at(l, i, borrow, n := n).after) {
    let ran = Limbs::dec_at::runs_held(n, own, l, length, i, borrow, holds);
    ⟨ran.value, ran.holds⟩
}

// A limb read without a test bounding its index: no proof is found.
// expect-error: `at`'s `inside` was left to its default, which did not give
runtime fn Limbs::loose({n: u64}, mut self l: Limbs(n), i: u64) → u64 { l.w.at(i) }

// A test against another bound does not bound it either.
// expect-error: `put`'s `inside` was left to its default, which did not give
runtime fn Limbs::wrong({n: u64}, mut self l: Limbs(n), i, m: u64) → u64 {
    if h: i < m { l.w := l.w.put(i, 0); 1 } else { 0 }
}

// A header before the array: the count's word, and a field at a numeral.
laid record Vector(cap: u64) { len: u64, items: [u64; cap.toNat()] }

runtime fn Vector::push({cap: u64}, mut self v: Vector(cap), x: u64) → u64 {
    if h: v.len < cap {
        v.items := v.items.put(v.len, x);
        v.len := v.len + 1;
        1
    } else { 0 }
}

theorem vector_push_runs(): Vector::push::bytes([b(1), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(9), b(0), b(0), b(0), b(0), b(0), b(0), b(0),
        b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(0)], w(24), w(2), w(4)).after =
    [b(2), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(9), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(4), b(0), b(0), b(0), b(0), b(0), b(0), b(0)] { refl }

// Full: nothing stored.
theorem vector_push_full_runs(): Vector::push::bytes([b(1), b(0), b(0), b(0), b(0), b(0), b(0), b(0), b(9), b(0), b(0), b(0), b(0), b(0), b(0), b(0)], w(16), w(1), w(4)).value = w(0) { refl }

theorem vector_push_held(cap: u64, own: List<u8>, v: Vector(cap), length, x: u64, holds: rt_held::Stored::Holds(Vector::stored(cap), own, length, v)):
    Vector::push(v, x, cap := cap).value = Vector::push::bytes(own, length, cap, x).value {
    Vector::push::runs_held(cap, own, v, length, x, holds).value
}

// Probes of `runtime fn` on functions that write a span
// (lib/native/runtime/runtime.hthr's `runtime_span`;
// docs/native/native-one-compiler-design.md §2.6, U4 step 4c-3c): what the
// generator publishes for a store, for calls of functions that write, and
// for loops (with a callee that only reads, with one that writes, with a
// store as a statement, an exit inside, two calls of their own, a plain
// `if` test), each stated at every file, and what it refuses. Tests, not library: nothing imports this module.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import rt_file_reflect;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import function_ir_writes;
import function_ir_link;
import function_ir_placeless;
import function_ir_lower;
import function_ir_lower_calls;
import x86_64_asm;
import runtime;
import runtime_file;

fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

// ---------------------------------------------------------------------------
// A store

// `v`'s low byte at `i` under the length word, returning the index.
runtime fn List::poke(mut self span: List<BitVec(8)>, length, i, v: BitVec(64)) → BitVec(64) {
    span.put_within(length, i, v.truncate(8, 56));
    i
}

theorem poke_runs(): program_run(List::poke::program, [[b(97), b(98), b(99)], [b(7)]], 0, [w(4096), w(3), w(1), w(88)]) =
    Ending(w(1), [[b(97), b(88), b(99)], [b(7)]]) { refl }

// What the generator states, at every file: the word and the span are the
// method's.
theorem poke_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i, v: BitVec(64)):
    program_run(List::poke::program, Cons(span, rest), 0, [place, length, i, v]) =
        Ending(List::poke(span, length, i, v).value, Cons(List::poke(span, length, i, v).after, rest)) {
    List::poke::runs_over(span, rest, place, length, i, v)
}

// The reflection the group is built on is the one the reflector's probes
// pin (`rt_file_reflect_tests.hthr`).
theorem poke_reflection(): List::poke::rt = FFun([Word(64), Word(64), Word(64), Word(64)], Word(64),
    Let(Prim(Trunc(8, 56), [0]), Put(2, 3, 0, Pure(Var(2))))) { refl }

// ---------------------------------------------------------------------------
// Calls of a function that writes, and a read of what they left

runtime fn List::poke_pair(mut self span: List<BitVec(8)>, length, i, v: BitVec(64)) → BitVec(64) {
    let at = span.poke(length, i, v);
    span.poke(length, at.add(BitVec::ofNat(1)), v);
    span.byte_within(length, at).zero_extend(56)
}

// The program is `poke` and then `poke_pair`, which calls it twice.
theorem poke_pair_runs(): program_run(List::poke_pair::program, [[b(97), b(98), b(99)], [b(7)]], 1, [w(4096), w(3), w(1), w(88)]) =
    Ending(w(88), [[b(97), b(88), b(88)], [b(7)]]) { refl }

theorem poke_pair_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i, v: BitVec(64)):
    program_run(List::poke_pair::program, Cons(span, rest), 1, [place, length, i, v]) =
        FTm::end_of(rest, List::poke_pair(span, length, i, v)) {
    List::poke_pair::runs_over(span, rest, place, length, i, v)
}

theorem poke_pair_stills(): List::poke_pair::stills = [False, False] { refl }

// ---------------------------------------------------------------------------
// A loop, with a callee that only reads

runtime fn raise(x: BitVec(64)) → BitVec(64) {
    match x.sub(BitVec::ofNat(97)).unsigned_lt_bit(BitVec::ofNat(26)) { False => x, True => x.sub(BitVec::ofNat(32)) }
}

// Every byte from `i` raised, the index it stopped at returned.
runtime fn raise_from(span: List<BitVec(8)>, length, i: BitVec(64)) → Mutated<List<BitVec(8)>, BitVec(64)> decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => Mutated(span, i),
        True => raise_from(span.with_byte_within(length, i, raise(span.byte_within(length, i).zero_extend(56)).truncate(8, 56)), length,
            i.add(BitVec::ofNat(1))),
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
}

// `raise` is function 0 and the loop function 1: "a1c" becomes "A1C".
theorem raise_from_runs(): program_run(raise_from::program, [[b(97), b(49), b(99)], [b(7)]], 1, [w(4096), w(3), w(0)]) =
    Ending(w(3), [[b(65), b(49), b(67)], [b(7)]]) { refl }

theorem raise_from_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i: BitVec(64)):
    program_run(raise_from::program, Cons(span, rest), 1, [place, length, i]) = FTm::end_of(rest, raise_from(span, length, i)) {
    raise_from::runs_over(span, rest, place, length, i)
}

theorem raise_from_stills(): raise_from::stills = [False, True] { refl }

// The function compiler takes each program, the functions that write lent
// one buffer.
theorem programs_counted(): program_counts(raise_from::program) = [0, 1] ∧ program_counts(List::poke_pair::program) = [1, 1] { ⟨refl, refl⟩ }

theorem raise_from_accepted():
    lower_program_lent(raise_from::program, plan_program(raise_from::program), program_counts(raise_from::program)).is_some() = True { refl }

theorem poke_pair_accepted(): lower_program_lent(List::poke_pair::program, plan_program(List::poke_pair::program),
    program_counts(List::poke_pair::program)).is_some() = True { refl }

// ---------------------------------------------------------------------------
// A loop that calls a function that writes

// `v` at every index from `i`, by `poke`: the callee's span is the one the
// next pass takes.
runtime fn fill_from(span: List<BitVec(8)>, length, i, v: BitVec(64)) → Mutated<List<BitVec(8)>, BitVec(64)> decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => Mutated(span, i),
        True => fill_from(List::poke(span, length, i, v).after, length, i.add(BitVec::ofNat(1)), v),
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
}

theorem fill_from_runs(): program_run(fill_from::program, [[b(97), b(98), b(99)], [b(7)]], 1, [w(4096), w(3), w(1), w(45)]) =
    Ending(w(3), [[b(97), b(45), b(45)], [b(7)]]) { refl }

theorem fill_from_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i, v: BitVec(64)):
    program_run(fill_from::program, Cons(span, rest), 1, [place, length, i, v]) = FTm::end_of(rest, fill_from(span, length, i, v)) {
    fill_from::runs_over(span, rest, place, length, i, v)
}

// The same loop as a method of the span
// (issues/mut-self-tail-branch-receiver.md): the body ends in the branch,
// the store is a call on the receiver, and the loop's own call ends the
// arm, so nothing threads the span by hand and no `Mutated` is written. It
// is `fill_from` as a function, and its program is `fill_from`'s.
runtime fn List::fill_all(mut self span: List<BitVec(8)>, length, i, v: BitVec(64)) → BitVec(64) decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => i,
        True => {
            span.poke(length, i, v);
            span.fill_all(length, i.add(BitVec::ofNat(1)), v)
        },
    }
}

theorem fill_all_runs(): program_run(List::fill_all::program, [[b(97), b(98), b(99)], [b(7)]], 1, [w(4096), w(3), w(1), w(45)]) =
    Ending(w(3), [[b(97), b(45), b(45)], [b(7)]]) { refl }

theorem fill_all_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i, v: BitVec(64)):
    program_run(List::fill_all::program, Cons(span, rest), 1, [place, length, i, v]) = FTm::end_of(rest, List::fill_all(span, length, i, v)) {
    List::fill_all::runs_over(span, rest, place, length, i, v)
}

theorem fill_all_is_fill_from(): List::fill_all::program = fill_from::program { refl }

// ---------------------------------------------------------------------------
// A function that writes after a function that reads the span

runtime fn first_byte(span: List<BitVec(8)>, length: BitVec(64)) → BitVec(64) { span.byte_within(length, BitVec::ofNat(0)).zero_extend(56) }

// The first byte copied to `i`: the callee is lent the span the store then
// writes, and reads it before the store.
runtime fn List::copy_first(mut self span: List<BitVec(8)>, length, i: BitVec(64)) → BitVec(64) {
    span.put_within(length, i, first_byte(span, length).truncate(8, 56));
    i
}

theorem copy_first_runs(): program_run(List::copy_first::program, [[b(97), b(98), b(99)], [b(7)]], 1, [w(4096), w(3), w(2)]) =
    Ending(w(2), [[b(97), b(98), b(97)], [b(7)]]) { refl }

theorem copy_first_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i: BitVec(64)):
    program_run(List::copy_first::program, Cons(span, rest), 1, [place, length, i]) = FTm::end_of(rest, List::copy_first(span, length, i)) {
    List::copy_first::runs_over(span, rest, place, length, i)
}

// ---------------------------------------------------------------------------
// Loops written as a loop is written
//
// A `decreases` function's companions (`ext`, `irrel`, the unfold) follow a
// `mut self` call statement before the loop's own call and a branch under
// the loop's test, so each of these is a `runtime fn` as it stands
// (docs/language/recursion/decreases-unfolding-design.md). Before, the first had to make its
// store in its own call's argument and the others decide after the loop.

// A store as a statement before the loop's own call.
runtime fn clear_from(span: List<BitVec(8)>, length, i: BitVec(64)) → Mutated<List<BitVec(8)>, BitVec(64)> decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => Mutated(span, i),
        True => {
            let mut span = span;
            span.put_within(length, i, BitVec::ofNat(0));
            clear_from(span, length, i.add(BitVec::ofNat(1)))
        },
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
}

theorem clear_from_runs(): program_run(clear_from::program, [[b(97), b(98), b(99)], [b(7)]], 0, [w(4096), w(3), w(1)]) =
    Ending(w(3), [[b(97), b(0), b(0)], [b(7)]]) { refl }

theorem clear_from_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i: BitVec(64)):
    program_run(clear_from::program, Cons(span, rest), 0, [place, length, i]) = FTm::end_of(rest, clear_from(span, length, i)) {
    clear_from::runs_over(span, rest, place, length, i)
}

// An exit inside the loop: it stops at the first newline, which it leaves.
runtime fn clear_line(span: List<BitVec(8)>, length, i: BitVec(64)) → Mutated<List<BitVec(8)>, BitVec(64)> decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => Mutated(span, i),
        True => match span.byte_within(length, i).eq_bit(BitVec::ofNat(10)) {
            True => Mutated(span, i),
            False => clear_line(span.with_byte_within(length, i, BitVec::ofNat(0)), length, i.add(BitVec::ofNat(1))),
        },
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
}

theorem clear_line_runs(): program_run(clear_line::program, [[b(97), b(10), b(99)], [b(7)]], 0, [w(4096), w(3), w(0)]) =
    Ending(w(1), [[b(0), b(10), b(99)], [b(7)]]) { refl }

theorem clear_line_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i: BitVec(64)):
    program_run(clear_line::program, Cons(span, rest), 0, [place, length, i]) = FTm::end_of(rest, clear_line(span, length, i)) {
    clear_line::runs_over(span, rest, place, length, i)
}

// Two calls of its own under a branch: every byte but a newline cleared.
runtime fn clear_text(span: List<BitVec(8)>, length, i: BitVec(64)) → Mutated<List<BitVec(8)>, BitVec(64)> decreases length.sub(i).toNat() {
    match h: i.unsigned_lt_bit(length) {
        False => Mutated(span, i),
        True => match span.byte_within(length, i).eq_bit(BitVec::ofNat(10)) {
            True => clear_text(span, length, i.add(BitVec::ofNat(1))),
            False => clear_text(span.with_byte_within(length, i, BitVec::ofNat(0)), length, i.add(BitVec::ofNat(1))),
        },
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
    on ?dec2 := {
        let below = bitvec_omega::unsigned_true(64, i, length, h);
        bv_omega
    };
}

theorem clear_text_runs(): program_run(clear_text::program, [[b(97), b(10), b(99)], [b(7)]], 0, [w(4096), w(3), w(0)]) =
    Ending(w(3), [[b(0), b(10), b(0)], [b(7)]]) { refl }

theorem clear_text_stated(span: List<BitVec(8)>, rest: List<List<BitVec(8)>>, place, length, i: BitVec(64)):
    program_run(clear_text::program, Cons(span, rest), 0, [place, length, i]) = FTm::end_of(rest, clear_text(span, length, i)) {
    clear_text::runs_over(span, rest, place, length, i)
}

// A test that is a plain `if`, its evidence unnamed: the measure is
// discharged from the branch's test, and the companions the loop's instance
// is built from bind the test's equation as `if h:` does
// (issues/measured-span-loop-plain-if.md). The same program as the `if h:`
// spelling's.
runtime fn zero_from(ctx: List<u8>, cn, i: u64) → Mutated<List<u8>, u64> decreases (64 - i).toNat() {
    if i < 64 {
        let mut ctx = ctx;
        ctx.put_within(cn, i + 64, 0);
        zero_from(ctx, cn, i + 1)
    } else {
        Mutated(ctx, i)
    }
}

runtime fn zero_from_named(ctx: List<u8>, cn, i: u64) → Mutated<List<u8>, u64> decreases (64 - i).toNat() {
    if h: i < 64 {
        let mut ctx = ctx;
        ctx.put_within(cn, i + 64, 0);
        zero_from_named(ctx, cn, i + 1)
    } else {
        Mutated(ctx, i)
    }
}

theorem zero_from_stated(span: List<u8>, rest: List<List<u8>>, place, cn, i: u64):
    program_run(zero_from::program, Cons(span, rest), 0, [place, cn, i]) = FTm::end_of(rest, zero_from(span, cn, i)) {
    zero_from::runs_over(span, rest, place, cn, i)
}

theorem zero_from_as_named(): zero_from::program = zero_from_named::program { refl }

// The function compiler takes each.
theorem loops_accepted():
    (lower_program_lent(clear_from::program, plan_program(clear_from::program), program_counts(clear_from::program)).is_some() = True) ∧
    ((lower_program_lent(clear_line::program, plan_program(clear_line::program), program_counts(clear_line::program)).is_some() = True) ∧
     (lower_program_lent(clear_text::program, plan_program(clear_text::program), program_counts(clear_text::program)).is_some() = True)) {
    ⟨refl, ⟨refl, refl⟩⟩
}

// A byte read once, by a `let` before the inner test: insertion sort's inner
// loop (issues/runtime-mut-self-let-read-walk.md). The read is a claimed
// call on the receiver, which the companions follow as `f#body` binds it.
runtime fn List::insert_below(mut self s: List<u8>, n, j, x: u64) → u64 decreases j.toNat() {
    if h: 0 < j {
        let below = s.byte_within(n, j - 1);
        if larger: x < below.zero_extend(56) { s.put_within(n, j, below); s.insert_below(n, j - 1, x) }
        else { s.put_within(n, j, x.truncate(8, 56)); j }
    } else { s.put_within(n, j, x.truncate(8, 56)); j }
}

theorem insert_below_runs(): program_run(List::insert_below::program, [[b(1), b(5), b(7), b(0)], [b(7)]], 0, [w(4096), w(4), w(3), w(3)]) =
    Ending(w(1), [[b(1), b(3), b(5), b(7)], [b(7)]]) { refl }

// The inner test a plain `if` (issues/measured-loop-inner-if-companions.md),
// the read written where it is used…
runtime fn List::sift(mut self s: List<u8>, n, j, key: u64) → u64 decreases j.toNat() {
    if h: 0 < j {
        if key < s.byte_within(n, j - 1).zero_extend(56) {
            s.put_within(n, j, s.byte_within(n, j - 1)); s.sift(n, j - 1, key)
        } else { j }
    } else { j }
}

theorem sift_runs(): program_run(List::sift::program, [[b(1), b(5), b(7), b(3)], [b(7)]], 0, [w(4096), w(4), w(3), w(3)]) =
    Ending(w(1), [[b(1), b(5), b(5), b(7)], [b(7)]]) { refl }

// …and bound by a `let`, after one shadowing the measured index.
runtime fn List::sift_let(mut self s: List<u8>, n, j, key: u64) → u64 decreases j.toNat() {
    if h: 0 < j {
        let j = j - 1;
        let prev = s.byte_within(n, j);
        if key < prev.zero_extend(56) { s.put_within(n, j + 1, prev); s.sift_let(n, j, key) }
        else { j + 1 }
    } else { j }
}

theorem sift_let_runs(): program_run(List::sift_let::program, [[b(1), b(5), b(7), b(3)], [b(7)]], 0, [w(4096), w(4), w(3), w(3)]) =
    Ending(w(1), [[b(1), b(5), b(5), b(7)], [b(7)]]) { refl }

// ---------------------------------------------------------------------------
// What the generator refuses

// A callee that writes and is not a runtime fn.
fn List::poke_plain(mut self span: List<BitVec(8)>, length, i, v: BitVec(64)) → BitVec(64) {
    span.put_within(length, i, v.truncate(8, 56));
    i
}

// expect-error: `poke_plain` writes the span and is an ordinary fn: mark it `runtime fn`
runtime fn List::poke_through(mut self span: List<BitVec(8)>, length, i, v: BitVec(64)) → BitVec(64) { span.poke_plain(length, i, v) }

// A byte across the boundary: the code takes 64-bit words.
// expect-error: it takes and returns 64-bit words for now, beside its span
runtime fn List::poke_byte(mut self span: List<BitVec(8)>, length, i: BitVec(64), v: BitVec(8)) → BitVec(64) {
    span.put_within(length, i, v);
    i
}

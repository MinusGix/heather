// Probes of effectful `rt` (`rt_io`, `rt_io_reflect`;
// docs/language/effects-capabilities-design.md §8): a `mut self` method over `Io`, its
// computation written as `ETm`, checked against the reflector's output from
// the real elaborated body (`reflects_io_as`), and the pin `meaning = f` by
// `refl` at a neutral world and neutral operands, the equation a `runtime fn`
// publishes. Plus the meaning run at a scripted world, negative controls, and
// the refusals that are the capability's linearity check. Tests, not library: nothing outside
// lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic;
import nat;
import list;
import option;
import pair;
import bitvec;
import linux_calls;
import char;
import string;
import tactic;
import linux_world;
import rt;
import rt_io;
import rt_io_reflect;

// Read up to 64 bytes from stdin into the buffer, and write what came back
// to stdout: the write's result word.
fn Io::echo_once(mut self io: Io, buf: List<BitVec(8)>) → BitVec(64) {
    let r = io.read_into(Io::stdin(), buf, BitVec::ofNat(0), BitVec::ofNat(64));
    let w = io.write_from(Io::stdout(), r.buf, BitVec::ofNat(0), r.result);
    w
}

// Its computation. Variables, innermost first, are noted at each node.
fn echo_rt() → EFun {
    EFun([ByteList(0)], Word(64),
        // buf
        Let(Lit(Word(64), 0),
        // stdin, buf
        Let(Lit(Word(64), 0),
        // at, stdin, buf
        Let(Lit(Word(64), 64),
        // max, at, stdin, buf
        Invoke(Reads(0), [2, 3, 1, 0],
        // result, buf′, max, at, stdin, buf
        Let(Lit(Word(64), 1),
        // stdout, result, buf′, …
        Let(Lit(Word(64), 0),
        // zero, stdout, result, buf′, …
        Invoke(Writes(0), [1, 3, 0, 2],
        // written, …
        Pure(Var(0))))))))))
}

// The reflector reads it off the elaborated body: the world chain gives the
// call order, `Io::stdin()` is its literal, and `r.buf`, `r.result` are the
// read's `Invoke`-bound variables. (A buffer's capacity is the setup's to
// choose, so the reflection says 0.)
theorem echo_reflected(): True { by reflects_io_as(["Io::echo_once"], [], [], [echo_rt()]) }

// The pin: the computation means the method, world and all, at every world
// and buffer.
theorem echo_reflects(io: Io, buf: List<BitVec(8)>):
    echo_rt().meaning(ETm::plain_world(), [])(io)(buf) = Io::echo_once(io, buf) { refl }

// Run at a piped world: "hi" comes back out.
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn piped() → Io { Io::of(World::piped([[b(104), b(105)]])) }
fn zeros() → List<BitVec(8)> { List::replicate(BitVec::ofNat(0), 64) }

theorem echo_writes(): echo_rt().meaning(ETm::plain_world(), [])(piped())(zeros()).after.sent(Io::stdout()) = [b(104), b(105)] { refl }
theorem echo_result(): echo_rt().meaning(ETm::plain_world(), [])(piped())(zeros()).value = BitVec::ofNat(2) { refl }

// A computation whose write names the buffer before the read filled it is
// another program: the pin refuses it.
fn echo_stale_rt() → EFun {
    EFun([ByteList(64)], Word(64),
        Let(Lit(Word(64), 0), Let(Lit(Word(64), 0), Let(Lit(Word(64), 64), Invoke(Reads(0), [2, 3, 1, 0],
        Let(Lit(Word(64), 1), Let(Lit(Word(64), 0), Invoke(Writes(64), [1, 8, 0, 2], Pure(Var(0))))))))))
}
// expect-error(kernel): the kernel rejected `echo_stale_misreflects`: NotConvertible
theorem echo_stale_misreflects(io: Io, buf: List<BitVec(8)>):
    echo_stale_rt().meaning(ETm::plain_world(), [])(io)(buf) = Io::echo_once(io, buf) { refl }

// ---------------------------------------------------------------------------
// The reflector over more shapes.

// Open a path, read from it into the buffer, close it, and answer the read's
// result plus the close's: three calls, operands from earlier answers, and
// pure arithmetic over two answers at the end.
fn Io::read_file(mut self io: Io, path: List<BitVec(8)>, buf: List<BitVec(8)>) → BitVec(64) {
    let fd = io.open_path(path, BitVec::ofNat(16));
    let r = io.read_into(fd, buf, BitVec::ofNat(0), BitVec::ofNat(64));
    let c = io.close_fd(fd);
    r.result.add(c)
}

fn read_file_rt() → EFun {
    EFun([ByteList(0), ByteList(0)], Word(64),
        // buf, path
        Let(Lit(Word(64), 16),
        // sixteen, buf, path
        Invoke(Opens(0), [2, 0],
        // fd, …
        Let(Lit(Word(64), 0),
        // at, fd, sixteen, buf, path
        Let(Lit(Word(64), 64),
        // max, at, fd, sixteen, buf, path
        Invoke(Reads(0), [2, 4, 1, 0],
        // result, buf′, max, at, fd, …
        Invoke(Closes, [4],
        // closed, result, …
        Pure(Prim(Add(64), [1, 0])))))))))
}

theorem read_file_reflected(): True { by reflects_io_as(["Io::read_file"], [], [], [read_file_rt()]) }

theorem read_file_reflects(io: Io, path: List<BitVec(8)>, buf: List<BitVec(8)>):
    read_file_rt().meaning(ETm::plain_world(), [])(io)(path, buf) = Io::read_file(io, path, buf) { refl }

// A method that never calls: `Pure`, the world unchanged.
fn Io::no_call(mut self io: Io, n: BitVec(64)) → BitVec(64) { n.add(n) }

theorem no_call_reflected(): True {
    by reflects_io_as(["Io::no_call"], [], [], [EFun([Word(64)], Word(64), Pure(Prim(Add(64), [0, 0])))])
}

theorem no_call_reflects(io: Io, n: BitVec(64)):
    EFun([Word(64)], Word(64), Pure(Prim(Add(64), [0, 0]))).meaning(ETm::plain_world(), [])(io)(n) = Io::no_call(io, n) { refl }

// ---------------------------------------------------------------------------
// Statement `if`s (`ETm::If`, docs/native/io-programs-design.md §4.2): the
// locals an `if`'s arms assign, the world among them, are joined once
// (`#stage`), and the reflector reads each arm from the state before the
// `if` and each local after it as a new variable.

// A write in one arm: the world and `k` are joined.
fn Io::write_if(mut self io: Io, buf: List<BitVec(8)>, n: BitVec(64)) → BitVec(64) {
    let mut k = n;
    if BitVec::ofNat(0).unsigned_lt_bit(n) {
        let w = io.write_from(Io::stdout(), buf, BitVec::ofNat(0), n);
        k := w;
    }
    k
}

fn write_if_rt() → EFun {
    // n, buf; the test is one `Tm`, its lets inside it.
    EFun([ByteList(0), Word(64)], Word(64),
        If(Let(Lit(Word(64), 0), Prim(Ult(64), [0, 1])),
            Let(Lit(Word(64), 1), Let(Lit(Word(64), 0), Invoke(Writes(0), [1, 3, 0, 2], Pure(Lit(Word(64), 0))))),
            Pure(Lit(Word(64), 0)),
            // `k`: the write's answer, or `n`.
            [PWorld, PVar(Word(64), 0, 0)],
            Pure(Var(0))))
}

theorem write_if_reflected(): True { by reflects_io_as(["Io::write_if"], [], [], [write_if_rt()]) }

theorem write_if_reflects(io: Io, buf: List<BitVec(8)>, n: BitVec(64)):
    write_if_rt().meaning(ETm::plain_world(), [])(io)(buf, n) = Io::write_if(io, buf, n) { refl }

// Run at a literal test: two bytes written, and none when `n` is 0.
fn hi() → List<BitVec(8)> { [b(104), b(105)] }
theorem write_if_writes(): write_if_rt().meaning(ETm::plain_world(), [])(piped())(hi(), BitVec::ofNat(2)).after.sent(Io::stdout()) = hi() { refl }
theorem write_if_quiet(): write_if_rt().meaning(ETm::plain_world(), [])(piped())(hi(), BitVec::ofNat(0)).after.sent(Io::stdout()) = [] { refl }

// The negative control: the arms the other way round, which the reflector
// does not give, write nothing when `n` is 2.
fn write_if_swapped() → EFun {
    EFun([ByteList(0), Word(64)], Word(64),
        If(Let(Lit(Word(64), 0), Prim(Ult(64), [0, 1])),
            Pure(Lit(Word(64), 0)),
            Let(Lit(Word(64), 1), Let(Lit(Word(64), 0), Invoke(Writes(0), [1, 3, 0, 2], Pure(Lit(Word(64), 0))))),
            [PWorld, PVar(Word(64), 0, 0)],
            Pure(Var(0))))
}
theorem write_if_swapped_quiet(): write_if_swapped().meaning(ETm::plain_world(), [])(piped())(hi(), BitVec::ofNat(2)).after.sent(Io::stdout()) = [] { refl }

// A call in each arm, and one after the `if` on the world it joined,
// writing the local it joined.
fn Io::write_twice(mut self io: Io, buf: List<BitVec(8)>, n: BitVec(64)) → BitVec(64) {
    let mut k = n;
    if BitVec::ofNat(0).unsigned_lt_bit(n) {
        let w = io.write_from(Io::stdout(), buf, BitVec::ofNat(0), n);
        k := w;
    } else {
        let r = io.read_into(Io::stdin(), buf, BitVec::ofNat(0), n);
        k := r.result;
    }
    let w2 = io.write_from(Io::stdout(), buf, BitVec::ofNat(0), k);
    w2
}

fn write_twice_rt() → EFun {
    EFun([ByteList(0), Word(64)], Word(64),
        If(Let(Lit(Word(64), 0), Prim(Ult(64), [0, 1])),
            Let(Lit(Word(64), 1), Let(Lit(Word(64), 0), Invoke(Writes(0), [1, 3, 0, 2], Pure(Lit(Word(64), 0))))),
            Let(Lit(Word(64), 0), Let(Lit(Word(64), 0), Invoke(Reads(0), [1, 3, 0, 2], Pure(Lit(Word(64), 0))))),
            [PWorld, PVar(Word(64), 0, 0)],
            // k, n, buf
            Let(Lit(Word(64), 1), Let(Lit(Word(64), 0), Invoke(Writes(0), [1, 4, 0, 2], Pure(Var(0)))))))
}

theorem write_twice_reflected(): True { by reflects_io_as(["Io::write_twice"], [], [], [write_twice_rt()]) }

theorem write_twice_reflects(io: Io, buf: List<BitVec(8)>, n: BitVec(64)):
    write_twice_rt().meaning(ETm::plain_world(), [])(io)(buf, n) = Io::write_twice(io, buf, n) { refl }

// Two locals and no world: an `if` with no call, joined all the same.
fn Io::pick2(mut self io: Io, n: BitVec(64)) → BitVec(64) {
    let mut a = n;
    let mut c = n;
    if BitVec::ofNat(0).unsigned_lt_bit(n) { a := BitVec::ofNat(1); c := BitVec::ofNat(2); }
    a.add(c)
}

fn pick2_rt() → EFun {
    EFun([Word(64)], Word(64),
        If(Let(Lit(Word(64), 0), Prim(Ult(64), [0, 1])), Let(Lit(Word(64), 1), Let(Lit(Word(64), 2), Pure(Lit(Word(64), 0)))), Pure(Lit(Word(64), 0)),
            [PVar(Word(64), 1, 0), PVar(Word(64), 0, 0)],
            Pure(Prim(Add(64), [1, 0]))))
}

theorem pick2_reflected(): True { by reflects_io_as(["Io::pick2"], [], [], [pick2_rt()]) }

theorem pick2_reflects(io: Io, n: BitVec(64)): pick2_rt().meaning(ETm::plain_world(), [])(io)(n) = Io::pick2(io, n) { refl }

// ---------------------------------------------------------------------------
// Linearity: what the reflector refuses, at the call.

// A copy of the world: the second write runs on the world before the first,
// so the meaning forks the history. The answer read is of a call the chain
// does not go through.
fn Io::forked(mut self io: Io, buf: List<BitVec(8)>) → BitVec(64) {
    let mut old = io;
    let a = io.write_from(Io::stdout(), buf, BitVec::ofNat(0), BitVec::ofNat(1));
    let b = old.write_from(Io::stderr(), buf, BitVec::ofNat(0), BitVec::ofNat(1));
    a.add(b)
}

// expect-error: answers a call the body does not thread its world through
theorem forked_refused(): True { by reflects_io_as(["Io::forked"], [], [], []) }

// A call whose world after is dropped: its answer is read, but the next
// call does not take its world.
fn Io::dropped(mut self io: Io, buf: List<BitVec(8)>) → BitVec(64) {
    let p = Io::write_from(io, Io::stdout(), buf, BitVec::ofNat(0), BitVec::ofNat(1));
    let c = io.close_fd(Io::stdout());
    p.value.add(c)
}

// expect-error: answers a call the body does not thread its world through
theorem dropped_refused(): True { by reflects_io_as(["Io::dropped"], [], [], []) }

// The world read as data: whole, or a field of it.
fn Io::world_as_value(mut self io: Io) → Io { io }

// expect-error: the world `io` used as a value
theorem world_whole_refused(): True { by reflects_io_as(["Io::world_as_value"], [], [], []) }

fn Io::history(mut self io: Io) → List<Exchange> { io.past }

// expect-error: the world `io` used as a value
theorem history_refused(): True { by reflects_io_as(["Io::history"], [], [], []) }

// A call the reflector does not know: `Io::read` answers a `ReadResult`,
// which has no word-level code.
fn Io::read_some(mut self io: Io) → Nat {
    let r = io.read(Io::stdin(), 4);
    0
}

// expect-error: is not a call on Linux the reflector knows
theorem read_some_refused(): True { by reflects_io_as(["Io::read_some"], [], [], []) }

// Refusals of a `runtime fn` recursion and of a program calling one
// (docs/native/runtime-fn-recursion-design.md §2, §3), apart from
// runtime_recursion_tests, which `write-elf` compiles. Tests, not library:
// nothing outside lib/_tests imports this module.
import logic;
import nat;
import bitvec;
import bitvec_nat;
import rt;
import rt_ptm;
import rt_proc_program;
import runtime;

runtime fn rsum(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => n.add(rsum(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

runtime fn count_down(n, acc: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => acc,
        False => count_down(n.sub(BitVec::ofNat(1)), acc.add(n)),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

// Ten nested calls of `rsum` and main's own need eleven levels: ten,
// stated, are refused, saying so (the inferred levels are the least).
// expect-error: nest deeper than `levels := 10`
runtime(levels := 10) fn sum_ten_shallow() → u64 { rsum(BitVec::ofNat(10)) }

// A recursion lifts its callers to statements: a caller with words is not
// built yet, and is refused naming the recursion.
// expect-error: which calls itself, so it is a call between statements
runtime fn rsum_twice(n: u64) → u64 { rsum(n).add(rsum(n)) }

// A tail call is still a loop: `count_down` gets a `Compile` instance and
// no `f::ptm`.
// expect-error: `count_down` has no member `ptm`
fn count_down_ptm() → PTm { count_down::ptm }

// A recursion that calls another function is not yet a procedure: refused
// with the judgment's reason.
runtime fn plus_one(x: u64) → u64 { x.add(BitVec::ofNat(1)) }

// expect-error: a call of itself that is not the last thing it does
runtime fn rcall(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => plus_one(rcall(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

// A `depth` bound that does not drop at a call is refused at the call,
// naming the bound and how to discharge it by hand (design §3.3).
// expect-error: must decrease the `depth` bound
runtime fn rflat(n: u64) → u64 decreases n.toNat() depth 3 {
    if small: n < 1 { 0 } else { n + rflat(n - 1) }
}

// A stack budget bounds a program's recursion, so a program calling none
// is refused one.
// expect-error: a stack budget, `stack := b`, is stated of a program that calls a recursion
runtime(stack := 4096) fn plus_two() → u64 { plus_one(BitVec::ofNat(1)) }

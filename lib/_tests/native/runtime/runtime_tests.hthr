// Probes of `runtime fn` (lib/native/runtime/runtime.hthr): the generator
// reflects each function, judges it under the default setup, and publishes
// its reflection, the pin, its FunctionIR code, its `Compile` instance, and
// the program it runs in with that program's agreement with the function,
// with no proof written for any of them here. A function a runtime fn calls must be one too; a refusal names its
// reason and publishes nothing. Tests, not library: nothing imports this
// module.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import bitvec_nat;
import bitvec_rotate;
import algebra;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// ---------------------------------------------------------------------------
// Straight-line code and a call (examples/x86-native/calls.hthr).

runtime fn leaf(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    left.add(right).bxor(BitVec::ofNat(0x0123456789abcdef))
}

// `leaf` is found to be a runtime fn and becomes entry 1 of the table.
runtime fn caller(left: BitVec(64), right: BitVec(64)) → BitVec(64) { leaf(left, right).sub(left) }

// What the generator published, read back. The reflection is data, and the
// pin is a theorem about `caller` itself.
theorem caller_rt_is(): caller::rt =
    Fun([Word(64), Word(64)], Word(64), Let(Call(1, [1, 0]), Prim(Sub(64), [0, 2]))) { refl }

theorem caller_table(): caller::world.sigs = [Sig([Word(64), Word(64)], Word(64)), Sig([Word(64), Word(64)], Word(64))] { refl }

theorem caller_pinned(a, b: BitVec(64)): caller::rt.meaning(caller::world)(a, b) = caller(a, b) { caller::reflects(a, b) }

// The program: `leaf` (function 0, from its own instance) and `caller`
// (function 1, its call of entry 1 of its table renamed to function 0). It
// computes `caller`, assuming nothing.
theorem caller_program(): caller::program.len() = 2 { refl }

theorem caller_runs(a, b: BitVec(64)): program_eval(caller::program, 1, [a, b]) = caller(a, b) { caller::agrees(a, b) }

theorem leaf_runs(a, b: BitVec(64)): program_eval(leaf::program, 0, [a, b]) = leaf(a, b) { leaf::agrees(a, b) }

// The instance's own agreement is the composable one: the code answers
// `caller` wherever its table's functions are answered by their meanings.
theorem caller_compiled(call: Answers(), agree: Tm::CallsAgree(caller::world, call), a, b: BitVec(64)):
    caller::code.eval(call, [a, b]) = caller(a, b) { caller::compile.agrees(Nil, call, agree, a, trivial, b, trivial) }

// The instance is found by search, keyed on the function.
fn code_of<F>(f: F, c: Compile<F>(f) := infer) → Function { c.code }

theorem leaf_found(): code_of(leaf) = leaf::code { refl }

theorem caller_found(): code_of(caller) = caller::code { refl }

// The instance's agreement, read through the class at the function: at
// every file, the code run over it returns what the function does there.
theorem leaf_through_class(c: Compile<BitVec(64) → BitVec(64) → BitVec(64)>(leaf), b: Buffers(), call: Answers(),
    agree: Tm::CallsAgree(c.world.at(c.callees, b), call)):
    Ty::Answers(c.world.at(c.callees, b).tys, c.reflected.params, c.reflected.result,
        Ty::lent_at(c.world.at(c.callees, b).tys, c.reflected.lent, c.reflected.params, c.reflected.result, c.typed(b), leaf, b),
        λ xs => c.code.eval(call, xs, buffers := b)) {
    c.agrees(b, call, agree)
}

// A function lent nothing computes the same over any file: the file is
// there for the functions that read it.
theorem caller_compiled_over(b: Buffers(), call: Answers(), agree: Tm::CallsAgree(caller::world.at(caller::world.fixed(), b), call),
    x, y: BitVec(64)): caller::code.eval(call, [x, y], buffers := b) = caller(x, y) { caller::compile.agrees(b, call, agree, x, trivial, y, trivial) }

// ---------------------------------------------------------------------------
// Branches on comparisons through `&&`, `||` and `!`
// (examples/x86-native/branches.hthr), with no case split anywhere.

runtime fn choose(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) || (b.eq_bit(BitVec::ofNat(7)) && !a.signed_lt_bit(b)) {
        False => a.bxor(b),
        True => b.sub(a),
    }
}

theorem choose_runs(a, b: BitVec(64)): program_eval(choose::program, 0, [a, b]) = choose(a, b) { choose::agrees(a, b) }

// ---------------------------------------------------------------------------
// Shared values and two calls of one callee (examples/x86-native/sharing.hthr).

runtime fn sleaf(left: BitVec(64), right: BitVec(64)) → BitVec(64) { left.sub(right) }

runtime fn scaller(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    let saved = left.bor(right);
    let first = sleaf(right, left);
    let second = sleaf(left, right);
    let shared = first.add(saved);
    shared.add(shared).add(first.add(first.add(second)))
}

// One table entry for `sleaf`, however often it is called, and one function
// of the program.
theorem scaller_table(): scaller::world.sigs.len() = 2 { refl }

theorem scaller_runs(a, b: BitVec(64)): program_eval(scaller::program, 1, [a, b]) = scaller(a, b) { scaller::agrees(a, b) }

// ---------------------------------------------------------------------------
// Three levels, a callee reached twice (examples/x86-native/levels.hthr):
// the program places each function once, callees first, and each
// function's table is renamed into it.

runtime fn twist(a, b: BitVec(64)) → BitVec(64) { a.sub(b).bxor(b) }

runtime fn middle(a, b: BitVec(64)) → BitVec(64) {
    match a.unsigned_lt_bit(b) {
        False => twist(b, a),
        True => twist(a, b).add(a),
    }
}

runtime fn top(a, b: BitVec(64)) → BitVec(64) {
    let m = middle(b, a);
    middle(m, a.add(b)).bor(twist(a, m))
}

// `top`'s table is itself, `middle`, `twist`; the program is `twist`,
// `middle`, `top`.
theorem top_table(): top::world.sigs.len() = 3 { refl }

theorem top_program(): top::program.len() = 3 { refl }

theorem top_runs(a, b: BitVec(64)): program_eval(top::program, 2, [a, b]) = top(a, b) { top::agrees(a, b) }

// The renaming is the whole of linking: a code evaluated with its calls
// renamed is the code with each call answered at the new name.
theorem relabel_is_answering(c: Function, call: Answers(), xs: List<BitVec(64)>):
    c.relabel(link_at([2, 0, 1])).eval(call, xs) = c.eval(Answers::relabel(call, link_at([2, 0, 1])), xs) {
    c.relabel_eval(call, link_at([2, 0, 1]), xs)
}

// ---------------------------------------------------------------------------
// A `match h:` convoy: the equation is erased, and the pin still converts.

runtime fn safe_pred(n: BitVec(64)) → BitVec(64) {
    match h: n.eq_bit(BitVec::ofNat(0)) { True => n, False => n.sub(BitVec::ofNat(1)) }
}

theorem safe_pred_runs(n: BitVec(64)): program_eval(safe_pred::program, 0, [n]) = safe_pred(n) { safe_pred::agrees(n) }

// ---------------------------------------------------------------------------
// Widths and shifts: `truncate` and `zero_extend` (one `Resize` node each)
// and shifts by a literal, `<<` among them, reflected and compiled through
// the instance with nothing proved here.

runtime fn spread(x: BitVec(64)) → BitVec(64) {
    x.truncate(8, 56).zero_extend(56).add(x << 3).bxor(x.arithmetic_shift_right(60)).bor(x.shift_right(7))
}

theorem spread_rt_is(): spread::rt = Fun([Word(64)], Word(64),
    Let(Prim(Trunc(8, 56), [0]), Let(Prim(Zext(8, 56), [0]), Let(Prim(Shl(64, 3), [2]), Let(Prim(Add(64), [1, 0]),
        Let(Prim(Ashr(64, 60), [4]), Let(Prim(Bxor(64), [1, 0]), Let(Prim(Lshr(64, 7), [6]), Prim(Bor(64), [1, 0]))))))))) { refl }

theorem spread_runs(x: BitVec(64)): program_eval(spread::program, 0, [x]) = spread(x) { spread::agrees(x) }

// ---------------------------------------------------------------------------
// Complement and rotations, which `rt` has no operation for: the generator
// reads `~x` as `all_ones ⊕ x` and `x.rotr(k)`/`x.rotl(k)` as their shift
// pairs (issues/rt-complement-and-rotate.md), and the pin holds because
// each converts to its rewriting at a literal width.

runtime fn flip(x: u64) → u64 { ~x }

theorem flip_rt_is(): flip::rt =
    Fun([Word(64)], Word(64), Let(Lit(Word(64), 0xffffffffffffffff), Prim(Bxor(64), [0, 1]))) { refl }

theorem flip_runs(x: u64): program_eval(flip::program, 0, [x]) = ~x { flip::agrees(x) }

// At a narrower width the literal is that width's all ones.
runtime fn flip_low(x: u64) → u64 { (~x.truncate(32, 32)).zero_extend(32) }

theorem flip_low_rt_is(): flip_low::rt = Fun([Word(64)], Word(64),
    Let(Prim(Trunc(32, 32), [0]), Let(Lit(Word(32), 0xffffffff), Let(Prim(Bxor(32), [0, 1]), Prim(Zext(32, 32), [0]))))) { refl }

theorem flip_low_runs(x: u64): program_eval(flip_low::program, 0, [x]) = flip_low(x) { flip_low::agrees(x) }

// A rotation right and one left by the other count are the same two shifts,
// bound once, joined each way.
runtime fn spin(x: u64) → u64 { x.rotr(8) ⊕ x.rotl(56) }

theorem spin_rt_is(): spin::rt = Fun([Word(64)], Word(64),
    Let(Prim(Lshr(64, 8), [0]), Let(Prim(Shl(64, 56), [1]), Let(Prim(Bor(64), [1, 0]),
        Let(Prim(Bor(64), [1, 2]), Prim(Bxor(64), [1, 0])))))) { refl }

theorem spin_runs(x: u64): program_eval(spin::program, 0, [x]) = x.rotr(8) ⊕ x.rotl(56) { spin::agrees(x) }

// A narrow rotation, and complement inside an expression.
runtime fn spin_low(x, y: u64) → u64 {
    let a = x.truncate(32, 32);
    let b = y.truncate(32, 32);
    (a.rotr(7) + (~a & b).rotl(3)).zero_extend(32)
}

theorem spin_low_runs(x, y: u64): program_eval(spin_low::program, 0, [x, y]) = spin_low(x, y) { spin_low::agrees(x, y) }

// ---------------------------------------------------------------------------
// A fourteen-arm callee and its caller (issues/runtime-fn-caller-agreement-fuel.md):
// a lexer's byte classifier. Linking needs only that each function's calls
// fit, which its instance carries (`Compile`'s `fits`);
// `program_evaluable`'s disjointness is quadratic in a function's size, and
// for `byte_class` alone it runs past the kernel's per-declaration fuel, so
// neither function could be compiled while `f::agrees` re-checked it for
// every function of the program.

runtime fn byte_class(b: BitVec(64)) → BitVec(64) {
    match b.eq_bit(BitVec::ofNat(10)) {
        True => BitVec::ofNat(6),
        False => match b.eq_bit(BitVec::ofNat(32)) {
            True => BitVec::ofNat(0),
            False => match b.sub(BitVec::ofNat(97)).unsigned_lt_bit(BitVec::ofNat(26)) {
                True => BitVec::ofNat(1),
                False => match b.sub(BitVec::ofNat(65)).unsigned_lt_bit(BitVec::ofNat(26)) {
                    True => BitVec::ofNat(1),
                    False => match b.eq_bit(BitVec::ofNat(95)) {
                        True => BitVec::ofNat(1),
                        False => match b.sub(BitVec::ofNat(48)).unsigned_lt_bit(BitVec::ofNat(10)) {
                            True => BitVec::ofNat(2),
                            False => match b.eq_bit(BitVec::ofNat(47)) {
                                True => BitVec::ofNat(3),
                                False => match b.eq_bit(BitVec::ofNat(45)) {
                                    True => BitVec::ofNat(4),
                                    False => match b.eq_bit(BitVec::ofNat(62)) {
                                        True => BitVec::ofNat(5),
                                        False => match b.eq_bit(BitVec::ofNat(9)) {
                                            True => BitVec::ofNat(0),
                                            False => match b.eq_bit(BitVec::ofNat(34)) {
                                                True => BitVec::ofNat(8),
                                                False => match b.eq_bit(BitVec::ofNat(39)) {
                                                    True => BitVec::ofNat(8),
                                                    False => match b.eq_bit(BitVec::ofNat(40)) {
                                                        True => BitVec::ofNat(9),
                                                        False => match b.eq_bit(BitVec::ofNat(41)) {
                                                            True => BitVec::ofNat(10),
                                                            False => BitVec::ofNat(7),
                                                        },
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    }
}

// Two bytes' classes at once: the callee linked twice into one call site's
// program, its agreement unconditional.
runtime fn byte_class_pair(a, b: BitVec(64)) → BitVec(64) { byte_class(a).add(byte_class(b) << 8) }

theorem byte_class_pair_runs(a, b: BitVec(64)): program_eval(byte_class_pair::program, 1, [a, b]) = byte_class_pair(a, b) {
    byte_class_pair::agrees(a, b)
}

// The whole program evaluable, the disjointness the x86 certificate needs:
// `program_scan_at` checks it in one pass, against the arities the program
// publishes, where `program_evaluable` itself runs past the fuel
// (issues/function-ir-evaluable-quadratic.md).
theorem byte_class_pair_evaluable(): program_evaluable(byte_class_pair::program).IsTrue() {
    program_scan_at_evaluable(byte_class_pair::program, byte_class_pair::arities, trivial)
}

// The arities are the functions' parameter counts, the last function's
// first, and a table that gets one wrong is refused: the scan holds each
// function to its own entry, which is what lets a caller's statement read
// the table and not its callees.
theorem byte_class_pair_arities(): byte_class_pair::arities = [2, 1] { refl }
theorem byte_class_pair_wrong_callee(): program_scan_at(byte_class_pair::program, [2, 2]) = False { refl }
theorem byte_class_pair_wrong_own(): program_scan_at(byte_class_pair::program, [1, 1]) = False { refl }
theorem byte_class_pair_short_table(): program_scan_at(byte_class_pair::program, [2]) = False { refl }

// A program of nine functions: eight callees under one caller, the widest
// program checked here. The linked program's sources and its code are each
// written once in the generator's reply and referred to from every part, so
// the reply grows with the functions and not with their square; when they
// were spelled out at each mention, a caller of eight was past what the
// host read (issues/runtime-generator-program-size.md).
runtime fn eighth_0(a: u64) → u64 { a.add(1) }
runtime fn eighth_1(a: u64) → u64 { a.add(2) }
runtime fn eighth_2(a: u64) → u64 { a.add(3) }
runtime fn eighth_3(a: u64) → u64 { a.add(4) }
runtime fn eighth_4(a: u64) → u64 { a.add(5) }
runtime fn eighth_5(a: u64) → u64 { a.add(6) }
runtime fn eighth_6(a: u64) → u64 { a.add(7) }
runtime fn eighth_7(a: u64) → u64 { a.add(8) }

runtime fn eighths(which, a: u64) → u64 {
    if which.eq_bit(0) { eighth_0(a) }
    else if which.eq_bit(1) { eighth_1(a) }
    else if which.eq_bit(2) { eighth_2(a) }
    else if which.eq_bit(3) { eighth_3(a) }
    else if which.eq_bit(4) { eighth_4(a) }
    else if which.eq_bit(5) { eighth_5(a) }
    else if which.eq_bit(6) { eighth_6(a) }
    else { eighth_7(a) }
}

// The caller is the program's last function, the ninth.
theorem eighths_runs(which, a: u64): program_eval(eighths::program, 8, [which, a]) = eighths(which, a) {
    eighths::agrees(which, a)
}

// ---------------------------------------------------------------------------
// Refusals. Each names its reason, and the function under the prefix is not
// published either (the item is one transaction).

fn helper(a: BitVec(64)) → BitVec(64) { a.add(a) }

// expect-error: `helper` is an ordinary fn: mark it `runtime fn`
runtime fn uses_helper(a: BitVec(64)) → BitVec(64) { helper(a).sub(a) }

// expect-error: unbound name `uses_helper`
theorem uses_helper_unpublished(a: BitVec(64)): uses_helper(a) = a { refl }

// expect-error: a result that is not a word of at most 64 bits
runtime fn is_small(a: BitVec(64)) → Bool { a.unsigned_lt_bit(BitVec::ofNat(8)) }

// A byte list is a lent span only where a span may stand: before the other
// parameters, followed by its length word
// (lib/_tests/native/runtime/runtime_lent_tests.hthr).
// expect-error: a byte list parameter that is not a lent span
runtime fn sum_bytes(start: BitVec(64), xs: List<BitVec(8)>) → BitVec(64) { start }

// A rotation's count is a literal, as a shift's is.
// expect-error: expected a numeral
runtime fn spin_by(x, c: u64) → u64 { x.rotr(c.toNat()) }

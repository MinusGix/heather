// Probes of `arena_handles.hthr`: the window laws together at an open heap,
// and the stale window of `arena_laws_tests.hthr` restated over handles,
// where it is a refused obligation and not only a pair of windows that
// meet.
import logic;
import bool;
import nat;
import list;
import option;
import vector;
import algebra;
import omega;
import runtime_data;
import arena;
import arena_laws;
import store;
import arena_handles;

// ---------------------------------------------------------------------------
// At an open heap: a window granted takes a store that no read through an
// older valid window sees. No `Apart` premise: the two keys differ
// (`alloc_other_key`), and validity gives the rest.
theorem fresh_store_unseen(h: Heap, size, i, x, k: u64, w, w2: Window, granted: Heap::alloc(h, size).value = Granted(w), valid2: h.Valid(w2),
    li: i.toNat() < w.count.toNat(), lk: k.toNat() < w2.count.toNat()):
    Heap::store(Heap::alloc(h, size).after, w, i, x, valid := Heap::alloc_valid(h, size, w, granted)).after.read(w2, k, valid := Heap::alloc_keeps(h, size, w2, valid2)) =
        h.read(w2, k, valid := valid2)
{
    let after = Heap::alloc(h, size).after;
    trans(after.store_apart(w, i, x, w2, k, Heap::alloc_valid(h, size, w, granted), Heap::alloc_keeps(h, size, w2, valid2), li, lk,
            λ e => Heap::alloc_other_key(h, size, w, granted, w2, valid2, sym(e))),
        Heap::alloc_reads_kept(h, size, w2, k, valid2, lk))
}

// A window below the mark survives a reset and reads what it read; one
// above it is ended.
theorem reset_splits(h: Heap, mark, k: u64, low, high: Window, vlow: h.Valid(low), under: low.base.toNat() + low.count.toNat() <= mark.toNat(),
    above: mark.toNat() < high.base.toNat() + high.count.toNat(), lk: k.toNat() < low.count.toNat()):
    And<Heap::reset(h, mark).after.read(low, k, valid := Heap::reset_keeps(h, mark, low, vlow, under)) = h.read(low, k, valid := vlow),
        ¬Heap::reset(h, mark).after.Valid(high)>
{
    And(Heap::reset_reads_kept(h, mark, low, k, vlow, under, lk), Heap::reset_ends(h, mark, high, above))
}

// A proof of validity in scope is what `known` finds.
fn read_known(h: Heap, w: Window, valid: h.Valid(w)) → u64 { if inside: 0 < w.count { h.read(w, 0) } else { 0 } }

// ---------------------------------------------------------------------------
// The stale window. `(0, 4)` granted, the heap reset to 0, `(0, 4)` granted
// again into the same claim slot at the next generation.

fn EMPTY_ARENA() → Arena { Arena(BitVec::ofNat(0), BitVec::ofNat(16), List::replicate(BitVec::ofNat(0, n := 64), 16).vector_of(16, BitVec::ofNat(0))) }

theorem empty_inv(): HeapInv(EMPTY_ARENA(), Store::empty()) {
    HeapInv(omega, omega, λ _ _ e => absurd(e), λ _ _ _ _ e1 _ _ => absurd(e1))
}

fn EMPTY() → Heap { Heap(EMPTY_ARENA(), Erased(Store::empty()), empty_inv()) }

fn NO_WINDOW() → Window { Window(0, 0, Erased(Key(0, 0))) }

fn FIRST() → Mutated<Heap, Grant> { Heap::alloc(EMPTY(), 4) }

fn W1() → Window { FIRST().value.window_or(NO_WINDOW()) }

fn SECOND() → Mutated<Heap, Grant> { Heap::alloc(Heap::reset(FIRST().after, 0).after, 4) }

fn W2() → Window { SECOND().value.window_or(NO_WINDOW()) }

// Both are `(0, 4)`; the keys name one slot at two generations.
theorem both_granted(): (W1() = Window(0, 4, Erased(Key(0, 0)))) ∧ (W2() = Window(0, 4, Erased(Key(0, 1)))) { ⟨refl, refl⟩ }

// They meet, as `arena_laws_tests.hthr`'s `stale_windows_meet` says of the
// words alone.
theorem stale_windows_meet(): ¬Arena::Apart(W1().base.toNat(), W1().count.toNat(), W2().base.toNat(), W2().count.toNat()) {
    let b1: (W1().base.toNat() = 0) = refl;
    let b2: (W2().base.toNat() = 0) = refl;
    let c1: (W1().count.toNat() = 4) = refl;
    let c2: (W2().count.toNat() = 4) = refl;
    λ apart => match apart { Inl(p) => omega(p, b1, b2, c1, c2), Inr(p) => omega(p, b1, b2, c1, c2) }
}

// The new window is valid; the stale one has no proof of validity.
theorem fresh_window_valid(): SECOND().after.Valid(W2()) { refl }

theorem stale_window_invalid(): ¬SECOND().after.Valid(W1()) { λ valid => absurd(valid) }

// The reset is what ended it, by the law at an open heap.
theorem stale_by_law(): ¬Heap::reset(FIRST().after, 0).after.Valid(W1()) {
    let end: (W1().base.toNat() + W1().count.toNat() = 4) = refl;
    Heap::reset_ends(FIRST().after, 0, W1(), omega(end))
}

// The read through the fresh window, its validity given.
theorem one_inside(): BitVec::ofNat(1, n := 64).toNat() < W2().count.toNat() { let c: (W2().count.toNat() = 4) = refl; omega(c) }

theorem fresh_reads(): SECOND().after.read(W2(), 1, valid := fresh_window_valid(), inside := squash(one_inside())) = 0 { refl }

// The read through the stale window, its validity left to `known`: refused,
// the obligation named. This is the stale window as a refused obligation.
// expect-error: `read`'s `valid` was left to its default, which did not give `arena_handles::Heap::Valid((SECOND).after, W1)` here
fn stale_read() → u64 { SECOND().after.read(W1(), 1) }

// And a store through it, the same.
// expect-error: `store`'s `valid` was left to its default
fn stale_store() → Mutated<Heap, u64> { Heap::store(SECOND().after, W1(), 1, 5) }

// ---------------------------------------------------------------------------
// A vector at closed values: a window `X` of one word, then a header of
// three and a data window of two, `X` holding 9 and the vector `[7]`; the
// vector grown into a data window of four at the top.

fn A1() → Mutated<Heap, Grant> { Heap::alloc(EMPTY(), 1) }

fn X() → Window { A1().value.window_or(NO_WINDOW()) }

fn A2() → Mutated<Heap, Grant> { Heap::alloc(A1().after, 3) }

fn HW() → Window { A2().value.window_or(NO_WINDOW()) }

fn A3() → Mutated<Heap, Grant> { Heap::alloc(A2().after, 2) }

fn DW() → Window { A3().value.window_or(NO_WINDOW()) }

theorem windows_granted(): (X() = Window(0, 1, Erased(Key(0, 0)))) ∧ ((HW() = Window(1, 3, Erased(Key(1, 0)))) ∧ (DW() = Window(4, 2, Erased(Key(2, 0))))) { ⟨refl, ⟨refl, refl⟩⟩ }

theorem x0_in(): BitVec::ofNat(0, n := 64).toNat() < X().count.toNat() { let c: (X().count.toNat() = 1) = refl; omega(c) }

theorem h_in(i: u64, small: i.toNat() < 3): i.toNat() < HW().count.toNat() { let c: (HW().count.toNat() = 3) = refl; omega(c, small) }

theorem d0_in(): BitVec::ofNat(0, n := 64).toNat() < DW().count.toNat() { let c: (DW().count.toNat() = 2) = refl; omega(c) }

fn H0() → Heap {
    let h1 = Heap::store(A3().after, X(), 0, 9, valid := refl, inside := squash(x0_in())).after;
    let h2 = Heap::store(h1, HW(), 0, 4, valid := refl, inside := squash(h_in(0, omega))).after;
    let h3 = Heap::store(h2, HW(), 1, 2, valid := refl, inside := squash(h_in(1, omega))).after;
    let h4 = Heap::store(h3, HW(), 2, 1, valid := refl, inside := squash(h_in(2, omega))).after;
    Heap::store(h4, DW(), 0, 7, valid := refl, inside := squash(d0_in())).after
}

theorem apart_keys(): ¬(HW().key.value.index = DW().key.value.index) { let a: (HW().key.value.index = 1) = refl; let b: (DW().key.value.index = 2) = refl; λ e => omega(e, a, b) }

theorem x_not_header(): ¬(X().key.value.index = HW().key.value.index) { let a: (X().key.value.index = 0) = refl; let b: (HW().key.value.index = 1) = refl; λ e => omega(e, a, b) }

theorem x_not_data(): ¬(X().key.value.index = DW().key.value.index) { let a: (X().key.value.index = 0) = refl; let b: (DW().key.value.index = 2) = refl; λ e => omega(e, a, b) }

fn V0() → VecHandle { VecHandle(HW(), DW()) }

theorem v0_ok(): VecOk(H0(), V0()) {
    let l: (H0().arena.cell(HW().base + 2).toNat() = 1) = refl;
    let c: (DW().count.toNat() = 2) = refl;
    VecOk(refl, refl, refl, apart_keys(), refl, refl, omega(l, c))
}

theorem v0_items(): H0().items(V0()) = [7] { refl }

fn G() → Mutated<Heap, VecHandle> { Heap::grow(H0(), V0(), v0_ok()) }

// The new data window is four words at the old top, under a key of its own.
theorem grown_handle(): G().value = VecHandle(HW(), Window(6, 4, Erased(Key(3, 0)))) { refl }

theorem grown_items(): G().after.items(G().value) = [7] { refl }

// The window `X` still reads 9, by evaluation and by the law.
theorem x_kept(): G().after.read(X(), 0, valid := refl, inside := squash(x0_in())) = 9 { refl }

theorem x_kept_by_law(): G().after.read(X(), 0, valid := H0().grow_keeps(V0(), v0_ok(), X(), refl, x_not_data()), inside := squash(x0_in())) =
    H0().read(X(), 0, valid := refl, inside := squash(x0_in()))
{
    H0().grow_reads_kept(V0(), v0_ok(), X(), 0, refl, x0_in(), x_not_header(), x_not_data())
}

// The old data window was released: it has no proof of validity, and a
// read through it is refused.
theorem old_data_invalid(): ¬G().after.Valid(DW()) { let none: (G().after.claims.value.get(DW().key.value) = None) = refl; λ valid => absurd(trans(sym(none), valid)) }

// expect-error: `read`'s `valid` was left to its default, which did not give `arena_handles::Heap::Valid((G).after, DW)` here
fn old_data_read() → u64 { G().after.read(DW(), 0, inside := squash(d0_in())) }

// ---------------------------------------------------------------------------
// Compiled (issues/runtime-record-erased-fields.md): `read`, `store` and
// `reset` are `runtime fn`s of the heap, whose code is over the arena's
// words alone. A window is its two words to the code; its key, the claims,
// the invariant and the proofs leave nothing (the read takes the span, its
// length word, the window's base and count, and the index).

fn heap_read_code() → (List<u8> → u64 → u64 → u64 → u64 → Mutated<List<u8>, u64>) { Heap::read::bytes }

fn heap_store_code() → (List<u8> → u64 → u64 → u64 → u64 → u64 → Mutated<List<u8>, u64>) { Heap::store::bytes }

fn heap_reset_code() → (List<u8> → u64 → u64 → Mutated<List<u8>, u64>) { Heap::reset::bytes }

// An arena of limit 16 with a window of four at 0, its element 2 set to 7.
fn HEAP_BYTES() → List<u8> {
    let empty: List<u8> = [0, 0, 0, 0, 0, 0, 0, 0, 16, 0, 0, 0, 0, 0, 0, 0] ++ List::replicate(BitVec::ofNat(0), 128);
    Arena::store::bytes(Arena::alloc::bytes(empty, 144, 4).after, 144, 0, 4, 2, 7).after
}

// At literal words the code computes: the read, the store answering the
// element it replaced and leaving the new one, and the reset to 0.
theorem heap_code_runs(): Heap::read::bytes(HEAP_BYTES(), 144, 0, 4, 2).value = 7 ∧
    (Heap::store::bytes(HEAP_BYTES(), 144, 0, 4, 2, 9).value = 7 ∧
    (Heap::read::bytes(Heap::store::bytes(HEAP_BYTES(), 144, 0, 4, 2, 9).after, 144, 0, 4, 2).value = 9 ∧
    Heap::reset::bytes(HEAP_BYTES(), 144, 0).value = 1)) {
    ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩
}

// What is published, at an open heap, window and proofs: the heap whole
// (its claims and invariant any at all) beside a span that holds its arena.
theorem heap_read_held(own: List<u8>, h: Heap, length: u64, w: Window, i: u64, valid: h.Valid(w), inside: ∥i.toNat() < w.count.toNat()∥,
    holds: rt_held::Stored::Holds(Arena::stored(), own, length, h.arena)):
    h.read(w, i, valid := valid, inside := inside) = Heap::read::bytes(own, length, w.base, w.count, i).value {
    Heap::read::runs_held(own, h, length, w, i, valid, inside, holds).value
}

theorem heap_store_held(own: List<u8>, h: Heap, length: u64, w: Window, i, x: u64, valid: h.Valid(w), inside: ∥i.toNat() < w.count.toNat()∥,
    holds: rt_held::Stored::Holds(Arena::stored(), own, length, h.arena)):
    Heap::store(h, w, i, x, valid := valid, inside := inside).value = Heap::store::bytes(own, length, w.base, w.count, i, x).value ∧
    rt_held::Stored::Holds(Arena::stored(), Heap::store::bytes(own, length, w.base, w.count, i, x).after, length, Heap::store(h, w, i, x, valid := valid, inside := inside).after.arena) {
    let ran = Heap::store::runs_held(own, h, length, w, i, x, valid, inside, holds);
    ⟨ran.value, ran.holds⟩
}

theorem heap_reset_held(own: List<u8>, h: Heap, length, mark: u64, holds: rt_held::Stored::Holds(Arena::stored(), own, length, h.arena)):
    Heap::reset(h, mark).value = Heap::reset::bytes(own, length, mark).value ∧
    rt_held::Stored::Holds(Arena::stored(), Heap::reset::bytes(own, length, mark).after, length, Heap::reset(h, mark).after.arena) {
    let ran = Heap::reset::runs_held(own, h, length, mark, holds);
    ⟨ran.value, ran.holds⟩
}

// In a checking position: a caller's proofs found where it is written, a
// window granted and its index tested, and the theorem read at them.
theorem heap_read_granted(own: List<u8>, h: Heap, size, i: u64, w: Window, granted: Heap::alloc(h, size).value = Granted(w), length: u64, small: i < w.count,
    holds: rt_held::Stored::Holds(Arena::stored(), own, length, Heap::alloc(h, size).after.arena)):
    Heap::alloc(h, size).after.read(w, i, valid := Heap::alloc_valid(h, size, w, granted)) = Heap::read::bytes(own, length, w.base, w.count, i).value {
    let found: ∥i.toNat() < w.count.toNat()∥ = bv_omega;
    Heap::read::runs_held(own, Heap::alloc(h, size).after, length, w, i, Heap::alloc_valid(h, size, w, granted), found, holds).value
}

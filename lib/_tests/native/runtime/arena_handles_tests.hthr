// Probes of `arena_handles.hthr`: the window laws together at an open heap,
// and the stale window of `arena_laws_tests.hthr` restated over handles,
// where it is a refused obligation and not only a pair of windows that
// meet.
import logic;
import bool;
import nat;
import list;
import option;
import vector;
import algebra;
import omega;
import runtime_data;
import arena;
import arena_laws;
import store;
import arena_handles;

// ---------------------------------------------------------------------------
// At an open heap: a window granted takes a store that no read through an
// older valid window sees. No `Apart` premise: the two keys differ
// (`alloc_other_key`), and validity gives the rest.
theorem fresh_store_unseen(h: Heap, size, i, x, k: u64, w, w2: Window, granted: Heap::alloc(h, size).value = Granted(w), valid2: h.Valid(w2),
    li: i.toNat() < w.count.toNat(), lk: k.toNat() < w2.count.toNat()):
    Heap::alloc(h, size).after.store(w, i, x, valid := Heap::alloc_valid(h, size, w, granted)).read(w2, k, valid := Heap::alloc_keeps(h, size, w2, valid2)) =
        h.read(w2, k, valid := valid2)
{
    let after = Heap::alloc(h, size).after;
    trans(after.store_apart(w, i, x, w2, k, Heap::alloc_valid(h, size, w, granted), Heap::alloc_keeps(h, size, w2, valid2), li, lk,
            λ e => Heap::alloc_other_key(h, size, w, granted, w2, valid2, sym(e))),
        Heap::alloc_reads_kept(h, size, w2, k, valid2, lk))
}

// A window below the mark survives a reset and reads what it read; one
// above it is ended.
theorem reset_splits(h: Heap, mark, k: u64, low, high: Window, vlow: h.Valid(low), under: low.base.toNat() + low.count.toNat() <= mark.toNat(),
    above: mark.toNat() < high.base.toNat() + high.count.toNat(), lk: k.toNat() < low.count.toNat()):
    And<Heap::reset(h, mark).after.read(low, k, valid := Heap::reset_keeps(h, mark, low, vlow, under)) = h.read(low, k, valid := vlow),
        ¬Heap::reset(h, mark).after.Valid(high)>
{
    And(Heap::reset_reads_kept(h, mark, low, k, vlow, under, lk), Heap::reset_ends(h, mark, high, above))
}

// A proof of validity in scope is what `known` finds.
fn read_known(h: Heap, w: Window, valid: h.Valid(w)) → u64 { if inside: 0 < w.count { h.read(w, 0) } else { 0 } }

// ---------------------------------------------------------------------------
// The stale window. `(0, 4)` granted, the heap reset to 0, `(0, 4)` granted
// again into the same claim slot at the next generation.

fn EMPTY_ARENA() → Arena { Arena(BitVec::ofNat(0), BitVec::ofNat(16), List::replicate(BitVec::ofNat(0, n := 64), 16).vector_of(16, BitVec::ofNat(0))) }

theorem empty_inv(): HeapInv(EMPTY_ARENA(), Store::empty()) {
    HeapInv(omega, omega, λ _ _ e => absurd(e), λ _ _ _ _ e1 _ _ => absurd(e1))
}

fn EMPTY() → Heap { Heap(EMPTY_ARENA(), Store::empty(), empty_inv()) }

fn NO_WINDOW() → Window { Window(0, 0, Key(0, 0)) }

fn FIRST() → Mutated<Heap, Grant> { Heap::alloc(EMPTY(), 4) }

fn W1() → Window { FIRST().value.window_or(NO_WINDOW()) }

fn SECOND() → Mutated<Heap, Grant> { Heap::alloc(Heap::reset(FIRST().after, 0).after, 4) }

fn W2() → Window { SECOND().value.window_or(NO_WINDOW()) }

// Both are `(0, 4)`; the keys name one slot at two generations.
theorem both_granted(): (W1() = Window(0, 4, Key(0, 0))) ∧ (W2() = Window(0, 4, Key(0, 1))) { ⟨refl, refl⟩ }

// They meet, as `arena_laws_tests.hthr`'s `stale_windows_meet` says of the
// words alone.
theorem stale_windows_meet(): ¬Arena::Apart(W1().base.toNat(), W1().count.toNat(), W2().base.toNat(), W2().count.toNat()) {
    let b1: (W1().base.toNat() = 0) = refl;
    let b2: (W2().base.toNat() = 0) = refl;
    let c1: (W1().count.toNat() = 4) = refl;
    let c2: (W2().count.toNat() = 4) = refl;
    λ apart => match apart { Inl(p) => omega(p, b1, b2, c1, c2), Inr(p) => omega(p, b1, b2, c1, c2) }
}

// The new window is valid; the stale one has no proof of validity.
theorem fresh_window_valid(): SECOND().after.Valid(W2()) { refl }

theorem stale_window_invalid(): ¬SECOND().after.Valid(W1()) { λ valid => absurd(valid) }

// The reset is what ended it, by the law at an open heap.
theorem stale_by_law(): ¬Heap::reset(FIRST().after, 0).after.Valid(W1()) {
    let end: (W1().base.toNat() + W1().count.toNat() = 4) = refl;
    Heap::reset_ends(FIRST().after, 0, W1(), omega(end))
}

// The read through the fresh window, its validity given.
theorem one_inside(): BitVec::ofNat(1, n := 64).toNat() < W2().count.toNat() { let c: (W2().count.toNat() = 4) = refl; omega(c) }

theorem fresh_reads(): SECOND().after.read(W2(), 1, valid := fresh_window_valid(), inside := squash(one_inside())) = 0 { refl }

// The read through the stale window, its validity left to `known`: refused,
// the obligation named. This is the stale window as a refused obligation.
// expect-error: `read`'s `valid` was left to its default, which did not give `arena_handles::Heap::Valid((SECOND).after, W1)` here
fn stale_read() → u64 { SECOND().after.read(W1(), 1) }

// And a store through it, the same.
// expect-error: `store`'s `valid` was left to its default
fn stale_store() → Heap { SECOND().after.store(W1(), 1, 5) }

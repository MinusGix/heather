// Probes for a `runtime fn`'s loops over words, which the elaborator writes
// as the library's `Loop::steps` where they stand
// (docs/language/loop-combinator-design.md §6.2): the reflector reads one
// `Iterate` node (a loop node where it fits, §6.9), and beside each loop the elaborator writes it as a
// `Loop` of its measure, whose step finds the decrease, and `f::loop::runs`,
// the loop the function runs is that `Loop`'s `run`. Each function here is
// compiled by its `runtime fn`, so checking this module is the test; each
// theorem runs a function by evaluation.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import tactic;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import rt_lower_defined;
import runtime;
import loop;

// One local, one capture, and the decrease `bv_omega` finds from the test.
runtime fn drop_to(n, lo: u64) → u64 {
    let mut x = n;
    while lo < x decreases (x - lo).toNat() { x := x - 1; }
    x
}

theorem drop_to_stops(): drop_to(10, 3) = 3 { refl }
theorem drop_to_below(): drop_to(2, 7) = 2 { refl }

// The loop the function runs is its `Loop`'s `run`, whatever the start.
theorem drop_to_loop_is_run(lo, x: u64):
    loop::Loop::steps(loop::Loop::passes(), λ (x: u64) => loop::Step::turn(decide_bit<lo < x>(), λ _ => { let x = x - 1; x }, x), x) =
        drop_to::loop::of(lo).run(x)
{
    drop_to::loop::runs(lo, x)
}

// A body with a `let`, the next value read through it, and a test that is
// a conjunction with a `≠` (one bit at the loop, split by its `Loop`'s step).
runtime fn halve_gap(n, lo, by: u64) → u64 {
    let mut x = n;
    while lo < x && by ≠ 0 decreases x.toNat() {
        let gap = x - lo;
        x := lo + (gap >> 1);
    }
    x
}

theorem halve_gap_runs(): halve_gap(40, 3, 5) = 3 { refl }

// Two captures, no local read in the test but the loop's own.
runtime fn count_up(n, step, cap: u64) → u64 {
    let mut x = n;
    while x < cap && step ≠ 0 decreases (cap - x).toNat() { x := x + 1; }
    x
}

theorem count_up_runs(): count_up(3, 1, 9) = 9 { refl }

// Two locals: the state is the generated record `f#State`, read back by
// its fields after the loop.
runtime fn bits_of(n: u64) → u64 {
    let mut x = n;
    let mut c: u64 = 0;
    while 0 < x decreases x.toNat() { x := x.shift_right(1); c := c + 1; }
    c
}

theorem bits_of_255(): bits_of(255) = 8 { refl }
theorem bits_of_0(): bits_of(0) = 0 { refl }

theorem bits_of_loop_is_run(s: bits_of::State): True { let _e = bits_of::loop::runs(s); trivial }

// A count over words: the count is a field of the state, the test `i < n`.
runtime fn fib(n: u64) → u64 {
    let mut a: u64 = 0;
    let mut b: u64 = 1;
    for i in 0..n { let t = a + b; a := b; b := t; }
    a
}

theorem fib_10(): fib(10) = 55 { refl }

theorem fib_loop_is_run(n: u64, s: fib::State): True { let _e = fib::loop::runs(n, s); trivial }

// Two loops in a row, the second starting where the first stopped, each
// read after it.
runtime fn there_and_back(n: u64) → u64 {
    let mut x: u64 = 0;
    while x < n decreases (n - x).toNat() { x := x + 1; }
    let mut y = x;
    let mut steps: u64 = 0;
    while 0 < y decreases y.toNat() { y := y - 1; steps := steps + 1; }
    x + steps
}

theorem there_and_back_4(): there_and_back(4) = 8 { refl }

// A measure the body does not lower is refused where the step goes round.
// expect-error: this pass of the loop must decrease the measure
runtime fn climbs(n: u64) → u64 {
    let mut x = n;
    while 0 < x decreases x.toNat() { x := x + 1; }
    x
}

// Written by hand, a loop reads as the elaborator's does (a record state
// read after the loop by its fields; a test of two bits), but no
// `f::loop::runs` pins it to a node, so it stays an `Iterate`, which is
// refused (docs/language/loop-combinator-design.md §6.9).
record Two { a: u64, b: u64 }

// expect-error: a loop that is not a loop node
runtime fn moved(n: u64) → u64 {
    let r: Two = loop::Loop::steps(loop::Loop::passes(), λ (s: Two) => loop::Step::turn(decide_bit<0 < s.b>(), λ _ => Two(s.a + 1, s.b - 1), s), Two(0, n));
    r.a + r.b + n
}

// expect-error: a loop that is not a loop node
runtime fn two_bits(n, cap: u64) → u64 {
    let x: u64 = loop::Loop::steps(loop::Loop::passes(), λ (x: u64) => loop::Step::turn(decide_bit<x < cap>() && decide_bit<x ≠ 7>(), λ _ => x + 1, x), n);
    x * 2
}

// Which loops are loop nodes (docs/language/loop-combinator-design.md
// §6.9): a `while` the elaborator wrote, over a word or over a record of
// words (its fields read before the node), is one `Tm::Loop`, its code one
// `Until`. One written by hand is refused above. `there_and_back`'s first loop is read twice, once for `x` and
// once for `y`'s start.
fn nodes_in(t: Tm) → Nat {
    match t {
        Let(e, b) => nodes_in(e) + nodes_in(b),
        If(_, y, n) => nodes_in(y) + nodes_in(n),
        Loop(_, _) => 1,
        _ => 0,
    }
}

fn iterates_in(t: Tm) → Nat {
    match t {
        Let(e, b) => iterates_in(e) + iterates_in(b),
        If(_, y, n) => iterates_in(y) + iterates_in(n),
        Iterate(_, _, _, _, _) => 1,
        _ => 0,
    }
}

theorem drop_to_node(): Pair(nodes_in(drop_to::rt.body), iterates_in(drop_to::rt.body)) = Pair(1, 0) { refl }
theorem halve_gap_node(): Pair(nodes_in(halve_gap::rt.body), iterates_in(halve_gap::rt.body)) = Pair(1, 0) { refl }
theorem count_up_node(): Pair(nodes_in(count_up::rt.body), iterates_in(count_up::rt.body)) = Pair(1, 0) { refl }
theorem there_and_back_nodes(): Pair(nodes_in(there_and_back::rt.body), iterates_in(there_and_back::rt.body)) = Pair(3, 0) { refl }
theorem bits_of_node(): Pair(nodes_in(bits_of::rt.body), iterates_in(bits_of::rt.body)) = Pair(1, 0) { refl }
theorem fib_node(): Pair(nodes_in(fib::rt.body), iterates_in(fib::rt.body)) = Pair(1, 0) { refl }

// A node's code is quiet, and what its ending owes is the generator's
// `f::ends`, from the loop's measure.
theorem drop_to_quiet(): drop_to::rt.quiet(drop_to::world) = True { refl }
theorem there_and_back_quiet(): there_and_back::rt.quiet(there_and_back::world) = True { refl }
theorem bits_of_quiet(): bits_of::rt.quiet(bits_of::world) = True { refl }
theorem fib_quiet(): fib::rt.quiet(fib::world) = True { refl }
theorem fib_ends_cited(): True { let _e = fib::ends; trivial }
theorem drop_to_ends_cited(): True { let _e = drop_to::ends; trivial }
theorem there_and_back_ends_cited(): True { let _e = there_and_back::ends; trivial }

// A loop given other passes than `Loop::passes()` is not one the reflector
// reads.
// expect-error: a loop given other than `Loop::passes()` passes
runtime fn short_loop(n: u64) → u64 {
    loop::Loop::steps(3, λ (x: u64) => loop::Step::turn(decide_bit<0 < x>(), λ _ => x - 1, x), n)
}

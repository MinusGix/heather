// What a `runtime fn` over an enum is refused at
// (docs/native/runtime-fn-setups-design.md §16.16): an enum is passed in
// as its tag word, matched on (`match` and `match h:`), built, returned
// and passed to a call; an enum whose constructors carry 64-bit fields is
// built and matched in a body, taken, passed and returned as its words
// (§16.17); one whose fields are bits or counts only inside a body. The accepted probes are runtime_enum_tests and
// runtime_enum_payload_tests. Tests, not library: nothing imports this
// module.

import bitvec;
import runtime;

inductive Shade { Dark, Mid, Light }

runtime fn shade_level(s: Shade) → u64 { match s { Dark => 10, Mid => 20, Light => 30 } }

// An enum is not a record's field: a record's fields are words.
record Tagged { s: Shade, n: u64 }

// expect-error: `Shade` has no runtime layout
runtime fn tagged_n(t: Tagged) → u64 { t.n }

// An enum with a payload is a parameter of several words, its tag word
// and then its slots (runtime_enum_payload_tests), but only where every
// slot is a 64-bit word: a bit's slot would be a word the caller could
// pass any value in.
inductive Flag { Unset, Set(b: Bool) }

// expect-error: a parameter that is not a word of at most 64 bits or an enum whose fields are 64-bit words
runtime fn flag_n(f: Flag) → u64 { match f { Unset => 0, Set(b) => if b { 1 } else { 2 } } }

// A field that is an enum has no slot: a slot is a word, a bit or a count.
inductive Lit { Off, On(s: Shade) }

// expect-error: a field of `Lit::On` that is not a word, a `Bool` or a `Nat`
runtime fn lit_of(x: u64) → u64 { match (if x < 1 { Off } else { On(Dark) }) { Off => 0, On(_) => 1 } }

// Probes of a word narrower than 64 bits at a `runtime fn`'s boundary
// (issues/runtime-repr-narrow-words.md, `Ty::Edge` in `rt_lower.hthr`). A
// plain function may take and return `u8`, `u16` or `u32`: a parameter is
// the low bits of the word passed, read into its own port by one `Resize`
// before the body, and the result is zero-extended into the word returned
// by one `Resize` after it. The agreement is stated at the words a call
// passes, through `runtime_low` and `runtime_wide`. Tests, not library:
// nothing imports this module.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// ---------------------------------------------------------------------------
// A byte in, a word out: the code reads the byte's port at its width.

runtime fn digit_value(b: u8) → u64 { if b'0' <= b ∧ b <= b'9' { (b - b'0').zero_extend(56) } else { 99 } }

theorem digit_value_rt_params(): digit_value::rt.params = [Word(8)] ∧ digit_value::rt.result = Word(64) { ⟨refl, refl⟩ }

// The low bits of whatever word is passed: the upper bits are not read.
theorem digit_value_agrees(x: u64): program_eval(digit_value::program, 0, [x]) = digit_value(runtime_low(8, x)) { digit_value::agrees(x) }

theorem digit_value_runs(): program_eval(digit_value::program, 0, [BitVec::ofNat(0x137)]) = 7 { digit_value::agrees(BitVec::ofNat(0x137)) }

// ---------------------------------------------------------------------------
// Narrow words in and out, at two widths: the result zero-extended.

runtime fn widen_add(a: u8, b: u16) → u16 { b + a.zero_extend(8) }

theorem widen_add_agrees(x, y: u64):
    program_eval(widen_add::program, 0, [x, y]) = runtime_wide(16, widen_add(runtime_low(8, x), runtime_low(16, y))) {
    widen_add::agrees(x, y)
}

// A sum that wraps at sixteen bits, from words with stray upper bits.
theorem widen_add_wraps(): program_eval(widen_add::program, 0, [BitVec::ofNat(0x302), BitVec::ofNat(0x1ffff)]) = 1 {
    widen_add::agrees(BitVec::ofNat(0x302), BitVec::ofNat(0x1ffff))
}

// A 32-bit result from 64-bit words: a truncation inside, a widening at the
// edge.
runtime fn low_half(x: u64) → u32 { x.truncate(32, 32) }

theorem low_half_runs(): program_eval(low_half::program, 0, [BitVec::ofNat(0x500000007)]) = 7 {
    low_half::agrees(BitVec::ofNat(0x500000007))
}

// ---------------------------------------------------------------------------
// A `Bool` at the boundary (docs/native/runtime-fn-setups-design.md
// §16.17) crosses as a one-bit word: a parameter is the lowest bit of the
// word passed (`runtime_bit_low`, a `Resize` to one bit before the body),
// and the result is zero or one (`runtime_bit_wide`, a `Resize` back after
// it), as C passes a `bool`.

runtime fn is_space(b: u8) → Bool { if b = b' ' { True } else { False } }

theorem is_space_agrees(x: u64): program_eval(is_space::program, 0, [x]) = runtime_bit_wide(is_space(runtime_low(8, x))) { is_space::agrees(x) }

theorem is_space_runs(): program_eval(is_space::program, 0, [BitVec::ofNat(0x120)]) = 1 ∧ program_eval(is_space::program, 0, [BitVec::ofNat(0x21)]) = 0 {
    ⟨is_space::agrees(BitVec::ofNat(0x120)), is_space::agrees(BitVec::ofNat(0x21))⟩
}

// A `Bool` parameter chooses between words: only its word's lowest bit
// is read.
runtime fn choose(c: Bool, x: u64, y: u64) → u64 { if c { x } else { y } }

theorem choose_agrees(c, x, y: u64): program_eval(choose::program, 0, [c, x, y]) = choose(runtime_bit_low(c), x, y) { choose::agrees(c, x, y) }

theorem choose_runs(): program_eval(choose::program, 0, [BitVec::ofNat(1), BitVec::ofNat(5), BitVec::ofNat(9)]) = 5 ∧
    program_eval(choose::program, 0, [BitVec::ofNat(2), BitVec::ofNat(5), BitVec::ofNat(9)]) = 9 {
    ⟨choose::agrees(BitVec::ofNat(1), BitVec::ofNat(5), BitVec::ofNat(9)), choose::agrees(BitVec::ofNat(2), BitVec::ofNat(5), BitVec::ofNat(9))⟩
}

// Bools in and out: a comparison's bit returned, another passed through.
runtime fn both_below(a: u64, b: u64, ok: Bool) → Bool { if a < b { ok } else { False } }

theorem both_below_runs(): program_eval(both_below::program, 0, [BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(1)]) = 1 ∧
    program_eval(both_below::program, 0, [BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(0)]) = 0 {
    ⟨both_below::agrees(BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(1)), both_below::agrees(BitVec::ofNat(2), BitVec::ofNat(3), BitVec::ofNat(0))⟩
}

// A `Bool` read back from a call: the callee answers its bit in a word,
// and the caller branches on it.
runtime fn is_small(x: u64) → Bool { if x < 10 { True } else { False } }

runtime fn count_small(x: u64, y: u64) → u64 { if is_small(x) { y + 1 } else { y } }

theorem count_small_agrees(x, y: u64): program_eval(count_small::program, 1, [x, y]) = count_small(x, y) { count_small::agrees(x, y) }

theorem count_small_runs(): program_eval(count_small::program, 1, [BitVec::ofNat(3), BitVec::ofNat(5)]) = 6 ∧
    program_eval(count_small::program, 1, [BitVec::ofNat(30), BitVec::ofNat(5)]) = 5 {
    ⟨count_small::agrees(BitVec::ofNat(3), BitVec::ofNat(5)), count_small::agrees(BitVec::ofNat(30), BitVec::ofNat(5))⟩
}

// A call of a function with a narrow parameter: the caller widens its
// argument into a word of its own first (`Tm::send_args`), and the callee
// reads the word's low bits.
runtime fn calls_digit(x: u64) → u64 { digit_value(x.truncate(8, 56)) + 1 }

theorem calls_digit_agrees(x: u64): program_eval(calls_digit::program, 1, [x]) = calls_digit(x) { calls_digit::agrees(x) }

// The byte is the word's low byte: 0x37 is '7', whatever is above it.
theorem calls_digit_runs(): program_eval(calls_digit::program, 1, [BitVec::ofNat(0x4137)]) = 8 { calls_digit::agrees(BitVec::ofNat(0x4137)) }

// A narrow argument computed in the caller, at its own width, then passed:
// a `u16` sum that wraps before the call reads it.
runtime fn wraps_then_widens(a: u8, b: u16) → u16 { widen_add(a, b + 1) }

theorem wraps_then_widens_runs(): program_eval(wraps_then_widens::program, 1, [BitVec::ofNat(3), BitVec::ofNat(0xffff)]) = 3 {
    wraps_then_widens::agrees(BitVec::ofNat(3), BitVec::ofNat(0xffff))
}

// A narrow result read back from a call, used at its width.
runtime fn twice_low(x: u64) → u32 { low_half(x) + low_half(x) }

theorem twice_low_runs(): program_eval(twice_low::program, 1, [BitVec::ofNat(0x900000003)]) = 6 { twice_low::agrees(BitVec::ofNat(0x900000003)) }

// A `Bool` passed to a call, and one passed on from the caller's own
// parameter.
runtime fn choose_small(x: u64, y: u64) → u64 { choose(is_small(x), x, y) }

theorem choose_small_runs(): program_eval(choose_small::program, 2, [BitVec::ofNat(3), BitVec::ofNat(40)]) = 3 ∧
    program_eval(choose_small::program, 2, [BitVec::ofNat(30), BitVec::ofNat(40)]) = 40 {
    ⟨choose_small::agrees(BitVec::ofNat(3), BitVec::ofNat(40)), choose_small::agrees(BitVec::ofNat(30), BitVec::ofNat(40))⟩
}

runtime fn pass_flag(c: Bool, x: u64) → u64 { choose(c, x, 0) }

theorem pass_flag_agrees(c, x: u64): program_eval(pass_flag::program, 1, [c, x]) = pass_flag(runtime_bit_low(c), x) { pass_flag::agrees(c, x) }

// ---------------------------------------------------------------------------
// Refusals, each with its reason.

// A loop's state is still 64-bit words (the loop's own lowering keeps
// `Ty::OneWord`).
// expect-error: a loop over something other than 64-bit words
runtime fn count_up(n, i: u64, b: u8) → u64 decreases (n - i).toNat() {
    if lt: i < n { count_up(n, i + 1, b + 1) } else { b.zero_extend(56) }
}


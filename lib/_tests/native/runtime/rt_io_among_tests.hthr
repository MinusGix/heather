// Probe of an effectful `rt` computation in a program with a function that
// writes (`rt_io_lower`; docs/native/native-one-compiler-design.md §2.6, U4 step
// 4c-4). The computation reads into its buffer and answers `raise_word` of
// the count, a call of function 0 of `tr`'s program
// (`raise_span::program`, native_tool_spans), whose function 1 rewrites the
// buffer. The soundness theorem is instantiated with the calls answered by
// that program: what it asks of the program's functions is asked of the one
// the computation can call, which the program's own marks say leaves every
// file (`program_writers_stills`). Tests, not library: nothing imports this
// module.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;
import native_source;
import native_source_co;
import native_source_io;
import rt;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import rt_io;
import rt_io_lower;
import runtime;
import runtime_file;
import native_tool_words;
import native_tool_words_program;
import native_tool_spans;

// Read up to 64 bytes from stdin into the buffer, and answer the count
// through `raise_word`.
fn Io::read_raised(mut self io: Io, buf: List<BitVec(8)>) → BitVec(64) {
    let r = io.read_into(Io::stdin(), buf, BitVec::ofNat(0), BitVec::ofNat(64));
    raise_word(r.result)
}

// Its computation: the call is of function 0 of the world.
fn read_body() → ETm { ETm::Let(Lit(Word(64), 0), ETm::Let(Lit(Word(64), 64), ETm::Invoke(Reads(0), [1, 2, 1, 0], ETm::Pure(Call(0, [0]))))) }

// The world: one function, `raise_word`, as `tr`'s program numbers it.
fn tr_world() → rt::World { rt::World(Table::none(), [Sig([Word(64)], Word(64))], Pair(λ (x: BitVec(64)) => raise_word(x), trivial)) }

fn read_g() → List<Ty> { [ByteList(0)] }
fn read_locs() → List<Loc> { [InBuffer(0)] }
fn read_lowered() → Option<ELowered> { read_body().lower(tr_world(), [], read_g(), read_locs(), 1) }
fn read_stmt() → Stmt { read_lowered().unwrap_or(ELowered(Exit(0), 0, 0, [])).stmt }
fn read_result() → Nat { read_lowered().unwrap_or(ELowered(Exit(0), 0, 0, [])).result }

fn lowers(o: Option<ELowered>) → Bool { match o { None => False, Some(_) => True } }
theorem read_lowers(): lowers(read_lowered()) = True { refl }

theorem read_means(io: Io, buf: List<BitVec(8)>): read_body().sem(tr_world(), [], read_g(), Pair(buf, trivial), io) = Io::read_raised(io, buf) { refl }

// The program's functions, as a source's calls are answered: `raise_span`
// among them, which writes.
fn tr_calls() → Writers() { program_writers(raise_span_program()) }

// The program's marks: function 0 leaves the file and function 1 does not,
// and the marks are sound.
theorem tr_marks(): raise_span::stills = [False, True] ∧ program_stills(raise_span_program(), raise_span::stills) = True { ⟨refl, refl⟩ }

// So the function the computation can call leaves every file.
theorem tr_still(): Writers::Still(tr_calls(), functions_below(1)) {
    Writers::still_within(tr_calls(), functions_below(1), linked_still(raise_span_program(), raise_span::stills),
        program_writers_stills(raise_span_program(), raise_span::stills, trivial),
        λ f => match f { Zero => λ _ => trivial, Succ(_) => λ never => false_elim(never) })
}

// And answers with `raise_word`, over any file the caller holds: it is
// lent nothing, and it is the program `raise_word` has alone.
theorem tr_agrees(held: Buffers()): Tm::CallsAgree(tr_world(), Writers::words(tr_calls(), held)) {
    λ f => match f {
        Zero => λ _ x => trans(cong_fn<Ending, List<BitVec(64)>>(λ end => Cons(end.word, end.rest), program_run_quiet(raise_span_program().tail(), trivial, [], 0, [x])),
            cong_fn<BitVec(64), List<BitVec(64)>>(λ w => [w], raise_word::agrees(x))),
        Succ(_) => λ ok => false_elim(ok.right),
    }
}

fn start(buf: List<BitVec(8)>) → native_source::Env { native_source::Env([], [buf], []) }

// The theorem at this computation in `tr`'s program: the lowered
// statements' tree, read against any world, is the surface method, up to
// silent steps.
fn read_reads(buf: List<BitVec(8)>, perform: PerformsCo()) →
    Io::Reads<BitVec(64)>(CoTree::map(Events::linux(), read_stmt().denote_co(tr_calls(), perform)(start(buf)),
            λ flow => flow.read_back(Word(64), Table::none(), read_result())),
        λ io => CRet(Io::read_raised(io, buf)))
{
    read_body().lower_reads(tr_world(), [], read_g(), read_locs(), 1, read_lowered().unwrap_or(ELowered(Exit(0), 0, 0, [])), refl,
        tr_calls(), tr_still(), tr_agrees, ETm::lents_agree_none(tr_calls()), perform, start(buf), Pair(buf, trivial), ⟨refl, trivial⟩, ⟨trivial, trivial⟩, trivial)
}

// The control: the function that writes is not among the ones that leave
// the file, so nothing here could be said of a computation that called it.
theorem tr_writer_unmarked(): linked_still(raise_span_program(), raise_span::stills, 1) = False { refl }

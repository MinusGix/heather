// Probes of the default setup's lowering of `rt` into FunctionIR and its
// soundness proved once (`lib/native/runtime/rt_lower.hthr`): V6 of
// docs/runtime-fn-setups-design.md §12, and round 2's primitives, literals,
// convoys, calls and the function wrapper. Per program nothing is proved: the
// lowering is evaluated, the theorem `Tm::lower_sound` is instantiated, and
// the pin (`rt` meaning to function, by conversion) closes the gap. Tests,
// not library: nothing imports this module.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import rt;
import function_ir;
import function_ir_eval;
import rt_lower;

fn no_records_world() → World { World(RecInfo::none, [], trivial) }

// What a lowering's region leaves at its result port as a word, or zero
// where the lowering refused.
fn Lowered::word(o: Option<Lowered>, call: Answers(), values: Valuation()) → BitVec(64) {
    match o { None => BitVec::ofNat(0), Some(c) => c.region.eval(call, values)(64, c.result) }
}

// ---------------------------------------------------------------------------
// A branch on a bit, one arm an `Add` (V6's two cases together).

fn pick(c: Bool, x, y: BitVec(64)) → BitVec(64) {
    match c { True => x.add(y), False => y }
}

// The context binds `c`, `x`, `y` in order, so `y` is variable 0. Their
// ports are the function's parameter ids 0, 1, 2.
fn pick_context() → List<Ty> { [Word(64), Word(64), Bit] }

fn pick_body() → Tm { If(2, Prim(Add(64), [1, 0]), Var(0)) }

// The lowering accepts it, by evaluation: the sum at id 3, the branch's
// result at 4, the next fresh id 5.
theorem pick_lowers():
    Tm::lower(pick_body(), no_records_world(), pick_context(), [2, 1, 0], 3).map(λ (c: Lowered) => Pair(c.result, c.next)) = Some(Pair(4, 5)) { refl }

// The region the lowering emits computes `pick`, from any valuation holding
// the arguments at their ports: the once-proof, instantiated.
theorem pick_agrees(c: Bool, x, y: BitVec(64), call: Answers(), values: Valuation(),
    held_c: values(1, 0) = BitVec::ofBool(c), held_x: values(64, 1) = x, held_y: values(64, 2) = y):
    Lowered::word(Tm::lower(pick_body(), no_records_world(), pick_context(), [2, 1, 0], 3), call, values) = pick(c, x, y) {
    Tm::lower_sound(pick_body(), no_records_world(), pick_context(), [2, 1, 0], 3, call, Tm::calls_agree_none(RecInfo::none, call), values, Pair(y, Pair(x, Pair(c, trivial))),
        ⟨held_y, ⟨held_x, ⟨held_c, trivial⟩⟩⟩, ⟨Nat::lt_succ_self(2), ⟨trivial, ⟨trivial, trivial⟩⟩⟩).right.right.right
}

// ---------------------------------------------------------------------------
// A shared subterm: the sum bound once and read twice.

fn twice(x: BitVec(64)) → BitVec(64) {
    let s = x.add(x);
    s.add(s)
}

fn twice_body() → Tm { Let(Prim(Add(64), [0, 0]), Prim(Add(64), [0, 0])) }

theorem twice_agrees(x: BitVec(64), call: Answers(), values: Valuation(), held_x: values(64, 0) = x):
    Lowered::word(Tm::lower(twice_body(), no_records_world(), [Word(64)], [0], 1), call, values) = twice(x) {
    Tm::lower_sound(twice_body(), no_records_world(), [Word(64)], [0], 1, call, Tm::calls_agree_none(RecInfo::none, call), values, Pair(x, trivial),
        ⟨held_x, trivial⟩, ⟨Nat::lt_succ_self(0), trivial⟩).right.right.right
}

// ---------------------------------------------------------------------------
// Refusals.

// A branch on a word is ill-typed: the lowering refuses it, so the theorem
// says nothing of it.
theorem branch_on_word_refused(): Tm::lower(If(0, Var(0), Var(0)), no_records_world(), [Word(64)], [0], 1) = None { refl }

// Arms of different codes are refused.
theorem arms_disagree_refused():
    Tm::lower(If(0, Var(0), Var(1)), no_records_world(), [Bit, Word(64)], [0, 1], 2) = None { refl }

// A wrong claim about the emitted region is refused: it computes `pick`,
// not the difference.
// expect-error(kernel): the kernel rejected `pick_not_sub`: NotConvertible
theorem pick_not_sub(x, y: BitVec(64), call: Answers(), values: Valuation(),
    held_c: values(1, 0) = BitVec::ofBool(True), held_x: values(64, 1) = x, held_y: values(64, 2) = y):
    Lowered::word(Tm::lower(pick_body(), no_records_world(), pick_context(), [2, 1, 0], 3), call, values) = x.sub(y) {
    Tm::lower_sound(pick_body(), no_records_world(), pick_context(), [2, 1, 0], 3, call, Tm::calls_agree_none(RecInfo::none, call), values, Pair(y, Pair(x, Pair(True, trivial))),
        ⟨held_y, ⟨held_x, ⟨held_c, trivial⟩⟩⟩, ⟨Nat::lt_succ_self(2), ⟨trivial, ⟨trivial, trivial⟩⟩⟩).right.right.right
}

// The negative control on the lowering itself: an `Add` lowered to a `Sub`
// node fails the `Add` case's proof, word for word the proof of the right
// lowering (`Tm::add_node_sound`).
fn wrong_add_node(next, width, pa, pb: Nat) → Option<Lowered> {
    Some(Lowered(nodes_region([Sub(width, next, pa, pb)]), next, Succ(next)))
}

// expect-error(kernel): the kernel rejected `wrong_add_node_sound`: NotConvertible
theorem wrong_add_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, width, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb), ea: Ty::at(g, a) = Word(width), eb: Ty::at(g, b) = Word(width)):
    Tm::LowerHolds(Prim(Add(width), [a, b]), w, g, ports, next, wrong_add_node(next, width, pa, pb)) {
    λ call agree values env held below => {
        let sum = λ (wd: Nat) => values(wd, pa).add(values(wd, pb));
        let left = Ty::cast_holds(w.tys, values, pa, Ty::at(g, a), Word(width), ea, Env::get(w.tys, g, env, a),
            env_holds_at(w.tys, values, g, ports, env, held, a, pa, at_a));
        let right = Ty::cast_holds(w.tys, values, pb, Ty::at(g, b), Word(width), eb, Env::get(w.tys, g, env, b),
            env_holds_at(w.tys, values, g, ports, env, held, b, pb, at_b));
        ⟨Nat::le_succ_r(next, next, next.le_refl()), ⟨next.lt_succ_self(),
            ⟨λ wd id lt => Valuation::set_other(values, next, sum, wd, id, Nat::ne_of_lt(id, next, lt)),
                trans(Valuation::set_here(values, next, sum, width), eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.add(y), left, right))⟩⟩⟩
    }
}

// ---------------------------------------------------------------------------
// Round 2: comparisons, `&&` and `!` on bits.

// What a lowering's region leaves at its result port as a bit, or zero
// where the lowering refused.
fn Lowered::bit(o: Option<Lowered>, call: Answers(), values: Valuation()) → BitVec(1) {
    match o { None => BitVec::ofNat(0), Some(c) => c.region.eval(call, values)(1, c.result) }
}

fn outside(lo, x, hi: BitVec(64)) → Bool { !(lo.unsigned_lt_bit(x) && x.unsigned_lt_bit(hi)) }

// `lo`, `x`, `hi` in order, so `hi` is variable 0, at ports 0, 1, 2.
fn outside_body() → Tm {
    Let(Prim(Ult(64), [2, 1]), Let(Prim(Ult(64), [2, 1]), Let(Prim(Conj, [1, 0]), Prim(Neg, [0]))))
}

fn words3() → List<Ty> { [Word(64), Word(64), Word(64)] }

theorem outside_agrees(lo, x, hi: BitVec(64), call: Answers(), values: Valuation(),
    held_hi: values(64, 0) = hi, held_x: values(64, 1) = x, held_lo: values(64, 2) = lo):
    Lowered::bit(Tm::lower(outside_body(), no_records_world(), words3(), [0, 1, 2], 3), call, values) = BitVec::ofBool(outside(lo, x, hi)) {
    Tm::lower_sound(outside_body(), no_records_world(), words3(), [0, 1, 2], 3, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(hi, Pair(x, Pair(lo, trivial))), ⟨held_hi, ⟨held_x, ⟨held_lo, trivial⟩⟩⟩, ⟨trivial, ⟨trivial, ⟨Nat::lt_succ_self(2), trivial⟩⟩⟩).right.right.right
}

// A wrong claim: the region negates the conjunction.
// expect-error(kernel): the kernel rejected `outside_not_inside`: NotConvertible
theorem outside_not_inside(lo, x, hi: BitVec(64), call: Answers(), values: Valuation(),
    held_hi: values(64, 0) = hi, held_x: values(64, 1) = x, held_lo: values(64, 2) = lo):
    Lowered::bit(Tm::lower(outside_body(), no_records_world(), words3(), [0, 1, 2], 3), call, values)
        = BitVec::ofBool(lo.unsigned_lt_bit(x) && x.unsigned_lt_bit(hi)) {
    Tm::lower_sound(outside_body(), no_records_world(), words3(), [0, 1, 2], 3, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(hi, Pair(x, Pair(lo, trivial))), ⟨held_hi, ⟨held_x, ⟨held_lo, trivial⟩⟩⟩, ⟨trivial, ⟨trivial, ⟨Nat::lt_succ_self(2), trivial⟩⟩⟩).right.right.right
}

// A bit literal is the one-bit word of its truth.
theorem bit_literal_agrees(call: Answers(), values: Valuation()):
    Lowered::bit(Tm::lower(Lit(Bit, 5), no_records_world(), [], [], 0), call, values) = BitVec::ofBool(True) {
    Tm::lower_sound(Lit(Bit, 5), no_records_world(), [], [], 0, call, Tm::calls_agree_none(RecInfo::none, call), values,
        trivial, trivial, trivial).right.right.right
}

// The negative control on the lowering: `!` against a constant zero is the
// bit itself, and the `Neg` case's proof fails on it.
fn wrong_neg_lowered(next, pa: Nat) → Lowered {
    Lowered(nodes_region([Const(1, next, 0), BitXor(1, Succ(next), pa, next)]), Succ(next), Succ(Succ(next)))
}

// expect-error(mismatch)
theorem wrong_neg_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), ea: Ty::at(g, a) = Bit):
    Tm::LowerHolds(Prim(Neg, [a]), w, g, ports, next, Some(wrong_neg_lowered(next, pa))) {
    λ call agree values env held below => {
        let one = Valuation::set(values, next, λ wd => BitVec::ofNat(0));
        let x = Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a));
        let pa_lt: (pa < next) = Ty::below_cast(w.tys, Ty::at(g, a), Bit, ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a));
        let step: (next <= Succ(next)) = Nat::le_succ_r(next, next, next.le_refl());
        ⟨Nat::le_succ_r(next, Succ(next), step), ⟨Succ(next).lt_succ_self(),
            ⟨λ wd id lt => trans(Valuation::set_other(one, Succ(next), λ v => one(v, pa).bxor(one(v, next)), wd, id,
                    Nat::ne_of_lt(id, Succ(next), Nat::lt_of_lt_of_le(id, next, Succ(next), lt, step))),
                Valuation::set_other(values, next, λ v => BitVec::ofNat(0), wd, id, Nat::ne_of_lt(id, next, lt))),
            trans(Valuation::set_here(one, Succ(next), λ v => one(v, pa).bxor(one(v, next)), 1),
                trans(eq2(λ (p: BitVec(1)) (q: BitVec(1)) => p.bxor(q),
                        trans(Valuation::set_other(values, next, λ v => BitVec::ofNat(0), 1, pa, Nat::ne_of_lt(pa, next, pa_lt)),
                            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Bit, ea)),
                        Valuation::set_here(values, next, λ v => BitVec::ofNat(0), 1)),
                    Tm::bxor_one(x)))⟩⟩⟩
    }
}

// ---------------------------------------------------------------------------
// Functions: the wrapper from `Function::eval` to the reflected meaning.
// The reflections are the reflector's (`lib/_tests/native/runtime/rt_tests.hthr`
// checks them against the elaborated bodies); here each is lowered and the
// theorem instantiated, and the pin closes by conversion.

// What a function's lowering returns on words, or zero where it refused.
fn Function::word(o: Option<Function>, call: Answers(), xs: List<BitVec(64)>) → BitVec(64) {
    match o { None => BitVec::ofNat(0), Some(code) => code.eval(call, xs) }
}

// A program with no calls needs no hypothesis about them.
fn twice_fun() → Fun { Fun([Word(64)], Word(64), twice_body()) }

theorem twice_compiled(call: Answers(), x: BitVec(64)): Function::word(twice_fun().lower(no_records_world()), call, [x]) = twice(x) {
    Fun::lower_sound(twice_fun(), no_records_world(), call, Tm::calls_agree_none(RecInfo::none, call), x)
}

// A literal and an exclusive or (`calls.hthr`'s leaf), and a call of it.
fn leaf(left: BitVec(64), right: BitVec(64)) → BitVec(64) {
    left.add(right).bxor(BitVec::ofNat(0x0123456789abcdef))
}

fn caller(left: BitVec(64), right: BitVec(64)) → BitVec(64) { leaf(left, right) }

fn leaf_rt() → Fun {
    Fun([Word(64), Word(64)], Word(64),
        Let(Prim(Add(64), [1, 0]), Let(Lit(Word(64), 0x0123456789abcdef), Prim(Bxor(64), [1, 0]))))
}

fn caller_rt() → Fun { Fun([Word(64), Word(64)], Word(64), Call(0, [1, 0])) }

fn calls_world() → World {
    World(RecInfo::none, [leaf_rt().sig(), caller_rt().sig()], Pair(leaf, Pair(caller, trivial)))
}

theorem leaf_compiled(call: Answers(), agree: Tm::CallsAgree(calls_world(), call), a, b: BitVec(64)):
    Function::word(leaf_rt().lower(calls_world()), call, [a, b]) = leaf(a, b) {
    Fun::lower_sound(leaf_rt(), calls_world(), call, agree, a, b)
}

// The call is FunctionIR's `Call` of function 0, answered by `leaf`'s
// meaning: the hypothesis a program discharges from `leaf_compiled`.
theorem caller_compiled(call: Answers(), agree: Tm::CallsAgree(calls_world(), call), a, b: BitVec(64)):
    Function::word(caller_rt().lower(calls_world()), call, [a, b]) = caller(a, b) {
    Fun::lower_sound(caller_rt(), calls_world(), call, agree, a, b)
}

// A `match h:` convoy (rt_tests' V4) lowers as a branch.
fn safe_pred(n: BitVec(64)) → BitVec(64) {
    match h: n.eq_bit(BitVec::ofNat(0)) { True => n, False => n.sub(BitVec::ofNat(1)) }
}

fn safe_pred_rt() → Fun {
    Fun([Word(64)], Word(64),
        Let(Lit(Word(64), 0), Let(Prim(Eq(64), [1, 0]), IfEq(0, Var(2), Let(Lit(Word(64), 1), Prim(Sub(64), [3, 0]))))))
}

fn safe_pred_world() → World { World(RecInfo::none, [safe_pred_rt().sig()], Pair(safe_pred, trivial)) }

theorem safe_pred_compiled(call: Answers(), agree: Tm::CallsAgree(safe_pred_world(), call), n: BitVec(64)):
    Function::word(safe_pred_rt().lower(safe_pred_world()), call, [n]) = safe_pred(n) {
    Fun::lower_sound(safe_pred_rt(), safe_pred_world(), call, agree, n)
}

// ---------------------------------------------------------------------------
// Refusals of round 2.

// An operand of the wrong width is refused: a `zero_extend` of a 32-bit
// word given a 64-bit one.
theorem zext_width_refused(): Tm::lower(Prim(Zext(32, 32), [0]), no_records_world(), [Word(64)], [0], 1) = None { refl }

// A call at a signature that is not all words.
fn bit_callee_world() → World { World(RecInfo::none, [Sig([Bit], Word(64))], Pair(λ (b: Bool) => BitVec::ofNat(0), trivial)) }

theorem call_of_bit_refused(): Tm::lower(Call(0, [0]), bit_callee_world(), [Bit], [0], 1) = None { refl }

// A call with an argument too few.
theorem call_arity_refused(): Tm::lower(Call(0, [0]), calls_world(), [Word(64)], [0], 1) = None { refl }

// A function of a bit has no word entry.
theorem fun_of_bit_refused(): Fun([Bit], Word(64), Lit(Word(64), 0)).lower(no_records_world()) = None { refl }

// ---------------------------------------------------------------------------
// Records (round 3): a record is its fields at consecutive ports. `Make`
// moves the field variables there, `Field` is the field's port (no code),
// and a branch moves a record a field at a time.

record WcState { lines: BitVec(64), words: BitVec(64), inside: Bool }

// rt_tests' V2, as the reflector reflects it.
fn wc_step(s: WcState, nl: Bool, space: Bool) → WcState {
    WcState(lines := s.lines.add(match nl { False => BitVec::ofNat(0), True => BitVec::ofNat(1) }),
            words := match !space && !s.inside { False => s.words, True => s.words.add(BitVec::ofNat(1)) },
            inside := !space)
}

fn wc_tys(i: Nat) → RecInfo {
    RecInfo(WcState, [Word(64), Word(64), Bit],
        λ t => WcState(t.fst, t.snd.fst, t.snd.snd.fst),
        λ s => Pair(s.lines, Pair(s.words, Pair(s.inside, trivial))),
        λ t => refl)
}

fn wc_step_body() → Tm {
    Let(Field(0, 0, 2),
    Let(If(2, Lit(Word(64), 1), Lit(Word(64), 0)),
    Let(Prim(Add(64), [1, 0]),
    Let(Prim(Neg, [3]),
    Let(Field(0, 2, 6),
    Let(Prim(Neg, [0]),
    Let(Prim(Conj, [2, 0]),
    Let(If(0, Let(Field(0, 1, 9), Let(Lit(Word(64), 1), Prim(Add(64), [1, 0]))), Field(0, 1, 9)),
        Make(0, [5, 0, 4])))))))))
}

fn wc_world() → World { World(wc_tys, [], trivial) }

// `s`, `nl`, `space` in order: `space` is variable 0 at port 4, `nl` at 3,
// and `s`'s fields at ports 0, 1, 2.
fn wc_context() → List<Ty> { [Bit, Bit, Named(0)] }

// The record a lowering leaves at its result ports: lines, words, the bit.
fn Lowered::wc(o: Option<Lowered>, call: Answers(), values: Valuation()) → Pair<BitVec(64), Pair<BitVec(64), BitVec(1)>> {
    match o {
        None => Pair(BitVec::ofNat(0), Pair(BitVec::ofNat(0), BitVec::ofNat(0))),
        Some(c) => Pair(c.region.eval(call, values)(64, c.result),
            Pair(c.region.eval(call, values)(64, Succ(c.result)), c.region.eval(call, values)(1, Succ(Succ(c.result))))),
    }
}

fn WcState::ports(self s: WcState) → Pair<BitVec(64), Pair<BitVec(64), BitVec(1)>> {
    Pair(s.lines, Pair(s.words, BitVec::ofBool(s.inside)))
}

// A branch between two records moves the chosen one a field at a time.
fn choose(c: Bool, s, t: WcState) → WcState { match c { True => s, False => t } }

theorem choose_agrees(c: Bool, s, t: WcState, call: Answers(), values: Valuation(),
    held_c: values(1, 6) = BitVec::ofBool(c),
    s_lines: values(64, 3) = s.lines, s_words: values(64, 4) = s.words, s_inside: values(1, 5) = BitVec::ofBool(s.inside),
    t_lines: values(64, 0) = t.lines, t_words: values(64, 1) = t.words, t_inside: values(1, 2) = BitVec::ofBool(t.inside)):
    Lowered::wc(Tm::lower(If(2, Var(1), Var(0)), wc_world(), [Named(0), Named(0), Bit], [0, 3, 6], 7), call, values) = choose(c, s, t).ports() {
    let ran = Tm::lower_sound(If(2, Var(1), Var(0)), wc_world(), [Named(0), Named(0), Bit], [0, 3, 6], 7, call, Tm::calls_agree_none(wc_tys, call),
        values, Pair(t, Pair(s, Pair(c, trivial))),
        ⟨⟨t_lines, ⟨t_words, ⟨t_inside, trivial⟩⟩⟩, ⟨⟨s_lines, ⟨s_words, ⟨s_inside, trivial⟩⟩⟩, ⟨held_c, trivial⟩⟩⟩,
        ⟨⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩, ⟨⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩, ⟨trivial, trivial⟩⟩⟩).right.right.right;
    eq2(λ (a: BitVec(64)) (b: Pair<BitVec(64), BitVec(1)>) => Pair(a, b), ran.left,
        eq2(λ (a: BitVec(64)) (b: BitVec(1)) => Pair(a, b), ran.right.left, ran.right.right.left))
}

// Refusals: a field past the record's end, and a record of a record.
theorem field_past_end_refused(): Tm::lower(Field(0, 3, 0), wc_world(), [Named(0)], [0], 3) = None { refl }

fn nested_tys(i: Nat) → RecInfo { RecInfo(True, [Named(0)], λ _ => trivial, λ _ => Pair(trivial, trivial), λ t => refl) }

theorem record_of_record_refused(): Tm::lower(Make(0, [0]), World(nested_tys, [], trivial), [Named(0)], [0], 1) = None { refl }

// The lowering's promise read off with the lowered region abstract: the
// elaborator then never spells the lowered region inside the record's type.
fn Lowered::WcOr(r: Option<Lowered>, call: Answers(), values: Valuation(), m: WcState) → Type {
    match r { None => True, Some(_) => Lowered::wc(r, call, values) = m.ports() }
}

theorem wc_step_lowered(r: Option<Lowered>, s: WcState, nl, space: Bool, call: Answers(), values: Valuation(),
    held_lines: values(64, 0) = s.lines, held_words: values(64, 1) = s.words, held_inside: values(1, 2) = BitVec::ofBool(s.inside),
    held_nl: values(1, 3) = BitVec::ofBool(nl), held_space: values(1, 4) = BitVec::ofBool(space),
    h: Tm::LowerHolds(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5, r)):
    Lowered::WcOr(r, call, values, wc_step(s, nl, space)) {
    match r as λ o => Tm::LowerHolds(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5, o) → Lowered::WcOr(o, call, values, wc_step(s, nl, space)) {
        None => λ _ => trivial,
        Some(_) => λ h => {
            let ran = h(call, Tm::calls_agree_none(wc_tys, call), values,
                Pair(space, Pair(nl, Pair(s, trivial))),
                ⟨held_space, ⟨held_nl, ⟨⟨held_lines, ⟨held_words, ⟨held_inside, trivial⟩⟩⟩, trivial⟩⟩⟩,
                ⟨trivial, ⟨trivial, ⟨⟨trivial, ⟨trivial, ⟨trivial, trivial⟩⟩⟩, trivial⟩⟩⟩).right.right.right;
            eq2(λ (a: BitVec(64)) (b: Pair<BitVec(64), BitVec(1)>) => Pair(a, b), ran.left,
                eq2(λ (a: BitVec(64)) (b: BitVec(1)) => Pair(a, b), ran.right.left, ran.right.right.left))
        },
    }(h)
}

// `wc_step`'s reflected body lowers, and its region leaves the step's record.
theorem wc_step_agrees(s: WcState, nl, space: Bool, call: Answers(), values: Valuation(),
    held_lines: values(64, 0) = s.lines, held_words: values(64, 1) = s.words, held_inside: values(1, 2) = BitVec::ofBool(s.inside),
    held_nl: values(1, 3) = BitVec::ofBool(nl), held_space: values(1, 4) = BitVec::ofBool(space)):
    Lowered::wc(Tm::lower(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5), call, values) = wc_step(s, nl, space).ports() {
    wc_step_lowered(Tm::lower(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5), s, nl, space, call, values,
        held_lines, held_words, held_inside, held_nl, held_space,
        Tm::lower_sound(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5))
}

// A wrong claim: the step does not swap the counts.
// expect-error(mismatch)
theorem wc_step_not_swapped(s: WcState, nl, space: Bool, call: Answers(), values: Valuation(),
    held_lines: values(64, 0) = s.lines, held_words: values(64, 1) = s.words, held_inside: values(1, 2) = BitVec::ofBool(s.inside),
    held_nl: values(1, 3) = BitVec::ofBool(nl), held_space: values(1, 4) = BitVec::ofBool(space)):
    Lowered::wc(Tm::lower(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5), call, values)
        = WcState(wc_step(s, nl, space).words, wc_step(s, nl, space).lines, wc_step(s, nl, space).inside).ports() {
    wc_step_lowered(Tm::lower(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5), s, nl, space, call, values,
        held_lines, held_words, held_inside, held_nl, held_space,
        Tm::lower_sound(wc_step_body(), wc_world(), wc_context(), [4, 3, 0], 5))
}

// ---------------------------------------------------------------------------
// Round 4: widths and shifts. `zero_extend` and `truncate` lower to one
// `Resize` node each (its value is the operand's number at the result's
// width, `BitVec::ofNat_toNat_zero_extend` and `_truncate`), a shift by a
// literal to FunctionIR's immediate shift.

// What a lowering's region leaves at its result port at width `wd`, or
// zero where the lowering refused.
fn Lowered::at(o: Option<Lowered>, call: Answers(), values: Valuation(), wd: Nat) → BitVec(wd) {
    match o { None => BitVec::ofNat(0), Some(c) => c.region.eval(call, values)(wd, c.result) }
}

// A byte widened to a word.
fn widen(b: BitVec(8)) → BitVec(64) { b.zero_extend(56) }

theorem widen_agrees(b: BitVec(8), call: Answers(), values: Valuation(), held_b: values(8, 0) = b):
    Lowered::word(Tm::lower(Prim(Zext(8, 56), [0]), no_records_world(), [Word(8)], [0], 1), call, values) = widen(b) {
    Tm::lower_sound(Prim(Zext(8, 56), [0]), no_records_world(), [Word(8)], [0], 1, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(b, trivial), ⟨held_b, trivial⟩, ⟨Nat::lt_succ_self(0), trivial⟩).right.right.right
}

// A word's low byte.
fn low(x: BitVec(64)) → BitVec(8) { x.truncate(8, 56) }

theorem low_agrees(x: BitVec(64), call: Answers(), values: Valuation(), held_x: values(64, 0) = x):
    Lowered::at(Tm::lower(Prim(Trunc(8, 56), [0]), no_records_world(), [Word(64)], [0], 1), call, values, 8) = low(x) {
    Tm::lower_sound(Prim(Trunc(8, 56), [0]), no_records_world(), [Word(64)], [0], 1, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(x, trivial), ⟨held_x, trivial⟩, ⟨Nat::lt_succ_self(0), trivial⟩).right.right.right
}

// All of them in one body: the low byte widened back, plus the word shifted
// left, against its top bits shifted down arithmetically and logically.
fn spread(x: BitVec(64)) → BitVec(64) {
    let b = x.truncate(8, 56);
    let y = b.zero_extend(56);
    let s = x.shift_left(3);
    let t = y.add(s);
    let u = x.arithmetic_shift_right(60);
    let v = x.shift_right(7);
    t.bxor(u).bor(v)
}

fn spread_body() → Tm {
    Let(Prim(Trunc(8, 56), [0]), Let(Prim(Zext(8, 56), [0]), Let(Prim(Shl(64, 3), [2]), Let(Prim(Add(64), [1, 0]),
        Let(Prim(Ashr(64, 60), [4]), Let(Prim(Lshr(64, 7), [5]), Let(Prim(Bxor(64), [2, 1]), Prim(Bor(64), [0, 1]))))))))
}

theorem spread_agrees(x: BitVec(64), call: Answers(), values: Valuation(), held_x: values(64, 0) = x):
    Lowered::word(Tm::lower(spread_body(), no_records_world(), [Word(64)], [0], 1), call, values) = spread(x) {
    Tm::lower_sound(spread_body(), no_records_world(), [Word(64)], [0], 1, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(x, trivial), ⟨held_x, trivial⟩, ⟨Nat::lt_succ_self(0), trivial⟩).right.right.right
}

// A wrong claim: the byte widened is not its sign extension.
// expect-error(kernel): the kernel rejected `widen_not_signed`: NotConvertible
theorem widen_not_signed(b: BitVec(8), call: Answers(), values: Valuation(), held_b: values(8, 0) = b):
    Lowered::word(Tm::lower(Prim(Zext(8, 56), [0]), no_records_world(), [Word(8)], [0], 1), call, values) = b.sign_extend(56) {
    Tm::lower_sound(Prim(Zext(8, 56), [0]), no_records_world(), [Word(8)], [0], 1, call, Tm::calls_agree_none(RecInfo::none, call), values,
        Pair(b, trivial), ⟨held_b, trivial⟩, ⟨Nat::lt_succ_self(0), trivial⟩).right.right.right
}

// The negative control on the lowering: a `zero_extend` lowered to a
// `Move` at the wider width (which reads the source at that width, not its
// value) fails the `Zext` case's proof, the right lowering's proof word for
// word but for the node.
fn wrong_zext_node(next, width, extra, pa: Nat) → Option<Lowered> {
    Some(Lowered(nodes_region([Move(extra + width, next, pa)]), next, Succ(next)))
}

// expect-error(kernel): the kernel rejected `wrong_zext_node_sound`: NotConvertible
theorem wrong_zext_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, width, extra, a, pa: Nat,
    at_a: port_at(ports, a) = Some(pa), ea: Ty::at(g, a) = Word(width)):
    Tm::LowerHolds(Prim(Zext(width, extra), [a]), w, g, ports, next, wrong_zext_node(next, width, extra, pa)) {
    Tm::resize_node_sound(w, g, ports, next, a, pa, at_a, width, extra + width, λ x => x.zero_extend(extra),
        BitVec::ofNat_toNat_zero_extend(width, extra), ea)
}

// Probes of `arena_laws.hthr`: the laws together at an open arena, and a
// window kept past a reset as the negative control.
import logic;
import bool;
import nat;
import list;
import vector;
import algebra;
import omega;
import runtime_data;
import arena;
import arena_laws;

// At an open arena: a window allocated above every older window takes a
// store that no read of an older window sees. `alloc_apart` gives the
// premise `store_apart` takes, in a checking position; the base is the one
// the outcome carries (`Got(base)`), with an open base.
theorem fresh_store_unseen(a: Arena, size, base, i, x, b, c, k: u64, got: Arena::alloc(a, size).value = Got(base),
    older: b.toNat() + c.toNat() <= a.top.toNat()):
    Arena::read(Arena::store(Arena::alloc(a, size).after, base, size, i, x).after, b, c, k).value =
        Arena::read(Arena::alloc(a, size).after, b, c, k).value
{
    let fresh = Arena::alloc_fresh(a, size, base, got);
    let at: (base.toNat() = a.top.toNat()) = cong_fn(λ (v: u64) => v.toNat(), fresh.left);
    let apart: Arena::Apart(base.toNat(), size.toNat(), b.toNat(), c.toNat()) =
        match Arena::alloc_apart(a, size, base, got, b.toNat(), c.toNat(), older) { Inl(p) => Inr(p), Inr(p) => Inl(p) };
    Arena::store_apart(Arena::alloc(a, size).after, base, size, i, x, b, c, k,
        omega(at, fresh.right.left, fresh.right.right.left), omega(older, fresh.right.left, fresh.right.right.left), apart)
}

// A caller binds the outcome and matches on it: the base where it is
// `Got`, and the arena as allocation left it where it is `Full`.
fn alloc_then_store(a: Arena, size, x: u64) → Mutated<Arena, u64> {
    let r = Arena::alloc(a, size);
    match r.value { Got(base) => Arena::store(r.after, base, size, 0, x), Full => Mutated(r.after, 0) }
}

// Where the window fits, the store is made at the old top, the base the
// outcome carries, at an open arena.
theorem alloc_then_store_got(a: Arena, size, x: u64, f: Arena::Fits(a, size)):
    alloc_then_store(a, size, x) = Arena::store(Arena::alloc(a, size).after, a.top, size, 0, x) {
    cong_fn(λ (v: Alloc) => match v { Got(base) => Arena::store(Arena::alloc(a, size).after, base, size, 0, x), Full => Mutated(Arena::alloc(a, size).after, 0) },
        Arena::alloc_got(a, size, f))
}

// At the limit, nothing is stored and the arena is as it was.
theorem alloc_then_store_full(a: Arena, size, x: u64, over: a.limit.toNat() < a.top.toNat() + size.toNat()): alloc_then_store(a, size, x) = Mutated(a, 0) {
    cong_fn(λ (m: Mutated<Arena, Alloc>) => match m.value { Got(base) => Arena::store(m.after, base, size, 0, x), Full => Mutated(m.after, 0) },
        Arena::alloc_full(a, size, over))
}

// The negative control at the type: `Full` carries no base, so an arm
// that reads one is refused.
// expect-error: unbound name `base`
fn full_base(a: Arena, size: u64) → u64 { match Arena::alloc(a, size).value { Got(base) => base, Full => base } }

// The negative control. `(0, 4)` allocated, the arena reset to 0, `(0, 4)`
// allocated again: the old window and the new one meet, so `store_apart`'s
// premise fails, and its conclusion does too (a store through the new
// window is read through the old).
fn STALE_EMPTY() → Arena { Arena(BitVec::ofNat(0), BitVec::ofNat(16), List::replicate(BitVec::ofNat(0, n := 64), 16).vector_of(16, BitVec::ofNat(0))) }

fn STALE_FIRST() → Mutated<Arena, Alloc> { Arena::alloc(STALE_EMPTY(), 4) }

fn STALE_SECOND() → Mutated<Arena, Alloc> { Arena::alloc(Arena::reset(STALE_FIRST().after, 0).after, 4) }

// Each base, as the outcome carries it (both are `Got`).
fn STALE_ONE() → u64 { STALE_FIRST().value.base_or(16) }

fn STALE_TWO() → u64 { STALE_SECOND().value.base_or(16) }

theorem stale_both_got(): (STALE_FIRST().value = Got(0)) ∧ (STALE_SECOND().value = Got(0)) { ⟨refl, refl⟩ }

theorem stale_windows_meet(): ¬Arena::Apart(STALE_ONE().toNat(), 4, STALE_TWO().toNat(), 4) {
    let b1: (STALE_ONE().toNat() = 0) = refl;
    let b2: (STALE_TWO().toNat() = 0) = refl;
    λ apart => match apart { Inl(p) => omega(p, b1, b2), Inr(p) => omega(p, b1, b2) }
}

theorem zero_not_five(e: BitVec::ofNat(0, n := 64) = BitVec::ofNat(5)): False { bv_omega }

theorem stale_store_seen(): ¬(Arena::read(Arena::store(STALE_SECOND().after, STALE_TWO(), 4, 1, 5).after, STALE_ONE(), 4, 1).value =
    Arena::read(STALE_SECOND().after, STALE_ONE(), 4, 1).value)
{
    let seen: (Arena::read(Arena::store(STALE_SECOND().after, STALE_TWO(), 4, 1, 5).after, STALE_ONE(), 4, 1).value = BitVec::ofNat(5)) = refl;
    let before: (Arena::read(STALE_SECOND().after, STALE_ONE(), 4, 1).value = BitVec::ofNat(0)) = refl;
    λ e => zero_not_five(trans(sym(before), trans(sym(e), seen)))
}

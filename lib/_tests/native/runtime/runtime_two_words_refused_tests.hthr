// What a `runtime fn` returning a record of two words is refused at
// (docs/native/runtime-fn-setups-design.md §16.16): a call of one, which
// reads RAX alone, and a record past the two result registers. The
// accepted probes are runtime_two_words_tests. Tests, not library: nothing
// imports this module.

import bitvec;
import runtime;

record Halves { high: u64, low: u64 }

runtime fn halves(x: u64) → Halves { Halves(x >> 32, x & 0xffffffff) }

// A call reads RAX alone: a function returning two words is not called.
// expect-error: a call of a function that does not take and return 64-bit words
runtime fn halves_called(x: u64) → u64 { halves(x).high }

// Three words are past the two result registers.
record Triple { a: u64, b: u64, c: u64 }

// expect-error: a result that is not a word of at most 64 bits or a record of two 64-bit words
runtime fn triple(x: u64) → Triple { Triple(x, x, x) }

// Probes of a pure body that calls procedures, lowered to a procedure's
// statements (`rt_proc`; docs/native/runtime-fn-recursion-design.md §6
// step 2): a recursive sum, its meaning read through the procedures'
// meanings, the levels it fits within, its procedure, the statements run
// with each call answered by its value, and refusals of a call with the wrong number of arguments and
// of a value that is not a word. Tests, not library: nothing outside
// lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic;
import nat;
import list;
import option;
import pair;
import bitvec;
import function_ir;
import function_ir_state;
import function_ir_placeless;
import native_source;
import native_source_io;
import native_source_pure;
import linux_world;
import rt;
import rt_lower;
import rt_io_lower;
import rt_proc;

fn proc_world() → rt::World { rt::World(Table::none(), [], trivial) }

// `sum(n) = if n == 0 { 0 } else { n + sum(n - 1) }`, variable 0 the
// argument: the call of itself is not the last thing it does.
fn sum_body() → PTm {
    Bind(Lit(Word(64), 0),
    Bind(Prim(Eq(64), [1, 0]),
    Choose(0,
        Value(Var(1)),
        Bind(Lit(Word(64), 1),
        Bind(Prim(Sub(64), [3, 0]),
        Recur(0, [0],
        Value(Prim(Add(64), [5, 0]))))))))
}

fn sum_defs() → List<PDef> { [PDef(1, sum_body())] }

// The sum as the reflector writes it, its call of itself `Call(0, …)`
// bound by a `Let`, reads as the same `PTm`.
fn sum_reflected() → Tm {
    Let(Lit(Word(64), 0),
    Let(Prim(Eq(64), [1, 0]),
    If(0,
        Var(1),
        Let(Lit(Word(64), 1),
        Let(Prim(Sub(64), [3, 0]),
        Let(Call(0, [0]),
        Prim(Add(64), [5, 0])))))))
}

theorem sum_from_reflected(): sum_reflected().to_ptm() = Some(sum_body()) { refl }

// Under `if h:` too.
theorem sum_from_if_eq(): Tm::to_ptm(Let(Lit(Word(64), 0), Let(Prim(Eq(64), [1, 0]), IfEq(0, Var(1),
    Let(Lit(Word(64), 1), Let(Prim(Sub(64), [3, 0]), Let(Call(0, [0]), Prim(Add(64), [5, 0])))))))) = Some(sum_body()) { refl }

// A self-call inside a bound term's own binding is refused.
theorem nested_self_call_refused(): Tm::to_ptm(Let(Let(Call(0, [0]), Var(0)), Var(0))).is_some() = False { refl }

// What the procedure means: the sum of 0 to its argument.
fn sum_meaning(p: Nat, xs: List<BitVec(64)>) → BitVec(64) {
    match xs { Nil => BitVec::ofNat(0), Cons(x, _) => BitVec::ofNat((x.toNat() * (x.toNat() + 1)).ldiv(2).quot()) }
}

// The meaning at 10, its call read through the procedures' meaning.
theorem sum_body_means(): PTm::sem(sum_body(), proc_world(), sum_meaning, PTm::word_ctx(1), PTm::vals_n(Table::none(), 1, [BitVec::ofNat(10)])) = BitVec::ofNat(55) {
    refl
}

// Its calls at 10 nest ten deep: it fits within ten levels and not nine.
theorem sum_fits_ten(): PDef::fits(sum_defs(), proc_world(), sum_meaning, 10, 0, [BitVec::ofNat(10)]) = True { refl }

theorem sum_not_nine(): PDef::fits(sum_defs(), proc_world(), sum_meaning, 9, 0, [BitVec::ofNat(10)]) = False { refl }

fn sum_procedures() → Option<List<Procedure>> { PDef::procedures(sum_defs(), proc_world(), PDef::known(sum_defs())) }

theorem sum_lowers(): sum_procedures().is_some() = True { refl }

fn sum_source() → Source {
    Source([], [], 0, Exit(0), procedures := match sum_procedures() { None => Nil, Some(ps) => ps })
}

fn sum_statement() → Stmt {
    match sum_source().procedures { Nil => Exit(0), Cons(proc, _) => proc.body }
}

// Its statements from an entry with argument 10, the call answered by the
// meaning: the world as it was, and 55 in the value word (word 1).
fn sum_run(io: Io) → Mutated<Io, Flow> {
    Stmt::thread_by(sum_statement(), program_writers([]), sum_source().pure_answer(PDef::spec(sum_defs(), sum_meaning, λ k p xs => PDef::fits(sum_defs(), proc_world(), sum_meaning, k, p, xs))),
        native_source::Env(Nil, [], []).set_words([0], [BitVec::ofNat(10)]), io)
}

theorem sum_runs(io: Io): (match sum_run(io).value { Onward(after) => after.number(1), Exited(_) => 0 }) = 55 { refl }

theorem sum_keeps_world(io: Io): sum_run(io).after = io { refl }

// A call with two arguments of a procedure that takes one.
fn wrong_arity_body() → PTm { Bind(Lit(Word(64), 1), Recur(0, [0, 1], Value(Var(0)))) }

theorem wrong_arity_refused(): PDef::procedures([PDef(1, wrong_arity_body())], proc_world(), PDef::known([PDef(1, wrong_arity_body())])).is_some() = False { refl }

// A value that is a bit, not a word.
theorem bit_value_refused(): PDef::procedures([PDef(1, Bind(Lit(Word(64), 0), Value(Prim(Eq(64), [1, 0]))))], proc_world(),
    PDef::known([PDef(1, Bind(Lit(Word(64), 0), Value(Prim(Eq(64), [1, 0]))))])).is_some() = False { refl }

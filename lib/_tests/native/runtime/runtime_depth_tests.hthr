// Probes of a recursion's depth bound (docs/native/runtime-fn-recursion-design.md
// §10.6). Tests, not library: nothing outside lib/_tests imports this
// module (docs/test-value-audit.md §4.5).
import logic;
import bool;
import nat;
import list;
import option;
import bitvec;
import bitvec_nat;
import rt;
import rt_lower;
import rt_lower_defined;
import function_ir;
import function_ir_eval;
import function_ir_levels;
import runtime;

runtime fn rsum(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => n.add(rsum(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

theorem rsum_quiet(): rsum::rt.quiet(rsum::world) = True { refl }

theorem rsum_coded(): rsum::compile.code = Setup::default().code(rsum::rt, rsum::world) { refl }


fn rsum_measure(n: BitVec(64)) → Nat { n.toNat() }

// The chain from a walked body to the program's definedness, the walk a
// premise.
theorem rsum_defined_from(more: Nat, n: BitVec(64),
    walked: (xs: List<BitVec(64)>) → Ty::AdmitsAll(rsum::world.tys, rsum::rt.params, xs) →
        rsum::rt.body.calls_ok(rsum::world.at(rsum::compile.callees, Nil),
            Tm::rank_oracle(rsum::world.at(rsum::compile.callees, Nil), [0, 0], 0, rsum_measure, Compile::rank(rsum, rsum::compile, rsum_measure, xs)),
            rsum::rt.context(), Ty::extend_words(rsum::world.tys, rsum::rt.params, Nil, trivial, xs)).IsTrue(),
    within: n.toNat() <= more):
    program_defined(program_deepened(rsum::program, more), 0, [n]).IsTrue() {
    let srcs = rsum::sources;
    let adm = rsum::admits;
    let arity = link_arity_self(rsum::program, rsum::arities, 1);
    let below = program_defined_over(Nil, program_deepened(Nil, more));
    let descends = Compile::descends(rsum, rsum::compile, srcs, adm, [0, 0], arity, link_every_table(Compile::table(rsum, rsum::compile)),
        link_same_admits(Compile::admit_table(rsum, rsum::compile)), trivial, refl, refl, refl, refl, refl, 0, refl, Nil, rsum_measure, walked, below,
        λ j lt ws => trivial);
    program_defined_deepened_by_rank(Compile::linked_self(rsum, rsum::compile, [0, 0]), Nil, rsum::arities, link_admits(adm), link_sources_at(srcs),
        rsum::sourced, more, Nil, Compile::rank(rsum, rsum::compile, rsum_measure), λ (ws: List<BitVec(64)>) => Ty::AdmitsAll(rsum::world.tys, rsum::rt.params, ws),
        0, refl, descends, [n], ⟨trivial, trivial⟩, within)
}

// Probes of a recursion's depth bound (docs/native/runtime-fn-recursion-design.md
// §10.6): a recursion's program, given `more` levels past its first, is
// defined wherever the function's measure is at most `more`, and answers as
// the function there. Tests, not library: nothing outside lib/_tests
// imports this module (docs/test-value-audit.md §4.5).
import logic;
import bool;
import nat;
import list;
import option;
import bitvec;
import bitvec_nat;
import rt;
import rt_lower;
import rt_lower_defined;
import function_ir;
import function_ir_eval;
import function_ir_levels;
import runtime;

// `n + (n - 1) + … + 0`: the call under a method call.
runtime fn rsum(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => n.add(rsum(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

// What `Compile::recursion_defined` evaluates at the instance: the code's
// nodes around its calls require nothing, and the instance's code is the
// default lowering's.
theorem rsum_quiet(): rsum::rt.quiet(rsum::world) = True { refl }

theorem rsum_coded(): rsum::compile.code = Setup::default().code(rsum::rt, rsum::world) { refl }

// The recursion is defined, and answers as the function, wherever its
// measure is at most the levels past the first: no premise about the
// program is left.
theorem rsum_defined(n: u64, more: Nat, within: n.toNat() <= more): program_defined(program_deepened(rsum::program, more), 0, [n]).IsTrue() {
    rsum::defined_within(n, more, within)
}

theorem rsum_agrees(n: u64, more: Nat, within: n.toNat() <= more): program_eval(program_deepened(rsum::program, more), 0, [n]) = rsum(n) {
    rsum::agrees_within(n, more, within)
}

// The bound is the one the levels give: one level short, the program is
// not defined (negative control).
theorem rsum_short(): program_defined(program_deepened(rsum::program, 2), 0, [BitVec::ofNat(3)]) = False { refl }

// Two parameters, the measure reading the second, and a `let` before the
// call.
runtime fn rpair(acc: u64, n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => acc,
        False => {
            let next = acc.add(n);
            rpair(next, n.sub(BitVec::ofNat(1))).add(BitVec::ofNat(1))
        },
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

theorem rpair_agrees(acc, n: u64, more: Nat, within: n.toNat() <= more):
    program_eval(program_deepened(rpair::program, more), 0, [acc, n]) = rpair(acc, n) {
    rpair::agrees_within(acc, n, more, within)
}

// A recursion that calls another function: the callee is before it in the
// program, and is defined everywhere.
runtime fn plus_one(x: u64) → u64 { x.add(BitVec::ofNat(1)) }

runtime fn rcall(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => plus_one(rcall(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

theorem rcall_defined(n: u64, more: Nat, within: n.toNat() <= more): program_defined(program_deepened(rcall::program, more), 1, [n]).IsTrue() {
    rcall::defined_within(n, more, within)
}

theorem rcall_agrees(n: u64, more: Nat, within: n.toNat() <= more): program_eval(program_deepened(rcall::program, more), 1, [n]) = rcall(n) {
    rcall::agrees_within(n, more, within)
}

// The measure, as a function of the parameters: what a certificate states
// its bound by.
theorem rpair_measure(acc, n: u64): rpair::measure(acc, n) = n.toNat() { refl }

theorem rpair_defined(acc, n: u64, within: rpair::measure(acc, n) <= 7): program_defined(program_deepened(rpair::program, 7), 0, [acc, n]).IsTrue() {
    rpair::defined_within(acc, n, 7, within)
}

// A recursion whose callee is a recursion has no bound read off it yet: its
// agreement keeps its premise.
runtime fn router(n: u64) → u64 decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => BitVec::ofNat(0),
        False => rsum(n).add(router(n.sub(BitVec::ofNat(1)))),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

theorem router_where(n: u64, more: Nat, defined: program_defined(program_deepened(router::program, more), 1, [n]).IsTrue()):
    program_eval(program_deepened(router::program, more), 1, [n]) = router(n) {
    router::agrees_where(n, more, defined)
}

// expect-error: agrees_within
theorem router_within(): True = True {
    let _ = router::agrees_within;
    refl
}

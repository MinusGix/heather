// Probes of loops over `i64` in `runtime fn` (docs/runtime-fn-setups-design.md
// §16.13, round 4; issues/runtime-repr-loops.md). Apart from
// `runtime_sint_tests` so each module stays inside the library gate's
// per-module CPU rail. Tests, not library: nothing imports this module.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import bitvec_nat;
import int;
import sint;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// A loop's state is words or types held by their repr in one, its result
// likewise. A fuel loop (the count a `Nat` read from a word), the same with a
// branch on a second `i64`, and a measured loop; the program agrees with the
// function on every word.

runtime fn i64_count(n: Nat, a: SInt(64)) → SInt(64) { match n { Zero => a, Succ(k) => i64_count(k, a + a) } }

theorem i64_count_agrees(r, x: BitVec(64)): program_eval(i64_count::program, 0, [r, x]) = I64::emb(i64_count(r.toNat(), I64::abs()(x))) { i64_count::agrees(r, x) }

runtime fn i64_clamp(n: Nat, a: SInt(64), lim: SInt(64)) → SInt(64) {
    match n { Zero => a, Succ(k) => if lim.lt_bit(a) { lim } else { i64_clamp(k, a + a, lim) } }
}

runtime fn i64_sum_down(n: BitVec(64), acc: SInt(64)) → SInt(64) decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => acc,
        False => i64_sum_down(n.sub(BitVec::ofNat(1)), acc + n.as_signed()),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

runtime fn i64_loops(x: SInt(64), n: BitVec(64)) → SInt(64) { i64_sum_down(n, i64_clamp(n.toNat(), x, i64_count(n.toNat(), x))) }

theorem i64_loops_agrees(x, n: BitVec(64)): program_eval(i64_loops::program, 3, [x, n]) = I64::emb(i64_loops(I64::abs()(x), n)) { i64_loops::agrees(x, n) }

// From -1 with n = 3: doubling gives -8, the clamp at -8 leaves -1 doubled
// three times, -8, and the measured loop adds 3, 2 and 1 read signed: -2.
theorem i64_loops_small(): program_eval(i64_loops::program, 3, [BitVec::ofNat(0xffffffffffffffff), BitVec::ofNat(3)]) =
    BitVec::ofNat(0xfffffffffffffffe) { i64_loops::agrees(BitVec::ofNat(0xffffffffffffffff), BitVec::ofNat(3)) }

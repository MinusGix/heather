// Probes for `runtime fn`s of a `Bytes(n)` (lib/native/runtime/bytes.hthr,
// docs/native/span-record-design.md): the function is compiled as the
// function of its bytes and `n` that its reflection writes out, and
// `f::runs_bytes` says the two agree at every record, with nothing proved
// by hand.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import vector;
import bitvec_bytes;
import nat_map;
import list_window;
import layout;
import stored;
import part;
import laid;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import rt_file_reflect;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import function_ir_writes;
import function_ir_link;
import function_ir_placeless;
import function_ir_lower;
import function_ir_lower_calls;
import x86_64_asm;
import runtime;
import runtime_file;
import stored_words;
import stored_accessor;
import rt_held;
import rt_held_fields;
import rt_held_reflect;
import bytes;
import rt_bytes;
import rt_bytes_loop;

// ---------------------------------------------------------------------------
// Stores and reads at found indices

runtime fn Bytes::copy_first({n: u64}, mut self s: Bytes(n), inside: ∥2 < s.len()∥ := bv_omega) → u64 {
    s[2] := s[0];
    s[1] := s[0];
    s.len()
}

// The record's bytes after the function are the code's span after it.
theorem copy_first_after({n: u64}, s: Bytes(n), inside: ∥2 < s.len()∥):
    (Bytes::copy_first(s, inside := inside).after).bytes = (Bytes::copy_first::bytes(s.bytes, n)).after {
    Bytes::copy_first::runs_bytes(n, s, inside, []).after
}

// ---------------------------------------------------------------------------
// A loop

runtime fn Bytes::clear({n: u64}, mut self s: Bytes(n)) → u64 {
    for i in 0..s.len() {
        s[i] := 0;
    }
    n
}

// The loop is written in place, one loop node over the record's bytes
// (docs/language/loop-combinator-design.md §6.3): the function agrees with
// its code at every record.
theorem clear_runs(): Bytes::clear(Bytes([1, 2, 3], refl), n := 3).after.bytes = [0, 0, 0] { refl }

theorem clear_after({n: u64}, s: Bytes(n)):
    (Bytes::clear(s).after).bytes = (Bytes::clear::bytes(s.bytes, n)).after {
    Bytes::clear::runs_bytes(n, s, []).after
}

// ---------------------------------------------------------------------------
// A loop that takes a fact (docs/native/span-record-design.md, "Loops that
// take facts"): its theorem is stated at the fact, which its passes keep
// without the body's proofs of it being read.

runtime fn Bytes::zero_from({n: u64}, s: Bytes(n), stop: u64, j: u64, inside: ∥stop <= s.len()∥ := bv_omega) → Mutated<Bytes(n), u64>
    decreases (stop - j).toNat() {
    if lt: j < stop {
        @zero_from(n, s.put(j, 0), stop, j + 1, inside)
    } else {
        Mutated(s, n)
    }
}

theorem zero_from_after({n: u64}, s: Bytes(n), stop, j: u64, inside: ∥stop <= s.len()∥):
    (Bytes::zero_from(s, stop, j, inside := inside).after).bytes = (Bytes::zero_from::bytes(s.bytes, n, stop, j)).after {
    Bytes::zero_from::runs_bytes(n, s, stop, j, inside, []).after
}

// A `while` whose invariant is a fact: the lifted loop takes it, and its
// caller is refused until a caller's theorem reads the facts at its call.
// expect-error: which takes facts
runtime fn Bytes::zero_upto({n: u64}, mut self s: Bytes(n), stop: u64, inside: ∥stop <= s.len()∥ := bv_omega) → u64 {
    let mut j: u64 = 0;
    while j < stop invariant stop <= s.len() decreases (stop - j).toNat() {
        s[j] := 0;
        j := j + 1;
    }
    n
}

// ---------------------------------------------------------------------------
// Functions that only read the record (docs/native/span-record-design.md,
// "Functions that only read"): each is compiled as a writer that stores
// nothing, and `f::runs_bytes` states its word beside the record as it was
// (`HWorld::unchanged`), so the code leaves the bytes as they were.

runtime fn Bytes::first_two({n: u64}, self s: Bytes(n), inside: ∥1 < s.len()∥ := bv_omega) → u64 { ↑s[0] + ↑s[1] }

theorem first_two_bytes(): Bytes::first_two::bytes([3, 4, 5], 3) = Mutated([3, 4, 5], 7) { refl }

theorem first_two_over({n: u64}, s: Bytes(n), inside: ∥1 < s.len()∥):
    Over<u64>(n, HWorld::unchanged(s, Bytes::first_two(s, inside := inside)), Bytes::first_two::bytes(s.bytes, n)) {
    Bytes::first_two::runs_bytes(n, s, inside, [])
}

// A `while` whose test reads the span: the loop is lifted, a loop that
// only reads, and the function calls it.
runtime fn Bytes::find_word({n: u64}, self s: Bytes(n), b: u64) → u64 {
    let mut i: u64 = 0;
    while i < s.len() && s[i].zero_extend(56) ≠ b decreases (n - i).toNat() { i := i + 1; }
    i
}

theorem find_word_bytes(): Bytes::find_word::bytes([3, 4, 5], 3, 5) = Mutated([3, 4, 5], 2) ∧
    Bytes::find_word::bytes([3, 4, 5], 3, 9) = Mutated([3, 4, 5], 3) ∧ Bytes::find_word::bytes([], 0, 9) = Mutated([], 0) {
    ⟨refl, ⟨refl, refl⟩⟩
}

// A reader written as its own recursion.
runtime fn Bytes::count_from({n: u64}, self s: Bytes(n), key, i, c: u64) → u64 decreases (n - i).toNat() {
    if h: i < s.len() { @count_from(n, s, key, i + 1, if s[i].zero_extend(56) = key { c + 1 } else { c }) } else { c }
}

theorem count_from_bytes(): Bytes::count_from::bytes([7, 1, 7], 3, 7, 0, 0) = Mutated([7, 1, 7], 2) { refl }

// At every record, and so at an open one: the function's word is the
// code's, and the bytes are as they were.
theorem count_from_over({n: u64}, s: Bytes(n), key, i, c: u64):
    Bytes::count_from(s, key, i, c) = (Bytes::count_from::bytes(s.bytes, n, key, i, c)).value ∧
    s.bytes = (Bytes::count_from::bytes(s.bytes, n, key, i, c)).after {
    let ran = Bytes::count_from::runs_bytes(n, s, key, i, c, []);
    ⟨ran.value, ran.after⟩
}

// A reader calling a reader twice, the second at a computed operand.
runtime fn Bytes::count_two({n: u64}, self s: Bytes(n), a, b: u64) → u64 { s.count_from(a, 0, 0) + s.count_from(b + 1, 0, 0) }

theorem count_two_bytes(): Bytes::count_two::bytes([7, 1, 7], 3, 7, 0) = Mutated([7, 1, 7], 3) { refl }

theorem count_two_over({n: u64}, s: Bytes(n), a, b: u64):
    Bytes::count_two(s, a, b) = (Bytes::count_two::bytes(s.bytes, n, a, b)).value {
    Bytes::count_two::runs_bytes(n, s, a, b, []).value
}

// A reader whose measure is not a word's `toNat`.
// expect-error: must `decreases` a 64-bit word's `toNat`
runtime fn Bytes::count_slow({n: u64}, self s: Bytes(n), i, c: u64) → u64 decreases (n - i).toNat() + 1 {
    if h: i < s.len() { @count_slow(n, s, i + 1, c + 1) } else { c }
}

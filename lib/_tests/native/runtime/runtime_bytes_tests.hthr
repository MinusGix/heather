// ---------------------------------------------------------------------------
// Stores and reads at found indices

runtime fn Bytes::copy_first({n: u64}, mut self s: Bytes(n), inside: ∥2 < s.len()∥ := bv_omega) → u64 {
    s[2] := s[0];
    s[1] := s[0];
    s.len()
}

// The record's bytes after the function are the code's span after it.
theorem copy_first_after({n: u64}, s: Bytes(n), inside: ∥2 < s.len()∥):
    (Bytes::copy_first(s, inside := inside).after).bytes = (Bytes::copy_first::bytes(s.bytes, n)).after {
    Bytes::copy_first::runs_bytes(n, s, inside, []).after
}

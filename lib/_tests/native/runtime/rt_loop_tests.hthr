// Probes of `rt_loop` (docs/native/runtime-fn-setups-design.md §16.10): a fuel
// recursion and a measured one, each lowered to a loop, their agreement read
// off the once-proved theorems with the hypotheses discharged as the
// generator does: the fuel equations by `refl`, `Guarded` from the
// function's own `ext` and `irrel`.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import rt;
import function_ir;
import function_ir_eval;
import rt_lower;
import rt_loop;
import tactic;
import simp;

fn rt_loop_lowers(r: Option<Function>) → Bool { match r { None => False, Some(_) => True } }

// ---------------------------------------------------------------------------
// A fuel recursion (examples/x86-native/loop_triangle.hthr).

fn sum_down(fuel: Nat, n, acc: BitVec(64)) → BitVec(64) {
    match fuel {
        Zero => acc,
        Succ(k) => match n.eq_bit(BitVec::ofNat(0)) {
            False => sum_down(k, n.sub(BitVec::ofNat(1)), acc.add(n)),
            True => acc,
        },
    }
}

// The `Succ` arm over `[k, acc, n, fuel]`.
fn sum_down_succ() → Tm {
    Let(Lit(Word(64), 0), Let(Prim(Eq(64), [3, 0]),
        If(0, Var(3), Let(Lit(Word(64), 1), Let(Prim(Sub(64), [5, 0]), Let(Prim(Add(64), [5, 6]), Call(0, [5, 1, 0])))))))
}

fn sum_down_world() → World { World(Table::none(), [Sig([Count, Word(64), Word(64)], Word(64))], Pair(sum_down, trivial)) }

theorem sum_down_lowers(): rt_loop_lowers(Fun::lower_fuel(Word(64), [Word(64)], Var(0), sum_down_succ(), Word(64), sum_down_world())) = True { refl }

theorem sum_down_loops(): Fun::FuelHolds([Word(64), Word(64)], Word(64), sum_down_world(), λ n => sum_down(n),
    Fun::lower_fuel(Word(64), [Word(64)], Var(0), sum_down_succ(), Word(64), sum_down_world())) {
    Fun::fuel_sound(Word(64), [Word(64)], Var(0), sum_down_succ(), Word(64), sum_down_world(), λ n => sum_down(n),
        λ x1 x2 => refl, λ r x1 x2 => refl)
}

// A wrong step is refused: `+` read as `-`.
fn sum_down_wrong() → Tm {
    Let(Lit(Word(64), 0), Let(Prim(Eq(64), [3, 0]),
        If(0, Var(3), Let(Lit(Word(64), 1), Let(Prim(Sub(64), [5, 0]), Let(Prim(Sub(64), [5, 6]), Call(0, [5, 1, 0])))))))
}

// expect-error(kernel): NotConvertible
theorem sum_down_wrong_step(): (r: Nat) → Fun::FuelStep([Word(64), Word(64)], Word(64), sum_down_wrong(), sum_down_world(), λ n => sum_down(n), r) {
    λ r x1 x2 => refl
}

// ---------------------------------------------------------------------------
// A measured recursion (examples/x86-native/loop_measure.hthr).

fn count_down(n, acc: BitVec(64)) → BitVec(64) decreases n.toNat() {
    match h: n.eq_bit(BitVec::ofNat(0)) {
        True => acc,
        False => count_down(n.sub(BitVec::ofNat(1)), acc.add(n)),
    }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}

// The body as written, over `[acc, n]`.
fn count_down_body() → Tm {
    Let(Lit(Word(64), 0), Let(Prim(Eq(64), [2, 0]),
        IfEq(0, Var(2), Let(Lit(Word(64), 1), Let(Prim(Sub(64), [4, 0]), Let(Prim(Add(64), [4, 5]), Call(0, [1, 0])))))))
}

fn count_down_world() → World { World(Table::none(), [Sig([Word(64), Word(64)], Word(64))], Pair(count_down, trivial)) }

fn count_down_measure(ys: List<BitVec(64)>) → Nat { ys.head_or(BitVec::zero()).toNat() }

theorem count_down_lowers(): rt_loop_lowers(Fun::lower_measured([], Word(64), [Word(64)], count_down_body(), Word(64), count_down_world(), 0)) = True { refl }

// The body with its recursion answered by `again` is the recursor's step
// with an ih that drops its proof.
theorem count_down_step(n, acc: BitVec(64), again: List<BitVec(64)> → BitVec(64)):
    count_down_body().tail_sem(count_down_world(), 0, Word(64), again, [Word(64), Word(64)], Pair(acc, Pair(n, trivial))) =
        count_down::body(n.toNat(), λ (y1: BitVec(64)) (y2: BitVec(64)) _ => again([y1, y2]), n, acc, nat::Nat::lt_succ_self(n.toNat())) { refl }

// `Guarded`, from `count_down::ext` and `count_down::irrel`: the generator's
// proof, written out.
theorem count_down_guarded(): Fun::Guarded([Word(64), Word(64)], Word(64), count_down_body(), count_down_world(), count_down, count_down_measure) {
    λ n acc again hyp => sym(count_down::ext(n.toNat(), n.toNat(),
        λ (y1: BitVec(64)) (y2: BitVec(64)) (p: nat::Nat::Lt(y1.toNat(), n.toNat())) => count_down::rec(n.toNat(), y1, y2, p),
        λ (y1: BitVec(64)) (y2: BitVec(64)) _ => again([y1, y2]),
        λ y1 y2 p q => trans(count_down::irrel(n.toNat(), y1.toNat() + 1, y1, y2, p, nat::Nat::lt_succ_self(y1.toNat())),
            sym(hyp([y1, y2], refl, p))),
        n, acc, nat::Nat::lt_succ_self(n.toNat()), nat::Nat::lt_succ_self(n.toNat())))
}

theorem count_down_bounded(): Fun::Bounded([Word(64), Word(64)], count_down_measure) {
    λ n acc => BitVec::toNat_lt_pow(64, n)
}

theorem count_down_loops(): Fun::MeasuredHolds([Word(64), Word(64)], Word(64), count_down_world(), count_down,
    Fun::lower_measured([], Word(64), [Word(64)], count_down_body(), Word(64), count_down_world(), 0)) {
    Fun::measured_sound([], Word(64), [Word(64)], count_down_body(), Word(64), count_down_world(), 0, count_down, count_down_measure,
        count_down_bounded(), count_down_guarded())
}

// ---------------------------------------------------------------------------
// `simp` on what a pass leaves: the continuation's `λ` is crossed by
// `Tm::leave`'s pointwise evidence, and a law about the leaving word closes.

theorem leave_continuation_simplified(w: World, res: Ty, er: res.OneWord(w.tys), a: Valuation(), flag: Nat, kept, ns: List<Nat>):
    words_of(a, ns).head_or(BitVec::zero()) =
        Tm::leave(a, flag, kept, ns,
            λ (ys: List<BitVec(64)>) => Tm::out(w.tys, res, Tm::into(w.tys, res, words_of(a, ns).head_or(BitVec::zero())))) {
    simp_only(Tm::out_into(w.tys, res, er), Tm::leave_first)
}

// ---------------------------------------------------------------------------
// The same recursion as a loop node (docs/language/loop-combinator-design.md
// §6.7): the body once, its call of itself a going round, the function's
// words the loop's state. Its code means what the node means
// (`Tm::lower_sound`), and the node means the function
// (`Loop::rounds_agree`), each pass from `count_down::ext` and
// `count_down::irrel` as `Guarded` is.

// The body over the state `[acc, n]`, going round where it called itself.
fn count_down_pass() → Tm {
    Let(Lit(Word(64), 0), Let(Prim(Eq(64), [2, 0]),
        IfEq(0, Var(2), Let(Lit(Word(64), 1), Let(Prim(Sub(64), [4, 0]), Let(Prim(Add(64), [4, 5]), Again(Word(64), [1, 0])))))))
}

fn count_down_node() → Tm { Loop([1, 0], count_down_pass()) }

theorem count_down_node_lowers(): rt_loop_lowers(Fun([Word(64), Word(64)], Word(64), count_down_node()).lower(count_down_world())) = True { refl }

// The function on words, as the state reads them (zero past their end).
fn count_down_words(ys: List<BitVec(64)>) → BitVec(64) { Ty::apply(Table::none(), [Word(64), Word(64)], Word(64), count_down, ys) }

// One pass, its going round answered by anything that agrees with the
// function below the measure, is the function.
theorem count_down_node_pass_at(n, acc: BitVec(64), k: List<BitVec(64)> → BitVec(64),
    agree: (zs: List<BitVec(64)>) → count_down_measure(zs) < n.toNat() → k(zs) = count_down_words(zs)):
    Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_pass(), k, [n, acc]) = count_down(n, acc) {
    sym(count_down::ext(n.toNat(), n.toNat(),
        λ (y1: BitVec(64)) (y2: BitVec(64)) (p: nat::Nat::Lt(y1.toNat(), n.toNat())) => count_down::rec(n.toNat(), y1, y2, p),
        λ (y1: BitVec(64)) (y2: BitVec(64)) _ => k([y1, y2]),
        λ y1 y2 p q => trans(count_down::irrel(n.toNat(), y1.toNat() + 1, y1, y2, p, nat::Nat::lt_succ_self(y1.toNat())),
            sym(agree([y1, y2], p))),
        n, acc, nat::Nat::lt_succ_self(n.toNat()), nat::Nat::lt_succ_self(n.toNat())))
}

// At any words: those past the state's two are not read, and missing ones
// are zero, alike on both sides.
theorem count_down_node_pass(ys: List<BitVec(64)>, k: List<BitVec(64)> → BitVec(64),
    agree: (zs: List<BitVec(64)>) → count_down_measure(zs) < count_down_measure(ys) → k(zs) = count_down_words(zs)):
    Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_pass(), k, ys) = count_down_words(ys) {
    match ys as λ l => ((zs: List<BitVec(64)>) → count_down_measure(zs) < count_down_measure(l) → k(zs) = count_down_words(zs)) →
        Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_pass(), k, l) = count_down_words(l) {
        Nil => λ a => count_down_node_pass_at(BitVec::zero(), BitVec::zero(), k, a),
        Cons(y1, r1) => match r1 as λ l1 => ((zs: List<BitVec(64)>) → count_down_measure(zs) < count_down_measure(Cons(y1, l1)) → k(zs) = count_down_words(zs)) →
            Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_pass(), k, Cons(y1, l1)) = count_down_words(Cons(y1, l1)) {
            Nil => λ a => count_down_node_pass_at(y1, BitVec::zero(), k, a),
            Cons(y2, _) => λ a => count_down_node_pass_at(y1, y2, k, a),
        },
    }(agree)
}

// The node means the function, at every pair of words.
theorem count_down_node_means(n, acc: BitVec(64)):
    Tm::sem(count_down_node(), count_down_world(), [Word(64), Word(64)], Pair(acc, Pair(n, trivial))) = count_down(n, acc) {
    trans(Tm::sem_in_loop([1, 0], count_down_pass(), count_down_world(), Tm::no_label(Table::none()), [Word(64), Word(64)], Pair(acc, Pair(n, trivial))),
        loop::Loop::rounds_agree(count_down_measure, count_down_words,
            λ (k: List<BitVec(64)> → BitVec(64)) (ys: List<BitVec(64)>) => Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_pass(), k, ys),
            λ (ys: List<BitVec(64)>) => Ty::cast(Table::none(), Word(64), Word(64), ys.head_or(BitVec::zero())),
            λ ys k a => count_down_node_pass(ys, k, a), Tm::passes(), [n, acc], Tm::word_within(n)))
}

// A wrong pass is refused: `+` read as `-`.
fn count_down_wrong_pass() → Tm {
    Let(Lit(Word(64), 0), Let(Prim(Eq(64), [2, 0]),
        IfEq(0, Var(2), Let(Lit(Word(64), 1), Let(Prim(Sub(64), [4, 0]), Let(Prim(Sub(64), [4, 5]), Again(Word(64), [1, 0])))))))
}

// expect-error(kernel): NotConvertible
theorem count_down_wrong_node(n, acc: BitVec(64), k: List<BitVec(64)> → BitVec(64),
    agree: (zs: List<BitVec(64)>) → count_down_measure(zs) < n.toNat() → k(zs) = count_down_words(zs)):
    Tm::loop_body(count_down_world(), [Word(64), Word(64)], count_down_wrong_pass(), k, [n, acc]) = count_down(n, acc) {
    sym(count_down::ext(n.toNat(), n.toNat(),
        λ (y1: BitVec(64)) (y2: BitVec(64)) (p: nat::Nat::Lt(y1.toNat(), n.toNat())) => count_down::rec(n.toNat(), y1, y2, p),
        λ (y1: BitVec(64)) (y2: BitVec(64)) _ => k([y1, y2]),
        λ y1 y2 p q => trans(count_down::irrel(n.toNat(), y1.toNat() + 1, y1, y2, p, nat::Nat::lt_succ_self(y1.toNat())),
            sym(agree([y1, y2], p))),
        n, acc, nat::Nat::lt_succ_self(n.toNat()), nat::Nat::lt_succ_self(n.toNat())))
}

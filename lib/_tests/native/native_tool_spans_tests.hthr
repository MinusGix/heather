// Probes of `native_tool_spans`: what `count_newlines` computes, that it
// may be called by a program (evaluable, placeless, lowered by the function
// compiler under its count of lent buffers), and what a program's call of
// it answers with no address stated (`program_readers`).
import native_tool_spans;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_placeless;
import function_ir_lower;
import function_ir_lower_calls;
import x86_64_asm;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

// "a\nb\n\nc": three newlines in six bytes.
fn lines() → Buffers() { [[b(97), b(10), b(98), b(10), b(10), b(99)]] }

// ---------------------------------------------------------------------------
// What it computes

theorem counts_all(): program_eval_over(lines(), count_newlines_program(), 0, [w(4096), w(6), w(6)]) = w(3) { refl }
// Only the first `count` bytes.
theorem counts_first(): program_eval_over(lines(), count_newlines_program(), 0, [w(4096), w(6), w(2)]) = w(1) { refl }
theorem counts_none(): program_eval_over(lines(), count_newlines_program(), 0, [w(4096), w(6), w(0)]) = w(0) { refl }
// A count past the buffer's end reads nothing past it.
theorem counts_to_end(): program_eval_over(lines(), count_newlines_program(), 0, [w(4096), w(6), w(9)]) = w(3) { refl }

// ---------------------------------------------------------------------------
// What a program's call needs of it (`Prog::links`)

theorem count_evaluable(): program_evaluable(count_newlines_program()) = True { refl }
theorem count_placeless(): program_placeless(count_newlines_program()) = True { refl }
theorem count_lent(): program_lent(count_newlines_program(), 0) = 1 { refl }
theorem count_lowers(): lower_program_lent(count_newlines_program(), plan_program(count_newlines_program()),
    program_counts(count_newlines_program())).is_some().IsTrue() { trivial }

// ---------------------------------------------------------------------------
// A program's call: the buffers it holds, no address, the count its word

theorem call_answers(): program_readers(count_newlines_program())(lines(), 0, [w(6)]) = w(3) { refl }
// It is lent the first buffer only, and sees it as it is when called.
theorem call_sees_first(): program_readers(count_newlines_program())([[b(10), b(10)], [b(10)]], 0, [w(2)]) = w(2) { refl }
theorem call_sees_now(): program_readers(count_newlines_program())([[b(10), b(7)]], 0, [w(2)]) = w(1) { refl }

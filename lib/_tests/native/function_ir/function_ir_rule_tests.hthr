// The `rule` prefix generator (function_ir_rule): for each rule theorem,
// the clause its statement stands for at chosen numbers, by evaluation, and
// a guard that refuses. The rule's soundness is in the published value's
// type, so each `_rule` below checking is the generator's proof checking.
// Tests, not library: nothing imports this module.
import function_ir;
import function_ir_eval;
import function_ir_replay;
import function_ir_rule;
import function_ir_rule_sound;
import function_ir_rules;
import tactic;
import bitvec; import bitvec_bytes; import bitvec_nat; import bitvec_resize; import bitvec_ring;
import omega; import bitvec_shift_nat; import bool; import list; import logic; import nat; import option; import string;

rule theorem add_zero_r(w: Nat, x: BitVec(w)): x.add(BitVec::ofNat(0)) = x { BitVec::add_zero(w, x) }

theorem add_zero_made(): add_zero_r_rule.make([64, 5, 7, 6]) = Some(Clause([Is(Const(64, 6, 0)), Is(Add(64, 7, 5, 6))], Is(Move(64, 7, 5)))) { refl }

rule theorem swap_twice_r(w: u32): w.swap_bytes().resize(64).resize(32).swap_bytes() = w {
    let back: (w.swap_bytes().resize(64).resize(32) = w.swap_bytes()) = BitVec::resize_round_trip(32, 64, Nat::leb_sound(32, 64, trivial), w.swap_bytes());
    trans(cong_fn(λ (z: u32) => z.swap_bytes(), trans(back, BitVec::swap_bytes_32(w))),
        trans(BitVec::swap_bytes_32(w.byte_swap(4)), BitVec::byte_swap_byte_swap(4, w)))
}

theorem swap_twice_made(): swap_twice_r_rule.make([9, 1, 2, 3, 4]) =
    Some(Clause([Is(ByteSwap(32, 4, 9)), Is(Resize(32, 64, 3, 4)), Is(Resize(64, 32, 2, 3)), Is(ByteSwap(32, 1, 2))], Is(Move(32, 1, 9)))) { refl }

rule theorem within_add_r(l, r: u64, a, b, c, d: Nat, left: Range(a, b).Holds(l), right: Range(c, d).Holds(r), fits: b + d <= word_top()):
    Range(a + c, b + d).Holds(l.add(r)) {
    let high: (l.toNat() + r.toNat() <= b + d) = Nat::add_le_mono(l.toNat(), b, r.toNat(), d, left.right, right.right);
    let sum: (l.add(r).toNat() = l.toNat() + r.toNat()) = trans(BitVec::toNat_add_mod(64, l, r),
        (l.toNat() + r.toNat()).mod_of_lt(Nat::pow(2, 64), Nat::le_trans(l.toNat() + r.toNat(), b + d, word_top(), high, fits)));
    j(sym(sum), λ n _ => (a + c <= n) ∧ (n <= b + d), ⟨Nat::add_le_mono(a, l.toNat(), c, r.toNat(), left.left, right.left), high⟩)
}

theorem within_add_made(): within_add_r_rule.make([1, 2, 0, 255, 0, 255, 3]) =
    Some(Clause([Within(1, 0, 255), Within(2, 0, 255), Is(Add(64, 3, 1, 2))], Within(3, 0, 510))) { refl }

theorem within_add_guarded(): within_add_r_rule.make([1, 2, 0, 18446744073709551615, 0, 255, 3]) = None { refl }

rule theorem below_left_r(l, r: u64, b: Nat, below: BitVec::ofBool(l.unsigned_lt_bit(r)) = BitVec::ofNat(1), right: Range(0, Succ(b)).Holds(r)):
    Range(0, b).Holds(l) {
    let bit: (l.unsigned_lt_bit(r) = True) = trans(sym(BitVec::head_bit_ofBool(l.unsigned_lt_bit(r))),
        trans(cong_fn(λ (w: BitVec(1)) => w.head_bit(), below), BitVec::head_bit_ofBool(True)));
    let lt: (l.toNat() < r.toNat()) = BitVec::borrow_sub_bit_true_iff(64, l, r).mp(bit);
    ⟨trivial, Nat::le_trans(Succ(l.toNat()), r.toNat(), Succ(b), lt, right.right)⟩
}

theorem below_left_made(): below_left_r_rule.make([1, 2, 9, 3]) =
    Some(Clause([Is(UnsignedLessThan(64, 3, 1, 2)), Is(Const(1, 3, 1)), Within(2, 0, 10)], Within(1, 0, 9))) { refl }

rule theorem order_join_r(x, y, z: u64, m, n, p, q, u, v: Nat, first: x.toNat() + m <= y.toNat() + n, second: y.toNat() + p <= z.toNat() + q,
    slack: u + (n + q) <= v + (m + p)): x.toNat() + u <= z.toNat() + v {
    omega(first, second, slack)
}

theorem order_join_made(): order_join_r_rule.make([1, 2, 3, 1, 0, 0, 0, 1, 0]) = Some(Clause([AtMost(1, 1, 2, 0), AtMost(2, 0, 3, 0)], AtMost(1, 1, 3, 0))) { refl }

// With the operators written as operators.
rule theorem add_zero_op({w: Nat}, x: BitVec(w)): x + 0 = x { BitVec::add_zero(w, x) }

theorem add_zero_op_made(): add_zero_op_rule.make([64, 5, 7, 6]) = Some(Clause([Is(Const(64, 6, 0)), Is(Add(64, 7, 5, 6))], Is(Move(64, 7, 5)))) { refl }

// The library's own two (function_ir_rules), at the numbers a plan gives.
theorem library_add_zero(): add_zero_rule.make([64, 0, 2, 1]) = Some(Clause([Is(Const(64, 1, 0)), Is(Add(64, 2, 0, 1))], Is(Move(64, 2, 0)))) { refl }

theorem library_swap_twice(): swap_twice_rule.make([9, 1, 2, 3, 4]) =
    Some(Clause([Is(ByteSwap(32, 4, 9)), Is(Resize(32, 64, 3, 4)), Is(Resize(64, 32, 2, 3)), Is(ByteSwap(32, 1, 2))], Is(Move(32, 1, 9)))) { refl }

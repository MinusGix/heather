// Probes of a function that calls itself
// (`lib/native/function_ir/function_ir_recursion.hthr`): the function the
// generator lowers `if n == 0 { 0 } else { n + f(n - 1) }` to, alone in
// its program, so that its call names function 0, itself. The emitter
// refuses it under the bound it emits function 0 with today and emits it
// with its own index among its callees; its frame and call fit at every
// level from one check. Tests, not library (docs/test-value-audit.md §4.5).
import function_ir;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_calls;
import function_ir_recursion;
import x86_64;
import x86_64_asm;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

fn nodes(body: List<Node>) → StructuredRegion { Dataflow(Region(inputs := Ports([]), nodes := body, outputs := Ports([]))) }

// rsum(n) = if n == 0 { 0 } else { n + rsum(n - 1) }, function 0.
fn rsum_ir() → Function {
    Function(parameters := [0],
        body := Compose(nodes([Const(64, 1, 0)]), Compose(nodes([Equal(64, 2, 0, 1)]),
            Conditional(Ports([]), 2, Ports([]), Ports([Port(id := 9, width := 64)]),
                Compose(nodes([Const(64, 3, 0)]), nodes([Move(64, 9, 3)])),
                Compose(Compose(nodes([Const(64, 4, 1)]), Compose(nodes([Sub(64, 5, 0, 4)]),
                    Compose(Compose(Call(0, [5], 6, []), nodes([Move(64, 7, 6)])), nodes([Add(64, 8, 0, 7)])))),
                    nodes([Move(64, 9, 8)]))))),
        result := 9)
}

fn rsum_asked() → Nat { placement_slots(rsum_ir().plan()) }
fn rsum_saves() → Nat { placement_saves(rsum_ir().plan()) }

// Its code after `Start`, its calls under `bound`.
fn rsum_emit(bound: Nat) → Option<Emitted> {
    match input_file(word_ports(rsum_ir().parameters), parameter_registers()) {
        None => None,
        Some(file) => rsum_ir().emit_body(rsum_asked(), rsum_saves(), placement_short(rsum_ir().plan()), Start, 0, bound, file,
            placement_body(rsum_ir().plan()), 1, []),
    }
}

// Calling only the functions below it, as every function is emitted
// today: refused, its callee is not below it.
theorem rsum_refused_below(): rsum_emit(0).is_some() = False { refl }

// With its own index among its callees: emitted, the code a call of
// another function would get.
theorem rsum_emitted_self(): rsum_emit(1).is_some() = True { refl }

// One check: a frame of 8 bytes and the call's 24, so 32 bytes a level and
// nothing where it calls no more.
theorem rsum_frame(): rsum_ir().frame(rsum_asked(), rsum_saves()) = 8 { refl }

theorem rsum_roomy(): rsum_ir().RoomyAt(self_rooms(λ (f: Nat) => 0, 0, 0), 1, 0 + 32, rsum_asked(), rsum_saves()) {
    ⟨rsum_ir().frame(rsum_asked(), rsum_saves()).leb_sound(0 + 32, trivial),
     ⟨λ _ => (rsum_ir().frame(rsum_asked(), rsum_saves()) + 24).leb_sound(0 + 32, trivial),
      rsum_ir().body.fits_sound(self_rooms(λ (f: Nat) => 0, 0, 0), 1, (0 + 32) - rsum_ir().frame(rsum_asked(), rsum_saves()), trivial)⟩⟩
}

// So it fits at every level, its own row that level's room.
theorem rsum_roomy_level(j: Nat): rsum_ir().RoomyAt(self_rooms(λ (f: Nat) => 0, 0, level_room(0, 32, j)), 1, level_room(0, 32, j) + 32,
    rsum_asked(), rsum_saves()) {
    rsum_ir().roomy_level(λ (f: Nat) => 0, 0, 0, 32, rsum_asked(), rsum_saves(), rsum_roomy(), j)
}

// Ten levels deep it asks for 320 bytes.
theorem rsum_room_ten(): level_room(0, 32, 10) = 320 { refl }

// A room of 31 bytes a level does not hold the frame and the call.
theorem rsum_not_31(): rsum_ir().body.fits(self_rooms(λ (f: Nat) => 0, 0, 0), (0 + 31) - rsum_ir().frame(rsum_asked(), rsum_saves())) = False { refl }

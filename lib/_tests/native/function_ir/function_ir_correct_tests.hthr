// Probes of the compiler's theorem as it is stated to be read
// (function_ir_correct, docs/native/compiler-theorem.md): the names unfold
// to what `compiled_returns` states, and the theorem composes with a
// `runtime fn`'s own agreement the way a certificate composes them. The
// controls that the contract's clauses have teeth are
// function_ir_compile_tests.hthr.
import function_ir;
import function_ir_eval;
import function_ir_lower;
import function_ir_lower_calls;
import function_ir_compile;
import function_ir_correct;
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_stack;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bitvec_omega;
import bool;
import list;
import logic;
import nat;
import option;
import rt;
import rt_lower;
import runtime;
import tactic;

// ---------------------------------------------------------------------------
// The names are the statement `compile-x86` instantiates

// `Prog::Returns` is `compiled_returns`' conclusion, word for word: a
// certificate's `_returns` theorem is a `Prog::Returns` with no step.
theorem returns_is_compiled_returns<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, code: Prog,
    lowered: lower_program_roomed(functions, placement, [], rooms) = Some(code), evaluable: program_evaluable(functions).IsTrue(),
    machine: Machine<M>, origin: BitVec(64), last: List<BitVec(8)>, f: Nat, defined: f + 1 <= functions.len(),
    arguments: List<BitVec(64)>, arity: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(),
    meets: program_defined(functions, f, arguments).IsTrue(), answer: BitVec(64),
    evaluates: program_eval(functions, f, arguments) = answer):
    code.Returns(machine, origin, last, f, rooms(f), arguments, answer) {
    compiled_returns<M>(functions, placement, rooms, code, lowered, evaluable, machine.fetch, machine.data, last, origin, machine.stack,
        f, defined, arguments, arity, meets, answer, evaluates)
}

// ---------------------------------------------------------------------------
// A program of FunctionIR: sum(a, b) = a + b

fn word(id: Nat) → Port { Port(id := id, width := 64) }

fn sum() → Function {
    Function(parameters := [0, 1],
        body := Dataflow(Region(inputs := Ports([word(0), word(1)]), nodes := [Add(width := 64, output := 2, left := 0, right := 1)],
            outputs := Ports([word(2)]))),
        result := 2)
}

// A leaf that saves nothing asks for no stack below its return address:
// lowered under the table of no room, its frame is empty and it makes no
// call (`Function::roomy`).
fn leaf_rooms() → Nat → Nat { λ (_: Nat) => 0 }

// Whatever code the lowering makes of `sum`, it adds.
theorem sum_computes<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed([sum()], placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, a, b: BitVec(64)): code.Computes(machine, 0, 0, [a, b], a + b) {
    compiled_computes<M>([sum()], placement, leaf_rooms(), code, lowered, trivial, machine, 0, trivial, [a, b], trivial,
        program_total_defined([sum()], [], trivial, 0, [a, b]), a + b, refl)
}

// ---------------------------------------------------------------------------
// The room is each function's frame and its callees' below it

// `sum`, then a function calling it, then `sum` again: the last is a leaf
// and asks for what its frame asks wherever it is in the program, the
// caller for its frame, the call's 24 bytes and its callee's room.
fn twice_then_sum() → Function {
    Function(parameters := [0, 1], body := Call(0, [0, 1], 2, []), result := 2)
}

fn leaf_after_caller() → List<Function> { [sum(), twice_then_sum(), sum()] }

// The table every placement fits, each function saving all six: a leaf's
// frame of six words, the caller's of eight call slots and six.
theorem leaf_after_caller_rooms():
    (stack_room(leaf_after_caller(), 0) = 48) ∧ ((stack_room(leaf_after_caller(), 1) = 184) ∧ (stack_room(leaf_after_caller(), 2) = 48)) {
    ⟨refl, ⟨refl, refl⟩⟩
}

// The table the planner's placement asks for: neither function saves, so
// the leaves ask for nothing, and the caller, which keeps nothing across
// its call and so asks for no call slots, for the call's 24 bytes.
theorem leaf_after_caller_planned():
    (program_room_planned(leaf_after_caller())(0) = 0) ∧
        ((program_room_planned(leaf_after_caller())(1) = 24) ∧ (program_room_planned(leaf_after_caller())(2) = 0)) {
    ⟨refl, ⟨refl, refl⟩⟩
}

theorem leaf_after_caller_lowers(): lower_program_planned(leaf_after_caller()).is_some() = True { refl }

// A table the calls do not fit is refused: the caller with no room for
// its frame or its call.
theorem no_room_refused(): lower_program_roomed(leaf_after_caller(), plan_program(leaf_after_caller()), [], leaf_rooms()).is_some() = False {
    refl
}

// And one that leaves the caller its frame but not its callee's room.
theorem callee_room_refused():
    lower_program_roomed(leaf_after_caller(), plan_program(leaf_after_caller()), [], λ (f: Nat) => match f { Zero => 8, Succ(_) => 24 }).is_some() = False {
    refl
}

// ---------------------------------------------------------------------------
// A `runtime fn`, as `compile-x86` takes one

runtime fn clamp(x, lo, hi: u64) → u64 {
    if x < lo {
        lo
    } else if hi < x {
        hi
    } else {
        x
    }
}

theorem clamp_within(x: u64, {lo, hi: u64}, ordered: lo <= hi): lo <= clamp(x, lo, hi) ∧ clamp(x, lo, hi) <= hi {
    split_all; all_goals { bv_omega }
}

// The certificate's theorem, from the generator's agreement and the
// compiler's: the code of `clamp`'s program computes `clamp`. A
// certificate has the lowering as a literal checked by evaluation; here
// it is any.
theorem clamp_computes<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed(clamp::program, placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, x, lo, hi: u64): code.Computes(machine, 0, 0, [x, lo, hi], clamp(x, lo, hi)) {
    compiled_computes<M>(clamp::program, placement, leaf_rooms(), code, lowered, trivial, machine, 0, trivial, [x, lo, hi], trivial,
        program_total_defined(clamp::program, [], trivial, 0, [x, lo, hi]), clamp(x, lo, hi), clamp::agrees(x, lo, hi))
}

// So a fact about the source function is a fact about what the machine
// returns: for ordered bounds, the code returns a word within them.
theorem clamp_code_within<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed(clamp::program, placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, x: u64, {lo, hi: u64}, ordered: lo <= hi):
    Exists<u64>(λ v => code.Computes(machine, 0, 0, [x, lo, hi], v) ∧ ((lo <= v) ∧ (v <= hi))) {
    Exists(clamp(x, lo, hi), ⟨clamp_computes<M>(placement, code, lowered, machine, x, lo, hi), clamp_within(x, ordered)⟩)
}

// One statement for every argument list: the code of `clamp`'s program
// implements `clamp`. Unfolded, `Implements` is the binders the theorem
// above takes, so its proof is `clamp_computes` under them.
theorem clamp_implements<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed(clamp::program, placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>): code.Implements(machine, 0, 0, 3, clamp) {
    λ x lo hi => clamp_computes<M>(placement, code, lowered, machine, x, lo, hi)
}

// And back at any three words.
theorem clamp_implements_at<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed(clamp::program, placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, x, lo, hi: u64): code.Computes(machine, 0, 0, [x, lo, hi], clamp(x, lo, hi)) {
    code.implements_at(machine, 0, 0, 3, clamp, clamp_implements<M>(placement, code, lowered, machine), [x, lo, hi], refl)
}

// `compiled_implements` from an agreement at every list of two words.
theorem sum_agrees(words: List<BitVec(64)>, length: words.len() = 2):
    program_eval([sum()], 0, words) = apply_words(2, λ (a: BitVec(64)) (b: BitVec(64)) => a + b, words) {
    spread(2, λ (ws: List<BitVec(64)>) => program_eval([sum()], 0, ws) = apply_words(2, λ (a: BitVec(64)) (b: BitVec(64)) => a + b, ws),
        λ a b => refl, words, length)
}

theorem sum_implements<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed([sum()], placement, [], leaf_rooms()) = Some(code), machine: Machine<M>):
    code.Implements(machine, 0, 0, 2, λ (a: BitVec(64)) (b: BitVec(64)) => a + b) {
    compiled_implements<M>([sum()], placement, leaf_rooms(), code, lowered, trivial, machine, 0, trivial, 2, trivial, λ (a: BitVec(64)) (b: BitVec(64)) => a + b,
        λ words _ => program_total_defined([sum()], [], trivial, 0, words), sum_agrees)
}

// A function of words is a function of spans lent nothing, and back.
theorem sum_over_none<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed([sum()], placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, a, b: BitVec(64), top: Nat):
    code.ComputesOver(machine, top, Lending::none(), 0, 0, [a, b], [], Ending(word := a + b, buffers := [])) {
    code.computes_over_none(machine, 0, 0, [a, b], a + b, sum_computes<M>(placement, code, lowered, machine, a, b), top)
}

theorem sum_back<M>(placement: List<Place>, code: Prog, lowered: lower_program_roomed([sum()], placement, [], leaf_rooms()) = Some(code),
    machine: Machine<M>, a, b: BitVec(64)): code.Computes(machine, 0, 0, [a, b], a + b) {
    code.computes_of_over_none(machine, 0, 0, [a, b], a + b, sum_over_none<M>(placement, code, lowered, machine, a, b, machine.stack.size))
}

// Probes of the function compiler reading and writing a lent buffer
// (function_ir_lower_reads; docs/native/native-one-compiler-design.md §2.3, U3,
// and §2.6, U4): a byte read under the comparison that bounds it, a loop
// over a buffer, a call that hands its buffer on, a byte stored under its
// bound, a loop that rewrites a buffer, and what is refused. Each
// program's code is computed by evaluation, and its claim is the one
// theorem (`lower_program_lent_correct`) instantiated, whatever the
// buffers hold and wherever the lending laws let them lie (`Loan`,
// x86_64_lending): the file is threaded, so a function is called over the
// file as it is then (docs/native/native-one-compiler-design.md §2.6).
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import function_ir_compile;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_stack;
import x86_64_lending;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

fn word(id: Nat) → Port { Port(id := id, width := 64) }
fn bit(id: Nat) → Port { Port(id := id, width := 1) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

fn Prog::put(self p: Prog, item: Asm) → Prog { At(p, 0, item) }
fn Prog::label(self p: Prog, name: Nat) → Prog { At(p, name, Block([])) }

// ---------------------------------------------------------------------------
// One byte, under its bound

// byte_at(buffer, i): the byte at `i`, or 256 past the end. The buffer is
// the function's first two parameters, its address and its length; the
// load is in the arm the comparison `i < length` guards.
fn byte_at() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(2)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [BufferLoad(output := 4, buffer := 0, index := 2)],
                    outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}

// The meaning reads the buffer it is called over, by number: the words
// that say where it lies are not read as addresses.
fn abc() → Buffers() { [[b(97), b(98), b(99)]] }
theorem byte_at_evaluable(): program_evaluable([byte_at()]).IsTrue() { trivial }
theorem byte_at_reads(): program_eval_over(abc(), [byte_at()], 0, [w(4096), w(3), w(1)]) = w(98) { refl }
theorem byte_at_past(): program_eval_over(abc(), [byte_at()], 0, [w(4096), w(3), w(3)]) = w(256) { refl }

// The address formed in RAX, the byte loaded over it.
fn byte_at_program() → Prog {
    Start
        .label(1).put(Block([]))
        .put(Block([]))
        .put(Block([CmpRR(Rdx, Rsi)])).put(Jcc(AE, 2))
        .put(Block([MovRR(Rax, Rdi), AddRR(Rax, Rdx)])).put(LoadByte(ByteLoad(Rax, Rax))).put(Jmp(3))
        .label(2).put(Block([MovRI32(Rax, BitVec::ofNat(256))]))
        .label(3)
        .put(Block([])).put(Block([])).put(Ret)
}

theorem byte_at_planned(): plan_program([byte_at()]) = [Folded, Into(Rax), Into(Rax)] { refl }
theorem byte_at_lowers(): lower_program_lent([byte_at()], plan_program([byte_at()]), [1]) = Some(byte_at_program()) { refl }

// Called with the buffer lent, its address and length the first two
// arguments, the function returns what its meaning says over the file and
// leaves the file its meaning says in memory.
theorem byte_at_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, buffers).spans())):
    Site<M>(fetch, data, byte_at_program(), last, origin).CallsOver(stack, program_effects([byte_at()]), program_room([byte_at()]), 1,
        Lending::reading([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([byte_at()], plan_program([byte_at()]), Lending::reading([1], addresses, buffers), byte_at_program(),
        byte_at_lowers(), fetch, data, last, origin, stack, top, loan, trivial,
        λ b stores => false_elim(program_quiet_stores([byte_at()], b, trivial, stores)))
}

// ---------------------------------------------------------------------------
// A loop over a buffer

// sum(buffer): its bytes added. The loop's state is the buffer's home,
// the index and the sum; a pass hands the home on as it came, which is
// what lets the body read through it (`loop_carried`).
fn sum() → Function {
    Function(parameters := [0, 1], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1)]),
                nodes := [Const(width := 64, output := 2, value := 0), Const(width := 64, output := 3, value := 0)],
                outputs := Ports([word(0), word(1), word(2), word(3)])),
            Loop(inputs := [0, 1, 2, 3], bound := 1, parameters := [10, 11, 12, 13], count := 14,
                body := Sequence(
                    Region(inputs := Ports([word(10), word(11), word(12), word(13), word(14)]),
                        nodes := [UnsignedLessThan(width := 64, output := 20, left := 14, right := 14),
                            UnsignedLessThan(width := 64, output := 15, left := 12, right := 11)],
                        outputs := Ports([word(10), word(11), word(12), word(13), bit(20), bit(15)])),
                    Conditional(Ports([word(10), word(11), word(12), word(13), bit(20), bit(15)]), 15, Ports([word(12), word(13)]),
                        Ports([word(16), word(17)]),
                        Sequence(
                            Region(inputs := Ports([word(12), word(13)]), nodes := [BufferLoad(output := 18, buffer := 0, index := 12)],
                                outputs := Ports([word(12), word(13), word(18)])),
                            Dataflow(Region(inputs := Ports([word(12), word(13), word(18)]),
                                nodes := [Add(width := 64, output := 16, left := 13, right := 18),
                                    Const(width := 64, output := 19, value := 1),
                                    Add(width := 64, output := 17, left := 12, right := 19)],
                                outputs := Ports([word(16), word(17)])))),
                        Dataflow(Region(inputs := Ports([word(12), word(13)]),
                            nodes := [Move(width := 64, output := 16, source := 13), Move(width := 64, output := 17, source := 12)],
                            outputs := Ports([word(16), word(17)]))))),
                exit := 20, next := [10, 11, 17, 16], outputs := [4, 5, 6, 7], exhausted := 8)),
        result := 7)
}

theorem sum_evaluable(): program_evaluable([sum()]).IsTrue() { trivial }
theorem sum_runs(): program_eval_over(abc(), [sum()], 0, [w(4096), w(3)]) = w(294) { refl }
theorem sum_of_none(): program_eval_over([[]], [sum()], 0, [w(4096), w(0)]) = w(0) { refl }

theorem sum_present(): lower_program_lent([sum()], plan_program([sum()]), [1]).is_some().IsTrue() { trivial }
fn sum_program() → Prog { lower_program_lent([sum()], plan_program([sum()]), [1]).get(sum_present()) }
theorem sum_lowers(): lower_program_lent([sum()], plan_program([sum()]), [1]) = Some(sum_program()) {
    Option::some_get(lower_program_lent([sum()], plan_program([sum()]), [1]), sum_present())
}

theorem sum_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, buffers).spans())):
    Site<M>(fetch, data, sum_program(), last, origin).CallsOver(stack, program_effects([sum()]), program_room([sum()]), 1,
        Lending::reading([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([sum()], plan_program([sum()]), Lending::reading([1], addresses, buffers), sum_program(), sum_lowers(),
        fetch, data, last, origin, stack, top, loan, trivial, λ b stores => false_elim(program_quiet_stores([sum()], b, trivial, stores)))
}

// What a caller cites (`compiled_returns_lent`): over a buffer that holds
// "abc", lent wherever the laws let it lie, the code returns 294 and
// leaves "abc" in memory.
theorem sum_of_abc<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, abc()).spans())):
    Site<M>(fetch, data, sum_program(), last, origin).Returns(stack, asm_labels(sum_program())(1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3)], i, s) ∧ 48 <= i) ∧
            stack.LentOver(Lending::reading([1], addresses, abc()), top, 0, [a, w(3)], abc())(i, s),
        stack.AnsweredBoth(Lending::reading([1], addresses, abc()), w(294), [], abc())) {
    compiled_returns_lent<M>([sum()], plan_program([sum()]), program_room([sum()]), Lending::reading([1], addresses, abc()), sum_program(), sum_lowers(),
        sum_evaluable(), trivial, fetch, data, last, origin, stack, top, loan, 0, trivial, [a, w(3)], trivial, abc(),
        program_total_defined([sum()], abc(), trivial, 0, [a, w(3)]), w(294), refl)
}

// The file is the one in memory at the call, not the one the lending was
// made over: the lending fixes each buffer's length and nothing else. Over
// "abc" lent and "ABC" there now, the code returns the sum of "ABC".
fn upper() → Buffers() { [[b(65), b(66), b(67)]] }
theorem sum_of_now<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, abc()).spans())):
    Site<M>(fetch, data, sum_program(), last, origin).Returns(stack, asm_labels(sum_program())(1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3)], i, s) ∧ 48 <= i) ∧
            stack.LentOver(Lending::reading([1], addresses, abc()), top, 0, [a, w(3)], upper())(i, s),
        stack.AnsweredBoth(Lending::reading([1], addresses, abc()), w(198), [], upper())) {
    compiled_returns_lent<M>([sum()], plan_program([sum()]), program_room([sum()]), Lending::reading([1], addresses, abc()), sum_program(), sum_lowers(),
        sum_evaluable(), trivial, fetch, data, last, origin, stack, top, loan, 0, trivial, [a, w(3)], trivial, upper(),
        program_total_defined([sum()], upper(), trivial, 0, [a, w(3)]), w(198), refl)
}

// ---------------------------------------------------------------------------
// A call hands the buffer on

// first(buffer) = byte_at(buffer, 0): the callee takes the caller's home
// as its own first arguments.
fn first() → Function {
    Function(parameters := [0, 1], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1)]), nodes := [Const(width := 64, output := 2, value := 0)],
                outputs := Ports([word(0), word(1), word(2)])),
            Call(0, [0, 1, 2], 3, [])),
        result := 3)
}

fn firsts() → List<Function> { [first(), byte_at()] }

theorem firsts_evaluable(): program_evaluable(firsts()).IsTrue() { trivial }
theorem first_runs(): program_eval_over(abc(), firsts(), 1, [w(4096), w(3)]) = w(97) { refl }
theorem firsts_counts(): program_counts(firsts()) = [1, 1] { refl }

theorem firsts_present(): lower_program_lent(firsts(), plan_program(firsts()), [1, 1]).is_some().IsTrue() { trivial }
fn firsts_program() → Prog { lower_program_lent(firsts(), plan_program(firsts()), [1, 1]).get(firsts_present()) }
theorem firsts_lowers(): lower_program_lent(firsts(), plan_program(firsts()), [1, 1]) = Some(firsts_program()) {
    Option::some_get(lower_program_lent(firsts(), plan_program(firsts()), [1, 1]), firsts_present())
}

theorem firsts_call<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1, 1], addresses, buffers).spans())):
    Site<M>(fetch, data, firsts_program(), last, origin).CallsOver(stack, program_effects(firsts()), program_room(firsts()), 2,
        Lending::reading([1, 1], addresses, buffers), top) {
    lower_program_lent_correct<M>(firsts(), plan_program(firsts()), Lending::reading([1, 1], addresses, buffers), firsts_program(),
        firsts_lowers(), fetch, data, last, origin, stack, top, loan, trivial,
        λ b stores => false_elim(program_quiet_stores(firsts(), b, trivial, stores)))
}

// ---------------------------------------------------------------------------
// One byte stored, under its bound

// put_at(buffer, i, v): `v`'s low byte stored at `i`, returning the byte
// then there, or 256 past the end with nothing stored. The store is in the
// arm the comparison `i < length` guards, as a load is.
fn put_at() → Function {
    Function(parameters := [0, 1, 2, 5], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2), word(5)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), word(5), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), word(5), bit(3)]), 3, Ports([word(0), word(2), word(5)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]),
                    nodes := [BufferStore(output := 4, buffer := 0, index := 2, value := 5)], outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}

// The buffer it stores into is read off the program.
theorem put_at_stores(): program_stores([put_at()], 0) = True { refl }
theorem put_at_spares(): program_stores([put_at()], 1) = False { refl }

// The address formed in RAX, the low byte of RCX stored over it and the
// byte then there loaded back, which is what the store's output names.
fn put_at_program() → Prog {
    Start
        .label(1).put(Block([]))
        .put(Block([]))
        .put(Block([CmpRR(Rdx, Rsi)])).put(Jcc(AE, 2))
        .put(Block([MovRR(Rax, Rdi), AddRR(Rax, Rdx)])).put(StoreByte(ByteStore(Rax, Rcx))).put(LoadByte(ByteLoad(Rax, Rax))).put(Jmp(3))
        .label(2).put(Block([MovRI32(Rax, BitVec::ofNat(256))]))
        .label(3)
        .put(Block([])).put(Block([])).put(Ret)
}

theorem put_at_planned(): plan_program([put_at()]) = [Folded, Into(Rax), Into(Rax)] { refl }
theorem put_at_lowers(): lower_program_lent([put_at()], plan_program([put_at()]), [1]) = Some(put_at_program()) { refl }

// A lending with buffer 0 to be written.
fn writing(counts: List<Nat>, addresses: List<BitVec(64)>, buffers: Buffers()) → Lending {
    Lending(counts, addresses, buffers, λ (b: Nat) => b.same(0))
}

theorem put_at_allowed(lending: Lending, written: lending.written(0) = True):
    (b: Nat) → program_stores([put_at()], b).IsTrue() → lending.written(b) = True {
    λ b => match b { Zero => λ _ => written, Succ(_) => λ no => false_elim(no) }
}

// Called with the buffer lent to be written, the function returns a result
// and leaves a file its meaning says it may, whatever the buffers hold.
theorem put_at_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, buffers).spans())):
    Site<M>(fetch, data, put_at_program(), last, origin).CallsOver(stack, program_effects([put_at()]), program_room([put_at()]), 1,
        writing([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([put_at()], plan_program([put_at()]), writing([1], addresses, buffers), put_at_program(),
        put_at_lowers(), fetch, data, last, origin, stack, top, loan, trivial, put_at_allowed(writing([1], addresses, buffers), refl))
}

// What it returns and leaves is computed (`program_run`,
// function_ir_run): over "abc", 'X' put at 1 returns 'X' and leaves "aXc",
// and past the end it returns 256 and leaves the file.
fn axc() → Buffers() { [[b(97), b(88), b(99)]] }
theorem put_at_evaluable(): program_evaluable([put_at()]).IsTrue() { trivial }
theorem put_at_runs(a: BitVec(64)): program_run([put_at()], abc(), 0, [a, w(3), w(1), w(88)]) = Ending(w(88), axc()) { refl }
theorem put_at_past(a: BitVec(64)): program_run([put_at()], abc(), 0, [a, w(3), w(3), w(88)]) = Ending(w(256), abc()) { refl }

// So the code, over "abc" lent to be written wherever the laws let it lie:
// it returns 'X', and "aXc" is the file in memory.
theorem put_at_x<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, abc()).spans())):
    Site<M>(fetch, data, put_at_program(), last, origin).Returns(stack, asm_labels(put_at_program())(1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3), w(1), w(88)], i, s) ∧ 48 <= i) ∧
            stack.LentOver(writing([1], addresses, abc()), top, 0, [a, w(3), w(1), w(88)], abc())(i, s),
        stack.AnsweredBoth(writing([1], addresses, abc()), w(88), [], axc())) {
    compiled_returns_run<M>([put_at()], plan_program([put_at()]), program_room([put_at()]), writing([1], addresses, abc()), put_at_program(), put_at_lowers(),
        put_at_evaluable(), trivial, put_at_allowed(writing([1], addresses, abc()), refl), fetch, data, last, origin, stack, top, loan, 0, trivial,
        [a, w(3), w(1), w(88)], trivial, abc(),
        program_total_run_defined([put_at()], trivial, abc(), 0, [a, w(3), w(1), w(88)]), Ending(w(88), axc()), put_at_runs(a))
}

// A lending to read does not let it be called: the theorem asks that the
// buffer it stores into is lent to be written.
// expect-error(kernel): the kernel rejected `put_at_read_only`: NotConvertible
theorem put_at_read_only<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, buffers).spans())):
    Site<M>(fetch, data, put_at_program(), last, origin).CallsOver(stack, program_effects([put_at()]), program_room([put_at()]), 1,
        Lending::reading([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([put_at()], plan_program([put_at()]), Lending::reading([1], addresses, buffers), put_at_program(),
        put_at_lowers(), fetch, data, last, origin, stack, top, loan, trivial, put_at_allowed(Lending::reading([1], addresses, buffers), refl))
}

// ---------------------------------------------------------------------------
// A loop that rewrites a buffer

// bump(buffer): every byte one more, returning how many. A pass loads the
// byte at the index, adds one and stores it back, under the one comparison
// that bounds both.
fn bump() → Function {
    Function(parameters := [0, 1], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1)]), nodes := [Const(width := 64, output := 2, value := 0)],
                outputs := Ports([word(0), word(1), word(2)])),
            Loop(inputs := [0, 1, 2], bound := 1, parameters := [10, 11, 12], count := 14,
                body := Sequence(
                    Region(inputs := Ports([word(10), word(11), word(12), word(14)]),
                        nodes := [UnsignedLessThan(width := 64, output := 20, left := 14, right := 14),
                            UnsignedLessThan(width := 64, output := 15, left := 12, right := 11)],
                        outputs := Ports([word(10), word(11), word(12), bit(20), bit(15)])),
                    Conditional(Ports([word(10), word(11), word(12), bit(20), bit(15)]), 15, Ports([word(12)]), Ports([word(17)]),
                        Sequence(
                            Region(inputs := Ports([word(12)]), nodes := [BufferLoad(output := 18, buffer := 0, index := 12)],
                                outputs := Ports([word(12), word(18)])),
                            Sequence(
                                Region(inputs := Ports([word(12), word(18)]),
                                    nodes := [Const(width := 64, output := 19, value := 1), Add(width := 64, output := 21, left := 18, right := 19)],
                                    outputs := Ports([word(12), word(19), word(21)])),
                                Sequence(
                                    Region(inputs := Ports([word(12), word(19), word(21)]),
                                        nodes := [BufferStore(output := 22, buffer := 0, index := 12, value := 21)],
                                        outputs := Ports([word(12), word(19)])),
                                    Dataflow(Region(inputs := Ports([word(12), word(19)]),
                                        nodes := [Add(width := 64, output := 17, left := 12, right := 19)], outputs := Ports([word(17)])))))),
                        Dataflow(Region(inputs := Ports([word(12)]), nodes := [Move(width := 64, output := 17, source := 12)],
                            outputs := Ports([word(17)]))))),
                exit := 20, next := [10, 11, 17], outputs := [4, 5, 6], exhausted := 8)),
        result := 6)
}

// The function compiler takes it: the loop carries the home, and the load
// and the store of a pass are each under the pass's comparison.
theorem bump_present(): lower_program_lent([bump()], plan_program([bump()]), [1]).is_some().IsTrue() { trivial }
fn bump_program() → Prog { lower_program_lent([bump()], plan_program([bump()]), [1]).get(bump_present()) }
theorem bump_lowers(): lower_program_lent([bump()], plan_program([bump()]), [1]) = Some(bump_program()) {
    Option::some_get(lower_program_lent([bump()], plan_program([bump()]), [1]), bump_present())
}

theorem bump_allowed(lending: Lending, written: lending.written(0) = True):
    (b: Nat) → program_stores([bump()], b).IsTrue() → lending.written(b) = True {
    λ b => match b { Zero => λ _ => written, Succ(_) => λ no => false_elim(no) }
}

// And its code meets the contract over the file, whatever the buffer
// holds: what it returns and leaves is what the meaning says it may.
theorem bump_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, buffers).spans())):
    Site<M>(fetch, data, bump_program(), last, origin).CallsOver(stack, program_effects([bump()]), program_room([bump()]), 1,
        writing([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([bump()], plan_program([bump()]), writing([1], addresses, buffers), bump_program(),
        bump_lowers(), fetch, data, last, origin, stack, top, loan, trivial, bump_allowed(writing([1], addresses, buffers), refl))
}

// By evaluation it turns "abc" into "bcd" and returns 3, and so does the
// code, over "abc" lent to be written.
fn bcd() → Buffers() { [[b(98), b(99), b(100)]] }
theorem bump_evaluable(): program_evaluable([bump()]).IsTrue() { trivial }
theorem bump_runs(a: BitVec(64)): program_run([bump()], abc(), 0, [a, w(3)]) = Ending(w(3), bcd()) { refl }
theorem bump_of_none(a: BitVec(64)): program_run([bump()], [[]], 0, [a, w(0)]) = Ending(w(0), [[]]) { refl }

theorem bump_of_abc<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, abc()).spans())):
    Site<M>(fetch, data, bump_program(), last, origin).Returns(stack, asm_labels(bump_program())(1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3)], i, s) ∧ 48 <= i) ∧
            stack.LentOver(writing([1], addresses, abc()), top, 0, [a, w(3)], abc())(i, s),
        stack.AnsweredBoth(writing([1], addresses, abc()), w(3), [], bcd())) {
    compiled_returns_run<M>([bump()], plan_program([bump()]), program_room([bump()]), writing([1], addresses, abc()), bump_program(), bump_lowers(),
        bump_evaluable(), trivial, bump_allowed(writing([1], addresses, abc()), refl), fetch, data, last, origin, stack, top, loan, 0, trivial,
        [a, w(3)], trivial, abc(),
        program_total_run_defined([bump()], trivial, abc(), 0, [a, w(3)]), Ending(w(3), bcd()), bump_runs(a))
}

// ---------------------------------------------------------------------------
// What is refused

// A store no comparison bounds.
fn storing() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Dataflow(Region(inputs := Ports([word(0), word(1), word(2)]),
            nodes := [BufferStore(output := 3, buffer := 0, index := 2, value := 2)], outputs := Ports([word(3)]))),
        result := 3)
}
theorem storing_refused(): lower_program_lent([storing()], [Into(Rax)], [1]) = None { refl }

// A store whose output has no register: the code names the byte then
// there in one.
theorem store_folded_refused(): lower_program_lent([put_at()], [Folded, Folded, Into(Rax)], [1]) = None { refl }

// A store through the entry for programs that lend nothing: with no home,
// no store lowers.
fn homeless() → Function {
    Function(parameters := [0, 1, 2, 5], body := put_at().body, result := 4)
}
theorem homeless_refused(): lower_program([homeless()], [Folded, Into(Rax), Into(Rax)]) = None { refl }

// A store into a buffer the function was not lent: it takes one, and
// stores into buffer 1.
fn other_store() → Function {
    Function(parameters := [0, 1, 2, 5], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2), word(5)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), word(5), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), word(5), bit(3)]), 3, Ports([word(0), word(2), word(5)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]),
                    nodes := [BufferStore(output := 4, buffer := 1, index := 2, value := 5)], outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem other_store_refused(): lower_program_lent([other_store()], [Folded, Into(Rax), Into(Rax)], [1]) = None { refl }

// A store of a value no register holds: the word 9 is nothing the function
// was given or computed.
fn valueless() → Function {
    Function(parameters := [0, 1, 2, 5], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2), word(5)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), word(5), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), word(5), bit(3)]), 3, Ports([word(0), word(2), word(5)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]),
                    nodes := [BufferStore(output := 4, buffer := 0, index := 2, value := 9)], outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2), word(5)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem valueless_refused(): lower_program_lent([valueless()], [Folded, Into(Rax), Into(Rax)], [1]) = None { refl }

// A load no comparison bounds.
fn unguarded() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Dataflow(Region(inputs := Ports([word(0), word(1), word(2)]),
            nodes := [BufferLoad(output := 3, buffer := 0, index := 2)], outputs := Ports([word(3)]))),
        result := 3)
}
theorem unguarded_refused(): lower_program_lent([unguarded()], [Into(Rax)], [1]) = None { refl }

// A comparison against a word that is not the buffer's length.
fn wrong_bound() → Function {
    Function(parameters := [0, 1, 2, 5], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2), word(5)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 5)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(2)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [BufferLoad(output := 4, buffer := 0, index := 2)],
                    outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem wrong_bound_refused(): lower_program_lent([wrong_bound()], [Folded, Into(Rax), Into(Rax)], [1]) = None { refl }

// The load in the arm where the comparison failed.
fn wrong_arm() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(2)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [BufferLoad(output := 4, buffer := 0, index := 2)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem wrong_arm_refused(): lower_program_lent([wrong_arm()], [Folded, Into(Rax), Into(Rax)], [1]) = None { refl }

// A buffer the function was not lent: it takes one, and reads buffer 1.
fn other_buffer() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(2)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [BufferLoad(output := 4, buffer := 1, index := 2)],
                    outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(2)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem other_buffer_refused(): lower_program_lent([other_buffer()], [Folded, Into(Rax), Into(Rax)], [1]) = None { refl }

// The program's table and the function disagree on how many it takes: the
// same function under a table that says none, and through the entry for
// programs that lend nothing.
theorem miscounted_refused(): lower_program_lent([byte_at()], plan_program([byte_at()]), [0]) = None { refl }
theorem unlent_refused(): lower_program([byte_at()], plan_program([byte_at()])) = None { refl }

// A call whose first arguments are not the callee's buffer's home: the
// words in the other order.
fn swapped() → Function {
    Function(parameters := [0, 1], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1)]), nodes := [Const(width := 64, output := 2, value := 0)],
                outputs := Ports([word(0), word(1), word(2)])),
            Call(0, [1, 0, 2], 3, [])),
        result := 3)
}
theorem swapped_refused(): lower_program_lent([swapped(), byte_at()], plan_program([swapped(), byte_at()]), [1, 1]) = None { refl }

// A loop whose passes change the word the buffer's address is in does not
// carry the home, so the load inside has none.
fn drifting() → Function {
    Function(parameters := [0, 1], lent := 1,
        body := Loop(inputs := [0, 1], bound := 1, parameters := [10, 11], count := 14,
            body := Sequence(
                Region(inputs := Ports([word(10), word(11), word(14)]),
                    nodes := [UnsignedLessThan(width := 64, output := 20, left := 14, right := 14),
                        UnsignedLessThan(width := 64, output := 15, left := 11, right := 11)],
                    outputs := Ports([word(10), word(11), bit(20), bit(15)])),
                Conditional(Ports([word(10), word(11), bit(20), bit(15)]), 15, Ports([word(10), word(11)]), Ports([word(16)]),
                    Sequence(
                        Region(inputs := Ports([word(10), word(11)]), nodes := [BufferLoad(output := 18, buffer := 0, index := 11)],
                            outputs := Ports([word(10), word(18)])),
                        Dataflow(Region(inputs := Ports([word(10), word(18)]),
                            nodes := [Add(width := 64, output := 16, left := 10, right := 18)], outputs := Ports([word(16)])))),
                    Dataflow(Region(inputs := Ports([word(10), word(11)]), nodes := [Move(width := 64, output := 16, source := 10)],
                        outputs := Ports([word(16)]))))),
            exit := 20, next := [16, 11], outputs := [4, 5], exhausted := 8),
        result := 4)
}
theorem drifting_carries_nothing(): loop_carried(drifting().homes(), [0, 1], [10, 11], [16, 11]) = [] { refl }
theorem drifting_refused(): lower_program_lent([drifting()], plan_program([drifting()]), [1]) = None { refl }

// ---------------------------------------------------------------------------
// What a false arm knows (docs/native/native-library-exports-design.md §3.1, V3)

// The file of an arm taken where the bit 2, `1 below 0`, is clear: value 0
// is at most value 1. Whatever else the file holds.
fn in_false_arm(file: File) → File { file.know(Compared(2, function_ir_lower::Below, 1, 0)).know(Falsity(2)) }

theorem false_arm_at_most(file: File): in_false_arm(file).at_most(0, 1) = True { refl }

// And it is so of the words, at any valuation the file represents.
theorem false_arm_orders(file: File, values: Valuation(), gprs: Gprs, represents: in_false_arm(file).Represents(values, gprs)):
    values(64, 0).toNat() <= values(64, 1).toNat() {
    in_false_arm(file).at_most_sound(values, gprs, 0, 1, represents, trivial)
}

// The controls. The other order is not known; the arm taken where the bit
// is set knows no such thing, and its own fact (`bounded`) is not a false
// arm's; a clear signed comparison says nothing of the unsigned order.
theorem false_arm_not_the_other_way(): in_false_arm(File::empty()).at_most(1, 0) = False { refl }
theorem true_arm_not_at_most():
    File::empty().know(Compared(2, function_ir_lower::Below, 1, 0)).know(Truth(2)).at_most(0, 1) = False { refl }
theorem false_arm_not_bounded(): in_false_arm(File::empty()).bounded(1, 0) = False { refl }
theorem signed_says_nothing(): File::empty().know(Compared(2, function_ir_lower::Less, 1, 0)).know(Falsity(2)).at_most(0, 1) = False { refl }

// A load in the arm taken where `index below length` is clear is refused as
// before: a false arm's fact admits no load.
fn load_in_false_arm() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2)]), nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(1), word(2)]), Ports([word(4)]),
                Dataflow(Region(inputs := Ports([word(0), word(1), word(2)]), nodes := [Const(width := 64, output := 4, value := 256)],
                    outputs := Ports([word(4)]))),
                Dataflow(Region(inputs := Ports([word(0), word(1), word(2)]), nodes := [BufferLoad(output := 4, buffer := 0, index := 2)],
                    outputs := Ports([word(4)]))))),
        result := 4)
}
theorem load_in_false_arm_refused(): lower_program_lent([load_in_false_arm()], plan_program([load_in_false_arm()]), [1]) = None { refl }

// ---------------------------------------------------------------------------
// What each function needs written
//
// One list of marks for a program asks every caller for every buffer some
// function stores into. A function at a time (`ProgramNeeds`, as rows by
// `program_marked`), a function that only reads is called under a lending
// to read, whatever the functions beside it store
// (docs/native/native-library-exports-design.md §3.1).

// `byte_at` beside `put_at`: function 1 reads its buffer, function 0
// stores into its own.
fn beside() → List<Function> { [byte_at(), put_at()] }
fn beside_rows() → List<List<Bool>> { [[True], []] }

theorem beside_marked(): program_marked(beside(), beside_rows()) = True { refl }
theorem beside_unmarked(): program_marked(beside(), [[], []]) = False { refl }
theorem beside_no_one_list(): program_stores_within(beside(), []) = False { refl }

theorem beside_present(): lower_program_lent(beside(), plan_program(beside()), [1, 1]).is_some().IsTrue() { trivial }
fn beside_program() → Prog { lower_program_lent(beside(), plan_program(beside()), [1, 1]).get(beside_present()) }
theorem beside_lowers(): lower_program_lent(beside(), plan_program(beside()), [1, 1]) = Some(beside_program()) {
    Option::some_get(lower_program_lent(beside(), plan_program(beside()), [1, 1]), beside_present())
}

// The reader, under a lending that lets nothing be written.
theorem beside_reads<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1, 1], addresses, buffers).spans()),
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    Site<M>(fetch, data, beside_program(), last, origin).Returns(stack, asm_labels(beside_program())(2),
        stack.CalledOver(program_effects(beside()), program_room(beside()), Lending::reading([1, 1], addresses, buffers), top, 1, arguments, result, rest, before, after),
        stack.AnsweredBoth(Lending::reading([1, 1], addresses, buffers), result, rest, after)) {
    lower_program_lent_needs<M>(beside(), plan_program(beside()), [1, 1], beside_program(), beside_lowers(),
        λ (f: Nat) (b: Nat) => marked(marks_row(beside_rows(), f), b), program_marked_needs(beside(), beside_rows(), trivial),
        fetch, data, last, origin, stack, top)(Lending::reading([1, 1], addresses, buffers), refl, loan, 1, trivial,
        λ b need => false_elim(need), arguments, result, rest, before, after)
}

// The storer, under one that lets its buffer be written.
theorem beside_stores<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1, 1], addresses, buffers).spans()),
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    Site<M>(fetch, data, beside_program(), last, origin).Returns(stack, asm_labels(beside_program())(1),
        stack.CalledOver(program_effects(beside()), program_room(beside()), writing([1, 1], addresses, buffers), top, 0, arguments, result, rest, before, after),
        stack.AnsweredBoth(writing([1, 1], addresses, buffers), result, rest, after)) {
    lower_program_lent_needs<M>(beside(), plan_program(beside()), [1, 1], beside_program(), beside_lowers(),
        λ (f: Nat) (b: Nat) => marked(marks_row(beside_rows(), f), b), program_marked_needs(beside(), beside_rows(), trivial),
        fetch, data, last, origin, stack, top)(writing([1, 1], addresses, buffers), refl, loan, 0, trivial,
        λ b => match b { Zero => λ _ => refl, Succ(_) => λ no => false_elim(no) }, arguments, result, rest, before, after)
}

// The control: under the lending to read the storer has no such theorem.
// Its row asks for buffer 0, which that lending does not let be written.
// expect-error(kernel): the kernel rejected `beside_stores_read_only`: NotConvertible
theorem beside_stores_read_only<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1, 1], addresses, buffers).spans()),
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    Site<M>(fetch, data, beside_program(), last, origin).Returns(stack, asm_labels(beside_program())(1),
        stack.CalledOver(program_effects(beside()), program_room(beside()), Lending::reading([1, 1], addresses, buffers), top, 0, arguments, result, rest, before, after),
        stack.AnsweredBoth(Lending::reading([1, 1], addresses, buffers), result, rest, after)) {
    lower_program_lent_needs<M>(beside(), plan_program(beside()), [1, 1], beside_program(), beside_lowers(),
        λ (f: Nat) (b: Nat) => marked(marks_row(beside_rows(), f), b), program_marked_needs(beside(), beside_rows(), trivial),
        fetch, data, last, origin, stack, top)(Lending::reading([1, 1], addresses, buffers), refl, loan, 0, trivial,
        λ b => match b { Zero => λ _ => refl, Succ(_) => λ no => false_elim(no) }, arguments, result, rest, before, after)
}

// ---------------------------------------------------------------------------
// A constant table read

// table(i): the entry of [10, 20, 30, 40] at the low two bits of `i`. The
// index is resized to its two bits in the leaf, so it is in a register
// at its narrow width when the read takes it.
fn table() → Function {
    Function(parameters := [0], lent := 0,
        body := Dataflow(Region(inputs := Ports([word(0)]),
            nodes := [Resize(from := 64, to := 2, output := 1, source := 0),
                TableRead(width := 64, output := 2, bits := 2, index := 1, entries := [10, 20, 30, 40])],
            outputs := Ports([word(2)]))),
        result := 2)
}

theorem table_evaluable(): program_evaluable([table()]).IsTrue() { trivial }
theorem table_reads(): program_eval_over([], [table()], 0, [w(5)]) = w(20) { refl }

theorem table_present(): lower_program_lent([table()], plan_program([table()]), [0]).is_some().IsTrue() { trivial }

// The index settled to its two bits in RDI, the table's address in RAX,
// the jump over its four words, then RAX loaded from [RAX + RDI*8].
fn table_program() → Prog {
    table_read_prog(Start.label(1).put(Block([])).put(Block(settle_code(Rdi, 2))),
        BRax, XRdi, [10, 20, 30, 40])
        .put(Block([])).put(Block([])).put(Ret)
}

theorem table_planned(): plan_program([table()]) = [Into(Rdi), Into(Rax)] { refl }
theorem table_lowers(): lower_program_lent([table()], plan_program([table()]), [0]) = Some(table_program()) { refl }

// Called, it returns the entry its meaning says, whatever memory holds
// beside its own code.
theorem table_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([0], addresses, buffers).spans())):
    Site<M>(fetch, data, table_program(), last, origin).CallsOver(stack, program_effects([table()]), program_room([table()]), 1,
        Lending::reading([0], addresses, buffers), top) {
    lower_program_lent_correct<M>([table()], plan_program([table()]), Lending::reading([0], addresses, buffers), table_program(),
        table_lowers(), fetch, data, last, origin, stack, top, loan, trivial,
        λ b stores => false_elim(program_quiet_stores([table()], b, trivial, stores)))
}

// An index the leaf does not narrow is a word, which no table has room
// for: the read is refused.
fn table_wide() → Function {
    Function(parameters := [0], lent := 0,
        body := Dataflow(Region(inputs := Ports([word(0)]),
            nodes := [TableRead(width := 64, output := 2, bits := 64, index := 0, entries := [10, 20, 30, 40])],
            outputs := Ports([word(2)]))),
        result := 2)
}

theorem table_wide_refused(): lower_program_lent([table_wide()], plan_program([table_wide()]), [0]) = None { refl }

// ---------------------------------------------------------------------------
// A big-endian word in one access (WideLoad, ByteSwap)

// What the optimizer writes before a word of four bytes from `i`: `i`
// below the length, then `t = i + 3` below it too, the access in the arm
// both tests take. The word is read as `ByteSwap(32, WideLoad(4, …))` and
// widened; 0 where either test fails.
fn zero_arm(inputs: List<Port>) → StructuredRegion {
    Dataflow(Region(inputs := Ports(inputs), nodes := [Const(width := 64, output := 4, value := 0)], outputs := Ports([word(4)])))
}
fn be_read(inputs: List<Port>) → StructuredRegion {
    Dataflow(Region(inputs := Ports(inputs), nodes := [WideLoad(4, 8, 0, 2), ByteSwap(32, 9, 8), Resize(32, 64, 4, 9)],
        outputs := Ports([word(4)])))
}
// `t = i + k`, then the arm under `t below length`.
fn spanned_by(k: Nat, arm: StructuredRegion) → StructuredRegion {
    Sequence(
        Region(inputs := Ports([word(0), word(1), word(2)]),
            nodes := [Const(width := 64, output := 5, value := k), Add(width := 64, output := 6, left := 2, right := 5),
                UnsignedLessThan(width := 64, output := 7, left := 6, right := 1)],
            outputs := Ports([word(0), word(1), word(2), bit(7)])),
        Conditional(Ports([word(0), word(1), word(2), bit(7)]), 7, Ports([word(0), word(2)]), Ports([word(4)]),
            arm, zero_arm([word(0), word(2)])))
}
// The body under `i below length`.
fn index_guarded(body: StructuredRegion) → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), bit(3)]), 3, Ports([word(0), word(1), word(2)]), Ports([word(4)]),
                body, zero_arm([word(0), word(1), word(2)]))),
        result := 4)
}

fn be_word() → Function { index_guarded(spanned_by(3, be_read([word(0), word(2)]))) }

fn bytes5() → Buffers() { [[b(1), b(2), b(3), b(4), b(5)]] }
theorem be_word_evaluable(): program_evaluable([be_word()]).IsTrue() { trivial }
theorem be_word_reads(): program_eval_over(bytes5(), [be_word()], 0, [w(4096), w(5), w(1)]) = w(0x02030405) { refl }
theorem be_word_last(): program_eval_over(bytes5(), [be_word()], 0, [w(4096), w(5), w(0)]) = w(0x01020304) { refl }
theorem be_word_short(): program_eval_over(bytes5(), [be_word()], 0, [w(4096), w(5), w(2)]) = w(0) { refl }

// The address formed in RAX as a byte load's is, the doubleword loaded
// over it and swapped in place; `t` is RDX plus 3 in RAX, compared and
// dropped. The planner continues past the load, from the file it leaves.
fn be_word_program() → Prog {
    Start
        .label(1).put(Block([]))
        .put(Block([]))
        .put(Block([CmpRR(Rdx, Rsi)])).put(Jcc(AE, 2))
        .put(Block([MovRR(Rax, Rdx), AddRI8(Rax, b(3))]))
        .put(Block([CmpRR(Rax, Rsi)])).put(Jcc(AE, 4))
        .put(Block([MovRR(Rax, Rdi), AddRR(Rax, Rdx)])).put(asm_dword_load(DwordLoad(Rax, Rax))).put(Block([Bswap32(Rax)])).put(Jmp(5))
        .label(4).put(Block([MovRI32(Rax, BitVec::ofNat(0))]))
        .label(5).put(Jmp(3))
        .label(2).put(Block([MovRI32(Rax, BitVec::ofNat(0))]))
        .label(3)
        .put(Block([])).put(Block([])).put(Ret)
}

theorem be_word_planned():
    plan_program([be_word()]) = [Folded, Folded, Into(Rax), Folded, Into(Rax), Into(Rax), Into(Rax), Into(Rax), Into(Rax)] { refl }
theorem be_word_lowers(): lower_program_lent([be_word()], plan_program([be_word()]), [1]) = Some(be_word_program()) { refl }

// Whatever the buffers hold and wherever the lending laws let them lie.
theorem be_word_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::reading([1], addresses, buffers).spans())):
    Site<M>(fetch, data, be_word_program(), last, origin).CallsOver(stack, program_effects([be_word()]), program_room([be_word()]), 1,
        Lending::reading([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([be_word()], plan_program([be_word()]), Lending::reading([1], addresses, buffers), be_word_program(),
        be_word_lowers(), fetch, data, last, origin, stack, top, loan, trivial,
        λ b stores => false_elim(program_quiet_stores([be_word()], b, trivial, stores)))
}

// The controls: `i below length` alone, `t` that is `i + 2`, and `t`
// below length without `i` below it (`t` may have wrapped) are each
// refused.
fn be_unspanned() → Function { index_guarded(be_read([word(0), word(1), word(2)])) }
fn be_short_span() → Function { index_guarded(spanned_by(2, be_read([word(0), word(2)]))) }
fn be_unguarded() → Function { Function(parameters := [0, 1, 2], lent := 1, body := spanned_by(3, be_read([word(0), word(2)])), result := 4) }
theorem be_unspanned_refused(): lower_program_lent([be_unspanned()], plan_program([be_unspanned()]), [1]) = None { refl }
theorem be_short_span_refused(): lower_program_lent([be_short_span()], plan_program([be_short_span()]), [1]) = None { refl }
theorem be_unguarded_refused(): lower_program_lent([be_unguarded()], plan_program([be_unguarded()]), [1]) = None { refl }

// What the file knows: `t` recorded as `i + 3` (`Known::Offset`, from the
// `Add` of a known constant) and tested below the length, at any file.
fn spanned_file(file: File, k: Nat) → File {
    file.know(Offset(6, 2, k)).know(Compared(7, function_ir_lower::Below, 6, 1)).know(Truth(7))
}
theorem span_known(file: File): spanned_file(file, 3).span_bounded(2, 1, 3) = True { refl }
theorem span_orders(file: File, values: Valuation(), gprs: Gprs, represents: spanned_file(file, 3).Represents(values, gprs),
    no_wrap: values(64, 2).toNat() + 3 < Nat::pow(2, 64)): values(64, 2).toNat() + 3 < values(64, 1).toNat() {
    spanned_file(file, 3).span_bounded_sound(values, gprs, 2, 1, 3, represents, no_wrap, trivial)
}
theorem span_other_offset(): spanned_file(File::empty(), 2).span_bounded(2, 1, 3) = False { refl }
theorem span_other_index(): spanned_file(File::empty(), 3).span_bounded(0, 1, 3) = False { refl }
// The `Add` of a known 3 records it: with `t` then tested, the span is known.
fn added(file: File) → Option<Lowered> { Add(width := 64, output := 6, left := 2, right := 5).lower(Rax, file) }
fn tested(out: Option<Lowered>) → Bool {
    match out { None => False, Some(l) => l.file.know(Compared(7, function_ir_lower::Below, 6, 1)).know(Truth(7)).span_bounded(2, 1, 3) }
}
theorem add_records_offset(): tested(added(File::empty().write(Rdx, Some(Held(2, Word))).know(Constant(5, 3)))) = True { refl }
theorem add_of_two_not_span(): tested(added(File::empty().write(Rdx, Some(Held(2, Word))).know(Constant(5, 2)))) = False { refl }

// ---------------------------------------------------------------------------
// A big-endian word stored in one access (ByteSwap, WideStore)

// The store's mirror of `be_word`: the low half of `v` swapped and stored
// as four bytes from `i`, in the arm both tests take; 1 there, 0 where
// either test fails. The store's own output (the word read back) is not
// used past the leaf.
fn be_write(inputs: List<Port>) → StructuredRegion {
    Dataflow(Region(inputs := Ports(inputs),
        nodes := [Const(width := 64, output := 4, value := 1), Resize(64, 32, 10, 13), ByteSwap(32, 11, 10), WideStore(4, 12, 0, 2, 11)],
        outputs := Ports([word(4)])))
}
fn put_zero() → StructuredRegion {
    Dataflow(Region(inputs := Ports([word(0), word(2), word(13)]), nodes := [Const(width := 64, output := 4, value := 0)],
        outputs := Ports([word(4)])))
}
// `t = i + k`, then the store under `t below length`.
fn put_spanned_by(k: Nat) → StructuredRegion {
    Sequence(
        Region(inputs := Ports([word(0), word(1), word(2), word(13)]),
            nodes := [Const(width := 64, output := 5, value := k), Add(width := 64, output := 6, left := 2, right := 5),
                UnsignedLessThan(width := 64, output := 7, left := 6, right := 1)],
            outputs := Ports([word(0), word(1), word(2), word(13), bit(7)])),
        Conditional(Ports([word(0), word(1), word(2), word(13), bit(7)]), 7, Ports([word(0), word(2), word(13)]), Ports([word(4)]),
            be_write([word(0), word(2), word(13)]), put_zero()))
}
// The body under `i below length`.
fn put_guarded(body: StructuredRegion) → Function {
    Function(parameters := [0, 1, 2, 13], lent := 1,
        body := Sequence(
            Region(inputs := Ports([word(0), word(1), word(2), word(13)]),
                nodes := [UnsignedLessThan(width := 64, output := 3, left := 2, right := 1)],
                outputs := Ports([word(0), word(1), word(2), word(13), bit(3)])),
            Conditional(Ports([word(0), word(1), word(2), word(13), bit(3)]), 3, Ports([word(0), word(1), word(2), word(13)]), Ports([word(4)]),
                body, Dataflow(Region(inputs := Ports([word(0), word(1), word(2), word(13)]),
                    nodes := [Const(width := 64, output := 4, value := 0)], outputs := Ports([word(4)]))))),
        result := 4)
}
fn be_put() → Function { put_guarded(put_spanned_by(3)) }

theorem be_put_evaluable(): program_evaluable([be_put()]).IsTrue() { trivial }
theorem be_put_stores(): program_stores([be_put()], 0) = True { refl }
fn put5() → Buffers() { [[b(1), b(2), b(3), b(4), b(5)]] }
fn put5_at1() → Buffers() { [[b(1), b(0x11), b(0x22), b(0x33), b(0x44)]] }
theorem be_put_runs(a: BitVec(64)): program_run([be_put()], put5(), 0, [a, w(5), w(1), w(0x99_11223344)]) = Ending(w(1), put5_at1()) { refl }
theorem be_put_past(a: BitVec(64)): program_run([be_put()], put5(), 0, [a, w(5), w(2), w(0x11223344)]) = Ending(w(0), put5()) { refl }

// The two tests as for the load; in the arm, 1 in RAX, the value's low
// half settled in RCX and swapped there, the address formed in R8, and the
// doubleword stored over it. Nothing is read back.
fn be_put_program() → Prog {
    Start
        .label(1).put(Block([]))
        .put(Block([]))
        .put(Block([CmpRR(Rdx, Rsi)])).put(Jcc(AE, 2))
        .put(Block([MovRR(Rax, Rdx), AddRI8(Rax, b(3))]))
        .put(Block([CmpRR(Rax, Rsi)])).put(Jcc(AE, 4))
        .put(Block(List::append([MovRI32(Rax, BitVec::ofNat(1))], List::append(settle_code(Rcx, 32), [Bswap32(Rcx), MovRR(R8, Rdi), AddRR(R8, Rdx)]))))
        .put(asm_dword_store(DwordStore(R8, Rcx))).put(Jmp(5))
        .label(4).put(Block([MovRI32(Rax, BitVec::ofNat(0))]))
        .label(5).put(Jmp(3))
        .label(2).put(Block([MovRI32(Rax, BitVec::ofNat(0))]))
        .label(3)
        .put(Block([])).put(Block([])).put(Ret)
}

theorem be_put_planned():
    plan_program([be_put()]) = [Folded, Folded, Into(Rax), Folded, Into(Rax), Into(Rcx), Into(Rcx), Into(R8), Into(Rax), Into(Rax)] { refl }
theorem be_put_lowers(): lower_program_lent([be_put()], plan_program([be_put()]), [1]) = Some(be_put_program()) { refl }

theorem be_put_allowed(lending: Lending, written: lending.written(0) = True):
    (b: Nat) → program_stores([be_put()], b).IsTrue() → lending.written(b) = True {
    λ b => match b { Zero => λ _ => written, Succ(_) => λ no => false_elim(no) }
}

// Lent to be written, wherever the lending laws let the buffer lie.
theorem be_put_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, buffers: Buffers(), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, buffers).spans())):
    Site<M>(fetch, data, be_put_program(), last, origin).CallsOver(stack, program_effects([be_put()]), program_room([be_put()]), 1,
        writing([1], addresses, buffers), top) {
    lower_program_lent_correct<M>([be_put()], plan_program([be_put()]), writing([1], addresses, buffers), be_put_program(),
        be_put_lowers(), fetch, data, last, origin, stack, top, loan, trivial, be_put_allowed(writing([1], addresses, buffers), refl))
}

// So the code, over 1 2 3 4 5 with 0x11223344 put at 1: it returns 1, and
// 1 11 22 33 44 is the file in memory.
theorem be_put_word<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, writing([1], addresses, put5()).spans())):
    Site<M>(fetch, data, be_put_program(), last, origin).Returns(stack, asm_labels(be_put_program())(1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(5), w(1), w(0x99_11223344)], i, s) ∧ 48 <= i) ∧
            stack.LentOver(writing([1], addresses, put5()), top, 0, [a, w(5), w(1), w(0x99_11223344)], put5())(i, s),
        stack.AnsweredBoth(writing([1], addresses, put5()), w(1), [], put5_at1())) {
    compiled_returns_run<M>([be_put()], plan_program([be_put()]), program_room([be_put()]), writing([1], addresses, put5()), be_put_program(), be_put_lowers(),
        be_put_evaluable(), trivial, be_put_allowed(writing([1], addresses, put5()), refl), fetch, data, last, origin, stack, top, loan, 0, trivial,
        [a, w(5), w(1), w(0x99_11223344)], trivial, put5(),
        program_total_run_defined([be_put()], trivial, put5(), 0, [a, w(5), w(1), w(0x99_11223344)]), Ending(w(1), put5_at1()), be_put_runs(a))
}

// The controls, as for the load: `i below length` alone, `t` that is
// `i + 2`, and `t` below length without `i` below it are each refused.
fn put_unspanned() → Function { put_guarded(be_write([word(0), word(1), word(2), word(13)])) }
fn put_short_span() → Function { put_guarded(put_spanned_by(2)) }
fn put_unguarded() → Function { Function(parameters := [0, 1, 2, 13], lent := 1, body := put_spanned_by(3), result := 4) }
theorem put_controls_evaluable(): program_evaluable([put_unspanned(), put_short_span(), put_unguarded()]).IsTrue() { trivial }
theorem put_unspanned_refused(): lower_program_lent([put_unspanned()], plan_program([put_unspanned()]), [1]) = None { refl }
theorem put_short_span_refused(): lower_program_lent([put_short_span()], plan_program([put_short_span()]), [1]) = None { refl }
theorem put_unguarded_refused(): lower_program_lent([put_unguarded()], plan_program([put_unguarded()]), [1]) = None { refl }

// Probes of the lowering of a call over views (`File::emit_lend`,
// function_ir_lower_calls; function_ir_lower_views;
// docs/native/native-library-exports-design.md §3.1): a function that lends its
// callee a window of its buffer to write, one that lends two windows of
// one buffer, one to read and one to write, the code each lowers to, the
// contract each meets at every lending of its counts, and what is
// refused: two views of one buffer, one to write, the path does not know
// apart. Tests, not library: nothing imports this module.
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_views;
import function_ir_lower_calls;
import function_ir_compile;
import function_ir_refusal;
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_stack;
import x86_64_memory_contract;
import x86_64_memory_tiers;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import string;

fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn word(id: Nat) → Port { Port(id := id, width := 64) }
fn leaf(nodes: List<Node>) → StructuredRegion { Dataflow(Region(Ports([]), nodes, Ports([]))) }
fn then(nodes: List<Node>, rest: StructuredRegion) → StructuredRegion { Sequence(Region(Ports([]), nodes, Ports([])), rest) }
// The arms of a branch on `bit` that leave `output`: `yes` where it is
// set.
fn when(bit, output: Nat, yes, no: StructuredRegion) → StructuredRegion {
    Conditional(Ports([]), bit, Ports([]), Ports([word(output)]), yes, no)
}

// ---------------------------------------------------------------------------
// One view, to write

// put_at(address, length, i, v): `v`'s low byte stored at `i` of its
// buffer, returning the byte then there, or 256 past the end.
fn put_at() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 4,
        body := then([UnsignedLessThan(width := 64, output := 5, left := 2, right := 1)],
            when(5, 4, leaf([BufferStore(output := 4, buffer := 0, index := 2, value := 3)]), leaf([Const(width := 64, output := 4, value := 256)]))))
}

// lends_at(address, length, from, to, i, v): `put_at(i, v)` over the bytes
// `from` up to `to` of its buffer, or 512 where that is no window of it.
// The two comparisons are what the lowering reads the window's bounds off
// (`View::lendable`): `to` is at most the length, `from` at most `to`.
fn lends_at(written: Bool) → Function {
    Function(parameters := [0, 1, 2, 3, 4, 5], lent := 1, result := 8,
        body := then([UnsignedLessThan(width := 64, output := 10, left := 1, right := 3)],
            when(10, 8, leaf([Const(width := 64, output := 8, value := 512)]),
                then([UnsignedLessThan(width := 64, output := 11, left := 3, right := 2)],
                    when(11, 8, leaf([Const(width := 64, output := 8, value := 512)]),
                        Compose(Lend([View(buffer := 0, home := 0, start := 2, end := 3, written := written, base := 6, length := 7)], 0, [4, 5], 9),
                            leaf([Move(64, 8, 9)])))))))
}
fn lending() → List<Function> { [lends_at(True), put_at()] }

fn five() → Buffers() { [[b(1), b(2), b(3), b(4), b(5)]] }

theorem lending_evaluable(): program_evaluable(lending()).IsTrue() { trivial }

// What it means, by evaluation: 9 put at 1 of the window from 1 to 4 is
// put at 2 of the buffer; past the window's end nothing is stored, though
// the buffer goes on; and where the bounds are no window nothing is lent.
theorem lending_runs(a: BitVec(64)): program_run(lending(), five(), 1, [a, w(5), w(1), w(4), w(1), w(9)]) =
    Ending(w(9), [[b(1), b(2), b(9), b(4), b(5)]]) { refl }
theorem lending_past_the_view(a: BitVec(64)): program_run(lending(), five(), 1, [a, w(5), w(1), w(4), w(3), w(9)]) = Ending(w(256), five()) { refl }
theorem lending_past_the_buffer(a: BitVec(64)): program_run(lending(), five(), 1, [a, w(5), w(1), w(6), w(1), w(9)]) = Ending(w(512), five()) { refl }
theorem lending_backwards(a: BitVec(64)): program_run(lending(), five(), 1, [a, w(5), w(4), w(1), w(1), w(9)]) = Ending(w(512), five()) { refl }

// It lowers: the views' base and length bound, then the call on them.
theorem lending_present(): lower_program_lent(lending(), plan_program(lending()), [1, 1]).is_some().IsTrue() { trivial }
fn lending_program() → Prog { lower_program_lent(lending(), plan_program(lending()), [1, 1]).get(lending_present()) }
theorem lending_lowers(): lower_program_lent(lending(), plan_program(lending()), [1, 1]) = Some(lending_program()) {
    Option::some_get(lower_program_lent(lending(), plan_program(lending()), [1, 1]), lending_present())
}

// Each function needs its buffer 0 lent to write: `put_at` stores into it,
// `lends_at` lends a window of it to be written.
theorem lending_marked(): program_marked(lending(), [[True], [True]]) = True { refl }

// The theorem instantiated: at every lending of the counts that lets a
// function write what its row marks, the function meets its contract.
theorem lending_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), top: Nat):
    Site<M>(fetch, data, lending_program(), last, origin).CallsLent(stack, program_effects(lending()), program_room(lending()), 2, [1, 1],
        λ (f: Nat) (v: Nat) => marked(marks_row([[True], [True]], f), v), top) {
    lower_program_lent_needs<M>(lending(), plan_program(lending()), [1, 1], lending_program(), lending_lowers(),
        λ (f: Nat) (v: Nat) => marked(marks_row([[True], [True]], f), v), program_marked_needs(lending(), [[True], [True]], trivial),
        fetch, data, last, origin, stack, top)
}

// So the code, over five bytes lent to be written wherever the laws let
// them lie: it returns 9, and the bytes with 9 at 2 are the file in
// memory.
theorem lending_puts<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([1, 1], addresses, five(), [True]).spans())):
    Site<M>(fetch, data, lending_program(), last, origin).Returns(stack, asm_labels(lending_program())(2),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(5), w(1), w(4), w(1), w(9)], i, s) ∧ 184 <= i) ∧
            stack.LentOver(Lending::writing([1, 1], addresses, five(), [True]), top, 1, [a, w(5), w(1), w(4), w(1), w(9)], five())(i, s),
        stack.AnsweredBoth(Lending::writing([1, 1], addresses, five(), [True]), w(9), [], [[b(1), b(2), b(9), b(4), b(5)]])) {
    compiled_returns_marked<M>(lending(), plan_program(lending()), program_room(lending()), [1, 1], addresses, [[True], [True]], lending_program(), lending_lowers(),
        lending_evaluable(), trivial, fetch, data, last, origin, stack, top, five(), 1, trivial, loan, [a, w(5), w(1), w(4), w(1), w(9)],
        trivial, program_total_run_defined(lending(), trivial, five(), 1, [a, w(5), w(1), w(4), w(1), w(9)]),
        Ending(w(9), [[b(1), b(2), b(9), b(4), b(5)]]), lending_runs(a))
}

// A view lent to read, to a callee that stores into it. The lowering does
// not refuse it: the code is the same. What refuses is the rows: no row
// for the lender lets `put_at`'s row be met by the view, so the program
// has no contract to be called under.
fn showing() → List<Function> { [lends_at(False), put_at()] }
theorem showing_lowers(): lower_program_lent(showing(), plan_program(showing()), [1, 1]).is_some().IsTrue() { trivial }
theorem showing_unmarked(): program_marked(showing(), [[True], [True]]) = False { refl }
theorem showing_unmarked_reading(): program_marked(showing(), [[True], [False]]) = False { refl }
// And with a callee's row that says it writes nothing, the callee's own
// store is what the rows refuse.
theorem showing_unmarked_quiet(): program_marked(showing(), [[False], [False]]) = False { refl }

// ---------------------------------------------------------------------------
// A whole buffer under another number

// renames(address, length, address, length, i, v): `put_at(i, v)` over the
// whole of its buffer 1, which is the callee's buffer 0. The view runs
// from the constant 0 to the buffer's own length, so no comparison is
// asked for: renaming a buffer is free.
fn renames() → Function {
    Function(parameters := [0, 1, 2, 3, 4, 5], lent := 2, result := 8,
        body := then([Const(width := 64, output := 9, value := 0)],
            Lend([View(buffer := 1, home := 2, start := 9, end := 3, written := True, base := 6, length := 7)], 0, [4, 5], 8)))
}
fn renaming() → List<Function> { [renames(), put_at()] }
fn two() → Buffers() { [[b(1), b(2), b(3)], [b(4), b(5), b(6), b(7)]] }

theorem renaming_evaluable(): program_evaluable(renaming()).IsTrue() { trivial }
theorem renaming_runs(a, c: BitVec(64)): program_run(renaming(), two(), 1, [a, w(3), c, w(4), w(3), w(9)]) =
    Ending(w(9), [[b(1), b(2), b(3)], [b(4), b(5), b(6), b(9)]]) { refl }

theorem renaming_present(): lower_program_lent(renaming(), plan_program(renaming()), [1, 2]).is_some().IsTrue() { trivial }
fn renaming_program() → Prog { lower_program_lent(renaming(), plan_program(renaming()), [1, 2]).get(renaming_present()) }
theorem renaming_lowers(): lower_program_lent(renaming(), plan_program(renaming()), [1, 2]) = Some(renaming_program()) {
    Option::some_get(lower_program_lent(renaming(), plan_program(renaming()), [1, 2]), renaming_present())
}

// The callee needs its buffer 0 and the lender its buffer 1: one list of
// marks for the program, read by each function at its own numbers, cannot
// say both without also letting the lender's buffer 0 be written.
theorem renaming_marked(): program_marked(renaming(), [[True], [False, True]]) = True { refl }
theorem renaming_one_list(): program_stores_within(renaming(), [False, True]) = False { refl }

// The lender's buffer 0 is lent to read: the code returns 9, and leaves 9
// at 3 of buffer 1.
theorem renaming_puts<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a, c: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([1, 2], addresses, two(), [False, True]).spans())):
    Site<M>(fetch, data, renaming_program(), last, origin).Returns(stack, asm_labels(renaming_program())(2),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3), c, w(4), w(3), w(9)], i, s) ∧ 184 <= i) ∧
            stack.LentOver(Lending::writing([1, 2], addresses, two(), [False, True]), top, 1, [a, w(3), c, w(4), w(3), w(9)], two())(i, s),
        stack.AnsweredBoth(Lending::writing([1, 2], addresses, two(), [False, True]), w(9), [], [[b(1), b(2), b(3)], [b(4), b(5), b(6), b(9)]])) {
    compiled_returns_marked<M>(renaming(), plan_program(renaming()), program_room(renaming()), [1, 2], addresses, [[True], [False, True]], renaming_program(),
        renaming_lowers(), renaming_evaluable(), trivial, fetch, data, last, origin, stack, top, two(), 1, trivial, loan,
        [a, w(3), c, w(4), w(3), w(9)], trivial,
        program_total_run_defined(renaming(), trivial, two(), 1, [a, w(3), c, w(4), w(3), w(9)]), Ending(w(9), [[b(1), b(2), b(3)], [b(4), b(5), b(6), b(9)]]), renaming_runs(a, c))
}

// ---------------------------------------------------------------------------
// Two views

// carry_at(address, length, address, length, i): the byte at `i` of its
// buffer 0 stored at `i` of its buffer 1, returning the byte then there,
// or 256 where `i` is past either.
fn carry_at() → Function {
    Function(parameters := [0, 1, 2, 3, 4], lent := 2, result := 6,
        body := then([UnsignedLessThan(width := 64, output := 10, left := 4, right := 1)],
            when(10, 6,
                then([UnsignedLessThan(width := 64, output := 11, left := 4, right := 3)],
                    when(11, 6,
                        then([BufferLoad(output := 5, buffer := 0, index := 4)], leaf([BufferStore(output := 6, buffer := 1, index := 4, value := 5)])),
                        leaf([Const(width := 64, output := 6, value := 256)]))),
                leaf([Const(width := 64, output := 6, value := 256)]))))
}

// crossing(address, length, address, length, mid): `carry_at(mid)` from
// its buffer 1 from `mid` on, lent to read, into its buffer 0 from `mid`
// on, lent to write: the lender's buffers under the callee's numbers the
// other way round. Or 512 where `mid` is past either buffer.
fn crossing() → Function {
    Function(parameters := [0, 1, 2, 3, 4], lent := 2, result := 9,
        body := then([UnsignedLessThan(width := 64, output := 10, left := 3, right := 4)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                then([UnsignedLessThan(width := 64, output := 16, left := 1, right := 4)],
                    when(16, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                        Compose(Lend([View(buffer := 1, home := 2, start := 4, end := 3, written := False, base := 11, length := 12),
                                View(buffer := 0, home := 0, start := 4, end := 1, written := True, base := 13, length := 14)], 0, [4], 15),
                            leaf([Move(64, 9, 15)])))))))
}
fn crossed() → List<Function> { [crossing(), carry_at()] }

theorem crossed_evaluable(): program_evaluable(crossed()).IsTrue() { trivial }
theorem crossed_runs(a, c: BitVec(64)): program_run(crossed(), two(), 1, [a, w(3), c, w(4), w(1)]) =
    Ending(w(6), [[b(1), b(2), b(6)], [b(4), b(5), b(6), b(7)]]) { refl }
theorem crossed_past(a, c: BitVec(64)): program_run(crossed(), two(), 1, [a, w(3), c, w(4), w(5)]) = Ending(w(512), two()) { refl }

theorem crossed_present(): lower_program_lent(crossed(), plan_program(crossed()), [2, 2]).is_some().IsTrue() { trivial }
fn crossed_program() → Prog { lower_program_lent(crossed(), plan_program(crossed()), [2, 2]).get(crossed_present()) }
theorem crossed_lowers(): lower_program_lent(crossed(), plan_program(crossed()), [2, 2]) = Some(crossed_program()) {
    Option::some_get(lower_program_lent(crossed(), plan_program(crossed()), [2, 2]), crossed_present())
}

// The callee needs its buffer 1 to write, which is the lender's buffer 0.
theorem crossed_marked(): program_marked(crossed(), [[False, True], [True, False]]) = True { refl }
theorem crossed_callee_row(): program_marked(crossed(), [[True, False], [True, False]]) = False { refl }
theorem crossed_lender_row(): program_marked(crossed(), [[False, True], [False, True]]) = False { refl }

// The lender's buffer 1 is lent to read: the code returns 6 and leaves it,
// with 6 at 2 of buffer 0.
theorem crossed_carries<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a, c: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([2, 2], addresses, two(), [True, False]).spans())):
    Site<M>(fetch, data, crossed_program(), last, origin).Returns(stack, asm_labels(crossed_program())(2),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(3), c, w(4), w(1)], i, s) ∧ 184 <= i) ∧
            stack.LentOver(Lending::writing([2, 2], addresses, two(), [True, False]), top, 1, [a, w(3), c, w(4), w(1)], two())(i, s),
        stack.AnsweredBoth(Lending::writing([2, 2], addresses, two(), [True, False]), w(6), [], [[b(1), b(2), b(6)], [b(4), b(5), b(6), b(7)]])) {
    compiled_returns_marked<M>(crossed(), plan_program(crossed()), program_room(crossed()), [2, 2], addresses, [[False, True], [True, False]], crossed_program(),
        crossed_lowers(), crossed_evaluable(), trivial, fetch, data, last, origin, stack, top, two(), 1, trivial, loan,
        [a, w(3), c, w(4), w(1)], trivial,
        program_total_run_defined(crossed(), trivial, two(), 1, [a, w(3), c, w(4), w(1)]), Ending(w(6), [[b(1), b(2), b(6)], [b(4), b(5), b(6), b(7)]]), crossed_runs(a, c))
}

// crossing_whole(address, length, address, length, mid): the same with the
// whole of buffer 1 lent to read, from the constant 0. Ten values are
// named on the way to the call (four home words, `mid`, the constant and
// the four words the views bind) and nine registers hold a function's
// values: it lowers because a home is read where a view names it, as any
// operand is, and is free after the last view that does
// (issues/function-homes-live-to-function-end.md).
fn crossing_whole() → Function {
    Function(parameters := [0, 1, 2, 3, 5], lent := 2, result := 9,
        body := then([Const(width := 64, output := 6, value := 0), UnsignedLessThan(width := 64, output := 16, left := 1, right := 5)],
            when(16, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 1, home := 2, start := 6, end := 3, written := False, base := 11, length := 12),
                        View(buffer := 0, home := 0, start := 5, end := 1, written := True, base := 13, length := 14)], 0, [5], 15),
                    leaf([Move(64, 9, 15)])))))
}
fn crossed_whole() → List<Function> { [crossing_whole(), carry_at()] }

theorem crossed_whole_evaluable(): program_evaluable(crossed_whole()).IsTrue() { trivial }
theorem crossed_whole_runs(a, c: BitVec(64)): program_run(crossed_whole(), two(), 1, [a, w(3), c, w(4), w(1)]) =
    Ending(w(5), [[b(1), b(2), b(5)], [b(4), b(5), b(6), b(7)]]) { refl }
theorem crossed_whole_past(a, c: BitVec(64)): program_run(crossed_whole(), two(), 1, [a, w(3), c, w(4), w(5)]) = Ending(w(512), two()) { refl }
theorem crossed_whole_lowers(): lower_program_lent(crossed_whole(), plan_program(crossed_whole()), [2, 2]).is_some().IsTrue() { trivial }
theorem crossed_whole_marked(): program_marked(crossed_whole(), [[False, True], [True, False]]) = True { refl }

// ---------------------------------------------------------------------------
// Two views of one buffer, one to write, known apart
// (issues/views-of-one-buffer-apart.md)

// halves_at(address, length, mid, i): `carry_at(i)` from the bytes of its
// buffer before `mid`, lent to read, into the bytes from `mid` on, lent to
// write; or 512 where `mid` is past the buffer. The halves are apart
// because one's end is the other's start: the one value `mid`, as
// `split_at` makes them.
fn halves_at() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := False, base := 5, length := 6),
                        View(buffer := 0, home := 0, start := 2, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                    leaf([Move(64, 9, 11)])))))
}
fn halving() → List<Function> { [halves_at(), carry_at()] }

theorem halving_evaluable(): program_evaluable(halving()).IsTrue() { trivial }

// What it means: byte 1 of the first half lands at byte 1 of the second;
// at another `mid` the halves are elsewhere; past the buffer nothing is
// lent.
theorem halving_runs(a: BitVec(64)): program_run(halving(), five(), 1, [a, w(5), w(2), w(1)]) =
    Ending(w(2), [[b(1), b(2), b(3), b(2), b(5)]]) { refl }
theorem halving_elsewhere(a: BitVec(64)): program_run(halving(), five(), 1, [a, w(5), w(1), w(0)]) =
    Ending(w(1), [[b(1), b(1), b(3), b(4), b(5)]]) { refl }
theorem halving_past(a: BitVec(64)): program_run(halving(), five(), 1, [a, w(5), w(6), w(0)]) = Ending(w(512), five()) { refl }

theorem halving_present(): lower_program_lent(halving(), plan_program(halving()), [2, 1]).is_some().IsTrue() { trivial }
fn halving_program() → Prog { lower_program_lent(halving(), plan_program(halving()), [2, 1]).get(halving_present()) }
theorem halving_lowers(): lower_program_lent(halving(), plan_program(halving()), [2, 1]) = Some(halving_program()) {
    Option::some_get(lower_program_lent(halving(), plan_program(halving()), [2, 1]), halving_present())
}

// The callee needs its buffer 1, the second half, to write; the lender its
// buffer 0, of which that half is.
theorem halving_marked(): program_marked(halving(), [[False, True], [True]]) = True { refl }
theorem halving_callee_row(): program_marked(halving(), [[True, True], [True]]) = False { refl }

// The code, over five bytes lent to be written wherever the laws let them
// lie: it returns 2, and the bytes with 2 at 3 are the file in memory.
theorem halving_carries<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([2, 1], addresses, five(), [True]).spans())):
    Site<M>(fetch, data, halving_program(), last, origin).Returns(stack, asm_labels(halving_program())(2),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(5), w(2), w(1)], i, s) ∧ 184 <= i) ∧
            stack.LentOver(Lending::writing([2, 1], addresses, five(), [True]), top, 1, [a, w(5), w(2), w(1)], five())(i, s),
        stack.AnsweredBoth(Lending::writing([2, 1], addresses, five(), [True]), w(2), [], [[b(1), b(2), b(3), b(2), b(5)]])) {
    compiled_returns_marked<M>(halving(), plan_program(halving()), program_room(halving()), [2, 1], addresses, [[False, True], [True]], halving_program(),
        halving_lowers(), halving_evaluable(), trivial, fetch, data, last, origin, stack, top, five(), 1, trivial, loan, [a, w(5), w(2), w(1)], trivial,
        program_total_run_defined(halving(), trivial, five(), 1, [a, w(5), w(2), w(1)]), Ending(w(2), [[b(1), b(2), b(3), b(2), b(5)]]), halving_runs(a))
}

// The same at every file: what the run answers at any bytes, any length
// and any `mid` is what the code leaves, the split point open.
theorem halving_carries_open<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, file: Buffers(), a, length, mid, i: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([2, 1], addresses, file, [True]).spans())):
    Site<M>(fetch, data, halving_program(), last, origin).Returns(stack, asm_labels(halving_program())(2),
        λ (k: Nat) (s: MachineState<M>) => (stack.Passed([a, length, mid, i], k, s) ∧ 184 <= k) ∧
            stack.LentOver(Lending::writing([2, 1], addresses, file, [True]), top, 1, [a, length, mid, i], file)(k, s),
        stack.AnsweredBoth(Lending::writing([2, 1], addresses, file, [True]), program_run(halving(), file, 1, [a, length, mid, i]).word, [],
            program_run(halving(), file, 1, [a, length, mid, i]).buffers)) {
    compiled_returns_marked<M>(halving(), plan_program(halving()), program_room(halving()), [2, 1], addresses, [[False, True], [True]], halving_program(),
        halving_lowers(), halving_evaluable(), trivial, fetch, data, last, origin, stack, top, file, 1, trivial, loan, [a, length, mid, i], trivial,
        program_total_run_defined(halving(), trivial, file, 1, [a, length, mid, i]), program_run(halving(), file, 1, [a, length, mid, i]), refl)
}

// halves_fixed(address, length, i): the same split at the literal 2. One
// constant is both halves' bound.
fn halves_fixed() → Function {
    Function(parameters := [0, 1, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), Const(width := 64, output := 2, value := 2),
                UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := False, base := 5, length := 6),
                        View(buffer := 0, home := 0, start := 2, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                    leaf([Move(64, 9, 11)])))))
}
fn halving_fixed() → List<Function> { [halves_fixed(), carry_at()] }
theorem halving_fixed_runs(a: BitVec(64)): program_run(halving_fixed(), five(), 1, [a, w(5), w(0)]) =
    Ending(w(1), [[b(1), b(2), b(1), b(4), b(5)]]) { refl }
theorem halving_fixed_lowers(): lower_program_lent(halving_fixed(), plan_program(halving_fixed()), [2, 1]).is_some().IsTrue() { trivial }

// gapped(address, length, i): bytes 0 up to 2 lent to read and bytes 3 on
// lent to write, the bounds two constants: apart because 2 is at most 3.
fn gapped(low, high: Nat) → Function {
    Function(parameters := [0, 1, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), Const(width := 64, output := 2, value := low),
                Const(width := 64, output := 12, value := high), UnsignedLessThan(width := 64, output := 10, left := 1, right := 12)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                then([UnsignedLessThan(width := 64, output := 13, left := 1, right := 2)],
                    when(13, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                        Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := False, base := 5, length := 6),
                                View(buffer := 0, home := 0, start := 12, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                            leaf([Move(64, 9, 11)])))))))
}
theorem gapped_runs(a: BitVec(64)): program_run([gapped(2, 3), carry_at()], five(), 1, [a, w(5), w(1)]) =
    Ending(w(2), [[b(1), b(2), b(3), b(4), b(2)]]) { refl }
theorem gapped_lowers(): lower_program_lent([gapped(2, 3), carry_at()], plan_program([gapped(2, 3), carry_at()]), [2, 1]).is_some().IsTrue() { trivial }

// compared(address, length, end, start, i): the half to read ends at
// `end` and the half to write starts at `start`, two values: they are
// apart where an arm says `end` is at most `start`. Each is compared with
// the length first; the third comparison is `left < right`, and the lend
// is where it is false.
fn compared_by(left, right: Nat) → Function {
    Function(parameters := [0, 1, 2, 12, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                then([UnsignedLessThan(width := 64, output := 14, left := 1, right := 12)],
                    when(14, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                        then([UnsignedLessThan(width := 64, output := 13, left := left, right := right)],
                            when(13, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := False, base := 5, length := 6),
                                        View(buffer := 0, home := 0, start := 12, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                                    leaf([Move(64, 9, 11)])))))))))
}
fn comparing() → List<Function> { [compared_by(12, 2), carry_at()] }
theorem comparing_runs(a: BitVec(64)): program_run(comparing(), five(), 1, [a, w(5), w(2), w(3), w(1)]) =
    Ending(w(2), [[b(1), b(2), b(3), b(4), b(2)]]) { refl }
theorem comparing_lowers(): lower_program_lent(comparing(), plan_program(comparing()), [2, 1]).is_some().IsTrue() { trivial }

// ---------------------------------------------------------------------------
// Two views to write of one buffer, known apart: `split_at_mut`

// exchange_at(address, length, address, length, i): the byte at `i` of
// its buffer 1 moved to `i` of its buffer 0, and `i`'s low byte stored in
// its place, returning the byte moved; or 256 where `i` is past either.
// It stores into both its buffers.
fn exchange_at() → Function {
    Function(parameters := [0, 1, 2, 3, 4], lent := 2, result := 6,
        body := then([UnsignedLessThan(width := 64, output := 10, left := 4, right := 1)],
            when(10, 6,
                then([UnsignedLessThan(width := 64, output := 11, left := 4, right := 3)],
                    when(11, 6,
                        then([BufferLoad(output := 5, buffer := 1, index := 4)],
                            then([BufferStore(output := 6, buffer := 0, index := 4, value := 5)],
                                leaf([BufferStore(output := 12, buffer := 1, index := 4, value := 4)]))),
                        leaf([Const(width := 64, output := 6, value := 256)]))),
                leaf([Const(width := 64, output := 6, value := 256)]))))
}

// splits_at(address, length, mid, i): `exchange_at(i)` over the bytes
// before `mid` and the bytes from `mid` on, both lent to write; or 512
// where `mid` is past the buffer. Apart because one's end is the other's
// start.
fn splits_at() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := True, base := 5, length := 6),
                        View(buffer := 0, home := 0, start := 2, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                    leaf([Move(64, 9, 11)])))))
}
fn splitting() → List<Function> { [splits_at(), exchange_at()] }

theorem splitting_evaluable(): program_evaluable(splitting()).IsTrue() { trivial }

// What it means: at `mid` 2, byte 1 of the second half (4) moved to byte
// 1 of the first, and 1 left in its place; at `mid` 1, byte 0 of each;
// past the buffer nothing is lent.
theorem splitting_runs(a: BitVec(64)): program_run(splitting(), five(), 1, [a, w(5), w(2), w(1)]) =
    Ending(w(4), [[b(1), b(4), b(3), b(1), b(5)]]) { refl }
theorem splitting_elsewhere(a: BitVec(64)): program_run(splitting(), five(), 1, [a, w(5), w(1), w(0)]) =
    Ending(w(2), [[b(2), b(0), b(3), b(4), b(5)]]) { refl }
theorem splitting_past(a: BitVec(64)): program_run(splitting(), five(), 1, [a, w(5), w(6), w(0)]) = Ending(w(512), five()) { refl }

theorem splitting_present(): lower_program_lent(splitting(), plan_program(splitting()), [2, 1]).is_some().IsTrue() { trivial }
fn splitting_program() → Prog { lower_program_lent(splitting(), plan_program(splitting()), [2, 1]).get(splitting_present()) }
theorem splitting_lowers(): lower_program_lent(splitting(), plan_program(splitting()), [2, 1]) = Some(splitting_program()) {
    Option::some_get(lower_program_lent(splitting(), plan_program(splitting()), [2, 1]), splitting_present())
}

// The callee needs both its buffers to write, and the lender its buffer 0.
theorem splitting_marked(): program_marked(splitting(), [[True, True], [True]]) = True { refl }
theorem splitting_callee_row(): program_marked(splitting(), [[False, True], [True]]) = False { refl }

// The code, over five bytes lent to be written: it returns 4, and both
// halves written are the file in memory.
theorem splitting_swaps<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, a: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([2, 1], addresses, five(), [True]).spans())):
    Site<M>(fetch, data, splitting_program(), last, origin).Returns(stack, asm_labels(splitting_program())(2),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed([a, w(5), w(2), w(1)], i, s) ∧ 184 <= i) ∧
            stack.LentOver(Lending::writing([2, 1], addresses, five(), [True]), top, 1, [a, w(5), w(2), w(1)], five())(i, s),
        stack.AnsweredBoth(Lending::writing([2, 1], addresses, five(), [True]), w(4), [], [[b(1), b(4), b(3), b(1), b(5)]])) {
    compiled_returns_marked<M>(splitting(), plan_program(splitting()), program_room(splitting()), [2, 1], addresses, [[True, True], [True]],
        splitting_program(), splitting_lowers(), splitting_evaluable(), trivial, fetch, data, last, origin, stack, top, five(), 1, trivial, loan,
        [a, w(5), w(2), w(1)], trivial, program_total_run_defined(splitting(), trivial, five(), 1, [a, w(5), w(2), w(1)]),
        Ending(w(4), [[b(1), b(4), b(3), b(1), b(5)]]), splitting_runs(a))
}

// At any file and words, the split point open.
theorem splitting_swaps_open<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), addresses: List<BitVec(64)>, file: Buffers(), a, length, mid, i: BitVec(64), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, Lending::writing([2, 1], addresses, file, [True]).spans())):
    Site<M>(fetch, data, splitting_program(), last, origin).Returns(stack, asm_labels(splitting_program())(2),
        λ (k: Nat) (s: MachineState<M>) => (stack.Passed([a, length, mid, i], k, s) ∧ 184 <= k) ∧
            stack.LentOver(Lending::writing([2, 1], addresses, file, [True]), top, 1, [a, length, mid, i], file)(k, s),
        stack.AnsweredBoth(Lending::writing([2, 1], addresses, file, [True]), program_run(splitting(), file, 1, [a, length, mid, i]).word, [],
            program_run(splitting(), file, 1, [a, length, mid, i]).buffers)) {
    compiled_returns_marked<M>(splitting(), plan_program(splitting()), program_room(splitting()), [2, 1], addresses, [[True, True], [True]],
        splitting_program(), splitting_lowers(), splitting_evaluable(), trivial, fetch, data, last, origin, stack, top, file, 1, trivial, loan,
        [a, length, mid, i], trivial, program_total_run_defined(splitting(), trivial, file, 1, [a, length, mid, i]),
        program_run(splitting(), file, 1, [a, length, mid, i]), refl)
}

// The same at the literal 2, two constants for the bounds: apart because
// 2 is at most 2.
fn splits_fixed() → Function {
    Function(parameters := [0, 1, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), Const(width := 64, output := 2, value := 2),
                Const(width := 64, output := 12, value := 2), UnsignedLessThan(width := 64, output := 10, left := 1, right := 12)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                then([UnsignedLessThan(width := 64, output := 13, left := 1, right := 2)],
                    when(13, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                        Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 2, written := True, base := 5, length := 6),
                                View(buffer := 0, home := 0, start := 12, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                            leaf([Move(64, 9, 11)])))))))
}
fn splitting_fixed() → List<Function> { [splits_fixed(), exchange_at()] }
theorem splitting_fixed_runs(a: BitVec(64)): program_run(splitting_fixed(), five(), 1, [a, w(5), w(0)]) =
    Ending(w(3), [[b(3), b(2), b(0), b(4), b(5)]]) { refl }
theorem splitting_fixed_lowers(): lower_program_lent(splitting_fixed(), plan_program(splitting_fixed()), [2, 1]).is_some().IsTrue() { trivial }

// ---------------------------------------------------------------------------
// What is refused, and what the report says of each
// (`Function::refused`, function_ir_refusal)

// The controls of the halves. Two views that overlap, one to write: the
// one to read runs to the buffer's end, past where the one to write
// starts. The meaning still says what it does; the lowering refuses it.
fn overlapping() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 1, written := False, base := 5, length := 6),
                        View(buffer := 0, home := 0, start := 2, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                    leaf([Move(64, 9, 11)])))))
}
fn overlapped() → List<Function> { [overlapping(), carry_at()] }
theorem overlapped_runs(a: BitVec(64)): program_run(overlapped(), five(), 1, [a, w(5), w(2), w(1)]) =
    Ending(w(2), [[b(1), b(2), b(3), b(2), b(5)]]) { refl }
theorem overlapped_refused(): lower_program_lent(overlapped(), plan_program(overlapped()), [2, 1]) = None { refl }
theorem overlapped_why(): overlapping().refused(1, overlapping().plan(), 2, [2, 1], index_rooms()) =
    "where 10 is false, the call of function 0 over views (buffer 0 from 4 to 1, buffer 0 from 2 to 1 written): its views buffer 0 from 4 to 1 and buffer 0 from 2 to 1 written share a buffer, and nothing says that one ends at most where the other starts: neither's end is the other's start, no arm taken on the way here compares them, and they are not two constants in order" { refl }

// Two constants out of order: the half to read ends at 3 and the half to
// write starts at 2.
theorem gapped_crossed_runs(a: BitVec(64)): program_run([gapped(3, 2), carry_at()], five(), 1, [a, w(5), w(1)]) =
    Ending(w(2), [[b(1), b(2), b(3), b(2), b(5)]]) { refl }
theorem gapped_crossed_refused(): lower_program_lent([gapped(3, 2), carry_at()], plan_program([gapped(3, 2), carry_at()]), [2, 1]) = None { refl }

// The comparison the wrong way round: an arm says `end` is less than
// `start` or not, and the lend is where it is not, which is no two windows
// apart.
fn backwards() → List<Function> { [compared_by(2, 12), carry_at()] }
theorem backwards_refused(): lower_program_lent(backwards(), plan_program(backwards()), [2, 1]) = None { refl }
theorem backwards_why(): compared_by(2, 12).refused(1, compared_by(2, 12).plan(), 2, [2, 1], index_rooms()) =
    "where 10 is false, where 14 is false, where 13 is false, the call of function 0 over views (buffer 0 from 4 to 2, buffer 0 from 12 to 1 written): its views buffer 0 from 4 to 2 and buffer 0 from 12 to 1 written share a buffer, and nothing says that one ends at most where the other starts: neither's end is the other's start, no arm taken on the way here compares them, and they are not two constants in order" { refl }

// Two views to write that overlap: the first runs to the buffer's end,
// past where the second starts. The meaning says what it does (the view
// put back last wins); the lowering refuses it, naming the two.
fn overlapping_written() → Function {
    Function(parameters := [0, 1, 2, 3], lent := 1, result := 9,
        body := then([Const(width := 64, output := 4, value := 0), UnsignedLessThan(width := 64, output := 10, left := 1, right := 2)],
            when(10, 9, leaf([Const(width := 64, output := 9, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 4, end := 1, written := True, base := 5, length := 6),
                        View(buffer := 0, home := 0, start := 2, end := 1, written := True, base := 7, length := 8)], 0, [3], 11),
                    leaf([Move(64, 9, 11)])))))
}
fn overlapped_written() → List<Function> { [overlapping_written(), exchange_at()] }
theorem overlapped_written_runs(a: BitVec(64)): program_run(overlapped_written(), five(), 1, [a, w(5), w(2), w(1)]) =
    Ending(w(4), [[b(1), b(4), b(3), b(1), b(5)]]) { refl }
theorem overlapped_written_refused(): lower_program_lent(overlapped_written(), plan_program(overlapped_written()), [2, 1]) = None { refl }
theorem overlapped_written_why(): overlapping_written().refused(1, overlapping_written().plan(), 2, [2, 1], index_rooms()) =
    "where 10 is false, the call of function 0 over views (buffer 0 from 4 to 1 written, buffer 0 from 2 to 1 written): its views buffer 0 from 4 to 1 written and buffer 0 from 2 to 1 written share a buffer, and nothing says that one ends at most where the other starts: neither's end is the other's start, no arm taken on the way here compares them, and they are not two constants in order" { refl }

// A window whose bounds no comparison on the way says.
fn unguarded() → Function {
    Function(parameters := [0, 1, 2, 3, 4, 5], lent := 1, result := 8,
        body := Lend([View(buffer := 0, home := 0, start := 2, end := 3, written := True, base := 6, length := 7)], 0, [4, 5], 8))
}
theorem unguarded_refused(): lower_program_lent([unguarded(), put_at()], plan_program([unguarded(), put_at()]), [1, 1]) = None { refl }
theorem unguarded_why(): unguarded().refused(1, unguarded().plan(), 2, [1, 1], index_rooms()) =
    "the call of function 0 over views (buffer 0 from 2 to 3 written): its view of buffer 0 from 2 to 3: no arm taken on the way here says that its start is at most its end, and its start is not the constant 0" { refl }

// A window that starts before it ends, with nothing said of where it ends
// in the buffer.
fn unbounded() → Function {
    Function(parameters := [0, 1, 2, 3, 4, 5], lent := 1, result := 8,
        body := then([UnsignedLessThan(width := 64, output := 11, left := 3, right := 2)],
            when(11, 8, leaf([Const(width := 64, output := 8, value := 512)]),
                Compose(Lend([View(buffer := 0, home := 0, start := 2, end := 3, written := True, base := 6, length := 7)], 0, [4, 5], 9),
                    leaf([Move(64, 8, 9)])))))
}
theorem unbounded_refused(): lower_program_lent([unbounded(), put_at()], plan_program([unbounded(), put_at()]), [1, 1]) = None { refl }
theorem unbounded_why(): unbounded().refused(1, unbounded().plan(), 2, [1, 1], index_rooms()) =
    "where 11 is false, the call of function 0 over views (buffer 0 from 2 to 3 written): its view of buffer 0 from 2 to 3: no arm taken on the way here says that its end is at most the buffer's length 1, and its end is not that length" { refl }

// A view of a buffer the function is not lent.
fn homeless() → Function {
    Function(parameters := [0, 1, 4, 5], lent := 1, result := 8,
        body := then([Const(width := 64, output := 9, value := 0)],
            Lend([View(buffer := 1, home := 0, start := 9, end := 1, written := True, base := 6, length := 7)], 0, [4, 5], 8)))
}
theorem homeless_refused(): lower_program_lent([homeless(), put_at()], plan_program([homeless(), put_at()]), [1, 1]) = None { refl }
theorem homeless_why(): homeless().refused(1, homeless().plan(), 2, [1, 1], index_rooms()) =
    "the call of function 0 over views (buffer 1 from 9 to 1 written): its view of buffer 1 from 9 to 1: the scope has no home of that buffer at 0" { refl }

// One view, to a callee that takes two buffers.
fn short() → Function {
    Function(parameters := [0, 1, 4], lent := 1, result := 8,
        body := then([Const(width := 64, output := 9, value := 0)],
            Lend([View(buffer := 0, home := 0, start := 9, end := 1, written := True, base := 6, length := 7)], 0, [0, 1, 4], 8)))
}
theorem short_refused(): lower_program_lent([short(), carry_at()], plan_program([short(), carry_at()]), [2, 1]) = None { refl }
theorem short_why(): short().refused(1, short().plan(), 2, [2, 1], index_rooms()) =
    "the call of function 0 over views (buffer 0 from 9 to 1 written): the callee is lent more buffers than the call has views" { refl }

// No view: a call over none is a call.
fn viewless() → Function {
    Function(parameters := [0, 1, 4, 5], lent := 1, result := 8, body := Lend([], 0, [0, 1, 4, 5], 8))
}
theorem viewless_refused(): lower_program_lent([viewless(), put_at()], plan_program([viewless(), put_at()]), [1, 1]) = None { refl }
theorem viewless_why(): viewless().refused(1, viewless().plan(), 2, [1, 1], index_rooms()) =
    "the call of function 0 over views (): it has no view, and a call over none is written as a call" { refl }

// ---------------------------------------------------------------------------
// The checks themselves (function_ir_lower_views)

fn window(buffer: Nat, written: Bool) → View { View(buffer := buffer, home := 0, start := 2, end := 3, written := written, base := 6, length := 7) }

// A view to write and another of its buffer, with no file to say where
// they lie: apart only where one's end is the other's start, whichever
// comes first. Views of two buffers, or two to read, are apart.
fn span(start, end: Nat, written: Bool) → View { View(buffer := 0, home := 0, start := start, end := end, written := written, base := 6, length := 7) }
theorem apart_buffers(): views_apart([window(0, True), window(1, False)], File::empty()) = True { refl }
theorem apart_reading(): views_apart([window(0, False), window(0, False)], File::empty()) = True { refl }
theorem apart_same_window(): views_apart([window(0, True), window(0, False)], File::empty()) = False { refl }
theorem apart_split(): views_apart([span(2, 3, False), span(3, 4, True)], File::empty()) = True { refl }
theorem apart_split_back(): views_apart([span(3, 4, True), span(2, 3, False)], File::empty()) = True { refl }
theorem apart_unknown(): views_apart([span(2, 3, False), span(4, 5, True)], File::empty()) = False { refl }
theorem apart_both_written(): views_apart([span(2, 3, True), span(3, 4, True)], File::empty()) = True { refl }
theorem apart_both_same_window(): views_apart([window(0, True), window(0, True)], File::empty()) = False { refl }

// The homes a callee's buffers are checked against are the views', by
// position.
theorem lents_numbered(): views_lents([window(4, True), window(2, False)]) = [Lent(0, 6, 7), Lent(1, 6, 7)] { refl }

// Probes of the inline stage (lib/native/function_ir/function_ir_inline.hthr,
// docs/native/optimizer-design.md §3.1): a call replaced by its callee's body in
// a composition, an arm and a loop's body; a program inlined callees first;
// what the stage's theorem says of the inlined program; the searcher's
// plans; the plans refused; and nodes at new ids written after a leaf.
// Tests, not library: nothing imports this module.
import function_ir;
import function_ir_eval;
import function_ir_writes;
import function_ir_stage;
import function_ir_fresh;
import function_ir_inline;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

fn nodes(ns: List<Node>) → StructuredRegion { StructuredRegion::of_nodes(ns) }

// Function 1 is x ↦ (5 + x) + 5, by a call of function 0, the sum.
fn two() → List<Function> {
    [Function([0], Compose(nodes([Const(64, 1, 5)]), Compose(Call(0, [1, 0], 2, []), nodes([Add(64, 3, 2, 1)]))), 3),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]
}

// Function 1's ids are below 4 and the sum's below 3.
fn two_plans() → List<Inlines> { [Inlines(4, Both(Stay, Both(Here(3), Stay))), Inlines(3, Stay)] }

// The sum's ids 0, 1, 2 are 4, 5, 6 in the caller: its parameters moved
// from the arguments, and the call's result moved from its result.
fn two_inlined() → List<Function> {
    [Function([0], Compose(nodes([Const(64, 1, 5)]), Compose(
            Compose(nodes([Move(64, 4, 1), Move(64, 5, 0)]), Compose(nodes([Add(64, 6, 4, 5)]), nodes([Move(64, 2, 6)]))),
            nodes([Add(64, 3, 2, 1)]))), 3),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]
}

theorem two_run(): inline_stage().run(two(), two_plans()) = Some(two_inlined()) { refl }

// The inlined program does whatever the program did, a function at its
// number: the stage's one theorem.
theorem two_keeps(before: Buffers(), f: Nat, arguments: List<BitVec(64)>, result: BitVec(64), after: Buffers(),
    ran: program_effects(two(), before, f, arguments, result, after)): program_effects(two_inlined(), before, f, arguments, result, after) {
    inline_stage().run_sound(two(), two_plans(), two_inlined(), two_run(), before, f, arguments, result, after, ran)
}

// The searcher finds that plan: the least bounds, every call.
theorem two_searched(): inline_search(two(), λ _ _ => True).map(λ s => s.plans) = Some(two_plans()) { refl }

// Callees first. Function 2 calls function 1, which calls function 0, so
// function 2 takes function 1's body as inlining left it: its ids below 6,
// raised by 3.
fn three() → List<Function> {
    [Function([0], Compose(Call(1, [0], 1, []), nodes([Add(64, 2, 1, 0)])), 2),
        Function([0], Compose(nodes([Const(64, 1, 7)]), Call(0, [0, 1], 2, [])), 2),
        Function([0, 1], nodes([BitXor(64, 2, 0, 1)]), 2)]
}

fn three_plans() → List<Inlines> { [Inlines(3, Both(Here(6), Stay)), Inlines(3, Both(Stay, Here(3))), Inlines(3, Stay)] }

fn three_inlined() → List<Function> {
    [Function([0], Compose(
            Compose(nodes([Move(64, 3, 0)]), Compose(
                Compose(nodes([Const(64, 4, 7)]),
                    Compose(nodes([Move(64, 6, 3), Move(64, 7, 4)]), Compose(nodes([BitXor(64, 8, 6, 7)]), nodes([Move(64, 5, 8)])))),
                nodes([Move(64, 1, 5)]))),
            nodes([Add(64, 2, 1, 0)])), 2),
        Function([0], Compose(nodes([Const(64, 1, 7)]),
            Compose(nodes([Move(64, 3, 0), Move(64, 4, 1)]), Compose(nodes([BitXor(64, 5, 3, 4)]), nodes([Move(64, 2, 5)])))), 2),
        Function([0, 1], nodes([BitXor(64, 2, 0, 1)]), 2)]
}

theorem three_run(): inline_stage().run(three(), three_plans()) = Some(three_inlined()) { refl }

theorem three_searched(): inline_search(three(), λ _ _ => True).map(λ s => s.plans) = Some(three_plans()) { refl }

// A searcher asked for calls of function 0 alone leaves function 2's call.
theorem three_some(): inline_search(three(), λ (f: Nat) _ => f.same(0)).map(λ s => s.plans) =
    Some([Inlines(3, Both(Stay, Stay)), Inlines(3, Both(Stay, Here(3))), Inlines(3, Stay)]) { refl }

// So does a searcher asked for callees of one node: function 0 is one, and
// function 1 with function 0's body in it is five.
theorem three_small(): inline_search(three(), inline_small(1)).map(λ s => s.plans) =
    Some([Inlines(3, Both(Stay, Stay)), Inlines(3, Both(Stay, Here(3))), Inlines(3, Stay)]) { refl }
theorem three_all(): inline_search(three(), inline_small(5)).map(λ s => s.plans) = Some(three_plans()) { refl }

// A call in a conditional's arm.
fn arm() → List<Function> {
    [Function([0], Compose(nodes([Equal(64, 1, 0, 0)]),
            Conditional(Ports([]), 1, Ports([]), Ports([]), Call(0, [0, 0], 2, []), nodes([Move(64, 2, 0)]))), 2),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]
}

theorem arm_run(): inline_stage().run(arm(), [Inlines(3, Both(Stay, Arms(Here(3), Stay))), Inlines(3, Stay)]) =
    Some([Function([0], Compose(nodes([Equal(64, 1, 0, 0)]),
            Conditional(Ports([]), 1, Ports([]), Ports([]),
                Compose(nodes([Move(64, 3, 0), Move(64, 4, 0)]), Compose(nodes([Add(64, 5, 3, 4)]), nodes([Move(64, 2, 5)]))),
                nodes([Move(64, 2, 0)]))), 2),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]) { refl }

// A call in a loop's body: the body's passes have valuations of their own,
// and the callee's ids are raised past the function's bound all the same.
fn looped() → List<Function> {
    [Function([0, 1], Loop([0], 1, [2], 3, Compose(Call(0, [2, 2], 4, []), nodes([Const(1, 5, 1)])), 5, [4], [6], 7), 6),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]
}

theorem looped_run(): inline_stage().run(looped(), [Inlines(8, Body(Both(Here(3), Stay))), Inlines(3, Stay)]) =
    Some([Function([0, 1], Loop([0], 1, [2], 3,
            Compose(Compose(nodes([Move(64, 8, 2), Move(64, 9, 2)]), Compose(nodes([Add(64, 10, 8, 9)]), nodes([Move(64, 4, 10)]))),
                nodes([Const(1, 5, 1)])), 5, [4], [6], 7), 6),
        Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)]) { refl }

// Refused: a room too small for the callee's ids; a bound below the
// caller's own ids; sites of another shape than the region's.
theorem room_small(): inline_stage().run(two(), [Inlines(4, Both(Stay, Both(Here(2), Stay))), Inlines(3, Stay)]) = None { refl }
theorem bound_low(): inline_stage().run(two(), [Inlines(3, Both(Stay, Both(Here(3), Stay))), Inlines(3, Stay)]) = None { refl }
theorem shape_refused(): inline_stage().run(two(), [Inlines(4, Then(Stay)), Inlines(3, Stay)]) = None { refl }

// Refused: a call of a function the program does not have, and a call that
// lends views, which stays a call.
theorem callee_missing(): inline_stage().run([Function([0], Call(5, [0], 1, []), 1)], [Inlines(2, Here(1))]) = None { refl }

fn lends() → List<Function> { [Function([0], Lend([], 0, [0, 0], 1), 1), Function([0, 1], nodes([Add(64, 2, 0, 1)]), 2)] }

theorem lend_refused(): inline_stage().run(lends(), [Inlines(2, Here(3)), Inlines(3, Stay)]) = None { refl }
theorem lend_stays(): inline_stage().run(lends(), [Inlines(2, Stay), Inlines(3, Stay)]) = Some(lends()) { refl }

// ---------------------------------------------------------------------------
// Nodes at new ids, after a leaf

// x ↦ the byte at x of a span, plus x. The function's ids are below 4.
fn reads() → Function {
    Function([0, 1, 2], Compose(nodes([BufferLoad(3, 0, 2)]), nodes([Add(64, 3, 3, 2)])), 3, lent := 1)
}

// After the load's leaf, two leaves more: the same byte loaded again at id
// 4, and at 5 and 6 its double and that with x. Each new node reads ids
// before it, the function's or the new ones.
fn reads_put() → Inlines { Inlines(4, Both(Put(3, [[BufferLoad(4, 0, 2)], [Add(64, 5, 4, 4), BitXor(64, 6, 5, 2)]]), Stay)) }

fn reads_more() → Function {
    Function([0, 1, 2], Compose(
        Compose(nodes([BufferLoad(3, 0, 2)]), Compose(nodes([BufferLoad(4, 0, 2)]), Compose(nodes([Add(64, 5, 4, 4), BitXor(64, 6, 5, 2)]), nodes([])))),
        nodes([Add(64, 3, 3, 2)])), 3, lent := 1)
}

theorem put_run(): inline_stage().rewrite([], reads(), reads_put()) = Some(reads_more()) { refl }

// The function with the nodes does whatever the function did: the stage's
// theorem, with no premise about the nodes' values.
theorem put_keeps(): Rewrites([], reads(), reads_more()) { inline_stage().sound([], reads(), reads_put(), reads_more(), put_run()) }

// In a loop's body, whose passes have valuations of their own.
theorem put_in_loop(): inline_stage().rewrite([],
    Function([0, 1], Loop([0], 1, [2], 3, nodes([Add(64, 4, 2, 2), Const(1, 5, 1)]), 5, [4], [6], 7), 6), Inlines(8, Body(Put(1, [[Add(64, 8, 4, 2)]])))) =
    Some(Function([0, 1], Loop([0], 1, [2], 3, Compose(nodes([Add(64, 4, 2, 2), Const(1, 5, 1)]), Compose(nodes([Add(64, 8, 4, 2)]), nodes([]))),
        5, [4], [6], 7), 6)) { refl }

// Refused: a store, which is no value; an output that is one of the
// function's ids; an output past the room asked for; a node that reads
// its own output; a node that reads an id a later one writes; and nodes
// put after a region that is no leaf.
theorem put_store(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(1, [[BufferStore(4, 0, 2, 3)]]), Stay))) = None { refl }
theorem put_old_id(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(1, [[Add(64, 3, 2, 2)]]), Stay))) = None { refl }
theorem put_past_room(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(1, [[Add(64, 5, 2, 2)]]), Stay))) = None { refl }
theorem put_own_output(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(1, [[Add(64, 4, 4, 2)]]), Stay))) = None { refl }
theorem put_out_of_order(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(2, [[Add(64, 4, 5, 2)], [Add(64, 5, 2, 2)]]), Stay))) = None { refl }
theorem put_at_call(): inline_stage().run(two(), [Inlines(4, Both(Stay, Both(Put(1, [[Add(64, 4, 0, 0)]]), Stay))), Inlines(3, Stay)]) = None { refl }

// Not refused: a new node that reads an id no node writes. It has a value
// all the same, and the lowering refuses a function that reads it.
theorem put_unwritten(): inline_stage().rewrite([], reads(), Inlines(4, Both(Put(3, [[Add(64, 4, 6, 2)]]), Stay))).map(λ (f: Function) => f.result) =
    Some(3) { refl }

// Probes of `sha256_context`: where the context's words are, a word
// stored by compiled code read back through the record, what the store
// leaves, the stream's count, and laws stated at the wrong place. Tests,
// not library: nothing imports this module.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;

// Probes of `sha256_block`: the pieces `sha256_compress` is made of, on
// literal bytes, and the round constants against the specification's table.
// What the whole function computes on a block is held where it is linked
// (crates/linked/tests/sha256.rs): sixty-four rounds are not run by
// conversion here.
//
// And the regression of issues/runtime-link-compares-functions.md for
// functions that only read: a caller and its callee of one Heather type,
// both heavy. Before that issue's change the generator's link check ran
// out of its budget on the pair; the writing pairs, plain and measured,
// are `sha256_block`'s own (`sha256_step` and `sha256_turn`,
// `sha256_rounds` and `sha256_step`). A measured function that only reads
// and calls one this heavy is refused for another reason
// (issues/runtime-measured-reader-heavy-callee.md). Tests, not library:
// nothing imports this module.
import sha256_block;
import sha256_round;
import sha2;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import bool;
import list;
import logic;
import nat;
import option;
import pair;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import derive;
import char;
import string;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;
import runtime;

fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }

fn six() → List<BitVec(8)> { [b(0x01), b(0x23), b(0x45), b(0x67), b(0x89), b(0xab)] }

// ---------------------------------------------------------------------------
// Words in a span

// Four bytes, the most significant first.
theorem word_at_start(): sha256_word_at(six(), w(6), w(0)) = w(0x01234567) { refl }
theorem word_at_two(): sha256_word_at(six(), w(6), w(2)) = w(0x456789ab) { refl }
// A byte past the end, or past the length word, is read as zero and
// nowhere.
theorem word_past_end(): sha256_word_at(six(), w(6), w(4)) = w(0x89ab0000) { refl }
theorem word_under_length(): sha256_word_at(six(), w(2), w(0)) = w(0x01230000) { refl }

// A word's low four bytes are stored, and what is above them is not.
theorem put_stores_four(): List::sha256_put_word(six(), w(6), w(1), w(0xdeadbeef)).after = [b(0x01), b(0xde), b(0xad), b(0xbe), b(0xef), b(0xab)] { refl }
theorem put_low_half_only(): List::sha256_put_word(six(), w(6), w(1), w(0x7deadbeef)).after = [b(0x01), b(0xde), b(0xad), b(0xbe), b(0xef), b(0xab)] { refl }
theorem put_then_read(): sha256_word_at(List::sha256_put_word(six(), w(6), w(1), w(0xdeadbeef)).after, w(6), w(1)) = w(0xdeadbeef) { refl }
// Nothing is stored past the end.
theorem put_at_end(): List::sha256_put_word(six(), w(6), w(4), w(0xdeadbeef)).after = [b(0x01), b(0x23), b(0x45), b(0x67), b(0xde), b(0xad)] { refl }

// ---------------------------------------------------------------------------
// The round constants

// `sha256_k` from `t` on is the table from there.
fn constants_from(ks: List<Nat>, t: Nat) → Bool {
    match ks {
        Nil => True,
        Cons(k, rest) => sha256_k(w(t)).eq_bit(w(k)) && constants_from(rest, t + 1),
    }
}

// All sixty-four, against FIPS 180-4 §4.2.2 as the specification holds it.
theorem constants_are_the_table(): constants_from(Sha2::k256(), 0) = True { refl }
theorem table_is_64(): Sha2::k256().len() = 64 { refl }
// Past the table the halving ends at the last: no round asks.
theorem constant_past_table(): sha256_k(w(64)) = w(0xc67178f2) { refl }

// ---------------------------------------------------------------------------
// A caller and a callee of one type, reading

// T1 of round `t` from the context, as `sha256_step` computes it.
runtime fn probe_t1(ctx: List<BitVec(8)>, cn, t: BitVec(64)) → BitVec(64) {
    sha256_t1(sha256_word_at(ctx, cn, BitVec::ofNat(60)), sha256_word_at(ctx, cn, BitVec::ofNat(48)), sha256_word_at(ctx, cn, BitVec::ofNat(52)),
        sha256_word_at(ctx, cn, BitVec::ofNat(56)), sha256_k(t), sha256_word_at(ctx, cn, t.shift_left(2).add(BitVec::ofNat(64))))
}

// Its caller, of the same type. That the two are `runtime fn`s at all is
// the probe: each instance's link check is run by the generator.
runtime fn probe_sum(ctx: List<BitVec(8)>, cn, t: BitVec(64)) → BitVec(64) {
    probe_t1(ctx, cn, t).add(sha256_t2(sha256_word_at(ctx, cn, t), sha256_word_at(ctx, cn, t.add(BitVec::ofNat(4))),
        sha256_word_at(ctx, cn, t.add(BitVec::ofNat(8)))))
}

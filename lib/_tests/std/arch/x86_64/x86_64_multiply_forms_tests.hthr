// `sar %cl, %r64` for every register.
theorem sar_cl_encodings(): encodings([shift_cl_bytes(OpSar, Rax), shift_cl_bytes(OpSar, Rcx), shift_cl_bytes(OpSar, Rdx), shift_cl_bytes(OpSar, Rbx), shift_cl_bytes(OpSar, Rsp), shift_cl_bytes(OpSar, Rbp), shift_cl_bytes(OpSar, Rsi), shift_cl_bytes(OpSar, Rdi), shift_cl_bytes(OpSar, R8), shift_cl_bytes(OpSar, R9), shift_cl_bytes(OpSar, R10), shift_cl_bytes(OpSar, R11), shift_cl_bytes(OpSar, R12), shift_cl_bytes(OpSar, R13), shift_cl_bytes(OpSar, R14), shift_cl_bytes(OpSar, R15)]) =

// ---------------------------------------------------------------------------
// Read back: the instruction decoder and the step-form decoder.

theorem imul_decodes(): decode_instruction(imul_bytes(R13, Rsi)) = Some(decoded_canonical(ImulRR(R13, Rsi))) { refl }
theorem mul_decodes(): decode_instruction(mul_bytes(R11)) = Some(decoded_canonical(MulR(R11))) { refl }
theorem shift_cl_decodes(): decode_instruction(shift_cl_bytes(OpSar, R12)) = Some(decoded_canonical(ShiftCl(OpSar, R12))) { refl }
theorem imul_step_form(): decode_step_form(imul_bytes(Rdi, R14)) = Some(FormEmitted(EmitOrdinary(ImulRR(Rdi, R14)))) { refl }
theorem mul_step_form(): decode_step_form(mul_bytes(Rbp)) = Some(FormEmitted(EmitOrdinary(MulR(Rbp)))) { refl }
theorem shift_cl_step_form(): decode_step_form(shift_cl_bytes(OpShr, R9)) = Some(FormEmitted(EmitOrdinary(ShiftCl(OpShr, R9)))) { refl }
// The byte load beside IMUL under REX.W 0F still reads back.
theorem byte_load_still_step_form(): decode_step_form([b(0x48), b(0x0f), b(0xb6), b(0x06)]) =
    Some(FormEmitted(EmitLoad(ByteLoad(destination := Rax, base := Rsi)))) { refl }
// F7 /6 is DIV (x86_64_divide_forms_tests), and F7 /7 IDIV, which the
// model does not have.
theorem div_beside_mul(): decode_instruction([b(0x48), b(0xf7), b(0xf3)]) = Some(decoded_canonical(DivR(Rbx))) { refl }
theorem idiv_refused(): decode_instruction([b(0x48), b(0xf7), b(0xfb)]) = None { refl }
// D3 /1 is ROR by CL, which the model does not have.
theorem ror_cl_refused(): decode_instruction([b(0x48), b(0xd3), b(0xc8)]) = None { refl }

// ---------------------------------------------------------------------------
// Every flag is undefined after each, and nothing reads them: a SETcc after
// any of the three is refused.

theorem imul_then_setb_refused(): block_reads([CmpRR(Rax, Rbx), ImulRR(Rax, Rbx), SetBelow(Al)], DefinedFlags::none()) = False { refl }
theorem mul_then_sete_refused(): block_reads([CmpRR(Rax, Rbx), MulR(Rbx), SetEqual(Al)], DefinedFlags::none()) = False { refl }
theorem shift_cl_then_setl_refused(): block_reads([CmpRR(Rax, Rbx), ShiftCl(OpShl, Rax), SetLess(Al)], DefinedFlags::none()) = False { refl }
theorem compare_after_multiply_reads(): block_reads([ImulRR(Rax, Rbx), CmpRR(Rax, Rbx), SetBelow(Al)], DefinedFlags::none()) = True { refl }

// ---------------------------------------------------------------------------
// The processor's results: the edge words multiplied in pairs, and shifted
// at counts 0, 1, 7, 63, 64, 65 and 255 (the last three masked to 0, 1
// and 63).

theorem imul_on_the_cpu(): words([after(ImulRR(Rax, Rbx), state(w(0x0000000000000000), w(0x00000000ffffffff), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0xffffffffffffffff), w(0xffffffff00000000), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0x8000000000000000), w(0x0123456789abcdef), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0x00000000ffffffff), w(0x0000000000000001), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0xffffffff00000000), w(0x8000000000000001), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0x0123456789abcdef), w(0x0000000000000000), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0x0000000000000001), w(0xffffffffffffffff), w(0)), Rax), after(ImulRR(Rax, Rbx), state(w(0x8000000000000001), w(0x8000000000000000), w(0)), Rax)]) =
    [w(0x0000000000000000), w(0x0000000100000000), w(0x8000000000000000), w(0x00000000ffffffff), w(0xffffffff00000000), w(0x0000000000000000), w(0xffffffffffffffff), w(0x8000000000000000)] { refl }

theorem mul_low_on_the_cpu(): words([after(MulR(Rbx), state(w(0x0000000000000000), w(0x00000000ffffffff), w(0)), Rax), after(MulR(Rbx), state(w(0xffffffffffffffff), w(0xffffffff00000000), w(0)), Rax), after(MulR(Rbx), state(w(0x8000000000000000), w(0x0123456789abcdef), w(0)), Rax), after(MulR(Rbx), state(w(0x00000000ffffffff), w(0x0000000000000001), w(0)), Rax), after(MulR(Rbx), state(w(0xffffffff00000000), w(0x8000000000000001), w(0)), Rax), after(MulR(Rbx), state(w(0x0123456789abcdef), w(0x0000000000000000), w(0)), Rax), after(MulR(Rbx), state(w(0x0000000000000001), w(0xffffffffffffffff), w(0)), Rax), after(MulR(Rbx), state(w(0x8000000000000001), w(0x8000000000000000), w(0)), Rax)]) =
    [w(0x0000000000000000), w(0x0000000100000000), w(0x8000000000000000), w(0x00000000ffffffff), w(0xffffffff00000000), w(0x0000000000000000), w(0xffffffffffffffff), w(0x8000000000000000)] { refl }

theorem mul_high_on_the_cpu(): words([after(MulR(Rbx), state(w(0x0000000000000000), w(0x00000000ffffffff), w(0)), Rdx), after(MulR(Rbx), state(w(0xffffffffffffffff), w(0xffffffff00000000), w(0)), Rdx), after(MulR(Rbx), state(w(0x8000000000000000), w(0x0123456789abcdef), w(0)), Rdx), after(MulR(Rbx), state(w(0x00000000ffffffff), w(0x0000000000000001), w(0)), Rdx), after(MulR(Rbx), state(w(0xffffffff00000000), w(0x8000000000000001), w(0)), Rdx), after(MulR(Rbx), state(w(0x0123456789abcdef), w(0x0000000000000000), w(0)), Rdx), after(MulR(Rbx), state(w(0x0000000000000001), w(0xffffffffffffffff), w(0)), Rdx), after(MulR(Rbx), state(w(0x8000000000000001), w(0x8000000000000000), w(0)), Rdx)]) =
    [w(0x0000000000000000), w(0xfffffffeffffffff), w(0x0091a2b3c4d5e6f7), w(0x0000000000000000), w(0x7fffffff80000000), w(0x0000000000000000), w(0x0000000000000000), w(0x4000000000000000)] { refl }

theorem shl_cl_0_on_the_cpu(): words([after(ShiftCl(OpShl, Rax), state(w(0x0000000000000000), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0xffffffffffffffff), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0x8000000000000000), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0x00000000ffffffff), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0xffffffff00000000), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0x0123456789abcdef), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0x0000000000000001), w(0x0), w(0)), Rax), after(ShiftCl(OpShl, Rax), state(w(0x8000000000000001), w(0x0), w(0)), Rax)]) =

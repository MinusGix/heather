// IMUL r64, r/m64 (`ImulRR`), MUL r/m64 (`MulR`) and the shifts by CL
// (`ShiftCl`), x86_64: the bytes the model writes are the assembler's for
// every register, the decoders read them back, and the model's results are
// the processor's. Tests, not library (docs/test-value-audit.md §4.5).
//
// The encodings are `as` (GNU Binutils 2.42), disassembled by `objdump`.
// The processor's results are from running the same bytes on the x86-64
// machine these tests were written on (an Intel Xeon, a C harness with the
// bytes inline): 3,000,000 operand triples, the eight edge words below
// among them, checked against the meaning the model gives (the low word of
// the product, the high word of the unsigned product, a shift by the count
// masked to six bits), counts drawn over the whole word, below 64 and below
// 300; no mismatch. The run is not repeated by the suite. The flags are
// undefined in the model after all three, so no flag is compared.
import x86_64; import x86_64_step_forms; import x86_64_block;
import bitvec; import bool; import list; import logic; import nat; import option;

fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn encodings(xs: List<List<BitVec(8)>>) → List<List<BitVec(8)>> { xs }
fn words(xs: List<BitVec(64)>) → List<BitVec(64)> { xs }

// Registers holding `a` in RAX, `b` in RBX and `c` in RCX.
fn state(a, b, c: BitVec(64)) → Gprs { write_gpr(Rcx, c, write_gpr(Rbx, b, write_gpr(Rax, a, zero_gprs()))) }

// `register` after the instruction runs from `gprs`.
fn after(instruction: Instruction, gprs: Gprs, register: Gpr) → BitVec(64) {
    read_gpr(register, execute_register(instruction, gprs, clear_flags()).gprs)
}

// ---------------------------------------------------------------------------
// The encodings

// `imul %rbx, %r64` for every destination.
theorem imul_destination_encodings(): encodings([imul_bytes(Rax, Rbx), imul_bytes(Rcx, Rbx), imul_bytes(Rdx, Rbx), imul_bytes(Rbx, Rbx), imul_bytes(Rsp, Rbx), imul_bytes(Rbp, Rbx), imul_bytes(Rsi, Rbx), imul_bytes(Rdi, Rbx), imul_bytes(R8, Rbx), imul_bytes(R9, Rbx), imul_bytes(R10, Rbx), imul_bytes(R11, Rbx), imul_bytes(R12, Rbx), imul_bytes(R13, Rbx), imul_bytes(R14, Rbx), imul_bytes(R15, Rbx)]) =
    [[b(0x48), b(0x0f), b(0xaf), b(0xc3)], [b(0x48), b(0x0f), b(0xaf), b(0xcb)], [b(0x48), b(0x0f), b(0xaf), b(0xd3)], [b(0x48), b(0x0f), b(0xaf), b(0xdb)], [b(0x48), b(0x0f), b(0xaf), b(0xe3)], [b(0x48), b(0x0f), b(0xaf), b(0xeb)], [b(0x48), b(0x0f), b(0xaf), b(0xf3)], [b(0x48), b(0x0f), b(0xaf), b(0xfb)], [b(0x4c), b(0x0f), b(0xaf), b(0xc3)], [b(0x4c), b(0x0f), b(0xaf), b(0xcb)], [b(0x4c), b(0x0f), b(0xaf), b(0xd3)], [b(0x4c), b(0x0f), b(0xaf), b(0xdb)], [b(0x4c), b(0x0f), b(0xaf), b(0xe3)], [b(0x4c), b(0x0f), b(0xaf), b(0xeb)], [b(0x4c), b(0x0f), b(0xaf), b(0xf3)], [b(0x4c), b(0x0f), b(0xaf), b(0xfb)]] { refl }

// `imul %r64, %r9` for every source.
theorem imul_source_encodings(): encodings([imul_bytes(R9, Rax), imul_bytes(R9, Rcx), imul_bytes(R9, Rdx), imul_bytes(R9, Rbx), imul_bytes(R9, Rsp), imul_bytes(R9, Rbp), imul_bytes(R9, Rsi), imul_bytes(R9, Rdi), imul_bytes(R9, R8), imul_bytes(R9, R9), imul_bytes(R9, R10), imul_bytes(R9, R11), imul_bytes(R9, R12), imul_bytes(R9, R13), imul_bytes(R9, R14), imul_bytes(R9, R15)]) =
    [[b(0x4c), b(0x0f), b(0xaf), b(0xc8)], [b(0x4c), b(0x0f), b(0xaf), b(0xc9)], [b(0x4c), b(0x0f), b(0xaf), b(0xca)], [b(0x4c), b(0x0f), b(0xaf), b(0xcb)], [b(0x4c), b(0x0f), b(0xaf), b(0xcc)], [b(0x4c), b(0x0f), b(0xaf), b(0xcd)], [b(0x4c), b(0x0f), b(0xaf), b(0xce)], [b(0x4c), b(0x0f), b(0xaf), b(0xcf)], [b(0x4d), b(0x0f), b(0xaf), b(0xc8)], [b(0x4d), b(0x0f), b(0xaf), b(0xc9)], [b(0x4d), b(0x0f), b(0xaf), b(0xca)], [b(0x4d), b(0x0f), b(0xaf), b(0xcb)], [b(0x4d), b(0x0f), b(0xaf), b(0xcc)], [b(0x4d), b(0x0f), b(0xaf), b(0xcd)], [b(0x4d), b(0x0f), b(0xaf), b(0xce)], [b(0x4d), b(0x0f), b(0xaf), b(0xcf)]] { refl }

// `mul %r64` for every register.
theorem mul_encodings(): encodings([mul_bytes(Rax), mul_bytes(Rcx), mul_bytes(Rdx), mul_bytes(Rbx), mul_bytes(Rsp), mul_bytes(Rbp), mul_bytes(Rsi), mul_bytes(Rdi), mul_bytes(R8), mul_bytes(R9), mul_bytes(R10), mul_bytes(R11), mul_bytes(R12), mul_bytes(R13), mul_bytes(R14), mul_bytes(R15)]) =
    [[b(0x48), b(0xf7), b(0xe0)], [b(0x48), b(0xf7), b(0xe1)], [b(0x48), b(0xf7), b(0xe2)], [b(0x48), b(0xf7), b(0xe3)], [b(0x48), b(0xf7), b(0xe4)], [b(0x48), b(0xf7), b(0xe5)], [b(0x48), b(0xf7), b(0xe6)], [b(0x48), b(0xf7), b(0xe7)], [b(0x49), b(0xf7), b(0xe0)], [b(0x49), b(0xf7), b(0xe1)], [b(0x49), b(0xf7), b(0xe2)], [b(0x49), b(0xf7), b(0xe3)], [b(0x49), b(0xf7), b(0xe4)], [b(0x49), b(0xf7), b(0xe5)], [b(0x49), b(0xf7), b(0xe6)], [b(0x49), b(0xf7), b(0xe7)]] { refl }

// `shl %cl, %r64` for every register.
theorem shl_cl_encodings(): encodings([shift_cl_bytes(OpShl, Rax), shift_cl_bytes(OpShl, Rcx), shift_cl_bytes(OpShl, Rdx), shift_cl_bytes(OpShl, Rbx), shift_cl_bytes(OpShl, Rsp), shift_cl_bytes(OpShl, Rbp), shift_cl_bytes(OpShl, Rsi), shift_cl_bytes(OpShl, Rdi), shift_cl_bytes(OpShl, R8), shift_cl_bytes(OpShl, R9), shift_cl_bytes(OpShl, R10), shift_cl_bytes(OpShl, R11), shift_cl_bytes(OpShl, R12), shift_cl_bytes(OpShl, R13), shift_cl_bytes(OpShl, R14), shift_cl_bytes(OpShl, R15)]) =

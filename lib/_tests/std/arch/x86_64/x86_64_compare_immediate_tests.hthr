// Negative control: CMP sign-extends its immediate, so a model that
// zero-extended -128 would find 0x80 equal to it, which the processor does
// not.
// expect-error: `refl` needs both sides to be definitionally equal
theorem cmp8_zero_extended(): sub_flags(w(0x80), b(0x80).zero_extend(56)).bits() = [True, True, False, False, False, False] { refl }

// Negative control: MOV r32 clears the upper half, so a model that kept it
// would be refused here.
// expect-error: `refl` needs both sides to be definitionally equal
theorem mov32_keeps_upper(): mov32(0xffffffffffffffff, 0x1) = w(0xffffffff00000001) { refl }


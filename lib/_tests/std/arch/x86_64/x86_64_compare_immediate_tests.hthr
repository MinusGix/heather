// CMP r64, imm8 and CMP r64, imm32 (`CmpRI8`, `CmpRI32`, x86_64) and
// MOV r32, imm32 (`MovRI32`): the bytes the model writes are the
// assembler's, every register, and the model's results are the
// processor's. Tests, not library (docs/test-value-audit.md §4.5).
//
// The encoding theorems are generated from `as` (GNU Binutils 2.42),
// `cmpq` as written and `{rex} movl` (the model always writes a REX,
// which `as` omits where the register does not need it), disassembled by
// `objdump`. For RAX `as` chooses CMP's short `3D id` form, which the
// model does not write; the model's `48 81 F8 id` for it is what
// `objdump` reads as `cmp $imm32, %rax`, sign-extended. The processor's
// results are from running the model's bytes on the x86-64 machine these
// tests were written on (a C harness with the bytes inline, flags read by
// PUSHFQ): every edge immediate against twelve edge operands and the
// random ones against three each below, and 1,920,576 more cases (40,000
// random operands per immediate, half of the CMP imm8 ones sharing the
// immediate's low byte) checked against the bytes' meaning. Neither run is
// repeated by the suite.
import x86_64;
import bitvec; import bool; import list; import logic; import nat; import option;

fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn d(n: Nat) → BitVec(32) { BitVec::ofNat(n) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
// The lists below are compared as these, so their literals have a type.
fn encodings(xs: List<List<BitVec(8)>>) → List<List<BitVec(8)>> { xs }
fn words(xs: List<BitVec(64)>) → List<BitVec(64)> { xs }
fn flag_lists(xs: List<List<Bool>>) → List<List<Bool>> { xs }

// CF, PF, AF, ZF, SF, OF: the flags CMP defines, in EFLAGS' bit order.
fn Flags::bits(self f: Flags) → List<Bool> { [f.cf, f.pf, f.af, f.zf, f.sf, f.of] }

// RAX holding `a`, every other register zero.
fn holding(a: Nat) → Gprs { write_gpr(Rax, w(a), zero_gprs()) }

fn cmp8(a, imm: Nat) → List<Bool> { execute_register(CmpRI8(Rax, b(imm)), holding(a), clear_flags()).flags.bits() }
fn cmp32(a, imm: Nat) → List<Bool> { execute_register(CmpRI32(Rax, d(imm)), holding(a), clear_flags()).flags.bits() }
fn mov32(a, imm: Nat) → BitVec(64) { read_gpr(Rax, execute_register(MovRI32(Rax, d(imm)), holding(a), clear_flags()).gprs) }

// ---------------------------------------------------------------------------
// The encodings

theorem cmp_ri8_encodings(): encodings([cmp_ri8_bytes(Rax, b(0x40)), cmp_ri8_bytes(Rcx, b(0x40)), cmp_ri8_bytes(Rdx, b(0x40)), cmp_ri8_bytes(Rbx, b(0x40)), cmp_ri8_bytes(Rsp, b(0x40)), cmp_ri8_bytes(Rbp, b(0x40)), cmp_ri8_bytes(Rsi, b(0x40)), cmp_ri8_bytes(Rdi, b(0x40)), cmp_ri8_bytes(R8, b(0x40)), cmp_ri8_bytes(R9, b(0x40)), cmp_ri8_bytes(R10, b(0x40)), cmp_ri8_bytes(R11, b(0x40)), cmp_ri8_bytes(R12, b(0x40)), cmp_ri8_bytes(R13, b(0x40)), cmp_ri8_bytes(R14, b(0x40)), cmp_ri8_bytes(R15, b(0x40))]) =

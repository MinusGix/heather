// The decoders read each form back: a CMP's /7 is not an ADD's /0, and the
// other /r of 83 and 81 (OR, ADC, SBB, AND, SUB, XOR) are no instruction of
// the model.
theorem cmp_ri8_decodes(): decode_instruction([b(0x49), b(0x83), b(0xff), b(0x80)]) =
    Some(decoded_canonical(CmpRI8(R15, b(0x80)))) { refl }
theorem cmp_ri32_decodes(): decode_instruction([b(0x48), b(0x81), b(0xf8), b(0x00), b(0x00), b(0x00), b(0x80)]) =
    Some(decoded_canonical(CmpRI32(Rax, d(0x80000000)))) { refl }
theorem mov_ri32_decodes(): decode_instruction([b(0x41), b(0xbc), b(0x78), b(0x56), b(0x34), b(0x12)]) =
    Some(decoded_canonical(MovRI32(R12, d(0x12345678)))) { refl }
theorem add_ri8_still_add(): decode_instruction([b(0x48), b(0x83), b(0xc0), b(0x40)]) =
    Some(decoded_canonical(AddRI8(Rax, b(0x40)))) { refl }
theorem sub_ri8_is_none(): decode_instruction([b(0x48), b(0x83), b(0xe8), b(0x40)]) = None { refl }
theorem sub_ri32_is_none(): decode_instruction([b(0x48), b(0x81), b(0xe8), b(0x00), b(0x00), b(0x00), b(0x80)]) = None { refl }


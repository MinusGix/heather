// DIV r/m64 (`DivR`), x86_64: the bytes the model writes are the
// assembler's for every register, the decoders read them back, the model
// faults exactly where the processor does, and its quotient and remainder
// are the processor's. Tests, not library (docs/test-value-audit.md §4.5).
//
// The encodings are `as` (GNU Binutils 2.42), disassembled by `objdump`.
// The processor's results are from running `div` on the x86-64 machine
// these tests were written on (an Intel Xeon, a C harness with the
// instruction inline and a SIGFPE handler): 3,000,000 random triples
// (RDX, RAX, divisor), with RDX zero, below the divisor or anything and
// small divisors among them, 625,055 of which faulted; the processor
// faulted exactly when the divisor was at most RDX (`div_faults`), and
// otherwise left the 128-bit quotient and remainder; no mismatch. The run
// is not repeated by the suite. The tables below are the ten edge words'
// cases, read off the same harness. The flags are undefined in the model,
// so no flag is compared.
import x86_64; import x86_64_step_forms; import x86_64_block;
import bitvec; import bool; import list; import logic; import nat; import option;

fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn encodings(xs: List<List<BitVec(8)>>) → List<List<BitVec(8)>> { xs }
fn words(xs: List<BitVec(64)>) → List<BitVec(64)> { xs }
fn bools(xs: List<Bool>) → List<Bool> { xs }

// ---------------------------------------------------------------------------
// The encodings

// `div %r64` for every register.
theorem div_encodings(): encodings([div_bytes(Rax), div_bytes(Rcx), div_bytes(Rdx), div_bytes(Rbx), div_bytes(Rsp), div_bytes(Rbp), div_bytes(Rsi), div_bytes(Rdi), div_bytes(R8), div_bytes(R9), div_bytes(R10), div_bytes(R11), div_bytes(R12), div_bytes(R13), div_bytes(R14), div_bytes(R15)]) =
    [[b(0x48), b(0xf7), b(0xf0)], [b(0x48), b(0xf7), b(0xf1)], [b(0x48), b(0xf7), b(0xf2)], [b(0x48), b(0xf7), b(0xf3)], [b(0x48), b(0xf7), b(0xf4)], [b(0x48), b(0xf7), b(0xf5)], [b(0x48), b(0xf7), b(0xf6)], [b(0x48), b(0xf7), b(0xf7)], [b(0x49), b(0xf7), b(0xf0)], [b(0x49), b(0xf7), b(0xf1)], [b(0x49), b(0xf7), b(0xf2)], [b(0x49), b(0xf7), b(0xf3)], [b(0x49), b(0xf7), b(0xf4)], [b(0x49), b(0xf7), b(0xf5)], [b(0x49), b(0xf7), b(0xf6)], [b(0x49), b(0xf7), b(0xf7)]] { refl }

// ---------------------------------------------------------------------------
// Read back: the instruction decoder and the step-form decoder.

theorem div_decodes(): decode_instruction(div_bytes(R11)) = Some(decoded_canonical(DivR(R11))) { refl }
theorem div_step_form(): decode_step_form(div_bytes(Rbp)) = Some(FormEmitted(EmitOrdinary(DivR(Rbp)))) { refl }
// MUL beside it still reads back.
theorem mul_still_decodes(): decode_instruction(mul_bytes(Rbx)) = Some(decoded_canonical(MulR(Rbx))) { refl }
// F7 /7 is IDIV, which the model does not have.
theorem idiv_refused(): decode_instruction([b(0x48), b(0xf7), b(0xfb)]) = None { refl }

// ---------------------------------------------------------------------------
// It may fault, so a block does not admit it on its own; nothing reads its
// flags.

theorem div_may_fault(): DivR(Rbx).may_fault() = True { refl }
theorem div_not_admitted(): block_reads([DivR(Rbx)], DefinedFlags::none()) = False { refl }
theorem div_leaves_no_flag(): DivR(Rbx).defines(DefinedFlags::all()) = DefinedFlags::none() { refl }

// A block holding DIV runs under a proof that it does not fault: with RDX
// cleared first, a nonzero divisor is that proof, at any state.
theorem cleared_divide_runs<M>(s: MachineState<M>, nonzero: read_gpr(Rbx, s.gprs) ≠ BitVec::zero()):
    ExecuteBlock([XorRR(Rdx, Rdx), DivR(Rbx)], s, execute_block_normal([XorRR(Rdx, Rdx), DivR(Rbx)], s)) {
    canonical_block_executes_guarded<M>([XorRR(Rdx, Rdx), DivR(Rbx)], s, refl,
        ⟨refl, ⟨div_fits_cleared(read_gpr(Rdx, s.gprs), read_gpr(Rbx, s.gprs), nonzero), trivial⟩⟩)
}

// The control: at a zero divisor no proof of `NoFaults` exists.
theorem zero_divide_faults<M>(s: MachineState<M>, zero: read_gpr(Rbx, s.gprs) = BitVec::zero()):
    ¬NoFaults([XorRR(Rdx, Rdx), DivR(Rbx)], s) {
    λ safe => absurd(trans(sym(safe.right.left),
        j(sym(zero), λ d _ => div_faults(read_gpr(Rdx, s.gprs).bxor(read_gpr(Rdx, s.gprs)), d) = True, refl)))
}

// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// The decoders read the forms back, and REX.W tells them apart

theorem bswap32_decodes(): decode_instruction(bswap32_bytes(R13)) = Some(decoded_canonical(Bswap32(R13))) { refl }
theorem bswap32_step_form(): decode_step_form(bswap32_bytes(R13)) = Some(FormEmitted(EmitOrdinary(Bswap32(R13)))) { refl }
theorem dword_load_decodes(): decode_step_form(dword_load_bytes(DwordLoad(destination := R10, base := R12))) =
    Some(FormEmitted(EmitDwordLoad(DwordLoad(destination := R10, base := R12)))) { refl }
theorem dword_store_decodes(): decode_step_form(dword_store_bytes(DwordStore(base := R14, source := R11))) =
    Some(FormStore(StoreDword(DwordStore(base := R14, source := R11)))) { refl }
theorem word_load_stays_a_word(): decode_step_form([b(0x48), b(0x8b), b(0x00)]) =
    Some(FormEmitted(EmitWordLoad(WordLoad(destination := Rax, base := Rax)))) { refl }
theorem dword_load_is_not_a_word(): decode_step_form([b(0x40), b(0x8b), b(0x00)]) =
    Some(FormEmitted(EmitDwordLoad(DwordLoad(destination := Rax, base := Rax)))) { refl }
theorem word_store_stays_a_word(): decode_step_form([b(0x48), b(0x89), b(0x10)]) =
    Some(FormStore(StoreWord(WordStore(base := Rax, source := Rdx)))) { refl }
// SETcc under a REX is still SETcc: only BSWAP's opcode has bit 6 set.
theorem rex_setcc_unchanged(): decode_step_form([b(0x40), b(0x0f), b(0x94), b(0xc6)]) =
    Some(FormEmitted(EmitOrdinary(SetEqual(Sil)))) { refl }
// Negative control: a 32-bit load from [rbx + rcx*8] is no form.
theorem dword_indexed_is_none(): decode_step_form([b(0x40), b(0x8b), b(0x04), b(0xcb)]) = None { refl }


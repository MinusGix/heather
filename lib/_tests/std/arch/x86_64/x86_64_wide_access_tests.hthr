// MOV r32, [base] (`DwordLoad`, x86_64_data_read), MOV [base], r32
// (`DwordStore`, x86_64_store) and BSWAP r32 (`Bswap32`, x86_64): the bytes
// the model writes are the assembler's, every register and base, the
// decoders read them back apart from the 64-bit forms, and the model's
// results are the processor's. Tests, not library
// (docs/test-value-audit.md §4.5).
//
// The encoding theorems are generated from `as` (GNU Binutils 2.42) with
// `{rex}` before each instruction, since the model always writes a REX and
// `as` omits one the registers do not need: 16 BSWAPs, 256 loads (every
// base and destination) and 192 stores (every plain base and source),
// disassembled by `objdump`. The processor's results are from running the
// same bytes on the x86-64 machine these tests were written on (a C
// harness with the bytes inline): the 8 edge operands and 16 random ones
// below, and 1,000,000 more random ones checked against the bytes'
// meaning. Neither run is repeated by the suite.
import x86_64; import x86_64_data_read; import x86_64_fetched_code; import x86_64_store; import x86_64_step_forms;
import bitvec; import bool; import list; import logic; import nat; import option;

fn b(n: Nat) → BitVec(8) { BitVec::ofNat(n) }
fn w(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
// The lists below are compared as these, so their literals have a type.
fn encodings(xs: List<List<BitVec(8)>>) → List<List<BitVec(8)>> { xs }
fn words(xs: List<BitVec(64)>) → List<BitVec(64)> { xs }

// ---------------------------------------------------------------------------
// The encodings

// BSWAP r32 for every register: `{rex} bswap` as assembled.
theorem bswap32_encodings(): encodings([bswap32_bytes(Rax), bswap32_bytes(Rcx), bswap32_bytes(Rdx), bswap32_bytes(Rbx), bswap32_bytes(Rsp), bswap32_bytes(Rbp), bswap32_bytes(Rsi), bswap32_bytes(Rdi), bswap32_bytes(R8), bswap32_bytes(R9), bswap32_bytes(R10), bswap32_bytes(R11), bswap32_bytes(R12), bswap32_bytes(R13), bswap32_bytes(R14), bswap32_bytes(R15)]) =
    [[b(0x40), b(0x0f), b(0xc8)], [b(0x40), b(0x0f), b(0xc9)], [b(0x40), b(0x0f), b(0xca)], [b(0x40), b(0x0f), b(0xcb)], [b(0x40), b(0x0f), b(0xcc)], [b(0x40), b(0x0f), b(0xcd)], [b(0x40), b(0x0f), b(0xce)], [b(0x40), b(0x0f), b(0xcf)], [b(0x41), b(0x0f), b(0xc8)], [b(0x41), b(0x0f), b(0xc9)], [b(0x41), b(0x0f), b(0xca)], [b(0x41), b(0x0f), b(0xcb)], [b(0x41), b(0x0f), b(0xcc)], [b(0x41), b(0x0f), b(0xcd)], [b(0x41), b(0x0f), b(0xce)], [b(0x41), b(0x0f), b(0xcf)]] { refl }

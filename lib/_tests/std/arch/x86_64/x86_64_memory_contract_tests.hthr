// Probes of the x86 memory contract (x86_64_memory_contract;
// issues/x86-memory-contract.md): two spans of a data region lent above an
// offset `top`, the first to write and the second to read, by
// `DataRegion::loan`, and what the laws give a borrower and its caller, for
// one byte stored and for four in one store; a heap with a shadow over
// them, a reference stored and loaded back. Then the
// controls: no lending has a written span that shares its first byte with
// another, and a doubleword load is refused over part of a reference.
// Tests, not library: nothing imports this module.
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_stack;
import x86_64_memory_contract;
import x86_64_memory_tiers;
import x86_64_byte_memory;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import function_ir;
import function_ir_writes;
import function_ir_lower_reads;
import function_ir_lower_calls;
import memory;
import bitvec;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Two spans of sixteen bytes, the first written

fn pair_size(b: Nat) → Nat { match b { Zero => 16, Succ(k) => match k { Zero => 16, Succ(_) => 0 } } }
fn pair_offset(top, b: Nat) → Nat { match b { Zero => top, Succ(_) => top + 16 } }
fn pair_at(r: DataRegion, top, b: Nat) → BitVec(64) {
    match b { Zero => next_rip(r.low, top), Succ(k) => match k { Zero => next_rip(r.low, top + 16), Succ(_) => BitVec::zero() } }
}
fn pair_written(b: Nat) → Bool { match b { Zero => True, Succ(_) => False } }

fn pair_spans(r: DataRegion, top: Nat) → Spans { Spans(λ b => pair_at(r, top, b), pair_size, pair_written) }

theorem pair_placed(r: DataRegion, top: Nat, fits: top + 32 <= r.size, b: Nat): 0 < pair_size(b) →
    (pair_at(r, top, b) = next_rip(r.low, pair_offset(top, b))) ∧ ((top <= pair_offset(top, b)) ∧ (pair_offset(top, b) + pair_size(b) <= r.size)) {
    let here: (top <= top) = omega;
    let whole: (top + 16 <= r.size) = omega(fits);
    let above: (top <= top + 16) = omega;
    let all: (top + 16 + 16 <= r.size) = omega(fits);
    match b {
        Zero => λ _ => ⟨refl, ⟨here, whole⟩⟩,
        Succ(k) => match k {
            Zero => λ _ => ⟨refl, ⟨above, all⟩⟩,
            Succ(_) => λ no => false_elim(no),
        },
    }
}

theorem pair_empty(r: DataRegion, top: Nat, b: Nat): pair_size(b) = 0 → pair_at(r, top, b).toNat() <= Nat::pow(2, 47) {
    match b {
        Zero => λ no => false_elim(j(no, λ n _ => 0 < n, trivial)),
        Succ(k) => match k {
            Zero => λ no => false_elim(j(no, λ n _ => 0 < n, trivial)),
            Succ(_) => λ _ => j(sym(BitVec::zero_toNat(64)), λ z _ => z <= Nat::pow(2, 47), Nat::leb_sound(0, Nat::pow(2, 47), trivial)),
        },
    }
}

theorem pair_apart(top: Nat, b, c: Nat): pair_written(b) = True → b ≠ c → 0 < pair_size(b) → 0 < pair_size(c) →
    (pair_offset(top, b) + pair_size(b) <= pair_offset(top, c)) ∨ (pair_offset(top, c) + pair_size(c) <= pair_offset(top, b)) {
    let below: (top + 16 <= top + 16) = omega;
    match b {
        Zero => match c {
            Zero => λ _ differs _ _ => false_elim(differs(refl)),
            Succ(k) => match k {
                Zero => λ _ _ _ _ => Inl(below),
                Succ(_) => λ _ _ _ no => false_elim(no),
            },
        },
        Succ(_) => λ written _ _ _ => absurd(written),
    }
}

// The lending: whatever the region, wherever the two spans fit above `top`.
theorem pair_loan(r: DataRegion, top: Nat, fits: top + 32 <= r.size):
    Loan<X86Memory(r.profile)>(r.profile.fetch(), r.profile.data(), r.stack(), top, pair_spans(r, top)) {
    r.loan(top, pair_spans(r, top), λ b => pair_offset(top, b), omega(fits), λ b => pair_placed(r, top, fits, b),
        λ b => pair_empty(r, top, b), λ b c => pair_apart(top, b, c))
}

// ---------------------------------------------------------------------------
// What the borrower and its caller have

// A byte stored into the written span: it reads its bytes with that one set.
theorem put_reads_back(r: DataRegion, top: Nat, fits: top + 32 <= r.size, m: X86Memory(r.profile), k: Nat, inside: k < 16,
    byte: BitVec(8), xs: List<BitVec(8)>, whole: xs.len() = 16, reads: Readable(r.profile.data(), m, next_rip(r.low, top), xs)):
    Readable(r.profile.data(), r.profile.store(m, next_rip(next_rip(r.low, top), k), [byte]), next_rip(r.low, top),
        xs.update(k, λ (_: BitVec(8)) => byte)) {
    pair_loan(r, top, fits).put_reads(m, 0, k, refl, inside, byte, xs, whole, reads)
}

// Four bytes stored into the written span in one store, as far as its end:
// it reads its bytes with those four written over them from `k`.
theorem four_read_back(r: DataRegion, top: Nat, fits: top + 32 <= r.size, m: X86Memory(r.profile), k: Nat, inside: k + 4 <= 16,
    a, b, c, d: BitVec(8), xs: List<BitVec(8)>, whole: xs.len() = 16, reads: Readable(r.profile.data(), m, next_rip(r.low, top), xs)):
    Readable(r.profile.data(), r.profile.store(m, next_rip(next_rip(r.low, top), k), [a, b, c, d]), next_rip(r.low, top),
        xs.put_window(k, [a, b, c, d])) {
    let start: (k < 16) = omega(inside);
    pair_loan(r, top, fits).store_reads(m, 0, k, refl, start, [a, b, c, d], inside, xs, whole, reads)
}

// The span lent to read reads what it did after anything the borrower may
// store, into its own room or the other span.
theorem read_span_kept(r: DataRegion, top: Nat, fits: top + 32 <= r.size, i: Nat, low: i <= top, ys: List<BitVec(8)>, short: ys.len() <= 16,
    before, after: X86Memory(r.profile), wrote: r.stack().WroteIn(i, pair_spans(r, top), before, after),
    reads: Readable(r.profile.data(), before, next_rip(r.low, top + 16), ys)): Readable(r.profile.data(), after, next_rip(r.low, top + 16), ys) {
    pair_loan(r, top, fits).unwritten_reads(i, low, 1, refl, ys, short, before, after, wrote, reads)
}

// The caller's stack words from the borrower's entry up to `top`, and the
// code, are as they were.
theorem caller_words_kept(r: DataRegion, top: Nat, fits: top + 32 <= r.size, i: Nat, before, after: X86Memory(r.profile),
    wrote: r.stack().WroteIn(i, pair_spans(r, top), before, after)): r.stack().UnchangedTo(i, top, before, after) {
    pair_loan(r, top, fits).unchanged(i, before, after, wrote)
}

theorem code_kept(r: DataRegion, top: Nat, fits: top + 32 <= r.size, i: Nat, low: i <= top, bytes: List<BitVec(8)>, at: BitVec(64),
    before, after: X86Memory(r.profile), wrote: r.stack().WroteIn(i, pair_spans(r, top), before, after),
    resident: CodeResident(r.profile.fetch(), before, bytes, at)): CodeResident(r.profile.fetch(), after, bytes, at) {
    pair_loan(r, top, fits).resident(i, low, bytes, at, before, after, wrote, resident)
}

// A store into the written span is one the borrower may make; into the
// other it is not, the span not being lent to write.
theorem put_allowed(r: DataRegion, top: Nat, i: Nat, m: X86Memory(r.profile), k: Nat, inside: k < 16, byte: BitVec(8)):
    r.stack().WroteIn(i, pair_spans(r, top), m, r.profile.store(m, next_rip(next_rip(r.low, top), k), [byte])) {
    r.stack().wrote_in_put(i, pair_spans(r, top), m, 0, k, refl, inside, byte)
}

// Four bytes in one store are a store the borrower may make, up to the
// span's last byte and not past it.
theorem four_allowed(r: DataRegion, top: Nat, i: Nat, m: X86Memory(r.profile), a, b, c, d: BitVec(8)):
    r.stack().WroteIn(i, pair_spans(r, top), m, r.profile.store(m, next_rip(next_rip(r.low, top), 12), [a, b, c, d])) {
    r.stack().wrote_in_store(i, pair_spans(r, top), m, 0, 12, refl, trivial, [a, b, c, d], trivial)
}

// expect-error: `omega` got stuck
theorem four_past_end_refused(r: DataRegion, top: Nat, i: Nat, m: X86Memory(r.profile), a, b, c, d: BitVec(8)):
    r.stack().WroteIn(i, pair_spans(r, top), m, r.profile.store(m, next_rip(next_rip(r.low, top), 13), [a, b, c, d])) {
    r.stack().wrote_in_store(i, pair_spans(r, top), m, 0, 13, refl, trivial, [a, b, c, d], omega)
}

// expect-error(kernel): the kernel rejected `put_refused`: NotConvertible
theorem put_refused(r: DataRegion, top: Nat, i: Nat, m: X86Memory(r.profile), k: Nat, inside: k < 16, byte: BitVec(8)):
    r.stack().WroteIn(i, pair_spans(r, top), m, r.profile.store(m, next_rip(next_rip(r.low, top + 16), k), [byte])) {
    r.stack().wrote_in_put(i, pair_spans(r, top), m, 1, k, refl, inside, byte)
}

// With nothing written, what a call may store is what it could before.
theorem reads_only_wrote(r: DataRegion, top: Nat, i: Nat, before, after: X86Memory(r.profile),
    wrote: r.stack().WroteIn(i, Spans(λ b => pair_at(r, top, b), pair_size, λ _ => False), before, after)): r.stack().Wrote(i, before, after) {
    r.stack().wrote_in_none(i, Spans(λ b => pair_at(r, top, b), pair_size, λ _ => False), λ b => refl, before, after, wrote)
}

// ---------------------------------------------------------------------------
// The control: a written span is nobody else's

// No lending, over any stack and memory, has a span that may be written
// starting where another span starts: the byte stored there would read back
// (`stored`) and read as it did (`apart`), whatever byte it is.
theorem written_span_unshared<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    loan: Loan<M>(fetch, data, stack, top, spans), b, c: Nat, differs: b ≠ c, written: spans.written(b) = True, some: 0 < spans.size(b),
    other: 0 < spans.size(c), same: spans.at(b) = spans.at(c), memory: M): False {
    let seen = λ (byte: BitVec(8)) => {
        let after = stack.writes.store(memory, spans.byte(b, 0), [byte]);
        let back: (data.read(after, next_rip(spans.at(c), 0)) = Some(byte)) =
            j(same, λ a _ => data.read(after, next_rip(a, 0)) = Some(byte), loan.stored(memory, b, 0, written, some, [byte], some, 0, trivial));
        trans(sym(back), loan.apart(memory, b, 0, written, some, [byte], some, c, 0, other, Inl(differs)))
    };
    let both: (Some<BitVec(8)>(BitVec::ofNat(0)) = Some<BitVec(8)>(BitVec::ofNat(1))) = trans(seen(BitVec::ofNat(0)), sym(seen(BitVec::ofNat(1))));
    let verdict: (True = False) = cong_fn<Option<BitVec(8)>, Bool>(λ o => match o { None => True, Some(v) => v.eq_bit(BitVec::ofNat(0)) }, both);
    absurd(verdict)
}

// ---------------------------------------------------------------------------
// A heap over the two spans

// A reference stored at byte 0 of block 0, to byte 2 of block 1, loads
// back as that byte's address.
theorem ref_stored_reads_address(r: DataRegion, top: Nat, fits: top + 32 <= r.size, m: X86Memory(r.profile), heap: Heap,
    inj: Injected<X86Memory(r.profile)>(r.profile.data(), pair_spans(r, top), heap, m), ok: heap.fits(Loc(0, 0), 8) = True,
    loaded: heap.store_ref(Loc(0, 0), Loc(1, 2)).load_ref(Loc(0, 0)) = Some(Loc(1, 2))):
    read_word(r.profile.data(), r.profile.store(m, Loc(0, 0).address(pair_spans(r, top)), word_bytes(Loc(1, 2).address(pair_spans(r, top)))),
        Loc(0, 0).address(pair_spans(r, top))) = Some(Loc(1, 2).address(pair_spans(r, top))) {
    pair_loan(r, top, fits).store_ref_injected(heap, m, inj, Loc(0, 0), refl, ok, Loc(1, 2)).ref_read(Loc(0, 0), Loc(1, 2), loaded).right
}

// Four bytes stored at byte 4 of block 0 load back as their doubleword.
theorem dword_stored_reads_back(r: DataRegion, top: Nat, fits: top + 32 <= r.size, m: X86Memory(r.profile), heap: Heap,
    inj: Injected<X86Memory(r.profile)>(r.profile.data(), pair_spans(r, top), heap, m), a, b, c, d: BitVec(8), bytes: List<BitVec(8)>,
    ok: heap.fits(Loc(0, 4), 4) = True, read: heap.store(Loc(0, 4), [a, b, c, d]).read_bytes(Loc(0, 4), 4) = Some(bytes)):
    read_dword(r.profile.data(), r.profile.store(m, Loc(0, 4).address(pair_spans(r, top)), [a, b, c, d]), Loc(0, 4).address(pair_spans(r, top))) =
        Some(imm32_from_bytes(byte_at(bytes, 0), byte_at(bytes, 1), byte_at(bytes, 2), byte_at(bytes, 3))) {
    pair_loan(r, top, fits).store_injected(heap, m, inj, Loc(0, 4), refl, trivial, [a, b, c, d], ok).dword_read(Loc(0, 4), bytes, read).right
}

// The two hypotheses hold of a heap of two blocks of sixteen bytes: the
// reference reads back, and so do the four bytes.
fn pair_heap() → Heap { Heap([List::replicate(BitVec::zero(), 16), List::replicate(BitVec::zero(), 16)], [], []) }

theorem pair_ref_loads(): pair_heap().store_ref(Loc(0, 0), Loc(1, 2)).load_ref(Loc(0, 0)) = Some(Loc(1, 2)) { refl }

theorem pair_dword_reads(a, b, c, d: BitVec(8)): pair_heap().store(Loc(0, 4), [a, b, c, d]).read_bytes(Loc(0, 4), 4) = Some([a, b, c, d]) { refl }

// A pointer stored keeps the heap canonical: its eight bytes are zero.
theorem ref_stored_canonical(heap: Heap, canonical: heap.Canonical(), target: Loc, fits: 8 <= heap.bytes(0).len()):
    heap.store_ref(Loc(0, 0), target).Canonical() {
    heap.placed_canonical(canonical, Loc(0, 0), Piece::reference(target), fits, Piece::reference_canonical(target))
}

// The control: a doubleword load over half of a reference is refused, in
// every heap.
theorem dword_over_reference_refused(heap: Heap, target: Loc):
    heap.store_ref(Loc(0, 0), target).read_bytes(Loc(0, 4), 4) = None {
    let x = (4 + 4).leb(heap.store_ref(Loc(0, 0), target).bytes(0).len());
    j(sym(Bool::and_false_r(x)), λ v _ =>
        (match (match v { False => None, True => Some(heap.store_ref(Loc(0, 0), target).piece(Loc(0, 4), 4)) }) as λ _ => Option<List<BitVec(8)>> {
            None => None,
            Some(piece) => piece.plain_bytes(),
        }) = None, refl)
}

// and so is a reference's load of four plain bytes.
theorem ref_of_bytes_refused(): pair_heap().store(Loc(0, 4), [BitVec::zero(), BitVec::zero(), BitVec::zero(), BitVec::zero()]).load_ref(Loc(0, 0)) = None { refl }

// The control on placement: two blocks placed overlapping are not injected
// where their spans share a byte, plain and defined in both, that their
// bytes there differ at (from the experiment's probes): no memory reads
// both.
theorem overlap_not_injected<M>(data: ByteReadAccess<M>, spans: Spans, heap: Heap, memory: M, b, i, c, k: Nat,
    in_b: i < spans.size(b), in_c: k < spans.size(c), shared: spans.byte(b, i) = spans.byte(c, k),
    plain_b: covered(heap.shadow, b, i) = False, plain_c: covered(heap.shadow, c, k) = False,
    defined_b: heap.undefined(b, i) = False, defined_c: heap.undefined(c, k) = False,
    differ: heap.bytes(b).nth(i) ≠ heap.bytes(c).nth(k)): ¬Injected<M>(data, spans, heap, memory) {
    λ inj => differ(trans(sym(inj.bytes(b, i, in_b, plain_b, defined_b)),
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ a => data.read(memory, a), shared), inj.bytes(c, k, in_c, plain_c, defined_c))))
}

// Block 1 at byte 8 of block 0, zeros against ones.
fn overlapping(base: BitVec(64)) → Spans {
    Spans(λ (b: Nat) => match b { Zero => base, Succ(_) => next_rip(base, 8) }, λ (b: Nat) => 16, λ (b: Nat) => True)
}

fn zeros_ones() → Heap { Heap([List::replicate(BitVec::zero(), 16), List::replicate(BitVec::ofNat(1), 16)], [], []) }

theorem overlapping_not_injected<M>(data: ByteReadAccess<M>, base: BitVec(64), memory: M): ¬Injected<M>(data, overlapping(base), zeros_ones(), memory) {
    overlap_not_injected(data, overlapping(base), zeros_ones(), memory, 0, 8, 1, 0, trivial, trivial, refl, refl, refl, refl, refl,
        λ same => absurd(cong_fn<Option<BitVec(8)>, Nat>(λ o => match o { None => 0, Some(byte) => byte.toNat() }, same)))
}

// ---------------------------------------------------------------------------
// Empty ranges (issues/byte-writes-empty-range.md)

// What the lowering of system calls assumed of each span's end, at any
// address, from a loan and nothing else: the buffer of a zero-byte read is
// writable for zero bytes, and storing no bytes there is the memory.
theorem loan_empty_range<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    loan: Loan<M>(fetch, data, stack, top, spans)):
    (m: M) → (a: BitVec(64)) → stack.writes.writable(m, a, 0) ∧ (stack.writes.store(m, a, []) = m) {
    λ m a => ⟨loan.empty_writable(m, a), loan.empty_store(m, a)⟩
}

// The region's loan, one past the written span's last byte: no `k < size`
// to give, and a zero-byte store there is the memory.
theorem pair_end_empty(r: DataRegion, top: Nat, fits: top + 32 <= r.size, m: X86Memory(r.profile)):
    r.profile.store(m, pair_spans(r, top).byte(0, 16), []) = m {
    pair_loan(r, top, fits).empty_store(m, pair_spans(r, top).byte(0, 16))
}

// The control: writes whose store of no bytes moves the memory do not keep
// the law, so it says something.
fn counting_writes() → ByteWrites<Nat> {
    ByteWrites(λ (m: Nat) (a: BitVec(64)) (k: Nat) => True, λ (m: Nat) (a: BitVec(64)) (bytes: List<BitVec(8)>) => m + 1)
}

theorem counting_not_empty(): ¬counting_writes().EmptyRange() {
    λ law => {
        let moved: (0 + 1 = 0) = law(0, BitVec::zero()).right;
        false_elim(omega(moved))
    }
}

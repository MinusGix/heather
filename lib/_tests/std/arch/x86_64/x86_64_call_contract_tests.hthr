// Probes of the call contract (x86_64_call_contract;
// issues/bytes-level-on-the-contract.md): the existing call contract at one
// lending (`Site::CallsLent`, FunctionIR's) gives `Site::Meets`' done clause
// at an empty shadow, for a meaning each of whose answers is, over heaps of
// buffers and words, one the program's functions allow, makes no system
// call and keeps the world. Then values lowered, and the outcomes' histories.
// Tests, not library: nothing imports this module.
import x86_64_call_contract;
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_store;
import x86_64_stack;
import x86_64_memory_contract;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import function_ir;
import function_ir_writes;
import function_ir_lower_reads;
import function_ir_lower_calls;
import linux_calls;
import linux_world;
import bitvec;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// The done clause, from the existing contract

theorem calls_lent_meets_done<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), effects: Effects(), rooms: Nat → Nat, bound: Nat,
    counts: List<Nat>, needs: Nat → Nat → Bool, top: Nat, lending: Lending, counted: lending.counts = counts,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), lent: site.CallsLent(stack, effects, rooms, bound, counts, needs, top),
    allowed: (f: Nat) → (b: Nat) → needs(f, b).IsTrue() → lending.written(b) = True, meaning: Nat → Calls(),
    answers: (n, f: Nat) → (args: List<Value>) → (heap: Heap) → (io: Io) → (a: Answer) → meaning(n, f, args, heap, io) = Done(a) →
        Exists<Buffers()>(λ before => Exists<Buffers()>(λ after => Exists<BitVec(64)>(λ result => Exists<List<BitVec(64)>>(λ rest =>
            ((heap = Heap::of(before)) ∧ ((a.heap = Heap::of(after)) ∧ ((lower_values(lending.spans(), a.words) = Cons(result, rest)) ∧ (a.io = io)))) ∧
            (effects(before, f, lower_values(lending.spans(), args), result, rest, after) ∧
                ArgsLent(lent_count(lending.counts, f), 0, lower_values(lending.spans(), args), lending.addresses, lending.buffers))))))):
    site.MeetsDone(stack, lending.spans(), top, rooms, bound, meaning) {
    λ f below args heap io answerable s at resident i rsp room passed low high inj ret saved n a ran => {
        let found = answers(n, f, args, heap, io, a, ran);
        let before = found.witness;
        let after = found.proof.witness;
        let result = found.proof.proof.witness;
        let rest = found.proof.proof.proof.witness;
        let facts = found.proof.proof.proof.proof;
        let spans = lending.spans();
        let arguments = lower_values(spans, args);
        let returns = lent(lending, counted, loan, f, below, λ b need => allowed(f, b, need), arguments, result, rest, before, after);
        let held_in: Injected<M>(site.data, spans, Heap::of(before), s.memory) =
            j(facts.left.left, λ h _ => Injected<M>(site.data, spans, h, s.memory), inj);
        let ran2 = returns(s, at, resident, i, rsp, room,
            ⟨⟨passed, ⟨facts.right.left, low⟩⟩, ⟨facts.right.right, ⟨high, injected_in_memory(lending, loan, before, s.memory, held_in)⟩⟩⟩, ret, saved);
        let t = ran2.witness;
        let done = ran2.proof.right.right.right.right;
        let words: ArgsIn(lower_values(spans, a.words), Cons(Rax, answer_registers()), t.gprs) =
            j(sym(facts.left.right.right.left), λ ws _ => ArgsIn(ws, Cons(Rax, answer_registers()), t.gprs), ⟨done.left.left, done.right⟩);
        let heaped: Injected<M>(site.data, spans, a.heap, t.memory) =
            j(sym(facts.left.right.left), λ h _ => Injected<M>(site.data, spans, h, t.memory),
                in_memory_injected(stack, lending, after, t.memory, done.left.right.right.right));
        Exists(0, Exists(t, ⟨ran2.proof.left, ⟨⟨ran2.proof.right.left, ⟨ran2.proof.right.right.left, ran2.proof.right.right.right.left⟩⟩,
            ⟨⟨words, done.left.right.left⟩, ⟨⟨done.left.right.right.left, heaped⟩, sym(facts.left.right.right.right)⟩⟩⟩⟩))
    }
}

// ---------------------------------------------------------------------------
// Values and outcomes

// A reference lowers to its target's address, a word to itself.
theorem ref_lowers(spans: Spans, loc: Loc): Ref(loc).lower(spans) = spans.byte(loc.block, loc.offset) { refl }

theorem word_lowers(spans: Spans, w: BitVec(64)): Word(w).lower(spans) = w { refl }

// A stuck run has a history (where it got stuck) and no meaning there.
theorem stuck_history(io: Io): history(Stuck<Answer>(io)) = None { refl }

theorem stuck_where(io: Io): stuck_after(Stuck<Answer>(io)) = Some(io.past) { refl }

// Control: a run that is going is not stuck.
theorem going_not_stuck(io: Io): stuck_after(Going<Answer>(io)) = None { refl }

// What the model defines after a rotate: CF, and the flags defined before
// but OF; nothing changes at a masked count of zero.
theorem ror32_defines_nonzero(): ror32_defines(ror32_count(b(7)), DefinedFlags::all()) =
    DefinedFlags(cf := True, pf := True, af := True, zf := True, sf := True, of := False) { refl }
theorem ror32_defines_masked_zero(): ror32_defines(ror32_count(b(32)), DefinedFlags::none()) = DefinedFlags::none() { refl }

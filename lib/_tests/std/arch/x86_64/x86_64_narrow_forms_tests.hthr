    [False, False, False, False, False, False, False, False] { refl }
theorem ror32_33_on_the_cpu(): words([ror32_value(w(0x0000000000000000), ror32_count(b(33))), ror32_value(w(0xffffffffffffffff), ror32_count(b(33))), ror32_value(w(0x0000000080000000), ror32_count(b(33))), ror32_value(w(0x00000000ffffffff), ror32_count(b(33))), ror32_value(w(0xffffffff00000000), ror32_count(b(33))), ror32_value(w(0x0123456789abcdef), ror32_count(b(33))), ror32_value(w(0x0000000000000001), ror32_count(b(33))), ror32_value(w(0x8000000000000001), ror32_count(b(33)))]) =

// Probes of a definition's own equations, one per branch
// (issues/definition-branch-equations.md): `f::True` and `f::False` for a
// test at the head of the body, chained (`f::False::True`) where an arm is a
// test again, each under its condition as the source wrote it. Varied over
// the four axes of docs/testing-generated-terms.md: a literal and a neutral
// argument, an open element type, a checking position, and negative
// controls. Tests, not library: nothing outside lib/_tests imports this
// module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import list; import omega; import tactic; import bitvec; import bitvec_omega; import option; import result;

// `if P` on a `Nat` comparison: the hypothesis is `P`, and `¬P` for the else.
fn clamp(n: Nat) → Nat { if n < 10 { n } else { 10 } }

theorem clamp_small(n: Nat, h: n < 10): clamp(n) = n { clamp::True(n, h) }
theorem clamp_big(n: Nat, h: ¬(n < 10)): clamp(n) = 10 { clamp::False(n, h) }
// At a literal, the hypothesis is a closed fact.
theorem clamp_three(): clamp(3) = 3 { clamp::True(3, omega) }
// In a checking position: the equation's type is compared by conversion.
theorem clamp_le(n: Nat, h: n < 10): clamp(n) <= 9 {
    let e: (clamp(n) = n) = clamp::True(n, h);
    j(sym(e), λ m _ => m <= 9, omega)
}

// `if h: P` names its evidence: the hypothesis takes that name, and an arm
// that uses the evidence is stated with it.
fn pred_below(n: Nat) → Nat { if h: 0 < n { n - 1 } else { 0 } }
theorem pred_below_pos(n: Nat, h: 0 < n): pred_below(n) = n - 1 { pred_below::True(n, h) }
theorem pred_below_zero(): pred_below(0) = 0 { pred_below::False(0, omega) }

// An open element type, tested on a `Bool`: the hypothesis is the bit's
// equation, since a `Bool` is not a proposition.
fn choose<A>(b: Bool, x, y: A) → A { if b { x } else { y } }
theorem choose_true<A>(b: Bool, x, y: A, h: b = True): choose(b, x, y) = x { choose::True(b, x, y, h) }
theorem choose_false<A>(x, y: A): choose(False, x, y) = y { choose::False(False, x, y, refl) }

// A `match` on a `Bool`, with and without an equation.
fn pick(b: Bool, x, y: Nat) → Nat { match b { True => x, False => y } }
theorem pick_true(x, y: Nat): pick(True, x, y) = x { pick::True(True, x, y, refl) }
fn pick_eq(b: Bool, x, y: Nat) → Nat { match e: b { True => x, False => y } }
theorem pick_eq_false(b: Bool, x, y: Nat, e: b = False): pick_eq(b, x, y) = y { pick_eq::False(b, x, y, e) }

// A test inside an arm, reading a `let` before it: the inner condition is
// stated with the `let`'s value, and both hypotheses are taken.
fn bucket(n: Nat) → Nat {
    let m = n + 1;
    if m < 5 { 0 } else { if m < 9 { 1 } else { 2 } }
}
theorem bucket_low(n: Nat, h: n + 1 < 5): bucket(n) = 0 { bucket::True(n, h) }
theorem bucket_mid(n: Nat, a: ¬(n + 1 < 5), b: n + 1 < 9): bucket(n) = 1 { bucket::False::True(n, a, b) }
theorem bucket_high(n: Nat, a: ¬(n + 1 < 5), b: ¬(n + 1 < 9)): bucket(n) = 2 { bucket::False::False(n, a, b) }

// A word comparison, and a literal arm at the declaration's carrier: the
// equation's sides are checked at the result type, so `0` is a `u64`.
fn step64(i: u64) → u64 { if i = 63 { 0 } else { i + 1 } }
theorem step64_wraps(i: u64, h: i = 63): step64(i) = 0 { step64::True(i, h) }
theorem step64_counts(i: u64, h: ¬(i = 63)): step64(i) = i + 1 { step64::False(i, h) }

// A `match` on a parameter of an inductive type: one equation per
// constructor, its fields as parameters and `h: x = C(ȳ)`.
fn pred_or(n, d: Nat) → Nat { match n { Zero => d, Succ(m) => m } }
theorem pred_or_zero(n, d: Nat, h: n = Zero): pred_or(n, d) = d { pred_or::Zero(n, d, h) }
theorem pred_or_succ(n, d, m: Nat, h: n = m + 1): pred_or(n, d) = m { pred_or::Succ(n, d, m, h) }
// An open element type, and a field named as the arm wrote it.
fn head_or<A>(xs: List<A>, d: A) → A { match xs { Nil => d, Cons(y, _) => y } }
theorem head_or_cons<A>(xs: List<A>, d, y: A, ys: List<A>, h: xs = Cons(y, ys)): head_or(xs, d) = y { head_or::Cons(xs, d, y, ys, h) }
// A test inside a constructor's arm: the names chain.
fn sign_of(n: Nat, k: Nat) → Nat { match n { Zero => 0, Succ(m) => if m < k { 1 } else { 2 } } }
theorem sign_of_mid(n, k, m: Nat, h: n = m + 1, lt: m < k): sign_of(n, k) = 1 { sign_of::Succ::True(n, k, m, h, lt) }
// A `_` arm has no equation of its own; the written arms do.
fn is_one(n: Nat) → Bool { match n { Succ(m) => m.same(0), _ => False } }
theorem is_one_succ(n, m: Nat, h: n = m + 1): is_one(n) = m.same(0) { is_one::Succ(n, m, h) }

// A `match` on a call's result (issues/induct-through-result-matches.md):
// one equation per constructor, the arm's fields as parameters and
// `h: g(ā) = C(ȳ)`, the call stated as the body spells it.
fn half_even(n: Nat) → Option<Nat> { if n.half() + n.half() = n { Some(n.half()) } else { None } }
fn quarter(n: Nat) → Option<Nat> { match half_even(n) { None => None, Some(k) => half_even(k) } }
theorem quarter_none(n: Nat, h: half_even(n) = None): quarter(n) = None { quarter::None(n, h) }
theorem quarter_some(n, k: Nat, h: half_even(n) = Some(k)): quarter(n) = half_even(k) { quarter::Some(n, k, h) }
// At a literal, the hypothesis is a closed fact the call computes.
theorem quarter_eight(): quarter(8) = half_even(4) { quarter::Some(8, 4, refl) }
// A `match h:` names the equation, and an arm that passes it on is stated
// with the hypothesis in its place.
fn first_of<A>(xs: List<A>) → Option<A> { match xs { Nil => None, Cons(x, _) => Some(x) } }
fn first_len<A>(xs: List<A>, x: A, got: first_of(xs) = Some(x)) → Nat { xs.len() }
fn first_seen<A>(xs: List<A>) → Nat { match got: first_of(xs) { None => 0, Some(x) => first_len(xs, x, got) } }
theorem first_seen_some<A>(xs: List<A>, x: A, got: first_of(xs) = Some(x)): first_seen(xs) = first_len(xs, x, got) {
    first_seen::Some(xs, x, got)
}
// Nested, over an open element type, after a constructor test: the path
// names every arm, and a later test reads an earlier arm's field.
fn second_of<A>(xs, ys: List<A>) → Option<A> {
    match xs {
        Nil => None,
        Cons(_, rest) => match first_of(rest) {
            None => first_of(ys),
            Some(a) => match first_of(ys) { None => Some(a), Some(b) => Some(b) },
        },
    }
}
theorem second_of_both<A>(xs, ys: List<A>, x: A, rest: List<A>, h: xs = Cons(x, rest), a: A, h2: first_of(rest) = Some(a), b: A, h3: first_of(ys) = Some(b)):
    second_of(xs, ys) = Some(b) {
    second_of::Cons::Some::Some(xs, ys, x, rest, h, a, h2, b, h3)
}
// In a checking position.
theorem quarter_some_le(n, k: Nat, h: half_even(n) = Some(k), none: half_even(k) = None): quarter(n) = None {
    let e: (quarter(n) = half_even(k)) = quarter::Some(n, k, h);
    trans(e, none)
}
// Negative control: the arm at `Some` is not the `None` one.
// expect-error: but `quarter(n) = None` is expected here
theorem quarter_wrong(n, k: Nat, h: half_even(n) = Some(k)): quarter(n) = None { quarter::Some(n, k, h) }
// A `_` arm leaves the `match` a leaf: there is no `Some` equation.
fn quarter_or(n: Nat) → Nat { match half_even(n) { Some(k) => k, _ => 0 } }
// expect-error: quarter_or::Some
theorem quarter_or_some(n, k: Nat, h: half_even(n) = Some(k)): quarter_or(n) = k { quarter_or::Some(n, k, h) }

// A pipeline written as calls reads as the `match` each call is: `and_then`
// and `map` on an `Option`, and a postfix `?` (which lowers to `Result`'s).
fn quarter_then(n: Nat) → Option<Nat> { half_even(n).and_then(λ k => half_even(k)) }
theorem quarter_then_some(n, k: Nat, h: half_even(n) = Some(k)): quarter_then(n) = half_even(k) { quarter_then::Some(n, k, h) }
theorem quarter_then_none(n: Nat, h: half_even(n) = None): quarter_then(n) = None { quarter_then::None(n, h) }
fn half_succ(n: Nat) → Option<Nat> { half_even(n).map(λ k => k + 1) }
theorem half_succ_some(n, k: Nat, h: half_even(n) = Some(k)): half_succ(n) = Some(k + 1) { half_succ::Some(n, k, h) }
fn small(n: Nat) → Result<Nat, Nat> { if n < 10 { Ok(n) } else { Err(n) } }
fn small_sum(a, b: Nat) → Result<Nat, Nat> {
    let x = small(a)?;
    let y = small(b)?;
    Ok(x + y)
}
theorem small_sum_ok(a, b, x, y: Nat, h: small(a) = Ok(x), h2: small(b) = Ok(y)): small_sum(a, b) = Ok(x + y) {
    small_sum::Ok::Ok(a, b, x, h, y, h2)
}
theorem small_sum_err(a, b, e: Nat, h: small(a) = Err(e)): small_sum(a, b) = Err(e) { small_sum::Err(a, b, e, h) }

// A call read by its name is checked like any equation: a `guard` that is
// not the guard (it keeps the value on `False`) gets no equation, and a
// reference says why.
fn Bool::guard<B>(self b: Bool, o: Option<B>) → Option<B> { match b { False => o, True => None } }
fn inverted(b: Bool) → Option<Nat> { b.guard(Some(1)) }
// expect-error: inverted::True
theorem inverted_true(): inverted(True) = Some(1) { inverted::True(True, refl) }

// As a `simp` law: the side condition is found among the hypotheses in scope.
theorem clamp_simp(n: Nat, h: n < 10): clamp(n) + 1 = n + 1 { simp_only(clamp::True) }

// Negative controls. The other arm's equation is not this one.
// expect-error: but `clamp(n) = 10` is expected here
theorem clamp_wrong(n: Nat, h: n < 10): clamp(n) = 10 { clamp::True(n, h) }

// A measured recursion has them too, each proved from its unfolding: the
// leaf's recursive call stays the call, and the measure's own `on` is no
// part of an equation.
fn halve(n: Nat) → Nat decreases n {
    if h: 1 < n { if small: n < 100 { 1 + halve(n - 2) } else { 50 } } else { 0 }
    on ?dec1 := { let more = h; omega };
}
theorem halve_step(n: Nat, h: 1 < n, small: n < 100): halve(n) = 1 + halve(n - 2) { halve::True::True(n, h, small) }
theorem halve_big(n: Nat, h: 1 < n, big: ¬(n < 100)): halve(n) = 50 { halve::True::False(n, h, big) }
theorem halve_four(): halve(4) = 1 + halve(2) { halve::True::True(4, omega, omega) }
// expect-error: but `halve(n) = 0` is expected here
theorem halve_wrong(n: Nat, h: 1 < n, small: n < 100): halve(n) = 0 { halve::True::True(n, h, small) }

// A `let` the recursive call reads, under named tests the measure's `on`
// reads: the obligation the body lifts quantifies the tests' equations
// (they are about the `let`), and the unfolding's companions cite it over
// the same ones, though they read the `let` inlined.
fn hop(n: Nat) → Nat decreases n {
    if h: 0 < n {
        let w = n.min(2);
        if z: w = 0 { 0 } else { 1 + hop(n - w) }
    } else {
        0
    }
    on ?dec1 := { let pos = h; omega };
}
theorem hop_on(n: Nat, h: 0 < n, z: ¬(n.min(2) = 0)): hop(n) = 1 + hop(n - n.min(2)) { hop::True::False(n, h, z) }

// A measured recursion through a call's result: the recursive call under
// the arm is the leaf, and the arm's field is an argument of it.
fn halving(n, acc: Nat) → Option<Nat> decreases n {
    if h: 0 < n {
        match half_even(n) { None => None, Some(k) => halving(n - 1, acc + k) }
    } else {
        Some(acc)
    }
    on ?dec1 := { let pos = h; omega };
}
theorem halving_some(n, acc, k: Nat, h: 0 < n, e: half_even(n) = Some(k)): halving(n, acc) = halving(n - 1, acc + k) {
    halving::True::Some(n, acc, h, k, e)
}

// An unmeasured recursion's equations would be its unfolding's, which it
// has none of.
fn tally(b: Bool, n: Nat) → Nat { if b { 0 } else { match n { Zero => 0, Succ(m) => tally(b, m) } } }
// expect-error: no branch equation `tally::True`
theorem tally_true(n: Nat): tally(True, n) = 0 { tally::True(True, n, refl) }

// A test that is a conjunction of equations over two `let`s: the hypothesis
// states it with both values put in (an equation inside `∧` mentions them).
fn both_low(x, y: Nat) → Nat {
    let a = x + 1;
    let b = y + 1;
    if a % 2 = 0 ∧ b % 2 = 0 { 1 } else { 0 }
}
theorem both_low_even(x, y: Nat, h: (x + 1) % 2 = 0 ∧ (y + 1) % 2 = 0): both_low(x, y) = 1 { both_low::True(x, y, h) }
theorem both_low_odd(x, y: Nat, h: ¬((x + 1) % 2 = 0 ∧ (y + 1) % 2 = 0)): both_low(x, y) = 0 { both_low::False(x, y, h) }

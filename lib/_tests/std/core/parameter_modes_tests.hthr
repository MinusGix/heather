// Probes of a parameter's mode (docs/language/sequencing-surface-design.md
// §24, docs/language/ownership-design.md §10.3,
// issues/ownership-parameter-modes.md): `x: &T` recorded with no change of
// meaning, `x: &mut T` on any parameter and several per function, and a call
// passing `&mut place`, which rebinds each place as a `mut self` receiver
// is. Each form at literal and neutral inputs, at an open type, through a
// field path, a loop and a branch, with the refusals the elaborator makes;
// the parse-time ones (a place that is not one, an immutable local, two
// `&mut` of overlapping places) are in crates/syntax/tests/parameter_modes.rs,
// since a parse error refuses the whole file. Tests, not library: nothing
// outside lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import list; import option; import tactic; import bitvec; import bitvec_omega;

record Counter { n: Nat, log: List<Nat> }

record Two { left: Nat, right: Nat }

// ---------------------------------------------------------------------------
// A frozen view means the value: the function is the one with `c: Counter`.

fn peek(c: &Counter) → Nat { c.n }
theorem peek_lit(): peek(Counter(4, [])) = 4 { refl }
theorem peek_open(c: Counter): peek(c) = c.n { refl }

fn first_or<A>(xs: &List<A>, d: A) → A {
    match xs { Nil => d, Cons(x, _) => x }
}
theorem first_or_open<A>(x, d: A, xs: List<A>): first_or(Cons(x, xs), d) = x { refl }

// ---------------------------------------------------------------------------
// One live path: its value after the call beside the answer, `Mutated<T, R>`,
// which is `mut self`'s shape.

fn add_into(acc: &mut Nat, k: Nat) → Nat {
    acc := acc + k;
    acc
}
theorem add_into_kernel(a, k: Nat): add_into(a, k) = Mutated(a + k, a + k) { refl }
theorem add_into_after(a: Nat): add_into(a, 2).after = a + 2 { refl }

// An open type: the path keeps its parameter's type.
fn put_front<A>(xs: &mut List<A>, x: A) → A {
    xs := Cons(x, xs);
    x
}
theorem put_front_open<A>(xs: List<A>, x: A): put_front(xs, x).after = Cons(x, xs) { refl }

// ---------------------------------------------------------------------------
// Several live paths: the values after nest in parameter order, the answer
// innermost.

fn swap_sum(a: &mut Nat, b: &mut Nat) → Nat {
    let t = a;
    a := b;
    b := t;
    a + b
}
theorem swap_sum_kernel(x, y: Nat): swap_sum(x, y) = Mutated(y, Mutated(x, y + x)) { refl }

// A run of names shares the mode with the type.
fn bump_both(a, b: &mut Nat, by: Nat) → True {
    a := a + by;
    b := b + by;
}
theorem bump_both_kernel(x, y: Nat): bump_both(x, y, 1) = Mutated(x + 1, Mutated(y + 1, trivial)) { refl }

// Called without `&mut`, a function with live paths gives its record, as
// `@Fd::read(fd, n)` gives a `mut self` method's.
theorem swap_sum_record(): swap_sum(1, 2).value.after = 1 { refl }

// ---------------------------------------------------------------------------
// Call sites: `&mut place` rebinds the place after the call.

fn use_swap(x, y: Nat) → Nat {
    let mut p = x;
    let mut q = y;
    let s = swap_sum(&mut p, &mut q);
    s + p * 10 + q
}
theorem use_swap_lit(): use_swap(1, 2) = 3 + 20 + 1 { refl }
theorem use_swap_open(x, y: Nat): use_swap(x, y) = (y + x) + y * 10 + x { refl }

// As a statement, the answer dropped; and an annotated `let`.
fn use_statement(x: Nat) → Nat {
    let mut p = x;
    add_into(&mut p, 3);
    let r: Nat = add_into(&mut p, 4);
    r + p
}
theorem use_statement_lit(): use_statement(1) = 8 + 8 { refl }
theorem use_statement_open(x: Nat): use_statement(x) = (x + 3 + 4) + (x + 3 + 4) { refl }

// A field path is a place (§20), and two different fields of one record are
// apart.
fn use_fields(t: Two) → Nat {
    let mut u = t;
    swap_sum(&mut u.left, &mut u.right);
    add_into(&mut u.left, 100);
    u.left
}
theorem use_fields_lit(): use_fields(Two(1, 2)) = 102 { refl }
theorem use_fields_open(a, b: Nat): use_fields(Two(a, b)) = b + 100 { refl }

fn use_counter(c: Counter) → Counter {
    let mut d = c;
    add_into(&mut d.n, 1);
    d
}
theorem use_counter_open(c: Counter): use_counter(c) = Counter(c.n + 1, c.log) { refl }

// A `mut` parameter, and a `&mut` parameter passed on to another call.
fn bump_local(mut x: Nat) → Nat {
    add_into(&mut x, 1);
    x
}
theorem bump_local_open(x: Nat): bump_local(x) = x + 1 { refl }

fn twice(a: &mut Nat) → True {
    add_into(&mut a, 1);
    add_into(&mut a, 1);
}
theorem twice_open(x: Nat): twice(x).after = x + 1 + 1 { refl }

// The call that ends a block is its value, the places rebound first.
fn bump_tail(mut x: Nat) → Nat { add_into(&mut x, 3) }
theorem bump_tail_open(x: Nat): bump_tail(x) = x + 3 { refl }

// In a loop's body: the place is the loop's state.
fn sum_into(xs: List<Nat>) → Nat {
    let mut acc = 0;
    for x in xs {
        add_into(&mut acc, x);
    }
    acc
}
theorem sum_into_lit(): sum_into([1, 2, 3]) = 6 { refl }

// In a statement `if`: the place is joined.
fn bump_when(x: Nat, b: Bool) → Nat {
    let mut p = x;
    if b { add_into(&mut p, 5); }
    p
}
theorem bump_when_true(x: Nat): bump_when(x, True) = x + 5 { refl }
theorem bump_when_false(x: Nat): bump_when(x, False) = x { refl }

// A recursion that lends its own paths on: one path, then two.
fn count_down(acc: &mut Nat, n: Nat) → Nat decreases n {
    match n {
        Zero => acc,
        Succ(k) => {
            add_into(&mut acc, 1);
            count_down(&mut acc, k)
        },
    }
}
theorem count_down_lit(): count_down(0, 3) = Mutated(3, 3) { refl }

fn split_count(a: &mut Nat, b: &mut Nat, xs: List<Bool>) → Nat decreases xs.len() {
    match xs {
        Nil => a + b,
        Cons(x, rest) => {
            // Bound first: read only by a statement `if`, the payload is
            // reported unused (issues/unused-payload-lint-statement-if-decreases.md).
            let left = x;
            if left { a := a + 1; } else { b := b + 1; }
            split_count(&mut a, &mut b, rest)
        },
    }
}
theorem split_count_lit(): split_count(0, 0, [True, False, True]) = Mutated(2, Mutated(1, 3)) { refl }

// A loop over words whose state is a path that is not a receiver: lifted
// as a plain loop, not as a method of the `self` parameter's type.
record Step { by: u64 }
fn Step::run(self s: Step, total: &mut u64) → u64 {
    for i in 0..3 {
        total := total + s.by;
    }
    total
}
theorem step_run_lit(): Step::run(Step(2), 1).after = 7 { refl }

// ---------------------------------------------------------------------------
// The body of a function with live paths ends as a `mut self` body does.

// A branch whose arms update a path returns the paths per arm (§19.2).
fn bump_if(a: &mut Nat, b: Bool) → Bool {
    if b {
        a := a + 1;
        True
    } else {
        False
    }
}
theorem bump_if_true(x: Nat): bump_if(x, True) = Mutated(x + 1, True) { refl }
theorem bump_if_false(x: Nat): bump_if(x, False) = Mutated(x, False) { refl }

// `return` leaves with every path as the body has threaded it.
fn add_until_zero(a: &mut Nat, b: &mut Nat, xs: List<Nat>) → Bool {
    for x in xs {
        if x = 0 { return Bool::False }
        a := a + x;
        b := b + 1;
    }
    Bool::True
}
theorem add_until_zero_stops(): add_until_zero(0, 0, [3, 4, 0, 5]) = Mutated(7, Mutated(2, Bool::False)) { refl }
theorem add_until_zero_runs(): add_until_zero(0, 0, [3]) = Mutated(3, Mutated(1, Bool::True)) { refl }

// ---------------------------------------------------------------------------
// `self x: &mut T` spells `mut self x: T`: a method call on a `let mut`
// local updates it.

fn Counter::tick(self c: &mut Counter, by: Nat) → Nat {
    c := Counter(c.n + by, Cons(by, c.log));
    c.n
}
theorem tick_kernel(c: Counter): Counter::tick(c, 1) = Mutated(Counter(c.n + 1, Cons(1, c.log)), c.n + 1) { refl }

fn run_ticks(start: Nat) → Nat {
    let mut c = Counter(start, []);
    let a = c.tick(2);
    c.tick(3);
    a + c.n
}
theorem run_ticks_open(s: Nat): run_ticks(s) = (s + 2) + (s + 2 + 3) { refl }

// ---------------------------------------------------------------------------
// Refusals the elaborator makes.

fn plain(k: Nat) → Nat { k + 1 }

// expect-error: `plain`'s parameter `k` is not `&mut`, so nothing comes back to the place lent it
fn lend_to_owned(x: Nat) → Nat {
    let mut p = x;
    let r = plain(&mut p);
    r
}

// expect-error: `swap_sum` takes `b` as `&mut`, so its argument is a place it lends back
fn missing_lend(x: Nat) → Nat {
    let mut p = x;
    let r = swap_sum(&mut p, 3);
    r
}

// expect-error: a `&mut` argument is lent by a call that surely runs before the statement around it
fn lend_under_lambda(x: Nat) → Nat {
    let mut p = x;
    let f = λ (k: Nat) => add_into(&mut p, k);
    f(1)
}

fn is_zero(n: Nat) → Bool { match n { Zero => True, Succ(_) => False } }

// expect-error: a `&mut` argument is lent by a call that surely runs before the statement around it
fn lend_under_or(x: Nat, b: Bool) → Bool {
    let mut p = x;
    let r = b || is_zero(add_into(&mut p, 1));
    r
}

// expect-error: `swap_sum`'s receiver is a `&mut` parameter, so it comes back to its place, and this receiver is not one that can be rebound
fn lend_by_fixed_receiver(x: Nat) → Nat {
    let p = x;
    let mut q = x;
    let r = p.swap_sum(&mut q);
    r
}

// ---------------------------------------------------------------------------
// A generator reads the modes a declaration wrote (`tactic::modes`): one per
// parameter of its table, type parameters included, in order.

fn mode_code(m: ParamMode) → Nat { match m { ByValue => 0, FrozenView => 1, LivePath => 2 } }

fn same_modes(ms: List<ParamMode>, want: List<Nat>) → Bool {
    match ms {
        Nil => match want { Nil => True, Cons(_, _) => False },
        Cons(m, rest) => match want {
            Nil => False,
            Cons(w, more) => mode_code(m).same(w) && same_modes(rest, more),
        },
    }
}

fn modes_are(name: String, want: List<Nat>) → Tac<Expr> {
    let g <- lookup(name).or_fail("lookup: ");
    let ms <- modes(g).or_fail("modes: ");
    let t <- resolve("trivial").or_fail("");
    match same_modes(ms, want) {
        True => exact(Hd(t)),
        False => fail("the modes are not the ones written", []),
    }
}

theorem peek_modes(): True { by modes_are("peek", [1]) }
theorem first_or_modes(): True { by modes_are("first_or", [0, 1, 0]) }
theorem swap_sum_modes(): True { by modes_are("swap_sum", [2, 2]) }
theorem bump_both_modes(): True { by modes_are("bump_both", [2, 2, 0]) }
theorem bump_local_modes(): True { by modes_are("bump_local", [0]) }
theorem tick_modes(): True { by modes_are("Counter::tick", [2, 0]) }

// `mut self` records the live path it has always been.
fn Counter::tally(mut self c: Counter, by: Nat) → Nat {
    c := Counter(c.n + by, c.log);
    c.n
}
theorem tally_modes(): True { by modes_are("Counter::tally", [2, 0]) }

// expect-error: the modes are not the ones written
theorem plain_modes_wrong(): True { by modes_are("plain", [2]) }

// ---------------------------------------------------------------------------
// A method call lends places (issues/parameter-modes-residue.md): a callee
// whose receiver is a live path rebinds the receiver from the outermost
// `Mutated` and the lent places from the ones inside it.

// A function whose first parameter is `&mut`, called as a method of it.
fn lend_by_method(x, y: Nat) → Nat {
    let mut p = x;
    let mut q = y;
    let r = p.swap_sum(&mut q);
    r + p * 10 + q
}
theorem lend_by_method_lit(): lend_by_method(1, 2) = 3 + 20 + 1 { refl }
theorem lend_by_method_open(x, y: Nat): lend_by_method(x, y) = (y + x) + y * 10 + x { refl }

// As a statement, and on two fields of one record (receiver and place apart).
fn lend_by_fields(t: Two) → Nat {
    let mut u = t;
    u.left.swap_sum(&mut u.right);
    u.left * 10 + u.right
}
theorem lend_by_fields_open(a, b: Nat): lend_by_fields(Two(a, b)) = b * 10 + a { refl }

// `mut self` beside another live path: the receiver comes back outermost,
// then the lent places in parameter order, the answer innermost.
fn Counter::give(mut self c: Counter, into: &mut Nat, k: Nat) → Nat {
    c := Counter(c.n + k, c.log);
    into := into + c.n;
    k
}
theorem give_kernel(c: Counter, a, k: Nat):
    Counter::give(c, a, k) = Mutated(Counter(c.n + k, c.log), Mutated(a + (c.n + k), k)) { refl }
theorem give_modes(): True { by modes_are("Counter::give", [2, 2, 0]) }

fn use_give(c: Counter, a: Nat) → Nat {
    let mut d = c;
    let mut t = a;
    let r = d.give(&mut t, 2);
    d.give(&mut t, 3);
    r + t + d.n
}
theorem use_give_open(c: Counter, a: Nat): use_give(c, a) = 2 + (a + (c.n + 2) + (c.n + 2 + 3)) + (c.n + 2 + 3) { refl }

// In a loop, the receiver and the lent place are both its state.
fn loop_give(c: Counter, xs: List<Nat>) → Nat {
    let mut d = c;
    let mut t = 0;
    for x in xs { d.give(&mut t, x); }
    t + d.n
}
theorem loop_give_lit(): loop_give(Counter(0, []), [1, 2]) = (1 + 3) + 3 { refl }

// A plain receiver beside a lent place: the receiver is not rebound,
// whether or not it could be.
fn use_run(k: u64) → u64 {
    let mut s = Step(k);
    let mut t: u64 = 1;
    let r = s.run(&mut t);
    r + t + s.by
}
theorem use_run_lit(): use_run(2) = 16 { refl }
fn use_run_fixed(k: u64) → u64 {
    let s = Step(k);
    let mut t: u64 = 1;
    s.run(&mut t);
    t
}
theorem use_run_fixed_lit(): use_run_fixed(2) = 7 { refl }

// A recursion through both: a `mut self` method lending its other path on,
// and a function whose `&mut` first parameter is the receiver.
fn Counter::drain(mut self c: Counter, into: &mut Nat, n: Nat) → Nat decreases n {
    match n {
        Zero => into,
        Succ(k) => {
            c.give(&mut into, 1);
            c.drain(&mut into, k)
        },
    }
}
theorem drain_lit(): Counter::drain(Counter(0, []), 0, 2) = Mutated(Counter(2, []), Mutated(1 + 2, 1 + 2)) { refl }

fn Nat::count_into(a: &mut Nat, b: &mut Nat, n: Nat) → Nat decreases n {
    match n {
        Zero => a,
        Succ(k) => {
            a := a + 1;
            a.count_into(&mut b, k)
        },
    }
}
theorem count_into_lit(): Nat::count_into(0, 5, 2) = Mutated(2, Mutated(5, 2)) { refl }

// ---------------------------------------------------------------------------
// A dot call threads its receiver where the receiver was written a live path
// (`mut self`, `self: &mut`), read from the callee's recorded modes, not from
// its result (issues/mutated-result-dot-call-diagnostic.md). A plain `self`
// whose result is a `Mutated` record answers that record, as its qualified
// call does, also on a `let mut` local.

fn Counter::split(self c: Counter, k: Nat) → Mutated<Counter, Nat> { Mutated(Counter(c.n + k, c.log), c.n) }
theorem split_dotted(c: Counter): c.split(1).value = c.n { refl }
theorem split_qualified(c: Counter): Counter::split(c, 1).value = c.n { refl }

fn split_on_local(c: Counter) → Nat {
    let mut d = c;
    let r = d.split(2);
    r.value + r.after.n + d.n
}
theorem split_on_local_open(c: Counter): split_on_local(c) = c.n + (c.n + 2) + c.n { refl }

// expect-error: `split` is not a `mut self` method
fn split_statement(c: Counter) → Nat {
    let mut d = c;
    d.split(2);
    d.n
}

// Under a projection, a `mut self` call no statement threads is refused
// with its own reason, not as a field the receiver lacks.
// expect-error: `tally` is a `mut self` method, so it updates its receiver, and nothing here keeps the update
theorem tally_projected(c: Counter): c.tally(1).value = c.n + 1 { refl }

// ---------------------------------------------------------------------------
// A call that lends places where it is surely run, anywhere in a statement's
// expression: it runs first, inner calls before outer and left to right,
// and the expression reads its answer (issues/parameter-modes-residue.md).

// An operand.
fn lend_in_operand(x: Nat) → Nat {
    let mut p = x;
    let r = add_into(&mut p, 1) + 10;
    r + p
}
theorem lend_in_operand_open(x: Nat): lend_in_operand(x) = (x + 1 + 10) + (x + 1) { refl }

// An argument of a call that lends too: the inner call runs first.
fn lend_in_argument(x: Nat) → Nat {
    let mut p = x;
    let mut q = x;
    let r = add_into(&mut p, add_into(&mut q, 2));
    r + q
}
theorem lend_in_argument_open(x: Nat): lend_in_argument(x) = (x + (x + 2)) + (x + 2) { refl }

// A statement whose call takes another's answer.
fn lend_in_statement(x: Nat) → Nat {
    let mut p = x;
    let mut q = x;
    add_into(&mut p, add_into(&mut q, 1));
    p + q
}
theorem lend_in_statement_open(x: Nat): lend_in_statement(x) = (x + (x + 1)) + (x + 1) { refl }

// `return`: the places are rebound before the function leaves, and in a
// function with a live path, the path returned is the one after.
fn lend_in_return(x: Nat, b: Bool) → Nat {
    let mut p = x;
    if b { return add_into(&mut p, 5); }
    p
}
theorem lend_in_return_true(x: Nat): lend_in_return(x, True) = x + 5 { refl }
theorem lend_in_return_false(x: Nat): lend_in_return(x, False) = x { refl }

fn lend_in_return_path(a: &mut Nat, b: Bool) → Nat {
    if b { return add_into(&mut a, 5) + 1; }
    0
}
theorem lend_in_return_path_true(x: Nat): lend_in_return_path(x, True) = Mutated(x + 5, x + 5 + 1) { refl }

// An arm of a branch that ends a block (§19.1): the bare call, or an
// expression holding it.
fn lend_in_arm(x: Nat, b: Bool) → Nat {
    let mut p = x;
    match b {
        True => add_into(&mut p, 3),
        False => p,
    }
}
theorem lend_in_arm_true(x: Nat): lend_in_arm(x, True) = x + 3 { refl }
theorem lend_in_arm_false(x: Nat): lend_in_arm(x, False) = x { refl }

fn lend_in_arm_path(a: &mut Nat, b: Bool) → Nat {
    match b {
        True => add_into(&mut a, 3) * 2,
        False => 0,
    }
}
theorem lend_in_arm_path_true(x: Nat): lend_in_arm_path(x, True) = Mutated(x + 3, (x + 3) * 2) { refl }
theorem lend_in_arm_path_false(x: Nat): lend_in_arm_path(x, False) = Mutated(x, 0) { refl }

// The value of an assignment, and a block's end inside an expression.
fn lend_in_assignment(x: Nat) → Nat {
    let mut p = x;
    let mut q = 0;
    q := add_into(&mut p, 4);
    q + p
}
theorem lend_in_assignment_open(x: Nat): lend_in_assignment(x) = (x + 4) + (x + 4) { refl }

fn zero() → Nat { 0 }
fn lend_in_tail(mut x: Nat) → Nat { add_into(&mut x, 3) + zero() }
theorem lend_in_tail_open(x: Nat): lend_in_tail(x) = x + 3 + 0 { refl }

// A monadic bind binds the answer; the place is rebound beside it.
fn some_into(acc: &mut Nat, k: Nat) → Option<Nat> {
    acc := acc + k;
    Some(acc)
}
fn lend_in_bind(x: Nat) → Option<Nat> {
    let mut p = x;
    let r <- some_into(&mut p, 2);
    Some(r + p)
}
theorem lend_in_bind_open(x: Nat): lend_in_bind(x) = Some((x + 2) + (x + 2)) { refl }

// ---------------------------------------------------------------------------
// A recursion is held to the modes its declaration wrote, as any call is,
// though its table is not registered while its body elaborates.

// expect-error: `count_by`'s parameter `by` is not `&mut`
fn count_by(acc: &mut Nat, by: Nat, n: Nat) → Nat decreases n {
    match n {
        Zero => acc,
        Succ(k) => {
            let mut b = by;
            count_by(&mut acc, &mut b, k)
        },
    }
}

// expect-error: `count_both` takes `b` as `&mut`
fn count_both(a: &mut Nat, b: &mut Nat, n: Nat) → Nat decreases n {
    match n {
        Zero => a,
        Succ(k) => count_both(&mut a, 3, k),
    }
}

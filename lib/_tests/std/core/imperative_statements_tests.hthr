// Probes of local state in pure code (docs/sequencing-surface-design.md §4,
// §5.1; issues/pure-imperative-statements.md): `let mut`, `x := e` and a
// statement `if`/`match` that joins per variable, all lowered by the parser
// to ordinary `let`s. Each form at literal and neutral inputs, at an open
// element type, in checking position, and with the negative controls the
// lowering refuses (the parse-time ones are in
// crates/syntax/tests/imperative_statements.rs: a parse error refuses the
// whole file). Tests, not library: nothing outside lib/_tests imports
// this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import list;

// Straight-line reassignment: each `:=` is a new alias checked at the
// local's declared type.
fn straight(n: Nat) → Nat {
    let mut x = n;
    x := x + 1;
    x := x * 2;
    x
}
theorem straight_lit(): straight(3) = 8 { refl }
// Neutral: the lowered term is the chain of `let`s.
theorem straight_unfolds(n: Nat): straight(n) = (n + 1) * 2 { refl }

// An open element type: the local keeps the parameter's type.
fn keep_last<A>(a, b: A, swap: Bool) → A {
    let mut r = a;
    if swap = True { r := b }
    r
}
theorem keep_last_swapped(): keep_last(1, 2, True) = 2 { refl }
theorem keep_last_kept(): keep_last(1, 2, False) = 1 { refl }
theorem keep_last_open<A>(a, b: A): keep_last(a, b, True) = b { refl }

// A statement `if` with an `else`, assigning two locals: one join each.
fn order(a, b: Nat) → Nat {
    let mut lo = a;
    let mut hi = b;
    if a <= b {
        lo := a
    } else {
        lo := b;
        hi := a
    }
    hi - lo
}
theorem order_swapped(): order(5, 2) = 3 { refl }
theorem order_kept(): order(2, 5) = 3 { refl }

// `else if` chains, ending without an `else`.
fn grade(n: Nat) → Nat {
    let mut g = 0;
    if 90 <= n { g := 3 } else if 50 <= n { g := 2 } else if 10 <= n { g := 1 }
    g
}
theorem grade_top(): grade(95) = 3 { refl }
theorem grade_mid(): grade(60) = 2 { refl }
theorem grade_low(): grade(20) = 1 { refl }
theorem grade_none(): grade(5) = 0 { refl }

// A statement `match` over a neutral scrutinee.
fn bump(o: Option<Nat>) → Nat {
    let mut total = 10;
    match o {
        Some(k) => { total := total + k },
        None => {},
    }
    total
}
theorem bump_some(): bump(Some(5)) = 15 { refl }
theorem bump_none(): bump(None) = 10 { refl }
theorem bump_neutral(k: Nat): bump(Some(k)) = 10 + k { refl }

// Nesting: an inner body declares its own `mut` and assigns an outer one.
fn nested(c, d: Bool) → Nat {
    let mut x = 1;
    if c = True {
        let mut y = 2;
        if d = True { x := 10; y := 20 }
        x := x + y
    }
    x
}
theorem nested_tt(): nested(True, True) = 30 { refl }
theorem nested_tf(): nested(True, False) = 3 { refl }
theorem nested_f(c: Bool): nested(False, c) = 1 { refl }

// In checking position: the local's type comes from its first value, and a
// later assignment is checked against it.
fn checked(xs: List<Nat>) → List<Nat> {
    let mut acc = xs;
    acc := List::Cons(0, acc);
    acc
}
theorem checked_lit(): checked([1]) = [0, 1] { refl }

// An assignment does not change the local's type.
// expect-error: is a constructor of `Bool`, which is not the expected type here
fn retyped() → Nat {
    let mut x = 1;
    x := True;
    0
}

// Probes of `lib/std/itree/coitree.hthr` (`docs/coitree-design.md`):
// observations at a literal and an open depth, generic results and events,
// and a client's own corecursive bisimilarity with its observation equations
// in checking position. Tests, not library: nothing outside lib/_tests
// imports this module (docs/test-value-audit.md §4.5). Moved from
// crates/elab/tests/lib_std_coitree.rs; the refusals stay there.
import logic; import nat; import itree; import itree_trace; import coitree;

// A counter loop with no fuel: `iter` goes round until the counter is zero.
fn down_body(E: Events, a: Nat) → CoTree<Step<Nat, Nat>>(E) {
    match a { Zero => CRet(Break(0)), Succ(m) => CRet(Continue(m)) }
}
fn down(E: Events, a: Nat) → CoTree<Nat>(E) { CoTree::iter(E, λ x => down_body(E, x), a) }

// Observations compute at a literal depth and at an open one, for `spin` and
// for a loop.
theorem spin_two<R>(E: Events): CoTree::approx(E, 2, CoTree::spin<R>(E)) = Tau(Tau(Cut)) { refl }
theorem spin_open<R>(E: Events, n: Nat): CoTree::approx(E, Succ(n), CoTree::spin<R>(E)) = Tau(CoTree::approx(E, n, CoTree::spin<R>(E))) { refl }
theorem down_obs(E: Events): CoTree::obs(E, down(E, 2)) = OTau(down(E, 1)) { refl }
theorem down_one(E: Events): CoTree::approx(E, 2, down(E, 1)) = Tau(Ret(0)) { refl }
theorem down_cont(E: Events, n: Nat): CoTree::obs(E, down(E, Succ(n))) = OTau(down(E, n)) {
    CoTree::iter_continue(E, λ x => down_body(E, x), Succ(n), n, refl)
}

// A client's own coinduction, and a bisimilarity used through the bridge to
// approximations and through transitivity.
fn spin_self<R>(E: Events) → Bisim<R>(E, CoTree::spin(E), CoTree::spin(E)) {
    BTau(CoTree::spin(E), CoTree::spin(E), refl, refl, spin_self(E))
}
theorem ret_r_approx<R>(E: Events, n: Nat, t: CoTree<R>(E)):
    ITree::Same(E, CoTree::approx(E, n, CoTree::bind(E, t, λ r => CRet(r))), CoTree::approx(E, n, t))
{
    Bisim::approx(E, n, CoTree::bind(E, t, λ r => CRet(r)), t, CoTree::bind_ret_r(E, t))
}
fn ret_r_twice<R>(E: Events, t: CoTree<R>(E)) → Bisim<R>(E, CoTree::bind<R, R>(E, CoTree::bind<R, R>(E, t, λ r => CRet(r)), λ r => CRet(r)), t) {
    Bisim::trans(E, CoTree::bind<R, R>(E, CoTree::bind<R, R>(E, t, λ r => CRet(r)), λ r => CRet(r)),
        CoTree::bind<R, R>(E, t, λ r => CRet(r)), t,
        CoTree::bind_ret_r(E, CoTree::bind(E, t, λ r => CRet(r))), CoTree::bind_ret_r(E, t))
}

// Constructors nested above a corecursive call (codata-elaborator-design
// §5.4): a call, then a silent step, then the call again, with the answer
// captured by the pending `CTau` as the next seed and a leaf in another arm.
fn Ask() → Events { Events(True, λ _ => Nat) }
fn answer(o: Obs<Nat>(Ask()), a: Nat) → CoTree<Nat>(Ask()) {
    match o { ORet(r) => CRet(r), OTau(s) => s, OVis(_, k) => k(a) }
}
fn echo(acc: Nat) → CoTree<Nat>(Ask()) {
    CVis(trivial, λ n => match n { Zero => CRet(acc), Succ(_) => CTau(echo(n + acc)) })
}
theorem echo_ticks(): CoTree::obs(Ask(), answer(CoTree::obs(Ask(), echo(1)), 2)) = OTau(echo(3)) { refl }
theorem echo_ticks_open(acc: Nat, m: Nat):
    CoTree::obs(Ask(), answer(CoTree::obs(Ask(), echo(acc)), Succ(m))) = OTau(echo(Succ(m) + acc)) { refl }
theorem echo_stops(acc: Nat): CoTree::obs(Ask(), answer(CoTree::obs(Ask(), echo(acc)), 0)) = ORet(acc) { refl }
// expect-error(kernel): the kernel rejected `echo_stops_wrong`: NotConvertible
theorem echo_stops_wrong(): CoTree::obs(Ask(), answer(CoTree::obs(Ask(), echo(2)), 0)) = ORet(0) { refl }

// Generic results and events, three layers, and a fixed continuation.
fn loop2<R>(E: Events, c: E.Cmd) → CoTree<R>(E) { CVis(c, λ a => CTau(CTau(loop2(E, c)))) }
fn mixed<R>(E: Events, c: E.Cmd, k: E.Resp(c) → CoTree<R>(E)) → CoTree<R>(E) { CTau(CVis(c, λ a => CTau(mixed(E, c, k)))) }
theorem loop2_approx<R>(E: Events, c: E.Cmd):
    CoTree::approx(E, 4, loop2<R>(E, c)) = Vis(c, λ a => Tau(Tau(Vis(c, λ b => Cut)))) { refl }
theorem mixed_approx<R>(E: Events, c: E.Cmd, k: E.Resp(c) → CoTree<R>(E)):
    CoTree::approx(E, 4, mixed(E, c, k)) = Tau(Vis(c, λ a => Tau(Tau(Cut)))) { refl }

// Nested above a call into an indexed family: a bisimulation that matches
// two observations per step, each pending node at its own pair of trees.
fn after<R>(E: Events, t: CoTree<R>(E)) → CoTree<R>(E) { match CoTree::obs(E, t) { OTau(s) => s, _ => t } }
fn tick2<R>(E: Events) → CoTree<R>(E) { CTau(CTau(tick2(E))) }
fn tick2_self<R>(E: Events) → Bisim<R>(E, tick2(E), tick2(E)) {
    BTau(after(E, tick2(E)), after(E, tick2(E)), refl, refl,
         BTau(after(E, after(E, tick2(E))), after(E, after(E, tick2(E))), refl, refl, tick2_self(E)))
}
fn spin_twice<R>(E: Events) → Bisim<R>(E, CoTree::spin(E), CoTree::spin(E)) {
    BTau(CoTree::spin(E), CoTree::spin(E), refl, refl, BTau(CoTree::spin(E), CoTree::spin(E), refl, refl, spin_twice(E)))
}
theorem spin_twice_approx<R>(E: Events, n: Nat):
    ITree::Same(E, CoTree::approx(E, n, CoTree::spin<R>(E)), CoTree::approx(E, n, CoTree::spin<R>(E)))
{
    Bisim::approx(E, n, CoTree::spin(E), CoTree::spin(E), spin_twice(E))
}

// `inj` and `absurd` through an observation that reaches its constructor only
// by reducing a codata `match` (issues/kernel-refuses-inj-through-corecursive-reduct.md):
// the reduct reads its fields as projections of a bare pair, which the
// kernel cannot infer, so `inj` reads them off before emitting. A literal
// tree with a neutral payload, a combinator whose field is a λ applied to
// such a projection, a client's own corecursive function at an open event
// set, a checking position, and the negative control.
theorem inj_obs_ret(E: Events, n: Nat, r: Nat, e: CoTree::obs<Nat>(E, CRet(n)) = ORet(r)): n = r { inj(e) }
theorem inj_obs_map(E: Events, n: Nat, r: Nat,
    e: CoTree::obs<Nat>(E, CoTree::map<Nat, Nat>(E, CRet(n), λ m => Succ(m))) = ORet(r)): Succ(n) = r
{
    inj(e)
}

record Stamped<R> { count: Nat, value: R }

fn stamp_obs<R>(E: Events, ans: (c: E.Cmd) → E.Resp(c), o: Obs<R>(E), w: Nat) → Partial(Stamped<R>) {
    match o {
        ORet(r) => CRet(Stamped(w, r)),
        OTau(s) => CTau(stamp_obs(E, ans, CoTree::obs(E, s), Succ(w))),
        OVis(c, k) => CTau(stamp_obs(E, ans, CoTree::obs(E, k(ans(c))), Succ(w))),
    }
}

theorem inj_corec_ret<R>(E: Events, ans: (c: E.Cmd) → E.Resp(c), x: R, w: Nat, r: R,
    e: CoTree::obs<R>(Events::none(), CoTree::map<Stamped<R>, R>(Events::none(), stamp_obs<R>(E, ans, ORet(x), w), λ m => m.value)) = ORet(r)):
    x = r
{
    let q: (x = r) = inj(e);
    q
}
theorem inj_corec_tau_ret<R>(E: Events, ans: (c: E.Cmd) → E.Resp(c), s: CoTree<R>(E), w: Nat, r: Stamped<R>,
    e: CoTree::obs<Stamped<R>>(Events::none(), stamp_obs<R>(E, ans, OTau(s), w)) = ORet(r)): False
{
    absurd(e)
}
// expect-error: which are different constructors (use `absurd`)
theorem inj_corec_tau_ret_refused<R>(E: Events, ans: (c: E.Cmd) → E.Resp(c), s: CoTree<R>(E), w: Nat, r: Stamped<R>,
    e: CoTree::obs<Stamped<R>>(Events::none(), stamp_obs<R>(E, ans, OTau(s), w)) = ORet(r)): False
{
    inj(e)
}

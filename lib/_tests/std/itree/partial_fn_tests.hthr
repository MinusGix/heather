// Probes of `partial fn` and of `while` with no measure
// (docs/language/partial-functions-design.md §4, docs/language/sequencing-surface-design.md
// §18, issues/partial-fn-surface.md). A partial function runs at literals by
// a count and `refl` (tail calls, bound calls, several parameters, an open
// element type, events). A body whose every self-call is a tail call is a
// loop, `CoTree::iter` of a pass (issues/partial-fn-tail-iter.md), and its
// result and its divergence are proved by the invariant rule
// `CoTree::iter_sound`; a body with a bound call is `CoTree::rec`, and its
// result is proved by fixpoint induction over `f::body`. `f::unfold` is the
// definition. A `while` with no measure runs in `Partial` and in
// `CoTree<_>(E)`, with a bind in its body and several locals, and is refused
// in a carrier that cannot iterate and in pure code. `CoTree` itself is a
// sequencing carrier (issues/codata-type-constructor-carrier.md). Tests, not
// library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import list; import omega; import int;
import itree; import itree_trace; import coitree; import coitree_eutt; import coitree_rec;

// ---------------------------------------------------------------------------
// `CoTree<_>(E)` as a carrier: a class over a type constructor learns
// `λ R => CoTree<R>(E)` from `CoTree<Nat>(E)`, and binding statements chain
// trees.

fn twice({M: Type → Type}, x: M(Nat), b: Bind<M> := infer, p: Pointed<M> := infer) → M(Nat) {
    b.bind(x, λ n => p.pure(n + n))
}
fn three(E: Events) → CoTree<Nat>(E) { CRet(3) }
theorem twice_tree(): CoTree::obs(Events::none(), twice(three(Events::none()))) = ORet(6) { refl }
// At an open event family, and a neutral tree.
fn twice_open(E: Events, t: CoTree<Nat>(E)) → CoTree<Nat>(E) { twice(t) }
theorem twice_open_is(E: Events, t: CoTree<Nat>(E)): twice_open(E, t) = CoTree::bind(E, t, λ n => CRet(n + n)) { refl }

fn chain(E: Events, a: CoTree<Nat>(E), b: CoTree<Nat>(E)) → CoTree<Nat>(E) {
    let x <- a;
    let y <- b;
    Pointed::ret(x + y)
}
theorem chain_lit(): CoTree::after(Events::none(), 2, chain(Events::none(), three(Events::none()), CTau(three(Events::none())))) = ORet(6) { refl }
// `Partial(B)` is `CoTree<B>(Events::none())`, so the same carrier.
fn chain_partial(a: Partial(Nat), b: Partial(Nat)) → Partial(Nat) {
    let x <- a;
    Pointed::ret(x + (<- b))
}
theorem chain_partial_lit(): CoTree::after(Events::none(), 0, chain_partial(CRet(1), CRet(2))) = ORet(3) { refl }

// ---------------------------------------------------------------------------
// `partial fn`: an unbounded search, a tail call. Its type is
// `Nat → Partial(Nat)`, and it is a loop: its body is one pass, `Continue`
// at the call and `Break` at the return.

fn big(m: Nat) → Bool { 50.leb(m * m) }

partial fn search(n: Nat) → Nat {
    match big(n) { True => Pointed::ret(n), False => search(Succ(n)) }
}

theorem search_0(): CoTree::after(Events::none(), 40, search(0)) = ORet(8) { refl }
theorem search_0_returns(): Returns(Events::none(), search(0), 8) { Returns(40, refl) }
theorem search_9(): CoTree::after(Events::none(), 0, search(9)) = ORet(9) { refl }
// The definition, by name: `CoTree::iter` of the pass.
theorem search_is(n: Nat): search(n) = CoTree::iter(Events::none(), search::body, n) {
    search_unfold(n)
}
// The pass at a call goes round again, and at a return stops.
theorem search_body_call(): search::body(0) = CRet(Continue(1)) { refl }
theorem search_body_stop(): search::body(9) = CRet(Break(9)) { refl }

// The negative controls: a wrong value, and a count too small to reach it.
// expect-error(kernel): the kernel rejected `search_wrong`: NotConvertible
theorem search_wrong(): CoTree::after(Events::none(), 40, search(0)) = ORet(7) { refl }
// expect-error(kernel): the kernel rejected `search_short`: NotConvertible
theorem search_short(): CoTree::after(Events::none(), 3, search(0)) = ORet(8) { refl }

// Its result, by the invariant rule: whatever it returns is big. The pass
// keeps `I` (here nothing) on the states it goes round with and `Q` on the
// value it stops with. A proof cases on what the pass matches on; `big(n)`
// is computed, so the case split is on a helper that takes it as a
// parameter, and the pass is that helper at `big(n)` by conversion
// (docs/proof-patterns.md §4).
fn search_at(n: Nat, b: Bool) → CoTree<Step<Nat, Nat>>(Events::none()) {
    match b { True => CRet(Break(n)), False => CRet(Continue(Succ(n))) }
}
theorem search_pass_at(n: Nat, b: Bool): big(n) = b → (x: Step<Nat, Nat>) → Returns(Events::none(), search_at(n, b), x) →
    Step::Within(λ _ => True, λ r => big(r) = True, x)
{
    match b {
        True => λ c x h => Returns::ret(Events::none(), Break(n), x, h, λ y => Step::Within(λ _ => True, λ r => big(r) = True, y), c),
        False => λ c x h => Returns::ret(Events::none(), Continue(Succ(n)), x, h, λ y => Step::Within(λ _ => True, λ r => big(r) = True, y), trivial),
    }
}
theorem search_pass(n: Nat, x: Step<Nat, Nat>, h: Returns(Events::none(), search::body(n), x)):
    Step::Within(λ _ => True, λ r => big(r) = True, x)
{
    search_pass_at(n, big(n), refl, x, h)
}
theorem search_returns_big(n: Nat, r: Nat, h: Returns(Events::none(), search(n), r)): big(r) = True {
    CoTree::iter_sound(Events::none(), search::body, λ _ => True, λ r2 => big(r2) = True, λ a _ x h2 => search_pass(a, x, h2),
        n, trivial, r, h)
}

// The negative control: the rule proves no false result. `search` stops,
// so its pass does not keep `False` on what it stops with.
// expect-error(mismatch)
theorem search_never(n: Nat, r: Nat, h: Returns(Events::none(), search(n), r)): False {
    CoTree::iter_sound(Events::none(), search::body, λ _ => True, λ _ => False, λ a _ x h2 => search_pass(a, x, h2),
        n, trivial, r, h)
}

// Two parameters and a neutral invariant: the state is the pair, and the
// sum `n + acc` is what every pass keeps.
partial fn walk(n: Nat, acc: Nat) → Nat {
    match n { Zero => Pointed::ret(acc), Succ(m) => walk(m, acc + 1) }
}
theorem walk_3(): CoTree::after(Events::none(), 10, walk(3, 4)) = ORet(7) { refl }
theorem walk_pass(k: Nat, s: Mutated<Nat, Nat>): s.after + s.value = k → (x: Step<Mutated<Nat, Nat>, Nat>) →
    Returns(Events::none(), walk::body(s), x) → Step::Within(λ s2 => s2.after + s2.value = k, λ r => r = k, x)
{
    match s {
        Mutated(n, acc) => match n {
            Zero => λ i x h => Returns::ret(Events::none(), Break(acc), x, h,
                λ y => Step::Within(λ s2 => s2.after + s2.value = k, λ r => r = k, y), omega(i)),
            Succ(m) => λ i x h => Returns::ret(Events::none(), Continue(Mutated(m, acc + 1)), x, h,
                λ y => Step::Within(λ s2 => s2.after + s2.value = k, λ r => r = k, y), omega(i)),
        },
    }
}
theorem walk_sum(n: Nat, acc: Nat, r: Nat, h: Returns(Events::none(), walk(n, acc), r)): r = n + acc {
    CoTree::iter_sound(Events::none(), walk::body, λ s => s.after + s.value = n + acc, λ r2 => r2 = n + acc,
        λ s i x h2 => walk_pass(n + acc, s, i, x, h2), Mutated(n, acc), refl, r, h)
}

// Divergence by the same rule: a function that only calls itself returns
// nothing, because its pass never stops, so `False` is a result invariant
// it keeps.
partial fn again(n: Nat) → Nat { again(n) }

theorem again_never(n: Nat, r: Nat, h: Returns(Events::none(), again(n), r)): False {
    CoTree::iter_sound(Events::none(), again::body, λ _ => True, λ _ => False,
        λ a _ x h2 => Returns::ret(Events::none(), Continue(a), x, h2, λ y => Step::Within(λ _ => True, λ _ => False, y), trivial),
        n, trivial, r, h)
}

// ---------------------------------------------------------------------------
// A bound call, not in tail position: `n + (n - 1) + … + 0`. The call waits
// for its answer, so the function is `CoTree::rec` of its body over its
// calls, and its result is proved by fixpoint induction.

partial fn tri(n: Nat) → Nat {
    match n { Zero => Pointed::ret(0), Succ(m) => { let r <- tri(m); Pointed::ret(n + r) } }
}
theorem tri_4(): CoTree::after(Events::none(), 40, tri(4)) = ORet(10) { refl }
theorem tri_is(n: Nat): tri(n) = CoTree::rec(Events::calls(Nat, Nat), Events::none(), tri::body, n) { tri::unfold(n) }
// A bound call's safety: `CoTree::safe_call_bind`, the continuation safe at
// every answer.
theorem tri_body_safe(n: Nat): CoTree::Safe<Nat>(Events::calls(Nat, Nat), Events::none(), λ d r => d <= r, tri::body(n), λ r => n <= r) {
    match n {
        Zero => CoTree::safe_ret<Nat>(Events::calls(Nat, Nat), Events::none(), λ d r => d <= r, λ r => 0 <= r, 0, omega),
        Succ(m) => CoTree::safe_call_bind<Nat>(Events::calls(Nat, Nat), Events::none(), λ d r => d <= r, λ r => Succ(m) <= r, m,
            λ r => CRet(Succ(m) + r),
            λ r _ => CoTree::safe_ret<Nat>(Events::calls(Nat, Nat), Events::none(), λ d r2 => d <= r2, λ r2 => Succ(m) <= r2, Succ(m) + r, omega)),
    }
}
theorem tri_at_least(n: Nat, r: Nat, h: Returns(Events::none(), tri(n), r)): n <= r {
    CoTree::rec_sound(Events::calls(Nat, Nat), Events::none(), tri::body, λ d r2 => d <= r2, tri_body_safe, n, r, h)
}

// Several parameters are one argument, nested in `Mutated`, which the body
// reads back.
partial fn add(a: Nat, b: Nat) → Nat {
    match b { Zero => Pointed::ret(a), Succ(m) => { let r <- add(a, m); Pointed::ret(Succ(r)) } }
}
theorem add_2_3(): CoTree::after(Events::none(), 40, add(2, 3)) = ORet(5) { refl }
theorem add_body_zero(a: Nat): add::body(Mutated(a, 0)) = CRet(a) { refl }

// An open element type.
partial fn last<A>(x: A, xs: List<A>) → A {
    match xs { Nil => Pointed::ret(x), Cons(y, ys) => last(y, ys) }
}
theorem last_lit(): CoTree::after(Events::none(), 10, last(0, [1, 2, 3])) = ORet(3) { refl }

// A pass that stops with a computation, not a value: the computation's
// value is the `Break`.
partial fn to_three(n: Nat) → Nat {
    match n { Zero => three(Events::none()), Succ(m) => to_three(m) }
}
theorem to_three_lit(): CoTree::after(Events::none(), 10, to_three(2)) = ORet(3) { refl }

// A pass may bind another partial function's call: `Partial(Nat)` is the
// pass's own carrier.
partial fn search_twice(n: Nat) → Nat {
    let r <- search(n);
    match r.leb(n) { True => Pointed::ret(r), False => search_twice(r) }
}
theorem search_twice_lit(): CoTree::after(Events::none(), 80, search_twice(0)) = ORet(8) { refl }

// With events: `partial(E) fn` passes `E`'s commands through. Each round
// asks for a number and stops at zero. A loop's pass is a computation over
// `E` itself, so it issues `E`'s commands as they are.
fn Events::ask() → Events { Events(True, λ _ => Nat) }

partial(Events::ask()) fn total(acc: Nat) → Nat {
    let n <- CoTree::trigger(Events::ask(), trivial);
    match n { Zero => Pointed::ret(acc), Succ(_) => total(acc + n) }
}
// The run stops at its first question, a command of `ask`'s own events:
// it is settled there, not taking silent steps.
theorem total_asks(): Obs::Settled(Events::ask(), CoTree::after(Events::ask(), 5, total(0))) { trivial }
// A body with a bound call answers its own calls among `E`'s commands, so
// it issues `E`'s injected into the sum.
partial(Events::ask()) fn asks(k: Nat) → Nat {
    match k {
        Zero => Pointed::ret(0),
        Succ(m) => {
            let n <- CoTree::trigger(Events::sum(Events::calls(Nat, Nat), Events::ask()), Inr(trivial));
            let r <- asks(m);
            Pointed::ret(n + r)
        },
    }
}
theorem asks_asks(): Obs::Settled(Events::ask(), CoTree::after(Events::ask(), 5, asks(2))) { trivial }

// The refusals, each with its reason.
// expect-error: `never` never calls itself, so it always returns: write it as a plain `fn`
partial fn never(n: Nat) → Nat { Pointed::ret(n) }
// expect-error: `inside` is partial, so a call to it is a computation that may not return: bind it with `let r <- inside(…);`
partial fn inside(n: Nat) → Nat { match n { Zero => Pointed::ret(0), Succ(m) => Pointed::ret(inside(m) + 1) } }
// expect-error: the partial `passed` is called in its own body, not passed
partial fn passed(n: Nat) → Nat { let f = passed; Pointed::ret(n) }
// expect-error: cannot depend on each other yet
partial fn dep(n: Nat, v: [Bool; n]) → Nat { dep(n, v) }
// A call used where its result is expected, from outside the function
// (an imported one: kernel_whnf_tests). The ordinary mismatch between two
// computations is not this refusal.
// expect-error: `search` is partial, so a call to it is a computation that may not return: this one has type `Partial(Nat)`, but `Nat` is expected here; bind it with `let r <- search(…);`
fn search_now(n: Nat) → Nat { search(n) }
// expect-error: `search` is partial, so a call to it is a computation that may not return: this one has type `Partial(Nat)`, but `Nat` is expected here
fn search_big(n: Nat) → Bool { big(search(n)) }
// expect-error: this has type `CoTree<Nat>(none)`, but `CoTree<Bool>(none)` is expected here
fn search_tree(n: Nat) → Partial(Bool) { search(n) }

// ---------------------------------------------------------------------------
// `while` with no measure, in a carrier that iterates: one `Iterate::then`
// call over the loop and the rest of the block. Literal and neutral bounds.

fn count(k: Nat) → Partial(Nat) {
    let mut n = 0;
    while n + 1 <= k { n := n + 1 }
    Pointed::ret(n)
}
theorem count_3(): CoTree::after(Events::none(), 10, count(3)) = ORet(3) { refl }
theorem count_3_returns(): Returns(Events::none(), count(3), 3) { Returns(10, refl) }
// expect-error(kernel): the kernel rejected `count_short`: NotConvertible
theorem count_short(): CoTree::after(Events::none(), 2, count(3)) = ORet(3) { refl }
// A loop that never stops: still a value, observed as silent steps.
fn forever() → Partial(Nat) {
    let mut n = 0;
    while True = True { n := n + 1 }
    Pointed::ret(n)
}
theorem forever_runs(): ¬Obs::Settled(Events::none(), CoTree::after(Events::none(), 30, forever())) { λ s => s }

// Two locals and a bind in the body, over an open event family.
fn sum_ticks(E: Events, k: Nat, tick: CoTree<Nat>(E)) → CoTree<Nat>(E) {
    let mut i = 0;
    let mut acc = 0;
    while i + 1 <= k {
        let t <- tick;
        acc := acc + t;
        i := i + 1
    }
    Pointed::ret(acc + i)
}
theorem sum_ticks_lit(): CoTree::after(Events::none(), 20, sum_ticks(Events::none(), 3, three(Events::none()))) = ORet(12) { refl }

// In a `partial fn`'s own body, beside its calls.
partial fn halve_all(n: Nat) → Nat {
    let mut m = n;
    while 2 <= m { m := m.half() }
    match m { Zero => Pointed::ret(0), Succ(_) => { let r <- halve_all(m - 1); Pointed::ret(r + 1) } }
}
theorem halve_all_lit(): CoTree::after(Events::none(), 40, halve_all(9)) = ORet(1) { refl }
// A tail call after the loop: the loop is a pass's first part.
partial fn halve_down(n: Nat) → Nat {
    let mut m = n;
    while 2 <= m { m := m.half() }
    match m { Zero => Pointed::ret(0), Succ(_) => halve_down(m - 1) }
}
theorem halve_down_lit(): CoTree::after(Events::none(), 40, halve_down(9)) = ORet(0) { refl }
theorem halve_down_is(n: Nat): halve_down(n) = CoTree::iter(Events::none(), halve_down::body, n) { halve_down::unfold(n) }

// The negative controls: a carrier with no `Iterate` instance, and pure code.
// expect-error: a `while` with no measure may go round forever, so it runs only in a block over a carrier that can iterate
fn opt_count(k: Nat) → Option<Nat> {
    let mut n = 0;
    while n + 1 <= k { n := n + 1 }
    Some(n)
}
// expect-error: a `while` with no measure may go round forever, so it runs only in a block over a carrier that can iterate
fn pure_count(k: Nat) → Nat {
    let mut n = 0;
    while n + 1 <= k { n := n + 1 }
    n
}

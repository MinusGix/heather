// Probes of `lib/std/itree/coitree_eutt.hthr`: counts that drop silent
// steps at literal trees in checking position, and a client composing
// equivalences by its own corecursion, through transitivity, and into
// refinement. Tests, not library: nothing outside lib/_tests imports this
// module (docs/test-value-audit.md §4.5). Moved from
// crates/elab/tests/lib_std_coitree_eutt.rs; the refusals stay there.
import logic; import nat; import itree; import itree_trace; import coitree; import coitree_eutt;

fn two_taus(E: Events) → Eutt<Nat>(E, CTau(CTau(CRet(1))), CRet(1)) { ERet(2, 0, 1, refl, refl) }
fn more_than_enough(E: Events) → Eutt<Nat>(E, CRet(1), CTau(CRet(1))) { ERet(5, 7, 1, refl, refl) }
theorem after_open<R>(E: Events, n: Nat, t: CoTree<R>(E)):
    CoTree::after(E, Succ(n), CTau(t)) = CoTree::after(E, n, t) { refl }

fn spin_self<R>(E: Events) → Eutt<R>(E, CoTree::spin(E), CoTree::spin(E)) {
    ETau(3, 1, CoTree::spin(E), CoTree::spin(E), refl, refl, spin_self(E))
}
fn spin_tau<R>(E: Events) → Eutt<R>(E, CoTree::spin(E), CTau(CoTree::spin(E))) {
    ETau(0, 1, CoTree::spin(E), CoTree::spin(E), refl, refl, spin_self(E))
}
fn two_off<R>(E: Events, t: CoTree<R>(E)) → Eutt<R>(E, CTau(CTau(t)), t) {
    Eutt::trans(E, CTau(CTau(t)), CTau(t), t, Eutt::tau_l(E, CTau(t)), Eutt::tau_l(E, t))
}
fn moved<R>(E: Events, t: CoTree<R>(E)) → Eutt<R>(E, CTau(t), CTau(CTau(t))) {
    Eutt::trans(E, CTau(t), t, CTau(CTau(t)), Eutt::tau_l(E, t), Eutt::sym(E, CTau(CTau(t)), t, two_off(E, t)))
}
theorem two_off_refines<R>(E: Events, t: CoTree<R>(E)):
    Program::Refines(E, CoTree::program(E, CTau(CTau(t))), CoTree::program(E, t))
{
    Eutt::refines(E, CTau(CTau(t)), t, two_off(E, t))
}
theorem ret_r_refined<R>(E: Events, t: CoTree<R>(E)):
    Program::Refines(E, CoTree::program(E, t), CoTree::program(E, CoTree::bind(E, t, λ r => CRet(r))))
{
    Eutt::refined(E, CoTree::bind(E, t, λ r => CRet(r)), t, Eutt::bind_ret_r(E, t))
}

// `bind` congruence: at a literal tree whose taus sit on both sides of the
// bind, at a neutral tree (a handler's first step), and through each side.
theorem after_bind_literal(E: Events, h: Nat → CoTree<Nat>(E)):
    CoTree::after(E, 2, CoTree::bind<Nat, Nat>(E, CTau(CTau(CTau(CRet(1)))), h)) = OTau(CoTree::bind<Nat, Nat>(E, CRet(1), h))
{
    CoTree::after_bind(E, h, OTau(CRet(1)), trivial, 2, CTau(CTau(CTau(CRet(1)))), refl)
}
fn taus_both_sides(E: Events) →
    Eutt<Nat>(E, CoTree::bind<Nat, Nat>(E, CTau(CTau(CRet(1))), λ n => CTau(CRet(Succ(n)))),
        CoTree::bind<Nat, Nat>(E, CRet(1), λ n => CRet(Succ(n))))
{
    Eutt::bind_cong(E, CTau(CTau(CRet(1))), CRet(1), λ n => CTau(CRet(Succ(n))), λ n => CRet(Succ(n)),
        two_off(E, CRet(1)), λ n => Eutt::tau_l(E, CRet(Succ(n))))
}
fn bind_tau_l<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E)) →
    Eutt<B>(E, CoTree::bind(E, CTau(t), h), CoTree::bind(E, t, h))
{
    Eutt::bind_cong_l(E, CTau(t), t, h, Eutt::tau_l(E, t))
}
fn bind_tau_r<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E)) →
    Eutt<B>(E, CoTree::bind(E, t, λ a => CTau(h(a))), CoTree::bind(E, t, h))
{
    Eutt::bind_cong_r(E, t, λ a => CTau(h(a)), h, λ a => Eutt::tau_l(E, h(a)))
}
theorem bind_tau_refines<A, B>(E: Events, t: CoTree<A>(E), h: A → CoTree<B>(E)):
    Program::Refines(E, CoTree::program(E, CoTree::bind(E, CTau(t), h)), CoTree::program(E, CoTree::bind(E, t, h)))
{
    Eutt::refines(E, CoTree::bind(E, CTau(t), h), CoTree::bind(E, t, h), bind_tau_l(E, t, h))
}
// A leaf moves `h` to the other value only if the relation says so: `1`
// continued is not `2` continued.
// expect-error(kernel): the kernel rejected `wrong_leaf`: NotConvertible
theorem wrong_leaf(E: Events, h: Nat → CoTree<Nat>(E)):
    CoTree::after(E, 1, CoTree::bind<Nat, Nat>(E, CTau(CRet(1)), h)) = CoTree::after(E, 0, h(2)) { refl }

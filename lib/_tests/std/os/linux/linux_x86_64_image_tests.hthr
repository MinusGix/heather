// The program's own stack (linux_x86_64_image;
// issues/native-target-minimal-system-assumptions.md): a segment of a page
// whose first 1024 bytes are the program's data and whose next 512 its
// stack; the loader's process of a file, which is loaded from the file, its
// code at the entry and its data zero; the stack's top the address the entry
// gives RSP; a word pushed there read back; and the stack past the data and
// inside the segment.
import linux_x86_64_image;
import x86_64;
import x86_64_byte_memory;
import x86_64_stack;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_data_read;
import linux_x86_64_byte_memory;
import bitvec;
import list;
import logic;
import nat;
import option;
import omega;

fn probe_profile() → X86Profile { X86Profile::io(4096) }

theorem probe_within(): 4096 <= io_data_limit() { Nat::leb_sound(4096, io_data_limit(), trivial) }
theorem probe_fits(): 1024 + 512 <= 4096 { Nat::leb_sound(1024 + 512, 4096, trivial) }
theorem probe_inside(): 1024 <= 4096 { Nat::leb_sound(1024, 4096, trivial) }

// A file of one RET, and the process the loader maps of it.
fn probe_file() → List<BitVec(8)> { io_elf_file([BitVec::ofNat(0xc3)], 4096) }
fn probe_memory() → X86Memory(probe_profile()) { X86Memory::io_load(4096, probe_within(), probe_file()) }

theorem probe_loaded(): probe_memory().LoadedFrom(4096, probe_file()) {
    X86Memory::io_load_loaded(4096, probe_within(), probe_file())
}

// Its code at the entry, and its data zero.
theorem probe_code(): CodeResident(probe_profile().fetch(), probe_memory(), [BitVec::ofNat(0xc3)], io_entry()) {
    probe_memory().loaded_entry(4096, probe_within(), io_elf_header(BitVec::ofNat(233), BitVec::ofNat((233).shr(8)), 4096),
        [BitVec::ofNat(0xc3)], refl, Nat::leb_sound(233, 65536, trivial), probe_loaded())
}
theorem probe_zero(): DataRegion::own_data(4096, probe_within(), 1024, probe_inside()).Holds(io_zero(), probe_memory()) {
    probe_memory().loaded_own_data(4096, probe_within(), 1024, probe_inside(), probe_file(), probe_loaded())
}

fn probe_stack() → DataRegion { DataRegion::own_stack(4096, probe_within(), 1024, 512, probe_fits()) }

// The stack's top is the address 1536 bytes into the segment, 0x410600:
// what the entry code moves into RSP.
theorem probe_top(): probe_stack().stack().at(512) = io_data_low().add_nat(1024 + 512) {
    DataRegion::own_stack_top(4096, probe_within(), 1024, 512, probe_fits())
}
theorem probe_top_address(): io_data_low().add_nat(1024 + 512).toNat() = 0x410600 { refl }

// A word pushed into the top word reads back.
theorem probe_slot_fits(): 504 + 8 <= probe_stack().stack().size { Nat::leb_sound(504 + 8, 512, trivial) }
fn probe_pushed(word: BitVec(64)) → X86Memory(probe_profile()) {
    probe_profile().store(probe_memory(), probe_stack().stack().at(504), word_bytes(word))
}
theorem probe_reads_back(word: BitVec(64)):
    read_word(probe_profile().data(), probe_pushed(word), probe_stack().stack().at(504)) = Some(word) {
    probe_stack().stack().stored(probe_memory(), 504, probe_slot_fits(), word)
}

// The stack starts where the data ends and ends inside the segment.
theorem probe_above(): io_data_low().toNat() + 1024 <= probe_stack().low.toNat() {
    DataRegion::own_stack_above(4096, probe_within(), 1024, 512, probe_fits())
}
theorem probe_end(): probe_stack().low.toNat() + 512 <= io_data_end(4096) {
    DataRegion::own_stack_end(4096, probe_within(), 1024, 512, probe_fits())
}

// Probes of `lib/std/data/sorting.hthr`: insertion sort computes at closed
// lists, stably under a key; the lexicographic order refuses a longer list
// below its prefix; and a sort's specification names one output only under
// an antisymmetric order (the negative control: a key order with a tie has
// two). Tests, not library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import sorting; import perm; import order; import relation_props; import list; import nat; import pair; import bool; import logic; import bitvec; import bitvec_order;

theorem nat_sort(): List::insertion_sort(Nat::Le, [3, 1, 2, 1]) = [1, 1, 2, 3] { refl }

// Under a linear order the specification is the output.
theorem nat_sort_unique(xs, out: List<Nat>, h: xs.SortedPerm(Nat::Le, out)): out = xs.insertion_sort(Nat::Le) {
    xs.sorted_perm_unique(Nat::Le, out, xs.insertion_sort(Nat::Le), h, xs.insertion_sort_correct(Nat::Le))
}

// Pairs ordered by their first component only: a total preorder with ties.
fn ByKey(a, b: Pair<Nat, Nat>) → Type { a.fst <= b.fst }

instance DecidableRel<Pair<Nat, Nat>>(ByKey) { rel_dec := λ a b => Nat::le_dec(a.fst, b.fst) }
instance Total<Pair<Nat, Nat>>(ByKey) { rel_total := λ a b => Nat::le_total(a.fst, b.fst) }

fn keyed() → List<Pair<Nat, Nat>> { [Pair(2, 0), Pair(1, 1), Pair(2, 2), Pair(1, 3)] }

// Ties keep their input order: (1, 1) before (1, 3), (2, 0) before (2, 2).
theorem keyed_sort(): keyed().insertion_sort(ByKey) = [Pair(1, 1), Pair(1, 3), Pair(2, 0), Pair(2, 2)] { refl }

// The same at an open input: the elements with key 2 come out in the order
// they went in. Their keys agree, so they chain.
fn key_two(a: Pair<Nat, Nat>) → Bool { a.fst.same(2) }

theorem key_two_chain(): List::Chain(ByKey, key_two) {
    λ a b ha hb => rewrite(a.fst.same_sound(2, ha), b.fst.same_sound(2, hb), Nat::le_refl(2))
}

theorem keyed_stable(xs: List<Pair<Nat, Nat>>): xs.insertion_sort(ByKey).filter(key_two) = xs.filter(key_two) {
    xs.insertion_sort_stable(ByKey, key_two, key_two_chain())
}

// Without antisymmetry the specification does not name one list: both
// orders of a tie are sorted permutations of the input.
fn tie() → List<Pair<Nat, Nat>> { [Pair(1, 0), Pair(1, 1)] }
fn tie_swapped() → List<Pair<Nat, Nat>> { [Pair(1, 1), Pair(1, 0)] }

theorem tie_two_outputs():
    tie().SortedPerm(ByKey, tie()) ∧ tie().SortedPerm(ByKey, tie_swapped()) ∧ ¬(tie() = tie_swapped())
{
    And(And(And(Nat::le_refl(1), And(trivial, trivial)), tie().perm_refl()), And(
        And(And(Nat::le_refl(1), And(trivial, trivial)), List::perm_swap(Pair(1, 0), Pair(1, 1), [])),
        λ e => Nat::zero_ne_succ(0, cong_fn(λ (l: List<Pair<Nat, Nat>>) => l.head_or(Pair(0, 7)).snd, e))))
}

// The lexicographic order: a prefix is below, a longer list is not below its
// prefix, and the order is decided.
theorem lex_prefix(): List::Lex(Nat::Le, [1], [1, 2]) { And(Nat::le_refl(1), λ _ => trivial) }
theorem lex_not_longer(): ¬List::Lex(Nat::Le, [1, 2], [1]) { λ h => h.right(Nat::le_refl(1)) }
theorem lex_first_differs(): List::Lex(Nat::Le, [1, 9], [2]) { And(trivial, λ h => false_elim(h)) }

// Lists of lists sort by the instances `Lex` gets from its element order.
theorem nested_sort(): List::insertion_sort(List::Lex(Nat::Le), [[2], [1, 5], [], [1]]) = [[], [1], [1, 5], [2]] { refl }

// ---------------------------------------------------------------------------
// Sorted by index (`sorted_nth`, `sorted_of_nth`, `sorted_iff_nth`).

// At an open list: the first element is below every later one.
theorem head_below_by_index(xs: List<Nat>, s: xs.Sorted(Nat::Le), k: Nat, a, b: Nat, pos: 0 < k,
    first: xs.nth(0) = Some(a), later: xs.nth(k) = Some(b)): a <= b {
    xs.sorted_nth(Nat::Le, s, 0, k, a, b, pos, first, later)
}

// Both ways at an open list, in a checking position.
theorem sorted_round_trip(xs: List<Nat>, s: xs.Sorted(Nat::Le)): xs.Sorted(Nat::Le) {
    xs.sorted_iff_nth(Nat::Le).mpr(xs.sorted_iff_nth(Nat::Le).mp(s))
}

// The index form reads past neighbours, so it needs the order's
// transitivity: along "one more", [0, 1, 2] is sorted, yet 0 is not one
// below 2. The negative control for `sorted_nth`'s preorder.
fn Next(a, b: Nat) → Type { a + 1 = b }

theorem steps_sorted(): [0, 1, 2].Sorted(Next) { And(refl, And(refl, And(trivial, trivial))) }

theorem steps_not_by_index():
    ¬((i, k: Nat) → (a, b: Nat) → i < k → [0, 1, 2].nth(i) = Some(a) → [0, 1, 2].nth(k) = Some(b) → Next(a, b)) {
    λ all => Nat::zero_ne_succ(0, Nat::succ_inj(0, 1, all(0, 2, 0, 2, trivial, refl, refl)))
}

// The order as an operator section, `(<=)` (issues/parenthesized-operator-symbols.md):
// the bare symbol resolves by the carrier its position asks for, so at a
// list of naturals it is `Nat::Le` and at bytes it is `BitVec::unsigned_le`.
fn sort_nat(xs: List<Nat>) → List<Nat> { xs.insertion_sort((<=)) }
theorem sort_nat_closed(): sort_nat([3, 1, 2, 1]) = [1, 1, 2, 3] { refl }
theorem sort_nat_section(xs: List<Nat>): xs.insertion_sort((<=)) = xs.insertion_sort(Nat::Le) { refl }
theorem sort_bytes_section(xs: List<u8>): xs.SortedPerm((<=), xs.insertion_sort((<=))) {
    xs.insertion_sort_correct(BitVec::unsigned_le)
}
theorem sorted_bytes_section(xs, out: List<u8>, h: xs.SortedPerm((<=), out)): xs.SortedPerm(BitVec::unsigned_le, out) { h }

// Placed before the list, the symbol has no carrier yet (the receiver
// spelling above gives it one), the same as the unparenthesised `<=`.
// expect-error: is not pinned here
theorem sort_section_first(): List::insertion_sort((<=), [3, 1, 2, 1]) = [1, 1, 2, 3] { refl }

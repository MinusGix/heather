// Probes of `lib/std/data/perm.hthr`: permutations built from the
// rearrangement lemmas at closed lists, and refused where counts or lengths
// differ (a `Perm` that held of everything would satisfy every theorem about
// open lists). Tests, not library: nothing outside lib/_tests imports this
// module (docs/test-value-audit.md §4.5).
import perm; import list; import nat; import logic;

// The last element moved to the front, read both ways.
theorem rotate(): Perm<Nat>([3, 1, 2], [1, 2, 3]) { List::perm_middle(3, [1, 2], []) }
theorem rotate_back(): Perm<Nat>([1, 2, 3], [3, 1, 2]) { List::perm_sym<Nat>([3, 1, 2], [1, 2, 3], rotate()) }

// Counts decide it at a carrier with equality: `occurrences` computes.
theorem counts(): List::occurrences([1, 2, 1, 3], 1) = 2 { refl }

// A different multiset is no permutation, though the members agree.
theorem not_perm_counts(): ¬Perm<Nat>([1, 1, 2], [1, 2, 2]) {
    λ p => Nat::succ_ne_zero(0, Nat::succ_inj(1, 0, List::perm_occurrences(1, [1, 1, 2], [1, 2, 2], p)))
}

theorem not_perm_len(): ¬Perm<Nat>([1], [1, 1]) {
    λ p => Nat::succ_ne_zero(0, Nat::succ_inj(1, 0, sym(List::perm_len<Nat>([1], [1, 1], p))))
}

// At an open element type: swapping two halves, and the counting
// characterisation's converse at an open list.
theorem halves<A>(xs, ys: List<A>): Perm(xs ++ ys, ys ++ xs) { xs.perm_append_comm(ys) }

theorem from_counts<A: DecEq>(xs, ys: List<A>, h: (a: A) → xs.occurrences(a) = ys.occurrences(a)): Perm(xs, ys) {
    xs.perm_iff_occurrences(ys).mpr(h)
}

// ---------------------------------------------------------------------------
// Writes by index (`perm_update`, `perm_swap_at`, `occurrences_update`).

// Two elements swapped, at a closed list: the statement computes to it.
theorem swap_ends(): Perm<Nat>([1, 2, 3], [3, 2, 1]) { List::perm_swap_at<Nat>([1, 2, 3], 0, 2, 1, 3, refl, refl) }

// At an open list and open indices, which may be one index: an element
// swapped with itself is still a permutation.
theorem swap_open<A>(xs: List<A>, i, k: Nat, x, y: A, at_i: xs.nth(i) = Some(x), at_k: xs.nth(k) = Some(y)):
    Perm(xs, xs.update(i, λ _ => y).update(k, λ _ => x)) { xs.perm_swap_at(i, k, x, y, at_i, at_k) }

theorem swap_self<A>(xs: List<A>, i: Nat, x: A, at: xs.nth(i) = Some(x)):
    Perm(xs, xs.update(i, λ _ => x).update(i, λ _ => x)) { xs.perm_swap_at(i, i, x, x, at, at) }

// A write moves one count: the old element's is given back in front.
theorem write_counts<A: DecEq>(a: A, xs: List<A>, i: Nat, x, v: A, at: xs.nth(i) = Some(x)):
    Cons(x, xs.update(i, λ _ => v)).occurrences(a) = Cons(v, xs).occurrences(a) { xs.occurrences_update(a, i, x, v, at) }

// A write alone is no permutation: the old element's count drops.
theorem write_not_perm(): ¬Perm<Nat>([1, 2], [1, 2].update(0, λ _ => 5)) {
    λ p => Nat::succ_ne_zero(0, List::perm_occurrences(1, [1, 2], [1, 2].update(0, λ _ => 5), p))
}

// Probes of `lib/std/relation/labelled_transition.hthr`: traces of a
// printing counter, its determinacy, and a pass that drops silent no-ops
// composed with a lock-step one, keeping the printed trace. Tests, not
// library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import labelled_transition; import transition; import relation; import logic; import nat; import option; import pair;
import list; import omega;

// ---------------------------------------------------------------------------
// A printer: each step prints the count and adds one. No step is silent.

fn Print(a: Nat, label: Option<Nat>, b: Nat) → Type {
    match label { None => False, Some(e) => (e = a) ∧ (b = a + 1) }
}

// Three steps from zero print 0, 1, 2.
theorem prints_three(): StarT(Print, [0, 1, 2], 0, 3) {
    StarT::cons(Print, 0, [1, 2], 0, 1, 3, ⟨refl, refl⟩,
        StarT::cons(Print, 1, [2], 1, 2, 3, ⟨refl, refl⟩,
            StarT::cons(Print, 2, Nil, 2, 3, 3, ⟨refl, refl⟩, StarT::refl(Print, 3))))
}

// The same run, as a two-step run followed by a one-step run.
theorem prints_three_appended(): StarT(Print, List::append<Nat>([0, 1], [2]), 0, 3) {
    StarT::append(Print, [0, 1], [2], 0, 2, 3,
        StarT::cons(Print, 0, [1], 0, 1, 2, ⟨refl, refl⟩, StarT::event(Print, 1, 1, 2, ⟨refl, refl⟩)),
        StarT::event(Print, 2, 2, 3, ⟨refl, refl⟩))
}

// The printer is determinate up to equality, whatever two events it
// compares.
theorem print_determinate(): Determinate<Nat, Nat>(Print, λ a b => a = b, λ e f => True) {
    Determinate(
        λ a a2 b b2 same never _ => false_elim(never),
        λ a a2 b b2 e same never _ => false_elim(never),
        λ a a2 b b2 e same _ never => false_elim(never),
        λ a a2 b b2 e f same left right _ => {
            let e_is: (e = a) = left.left;
            let f_is: (f = a2) = right.left;
            let b_is: (b = a + 1) = left.right;
            let b2_is: (b2 = a2 + 1) = right.right;
            let same_at: (a = a2) = same;
            ⟨{ omega }, { omega }⟩
        })
}

// Any two runs from zero printing as many numbers printed the same ones.
theorem prints_once(left, right: List<Nat>, b, b2: Nat, one: StarT(Print, left, 0, b), two: StarT(Print, right, 0, b2),
    lengths: AgreeAll<Nat>(λ e f => True, left, right)): left = right {
    StarT::determined<Nat, Nat>(Print, λ a b => a = b, λ e f => True, print_determinate(), left, right, 0, 0, b, b2,
        refl, one, two, lengths)
}

// So a run from zero printing three numbers printed 0, 1, 2.
theorem three_printed(trace: List<Nat>, b: Nat, run: StarT(Print, trace, 0, b),
    three: AgreeAll<Nat>(λ e f => True, trace, [0, 1, 2])): trace = [0, 1, 2] {
    prints_once(trace, [0, 1, 2], b, 3, run, prints_three(), three)
}

// A trace is what was printed: a run printing 1 first does not start at 0.
// expect-error: NotConvertible
theorem prints_one_first(): StarT(Print, [1], 0, 1) {
    StarT::event(Print, 1, 0, 1, ⟨refl, refl⟩)
}

// ---------------------------------------------------------------------------
// A chattering printer: a state is (no-ops left, count). A no-op is a
// silent step; with none left, a step prints the count.

fn Chatter(a: Pair<Nat, Nat>, label: Option<Nat>, b: Pair<Nat, Nat>) → Type {
    match a.fst {
        Zero => match label { None => False, Some(e) => (e = a.snd) ∧ (b = Pair(0, a.snd + 1)) },
        Succ(k) => match label { None => b = Pair(k, a.snd), Some(_) => False },
    }
}

fn Below(i, j: Nat) → Type { i + 1 = j }

fn Drops(i: Nat, a: Pair<Nat, Nat>, b: Nat) → Type { (a.fst = i) ∧ (a.snd = b) }

// Dropping the no-ops keeps what is printed: a no-op is a stutter whose
// index (the no-ops left) goes down, a print is the printer's.
theorem drops_diagram(): TraceStarDiagram(Chatter, Print, Below, Drops) {
    λ i a label a2 b => match a {
        Pair(pending, _) => match pending {
            Zero => match label {
                None => λ m s => false_elim(s),
                Some(e) => λ m s => Exists(0, Exists(b + 1, ⟨
                    StarT::event(Print, e, b, b + 1, ⟨trans(s.left, m.right), refl⟩),
                    j(sym(s.right), λ x _ => Drops(0, x, b + 1), ⟨refl, Nat::cong_succ(m.right)⟩)⟩)),
            },
            Succ(k) => match label {
                None => λ m s => Exists(k, Exists(b, ⟨Inr(⟨Star::refl(Silent(Print), b), m.left⟩),
                    j(sym(s), λ x _ => Drops(k, x, b), ⟨refl, m.right⟩)⟩)),
                Some(_) => λ m s => false_elim(s),
            },
        },
    }
}

// A run of the chatterer prints what the printer prints from its count.
theorem chatter_prints(trace: List<Nat>, a, a2: Pair<Nat, Nat>, run: StarT(Chatter, trace, a, a2)):
    ∃ j: Nat, ∃ b2: Nat, StarT(Print, trace, a.snd, b2) ∧ Drops(j, a2, b2) {
    TraceStarDiagram::runs(Chatter, Print, Below, Drops, drops_diagram(), trace, a.fst, a, a2, a.snd, ⟨refl, refl⟩, run)
}

// ---------------------------------------------------------------------------
// A printer with a shadow counter that counts in twos, in lock-step with
// the printer; composed with dropping no-ops, it prints what the
// chatterer prints.

fn PrintBoth(a: Pair<Nat, Nat>, label: Option<Nat>, b: Pair<Nat, Nat>) → Type {
    match label { None => False, Some(e) => (e = a.fst) ∧ (b = Pair(a.fst + 1, a.snd + 2)) }
}

fn Shadowed(b: Nat, c: Pair<Nat, Nat>) → Type { (c.fst = b) ∧ (c.snd = b + b) }

theorem shadow_diagram(): TraceLockstepDiagram(Print, PrintBoth, Shadowed) {
    λ b label b2 c => match label {
        None => λ m s => false_elim(s),
        Some(e) => λ m s => {
            let at: (c.fst = b) = m.left;
            let twice: (c.snd = b + b) = m.right;
            let printed: (e = b) = s.left;
            let next: (b2 = b + 1) = s.right;
            Exists(Pair(c.fst + 1, c.snd + 2), ⟨⟨{ omega }, refl⟩, ⟨{ omega }, { omega }⟩⟩)
        },
    }
}

theorem passes_compose(): TraceStarDiagram<Pair<Nat, Nat>, Pair<Nat, Nat>, Nat, Pair<True, Nat>>(Chatter, PrintBoth,
    λ x y => StarComposeLt(Below, λ p q => False, x, y),
    λ k a c => StarCompose(Drops, λ u b c2 => Shadowed(b, c2), k, a, c)) {
    TraceStarDiagram::compose(Chatter, Print, PrintBoth, Below, λ p q => False, Drops, λ u b c2 => Shadowed(b, c2),
        drops_diagram(), TraceLockstepDiagram::star(Print, PrintBoth, λ p q => False, Shadowed, shadow_diagram()))
}

// Through both passes the trace is kept.
theorem chatter_prints_shadowed(trace: List<Nat>, a, a2: Pair<Nat, Nat>, run: StarT(Chatter, trace, a, a2)):
    ∃ k: Pair<True, Nat>, ∃ c2: Pair<Nat, Nat>, StarT(PrintBoth, trace, Pair(a.snd, a.snd + a.snd), c2) ∧
        StarCompose(Drops, λ u b c2 => Shadowed(b, c2), k, a2, c2) {
    TraceStarDiagram::runs(Chatter, PrintBoth, λ x y => StarComposeLt(Below, λ p q => False, x, y),
        λ k s c => StarCompose(Drops, λ u b c2 => Shadowed(b, c2), k, s, c), passes_compose(), trace,
        Pair(trivial, a.fst), a, a2, Pair(a.snd, a.snd + a.snd), Exists(a.snd, ⟨⟨refl, refl⟩, ⟨refl, refl⟩⟩), run)
}

// Into the determinate printer, dropping no-ops is backward: the printer's
// next print from a matched state is the chatterer's step, or the
// chatterer is still dropping no-ops.
theorem drops_backward(i: Nat, a, a2: Pair<Nat, Nat>, b: Nat, label: Option<Nat>, matched: Drops(i, a, b),
    step: Chatter(a, label, a2)):
    ∃ j: Nat, (∃ b3: Nat, Star(Silent(Print), b + 1, b3) ∧ Drops(j, a2, b3) ∧ (label = Some(b))) ∨
        (Below(j, i) ∧ Drops(j, a2, b) ∧ (label = None)) {
    TraceStarDiagram::backward_event(Chatter, Print, Below, Drops, drops_diagram(), λ e f => True, print_determinate(),
        i, a, b, label, a2, b, b + 1, matched, ⟨refl, refl⟩, step, λ e _ => trivial)
}

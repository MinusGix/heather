// Probes of `bv_decide` (lib/std/tactic/bv_decide.hthr): one claim per
// operation the reader takes, claims mixing words and Booleans, claims at
// wider words, and claims it refuses: a false one, answered with a
// counterexample, and one it cannot read.
import logic;
import bool;
import nat;
import bitvec;
import bv_decide;

// Bitwise operations and complement.
theorem demorgan(x, y: u8): (x & y).complement() = x.complement() | y.complement() { by bv_decide() }
theorem xor_twice(x, y: u8): x.bxor(y).bxor(y) = x { by bv_decide() }

// Arithmetic the normalizer decides: a chain of `+`, `-`, `*`, `&`, `|` or
// `bxor` is flattened, sorted and merged before it is blasted, so these
// reach the solver as constants, at any width.
theorem add_comm(x, y: u64): x + y = y + x { by bv_decide() }
theorem add_assoc(x, y, z: u64): x + y + z = z + (y + x) { by bv_decide() }
theorem sub_add(x, y: u64): x - y + y = x { by bv_decide() }
theorem mul_comm(x, y: u64): x * y = y * x { by bv_decide() }
theorem constants(x, y: u8): (x + 1) + (y - 1) = x + y { by bv_decide() }
theorem xor_cancel(x, y: u64): x.bxor(y).bxor(x) = y { by bv_decide() }
theorem and_idem(x, y: u32): (x & y) & x = y & x { by bv_decide() }
theorem neg_neg(x: u64): -(-x) = x { by bv_decide() }

// Arithmetic the solver decides. A proof's check is linear in the solver's
// proof, which grows fast with adders in series: these stay at a few bits
// where a byte costs seconds (docs/tactics/bv-decide-design.md).
theorem neg_is(x: u8): -x = x.complement() + 1 { by bv_decide() }
theorem mul_three(x: BitVec(4)): x * 3 = x + x + x { by bv_decide() }
theorem mul_two(x: u8): x * 2 = x << 1 { by bv_decide() }

// Shifts by a numeral.
theorem shifts(x: u8): (x >> 4) << 4 = x & 0xF0 { by bv_decide() }

// Slices, extension and concatenation.
theorem halves(x: u8): x.take_low(4, 4).concat(x.drop_low(4, 4)) = x { by bv_decide() }
theorem low_byte(x: u16): x.truncate(8, 8) = x.take_low(8, 8) { by bv_decide() }
theorem widen(x: u8): x.zero_extend(8).truncate(8, 8) = x { by bv_decide() }
theorem sign_top(x: u8): x.sign_extend(8).bit_at(15) = x.bit_at(7) { by bv_decide() }

// Comparisons and single bits.
theorem slt_flip(x, y: u8): x.signed_lt_bit(y) = x.bxor(0x80).unsigned_lt_bit(y.bxor(0x80)) { by bv_decide() }
theorem ult_succ(x: u8): (x.eq_bit(255) || x.unsigned_lt_bit(x + 1)) = True { by bv_decide() }
theorem bit0(x: u8): x.bit_at(0) = (x & 1).eq_bit(1) { by bv_decide() }
theorem head0(x: u8): x.head_bit() = x.bit_at(0) { by bv_decide() }

// Booleans, alone and beside words.
theorem bool_comm(b, c: Bool): (b && c) = (c && b) { by bv_decide() }
theorem bool_xor(b, c: Bool): b.xor(c) = ((b || c) && !(b && c)) { by bv_decide() }
theorem mixed(x: u8, b: Bool): (x.bit_at(3) && b) || !b || !x.bit_at(3) = True { by bv_decide() }

// A definition the reader does not know is unfolded.
fn low_nibble(x: u8) → u8 { x & 0x0F }
theorem nibble_twice(x: u8): low_nibble(low_nibble(x)) = low_nibble(x) { by bv_decide() }

// Wider words.
theorem demorgan32(x, y: u32): (x | y).complement() = x.complement() & y.complement() { by bv_decide() }
theorem mask64(x: u64): (x & 0xFF) | (x & 0xFF00) = x & 0xFFFF { by bv_decide() }

// Comparisons as propositions: `<`, `<=` and `≠` between words.
theorem lt_succ(x: u8): x & 0x7F < 0x80 { by bv_decide() }
theorem le_or(x, y: u8): x <= x | y { by bv_decide() }
theorem ne_succ(x: u16): x + 1 ≠ x { by bv_decide() }

// Hypotheses: each local it can read is assumed, in any of the shapes a
// goal takes; one it cannot read is passed over.
theorem lt_hyp(x: u8, h: x.unsigned_lt_bit(10) = True): (x + 1).unsigned_lt_bit(11) = True { by bv_decide() }
theorem lt_trans(x, y, z: u8, a: x < y, b: y < z): x < z { by bv_decide() }
theorem le_antisymm(x, y: u16, a: x <= y, b: y <= x): x = y { by bv_decide() }
theorem eq_hyp(x, y: u8, h: x = y + 1): x - y = 1 { by bv_decide() }
theorem ne_hyp(x: u8, h: x ≠ 0): (x - 1) < x { by bv_decide() }
theorem bool_hyp(b, c: Bool, h: b = True): (b || c) = True { by bv_decide() }
theorem skips(x: u8, n: Nat, h: n = 3): x <= 0xFF { by bv_decide() }

// Refusals: a false claim names values that falsify it; a claim with a
// shift by a variable count is not one the reader takes.
// expect-error: bv_decide: the claim is false at x =
theorem add_left(x, y: u8): x + y = x { by bv_decide() }

// expect-error: bv_decide: the claim is false at b =
theorem not_self(b: Bool): b = !b { by bv_decide() }

// expect-error: bv_decide: a shift count is not a numeral
theorem shift_by(x: u8, n: Nat): x << n = x << n { by bv_decide() }

// A claim false under its hypotheses is answered with values that meet
// them.
// expect-error: bv_decide: the claim is false at x =
theorem lt_not_enough(x: u8, h: x < 200): x < x + 100 { by bv_decide() }

// Numbers of words: `toNat` comparisons, `Nat::leb` and `Succ`, at one width
// and across two.
theorem tonat_bound(x: u8): x.toNat() < 256 { by bv_decide() }
theorem tonat_zero_extend(x: u8): x.zero_extend(56).toNat() = x.toNat() { by bv_decide() }
theorem tonat_succ_under(x: u8, h: x.toNat() < 10): (x + 1).toNat() < 11 { by bv_decide() }
theorem tonat_leb_or(x, y: u8): Nat::leb(x.toNat(), (x | y).toNat()) = True { by bv_decide() }
theorem tonat_shifted_payload(x: u64): ((x & 0x3F) << 6).toNat() <= 4032 { by bv_decide() }
theorem tonat_pred(x: u8, h: x.toNat() ≠ 0): (x - 1).toNat() < x.toNat() { by bv_decide() }
fn payload2(b, c: u8) → Nat { (((b.zero_extend(56) & 0x1F) << 6) + (c.zero_extend(56) & 0x3F)).toNat() }
theorem payload2_no_surrogate(b, c: u8): Succ(payload2(b, c)).leb(0xD800) = True { by bv_decide() }
// `x + 1` is `Succ(x)` by computation, and a strict bound alike.
theorem payload2_plus_one(b, c: u8): (payload2(b, c) + 1).leb(0xD800) = True { by bv_decide() }
// expect-error: bv_decide: the claim is false at x =
theorem tonat_false(x: u8): x.toNat() < 200 { by bv_decide() }

// Negated comparisons in both spellings, as hypotheses and as goals: `¬(…)`
// and the `→ False` a refuted test reads as in an `induct` arm.
theorem not_lt_hyp(x: u8, h: ¬(x.zero_extend(56) < 0x80)): x.bit_at(7) = True { by bv_decide() }
theorem arrow_false_hyp(x: u8, h: x.zero_extend(56) < 0x80 → False): ¬(x.toNat() < 128) { by bv_decide() }
theorem not_le_nat(x: u8, h: ¬(x.toNat() <= 200)): ¬(x <= 200) { by bv_decide() }
theorem not_le_word(x: u8, h: ¬(x <= 0xC0)): ¬(x.toNat() < 0xC1) { by bv_decide() }
// expect-error: bv_decide: the claim is false at x =
theorem not_le_false(x: u8, h: ¬(x < 0x80)): ¬(x.toNat() <= 0x80) { by bv_decide() }

// A word an `if` chooses: the goal is split on the test, inside the call
// and on the other side alike, and each case decided. The verdict as a
// word, as a Boolean against the tests spelled out, and at arguments that
// are themselves calls (the split unfolds one definition at a time, not
// into `zero_extend`'s representation).
fn pick(b, c: u64) → u64 { if c & 0xC0 = 0x80 { let code = ((b & 0x1F) << 6) + (c & 0x3F); if code < 0x80 { 0 } else { 1 } } else { 0 } }
theorem pick_bool(b, c: u64): pick(b, c).eq_bit(0) = !((c & 0xC0).eq_bit(0x80) && !(((b & 0x1F) << 6) + (c & 0x3F)).unsigned_lt_bit(0x80)) { by bv_decide() }
theorem pick_le_one(b, c: u64): pick(b, c) <= 1 { by bv_decide() }
fn as_word(b: u8) → u64 { b.zero_extend(56) }
theorem pick_bytes(b, c: u8): pick(as_word(b), as_word(c)) <= 1 { by bv_decide() }
// expect-error: bv_decide: the claim is false at
theorem pick_false(b, c: u64): pick(b, c) = 0 { by bv_decide() }

// ---- Statements joined by ∧ ∨ ↔ ¬ (goals and hypotheses) ----

theorem conn_and(x: u8): x & 0x0F <= 0x0F ∧ x >> 4 < 0x10 { by bv_decide() }
theorem conn_or(x: u8): x < 0x80 ∨ 0x80 <= x { by bv_decide() }
theorem conn_iff(x: u8): (x & 0x80 = 0) ↔ x < 0x80 { by bv_decide() }
theorem conn_not(x: u8): ¬(x < 0x10 ∧ 0x20 <= x) { by bv_decide() }
theorem conn_nested(x: u8): ¬(x < 0x10 ∨ 0x20 <= x) ∨ x < 0x10 ∨ ¬(x < 0x20) { by bv_decide() }
theorem conn_hyp_nested(x: u8, h: ¬(x < 0x10 ∨ (0x20 <= x ∧ x ≠ 0x40))): x = 0x40 ∨ x < 0x20 { by bv_decide() }
// A range test as the loop's condition reads it, taken and refused.
theorem conn_hyp_and(b, c: u8, ok: c & 0xC0 = 0x80 ∧ (b ≠ 0xE0 ∨ 0xA0 <= c)): 0x80 <= c { by bv_decide() }
theorem conn_hyp_or(b, c: u8, h: b = 0xE0 ∨ b = 0xED, t: 0xE0 <= b): b < 0xEE { by bv_decide() }
theorem conn_hyp_not(c: u8, no: ¬(c & 0xC0 = 0x80 ∧ c < 0xA0), lo: 0x80 <= c, hi: c < 0x90): False { by bv_decide() }
theorem conn_hyp_iff(x, y: u8, h: (x = 0) ↔ (y = 0), z: x = 0): y = 0 { by bv_decide() }
// Contradictory hypotheses prove `False`.
theorem conn_false(x: u8, a: x < 4, b: 8 <= x): False { by bv_decide() }
// expect-error: the claim is false
theorem conn_or_false(x: u8): x < 0x80 ∨ 0x90 <= x { by bv_decide() }

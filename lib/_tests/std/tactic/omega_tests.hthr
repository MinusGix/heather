// Probes of the `omega` tactic (`lib/std/tactic/omega.hthr`,
// `docs/omega-measure-reduction-design.md`). Tests, not library: nothing
// outside lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import int; import omega; import list;

// A field of a call that unfolds to a constructor is read as what was put
// there, through any number of record fields
// (issues/omega-nested-projection-of-call.md, §11 of the design).
record P { pred: Nat }
fn P::of(n: Nat) → P { P(n) }
record Q { num: Int, den: P }
fn Q::at(n: Nat) → Q { Q(OfNat(n), P::of(n)) }
fn Q::twice(n: Nat) → Q { Q(OfNat(n), P::of(n + n)) }
record R { inner: Q, tag: Nat }
fn R::at(n: Nat) → R { R(Q::at(n), n) }
fn bump(b: Bool, n: Nat) → Nat { match b { True => Succ(n), False => n } }
fn Q::bumped(b: Bool, n: Nat) → Q { Q(OfNat(n), P(bump(b, n))) }

// One field put as a variable, then two and three receivers deep.
theorem field_put_as_variable(n: Nat): P::of(n).pred = n { omega }
theorem field_of_field(n: Nat): Q::at(n).den.pred = n { omega }
theorem three_deep(n: Nat): R::at(n).inner.den.pred = n { omega }
// The inner receiver's field is arithmetic.
theorem field_of_field_sum(n: Nat): Q::twice(n).den.pred = n + n { omega }
// At `Int`, in a goal and in a fact.
theorem int_field_of_field(n: Nat): R::at(n).inner.num = OfNat(n) { omega }
theorem int_fact(n: Nat, x: Int, h: x < R::at(n).inner.num): x < OfNat(n) + OfNat(1) { omega }
// In a checking position.
theorem checking(n, m: Nat, h: m < n): m < R::at(n).inner.den.pred {
    let k: (m < R::at(n).inner.den.pred) = omega;
    k
}
// A field put as a call stuck on a match is that call, so it meets the
// call's other mentions.
theorem stuck_call_put(b: Bool, n: Nat): Q::bumped(b, n).den.pred = bump(b, n) { omega }

// Controls. A field put as a stuck call is not unfolded past the call, a
// false claim through a nested field is refused, and a field of a neutral
// record stays an atom.
// expect-error: `omega` got stuck
theorem stuck_call_opaque(b: Bool, n: Nat): Q::bumped(b, n).den.pred <= n { omega }
// expect-error: `omega` got stuck
theorem false_through_fields(n: Nat): R::at(n).inner.den.pred = n + 1 { omega }
// expect-error: `omega` got stuck
theorem neutral_receiver(q: Q, n: Nat): q.den.pred = n { omega }

// At closed arguments a field is read as put, without evaluating it: two
// fields of one call share their atoms though `lay(3)` computes past the
// projection's step budget (issues/omega-closed-field-value-atomised.md).
fn lay(n: Nat) → Nat { List::range(n).map(λ i => i * i).len() }
record Lay { size: Nat, cap: Nat }
fn Lay::of(n: Nat) → Lay { Lay(lay(n), lay(n) + 4) }
theorem at_var(n, a: Nat, h: a < Lay::of(n).size): a < Lay::of(n).cap { omega }
theorem at_lit(a: Nat, h: a < Lay::of(3).size): a < Lay::of(3).cap { omega }
theorem at_lit_goal(): Lay::of(30).size < Lay::of(30).cap { omega }
// Control: a field put as a match on that computation stays an atom, so a
// claim only its value makes true is refused (`Pick::of(3).v` is 2).
record Pick { v: Nat }
fn Pick::of(n: Nat) → Pick { Pick(match lay(n) { Zero => 0, Succ(k) => k }) }
// expect-error: `omega` got stuck
theorem closed_match_opaque(a: Nat, h: a < Pick::of(3).v): a < 2 { omega }

// Integer-only conflicts the real shadow misses go to CutSat, whose
// certificate is one `have` per reachable derivation node
// (docs/certifying-arithmetic-substrate-design.md). The minimal gap: the
// real relaxation is satisfiable, no integer point is.
theorem cutsat_real_shadow_gap(x, y: Int,
    first: NegSucc(1) <= OfNat(2) * x + OfNat(3) * y,
    second: OfNat(2) * x + OfNat(5) * y <= OfNat(0),
    third: OfNat(1) <= y): logic::False
{ omega }

// Pugh's nightmare: a thin real parallelogram holding no integer point. The
// old nested-omega certificate re-ran itself per Cooper case past the rail.
theorem cutsat_pughs_nightmare(x, y: Int,
    a1: OfNat(27) <= OfNat(11) * x + OfNat(13) * y, a2: OfNat(11) * x + OfNat(13) * y <= OfNat(45),
    b1: NegSucc(9) <= OfNat(7) * x + NegSucc(8) * y, b2: OfNat(7) * x + NegSucc(8) * y <= OfNat(4),
    c1: NegSucc(15) <= x, c2: x <= OfNat(16), d1: NegSucc(15) <= y, d2: y <= OfNat(16)): logic::False
{ omega }

// Disequalities go to CutSat whole (`omega::normalized_ne_value`,
// `Int::ofnat_ne` at Nat), which splits one only where its model sits on
// the excluded value; eight of them once cost 2⁸ re-runs of Omega.
theorem cutsat_excludes_every_value(x: Int, low: OfNat(0) <= x, high: x <= OfNat(7),
    h0: x ≠ OfNat(0), h1: x ≠ OfNat(1), h2: x ≠ OfNat(2), h3: x ≠ OfNat(3),
    h4: x ≠ OfNat(4), h5: x ≠ OfNat(5), h6: x ≠ OfNat(6), h7: x ≠ OfNat(7)): logic::False
{ omega }

theorem cutsat_nat_disequalities(m, n: Nat, sum: m + n = 2, apart: m ≠ n, m_pos: m ≠ 0, n_pos: n ≠ 0): logic::False
{ omega }

theorem cutsat_disequality_pins_an_equation(x: Int, low: OfNat(1) <= x, high: x <= OfNat(3),
    not_low: x ≠ OfNat(1), not_high: x ≠ OfNat(3)): x = OfNat(2)
{ omega }

// Nearby satisfiable systems are refused with CutSat's integer point.
// expect-error: CutSat's integer model [x = 1, y = 2]
theorem cutsat_pugh_widened(x, y: Int,
    a1: OfNat(27) <= OfNat(11) * x + OfNat(13) * y, a2: OfNat(11) * x + OfNat(13) * y <= OfNat(45),
    b1: NegSucc(10) <= OfNat(7) * x + NegSucc(8) * y, b2: OfNat(7) * x + NegSucc(8) * y <= OfNat(4),
    c1: NegSucc(15) <= x, c2: x <= OfNat(16), d1: NegSucc(15) <= y, d2: y <= OfNat(16)): logic::False
{ omega }
// expect-error: CutSat's integer model [x = 7]
theorem cutsat_one_value_left(x: Int, low: OfNat(0) <= x, high: x <= OfNat(7),
    h0: x ≠ OfNat(0), h1: x ≠ OfNat(1), h2: x ≠ OfNat(2), h3: x ≠ OfNat(3),
    h4: x ≠ OfNat(4), h5: x ≠ OfNat(5), h6: x ≠ OfNat(6)): logic::False
{ omega }

// Three-variable systems from a seeded generator, each the smallest whose
// certificate uses the named rule; Omega's real shadow refutes none of them.

// A Cooper split under a variable that already carries a divisibility, whose
// cases close on a constant divisibility (`cut_cooper_left`/`right`,
// `cut_constant_dvd`).
theorem cutsat_cooper_carries_a_divisibility(x, y, z: Int,
    h0: NegSucc(3) * x + NegSucc(3) * y + NegSucc(3) * z ≠ OfNat(5),
    h1: NegSucc(3) * x + NegSucc(2) * y + OfNat(1) * z <= OfNat(5),
    h2: OfNat(3) * x + OfNat(2) * y <= NegSucc(5),
    h3: OfNat(2) * x + OfNat(4) * y + OfNat(2) * z <= NegSucc(4),
    h4: NegSucc(3) * y + NegSucc(0) * z <= OfNat(0),
    b0: NegSucc(2) <= x, c0: x <= OfNat(3),
    b1: NegSucc(2) <= y, c1: y <= OfNat(3),
    b2: NegSucc(2) <= z, c2: z <= OfNat(3)): logic::False
{ omega }

// Disequalities split only where the model is cornered (`cut_diseq`).
theorem cutsat_splits_cornered_disequalities(x, y, z: Int,
    h0: OfNat(4) * x + NegSucc(2) * y + NegSucc(1) * z ≠ NegSucc(0),
    h1: OfNat(3) * y + NegSucc(3) * z <= OfNat(2),
    h2: NegSucc(0) * x + NegSucc(0) * z <= NegSucc(5),
    h3: OfNat(1) * x ≠ OfNat(3),
    h4: OfNat(4) * x + OfNat(4) * z ≠ NegSucc(5),
    b0: NegSucc(2) <= x, c0: x <= OfNat(3),
    b1: NegSucc(2) <= y, c1: y <= OfNat(3),
    b2: NegSucc(2) <= z, c2: z <= OfNat(3)): logic::False
{ omega }

// A divisibility whose variable has no admissible value drops it (`cut_dvd_drop`).
theorem cutsat_drops_a_divisibility(x, y, z: Int,
    h0: OfNat(3) * x + NegSucc(2) * y + OfNat(1) * z ≠ NegSucc(1),
    h1: OfNat(4) * x + OfNat(1) * y + NegSucc(1) * z <= OfNat(4),
    h2: NegSucc(1) * x + OfNat(3) * y + NegSucc(1) * z <= OfNat(4),
    h3: OfNat(2) * x + NegSucc(2) * y <= NegSucc(4),
    h4: NegSucc(2) * x + NegSucc(1) * y + OfNat(4) * z <= NegSucc(1),
    b0: NegSucc(2) <= x, c0: x <= OfNat(3),
    b1: NegSucc(2) <= y, c1: y <= OfNat(3),
    b2: NegSucc(2) <= z, c2: z <= OfNat(3)): logic::False
{ omega }

// Two divisibilities on one variable combine into solved form (`cut_dvd_combo`).
theorem cutsat_combines_congruences(x, y, z: Int,
    h0: OfNat(4) * x + NegSucc(0) * y + NegSucc(3) * z <= NegSucc(5),
    h1: OfNat(1) * x + NegSucc(3) * y + OfNat(3) * z <= NegSucc(0),
    h2: NegSucc(1) * x + NegSucc(2) * y + OfNat(1) * z ≠ OfNat(1),
    h3: OfNat(3) * x + OfNat(4) * y + OfNat(2) * z <= OfNat(1),
    h4: NegSucc(2) * x + NegSucc(1) * y + NegSucc(1) * z <= OfNat(1),
    b0: NegSucc(2) <= x, c0: x <= OfNat(3),
    b1: NegSucc(2) <= y, c1: y <= OfNat(3),
    b2: NegSucc(2) <= z, c2: z <= OfNat(3)): logic::False
{ omega }

// A negated relation as the goal is assumed and refuted: `≠`, `¬(_ <= _)`
// and `¬(_ < _)` at Nat and at Int.
theorem ne_goal_nat(a, b: Nat, h: a < b): a ≠ b { omega }
theorem ne_goal_int(a, b: Int, h: a < b): a ≠ b { omega }
theorem not_le_goal_int(a, b: Int, h: a < b): ¬(b <= a) { omega }
theorem not_lt_goal_nat(a, b: Nat, h: a <= b): ¬(b < a) { omega }
// Control: the assumption has a model.
// expect-error: `omega` got stuck
theorem ne_goal_false(a, b: Nat, h: a <= b): a ≠ b { omega }

// A conjunction fact is read as its conjuncts at every depth, right- and
// left-nested, each cited by its projection (`h.right.left`)
// (issues/omega-nested-conjunction-facts.md).
theorem conj_nested(a, b, c: Nat, h: a < b ∧ (b < c ∧ c < 5)): a < 5 { omega }
theorem conj_left_nested(a, b, c: Nat, h: (a < b ∧ b < c) ∧ c < 5): a < 5 { omega }
theorem conj_three_deep(a, b, c, d: Nat, h: a < b ∧ (b < c ∧ (c < d ∧ d < 5))): a < 5 { omega }
// A disjunction under a conjunction is split like a top-level one.
theorem conj_of_or(a, b, c: Nat, h: a < b ∧ (b < c ∨ b < 2), k: c < 3): b < 3 { omega }
// A conjunction passed as an argument, in a checking position.
theorem conj_argument(a, b, c: Nat, h: a < b ∧ (b < c ∧ c < 5)): a < 5 {
    let k: (a < 5) = omega(h);
    k
}
// Control: every conjunct read, and still a model (`a = 2, b = 3, c = 4`).
// expect-error: `omega` got stuck
theorem conj_nested_false(a, b, c: Nat, h: a < b ∧ (b < c ∧ c < 5)): a < 2 { omega }

// A fact typed by a head β-redex is read through its contractum: an
// `Exists`'s `.proof` is `(λ k => P(k))(e.witness)`
// (issues/omega-redex-typed-fact-ignored.md).
theorem ex_proof(a: Nat, e: Exists<Nat>(λ k => a = k + 2)): 2 <= a { omega(e.proof) }
theorem ex_proof_let(a: Nat, e: Exists<Nat>(λ k => a = k + 2)): 2 <= a {
    let p = e.proof;
    omega
}
// The contractum is a conjunction, read as its conjuncts.
theorem ex_proof_conj(a: Nat, e: Exists<Nat>(λ k => a = k + 2 ∧ k < 3)): a < 5 { omega(e.proof) }
// At Int, with the witness under the relation's other side.
theorem ex_proof_int(x: Int, e: Exists<Int>(λ k => k < x ∧ OfNat(3) <= k)): OfNat(3) < x { omega(e.proof) }
// Control: the contractum read, and still a model (`a = 2`).
// expect-error: `omega` got stuck
theorem ex_proof_false(a: Nat, e: Exists<Nat>(λ k => a = k + 2)): 3 <= a { omega(e.proof) }

// `omega` is a checking form: where nothing is expected it says so and how
// to state the goal, not "unbound name"
// (issues/checking-tactic-in-inference-position-diagnostic.md).
// expect-error: `omega` needs an expected type
// expect-error: `let k: (T) = omega(…);`
theorem let_omega_unannotated(a: Nat, h: a < 3): a < 4 { let k = omega(h); k }
// expect-error: `omega` needs an expected type
theorem let_bare_omega_unannotated(a: Nat, h: a < 3): a < 4 { let k = omega; k }

// Mutation controls (docs/tactics/grind-design.md §9.6): goals of grind_tests with
// their lemmas reordered or beside lemmas they do not need. grind visits
// nodes in order under per-round budgets, so closing again is not
// automatic: a proof that survives these is one a growing library is less
// likely to break (the robustness check of Axolocl, CAV 2025). A module of
// its own so that grind_tests stays under its CPU rail.
import logic; import bool; import nat; import list; import option; import char; import string; import tactic; import int; import grind;

theorem tower_nil_reordered<A>(a, b, c: List<A>): ((a ++ []) ++ b) ++ c = a ++ (b ++ c) { by grind_using(["List::append_nil", "List::append_assoc"], []) }
theorem tower_lens_unrelated<A>(a, b, c: List<A>): ((a ++ b) ++ c).len() = a.len() + (b.len() + c.len()) { by grind_using(["Int::add_comm", "Nat::add_assoc", "List::append_nil", "List::len_append"], []) }
theorem regroup_reordered(a, b, c: Int): (a + b) + c = b + (c + a) { by grind_using(["Int::add_comm", "Int::add_assoc"], []) }
theorem regroup_unrelated(a, b, c: Int): (a + b) + c = b + (c + a) { by grind_using(["List::append_assoc", "Int::add_assoc", "List::append_nil", "Int::add_comm"], []) }
theorem neg_add_succ_reordered(a: Int, k: Nat, ih: -(a + OfNat(k)) = -a + -OfNat(k)): -(a + OfNat(k + 1)) = -a + NegSucc(k) {
    by grind_using(["Int::ipred_negOfNat", "Int::add_ipred", "Int::neg_isucc", "Int::add_isucc"], [])
}
// `Int::add_comm` matches every sum both ways, and the search makes about
// 2,700 host requests before the sides meet. That used to be fatal under any
// `bind`: each request lengthened the chain the final `Pure` reads, and its
// native depth ran out (issues/grind-unrelated-lemma-fuel.md).
theorem neg_add_succ_unrelated(a: Int, k: Nat, ih: -(a + OfNat(k)) = -a + -OfNat(k)): -(a + OfNat(k + 1)) = -a + NegSucc(k) {
    by grind_using(["Int::add_isucc", "Int::add_comm", "Int::neg_isucc", "Int::add_ipred", "Int::ipred_negOfNat"], [])
}

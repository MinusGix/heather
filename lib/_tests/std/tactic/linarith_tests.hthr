// Probes of `linarith` (lib/std/tactic/linarith.hthr, docs/tactics/linarith-design.md):
// linear facts at an ordered field, read at its `≈`, the same certificate
// checked at `Rat` and at `CReal` through the class laws. Tests, not
// library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
//
// This module does not import `ring`, on purpose: the reading confirms
// numerals and the certificate checks its identity through `ring`'s lemmas,
// which must resolve in a client that imports only `linarith` (once, every
// numeral here silently became an atom).
import logic; import nat; import int; import omega; import linarith;
import relation_props; import order; import list; import algebra_rel; import ring; import semiring; import ordered_field; import rat; import creal;

// The rearrangements issues/linarith-ordered-fields.md names.
theorem rat_trans(a, b, c: Rat, h1: a <= b, h2: b < c): a < c { linarith(h1, h2) }
theorem rat_shift(a, q, e, f, r: Rat, h: a <= q + (e + r), ef: e <= f): a <= (q + r) + f { linarith(h, ef) }
theorem creal_shift(a, q, e, f, r: CReal, h: a <= q + (e + r), ef: e <= f): a <= (q + r) + f { linarith(h, ef) }
theorem rat_sub_rearrange(b, u, c: Rat): (b + u) - c ≈ (b - c) + u { linarith }
theorem creal_sub_rearrange(b, u, c: CReal): (b + u) - c ≈ (b - c) + u { linarith }

// Coefficients and constants: the combination is found over the rationals
// and written with positive integer multipliers.
theorem rat_scaled(x, y: Rat, h1: 2 * x + y <= 3, h2: x - y <= 0): 3 * x <= 3 { linarith(h1, h2) }
theorem creal_scaled(x, y: CReal, h1: 2 * x + y < 3, h2: x - y <= 0): x < 1 { linarith(h1, h2) }
theorem rat_constant(x: Rat): x < x + 1 { linarith }
theorem creal_constant(x: CReal, h: x <= 0): x < 2 { linarith(h) }

// Equations are used either way round.
theorem rat_same_hyp(x, y, z: Rat, h: x ≈ y + z, hz: 0 < z): y < x { linarith(h, hz) }
theorem creal_same_goal(x, y: CReal, h1: x <= y, h2: y <= x): x ≈ y { linarith(h1, h2) }

// Products and other non-linear terms are atoms.
theorem rat_product_atom(x, y, z: Rat, h: x * y <= z, hz: z < 1): y * x < 1 { linarith(h, hz) }
theorem creal_reciprocal_atom(x, y: CReal, hx: x.Apart(0), h: x⁻¹ <= y): x⁻¹ - y <= 0 { linarith(h) }

// An atom with no source spelling, a real's term, is named by an alias.
theorem rat_term_atoms(x: CReal, m, n: Nat, h: x.at(m) <= x.at(n) + 1, hn: x.at(n) < 0): x.at(m) < 1 { linarith(h, hn) }

// Facts come from the context when the written ones do not suffice.
theorem rat_from_context(a, b, c: Rat, h1: a < b, h2: b < c): a < c { linarith }
theorem creal_let_fact(a, b: CReal, h: a < b): a <= b + 1 {
    let wider: (b <= b + 1) = linarith;
    linarith(h, wider)
}

// `¬(a < b)` both as a fact and as a goal, `≤`'s own meaning.
theorem rat_not_lt_goal(a, b: Rat, h: b <= a): ¬(a < b) { linarith(h) }
theorem creal_not_lt_fact(a, b, c: CReal, h: ¬(b < a), hc: b < c): a < c { linarith(h, hc) }

// A reciprocal whose denominator a fact shows positive is cleared: the row
// is offered multiplied by the denominator, `r·d` read as 1, and `ring`
// checks the identity with the reciprocal's fact
// (issues/linarith-positive-denominators.md).
theorem rat_den_goal(a, b, d: Rat, hd: 0 < d, h: a <= b * d): a * d⁻¹ <= b { linarith(hd, h) }
theorem rat_den_fact(a, b, d: Rat, hd: 0 < d, h: a * d⁻¹ <= b): a <= b * d { linarith(hd, h) }
theorem creal_den_fact(a, b, d: CReal, hd: 0 < d, h: a * d⁻¹ < b): a < b * d { linarith(hd, h) }
theorem creal_den_context(a, b, d: CReal, hd: 0 < d, h: a <= b * d): a * d⁻¹ <= b { linarith }
theorem rat_den_same(a, b, d: Rat, hd: 0 < d, h: a ≈ b * d): a * d⁻¹ ≈ b { linarith(hd, h) }
theorem rat_two_dens(a, b, d, e: Rat, hd: 0 < d, he: 0 < e, h: a * d⁻¹ <= b * e⁻¹): a * e <= b * d { linarith(hd, he, h) }
theorem rat_den_sum(a, b, d: Rat, hd: 0 < d + 1, h: a * (d + 1)⁻¹ <= b): a <= b * d + b { linarith(hd, h) }
// A quotient is a product with the divisor's reciprocal, and a numeral
// divisor is positive by its sign rule, so `a / 2` is cleared with no fact
// about it (docs/library/division-design.md).
theorem rat_half_below(a: Rat, h: 0 < a): a / 2 < a { linarith }
theorem rat_midpoint(a, b: Rat, h: a < b): a < (a + b) / 2 ∧ (a + b) / 2 < b { And(linarith, linarith) }
theorem rat_third(a: Rat, h: a <= 6): a / 3 < 3 { linarith }
theorem rat_div_neutral(a, b: Rat, hb: 0 < b, h: a < 1): a / b < 1 / b { linarith }
theorem creal_half_below(a: CReal, h: 0 < a): a / 2 < a { linarith }
// A power at a literal exponent is a square `nlinarith` sees.
theorem rat_power_square_pos(b: Rat): 0 < b ^ 2 + 1 { nlinarith }
theorem rat_power_am_gm(a, b: Rat): 2 * a * b <= a ^ 2 + b ^ 2 { nlinarith(Rat::sq_nonneg(a - b)) }
theorem rat_den_absurd(a, d: Rat, hd: 0 < d, h1: 1 < a * d⁻¹, h2: a <= d): False { linarith(hd, h1, h2) }
// A positive reciprocal has a positive denominator; `Rat::inv_succ(n)` is
// positive by construction (`Rat::inv_succ_pos`), with no fact written.
theorem rat_recip_pos(a, b, d: Rat, hx: d.Apart(0), hd: 0 < d⁻¹, h: a * d⁻¹ < b * d⁻¹): a < b { linarith(hd, h) }
theorem rat_inv_succ(n: Nat, a, b: Rat, h: a <= b * (Rat::ofInt(OfNat(n)) + 1)): a * Rat::inv_succ(n) <= b { linarith(h) }

// Contradictory facts prove anything.
theorem rat_absurd(x: Rat, h1: x < 0, h2: 0 < x): False { linarith(h1, h2) }
theorem creal_absurd_goal(x, y: CReal, h1: x < y, h2: y < x): x * x ≈ y { linarith(h1, h2) }

// A goal that does not follow is refused with the facts it tried.
// expect-error: `linarith` could not prove
theorem rat_not_entailed(x, y: Rat, h: x <= y): x < y { linarith(h) }
// A product is an atom to `linarith`, and its refusal names `nlinarith`.
// expect-error: `nlinarith` also multiplies the facts
theorem creal_product_is_not_linear(x: CReal, h: 0 <= x): 0 <= x * x { linarith(h) }
// A denominator of unknown sign, or a negative one, is not cleared.
// expect-error: `linarith` could not prove
theorem rat_den_sign_unknown(a, b, d: Rat, hd: d.Apart(0), h: a <= b * d): a * d⁻¹ <= b { linarith(h) }
// expect-error: `linarith` could not prove
theorem rat_den_negative(a, b, d: Rat, hd: d < 0, h: a <= b * d): a * d⁻¹ <= b { linarith(hd, h) }
// A fact that is not an order at the goal's carrier is named.
// expect-error: combines `<`, `<=`, `≈` and `¬(x < y)` facts at `Rat`
theorem rat_wrong_fact(x: Rat, n: Nat, h: n < 3): x <= x { linarith(h) }

// At `Int` and `Nat` `omega` decides, with `ring`'s monomials as its atoms
// (docs/tactics/linarith-design.md §8): a side that multiplies is stated equal to
// its normal form, so `b * a`, `a * b` and the `a * b` inside `(a + 1) * b`
// are one atom, and the integers' rounding comes with `omega`.
theorem int_commuted(a, b, c: Int, h: a * b <= c): b * a + b <= c + b { linarith(h) }
theorem int_distributed(a, b, c: Int, h: (a + OfNat(1)) * b < c): a * b + b < c { linarith(h) }
theorem int_rounding(x, y: Int, h: OfNat(2) * (x * y) <= OfNat(1), hp: OfNat(0) < y * x): False { linarith(h, hp) }
theorem int_identity(a, b: Int): (a + b) * (a + b) - (a - b) * (a - b) = OfNat(4) * (a * b) { linarith }
theorem int_from_context(a, b, c: Int, h: a * b <= c): b * a <= c { linarith }
theorem int_negated(a, b: Int, h: ¬(b * a < a * b + OfNat(1))): False { linarith(h) }
// A numeral factor is `omega`'s own scaling; a product that cancels is still
// one `omega` would read as an atom.
theorem int_numeral_factor(x: Int, h: x <= OfNat(1)): OfNat(2) * (OfNat(3) * x) <= OfNat(6) { linarith(h) }
theorem int_cancelled(x, y, z: Int, h: z <= OfNat(0)): x * (y - y) + z <= OfNat(0) { linarith(h) }
theorem nat_distributed(a, b, c: Nat, h: (a + 1) * b <= c): b * a + b <= c { linarith(h) }
theorem nat_succ(n, m, k: Nat, h: Succ(n) * m < k): n * m + m < k { linarith(h) }
// In checking position inside a block, and at an open atom (a function's
// value).
theorem int_let(f: Int → Int, x, y: Int, h: f(x) * f(y) <= y): f(y) * f(x) <= y {
    let g: (f(y) * f(x) <= y) = linarith(h);
    g
}
// A written equation that defines an atom (`t = e`, `t` not in `e`) is
// substituted, and `ring` proves the side from it: the multiplier is the
// rest of the monomial.
theorem int_defined(s, d, p, e, t: Int, h: d = p * e, k: s * d <= t): s * p * e <= t { linarith(h, k) }
theorem nat_defined(s, d, p, t: Nat, h: d = p + 1, k: s * d <= t): s * p + s <= t { linarith(h, k) }
// A rational order unfolds to one at `Int`: when the field reading cannot
// prove it, the cross-multiplication is read with products as monomials.
theorem rat_mul_mono({x, y, z: Rat}, h: x <= y, hz: z <= 0): y * z <= x * z {
    let flipped = Rat::mul_le_mono_r(x := x, y := y, z := -z, h := h, hz := omega(hz, Int::zero_mul(z.den.int())));
    linarith(flipped)
}

// Refusals at `Int`: a goal that does not follow, a square's sign (no
// products of facts), and a fact at another carrier.
// expect-error: `linarith` could not prove
theorem int_not_entailed(a, b, c: Int, h: a * b <= c): a * b < c { linarith(h) }
// expect-error: `linarith` could not prove
theorem int_square_is_not_linear(x: Int): OfNat(0) <= x * x { linarith }
// expect-error: combines `<`, `<=` and `=` facts there
theorem int_wrong_fact(x: Int, h: True): x * x <= x * x { linarith(h) }
// expect-error: `linarith` could not prove
theorem nat_not_entailed(a, b: Nat, h: a * b <= 3): b * a < 3 { linarith(h) }

// ---------------------------------------------------------------------------
// `nlinarith` (docs/tactics/nonlinear-arithmetic-design.md): the facts multiplied
// pairwise, the goal's negation among them where a refutation proves the
// goal, and the squares the terms show.

// Squares the goal writes, at both fields and at `Int`; a square's
// negation refuted.
theorem nlin_creal_sq(x: CReal): 0 <= x * x { nlinarith }
theorem nlin_rat_sq_diff(a, b: Rat): 0 <= (a - b) * (a - b) { nlinarith }
theorem nlin_int_sq(x: Int): OfNat(0) <= x * x { nlinarith }
theorem nlin_creal_not_neg(x: CReal): ¬(x * x < 0) { nlinarith }
// A monomial whose exponents are all even is a square.
theorem nlin_rat_even(x, y: Rat, h: x * x * (y * y) <= 0): x * x * (y * y) ≈ 0 { nlinarith(h) }
// Products of facts, written or from the context.
theorem nlin_rat_prod(a, b: Rat, ha: 0 <= a, hb: 0 <= b): 0 <= a * b { nlinarith(ha, hb) }
theorem nlin_rat_prod_context(a, b: Rat, ha: 0 <= a, hb: 0 <= b): 0 <= a * b { nlinarith }
theorem nlin_creal_prod_strict(a, b: CReal, ha: 0 < a, hb: 0 < b): 0 < a * b { nlinarith(ha, hb) }
theorem nlin_rat_mono(a, b, c: Rat, h: a <= b, hc: 0 <= c): a * c <= b * c { nlinarith(h, hc) }
theorem nlin_int_prod(a, b: Int, ha: OfNat(0) <= a, hb: OfNat(0) <= b): OfNat(0) <= a * b { nlinarith(ha, hb) }
theorem nlin_int_prod_strict(a, b: Int, ha: OfNat(0) < a, hb: OfNat(0) < b): OfNat(0) < a * b { nlinarith(ha, hb) }
theorem nlin_nat_cross(a, b, c, d: Nat, h1: a <= b, h2: c <= d): a * d + b * c <= a * c + b * d { nlinarith(h1, h2) }
// A hint is a fact: the square `nlinarith` does not try by itself.
theorem nlin_rat_amgm(a, b: Rat): 2 * (a * b) <= a * a + b * b { nlinarith(Rat::sq_nonneg(a - b)) }
theorem nlin_creal_amgm(a, b: CReal): 2 * (a * b) <= a * a + b * b { nlinarith(CReal::sq_nonneg(a - b)) }
// The goal's negation multiplied: cancelling a positive factor.
theorem nlin_rat_cancel(a, b, c: Rat, h: a * c <= b * c, hc: 0 < c): a <= b { nlinarith(h, hc) }
theorem nlin_creal_cancel(a, b, c: CReal, h: a * c <= b * c, hc: 0 < c): a <= b { nlinarith(h, hc) }
theorem nlin_int_cancel(a, b, c: Int, h: a * c <= b * c, hc: OfNat(0) < c): a <= b { nlinarith(h, hc) }
theorem nlin_nat_cancel(a, b, c: Nat, h: a * c <= b * c, hc: 0 < c): a <= b { nlinarith(h, hc) }
theorem nlin_int_sq_diff(a, b: Int): OfNat(0) <= (a - b) * (a - b) { nlinarith }
// In checking position inside a block.
theorem nlin_rat_let(a, b: Rat, ha: 0 <= a, hb: 0 <= b): 0 <= a * b + 1 {
    let p: (0 <= a * b) = nlinarith(ha, hb);
    linarith(p)
}
// A strict goal at `Rat`, whose order is decided.
theorem nlin_rat_cancel_lt(a, b, c: Rat, h: a * c < b * c, hc: 0 < c): a < b { nlinarith(h, hc) }

// A pattern-bound fact is typed by its predicate applied to the witness, a
// head β-redex, and is read through its contractum as `omega` reads one
// (issues/linarith-redex-typed-fact.md): at a field, at `Int`, and
// multiplied by `nlinarith`.
theorem lin_redex_typed_rat(dd: Rat, hdd: 0 < dd): ∃ k: Nat, Rat::inv_pow2(k) + Rat::inv_pow2(k) < dd + dd {
    match dd.archimedean_inv_pow2(hdd) {
        Exists(k, small) => Exists(k, linarith(small)),
    }
}
theorem lin_redex_typed_int(e: ∃ k: Int, 2 * k <= 6): ∃ k: Int, 4 * k <= 12 {
    match e {
        Exists(k, h) => Exists(k, linarith(h)),
    }
}
theorem nlin_redex_typed_int(e: ∃ k: Int, 3 <= k): ∃ k: Int, 9 <= k * k {
    match e {
        Exists(k, h) => Exists(k, nlinarith(h)),
    }
}

// Refusals: a goal that does not follow, and a strict goal at `CReal`,
// where a refutation proves only its double negation.
// expect-error: `nlinarith` could not prove
theorem nlin_rat_not_entailed(x: Rat, h: 0 <= x): x * x <= x { nlinarith(h) }
// expect-error: a refutation does not prove `<`
theorem nlin_creal_cancel_lt(a, b, c: CReal, h: a * c < b * c, hc: 0 < c): a < b { nlinarith(h, hc) }
// A checking form met where nothing is expected
// (issues/checking-tactic-in-inference-position-diagnostic.md).
// expect-error: `linarith` needs an expected type
theorem let_linarith_unannotated(x: Rat, h: x < 1): x < 2 { let k = linarith(h); k }

// At a class carrier (issue cast-reading-at-class-carrier): the facts and
// the goal are the section's own relations, and the certificate is spelled
// in its operations (docs/language/casting-design.md §16).
section<K: OrderedField(≈, <, <=, +, *)> {
theorem class_trans(x, y, z: K, h: x <= y, k: y < z): x < z { linarith }
theorem class_halve(x, y: K, h: x + x <= y + y): x <= y { linarith }
theorem class_not_lt(x, y: K, h: x < y): ¬(y < x) { linarith }
theorem class_unit(x: K, h: K.unit < x): K.unit < x + x { linarith }
theorem class_antisymm(x, y: K, h: x <= y, k: y <= x): x ≈ y { linarith }
theorem class_product(x, y: K, h: K.unit <= x, k: K.unit <= y): K.unit <= x * y { nlinarith }
// expect-error: `linarith` could not prove
theorem class_not_entailed(x, y: K, h: x <= y): x < y { linarith }
// A predicate defined in a parent class's section reads `K.inv` off the
// parent's dictionary, a record built from `K`'s fields: it is still the
// negation (issues/ring-atom-mentions-class-constant.md).
theorem class_parent_predicate(z, e: K, h: AbsLe(z, e)): K.unit <= e { linarith(h.left, h.right) }
theorem class_parent_close(x, y, e: K, h: Close(x, y, e)): y < x + e { linarith(h.left) }
// expect-error: `linarith` could not prove
theorem class_parent_not_entailed(z, e: K, h: AbsLe(z, e)): K.unit < e { linarith(h.left, h.right) }
// A refusal spells the goal as written, not the section's placeholders
// (issues/class-carrier-diagnostics-spell-placeholders.md).
// expect-error: `linarith` could not prove `K.unit <= d * d + K.unit`
theorem class_refusal_spelled(d: K): K.unit <= d * d + K.unit { linarith }
}

// Conjunctions (docs/tactics/linarith-design.md §9): a fact that is one, or a
// definition that unfolds to one, gives each side as a row, written or in
// context; a goal that is one is proved side by side.
theorem conj_written(x, y: Rat, h: 0 <= x ∧ x <= y): 0 <= y { linarith(h) }
theorem conj_context(x, y: CReal, h: 0 <= x ∧ x <= y): 0 <= y { linarith }
theorem conj_nested(x, y, z: Rat, h: (x <= y ∧ y <= z) ∧ z <= 1): x <= 1 { linarith(h) }
theorem conj_contradictory(x: Rat, h: 1 <= x ∧ x <= 0): False { linarith(h) }
theorem conj_goal(x: Rat, h: 0 < x): 0 < x + x ∧ x <= x + x { linarith(h) }
// A side that is no relation at the carrier is passed over.
theorem conj_mixed(x: Rat, n: Nat, h: n = 2 ∧ x <= 1): x < 2 { linarith(h) }
// At `Int` and `Nat`, each side is a fact `omega` is given.
theorem conj_nat(n, m: Nat, h: n <= m ∧ m <= 3): n <= 3 { linarith(h) }
// expect-error: `linarith` combines
theorem conj_unread(x: Rat, n: Nat, h: n = 2 ∧ n = 3): x < 2 { linarith(h) }
section<K: OrderedField(≈, <, <=, +, *)> {
theorem conj_abs_le(z, e: K, h: AbsLe(z, e)): K.unit <= e { linarith(h) }
theorem conj_abs_le_context(z, e: K, h: AbsLe(z, e)): K.unit <= e { linarith }
theorem conj_close(x, y, e: K, h: Close(x, y, e)): y < x + e { linarith(h) }
theorem conj_abs_le_goal(z, e, d: K, h: AbsLe(z, e), hd: K.unit <= d): AbsLe(z, e + d) { linarith }
theorem conj_abs_lt_goal(z, e: K, h: AbsLe(z, e)): AbsLt(z + z, e + e + e + K.multiplicative.unit) { linarith(h) }
// The side that fails is named, as a side of the goal as written.
// expect-error: `linarith` could not prove the left side `K.inv(e + z) <= z` of `AbsLe(z, e + z)`
theorem conj_abs_le_goal_not_entailed(z, e: K, h: AbsLe(z, e)): AbsLe(z, e + z) { linarith(h) }
}

// Probes of `bv_omega` (`lib/std/tactic/bitvec_omega.hthr`,
// `docs/tactics/bv-omega-design.md`) and of the `decreases` discharge that falls
// back to it over a word measure (issues/decreases-word-measures-by-hand.md).
// Tests, not library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import int; import omega; import bitvec; import bitvec_nat; import bitvec_omega; import bitvec_shift_nat; import bitvec_div; import list; import loop;

// ---- The test, read from the context as it is written ----

// The Boolean test a `match h:` states, without binding
// `bitvec_omega::unsigned_true` by hand.
theorem lt_bit_true(i: BitVec(64), h: i.unsigned_lt_bit(BitVec::ofNat(64)) = True):
    BitVec::sub(BitVec::ofNat(64), i + 1).toNat() < BitVec::sub(BitVec::ofNat(64), i).toNat() { bv_omega }
// Its other arm: the test failed, so `i` is at least 64.
theorem lt_bit_false(i: BitVec(64), h: i.unsigned_lt_bit(BitVec::ofNat(64)) = False): 64 <= i.toNat() { bv_omega }
// The `<=` bit and the equality bit.
theorem le_bit_true(i: BitVec(64), h: i.unsigned_le_bit(BitVec::ofNat(63)) = True): i.toNat() < 64 { bv_omega }
theorem le_bit_false(i: BitVec(64), h: i.unsigned_le_bit(BitVec::ofNat(63)) = False): 63 < i.toNat() { bv_omega }
theorem eq_bit_true(i: BitVec(64), h: i.eq_bit(BitVec::ofNat(7)) = True): i.toNat() = 7 { bv_omega }
theorem eq_bit_false(i: BitVec(64), h: i.eq_bit(BitVec::ofNat(7)) = False, k: i.toNat() <= 7): i.toNat() < 7 { bv_omega }

// The propositions `<` and `<=` at a word, the literal's `toNat` evaluated.
theorem lt_prop(i: BitVec(64), h: i < 64):
    BitVec::sub(BitVec::ofNat(64), i + 1).toNat() < BitVec::sub(BitVec::ofNat(64), i).toNat() { bv_omega }
theorem le_prop(i: BitVec(64), h: i <= 63): i.toNat() + 1 <= 64 { bv_omega }
// Two words, neither a literal.
theorem lt_prop_words(i, j: BitVec(64), h: i < j): (j - (i + 1)).toNat() < (j - i).toNat() { bv_omega }
// A literal at an open width: its fit `0 < 2^w` is over no atom but is no
// comparison of literals, so `omega` proves it, from a leaf's range.
theorem lt_prop_open_zero(w: Nat, n: BitVec(w), h: 0 < n): 1 <= n.toNat() { bv_omega }
// In a checking position.
theorem lt_prop_checking(i: BitVec(64), h: i < 64): i.toNat() < 64 {
    let below: (i.toNat() < 64) = bv_omega;
    below
}
// A literal's `toNat` inside a Nat fact.
theorem literal_in_fact(i: BitVec(8), h: i.toNat() < BitVec::ofNat(200, n := 8).toNat()): i.toNat() < 200 { bv_omega }

// Negative control: the test says nothing about the upper end, so the
// difference may wrap.
// expect-error: may borrow
theorem lt_bit_wrong_way(i: BitVec(64), h: i.unsigned_lt_bit(BitVec::ofNat(64)) = False):
    BitVec::sub(BitVec::ofNat(64), i + 1).toNat() < BitVec::sub(BitVec::ofNat(64), i).toNat() { bv_omega }

// ---- Word arithmetic in the facts, used by the side conditions ----

// `1 < n - i` is a fact about `toNat(n - i)`, which the side condition
// `i + 2 <= n` (that `n - (i + 2)` does not borrow) needs beside `n - i`'s
// own fact: side conditions are proved in stages, a hypothesis word's fact
// before the side conditions that read it (docs/tactics/bv-omega-design.md §2).
theorem hyp_word_cmp(n, i: BitVec(64), a: i < n, b: 1 < n - i): (n - (i + 2)).toNat() < (n - i).toNat() { bv_omega }
// The same fact over Nat values.
theorem hyp_word_nat(n, i: BitVec(64), a: i < n, b: 1 < (n - i).toNat()): (n - (i + 2)).toNat() < (n - i).toNat() { bv_omega }
// The facts the other way round: `n - i`'s no-borrow needs `a`, after `b`.
theorem hyp_word_order(n, i: BitVec(64), b: 1 < n - i, a: i < n): (n - (i + 2)).toNat() < (n - i).toNat() { bv_omega }
// The Boolean tests nested guards put in scope.
theorem hyp_word_bits(n, i: BitVec(64), a: i.unsigned_lt_bit(n) = True, b: BitVec::ofNat(1).unsigned_lt_bit(n - i) = True):
    (n - (i + 2)).toNat() < (n - i).toNat() { bv_omega }
// A chain: the second word's no-borrow needs the first word's fact.
theorem hyp_word_chain(n, i: BitVec(64), a: i < n, b: 2 < n - i, c: 0 < (n - i) - 2): (n - (i + 3)).toNat() < (n - i).toNat() { bv_omega }
// In a checking position.
theorem hyp_word_checking(n, i: BitVec(64), a: i < n, b: 1 < n - i): (n - i).toNat() - 2 = (n - (i + 2)).toNat() {
    let step: ((n - (i + 2)).toNat() + 2 = (n - i).toNat()) = bv_omega;
    omega
}
// At an open width, the step a word too (a literal step at an open width
// may not fit it, which no fact here rules out).
theorem hyp_word_open(w: Nat, n, i, k: BitVec(w), a: i < n, b: k < n - i): (n - (i + k)).toNat() <= (n - i).toNat() { bv_omega }

// Negative control: `0 < n - i` leaves room for one step, not two.
// expect-error: may borrow
theorem hyp_word_one_short(n, i: BitVec(64), a: i < n, b: 0 < n - i): (n - (i + 2)).toNat() < (n - i).toNat() { bv_omega }

// A loop stepping by two under two nested guards: its decrease is found
// from both tests.
fn pairs_left(n, i: BitVec(64)) → Nat decreases (n - i).toNat() {
    if h: i < n {
        if g: 1 < n - i { 1 + pairs_left(n, i + 2) } else { 0 }
    } else { 0 }
}
theorem pairs_left_lit(): pairs_left(10, 3) = 3 { refl }

// Negative control: the inner guard does not leave room for two steps.
// expect-error: must decrease the measure
fn pairs_left_wrong(n, i: BitVec(64)) → Nat decreases (n - i).toNat() {
    if h: i < n {
        if g: 0 < n - i { 1 + pairs_left_wrong(n, i + 2) } else { 0 }
    } else { 0 }
}

// ---- A plain equation of words in scope ----

// `same: fill = 63` gives `fill.toNat() = 63`, either way round.
theorem word_eq_hyp(fill: BitVec(64), same: fill = 63): fill.toNat() + 1 = 64 { bv_omega }
theorem word_eq_hyp_flipped(fill: BitVec(64), same: 63 = fill): fill.toNat() + 1 = 64 { bv_omega }
// Refuting a branch: the value says the word cannot be 63.
theorem word_eq_hyp_refutes(fill: BitVec(64), k, len: Nat, at: fill.toNat() = len, short: len + (k + 1) = 63, same: fill = 63): logic::False { bv_omega }
// Two words, one composite.
theorem word_eq_hyp_words(i, j: BitVec(64), h: j = i + 1, b: i < 8): j.toNat() = i.toNat() + 1 { bv_omega }

// Negative control: the equation is about another word.
// expect-error: got stuck
theorem word_eq_hyp_other(fill, other: BitVec(64), same: other = 63): fill.toNat() + 1 = 64 { bv_omega }

// ---- Word comparisons as goals ----

// `<` and `<=` at a word, and the `<=` bit, as the Nat order over values.
theorem goal_le_prop(i: BitVec(64), h: i < 8): i + 1 <= 8 { bv_omega }
theorem goal_lt_prop(n, i: BitVec(64), a: i < n, b: 1 < n - i): i + 1 < n { bv_omega }
theorem goal_le_bit_true(i: BitVec(64), h: i < 8): (i + 1).unsigned_le_bit(8) = True { bv_omega }
theorem goal_le_bit_false(i: BitVec(64), h: 8 < i): i.unsigned_le_bit(8) = False { bv_omega }
// At an open width, in a checking position.
theorem goal_le_open(w: Nat, i, n: BitVec(w), h: i < n): i + 1 <= n {
    let r: (i + 1 <= n) = bv_omega;
    r
}

// Negative control: `i` may be eight.
// expect-error: got stuck
theorem goal_le_wrong(i: BitVec(64), h: i <= 8): i + 1 <= 8 { bv_omega }

// ---- An `if h:` test named only by a discharge ----

// The branches never mention `h`; the `on ?dec1` that proves the recursive
// call's decrease does, so the branch binds it.
fn count_down_on(n, acc: BitVec(64)) → BitVec(64) decreases n.toNat() {
    if h: n.eq_bit(BitVec::ofNat(0)) = False { count_down_on(n.sub(BitVec::ofNat(1)), acc.add(n)) } else { acc }
    on ?dec1 := bitvec_nat::toNat_sub_one_lt(n, h);
}
theorem count_down_on_lit(): count_down_on(3, 0) = 6 { refl }

// ---- A variable named `t` (issues/bv-omega-binder-captures-t.md) ----

theorem named_t(t: BitVec(64), h: t.unsigned_lt_bit(64) = True): BitVec::sub(BitVec::ofNat(64), t + 1).toNat() < BitVec::sub(BitVec::ofNat(64), t).toNat() { bv_omega }

// ---- Loops over a word, their decrease discharged automatically ----

// The `match h:` form, the measure the word's distance to the bound.
fn count_up(i: BitVec(64)) → Nat decreases (64 - i).toNat() {
    match h: i.unsigned_lt_bit(64) {
        False => 0,
        True => 1 + count_up(i + 1),
    }
}
theorem count_up_lit(): count_up(60) = 4 { refl }
theorem count_up_done(): count_up(64) = 0 { refl }

// The test as the proposition `i < 64`.
fn count_up_if(i: BitVec(64)) → Nat decreases (64 - i).toNat() {
    if h: i < 64 { 1 + count_up_if(i + 1) } else { 0 }
}
theorem count_up_if_lit(): count_up_if(61) = 3 { refl }

// The counter named `t`.
fn count_up_t(t: BitVec(64)) → Nat decreases (64 - t).toNat() {
    match h: t.unsigned_lt_bit(64) {
        False => 0,
        True => 1 + count_up_t(t + 1),
    }
}
theorem count_up_t_lit(): count_up_t(62) = 2 { refl }

// A `while` over a word: nowhere to write the proof, so it is automatic or
// nothing.
fn sum_below(k: BitVec(64)) → BitVec(64) {
    let mut i: BitVec(64) = k;
    let mut acc: BitVec(64) = 0;
    while i < 64 decreases (64 - i).toNat() {
        acc := acc + i;
        i := i + 1
    }
    acc
}
theorem sum_below_lit(): sum_below(60) = 246 { refl }
theorem sum_below_done(): sum_below(64) = 0 { refl }

// Negative control: the measure does not fall when the counter counts up
// past the bound the test does not check.
// expect-error: must decrease the measure
fn count_up_wrong(i: BitVec(64)) → Nat decreases (64 - i).toNat() {
    match h: i.unsigned_lt_bit(64) {
        False => 1 + count_up_wrong(i + 1),
        True => 0,
    }
}

// ---- A lambda binder in an atom ----

// omega spells an atom containing a lambda as source, and a binder at a type
// with a value argument is spelled whole (`BitVec(8)`, not the `BitVec` that
// does not elaborate), whether or not the fact holding it is listed
// (issues/omega-atom-lambda-binder-type-spelled-bare.md).
theorem respell_binder(xs: List<BitVec(8)>, k, t: Nat, byte: BitVec(8),
    short: t < xs.update(k, λ (_: BitVec(8)) => byte).len(), whole: xs.len() = 16, before: t < xs.len()): t < 16 {
    omega(before, whole)
}
// The atom is the fact omega reads, at a neutral width.
theorem binder_neutral_width(n: Nat, xs: List<BitVec(n)>, k, t: Nat, byte: BitVec(n),
    short: t < xs.update(k, λ (_: BitVec(n)) => byte).len()): t < xs.update(k, λ (_: BitVec(n)) => byte).len() + 1 {
    omega
}
// A family with a type argument and a value argument, the type argument open.
record Tagged<A>(n: Nat) { items: [A; n] }
theorem binder_type_and_value<A>(xs: List<Tagged<A>(3)>, k, t: Nat, v: Tagged<A>(3),
    short: t < xs.update(k, λ (_: Tagged<A>(3)) => v).len()): t < xs.update(k, λ (_: Tagged<A>(3)) => v).len() + 1 {
    omega
}
// In a checking position.
theorem binder_checking(xs: List<BitVec(8)>, k, t: Nat, byte: BitVec(8),
    short: t < xs.update(k, λ (_: BitVec(8)) => byte).len()): t < xs.update(k, λ (_: BitVec(8)) => byte).len() + 2 {
    let h: (t < xs.update(k, λ (_: BitVec(8)) => byte).len() + 2) = omega;
    h
}
// Negative control: a value argument no field mentions cannot be read back
// off the type, so the spelling declines rather than write the bare name.
record Phantom(n: Nat) { tag: Nat }
// expect-error: could not spell
theorem binder_phantom_declines(xs: List<Phantom(3)>, k, t: Nat, v: Phantom(3),
    short: t < xs.update(k, λ (_: Phantom(3)) => v).len()): t < xs.update(k, λ (_: Phantom(3)) => v).len() + 1 {
    omega
}

// ---- A bound stated of a sum is not the sum's own bound ----

// `g` bounds `toNat(j + 16)`, which says nothing about whether `j + 16`
// wrapped, so the sum's fact cannot be read from it (reading it took the
// fact it was to give: issues/found-proof-differs-across-recursion-companions.md).
theorem stated_of_sum_is_no_bound(j: BitVec(64), b: j < 48, g: (j + 16).toNat() < 64): j.toNat() < 64 { bv_omega }

// ---- A proof left to a default, found from the test around the call ----

fn word_below(i: BitVec(64), inside: i.toNat() < 64 := bv_omega) → BitVec(64) { i }

// An operator whose operands are such calls: each has its type once the
// declaration has the goal slots its searches want
// (issues/operator-on-call-with-defaulted-argument.md).
fn two_below(j: BitVec(64), h: j < 48) → BitVec(64) { word_below(j + 14) + word_below(j) }

// Under `decreases` each found proof is a declaration of its own, so the
// body and the unfolding equation name one term.
fn climb(acc, j: BitVec(64)) → BitVec(64)
    decreases (48 - j).toNat() {
    if h: j < 48 { climb(acc + word_below(j + 16), j + 1) } else { acc }
}
theorem climb_unfolds(acc, j: BitVec(64)): True { let step = climb::unfold(acc, j); trivial }

// expect-error: `word_below`'s `inside` was left to its default, which did not give
fn climb_loose(j: BitVec(64)) → BitVec(64) { word_below(j + 16) }
// ---- A word under a mask is at most the mask (issues/bv-omega-masked-word-bound.md) ----

// The index into a ring of sixteen words.
theorem mask_ring_index(i: BitVec(64)): (i & 15).toNat() < 16 { bv_omega }
// The masked word itself taken apart: a message-schedule read `W[(t - 3) & 15]`.
theorem mask_of_difference(t: BitVec(64)): ((t - 3) & 15).toNat() < 16 { bv_omega }
// At an open width, the mask's numeral read past the width.
theorem mask_open_width(n: Nat, x: BitVec(n)): (x & BitVec::ofNat(15)).toNat() < 16 { bv_omega }
// A literal masked word.
theorem mask_literal(): (BitVec::ofNat(37, n := 64) & BitVec::ofNat(15)).toNat() < 16 { bv_omega }
// The mask a bare numeral beside it (issues/named-result-only-implicit-deferred.md).
theorem mask_literal_numeral(): (BitVec::ofNat(37, n := 64) & 15).toNat() < 16 { bv_omega }
// A mask that is not a numeral bounds by its own value.
theorem mask_by_word(x, m: BitVec(64)): (x & m).toNat() <= m.toNat() { bv_omega }
// Inside arithmetic: two masked words cannot overflow their sum.
theorem mask_sum(x, y: BitVec(64)): ((x & 15) + (y & 15)).toNat() < 31 { bv_omega }
// In a checking position.
theorem mask_checking(i: BitVec(64)): (i & 15).toNat() + 1 <= 16 {
    let below: ((i & 15).toNat() + 1 <= 16) = bv_omega;
    below
}
// The law, cited by name.
theorem mask_law(x: BitVec(64)): (x & 15).toNat() <= 15 { BitVec::toNat_band_ofNat_le(64, x, 15) }

// Negative control: sixteen is no mask of the low four bits, and `x & 16`
// may be sixteen.
// expect-error: got stuck
theorem mask_wrong(x: BitVec(64)): (x & 16).toNat() < 16 { bv_omega }

// ---- A search in a declaration's statement, beside a goal ----

// A search written in a statement fills a slot of the goal world as one in
// the body does, so it is counted with the body's `?`s; uncounted, it took
// the `?`'s slot and the goal was an internal error. Its discharge mentions
// the lifted proof through the statement
// (issues/goal-hole-beside-a-search-in-the-statement.md). `word_below` is
// the one above.
fn nat_below(n: Nat, inside: n < 64 := omega) → Nat { n }

// In the result type, discharged by name.
theorem search_in_result(j: BitVec(64), h: j < 48): word_below(j + 16, inside := bv_omega) = j + 16 {
    ?rest
    on ?rest := refl;
}
// In a parameter's type, discharged by statement.
theorem search_in_parameter(j: BitVec(64), h: j < 48, e: word_below(j + 16, inside := bv_omega) = j + 16):
    word_below(j + 16, inside := bv_omega) = j + 16 {
    ?rest
    on _: word_below(j + 16, inside := bv_omega) = j + 16 := e;
}
// Two searches in the statement, `omega`'s atom list among the lifted slots.
theorem searches_in_result(j: BitVec(64), n: Nat, h: j < 48, k: n < 10):
    word_below(j + 16, inside := bv_omega).toNat() + nat_below(n + 1, inside := omega) = (j + 16).toNat() + (n + 1) {
    ?rest
    on ?rest := refl;
}
// Inside a checking position in the body as well.
theorem search_in_result_and_body(j: BitVec(64), h: j < 48): word_below(j + 16, inside := bv_omega) = j + 16 {
    let below: ((j + 16).toNat() < 64) = bv_omega;
    ?rest
    on ?rest := refl;
}
// Negative control: left open, the goal is reported with its statement, the
// lifted proof spelled as the search that found it.
// expect-error: ?rest : word_below(j + ofNat(16), inside := bv_omega) = j + ofNat(16)
theorem search_goal_left_open(j: BitVec(64), h: j < 48): word_below(j + 16, inside := bv_omega) = j + 16 { ?rest }
// `omega`'s certificate is inline, not lifted, and has no spelling: `…`, not
// the kernel term, and the rest of the statement still spelled.
// expect-error: ?rest : toNat(word_below(j + ofNat(16), inside := bv_omega)) + nat_below(n + 1, inside := …) = toNat(j + ofNat(16)) + (n + 1)
theorem searches_left_open(j: BitVec(64), n: Nat, h: j < 48, k: n < 10):
    word_below(j + 16, inside := bv_omega).toNat() + nat_below(n + 1, inside := omega) = (j + 16).toNat() + (n + 1) { ?rest }
// A goal another goal's statement mentions is spelled by its name.
// expect-error: ?rest : word_below(j + ofNat(16), inside := ?p) = j + ofNat(16)
theorem goal_in_goal(j: BitVec(64), h: j < 48): word_below(j + 16, inside := ?p) = j + 16 { ?rest }

// ---- Every word's range, met in the goal or only in a fact (issues/bv-omega-hypothesis-word-bound.md) ----

// `m` appears only in the fact, and the fact's bound on `j` is what keeps
// `j + 1` from wrapping.
theorem next_below_fact_word(j, m: BitVec(64), inside: j.toNat() < m.toNat()): (j + 1).toNat() = j.toNat() + 1 { bv_omega }
// `omega` itself states the range of each word it meets, at a literal width.
theorem range_from_fact(j, m: BitVec(8), h: j.toNat() < m.toNat()): j.toNat() < 255 { omega }
theorem range_in_goal(x: BitVec(16)): x.toNat() <= 65535 { omega }
theorem range_checking(x: BitVec(8), k: Nat, h: k = x.toNat()): k < 300 {
    let r: (x.toNat() < 256) = omega;
    omega
}
// Control: the range's top is reached, so a bound one below it is refused.
// expect-error: `omega` got stuck
theorem range_not_below_top(x: BitVec(8)): x.toNat() < 255 { omega }
// A closed word is its value.
theorem closed_word(k: Nat): BitVec::ofNat(5, n := 64).toNat() + k = k + 5 { omega }

// A conjunction in scope is read side by side (`m.left`, `m.right`), and a
// side restated over a word the walk takes apart is rebound under a fresh
// name: a projection path is no binder (it once wrote `(m.left: …) →`).
theorem conjunct_fact_restated(lo, hi: BitVec(64), h: lo.toNat() < hi.toNat(), gap: (hi - lo).toNat() + lo.toNat() = hi.toNat(),
    m: And<(lo + ((hi - lo) >> 1)).toNat() = lo.toNat() + ((hi - lo) >> 1).toNat(), (lo + ((hi - lo) >> 1)).toNat() < hi.toNat()>):
    (hi - ((lo + ((hi - lo) >> 1)) + 1)).toNat() < (hi - lo).toNat() { bv_omega }

// ---- A word widened by zeros has the narrower word's value ----

// A byte read as a `u64` and compared, as a program spells its tests.
theorem widened_byte(c: u8, t: c.toNat() < 0x80): c.zero_extend(56) < 0x80 { bv_omega }
theorem widened_byte_range(c: u8): c.zero_extend(56) < 256 { bv_omega }
// The test decided by its Boolean, on a byte equal to the one read.
theorem widened_decided(c, b: u8, read: c = b, t: decide_bit<b.zero_extend(56) < 0x80>() = False): ¬(c.zero_extend(56) < 0x80) { bv_omega }
// An open width.
theorem widened_open(n: Nat, x, y: BitVec(n), h: x.toNat() < y.toNat()): x.zero_extend(8) < y.zero_extend(8) { bv_omega }
// In a checking position: a step of a longer proof.
theorem widened_step(c: u8, t: c.toNat() < 0x80): c.zero_extend(56).toNat() < 200 {
    let w: (c.zero_extend(56) < 0x80) = bv_omega;
    bv_omega
}
// Control: a byte reaches 255, so a bound one below it is refused.
// expect-error: `omega` got stuck
theorem widened_not_below_top(c: u8): c.zero_extend(56) < 255 { bv_omega }

// ---- A shift right by a numeral is a quotient ----

// `x >> k` is `x.toNat()` divided by `2^k`, read as its two bounds: the
// midpoint `lo + ((hi - lo) >> 1)` stays in `[lo, hi)`, and the range left on
// either side shrinks.
theorem shr_midpoint_from(lo, hi: BitVec(64), h: lo < hi): lo <= lo + ((hi - lo) >> 1) { bv_omega }
theorem shr_midpoint_below(lo, hi: BitVec(64), h: lo < hi): lo + ((hi - lo) >> 1) < hi { bv_omega }
theorem shr_right_smaller(lo, hi: BitVec(64), h: lo < hi): (hi - ((lo + ((hi - lo) >> 1)) + 1)).toNat() < (hi - lo).toNat() { bv_omega }
// A count past one, and an open width.
theorem shr_quarter(w: Nat, x: BitVec(w)): (x >> 2).toNat() + (x >> 2).toNat() + (x >> 2).toNat() + (x >> 2).toNat() <= x.toNat() { bv_omega }

// So a halving search terminates with no `on` clause.
fn halving_steps(lo, hi: BitVec(64)) → Nat decreases (hi - lo).toNat() {
    if h: lo < hi { 1 + halving_steps(lo, lo + ((hi - lo) >> 1)) } else { 0 }
}
theorem halving_steps_lit(): halving_steps(0, 8) = 4 { refl }

// Negative control: at zero the half is not smaller.
// expect-error: got stuck
theorem shr_smaller_wrong(x: BitVec(64)): x >> 1 < x { bv_omega }

// ---- A remainder and a quotient are known by their laws ----

// `x % d` and `x / d` are atoms with facts beside them (`bitvec_div`'s
// `toNat_urem_*`, `toNat_udiv_*`): a hash table's slot `hash % 8` is below
// the capacity with nothing in scope, the literal divisor read as its value.
theorem rem_lit(k: u64): (k % 8).toNat() < 8 { bv_omega }
theorem rem_lit_word(k: u64): k % 8 < 8 { bv_omega }
theorem rem_lit_next(k: u64): (k % 8 + 1).toNat() <= 8 { bv_omega }
theorem rem_lit_of_sum(a, b: u64): ((a + b) % 16).toNat() < 16 { bv_omega }
// The remainder is at most the dividend, whatever the divisor.
theorem rem_le(k, n: u64): k % n <= k { bv_omega }
// A divisor of run-time value, under the test that puts it on the path:
// `0 < n` or `n ≠ 0` as the proposition, or over its value.
theorem rem_by_pos(k, n: u64, h: 0 < n): k % n < n { bv_omega }
theorem rem_by_ne(k, n: u64, h: n ≠ 0): k % n < n { bv_omega }
theorem rem_by_pos_nat(k, n: u64, h: 0 < n.toNat()): (k % n).toNat() < n.toNat() { bv_omega }
fn rem_by_test(k, n: u64) → Bool { if h: 0 < n { let below: ((k % n).toNat() < n.toNat()) = bv_omega; True } else { False } }
// An open width.
theorem rem_open(w: Nat, k, n: BitVec(w), h: 0 < n): k % n < n { bv_omega }
// The quotient: at most the dividend away from a zero divisor, and over a
// literal divisor the two bounds of `x >> k`, with the link `x = q·c + r`
// when the remainder is here too.
theorem div_lit_le(k: u64): k / 8 <= k { bv_omega }
theorem div_by_pos_le(k, n: u64, h: 0 < n): k / n <= k { bv_omega }
theorem div_lit_scaled(k: u64): (k / 8).toNat() * 8 <= k.toNat() { bv_omega }
theorem div_lit_above(k: u64): k.toNat() < (k / 8).toNat() * 8 + 8 { bv_omega }
theorem div_rem_link(k: u64): (k / 8).toNat() * 8 + (k % 8).toNat() = k.toNat() { bv_omega }
theorem div_of_rem(k: u64): (k % 64) / 8 < 8 { bv_omega }

// Negative controls: by zero the remainder is the dividend and the
// quotient all ones, so neither bound holds with nothing known of `n`.
// expect-error: got stuck
theorem rem_by_unknown(k, n: u64): k % n < n { bv_omega }
// expect-error: got stuck
theorem div_by_unknown(k, n: u64): k / n <= k { bv_omega }
// The remainder can reach `c - 1`, and the quotient's product falls short.
// expect-error: got stuck
theorem rem_lit_too_tight(k: u64): (k % 8).toNat() < 7 { bv_omega }
// expect-error: got stuck
theorem div_lit_not_exact(k: u64): (k / 8).toNat() * 8 = k.toNat() { bv_omega }

// ---- `omega` reads a word's comparison bit as the comparison ----
// (issues/omega-if-bit-word-comparison.md). An `if x < y` branch that does
// not name its test keeps the bit's equation; `omega` reads it as the
// comparison of the `toNat`s, as it reads the proposition, not as an atom.

// Each bit, both ways, over two neutral words of an open width.
theorem omega_lt_bit_true(n: Nat, a, b: BitVec(n), h: a.unsigned_lt_bit(b) = True): a.toNat() + 1 <= b.toNat() { omega }
theorem omega_lt_bit_false(n: Nat, a, b: BitVec(n), h: a.unsigned_lt_bit(b) = False): b.toNat() <= a.toNat() { omega }
theorem omega_le_bit_true(n: Nat, a, b: BitVec(n), h: a.unsigned_le_bit(b) = True): a.toNat() <= b.toNat() { omega }
theorem omega_le_bit_false(n: Nat, a, b: BitVec(n), h: a.unsigned_le_bit(b) = False): b.toNat() < a.toNat() { omega }
theorem omega_eq_bit_true(n: Nat, a, b: BitVec(n), h: a.eq_bit(b) = True): a.toNat() = b.toNat() { omega }
theorem omega_eq_bit_false(n: Nat, a, b: BitVec(n), h: a.eq_bit(b) = False, k: a.toNat() <= b.toNat()): a.toNat() < b.toNat() { omega }
// Either orientation, and the `IsTrue` form.
theorem omega_lt_bit_flipped(n: Nat, a, b: BitVec(n), h: True = a.unsigned_lt_bit(b)): a.toNat() < b.toNat() { omega }
theorem omega_lt_bit_is_true(n: Nat, a, b: BitVec(n), h: a.unsigned_lt_bit(b).IsTrue()): a.toNat() < b.toNat() { omega }
// The proposition at a word as the goal, from the bit.
theorem omega_le_prop_goal(a, b: u8, h: a.unsigned_lt_bit(b) = False): BitVec::unsigned_le(b, a) { omega }
// A branch that names neither side: the sort example's shape, the facts
// relating the widened words to the bytes beside the test.
theorem omega_unnamed_branch(a, b: u8): BitVec::unsigned_le(a, b) ∨ BitVec::unsigned_le(b, a) {
    let one: (b.zero_extend(56).toNat() = b.toNat()) = BitVec::toNat_zero_extend(8, 56, b);
    let two: (a.zero_extend(56).toNat() = a.toNat()) = BitVec::toNat_zero_extend(8, 56, a);
    if larger: b.zero_extend(56) < a.zero_extend(56) {
        let ba: BitVec::unsigned_le(b, a) = omega;
        Inr(ba)
    } else {
        let ab: BitVec::unsigned_le(a, b) = omega;
        Inl(ab)
    }
}
// Control: the bit says `a < b`, not `b < a`.
// expect-error: `omega` got stuck
theorem omega_lt_bit_wrong_way(n: Nat, a, b: BitVec(n), h: a.unsigned_lt_bit(b) = True): b.toNat() < a.toNat() { omega }

// ---- A word whose side conditions fail is kept whole ----

// A `let`-bound midpoint is read through its `let`, and its addition's
// overflow is not visible through the shift; kept as an atom, the facts
// that mention it are enough (issues/bv-omega-let-alias-taken-apart.md).
theorem midpoint_kept_whole(lo, hi, n: u64, h: lo < hi, fits: hi <= n,
    end: (lo + ((hi - lo) >> 1)) < hi): (lo + ((hi - lo) >> 1)) < n {
    let mid = lo + ((hi - lo) >> 1);
    let real: (mid < n) = bv_omega;
    real
}
// The next word after it does not wrap: `mid + 1` is taken apart over `mid` as an atom.
theorem midpoint_next_le(lo, hi: u64, end: (lo + ((hi - lo) >> 1)) < hi): (lo + ((hi - lo) >> 1)) + 1 <= hi {
    let mid = lo + ((hi - lo) >> 1);
    bv_omega
}
theorem midpoint_le_of_lt_next(lo, hi, j: u64, end: (lo + ((hi - lo) >> 1)) < hi,
    before: j < (lo + ((hi - lo) >> 1)) + 1): j <= lo + ((hi - lo) >> 1) {
    let mid = lo + ((hi - lo) >> 1);
    let up: (j <= mid) = bv_omega;
    up
}
// An open width, with the bound as a Nat fact.
theorem kept_whole_open(n: Nat, a, b, c: BitVec(n), room: (a + (b >> 1)).toNat() < c.toNat()): (a + (b >> 1)) + 1 <= c { bv_omega }
// Control: nothing bounds the kept word, so its successor may wrap, and
// the refusal still names the first proof's side condition. Since the shift
// is read as a quotient, that is the gap `hi - lo` it divides, which may
// borrow when nothing orders `lo` and `hi`.
// expect-error: may borrow
theorem kept_whole_unbounded(lo, hi: u64): (lo + ((hi - lo) >> 1)).toNat() < ((lo + ((hi - lo) >> 1)) + 1).toNat() { bv_omega }

// ---- Goals read through a value built in place ----

// A step that hands on a record it built: its invariant is a defined
// proposition over a match on the constructor, and its fields are
// projections of the record, not calls. `bv_omega` unfolds the proposition
// and reads each field as the word the record was built with, in a goal of
// its own and as each conjunct of an anonymous pair
// (lib/_tests/std/core/loop_tests.hthr's `Range::search_keeps`).
record Span { lo: u64, hi: u64 }
inductive Step { Next(s: Span), Stop(r: u64) }
fn Step::Holds(self p: Step) → Type { match p { Next(s) => s.lo <= s.hi, Stop(r) => r <= 10 } }
fn Step::Both(self p: Step) → Type { match p { Next(s) => And<s.lo <= s.hi, s.hi <= 20>, Stop(r) => r <= 10 } }

theorem built_field(x: u64, h: x < 10): Step::Holds(Next(Span(lo := x + 1, hi := 10))) { bv_omega }
theorem built_field_pair(x: u64, h: x < 10): Step::Both(Next(Span(lo := x + 1, hi := 10))) { ⟨bv_omega, bv_omega⟩ }
// An open bound, from facts in scope.
theorem built_field_open(w, x: u64, h: x < w, k: w <= 20): Step::Both(Next(Span(lo := x + 1, hi := w))) { ⟨bv_omega, bv_omega⟩ }
// Control: `x + 2` may pass 10, so the field is refused.
// expect-error: got stuck
theorem built_field_past(x: u64, h: x < 10): Step::Holds(Next(Span(lo := x + 2, hi := 10))) { bv_omega }

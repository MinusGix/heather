// Probes of `by intervals()` at `CReal` (lib/std/tactic/interval_tactic.hthr):
// goals read into `RealExpr` trees, with `CReal::ofRat(q)` an exact leaf and
// any other real enclosed from its terms. Tests, not library: nothing outside
// lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import int; import rat; import creal; import dyadic; import interval; import creal_interval; import tactic; import interval_tactic;

fn third() → CReal { CReal::ofRat(Rat(1, 3)) }
fn step() → CReal { CReal::ofRat(Rat(1, 100)) }

theorem two_thirds(): third() + third() < CReal::ofRat(1) { by intervals() }
theorem ninth_lt_eighth(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals() }
theorem sub_lt(): third() - CReal::ofRat(Rat(1, 4)) < CReal::ofRat(Rat(1, 10)) { by intervals() }
theorem neg_mul_le(): -(third() * CReal::ofRat(2)) <= CReal::ofRat(Rat(-1, 2)) { by intervals() }
// Exact leaves only: the power is evaluated as at `Rat`.
theorem compound(): (CReal::ofRat(1) + CReal::ofRat(Rat(1, 100))).npow(100) < CReal::ofRat(3) { by intervals() }
// A real leaf under the power.
theorem leaf_compound(): (CReal::ofRat(1) + step()).npow(100) < CReal::ofRat(3) { by intervals() }
// A numeral is a real leaf: its terms are the numeral.
theorem below_one(): third() < 1 { by intervals() }
// The index refines: a ninth and an eighth are 1/72 apart, which index 7
// cannot separate and its fifth refinement can.
theorem refined(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals(p := 16, tries := 6, n := 7) }

// expect-error: intervals: the enclosures do not separate the two sides
theorem false_order(): CReal::ofRat(Rat(1, 2)) < third() { by intervals() }
// expect-error: intervals: the enclosures do not separate the two sides
theorem too_close(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals(p := 16, tries := 2, n := 7) }
// expect-error: intervals: the enclosures do not separate the two sides
theorem open_side(x: CReal): x < x + 1 { by intervals() }
// An equality is never decided by enclosures, even as `<=`.
// expect-error: intervals: the enclosures do not separate the two sides
theorem third_le_third(): third() <= third() { by intervals() }

// Probes of `by intervals()` at `CReal` (lib/std/tactic/interval_tactic.hthr):
// goals read into `RealExpr` trees, with `CReal::ofRat(q)` an exact leaf and
// any other real enclosed from its terms. Tests, not library: nothing outside
// lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import int; import rat; import creal; import dyadic; import interval; import creal_interval; import tactic; import interval_tactic;

fn third() → CReal { CReal::ofRat(Rat(1, 3)) }
fn step() → CReal { CReal::ofRat(Rat(1, 100)) }

theorem two_thirds(): third() + third() < CReal::ofRat(1) { by intervals() }
theorem ninth_lt_eighth(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals() }
theorem sub_lt(): third() - CReal::ofRat(Rat(1, 4)) < CReal::ofRat(Rat(1, 10)) { by intervals() }
theorem neg_mul_le(): -(third() * CReal::ofRat(2)) <= CReal::ofRat(Rat(-1, 2)) { by intervals() }
// Exact leaves only: the power is evaluated as at `Rat`.
theorem compound(): (CReal::ofRat(1) + CReal::ofRat(Rat(1, 100))).npow(100) < CReal::ofRat(3) { by intervals() }
// A real leaf under the power.
theorem leaf_compound(): (CReal::ofRat(1) + step()).npow(100) < CReal::ofRat(3) { by intervals() }
// A numeral is a real leaf: its terms are the numeral's floors, exact.
theorem below_one(): third() < 1 { by intervals() }
// The index refines, one bit per try: a ninth and an eighth are 1/72 apart,
// which index 3 (terms within 1/8) cannot separate and a later try can.
theorem refined(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals(p := 16, tries := 6, n := 3) }

// expect-error: intervals: the enclosures do not separate the two sides
theorem false_order(): CReal::ofRat(Rat(1, 2)) < third() { by intervals() }
// expect-error: intervals: the enclosures do not separate the two sides
theorem too_close(): third() * third() < CReal::ofRat(Rat(1, 8)) { by intervals(p := 16, tries := 2, n := 3) }
// expect-error: intervals: the enclosures do not separate the two sides
theorem open_side(x: CReal): x < x + 1 { by intervals() }
// An equality is never decided by enclosures, even as `<=`.
// expect-error: intervals: the enclosures do not separate the two sides
theorem third_le_third(): third() <= third() { by intervals() }

// Inverses. The apartness an inverse needs comes from the tactic too, and
// the inverse's enclosure is its argument's reciprocal: a twelfth's is
// between 11 and 13.
fn twelfth() → CReal { third() - CReal::ofRat(Rat(1, 4)) }
theorem twelfth_apart(): twelfth().Apart(0) { by intervals() }
theorem inv_lt(): twelfth().inv(h := twelfth_apart()) < CReal::ofRat(13) { by intervals() }
theorem lt_inv(): CReal::ofRat(11) < twelfth().inv(h := twelfth_apart()) { by intervals() }
theorem inline_apart(): (third() - CReal::ofRat(Rat(1, 4))).inv(h := by intervals()) <= CReal::ofRat(13) { by intervals() }
// A rational's inverse with its apartness searched at the call, read exactly.
theorem inv_rat(): CReal::ofRat(Rat(1, 3))⁻¹ < CReal::ofRat(4) { by intervals() }
theorem neg_inv(): (-twelfth()).inv(h := by intervals()) < CReal::ofRat(-11) { by intervals() }
// The inverse is enclosed through its argument, never through its own terms:
// with the apartness a hypothesis its terms do not compute, and the goal
// still goes through.
theorem inv_open_proof(h: twelfth().Apart(0)): twelfth().inv(h := h) < CReal::ofRat(13) { by intervals() }
theorem apart_reals(): third().Apart(CReal::ofRat(Rat(1, 4))) { by intervals() }
// expect-error: intervals: the enclosures do not separate the two sides
theorem apart_same(): third().Apart(third()) { by intervals() }
// Read at index 3 the twelfth's enclosure holds zero, and one try does not
// refine.
// expect-error: intervals: the enclosures do not separate the two sides
theorem apart_near(): twelfth().Apart(0) { by intervals(p := 16, tries := 1, n := 3) }

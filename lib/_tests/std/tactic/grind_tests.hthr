// Probes of `lib/std/tactic/grind.hthr`: congruence closure over the goal's
// equations, the hints and the lemmas they instantiate, and its refusals,
// which report the graph. Tests, not library: nothing outside lib/_tests
// imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import list; import option; import char; import string; import tactic; import int; import grind; import memory;

// Equations chained, and turned around.
theorem chain(a, b, c, d: Nat, h1: a = b, h2: c = b, h3: c = d): a = d { by grind() }
// Congruence: an argument, the function, both, and under several layers.
theorem arg(f: Nat → Nat, a, b: Nat, h: a = b): f(a) = f(b) { by grind() }
theorem fun_and_arg(f, g: Nat → Nat, a, b: Nat, hf: f = g, ha: a = b): f(a) = g(b) { by grind() }
theorem two_args(f: Nat → Nat → Nat, a, b, c, d: Nat, h1: a = b, h2: c = d): f(a, c) = f(b, d) { by grind() }
theorem partial(f: Nat → Nat → Nat, a, b, c: Nat, h1: a = b, h2: f(b, c) = c): f(a, c) = c { by grind() }
// A fixed point reached through the graph rather than given: `f(a) = a`
// makes `f(f(a))` a member of `a`'s class.
theorem fixed_point(f: Nat → Nat, a: Nat, h: f(a) = a): f(f(f(a))) = a { by grind() }
// An open element type, and type arguments read as part of the head.
theorem open_type<A>(f: A → A, x, y: A, h: x = y): f(f(x)) = f(f(y)) { by grind() }
theorem open_lists<A>(xs, ys, zs: List<A>, h: xs = ys): (xs ++ zs).len() = (ys ++ zs).len() { by grind() }
// Constructor values, read as their constructor applied to the fields.
theorem ctor_fields(x, y: Nat, xs, ys: List<Nat>, h1: x = y, h2: xs = ys): Cons(x, xs) = Cons(y, ys) { by grind() }
theorem ctor_option<A>(x, y: A, h: x = y): Some(x) = Some(y) { by grind() }
// Hints: a lemma at its instance, and a local's consequence.
theorem hint_lemma(xs: List<Nat>): xs ++ [] = xs { by grind_with([List::append_nil(xs)]) }
theorem hint_local(f: Nat → Nat, k: (n: Nat) → f(n) = n, a: Nat): f(f(a)) = a { by grind_with([k(a)]) }
// The shape of `Format::down_of_le`'s two hand-built steps
// (lib/std/num/float/eft.hthr), with the two lemmas as hints: a `trans` of a
// `cong` and an instance, and the same again under a product.
theorem down_of_le_steps(h, k, b, e: Nat, s: Succ(b) = (b - e) + Succ(e), hk: h = k * Nat::pow(2, Succ(b))): h = (k * Nat::pow(2, b - e)) * Nat::pow(2, Succ(e)) {
    by grind_with([Nat::pow_add(2, b - e, Succ(e)), sym(k.mul_assoc(Nat::pow(2, b - e), Nat::pow(2, Succ(e))))])
}
// A checking position: the goal comes from a `let`'s annotation, and from
// the codomain of a λ.
theorem in_let(f: Nat → Nat, a, b: Nat, h: a = b): f(b) = f(a) {
    let p: (f(a) = f(b)) = by grind();
    sym(p)
}
fn under_lambda(f: Nat → Nat, a, b: Nat, h: a = b) → Nat → f(a) = f(b) { λ n => by grind() }

// Lemmas: equations under binders, instantiated by matching one side
// against the graph (round 2). A local lemma, then the append tower of
// issues/grind-e-matching.md from the lemmas by name with no instance
// written: at an open element type, with a lemma that does not apply, two
// lemmas over two types (`len` of appends, then `+`), and at `Nat` with a
// closed list among the terms.
theorem local_lemma(f: Nat → Nat, k: (n: Nat) → f(n) = n, a: Nat): f(f(a)) = a { by grind() }
theorem tower<A>(a, b, c, d: List<A>): ((a ++ b) ++ c) ++ d = a ++ (b ++ (c ++ d)) { by grind_using(["List::append_assoc"], []) }
theorem tower_nil<A>(a, b, c: List<A>): ((a ++ []) ++ b) ++ c = a ++ (b ++ c) { by grind_using(["List::append_assoc", "List::append_nil"], []) }
theorem tower_lens<A>(a, b, c: List<A>): ((a ++ b) ++ c).len() = a.len() + (b.len() + c.len()) { by grind_using(["List::len_append", "Nat::add_assoc"], []) }
theorem tower_closed(xs, ys, zs: List<Nat>): ((xs ++ ys) ++ zs) ++ [1, 2] = xs ++ (ys ++ (zs ++ [1, 2])) { by grind_using(["List::append_assoc"], []) }
// A commutative lemma among them (its instances turn every sum round), and
// a round whose matching outgrew one evaluation's fuel until each lemma's
// matching was made its own (`settled`).
theorem regroup(a, b, c: Int): (a + b) + c = b + (c + a) { by grind_using(["Int::add_assoc", "Int::add_comm"], []) }

// Definitional equalities (issues/grind-definitional-equalities.md): a
// pattern's argument matched up to `Defeq`, its free binder drawn from the
// graph's terms. `Int::neg_add`'s `Succ` step from the four lemmas its
// `calc` cites, as `lib/std/num/int.hthr` states it: `OfNat(Succ(k))` is
// `OfNat(k).isucc()`, and `-OfNat(k)` is `Int::negOfNat(k)`, only by
// computation, at a neutral `k`; and the step with the first spelled the
// lemmas' way. Then a list at an open element type, `[a] ++ xs` against
// `Cons(a, ys)` and `[] ++ ys` against `xs` (the second only from the
// right side's pattern, `g(ys)`); a checking position; and a negative
// control, where no term of the graph makes `Cons(a, ys)` the list.
theorem neg_add_succ(a: Int, k: Nat, ih: -(a + OfNat(k)) = -a + -OfNat(k)): -(a + OfNat(Succ(k))) = -a + NegSucc(k) {
    by grind_using(["Int::add_isucc", "Int::neg_isucc", "Int::add_ipred", "Int::ipred_negOfNat"], [])
}
theorem neg_add_step(a: Int, k: Nat, ih: -(a + OfNat(k)) = -a + -OfNat(k)): -(a + OfNat(k).isucc()) = -a + Int::negOfNat(k).ipred() {
    by grind_using(["Int::add_isucc", "Int::neg_isucc", "Int::add_ipred", "Int::ipred_negOfNat"], [])
}
theorem near_cons<A>(f, g: List<A> → Nat, a: A, k: (ys: List<A>) → f(Cons(a, ys)) = g(ys), xs: List<A>): f(List::append([a], xs)) = g(xs) { by grind() }
theorem near_nil<A>(f, g: List<A> → Nat, k: (ys: List<A>) → f(List::append([], ys)) = g(ys), xs: List<A>): f(xs) = g(xs) { by grind() }
theorem near_checking<A>(f, g: List<A> → Nat, a: A, k: (ys: List<A>) → f(Cons(a, ys)) = g(ys), xs: List<A>): g(xs) = f(List::append([a], xs)) {
    let p: (f(List::append([a], xs)) = g(xs)) = by grind();
    sym(p)
}
// Two free binders (`x` and `ys`), asked about with holes and looked up:
// `?x := a`, `?ys := [] ++ xs`, which is `xs`, in a checking position and
// at a literal list; a free type binder (`len<?A>(?xs)` against
// `near_len(bs)`, whose `?A := Bool` is an atom of the graph); and a
// negative control, where the solution `?ys` is no term of `g(zs)`.
theorem near_two<A>(f, g: List<A> → Nat, k: (x: A, ys: List<A>) → f(Cons(x, ys)) = g(ys), a: A, xs: List<A>): f(List::append([a], xs)) = g(xs) { by grind() }
theorem near_two_checking<A>(f, g: List<A> → Nat, k: (x: A, ys: List<A>) → f(Cons(x, ys)) = g(ys), a: A, xs: List<A>): g(xs) = f(List::append([a], xs)) {
    let p: (f(List::append([a], xs)) = g(xs)) = by grind();
    sym(p)
}
theorem near_two_closed(f, g: List<Nat> → Nat, k: (x: Nat, ys: List<Nat>) → f(Cons(x, ys)) = g(ys)): f(List::append([1], [2, 3])) = g([2, 3]) { by grind() }
fn near_len<A>(xs: List<A>) → Nat { xs.len() }
theorem near_type(c: Nat → Nat, k: (A: Type, xs: List<A>) → c(List::len(xs)) = 0, bs: List<Bool>): c(near_len(bs)) = 0 { by grind() }
// One free binder the holes leave unsolved (`len([] ++ ?xs)` against
// `near_len(bs)` stops at two stuck matches), drawn from the graph instead.
theorem near_drawn(c: Nat → Nat, k: (xs: List<Bool>) → c(List::len(List::append(Nil, xs))) = 0, bs: List<Bool>): c(near_len(bs)) = 0 { by grind() }
// expect-error: grind: the two sides are not in one class
theorem near_two_refused<A>(f, g: List<A> → Nat, k: (x: A, ys: List<A>) → f(Cons(x, ys)) = g(ys), a: A, xs, zs: List<A>): f(List::append([a], xs)) = g(zs) { by grind() }
// expect-error: grind: the two sides are not in one class
theorem near_refused<A>(f, g: List<A> → Nat, a, b: A, k: (ys: List<A>) → f(Cons(a, ys)) = g(ys), xs: List<A>): f(List::append([b], xs)) = g(xs) { by grind() }
// The report of the lemmas used (a `tactic-report` warning): here
// `List::append_assoc`, and not `List::append_nil`.
theorem reported<A>(a, b, c: List<A>): (a ++ b) ++ c = a ++ (b ++ c) { by grind_report(["List::append_assoc", "List::append_nil"], []) }

// A lurking hint (docs/grind-design.md §9.6): `lurk_one` says nothing about
// `c` or `lurk_two`, and the proof does not cite it, but it is the only
// thing that puts the term `1` in the graph, which the near match of
// `lurk_sc(?b)` against `lurk_two()` needs as its solution. The report says
// "not cited, but needed to find it: lurk_one", and the narrowed call fails.
fn lurk_sc(n: Nat) → Nat { Succ(n) }
fn lurk_two() → Nat { 2 }
theorem lurk_one(): Nat::add(1, 0) = 1 { refl }
theorem lurk_reported(c: Nat → Nat, k: (b: Nat) → c(lurk_sc(b)) = 0): c(lurk_two()) = 0 { by grind_report(["lurk_one", "List::append_nil"], []) }
// expect-error: grind: the two sides are not in one class
theorem lurk_narrowed(c: Nat → Nat, k: (b: Nat) → c(lurk_sc(b)) = 0): c(lurk_two()) = 0 { by grind_report([], []) }

// The lurking hint's goal with its hints reordered and one it does not need
// (the other mutation controls are in grind_mutation_tests).
theorem lurk_reordered(c: Nat → Nat, k: (b: Nat) → c(lurk_sc(b)) = 0): c(lurk_two()) = 0 { by grind_using(["List::append_nil", "lurk_one"], []) }

// Lemmas with premises (issues/grind-lemma-premises.md): the binders no
// side binds are proved at each instance. An order premise by a local; an
// equation premise by the graph, where no local is it (`p(a)` is `p(b)` only
// through `a = b`); a closed premise by the instance search; and a premise
// that only holds once an earlier instance has merged its sides, so the
// instance waits and is tried again.
theorem premise_local(f, g: Nat → Nat, n: Nat, k: (i: Nat) → i < n → f(i) = g(i), a: Nat, h: a < n): f(a) = g(a) { by grind() }
theorem premise_graph(f: Nat → Nat, p: Nat → Bool, k: (x: Nat) → p(x) = True → f(x) = x, a, b: Nat, hb: p(b) = True, ab: a = b): f(a) = b { by grind() }
theorem premise_synth(f: Nat → Nat, k: (n: Nat) → 0 < n → f(n) = 1): f(3) = 1 { by grind() }
theorem premise_later(f, g: Nat → Nat, p: Nat → Bool, k: (x: Nat) → p(x) = True → f(x) = x, e: (x: Nat) → g(x) = x, a: Nat, hb: p(a) = True): f(g(a)) = a { by grind() }
// The shape of `Memory::set_set_comm`'s branches (lib/std/machine/memory.hthr):
// `get_set_hit` and `get_set_other` by name, their `same` premises the
// branch's locals, read over another memory with the same space by `Defeq`.
theorem set_set_hit_other<A, C>(m: Memory<A, C>, x, y, z: A, d, e: C, yx: m.space.same(y, x) = True, zx: m.space.same(z, x) = False):
    m.set(z, e).set(y, d).get(x) = m.set(y, d).set(z, e).get(x) {
    by grind_using(["Memory::get_set_hit", "Memory::get_set_other"], [])
}
// A premise no local is, by a hint that is no equation (a derived order
// fact).
theorem premise_hint(f, g: Nat → Nat, n: Nat, k: (i: Nat) → Succ(i).Le(n) → f(i) = g(i), a, b: Nat, ab: Succ(a).Le(b), bn: b.Le(n)): f(a) = g(a) {
    by grind_with([Succ(a).le_trans(b, n, ab, bn)])
}
// The report names the locals the premises cite.
theorem premise_reported(f, g: Nat → Nat, n: Nat, k: (i: Nat) → i < n → f(i) = g(i), a: Nat, h: a < n): f(a) = g(a) { by grind_report([], []) }

// Conjunctions and records of equations (issues/grind-read-conjunctions.md):
// a one-constructor fact is read field by field, `k.left`, `k.right`, each
// proved by its projection. Nested, through a definition whose value is a
// `∧` (`Env::Same`'s shape), a lemma among the fields, a hint, a record that
// is not `∧`, a field at an open element type, a field that proves a
// premise, and a checking position.
theorem conj(a, b, c: Nat, k: a = b ∧ b = c): a = c { by grind() }
theorem conj_nested(a, b, c, d: Nat, k: (a = b) ∧ ((b = c) ∧ (c = d))): d = a { by grind() }
fn Pairs(a, b, c: Nat) → Type { (a = b) ∧ (b = c) }
theorem conj_defined(a, b, c: Nat, k: Pairs(a, b, c)): a = c { by grind() }
theorem conj_lemma(f, g: Nat → Nat, a, b: Nat, k: ((n: Nat) → f(n) = g(n)) ∧ (g(a) = b)): f(a) = b { by grind() }
theorem conj_hint(f: Nat → Nat, a, b, c: Nat, k: (n: Nat) → (f(n) = n) ∧ (n = n)): f(f(a)) = a { by grind_with([k(a), k(f(a))]) }
record Hops(a, b, c: Nat) { ab: a = b, bc: b = c }
theorem conj_record(f: Nat → Nat, a, b, c: Nat, p: Hops(a, b, c)): f(a) = f(c) { by grind() }
theorem conj_open<A>(x, y, z: A, k: (x = y) ∧ (y = z)): x = z { by grind() }
theorem conj_premise(f, g: Nat → Nat, n: Nat, k: (i: Nat) → i < n → f(i) = g(i), a: Nat, h: (a < n) ∧ True): f(a) = g(a) { by grind() }
theorem conj_checking(f: Nat → Nat, a, b: Nat, k: (a = b) ∧ True): f(b) = f(a) {
    let p: (f(a) = f(b)) = by grind();
    sym(p)
}

// Constructors and disequalities (issues/grind-constructor-facts.md): two
// values of one constructor in one class give their fields' equations
// (injectivity); two different constructors, or both sides of a
// disequality, are a contradiction, which proves any goal. The issue's
// three: a field of a list equation, `Nil = Cons(…)` proving anything, and
// a disequality through a congruence (the goal `a ≠ b` opened). Then a
// literal field, an open element type, a checking position, a
// three-constructor type (its middle constructor's fields, and it against
// the last), a record, nested constructors, two values reached through a
// chain (the shape of `x86_64_fetch`'s `readable_head_same`), through a
// lemma's instance, `Bool` and literal contradictions, a disequality and a
// contradiction proving an equation goal, a goal under a binder, and `Nat`'s
// successor: congruence, injectivity, `Succ(a) ≠ 0`, and in a lemma's
// pattern.
theorem inj_head(a, b: Nat, as, bs: List<Nat>, h: Cons(a, as) = Cons(b, bs)): a = b { by grind() }
theorem inj_tail(a, b: Nat, as, bs: List<Nat>, h: Cons(a, as) = Cons(b, bs)): as = bs { by grind() }
theorem disjoint_any<P>(x: Nat, xs: List<Nat>, h: (Nil<Nat> = Cons(x, xs))): P { by grind() }
theorem diseq_cong(f: Nat → Nat, a, b: Nat, h: f(a) ≠ f(b)): a ≠ b { by grind() }
theorem inj_literal(b: Nat, as, bs: List<Nat>, h: Cons(1, as) = Cons(b, bs)): b = 1 { by grind() }
theorem inj_open<A>(a, b: A, as, bs: List<A>, h: Cons(a, as) = Cons(b, bs)): as = bs { by grind() }
theorem inj_checking<A>(f: A → Nat, a, b: A, h: Some(a) = Some(b)): f(b) = f(a) {
    let p: (f(a) = f(b)) = by grind();
    sym(p)
}
inductive Tri { One(n: Nat), Two(n: Nat, m: Nat), Three }
theorem tri_inj(a, b, c, d: Nat, h: Two(a, b) = Two(c, d)): b = d { by grind() }
theorem tri_disjoint(a, b: Nat, t: Tri, h1: t = Two(a, b), h2: t = Three): a = b { by grind() }
theorem tri_disjoint_one<P>(a, b, c: Nat, h: One(a) = Two(b, c)): P { by grind() }
record Pt { x: Nat, y: Nat }
theorem record_inj(a, b, c, d: Nat, h: Pt(a, b) = Pt(c, d)): b = d { by grind() }
theorem inj_nested(a, b: Nat, xs: List<Nat>, h: Some(Cons(a, xs)) = Some(Cons(b, xs))): a = b { by grind() }
theorem read_twice(r: Nat → Option<Nat>, x, l, m: Nat, h1: r(x) = Some(l), h2: r(x) = Some(m)): l = m { by grind() }
theorem inj_by_lemma(r: Nat → Option<Nat>, k: (x: Nat) → r(x) = r(Succ(x)), x, l, m: Nat, h1: r(x) = Some(l), h2: r(Succ(x)) = Some(m)): l = m { by grind() }
theorem bool_squeeze(n: Bool, h1: n = True, h2: n = False): False { by grind() }
theorem literal_squeeze(n: Nat, h1: n = 3, h2: n = 4): False { by grind() }
theorem squeeze_equation(n: Bool, a, b: Nat, h1: n = True, h2: n = False): a = b { by grind() }
theorem diseq_equation(a, b: Nat, f: Nat → Nat, h: f(a) ≠ f(b), e: a = b): 0 = 1 { by grind() }
theorem goal_ctors<A>(x: A): Some(x) ≠ None { by grind() }
theorem goal_binder(f: Nat → Nat, k: (n: Nat) → f(n) = n): (m: Nat) → f(f(m)) = m { by grind() }
theorem succ_cong(a, b: Nat, h: a = b): Succ(a) = Succ(b) { by grind() }
theorem succ_inj(a, b: Nat, h: Succ(a) = Succ(b)): a = b { by grind() }
theorem succ_zero(a: Nat, h: Succ(a) = 0): False { by grind() }
theorem succ_pattern(f: Nat → Nat, k: (n: Nat) → f(Succ(n)) = n, a, b: Nat, h: b = Succ(a)): f(b) = a { by grind() }
// The report names the local the field equation came from.
theorem inj_reported(a, b: Nat, as, bs: List<Nat>, h: Cons(a, as) = Cons(b, bs)): a = b { by grind_report([], []) }

// A side's head normal form, read once the graph as written proves nothing
// (docs/grind-design.md §14.4): a definition whose value is a literal or a
// constructor's (codata observations: `grind_codata_tests`).
fn grind_two() → Nat { 2 }
fn grind_wrap(n: Nat) → Option<Nat> { Some(n) }
theorem reduct_literal(h: grind_two() = 3): False { by grind() }
theorem reduct_inj(a, b: Nat, h: grind_wrap(a) = Some(b)): a = b { by grind() }
theorem reduct_disjoint(a: Nat, h: grind_wrap(a) = None): False { by grind() }

// The two sides in different classes: the failure is the graph.
// expect-error: grind: the two sides are not in one class
theorem not_closed(f: Nat → Nat, a, b: Nat, h: f(a) = b): f(b) = a { by grind() }
// A lemma whose pattern meets nothing in the graph: the report says which.
// expect-error: its patterns never matched
theorem never_matched(f, g: Nat → Nat, k: (n: Nat) → g(n) = n, a: Nat): f(a) = a { by grind() }
// A premise the instance cannot prove: `a = 0` is in no class, no local and
// no instance, so the instance waits and the report names the premise.
// expect-error: k, premise 1
theorem premise_unproved(f: Nat → Nat, k: (n: Nat) → n = 0 → f(n) = n, a: Nat): f(a) = a { by grind() }
// A binder only a premise mentions (`∃`-like): no side binds it and the
// premise depends on it, so the lemma is set aside.
// expect-error: neither side mentions every binder
theorem premise_exists(f: Nat → Nat, k: (n, m: Nat) → n < m → f(n) = n, a: Nat): f(a) = a { by grind() }
// Instances that only make terms of one class: matching runs dry.
// expect-error: no new instance after 2 rounds
theorem runs_dry(f: Nat → Nat, k: (n: Nat) → f(n) = f(f(n)), a: Nat): f(a) = a { by grind() }
// Instances that make new terms every round: the round budget ends it.
// expect-error: stopped after 8 rounds
theorem keeps_growing(f, g: Nat → Nat, k: (n: Nat) → f(n) = f(g(n)), a: Nat): f(a) = a { by grind() }
// A congruence is not injectivity: `f(a) = f(b)` says nothing of `a` and `b`.
// expect-error: grind: the two sides are not in one class
theorem not_injective(f: Nat → Nat, a, b: Nat, h: f(a) = f(b)): a = b { by grind() }
// A goal that is no equation is proved only from a contradiction.
// expect-error: grind: the goal is not an equation, and the facts hold no contradiction
theorem not_equation(a, b: Nat, h: a = b): a <= b { by grind() }
// Injectivity gives the fields' equations and no more; one constructor on
// both sides, one side of a `Bool`, and a disequality whose sides stay apart
// are no contradiction.
// expect-error: grind: the two sides are not in one class
theorem inj_only_fields(a, b: Nat, as, bs: List<Nat>, h: Cons(a, as) = Cons(b, bs)): as = Nil { by grind() }
// expect-error: no contradiction
theorem one_ctor_no_contradiction<A>(x, y: A, h: Some(x) = Some(y)): False { by grind() }
// expect-error: no contradiction
theorem one_side_no_contradiction(n: Bool, h: n = True): False { by grind() }
// expect-error: no contradiction
theorem diseq_apart(f: Nat → Nat, a, b: Nat, h: f(a) ≠ f(b)): False { by grind() }
// Not yet: a successor against a literal (`Succ(a)` with `a = 2` is `3` by
// computation, which the graph does not see), and a constructor whose field
// a later field's type mentions (its value is read as an atom).
// expect-error: grind: the two sides are not in one class
theorem succ_literal_unread(f: Nat → Nat, a: Nat, h: a = 2): f(Succ(a)) = f(3) { by grind() }
record Tied { lo: Nat, hi: Nat, same: lo = hi }
// expect-error: grind: the two sides are not in one class
theorem dependent_ctor_unread(a, b, c, d: Nat, s: a = b, t: c = d, h: Tied(a, b, s) = Tied(c, d, t)): a = c { by grind() }
// A hint that is no equation is kept for the premises, and closes nothing
// by itself.
// expect-error: hint 0: not an equation: kept for the premises
theorem order_hint(a, b, c: Nat, h: a <= b): a = c { by grind_with([h]) }
// A conjunction none of whose sides is an equation is read as nothing, as
// before; a record whose field a later field's type mentions (an
// existential, whose proof is about its witness) is kept whole, and so is
// `↔`.
// expect-error: grind: the two sides are not in one class
theorem conj_no_equation(a, b, c: Nat, k: (a <= b) ∧ (b <= c)): a = c { by grind() }
record Pinned { here: Nat, there: Nat, same: here = there }
// expect-error: grind: the two sides are not in one class
theorem dependent_unread(p: Pinned, x: Nat, h: p.there = x): p.here = x { by grind() }

theorem addcomm4_refuted(v: Nat → Bool): all_true(addcomm4_cnf(), v) = False {
    match e: all_true(addcomm4_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(addcomm4_f0(), v) = j(addcomm4_f0_is(), λ g _ => Holds(g, v), holds_formula_from(addcomm4_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(addcomm4_f1(), v) = adds_sound(addcomm4_f0(), v, h0, addcomm4_c1(), addcomm4_s1());
            let h2: Holds(addcomm4_f2(), v) = j(addcomm4_f2_is(), λ g _ => Holds(g, v), adds_sound(addcomm4_f1(), v, h1, addcomm4_c2(), addcomm4_s2()));
            false_elim(check_sound(addcomm4_f2(), v, h2, addcomm4_c3(), addcomm4_s3()))
        },
    }

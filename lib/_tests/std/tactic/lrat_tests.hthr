// Probes of the kernel's LRAT checker (lib/std/tactic/lrat.hthr).
import logic;
import bool;
import list;
import option;
import nat_map;
import lrat;

// `x` and `¬x`: the second clause is a conflict once the first is a unit.
theorem tiny_checks(): check(formula_of([[2], [3]]), [Add(3, [], [1, 2])]) = True { refl }

theorem tiny_refuted(v: Nat → Bool): all_true([[2], [3]], v) = False {
    refuted([[2], [3]], [Add(3, [], [1, 2])], tiny_checks(), v)
}

// A hint list that stops before the conflict derives nothing.
// expect-error(kernel): the kernel rejected `tiny_short_hints`: NotConvertible
theorem tiny_short_hints(): check(formula_of([[2], [3]]), [Add(3, [], [1])]) = True { refl }

// A satisfiable formula has no refutation the checker accepts: soundness,
// at the valuation making every variable true.
theorem satisfiable_never_refuted(steps: List<Step>): ¬(check(formula_of([[2, 4], [5, 6]]), steps) = True) {
    λ ok => absurd(refuted([[2, 4], [5, 6]], steps, ok, λ _ => True))
}


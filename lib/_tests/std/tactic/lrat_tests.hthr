fn addcomm4_c3() → List<Step> { [Add(175, [10, 8, 3, 7, 5], [3, 6, 20, 62, 63, 78, 118, 157]), Add(176, [12, 8, 55, 86, 21, 7, 5], [10, 13, 21, 23, 69, 71, 79, 81, 121, 156, 26, 32, 35, 39, 84, 90, 93, 97, 126, 133, 145, 45, 47, 102, 105, 129]), Add(177, [8, 7, 3, 5], [175, 2, 7, 60, 65, 117, 176, 9, 15, 18, 22, 67, 73, 76, 80, 122, 156, 26, 32, 35, 39, 84, 90, 93, 97, 126, 133, 145, 45, 47, 102, 105, 129]), Add(178, [10, 3, 9, 7, 5], [3, 6, 20, 62, 63, 78, 118, 158, 9, 12, 18, 22, 67, 70, 76, 80, 121, 159, 26, 32, 35, 39, 84, 90, 93, 97, 126, 133, 148, 43, 49, 101, 107, 130]), Add(179, [12, 55, 86, 21, 9, 7, 5], [10, 13, 21, 23, 69, 71, 79, 81, 121, 159, 26, 32, 35, 39, 84, 90, 93, 97, 126, 133, 148, 43, 49, 101, 107, 130]), Add(180, [], [160, 169, 174, 177, 178, 2, 7, 60, 65, 117, 179, 9, 15, 18, 22, 67, 73, 76, 80, 122, 159, 26, 32, 35, 39, 84, 90, 93, 97, 126, 133, 148, 43, 49, 101, 107, 130])] }

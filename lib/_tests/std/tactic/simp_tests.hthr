// Probes of `simp_only`, `simp_show` and `by simp()` (docs/tactics/simp-design.md,
// issues/simp-tactic.md): a goal normalised by a pinned list of laws along
// `=` and along a designated relation, side conditions, what is left
// (`then :=`, `using :=`), calls at constructors computing first, every
// refusal with the route it took, and the sets a goal's types bring. Tests, not library: nothing imports this
// module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import list; import option; import pair; import char; import string; import tactic;
import relation; import relation_props; import algebra_rel; import algebra; import regex; import regex_language; import regex_dfa;
import simp_laws; import simp; import list_pointwise; import bitvec; import vector;

// ---------------------------------------------------------------------------
// Equations: both sides normalised, the goal closed where they meet.

theorem len_three<A>(xs, ys, zs: List<A>): ((xs ++ ys) ++ zs).len() = xs.len() + (ys.len() + zs.len()) {
    simp_only(List::len_append, Nat::add_assoc)
}

// A hypothesis is a law like any other.
theorem by_hypothesis(a, b, c: Nat, h: a = b): a + c = b + c { simp_only(h) }

// A law that would rewrite for ever stops where the two sides are one term.
theorem commuted(a, b: Nat): a + b = b + a { simp_only(Nat::add_comm) }

// One step of a calc.
theorem in_a_calc<A>(xs, ys, zs: List<A>): ((xs ++ ys) ++ zs).len() = (ys.len() + zs.len()) + xs.len() {
    calc {
        ((xs ++ ys) ++ zs).len()
            = xs.len() + (ys.len() + zs.len()) := simp_only(List::len_append, Nat::add_assoc),
            = (ys.len() + zs.len()) + xs.len() := Nat::add_comm(xs.len(), ys.len() + zs.len()),
    }
}

// A call at a constructor computes to its arm with the recursive call
// written as a call, so a law over that call matches it: a tail call on an
// accumulator (`foldl`), and a recursion on `Nat`.
theorem computed_tail_call<A, B>(t: List<A>, a: A, f, g: B → A → B, z: B,
    e: (w: B) → t.foldl(f, w) = t.foldl(g, w), h: f(z, a) = g(z, a)): Cons(a, t).foldl(f, z) = Cons(a, t).foldl(g, z)
{
    simp_only(h, e)
}

fn sum_below(n: Nat, f: Nat → Nat) → Nat { match n { Zero => 0, Succ(m) => sum_below(m, f) + f(m) } }

theorem computed_nat_recursion(m: Nat, f, g: Nat → Nat, e: sum_below(m, f) = sum_below(m, g), h: f(m) = g(m)):
    sum_below(Succ(m), f) = sum_below(Succ(m), g)
{
    simp_only(e, h)
}

// What is left is spelled as the calls it holds.
// expect-error: foldl(t, f, g(z, a))
theorem computed_left_spelled<A, B>(t: List<A>, a: A, f, g: B → A → B, z: B, h: f(z, a) = g(z, a)):
    Cons(a, t).foldl(f, z) = Cons(a, t).foldl(g, z)
{
    simp_only(h)
}

// A definition named among the laws is unfolded where it is called, its
// body at the call's arguments (docs/tactics/simp-design.md §14); a law about what
// it unfolds to then fires. A theorem's proof is opaque and is never
// unfolded: it is a law.
fn twice(n: Nat) → Nat { n + n }
fn twice_list<A>(xs: List<A>) → List<A> { xs ++ xs }

theorem unfolded_by_name(a: Nat): twice(0 + a) = a + a { simp_only(twice, Nat::add_left_zero) }
theorem unfolded_generic<A>(xs: List<A>): twice_list(xs ++ Nil).len() = xs.len() + xs.len() {
    simp_only(twice_list, List::append_nil, List::len_append)
}

// A definition whose body matches on what its arguments do not decide yet
// unfolds all the same: the laws rewrite the scrutinee, and the match
// selects its arm. A comparison of two closed words computes.
fn leave_like(f: Nat → Bool, n, x, y: Nat) → Nat { match f(n) { False => x, True => y } }
fn flag_word(v: Nat → BitVec(64), n: Nat) → Nat { match v(n).eq_bit(BitVec::ofNat(1)) { False => 0, True => 1 } }

theorem unfolded_into_a_match(f: Nat → Bool, n, x, y: Nat, h: f(n) = True): leave_like(f, n, x, y) = y { simp_only(leave_like, h) }
theorem decided_by_equal_words(v: Nat → BitVec(64), n: Nat, h: v(n) = BitVec::ofNat(1)): flag_word(v, n) = 1 { simp_only(flag_word, h) }
theorem decided_by_unequal_words(v: Nat → BitVec(64), n: Nat, h: v(n) = BitVec::ofNat(0)): flag_word(v, n) = 0 { simp_only(flag_word, h) }

// A match nothing decides keeps its arms, and the laws rewrite inside them.
fn pick_shifted(f: Nat → Bool, n, a, b: Nat) → Nat { match f(n) { False => 0 + a, True => b } }

theorem inside_the_arms(f: Nat → Bool, n, a, b: Nat): pick_shifted(f, n, a, b) = (match f(n) { False => a, True => b }) {
    simp_only(pick_shifted, Nat::add_left_zero)
}

// Nothing decides it: the match is what is left, shown as the `if` it is.
// expect-error: if eq_bit(v(n), ofNat(1)) { 1 } else { 0 }
theorem undecided_match(v: Nat → BitVec(64), n: Nat): flag_word(v, n) = 1 { simp_only(flag_word) }

// Not named, a definition stays a call, and a law about its body does not
// reach inside it.
// expect-error: len(twice_list(xs))
theorem not_unfolded<A>(xs: List<A>): twice_list(xs ++ Nil).len() = xs.len() + xs.len() {
    simp_only(List::append_nil, List::len_append)
}

// A function that is no definition is neither a law nor unfolded.
// expect-error: is not a law
theorem a_variable_is_not_unfolded(f: Nat → Nat, a: Nat): f(a) = a { simp_only(f) }

// ---------------------------------------------------------------------------
// Side conditions: a hypothesis in scope, a `let`, or `discharge :=`.

theorem condition_in_scope(n, m, k: Nat, h: n <= m): ((m - n) + n) + k = m + k {
    simp_only(Nat::sub_add_cancel)
}

theorem condition_by_let(n, m, k: Nat, h0: n <= m ∧ True): ((m - n) + n) + k = m + k {
    let h: (n <= m) = h0.left;
    simp_only(Nat::sub_add_cancel)
}

theorem condition_discharged(n, m, k: Nat, h0: n <= m ∧ True): ((m - n) + n) + k = m + k {
    simp_only(Nat::sub_add_cancel, discharge := h0.left)
}

// expect-error: its side condition `n <= m` is not a hypothesis here, and nothing discharged it
theorem condition_blocked(n, m, k: Nat): ((m - n) + n) + k = m + k {
    simp_only(Nat::sub_add_cancel)
}

// ---------------------------------------------------------------------------
// What is left: proved by `then :=`, or closed from a fact by `using :=`.

theorem then_proves_the_rest<A>(xs, ys: List<A>, P: Nat → Type, h: P(xs.len() + ys.len())): P((xs ++ ys).len()) {
    simp_only(List::len_append, then := h)
}

theorem using_a_fact<A>(xs, ys, zs: List<A>, P: Nat → Type, h: P((xs ++ ys).len() + zs.len())): P(((xs ++ ys) ++ zs).len()) {
    simp_only(List::len_append, using := h)
}

// expect-error: the goal and the fact given by `using :=` do not simplify to the same statement
theorem using_another_fact<A>(xs, ys: List<A>, P: Nat → Type, h: P(ys.len() + xs.len())): P((xs ++ ys).len()) {
    simp_only(List::len_append, using := h)
}

// ---------------------------------------------------------------------------
// A designated relation: laws along `≈`, under constructors and calls.

theorem smart_constructors(a, b: Regex): Regex::alt(Regex::seq(a, b), b) ≈ Alt(Seq(a, b), b) {
    simp_only(Regex::alt_same, Regex::seq_same)
}

theorem laws_with_arguments(a, b: Regex): Regex::seq(a.simplify(), b.simplify()) ≈ Seq(a, b) {
    simp_only(Regex::seq_same, Regex::simplify_same)
}

// A hypothesis along the relation, at two fields of constructor values.
theorem under_constructors(a, a2, b: Regex, h: a ≈ a2): Alt(Seq(a, b), a) ≈ Alt(Seq(a2, b), a2) { simp_only(h) }

// A call at a constructor computes before the laws are matched, its
// recursive calls kept as calls: no equation of `simp` is listed.
theorem computes_first(a, b: Regex, ha: a.simplify() ≈ a, hb: b.simplify() ≈ b): Seq(a, Star(b)).simplify() ≈ Seq(a, Star(b)) {
    simp_only(Regex::seq_same, ha, hb)
}

// ---------------------------------------------------------------------------
// Refusals, each with its route.

// expect-error: the two sides do not meet
theorem sides_apart<A>(xs, ys: List<A>): (xs ++ ys).len() = ys.len() + xs.len() {
    simp_only(List::len_append)
}

// expect-error: 1. `List::len_append`: `len(xs ++ ys)` ⟶ `len(xs) + len(ys)`
theorem route_is_shown<A>(xs, ys: List<A>): (xs ++ ys).len() = ys.len() + xs.len() {
    simp_only(List::len_append)
}

// Two laws that undo each other: found at the first repeat, not at the
// budget.
// expect-error: these laws loop: step 2 returns to the goal as written
theorem laws_loop<A>(xs, ys: List<A>, P: Nat → Type, h: P(0)): P((xs ++ ys).len()) {
    simp_only(List::len_append, prelude::sym(List::len_append(xs, ys)), then := h)
}

// expect-error: `simp_show` never closes a goal
theorem shown<A>(xs, ys, zs: List<A>): ((xs ++ ys) ++ zs).len() = xs.len() + (ys.len() + zs.len()) {
    simp_show(List::len_append)
}

// expect-error: the goal simplifies to
theorem shown_result<A>(xs, ys, zs: List<A>): ((xs ++ ys) ++ zs).len() = xs.len() + (ys.len() + zs.len()) {
    simp_show(List::len_append)
}

// expect-error: and not `unfold :=`
theorem unknown_named(a: Nat): a = a { simp_only(Nat::add_comm, unfold := a) }

// expect-error: takes the laws to simplify with
theorem no_laws(a: Nat): a + 0 = a { simp_only() }

// expect-error: `a` is not a law
theorem not_a_law(a: Nat): a + 0 = a { simp_only(a) }

// An instance under a λ (docs/tactics/simp-design.md §13): the equation is walked
// as a step of the identity relation, and the λ is crossed by its
// consumer's pointwise evidence (`list_pointwise`), since there is no
// function extensionality to cross it by.
theorem under_a_binder<A>(xs: List<A>, f: A → List<A>): xs.map(λ x => (f(x) ++ Nil).len()) = xs.map(λ x => f(x).len()) {
    simp_only(List::append_nil)
}

theorem under_a_filter<A>(xs: List<List<A>>, ys: List<A>):
    xs.filter(λ x => (x ++ Nil).len().leb((ys ++ Nil).len())).len() = xs.filter(λ x => x.len().leb(ys.len())).len()
{
    simp_only(List::append_nil)
}

theorem under_a_count<A>(xs: List<List<A>>, ys: List<A>): xs.count(λ x => (x ++ Nil).len().leb(ys.len())) + 0 = xs.count(λ x => x.len().leb(ys.len())) {
    simp_only(List::append_nil)
}

// The route spells the instance where it was found.
// expect-error: 1. `List::append_nil`: `f(x0) ++ []` ⟶ `f(x0)`
theorem under_a_binder_route<A>(xs: List<A>, f: A → List<A>): xs.map(λ x => (f(x) ++ Nil).len()).len() = 0 {
    simp_show(List::append_nil)
}

// A fold's step is crossed one binder at a time
// (`Pointwise(Pointwise(RelId))`), and each consumer in `list_pointwise`
// has its evidence.
theorem under_a_foldr<A>(xs: List<List<A>>): xs.foldr(λ x n => (x ++ Nil).len() + n, 0) = xs.foldr(λ x n => x.len() + n, 0) {
    simp_only(List::append_nil)
}
theorem under_a_foldl<A>(xs: List<List<A>>): xs.foldl(λ n x => n + (x ++ Nil).len(), 0) = xs.foldl(λ n x => n + x.len(), 0) {
    simp_only(List::append_nil)
}
theorem under_any_and_all<A>(xs: List<List<A>>, ys: List<A>):
    xs.any_bit(λ x => (x ++ Nil).len().leb(ys.len())) && xs.all_bit(λ x => (x ++ Nil).len().leb(ys.len()))
        = xs.any_bit(λ x => x.len().leb(ys.len())) && xs.all_bit(λ x => x.len().leb(ys.len()))
{
    simp_only(List::append_nil)
}
theorem under_a_find<A>(xs: List<List<A>>, ys: List<A>): xs.find(λ x => (x ++ Nil).len().leb(ys.len())) = xs.find(λ x => x.len().leb(ys.len())) {
    simp_only(List::append_nil)
}
theorem under_an_update<A>(xs: List<List<A>>): xs.update(2, λ x => x ++ Nil) = xs.update(2, λ x => x) { simp_only(List::append_nil) }
theorem under_a_split<A>(xs: List<List<A>>): xs.split_by(λ x => (x ++ Nil).non_empty()) = xs.split_by(λ x => x.non_empty()) {
    simp_only(List::append_nil)
}
theorem under_a_foldr_by_defaults<A>(xs: List<List<A>>): xs.foldr(λ x n => (x ++ Nil).len() + n, 0) = xs.foldr(λ x n => x.len() + n, 0) {
    by simp()
}

// A consumer with no pointwise evidence is named.
fn sum_of<A>(xs: List<A>, f: A → Nat) → Nat { xs.foldr(λ x n => f(x) + n, 0) }
// expect-error: PreservesRelation(Pointwise
theorem under_a_binder_no_evidence<A>(xs: List<List<A>>): sum_of(xs, λ x => (x ++ Nil).len()) = sum_of(xs, λ x => x.len()) {
    simp_show(List::append_nil)
}

// A statement that is not a relation application gives the relation no
// context to cross.
// expect-error: so nothing says how it respects the relation `Same`
theorem no_context(a, b: Regex, w: List<Nat>, h: Regex::Seq(a, b).Denotes(w)): Regex::seq(a, b).Denotes(w) {
    simp_only(Regex::seq_same, using := h)
}

// ---------------------------------------------------------------------------
// `by simp()`: the default sets of the types in the goal
// (lib/std/tactic/simp.hthr, docs/tactics/simp-design.md §3.1).

// A list and a number: `List::shape` and `Nat::arith`, neither named.
theorem by_type_defaults<A>(xs, ys: List<A>): ((xs ++ Nil) ++ ys).len() + 0 = 0 + (xs.len() + ys.len()) { by simp() }

theorem defaults_nest_right<A>(xs, ys, zs: List<A>): ((xs ++ ys) ++ zs).len() = xs.len() + (ys.len() + zs.len()) { by simp() }

// `List::windows`: a module that does not import `list_window` gets its
// laws, since the set is registered where `simp` reaches it.
theorem windows_default<A>(xs, ys: List<A>): (xs ++ ys).drop(xs.len()).drop(0) = ys ++ xs.drop(xs.len()) { by simp() }

theorem windows_lengths<A>(xs: List<A>, i: Nat, f: A → A): xs.update(i, f).drop(i).len() = xs.len() - i { by simp() }

// `Vec::entries`: a vector's entries after a `snoc` and an update.
theorem vector_default<A>(n: Nat, v: [A; n], a, b: A): vector_entries(snoc(vector_update(v, 0, b), a)) = vector_entries(v).update(0, λ _ => b) ++ [a] { by simp() }

// `BitVec::nat`: conversions that cancel; the bound a hypothesis.
theorem bitvec_default(x: BitVec(64), y: Nat, h: y < Nat::pow(2, 64)): BitVec::ofNat(x.toNat()) = x ∧ BitVec::ofNat(y, n := 64).toNat() = y { by simp() }

// `Regex`'s default is along `≈`.
theorem regex_default(a, b: Regex, c: Nat): Regex::seq(a.deriv_simp(c), b.simplify()) ≈ Seq(a.deriv(c), b) { by simp() }

// The call's own laws, a hypothesis among them.
theorem with_a_hypothesis(a, b: Nat, f: Nat → Nat, h: f(a) = b): f(0 + a) + 0 = b { by simp(extra := [h]) }

// A set of the client's own, named at the call; the type defaults left out.
register def simp_tests_commute: SimpSet = simp_set("simp_tests::commute", [name_of(Nat::add_comm)]);

theorem named_set(a, b: Nat): a + b = b + a { by simp_with([simp_tests_commute], defaults := False) }

// A default does not hold what the goal needs: the report is the route and
// the sets that were used, each with the type that brought it.
// expect-error: tried the set `Nat::arith`: the default of `Nat`, which the goal has a value of
theorem default_falls_short(a, b: Nat): a + b = b + a { by simp() }

// expect-error: `simp`: the two sides do not meet
theorem default_report(a, b: Nat): a + b = b + a { by simp() }

// A window of count 0 at a neutral list: `take`/`drop` recurse on the list
// first, so these are laws in `List::shape`, not conversions.
theorem defaults_zero_window<A>(xs, ys: List<A>): xs.take(0) ++ ys.drop(0) = ys { by simp() }

// No type in the goal has a default: said, not a silent empty run.
// expect-error: no type in the goal has a default set here, and the call names none
theorem no_default(a, b: Bool): a = b { by simp() }

// A type's default is not used at a goal without a value of the type:
// `Nat::add_left_zero` is in `Nat::arith`, which a goal about Booleans
// does not get.
// expect-error: tried sets: none
theorem defaults_follow_the_goal(a: Bool): (a && True) = (True && a) { by simp() }

// ---------------------------------------------------------------------------
// `by simp_check([S, …])`: sets held to the checks of a rewrite system
// (docs/tactics/simp-design.md §4), as far as running them shows.

// Sets from different modules, checked for use together.
theorem defaults_together(): True { by simp_check([simp_nat_arith, simp_list_shape, simp_regex_same]) }

// A commuting law loops on its own statement.
// expect-error: these laws have no normal form at an instance of law 1 `add_comm`
theorem commuting_set(): True { by simp_check([simp_tests_commute]) }

// Two laws for one left side whose results do not join: the report gives
// the two normal forms, which is the equation to add.
theorem len_append_swapped<A>(xs, ys: List<A>): (xs ++ ys).len() = ys.len() + xs.len() {
    rewrite(List::len_append(xs, ys), Nat::add_comm(xs.len(), ys.len()))
}

register def simp_tests_overlap: SimpSet = simp_set("simp_tests::overlap", [name_of(List::len_append), name_of(len_append_swapped)]);

// expect-error: law 2 `len_append_swapped` overlaps another law, and the two results do not join
theorem overlapping_set(): True { by simp_check([simp_tests_overlap]) }

// ---------------------------------------------------------------------------
// Laws between statements, `P ↔ Q` (docs/tactics/simp-design.md §12): the goal
// itself, the operands of `∧`, `∨`, `↔`, `¬` and `→`, and the body of a `∀`.

theorem iff_law(P, Q: Type, h: P ↔ Q, q: Q): P { simp_only(h, then := q) }

theorem iff_in_and(P, Q, R: Type, h: P ↔ Q, q: Q, r: R): R ∧ P { simp_only(h, then := And(r, q)) }

theorem iff_in_or_not(P, Q, R: Type, h: P ↔ Q, nq: ¬Q): ¬P ∨ R { simp_only(h, then := Inl(nq)) }

theorem iff_in_premise(P, Q, R: Type, h: P ↔ Q, f: Q → R): P → R { simp_only(h, then := f) }

// Both sides of a goal that is itself `↔` are rewritten, and it closes
// where they meet.
theorem iff_both_sides(P, Q, R: Type, h: P ↔ Q): (P ∧ R) ↔ (Q ∧ R) { simp_only(h) }

// The done-when of issues/simp-iff-laws.md: an unapplied law, instantiated
// at each position it matches.
theorem mem_three<A>(xs, ys, zs: List<A>, a: A): Mem(a, (xs ++ ys) ++ zs) ↔ (Mem(a, xs) ∨ Mem(a, ys)) ∨ Mem(a, zs) {
    simp_only(List::mem_append_iff)
}

theorem mem_then<A>(xs, ys: List<A>, a: A, m: Mem(a, ys)): Mem(a, xs ++ ys) {
    simp_only(List::mem_append_iff, then := Inr(m))
}

theorem mem_using<A>(xs, ys: List<A>, a: A, m: Mem(a, xs ++ ys)): Mem(a, xs) ∨ Mem(a, ys) {
    simp_only(List::mem_append_iff, using := m)
}

// Below a `∀` the instance mentions the bound variable.
theorem mem_forall<A>(xs, ys: List<A>, f: (a: A) → Mem(a, xs) ∨ Mem(a, ys)): (a: A) → Mem(a, xs ++ ys) {
    simp_only(List::mem_append_iff, then := f)
}

// A left side that is a connective over statement variables, matched
// operand by operand; and one that is an equation, matched side by side.
theorem and_true_iff<P>(): P ∧ True ↔ P { Iff(mp := λ (h: P ∧ True) => h.left, mpr := λ (p: P) => And(p, trivial)) }
theorem true_and_iff<P>(): True ∧ P ↔ P { Iff(mp := λ (h: True ∧ P) => h.right, mpr := λ (p: P) => And(trivial, p)) }
theorem and_comm_iff<P, Q>(): P ∧ Q ↔ Q ∧ P { Iff(mp := λ (h: P ∧ Q) => and_swap(h), mpr := λ (h: Q ∧ P) => and_swap(h)) }
theorem succ_eq_iff(a, b: Nat): Succ(a) = Succ(b) ↔ a = b {
    Iff(mp := λ (e: Succ(a) = Succ(b)) => Nat::succ_inj(a, b, e), mpr := λ (e: a = b) => Nat::cong_succ(e))
}

theorem statement_variables(R, S: Type, r: R, s: S): (True ∧ R) ∧ (S ∧ True) {
    simp_only(and_true_iff, true_and_iff, then := And(r, s))
}

theorem equation_sides(x, y: Nat, R: Type, r: R, e: x = y): R ∧ Succ(Succ(x)) = Succ(Succ(y)) {
    simp_only(succ_eq_iff, then := And(r, e))
}

// A side condition is a hypothesis in scope, as for an equation.
theorem mem_append_nonempty<A>(xs, ys: List<A>, a: A, ne: ¬(xs = Nil)): Mem(a, xs ++ ys) ↔ Mem(a, xs) ∨ Mem(a, ys) {
    xs.mem_append_iff(ys, a)
}
theorem iff_side_condition<A>(xs, ys: List<A>, a: A, ne: ¬(xs = Nil), m: Mem(a, ys)): Mem(a, xs ++ ys) {
    simp_only(mem_append_nonempty, then := Inr(m))
}
// expect-error: its side condition `xs = [] -> False` is not a hypothesis here
theorem iff_side_condition_missing<A>(xs, ys: List<A>, a: A, m: Mem(a, ys)): Mem(a, xs ++ ys) {
    simp_show(mem_append_nonempty)
}

// The route names each instance where it was found, a bound variable
// included.
// expect-error: 1. `List::mem_append_iff`: `Mem(x, xs ++ ys)` ⟶ `Or<Mem(x, xs), Mem(x, ys)>`
theorem iff_route<A>(xs, ys: List<A>): (a: A) → Mem(a, xs ++ ys) → Mem(a, ys ++ xs) {
    simp_show(List::mem_append_iff)
}

// Two laws that undo each other loop, as two equations do.
// expect-error: these laws loop: step 2 returns to the goal as written
theorem iff_loop(P, Q: Type, h: P ↔ Q, g: Q ↔ P, q: Q): P { simp_only(h, g, then := q) }

// An equation or a relation step reaches the same positions: an operand of
// a connective is below a binder of the connective's lowering, where the
// equation form's own motive does not look.
theorem equation_in_and<A>(zs: List<A>, a: A, m: Mem(a, zs)): Mem(a, zs ++ Nil) ∧ Mem(a, (zs ++ Nil) ++ Nil) {
    simp_only(List::append_nil, then := And(m, m))
}

theorem equation_in_iff<A>(zs: List<A>, a: A): Mem(a, zs ++ Nil) ↔ Mem(a, zs) { simp_only(List::append_nil) }

theorem equation_below_forall<A>(zs: List<A>, f: (a: A) → Mem(a, zs)): (a: A) → ¬¬Mem(a, zs ++ Nil) {
    simp_only(List::append_nil, then := λ (a: A) (n: ¬Mem(a, zs)) => n(f(a)))
}

theorem equation_using<A>(zs: List<A>, a: A, R: Type, h: R ∨ Mem(a, zs ++ Nil)): R ∨ Mem(a, zs) {
    simp_only(List::append_nil, using := h)
}

theorem equations_and_statements<A>(xs, ys: List<A>, a: A, m: Mem(a, xs)): Mem(a, (xs ++ Nil) ++ ys) {
    simp_only(List::append_nil, List::mem_append_iff, then := Inl(m))
}

// `List`'s default set has the membership law, and the types inside a
// statement bring their defaults.
theorem mem_by_default<A>(xs, ys, zs: List<A>, a: A): Mem(a, (xs ++ ys) ++ (zs ++ Nil)) ↔ Mem(a, xs) ∨ (Mem(a, ys) ∨ Mem(a, zs)) {
    by simp()
}

// A set of laws between statements is checked as any other.
register def simp_tests_units: SimpSet = simp_set("simp_tests::units", [name_of(and_true_iff), name_of(true_and_iff)]);
theorem simp_tests_units_checked(): True { by simp_check([simp_tests_units]) }

register def simp_tests_and_comm: SimpSet = simp_set("simp_tests::and_comm", [name_of(and_comm_iff)]);
// expect-error: rewriting its own statement loops
theorem simp_tests_and_comm_checked(): True { by simp_check([simp_tests_and_comm]) }

// Below an `∃`: the predicate's body is a statement one binder down.
theorem below_exists<A>(xs, ys: List<A>, w: Exists(λ (a: A) => Mem(a, xs) ∨ Mem(a, ys))): Exists(λ (a: A) => Mem(a, xs ++ ys)) {
    simp_only(List::mem_append_iff, then := w)
}

theorem below_exists_both<A>(xs, ys: List<A>): Exists(λ (a: A) => Mem(a, xs ++ ys)) ↔ Exists(λ (a: A) => Mem(a, xs) ∨ Mem(a, ys)) {
    simp_only(List::mem_append_iff)
}

theorem equation_below_exists<A>(xs: List<A>, R: Type): R ∧ Exists(λ (a: A) => Mem(a, xs ++ Nil)) ↔ R ∧ Exists(λ (a: A) => Mem(a, xs)) {
    simp_only(List::append_nil)
}

theorem below_two_exists<A>(xs, ys: List<A>, w: Exists<A>(λ (a: A) => Exists<A>(λ (b: A) => a = b ∧ (Mem(b, xs) ∨ Mem(b, ys))))):
    Exists<A>(λ (a: A) => Exists<A>(λ (b: A) => a = b ∧ Mem(b, xs ++ ys)))
{
    simp_only(List::mem_append_iff, then := w)
}

// The default sets of a type met only inside an `∃`: the host's view of
// `Exists(P)` presents `P`, which `by simp()` enters.
theorem defaults_below_exists<A>(xs, ys: List<A>):
    Exists(λ (a: A) => Mem(a, xs ++ (ys ++ Nil))) ↔ Exists(λ (a: A) => Mem(a, xs) ∨ Mem(a, ys))
{
    by simp()
}

// expect-error: 1. `List::mem_append_iff`: `Mem(x, xs ++ ys)` ⟶ `Or<Mem(x, xs), Mem(x, ys)>`
theorem below_exists_route<A>(xs, ys: List<A>): Exists(λ (a: A) => Mem(a, xs ++ ys)) → False {
    simp_show(List::mem_append_iff)
}

// The result line spells a type's arguments that mention the bound
// variable in full, at the binder's own scope
// (issues/type-arguments-under-a-binder-print-elided.md).
// expect-error: ((x: A) -> Or<Mem(x, xs), Mem(x, ys)>) -> False
theorem below_forall_result<A>(xs, ys: List<A>): ((a: A) → Mem(a, xs ++ ys)) → False {
    simp_show(List::mem_append_iff)
}

// expect-error: (λ (x: A) => Or<Mem(x, xs), Mem(x, ys)>) -> False
theorem below_exists_result<A>(xs, ys: List<A>): Exists(λ (a: A) => Mem(a, xs ++ ys)) → False {
    simp_show(List::mem_append_iff)
}

theorem mulcomm4_s11(): check(mulcomm4_f10(), mulcomm4_c11()) = True { refl }
theorem mulcomm4_refuted(v: Nat → Bool): all_true(mulcomm4_cnf(), v) = False {
    match e: all_true(mulcomm4_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(mulcomm4_f0(), v) = j(mulcomm4_f0_is(), λ g _ => Holds(g, v), holds_formula_from(mulcomm4_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(mulcomm4_f1(), v) = adds_sound(mulcomm4_f0(), v, h0, mulcomm4_c1(), mulcomm4_s1());
            let h2: Holds(mulcomm4_f2(), v) = adds_sound(mulcomm4_f1(), v, h1, mulcomm4_c2(), mulcomm4_s2());
            let h3: Holds(mulcomm4_f3(), v) = adds_sound(mulcomm4_f2(), v, h2, mulcomm4_c3(), mulcomm4_s3());
            let h4: Holds(mulcomm4_f4(), v) = adds_sound(mulcomm4_f3(), v, h3, mulcomm4_c4(), mulcomm4_s4());
            let h5: Holds(mulcomm4_f5(), v) = adds_sound(mulcomm4_f4(), v, h4, mulcomm4_c5(), mulcomm4_s5());
            let h6: Holds(mulcomm4_f6(), v) = adds_sound(mulcomm4_f5(), v, h5, mulcomm4_c6(), mulcomm4_s6());
            let h7: Holds(mulcomm4_f7(), v) = adds_sound(mulcomm4_f6(), v, h6, mulcomm4_c7(), mulcomm4_s7());
            let h8: Holds(mulcomm4_f8(), v) = j(mulcomm4_f8_is(), λ g _ => Holds(g, v), adds_sound(mulcomm4_f7(), v, h7, mulcomm4_c8(), mulcomm4_s8()));
            let h9: Holds(mulcomm4_f9(), v) = adds_sound(mulcomm4_f8(), v, h8, mulcomm4_c9(), mulcomm4_s9());
            let h10: Holds(mulcomm4_f10(), v) = adds_sound(mulcomm4_f9(), v, h9, mulcomm4_c10(), mulcomm4_s10());
            false_elim(check_sound(mulcomm4_f10(), v, h10, mulcomm4_c11(), mulcomm4_s11()))
        },
    }
}
theorem mulcomm4_cnf_is(): BVPred::clauses(mulcomm4(), 8) = mulcomm4_cnf() { refl }
theorem mulcomm4_holds(bits: Nat → Bool): BVPred::eval(mulcomm4(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(mulcomm4(), 8, λ v => j(sym(mulcomm4_cnf_is()), λ g _ => all_true(g, v) = False, mulcomm4_refuted(v)), bits)
}


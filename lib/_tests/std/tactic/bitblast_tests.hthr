// ---------------------------------------------------------------------------
// From the predicate to the words: lay `x` and `y` out as the input bits and
// read each `BVar` back.

fn lay8(x, y: BitVec(8)) → Nat → Bool { λ k => Succ(k).leb(16) && BitVec::pair_bits(x, y)(k) }

theorem addcomm8_word(x, y: BitVec(8)): x + y = y + x {
    let wx = window(lay8(x, y), 0, 8, n := 8);
    let low: (wx = x) = BitVec::pair_window_low(8, x, y);
    let high: (window(lay8(x, y), 8, 8, n := 8) = y) = BitVec::pair_window_high(8, x, y);
    let held: ((wx + y).eq_bit(y + wx) = True) = j(high, λ b _ => (wx + b).eq_bit(b + wx) = True, addcomm8_holds(BitVec::pair_bits(x, y)));
    BitVec::eq_of_eq_bit(8, x + y, y + x, j(low, λ a _ => (a + y).eq_bit(y + a) = True, held))
}

theorem demorgan8_word(x, y: BitVec(8)): x.band(y).complement() = x.complement().bor(y.complement()) {
    let wx = window(lay8(x, y), 0, 8, n := 8);
    let low: (wx = x) = BitVec::pair_window_low(8, x, y);
    let high: (window(lay8(x, y), 8, 8, n := 8) = y) = BitVec::pair_window_high(8, x, y);
    let held: (wx.band(y).complement().eq_bit(wx.complement().bor(y.complement())) = True) =
        j(high, λ b _ => wx.band(b).complement().eq_bit(wx.complement().bor(b.complement())) = True, demorgan8_holds(BitVec::pair_bits(x, y)));
    BitVec::eq_of_eq_bit(8, x.band(y).complement(), x.complement().bor(y.complement()),
        j(low, λ a _ => a.band(y).complement().eq_bit(a.complement().bor(y.complement())) = True, held))
}

// ---------------------------------------------------------------------------
// Negative controls.

// A false predicate's clauses have no refutation: at `x = 0, y = 1` the
// end theorem would make `False` true.
theorem add_left8_never_refuted(): ¬((v: Nat → Bool) → all_true(BVPred::clauses(add_left8(), 16), v) = False) {
    λ unsat => {
        let h: (False = True) = BVPred::unsat_sound(add_left8(), 16, unsat, λ k => k.leb(8) && Nat::leb(8, k));
        absurd(h)
    }
}

// Another predicate's refutation is not this one's.
// expect-error(kernel): the kernel rejected `add_left8_cnf_is`: NotConvertible
theorem add_left8_cnf_is(): BVPred::clauses(add_left8(), 16) = addcomm8_cnf() { refl }

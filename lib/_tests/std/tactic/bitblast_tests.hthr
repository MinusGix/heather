theorem slt_flip8_refuted(v: Nat → Bool): all_true(slt_flip8_cnf(), v) = False {
    match e: all_true(slt_flip8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(slt_flip8_f0(), v) = j(slt_flip8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(slt_flip8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(slt_flip8_f1(), v) = adds_sound(slt_flip8_f0(), v, h0, slt_flip8_c1(), slt_flip8_s1());
            false_elim(check_sound(slt_flip8_f1(), v, h1, slt_flip8_c2(), slt_flip8_s2()))
        },
    }
}
theorem slt_flip8_cnf_is(): BVPred::clauses(slt_flip8(), 16) = slt_flip8_cnf() { refl }
theorem slt_flip8_holds(bits: Nat → Bool): BVPred::eval(slt_flip8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(slt_flip8(), 16, λ v => j(sym(slt_flip8_cnf_is()), λ g _ => all_true(g, v) = False, slt_flip8_refuted(v)), bits)
}

// `scripts/lrat-probes blast concat8 lib/_tests/std/tactic/bitblast_tests.hthr 'concat8()' 16`
// concat8: 1 variables, 2 clauses, 1 steps, 2 hints (cadical)
fn concat8_cnf() → List<List<Nat>> { [[0], [1]] }
fn concat8_f0() → NatMap<List<Nat>> { MNode(None, MNode(Some([0]), MEmpty, MEmpty), MNode(Some([1]), MEmpty, MEmpty)) }
theorem concat8_f0_is(): formula_of(concat8_cnf()) = concat8_f0() { refl }
fn concat8_c1() → List<Step> { [Add(3, [], [1, 2])] }
theorem concat8_s1(): check(concat8_f0(), concat8_c1()) = True { refl }
theorem concat8_refuted(v: Nat → Bool): all_true(concat8_cnf(), v) = False {
    match e: all_true(concat8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(concat8_f0(), v) = j(concat8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(concat8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(concat8_f0(), v, h0, concat8_c1(), concat8_s1()))
        },
    }
}
theorem concat8_cnf_is(): BVPred::clauses(concat8(), 16) = concat8_cnf() { refl }
theorem concat8_holds(bits: Nat → Bool): BVPred::eval(concat8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(concat8(), 16, λ v => j(sym(concat8_cnf_is()), λ g _ => all_true(g, v) = False, concat8_refuted(v)), bits)
}


theorem neg8_s2(): check(neg8_f1(), neg8_c2()) = True { refl }
theorem neg8_refuted(v: Nat → Bool): all_true(neg8_cnf(), v) = False {
    match e: all_true(neg8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(neg8_f0(), v) = j(neg8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(neg8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(neg8_f1(), v) = adds_sound(neg8_f0(), v, h0, neg8_c1(), neg8_s1());
            false_elim(check_sound(neg8_f1(), v, h1, neg8_c2(), neg8_s2()))
        },
    }
}
theorem neg8_cnf_is(): BVPred::clauses(neg8(), 8) = neg8_cnf() { refl }
theorem neg8_holds(bits: Nat → Bool): BVPred::eval(neg8(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(neg8(), 8, λ v => j(sym(neg8_cnf_is()), λ g _ => all_true(g, v) = False, neg8_refuted(v)), bits)
}


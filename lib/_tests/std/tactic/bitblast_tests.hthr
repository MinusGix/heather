theorem demorgan8_f0_is(): formula_of(demorgan8_cnf()) = demorgan8_f0() { refl }
fn demorgan8_c1() → List<Step> { [Add(144, [71, 125], [1, 4]), Add(145, [69], [89, 90, 140, 141, 118]), Add(146, [67], [92, 93, 116, 117, 142]), Add(147, [70], [146, 145, 88]), Add(148, [125], [147, 144]), Add(149, [73], [83, 84, 113, 114, 139]), Add(150, [75], [80, 81, 137, 138, 115]), Add(151, [76], [150, 149, 79]), Add(152, [123], [151, 148, 7]), Add(153, [79], [74, 75, 110, 111, 136]), Add(154, [81], [71, 72, 134, 135, 112]), Add(155, [82], [154, 153, 70]), Add(156, [121], [155, 152, 10]), Add(157, [85], [65, 66, 107, 108, 133]), Add(158, [87], [62, 63, 131, 132, 109]), Add(159, [88], [158, 157, 61]), Add(160, [119], [159, 156, 13]), Add(161, [91], [56, 57, 104, 105, 130]), Add(162, [93], [53, 54, 128, 129, 106]), Add(163, [94], [162, 161, 52]), Add(164, [117], [163, 160, 16]), Add(165, [97], [47, 48, 101, 102, 127]), Add(166, [99], [44, 45, 125, 126, 103]), Add(167, [100], [166, 165, 43]), Add(168, [115], [167, 164, 19]), Add(169, [103], [38, 39, 98, 99, 124]), Add(170, [105], [35, 36, 122, 123, 100]), Add(171, [106], [170, 169, 34]), Add(172, [113], [171, 168, 22]), Add(173, [109], [29, 30, 95, 96, 121]), Add(174, [110], [173, 172, 25]), Add(175, [48], [174, 26]), Add(176, [65], [174, 27]), Add(177, [16], [175, 119]), Add(178, [32], [175, 120]), Add(179, [], [176, 178, 177, 97])] }
theorem demorgan8_s1(): check(demorgan8_f0(), demorgan8_c1()) = True { refl }
theorem demorgan8_refuted(v: Nat → Bool): all_true(demorgan8_cnf(), v) = False {
    match e: all_true(demorgan8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(demorgan8_f0(), v) = j(demorgan8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(demorgan8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(demorgan8_f0(), v, h0, demorgan8_c1(), demorgan8_s1()))
        },
    }
}
theorem demorgan8_cnf_is(): BVPred::clauses(demorgan8(), 16) = demorgan8_cnf() { refl }
theorem demorgan8_holds(bits: Nat → Bool): BVPred::eval(demorgan8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(demorgan8(), 16, λ v => j(sym(demorgan8_cnf_is()), λ g _ => all_true(g, v) = False, demorgan8_refuted(v)), bits)
}


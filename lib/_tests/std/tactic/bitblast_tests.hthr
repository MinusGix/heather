fn mul_shift8_c1() → List<Step> { [Add(3, [], [1, 2])] }
theorem mul_shift8_s1(): check(mul_shift8_f0(), mul_shift8_c1()) = True { refl }
theorem mul_shift8_refuted(v: Nat → Bool): all_true(mul_shift8_cnf(), v) = False {
    match e: all_true(mul_shift8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(mul_shift8_f0(), v) = j(mul_shift8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(mul_shift8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(mul_shift8_f0(), v, h0, mul_shift8_c1(), mul_shift8_s1()))
        },
    }
}
theorem mul_shift8_cnf_is(): BVPred::clauses(mul_shift8(), 8) = mul_shift8_cnf() { refl }
theorem mul_shift8_holds(bits: Nat → Bool): BVPred::eval(mul_shift8(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(mul_shift8(), 8, λ v => j(sym(mul_shift8_cnf_is()), λ g _ => all_true(g, v) = False, mul_shift8_refuted(v)), bits)
}


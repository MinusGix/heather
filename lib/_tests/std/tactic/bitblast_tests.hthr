theorem sext_top8_f0_is(): formula_of(sext_top8_cnf()) = sext_top8_f0() { refl }
fn sext_top8_c1() → List<Step> { [Add(3, [], [1, 2])] }
theorem sext_top8_s1(): check(sext_top8_f0(), sext_top8_c1()) = True { refl }
theorem sext_top8_refuted(v: Nat → Bool): all_true(sext_top8_cnf(), v) = False {
    match e: all_true(sext_top8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(sext_top8_f0(), v) = j(sext_top8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(sext_top8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(sext_top8_f0(), v, h0, sext_top8_c1(), sext_top8_s1()))
        },
    }
}
theorem sext_top8_cnf_is(): BVPred::clauses(sext_top8(), 8) = sext_top8_cnf() { refl }
theorem sext_top8_holds(bits: Nat → Bool): BVPred::eval(sext_top8(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(sext_top8(), 8, λ v => j(sym(sext_top8_cnf_is()), λ g _ => all_true(g, v) = False, sext_top8_refuted(v)), bits)
}


// What the predicates say about words, read back by conversion.
theorem sub_add8_word(x, y: BitVec(8)): (x + y) - y = x {
    let wx = window(lay8(x, y), 0, 8, n := 8);
    let low: (wx = x) = BitVec::pair_window_low(8, x, y);
    let high: (window(lay8(x, y), 8, 8, n := 8) = y) = BitVec::pair_window_high(8, x, y);
    let held: (((wx + y) - y).eq_bit(wx) = True) = j(high, λ b _ => ((wx + b) - b).eq_bit(wx) = True, sub_add8_holds(BitVec::pair_bits(x, y)));
    BitVec::eq_of_eq_bit(8, (x + y) - y, x, j(low, λ a _ => ((a + y) - y).eq_bit(a) = True, held))
}

theorem slt_flip8_bits(x, y: BitVec(8)): BitVec::bool_eq(x.signed_lt_bit(y), x.bxor(BitVec::ofNat(128)).unsigned_lt_bit(y.bxor(BitVec::ofNat(128)))) = True {
    let wx = window(lay8(x, y), 0, 8, n := 8);
    let low: (wx = x) = BitVec::pair_window_low(8, x, y);
    let high: (window(lay8(x, y), 8, 8, n := 8) = y) = BitVec::pair_window_high(8, x, y);
    let held: (BitVec::bool_eq(wx.signed_lt_bit(y), wx.bxor(BitVec::ofNat(128)).unsigned_lt_bit(y.bxor(BitVec::ofNat(128)))) = True) =
        j(high, λ b _ => BitVec::bool_eq(wx.signed_lt_bit(b), wx.bxor(BitVec::ofNat(128)).unsigned_lt_bit(b.bxor(BitVec::ofNat(128)))) = True, slt_flip8_holds(BitVec::pair_bits(x, y)));
    j(low, λ a _ => BitVec::bool_eq(a.signed_lt_bit(y), a.bxor(BitVec::ofNat(128)).unsigned_lt_bit(y.bxor(BitVec::ofNat(128)))) = True, held)
}

// The shape operations convert to the library's own: `concat` is the low
// word zero-extended, or'd with the high one shifted up.
theorem concat8_word(x, y: BitVec(8)): x.concat(y) = x.zero_extend(8).bor(y.zero_extend(8).shift_left(8)) {
    let wx = window(lay8(x, y), 0, 8, n := 8);
    let low: (wx = x) = BitVec::pair_window_low(8, x, y);
    let high: (window(lay8(x, y), 8, 8, n := 8) = y) = BitVec::pair_window_high(8, x, y);
    let held: (wx.concat(y).eq_bit(wx.zero_extend(8).bor(y.zero_extend(8).shift_left(8))) = True) =
        j(high, λ b _ => wx.concat(b).eq_bit(wx.zero_extend(8).bor(b.zero_extend(8).shift_left(8))) = True, concat8_holds(BitVec::pair_bits(x, y)));
    BitVec::eq_of_eq_bit(16, x.concat(y), x.zero_extend(8).bor(y.zero_extend(8).shift_left(8)), j(low, λ a _ => a.concat(y).eq_bit(a.zero_extend(8).bor(y.zero_extend(8).shift_left(8))) = True, held))
}

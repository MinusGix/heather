// Probes of the bit-blaster (lib/std/tactic/bitblast.hthr): predicates over
// words, their clauses refuted by CaDiCaL through `scripts/lrat-probes
// blast`, and what the end theorem then proves about `BitVec`.
import logic;
import bool;
import nat;
import list;
import nat_map;
import lrat;
import bitvec;
import bitblast;

// Two bytes, at offsets 0 and 8.
fn x8() → BVExpr { BVar(0, 8) }
fn y8() → BVExpr { BVar(8, 8) }

fn demorgan8() → BVPred { PEq(8, BNot(BAnd(x8(), y8())), BOr(BNot(x8()), BNot(y8()))) }
fn addcomm8() → BVPred { PEq(8, BAdd(x8(), y8()), BAdd(y8(), x8())) }
fn double8() → BVPred { PEq(8, BAdd(x8(), x8()), BShl(x8(), 1)) }
fn succ_above8() → BVPred { POr(PEq(8, x8(), BConst(255)), PUlt(8, x8(), BAdd(x8(), BConst(1)))) }

// The UTF-8 decoder's tests, on bytes zero-extended to 64 bits
// (examples/utf8/utf8_check.hthr): a continuation byte is `10xxxxxx`, and a
// two-byte sequence is overlong exactly when its lead's payload is below 2.
fn cont64() → BVPred {
    PIff(PEq(64, BAnd(x8(), BConst(192)), BConst(128)),
        PAnd(PEq(64, BAnd(x8(), BConst(128)), BConst(128)), PNot(PEq(64, BAnd(x8(), BConst(64)), BConst(64)))))
}
fn code2() → BVExpr { BAdd(BShl(BAnd(x8(), BConst(31)), 6), BAnd(y8(), BConst(63))) }
fn overlong2() → BVPred { PIff(PUlt(64, code2(), BConst(128)), PEq(64, BAnd(x8(), BConst(30)), BConst(0))) }

// A false predicate: `x + y = x`.
fn add_left8() → BVPred { PEq(8, BAdd(x8(), y8()), x8()) }

// `scripts/lrat-probes blast demorgan8 lib/_tests/std/tactic/bitblast_tests.hthr 'demorgan8()' 16`
// demorgan8: 25 variables, 26 clauses, 1 steps, 2 hints (cadical)
fn demorgan8_cnf() → List<List<Nat>> { [[0], [49, 16], [49, 32], [48, 17, 33], [47, 14], [47, 30], [46, 15, 31], [45, 12], [45, 28], [44, 13, 29], [43, 10], [43, 26], [42, 11, 27], [41, 8], [41, 24], [40, 9, 25], [39, 6], [39, 22], [38, 7, 23], [37, 4], [37, 20], [36, 5, 21], [35, 2], [35, 18], [34, 3, 19], [1]] }
fn demorgan8_f0() → NatMap<List<Nat>> { MNode(None, MNode(Some([0]), MNode(Some([49, 32]), MNode(Some([46, 15, 31]), MNode(Some([41, 24]), MEmpty, MEmpty), MNode(Some([35, 2]), MEmpty, MEmpty)), MNode(Some([43, 10]), MNode(Some([38, 7, 23]), MEmpty, MEmpty), MEmpty)), MNode(Some([47, 14]), MNode(Some([45, 28]), MNode(Some([39, 6]), MEmpty, MEmpty), MNode(Some([34, 3, 19]), MEmpty, MEmpty)), MNode(Some([42, 11, 27]), MNode(Some([37, 20]), MEmpty, MEmpty), MEmpty))), MNode(Some([49, 16]), MNode(Some([48, 17, 33]), MNode(Some([45, 12]), MNode(Some([40, 9, 25]), MEmpty, MEmpty), MNode(Some([35, 18]), MEmpty, MEmpty)), MNode(Some([43, 26]), MNode(Some([37, 4]), MEmpty, MEmpty), MEmpty)), MNode(Some([47, 30]), MNode(Some([44, 13, 29]), MNode(Some([39, 22]), MEmpty, MEmpty), MNode(Some([1]), MEmpty, MEmpty)), MNode(Some([41, 8]), MNode(Some([36, 5, 21]), MEmpty, MEmpty), MEmpty)))) }
theorem demorgan8_f0_is(): formula_of(demorgan8_cnf()) = demorgan8_f0() { refl }
fn demorgan8_c1() → List<Step> { [Add(27, [], [1, 26])] }
theorem demorgan8_s1(): check(demorgan8_f0(), demorgan8_c1()) = True { refl }
theorem demorgan8_refuted(v: Nat → Bool): all_true(demorgan8_cnf(), v) = False {
    match e: all_true(demorgan8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(demorgan8_f0(), v) = j(demorgan8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(demorgan8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(demorgan8_f0(), v, h0, demorgan8_c1(), demorgan8_s1()))
        },
    }
}
theorem demorgan8_cnf_is(): BVPred::clauses(demorgan8(), 16) = demorgan8_cnf() { refl }
theorem demorgan8_holds(bits: Nat → Bool): BVPred::eval(demorgan8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(demorgan8(), 16, λ v => j(sym(demorgan8_cnf_is()), λ g _ => all_true(g, v) = False, demorgan8_refuted(v)), bits)
}


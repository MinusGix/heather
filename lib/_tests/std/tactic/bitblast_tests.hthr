// Probes of the bit-blaster (lib/std/tactic/bitblast.hthr): predicates over
// words, their clauses refuted by CaDiCaL through `scripts/lrat-probes
// blast`, and what the end theorem then proves about `BitVec`.
import logic;
import bool;
import nat;
import list;
import nat_map;
import lrat;
import bitvec;
import bitblast;

// Two bytes, at offsets 0 and 8.
fn x8() → BVExpr { BVar(0, 8) }
fn y8() → BVExpr { BVar(8, 8) }

fn demorgan8() → BVPred { PEq(8, BNot(BAnd(x8(), y8())), BOr(BNot(x8()), BNot(y8()))) }
fn addcomm8() → BVPred { PEq(8, BAdd(x8(), y8()), BAdd(y8(), x8())) }
fn double8() → BVPred { PEq(8, BAdd(x8(), x8()), BShl(x8(), 1)) }
fn succ_above8() → BVPred { POr(PEq(8, x8(), BConst(255)), PUlt(8, x8(), BAdd(x8(), BConst(1)))) }

// The UTF-8 decoder's tests, on bytes zero-extended to 64 bits
// (examples/utf8/utf8_check.hthr): a continuation byte is `10xxxxxx`, and a
// two-byte sequence is overlong exactly when its lead's payload is below 2.
fn cont64() → BVPred {
    PIff(PEq(64, BAnd(x8(), BConst(192)), BConst(128)),
        PAnd(PEq(64, BAnd(x8(), BConst(128)), BConst(128)), PNot(PEq(64, BAnd(x8(), BConst(64)), BConst(64)))))
}
fn code2() → BVExpr { BAdd(BShl(BAnd(x8(), BConst(31)), 6), BAnd(y8(), BConst(63))) }
fn overlong2() → BVPred { PIff(PUlt(64, code2(), BConst(128)), PEq(64, BAnd(x8(), BConst(30)), BConst(0))) }

// A false predicate: `x + y = x`.
fn add_left8() → BVPred { PEq(8, BAdd(x8(), y8()), x8()) }


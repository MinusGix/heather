theorem sub_add8_refuted(v: Nat → Bool): all_true(sub_add8_cnf(), v) = False {
    match e: all_true(sub_add8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(sub_add8_f0(), v) = j(sub_add8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(sub_add8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(sub_add8_f1(), v) = adds_sound(sub_add8_f0(), v, h0, sub_add8_c1(), sub_add8_s1());
            let h2: Holds(sub_add8_f2(), v) = adds_sound(sub_add8_f1(), v, h1, sub_add8_c2(), sub_add8_s2());
            let h3: Holds(sub_add8_f3(), v) = adds_sound(sub_add8_f2(), v, h2, sub_add8_c3(), sub_add8_s3());
            let h4: Holds(sub_add8_f4(), v) = adds_sound(sub_add8_f3(), v, h3, sub_add8_c4(), sub_add8_s4());
            let h5: Holds(sub_add8_f5(), v) = adds_sound(sub_add8_f4(), v, h4, sub_add8_c5(), sub_add8_s5());
            false_elim(check_sound(sub_add8_f5(), v, h5, sub_add8_c6(), sub_add8_s6()))
        },
    }
}
theorem sub_add8_cnf_is(): BVPred::clauses(sub_add8(), 16) = sub_add8_cnf() { refl }
theorem sub_add8_holds(bits: Nat → Bool): BVPred::eval(sub_add8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(sub_add8(), 16, λ v => j(sym(sub_add8_cnf_is()), λ g _ => all_true(g, v) = False, sub_add8_refuted(v)), bits)
}


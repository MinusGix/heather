theorem mulcomm4_s4(): check(mulcomm4_f3(), mulcomm4_c4()) = True { refl }
theorem mulcomm4_refuted(v: Nat → Bool): all_true(mulcomm4_cnf(), v) = False {
    match e: all_true(mulcomm4_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(mulcomm4_f0(), v) = j(mulcomm4_f0_is(), λ g _ => Holds(g, v), holds_formula_from(mulcomm4_cnf(), v, 1, MEmpty, holds_empty(v), e));
            let h1: Holds(mulcomm4_f1(), v) = adds_sound(mulcomm4_f0(), v, h0, mulcomm4_c1(), mulcomm4_s1());
            let h2: Holds(mulcomm4_f2(), v) = adds_sound(mulcomm4_f1(), v, h1, mulcomm4_c2(), mulcomm4_s2());
            let h3: Holds(mulcomm4_f3(), v) = adds_sound(mulcomm4_f2(), v, h2, mulcomm4_c3(), mulcomm4_s3());
            false_elim(check_sound(mulcomm4_f3(), v, h3, mulcomm4_c4(), mulcomm4_s4()))
        },
    }
}
theorem mulcomm4_cnf_is(): BVPred::clauses(mulcomm4(), 8) = mulcomm4_cnf() { refl }
theorem mulcomm4_holds(bits: Nat → Bool): BVPred::eval(mulcomm4(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(mulcomm4(), 8, λ v => j(sym(mulcomm4_cnf_is()), λ g _ => all_true(g, v) = False, mulcomm4_refuted(v)), bits)
}


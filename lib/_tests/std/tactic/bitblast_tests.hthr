theorem addcomm8_refuted(v: Nat → Bool): all_true(addcomm8_cnf(), v) = False {
    match e: all_true(addcomm8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(addcomm8_f0(), v) = j(addcomm8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(addcomm8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(addcomm8_f0(), v, h0, addcomm8_c1(), addcomm8_s1()))
        },
    }
}
theorem addcomm8_cnf_is(): BVPred::clauses(addcomm8(), 16) = addcomm8_cnf() { refl }
theorem addcomm8_holds(bits: Nat → Bool): BVPred::eval(addcomm8(), λ (k: Nat) => Succ(k).leb(16) && bits(k)) = True {
    BVPred::unsat_sound(addcomm8(), 16, λ v => j(sym(addcomm8_cnf_is()), λ g _ => all_true(g, v) = False, addcomm8_refuted(v)), bits)
}

// `scripts/lrat-probes blast double8 lib/_tests/std/tactic/bitblast_tests.hthr 'double8()' 8`
// double8: 1 variables, 2 clauses, 1 steps, 2 hints (cadical)
fn double8_cnf() → List<List<Nat>> { [[0], [1]] }
fn double8_f0() → NatMap<List<Nat>> { MNode(None, MNode(Some([0]), MEmpty, MEmpty), MNode(Some([1]), MEmpty, MEmpty)) }
theorem double8_f0_is(): formula_of(double8_cnf()) = double8_f0() { refl }
fn double8_c1() → List<Step> { [Add(3, [], [1, 2])] }
theorem double8_s1(): check(double8_f0(), double8_c1()) = True { refl }
theorem double8_refuted(v: Nat → Bool): all_true(double8_cnf(), v) = False {
    match e: all_true(double8_cnf(), v) {
        False => refl,
        True => {
            let h0: Holds(double8_f0(), v) = j(double8_f0_is(), λ g _ => Holds(g, v), holds_formula_from(double8_cnf(), v, 1, MEmpty, holds_empty(v), e));
            false_elim(check_sound(double8_f0(), v, h0, double8_c1(), double8_s1()))
        },
    }
}
theorem double8_cnf_is(): BVPred::clauses(double8(), 8) = double8_cnf() { refl }
theorem double8_holds(bits: Nat → Bool): BVPred::eval(double8(), λ (k: Nat) => Succ(k).leb(8) && bits(k)) = True {
    BVPred::unsat_sound(double8(), 8, λ v => j(sym(double8_cnf_is()), λ g _ => all_true(g, v) = False, double8_refuted(v)), bits)
}


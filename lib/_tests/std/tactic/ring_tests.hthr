// Probes of the `ring` tactic (`lib/std/tactic/ring.hthr`,
// `docs/ring-normalization-design.md`): identities it proves, at `Int` and
// `Nat`, in checking positions, and from hypotheses combined with
// multipliers it finds, and modulo `≈` at `Rat` and `CReal`. Tests, not
// library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5). Moved from
// crates/elab/tests/lib_std_ring.rs; the refusals stay there, except the
// ones at a `≈` carrier, which are below.
import logic; import nat; import int; import list; import omega; import ring;
import relation_props; import semiring; import rat; import creal;

// Identities at `Int`, over neutral atoms and closed numerals.
theorem squares(a, b: Int): (a + b) * (a - b) = a * a - b * b { ring }
theorem negation(a, b: Int): -(a - b) * -b = a * b + -(b * b) { ring }
theorem seven(a, c, r, p, q: Int): (a * (c * r)) * ((p * q) * (p * r)) = ((a * c) * (p * r)) * (p * (q * r)) { ring }
// Closed numerals fold; a neutral factor beside them stays an atom.
theorem literal(): OfNat(2) * OfNat(3) - OfNat(7) = NegSucc(0) { ring }
theorem scaled(a: Int): (a + OfNat(2)) * OfNat(3) = OfNat(3) * a + OfNat(6) { ring }
// Atoms are whatever is not ring syntax, here applications that mention a
// function parameter.
theorem applied(f: Int → Int, x, y: Int): (f(x) + f(y)) * f(x) = f(x) * f(x) + f(y) * f(x) { ring }

// Identities at `Nat`; `Succ(x)` is read as `x + 1`, and computes back to it.
theorem nat_square(x, y: Nat): (x + y) * (x + y) = x * x + 2 * (x * y) + y * y { ring }
theorem nat_succ(x: Nat): Succ(x) * Succ(x) = x * x + 2 * x + 1 { ring }
theorem nat_closed(): 3 * 4 + 1 = 13 { ring }

// Checking positions: a `let`, a `calc` step, a match arm (whose atoms are
// the pattern's variables), and under a binder `x` that shadows the
// parameter `x` the hypothesis is about.
theorem by_let(a, b: Int): a * b * a = a * a * b {
    let swapped: (a * b * a = b * (a * a)) = ring;
    trans(swapped, b.mul_comm(a * a))
}
theorem by_calc(a, b: Int): (a + b) * (a + b) = a * a + (a * b + a * b) + b * b {
    calc {
        (a + b) * (a + b)
            = a * (a + b) + b * (a + b) := ring,
            = a * a + (a * b + a * b) + b * b := ring,
    }
}
theorem by_arm(xs: List<Int>): List<Int> → OfNat(0) = OfNat(0) {
    match xs {
        Nil => λ ys => refl,
        Cons(h, _) => λ ys => {
            let fact: (h * h - h * h = OfNat(0)) = ring;
            refl
        },
    }
}
theorem shadowed(x, y: Int, h: x = y): (w: Int) → w * x = w * y { λ x => ring(h) }

// `ring(h, …)`: a substitution; cross-multiplication, each hypothesis scaled
// by the other side's factors; a chain, one link per round; a hypothesis
// that is not needed; a proof that is not a name.
theorem substituted(a, b, c: Int, h: a = b + c): a * a = b * b + OfNat(2) * b * c + c * c { ring(h) }
theorem crossed(a, p, q, a2, p2, q2: Int, h: a * p2 = a2 * p): (a * q) * (p2 * q2) = (a2 * q2) * (p * q) { ring(h) }
theorem chained(s, d, e, p, q, r: Int, h1: d = p * e, h2: e = q * r): s * d = s * p * q * r { ring(h1, h2) }
theorem unused(a, b: Int, h: a = b): a * b = b * a { ring(h) }
theorem by_lemma(a, b, c: Int): a * (b * c) = c * (b * a) { ring(a.mul_comm(b)) }
theorem at_nat(x, y: Nat, h: x = y + 1): x * x = y * y + 2 * y + 1 { ring(h) }

// A defined proposition, as goal and as hypothesis.
fn Square(a, b: Int) → Type { a * a = b }
theorem defined_goal(x, y: Int): Square(x + y, x * x + OfNat(2) * x * y + y * y) { ring }
theorem defined_hypothesis(x, y: Int, h: Square(x, y)): x * x * x = y * x { ring(h) }

// A `ring` fact handed to `omega`.
theorem mixed(a, b, c: Int, h: a * b * c <= OfNat(5)): c * (b * a) + OfNat(1) <= OfNat(6) {
    let same: (c * (b * a) = a * b * c) = ring;
    omega
}

// An unused hypothesis is still checked: the right one passes
// (crates/elab/tests/lib_std_ring.rs refuses the wrong one).
record Q { a: Int, h: a = OfNat(3) }
theorem unused_right(a, b: Int): a * b = b * a { ring(Q(OfNat(3), refl).h) }

// A local named `ring` is the local.
theorem local_ring(a: Int, ring: a = a): a = a { ring }

// Modulo `≈` (issues/ring-modulo-a-relation.md): a goal at `Rat` is
// normalized at `Rat`, its atoms `Rat` values and its numerals the
// coefficients `Rat::ofInt` reads back to; subtraction and negation are the
// carrier's. No denominator fact is handed in.
theorem rat_distrib(x, y, z: Rat): x * (y + z) ≈ x * y + x * z { ring }
theorem rat_square(x, y: Rat): (x + y) * (x + y) ≈ x * x + 2 * x * y + y * y { ring }
theorem rat_squares(x, y: Rat): (x + y) * (x - y) ≈ x * x - y * y { ring }
theorem rat_signs(x, y: Rat): -(x - y) * -y ≈ x * y - y * y { ring }
theorem rat_numerals(x: Rat): 3 * x - x + 0 ≈ 2 * x { ring }
theorem rat_closed(x: Rat): 2 * 3 - 7 + x ≈ x - 1 { ring }
// Atoms are whatever is not ring syntax: a call, an application.
theorem rat_atoms(n: Nat, f: Rat → Rat): (f(1) + Rat::inv_succ(n)) * f(1) ≈ f(1) * f(1) + f(1) * Rat::inv_succ(n) { ring }
// In a `calc` step.
theorem rat_by_calc(x, y: Rat): (x + y) * (x + y) - y * y ≈ x * (x + 2 * y) {
    calc {
        (x + y) * (x + y) - y * y
            ≈ x * x + 2 * x * y := ring,
            ≈ x * (x + 2 * y) := ring,
    }
}
// `ring(h, …)` with `≈` hypotheses at the same carrier: multipliers found as
// at `Int`, combined in the ring.
theorem rat_substituted(a, b, c: Rat, h: a ≈ b + c): a * a ≈ b * b + 2 * b * c + c * c { ring(h) }
theorem rat_chained(s, d, e, p, q, r: Rat, h1: d ≈ p * e, h2: e ≈ q * r): s * d ≈ s * p * q * r { ring(h1, h2) }
theorem rat_respects(x, x2, y, y2: Rat, hx: x ≈ x2, hy: y ≈ y2): x * y + x ≈ x2 * y2 + x2 { ring(hx, hy) }
// Hypotheses about the representation are not `≈` at `Rat`, so the goal is
// read through its cross-multiplication, as before the relation reading.
theorem rat_unfolded(x, y: Rat): x + y ≈ y + x { ring(x.den_add(y), y.den_add(x)) }

// The same at `CReal`, whose `≈` does not unfold to an equation: only the
// relation reading proves anything there.
theorem creal_distrib(x, y, z: CReal): (x + y) * z ≈ x * z + y * z { ring }
theorem creal_square(x, y: CReal): (x - y) * (x - y) ≈ x * x - 2 * x * y + y * y { ring }
theorem creal_numerals(x: CReal): (x + 1) * (x + 1) - 1 ≈ x * (x + 2) { ring }
theorem creal_substituted(x, x2, y: CReal, h: x ≈ x2): x * y + y ≈ (x2 + 1) * y { ring(h) }

// What `ring` refuses modulo `≈`: a non-identity, named by its residual in
// the carrier's terms; a combination the hypotheses do not give.
// expect-error: differ by `2 * x * y`
theorem rat_not_identity(x, y: Rat): (x + y) * (x + y) ≈ x * x + y * y { ring }
// expect-error: no combination
theorem creal_no_combination(x, y: CReal, h: x ≈ y): x * x ≈ y { ring(h) }

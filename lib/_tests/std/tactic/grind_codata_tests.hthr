// grind over codata observations: a side's head normal form, read once the
// graph as written proves nothing (docs/grind-design.md §14.4). A module of
// its own: with `coitree` in scope every grind call in a module costs
// several times more (issues/grind-closure-cost.md), which put the main
// probe module over its CPU rail.
import logic; import bool; import nat; import list; import option; import tactic; import grind; import itree; import coitree;

// An observation that computes to a constructor's value, one stuck
// observation spelled twice, and a corecursive tree observed.
theorem reduct_observed<R>(E: Events, t: CoTree<R>(E), r: R, e: CoTree::obs(E, CTau(t)) = ORet(r)): False { by grind() }
theorem reduct_stuck<R>(E: Events, t: CoTree<R>(E), r: R, e: CoTree::obs(E, t) = ORet(r), f: CoTree::obs(E, t) = OTau(t)): False { by grind() }
theorem reduct_spin<R>(E: Events, r: R, e: CoTree::obs(E, CoTree::spin<R>(E)) = ORet(r)): False { by grind() }

// Not yet: a reduct's field is its spelling, not the local it came from
// (issues/grind-reduct-fields.md).
// expect-error: grind: the two sides are not in one class
theorem reduct_field_unread<R>(E: Events, t, u: CoTree<R>(E), e: CoTree::obs(E, CTau(t)) = OTau(u)): u = t { by grind() }

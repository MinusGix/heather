// Probes of `lib/std/tactic/wlog.hthr`: `wlog` on symmetric goals at the
// carriers that state a `wlog_le`, and its refusals. Tests, not library:
// nothing outside lib/_tests imports this module (docs/test-value-audit.md
// §4.5).
import logic; import nat; import int; import rat; import dyadic; import creal; import ring; import omega; import tactic; import wlog;

// The two cases are unannotated terms, checked where the lemma puts them:
// `h` is the goal at `(a, b)`, `le` the order the main case may assume.
theorem nat_add_comm(m, n: Nat): m + n = n + m {
    by wlog(m, n, λ a b h => sym(h), λ a b le => a.add_comm(b))
}
theorem int_add_comm(m, n: Int): m + n = n + m {
    by wlog(m, n, λ a b h => sym(h), λ a b le => a.add_comm(b))
}

// Under binders and beside a `let`: the goal is the body under `λ m n`, and
// the cases see the `let` as the proof around them does.
theorem under_lambda(k: Nat): (m, n: Nat) → k + (m + n) = k + (n + m) {
    let j = k;
    λ m n => by wlog(m, n, λ a b h => sym(h), λ a b le => cong(f := λ (t: Nat) => j + t, p := a.add_comm(b)))
}

// A goal a definition states, its points bound by the `λ` that opens it:
// their type is the definition's spelling until it is decoded.
fn SymSum(f: Nat → Nat) → Type { (m, n: Nat) → f(m) + f(n) = f(n) + f(m) }
theorem sym_sum(f: Nat → Nat): SymSum(f) {
    λ m n => by wlog(m, n, λ a b h => sym(h), λ a b le => f(a).add_comm(f(b)))
}

// The order the main case assumes is the lemma's: `a <= b`, never the other
// way round.
theorem order_given(m, n: Nat): m <= n ∨ n <= m {
    by wlog(m, n, λ a b h => match h { Inl(x) => Inr(x), Inr(x) => Inl(x) }, λ a b le => Inl(le))
}

// At `Rat` and `Dyadic`, the same lemma by the same name.
theorem rat_add_comm(m, n: Rat): m + n ≈ n + m {
    by wlog(m, n, λ a b h => Rat::same_sym(h), λ a b le => a.add_comm(b))
}
theorem dyadic_order(m, n: Dyadic): m <= n ∨ n <= m {
    by wlog(m, n, λ a b h => match h { Inl(x) => Inr(x), Inr(x) => Inl(x) }, λ a b le => Inl(le))
}

// Hypotheses about the points, generalized with them: each case takes them
// at its own points, after its own arguments, in the order `over` names them.
theorem over_hypotheses(m, n, k: Nat, hm: m <= k, hn: n <= k): m + n <= k + k {
    by wlog(m, n, λ a b h => λ hb ha => { let r = h(ha, hb); omega(r) }, λ a b le => λ ha hb => omega(ha, hb), over := [hm, hn])
}
// Without them the cases see only the original points' hypotheses, which say
// nothing about `a` and `b`.
// expect-error: omega
theorem over_missing(m, n, k: Nat, hm: m <= k, hn: n <= k): m + n <= k + k {
    by wlog(m, n, λ a b h => omega(h), λ a b le => omega(hm, hn))
}

// Signs: the negative case is the nonnegative one through negation.
theorem rat_square(x: Rat): 0 <= x * x {
    by wlog_sign(x, λ a h => { let e: ((-a) * (-a) ≈ a * a) = ring; Rat::le_of_le_of_same(h, e) }, λ a h => Rat::mul_nonneg(h, h))
}
theorem int_add_neg(x: Int): x + -x = 0 {
    by wlog_sign(x, λ a h => { let e = (-a).add_neg(); omega(h) }, λ a h => a.add_neg())
}

// At `CReal`, where `<=` has no decision: the main case is proved below the
// second point up to a tolerance.
theorem creal_add_comm(m, n: CReal): m + n ≈ n + m {
    let one: CReal = 1;
    by wlog_within(m, n, one, CReal::zero_lt_one(), λ a b h => CReal::same_sym(h), λ a b lt => CReal::add_comm(a, b))
}

// A case is checked at its place, and its own error is the one reported:
// the reduction must produce the goal at `(b, a)`, not restate `(a, b)`.
// expect-error: `b + a = a + b` is expected here
theorem swap_not_symmetric(m, n: Nat): m + n = n + m {
    by wlog(m, n, λ a b h => h, λ a b le => a.add_comm(b))
}

// Only a local of the goal's context is abstracted.
// expect-error: only a local of the goal's context
theorem not_a_local(m, n: Nat): (m + 1) + n = n + (m + 1) {
    by wlog(m + 1, n, λ a b h => sym(h), λ a b le => a.add_comm(b))
}

// Probes of `lib/std/algebra/semiring.hthr` at `Nat` and `Int` under
// identity and at `Rat` under `≈` (`issues/semiring-ring-structure-api.md`):
// every structure resolves, the units under the tags are the carriers' own,
// and each layer's theorems apply at their own layer. Tests, not library:
// nothing outside lib/_tests imports this module (docs/test-value-audit.md
// §4.5). Moved from crates/elab/tests/lib_std_semiring.rs; the refusals that
// need the checker stay there.
import logic; import nat; import int; import list; import relation;
import relation_props; import algebra_rel; import algebra; import semiring; import rat;

fn nat_layers() → Nat {
    let a = Nat::CommSemiring(RelId, Nat::add, Nat::mul);
    let b = Nat::Semiring(RelId, Nat::add, Nat::mul);
    let c = Nat::Distributes(RelId, Nat::add, Nat::mul);
    let d = Nat::MonoidRel(RelId, Nat::mul);
    0
}
fn int_layers() → Nat {
    let a = Int::CommRing(RelId, Int::add, Int::mul);
    let b = Int::Ring(RelId, Int::add, Int::mul);
    let c = Int::GroupRel(RelId, Int::add);
    0
}
fn rat_layers() → Nat {
    let a = Rat::CommRing(Rat::Same, Rat::add, Rat::mul);
    let b = Rat::Ring(Rat::Same, Rat::add, Rat::mul);
    let c = Rat::CommSemiring(Rat::Same, Rat::add, Rat::mul);
    0
}
theorem nat_zero(): Nat::Semiring(RelId, Nat::add, Nat::mul).unit = 0 { refl }
theorem nat_one(): Nat::Semiring(RelId, Nat::add, Nat::mul).multiplicative.unit = 1 { refl }
theorem int_neg(x: Int): Int::Ring(RelId, Int::add, Int::mul).inv(x) = -x { refl }
theorem rat_one(): Rat::Ring(Rat::Same, Rat::add, Rat::mul).multiplicative.unit = 1 { refl }
theorem rat_neg(x: Rat): Rat::Ring(Rat::Same, Rat::add, Rat::mul).inv(x) = -x { refl }
// The `≈` of the identity carriers is `=`.
theorem nat_same_is_eq(x, y: Nat, h: x ≈ y): x = y { h }
theorem int_same_is_eq(x, y: Int, h: x = y): x ≈ y { h }

// Each layer's theorems at their own layer: signs at a ring, a split product
// at a commutative semiring, a split sum at any semiring, and a constant
// factor out of a sum at a semiring.
theorem signs<A: Ring(≈, +, *)>(x, y: A): A.inv(x) * y ≈ A.inv(x * y) { Ring::neg_mul(x, y) }
theorem split<A: CommSemiring(≈, +, *), B>(xs: List<B>, f, g: B → A):
    MonoidRel::fold(*, xs.map(λ x => f(x) * g(x))) ≈ MonoidRel::fold(*, xs.map(f)) * MonoidRel::fold(*, xs.map(g))
{
    CommMonoidRel::fold_map_op(≈, *, xs, f, g)
}
theorem split_sum<A: Semiring(≈, +, *), B>(xs: List<B>, f, g: B → A):
    MonoidRel::fold(+, xs.map(λ x => f(x) + g(x))) ≈ MonoidRel::fold(+, xs.map(f)) + MonoidRel::fold(+, xs.map(g))
{
    CommMonoidRel::fold_map_op(≈, +, xs, f, g)
}
theorem sum_distribution<A: Semiring(≈, +, *)>(x: A, ys: List<A>): x ≈ x {
    let s = Semiring::mul_sum_l<A>(x, ys);
    A.rel_refl(x)
}

// At `Rat` a ring law holds modulo `≈`.
theorem rat_signs(x, y: Rat): -x * -y ≈ x * y { Ring::neg_mul_neg(x, y) }

// ---------------------------------------------------------------------------
// One theorem library (docs/library/relation-indexed-algebra-design.md): `algebra`'s
// identity classes are `algebra_rel`'s at `RelId`, so a relational theorem is
// spent at an identity structure and at an unreduced one alike.

// The fold's append law at `Nat` under `+`, reached from the identity
// `CommMonoid<Nat>(add)`'s registered parent, and at `Rat` modulo `Rat::Same`.
theorem nat_fold_append(xs, ys: List<Nat>):
    MonoidRel::fold(Nat::add, xs ++ ys) = MonoidRel::fold(Nat::add, xs) + MonoidRel::fold(Nat::add, ys)
{
    MonoidRel::fold_append(Nat::add, xs, ys)
}
theorem rat_fold_append(xs, ys: List<Rat>):
    MonoidRel::fold(+, xs ++ ys) ≈ MonoidRel::fold(+, xs) + MonoidRel::fold(+, ys)
{
    MonoidRel::fold_append(+, xs, ys)
}
// The product, through the ring's tagged `multiplicative` view at `Rat`.
theorem rat_fold_append_mul(xs, ys: List<Rat>):
    MonoidRel::fold(*, xs ++ ys) ≈ MonoidRel::fold(*, xs) * MonoidRel::fold(*, ys)
{
    MonoidRel::fold_append(*, xs, ys)
}

// The identity fold is the relational one: `mconcat` unfolds to it, so the
// relational law is a law about `sum`.
theorem nat_sum_append(xs, ys: List<Nat>): (xs ++ ys).sum() = xs.sum() + ys.sum() {
    MonoidRel::fold_append(Nat::add, xs, ys)
}

// A generic identity consumer reaches the relational theorem from its own
// `Monoid(op)` binder: the binder proposes `RelId<A>` for the relation.
theorem mconcat_append<A: Monoid(op)>(op as ∙: A → A → A, xs, ys: List<A>):
    (xs ++ ys).mconcat(op) = xs.mconcat(op) ∙ ys.mconcat(op)
{
    MonoidRel::fold_append(op, xs, ys)
}
// …spent at three identity structures, one of them at an open carrier.
theorem int_sum_append(xs, ys: List<Int>): (xs ++ ys).mconcat(Int::mul) = xs.mconcat(Int::mul) * ys.mconcat(Int::mul) {
    mconcat_append(Int::mul, xs, ys)
}
theorem bool_all_append(xs, ys: List<Bool>): (xs ++ ys).all_of() = xs.all_of().and(ys.all_of()) {
    mconcat_append(Bool::and, xs, ys)
}
theorem concat_append<B>(xss, yss: List<List<B>>): (xss ++ yss).concat() = xss.concat() ++ yss.concat() {
    mconcat_append(List::append, xss, yss)
}

// Uniqueness of inverses, one proof: the identity name at `Int`, the
// relational one at `Rat` modulo `≈`.
theorem int_inv_unique(x, y: Int, h: x + y = OfNat(0)): y = -x { op_inv_unique(x, y, h) }
theorem rat_inv_unique(x, y: Rat, h: x + y ≈ 0): y ≈ -x { GroupRel::inv_unique(+, x, y, h) }

// The dictionary views: the identity structure's relational parent is the
// registered relational instance, the very dictionary the ring holds.
theorem nat_views_agree(): Nat::CommMonoid(Nat::add).unit = Nat::CommMonoidRel(RelId, Nat::add).unit { refl }
theorem nat_ring_view(): Nat::CommSemiring(RelId, Nat::add, Nat::mul).multiplicative.unit = Nat::Monoid(Nat::mul).unit { refl }
theorem int_group_view(x: Int): Int::Group(Int::add).inv(x) = Int::GroupRel(RelId, Int::add).inv(x) { refl }

// `-x`, `x - y` and numerals at a ring's carrier
// (issues/class-carrier-arithmetic-surface.md): the designations at `Ring`,
// each one δ-step from the dictionary spelling, and `2` the ring's
// `nat_cast`, which computes to `1 + 1`.
section<R: Ring(≈, +, *)> {

theorem ring_class_negated_difference(x, y: R): -(x - y) ≈ R.inv(x + R.inv(y)) { R.rel_refl(-(x - y)) }
theorem ring_class_two(x: R): 2 ≈ 1 + 1 { R.rel_refl(2) }
theorem ring_class_zero_is_unit(x: R): x + 0 ≈ x { R.unit_r(x) }
theorem ring_class_negative_numeral(x: R): -2 + 2 ≈ 0 { R.inv_l(2) }

}

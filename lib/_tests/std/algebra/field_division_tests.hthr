// Probes of `lib/std/algebra/field_division.hthr`: `x⁻¹` and `a / b` inside
// a section over an ordered field, each divisor's apartness found with
// nothing written (docs/library/division-design.md §6). Tests, not library: nothing
// outside lib/_tests imports this module (docs/test-value-audit.md §4.5).
import logic; import nat; import int; import relation; import order; import algebra_rel; import semiring;
import ordered_field; import field_division; import rat; import ring; import linarith;

section<K: OrderedField(≈, <, <=, +, *)> {

// A local, up to conversion: a sign or the apartness itself.
theorem inv_at_positive(x: K, hx: K.unit < x): x * x⁻¹ ≈ K.multiplicative.unit { OrderedField::mul_inv(x) }
theorem inv_at_negative(x: K, hx: x < K.unit): x * x⁻¹ ≈ K.multiplicative.unit { OrderedField::mul_inv(x) }
theorem inv_at_apart(x: K, hx: ApartBy(<, x, K.unit)): x * x⁻¹ ≈ K.multiplicative.unit { OrderedField::mul_inv(x) }

// The sign rules: sums, products, negation, inverses and quotients of
// numbers with a known sign, squares, and one.
fn div_square_plus_one(a, b: K) → K { a / (b * b + K.multiplicative.unit) }
fn div_sum(a, b, c: K, hb: K.unit < b, hc: K.unit < c) → K { a / (b + c) }
fn div_negation(a, b: K, hb: K.unit < b) → K { a / K.inv(b) }
fn div_inverse_plus_one(a, b: K, hb: K.unit < b) → K { a / (b⁻¹ + K.multiplicative.unit) }
fn div_product(a, b, c: K, hb: b < K.unit, hc: K.unit < c) → K { a / (b * c) }
fn div_quotient(a, b, c: K, hb: b < K.unit, hc: K.unit < c) → K { a / (b / c) }
fn div_one(a: K) → K { a / K.multiplicative.unit }
fn inv_inv(a: K, ha: a < K.unit) → K { a⁻¹⁻¹ }

// `nlinarith` at the leaves, over the caller's hypotheses: a gap (`c - b`
// is `c + K.inv(b)` here), on either side of zero, a product of numbers
// above one, and a gap plus a nonnegative.
fn div_gap(a, b, c: K, h: b < c) → K { a / (c + K.inv(b)) }
fn div_gap_negative(a, b, c: K, h: b < c) → K { a / (b + K.inv(c)) }
fn div_product_above_one(a, b, c: K, hb: K.multiplicative.unit < b, hc: K.multiplicative.unit < c) → K {
    a / (b * c + K.inv(K.multiplicative.unit))
}
fn div_gap_plus_nonneg(a, b, c, e: K, h: b < c, he: K.unit <= e) → K { a / ((c + K.inv(b)) + e) }

// Nothing known about the divisor, and the divisor zero, are refused.
// expect-error: no instance for `Invertible(b)`
fn div_unknown(a, b: K) → K { a / b }
// expect-error: no instance for `Invertible(
fn div_zero(a: K) → K { a / K.unit }

// The laws, at searched proofs.
theorem div_cancel_at_gap(a, b, c: K, h: b < c): a / (c + K.inv(b)) * (c + K.inv(b)) ≈ a {
    OrderedField::div_mul_cancel(a, c + K.inv(b))
}
theorem halves(a, b: K, hb: K.unit < b): a / b + a / b ≈ (a + a) / b {
    K.rel_sym((a + a) / b, a / b + a / b, OrderedField::add_div(a, a, b))
}

// `ring` reads `a / b` as `a * b⁻¹` and `b⁻¹` with its fact `b⁻¹ * b ≈ 1`,
// and `linarith` clears a reciprocal whose denominator a fact signs.
theorem ring_sum_of_quotients(a, b, c: K, hc: K.unit < c): a / c + b / c ≈ (a + b) / c { ring }
theorem ring_cancel(a, c: K, hc: c < K.unit): a / c * c ≈ a { ring }
theorem linarith_quotient_positive(a, c: K, hc: K.unit < c, ha: K.unit < a): K.unit < a / c { linarith }

}

// Numerals and `-` at the section's carrier
// (issues/class-carrier-arithmetic-surface.md): `0` and `1` are the units,
// `2` is the ring's `Ring::nat_cast<K>(2)`, `-x` and `x - y` the class's
// designations, each one δ-step from the dictionary spelling, which `refl`
// and the tactics read alike.
section<K: OrderedField(≈, <, <=, +, *)> {

theorem numeral_neg_cancels(x: K): x + -x ≈ 0 { K.inv_r(x) }
theorem numeral_units(x: K): 0 < 1 { K.zero_lt_one }
theorem numeral_unit_spelling(x: K): K.unit < K.multiplicative.unit { let p: (0 < 1) = K.zero_lt_one; p }
theorem numeral_sub_unfolds(x, y: K): x - y ≈ x + K.inv(y) { K.rel_refl(x + K.inv(y)) }
theorem numeral_led_difference(x: K): 1 - x ≈ K.multiplicative.unit + K.inv(x) { K.rel_refl(1 - x) }
theorem numeral_negative_one(x: K): -1 ≈ K.inv(K.multiplicative.unit) { K.rel_refl(-1) }
theorem numeral_two_is_one_plus_one(x: K): 2 ≈ 1 + 1 { K.rel_refl(2) }
theorem numeral_ring_difference_of_squares(x, y: K): (x - y) * (x + y) ≈ x * x - y * y { ring }
theorem numeral_ring_halves(e: K): e / 2 + e / 2 ≈ e { ring }
theorem numeral_ring_thirds(a, b: K): (a - b) / 3 + b / 3 ≈ a / 3 { ring }
theorem numeral_linarith_half(e: K, he: 0 < e): e / 2 < e { linarith(he) }
theorem numeral_linarith_thirds(a: K, ha: 0 < a): a / 3 < a / 2 { linarith(ha) }
theorem numeral_linarith_neg(a: K, ha: a < 0): 0 < -a { linarith(ha) }
fn numeral_divisor_sign(a, b: K, hb: 0 < b) → K { a / -b }
fn numeral_divisor_gap(a, b, c: K, h: b < c) → K { a / (c - b) }

// A divisor with no source spelling (`c + 1`, whose `+` is the section's
// binder): `ring` reads the quotient and its reciprocal's fact from the terms.
theorem quotient_unspelled_divisor(c, e: K, hc: 0 <= c): c * (e / (c + 1)) + e / (c + 1) ≈ e { ring }
// A reciprocal whose apartness the search built through a rule
// (issues/ring-reciprocal-of-searched-proof.md): its fact is read too.
theorem ring_searched_product_reciprocal(x, y: K, hx: 0 < x, hy: 0 < y): (x * y)⁻¹ * x ≈ y⁻¹ { ring }

}

// A carrier reads the generic laws through its instance: at `Rat`, the
// class's quotient is `Rat`'s own `/` by unfolding.
theorem rat_reads_div_mul_cancel(a, b: Rat, hb: Rat::Lt(0, b)): a / b * b ≈ a {
    OrderedField::div_mul_cancel(a, b, h := Inr(hb))
}

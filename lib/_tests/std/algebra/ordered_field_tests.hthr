// Probes of `lib/std/algebra/ordered_field.hthr` at `Rat` and `CReal`
// (`docs/library/constructive-ordered-field-design.md`): every layer resolves at
// both carriers with the carrier's own operations as its fields, and each
// layer's theorems apply where its structure is. Tests, not library: nothing
// outside lib/_tests imports this module (docs/test-value-audit.md §4.5).
// Moved from crates/elab/tests/lib_std_ordered_field.rs; the refusals that
// need the checker stay there.
import logic; import nat; import int; import omega; import relation_props; import order;
import algebra_rel; import semiring; import ordered_field; import rat; import creal;
import relation; import big_operator; import dyadic;

// Every layer resolves at both carriers, and each field is the carrier's own
// operation, definitionally.
fn rat_layers() → Nat {
    let a = Rat::StrictOrder(Rat::Same, Rat::Lt, Rat::Le);
    let b = Rat::Cotransitive(Rat::Lt);
    let c = Rat::PseudoOrder(Rat::Same, Rat::Lt, Rat::Le);
    let d = Rat::OrderedAddGroup(Rat::Same, Rat::Lt, Rat::Le, Rat::add);
    let f = Rat::LocatedAddGroup(Rat::Same, Rat::Lt, Rat::Le, Rat::add);
    let g = Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul);
    let r = Rat::CommRing(Rat::Same, Rat::add, Rat::mul);
    0
}
fn creal_layers() → Nat {
    let a = CReal::StrictOrder(CReal::Same, CReal::Lt, CReal::Le);
    let b = CReal::Cotransitive(CReal::Lt);
    let c = CReal::PseudoOrder(CReal::Same, CReal::Lt, CReal::Le);
    let d = CReal::OrderedAddGroup(CReal::Same, CReal::Lt, CReal::Le, CReal::add);
    let f = CReal::LocatedAddGroup(CReal::Same, CReal::Lt, CReal::Le, CReal::add);
    let g = CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul);
    let r = CReal::CommRing(CReal::Same, CReal::add, CReal::mul);
    0
}
theorem rat_zero(): Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).unit = 0 { refl }
theorem rat_neg(x: Rat): Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).inv(x) = -x { refl }
theorem rat_recip(x: Rat, h: x.Apart(0)):
    Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).recip(x, h) = x.inv(h := h) { refl }
theorem creal_one(): CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul).multiplicative.unit = 1 { refl }
theorem creal_recip(x: CReal, h: x.Apart(0)):
    CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul).recip(x, h) = x.inv(h := h) { refl }
// `≤` at the reals is Bishop's by definition; at the rationals it is the
// cross-multiplied one, reached through the instance's laws.
theorem creal_le_is_not_lt(x, y: CReal, h: ¬(y < x)): x <= y { h }
theorem rat_le_of_not_lt(x, y: Rat, h: ¬(y < x)): x <= y { Rat::StrictOrder(Rat::Same, Rat::Lt, Rat::Le).le_of_not_lt(x, y, h) }

// A predicate meets its own unfolding wherever it is written: a hypothesis
// of `Close` where `AbsLt` is expected, a bound passed as `Between`, and a
// result checked against the carrier's spelled-out order. The carrier, from
// the first point or a type argument, fills the indices through its
// designations (issues/constrained-predicate-expected-type.md).
theorem close_neg<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e: A, h: Close(x, y, e)): AbsLt(A.inv(x + A.inv(y)), e) {
    OrderedAddGroup::abs_lt_neg(x + A.inv(y), e, h)
}
theorem bound_lt<A: OrderedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): A.inv(e) < e { StrictOrder::between_lt(A.inv(e), x, e, h) }
theorem rat_sum(x, y, e, d: Rat, hx: -e < x ∧ x < e, hy: -d < y ∧ y < d): -(e + d) < x + y ∧ x + y < e + d {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}
theorem creal_within(x, e: CReal, h: -e < x ∧ x < e): -e <= x ∧ x <= e { LocatedAddGroup::abs_le_of_abs_lt(x, e, h) }
theorem rat_le_typed(x, y: Rat, h: x < y): x <= y { StrictOrder::le_of_lt<Rat>(x, y, h) }
theorem creal_le_typed(x, y: CReal, h: x < y): x <= y { StrictOrder::le_of_lt<CReal>(x, y, h) }

// Each layer's theorems at their own layer: `≤` transitivity and a bound's
// positivity at the located ones; antisymmetry, open intervals and the
// triangle inequality need no locatedness at all.
theorem le_transitive<A: PseudoOrder(≈, <, <=)>(x, y, z: A, h1: x <= y, h2: y <= z): x <= z { PseudoOrder::le_trans(x, y, z, h1, h2) }
theorem bound_pos<A: LocatedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): A.unit < e { LocatedAddGroup::abs_lt_pos(x, e, h) }
theorem antisymm<A: StrictOrder(≈, <, <=)>(x, y: A, h1: x <= y, h2: y <= x): x ≈ y { StrictOrder::le_antisymm(x, y, h1, h2) }
theorem triangle<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e, d: A, hx: AbsLt(x, e), hy: AbsLt(y, d)): AbsLt(x + y, e + d) {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}
theorem le_reflexive<A: OrderedField(≈, <, <=, +, *)>(x: A): x <= x { StrictOrder::le_refl(x) }
theorem strict_irrefl<A: OrderedField(≈, <, <=, +, *)>(x: A): ¬(x < x) { A.lt_irrefl(x) }

// The inverse: of one, from `0 < 1`; of a negative, negative; and zero is
// not apart from itself, so no inverse of zero can be written.
fn recip_one<A: OrderedField(≈, <, <=, +, *)>(x: A) → A { A.recip(A.multiplicative.unit, Inr(A.zero_lt_one)) }
theorem neg_recip<A: OrderedField(≈, <, <=, +, *)>(x: A, hx: x < A.unit): A.recip(x, Inl(hx)) < A.unit {
    OrderedField::recip_neg(x, Inl(hx), hx)
}
theorem zero_not_apart<A: OrderedField(≈, <, <=, +, *)>(x: A): ¬(ApartBy(<, A.unit, A.unit)) { StrictOrder::apart_irrefl(A.unit) }

// `Rat` decides `≤` as an extra; the interface does not.
fn rat_decides(x, y: Rat) → x <= y ∨ ¬(x <= y) { x.le_dec(y) }

// The ordered layers extend the algebraic ones
// (issues/ordered-field-over-comm-ring.md): a `GroupRel` theorem applies to an
// ordered group, a `Ring` or `Semiring` theorem to an ordered field, and a
// generic ring theorem lands at `CReal` through its `CommRing` instance.
theorem group_neg_neg<A: OrderedAddGroup(≈, <, <=, +)>(x: A): A.inv(A.inv(x)) ≈ x { GroupRel::inv_inv(+, x) }
theorem field_neg_mul<A: OrderedField(≈, <, <=, +, *)>(x, y: A): A.inv(x) * y ≈ A.inv(x * y) { Ring::neg_mul(x, y) }
theorem field_mul_add_add<A: OrderedField(≈, <, <=, +, *)>(a, b, c, d: A): (a + b) * (c + d) ≈ (a * c + a * d) + (b * c + b * d) {
    Semiring::mul_add_add(a, b, c, d)
}
theorem field_mul_comm<A: OrderedField(≈, <, <=, +, *)>(x, y: A): x * y ≈ y * x { A.commutative.comm(x, y) }
theorem creal_neg_mul_neg(x, y: CReal): -x * -y ≈ x * y { Ring::neg_mul_neg(x, y) }
theorem creal_interchange(a, b, c, d: CReal): (a * b) * (c * d) ≈ (a * c) * (b * d) { CommMonoidRel::interchange(≈, *, a, b, c, d) }

// ---------------------------------------------------------------------------
// Two constraints sharing `≈`, `+` and `*` at one carrier are one dictionary
// (issues/constraints-sharing-indices.md, docs/language/classes/operators-onto-classes-design.md
// §17). `zero_lt_one` is `OrderedField`'s, over its `unit`; `of_int_one` is
// `CommRingOfInt`'s, over its `multiplicative.unit`: they combine only if
// both classes' `CommRing` is one.
theorem both_one_pos<A: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)>(x: A):
    A.unit < A.of_int(OfNat(1))
{
    StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, A.of_int(OfNat(1)),
        A.rel_sym(A.of_int(OfNat(1)), A.multiplicative.unit, A.of_int_one), A.zero_lt_one)
}

// Written in the other order it is the same dictionary, so the call passes it on.
theorem both_one_pos_swapped<A: CommRingOfInt(≈, +, *) + OrderedField(≈, <, <=, +, *)>(x: A):
    A.unit < A.of_int(OfNat(1))
{
    both_one_pos(x)
}

// One parent's lemmas apply through it.
theorem both_of_nat_pos<A: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)>(x: A, n: Nat):
    A.unit < A.of_nat(n + 1)
{
    OrderedField::of_nat_pos(n)
}

// At a concrete carrier the dictionary is assembled from the two instances.
theorem both_at_rat(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_one_pos(q) }
theorem both_at_creal(x: CReal): CReal::Lt(0, CReal::ofRat(Rat::ofInt(OfNat(1)))) { both_one_pos(x) }
theorem both_at_rat_explicit(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_one_pos<Rat>(q) }

// A section's constraint merges the same way.
section<B: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)> {
theorem both_in_section(x: B): B.unit < B.of_int(OfNat(1)) { both_one_pos(x) }
}
theorem both_in_section_at_rat(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_in_section(q) }

// At two carriers the symbols name two things, which §5.1 still refuses.
// expect-error: `≈` is already this declaration's body spelling
theorem two_carriers<A: OrderedField(≈, <, <=, +, *), B: CommRingOfInt(≈, +, *)>(x: A, y: B): x ≈ x {
    A.rel_refl(x)
}

// ---------------------------------------------------------------------------
// The layers below the field (issues/ordered-algebra-api.md,
// docs/library/ordered-algebra-design.md). `Nat` is an ordered semiring and `Int` and
// `Dyadic` ordered rings; the fields are ordered rings too. A theorem stated
// once at its weakest layer reads at each of them.

fn nat_layers() → Nat {
    let a = Nat::StrictOrder(RelId<Nat>, Nat::Lt, Nat::Le);
    let m = Nat::OrderedAddMonoid(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add);
    let l = Nat::LocatedAddMonoid(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add);
    let s = Nat::OrderedSemiring(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add, Nat::mul);
    0
}
fn int_layers() → Nat {
    let g = Int::LocatedAddGroup(RelId<Int>, Int::Lt, Int::Le, Int::add);
    let s = Int::OrderedSemiring(RelId<Int>, Int::Lt, Int::Le, Int::add, Int::mul);
    let r = Int::OrderedRing(RelId<Int>, Int::Lt, Int::Le, Int::add, Int::mul);
    0
}
fn dyadic_layers() → Nat {
    let m = Dyadic::LocatedAddMonoid(Dyadic::Same, Dyadic::Lt, Dyadic::Le, Dyadic::add);
    let r = Dyadic::OrderedRing(Dyadic::Same, Dyadic::Lt, Dyadic::Le, Dyadic::add, Dyadic::mul);
    0
}
fn field_rings() → Nat {
    let q = Rat::OrderedRing(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul);
    let x = CReal::OrderedSemiring(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul);
    0
}

// The semiring's laws are the carriers' own monotone forms.
theorem nat_one(): Nat::OrderedSemiring(RelId<Nat>, Nat::Lt, Nat::Le, Nat::add, Nat::mul).multiplicative.unit = 1 { refl }
theorem int_inv(x: Int): Int::OrderedRing(RelId<Int>, Int::Lt, Int::Le, Int::add, Int::mul).inv(x) = -x { refl }

// Monoid layers at `Nat`: translation both ways, and a sum termwise.
theorem nat_add_lt_cancel(x, y, z: Nat, h: z + x < z + y): x < y { OrderedAddMonoid::add_lt_cancel_l(x, y, z, h) }
theorem nat_add_le_mono(a, b, c, d: Nat, h1: a <= b, h2: c <= d): a + c <= b + d { LocatedAddMonoid::add_le_mono(a, b, c, d, h1, h2) }
theorem nat_range_le(n: Nat, f, g: Nat → Nat, h: (k: Nat) → k < n → f(k) <= g(k)): MonoidRel::range(Nat::add, n, f) <= MonoidRel::range(Nat::add, n, g) {
    LocatedAddMonoid::range_le(n, f, g, h)
}

// Semiring layer at `Nat`, `Int`, `Dyadic` and the fields.
theorem nat_mul_le_mul(a, b, c, d: Nat, h1: a <= b, h2: c <= d, ha: 0 <= a, hc: 0 <= c): a * c <= b * d {
    OrderedSemiring::mul_le_mul(a, b, c, d, h1, h2, ha, hc)
}
theorem nat_pos_of_mul_pos(z, d: Nat, h: 0 < z * d): 0 < d { OrderedSemiring::pos_of_mul_pos_nonneg(z, d, trivial, h) }
theorem int_mul_le_mono(x, y, z: Int, h: x <= y, hz: OfNat(0) <= z): z * x <= z * y { OrderedSemiring::mul_le_mono_l(x, y, z, h, hz) }
theorem dyadic_mul_pos(x, y: Dyadic, hx: 0 < x, hy: 0 < y): 0 < x * y { OrderedSemiring::mul_pos(x, y, hx, hy) }
theorem rat_mul_cancel(x, y, z: Rat, hz: 0 < z, h: x * z < y * z): x < y { OrderedSemiring::mul_lt_cancel_r(x, y, z, hz, h) }

// Ring layer: the sign of a square, at a carrier with no field.
theorem int_sq_nonneg(x: Int): OfNat(0) <= x * x { OrderedRing::sq_nonneg(x) }
theorem dyadic_sq_nonneg(x: Dyadic): 0 <= x * x { OrderedRing::sq_nonneg(x) }
theorem int_abs_add(x, y, e, d: Int, hx: AbsLe(x, e), hy: AbsLe(y, d)): AbsLe(x + y, e + d) { LocatedAddGroup::abs_le_add(x, y, e, d, hx, hy) }

// Each layer's theorems one layer down are refused: a square's sign needs
// negation, and `Nat` has none.
// expect-error: needed for `OrderedRing<A>(≈, <, <=, +, *)`
theorem sq_needs_a_ring<A: OrderedSemiring(≈, <, <=, +, *)>(x: A): A.unit <= x * x { OrderedRing::sq_nonneg(x) }

// expect-error: OrderedRing
theorem nat_has_no_ring(x: Nat): 0 <= x * x { OrderedRing::sq_nonneg(x) }

// A sum's monotonicity needs locatedness, at the monoid as at the group.
// expect-error: needed for `LocatedAddMonoid<A>(≈, <, <=, +)`
theorem range_needs_located<A: OrderedAddMonoid(≈, <, <=, +)>(n: Nat, f, g: Nat → A, h: (k: Nat) → k < n → f(k) <= g(k)):
    MonoidRel::range(+, n, f) <= MonoidRel::range(+, n, g)
{
    LocatedAddMonoid::range_le(n, f, g, h)
}

// The reciprocal is the field's: an ordered ring has none.
// expect-error: of `OrderedField` at `A` is not pinned
fn ring_has_no_recip<A: OrderedRing(≈, <, <=, +, *)>(x: A, h: ApartBy(<, x, A.unit)) → A { A.recip(x, h) }

// A generic `calc` steps through `<`, `≈` and `≤` from the class alone
// (docs/library/strict-order-presentation-design.md): a strict order's tagged views
// give `<` transitivity and `≈` on either side of either order, and a
// located one adds `≤` transitivity and the mixed `<`/`≤` pairs.
section<A: StrictOrder(≈, <, <=)> {
theorem strict_chain(w, x, y, z: A, h1: w ≈ x, h2: x < y, h3: y < z): w < z {
    calc { w ≈ x := h1, < y := h2, < z := h3, }
}
theorem strict_le_same(x, y, z: A, h1: x <= y, h2: y ≈ z): x <= z {
    calc { x <= y := h1, ≈ z := h2, }
}
}
section<A: PseudoOrder(≈, <, <=)> {
theorem located_chain(v, w, x, y, z: A, h1: v <= w, h2: w <= x, h3: x < y, h4: y ≈ z): v < z {
    calc { v <= w := h1, <= x := h2, < y := h3, ≈ z := h4, }
}
}
// The same chains at the carriers, through their instances.
theorem rat_located_chain(v, w, x, y, z: Rat, h1: v <= w, h2: w <= x, h3: x < y, h4: y ≈ z): v < z {
    located_chain(v, w, x, y, z, h1, h2, h3, h4)
}
theorem nat_located_chain(v, w, x, y, z: Nat, h1: v <= w, h2: w <= x, h3: x < y, h4: RelId(y, z)): v < z {
    located_chain(v, w, x, y, z, h1, h2, h3, h4)
}
theorem int_strict_chain(w, x, y, z: Int, h1: RelId(w, x), h2: x < y, h3: y < z): w < z {
    strict_chain(w, x, y, z, h1, h2, h3)
}

// Without locatedness `≤` is not known transitive, so a strict order alone
// has no `<`/`≤` pair.
section<A: StrictOrder(≈, <, <=)> {
// expect-error: no instance for `Trans<A>
theorem strict_mixed_refused(x, y, z: A, h1: x < y, h2: y <= z): x < z {
    calc { x < y := h1, <= z := h2, }
}
}

// ---------------------------------------------------------------------------
// Cancellation (issues/cancellative-algebra-api.md). Addition cancels with no
// side condition at every ordered additive monoid, `Nat` included; a factor
// cancels when it is positive (any ordered semiring) or apart from zero (any
// ordered ring).
theorem nat_add_cancel(x, y, z: Nat, h: x + z = y + z): x = y { OrderedAddMonoid::add_cancel_r(x, y, z, h) }
theorem nat_add_le_cancel(x, y, z: Nat, h: z + x <= z + y): x <= y { OrderedAddMonoid::add_le_cancel_l(x, y, z, h) }
theorem rat_add_cancel(x, y, z: Rat, h: z + x ≈ z + y): x ≈ y { OrderedAddMonoid::add_cancel_l(x, y, z, h) }
theorem nat_mul_cancel_pos(x, y, z: Nat, hz: 0 < z, h: z * x = z * y): x = y { OrderedSemiring::mul_cancel_pos_l(x, y, z, hz, h) }
theorem dyadic_mul_cancel_pos(x, y, z: Dyadic, hz: 0 < z, h: x * z ≈ y * z): x ≈ y { OrderedSemiring::mul_cancel_pos_r(x, y, z, hz, h) }
theorem int_mul_le_cancel(x, y, z: Int, hz: OfNat(0) < z, h: z * x <= z * y): x <= y { OrderedSemiring::mul_le_cancel_pos_l(x, y, z, hz, h) }
theorem int_mul_cancel_neg(x, y: Int, h: NegSucc(2) * x = NegSucc(2) * y): x = y {
    OrderedRing::mul_cancel_apart_l(x, y, NegSucc(2), Inl(Int::negsucc_lt_ofnat(2, 0)), h)
}
theorem creal_mul_cancel_apart(x, y, z: CReal, hz: ApartBy(CReal::Lt, z, 0), h: x * z ≈ y * z): x ≈ y {
    OrderedRing::mul_cancel_apart_r(x, y, z, hz, h)
}

// The carriers' own nonzero forms, where deciding the sign turns `≠ 0` into
// positive or apart.
theorem nat_mul_cancel_ne(x, y, z: Nat, hz: ¬(z = 0), h: x * z = y * z): x = y { x.mul_cancel_r(y, z, hz, h) }
theorem int_mul_cancel_ne(x, y, z: Int, hz: ¬(z = OfNat(0)), h: z * x = z * y): x = y { z.mul_cancel_l(x, y, hz, h) }

// The customer: cross-multiplication equality is transitive through a
// positive middle factor, which is `Rat::same_trans` at `Int`.
theorem int_cross_trans(a, b, c, d, e, f: Int, hd: OfNat(0) < d, h1: a * d ≈ c * b, h2: c * f ≈ e * d): a * f ≈ e * b {
    OrderedSemiring::cross_same_trans(a, b, c, d, e, f, hd, h1, h2)
}

// Without a side condition multiplication does not cancel: a zero factor
// equates everything.
theorem nat_mul_not_cancellative(): ¬((x, y, z: Nat) → z * x = z * y → x = y) {
    λ h => omega(h(0, 1, 0, omega))
}

// Implicit points at a class theorem (issues/generic-theorem-implicit-points.md):
// the hypotheses solve the points, the points' types the carrier, and the
// carrier pins the class goal's indices, from the section's dictionary or
// from the carrier's designations.
section<K: OrderedField(≈, <, <=, +, *)> {
theorem implicit_lt_le({x, y, z: K}, a: x < y, b: y < z): x <= z { StrictOrder::le_of_lt(x, z, K.lt_trans(x, y, z, a, b)) }
theorem implicit_in_section(a, b, c: K, h1: a < b, h2: b < c): a <= c { implicit_lt_le(h1, h2) }
// No point at all: the expected type pins the order, and its type the carrier.
theorem no_point(): K.unit < K.multiplicative.unit { K.zero_lt_one }
theorem no_point_in_section(a: K): K.unit < K.multiplicative.unit { no_point() }
}
theorem implicit_at_rat(a, b, c: Rat, h1: a < b, h2: b < c): a <= c { implicit_lt_le(h1, h2) }
theorem implicit_at_creal(a, b, c: CReal, h1: a < b, h2: b < c): a <= c { implicit_lt_le(h1, h2) }
theorem no_point_at_rat(): Rat::Lt(0, 1) { no_point() }
theorem no_point_at_creal(): CReal::Lt(0, 1) { no_point() }

// Hypotheses at two carriers: the first fixes the carrier, and the point
// only the second mentions is not inferred, as at a concrete carrier.
// expect-error: could not infer the implicit argument `z` of `implicit_lt_le`
theorem implicit_two_carriers(a, b: Rat, c, d: CReal, h1: a < b, h2: c < d): True { let _ = implicit_lt_le(h1, h2); trivial }

// `-x` and `x - y` at an ordered group's carrier, the designations at
// `OrderedAddGroup` (issues/class-carrier-arithmetic-surface.md). A group has
// no `1`, so it has no numerals: they come from a ring in scope.
section<A: OrderedAddGroup(≈, <, <=, +)> {

theorem group_class_sub_self(x: A): x - x ≈ A.unit { A.inv_r(x) }
theorem group_class_neg_sub(x, y: A): -(x - y) ≈ y - x { OrderedAddGroup::neg_sub(x, y) }

// expect-error: needs a ring over `A` in scope
theorem group_class_has_no_numerals(x: A): x + 0 ≈ x { A.unit_r(x) }

}

fn section_twice<A>(f: A → A → A, a: A) → A { f(a, a) }

// A section's symbols are its carrier's: an operand at a carrier of its own
// reads that carrier's designation, and generic operands keep the binder's
// (issues/section-symbols-capture-other-carriers.md).
section<K: OrderedField(≈, <, <=, +, *)> {

theorem section_rat_operands(x: K, a, b: Rat, h: a <= b): a + 0 <= b {
    Rat::le_respects(Rat::same_sym(Rat::add_zero(a)), b.same_refl(), h)
}
theorem section_rat_is_rat(x: K, a, b: Rat): a * b + a = Rat::add(Rat::mul(a, b), a) { refl }
// A numeral-led operand takes its carrier from the operand beside it.
theorem section_rat_numeral_led(x: K, a: Rat): 0 + a = Rat::add(0, a) { refl }
theorem section_nat_is_nat(x: K, m, n: Nat): m + n = Nat::add(m, n) { refl }

// The section's own carrier still reads the binder, numerals included.
theorem section_own_carrier(x: K): x + K.unit ≈ x { K.unit_r(x) }
theorem section_own_numeral(x: K): x + 0 ≈ x { K.unit_r(x) }

// Bare, the carrier is the one the position expects: `Rat`'s `+` where
// `Rat → Rat → Rat` is asked for, as in `OrderedRingHom<Rat, K>(map, ≈, …)`
// (issues/constraint-indices-from-carrier-designations.md).
theorem section_bare_rat(x: K, a: Rat): section_twice<Rat>(+, a) = Rat::add(a, a) { refl }
theorem section_bare_own(x: K): section_twice<K>(+, x) = x + x { refl }

// expect-error: nothing designates `+` at `Bool`
theorem section_bool_has_no_plus(x: K, p, q: Bool): p + q = p { refl }

}

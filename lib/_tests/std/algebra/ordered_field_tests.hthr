// Probes of `lib/std/algebra/ordered_field.hthr` at `Rat` and `CReal`
// (`docs/constructive-ordered-field-design.md`): every layer resolves at
// both carriers with the carrier's own operations as its fields, and each
// layer's theorems apply where its structure is. Tests, not library: nothing
// outside lib/_tests imports this module (docs/test-value-audit.md §4.5).
// Moved from crates/elab/tests/lib_std_ordered_field.rs; the refusals that
// need the checker stay there.
import logic; import nat; import int; import omega; import relation_props;
import algebra_rel; import semiring; import ordered_field; import rat; import creal;

// Every layer resolves at both carriers, and each field is the carrier's own
// operation, definitionally.
fn rat_layers() → Nat {
    let a = Rat::StrictOrder(Rat::Same, Rat::Lt, Rat::Le);
    let b = Rat::Cotransitive(Rat::Lt);
    let c = Rat::PseudoOrder(Rat::Same, Rat::Lt, Rat::Le);
    let d = Rat::OrderedAddGroup(Rat::Same, Rat::Lt, Rat::Le, Rat::add);
    let f = Rat::LocatedAddGroup(Rat::Same, Rat::Lt, Rat::Le, Rat::add);
    let g = Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul);
    let r = Rat::CommRing(Rat::Same, Rat::add, Rat::mul);
    0
}
fn creal_layers() → Nat {
    let a = CReal::StrictOrder(CReal::Same, CReal::Lt, CReal::Le);
    let b = CReal::Cotransitive(CReal::Lt);
    let c = CReal::PseudoOrder(CReal::Same, CReal::Lt, CReal::Le);
    let d = CReal::OrderedAddGroup(CReal::Same, CReal::Lt, CReal::Le, CReal::add);
    let f = CReal::LocatedAddGroup(CReal::Same, CReal::Lt, CReal::Le, CReal::add);
    let g = CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul);
    let r = CReal::CommRing(CReal::Same, CReal::add, CReal::mul);
    0
}
theorem rat_zero(): Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).unit = 0 { refl }
theorem rat_neg(x: Rat): Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).inv(x) = -x { refl }
theorem rat_recip(x: Rat, h: x.Apart(0)):
    Rat::OrderedField(Rat::Same, Rat::Lt, Rat::Le, Rat::add, Rat::mul).recip(x, h) = x.inv(h := h) { refl }
theorem creal_one(): CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul).multiplicative.unit = 1 { refl }
theorem creal_recip(x: CReal, h: x.Apart(0)):
    CReal::OrderedField(CReal::Same, CReal::Lt, CReal::Le, CReal::add, CReal::mul).recip(x, h) = x.inv(h := h) { refl }
// `≤` at the reals is Bishop's by definition; at the rationals it is the
// cross-multiplied one, reached through the instance's laws.
theorem creal_le_is_not_lt(x, y: CReal, h: ¬(y < x)): x <= y { h }
theorem rat_le_of_not_lt(x, y: Rat, h: ¬(y < x)): x <= y { Rat::StrictOrder(Rat::Same, Rat::Lt, Rat::Le).le_of_not_lt(x, y, h) }

// A predicate meets its own unfolding wherever it is written: a hypothesis
// of `Close` where `AbsLt` is expected, a bound passed as `Between`, and a
// result checked against the carrier's spelled-out order. The carrier, from
// the first point or a type argument, fills the indices through its
// designations (issues/constrained-predicate-expected-type.md).
theorem close_neg<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e: A, h: Close(x, y, e)): AbsLt(A.inv(x + A.inv(y)), e) {
    OrderedAddGroup::abs_lt_neg(x + A.inv(y), e, h)
}
theorem bound_lt<A: OrderedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): A.inv(e) < e { StrictOrder::between_lt(A.inv(e), x, e, h) }
theorem rat_sum(x, y, e, d: Rat, hx: -e < x ∧ x < e, hy: -d < y ∧ y < d): -(e + d) < x + y ∧ x + y < e + d {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}
theorem creal_within(x, e: CReal, h: -e < x ∧ x < e): -e <= x ∧ x <= e { LocatedAddGroup::abs_le_of_abs_lt(x, e, h) }
theorem rat_le_typed(x, y: Rat, h: x < y): x <= y { StrictOrder::le_of_lt<Rat>(x, y, h) }
theorem creal_le_typed(x, y: CReal, h: x < y): x <= y { StrictOrder::le_of_lt<CReal>(x, y, h) }

// Each layer's theorems at their own layer: `≤` transitivity and a bound's
// positivity at the located ones; antisymmetry, open intervals and the
// triangle inequality need no locatedness at all.
theorem le_transitive<A: PseudoOrder(≈, <, <=)>(x, y, z: A, h1: x <= y, h2: y <= z): x <= z { PseudoOrder::le_trans(x, y, z, h1, h2) }
theorem bound_pos<A: LocatedAddGroup(≈, <, <=, +)>(x, e: A, h: AbsLt(x, e)): A.unit < e { LocatedAddGroup::abs_lt_pos(x, e, h) }
theorem antisymm<A: StrictOrder(≈, <, <=)>(x, y: A, h1: x <= y, h2: y <= x): x ≈ y { StrictOrder::le_antisymm(x, y, h1, h2) }
theorem triangle<A: OrderedAddGroup(≈, <, <=, +)>(x, y, e, d: A, hx: AbsLt(x, e), hy: AbsLt(y, d)): AbsLt(x + y, e + d) {
    OrderedAddGroup::abs_lt_add(x, y, e, d, hx, hy)
}
theorem le_reflexive<A: OrderedField(≈, <, <=, +, *)>(x: A): x <= x { StrictOrder::le_refl(x) }
theorem strict_irrefl<A: OrderedField(≈, <, <=, +, *)>(x: A): ¬(x < x) { A.lt_irrefl(x) }

// The inverse: of one, from `0 < 1`; of a negative, negative; and zero is
// not apart from itself, so no inverse of zero can be written.
fn recip_one<A: OrderedField(≈, <, <=, +, *)>(x: A) → A { A.recip(A.multiplicative.unit, Inr(A.zero_lt_one)) }
theorem neg_recip<A: OrderedField(≈, <, <=, +, *)>(x: A, hx: x < A.unit): A.recip(x, Inl(hx)) < A.unit {
    OrderedField::recip_neg(x, Inl(hx), hx)
}
theorem zero_not_apart<A: OrderedField(≈, <, <=, +, *)>(x: A): ¬(ApartBy(<, A.unit, A.unit)) { StrictOrder::apart_irrefl(A.unit) }

// `Rat` decides `≤` as an extra; the interface does not.
fn rat_decides(x, y: Rat) → x <= y ∨ ¬(x <= y) { x.le_dec(y) }

// The ordered layers extend the algebraic ones
// (issues/ordered-field-over-comm-ring.md): a `GroupRel` theorem applies to an
// ordered group, a `Ring` or `Semiring` theorem to an ordered field, and a
// generic ring theorem lands at `CReal` through its `CommRing` instance.
theorem group_neg_neg<A: OrderedAddGroup(≈, <, <=, +)>(x: A): A.inv(A.inv(x)) ≈ x { GroupRel::inv_inv(+, x) }
theorem field_neg_mul<A: OrderedField(≈, <, <=, +, *)>(x, y: A): A.inv(x) * y ≈ A.inv(x * y) { Ring::neg_mul(x, y) }
theorem field_mul_add_add<A: OrderedField(≈, <, <=, +, *)>(a, b, c, d: A): (a + b) * (c + d) ≈ (a * c + a * d) + (b * c + b * d) {
    Semiring::mul_add_add(a, b, c, d)
}
theorem field_mul_comm<A: OrderedField(≈, <, <=, +, *)>(x, y: A): x * y ≈ y * x { A.commutative.comm(x, y) }
theorem creal_neg_mul_neg(x, y: CReal): -x * -y ≈ x * y { Ring::neg_mul_neg(x, y) }
theorem creal_interchange(a, b, c, d: CReal): (a * b) * (c * d) ≈ (a * c) * (b * d) { CommMonoidRel::interchange(≈, *, a, b, c, d) }

// ---------------------------------------------------------------------------
// Two constraints sharing `≈`, `+` and `*` at one carrier are one dictionary
// (issues/constraints-sharing-indices.md, docs/operators-onto-classes-design.md
// §17). `zero_lt_one` is `OrderedField`'s, over its `unit`; `of_int_one` is
// `CommRingOfInt`'s, over its `multiplicative.unit`: they combine only if
// both classes' `CommRing` is one.
theorem both_one_pos<A: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)>(x: A):
    A.unit < A.of_int(OfNat(1))
{
    StrictOrder::lt_respects_r(A.unit, A.multiplicative.unit, A.of_int(OfNat(1)),
        A.rel_sym(A.of_int(OfNat(1)), A.multiplicative.unit, A.of_int_one), A.zero_lt_one)
}

// Written in the other order it is the same dictionary, so the call passes it on.
theorem both_one_pos_swapped<A: CommRingOfInt(≈, +, *) + OrderedField(≈, <, <=, +, *)>(x: A):
    A.unit < A.of_int(OfNat(1))
{
    both_one_pos(x)
}

// One parent's lemmas apply through it.
theorem both_of_nat_pos<A: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)>(x: A, n: Nat):
    A.unit < A.of_nat(Succ(n))
{
    OrderedField::of_nat_pos(x, n)
}

// At a concrete carrier the dictionary is assembled from the two instances.
theorem both_at_rat(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_one_pos(q) }
theorem both_at_creal(x: CReal): CReal::Lt(0, CReal::ofRat(Rat::ofInt(OfNat(1)))) { both_one_pos(x) }
theorem both_at_rat_explicit(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_one_pos<Rat>(q) }

// A section's constraint merges the same way.
section<B: OrderedField(≈, <, <=, +, *) + CommRingOfInt(≈, +, *)> {
theorem both_in_section(x: B): B.unit < B.of_int(OfNat(1)) { both_one_pos(x) }
}
theorem both_in_section_at_rat(q: Rat): Rat::Lt(0, Rat::ofInt(OfNat(1))) { both_in_section(q) }

// At two carriers the symbols name two things, which §5.1 still refuses.
// expect-error: `≈` is already this declaration's body spelling
theorem two_carriers<A: OrderedField(≈, <, <=, +, *), B: CommRingOfInt(≈, +, *)>(x: A, y: B): x ≈ x {
    A.rel_refl(x)
}

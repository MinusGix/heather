// Probes of `rewrite` along a relation (docs/equation-rewrite-design.md §9)
// at an open carrier, over the evidence `algebra_rel` and `relation_props`
// state: `Respects2` for a binary operation, `PreservesRelation` for one
// argument, `Reflexive` for an argument that stays, `Symmetric` for the
// goal's right side, `Transitive`/`Trans` to compose. Evidence is a binder
// here, so each probe says which piece the rewrite consumed; the Rat probes
// (`rat_tests.hthr`) are the registered-instance side. Tests, not library:
// nothing outside lib/_tests imports this module (docs/test-value-audit.md
// §4.5). Refusals are checked by `heather check --expectations`.
import logic; import nat; import relation; import relation_props; import algebra_rel;

// A binary operation, with the other argument held by reflexivity.
theorem binary<A: Equivalence(R)>(R: A → A → Type, op: A → A → A, x, y, z: A,
    c: Respects2<A, A, A>(R, R, R, op), h: R(x, y), e: R(op(y, z), z)): R(op(x, z), z)
{ rewrite(h, e) }

// One argument through `PreservesRelation`, nested, so the outer step
// consumes the inner one's proof.
theorem unary<A: Equivalence(R)>(R: A → A → Type, f: A → A, x, y, z: A,
    c: PreservesRelation(R, R, f), h: R(x, y), e: R(f(f(y)), z)): R(f(f(x)), z)
{ rewrite(h, e) }

// A change that is not in the last argument asks for the context as a `λ`.
theorem first_argument<A: Equivalence(R)>(R: A → A → Type, k: A → Nat → A, n: Nat, x, y, z: A,
    c: PreservesRelation(R, R, λ a => k(a, n)), h: R(x, y), e: R(k(y, n), z)): R(k(x, n), z)
{ rewrite(h, e) }

// The right side runs the other way, through `Symmetric`.
theorem right_side<A: Equivalence(R)>(R: A → A → Type, op: A → A → A, x, y, z: A,
    c: Respects2<A, A, A>(R, R, R, op), h: R(x, y), e: R(z, op(y, y))): R(z, op(x, x))
{ rewrite(h, e) }

// A goal relation other than the rewrite's composes through `Trans`, as a
// `calc` chain mixing the two would.
theorem mixed<A: Equivalence(R)>(R, S: A → A → Type, op: A → A → A, x, y, z: A,
    c: Respects2<A, A, A>(R, R, R, op), left: Trans<A>(R, S, S), right: Trans<A>(S, R, S),
    h: R(x, y), e: S(op(y, z), op(z, y))): S(op(x, z), op(z, x))
{ rewrite(h, e) }

// A let-shared goal: the chain is 2^8 paths to `x` and eight nodes, each
// rewritten once.
theorem shared<A: Equivalence(R)>(R: A → A → Type, op: A → A → A, x, y: A,
    c: Respects2<A, A, A>(R, R, R, op), h: R(x, y)):
    R({ let a = op(x, x); let b = op(a, a); let c = op(b, b); let d = op(c, c);
        let e = op(d, d); let f = op(e, e); let g = op(f, f); op(g, g) },
      { let a = op(y, y); let b = op(a, a); let c = op(b, b); let d = op(c, c);
        let e = op(d, d); let f = op(e, e); let g = op(f, f); op(g, g) })
{ rewrite(h, A.rel_refl({ let a = op(y, y); let b = op(a, a); let c = op(b, b); let d = op(c, c);
    let e = op(d, d); let f = op(e, e); let g = op(f, f); op(g, g) })) }

// Missing evidence is an obligation, as `rel_cong` leaves it: here the
// operation's congruence, which nothing in scope proves until the block
// discharges it.
theorem obligation<A: Equivalence(R)>(R: A → A → Type, f: A → A, x, y, z: A,
    supply: (u: A) → PreservesRelation(R, R, f), h: R(x, y), e: R(f(y), z)): R(f(x), z)
{
    rewrite(h, e)
    on ?compatibility := supply(x);
}

// Left undischarged, the obligation is reported with its statement.
// expect-error: ?compatibility : PreservesRelation
theorem obligation_open<A: Equivalence(R)>(R: A → A → Type, f: A → A, x, y, z: A,
    h: R(x, y), e: R(f(y), z)): R(f(x), z)
{ rewrite(h, e) }

// Without `Symmetric` evidence the right side cannot be closed, and the
// rewrite does not invent it: the obligation is the symmetry.
// expect-error: ?symmetry : Symmetric
theorem no_symmetry<A: Transitive(R)>(R: A → A → Type, f: A → A, x, y, z: A,
    c: PreservesRelation(R, R, f), h: R(x, y), e: R(z, f(y))): R(z, f(x))
{ rewrite(h, e) }

// Two arguments that are not the last two have no congruence to ask for.
// expect-error: changes in 2 of its arguments
theorem two_arguments<A: Equivalence(R)>(R: A → A → Type, k: A → Nat → A → A, n: Nat, x, y: A,
    h: R(x, y), e: R(k(y, n, y), y)): R(k(x, n, x), y)
{ rewrite(h, e) }

// A function out of the carrier leaves it (docs/equation-rewrite-design.md
// §11.4, §11.6). With nothing naming a relation at `Nat`, its result changes
// by `=`, and the obligation says what that asks of `size`; `back` then
// crosses back into `R` by `R`'s reflexivity, as every function preserves `=`.
// expect-error: ?compatibility : PreservesRelation(R, RelId, size)
theorem leaves_the_carrier<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{ rewrite(h, e) }
theorem leaves_the_carrier_discharged<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    supply: (u: A) → PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{
    rewrite(h, e)
    on ?compatibility := supply(x);
}
// A hypothesis in scope names the relation, `=` here or another one.
theorem hypothesis_names_identity<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{ rewrite(h, e) }
theorem hypothesis_names_other<A: Equivalence(R)>(R: A → A → Type, S: Nat → Nat → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, S, size), cb: PreservesRelation(S, R, back), h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{ rewrite(h, e) }
// The relation a hypothesis names is still owed its way back.
// expect-error: ?compatibility : PreservesRelation(S, R, back)
theorem hypothesis_one_way<A: Equivalence(R)>(R: A → A → Type, S: Nat → Nat → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, S, size), h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{ rewrite(h, e) }
// A hypothesis about another function names nothing.
// expect-error: ?compatibility : PreservesRelation(R, RelId, size)
theorem hypothesis_other_function<A: Equivalence(R)>(R: A → A → Type, S: Nat → Nat → Type, size, other: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, S, other), h: R(x, y), e: R(back(size(y)), z)): R(back(size(x)), z)
{ rewrite(h, e) }
// A change by `=` crosses a context in its carrier, and is chained into a
// goal at `Nat` as an `=` step, on either side.
theorem identity_through<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: R(back(Nat::add(size(y), 1)), z)): R(back(Nat::add(size(x), 1)), z)
{ rewrite(h, e) }
theorem identity_goal_left<A: Equivalence(R)>(R: A → A → Type, T: Nat → Nat → Type, size: A → Nat, x, y: A, m: Nat,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: T(size(y), m)): T(size(x), m)
{ rewrite(h, e) }
theorem identity_goal_right<A: Equivalence(R)>(R: A → A → Type, T: Nat → Nat → Type, size: A → Nat, x, y: A, m: Nat,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: T(m, size(y))): T(m, size(x))
{ rewrite(h, e) }
// Below binders, whether or not the context mentions them.
theorem leaving_under_binder<A: Equivalence(R)>(R: A → A → Type, F: (Nat → A) → A, size: A → Nat, back: Nat → Nat → A, x, y, w: A,
    c: PreservesRelation(Pointwise<Nat, A>(R), R, F), cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y),
    e: R(F(λ n => back(n, size(y))), w)): R(F(λ n => back(n, size(x))), w)
{ rewrite(h, e) }

// Two changed arguments at different relations: `Respects2` over the
// relation each changed by, the result's named as a context's is.
theorem binary_mixed<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, op: A → Nat → A, x, y, z: A,
    cs: PreservesRelation(R, RelId<Nat>, size), c: Respects2<A, Nat, A>(R, RelId<Nat>, R, op), h: R(x, y),
    e: R(op(y, size(y)), z)): R(op(x, size(x)), z)
{ rewrite(h, e) }
// Both by `=`: every operation respects it (`relid_respects2`), and
// `Nat::add`'s registered instance is found as it is.
theorem binary_identity<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, g: Nat → Nat → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y),
    e: R(back(g(size(y), size(y))), z)): R(back(g(size(x), size(x))), z)
{ rewrite(h, e) }
theorem binary_identity_registered<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, back: Nat → A, x, y, z: A,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y),
    e: R(back(Nat::add(size(y), size(y))), z)): R(back(Nat::add(size(x), size(x))), z)
{ rewrite(h, e) }
// An operation out of the carrier with both arguments changed by `R`.
theorem binary_out<A: Equivalence(R)>(R: A → A → Type, d: A → A → Nat, back: Nat → A, x, y, z: A,
    c: Respects2<A, A, Nat>(R, R, RelId<Nat>, d), h: R(x, y),
    e: R(back(d(y, y)), z)): R(back(d(x, x)), z)
{ rewrite(h, e) }
// expect-error: ?compatibility : Respects2
theorem binary_out_open<A: Equivalence(R)>(R: A → A → Type, d: A → A → Nat, back: Nat → A, x, y, z: A, h: R(x, y),
    e: R(back(d(y, y)), z)): R(back(d(x, x)), z)
{ rewrite(h, e) }
// Two changed arguments that are not the last two: the refusal names the
// relation each changed by.
// expect-error: changes in 2 of its arguments (by `R` and `RelId`)
theorem two_arguments_two_relations<A: Equivalence(R)>(R: A → A → Type, size: A → Nat, k: A → Nat → Nat → A, x, y, z: A, n: Nat,
    cs: PreservesRelation(R, RelId<Nat>, size), h: R(x, y), e: R(k(y, size(y), n), z)): R(k(x, size(x), n), z)
{ rewrite(h, e) }

// Under a binder (§10): the body is rewritten below it, the two λs are
// related by `Pointwise(R)`, and the consumer crosses that by its evidence.
theorem under_binder<A: Equivalence(R)>(R: A → A → Type, F: (A → A) → A, f: A → A, x, y, w: A,
    c: PreservesRelation(Pointwise<A, A>(R), R, F), cf: PreservesRelation(R, R, f), h: R(x, y), e: R(F(λ z => f(y)), w)):
    R(F(λ z => f(x)), w)
{ rewrite(h, e) }
// Two binders of one λ, crossed by `Pointwise(Pointwise(R))`.
theorem under_two_binders<A: Equivalence(R)>(R: A → A → Type, F: (A → A → A) → A, f: A → A, x, y, w: A,
    c: PreservesRelation(Pointwise<A, A → A>(Pointwise<A, A>(R)), R, F), cf: PreservesRelation(R, R, f), h: R(x, y),
    e: R(F(λ u v => f(y)), w)): R(F(λ u v => f(x)), w)
{ rewrite(h, e) }
// A λ changed beside another argument has no congruence to ask for.
// expect-error: changes in 2 of its arguments, a λ among them
theorem binder_and_argument<A: Equivalence(R)>(R: A → A → Type, G: (A → A) → A → A, f: A → A, x, y, w: A,
    cf: PreservesRelation(R, R, f), h: R(x, y), e: R(G(λ z => f(y), y), w)): R(G(λ z => f(x), x), w)
{ rewrite(h, e) }

// Inside a codata constructor (§11.5): the children are the arguments, each
// crossed by `PreservesRelation` about the context `λ z. C(…, z, …)`; a
// function child changes pointwise. Plain and function children, in any
// position, and an indexed declaration.
codata Two { Leaf(n: Nat), Node(l: Two, r: Two), Br(f: Nat → Two, t: Two) }
theorem ctor_last_child(S: Two → Two → Type, tr: Transitive<Two>(S), c: PreservesRelation(S, S, λ z => Node(Leaf(0), z)),
    a, b: Two, h: S(a, b), u: Two, e: S(Node(Leaf(0), b), u)): S(Node(Leaf(0), a), u)
{ rewrite(h, e) }
theorem ctor_first_child(S: Two → Two → Type, tr: Transitive<Two>(S), c: PreservesRelation(S, S, λ z => Node(z, Leaf(1))),
    a, b: Two, h: S(a, b), u: Two, e: S(Node(b, Leaf(1)), u)): S(Node(a, Leaf(1)), u)
{ rewrite(h, e) }
theorem ctor_beside_function(S: Two → Two → Type, tr: Transitive<Two>(S), g: Nat → Two, c: PreservesRelation(S, S, λ z => Br(g, z)),
    a, b: Two, h: S(a, b), u: Two, e: S(Br(g, b), u)): S(Br(g, a), u)
{ rewrite(h, e) }
theorem ctor_function_child(S: Two → Two → Type, tr: Transitive<Two>(S), t: Two,
    c: PreservesRelation(Pointwise<Nat, Two>(S), S, λ f => Br(f, t)),
    a, b: Two, h: S(a, b), u: Two, e: S(Br(λ n => b, t), u)): S(Br(λ n => a, t), u)
{ rewrite(h, e) }
codata Keep: (n: Nat) → Type { K(at: Nat, next: Keep(n)), KF(g: Nat → Keep(n)) }
theorem ctor_indexed(m: Nat, S: Keep(m) → Keep(m) → Type, tr: Transitive<Keep(m)>(S), c: PreservesRelation(S, S, λ z => K(3, z)),
    a, b: Keep(m), h: S(a, b), u: Keep(m), e: S(K(3, b), u)): S(K(3, a), u)
{ rewrite(h, e) }
theorem ctor_indexed_function(m: Nat, S: Keep(m) → Keep(m) → Type, tr: Transitive<Keep(m)>(S),
    c: PreservesRelation(Pointwise<Nat, Keep(m)>(S), S, λ g => KF(g)),
    a, b: Keep(m), h: S(a, b), u: Keep(m), e: S(KF(λ i => b), u)): S(KF(λ i => a), u)
{ rewrite(h, e) }
// Two changed children have no one context to ask about.
// expect-error: changes in 2 of its children
theorem ctor_both_children(S: Two → Two → Type, tr: Transitive<Two>(S), a, b: Two, h: S(a, b), u: Two, e: S(Node(b, b), u)): S(Node(a, a), u)
{ rewrite(h, e) }

// `rel_cong` under a constructor of a parametric type: the compatibility is
// registered at the constructor's name, for every element type
// (issues/rel-cong-under-constructors.md; the closed carrier's probes are in
// lib/_tests/std/text/regex/regex_dfa_tests.hthr).
inductive CongTree<A> { CongLeaf(a: A), CongNode(l: CongTree<A>, r: CongTree<A>) }
fn CongTree::Alike<A>(a, b: CongTree<A>) → Type { a = b }
instance<A> Reflexive<CongTree<A>>(CongTree::Alike<A>) { rel_refl := λ a => refl }
instance<A> Respects2<CongTree<A>, CongTree<A>, CongTree<A>>(CongTree::Alike<A>, CongTree::Alike<A>, CongTree::Alike<A>, CongTree::CongNode) {
    respects2 := λ a a2 sa b b2 sb => subst(sym(sa), subst(sym(sb), refl)),
}
theorem cong_under_node<A>(a, a2, b: CongTree<A>, h: CongTree::Alike(a, a2)): CongTree::Alike(CongNode(a, b), CongNode(a2, b)) { rel_cong(h) }
theorem cong_under_nodes(a, a2, b: CongTree<Nat>, h: CongTree::Alike(a, a2)):
    CongTree::Alike(CongNode(CongNode(a, b), CongLeaf(3)), CongNode(CongNode(a2, b), CongLeaf(3))) { rel_cong(h) }
// A leaf's field is an element, not a tree: no context.
// expect-error: context mismatch
theorem cong_under_leaf(x, y: Nat, h: CongTree::Alike(CongLeaf(x), CongLeaf(x))): CongTree::Alike(CongLeaf(x), CongLeaf(y)) { rel_cong(h) }

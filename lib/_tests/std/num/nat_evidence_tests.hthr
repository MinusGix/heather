// Probes of `:= infer` at a proposition goal, with `lib/std/num/nat.hthr`'s
// positivity rules as the customer (`issues/infer-proposition-evidence.md`,
// `docs/positivity-evidence-design.md` §6 A): computation, a local proof up
// to conversion, rules that backchain through locals, nest and mix with
// computation, a rule called as an ordinary theorem, and a rule declared
// here used here. The axes of `docs/testing-generated-terms.md`: a literal
// and a neutral operand, a checking position (the proof used where the
// statement is the expected type, and inside a `let`). Tests, not library:
// nothing outside lib/_tests imports this module (docs/test-value-audit.md
// §4.5). Moved from crates/elab/tests/lib_std_evidence.rs; the refusals stay
// there.
import logic; import nat;

theorem uses(n: Nat, h: 0 < n := infer): 0 < n { h }

// A goal that computes to `True` is discharged: a literal, and a neutral
// operand under a `Succ`.
theorem lit(): 0 < 5 { uses(5) }
theorem succ(k: Nat): 0 < Succ(k) { uses(Succ(k)) }
theorem plus_one(k: Nat): 0 < k + 1 { uses(k + 1) }

// Scope still comes first, up to conversion.
theorem exact(n: Nat, p: 0 < n): 0 < n { uses(n) }
theorem spelled(n: Nat, p: 1 <= n): 0 < n { uses(n) }

// Library rules backchain through locals.
theorem product(x, y: Nat, px: 0 < x, py: 0 < y): 0 < x * y { uses(x * y) }
theorem nested(x, y, z: Nat, px: 0 < x, py: 0 < y, pz: 0 < z): 0 < x * (y * z) { uses(x * (y * z)) }
theorem right_summand(a, b: Nat, pb: 0 < b): 0 < a + b { uses(a + b) }

// A rule premise may be discharged by computation: `0 < Succ(k)` and
// `0 < y + 1` are premises no local states.
theorem mixed(x, k: Nat, px: 0 < x): 0 < x * Succ(k) { uses(x * Succ(k)) }
theorem in_let(x, y: Nat, px: 0 < x): 0 < x * (y + 1) {
    let p = uses(x * (y + 1));
    p
}

// A rule is an ordinary theorem too: callable with every premise searched, or
// with one given by name.
theorem direct(x, y: Nat, px: 0 < x, py: 0 < y): 0 < x * y { Nat::mul_pos() }
theorem named(x, y: Nat, q: 1 <= y, px: 0 < x): 0 < x * y { Nat::mul_pos(pb := q) }

// A rule declared here is used here, beside the library's: two rules about
// `Nat::Lt` coexist, which the class registry's (class, carrier head) key
// would refuse.
fn twice(n: Nat) → Nat { n + n }
evidence theorem twice_pos({n: Nat}, p: 0 < n := infer): 0 < twice(n) { uses(n + n) }
theorem t(n, m: Nat, p: 0 < n, q: 0 < m): 0 < twice(n) * m { uses(twice(n) * m) }

// `evidence` stays an ordinary name everywhere else.
record W { evidence: Nat }
fn read(w: W) → Nat { w.evidence }

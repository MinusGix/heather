// Probes of matching on a `Nat` literal inside an enclosing recursion
// (`issues/kernel-fold-probe-evaluates-recursive-arms.md`). A `match` on a
// literal is a fold over a run, and the kernel classifies a fold's step by
// evaluating it; a step that never reads its `ih` is no algebra, so it is
// not probed and the fold is its one ordinary step. Before, each level of
// these walks evaluated its arm's recursive call once per probe as well,
// and every walk below but `count_upto` ran a declaration out of fuel.
// Tests, not library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import logic; import bool; import nat;

inductive Walk { Start, At(before: Walk, name: Nat) }

// Both arms recurse, and the result is a `Bool`.
fn Walk::all(self p: Walk) → Bool {
    match p { Start => True, At(before, name) => match name { Zero => before.all(), Succ(_) => before.all() } }
}

// The arm reads the predecessor after recursing, so a probe would run the
// whole walk before it got stuck on the predecessor.
fn Walk::small(self p: Walk) → Bool {
    match p { Start => True, At(before, name) => match name { Zero => before.small(), Succ(m) => before.small() && m.leb(8) } }
}

// A control: a `Nat` result, the recursive call under a successor, which
// read as a literal tree and was cheap before too.
fn Walk::count(self p: Walk) → Nat {
    match p { Start => 0, At(before, name) => match name { Zero => before.count(), Succ(_) => before.count() + 1 } }
}

fn Walk::named(n, name: Nat) → Walk { match n { Zero => Start, Succ(k) => At(Walk::named(k, name), name) } }

// Names 0, 1, …, n - 1: literals of every length up to `n`, zero included.
fn Walk::upto(n: Nat) → Walk { match n { Zero => Start, Succ(k) => At(Walk::upto(k), k) } }

theorem all_ones(): Walk::named(64, 1).all() = True { refl }
theorem all_wide(): Walk::named(64, 1000000).all() = True { refl }
theorem all_upto(): Walk::upto(64).all() = True { refl }
theorem small_fives(): Walk::named(64, 5).small() = True { refl }
theorem not_small(): Walk::upto(64).small() = False { refl }
theorem count_upto(): Walk::upto(64).count() = 63 { refl }

// `/` and `%` at `Nat` (issues/integer-operator-symbols.md), by zero too.
theorem div_symbols(): 17 / 5 = 3 ∧ 17 % 5 = 2 ∧ 17 / 0 = 0 ∧ 17 % 0 = 17 {
    And(refl, And(refl, And(refl, refl)))
}
theorem div_symbols_open(a, b: Nat): a / b = a.div(b) ∧ a % b = a.mod(b) { And(refl, refl) }

// A counter written a piece at a time is compared as the number it spells
// (`issues/succ-chain-numbers-fold-unary.md`). Each walk compares its
// counter at every step: a comparison that read the counter a successor at
// a time made the walk quadratic, and each of these ran out of fuel well
// before its end. The counter is a written successor of the one before,
// and one read off a record a call returns.
fn climbs(steps, at: Nat) → Bool {
    match steps { Zero => True, Succ(rest) => at.same(at) && climbs(rest, at + 1) }
}

record Counter { seen: Nat, next: Nat }

fn Counter::step(self c: Counter) → Counter { Counter(c.next, c.next + 1) }

fn climbs_through(steps: Nat, c: Counter) → Bool {
    match steps { Zero => True, Succ(rest) => c.next.same(c.seen + 1) && climbs_through(rest, c.step()) }
}

theorem climbs_far(): climbs(4000, 0) = True { refl }
theorem climbs_through_far(): climbs_through(4000, Counter(0, 1)) = True { refl }

// The decider is `same`'s, so two long literals are decided in a step or
// two each way, where a walk down both took a step a successor.
theorem eq_dec_long(): (match Nat::eq_dec(1000000, 1000000) { Inl(_) => True, Inr(_) => False }) = True { refl }
theorem eq_dec_long_differ(): (match Nat::eq_dec(1000000, 1000001) { Inl(_) => True, Inr(_) => False }) = False { refl }

// A fold whose step runs another fold over a run, that one's step reading
// the outer step's `ih` (`issues/fold-probe-nested-probe-variable-collision.md`).
// Each probe has variables of its own: when the inner probe read the outer
// `ih` as its own, `outer(3)` computed to 0 and `False` followed.
fn const2(a: Nat, b: Nat) → Nat { a }
fn inner(o: Nat, n: Nat) → Nat { match n { Zero => Zero, Succ(k) => const2(o, inner(o, k)) } }
fn outer(n: Nat) → Nat { match n { Zero => 7, Succ(k) => inner(outer(k), 5) } }

theorem outer_three(): outer(3) = 7 { refl }
// expect-error(kernel): the kernel rejected `outer_three_zero`: NotConvertible
theorem outer_three_zero(): outer(3) = 0 { refl }

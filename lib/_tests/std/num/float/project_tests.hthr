// Probes of `lib/std/num/float/project.hthr`: P3109's projection at the
// edges of the finite range, per saturation mode (interim report §4.7.5).
// Tests, not library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import int; import omega; import rat;
import dyadic; import float; import round; import p3109; import project;
fn val_or({F: Format}, r: Float(F), d: Rat) → Rat { match r { Fin(f) => f.val(), Inf(_, _) => d, NaN(_) => d } }
fn inf_bit({F: Format}, r: Float(F)) → Bool { match r { Fin(_) => False, Inf(n, _) => !n, NaN(_) => False } }

// ---------------------------------------------------------------------------
// Binary8p3se (extended): largest float 49152.

// Inside the range every saturation mode rounds.
theorem se_in(): Rat::Same(val_or(binary8p3se().project(NearestEven, SatNone, Rat(11, 8)), 99), Rat(3, 2)) { refl }
theorem se_in_fin(): Rat::Same(val_or(binary8p3se().project(NearestEven, SatFinite, Rat(11, 8)), 99), Rat(3, 2)) { refl }
// Past it: SatNone overflows to infinity, the others clamp.
theorem se_none(): inf_bit(binary8p3se().project(NearestEven, SatNone, 100000)) = True { refl }
theorem se_finite(): Rat::Same(val_or(binary8p3se().project(NearestEven, SatFinite, 100000), 99), 49152) { refl }
theorem se_prop(): Rat::Same(val_or(binary8p3se().project(NearestEven, SatPropagate, 100000), 99), 49152) { refl }
theorem se_finite_neg(): Rat::Same(val_or(binary8p3se().project(TowardNeg, SatFinite, -100000), 99), -49152) { refl }
// The overflow tie stays at the even largest float under every mode of saturation.
theorem se_tie(): Rat::Same(val_or(binary8p3se().project(NearestEven, SatNone, 53248), 99), 49152) { refl }
// Directed rounding back toward the range never overflows.
theorem se_tz(): Rat::Same(val_or(binary8p3se().project(TowardZero, SatNone, 100000), 99), 49152) { refl }
theorem se_up(): inf_bit(binary8p3se().project(TowardPos, SatNone, 49153)) = True { refl }

// ---------------------------------------------------------------------------
// Binary8p3sf (finite): largest float 57344, code 0x7f, odd.

// SatNone at a finite domain gives NaN where rounding leaves the range.
theorem sf_none(): (binary8p3sf().project(NearestEven, SatNone, 100000)).is_nan() = True { refl }
theorem sf_finite(): Rat::Same(val_or(binary8p3sf().project(NearestEven, SatFinite, 100000), 99), 57344) { refl }
// The largest float is odd, so the tie at 57344 + 4096 rounds up and past.
theorem sf_tie_none(): (binary8p3sf().project(NearestEven, SatNone, 61440)).is_nan() = True { refl }
theorem sf_tie_finite(): Rat::Same(val_or(binary8p3sf().project(NearestEven, SatFinite, 61440), 99), 57344) { refl }
theorem sf_below_tie(): Rat::Same(val_or(binary8p3sf().project(NearestEven, SatNone, 61439), 99), 57344) { refl }
// Rounding toward zero or downward from above the range asks for a finite result.
theorem sf_tz(): Rat::Same(val_or(binary8p3sf().project(TowardZero, SatNone, 100000), 99), 57344) { refl }
theorem sf_tn(): Rat::Same(val_or(binary8p3sf().project(TowardNeg, SatNone, 100000), 99), 57344) { refl }
theorem sf_tp(): (binary8p3sf().project(TowardPos, SatNone, 57345)).is_nan() = True { refl }
// What `RoundsTo` itself does at a format without infinities is SatFinite.
theorem sf_rounds_is_finite(): Rat::Same(val_or(binary8p3sf().round_rat(NearestEven, 100000), 99), 57344) { refl }

// OCP E4M3 is NaN-only too: SatNone is its non-saturating conversion.
theorem e4m3_none(): (e4m3().project(NearestEven, SatNone, 500)).is_nan() = True { refl }
theorem e4m3_finite(): Rat::Same(val_or(e4m3().project(NearestEven, SatFinite, 500), 99), 448) { refl }

// ---------------------------------------------------------------------------
// Unsigned (Binary8p3ue): negative values go below `Mlo = 0`.

theorem ue_neg_none(): (binary8p3ue().project_unsigned(NearestEven, SatNone, -1)).is_nan() = True { refl }
theorem ue_neg_finite(): Rat::Same(val_or(binary8p3ue().project_unsigned(NearestEven, SatFinite, -1), 99), 0) { refl }
theorem ue_neg_tz(): Rat::Same(val_or(binary8p3ue().project_unsigned(TowardZero, SatNone, -1), 99), 0) { refl }
theorem ue_neg_tp(): Rat::Same(val_or(binary8p3ue().project_unsigned(TowardPos, SatNone, -1), 99), 0) { refl }
theorem ue_neg_tn(): (binary8p3ue().project_unsigned(TowardNeg, SatNone, -1)).is_nan() = True { refl }
// A negative value that rounds to zero is zero.
theorem ue_tiny(): Rat::Same(val_or(binary8p3ue().project_unsigned(NearestEven, SatNone, Dyadic(-1, -40).rat()), 99), 0) { refl }
// The positive side is the envelope's projection.
theorem ue_pos(): Rat::Same(val_or(binary8p3ue().project_unsigned(NearestEven, SatNone, Rat(11, 8)), 99), Rat(3, 2)) { refl }
theorem ue_over(): inf_bit(binary8p3ue().project_unsigned(NearestEven, SatNone, Dyadic(1, 40).rat())) = True { refl }

// The theorems at work on an open value.
theorem ue_nonneg(x: Rat): (binary8p3ue().project_unsigned(NearestEven, SatNone, x)).NonNeg() { binary8p3ue().project_unsigned_nonneg(NearestEven, SatNone, x) }
theorem se_faithful(x: Rat, f: Finite(binary8p3se()), h: binary8p3se().project(TowardPos, SatFinite, x) = Float::Fin(f)): Finite::Below(x, f) ∨ Finite::Above(x, f) {
    binary8p3se().project_faithful(TowardPos, SatFinite, x, f, h)
}

// ---------------------------------------------------------------------------
// Round to odd.

// E2M1's floats 1, 1.5, 2, 3 have codes even, odd, even, odd.
theorem odd_up(): Rat::Same(val_or(e2m1().round_odd(Rat(5, 4)), 99), Rat(3, 2)) { refl }
theorem odd_keep(): Rat::Same(val_or(e2m1().round_odd(Rat(7, 4)), 99), Rat(3, 2)) { refl }
theorem odd_exact_even(): Rat::Same(val_or(e2m1().round_odd(1), 99), 1) { refl }
theorem odd_carry(): Rat::Same(val_or(e2m1().round_odd(Rat(5, 2)), 99), 3) { refl }
theorem odd_neg(): Rat::Same(val_or(e2m1().round_odd(Rat(-5, 4)), 99), Rat(-3, 2)) { refl }
// At precision one the code is the exponent: 2 (0x41) is odd, 4 (0x42) even.
theorem odd_p1_keep(): Rat::Same(val_or(binary8p1se().round_odd(3), 99), 2) { refl }
theorem odd_p1_step(): Rat::Same(val_or(binary8p1se().round_odd(5), 99), 8) { refl }
// Past the range (issues/float-round-to-odd.md): with infinities an even
// largest float steps away to infinity, so an even result is still exact;
// binary16's largest float is odd and is kept.
theorem odd_b8_over(): inf_bit(binary8p3se().round_odd(50000)) = True { refl }
theorem odd_b16_top(): Rat::Same(val_or(binary16().round_odd(65505), 99), 65504) { refl }
// Negative control: E4M3 saturates, and its largest float 448 is even, so
// round to odd returns an even float that is not the value.
theorem odd_sat_even_inexact(): e4m3().round_odd(460) = Float::Fin(Finite::max_finite(e4m3()))
    ∧ Nat::Even((Finite::max_finite(e4m3())).mag) ∧ ¬Rat::Same((Finite::max_finite(e4m3())).val(), 460)
{
    let v: Rat::Same((Finite::max_finite(e4m3())).val(), 448) = refl;
    And(refl, And(trivial, λ h => { let b: Rat::Same(Rat::ofInt(448), 460) = Rat::same_trans(Rat::same_sym(v), h); omega(b) }))
}

// ---------------------------------------------------------------------------
// Stochastic rounding, pointwise. E2M1 between 1 and 1.5 (spacing 1/2), two
// random bits.

// 5/4 is halfway (ν·4 = 2): variant A steps away for R = 2, 3.
theorem sra_low(): Rat::Same(val_or(e2m1().round_sr_a(Rat(5, 4), 2, 1), 99), 1) { refl }
theorem sra_high(): Rat::Same(val_or(e2m1().round_sr_a(Rat(5, 4), 2, 2), 99), Rat(3, 2)) { refl }
theorem srb_low(): Rat::Same(val_or(e2m1().round_sr_b(Rat(5, 4), 2, 1), 99), 1) { refl }
theorem srb_high(): Rat::Same(val_or(e2m1().round_sr_b(Rat(5, 4), 2, 2), 99), Rat(3, 2)) { refl }
// 23/16 has ν·4 = 3.5: A sees 3 and keeps 1 at R = 0; C rounds 3.5 to 4 and
// always steps away.
theorem sra_frac(): Rat::Same(val_or(e2m1().round_sr_a(Rat(23, 16), 2, 0), 99), 1) { refl }
theorem src_frac(): Rat::Same(val_or(e2m1().round_sr_c(Rat(23, 16), 2, 0), 99), Rat(3, 2)) { refl }
// 21/16 has ν·4 = 2.5, a tie for C's inner rounding: to even, 2.
theorem src_tie(): Rat::Same(val_or(e2m1().round_sr_c(Rat(21, 16), 2, 1), 99), 1) { refl }
// Negative values step away from zero.
theorem sra_neg(): Rat::Same(val_or(e2m1().round_sr_a(Rat(-5, 4), 2, 3), 99), Rat(-3, 2)) { refl }
// Exactly representable values never move.
theorem sra_exact(): Rat::Same(val_or(e2m1().round_sr_a(Rat(3, 2), 2, 3), 99), Rat(3, 2)) { refl }
// Of the four draws at ν·4 = 2, two step away.
theorem sra_count(): Nat::count_away(2, 4, 4) = 2 { refl }

// ---------------------------------------------------------------------------
// Round to odd and stochastic rounding through saturation.

// Binary8p3sf: largest float 57344 (odd code), next grid value 65536. Between
// them round to odd keeps the odd largest float; from 65536 on it overflows,
// which a finite domain under SatNone makes NaN.
theorem odd_sf_keep(): Rat::Same(val_or(binary8p3sf().project_odd(SatNone, 60000), 99), 57344) { refl }
theorem odd_sf_over(): (binary8p3sf().project_odd(SatNone, 65536)).is_nan() = True { refl }
// Binary8p3se: the largest float 49152 is even, so just past it round to odd
// steps away and overflows.
theorem odd_se_over(): inf_bit(binary8p3se().project_odd(SatNone, 50000)) = True { refl }
theorem odd_se_sat(): Rat::Same(val_or(binary8p3se().project_odd(SatFinite, 50000), 99), 49152) { refl }
// E4M3 under SatNone no longer returns its even largest float for 460: the
// step away overflows to NaN. SatFinite clamps, and there the even result is
// inexact (the caveat of issues/float-round-to-odd.md).
theorem odd_e4m3_none(): (e4m3().project_odd(SatNone, 460)).is_nan() = True { refl }
theorem odd_e4m3_finite(): Rat::Same(val_or(e4m3().project_odd(SatFinite, 460), 99), 448) { refl }
// In range nothing changes.
theorem odd_in_range(): Rat::Same(val_or(e2m1().project_odd(SatNone, Rat(5, 4)), 99), Rat(3, 2)) { refl }

// Stochastic rounding at Binary8p3se's top: 53248 is halfway to the next
// grid value 57344, so two of the four draws step away and overflow.
theorem sr_top_keep(): Rat::Same(val_or(binary8p3se().project_sr_a(SatNone, 53248, 2, 1), 99), 49152) { refl }
theorem sr_top_over(): inf_bit(binary8p3se().project_sr_a(SatNone, 53248, 2, 2)) = True { refl }
theorem sr_top_sat(): Rat::Same(val_or(binary8p3se().project_sr_a(SatFinite, 53248, 2, 2), 99), 49152) { refl }
// Past the next grid value every draw overflows.
theorem sr_past(): inf_bit(binary8p3se().project_sr_a(SatNone, 60000, 2, 0)) = True { refl }
theorem sr_past_c(): inf_bit(binary8p3se().project_sr_c(SatNone, 60000, 2, 0)) = True { refl }
theorem sr_past_b(): inf_bit(binary8p3se().project_sr_b(SatNone, 60000, 2, 0)) = True { refl }

// The exactness theorem at work on an open value.
theorem odd_exact_open(x: Rat, g: Finite(binary8p3se()), h: binary8p3se().project_odd(SatNone, x) = Float::Fin(g), ev: Finite::Even(g),
    lo: -(Finite::max_finite(binary8p3se())).val() <= x, hi: x <= (Finite::max_finite(binary8p3se())).val()): g.val() ≈ x
{
    binary8p3se().project_odd_even_exact(SatNone, x, g, h, ev, lo, hi)
}

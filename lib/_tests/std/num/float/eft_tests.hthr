// Probes of `lib/std/num/float/eft.hthr`: the error-free transformations at
// binary16, by evaluation and by citing the theorems, with negative controls
// for each hypothesis. Tests, not library: nothing outside lib/_tests imports
// this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import int; import omega; import rat;
import dyadic; import float; import round; import arith; import eft;
fn h16(neg: Bool, m, b: Nat, ok: binary16().canonical(m, b).IsTrue()) → Finite(binary16()) { Finite(neg, m, b, ok) }
fn one() → Finite(binary16()) { h16(False, 1024, 14, trivial) }
fn three() → Finite(binary16()) { h16(False, 1536, 15, trivial) }
fn two() → Finite(binary16()) { h16(False, 1024, 15, trivial) }
// 1 + 2^-10, the float after 1.
fn one_up() → Finite(binary16()) { h16(False, 1025, 14, trivial) }
// 3 · 2^-12, below half an ulp of 1 plus a quarter.
fn b3() → Finite(binary16()) { h16(False, 1536, 3, trivial) }
// 2^-10 and -2^-12.
fn ulp1() → Finite(binary16()) { h16(False, 1024, 4, trivial) }
fn neg_q() → Finite(binary16()) { h16(True, 1024, 2, trivial) }
// The least subnormal, 2^-24.
fn tiny() → Finite(binary16()) { h16(False, 1, 0, trivial) }

// Sterbenz: 3 - 2 at any mode, from the theorem.
theorem sterbenz_three_two(): (three().sub(two(), mode := TowardPos)).Exact(three().val() - two().val()) {
    Finite::sterbenz(three(), two(), TowardPos, trivial, trivial)
}
// Negative control: 1 - 3·2^-12 is outside `y/2 <= x <= 2y` and is not exact
// (it is a tie, and rounds to 2046 · 2^-11).
theorem sterbenz_needs_range(): ¬(one().sub(b3())).Exact(one().val() - b3().val()) {
    λ ex => {
        let c: (one().sub(b3()) = Float::Fin(h16(False, 2046, 13, trivial))) = refl;
        let e: (h16(False, 2046, 13, trivial).val() ≈ one().val() - b3().val()) = j(c, λ o _ => o.Exact(one().val() - b3().val()), ex);
        Rat::not_le_of_lt(x := h16(False, 2046, 13, trivial).val(), y := one().val() - b3().val(), h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// Fast2Sum on 1 + 3·2^-12: s = 1 + 2^-10, z = 2^-10, t = -2^-12.
theorem f2s_s(): one().add(b3()) = Float::Fin(one_up()) { refl }
theorem f2s_z(): one_up().sub(one()) = Float::Fin(ulp1()) { refl }
theorem f2s_t(): b3().sub(ulp1()) = Float::Fin(neg_q()) { refl }
theorem f2s_exact(): one_up().val() + neg_q().val() ≈ one().val() + b3().val() {
    Finite::fast_two_sum_exact(one(), b3(), one_up(), ulp1(), neg_q(), True, NearestEven, trivial, refl, refl, refl)
}
// The second step under a directed mode is still exact.
theorem f2s_err_up(): (b3().sub(ulp1(), mode := TowardPos)).Exact((one().val() + b3().val()) - one_up().val()) {
    Finite::fast_two_sum_err(one(), b3(), one_up(), ulp1(), True, TowardPos, refl, refl)
}
// Negative control: with |b| > |a| the first step is not exact: 1 + 2^-24
// rounds to 1, and 1 - 2^-24 needs 24 bits.
theorem f2s_needs_order(): ¬(one().sub(tiny())).Exact(one().val() - tiny().val()) {
    λ ex => {
        let c: (one().sub(tiny()) = Float::Fin(one())) = refl;
        let e: (one().val() ≈ one().val() - tiny().val()) = j(c, λ o _ => o.Exact(one().val() - tiny().val()), ex);
        Rat::not_le_of_lt(x := one().val() - tiny().val(), y := one().val(), h := trivial)(Rat::le_of_same(e))
    }
}

// The error of a nearest sum is a float...
theorem err_near(): ∃ f: Finite(binary16()), f.val() ≈ (one().val() + b3().val()) - one_up().val() {
    Finite::add_error(one(), b3(), one_up(), True, refl)
}
// ...and negative control: the error of a directed one need not be. 1 + 2^-24
// rounds up to 1 + 2^-10, and 2^-24 - 2^-10 has 14 significant bits.
theorem err_up_add(): one().add(tiny(), mode := TowardPos) = Float::Fin(one_up()) { refl }
theorem err_up_not_float(): ¬(∃ f: Finite(binary16()), f.val() ≈ (one().val() + tiny().val()) - one_up().val()) {
    λ r => {
        let v = (one().val() + tiny().val()) - one_up().val();
        let ex = (binary16()).round_rat_of_rep(NearestEven, v, r);
        let c: ((binary16()).round_rat(NearestEven, v) = Float::Fin(h16(True, 1024, 4, trivial))) = refl;
        let e: (h16(True, 1024, 4, trivial).val() ≈ v) = j(c, λ o _ => o.Exact(v), ex);
        Rat::not_le_of_lt(x := h16(True, 1024, 4, trivial).val(), y := v, h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// Vacuity controls: `Exact` names its value, so a citation at another value
// is refused.
// expect-error(mismatch)
theorem sterbenz_not_sum(): (three().sub(two())).Exact(three().val() + two().val()) { Finite::sterbenz(three(), two(), NearestEven, trivial, trivial) }
// expect-error(mismatch)
theorem f2s_not_sum({F: Format}, a, b, s: Finite(F), le: b.val().abs() <= a.val().abs(), hs: a.add(b) = Float::Fin(s)):
    (s.sub(a)).Exact(s.val() + a.val())
{
    Finite::fast_two_sum(a, b, s, True, NearestEven, le, hs)
}

// TwoProduct on (1 + 2^-10)²: p = 1 + 2^-9, e = 2^-20, from fma.
fn one_up2() → Finite(binary16()) { h16(False, 1026, 14, trivial) }
fn e20() → Finite(binary16()) { h16(False, 16, 0, trivial) }
theorem tp_p(): one_up().mul(one_up()) = Float::Fin(one_up2()) { refl }
theorem tp_e(): one_up().fma(one_up(), -one_up2()) = Float::Fin(e20()) { refl }
theorem tp_exact(): one_up2().val() + e20().val() ≈ one_up().val() * one_up().val() {
    Finite::two_product_exact(one_up(), one_up(), one_up2(), e20(), True, NearestEven, 4, refl, trivial, refl, refl)
}
// The fma may round in any mode: the error is a float.
theorem tp_up(): (one_up().fma(one_up(), -one_up2(), mode := TowardNeg)).Exact(one_up().val() * one_up().val() - one_up2().val()) {
    Finite::two_product(one_up(), one_up(), one_up2(), True, TowardNeg, 4, refl, trivial, refl)
}
// Negative control: below the subnormal grid the product error is not a
// float. (1025 · 2^-22)² rounds to 2^-24 and leaves 2049 · 2^-44.
fn sub_a() → Finite(binary16()) { h16(False, 1025, 2, trivial) }
theorem tp_under_p(): sub_a().mul(sub_a()) = Float::Fin(tiny()) { refl }
theorem tp_needs_grid(): ¬(∃ f: Finite(binary16()), f.val() ≈ sub_a().val() * sub_a().val() - tiny().val()) {
    λ r => {
        let v = sub_a().val() * sub_a().val() - tiny().val();
        let ex = (binary16()).round_rat_of_rep(NearestEven, v, r);
        let c: ((binary16()).round_rat(NearestEven, v) = Float::Fin(Finite::zero(binary16(), False))) = refl;
        let e: ((Finite::zero(binary16(), False)).val() ≈ v) = j(c, λ o _ => o.Exact(v), ex);
        Rat::not_le_of_lt(x := (Finite::zero(binary16(), False)).val(), y := v, h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// TwoSum on 3·2^-12 + 1, the order Fast2Sum needs reversed: s = 1 + 2^-10,
// a1 = 2^-10, b1 = 1, da = -2^-12, db = 0, t = -2^-12.
fn pzero() → Finite(binary16()) { Finite::zero(binary16(), False) }
theorem ts_s(): b3().add(one()) = Float::Fin(one_up()) { refl }
theorem ts_a1(): one_up().sub(one()) = Float::Fin(ulp1()) { refl }
theorem ts_b1(): one_up().sub(ulp1()) = Float::Fin(one()) { refl }
theorem ts_da(): b3().sub(ulp1()) = Float::Fin(neg_q()) { refl }
theorem ts_db(): one().sub(one()) = Float::Fin(pzero()) { refl }
theorem ts_t(): neg_q().add(pzero()) = Float::Fin(neg_q()) { refl }
theorem ts_exact(): one_up().val() + neg_q().val() ≈ b3().val() + one().val() {
    Finite::two_sum_exact(b3(), one(), one_up(), ulp1(), one(), neg_q(), pzero(), neg_q(), True, NearestEven, trivial, refl, refl, refl, refl, refl, refl)
}
// The last four steps may round in any mode (downward, `1 - 1` is -0).
fn nzero() → Finite(binary16()) { Finite::zero(binary16(), True) }
theorem ts_down(): (neg_q().add(nzero(), mode := TowardNeg)).Exact((b3().val() + one().val()) - one_up().val()) {
    Finite::two_sum(b3(), one(), one_up(), ulp1(), one(), neg_q(), nzero(), True, TowardNeg, trivial, refl, refl, refl, refl, refl)
}
// TwoSum also recovers the error Fast2Sum lost on 2^-24 + 1: s = 1, t = 2^-24.
theorem ts_tiny(): one().val() + tiny().val() ≈ tiny().val() + one().val() {
    Finite::two_sum_exact(tiny(), one(), one(), pzero(), one(), tiny(), pzero(), tiny(), True, NearestEven, trivial, refl, refl, refl, refl, refl, refl)
}
// Negative control: with `s` rounded upward, 2^-24 + 1 gives s = 1 + 2^-10,
// a1 = 2^-10, and `da = 2^-24 - 2^-10` needs 15 bits: it rounds to -2^-10.
theorem ts_up_s(): tiny().add(one(), mode := TowardPos) = Float::Fin(one_up()) { refl }
theorem ts_needs_nearest(): ¬(tiny().sub(ulp1())).Exact(tiny().val() - ulp1().val()) {
    λ ex => {
        let c: (tiny().sub(ulp1()) = Float::Fin(-ulp1())) = refl;
        let e: ((-ulp1()).val() ≈ tiny().val() - ulp1().val()) = j(c, λ o _ => o.Exact(tiny().val() - ulp1().val()), ex);
        Rat::not_le_of_lt(x := (-ulp1()).val(), y := tiny().val() - ulp1().val(), h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// Veltkamp splitting at s = 5 (C = 33 = 1056 · 2^-5) on x = 1537 · 2^-10:
// g = 1585 · 2^-5, d = -1537 · 2^-5, xh = 1.5 (6 bits), xl = 2^-10.
fn c33() → Finite(binary16()) { h16(False, 1056, 19, trivial) }
fn vx() → Finite(binary16()) { h16(False, 1537, 14, trivial) }
fn vg() → Finite(binary16()) { h16(False, 1585, 19, trivial) }
fn vd() → Finite(binary16()) { h16(True, 1537, 19, trivial) }
fn vxh() → Finite(binary16()) { h16(False, 1536, 14, trivial) }
theorem vk_g(): c33().mul(vx()) = Float::Fin(vg()) { refl }
theorem vk_d(): vx().sub(vg()) = Float::Fin(vd()) { refl }
theorem vk_xh(): vg().add(vd()) = Float::Fin(vxh()) { refl }
theorem vk_xl(): vx().sub(vxh()) = Float::Fin(ulp1()) { refl }
theorem vk_split(): vxh().val() + ulp1().val() ≈ vx().val() ∧ OnGrid(vx().bexp + 5, vxh().H())
    ∧ (ulp1().H() <= Nat::pow(2, vx().bexp + 5).int() ∧ -Nat::pow(2, vx().bexp + 5).int() <= ulp1().H())
{
    Finite::veltkamp(vx(), c33(), vg(), vd(), vxh(), ulp1(), 5, True, NearestEven, Rat::le_antisymm(trivial, trivial), trivial, trivial, trivial, trivial,
        refl, refl, refl, refl)
}
// The last two steps may round in any mode, and a negative `x` splits the
// same way, negated.
theorem vk_split_neg(): (-vxh()).val() + (-ulp1()).val() ≈ (-vx()).val() {
    (Finite::veltkamp(-vx(), c33(), -vg(), -vd(), -vxh(), -ulp1(), 5, True, TowardPos, Rat::le_antisymm(trivial, trivial), trivial, trivial, trivial, trivial,
        refl, refl, refl, refl)).left
}
// Negative control: with `d` rounded toward zero, d = -1536 · 2^-5, xh =
// 49 · 2^-5 and xl = -31 · 2^-10, past half the spacing (16 · 2^-10) of xh's grid.
fn vd_rz() → Finite(binary16()) { h16(True, 1536, 19, trivial) }
fn vxh_rz() → Finite(binary16()) { h16(False, 1568, 14, trivial) }
fn vxl_rz() → Finite(binary16()) { h16(True, 1984, 8, trivial) }
theorem vk_d_rz(): vx().sub(vg(), mode := TowardZero) = Float::Fin(vd_rz()) { refl }
theorem vk_xh_rz(): vg().add(vd_rz()) = Float::Fin(vxh_rz()) { refl }
theorem vk_xl_rz(): vx().sub(vxh_rz()) = Float::Fin(vxl_rz()) { refl }
theorem vk_needs_nearest(): ¬(-Nat::pow(2, vx().bexp + 5).int() <= vxl_rz().H()) {
    λ h => {
        let e: (vxl_rz().H() = -1015808) = refl;
        let p: (Nat::pow(2, vx().bexp + 5).int() = 524288) = refl;
        omega(h, e, p)
    }
}

// ---------------------------------------------------------------------------
// Fast2Sum at a format without infinities (issues/float-fast2sum-saturated.md):
// a nearest rounding past the largest float saturates to it, and that is
// still a nearest float, so Fast2Sum gives the overflow error exactly.

// E4M3: 416 + 64 = 480 is past 448, the largest float (its NaN takes the
// next code), and saturates to it; `z = 448 - 416 = 32` and `t = 64 - 32`
// is the overflow error 32, exactly.
fn e4(m, b: Nat, ok: e4m3().canonical(m, b).IsTrue()) → Finite(e4m3()) { Finite(False, m, b, ok) }
theorem e4m3_f2s_s(): (e4(13, 14, trivial)).add(e4(8, 12, trivial)) = Float::Fin(e4(14, 14, trivial)) { refl }
theorem e4m3_f2s_exact(): (e4(14, 14, trivial)).val() + (e4(8, 11, trivial)).val() ≈ (e4(13, 14, trivial)).val() + (e4(8, 12, trivial)).val() {
    Finite::fast_two_sum_exact(e4(13, 14, trivial), e4(8, 12, trivial), e4(14, 14, trivial), e4(8, 11, trivial), e4(8, 11, trivial),
        True, NearestEven, trivial, refl, refl, refl)
}

// E2M1: 4 + 4 = 8 saturates to 6; `z = 2` and `t = 2` is the error.
fn e2(m, b: Nat, ok: e2m1().canonical(m, b).IsTrue()) → Finite(e2m1()) { Finite(False, m, b, ok) }
theorem e2m1_f2s_s(): (e2(2, 2, trivial)).add(e2(2, 2, trivial)) = Float::Fin(e2(3, 2, trivial)) { refl }
theorem e2m1_f2s_exact(): (e2(3, 2, trivial)).val() + (e2(2, 1, trivial)).val() ≈ (e2(2, 2, trivial)).val() + (e2(2, 2, trivial)).val() {
    Finite::fast_two_sum_exact(e2(2, 2, trivial), e2(2, 2, trivial), e2(3, 2, trivial), e2(2, 1, trivial), e2(2, 1, trivial),
        True, NearestEven, trivial, refl, refl, refl)
}

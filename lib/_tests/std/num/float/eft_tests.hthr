// Probes of `lib/std/num/float/eft.hthr`: the error-free transformations at
// binary16, by evaluation and by citing the theorems, with negative controls
// for each hypothesis. Tests, not library: nothing outside lib/_tests imports
// this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import int; import omega; import rat;
import dyadic; import float; import round; import arith; import eft;
fn h16(neg: Bool, m, b: Nat, ok: binary16().canonical(m, b).IsTrue()) → Finite(binary16()) { Finite(neg, m, b, ok) }
fn one() → Finite(binary16()) { h16(False, 1024, 14, trivial) }
fn three() → Finite(binary16()) { h16(False, 1536, 15, trivial) }
fn two() → Finite(binary16()) { h16(False, 1024, 15, trivial) }
// 1 + 2^-10, the float after 1.
fn one_up() → Finite(binary16()) { h16(False, 1025, 14, trivial) }
// 3 · 2^-12, below half an ulp of 1 plus a quarter.
fn b3() → Finite(binary16()) { h16(False, 1536, 3, trivial) }
// 2^-10 and -2^-12.
fn ulp1() → Finite(binary16()) { h16(False, 1024, 4, trivial) }
fn neg_q() → Finite(binary16()) { h16(True, 1024, 2, trivial) }
// The least subnormal, 2^-24.
fn tiny() → Finite(binary16()) { h16(False, 1, 0, trivial) }

// Sterbenz: 3 - 2 at any mode, from the theorem.
theorem sterbenz_three_two(): (three().sub(two(), mode := TowardPos)).Exact(three().val() - two().val()) {
    Finite::sterbenz(three(), two(), TowardPos, trivial, trivial)
}
// Negative control: 1 - 3·2^-12 is outside `y/2 <= x <= 2y` and is not exact
// (it is a tie, and rounds to 2046 · 2^-11).
theorem sterbenz_needs_range(): ¬(one().sub(b3())).Exact(one().val() - b3().val()) {
    λ ex => {
        let c: (one().sub(b3()) = Float::Fin(h16(False, 2046, 13, trivial))) = refl;
        let e: (h16(False, 2046, 13, trivial).val() ≈ one().val() - b3().val()) = j(c, λ o _ => o.Exact(one().val() - b3().val()), ex);
        Rat::not_le_of_lt(x := h16(False, 2046, 13, trivial).val(), y := one().val() - b3().val(), h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// Fast2Sum on 1 + 3·2^-12: s = 1 + 2^-10, z = 2^-10, t = -2^-12.
theorem f2s_s(): one().add(b3()) = Float::Fin(one_up()) { refl }
theorem f2s_z(): one_up().sub(one()) = Float::Fin(ulp1()) { refl }
theorem f2s_t(): b3().sub(ulp1()) = Float::Fin(neg_q()) { refl }
theorem f2s_exact(): one_up().val() + neg_q().val() ≈ one().val() + b3().val() {
    Finite::fast_two_sum_exact(one(), b3(), one_up(), ulp1(), neg_q(), True, NearestEven, trivial, refl, refl, refl)
}
// The second step under a directed mode is still exact.
theorem f2s_err_up(): (b3().sub(ulp1(), mode := TowardPos)).Exact((one().val() + b3().val()) - one_up().val()) {
    Finite::fast_two_sum_err(one(), b3(), one_up(), ulp1(), True, TowardPos, refl, refl)
}
// Negative control: with |b| > |a| the first step is not exact: 1 + 2^-24
// rounds to 1, and 1 - 2^-24 needs 24 bits.
theorem f2s_needs_order(): ¬(one().sub(tiny())).Exact(one().val() - tiny().val()) {
    λ ex => {
        let c: (one().sub(tiny()) = Float::Fin(one())) = refl;
        let e: (one().val() ≈ one().val() - tiny().val()) = j(c, λ o _ => o.Exact(one().val() - tiny().val()), ex);
        Rat::not_le_of_lt(x := one().val() - tiny().val(), y := one().val(), h := trivial)(Rat::le_of_same(e))
    }
}

// The error of a nearest sum is a float...
theorem err_near(): ∃ f: Finite(binary16()), f.val() ≈ (one().val() + b3().val()) - one_up().val() {
    Finite::add_error(one(), b3(), one_up(), True, refl)
}
// ...and negative control: the error of a directed one need not be. 1 + 2^-24
// rounds up to 1 + 2^-10, and 2^-24 - 2^-10 has 14 significant bits.
theorem err_up_add(): one().add(tiny(), mode := TowardPos) = Float::Fin(one_up()) { refl }
theorem err_up_not_float(): ¬(∃ f: Finite(binary16()), f.val() ≈ (one().val() + tiny().val()) - one_up().val()) {
    λ r => {
        let v = (one().val() + tiny().val()) - one_up().val();
        let ex = (binary16()).round_rat_of_rep(NearestEven, v, r);
        let c: ((binary16()).round_rat(NearestEven, v) = Float::Fin(h16(True, 1024, 4, trivial))) = refl;
        let e: (h16(True, 1024, 4, trivial).val() ≈ v) = j(c, λ o _ => o.Exact(v), ex);
        Rat::not_le_of_lt(x := h16(True, 1024, 4, trivial).val(), y := v, h := trivial)(Rat::le_of_same(Rat::same_sym(e)))
    }
}

// Vacuity controls: `Exact` names its value, so a citation at another value
// is refused.
// expect-error(mismatch)
theorem sterbenz_not_sum(): (three().sub(two())).Exact(three().val() + two().val()) { Finite::sterbenz(three(), two(), NearestEven, trivial, trivial) }
// expect-error(mismatch)
theorem f2s_not_sum({F: Format}, a, b, s: Finite(F), le: b.val().abs() <= a.val().abs(), hs: a.add(b) = Float::Fin(s)):
    (s.sub(a)).Exact(s.val() + a.val())
{
    Finite::fast_two_sum(a, b, s, True, NearestEven, le, hs)
}

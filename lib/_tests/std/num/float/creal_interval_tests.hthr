// Probes of `lib/std/num/float/creal_interval.hthr`: enclosures of reals
// from their terms, containment at `CReal`, and comparisons of reals decided
// by evaluation. Tests, not library: nothing outside lib/_tests imports this
// module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import int; import rat; import creal; import dyadic; import interval; import creal_interval;

// Reals given by their sequences: a product reads its factors far out, so
// its terms are not its factors' terms.
fn third() → CReal { CReal::ofRat(Rat(1, 3)) }
fn ninth() → CReal { third() * third() }

// A real's enclosure is its term, widened by the rate and rounded outward:
// at index 1023 and 16 bits a third is [43562, 43820] · 2^-17, just outside
// [1/3 - 1/1024, 1/3 + 1/1024].
theorem third_at_1023(): third().enclose(1023, 16) = Bnd(Dyadic(43562, -17), Dyadic(43820, -17)) { refl }
theorem enclose_contract(x: CReal, n, p: Nat): x.enclose(n, p).HasReal(x) { x.enclose_has(n, p) }

// Two reals compared by their enclosures: a ninth is below an eighth once
// the terms are read far enough out that 1/(n+1) is under half the gap of
// 1/72, and not at index 15.
theorem ninth_lt_eighth(): ninth() < CReal::ofRat(Rat(1, 8)) { CReal::lt_of_enclose(ninth(), CReal::ofRat(Rat(1, 8)), 1023, 16, refl) }
// expect-error(kernel): the kernel rejected `ninth_lt_eighth_near`: NotConvertible
theorem ninth_lt_eighth_near(): ninth() < CReal::ofRat(Rat(1, 8)) { CReal::lt_of_enclose(ninth(), CReal::ofRat(Rat(1, 8)), 15, 16, refl) }

// The checker: rational leaves are exact, real leaves enclosed from their
// terms; the search reads further out on a miss.
theorem two_thirds_lt_one(): third() + third() < CReal::ofRat(1) {
    RealExpr::lt_of_search(RAdd(RReal(third()), RReal(third())), RRat(1), 63, 16, 1, refl)
}
theorem refined(): ninth() < CReal::ofRat(Rat(1, 8)) { RealExpr::lt_of_search(RReal(ninth()), RRat(Rat(1, 8)), 7, 16, 6, refl) }
// expect-error(kernel): the kernel rejected `unrefined`: NotConvertible
theorem unrefined(): ninth() < CReal::ofRat(Rat(1, 8)) { RealExpr::lt_of_search(RReal(ninth()), RRat(Rat(1, 8)), 7, 16, 2, refl) }

// Arithmetic over real leaves: (1 + 1/100)^100 < 3 with the step a real.
fn step() → CReal { CReal::ofRat(Rat(1, 100)) }
theorem compound_lt_3(): (CReal::ofRat(1) + step()).npow(100) < CReal::ofRat(3) {
    RealExpr::lt_of_search(RPow(RAdd(RRat(1), RReal(step())), 100), RRat(3), 1023, 32, 1, refl)
}
theorem le_neg_mul(): -(third() * CReal::ofRat(2)) <= CReal::ofRat(Rat(-1, 2)) {
    RealExpr::le_of_search(RNeg(RMul(RReal(third()), RRat(2))), RRat(Rat(-1, 2)), 1023, 16, 1, refl)
}

// The negative control: enclosures never decide an equality, so `x <= x` for
// a real leaf is refused at every index although it is true.
// expect-error(kernel): the kernel rejected `third_le_third`: NotConvertible
theorem third_le_third(): third() <= third() { RealExpr::le_of_search(RReal(third()), RReal(third()), 1023, 16, 4, refl) }

// Containment at `CReal` through each operation, at open arguments.
theorem mul_contract(I, J: Interval, p: Nat, x, y: CReal, hx: I.HasReal(x), hy: J.HasReal(y)): I.mul(J, p).HasReal(x * y) { Interval::mul_has_real(I, J, p, hx, hy) }
theorem encloses(e: RealExpr, n, p: Nat): e.enclose(n, p).HasReal(e.eval()) { e.enclose_has(n, p) }

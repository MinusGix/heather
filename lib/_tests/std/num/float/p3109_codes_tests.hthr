// Probes of `lib/std/num/float/p3109_codes.hthr`: every code point of the
// P3109 formats below decodes to the value the P3109 working group's value
// tables give (`Value Tables/Hexadecimal/K*/…csv` in github.com/P3109/Public,
// interim report v4.1), and encodes back to itself. The lists are generated
// from the CSV files: each entry is `WFin(negative, m, e)` for `±m·2^e`,
// `WPinf`, `WNinf` or `WNaN`. Tests, not library: nothing outside lib/_tests
// imports this module (docs/test-value-audit.md §4.5).
import logic; import bool; import nat; import option; import int; import omega; import rat;
import dyadic; import float; import round; import p3109; import p3109_codes;

inductive Want { WFin(neg: Bool, m: Nat, e: Int), WPinf, WNinf, WNaN }

fn rat_eq_bit(x, y: Rat) → Bool { match x.le_dec(y) { Inl(_) => match y.le_dec(x) { Inl(_) => True, Inr(_) => False }, Inr(_) => False } }

fn nat_eq_bit(a, b: Nat) → Bool { match a.eq_dec(b) { Inl(_) => True, Inr(_) => False } }

fn signed_of(neg: Bool, m: Nat) → Int { match neg { False => m.int(), True => -m.int() } }

fn want_ok({F: Format}, r: Float(F), w: Want) → Bool {
    match w {
        WFin(ng, m, e) => match r { Fin(f) => rat_eq_bit(f.val(), Dyadic(signed_of(ng, m), e).rat()), Inf(_, _) => False, NaN(_) => False },
        WPinf => match r { Fin(_) => False, Inf(n, _) => !n, NaN(_) => False },
        WNinf => match r { Fin(_) => False, Inf(n, _) => n, NaN(_) => False },
        WNaN => match r { Fin(_) => False, Inf(_, _) => False, NaN(_) => True },
    }
}

// Code `n` and the codes after it match the list, and each encodes back.
fn table_ok({F: Format}, L: P3109Layout(F), ws: List<Want>) → Nat → Bool {
    match ws {
        Nil => λ _ => True,
        Cons(w, t) => λ n => want_ok(L.decode(n), w) && nat_eq_bit(L.encode(L.decode(n)), n) && table_ok(L, t)(n + 1),
    }
}

// The bijection theorems at a format, on open codes and data.
fn l8p3se() → P3109Layout(binary8p3se()) { Format::p3109_layout(8, 3, Signed, ExtendedDomain, trivial, trivial) }
theorem l8p3se_codes(n: Nat, lt: n < 256): l8p3se().encode(l8p3se().decode(n)) = n { l8p3se().encode_decode(n, lt) }
theorem l8p3se_data(r: Float(binary8p3se())): Float::SameDatum(l8p3se().decode(l8p3se().encode(r)), r) { l8p3se().decode_encode(r, trivial) }
fn l8p3ue() → P3109Layout(binary8p3ue()) { Format::p3109_layout(8, 3, Unsigned, ExtendedDomain, trivial, trivial) }
theorem l8p3ue_datum(n: Nat): (l8p3ue().decode(n)).Unsigned() { l8p3ue().decode_datum(n) }
// Both zeros encode as 0 (design D1), and `-0` comes back as the value 0.
theorem l8p3se_negzero(): l8p3se().encode(Float::Fin(Finite::zero(binary8p3se(), True))) = 0 { refl }

// For every valid format at once (issues/float-p3109-layout-generic.md).
theorem every_format_codes(K, P: Nat, s: Signedness, d: Domain, v: Format::P3109Params(K, P, s), n: Nat, lt: n < Nat::pow(2, K)):
    (Format::p3109_layout_of(K, P, s, d, v)).encode((Format::p3109_layout_of(K, P, s, d, v)).decode(n)) = n
{
    (Format::p3109_layout_of(K, P, s, d, v)).encode_decode(n, lt)
}
theorem every_format_data(K, P: Nat, s: Signedness, d: Domain, v: Format::P3109Params(K, P, s), r: Float(Format::p3109(K, P, s, d)),
    dat: (Format::p3109_layout_of(K, P, s, d, v)).Datum(r)):
    Float::SameDatum((Format::p3109_layout_of(K, P, s, d, v)).decode((Format::p3109_layout_of(K, P, s, d, v)).encode(r)), r)
{
    (Format::p3109_layout_of(K, P, s, d, v)).decode_encode(r, dat)
}
// The constraints close by evaluation at a literal format.
theorem b16p11se_params(): Format::P3109Params(16, 11, Signed) { And(trivial, And(trivial, trivial)) }

// generated by scripts/p3109-tables from the P3109 value tables; do not edit by hand.

fn b3p1se() → P3109Layout(Format::p3109(3, 1, Signed, ExtendedDomain)) { Format::p3109_layout(3, 1, Signed, ExtendedDomain, trivial, trivial) }
theorem b3p1se_table(): table_ok(b3p1se(), [WFin(False, 0, 0), WFin(False, 1, -1), WFin(False, 1, 0), WPinf, WNaN, WFin(True, 1, -1), WFin(True, 1, 0), WNinf])(0) = True { refl }
theorem b3p1se_count(): Nat::pow(2, 3) = 8 { refl }

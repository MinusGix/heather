// Probes of `lib/std/num/rat.hthr`: theorems that pin the concept down at
// specific values and restate the contract at open ones. Tests, not library:
// nothing outside lib/_tests imports this module (docs/test-value-audit.md
// §4.5). Moved from crates/elab/tests/lib_std_rat.rs; the refusals that need
// the checker stay there.
import logic; import bool; import nat; import list; import int; import algebra; import omega; import ring;
import rat; import order; import relation; import relation_props; import algebra_rel; import semiring; import ordered_field;

// Instance resolution finds the registered dictionaries at `Rat`: the
// equivalence, the strict order's transitivity, and `Decide` for `if`.
theorem resolved(x, y, z: Rat, a: x ≈ y, b: y ≈ z): x ≈ z { relation_step(Rat::Same, x, y, z, a, b) }
theorem resolved_lt(x, y, z: Rat, a: x < y, b: y < z): x < z { relation_step(Rat::Lt, x, y, z, a, b) }
fn larger(x, y: Rat) → Rat { if x <= y { y } else { x } }

// `≈` is not identity: 1/2 and 2/4 are the same number, and different pairs.
theorem half_same(): Rat(OfNat(1), 2) ≈ Rat(OfNat(2), 4) { refl }
theorem half_not_equal(): ¬(Rat(OfNat(1), 2) = Rat(OfNat(2), 4)) {
    λ h => {
        let nums: (Int::OfNat(1) = Int::OfNat(2)) = cong_fn(λ (x: Rat) => x.num, h);
        omega(nums)
    }
}
theorem half_not_two_thirds(): ¬(Rat(OfNat(1), 2) ≈ Rat(OfNat(2), 3)) { λ h => omega(h) }

// The raw reciprocal sends 0 to 0, so 0 · recip(0) is 0, not 1.
theorem zero_recip_not_one(): ¬(0 * Rat::recip(0) ≈ 1) { λ h => omega(h) }

// `x⁻¹` and `x ^ n` (docs/inverse-power-notation-design.md): the hypothesis
// is searched at the call, from a local apartness, a local sign, a product or
// power of those, or a literal; the integer power's side condition computes
// from the exponent's sign. A neutral and a literal base, a neutral and a
// literal exponent, inference and checking positions.
theorem from_apart(x: Rat, h: x.Apart(0)): x * x⁻¹ ≈ 1 { x.mul_inv() }
theorem from_positive(x: Rat, h: 0 < x): x⁻¹ * x ≈ 1 { x.inv_mul() }
theorem from_negative(x: Rat, h: x < 0): x ^ (-1) ≈ x⁻¹ { x.pow_neg_one() }
theorem of_product(x, y: Rat, hx: x.Apart(0), hy: 0 < y): (x * y) * (x * y)⁻¹ ≈ 1 { (x * y).mul_inv() }
theorem of_inverse(x: Rat, h: x.Apart(0)): x⁻¹ * x⁻¹⁻¹ ≈ 1 { x⁻¹.mul_inv() }
theorem of_power(x: Rat, h: x.Apart(0), k: Nat): (x ^ NegSucc(k)).Apart(0) { Rat::apart_pow() }
fn half() → Rat { 2⁻¹ }
theorem half_value(): half() ≈ Rat(OfNat(1), 2) { refl }
theorem neg_third(): (-3)⁻¹ ≈ Rat(-OfNat(1), 3) { refl }
theorem quarter(): Rat::Same(2 ^ (-2) * 4, 1) { refl }
theorem square(x: Rat): x ^ 2 ≈ x * x { x.pow_two() }
theorem nat_exponent(x: Rat, n: Nat): x ^ OfNat(n) = x.npow(n) { refl }
theorem neutral_negative(x: Rat, h: x.Apart(0), k: Nat): x ^ NegSucc(k) ≈ (x ^ OfNat(Succ(k)))⁻¹ { x.pow_negSucc_inv(k) }
// `^` binds tighter than negation.
theorem precedence(x: Rat): -x ^ 2 = -(x ^ 2) { refl }
theorem any_proof(x: Rat, h, h2: x.Apart(0)): x.inv(h := h) = x.inv(h := h2) { refl }
theorem checked(x: Rat, h: 0 < x): 1 ≈ x * x⁻¹ { Rat::same_sym(x.mul_inv()) }

// `a / b` (docs/division-design.md) asks for `b.Apart(0)` as `b⁻¹` does. The
// search reads a local apartness, sign or `¬(b ≈ 0)`; a closed divisor by
// computation; the sign rules through sums, products, quotients, inverses,
// powers, squares and absolute values; and last `nlinarith` over the
// hypotheses. Neutral and literal divisors, and refusals at a divisor with
// nothing known, at 0, and at a structural `¬(b = 0)`.
theorem div_is_mul_inv(a, b: Rat, h: 0 < b): a / b = a * b⁻¹ { refl }
theorem div_cancels(a, b: Rat, h: b.Apart(0)): (a / b) * b ≈ a { a.div_mul_cancel(b) }
theorem div_from_nonzero(a, b: Rat, h: ¬(b ≈ 0)): (a * b) / b ≈ a { a.mul_div_cancel(b) }
theorem div_from_negative(b: Rat, h: b < 0): b / b ≈ 1 { b.div_self() }
fn div_half() → Rat { 1 / 2 }
theorem div_half_value(): div_half() ≈ Rat(OfNat(1), 2) { refl }
theorem div_closed_divisor(): Rat::Same(3 / (4 - 1), 1) { refl }
theorem div_negative_literal(): Rat::Same(1 / (-2), Rat(-OfNat(1), 2)) { refl }
fn div_of_sum(a, b, c: Rat, hb: 0 < b, hc: 0 < c) → Rat { a / (b + c) }
fn div_of_mixed_product(a, b, c: Rat, hb: b < 0, hc: 0 < c) → Rat { a / (b * c) }
fn div_of_quotient(a, b, c: Rat, hb: 0 < b, hc: c < 0) → Rat { a / (b / c) }
fn div_of_inverse_sum(a, b: Rat, hb: 0 < b) → Rat { a / (b⁻¹ + 1) }
fn div_of_power(a, b: Rat, hb: 0 < b) → Rat { a / (b ^ 3 + 1) }
fn div_of_square(a, b: Rat) → Rat { a / (b ^ 2 + 1) }
fn div_of_self_product(a, b, c: Rat, hc: 0 < c) → Rat { a / (b * b + c) }
fn div_of_abs(a, b: Rat) → Rat { a / (b.abs() + 1) }
fn div_of_gap(a, b, c: Rat, h: b < c) → Rat { a / (c - b) }
fn div_of_negative_gap(a, b, c: Rat, h: b < c) → Rat { a / (b - c) }
fn div_of_bound(a, b: Rat, h: 1 <= b) → Rat { a / b }
fn div_of_shifted(a, b: Rat, h: b < -1) → Rat { a / (b + 1) }
fn div_of_product_bound(a, b, c: Rat, hb: 1 < b, hc: 1 < c) → Rat { a / (b * c - 1) }
fn div_of_gap_product(a, b, c, d: Rat, h: b < c, hd: 0 < d) → Rat { a / ((c - b) * d) }
theorem div_laws(a, c, b: Rat, h: 0 < b): (a + c) / b ≈ a / b + c / b ∧ (a * c) / b ≈ a * (c / b) {
    And(a.add_div(c, b), a.mul_div_assoc(c, b))
}
theorem div_products(a, b, c, d: Rat, hb: 0 < b, hd: d.Apart(0)): (a / b) * (c / d) ≈ (a * c) / (b * d) { a.div_mul_div(b, c, d) }
// expect-error: no instance for `Apart(b, ofInt(OfNat(0)))`
fn div_unknown(a, b: Rat) → Rat { a / b }
// expect-error: no instance for `Apart(ofInt(OfNat(0)), ofInt(OfNat(0)))`
fn div_zero(a: Rat) → Rat { a / 0 }
// `=` at `Rat` is the pair's: `Rat(0, 2)` is not `Rat(0, 1)` but is ≈ 0.
// expect-error: no instance for `Apart(b, ofInt(OfNat(0)))`
fn div_structural_ne(a, b: Rat, h: ¬(b = 0)) → Rat { a / b }
// Arithmetic at the sign rules' leaves: `c - b` is positive by `nlinarith`
// inside the sum, and a positive local is nonnegative by `linarith`.
fn div_arith_leaf(a, b, c, e: Rat, h: b < c) → Rat { a / ((c - b) + e.abs()) }
fn div_positive_as_nonneg(a, x, y: Rat, hx: 0 < x, hy: 0 <= y) → Rat { a / (x * y + x) }
// A product of unknowns is not apart from zero.
// expect-error: no instance for `Apart(mul(b, b), ofInt(OfNat(0)))`
fn div_square_unknown(a, b: Rat) → Rat { a / (b * b) }
// A written sign goal reaches the sign rules (`lt_of_positive`).
theorem positivity_of_quotient(a, b: Rat, ha: 0 < a, hb: 0 < b): 0 < a / b { positivity }
theorem positivity_of_square_sum(a, b: Rat, hb: 0 < b): 0 <= a * a + b { positivity }
fn wants_positive(x: Rat, h: 0 < x := infer) → Rat { x }
fn passes_positive(b: Rat, hb: 0 < b) → Rat { wants_positive(b * b + b) }

// A denominator carries its positivity: a local fact or a product of
// denominators is found, and the fact reads back through `den_positive`.
fn local(k: Nat, h: 0 < k) → Rat { Rat(OfNat(1), k) }
fn product(x, y: Rat) → Rat { Rat(x.num, x.den * y.den) }
theorem positive(x: Rat): 0 < x.den { Rat::den_positive() }

// `<` is strict: 1/2 is not below 2/4, but is below 3/4; and `≤` is not `<`.
theorem half_lt_three_quarters(): Rat(OfNat(1), 2) < Rat(OfNat(3), 4) { omega }
theorem half_not_lt_two_quarters(): ¬(Rat(OfNat(1), 2) < Rat(OfNat(2), 4)) { λ h => omega(h) }
theorem le_is_not_lt(): ¬((x, y: Rat) → x <= y → x < y) { λ h => Rat::lt_irrefl(0, h(0, 0, Rat::le_refl(0))) }

// Equal fractions share a numerator sign: at a neutral pair, and the inverse
// it feeds at a literal negative pair (-1/2 ≈ -2/4, so their inverses agree).
theorem num_neg(x, y: Rat, h: x ≈ y, hx: x.num < OfNat(0)): y.num < OfNat(0) { Rat::num_neg_of_same(h, hx) }
theorem recip(): Rat(NegSucc(0), 2).recip() ≈ Rat(NegSucc(1), 4).recip() {
    Rat::recip_parts_respects(NegSucc(0), 2, NegSucc(1), 4, refl)
}

// `calc` over `<=` and `<` (`issues/calc-over-order-relations.md`): each
// adjacent pair composes by its own lemma, so a chain may mix `=`, `≈`, `<=`
// and `<`, and proves the strongest relation it used.
theorem le3(x, y, z, w: Rat, a: x <= y, b: y <= z, c: z <= w): x <= w { calc { x <= y := a, <= z := b, <= w := c } }
theorem lt3(x, y, z, w: Rat, a: x < y, b: y < z, c: z < w): x < w { calc { x < y := a, < z := b, < w := c } }
theorem mixed(x, y, z, w: Rat, a: x ≈ y, b: y < z, c: z <= w): x < w { calc { x ≈ y := a, < z := b, <= w := c } }
theorem same_last(x, y, z: Rat, a: x <= y, b: y ≈ z): x <= z { calc { x <= y := a, ≈ z := b } }
theorem eqs(x, y, z, w: Rat, a: x = y, b: y < z, c: z = w): x < w { calc { x = y := a, < z := b, = w := c } }
theorem refl_step(x, y: Rat, a: x + 0 <= y): x + 0 <= y { calc { x + 0 = x + 0 := refl, <= y := a } }
theorem one(x, y: Rat, a: x < y): x < y { calc { x < y := a } }
theorem nat_mixed(x, y, z, w: Nat, a: x < y, b: y <= z, c: z < w): x < w { calc { x < y := a, <= z := b, < w := c } }
theorem int_mixed(x, y, z: Int, a: x <= y, b: y < z): x < z { calc { x <= y := a, < z := b } }

// |x| is not x: -1/2 has absolute value 1/2.
theorem abs_neg_half(): Rat(NegSucc(0), 2).abs() ≈ Rat(OfNat(1), 2) { refl }
theorem abs_not_identity(): ¬((x: Rat) → x.abs() ≈ x) { λ h => omega(h(Rat(NegSucc(0), 2))) }

// ---------------------------------------------------------------------------
// `rewrite` along `≈` (docs/equation-rewrite-design.md §9): a proof of
// `x ≈ y` turns `x` into `y` through `+` and `*` (their `Respects2`
// instances), on either side of `≈` (the right side through `≈`'s
// symmetry), and inside `<=` through the `Trans` pairs `calc` chains with.
theorem rewrite_left(x, y, z: Rat, h: x ≈ y, e: y + z ≈ z): x + z ≈ z { rewrite(h, e) }
theorem rewrite_right(x, y, z: Rat, h: x ≈ y, e: z ≈ y * z): z ≈ x * z { rewrite(h, e) }
theorem rewrite_both(x, y: Rat, h: x ≈ y): x + x ≈ y + y { rewrite(h, refl) }
theorem rewrite_into_le(x, y, z: Rat, h: x ≈ y, e: y + z <= z): x + z <= z { rewrite(h, e) }
// An unapplied law finds its instance; the other argument of `*` stays, by
// `≈`'s reflexivity.
theorem rewrite_law(x, z: Rat, e: x * z ≈ z): (x + 0) * z ≈ z { rewrite(Rat::add_zero, e) }
// A hypothesis is carried the other way: from what it says to the rewrite.
theorem rewrite_hypothesis(x, y, z: Rat, h: x ≈ y, e: x + z ≈ z): y + z ≈ z { rewrite(h, in := e) }
// An implication's premise is rewritten against its conclusion's direction.
theorem rewrite_implication(x, y, z: Rat, h: x ≈ y, e: y ≈ z → y + y ≈ z): x ≈ z → x + x ≈ z { rewrite(h, e) }
// `Rat::add_neg_cancel_r`'s `calc` chain, as three rewrites.
theorem rewrite_chain(x, y: Rat): (x + y) + -y ≈ x { rewrite(x.add_assoc(y, -y), y.add_neg(), x.add_zero(), refl) }

// The case is checked at the rewritten goal, not at the original.
// expect-error(mismatch)
theorem rewrite_checks_its_case(x, y, z: Rat, h: x ≈ y, e: x + z ≈ z): x + z ≈ z { rewrite(h, e) }
// Direction is the written one: a goal holding only the right side is refused.
// expect-error: does not mention the relation's left side
theorem rewrite_not_reversed(x, y, z: Rat, h: x ≈ y, e: y + z ≈ z): y + z ≈ z { rewrite(h, e) }
// `=` does not respect `≈`, so an equation goal is not rewritten along it.
// expect-error: is not a relation application `S(l, r)`
theorem rewrite_into_equation(x, y: Rat, h: x ≈ y, e: y.num = y.num): x.num = x.num { rewrite(h, e) }
// Under a binder the two λs are related pointwise (§10), and the binder's
// consumer crosses that relation by evidence: given here, an obligation when
// missing.
theorem rewrite_under_binder(x, y: Rat, h: x ≈ y, f: (Rat → Rat) → Rat,
    c: PreservesRelation(Pointwise<Rat, Rat>(Rat::Same), Rat::Same, f), e: f(λ z => z + y) ≈ y): f(λ z => z + x) ≈ y { rewrite(h, e) }
// expect-error: ?compatibility : PreservesRelation(Pointwise(Same), Same
theorem rewrite_under_binder_open(x, y: Rat, h: x ≈ y, f: (Rat → Rat) → Rat, e: f(λ z => z + y) ≈ y): f(λ z => z + x) ≈ y { rewrite(h, e) }
// `at :=` numbers tree positions, which a shared walk does not have.
// expect-error: a relation rewrite rewrites every occurrence
theorem rewrite_at(x, y: Rat, h: x ≈ y, e: y + x ≈ x): x + x ≈ x { rewrite(h, e, at := 1) }

// A hypothesis stated at `Rat` pins a generic theorem's indices at `Int`
// through its definition (issues/index-inference-through-unfolding.md):
// `x ≈ y` is `Rat::Same(x, y)`, which unfolds to `cross_same_trans`'s
// `a * d ≈ c * b`. The call's carrier is `Int` from the explicit arguments,
// so `≈ := Rat::Same` read off the hypothesis (or off the goal) does not fit
// the slot and the indices come from `Int`'s designations.
theorem cross_trans_as_stated(x, y, z: Rat, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    OrderedSemiring::cross_same_trans(x.num, x.den.int(), y.num, y.den.int(), z.num, z.den.int(), y.den_pos, hxy, hyz)
}
// The same call with the hypotheses restated at `Int` first.
theorem cross_trans_restated(x, y, z: Rat, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    let h1: (x.num * y.den.int() ≈ y.num * x.den.int()) = hxy;
    let h2: (y.num * z.den.int() ≈ z.num * y.den.int()) = hyz;
    OrderedSemiring::cross_same_trans(x.num, x.den.int(), y.num, y.den.int(), z.num, z.den.int(), y.den_pos, h1, h2)
}
// Negative control: the unfolding does not match. Swapped, `y ≈ z` is not
// `x.num * y.den ≈ y.num * x.den`, and the refusal is at that argument.
// expect-error(mismatch)
theorem cross_trans_swapped(x, y, z: Rat, hxy: x ≈ y, hyz: y ≈ z): x ≈ z {
    OrderedSemiring::cross_same_trans(x.num, x.den.int(), y.num, y.den.int(), z.num, z.den.int(), y.den_pos, hyz, hxy)
}

theorem sha256_blocks_at_120(): Sha2::sha256().blocks(List::replicate(BitVec::zero(), 120)).len() = 3 { refl }

// SHA512's padding: one block up to 111 bytes, two from 112.
theorem sha512_blocks_at_0(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 0)).len() = 1 { refl }
theorem sha512_blocks_at_1(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 1)).len() = 1 { refl }
theorem sha512_blocks_at_111(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 111)).len() = 1 { refl }
theorem sha512_blocks_at_112(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 112)).len() = 2 { refl }
theorem sha512_blocks_at_127(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 127)).len() = 2 { refl }
theorem sha512_blocks_at_128(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 128)).len() = 2 { refl }
theorem sha512_blocks_at_239(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 239)).len() = 2 { refl }
theorem sha512_blocks_at_240(): Sha2::sha512().blocks(List::replicate(BitVec::zero(), 240)).len() = 3 { refl }

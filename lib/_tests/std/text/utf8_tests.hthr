// Probes of `lib/std/text/utf8.hthr`, UTF-8 as the first representation of
// `String` and the `Utf8` byte-level spec type beside it
// (docs/string-char-design.md §5): the encoder at a literal of every byte
// width, the strict decoder at each rejection, every law at a literal and at
// a neutral string, and `¬` theorems for the wrong values. Tests, not
// library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5). Moved from
// crates/elab/tests/lib_std_utf8.rs; the refusals stay there.
import logic; import bool; import nat; import option; import pair;
import list; import bitvec; import char; import string; import utf8; import omega;

// The encoder at a literal of every byte width.
// One byte per class boundary: ASCII, Latin-1, the BMP, and an astral plane.
theorem encode_one_byte(): utf8::encode("a") = [@bitvec::BitVec::ofNat(8, 0x61)] { refl }
theorem encode_two_bytes(): utf8::encode("\u{E9}")
    = [@bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0xA9)] { refl }
theorem encode_three_bytes(): utf8::encode("\u{20AC}")
    = [@bitvec::BitVec::ofNat(8, 0xE2), @bitvec::BitVec::ofNat(8, 0x82), @bitvec::BitVec::ofNat(8, 0xAC)] { refl }
theorem encode_four_bytes(): utf8::encode("\u{1F600}")
    = [@bitvec::BitVec::ofNat(8, 0xF0), @bitvec::BitVec::ofNat(8, 0x9F), @bitvec::BitVec::ofNat(8, 0x98),
       @bitvec::BitVec::ofNat(8, 0x80)] { refl }
// A mixed string is the concatenation of its characters' bytes.
theorem encode_mixed(): utf8::encode("a\u{E9}")
    = [@bitvec::BitVec::ofNat(8, 0x61), @bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0xA9)] { refl }
theorem encode_empty(): utf8::encode("") = Nil<BitVec(8)> { refl }

// The decoder gives those strings back.
theorem decode_one_byte(): utf8::decode([@bitvec::BitVec::ofNat(8, 0x61)]) = Some("a") { refl }
theorem decode_two_bytes(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0xA9)])
    = Some("\u{E9}") { refl }
theorem decode_three_bytes(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xE2), @bitvec::BitVec::ofNat(8, 0x82),
    @bitvec::BitVec::ofNat(8, 0xAC)]) = Some("\u{20AC}") { refl }
theorem decode_four_bytes(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xF0), @bitvec::BitVec::ofNat(8, 0x9F),
    @bitvec::BitVec::ofNat(8, 0x98), @bitvec::BitVec::ofNat(8, 0x80)]) = Some("\u{1F600}") { refl }
theorem decode_empty(): utf8::decode(Nil<BitVec(8)>) = Some("") { refl }

// The decoder is strict at every rejection Rust's `from_utf8` makes.
// An overlong two-byte form of `0x00`: the payload is below the class's
// least legal value.
theorem overlong(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xC0), @bitvec::BitVec::ofNat(8, 0x80)]) = None { refl }
// A lone surrogate, `U+D800` spelled in three bytes: not a scalar value.
theorem surrogate(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xED), @bitvec::BitVec::ofNat(8, 0xA0),
    @bitvec::BitVec::ofNat(8, 0x80)]) = None { refl }
// A three-byte sequence with only two bytes present.
theorem truncated(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xE2), @bitvec::BitVec::ofNat(8, 0x82)]) = None { refl }
// A continuation byte where a lead byte belongs.
theorem stray_continuation(): utf8::decode([@bitvec::BitVec::ofNat(8, 0x80)]) = None { refl }
// `0xF5` starts a sequence above `0x10FFFF`.
theorem above_range(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xF5), @bitvec::BitVec::ofNat(8, 0x80),
    @bitvec::BitVec::ofNat(8, 0x80), @bitvec::BitVec::ofNat(8, 0x80)]) = None { refl }
// A lead byte with no continuation marker after it.
theorem bad_continuation(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0x41)])
    = None { refl }
// `0xF8` is no lead byte at all.
theorem no_class(): utf8::decode([@bitvec::BitVec::ofNat(8, 0xF8)]) = None { refl }
// A rejection anywhere rejects the whole list, not just its tail.
theorem rejection_propagates(): utf8::decode([@bitvec::BitVec::ofNat(8, 0x61), @bitvec::BitVec::ofNat(8, 0x80)])
    = None { refl }

// The round trip, at a literal and at a neutral string.
theorem round_trip_literal(): utf8::decode(utf8::encode("h\u{E9}\u{20AC}\u{1F600}"))
    = Some("h\u{E9}\u{20AC}\u{1F600}") { utf8::decode_encode("h\u{E9}\u{20AC}\u{1F600}") }
// The literal's round trip also computes, with no lemma at all.
theorem round_trip_literal_computes(): utf8::decode(utf8::encode("h\u{E9}")) = Some("h\u{E9}") { refl }
theorem round_trip_neutral(s: String): utf8::decode(utf8::encode(s)) = Some(s) { utf8::decode_encode(s) }
theorem round_trip_half_open(s: String): utf8::decode(utf8::encode("a" ++ s)) = Some("a" ++ s) {
    utf8::decode_encode("a" ++ s)
}
// One character at an OPEN code, which is the case a closed literal hides:
// the decoder's rejections are refuted by the character's own witness and by
// its class's range test, not by computation.
theorem round_trip_one_char(c: Char, rest: List<BitVec(8)>):
    utf8::decode_char(utf8::encode_char(c) ++ rest) = Some(Pair(c, rest))
{ utf8::decode_char_encode_char(c, rest) }

// Encoding is injective and additive, at both kinds of argument.
theorem neutral_injective(s, t: String, p: utf8::encode(s) = utf8::encode(t)): s = t {
    utf8::encode_injective(s, t, p)
}
theorem literal_injective(t: String, p: utf8::encode("hi") = utf8::encode(t)): "hi" = t {
    utf8::encode_injective("hi", t, p)
}
theorem neutral_append(s, t: String):
    utf8::encode(s ++ t) = utf8::encode(s) ++ utf8::encode(t) { utf8::encode_append(s, t) }
theorem half_open_append(s: String):
    utf8::encode(s ++ "a") = utf8::encode(s) ++ [@bitvec::BitVec::ofNat(8, 0x61)] {
    utf8::encode_append(s, "a")
}
theorem literal_append(): utf8::encode("a" ++ "\u{E9}")
    = utf8::encode("a") ++ utf8::encode("\u{E9}") { refl }

// The `Utf8` record carries its bytes and reads back the string.
theorem record_neutral(s: String): utf8::ofString(s).toString() = s { utf8::toString_ofString(s) }
theorem record_literal(): utf8::ofString("h\u{E9}").toString() = "h\u{E9}" {
    utf8::toString_ofString("h\u{E9}")
}
// The byte length and the character length are different measurements, which
// is why this type exists at all.
theorem record_byte_length(): utf8::ofString("h\u{E9}\u{20AC}").len() = 6 {}
theorem record_char_length(): "h\u{E9}\u{20AC}".len() = 3 {}
theorem record_ascii_lengths_agree(): utf8::ofString("hi").len() = "hi".len() { refl }
// The witness is the decision, so an encoded string is valid by construction
// at an open argument too.
theorem record_valid_of_encode(s: String): utf8::utf8_valid(utf8::encode(s)) { utf8::ofString(s).valid }
theorem record_bytes_of_ofString(s: String): utf8::ofString(s).bytes = utf8::encode(s) { refl }

// Decoding a list is decoding its head, then its tail, by computation.
theorem uf1(b: BitVec(7), t: List<BitVec(8)>):
        decode(Cons(ascii_byte(b), t)) = push_char(decode_seq(C1, ascii_byte(b), t), decode(t))
{ refl }
theorem uf2(q: BitVec(5), r: BitVec(6), t: List<BitVec(8)>):
        decode(Cons(lead2_byte(q), Cons(cont_byte(r), t)))
        = push_char(decode_seq(C2, lead2_byte(q), Cons(cont_byte(r), t)), decode(t))
{ refl }
theorem uf3(q: BitVec(4), r, s: BitVec(6), t: List<BitVec(8)>):
        decode(Cons(lead3_byte(q), Cons(cont_byte(r), Cons(cont_byte(s), t))))
        = push_char(decode_seq(C3, lead3_byte(q),
              Cons(cont_byte(r), Cons(cont_byte(s), t))), decode(t))
{ refl }
theorem uf4(q: BitVec(3), r, s, u: BitVec(6), t: List<BitVec(8)>):
        decode(Cons(lead4_byte(q), Cons(cont_byte(r), Cons(cont_byte(s), Cons(cont_byte(u), t)))))
        = push_char(decode_seq(C4, lead4_byte(q),
              Cons(cont_byte(r), Cons(cont_byte(s), Cons(cont_byte(u), t)))), decode(t))
{ refl }
// The one-character decoder is the same call.
theorem uf3c(q: BitVec(4), r, s: BitVec(6), t: List<BitVec(8)>):
        decode(Cons(lead3_byte(q), Cons(cont_byte(r), Cons(cont_byte(s), t))))
        = push_char(decode_char(Cons(lead3_byte(q), Cons(cont_byte(r), Cons(cont_byte(s), t)))),
              decode(t))
{ refl }
// The library's statement, at an open width and code.
theorem step(w: Width, code: Nat, rest: List<BitVec(8)>):
        decode(encode_width(w, code) ++ rest)
            = push_char(decode_char(encode_width(w, code) ++ rest), decode(rest))
{ utf8::decode_step(w, code, rest) }

// A decoded value re-encodes to its bytes.
// Theorem 7 at a literal of each width. The decoding hypothesis computes;
// the conclusion is the theorem's, not `refl`'s.
theorem reencode_one_byte(): utf8::encode("a") = [@bitvec::BitVec::ofNat(8, 0x61)] {
    utf8::encode_decode([@bitvec::BitVec::ofNat(8, 0x61)], "a", refl)
}
theorem reencode_two_bytes(): utf8::encode("\u{E9}") = [@bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0xA9)] {
    utf8::encode_decode([@bitvec::BitVec::ofNat(8, 0xC3), @bitvec::BitVec::ofNat(8, 0xA9)], "\u{E9}", refl)
}
theorem reencode_four_bytes(): utf8::encode("\u{1F600}")
    = [@bitvec::BitVec::ofNat(8, 0xF0), @bitvec::BitVec::ofNat(8, 0x9F), @bitvec::BitVec::ofNat(8, 0x98), @bitvec::BitVec::ofNat(8, 0x80)] {
    utf8::encode_decode([@bitvec::BitVec::ofNat(8, 0xF0), @bitvec::BitVec::ofNat(8, 0x9F), @bitvec::BitVec::ofNat(8, 0x98),
        @bitvec::BitVec::ofNat(8, 0x80)], "\u{1F600}", refl)
}
// At a neutral byte list and string, which is the statement: nothing here
// computes, every rejection of the decoder is inverted.
theorem reencode_neutral(bs: List<BitVec(8)>, s: String, p: utf8::decode(bs) = Some(s)):
    utf8::encode(s) = bs { utf8::encode_decode(bs, s, p) }
// One OPEN byte: the class is read off its header bits, not off a literal.
theorem reencode_one_open(b: BitVec(8), s: String, p: utf8::decode([b]) = Some(s)):
    utf8::encode(s) = [b] { utf8::encode_decode([b], s, p) }
// A two-byte sequence with an open tail: the tail is the induction
// hypothesis and the lead pair is rebuilt from their payloads.
theorem reencode_two_open(b, c: BitVec(8), rest: List<BitVec(8)>, s: String,
    p: utf8::decode(Cons(b, Cons(c, rest))) = Some(s)):
    utf8::encode(s) = Cons(b, Cons(c, rest)) { utf8::encode_decode(Cons(b, Cons(c, rest)), s, p) }
// Theorem 8: the two conversions are mutually inverse, so a `Utf8` is
// determined by its bytes exactly as a `Char` is by its code.
theorem reencode_section(u: utf8::Utf8): utf8::ofString(u.toString()) = u { utf8::ofString_toString(u) }
theorem reencode_retraction(s: String): utf8::ofString(s).toString() = s { utf8::toString_ofString(s) }
theorem reencode_determined(u, v: utf8::Utf8, p: u.bytes = v.bytes): u = v { utf8::bytes_injective(u, v, p) }

// The wrong values, as `¬` theorems. Neither byte lists nor decoded options
// have a `Decide` instance, so each is told apart through a function into
// `Nat`: the first byte's value, or whether the decoding is a given string.
fn head_code(bs: List<BitVec(8)>) → Nat { match bs { Nil => 0, Cons(b, _) => b.toNat() + 1 } }
fn decoded_as(want: String, o: Option<String>) → Nat { match o { None => 0, Some(s) => or_pick(string_eq_dec(s, want), 1, 2) } }

theorem a_is_not_b(): ¬(utf8::encode("a") = [@bitvec::BitVec::ofNat(8, 0x62)]) {
    λ h => { let s: (0x62 = 0x63) = cong_fn(head_code, h); omega(s) }
}
// The class boundary is the encoder's own range test: `0x80` is two bytes.
theorem x80_is_two_bytes(): ¬(utf8::encode("\u{80}") = [@bitvec::BitVec::ofNat(8, 0x80)]) {
    λ h => { let s: (0xC3 = 0x81) = cong_fn(head_code, h); omega(s) }
}
theorem decodes_to_a_not_b(): ¬(utf8::decode([@bitvec::BitVec::ofNat(8, 0x61)]) = Some("b")) {
    λ h => { let s: (1 = 2) = cong_fn(λ (o: Option<String>) => decoded_as("b", o), h); omega(s) }
}
// Strictness is not vacuous: a valid list is not rejected ...
theorem valid_is_not_rejected(): ¬(utf8::decode([@bitvec::BitVec::ofNat(8, 0x61)]) = None) {
    λ h => { let s: (1 = 0) = cong_fn(λ (o: Option<String>) => decoded_as("b", o), h); omega(s) }
}
// ... and a rejected list decodes to nothing at all, not even the empty string.
theorem overlong_is_nothing(): ¬(utf8::decode([@bitvec::BitVec::ofNat(8, 0xC0), @bitvec::BitVec::ofNat(8, 0x80)]) = Some("")) {
    λ h => { let s: (0 = 2) = cong_fn(λ (o: Option<String>) => decoded_as("", o), h); omega(s) }
}
theorem stray_is_nothing(): ¬(utf8::decode([@bitvec::BitVec::ofNat(8, 0x80)]) = Some("")) {
    λ h => { let s: (0 = 2) = cong_fn(λ (o: Option<String>) => decoded_as("", o), h); omega(s) }
}
// A byte list that does not decode has no witness, so no `Utf8` value.
theorem stray_has_no_witness(p: utf8::utf8_valid([@bitvec::BitVec::ofNat(8, 0x80)])): False { p }
theorem byte_length_is_not_char_length(): ¬(utf8::ofString("h\u{E9}").len() = 2) { decide }

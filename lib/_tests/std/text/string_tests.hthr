// Probes of `lib/std/text/char.hthr` and `lib/std/text/string.hthr`
// (docs/string-char-design.md): every law at a literal and at a neutral
// string, from a checking position, with a `¬` theorem beside it for the
// wrong value a reader might expect (`docs/testing-generated-terms.md`).
// Tests, not library: nothing outside lib/_tests imports this module
// (docs/test-value-audit.md §4.5). Moved from
// crates/elab/tests/lib_std_string.rs; the refusals stay there.
import logic; import bool; import nat; import list; import char; import string;

// A character is its code and nothing else.
theorem code_decides(a, b: Char, p: a.code = b.code): a = b { code_injective(a, b, p) }
theorem round_trip(code: Nat, p: scalar(code)): ofNat(code, p).toNat() = code { refl }
// The witness is not part of the value: two proofs of the same code build
// the same character. At an OPEN code that is `scalar_unique` through
// `code_injective` rather than a conversion — the witness is relevant
// (docs/string-char-design.md §5.1) — while at a closed one the two proofs
// inhabit `Unit` and are definitionally equal.
theorem witness_irrelevant(code: Nat, p, q: scalar(code)): ofNat(code, p) = ofNat(code, q) {
    code_injective(ofNat(code, p), ofNat(code, q), refl)
}
theorem witness_irrelevant_closed(p, q: scalar(97)): ofNat(97, p) = ofNat(97, q) {}
// The surrogate block and the code past the last scalar are outside `scalar`;
// the codes next to them are inside.
theorem surrogates_excluded(p: scalar(55296)): False { p }
theorem past_the_end_excluded(p: scalar(1114112)): False { p }
theorem boundaries(): scalar(55295) ∧ scalar(57344) ∧ scalar(1114111) { decide }
// The witness is Bool-reflected, so its arithmetic reading is a lemma rather
// than a projection (docs/string-char-design.md §5.1).
theorem sound(code: Nat, p: scalar(code)): code < 0x110000 { scalar_sound(code, p).left }
theorem sound_surrogate(p: scalar(0xD800)): False {
    scalar_sound(0xD800, p).right(And(Nat::le_refl(0xD800), Nat::lt_succ_self(0xD800)))
}

// `nth` reads at a literal and into an open tail, which reduces step by step:
// the length is a `Succ` at every `Cons`, so the `Fin` motive instantiates
// without the tail.
theorem literal_first(): "abc".nth(FZ) = 'a' { refl }
theorem literal_second(): "abc".nth(FS(FZ)) = 'b' { refl }
theorem literal_third(): "abc".nth(FS(FS(FZ))) = 'c' { refl }
theorem first_is_not_second(): ¬("abc".nth(FZ) = 'b') { decide }
theorem open_tail(c: Char, rest: List<Char>): String(chars := Cons(c, rest)).nth(FZ) = c {}
theorem open_tail_second(c, d: Char, rest: List<Char>): String(chars := Cons(c, Cons(d, rest))).nth(FS(FZ)) = d {}
theorem open_tail_step(c: Char, rest: List<Char>, i: Fin(rest.len())):
    String(chars := Cons(c, rest)).nth(FS(i)) = String(chars := rest).nth(i)
{}

// `take` and `drop` rebuild the string, at a literal, a neutral string and a
// neutral index.
theorem split_literal(): string::String::take("abc", 1) ++ string::String::drop("abc", 1) = "abc" { take_drop("abc", 1) }
theorem take_computes(): string::String::take("abc", 1) = "a" {}
theorem drop_computes(): string::String::drop("abc", 1) = "bc" {}
theorem take_is_not_longer(): ¬(string::String::take("abc", 1) = "ab") { decide }
theorem split_neutral(s: String, n: Nat): string::String::take(s, n) ++ string::String::drop(s, n) = s { take_drop(s, n) }
theorem split_neutral_index(n: Nat): string::String::take("abc", n) ++ string::String::drop("abc", n) = "abc" { take_drop("abc", n) }

// Appending adds the lengths.
theorem append_len_literal(): ("ab" ++ "cde").len() = 5 {}
theorem append_literal(): "ab" ++ "cde" = "abcde" { refl }
theorem append_len_is_not_six(): ¬(("ab" ++ "cde").len() = 6) { decide }
theorem append_len_neutral(s, t: String): (s ++ t).len() = s.len() + t.len() { string::len_append(s, t) }
theorem append_len_half_open(s: String): (s ++ "ab").len() = s.len() + 2 { string::len_append(s, "ab") }

// Equality decides at literals and resolves at open endpoints, to the
// declared decider: resolution is what a literal-only test would not see.
theorem literals_agree(): "hi" = "hi" { decide }
theorem literals_differ(): ¬("hi" = "ho") { decide }
theorem lengths_differ(): ¬("hi" = "h") { decide }
theorem empty_differs(): ¬("" = "h") { decide }
theorem chars_agree(): 'a' = 'a' { decide }
theorem chars_differ(): ¬('a' = 'b') { decide }
theorem neutral_instance(s, t: String, a, b: Char): decide_pick<s = t, Char>(a, b) = or_pick(string_eq_dec(s, t), a, b) { refl }
theorem neutral_char_instance(a, b: Char, x, y: Char): decide_pick<a = b, Char>(x, y) = or_pick(char_eq_dec(a, b), x, y) { refl }
theorem neutral_sound(s, t: String, p: s.chars = t.chars): s = t { chars_injective(s, t, p) }

// A type name is expanded where it is read (`u8` is `BitVec(8)` to every
// reader, docs/library/fixed-width-integers-design.md §2), and a diagnostic spells
// the expansion back by the name the program wrote
// (issues/type-name-display-respelling.md): the most recently written name
// that still means it here. Tests, not library: nothing outside lib/_tests
// imports this module (docs/test-value-audit.md §4.5).
import bool; import nat; import int; import bitvec; import sint;

def Byte: Type = BitVec(8);
// Names through other names: a family applied, a name, a family.
def Word: Type = u(16);
def Half: Type = Word;
def unsigned: Nat → Type = u;
// Not a declaration's type constructor: its expansion keeps its spelling.
def Count: Type = Nat;

// A width family at a written width.
// expect-error: this has type `u8`, but `Bool` is expected here
fn unsigned_byte(x: u8) → Bool { x }

// expect-error: this has type `i64`, but `Bool` is expected here
fn signed_word(x: i64) → Bool { x }

// An open width spells the family applied.
// expect-error: this has type `i(n)`, but `Bool` is expected here
fn open_width(n: Nat, x: i(n)) → Bool { x }

// The family covers widths the program did not write that way.
// expect-error: this has type `u16`, but `Bool` is expected here
fn unwritten_width(x: BitVec(16)) → Bool { x }

// A width the display would have to compute stays as it is: the display
// never reduces.
// expect-error: this has type `u(8 + 8)`, but `Bool` is expected here
fn computed_width(x: u8) → Bool { x.zero_extend(8) }

// Inside a type argument, and on the expected side.
// expect-error: this has type `List<u8>`, but `Bool` is expected here
fn in_argument(x: List<u8>) → Bool { x }

// expect-error: this has type `Bool`, but `u8` is expected here
fn expected_side(x: Bool) → u8 { x }

// The program's own name.
// expect-error: this has type `Byte`, but `Bool` is expected here
fn own_name(x: Byte) → Bool { x }

// expect-error: this has type `Word`, but `Bool` is expected here
fn through_family(x: Word) → Bool { x }

// expect-error: this has type `Half`, but `Bool` is expected here
fn through_name(x: Half) → Bool { x }

// expect-error: this has type `unsigned3`, but `Bool` is expected here
fn through_family_alias(x: unsigned(3)) → Bool { x }

// Two names for one type: the one written last.
// expect-error: this has type `u8`, but `Bool` is expected here
fn both_names(x: Byte, y: u8) → Bool { x }

// A local that hides the name: the other name.
// expect-error: this has type `u8`, but `Bool` is expected here
fn hidden(Byte: Nat, x: BitVec(8)) → Bool { x }

// Control: a name for something other than an instance.
// expect-error: this has type `Nat`, but `Bool` is expected here
fn not_an_instance(x: Count) → Bool { x }

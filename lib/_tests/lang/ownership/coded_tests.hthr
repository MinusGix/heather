// Probes of the coded universal value (lib/lang/ownership/coded.hthr,
// issues/ownership-coded-values.md).
import logic;
import bool;
import nat;
import option;
import list;
import list_window;
import span_set;
import store;
import path;
import list_path;
import atom;
import steps;
import omega;
import coded;

// ---------------------------------------------------------------------------
// The decision and the cast at closed codes

theorem dec_closed(): Shape::dec(SSeq(SNamed(3)), SSeq(SNamed(3))) = Inl(refl) { refl }

// A value put back at its own closed code is itself: the decision is
// `Inl(refl)` and the cast the identity, by evaluation.
theorem back_closed(xs: List<List<Nat>>, ys: List<List<Nat>>): Dyn::back(Dyn::no_tys(), SSeq(SSeq(SWord)), Dyn(SSeq(SSeq(SWord)), xs), ys) = xs { refl }

// ---------------------------------------------------------------------------
// A user record and its instance, written by hand

record Point { x: Nat, y: Nat }

fn pt_tys() → Nat → Type { λ k => match k { Zero => Point, Succ(_) => True } }

fn Point::fx() → Field(pt_tys(), Point) { Field(SWord, Path<Point, Nat>(get := λ (p: Point) => Some(p.x), set := λ (p: Point) => λ (v: Nat) => Point(v, p.y))) }

fn Point::fy() → Field(pt_tys(), Point) { Field(SWord, Path<Point, Nat>(get := λ (p: Point) => Some(p.y), set := λ (p: Point) => λ (v: Nat) => Point(p.x, v))) }

fn Point::origin() → Point { Point(0, 0) }

fn pt_strs() → Strs(pt_tys()) {
    λ k => match k { Zero => Fields(Point::origin(), [Point::fx(), Point::fy()]), Succ(_) => Opaque(trivial) }
}

fn pts() → Shape { SSeq(SNamed(0)) }

// ---------------------------------------------------------------------------
// 1. `ps[i].x`

fn get_x(ps: List<Point>, i: Nat) → Nat { ps.nth(i).unwrap_or(Point::origin()).x }

theorem get_x_pin(ps: List<Point>, i: Nat):
    Dyn::word(pt_tys(), Dyn::read(pt_tys(), pt_strs(), Env::start([i]), [SElem(Var(0)), SField(0)], Dyn(pts(), ps))) = get_x(ps, i)
{ refl }

// The control: the same place does not read `.y`.
// expect-error(kernel)
theorem get_x_not_y(ps: List<Point>, i: Nat):
    Dyn::word(pt_tys(), Dyn::read(pt_tys(), pt_strs(), Env::start([i]), [SElem(Var(0)), SField(0)], Dyn(pts(), ps))) = ps.nth(i).unwrap_or(Point::origin()).y
{ refl }

// ---------------------------------------------------------------------------
// Native callees, and the world of their meanings

fn gap(p: Point, ok: p.y <= p.x) → Nat { p.x - p.y }

fn total(qs: List<Point>) → Nat { match qs { Nil => 0, Cons(q, r) => q.x + total(r) } }

fn dyn_at(ds: List<Dyn(pt_tys())>, k: Nat) → Dyn(pt_tys()) { obj_at(pt_tys(), ds, k) }

fn as_point(d: Dyn(pt_tys())) → Point { Dyn::as_code(pt_tys(), pt_strs(), SNamed(0), d) }

fn as_points(d: Dyn(pt_tys())) → List<Point> { Dyn::as_code(pt_tys(), pt_strs(), pts(), d) }

// `gap`'s proof is erased in its meaning: it reads `x - y`.
fn pt_world() → World(pt_tys()) { λ g ds ws => match g { Zero => as_point(dyn_at(ds, 0)).x - as_point(dyn_at(ds, 0)).y, Succ(_) => total(as_points(dyn_at(ds, 0))) } }

// The callees' preconditions, over the values passed.
fn pt_pres() → Pres(pt_tys()) {
    λ g ds ws => match g { Zero => as_point(dyn_at(ds, 0)).y <= as_point(dyn_at(ds, 0)).x, Succ(_) => ∥0 < as_points(dyn_at(ds, 0)).len()∥ }
}

fn mean_pt(f: Func, ps: List<Point>, ws: List<Nat>) → MOut(pt_tys()) { mean_fn(pt_tys(), pt_strs(), pt_world(), f, [Dyn(pts(), ps)], ws) }

fn word_pt(f: Func, ps: List<Point>, ws: List<Nat>) → Nat { mean_word(pt_tys(), pt_strs(), pt_world(), f, [Dyn(pts(), ps)], ws) }

fn due_pt(d: Owes, f: Func, ps: List<Point>, ws: List<Nat>) → Type { d.Due(pt_tys(), pt_strs(), pt_world(), pt_pres(), f, [Dyn(pts(), ps)], ws) }

fn x_of(r: Nat, i: Atom) → Place { Place(r, [SElem(i), SField(0)]) }

// ---------------------------------------------------------------------------
// 1. A read of a field of an element: `ps[i].x`

fn get_x_r() → Func { Func(seq([Get(x_of(0, Var(0)))]), RWord(Var(1))) }

theorem get_x_reflects(ps: List<Point>, i: Nat): mean_pt(get_x_r(), ps, [i]).word = get_x(ps, i) { refl }

fn get_x_owes() → Owes { ODo([Inside(Place(0, Nil), Var(0))], OEnd) }

// The bound, as the source writes it, over the list inside the `Dyn`: the
// source's hypothesis placed, by conversion.
theorem get_x_site(ps: List<Point>, i: Nat, inside: ∥i < ps.len()∥): due_pt(get_x_owes(), get_x_r(), ps, [i]) { ⟨inside, trivial⟩ }

// ---------------------------------------------------------------------------
// 2. A write of a field of an element: `ps[i].x := v`, against the explicit
//    functional update (the surface's place update desugars to `put` and a
//    proof-carrying `at`, which `List` does not have).

fn set_x(ps: List<Point>, i, v: Nat) → List<Point> { ps.update(i, λ p => Point(v, p.y)) }

fn set_x_r() → Func { Func(seq([Put(x_of(0, Var(0)), FromWord(Var(1)))]), RWord(Lit(0))) }

theorem set_x_reflects(ps: List<Point>, i, v: Nat): as_points(obj_at(pt_tys(), mean_pt(set_x_r(), ps, [i, v]).objs, 0)) = set_x(ps, i, v) { refl }

// The control: the update is of `.x`, not `.y`.
// expect-error(kernel)
theorem set_x_not_y(ps: List<Point>, i, v: Nat): as_points(obj_at(pt_tys(), mean_pt(set_x_r(), ps, [i, v]).objs, 0)) = ps.update(i, λ p => Point(p.x, v)) { refl }

// ---------------------------------------------------------------------------
// 3. A generic function at an open type parameter `T`: the environment
//    holds the neutral `T`, opaque, with the inhabitant the function is
//    given.

fn t_tys(T: Type) → Nat → Type { λ k => match k { Zero => T, Succ(_) => True } }

fn t_strs(T: Type, d: T) → Strs(t_tys(T)) { λ k => match k { Zero => Opaque(d), Succ(_) => Opaque(trivial) } }

fn no_world(T: Type) → World(t_tys(T)) { λ _ _ _ => 0 }

// `xs[i] := xs[j]`, then answer `xs[i]`.
fn copy_elem<T>(xs: List<T>, i, j: Nat, d: T) → List<T> { xs.update(i, λ _ => xs.nth(j).unwrap_or(d)) }

fn copy_elem_r() → Func { Func(seq([Put(Place(0, [SElem(Var(0))]), FromPlace(Place(0, [SElem(Var(1))])))]), RPlace(Place(0, [SElem(Var(0))]))) }

fn mean_t(T: Type, d: T, f: Func, xs: List<T>, ws: List<Nat>) → MOut(t_tys(T)) { mean_fn(t_tys(T), t_strs(T, d), no_world(T), f, [Dyn(SSeq(SNamed(0)), xs)], ws) }

theorem copy_elem_reflects<T>(xs: List<T>, i, j: Nat, d: T):
    Dyn::as_code(t_tys(T), t_strs(T, d), SSeq(SNamed(0)), obj_at(t_tys(T), mean_t(T, d, copy_elem_r(), xs, [i, j]).objs, 0)) = copy_elem(xs, i, j, d)
{ refl }

// The value it answers: the element read after the write.
theorem copy_elem_answers<T>(xs: List<T>, i, j: Nat, d: T):
    Dyn::as_code(t_tys(T), t_strs(T, d), SNamed(0), mean_t(T, d, copy_elem_r(), xs, [i, j]).val) = copy_elem(xs, i, j, d).nth(i).unwrap_or(d)
{ refl }

// ---------------------------------------------------------------------------
// 4. `if h: i < ps.len()` guarding a read

fn guarded(ps: List<Point>, i: Nat) → Nat { if h: i < ps.len() { get_x(ps, i) } else { 0 } }

fn guarded_r() → Func { Func(If(LtLen(Var(0), Place(0, Nil)), seq([Get(x_of(0, Var(0)))]), seq([Add(Lit(0), Lit(0))]), End), RWord(Var(1))) }

theorem guarded_reflects(ps: List<Point>, i: Nat): word_pt(guarded_r(), ps, [i]) = guarded(ps, i) { refl }

// `.word` of the whole output does not pin: the projection meets the
// convoy over the record, which is stuck at the test.
// expect-error(kernel)
theorem guarded_projected(ps: List<Point>, i: Nat): mean_pt(guarded_r(), ps, [i]).word = guarded(ps, i) { refl }

fn guarded_owes() → Owes { OIf(ODo([Inside(Place(0, Nil), Var(0))], OEnd), ODo(Nil, OEnd), OEnd) }

// The arm's bound is the `if`'s own evidence.
theorem guarded_site(ps: List<Point>, i: Nat): due_pt(guarded_owes(), guarded_r(), ps, [i]) {
    cases(decide_bit<i < ps.len()>(), λ e => ⟨squash(decide_true<i < ps.len()>(e)), trivial⟩, λ _ => trivial)
}

// ---------------------------------------------------------------------------
// 5. Calls: one passing a record, one passing a window of a list

fn call_gap(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x) → Nat {
    gap(ps.nth(i).unwrap_or(Point::origin()), ok)
}

fn call_gap_r() → Func { Func(seq([Call(0, [Place(0, [SElem(Var(0))])], Nil)]), RWord(Var(1))) }

theorem call_gap_reflects(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x):
    mean_pt(call_gap_r(), ps, [i]).word = call_gap(ps, i, ok)
{ refl }

fn call_gap_owes() → Owes { ODo([Pre(0, [Place(0, [SElem(Var(0))])], Nil)], OEnd) }

// The callee's precondition at the record passed: the caller's own proof.
theorem call_gap_site(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x):
    due_pt(call_gap_owes(), call_gap_r(), ps, [i])
{ ⟨ok, trivial⟩ }

fn call_total(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥) → Nat { total(ps.drop(lo).take(n)) }

fn call_total_r() → Func { Func(seq([Call(1, [Place(0, [SWindow(Var(0), Var(1))])], Nil)]), RWord(Var(2))) }

theorem call_total_reflects(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥): mean_pt(call_total_r(), ps, [lo, n]).word = call_total(ps, lo, n, some) { refl }

fn call_total_owes() → Owes { ODo([Pre(1, [Place(0, [SWindow(Var(0), Var(1))])], Nil)], OEnd) }

theorem call_total_site(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥): due_pt(call_total_owes(), call_total_r(), ps, [lo, n]) { ⟨some, trivial⟩ }

// ---------------------------------------------------------------------------
// `Point`'s structure laws, by hand: what a derived instance proves. Its
// two fields are lawful paths and apart; with them the `Dyn` model is
// lawful relative to the read, and the decider's verdicts at a list of
// points are `Apart` there.

theorem Point::fx_laws(): PathLaws<Point, Nat>(Point::fx().path) {
    PathLaws(λ s a v h => refl, λ s a h => j(Option::some_inj(s.x, a, h), λ b _ => Point(b, s.y) = s, refl), λ s v w => refl, λ s v no => absurd(no))
}

theorem Point::fy_laws(): PathLaws<Point, Nat>(Point::fy().path) {
    PathLaws(λ s a v h => refl, λ s a h => j(Option::some_inj(s.y, a, h), λ b _ => Point(s.x, b) = s, refl), λ s v w => refl, λ s v no => absurd(no))
}

theorem Point::fx_fy_apart(): Apart<Point, Nat, Nat>(Point::fx().path, Point::fy().path) { Apart(λ s v => refl, λ s v => refl, λ s a b => refl) }

theorem Point::fields_laws(): FieldsLaws(pt_tys(), Point, [Point::fx(), Point::fy()]) {
    FieldsLaws(
        λ i => match i {
            Zero => λ f e => j(Option::some_inj(Point::fx(), f, e), λ g _ => PathLaws<Point, El(pt_tys(), g.shape)>(g.path), Point::fx_laws()),
            Succ(i1) => match i1 {
                Zero => λ f e => j(Option::some_inj(Point::fy(), f, e), λ g _ => PathLaws<Point, El(pt_tys(), g.shape)>(g.path), Point::fy_laws()),
                Succ(_) => λ f no => absurd(no),
            },
        },
        λ i l => match i {
            Zero => match l {
                Zero => λ f g _ _ ne => false_elim(ne(refl)),
                Succ(l1) => match l1 {
                    Zero => λ f g ei el _ => j(Option::some_inj(Point::fx(), f, ei), λ f2 _ => Apart<Point, El(pt_tys(), f2.shape), El(pt_tys(), g.shape)>(f2.path, g.path),
                        j(Option::some_inj(Point::fy(), g, el), λ g2 _ => Apart<Point, Nat, El(pt_tys(), g2.shape)>(Point::fx().path, g2.path), Point::fx_fy_apart())),
                    Succ(_) => λ f g _ no _ => absurd(no),
                },
            },
            Succ(i1) => match i1 {
                Zero => match l {
                    Zero => λ f g ei el _ => j(Option::some_inj(Point::fy(), f, ei), λ f2 _ => Apart<Point, El(pt_tys(), f2.shape), El(pt_tys(), g.shape)>(f2.path, g.path),
                        j(Option::some_inj(Point::fx(), g, el), λ g2 _ => Apart<Point, Nat, El(pt_tys(), g2.shape)>(Point::fy().path, g2.path), Apart::symm(Point::fx_fy_apart()))),
                    Succ(l1) => match l1 { Zero => λ f g _ _ ne => false_elim(ne(refl)), Succ(_) => λ f g _ no _ => absurd(no) },
                },
                Succ(_) => λ f g no _ _ => absurd(no),
            },
        },
    )
}

theorem pt_strs_laws(): StrsLaws(pt_tys(), pt_strs()) { λ k => match k { Zero => Point::fields_laws(), Succ(_) => trivial } }

fn pt_place(ws: List<Nat>, xs: List<Step>) → Path<Dyn(pt_tys()), Dyn(pt_tys())> { PathModel::denote(Dyn::model_rel(pt_tys(), pt_strs()).steps(), ws, xs) }

// `ps[i].x` and `ps[i].y`: the decider walks the common element and finds
// the fields apart, owing nothing.
theorem xy_apart(i: Nat): Apart<Dyn(pt_tys()), Dyn(pt_tys()), Dyn(pt_tys())>(pt_place([i], [SElem(Var(0)), SField(0)]), pt_place([i], [SElem(Var(0)), SField(1)])) {
    Dyn::apart(pt_tys(), pt_strs(), pt_strs_laws(), [i], [SElem(Var(0)), SField(0)], [SElem(Var(0)), SField(1)], Nil, refl, trivial)
}

// `ps[i].x` and `ps[l].x` for `i ≠ l`: owed, and the source's `i ≠ l`
// discharges it.
theorem elems_x_apart(i, l: Nat, ne: ¬(i = l)): Apart<Dyn(pt_tys()), Dyn(pt_tys()), Dyn(pt_tys())>(pt_place([i, l], [SElem(Var(0)), SField(0)]), pt_place([i, l], [SElem(Var(1)), SField(0)])) {
    let owed: Span(i, 1).apart(Span(l, 1)).IsTrue() = omega(ne);
    Dyn::apart(pt_tys(), pt_strs(), pt_strs_laws(), [i, l], [SElem(Var(0)), SField(0)], [SElem(Var(1)), SField(0)], [Spans(Var(0), Lit(1), Var(1), Lit(1))], refl, And(owed, trivial))
}

// ---------------------------------------------------------------------------
// A function that continues after its `if`: the branch names its output,
// the joined word is the convoy of the arms' words (the term the source's
// `let a = if h: … else …` elaborates to), and what follows runs once.
//    `fn after_join(ps, i) → Nat { let a = if h: i < ps.len() { ps[i].x } else { 0 }; ps[a].y }`

fn after_join(ps: List<Point>, i: Nat) → Nat {
    let a = if h: i < ps.len() { get_x(ps, i) } else { 0 };
    ps.nth(a).unwrap_or(Point::origin()).y
}

fn after_join_r() → Func {
    Func(Join(LtLen(Var(0), Place(0, Nil)), seq([Get(x_of(0, Var(0)))]), Var(1), seq(Nil), Lit(0), seq([Get(Place(0, [SElem(Var(1)), SField(1)]))])), RWord(Var(2)))
}

theorem after_join_reflects(ps: List<Point>, i: Nat): word_pt(after_join_r(), ps, [i]) = after_join(ps, i) { refl }

// The whole output pins too: the join leaves no convoy over the record.
theorem after_join_whole(ps: List<Point>, i: Nat): mean_pt(after_join_r(), ps, [i]).word = after_join(ps, i) { refl }

// The arm's bound is the `if`'s evidence; the read after the join owes its
// bound at the joined word, which the source must prove of the convoy.
fn after_join_owes() → Owes { OJoin(ODo([Inside(Place(0, Nil), Var(0))], OEnd), OEnd, ODo([Inside(Place(0, Nil), Var(1))], OEnd)) }

theorem after_join_site(ps: List<Point>, i: Nat, next: ∥(if h: i < ps.len() { get_x(ps, i) } else { 0 }) < ps.len()∥): due_pt(after_join_owes(), after_join_r(), ps, [i]) {
    ⟨cases(decide_bit<(i < ps.len())>(), λ e => ⟨squash(decide_true<(i < ps.len())>(e)), trivial⟩, λ _ => trivial), ⟨next, trivial⟩⟩
}

// The control: the read after the join is of `.y`, not `.x`.
fn after_join_x(ps: List<Point>, i: Nat) → Nat {
    let a = if h: i < ps.len() { get_x(ps, i) } else { 0 };
    ps.nth(a).unwrap_or(Point::origin()).x
}

// expect-error(kernel)
theorem after_join_not_x(ps: List<Point>, i: Nat): word_pt(after_join_r(), ps, [i]) = after_join_x(ps, i) { refl }

// ---------------------------------------------------------------------------
// How a real source spells an element read, against the total read
//
// `Vec::at` and `Bytes::at` (`stored_words.hthr`, `bytes.hthr`) take the
// bound as a squashed parameter their body does not read: the body is the
// total read with 0 past the end. That spelling pins by `refl` (the proof
// is never looked at). A read that consumes its proof (`vector_index` at
// the proof, what `Vec::at_index` relates `Vec::at` to; here a recursion on
// the list) is not a conversion: it is one library lemma per site.

// The `Vec::at` shape, over a list of words.
fn List::at_word(self xs: List<Nat>, i: Nat, inside: ∥i < xs.len()∥) → Nat { xs.nth(i).unwrap_or(0) }

fn read_w_r() → Func { Func(seq([Get(Place(0, [SElem(Var(0))]))]), RWord(Var(1))) }

theorem read_w_reflects(xs: List<Nat>, i: Nat, inside: ∥i < xs.len()∥):
    mean_word(pt_tys(), pt_strs(), pt_world(), read_w_r(), [Dyn(SSeq(SWord), xs)], [i]) = xs.at_word(i, inside)
{ refl }

// A read that consumes its proof.
theorem List::nil_not_below<A>(i: Nat, inside: i < List::len(Nil<A>)): False { omega(inside) }

theorem List::below_tail<A>(h: A, t: List<A>, k: Nat, inside: Succ(k) < List::len(Cons(h, t))): k < t.len() { omega(inside) }

fn List::at_below<A>(self xs: List<A>) → (i: Nat) → i < xs.len() → A {
    match xs {
        Nil => λ i inside => false_elim(List::nil_not_below<A>(i, inside)),
        Cons(h, t) => λ i => match i { Zero => λ _ => h, Succ(k) => λ inside => t.at_below(k, List::below_tail(h, t, k, inside)) },
    }
}

fn get_x_below(ps: List<Point>, i: Nat, inside: i < ps.len()) → Nat { ps.at_below(i, inside).x }

// expect-error(kernel)
theorem get_x_below_refl(ps: List<Point>, i: Nat, inside: i < ps.len()): word_pt(get_x_r(), ps, [i]) = get_x_below(ps, i, inside) { refl }

// The library lemma it takes: under the bound, the read is the total read
// at any inhabitant.
theorem List::at_below_total<A>(self xs: List<A>): (i: Nat) → (inside: i < xs.len()) → (d: A) → xs.at_below(i, inside) = xs.nth(i).unwrap_or(d) {
    match xs {
        Nil => λ i inside d => false_elim(List::nil_not_below<A>(i, inside)),
        Cons(h, t) => λ i => match i { Zero => λ _ _ => refl, Succ(k) => λ inside d => t.at_below_total(k, List::below_tail(h, t, k, inside), d) },
    }
}

theorem get_x_below_pin(ps: List<Point>, i: Nat, inside: i < ps.len()): word_pt(get_x_r(), ps, [i]) = get_x_below(ps, i, inside) {
    cong_fn(λ (p: Point) => p.x, sym(ps.at_below_total(i, inside, Point::origin())))
}

// ---------------------------------------------------------------------------
// The open `T` with the inhabitant only in the pin's statement: the
// function takes no `T`. A write that reads nothing at `T` pins at every
// inhabitant by `refl`; a read at `T` does not, since the meaning's read
// is `unwrap_or(d)` and the source has no `d` to spell: it takes the
// proof-consuming read and the lemma above.

fn put_elem<T>(xs: List<T>, i: Nat, x: T) → List<T> { xs.update(i, λ _ => x) }

// `xs[i] := x` with `x` a second object, the element at its root.
fn put_elem_r() → Func { Func(seq([Put(Place(0, [SElem(Var(0))]), FromPlace(Place(1, Nil)))]), RWord(Lit(0))) }

theorem put_elem_reflects<T>(xs: List<T>, i: Nat, x: T): (d: T) →
    Dyn::as_code(t_tys(T), t_strs(T, d), SSeq(SNamed(0)), obj_at(t_tys(T), mean_fn(t_tys(T), t_strs(T, d), no_world(T), put_elem_r(), [Dyn(SSeq(SNamed(0)), xs), Dyn(SNamed(0), x)], [i]).objs, 0))
        = put_elem(xs, i, x)
{ λ d => refl }

fn copy_below<T>(xs: List<T>, i, j: Nat, inside: j < xs.len()) → List<T> { xs.update(i, λ _ => xs.at_below(j, inside)) }

theorem copy_below_pin<T>(xs: List<T>, i, j: Nat, inside: j < xs.len()): (d: T) →
    Dyn::as_code(t_tys(T), t_strs(T, d), SSeq(SNamed(0)), obj_at(t_tys(T), mean_t(T, d, copy_elem_r(), xs, [i, j]).objs, 0)) = copy_below(xs, i, j, inside)
{
    λ d => cong_fn(λ (y: T) => xs.update(i, λ _ => y), sym(xs.at_below_total(j, inside, d)))
}

// ---------------------------------------------------------------------------
// The step lemma at `Dyn`: a store through `ps[i].x` (block 0) keeps the
// view `ps[i].y` of the same block, and any view of block 1, with no look
// inside a code.

theorem store_x_keeps_y(heap: List<Dyn(pt_tys())>, i: Nat, x: Dyn(pt_tys())):
    View(0, [SElem(Var(0)), SField(1)]).read(Dyn::model_rel(pt_tys(), pt_strs()), [i], View(0, [SElem(Var(0)), SField(0)]).write(Dyn::model_rel(pt_tys(), pt_strs()), [i], heap, x))
        = View(0, [SElem(Var(0)), SField(1)]).read(Dyn::model_rel(pt_tys(), pt_strs()), [i], heap)
{
    View::write_keeps(Dyn::model_rel(pt_tys(), pt_strs()), Dyn::model_laws_rel(pt_tys(), pt_strs(), pt_strs_laws()), [i], heap,
        View(0, [SElem(Var(0)), SField(0)]), View(0, [SElem(Var(0)), SField(1)]), x, Places(refl, Nil, refl, trivial))
}

theorem store_x_keeps_other_block(heap: List<Dyn(pt_tys())>, i: Nat, xs: List<Step>, x: Dyn(pt_tys())):
    View(1, xs).read(Dyn::model_rel(pt_tys(), pt_strs()), [i], View(0, [SElem(Var(0)), SField(0)]).write(Dyn::model_rel(pt_tys(), pt_strs()), [i], heap, x))
        = View(1, xs).read(Dyn::model_rel(pt_tys(), pt_strs()), [i], heap)
{
    View::write_keeps(Dyn::model_rel(pt_tys(), pt_strs()), Dyn::model_laws_rel(pt_tys(), pt_strs(), pt_strs_laws()), [i], heap,
        View(0, [SElem(Var(0)), SField(0)]), View(1, xs), x, Blocks(λ no => absurd(no)))
}

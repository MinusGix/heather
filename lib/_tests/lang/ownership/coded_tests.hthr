// Probes of the coded universal value (lib/lang/ownership/coded.hthr,
// issues/ownership-coded-values.md).
import logic;
import bool;
import nat;
import option;
import list;
import list_window;
import span_set;
import store;
import path;
import list_path;
import atom;
import steps;
import coded;

// ---------------------------------------------------------------------------
// The decision and the cast at closed codes

theorem dec_closed(): Shape::dec(SSeq(SNamed(3)), SSeq(SNamed(3))) = Inl(refl) { refl }

// A value put back at its own closed code is itself: the decision is
// `Inl(refl)` and the cast the identity, by evaluation.
theorem back_closed(xs: List<List<Nat>>, ys: List<List<Nat>>): Dyn::back(Nil, SSeq(SSeq(SWord)), Dyn(SSeq(SSeq(SWord)), xs), ys) = xs { refl }

// ---------------------------------------------------------------------------
// A user record and its instance, written by hand

record Point { x: Nat, y: Nat }

fn pt_tys() → List<Type> { Cons(Point, Nil) }

fn Point::fx() → Field(pt_tys(), Point) { Field(SWord, Path<Point, Nat>(get := λ (p: Point) => Some(p.x), set := λ (p: Point) => λ (v: Nat) => Point(v, p.y))) }

fn Point::fy() → Field(pt_tys(), Point) { Field(SWord, Path<Point, Nat>(get := λ (p: Point) => Some(p.y), set := λ (p: Point) => λ (v: Nat) => Point(p.x, v))) }

fn Point::origin() → Point { Point(0, 0) }

fn pt_strs() → Strs(pt_tys()) {
    λ k => match k as λ k2 => Struct(pt_tys(), ty_at(pt_tys(), k2)) { Zero => Fields(Point::origin(), [Point::fx(), Point::fy()]), Succ(_) => Opaque(trivial) }
}

fn pts() → Shape { SSeq(SNamed(0)) }

// ---------------------------------------------------------------------------
// 1. `ps[i].x`

fn get_x(ps: List<Point>, i: Nat) → Nat { ps.nth(i).unwrap_or(Point::origin()).x }

theorem get_x_pin(ps: List<Point>, i: Nat):
    Dyn::word(pt_tys(), Dyn::read(pt_tys(), pt_strs(), Env::start([i]), [SElem(Var(0)), SField(0)], Dyn(pts(), ps))) = get_x(ps, i)
{ refl }

// The control: the same place does not read `.y`.
// expect-error(kernel)
theorem get_x_not_y(ps: List<Point>, i: Nat):
    Dyn::word(pt_tys(), Dyn::read(pt_tys(), pt_strs(), Env::start([i]), [SElem(Var(0)), SField(0)], Dyn(pts(), ps))) = ps.nth(i).unwrap_or(Point::origin()).y
{ refl }

// ---------------------------------------------------------------------------
// Native callees, and the world of their meanings

fn gap(p: Point, ok: p.y <= p.x) → Nat { p.x - p.y }

fn total(qs: List<Point>) → Nat { match qs { Nil => 0, Cons(q, r) => q.x + total(r) } }

fn dyn_at(ds: List<Dyn(pt_tys())>, k: Nat) → Dyn(pt_tys()) { obj_at(pt_tys(), ds, k) }

fn as_point(d: Dyn(pt_tys())) → Point { Dyn::as_code(pt_tys(), pt_strs(), SNamed(0), d) }

fn as_points(d: Dyn(pt_tys())) → List<Point> { Dyn::as_code(pt_tys(), pt_strs(), pts(), d) }

// `gap`'s proof is erased in its meaning: it reads `x - y`.
fn pt_world() → World(pt_tys()) { λ g ds ws => match g { Zero => as_point(dyn_at(ds, 0)).x - as_point(dyn_at(ds, 0)).y, Succ(_) => total(as_points(dyn_at(ds, 0))) } }

// The callees' preconditions, over the values passed.
fn pt_pres() → Pres(pt_tys()) {
    λ g ds ws => match g { Zero => as_point(dyn_at(ds, 0)).y <= as_point(dyn_at(ds, 0)).x, Succ(_) => ∥0 < as_points(dyn_at(ds, 0)).len()∥ }
}

fn mean_pt(f: Func, ps: List<Point>, ws: List<Nat>) → MOut(pt_tys()) { mean_fn(pt_tys(), pt_strs(), pt_world(), f, [Dyn(pts(), ps)], ws) }

fn word_pt(f: Func, ps: List<Point>, ws: List<Nat>) → Nat { mean_word(pt_tys(), pt_strs(), pt_world(), f, [Dyn(pts(), ps)], ws) }

fn due_pt(d: Owes, f: Func, ps: List<Point>, ws: List<Nat>) → Type { d.Due(pt_tys(), pt_strs(), pt_world(), pt_pres(), f, [Dyn(pts(), ps)], ws) }

fn x_of(r: Nat, i: Atom) → Place { Place(r, [SElem(i), SField(0)]) }

// ---------------------------------------------------------------------------
// 1. A read of a field of an element: `ps[i].x`

fn get_x_r() → Func { Func(seq([Get(x_of(0, Var(0)))]), RWord(Var(1))) }

theorem get_x_reflects(ps: List<Point>, i: Nat): mean_pt(get_x_r(), ps, [i]).word = get_x(ps, i) { refl }

fn get_x_owes() → Owes { ODo([Inside(Place(0, Nil), Var(0))], OEnd) }

// The bound, as the source writes it, over the list inside the `Dyn`: the
// source's hypothesis placed, by conversion.
theorem get_x_site(ps: List<Point>, i: Nat, inside: ∥i < ps.len()∥): due_pt(get_x_owes(), get_x_r(), ps, [i]) { ⟨inside, trivial⟩ }

// ---------------------------------------------------------------------------
// 2. A write of a field of an element: `ps[i].x := v`, against the explicit
//    functional update (the surface's place update desugars to `put` and a
//    proof-carrying `at`, which `List` does not have).

fn set_x(ps: List<Point>, i, v: Nat) → List<Point> { ps.update(i, λ p => Point(v, p.y)) }

fn set_x_r() → Func { Func(seq([Put(x_of(0, Var(0)), FromWord(Var(1)))]), RWord(Lit(0))) }

theorem set_x_reflects(ps: List<Point>, i, v: Nat): as_points(obj_at(pt_tys(), mean_pt(set_x_r(), ps, [i, v]).objs, 0)) = set_x(ps, i, v) { refl }

// The control: the update is of `.x`, not `.y`.
// expect-error(kernel)
theorem set_x_not_y(ps: List<Point>, i, v: Nat): as_points(obj_at(pt_tys(), mean_pt(set_x_r(), ps, [i, v]).objs, 0)) = ps.update(i, λ p => Point(p.x, v)) { refl }

// ---------------------------------------------------------------------------
// 3. A generic function at an open type parameter `T`: the environment
//    holds the neutral `T`, opaque, with the inhabitant the function is
//    given.

fn t_tys(T: Type) → List<Type> { Cons(T, Nil) }

fn t_strs(T: Type, d: T) → Strs(t_tys(T)) { λ k => match k as λ k2 => Struct(t_tys(T), ty_at(t_tys(T), k2)) { Zero => Opaque(d), Succ(_) => Opaque(trivial) } }

fn no_world(T: Type) → World(t_tys(T)) { λ _ _ _ => 0 }

// `xs[i] := xs[j]`, then answer `xs[i]`.
fn copy_elem<T>(xs: List<T>, i, j: Nat, d: T) → List<T> { xs.update(i, λ _ => xs.nth(j).unwrap_or(d)) }

fn copy_elem_r() → Func { Func(seq([Put(Place(0, [SElem(Var(0))]), FromPlace(Place(0, [SElem(Var(1))])))]), RPlace(Place(0, [SElem(Var(0))]))) }

fn mean_t(T: Type, d: T, f: Func, xs: List<T>, ws: List<Nat>) → MOut(t_tys(T)) { mean_fn(t_tys(T), t_strs(T, d), no_world(T), f, [Dyn(SSeq(SNamed(0)), xs)], ws) }

theorem copy_elem_reflects<T>(xs: List<T>, i, j: Nat, d: T):
    Dyn::as_code(t_tys(T), t_strs(T, d), SSeq(SNamed(0)), obj_at(t_tys(T), mean_t(T, d, copy_elem_r(), xs, [i, j]).objs, 0)) = copy_elem(xs, i, j, d)
{ refl }

// The value it answers: the element read after the write.
theorem copy_elem_answers<T>(xs: List<T>, i, j: Nat, d: T):
    Dyn::as_code(t_tys(T), t_strs(T, d), SNamed(0), mean_t(T, d, copy_elem_r(), xs, [i, j]).val) = copy_elem(xs, i, j, d).nth(i).unwrap_or(d)
{ refl }

// ---------------------------------------------------------------------------
// 4. `if h: i < ps.len()` guarding a read

fn guarded(ps: List<Point>, i: Nat) → Nat { if h: i < ps.len() { get_x(ps, i) } else { 0 } }

fn guarded_r() → Func { Func(If(LtLen(Var(0), Place(0, Nil)), seq([Get(x_of(0, Var(0)))]), seq([Add(Lit(0), Lit(0))]), End), RWord(Var(1))) }

theorem guarded_reflects(ps: List<Point>, i: Nat): word_pt(guarded_r(), ps, [i]) = guarded(ps, i) { refl }

// `.word` of the whole output does not pin: the projection meets the
// convoy over the record, which is stuck at the test.
// expect-error(kernel)
theorem guarded_projected(ps: List<Point>, i: Nat): mean_pt(guarded_r(), ps, [i]).word = guarded(ps, i) { refl }

fn guarded_owes() → Owes { OIf(ODo([Inside(Place(0, Nil), Var(0))], OEnd), ODo(Nil, OEnd), OEnd) }

// The arm's bound is the `if`'s own evidence.
theorem guarded_site(ps: List<Point>, i: Nat): due_pt(guarded_owes(), guarded_r(), ps, [i]) {
    cases(decide_bit<i < ps.len()>(), λ e => ⟨squash(decide_true<i < ps.len()>(e)), trivial⟩, λ _ => trivial)
}

// ---------------------------------------------------------------------------
// 5. Calls: one passing a record, one passing a window of a list

fn call_gap(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x) → Nat {
    gap(ps.nth(i).unwrap_or(Point::origin()), ok)
}

fn call_gap_r() → Func { Func(seq([Call(0, [Place(0, [SElem(Var(0))])], Nil)]), RWord(Var(1))) }

theorem call_gap_reflects(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x):
    mean_pt(call_gap_r(), ps, [i]).word = call_gap(ps, i, ok)
{ refl }

fn call_gap_owes() → Owes { ODo([Pre(0, [Place(0, [SElem(Var(0))])], Nil)], OEnd) }

// The callee's precondition at the record passed: the caller's own proof.
theorem call_gap_site(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x):
    due_pt(call_gap_owes(), call_gap_r(), ps, [i])
{ ⟨ok, trivial⟩ }

fn call_total(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥) → Nat { total(ps.drop(lo).take(n)) }

fn call_total_r() → Func { Func(seq([Call(1, [Place(0, [SWindow(Var(0), Var(1))])], Nil)]), RWord(Var(2))) }

theorem call_total_reflects(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥): mean_pt(call_total_r(), ps, [lo, n]).word = call_total(ps, lo, n, some) { refl }

fn call_total_owes() → Owes { ODo([Pre(1, [Place(0, [SWindow(Var(0), Var(1))])], Nil)], OEnd) }

theorem call_total_site(ps: List<Point>, lo, n: Nat, some: ∥0 < ps.drop(lo).take(n).len()∥): due_pt(call_total_owes(), call_total_r(), ps, [lo, n]) { ⟨some, trivial⟩ }

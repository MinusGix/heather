// Three programs through every layer by evaluation (lib/lang/ownership/
// placement.hthr, placement_seam.hthr; docs/language/ownership-design.md §25;
// issues/ownership-end-to-end-slice.md): a loop over a byte buffer that only
// reads (`count_newlines`), a function that lends a window to write
// (`copy_window`), and a recursion (`sum`), each written by hand in the
// reflected body. For each: the checker's verdict by `refl`; the pin of its
// meaning to a pure source function at closed arguments by `refl`; `place`'s
// routine; the level-2 run and the bytes level's run of the routine agreeing
// at closed arguments; and `Program::lower` answering `Some`.
//
// The environment has one named type, a byte buffer (`List<u8>`) indexed by
// a word, with windows: `sequences.hthr`'s `Seq::words` (§25.4 item 10).
import logic;
import bool;
import nat;
import option;
import list;
import list_window;
import pair;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import sequences;
import body::{Place, Callees};
import level2;
import run;
import verdict;
import checker;
import placement;
import placement_seam;
import placement_inject;
import placement_laid;
import placement_stages;
import placement_walk;
import placement_places;
import bytes_memory;
import bytes_level;
import bytes_level_routines;
import x86_64_memory_contract;
import x86_64_call_contract;
import function_ir;
import function_ir_lower;
import x86_64;
import linux_world;
import x86_64_asm;

// ---------------------------------------------------------------------------
// The environment: a byte buffer, indexed by a word, with windows

fn bytes_t() → Type { List<u8> }

fn tys() → Nat → Type { λ k => match k { Zero => List<u8>, Succ(_) => True } }

fn buf_s() → Shape { SNamed(0) }

fn u64_s() → Shape { SWord(WBits(64)) }

fn u8_s() → Shape { SWord(WBits(8)) }

fn bwin(xs: List<u8>, lo, n: Ix) → List<u8> { xs.drop(lo.toNat()).take(n.toNat()) }

fn bput_win(xs: List<u8>, lo, n: Ix, ys: List<u8>) → List<u8> {
    match (lo.toNat() + n.toNat()).leb(xs.len()) && ys.len().same(n.toNat()) { True => xs.put_window(lo.toNat(), ys), False => xs }
}

// The byte buffer: `sequences.hthr`'s list of words indexed by a machine
// word, with windows of itself.
fn bytes_seq() → shape::Seq(tys(), List<u8>) {
    Seq::words(tys(), u8_s(), BitVec::ofNat(0), Some(Seq::words_win(tys(), u8_s(), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l)))
}

fn strs() → Strs(tys()) { λ k => match k { Zero => Struct(Object, None, Sequence(bytes_seq())), Succ(_) => Struct(Plain, None, Opaque) } }

// The structures are lawful: the instance's laws, its windows', and a
// window's length read as the environment reads it.
theorem strs_lawful(): StrsLaws(tys(), strs()) {
    λ k => match k {
        Zero => ⟨Seq::words_laws(tys(), u8_s(), BitVec::ofNat(0), Some(Seq::words_win(tys(), u8_s(), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l))),
            ⟨Seq::words_win_laws(tys(), u8_s(), BitVec::ofNat(0), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l, λ l => refl, λ y => refl,
                Some(Seq::words_win(tys(), u8_s(), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l))), λ y => refl⟩⟩,
        Succ(_) => trivial,
    }
}

fn buf(xs: List<u8>) → Dyn(tys()) { Dyn(buf_s(), xs) }

fn w64(x: u64) → Dyn(tys()) { Dyn(u64_s(), x) }

fn as_buf(d: Dyn(tys())) → List<u8> { Dyn::get(tys(), buf_s(), d).unwrap_or(Nil) }

fn as_w64(d: Dyn(tys())) → u64 { Dyn::get(tys(), u64_s(), d).unwrap_or(BitVec::ofNat(0)) }

fn arg(ds: List<Dyn(tys())>, i: Nat) → Dyn(tys()) { ds.nth(i).unwrap_or(Dyn::none(tys())) }

fn nofunc() → Func { Func(Sig(Nil, Nil), Ret(Nil)) }

fn sigs_of(fs: List<Func>) → Nat → Sig { λ g => (fs.nth(g).unwrap_or(nofunc())).sig }

fn no_prim() → Nat → Bool { λ _ => False }

// Every function is measured, so each call and `Jump` owes its measure.
fn verdict(fs: List<Func>, g: Nat) → Option<Owes> { check(tys(), strs(), sigs_of(fs), no_prim(), λ _ => True, g, fs.nth(g).unwrap_or(nofunc())) }

fn why(fs: List<Func>, g: Nat) → Option<Why> { (fs.nth(g).unwrap_or(nofunc())).refusal(tys(), strs(), sigs_of(fs), no_prim(), λ _ => True, g) }

fn means(fs: List<Func>, w: Callees(tys()), g: Nat, ds: List<Dyn(tys())>) → List<Dyn(tys())> { (fs.nth(g).unwrap_or(nofunc())).denote(tys(), strs(), w, g, ds) }

fn placed(fs: List<Func>) → Option<Program> { place(tys(), strs(), no_prim(), fs) }

fn rd(n: Nat) → Param { Param(buf_s(), ByRead) }

fn word_p() → Param { Param(u64_s(), ByTake) }

fn word_r() → Result { Result(u64_s(), OFresh) }

fn el(r: Var, i: Atom) → Place { Place(r, [SElem(i)]) }

fn win(r: Var, lo, n: Atom) → Place { Place(r, [SWindow(lo, n)]) }

fn whole(r: Var) → Place { Place(r, Nil) }

fn ten() → u8 { BitVec::ofNat(10) }

// ---------------------------------------------------------------------------
// 1. count_newlines: a loop over a byte buffer that only reads
//
//    fn newlines_from(text: &[u8], n, i, acc: u64) → u64 decreases n - i {
//        if i < n { newlines_from(text, n, i + 1, if text[i] == 10 { acc + 1 } else { acc }) } else { acc }
//    }
//    fn count_newlines(text: &[u8], n: u64) → u64 requires n <= text.len() { newlines_from(text, n, 0, 0) }

fn nl_go(xs: List<u8>, k: Nat, n, i, acc: u64) → u64 {
    match k {
        Zero => acc,
        Succ(k1) => match i.unsigned_lt_bit(n) {
            False => acc,
            True => nl_go(xs, k1, n, i.add(BitVec::ofNat(1)), match xs.nth(i.toNat()).unwrap_or(BitVec::ofNat(0)).eq_bit(ten()) { True => acc.add(BitVec::ofNat(1)), False => acc }),
        },
    }
}

fn newlines_from(xs: List<u8>, n, i, acc: u64) → u64 { nl_go(xs, n.sub(i).toNat(), n, i, acc) }

fn count_newlines(xs: List<u8>, n: u64) → u64 { newlines_from(xs, n, BitVec::ofNat(0), BitVec::ofNat(0)) }

// The loop at `(text, n, i, acc)`: the test, a byte read, the newline's
// test as two comparisons (the body has `<` and `<=` only), then round again.
// Locals newest first beside each statement.
fn nl_loop_r() → Func {
    Func(Sig([rd(0), word_p(), word_p(), word_p()], [word_r()]),
        Join(TLt(Arg(2), Arg(1)),
            seq([Stmt::Read(el(Arg(0), Var(2))),           // [b]
                 Stmt::Lit(WBits(8), 10)],                  // [ten, b]
                Join(TLt(Loc(1), Loc(0)),
                    Yield([Arg(3)]),
                    Join(TLt(Loc(0), Loc(1)),
                        Yield([Arg(3)]),
                        seq([Stmt::Lit(WBits(64), 1), Op(PAdd, Arg(3), Loc(0))], Yield([Loc(0)])),
                        Yield([Loc(0)])),
                    // [acc', ten, b]
                    seq([Stmt::Lit(WBits(64), 1), Op(PAdd, Arg(2), Loc(0))],   // [i', one, acc', ten, b]
                        Jump([Arg(0), Arg(1), Loc(0), Loc(2)])))),
            Ret([Arg(3)]),
            Ret([Arg(3)])))
}

fn count_newlines_r() → Func {
    Func(Sig([rd(0), word_p()], [word_r()]),
        seq([Stmt::Lit(WBits(64), 0), Stmt::Call(0, [Arg(0), Arg(1), Loc(0), Loc(0)], 1)], Ret([Loc(0)])))
}

fn nl_fns() → List<Func> { [nl_loop_r(), count_newlines_r()] }

fn nl_world() → Callees(tys()) {
    λ g ds => match g {
        Zero => [w64(newlines_from(as_buf(arg(ds, 0)), as_w64(arg(ds, 1)), as_w64(arg(ds, 2)), as_w64(arg(ds, 3))))],
        Succ(g1) => match g1 { Zero => [w64(count_newlines(as_buf(arg(ds, 0)), as_w64(arg(ds, 1))))], Succ(_) => Nil },
    }
}

fn text() → List<u8> { [BitVec::ofNat(97), BitVec::ofNat(10), BitVec::ofNat(98), BitVec::ofNat(10), BitVec::ofNat(10), BitVec::ofNat(99)] }

theorem nl_loop_checked(): why(nl_fns(), 0) = None { refl }

theorem count_newlines_checked(): why(nl_fns(), 1) = None { refl }

// The pins, at closed arguments: the world's entry is the body's meaning.
theorem nl_loop_pin(): nl_world()(0, [buf(text()), w64(BitVec::ofNat(5)), w64(BitVec::ofNat(1)), w64(BitVec::ofNat(0))])
    = means(nl_fns(), nl_world(), 0, [buf(text()), w64(BitVec::ofNat(5)), w64(BitVec::ofNat(1)), w64(BitVec::ofNat(0))]) { refl }

theorem count_newlines_pin(): nl_world()(1, [buf(text()), w64(BitVec::ofNat(6))]) = means(nl_fns(), nl_world(), 1, [buf(text()), w64(BitVec::ofNat(6))]) { refl }

theorem count_newlines_value(): count_newlines(text(), BitVec::ofNat(6)) = BitVec::ofNat(3) { refl }

// Each signature is well formed (`Sig::ok`, §23.21).
theorem nl_sigs_ok(): nl_fns().all_bit(λ (f: Func) => Sig::ok(tys(), strs(), f.sig)) = True { refl }

theorem nl_placed(): (placed(nl_fns())).is_some() = True { refl }

// ---------------------------------------------------------------------------
// Runs on both levels, observed alike: level 2's answer's returned values
// lowered and its blocks' bytes (`Dyn::encode`), at the identity injection;
// the bytes level's words and blocks.

fn io0() → Io { Io::of(World::piped([])) }

fn ident() → Nat → Nat { λ b => b }

fn blocks_of(h: level2::Heap(tys())) → List<Option<List<u8>>> {
    h.map(λ (bl: Block(tys())) => match bl { Live(o) => Dyn::encode(tys(), strs(), o.val), Dead => None })
}

fn bheap(h: level2::Heap(tys())) → x86_64_memory_contract::Heap { x86_64_memory_contract::Heap(blocks_of(h).map(λ (o: Option<List<u8>>) => o.unwrap_or(Nil)), Nil, Nil) }

record Seen { words: Option<List<x86_64_call_contract::Value>>, blocks: List<Option<List<u8>>> }

fn l2_seen(fs: List<Func>, g: Nat, r: level2::Ran(tys())) → Option<Seen> {
    match r {
        Done(a) => Some(Seen(values_lower(tys(), strs(), ident(), a.heap, (funcs_at(fs)(g)).sig.returned(tys(), a.results)), blocks_of(a.heap))),
        Exited(_, _) => None,
        Going(_) => None,
        Stuck => None,
    }
}

fn b_seen(r: x86_64_call_contract::Ran<x86_64_call_contract::Answer>) → Option<Seen> {
    match r {
        Done(a) => Some(Seen(Some(a.words), a.heap.blocks.map(λ (bs: List<u8>) => Some(bs)))),
        Exited(_, _) => None,
        Going(_) => None,
        Stuck(_) => None,
    }
}

fn run2(fs: List<Func>, w: Callees(tys()), fuel, g: Nat, vs: List<level2::Value(tys())>, h: level2::Heap(tys())) → level2::Ran(tys()) {
    Run::of(tys(), strs(), funcs_at(fs), w, no_prim(), fuel, g, vs, h, io0())
}

// The bytes level's run of the placed program at one fuel more, from the
// arguments and heap lowered, every block writable where `wr` says.
fn runb(fs: List<Func>, wr: Nat → Bool, fuel, g: Nat, vs: List<level2::Value(tys())>, h: level2::Heap(tys())) → x86_64_call_contract::Ran<x86_64_call_contract::Answer> {
    bytes_level::run(placed(fs).unwrap_or(Program(Nil)), Blocks(wr), fuel + 1, g, values_lower(tys(), strs(), ident(), h, vs).unwrap_or(Nil), bheap(h), io0())
}

fn none_written() → Nat → Bool { λ _ => False }

fn heap1(xs: List<u8>) → level2::Heap(tys()) { [Live(Obj(buf(xs), Nil))] }

fn obj(b: Nat) → level2::Value(tys()) { Refer(level2::Ref(b, Nil)) }

fn word(n: Nat) → level2::Value(tys()) { Plain(w64(BitVec::ofNat(n))) }

// count_newlines over six bytes, three newlines: level 2 at fuel 7 (six
// passes after the first), the bytes level at 8; read-only, no block
// writable.
theorem nl_args_lowered(): values_lower(tys(), strs(), ident(), heap1(text()), [obj(0), word(6)])
    = Some([x86_64_call_contract::Ref(Loc(0, 0)), x86_64_call_contract::Word(BitVec::ofNat(6)), x86_64_call_contract::Word(BitVec::ofNat(6))]) { refl }

theorem nl_level2(): l2_seen(nl_fns(), 1, run2(nl_fns(), nl_world(), 7, 1, [obj(0), word(6)], heap1(text())))
    = Some(Seen(Some([x86_64_call_contract::Word(BitVec::ofNat(3))]), [Some(text())])) { refl }

theorem nl_agree(): b_seen(runb(nl_fns(), none_written(), 7, 1, [obj(0), word(6)], heap1(text())))
    = l2_seen(nl_fns(), 1, run2(nl_fns(), nl_world(), 7, 1, [obj(0), word(6)], heap1(text()))) { refl }

fn going2(r: level2::Ran(tys())) → Bool { match r { Going(_) => True, Done(_) => False, Exited(_, _) => False, Stuck => False } }

fn goingb(r: x86_64_call_contract::Ran<x86_64_call_contract::Answer>) → Bool { match r { Going(_) => True, Done(_) => False, Exited(_, _) => False, Stuck(_) => False } }

// One fuel short of the loop's last turn, both are going: the fuels meet
// exactly here, since the loop calls nothing (§25 on fuel).
theorem nl_going(): Pair(going2(run2(nl_fns(), nl_world(), 6, 1, [obj(0), word(6)], heap1(text()))), goingb(runb(nl_fns(), none_written(), 6, 1, [obj(0), word(6)], heap1(text()))))
    = Pair(True, True) { refl }

// ---------------------------------------------------------------------------
// 2. copy_window: a function that lends a window to write
//
//    fn copy_span(out: &mut [u8], text: &[u8], n, i: u64) → u64 decreases n - i {
//        if i < n { out[i] := text[i]; copy_span(out, text, n, i + 1) } else { i }
//    }
//    fn copy_window(out: &mut [u8], text: &[u8], from, end: u64) → u64
//        requires from <= end, end <= out.len(), end <= text.len()
//    { let k = end - from; copy_span(&mut out[from..from+k], &text[from..from+k], k, 0) }

fn cs_go(out, txt: List<u8>, k: Nat, n, i: u64) → Pair<List<u8>, u64> {
    match k {
        Zero => Pair(out, i),
        Succ(k1) => match i.unsigned_lt_bit(n) {
            False => Pair(out, i),
            True => cs_go(out.update(i.toNat(), λ _ => txt.nth(i.toNat()).unwrap_or(BitVec::ofNat(0))), txt, k1, n, i.add(BitVec::ofNat(1))),
        },
    }
}

fn copy_span(out, txt: List<u8>, n, i: u64) → Pair<List<u8>, u64> { cs_go(out, txt, n.sub(i).toNat(), n, i) }

fn copy_window(out, txt: List<u8>, from, end: u64) → Pair<List<u8>, u64> {
    let k = end.sub(from);
    let r = copy_span(bwin(out, IWord(64, from), IWord(64, k)), bwin(txt, IWord(64, from), IWord(64, k)), k, BitVec::ofNat(0));
    Pair(bput_win(out, IWord(64, from), IWord(64, k), r.fst), r.snd)
}

fn wr(n: Nat) → Param { Param(buf_s(), ByWrite) }

// The loop: a byte of `text` stored into `out` at `i`, round again; it
// answers `i`, then `out` (its `Ret` convention).
fn copy_span_r() → Func {
    Func(Sig([wr(0), rd(0), word_p(), word_p()], [word_r()]),
        Join(TLt(Arg(3), Arg(2)),
            seq([Stmt::Read(el(Arg(1), Var(3))),                // [b]
                 Stmt::Write(el(Arg(0), Var(3)), Loc(0)),
                 Stmt::Lit(WBits(64), 1),                        // [one, b]
                 Op(PAdd, Arg(3), Loc(0))],                      // [i', one, b]
                Jump([Arg(0), Arg(1), Arg(2), Loc(0)])),
            Ret([Arg(3), Arg(0)]),
            Ret([Arg(3), Arg(0)])))
}

// The lengths read and tested as the export tests them (`end` past either
// span's length, or before `from`, answers 0 with nothing stored); then the
// windows opened, lent, written back (the call's written window to the
// view, the view to its place: `Back`, §23.23), each dead once written back,
// and the count answered.
fn zero_ret() → body::Body { seq([Stmt::Lit(WBits(64), 0)], Ret([Loc(0), Arg(0)])) }

fn copy_window_r() → Func {
    Func(Sig([wr(0), rd(0), word_p(), word_p()], [word_r()]),
        seq([Stmt::Len(whole(Arg(0)), WBits(64))],                          // [ol]
            Join(TLt(Loc(0), Arg(3)), zero_ret(), Yield(Nil),
                seq([Stmt::Len(whole(Arg(1)), WBits(64))],                  // [tl, ol]
                    Join(TLt(Loc(0), Arg(3)), zero_ret(), Yield(Nil),
                        Join(TLt(Arg(3), Arg(2)), zero_ret(), Yield(Nil),
                            seq([Op(PSub, Arg(3), Arg(2)),                                   // [k, tl, ol]
                                 View(win(Arg(0), Var(2), Var(4)), Writing),                 // [w, k, ..]
                                 View(win(Arg(1), Var(2), Var(5)), Reading),                 // [t, w, k, ..]
                                 Stmt::Lit(WBits(64), 0),                                    // [z, t, w, k, ..]
                                 Stmt::Call(0, [Loc(2), Loc(1), Loc(3), Loc(0)], 2),         // [w', r, z, t, w, k, ..]
                                 Stmt::Back(whole(Loc(4)), Loc(0)),
                                 Death(whole(Loc(0))),
                                 Stmt::Back(win(Arg(0), Var(2), Var(9)), Loc(4)),
                                 Death(whole(Loc(4))),
                                 Death(whole(Loc(3)))],
                                Ret([Loc(1), Arg(0)]))))))))
}

fn cw_fns() → List<Func> { [copy_span_r(), copy_window_r()] }

fn cw_world() → Callees(tys()) {
    λ g ds => match g {
        Zero => {
            let r = copy_span(as_buf(arg(ds, 0)), as_buf(arg(ds, 1)), as_w64(arg(ds, 2)), as_w64(arg(ds, 3)));
            [w64(r.snd), buf(r.fst)]
        },
        Succ(g1) => match g1 {
            Zero => {
                let r = copy_window(as_buf(arg(ds, 0)), as_buf(arg(ds, 1)), as_w64(arg(ds, 2)), as_w64(arg(ds, 3)));
                [w64(r.snd), buf(r.fst)]
            },
            Succ(_) => Nil,
        },
    }
}

fn outb() → List<u8> { List::replicate(BitVec::ofNat(0), 6) }

theorem copy_span_checked(): why(cw_fns(), 0) = None { refl }

theorem copy_window_checked(): why(cw_fns(), 1) = None { refl }

theorem copy_span_pin(): cw_world()(0, [buf(outb()), buf(text()), w64(BitVec::ofNat(4)), w64(BitVec::ofNat(1))])
    = means(cw_fns(), cw_world(), 0, [buf(outb()), buf(text()), w64(BitVec::ofNat(4)), w64(BitVec::ofNat(1))]) { refl }

theorem copy_window_pin(): cw_world()(1, [buf(outb()), buf(text()), w64(BitVec::ofNat(1)), w64(BitVec::ofNat(4))])
    = means(cw_fns(), cw_world(), 1, [buf(outb()), buf(text()), w64(BitVec::ofNat(1)), w64(BitVec::ofNat(4))]) { refl }

theorem copy_window_value(): copy_window(outb(), text(), BitVec::ofNat(1), BitVec::ofNat(4))
    = Pair([BitVec::ofNat(0), BitVec::ofNat(10), BitVec::ofNat(98), BitVec::ofNat(10), BitVec::ofNat(0), BitVec::ofNat(0)], BitVec::ofNat(3)) { refl }

theorem cw_sigs_ok(): cw_fns().all_bit(λ (f: Func) => Sig::ok(tys(), strs(), f.sig)) = True { refl }

theorem cw_placed(): (placed(cw_fns())).is_some() = True { refl }

// `out` is block 0, lent to write; `text` block 1.
fn heap2() → level2::Heap(tys()) { [Live(Obj(buf(outb()), Nil)), Live(Obj(buf(text()), Nil))] }

fn first_written() → Nat → Bool { λ b => b.same(0) }

theorem cw_level2(): l2_seen(cw_fns(), 1, run2(cw_fns(), cw_world(), 5, 1, [obj(0), obj(1), word(1), word(4)], heap2()))
    = Some(Seen(Some([x86_64_call_contract::Word(BitVec::ofNat(3))]),
        [Some([BitVec::ofNat(0), BitVec::ofNat(10), BitVec::ofNat(98), BitVec::ofNat(10), BitVec::ofNat(0), BitVec::ofNat(0)]), Some(text())])) { refl }

theorem cw_agree(): b_seen(runb(cw_fns(), first_written(), 5, 1, [obj(0), obj(1), word(1), word(4)], heap2()))
    = l2_seen(cw_fns(), 1, run2(cw_fns(), cw_world(), 5, 1, [obj(0), obj(1), word(1), word(4)], heap2())) { refl }

// `end` past both lengths: the tests answer 0 and store nothing, on both.
theorem cw_past_end(): Pair(b_seen(runb(cw_fns(), first_written(), 5, 1, [obj(0), obj(1), word(1), word(9)], heap2())),
        l2_seen(cw_fns(), 1, run2(cw_fns(), cw_world(), 5, 1, [obj(0), obj(1), word(1), word(9)], heap2())))
    = Pair(Some(Seen(Some([x86_64_call_contract::Word(BitVec::ofNat(0))]), [Some(outb()), Some(text())])),
        Some(Seen(Some([x86_64_call_contract::Word(BitVec::ofNat(0))]), [Some(outb()), Some(text())]))) { refl }

// ---------------------------------------------------------------------------
// 3. sum: a recursion
//
//    fn sum(n: u64) → u64 decreases n { if 0 < n { n + sum(n - 1) } else { 0 } }

fn sum_go(k: Nat, n: u64) → u64 {
    match k { Zero => BitVec::ofNat(0), Succ(k1) => match BitVec::ofNat(0).unsigned_lt_bit(n) { True => n.add(sum_go(k1, n.sub(BitVec::ofNat(1)))), False => BitVec::ofNat(0) } }
}

fn sum(n: u64) → u64 { sum_go(n.toNat(), n) }

fn sum_r() → Func {
    Func(Sig([word_p()], [word_r()]),
        seq([Stmt::Lit(WBits(64), 0)],                                   // [z]
            Join(TLt(Loc(0), Arg(0)),
                seq([Stmt::Lit(WBits(64), 1),                             // [one, z]
                     Op(PSub, Arg(0), Loc(0)),                            // [m, one, z]
                     Stmt::Call(0, [Loc(0)], 1),                          // [s, m, one, z]
                     Op(PAdd, Arg(0), Loc(0))],                           // [r, s, m, one, z]
                    Ret([Loc(0)])),
                Ret([Loc(0)]),
                Ret([Loc(0)]))))
}

fn sum_fns() → List<Func> { [sum_r()] }

fn sum_world() → Callees(tys()) { λ g ds => match g { Zero => [w64(sum(as_w64(arg(ds, 0))))], Succ(_) => Nil } }

theorem sum_checked(): why(sum_fns(), 0) = None { refl }

theorem sum_pin(): sum_world()(0, [w64(BitVec::ofNat(4))]) = means(sum_fns(), sum_world(), 0, [w64(BitVec::ofNat(4))]) { refl }

theorem sum_sigs_ok(): sum_fns().all_bit(λ (f: Func) => Sig::ok(tys(), strs(), f.sig)) = True { refl }

theorem sum_placed(): (placed(sum_fns())).is_some() = True { refl }

theorem sum_level2(): l2_seen(sum_fns(), 0, run2(sum_fns(), sum_world(), 4, 0, [word(4)], Nil)) = Some(Seen(Some([x86_64_call_contract::Word(BitVec::ofNat(10))]), Nil)) { refl }

theorem sum_agree(): b_seen(runb(sum_fns(), none_written(), 4, 0, [word(4)], Nil)) = l2_seen(sum_fns(), 0, run2(sum_fns(), sum_world(), 4, 0, [word(4)], Nil)) { refl }

// One fuel short, both going: a call costs one on each side.
theorem sum_going(): Pair(going2(run2(sum_fns(), sum_world(), 3, 0, [word(4)], Nil)), goingb(runb(sum_fns(), none_written(), 3, 0, [word(4)], Nil))) = Pair(True, True) { refl }

// ---------------------------------------------------------------------------
// Lowered: `Program::lower` answers `Some` for each placed program, at a
// placement written by a linear scan over each path (the planner is not yet
// on the bytes level: §25), so every layout premise is met.

fn nl_places() → List<function_ir_lower::Place> { [Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(R9), Into(R10), Into(R11), Into(Rax), Into(R9), Into(R8), Into(R9), Into(R8), Into(Rax), Into(R8), Into(R8), Into(R8), Into(Rax), Into(Rcx), Into(R9), Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(Rax), Into(R9), Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(Rax), Into(R9), Into(R10), CallSlots(0), Into(Rcx), Spilling(0), Into(Rax)] }

fn nl_lowered() → Option<x86_64_asm::Prog> { placed(nl_fns()).and_then(λ (q: Program) => q.lower(nl_places())) }

theorem nl_lowers(): nl_lowered().is_some() = True { refl }

fn cw_places() → List<function_ir_lower::Place> { [Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(R9), Into(R10), Into(R11), Into(Rax), Into(R10), Into(Rax), Into(Rax), Into(R9), Into(R10), Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(R9), Into(Rax), Into(R10), Into(Rdi), Into(Rsi), Into(Rdx), Into(Rcx), Into(R8), Into(R9), Into(Rax), Into(R10), Into(R11), CallSlots(0), Into(R10), Into(R11), Into(Rax), Into(R10), Into(R11), Into(Rax), Into(R10), Into(R11), Into(Rax), Into(Rcx), Into(Rsi), Into(Rdx), Into(Rdi), Spilling(0), Into(Rax)] }

fn cw_lowered() → Option<x86_64_asm::Prog> { placed(cw_fns()).and_then(λ (q: Program) => q.lower(cw_places())) }

theorem cw_lowers(): cw_lowered().is_some() = True { refl }

fn sum_places() → List<function_ir_lower::Place> { [CallSlots(1), Into(Rcx), Into(Rdx), Into(Rsi), Into(R8), Spilling(8), Into(Rdi), Into(Rax), Into(Rax)] }

fn sum_lowered() → Option<x86_64_asm::Prog> { placed(sum_fns()).and_then(λ (q: Program) => q.lower(sum_places())) }

theorem sum_lowers(): sum_lowered().is_some() = True { refl }

// ---------------------------------------------------------------------------
// Checked, in the fragment, and refused by `place` (§25.5): what `place`
// does not yet place beyond the fragment's limits and the three tests the
// run's changes remove.

// A view of a word element, read through: `let v = &text[i]; *v`.
fn word_view_r() → Func { Func(Sig([rd(0), word_p()], [word_r()]), seq([View(el(Arg(0), Var(1)), Reading), Stmt::Read(whole(Loc(0)))], Ret([Loc(0)]))) }

// A word variable written: `n := 1; n`.
fn word_write_r() → Func { Func(Sig([word_p()], [word_r()]), seq([Stmt::Lit(WBits(64), 1), Stmt::Write(whole(Arg(0)), Loc(0))], Ret([Arg(0)]))) }

// A taken word answered back, as a fresh word (a plain value answered back
// is `OFresh`).
fn word_back_r() → Func { Func(Sig([word_p()], [Result(u64_s(), OFresh)]), Ret([Arg(0)])) }

// A narrow index, placed since §25.5: `text[i as u32]`.
fn narrow_index_r() → Func {
    Func(Sig([rd(0), Param(SWord(WBits(32)), ByTake)], [Result(u8_s(), OFresh)]), seq([Stmt::Read(el(Arg(0), Var(1)))], Ret([Loc(0)])))
}

// The checker's verdict and whether `place` answers: a view of a word is
// refused by its codes (not a finding); a word variable written is checked
// and placed since its slot rebinds (§25.9); a taken word answered back
// fresh is checked and placed; a narrow index is checked and placed.
theorem refusals_sorted(): [word_view_r(), word_write_r(), word_back_r(), narrow_index_r()].map(λ (f: Func) => Pair(why([f], 0), placed([f]).is_some()))
    = [Pair(Some(WCodes), False), Pair(None, True), Pair(None, True), Pair(None, True)] { refl }

// Codes compared (§25.8): `1u64 + 2u8` reads the u8 as zero on level 2
// (`Dyn::words`) and adds it on the bytes level, so `place` refuses it; the
// checker refuses it by its codes too.
fn mixed_r() → Func { Func(Sig(Nil, [word_r()]), seq([Stmt::Lit(WBits(64), 1), Stmt::Lit(WBits(8), 2), Op(PAdd, Loc(1), Loc(0))], Ret([Loc(0)]))) }

theorem codes_compared(): Pair(why([mixed_r()], 0), placed([mixed_r()]).is_some()) = Pair(Some(WCodes), False) { refl }

fn in_fragment(fs: List<Func>) → List<Bool> { fs.map(λ (f: Func) => f.fragment(tys(), strs(), sigs_of(fs), no_prim())) }

// The three programs are in the fragment, and so is the written word
// variable, now placed.
theorem fragments(): in_fragment(nl_fns()) ++ in_fragment(cw_fns()) ++ in_fragment(sum_fns()) ++ in_fragment([word_write_r()]) = [True, True, True, True, True, True] { refl }

// ---------------------------------------------------------------------------
// Joins in a row (§25.5): `k` joins each of whose arms yield, the next one
// reading the last's output, placed as `k` branches with what follows each
// placed once, so the routine's size is linear in `k` (copying what follows
// into each arm would read it `2^k` times).

fn packed_from(k: Nat) → body::Body { match k { Zero => Ret([Loc(0)]), Succ(j) => Join(TLt(Loc(0), Arg(0)), Yield([Arg(0)]), Yield([Loc(0)]), packed_from(j)) } }

fn packed_r(k: Nat) → Func { Func(Sig([word_p()], [word_r()]), seq([Stmt::Lit(WBits(64), 0)], packed_from(k))) }

fn code_size(b: bytes_level::Body) → Nat {
    match b {
        Leaf(is) => is.len(), Seq(a, r) => code_size(a) + code_size(r), Branch(_, y, n) => code_size(y) + code_size(n) + 1,
        Call(_, _, _) => 1, Loop(_, _, inner, _, _, _) => code_size(inner) + 1, Sys(_) => 1, Exit(_) => 1,
    }
}

fn packed_size(k: Nat) → Nat { match placed([packed_r(k)]) { Some(p) => match p.routines { Cons(r, _) => code_size(r.body), Nil => 0 }, None => 0 } }

theorem packed_checked(): why([packed_r(3)], 0) = None { refl }

fn packed_sizes() → List<Nat> { [packed_size(1), packed_size(2), packed_size(3), packed_size(4), packed_size(8)] }

// Four nodes a join, two to start and end: 2 + 4k.
theorem packed_linear(): packed_sizes() = [6, 10, 14, 18, 34] { refl }

// ---------------------------------------------------------------------------
// The injection's lemmas at a closed value (placement_inject.hthr, §25.8):
// a window of the text from 1, four long, then its element 2, is located at
// byte 3, the byte 10, and the encoding's byte there is that byte.

theorem located_in_window(): Sel::locate(tys(), strs(), buf(text()), [win_sel(INat(1), INat(4)), el_sel(IWord(64, BitVec::ofNat(2)))], 0)
    = Some(Pair(3, Dyn(u8_s(), BitVec::ofNat(10)))) { refl }

theorem located_bytes(): (Dyn::encode(tys(), strs(), buf(text()))).map(λ (bs: List<u8>) => bs.window(3, 4)) = Some([BitVec::ofNat(10)]) { refl }

// ---------------------------------------------------------------------------
// The layout's law (§25.8, F1; §25.9): the probes' environment is laid out,
// from `Seq::words`' positional laws (sequences.hthr) and its laws; the
// library's lawful number-indexed `Seq::list` is not, and a program over it
// is checked and placed and answers differently on the two levels.

theorem strs_laid(): Strs::Laid(tys(), strs()) {
    Strs::laid_of(tys(), strs(), strs_lawful(), λ k => match k {
        Zero => ⟨Seq::words_num(tys(), u8_s(), BitVec::ofNat(0), Some(Seq::words_win(tys(), u8_s(), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l))),
            ⟨refl, Exists(λ (l: List<u8>) => l, ⟨λ y => refl, Seq::words_win_num(tys(), u8_s(), BitVec::ofNat(0), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l, λ l => refl,
                Some(Seq::words_win(tys(), u8_s(), buf_s(), λ (l: List<u8>) => l, λ (l: List<u8>) => l)))⟩)⟩⟩,
        Succ(_) => trivial,
    })
}

// The byte buffer as `Seq::list` (a number indexes, a word reads the pad).
fn strs_list() → Strs(tys()) { λ k => match k { Zero => Struct(Object, None, Sequence(Seq::list(tys(), u8_s(), BitVec::ofNat(0), None))), Succ(_) => Struct(Plain, None, Opaque) } }

theorem list_lawful(): StrsLaws(tys(), strs_list()) {
    λ k => match k { Zero => ⟨Seq::list_laws(tys(), u8_s(), BitVec::ofNat(0), None), ⟨trivial, trivial⟩⟩, Succ(_) => trivial }
}

// Not laid out: element 0 read at the number and at the 64-bit word differ.
theorem list_not_laid(): ¬Strs::Laid(tys(), strs_list()) {
    λ laid => {
        let sq: SeqLaid(tys(), strs_list(), buf_s(), u8_s(), 1) = (laid.left(buf_s(), u8_s(), 1, None, refl)).left;
        let e = sq.elem_num([BitVec::ofNat(5)], INat(0), IWord(64, BitVec::ofNat(0)), refl);
        let bad: (True = False) = cong_fn(λ (d: Dyn(tys())) => Dyn::index(tys(), d).same(5), e);
        absurd(bad)
    }
}

// `fn first(xs: &[u8]) → u8 { xs[0] }` over it, on [5]: checked and
// placed; level 2 answers 5, the bytes level the pad its block holds, 0.
fn first_r() → Func { Func(Sig([rd(0)], [Result(u8_s(), OFresh)]), seq([Stmt::Read(el(Arg(0), Lit(0)))], Ret([Loc(0)]))) }

fn heap_five() → level2::Heap(tys()) { [Live(Obj(buf([BitVec::ofNat(5)]), Nil))] }

fn first_l2() → Option<List<x86_64_call_contract::Value>> {
    match Run::of(tys(), strs_list(), funcs_at([first_r()]), λ _ _ => Nil, no_prim(), 1, 0, [obj(0)], heap_five(), io0()) {
        Done(a) => values_lower(tys(), strs_list(), ident(), a.heap, a.results),
        Exited(_, _) => None, Going(_) => None, Stuck => None,
    }
}

fn first_b() → Option<List<x86_64_call_contract::Value>> {
    let hb = x86_64_memory_contract::Heap([(Dyn::encode(tys(), strs_list(), buf([BitVec::ofNat(5)]))).unwrap_or(Nil)], Nil, Nil);
    match bytes_level::run(place(tys(), strs_list(), no_prim(), [first_r()]).unwrap_or(Program(Nil)), Blocks(none_written()), 2, 0,
        values_lower(tys(), strs_list(), ident(), heap_five(), [obj(0)]).unwrap_or(Nil), hb, io0()) {
        Done(a) => Some(a.words), Exited(_, _) => None, Going(_) => None, Stuck(_) => None,
    }
}

theorem first_disagrees(): Pair((first_r()).refusal(tys(), strs_list(), sigs_of([first_r()]), no_prim(), λ _ => True, 0), Pair(first_l2(), first_b()))
    = Pair(None, Pair(Some([x86_64_call_contract::Word(BitVec::ofNat(5))]), Some([x86_64_call_contract::Word(BitVec::ofNat(0))]))) { refl }

// F2: `fn f(x: u64) → u64 { x + 255 }` at the u8 1 adds at the argument's
// own width on level 2 (1: the u64 255 reads as zero there) and at 64 bits
// on the bytes level (256). `Dyn::Coded`, now a premise, refuses the
// argument.
fn add255_r() → Func { Func(Sig([word_p()], [word_r()]), seq([Stmt::Lit(WBits(64), 255), Op(PAdd, Arg(0), Loc(0))], Ret([Loc(0)]))) }

fn add255_l2() → Option<List<x86_64_call_contract::Value>> {
    match run2([add255_r()], λ _ _ => Nil, 1, 0, [Plain(Dyn(u8_s(), BitVec::ofNat(1)))], Nil) {
        Done(a) => values_lower(tys(), strs(), ident(), a.heap, a.results), Exited(_, _) => None, Going(_) => None, Stuck => None,
    }
}

fn add255_b() → Option<List<x86_64_call_contract::Value>> { b_seen(runb([add255_r()], none_written(), 1, 0, [Plain(Dyn(u8_s(), BitVec::ofNat(1)))], Nil)).and_then(λ (s: Seen) => s.words) }

theorem ill_coded(): Pair(why([add255_r()], 0), Pair(Dyn::coded(tys(), [Dyn(u8_s(), BitVec::ofNat(1))], [word_p()]), Pair(add255_l2(), add255_b())))
    = Pair(None, Pair(False, Pair(Some([x86_64_call_contract::Word(BitVec::ofNat(1))]), Some([x86_64_call_contract::Word(BitVec::ofNat(256))])))) { refl }

// F4: `1u64 + 2u8` reads the u8 as zero on level 2, which answers 1 where
// the operands sum to 3; `place` compares the codes (`codes_compared`).
fn mixed_l2() → Option<List<x86_64_call_contract::Value>> {
    match run2([mixed_r()], λ _ _ => Nil, 1, 0, Nil, Nil) {
        Done(a) => values_lower(tys(), strs(), ident(), a.heap, a.results), Exited(_, _) => None, Going(_) => None, Stuck => None,
    }
}

theorem mixed_reads_zero(): mixed_l2() = Some([x86_64_call_contract::Word(BitVec::ofNat(1))]) { refl }

// ---------------------------------------------------------------------------
// A death of an owner against `StageRel` (§25.9): the dying variable stays
// in both environments, its slot reading the reference it read, while its
// block is dead on level 2, where `value_lower` answers nothing.

fn owner_env() → REnv(tys()) { REnv([Cell(obj(0), True)], Nil) }

fn owner_slot() → PSlot { PSlot(buf_s(), [ref_id(0), word_id(1)]) }

fn after_death() → Option<level2::Heap(tys())> {
    match (Death(whole(Arg(0)))).run(tys(), strs(), funcs_at(Nil), λ _ _ _ _ => level2::Stuck, Act(Nil, 0), Mach(heap1(text()), owner_env(), io0()), λ m2 => Done(Answer(Nil, m2.heap, m2.io))) {
        Done(a) => Some(a.heap), Exited(_, _) => None, Going(_) => None, Stuck => None,
    }
}

theorem death_breaks_rel(): Pair((Death(whole(Arg(0)))).place(tys(), PCx(strs(), sigs_of(Nil), no_prim()), PEnv(1, [owner_slot()]), 2).is_some(),
        Pair(value_lower(tys(), strs(), ident(), heap1(text()), obj(0)).is_some(), after_death().map(λ (h: level2::Heap(tys())) => value_lower(tys(), strs(), ident(), h, obj(0)).is_some())))
    = Pair(True, Pair(True, Some(False))) { refl }

// A loop answering a view (§25.9): checked and in the fragment, refused by
// `place`, whose loop state zeroes its results part and a reference has no
// zero.
fn view_loop_r() → Func {
    Func(Sig([rd(0), word_p()], [Result(buf_s(), OView(0, [SWindow(Lit(0), Lit(1))]))]),
        seq([Stmt::Lit(WBits(64), 1)],                                            // [one]
            Join(TLt(Arg(1), Loc(0)), seq([View(win(Arg(0), Lit(0), Lit(1)), Reading)], Ret([Loc(0)])), Yield(Nil),
                seq([Op(PSub, Arg(1), Loc(0))], Jump([Arg(0), Loc(0)])))))
}

theorem view_loop_refused(): Pair(why([view_loop_r()], 0), Pair(in_fragment([view_loop_r()]), placed([view_loop_r()]).is_some())) = Pair(None, Pair([True], False)) { refl }

// An index into elements of eight bytes is shifted by three (§25.10): the
// shift is `ShiftLeft`'s literal amount, one node, its output the scaled
// index.
theorem scaled_shifts(): Pair(scaled(Word1(Nil, 5, 9), 8), scaled(Word1(Nil, 5, 9), 1)) = Pair(Word1([Compute(ShiftLeft(64, 9, 5, 3))], 9, 10), Word1(Nil, 5, 9)) { refl }

// The node shifts 7 to 56.
theorem scaled_value(): ((Compute(ShiftLeft(64, 9, 5, 3))).step(Blocks(λ _ => False), Config(Locals(Valuation::set(Valuation::zero(), 5, λ (w: Nat) => BitVec::ofNat(7)), λ _ => None),
        x86_64_memory_contract::Heap(Nil, Nil, Nil), io0()))).map(λ (c: Config) => c.locals.word(9).toNat()) = Some(56) { refl }

// F8 (§25.10): a word slot over a cell that refers to a dead block holds
// whatever word, as F7's ruling has it, while an index atom reads such a
// variable through `Mach::ixs`, which never sticks: as the number zero.
// Arguments: the text (slots 0, 1) and an index variable whose cell refers
// to block 1, past the heap (slot 2, holding 1). `text[x]` reads element 0
// at level 2 (97), and its placed leaf loads element 1 (10).
fn f8_env() → PEnv { PEnv(2, [PSlot(buf_s(), [ref_id(0), word_id(1)]), PSlot(u64_s(), [word_id(2)])]) }

fn f8_mach() → Mach(tys()) { Mach(heap1(text()), REnv([Cell(obj(0), False), Cell(obj(1), False)], Nil), io0()) }

fn f8_config() → Config {
    Config(Locals(Valuation::set(Valuation::set(Valuation::zero(), 1, λ (w: Nat) => BitVec::ofNat(6)), 2, λ (w: Nat) => BitVec::ofNat(1)),
        λ (i: Nat) => match i { Zero => Some(Loc(0, 0)), Succ(_) => None }), bheap(heap1(text())), io0())
}

fn f8_read() → Stmt { Stmt::Read(el(Arg(0), Var(1))) }

// Level 2's read: the pushed cell's value.
fn f8_level2() → Option<Nat> {
    match f8_read().run(tys(), strs(), funcs_at(Nil), λ _ _ _ _ => level2::Stuck, Act(Nil, 1), f8_mach(),
            λ m2 => Done(Answer(match m2.env.locs { Cons(cl, _) => [cl.v], Nil => Nil }, m2.heap, m2.io))) {
        Done(a) => match a.results { Cons(v, _) => match v { Plain(d) => Some(Dyn::index(tys(), d)), Refer(_) => None }, Nil => None },
        Exited(_, _) => None, Going(_) => None, Stuck => None,
    }
}

// The bytes level's leaf: the word the new slot holds.
fn f8_bytes() → Option<Nat> {
    match f8_read().place(tys(), PCx(strs(), sigs_of(Nil), no_prim()), f8_env(), 3) {
        Some(o) => match o.code {
            Leaf(is) => match run_instrs(Blocks(none_written()), is, f8_config()) {
                Some(c2) => match o.env.vars.nth(2) { Some(s) => match s.word() { Some(t) => Some(c2.locals.word(t.id).toNat()), None => None }, None => None },
                None => None,
            },
            _ => None,
        },
        None => None,
    }
}

// The relation's parts at the arguments: the text's slot reads its
// lowering at its code, and the index's cell is over no live block (its
// slot unconstrained); level 2 reads 97, the leaf 10.
theorem f8_atom_dead(): Pair(Pair(read_values([ref_id(0), word_id(1)], f8_config().locals), value_lower(tys(), strs(), ident(), heap1(text()), obj(0))),
        Pair(value_live(tys(), heap1(text()), obj(1)), Pair(f8_level2(), f8_bytes())))
    = Pair(Pair(Some([x86_64_call_contract::Ref(Loc(0, 0)), x86_64_call_contract::Word(BitVec::ofNat(6))]), Some([x86_64_call_contract::Ref(Loc(0, 0)), x86_64_call_contract::Word(BitVec::ofNat(6))])),
        Pair(False, Pair(Some(97), Some(10)))) { refl }

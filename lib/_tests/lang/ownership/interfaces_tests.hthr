// The remaining interfaces stated at one small function, so each type is
// checked (lib/lang/ownership/level2.hthr, verdict.hthr;
// issues/ownership-interfaces.md): level 2's heap and objects with holes, a
// canonical reference, the run's outcome, each residual kind, the verdict's
// tree, a function's safety and `check_sound`. Nothing is proved over the
// statements but a control: a run that is stuck is not safe.
import logic;
import bool;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import sequences;
import body;
import level2;
import verdict;
import checker;
import linux_world;

fn tys() → Nat → Type { λ k => match k { Zero => List<Nat>, Succ(_) => True } }

fn strs() → Strs(tys()) {
    λ k => match k { Zero => Struct(Object, None, Sequence(Seq::list(tys(), SWord(WNat), 0, None))), Succ(_) => Struct(Plain, None, Opaque) }
}

fn nat(n: Nat) → Dyn(tys()) { Dyn(SWord(WNat), n) }

fn nats(xs: List<Nat>) → Dyn(tys()) { Dyn(SNamed(0), xs) }

// A pin's continuation: the first result read back as a number.
fn as_nat(rs: List<Dyn(tys())>) → Nat { Dyn::index(tys(), rs.nth(0).unwrap_or(Dyn::none(tys()))) }

// `fn pick(xs: &[Nat], i: Nat, inside: ∥i < xs.len()∥) → Nat { xs[i] }`,
// as the list's own total accessor reads.
fn pick(xs: List<Nat>, i: Nat, inside: ∥i < xs.len()∥) → Nat { xs.nth(i).unwrap_or(0) }

fn pick_r() → Func { Func(Sig([Param(SNamed(0), ByRead), Param(SWord(WNat), ByTake)], [Result(SWord(WNat), OFresh)]), seq([Read(Place(Arg(0), [SElem(Var(1))]))], Ret([Loc(0)]))) }

fn pick_ctx(xs: List<Nat>, i: Nat) → Ctx(tys()) { Ctx(strs(), λ _ _ => Nil, 0, λ _ _ => True, λ _ _ => 0, [nats(xs), nat(i)]) }

fn pick_env(xs: List<Nat>, i: Nat) → Env(tys()) { Env::start(tys(), [nats(xs), nat(i)]) }

theorem pick_means(xs: List<Nat>, i: Nat, inside: ∥i < xs.len()∥): pick_r().then(Nat, tys(), strs(), λ _ _ => Nil, 0, [nats(xs), nat(i)], as_nat) = pick(xs, i, inside) { refl }

// ---------------------------------------------------------------------------
// The residual kinds, each the source's proposition by conversion

// An element read owes its accessor's bound: the source's own hypothesis.
theorem access_is_bound(xs: List<Nat>, i: Nat): RAccess(Place(Arg(0), [SElem(Var(1))])).Holds(tys(), pick_ctx(xs, i), pick_env(xs, i)) = (∥i < xs.len()∥) { refl }

// Two windows apart: a disjunction naming its sides.
theorem apart_is_sides(xs: List<Nat>, i: Nat): RApart(Lit(0), Var(1), Var(1), Lit(1)).Holds(tys(), pick_ctx(xs, i), pick_env(xs, i)) = ((0 + i <= i) ∨ (i + 1 <= 0)) { refl }

// A write of a whole place: what is written fits what was there.
theorem fits_is_same(xs: List<Nat>, i: Nat): RFits(Place(Arg(0), Nil), Arg(0)).Holds(tys(), pick_ctx(xs, i), pick_env(xs, i)) = Dyn::Fits(tys(), strs(), nats(xs), nats(xs)) { refl }

// A callee's precondition at the values passed, and a measure.
theorem pre_is_callee(xs: List<Nat>, i: Nat): RPre(3, [Arg(1)]).Holds(tys(), pick_ctx(xs, i), pick_env(xs, i)) = True { refl }

theorem measure_is_below(xs: List<Nat>, i: Nat): RMeasure(0, [Arg(0), Arg(1)]).Holds(tys(), pick_ctx(xs, i), pick_env(xs, i)) = (0 < 0) { refl }

// ---------------------------------------------------------------------------
// The verdict's tree, owed along the meaning: discharged by the source's
// proof, placed

fn pick_owes() → Owes { ODo([RAccess(Place(Arg(0), [SElem(Var(1))]))], OEnd) }

theorem pick_due(xs: List<Nat>, i: Nat, inside: ∥i < xs.len()∥): pick_owes().Due(tys(), pick_ctx(xs, i), pick_r()) { ⟨inside, trivial⟩ }

// The control: a verdict not in the body's shape owes `False`.
theorem wrong_shape_owes_false(xs: List<Nat>, i: Nat): OJump(Nil).Due(tys(), pick_ctx(xs, i), pick_r()) = False { refl }

// ---------------------------------------------------------------------------
// Level 2

// A block holding the list, and a second holding an object one of whose
// fields is owned by the first: read as a value, the hole is filled.
fn heap1(xs: List<Nat>) → Heap(tys()) { [Live(Obj(nats(xs), Nil))] }

theorem read_plain(xs: List<Nat>): Obj::read(tys(), strs(), heap1(xs), 1, Obj(nats(xs), Nil)) = Some(nats(xs)) { refl }

// A taken place has no value.
theorem read_taken(xs: List<Nat>): Obj::read(tys(), strs(), heap1(xs), 1, Obj(nats(xs), [HoleAt([OnSeq(SeqOne(INat(0)))], Taken)])) = None { refl }

// A reference into the block, and what it says to be canonical.
fn canon_ref(xs: List<Nat>) → Type { Ref::Canonical(tys(), heap1(xs), Ref(0, [OnSeq(SeqOne(INat(2)))])) }

theorem ref_reads(xs: List<Nat>): Value::read(tys(), Refer(Ref(0, [OnSeq(SeqOne(INat(2)))])), strs(), heap1(xs), 1) = Some(nat(xs.nth(2).unwrap_or(0))) { refl }

// ---------------------------------------------------------------------------
// A program, a function's safety, `check_sound`: their types at `pick`

// `pick` with its precondition, and without it.
fn pick_pre(ds: List<Dyn(tys())>) → Type { ∥Dyn::index(tys(), ds.nth(1).unwrap_or(Dyn::none(tys()))) < Dyn::len(tys(), strs(), ds.nth(0).unwrap_or(Dyn::none(tys())))∥ }

fn pick_world() → Callees(tys()) { λ _ ds => [nat(Dyn::back(tys(), SNamed(0), ds.nth(0).unwrap_or(Dyn::none(tys())), Nil).nth(Dyn::index(tys(), ds.nth(1).unwrap_or(Dyn::none(tys())))).unwrap_or(0))] }

fn pick_prog(pre: List<Dyn(tys())> → Type) → Prog(tys()) {
    Prog(strs(), λ _ => pick_r(), pick_world(), λ _ ds => pre(ds), λ _ => Some(λ _ _ => 0), λ _ => False, λ _ _ _ => True)
}

fn pick_safety(pre: List<Dyn(tys())> → Type) → Type { Safety(tys(), pick_prog(pre), 0) }

fn pick_check_sound(check: Checker(tys())) → Type<1> { CheckSound(tys(), check) }

// The program's run is the defined one, reading the list by value here.
theorem pick_runs(io: Io): (pick_prog(pick_pre)).run(tys(), 1, 0, [Plain(nats([4, 5])), Plain(nat(1))], Nil, io) = Done(Answer([Plain(nat(5))], Nil, io)) { refl }

// The control: without its precondition `pick` is not safe. At an empty
// list it reads past the end, and its own run is stuck, at inputs that
// read as the meaning's arguments and are lendable.
fn empty_in() → List<Value(tys())> { [Plain(nats(Nil)), Plain(nat(0))] }

// A plain argument is not a reference.
fn Value::is_refer(o: Option<Value(tys())>) → Type { match o { Some(v) => match v { Plain(_) => False, Refer(_) => True }, None => False } }

theorem plain_not_refer(d: Dyn(tys()), r: Ref, e: Some(level2::Plain(d)) = Some(Refer(r))): False { j(sym(e), λ o _ => Value::is_refer(o), trivial) }

theorem empty_no_refer(i: Nat, r: Ref): ¬(empty_in().nth(i) = Some(Refer(r))) {
    match i { Zero => λ e => plain_not_refer(nats(Nil), r, e), Succ(k) => match k { Zero => λ e => plain_not_refer(nat(0), r, e), Succ(_) => λ e => absurd(e) } }
}

theorem empty_lendable(): Lendable(tys(), strs(), pick_r().sig.params, Nil, empty_in()) {
    Lendable(refl, λ i r e => false_elim(empty_no_refer(i, r, e)), λ i p _ _ _ r => empty_no_refer(i, r), λ i k _ p _ _ r q e _ => false_elim(empty_no_refer(i, r, e)),
        λ i p _ _ _ r e => false_elim(empty_no_refer(i, r, e)))
}

theorem empty_stuck(io: Io): (pick_prog(λ _ => True)).run(tys(), 0, 0, empty_in(), Nil, io) = Stuck { refl }

theorem unpreconditioned_not_safe(io: Io): ¬pick_safety(λ _ => True) {
    λ safe => {
        let at0 = safe(0, λ g2 k no => false_elim(Nat::not_succ_le_zero(k, no)));
        let clauses = at0(empty_in(), Nil, io, [nats(Nil), nat(0)], ⟨refl, ⟨refl, trivial⟩⟩, refl, trivial, empty_lendable());
        clauses.left(empty_stuck(io))
    }
}

// The arguments' codes: `pick`'s are a list and a word, and two words are
// not (§23.7: without the clause, a function reading a field of an
// argument given a word owes nothing, and its run is stuck).
theorem pick_args_coded(xs: List<Nat>, i: Nat): Dyn::Coded(tys(), [nats(xs), nat(i)], pick_r().sig.params) { refl }

theorem words_not_coded(): ¬Dyn::Coded(tys(), [nat(5), nat(1)], pick_r().sig.params) { λ no => absurd(no) }

// ---------------------------------------------------------------------------
// The check's refusals, from codes alone (the checker's pass says so,
// `Func::refusal`): the meaning of each is junk

fn sigs() → Nat → Sig { λ g => match g { Zero => Sig([Param(SNamed(0), ByRead), Param(SWord(WNat), ByTake)], [Result(SWord(WNat), OFresh)]), Succ(_) => Sig(Nil, Nil) } }

fn refused(f: Func, sg: Nat → Sig) → Option<Why> { f.refusal(tys(), strs(), sg, λ _ => False, λ _ => True, 0) }

theorem pick_coded(): refused(pick_r(), sigs()) = None { refl }

// A join whose arms yield a number and a list.
fn ill_join_r() → Func { Func(pick_r().sig, Join(TLt(Arg(1), Arg(1)), Yield([Arg(1)]), Yield([Arg(0)]), Ret([Loc(0)]))) }

theorem ill_join_refused(): refused(ill_join_r(), sigs()) = Some(WCodes) { refl }

// The same join yielding one code is accepted.
fn good_join_r() → Func { Func(pick_r().sig, Join(TLt(Arg(1), Arg(1)), Yield([Arg(1)]), seq([Lit(WNat, 0)], Yield([Loc(0)])), Ret([Loc(0)]))) }

theorem good_join_coded(): refused(good_join_r(), sigs()) = None { refl }

// A call of `pick` (callee 0) with its arguments swapped.
fn ill_call_r() → Func { Func(pick_r().sig, seq([Call(0, [Arg(1), Arg(0)], 1)], Ret([Loc(0)]))) }

theorem ill_call_refused(): refused(ill_call_r(), sigs()) = Some(WCodes) { refl }

fn good_call_r() → Func { Func(pick_r().sig, seq([Call(0, [Arg(0), Arg(1)], 1)], Ret([Loc(0)]))) }

theorem good_call_coded(): refused(good_call_r(), sigs()) = None { refl }

// A word primitive on a list.
fn ill_word_r() → Func { Func(pick_r().sig, seq([Op(PAdd, Arg(0), Arg(1))], Ret([Loc(0)]))) }

theorem ill_word_refused(): refused(ill_word_r(), sigs()) = Some(WCodes) { refl }

// Its junk meaning: a list is not a word, so the sum is `0 + i`.
theorem ill_word_junk(xs: List<Nat>, i: Nat): ill_word_r().then(Nat, tys(), strs(), λ _ _ => Nil, 0, [nats(xs), nat(i)], as_nat) = 0 + i { refl }

// ---------------------------------------------------------------------------
// A written parameter: `fn bump(x: &mut Nat) { x := x + 1 }`. Its `Ret`
// lists no results, then `x` at the end; safety's written clause reads the
// argument's block after against that value, and owes its fit.

fn bump_sig() → Sig { Sig([Param(SWord(WNat), ByWrite)], Nil) }

fn bump_r() → Func { Func(bump_sig(), seq([Lit(WNat, 1), Op(PAdd, Arg(0), Loc(0)), Write(Place(Arg(0), Nil), Loc(0))], Ret([Arg(0)]))) }

fn bump_sigs() → Nat → Sig { λ _ => bump_sig() }

theorem bump_written(): bump_sig().written() = [0] { refl }

theorem bump_coded(): refused(bump_r(), bump_sigs()) = None { refl }

// The control: a `Ret` that leaves out the written parameter is refused.
theorem bump_unreturned_refused(): refused(Func(bump_sig(), Ret(Nil)), bump_sigs()) = Some(WCodes) { refl }

fn bump(x: &mut Nat) → True {
    x := x + 1;
    trivial
}

// The source's `Mutated(x, trivial)` read back: no results, then `x` after.
theorem bump_means(x: Nat): bump_r().then(Mutated<Nat, True>, tys(), strs(), λ _ _ => Nil, 0, [nat(x)], λ rs => Mutated(as_nat(rs), trivial)) = bump(x) { refl }

fn arg0() → Value(tys()) { Refer(Ref(0, Nil)) }

// The clause at a run whose answer's slot is the argument: the slot is the
// argument itself, and the meaning's `x + 1` fits `x`; what the slot reads
// is `ReadAll`'s.
theorem bump_written_clause(x: Nat):
    Value::Written(tys(), strs(), [arg0()], [nat(x)], bump_sig().written(), [arg0()], bump_r().denote(tys(), strs(), λ _ _ => Nil, 0, [nat(x)]).drop(0))
    = ((arg0() = arg0()) ∧ Dyn::Fits(tys(), strs(), nat(x), nat(x + 1)) ∧ True)
{ refl }

// ---------------------------------------------------------------------------
// A returned view: `fn at(xs: &[Nat], i: u64) → &Nat { &xs[i] }`, its
// result the first parameter's reference narrowed by `[i]` at the call's
// words. The index is selected at the word itself.

fn at_sig() → Sig { Sig([Param(SNamed(0), ByRead), Param(SWord(WBits(64)), ByTake)], [Result(SWord(WNat), OView(0, [SElem(Var(1))]))]) }

theorem view_clause(xs: List<Nat>, i: u64, b: Nat, out: Value(tys())):
    Value::Views(tys(), strs(), 1, [Refer(Ref(b, Nil)), Plain(Dyn(SWord(WBits(64)), i))], Dyn::ixs(tys(), [nats(xs), Dyn(SWord(WBits(64)), i)]), at_sig().results, [out])
    = ((out = Refer(Ref(b, [OnSeq(SeqOne(IWord(64, i)))]))) ∧ True)
{ refl }

// The control: a view of a parameter passed by value owes `False`.
theorem view_of_plain(xs: List<Nat>, i: u64, out: Value(tys())):
    Value::Views(tys(), strs(), 1, [Plain(nats(xs)), Plain(Dyn(SWord(WBits(64)), i))], Dyn::ixs(tys(), [nats(xs), Dyn(SWord(WBits(64)), i)]), at_sig().results, [out]) = (False ∧ True)
{ refl }

// Pins of the body's meaning (lib/lang/ownership/body.hthr,
// issues/ownership-interfaces.md): each a real source function against the
// meaning of its reflected body, by `refl` unless it says otherwise, with a
// refused control.
//
// A function of `(ps, i)` sees `ps` as `Arg(0)` and `i` as `Arg(1)`; its
// locals are `Loc(j)`, newest first. An atom reads the arguments' words,
// then the locals': `Var(1)` is `i`, `Var(2)` the newest local.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import sequences;
import body;
import int;
import loop;

// ---------------------------------------------------------------------------
// The environment: a record, a list of it, a list of numbers

record Point { x: Nat, y: Nat }

fn Point::origin() → Point { Point(0, 0) }

fn tys() → Nat → Type { λ k => match k { Zero => Point, Succ(k1) => match k1 { Zero => List<Point>, Succ(k2) => match k2 { Zero => List<Nat>, Succ(_) => True } } } }

fn pt_s() → Shape { SNamed(0) }

fn pts_s() → Shape { SNamed(1) }

fn nats_s() → Shape { SNamed(2) }

fn nat_s() → Shape { SWord(WNat) }

fn Point::fx() → Field(tys(), Point) { Field(nat_s(), λ (p: Point) => p.x, λ (p: Point) => λ (v: Nat) => Point(v, p.y)) }

fn Point::fy() → Field(tys(), Point) { Field(nat_s(), λ (p: Point) => p.y, λ (p: Point) => λ (v: Nat) => Point(p.x, v)) }

fn strs() → Strs(tys()) {
    λ k => match k {
        Zero => Struct(Plain, Some(Point::origin()), Record([Point::fx(), Point::fy()])),
        Succ(k1) => match k1 {
            Zero => Struct(Object, None, Sequence(Seq::list(tys(), pt_s(), Point::origin(), Some(Seq::list_win(tys(), pt_s(), pts_s(), λ (l: List<Point>) => l, λ (l: List<Point>) => l))))),
            Succ(k2) => match k2 {
                Zero => Struct(Object, None, Sequence(Seq::list(tys(), nat_s(), 0, Some(Seq::list_win(tys(), nat_s(), nats_s(), λ (l: List<Nat>) => l, λ (l: List<Nat>) => l))))),
                Succ(_) => Struct(Plain, None, Opaque),
            },
        },
    }
}

fn pts(ps: List<Point>) → Dyn(tys()) { Dyn(pts_s(), ps) }

fn nat(n: Nat) → Dyn(tys()) { Dyn(nat_s(), n) }

// The callees: 0 is `gap`, 1 is `List::len` of points, 2 is `total`; an
// ill-coded argument list answers nothing.
fn gap(p: Point, ok: p.y <= p.x) → Nat { p.x - p.y }

fn total(qs: List<Point>) → Nat { match qs { Nil => 0, Cons(q, r) => q.x + total(r) } }

fn first(ds: List<Dyn(tys())>) → Dyn(tys()) { ds.nth(0).unwrap_or(Dyn::none(tys())) }

fn world() → Callees(tys()) {
    λ g ds => match g {
        Zero => match Dyn::get(tys(), pt_s(), first(ds)) { Some(p) => [nat(p.x - p.y)], None => Nil },
        Succ(g1) => match g1 {
            Zero => match Dyn::get(tys(), pts_s(), first(ds)) { Some(qs) => [nat(qs.len())], None => Nil },
            Succ(_) => match Dyn::get(tys(), pts_s(), first(ds)) { Some(qs) => [nat(total(qs))], None => Nil },
        },
    }
}

fn run(f: Func, args: List<Dyn(tys())>) → List<Dyn(tys())> { f.denote(tys(), strs(), world(), 99, args) }

fn sig0() → Sig { Sig(Nil, Nil) }

fn x_of(r: Var, i: Atom) → Place { Place(r, [SElem(i), SField(0)]) }

fn y_of(r: Var, i: Atom) → Place { Place(r, [SElem(i), SField(1)]) }

// ---------------------------------------------------------------------------
// 1. `ps[i].x`

fn get_x(ps: List<Point>, i: Nat) → Nat { ps.nth(i).unwrap_or(Point::origin()).x }

fn get_x_r() → Func { Func(sig0(), seq([Read(x_of(Arg(0), Var(1)))], Ret([Loc(0)]))) }

theorem get_x_pin(ps: List<Point>, i: Nat): run(get_x_r(), [pts(ps), nat(i)]) = [nat(get_x(ps, i))] { refl }

// expect-error(kernel)
theorem get_x_not_y(ps: List<Point>, i: Nat): run(get_x_r(), [pts(ps), nat(i)]) = [nat(ps.nth(i).unwrap_or(Point::origin()).y)] { refl }

// ---------------------------------------------------------------------------
// 2. `ps[i].x := v`, the update spelled through the list's own accessor

fn set_x(ps: List<Point>, i, v: Nat) → List<Point> { ps.update(i, λ _ => Point(v, ps.nth(i).unwrap_or(Point::origin()).y)) }

fn set_x_r() → Func { Func(sig0(), seq([Write(x_of(Arg(0), Var(1)), Arg(2))], Ret([Arg(0)]))) }

theorem set_x_pin(ps: List<Point>, i, v: Nat): run(set_x_r(), [pts(ps), nat(i), nat(v)]) = [pts(set_x(ps, i, v))] { refl }

// expect-error(kernel)
theorem set_x_not_y(ps: List<Point>, i, v: Nat): run(set_x_r(), [pts(ps), nat(i), nat(v)]) = [pts(ps.update(i, λ _ => Point(ps.nth(i).unwrap_or(Point::origin()).x, v)))] { refl }

// ---------------------------------------------------------------------------
// 3. A generic function at an open `T`: the element's pad is a field of
//    the parameter's opaque structure, quantified in the pin's statement;
//    the function takes no `T`.

fn t_tys(T: Type) → Nat → Type { λ k => match k { Zero => T, Succ(k1) => match k1 { Zero => List<T>, Succ(_) => True } } }

fn t_strs(T: Type, d: T) → Strs(t_tys(T)) {
    λ k => match k {
        Zero => Struct(Plain, Some(d), Opaque),
        Succ(k1) => match k1 { Zero => Struct(Object, None, Sequence(Seq::list(t_tys(T), SNamed(0), d, None))), Succ(_) => Struct(Plain, None, Opaque) },
    }
}

fn t_run(T: Type, d: T, f: Func, args: List<Dyn(t_tys(T))>) → List<Dyn(t_tys(T))> { f.denote(t_tys(T), t_strs(T, d), λ _ _ => Nil, 99, args) }

// `xs[i] := xs[j]`, then `xs[i]`.
fn copy_elem<T>(xs: List<T>, i, j: Nat, d: T) → List<T> { xs.update(i, λ _ => xs.nth(j).unwrap_or(d)) }

fn copy_elem_r() → Func {
    Func(sig0(), seq([Read(Place(Arg(0), [SElem(Var(2))])), Write(Place(Arg(0), [SElem(Var(1))]), Loc(0)), Read(Place(Arg(0), [SElem(Var(1))]))], Ret([Arg(0), Loc(0)])))
}

theorem copy_elem_pin<T>(xs: List<T>, i, j: Nat): (d: T) →
    t_run(T, d, copy_elem_r(), [Dyn(SNamed(1), xs), Dyn(SWord(WNat), i), Dyn(SWord(WNat), j)])
        = [Dyn(SNamed(1), copy_elem(xs, i, j, d)), Dyn(SNamed(0), copy_elem(xs, i, j, d).nth(i).unwrap_or(d))]
{ λ d => refl }

// A write of a second object that reads nothing at `T` pins at every pad.
fn put_elem<T>(xs: List<T>, i: Nat, x: T) → List<T> { xs.update(i, λ _ => x) }

fn put_elem_r() → Func { Func(sig0(), seq([Write(Place(Arg(0), [SElem(Var(1))]), Arg(2))], Ret([Arg(0)]))) }

theorem put_elem_pin<T>(xs: List<T>, i: Nat, x: T): (d: T) →
    t_run(T, d, put_elem_r(), [Dyn(SNamed(1), xs), Dyn(SWord(WNat), i), Dyn(SNamed(0), x)]) = [Dyn(SNamed(1), put_elem(xs, i, x))]
{ λ d => refl }

// A read through the proof-consuming accessor, as generic library code
// writes it once: one library lemma per site.
theorem List::nil_not_below<A>(i: Nat, inside: i < List::len(Nil<A>)): False { omega(inside) }

theorem List::below_tail<A>(h: A, t: List<A>, k: Nat, inside: Succ(k) < List::len(Cons(h, t))): k < t.len() { omega(inside) }

fn List::at_below<A>(self xs: List<A>) → (i: Nat) → i < xs.len() → A {
    match xs {
        Nil => λ i inside => false_elim(List::nil_not_below<A>(i, inside)),
        Cons(h, t) => λ i => match i { Zero => λ _ => h, Succ(k) => λ inside => t.at_below(k, List::below_tail(h, t, k, inside)) },
    }
}

theorem List::at_below_total<A>(self xs: List<A>): (i: Nat) → (inside: i < xs.len()) → (d: A) → xs.at_below(i, inside) = xs.nth(i).unwrap_or(d) {
    match xs {
        Nil => λ i inside d => false_elim(List::nil_not_below<A>(i, inside)),
        Cons(h, t) => λ i => match i { Zero => λ _ _ => refl, Succ(k) => λ inside d => t.at_below_total(k, List::below_tail(h, t, k, inside), d) },
    }
}

fn copy_below<T>(xs: List<T>, i, j: Nat, inside: j < xs.len()) → List<T> { xs.update(i, λ _ => xs.at_below(j, inside)) }

fn copy_only_r() → Func { Func(sig0(), seq([Read(Place(Arg(0), [SElem(Var(2))])), Write(Place(Arg(0), [SElem(Var(1))]), Loc(0))], Ret([Arg(0)]))) }

// expect-error(kernel)
theorem copy_below_refl<T>(xs: List<T>, i, j: Nat, inside: j < xs.len(), d: T):
    t_run(T, d, copy_only_r(), [Dyn(SNamed(1), xs), Dyn(SWord(WNat), i), Dyn(SWord(WNat), j)]) = [Dyn(SNamed(1), copy_below(xs, i, j, inside))]
{ refl }

theorem copy_below_pin<T>(xs: List<T>, i, j: Nat, inside: j < xs.len()): (d: T) →
    t_run(T, d, copy_only_r(), [Dyn(SNamed(1), xs), Dyn(SWord(WNat), i), Dyn(SWord(WNat), j)]) = [Dyn(SNamed(1), copy_below(xs, i, j, inside))]
{
    λ d => cong_fn(λ (y: T) => [Dyn(SNamed(1), xs.update(i, λ _ => y))], sym(xs.at_below_total(j, inside, d)))
}

// ---------------------------------------------------------------------------
// 4. `if h: i < ps.len()` guarding a read, ending the body: its two arms
//    yield the answer, the join is one convoy at `Nat`, and the whole
//    answer pins.

fn guarded(ps: List<Point>, i: Nat) → Nat { if h: i < ps.len() { get_x(ps, i) } else { 0 } }

fn guarded_r() → Func {
    Func(sig0(), seq([Call(1, [Arg(0)], 1)], Join(TLt(Arg(1), Loc(0)), seq([Read(x_of(Arg(0), Var(1)))], Yield([Loc(0)])), seq([Lit(WNat, 0)], Yield([Loc(0)])), Ret([Loc(0)]))))
}

theorem guarded_whole(ps: List<Point>, i: Nat): run(guarded_r(), [pts(ps), nat(i)]) = [nat(guarded(ps, i))] { refl }

fn guarded_y(ps: List<Point>, i: Nat) → Nat { if h: i < ps.len() { ps.nth(i).unwrap_or(Point::origin()).y } else { 0 } }

// expect-error(kernel)
theorem guarded_not_y(ps: List<Point>, i: Nat): run(guarded_r(), [pts(ps), nat(i)]) = [nat(guarded_y(ps, i))] { refl }

// ---------------------------------------------------------------------------
// 5. Calls: one passing a record, one passing a window of a list

fn call_gap(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x) → Nat {
    gap(ps.nth(i).unwrap_or(Point::origin()), ok)
}

fn call_gap_r() → Func { Func(sig0(), seq([Read(Place(Arg(0), [SElem(Var(1))])), Call(0, [Loc(0)], 1)], Ret([Loc(0)]))) }

theorem call_gap_pin(ps: List<Point>, i: Nat, ok: ps.nth(i).unwrap_or(Point::origin()).y <= ps.nth(i).unwrap_or(Point::origin()).x):
    run(call_gap_r(), [pts(ps), nat(i)]) = [nat(call_gap(ps, i, ok))]
{ refl }

// An ill-coded call (a list where `gap` takes a point) answers nothing, and
// its binder binds the word zero.
fn call_ill_r() → Func { Func(sig0(), seq([Call(0, [Arg(0)], 1)], Ret([Loc(0)]))) }

theorem call_ill_junk(ps: List<Point>, i: Nat): run(call_ill_r(), [pts(ps), nat(i)]) = [nat(0)] { refl }

fn call_total(ps: List<Point>, lo, n: Nat) → Nat { total(ps.drop(lo).take(n)) }

fn call_total_r() → Func { Func(sig0(), seq([View(Place(Arg(0), [SWindow(Var(1), Var(2))]), Reading), Call(2, [Loc(0)], 1)], Ret([Loc(0)]))) }

theorem call_total_pin(ps: List<Point>, lo, n: Nat): run(call_total_r(), [pts(ps), nat(lo), nat(n)]) = [nat(call_total(ps, lo, n))] { refl }

// ---------------------------------------------------------------------------
// 6. A function that continues after its `if`: the join binds its output
//    once, and what follows reads it.

fn after_join(ps: List<Point>, i: Nat) → Nat {
    let a = if h: i < ps.len() { get_x(ps, i) } else { 0 };
    ps.nth(a).unwrap_or(Point::origin()).y
}

// After the join its output is `Loc(0)`, which an atom reads as `Var(2)`.
fn after_join_r() → Func {
    Func(sig0(), seq([Call(1, [Arg(0)], 1)], Join(TLt(Arg(1), Loc(0)), seq([Read(x_of(Arg(0), Var(1)))], Yield([Loc(0)])), seq([Lit(WNat, 0)], Yield([Loc(0)])),
        seq([Read(y_of(Arg(0), Var(2)))], Ret([Loc(0)])))))
}

theorem after_join_pin(ps: List<Point>, i: Nat): run(after_join_r(), [pts(ps), nat(i)]) = [nat(after_join(ps, i))] { refl }

fn after_join_x(ps: List<Point>, i: Nat) → Nat {
    let a = if h: i < ps.len() { get_x(ps, i) } else { 0 };
    ps.nth(a).unwrap_or(Point::origin()).x
}

// expect-error(kernel)
theorem after_join_not_x(ps: List<Point>, i: Nat): run(after_join_r(), [pts(ps), nat(i)]) = [nat(after_join_x(ps, i))] { refl }

// ---------------------------------------------------------------------------
// 7. A join assigning two variables, one an object an arm writes, then a
//    use of both (§21.5 probe 3). The surface packs the arms' values as
//    `Mutated(qs, k)` in one convoy and reads both out of it once.

fn join_two(ps: List<Point>, i, n: Nat) → Nat {
    let mut qs = ps;
    let mut k = n;
    if h: i < n {
        qs := qs.update(i, λ _ => Point(k, qs.nth(i).unwrap_or(Point::origin()).y));
        k := k + 1;
    } else {
        k := 0;
    }
    qs.nth(k).unwrap_or(Point::origin()).x + k
}

// After the join, `k` is `Loc(0)` (an atom's `Var(3)`) and `qs` `Loc(1)`.
fn join_two_r() → Func {
    Func(sig0(), Join(TLt(Arg(1), Arg(2)),
        seq([Write(x_of(Arg(0), Var(1)), Arg(2)), Lit(WNat, 1), Op(PAdd, Arg(2), Loc(0))], Yield([Arg(0), Loc(0)])),
        seq([Lit(WNat, 0)], Yield([Arg(0), Loc(0)])),
        seq([Read(x_of(Loc(1), Var(3))), Op(PAdd, Loc(0), Loc(1))], Ret([Loc(0)]))))
}

theorem join_two_pin(ps: List<Point>, i, n: Nat): run(join_two_r(), [pts(ps), nat(i), nat(n)]) = [nat(join_two(ps, i, n))] { refl }

fn join_two_y(ps: List<Point>, i, n: Nat) → Nat {
    let mut qs = ps;
    let mut k = n;
    if h: i < n {
        qs := qs.update(i, λ _ => Point(k, qs.nth(i).unwrap_or(Point::origin()).y));
        k := k + 1;
    } else {
        k := 0;
    }
    qs.nth(k).unwrap_or(Point::origin()).y + k
}

// expect-error(kernel)
theorem join_two_not_y(ps: List<Point>, i, n: Nat): run(join_two_r(), [pts(ps), nat(i), nat(n)]) = [nat(join_two_y(ps, i, n))] { refl }

// An arm yielding other codes than the yes arm has a junk meaning, which is
// this: the no arm's list cast to the yes arm's number falls back to the
// yes arm's value, and a field of a number reads the word zero. The check
// refuses the function (interfaces_tests.hthr).
fn join_ill_coded_r() → Func {
    Func(sig0(), Join(TLt(Arg(1), Arg(2)), Yield([Arg(1), Arg(2)]), Yield([Arg(0), Arg(2)]), seq([Read(x_of(Loc(1), Var(3))), Op(PAdd, Loc(0), Loc(1))], Ret([Loc(0)]))))
}

theorem join_ill_coded_junk(ps: List<Point>, i, n: Nat): run(join_ill_coded_r(), [pts(ps), nat(i), nat(n)]) = [nat(0 + convoy(decide_bit<(i < n)>(), Mutated(i, n), Mutated(i, n)).value)] { refl }

// ---------------------------------------------------------------------------
// 8. A join one of whose arms returns on an inner path: what follows is
//    bound once and each `Yield` calls it; the surface copies it into the
//    arms that fall through, the same term after β. Its convoy is over the
//    answer, so this function pins through its word, read inside the
//    continuation.

fn early(i, n, m: Nat) → Nat {
    let mut x = i;
    if h: i < n {
        if h2: n < m { return 0; }
        x := x + 1;
    } else {
        x := 2;
    }
    x + n
}

fn early_r() → Func {
    Func(sig0(), Join(TLt(Arg(0), Arg(1)),
        Join(TLt(Arg(1), Arg(2)), seq([Lit(WNat, 0)], Ret([Loc(0)])), Yield(Nil), seq([Lit(WNat, 1), Op(PAdd, Arg(0), Loc(0))], Yield([Loc(0)]))),
        seq([Lit(WNat, 2)], Yield([Loc(0)])),
        seq([Op(PAdd, Loc(0), Arg(1))], Ret([Loc(0)]))))
}

fn word(f: Func, args: List<Dyn(tys())>) → Nat {
    f.body.mean(Nat, tys(), strs(), world(), 99, Env::start(tys(), args), λ rs => Dyn::index(tys(), first(rs)), λ _ => 0)
}

theorem early_pin(i, n, m: Nat): word(early_r(), [nat(i), nat(n), nat(m)]) = early(i, n, m) { refl }

// The whole answer does not pin: the meaning's convoy is over the answer.
// expect-error(kernel)
theorem early_whole(i, n, m: Nat): run(early_r(), [nat(i), nat(n), nat(m)]) = [nat(early(i, n, m))] { refl }

fn early_off(i, n, m: Nat) → Nat {
    let mut x = i;
    if h: i < n {
        if h2: n < m { return 1; }
        x := x + 1;
    } else {
        x := 2;
    }
    x + n
}

// expect-error(kernel)
theorem early_not_off(i, n, m: Nat): word(early_r(), [nat(i), nat(n), nat(m)]) = early_off(i, n, m) { refl }

// ---------------------------------------------------------------------------
// 9. A `while` with `decreases`: the surface's `Loop(measure, step)` over
//    the state, run from the locals. Its body is a function whose own call
//    ends the round (`Jump`); the world holds the loop itself, and the pin
//    is the loop's one equation (`Loop::run_unfold`), then the step's two
//    ways (`dconvoy_map`), each `refl`.

fn drain(n: Nat) → Nat {
    let mut i = n;
    while 1 <= i decreases i { i := i - 1 }
    i
}

fn drain_loop() → Loop<drain::State, drain::State> { Loop<drain::State, drain::State>(measure := λ (s: drain::State) => s.i, step := drain::step) }

theorem drain_is_loop(n: Nat): drain(n) = drain_loop().run(drain::State(n)).i { refl }

// The loop's body at `(i)`: the test `1 <= i`, then round again at `i - 1`
// or answer `i`.
fn drain_r() → Func {
    Func(sig0(), seq([Lit(WNat, 1)], Join(TLe(Loc(0), Arg(0)), seq([Op(PSub, Arg(0), Loc(0))], Jump([Loc(0)])), Ret([Arg(0)]), Ret(Nil))))
}

// The world: callee 0 is the loop.
fn loop_world() → Callees(tys()) {
    λ g ds => match g { Zero => match Dyn::get(tys(), nat_s(), first(ds)) { Some(i) => [nat(drain_loop().run(drain::State(i)).i)], None => Nil }, Succ(_) => Nil }
}

fn one(d: Dyn(tys())) → List<Dyn(tys())> { [d] }

// The meaning, evaluated: a convoy over the test.
fn drain_r_val(i: Nat) → List<Dyn(tys())> { convoy(decide_bit<(1 <= i)>(), [nat(drain_loop().run(drain::State(i - 1)).i)], [nat(i)]) }

theorem drain_r_eval(i: Nat): drain_r().denote(tys(), strs(), loop_world(), 0, [nat(i)]) = drain_r_val(i) { refl }

// The step, as the surface builds it: the test's convoy, round again at
// `i - 1` below the measure, or leave.
fn drain_lower(i: Nat, h: decide_bit<(1 <= i)>() = True) → Lower<drain::State>(λ (s: drain::State) => s.i, drain::State(i)) {
    let le: (1 <= i) = decide_true<(1 <= i)>(h);
    let lt: (i - 1 < i) = omega(le);
    Lower(next := drain::State(i - 1), less := squash(lt))
}

theorem drain_step_is(i: Nat): drain::step(drain::State(i)) = dconvoy(decide_bit<(1 <= i)>(), λ h => Again(drain_lower(i, h)), λ _ => Done(drain::State(i))) { refl }

// The step's two ways: round again, or answer.
theorem drain_step_split(i: Nat):
    [nat((match drain::step(drain::State(i)) { Again(b) => drain_loop().run(b.next), Done(r) => r }).i)] = drain_r_val(i)
{
    dconvoy_map<Pass<drain::State, drain::State>(λ (s: drain::State) => s.i, drain::State(i)), List<Dyn(tys())>>(decide_bit<(1 <= i)>(),
        λ h => Again(drain_lower(i, h)), λ _ => Done(drain::State(i)), λ _ => [nat(drain_loop().run(drain::State(i - 1)).i)], λ _ => [nat(i)],
        λ (p: Pass<drain::State, drain::State>(λ (s: drain::State) => s.i, drain::State(i))) => [nat((match p { Again(b) => drain_loop().run(b.next), Done(r) => r }).i)],
        λ e => refl, λ e => refl)
}

theorem drain_loop_pin(i: Nat): loop_world()(0, [nat(i)]) = drain_r().denote(tys(), strs(), loop_world(), 0, [nat(i)]) {
    let unfolded: (one(nat(drain_loop().run(drain::State(i)).i)) = one(nat((match drain::step(drain::State(i)) { Again(b) => drain_loop().run(b.next), Done(r) => r }).i))) =
        cong_fn(λ (s: drain::State) => one(nat(s.i)), drain_loop().run_unfold(drain::State(i)));
    trans(unfolded, trans(drain_step_split(i), sym(drain_r_eval(i))))
}

// The function that runs it, by `refl` given the world.
fn drain_outer_r() → Func { Func(sig0(), seq([Call(0, [Arg(0)], 1)], Ret([Loc(0)]))) }

theorem drain_outer_pin(n: Nat): drain_outer_r().denote(tys(), strs(), loop_world(), 9, [nat(n)]) = [nat(drain(n))] { refl }

// ---------------------------------------------------------------------------
// 10. A `for`: the fold of its named step. The step is a function pinned by
//     `refl`; the loop is the library's fold of the step's meaning, and the
//     source's fold of its own step is that by `List::foldl_same`.

fn sum(xs: List<Nat>) → Nat {
    let mut s = 0;
    for x in xs { s := s + x }
    s
}

theorem sum_is_fold(xs: List<Nat>): sum(xs) = xs.foldl(sum::step, 0) { refl }

fn sum_step_r() → Func { Func(sig0(), seq([Op(PAdd, Arg(0), Arg(1))], Ret([Loc(0)]))) }

fn sum_step_m(s, x: Nat) → Nat { Dyn::index(tys(), first(sum_step_r().denote(tys(), strs(), world(), 9, [nat(s), nat(x)]))) }

theorem sum_step_pin(s, x: Nat): sum::step(s, x) = sum_step_m(s, x) { refl }

theorem sum_pin(xs: List<Nat>): sum(xs) = xs.foldl(sum_step_m, 0) { xs.foldl_same(sum::step, sum_step_m, sum_step_pin, 0) }

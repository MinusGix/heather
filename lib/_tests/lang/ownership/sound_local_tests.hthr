// ---------------------------------------------------------------------------
// Negative controls: each group's decider fails where its clause is weakened
// or the state is broken, at some state of a trace above.

fn trace_with(fs: List<Func>, g: Nat, f: Tri(tys()) → Bool, vs: List<Value(tys())>, ds: List<Dyn(tys())>, h: Heap(tys())) → Bool {
    (((fns_of(fs)(g)).trace_with(tys(), cx_of(fs, g, vs, h), f, vs, ds, h, io0())).log).all_bit(λ b => b)
}

fn on_loan_ref(f: Tri(tys()) → Bool) → Bool { trace_with([loan()], 0, f, [obj0(), w(1), w(3)], loan_args(), heap_ns()) }

fn on_loan_copy(f: Tri(tys()) → Bool) → Bool { trace_with([loan()], 0, f, [Plain(nats(ns5())), w(1), w(3)], loan_args(), Nil) }

// Agreement as `val = d` whole, the patch's absence: false while a view to
// write through a reference is pending (its parent's value already holds
// what its meaning holds only after the write-back); true along the copies,
// where nothing is shared.
fn whole_b(t: Tri(tys())) → Bool {
    (t.s).levels().all_bit(λ l => !(t.s).live(l) || Dyn::opt_eq_b(tys(), eqn(), CSt::val_at(tys(), strs(), t.s, t.m, l), Some(CSt::mean_at(tys(), t.s, t.e, l))))
}

theorem whole_fails_ref(): on_loan_ref(whole_b) = False { refl }

theorem whole_holds_copy(): on_loan_copy(whole_b) = True { refl }

// Sync at every entry to write, written back or not: false while pending.
fn sync_all_b(t: Tri(tys())) → Bool {
    let ws = Mach::ixs(tys(), strs(), t.m);
    (t.s).views.all_bit(λ en => Dyn::eq_b(tys(), eqn(), Sel::read_at(tys(), strs(), en.place(t.s, ws), CSt::mean_at(tys(), t.s, t.e, en.par)), CSt::mean_at(tys(), t.s, t.e, en.lvl)))
}

theorem sync_all_fails(): on_loan_ref(sync_all_b) = False { refl }

// Footprints with every view to read moved onto the view to write's place:
// the loan's window and `t`'s then meet.
fn VEnt::onto(self en: VEnt, at: List<Step>, reg: List<Step>) → VEnt { VEnt(en.lvl, en.obj, reg, en.mode, en.par, at, en.back) }

fn meet_b(t: Tri(tys())) → Bool {
    let s = t.s;
    let moved = match s.views.find(λ en => en.mode.writes()) {
        Some(wv) => s.views.map(λ en => match en.mode { Reading => en.onto(wv.at, wv.reg), Writing => en }),
        None => s.views,
    };
    Foot::holds_b(tys(), strs(), CSt(s.args, s.locs, s.na, s.nd, moved, s.nobj, s.touched, s.wrote), t.m, t.root)
}

theorem meet_fails(): on_loan_ref(meet_b) = False { refl }

// Cells against roots none of which is there.
fn rootless_b(t: Tri(tys())) → Bool { Cells::holds_b(tys(), strs(), t.s, t.m, λ _ => None) }

theorem rootless_fails(): on_loan_ref(rootless_b) = False { refl }

// Agreement against a meaning whose object is another list.
fn other_b(t: Tri(tys())) → Bool { Agree::holds_b(tys(), strs(), eqn(), t.s, Env(Cons(nats([0]), (t.e).args.drop(1)), (t.e).locs), t.m) }

theorem other_fails(): on_loan_ref(other_b) = False { refl }

// Like-ness against a meaning whose object is shorter.
fn short_b(t: Tri(tys())) → Bool { Likes::holds_b(tys(), strs(), t.s, Env(Cons(nats([0]), (t.e).args.drop(1)), (t.e).locs), t.m) }

theorem short_fails(): on_loan_ref(short_b) = False { refl }

// The state with every entry's parent its own level: `chain` fails.
fn selfish_b(t: Tri(tys())) → Bool {
    let s = t.s;
    CSt(s.args, s.locs, s.na, s.nd, s.views.map(λ en => VEnt(en.lvl, en.obj, en.reg, en.mode, en.lvl, en.at, en.back)), s.nobj, s.touched, s.wrote).wf_b()
}

theorem selfish_fails(): on_loan_ref(selfish_b) = False { refl }

// The heap group against an entry heap with a block more than the run's.
fn grown_b(t: Tri(tys())) → Bool { Heaped::holds_b(tys(), strs(), eqn(), t.s, t.m, heap_ns() ++ heap_ns(), Nil, t.root) }

theorem grown_fails(): on_loan_ref(grown_b) = False { refl }

// Sync of a view to read at every entry, not one: a read view chosen by a
// join has an entry of the arm the run did not take, whose parent's meaning
// at its place is not the view's.
fn sync_every_b(t: Tri(tys())) → Bool {
    let ws = Mach::ixs(tys(), strs(), t.m);
    (t.s).views.all_bit(λ en => en.mode.writes() ||
        Dyn::eq_b(tys(), eqn(), Sel::read_at(tys(), strs(), en.place(t.s, ws), CSt::mean_at(tys(), t.s, t.e, en.par)), CSt::mean_at(tys(), t.s, t.e, en.lvl)))
}

fn on_join_read(f: Tri(tys()) → Bool, i, k: Nat) → Bool {
    trace_with([join_read()], 0, f, [obj0(), Plain(pts(ps2())), w(i), w(k)], [pts(ps2()), pts(ps2()), nat(i), nat(k)], heap_pts())
}

theorem sync_every_fails(): on_join_read(sync_every_b, 0, 1) = False { refl }

// The present invariant's `uni` (a view's cell refers iff its parent's does,
// at every entry) is false there: one parent refers, the other is a copy.
fn uni_b(t: Tri(tys())) → Bool {
    (t.s).views.all_bit(λ en => Bool::same_b(Value::refers_b(tys(), (CSt::cell_at(tys(), t.s, t.m, en.lvl)).v), Value::refers_b(tys(), (CSt::cell_at(tys(), t.s, t.m, en.par)).v)))
}

theorem uni_fails_yes(): on_join_read(uni_b, 0, 1) = False { refl }

theorem uni_fails_no(): on_join_read(uni_b, 1, 0) = False { refl }

// Two views of one copy meet where their places do: a copy's footprint is
// the level its chain of copies starts at, with the selections from there.
theorem meet_fails_copy(): on_loan_copy(meet_b) = False { refl }

// The bag's nested length is not what it was lent with: the deep shape is
// not kept by a checked write (so like-ness is the top code and length).
fn deep_b(t: Tri(tys())) → Bool {
    match Heap::obj(tys(), (t.m).heap, 0) {
        Some(ob) => Dyn::len(tys(), strs(), Sel::read_at(tys(), strs(), [OnField(1)], ob.val)).same(2),
        None => True,
    }
}

theorem deep_changes(): trace_with([bag_set()], 0, deep_b, [obj0(), Plain(bag123())], [bag12(), bag123()], [Live(Obj(bag12(), Nil))]) = False { refl }

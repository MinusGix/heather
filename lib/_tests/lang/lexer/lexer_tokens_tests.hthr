// After the last byte the loop gives `END` once, and no state asks for more:
// each stops there or refuses.
fn lexer_stops(states: List<u64>) → Bool {
    match states {
        Nil => True,
        Cons(s, rest) => (scan_step(s, END).eq_bit(DEAD) || scan_step(s, END).band(255).eq_bit(FAIL)) && lexer_stops(rest),
    }
}

theorem lexer_states_stop_at_the_end(): lexer_stops(lexer_states()) = True { refl }

// A state's kind is the one in its name: an identifier's, and a finished
// arrow's.
theorem lexer_accepts_by_state(): scan_accept(IDENT) = KIND_IDENT ∧ scan_accept(DONE_ARROW) = KIND_ARROW ∧ scan_accept(START) = 0 {
    ⟨refl, ⟨refl, refl⟩⟩
}


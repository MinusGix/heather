// FunctionIR's first typed-region slice. Regions are stored as deterministic
// topological node sequences, but their pure meaning is a conjunction of
// dependency equations over stable value IDs. The list is therefore a
// schedule used by validation and execution, not an observable ordering of
// independent computations.
//
// This is intentionally small: every value is a fixed-width bitvector and
// `Add` is the only operation. The raw-data-plus-`RegionValid` boundary is the
// hybrid representation that later operation families and nested regions can
// grow from without inheriting `ir_v1`'s constructor-tree value model.

import bitvec;
import list;
import logic;
import nat;
import option;

// Stable IDs are Nats in the first representation. A port records the type
// independently of its uses, so validation—not the raw node constructor—pins
// operand references to definitions of the required width.
record Port { id: Nat, width: Nat }

// A region's port environment has a dedicated carrier even though its first
// representation is a list. Clients use this API rather than depending on the
// storage choice or confusing an environment with an arbitrary list of IDs.
record Ports { entries: List<Port> }

fn empty_ports() → Ports { Ports([]) }

fn push_port(port: Port, ports: Ports) → Ports {
    Ports(Cons(port, ports.entries))
}

// Operation-specific fields keep raw construction simple while making the
// operation's input and output arities explicit. Shift counts are immediate
// mathematical Nats at this layer; target masking is a lowering concern.
// Comparisons consume `width`-bit operands and produce a one-bit BitVec.
inductive Node {
    Const(width: Nat, output: Nat, value: Nat),
    Add(width: Nat, output: Nat, left: Nat, right: Nat),
    Sub(width: Nat, output: Nat, left: Nat, right: Nat),
    BitAnd(width: Nat, output: Nat, left: Nat, right: Nat),
    BitOr(width: Nat, output: Nat, left: Nat, right: Nat),
    BitXor(width: Nat, output: Nat, left: Nat, right: Nat),
    ShiftLeft(width: Nat, output: Nat, value: Nat, amount: Nat),
    LogicalShiftRight(width: Nat, output: Nat, value: Nat, amount: Nat),
    ArithmeticShiftRight(width: Nat, output: Nat, value: Nat, amount: Nat),
    UnsignedLessThan(width: Nat, output: Nat, left: Nat, right: Nat),
    SignedLessThan(width: Nat, output: Nat, left: Nat, right: Nat),
}

record Region {
    inputs: Ports,
    nodes: List<Node>,
    outputs: Ports,
}

fn node_output(node: Node) → Port {
    match node {
        Const(width, output, _) => Port(output, width),
        Add(width, output, _, _) => Port(output, width),
        Sub(width, output, _, _) => Port(output, width),
        BitAnd(width, output, _, _) => Port(output, width),
        BitOr(width, output, _, _) => Port(output, width),
        BitXor(width, output, _, _) => Port(output, width),
        ShiftLeft(width, output, _, _) => Port(output, width),
        LogicalShiftRight(width, output, _, _) => Port(output, width),
        ArithmeticShiftRight(width, output, _, _) => Port(output, width),
        UnsignedLessThan(_, output, _, _) => Port(output, 1),
        SignedLessThan(_, output, _, _) => Port(output, 1),
    }
}

// ---------------------------------------------------------------------------
// Compact validity environment

// A balanced directory separates stable graph identity from schedule
// availability. It records each port's width and unique origin; ranks say when
// a node-produced value becomes available. The directory cardinality and
// exact input/output origins rule out duplicate or phantom definitions.

inductive PortOrigin { InputAt(index: Nat), NodeAt(index: Nat) }

record DirectoryPort { port: Port, origin: PortOrigin }

inductive PortDirectory {
    DirectoryEmpty,
    DirectoryBranch(
        left: PortDirectory,
        entry: DirectoryPort,
        right: PortDirectory),
}

fn DirectoryAbove(lower: Option<Nat>, id: Nat) → Type {
    match lower { None => True, Some(bound) => bound < id }
}

fn DirectoryBelow(upper: Option<Nat>, id: Nat) → Type {
    match upper { None => True, Some(bound) => id < bound }
}

// Bounds are threaded down the tree, so ordering evidence is linear in the
// directory size rather than restating every descendant comparison at every
// branch.
fn DirectoryWithin(directory: PortDirectory) →
    Option<Nat> → Option<Nat> → Type
{
    match directory {
        DirectoryEmpty => λ _ _ => True,
        DirectoryBranch(left, entry, right) => λ lower upper =>
            DirectoryAbove(lower, entry.port.id) ∧
            (DirectoryBelow(upper, entry.port.id) ∧
             (DirectoryWithin(left, lower, Some(entry.port.id)) ∧
              DirectoryWithin(right, Some(entry.port.id), upper))),
    }
}

fn DirectoryOrdered(directory: PortDirectory) → Type {
    DirectoryWithin(directory, None, None)
}

theorem directory_within_empty(lower, upper: Option<Nat>):
    DirectoryWithin(DirectoryEmpty, lower, upper)
{
    trivial
}

theorem directory_within_branch(
    {left, right: PortDirectory}, {entry: DirectoryPort},
    {lower, upper: Option<Nat>},
    above: DirectoryAbove(lower, entry.port.id),
    below: DirectoryBelow(upper, entry.port.id),
    left_within: DirectoryWithin(left, lower, Some(entry.port.id)),
    right_within: DirectoryWithin(right, Some(entry.port.id), upper)):
    DirectoryWithin(DirectoryBranch(left, entry, right), lower, upper)
{
    ⟨above, ⟨below, ⟨left_within, right_within⟩⟩⟩
}

fn directory_count(directory: PortDirectory) → Nat {
    match directory {
        DirectoryEmpty => 0,
        DirectoryBranch(left, _, right) =>
            Succ(directory_count(left) + directory_count(right)),
    }
}

fn HasDirectoryPortAt(directory: PortDirectory, id, width: Nat,
    origin: PortOrigin) → Type
{
    match directory {
        DirectoryEmpty => False,
        DirectoryBranch(left, entry, right) =>
            (entry.port.id = id ∧
             (entry.port.width = width ∧ entry.origin = origin)) ∨
            (HasDirectoryPortAt(left, id, width, origin) ∨
             HasDirectoryPortAt(right, id, width, origin)),
    }
}

theorem directory_has_here(
    {left, right: PortDirectory}, {entry: DirectoryPort}):
    HasDirectoryPortAt(DirectoryBranch(left, entry, right),
        entry.port.id, entry.port.width, entry.origin)
{
    ⟨⟨refl, ⟨refl, refl⟩⟩ |⟩
}

theorem directory_has_left(
    {left, right: PortDirectory}, {entry: DirectoryPort},
    {id, width: Nat}, {origin: PortOrigin},
    found: HasDirectoryPortAt(left, id, width, origin)):
    HasDirectoryPortAt(DirectoryBranch(left, entry, right),
        id, width, origin)
{
    ⟨| ⟨found |⟩⟩
}

theorem directory_has_right(
    {left, right: PortDirectory}, {entry: DirectoryPort},
    {id, width: Nat}, {origin: PortOrigin},
    found: HasDirectoryPortAt(right, id, width, origin)):
    HasDirectoryPortAt(DirectoryBranch(left, entry, right),
        id, width, origin)
{
    ⟨| ⟨| found⟩⟩
}

fn HasDirectoryPort(directory: PortDirectory, id, width: Nat) → Type {
    Exists<PortOrigin>(λ origin =>
        HasDirectoryPortAt(directory, id, width, origin))
}

fn OriginAvailableBefore(origin: PortOrigin, before: Nat) → Type {
    match origin { InputAt(_) => True, NodeAt(index) => index < before }
}

fn HasAvailableDirectoryPort(directory: PortDirectory,
    id, width, before: Nat) → Type
{
    Exists<PortOrigin>(λ origin =>
        HasDirectoryPortAt(directory, id, width, origin) ∧
        OriginAvailableBefore(origin, before))
}

theorem available_input(
    {directory: PortDirectory}, {id, width: Nat}, index, before: Nat,
    found: HasDirectoryPortAt(directory, id, width, InputAt(index))):
    HasAvailableDirectoryPort(directory, id, width, before)
{
    Exists(InputAt(index), ⟨found, trivial⟩)
}

theorem available_node(
    {directory: PortDirectory}, {id, width: Nat}, index, before: Nat,
    found: HasDirectoryPortAt(directory, id, width, NodeAt(index)),
    earlier: index < before):
    HasAvailableDirectoryPort(directory, id, width, before)
{
    Exists(NodeAt(index), ⟨found, earlier⟩)
}

theorem directory_port_exists(
    {directory: PortDirectory}, {id, width: Nat}, {origin: PortOrigin},
    found: HasDirectoryPortAt(directory, id, width, origin)):
    HasDirectoryPort(directory, id, width)
{
    Exists(origin, found)
}

fn InputEntriesIndexed(directory: PortDirectory,
    entries: List<Port>) → Nat → Type
{
    match entries {
        Nil => λ _ => True,
        Cons(port, rest) => λ index =>
            HasDirectoryPortAt(directory, port.id, port.width,
                InputAt(index)) ∧
            InputEntriesIndexed(directory, rest, Succ(index)),
    }
}

fn InputsIndexed(directory: PortDirectory, inputs: Ports) → Type {
    InputEntriesIndexed(directory, inputs.entries, 0)
}

theorem input_entries_indexed_nil(
    {directory: PortDirectory}, {index: Nat}):
    InputEntriesIndexed(directory, Nil, index)
{
    trivial
}

theorem input_entries_indexed_cons(
    {directory: PortDirectory}, {index: Nat},
    {port: Port}, {rest: List<Port>},
    found: HasDirectoryPortAt(directory, port.id, port.width,
        InputAt(index)),
    tail: InputEntriesIndexed(directory, rest, Succ(index))):
    InputEntriesIndexed(directory, Cons(port, rest), index)
{
    ⟨found, tail⟩
}

fn ProducedAt(directory: PortDirectory, index, id, width: Nat) → Type {
    HasDirectoryPortAt(directory, id, width, NodeAt(index))
}

fn BinaryNodeIndexed(directory: PortDirectory, index, width, output,
    left, right: Nat) → Type
{
    ProducedAt(directory, index, output, width) ∧
    (HasAvailableDirectoryPort(directory, left, width, index) ∧
     HasAvailableDirectoryPort(directory, right, width, index))
}

fn UnaryImmediateNodeIndexed(directory: PortDirectory, index, width, output,
    value: Nat) → Type
{
    ProducedAt(directory, index, output, width) ∧
    HasAvailableDirectoryPort(directory, value, width, index)
}

fn CompareNodeIndexed(directory: PortDirectory, index, width, output,
    left, right: Nat) → Type
{
    ProducedAt(directory, index, output, 1) ∧
    (HasAvailableDirectoryPort(directory, left, width, index) ∧
     HasAvailableDirectoryPort(directory, right, width, index))
}

fn NodeIndexedIn(directory: PortDirectory, index: Nat, node: Node) → Type {
    match node {
        Const(width, output, _) => ProducedAt(directory, index, output, width),
        Add(width, output, left, right) =>
            BinaryNodeIndexed(directory, index, width, output, left, right),
        Sub(width, output, left, right) =>
            BinaryNodeIndexed(directory, index, width, output, left, right),
        BitAnd(width, output, left, right) =>
            BinaryNodeIndexed(directory, index, width, output, left, right),
        BitOr(width, output, left, right) =>
            BinaryNodeIndexed(directory, index, width, output, left, right),
        BitXor(width, output, left, right) =>
            BinaryNodeIndexed(directory, index, width, output, left, right),
        ShiftLeft(width, output, value, _) =>
            UnaryImmediateNodeIndexed(directory, index, width, output, value),
        LogicalShiftRight(width, output, value, _) =>
            UnaryImmediateNodeIndexed(directory, index, width, output, value),
        ArithmeticShiftRight(width, output, value, _) =>
            UnaryImmediateNodeIndexed(directory, index, width, output, value),
        UnsignedLessThan(width, output, left, right) =>
            CompareNodeIndexed(directory, index, width, output, left, right),
        SignedLessThan(width, output, left, right) =>
            CompareNodeIndexed(directory, index, width, output, left, right),
    }
}

theorem node_indexed_const_fields(
    {directory: PortDirectory}, {index, width, output: Nat},
    output_found: ProducedAt(directory, index, output, width)):
    ProducedAt(directory, index, output, width)
{
    output_found
}

theorem node_indexed_binary(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found:
        ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    BinaryNodeIndexed(directory, index, width, output, left, right)
{
    ⟨output_found, ⟨left_found, right_found⟩⟩
}

theorem node_indexed_unary_immediate(
    {directory: PortDirectory}, {index, width, output, value: Nat},
    output_found: ProducedAt(directory, index, output, width),
    value_found: HasAvailableDirectoryPort(directory, value, width, index)):
    UnaryImmediateNodeIndexed(directory, index, width, output, value)
{
    ⟨output_found, value_found⟩
}

theorem node_indexed_compare(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, 1),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    CompareNodeIndexed(directory, index, width, output, left, right)
{
    ⟨output_found, ⟨left_found, right_found⟩⟩
}

theorem node_indexed_const(
    {directory: PortDirectory}, {index, width, output, value: Nat},
    output_found: ProducedAt(directory, index, output, width)):
    NodeIndexedIn(directory, index, Const(width, output, value))
{
    node_indexed_const_fields(output_found)
}

theorem node_indexed_add(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index, Add(width, output, left, right))
{
    node_indexed_binary(output_found, left_found, right_found)
}

theorem node_indexed_sub(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index, Sub(width, output, left, right))
{
    node_indexed_binary(output_found, left_found, right_found)
}

theorem node_indexed_bitand(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index, BitAnd(width, output, left, right))
{
    node_indexed_binary(output_found, left_found, right_found)
}

theorem node_indexed_bitor(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index, BitOr(width, output, left, right))
{
    node_indexed_binary(output_found, left_found, right_found)
}

theorem node_indexed_bitxor(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, width),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index, BitXor(width, output, left, right))
{
    node_indexed_binary(output_found, left_found, right_found)
}

theorem node_indexed_shift_left(
    {directory: PortDirectory}, {index, width, output, value, amount: Nat},
    output_found: ProducedAt(directory, index, output, width),
    value_found: HasAvailableDirectoryPort(directory, value, width, index)):
    NodeIndexedIn(directory, index, ShiftLeft(width, output, value, amount))
{
    node_indexed_unary_immediate(output_found, value_found)
}

theorem node_indexed_logical_shift_right(
    {directory: PortDirectory}, {index, width, output, value, amount: Nat},
    output_found: ProducedAt(directory, index, output, width),
    value_found: HasAvailableDirectoryPort(directory, value, width, index)):
    NodeIndexedIn(directory, index,
        LogicalShiftRight(width, output, value, amount))
{
    node_indexed_unary_immediate(output_found, value_found)
}

theorem node_indexed_arithmetic_shift_right(
    {directory: PortDirectory}, {index, width, output, value, amount: Nat},
    output_found: ProducedAt(directory, index, output, width),
    value_found: HasAvailableDirectoryPort(directory, value, width, index)):
    NodeIndexedIn(directory, index,
        ArithmeticShiftRight(width, output, value, amount))
{
    node_indexed_unary_immediate(output_found, value_found)
}

theorem node_indexed_unsigned_less_than(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, 1),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index,
        UnsignedLessThan(width, output, left, right))
{
    node_indexed_compare(output_found, left_found, right_found)
}

theorem node_indexed_signed_less_than(
    {directory: PortDirectory}, {index, width, output, left, right: Nat},
    output_found: ProducedAt(directory, index, output, 1),
    left_found: HasAvailableDirectoryPort(directory, left, width, index),
    right_found: HasAvailableDirectoryPort(directory, right, width, index)):
    NodeIndexedIn(directory, index,
        SignedLessThan(width, output, left, right))
{
    node_indexed_compare(output_found, left_found, right_found)
}

fn NodesIndexed(directory: PortDirectory, nodes: List<Node>) → Nat → Type {
    match nodes {
        Nil => λ _ => True,
        Cons(node, rest) => λ index =>
            NodeIndexedIn(directory, index, node) ∧
            NodesIndexed(directory, rest, Succ(index)),
    }
}

theorem nodes_indexed_nil(
    {directory: PortDirectory}, {index: Nat}):
    NodesIndexed(directory, Nil, index)
{
    trivial
}

theorem nodes_indexed_cons(
    {directory: PortDirectory}, {index: Nat},
    {node: Node}, {rest: List<Node>},
    head: NodeIndexedIn(directory, index, node),
    tail: NodesIndexed(directory, rest, Succ(index))):
    NodesIndexed(directory, Cons(node, rest), index)
{
    ⟨head, tail⟩
}

fn OutputEntriesIndexed(directory: PortDirectory,
    outputs: List<Port>) → Type
{
    match outputs {
        Nil => True,
        Cons(output, rest) =>
            HasDirectoryPort(directory, output.id, output.width) ∧
            OutputEntriesIndexed(directory, rest),
    }
}

theorem output_entries_indexed_nil({directory: PortDirectory}):
    OutputEntriesIndexed(directory, Nil)
{
    trivial
}

theorem output_entries_indexed_cons(
    {directory: PortDirectory}, {output: Port}, {rest: List<Port>},
    found: HasDirectoryPort(directory, output.id, output.width),
    tail: OutputEntriesIndexed(directory, rest)):
    OutputEntriesIndexed(directory, Cons(output, rest))
{
    ⟨found, tail⟩
}

record RegionValid(region: Region) {
    directory: PortDirectory,
    directory_ordered: DirectoryOrdered(directory),
    directory_size:
        directory_count(directory) =
            region.inputs.entries.len() + region.nodes.len(),
    inputs_indexed: InputsIndexed(directory, region.inputs),
    nodes_indexed: NodesIndexed(directory, region.nodes, 0),
    outputs_indexed: OutputEntriesIndexed(directory, region.outputs.entries),
}

record CheckedRegion {
    raw: Region,
    valid: RegionValid(raw),
}

// ---------------------------------------------------------------------------
// Pure graph semantics

// A valuation assigns a bitvector of every width to every stable value ID.
// Region inputs constrain selected entries from outside; each node adds an
// equation; region outputs select entries for observation. Because node
// equations do not consume or update a sequential environment, their meaning
// depends only on graph edges, not on the stored schedule.
fn Valuation() → Type { (width: Nat) → Nat → BitVec(width) }

fn NodeHolds(values: Valuation(), node: Node) → Type {
    match node {
        Const(width, output, value) =>
            values(width, output) = bitvec::ofNat(width, value),
        Add(width, output, left, right) =>
            values(width, output) =
                bitvec::add(width, values(width, left), values(width, right)),
        Sub(width, output, left, right) =>
            values(width, output) =
                bitvec::sub(width, values(width, left), values(width, right)),
        BitAnd(width, output, left, right) =>
            values(width, output) =
                bitvec::band(width, values(width, left), values(width, right)),
        BitOr(width, output, left, right) =>
            values(width, output) =
                bitvec::bor(width, values(width, left), values(width, right)),
        BitXor(width, output, left, right) =>
            values(width, output) =
                bitvec::bxor(width, values(width, left), values(width, right)),
        ShiftLeft(width, output, value, amount) =>
            values(width, output) =
                bitvec::shift_left(width, values(width, value), amount),
        LogicalShiftRight(width, output, value, amount) =>
            values(width, output) =
                bitvec::shift_right(width, values(width, value), amount),
        ArithmeticShiftRight(width, output, value, amount) =>
            values(width, output) =
                bitvec::arithmetic_shift_right(width, values(width, value), amount),
        UnsignedLessThan(width, output, left, right) =>
            values(1, output) = bitvec::ofBool(
                bitvec::unsigned_lt_bit(width,
                    values(width, left), values(width, right))),
        SignedLessThan(width, output, left, right) =>
            values(1, output) = bitvec::ofBool(
                bitvec::signed_lt_bit(width,
                    values(width, left), values(width, right))),
    }
}

fn NodesHold(values: Valuation(), nodes: List<Node>) → Type {
    match nodes {
        Nil => True,
        Cons(node, rest) =>
            NodeHolds(values, node) ∧ NodesHold(values, rest),
    }
}

fn RegionHolds(region: Region, values: Valuation()) → Type {
    NodesHold(values, region.nodes)
}

// ---------------------------------------------------------------------------
// Structured regions

// A control-flow edge binds `value` from its predecessor to the fresh
// `parameter` visible in its successor.  Width lives on the binding so the
// semantic equality is well typed without a cast or a trusted lookup.
record BlockArgument {
    width: Nat,
    value: Nat,
    parameter: Nat,
}

fn BlockArguments() → Type { List<BlockArgument> }

fn block_argument_value_entries(arguments: BlockArguments()) → List<Port> {
    match arguments {
        Nil => [],
        Cons(argument, rest) => Cons(
            Port(id := argument.value, width := argument.width),
            block_argument_value_entries(rest)),
    }
}

fn block_argument_values(arguments: BlockArguments()) → Ports {
    Ports(block_argument_value_entries(arguments))
}

fn block_argument_parameter_entries(arguments: BlockArguments()) → List<Port> {
    match arguments {
        Nil => [],
        Cons(argument, rest) => Cons(
            Port(id := argument.parameter, width := argument.width),
            block_argument_parameter_entries(rest)),
    }
}

fn block_argument_parameters(arguments: BlockArguments()) → Ports {
    Ports(block_argument_parameter_entries(arguments))
}

fn BlockArgumentsHold(values: Valuation(), arguments: BlockArguments()) → Type {
    match arguments {
        Nil => True,
        Cons(argument, rest) =>
            values(argument.width, argument.parameter) =
                values(argument.width, argument.value) ∧
            BlockArgumentsHold(values, rest),
    }
}

// Flat `Region` remains the scheduled presentation of one pure dataflow
// graph. `StructuredRegion` composes those leaves with directly recursive
// control nodes. Direct recursion is intentional: writing branches as
// `List<NodeF<StructuredRegion>>` would require nested-inductive lowering and
// would also blur the semantic difference between dataflow scheduling and
// structured control.
inductive StructuredRegion {
    Dataflow(region: Region),
    Sequence(prefix: Region, continuation: StructuredRegion),
    Conditional(
        inputs: Ports,
        condition: Nat,
        arguments: Ports,
        outputs: Ports,
        when_true: StructuredRegion,
        when_false: StructuredRegion),
}

fn structured_inputs(region: StructuredRegion) → Ports {
    match region {
        Dataflow(body) => body.inputs,
        Sequence(prefix, _) => prefix.inputs,
        Conditional(inputs, _, _, _, _, _) => inputs,
    }
}

fn structured_outputs(region: StructuredRegion) → Ports {
    match region {
        Dataflow(body) => body.outputs,
        Sequence(_, continuation) => structured_outputs(continuation),
        Conditional(_, _, _, outputs, _, _) => outputs,
    }
}

fn PortIdAbsent(id: Nat, entries: List<Port>) → Type {
    match entries {
        Nil => True,
        Cons(port, rest) => id ≠ port.id ∧ PortIdAbsent(id, rest),
    }
}

fn PortEntriesUnique(entries: List<Port>) → Type {
    match entries {
        Nil => True,
        Cons(port, rest) => PortIdAbsent(port.id, rest) ∧ PortEntriesUnique(rest),
    }
}

fn PortIdsDisjoint(left, right: List<Port>) → Type {
    match left {
        Nil => True,
        Cons(port, rest) =>
            PortIdAbsent(port.id, right) ∧ PortIdsDisjoint(rest, right),
    }
}

fn HasInterfacePort(entries: List<Port>, id, width: Nat) → Type {
    match entries {
        Nil => False,
        Cons(port, rest) =>
            (port.id = id ∧ port.width = width) ∨
            HasInterfacePort(rest, id, width),
    }
}

fn InterfaceSubset(entries, available: List<Port>) → Type {
    match entries {
        Nil => True,
        Cons(port, rest) =>
            HasInterfacePort(available, port.id, port.width) ∧
            InterfaceSubset(rest, available),
    }
}

fn StructuredRegionValid(region: StructuredRegion) → Type {
    match region {
        Dataflow(body) => RegionValid(body),
        Sequence(prefix, continuation) =>
            RegionValid(prefix) ∧
            (InterfaceSubset(structured_inputs(continuation).entries,
                prefix.inputs.entries ++ prefix.outputs.entries) ∧
             StructuredRegionValid(continuation)),
        Conditional(inputs, condition, arguments, outputs,
            when_true, when_false) =>
            PortEntriesUnique(inputs.entries) ∧
            (PortEntriesUnique(arguments.entries) ∧
             (HasInterfacePort(inputs.entries, condition, 1) ∧
              (InterfaceSubset(arguments.entries, inputs.entries) ∧
               (structured_inputs(when_true) = arguments ∧
                (structured_inputs(when_false) = arguments ∧
                 (structured_outputs(when_true) = outputs ∧
                  (structured_outputs(when_false) = outputs ∧
                   (StructuredRegionValid(when_true) ∧
                    StructuredRegionValid(when_false))))))))),
    }
}

fn StructuredRegionHolds(values: Valuation(), region: StructuredRegion) → Type {
    match region {
        Dataflow(body) => RegionHolds(body, values),
        Sequence(prefix, continuation) =>
            RegionHolds(prefix, values) ∧
            StructuredRegionHolds(values, continuation),
        Conditional(_, condition, _, _, when_true, when_false) =>
            match bitvec::head_bit(0, values(1, condition)) {
                False => StructuredRegionHolds(values, when_false),
                True => StructuredRegionHolds(values, when_true),
            },
    }
}

// The first block-argument graph is a four-block diamond: a producer prefix,
// two selected arms, and one shared continuation.  Keeping this initial core
// as records avoids imposing another recursive eliminator on all FunctionIR
// users.  Recursive composition can be added once this shape has replaced
// the older conditional route and its measured representation cost is known.
record ConditionalJoinRegion {
    inputs: Ports,
    condition: Nat,
    arguments: Ports,
    when_true: Region,
    true_arguments: BlockArguments(),
    when_false: Region,
    false_arguments: BlockArguments(),
    continuation: Region,
}

record ControlRegion {
    prefix: Region,
    join: ConditionalJoinRegion,
}

fn control_inputs(region: ControlRegion) → Ports { region.prefix.inputs }
fn control_outputs(region: ControlRegion) → Ports { region.join.continuation.outputs }

fn ControlJoinInterfacesValid(join: ConditionalJoinRegion) → Type
{
    PortEntriesUnique(join.inputs.entries) ∧
    (PortEntriesUnique(join.arguments.entries) ∧
     (HasInterfacePort(join.inputs.entries, join.condition, 1) ∧
      (InterfaceSubset(join.arguments.entries, join.inputs.entries) ∧
       (join.when_true.inputs = join.arguments ∧
        (join.when_false.inputs = join.arguments ∧
         (join.when_true.outputs = block_argument_values(join.true_arguments) ∧
          (join.when_false.outputs = block_argument_values(join.false_arguments) ∧
           (block_argument_parameters(join.true_arguments) =
            block_argument_parameters(join.false_arguments) ∧
            (join.continuation.inputs =
                block_argument_parameters(join.true_arguments) ∧
             (PortEntriesUnique(
                block_argument_parameters(join.true_arguments).entries) ∧
              PortIdsDisjoint(
                block_argument_parameters(join.true_arguments).entries,
                join.inputs.entries)))))))))))
}

fn ControlRegionValid(region: ControlRegion) → Type {
    RegionValid(region.prefix) ∧
    (InterfaceSubset(region.join.inputs.entries,
        region.prefix.inputs.entries ++ region.prefix.outputs.entries) ∧
     (ControlJoinInterfacesValid(region.join) ∧
      (RegionValid(region.join.when_true) ∧
       (RegionValid(region.join.when_false) ∧
        RegionValid(region.join.continuation)))))
}

fn ControlJoinHolds(values: Valuation(), join: ConditionalJoinRegion) → Type {
    match bitvec::head_bit(0, values(1, join.condition)) {
        False => RegionHolds(join.when_false, values) ∧
            (BlockArgumentsHold(values, join.false_arguments) ∧
             RegionHolds(join.continuation, values)),
        True => RegionHolds(join.when_true, values) ∧
            (BlockArgumentsHold(values, join.true_arguments) ∧
             RegionHolds(join.continuation, values)),
    }
}

fn ControlRegionHolds(values: Valuation(), region: ControlRegion) → Type {
    RegionHolds(region.prefix, values) ∧ ControlJoinHolds(values, region.join)
}

theorem control_join_false(values: Valuation(), join: ConditionalJoinRegion,
    condition: bitvec::head_bit(0, values(1, join.condition)) = False,
    branch: RegionHolds(join.when_false, values),
    arguments: BlockArgumentsHold(values, join.false_arguments),
    continuation: RegionHolds(join.continuation, values)):
    ControlJoinHolds(values, join)
{
    j(sym(condition),
        λ actual _ => match actual as λ _ => Type {
            False => RegionHolds(join.when_false, values) ∧
                (BlockArgumentsHold(values, join.false_arguments) ∧
                 RegionHolds(join.continuation, values)),
            True => RegionHolds(join.when_true, values) ∧
                (BlockArgumentsHold(values, join.true_arguments) ∧
                 RegionHolds(join.continuation, values)),
        },
        ⟨branch, ⟨arguments, continuation⟩⟩)
}

theorem control_join_true(values: Valuation(), join: ConditionalJoinRegion,
    condition: bitvec::head_bit(0, values(1, join.condition)) = True,
    branch: RegionHolds(join.when_true, values),
    arguments: BlockArgumentsHold(values, join.true_arguments),
    continuation: RegionHolds(join.continuation, values)):
    ControlJoinHolds(values, join)
{
    j(sym(condition),
        λ actual _ => match actual as λ _ => Type {
            False => RegionHolds(join.when_false, values) ∧
                (BlockArgumentsHold(values, join.false_arguments) ∧
                 RegionHolds(join.continuation, values)),
            True => RegionHolds(join.when_true, values) ∧
                (BlockArgumentsHold(values, join.true_arguments) ∧
                 RegionHolds(join.continuation, values)),
        },
        ⟨branch, ⟨arguments, continuation⟩⟩)
}

// The semantic rule for an Add node, factored away from any particular
// region. Lowering proofs can use the same observation lemma no matter where
// the node occurs in a schedule.
theorem binary_node_denotes(width, output, left, right: Nat,
    operation: BitVec(width) → BitVec(width) → BitVec(width),
    x, y: BitVec(width), values: Valuation(),
    x_value: values(width, left) = x,
    y_value: values(width, right) = y,
    equation: values(width, output) =
        operation(values(width, left), values(width, right))):
    values(width, output) = operation(x, y)
{
    apply trans;
    give equation;
    apply trans;
    give list::cong_fn<BitVec(width), BitVec(width)>(
        operation(·, values(width, right)), x_value);
    list::cong_fn<BitVec(width), BitVec(width)>(operation(x, ·), y_value)
}

theorem equality_refl<A>(value: A): value = value { refl }

theorem bitvec64_add_congruent(
    {left_before, left_after, right_before, right_after: BitVec(64)},
    left: left_before = left_after,
    right: right_before = right_after):
    bitvec::add(64, left_before, right_before) =
        bitvec::add(64, left_after, right_after)
{
    apply trans;
    give list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::add(64, ·, right_before), left);
    list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::add(64, left_after, ·), right)
}

theorem bitvec64_sub_congruent(
    {left_before, left_after, right_before, right_after: BitVec(64)},
    left: left_before = left_after,
    right: right_before = right_after):
    bitvec::sub(64, left_before, right_before) =
        bitvec::sub(64, left_after, right_after)
{
    apply trans;
    give list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::sub(64, ·, right_before), left);
    list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::sub(64, left_after, ·), right)
}

theorem bitvec64_band_congruent(
    {left_before, left_after, right_before, right_after: BitVec(64)},
    left: left_before = left_after,
    right: right_before = right_after):
    bitvec::band(64, left_before, right_before) =
        bitvec::band(64, left_after, right_after)
{
    apply trans;
    give list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::band(64, ·, right_before), left);
    list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::band(64, left_after, ·), right)
}

theorem bitvec64_bor_congruent(
    {left_before, left_after, right_before, right_after: BitVec(64)},
    left: left_before = left_after,
    right: right_before = right_after):
    bitvec::bor(64, left_before, right_before) =
        bitvec::bor(64, left_after, right_after)
{
    apply trans;
    give list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::bor(64, ·, right_before), left);
    list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::bor(64, left_after, ·), right)
}

theorem bitvec64_bxor_congruent(
    {left_before, left_after, right_before, right_after: BitVec(64)},
    left: left_before = left_after,
    right: right_before = right_after):
    bitvec::bxor(64, left_before, right_before) =
        bitvec::bxor(64, left_after, right_after)
{
    apply trans;
    give list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::bxor(64, ·, right_before), left);
    list::cong_fn<BitVec(64), BitVec(64)>(
        bitvec::bxor(64, left_after, ·), right)
}

theorem add_node_denotes(width, output, left, right: Nat,
    x, y: BitVec(width), values: Valuation(),
    x_value: values(width, left) = x,
    y_value: values(width, right) = y,
    equation: NodeHolds(values,
        Add(width := width, output := output, left := left, right := right))):
    values(width, output) = bitvec::add(width, x, y)
{
    binary_node_denotes(width, output, left, right,
        bitvec::add(width, ·, ·), x, y, values,
        x_value, y_value, equation)
}

// ---------------------------------------------------------------------------
// First checked function: modular 64-bit addition

fn add64_raw() → Region {
    Region(
        inputs := Ports([
            Port(id := 0, width := 64),
            Port(id := 1, width := 64),
        ]),
        nodes := [Add(width := 64, output := 2, left := 0, right := 1)],
        outputs := Ports([Port(id := 2, width := 64)]))
}

theorem add64_denotes(x, y: BitVec(64), values: Valuation(),
    x_value: values(64, 0) = x,
    y_value: values(64, 1) = y,
    graph: RegionHolds(add64_raw(), values)):
    values(64, 2) = bitvec::add(64, x, y)
{
    add_node_denotes(64, 2, 0, 1, x, y, values,
        x_value, y_value, graph.left)
}

// ---------------------------------------------------------------------------
// First nontrivial dataflow graph: two independent additions and a join.

fn sum4_inputs() → Ports {
    Ports([
        Port(id := 0, width := 64), Port(id := 1, width := 64),
        Port(id := 2, width := 64), Port(id := 3, width := 64),
    ])
}

fn sum4_outputs() → Ports { Ports([Port(id := 6, width := 64)]) }

fn sum4_left_first_nodes() → List<Node> {
    [
        Add(width := 64, output := 4, left := 0, right := 1),
        Add(width := 64, output := 5, left := 2, right := 3),
        Add(width := 64, output := 6, left := 4, right := 5),
    ]
}

fn sum4_right_first_nodes() → List<Node> {
    [
        Add(width := 64, output := 5, left := 2, right := 3),
        Add(width := 64, output := 4, left := 0, right := 1),
        Add(width := 64, output := 6, left := 4, right := 5),
    ]
}

fn sum4_left_first_raw() → Region {
    Region(inputs := sum4_inputs(), nodes := sum4_left_first_nodes(),
        outputs := sum4_outputs())
}

fn sum4_right_first_raw() → Region {
    Region(inputs := sum4_inputs(), nodes := sum4_right_first_nodes(),
        outputs := sum4_outputs())
}

theorem sum4_left_to_right_schedule(values: Valuation(),
    graph: RegionHolds(sum4_left_first_raw(), values)):
    RegionHolds(sum4_right_first_raw(), values)
{
    ⟨graph.right.left, ⟨graph.left, graph.right.right⟩⟩
}

theorem sum4_right_to_left_schedule(values: Valuation(),
    graph: RegionHolds(sum4_right_first_raw(), values)):
    RegionHolds(sum4_left_first_raw(), values)
{
    ⟨graph.right.left, ⟨graph.left, graph.right.right⟩⟩
}

theorem sum4_schedules_equivalent(values: Valuation()):
    RegionHolds(sum4_left_first_raw(), values) ↔
        RegionHolds(sum4_right_first_raw(), values)
{
    ⟨sum4_left_to_right_schedule(values, ·),
     sum4_right_to_left_schedule(values, ·)⟩
}

theorem sum4_denotes(a, b, c, d: BitVec(64), values: Valuation(),
    a_value: values(64, 0) = a,
    b_value: values(64, 1) = b,
    c_value: values(64, 2) = c,
    d_value: values(64, 3) = d,
    graph: RegionHolds(sum4_left_first_raw(), values)):
    values(64, 6) = bitvec::add(64,
        bitvec::add(64, a, b), bitvec::add(64, c, d))
{
    add_node_denotes(64, 6, 4, 5,
        bitvec::add(64, a, b), bitvec::add(64, c, d), values,
        add_node_denotes(64, 4, 0, 1, a, b, values,
            a_value, b_value, graph.left),
        add_node_denotes(64, 5, 2, 3, c, d, values,
            c_value, d_value, graph.right.left),
        graph.right.right.left)
}

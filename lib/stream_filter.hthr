// What a stream filter computes (docs/native-stream-filter-design.md §2.1):
// a step that, from a state and a byte, gives the next state and the byte it
// emits, if any, folded over the input. Nothing here is about machines; the
// burned read profile (elf64_read_filter, at the native-v0 tag) ran a filter
// and stated its claim in these terms, and a rebuilt program's spec can too.
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;
import function_ir_loop;

// What one byte does: the next state, and the byte it emits, if any.
record Filtered<C> { next: C, emit: Option<BitVec(8)> }

// A filter that keeps nothing between bytes.
record Stateless {}

// The bytes an emit is: none, or the one.
fn emitted_byte(emit: Option<BitVec(8)>) → List<BitVec(8)> {
    match emit { None => Nil, Some(byte) => [byte] }
}

// The state after the bytes, and what they emit, from a state `s`.
fn filter_state<C>(step: C → BitVec(8) → Filtered<C>, bytes: List<BitVec(8)>) → C → C {
    match bytes {
        Nil => λ s => s,
        Cons(byte, rest) => λ s => filter_state(step, rest, step(s, byte).next),
    }
}
fn filter_emitted<C>(step: C → BitVec(8) → Filtered<C>, bytes: List<BitVec(8)>) → C → List<BitVec(8)> {
    match bytes {
        Nil => λ s => Nil,
        Cons(byte, rest) => λ s => emitted_byte(step(s, byte).emit) ++ filter_emitted(step, rest, step(s, byte).next),
    }
}

// Input read in two parts: the second part starts from the state the first
// left.
theorem filter_state_append<C>(step: C → BitVec(8) → Filtered<C>, front, back: List<BitVec(8)>):
    (s: C) → filter_state(step, front ++ back, s) = filter_state(step, back, filter_state(step, front, s)) {
    match front {
        Nil => λ s => refl,
        Cons(byte, rest) => λ s => filter_state_append(step, rest, back, step(s, byte).next),
    }
}
theorem filter_emitted_append<C>(step: C → BitVec(8) → Filtered<C>, front, back: List<BitVec(8)>):
    (s: C) → filter_emitted(step, front ++ back, s) = filter_emitted(step, front, s) ++ filter_emitted(step, back, filter_state(step, front, s)) {
    match front {
        Nil => λ s => refl,
        Cons(byte, rest) => λ s => {
            let here = emitted_byte(step(s, byte).emit);
            let next = step(s, byte).next;
            trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => here ++ tail, filter_emitted_append(step, rest, back, next)),
                sym(List::append_assoc(here, filter_emitted(step, rest, next), filter_emitted(step, back, filter_state(step, rest, next)))))
        },
    }
}

// One byte: what it emits, then the rest from the state it leaves. The
// process stores byte by byte, so it reads the input as front and one more.
theorem filter_emitted_snoc<C>(step: C → BitVec(8) → Filtered<C>, front: List<BitVec(8)>, byte: BitVec(8), s: C):
    filter_emitted(step, front ++ [byte], s) =
        filter_emitted(step, front, s) ++ emitted_byte(step(filter_state(step, front, s), byte).emit) {
    trans(filter_emitted_append(step, front, [byte], s),
        cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => filter_emitted(step, front, s) ++ tail,
            List::append_nil(emitted_byte(step(filter_state(step, front, s), byte).emit))))
}
theorem filter_state_snoc<C>(step: C → BitVec(8) → Filtered<C>, front: List<BitVec(8)>, byte: BitVec(8), s: C):
    filter_state(step, front ++ [byte], s) = step(filter_state(step, front, s), byte).next {
    filter_state_append(step, front, [byte], s)
}

// A byte emits at most one byte, so the output is never longer than the
// input: the process writes it in place, behind the read.
theorem emitted_byte_len(emit: Option<BitVec(8)>): emitted_byte(emit).len() <= 1 {
    match emit as λ e => emitted_byte(e).len() <= 1 { None => trivial, Some(_) => trivial }
}
theorem filter_emitted_len<C>(step: C → BitVec(8) → Filtered<C>, bytes: List<BitVec(8)>):
    (s: C) → filter_emitted(step, bytes, s).len() <= bytes.len() {
    match bytes {
        Nil => λ s => trivial,
        Cons(byte, rest) => λ s => {
            let here = emitted_byte_len(step(s, byte).emit);
            let after = filter_emitted_len(step, rest, step(s, byte).next);
            // At the goal's spelling: omega reads atoms as written.
            let whole: (filter_emitted(step, Cons(byte, rest), s).len() =
                    emitted_byte(step(s, byte).emit).len() + filter_emitted(step, rest, step(s, byte).next).len()) =
                List::len_append(emitted_byte(step(s, byte).emit), filter_emitted(step, rest, step(s, byte).next));
            let input: (Cons(byte, rest).len() = Succ(rest.len())) = refl;
            omega
        },
    }
}

// ---------------------------------------------------------------------------
// The old shapes, as steps.

// A step that only counts: the fold of `g`, emitting nothing.
fn counting<C>(g: C → BitVec(8) → C) → C → BitVec(8) → Filtered<C> { λ s byte => Filtered(g(s, byte), None) }

theorem counting_state<C>(g: C → BitVec(8) → C, bytes: List<BitVec(8)>):
    (s: C) → filter_state(counting(g), bytes, s) = fold_bytes(g, bytes, s) {
    match bytes {
        Nil => λ s => refl,
        Cons(byte, rest) => λ s => counting_state(g, rest, g(s, byte)),
    }
}
theorem counting_emitted<C>(g: C → BitVec(8) → C, bytes: List<BitVec(8)>): (s: C) → filter_emitted(counting(g), bytes, s) = Nil {
    match bytes {
        Nil => λ s => refl,
        Cons(byte, rest) => λ s => counting_emitted(g, rest, g(s, byte)),
    }
}

// A byte map: every byte emits its image, and nothing is kept.
fn mapping(f: BitVec(8) → BitVec(8)) → Stateless → BitVec(8) → Filtered<Stateless> { λ s byte => Filtered(s, Some(f(byte))) }

theorem mapping_emitted(f: BitVec(8) → BitVec(8), bytes: List<BitVec(8)>): (s: Stateless) → filter_emitted(mapping(f), bytes, s) = bytes.map(f) {
    match bytes {
        Nil => λ s => refl,
        Cons(byte, rest) => λ s => cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => Cons(f(byte), tail), mapping_emitted(f, rest, s)),
    }
}

// ---------------------------------------------------------------------------
// What a counting step's fold computes, from what one byte does to a count
// (docs/native-programs-read-like-programs-design.md §3, S1; moved here from
// the burned filter_program, docs/native-program-logic-design.md §3.1). A
// program proves the per-byte fact, usually by `split_all`; these carry it
// over the input.

// A count field the step raises by one at each byte `p` holds of counts those
// bytes.
theorem counts_filtered<C>(g: C → BitVec(8) → C, field: C → Nat, p: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → field(g(s, b)) = field(s) + Nat::of_bit(p(b)), bytes: List<BitVec(8)>):
    (s: C) → field(fold_bytes(g, bytes, s)) = field(s) + bytes.count(p) {
    match bytes {
        Nil => λ s => refl,
        Cons(b, rest) => λ s => {
            let ih = counts_filtered(g, field, p, grows, rest, g(s, b));
            let grew = grows(s, b);
            let kept = List::count_cons(b, rest, p);
            let sum: (field(fold_bytes(g, rest, g(s, b))) = field(s) + Cons(b, rest).count(p)) = omega;
            sum
        },
    }
}

// A count the step raises by one at every byte counts the bytes.
theorem counts_len<C>(g: C → BitVec(8) → C, count: C → Nat,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = Succ(count(s)), bytes: List<BitVec(8)>):
    (s: C) → count(fold_bytes(g, bytes, s)) = count(s) + bytes.len() {
    match bytes {
        Nil => λ s => refl,
        Cons(b, rest) => λ s => {
            let ih = counts_len(g, count, grows, rest, g(s, b));
            let grew = grows(s, b);
            let sum: (count(fold_bytes(g, rest, g(s, b))) = count(s) + Succ(rest.len())) = omega;
            sum
        },
    }
}

// Runs: the non-empty pieces between separators, such as `wc`'s words.

// What a byte adds to a run count: one when it is not a separator and the
// state was not already in a run.
fn starts_run(cut, inside: Bool) → Nat { match cut { True => 0, False => match inside { True => 0, False => 1 } } }

fn runs_of<A>(pieces: List<List<A>>) → Nat { pieces.count(List::non_empty) }

// Whether the first piece is a run: the one a state already inside a run is
// in, and counted when it began.
fn first_run<A>(pieces: List<List<A>>) → Nat { match pieces { Nil => 0, Cons(piece, _) => Nat::of_bit(piece.non_empty()) } }
fn inside_runs<A>(inside: Bool, pieces: List<List<A>>) → Nat { match inside { True => first_run(pieces), False => 0 } }

theorem onto_first_runs<A>(x: A, pieces: List<List<A>>): runs_of(List::onto_first(x, pieces)) + first_run(pieces) = Succ(runs_of(pieces)) {
    match pieces as λ ps => runs_of(List::onto_first(x, ps)) + first_run(ps) = Succ(runs_of(ps)) {
        Nil => refl,
        Cons(piece, rest) => match piece as λ p => Succ(runs_of(rest)) + first_run(Cons(p, rest)) = Succ(runs_of(Cons(p, rest))) {
            Nil => refl, Cons(_, _) => refl,
        },
    }
}
theorem onto_first_starts<A>(x: A, pieces: List<List<A>>): first_run(List::onto_first(x, pieces)) = 1 {
    match pieces as λ ps => first_run(List::onto_first(x, ps)) = 1 { Nil => refl, Cons(_, _) => refl }
}

// One byte: what the count and the flag do, against what the pieces count and
// start with.
theorem runs_one<A>(x: A, pieces: List<List<A>>, total, before: Nat): (cut, inside: Bool) →
    (total + inside_runs(!cut, pieces) = (before + starts_run(cut, inside)) + runs_of(pieces)) →
    total + inside_runs(inside, List::split_onto(cut, x, pieces)) = before + runs_of(List::split_onto(cut, x, pieces)) {
    split_all;
    all_goals {
        let joined = onto_first_runs(x, pieces);
        let starts = onto_first_starts(x, pieces);
        let empty: (runs_of(Cons(Nil, pieces)) = runs_of(pieces)) = refl;
        omega
    }
}

// A count the step raises at each run's first byte, beside a flag saying
// whether the state is in a run, counts the runs, less the first when the
// state starts inside it.
theorem counts_runs<C>(g: C → BitVec(8) → C, count: C → Nat, inside: C → Bool, sep: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = count(s) + starts_run(sep(b), inside(s)),
    flag: (s: C) → (b: BitVec(8)) → inside(g(s, b)) = !sep(b), bytes: List<BitVec(8)>):
    (s: C) → count(fold_bytes(g, bytes, s)) + inside_runs(inside(s), bytes.split_by(sep)) = count(s) + runs_of(bytes.split_by(sep)) {
    match bytes {
        Nil => λ s => match inside(s) as λ i => count(s) + inside_runs<BitVec(8)>(i, [Nil]) = count(s) + 0 { True => refl, False => refl },
        Cons(b, rest) => λ s => {
            let ih = counts_runs(g, count, inside, sep, grows, flag, rest, g(s, b));
            let flagged = rewrite(flag(s, b), in := ih);
            let grown = rewrite(grows(s, b), in := flagged);
            runs_one(b, rest.split_by(sep), count(fold_bytes(g, rest, g(s, b))), count(s), sep(b), inside(s), grown)
        },
    }
}

// What an author calls: from a state whose count is zero (and, for runs,
// outside a run), the fold's count is what the count means.
theorem fold_counts_filtered<C>(g: C → BitVec(8) → C, field: C → Nat, p: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → field(g(s, b)) = field(s) + Nat::of_bit(p(b)), init: C, zero: field(init) = 0):
    (bytes: List<BitVec(8)>) → bytes.count(p) = field(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let counted = counts_filtered(g, field, p, grows, bytes, init);
        omega
    }
}

theorem fold_counts_len<C>(g: C → BitVec(8) → C, count: C → Nat,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = Succ(count(s)), init: C, zero: count(init) = 0):
    (bytes: List<BitVec(8)>) → bytes.len() = count(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let counted = counts_len(g, count, grows, bytes, init);
        omega
    }
}

theorem fold_counts_runs<C>(g: C → BitVec(8) → C, count: C → Nat, inside: C → Bool, sep: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = count(s) + starts_run(sep(b), inside(s)),
    flag: (s: C) → (b: BitVec(8)) → inside(g(s, b)) = !sep(b), init: C, zero: count(init) = 0, outside: inside(init) = False):
    (bytes: List<BitVec(8)>) → runs_of(bytes.split_by(sep)) = count(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let all = counts_runs(g, count, inside, sep, grows, flag, bytes, init);
        let none: (inside_runs(inside(init), bytes.split_by(sep)) = 0) = j(sym(outside), λ i _ => inside_runs(i, bytes.split_by(sep)) = 0, refl);
        omega
    }
}

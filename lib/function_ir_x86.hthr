theorem sum4_right_x86_block_is_allowed<M>(before: MachineState<M>):
    ExecuteBlock(sum4_right_x86_instructions(), before, sum4_right_x86_after(before))
{
    canonical_execute_block_cons(MovRR(Rax, Rdx), [AddRR(Rax, Rcx), MovRR(R8, Rdi), AddRR(R8, Rsi), AddRR(R8, Rax), MovRR(Rax, R8)], sum4_right_x86_state_0(before), sum4_right_x86_state_6(before), canonical_execute_block_cons(AddRR(Rax, Rcx), [MovRR(R8, Rdi), AddRR(R8, Rsi), AddRR(R8, Rax), MovRR(Rax, R8)], sum4_right_x86_state_1(before), sum4_right_x86_state_6(before), canonical_execute_block_cons(MovRR(R8, Rdi), [AddRR(R8, Rsi), AddRR(R8, Rax), MovRR(Rax, R8)], sum4_right_x86_state_2(before), sum4_right_x86_state_6(before), canonical_execute_block_cons(AddRR(R8, Rsi), [AddRR(R8, Rax), MovRR(Rax, R8)], sum4_right_x86_state_3(before), sum4_right_x86_state_6(before), canonical_execute_block_cons(AddRR(R8, Rax), [MovRR(Rax, R8)], sum4_right_x86_state_4(before), sum4_right_x86_state_6(before), canonical_execute_block_cons(MovRR(Rax, R8), [], sum4_right_x86_state_5(before), sum4_right_x86_state_6(before), execute_block_nil(sum4_right_x86_state_6(before))))))))
}


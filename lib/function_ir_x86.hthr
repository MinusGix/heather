    input_2_placed: ValuePlaced(values, 2, Rdx, before),
    input_3_placed: ValuePlaced(values, 3, Rcx, before),
    graph: RegionHolds(sum4_right_first_raw(), values)):
    ValuePlaced(values, 6, Rax, sum4_right_x86_state_6(before))
{
    placed_after_move(values, 6, R8, Rax,
        sum4_right_x86_state_5(before),
        sum4_right_x86_state_6(before), sum4_right_x86_value_6_after_node_2(values, before, input_0_placed, input_1_placed, input_2_placed, input_3_placed, graph),
        sum4_right_x86_step_5_result(
            sum4_right_x86_state_5(before)))
}
theorem sum4_right_x86_refines_function_ir<M>(values: Valuation(),
    before: MachineState<M>,
    input_0_placed: ValuePlaced(values, 0, Rdi, before),
    input_1_placed: ValuePlaced(values, 1, Rsi, before),
    input_2_placed: ValuePlaced(values, 2, Rdx, before),
    input_3_placed: ValuePlaced(values, 3, Rcx, before),
    graph: RegionHolds(sum4_right_first_raw(), values)):
    read_gpr(Rax, sum4_right_x86_after(before).gprs) = values(64, 6)
{
    sym(sum4_right_x86_output_placed(values, before, input_0_placed, input_1_placed, input_2_placed, input_3_placed, graph))
}

theorem sum4_right_x86_preserves_memory<M>(before: MachineState<M>):
    sum4_right_x86_after(before).memory = before.memory
{ refl }

fn sum4_right_x86_final_rip(start: BitVec(64)) → BitVec(64) { next_rip(next_rip(next_rip(next_rip(next_rip(next_rip(start, 3), 3), 3), 3), 3), 3) }

theorem sum4_right_x86_advances_rip<M>(before: MachineState<M>):
    sum4_right_x86_after(before).rip = sum4_right_x86_final_rip(before.rip)
{ refl }

fn sum4_right_x86_Protected(register: Gpr) → Type {
    match register { Rax => False, R8 => False, _ => True }
}

theorem sum4_right_x86_preserves_protected<M>(register: Gpr,
    before: MachineState<M>): sum4_right_x86_Protected(register) →
    read_gpr(register, sum4_right_x86_after(before).gprs) =
        read_gpr(register, before.gprs)
{
    match register {
         Rax => protected ⊢ false_elim(protected),
         R8 => protected ⊢ false_elim(protected),
         _ => protected ⊢ refl,    }
}

theorem sum4_right_x86_artifact<M>(values: Valuation(),
    before: MachineState<M>,
    input_0_placed: ValuePlaced(values, 0, Rdi, before),
    input_1_placed: ValuePlaced(values, 1, Rsi, before),
    input_2_placed: ValuePlaced(values, 2, Rdx, before),
    input_3_placed: ValuePlaced(values, 3, Rcx, before),
    graph: RegionHolds(sum4_right_first_raw(), values)):
    BlockArtifact<M>(sum4_right_x86_instructions(), before, Rax,
        values(64, 6), sum4_right_x86_Protected,
        sum4_right_x86_final_rip(before.rip))
{
    BlockArtifact(
        after := sum4_right_x86_after(before),
        execution := sum4_right_x86_block_is_allowed(before),
        result_correct := sum4_right_x86_refines_function_ir(values, before, input_0_placed, input_1_placed, input_2_placed, input_3_placed, graph),
        memory_preserved := sum4_right_x86_preserves_memory(before),
        rip_correct := sum4_right_x86_advances_rip(before),
        registers_preserved := λ register protected =>
            sum4_right_x86_preserves_protected(register, before, protected))
}

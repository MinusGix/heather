theorem sum4_x86_preserves_memory<M>(before: MachineState<M>):
    sum4_x86_after(before).memory = before.memory
{ refl }

fn sum4_x86_final_rip(start: BitVec(64)) → BitVec(64) { next_rip(next_rip(next_rip(next_rip(next_rip(start, 3), 3), 3), 3), 3) }

theorem sum4_x86_advances_rip<M>(before: MachineState<M>):
    sum4_x86_after(before).rip = sum4_x86_final_rip(before.rip)
{ refl }

fn sum4_x86_Protected(register: Gpr) → Type {
    match register { Rax => False, R8 => False, _ => True }
}

theorem sum4_x86_preserves_protected<M>(register: Gpr,
    before: MachineState<M>): sum4_x86_Protected(register) →
    read_gpr(register, sum4_x86_after(before).gprs) =
        read_gpr(register, before.gprs)
{
    match register {
         Rax => protected ⊢ false_elim(protected),
         R8 => protected ⊢ false_elim(protected),
         _ => protected ⊢ refl,    }
}

theorem sum4_x86_artifact<M>(values: Valuation(),
    before: MachineState<M>,
    input_0_placed: ValuePlaced(values, 0, Rdi, before),
    input_1_placed: ValuePlaced(values, 1, Rsi, before),
    input_2_placed: ValuePlaced(values, 2, Rdx, before),
    input_3_placed: ValuePlaced(values, 3, Rcx, before),
    graph: RegionHolds(sum4_left_first_raw(), values)):
    BlockArtifact<M>(sum4_x86_instructions(), before, Rax,
        values(64, 6), sum4_x86_Protected,
        sum4_x86_final_rip(before.rip))
{
    BlockArtifact(
        after := sum4_x86_after(before),
        execution := sum4_x86_block_is_allowed(before),
        result_correct := sum4_x86_refines_function_ir(values, before, input_0_placed, input_1_placed, input_2_placed, input_3_placed, graph),
        memory_preserved := sum4_x86_preserves_memory(before),
        rip_correct := sum4_x86_advances_rip(before),
        registers_preserved := λ register protected =>
            sum4_x86_preserves_protected(register, before, protected))
}

fn sum4_right_x86_instructions() → List<Instruction> {
    [MovRR(Rax, Rdx), AddRR(Rax, Rcx), MovRR(R8, Rdi), AddRR(R8, Rsi), AddRR(R8, Rax), MovRR(Rax, R8)]
}

fn sum4_right_x86_bytes() → List<BitVec(8)> {
    canonical_block_bytes(sum4_right_x86_instructions())
}

theorem sum4_right_x86_byte_length(): sum4_right_x86_bytes().len() = 18 { refl }

theorem sum4_right_x86_block_decodes(start: BitVec(64)):
    CanonicalBlockDecodes(sum4_right_x86_instructions(), start)
{
    canonical_block_decodes(sum4_right_x86_instructions(), start)
}


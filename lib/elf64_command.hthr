     canonical_block_bytes([MovRI(R9, page_word()), MovRI(R10, BitVec::ofNat(1))]),
     write_loop_code(pj_newline()),
     canonical_block_bytes([MovRI(R11, slot_at(23))]),
     word_load_bytes(WordLoad(destination := Rax, base := R11)),
     canonical_block_bytes([MovRI(R11, word_zero()), CmpRR(Rax, R11)]),
     near_control_bytes(JumpIfNear(E, cmd_d_closes_je())),
     canonical_block_bytes([MovRR(Rdi, Rsp), MovRI(Rax, BitVec::ofNat(3))]),
     syscall_bytes(),
     canonical_block_bytes([TestRR(Rax, Rax)]),
     near_control_bytes(JumpIfNear(S, cmd_d_close_js())),
     near_control_bytes(JumpNear(cmd_d_close_jmp())),
     canonical_block_bytes([MovRI(R11, BitVec::ofNat(10))]),
     byte_store_bytes(ByteStore(base := Rdi, source := R11)),
     canonical_block_bytes([AddRI8(Rdi, one_byte()), MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)])]
}

theorem keep_measured(): LayoutMeasured(keep_parts(), keep_lens()) {
    let closed: (piece_lens(keep_parts()) = keep_lens()) = refl;
    j(closed, λ ls _ => LayoutMeasured(keep_parts(), ls), measured_self(keep_parts()))
}
theorem keep_code_len(): keep_code().len() = keep_len() { layout_len(keep_parts(), keep_last(), keep_lens(), keep_measured(), 5, refl) }

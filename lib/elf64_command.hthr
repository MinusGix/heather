fn keep_parts() → List<List<BitVec(8)>> {
    [canonical_block_bytes([MovRI(R11, slot_at(16))]),
     word_store_bytes(WordStore(base := R11, source := R8)),
     canonical_block_bytes([MovRI(R11, slot_at(21))]),
     word_store_bytes(WordStore(base := R11, source := R9)),
     canonical_block_bytes([MovRI(R11, BitVec::ofNat(2)), CmpRR(R9, R11)]),
     near_control_bytes(JumpIfNear(AE, cmd_d_few_jae())),
     canonical_block_bytes([MovRI(R11, BitVec::ofNat(1)), MovRR(Rax, R8), SubRR(Rax, R11), AndRR(Rax, R8), MovRI(R11, word_zero()), CmpRR(Rax, R11)]),
     near_control_bytes(JumpIfNear(NE, cmd_d_single_jne())),
     canonical_block_bytes([MovRI(Rsi, BitVec::ofNat(1))])]
}

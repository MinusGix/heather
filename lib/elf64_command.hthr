// A command (docs/native-wc-command-design.md §6): a filter run over each
// operand in turn, a row of counts after each, a total row after two or more,
// and the exit status of what failed. The code is a program of labelled
// items (x86_64_asm), the program's step last, so only the step's own jumps
// depend on its length; the library pieces (the argument scan, the stat pass,
// the operand cursor, the row writer, the read head and the filter's chunk
// loop) are placed whole. Between operands everything the command keeps is
// in the frame's slots (elf64_frame), since the read loop leaves it no
// register but RSP, which holds the operand's fd. The claim is
// `command_runs`, against elf64_command_events' `command_events`.
import command_program;
import decimal_line;
import elf64_arg_scan;
import elf64_command_events;
import elf64_format_width;
import elf64_runs;
import elf64_frame;
import elf64_straight;
import elf64_io;
import elf64_operand_cursor;
import elf64_print_pieces;
import elf64_read_filter;
import elf64_read_pieces;
import elf64_row_fields;
import elf64_stat_width;
import elf64_write_loop;
import filter_step_piece;
import linux_x86_64_io;
import stream_filter;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import x86_64_store;
import x86_64_structured_block;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The frame's slots: a file's counts (0–7), the totals (8–15), the selection
// (16), the width (17), the status (18), the operand cursor's argv slot (19)
// and whether `--` has been seen (20), the operand count (21), the current
// operand's name (22), and whether it was opened, so is closed (23).

fn slot_at(i: Nat) → BitVec(64) { frame_at(8 * i) }

// The registers a column's count can be spilled from: the state's.
inductive StateReg { SR13, SR14, SR15, SR8 }
fn state_gpr(r: StateReg) → Gpr { match r { SR13 => R13, SR14 => R14, SR15 => R15, SR8 => R8 } }

// Slot `i`'s count stored, then added into its total: R11 and RAX only. A
// program of its own (x86_64_asm), the same bytes wherever it is placed.
fn lsp_slot(r: Gpr, i: Nat) → Prog { then(Start, Block([MovRI(R11, slot_at(i))])) }
fn lsp_store(r: Gpr, i: Nat) → Prog { then(lsp_slot(r, i), Store(WordStore(base := R11, source := r))) }
fn lsp_total(r: Gpr, i: Nat) → Prog { then(lsp_store(r, i), Block([MovRI(R11, slot_at(8 + i))])) }
fn lsp_load(r: Gpr, i: Nat) → Prog { then(lsp_total(r, i), Load(WordLoad(destination := Rax, base := R11))) }
fn lsp_add(r: Gpr, i: Nat) → Prog { then(lsp_load(r, i), Block([AddRR(Rax, r)])) }
fn lsp_back(r: Gpr, i: Nat) → Prog { then(lsp_add(r, i), Store(WordStore(base := R11, source := Rax))) }
fn spill_block(r: Gpr, i: Nat) → List<BitVec(8)> { assemble(no_fills(), lsp_back(r, i), Nil) }
fn spill_blocks(spill: Nat → StateReg, i, j: Nat) → List<BitVec(8)> {
    match j { Zero => Nil, Succ(k) => spill_block(state_gpr(spill(i)), i) ++ spill_blocks(spill, Succ(i), k) }
}
fn spill_code(spill: Nat → StateReg) → List<BitVec(8)> { spill_blocks(spill, 0, column_slots()) }

theorem spill_block_len(r: Gpr, i: Nat): spill_block(r, i).len() = 32 { refl }
theorem spill_blocks_len(spill: Nat → StateReg, j: Nat): (i: Nat) → spill_blocks(spill, i, j).len() = 32 * j {
    match j as λ k => (i: Nat) → spill_blocks(spill, i, k).len() = 32 * k {
        Zero => λ i => refl,
        Succ(k) => λ i => {
            let rest = spill_blocks_len(spill, k, Succ(i));
            let total: (32 + 32 * k = 32 * Succ(k)) = omega;
            trans(List::len_append(spill_block(state_gpr(spill(i)), i), spill_blocks(spill, Succ(i), k)),
                trans(cong_fn<Nat, Nat>(λ l => l + spill_blocks(spill, Succ(i), k).len(), spill_block_len(state_gpr(spill(i)), i)),
                    trans(cong_fn<Nat, Nat>(λ l => 32 + l, rest), total)))
        },
    }
}
fn spill_len() → Nat { 32 * column_slots() }
theorem spill_code_len(spill: Nat → StateReg): spill_code(spill).len() = spill_len() { spill_blocks_len(spill, 8, 0) }

// ---------------------------------------------------------------------------
// The code (x86_64_asm): the library's pieces placed whole and the command's
// own code between them, every position a proof cites a label. The read
// head's JZ goes to the row code at `l_spill`, its JS to the failed read at
// `l_read_failed`, and the program's step and the chunk loop's other code
// come last, at `l_core`.

// The jumps' targets, named: any numbers but zero will do, so long as no two
// are the same (a name given twice sends a jump to the later label, and that
// jump's landing fact below refuses it).
fn t_stat() → Nat { 1 }
fn t_wstore() → Nat { 2 }
fn t_loop() → Nat { 3 }
fn t_open() → Nat { 4 }
fn t_failed() → Nat { 5 }
fn t_spill() → Nat { 6 }
fn t_nm() → Nat { 7 }
fn t_len_load() → Nat { 8 }
fn t_found() → Nat { 9 }
fn t_nl() → Nat { 10 }
fn t_closes() → Nat { 11 }
fn t_unnamed() → Nat { 12 }
fn t_total() → Nat { 13 }
fn t_exit() → Nat { 14 }
fn t_read_failed() → Nat { 15 }
fn t_state_init() → Nat { 16 }
fn t_head() → Nat { 17 }
fn syscall() → Asm { Code(syscall_bytes()) }
// A word stored to or loaded from the slot R11 holds.
fn wstore(source: Gpr) → Asm { Store(WordStore(base := R11, source := source)) }
fn wload(destination: Gpr) → Asm { Load(WordLoad(destination := destination, base := R11)) }
// The write loop (elf64_write_loop), its all-sent JZ to `done`.
fn write_done(labels: Nat → Nat, here: Nat, done: Nat) → BitVec(32) { near_rel(wl_at_wjz(here) + 6, labels(done)) }
fn write_to(done: Nat) → Asm {
    Refer(λ labels here => write_loop_code(wl_jumps(write_done(labels, here, done))), write_loop_len(),
        λ labels here => write_loop_code_len(wl_jumps(write_done(labels, here, done))))
}
// The read head (elf64_read_pieces), its JZ to `ended` and its JS to `failed`.
fn head_ed(labels: Nat → Nat, here: Nat, ended: Nat) → BitVec(32) { near_rel(rh_at_js(FdIn(Rsp), here), labels(ended)) }
fn head_sd(labels: Nat → Nat, here: Nat, failed: Nat) → BitVec(32) { near_rel(rh_at_end(FdIn(Rsp), here), labels(failed)) }
fn head_to(ended, failed: Nat) → Asm {
    Refer(λ labels here => read_head_code(FdIn(Rsp), head_ed(labels, here, ended), head_sd(labels, here, failed)), read_head_len(FdIn(Rsp)),
        λ labels here => read_head_code_len(FdIn(Rsp), head_ed(labels, here, ended), head_sd(labels, here, failed)))
}

// The command's code: the argument scan; the selection and count kept, and
// the width set; the stat pass; the slots set; the operand cursor's start,
// and stdin when there is no operand; the cursor, and each operand opened,
// `-` read as stdin, or its failure recorded; after a file's reads the
// spill and its row, the name, and the close; after the last operand the
// totals' row; the exit, the failed read and the read loop's state; and the
// read head, with the chunk loop and the step after it (`l_core`). Each
// label is the program up to and with its item; the scan and the spill
// table are the holes the command is assembled with (`cmd_fills`).
// scan
fn l_scan() → Prog { then(Start, Hole(0, scan_len())) }
// keep
fn l_keep_mask() → Prog { then(l_scan(), Block([MovRI(R11, slot_at(16))])) }
fn l_keep_mask_store() → Prog { then(l_keep_mask(), wstore(R8)) }
fn l_keep_count() → Prog { then(l_keep_mask_store(), Block([MovRI(R11, slot_at(21))])) }
fn l_keep_count_store() → Prog { then(l_keep_count(), wstore(R9)) }
fn l_few() → Prog { then(l_keep_count_store(), Block([MovRI(R11, BitVec::ofNat(2)), CmpRR(R9, R11)])) }
fn l_few_jae() → Prog { then(l_few(), Jcc(AE, t_stat())) }
fn l_single() → Prog { then(l_few_jae(), Block([MovRI(R11, BitVec::ofNat(1)), MovRR(Rax, R8), SubRR(Rax, R11), AndRR(Rax, R8), MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_single_jne() → Prog { then(l_single(), Jcc(NE, t_stat())) }
fn l_narrow() → Prog { then(l_single_jne(), Block([MovRI(Rsi, BitVec::ofNat(1))])) }
fn l_narrow_jmp() → Prog { then(l_narrow(), Jmp(t_wstore())) }
// stat
fn l_stat() → Prog { At(l_narrow_jmp(), t_stat(), Piece(stat_code(), stat_len(), stat_code_len())) }
// init
fn l_wstore() → Prog { At(l_stat(), t_wstore(), Block([MovRI(R11, slot_at(17))])) }
fn l_wstore_store() → Prog { then(l_wstore(), wstore(Rsi)) }
fn l_zero() → Prog { then(l_wstore_store(), Block([MovRI(Rax, word_zero())])) }
fn l_zero0() → Prog { then(l_zero(), Block([MovRI(R11, slot_at(18))])) }
fn l_zero0_store() → Prog { then(l_zero0(), wstore(Rax)) }
fn l_zero1() → Prog { then(l_zero0_store(), Block([MovRI(R11, slot_at(8))])) }
fn l_zero1_store() → Prog { then(l_zero1(), wstore(Rax)) }
fn l_zero2() → Prog { then(l_zero1_store(), Block([MovRI(R11, slot_at(9))])) }
fn l_zero2_store() → Prog { then(l_zero2(), wstore(Rax)) }
fn l_zero3() → Prog { then(l_zero2_store(), Block([MovRI(R11, slot_at(10))])) }
fn l_zero3_store() → Prog { then(l_zero3(), wstore(Rax)) }
fn l_zero4() → Prog { then(l_zero3_store(), Block([MovRI(R11, slot_at(11))])) }
fn l_zero4_store() → Prog { then(l_zero4(), wstore(Rax)) }
fn l_zero5() → Prog { then(l_zero4_store(), Block([MovRI(R11, slot_at(12))])) }
fn l_zero5_store() → Prog { then(l_zero5(), wstore(Rax)) }
fn l_zero6() → Prog { then(l_zero5_store(), Block([MovRI(R11, slot_at(13))])) }
fn l_zero6_store() → Prog { then(l_zero6(), wstore(Rax)) }
fn l_zero7() → Prog { then(l_zero6_store(), Block([MovRI(R11, slot_at(14))])) }
fn l_zero7_store() → Prog { then(l_zero7(), wstore(Rax)) }
fn l_zero8() → Prog { then(l_zero7_store(), Block([MovRI(R11, slot_at(15))])) }
fn l_zero8_store() → Prog { then(l_zero8(), wstore(Rax)) }
// start
fn l_start() → Prog { then(l_zero8_store(), Piece(start_code(), start_len(), start_code_len())) }
// begin
fn l_ckeep() → Prog { then(l_start(), Block([MovRI(R11, slot_at(19))])) }
fn l_ckeep_store() → Prog { then(l_ckeep(), wstore(Rbx)) }
fn l_ekeep() → Prog { then(l_ckeep_store(), Block([MovRI(R11, slot_at(20))])) }
fn l_ekeep_store() → Prog { then(l_ekeep(), wstore(R12)) }
fn l_none() → Prog { then(l_ekeep_store(), Block([MovRI(R11, slot_at(21))])) }
fn l_none_load() → Prog { then(l_none(), wload(Rax)) }
fn l_none_test() → Prog { then(l_none_load(), Block([MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_none_jne() → Prog { then(l_none_test(), Jcc(NE, t_loop())) }
fn l_stdin() → Prog { then(l_none_jne(), Block([MovRI(Rsp, word_zero())])) }
fn l_stdin_jmp() → Prog { then(l_stdin(), Jmp(t_state_init())) }
fn l_loop() → Prog { At(l_stdin_jmp(), t_loop(), Block([MovRI(R11, slot_at(19))])) }
fn l_loop_load() → Prog { then(l_loop(), wload(Rbx)) }
fn l_loop_ended() → Prog { then(l_loop_load(), Block([MovRI(R11, slot_at(20))])) }
fn l_loop_ended_load() → Prog { then(l_loop_ended(), wload(R12)) }
// cursor
fn l_cursor() → Prog { then(l_loop_ended_load(), Piece(cursor_code(), cursor_len(), cursor_code_len())) }
// operand
fn l_cstore() → Prog { then(l_cursor(), Block([MovRI(R11, slot_at(19))])) }
fn l_cstore_store() → Prog { then(l_cstore(), wstore(Rbx)) }
fn l_estore() → Prog { then(l_cstore_store(), Block([MovRI(R11, slot_at(20))])) }
fn l_estore_store() → Prog { then(l_estore(), wstore(R12)) }
fn l_last() → Prog { then(l_estore_store(), Block([MovRI(R11, word_zero()), CmpRR(Rsi, R11)])) }
fn l_last_je() → Prog { then(l_last(), Jcc(E, t_total())) }
fn l_name() → Prog { then(l_last_je(), Block([MovRI(R11, slot_at(22))])) }
fn l_name_store() → Prog { then(l_name(), wstore(Rsi)) }
fn l_dash_load() → Prog { then(l_name_store(), LoadByte(ByteLoad(destination := Rax, base := Rsi))) }
fn l_dash_test() → Prog { then(l_dash_load(), Block([MovRI(R11, byte_word(dash())), CmpRR(Rax, R11)])) }
fn l_dash_jne() → Prog { then(l_dash_test(), Jcc(NE, t_open())) }
fn l_ahead() → Prog { then(l_dash_jne(), Block([MovRR(Rdi, Rsi), AddRI8(Rdi, one_byte())])) }
fn l_ahead_load() → Prog { then(l_ahead(), LoadByte(ByteLoad(destination := Rax, base := Rdi))) }
fn l_ahead_test() → Prog { then(l_ahead_load(), Block([MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_ahead_jne() → Prog { then(l_ahead_test(), Jcc(NE, t_open())) }
fn l_dash() → Prog { then(l_ahead_jne(), Block([MovRI(Rax, word_zero()), MovRI(R11, slot_at(23))])) }
fn l_dash_store() → Prog { then(l_dash(), wstore(Rax)) }
fn l_dash_fd() → Prog { then(l_dash_store(), Block([MovRI(Rsp, word_zero())])) }
fn l_dash_jmp() → Prog { then(l_dash_fd(), Jmp(t_state_init())) }
fn l_open() → Prog { At(l_dash_jmp(), t_open(), Block([MovRI(Rdi, at_fdcwd()), MovRI(Rdx, word_zero()), MovRI(Rax, BitVec::ofNat(257))])) }
fn l_open_call() → Prog { then(l_open(), syscall()) }
fn l_open_test() → Prog { then(l_open_call(), Block([TestRR(Rax, Rax)])) }
fn l_open_js() → Prog { then(l_open_test(), Jcc(S, t_failed())) }
fn l_opened() → Prog { then(l_open_js(), Block([MovRR(Rsp, Rax), MovRI(Rax, BitVec::ofNat(1)), MovRI(R11, slot_at(23))])) }
fn l_opened_store() → Prog { then(l_opened(), wstore(Rax)) }
fn l_opened_jmp() → Prog { then(l_opened_store(), Jmp(t_state_init())) }
fn l_failed() → Prog { At(l_opened_jmp(), t_failed(), Block([MovRI(Rax, BitVec::ofNat(1)), MovRI(R11, slot_at(18))])) }
fn l_failed_store() → Prog { then(l_failed(), wstore(Rax)) }
fn l_failed_jmp() → Prog { then(l_failed_store(), Jmp(t_loop())) }
// spill
fn l_spill() → Prog { At(l_failed_jmp(), t_spill(), Hole(1, spill_len())) }
// setup
fn l_setup() → Prog { then(l_spill(), Block([MovRI(R12, slot_at(0)), MovRI(R11, slot_at(16))])) }
fn l_setup_mask() → Prog { then(l_setup(), wload(R13)) }
fn l_setup_w() → Prog { then(l_setup_mask(), Block([MovRI(R11, slot_at(17))])) }
fn l_setup_width() → Prog { then(l_setup_w(), wload(R14)) }
fn l_setup_page() → Prog { then(l_setup_width(), Block([MovRI(Rdi, page_word())])) }
// row
fn l_row() → Prog { then(l_setup_page(), Piece(row_code(), row_len(), row_code_len())) }
// tails
fn l_named() → Prog { then(l_row(), Block([MovRI(R11, slot_at(21))])) }
fn l_named_load() → Prog { then(l_named(), wload(Rax)) }
fn l_named_test() → Prog { then(l_named_load(), Block([MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_named_je() → Prog { then(l_named_test(), Jcc(E, t_unnamed())) }
fn l_gap() → Prog { then(l_named_je(), Block([MovRI(R11, BitVec::ofNat(32))])) }
fn l_gap_store() → Prog { then(l_gap(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_gap_len() → Prog { then(l_gap_store(), Block([AddRI8(Rdi, one_byte()), MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)])) }
fn l_gap_write() → Prog { then(l_gap_len(), write_to(t_nm())) }
fn l_nm() → Prog { At(l_gap_write(), t_nm(), Block([MovRI(R11, slot_at(22))])) }
fn l_nm_load() → Prog { then(l_nm(), wload(Rsi)) }
fn l_nm_copy() → Prog { then(l_nm_load(), Block([MovRR(Rdx, Rsi)])) }
fn l_len_load() → Prog { At(l_nm_copy(), t_len_load(), LoadByte(ByteLoad(destination := Rax, base := Rdx))) }
fn l_len_test() → Prog { then(l_len_load(), Block([MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_len_je() → Prog { then(l_len_test(), Jcc(E, t_found())) }
fn l_len_step() → Prog { then(l_len_je(), Block([AddRI8(Rdx, one_byte())])) }
fn l_len_jmp() → Prog { then(l_len_step(), Jmp(t_len_load())) }
fn l_found() → Prog { At(l_len_jmp(), t_found(), Block([MovRR(R9, Rsi), MovRR(R10, Rdx), SubRR(R10, Rsi)])) }
fn l_name_write() → Prog { then(l_found(), write_to(t_nl())) }
fn l_nl() → Prog { At(l_name_write(), t_nl(), Block([MovRI(Rdi, page_word()), MovRI(R11, BitVec::ofNat(10))])) }
fn l_nl_store() → Prog { then(l_nl(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_nl_len() → Prog { then(l_nl_store(), Block([MovRI(R9, page_word()), MovRI(R10, BitVec::ofNat(1))])) }
fn l_nl_write() → Prog { then(l_nl_len(), write_to(t_closes())) }
fn l_closes() → Prog { At(l_nl_write(), t_closes(), Block([MovRI(R11, slot_at(23))])) }
fn l_closes_load() → Prog { then(l_closes(), wload(Rax)) }
fn l_closes_test() → Prog { then(l_closes_load(), Block([MovRI(R11, word_zero()), CmpRR(Rax, R11)])) }
fn l_closes_je() → Prog { then(l_closes_test(), Jcc(E, t_loop())) }
fn l_close() → Prog { then(l_closes_je(), Block([MovRR(Rdi, Rsp), MovRI(Rax, BitVec::ofNat(3))])) }
fn l_close_call() → Prog { then(l_close(), syscall()) }
fn l_close_test() → Prog { then(l_close_call(), Block([TestRR(Rax, Rax)])) }
fn l_close_js() → Prog { then(l_close_test(), Jcc(S, t_failed())) }
fn l_close_jmp() → Prog { then(l_close_js(), Jmp(t_loop())) }
fn l_unnamed() → Prog { At(l_close_jmp(), t_unnamed(), Block([MovRI(R11, BitVec::ofNat(10))])) }
fn l_unnamed_store() → Prog { then(l_unnamed(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_unnamed_len() → Prog { then(l_unnamed_store(), Block([AddRI8(Rdi, one_byte()), MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)])) }
fn l_unnamed_write() → Prog { then(l_unnamed_len(), write_to(t_exit())) }
// total
fn l_total() → Prog { At(l_unnamed_write(), t_total(), Block([MovRI(R11, slot_at(21))])) }
fn l_total_load() → Prog { then(l_total(), wload(Rax)) }
fn l_total_test() → Prog { then(l_total_load(), Block([MovRI(R11, BitVec::ofNat(2)), CmpRR(Rax, R11)])) }
fn l_total_jb() → Prog { then(l_total_test(), Jcc(B, t_exit())) }
// tsetup
fn l_tsetup() → Prog { then(l_total_jb(), Block([MovRI(R12, slot_at(8)), MovRI(R11, slot_at(16))])) }
fn l_tsetup_mask() → Prog { then(l_tsetup(), wload(R13)) }
fn l_tsetup_w() → Prog { then(l_tsetup_mask(), Block([MovRI(R11, slot_at(17))])) }
fn l_tsetup_width() → Prog { then(l_tsetup_w(), wload(R14)) }
fn l_tsetup_page() → Prog { then(l_tsetup_width(), Block([MovRI(Rdi, page_word())])) }
// total_row
fn l_total_row() → Prog { then(l_tsetup_page(), Piece(row_code(), row_len(), row_code_len())) }
// tname
fn l_tn0() → Prog { then(l_total_row(), Block([MovRI(R11, BitVec::ofNat(32))])) }
fn l_tn0_store() → Prog { then(l_tn0(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn0_step() → Prog { then(l_tn0_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn1() → Prog { then(l_tn0_step(), Block([MovRI(R11, BitVec::ofNat(116))])) }
fn l_tn1_store() → Prog { then(l_tn1(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn1_step() → Prog { then(l_tn1_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn2() → Prog { then(l_tn1_step(), Block([MovRI(R11, BitVec::ofNat(111))])) }
fn l_tn2_store() → Prog { then(l_tn2(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn2_step() → Prog { then(l_tn2_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn3() → Prog { then(l_tn2_step(), Block([MovRI(R11, BitVec::ofNat(116))])) }
fn l_tn3_store() → Prog { then(l_tn3(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn3_step() → Prog { then(l_tn3_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn4() → Prog { then(l_tn3_step(), Block([MovRI(R11, BitVec::ofNat(97))])) }
fn l_tn4_store() → Prog { then(l_tn4(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn4_step() → Prog { then(l_tn4_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn5() → Prog { then(l_tn4_step(), Block([MovRI(R11, BitVec::ofNat(108))])) }
fn l_tn5_store() → Prog { then(l_tn5(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn5_step() → Prog { then(l_tn5_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tn6() → Prog { then(l_tn5_step(), Block([MovRI(R11, BitVec::ofNat(10))])) }
fn l_tn6_store() → Prog { then(l_tn6(), Code(byte_store_bytes(ByteStore(base := Rdi, source := R11)))) }
fn l_tn6_step() → Prog { then(l_tn6_store(), Block([AddRI8(Rdi, one_byte())])) }
fn l_tlen() → Prog { then(l_tn6_step(), Block([MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)])) }
fn l_total_write() → Prog { then(l_tlen(), write_to(t_exit())) }
// finish
fn l_exit() → Prog { At(l_total_write(), t_exit(), Block([MovRI(R11, slot_at(18))])) }
fn l_exit_load() → Prog { then(l_exit(), wload(Rdi)) }
fn l_exit_num() → Prog { then(l_exit_load(), Block([MovRI(Rax, BitVec::ofNat(60))])) }
fn l_exit_call() → Prog { then(l_exit_num(), syscall()) }
fn l_read_failed() → Prog { At(l_exit_call(), t_read_failed(), Block(eof_retry_block())) }
fn l_retry_jz() → Prog { then(l_read_failed(), Jcc(E, t_head())) }
fn l_rfail() → Prog { then(l_retry_jz(), Block([MovRI(Rax, BitVec::ofNat(1)), MovRI(R11, slot_at(18))])) }
fn l_rfail_store() → Prog { then(l_rfail(), wstore(Rax)) }
fn l_rfail_jmp() → Prog { then(l_rfail_store(), Jmp(t_spill())) }
fn l_state_init() → Prog { At(l_rfail_jmp(), t_state_init(), Block(state_init_block())) }
// head
fn l_head() → Prog { At(l_state_init(), t_head(), head_to(t_spill(), t_read_failed())) }
fn cmd_prog() → Prog { l_head() }
// Where the program ends: the chunk loop, the step and what follows them.
fn l_core() → Prog { then(l_head(), Block(Nil)) }
fn cmd_labels() → Nat → Nat { asm_labels(cmd_prog()) }
// The holes: the argument scan, at the command's letters and default, and
// the spill table.
fn cmd_fills(letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg) → Nat → List<BitVec(8)> {
    λ i => match i { Zero => scan_code(letters, default), Succ(_) => spill_code(spill) }
}
theorem cmd_fits(letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg): FillsFit(cmd_prog(), cmd_fills(letters, default, spill)) {
    // Stated unfolded: elaborating against `FillsFit` itself walks the
    // whole chain in the elaborator.
    let fit: (cmd_fills(letters, default, spill)(1).len() = spill_len()) ∧ ((cmd_fills(letters, default, spill)(0).len() = scan_len()) ∧ True) =
        And(spill_code_len(spill), And(scan_code_len(letters, default), trivial));
    fit
}
// The code: the program, then the chunk loop.
fn command_code(letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps)
    → List<BitVec(8)> {
    assemble(cmd_fills(letters, default, spill), cmd_prog(), filter_core_code(code, jumps, pj))
}
fn ca(l: Prog) → Nat { asm_at(l) }
// The displacement of the jump at `l`.
fn cmd_d(l: Prog) → BitVec(32) { asm_jump(cmd_labels(), l) }
fn cmd_ed() → BitVec(32) { head_ed(cmd_labels(), ca(l_head()), t_spill()) }
fn cmd_sd() → BitVec(32) { head_sd(cmd_labels(), ca(l_head()), t_read_failed()) }
// The write loop at `at`, done at the label named `done`.
fn pj_to(at: Prog, done: Nat) → PrintJumps { wl_jumps(write_done(cmd_labels(), ca(at), done)) }
fn pj_counts() → PrintJumps { pj_to(l_gap_write(), t_nm()) }
fn pj_name() → PrintJumps { pj_to(l_name_write(), t_nl()) }
fn pj_newline() → PrintJumps { pj_to(l_nl_write(), t_closes()) }
fn pj_stdin() → PrintJumps { pj_to(l_unnamed_write(), t_exit()) }
fn pj_total() → PrintJumps { pj_to(l_total_write(), t_exit()) }

// Where each jump lands: closed facts, by evaluation.
theorem cmd_j_few_jae(): JumpsForward(ca(l_few_jae()), 6, cmd_d(l_few_jae()), ca(l_stat())) { asm_jump_lands(cmd_labels(), l_few_jae(), 6, ca(l_stat()), refl) }
theorem cmd_j_single_jne(): JumpsForward(ca(l_single_jne()), 6, cmd_d(l_single_jne()), ca(l_stat())) { asm_jump_lands(cmd_labels(), l_single_jne(), 6, ca(l_stat()), refl) }
theorem cmd_j_narrow_jmp(): JumpsForward(ca(l_narrow_jmp()), 5, cmd_d(l_narrow_jmp()), ca(l_wstore())) { asm_jump_lands(cmd_labels(), l_narrow_jmp(), 5, ca(l_wstore()), refl) }
theorem cmd_j_none_jne(): JumpsForward(ca(l_none_jne()), 6, cmd_d(l_none_jne()), ca(l_loop())) { asm_jump_lands(cmd_labels(), l_none_jne(), 6, ca(l_loop()), refl) }
theorem cmd_j_stdin_jmp(): JumpsForward(ca(l_stdin_jmp()), 5, cmd_d(l_stdin_jmp()), ca(l_state_init())) { asm_jump_lands(cmd_labels(), l_stdin_jmp(), 5, ca(l_state_init()), refl) }
theorem cmd_j_last_je(): JumpsForward(ca(l_last_je()), 6, cmd_d(l_last_je()), ca(l_total())) { asm_jump_lands(cmd_labels(), l_last_je(), 6, ca(l_total()), refl) }
theorem cmd_j_dash_jne(): JumpsForward(ca(l_dash_jne()), 6, cmd_d(l_dash_jne()), ca(l_open())) { asm_jump_lands(cmd_labels(), l_dash_jne(), 6, ca(l_open()), refl) }
theorem cmd_j_ahead_jne(): JumpsForward(ca(l_ahead_jne()), 6, cmd_d(l_ahead_jne()), ca(l_open())) { asm_jump_lands(cmd_labels(), l_ahead_jne(), 6, ca(l_open()), refl) }
theorem cmd_j_dash_jmp(): JumpsForward(ca(l_dash_jmp()), 5, cmd_d(l_dash_jmp()), ca(l_state_init())) { asm_jump_lands(cmd_labels(), l_dash_jmp(), 5, ca(l_state_init()), refl) }
theorem cmd_j_open_js(): JumpsForward(ca(l_open_js()), 6, cmd_d(l_open_js()), ca(l_failed())) { asm_jump_lands(cmd_labels(), l_open_js(), 6, ca(l_failed()), refl) }
theorem cmd_j_opened_jmp(): JumpsForward(ca(l_opened_jmp()), 5, cmd_d(l_opened_jmp()), ca(l_state_init())) { asm_jump_lands(cmd_labels(), l_opened_jmp(), 5, ca(l_state_init()), refl) }
theorem cmd_j_failed_jmp(): JumpsBack(ca(l_failed_jmp()), 5, cmd_d(l_failed_jmp()), ca(l_loop())) { asm_jump_lands_back(cmd_labels(), l_failed_jmp(), 5, ca(l_loop()), refl) }
theorem cmd_j_named_je(): JumpsForward(ca(l_named_je()), 6, cmd_d(l_named_je()), ca(l_unnamed())) { asm_jump_lands(cmd_labels(), l_named_je(), 6, ca(l_unnamed()), refl) }
theorem cmd_j_len_je(): JumpsForward(ca(l_len_je()), 6, cmd_d(l_len_je()), ca(l_found())) { asm_jump_lands(cmd_labels(), l_len_je(), 6, ca(l_found()), refl) }
theorem cmd_j_len_jmp(): JumpsBack(ca(l_len_jmp()), 5, cmd_d(l_len_jmp()), ca(l_len_load())) { asm_jump_lands_back(cmd_labels(), l_len_jmp(), 5, ca(l_len_load()), refl) }
theorem cmd_j_closes_je(): JumpsBack(ca(l_closes_je()), 6, cmd_d(l_closes_je()), ca(l_loop())) { asm_jump_lands_back(cmd_labels(), l_closes_je(), 6, ca(l_loop()), refl) }
theorem cmd_j_close_js(): JumpsBack(ca(l_close_js()), 6, cmd_d(l_close_js()), ca(l_failed())) { asm_jump_lands_back(cmd_labels(), l_close_js(), 6, ca(l_failed()), refl) }
theorem cmd_j_close_jmp(): JumpsBack(ca(l_close_jmp()), 5, cmd_d(l_close_jmp()), ca(l_loop())) { asm_jump_lands_back(cmd_labels(), l_close_jmp(), 5, ca(l_loop()), refl) }
theorem cmd_j_total_jb(): JumpsForward(ca(l_total_jb()), 6, cmd_d(l_total_jb()), ca(l_exit())) { asm_jump_lands(cmd_labels(), l_total_jb(), 6, ca(l_exit()), refl) }
theorem cmd_j_retry_jz(): JumpsForward(ca(l_retry_jz()), 6, cmd_d(l_retry_jz()), ca(l_head())) { asm_jump_lands(cmd_labels(), l_retry_jz(), 6, ca(l_head()), refl) }
theorem cmd_j_rfail_jmp(): JumpsBack(ca(l_rfail_jmp()), 5, cmd_d(l_rfail_jmp()), ca(l_spill())) { asm_jump_lands_back(cmd_labels(), l_rfail_jmp(), 5, ca(l_spill()), refl) }
theorem cmd_j_head_ed(): JumpsBack(rh_at_jz(FdIn(Rsp), ca(l_head())), 6, cmd_ed(), ca(l_spill())) { asm_lands_back(rh_at_jz(FdIn(Rsp), ca(l_head())), 6, cmd_ed(), ca(l_spill()), refl) }
theorem cmd_j_head_sd(): JumpsBack(rh_at_js(FdIn(Rsp), ca(l_head())), 6, cmd_sd(), ca(l_read_failed())) { asm_lands_back(rh_at_js(FdIn(Rsp), ca(l_head())), 6, cmd_sd(), ca(l_read_failed()), refl) }
// The chunk loop starts where the read head ends.
theorem cmd_core_from_head(): eof_rip(rh_at_end(FdIn(Rsp), ca(l_head()))) = eof_rip(ca(l_core())) {
    cong_fn<Nat, BitVec(64)>(λ a => eof_rip(a), asm_same_eq(rh_at_end(FdIn(Rsp), ca(l_head())), ca(l_core()), refl))
}
theorem pj_counts_done(): JumpsForward(wl_at_wjz(ca(l_gap_write())), 6, pj_counts().zd, ca(l_nm())) { asm_lands_forward(wl_at_wjz(ca(l_gap_write())), 6, pj_counts().zd, ca(l_nm()), refl) }
theorem pj_name_done(): JumpsForward(wl_at_wjz(ca(l_name_write())), 6, pj_name().zd, ca(l_nl())) { asm_lands_forward(wl_at_wjz(ca(l_name_write())), 6, pj_name().zd, ca(l_nl()), refl) }
theorem pj_newline_done(): JumpsForward(wl_at_wjz(ca(l_nl_write())), 6, pj_newline().zd, ca(l_closes())) { asm_lands_forward(wl_at_wjz(ca(l_nl_write())), 6, pj_newline().zd, ca(l_closes()), refl) }
theorem pj_stdin_done(): JumpsForward(wl_at_wjz(ca(l_unnamed_write())), 6, pj_stdin().zd, ca(l_exit())) { asm_lands_forward(wl_at_wjz(ca(l_unnamed_write())), 6, pj_stdin().zd, ca(l_exit()), refl) }
theorem pj_total_done(): JumpsForward(wl_at_wjz(ca(l_total_write())), 6, pj_total().zd, ca(l_exit())) { asm_lands_forward(wl_at_wjz(ca(l_total_write())), 6, pj_total().zd, ca(l_exit()), refl) }

// ---------------------------------------------------------------------------
// The items, wherever the frame and the page are.

fn CommandPlaced(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps) → Type {
    (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), command_code(letters, default, spill, code, jumps, pj), io_entry())
}
// The item at each label, resident at the label; the chunk loop at `l_core`.
fn CmdAt(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg) → Type {
    (l: Prog) → Placed(file, item_bytes(cmd_fills(letters, default, spill), cmd_labels(), asm_find(cmd_prog(), l)), eof_rip(ca(asm_find(cmd_prog(), l))))
}
theorem cmd_at(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: Placed(file, command_code(letters, default, spill, code, jumps, pj), io_entry())):
    CmdAt(file, letters, default, spill) {
    λ l page => asm_resident(io_fetch_access(), IoMemory(file, page), io_entry(), cmd_fills(letters, default, spill), cmd_labels(), cmd_prog(),
        cmd_fits(letters, default, spill), filter_core_code(code, jumps, pj), placed(page), l)
}
theorem cmd_core_at(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: Placed(file, command_code(letters, default, spill, code, jumps, pj), io_entry())):
    Placed(file, filter_core_code(code, jumps, pj), eof_rip(ca(l_core()))) {
    λ page => asm_last_resident(io_fetch_access(), IoMemory(file, page), io_entry(), cmd_fills(letters, default, spill), cmd_labels(), cmd_prog(),
        cmd_fits(letters, default, spill), filter_core_code(code, jumps, pj), placed(page))
}

// A stretch of the command run by computation (elf64_straight): the `n`
// items ending at label `l`, from a framed state where the first starts.
// `at` (`refl`) says `l` is the program's: the kernel finds it, so the
// elaborator never walks the program for it.
theorem cmd_straight(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj), page: Nat → BitVec(8),
    goal: MachineState<IoMemory> → Type, back: StepsBack(goal), l: Prog, at: asm_find(cmd_prog(), l) = l, n: Nat, vars: Nat → BitVec(64),
    state: MachineState<IoMemory>, rip: state.rip = eof_rip(straight_from(l, n)), framed: Framed(file, page, vars)(state),
    held: Straight(file, page, io_entry(), goal, cmd_labels(), l, n)(vars, state)): goal(state) {
    let k = prog_depth(cmd_prog()) -prog_depth(l);
    let fills = cmd_fills(letters, default, spill);
    let front = asm_code(fills, cmd_labels(), asm_back(cmd_prog(), k));
    let after = asm_code_after(fills, cmd_labels(), cmd_prog(), k);
    let core = filter_core_code(code, jumps, pj);
    straight_runs(file, page, io_entry(), goal, back, fills, cmd_labels(), l, n,
        j(at, λ x _ => FillsFit(x, fills), fills_fit_back(fills, k, cmd_prog(), cmd_fits(letters, default, spill))), after ++ core,
        λ frame => j(at, λ x _ => Placed(with_frame(file, frame), asm_code(fills, cmd_labels(), x) ++ (after ++ core), io_entry()),
            j(trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ c => c ++ core, asm_code_back(fills, cmd_labels(), k, cmd_prog())),
                List::append_assoc(front, after, core)), λ c _ => Placed(with_frame(file, frame), c, io_entry()), placed(frame))),
        vars, state, rip, framed, held)
}

// A jump's landing as a straight stretch spells its leaf (`straight_item`):
// at the offset of the label before it, by its target's name. The landing
// facts (`cmd_j_*`) spell it by the jump's own label; the elaborator meets
// the two here, once per fact, and not where a stretch's leaf meets it.
theorem cmd_lands(before: Prog, size, target, to: Nat,
    lands: JumpsForward(prog_len(before), size, near_rel(prog_len(before) + size, cmd_labels()(target)), to)):
    near_branch_target(next_rip(io_entry(), prog_len(before)), size, near_rel(prog_len(before) + size, cmd_labels()(target))) = next_rip(io_entry(), to) {
    jumps_forward(io_entry(), prog_len(before), size, near_rel(prog_len(before) + size, cmd_labels()(target)), to, lands)
}
theorem cmd_lands_back(before: Prog, size, target, to: Nat,
    lands: JumpsBack(prog_len(before), size, near_rel(prog_len(before) + size, cmd_labels()(target)), to)):
    near_branch_target(next_rip(io_entry(), prog_len(before)), size, near_rel(prog_len(before) + size, cmd_labels()(target))) = next_rip(io_entry(), to) {
    jumps_back(io_entry(), prog_len(before), size, near_rel(prog_len(before) + size, cmd_labels()(target)), to, lands)
}
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// The frame's slots, loaded and stored from placed code.

fn stored_frame(file: IoImage, frame: Nat → BitVec(8), q: Nat, w: BitVec(64)) → Nat → BitVec(8) {
    frame_stored(with_frame(file, frame), 8 * q, w).frame
}
fn slot_block(q: Nat) → List<Instruction> { [MovRI(R11, slot_at(q))] }
fn slot_store_after(source: Gpr, q: Nat, state: MachineState<IoMemory>) → MachineState<IoMemory> {
    word_store_after(linux_writes(io_linux()), WordStore(base := R11, source := source), execute_block_normal(slot_block(q), state))
}
fn slot_load_after(destination: Gpr, w: BitVec(64), q: Nat, state: MachineState<IoMemory>) → MachineState<IoMemory> {
    word_load_after(WordLoad(destination := destination, base := R11), w, execute_block_normal(slot_block(q), state))
}

// R11 := the slot's address, then the source's word stored there: the slot
// set, every other kept.
record SlotStored(file: IoImage, frame: Nat → BitVec(8), vars: Nat → BitVec(64), q: Nat, w: BitVec(64), page: Nat → BitVec(8),
    before, after: MachineState<IoMemory>, to: Nat) {
    steps: LinuxSteps(io_linux(), before, after),
    memory_is: after.memory = IoMemory(with_frame(file, stored_frame(file, frame, q, w)), page),
    rip_is: after.rip = eof_rip(to),
    holds: FrameHolds(stored_frame(file, frame, q, w), set_var(vars, q, w)),
}
theorem run_slot_store(file: IoImage, frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars),
    page: Nat → BitVec(8), k, q: Nat, inside: q < frame_slots(), source: Gpr,
    block: Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    store: Placed(with_frame(file, frame), word_store_bytes(WordStore(base := R11, source := source)), eof_rip(k + 10)),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page), rip_is: state.rip = eof_rip(k)):
    SlotStored(file, frame, vars, q, read_gpr(source, execute_block_normal(slot_block(q), state).gprs), page, state,
        slot_store_after(source, q, state), (k + 10) + 3) {
    let img = with_frame(file, frame);
    let set = run_block(img, page, slot_block(q), io_entry(), k, block, state, memory_is, rip_is);
    let s1 = execute_block_normal(slot_block(q), state);
    let stored = run_frame_store(img, page, WordStore(base := R11, source := source), refl, io_entry(), k + 10, store, 8 * q, { omega },
        s1, set.memory_is, set.rip_is, refl);
    SlotStored(
        steps := linux_steps_trans(io_linux(), state, s1, slot_store_after(source, q, state), linux_steps_of_fetched(io_linux(), state, s1, set.steps),
            stored.step),
        memory_is := stored.memory_is,
        rip_is := stored.rip_is,
        holds := frame_holds_store(img, vars, q, read_gpr(source, s1.gprs), holds))
}
// R11 := the slot's address, then its word loaded.
theorem run_slot_load(file: IoImage, frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars),
    page: Nat → BitVec(8), k, q: Nat, inside: q < frame_slots(), destination: Gpr,
    block: Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    load: Placed(with_frame(file, frame), word_load_bytes(WordLoad(destination := destination, base := R11)), eof_rip(k + 10)),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page), rip_is: state.rip = eof_rip(k)):
    Ran(with_frame(file, frame), page, state, slot_load_after(destination, vars(q), q, state), eof_rip((k + 10) + 3)) {
    let img = with_frame(file, frame);
    let set = run_block(img, page, slot_block(q), io_entry(), k, block, state, memory_is, rip_is);
    let s1 = execute_block_normal(slot_block(q), state);
    let loaded = run_word_load(img, page, WordLoad(destination := destination, base := R11), io_entry(), k + 10, load, s1, set.memory_is, set.rip_is,
        vars(q), frame_var_at(img, page, vars, holds, q, inside));
    Ran(steps := fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, slot_load_after(destination, vars(q), q, state), set.steps,
            loaded.steps),
        memory_is := loaded.memory_is, rip_is := loaded.rip_is)
}

// The same over `Runs`, over a `Framed` state (elf64_straight).
theorem runs_slot_store(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), k, q: Nat, inside: q < frame_slots(), source: Gpr,
    block: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    store: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), word_store_bytes(WordStore(base := R11, source := source)), eof_rip(k + 10)),
    p, r: MachineState<IoMemory> → Type, framed: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(state),
    post: (state: MachineState<IoMemory>) → p(state) →
        Framed(file, page, set_var(vars, q, read_gpr(source, execute_block_normal(slot_block(q), state).gprs)))(slot_store_after(source, q, state)) →
        r(slot_store_after(source, q, state))): Runs(p, eof_rip(k), r, eof_rip((k + 10) + 3)) {
    λ state rip_is holds => {
        let at = framed(state, holds);
        let stored = run_slot_store(file, at.witness, vars, at.proof.right, page, k, q, inside, source, block(at.witness), store(at.witness), state,
            at.proof.left, rip_is);
        Exists(slot_store_after(source, q, state), ⟨stored.steps, ⟨stored.rip_is,
            post(state, holds, Exists(stored_frame(file, at.witness, q, read_gpr(source, execute_block_normal(slot_block(q), state).gprs)),
                ⟨stored.memory_is, stored.holds⟩))⟩⟩)
    }
}
theorem runs_slot_load(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), k, q: Nat, inside: q < frame_slots(), destination: Gpr,
    block: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    load: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), word_load_bytes(WordLoad(destination := destination, base := R11)), eof_rip(k + 10)),
    p, r: MachineState<IoMemory> → Type, framed: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(state),
    post: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(slot_load_after(destination, vars(q), q, state)) →
        r(slot_load_after(destination, vars(q), q, state))): Runs(p, eof_rip(k), r, eof_rip((k + 10) + 3)) {
    λ state rip_is holds => {
        let at = framed(state, holds);
        let loaded = run_slot_load(file, at.witness, vars, at.proof.right, page, k, q, inside, destination, block(at.witness), load(at.witness), state,
            at.proof.left, rip_is);
        Exists(slot_load_after(destination, vars(q), q, state), ⟨linux_steps_of_fetched(io_linux(), state, slot_load_after(destination, vars(q), q, state),
            loaded.steps), ⟨loaded.rip_is, post(state, holds, Exists(at.witness, ⟨loaded.memory_is, at.proof.right⟩))⟩⟩)
    }
}

// A word stored from `source` at R11, which holds slot `q`'s address.
theorem runs_frame_store(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), k, q: Nat, inside: q < frame_slots(), source: Gpr,
    store: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), word_store_bytes(WordStore(base := R11, source := source)), eof_rip(k)),
    p, r: MachineState<IoMemory> → Type, framed: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(state),
    base: (state: MachineState<IoMemory>) → p(state) → read_gpr(R11, state.gprs) = slot_at(q),
    post: (state: MachineState<IoMemory>) → p(state) →
        Framed(file, page, set_var(vars, q, read_gpr(source, state.gprs)))(word_store_after(linux_writes(io_linux()), WordStore(base := R11, source := source), state)) →
        r(word_store_after(linux_writes(io_linux()), WordStore(base := R11, source := source), state))): Runs(p, eof_rip(k), r, eof_rip(k + 3)) {
    λ state rip_is holds => {
        let at = framed(state, holds);
        let img = with_frame(file, at.witness);
        let stored = run_frame_store(img, page, WordStore(base := R11, source := source), refl, io_entry(), k, store(at.witness), 8 * q, { omega },
            state, at.proof.left, rip_is, base(state, holds));
        Exists(word_store_after(linux_writes(io_linux()), WordStore(base := R11, source := source), state), ⟨stored.step, ⟨stored.rip_is,
            post(state, holds, Exists(stored_frame(file, at.witness, q, read_gpr(source, state.gprs)),
                ⟨stored.memory_is, frame_holds_store(img, vars, q, read_gpr(source, state.gprs), at.proof.right)⟩))⟩⟩)
    }
}

// A word loaded into `destination` from R11, which holds slot `q`'s address.
theorem runs_frame_load(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), k, q: Nat, inside: q < frame_slots(), destination: Gpr,
    load: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), word_load_bytes(WordLoad(destination := destination, base := R11)), eof_rip(k)),
    p, r: MachineState<IoMemory> → Type, framed: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(state),
    base: (state: MachineState<IoMemory>) → p(state) → read_gpr(R11, state.gprs) = slot_at(q),
    post: (state: MachineState<IoMemory>) → p(state) →
        Framed(file, page, vars)(word_load_after(WordLoad(destination := destination, base := R11), vars(q), state)) →
        r(word_load_after(WordLoad(destination := destination, base := R11), vars(q), state))): Runs(p, eof_rip(k), r, eof_rip(k + 3)) {
    λ state rip_is holds => {
        let at = framed(state, holds);
        let img = with_frame(file, at.witness);
        let loaded = run_word_load(img, page, WordLoad(destination := destination, base := R11), io_entry(), k, load(at.witness), state, at.proof.left,
            rip_is, vars(q), j(sym(base(state, holds)), λ a _ => WordAt(io_data_access(), IoMemory(img, page), a, vars(q)),
                frame_var_at(img, page, vars, at.proof.right, q, inside)));
        let after = word_load_after(WordLoad(destination := destination, base := R11), vars(q), state);
        Exists(after, ⟨linux_steps_of_fetched(io_linux(), state, after, loaded.steps), ⟨loaded.rip_is,
            post(state, holds, Exists(at.witness, ⟨loaded.memory_is, at.proof.right⟩))⟩⟩)
    }
}

// ---------------------------------------------------------------------------
// What the slots hold between phases: the selection, the width, the status,
// the operand count and the totals.

record Vars(vars: Nat → BitVec(64), mask: BitVec(64), width, n: Nat, failed: Bool, totals: Nat → BitVec(64)) {
    mask_is: vars(16) = mask,
    width_is: vars(17) = word_of_nat(64, width),
    status_is: vars(18) = status_word(failed),
    count_is: vars(21) = word_of_nat(64, n),
    totals_is: (i: Nat) → i < 8 → vars(8 + i) = totals(i),
}
theorem set_var_same(vars: Nat → BitVec(64), q: Nat, w: BitVec(64)): set_var(vars, q, w)(q) = w {
    match Nat::eq_dec(q, q) as λ d => (match d { Inl(_) => w, Inr(_) => vars(q) }) = w {
        Inl(_) => refl,
        Inr(no) => false_elim(no(refl)),
    }
}
theorem set_var_other(vars: Nat → BitVec(64), q: Nat, w: BitVec(64), i: Nat, other: Not(i = q)): set_var(vars, q, w)(i) = vars(i) {
    match Nat::eq_dec(i, q) as λ d => (match d { Inl(_) => w, Inr(_) => vars(i) }) = vars(i) {
        Inl(same) => false_elim(other(same)),
        Inr(_) => refl,
    }
}

// ---------------------------------------------------------------------------
// The exit: the status's slot into RDI, exit(RDI).

theorem exit_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), status: BitVec(64), status_is: vars(18) = status,
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_exit()))): LinuxRuns(io_linux(), [ExitEvent(status)], state) {
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let loaded = run_slot_load(file, frame, vars, holds, page, ca(l_exit()), 18, { omega }, Rdi, pieces(l_exit()), pieces(l_exit_load()), state,
        memory_is, rip_is);
    let s1 = slot_load_after(Rdi, vars(18), 18, state);
    let numbered = run_block(img, page, [MovRI(Rax, BitVec::ofNat(60))], io_entry(), ca(l_exit_num()), pieces(l_exit_num()), s1, loaded.memory_is,
        loaded.rip_is);
    let s2 = execute_block_normal([MovRI(Rax, BitVec::ofNat(60))], s1);
    linux_runs_exit(io_linux(), state, s2, status,
        fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2, loaded.steps, numbered.steps),
        syscall_placed(img, page, io_entry(), ca(l_exit_call()), pieces(l_exit_call()), s2, numbered.memory_is, numbered.rip_is),
        refl, status_is)
}

// ---------------------------------------------------------------------------
// Rows: the counts from the frame's slots, a row no longer than its eight
// fields, and bytes put one at a time after it.

theorem slots_counts(file: IoImage, frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), b: Nat,
    inside: b + 8 <= frame_slots(), counts: Nat → BitVec(64), same: (i: Nat) → i < 8 → vars(b + i) = counts(i)):
    CountsAt(with_frame(file, frame), slot_at(b), counts) {
    λ page i below => {
        let start = frame_value(8 * b, { omega });
        let place: (slot_at(b).toNat() + 8 * i = io_frame_base() + 8 * (b + i)) = omega;
        let address: (argv_slot(slot_at(b), i) = frame_at(8 * (b + i))) =
            trans(cong_fn<Nat, BitVec(64)>(λ a => word_of_nat(64, a), place), frame_counted(8 * (b + i), { omega }));
        let word = frame_var_at(with_frame(file, frame), page, vars, holds, b + i, { omega });
        j(sym(address), λ a _ => WordAt(io_data_access(), IoMemory(with_frame(file, frame), page), a, counts(i)),
            j(same(i, below), λ v _ => WordAt(io_data_access(), IoMemory(with_frame(file, frame), page), frame_at(8 * (b + i)), v), word))
    }
}

fn row_room(width, k: Nat) → Nat { match k { Zero => 0, Succ(m) => (width + 21) + row_room(width, m) } }
theorem row_fields_le(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), k: Nat):
    (first: Bool) → (i: Nat) → row_fields(width, mask, counts, first, i, k).len() <= row_room(width, k) {
    match k as λ m => (first: Bool) → (i: Nat) → row_fields(width, mask, counts, first, i, m).len() <= row_room(width, m) {
        Zero => λ first i => { omega },
        Succ(m) => λ first i => {
            let field = slot_field(width, mask, counts, first, i);
            let later = row_fields(width, mask, counts, first_after(mask, first, i), Succ(i), m);
            let short = slot_field_le(width, mask, counts, first, i);
            let rest = row_fields_le(width, mask, counts, m, first_after(mask, first, i), Succ(i));
            let both = List::len_append(field, later);
            let sum: ((field ++ later).len() <= (width + 21) + row_room(width, m)) = omega;
            j(sym(row_unfold(width, mask, counts, first, i, m)), λ l _ => l.len() <= (width + 21) + row_room(width, m), sum)
        },
    }
}
theorem row_counts_le(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64)): row_counts(width, mask, counts).len() <= 8 * (width + 21) {
    let fields = row_fields_le(width, mask, counts, 8, True, 0);
    let rooms: (row_room(width, 8) = (width + 21) + ((width + 21) + ((width + 21) + ((width + 21) + ((width + 21) + ((width + 21) +
        ((width + 21) + ((width + 21) + 0)))))))) = refl;
    omega
}

// At `k`, `bytes` stored from `o`, RDI past them.
record Put(file: IoImage, page0: Nat → BitVec(8), o: Nat, bytes: List<BitVec(8)>, k: Nat, state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = eof_rip(k),
    holds: PageNext(page0, page, o, bytes),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (o + bytes.len()),
}
fn put_after(w: BitVec(64), state: MachineState<IoMemory>) → MachineState<IoMemory> {
    execute_block_normal([AddRI8(Rdi, one_byte())], byte_store_after(linux_writes(io_linux()), ByteStore(base := Rdi, source := R11),
        execute_block_normal([MovRI(R11, w)], state)))
}
theorem put_grown(base, o, b, f, p, t, q: Nat, l1: b = f + p, l2: t = f + q, l3: q = p + 1): Succ(base + (o + b)) = base + (o + t) { omega }
// R11 := the byte, stored at RDI, RDI on by one.
theorem put_byte(file: IoImage, page0: Nat → BitVec(8), o: Nat, front, prefix: List<BitVec(8)>, k: Nat, w: BitVec(64), x: BitVec(8),
    low: imm_byte0(w) = x,
    set: Placed(file, canonical_block_bytes([MovRI(R11, w)]), eof_rip(k)),
    store: Placed(file, byte_store_bytes(ByteStore(base := Rdi, source := R11)), eof_rip(k + 10)),
    step: Placed(file, canonical_block_bytes([AddRI8(Rdi, one_byte())]), eof_rip((k + 10) + 3)),
    state: MachineState<IoMemory>, head: Put(file, page0, o, front ++ prefix, k, state), room: o + (front ++ prefix).len() < 4096):
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧ Put(file, page0, o, front ++ (prefix ++ [x]), ((k + 10) + 3) + 4, after)) {
    let io = io_linux();
    let bytes = front ++ prefix;
    let c = o + bytes.len();
    let s1 = execute_block_normal([MovRI(R11, w)], state);
    let ran1 = run_block(file, head.page, [MovRI(R11, w)], io_entry(), k, set, state, head.memory_is, head.rip_is);
    let stored = run_store(file, head.page, ByteStore(base := Rdi, source := R11), refl, io_entry(), k + 10, store, c, room, x, s1,
        ran1.memory_is, ran1.rip_is, head.rdi, low);
    let s2 = byte_store_after(linux_writes(io), ByteStore(base := Rdi, source := R11), s1);
    let next = io_store_offset(IoMemory(file, head.page), c, [x]).page;
    let ran3 = run_block(file, next, [AddRI8(Rdi, one_byte())], io_entry(), (k + 10) + 3, step, s2, stored.memory_is, stored.rip_is);
    let paged = page_next(file, page0, head.page, o, bytes, x, head.holds.held, head.holds.below, head.holds.above);
    let moved = List::append_assoc(front, prefix, [x]);
    let page_low: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    let one = add_one_value(read_gpr(Rdi, s2.gprs), io_page_base() + c, head.rdi, { omega });
    let l1: (bytes.len() = front.len() + prefix.len()) = List::len_append(front, prefix);
    let l2: ((front ++ (prefix ++ [x])).len() = front.len() + (prefix ++ [x]).len()) = List::len_append(front, prefix ++ [x]);
    let l3: ((prefix ++ [x]).len() = prefix.len() + 1) = List::len_append(prefix, [x]);
    let grown = put_grown(io_page_base(), o, bytes.len(), front.len(), prefix.len(), (front ++ (prefix ++ [x])).len(), (prefix ++ [x]).len(),
        l1, l2, l3);
    let rdi: (read_gpr(Rdi, put_after(w, state).gprs).toNat() = io_page_base() + (o + (front ++ (prefix ++ [x])).len())) = trans(one, grown);
    Exists(put_after(w, state), ⟨linux_steps_trans(io, state, s2, put_after(w, state),
        linux_steps_trans(io, state, s1, s2, linux_steps_of_fetched(io, state, s1, ran1.steps), stored.step),
        linux_steps_of_fetched(io, s2, put_after(w, state), ran3.steps)),
     Put(page := next, memory_is := ran3.memory_is, rip_is := ran3.rip_is,
        holds := j(moved, λ bs _ => PageNext(page0, next, o, bs), PageNext(held := paged.held, below := paged.below, above := paged.above)),
        rdi := rdi)⟩)
}

// ---------------------------------------------------------------------------
// A write of `bytes` from the loop at `at`, all sent going on at `done`.

theorem mem_write(file: IoImage, page: Nat → BitVec(8), at, done: Nat, pj: PrintJumps, placed: Placed(file, write_loop_code(pj), eof_rip(at)),
    facts: WriteJumpFacts(pj), lands: JumpsForward(wl_at_wjz(at), 6, pj.zd, done),
    bytes: List<BitVec(8)>, write: RowWrite, ok: RowWriteOk(bytes, write), some: 0 < bytes.len(), fits: bytes.len() <= 4096,
    after: List<LinuxEvent>, origin: Gprs, then: WriteThen(IoMemory(file, page), done, after, origin),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = eof_rip(at),
    sends: LinuxWritesFrom(io_linux(), IoMemory(file, page), read_gpr(R9, state.gprs), bytes),
    room: read_gpr(R9, state.gprs).toNat() + bytes.len() < Nat::pow(2, 64),
    r10: read_gpr(R10, state.gprs).toNat() = bytes.len(), kept: WriteKept(state.gprs, origin)):
    LinuxRuns(io_linux(), write_events_then(bytes, write.steps, write.ending, after), state) {
    let memory = IoMemory(file, page);
    let pieces = write_loop_resident(memory, at, pj, placed(page));
    let targets = write_targets_to(at, done, pj, facts, jumps_forward(io_entry(), wl_at_wjz(at), 6, pj.zd, done, lands));
    wl_from_then(memory, at, pj, done, pieces, targets, after, write.ending, ok.right, origin,
        finished_then(write.ending, memory, done, after, origin, then), write.steps)(bytes, ok.left, state, some, fits, rip_is, memory_is,
        sends, r10, room, kept)
}
// The same from the page's start.
theorem page_write(file: IoImage, page: Nat → BitVec(8), at, done: Nat, pj: PrintJumps, placed: Placed(file, write_loop_code(pj), eof_rip(at)),
    facts: WriteJumpFacts(pj), lands: JumpsForward(wl_at_wjz(at), 6, pj.zd, done),
    bytes: List<BitVec(8)>, write: RowWrite, ok: RowWriteOk(bytes, write), some: 0 < bytes.len(), fits: bytes.len() <= 4096,
    after: List<LinuxEvent>, origin: Gprs, then: WriteThen(IoMemory(file, page), done, after, origin),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = eof_rip(at),
    held: Stored(page, 0, bytes), r9: read_gpr(R9, state.gprs) = page_word(),
    r10: read_gpr(R10, state.gprs).toNat() = bytes.len(), kept: WriteKept(state.gprs, origin)):
    LinuxRuns(io_linux(), write_events_then(bytes, write.steps, write.ending, after), state) {
    let base: (read_gpr(R9, state.gprs).toNat() = io_page_base() + 0) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), r9), page_word_value());
    let page_low: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    mem_write(file, page, at, done, pj, placed, facts, lands, bytes, write, ok, some, fits, after, origin, then, state, memory_is, rip_is,
        stored_sends(IoMemory(file, page), 0, bytes, held, read_gpr(R9, state.gprs), base, { omega }), { omega }, r10, kept)
}
// R9 := the page, R10 := RDI - R9: the length of what is stored from the
// page's start.
fn length_block() → List<Instruction> { [MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)] }
theorem length_r10(state: MachineState<IoMemory>, o: Nat, rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + o):
    read_gpr(R10, execute_block_normal(length_block(), state).gprs).toNat() = o {
    let base: (page_word().toNat() = io_page_base()) = { let v = page_word_value(); omega };
    filter_out_len(read_gpr(Rdi, state.gprs), page_word(), o, rdi, base)
}

// ---------------------------------------------------------------------------
// After the last operand (`l_total`): with two or more, the totals' row and
// " total", then the exit.

theorem total_events_few(mask: BitVec(64), width, n: Nat, total: RowWrite, failed: Bool, totals: Nat → BitVec(64),
    few: Nat::leb(2, n) = False): total_events(mask, width, n, total, failed, totals) = [ExitEvent(status_word(failed))] {
    j(sym(few), λ b _ => (match b {
            True => write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]),
            False => [ExitEvent(status_word(failed))],
        }) = [ExitEvent(status_word(failed))], refl)
}
theorem total_events_many(mask: BitVec(64), width, n: Nat, total: RowWrite, failed: Bool, totals: Nat → BitVec(64),
    many: Nat::leb(2, n) = True): total_events(mask, width, n, total, failed, totals) =
        write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]) {
    j(sym(many), λ b _ => (match b {
            True => write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]),
            False => [ExitEvent(status_word(failed))],
        }) = write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]),
        refl)
}
fn TotalOk(mask: BitVec(64), width, n: Nat, total: RowWrite, totals: Nat → BitVec(64)) → Type {
    match Nat::leb(2, n) as λ _ => Type { True => RowWriteOk(row_counts(width, mask, totals) ++ total_name(), total), False => True }
}
theorem total_ok_many(mask: BitVec(64), width, n: Nat, total: RowWrite, totals: Nat → BitVec(64), many: Nat::leb(2, n) = True,
    ok: TotalOk(mask, width, n, total, totals)): RowWriteOk(row_counts(width, mask, totals) ++ total_name(), total) {
    j(many, λ b _ => match b as λ _ => Type { True => RowWriteOk(row_counts(width, mask, totals) ++ total_name(), total), False => True }, ok)
}

// The row, then " total\n" (`l_tn0` on): seven bytes put, the length, the write,
// then the exit.
theorem drop_zero(a, base, t: Nat, h: a = base + (0 + t)): a = base + t { omega }
theorem tail_room(r, t, k: Nat, len: t = r + k, short: r <= 4000, small: Nat::leb(k, 7).IsTrue()): 0 + t < 4096 {
    let few: (k <= 7) = Nat::leb_sound(k, 7, small);
    omega
}
// The total row's " total\n", stored after its counts, in two halves.
fn PutReach(file: IoImage, page0: Nat → BitVec(8), bytes: List<BitVec(8)>, k: Nat, state: MachineState<IoMemory>) → Type {
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧ Put(file, page0, 0, bytes, k, after))
}
fn tname_front() → List<BitVec(8)> { [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111), BitVec::ofNat(116)] }
theorem tname_first(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj), frame: Nat → BitVec(8),
    row: List<BitVec(8)>, short: row.len() <= 4000, page0: Nat → BitVec(8), state: MachineState<IoMemory>,
    head: Put(with_frame(file, frame), page0, 0, row ++ Nil, ca(l_tn0()), state)):
    PutReach(with_frame(file, frame), page0, row ++ tname_front(), ca(l_tn4()), state) {
    let io = io_linux();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let l0: ((row ++ Nil).len() = row.len() + 0) = List::len_append(row, Nil);
    have b1 = put_byte(img, page0, 0, row, Nil, ca(l_tn0()), BitVec::ofNat(32), field_gap(), refl, pieces(l_tn0()), pieces(l_tn0_store()), pieces(l_tn0_step()),
        state, head, tail_room(row.len(), (row ++ Nil).len(), 0, l0, short, trivial));
    let p1: List<BitVec(8)> = [field_gap()];
    let l1: ((row ++ p1).len() = row.len() + 1) = List::len_append(row, p1);
    have b2 = put_byte(img, page0, 0, row, p1, ca(l_tn1()), BitVec::ofNat(116), BitVec::ofNat(116), refl, pieces(l_tn1()),
        pieces(l_tn1_store()), pieces(l_tn1_step()), b1.witness, b1.proof.right, tail_room(row.len(), (row ++ p1).len(), 1, l1, short, trivial));
    let p2: List<BitVec(8)> = [field_gap(), BitVec::ofNat(116)];
    let l2: ((row ++ p2).len() = row.len() + 2) = List::len_append(row, p2);
    have b3 = put_byte(img, page0, 0, row, p2, ca(l_tn2()), BitVec::ofNat(111), BitVec::ofNat(111), refl, pieces(l_tn2()),
        pieces(l_tn2_store()), pieces(l_tn2_step()), b2.witness, b2.proof.right, tail_room(row.len(), (row ++ p2).len(), 2, l2, short, trivial));
    let p3: List<BitVec(8)> = [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111)];
    let l3: ((row ++ p3).len() = row.len() + 3) = List::len_append(row, p3);
    have b4 = put_byte(img, page0, 0, row, p3, ca(l_tn3()), BitVec::ofNat(116), BitVec::ofNat(116), refl, pieces(l_tn3()),
        pieces(l_tn3_store()), pieces(l_tn3_step()), b3.witness, b3.proof.right, tail_room(row.len(), (row ++ p3).len(), 3, l3, short, trivial));
    Exists(b4.witness, ⟨linux_steps_trans(io, state, b1.witness, b4.witness, b1.proof.left,
        linux_steps_trans(io, b1.witness, b2.witness, b4.witness, b2.proof.left, linux_steps_trans(io, b2.witness, b3.witness, b4.witness,
            b3.proof.left, b4.proof.left))), b4.proof.right⟩)
}
theorem tname_second(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj), frame: Nat → BitVec(8),
    row: List<BitVec(8)>, short: row.len() <= 4000, page0: Nat → BitVec(8), state: MachineState<IoMemory>,
    head: Put(with_frame(file, frame), page0, 0, row ++ tname_front(), ca(l_tn4()), state)):
    PutReach(with_frame(file, frame), page0, row ++ total_name(), ca(l_tlen()), state) {
    let io = io_linux();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let p4: List<BitVec(8)> = [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111), BitVec::ofNat(116)];
    let l4: ((row ++ p4).len() = row.len() + 4) = List::len_append(row, p4);
    have b5 = put_byte(img, page0, 0, row, p4, ca(l_tn4()), BitVec::ofNat(97), BitVec::ofNat(97), refl, pieces(l_tn4()),
        pieces(l_tn4_store()), pieces(l_tn4_step()), state, head, tail_room(row.len(), (row ++ p4).len(), 4, l4, short, trivial));
    let p5: List<BitVec(8)> = [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111), BitVec::ofNat(116), BitVec::ofNat(97)];
    let l5: ((row ++ p5).len() = row.len() + 5) = List::len_append(row, p5);
    have b6 = put_byte(img, page0, 0, row, p5, ca(l_tn5()), BitVec::ofNat(108), BitVec::ofNat(108), refl, pieces(l_tn5()),
        pieces(l_tn5_store()), pieces(l_tn5_step()), b5.witness, b5.proof.right, tail_room(row.len(), (row ++ p5).len(), 5, l5, short, trivial));
    let p6: List<BitVec(8)> = [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111), BitVec::ofNat(116), BitVec::ofNat(97), BitVec::ofNat(108)];
    let l6: ((row ++ p6).len() = row.len() + 6) = List::len_append(row, p6);
    have b7 = put_byte(img, page0, 0, row, p6, ca(l_tn6()), BitVec::ofNat(10), newline(), refl, pieces(l_tn6()),
        pieces(l_tn6_store()), pieces(l_tn6_step()), b6.witness, b6.proof.right, tail_room(row.len(), (row ++ p6).len(), 6, l6, short, trivial));
    Exists(b7.witness, ⟨linux_steps_trans(io, state, b5.witness, b7.witness, b5.proof.left,
        linux_steps_trans(io, b5.witness, b6.witness, b7.witness, b6.proof.left, b7.proof.left)), b7.proof.right⟩)
}
theorem total_tail(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), status: BitVec(64), status_is: vars(18) = status,
    row: List<BitVec(8)>, short: row.len() <= 4000, total: RowWrite, ok: RowWriteOk(row ++ total_name(), total),
    page0: Nat → BitVec(8), state: MachineState<IoMemory>, head: Put(with_frame(file, frame), page0, 0, row ++ Nil, ca(l_tn0()), state)):
    LinuxRuns(io_linux(), write_events_then(row ++ total_name(), total.steps, total.ending, [ExitEvent(status)]), state) {
    let io = io_linux();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    have first = tname_first(file, letters, default, spill, code, jumps, pj, placed, frame, row, short, page0, state, head);
    have second = tname_second(file, letters, default, spill, code, jumps, pj, placed, frame, row, short, page0, first.witness, first.proof.right);
    let s7 = second.witness;
    let last = second.proof.right;
    let lengthened = run_block(img, last.page, length_block(), io_entry(), ca(l_tlen()), pieces(l_tlen()), s7, last.memory_is, last.rip_is);
    let s8 = execute_block_normal(length_block(), s7);
    let bytes = row ++ total_name();
    let lb: (bytes.len() = row.len() + 7) = List::len_append(row, total_name());
    let to_s7: LinuxSteps(io, state, s7) = linux_steps_trans(io, state, first.witness, s7, first.proof.left, second.proof.left);
    let exiting: WriteThen(IoMemory(img, last.page), ca(l_exit()), [ExitEvent(status)], s8.gprs) =
        λ st at_exit in_memory _ => exit_runs(file, letters, default, spill, code, jumps, pj, placed, frame, vars, holds,
            status, status_is, last.page, st, in_memory, at_exit);
    let writes = page_write(img, last.page, ca(l_total_write()), ca(l_exit()), pj_total(), pieces(l_total_write()), WriteJumpFacts(refl, refl, refl),
        pj_total_done(), bytes, total, ok, { omega }, { omega }, [ExitEvent(status)], s8.gprs, exiting, s8, lengthened.memory_is,
        lengthened.rip_is, last.holds.held, refl, length_r10(s7, bytes.len(), drop_zero(read_gpr(Rdi, s7.gprs).toNat(), io_page_base(), bytes.len(), last.rdi)), write_kept_refl(s8.gprs));
    linux_runs_after_linux_steps(io, write_events_then(bytes, total.steps, total.ending, [ExitEvent(status)]), state, s7, to_s7,
        linux_runs_after_steps(io, write_events_then(bytes, total.steps, total.ending, [ExitEvent(status)]), s7, s8, lengthened.steps, writes))
}

fn total_setup1() → List<Instruction> { [MovRI(R12, slot_at(8)), MovRI(R11, slot_at(16))] }
fn page_block() → List<Instruction> { [MovRI(Rdi, page_word())] }
fn total_compare() → List<Instruction> { [MovRI(R11, BitVec::ofNat(2)), CmpRR(Rax, R11)] }
// Two or more (`l_tsetup` on): R12 at the totals' slots, R13 the selection, R14
// the width, RDI the page; the row; then the tail.
theorem total_rows(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), width, n: Nat, failed: Bool,
    totals: Nat → BitVec(64), held: Vars(vars, mask, width, n, failed, totals), narrow: width <= 20,
    total: RowWrite, ok: RowWriteOk(row_counts(width, mask, totals) ++ total_name(), total),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_tsetup()))):
    LinuxRuns(io_linux(), write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending,
        [ExitEvent(status_word(failed))]), state) {
    let io = io_linux();
    let row = row_counts(width, mask, totals);
    let events = write_events_then(row ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]);
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let q0 = Framed(file, page, vars);
    let q1 = λ (st: MachineState<IoMemory>) => q0(st) ∧ ((read_gpr(R12, st.gprs) = slot_at(8)) ∧ (read_gpr(R11, st.gprs) = slot_at(16)));
    let q2 = λ (st: MachineState<IoMemory>) => q0(st) ∧ ((read_gpr(R12, st.gprs) = slot_at(8)) ∧ (read_gpr(R13, st.gprs) = vars(16)));
    let q3 = λ (st: MachineState<IoMemory>) => q2(st) ∧ (read_gpr(R11, st.gprs) = slot_at(17));
    let q4 = λ (st: MachineState<IoMemory>) => q2(st) ∧ (read_gpr(R14, st.gprs) = vars(17));
    let q5 = λ (st: MachineState<IoMemory>) => q4(st) ∧ (read_gpr(Rdi, st.gprs) = page_word());
    let setup = runs_seq(q0, eof_rip(ca(l_tsetup())), q1, eof_rip(ca(l_tsetup_mask())), q5, eof_rip(ca(l_total_row())),
        runs_block(total_setup1(), io_entry(), ca(l_tsetup()), q0, q1,
            λ st h => framed_resident(file, page, vars, canonical_block_bytes(total_setup1()), eof_rip(ca(l_tsetup())), here(l_tsetup()), st, h),
            λ st h same => ⟨framed_moved(file, page, vars, execute_block_normal(total_setup1(), st), st, same, h), ⟨refl, refl⟩⟩),
        runs_seq(q1, eof_rip(ca(l_tsetup_mask())), q2, eof_rip(ca(l_tsetup_w())), q5, eof_rip(ca(l_total_row())),
            runs_frame_load(file, page, vars, ca(l_tsetup_mask()), 16, { omega }, R13, here(l_tsetup_mask()), q1, q2, λ _ h => h.left,
                λ _ h => h.right.right, λ st h framed => ⟨framed, ⟨h.right.left, refl⟩⟩),
            runs_seq(q2, eof_rip(ca(l_tsetup_w())), q3, eof_rip(ca(l_tsetup_width())), q5, eof_rip(ca(l_total_row())),
                runs_block(slot_block(17), io_entry(), ca(l_tsetup_w()), q2, q3,
                    λ st h => framed_resident(file, page, vars, canonical_block_bytes(slot_block(17)), eof_rip(ca(l_tsetup_w())), here(l_tsetup_w()), st,
                        h.left),
                    λ st h same => ⟨⟨framed_moved(file, page, vars, execute_block_normal(slot_block(17), st), st, same, h.left), h.right⟩, refl⟩),
                runs_seq(q3, eof_rip(ca(l_tsetup_width())), q4, eof_rip(ca(l_tsetup_page())), q5, eof_rip(ca(l_total_row())),
                    runs_frame_load(file, page, vars, ca(l_tsetup_width()), 17, { omega }, R14, here(l_tsetup_width()), q3, q4,
                        λ _ h => h.left.left, λ _ h => h.right, λ st h framed => ⟨⟨framed, h.left.right⟩, refl⟩),
                    runs_block(page_block(), io_entry(), ca(l_tsetup_page()), q4, q5,
                        λ st h => framed_resident(file, page, vars, canonical_block_bytes(page_block()), eof_rip(ca(l_tsetup_page())),
                            here(l_tsetup_page()), st, h.left.left),
                        λ st h same => ⟨⟨⟨framed_moved(file, page, vars, execute_block_normal(page_block(), st), st, same, h.left.left), h.left.right⟩,
                            h.right⟩, refl⟩)))));
    let w_small: (width < Nat::pow(2, 64)) = { let top: (21 <= Nat::pow(2, 64)) = Nat::leb_sound(21, Nat::pow(2, 64), trivial); omega };
    runs_elim(q0, eof_rip(ca(l_tsetup())), q5, eof_rip(ca(l_total_row())), LinuxRuns(io, events, state), setup, state, rip_is,
        Exists(frame, ⟨memory_is, holds⟩), λ s8 steps8 rip8 at8 => {
            let f8 = at8.left.left.left.witness;
            let framed8 = at8.left.left.left.proof;
            let img = with_frame(file, f8);
            let counts = slots_counts(file, f8, vars, framed8.right, 8, { omega }, totals, held.totals_is);
            have ran = row_runs(img, eof_rip(ca(l_total_row())), here(l_total_row(), f8), page, width, mask, slot_at(8), totals, counts, 0, s8,
                framed8.left, rip8, trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), at8.right), page_word_value()), at8.left.left.right.left,
                trans(at8.left.left.right.right, held.mask_is),
                trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(at8.left.right, held.width_is)), toNat_word_of_nat(64, width, w_small)),
                { omega });
            let s9 = ran.witness;
            let out = ran.proof.right;
            let short_row = row_counts_le(width, mask, totals);
            let p0: Put(img, page, 0, row ++ Nil, ca(l_tn0()), s9) = j(sym(List::append_nil(row)), λ bs _ => Put(img, page, 0, bs, ca(l_tn0()), s9),
                Put(page := out.page, memory_is := out.memory_is, rip_is := trans(out.rip_is, rip_compose(io_entry(), ca(l_total_row()), row_len())),
                    holds := out.holds, rdi := out.rdi));
            linux_runs_after_linux_steps(io, events, state, s9, linux_steps_trans(io, state, s8, s9, steps8, ran.proof.left),
                total_tail(file, letters, default, spill, code, jumps, pj, placed, f8, vars, framed8.right, status_word(failed), held.status_is,
                    row, { omega }, total, ok, page, s9, p0))
        })
}
// After the last operand (`l_total`): with two or more, the totals' row, then
// the exit.
theorem total_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), width, n: Nat, failed: Bool,
    totals: Nat → BitVec(64), held: Vars(vars, mask, width, n, failed, totals), narrow: width <= 20, few: n < Nat::pow(2, 64),
    total: RowWrite, ok: TotalOk(mask, width, n, total, totals),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_total()))): LinuxRuns(io_linux(), total_events(mask, width, n, total, failed, totals), state) {
    let io = io_linux();
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let count = vars(21);
    let two = BitVec::ofNat(2, n := 64);
    let p0 = Framed(file, page, vars);
    let p1 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (read_gpr(Rax, st.gprs) = count);
    let p2 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (condition_holds(B, st.flags) = count.borrow_sub_bit(two));
    let compared = runs_seq(p0, eof_rip(ca(l_total())), p1, eof_rip(ca(l_total_test())), p2, eof_rip(ca(l_total_jb())),
        runs_slot_load(file, page, vars, ca(l_total()), 21, { omega }, Rax, here(l_total()), here(l_total_load()), p0, p1, λ _ h => h,
            λ st h framed => ⟨framed, refl⟩),
        runs_block(total_compare(), io_entry(), ca(l_total_test()), p1, p2,
            λ st h => framed_resident(file, page, vars, canonical_block_bytes(total_compare()), eof_rip(ca(l_total_test())), here(l_total_test()), st,
                h.left),
            λ st h same => ⟨framed_moved(file, page, vars, execute_block_normal(total_compare(), st), st, same, h.left),
                cong_fn<BitVec(64), Bool>(λ v => v.borrow_sub_bit(two), h.right)⟩));
    let jb = JumpIfNear(B, cmd_d(l_total_jb()));
    let resident = λ (st: MachineState<IoMemory>) (h: p2(st)) =>
        framed_resident(file, page, vars, near_control_bytes(jb), eof_rip(ca(l_total_jb())), here(l_total_jb()), st, h.left);
    let pre: p0(state) = Exists(frame, ⟨memory_is, holds⟩);
    let value: (count.toNat() = n) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), held.count_is), toNat_word_of_nat(64, n, few));
    let two_value: (two.toNat() = 2) = BitVec::toNat_ofNat(64, 2, { omega });
    (match count.borrow_sub_bit(two) as λ c => (count.borrow_sub_bit(two) = c) →
            LinuxRuns(io, total_events(mask, width, n, total, failed, totals), state) {
        True => λ below => {
            let lt = cmp_below(count, two, below);
            let short: (n < 2) = omega;
            j(sym(total_events_few(mask, width, n, total, failed, totals, io_leb_false(2, n, short))), λ es _ => LinuxRuns(io, es, state),
                runs_into(p0, eof_rip(ca(l_total())), p0, eof_rip(ca(l_exit())), [ExitEvent(status_word(failed))],
                    runs_seq(p0, eof_rip(ca(l_total())), p2, eof_rip(ca(l_total_jb())), p0, eof_rip(ca(l_exit())), compared,
                        runs_jcc_taken(B, cmd_d(l_total_jb()), io_entry(), ca(l_total_jb()), ca(l_exit()), cmd_j_total_jb(), p2, p0, resident,
                            λ st h => trans(h.right, below), λ st h => h.left)),
                    state, rip_is, pre,
                    λ s at h => exit_runs(file, letters, default, spill, code, jumps, pj, placed, h.witness, vars, h.proof.right, status_word(failed),
                        held.status_is, page, s, h.proof.left, at)))
        },
        False => λ fits => {
            let ge = cmp_not_below(count, two, fits);
            let many_n: (2 <= n) = omega;
            let many: (Nat::leb(2, n) = True) = bool::eq_true_of_is_true(Nat::leb(2, n), Nat::leb_complete(2, n, many_n));
            let events = write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]);
            j(sym(total_events_many(mask, width, n, total, failed, totals, many)), λ es _ => LinuxRuns(io, es, state),
                runs_into(p0, eof_rip(ca(l_total())), p0, eof_rip(ca(l_tsetup())), events,
                    runs_seq(p0, eof_rip(ca(l_total())), p2, eof_rip(ca(l_total_jb())), p0, eof_rip(ca(l_tsetup())), compared,
                        runs_jcc_passed(B, cmd_d(l_total_jb()), io_entry(), ca(l_total_jb()), p2, p0, resident, λ st h => trans(h.right, fits),
                            λ st h => h.left)),
                    state, rip_is, pre,
                    λ s at h => total_rows(file, letters, default, spill, code, jumps, pj, placed, h.witness, vars, h.proof.right, mask, width, n, failed,
                        totals, held, narrow, total, total_ok_many(mask, width, n, total, totals, many, ok), page, s, h.proof.left, at)))
        },
    })(refl)
}

// ---------------------------------------------------------------------------
// The name's length (`l_len_load` to `l_found`): RDX walks from the name to its
// NUL, one stretch (elf64_straight) a byte, the frame holding `vars`
// throughout. The name is an argument's, read the same under every frame.

theorem low_at(a, v, l: Nat, at: a = v, low: v + l < Nat::pow(2, 47)): a < Nat::pow(2, 47) { omega }
theorem name_step_low(v, l: Nat, low: v + Succ(l) < Nat::pow(2, 47)): (Succ(v) < Nat::pow(2, 47)) ∧ (Succ(v) + l < Nat::pow(2, 47)) {
    ⟨omega, omega⟩
}
// The byte `i` past `v`, at `a`, whatever the frame.
theorem name_byte(file: IoImage, page: Nat → BitVec(8), v: Nat, a: BitVec(64), i: Nat, at: a.toNat() = v + i,
    frame: Nat → BitVec(8)): io_data_access().read(IoMemory(with_frame(file, frame), page), a) =
        io_data_access().read(IoMemory(with_frame(file, frame), page), word_of_nat(64, v + i)) {
    let memory = IoMemory(with_frame(file, frame), page);
    trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ x => io_data_access().read(memory, x), sym(word_of_nat_toNat(64, a))),
        cong_fn<Nat, Option<BitVec(8)>>(λ k => io_data_access().read(memory, word_of_nat(64, k)), at))
}
// A C string read from a source the same at every index.
theorem cstring_from_same(path: List<BitVec(8)>): (s, t: Nat → Option<BitVec(8)>) → ((i: Nat) → s(i) = t(i)) → CStringFrom(path, s) →
    CStringFrom(path, t) {
    match path as λ p => (s, t: Nat → Option<BitVec(8)>) → ((i: Nat) → s(i) = t(i)) → CStringFrom(p, s) → CStringFrom(p, t) {
        Nil => λ s t same held => trans(sym(same(0)), held),
        Cons(_, rest) => λ s t same held => ⟨trans(sym(same(0)), held.left),
            ⟨held.right.left, cstring_from_same(rest, λ i => s(Succ(i)), λ i => t(Succ(i)), λ i => same(Succ(i)), held.right.right)⟩⟩,
    }
}
// The name's bytes from `v` on, under every frame; and from the next.
fn NameReads(file: IoImage, page: Nat → BitVec(8), rest: List<BitVec(8)>, v: Nat) → Type {
    (frame: Nat → BitVec(8)) → CStringFrom(rest, λ i => io_data_access().read(IoMemory(with_frame(file, frame), page), word_of_nat(64, v + i)))
}
theorem name_reads_next(file: IoImage, page: Nat → BitVec(8), x: BitVec(8), more: List<BitVec(8)>, v: Nat,
    reads: NameReads(file, page, Cons(x, more), v)): NameReads(file, page, more, Succ(v)) {
    λ frame => {
        let memory = IoMemory(with_frame(file, frame), page);
        cstring_from_same(more, λ i => io_data_access().read(memory, word_of_nat(64, v + Succ(i))),
            λ i => io_data_access().read(memory, word_of_nat(64, Succ(v) + i)),
            λ i => cong_fn<Nat, Option<BitVec(8)>>(λ k => io_data_access().read(memory, word_of_nat(64, k)), sym(Nat::add_succ_left(v, i))),
            (reads(frame)).right.right)
    }
}
// At the NUL (`l_found`): RDX at its address, RSI and RSP as they were.
fn NameFound(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer, fd: BitVec(64), end: Nat, events: List<LinuxEvent>) → Type {
    (state: MachineState<IoMemory>) → Framed(file, page, vars)(state) → state.rip = eof_rip(ca(l_found())) →
        read_gpr(Rdx, state.gprs).toNat() = end → read_gpr(Rsi, state.gprs) = pointer → read_gpr(Rsp, state.gprs) = fd →
        LinuxRuns(io_linux(), events, state)
}
// A byte loaded and tested, the JE to `l_found` at the NUL; any other, RDX
// on and the JMP back.
theorem name_scan(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer, fd: BitVec(64), events: List<LinuxEvent>, rest: List<BitVec(8)>):
    (v: Nat) → NameFound(file, page, vars, pointer, fd, v + rest.len(), events) → NameReads(file, page, rest, v) → v + rest.len() < Nat::pow(2, 47) →
    (state: MachineState<IoMemory>) → Framed(file, page, vars)(state) → state.rip = eof_rip(ca(l_len_load())) →
    read_gpr(Rdx, state.gprs).toNat() = v → read_gpr(Rsi, state.gprs) = pointer → read_gpr(Rsp, state.gprs) = fd →
    LinuxRuns(io_linux(), events, state) {
    let io = io_linux();
    match rest as λ r => (v: Nat) → NameFound(file, page, vars, pointer, fd, v + r.len(), events) → NameReads(file, page, r, v) →
            v + r.len() < Nat::pow(2, 47) → (state: MachineState<IoMemory>) → Framed(file, page, vars)(state) → state.rip = eof_rip(ca(l_len_load())) →
            read_gpr(Rdx, state.gprs).toNat() = v → read_gpr(Rsi, state.gprs) = pointer → read_gpr(Rsp, state.gprs) = fd →
            LinuxRuns(io, events, state) {
        // The NUL: the JE taken.
        Nil => λ v found reads low state framed rip_is rdx rsi rsp => {
            let ends: (nul().eq_bit(nul()) = True) = refl;
            cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
                l_len_jmp(), refl, 5, vars, state, rip_is, framed,
                Exists(nul(), Exists(read_gpr(Rdx, state.gprs), ⟨refl,
                    ⟨λ frame => trans(name_byte(file, page, v, read_gpr(Rdx, state.gprs), 0, rdx, frame), reads(frame)),
                     ⟨low_at(read_gpr(Rdx, state.gprs).toNat(), v, 0, rdx, low),
                      ⟨λ _ after at fr same => found(after, fr, trans(at, cmd_lands(l_len_test(), 6, t_found(), ca(l_found()), cmd_j_len_je())),
                          trans(cong_fn<MachineState<IoMemory>, Nat>(λ x => read_gpr(Rdx, x.gprs).toNat(), same), rdx),
                          trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsi, x.gprs), same), rsi),
                          trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsp, x.gprs), same), rsp)),
                       λ no => absurd(trans(trans(sym(no), cmp_bytes(nul(), nul())), ends))⟩⟩⟩⟩)))
        },
        // A byte before it: the JE passed, RDX on, back to the load.
        Cons(x, more) => λ v found reads low state framed rip_is rdx rsi rsp => {
            let steps_low = name_step_low(v, more.len(), low);
            let sum = λ (end: Nat) (at_end: end = Succ(v) + more.len()) => trans(at_end, Nat::add_succ_left(v, more.len()));
            cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
                l_len_jmp(), refl, 5, vars, state, rip_is, framed,
                Exists(x, Exists(read_gpr(Rdx, state.gprs), ⟨refl,
                    ⟨λ frame => trans(name_byte(file, page, v, read_gpr(Rdx, state.gprs), 0, rdx, frame), (reads(frame)).left),
                     ⟨low_at(read_gpr(Rdx, state.gprs).toNat(), v, Succ(more.len()), rdx, low),
                      ⟨λ yes => absurd(trans(sym(yes), trans(cmp_bytes(x, nul()), not_nul(x, (reads(file.frame)).right.left)))),
                       λ _ after at fr same => name_scan(file, letters, default, spill, code, jumps, pj, placed, page, vars, pointer, fd, events, more,
                          Succ(v), λ s f r d si sp => found(s, f, r, sum(read_gpr(Rdx, s.gprs).toNat(), d), si, sp),
                          name_reads_next(file, page, x, more, v, reads), steps_low.right, after, fr,
                          trans(at, cmd_lands_back(l_len_step(), 5, t_len_load(), ca(l_len_load()), cmd_j_len_jmp())),
                          trans(cong_fn<MachineState<IoMemory>, Nat>(λ y => read_gpr(Rdx, y.gprs).toNat(), same),
                              pointer_next(read_gpr(Rdx, state.gprs), v, rdx, steps_low.left)),
                          trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ y => read_gpr(Rsi, y.gprs), same), rsi),
                          trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ y => read_gpr(Rsp, y.gprs), same), rsp))⟩⟩⟩⟩)))
        },
    }
}

// ---------------------------------------------------------------------------
// Back to the operand loop (`l_loop`): what runs there, for every frame holding
// the selection, the width, the count, the cursor's two slots as `c19` and
// `c20`, and the totals so far, whatever the status. The totals are fixed
// here, since what the operands after them need of the history depends on
// them (`FilesOk`).

fn LoopGoes(file: IoImage, mask: BitVec(64), width, n: Nat, c19, c20: BitVec(64), totals: Nat → BitVec(64),
    after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → Type {
    (failed: Bool) → (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) →
        Vars(vars, mask, width, n, failed, totals) → vars(19) = c19 → vars(20) = c20 → (page: Nat → BitVec(8)) →
        (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) → state.rip = eof_rip(ca(l_loop())) →
        LinuxRuns(io_linux(), after(failed, totals), state)
}

theorem ne_below(a, b: Nat, below: a < b): Not(a = b) { λ same => { omega } }
theorem ne_above(a, b: Nat, above: b < a): Not(a = b) { λ same => { omega } }
// A slot other than the status's, after the status is set.
theorem status_vars(vars: Nat → BitVec(64), mask: BitVec(64), width, n: Nat, failed: Bool, totals: Nat → BitVec(64),
    held: Vars(vars, mask, width, n, failed, totals), now: Bool):
    Vars(set_var(vars, 18, status_word(now)), mask, width, n, now, totals) {
    Vars(mask_is := trans(set_var_other(vars, 18, status_word(now), 16, ne_below(16, 18, trivial)), held.mask_is),
        width_is := trans(set_var_other(vars, 18, status_word(now), 17, ne_below(17, 18, trivial)), held.width_is),
        status_is := set_var_same(vars, 18, status_word(now)),
        count_is := trans(set_var_other(vars, 18, status_word(now), 21, ne_above(21, 18, trivial)), held.count_is),
        totals_is := λ i below => trans(set_var_other(vars, 18, status_word(now), 8 + i, ne_below(8 + i, 18, { omega })), held.totals_is(i, below)))
}

// The failed path (`l_failed`): the status set to 1, back to the loop.
fn failed_block() → List<Instruction> { [MovRI(Rax, BitVec::ofNat(1)), MovRI(R11, slot_at(18))] }
theorem failed_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, c19, c20: BitVec(64), after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    totals: Nat → BitVec(64), goes: LoopGoes(file, mask, width, n, c19, c20, totals, after),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    held: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20,
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_failed()))): LinuxRuns(io_linux(), after(True, totals), state) {
    let one = status_word(True);
    // The status set, the JMP back to the loop.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io_linux(), after(True, totals), s),
        runs_back(after(True, totals)), l_failed_jmp(), refl, 3, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
        Exists(18, ⟨trivial, ⟨refl, λ s at framed _ => goes(True, framed.witness, set_var(vars, 18, one), framed.proof.right,
            status_vars(vars, mask, width, n, failed, totals, held, True),
            trans(set_var_other(vars, 18, one, 19, ne_above(19, 18, trivial)), at19), trans(set_var_other(vars, 18, one, 20, ne_above(20, 18, trivial)), at20),
            page, s, framed.proof.left,
            trans(at, cmd_lands_back(l_failed_store(), 5, t_loop(), ca(l_loop()), cmd_j_failed_jmp())))⟩⟩))
}

// ---------------------------------------------------------------------------
// The close (`l_closes`): when the operand was opened, close(RSP); a failed close
// sets the status. Then back to the loop.

theorem or_true_r(a: Bool): a || True = True { match a { False => refl, True => refl } }
fn closes_block() → List<Instruction> { [MovRR(Rdi, Rsp), MovRI(Rax, BitVec::ofNat(3))] }
fn zero_test_block() → List<Instruction> { [MovRI(R11, word_zero()), CmpRR(Rax, R11)] }
// Slot `q` into RAX (`k`), then against zero: ZF is whether it is zero.
fn slot_tested_after(q: Nat, vars: Nat → BitVec(64), state: MachineState<IoMemory>) → MachineState<IoMemory> {
    execute_block_normal(zero_test_block(), slot_load_after(Rax, vars(q), q, state))
}
theorem runs_slot_test(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), k, q: Nat, inside: q < frame_slots(),
    block: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    load: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), word_load_bytes(WordLoad(destination := Rax, base := R11)), eof_rip(k + 10)),
    test: (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), canonical_block_bytes(zero_test_block()), eof_rip((k + 10) + 3)),
    p, r: MachineState<IoMemory> → Type, framed: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(state),
    post: (state: MachineState<IoMemory>) → p(state) → Framed(file, page, vars)(slot_tested_after(q, vars, state)) →
        r(slot_tested_after(q, vars, state))): Runs(p, eof_rip(k), r, eof_rip(((k + 10) + 3) + 13)) {
    λ state rip_is holds => {
        let at = framed(state, holds);
        let img = with_frame(file, at.witness);
        let loaded = run_slot_load(file, at.witness, vars, at.proof.right, page, k, q, inside, Rax, block(at.witness), load(at.witness), state,
            at.proof.left, rip_is);
        let s1 = slot_load_after(Rax, vars(q), q, state);
        let tested = run_block(img, page, zero_test_block(), io_entry(), (k + 10) + 3, test(at.witness), s1, loaded.memory_is, loaded.rip_is);
        let s2 = slot_tested_after(q, vars, state);
        Exists(s2, ⟨linux_steps_of_fetched(io_linux(), state, s2, fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2,
                loaded.steps, tested.steps)),
            ⟨tested.rip_is, post(state, holds, Exists(at.witness, ⟨tested.memory_is, at.proof.right⟩))⟩⟩)
    }
}
// After the close returned (`l_close_test`): TEST, JS to the failed path, else back.
fn test_block() → List<Instruction> { [TestRR(Rax, Rax)] }
theorem close_back(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, c19, c20: BitVec(64), after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    totals: Nat → BitVec(64), goes: LoopGoes(file, mask, width, n, c19, c20, totals, after),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    held: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20,
    closed: CloseResult, returns: CloseReturns(closed),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_close_test())), rax: read_gpr(Rax, state.gprs) = close_rax(closed)):
    LinuxRuns(io_linux(), after(failed || close_failed(closed), totals), state) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let tested = run_block(img, page, test_block(), io_entry(), ca(l_close_test()), pieces(l_close_test()), state, memory_is, rip_is);
    let s1 = execute_block_normal(test_block(), state);
    let js = JumpIfNear(S, cmd_d(l_close_js()));
    let jumped = run_near(img, page, js, io_entry(), ca(l_close_js()), pieces(l_close_js()), s1, tested.memory_is, tested.rip_is);
    let s2 = execute_near_control(js, s1);
    let sf: (s1.flags.sf = read_gpr(Rax, state.gprs).band(read_gpr(Rax, state.gprs)).sign_bit()) = refl;
    (match closed as λ c => CloseReturns(c) → read_gpr(Rax, state.gprs) = close_rax(c) →
            LinuxRuns(io, after(failed || close_failed(c), totals), state) {
        Closed => λ _ zero => {
            let small: (BitVec::ofNat(0, n := 64).toNat() < Nat::pow(2, 63)) = { let v: (BitVec::ofNat(0, n := 64).toNat() = 0) = refl; omega };
            let clear: (s1.flags.sf = False) = trans(sf, trans(cong_fn<BitVec(64), Bool>(λ v => v.band(v).sign_bit(), zero),
                test_self_nonnegative(BitVec::ofNat(0), small)));
            let s2_rip = jcc_passed(S, cmd_d(l_close_js()), s1, io_entry(), ca(l_close_js()), tested.rip_is, clear);
            let back = run_near(img, page, JumpNear(cmd_d(l_close_jmp())), io_entry(), ca(l_close_jmp()), pieces(l_close_jmp()), s2, tested.memory_is, s2_rip);
            let s3 = execute_near_control(JumpNear(cmd_d(l_close_jmp())), s2);
            let s3_rip = jmp_back(cmd_d(l_close_jmp()), s2, io_entry(), ca(l_close_jmp()), ca(l_loop()), s2_rip, cmd_j_close_jmp());
            j(sym(Bool::or_false_r(failed)), λ b _ => LinuxRuns(io, after(b, totals), state),
                linux_runs_after_steps(io, after(failed, totals), state, s3,
                    fetched_steps_trans(fetch, data, state, s1, s3, tested.steps, fetched_steps_trans(fetch, data, s1, s2, s3, jumped, back)),
                    goes(failed, frame, vars, holds, held, at19, at20, page, s3, tested.memory_is, s3_rip)))
        },
        CloseFailed(errno) => λ error negative => {
            let set: (s1.flags.sf = True) = trans(sf, trans(cong_fn<BitVec(64), Bool>(λ v => v.band(v).sign_bit(), negative),
                test_self_negative(errno_word(errno), errno_negative(errno, error))));
            let s2_rip = jcc_taken_back(S, cmd_d(l_close_js()), s1, io_entry(), ca(l_close_js()), ca(l_failed()), tested.rip_is, set, cmd_j_close_js());
            j(sym(or_true_r(failed)), λ b _ => LinuxRuns(io, after(b, totals), state),
                linux_runs_after_steps(io, after(True, totals), state, s2, fetched_steps_trans(fetch, data, state, s1, s2, tested.steps, jumped),
                    failed_runs(file, letters, default, spill, code, jumps, pj, placed, mask, width, n, c19, c20, after, totals, goes, frame, vars, holds,
                        failed, held, at19, at20, page, s2, tested.memory_is, s2_rip)))
        },
    })(returns, rax)
}
theorem closes_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, c19, c20: BitVec(64), after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    totals: Nat → BitVec(64), goes: LoopGoes(file, mask, width, n, c19, c20, totals, after),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    held: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20,
    closes: Bool, closes_is: vars(23) = status_word(closes), fd: BitVec(64), closed: CloseResult, returns: CloseReturns(closed),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_closes())), rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), closing(fd, closes, closed, failed, totals, after), state) {
    let io = io_linux();
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let p0 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (read_gpr(Rsp, st.gprs) = fd);
    let tested_at = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧
        ((st.flags.zf = is_zero_bits(64, vars(23).sub(word_zero()))) ∧ (read_gpr(Rsp, st.gprs) = fd));
    let test = runs_slot_test(file, page, vars, ca(l_closes()), 23, { omega }, here(l_closes()), here(l_closes_load()), here(l_closes_test()),
        p0, tested_at, λ _ h => h.left, λ st h framed => ⟨framed, ⟨refl, h.right⟩⟩);
    let je = JumpIfNear(E, cmd_d(l_closes_je()));
    let resident = λ (st: MachineState<IoMemory>) (h: tested_at(st)) =>
        framed_resident(file, page, vars, near_control_bytes(je), eof_rip(ca(l_closes_je())), here(l_closes_je()), st, h.left);
    let pre: p0(state) = ⟨Exists(frame, ⟨memory_is, holds⟩), rsp⟩;
    (match closes as λ c => vars(23) = status_word(c) → LinuxRuns(io, closing(fd, c, closed, failed, totals, after), state) {
        False => λ none => {
            let p1 = Framed(file, page, vars);
            runs_into(p0, eof_rip(ca(l_closes())), p1, eof_rip(ca(l_loop())), after(failed, totals),
                runs_seq(p0, eof_rip(ca(l_closes())), tested_at, eof_rip(ca(l_closes_je())), p1, eof_rip(ca(l_loop())), test,
                    runs_jcc_taken_back(E, cmd_d(l_closes_je()), io_entry(), ca(l_closes_je()), ca(l_loop()), cmd_j_closes_je(), tested_at, p1,
                        resident,
                        λ st h => trans(h.right.left, trans(cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), none),
                            zero_bits_sub_self(64, word_zero()))),
                        λ st h => h.left)),
                state, rip_is, pre,
                λ s at h => goes(failed, h.witness, vars, h.proof.right, held, at19, at20, page, s, h.proof.left, at))
        },
        True => λ some => {
            let asked = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧
                ((read_gpr(Rax, st.gprs) = BitVec::ofNat(3)) ∧ (read_gpr(Rdi, st.gprs) = fd));
            let rest = after(failed || close_failed(closed), totals);
            runs_into(p0, eof_rip(ca(l_closes())), asked, eof_rip(ca(l_close_call())), Cons(CloseEvent(fd, closed), rest),
                runs_seq(p0, eof_rip(ca(l_closes())), tested_at, eof_rip(ca(l_closes_je())), asked, eof_rip(ca(l_close_call())), test,
                    runs_seq(tested_at, eof_rip(ca(l_closes_je())), p0, eof_rip(ca(l_close())), asked, eof_rip(ca(l_close_call())),
                        runs_jcc_passed(E, cmd_d(l_closes_je()), io_entry(), ca(l_closes_je()), tested_at, p0, resident,
                            λ st h => trans(h.right.left, cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), some)),
                            λ st h => ⟨h.left, h.right.right⟩),
                        runs_block(closes_block(), io_entry(), ca(l_close()), p0, asked,
                            λ st h => framed_resident(file, page, vars, canonical_block_bytes(closes_block()), eof_rip(ca(l_close())), here(l_close()),
                                st, h.left),
                            λ st h same => ⟨framed_moved(file, page, vars, execute_block_normal(closes_block(), st), st, same, h.left), ⟨refl, h.right⟩⟩))),
                state, rip_is, pre,
                λ s4 at h => linux_runs_close(io, s4, s4, fd, closed, rest, Exists(0, refl),
                    syscall_placed(with_frame(file, h.left.witness), page, io_entry(), ca(l_close_call()), here(l_close_call(), h.left.witness), s4,
                        h.left.proof.left, at),
                    h.right.left, h.right.right, returns,
                    λ rcx r11 => close_back(file, letters, default, spill, code, jumps, pj, placed, mask, width, n, c19, c20, after, totals, goes,
                        h.left.witness, vars, h.left.proof.right, failed, held, at19, at20, closed, returns, page,
                        linux_write_return(s4, close_rax(closed), rcx, r11), h.left.proof.left, rip_advance(io_entry(), s4.rip, ca(l_close_call()), 2, at),
                        refl)))
        },
    })(closes_is)
}

// ---------------------------------------------------------------------------
// A row's writes. What runs once one is all sent, from `done`, for any page,
// with RSP still the operand's fd.

fn WriteGoes(file: IoImage, done: Nat, after: List<LinuxEvent>, fd: BitVec(64)) → Type {
    (page: Nat → BitVec(8)) → (origin: Gprs) → read_gpr(Rsp, origin) = fd → WriteThen(IoMemory(file, page), done, after, origin)
}
theorem zero_plus(a: Nat): a = 0 + a { omega }
theorem one_more(base, r, t: Nat, len: t = r + 1): Succ(base + r) = base + t { omega }
theorem send_room(r, t: Nat, len: t = r + 1, short: r < 4096): (0 < t) ∧ (t <= 4096) { ⟨omega, omega⟩ }

// One more byte after what the page holds from its start, then the whole
// written: the loop after the three items from `k`. An offset is the one
// before it plus an item's length, as a label's is, so the labels convert to
// it an item at a time.
fn send_block() → List<Instruction> { [AddRI8(Rdi, one_byte()), MovRI(R9, page_word()), MovRR(R10, Rdi), SubRR(R10, R9)] }
theorem row_send(file: IoImage, page: Nat → BitVec(8), k, done: Nat, w: BitVec(64), x: BitVec(8), low: imm_byte0(w) = x,
    set: Placed(file, canonical_block_bytes([MovRI(R11, w)]), eof_rip(k)),
    store: Placed(file, byte_store_bytes(ByteStore(base := Rdi, source := R11)), eof_rip(k + 10)),
    send: Placed(file, canonical_block_bytes(send_block()), eof_rip((k + 10) + 3)),
    pj: PrintJumps, loop: Placed(file, write_loop_code(pj), eof_rip(((k + 10) + 3) + 20)), facts: WriteJumpFacts(pj),
    lands: JumpsForward(wl_at_wjz(((k + 10) + 3) + 20), 6, pj.zd, done),
    row: List<BitVec(8)>, short: row.len() < 4096, write: RowWrite, ok: RowWriteOk(row ++ [x], write),
    after: List<LinuxEvent>, fd: BitVec(64), goes: WriteGoes(file, done, after, fd),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = eof_rip(k), held: Stored(page, 0, row),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (0 + row.len()), rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), write_events_then(row ++ [x], write.steps, write.ending, after), state) {
    let io = io_linux();
    let memory = IoMemory(file, page);
    let ran1 = run_block(file, page, [MovRI(R11, w)], io_entry(), k, set, state, memory_is, rip_is);
    let s1 = execute_block_normal([MovRI(R11, w)], state);
    let cursor = drop_zero(read_gpr(Rdi, state.gprs).toNat(), io_page_base(), row.len(), rdi);
    let stored = run_store(file, page, ByteStore(base := Rdi, source := R11), refl, io_entry(), k + 10, store, row.len(), short, x, s1,
        ran1.memory_is, ran1.rip_is, cursor, low);
    let s2 = byte_store_after(linux_writes(io), ByteStore(base := Rdi, source := R11), s1);
    let next = io_store_offset(memory, row.len(), [x]).page;
    let ran3 = run_block(file, next, send_block(), io_entry(), (k + 10) + 3, send, s2, stored.memory_is, stored.rip_is);
    let s3 = execute_block_normal(send_block(), s2);
    let bytes = row ++ [x];
    let lb: (bytes.len() = row.len() + 1) = List::len_append(row, [x]);
    let old: Stored(next, 0, row) = stored_kept(memory, row.len(), [x], row, 0, { omega }, held);
    let new: Stored(next, 0 + row.len(), [x]) = j(zero_plus(row.len()), λ c _ => Stored(next, c, [x]),
        stored_store(memory, row.len(), [x]));
    let page_low: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    let moved = add_one_value(read_gpr(Rdi, s2.gprs), io_page_base() + row.len(), cursor, { omega });
    let at_out = trans(moved, one_more(io_page_base(), row.len(), bytes.len(), lb));
    let base: (page_word().toNat() = io_page_base()) = { let v = page_word_value(); omega };
    let room = send_room(row.len(), bytes.len(), lb, short);
    let writes = page_write(file, next, ((k + 10) + 3) + 20, done, pj, loop, facts, lands, bytes, write, ok, room.left, room.right, after, s3.gprs,
        goes(next, s3.gprs, rsp), s3, ran3.memory_is, ran3.rip_is, stored_join(next, 0, row, [x], old, new), refl,
        filter_out_len(read_gpr(Rdi, s2.gprs).add(one_byte().sign_extend(56)), page_word(), bytes.len(), at_out, base), write_kept_refl(s3.gprs));
    linux_runs_after_linux_steps(io, write_events_then(bytes, write.steps, write.ending, after), state, s2,
        linux_steps_trans(io, state, s1, s2, linux_steps_of_fetched(io, state, s1, ran1.steps), stored.step),
        linux_runs_after_steps(io, write_events_then(bytes, write.steps, write.ending, after), s2, s3, ran3.steps, writes))
}

// The newline (`l_nl` to `l_closes`): one byte at the page's start, written.
fn newline_block() → List<Instruction> { [MovRI(Rdi, page_word()), MovRI(R11, BitVec::ofNat(10))] }
fn one_block() → List<Instruction> { [MovRI(R9, page_word()), MovRI(R10, BitVec::ofNat(1))] }
theorem newline_send(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg,
    pieces: CmdAt(file, letters, default, spill),
    write: RowWrite, ok: RowWriteOk([newline()], write), after: List<LinuxEvent>, fd: BitVec(64), goes: WriteGoes(file, ca(l_closes()), after, fd),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = eof_rip(ca(l_nl())),
    rsp: read_gpr(Rsp, state.gprs) = fd): LinuxRuns(io_linux(), write_events_then([newline()], write.steps, write.ending, after), state) {
    let io = io_linux();
    let memory = IoMemory(file, page);
    let ran1 = run_block(file, page, newline_block(), io_entry(), ca(l_nl()), pieces(l_nl()), state, memory_is, rip_is);
    let s1 = execute_block_normal(newline_block(), state);
    let stored = run_store(file, page, ByteStore(base := Rdi, source := R11), refl, io_entry(), ca(l_nl_store()), pieces(l_nl_store()), 0, trivial, newline(), s1,
        ran1.memory_is, ran1.rip_is, page_word_value(), refl);
    let s2 = byte_store_after(linux_writes(io), ByteStore(base := Rdi, source := R11), s1);
    let next = io_store_offset(memory, 0, [newline()]).page;
    let ran3 = run_block(file, next, one_block(), io_entry(), ca(l_nl_len()), pieces(l_nl_len()), s2, stored.memory_is, stored.rip_is);
    let s3 = execute_block_normal(one_block(), s2);
    let writes = page_write(file, next, ca(l_nl_write()), ca(l_closes()), pj_newline(), pieces(l_nl_write()), WriteJumpFacts(refl, refl, refl), pj_newline_done(), [newline()],
        write, ok, trivial, trivial, after, s3.gprs, goes(next, s3.gprs, rsp), s3, ran3.memory_is, ran3.rip_is,
        stored_store(memory, 0, [newline()]), refl, BitVec::toNat_ofNat(64, 1, { omega }), write_kept_refl(s3.gprs));
    linux_runs_after_linux_steps(io, write_events_then([newline()], write.steps, write.ending, after), state, s2,
        linux_steps_trans(io, state, s1, s2, linux_steps_of_fetched(io, state, s1, ran1.steps), stored.step),
        linux_runs_after_steps(io, write_events_then([newline()], write.steps, write.ending, after), s2, s3, ran3.steps, writes))
}

// A C string's bytes are what a write from its start sends.
theorem cstring_nth(path: List<BitVec(8)>): (source: Nat → Option<BitVec(8)>) → CStringFrom(path, source) → (i: Nat) → (b: BitVec(8)) →
    path.nth(i) = Some(b) → source(i) = Some(b) {
    match path as λ p => (source: Nat → Option<BitVec(8)>) → CStringFrom(p, source) → (i: Nat) → (b: BitVec(8)) → p.nth(i) = Some(b) →
            source(i) = Some(b) {
        Nil => λ source held i b present => absurd(present),
        Cons(x, rest) => λ source held i => match i as λ k => (b: BitVec(8)) → Cons(x, rest).nth(k) = Some(b) → source(k) = Some(b) {
            Zero => λ b present => trans(held.left, present),
            Succ(k) => λ b present => cstring_nth(rest, λ m => source(Succ(m)), held.right.right, k, b, present),
        },
    }
}
theorem cstring_sends(memory: IoMemory, buffer: BitVec(64), name: List<BitVec(8)>, held: CStringAt(io_data_access(), memory, buffer, name)):
    LinuxWritesFrom(io_linux(), memory, buffer, name) {
    λ i b present => cstring_nth(name, λ m => io_data_access().read(memory, word_of_nat(64, buffer.toNat() + m)), held, i, b, present)
}
theorem name_sub(rdx, rsi: BitVec(64), v, l: Nat, end: rdx.toNat() = v + l, start: rsi.toNat() = v): rdx.sub(rsi).toNat() = l {
    let difference = bitvec_nat::toNat_sub(64, rdx, rsi, { omega });
    let back: ((rdx.toNat() -rsi.toNat()) + rsi.toNat() = rdx.toNat()) = Nat::sub_add_cancel(rsi.toNat(), rdx.toNat(), { omega });
    omega
}
theorem name_room(v, l: Nat, low: v + l + 1 <= Nat::pow(2, 47)): (v + l < Nat::pow(2, 47)) ∧ (v + l < Nat::pow(2, 64)) {
    let wide: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Succ(Nat::pow(2, 47)), Nat::pow(2, 64), trivial);
    ⟨omega, omega⟩
}

// The name (`l_nm` to `l_nl`): its pointer from slot 22, its length, written.
// Two stretches (elf64_straight) around the scan: slot 22 into RSI and RDX,
// then at the NUL R9 and R10 set for the write. What follows the write takes
// whichever frame holds `vars` (`FramedWrite`).
fn FramedWrite(file: IoImage, vars: Nat → BitVec(64), done: Nat, after: List<LinuxEvent>, fd: BitVec(64)) → Type {
    (frame: Nat → BitVec(8)) → FrameHolds(frame, vars) → WriteGoes(with_frame(file, frame), done, after, fd)
}
theorem name_send(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    vars: Nat → BitVec(64), pointer: BitVec(64), at22: vars(22) = pointer, name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), some: 0 < name.len(), fits: name.len() <= 4096,
    write: RowWrite, ok: RowWriteOk(name, write), after: List<LinuxEvent>, fd: BitVec(64), goes: FramedWrite(file, vars, ca(l_nl()), after, fd),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_nm())), rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), write_events_then(name, write.steps, write.ending, after), state) {
    let io = io_linux();
    let events = write_events_then(name, write.steps, write.ending, after);
    let v = pointer.toNat();
    let rooms = name_room(v, name.len(), low);
    // At the NUL: R9 the name, R10 its length, then the write.
    let found: NameFound(file, page, vars, pointer, fd, v + name.len(), events) = λ s3 framed3 rip3 rdx3 rsi3 rsp3 =>
        cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
            l_found(), refl, 1, vars, s3, rip3, framed3,
            λ s4 at fr same => {
                let img = with_frame(file, fr.witness);
                let memory = IoMemory(img, page);
                let regs = cong_fn<MachineState<IoMemory>, Gprs>(λ y => y.gprs, same);
                let r9: (read_gpr(R9, s4.gprs) = pointer) = trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(R9, g), regs), rsi3);
                let r10: (read_gpr(R10, s4.gprs).toNat() = name.len()) = trans(cong_fn<Gprs, Nat>(λ g => read_gpr(R10, g).toNat(), regs),
                    name_sub(read_gpr(Rdx, s3.gprs), read_gpr(Rsi, s3.gprs), v, name.len(), rdx3, cong_fn<BitVec(64), Nat>(λ w => w.toNat(), rsi3)));
                let sends: LinuxWritesFrom(io, memory, read_gpr(R9, s4.gprs), name) =
                    j(sym(r9), λ w _ => LinuxWritesFrom(io, memory, w, name), cstring_sends(memory, pointer, name, string(fr.witness, page)));
                let room: (read_gpr(R9, s4.gprs).toNat() + name.len() < Nat::pow(2, 64)) =
                    j(sym(r9), λ w _ => w.toNat() + name.len() < Nat::pow(2, 64), rooms.right);
                let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(fr.witness));
                mem_write(img, page, ca(l_name_write()), ca(l_nl()), pj_name(), pieces(l_name_write()), WriteJumpFacts(refl, refl, refl), pj_name_done(),
                    name, write, ok, some, fits, after, s4.gprs,
                    goes(fr.witness, fr.proof.right)(page, s4.gprs, trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsp, g), regs), rsp3)),
                    s4, fr.proof.left, at, sends, room, r10, write_kept_refl(s4.gprs))
            });
    // Slot 22 into RSI, copied to RDX: the scan from the name's start.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
        l_nm_copy(), refl, 3, vars, state, rip_is, framed,
        Exists(22, ⟨trivial, ⟨refl, λ s2 at fr same => {
            let regs = cong_fn<MachineState<IoMemory>, Gprs>(λ y => y.gprs, same);
            name_scan(file, letters, default, spill, code, jumps, pj, placed, page, vars, pointer, fd, events, name, v, found,
                λ frame => string(frame, page), rooms.left, s2, fr, at,
                cong_fn<BitVec(64), Nat>(λ w => w.toNat(), trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rdx, g), regs), at22)),
                trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsi, g), regs), at22),
                trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsp, g), regs), rsp))
        }⟩⟩))
}

// ---------------------------------------------------------------------------
// A row's tail (`l_named`): with operands, a space, the name and the newline,
// each written, then the close; with none, stdin's newline and the exit.

fn tail_test_block() → List<Instruction> { [MovRI(R11, word_zero()), CmpRR(Rax, R11)] }
theorem named_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, c19, c20: BitVec(64), after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    totals: Nat → BitVec(64), goes: LoopGoes(file, mask, width, n, c19, c20, totals, after),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    held: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20,
    nonzero: 0 < n, few: n < Nat::pow(2, 64),
    row: List<BitVec(8)>, short: row.len() < 4096, counts: RowWrite, counts_ok: RowWriteOk(row ++ [field_gap()], counts),
    pointer: BitVec(64), at22: vars(22) = pointer, name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), some: 0 < name.len(), fits: name.len() <= 4096,
    named: RowWrite, named_ok: RowWriteOk(name, named), nl: RowWrite, nl_ok: RowWriteOk([newline()], nl),
    closes: Bool, closes_is: vars(23) = status_word(closes), fd: BitVec(64), closed: CloseResult, returns: CloseReturns(closed),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_named())), stored: Stored(page, 0, row),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (0 + row.len()), rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), write_events_then(row ++ [field_gap()], counts.steps, counts.ending,
        write_events_then(name, named.steps, named.ending,
            write_events_then([newline()], nl.steps, nl.ending, closing(fd, closes, closed, failed, totals, after)))), state) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let loaded = run_slot_load(file, frame, vars, holds, page, ca(l_named()), 21, { omega }, Rax, pieces(l_named()), pieces(l_named_load()), state,
        memory_is, rip_is);
    let s1 = slot_load_after(Rax, vars(21), 21, state);
    let tested = run_block(img, page, tail_test_block(), io_entry(), ca(l_named_test()), pieces(l_named_test()), s1, loaded.memory_is, loaded.rip_is);
    let s2 = execute_block_normal(tail_test_block(), s1);
    let je = JumpIfNear(E, cmd_d(l_named_je()));
    let jumped = run_near(img, page, je, io_entry(), ca(l_named_je()), pieces(l_named_je()), s2, tested.memory_is, tested.rip_is);
    let s3 = execute_near_control(je, s2);
    let value: (vars(21).toNat() = n) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), held.count_is), toNat_word_of_nat(64, n, few));
    let clear: (s2.flags.zf = False) = trans(zero_bits_sub(64, vars(21), word_zero()), nonzero_word(vars(21), { omega }));
    let s3_rip = jcc_passed(E, cmd_d(l_named_je()), s2, io_entry(), ca(l_named_je()), tested.rip_is, clear);
    let closing_events = closing(fd, closes, closed, failed, totals, after);
    let nl_events = write_events_then([newline()], nl.steps, nl.ending, closing_events);
    let name_events = write_events_then(name, named.steps, named.ending, nl_events);
    let to_close: FramedWrite(file, vars, ca(l_closes()), closing_events, fd) = λ f h page2 origin rsp2 st at in_memory kept =>
        closes_runs(file, letters, default, spill, code, jumps, pj, placed, mask, width, n, c19, c20, after, totals, goes, f, vars, h, failed,
            held, at19, at20, closes, closes_is, fd, closed, returns, page2, st, in_memory, at,
            trans(kept.right.right.right.right.right.right, rsp2));
    let to_newline: FramedWrite(file, vars, ca(l_nl()), nl_events, fd) = λ f h page2 origin rsp2 st at in_memory kept =>
        newline_send(with_frame(file, f), letters, default, spill, cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f)), nl,
            nl_ok, closing_events, fd, to_close(f, h), page2, st, in_memory, at, trans(kept.right.right.right.right.right.right, rsp2));
    let to_name: WriteGoes(img, ca(l_nm()), name_events, fd) = λ page2 origin rsp2 st at in_memory kept =>
        name_send(file, letters, default, spill, code, jumps, pj, placed, vars, pointer, at22, name, string, low, some, fits,
            named, named_ok, nl_events, fd, to_newline, page2, st, Exists(frame, ⟨in_memory, holds⟩), at, trans(kept.right.right.right.right.right.right, rsp2));
    linux_runs_after_steps(io, write_events_then(row ++ [field_gap()], counts.steps, counts.ending, name_events), state, s3,
        fetched_steps_trans(fetch, data, state, s1, s3, loaded.steps, fetched_steps_trans(fetch, data, s1, s2, s3, tested.steps, jumped)),
        row_send(img, page, ca(l_gap()), ca(l_nm()), BitVec::ofNat(32), field_gap(), refl, pieces(l_gap()), pieces(l_gap_store()), pieces(l_gap_len()), pj_counts(),
            pieces(l_gap_write()), WriteJumpFacts(refl, refl, refl), pj_counts_done(), row, short, counts, counts_ok, name_events, fd, to_name,
            s3, tested.memory_is, s3_rip, stored, rdi, rsp))
}
// No operand: stdin's row and a newline, one write, then the exit.
theorem unnamed_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width: Nat, frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    totals: Nat → BitVec(64), held: Vars(vars, mask, width, 0, failed, totals),
    row: List<BitVec(8)>, short: row.len() < 4096, counts: RowWrite, counts_ok: RowWriteOk(row ++ [newline()], counts),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_named())), stored: Stored(page, 0, row),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (0 + row.len())):
    LinuxRuns(io_linux(), write_events_then(row ++ [newline()], counts.steps, counts.ending, [ExitEvent(status_word(failed))]), state) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    let loaded = run_slot_load(file, frame, vars, holds, page, ca(l_named()), 21, { omega }, Rax, pieces(l_named()), pieces(l_named_load()), state,
        memory_is, rip_is);
    let s1 = slot_load_after(Rax, vars(21), 21, state);
    let tested = run_block(img, page, tail_test_block(), io_entry(), ca(l_named_test()), pieces(l_named_test()), s1, loaded.memory_is, loaded.rip_is);
    let s2 = execute_block_normal(tail_test_block(), s1);
    let je = JumpIfNear(E, cmd_d(l_named_je()));
    let jumped = run_near(img, page, je, io_entry(), ca(l_named_je()), pieces(l_named_je()), s2, tested.memory_is, tested.rip_is);
    let s3 = execute_near_control(je, s2);
    let set: (s2.flags.zf = True) = trans(cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), held.count_is),
        zero_bits_sub_self(64, word_zero()));
    let s3_rip = jcc_taken(E, cmd_d(l_named_je()), s2, io_entry(), ca(l_named_je()), ca(l_unnamed()), tested.rip_is, set, cmd_j_named_je());
    let exiting: WriteGoes(img, ca(l_exit()), [ExitEvent(status_word(failed))], read_gpr(Rsp, state.gprs)) = λ page2 origin _ st at in_memory _ =>
        exit_runs(file, letters, default, spill, code, jumps, pj, placed, frame, vars, holds, status_word(failed), held.status_is, page2, st,
            in_memory, at);
    linux_runs_after_steps(io, write_events_then(row ++ [newline()], counts.steps, counts.ending, [ExitEvent(status_word(failed))]), state, s3,
        fetched_steps_trans(fetch, data, state, s1, s3, loaded.steps, fetched_steps_trans(fetch, data, s1, s2, s3, tested.steps, jumped)),
        row_send(img, page, ca(l_unnamed()), ca(l_exit()), BitVec::ofNat(10), newline(), refl, pieces(l_unnamed()), pieces(l_unnamed_store()), pieces(l_unnamed_len()), pj_stdin(),
            pieces(l_unnamed_write()), WriteJumpFacts(refl, refl, refl), pj_stdin_done(), row, short, counts, counts_ok, [ExitEvent(status_word(failed))],
            read_gpr(Rsp, state.gprs), exiting, s3, tested.memory_is, s3_rip, stored, rdi, refl))
}

// ---------------------------------------------------------------------------
// The spill (`l_spill`): each column's count stored in its slot and added into
// its total, slot by slot.

fn spill_step(vars, counts: Nat → BitVec(64), i: Nat) → Nat → BitVec(64) {
    set_var(set_var(vars, i, counts(i)), 8 + i, set_var(vars, i, counts(i))(8 + i).add(counts(i)))
}
fn spill_vars(counts: Nat → BitVec(64), j: Nat) → (Nat → BitVec(64)) → Nat → Nat → BitVec(64) {
    match j { Zero => λ vars i => vars, Succ(k) => λ vars i => spill_vars(counts, k)(spill_step(vars, counts, i), Succ(i)) }
}
// A slot neither step sets.
theorem spill_step_other(vars, counts: Nat → BitVec(64), i, m: Nat, first: Not(m = i), second: Not(m = 8 + i)):
    spill_step(vars, counts, i)(m) = vars(m) {
    trans(set_var_other(set_var(vars, i, counts(i)), 8 + i, set_var(vars, i, counts(i))(8 + i).add(counts(i)), m, second),
        set_var_other(vars, i, counts(i), m, first))
}
// The slots past the totals' stay.
theorem spill_high(counts: Nat → BitVec(64), j: Nat): (vars: Nat → BitVec(64)) → (i, m: Nat) → i + j <= 8 → 16 <= m →
    spill_vars(counts, j)(vars, i)(m) = vars(m) {
    match j as λ k => (vars: Nat → BitVec(64)) → (i, m: Nat) → i + k <= 8 → 16 <= m → spill_vars(counts, k)(vars, i)(m) = vars(m) {
        Zero => λ vars i m _ _ => refl,
        Succ(k) => λ vars i m fits high => trans(spill_high(counts, k, spill_step(vars, counts, i), Succ(i), m, { omega }, high),
            spill_step_other(vars, counts, i, m, ne_above(m, i, { omega }), ne_above(m, 8 + i, { omega }))),
    }
}
// A count's slot before the steps, and its total's, stay.
theorem spill_before(counts: Nat → BitVec(64), j: Nat): (vars: Nat → BitVec(64)) → (i, m: Nat) → m < i → i + j <= 8 →
    (spill_vars(counts, j)(vars, i)(m) = vars(m)) ∧ (spill_vars(counts, j)(vars, i)(8 + m) = vars(8 + m)) {
    match j as λ k => (vars: Nat → BitVec(64)) → (i, m: Nat) → m < i → i + k <= 8 →
            (spill_vars(counts, k)(vars, i)(m) = vars(m)) ∧ (spill_vars(counts, k)(vars, i)(8 + m) = vars(8 + m)) {
        Zero => λ vars i m _ _ => ⟨refl, refl⟩,
        Succ(k) => λ vars i m below fits => {
            let later = spill_before(counts, k, spill_step(vars, counts, i), Succ(i), m, { omega }, { omega });
            let count_slot = spill_step_other(vars, counts, i, m, ne_below(m, i, below), ne_below(m, 8 + i, { omega }));
            let total_slot = spill_step_other(vars, counts, i, 8 + m, ne_above(8 + m, i, { omega }), ne_below(8 + m, 8 + i, { omega }));
            ⟨trans(later.left, count_slot), trans(later.right, total_slot)⟩
        },
    }
}
// Each stepped slot holds its count, and its total the sum.
theorem spill_set(counts: Nat → BitVec(64), j: Nat): (vars: Nat → BitVec(64)) → (i, m: Nat) → i <= m → m < i + j → i + j <= 8 →
    (spill_vars(counts, j)(vars, i)(m) = counts(m)) ∧ (spill_vars(counts, j)(vars, i)(8 + m) = vars(8 + m).add(counts(m))) {
    match j as λ k => (vars: Nat → BitVec(64)) → (i, m: Nat) → i <= m → m < i + k → i + k <= 8 →
            (spill_vars(counts, k)(vars, i)(m) = counts(m)) ∧ (spill_vars(counts, k)(vars, i)(8 + m) = vars(8 + m).add(counts(m))) {
        Zero => λ vars i m from below _ => false_elim(Nat::lt_irrefl(m, { omega })),
        Succ(k) => λ vars i m from below fits => {
            let stepped = spill_step(vars, counts, i);
            let first = set_var(vars, i, counts(i));
            match Nat::eq_dec(m, i) {
                Inl(same) => {
                    let kept = spill_before(counts, k, stepped, Succ(i), i, { omega }, { omega });
                    let count_slot: (stepped(i) = counts(i)) =
                        trans(set_var_other(first, 8 + i, first(8 + i).add(counts(i)), i, ne_below(i, 8 + i, { omega })),
                            set_var_same(vars, i, counts(i)));
                    let total_slot: (stepped(8 + i) = vars(8 + i).add(counts(i))) =
                        trans(set_var_same(first, 8 + i, first(8 + i).add(counts(i))),
                            cong_fn<BitVec(64), BitVec(64)>(λ v => v.add(counts(i)), set_var_other(vars, i, counts(i), 8 + i, ne_above(8 + i, i, { omega }))));
                    j(sym(same), λ q _ => (spill_vars(counts, k)(stepped, Succ(i))(q) = counts(q)) ∧
                            (spill_vars(counts, k)(stepped, Succ(i))(8 + q) = vars(8 + q).add(counts(q))),
                        ⟨trans(kept.left, count_slot), trans(kept.right, total_slot)⟩)
                },
                Inr(other) => {
                    let later = spill_set(counts, k, stepped, Succ(i), m, { let apart: (i < m) = Nat::lt_of_le_of_ne(i, m, from, λ e => other(sym(e))); omega },
                        { omega }, { omega });
                    let total_slot = spill_step_other(vars, counts, i, 8 + m, ne_above(8 + m, i, { omega }),
                        λ e => other(Nat::add_left_cancel(8, m, i, e)));
                    ⟨later.left, trans(later.right, cong_fn<BitVec(64), BitVec(64)>(λ v => v.add(counts(m)), total_slot))⟩
                },
            }
        },
    }
}

// A state register through code that writes only others.
theorem state_kept(r: StateReg, after, before: Gprs, kept: WriteKept(after, before)): read_gpr(state_gpr(r), after) = read_gpr(state_gpr(r), before) {
    match r as λ q => read_gpr(state_gpr(q), after) = read_gpr(state_gpr(q), before) {
        SR13 => kept.right.right.left,
        SR14 => kept.right.right.right.left,
        SR15 => kept.right.right.right.right.left,
        SR8 => kept.left,
    }
}
theorem placed_shift(file: IoImage, code: List<BitVec(8)>, k, off: Nat, placed: Placed(file, code, next_rip(eof_rip(k), off))):
    Placed(file, code, eof_rip(k + off)) {
    j(rip_compose(io_entry(), k, off), λ a _ => Placed(file, code, a), placed)
}

// The spill's states: the frame holds `vars`, and the state registers are as
// they were where the spill began (`g`), so a count register still holds its
// count.
fn SpillPre(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), g: Gprs) → MachineState<IoMemory> → Type {
    λ state => Framed(file, page, vars)(state) ∧ WriteKept(state.gprs, g)
}
fn SpillBlockPlaced(file: IoImage, r: Gpr, i, k: Nat) → Type {
    (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), spill_block(r, i), eof_rip(k))
}
theorem spill_piece(file: IoImage, r: Gpr, i, k: Nat, block: SpillBlockPlaced(file, r, i, k), frame: Nat → BitVec(8), l: Prog):
    Placed(with_frame(file, frame), item_bytes(no_fills(), asm_labels(lsp_back(r, i)), asm_find(lsp_back(r, i), l)),
        eof_rip(k + asm_at(asm_find(lsp_back(r, i), l)))) {
    placed_shift(with_frame(file, frame), item_bytes(no_fills(), asm_labels(lsp_back(r, i)), asm_find(lsp_back(r, i), l)), k,
        asm_at(asm_find(lsp_back(r, i), l)), asm_placed(with_frame(file, frame), no_fills(), lsp_back(r, i), trivial, eof_rip(k), block(frame), l))
}
// One slot (`k` to `k + 32`): the count stored in its slot, the total loaded,
// the count added, the total stored back.
theorem spill_one_runs(file: IoImage, page: Nat → BitVec(8), spill: Nat → StateReg, i: Nat, inside: i < 8, k: Nat,
    block: SpillBlockPlaced(file, state_gpr(spill(i)), i, k), counts, vars: Nat → BitVec(64), g: Gprs,
    col: read_gpr(state_gpr(spill(i)), g) = counts(i)):
    Runs(SpillPre(file, page, vars, g), eof_rip(k), SpillPre(file, page, spill_step(vars, counts, i), g), eof_rip(k + 32)) {
    let r = state_gpr(spill(i));
    let vars1 = set_var(vars, i, counts(i));
    let total = vars1(8 + i);
    let p0 = SpillPre(file, page, vars, g);
    let p1 = SpillPre(file, page, vars1, g);
    let p2 = λ (s: MachineState<IoMemory>) => p1(s) ∧ ((read_gpr(Rax, s.gprs) = total) ∧ (read_gpr(R11, s.gprs) = slot_at(8 + i)));
    let p3 = λ (s: MachineState<IoMemory>) => p1(s) ∧ ((read_gpr(Rax, s.gprs) = total.add(counts(i))) ∧ (read_gpr(R11, s.gprs) = slot_at(8 + i)));
    let p4 = SpillPre(file, page, spill_step(vars, counts, i), g);
    let count = λ (s: MachineState<IoMemory>) (kept: WriteKept(s.gprs, g)) => trans(state_kept(spill(i), s.gprs, g, kept), col);
    let piece = λ (l: Prog) (f: Nat → BitVec(8)) => spill_piece(file, r, i, k, block, f, l);
    runs_seq(p0, eof_rip(k), p1, eof_rip((k + 10) + 3), p4, eof_rip(k + 32),
        runs_slot_store(file, page, vars, k, i, { omega }, r, piece(lsp_slot(r, i)), piece(lsp_store(r, i)), p0, p1, λ _ held => held.left,
            λ s held framed => ⟨framed_set(file, page, vars, i, read_gpr(r, execute_block_normal(slot_block(i), s).gprs), counts(i),
                count(execute_block_normal(slot_block(i), s), held.right), slot_store_after(r, i, s), framed), held.right⟩),
        runs_seq(p1, eof_rip((k + 10) + 3), p2, eof_rip(k + 26), p4, eof_rip(k + 32),
            runs_slot_load(file, page, vars1, (k + 10) + 3, 8 + i, { omega }, Rax, piece(lsp_total(r, i)), piece(lsp_load(r, i)), p1, p2, λ _ held => held.left,
                λ s held framed => ⟨⟨framed, held.right⟩, ⟨refl, refl⟩⟩),
            runs_seq(p2, eof_rip(k + 26), p3, eof_rip(k + 29), p4, eof_rip(k + 32),
                runs_block([AddRR(Rax, r)], io_entry(), k + 26, p2, p3,
                    λ s held => framed_resident(file, page, vars1, canonical_block_bytes([AddRR(Rax, r)]), eof_rip(k + 26), piece(lsp_add(r, i)), s, held.left.left),
                    λ s held same => {
                        let sum = execute_block_normal([AddRR(Rax, r)], s);
                        let added: (read_gpr(Rax, sum.gprs) = total.add(counts(i))) =
                            j(held.right.left, λ x _ => read_gpr(Rax, sum.gprs) = x.add(counts(i)),
                                j(count(s, held.left.right), λ y _ => read_gpr(Rax, sum.gprs) = read_gpr(Rax, s.gprs).add(y), refl));
                        ⟨⟨framed_moved(file, page, vars1, sum, s, same, held.left.left), held.left.right⟩, ⟨added, held.right.right⟩⟩
                    }),
                runs_frame_store(file, page, vars1, k + 29, 8 + i, { omega }, Rax, piece(lsp_back(r, i)), p3, p4, λ _ held => held.left.left,
                    λ _ held => held.right.right,
                    λ s held framed => ⟨framed_set(file, page, vars1, 8 + i, read_gpr(Rax, s.gprs), total.add(counts(i)), held.right.left,
                        word_store_after(linux_writes(io_linux()), WordStore(base := R11, source := Rax), s), framed), held.left.right⟩))))
}
fn SpillPlaced(file: IoImage, spill: Nat → StateReg, i, j, k: Nat) → Type {
    (frame: Nat → BitVec(8)) → Placed(with_frame(file, frame), spill_blocks(spill, i, j), eof_rip(k))
}
theorem spill_rest_at(k, m: Nat): (k + 32) + 32 * m = k + 32 * Succ(m) { omega }
// Slots `i` to `i + n`.
theorem spill_runs(file: IoImage, page: Nat → BitVec(8), spill: Nat → StateReg, counts: Nat → BitVec(64), g: Gprs,
    cols: (m: Nat) → m < 8 → read_gpr(state_gpr(spill(m)), g) = counts(m), n: Nat): (i, k: Nat) → SpillPlaced(file, spill, i, n, k) →
    i + n <= 8 → (vars: Nat → BitVec(64)) →
    Runs(SpillPre(file, page, vars, g), eof_rip(k), SpillPre(file, page, spill_vars(counts, n)(vars, i), g), eof_rip(k + 32 * n)) {
    match n as λ q => (i, k: Nat) → SpillPlaced(file, spill, i, q, k) → i + q <= 8 → (vars: Nat → BitVec(64)) →
            Runs(SpillPre(file, page, vars, g), eof_rip(k), SpillPre(file, page, spill_vars(counts, q)(vars, i), g), eof_rip(k + 32 * q)) {
        Zero => λ i k _ _ vars => runs_here(SpillPre(file, page, vars, g), eof_rip(k)),
        Succ(m) => λ i k placed fits vars => {
            let r = state_gpr(spill(i));
            let halves = λ (f: Nat → BitVec(8)) => placed_split(with_frame(file, f), spill_block(r, i), spill_blocks(spill, Succ(i), m), eof_rip(k),
                placed(f));
            let block: SpillBlockPlaced(file, r, i, k) = λ f => (halves(f)).left;
            let rest: SpillPlaced(file, spill, Succ(i), m, k + 32) = λ f => placed_shift(with_frame(file, f), spill_blocks(spill, Succ(i), m), k, 32,
                j(spill_block_len(r, i), λ l _ => Placed(with_frame(file, f), spill_blocks(spill, Succ(i), m), next_rip(eof_rip(k), l)),
                    (halves(f)).right));
            let stepped = spill_step(vars, counts, i);
            let later = spill_runs(file, page, spill, counts, g, cols, m, Succ(i), k + 32, rest, { omega }, stepped);
            j(cong_fn<Nat, BitVec(64)>(λ t => eof_rip(t), spill_rest_at(k, m)),
                λ c _ => Runs(SpillPre(file, page, vars, g), eof_rip(k), SpillPre(file, page, spill_vars(counts, m)(stepped, Succ(i)), g), c),
                runs_seq(SpillPre(file, page, vars, g), eof_rip(k), SpillPre(file, page, stepped, g), eof_rip(k + 32),
                    SpillPre(file, page, spill_vars(counts, m)(stepped, Succ(i)), g), eof_rip((k + 32) + 32 * m),
                    spill_one_runs(file, page, spill, i, { omega }, k, block, counts, vars, g, cols(i, { omega })), later))
        },
    }
}

// After a file's reads (`l_spill`): the spill, then R12 at the counts' slots, R13
// the selection, R14 the width, RDI the page, and the row, to 4427.
record RowReady(file: IoImage, mask: BitVec(64), width, n: Nat, failed: Bool, totals, counts, vars0: Nat → BitVec(64), rsp: BitVec(64),
    before: MachineState<IoMemory>) {
    after: MachineState<IoMemory>,
    frame: Nat → BitVec(8),
    vars: Nat → BitVec(64),
    page: Nat → BitVec(8),
    steps: LinuxSteps(io_linux(), before, after),
    memory_is: after.memory = IoMemory(with_frame(file, frame), page),
    rip_is: after.rip = eof_rip(ca(l_named())),
    holds: FrameHolds(frame, vars),
    held: Vars(vars, mask, width, n, failed, add_counts(totals, counts)),
    high: (m: Nat) → 16 <= m → vars(m) = vars0(m),
    stored: Stored(page, 0, row_counts(width, mask, counts)),
    rdi: read_gpr(Rdi, after.gprs).toNat() = io_page_base() + (0 + row_counts(width, mask, counts).len()),
    rsp_is: read_gpr(Rsp, after.gprs) = rsp,
}
fn row_setup1() → List<Instruction> { [MovRI(R12, slot_at(0)), MovRI(R11, slot_at(16))] }
theorem spill_row(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), width, n: Nat, failed: Bool,
    totals: Nat → BitVec(64), held: Vars(vars, mask, width, n, failed, totals), narrow: width <= 20, counts: Nat → BitVec(64),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_spill())), cols: (m: Nat) → m < 8 → read_gpr(state_gpr(spill(m)), state.gprs) = counts(m)):
    RowReady(file, mask, width, n, failed, totals, counts, vars, read_gpr(Rsp, state.gprs), state) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    let g = state.gprs;
    let sv = spill_vars(counts, 8)(vars, 0);
    let high: ((m: Nat) → 16 <= m → sv(m) = vars(m)) = λ m above => spill_high(counts, 8, vars, 0, m, trivial, above);
    let held2: Vars(sv, mask, width, n, failed, add_counts(totals, counts)) = Vars(
        mask_is := trans(high(16, trivial), held.mask_is), width_is := trans(high(17, trivial), held.width_is),
        status_is := trans(high(18, trivial), held.status_is), count_is := trans(high(21, trivial), held.count_is),
        totals_is := λ i below => trans((spill_set(counts, 8, vars, 0, i, { omega }, below, trivial)).right,
            cong_fn<BitVec(64), BitVec(64)>(λ v => v.add(counts(i)), held.totals_is(i, below))));
    let rsp0 = read_gpr(Rsp, g);
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let p = SpillPre(file, page, vars, g);
    let spilled = spill_runs(file, page, spill, counts, g, cols, 8, 0, ca(l_spill()), here(l_spill()), trivial, vars);
    let q0 = λ (st: MachineState<IoMemory>) => Framed(file, page, sv)(st) ∧ (read_gpr(Rsp, st.gprs) = rsp0);
    let q1 = λ (st: MachineState<IoMemory>) => q0(st) ∧ ((read_gpr(R12, st.gprs) = slot_at(0)) ∧ (read_gpr(R11, st.gprs) = slot_at(16)));
    let q2 = λ (st: MachineState<IoMemory>) => q0(st) ∧ ((read_gpr(R12, st.gprs) = slot_at(0)) ∧ (read_gpr(R13, st.gprs) = sv(16)));
    let q3 = λ (st: MachineState<IoMemory>) => q2(st) ∧ (read_gpr(R11, st.gprs) = slot_at(17));
    let q4 = λ (st: MachineState<IoMemory>) => q2(st) ∧ (read_gpr(R14, st.gprs) = sv(17));
    let q5 = λ (st: MachineState<IoMemory>) => q4(st) ∧ (read_gpr(Rdi, st.gprs) = page_word());
    let setup = runs_seq(q0, eof_rip(ca(l_setup())), q1, eof_rip(ca(l_setup_mask())), q5, eof_rip(ca(l_row())),
        runs_block(row_setup1(), io_entry(), ca(l_setup()), q0, q1,
            λ st held => framed_resident(file, page, sv, canonical_block_bytes(row_setup1()), eof_rip(ca(l_setup())), here(l_setup()), st, held.left),
            λ st held same => ⟨⟨framed_moved(file, page, sv, execute_block_normal(row_setup1(), st), st, same, held.left), held.right⟩, ⟨refl, refl⟩⟩),
        runs_seq(q1, eof_rip(ca(l_setup_mask())), q2, eof_rip(ca(l_setup_w())), q5, eof_rip(ca(l_row())),
            runs_frame_load(file, page, sv, ca(l_setup_mask()), 16, { omega }, R13, here(l_setup_mask()), q1, q2, λ _ held => held.left.left,
                λ _ held => held.right.right, λ st held framed => ⟨⟨framed, held.left.right⟩, ⟨held.right.left, refl⟩⟩),
            runs_seq(q2, eof_rip(ca(l_setup_w())), q3, eof_rip(ca(l_setup_width())), q5, eof_rip(ca(l_row())),
                runs_block(slot_block(17), io_entry(), ca(l_setup_w()), q2, q3,
                    λ st held => framed_resident(file, page, sv, canonical_block_bytes(slot_block(17)), eof_rip(ca(l_setup_w())), here(l_setup_w()), st,
                        held.left.left),
                    λ st held same => ⟨⟨⟨framed_moved(file, page, sv, execute_block_normal(slot_block(17), st), st, same, held.left.left), held.left.right⟩,
                        held.right⟩, refl⟩),
                runs_seq(q3, eof_rip(ca(l_setup_width())), q4, eof_rip(ca(l_setup_page())), q5, eof_rip(ca(l_row())),
                    runs_frame_load(file, page, sv, ca(l_setup_width()), 17, { omega }, R14, here(l_setup_width()), q3, q4,
                        λ _ held => held.left.left.left, λ _ held => held.right,
                        λ st held framed => ⟨⟨⟨framed, held.left.left.right⟩, held.left.right⟩, refl⟩),
                    runs_block(page_block(), io_entry(), ca(l_setup_page()), q4, q5,
                        λ st held => framed_resident(file, page, sv, canonical_block_bytes(page_block()), eof_rip(ca(l_setup_page())), here(l_setup_page()),
                            st, held.left.left.left),
                        λ st held same => ⟨⟨⟨⟨framed_moved(file, page, sv, execute_block_normal(page_block(), st), st, same, held.left.left.left),
                            held.left.left.right⟩, held.left.right⟩, held.right⟩, refl⟩)))));
    let w_small: (width < Nat::pow(2, 64)) = { let top: (21 <= Nat::pow(2, 64)) = Nat::leb_sound(21, Nat::pow(2, 64), trivial); omega };
    let whole = runs_seq(p, eof_rip(ca(l_spill())), q0, eof_rip(ca(l_setup())), q5, eof_rip(ca(l_row())),
        runs_post(p, eof_rip(ca(l_spill())), SpillPre(file, page, sv, g), q0, eof_rip(ca(l_setup())), spilled,
            λ _ held => ⟨held.left, held.right.right.right.right.right.right.right⟩),
        setup);
    runs_elim(p, eof_rip(ca(l_spill())), q5, eof_rip(ca(l_row())), RowReady(file, mask, width, n, failed, totals, counts, vars, rsp0, state),
        whole, state, rip_is, ⟨Exists(frame, ⟨memory_is, holds⟩), write_kept_refl(g)⟩, λ s5 steps5 rip5 at5 => {
            let f5 = at5.left.left.left.left.witness;
            let framed5 = at5.left.left.left.left.proof;
            let img = with_frame(file, f5);
            let in_slots: CountsAt(img, slot_at(0), counts) = slots_counts(file, f5, sv, framed5.right, 0, trivial, counts,
                λ i below => j(zero_plus(i), λ q _ => sv(q) = counts(i), (spill_set(counts, 8, vars, 0, i, { omega }, below, trivial)).left));
            have ran = row_runs(img, eof_rip(ca(l_row())), here(l_row())(f5), page, width, mask, slot_at(0), counts, in_slots, 0, s5,
                framed5.left, rip5, trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), at5.right), page_word_value()), at5.left.left.right.left,
                trans(at5.left.left.right.right, held2.mask_is),
                trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(at5.left.right, held2.width_is)), toNat_word_of_nat(64, width, w_small)),
                { omega });
            let row_out = ran.proof.right;
            RowReady(after := ran.witness, frame := f5, vars := sv, page := row_out.page,
                steps := linux_steps_trans(io, state, s5, ran.witness, steps5, ran.proof.left),
                memory_is := row_out.memory_is, rip_is := trans(row_out.rip_is, rip_compose(io_entry(), ca(l_row()), row_len())),
                holds := framed5.right, held := held2, high := high, stored := row_out.holds.held, rdi := row_out.rdi,
                rsp_is := trans(row_out.kept.rsp, at5.left.left.left.right))
        })
}

// ---------------------------------------------------------------------------
// A file's reads (`l_state_init`): the state zeroed, then the filter's chunk loop
// reading the fd in RSP, until the empty read goes to the spill (`l_spill`), and a
// failed read goes there too with the status set first. The chunk loop is
// the filter's, over the program's representation with RSP pinned to the fd.

fn fd_rep<C>(rep: Gprs → C → Type, fd: BitVec(64)) → Gprs → C → Type { λ g s => rep(g, s) ∧ (read_gpr(Rsp, g) = fd) }
fn fd_shape<C>(shape: FilterShape<C>, fd: BitVec(64)) → FilterShape<C> {
    FilterShape(step := shape.step, init := shape.init, counts := shape.counts, rep := fd_rep(shape.rep, fd), code := shape.code)
}
// The step keeps RSP, so it keeps the fd.
theorem fd_step_piece<C>(shape: FilterShape<C>, piece: StepPiece<IoMemory, C>(shape.code, shape.rep, shape.counts, shape.step), fd: BitVec(64)):
    StepPiece<IoMemory, C>(shape.code, fd_rep(shape.rep, fd), shape.counts, shape.step) {
    λ before s b held rax fit => {
        let r = piece(before, s, b, held.left, rax, fit);
        StepRan(after := r.after, execution := r.execution, layout := r.layout, decoding := r.decoding,
            next_held := ⟨r.next_held, trans(r.registers_preserved(Rsp, trivial), held.right)⟩,
            flag_is := r.flag_is, byte_is := r.byte_is, memory_preserved := r.memory_preserved, rip_correct := r.rip_correct,
            registers_preserved := r.registers_preserved)
    }
}
theorem fd_loop_facts<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), fd: BitVec(64)): LoopFacts<C>(fd_shape(shape, fd)) {
    LoopFacts(piece := fd_step_piece(shape, facts.piece, fd),
        framed := λ before after carry kept rsp held => ⟨facts.framed(before, after, carry, kept, held.left), trans(rsp, held.right)⟩,
        advances := facts.advances, zero := facts.zero)
}

// What runs at the spill after all of `input` was read, for any status and
// any frame holding the selection, the width, the count and the totals, and
// agreeing with `vars0` from the cursor's slot on.
fn SpillGoes<C>(file: IoImage, shape: FilterShape<C>, fd: BitVec(64), mask: BitVec(64), width, n: Nat, totals, vars0: Nat → BitVec(64),
    input: List<BitVec(8)>, after: Bool → List<LinuxEvent>) → Type {
    (failed: Bool) → (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) →
        Vars(vars, mask, width, n, failed, totals) → ((m: Nat) → 19 <= m → vars(m) = vars0(m)) → (page: Nat → BitVec(8)) →
        (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) → state.rip = eof_rip(ca(l_spill())) →
        shape.rep(state.gprs, filter_state(shape.step, input, shape.init)) → read_gpr(Rsp, state.gprs) = fd →
        LinuxRuns(io_linux(), after(failed), state)
}

// A failed read other than EINTR (`l_read_failed`): past the retry test, the status set
// to 1, then the spill. One stretch (elf64_straight).
theorem read_failed<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    shape: FilterShape<C>, framed: StateFramed(shape.rep), fd: BitVec(64), mask: BitVec(64), width, n: Nat, totals, vars0: Nat → BitVec(64),
    input: List<BitVec(8)>, after: Bool → List<LinuxEvent>, goes: SpillGoes(file, shape, fd, mask, width, n, totals, vars0, input, after),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool, values: Vars(vars, mask, width, n, failed, totals),
    agree: (m: Nat) → 19 <= m → vars(m) = vars0(m), page: Nat → BitVec(8), errno: Nat, error: Errno(errno), other: Not(errno = eintr()),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_read_failed())), rax: read_gpr(Rax, state.gprs) = errno_word(errno),
    rep: shape.rep(state.gprs, filter_state(shape.step, input, shape.init)), rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), after(True), state) {
    let one = status_word(True);
    let clear: (is_zero_bits(64, read_gpr(Rax, state.gprs).add(BitVec::ofNat(4))) = False) =
        trans(cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.add(BitVec::ofNat(4))), rax), other_errno_plus_four(errno, error, other));
    // The retry test, the JZ passed, the status set, the JMP back to the spill.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io_linux(), after(True), s), runs_back(after(True)),
        l_rfail_jmp(), refl, 5, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
        ⟨λ yes => absurd(trans(sym(yes), clear)),
         λ _ => Exists(18, ⟨trivial, ⟨refl, λ s at fr same => goes(True, fr.witness, set_var(vars, 18, one), fr.proof.right,
            status_vars(vars, mask, width, n, failed, totals, values, True),
            λ m above => trans(set_var_other(vars, 18, one, m, ne_above(m, 18, { omega })), agree(m, above)),
            page, s, fr.proof.left, trans(at, cmd_lands_back(l_rfail_store(), 5, t_spill(), ca(l_spill()), cmd_j_rfail_jmp())),
            framed(state.gprs, s.gprs, filter_state(shape.step, input, shape.init),
                j(sym(same), λ x _ => StateKept(x.gprs, state.gprs), ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩), rep),
            trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsp, x.gprs), same), rsp))⟩⟩)⟩)
}

// The process the reads run, as filter_process's but reading the fd in RSP,
// with the spill after the empty read and after a failed one.
theorem cmd_process<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj),
    fd: BitVec(64), mask: BitVec(64), width, n: Nat, totals, vars0: Nat → BitVec(64), rows: List<BitVec(8)> → Bool → List<LinuxEvent>,
    input: List<BitVec(8)>, room: FilterRoom(shape.counts, input),
    goes: SpillGoes(file, shape, fd, mask, width, n, totals, vars0, input, λ f => rows(input, f)),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool, values: Vars(vars, mask, width, n, failed, totals),
    agree: (m: Nat) → 19 <= m → vars(m) = vars0(m)):
    EofProcess<List<WriteStep>, WriteFailure>(FdIn(Rsp), fd, with_frame(file, frame), ca(l_head()), ca(l_read_failed()), ca(l_spill()),
        filter_inv(fd_shape(shape, fd)), input, filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape),
        λ seen _ => rows(seen, True), rows(input, failed)) {
    let img = with_frame(file, frame);
    let fs = fd_shape(shape, fd);
    let loop = fd_loop_facts(shape, facts, fd);
    let pieces = cmd_at(img, letters, default, spill, shape.code, jumps, pj, placed(frame));
    let core = λ (pg: Nat → BitVec(8)) => filter_core(IoMemory(img, pg), ca(l_core()), shape.code, jumps, pj, cmd_core_at(img, letters, default, spill, shape.code, jumps, pj, placed(frame))(pg));
    EofProcess(
        reads := λ _ _ held => held.right,
        framed := λ seen before after kept held => ⟨facts.framed(before, after, filter_state(shape.step, seen, shape.init),
            ⟨kept.right.right.right.right.right.right.left, ⟨kept.right.right.right.right.right.right.right.left,
                ⟨kept.right.right.right.right.right.right.right.right, kept.right.right.left⟩⟩⟩, held.left), trans(kept.right.left, held.right)⟩,
        chunk := λ pg seen bytes rest writes some fits written prefix going rip_is memory_is length_word held after next =>
            filter_chunk(fs, loop, jumps, pj, ca(l_core()), ca(l_head()), targets, img, core, pg, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(fs, loop, input, seen, bytes, room,
                    λ front back chunk => chunk_within(seen, front, back, bytes, rest, input, chunk, prefix)),
                going, memory_is, trans(rip_is, cmd_core_from_head()), length_word, held, writes, written, Finished, trivial, after,
                λ next_page st at_read in_page placed2 => next(next_page, st, at_read, in_page,
                    j(sym(filter_state_append(shape.step, seen, bytes, shape.init)), λ t _ => fd_rep(shape.rep, fd)(st.gprs, t), placed2))),
        ends := λ pg seen bytes failure some fits failed2 all going rip_is memory_is length_word held =>
            filter_chunk(fs, loop, jumps, pj, ca(l_core()), ca(l_head()), targets, img, core, pg, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(fs, loop, input, seen, bytes, room,
                    λ front back chunk => ended_within(seen, front, back, bytes, input, chunk, fits, all)),
                going, memory_is, trans(rip_is, cmd_core_from_head()), length_word, held, failure.writes,
                writes_for_of(chunk_out(shape, seen, bytes), failure.writes, failed2.left, failed2.right.left),
                WriteFailedWith(failure.errno), failed2.right.right, Nil, failed2.left),
        fails := λ pg junk seen errno error other all st rip_is memory_is rax held =>
            j(sym(all), λ t _ => fd_rep(shape.rep, fd)(st.gprs, filter_state(shape.step, t, shape.init)) → LinuxRuns(io_linux(), rows(t, True), st),
                λ h => read_failed(file, letters, default, spill, shape.code, jumps, pj, placed, shape, facts.framed, fd, mask, width, n, totals,
                    vars0, input, λ f => rows(input, f), goes, frame, vars, holds, failed, values, agree,
                    io_store_offset(IoMemory(img, pg), 0, junk).page, errno, error, other, st, memory_is, rip_is, rax, h.left, h.right))(held),
        at_end := λ pg st at_done in_page held => goes(failed, frame, vars, holds, values, agree, pg, st, in_page, at_done, held.left, held.right))
}

// The reads, from the state's zeroing (`l_state_init`) with the fd in RSP.
theorem read_pass<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj),
    fd: BitVec(64), mask: BitVec(64), width, n: Nat, totals, vars0: Nat → BitVec(64), rows: List<BitVec(8)> → Bool → List<LinuxEvent>,
    steps: List<EofStep<List<WriteStep>>>, ok: FilterSteps(shape, steps), ending: EofEnd<WriteFailure>,
    ending_ok: FilterEndingOk(shape, steps, ending), room: FilterRoom(shape.counts, eof_input(steps)),
    goes: SpillGoes(file, shape, fd, mask, width, n, totals, vars0, eof_input(steps), λ f => rows(eof_input(steps), f)),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool, values: Vars(vars, mask, width, n, failed, totals),
    agree: (m: Nat) → 19 <= m → vars(m) = vars0(m), page: Nat → BitVec(8), state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(with_frame(file, frame), page), rip_is: state.rip = eof_rip(ca(l_state_init())),
    rsp: read_gpr(Rsp, state.gprs) = fd):
    LinuxRuns(io_linux(), eof_run(fd, filter_body(shape), filter_failed(shape), λ seen _ => rows(seen, True), steps, ending,
        rows(eof_input(steps), failed), Nil), state) {
    let img = with_frame(file, frame);
    let input = eof_input(steps);
    let pieces = cmd_at(img, letters, default, spill, shape.code, jumps, pj, placed(frame));
    let process = cmd_process(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, fd, mask, width, n, totals, vars0, rows,
        input, room, goes, frame, vars, holds, failed, values, agree);
    let layout: EofLayout(FdIn(Rsp), img, ca(l_head()), ca(l_read_failed()), ca(l_spill()), cmd_ed(), cmd_sd(), cmd_d(l_retry_jz())) =
        EofLayout(head := λ pg => read_head(FdIn(Rsp), IoMemory(img, pg), ca(l_head()), cmd_ed(), cmd_sd(), pieces(l_head())(pg)), fail := λ pg => RetryTail(pieces(l_read_failed())(pg), pieces(l_retry_jz())(pg)),
            to_end := jumps_back(io_entry(), rh_at_jz(FdIn(Rsp), ca(l_head())), 6, cmd_ed(), ca(l_spill()), cmd_j_head_ed()),
            to_fail := jumps_back(io_entry(), rh_at_js(FdIn(Rsp), ca(l_head())), 6, cmd_sd(), ca(l_read_failed()), cmd_j_head_sd()),
            to_read := jumps_forward(io_entry(), ca(l_retry_jz()), 6, cmd_d(l_retry_jz()), ca(l_head()), cmd_j_retry_jz()));
    let started = run_block(img, page, state_init_block(), io_entry(), ca(l_state_init()), pieces(l_state_init()), state, memory_is, rip_is);
    let ready = execute_block_normal(state_init_block(), state);
    let init_held: filter_inv(fd_shape(shape, fd))(Nil, ready.gprs) = ⟨facts.initialised(state), rsp⟩;
    linux_runs_after_steps(io_linux(), eof_run(fd, filter_body(shape), filter_failed(shape), λ seen _ => rows(seen, True), steps, ending,
        rows(input, failed), Nil), state, ready, started.steps,
        eof_from(FdIn(Rsp), fd, img, ca(l_head()), ca(l_read_failed()), ca(l_spill()), cmd_ed(), cmd_sd(), cmd_d(l_retry_jz()), layout,
            filter_inv(fd_shape(shape, fd)), input, filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape),
            λ seen _ => rows(seen, True), rows(input, failed), process, ending, ending_ok, steps)(Nil, ok, page, refl, ready, started.rip_is,
            started.memory_is, init_held))
}

// After the reads, a named file's row: the spill and the counts' row, then
// its writes and close (`named_runs`), back to the operand loop.
theorem row_short(l, width: Nat, le: l <= 8 * (width + 21), narrow: width <= 20): l < 4096 { omega }
theorem named_spill<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, n: Nat, nonzero: 0 < n, few: n < Nat::pow(2, 64), c19, c20: BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>, totals, vars0: Nat → BitVec(64), at19: vars0(19) = c19, at20: vars0(20) = c20,
    pointer: BitVec(64), at22: vars0(22) = pointer, name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), some: 0 < name.len(), fits: name.len() <= 4096,
    run: OperandRun, input: List<BitVec(8)>,
    goes: LoopGoes(file, mask, width, n, c19, c20, add_counts(totals, input_counts(shape, column, input)), rest),
    counts_ok: RowWriteOk(row_counts(width, mask, input_counts(shape, column, input)) ++ [field_gap()], run.counts),
    named_ok: RowWriteOk(name, run.name), nl_ok: RowWriteOk([newline()], run.newline),
    closes: Bool, closes_is: vars0(23) = status_word(closes), fd: BitVec(64), returns: CloseReturns(run.closed)):
    SpillGoes(file, shape, fd, mask, width, n, totals, vars0, input,
        λ f => named_row(shape, column, mask, width, name, run, fd, closes, input, f, totals, rest)) {
    λ failed frame vars holds values agree page state memory_is rip_is rep rsp => {
        let counts = input_counts(shape, column, input);
        have ready = spill_row(file, letters, default, spill, shape.code, jumps, pj, placed, frame, vars, holds, mask, width, n, failed, totals,
            values, narrow, counts, page, state, memory_is, rip_is,
            λ m below => spilled(m, below, state.gprs, filter_state(shape.step, input, shape.init), rep));
        let row = row_counts(width, mask, counts);
        linux_runs_after_linux_steps(io_linux(), named_row(shape, column, mask, width, name, run, fd, closes, input, failed, totals, rest), state,
            ready.after, ready.steps,
            named_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, width, n, c19, c20, rest, add_counts(totals, counts), goes, ready.frame, ready.vars,
                ready.holds, failed, ready.held, trans(ready.high(19, trivial), trans(agree(19, trivial), at19)),
                trans(ready.high(20, trivial), trans(agree(20, trivial), at20)), nonzero, few, row,
                row_short(row.len(), width, row_counts_le(width, mask, counts), narrow), run.counts, counts_ok, pointer,
                trans(ready.high(22, trivial), trans(agree(22, trivial), at22)), name, string, low, some, fits, run.name, named_ok, run.newline,
                nl_ok, closes, trans(ready.high(23, trivial), trans(agree(23, trivial), closes_is)), fd, run.closed, returns,
                ready.page, ready.after, ready.memory_is, ready.rip_is, ready.stored, ready.rdi, trans(ready.rsp_is, rsp)))
    }
}
// With no operand, stdin's row and the exit (`unnamed_runs`).
theorem unnamed_spill<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, totals, vars0: Nat → BitVec(64), run: OperandRun, input: List<BitVec(8)>,
    counts_ok: RowWriteOk(row_counts(width, mask, input_counts(shape, column, input)) ++ [newline()], run.counts), fd: BitVec(64)):
    SpillGoes(file, shape, fd, mask, width, 0, totals, vars0, input, λ f => stdin_row(shape, column, mask, width, run, input, f)) {
    λ failed frame vars holds values agree page state memory_is rip_is rep rsp => {
        let counts = input_counts(shape, column, input);
        have ready = spill_row(file, letters, default, spill, shape.code, jumps, pj, placed, frame, vars, holds, mask, width, 0, failed, totals,
            values, narrow, counts, page, state, memory_is, rip_is,
            λ m below => spilled(m, below, state.gprs, filter_state(shape.step, input, shape.init), rep));
        let row = row_counts(width, mask, counts);
        linux_runs_after_linux_steps(io_linux(), stdin_row(shape, column, mask, width, run, input, failed), state, ready.after, ready.steps,
            unnamed_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, width, ready.frame, ready.vars, ready.holds, failed,
                add_counts(totals, counts), ready.held, row, row_short(row.len(), width, row_counts_le(width, mask, counts), narrow), run.counts,
                counts_ok, ready.page, ready.after, ready.memory_is, ready.rip_is, ready.stored, ready.rdi))
    }
}

// ---------------------------------------------------------------------------
// The operand loop (`l_loop`): the cursor's slots loaded, the cursor run to the
// next operand, its slots stored back; no operand left goes to the total
// row, and an operand is read as stdin (`-`) or opened.

// A slot past the status, other than the count's, leaves what Vars says.
theorem slot_vars(vars: Nat → BitVec(64), mask: BitVec(64), width, n: Nat, failed: Bool, totals: Nat → BitVec(64),
    held: Vars(vars, mask, width, n, failed, totals), q: Nat, w: BitVec(64), low: 18 < q, other: Not(q = 21)):
    Vars(set_var(vars, q, w), mask, width, n, failed, totals) {
    Vars(mask_is := trans(set_var_other(vars, q, w, 16, ne_below(16, q, { omega })), held.mask_is),
        width_is := trans(set_var_other(vars, q, w, 17, ne_below(17, q, { omega })), held.width_is),
        status_is := trans(set_var_other(vars, q, w, 18, ne_below(18, q, low)), held.status_is),
        count_is := trans(set_var_other(vars, q, w, 21, λ same => other(sym(same))), held.count_is),
        totals_is := λ i below => trans(set_var_other(vars, q, w, 8 + i, ne_below(8 + i, q, { omega })), held.totals_is(i, below)))
}

// The cursor's slots into RBX and R12, then the cursor.
// What follows the cursor: from where it starts (`l_cursor`), with the frame
// that holds `vars` and the cursor run from there.
fn CursorGoes(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), rsp: BitVec(64), origin: Gprs, ops: List<List<BitVec(8)>>,
    events: List<LinuxEvent>) → Type {
    (frame: Nat → BitVec(8)) → FrameHolds(frame, vars) → (state: MachineState<IoMemory>) →
        CursorReach(with_frame(file, frame), page, eof_rip(ca(l_cursor())), rsp, origin, ops, state) → LinuxRuns(io_linux(), events, state)
}
// Slots 19 and 20 into RBX and R12 (one stretch, elf64_straight), then the
// cursor.
theorem loop_cursor(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    vars: Nat → BitVec(64), rsp: BitVec(64), k: Nat, ended: Bool,
    args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, argv: ArgvStays(file, rsp, args, pointers, k),
    at19: vars(19) = argv_slot(rsp, k), at20: vars(20) = ended_word(ended), events: List<LinuxEvent>,
    page: Nat → BitVec(8), state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_loop())), then: CursorGoes(file, page, vars, rsp, state.gprs, operands_from(ended, args), events)):
    LinuxRuns(io_linux(), events, state) {
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io_linux(), events, s), runs_back(events),
        l_loop_ended_load(), refl, 4, vars, state, rip_is, framed,
        Exists(19, ⟨trivial, ⟨refl, Exists(20, ⟨trivial, ⟨refl, λ s at fr same => {
            let img = with_frame(file, fr.witness);
            let head: CursorAt(img, page, eof_rip(ca(l_cursor())), rsp, k, ended, state.gprs, s) = CursorAt(memory_is := fr.proof.left, rip_is := at,
                regs := j(sym(same), λ x _ => CursorRegs(rsp, k, ended, state.gprs, x.gprs),
                    ⟨at19, ⟨at20, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩));
            then(fr.witness, fr.proof.right, s, cursor_runs(img, eof_rip(ca(l_cursor())),
                cmd_at(img, letters, default, spill, code, jumps, pj, placed(fr.witness))(l_cursor()), page, rsp, k, ended, args, pointers, state.gprs, s,
                argv, head))
        }⟩⟩)⟩⟩))
}

// Past the cursor (`l_cstore`): RBX and R12 back in their slots 19 and 20.
// No operand left: RSI zero, JE to the total row.
theorem loop_last(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), width, n: Nat, failed: Bool,
    totals: Nat → BitVec(64), values: Vars(vars, mask, width, n, failed, totals), narrow: width <= 20, few: n < Nat::pow(2, 64),
    total: RowWrite, ok: TotalOk(mask, width, n, total, totals),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_cstore())), rsi: read_gpr(Rsi, state.gprs) = word_zero()):
    LinuxRuns(io_linux(), total_events(mask, width, n, total, failed, totals), state) {
    let events = total_events(mask, width, n, total, failed, totals);
    let c19 = read_gpr(Rbx, state.gprs);
    let c20 = read_gpr(R12, state.gprs);
    let cv = set_var(set_var(vars, 19, c19), 20, c20);
    let zero: (is_zero_bits(64, read_gpr(Rsi, state.gprs).sub(word_zero())) = True) =
        trans(cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), rsi), zero_bits_sub_self(64, word_zero()));
    // The cursor into slots 19 and 20, RSI against zero, the JE taken.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io_linux(), events, s), runs_back(events),
        l_last_je(), refl, 6, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
        Exists(19, ⟨trivial, ⟨refl, Exists(20, ⟨trivial, ⟨refl,
            ⟨λ _ after at framed _ => total_runs(file, letters, default, spill, code, jumps, pj, placed, framed.witness, cv, framed.proof.right, mask,
                width, n, failed, totals,
                slot_vars(set_var(vars, 19, c19), mask, width, n, failed, totals, slot_vars(vars, mask, width, n, failed, totals, values, 19, c19, trivial,
                    ne_below(19, 21, trivial)), 20, c20, trivial, ne_below(20, 21, trivial)),
                narrow, few, total, ok, page, after, framed.proof.left,
                trans(at, cmd_lands(l_last(), 6, t_total(), ca(l_total()), cmd_j_last_je()))),
             λ no => absurd(trans(sym(no), zero))⟩⟩⟩)⟩⟩))
}

// An operand (RSI not zero): past the JE, its name's pointer into slot 22.
record OperandAt(file: IoImage, page: Nat → BitVec(8), mask: BitVec(64), width, n: Nat, failed: Bool, totals: Nat → BitVec(64),
    c19, c20, pointer: BitVec(64), before: MachineState<IoMemory>) {
    after: MachineState<IoMemory>,
    frame: Nat → BitVec(8),
    vars: Nat → BitVec(64),
    steps: LinuxSteps(io_linux(), before, after),
    memory_is: after.memory = IoMemory(with_frame(file, frame), page),
    rip_is: after.rip = eof_rip(ca(l_dash_load())),
    holds: FrameHolds(frame, vars),
    values: Vars(vars, mask, width, n, failed, totals),
    at19: vars(19) = c19,
    at20: vars(20) = c20,
    at22: vars(22) = pointer,
    rsi: read_gpr(Rsi, after.gprs) = pointer,
}
theorem operand_at_back(file: IoImage, page: Nat → BitVec(8), mask: BitVec(64), width, n: Nat, failed: Bool, totals: Nat → BitVec(64),
    c19, c20, pointer: BitVec(64)): StepsBack(λ s => OperandAt(file, page, mask, width, n, failed, totals, c19, c20, pointer, s)) {
    λ before after steps at => OperandAt(after := at.after, frame := at.frame, vars := at.vars,
        steps := linux_steps_trans(io_linux(), before, after, at.after, steps, at.steps), memory_is := at.memory_is, rip_is := at.rip_is,
        holds := at.holds, values := at.values, at19 := at.at19, at20 := at.at20, at22 := at.at22, rsi := at.rsi)
}
theorem operand_head(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), width, n: Nat, failed: Bool,
    totals: Nat → BitVec(64), values: Vars(vars, mask, width, n, failed, totals), pointer: BitVec(64), nonzero: 0 < pointer.toNat(),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_cstore())), rsi: read_gpr(Rsi, state.gprs) = pointer):
    OperandAt(file, page, mask, width, n, failed, totals, read_gpr(Rbx, state.gprs), read_gpr(R12, state.gprs), pointer, state) {
    let c19 = read_gpr(Rbx, state.gprs);
    let c20 = read_gpr(R12, state.gprs);
    let w = read_gpr(Rsi, state.gprs);
    let cv = set_var(set_var(vars, 19, c19), 20, c20);
    let nonzero_flag: (is_zero_bits(64, w.sub(word_zero())) = False) =
        trans(cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), rsi),
            trans(zero_bits_sub(64, pointer, word_zero()), nonzero_word(pointer, nonzero)));
    // The cursor into slots 19 and 20, RSI against zero, the JE passed, the
    // name's pointer into slot 22.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page,
        λ s => OperandAt(file, page, mask, width, n, failed, totals, c19, c20, pointer, s), operand_at_back(file, page, mask, width, n, failed, totals,
            c19, c20, pointer),
        l_name_store(), refl, 8, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
        Exists(19, ⟨trivial, ⟨refl, Exists(20, ⟨trivial, ⟨refl,
            ⟨λ yes => absurd(trans(sym(yes), nonzero_flag)),
             λ _ => Exists(22, ⟨trivial, ⟨refl, λ after at framed same =>
                OperandAt(after := after, frame := framed.witness, vars := set_var(cv, 22, w), steps := Exists(0, refl),
                    memory_is := framed.proof.left, rip_is := at, holds := framed.proof.right,
                    values := slot_vars(cv, mask, width, n, failed, totals,
                        slot_vars(set_var(vars, 19, c19), mask, width, n, failed, totals, slot_vars(vars, mask, width, n, failed, totals, values, 19, c19,
                            trivial, ne_below(19, 21, trivial)), 20, c20, trivial, ne_below(20, 21, trivial)), 22, w, trivial, ne_above(22, 21, trivial)),
                    at19 := refl, at20 := refl, at22 := rsi,
                    rsi := trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsi, x.gprs), same), rsi))⟩⟩)⟩⟩⟩)⟩⟩))
}

// The name's first byte against `-` (`l_dash_load`), and after a `-` its second
// against NUL (`l_ahead`): `-` alone is stdin (`l_dash`), anything else is
// opened (`l_open`). Either goes on from whichever frame holds `vars`.
fn StdinAt(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), events: List<LinuxEvent>) → Type {
    (state: MachineState<IoMemory>) → Framed(file, page, vars)(state) → state.rip = eof_rip(ca(l_dash())) → LinuxRuns(io_linux(), events, state)
}
fn OpenAt(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer: BitVec(64), events: List<LinuxEvent>) → Type {
    (state: MachineState<IoMemory>) → Framed(file, page, vars)(state) → state.rip = eof_rip(ca(l_open())) →
        read_gpr(Rsi, state.gprs) = pointer → LinuxRuns(io_linux(), events, state)
}
theorem below_from(a, v, l: Nat, at: a = v, low: v + l + 1 <= Nat::pow(2, 47)): a < Nat::pow(2, 47) { omega }
theorem ahead_low(v, l: Nat, low: v + Succ(l) + 1 <= Nat::pow(2, 47)): Succ(v) < Nat::pow(2, 47) { omega }
theorem lt_from(a, b, m: Nat, at: a = b, below: b < m): a < m { omega }
theorem stdin_not_dash(b: BitVec(8), rest: List<BitVec(8)>, no: b.eq_bit(dash()) = False): names_stdin(Cons(b, rest)) = False {
    match rest as λ r => names_stdin(Cons(b, r)) = False { Nil => no, Cons(_, _) => refl }
}
// The byte a name starts with, its NUL when it is empty; and the next byte,
// read past a first that is not its NUL.
fn first_byte(name: List<BitVec(8)>) → BitVec(8) { match name { Nil => nul(), Cons(b, _) => b } }
theorem first_reads(file: IoImage, page: Nat → BitVec(8), pointer: BitVec(64), name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    frame: Nat → BitVec(8)): io_data_access().read(IoMemory(with_frame(file, frame), page), pointer) = Some(first_byte(name)) {
    (match name as λ nm => ArgStays(file, pointer, nm) →
            io_data_access().read(IoMemory(with_frame(file, frame), page), pointer) = Some(first_byte(nm)) {
        Nil => λ held => trans(name_byte(file, page, pointer.toNat(), pointer, 0, refl, frame), held(frame, page)),
        Cons(_, _) => λ held => trans(name_byte(file, page, pointer.toNat(), pointer, 0, refl, frame), (held(frame, page)).left),
    })(string)
}
theorem second_reads(file: IoImage, page: Nat → BitVec(8), pointer, a: BitVec(64), at: a.toNat() = Succ(pointer.toNat()), b: BitVec(8),
    rest: List<BitVec(8)>, string: ArgStays(file, pointer, Cons(b, rest)), frame: Nat → BitVec(8)):
    io_data_access().read(IoMemory(with_frame(file, frame), page), a) = Some(first_byte(rest)) {
    (match rest as λ r => ArgStays(file, pointer, Cons(b, r)) →
            io_data_access().read(IoMemory(with_frame(file, frame), page), a) = Some(first_byte(r)) {
        Nil => λ held => trans(name_byte(file, page, pointer.toNat(), a, 1, at, frame), (held(frame, page)).right.right),
        Cons(_, _) => λ held => trans(name_byte(file, page, pointer.toNat(), a, 1, at, frame), (held(frame, page)).right.right.left),
    })(string)
}
// What a tested byte's flag says (`cmp_bytes`), as the JNE reads it.
theorem byte_differs(c: Bool, ne: !c = True): c = False { match c as λ x => !x = True → x = False { False => λ _ => refl, True => λ no => absurd(no) }(ne) }
theorem byte_same(c: Bool, eq: !c = False): c = True { match c as λ x => !x = False → x = True { False => λ no => absurd(no), True => λ _ => refl }(eq) }
// Which the name is, from its bytes' tests.
theorem stdin_of_first(name: List<BitVec(8)>, no: first_byte(name).eq_bit(dash()) = False): names_stdin(name) = False {
    match name as λ nm => first_byte(nm).eq_bit(dash()) = False → names_stdin(nm) = False { Nil => λ _ => refl, Cons(b, rest) => λ h => stdin_not_dash(b, rest, h) }(no)
}
theorem stdin_of_second(b: BitVec(8), rest: List<BitVec(8)>, no: first_byte(rest).eq_bit(nul()) = False): names_stdin(Cons(b, rest)) = False {
    match rest as λ r => first_byte(r).eq_bit(nul()) = False → names_stdin(Cons(b, r)) = False { Nil => λ h => absurd(h), Cons(_, _) => λ _ => refl }(no)
}
theorem stdin_of_nul(file: IoImage, page: Nat → BitVec(8), pointer: BitVec(64), b: BitVec(8), rest: List<BitVec(8)>,
    string: ArgStays(file, pointer, Cons(b, rest)), dashed: b.eq_bit(dash()) = True, ends: first_byte(rest).eq_bit(nul()) = True):
    names_stdin(Cons(b, rest)) = True {
    (match rest as λ r => ArgStays(file, pointer, Cons(b, r)) → first_byte(r).eq_bit(nul()) = True → names_stdin(Cons(b, r)) = True {
        Nil => λ _ _ => dashed,
        Cons(c, _) => λ held is_nul => false_elim((held(file.frame, page)).right.right.right.left(BitVec::eq_of_eq_bit(8, c, nul(), is_nul))),
    })(string, ends)
}
// The two ends: the open, or stdin.
theorem dash_opens(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer: BitVec(64), name: List<BitVec(8)>,
    events: Bool → List<LinuxEvent>, on_open: names_stdin(name) = False → OpenAt(file, page, vars, pointer, events(False)),
    not_stdin: names_stdin(name) = False, state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_open())), rsi: read_gpr(Rsi, state.gprs) = pointer): LinuxRuns(io_linux(), events(names_stdin(name)), state) {
    j(sym(not_stdin), λ x _ => LinuxRuns(io_linux(), events(x), state), on_open(not_stdin)(state, framed, rip_is, rsi))
}
theorem dash_stdin(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), name: List<BitVec(8)>, events: Bool → List<LinuxEvent>,
    on_stdin: names_stdin(name) = True → StdinAt(file, page, vars, events(True)), stdin: names_stdin(name) = True,
    state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state), rip_is: state.rip = eof_rip(ca(l_dash()))):
    LinuxRuns(io_linux(), events(names_stdin(name)), state) {
    j(sym(stdin), λ x _ => LinuxRuns(io_linux(), events(x), state), on_stdin(stdin)(state, framed, rip_is))
}
// After a `-` (`l_ahead`): the second byte against NUL, the JNE to the open,
// else on to stdin. One stretch (elf64_straight).
theorem dash_ahead(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer: BitVec(64), name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), events: Bool → List<LinuxEvent>,
    on_stdin: names_stdin(name) = True → StdinAt(file, page, vars, events(True)),
    on_open: names_stdin(name) = False → OpenAt(file, page, vars, pointer, events(False)),
    dashed: first_byte(name).eq_bit(dash()) = True, state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_ahead())), rsi: read_gpr(Rsi, state.gprs) = pointer):
    LinuxRuns(io_linux(), events(names_stdin(name)), state) {
    let io = io_linux();
    (match name as λ nm => ArgStays(file, pointer, nm) → pointer.toNat() + nm.len() + 1 <= Nat::pow(2, 47) →
            (names_stdin(nm) = True → StdinAt(file, page, vars, events(True))) →
            (names_stdin(nm) = False → OpenAt(file, page, vars, pointer, events(False))) →
            first_byte(nm).eq_bit(dash()) = True → LinuxRuns(io, events(names_stdin(nm)), state) {
        Nil => λ _ _ _ _ no => {
            let never: (nul().eq_bit(dash()) = False) = refl;
            absurd(trans(sym(no), never))
        },
        Cons(b, rest) => λ held lw stdin opens yes => {
            let ahead = read_gpr(Rsi, state.gprs).add(one_byte().sign_extend(56));
            let near = ahead_low(pointer.toNat(), rest.len(), lw);
            let ahead_value: (ahead.toNat() = Succ(pointer.toNat())) =
                pointer_next(read_gpr(Rsi, state.gprs), pointer.toNat(), cong_fn<BitVec(64), Nat>(λ w => w.toNat(), rsi), near);
            let c = first_byte(rest);
            cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events(names_stdin(Cons(b, rest))), s),
                runs_back(events(names_stdin(Cons(b, rest)))), l_ahead_jne(), refl, 4, vars, state, rip_is, framed,
                Exists(c, Exists(ahead, ⟨refl, ⟨λ frame => second_reads(file, page, pointer, ahead, ahead_value, b, rest, held, frame),
                    ⟨lt_from(ahead.toNat(), Succ(pointer.toNat()), Nat::pow(2, 47), ahead_value, near),
                     ⟨λ ne after at fr same => dash_opens(file, page, vars, pointer, Cons(b, rest), events, opens,
                         stdin_of_second(b, rest, byte_differs(c.eq_bit(nul()), trans(sym(cong_fn<Bool, Bool>(λ x => !x, cmp_bytes(c, nul()))), ne))),
                         after, fr, trans(at, cmd_lands(l_ahead_test(), 6, t_open(), ca(l_open()), cmd_j_ahead_jne())),
                         trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsi, x.gprs), same), rsi)),
                      λ eq after at fr _ => dash_stdin(file, page, vars, Cons(b, rest), events, stdin,
                         stdin_of_nul(file, page, pointer, b, rest, held, yes,
                             byte_same(c.eq_bit(nul()), trans(sym(cong_fn<Bool, Bool>(λ x => !x, cmp_bytes(c, nul()))), eq))),
                         after, fr, at)⟩⟩⟩⟩)))
        },
    })(string, low, on_stdin, on_open, dashed)
}
// The first byte (`l_dash_load`) against `-`, the JNE to the open: one
// stretch (elf64_straight), on to `dash_ahead` past it.
theorem dash_test(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), pointer: BitVec(64), name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), events: Bool → List<LinuxEvent>,
    on_stdin: names_stdin(name) = True → StdinAt(file, page, vars, events(True)),
    on_open: names_stdin(name) = False → OpenAt(file, page, vars, pointer, events(False)),
    state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_dash_load())), rsi: read_gpr(Rsi, state.gprs) = pointer):
    LinuxRuns(io_linux(), events(names_stdin(name)), state) {
    let io = io_linux();
    let b = first_byte(name);
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events(names_stdin(name)), s),
        runs_back(events(names_stdin(name))), l_dash_jne(), refl, 3, vars, state, rip_is, framed,
        Exists(b, Exists(pointer, ⟨rsi, ⟨λ frame => first_reads(file, page, pointer, name, string, frame),
            ⟨below_from(pointer.toNat(), pointer.toNat(), name.len(), refl, low),
             ⟨λ ne after at fr same => dash_opens(file, page, vars, pointer, name, events, on_open,
                 stdin_of_first(name, byte_differs(b.eq_bit(dash()), trans(sym(cong_fn<Bool, Bool>(λ x => !x, cmp_bytes(b, dash()))), ne))),
                 after, fr, trans(at, cmd_lands(l_dash_test(), 6, t_open(), ca(l_open()), cmd_j_dash_jne())),
                 trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsi, x.gprs), same), rsi)),
              λ eq after at fr same => dash_ahead(file, letters, default, spill, code, jumps, pj, placed, page, vars, pointer, name, string, low, events,
                 on_stdin, on_open, byte_same(b.eq_bit(dash()), trans(sym(cong_fn<Bool, Bool>(λ x => !x, cmp_bytes(b, dash()))), eq)),
                 after, fr, at, trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsi, x.gprs), same), rsi))⟩⟩⟩⟩)))
}

// At the reads (`l_state_init`) with the operand's fd in RSP and slot 23 saying
// whether it is closed after: what runs, whatever the status.
fn ReadsGoes(file: IoImage, mask: BitVec(64), width, n: Nat, totals: Nat → BitVec(64), c19, c20, pointer, fd: BitVec(64), closes: Bool,
    events: Bool → List<LinuxEvent>) → Type {
    (failed: Bool) → (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) →
        Vars(vars, mask, width, n, failed, totals) → vars(19) = c19 → vars(20) = c20 → vars(22) = pointer →
        vars(23) = status_word(closes) → (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) →
        state.memory = IoMemory(with_frame(file, frame), page) → state.rip = eof_rip(ca(l_state_init())) → read_gpr(Rsp, state.gprs) = fd →
        LinuxRuns(io_linux(), events(failed), state)
}
// A file's reads and its row, then the operands after it.
theorem file_reads_runs<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, n: Nat, nonzero: 0 < n, few: n < Nat::pow(2, 64), c19, c20: BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>, totals: Nat → BitVec(64),
    pointer: BitVec(64), name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), some: 0 < name.len(), fits: name.len() <= 4096,
    run: OperandRun, ok: NamedOk<C>(shape, column, mask, width, name, run), fd: BitVec(64), closes: Bool,
    goes: LoopGoes(file, mask, width, n, c19, c20, add_counts(totals, input_counts(shape, column, eof_input(run.steps))), rest)):
    ReadsGoes(file, mask, width, n, totals, c19, c20, pointer, fd, closes,
        λ f => file_reads(shape, column, mask, width, name, run, fd, closes, f, totals, rest)) {
    λ failed frame vars holds values at19 at20 at22 at23 page state memory_is rip_is rsp =>
        read_pass(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, fd, mask, width, n, totals, vars,
            λ seen f => named_row(shape, column, mask, width, name, run, fd, closes, seen, f, totals, rest),
            run.steps, ok.reads.steps, run.ending, ok.reads.ending, ok.reads.room,
            named_spill(file, letters, default, spill, shape, jumps, pj, placed, column, spilled, mask, width, narrow, n, nonzero, few, c19, c20,
                rest, totals, vars, at19, at20, pointer, at22, name, string, low, some, fits, run, eof_input(run.steps), goes, ok.counts,
                ok.named, ok.newline, closes, at23, fd, ok.closed),
            frame, vars, holds, failed, values, λ m _ => refl, page, state, memory_is, rip_is, rsp)
}

theorem jmp_forward(d: BitVec(32), state: MachineState<IoMemory>, at: BitVec(64), from, to: Nat,
    rip_is: state.rip = next_rip(at, from), lands: JumpsForward(from, 5, d, to)):
    execute_near_control(JumpNear(d), state).rip = next_rip(at, to) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 5, d), rip_is), jumps_forward(at, from, 5, d, to, lands))
}

// `-` (`l_dash`): not closed after, fd 0, to the reads.
fn fd_zero_block() → List<Instruction> { [MovRI(Rsp, word_zero())] }
theorem stdin_path(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, totals: Nat → BitVec(64), c19, c20, pointer: BitVec(64), events: Bool → List<LinuxEvent>,
    reads: ReadsGoes(file, mask, width, n, totals, c19, c20, pointer, BitVec::zero(), False, events),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    values: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20, at22: vars(22) = pointer,
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_dash()))): LinuxRuns(io_linux(), events(failed), state) {
    let zero = word_zero();
    let vars2 = set_var(vars, 23, zero);
    // Slot 23 cleared (not closed after), RSP zero, the JMP to the reads.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io_linux(), events(failed), s),
        runs_back(events(failed)), l_dash_jmp(), refl, 4, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
        Exists(23, ⟨trivial, ⟨refl, λ after at framed same => reads(failed, framed.witness, vars2, framed.proof.right,
            slot_vars(vars, mask, width, n, failed, totals, values, 23, zero, trivial, ne_above(23, 21, trivial)),
            trans(set_var_other(vars, 23, zero, 19, ne_below(19, 23, trivial)), at19),
            trans(set_var_other(vars, 23, zero, 20, ne_below(20, 23, trivial)), at20),
            trans(set_var_other(vars, 23, zero, 22, ne_below(22, 23, trivial)), at22),
            set_var_same(vars, 23, zero), page, after, framed.proof.left,
            trans(at, cmd_lands(l_dash_fd(), 5, t_state_init(), ca(l_state_init()), cmd_j_dash_jmp())),
            cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsp, x.gprs), same))⟩⟩))
}

// Any other operand (`l_open`): openat(AT_FDCWD, name, O_RDONLY); a failed open
// sets the status and goes back to the loop, an opened fd goes into RSP, to
// be closed after, and to the reads.
fn open_events<C>(opened: OpenResult, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat,
    name: List<BitVec(8)>, run: OperandRun, failed: Bool, totals: Nat → BitVec(64), rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>)
    → List<LinuxEvent> {
    Cons(OpenEvent(name, opened), match opened {
        Opened(fd) => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, failed, totals, rest),
        OpenFailed(_) => rest(True, totals),
    })
}
fn OpenGoes<C>(opened: OpenResult, file: IoImage, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat,
    totals: Nat → BitVec(64), c19, c20, pointer: BitVec(64), name: List<BitVec(8)>, run: OperandRun,
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → Type {
    match opened {
        Opened(fd) => ReadsGoes(file, mask, width, n, totals, c19, c20, pointer, word_of_nat(64, fd), True,
            λ f => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, f, totals, rest)),
        OpenFailed(_) => LoopGoes(file, mask, width, n, c19, c20, totals, rest),
    }
}
fn open_block() → List<Instruction> { [MovRI(Rdi, at_fdcwd()), MovRI(Rdx, word_zero()), MovRI(Rax, BitVec::ofNat(257))] }
theorem fd_bounds(fd: Nat, below: fd < Nat::pow(2, 31)): (fd < Nat::pow(2, 63)) ∧ (fd < Nat::pow(2, 64)) {
    let a: (Nat::pow(2, 31) <= Nat::pow(2, 63)) = Nat::leb_sound(Nat::pow(2, 31), Nat::pow(2, 63), trivial);
    let b: (Nat::pow(2, 63) <= Nat::pow(2, 64)) = Nat::leb_sound(Nat::pow(2, 63), Nat::pow(2, 64), trivial);
    ⟨omega, omega⟩
}
// After the open returned (`l_open_test`): TEST, JS to the failed path, else the fd
// into RSP and slot 23 set, then the reads.
theorem open_back<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, totals: Nat → BitVec(64), c19, c20, pointer: BitVec(64),
    name: List<BitVec(8)>, run: OperandRun, rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), failed: Bool,
    values: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20, at22: vars(22) = pointer, opened: OpenResult):
    OpenReturns(opened) → OpenGoes<C>(opened, file, shape, column, mask, width, n, totals, c19, c20, pointer, name, run, rest) →
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) →
    state.rip = eof_rip(ca(l_open_test())) → read_gpr(Rax, state.gprs) = open_rax(opened) →
    LinuxRuns(io_linux(), match opened {
        Opened(fd) => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, failed, totals, rest),
        OpenFailed(_) => rest(True, totals),
    }, state) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    let img = with_frame(file, frame);
    let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
    match opened as λ o => OpenReturns(o) → OpenGoes<C>(o, file, shape, column, mask, width, n, totals, c19, c20, pointer, name, run, rest) →
            (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(img, page) →
            state.rip = eof_rip(ca(l_open_test())) → read_gpr(Rax, state.gprs) = open_rax(o) →
            LinuxRuns(io, match o {
                Opened(fd) => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, failed, totals, rest),
                OpenFailed(_) => rest(True, totals),
            }, state) {
        Opened(fd) => λ below reads page state memory_is rip_is rax => {
            let bounds = fd_bounds(fd, below);
            let word = word_of_nat(64, fd);
            let small: (word.toNat() < Nat::pow(2, 63)) = { let v = toNat_word_of_nat(64, fd, bounds.right); let w = bounds.left; omega };
            let one = status_word(True);
            let vars2 = set_var(vars, 23, one);
            let events = file_reads(shape, column, mask, width, name, run, word, True, failed, totals, rest);
            let clear: (read_gpr(Rax, state.gprs).band(read_gpr(Rax, state.gprs)).sign_bit() = False) =
                trans(cong_fn<BitVec(64), Bool>(λ v => v.band(v).sign_bit(), rax), test_self_nonnegative(word, small));
            // RAX tested, the JS passed, the fd into RSP and slot 23 set
            // (closed after), the JMP to the reads.
            cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
                l_opened_jmp(), refl, 5, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
                ⟨λ yes => absurd(trans(sym(yes), clear)),
                 λ _ => Exists(23, ⟨trivial, ⟨refl, λ after at framed same => reads(failed, framed.witness, vars2, framed.proof.right,
                    slot_vars(vars, mask, width, n, failed, totals, values, 23, one, trivial, ne_above(23, 21, trivial)),
                    trans(set_var_other(vars, 23, one, 19, ne_below(19, 23, trivial)), at19),
                    trans(set_var_other(vars, 23, one, 20, ne_below(20, 23, trivial)), at20),
                    trans(set_var_other(vars, 23, one, 22, ne_below(22, 23, trivial)), at22),
                    set_var_same(vars, 23, one), page, after, framed.proof.left,
                    trans(at, cmd_lands(l_opened_store(), 5, t_state_init(), ca(l_state_init()), cmd_j_opened_jmp())),
                    trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ x => read_gpr(Rsp, x.gprs), same), rax))⟩⟩)⟩)
        },
        OpenFailed(errno) => λ error goes page state memory_is rip_is rax => {
            let word = errno_word(errno);
            let set: (read_gpr(Rax, state.gprs).band(read_gpr(Rax, state.gprs)).sign_bit() = True) =
                trans(cong_fn<BitVec(64), Bool>(λ v => v.band(v).sign_bit(), rax), test_self_negative(word, errno_negative(errno, error)));
            // RAX tested, the JS taken to the failed path.
            cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, rest(True, totals), s),
                runs_back(rest(True, totals)), l_open_js(), refl, 2, vars, state, rip_is, Exists(frame, ⟨memory_is, holds⟩),
                ⟨λ _ after at framed _ => failed_runs(file, letters, default, spill, code, jumps, pj, placed, mask, width, n, c19, c20, rest, totals, goes,
                    framed.witness, vars, framed.proof.right, failed, values, at19, at20, page, after, framed.proof.left,
                    trans(at, cmd_lands(l_open_test(), 6, t_failed(), ca(l_failed()), cmd_j_open_js()))),
                 λ no => absurd(trans(sym(no), set))⟩)
        },
    }
}
theorem open_path<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, totals: Nat → BitVec(64), c19, c20, pointer: BitVec(64),
    name: List<BitVec(8)>, string: ArgStays(file, pointer, name), run: OperandRun, rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    opened: OpenResult, returns: OpenReturns(opened),
    goes: OpenGoes<C>(opened, file, shape, column, mask, width, n, totals, c19, c20, pointer, name, run, rest),
    vars: Nat → BitVec(64), failed: Bool,
    values: Vars(vars, mask, width, n, failed, totals), at19: vars(19) = c19, at20: vars(20) = c20, at22: vars(22) = pointer,
    page: Nat → BitVec(8), state: MachineState<IoMemory>, framed: Framed(file, page, vars)(state),
    rip_is: state.rip = eof_rip(ca(l_open())), rsi: read_gpr(Rsi, state.gprs) = pointer):
    LinuxRuns(io_linux(), open_events(opened, shape, column, mask, width, name, run, failed, totals, rest), state) {
    let io = io_linux();
    let data = io_data_access();
    let after_open: List<LinuxEvent> = match opened {
        Opened(fd) => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, failed, totals, rest),
        OpenFailed(_) => rest(True, totals),
    };
    let events = Cons(OpenEvent(name, opened), after_open);
    // The open's arguments set, a stretch of one block: the syscall ends it.
    cmd_straight(file, letters, default, spill, code, jumps, pj, placed, page, λ s => LinuxRuns(io, events, s), runs_back(events),
        l_open(), refl, 1, vars, state, rip_is, framed,
        λ s1 at fr same => {
            let img = with_frame(file, fr.witness);
            let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(fr.witness));
            let regs = cong_fn<MachineState<IoMemory>, Gprs>(λ x => x.gprs, same);
            let path: CStringAt(data, s1.memory, read_gpr(Rsi, s1.gprs), name) =
                j(sym(trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsi, g), regs), rsi)), λ p _ => CStringAt(data, s1.memory, p, name),
                    j(sym(fr.proof.left), λ m _ => CStringAt(data, m, pointer, name), string(fr.witness, page)));
            linux_runs_open(io, s1, s1, name, opened, after_open, Exists(0, refl),
                syscall_placed(img, page, io_entry(), ca(l_open_call()), pieces(l_open_call()), s1, fr.proof.left, at),
                ⟨cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rax, g), regs), ⟨cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rdi, g), regs),
                 ⟨cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rdx, g), regs), path⟩⟩⟩, returns,
                λ rcx r11 => open_back(file, letters, default, spill, code, jumps, pj, placed, shape, column, mask, width, n, totals, c19, c20, pointer,
                    name, run, rest, fr.witness, vars, fr.proof.right, failed, values, at19, at20, at22, opened, returns, goes, page,
                    linux_write_return(s1, open_rax(opened), rcx, r11), fr.proof.left, rip_advance(io_entry(), s1.rip, ca(l_open_call()), 2, at), refl))
        })
}

// An operand's events, facts and totals by whether it names stdin, as
// `file_events`, `FileOk` and `totals_after` take them apart.
fn operand_events<C>(stdin: Bool, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat,
    name: List<BitVec(8)>, run: OperandRun, failed: Bool, totals: Nat → BitVec(64), rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>)
    → List<LinuxEvent> {
    match stdin {
        True => file_reads(shape, column, mask, width, name, run, BitVec::zero(), False, failed, totals, rest),
        False => open_events(run.opened, shape, column, mask, width, name, run, failed, totals, rest),
    }
}
fn open_ok<C>(opened: OpenResult, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun) → Type {
    match opened as λ _ => Type { Opened(_) => NamedOk<C>(shape, column, mask, width, name, run), OpenFailed(_) => True }
}
fn operand_ok<C>(stdin: Bool, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun) → Type {
    match stdin {
        True => NamedOk<C>(shape, column, mask, width, name, run),
        False => OpenOk(name, run.opened) ∧ open_ok<C>(run.opened, shape, column, mask, width, name, run),
    }
}
fn open_totals<C>(opened: OpenResult, shape: FilterShape<C>, column: Nat → C → BitVec(64), run: OperandRun, totals: Nat → BitVec(64))
    → Nat → BitVec(64) {
    match opened { Opened(_) => add_counts(totals, input_counts(shape, column, eof_input(run.steps))), OpenFailed(_) => totals }
}
fn operand_totals<C>(stdin: Bool, shape: FilterShape<C>, column: Nat → C → BitVec(64), run: OperandRun, totals: Nat → BitVec(64))
    → Nat → BitVec(64) {
    match stdin {
        True => add_counts(totals, input_counts(shape, column, eof_input(run.steps))),
        False => open_totals(run.opened, shape, column, run, totals),
    }
}
theorem operand_events_is<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun, failed: Bool, totals: Nat → BitVec(64), rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>):
    file_events(shape, column, mask, width, name, run, failed, totals, rest) =
        operand_events(names_stdin(name), shape, column, mask, width, name, run, failed, totals, rest) { refl }
theorem operand_ok_is<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun, ok: FileOk(shape, column, mask, width, name, run)): operand_ok(names_stdin(name), shape, column, mask, width, name, run) {
    ok
}
theorem operand_totals_is<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), name: List<BitVec(8)>, run: OperandRun,
    totals: Nat → BitVec(64)): totals_after(shape, column, name, run, totals) = operand_totals(names_stdin(name), shape, column, run, totals) {
    refl
}

// `-` alone is one byte.
theorem stdin_len(name: List<BitVec(8)>, stdin: names_stdin(name) = True): name.len() = 1 {
    match name as λ nm => names_stdin(nm) = True → nm.len() = 1 {
        Nil => λ no => absurd(no),
        Cons(b, rest) => match rest as λ r => names_stdin(Cons(b, r)) = True → Cons(b, r).len() = 1 {
            Nil => λ _ => refl,
            Cons(_, _) => λ no => absurd(no),
        },
    }(stdin)
}
theorem len_fits(l: Nat, below: l < 4096): l <= 4096 { omega }
theorem len_one(l: Nat, one: l = 1): (0 < l) ∧ (l <= 4096) { ⟨omega, omega⟩ }

// What an open goes on to, from the facts its history gives and the loop
// after it.
theorem open_goes<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, n: Nat, nonzero: 0 < n, few: n < Nat::pow(2, 64), c19, c20: BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>, totals: Nat → BitVec(64),
    pointer: BitVec(64), name: List<BitVec(8)>, string: ArgStays(file, pointer, name),
    low: pointer.toNat() + name.len() + 1 <= Nat::pow(2, 47), run: OperandRun, later_ok: (Nat → BitVec(64)) → Type,
    onward: (t: Nat → BitVec(64)) → later_ok(t) → LoopGoes(file, mask, width, n, c19, c20, t, rest), opened: OpenResult):
    OpenOk(name, opened) → open_ok<C>(opened, shape, column, mask, width, name, run) → later_ok(open_totals(opened, shape, column, run, totals)) →
    OpenGoes<C>(opened, file, shape, column, mask, width, n, totals, c19, c20, pointer, name, run, rest) {
    match opened as λ o => OpenOk(name, o) → open_ok<C>(o, shape, column, mask, width, name, run) →
            later_ok(open_totals(o, shape, column, run, totals)) → OpenGoes<C>(o, file, shape, column, mask, width, n, totals, c19, c20, pointer,
                name, run, rest) {
        Opened(fd) => λ oo ok fitted => file_reads_runs(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled,
            mask, width, narrow, n, nonzero, few, c19, c20, rest, totals, pointer, name, string, low, oo.right.left,
            len_fits(name.len(), oo.right.right), run, ok, word_of_nat(64, fd), True,
            onward(add_counts(totals, input_counts(shape, column, eof_input(run.steps))), fitted)),
        OpenFailed(_) => λ _ _ fitted => onward(totals, fitted),
    }
}

// One operand, from the loop's head: the cursor to it, its slots, the dash
// test, then its reads and row, or its failed open, and on to the loop.
theorem operand_step<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, n: Nat, nonzero: 0 < n, few: n < Nat::pow(2, 64), rsp: BitVec(64),
    name: List<BitVec(8)>, more: List<List<BitVec(8)>>, run: OperandRun, rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    later_ok: (Nat → BitVec(64)) → Type,
    onward: (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) → (pointers: List<BitVec(64)>) → ArgvStays(file, rsp, args, pointers, k) →
        operands_from(ended, args) = more → (t: Nat → BitVec(64)) → later_ok(t) →
        LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(ended), t, rest),
    totals: Nat → BitVec(64), k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    argv: ArgvStays(file, rsp, args, pointers, k), left: operands_from(ended, args) = Cons(name, more),
    ok: FileOk(shape, column, mask, width, name, run), fitted: later_ok(totals_after(shape, column, name, run, totals))):
    LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(ended), totals,
        λ f t => file_events(shape, column, mask, width, name, run, f, t, rest)) {
    λ failed frame vars holds values at19 at20 page state memory_is rip_is =>
    loop_cursor(file, letters, default, spill, shape.code, jumps, pj, placed, vars, rsp, k, ended, args, pointers, argv, at19, at20,
        file_events(shape, column, mask, width, name, run, failed, totals, rest), page, state, Exists(frame, ⟨memory_is, holds⟩), rip_is,
        λ frame1 holds1 s1 reached => {
        let io = io_linux();
        have reach = j(left, λ o _ => CursorReach(with_frame(file, frame1), page, eof_rip(ca(l_cursor())), rsp, state.gprs, o, s1), reached);
        let s0 = reach.witness;
        let found = reach.proof.right;
        let pointer = found.witness;
        let at = found.proof;
        let cur = at.right.right.right.right;
        have head = operand_head(file, letters, default, spill, shape.code, jumps, pj, placed, frame1, vars, holds1, mask, width, n, failed, totals,
            values, pointer, at.right.left, page, s0, cur.memory_is, trans(cur.rip_is, rip_compose(io_entry(), ca(l_cursor()), cursor_len())), at.left);
        let c19 = argv_slot(rsp, cur.k);
        let c20 = ended_word(cur.ended);
        let head19: (head.vars(19) = c19) = trans(head.at19, cur.regs.left);
        let head20: (head.vars(20) = c20) = trans(head.at20, cur.regs.right.left);
        let string = at.right.right.right.left;
        let low = at.right.right.left;
        let goes_on = λ (t: Nat → BitVec(64)) (fit: later_ok(t)) => onward(cur.k, cur.ended, cur.args, cur.pointers, cur.argv, cur.left, t, fit);
        let events = λ (b: Bool) => operand_events(b, shape, column, mask, width, name, run, failed, totals, rest);
        let ran = dash_test(file, letters, default, spill, shape.code, jumps, pj, placed, page, head.vars, pointer, name, string, low, events,
            λ stdin st st_framed st_rip => {
                let named = j(stdin, λ b _ => operand_ok(b, shape, column, mask, width, name, run), operand_ok_is(shape, column, mask, width, name, run, ok));
                let fit = j(stdin, λ b _ => later_ok(operand_totals(b, shape, column, run, totals)), fitted);
                let sized = len_one(name.len(), stdin_len(name, stdin));
                stdin_path(file, letters, default, spill, shape.code, jumps, pj, placed, mask, width, n, totals, c19, c20, pointer,
                    λ f => file_reads(shape, column, mask, width, name, run, BitVec::zero(), False, f, totals, rest),
                    file_reads_runs(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask, width, narrow,
                        n, nonzero, few, c19, c20, rest, totals, pointer, name, string, low, sized.left, sized.right, run, named, BitVec::zero(), False,
                        goes_on(add_counts(totals, input_counts(shape, column, eof_input(run.steps))), fit)),
                    st_framed.witness, head.vars, st_framed.proof.right, failed, head.values, head19, head20, head.at22, page, st, st_framed.proof.left,
                    st_rip)
            },
            λ opens st st_framed st_rip st_rsi => {
                let checked = j(opens, λ b _ => operand_ok(b, shape, column, mask, width, name, run), operand_ok_is(shape, column, mask, width, name, run, ok));
                let fit = j(opens, λ b _ => later_ok(operand_totals(b, shape, column, run, totals)), fitted);
                open_path(file, letters, default, spill, shape.code, jumps, pj, placed, shape, column, mask, width, n, totals, c19, c20, pointer,
                    name, string, run, rest, run.opened, checked.left.left,
                    open_goes(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask, width, narrow, n,
                        nonzero, few, c19, c20, rest, totals, pointer, name, string, low, run, later_ok, goes_on, run.opened)(checked.left,
                        checked.right, fit),
                    head.vars, failed, head.values, head19, head20, head.at22, page, st, st_framed, st_rip, st_rsi)
            },
            head.after, Exists(head.frame, ⟨head.memory_is, head.holds⟩), head.rip_is, head.rsi);
        linux_runs_after_linux_steps(io, file_events(shape, column, mask, width, name, run, failed, totals, rest), s1, head.after,
            linux_steps_trans(io, s1, s0, head.after, linux_steps_of_fetched(io, s1, s0, reach.proof.left), head.steps), ran)
    })
}

// The loop over the operands still to come, by recursion on them: from the
// loop's head with the cursor's slots at argv slot `k`, the operands' events
// and then the total row.
fn LoopNext<C>(file: IoImage, shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, total: RowWrite,
    rsp: BitVec(64), ops: List<List<BitVec(8)>>) → Type {
    (runs: List<OperandRun>) → (totals: Nat → BitVec(64)) → FilesOk(shape, column, mask, width, n, total, ops, runs, totals) →
        (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) → (pointers: List<BitVec(64)>) → ArgvStays(file, rsp, args, pointers, k) →
        operands_from(ended, args) = ops →
        LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(ended), totals,
            λ f t => files_events(shape, column, mask, width, n, total, ops, runs, f, t))
}
theorem total_ok_of<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, total: RowWrite,
    totals: Nat → BitVec(64), runs: List<OperandRun>, ok: FilesOk(shape, column, mask, width, n, total, Nil, runs, totals)):
    TotalOk(mask, width, n, total, totals) {
    (match runs as λ r => FilesOk(shape, column, mask, width, n, total, Nil, r, totals) → TotalOk(mask, width, n, total, totals) {
        Nil => λ held => held,
        Cons(_, _) => λ never => false_elim(never),
    })(ok)
}
theorem operand_loop<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, n: Nat, nonzero: 0 < n, few: n < Nat::pow(2, 64), total: RowWrite, rsp: BitVec(64),
    ops: List<List<BitVec(8)>>): LoopNext<C>(file, shape, column, mask, width, n, total, rsp, ops) {
    match ops as λ o => LoopNext<C>(file, shape, column, mask, width, n, total, rsp, o) {
        Nil => λ runs totals ok k ended args pointers argv left failed frame vars holds values at19 at20 page state memory_is rip_is =>
            loop_cursor(file, letters, default, spill, shape.code, jumps, pj, placed, vars, rsp, k, ended, args, pointers, argv, at19, at20,
                total_events(mask, width, n, total, failed, totals), page, state, Exists(frame, ⟨memory_is, holds⟩), rip_is,
                λ frame1 holds1 s1 reached => {
                    have reach = j(left, λ o _ => CursorReach(with_frame(file, frame1), page, eof_rip(ca(l_cursor())), rsp, state.gprs, o, s1), reached);
                    let out = reach.proof.right;
                    linux_runs_after_steps(io_linux(), total_events(mask, width, n, total, failed, totals), s1, reach.witness, reach.proof.left,
                        loop_last(file, letters, default, spill, shape.code, jumps, pj, placed, frame1, vars, holds1, mask, width, n, failed, totals,
                            values, narrow, few, total, total_ok_of(shape, column, mask, width, n, total, totals, runs, ok), page, reach.witness,
                            out.right.memory_is, trans(out.right.rip_is, rip_compose(io_entry(), ca(l_cursor()), cursor_len())), out.left))
                }),
        Cons(name, more) => λ runs => match runs as λ r => (totals: Nat → BitVec(64)) →
                FilesOk(shape, column, mask, width, n, total, Cons(name, more), r, totals) →
                (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) → (pointers: List<BitVec(64)>) → ArgvStays(file, rsp, args, pointers, k) →
                operands_from(ended, args) = Cons(name, more) →
                LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(ended), totals,
                    λ f t => files_events(shape, column, mask, width, n, total, Cons(name, more), r, f, t)) {
            Nil => λ _ never => false_elim(never),
            Cons(run, later) => λ totals ok k ended args pointers argv left =>
                operand_step(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask, width, narrow, n,
                    nonzero, few, rsp, name, more, run, λ f t => files_events(shape, column, mask, width, n, total, more, later, f, t),
                    λ t => FilesOk(shape, column, mask, width, n, total, more, later, t),
                    λ k2 ended2 args2 pointers2 argv2 left2 t fit => operand_loop(file, letters, default, spill, shape, facts, jumps, pj, placed,
                        targets, column, spilled, mask, width, narrow, n, nonzero, few, total, rsp, more)(later, t, fit, k2, ended2, args2, pointers2,
                        argv2, left2),
                    totals, k, ended, args, pointers, argv, left, ok.left, ok.right),
        },
    }
}

// ---------------------------------------------------------------------------
// The prologue: the scan (0), the selection and the operand count into their
// slots (`l_keep_mask`), the stat pass when one is made (`l_stat`) or width 1 (`l_narrow`), the
// width, status and totals into theirs (`l_wstore`), the cursor's start (`l_start`),
// then the operand loop, or stdin when there is no operand (`l_ckeep`).

// Past the slots of the selection and the count, at `to` with `extra` of
// the registers.
fn KeptGoes(file: IoImage, mask: BitVec(64), n: Nat, rsp: BitVec(64), to: Nat, extra: Gprs → Type, events: List<LinuxEvent>) → Type {
    (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) → vars(16) = mask → vars(21) = word_of_nat(64, n) →
        (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) →
        state.rip = eof_rip(to) → read_gpr(Rsp, state.gprs) = rsp → extra(state.gprs) → LinuxRuns(io_linux(), events, state)
}
fn keep_few_block() → List<Instruction> { [MovRI(R11, BitVec::ofNat(2)), CmpRR(R9, R11)] }
fn keep_single_block() → List<Instruction> {
    [MovRI(R11, BitVec::ofNat(1)), MovRR(Rax, R8), SubRR(Rax, R11), AndRR(Rax, R8), MovRI(R11, word_zero()), CmpRR(Rax, R11)]
}
fn keep_one_block() → List<Instruction> { [MovRI(Rsi, BitVec::ofNat(1))] }
// The selection in R8, RSP as it was.
fn KeepAt(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), mask, rsp: BitVec(64)) → MachineState<IoMemory> → Type {
    λ state => Framed(file, page, vars)(state) ∧ ((read_gpr(R8, state.gprs) = mask) ∧ (read_gpr(Rsp, state.gprs) = rsp))
}
// Where the prologue goes on: RSP as it was, and `extra`.
fn KeepGone(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), rsp: BitVec(64), extra: Gprs → Type) → MachineState<IoMemory> → Type {
    λ state => Framed(file, page, vars)(state) ∧ ((read_gpr(Rsp, state.gprs) = rsp) ∧ extra(state.gprs))
}
theorem kept_goes(file: IoImage, mask: BitVec(64), n: Nat, rsp: BitVec(64), to: Nat, extra: Gprs → Type, events: List<LinuxEvent>,
    goes: KeptGoes(file, mask, n, rsp, to, extra, events), page: Nat → BitVec(8), vars: Nat → BitVec(64), at16: vars(16) = mask,
    at21: vars(21) = word_of_nat(64, n), state: MachineState<IoMemory>, rip_is: state.rip = eof_rip(to),
    gone: KeepGone(file, page, vars, rsp, extra)(state)): LinuxRuns(io_linux(), events, state) {
    goes(gone.left.witness, vars, gone.left.proof.right, at16, at21, page, state, gone.left.proof.left, rip_is, gone.right.left, gone.right.right)
}
// One operand or none (`l_single`): one count makes no stat (`l_narrow`, width 1);
// more than one makes the stat pass (`l_stat`).
theorem keep_single(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), mask: BitVec(64), n: Nat, rsp: BitVec(64),
    at16: vars(16) = mask, at21: vars(21) = word_of_nat(64, n), leb1: Nat::leb(n, 1) = True,
    events: Bool → List<LinuxEvent>,
    to_stat: stats_made(mask, n) = True → KeptGoes(file, mask, n, rsp, ca(l_stat()), λ _ => True, events(True)),
    to_one: stats_made(mask, n) = False →
        KeptGoes(file, mask, n, rsp, ca(l_wstore()), λ g => read_gpr(Rsi, g) = BitVec::ofNat(1), events(False)),
    state: MachineState<IoMemory>, rip_is: state.rip = eof_rip(ca(l_single())), held: KeepAt(file, page, vars, mask, rsp)(state)):
    LinuxRuns(io_linux(), events(stats_made(mask, n)), state) {
    let io = io_linux();
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let p0 = KeepAt(file, page, vars, mask, rsp);
    let p1 = λ (st: MachineState<IoMemory>) => KeepAt(file, page, vars, mask, rsp)(st) ∧ (st.flags.zf = single_count(mask));
    let tested = runs_block(keep_single_block(), io_entry(), ca(l_single()), p0, p1,
        λ st h => framed_resident(file, page, vars, canonical_block_bytes(keep_single_block()), eof_rip(ca(l_single())), here(l_single()), st, h.left),
        λ st h same => {
            let w8 = read_gpr(R8, st.gprs);
            ⟨⟨framed_moved(file, page, vars, execute_block_normal(keep_single_block(), st), st, same, h.left), h.right⟩,
                trans(zero_bits_sub(64, w8.sub(BitVec::ofNat(1)).band(w8), word_zero()),
                    cong_fn<BitVec(64), Bool>(λ v => v.sub(BitVec::ofNat(1)).band(v).eq_bit(word_zero()), h.right.left))⟩
        });
    let jne = JumpIfNear(NE, cmd_d(l_single_jne()));
    let resident = λ (st: MachineState<IoMemory>) (h: p1(st)) =>
        framed_resident(file, page, vars, near_control_bytes(jne), eof_rip(ca(l_single_jne())), here(l_single_jne()), st, h.left.left);
    (match single_count(mask) as λ c => (single_count(mask) = c) → LinuxRuns(io, events(stats_made(mask, n)), state) {
        False => λ multi => {
            let made: (stats_made(mask, n) = True) = trans(cong_fn<Bool, Bool>(λ x => !(x && single_count(mask)), leb1),
                cong_fn<Bool, Bool>(λ s => !(True && s), multi));
            let gone = KeepGone(file, page, vars, rsp, λ _ => True);
            j(sym(made), λ x _ => LinuxRuns(io, events(x), state),
                runs_into(p0, eof_rip(ca(l_single())), gone, eof_rip(ca(l_stat())), events(True),
                    runs_seq(p0, eof_rip(ca(l_single())), p1, eof_rip(ca(l_single_jne())), gone, eof_rip(ca(l_stat())), tested,
                        runs_jcc_taken(NE, cmd_d(l_single_jne()), io_entry(), ca(l_single_jne()), ca(l_stat()), cmd_j_single_jne(), p1, gone, resident,
                            λ st h => cong_fn<Bool, Bool>(λ x => !x, trans(h.right, multi)), λ st h => ⟨h.left.left, ⟨h.left.right.right, trivial⟩⟩)),
                    state, rip_is, held,
                    λ s at gone_held => kept_goes(file, mask, n, rsp, ca(l_stat()), λ _ => True, events(True), to_stat(made), page, vars, at16, at21,
                        s, at, gone_held)))
        },
        True => λ single => {
            let made: (stats_made(mask, n) = False) = trans(cong_fn<Bool, Bool>(λ x => !(x && single_count(mask)), leb1),
                cong_fn<Bool, Bool>(λ s => !(True && s), single));
            let one = λ (g: Gprs) => read_gpr(Rsi, g) = BitVec::ofNat(1);
            let gone = KeepGone(file, page, vars, rsp, one);
            let runs = runs_seq(p0, eof_rip(ca(l_single())), p1, eof_rip(ca(l_single_jne())), gone, eof_rip(ca(l_wstore())), tested,
                runs_seq(p1, eof_rip(ca(l_single_jne())), p0, eof_rip(ca(l_narrow())), gone, eof_rip(ca(l_wstore())),
                    runs_jcc_passed(NE, cmd_d(l_single_jne()), io_entry(), ca(l_single_jne()), p1, p0, resident,
                        λ st h => cong_fn<Bool, Bool>(λ x => !x, trans(h.right, single)), λ st h => h.left),
                    runs_seq(p0, eof_rip(ca(l_narrow())), gone, eof_rip(ca(l_narrow_jmp())), gone, eof_rip(ca(l_wstore())),
                        runs_block(keep_one_block(), io_entry(), ca(l_narrow()), p0, gone,
                            λ st h => framed_resident(file, page, vars, canonical_block_bytes(keep_one_block()), eof_rip(ca(l_narrow())), here(l_narrow()),
                                st, h.left),
                            λ st h same => ⟨framed_moved(file, page, vars, execute_block_normal(keep_one_block(), st), st, same, h.left),
                                ⟨h.right.right, refl⟩⟩),
                        runs_jmp(cmd_d(l_narrow_jmp()), io_entry(), ca(l_narrow_jmp()), ca(l_wstore()), cmd_j_narrow_jmp(), gone, gone,
                            λ st h => framed_resident(file, page, vars, near_control_bytes(JumpNear(cmd_d(l_narrow_jmp()))), eof_rip(ca(l_narrow_jmp())),
                                here(l_narrow_jmp()), st, h.left),
                            λ st h => h))));
            j(sym(made), λ x _ => LinuxRuns(io, events(x), state),
                runs_into(p0, eof_rip(ca(l_single())), gone, eof_rip(ca(l_wstore())), events(False), runs, state, rip_is, held,
                    λ s at gone_held => kept_goes(file, mask, n, rsp, ca(l_wstore()), one, events(False), to_one(made), page, vars, at16, at21,
                        s, at, gone_held)))
        },
    })(refl)
}
// The selection and the count into their slots (`l_keep_mask`), then the count
// against two (`l_few`): two or more make the stat pass (`l_stat`).
theorem keep_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars), mask: BitVec(64), n: Nat, few: n < Nat::pow(2, 64),
    page: Nat → BitVec(8), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page),
    rip_is: state.rip = eof_rip(ca(l_keep_mask())), r8: read_gpr(R8, state.gprs) = mask, r9: read_gpr(R9, state.gprs) = word_of_nat(64, n),
    events: Bool → List<LinuxEvent>,
    to_stat: stats_made(mask, n) = True → KeptGoes(file, mask, n, read_gpr(Rsp, state.gprs), ca(l_stat()), λ _ => True, events(True)),
    to_one: stats_made(mask, n) = False →
        KeptGoes(file, mask, n, read_gpr(Rsp, state.gprs), ca(l_wstore()), λ g => read_gpr(Rsi, g) = BitVec::ofNat(1), events(False))):
    LinuxRuns(io_linux(), events(stats_made(mask, n)), state) {
    let io = io_linux();
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let wn = word_of_nat(64, n);
    let two = BitVec::ofNat(2, n := 64);
    let rsp = read_gpr(Rsp, state.gprs);
    let v16 = set_var(vars, 16, mask);
    let kv = set_var(v16, 21, wn);
    let p0 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧
        ((read_gpr(R8, st.gprs) = mask) ∧ ((read_gpr(R9, st.gprs) = wn) ∧ (read_gpr(Rsp, st.gprs) = rsp)));
    let p1 = λ (st: MachineState<IoMemory>) => Framed(file, page, v16)(st) ∧
        ((read_gpr(R8, st.gprs) = mask) ∧ ((read_gpr(R9, st.gprs) = wn) ∧ (read_gpr(Rsp, st.gprs) = rsp)));
    let p2 = λ (st: MachineState<IoMemory>) => Framed(file, page, kv)(st) ∧
        ((read_gpr(R8, st.gprs) = mask) ∧ ((read_gpr(R9, st.gprs) = wn) ∧ (read_gpr(Rsp, st.gprs) = rsp)));
    let p3 = λ (st: MachineState<IoMemory>) => KeepAt(file, page, kv, mask, rsp)(st) ∧ (condition_holds(AE, st.flags) = !(wn.borrow_sub_bit(two)));
    let stored = runs_seq(p0, eof_rip(ca(l_keep_mask())), p1, eof_rip(ca(l_keep_count())), p3, eof_rip(ca(l_few_jae())),
        runs_slot_store(file, page, vars, ca(l_keep_mask()), 16, { omega }, R8, here(l_keep_mask()), here(l_keep_mask_store()), p0, p1,
            λ _ h => h.left,
            λ st h framed => ⟨framed_set(file, page, vars, 16, read_gpr(R8, execute_block_normal(slot_block(16), st).gprs), mask, h.right.left,
                slot_store_after(R8, 16, st), framed), h.right⟩),
        runs_seq(p1, eof_rip(ca(l_keep_count())), p2, eof_rip(ca(l_few())), p3, eof_rip(ca(l_few_jae())),
            runs_slot_store(file, page, v16, ca(l_keep_count()), 21, { omega }, R9, here(l_keep_count()), here(l_keep_count_store()), p1, p2,
                λ _ h => h.left,
                λ st h framed => ⟨framed_set(file, page, v16, 21, read_gpr(R9, execute_block_normal(slot_block(21), st).gprs), wn, h.right.right.left,
                    slot_store_after(R9, 21, st), framed), h.right⟩),
            runs_block(keep_few_block(), io_entry(), ca(l_few()), p2, p3,
                λ st h => framed_resident(file, page, kv, canonical_block_bytes(keep_few_block()), eof_rip(ca(l_few())), here(l_few()), st, h.left),
                λ st h same => ⟨⟨framed_moved(file, page, kv, execute_block_normal(keep_few_block(), st), st, same, h.left),
                    ⟨h.right.left, h.right.right.right⟩⟩, cong_fn<BitVec(64), Bool>(λ v => !(v.borrow_sub_bit(two)), h.right.right.left)⟩)));
    let at16: (kv(16) = mask) = trans(set_var_other(v16, 21, wn, 16, ne_below(16, 21, trivial)), set_var_same(vars, 16, mask));
    let at21: (kv(21) = wn) = set_var_same(v16, 21, wn);
    let jae = JumpIfNear(AE, cmd_d(l_few_jae()));
    let resident = λ (st: MachineState<IoMemory>) (h: p3(st)) =>
        framed_resident(file, page, kv, near_control_bytes(jae), eof_rip(ca(l_few_jae())), here(l_few_jae()), st, h.left.left);
    let pre: p0(state) = ⟨Exists(frame, ⟨memory_is, holds⟩), ⟨r8, ⟨r9, refl⟩⟩⟩;
    let value: (wn.toNat() = n) = toNat_word_of_nat(64, n, few);
    let two_value: (two.toNat() = 2) = BitVec::toNat_ofNat(64, 2, { omega });
    (match wn.borrow_sub_bit(two) as λ c => (wn.borrow_sub_bit(two) = c) → LinuxRuns(io, events(stats_made(mask, n)), state) {
        False => λ fits => {
            let ge = cmp_not_below(wn, two, fits);
            let many: (1 < n) = omega;
            let made: (stats_made(mask, n) = True) = cong_fn<Bool, Bool>(λ x => !(x && single_count(mask)), io_leb_false(n, 1, many));
            let gone = KeepGone(file, page, kv, rsp, λ _ => True);
            j(sym(made), λ x _ => LinuxRuns(io, events(x), state),
                runs_into(p0, eof_rip(ca(l_keep_mask())), gone, eof_rip(ca(l_stat())), events(True),
                    runs_seq(p0, eof_rip(ca(l_keep_mask())), p3, eof_rip(ca(l_few_jae())), gone, eof_rip(ca(l_stat())), stored,
                        runs_jcc_taken(AE, cmd_d(l_few_jae()), io_entry(), ca(l_few_jae()), ca(l_stat()), cmd_j_few_jae(), p3, gone, resident,
                            λ st h => trans(h.right, cong_fn<Bool, Bool>(λ x => !x, fits)), λ st h => ⟨h.left.left, ⟨h.left.right.right, trivial⟩⟩)),
                    state, rip_is, pre,
                    λ s at gone_held => kept_goes(file, mask, n, rsp, ca(l_stat()), λ _ => True, events(True), to_stat(made), page, kv, at16, at21,
                        s, at, gone_held)))
        },
        True => λ below => {
            let lt = cmp_below(wn, two, below);
            let one_n: (n <= 1) = omega;
            let leb1: (Nat::leb(n, 1) = True) = bool::eq_true_of_is_true(Nat::leb(n, 1), Nat::leb_complete(n, 1, one_n));
            let p4 = KeepAt(file, page, kv, mask, rsp);
            runs_into(p0, eof_rip(ca(l_keep_mask())), p4, eof_rip(ca(l_single())), events(stats_made(mask, n)),
                runs_seq(p0, eof_rip(ca(l_keep_mask())), p3, eof_rip(ca(l_few_jae())), p4, eof_rip(ca(l_single())), stored,
                    runs_jcc_passed(AE, cmd_d(l_few_jae()), io_entry(), ca(l_few_jae()), p3, p4, resident,
                        λ st h => trans(h.right, cong_fn<Bool, Bool>(λ x => !x, below)), λ st h => h.left)),
                state, rip_is, pre,
                λ s at h => keep_single(file, letters, default, spill, code, jumps, pj, placed, page, kv, mask, n, rsp, at16, at21, leb1, events,
                    to_stat, to_one, s, at, h))
        },
    })(refl)
}
// A fact of each of 0 to 7 is one of every slot below 8.
theorem below_eight(p: Nat → Type, p0: p(0), p1: p(1), p2: p(2), p3: p(3), p4: p(4), p5: p(5), p6: p(6), p7: p(7)):
    (i: Nat) → i < 8 → p(i) {
    λ a0 below => (match a0 as λ b => b < 8 → p(b) {
        Zero => λ _ => p0,
        Succ(a1) => match a1 as λ b => Succ(b) < 8 → p(Succ(b)) {
            Zero => λ _ => p1,
            Succ(a2) => match a2 as λ b => Succ(Succ(b)) < 8 → p(Succ(Succ(b))) {
                Zero => λ _ => p2,
                Succ(a3) => match a3 as λ b => Succ(Succ(Succ(b))) < 8 → p(Succ(Succ(Succ(b)))) {
                    Zero => λ _ => p3,
                    Succ(a4) => match a4 as λ b => Succ(Succ(Succ(Succ(b)))) < 8 → p(Succ(Succ(Succ(Succ(b))))) {
                        Zero => λ _ => p4,
                        Succ(a5) => match a5 as λ b => Succ(Succ(Succ(Succ(Succ(b))))) < 8 → p(Succ(Succ(Succ(Succ(Succ(b)))))) {
                            Zero => λ _ => p5,
                            Succ(a6) => match a6 as λ b => Succ(Succ(Succ(Succ(Succ(Succ(b)))))) < 8 → p(Succ(Succ(Succ(Succ(Succ(Succ(b))))))) {
                                Zero => λ _ => p6,
                                Succ(a7) => match a7 as λ b => Succ(Succ(Succ(Succ(Succ(Succ(Succ(b))))))) < 8 → p(Succ(Succ(Succ(Succ(Succ(Succ(Succ(b)))))))) {
                                    Zero => λ _ => p7,
                                    Succ(_) => λ never => false_elim(never),
                                },
                            },
                        },
                    },
                },
            },
        },
    })(below)
}

// At the width's store (`l_wstore`) with RSI the width.
fn WidthGoes(file: IoImage, mask: BitVec(64), n: Nat, rsp: BitVec(64), width: Nat, events: List<LinuxEvent>) → Type {
    (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) → vars(16) = mask → vars(21) = word_of_nat(64, n) →
        (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) →
        state.rip = eof_rip(ca(l_wstore())) → read_gpr(Rsp, state.gprs) = rsp → read_gpr(Rsi, state.gprs).toNat() = width →
        LinuxRuns(io_linux(), events, state)
}
// The stat pass (`l_stat`), over the operands `parse_args` gives.
theorem stat_pass(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), n: Nat, rsp: BitVec(64), argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    stays: ArgvStaysAt(file, rsp, argv, pointers), results: List<StatResult>,
    fit: StatsFit(stat_targets(operands_from(False, command_args(argv))), results), after: List<LinuxEvent>,
    then: WidthGoes(file, mask, n, rsp, stat_width(results.map(stat_seen)), after)):
    KeptGoes(file, mask, n, rsp, ca(l_stat()), λ _ => True,
        stat_events(stat_targets(operands_from(False, command_args(argv))), results) ++ after) {
    λ frame vars holds at16 at21 page state memory_is rip_is rsp_is _ => {
        let img = with_frame(file, frame);
        let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
        stat_runs(img, eof_rip(ca(l_stat())), pieces(l_stat()), page, argv, pointers, results, fit, after, state, memory_is, rip_is,
            j(sym(rsp_is), λ r _ => ArgvStaysAt(img, r, argv, pointers), stays),
            λ pg st out => then(frame, vars, holds, at16, at21, pg, st, out.memory_is, trans(out.rip_is, rip_compose(io_entry(), ca(l_stat()), stat_len())),
                trans(out.kept.left, rsp_is), out.rsi))
    }
}
// No stat (`l_narrow`): width 1.
theorem one_width(file: IoImage, mask: BitVec(64), n: Nat, rsp: BitVec(64), after: List<LinuxEvent>, then: WidthGoes(file, mask, n, rsp, 1, after)):
    KeptGoes(file, mask, n, rsp, ca(l_wstore()), λ g => read_gpr(Rsi, g) = BitVec::ofNat(1), after) {
    λ frame vars holds at16 at21 page state memory_is rip_is rsp_is rsi =>
        then(frame, vars, holds, at16, at21, page, state, memory_is, rip_is, rsp_is,
            trans(cong_fn<BitVec(64), Nat>(λ w => w.toNat(), rsi), BitVec::toNat_ofNat(64, 1, { omega })))
}

// A slot zeroed from RAX.
record SlotZeroed(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), q: Nat, before: MachineState<IoMemory>, to: Nat) {
    after: MachineState<IoMemory>,
    frame: Nat → BitVec(8),
    steps: LinuxSteps(io_linux(), before, after),
    memory_is: after.memory = IoMemory(with_frame(file, frame), page),
    rip_is: after.rip = eof_rip(to),
    holds: FrameHolds(frame, set_var(vars, q, word_zero())),
    rax: read_gpr(Rax, after.gprs) = word_zero(),
    rsp: read_gpr(Rsp, after.gprs) = read_gpr(Rsp, before.gprs),
}
theorem zero_slot(file: IoImage, frame: Nat → BitVec(8), vars: Nat → BitVec(64), holds: FrameHolds(frame, vars),
    page: Nat → BitVec(8), k, q: Nat, inside: q < frame_slots(),
    block: Placed(with_frame(file, frame), canonical_block_bytes(slot_block(q)), eof_rip(k)),
    store: Placed(with_frame(file, frame), word_store_bytes(WordStore(base := R11, source := Rax)), eof_rip(k + 10)),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(with_frame(file, frame), page), rip_is: state.rip = eof_rip(k),
    rax: read_gpr(Rax, state.gprs) = word_zero()): SlotZeroed(file, page, vars, q, state, (k + 10) + 3) {
    let s = run_slot_store(file, frame, vars, holds, page, k, q, inside, Rax, block, store, state, memory_is, rip_is);
    let f = stored_frame(file, frame, q, read_gpr(Rax, state.gprs));
    SlotZeroed(after := slot_store_after(Rax, q, state), frame := f, steps := s.steps, memory_is := s.memory_is, rip_is := s.rip_is,
        holds := j(rax, λ x _ => FrameHolds(f, set_var(vars, q, x)), s.holds), rax := rax, rsp := refl)
}

// At the cursor's start (`l_start`): the frame holds what Vars says, nothing
// failed and the totals are zero.
fn InitGoes(file: IoImage, mask: BitVec(64), width, n: Nat, rsp: BitVec(64), events: List<LinuxEvent>) → Type {
    (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) → Vars(vars, mask, width, n, False, no_counts()) →
        (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) →
        state.rip = eof_rip(ca(l_start())) → read_gpr(Rsp, state.gprs) = rsp → LinuxRuns(io_linux(), events, state)
}
fn rax_zero_block() → List<Instruction> { [MovRI(Rax, word_zero())] }
theorem init_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), n: Nat, rsp: BitVec(64), width: Nat, after: List<LinuxEvent>, then: InitGoes(file, mask, width, n, rsp, after)):
    WidthGoes(file, mask, n, rsp, width, after) {
    λ frame vars holds at16 at21 page state memory_is rip_is rsp_is rsi => {
        let io = io_linux();
        let img = with_frame(file, frame);
        let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
        let a = run_slot_store(file, frame, vars, holds, page, ca(l_wstore()), 17, { omega }, Rsi, pieces(l_wstore()), pieces(l_wstore_store()), state,
            memory_is, rip_is);
        let s1 = slot_store_after(Rsi, 17, state);
        let w17 = read_gpr(Rsi, state.gprs);
        let frame1 = stored_frame(file, frame, 17, w17);
        let vars1 = set_var(vars, 17, w17);
        let pieces1 = cmd_at(with_frame(file, frame1), letters, default, spill, code, jumps, pj, placed(frame1));
        let z = run_block(with_frame(file, frame1), page, rax_zero_block(), io_entry(), ca(l_zero()), pieces1(l_zero()), s1, a.memory_is, a.rip_is);
        let s2 = execute_block_normal(rax_zero_block(), s1);
        let p = λ (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f));
        have z0 = zero_slot(file, frame1, vars1, a.holds, page, ca(l_zero0()), 18, { omega }, (p(frame1))(l_zero0()), (p(frame1))(l_zero0_store()), s2,
            z.memory_is, z.rip_is, refl);
        let v0 = set_var(vars1, 18, word_zero());
        have z1 = zero_slot(file, z0.frame, v0, z0.holds, page, ca(l_zero1()), 8, { omega }, (p(z0.frame))(l_zero1()), (p(z0.frame))(l_zero1_store()), z0.after,
            z0.memory_is, z0.rip_is, z0.rax);
        let v1 = set_var(v0, 8, word_zero());
        have z2 = zero_slot(file, z1.frame, v1, z1.holds, page, ca(l_zero2()), 9, { omega }, (p(z1.frame))(l_zero2()), (p(z1.frame))(l_zero2_store()), z1.after,
            z1.memory_is, z1.rip_is, z1.rax);
        let v2 = set_var(v1, 9, word_zero());
        have z3 = zero_slot(file, z2.frame, v2, z2.holds, page, ca(l_zero3()), 10, { omega }, (p(z2.frame))(l_zero3()), (p(z2.frame))(l_zero3_store()),
            z2.after, z2.memory_is, z2.rip_is, z2.rax);
        let v3 = set_var(v2, 10, word_zero());
        have z4 = zero_slot(file, z3.frame, v3, z3.holds, page, ca(l_zero4()), 11, { omega }, (p(z3.frame))(l_zero4()), (p(z3.frame))(l_zero4_store()),
            z3.after, z3.memory_is, z3.rip_is, z3.rax);
        let v4 = set_var(v3, 11, word_zero());
        have z5 = zero_slot(file, z4.frame, v4, z4.holds, page, ca(l_zero5()), 12, { omega }, (p(z4.frame))(l_zero5()), (p(z4.frame))(l_zero5_store()),
            z4.after, z4.memory_is, z4.rip_is, z4.rax);
        let v5 = set_var(v4, 12, word_zero());
        have z6 = zero_slot(file, z5.frame, v5, z5.holds, page, ca(l_zero6()), 13, { omega }, (p(z5.frame))(l_zero6()), (p(z5.frame))(l_zero6_store()),
            z5.after, z5.memory_is, z5.rip_is, z5.rax);
        let v6 = set_var(v5, 13, word_zero());
        have z7 = zero_slot(file, z6.frame, v6, z6.holds, page, ca(l_zero7()), 14, { omega }, (p(z6.frame))(l_zero7()), (p(z6.frame))(l_zero7_store()),
            z6.after, z6.memory_is, z6.rip_is, z6.rax);
        let v7 = set_var(v6, 14, word_zero());
        have z8 = zero_slot(file, z7.frame, v7, z7.holds, page, ca(l_zero8()), 15, { omega }, (p(z7.frame))(l_zero8()), (p(z7.frame))(l_zero8_store()),
            z7.after, z7.memory_is, z7.rip_is, z7.rax);
        let v8 = set_var(v7, 15, word_zero());
        let zeroed = λ (m: Nat) => v8(8 + m) = no_counts()(m);
        let values: Vars(v8, mask, width, n, False, no_counts()) = Vars(mask_is := at16,
            width_is := sym(trans(cong_fn<Nat, BitVec(64)>(λ m => word_of_nat(64, m), sym(rsi)), word_of_nat_toNat(64, w17))),
            status_is := refl, count_is := at21,
            totals_is := below_eight(zeroed, refl, refl, refl, refl, refl, refl, refl, refl));
        let steps = linux_steps_trans(io, state, s1, z8.after, a.steps, linux_steps_trans(io, s1, s2, z8.after,
            linux_steps_of_fetched(io, s1, s2, z.steps), linux_steps_trans(io, s2, z0.after, z8.after, z0.steps,
            linux_steps_trans(io, z0.after, z1.after, z8.after, z1.steps, linux_steps_trans(io, z1.after, z2.after, z8.after, z2.steps,
            linux_steps_trans(io, z2.after, z3.after, z8.after, z3.steps, linux_steps_trans(io, z3.after, z4.after, z8.after, z4.steps,
            linux_steps_trans(io, z4.after, z5.after, z8.after, z5.steps, linux_steps_trans(io, z5.after, z6.after, z8.after, z6.steps,
            linux_steps_trans(io, z6.after, z7.after, z8.after, z7.steps, z8.steps))))))))));
        let rsp8: (read_gpr(Rsp, z8.after.gprs) = rsp) = trans(z8.rsp, trans(z7.rsp, trans(z6.rsp, trans(z5.rsp, trans(z4.rsp, trans(z3.rsp,
            trans(z2.rsp, trans(z1.rsp, trans(z0.rsp, rsp_is)))))))));
        linux_runs_after_linux_steps(io, after, state, z8.after, steps,
            then(z8.frame, v8, z8.holds, values, page, z8.after, z8.memory_is, z8.rip_is, rsp8))
    }
}

// With no operand (`l_stdin`): fd 0, at the reads (`l_state_init`).
fn StdinGoes(file: IoImage, mask: BitVec(64), width, n: Nat, events: List<LinuxEvent>) → Type {
    (frame: Nat → BitVec(8)) → (vars: Nat → BitVec(64)) → FrameHolds(frame, vars) → Vars(vars, mask, width, n, False, no_counts()) →
        (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(with_frame(file, frame), page) →
        state.rip = eof_rip(ca(l_state_init())) → read_gpr(Rsp, state.gprs) = BitVec::zero() → LinuxRuns(io_linux(), events, state)
}
// With one (`l_loop`): the loop, the cursor past argv[0] and no `--` yet.
fn BeginGoes(file: IoImage, mask: BitVec(64), width, n: Nat, rsp: BitVec(64), argv: List<List<BitVec(8)>>,
    after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → Type {
    (k: Nat) → (pointers: List<BitVec(64)>) → ArgvStays(file, rsp, command_args(argv), pointers, k) →
        LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(False), no_counts(), after)
}
// RBX and R12 into their slots (`l_ckeep`), then the count loaded and tested
// (`l_none`), up to the JNE.
fn BeginPre(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64), c19, c20: BitVec(64)) → MachineState<IoMemory> → Type {
    λ state => Framed(file, page, vars)(state) ∧ ((read_gpr(Rbx, state.gprs) = c19) ∧ (read_gpr(R12, state.gprs) = c20))
}
fn NoneTested(file: IoImage, page: Nat → BitVec(8), vars: Nat → BitVec(64)) → MachineState<IoMemory> → Type {
    λ state => Framed(file, page, vars)(state) ∧ (state.flags.zf = is_zero_bits(64, vars(21).sub(word_zero())))
}
theorem begin_store_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), c19, c20: BitVec(64)):
    Runs(BeginPre(file, page, vars, c19, c20), eof_rip(ca(l_ckeep())), NoneTested(file, page, set_var(set_var(vars, 19, c19), 20, c20)),
        eof_rip(ca(l_none_jne()))) {
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let v19 = set_var(vars, 19, c19);
    let bv = set_var(v19, 20, c20);
    let p0 = BeginPre(file, page, vars, c19, c20);
    let p1 = λ (st: MachineState<IoMemory>) => Framed(file, page, v19)(st) ∧ (read_gpr(R12, st.gprs) = c20);
    let p2 = Framed(file, page, bv);
    let p3 = λ (st: MachineState<IoMemory>) => Framed(file, page, bv)(st) ∧ (read_gpr(Rax, st.gprs) = bv(21));
    let p4 = NoneTested(file, page, bv);
    runs_seq(p0, eof_rip(ca(l_ckeep())), p1, eof_rip(ca(l_ekeep())), p4, eof_rip(ca(l_none_jne())),
        runs_slot_store(file, page, vars, ca(l_ckeep()), 19, { omega }, Rbx, here(l_ckeep()), here(l_ckeep_store()), p0, p1, λ _ held => held.left,
            λ st held framed => ⟨framed_set(file, page, vars, 19, read_gpr(Rbx, execute_block_normal(slot_block(19), st).gprs), c19, held.right.left,
                slot_store_after(Rbx, 19, st), framed), held.right.right⟩),
        runs_seq(p1, eof_rip(ca(l_ekeep())), p2, eof_rip(ca(l_none())), p4, eof_rip(ca(l_none_jne())),
            runs_slot_store(file, page, v19, ca(l_ekeep()), 20, { omega }, R12, here(l_ekeep()), here(l_ekeep_store()), p1, p2, λ _ held => held.left,
                λ st held framed => framed_set(file, page, v19, 20, read_gpr(R12, execute_block_normal(slot_block(20), st).gprs), c20, held.right,
                    slot_store_after(R12, 20, st), framed)),
            runs_seq(p2, eof_rip(ca(l_none())), p3, eof_rip(ca(l_none_test())), p4, eof_rip(ca(l_none_jne())),
                runs_slot_load(file, page, bv, ca(l_none()), 21, { omega }, Rax, here(l_none()), here(l_none_load()), p2, p3, λ _ held => held,
                    λ st held framed => ⟨framed, refl⟩),
                runs_block(zero_test_block(), io_entry(), ca(l_none_test()), p3, p4,
                    λ st held => framed_resident(file, page, bv, canonical_block_bytes(zero_test_block()), eof_rip(ca(l_none_test())), here(l_none_test()),
                        st, held.left),
                    λ st held same => ⟨framed_moved(file, page, bv, execute_block_normal(zero_test_block(), st), st, same, held.left),
                        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), held.right)⟩))))
}
// The JNE (`l_none_jne`): no operand goes to stdin with fd 0 (`l_state_init`), any to
// the loop (`l_loop`).
theorem begin_test(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, few: n < Nat::pow(2, 64), rsp: BitVec(64), k: Nat, after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    to_stdin: n = 0 → StdinGoes(file, mask, width, n, after(False, no_counts())),
    to_loop: 0 < n → LoopGoes(file, mask, width, n, argv_slot(rsp, k), ended_word(False), no_counts(), after),
    page: Nat → BitVec(8), vars: Nat → BitVec(64), values: Vars(vars, mask, width, n, False, no_counts()),
    at19: vars(19) = argv_slot(rsp, k), at20: vars(20) = ended_word(False),
    state: MachineState<IoMemory>, rip_is: state.rip = eof_rip(ca(l_none_jne())), tested: NoneTested(file, page, vars)(state)):
    LinuxRuns(io_linux(), after(False, no_counts()), state) {
    let io = io_linux();
    let events = after(False, no_counts());
    let here = λ (l: Prog) (f: Nat → BitVec(8)) => cmd_at(with_frame(file, f), letters, default, spill, code, jumps, pj, placed(f))(l);
    let jne = JumpIfNear(NE, cmd_d(l_none_jne()));
    let resident = λ (zf: Bool) (st: MachineState<IoMemory>) (held: Framed(file, page, vars)(st) ∧ (st.flags.zf = zf)) =>
        framed_resident(file, page, vars, near_control_bytes(jne), eof_rip(ca(l_none_jne())), here(l_none_jne()), st, held.left);
    let zf_is: (state.flags.zf = is_zero_bits(64, word_of_nat(64, n).sub(word_zero()))) =
        trans(tested.right, cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.sub(word_zero())), values.count_is));
    (match n as λ m => (n = m) → LinuxRuns(io, events, state) {
        Zero => λ zero => {
            let zf: (state.flags.zf = True) = trans(zf_is, trans(cong_fn<Nat, Bool>(λ m => is_zero_bits(64, word_of_nat(64, m).sub(word_zero())),
                zero), zero_bits_sub_self(64, word_zero())));
            let p0 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (st.flags.zf = True);
            let p1 = Framed(file, page, vars);
            let p2 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (read_gpr(Rsp, st.gprs) = BitVec::zero());
            let runs = runs_seq(p0, eof_rip(ca(l_none_jne())), p1, eof_rip(ca(l_stdin())), p2, eof_rip(ca(l_state_init())),
                runs_jcc_passed(NE, cmd_d(l_none_jne()), io_entry(), ca(l_none_jne()), p0, p1, resident(True),
                    λ st held => cong_fn<Bool, Bool>(λ x => !x, held.right), λ st held => held.left),
                runs_seq(p1, eof_rip(ca(l_stdin())), p2, eof_rip(ca(l_stdin_jmp())), p2, eof_rip(ca(l_state_init())),
                    runs_block(fd_zero_block(), io_entry(), ca(l_stdin()), p1, p2,
                        λ st held => framed_resident(file, page, vars, canonical_block_bytes(fd_zero_block()), eof_rip(ca(l_stdin())), here(l_stdin()),
                            st, held),
                        λ st held same => ⟨framed_moved(file, page, vars, execute_block_normal(fd_zero_block(), st), st, same, held), refl⟩),
                    runs_jmp(cmd_d(l_stdin_jmp()), io_entry(), ca(l_stdin_jmp()), ca(l_state_init()), cmd_j_stdin_jmp(), p2, p2,
                        λ st held => framed_resident(file, page, vars, near_control_bytes(JumpNear(cmd_d(l_stdin_jmp()))), eof_rip(ca(l_stdin_jmp())),
                            here(l_stdin_jmp()), st, held.left),
                        λ st held => held)));
            runs_into(p0, eof_rip(ca(l_none_jne())), p2, eof_rip(ca(l_state_init())), events, runs, state, rip_is, ⟨tested.left, zf⟩,
                λ s5 s5_rip held => to_stdin(zero)(held.left.witness, vars, held.left.proof.right, values, page, s5, held.left.proof.left, s5_rip,
                    held.right))
        },
        Succ(m) => λ succ => {
            let value = toNat_word_of_nat(64, n, few);
            let positive: (0 < word_of_nat(64, n).toNat()) = omega;
            let some: (0 < n) = omega;
            let zf: (state.flags.zf = False) = trans(zf_is, trans(zero_bits_sub(64, word_of_nat(64, n), word_zero()),
                nonzero_word(word_of_nat(64, n), positive)));
            let p0 = λ (st: MachineState<IoMemory>) => Framed(file, page, vars)(st) ∧ (st.flags.zf = False);
            runs_into(p0, eof_rip(ca(l_none_jne())), Framed(file, page, vars), eof_rip(ca(l_loop())), events,
                runs_jcc_taken(NE, cmd_d(l_none_jne()), io_entry(), ca(l_none_jne()), ca(l_loop()), cmd_j_none_jne(), p0, Framed(file, page, vars),
                    resident(False), λ st held => cong_fn<Bool, Bool>(λ x => !x, held.right), λ st held => held.left),
                state, rip_is, ⟨tested.left, zf⟩,
                λ s3 s3_rip held => to_loop(some)(False, held.witness, vars, held.proof.right, values, at19, at20, page, s3, held.proof.left, s3_rip))
        },
    })(refl)
}
// The cursor's start (`l_start`), RBX and R12 into their slots, then the count
// tested: none goes to stdin, any to the loop.
theorem begin_runs(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, code: StructuredCode,
    jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, code, jumps, pj),
    mask: BitVec(64), width, n: Nat, few: n < Nat::pow(2, 64), rsp: BitVec(64), argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    stays: ArgvStaysAt(file, rsp, argv, pointers), after: Bool → (Nat → BitVec(64)) → List<LinuxEvent>,
    to_stdin: n = 0 → StdinGoes(file, mask, width, n, after(False, no_counts())),
    to_loop: 0 < n → BeginGoes(file, mask, width, n, rsp, argv, after)):
    InitGoes(file, mask, width, n, rsp, after(False, no_counts())) {
    λ frame vars holds values page state memory_is rip_is rsp_is => {
        let io = io_linux();
        let events = after(False, no_counts());
        let img = with_frame(file, frame);
        let pieces = cmd_at(img, letters, default, spill, code, jumps, pj, placed(frame));
        have started = cursor_start(img, eof_rip(ca(l_start())), pieces(l_start()), page, argv, pointers, state, memory_is, rip_is,
            j(sym(rsp_is), λ r _ => ArgvStaysAt(img, r, argv, pointers), stays));
        let s0 = started.witness;
        let out = started.proof.right;
        let k = out.k;
        let rbx: (read_gpr(Rbx, s0.gprs) = argv_slot(rsp, k)) =
            trans(out.regs.left, cong_fn<BitVec(64), BitVec(64)>(λ r => argv_slot(r, k), rsp_is));
        let c19 = argv_slot(rsp, k);
        let c20 = ended_word(False);
        let v19 = set_var(vars, 19, c19);
        let bv = set_var(v19, 20, c20);
        let values2 = slot_vars(v19, mask, width, n, False, no_counts(), slot_vars(vars, mask, width, n, False, no_counts(), values, 19, c19,
            trivial, ne_below(19, 21, trivial)), 20, c20, trivial, ne_below(20, 21, trivial));
        let argv_k: ArgvStays(file, rsp, command_args(argv), out.pointers, k) =
            j(rsp_is, λ r _ => ArgvStays(file, r, command_args(argv), out.pointers, k), out.argv);
        linux_runs_after_steps(io, events, state, s0, started.proof.left,
            runs_elim(BeginPre(file, page, vars, c19, c20), eof_rip(ca(l_ckeep())), NoneTested(file, page, bv), eof_rip(ca(l_none_jne())),
                LinuxRuns(io, events, s0), begin_store_runs(file, letters, default, spill, code, jumps, pj, placed, page, vars, c19, c20), s0,
                trans(out.rip_is, rip_compose(io_entry(), ca(l_start()), start_len())), ⟨Exists(frame, ⟨out.memory_is, holds⟩), ⟨rbx, out.regs.right.left⟩⟩,
                λ s1 steps1 rip1 tested => linux_runs_after_linux_steps(io, events, s0, s1, steps1,
                    begin_test(file, letters, default, spill, code, jumps, pj, placed, mask, width, n, few, rsp, k, after, to_stdin,
                        λ some => to_loop(some)(k, out.pointers, argv_k), page, bv, values2,
                        trans(set_var_other(v19, 20, c20, 19, ne_below(19, 20, trivial)), set_var_same(vars, 19, c19)), set_var_same(v19, 20, c20),
                        s1, rip1, tested))))
    }
}

// The inputs: stdin read once when there is no operand, the operand loop
// otherwise.
theorem inputs_runs<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    mask: BitVec(64), width: Nat, narrow: width <= 20, rsp: BitVec(64), argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    stays: ArgvStaysAt(file, rsp, argv, pointers), history: CommandHistory, ops: List<List<BitVec(8)>>):
    operands_from(False, command_args(argv)) = ops → ops.len() < Nat::pow(2, 64) → InputsOk(shape, column, mask, width, ops, history) →
    InitGoes(file, mask, width, ops.len(), rsp, inputs_events(shape, column, mask, width, ops, history)) {
    match ops as λ o => operands_from(False, command_args(argv)) = o → o.len() < Nat::pow(2, 64) → InputsOk(shape, column, mask, width, o, history) →
            InitGoes(file, mask, width, o.len(), rsp, inputs_events(shape, column, mask, width, o, history)) {
        Nil => λ _ _ => match history.runs as λ r => (match r as λ _ => Type {
                    Nil => False,
                    Cons(run, later) => ReadsOk<C>(shape, run) ∧
                        (RowWriteOk(row_counts(width, mask, input_counts(shape, column, eof_input(run.steps))) ++ [newline()], run.counts) ∧
                            (later = Nil)),
                }) → InitGoes(file, mask, width, 0, rsp, match r { Nil => Nil, Cons(run, _) => stdin_events(shape, column, mask, width, run) }) {
            Nil => λ never => false_elim(never),
            Cons(run, later) => λ held => begin_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, width, 0, { omega }, rsp,
                argv, pointers, stays, λ _ _ => stdin_events(shape, column, mask, width, run),
                λ _ frame vars holds values page state memory_is rip_is rsp_is =>
                    read_pass(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, BitVec::zero(), mask, width, 0, no_counts(), vars,
                        λ seen f => stdin_row(shape, column, mask, width, run, seen, f), run.steps, held.left.steps, run.ending, held.left.ending,
                        held.left.room,
                        unnamed_spill(file, letters, default, spill, shape, jumps, pj, placed, column, spilled, mask, width, narrow, no_counts(), vars,
                            run, eof_input(run.steps), held.right.left, BitVec::zero()),
                        frame, vars, holds, False, values, λ m _ => refl, page, state, memory_is, rip_is, rsp_is),
                λ none => false_elim(ne_below(0, 0, none)(refl))),
        },
        Cons(name, more) => λ left few ok => begin_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, width,
            Cons(name, more).len(), few, rsp, argv, pointers, stays,
            λ f t => files_events(shape, column, mask, width, Cons(name, more).len(), history.total, Cons(name, more), history.runs, f, t),
            λ zero => false_elim(ne_below(0, Cons(name, more).len(), { omega })(sym(zero))),
            λ some k pointers2 argv2 => operand_loop(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask,
                width, narrow, Cons(name, more).len(), some, few, history.total, rsp, Cons(name, more))(history.runs, no_counts(), ok, k, False,
                command_args(argv), pointers2, argv2, left)),
    }
}

// ---------------------------------------------------------------------------
// The claim's bounds: the width is at most twenty, and there are no more
// operands than arguments.

theorem digits_le(x: BitVec(64)): decimal(x.toNat()).len() <= 20 {
    let n = x.toNat();
    let digits: (decimal(n).len() = Succ(places_reached(19, n))) = decimal_len(n, BitVec::toNat_lt_pow(64, x));
    let few = places_le(n, 19);
    let bound: (decimal(n).len() <= 20) = omega;
    bound
}
theorem widened_le(other: Bool, d: Nat, le: d <= 20): widened(other, d) <= 20 {
    match other as λ o => widened(o, d) <= 20 {
        False => le,
        True => match Nat::leb(7, d) as λ c => (match c { True => d, False => 7 }) <= 20 {
            True => le,
            False => {
                let b: (7 <= 20) = omega;
                b
            },
        },
    }
}
theorem stat_width_le(seen: List<StatSeen>): stat_width(seen) <= 20 {
    widened_le(any_other(False, seen), decimal(regular_total(BitVec::zero(), seen).toNat()).len(),
        digits_le(regular_total(BitVec::zero(), seen)))
}
theorem operands_le(args: List<List<BitVec(8)>>): (ended: Bool) → operands_from(ended, args).len() <= args.len() {
    match args as λ a => (ended: Bool) → operands_from(ended, a).len() <= a.len() {
        Nil => λ _ => Nat::le_refl(0),
        Cons(arg, rest) => λ ended => {
            let kept = λ (e: Bool) => {
                let r = operands_le(rest, e);
                let b: (Succ(operands_from(e, rest).len()) <= Succ(rest.len())) = omega;
                b
            };
            let dropped = λ (e: Bool) => {
                let r = operands_le(rest, e);
                let b: (operands_from(e, rest).len() <= Succ(rest.len())) = omega;
                b
            };
            match ended as λ e => operands_from(e, Cons(arg, rest)).len() <= Succ(rest.len()) {
                True => kept(True),
                False => match arg as λ g => operands_from(False, Cons(g, rest)).len() <= Succ(rest.len()) {
                    Nil => kept(False),
                    Cons(first, tail) => match first.eq_bit(dash()) as λ c => (match c {
                            False => Cons(Cons(first, tail), operands_from(False, rest)),
                            True => match tail {
                                Nil => Cons(Cons(first, tail), operands_from(False, rest)),
                                Cons(second, more) => operands_from(!letters_follow(second, more), rest),
                            },
                        }).len() <= Succ(rest.len()) {
                        False => kept(False),
                        True => match tail as λ t => (match t {
                                Nil => Cons(Cons(first, t), operands_from(False, rest)),
                                Cons(second, more) => operands_from(!letters_follow(second, more), rest),
                            }).len() <= Succ(rest.len()) {
                            Nil => kept(False),
                            Cons(second, more) => dropped(!letters_follow(second, more)),
                        },
                    },
                },
            }
        },
    }
}
theorem with_frame_self(file: IoImage): with_frame(file, file.frame) = file { refl }
theorem args_le(argv: List<List<BitVec(8)>>): command_args(argv).len() <= argv.len() {
    match argv as λ a => command_args(a).len() <= a.len() {
        Nil => Nat::le_refl(0),
        Cons(_, rest) => {
            let b: (rest.len() <= Succ(rest.len())) = omega;
            b
        },
    }
}
theorem operands_few(argv: List<List<BitVec(8)>>, operands: List<List<BitVec(8)>>, same: operands_from(False, command_args(argv)) = operands,
    argc: argv.len() < Nat::pow(2, 31)): operands.len() < Nat::pow(2, 64) {
    let bound = operands_le(command_args(argv), False);
    let args = args_le(argv);
    let len_same: (operands_from(False, command_args(argv)).len() = operands.len()) =
        cong_fn<List<List<BitVec(8)>>, Nat>(λ o => o.len(), same);
    let few: (operands.len() < Nat::pow(2, 64)) = omega;
    few
}
theorem one_narrow(): 1 <= 20 { omega }

// ---------------------------------------------------------------------------
// The claim.

// What the history must be, and what the run does, once the command line is
// parsed: `CommandHistoryOk` and `command_events` past their match.
fn parsed_ok<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), history: CommandHistory, parsed: Scanned) → Type {
    match parsed {
        Refused => True,
        Scanned(mask, operands) => match stats_made(mask, operands.len()) {
            True => StatsFit(stat_targets(operands), history.stats) ∧
                InputsOk(shape, column, mask, stat_width(history.stats.map(stat_seen)), operands, history),
            False => InputsOk(shape, column, mask, 1, operands, history),
        },
    }
}
fn parsed_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), history: CommandHistory, parsed: Scanned) → List<LinuxEvent> {
    match parsed {
        Refused => [ExitEvent(BitVec::ofNat(1))],
        Scanned(mask, operands) => match stats_made(mask, operands.len()) {
            True => stat_events(stat_targets(operands), history.stats) ++
                inputs_events(shape, column, mask, stat_width(history.stats.map(stat_seen)), operands, history),
            False => inputs_events(shape, column, mask, 1, operands, history),
        },
    }
}
// Past the scan (`l_keep_mask`), the command line parsed: the selection and the count
// kept, the stat pass or width 1, the slots set, then the inputs.
theorem parsed_runs<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, history: CommandHistory, argc: argv.len() < Nat::pow(2, 31),
    mask: BitVec(64), operands: List<List<BitVec(8)>>, same: operands_from(False, command_args(argv)) = operands,
    ok: parsed_ok(shape, column, history, Scanned(mask, operands)), page: Nat → BitVec(8), state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(with_frame(file, file.frame), page), rip_is: state.rip = eof_rip(ca(l_keep_mask())),
    r8: read_gpr(R8, state.gprs) = mask, r9: read_gpr(R9, state.gprs) = word_of_nat(64, operands.len()),
    stays: ArgvStaysAt(file, read_gpr(Rsp, state.gprs), argv, pointers)):
    LinuxRuns(io_linux(), parsed_events(shape, column, history, Scanned(mask, operands)), state) {
    let n = operands.len();
    let rsp = read_gpr(Rsp, state.gprs);
    let few = operands_few(argv, operands, same, argc);
    let width = stat_width(history.stats.map(stat_seen));
    let made_ok = λ (b: Bool) => match b as λ _ => Type {
        True => StatsFit(stat_targets(operands), history.stats) ∧ InputsOk(shape, column, mask, width, operands, history),
        False => InputsOk(shape, column, mask, 1, operands, history),
    };
    let events = λ (b: Bool) => match b {
        True => stat_events(stat_targets(operands), history.stats) ++ inputs_events(shape, column, mask, width, operands, history),
        False => inputs_events(shape, column, mask, 1, operands, history),
    };
    keep_runs(file, letters, default, spill, shape.code, jumps, pj, placed, file.frame, λ i => frame_word(file.frame, 8 * i),
        frame_holds_self(file.frame), mask, n, few, page, state, memory_is, rip_is, r8, r9, events,
        λ made => {
            let held: made_ok(True) = j(made, λ c _ => made_ok(c), ok);
            let after = inputs_events(shape, column, mask, width, operands, history);
            j(same, λ o _ => KeptGoes(file, mask, n, rsp, ca(l_stat()), λ _ => True, stat_events(stat_targets(o), history.stats) ++ after),
                stat_pass(file, letters, default, spill, shape.code, jumps, pj, placed, mask, n, rsp, argv, pointers, stays, history.stats,
                    j(sym(same), λ o _ => StatsFit(stat_targets(o), history.stats), held.left), after,
                    init_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, n, rsp, width, after,
                        inputs_runs(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask, width,
                            stat_width_le(history.stats.map(stat_seen)), rsp, argv, pointers, stays, history, operands)(same, few, held.right))))
        },
        λ made => {
            let held: made_ok(False) = j(made, λ c _ => made_ok(c), ok);
            let after = inputs_events(shape, column, mask, 1, operands, history);
            one_width(file, mask, n, rsp, after,
                init_runs(file, letters, default, spill, shape.code, jumps, pj, placed, mask, n, rsp, 1, after,
                    inputs_runs(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, mask, 1, one_narrow(),
                        rsp, argv, pointers, stays, history, operands)(same, few, held)))
        })
}
// The claim: for a file holding the command's code at the entry, whatever
// its frame holds, any argv laid out at RSP with fewer than 2^31 arguments
// (Linux's MAX_ARG_STRINGS), any page, registers and flags, and any history
// Linux can give, the process makes `command_events`.
theorem command_runs<C>(file: IoImage, letters: List<BitVec(8)>, default: BitVec(64), spill: Nat → StateReg, shape: FilterShape<C>,
    facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, placed: CommandPlaced(file, letters, default, spill, shape.code, jumps, pj),
    targets: CoreTargets(ca(l_core()), ca(l_head()), structured_bytes(shape.code).len(), jumps, pj), column: Nat → C → BitVec(64),
    spilled: (i: Nat) → i < 8 → (g: Gprs) → (s: C) → shape.rep(g, s) → read_gpr(state_gpr(spill(i)), g) = column(i)(s),
    argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, history: CommandHistory,
    ok: CommandHistoryOk(shape, column, letters, default, argv, history), page: Nat → BitVec(8), gprs: Gprs, flags: Flags,
    stays: ArgvStaysAt(file, read_gpr(Rsp, gprs), argv, pointers), argc: argv.len() < Nat::pow(2, 31)):
    LinuxRuns(io_linux(), command_events(shape, column, letters, default, argv, history), io_initial(file, page, gprs, flags)) {
    let io = io_linux();
    let state = io_initial(file, page, gprs, flags);
    let pieces = cmd_at(file, letters, default, spill, shape.code, jumps, pj, placed(file.frame));
    let ops = operands_from(False, command_args(argv));
    let checked: parsed_ok(shape, column, history, parse_args(letters, default, argv)) = ok;
    let result: LinuxRuns(io, parsed_events(shape, column, history, parse_args(letters, default, argv)), state) =
        (match parse_args(letters, default, argv) as λ r => ScanResult(file, page, eof_rip(ca(l_scan())), gprs, r, state) → OperandsAre(r, ops) →
                parsed_ok(shape, column, history, r) → LinuxRuns(io, parsed_events(shape, column, history, r), state) {
            Refused => λ runs _ _ => runs,
            Scanned(mask, operands) => λ scanned same held => {
                let s1 = scanned.witness;
                let out = scanned.proof.right;
                linux_runs_after_steps(io, parsed_events(shape, column, history, Scanned(mask, operands)), state, s1, scanned.proof.left,
                    parsed_runs(file, letters, default, spill, shape, facts, jumps, pj, placed, targets, column, spilled, argv, pointers, history, argc,
                        mask, operands, sym(same), held, page, s1, out.memory_is, trans(out.rip_is, rip_compose(io_entry(), ca(l_scan()), scan_len())),
                        out.r8, out.r9, j(sym(out.kept.left), λ r _ => ArgvStaysAt(file, r, argv, pointers), stays)))
            },
        })(scan_runs(file, letters, default, eof_rip(ca(l_scan())), pieces(l_scan()), page, argv, state, refl, refl,
            stays_argv_at(file, read_gpr(Rsp, gprs), argv, pointers, stays, page)), parse_operands(letters, default, argv), checked);
    result
}

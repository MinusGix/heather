// The verdict and the theorem, as definitions (docs/language/ownership-design.md
// §21.4; issues/ownership-interfaces.md). The statements of a function's
// safety and of `check_sound` are `Type`-valued definitions here: no proof
// and no axiom is over them in this package.
//
// - **Residual kinds** (`Residual`): two spans apart, a disjunction naming
//   its sides as a source spells them (`Apart`); a callee's precondition at
//   the values passed, and an accessor's precondition at a place's last
//   step, which an element read, an element write, a take and a view's
//   opening each owe (`Pre`, `Access`); a write of a whole place owing that
//   what is written fits what was there (`Fits`); a call in one recursion
//   owing its measure below the caller's (`Measure`). Each holds over the
//   native values inside the `Dyn`s, so a source's proof is its discharge by
//   conversion.
// - **The verdict's tree** (`Owes`) is in the body's shape: each
//   statement's residuals at the state it reads, a join's arms under their
//   sides of the test, what follows a join once.
// - **A function's safety** (`Safety`), relative to its callees' at less
//   fuel: at no fuel is the run stuck; a measured function's run is done
//   from its measure on; where it is done, its results read the meaning's,
//   each referring written parameter's slot is the argument itself (a plain
//   one's comes back plain) and the meaning's value after fits its value
//   before (`Value::Written`), the heap after is the heap before with each
//   reference lent to change overwritten by what it reads after (`Heap::Frame`,
//   §18.3's lens equation), its old blocks are live only where they were and keep having no holes
//   (`Heap::Kept`), and each returned view is its parameter's reference
//   narrowed by the steps its signature names at the call's words
//   (`Value::Views`, `Ref::narrow`), each fresh one a bare block, each
//   owning one (fresh or a moved parameter) a block of its own
//   (`Heap::Bare`, `Value::OwnedApart`), and the results have their codes
//   (`Dyn::Coded`); where an unmeasured run is going, its history is a
//   prefix of one the meaning reaches.
// - **The check's refusals from codes alone** are the checker's own
//   (`checker.hthr`, one pass): a word primitive or test at a non-word, a
//   join whose arms yield different codes, a call whose arguments' codes are
//   not its signature's, and the like; the meaning of what it refuses is
//   junk.
// - **`check_sound`** (`CheckSound`): a checker's verdict, and its residuals
//   holding along the meaning, give the function's safety.
import logic;
import bool;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import level2;
import run;
import linux_world;

// ---------------------------------------------------------------------------
// Residuals

inductive Residual {
    RApart(lo1: Atom, n1: Atom, lo2: Atom, n2: Atom),
    RPre(g: Nat, args: List<Var>),
    RAccess(p: Place),
    RFits(p: Place, v: Var),
    RMeasure(g: Nat, args: List<Var>),
}

// Each callee's precondition at the values passed, and each function's
// measure (its `need`) at its arguments.
fn Pres(tys: Nat → Type) → Type<1> { Nat → List<Dyn(tys)> → Type }

fn Need(tys: Nat → Type) → Type { Nat → List<Dyn(tys)> → Nat }

// A place's steps but its last, and its last.
fn Steps::init(xs: List<Step>) → List<Step> { match xs { Nil => Nil, Cons(a, rest) => match rest { Nil => Nil, Cons(_, _) => Cons(a, Steps::init(rest)) } } }

fn Steps::last(xs: List<Step>) → Option<Step> { match xs { Nil => None, Cons(a, rest) => match rest { Nil => Some(a), Cons(_, _) => Steps::last(rest) } } }

// What a sequence's accessor asks of a selection at an owner: an element's
// or a window's proposition; nothing of another kind.
fn Dyn::pre(tys: Nat → Type, strs: Strs(tys), sel: Sel, d: Dyn(tys)) → Type {
    (match d.code as λ c => El(tys, c) → Type {
        SWord(_) => λ _ => True,
        SNamed(k) => λ v => match strs(k).kind {
            Sequence(q) => match sel {
                OnSeq(a) => match a { SeqOne(i) => q.Pre(v, i), SeqRun(lo, n) => match q.win { Some(w) => w.Pre(v, lo, n), None => True } },
                OnField(_) => True, OnKey(_) => True, OnVariant(_) => True,
            },
            Opaque => True,
            Record(_) => True,
        },
    })(d.val)
}

// What is written fits what was there: its code, and a sequence's length.
fn Dyn::Fits(tys: Nat → Type, strs: Strs(tys), old, new: Dyn(tys)) → Type { (new.code.same(old.code) = True) ∧ (Dyn::len(tys, strs, new) = Dyn::len(tys, strs, old)) }

// What a residual says at a state: `args` are the function's own
// arguments, which a measure is compared against.
record Ctx(tys: Nat → Type) { strs: Strs(tys), w: Callees(tys), me: Nat, pres: Pres(tys), need: Need(tys), args: List<Dyn(tys)> }

fn Residual::Holds(self r: Residual, tys: Nat → Type, cx: Ctx(tys), env: Env(tys)) → Type {
    match r {
        RApart(lo1, n1, lo2, n2) => {
            let ns = Ix::nats(Env::ixs(tys, env));
            (lo1.val(ns) + n1.val(ns) <= lo2.val(ns)) ∨ (lo2.val(ns) + n2.val(ns) <= lo1.val(ns))
        },
        RPre(g, args) => cx.pres(g, args.map(λ x => Env::get(tys, env, x))),
        RAccess(p) => match Steps::last(p.steps) {
            Some(a) => Dyn::pre(tys, cx.strs, a.sel(Env::ixs(tys, env)), Place(p.root, Steps::init(p.steps)).val(tys, cx.strs, env)),
            None => True,
        },
        RFits(p, v) => Dyn::Fits(tys, cx.strs, p.val(tys, cx.strs, env), Env::get(tys, env, v)),
        RMeasure(g, args) => cx.need(g, args.map(λ x => Env::get(tys, env, x))) < cx.need(cx.me, cx.args),
    }
}

fn Residual::All(rs: List<Residual>, tys: Nat → Type, cx: Ctx(tys), env: Env(tys), tail: Type) → Type {
    match rs { Nil => tail, Cons(r, rest) => r.Holds(tys, cx, env) ∧ Residual::All(rest, tys, cx, env, tail) }
}

// ---------------------------------------------------------------------------
// The verdict's tree, and what it owes along the meaning

inductive Owes { OEnd, ODo(here: List<Residual>, rest: Owes), OJoin(yes: Owes, no: Owes, rest: Owes), OJump(here: List<Residual>) }

fn Cases(c: Bool, x, y: Type) → Type { match c { True => x, False => y } }

// Each statement's residuals at the state it reads, then what follows at
// the state after it; a join's arms under their sides of the test; after a
// join of two yielding arms, what follows once at the joined state; after
// one whose arm leaves, at each `Yield`, which is where the meaning reads
// what follows. A verdict not in the body's shape owes `False`.
fn Owes::Holds(self d: Owes, tys: Nat → Type, cx: Ctx(tys), b: Body, env: Env(tys), after: List<Dyn(tys)> → Type) → Type {
    match b {
        Ret(_) => True,
        Yield(os) => after(os.map(λ x => Env::get(tys, env, x))),
        Jump(_) => match d { OJump(here) => Residual::All(here, tys, cx, env, True), _ => False },
        Do(s, rest) => match d {
            ODo(here, dr) => Residual::All(here, tys, cx, env, dr.Holds(tys, cx, rest, s.eval(Env(tys), tys, cx.strs, cx.w, env, λ e => e), after)),
            _ => False,
        },
        Join(t, yes, no, rest) => match d {
            OJoin(dy, dn, dr) => match yes.exits() || no.exits() {
                False => Cases(t.bit(tys, env), dy.Holds(tys, cx, yes, env, λ _ => True), dn.Holds(tys, cx, no, env, λ _ => True)) ∧
                    dr.Holds(tys, cx, rest, Env::push_all(tys, env, Body::joined(tys, t.bit(tys, env),
                        yes.mean(List<Dyn(tys)>, tys, cx.strs, cx.w, cx.me, env, λ _ => Nil, λ ds => ds), no.mean(List<Dyn(tys)>, tys, cx.strs, cx.w, cx.me, env, λ _ => Nil, λ ds => ds))), after),
                True => {
                    let next = λ (ds: List<Dyn(tys)>) => dr.Holds(tys, cx, rest, Env::push_all(tys, env, ds), after);
                    Cases(t.bit(tys, env), dy.Holds(tys, cx, yes, env, next), dn.Holds(tys, cx, no, env, next))
                },
            },
            _ => False,
        },
    }
}

// What a function owes at its arguments.
fn Owes::Due(self d: Owes, tys: Nat → Type, cx: Ctx(tys), f: Func) → Type { d.Holds(tys, cx, f.body, Env::start(tys, cx.args), λ _ => True) }

// ---------------------------------------------------------------------------
// A program, a function's safety, and `check_sound`

// A program: its environments, its functions, their meanings, their
// preconditions and measures (a function with none answers `None`), which
// callees are primitives, and the histories each function's meaning
// reaches. A primitive is §15.4's "level 2's primitive": a world entry the
// program gives no body, which only reads (`Sig::reads_only`) and answers
// plain values; its run is the world's function at its arguments read
// through the heap (`Run::prim`), so it owes no soundness proof of its own.
// There is no other kind.
record Prog(tys: Nat → Type) {
    strs: Strs(tys),
    fns: Nat → Func,
    w: Callees(tys),
    pres: Pres(tys),
    need: Nat → Option<Need(tys)>,
    prim: Nat → Bool,
    reaches: Nat → List<Dyn(tys)> → List<Exchange> → Type,
}

// The program's run: the defined one.
fn Prog::run(tys: Nat → Type, self p: Prog(tys), fuel, g: Nat, vs: List<Value(tys)>, h: Heap(tys), io: Io) → Ran(tys) { Run::of(tys, p.strs, p.fns, p.w, p.prim, fuel, g, vs, h, io) }

fn Prog::ctx(tys: Nat → Type, self p: Prog(tys), g: Nat, args: List<Dyn(tys)>) → Ctx(tys) {
    Ctx(p.strs, p.w, g, p.pres, λ g2 ds => match p.need(g2) { Some(n) => n(g2, ds), None => 0 }, args)
}

// Values read as the meaning's, at a fill fuel.
fn Value::ReadAll(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), fuel: Nat, vs: List<Value(tys)>) → List<Dyn(tys)> → Type {
    match vs {
        Nil => λ ds => match ds { Nil => True, Cons(_, _) => False },
        Cons(v, vr) => λ ds => match ds { Nil => False, Cons(d, dr) => (Value::read(tys, v, strs, h, fuel) = Some(d)) ∧ Value::ReadAll(tys, strs, h, fuel, vr, dr) },
    }
}

// `PMode::changes` and `Value::lent` are `run.hthr`'s: the run's stores are
// stuck outside what the activation was lent to change (`Act`).

// Two selection paths of one value apart: a modification through either
// leaves the other's read and whether it fits (a run's read is stuck where
// it does not), and the two commute.
record SelApart(tys: Nat → Type, strs: Strs(tys), xs, ys: List<Sel>) {
    reads: ApartAt<Dyn(tys)>(λ d => Sel::read_at(tys, strs, xs, d), λ g d => Sel::write_at(tys, strs, xs, g, d), λ d => Sel::read_at(tys, strs, ys, d), λ g d => Sel::write_at(tys, strs, ys, g, d)),
    fit1: (g: Dyn(tys) → Dyn(tys)) → (d: Dyn(tys)) → Sel::fit(tys, strs, xs, Sel::write_at(tys, strs, ys, g, d)) = Sel::fit(tys, strs, xs, d),
    fit2: (g: Dyn(tys) → Dyn(tys)) → (d: Dyn(tys)) → Sel::fit(tys, strs, ys, Sel::write_at(tys, strs, xs, g, d)) = Sel::fit(tys, strs, ys, d),
}

fn Sel::Apart(tys: Nat → Type, strs: Strs(tys), xs, ys: List<Sel>) → Type { SelApart(tys, strs, xs, ys) }

// Two references apart: in different blocks, or apart in one.
fn Ref::Apart(tys: Nat → Type, strs: Strs(tys), r, q: Ref) → Type { (r.b = q.b) → Sel::Apart(tys, strs, r.sels, q.sels) }

// What a function may assume of its inputs (§15.8: a function requires only
// that what it may change is not aliased), named once: one argument per
// parameter; each referring argument's block is live and has no holes, and its selections fit there;
// an argument taken at a plain code is a plain value; an argument the
// callee may change is apart from every other argument; and an object taken
// is a whole block no other argument refers to, since the callee owns it and
// its death frees the block.
record Lendable(tys: Nat → Type, strs: Strs(tys), ps: List<Param>, h: Heap(tys), vs: List<Value(tys)>) {
    arity: vs.len() = ps.len(),
    live: (i: Nat) → (r: Ref) → vs.nth(i) = Some(Refer(r)) → Exists<Dyn(tys)>(λ d => (Heap::obj(tys, h, r.b) = Some(Obj(d, Nil))) ∧ (Sel::fit(tys, strs, r.sels, d) = True)),
    plain: (i: Nat) → (p: Param) → ps.nth(i) = Some(p) → p.mode = ByTake → Shape::plain(tys, strs, p.code) = True → (r: Ref) → ¬(vs.nth(i) = Some(Refer(r))),
    apart: (i, k: Nat) → ¬(i = k) → (p: Param) → ps.nth(i) = Some(p) → p.mode.changes() = True → (r, q: Ref) → vs.nth(i) = Some(Refer(r)) → vs.nth(k) = Some(Refer(q)) →
        Ref::Apart(tys, strs, r, q),
    whole: (i: Nat) → (p: Param) → ps.nth(i) = Some(p) → p.mode = ByTake → Shape::plain(tys, strs, p.code) = False → (r: Ref) → vs.nth(i) = Some(Refer(r)) →
        (r.sels = Nil) ∧ ((k: Nat) → ¬(k = i) → (q: Ref) → vs.nth(k) = Some(Refer(q)) → ¬(q.b = r.b)),
}

// The meaning's arguments have the parameters' codes: what makes a junk
// meaning of an ill-coded input sound to promise nothing about. Without it a
// function that reads a field of an argument given a word owes nothing and
// its run is stuck (§23.7, `get_x`). A Boolean equation, so `refl` at a
// closed call.
fn Dyn::coded(tys: Nat → Type, ds: List<Dyn(tys)>, ps: List<Param>) → Bool {
    match ds {
        Nil => match ps { Nil => True, Cons(_, _) => False },
        Cons(d, dr) => match ps { Nil => False, Cons(q, pr) => d.code.same(q.code) && Dyn::coded(tys, dr, pr) },
    }
}

fn Dyn::Coded(tys: Nat → Type, ds: List<Dyn(tys)>, ps: List<Param>) → Type { Dyn::coded(tys, ds, ps) = True }

// A signature's results read as parameters of their codes, for `Dyn::Coded`
// (the mode is not read).
fn Sig::res_params(self sg: Sig) → List<Param> { sg.results.map(λ r => Param(r.code, ByTake)) }

// Each written parameter, after: a referring argument's slot in the answer
// is the argument itself, so the caller's view of what it lent stays its
// own reference (what the slot reads is `ReadAll`'s), and one passed by value
// comes back a plain value (§23.17: the caller's view of it is a copy); and
// the meaning's value after fits the value before. (A plain one's value
// after is in the answer's written slots, which `ReadAll` reads.)
fn Value::Written(tys: Nat → Type, strs: Strs(tys), vs: List<Value(tys)>, ds: List<Dyn(tys)>, is: List<Nat>) → List<Value(tys)> → List<Dyn(tys)> → Type {
    match is {
        Nil => λ _ _ => True,
        Cons(i, rest) => λ slots outs => match slots {
            Nil => False,
            Cons(a, arest) => match outs {
                Nil => False,
                Cons(o, orest) =>
                    (match vs.nth(i).unwrap_or(Plain(Dyn::none(tys))) as λ _ => Type { Refer(r) => a = Refer(r), Plain(_) => Value::refers(tys, a) = False }) ∧
                    Dyn::Fits(tys, strs, ds.nth(i).unwrap_or(Dyn::none(tys)), o) ∧
                    Value::Written(tys, strs, vs, ds, rest, arest, orest),
            },
        },
    }
}

// A block live with no holes. **This fragment's clause**: a caller's object
// is a bare block (`Inv.bare`), so the block of a fresh result the caller
// takes as its own must be one; the round with holes replaces it, with
// `Heap::Stays`' no-holes part, by what the caller may read through holes.
fn Heap::Bare(tys: Nat → Type, h: Heap(tys), b: Nat) → Type { Exists<Obj(tys)>(λ ob => (Heap::obj(tys, h, b) = Some(ob)) ∧ (ob.holes = Nil)) }

// Each result, after, as its origin says: a fresh one is plain or a block
// this call made (none below the heap's length `n` before it, so no argument
// reaches it), live with no holes in the heap after `h`; a parameter's is the
// argument itself where it refers (one passed by value comes back a plain
// value, changed or not); a view is the argument's reference narrowed by the
// steps the signature names (a copy, where the argument was passed by value),
// read at the call's words: the arguments', then the results'.
fn Value::ViewIs(tys: Nat → Type, strs: Strs(tys), n: Nat, h: Heap(tys), vs: List<Value(tys)>, ws: List<Ix>, code: Shape, org: Origin, o: Value(tys)) → Type {
    match org {
        OView(i, xs) => match vs.nth(i) { Some(v) => match v { Refer(r) => o = Refer(r.narrow(ws, xs)), Plain(_) => Value::refers(tys, o) = False }, None => False },
        OFresh => match o { Plain(_) => True, Refer(r) => (Shape::plain(tys, strs, code) = False) ∧ ((n <= r.b) ∧ ((r.sels = Nil) ∧ Heap::Bare(tys, h, r.b))) },
        OParam(i) => match vs.nth(i) { Some(v) => match v { Refer(r) => o = Refer(r), Plain(_) => Value::refers(tys, o) = False }, None => False },
    }
}

fn Value::Views(tys: Nat → Type, strs: Strs(tys), n: Nat, h: Heap(tys), vs: List<Value(tys)>, ws: List<Ix>, rs: List<Result>) → List<Value(tys)> → Type {
    match rs {
        Nil => λ _ => True,
        Cons(r, rest) => λ outs => match outs { Nil => False, Cons(o, orest) => Value::ViewIs(tys, strs, n, h, vs, ws, r.code, r.origin, o) ∧ Value::Views(tys, strs, n, h, vs, ws, rest, orest) },
    }
}

// An owning result's block, where it refers: a fresh one, or a parameter
// answered back (a view owns nothing).
fn Value::owned_b(tys: Nat → Type, org: Origin, o: Value(tys)) → Option<Nat> {
    match org { OFresh => match o { Refer(r) => Some(r.b), Plain(_) => None }, OParam(_) => match o { Refer(r) => Some(r.b), Plain(_) => None }, OView(_, _) => None }
}

// No later result owns block `b`.
fn Value::NotOwned(tys: Nat → Type, b: Nat, rs: List<Result>, outs: List<Value(tys)>) → Type {
    match rs { Nil => True, Cons(r, rest) => match outs { Nil => True, Cons(o, orest) => ¬(Value::owned_b(tys, r.origin, o) = Some(b)) ∧ Value::NotOwned(tys, b, rest, orest) } }
}

// Two results that own are in different blocks (§23.17, §23.21): fresh or a
// moved parameter, the caller (or a host outside the program) takes each as
// an object alone in its block (`Inv.own`), and the death of one frees no
// other's.
fn Value::OwnedApart(tys: Nat → Type, rs: List<Result>, outs: List<Value(tys)>) → Type {
    match rs {
        Nil => True,
        Cons(r, rest) => match outs {
            Nil => True,
            Cons(o, orest) => (match Value::owned_b(tys, r.origin, o) as λ _ => Type { Some(b) => Value::NotOwned(tys, b, rest, orest), None => True }) ∧ Value::OwnedApart(tys, rest, orest),
        },
    }
}

// What a block holds at a selection path: its object's value read there,
// where the path fits (holes are not read: the fragment has none).
fn Heap::at(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), b: Nat, q: List<Sel>) → Option<Dyn(tys)> { Heap::obj(tys, h, b).and_then(λ o => Sel::get(tys, strs, q, o.val)) }

// One reference's put into block `b` (§18.3's lens): the part it selects in
// `d` overwritten by what it selects in `a`; nothing where it is into
// another block.
fn Sel::put_ref(tys: Nat → Type, strs: Strs(tys), r: Ref, b: Nat, a, d: Dyn(tys)) → Dyn(tys) {
    match r.b.same(b) { True => Sel::write_at(tys, strs, r.sels, λ _ => Sel::read_at(tys, strs, r.sels, a), d), False => d }
}

// The references' puts into block `b`, in the list's order. Puts of
// references apart commute (`Sel::put_ref_comm`), so the order is a
// spelling, not a choice.
fn Sel::put_lent(tys: Nat → Type, strs: Strs(tys), rs: List<Ref>, b: Nat, a, d: Dyn(tys)) → Dyn(tys) {
    match rs { Nil => d, Cons(r, rest) => Sel::put_lent(tys, strs, rest, b, a, Sel::put_ref(tys, strs, r, b, a, d)) }
}

// The heap after is the heap before with what was lent to change replaced
// (§18.3's lens equation): at every block live before that nothing was lent
// to change whole, the block is live after and its value after is its value
// before with each reference lent to change into it overwritten by what that
// reference reads after. Every path apart from what was lent reads, and
// fits, as before (`Heap::frame_apart`), and a block lent to nothing is its
// value before (`Heap::frame_whole`); without the equation a record kind's
// fields need not cover its type, and a path under a lent one could not be
// spoken of (§23.17, `lend_under_checked`). A block lent to change whole (a
// reference with no selections, as a taken object is) is the callee's; a
// block made by the call is not spoken of. Only references lent to change
// count (`Value::lent`): a block lent only to read is unchanged (§23.8).
fn Heap::Frame(tys: Nat → Type, strs: Strs(tys), before, after: Heap(tys), rs: List<Ref>) → Type {
    (b: Nat) → ((r: Ref) → Mem(r, rs) → r.b = b → ¬(r.sels = Nil)) → (ob: Obj(tys)) → Heap::obj(tys, before, b) = Some(ob) →
        Exists<Obj(tys)>(λ ob2 => (Heap::obj(tys, after, b) = Some(ob2)) ∧ (ob2.val = Sel::put_lent(tys, strs, rs, b, ob2.val, ob.val)))
}

// The blocks a call leaves beside the ones it was given (§23.17): a block
// that existed is live after only if it was live before, and has no holes
// after where it had none. The run only stores into a block (keeping its
// holes), kills one, or adds one past the end; a caller re-reads its own
// objects' blocks after a call, and lends them again, by this. **This
// fragment's clause, not a law of level 2**: this round has no holes, so "no
// holes before, none after" is the whole truth here. The round that adds
// holes replaces it with the frame reading holes as well as values (a hole
// apart from what was lent is kept, one under it is the callee's to change);
// it is to be replaced, not generalised around.
fn Heap::Stays(tys: Nat → Type, before, after: Heap(tys)) → Type {
    (b: Nat) → b < before.len() → (ob2: Obj(tys)) → Heap::obj(tys, after, b) = Some(ob2) → Exists<Obj(tys)>(λ ob => (Heap::obj(tys, before, b) = Some(ob)) ∧ (ob.holes = Nil → ob2.holes = Nil))
}

// The heap a call leaves: no shorter, and its old blocks `Stays`.
fn Heap::Kept(tys: Nat → Type, before, after: Heap(tys)) → Type { (before.len() <= after.len()) ∧ Heap::Stays(tys, before, after) }

// A function's safety at one fuel: what its run owes at every input that
// reads as the meaning's arguments, meets the function's precondition and
// is lendable. The meaning is the program's world (each function's pin
// relates it to its body: `CheckSound`'s premise).
fn SafeAt(tys: Nat → Type, p: Prog(tys), g: Nat, fuel: Nat) → Type {
    (vs: List<Value(tys)>) → (h: Heap(tys)) → (io: Io) → (ds: List<Dyn(tys)>) → Value::ReadAll(tys, p.strs, h, h.len(), vs, ds) → Dyn::Coded(tys, ds, (p.fns(g)).sig.params) → p.pres(g, ds) →
        Lendable(tys, p.strs, (p.fns(g)).sig.params, h, vs) →
        ¬(p.run(tys, fuel, g, vs, h, io) = Stuck) ∧
        ((match p.need(g) as λ _ => Type { Some(n) => n(g, ds) <= fuel → Exists<Answer(tys)>(λ a => p.run(tys, fuel, g, vs, h, io) = Done(a)), None => True }) ∧
        (((a: Answer(tys)) → p.run(tys, fuel, g, vs, h, io) = Done(a) →
            Value::ReadAll(tys, p.strs, a.heap, a.heap.len(), a.results, p.w(g, ds)) ∧
            Value::Written(tys, p.strs, vs, ds, (p.fns(g)).sig.written(), a.results.drop((p.fns(g)).sig.results.len()), (p.w(g, ds)).drop((p.fns(g)).sig.results.len())) ∧
            Heap::Frame(tys, p.strs, h, a.heap, Value::lent(tys, (p.fns(g)).sig.params, vs)) ∧
            Heap::Kept(tys, h, a.heap) ∧
            Value::Views(tys, p.strs, h.len(), a.heap, vs, Dyn::ixs(tys, ds ++ p.w(g, ds)), (p.fns(g)).sig.results, a.results) ∧
            Value::OwnedApart(tys, (p.fns(g)).sig.results, a.results) ∧
            Dyn::Coded(tys, (p.w(g, ds)).take((p.fns(g)).sig.results.len()), (p.fns(g)).sig.res_params())) ∧
        (match p.need(g) as λ _ => Type { Some(_) => True, None => (io2: Io) → p.run(tys, fuel, g, vs, h, io) = Going(io2) → p.reaches(g, ds, io2.past) })))
}

// Safety relative to the callees' at less fuel.
fn Safety(tys: Nat → Type, p: Prog(tys), g: Nat) → Type { (fuel: Nat) → ((g2, k: Nat) → k < fuel → SafeAt(tys, p, g2, k)) → SafeAt(tys, p, g, fuel) }

// ---------------------------------------------------------------------------
// The checker, and what is stated of it

// A primitive's signature: every parameter read, or taken plain; every
// result fresh and plain.
fn Sig::reads_only(tys: Nat → Type, strs: Strs(tys), sg: Sig) → Bool {
    sg.params.all_bit(λ p => match p.mode { ByRead => True, ByTake => Shape::plain(tys, strs, p.code), ByWrite => False })
        && sg.results.all_bit(λ r => (match r.origin { OFresh => True, OParam(_) => False, OView(_, _) => False }) && Shape::plain(tys, strs, r.code))
}

// A checker: from the environment's structures, the program's signatures,
// which callees are primitives, which functions are measured (have a
// `need`) and a function's index, its verdict, or a refusal.
fn Checker(tys: Nat → Type) → Type<1> { Strs(tys) → (Nat → Sig) → (Nat → Bool) → (Nat → Bool) → Nat → Func → Option<Owes> }

fn Prog::measured(tys: Nat → Type, self p: Prog(tys), g: Nat) → Bool { match p.need(g) { Some(_) => True, None => False } }

// Each function's pin: its meaning in the world is its body's, pointwise.
fn Prog::Pinned(tys: Nat → Type, p: Prog(tys)) → Type {
    (g: Nat) → p.prim(g) = False → (ds: List<Dyn(tys)>) → p.w(g, ds) = (p.fns(g)).denote(tys, p.strs, p.w, g, ds)
}

// A law of the world (§23.21): a primitive's answer at coded arguments has
// its signature's result codes. A function with a body gives its results'
// codes from its own checked `Ret`; a primitive's answer is the world's, so
// the program states it. Without it `y = g(); Read(y.f)`, checked, is stuck
// at a world answering a word (`prim_word_stuck`).
fn Prog::Coded(tys: Nat → Type, p: Prog(tys)) → Type {
    (g: Nat) → p.prim(g) = True → (ds: List<Dyn(tys)>) → Dyn::Coded(tys, ds, (p.fns(g)).sig.params) →
        Dyn::Coded(tys, (p.w(g, ds)).take((p.fns(g)).sig.results.len()), (p.fns(g)).sig.res_params())
}

// `check_sound`: in a program whose functions are pinned and whose
// primitives answer coded, a verdict, and what it owes holding at every
// argument list meeting the function's precondition, give the function's
// safety.
fn CheckSound(tys: Nat → Type, check: Checker(tys)) → Type<1> {
    (p: Prog(tys)) → Prog::Pinned(tys, p) → Prog::Coded(tys, p) → (g: Nat) → (d: Owes) → check(p.strs, λ g2 => (p.fns(g2)).sig, p.prim, λ g2 => p.measured(tys, g2), g, p.fns(g)) = Some(d) →
        ((args: List<Dyn(tys)>) → Dyn::Coded(tys, args, (p.fns(g)).sig.params) → p.pres(g, args) → d.Due(tys, Prog::ctx(tys, p, g, args), p.fns(g))) → Safety(tys, p, g)
}

// Paths as data: steps, their denotation, and an apartness decider
// (docs/language/ownership-design.md §15.3, §15.5; issues/ownership-steps.md).
//
// A place is a root and steps. A `Step` is a field, an element at an index,
// a window, a key, or an enum's variant, over atoms (`atom.hthr`): closed
// data, compared by evaluation, where a `Path` (`path.hthr`) is a pair of
// functions and cannot be compared at all.
//
// - **Untyped steps, a total model that denotes them.** A step does not
//   carry its source and target types: a field step goes from a record to
//   one of its fields, and an inductive family indexed by types is a
//   universe above what the kernel evaluates cheaply. An atom reads as an
//   index (`Ix`): a number, or a word of a width, the variable's own value,
//   which an instance reads at its own accessor's type and the decider as a
//   number. A `StepModel<S>`
//   gives each step with its atoms read (a `Sel`) a total read `at` and a
//   total modification `over` of one value type `S`, a Boolean "this step
//   fits this owner", and a relative fit `like` (what is written there is
//   like what was read there: for a typed value its code, for a window its
//   length). `Steps::at` and `Steps::over` compose them. Its laws
//   (`StepModelLaws`) are what the decider's soundness reads of a model:
//   where a step fits, a modification whose result is like what was read
//   is read back, two are one, and a modification reads only what was read;
//   where it does not fit it modifies nothing; every modification keeps an
//   owner like what it was like; and two steps whose selections are apart
//   are apart (`ApartAt`). Nothing is read through an `Option` and no
//   inhabitant is asked (docs/language/ownership-design.md §21.1).
// - **The decider** `Steps::apart(xs, ys)` walks the common prefix and
//   compares the first steps that differ: no (`None`: one list is a prefix
//   of the other, or the first difference overlaps or mixes kinds), yes
//   (`Some(Nil)`), or yes owing obligations over the atoms (`Some(rs)`)
//   where an index or a key is open. It reads no value and no word.
// - **Sound** (`Steps::apart_sound`): a verdict and its obligations holding
//   at the words give the two places apart (`Steps::Apart`), by
//   `ApartAt::under` down the common prefix and `ApartAt::then_both` after
//   the difference.
// - **Where it is complete**: on closed steps it never owes anything
//   (`Steps::apart_closed`), and two step lists that first differ at a pair
//   of steps whose closed selections are apart are found apart
//   (`Steps::apart_at_difference`). It is incomplete where an open index is
//   followed by more steps (`[Elem(x), Field(0)]` and `[Elem(y), Field(1)]`
//   are apart whatever `x` and `y` are, and the decider owes `x ≠ y`),
//   between steps of different kinds (refused, though in a model where no
//   value is both a record and a sequence they are vacuously apart), and
//   between steps that are never valid together.
import logic;
import bool;
import nat;
import option;
import list;
import span_set;
import store;
import store_path;
import bitvec;
import atom;

// ---------------------------------------------------------------------------
// Steps

inductive Step {
    SField(i: Nat),
    SElem(i: Atom),
    SWindow(lo: Atom, n: Atom),
    SKey(index: Atom, gen: Atom),
    SVariant(c: Nat),
}

fn Step::same(self a, b: Step) → Bool {
    match a {
        SField(i) => match b { SField(j) => i.same(j), _ => False },
        SElem(i) => match b { SElem(j) => i.same(j), _ => False },
        SWindow(lo, n) => match b { SWindow(lo2, n2) => lo.same(lo2) && n.same(n2), _ => False },
        SKey(i, g) => match b { SKey(i2, g2) => i.same(i2) && g.same(g2), _ => False },
        SVariant(c) => match b { SVariant(d) => c.same(d), _ => False },
    }
}

// A place's steps from its root, the first outermost.
fn Steps() → Type { List<Step> }

// Every atom of the step is a literal.
fn Step::closed(self a: Step) → Bool {
    match a {
        SField(_) => True,
        SElem(i) => i.closed(),
        SWindow(lo, n) => lo.closed() && n.closed(),
        SKey(i, g) => i.closed() && g.closed(),
        SVariant(_) => True,
    }
}

fn Steps::closed(xs: List<Step>) → Bool { match xs { Nil => True, Cons(a, rest) => a.closed() && Steps::closed(rest) } }

// ---------------------------------------------------------------------------
// Selections: steps with their atoms read

// An index as the source holds it: a number, or a word of a width. An
// instance reads it at its own accessor's type; the decider reads it as a
// number.
inductive Ix { INat(n: Nat), IWord(w: Nat, v: BitVec(w)) }

fn Ix::toNat(self i: Ix) → Nat { match i { INat(n) => n, IWord(_, v) => v.toNat() } }

fn Ix::nats(ws: List<Ix>) → List<Nat> { ws.map(λ (i: Ix) => i.toNat()) }

fn Ix::of_nats(ns: List<Nat>) → List<Ix> { ns.map(λ (n: Nat) => INat(n)) }

// An atom read as an index: a literal is a number.
fn Atom::ix(self a: Atom, ws: List<Ix>) → Ix { match a { Lit(n) => INat(n), Var(w) => ws.nth(w).unwrap_or(INat(0)) } }

// One element, or a run of `n` from `lo`.
inductive SeqSel { SeqOne(i: Ix), SeqRun(lo: Ix, n: Ix) }

fn SeqSel::span(self a: SeqSel) → Span { match a { SeqOne(i) => Span(i.toNat(), 1), SeqRun(lo, n) => Span(lo.toNat(), n.toNat()) } }

inductive Sel { OnField(i: Nat), OnSeq(a: SeqSel), OnKey(k: Key), OnVariant(c: Nat) }

fn Step::sel(self a: Step, ws: List<Ix>) → Sel {
    match a {
        SField(i) => OnField(i),
        SElem(i) => OnSeq(SeqOne(i.ix(ws))),
        SWindow(lo, n) => OnSeq(SeqRun(lo.ix(ws), n.ix(ws))),
        SKey(i, g) => OnKey(Key(i.val(Ix::nats(ws)), g.val(Ix::nats(ws)))),
        SVariant(c) => OnVariant(c),
    }
}

// An atom's index read as a number is the atom read at the numbers.
theorem Ix::nth_nat(ws: List<Ix>): (w: Nat) → ws.nth(w).unwrap_or(INat(0)).toNat() = word(Ix::nats(ws), w) {
    match ws { Nil => λ w => refl, Cons(_, t) => λ w => match w { Zero => refl, Succ(k) => Ix::nth_nat(t, k) } }
}

theorem Atom::ix_nat(self a: Atom, ws: List<Ix>): a.ix(ws).toNat() = a.val(Ix::nats(ws)) { match a { Lit(_) => refl, Var(w) => Ix::nth_nat(ws, w) } }

theorem Ix::nats_of(ns: List<Nat>): Ix::nats(Ix::of_nats(ns)) = ns { match ns { Nil => refl, Cons(h, t) => List::cong_cons(h, Ix::nats_of(t)) } }

// Two spans of indices apart is the obligation at the numbers.
theorem Atom::spans_ix(lo1, n1, lo2, n2: Atom, ws: List<Ix>):
    Span(lo1.ix(ws).toNat(), n1.ix(ws).toNat()).apart(Span(lo2.ix(ws).toNat(), n2.ix(ws).toNat())) = Spans(lo1, n1, lo2, n2).verdict(Ix::nats(ws))
{
    Atom::cong4(λ (a: Nat) (b: Nat) (c: Nat) (d: Nat) => Span(a, b).apart(Span(c, d)), lo1.ix_nat(ws), n1.ix_nat(ws), lo2.ix_nat(ws), n2.ix_nat(ws))
}

theorem Atom::spans_hold(lo1, n1, lo2, n2: Atom, ws: List<Ix>, h: Spans(lo1, n1, lo2, n2).Holds(Ix::nats(ws))):
    Span(lo1.ix(ws).toNat(), n1.ix(ws).toNat()).apart(Span(lo2.ix(ws).toNat(), n2.ix(ws).toNat())).IsTrue()
{
    j(sym(Atom::spans_ix(lo1, n1, lo2, n2, ws)), λ b _ => b.IsTrue(), h)
}

// Two selections of one kind that cannot meet: fields, elements and runs by
// their spans, keys by being different, variants by being different. Two
// of different kinds are not found apart.
fn Sel::apart(self a, b: Sel) → Bool {
    match a {
        OnField(i) => match b { OnField(j) => Span(i, 1).apart(Span(j, 1)), _ => False },
        OnSeq(x) => match b { OnSeq(y) => x.span().apart(y.span()), _ => False },
        OnKey(k) => match b { OnKey(l) => k.apart(l), _ => False },
        OnVariant(c) => match b { OnVariant(d) => !c.same(d), _ => False },
    }
}

// ---------------------------------------------------------------------------
// A model, and the denotation

// Each selection as a total read and a total modification of one value
// type `S`; whether the step fits an owner; and whether a value written
// there is like the value read there (for a typed value, the same code; for
// a window, the same length).
record StepModel<S> { at: Sel → S → S, over: Sel → (S → S) → S → S, fits: Sel → S → Bool, like: Sel → S → S → Bool }

// Two places of one owner apart: a modification through either leaves the
// other's read, and the two modifications commute.
record ApartAt<S>(at1: S → S, over1: (S → S) → S → S, at2: S → S, over2: (S → S) → S → S) {
    left_after_right: (g: S → S) → (s: S) → at1(over2(g, s)) = at1(s),
    right_after_left: (g: S → S) → (s: S) → at2(over1(g, s)) = at2(s),
    commute: (f, g: S → S) → (s: S) → over1(f, over2(g, s)) = over2(g, over1(f, s)),
}

// The laws hold where the step fits, relative to what it read there. A step
// that does not fit modifies nothing; what it reads there is the model's
// own (the soundness below never reads it).
record StepModelLaws<S>(m: StepModel<S>) {
    still: (a: Sel) → (g: S → S) → (s: S) → m.fits(a, s) = False → m.over(a, g, s) = s,
    over_at: (a: Sel) → (g: S → S) → (s: S) → m.fits(a, s) = True → m.like(a, m.at(a, s), g(m.at(a, s))) = True → m.at(a, m.over(a, g, s)) = g(m.at(a, s)),
    over_over: (a: Sel) → (g, h: S → S) → (s: S) → m.fits(a, s) = True → m.like(a, m.at(a, s), g(m.at(a, s))) = True →
        m.like(a, m.at(a, s), h(g(m.at(a, s)))) = True → m.over(a, h, m.over(a, g, s)) = m.over(a, λ x => h(g(x)), s),
    over_read: (a: Sel) → (g, h: S → S) → (s: S) → g(m.at(a, s)) = h(m.at(a, s)) → m.over(a, g, s) = m.over(a, h, s),
    like_refl: (a: Sel) → (x: S) → m.like(a, x, x) = True,
    keeps: (a, b: Sel) → (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, m.over(b, g, s)) = True,
    apart: (a, b: Sel) → a.apart(b).IsTrue() → ApartAt<S>(m.at(a), m.over(a), m.at(b), m.over(b)),
    // Writing back what was read changes nothing, where the step fits and
    // where it does not.
    put_back: (a: Sel) → (s: S) → m.over(a, λ _ => m.at(a, s), s) = s,
    // A modification at any step keeps whether every step fits.
    fits_over: (a, b: Sel) → (g: S → S) → (s: S) → m.fits(a, m.over(b, g, s)) = m.fits(a, s),
}

// The steps from the root, the first outermost: read, and modified.
fn Steps::at<S>(m: StepModel<S>, ws: List<Ix>, xs: List<Step>, s: S) → S {
    match xs { Nil => s, Cons(a, rest) => Steps::at(m, ws, rest, m.at(a.sel(ws), s)) }
}

fn Steps::over<S>(m: StepModel<S>, ws: List<Ix>, xs: List<Step>, g: S → S, s: S) → S {
    match xs { Nil => g(s), Cons(a, rest) => m.over(a.sel(ws), λ x => Steps::over(m, ws, rest, g, x), s) }
}

// Two places apart, as the denotation of their steps.
fn Steps::Apart<S>(m: StepModel<S>, ws: List<Ix>, xs, ys: List<Step>) → Type {
    ApartAt<S>(λ s => Steps::at(m, ws, xs, s), λ g s => Steps::over(m, ws, xs, g, s), λ s => Steps::at(m, ws, ys, s), λ g s => Steps::over(m, ws, ys, g, s))
}

// Whether every step of a place fits, read down from the root.
fn Steps::fit<S>(m: StepModel<S>, ws: List<Ix>, xs: List<Step>, s: S) → Bool {
    match xs { Nil => True, Cons(a, rest) => m.fits(a.sel(ws), s) && Steps::fit(m, ws, rest, m.at(a.sel(ws), s)) }
}

// A modification at `xs` keeps whether `ys` fits.
fn Steps::KeepsFit<S>(m: StepModel<S>, ws: List<Ix>, xs, ys: List<Step>) → Type {
    (g: S → S) → (s: S) → Steps::fit(m, ws, ys, Steps::over(m, ws, xs, g, s)) = Steps::fit(m, ws, ys, s)
}

// ---------------------------------------------------------------------------
// The decider

// The first two steps that differ: are they apart?
fn Step::apart(self a, b: Step) → Option<List<Obligation>> {
    match a {
        SField(i) => match b { SField(j) => Span(i, 1).apart(Span(j, 1)).then(Some(Nil)), _ => None },
        SElem(i) => match b {
            SElem(j) => Spans(i, Lit(1), j, Lit(1)).settle(),
            SWindow(lo, n) => Spans(i, Lit(1), lo, n).settle(),
            _ => None,
        },
        SWindow(lo, n) => match b {
            SElem(j) => Spans(lo, n, j, Lit(1)).settle(),
            SWindow(lo2, n2) => Spans(lo, n, lo2, n2).settle(),
            _ => None,
        },
        SKey(i, g) => match b { SKey(i2, g2) => Keys(i, g, i2, g2).settle(), _ => None },
        SVariant(c) => match b { SVariant(d) => (!c.same(d)).then(Some(Nil)), _ => None },
    }
}

fn Steps::apart(xs, ys: List<Step>) → Option<List<Obligation>> {
    match xs {
        Nil => None,
        Cons(a, xr) => match ys {
            Nil => None,
            Cons(b, yr) => match a.same(b) { True => Steps::apart(xr, yr), False => a.apart(b) },
        },
    }
}

// ---------------------------------------------------------------------------
// Soundness

theorem Step::same_sound(self a, b: Step, e: a.same(b) = True): a = b {
    (match a as λ x => x.same(b) = True → x = b {
        SField(i) => match b as λ y => SField(i).same(y) = True → SField(i) = y {
            SField(k) => λ h => cong_fn(λ (n: Nat) => SField(n), i.same_sound(k, h)),
            SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SElem(i) => match b as λ y => SElem(i).same(y) = True → SElem(i) = y {
            SElem(k) => λ h => cong_fn(λ (t: Atom) => SElem(t), i.same_sound(k, h)),
            SField(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SWindow(lo, n) => match b as λ y => SWindow(lo, n).same(y) = True → SWindow(lo, n) = y {
            SWindow(lo2, n2) => λ h => {
                let parts = Bool::and_true_parts(lo.same(lo2), n.same(n2), h);
                let e1: (lo = lo2) = lo.same_sound(lo2, parts.left);
                let e2: (n = n2) = n.same_sound(n2, parts.right);
                rewrite(e1, e2, refl)
            },
            SField(_) => λ no => absurd(no), SElem(_) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SKey(i, g) => match b as λ y => SKey(i, g).same(y) = True → SKey(i, g) = y {
            SKey(i2, g2) => λ h => {
                let parts = Bool::and_true_parts(i.same(i2), g.same(g2), h);
                let e1: (i = i2) = i.same_sound(i2, parts.left);
                let e2: (g = g2) = g.same_sound(g2, parts.right);
                rewrite(e1, e2, refl)
            },
            SField(_) => λ no => absurd(no), SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SVariant(c) => match b as λ y => SVariant(c).same(y) = True → SVariant(c) = y {
            SVariant(d) => λ h => cong_fn(λ (n: Nat) => SVariant(n), c.same_sound(d, h)),
            SField(_) => λ no => absurd(no), SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no),
        },
    })(e)
}

theorem Step::same_self(self a: Step): a.same(a) = True {
    match a {
        SField(i) => i.same_self(),
        SElem(i) => i.same_self(),
        SWindow(lo, n) => Bool::and_true_of(lo.same(lo), n.same(n), lo.same_self(), n.same_self()),
        SKey(i, g) => Bool::and_true_of(i.same(i), g.same(g), i.same_self(), g.same_self()),
        SVariant(c) => c.same_self(),
    }
}

// What the first difference answers holds of the two selections.
theorem Step::apart_sound(self a, b: Step, ws: List<Ix>, rs: List<Obligation>, ok: a.apart(b) = Some(rs), hold: Obligation::All(rs, Ix::nats(ws))):
    a.sel(ws).apart(b.sel(ws)).IsTrue()
{
    (match a as λ x => x.apart(b) = Some(rs) → x.sel(ws).apart(b.sel(ws)).IsTrue() {
        SField(i) => match b as λ y => SField(i).apart(y) = Some(rs) → SField(i).sel(ws).apart(y.sel(ws)).IsTrue() {
            SField(k) => λ h => Bool::is_true_of_eq(Bool::then_some(Span(i, 1).apart(Span(k, 1)), Some(Nil<Obligation>), rs, h).left),
            SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SElem(i) => match b as λ y => SElem(i).apart(y) = Some(rs) → SElem(i).sel(ws).apart(y.sel(ws)).IsTrue() {
            SElem(k) => λ h => Atom::spans_hold(i, Lit(1), k, Lit(1), ws, Spans(i, Lit(1), k, Lit(1)).settle_sound(Ix::nats(ws), rs, h, hold)),
            SWindow(lo, n) => λ h => Atom::spans_hold(i, Lit(1), lo, n, ws, Spans(i, Lit(1), lo, n).settle_sound(Ix::nats(ws), rs, h, hold)),
            SField(_) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SWindow(lo, n) => match b as λ y => SWindow(lo, n).apart(y) = Some(rs) → SWindow(lo, n).sel(ws).apart(y.sel(ws)).IsTrue() {
            SElem(k) => λ h => Atom::spans_hold(lo, n, k, Lit(1), ws, Spans(lo, n, k, Lit(1)).settle_sound(Ix::nats(ws), rs, h, hold)),
            SWindow(lo2, n2) => λ h => Atom::spans_hold(lo, n, lo2, n2, ws, Spans(lo, n, lo2, n2).settle_sound(Ix::nats(ws), rs, h, hold)),
            SField(_) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SKey(i, g) => match b as λ y => SKey(i, g).apart(y) = Some(rs) → SKey(i, g).sel(ws).apart(y.sel(ws)).IsTrue() {
            SKey(i2, g2) => λ h => Keys(i, g, i2, g2).settle_sound(Ix::nats(ws), rs, h, hold),
            SField(_) => λ no => absurd(no), SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SVariant(_) => λ no => absurd(no),
        },
        SVariant(c) => match b as λ y => SVariant(c).apart(y) = Some(rs) → SVariant(c).sel(ws).apart(y.sel(ws)).IsTrue() {
            SVariant(d) => λ h => Bool::is_true_of_eq(Bool::then_some(!c.same(d), Some(Nil<Obligation>), rs, h).left),
            SField(_) => λ no => absurd(no), SElem(_) => λ no => absurd(no), SWindow(_, _) => λ no => absurd(no), SKey(_, _) => λ no => absurd(no),
        },
    })(ok)
}

// A modification through `xs` keeps an owner like what it was like at `f`.
fn Steps::Keeps<S>(m: StepModel<S>, ws: List<Ix>, f: Sel, xs: List<Step>) → Type {
    (x, s: S) → m.like(f, x, s) = True → (g: S → S) → m.like(f, x, Steps::over(m, ws, xs, g, s)) = True
}

// Steps after a first step keep it, as the first step's modification does.
theorem Steps::keeps<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, f: Sel, a: Step, rest: List<Step>): Steps::Keeps(m, ws, f, Cons(a, rest)) {
    λ x s h g => ml.keeps(f, a.sel(ws), x, s, h, λ y => Steps::over(m, ws, rest, g, y))
}

// Where the decider answers yes, neither list is empty: both keep it.
theorem Steps::verdict_keeps<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, f: Sel, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → And<Steps::Keeps(m, ws, f, xs), Steps::Keeps(m, ws, f, ys)>
{
    match xs {
        Nil => λ ys rs no => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no => absurd(no),
            Cons(b, yr) => λ rs _ => And(Steps::keeps(m, ml, ws, f, a, xr), Steps::keeps(m, ml, ws, f, b, yr)),
        },
    }
}

// A read under the step after a modification under it that leaves the
// inner read.
theorem ApartAt::under_read<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), a: Sel, {at1: S → S}, {over2: (S → S) → S → S}, inner: (g: S → S) → (s: S) → at1(over2(g, s)) = at1(s),
    k2: (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, over2(g, s)) = True, g: S → S, s: S):
    at1(m.at(a, m.over(a, λ x => over2(g, x), s))) = at1(m.at(a, s))
{
    (match m.fits(a, s) as λ c => m.fits(a, s) = c → at1(m.at(a, m.over(a, λ x => over2(g, x), s))) = at1(m.at(a, s)) {
        True => λ e => {
            let r = m.at(a, s);
            let back: (m.at(a, m.over(a, λ x => over2(g, x), s)) = over2(g, r)) = ml.over_at(a, λ x => over2(g, x), s, e, k2(r, r, ml.like_refl(a, r), g));
            trans(cong_fn(at1, back), inner(g, r))
        },
        False => λ e => cong_fn(λ (t: S) => at1(m.at(a, t)), ml.still(a, λ x => over2(g, x), s, e)),
    })(refl)
}

theorem ApartAt::under_commute<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), a: Sel, {over1, over2: (S → S) → S → S},
    inner: (f, g: S → S) → (s: S) → over1(f, over2(g, s)) = over2(g, over1(f, s)),
    k1: (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, over1(g, s)) = True,
    k2: (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, over2(g, s)) = True, f, g: S → S, s: S):
    m.over(a, λ x => over1(f, x), m.over(a, λ x => over2(g, x), s)) = m.over(a, λ x => over2(g, x), m.over(a, λ x => over1(f, x), s))
{
    (match m.fits(a, s) as λ c => m.fits(a, s) = c →
            m.over(a, λ x => over1(f, x), m.over(a, λ x => over2(g, x), s)) = m.over(a, λ x => over2(g, x), m.over(a, λ x => over1(f, x), s)) {
        True => λ e => {
            let r = m.at(a, s);
            let lg: (m.like(a, r, over2(g, r)) = True) = k2(r, r, ml.like_refl(a, r), g);
            let lf: (m.like(a, r, over1(f, r)) = True) = k1(r, r, ml.like_refl(a, r), f);
            let lfg: (m.like(a, r, over1(f, over2(g, r))) = True) = k1(r, over2(g, r), lg, f);
            let lgf: (m.like(a, r, over2(g, over1(f, r))) = True) = k2(r, over1(f, r), lf, g);
            let left: (m.over(a, λ x => over1(f, x), m.over(a, λ x => over2(g, x), s)) = m.over(a, λ x => over1(f, over2(g, x)), s)) =
                ml.over_over(a, λ x => over2(g, x), λ x => over1(f, x), s, e, lg, lfg);
            let right: (m.over(a, λ x => over2(g, x), m.over(a, λ x => over1(f, x), s)) = m.over(a, λ x => over2(g, over1(f, x)), s)) =
                ml.over_over(a, λ x => over1(f, x), λ x => over2(g, x), s, e, lf, lgf);
            trans(left, trans(ml.over_read(a, λ x => over1(f, over2(g, x)), λ x => over2(g, over1(f, x)), s, inner(f, g, r)), sym(right)))
        },
        False => λ e => {
            let sg: (m.over(a, λ x => over2(g, x), s) = s) = ml.still(a, λ x => over2(g, x), s, e);
            let sf: (m.over(a, λ x => over1(f, x), s) = s) = ml.still(a, λ x => over1(f, x), s, e);
            trans(cong_fn(λ (t: S) => m.over(a, λ x => over1(f, x), t), sg), trans(sf, trans(sym(sg), cong_fn(λ (t: S) => m.over(a, λ x => over2(g, x), t), sym(sf)))))
        },
    })(refl)
}

// Under one step: two places apart inside, each keeping what the step read
// like itself, are apart after it. Where the step does not fit, neither
// modification does anything.
theorem ApartAt::under<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), a: Sel, {at1, at2: S → S}, {over1, over2: (S → S) → S → S}, inner: ApartAt<S>(at1, over1, at2, over2),
    k1: (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, over1(g, s)) = True,
    k2: (x, s: S) → m.like(a, x, s) = True → (g: S → S) → m.like(a, x, over2(g, s)) = True):
    ApartAt<S>(λ s => at1(m.at(a, s)), λ g s => m.over(a, λ x => over1(g, x), s), λ s => at2(m.at(a, s)), λ g s => m.over(a, λ x => over2(g, x), s))
{
    ApartAt(
        λ g s => ApartAt::under_read(m, ml, a, inner.left_after_right, k2, g, s),
        λ g s => ApartAt::under_read(m, ml, a, inner.right_after_left, k1, g, s),
        λ f g s => ApartAt::under_commute(m, ml, a, inner.commute, k1, k2, f, g, s),
    )
}

// After two steps apart, whatever follows each.
theorem ApartAt::then_both<S>(m: StepModel<S>, a, b: Sel, ap: ApartAt<S>(m.at(a), m.over(a), m.at(b), m.over(b)), at1, at2: S → S, over1, over2: (S → S) → S → S):
    ApartAt<S>(λ s => at1(m.at(a, s)), λ g s => m.over(a, λ x => over1(g, x), s), λ s => at2(m.at(b, s)), λ g s => m.over(b, λ x => over2(g, x), s))
{
    ApartAt(
        λ g s => cong_fn(at1, ap.left_after_right(λ x => over2(g, x), s)),
        λ g s => cong_fn(at2, ap.right_after_left(λ x => over1(g, x), s)),
        λ f g s => ap.commute(λ x => over1(f, x), λ x => over2(g, x), s),
    )
}

// The decider is sound: a verdict, and its obligations holding at the
// words, give the two places apart.
theorem Steps::apart_sound<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → Obligation::All(rs, Ix::nats(ws)) → Steps::Apart(m, ws, xs, ys)
{
    match xs {
        Nil => λ ys rs no _ => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no _ => absurd(no),
            Cons(b, yr) => λ rs => (match a.same(b) as λ c => a.same(b) = c → (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = Some(rs) →
                    Obligation::All(rs, Ix::nats(ws)) → Steps::Apart(m, ws, Cons(a, xr), Cons(b, yr)) {
                True => λ e ok hold => {
                    let same: (a = b) = a.same_sound(b, e);
                    let fit = Steps::verdict_keeps(m, ml, ws, a.sel(ws), xr, yr, rs, ok);
                    let here: Steps::Apart(m, ws, Cons(a, xr), Cons(a, yr)) = ApartAt::under(m, ml, a.sel(ws), Steps::apart_sound(m, ml, ws, xr, yr, rs, ok, hold), fit.left, fit.right);
                    j(same, λ c _ => Steps::Apart(m, ws, Cons(a, xr), Cons(c, yr)), here)
                },
                False => λ e ok hold => ApartAt::then_both(m, a.sel(ws), b.sel(ws), ml.apart(a.sel(ws), b.sel(ws), a.apart_sound(b, ws, rs, ok, hold)),
                    λ s => Steps::at(m, ws, xr, s), λ s => Steps::at(m, ws, yr, s), λ g s => Steps::over(m, ws, xr, g, s), λ g s => Steps::over(m, ws, yr, g, s)),
            })(refl)
        },
    }
}

// The fits kept: a modification at one of two places apart keeps whether
// the other fits. Under a step both share, the step's own fit is kept and
// it reads what the inner modification left; after two steps apart, the
// other's step reads what it did.
theorem Steps::fit_under<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, a: Step, yr: List<Step>, over1: (S → S) → S → S,
    inner: (g: S → S) → (s: S) → Steps::fit(m, ws, yr, over1(g, s)) = Steps::fit(m, ws, yr, s),
    k1: (x, s: S) → m.like(a.sel(ws), x, s) = True → (g: S → S) → m.like(a.sel(ws), x, over1(g, s)) = True, g: S → S, s: S):
    Steps::fit(m, ws, Cons(a, yr), m.over(a.sel(ws), λ x => over1(g, x), s)) = Steps::fit(m, ws, Cons(a, yr), s)
{
    (match m.fits(a.sel(ws), s) as λ c => m.fits(a.sel(ws), s) = c →
            Steps::fit(m, ws, Cons(a, yr), m.over(a.sel(ws), λ x => over1(g, x), s)) = Steps::fit(m, ws, Cons(a, yr), s) {
        True => λ on => {
            let ov: (m.at(a.sel(ws), m.over(a.sel(ws), λ x => over1(g, x), s)) = over1(g, m.at(a.sel(ws), s))) =
                ml.over_at(a.sel(ws), λ x => over1(g, x), s, on, k1(m.at(a.sel(ws), s), m.at(a.sel(ws), s), ml.like_refl(a.sel(ws), m.at(a.sel(ws), s)), g));
            let e1: (m.fits(a.sel(ws), m.over(a.sel(ws), λ x => over1(g, x), s)) = m.fits(a.sel(ws), s)) = ml.fits_over(a.sel(ws), a.sel(ws), λ x => over1(g, x), s);
            trans(cong_fn(λ (q: Bool) => q && Steps::fit(m, ws, yr, m.at(a.sel(ws), m.over(a.sel(ws), λ x => over1(g, x), s))), e1),
                cong_fn(λ (t: Bool) => m.fits(a.sel(ws), s) && t, trans(cong_fn(λ (t: S) => Steps::fit(m, ws, yr, t), ov), inner(g, m.at(a.sel(ws), s)))))
        },
        False => λ off => cong_fn(λ (t: S) => Steps::fit(m, ws, Cons(a, yr), t), ml.still(a.sel(ws), λ x => over1(g, x), s, off)),
    })(refl)
}

theorem Steps::fit_then<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, a, b: Step, ap: ApartAt<S>(m.at(a.sel(ws)), m.over(a.sel(ws)), m.at(b.sel(ws)), m.over(b.sel(ws))),
    yr: List<Step>, f: S → S, s: S): Steps::fit(m, ws, Cons(b, yr), m.over(a.sel(ws), f, s)) = Steps::fit(m, ws, Cons(b, yr), s)
{
    let e1: (m.fits(b.sel(ws), m.over(a.sel(ws), f, s)) = m.fits(b.sel(ws), s)) = ml.fits_over(b.sel(ws), a.sel(ws), f, s);
    let e2: (m.at(b.sel(ws), m.over(a.sel(ws), f, s)) = m.at(b.sel(ws), s)) = ap.right_after_left(f, s);
    trans(cong_fn(λ (q: Bool) => q && Steps::fit(m, ws, yr, m.at(b.sel(ws), m.over(a.sel(ws), f, s))), e1),
        cong_fn(λ (t: S) => m.fits(b.sel(ws), s) && Steps::fit(m, ws, yr, t), e2))
}

theorem Steps::apart_fit<S>(m: StepModel<S>, ml: StepModelLaws<S>(m), ws: List<Ix>, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → Obligation::All(rs, Ix::nats(ws)) →
    And<Steps::KeepsFit(m, ws, xs, ys), Steps::KeepsFit(m, ws, ys, xs)>
{
    match xs {
        Nil => λ ys rs no _ => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no _ => absurd(no),
            Cons(b, yr) => λ rs => (match a.same(b) as λ c => a.same(b) = c → (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = Some(rs) →
                    Obligation::All(rs, Ix::nats(ws)) → And<Steps::KeepsFit(m, ws, Cons(a, xr), Cons(b, yr)), Steps::KeepsFit(m, ws, Cons(b, yr), Cons(a, xr))> {
                True => λ e ok hold => {
                    let same: (a = b) = a.same_sound(b, e);
                    let fit = Steps::verdict_keeps(m, ml, ws, a.sel(ws), xr, yr, rs, ok);
                    let ih = Steps::apart_fit(m, ml, ws, xr, yr, rs, ok, hold);
                    let here: And<Steps::KeepsFit(m, ws, Cons(a, xr), Cons(a, yr)), Steps::KeepsFit(m, ws, Cons(a, yr), Cons(a, xr))> = And(
                        λ g s => Steps::fit_under(m, ml, ws, a, yr, λ g2 s2 => Steps::over(m, ws, xr, g2, s2), ih.left, fit.left, g, s),
                        λ g s => Steps::fit_under(m, ml, ws, a, xr, λ g2 s2 => Steps::over(m, ws, yr, g2, s2), ih.right, fit.right, g, s));
                    j(same, λ c _ => And<Steps::KeepsFit(m, ws, Cons(a, xr), Cons(c, yr)), Steps::KeepsFit(m, ws, Cons(c, yr), Cons(a, xr))>, here)
                },
                False => λ e ok hold => {
                    let ap = ml.apart(a.sel(ws), b.sel(ws), a.apart_sound(b, ws, rs, ok, hold));
                    let pa: ApartAt<S>(m.at(b.sel(ws)), m.over(b.sel(ws)), m.at(a.sel(ws)), m.over(a.sel(ws))) =
                        ApartAt(ap.right_after_left, ap.left_after_right, λ f g d => sym(ap.commute(g, f, d)));
                    And(λ g s => Steps::fit_then(m, ml, ws, a, b, ap, yr, λ x => Steps::over(m, ws, xr, g, x), s),
                        λ g s => Steps::fit_then(m, ml, ws, b, a, pa, xr, λ x => Steps::over(m, ws, yr, g, x), s))
                },
            })(refl)
        },
    }
}

// ---------------------------------------------------------------------------
// Completeness

// On closed steps the first difference owes nothing.
theorem Step::apart_closed(self a, b: Step, ca: a.closed() = True, cb: b.closed() = True, rs: List<Obligation>, ok: a.apart(b) = Some(rs)): rs = Nil {
    (match a as λ x => x.closed() = True → x.apart(b) = Some(rs) → rs = Nil {
        SField(i) => λ _ => (match b as λ y => y.closed() = True → SField(i).apart(y) = Some(rs) → rs = Nil {
            SField(k) => λ _ h => sym(Option::some_inj(Nil<Obligation>, rs, Bool::then_some(Span(i, 1).apart(Span(k, 1)), Some(Nil<Obligation>), rs, h).right)),
            SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
        })(cb),
        SElem(i) => λ ci => (match b as λ y => y.closed() = True → SElem(i).apart(y) = Some(rs) → rs = Nil {
            SElem(k) => λ ck h => Spans(i, Lit(1), k, Lit(1)).settle_closed(Atom::closed_all4(i, Lit(1), k, Lit(1), ci, refl, ck, refl), rs, h),
            SWindow(lo, n) => λ cw h => {
                let parts = Bool::and_true_parts(lo.closed(), n.closed(), cw);
                Spans(i, Lit(1), lo, n).settle_closed(Atom::closed_all4(i, Lit(1), lo, n, ci, refl, parts.left, parts.right), rs, h)
            },
            SField(_) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
        })(cb),
        SWindow(lo, n) => λ cw => {
            let pw = Bool::and_true_parts(lo.closed(), n.closed(), cw);
            (match b as λ y => y.closed() = True → SWindow(lo, n).apart(y) = Some(rs) → rs = Nil {
                SElem(k) => λ ck h => Spans(lo, n, k, Lit(1)).settle_closed(Atom::closed_all4(lo, n, k, Lit(1), pw.left, pw.right, ck, refl), rs, h),
                SWindow(lo2, n2) => λ c2 h => {
                    let p2 = Bool::and_true_parts(lo2.closed(), n2.closed(), c2);
                    Spans(lo, n, lo2, n2).settle_closed(Atom::closed_all4(lo, n, lo2, n2, pw.left, pw.right, p2.left, p2.right), rs, h)
                },
                SField(_) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
            })(cb)
        },
        SKey(i, g) => λ ck => {
            let pk = Bool::and_true_parts(i.closed(), g.closed(), ck);
            (match b as λ y => y.closed() = True → SKey(i, g).apart(y) = Some(rs) → rs = Nil {
                SKey(i2, g2) => λ c2 h => {
                    let p2 = Bool::and_true_parts(i2.closed(), g2.closed(), c2);
                    Keys(i, g, i2, g2).settle_closed(Atom::closed_all4(i, g, i2, g2, pk.left, pk.right, p2.left, p2.right), rs, h)
                },
                SField(_) => λ _ no => absurd(no), SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
            })(cb)
        },
        SVariant(c) => λ _ => (match b as λ y => y.closed() = True → SVariant(c).apart(y) = Some(rs) → rs = Nil {
            SVariant(d) => λ _ h => sym(Option::some_inj(Nil<Obligation>, rs, Bool::then_some(!c.same(d), Some(Nil<Obligation>), rs, h).right)),
            SField(_) => λ _ no => absurd(no), SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no),
        })(cb),
    })(ca, ok)
}

// On closed steps the decider never owes: it answers yes or no.
theorem Steps::apart_closed(xs: List<Step>): (ys: List<Step>) → Steps::closed(xs) = True → Steps::closed(ys) = True →
    (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → rs = Nil
{
    match xs {
        Nil => λ ys _ _ rs no => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ _ _ rs no => absurd(no),
            Cons(b, yr) => λ cx cy rs => {
                let px = Bool::and_true_parts(a.closed(), Steps::closed(xr), cx);
                let py = Bool::and_true_parts(b.closed(), Steps::closed(yr), cy);
                (match a.same(b) as λ c => (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = Some(rs) → rs = Nil {
                    True => λ ok => Steps::apart_closed(xr, yr, px.right, py.right, rs, ok),
                    False => λ ok => a.apart_closed(b, px.left, py.left, rs, ok),
                })
            },
        },
    }
}

// Two lists that first differ at `a` and `b` get the answer of that pair.
theorem Steps::apart_at_difference(pre: List<Step>, a, b: Step, xr, yr: List<Step>, differ: a.same(b) = False):
    Steps::apart(pre ++ Cons(a, xr), pre ++ Cons(b, yr)) = a.apart(b)
{
    match pre {
        Nil => j(sym(differ), λ c _ => (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = a.apart(b), refl),
        Cons(c, rest) => j(sym(c.same_self()), λ t _ => (match t { True => Steps::apart(rest ++ Cons(a, xr), rest ++ Cons(b, yr)), False => c.apart(c) }) = a.apart(b),
            Steps::apart_at_difference(rest, a, b, xr, yr, differ)),
    }
}

// Two closed steps whose selections are apart are found apart owing
// nothing, so (by `Steps::apart_at_difference`) are any two closed lists
// first differing there.
theorem Step::apart_complete(self a, b: Step, ca: a.closed() = True, cb: b.closed() = True, verdict: a.sel(Nil).apart(b.sel(Nil)) = True): a.apart(b) = Some(Nil) {
    (match a as λ x => x.closed() = True → x.sel(Nil).apart(b.sel(Nil)) = True → x.apart(b) = Some(Nil) {
        SField(i) => λ _ => (match b as λ y => y.closed() = True → SField(i).sel(Nil).apart(y.sel(Nil)) = True → SField(i).apart(y) = Some(Nil) {
            SField(_) => λ _ v => j(sym(v), λ t _ => t.then(Some(Nil<Obligation>)) = Some(Nil<Obligation>), refl),
            SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
        })(cb),
        SElem(i) => λ ci => (match b as λ y => y.closed() = True → SElem(i).sel(Nil).apart(y.sel(Nil)) = True → SElem(i).apart(y) = Some(Nil) {
            SElem(k) => λ ck v => Spans(i, Lit(1), k, Lit(1)).settle_yes(Atom::closed_all4(i, Lit(1), k, Lit(1), ci, refl, ck, refl), trans(sym(Atom::spans_ix(i, Lit(1), k, Lit(1), Nil)), v)),
            SWindow(lo, n) => λ cw v => {
                let parts = Bool::and_true_parts(lo.closed(), n.closed(), cw);
                Spans(i, Lit(1), lo, n).settle_yes(Atom::closed_all4(i, Lit(1), lo, n, ci, refl, parts.left, parts.right), trans(sym(Atom::spans_ix(i, Lit(1), lo, n, Nil)), v))
            },
            SField(_) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
        })(cb),
        SWindow(lo, n) => λ cw => {
            let pw = Bool::and_true_parts(lo.closed(), n.closed(), cw);
            (match b as λ y => y.closed() = True → SWindow(lo, n).sel(Nil).apart(y.sel(Nil)) = True → SWindow(lo, n).apart(y) = Some(Nil) {
                SElem(k) => λ ck v => Spans(lo, n, k, Lit(1)).settle_yes(Atom::closed_all4(lo, n, k, Lit(1), pw.left, pw.right, ck, refl), trans(sym(Atom::spans_ix(lo, n, k, Lit(1), Nil)), v)),
                SWindow(lo2, n2) => λ c2 v => {
                    let p2 = Bool::and_true_parts(lo2.closed(), n2.closed(), c2);
                    Spans(lo, n, lo2, n2).settle_yes(Atom::closed_all4(lo, n, lo2, n2, pw.left, pw.right, p2.left, p2.right), trans(sym(Atom::spans_ix(lo, n, lo2, n2, Nil)), v))
                },
                SField(_) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
            })(cb)
        },
        SKey(i, g) => λ ck => {
            let pk = Bool::and_true_parts(i.closed(), g.closed(), ck);
            (match b as λ y => y.closed() = True → SKey(i, g).sel(Nil).apart(y.sel(Nil)) = True → SKey(i, g).apart(y) = Some(Nil) {
                SKey(i2, g2) => λ c2 v => {
                    let p2 = Bool::and_true_parts(i2.closed(), g2.closed(), c2);
                    Keys(i, g, i2, g2).settle_yes(Atom::closed_all4(i, g, i2, g2, pk.left, pk.right, p2.left, p2.right), v)
                },
                SField(_) => λ _ no => absurd(no), SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SVariant(_) => λ _ no => absurd(no),
            })(cb)
        },
        SVariant(c) => λ _ => (match b as λ y => y.closed() = True → SVariant(c).sel(Nil).apart(y.sel(Nil)) = True → SVariant(c).apart(y) = Some(Nil) {
            SVariant(_) => λ _ v => j(sym(v), λ t _ => t.then(Some(Nil<Obligation>)) = Some(Nil<Obligation>), refl),
            SField(_) => λ _ no => absurd(no), SElem(_) => λ _ no => absurd(no), SWindow(_, _) => λ _ no => absurd(no), SKey(_, _) => λ _ no => absurd(no),
        })(cb),
    })(ca, verdict)
}

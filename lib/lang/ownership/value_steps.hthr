// Steps over a universe of values: the model `steps.hthr`'s decider is
// sound in, built from the library's paths (docs/language/ownership-design.md
// §15.5, issues/ownership-steps.md).
//
// A `Val` is a word, a sequence, a record, an enum's variant with its
// payload, or a store of values: level 2's cells before layout, where a
// value is one of these and a step that does not fit it reads nothing. The
// sequences, records and stores hold their parts in mutual types (`Vals`,
// `VSlots`) carried to and from `List<Val>` and `Store<Val>`, so each step
// is the library's own path after one lawful step in:
//
// | Step | Path |
// |---|---|
// | `SField(i)` | `Val::rec_path()` then `Path::elem(i)` |
// | `SElem(i)` | `Val::seq_path()` then `Path::elem(i)` |
// | `SWindow(lo, n)` | `Val::seq_path()` then `Path::window(lo, n)` then the vector as a sequence (`Val::vec_path(n)`) |
// | `SKey(k)` | `Val::map_path()` then `Store::key_path(k)` |
// | `SVariant(c)` | `Val::tag_path(c)` |
//
// A window's value is a sequence of its length; a write of any other value
// through it writes nothing, so it is lawful where what is written is a
// sequence of that length (`Val::vec_laws_on`), and every step's write keeps
// a sequence's length (`Val::model_laws().keeps`). Two steps' selections
// apart are `Apart` by `PathIn::apart_sound` under the step in (elements,
// windows, fields), `Store::keys_apart_sound` (keys), and `Val::tags_apart`
// (variants).
//
// The customers, each by evaluating the decider: `split_at_mut`
// (`Val::split_apart`, `Val::split_apart_under`), an element held while
// another is stored (`Val::hold_while_store`, `Val::hold_window_store`), and
// two fields of one record (`Val::fields_apart`, `Val::nested_fields_apart`).
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import vector;
import span_set;
import store;
import path;
import list_path;
import store_path;
import atom;
import steps;

// ---------------------------------------------------------------------------
// The path model this module was built for
//
// `steps.hthr`'s first model, each selection a `Path` lawful where what it
// writes fits (`PathLawsOn`), with its soundness. `steps.hthr` now holds the
// total model of docs/language/ownership-design.md §21.1; this one stays
// only as long as this experiment module does (§21.1: `Val` has no
// customer after it, and its probes are restated at `Dyn`).

record PathModel<S> { path: Sel → Path<S, S>, fits: Sel → S → Bool }

record PathModelLaws<S>(m: PathModel<S>) {
    laws: (a: Sel) → PathLawsOn<S, S>(m.path(a), m.fits(a)),
    keeps: (a, b: Sel) → Path::KeepsFit(m.path(b), m.fits(a)),
    apart: (a, b: Sel) → a.apart(b).IsTrue() → Apart<S, S, S>(m.path(a), m.path(b)),
}

// The steps from the root, the first outermost.
fn PathModel::denote<S>(m: PathModel<S>, ws: List<Nat>, xs: List<Step>) → Path<S, S> {
    match xs { Nil => Path::id<S>(), Cons(a, rest) => m.path(a.sel(ws)).then(PathModel::denote(m, ws, rest)) }
}

// Steps after a first step: their writes keep every fit, as the first
// step's do.
theorem PathModel::keeps_fit<S>(m: PathModel<S>, ml: PathModelLaws<S>(m), ws: List<Nat>, f: Sel, a: Step, rest: List<Step>):
    Path::KeepsFit(PathModel::denote(m, ws, Cons(a, rest)), m.fits(f))
{
    Path::then_keeps_fit(m.path(a.sel(ws)), PathModel::denote(m, ws, rest), m.fits(f), ml.keeps(f, a.sel(ws)))
}

// Where the decider answers yes, neither list is empty: both keep every fit.
theorem PathModel::verdict_keeps<S>(m: PathModel<S>, ml: PathModelLaws<S>(m), ws: List<Nat>, f: Sel, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) →
        And<Path::KeepsFit(PathModel::denote(m, ws, xs), m.fits(f)), Path::KeepsFit(PathModel::denote(m, ws, ys), m.fits(f))>
{
    match xs {
        Nil => λ ys rs no => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no => absurd(no),
            Cons(b, yr) => λ rs _ => And(PathModel::keeps_fit(m, ml, ws, f, a, xr), PathModel::keeps_fit(m, ml, ws, f, b, yr)),
        },
    }
}

// The decider is sound: a verdict, and its obligations holding at the
// words, give the two denotations apart.
theorem PathModel::apart_sound<S>(m: PathModel<S>, ml: PathModelLaws<S>(m), ws: List<Nat>, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → Obligation::All(rs, ws) →
        Apart<S, S, S>(PathModel::denote(m, ws, xs), PathModel::denote(m, ws, ys))
{
    match xs {
        Nil => λ ys rs no _ => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no _ => absurd(no),
            Cons(b, yr) => λ rs => (match a.same(b) as λ c => a.same(b) = c → (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = Some(rs) →
                    Obligation::All(rs, ws) → Apart<S, S, S>(PathModel::denote(m, ws, Cons(a, xr)), PathModel::denote(m, ws, Cons(b, yr))) {
                True => λ e ok hold => {
                    let same: (a = b) = a.same_sound(b, e);
                    let fit = PathModel::verdict_keeps(m, ml, ws, a.sel(ws), xr, yr, rs, ok);
                    let here: Apart<S, S, S>(m.path(a.sel(ws)).then(PathModel::denote(m, ws, xr)), m.path(a.sel(ws)).then(PathModel::denote(m, ws, yr))) =
                        Apart::under_on(m.path(a.sel(ws)), m.fits(a.sel(ws)), ml.laws(a.sel(ws)), PathModel::apart_sound(m, ml, ws, xr, yr, rs, ok, hold), fit.left, fit.right);
                    j(same, λ c _ => Apart<S, S, S>(m.path(a.sel(ws)).then(PathModel::denote(m, ws, xr)), m.path(c.sel(ws)).then(PathModel::denote(m, ws, yr))), here)
                },
                False => λ e ok hold =>
                    Apart::then_both(ml.apart(a.sel(ws), b.sel(ws), a.apart_sound(b, ws, rs, ok, hold)), PathModel::denote(m, ws, xr), PathModel::denote(m, ws, yr)),
            })(refl)
        },
    }
}

// ---------------------------------------------------------------------------
// Values

inductive Val { VWord(n: Nat), VSeq(xs: Vals), VRec(fs: Vals), VTag(c: Nat, v: Val), VMap(slots: VSlots) }
inductive Vals { VNil, VCons(head: Val, tail: Vals) }
inductive VSlots { SlotsEnd, SlotLive(gen: Nat, value: Val, rest: VSlots), SlotFree(gen: Nat, rest: VSlots) }

// ---------------------------------------------------------------------------
// The parts as lists

fn Vals::list(self vs: Vals) → List<Val> { match vs { VNil => Nil, VCons(h, t) => Cons(h, t.list()) } }

fn Vals::of(xs: List<Val>) → Vals { match xs { Nil => VNil, Cons(h, t) => VCons(h, Vals::of(t)) } }

theorem Vals::list_of(xs: List<Val>): Vals::of(xs).list() = xs {
    match xs { Nil => refl, Cons(h, t) => List::cong_cons(h, Vals::list_of(t)) }
}

theorem Vals::of_list(self vs: Vals): Vals::of(vs.list()) = vs {
    match vs { VNil => refl, VCons(h, t) => cong_fn(λ (u: Vals) => VCons(h, u), t.of_list()) }
}

fn VSlots::list(self ss: VSlots) → List<Slot<Val>> {
    match ss { SlotsEnd => Nil, SlotLive(g, v, t) => Cons(Live(g, v), t.list()), SlotFree(g, t) => Cons(Free<Val>(g), t.list()) }
}

fn VSlots::push(h: Slot<Val>, t: VSlots) → VSlots { match h { Live(g, v) => SlotLive(g, v, t), Free(g) => SlotFree(g, t) } }

fn VSlots::of(xs: List<Slot<Val>>) → VSlots { match xs { Nil => SlotsEnd, Cons(h, t) => VSlots::push(h, VSlots::of(t)) } }

theorem VSlots::list_of(xs: List<Slot<Val>>): VSlots::of(xs).list() = xs {
    match xs {
        Nil => refl,
        Cons(h, t) => match h {
            Live(g, v) => List::cong_cons(Live(g, v), VSlots::list_of(t)),
            Free(g) => List::cong_cons(Free<Val>(g), VSlots::list_of(t)),
        },
    }
}

theorem slots_of_list(ss: VSlots): VSlots::of(ss.list()) = ss {
    match ss {
        SlotsEnd => refl,
        SlotLive(g, v, t) => cong_fn(λ (u: VSlots) => SlotLive(g, v, u), slots_of_list(t)),
        SlotFree(g, t) => cong_fn(λ (u: VSlots) => SlotFree(g, u), slots_of_list(t)),
    }
}

// ---------------------------------------------------------------------------
// The steps in: a sequence's, a record's and a store's parts, a variant's
// payload

fn Val::seq_path() → Path<Val, List<Val>> {
    Path<Val, List<Val>>(
        get := λ (v: Val) => match v { VSeq(xs) => Some(xs.list()), _ => None },
        set := λ (v: Val) => λ (l: List<Val>) => match v { VSeq(_) => VSeq(Vals::of(l)), _ => v },
    )
}

fn Val::rec_path() → Path<Val, List<Val>> {
    Path<Val, List<Val>>(
        get := λ (v: Val) => match v { VRec(xs) => Some(xs.list()), _ => None },
        set := λ (v: Val) => λ (l: List<Val>) => match v { VRec(_) => VRec(Vals::of(l)), _ => v },
    )
}

fn Val::map_path() → Path<Val, Store<Val>> {
    Path<Val, Store<Val>>(
        get := λ (v: Val) => match v { VMap(ss) => Some(Store(ss.list())), _ => None },
        set := λ (v: Val) => λ (st: Store<Val>) => match v { VMap(_) => VMap(VSlots::of(st.slots)), _ => v },
    )
}

fn Val::tag_path(c: Nat) → Path<Val, Val> {
    Path<Val, Val>(
        get := λ (v: Val) => match v { VTag(d, x) => d.same(c).then(Some(x)), _ => None },
        set := λ (v: Val) => λ (w: Val) => match v { VTag(d, x) => VTag(d, d.same(c).select(w, x)), _ => v },
    )
}

theorem Val::seq_laws(): PathLaws<Val, List<Val>>(Val::seq_path()) {
    PathLaws(
        λ s a l => match s {
            VSeq(_) => λ _ => cong_fn(λ (ys: List<Val>) => Some(ys), Vals::list_of(l)),
            VWord(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s a => match s {
            VSeq(xs) => λ h => trans(cong_fn(λ (ys: List<Val>) => VSeq(Vals::of(ys)), sym(Option::some_inj(xs.list(), a, h))), cong_fn(λ (u: Vals) => VSeq(u), xs.of_list())),
            VWord(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s v w => match s { VSeq(_) => refl, VWord(_) => refl, VRec(_) => refl, VTag(_, _) => refl, VMap(_) => refl },
        λ s v => match s {
            VSeq(_) => λ no => absurd(no),
            VWord(_) => λ _ => refl, VRec(_) => λ _ => refl, VTag(_, _) => λ _ => refl, VMap(_) => λ _ => refl,
        },
    )
}

theorem Val::rec_laws(): PathLaws<Val, List<Val>>(Val::rec_path()) {
    PathLaws(
        λ s a l => match s {
            VRec(_) => λ _ => cong_fn(λ (ys: List<Val>) => Some(ys), Vals::list_of(l)),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s a => match s {
            VRec(xs) => λ h => trans(cong_fn(λ (ys: List<Val>) => VRec(Vals::of(ys)), sym(Option::some_inj(xs.list(), a, h))), cong_fn(λ (u: Vals) => VRec(u), xs.of_list())),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s v w => match s { VSeq(_) => refl, VWord(_) => refl, VRec(_) => refl, VTag(_, _) => refl, VMap(_) => refl },
        λ s v => match s {
            VRec(_) => λ no => absurd(no),
            VWord(_) => λ _ => refl, VSeq(_) => λ _ => refl, VTag(_, _) => λ _ => refl, VMap(_) => λ _ => refl,
        },
    )
}

theorem Val::map_laws(): PathLaws<Val, Store<Val>>(Val::map_path()) {
    PathLaws(
        λ s a st => match s {
            VMap(_) => λ _ => cong_fn(λ (ys: List<Slot<Val>>) => Some(Store(ys)), VSlots::list_of(st.slots)),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no),
        },
        λ s a => match s {
            VMap(ss) => λ h => trans(cong_fn(λ (st: Store<Val>) => VMap(VSlots::of(st.slots)), sym(Option::some_inj(Store(ss.list()), a, h))),
                cong_fn(λ (u: VSlots) => VMap(u), slots_of_list(ss))),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no),
        },
        λ s v w => match s { VSeq(_) => refl, VWord(_) => refl, VRec(_) => refl, VTag(_, _) => refl, VMap(_) => refl },
        λ s v => match s {
            VMap(_) => λ no => absurd(no),
            VWord(_) => λ _ => refl, VSeq(_) => λ _ => refl, VRec(_) => λ _ => refl, VTag(_, _) => λ _ => refl,
        },
    )
}

// The variant's laws, at what `d.same(c)` answered.
theorem Val::tag_set_get(b: Bool, x, a, w: Val, h: b.then(Some(x)) = Some(a)): b.then(Some(b.select(w, x))) = Some(w) {
    (match b as λ t => t.then(Some(x)) = Some(a) → t.then(Some(t.select(w, x))) = Some(w) { True => λ _ => refl, False => λ no => absurd(no) })(h)
}

theorem Val::tag_get_set(b: Bool, x, a: Val, h: b.then(Some(x)) = Some(a)): b.select(a, x) = x {
    (match b as λ t => t.then(Some(x)) = Some(a) → t.select(a, x) = x { True => λ e => sym(Option::some_inj(x, a, e)), False => λ _ => refl })(h)
}

theorem Val::tag_set_set(b: Bool, x, v, w: Val): b.select(w, b.select(v, x)) = b.select(w, x) { match b { True => refl, False => refl } }

theorem Val::tag_set_none(b: Bool, x, w: Val, h: b.then(Some(x)) = None): b.select(w, x) = x {
    (match b as λ t => t.then(Some(x)) = None → t.select(w, x) = x { True => λ no => absurd(no), False => λ _ => refl })(h)
}

theorem Val::tag_laws(c: Nat): PathLaws<Val, Val>(Val::tag_path(c)) {
    PathLaws(
        λ s a w => match s {
            VTag(d, x) => λ h => Val::tag_set_get(d.same(c), x, a, w, h),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s a => match s {
            VTag(d, x) => λ h => cong_fn(λ (y: Val) => VTag(d, y), Val::tag_get_set(d.same(c), x, a, h)),
            VWord(_) => λ no => absurd(no), VSeq(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
        },
        λ s v w => match s {
            VTag(d, x) => cong_fn(λ (y: Val) => VTag(d, y), Val::tag_set_set(d.same(c), x, v, w)),
            VSeq(_) => refl, VWord(_) => refl, VRec(_) => refl, VMap(_) => refl,
        },
        λ s w => match s {
            VTag(d, x) => λ h => cong_fn(λ (y: Val) => VTag(d, y), Val::tag_set_none(d.same(c), x, w, h)),
            VWord(_) => λ _ => refl, VSeq(_) => λ _ => refl, VRec(_) => λ _ => refl, VMap(_) => λ _ => refl,
        },
    )
}

// ---------------------------------------------------------------------------
// A window's value: the vector as a sequence of its length

// `w` is a sequence of `n` values.
fn Val::fits_seq(self w: Val, n: Nat) → Bool { match w { VSeq(ys) => ys.list().len().same(n), _ => False } }

fn Val::entries(self w: Val) → List<Val> { match w { VSeq(ys) => ys.list(), _ => Nil } }

// The write: a sequence of the window's length is written, anything else
// writes nothing.
fn Val::vec_put(n: Nat, v: [Val; n], w: Val) → [Val; n] { match w.fits_seq(n) { True => w.entries().vector_of(n, VWord(0)), False => v } }

fn Val::vec_path(n: Nat) → Path<[Val; n], Val> {
    Path<[Val; n], Val>(get := λ (v: [Val; n]) => Some(VSeq(Vals::of(vector_entries(v)))), set := λ (v: [Val; n]) => λ (w: Val) => Val::vec_put(n, v, w))
}

theorem Val::fits_parts(self w: Val, n: Nat): w.fits_seq(n) = True → And<w.entries().len() = n, VSeq(Vals::of(w.entries())) = w> {
    match w {
        VSeq(ys) => λ h => And(ys.list().len().same_sound(n, h), cong_fn(λ (u: Vals) => VSeq(u), ys.of_list())),
        VWord(_) => λ no => absurd(no), VRec(_) => λ no => absurd(no), VTag(_, _) => λ no => absurd(no), VMap(_) => λ no => absurd(no),
    }
}

theorem Val::vec_put_fits(n: Nat, v: [Val; n], w: Val, f: w.fits_seq(n) = True): Val::vec_put(n, v, w) = w.entries().vector_of(n, VWord(0)) {
    j(sym(f), λ b _ => (match b { True => w.entries().vector_of(n, VWord(0)), False => v }) = w.entries().vector_of(n, VWord(0)), refl)
}

// What the window reads is a sequence of its length.
theorem Val::vec_read_fits(n: Nat, v: [Val; n]): VSeq(Vals::of(vector_entries(v))).fits_seq(n) = True {
    trans(cong_fn(λ (ys: List<Val>) => ys.len().same(n), Vals::list_of(vector_entries(v))),
        trans(cong_fn(λ (k: Nat) => k.same(n), vector_entries_len(n, v)), n.same_self()))
}

theorem Val::vec_laws_on(n: Nat): PathLawsOn<[Val; n], Val>(Val::vec_path(n), λ (w: Val) => w.fits_seq(n)) {
    PathLawsOn(
        λ v a w h f => {
            let parts = w.fits_parts(n, f);
            let back: (vector_entries(w.entries().vector_of(n, VWord(0))) = w.entries()) = List::entries_vector_of(n, VWord(0), w.entries(), parts.left);
            trans(cong_fn(λ (u: [Val; n]) => Some(VSeq(Vals::of(vector_entries(u)))), Val::vec_put_fits(n, v, w, f)),
                trans(cong_fn(λ (ys: List<Val>) => Some(VSeq(Vals::of(ys))), back), cong_fn(λ (x: Val) => Some(x), parts.right)))
        },
        λ v a h => {
            let a0 = VSeq(Vals::of(vector_entries(v)));
            let same: (a0 = a) = Option::some_inj(a0, a, h);
            let f0: (a0.fits_seq(n) = True) = Val::vec_read_fits(n, v);
            let put: (Val::vec_put(n, v, a0) = v) =
                trans(Val::vec_put_fits(n, v, a0, f0),
                    trans(cong_fn(λ (ys: List<Val>) => ys.vector_of(n, VWord(0)), Vals::list_of(vector_entries(v))), vector_of_entries_exact(n, VWord(0), v)));
            j(same, λ x _ => Val::vec_put(n, v, x) = v, put)
        },
        λ v w1 w2 f1 f2 => trans(Val::vec_put_fits(n, Val::vec_put(n, v, w1), w2, f2), sym(Val::vec_put_fits(n, v, w2, f2))),
        λ v w no => absurd(no),
        λ v a h => j(Option::some_inj(VSeq(Vals::of(vector_entries(v))), a, h), λ x _ => x.fits_seq(n) = True, Val::vec_read_fits(n, v)),
    )
}

// ---------------------------------------------------------------------------
// Two variants apart

theorem Val::same_false_symm(c, d: Nat, cd: c.same(d) = False): d.same(c) = False {
    (match d.same(c) as λ t => d.same(c) = t → t = False {
        True => λ h => false_elim(c.ne_of_same(d, cd)(sym(d.same_sound(c, h)))),
        False => λ _ => refl,
    })(refl)
}

// A value of variant `e` is not of both `c` and `d`.
theorem Val::tags_exclusive(c, d, e: Nat, cd: c.same(d) = False, ec: e.same(c) = True): e.same(d) = False {
    j(sym(e.same_sound(c, ec)), λ t _ => t.same(d) = False, cd)
}

theorem Val::tag_read_other(bc, bd: Bool, ne: bc = True → bd = False, x, v: Val): bc.then(Some(bd.select(v, x))) = bc.then(Some(x)) {
    (match bc as λ t => (t = True → bd = False) → t.then(Some(bd.select(v, x))) = t.then(Some(x)) {
        True => λ n => j(sym(n(refl)), λ t _ => Some(t.select(v, x)) = Some(x), refl),
        False => λ _ => refl,
    })(ne)
}

theorem Val::tag_commute(bc, bd: Bool, ne: bc = True → bd = False, x, a, b: Val): bc.select(a, bd.select(b, x)) = bd.select(b, bc.select(a, x)) {
    (match bc as λ t => (t = True → bd = False) → t.select(a, bd.select(b, x)) = bd.select(b, t.select(a, x)) {
        True => λ n => j(sym(n(refl)), λ t _ => a = t.select(b, a), refl),
        False => λ _ => refl,
    })(ne)
}

theorem Val::not_true_false(b: Bool, h: (!b).IsTrue()): b = False { (match b as λ t => (!t).IsTrue() → t = False { True => λ no => false_elim(no), False => λ _ => refl })(h) }

theorem Val::tags_apart(c, d: Nat, verdict: (!c.same(d)).IsTrue()): Apart<Val, Val, Val>(Val::tag_path(c), Val::tag_path(d)) {
    let cd: (c.same(d) = False) = Val::not_true_false(c.same(d), verdict);
    let dc: (d.same(c) = False) = Val::same_false_symm(c, d, cd);
    Apart(
        λ s v => match s {
            VTag(e, x) => Val::tag_read_other(e.same(c), e.same(d), λ ec => Val::tags_exclusive(c, d, e, cd, ec), x, v),
            VWord(_) => refl, VSeq(_) => refl, VRec(_) => refl, VMap(_) => refl,
        },
        λ s v => match s {
            VTag(e, x) => Val::tag_read_other(e.same(d), e.same(c), λ ed => Val::tags_exclusive(d, c, e, dc, ed), x, v),
            VWord(_) => refl, VSeq(_) => refl, VRec(_) => refl, VMap(_) => refl,
        },
        λ s a b => match s {
            VTag(e, x) => cong_fn(λ (y: Val) => VTag(e, y), Val::tag_commute(e.same(c), e.same(d), λ ec => Val::tags_exclusive(c, d, e, cd, ec), x, a, b)),
            VWord(_) => refl, VSeq(_) => refl, VRec(_) => refl, VMap(_) => refl,
        },
    )
}

// ---------------------------------------------------------------------------
// The model

// An element or a window of a sequence's parts.
fn Val::seq_step(a: SeqSel) → Path<List<Val>, Val> {
    match a { SeqOne(i) => Path::elem<Val>(i), SeqRun(lo, n) => Path::window<Val>(lo, n).then(Val::vec_path(n)) }
}

theorem Val::seq_step_in(a: SeqSel): PathIn<Val, Val>(Val::seq_step(a), a.span()) {
    match a { SeqOne(i) => Path::elem_in<Val>(i), SeqRun(lo, n) => Path::window_in<Val>(lo, n).then(Val::vec_path(n)) }
}

fn Val::sel_path(a: Sel) → Path<Val, Val> {
    match a {
        OnField(i) => Val::rec_path().then(Path::elem<Val>(i)),
        OnSeq(x) => Val::seq_path().then(Val::seq_step(x)),
        OnKey(k) => Val::map_path().then(Store::key_path<Val>(k)),
        OnVariant(c) => Val::tag_path(c),
    }
}

fn Val::step_fits(x: SeqSel) → Val → Bool { match x { SeqOne(_) => λ (_: Val) => True, SeqRun(_, n) => λ (w: Val) => w.fits_seq(n) } }

fn Val::sel_fits(a: Sel) → Val → Bool { match a { OnSeq(x) => Val::step_fits(x), _ => λ (_: Val) => True } }

fn Val::model() → PathModel<Val> { PathModel<Val>(Val::sel_path, Val::sel_fits) }

theorem Val::seq_step_laws(x: SeqSel): PathLawsOn<List<Val>, Val>(Val::seq_step(x), Val::step_fits(x)) {
    match x {
        SeqOne(i) => Path::elem_laws<Val>(i).on(),
        SeqRun(lo, n) => Path::window<Val>(lo, n).then_laws_on(Val::vec_path(n), λ (w: Val) => w.fits_seq(n), Path::window_laws<Val>(lo, n), Val::vec_laws_on(n)),
    }
}

theorem Val::sel_laws(a: Sel): PathLawsOn<Val, Val>(Val::sel_path(a), Val::sel_fits(a)) {
    match a {
        OnField(i) => Val::rec_path().then_laws(Path::elem<Val>(i), Val::rec_laws(), Path::elem_laws<Val>(i)).on(),
        OnSeq(x) => Val::seq_path().then_laws_on(Val::seq_step(x), Val::step_fits(x), Val::seq_laws(), Val::seq_step_laws(x)),
        OnKey(k) => Val::map_path().then_laws(Store::key_path<Val>(k), Val::map_laws(), Store::key_laws<Val>(k)).on(),
        OnVariant(c) => Val::tag_laws(c).on(),
    }
}

// A write through any step keeps a sequence's length.
theorem Val::sel_keeps_len(b: Sel, ys: Vals, v: Val, n: Nat, f: VSeq(ys).fits_seq(n) = True): Val::sel_path(b).set(VSeq(ys), v).fits_seq(n) = True {
    match b {
        OnField(_) => f,
        OnSeq(x) => {
            let l = Val::seq_step(x).set(ys.list(), v);
            trans(cong_fn(λ (zs: List<Val>) => zs.len().same(n), Vals::list_of(l)),
                trans(cong_fn(λ (k: Nat) => k.same(n), Val::seq_step_in(x).shape(ys.list(), v)), f))
        },
        OnKey(_) => f,
        OnVariant(_) => f,
    }
}

theorem Val::keeps(a, b: Sel): Path::KeepsFit(Val::sel_path(b), Val::sel_fits(a)) {
    match a {
        OnSeq(x) => match x {
            SeqOne(_) => Path::keeps_fit_true(Val::sel_path(b)),
            SeqRun(_, n) => λ s => match s {
                VSeq(ys) => λ fs v => Val::sel_keeps_len(b, ys, v, n, fs),
                VWord(_) => λ no v => absurd(no), VRec(_) => λ no v => absurd(no), VTag(_, _) => λ no v => absurd(no), VMap(_) => λ no v => absurd(no),
            },
        },
        OnField(_) => Path::keeps_fit_true(Val::sel_path(b)),
        OnKey(_) => Path::keeps_fit_true(Val::sel_path(b)),
        OnVariant(_) => Path::keeps_fit_true(Val::sel_path(b)),
    }
}

// Two selections apart are apart: by their spans under the step into a
// record's or a sequence's parts, by their keys under the step into a
// store, by their variants.
theorem Val::sel_apart(a, b: Sel): a.apart(b).IsTrue() → Apart<Val, Val, Val>(Val::sel_path(a), Val::sel_path(b)) {
    match a {
        OnField(i) => match b {
            OnField(j) => λ v => Apart::under(Val::rec_path(), Val::rec_laws(), PathIn::apart_sound(Path::elem_in<Val>(i), Path::elem_in<Val>(j), v)),
            OnSeq(_) => λ no => false_elim(no), OnKey(_) => λ no => false_elim(no), OnVariant(_) => λ no => false_elim(no),
        },
        OnSeq(x) => match b {
            OnSeq(y) => λ v => Apart::under(Val::seq_path(), Val::seq_laws(), PathIn::apart_sound(Val::seq_step_in(x), Val::seq_step_in(y), v)),
            OnField(_) => λ no => false_elim(no), OnKey(_) => λ no => false_elim(no), OnVariant(_) => λ no => false_elim(no),
        },
        OnKey(k) => match b {
            OnKey(l) => λ v => Apart::under(Val::map_path(), Val::map_laws(), Store::keys_apart_sound<Val>(k, l, v)),
            OnField(_) => λ no => false_elim(no), OnSeq(_) => λ no => false_elim(no), OnVariant(_) => λ no => false_elim(no),
        },
        OnVariant(c) => match b {
            OnVariant(d) => λ v => Val::tags_apart(c, d, v),
            OnField(_) => λ no => false_elim(no), OnSeq(_) => λ no => false_elim(no), OnKey(_) => λ no => false_elim(no),
        },
    }
}

theorem Val::model_laws(): PathModelLaws<Val>(Val::model()) { PathModelLaws(Val::sel_laws, Val::keeps, Val::sel_apart) }

// A place's path in the universe, at the words.
fn Val::place(ws: List<Nat>, xs: List<Step>) → Path<Val, Val> { PathModel::denote(Val::model(), ws, xs) }

// The decider's verdict, its obligations holding, gives the two places
// apart.
theorem Val::apart(ws: List<Nat>, xs, ys: List<Step>, rs: List<Obligation>, ok: Steps::apart(xs, ys) = Some(rs), hold: Obligation::All(rs, ws)):
    Apart<Val, Val, Val>(Val::place(ws, xs), Val::place(ws, ys))
{
    PathModel::apart_sound(Val::model(), Val::model_laws(), ws, xs, ys, rs, ok, hold)
}

// ---------------------------------------------------------------------------
// split_at_mut: `xs[0..k]` and `xs[k..k+m]`, the words `k` and `m`

fn Val::split_left() → List<Step> { [SWindow(Lit(0), Var(0))] }

fn Val::split_right() → List<Step> { [SWindow(Var(0), Var(1))] }

// The decider owes one fact about the words: the spans `[0, k)` and
// `[k, k + m)` are apart.
theorem Val::split_verdict(): Steps::apart(Val::split_left(), Val::split_right()) = Some([Spans(Lit(0), Var(0), Var(0), Var(1))]) { refl }

theorem Val::split_apart(k, m: Nat): Apart<Val, Val, Val>(Val::place([k, m], Val::split_left()), Val::place([k, m], Val::split_right())) {
    let owed: Span(0, k).apart(Span(k, m)).IsTrue() = omega;
    Val::apart([k, m], Val::split_left(), Val::split_right(), [Spans(Lit(0), Var(0), Var(0), Var(1))], Val::split_verdict(), And(owed, trivial))
}

// The same split of a sequence held in field 2 of a record: the decider
// walks the common field and owes the same fact.
theorem Val::split_apart_under(k, m: Nat):
    Apart<Val, Val, Val>(Val::place([k, m], [SField(2), SWindow(Lit(0), Var(0))]), Val::place([k, m], [SField(2), SWindow(Var(0), Var(1))]))
{
    let owed: Span(0, k).apart(Span(k, m)).IsTrue() = omega;
    Val::apart([k, m], [SField(2), SWindow(Lit(0), Var(0))], [SField(2), SWindow(Var(0), Var(1))], [Spans(Lit(0), Var(0), Var(0), Var(1))], refl, And(owed, trivial))
}

// At literal bounds nothing is owed.
theorem Val::split_closed(): Steps::apart([SWindow(Lit(0), Lit(4))], [SWindow(Lit(4), Lit(4))]) = Some(Nil) { refl }

// ---------------------------------------------------------------------------
// Holding element `i` while storing element `j`

theorem Val::elems_apart(i, j: Nat, ne: ¬(i = j)): Apart<Val, Val, Val>(Val::place([i, j], [SElem(Var(0))]), Val::place([i, j], [SElem(Var(1))])) {
    let owed: Span(i, 1).apart(Span(j, 1)).IsTrue() = omega(ne);
    Val::apart([i, j], [SElem(Var(0))], [SElem(Var(1))], [Spans(Var(0), Lit(1), Var(1), Lit(1))], refl, And(owed, trivial))
}

// What element `i` read is still read after a store to element `j ≠ i`.
theorem Val::hold_while_store(i, j: Nat, ne: ¬(i = j), s, v: Val):
    Val::place([i, j], [SElem(Var(0))]).Keeps(s, Val::place([i, j], [SElem(Var(1))]).set(s, v))
{
    Val::elems_apart(i, j, ne).keeps(s, v)
}

// §15.3's example: a view of `xs[0..8]` permits `xs[9] := v`, decided with
// nothing owed.
theorem Val::hold_window_verdict(): Steps::apart([SWindow(Lit(0), Lit(8))], [SElem(Lit(9))]) = Some(Nil) { refl }

theorem Val::hold_window_store(s, v: Val): Val::place(Nil, [SWindow(Lit(0), Lit(8))]).Keeps(s, Val::place(Nil, [SElem(Lit(9))]).set(s, v)) {
    Val::apart(Nil, [SWindow(Lit(0), Lit(8))], [SElem(Lit(9))], Nil, Val::hold_window_verdict(), trivial).keeps(s, v)
}

// ---------------------------------------------------------------------------
// Two fields of one record

theorem Val::fields_verdict(): Steps::apart([SField(0)], [SField(1)]) = Some(Nil) { refl }

theorem Val::fields_apart(): Apart<Val, Val, Val>(Val::place(Nil, [SField(0)]), Val::place(Nil, [SField(1)])) {
    Val::apart(Nil, [SField(0)], [SField(1)], Nil, Val::fields_verdict(), trivial)
}

// Two fields of the record in field 2, and the element of a sequence in
// one beside the other.
theorem Val::nested_fields_apart(i: Nat):
    Apart<Val, Val, Val>(Val::place([i], [SField(2), SField(0), SElem(Var(0))]), Val::place([i], [SField(2), SField(1)]))
{
    Val::apart([i], [SField(2), SField(0), SElem(Var(0))], [SField(2), SField(1)], Nil, refl, trivial)
}

// The payloads of two variants: never valid together, so apart.
theorem Val::variants_apart(): Apart<Val, Val, Val>(Val::place(Nil, [SVariant(0), SField(0)]), Val::place(Nil, [SVariant(1), SField(0)])) {
    Val::apart(Nil, [SVariant(0), SField(0)], [SVariant(1), SField(0)], Nil, refl, trivial)
}

// Two keys into one store, the words its index and generation: apart where
// the keys differ.
theorem Val::keys_apart(i1, g1, i2, g2: Nat, ne: !(i1.same(i2) && g1.same(g2)) = True):
    Apart<Val, Val, Val>(Val::place([i1, g1, i2, g2], [SKey(Var(0), Var(1))]), Val::place([i1, g1, i2, g2], [SKey(Var(2), Var(3))]))
{
    Val::apart([i1, g1, i2, g2], [SKey(Var(0), Var(1))], [SKey(Var(2), Var(3))], [Keys(Var(0), Var(1), Var(2), Var(3))], refl, And(Bool::is_true_of_eq(ne), trivial))
}

// `check_sound`, being built (docs/language/ownership-design.md §15.4,
// §21.4, §23; issues/ownership-checker.md item 3): the run agrees with the
// meaning wherever the checker's verdict holds. Ownership is the licence for
// the run to share; no separation algebra is used.
//
// This module holds, so far:
//
// - **Selections composed**: a read, a write and a fit along an appended
//   path (`Sel::read_append`, `Sel::write_append`, `Sel::fit_append`), and a
//   place's steps as selections at the words (`Steps::read_sels`,
//   `Steps::write_sels`).
// - **Levels**: the state's levels name the environments' slots
//   (`CSt::lvl_var`, `CSt::lvl_below`), and a push keeps every earlier level
//   (`CSt::var_push`, `CSt::lvl_push_loc`).
// - **The invariant's first part** (`Sim`): each variable's run-time cell
//   agrees with the meaning's value as the checker's role says (a plain
//   variable holds the value; a holder or a view reads it through the heap,
//   its block live, its selections fitting), with `Sim::push`, the one lemma
//   every binding statement uses.
// - **Reads**: what reads a value at no selections reads its selections
//   further on where they fit (`Value::get_more`), and a place whose codes
//   have parts and whose accessors' residuals hold fits
//   (`Place::fit_from`, from `pre_inside`: `Dyn::fits_of_pre`).
// - **A read's verdict** (`ReadInv`, `CSt::read_inv`): what the checker's
//   read of a place found, split into its parts once.
// - **Stages** (`Stepped`): one lemma per statement kind, from a state the
//   invariant holds of to the next (`Stmt::stage_lit`, `Stmt::stage_op`,
//   `Stmt::stage_read`).
// - **Words**: an atom the checker reads at plain levels reads one index in
//   the run and in the meaning (`Sim::atom_ix`), and so a place's steps make
//   one list of selections in both (`Sim::steps_same`); and so the run reads
//   a place the checker read at the meaning's value (`Sim::place`), the
//   `Read` stage (`Stmt::stage_read`).
// - **The invariant** (`Inv`), its clauses explained where it is stated, and
//   the facts its entry needs (`Slot`, `Value::get_of_read`).
import logic;
import bool;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import level2;
import run;
import verdict;
import checker;
import linux_world;

// ---------------------------------------------------------------------------
// Selections: reads and writes along a path, composed

theorem Sel::read_append(tys: Nat → Type, strs: Strs(tys), xs: List<Sel>): (ys: List<Sel>) → (d: Dyn(tys)) →
    Sel::read_at(tys, strs, xs ++ ys, d) = Sel::read_at(tys, strs, ys, Sel::read_at(tys, strs, xs, d))
{
    match xs { Nil => λ ys d => refl, Cons(a, rest) => λ ys d => Sel::read_append(tys, strs, rest, ys, (Dyn::model(tys, strs)).at(a, d)) }
}

theorem Sel::fit_append(tys: Nat → Type, strs: Strs(tys), xs: List<Sel>): (ys: List<Sel>) → (d: Dyn(tys)) →
    Sel::fit(tys, strs, xs ++ ys, d) = (Sel::fit(tys, strs, xs, d) && Sel::fit(tys, strs, ys, Sel::read_at(tys, strs, xs, d)))
{
    match xs {
        Nil => λ ys d => refl,
        Cons(a, rest) => λ ys d => {
            let ih = Sel::fit_append(tys, strs, rest, ys, Dyn::at(tys, strs, a, d));
            match Dyn::fits(tys, strs, a, d) {
                True => ih,
                False => refl,
            }
        },
    }
}

// A modification through a step by two pointwise equal functions is one
// (no funext: by the part's own `set`).
theorem Dyn::over_read_ext(tys: Nat → Type, strs: Strs(tys), a: Sel, g, h: Dyn(tys) → Dyn(tys), e: (x: Dyn(tys)) → g(x) = h(x), d: Dyn(tys)): Dyn::over(tys, strs, a, g, d) = Dyn::over(tys, strs, a, h, d) {
    cong_fn(λ (u: El(tys, d.code)) => Dyn(d.code, u), Dyn::in_over_read(tys, Dyn::part(tys, strs, a, d.code), g, h, d.val, e(Dyn::at_in(tys, Dyn::part(tys, strs, a, d.code), d.val))))
}

// The steps' fold is the selections' fold at the words.
theorem Steps::read_sels(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs: List<Step>): (d: Dyn(tys)) →
    Dyn::read(tys, strs, ws, xs, d) = Sel::read_at(tys, strs, Steps::sels(xs, ws), d)
{
    match xs { Nil => λ d => refl, Cons(a, rest) => λ d => Steps::read_sels(tys, strs, ws, rest, Dyn::at(tys, strs, a.sel(ws), d)) }
}

theorem Steps::write_sels(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs: List<Step>, g: Dyn(tys) → Dyn(tys)): (d: Dyn(tys)) →
    Dyn::write(tys, strs, ws, xs, g, d) = Sel::write_at(tys, strs, Steps::sels(xs, ws), g, d)
{
    match xs {
        Nil => λ d => refl,
        Cons(a, rest) => λ d => Dyn::over_read_ext(tys, strs, a.sel(ws), λ x => Dyn::write(tys, strs, ws, rest, g, x), λ x => Sel::write_at(tys, strs, Steps::sels(rest, ws), g, x),
            λ x => Steps::write_sels(tys, strs, ws, rest, g, x), d),
    }
}

theorem Sel::write_append(tys: Nat → Type, strs: Strs(tys), xs: List<Sel>): (ys: List<Sel>) → (g: Dyn(tys) → Dyn(tys)) → (d: Dyn(tys)) →
    Sel::write_at(tys, strs, xs ++ ys, g, d) = Sel::write_at(tys, strs, xs, λ x => Sel::write_at(tys, strs, ys, g, x), d)
{
    match xs {
        Nil => λ ys g d => refl,
        Cons(a, rest) => λ ys g d => Dyn::over_read_ext(tys, strs, a, λ x => Sel::write_at(tys, strs, rest ++ ys, g, x), λ x => Sel::write_at(tys, strs, rest, λ y => Sel::write_at(tys, strs, ys, g, y), x),
            λ x => Sel::write_append(tys, strs, rest, ys, g, x), d),
    }
}

// ---------------------------------------------------------------------------
// Levels and variables: the state's levels name the environments' slots

theorem Bool::false_of_not(b: Bool, h: ¬(b = True)): b = False { (match b as λ c => ¬(c = True) → c = False { True => λ no => false_elim(no(refl)), False => λ _ => refl })(h) }

// A level's variable at a state: an argument below the arguments' count, a
// local newest first above it.
fn CSt::var_at(self s: CSt, l: Nat) → Var { match (l + 1).leb(s.na) { True => Arg(l), False => Loc(s.na + s.nd - 1 - l) } }

theorem CSt::lvl_var(self s: CSt, x: Var, l: Nat, e: s.lvl(x) = Some(l)): s.var_at(l) = x {
    (match x as λ y => s.lvl(y) = Some(l) → s.var_at(l) = y {
        Arg(i) => λ h => {
            let p = Bool::then_some((i + 1).leb(s.na), Some(i), l, h);
            let eq: (i = l) = Option::some_inj(i, l, p.right);
            j(eq, λ k _ => (match (k + 1).leb(s.na) { True => Arg(k), False => Loc(s.na + s.nd - 1 - k) }) = Arg(i), j(sym(p.left), λ c _ => (match c { True => Arg(i), False => Loc(s.na + s.nd - 1 - i) }) = Arg(i), refl))
        },
        Loc(k) => λ h => {
            let p = Bool::then_some((k + 1).leb(s.nd), Some(s.na + s.nd - 1 - k), l, h);
            let eq: (s.na + s.nd - 1 - k = l) = Option::some_inj(s.na + s.nd - 1 - k, l, p.right);
            let below: (k + 1 <= s.nd) = omega(p.left);
            let notarg: ((l + 1).leb(s.na) = False) = Bool::false_of_not((l + 1).leb(s.na), λ t => omega(t, eq, below));
            let back: (s.na + s.nd - 1 - l = k) = omega(eq, below);
            j(sym(notarg), λ c _ => (match c { True => Arg(l), False => Loc(s.na + s.nd - 1 - l) }) = Loc(k), cong_fn(λ (n: Nat) => Loc(n), back))
        },
    })(e)
}

// A push leaves every earlier level's variable in place: an argument as it
// was, a local one deeper.
theorem CSt::var_push(self s: CSt, c: CVar, l: Nat, below: l < s.na + s.nd): (s.push(c)).var(l) = s.var(l) {
    match (l + 1).leb(s.na) {
        True => refl,
        False => {
            let k: (s.na + (s.nd + 1) - 1 - l = Succ(s.na + s.nd - 1 - l)) = omega(below);
            j(sym(k), λ t _ => (Cons(c, s.locs)).nth(t).unwrap_or(CVar::none()) = (Cons(c, s.locs)).nth(Succ(s.na + s.nd - 1 - l)).unwrap_or(CVar::none()), refl)
        },
    }
}

// The pushed variable is at the next level.
theorem CSt::var_pushed(self s: CSt, c: CVar): (s.push(c)).var(s.na + s.nd) = c {
    let notarg: ((s.na + s.nd + 1).leb(s.na) = False) = Bool::false_of_not((s.na + s.nd + 1).leb(s.na), λ t => omega(t));
    let k: (s.na + (s.nd + 1) - 1 - (s.na + s.nd) = 0) = omega();
    j(sym(notarg), λ b _ => (match b { True => (s.args).nth(s.na + s.nd).unwrap_or(CVar::none()), False => (Cons(c, s.locs)).nth(s.na + (s.nd + 1) - 1 - (s.na + s.nd)).unwrap_or(CVar::none()) }) = c,
        j(sym(k), λ t _ => (Cons(c, s.locs)).nth(t).unwrap_or(CVar::none()) = c, refl))
}

// ---------------------------------------------------------------------------
// The invariant (first part): each variable's cell agrees with the meaning

// A run-time value reads as a meaning's value: through the heap, its block
// live, its selections fitting.
fn Value::Reads(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), v: Value(tys), d: Dyn(tys)) → Type { Value::get(tys, strs, h, v, Nil) = Some(d) }

// The run's cell and the meaning's value at one variable, as the checker's
// role says: a plain variable holds the meaning's value itself; a holder or
// a view reads it; a gone variable owes nothing.
fn Cell::Agrees(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Role, c: Cell(tys), d: Dyn(tys)) → Type {
    match r { KPlain => c.v = Plain(d), KGone => True, KHold(_, _) => Value::Reads(tys, strs, h, c.v, d), KView => Value::Reads(tys, strs, h, c.v, d) }
}

record Sim(tys: Nat → Type, strs: Strs(tys), s: CSt, e: Env(tys), m: Mach(tys)) {
    eargs: e.args.len() = s.na,
    margs: (m.env).args.len() = s.na,
    elocs: e.locs.len() = s.nd,
    mlocs: (m.env).locs.len() = s.nd,
    vars: (x: Var) → (l: Nat) → s.lvl(x) = Some(l) → Cell::Agrees(tys, strs, m.heap, s.role(l), REnv::get(tys, m.env, x), Env::get(tys, e, x)),
    codes: (x: Var) → (l: Nat) → s.lvl(x) = Some(l) → (Env::get(tys, e, x)).code = (s.var(l)).code,
}

theorem CSt::lvl_below(self s: CSt, x: Var, l: Nat, h: s.lvl(x) = Some(l)): l < s.na + s.nd {
    (match x as λ y => s.lvl(y) = Some(l) → l < s.na + s.nd {
        Arg(i) => λ h2 => {
            let p = Bool::then_some((i + 1).leb(s.na), Some(i), l, h2);
            let eq: (i = l) = Option::some_inj(i, l, p.right);
            omega(p.left, eq)
        },
        Loc(k) => λ h2 => {
            let p = Bool::then_some((k + 1).leb(s.nd), Some(s.na + s.nd - 1 - k), l, h2);
            let eq: (s.na + s.nd - 1 - k = l) = Option::some_inj(s.na + s.nd - 1 - k, l, p.right);
            omega(p.left, eq)
        },
    })(h)
}

// After a push, a local one deeper is at the level it had.
theorem CSt::lvl_push_loc(self s: CSt, c: CVar, k: Nat): (s.push(c)).lvl(Loc(k + 1)) = s.lvl(Loc(k)) {
    let e: (s.na + (s.nd + 1) - 1 - (k + 1) = s.na + s.nd - 1 - k) = omega();
    j(sym(e), λ t _ => (k + 1 + 1).leb(s.nd + 1).then(Some(t)) = (k + 1).leb(s.nd).then(Some(s.na + s.nd - 1 - k)), refl)
}

theorem CSt::role_push(self s: CSt, c: CVar, l: Nat, below: l < s.na + s.nd): (s.push(c)).role(l) = s.role(l) { cong_fn(λ (v: CVar) => v.role, s.var_push(c, l, below)) }

// A binding: the new variable's cell agrees with its value, and every other
// is as it was.
theorem Sim::push(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), cv: CVar, c: Cell(tys), d: Dyn(tys),
    ok: Cell::Agrees(tys, strs, m.heap, cv.role, c, d), okc: d.code = cv.code): Sim(tys, strs, s.push(cv), Env::push(tys, e, d), Mach::push(tys, m, c))
{
    Sim(sim.eargs, sim.margs, cong_fn(λ (n: Nat) => Succ(n), sim.elocs), cong_fn(λ (n: Nat) => Succ(n), sim.mlocs),
        λ x => match x {
            Arg(i) => λ l h => {
                let below: (l < s.na + s.nd) = s.lvl_below(Arg(i), l, h);
                j(sym(s.role_push(cv, l, below)), λ r _ => Cell::Agrees(tys, strs, m.heap, r, REnv::get(tys, m.env, Arg(i)), Env::get(tys, e, Arg(i))), sim.vars(Arg(i), l, h))
            },
            Loc(k) => match k {
                Zero => λ l h => {
                    let raw: (s.na + (s.nd + 1) - 1 - 0 = l) = Option::some_inj(s.na + (s.nd + 1) - 1 - 0, l, Bool::then_some((0 + 1).leb(s.nd + 1), Some(s.na + (s.nd + 1) - 1 - 0), l, h).right);
                    let at: (l = s.na + s.nd) = omega(raw);
                    j(sym(at), λ t _ => Cell::Agrees(tys, strs, m.heap, (s.push(cv)).role(t), c, d), j(sym(cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv))), λ r _ => Cell::Agrees(tys, strs, m.heap, r, c, d), ok))
                },
                Succ(k1) => λ l h => {
                    let h0: (s.lvl(Loc(k1)) = Some(l)) = trans(sym(s.lvl_push_loc(cv, k1)), h);
                    let below: (l < s.na + s.nd) = s.lvl_below(Loc(k1), l, h0);
                    j(sym(s.role_push(cv, l, below)), λ r _ => Cell::Agrees(tys, strs, m.heap, r, REnv::get(tys, m.env, Loc(k1)), Env::get(tys, e, Loc(k1))), sim.vars(Loc(k1), l, h0))
                },
            },
        },
        λ x => match x {
            Arg(i) => λ l h => {
                let below: (l < s.na + s.nd) = s.lvl_below(Arg(i), l, h);
                trans(sim.codes(Arg(i), l, h), cong_fn(λ (v: CVar) => v.code, sym(s.var_push(cv, l, below))))
            },
            Loc(k) => match k {
                Zero => λ l h => {
                    let raw: (s.na + (s.nd + 1) - 1 - 0 = l) = Option::some_inj(s.na + (s.nd + 1) - 1 - 0, l, Bool::then_some((0 + 1).leb(s.nd + 1), Some(s.na + (s.nd + 1) - 1 - 0), l, h).right);
                    let at: (l = s.na + s.nd) = omega(raw);
                    j(sym(at), λ t _ => d.code = ((s.push(cv)).var(t)).code, trans(okc, cong_fn(λ (v: CVar) => v.code, sym(s.var_pushed(cv)))))
                },
                Succ(k1) => λ l h => {
                    let h0: (s.lvl(Loc(k1)) = Some(l)) = trans(sym(s.lvl_push_loc(cv, k1)), h);
                    let below: (l < s.na + s.nd) = s.lvl_below(Loc(k1), l, h0);
                    trans(sim.codes(Loc(k1), l, h0), cong_fn(λ (v: CVar) => v.code, sym(s.var_push(cv, l, below))))
                },
            },
        })
}

// ---------------------------------------------------------------------------
// Reads through the heap

theorem Bool::and_parts(a, b: Bool, h: (a && b) = True): (a = True) ∧ (b = True) {
    (match a as λ c => (c && b) = True → (c = True) ∧ (b = True) { True => λ e => ⟨refl, e⟩, False => λ no => absurd(no) })(h)
}

theorem Bool::and_of(a, b: Bool, ha: a = True, hb: b = True): (a && b) = True { j(sym(ha), λ c _ => (c && b) = True, hb) }

// A selection path that fits reads; `Sel::get` is the read.
theorem Sel::get_fit(tys: Nat → Type, strs: Strs(tys), ss: List<Sel>, d: Dyn(tys), f: Sel::fit(tys, strs, ss, d) = True): Sel::get(tys, strs, ss, d) = Some(Sel::read_at(tys, strs, ss, d)) {
    j(sym(f), λ c _ => (match c { True => Some(Sel::read_at(tys, strs, ss, d)), False => None<Dyn(tys)>() }) = Some(Sel::read_at(tys, strs, ss, d)), refl)
}

theorem Sel::get_parts(tys: Nat → Type, strs: Strs(tys), ss: List<Sel>, d, r: Dyn(tys), g: Sel::get(tys, strs, ss, d) = Some(r)):
    (Sel::fit(tys, strs, ss, d) = True) ∧ (Sel::read_at(tys, strs, ss, d) = r)
{
    (match Sel::fit(tys, strs, ss, d) as λ c => Sel::fit(tys, strs, ss, d) = c → (match c { True => Some(Sel::read_at(tys, strs, ss, d)), False => None<Dyn(tys)>() }) = Some(r) →
            (Sel::fit(tys, strs, ss, d) = True) ∧ (Sel::read_at(tys, strs, ss, d) = r) {
        True => λ e h => ⟨e, Option::some_inj(Sel::read_at(tys, strs, ss, d), r, h)⟩,
        False => λ _ no => absurd(no),
    })(refl, g)
}

// What reads `d` at no selections reads `d`'s selections further on, where
// they fit.
theorem Value::get_more(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), v: Value(tys), d: Dyn(tys), ok: Value::get(tys, strs, h, v, Nil) = Some(d), ss: List<Sel>,
    f: Sel::fit(tys, strs, ss, d) = True): Value::get(tys, strs, h, v, ss) = Some(Sel::read_at(tys, strs, ss, d))
{
    (match v as λ u => Value::get(tys, strs, h, u, Nil) = Some(d) → Value::get(tys, strs, h, u, ss) = Some(Sel::read_at(tys, strs, ss, d)) {
        Plain(x) => λ g => {
            let eq: (x = d) = Option::some_inj(x, d, g);
            j(sym(eq), λ y _ => Sel::get(tys, strs, ss, y) = Some(Sel::read_at(tys, strs, ss, d)), Sel::get_fit(tys, strs, ss, d, f))
        },
        Refer(r) => match Heap::val(tys, strs, h, r.b) as λ o => (match o { Some(b) => Sel::get(tys, strs, r.sels ++ Nil, b), None => None<Dyn(tys)>() }) = Some(d) →
                (match o { Some(b) => Sel::get(tys, strs, r.sels ++ ss, b), None => None<Dyn(tys)>() }) = Some(Sel::read_at(tys, strs, ss, d)) {
            None => λ no => absurd(no),
            Some(b) => λ g => {
                let pre = Sel::get_parts(tys, strs, r.sels ++ Nil, b, d, g);
                let nil: (r.sels ++ Nil = r.sels) = List::append_nil(r.sels);
                let fit0: (Sel::fit(tys, strs, r.sels, b) = True) = j(nil, λ t _ => Sel::fit(tys, strs, t, b) = True, pre.left);
                let read0: (Sel::read_at(tys, strs, r.sels, b) = d) = j(nil, λ t _ => Sel::read_at(tys, strs, t, b) = d, pre.right);
                let fit1: (Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, r.sels, b)) = True) = j(sym(read0), λ t _ => Sel::fit(tys, strs, ss, t) = True, f);
                let fitall: (Sel::fit(tys, strs, r.sels ++ ss, b) = True) = trans(Sel::fit_append(tys, strs, r.sels, ss, b), Bool::and_of(Sel::fit(tys, strs, r.sels, b), Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, r.sels, b)), fit0, fit1));
                let readall: (Sel::read_at(tys, strs, r.sels ++ ss, b) = Sel::read_at(tys, strs, ss, d)) =
                    trans(Sel::read_append(tys, strs, r.sels, ss, b), cong_fn(λ (t: Dyn(tys)) => Sel::read_at(tys, strs, ss, t), read0));
                trans(Sel::get_fit(tys, strs, r.sels ++ ss, b, fitall), cong_fn(λ (t: Dyn(tys)) => Some(t), readall))
            },
        },
    })(ok)
}

// ---------------------------------------------------------------------------
// Codes along a place

// The code a part has, where it has one.
fn Dyn::part_code(tys: Nat → Type, strs: Strs(tys), sel: Sel, c: Shape) → Option<Shape> { Dyn::part(tys, strs, sel, c).map(λ pt => pt.t) }

fn SeqSel::is_run(self a: SeqSel) → Bool { match a { SeqOne(_) => False, SeqRun(_, _) => True } }

// A step's part code does not read its indices: the checker's `a.sel(Nil)`
// and the run's `a.sel(ws)` find the same.
theorem Seq::part_code_any(tys: Nat → Type, k: Nat, q: Seq(tys, tys(k)), a, b: SeqSel, same: a.is_run() = b.is_run()):
    (Seq::part(tys, SNamed(k), q, a)).map(λ pt => pt.t) = (Seq::part(tys, SNamed(k), q, b)).map(λ pt => pt.t)
{
    (match a as λ x => x.is_run() = b.is_run() → (Seq::part(tys, SNamed(k), q, x)).map(λ pt => pt.t) = (Seq::part(tys, SNamed(k), q, b)).map(λ pt => pt.t) {
        SeqOne(_) => match b { SeqOne(_) => λ _ => refl, SeqRun(_, _) => λ no => absurd(no) },
        SeqRun(_, _) => match b {
            SeqRun(_, _) => λ _ => match q.win {
                Some(_) => refl,
                None => refl,
            },
            SeqOne(_) => λ no => absurd(no),
        },
    })(same)
}

theorem Step::part_code(tys: Nat → Type, strs: Strs(tys), a: Step, ws, vs: List<Ix>, c: Shape): Dyn::part_code(tys, strs, a.sel(ws), c) = Dyn::part_code(tys, strs, a.sel(vs), c) {
    match c {
        SWord(_) => refl,
        SNamed(k) => match strs(k).kind {
            Opaque => refl,
            Record(_) => match a { SField(_) => refl, SElem(_) => refl, SWindow(_, _) => refl, SKey(_, _) => refl, SVariant(_) => refl },
            Sequence(q) => match a {
                SElem(i) => Seq::part_code_any(tys, k, q, SeqOne(i.ix(ws)), SeqOne(i.ix(vs)), refl),
                SWindow(lo, n) => Seq::part_code_any(tys, k, q, SeqRun(lo.ix(ws), n.ix(ws)), SeqRun(lo.ix(vs), n.ix(vs)), refl),
                SField(_) => refl, SKey(_, _) => refl, SVariant(_) => refl,
            },
        },
    }
}

// What a sequence's accessor asks gives the run's fit, by `pre_inside`; a
// field always fits.
fn Kind::Pre(tys: Nat → Type, k: Nat, kd: Kind(tys, tys(k)), sel: Sel, v: tys(k)) → Type {
    match kd {
        Sequence(q) => match sel as λ _ => Type {
            OnSeq(a) => match a { SeqOne(i) => q.Pre(v, i), SeqRun(lo, n) => match q.win { Some(w) => w.Pre(v, lo, n), None => True } },
            OnField(_) => True, OnKey(_) => True, OnVariant(_) => True,
        },
        Opaque => True,
        Record(_) => True,
    }
}

theorem Kind::fits_of_pre(tys: Nat → Type, strs: Strs(tys), k: Nat, sel: Sel, t: Shape): (kd: Kind(tys, tys(k))) → KindLaws(tys, strs, kd) → (v: tys(k)) →
    (Kind::part(tys, k, kd, sel)).map(λ pt => pt.t) = Some(t) → Kind::Pre(tys, k, kd, sel, v) → Dyn::fits_in(tys, Kind::part(tys, k, kd, sel), v) = True
{
    λ kd => match kd {
        Opaque => λ _ v no _ => absurd(no),
        Record(fs) => λ _ v => match sel {
            OnField(i) => match fs.nth(i) as λ o => (match o { Some(f) => Some(Field::part(tys, f)), None => None<Part(tys, SNamed(k))>() }).map(λ pt => pt.t) = Some(t) → True →
                    Dyn::fits_in(tys, match o { Some(f) => Some(Field::part(tys, f)), None => None<Part(tys, SNamed(k))>() }, v) = True {
                Some(_) => λ _ _ => refl,
                None => λ no _ => absurd(no),
            },
            OnSeq(_) => λ no _ => absurd(no), OnKey(_) => λ no _ => absurd(no), OnVariant(_) => λ no _ => absurd(no),
        },
        Sequence(q) => λ ql v => match sel {
            OnSeq(a) => match a {
                SeqOne(i) => λ _ pre => ql.left.pre_inside(v, i, pre),
                SeqRun(lo, n) => (match q.win as λ ow => (match ow as λ _ => Type { Some(w) => WinLaws(tys, tys(k), q, w), None => True }) →
                        (match ow { Some(w) => Some(Seq::win_part(tys, w, lo, n)), None => None<Part(tys, SNamed(k))>() }).map(λ pt => pt.t) = Some(t) →
                        (match ow as λ _ => Type { Some(w) => w.Pre(v, lo, n), None => True }) →
                        Dyn::fits_in(tys, match ow { Some(w) => Some(Seq::win_part(tys, w, lo, n)), None => None<Part(tys, SNamed(k))>() }, v) = True {
                    Some(_) => λ wl _ pre => wl.pre_inside(v, lo, n, pre),
                    None => λ _ no _ => absurd(no),
                })(ql.right.left),
            },
            OnField(_) => λ no _ => absurd(no), OnKey(_) => λ no _ => absurd(no), OnVariant(_) => λ no _ => absurd(no),
        },
    }
}

theorem Dyn::fits_of_pre(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), sel: Sel, d: Dyn(tys), t: Shape, has: Dyn::part_code(tys, strs, sel, d.code) = Some(t),
    pre: Dyn::pre(tys, strs, sel, d)): Dyn::fits(tys, strs, sel, d) = True
{
    (match d.code as λ c => (v: El(tys, c)) → Dyn::part_code(tys, strs, sel, c) = Some(t) → Dyn::pre(tys, strs, sel, Dyn(c, v)) → Dyn::fits(tys, strs, sel, Dyn(c, v)) = True {
        SWord(_) => λ v no _ => absurd(no),
        SNamed(k) => λ v h p => Kind::fits_of_pre(tys, strs, k, sel, t, strs(k).kind, sl(k), v, h, p),
    })(d.val, has, pre)
}

theorem Steps::init_snoc(pre: List<Step>, a: Step): Steps::init(pre ++ [a]) = pre {
    match pre {
        Nil => refl,
        Cons(b, rest) => (match rest as λ r => r = rest → Steps::init(Cons(b, r) ++ [a]) = Cons(b, r) {
            Nil => λ _ => refl,
            Cons(_, _) => λ e => cong_fn(λ (t: List<Step>) => Cons(b, t), j(sym(e), λ r _ => Steps::init(r ++ [a]) = r, Steps::init_snoc(rest, a))),
        })(refl),
    }
}

theorem Steps::last_snoc(pre: List<Step>, a: Step): Steps::last(pre ++ [a]) = Some(a) {
    match pre {
        Nil => refl,
        Cons(b, rest) => (match rest as λ r => r = rest → Steps::last(Cons(b, r) ++ [a]) = Some(a) {
            Nil => λ _ => refl,
            Cons(_, _) => λ e => j(sym(e), λ r _ => Steps::last(r ++ [a]) = Some(a), Steps::last_snoc(rest, a)),
        })(refl),
    }
}

theorem Dyn::read_snoc(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, pre: List<Step>, a: Step): (d: Dyn(tys)) →
    Dyn::read(tys, strs, ws, pre ++ [a], d) = Dyn::at(tys, strs, a.sel(ws), Dyn::read(tys, strs, ws, pre, d))
{
    match pre { Nil => λ d => refl, Cons(b, rest) => λ d => Dyn::read_snoc(tys, strs, ws, rest, a, Dyn::at(tys, strs, b.sel(ws), d)) }
}

theorem Dyn::at_code(tys: Nat → Type, strs: Strs(tys), sel: Sel, d: Dyn(tys), t: Shape, has: Dyn::part_code(tys, strs, sel, d.code) = Some(t)): (Dyn::at(tys, strs, sel, d)).code = t {
    (match Dyn::part(tys, strs, sel, d.code) as λ o => o.map(λ pt => pt.t) = Some(t) → (Dyn::at_in(tys, o, d.val)).code = t {
        Some(pt) => λ h => Option::some_inj(pt.t, t, h),
        None => λ no => absurd(no),
    })(has)
}

// A field asks nothing.
theorem Dyn::pre_field(tys: Nat → Type, strs: Strs(tys), i: Nat, d: Dyn(tys)): Dyn::pre(tys, strs, OnField(i), d) {
    (match d.code as λ c => (v: El(tys, c)) → Dyn::pre(tys, strs, OnField(i), Dyn(c, v)) {
        SWord(_) => λ _ => trivial,
        SNamed(k) => λ v => match strs(k).kind { Sequence(_) => trivial, Opaque => trivial, Record(_) => trivial },
    })(d.val)
}

// The accessor's residual at a prefix ending in `a` is its precondition at
// the value before `a`.
theorem Residual::access_at(tys: Nat → Type, cx: Ctx(tys), env: Env(tys), r: Var, pre: List<Step>, a: Step, h: (RAccess(Place(r, pre ++ [a]))).Holds(tys, cx, env)):
    Dyn::pre(tys, cx.strs, a.sel(Env::ixs(tys, env)), (Place(r, pre)).val(tys, cx.strs, env))
{
    let h1: (match Steps::last(pre ++ [a]) as λ _ => Type { Some(b) => Dyn::pre(tys, cx.strs, b.sel(Env::ixs(tys, env)), (Place(r, Steps::init(pre ++ [a]))).val(tys, cx.strs, env)), None => True }) = h;
    let h2 = j(Steps::last_snoc(pre, a), λ o _ => match o as λ _ => Type { Some(b) => Dyn::pre(tys, cx.strs, b.sel(Env::ixs(tys, env)), (Place(r, Steps::init(pre ++ [a]))).val(tys, cx.strs, env)), None => True }, h1);
    j(Steps::init_snoc(pre, a), λ q _ => Dyn::pre(tys, cx.strs, a.sel(Env::ixs(tys, env)), (Place(r, q)).val(tys, cx.strs, env)), h2)
}

// The residuals along a place: the first step's, where it accesses, and
// the rest's.
theorem Place::res_split(tys: Nat → Type, cx: Ctx(tys), env: Env(tys), r: Var, pre: List<Step>, a: Step, rest: List<Step>,
    res: Residual::All(Steps::access_from(r, pre, Cons(a, rest)), tys, cx, env, True)):
    ((a.accesses() = True) → (RAccess(Place(r, pre ++ [a]))).Holds(tys, cx, env)) ∧ Residual::All(Steps::access_from(r, pre ++ [a], rest), tys, cx, env, True)
{
    (match a.accesses() as λ b => a.accesses() = b →
            Residual::All(match b { True => Cons(RAccess(Place(r, pre ++ [a])), Steps::access_from(r, pre ++ [a], rest)), False => Steps::access_from(r, pre ++ [a], rest) }, tys, cx, env, True) →
            ((a.accesses() = True) → (RAccess(Place(r, pre ++ [a]))).Holds(tys, cx, env)) ∧ Residual::All(Steps::access_from(r, pre ++ [a], rest), tys, cx, env, True) {
        True => λ _ h => ⟨λ _ => h.left, h.right⟩,
        False => λ e h => ⟨λ t => absurd(trans(sym(e), t)), h⟩,
    })(refl, res)
}

// A key or a variant has no part at any code.
theorem Dyn::no_key_part(tys: Nat → Type, strs: Strs(tys), sel: Sel, c: Shape, t: Shape, kv: (match sel { OnKey(_) => True, OnVariant(_) => True, OnField(_) => False, OnSeq(_) => False }) = True,
    has: Dyn::part_code(tys, strs, sel, c) = Some(t)): False
{
    (match c as λ c2 => Dyn::part_code(tys, strs, sel, c2) = Some(t) → False {
        SWord(_) => λ no => absurd(no),
        SNamed(k) => match strs(k).kind {
            Opaque => λ no => absurd(no),
            Record(_) => (match sel as λ s2 => (match s2 { OnKey(_) => True, OnVariant(_) => True, OnField(_) => False, OnSeq(_) => False }) = True → (Kind::part(tys, k, Record(_), s2)).map(λ pt => pt.t) = Some(t) → False {
                OnKey(_) => λ _ no => absurd(no), OnVariant(_) => λ _ no => absurd(no), OnField(_) => λ no _ => absurd(no), OnSeq(_) => λ no _ => absurd(no),
            })(kv),
            Sequence(q) => (match sel as λ s2 => (match s2 { OnKey(_) => True, OnVariant(_) => True, OnField(_) => False, OnSeq(_) => False }) = True → (Kind::part(tys, k, Sequence(q), s2)).map(λ pt => pt.t) = Some(t) → False {
                OnKey(_) => λ _ no => absurd(no), OnVariant(_) => λ _ no => absurd(no), OnField(_) => λ no _ => absurd(no), OnSeq(_) => λ no _ => absurd(no),
            })(kv),
        },
    })(has)
}

// The first step of a place fits: a field by its part, an element or a
// window by its residual.
theorem Place::first_fits(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), env: Env(tys), r: Var, pre: List<Step>, a: Step, t: Shape,
    has: Dyn::part_code(tys, cx.strs, a.sel(Env::ixs(tys, env)), ((Place(r, pre)).val(tys, cx.strs, env)).code) = Some(t),
    acc: (a.accesses() = True) → (RAccess(Place(r, pre ++ [a]))).Holds(tys, cx, env)):
    Dyn::fits(tys, cx.strs, a.sel(Env::ixs(tys, env)), (Place(r, pre)).val(tys, cx.strs, env)) = True
{
    let d = (Place(r, pre)).val(tys, cx.strs, env);
    let ws = Env::ixs(tys, env);
    (match a as λ b => Dyn::part_code(tys, cx.strs, b.sel(ws), d.code) = Some(t) → ((b.accesses() = True) → (RAccess(Place(r, pre ++ [b]))).Holds(tys, cx, env)) →
            Dyn::fits(tys, cx.strs, b.sel(ws), d) = True {
        SField(i) => λ h _ => Dyn::fits_of_pre(tys, cx.strs, sl, OnField(i), d, t, h, Dyn::pre_field(tys, cx.strs, i, d)),
        SElem(i) => λ h ac => Dyn::fits_of_pre(tys, cx.strs, sl, (SElem(i)).sel(ws), d, t, h, Residual::access_at(tys, cx, env, r, pre, SElem(i), ac(refl))),
        SWindow(lo, n) => λ h ac => Dyn::fits_of_pre(tys, cx.strs, sl, (SWindow(lo, n)).sel(ws), d, t, h, Residual::access_at(tys, cx, env, r, pre, SWindow(lo, n), ac(refl))),
        SKey(i, g) => λ h _ => false_elim(Dyn::no_key_part(tys, cx.strs, (SKey(i, g)).sel(ws), d.code, t, refl, h)),
        SVariant(v) => λ h _ => false_elim(Dyn::no_key_part(tys, cx.strs, OnVariant(v), d.code, t, refl, h)),
    })(has, acc)
}

// A place whose codes have parts and whose accessors' residuals hold fits,
// from the value at `pre` on.
theorem Place::fit_from(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), env: Env(tys), r: Var, xs: List<Step>): (pre: List<Step>) → (c, c2: Shape) →
    ((Place(r, pre)).val(tys, cx.strs, env)).code = c → Shape::steps_ok(tys, cx.strs, xs, c) = Some(c2) → Residual::All(Steps::access_from(r, pre, xs), tys, cx, env, True) →
    Sel::fit(tys, cx.strs, Steps::sels(xs, Env::ixs(tys, env)), (Place(r, pre)).val(tys, cx.strs, env)) = True
{
    match xs {
        Nil => λ pre c c2 _ _ _ => refl,
        Cons(a, rest) => λ pre c c2 ec ok res => {
            let ws = Env::ixs(tys, env);
            let d = (Place(r, pre)).val(tys, cx.strs, env);
            let sp = Option::and_then_some(Shape::step_ok(tys, cx.strs, a, c), λ c1 => Shape::steps_ok(tys, cx.strs, rest, c1), c2, ok);
            let c1 = sp.witness;
            let has0: (Dyn::part_code(tys, cx.strs, a.sel(Nil), c) = Some(c1)) = sp.proof.left;
            let has1: (Dyn::part_code(tys, cx.strs, a.sel(ws), c) = Some(c1)) = trans(Step::part_code(tys, cx.strs, a, ws, Nil, c), has0);
            let has: (Dyn::part_code(tys, cx.strs, a.sel(ws), d.code) = Some(c1)) = j(sym(ec), λ q _ => Dyn::part_code(tys, cx.strs, a.sel(ws), q) = Some(c1), has1);
            let rs = Place::res_split(tys, cx, env, r, pre, a, rest, res);
            let here: (Dyn::fits(tys, cx.strs, a.sel(ws), d) = True) = Place::first_fits(tys, cx, sl, env, r, pre, a, c1, has, rs.left);
            let next: ((Place(r, pre ++ [a])).val(tys, cx.strs, env) = Dyn::at(tys, cx.strs, a.sel(ws), d)) = Dyn::read_snoc(tys, cx.strs, ws, pre, a, Env::get(tys, env, r));
            let ncode: (((Place(r, pre ++ [a])).val(tys, cx.strs, env)).code = c1) = trans(cong_fn(λ (x: Dyn(tys)) => x.code, next), Dyn::at_code(tys, cx.strs, a.sel(ws), d, c1, has));
            let ih = Place::fit_from(tys, cx, sl, env, r, rest, pre ++ [a], c1, c2, ncode, sp.proof.right, rs.right);
            let ih2: (Sel::fit(tys, cx.strs, Steps::sels(rest, ws), Dyn::at(tys, cx.strs, a.sel(ws), d)) = True) = j(next, λ x _ => Sel::fit(tys, cx.strs, Steps::sels(rest, ws), x) = True, ih);
            Bool::and_of(Dyn::fits(tys, cx.strs, a.sel(ws), d), Sel::fit(tys, cx.strs, Steps::sels(rest, ws), Dyn::at(tys, cx.strs, a.sel(ws), d)), here, ih2)
        },
    }
}

// ---------------------------------------------------------------------------
// What the checker's read of a place gives

record ReadInv(tys: Nat → Type, strs: Strs(tys), s: CSt, p: Place, g: Got) {
    lvl: s.lvl(p.root) = Some(g.root),
    steps: s.steps(p.steps) = Some(g.at),
    code: Shape::steps_ok(tys, strs, p.steps, (s.var(g.root)).code) = Some(g.code),
    live: ¬((s.role(g.root)).same(KGone) = True),
    ra: List<Residual>,
    rl: List<Residual>,
    atoms: s.atoms_ok(Steps::lvls(g.at)) = Some(ra),
    rs: g.rs = ra ++ rl ++ p.accesses(),
    rat: s.read_at(g.root, g.at) = Some(rl),
}

theorem Role::not_gone_of_read(s: CSt, l: Nat, xs: List<Step>, rs: List<Residual>, h: s.read_at(l, xs) = Some(rs)): ¬((s.role(l)).same(KGone) = True) {
    (match s.role(l) as λ r => (match r { KGone => None<List<Residual>>(), _ => s.license(s.views, Reading, l, s.places(l, xs)) }) = Some(rs) → ¬(r.same(KGone) = True) {
        KGone => λ no => absurd(no),
        KPlain => λ _ no => absurd(no),
        KHold(_, _) => λ _ no => absurd(no),
        KView => λ _ no => absurd(no),
    })(h)
}

theorem CSt::read_inv_close(s: CSt, tys: Nat → Type, strs: Strs(tys), p: Place, g: Got, l: Nat, xs: List<Step>, c: Shape, ra: List<Residual>,
    hl: s.lvl(p.root) = Some(l), hs: s.steps(p.steps) = Some(xs), hc: Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code) = Some(c), ha: s.atoms_ok(Steps::lvls(xs)) = Some(ra),
    hm: (s.read_at(l, xs)).map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses())) = Some(g)): ReadInv(tys, strs, s, p, g)
{
    (match s.read_at(l, xs) as λ o => s.read_at(l, xs) = o → o.map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses())) = Some(g) → ReadInv(tys, strs, s, p, g) {
        None => λ _ no => absurd(no),
        Some(rl) => λ e h => {
            let eg: (Got(c, xs, l, ra ++ rl ++ p.accesses()) = g) = Option::some_inj(Got(c, xs, l, ra ++ rl ++ p.accesses()), g, h);
            j(eg, λ q _ => ReadInv(tys, strs, s, p, q), ReadInv(hl, hs, hc, Role::not_gone_of_read(s, l, xs, rl, e), ra, rl, ha, refl, e))
        },
    })(refl, hm)
}

theorem CSt::read_inv(self s: CSt, tys: Nat → Type, strs: Strs(tys), p: Place, g: Got, ok: s.read(tys, strs, p) = Some(g)): ReadInv(tys, strs, s, p, g) {
    let a1 = Option::and_then_some(s.lvl(p.root), λ l => s.steps(p.steps).and_then(λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c =>
        s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.read_at(l, xs).map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses()))))), g, ok);
    let l = a1.witness;
    let a2 = Option::and_then_some(s.steps(p.steps), λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c =>
        s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.read_at(l, xs).map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses())))), g, a1.proof.right);
    let xs = a2.witness;
    let a3 = Option::and_then_some(Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code), λ c =>
        s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.read_at(l, xs).map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses()))), g, a2.proof.right);
    let c = a3.witness;
    let a4 = Option::and_then_some(s.atoms_ok(Steps::lvls(xs)), λ ra => s.read_at(l, xs).map(λ rl => Got(c, xs, l, ra ++ rl ++ p.accesses())), g, a3.proof.right);
    let ra = a4.witness;
    CSt::read_inv_close(s, tys, strs, p, g, l, xs, c, ra, a1.proof.left, a2.proof.left, a3.proof.left, a4.proof.left, a4.proof.right)
}

// ---------------------------------------------------------------------------
// A variable the checker reads has its meaning's value in the run

theorem Cell::agrees_val(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Role, c: Cell(tys), d: Dyn(tys), ag: Cell::Agrees(tys, strs, h, r, c, d), live: ¬(r.same(KGone) = True)):
    Value::get(tys, strs, h, c.v, Nil) = Some(d)
{
    (match r as λ q => Cell::Agrees(tys, strs, h, q, c, d) → ¬(q.same(KGone) = True) → Value::get(tys, strs, h, c.v, Nil) = Some(d) {
        KPlain => λ a _ => j(sym(a), λ v _ => Value::get(tys, strs, h, v, Nil) = Some(d), refl),
        KHold(_, _) => λ a _ => a,
        KView => λ a _ => a,
        KGone => λ _ no => false_elim(no(refl)),
    })(ag, live)
}

theorem Sim::val(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), x: Var, l: Nat, hl: s.lvl(x) = Some(l),
    live: ¬((s.role(l)).same(KGone) = True)): Mach::val(tys, strs, m, x) = Some(Env::get(tys, e, x))
{
    Cell::agrees_val(tys, strs, m.heap, s.role(l), REnv::get(tys, m.env, x), Env::get(tys, e, x), sim.vars(x, l, hl), live)
}

theorem Sim::read_val(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), x: Var, g: Got,
    ok: s.read_var(tys, strs, x) = Some(g)): Mach::val(tys, strs, m, x) = Some(Env::get(tys, e, x))
{
    let inv = s.read_inv(tys, strs, Place(x, Nil), g, ok);
    Sim::val(tys, strs, sim, x, g.root, inv.lvl, inv.live)
}

// A word primitive's result has its first operand's code, where that is a
// word.
theorem Dyn::words_code(tys: Nat → Type, x, y: Dyn(tys), op: Prim, c: Shape, xc: x.code = c, isw: c.is_word() = True):
    (Dyn::words<Dyn(tys)>(tys, x, y, λ wd u w => Dyn(SWord(wd), Width::op(wd, op, u, w)))).code = c
{
    j(xc, λ c2 _ => c2.is_word() = True → (Dyn::words<Dyn(tys)>(tys, x, y, λ wd u w => Dyn(SWord(wd), Width::op(wd, op, u, w)))).code = c2,
        (match x.code as λ k => (v: El(tys, k)) → k.is_word() = True → (Dyn::words<Dyn(tys)>(tys, Dyn(k, v), y, λ wd u w => Dyn(SWord(wd), Width::op(wd, op, u, w)))).code = k {
            SWord(_) => λ _ _ => refl,
            SNamed(_) => λ _ no => absurd(no),
        })(x.val))(isw)
}

// A variable the checker reads has the code the checker records.
theorem Sim::read_code(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), x: Var, g: Got,
    ok: s.read_var(tys, strs, x) = Some(g)): (Env::get(tys, e, x)).code = g.code
{
    let inv = s.read_inv(tys, strs, Place(x, Nil), g, ok);
    trans(sim.codes(x, g.root, inv.lvl), Option::some_inj((s.var(g.root)).code, g.code, inv.code))
}

// ---------------------------------------------------------------------------
// Stage lemmas: each statement, run, continues at the machine that agrees
// with the meaning's next environment, at the checker's next state.

// A statement's run continues at `m2`, whatever follows.
fn Stmt::Continues(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), st: Stmt, m, m2: Mach(tys)) → Type {
    (k: Mach(tys) → Ran(tys)) → st.run(tys, strs, fns, call, m, k) = k(m2)
}

theorem Stmt::op_runs(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), op: Prim, a, b: Var, da, db: Dyn(tys),
    va: Mach::val(tys, strs, m, a) = Some(da), vb: Mach::val(tys, strs, m, b) = Some(db), k: Mach(tys) → Ran(tys)):
    (Op(op, a, b)).run(tys, strs, fns, call, m, k) = k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, da, db, λ wd x y => Dyn(SWord(wd), Width::op(wd, op, x, y))))))
{
    let tail = λ (x: Dyn(tys)) => match Mach::val(tys, strs, m, b) { Some(y) => k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, x, y, λ wd u w => Dyn(SWord(wd), Width::op(wd, op, u, w)))))), None => Stuck };
    j(sym(va), λ o _ => (match o { Some(x) => tail(x), None => Stuck }) = k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, da, db, λ wd x y => Dyn(SWord(wd), Width::op(wd, op, x, y)))))),
        j(sym(vb), λ o _ => (match o { Some(y) => k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, da, y, λ wd u w => Dyn(SWord(wd), Width::op(wd, op, u, w)))))), None => Stuck })
            = k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, da, db, λ wd x y => Dyn(SWord(wd), Width::op(wd, op, x, y)))))), refl))
}

// ---------------------------------------------------------------------------
// The words an atom reads agree

theorem Role::plain_is(self r: Role): r.plain() = True → r = KPlain {
    match r { KPlain => λ _ => refl, KHold(_, _) => λ no => absurd(no), KView => λ no => absurd(no), KGone => λ no => absurd(no) }
}

// A plain variable's run-time cell holds the meaning's value.
theorem Sim::plain_cell(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), x: Var, l: Nat,
    hl: s.lvl(x) = Some(l), pl: (s.role(l)).plain() = True): (REnv::get(tys, m.env, x)).v = Plain(Env::get(tys, e, x))
{
    j(Role::plain_is(s.role(l), pl), λ r _ => Cell::Agrees(tys, strs, m.heap, r, REnv::get(tys, m.env, x), Env::get(tys, e, x)), sim.vars(x, l, hl))
}

// The run's word at a plain variable is the meaning's.
theorem Cell::plain_ix(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), c: Cell(tys), d: Dyn(tys), e: c.v = Plain(d)):
    Dyn::ix(tys, (Value::get(tys, strs, h, c.v, Nil)).unwrap_or(Dyn::none(tys))) = Dyn::ix(tys, d)
{
    j(sym(e), λ v _ => Dyn::ix(tys, (Value::get(tys, strs, h, v, Nil)).unwrap_or(Dyn::none(tys))) = Dyn::ix(tys, d), refl)
}

// The cell and value at one index of two lists, from the lists' lengths.
theorem Cell::at_plain(tys: Nat → Type, cs: List<Cell(tys)>, ds: List<Dyn(tys)>, i: Nat, c: Cell(tys), d: Dyn(tys), hc: cs.nth(i) = Some(c), hd: ds.nth(i) = Some(d),
    pl: (cs.nth(i).unwrap_or(Cell::none(tys))).v = Plain(ds.nth(i).unwrap_or(Dyn::none(tys)))): c.v = Plain(d)
{
    let p1 = j(hc, λ o _ => (o.unwrap_or(Cell::none(tys))).v = Plain(ds.nth(i).unwrap_or(Dyn::none(tys))), pl);
    j(hd, λ o _ => c.v = Plain(o.unwrap_or(Dyn::none(tys))), p1)
}

// The words at an index of the arguments' part.
theorem Ix::slot_l(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), cs, cs2: List<Cell(tys)>, ds, ds2: List<Dyn(tys)>, i: Nat, c: Cell(tys), d: Dyn(tys),
    hc: cs.nth(i) = Some(c), hd: ds.nth(i) = Some(d), pl: c.v = Plain(d)):
    (cs ++ cs2).map(λ (x: Cell(tys)) => Dyn::ix(tys, (Value::get(tys, strs, h, x.v, Nil)).unwrap_or(Dyn::none(tys)))).nth(i) = (Dyn::ixs(tys, ds) ++ Dyn::ixs(tys, ds2)).nth(i)
{
    let f = λ (x: Cell(tys)) => Dyn::ix(tys, (Value::get(tys, strs, h, x.v, Nil)).unwrap_or(Dyn::none(tys)));
    let l1 = List::nth_map_some(cs ++ cs2, f, i, c, List::nth_append_l(cs, cs2, i, c, hc));
    let r1 = List::nth_append_l(Dyn::ixs(tys, ds), Dyn::ixs(tys, ds2), i, Dyn::ix(tys, d), List::nth_map_some(ds, λ (x: Dyn(tys)) => Dyn::ix(tys, x), i, d, hd));
    trans(l1, trans(cong_fn(λ (x: Ix) => Some(x), Cell::plain_ix(tys, strs, h, c, d, pl)), sym(r1)))
}

// The words at an index of the locals' part.
theorem Ix::slot_r(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), cs, cs2: List<Cell(tys)>, ds, ds2: List<Dyn(tys)>, n: Nat, lc: cs.len() = n, ld: ds.len() = n,
    i: Nat, c: Cell(tys), d: Dyn(tys), hc: cs2.nth(i) = Some(c), hd: ds2.nth(i) = Some(d), pl: c.v = Plain(d)):
    (cs ++ cs2).map(λ (x: Cell(tys)) => Dyn::ix(tys, (Value::get(tys, strs, h, x.v, Nil)).unwrap_or(Dyn::none(tys)))).nth(i + n) = (Dyn::ixs(tys, ds) ++ Dyn::ixs(tys, ds2)).nth(i + n)
{
    let f = λ (x: Cell(tys)) => Dyn::ix(tys, (Value::get(tys, strs, h, x.v, Nil)).unwrap_or(Dyn::none(tys)));
    let g = λ (x: Dyn(tys)) => Dyn::ix(tys, x);
    let kc: (cs.map(f).len() = n) = trans(List::len_map(cs, f), lc);
    let kd: (ds.map(g).len() = n) = trans(List::len_map(ds, g), ld);
    let l0 = cong_fn(λ (zs: List<Ix>) => zs.nth(i + n), List::map_append(cs, cs2, f));
    let l1 = j(kc, λ q _ => (cs.map(f) ++ cs2.map(f)).nth(i + q) = cs2.map(f).nth(i), List::nth_append_r(cs.map(f), cs2.map(f), i));
    let r1 = j(kd, λ q _ => (ds.map(g) ++ ds2.map(g)).nth(i + q) = ds2.map(g).nth(i), List::nth_append_r(ds.map(g), ds2.map(g), i));
    let mid = trans(List::nth_map_some(cs2, f, i, c, hc), trans(cong_fn(λ (x: Ix) => Some(x), Cell::plain_ix(tys, strs, h, c, d, pl)), sym(List::nth_map_some(ds2, g, i, d, hd))));
    trans(l0, trans(l1, trans(mid, sym(r1))))
}

fn Atom::wix(self x: Atom) → Nat { match x { Var(k) => k, Lit(_) => 0 } }

theorem Atom::var_inj(a, b: Nat, p: Some<Atom>(Var(a)) = Some<Atom>(Var(b))): a = b { j(p, λ y _ => a = (y.unwrap_or(Lit(0))).wix(), refl) }

// An atom the checker reads at a plain level reads one word in the run
// and in the meaning.
theorem Sim::atom_ix(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, self sim: Sim(tys, strs, s, e, m), w: Nat, l: Nat,
    ha: s.atom(Var(w)) = Some(Var(l)), pl: (s.role(l)).plain() = True): (Mach::ixs(tys, strs, m)).nth(w) = (Env::ixs(tys, e)).nth(w)
{
    (match (w + 1).leb(s.na) as λ b => (w + 1).leb(s.na) = b →
            (match b as λ _ => Option<Atom> { True => Some(Var(w)), False => (w - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (w - s.na)))) }) = Some<Atom>(Var(l)) →
            (Mach::ixs(tys, strs, m)).nth(w) = (Env::ixs(tys, e)).nth(w) {
        True => λ eb h => {
            let wl: (w = l) = Atom::var_inj(w, l, h);
            let plw: ((s.role(w)).plain() = True) = j(sym(wl), λ q _ => (s.role(q)).plain() = True, pl);
            let hl: (s.lvl(Arg(w)) = Some(w)) = j(sym(eb), λ b _ => b.then(Some(w)) = Some(w), refl);
            let lt: (w + 1 <= s.na) = Nat::le_of_leb(w + 1, s.na, eb);
            let plc = Sim::plain_cell(tys, strs, sim, Arg(w), w, hl, plw);
            match List::nth_present((m.env).args, w, omega(lt, sim.margs)) {
                ⟨c, hc⟩ => match List::nth_present(e.args, w, omega(lt, sim.eargs)) {
                    ⟨d, hd⟩ => Ix::slot_l(tys, strs, m.heap, (m.env).args, (m.env).locs, e.args, e.locs, w, c, d, hc, hd, Cell::at_plain(tys, (m.env).args, e.args, w, c, d, hc, hd, plc)),
                },
            }
        },
        False => λ eb h => {
            let k = w - s.na;
            let p = Bool::then_some<Atom>((k + 1).leb(s.nd), Some(Var(s.na + s.nd - 1 - k)), Var(l), h);
            let ll: (s.na + s.nd - 1 - k = l) = Atom::var_inj(s.na + s.nd - 1 - k, l, p.right);
            let hl0: (s.lvl(Loc(k)) = Some(s.na + s.nd - 1 - k)) = j(sym(p.left), λ b _ => b.then(Some(s.na + s.nd - 1 - k)) = Some(s.na + s.nd - 1 - k), refl);
            let hl: (s.lvl(Loc(k)) = Some(l)) = trans(hl0, cong_fn(λ (q: Nat) => Some(q), ll));
            let ge: ¬(w + 1 <= s.na) = λ le => absurd(trans(sym(eb), Nat::leb_true(w + 1, s.na, le)));
            let lt: (k + 1 <= s.nd) = Nat::le_of_leb(k + 1, s.nd, p.left);
            let wk: (k + s.na = w) = omega(ge);
            let plc = Sim::plain_cell(tys, strs, sim, Loc(k), l, hl, pl);
            match List::nth_present((m.env).locs, k, omega(lt, sim.mlocs)) {
                ⟨c, hc⟩ => match List::nth_present(e.locs, k, omega(lt, sim.elocs)) {
                    ⟨d, hd⟩ => j(wk, λ q _ => (Mach::ixs(tys, strs, m)).nth(q) = (Env::ixs(tys, e)).nth(q),
                        Ix::slot_r(tys, strs, m.heap, (m.env).args, (m.env).locs, e.args, e.locs, s.na, sim.margs, sim.eargs, k, c, d, hc, hd,
                            Cell::at_plain(tys, (m.env).locs, e.locs, k, c, d, hc, hd, plc))),
                },
            }
        },
    })(refl, ha)
}

// ---------------------------------------------------------------------------
// The selections a place's steps make agree

theorem Option::map_some_inv<A, B>(o: Option<A>, f: A → B, b: B): o.map(f) = Some(b) → Exists<A>(λ a => (o = Some(a)) ∧ (f(a) = b)) {
    match o { None => λ h => absurd(h), Some(a) => λ h => Exists(a, ⟨refl, Option::some_inj(f(a), b, h)⟩) }
}

fn Atom::IsVar(self a: Atom) → Type { match a { Var(_) => True, Lit(_) => False } }

theorem Atom::var_not_lit(a, n: Nat, p: Some<Atom>(Var(a)) = Some<Atom>(Lit(n))): False { j(p, λ y _ => (y.unwrap_or(Lit(0))).IsVar(), trivial) }

// The checker reads a variable atom as a level, never as a literal.
theorem CSt::atom_not_lit(self s: CSt, w: Nat, n: Nat, ha: s.atom(Var(w)) = Some(Lit(n))): False {
    (match (w + 1).leb(s.na) as λ b =>
            (match b as λ _ => Option<Atom> { True => Some(Var(w)), False => (w - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (w - s.na)))) }) = Some<Atom>(Lit(n)) → False {
        True => λ h => Atom::var_not_lit(w, n, h),
        False => λ h => Atom::var_not_lit(s.na + s.nd - 1 - (w - s.na), n, (Bool::then_some<Atom>((w - s.na + 1).leb(s.nd), Some(Var(s.na + s.nd - 1 - (w - s.na))), Lit(n), h)).right),
    })(ha)
}

theorem CSt::atoms_ok_app(self l1: List<Nat>, s: CSt): (l2: List<Nat>) → (r: List<Residual>) → s.atoms_ok(l1 ++ l2) = Some(r) → (s.atoms_ok(l1) = Some(Nil)) ∧ (s.atoms_ok(l2) = Some(r)) {
    match l1 {
        Nil => λ l2 r h => ⟨refl, h⟩,
        Cons(l, rest) => λ l2 r h => {
            let p = Bool::then_some((s.role(l)).plain(), s.atoms_ok(rest ++ l2), r, h);
            let q = CSt::atoms_ok_app(rest, s, l2, r, p.right);
            ⟨j(sym(p.left), λ b _ => b.then(s.atoms_ok(rest)) = Some(Nil), q.left), q.right⟩
        },
    }
}

// An atom the checker reads at plain levels reads one index in the run and
// in the meaning.
theorem Sim::atom_same(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), a, b: Atom, r: List<Residual>,
    ha: s.atom(a) = Some(b), ok: s.atoms_ok(b.lvls()) = Some(r)): a.ix(Mach::ixs(tys, strs, m)) = a.ix(Env::ixs(tys, e))
{
    (match a as λ x => s.atom(x) = Some(b) → x.ix(Mach::ixs(tys, strs, m)) = x.ix(Env::ixs(tys, e)) {
        Lit(_) => λ _ => refl,
        Var(w) => λ hw => (match b as λ y => s.atom(Var(w)) = Some(y) → s.atoms_ok(y.lvls()) = Some(r) → (Mach::ixs(tys, strs, m)).nth(w).unwrap_or(INat(0)) = (Env::ixs(tys, e)).nth(w).unwrap_or(INat(0)) {
            Lit(n) => λ h _ => false_elim(s.atom_not_lit(w, n, h)),
            Var(l) => λ h o => {
                let pl = (Bool::then_some((s.role(l)).plain(), s.atoms_ok(Nil), r, o)).left;
                cong_fn(λ (q: Option<Ix>) => q.unwrap_or(INat(0)), Sim::atom_ix(tys, strs, sim, w, l, h, pl))
            },
        })(hw, ok),
    })(ha)
}

fn Step::sel_two(a: Step, ws, ws2: List<Ix>) → Type { a.sel(ws) = a.sel(ws2) }

theorem Sim::step_same(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), a, b: Step, r: List<Residual>,
    ha: s.step(a) = Some(b), ok: s.atoms_ok(b.lvls()) = Some(r)): a.sel(Mach::ixs(tys, strs, m)) = a.sel(Env::ixs(tys, e))
{
    let w1 = Mach::ixs(tys, strs, m);
    let w2 = Env::ixs(tys, e);
    (match a as λ x => s.step(x) = Some(b) → x.sel(w1) = x.sel(w2) {
        SField(_) => λ _ => refl,
        SElem(i) => λ h => match Option::map_some_inv(s.atom(i), λ (q: Atom) => SElem(q), b, h) {
            ⟨k, pk⟩ => {
                let ok2 = j(sym(pk.right), λ y _ => s.atoms_ok(y.lvls()) = Some(r), ok);
                cong_fn(λ (q: Ix) => OnSeq(SeqOne(q)), Sim::atom_same(tys, strs, sim, i, k, r, pk.left, ok2))
            },
        },
        SWindow(lo, n) => λ h => match Option::and_then_some(s.atom(lo), λ l2 => s.atom(n).map(λ n2 => SWindow(l2, n2)), b, h) {
            ⟨l2, pl⟩ => match Option::map_some_inv(s.atom(n), λ (n2: Atom) => SWindow(l2, n2), b, pl.right) {
                ⟨n2, pn⟩ => {
                    let ok2 = j(sym(pn.right), λ y _ => s.atoms_ok(y.lvls()) = Some(r), ok);
                    let sp = CSt::atoms_ok_app(l2.lvls(), s, n2.lvls(), r, ok2);
                    let el = Sim::atom_same(tys, strs, sim, lo, l2, Nil, pl.left, sp.left);
                    let en = Sim::atom_same(tys, strs, sim, n, n2, r, pn.left, sp.right);
                    trans(cong_fn(λ (q: Ix) => OnSeq(SeqRun(q, n.ix(w1))), el), cong_fn(λ (q: Ix) => OnSeq(SeqRun(lo.ix(w2), q)), en))
                },
            },
        },
        SKey(_, _) => λ h => absurd(h),
        SVariant(_) => λ h => absurd(h),
    })(ha)
}

// A place's steps the checker reads at plain levels select alike in the
// run and in the meaning.
theorem Sim::steps_same(self ps: List<Step>, tys: Nat → Type, strs: Strs(tys), s: CSt, e: Env(tys), m: Mach(tys), sim: Sim(tys, strs, s, e, m)):
    (xs: List<Step>) → s.steps(ps) = Some(xs) → (r: List<Residual>) → s.atoms_ok(Steps::lvls(xs)) = Some(r) →
    Steps::sels(ps, Mach::ixs(tys, strs, m)) = Steps::sels(ps, Env::ixs(tys, e))
{
    match ps {
        Nil => λ _ _ _ _ => refl,
        Cons(a, rest) => λ xs h r ok => match Option::and_then_some(s.step(a), λ b => s.steps(rest).map(λ bs => Cons(b, bs)), xs, h) {
            ⟨b, pb⟩ => match Option::map_some_inv(s.steps(rest), λ (bs: List<Step>) => Cons(b, bs), xs, pb.right) {
                ⟨bs, pbs⟩ => {
                    let ok2 = j(sym(pbs.right), λ y _ => s.atoms_ok(Steps::lvls(y)) = Some(r), ok);
                    let sp = CSt::atoms_ok_app(b.lvls(), s, Steps::lvls(bs), r, ok2);
                    let hd = Sim::step_same(tys, strs, sim, a, b, Nil, pb.left, sp.left);
                    let tl = Sim::steps_same(rest, tys, strs, s, e, m, sim, bs, pbs.left, r, sp.right);
                    trans(cong_fn(λ (q: Sel) => Cons(q, Steps::sels(rest, Mach::ixs(tys, strs, m))), hd), cong_fn(λ (t: List<Sel>) => Cons(a.sel(Env::ixs(tys, e)), t), tl))
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The read stage

theorem Residual::all_app(tys: Nat → Type, cx: Ctx(tys), env: Env(tys), tail: Type, xs: List<Residual>): (ys: List<Residual>) → Residual::All(xs ++ ys, tys, cx, env, tail) →
    Residual::All(xs, tys, cx, env, True) ∧ Residual::All(ys, tys, cx, env, tail)
{
    match xs {
        Nil => λ ys h => ⟨trivial, h⟩,
        Cons(_, rest) => λ ys h => {
            let ih = Residual::all_app(tys, cx, env, tail, rest, ys, h.right);
            ⟨⟨h.left, ih.left⟩, ih.right⟩
        },
    }
}

theorem Residual::all_true(tys: Nat → Type, cx: Ctx(tys), env: Env(tys), tail: Type, xs: List<Residual>): Residual::All(xs, tys, cx, env, tail) → Residual::All(xs, tys, cx, env, True) {
    match xs { Nil => λ _ => trivial, Cons(_, rest) => λ h => ⟨h.left, Residual::all_true(tys, cx, env, tail, rest, h.right)⟩ }
}

// A place's code is what the checker's codes of its steps say, fit or not.
theorem Dyn::read_code(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs: List<Step>): (d: Dyn(tys)) → (c, c2: Shape) → d.code = c → Shape::steps_ok(tys, strs, xs, c) = Some(c2) →
    (Dyn::read(tys, strs, ws, xs, d)).code = c2
{
    match xs {
        Nil => λ d c c2 ec ok => trans(ec, Option::some_inj(c, c2, ok)),
        Cons(a, rest) => λ d c c2 ec ok => {
            let sp = Option::and_then_some(Shape::step_ok(tys, strs, a, c), λ c1 => Shape::steps_ok(tys, strs, rest, c1), c2, ok);
            let c1 = sp.witness;
            let has1: (Dyn::part_code(tys, strs, a.sel(ws), c) = Some(c1)) = trans(Step::part_code(tys, strs, a, ws, Nil, c), sp.proof.left);
            let has: (Dyn::part_code(tys, strs, a.sel(ws), d.code) = Some(c1)) = j(sym(ec), λ q _ => Dyn::part_code(tys, strs, a.sel(ws), q) = Some(c1), has1);
            Dyn::read_code(tys, strs, ws, rest, Dyn::at(tys, strs, a.sel(ws), d), c1, c2, Dyn::at_code(tys, strs, a.sel(ws), d, c1, has), sp.proof.right)
        },
    }
}

// The run reads a place the checker read where the meaning does, given the
// read's residuals.
theorem Sim::place(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, cx.strs, s, e, m), p: Place, g: Got,
    ok: s.read(tys, cx.strs, p) = Some(g), tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)): Mach::place(tys, cx.strs, m, p) = Some(p.val(tys, cx.strs, e))
{
    let strs = cx.strs;
    let inv = s.read_inv(tys, strs, p, g, ok);
    let ws = Env::ixs(tys, e);
    let res1 = Residual::all_app(tys, cx, e, tail, inv.ra, inv.rl ++ p.accesses(), j(inv.rs, λ q _ => Residual::All(q, tys, cx, e, tail), res)).right;
    let acc = Residual::all_true(tys, cx, e, tail, p.accesses(), (Residual::all_app(tys, cx, e, tail, inv.rl, p.accesses(), res1)).right);
    let root: (((Place(p.root, Nil)).val(tys, strs, e)).code = (s.var(g.root)).code) = sim.codes(p.root, g.root, inv.lvl);
    let fit = Place::fit_from(tys, cx, sl, e, p.root, p.steps, Nil, (s.var(g.root)).code, g.code, root, inv.code, acc);
    let same = Sim::steps_same(p.steps, tys, strs, s, e, m, sim, g.at, inv.steps, inv.ra, inv.atoms);
    let got = Value::get_more(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, Env::get(tys, e, p.root), Sim::val(tys, strs, sim, p.root, g.root, inv.lvl, inv.live),
        Steps::sels(p.steps, ws), fit);
    let got2 = j(sym(same), λ q _ => Value::get(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, q) = Some(Sel::read_at(tys, strs, Steps::sels(p.steps, ws), Env::get(tys, e, p.root))), got);
    trans(got2, cong_fn(λ (x: Dyn(tys)) => Some(x), sym(Steps::read_sels(tys, strs, ws, p.steps, Env::get(tys, e, p.root)))))
}

theorem Sim::place_code(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), p: Place, g: Got,
    ok: s.read(tys, strs, p) = Some(g)): (p.val(tys, strs, e)).code = g.code
{
    let inv = s.read_inv(tys, strs, p, g, ok);
    Dyn::read_code(tys, strs, Env::ixs(tys, e), p.steps, Env::get(tys, e, p.root), (s.var(g.root)).code, g.code, sim.codes(p.root, g.root, inv.lvl), inv.code)
}

// ---------------------------------------------------------------------------
// The invariant
//
// What holds between the checker's state `s`, the meaning's environment `e`
// and the run's machine `m`, for a function entered on heap `h0` with the
// blocks `lent` it was lent:
//
// - `sim`: every live variable's cell agrees with its meaning as its role
//   says (`Sim`), against the meaning with the pending chain written up
//   (`CSt::patched`): while a view to write has changed and is not yet
//   written back, the heap already holds its value in each of its
//   ancestors, which the meaning holds only after each write-back. Only a
//   chain whose cells refer: a view of an object held by value is a copy,
//   and its ancestors' cells, like their meanings, change at the write-back
//   (a chain refers or is plain throughout, a view's cell being its
//   parent's narrowed). The chain is walked by levels, a parent's being
//   lower, so the level count is its fuel.
// - `root`, `refs`: each object has at most one reference in the run (an
//   object held by value has none), and a live variable's reference is its
//   object's (a holder) or its object's narrowed by one of its entries'
//   region at the words (a view). The licence's apartness is between
//   regions of one object; this is what makes it apartness of the run's
//   references.
// - `apart`, `inheap`: objects one of which may change have roots apart:
//   `Lendable`'s clause at entry, a fresh block after, which is past every
//   root (`inheap`). Stated per object, a binding touches neither.
// - `owned`, `frame`, `grows`: an object something may change through has
//   its root in a block it was lent to change or made here, so the blocks
//   lent only to read, and those not lent, are as they were.
// - `own`: a cell whose frame owns its block holds its object's root, a
//   whole block no other object's root is in, so the object's death frees
//   only it.
// - `one`: an object has one holder, so a write or death through it meets
//   every other variable of the object in the licence.
// - `words`: every level a live region reads is a plain variable, so the
//   region's selections are the same in the run and in the meaning, and do
//   not move while it lives.
// - `young`, `held`, `vents`: the objects made so far are below `nobj`, and
//   none past it has a root, so a fresh object's is new; a live entry is a
//   view variable's, below the next level.
// - `bare`: an object's block has no holes (this fragment), so its read does
//   not depend on the rest of the heap.
// - `chain`: a live entry's parent is live, at a lower level, and its
//   region extends the parent's by the place it was opened at, so a write-back
//   stores what is there, and the pending chain is the ancestors'.
// - `excl`: a live view to write is apart from every live entry of its
//   object that is neither its ancestor nor its descendant: the licence
//   checked it when the later of the two was opened, and it meets only its
//   descendants after.

fn CSt::unstep(self s: CSt, a: Step) → Step {
    match a {
        SField(i) => SField(i),
        SElem(i) => SElem(s.unatom(i)),
        SWindow(lo, n) => SWindow(s.unatom(lo), s.unatom(n)),
        SKey(i, g) => SKey(s.unatom(i), s.unatom(g)),
        SVariant(c) => SVariant(c),
    }
}

fn CSt::unsteps(self s: CSt, xs: List<Step>) → List<Step> { xs.map(λ a => s.unstep(a)) }

fn VEnt::Any(es: List<VEnt>, P: VEnt → Type) → Type { match es { Nil => False, Cons(en, rest) => P(en) ∨ VEnt::Any(rest, P) } }

// A live variable's run reference, as its role says: a holder's is its
// object's root; a view's is one of its entries' object's root narrowed by
// the entry's region at the words (after a join, a read view's entries may
// be of several objects); a plain variable has none.
fn CSt::RefOk(self s: CSt, root: Nat → Option<Ref>, ws: List<Ix>, l: Nat, r: Ref) → Type {
    match s.role(l) {
        KHold(o, _) => root(o) = Some(r),
        KView => VEnt::Any(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
        KPlain => False,
        KGone => True,
    }
}

// An object something live may change through: a holder that may write
// it, or a live entry of a view to write.
fn CSt::Changes(self s: CSt, o: Nat) → Type {
    Exists<Nat>(λ l => (l < s.na + s.nd) ∧ Exists<Acc>(λ a => (s.role(l) = KHold(o, a)) ∧ (a.writes() = True))) ∨
        Exists<VEnt>(λ en => Mem(en, s.views) ∧ ((en.obj = o) ∧ (en.mode.writes() = True)))
}

// The pending chain written up, child into parent, from a view whose value
// the heap holds and its ancestors' meanings do not yet.
fn CSt::up(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), c: Nat, fuel: Nat) → Env(tys) {
    match fuel {
        Zero => e,
        Succ(f) => match s.ents(c) {
            Nil => e,
            Cons(en, _) => match en.par.same(c) {
                True => e,
                False => s.up(tys, strs, Env::set(tys, e, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(en.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), en.par, f),
            },
        },
    }
}

fn CSt::patched(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys)) → Env(tys) {
    match s.pending() {
        False => e,
        True => match s.views.find(λ en => en.mode.writes() && !en.back) {
            Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v { Refer(_) => s.up(tys, strs, e, en.lvl, s.na + s.nd), Plain(_) => e },
            None => e,
        },
    }
}

theorem CSt::patched_none(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), none: s.pending() = False): s.patched(tys, strs, e, m) = e {
    j(sym(none), λ b _ => (match b { False => e, True => match s.views.find(λ en => en.mode.writes() && !en.back) {
        Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v { Refer(_) => s.up(tys, strs, e, en.lvl, s.na + s.nd), Plain(_) => e }, None => e } }) = e, refl)
}

// A live entry's parent: the holder of its object, its region the place it
// was opened at; or a view, one of whose entries' region its region extends
// by that place.
fn CSt::Parent(self s: CSt, en: VEnt) → Type {
    match s.role(en.par) {
        KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
        KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
        KPlain => False,
        KGone => False,
    }
}

// A live view to write whose parent is a view: the parent has one entry,
// itself to write (the checker opened it through `write_at`, and a parent
// with children does not die), so the pending chain is one path.
fn CSt::WPar(self s: CSt, en: VEnt) → Type { s.role(en.par) = KView → Exists<VEnt>(λ pe => (s.ents(en.par) = [pe]) ∧ (pe.mode.writes() = True)) }

theorem CSt::wpar_keep(s, s2: CSt, en: VEnt, role: s2.role(en.par) = s.role(en.par), ents: s2.ents(en.par) = s.ents(en.par), w: s.WPar(en)): s2.WPar(en) {
    λ rv => match w(trans(sym(role), rv)) { ⟨pe, pp⟩ => Exists(pe, ⟨trans(ents, pp.left), pp.right⟩) }
}

fn Value::refers(tys: Nat → Type, v: Value(tys)) → Bool { match v { Plain(_) => False, Refer(_) => True } }

// A live entry's cell and its parent's both refer or are both copies: a
// view's cell is its parent's narrowed, or a copy of a copy.
fn CSt::Uni(tys: Nat → Type, s: CSt, env: REnv(tys)) → Type {
    (en: VEnt) → Mem(en, s.views) → (x, y: Var) → s.lvl(x) = Some(en.lvl) → s.lvl(y) = Some(en.par) →
        Value::refers(tys, (REnv::get(tys, env, x)).v) = Value::refers(tys, (REnv::get(tys, env, y)).v)
}

// The entries pending (to write, not written back) are at one level: the
// write-back is eager, so at most one view's change is in flight, and
// `patched` follows the first such entry.
fn CSt::POne(self s: CSt) → Type {
    (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, s.views) → (e1.mode.writes() && !e1.back) = True → (e2.mode.writes() && !e2.back) = True → e1.lvl = e2.lvl
}

// A live entry whose parent's cell is a copy: its place fits that copy at
// the run's words, and its own copy is like what the place reads there (its
// code and length), so writing it back is a write that fits and keeps the
// place fitting (`cfit`). A copy's write-back is the design's ordinary case
// for small plain data (§15.2), and the run's write is stuck where the place
// does not fit; the like-ness is what a write at a place of several steps
// needs to keep it fitting.
fn CSt::CFitAt(tys: Nat → Type, strs: Strs(tys), ss: List<Sel>, dp, dc: Dyn(tys)) → Type {
    (Sel::fit(tys, strs, ss, dp) = True) ∧ ((dc.code = (Sel::read_at(tys, strs, ss, dp)).code) ∧ (Dyn::len(tys, strs, dc) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, dp))))
}

fn CSt::CFit(tys: Nat → Type, strs: Strs(tys), s: CSt, env: REnv(tys), ws: List<Ix>) → Type {
    (en: VEnt) → Mem(en, s.views) → (y, z: Var) → s.lvl(y) = Some(en.par) → s.lvl(z) = Some(en.lvl) → (dp, dc: Dyn(tys)) →
        (REnv::get(tys, env, y)).v = level2::Plain(dp) → (REnv::get(tys, env, z)).v = level2::Plain(dc) → CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), ws), dp, dc)
}

// Two live entries opened on one parent, one of them to write, are apart at
// their places (`sib`). `excl` says so of their whole regions; under a
// parent that is a view the regions share the parent's, and a write-back
// into a copy changes the copy at one child's place, which must keep a
// sibling's place fitting. The licence's decider found the places apart, a
// common prefix deciding nothing (`Steps::apart_prefix`).
fn CSt::Sib(tys: Nat → Type, strs: Strs(tys), s: CSt, ws: List<Ix>) → Type {
    (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, s.views) → e1.mode.writes() = True → e1.par = e2.par → ¬(e1.lvl = e2.lvl) →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(e2.at), ws))
}

record Inv(tys: Nat → Type, strs: Strs(tys), s: CSt, e: Env(tys), m: Mach(tys), h0: Heap(tys), lent: Nat → Bool) {
    sim: Sim(tys, strs, s, s.patched(tys, strs, e, m), m),
    root: Nat → Option<Ref>,
    refs: (x: Var) → (l: Nat) → s.lvl(x) = Some(l) → (r: Ref) → (REnv::get(tys, m.env, x)).v = Refer(r) → s.RefOk(root, Mach::ixs(tys, strs, m), l, r),
    apart: (o1, o2: Nat) → ¬(o1 = o2) → s.Changes(o1) → (r1, r2: Ref) → root(o1) = Some(r1) → root(o2) = Some(r2) → Ref::Apart(tys, strs, r1, r2),
    inheap: (o: Nat) → (r: Ref) → root(o) = Some(r) → r.b < m.heap.len(),
    owned: (o: Nat) → s.Changes(o) → (r: Ref) → root(o) = Some(r) → (lent(r.b) = True) ∨ (h0.len() <= r.b),
    own: (x: Var) → (l: Nat) → s.lvl(x) = Some(l) → ¬((s.role(l)).same(KGone) = True) → (REnv::get(tys, m.env, x)).own = True → (r: Ref) → (REnv::get(tys, m.env, x)).v = Refer(r) →
        Exists<Nat>(λ o => (s.role(l) = KHold(o, AcOwn)) ∧ ((root(o) = Some(r)) ∧ ((r.sels = Nil) ∧ ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → root(o2) = Some(r2) → ¬(r2.b = r.b))))),
    one: (l1, l2, o: Nat) → (a1, a2: Acc) → l1 < s.na + s.nd → l2 < s.na + s.nd → ¬(l1 = l2) → s.role(l1) = KHold(o, a1) → s.role(l2) = KHold(o, a2) → False,
    words: (l: Nat) → s.in_regions(l) = True → (l < s.na + s.nd) ∧ ((s.role(l)).plain() = True),
    frame: Heap::Frame(tys, h0, m.heap, lent),
    grows: h0.len() <= m.heap.len(),
    young: (o: Nat) → s.nobj <= o → root(o) = None,
    held: (l, o: Nat) → (a: Acc) → l < s.na + s.nd → s.role(l) = KHold(o, a) → o < s.nobj,
    vents: (en: VEnt) → Mem(en, s.views) → (en.obj < s.nobj) ∧ ((en.lvl < s.na + s.nd) ∧ (s.role(en.lvl) = KView)),
    bare: (o: Nat) → (r: Ref) → root(o) = Some(r) → (ob: Obj(tys)) → Heap::obj(tys, m.heap, r.b) = Some(ob) → ob.holes = Nil,
    chain: (en: VEnt) → Mem(en, s.views) → (en.par < en.lvl) ∧ s.Parent(en),
    excl: (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, s.views) → e1.mode.writes() = True → e1.obj = e2.obj → ¬(e1.lvl = e2.lvl) →
        e1.lvl.member(s.anc_of(e2, s.na + s.nd)) = False → e2.lvl.member(s.anc_of(e1, s.na + s.nd)) = False →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), Mach::ixs(tys, strs, m)), Steps::sels(s.unsteps(e2.reg), Mach::ixs(tys, strs, m))),
    wpar: (en: VEnt) → Mem(en, s.views) → en.mode.writes() = True → s.WPar(en),
    uni: CSt::Uni(tys, s, m.env),
    pone: s.POne(),
    cfit: CSt::CFit(tys, strs, s, m.env, Mach::ixs(tys, strs, m)),
    sib: CSt::Sib(tys, strs, s, Mach::ixs(tys, strs, m)),
}

// Where nothing is pending, the invariant's first part is `Sim` itself.
theorem Inv::sim_now(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False): Sim(tys, strs, s, e, m)
{
    j(s.patched_none(tys, strs, e, m, none), λ q _ => Sim(tys, strs, s, q, m), inv.sim)
}

// ---------------------------------------------------------------------------
// Entry: the invariant at a function's start, from `SafeAt`'s premises

theorem Shape::same_eq(a, b: Shape, h: a.same(b) = True): a = b {
    (match Shape::dec(a, b) as λ o => (match o { Inl(_) => True, Inr(_) => False }) = True → a = b { Inl(e) => λ _ => e, Inr(_) => λ no => absurd(no) })(h)
}

// Coded arguments hold their parameters' codes at each index.
theorem Dyn::coded_nth(tys: Nat → Type, ds: List<Dyn(tys)>): (ps: List<Param>) → Dyn::Coded(tys, ds, ps) → (i: Nat) → (d: Dyn(tys)) → (p: Param) →
    ds.nth(i) = Some(d) → ps.nth(i) = Some(p) → d.code = p.code
{
    match ds {
        Nil => λ ps _ i d p no => absurd(no),
        Cons(d0, dr) => λ ps => match ps {
            Nil => λ no => absurd(no),
            Cons(q, pr) => λ h i => {
                let parts = Bool::and_true_parts(d0.code.same(q.code), Dyn::coded(tys, dr, pr), h);
                match i {
                    Zero => λ d p ed ep => {
                        let a: (d0 = d) = Option::some_inj(d0, d, ed);
                        let b: (q = p) = Option::some_inj(q, p, ep);
                        j(b, λ r _ => d.code = r.code, j(a, λ r _ => r.code = q.code, Shape::same_eq(d0.code, q.code, parts.left)))
                    },
                    Succ(k) => λ d p ed ep => Dyn::coded_nth(tys, dr, pr, parts.right, k, d, p, ed, ep),
                }
            },
        },
    }
}

fn CSt::role_of(tys: Nat → Type, strs: Strs(tys), p: Param, i: Nat) → Role {
    match p.mode { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(i, AcOwn) }, ByRead => KHold(i, AcRead), ByWrite => KHold(i, AcWrite) }
}

theorem CSt::params_nth(tys: Nat → Type, strs: Strs(tys), ps: List<Param>): (k, i: Nat) → (p: Param) → ps.nth(i) = Some(p) →
    (CSt::params(tys, strs, ps, k)).nth(i) = Some(CVar(p.code, CSt::role_of(tys, strs, p, i + k)))
{
    match ps {
        Nil => λ k i p no => absurd(no),
        Cons(q, rest) => λ k i => match i {
            Zero => λ p e => {
                let qp: (q = p) = Option::some_inj(q, p, e);
                let kk: (k = 0 + k) = omega();
                j(kk, λ n _ => Some(CVar(q.code, CSt::role_of(tys, strs, q, k))) = Some(CVar(p.code, CSt::role_of(tys, strs, p, n))),
                    j(qp, λ r _ => Some(CVar(q.code, CSt::role_of(tys, strs, q, k))) = Some(CVar(r.code, CSt::role_of(tys, strs, r, k))), refl))
            },
            Succ(i1) => λ p e => {
                let ih = CSt::params_nth(tys, strs, rest, k + 1, i1, p, e);
                let ii: (i1 + (k + 1) = Succ(i1) + k) = omega();
                j(ii, λ n _ => (CSt::params(tys, strs, rest, k + 1)).nth(i1) = Some(CVar(p.code, CSt::role_of(tys, strs, p, n))), ih)
            },
        },
    }
}

theorem Cell::args_v(tys: Nat → Type, vs: List<Value(tys)>): (ps: List<Param>) → (i: Nat) → (Cell::args(tys, ps, vs)).nth(i).map(λ (c: Cell(tys)) => c.v) = vs.nth(i) {
    match vs {
        Nil => λ ps i => refl,
        Cons(_, rest) => λ ps i => match i { Zero => refl, Succ(k) => Cell::args_v(tys, rest, ps.drop(1), k) },
    }
}

theorem Cell::args_len(tys: Nat → Type, vs: List<Value(tys)>): (ps: List<Param>) → (Cell::args(tys, ps, vs)).len() = vs.len() {
    match vs { Nil => λ ps => refl, Cons(_, rest) => λ ps => Nat::cong_succ(Cell::args_len(tys, rest, ps.drop(1))) }
}

theorem Value::read_all_len(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), f: Nat, vs: List<Value(tys)>): (ds: List<Dyn(tys)>) → Value::ReadAll(tys, strs, h, f, vs, ds) → vs.len() = ds.len() {
    match vs {
        Nil => λ ds => match ds { Nil => λ _ => refl, Cons(_, _) => λ no => false_elim(no) },
        Cons(_, vr) => λ ds => match ds { Nil => λ no => false_elim(no), Cons(_, dr) => λ h2 => Nat::cong_succ(Value::read_all_len(tys, strs, h, f, vr, dr, h2.right)) },
    }
}

theorem Value::read_all_nth(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), f: Nat, vs: List<Value(tys)>): (ds: List<Dyn(tys)>) → Value::ReadAll(tys, strs, h, f, vs, ds) →
    (i: Nat) → (v: Value(tys)) → (d: Dyn(tys)) → vs.nth(i) = Some(v) → ds.nth(i) = Some(d) → Value::read(tys, v, strs, h, f) = Some(d)
{
    match vs {
        Nil => λ ds _ i v d no => absurd(no),
        Cons(v0, vr) => λ ds => match ds {
            Nil => λ no => false_elim(no),
            Cons(d0, dr) => λ h2 i => match i {
                Zero => λ v d ev ed => {
                    let a: (v0 = v) = Option::some_inj(v0, v, ev);
                    let b: (d0 = d) = Option::some_inj(d0, d, ed);
                    j(b, λ q _ => Value::read(tys, v, strs, h, f) = Some(q), j(a, λ q _ => Value::read(tys, q, strs, h, f) = Some(d0), h2.left))
                },
                Succ(k) => λ v d ev ed => Value::read_all_nth(tys, strs, h, f, vr, dr, h2.right, k, v, d, ev, ed),
            },
        },
    }
}

theorem Obj::fill_nil(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), fuel: Nat, d: Dyn(tys)): Obj::fill(tys, strs, h, fuel, d, Nil) = Some(d) { match fuel { Zero => refl, Succ(_) => refl } }

// An argument the meaning reads, live and fitting, the run reads too.
theorem Value::get_of_read(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), v: Value(tys), d: Dyn(tys), rd: Value::read(tys, v, strs, h, h.len()) = Some(d),
    live: (r: Ref) → v = Refer(r) → Exists<Dyn(tys)>(λ d1 => (Heap::obj(tys, h, r.b) = Some(Obj(d1, Nil))) ∧ (Sel::fit(tys, strs, r.sels, d1) = True))):
    Value::get(tys, strs, h, v, Nil) = Some(d)
{
    (match v as λ u => Value::read(tys, u, strs, h, h.len()) = Some(d) → ((r: Ref) → u = Refer(r) → Exists<Dyn(tys)>(λ d1 => (Heap::obj(tys, h, r.b) = Some(Obj(d1, Nil))) ∧ (Sel::fit(tys, strs, r.sels, d1) = True))) →
            Value::get(tys, strs, h, u, Nil) = Some(d) {
        Plain(_) => λ e _ => e,
        Refer(r) => λ e lv => match lv(r, refl) {
            ⟨d1, pr⟩ => {
                let hv: (Heap::val(tys, strs, h, r.b) = Some(d1)) =
                    j(sym(pr.left), λ oo _ => (match oo as λ _ => Option<Dyn(tys)> { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None }) = Some(d1), Obj::fill_nil(tys, strs, h, h.len(), d1));
                let rd1: (Some(Sel::read_at(tys, strs, r.sels, d1)) = Some(d)) =
                    trans(sym(j(sym(pr.left), λ oo _ => (match oo as λ _ => Option<Dyn(tys)> { Some(o) => Obj::read(tys, strs, h, h.len(), o).map(λ x => Sel::read_at(tys, strs, r.sels, x)), None => None })
                        = Some(Sel::read_at(tys, strs, r.sels, d1)), cong_fn(λ (o: Option<Dyn(tys)>) => o.map(λ x => Sel::read_at(tys, strs, r.sels, x)), Obj::fill_nil(tys, strs, h, h.len(), d1)))), e);
                let base: (Sel::get(tys, strs, r.sels ++ Nil, d1) = Some(d)) =
                    trans(cong_fn(λ (ss: List<Sel>) => Sel::get(tys, strs, ss, d1), List::append_nil(r.sels)), trans(Sel::get_fit(tys, strs, r.sels, d1, pr.right), rd1));
                j(sym(hv), λ oo _ => (match oo as λ _ => Option<Dyn(tys)> { Some(x) => Sel::get(tys, strs, r.sels ++ Nil, x), None => None }) = Some(d), base)
            },
        },
    })(rd, live)
}

// A level at the start is an argument's position.
theorem CSt::start_lvl(tys: Nat → Type, strs: Strs(tys), sig: Sig, x: Var, l: Nat, h: (CSt::start(tys, strs, sig)).lvl(x) = Some(l)): (x = Arg(l)) ∧ (l < sig.params.len()) {
    (match x as λ y => (CSt::start(tys, strs, sig)).lvl(y) = Some(l) → (y = Arg(l)) ∧ (l < sig.params.len()) {
        Arg(i) => λ h2 => {
            let p = Bool::then_some((i + 1).leb(sig.params.len()), Some(i), l, h2);
            let il: (i = l) = Option::some_inj(i, l, p.right);
            ⟨cong_fn(λ (k: Nat) => Arg(k), il), omega(Nat::le_of_leb(i + 1, sig.params.len(), p.left), il)⟩
        },
        Loc(_) => λ no => absurd(no),
    })(h)
}

theorem CSt::start_var(tys: Nat → Type, strs: Strs(tys), sig: Sig, i: Nat, p: Param, hp: sig.params.nth(i) = Some(p), lt: i < sig.params.len()):
    (CSt::start(tys, strs, sig)).var(i) = CVar(p.code, CSt::role_of(tys, strs, p, i))
{
    let below: ((i + 1).leb(sig.params.len()) = True) = Nat::leb_true(i + 1, sig.params.len(), lt);
    let at = CSt::params_nth(tys, strs, sig.params, 0, i, p, hp);
    j(sym(below), λ b _ => (match b { True => (CSt::params(tys, strs, sig.params, 0)).nth(i).unwrap_or(CVar::none()),
        False => (Nil<CVar>()).nth(sig.params.len() + 0 - 1 - i).unwrap_or(CVar::none()) }) = CVar(p.code, CSt::role_of(tys, strs, p, i)),
        cong_fn(λ (o: Option<CVar>) => o.unwrap_or(CVar::none()), at))
}

// One argument's slot: its parameter, value, meaning and cell.
record Slot(tys: Nat → Type, ps: List<Param>, vs: List<Value(tys)>, ds: List<Dyn(tys)>, cs: List<Cell(tys)>, i: Nat) {
    p: Param, v: Value(tys), d: Dyn(tys), c: Cell(tys),
    hp: ps.nth(i) = Some(p), hv: vs.nth(i) = Some(v), hd: ds.nth(i) = Some(d), hc: cs.nth(i) = Some(c), cv: c.v = v,
}

theorem Slot::at(tys: Nat → Type, ps: List<Param>, vs: List<Value(tys)>, ds: List<Dyn(tys)>, i: Nat, lv: vs.len() = ps.len(), ld: ds.len() = ps.len(), lt: i < ps.len()):
    Slot(tys, ps, vs, ds, Cell::args(tys, ps, vs), i)
{
    let lc: ((Cell::args(tys, ps, vs)).len() = ps.len()) = trans(Cell::args_len(tys, vs, ps), lv);
    match List::nth_present(ps, i, lt) {
        ⟨p, hp⟩ => match List::nth_present(vs, i, omega(lt, lv)) {
            ⟨v, hv⟩ => match List::nth_present(ds, i, omega(lt, ld)) {
                ⟨d, hd⟩ => match List::nth_present(Cell::args(tys, ps, vs), i, omega(lt, lc)) {
                    ⟨c, hc⟩ => {
                        let m0 = Cell::args_v(tys, vs, ps, i);
                        let m1: (Some(c.v) = vs.nth(i)) = j(hc, λ o _ => o.map(λ (q: Cell(tys)) => q.v) = vs.nth(i), m0);
                        Slot(p, v, d, c, hp, hv, hd, hc, Option::some_inj(c.v, v, trans(m1, hv)))
                    },
                },
            },
        },
    }
}

// An argument's cell agrees with its meaning as its parameter's role says.
theorem Cell::start_agrees(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), p: Param, i: Nat, c: Cell(tys), v: Value(tys), d: Dyn(tys), cv: c.v = v,
    rd: Value::read(tys, v, strs, h, h.len()) = Some(d),
    live: (r: Ref) → v = Refer(r) → Exists<Dyn(tys)>(λ d1 => (Heap::obj(tys, h, r.b) = Some(Obj(d1, Nil))) ∧ (Sel::fit(tys, strs, r.sels, d1) = True)),
    plain: p.mode = ByTake → Shape::plain(tys, strs, p.code) = True → (r: Ref) → ¬(v = Refer(r))):
    Cell::Agrees(tys, strs, h, CSt::role_of(tys, strs, p, i), c, d)
{
    let reads: Value::Reads(tys, strs, h, c.v, d) = j(sym(cv), λ u _ => Value::get(tys, strs, h, u, Nil) = Some(d), Value::get_of_read(tys, strs, h, v, d, rd, live));
    (match p.mode as λ md => p.mode = md → Cell::Agrees(tys, strs, h,
            match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(i, AcOwn) }, ByRead => KHold(i, AcRead), ByWrite => KHold(i, AcWrite) }, c, d) {
        ByRead => λ _ => reads,
        ByWrite => λ _ => reads,
        ByTake => λ em => (match Shape::plain(tys, strs, p.code) as λ b => Shape::plain(tys, strs, p.code) = b →
                Cell::Agrees(tys, strs, h, match b { True => KPlain, False => KHold(i, AcOwn) }, c, d) {
            False => λ _ => reads,
            True => λ ep => (match v as λ u => c.v = u → Value::read(tys, u, strs, h, h.len()) = Some(d) → ((r: Ref) → ¬(u = Refer(r))) → c.v = level2::Plain(d) {
                Plain(d0) => λ cv2 rd2 _ => trans(cv2, cong_fn(λ (x: Dyn(tys)) => level2::Plain(x), Option::some_inj(d0, d, rd2))),
                Refer(r) => λ _ _ no => false_elim(no(r, refl)),
            })(cv, rd, plain(em, ep)),
        })(refl),
    })(refl)
}

// The invariant's first part at the start.
theorem Sim::start(tys: Nat → Type, strs: Strs(tys), sig: Sig, vs: List<Value(tys)>, h: Heap(tys), io: Io, ds: List<Dyn(tys)>, ra: Value::ReadAll(tys, strs, h, h.len(), vs, ds),
    coded: Dyn::Coded(tys, ds, sig.params), ld: Lendable(tys, strs, sig.params, h, vs)):
    Sim(tys, strs, CSt::start(tys, strs, sig), Env::start(tys, ds), Mach(h, REnv(Cell::args(tys, sig.params, vs), Nil), io))
{
    let s = CSt::start(tys, strs, sig);
    let e = Env::start(tys, ds);
    let cs = Cell::args(tys, sig.params, vs);
    let lv: (vs.len() = sig.params.len()) = ld.arity;
    let ld2: (ds.len() = sig.params.len()) = trans(sym(Value::read_all_len(tys, strs, h, h.len(), vs, ds, ra)), lv);
    Sim(ld2, trans(Cell::args_len(tys, vs, sig.params), lv), refl, refl,
        λ x l hl => {
            let st = CSt::start_lvl(tys, strs, sig, x, l, hl);
            let sl = Slot::at(tys, sig.params, vs, ds, l, lv, ld2, st.right);
            let var = CSt::start_var(tys, strs, sig, l, sl.p, sl.hp, st.right);
            let ag = Cell::start_agrees(tys, strs, h, sl.p, l, sl.c, sl.v, sl.d, sl.cv, Value::read_all_nth(tys, strs, h, h.len(), vs, ds, ra, l, sl.v, sl.d, sl.hv, sl.hd),
                λ r e2 => ld.live(l, r, trans(sl.hv, cong_fn(λ (u: Value(tys)) => Some(u), e2))),
                λ em ep r e2 => ld.plain(l, sl.p, sl.hp, em, ep, r)(trans(sl.hv, cong_fn(λ (u: Value(tys)) => Some(u), e2))));
            let a1 = j(sym(var), λ q _ => Cell::Agrees(tys, strs, h, q.role, sl.c, sl.d), ag);
            let a2 = j(sym(sl.hc), λ o _ => Cell::Agrees(tys, strs, h, s.role(l), o.unwrap_or(Cell::none(tys)), sl.d), a1);
            let a3 = j(sym(sl.hd), λ o _ => Cell::Agrees(tys, strs, h, s.role(l), cs.nth(l).unwrap_or(Cell::none(tys)), o.unwrap_or(Dyn::none(tys))), a2);
            j(sym(st.left), λ y _ => Cell::Agrees(tys, strs, h, s.role(l), REnv::get(tys, REnv(cs, Nil), y), Env::get(tys, e, y)), a3)
        },
        λ x l hl => {
            let st = CSt::start_lvl(tys, strs, sig, x, l, hl);
            let sl = Slot::at(tys, sig.params, vs, ds, l, lv, ld2, st.right);
            let var = CSt::start_var(tys, strs, sig, l, sl.p, sl.hp, st.right);
            let pc: (sl.d.code = sl.p.code) = Dyn::coded_nth(tys, ds, sig.params, coded, l, sl.d, sl.p, sl.hd, sl.hp);
            let c1: (sl.d.code = (s.var(l)).code) = trans(pc, cong_fn(λ (q: CVar) => q.code, sym(var)));
            let c2 = j(sym(sl.hd), λ o _ => (o.unwrap_or(Dyn::none(tys))).code = (s.var(l)).code, c1);
            j(sym(st.left), λ y _ => (Env::get(tys, e, y)).code = (s.var(l)).code, c2)
        })
}

// The objects at the start are the arguments, by position; one passed by
// value has no root.
fn CSt::start_root(tys: Nat → Type, vs: List<Value(tys)>, o: Nat) → Option<Ref> {
    match vs.nth(o) { Some(v) => match v { Refer(r) => Some(r), Plain(_) => None }, None => None }
}

theorem CSt::start_root_at(tys: Nat → Type, vs: List<Value(tys)>, o: Nat, r: Ref, h: vs.nth(o) = Some(Refer(r))): CSt::start_root(tys, vs, o) = Some(r) {
    j(sym(h), λ q _ => (match q { Some(v) => match v { Refer(r2) => Some(r2), Plain(_) => None<Ref>() }, None => None<Ref>() }) = Some(r), refl)
}

theorem CSt::start_root_is(tys: Nat → Type, vs: List<Value(tys)>, o: Nat, r: Ref, h: CSt::start_root(tys, vs, o) = Some(r)): vs.nth(o) = Some(Refer(r)) {
    (match vs.nth(o) as λ q => (match q { Some(v) => match v { Refer(r2) => Some(r2), Plain(_) => None<Ref>() }, None => None<Ref>() }) = Some(r) → q = Some(Refer(r)) {
        None => λ no => absurd(no),
        Some(v) => match v {
            Refer(r2) => λ e => cong_fn(λ (q: Ref) => Some(Refer(q)), Option::some_inj(r2, r, e)),
            Plain(_) => λ no => absurd(no),
        },
    })(h)
}

// What a start role says of a reference, as `CSt::RefOk` reads it.
fn Role::RefAt(r0: Role, root: Nat → Option<Ref>, kv: Type, r: Ref) → Type { match r0 { KHold(o, _) => root(o) = Some(r), KView => kv, KPlain => False, KGone => True } }

theorem CSt::start_ref(tys: Nat → Type, strs: Strs(tys), p: Param, l: Nat, root: Nat → Option<Ref>, kv: Type, r: Ref, at: root(l) = Some(r),
    plain: p.mode = ByTake → Shape::plain(tys, strs, p.code) = True → False): Role::RefAt(CSt::role_of(tys, strs, p, l), root, kv, r)
{
    (match p.mode as λ md => p.mode = md →
            Role::RefAt(match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(l, AcOwn) }, ByRead => KHold(l, AcRead), ByWrite => KHold(l, AcWrite) }, root, kv, r) {
        ByRead => λ _ => at,
        ByWrite => λ _ => at,
        ByTake => λ em => (match Shape::plain(tys, strs, p.code) as λ b => Shape::plain(tys, strs, p.code) = b → Role::RefAt(match b { True => KPlain, False => KHold(l, AcOwn) }, root, kv, r) {
            True => λ ep => plain(em, ep),
            False => λ _ => at,
        })(refl),
    })(refl)
}

fn Role::held(r: Role) → Nat { match r { KHold(o, _) => o, KPlain => 0, KView => 0, KGone => 0 } }

// A start role that holds an object holds its own position's.
theorem CSt::role_of_hold(tys: Nat → Type, strs: Strs(tys), p: Param, l, o: Nat, a: Acc, h: CSt::role_of(tys, strs, p, l) = KHold(o, a)): o = l {
    (match p.mode as λ md => (match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(l, AcOwn) }, ByRead => KHold(l, AcRead), ByWrite => KHold(l, AcWrite) }) = KHold(o, a) → o = l {
        ByRead => λ e => sym(cong_fn(Role::held, e)),
        ByWrite => λ e => sym(cong_fn(Role::held, e)),
        ByTake => match Shape::plain(tys, strs, p.code) {
            True => λ no => absurd(no),
            False => λ e => sym(cong_fn(Role::held, e)),
        },
    })(h)
}

// A start role that owns its object is a taken parameter's, at a code that
// is not plain.
theorem CSt::role_of_own(tys: Nat → Type, strs: Strs(tys), p: Param, l, o: Nat, h: CSt::role_of(tys, strs, p, l) = KHold(o, AcOwn)):
    (p.mode = ByTake) ∧ (Shape::plain(tys, strs, p.code) = False)
{
    (match p.mode as λ md => p.mode = md → (match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(l, AcOwn) }, ByRead => KHold(l, AcRead), ByWrite => KHold(l, AcWrite) }) = KHold(o, AcOwn) →
            (md = ByTake) ∧ (Shape::plain(tys, strs, p.code) = False) {
        ByRead => λ _ e => absurd(cong_fn(λ (r: Role) => match r { KHold(_, a) => a.rank(), KPlain => 0, KView => 0, KGone => 0 }, e)),
        ByWrite => λ _ e => absurd(cong_fn(λ (r: Role) => match r { KHold(_, a) => a.rank(), KPlain => 0, KView => 0, KGone => 0 }, e)),
        ByTake => λ _ => (match Shape::plain(tys, strs, p.code) as λ b => Shape::plain(tys, strs, p.code) = b → (match b { True => KPlain, False => KHold(l, AcOwn) }) = KHold(o, AcOwn) →
                (ByTake = ByTake) ∧ (Shape::plain(tys, strs, p.code) = False) {
            True => λ _ no => absurd(no),
            False => λ ep _ => ⟨refl, ep⟩,
        })(refl),
    })(refl, h)
}

// A start role that holds an object to write is a parameter's that changes.
theorem CSt::role_of_changes(tys: Nat → Type, strs: Strs(tys), p: Param, l, o: Nat, a: Acc, h: CSt::role_of(tys, strs, p, l) = KHold(o, a), w: a.writes() = True): p.mode.changes() = True {
    (match p.mode as λ md => (match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(l, AcOwn) }, ByRead => KHold(l, AcRead), ByWrite => KHold(l, AcWrite) }) = KHold(o, a) →
            md.changes() = True {
        ByRead => λ e => absurd(trans(cong_fn(λ (r: Role) => match r { KHold(_, x) => x.writes(), KPlain => False, KView => False, KGone => False }, e), w)),
        ByWrite => λ _ => refl,
        ByTake => λ _ => refl,
    })(h)
}

theorem Value::lends_nth(tys: Nat → Type, vs: List<Value(tys)>): (ps: List<Param>) → (i: Nat) → (p: Param) → (r: Ref) → ps.nth(i) = Some(p) → p.mode.changes() = True →
    vs.nth(i) = Some(Refer(r)) → Value::lends(tys, ps, vs, r.b) = True
{
    match vs {
        Nil => λ ps i p r _ _ no => absurd(no),
        Cons(v, rest) => λ ps => match ps {
            Nil => λ i p r no => absurd(no),
            Cons(q, pr) => λ i => match i {
                Zero => λ p r ep ch e => {
                    let qp: (q = p) = Option::some_inj(q, p, ep);
                    let vr: (v = Refer(r)) = Option::some_inj(v, Refer(r), e);
                    let ch2: (q.mode.changes() = True) = j(sym(qp), λ u _ => u.mode.changes() = True, ch);
                    let hit: ((match v { Refer(r2) => r2.b.same(r.b), Plain(_) => False }) = True) =
                        j(sym(vr), λ u _ => (match u { Refer(r2) => r2.b.same(r.b), Plain(_) => False }) = True, r.b.same_self());
                    j(sym(Bool::and_of(q.mode.changes(), match v { Refer(r2) => r2.b.same(r.b), Plain(_) => False }, ch2, hit)),
                        λ bb _ => (bb || Value::lends(tys, pr, rest, r.b)) = True, refl)
                },
                Succ(k) => λ p r ep ch e => {
                    let ih = Value::lends_nth(tys, rest, pr, k, p, r, ep, ch, e);
                    match (q.mode.changes() && match v { Refer(r2) => r2.b.same(r.b), Plain(_) => False }) { True => refl, False => ih }
                },
            },
        },
    }
}

// A start variable's argument, where its cell refers.
theorem Slot::refers(tys: Nat → Type, strs: Strs(tys), sig: Sig, vs: List<Value(tys)>, ds: List<Dyn(tys)>, x: Var, l: Nat, r: Ref, st: (x = Arg(l)) ∧ (l < sig.params.len()),
    sl: Slot(tys, sig.params, vs, ds, Cell::args(tys, sig.params, vs), l), cr: (REnv::get(tys, REnv(Cell::args(tys, sig.params, vs), Nil), x)).v = Refer(r)): vs.nth(l) = Some(Refer(r))
{
    let cs = Cell::args(tys, sig.params, vs);
    let cr1: ((cs.nth(l).unwrap_or(Cell::none(tys))).v = Refer(r)) = j(st.left, λ y _ => (REnv::get(tys, REnv(cs, Nil), y)).v = Refer(r), cr);
    let cr2: (sl.c.v = Refer(r)) = j(sl.hc, λ o _ => (o.unwrap_or(Cell::none(tys))).v = Refer(r), cr1);
    trans(sl.hv, cong_fn(λ (u: Value(tys)) => Some(u), trans(sym(sl.cv), cr2)))
}

theorem CSt::start_changes(tys: Nat → Type, strs: Strs(tys), sig: Sig, o: Nat, h: (CSt::start(tys, strs, sig)).Changes(o)):
    Exists<Param>(λ p => (sig.params.nth(o) = Some(p)) ∧ (p.mode.changes() = True))
{
    match h {
        Inl(ex) => match ex {
            ⟨l, pl⟩ => match List::nth_present(sig.params, l, pl.left) {
                ⟨p, hp⟩ => match pl.right {
                    ⟨a, pa⟩ => {
                        let r1 = cong_fn(λ (q: CVar) => q.role, CSt::start_var(tys, strs, sig, l, p, hp, pl.left));
                        let hr: (CSt::role_of(tys, strs, p, l) = KHold(o, a)) = trans(sym(r1), pa.left);
                        let ol: (o = l) = CSt::role_of_hold(tys, strs, p, l, o, a, hr);
                        Exists(p, ⟨j(sym(ol), λ q _ => sig.params.nth(q) = Some(p), hp), CSt::role_of_changes(tys, strs, p, l, o, a, hr, pa.right)⟩)
                    },
                },
            },
        },
        Inr(ev) => match ev { ⟨en, pe⟩ => false_elim(pe.left) },
    }
}

// Where a heap's block is live, it is in the heap.
theorem Heap::obj_below(tys: Nat → Type, h: Heap(tys), b: Nat, o: Obj(tys), e: Heap::obj(tys, h, b) = Some(o)): b < h.len() {
    (match h.nth(b) as λ q => h.nth(b) = q → (match q { Some(bl) => match bl { Live(o2) => Some(o2), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }) = Some(o) → b < h.len() {
        None => λ _ no => absurd(no),
        Some(bl) => λ hn _ => List::nth_some_below(h, b, bl, hn),
    })(refl, e)
}

// A start cell its frame owns is a taken argument's.
theorem Cell::args_own(tys: Nat → Type, vs: List<Value(tys)>): (ps: List<Param>) → (i: Nat) → (c: Cell(tys)) → (Cell::args(tys, ps, vs)).nth(i) = Some(c) → c.own = True →
    (ps.nth(i).unwrap_or(Param(SWord(WNat), ByRead))).mode = ByTake
{
    match vs {
        Nil => λ ps i c no => absurd(no),
        Cons(v, rest) => λ ps i => match i {
            Zero => λ c e o => {
                let take = match (ps.nth(0).unwrap_or(Param(SWord(WNat), ByRead))).mode { ByTake => True, ByRead => False, ByWrite => False };
                let ce: (Cell(v, take && Value::refers(tys, v)) = c) = Option::some_inj(Cell(v, take && Value::refers(tys, v)), c, e);
                let o2: ((take && Value::refers(tys, v)) = True) = trans(cong_fn(λ (q: Cell(tys)) => q.own, ce), o);
                let t: (take = True) = (Bool::and_parts(take, Value::refers(tys, v), o2)).left;
                (match (ps.nth(0).unwrap_or(Param(SWord(WNat), ByRead))).mode as λ md => (match md { ByTake => True, ByRead => False, ByWrite => False }) = True → md = ByTake {
                    ByTake => λ _ => refl, ByRead => λ no => absurd(no), ByWrite => λ no => absurd(no),
                })(t)
            },
            Succ(k) => λ c e o => {
                let ih = Cell::args_own(tys, rest, ps.drop(1), k, c, e, o);
                j(List::nth_drop_add(ps, 1, k), λ q _ => (q.unwrap_or(Param(SWord(WNat), ByRead))).mode = ByTake, ih)
            },
        },
    }
}

theorem CSt::role_of_take(tys: Nat → Type, strs: Strs(tys), p: Param, l: Nat, take: p.mode = ByTake, ep: Shape::plain(tys, strs, p.code) = False): CSt::role_of(tys, strs, p, l) = KHold(l, AcOwn) {
    j(sym(take), λ md _ => (match md { ByTake => match Shape::plain(tys, strs, p.code) { True => KPlain, False => KHold(l, AcOwn) }, ByRead => KHold(l, AcRead), ByWrite => KHold(l, AcWrite) }) = KHold(l, AcOwn),
        j(sym(ep), λ b _ => (match b { True => KPlain, False => KHold(l, AcOwn) }) = KHold(l, AcOwn), refl))
}

// A start variable its frame owns holds its argument's whole block, which no
// other argument's is.
theorem Inv::start_own(tys: Nat → Type, strs: Strs(tys), sig: Sig, vs: List<Value(tys)>, h: Heap(tys), ds: List<Dyn(tys)>, ld: Lendable(tys, strs, sig.params, h, vs),
    x: Var, l: Nat, r: Ref, st: (x = Arg(l)) ∧ (l < sig.params.len()), sl: Slot(tys, sig.params, vs, ds, Cell::args(tys, sig.params, vs), l),
    co: (REnv::get(tys, REnv(Cell::args(tys, sig.params, vs), Nil), x)).own = True, cr: (REnv::get(tys, REnv(Cell::args(tys, sig.params, vs), Nil), x)).v = Refer(r)):
    Exists<Nat>(λ o => ((CSt::start(tys, strs, sig)).role(l) = KHold(o, AcOwn)) ∧ ((CSt::start_root(tys, vs, o) = Some(r)) ∧ ((r.sels = Nil) ∧
        ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → CSt::start_root(tys, vs, o2) = Some(r2) → ¬(r2.b = r.b)))))
{
    let cs = Cell::args(tys, sig.params, vs);
    let var = CSt::start_var(tys, strs, sig, l, sl.p, sl.hp, st.right);
    let hv = Slot::refers(tys, strs, sig, vs, ds, x, l, r, st, sl, cr);
    let co1: ((cs.nth(l).unwrap_or(Cell::none(tys))).own = True) = j(st.left, λ y _ => (REnv::get(tys, REnv(cs, Nil), y)).own = True, co);
    let co2: (sl.c.own = True) = j(sl.hc, λ q _ => (q.unwrap_or(Cell::none(tys))).own = True, co1);
    let take0 = Cell::args_own(tys, vs, sig.params, l, sl.c, sl.hc, co2);
    let take: (sl.p.mode = ByTake) = j(sl.hp, λ q _ => (q.unwrap_or(Param(SWord(WNat), ByRead))).mode = ByTake, take0);
    (match Shape::plain(tys, strs, sl.p.code) as λ b => Shape::plain(tys, strs, sl.p.code) = b →
            Exists<Nat>(λ o => ((CSt::start(tys, strs, sig)).role(l) = KHold(o, AcOwn)) ∧ ((CSt::start_root(tys, vs, o) = Some(r)) ∧ ((r.sels = Nil) ∧
                ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → CSt::start_root(tys, vs, o2) = Some(r2) → ¬(r2.b = r.b))))) {
        True => λ ep => false_elim(ld.plain(l, sl.p, sl.hp, take, ep, r)(hv)),
        False => λ ep => {
            let w = ld.whole(l, sl.p, sl.hp, take, ep, r, hv);
            let role: ((CSt::start(tys, strs, sig)).role(l) = KHold(l, AcOwn)) = trans(cong_fn(λ (q: CVar) => q.role, var), CSt::role_of_take(tys, strs, sl.p, l, take, ep));
            Exists(l, ⟨role, ⟨CSt::start_root_at(tys, vs, l, r, hv), ⟨w.left, λ o2 ne r2 h2 => w.right(o2, ne, r2, CSt::start_root_is(tys, vs, o2, r2, h2))⟩⟩⟩)
        },
    })(refl)
}

// Two start variables hold different objects.
theorem Inv::start_one(tys: Nat → Type, strs: Strs(tys), sig: Sig, l1, l2, o: Nat, a1, a2: Acc, b1: l1 < sig.params.len(), b2: l2 < sig.params.len(), ne: ¬(l1 = l2),
    h1: (CSt::start(tys, strs, sig)).role(l1) = KHold(o, a1), h2: (CSt::start(tys, strs, sig)).role(l2) = KHold(o, a2)): False
{
    match List::nth_present(sig.params, l1, b1) {
        ⟨p1, hp1⟩ => match List::nth_present(sig.params, l2, b2) {
            ⟨p2, hp2⟩ => {
                let r1 = cong_fn(λ (q: CVar) => q.role, CSt::start_var(tys, strs, sig, l1, p1, hp1, b1));
                let r2 = cong_fn(λ (q: CVar) => q.role, CSt::start_var(tys, strs, sig, l2, p2, hp2, b2));
                let e1: (o = l1) = CSt::role_of_hold(tys, strs, p1, l1, o, a1, trans(sym(r1), h1));
                let e2: (o = l2) = CSt::role_of_hold(tys, strs, p2, l2, o, a2, trans(sym(r2), h2));
                ne(trans(sym(e1), e2))
            },
        },
    }
}

// The invariant at a function's start, from `SafeAt`'s premises and the
// arguments' codes.
theorem Inv::start(tys: Nat → Type, strs: Strs(tys), sig: Sig, vs: List<Value(tys)>, h: Heap(tys), io: Io, ds: List<Dyn(tys)>, ra: Value::ReadAll(tys, strs, h, h.len(), vs, ds),
    coded: Dyn::Coded(tys, ds, sig.params), ld: Lendable(tys, strs, sig.params, h, vs)):
    Inv(tys, strs, CSt::start(tys, strs, sig), Env::start(tys, ds), Mach(h, REnv(Cell::args(tys, sig.params, vs), Nil), io), h, λ b => Value::lends(tys, sig.params, vs, b))
{
    let s = CSt::start(tys, strs, sig);
    let m = Mach(h, REnv(Cell::args(tys, sig.params, vs), Nil), io);
    let lv: (vs.len() = sig.params.len()) = ld.arity;
    let ld2: (ds.len() = sig.params.len()) = trans(sym(Value::read_all_len(tys, strs, h, h.len(), vs, ds, ra)), lv);
    let root = λ (o: Nat) => CSt::start_root(tys, vs, o);
    Inv(Sim::start(tys, strs, sig, vs, h, io, ds, ra, coded, ld), root,
        λ x l hl r cr => {
            let st = CSt::start_lvl(tys, strs, sig, x, l, hl);
            let sl = Slot::at(tys, sig.params, vs, ds, l, lv, ld2, st.right);
            let var = CSt::start_var(tys, strs, sig, l, sl.p, sl.hp, st.right);
            let hv = Slot::refers(tys, strs, sig, vs, ds, x, l, r, st, sl, cr);
            let kv = VEnt::Any(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(Mach::ixs(tys, strs, m), s.unsteps(en.reg))) = Some(r));
            j(sym(var), λ q _ => Role::RefAt(q.role, root, kv, r),
                CSt::start_ref(tys, strs, sl.p, l, root, kv, r, CSt::start_root_at(tys, vs, l, r, hv), λ em ep => ld.plain(l, sl.p, sl.hp, em, ep, r)(hv)))
        },
        λ o1 o2 ne ch r1 r2 h1 h2 => match CSt::start_changes(tys, strs, sig, o1, ch) {
            ⟨p, pp⟩ => ld.apart(o1, o2, ne, p, pp.left, pp.right, r1, r2, CSt::start_root_is(tys, vs, o1, r1, h1), CSt::start_root_is(tys, vs, o2, r2, h2)),
        },
        λ o r hr => match ld.live(o, r, CSt::start_root_is(tys, vs, o, r, hr)) { ⟨d1, pr⟩ => Heap::obj_below(tys, h, r.b, Obj(d1, Nil), pr.left) },
        λ o ch r hr => match CSt::start_changes(tys, strs, sig, o, ch) {
            ⟨p, pp⟩ => Inl(Value::lends_nth(tys, vs, sig.params, o, p, r, pp.left, pp.right, CSt::start_root_is(tys, vs, o, r, hr))),
        },
        λ x l hl _ co r cr => {
            let st = CSt::start_lvl(tys, strs, sig, x, l, hl);
            Inv::start_own(tys, strs, sig, vs, h, ds, ld, x, l, r, st, Slot::at(tys, sig.params, vs, ds, l, lv, ld2, st.right), co, cr)
        },
        λ l1 l2 o a1 a2 b1 b2 ne h1 h2 => Inv::start_one(tys, strs, sig, l1, l2, o, a1, a2, b1, b2, ne, h1, h2),
        λ l no => absurd(no),
        λ b _ _ => refl,
        omega(),
        λ o ge => {
            let ge2: (sig.params.len() <= o) = ge;
            j(sym(List::nth_past_end(vs, o, omega(ge2, lv))), λ q _ => (match q { Some(v) => match v { Refer(r) => Some(r), Plain(_) => None<Ref>() }, None => None<Ref>() }) = None<Ref>(), refl)
        },
        λ l o a b hr => {
            match List::nth_present(sig.params, l, b) {
                ⟨p, hp⟩ => {
                    let r1 = cong_fn(λ (q: CVar) => q.role, CSt::start_var(tys, strs, sig, l, p, hp, b));
                    let e1: (o = l) = CSt::role_of_hold(tys, strs, p, l, o, a, trans(sym(r1), hr));
                    j(sym(e1), λ q _ => q < sig.params.len(), b)
                },
            }
        },
        λ en no => false_elim(no),
        λ o r hr ob hb => match ld.live(o, r, CSt::start_root_is(tys, vs, o, r, hr)) {
            ⟨d1, pr⟩ => sym(cong_fn(λ (q: Obj(tys)) => q.holes, Option::some_inj(Obj(d1, Nil), ob, trans(sym(pr.left), hb)))),
        },
        λ en no => false_elim(no),
        λ e1 e2 no => false_elim(no),
        λ en no => false_elim(no),
        λ en no => false_elim(no),
        λ e1 e2 no => false_elim(no),
        λ en no => false_elim(no),
        λ e1 e2 no => false_elim(no))
}

// ---------------------------------------------------------------------------
// The words a region reads, kept: a level's index at a state, and a
// region's selections the same at two states whose words agree at its levels

// A level's index among the arguments, then the locals newest first: what
// `CSt::unatom` reads it at.
fn CSt::ix_of(self s: CSt, l: Nat) → Nat { match (l + 1).leb(s.na) { True => l, False => s.na + (s.nd - 1 - (l - s.na)) } }

theorem CSt::unatom_var(self s: CSt, l: Nat): s.unatom(Var(l)) = Var(s.ix_of(l)) {
    (match (l + 1).leb(s.na) as λ b => (match b as λ _ => Atom { True => Var(l), False => Var(s.na + (s.nd - 1 - (l - s.na))) }) = Var(match b as λ _ => Nat { True => l, False => s.na + (s.nd - 1 - (l - s.na)) }) {
        True => refl,
        False => refl,
    })
}

theorem List::nth_map_opt<A, B>(self xs: List<A>, f: A → B): (i: Nat) → xs.map(f).nth(i) = (xs.nth(i)).map(f) {
    match xs { Nil => λ i => refl, Cons(_, rest) => λ i => match i { Zero => refl, Succ(k) => rest.nth_map_opt(f, k) } }
}

theorem Nat::member_app_l(self l: Nat, xs: List<Nat>): (ys: List<Nat>) → l.member(xs) = True → l.member(xs ++ ys) = True {
    match xs {
        Nil => λ ys no => absurd(no),
        Cons(k, rest) => λ ys h => match k.same(l) { True => refl, False => l.member_app_l(rest, ys, h) },
    }
}

theorem Nat::member_app_r(self l: Nat, xs: List<Nat>): (ys: List<Nat>) → l.member(ys) = True → l.member(xs ++ ys) = True {
    match xs {
        Nil => λ ys h => h,
        Cons(k, rest) => λ ys h => match k.same(l) { True => refl, False => l.member_app_r(rest, ys, h) },
    }
}

theorem List::any_bit_mem<A>(self xs: List<A>, p: A → Bool, a: A): Mem(a, xs) → p(a) = True → xs.any_bit(p) = True {
    match xs {
        Nil => λ m _ => false_elim(m),
        Cons(b, rest) => λ m h => match m {
            Inl(e) => j(sym(j(e, λ y _ => p(y) = True, h)), λ c _ => (c || rest.any_bit(p)) = True, refl),
            Inr(m2) => match p(b) { True => refl, False => rest.any_bit_mem(p, a, m2, h) },
        },
    }
}

theorem CSt::pone_none(self s: CSt, none: s.pending() = False): s.POne() {
    λ e1 e2 m1 _ w1 _ => absurd(trans(sym(none), s.views.any_bit_mem(λ en => en.mode.writes() && !en.back, e1, m1, w1)))
}

// Two lists of words agree at the levels `ls`, each read at its own state.
fn CSt::WordsAt(s2: CSt, ws2: List<Ix>, s: CSt, ws: List<Ix>, ls: List<Nat>) → Type { (l: Nat) → l.member(ls) = True → ws2.nth(s2.ix_of(l)) = ws.nth(s.ix_of(l)) }

theorem CSt::atom_keep(s2: CSt, ws2: List<Ix>, s: CSt, ws: List<Ix>, a: Atom, w: CSt::WordsAt(s2, ws2, s, ws, a.lvls())):
    ((s2.unatom(a)).ix(ws2) = (s.unatom(a)).ix(ws)) ∧ ((s2.unatom(a)).val(Ix::nats(ws2)) = (s.unatom(a)).val(Ix::nats(ws)))
{
    (match a as λ b => CSt::WordsAt(s2, ws2, s, ws, b.lvls()) → ((s2.unatom(b)).ix(ws2) = (s.unatom(b)).ix(ws)) ∧ ((s2.unatom(b)).val(Ix::nats(ws2)) = (s.unatom(b)).val(Ix::nats(ws))) {
        Lit(_) => λ _ => ⟨refl, refl⟩,
        Var(l) => λ wl => {
            let at: (ws2.nth(s2.ix_of(l)) = ws.nth(s.ix_of(l))) = wl(l, j(sym(l.same_self()), λ c _ => (c || l.member(Nil)) = True, refl));
            let u2 = s2.unatom_var(l);
            let u1 = s.unatom_var(l);
            let eix: (Atom::ix(Var(s2.ix_of(l)), ws2) = Atom::ix(Var(s.ix_of(l)), ws)) = cong_fn(λ (o: Option<Ix>) => o.unwrap_or(INat(0)), at);
            let nv: (Atom::val(Var(s2.ix_of(l)), Ix::nats(ws2)) = Atom::val(Var(s.ix_of(l)), Ix::nats(ws))) =
                trans(cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), List::nth_map_opt(ws2, λ (i: Ix) => i.toNat(), s2.ix_of(l))),
                    trans(cong_fn(λ (o: Option<Ix>) => (o.map(λ (i: Ix) => i.toNat())).unwrap_or(0), at),
                        sym(cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), List::nth_map_opt(ws, λ (i: Ix) => i.toNat(), s.ix_of(l))))));
            ⟨j(sym(u1), λ q _ => (s2.unatom(Var(l))).ix(ws2) = Atom::ix(q, ws), j(sym(u2), λ q _ => Atom::ix(q, ws2) = Atom::ix(Var(s.ix_of(l)), ws), eix)),
             j(sym(u1), λ q _ => (s2.unatom(Var(l))).val(Ix::nats(ws2)) = Atom::val(q, Ix::nats(ws)), j(sym(u2), λ q _ => Atom::val(q, Ix::nats(ws2)) = Atom::val(Var(s.ix_of(l)), Ix::nats(ws)), nv))⟩
        },
    })(w)
}

theorem CSt::words_app(s2: CSt, ws2: List<Ix>, s: CSt, ws: List<Ix>, xs, ys: List<Nat>, w: CSt::WordsAt(s2, ws2, s, ws, xs ++ ys)):
    CSt::WordsAt(s2, ws2, s, ws, xs) ∧ CSt::WordsAt(s2, ws2, s, ws, ys)
{
    ⟨λ l m => w(l, l.member_app_l(xs, ys, m)), λ l m => w(l, l.member_app_r(xs, ys, m))⟩
}

theorem CSt::step_keep(s2: CSt, ws2: List<Ix>, s: CSt, ws: List<Ix>, a: Step, w: CSt::WordsAt(s2, ws2, s, ws, a.lvls())): (s2.unstep(a)).sel(ws2) = (s.unstep(a)).sel(ws) {
    (match a as λ b => CSt::WordsAt(s2, ws2, s, ws, b.lvls()) → (s2.unstep(b)).sel(ws2) = (s.unstep(b)).sel(ws) {
        SField(_) => λ _ => refl,
        SVariant(_) => λ _ => refl,
        SElem(i) => λ wi => cong_fn(λ (q: Ix) => OnSeq(SeqOne(q)), (CSt::atom_keep(s2, ws2, s, ws, i, wi)).left),
        SWindow(lo, n) => λ wb => {
            let sp = CSt::words_app(s2, ws2, s, ws, lo.lvls(), n.lvls(), wb);
            let a1 = (CSt::atom_keep(s2, ws2, s, ws, lo, sp.left)).left;
            let a2 = (CSt::atom_keep(s2, ws2, s, ws, n, sp.right)).left;
            trans(cong_fn(λ (q: Ix) => OnSeq(SeqRun(q, (s2.unatom(n)).ix(ws2))), a1), cong_fn(λ (q: Ix) => OnSeq(SeqRun((s.unatom(lo)).ix(ws), q)), a2))
        },
        SKey(i, g) => λ wb => {
            let sp = CSt::words_app(s2, ws2, s, ws, i.lvls(), g.lvls(), wb);
            let a1 = (CSt::atom_keep(s2, ws2, s, ws, i, sp.left)).right;
            let a2 = (CSt::atom_keep(s2, ws2, s, ws, g, sp.right)).right;
            trans(cong_fn(λ (q: Nat) => OnKey(Key(q, (s2.unatom(g)).val(Ix::nats(ws2)))), a1), cong_fn(λ (q: Nat) => OnKey(Key((s.unatom(i)).val(Ix::nats(ws)), q)), a2))
        },
    })(w)
}

theorem CSt::sels_keep(self xs: List<Step>, s2: CSt, ws2: List<Ix>, s: CSt, ws: List<Ix>): CSt::WordsAt(s2, ws2, s, ws, Steps::lvls(xs)) →
    Steps::sels(s2.unsteps(xs), ws2) = Steps::sels(s.unsteps(xs), ws)
{
    match xs {
        Nil => λ _ => refl,
        Cons(a, rest) => λ w => {
            let sp = CSt::words_app(s2, ws2, s, ws, a.lvls(), Steps::lvls(rest), w);
            trans(cong_fn(λ (q: Sel) => Cons(q, Steps::sels(s2.unsteps(rest), ws2)), CSt::step_keep(s2, ws2, s, ws, a, sp.left)),
                cong_fn(λ (t: List<Sel>) => Cons((s.unstep(a)).sel(ws), t), CSt::sels_keep(rest, s2, ws2, s, ws, sp.right)))
        },
    }
}

theorem VEnt::any_mono(self es: List<VEnt>, P, Q: VEnt → Type): ((en: VEnt) → Mem(en, es) → P(en) → Q(en)) → VEnt::Any(es, P) → VEnt::Any(es, Q) {
    match es {
        Nil => λ _ no => no,
        Cons(en, rest) => λ h a => match a {
            Inl(p) => Inl(h(en, Inl(refl), p)),
            Inr(q) => Inr(VEnt::any_mono(rest, P, Q, λ e m p => h(e, Inr(m), p), q)),
        },
    }
}

// A variable's reference as its role says, kept across a step that keeps
// its role and entries, the selections of each entry's region, and the
// roots of the objects it names.
theorem CSt::refok_keep(s, s2: CSt, root, root2: Nat → Option<Ref>, ws, ws2: List<Ix>, l: Nat, r: Ref, role: s2.role(l) = s.role(l), ents: s2.ents(l) = s.ents(l),
    rh: (o: Nat) → (a: Acc) → s.role(l) = KHold(o, a) → root2(o) = root(o),
    rv: (en: VEnt) → Mem(en, s.ents(l)) → root2(en.obj) = root(en.obj),
    regs: (en: VEnt) → Mem(en, s.ents(l)) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws),
    ok: s.RefOk(root, ws, l, r)): s2.RefOk(root2, ws2, l, r)
{
    let kv2 = VEnt::Any(s2.ents(l), λ en => (root2(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r));
    let kv = VEnt::Any(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r));
    let kv_to: (kv → kv2) = λ h => j(sym(ents), λ es _ => VEnt::Any(es, λ en => (root2(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r)),
        VEnt::any_mono(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r),
            λ en => (root2(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r),
            λ en m p => trans(cong_fn(λ (q: Option<Ref>) => q.map(λ r0 => Ref(r0.b, r0.sels ++ Steps::sels(s2.unsteps(en.reg), ws2))), rv(en, m)),
                trans(cong_fn(λ (ss: List<Sel>) => (root(en.obj)).map(λ r0 => Ref(r0.b, r0.sels ++ ss)), regs(en, m)), p)), h));
    let mid: (match s.role(l) { KHold(o, _) => root2(o) = Some(r), KView => kv2, KPlain => False, KGone => True }) =
        (match s.role(l) as λ q => s.role(l) = q → (match q { KHold(o, _) => root(o) = Some(r), KView => kv, KPlain => False, KGone => True }) →
                (match q { KHold(o, _) => root2(o) = Some(r), KView => kv2, KPlain => False, KGone => True }) {
            KHold(o, a) => λ eq h => trans(rh(o, a, eq), h), KView => λ _ => kv_to, KPlain => λ _ h => h, KGone => λ _ h => h,
        })(refl, ok);
    j(sym(role), λ q _ => match q { KHold(o, _) => root2(o) = Some(r), KView => kv2, KPlain => False, KGone => True }, mid)
}

// The levels a live region reads, as the invariant's `words` names them.
theorem Bool::or_true_right(self a: Bool): (a || True) = True { match a { True => refl, False => refl } }

theorem CSt::region_lvl(self s: CSt, en: VEnt, m: Mem(en, s.views), l: Nat, h: l.member(Steps::lvls(en.reg)) = True): s.in_regions(l) = True {
    s.views.any_bit_mem(λ e => l.member(Steps::lvls(e.reg)) || l.member(Steps::lvls(e.at)), en, m, j(sym(h), λ c _ => (c || l.member(Steps::lvls(en.at))) = True, refl))
}

theorem CSt::at_lvl(self s: CSt, en: VEnt, m: Mem(en, s.views), l: Nat, h: l.member(Steps::lvls(en.at)) = True): s.in_regions(l) = True {
    s.views.any_bit_mem(λ e => l.member(Steps::lvls(e.reg)) || l.member(Steps::lvls(e.at)), en, m,
        j(sym(h), λ c _ => (l.member(Steps::lvls(en.reg)) || c) = True, Bool::or_true_right(l.member(Steps::lvls(en.reg)))))
}

// ---------------------------------------------------------------------------
// Ancestry: the checker's chain of parents, the same at any fuel past the
// entry's level, and the same at two states with the same entries

// Two ancestries agreeing at each entry of a parent agree through it.
theorem VEnt::foldr_anc(self es: List<VEnt>, f, g: VEnt → List<Nat>): ((pe: VEnt) → Mem(pe, es) → f(pe) = g(pe)) →
    es.foldr(λ (pe: VEnt) (acc: List<Nat>) => f(pe) ++ acc, Nil) = es.foldr(λ (pe: VEnt) (acc: List<Nat>) => g(pe) ++ acc, Nil)
{
    match es {
        Nil => λ _ => refl,
        Cons(pe, rest) => λ h => trans(cong_fn(λ (t: List<Nat>) => t ++ rest.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil), h(pe, Inl(refl))),
            cong_fn(λ (t: List<Nat>) => g(pe) ++ t, VEnt::foldr_anc(rest, f, g, λ q m => h(q, Inr(m))))),
    }
}

theorem CSt::anc_more(self f: Nat, s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl): (e: VEnt) → Mem(e, s.views) → e.lvl <= f → s.anc_of(e, f) = s.anc_of(e, Succ(f)) {
    match f {
        Zero => λ e m le => false_elim(Nat::not_succ_le_zero(e.par, omega(lt(e, m), le))),
        Succ(f1) => λ e m le => match e.par.same(e.lvl) {
            True => refl,
            False => cong_fn(λ (t: List<Nat>) => Cons(e.par, t),
                VEnt::foldr_anc(s.ents(e.par), λ pe => s.anc_of(pe, f1), λ pe => s.anc_of(pe, Succ(f1)), λ pe mf => {
                    let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), mf);
                    let pl: (pe.lvl = e.par) = pe.lvl.same_sound(e.par, s.views.mem_filter_holds(pe, λ q => q.lvl.same(e.par), mf));
                    CSt::anc_more(f1, s, lt, pe, mv, omega(pl, lt(e, m), le))
                })),
        },
    }
}

theorem CSt::anc_plus(self k: Nat, s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl, e: VEnt, m: Mem(e, s.views), f: Nat, le: e.lvl <= f): s.anc_of(e, f + k) = s.anc_of(e, f) {
    match k { Zero => refl, Succ(k1) => trans(sym(CSt::anc_more(f + k1, s, lt, e, m, omega(le))), CSt::anc_plus(k1, s, lt, e, m, f, le)) }
}

theorem CSt::anc_views(self f: Nat, s, s2: CSt, vs: s2.views = s.views): (e: VEnt) → s2.anc_of(e, f) = s.anc_of(e, f) {
    match f {
        Zero => λ e => refl,
        Succ(f1) => λ e => match e.par.same(e.lvl) {
            True => refl,
            False => {
                let ents: (s2.ents(e.par) = s.ents(e.par)) = cong_fn(λ (q: List<VEnt>) => q.filter(λ x => x.lvl.same(e.par)), vs);
                cong_fn(λ (t: List<Nat>) => Cons(e.par, t),
                    trans(cong_fn(λ (q: List<VEnt>) => q.foldr(λ (pe: VEnt) (acc: List<Nat>) => s2.anc_of(pe, f1) ++ acc, Nil), ents),
                        VEnt::foldr_anc(s.ents(e.par), λ pe => s2.anc_of(pe, f1), λ pe => s.anc_of(pe, f1), λ pe _ => CSt::anc_views(f1, s, s2, vs, pe))))
            },
        },
    }
}

// What `excl` says, at a state and words.
fn CSt::Excl(tys: Nat → Type, strs: Strs(tys), s: CSt, ws: List<Ix>) → Type {
    (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, s.views) → e1.mode.writes() = True → e1.obj = e2.obj → ¬(e1.lvl = e2.lvl) →
        e1.lvl.member(s.anc_of(e2, s.na + s.nd)) = False → e2.lvl.member(s.anc_of(e1, s.na + s.nd)) = False →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(e2.reg), ws))
}

// `excl` kept across a step that keeps the entries, adds levels, and keeps
// each region's selections.
theorem CSt::excl_keep(tys: Nat → Type, strs: Strs(tys), s, s2: CSt, ws, ws2: List<Ix>, vs: s2.views = s.views, grow: s.na + s.nd <= s2.na + s2.nd,
    lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl, lv: (en: VEnt) → Mem(en, s.views) → en.lvl < s.na + s.nd,
    regs: (en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws),
    ex: CSt::Excl(tys, strs, s, ws)): CSt::Excl(tys, strs, s2, ws2)
{
    λ e1 e2 m1 m2 w eo ne a1 a2 => {
        let n1: Mem(e1, s.views) = j(vs, λ q _ => Mem(e1, q), m1);
        let n2: Mem(e2, s.views) = j(vs, λ q _ => Mem(e2, q), m2);
        let k = s2.na + s2.nd - (s.na + s.nd);
        let fk: (s2.na + s2.nd = s.na + s.nd + k) = omega(grow);
        let at = λ (e: VEnt) (me: Mem(e, s.views)) => trans(CSt::anc_views(s2.na + s2.nd, s, s2, vs, e),
            j(sym(fk), λ q _ => s.anc_of(e, q) = s.anc_of(e, s.na + s.nd), CSt::anc_plus(k, s, lt, e, me, s.na + s.nd, omega(lv(e, me)))));
        let b1: (e1.lvl.member(s.anc_of(e2, s.na + s.nd)) = False) = j(at(e2, n2), λ q _ => e1.lvl.member(q) = False, a1);
        let b2: (e2.lvl.member(s.anc_of(e1, s.na + s.nd)) = False) = j(at(e1, n1), λ q _ => e2.lvl.member(q) = False, a2);
        let ap = ex(e1, e2, n1, n2, w, eo, ne, b1, b2);
        j(sym(regs(e2, n2)), λ q _ => Sel::Apart(tys, strs, Steps::sels(s2.unsteps(e1.reg), ws2), q),
            j(sym(regs(e1, n1)), λ q _ => Sel::Apart(tys, strs, q, Steps::sels(s.unsteps(e2.reg), ws)), ap))
    }
}

// A live entry's parent, kept across a step that keeps the parent's role
// and entries.
theorem CSt::parent_keep(s, s2: CSt, en: VEnt, role: s2.role(en.par) = s.role(en.par), ents: s2.ents(en.par) = s.ents(en.par), p: s.Parent(en)): s2.Parent(en) {
    let p2: (match s.role(en.par) { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s2.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
            KPlain => False, KGone => False }) = j(sym(ents), λ q _ => match s.role(en.par) { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
                KView => VEnt::Any(q, λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False }, p);
    j(sym(role), λ r _ => match r { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s2.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
        KPlain => False, KGone => False }, p2)
}

// ---------------------------------------------------------------------------
// A binding: the variables after a push, the words after it

fn Var::up(self x: Var) → Var { match x { Arg(i) => Arg(i), Loc(k) => Loc(k + 1) } }

theorem REnv::get_push_up(tys: Nat → Type, e: REnv(tys), c: Cell(tys), x: Var): REnv::get(tys, REnv::push(tys, e, c), x.up()) = REnv::get(tys, e, x) {
    match x { Arg(_) => refl, Loc(_) => refl }
}

// A variable after a push is the new one, or one from before at its level.
theorem CSt::push_lvl(self s: CSt, c: CVar, x: Var, l: Nat, h: (s.push(c)).lvl(x) = Some(l)):
    ((x = Loc(0)) ∧ (l = s.na + s.nd)) ∨ Exists<Var>(λ x0 => (x = x0.up()) ∧ (s.lvl(x0) = Some(l)))
{
    (match x as λ y => (s.push(c)).lvl(y) = Some(l) → ((y = Loc(0)) ∧ (l = s.na + s.nd)) ∨ Exists<Var>(λ x0 => (y = x0.up()) ∧ (s.lvl(x0) = Some(l))) {
        Arg(i) => λ h2 => Inr(Exists(Arg(i), ⟨refl, h2⟩)),
        Loc(k) => match k {
            Zero => λ h2 => {
                let raw: (s.na + (s.nd + 1) - 1 - 0 = l) = Option::some_inj(s.na + (s.nd + 1) - 1 - 0, l, Bool::then_some((0 + 1).leb(s.nd + 1), Some(s.na + (s.nd + 1) - 1 - 0), l, h2).right);
                Inl(⟨refl, omega(raw)⟩)
            },
            Succ(k1) => λ h2 => Inr(Exists(Loc(k1), ⟨refl, trans(sym(s.lvl_push_loc(c, k1)), h2)⟩)),
        },
    })(h)
}

// `Uni` after a push: an old entry's variables moved up one, a new entry's
// variable the pushed one.
theorem CSt::uni_push(tys: Nat → Type, s: CSt, cv: CVar, env: REnv(tys), c: Cell(tys), u: CSt::Uni(tys, s, env),
    lt: (en: VEnt) → Mem(en, s.views) → en.par < s.na + s.nd,
    new: (en: VEnt) → Mem(en, s.views) → en.lvl = s.na + s.nd → (y0: Var) → s.lvl(y0) = Some(en.par) → Value::refers(tys, c.v) = Value::refers(tys, (REnv::get(tys, env, y0)).v)):
    CSt::Uni(tys, s.push(cv), REnv::push(tys, env, c))
{
    let env2 = REnv::push(tys, env, c);
    λ en mem x y hx hy => match s.push_lvl(cv, y, en.par, hy) {
        Inl(py) => false_elim(Nat::lt_irrefl(en.par, omega(lt(en, mem), py.right))),
        Inr(ey) => match ey {
            ⟨y0, py⟩ => {
                let gy: (Value::refers(tys, (REnv::get(tys, env2, y)).v) = Value::refers(tys, (REnv::get(tys, env, y0)).v)) =
                    j(sym(py.left), λ z _ => Value::refers(tys, (REnv::get(tys, env2, z)).v) = Value::refers(tys, (REnv::get(tys, env, y0)).v),
                        cong_fn(λ (q: Cell(tys)) => Value::refers(tys, q.v), REnv::get_push_up(tys, env, c, y0)));
                match s.push_lvl(cv, x, en.lvl, hx) {
                    Inl(px) => trans(j(sym(px.left), λ z _ => Value::refers(tys, (REnv::get(tys, env2, z)).v) = Value::refers(tys, c.v), refl),
                        trans(new(en, mem, px.right, y0, py.right), sym(gy))),
                    Inr(ex) => match ex {
                        ⟨x0, px⟩ => trans(j(sym(px.left), λ z _ => Value::refers(tys, (REnv::get(tys, env2, z)).v) = Value::refers(tys, (REnv::get(tys, env, x0)).v),
                                cong_fn(λ (q: Cell(tys)) => Value::refers(tys, q.v), REnv::get_push_up(tys, env, c, x0))),
                            trans(u(en, mem, x0, y0, px.right, py.right), sym(gy))),
                    },
                }
            },
        },
    }
}

theorem List::nth_map_insert<A, B>(self xs: List<A>, c: A, ys: List<A>, f: A → B, k: Nat): ((xs ++ Cons(c, ys)).map(f)).nth(k + 1 + xs.len()) = ((xs ++ ys).map(f)).nth(k + xs.len()) {
    match xs { Nil => refl, Cons(_, rest) => rest.nth_map_insert(c, ys, f, k) }
}

theorem List::nth_map_before<A, B>(self xs: List<A>, c: A, ys: List<A>, f: A → B): (i: Nat) → i < xs.len() → ((xs ++ Cons(c, ys)).map(f)).nth(i) = ((xs ++ ys).map(f)).nth(i) {
    match xs {
        Nil => λ i no => false_elim(Nat::not_succ_le_zero(i, no)),
        Cons(_, rest) => λ i => match i { Zero => λ _ => refl, Succ(k) => λ lt => rest.nth_map_before(c, ys, f, k, omega(lt)) },
    }
}

// A push leaves each earlier level's word where its index now is.
theorem CSt::ixs_push(tys: Nat → Type, strs: Strs(tys), s: CSt, cv: CVar, m: Mach(tys), c: Cell(tys), margs: (m.env).args.len() = s.na, l: Nat, below: l < s.na + s.nd):
    (Mach::ixs(tys, strs, Mach::push(tys, m, c))).nth((s.push(cv)).ix_of(l)) = (Mach::ixs(tys, strs, m)).nth(s.ix_of(l))
{
    let f = λ (x: Cell(tys)) => Dyn::ix(tys, (Value::get(tys, strs, m.heap, x.v, Nil)).unwrap_or(Dyn::none(tys)));
    let a = (m.env).args;
    let ls = (m.env).locs;
    (match (l + 1).leb(s.na) as λ b => (l + 1).leb(s.na) = b →
            ((a ++ Cons(c, ls)).map(f)).nth(match b { True => l, False => s.na + (s.nd + 1 - 1 - (l - s.na)) }) = ((a ++ ls).map(f)).nth(match b { True => l, False => s.na + (s.nd - 1 - (l - s.na)) }) {
        True => λ eb => a.nth_map_before(c, ls, f, l, omega(Nat::le_of_leb(l + 1, s.na, eb), margs)),
        False => λ eb => {
            let ge: ¬(l + 1 <= s.na) = λ le => absurd(trans(sym(eb), Nat::leb_true(l + 1, s.na, le)));
            let k = s.nd - 1 - (l - s.na);
            let i2: (s.na + (s.nd + 1 - 1 - (l - s.na)) = k + 1 + a.len()) = omega(ge, below, margs);
            let i1: (s.na + (s.nd - 1 - (l - s.na)) = k + a.len()) = omega(ge, below, margs);
            j(sym(i1), λ q _ => ((a ++ Cons(c, ls)).map(f)).nth(s.na + (s.nd + 1 - 1 - (l - s.na))) = ((a ++ ls).map(f)).nth(q),
                j(sym(i2), λ q _ => ((a ++ Cons(c, ls)).map(f)).nth(q) = ((a ++ ls).map(f)).nth(k + a.len()), a.nth_map_insert(c, ls, f, k)))
        },
    })(refl)
}

// A level below the next after a push is one from before, or the new one.
theorem Nat::below_succ(l, n: Nat, h: l < n + 1): (l < n) ∨ (l = n) { match Nat::lt_or_ge(l, n) { Inl(a) => Inl(a), Inr(b) => Inr(omega(h, b)) } }

// A push of a variable that holds nothing to write keeps what may change.
theorem CSt::changes_push(self s: CSt, cv: CVar, o: Nat, nohold: (a: Acc) → cv.role = KHold(o, a) → a.writes() = True → False, h: (s.push(cv)).Changes(o)): s.Changes(o) {
    match h {
        Inl(ex) => match ex {
            ⟨l, pl⟩ => match pl.right {
                ⟨a, pa⟩ => match Nat::below_succ(l, s.na + s.nd, pl.left) {
                    Inr(at) => false_elim(nohold(a, trans(sym(j(sym(at), λ q _ => (s.push(cv)).role(q) = cv.role, cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv)))), pa.left), pa.right)),
                    Inl(c1) => Inl(Exists(l, ⟨c1, Exists(a, ⟨trans(sym(s.role_push(cv, l, c1)), pa.left), pa.right⟩)⟩)),
                },
            },
        },
        Inr(ev) => Inr(ev),
    }
}

// `cfit` and `sib` where only the words may have moved: kept where every
// entry's place selects alike.
theorem CSt::cfit_ws(tys: Nat → Type, strs: Strs(tys), s: CSt, env: REnv(tys), ws, ws2: List<Ix>,
    ats: (en: VEnt) → Mem(en, s.views) → Steps::sels(s.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws), cf: CSt::CFit(tys, strs, s, env, ws)): CSt::CFit(tys, strs, s, env, ws2)
{
    λ en mem y z hy hz dp dc cy cz => j(sym(ats(en, mem)), λ q _ => CSt::CFitAt(tys, strs, q, dp, dc), cf(en, mem, y, z, hy, hz, dp, dc, cy, cz))
}

theorem CSt::sib_keep(tys: Nat → Type, strs: Strs(tys), s, s2: CSt, ws, ws2: List<Ix>, vs: s2.views = s.views,
    ats: (en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws), sb: CSt::Sib(tys, strs, s, ws)): CSt::Sib(tys, strs, s2, ws2)
{
    λ e1 e2 m1 m2 w1 pp ne => {
        let n1: Mem(e1, s.views) = j(vs, λ q _ => Mem(e1, q), m1);
        let n2: Mem(e2, s.views) = j(vs, λ q _ => Mem(e2, q), m2);
        j(sym(ats(e2, n2)), λ q _ => Sel::Apart(tys, strs, Steps::sels(s2.unsteps(e1.at), ws2), q),
            j(sym(ats(e1, n1)), λ q _ => Sel::Apart(tys, strs, q, Steps::sels(s.unsteps(e2.at), ws)), sb(e1, e2, n1, n2, w1, pp, ne)))
    }
}

// `cfit` after a push: an old entry's variables moved up one, a new entry's
// own variable the pushed one.
theorem CSt::cfit_push(tys: Nat → Type, strs: Strs(tys), s: CSt, cv: CVar, env: REnv(tys), c: Cell(tys), ws, ws2: List<Ix>, cf: CSt::CFit(tys, strs, s, env, ws),
    pb: (en: VEnt) → Mem(en, s.views) → en.par < s.na + s.nd,
    new: (en: VEnt) → Mem(en, s.views) → en.lvl = s.na + s.nd → (y0: Var) → s.lvl(y0) = Some(en.par) → (dp, dc: Dyn(tys)) → (REnv::get(tys, env, y0)).v = level2::Plain(dp) →
        c.v = level2::Plain(dc) → CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), ws), dp, dc),
    ats: (en: VEnt) → Mem(en, s.views) → Steps::sels((s.push(cv)).unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)):
    CSt::CFit(tys, strs, s.push(cv), REnv::push(tys, env, c), ws2)
{
    let env2 = REnv::push(tys, env, c);
    λ en mem y z hy hz dp dc cy cz => match s.push_lvl(cv, y, en.par, hy) {
        Inl(py) => false_elim(Nat::lt_irrefl(en.par, omega(pb(en, mem), py.right))),
        Inr(ey) => match ey {
            ⟨y0, py⟩ => {
                let cy0: ((REnv::get(tys, env, y0)).v = level2::Plain(dp)) =
                    trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, env, c, y0))), j(py.left, λ u _ => (REnv::get(tys, env2, u)).v = level2::Plain(dp), cy));
                j(sym(ats(en, mem)), λ q _ => CSt::CFitAt(tys, strs, q, dp, dc), match s.push_lvl(cv, z, en.lvl, hz) {
                    Inl(pz) => new(en, mem, pz.right, y0, py.right, dp, dc, cy0, j(pz.left, λ u _ => (REnv::get(tys, env2, u)).v = level2::Plain(dc), cz)),
                    Inr(ez) => match ez {
                        ⟨z0, qz⟩ => cf(en, mem, y0, z0, py.right, qz.right, dp, dc, cy0,
                            trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, env, c, z0))), j(qz.left, λ u _ => (REnv::get(tys, env2, u)).v = level2::Plain(dc), cz))),
                    },
                })
            },
        },
    }
}

// The invariant after a binding of a plain value, nothing pending (its
// cell's ownership flag is any: a plain value owns no block).
theorem Inv::push_plain(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, code: Shape, d: Dyn(tys), ow: Bool, okc: d.code = code):
    Inv(tys, strs, s.push(CVar(code, KPlain)), Env::push(tys, e, d), Mach::push(tys, m, Cell(level2::Plain(d), ow)), h0, lent)
{
    let cv = CVar(code, KPlain);
    let s2 = s.push(cv);
    let c: Cell(tys) = Cell(level2::Plain(d), ow);
    let m2 = Mach::push(tys, m, c);
    let sim0 = Inv::sim_now(tys, strs, inv, none);
    let sim1: Sim(tys, strs, s2, Env::push(tys, e, d), m2) = Sim::push(tys, strs, sim0, cv, c, d, refl, okc);
    let sim2 = j(sym(s2.patched_none(tys, strs, Env::push(tys, e, d), m2, none)), λ q _ => Sim(tys, strs, s2, q, m2), sim1);
    let ws = Mach::ixs(tys, strs, m);
    let ws2 = Mach::ixs(tys, strs, m2);
    let ch: ((o: Nat) → s2.Changes(o) → s.Changes(o)) = λ o h1 => s.changes_push(cv, o, λ a e _ => absurd(e), h1);
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws)) = λ en mem =>
        CSt::sels_keep(en.reg, s2, ws2, s, ws, λ l2 m2l => CSt::ixs_push(tys, strs, s, cv, m, c, sim0.margs, l2, (inv.words(l2, s.region_lvl(en, mem, l2, m2l))).left));
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)) = λ en mem =>
        CSt::sels_keep(en.at, s2, ws2, s, ws, λ l2 m2l => CSt::ixs_push(tys, strs, s, cv, m, c, sim0.margs, l2, (inv.words(l2, s.at_lvl(en, mem, l2, m2l))).left));
    Inv(sim2, inv.root,
        λ x l h r cr => match s.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let bad: (level2::Plain(d) = Refer(r)) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr);
                absurd(bad)
            },
            Inr(⟨x0, p⟩) => {
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, m.env, c, x0))), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let below = s.lvl_below(x0, l, p.right);
                CSt::refok_keep(s, s2, inv.root, inv.root, ws, ws2, l, r, s.role_push(cv, l, below), refl, λ _ _ _ => refl, λ _ _ => refl,
                    λ en mem => regs(en, s.views.mem_filter(en, λ q => q.lvl.same(l), mem)),
                    inv.refs(x0, l, p.right, r, cr0))
            },
        },
        λ o1 o2 ne h1 => inv.apart(o1, o2, ne, ch(o1, h1)),
        inv.inheap,
        λ o h1 => inv.owned(o, ch(o, h1)),
        λ x l h lv co r cr => match s.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let bad: (level2::Plain(d) = Refer(r)) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr);
                absurd(bad)
            },
            Inr(⟨x0, p⟩) => {
                let get0 = REnv::get_push_up(tys, m.env, c, x0);
                let co0: ((REnv::get(tys, m.env, x0)).own = True) = trans(cong_fn(λ (q: Cell(tys)) => q.own, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).own = True, co));
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let rp = s.role_push(cv, l, s.lvl_below(x0, l, p.right));
                let lv0: ¬((s.role(l)).same(KGone) = True) = λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), rp), g));
                match inv.own(x0, l, p.right, lv0, co0, r, cr0) { ⟨o, po⟩ => Exists(o, ⟨trans(rp, po.left), po.right⟩) }
            },
        },
        λ l1 l2 o a1 a2 b1 b2 ne h1 h2 => match Nat::below_succ(l1, s.na + s.nd, b1) {
            Inr(at) => absurd(trans(sym(h1), j(sym(at), λ q _ => s2.role(q) = KPlain, cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv))))),
            Inl(c1) => match Nat::below_succ(l2, s.na + s.nd, b2) {
                Inr(at) => absurd(trans(sym(h2), j(sym(at), λ q _ => s2.role(q) = KPlain, cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv))))),
                Inl(c2) => inv.one(l1, l2, o, a1, a2, c1, c2, ne, trans(sym(s.role_push(cv, l1, c1)), h1), trans(sym(s.role_push(cv, l2, c2)), h2)),
            },
        },
        λ l w => {
            let ww = inv.words(l, w);
            ⟨omega(ww.left), trans(cong_fn(λ (q: Role) => q.plain(), s.role_push(cv, l, ww.left)), ww.right)⟩
        },
        inv.frame,
        inv.grows,
        inv.young,
        λ l o a b hr => match Nat::below_succ(l, s.na + s.nd, b) {
            Inr(at) => absurd(trans(sym(hr), j(sym(at), λ q _ => s2.role(q) = KPlain, cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv))))),
            Inl(c1) => inv.held(l, o, a, c1, trans(sym(s.role_push(cv, l, c1)), hr)),
        },
        λ en mem => {
            let vv = inv.vents(en, mem);
            ⟨vv.left, ⟨omega(vv.right.left), trans(s.role_push(cv, en.lvl, vv.right.left), vv.right.right)⟩⟩
        },
        inv.bare,
        λ en mem => {
            let cc = inv.chain(en, mem);
            ⟨cc.left, CSt::parent_keep(s, s2, en, s.role_push(cv, en.par, omega(cc.left, (inv.vents(en, mem)).right.left)), refl, cc.right)⟩
        },
        CSt::excl_keep(tys, strs, s, s2, ws, ws2, refl, omega(), λ en mem => (inv.chain(en, mem)).left, λ en mem => (inv.vents(en, mem)).right.left, regs, inv.excl),
        λ en mem w => CSt::wpar_keep(s, s2, en, s.role_push(cv, en.par, omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left)), refl, inv.wpar(en, mem, w)),
        CSt::uni_push(tys, s, cv, m.env, c, inv.uni, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at)))), inv.pone,
        CSt::cfit_push(tys, strs, s, cv, m.env, c, ws, ws2, inv.cfit, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at))), ats),
        CSt::sib_keep(tys, strs, s, s2, ws, ws2, refl, ats, inv.sib))
}

// ---------------------------------------------------------------------------
// Stages: each statement, run, continues at the machine at which the
// invariant holds of the checker's next state and the meaning's next
// environment

record Stepped(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), st: Stmt, s2: CSt, e2: Env(tys), m: Mach(tys), h0: Heap(tys), lent: Nat → Bool) {
    m2: Mach(tys),
    runs: Stmt::Continues(tys, strs, fns, call, st, m, m2),
    inv: Inv(tys, strs, s2, e2, m2, h0, lent),
}

theorem Stmt::stage_lit(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, w: Width, n: Nat):
    Stepped(tys, strs, fns, call, Lit(w, n), s.push(CVar(SWord(w), KPlain)), Env::push(tys, e, Dyn(SWord(w), Width::of_nat(w, n))), m, h0, lent)
{
    let d: Dyn(tys) = Dyn(SWord(w), Width::of_nat(w, n));
    Stepped(Mach::push(tys, m, Cell::plain(tys, d)), λ k => refl, Inv::push_plain(tys, strs, inv, none, SWord(w), d, False, refl))
}

theorem Stmt::stage_op(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, op: Prim, a, b: Var,
    ga, gb: Got, oka: s.read_var(tys, strs, a) = Some(ga), okb: s.read_var(tys, strs, b) = Some(gb), isw: ga.code.is_word() = True):
    Stepped(tys, strs, fns, call, Op(op, a, b), s.push(CVar(ga.code, KPlain)),
        Env::push(tys, e, Dyn::words<Dyn(tys)>(tys, Env::get(tys, e, a), Env::get(tys, e, b), λ wd x y => Dyn(SWord(wd), Width::op(wd, op, x, y)))), m, h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let d = Dyn::words<Dyn(tys)>(tys, Env::get(tys, e, a), Env::get(tys, e, b), λ wd x y => Dyn(SWord(wd), Width::op(wd, op, x, y)));
    let va: (Mach::val(tys, strs, m, a) = Some(Env::get(tys, e, a))) = Sim::read_val(tys, strs, sim, a, ga, oka);
    let vb: (Mach::val(tys, strs, m, b) = Some(Env::get(tys, e, b))) = Sim::read_val(tys, strs, sim, b, gb, okb);
    Stepped(Mach::push(tys, m, Cell::plain(tys, d)),
        λ k => Stmt::op_runs(tys, strs, fns, call, m, op, a, b, Env::get(tys, e, a), Env::get(tys, e, b), va, vb, k),
        Inv::push_plain(tys, strs, inv, none, ga.code, d, False, Dyn::words_code(tys, Env::get(tys, e, a), Env::get(tys, e, b), op, ga.code, Sim::read_code(tys, strs, sim, a, ga, oka), isw)))
}

theorem Stmt::stage_read(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, Read(p), s.push(CVar(g.code, KPlain)), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let sim = Inv::sim_now(tys, cx.strs, inv, none);
    let d = p.val(tys, cx.strs, e);
    let at = Sim::place(tys, cx, sl, sim, p, g, ok, tail, res);
    Stepped(Mach::push(tys, m, Cell::plain(tys, d)),
        λ k => j(sym(at), λ o _ => (match o { Some(x) => k(Mach::push(tys, m, Cell::plain(tys, x))), None => Stuck }) = k(Mach::push(tys, m, Cell::plain(tys, d))), refl),
        Inv::push_plain(tys, cx.strs, inv, none, g.code, d, False, Sim::place_code(tys, cx.strs, sim, p, g, ok)))
}

// ---------------------------------------------------------------------------
// A heap one block longer: the blocks the invariant reads are as they were

theorem List::nth_snoc_below<A>(self xs: List<A>, x: A): (i: Nat) → i < xs.len() → (xs ++ [x]).nth(i) = xs.nth(i) {
    match xs {
        Nil => λ i no => false_elim(Nat::not_succ_le_zero(i, no)),
        Cons(_, rest) => λ i => match i { Zero => λ _ => refl, Succ(k) => λ lt => rest.nth_snoc_below(x, k, omega(lt)) },
    }
}

theorem List::nth_snoc_at<A>(self xs: List<A>, x: A): (xs ++ [x]).nth(xs.len()) = Some(x) { match xs { Nil => refl, Cons(_, rest) => rest.nth_snoc_at(x) } }

theorem List::len_snoc<A>(self xs: List<A>, x: A): (xs ++ [x]).len() = xs.len() + 1 { match xs { Nil => refl, Cons(_, rest) => Nat::cong_succ(rest.len_snoc(x)) } }

theorem Heap::obj_grow(tys: Nat → Type, h: Heap(tys), x: Block(tys), b: Nat, below: b < h.len()): Heap::obj(tys, h ++ [x], b) = Heap::obj(tys, h, b) {
    cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }, h.nth_snoc_below(x, b, below))
}

theorem Heap::obj_new(tys: Nat → Type, h: Heap(tys), o: Obj(tys)): Heap::obj(tys, h ++ [Live(o)], h.len()) = Some(o) {
    cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o2) => Some(o2), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }, h.nth_snoc_at(Live(o)))
}

// An object with no holes reads as its value, whatever the heap and fuel.
theorem Obj::read_bare(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), fuel: Nat, o: Obj(tys), hn: o.holes = Nil): Obj::read(tys, strs, h, fuel, o) = Some(o.val) {
    j(sym(hn), λ hs _ => Obj::fill(tys, strs, h, fuel, o.val, hs) = Some(o.val), Obj::fill_nil(tys, strs, h, fuel, o.val))
}

theorem Heap::val_grow(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), x: Block(tys), b: Nat, below: b < h.len(),
    bare: (ob: Obj(tys)) → Heap::obj(tys, h, b) = Some(ob) → ob.holes = Nil): Heap::val(tys, strs, h ++ [x], b) = Heap::val(tys, strs, h, b)
{
    let h2 = h ++ [x];
    let lhs: (Heap::val(tys, strs, h2, b) = (match Heap::obj(tys, h, b) { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() })) =
        cong_fn(λ (q: Option<Obj(tys)>) => match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }, Heap::obj_grow(tys, h, x, b, below));
    trans(lhs, (match Heap::obj(tys, h, b) as λ q => Heap::obj(tys, h, b) = q →
            (match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }) = (match q { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None<Dyn(tys)>() }) {
        None => λ _ => refl,
        Some(o) => λ e1 => trans(Obj::read_bare(tys, strs, h2, h2.len(), o, bare(o, e1)), sym(Obj::read_bare(tys, strs, h, h.len(), o, bare(o, e1)))),
    })(refl))
}

// A reference the invariant knows is into some object's root's block.
fn Ref::InRoot(root: Nat → Option<Ref>, b: Nat) → Type { Exists<Nat>(λ o => Exists<Ref>(λ r0 => (root(o) = Some(r0)) ∧ (r0.b = b))) }

theorem VEnt::any_exists(self es: List<VEnt>, root: Nat → Option<Ref>, ws: List<Ix>, s: CSt, r: Ref):
    VEnt::Any(es, λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)) → Ref::InRoot(root, r.b)
{
    match es {
        Nil => λ no => false_elim(no),
        Cons(en, rest) => λ a => match a {
            Inl(p) => match Option::map_some_inv(root(en.obj), λ r0 => r0.narrow(ws, s.unsteps(en.reg)), r, p) {
                ⟨r0, pr⟩ => Exists(en.obj, Exists(r0, ⟨pr.left, cong_fn(λ (q: Ref) => q.b, pr.right)⟩)),
            },
            Inr(q) => VEnt::any_exists(rest, root, ws, s, r, q),
        },
    }
}

theorem CSt::refok_block(self s: CSt, root: Nat → Option<Ref>, ws: List<Ix>, l: Nat, r: Ref, ok: s.RefOk(root, ws, l, r), live: ¬((s.role(l)).same(KGone) = True)): Ref::InRoot(root, r.b) {
    (match s.role(l) as λ q => (match q { KHold(o, _) => root(o) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
            KPlain => False, KGone => True }) → ¬(q.same(KGone) = True) → Ref::InRoot(root, r.b) {
        KHold(o, _) => λ h _ => Exists(o, Exists(r, ⟨h, refl⟩)),
        KView => λ h _ => VEnt::any_exists(s.ents(l), root, ws, s, r, h),
        KPlain => λ no _ => false_elim(no),
        KGone => λ _ no => false_elim(no(refl)),
    })(ok, live)
}

// A cell that agrees, read on a heap one block longer, where its block is
// some root's.
theorem Cell::agrees_grow(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), x: Block(tys), rl: Role, c: Cell(tys), d: Dyn(tys), ag: Cell::Agrees(tys, strs, h, rl, c, d),
    blk: (r: Ref) → c.v = Refer(r) → ¬(rl.same(KGone) = True) → (r.b < h.len()) ∧ ((ob: Obj(tys)) → Heap::obj(tys, h, r.b) = Some(ob) → ob.holes = Nil)):
    Cell::Agrees(tys, strs, h ++ [x], rl, c, d)
{
    let reads = λ (bk: (r: Ref) → c.v = Refer(r) → (r.b < h.len()) ∧ ((ob: Obj(tys)) → Heap::obj(tys, h, r.b) = Some(ob) → ob.holes = Nil)) =>
        (match c.v as λ u => ((r: Ref) → u = Refer(r) → (r.b < h.len()) ∧ ((ob: Obj(tys)) → Heap::obj(tys, h, r.b) = Some(ob) → ob.holes = Nil)) →
                Value::Reads(tys, strs, h, u, d) → Value::Reads(tys, strs, h ++ [x], u, d) {
            Plain(_) => λ _ g => g,
            Refer(r) => λ bk2 g => {
                let b2 = bk2(r, refl);
                j(sym(Heap::val_grow(tys, strs, h, x, r.b, b2.left, b2.right)), λ q _ => (match q { Some(dv) => Sel::get(tys, strs, r.sels ++ Nil, dv), None => None<Dyn(tys)>() }) = Some(d), g)
            },
        })(bk);
    (match rl as λ q => Cell::Agrees(tys, strs, h, q, c, d) → ((r: Ref) → c.v = Refer(r) → ¬(q.same(KGone) = True) → (r.b < h.len()) ∧ ((ob: Obj(tys)) → Heap::obj(tys, h, r.b) = Some(ob) → ob.holes = Nil)) →
            Cell::Agrees(tys, strs, h ++ [x], q, c, d) {
        KPlain => λ a _ => a,
        KGone => λ a _ => a,
        KHold(_, _) => λ a bk => reads(λ r e => bk(r, e, λ no => absurd(no)), a),
        KView => λ a bk => reads(λ r e => bk(r, e, λ no => absurd(no)), a),
    })(ag, blk)
}

// `Sim` on a heap one block longer.
theorem Sim::grow(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    sim: Sim(tys, strs, s, e, m), x: Block(tys)): Sim(tys, strs, s, e, Mach(m.heap ++ [x], m.env, m.io))
{
    Sim(sim.eargs, sim.margs, sim.elocs, sim.mlocs,
        λ y l hl => Cell::agrees_grow(tys, strs, m.heap, x, s.role(l), REnv::get(tys, m.env, y), Env::get(tys, e, y), sim.vars(y, l, hl),
            λ r cr live => match s.refok_block(inv.root, Mach::ixs(tys, strs, m), l, r, inv.refs(y, l, hl, r, cr), live) {
                ⟨o, ⟨r0, pr⟩⟩ => ⟨j(pr.right, λ b _ => b < m.heap.len(), inv.inheap(o, r0, pr.left)), j(pr.right, λ b _ => (ob: Obj(tys)) → Heap::obj(tys, m.heap, b) = Some(ob) → ob.holes = Nil, inv.bare(o, r0, pr.left))⟩,
            }),
        sim.codes)
}

// ---------------------------------------------------------------------------
// Fresh: a new object in a new block, held and owned

theorem Nat::same_false(a, b: Nat, ne: ¬(a = b)): a.same(b) = False {
    (match a.same(b) as λ c => a.same(b) = c → c = False { True => λ e => false_elim(ne(a.same_sound(b, e))), False => λ _ => refl })(refl)
}

// The roots after a fresh object: the new one's at block `b`, whole.
fn CSt::fresh_root(self s: CSt, root: Nat → Option<Ref>, b: Nat) → Nat → Option<Ref> { λ o => match o.same(s.nobj) { True => Some(Ref(b, Nil)), False => root(o) } }

theorem CSt::fresh_root_at(self s: CSt, root: Nat → Option<Ref>, b: Nat): s.fresh_root(root, b)(s.nobj) = Some(Ref(b, Nil)) {
    j(sym(s.nobj.same_self()), λ c _ => (match c { True => Some(Ref(b, Nil)), False => root(s.nobj) }) = Some(Ref(b, Nil)), refl)
}

theorem CSt::fresh_root_other(self s: CSt, root: Nat → Option<Ref>, b, o: Nat, ne: ¬(o = s.nobj)): s.fresh_root(root, b)(o) = root(o) {
    j(sym(Nat::same_false(o, s.nobj, ne)), λ c _ => (match c { True => Some(Ref(b, Nil)), False => root(o) }) = root(o), refl)
}

theorem Nat::eq_or_ne(a, b: Nat): (a = b) ∨ ¬(a = b) {
    (match a.same(b) as λ c => a.same(b) = c → (a = b) ∨ ¬(a = b) { True => λ e => Inl(a.same_sound(b, e)), False => λ e => Inr(Nat::ne_of_same(a, b, e)) })(refl)
}

// The level of an index the checker reads at a level, back.
theorem CSt::atom_ix_of(self s: CSt, l: Nat, below: l < s.na + s.nd): s.atom(Var(s.ix_of(l))) = Some(Var(l)) {
    (match (l + 1).leb(s.na) as λ c => (l + 1).leb(s.na) = c → s.atom(Var(match c as λ _ => Nat { True => l, False => s.na + (s.nd - 1 - (l - s.na)) })) = Some(Var(l)) {
        True => λ eb => j(sym(eb), λ c2 _ => (match c2 as λ _ => Option<Atom> { True => Some(Var(l)), False => (l - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (l - s.na)))) }) = Some(Var(l)), refl),
        False => λ eb => {
            let ge: ¬(l + 1 <= s.na) = λ le => absurd(trans(sym(eb), Nat::leb_true(l + 1, s.na, le)));
            let w = s.na + (s.nd - 1 - (l - s.na));
            let notarg: ((w + 1).leb(s.na) = False) = Bool::false_of_not((w + 1).leb(s.na), λ t => omega(Nat::le_of_leb(w + 1, s.na, t), ge, below));
            let inside: ((w - s.na + 1).leb(s.nd) = True) = Nat::leb_true(w - s.na + 1, s.nd, omega(ge, below));
            let back: (s.na + s.nd - 1 - (w - s.na) = l) = omega(ge, below);
            j(sym(notarg), λ c2 _ => (match c2 as λ _ => Option<Atom> { True => Some(Var(w)), False => (w - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (w - s.na)))) }) = Some(Var(l)),
                j(sym(inside), λ c3 _ => c3.then(Some<Atom>(Var(s.na + s.nd - 1 - (w - s.na)))) = Some<Atom>(Var(l)), cong_fn(λ (k: Nat) => Some<Atom>(Var(k)), back)))
        },
    })(refl)
}

// A plain level's word in the run is the meaning's.
theorem Sim::lvl_ix(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), l: Nat, below: l < s.na + s.nd, pl: (s.role(l)).plain() = True):
    (Mach::ixs(tys, strs, m)).nth(s.ix_of(l)) = (Env::ixs(tys, e)).nth(s.ix_of(l))
{
    Sim::atom_ix(tys, strs, sim, s.ix_of(l), l, s.atom_ix_of(l, below), pl)
}

// The invariant after a fresh object `d` of code `c`, nothing pending.
theorem Inv::fresh(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, c: Shape, d: Dyn(tys), okc: d.code = c):
    Inv(tys, strs, s.push(CVar(c, KHold(s.nobj, AcOwn))).fresh_obj(), Env::push(tys, e, d),
        Mach(m.heap ++ [Live(Obj(d, Nil))], REnv::push(tys, m.env, Cell(Refer(Ref(m.heap.len(), Nil)), True)), m.io), h0, lent)
{
    let cv = CVar(c, KHold(s.nobj, AcOwn));
    let s2 = s.push(cv).fresh_obj();
    let hb = m.heap.len();
    let x: Block(tys) = Live(Obj(d, Nil));
    let h2 = m.heap ++ [x];
    let cn: Cell(tys) = Cell(Refer(Ref(hb, Nil)), True);
    let mg = Mach(h2, m.env, m.io);
    let m2 = Mach(h2, REnv::push(tys, m.env, cn), m.io);
    let e2 = Env::push(tys, e, d);
    let root2 = s.fresh_root(inv.root, hb);
    let sim0 = Inv::sim_now(tys, strs, inv, none);
    let simg = Sim::grow(tys, strs, inv, sim0, x);
    let hv: (Heap::val(tys, strs, h2, hb) = Some(d)) =
        trans(cong_fn(λ (q: Option<Obj(tys)>) => match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }, Heap::obj_new(tys, m.heap, Obj(d, Nil))), Obj::fill_nil(tys, strs, h2, h2.len(), d));
    let ag: Value::Reads(tys, strs, h2, Refer(Ref(hb, Nil)), d) = j(sym(hv), λ q _ => (match q { Some(dv) => Sel::get(tys, strs, Nil<Sel>() ++ Nil<Sel>(), dv), None => None<Dyn(tys)>() }) = Some(d), refl);
    let sim1: Sim(tys, strs, s2, e2, m2) = Sim::push(tys, strs, simg, cv, cn, d, ag, okc);
    let sim2 = j(sym(s2.patched_none(tys, strs, e2, m2, none)), λ q _ => Sim(tys, strs, s2, q, m2), sim1);
    let ws = Mach::ixs(tys, strs, m);
    let ws2 = Mach::ixs(tys, strs, m2);
    let lenh: (h2.len() = hb + 1) = m.heap.len_snoc(x);
    let rolen: (s2.role(s.na + s.nd) = KHold(s.nobj, AcOwn)) = cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv));
    let below_obj: ((l, o: Nat) → (a: Acc) → l < s.na + s.nd → s.role(l) = KHold(o, a) → ¬(o = s.nobj)) = λ l o a b hr eq => Nat::lt_irrefl(o, j(sym(eq), λ q _ => o < q, inv.held(l, o, a, b, hr)));
    let words2: ((l: Nat) → s.in_regions(l) = True → ws2.nth(s2.ix_of(l)) = ws.nth(s.ix_of(l))) = λ l w => {
        let rl = inv.words(l, w);
        trans(CSt::ixs_push(tys, strs, s, cv, mg, cn, sim0.margs, l, rl.left), trans(Sim::lvl_ix(tys, strs, simg, l, rl.left, rl.right), sym(Sim::lvl_ix(tys, strs, sim0, l, rl.left, rl.right))))
    };
    let ch: ((o: Nat) → ¬(o = s.nobj) → s2.Changes(o) → s.Changes(o)) = λ o ne h1 => s.changes_push(cv, o, λ a e _ => ne(sym(cong_fn(Role::held, e))), h1);
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws)) = λ en mem =>
        CSt::sels_keep(en.reg, s2, ws2, s, ws, λ l2 m2l => words2(l2, s.region_lvl(en, mem, l2, m2l)));
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)) = λ en mem =>
        CSt::sels_keep(en.at, s2, ws2, s, ws, λ l2 m2l => words2(l2, s.at_lvl(en, mem, l2, m2l)));
    let new_block: ((o: Nat) → (r: Ref) → inv.root(o) = Some(r) → ¬(r.b = hb)) = λ o r hr eb => Nat::lt_irrefl(hb, j(eb, λ q _ => q < hb, inv.inheap(o, r, hr)));
    Inv(sim2, root2,
        λ y l h r cr => match s.push_lvl(cv, y, l, h) {
            Inl(nw) => {
                let rr = j(nw.left, λ q _ => (REnv::get(tys, m2.env, q)).v = Refer(r), cr);
                let re: (Ref(hb, Nil) = r) = cong_fn(λ (v: Value(tys)) => match v { Refer(q) => q, Plain(_) => Ref(0, Nil) }, rr);
                let at: (root2(s.nobj) = Some(r)) = trans(s.fresh_root_at(inv.root, hb), cong_fn(λ (q: Ref) => Some(q), re));
                j(sym(nw.right), λ q _ => s2.RefOk(root2, ws2, q, r),
                    j(sym(rolen), λ q _ => match q { KHold(o, _) => root2(o) = Some(r), KView => VEnt::Any(s2.ents(s.na + s.nd), λ en => (root2(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r)),
                        KPlain => False, KGone => True }, at))
            },
            Inr(⟨x0, p⟩) => {
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, m.env, cn, x0))), j(p.left, λ q _ => (REnv::get(tys, m2.env, q)).v = Refer(r), cr));
                let below = s.lvl_below(x0, l, p.right);
                CSt::refok_keep(s, s2, inv.root, root2, ws, ws2, l, r, s.role_push(cv, l, below), refl,
                    λ o a hr => s.fresh_root_other(inv.root, hb, o, below_obj(l, o, a, below, hr)),
                    λ en mem => s.fresh_root_other(inv.root, hb, en.obj, λ eq => Nat::lt_irrefl(en.obj, j(sym(eq), λ q _ => en.obj < q, (inv.vents(en, s.views.mem_filter(en, λ q => q.lvl.same(l), mem))).left))),
                    λ en mem => regs(en, s.views.mem_filter(en, λ q => q.lvl.same(l), mem)),
                    inv.refs(x0, l, p.right, r, cr0))
            },
        },
        λ o1 o2 ne ch1 r1 r2 h1 h2b => match Nat::eq_or_ne(o1, s.nobj) {
            Inl(e1) => {
                let rn: (Ref(hb, Nil) = r1) = Option::some_inj(Ref(hb, Nil), r1, trans(sym(s.fresh_root_at(inv.root, hb)), j(e1, λ q _ => root2(q) = Some(r1), h1)));
                let ne2: ¬(o2 = s.nobj) = λ e2 => ne(trans(e1, sym(e2)));
                let old2: (inv.root(o2) = Some(r2)) = trans(sym(s.fresh_root_other(inv.root, hb, o2, ne2)), h2b);
                λ eb => false_elim(new_block(o2, r2, old2, sym(trans(cong_fn(λ (q: Ref) => q.b, rn), eb))))
            },
            Inr(n1) => match Nat::eq_or_ne(o2, s.nobj) {
                Inl(e2) => {
                    let rn: (Ref(hb, Nil) = r2) = Option::some_inj(Ref(hb, Nil), r2, trans(sym(s.fresh_root_at(inv.root, hb)), j(e2, λ q _ => root2(q) = Some(r2), h2b)));
                    let old1: (inv.root(o1) = Some(r1)) = trans(sym(s.fresh_root_other(inv.root, hb, o1, n1)), h1);
                    λ eb => false_elim(new_block(o1, r1, old1, trans(eb, sym(cong_fn(λ (q: Ref) => q.b, rn)))))
                },
                Inr(n2) => inv.apart(o1, o2, ne, ch(o1, n1, ch1), r1, r2, trans(sym(s.fresh_root_other(inv.root, hb, o1, n1)), h1), trans(sym(s.fresh_root_other(inv.root, hb, o2, n2)), h2b)),
            },
        },
        λ o r hr => match Nat::eq_or_ne(o, s.nobj) {
            Inl(eq) => {
                let rn: (Ref(hb, Nil) = r) = Option::some_inj(Ref(hb, Nil), r, trans(sym(s.fresh_root_at(inv.root, hb)), j(eq, λ q _ => root2(q) = Some(r), hr)));
                j(rn, λ q _ => q.b < h2.len(), omega(lenh))
            },
            Inr(ne) => {
                let lt = inv.inheap(o, r, trans(sym(s.fresh_root_other(inv.root, hb, o, ne)), hr));
                omega(lt, lenh)
            },
        },
        λ o ch1 r hr => match Nat::eq_or_ne(o, s.nobj) {
            Inl(eq) => {
                let rn: (Ref(hb, Nil) = r) = Option::some_inj(Ref(hb, Nil), r, trans(sym(s.fresh_root_at(inv.root, hb)), j(eq, λ q _ => root2(q) = Some(r), hr)));
                Inr(j(rn, λ q _ => h0.len() <= q.b, inv.grows))
            },
            Inr(ne) => inv.owned(o, ch(o, ne, ch1), r, trans(sym(s.fresh_root_other(inv.root, hb, o, ne)), hr)),
        },
        λ y l h lv co r cr => match s.push_lvl(cv, y, l, h) {
            Inl(nw) => {
                let rr = j(nw.left, λ q _ => (REnv::get(tys, m2.env, q)).v = Refer(r), cr);
                let re: (Ref(hb, Nil) = r) = cong_fn(λ (v: Value(tys)) => match v { Refer(q) => q, Plain(_) => Ref(0, Nil) }, rr);
                Exists(s.nobj, ⟨j(sym(nw.right), λ q _ => s2.role(q) = KHold(s.nobj, AcOwn), rolen),
                    ⟨trans(s.fresh_root_at(inv.root, hb), cong_fn(λ (q: Ref) => Some(q), re)),
                    ⟨cong_fn(λ (q: Ref) => q.sels, sym(re)),
                    λ o2 ne2 r2 h2r eb => new_block(o2, r2, trans(sym(s.fresh_root_other(inv.root, hb, o2, ne2)), h2r), trans(eb, sym(cong_fn(λ (q: Ref) => q.b, re))))⟩⟩⟩)
            },
            Inr(⟨x0, p⟩) => {
                let get0 = REnv::get_push_up(tys, m.env, cn, x0);
                let co0: ((REnv::get(tys, m.env, x0)).own = True) = trans(cong_fn(λ (q: Cell(tys)) => q.own, sym(get0)), j(p.left, λ q _ => (REnv::get(tys, m2.env, q)).own = True, co));
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(get0)), j(p.left, λ q _ => (REnv::get(tys, m2.env, q)).v = Refer(r), cr));
                let below = s.lvl_below(x0, l, p.right);
                let lv0: ¬((s.role(l)).same(KGone) = True) = λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), s.role_push(cv, l, below)), g));
                match inv.own(x0, l, p.right, lv0, co0, r, cr0) {
                    ⟨o, po⟩ => {
                        let no = below_obj(l, o, AcOwn, below, po.left);
                        Exists(o, ⟨trans(s.role_push(cv, l, below), po.left), ⟨trans(s.fresh_root_other(inv.root, hb, o, no), po.right.left), ⟨po.right.right.left,
                            λ o2 ne2 r2 h2r => match Nat::eq_or_ne(o2, s.nobj) {
                                Inl(e2) => {
                                    let rn: (Ref(hb, Nil) = r2) = Option::some_inj(Ref(hb, Nil), r2, trans(sym(s.fresh_root_at(inv.root, hb)), j(e2, λ q _ => root2(q) = Some(r2), h2r)));
                                    λ eb => new_block(o, r, po.right.left, trans(sym(eb), sym(cong_fn(λ (q: Ref) => q.b, rn))))
                                },
                                Inr(n2) => po.right.right.right(o2, ne2, r2, trans(sym(s.fresh_root_other(inv.root, hb, o2, n2)), h2r)),
                            }⟩⟩⟩)
                    },
                }
            },
        },
        λ l1 l2 o a1 a2 b1 b2 ne h1 h2r => match Nat::below_succ(l1, s.na + s.nd, b1) {
            Inr(at1) => match Nat::below_succ(l2, s.na + s.nd, b2) {
                Inr(at2) => ne(trans(at1, sym(at2))),
                Inl(c2) => {
                    let on: (s.nobj = o) = cong_fn(Role::held, trans(sym(j(sym(at1), λ q _ => s2.role(q) = KHold(s.nobj, AcOwn), rolen)), h1));
                    below_obj(l2, o, a2, c2, trans(sym(s.role_push(cv, l2, c2)), h2r), sym(on))
                },
            },
            Inl(c1) => match Nat::below_succ(l2, s.na + s.nd, b2) {
                Inr(at2) => {
                    let on: (s.nobj = o) = cong_fn(Role::held, trans(sym(j(sym(at2), λ q _ => s2.role(q) = KHold(s.nobj, AcOwn), rolen)), h2r));
                    below_obj(l1, o, a1, c1, trans(sym(s.role_push(cv, l1, c1)), h1), sym(on))
                },
                Inl(c2) => inv.one(l1, l2, o, a1, a2, c1, c2, ne, trans(sym(s.role_push(cv, l1, c1)), h1), trans(sym(s.role_push(cv, l2, c2)), h2r)),
            },
        },
        λ l w => {
            let ww = inv.words(l, w);
            ⟨omega(ww.left), trans(cong_fn(λ (q: Role) => q.plain(), s.role_push(cv, l, ww.left)), ww.right)⟩
        },
        λ b bl nl => trans(m.heap.nth_snoc_below(x, b, omega(bl, inv.grows)), inv.frame(b, bl, nl)),
        omega(inv.grows, lenh),
        λ o ge => trans(s.fresh_root_other(inv.root, hb, o, λ eq => omega(ge, eq)), inv.young(o, omega(ge))),
        λ l o a b hr => match Nat::below_succ(l, s.na + s.nd, b) {
            Inr(at) => {
                let on: (s.nobj = o) = cong_fn(Role::held, trans(sym(j(sym(at), λ q _ => s2.role(q) = KHold(s.nobj, AcOwn), rolen)), hr));
                j(on, λ q _ => q < s.nobj + 1, omega())
            },
            Inl(c1) => omega(inv.held(l, o, a, c1, trans(sym(s.role_push(cv, l, c1)), hr))),
        },
        λ en mem => {
            let vv = inv.vents(en, mem);
            ⟨omega(vv.left), ⟨omega(vv.right.left), trans(s.role_push(cv, en.lvl, vv.right.left), vv.right.right)⟩⟩
        },
        λ o r hr ob hob => match Nat::eq_or_ne(o, s.nobj) {
            Inl(eq) => {
                let rn: (Ref(hb, Nil) = r) = Option::some_inj(Ref(hb, Nil), r, trans(sym(s.fresh_root_at(inv.root, hb)), j(eq, λ q _ => root2(q) = Some(r), hr)));
                let hob2: (Heap::obj(tys, h2, hb) = Some(ob)) = j(sym(rn), λ q _ => Heap::obj(tys, h2, q.b) = Some(ob), hob);
                sym(cong_fn(λ (q: Obj(tys)) => q.holes, Option::some_inj(Obj(d, Nil), ob, trans(sym(Heap::obj_new(tys, m.heap, Obj(d, Nil))), hob2))))
            },
            Inr(ne) => {
                let hr0 = trans(sym(s.fresh_root_other(inv.root, hb, o, ne)), hr);
                inv.bare(o, r, hr0, ob, trans(sym(Heap::obj_grow(tys, m.heap, x, r.b, inv.inheap(o, r, hr0))), hob))
            },
        },
        λ en mem => {
            let cc = inv.chain(en, mem);
            ⟨cc.left, CSt::parent_keep(s, s2, en, s.role_push(cv, en.par, omega(cc.left, (inv.vents(en, mem)).right.left)), refl, cc.right)⟩
        },
        CSt::excl_keep(tys, strs, s, s2, ws, ws2, refl, omega(), λ en mem => (inv.chain(en, mem)).left, λ en mem => (inv.vents(en, mem)).right.left, regs, inv.excl),
        λ en mem w => CSt::wpar_keep(s, s2, en, s.role_push(cv, en.par, omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left)), refl, inv.wpar(en, mem, w)),
        CSt::uni_push(tys, s, cv, m.env, cn, inv.uni, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at)))), inv.pone,
        CSt::cfit_push(tys, strs, s, cv, m.env, cn, ws, ws2, inv.cfit, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at))), ats),
        CSt::sib_keep(tys, strs, s, s2, ws, ws2, refl, ats, inv.sib))
}

// A value read at its own code is there.
theorem Dyn::get_coded(tys: Nat → Type, c: Shape, d: Dyn(tys), h: d.code = c): Exists<El(tys, c)>(λ x => Dyn::get(tys, c, d) = Some(x)) {
    (match Shape::dec(d.code, c) as λ o => Exists<El(tys, c)>(λ x => (match o { Inl(h2) => Some(Shape::cast(tys, h2, d.val)), Inr(_) => None<El(tys, c)>() }) = Some(x)) {
        Inl(h2) => Exists(Shape::cast(tys, h2, d.val), refl),
        Inr(ne) => false_elim(ne(h)),
    })
}

// A fresh sequence of an element of its element's code has its code (the
// code check's condition, as `Stmt::code_ok` states it).
theorem Dyn::fresh_code(tys: Nat → Type, strs: Strs(tys), k: Nat, n, v: Dyn(tys), vc: Shape, ec: v.code = vc, a: Bool,
    ok: (match strs(k).kind { Sequence(q) => a && vc.same(q.elem), Opaque => False, Record(_) => False }) = True):
    (Dyn::fresh(tys, strs, SNamed(k), n, v)).code = SNamed(k)
{
    (match strs(k).kind as λ kd => (match kd { Sequence(q) => a && vc.same(q.elem), Opaque => False, Record(_) => False }) = True →
            (match kd { Sequence(q2) => match Dyn::get(tys, q2.elem, v) { Some(x) => Dyn(SNamed(k), q2.make(Dyn::ix(tys, n), x)), None => Dyn::none(tys) },
                Opaque => Dyn::none(tys), Record(_) => Dyn::none(tys) }).code = SNamed(k) {
        Sequence(q) => λ h => {
            let same: (v.code = q.elem) = trans(ec, Shape::same_eq(vc, q.elem, (Bool::and_parts(a, vc.same(q.elem), h)).right));
            match Dyn::get_coded(tys, q.elem, v, same) {
                ⟨x, gx⟩ => j(sym(gx), λ o _ => (match o { Some(x2) => Dyn(SNamed(k), q.make(Dyn::ix(tys, n), x2)), None => Dyn::none(tys) }).code = SNamed(k), refl),
            }
        },
        Opaque => λ no => absurd(no),
        Record(_) => λ no => absurd(no),
    })(ok)
}

// The code the checker reads a variable at is the code it records.
theorem CSt::code_read(self s: CSt, tys: Nat → Type, strs: Strs(tys), x: Var, g: Got, ok: s.read_var(tys, strs, x) = Some(g)): s.code(x) = g.code {
    let inv = s.read_inv(tys, strs, Place(x, Nil), g, ok);
    trans(cong_fn(λ (o: Option<Nat>) => match o { Some(l) => (s.var(l)).code, None => SWord(WNat) }, inv.lvl), Option::some_inj((s.var(g.root)).code, g.code, inv.code))
}

theorem Stmt::fresh_runs(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), c: Shape, n, v: Var, dn, dv: Dyn(tys),
    vn: Mach::val(tys, strs, m, n) = Some(dn), vv: Mach::val(tys, strs, m, v) = Some(dv), k: Mach(tys) → Ran(tys)):
    (Fresh(c, n, v)).run(tys, strs, fns, call, m, k) = k(Mach(m.heap ++ [Live(Obj(Dyn::fresh(tys, strs, c, dn, dv), Nil))], REnv::push(tys, m.env, Cell(Refer(Ref(m.heap.len(), Nil)), True)), m.io))
{
    let fin = λ (a: Dyn(tys)) (b: Dyn(tys)) => k(Mach(m.heap ++ [Live(Obj(Dyn::fresh(tys, strs, c, a, b), Nil))], REnv::push(tys, m.env, Cell(Refer(Ref(m.heap.len(), Nil)), True)), m.io));
    j(sym(vn), λ o _ => (match o { Some(nd) => match Mach::val(tys, strs, m, v) { Some(xd) => fin(nd, xd), None => Stuck }, None => Stuck }) = fin(dn, dv),
        j(sym(vv), λ o _ => (match o { Some(xd) => fin(dn, xd), None => Stuck }) = fin(dn, dv), refl))
}

theorem Stmt::stage_fresh(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, k: Nat, n, v: Var, gn, gv: Got,
    okn: s.read_var(tys, strs, n) = Some(gn), okv: s.read_var(tys, strs, v) = Some(gv),
    kok: (match strs(k).kind { Sequence(q) => s.code(n).is_word() && s.code(v).same(q.elem), Opaque => False, Record(_) => False }) = True):
    Stepped(tys, strs, fns, call, Fresh(SNamed(k), n, v), s.push(CVar(SNamed(k), KHold(s.nobj, AcOwn))).fresh_obj(),
        Env::push(tys, e, Dyn::fresh(tys, strs, SNamed(k), Env::get(tys, e, n), Env::get(tys, e, v))), m, h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let vn = Sim::read_val(tys, strs, sim, n, gn, okn);
    let vv = Sim::read_val(tys, strs, sim, v, gv, okv);
    let d = Dyn::fresh(tys, strs, SNamed(k), Env::get(tys, e, n), Env::get(tys, e, v));
    Stepped(Mach(m.heap ++ [Live(Obj(d, Nil))], REnv::push(tys, m.env, Cell(Refer(Ref(m.heap.len(), Nil)), True)), m.io),
        λ kk => Stmt::fresh_runs(tys, strs, fns, call, m, SNamed(k), n, v, Env::get(tys, e, n), Env::get(tys, e, v), vn, vv, kk),
        Inv::fresh(tys, strs, inv, none, SNamed(k), d, Dyn::fresh_code(tys, strs, k, Env::get(tys, e, n), Env::get(tys, e, v), s.code(v), trans(Sim::read_code(tys, strs, sim, v, gv, okv), sym(s.code_read(tys, strs, v, gv, okv))), s.code(n).is_word(), kok)))
}

// ---------------------------------------------------------------------------
// A level set gone: its role, every other's, every code

theorem List::nth_update_gone(self xs: List<CVar>): (i: Nat) → ((xs.update(i, λ c => CVar(c.code, KGone))).nth(i).unwrap_or(CVar::none())).role = KGone {
    match xs { Nil => λ i => refl, Cons(_, t) => λ i => match i { Zero => refl, Succ(k) => t.nth_update_gone(k) } }
}

theorem List::nth_update_code(self xs: List<CVar>, r: Role): (i: Nat) → ((xs.update(i, λ c => CVar(c.code, r))).nth(i).unwrap_or(CVar::none())).code = (xs.nth(i).unwrap_or(CVar::none())).code {
    match xs { Nil => λ i => refl, Cons(_, t) => λ i => match i { Zero => refl, Succ(k) => t.nth_update_code(r, k) } }
}

// The lists a set level reads, as the bit that says which holds it.
fn CSt::set_args(self s: CSt, l: Nat, r: Role, b: Bool) → List<CVar> { match b { True => s.args.update(l, λ c => CVar(c.code, r)), False => s.args } }

fn CSt::set_locs(self s: CSt, l: Nat, r: Role, b: Bool) → List<CVar> { match b { True => s.locs, False => s.locs.update(s.na + s.nd - 1 - l, λ c => CVar(c.code, r)) } }

fn CSt::var_in(self s: CSt, a, ls: List<CVar>, l2: Nat, b2: Bool) → CVar { match b2 { True => a.nth(l2).unwrap_or(CVar::none()), False => ls.nth(s.na + s.nd - 1 - l2).unwrap_or(CVar::none()) } }

theorem CSt::set_gone_role(self s: CSt, l: Nat): (s.set(l, KGone)).role(l) = KGone {
    (match (l + 1).leb(s.na) as λ b => (s.var_in(s.set_args(l, KGone, b), s.set_locs(l, KGone, b), l, b)).role = KGone {
        True => s.args.nth_update_gone(l),
        False => s.locs.nth_update_gone(s.na + s.nd - 1 - l),
    })
}

theorem CSt::set_code_here(self s: CSt, l: Nat, r: Role): ((s.set(l, r)).var(l)).code = (s.var(l)).code {
    (match (l + 1).leb(s.na) as λ b => (s.var_in(s.set_args(l, r, b), s.set_locs(l, r, b), l, b)).code = (s.var_in(s.args, s.locs, l, b)).code {
        True => s.args.nth_update_code(r, l),
        False => s.locs.nth_update_code(r, s.na + s.nd - 1 - l),
    })
}

theorem CSt::set_other(self s: CSt, l, l2: Nat, r: Role, ne: ¬(l2 = l), b: l < s.na + s.nd, b2: l2 < s.na + s.nd): (s.set(l, r)).var(l2) = s.var(l2) {
    let f = λ (c: CVar) => CVar(c.code, r);
    (match (l + 1).leb(s.na) as λ c1 => (l + 1).leb(s.na) = c1 → (c2: Bool) → (l2 + 1).leb(s.na) = c2 →
            s.var_in(s.set_args(l, r, c1), s.set_locs(l, r, c1), l2, c2) = s.var_in(s.args, s.locs, l2, c2) {
        True => λ _ c2 e2 => (match c2 as λ c => s.var_in(s.args.update(l, f), s.locs, l2, c) = s.var_in(s.args, s.locs, l2, c) {
            True => cong_fn(λ (o: Option<CVar>) => o.unwrap_or(CVar::none()), s.args.nth_update_other(l, f, l2, ne)),
            False => refl,
        }),
        False => λ e1 c2 e2 => (match c2 as λ c => (l2 + 1).leb(s.na) = c → s.var_in(s.args, s.locs.update(s.na + s.nd - 1 - l, f), l2, c) = s.var_in(s.args, s.locs, l2, c) {
            True => λ _ => refl,
            False => λ e2f => {
                let ge: ¬(l + 1 <= s.na) = λ le => absurd(trans(sym(e1), Nat::leb_true(l + 1, s.na, le)));
                let ge2: ¬(l2 + 1 <= s.na) = λ le => absurd(trans(sym(e2f), Nat::leb_true(l2 + 1, s.na, le)));
                cong_fn(λ (o: Option<CVar>) => o.unwrap_or(CVar::none()), s.locs.nth_update_other(s.na + s.nd - 1 - l, f, s.na + s.nd - 1 - l2, λ eq => ne(omega(eq, ge, ge2, b, b2))))
            },
        })(e2),
    })(refl, (l2 + 1).leb(s.na), refl)
}

theorem CSt::role_set_other(self s: CSt, l, l2: Nat, r: Role, ne: ¬(l2 = l), b: l < s.na + s.nd, b2: l2 < s.na + s.nd): (s.set(l, r)).role(l2) = s.role(l2) {
    cong_fn(λ (v: CVar) => v.role, s.set_other(l, l2, r, ne, b, b2))
}

theorem CSt::set_code(self s: CSt, l, l2: Nat, r: Role, b: l < s.na + s.nd, b2: l2 < s.na + s.nd): ((s.set(l, r)).var(l2)).code = (s.var(l2)).code {
    match Nat::eq_or_ne(l2, l) {
        Inl(eq) => j(sym(eq), λ q _ => ((s.set(l, r)).var(q)).code = (s.var(q)).code, s.set_code_here(l, r)),
        Inr(ne) => cong_fn(λ (v: CVar) => v.code, s.set_other(l, l2, r, ne, b, b2)),
    }
}

// A level gone holds nothing: what may change after, might before.
theorem CSt::changes_gone(self s: CSt, l: Nat, b: l < s.na + s.nd, o: Nat, h: (s.set(l, KGone)).Changes(o)): s.Changes(o) {
    match h {
        Inl(ex) => match ex {
            ⟨l2, pl⟩ => match pl.right {
                ⟨a, pa⟩ => match Nat::eq_or_ne(l2, l) {
                    Inl(eq) => absurd(trans(sym(pa.left), j(sym(eq), λ q _ => (s.set(l, KGone)).role(q) = KGone, s.set_gone_role(l)))),
                    Inr(ne) => Inl(Exists(l2, ⟨pl.left, Exists(a, ⟨trans(sym(s.role_set_other(l, l2, KGone, ne, b, pl.left)), pa.left), pa.right⟩)⟩)),
                },
            },
        },
        Inr(ev) => Inr(ev),
    }
}

// `Sim` with a level set gone.
theorem Sim::gone(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), l: Nat, b: l < s.na + s.nd): Sim(tys, strs, s.set(l, KGone), e, m) {
    Sim(sim.eargs, sim.margs, sim.elocs, sim.mlocs,
        λ x l2 h => match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(eq), λ q _ => Cell::Agrees(tys, strs, m.heap, (s.set(l, KGone)).role(q), REnv::get(tys, m.env, x), Env::get(tys, e, x)),
                j(sym(s.set_gone_role(l)), λ r _ => Cell::Agrees(tys, strs, m.heap, r, REnv::get(tys, m.env, x), Env::get(tys, e, x)), trivial)),
            Inr(ne) => j(sym(s.role_set_other(l, l2, KGone, ne, b, s.lvl_below(x, l2, h))), λ r _ => Cell::Agrees(tys, strs, m.heap, r, REnv::get(tys, m.env, x), Env::get(tys, e, x)),
                sim.vars(x, l2, h)),
        },
        λ x l2 h => trans(sim.codes(x, l2, h), sym(s.set_code(l, l2, KGone, b, s.lvl_below(x, l2, h)))))
}

// The invariant with a level set gone that no live region reads, no entry
// is of, and no entry is opened on.
theorem Inv::gone(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    l: Nat, b: l < s.na + s.nd, notreg: s.in_regions(l) = False, nolvl: (en: VEnt) → Mem(en, s.views) → ¬(en.lvl = l), nopar: (en: VEnt) → Mem(en, s.views) → ¬(en.par = l)):
    Inv(tys, strs, s.set(l, KGone), e, m, h0, lent)
{
    let s2 = s.set(l, KGone);
    let ws = Mach::ixs(tys, strs, m);
    let other = λ (l2: Nat) (b2: l2 < s.na + s.nd) (ne: ¬(l2 = l)) => s.role_set_other(l, l2, KGone, ne, b, b2);
    let notl = λ (l2: Nat) (r: Role) (h2: s2.role(l2) = r) (ng: ¬(r = KGone)) => λ (eq: l2 = l) => ng(trans(sym(h2), j(sym(eq), λ q _ => s2.role(q) = KGone, s.set_gone_role(l))));
    Inv(Sim::gone(tys, strs, inv.sim, l, b), inv.root,
        λ x l2 h r cr => match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(eq), λ q _ => s2.RefOk(inv.root, ws, q, r),
                j(sym(s.set_gone_role(l)), λ q _ => match q { KHold(o, _) => inv.root(o) = Some(r), KView => VEnt::Any(s2.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s2.unsteps(en.reg))) = Some(r)),
                    KPlain => False, KGone => True }, trivial)),
            Inr(ne) => CSt::refok_keep(s, s2, inv.root, inv.root, ws, ws, l2, r, other(l2, s.lvl_below(x, l2, h), ne), refl, λ _ _ _ => refl, λ _ _ => refl, λ _ _ => refl, inv.refs(x, l2, h, r, cr)),
        },
        λ o1 o2 ne ch => inv.apart(o1, o2, ne, s.changes_gone(l, b, o1, ch)),
        inv.inheap,
        λ o ch => inv.owned(o, s.changes_gone(l, b, o, ch)),
        λ x l2 h lv co r cr => {
            let b2 = s.lvl_below(x, l2, h);
            let ne: ¬(l2 = l) = λ eq => lv(j(sym(eq), λ q _ => (s2.role(q)).same(KGone) = True, j(sym(s.set_gone_role(l)), λ q _ => q.same(KGone) = True, refl)));
            let ro = other(l2, b2, ne);
            match inv.own(x, l2, h, λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), ro), g)), co, r, cr) { ⟨o, po⟩ => Exists(o, ⟨trans(ro, po.left), po.right⟩) }
        },
        λ l1 l2 o a1 a2 b1 b2 ne h1 h2 => inv.one(l1, l2, o, a1, a2, b1, b2, ne,
            trans(sym(other(l1, b1, notl(l1, KHold(o, a1), h1, λ no => absurd(no)))), h1), trans(sym(other(l2, b2, notl(l2, KHold(o, a2), h2, λ no => absurd(no)))), h2)),
        λ l2 w => {
            let ww = inv.words(l2, w);
            ⟨ww.left, trans(cong_fn(λ (q: Role) => q.plain(), other(l2, ww.left, λ eq => absurd(trans(sym(notreg), j(eq, λ q _ => s.in_regions(q) = True, w))))), ww.right)⟩
        },
        inv.frame,
        inv.grows,
        inv.young,
        λ l2 o a b2 hr => inv.held(l2, o, a, b2, trans(sym(other(l2, b2, notl(l2, KHold(o, a), hr, λ no => absurd(no)))), hr)),
        λ en mem => {
            let vv = inv.vents(en, mem);
            ⟨vv.left, ⟨vv.right.left, trans(other(en.lvl, vv.right.left, nolvl(en, mem)), vv.right.right)⟩⟩
        },
        inv.bare,
        λ en mem => {
            let cc = inv.chain(en, mem);
            let pb: (en.par < s.na + s.nd) = omega(cc.left, (inv.vents(en, mem)).right.left);
            ⟨cc.left, CSt::parent_keep(s, s2, en, other(en.par, pb, nopar(en, mem)), refl, cc.right)⟩
        },
        inv.excl,
        λ en mem w => CSt::wpar_keep(s, s2, en, other(en.par, omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left), nopar(en, mem)), refl, inv.wpar(en, mem, w)), inv.uni, inv.pone, inv.cfit, inv.sib)
}

// ---------------------------------------------------------------------------
// A block killed: the blocks the invariant reads are as they were

theorem Heap::obj_kill_other(tys: Nat → Type, h: Heap(tys), kb, b: Nat, ne: ¬(b = kb)): Heap::obj(tys, Heap::kill(tys, h, kb), b) = Heap::obj(tys, h, b) {
    cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }, h.nth_update_other(kb, λ _ => Dead, b, ne))
}

theorem Heap::val_kill_other(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), kb, b: Nat, ne: ¬(b = kb), bare: (ob: Obj(tys)) → Heap::obj(tys, h, b) = Some(ob) → ob.holes = Nil):
    Heap::val(tys, strs, Heap::kill(tys, h, kb), b) = Heap::val(tys, strs, h, b)
{
    let h2 = Heap::kill(tys, h, kb);
    let lhs: (Heap::val(tys, strs, h2, b) = (match Heap::obj(tys, h, b) { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() })) =
        cong_fn(λ (q: Option<Obj(tys)>) => match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }, Heap::obj_kill_other(tys, h, kb, b, ne));
    trans(lhs, (match Heap::obj(tys, h, b) as λ q => Heap::obj(tys, h, b) = q →
            (match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }) = (match q { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None<Dyn(tys)>() }) {
        None => λ _ => refl,
        Some(o) => λ e1 => trans(Obj::read_bare(tys, strs, h2, h2.len(), o, bare(o, e1)), sym(Obj::read_bare(tys, strs, h, h.len(), o, bare(o, e1)))),
    })(refl))
}

// A reference the invariant knows: into the root's block of an object the
// variable holds, or of one of the live entries.
theorem VEnt::any_obj(self es: List<VEnt>, root: Nat → Option<Ref>, ws: List<Ix>, s: CSt, r: Ref):
    VEnt::Any(es, λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)) →
    Exists<VEnt>(λ en => Mem(en, es) ∧ Exists<Ref>(λ r0 => (root(en.obj) = Some(r0)) ∧ (r0.b = r.b)))
{
    match es {
        Nil => λ no => false_elim(no),
        Cons(en, rest) => λ a => match a {
            Inl(p) => match Option::map_some_inv(root(en.obj), λ r0 => r0.narrow(ws, s.unsteps(en.reg)), r, p) {
                ⟨r0, pr⟩ => Exists(en, ⟨Inl(refl), Exists(r0, ⟨pr.left, cong_fn(λ (q: Ref) => q.b, pr.right)⟩)⟩),
            },
            Inr(q) => match VEnt::any_obj(rest, root, ws, s, r, q) { ⟨e2, p2⟩ => Exists(e2, ⟨Inr(p2.left), p2.right⟩) },
        },
    }
}

theorem CSt::refok_obj(self s: CSt, root: Nat → Option<Ref>, ws: List<Ix>, l: Nat, r: Ref, ok: s.RefOk(root, ws, l, r), live: ¬((s.role(l)).same(KGone) = True)):
    Exists<Nat>(λ o => Exists<Ref>(λ r0 => (root(o) = Some(r0)) ∧ ((r0.b = r.b) ∧ (Exists<Acc>(λ a => s.role(l) = KHold(o, a)) ∨ Exists<VEnt>(λ en => Mem(en, s.views) ∧ (en.obj = o))))))
{
    (match s.role(l) as λ q => s.role(l) = q → (match q { KHold(o, _) => root(o) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
            KPlain => False, KGone => True }) → ¬(q.same(KGone) = True) →
            Exists<Nat>(λ o => Exists<Ref>(λ r0 => (root(o) = Some(r0)) ∧ ((r0.b = r.b) ∧ (Exists<Acc>(λ a => s.role(l) = KHold(o, a)) ∨ Exists<VEnt>(λ en => Mem(en, s.views) ∧ (en.obj = o)))))) {
        KHold(o, a) => λ eq h _ => Exists(o, Exists(r, ⟨h, ⟨refl, Inl(Exists(a, eq))⟩⟩)),
        KView => λ _ h _ => match VEnt::any_obj(s.ents(l), root, ws, s, r, h) {
            ⟨en, pe⟩ => match pe.right { ⟨r0, pr⟩ => Exists(en.obj, Exists(r0, ⟨pr.left, ⟨pr.right, Inr(Exists(en, ⟨s.views.mem_filter(en, λ q => q.lvl.same(l), pe.left), refl⟩))⟩⟩)) },
        },
        KPlain => λ _ no _ => false_elim(no),
        KGone => λ _ _ no => false_elim(no(refl)),
    })(refl, ok, live)
}

theorem CSt::obj_views(self s: CSt, en: VEnt, m: Mem(en, s.views), o: Nat, eo: en.obj = o): s.has_obj_views(o) = True {
    s.views.any_bit_mem(λ e => e.obj.same(o), en, m, j(sym(eo), λ q _ => q.same(o) = True, o.same_self()))
}

// `Sim` after the death of a held object's whole block, which only its
// holder reads.
theorem Sim::kill(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    sim: Sim(tys, strs, s, e, m), l, o: Nat, r: Ref, b: l < s.na + s.nd, hr: s.role(l) = KHold(o, AcOwn), rt: inv.root(o) = Some(r),
    ex: (o2: Nat) → ¬(o2 = o) → (r2: Ref) → inv.root(o2) = Some(r2) → ¬(r2.b = r.b), nov: s.has_obj_views(o) = False):
    Sim(tys, strs, s.set(l, KGone), e, Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io))
{
    let s2 = s.set(l, KGone);
    let h2 = Heap::kill(tys, m.heap, r.b);
    let sg = Sim::gone(tys, strs, sim, l, b);
    Sim(sim.eargs, sim.margs, sim.elocs, sim.mlocs,
        λ x l2 hl => {
            let c = REnv::get(tys, m.env, x);
            let d = Env::get(tys, e, x);
            match Nat::eq_or_ne(l2, l) {
                Inl(eq) => j(sym(eq), λ q _ => Cell::Agrees(tys, strs, h2, s2.role(q), c, d), j(sym(s.set_gone_role(l)), λ q _ => Cell::Agrees(tys, strs, h2, q, c, d), trivial)),
                Inr(ne) => {
                    let b2 = s.lvl_below(x, l2, hl);
                    let ro = s.role_set_other(l, l2, KGone, ne, b, b2);
                    let ag: Cell::Agrees(tys, strs, m.heap, s.role(l2), c, d) = sim.vars(x, l2, hl);
                    let reads = λ (rl: Role) (live: ¬(rl.same(KGone) = True)) (er: s.role(l2) = rl) =>
                        (match c.v as λ u => c.v = u → Value::Reads(tys, strs, m.heap, u, d) → Value::Reads(tys, strs, h2, u, d) {
                            Plain(_) => λ _ g => g,
                            Refer(r1) => λ cr g => match s.refok_obj(inv.root, Mach::ixs(tys, strs, m), l2, r1, inv.refs(x, l2, hl, r1, cr), λ gg => live(trans(cong_fn(λ (q: Role) => q.same(KGone), sym(er)), gg))) {
                                ⟨o1, p1⟩ => match p1 {
                                    ⟨r0, pr⟩ => {
                                        let not_o: ¬(o1 = o) = λ eo => match pr.right.right {
                                            Inl(ha) => match ha { ⟨a1, pa⟩ => inv.one(l2, l, o, a1, AcOwn, b2, b, ne, j(eo, λ q _ => s.role(l2) = KHold(q, a1), pa), hr) },
                                            Inr(hv) => match hv { ⟨en, pe⟩ => absurd(trans(sym(nov), s.obj_views(en, pe.left, o, trans(pe.right, eo)))) },
                                        };
                                        let nb: ¬(r1.b = r.b) = λ eb => ex(o1, not_o, r0, pr.left, trans(pr.right.left, eb));
                                        j(sym(Heap::val_kill_other(tys, strs, m.heap, r.b, r1.b, nb, j(pr.right.left, λ q _ => (ob: Obj(tys)) → Heap::obj(tys, m.heap, q) = Some(ob) → ob.holes = Nil, inv.bare(o1, r0, pr.left)))),
                                            λ q _ => (match q { Some(dv) => Sel::get(tys, strs, r1.sels ++ Nil, dv), None => None<Dyn(tys)>() }) = Some(d), g)
                                    },
                                },
                            },
                        })(refl);
                    let ag2: Cell::Agrees(tys, strs, h2, s.role(l2), c, d) = (match s.role(l2) as λ q => s.role(l2) = q → Cell::Agrees(tys, strs, m.heap, q, c, d) → Cell::Agrees(tys, strs, h2, q, c, d) {
                        KPlain => λ _ a2 => a2,
                        KGone => λ _ a2 => a2,
                        KHold(o3, a3) => λ er a2 => reads(KHold(o3, a3), λ no => absurd(no), er, a2),
                        KView => λ er a2 => reads(KView, λ no => absurd(no), er, a2),
                    })(refl, ag);
                    j(sym(ro), λ q _ => Cell::Agrees(tys, strs, h2, q, c, d), ag2)
                },
            }
        },
        sg.codes)
}

// No entry is of a holder, and none is opened on a holder of an object with
// no live views; no live region reads a holder.
theorem Inv::hold_facts(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    l, o: Nat, a: Acc, hr: s.role(l) = KHold(o, a), nov: s.has_obj_views(o) = False):
    (s.in_regions(l) = False) ∧ (((en: VEnt) → Mem(en, s.views) → ¬(en.lvl = l)) ∧ ((en: VEnt) → Mem(en, s.views) → ¬(en.par = l)))
{
    ⟨Bool::false_of_not(s.in_regions(l), λ w => absurd(trans(sym((inv.words(l, w)).right), cong_fn(λ (q: Role) => q.plain(), hr)))),
     ⟨λ en mem eq => absurd(trans(sym(j(eq, λ q _ => s.role(q) = KView, (inv.vents(en, mem)).right.right)), hr)),
      λ en mem eq => {
          let p0 = (inv.chain(en, mem)).right;
          let p1: (match s.role(l) { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
              KPlain => False, KGone => False }) = j(eq, λ q _ => match s.role(q) { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(q), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
                  KPlain => False, KGone => False }, p0);
          let p2: ((o = en.obj) ∧ (en.reg = en.at)) = j(hr, λ q _ => match q { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
              KPlain => False, KGone => False }, p1);
          absurd(trans(sym(nov), s.obj_views(en, mem, o, sym(p2.left))))
      }⟩⟩
}

// The invariant after the death of a held object's whole block.
theorem Inv::kill(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, l, o: Nat, r: Ref, b: l < s.na + s.nd, hr: s.role(l) = KHold(o, AcOwn), rt: inv.root(o) = Some(r),
    ex: (o2: Nat) → ¬(o2 = o) → (r2: Ref) → inv.root(o2) = Some(r2) → ¬(r2.b = r.b), nov: s.has_obj_views(o) = False):
    Inv(tys, strs, s.set(l, KGone), e, Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io), h0, lent)
{
    let s2 = s.set(l, KGone);
    let h2 = Heap::kill(tys, m.heap, r.b);
    let m2 = Mach(h2, m.env, m.io);
    let hf = Inv::hold_facts(tys, strs, inv, l, o, AcOwn, hr, nov);
    let ig = Inv::gone(tys, strs, inv, l, b, hf.left, hf.right.left, hf.right.right);
    let sim0 = Inv::sim_now(tys, strs, inv, none);
    let sim2: Sim(tys, strs, s2, e, m2) = Sim::kill(tys, strs, inv, sim0, l, o, r, b, hr, rt, ex, nov);
    let ws = Mach::ixs(tys, strs, m);
    let ws2 = Mach::ixs(tys, strs, m2);
    let lenh: (h2.len() = m.heap.len()) = m.heap.len_update(r.b, λ _ => Dead);
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s2.unsteps(en.reg), ws)) = λ en mem =>
        CSt::sels_keep(en.reg, s2, ws2, s2, ws, λ l2 m2l => {
            let w = s.region_lvl(en, mem, l2, m2l);
            let rl = inv.words(l2, w);
            let ne: ¬(l2 = l) = λ eq => absurd(trans(sym(hf.left), j(eq, λ q _ => s.in_regions(q) = True, w)));
            let pl2: ((s2.role(l2)).plain() = True) = trans(cong_fn(λ (q: Role) => q.plain(), s.role_set_other(l, l2, KGone, ne, b, rl.left)), rl.right);
            trans(Sim::lvl_ix(tys, strs, sim2, l2, rl.left, pl2), sym(Sim::lvl_ix(tys, strs, sim0, l2, rl.left, rl.right)))
        });
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s2.unsteps(en.at), ws)) = λ en mem =>
        CSt::sels_keep(en.at, s2, ws2, s2, ws, λ l2 m2l => {
            let w = s.at_lvl(en, mem, l2, m2l);
            let rl = inv.words(l2, w);
            let ne: ¬(l2 = l) = λ eq => absurd(trans(sym(hf.left), j(eq, λ q _ => s.in_regions(q) = True, w)));
            let pl2: ((s2.role(l2)).plain() = True) = trans(cong_fn(λ (q: Role) => q.plain(), s.role_set_other(l, l2, KGone, ne, b, rl.left)), rl.right);
            trans(Sim::lvl_ix(tys, strs, sim2, l2, rl.left, pl2), sym(Sim::lvl_ix(tys, strs, sim0, l2, rl.left, rl.right)))
        });
    let killed: ((b2: Nat) → ¬(b2 = r.b) → Heap::obj(tys, h2, b2) = Heap::obj(tys, m.heap, b2)) = λ b2 ne => Heap::obj_kill_other(tys, m.heap, r.b, b2, ne);
    let dead: ((ob: Obj(tys)) → Heap::obj(tys, h2, r.b) = Some(ob) → False) = λ ob h1 => {
        let n0: (h2.nth(r.b) = Some(Dead) ∨ h2.nth(r.b) = None) = match m.heap.nth(r.b) as λ q => m.heap.nth(r.b) = q → (h2.nth(r.b) = Some(Dead) ∨ h2.nth(r.b) = None) {
            Some(bl) => λ hn => Inl(m.heap.nth_update_here(r.b, λ _ => Dead, bl, hn)),
            None => λ hn => Inr(m.heap.nth_update_none(r.b, λ _ => Dead, hn)),
        }(refl);
        match n0 {
            Inl(hd) => absurd(trans(sym(h1), cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o2) => Some(o2), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }, hd))),
            Inr(hn) => absurd(trans(sym(h1), cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o2) => Some(o2), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() }, hn))),
        }
    };
    let chg: s.Changes(o) = Inl(Exists(l, ⟨b, Exists(AcOwn, ⟨hr, refl⟩)⟩));
    Inv(j(sym(s2.patched_none(tys, strs, e, m2, none)), λ q _ => Sim(tys, strs, s2, q, m2), sim2), inv.root,
        λ x l2 h rr cr => CSt::refok_keep(s2, s2, inv.root, inv.root, ws, ws2, l2, rr, refl, refl, λ _ _ _ => refl, λ _ _ => refl,
            λ en mem => regs(en, s.views.mem_filter(en, λ q => q.lvl.same(l2), mem)), ig.refs(x, l2, h, rr, cr)),
        ig.apart,
        λ o2 r2 h1 => j(sym(lenh), λ n _ => r2.b < n, inv.inheap(o2, r2, h1)),
        ig.owned,
        ig.own,
        ig.one,
        ig.words,
        λ b2 bl nl => match Nat::eq_or_ne(b2, r.b) {
            Inl(eq) => match inv.owned(o, chg, r, rt) {
                Inl(lt) => absurd(trans(sym(nl), j(sym(eq), λ q _ => lent(q) = True, lt))),
                Inr(ge) => false_elim(Nat::lt_irrefl(b2, omega(bl, ge, eq))),
            },
            Inr(ne) => trans(m.heap.nth_update_other(r.b, λ _ => Dead, b2, ne), inv.frame(b2, bl, nl)),
        },
        j(sym(lenh), λ n _ => h0.len() <= n, inv.grows),
        ig.young,
        ig.held,
        ig.vents,
        λ o2 r2 h1 ob hob => match Nat::eq_or_ne(r2.b, r.b) {
            Inl(eq) => false_elim(dead(ob, j(eq, λ q _ => Heap::obj(tys, h2, q) = Some(ob), hob))),
            Inr(ne) => inv.bare(o2, r2, h1, ob, trans(sym(killed(r2.b, ne)), hob)),
        },
        ig.chain,
        CSt::excl_keep(tys, strs, s2, s2, ws, ws2, refl, omega(), λ en mem => (ig.chain(en, mem)).left, λ en mem => (ig.vents(en, mem)).right.left, regs, ig.excl), ig.wpar, ig.uni, ig.pone,
        CSt::cfit_ws(tys, strs, s2, m.env, ws, ws2, ats, ig.cfit), CSt::sib_keep(tys, strs, s2, s2, ws, ws2, refl, ats, ig.sib))
}

// ---------------------------------------------------------------------------
// The death stages: of a part (nothing), of a plain variable, of a holder

theorem Stmt::stage_death_part(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), x: Var, a: Step, rest: List<Step>): Stepped(tys, strs, fns, call, Death(Place(x, Cons(a, rest))), s, e, m, h0, lent)
{
    Stepped(m, λ k => refl, inv)
}

theorem Heap::obj_of_val(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), b: Nat, d: Dyn(tys), hv: Heap::val(tys, strs, h, b) = Some(d)): Exists<Obj(tys)>(λ o => Heap::obj(tys, h, b) = Some(o)) {
    (match Heap::obj(tys, h, b) as λ q => (match q { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None<Dyn(tys)>() }) = Some(d) → Exists<Obj(tys)>(λ o => q = Some(o)) {
        Some(o) => λ _ => Exists(o, refl),
        None => λ no => absurd(no),
    })(hv)
}

// What a referring cell reads at no selections, its block holds.
theorem Value::reads_live(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Ref, d: Dyn(tys), g: Value::Reads(tys, strs, h, Refer(r), d)): Exists<Obj(tys)>(λ o => Heap::obj(tys, h, r.b) = Some(o)) {
    (match Heap::val(tys, strs, h, r.b) as λ q => Heap::val(tys, strs, h, r.b) = q → (match q { Some(dv) => Sel::get(tys, strs, r.sels ++ Nil, dv), None => None<Dyn(tys)>() }) = Some(d) →
            Exists<Obj(tys)>(λ o => Heap::obj(tys, h, r.b) = Some(o)) {
        Some(dv) => λ hv _ => Heap::obj_of_val(tys, strs, h, r.b, dv, hv),
        None => λ _ no => absurd(no),
    })(refl, g)
}

theorem Stmt::death_keeps(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), x: Var, k: Mach(tys) → Ran(tys),
    keep: ((REnv::get(tys, m.env, x)).own = False) ∨ Exists<Dyn(tys)>(λ d => (REnv::get(tys, m.env, x)).v = level2::Plain(d))):
    (Death(Place(x, Nil))).run(tys, strs, fns, call, m, k) = k(m)
{
    let c = REnv::get(tys, m.env, x);
    let tail = λ (v: Value(tys)) => match v { Plain(_) => k(m), Refer(r) => match Heap::obj(tys, m.heap, r.b) { Some(_) => k(Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io)), None => Stuck } };
    match keep {
        Inl(no) => j(sym(no), λ b _ => (match b { False => k(m), True => tail(c.v) }) = k(m), refl),
        Inr(ex) => match ex { ⟨d, pv⟩ => match c.own { False => refl, True => j(sym(pv), λ v _ => tail(v) = k(m), refl) } },
    }
}

theorem Stmt::death_kills(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), x: Var, r: Ref, k: Mach(tys) → Ran(tys),
    co: (REnv::get(tys, m.env, x)).own = True, cr: (REnv::get(tys, m.env, x)).v = Refer(r), ob: Obj(tys), live: Heap::obj(tys, m.heap, r.b) = Some(ob)):
    (Death(Place(x, Nil))).run(tys, strs, fns, call, m, k) = k(Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io))
{
    let c = REnv::get(tys, m.env, x);
    let fin = k(Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io));
    j(sym(co), λ b _ => (match b { False => k(m), True => match c.v { Plain(_) => k(m), Refer(r1) => match Heap::obj(tys, m.heap, r1.b) { Some(_) => k(Mach(Heap::kill(tys, m.heap, r1.b), m.env, m.io)), None => Stuck } } }) = fin,
        j(sym(cr), λ v _ => (match v { Plain(_) => k(m), Refer(r1) => match Heap::obj(tys, m.heap, r1.b) { Some(_) => k(Mach(Heap::kill(tys, m.heap, r1.b), m.env, m.io)), None => Stuck } }) = fin,
            j(sym(live), λ q _ => (match q { Some(_) => fin, None => Stuck }) = fin, refl)))
}

theorem Stmt::stage_death_plain(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, x: Var, l: Nat, hl: s.lvl(x) = Some(l), hp: s.role(l) = KPlain, notreg: s.in_regions(l) = False):
    Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.set(l, KGone), e, m, h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let pv = Sim::plain_cell(tys, strs, sim, x, l, hl, j(sym(hp), λ q _ => q.plain() = True, refl));
    let nolvl: ((en: VEnt) → Mem(en, s.views) → ¬(en.lvl = l)) = λ en mem eq => absurd(trans(sym(j(eq, λ q _ => s.role(q) = KView, (inv.vents(en, mem)).right.right)), hp));
    let nopar: ((en: VEnt) → Mem(en, s.views) → ¬(en.par = l)) = λ en mem eq => {
        let p1: (match s.role(l) { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
            KPlain => False, KGone => False }) = j(eq, λ q _ => match s.role(q) { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(q), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
                KPlain => False, KGone => False }, (inv.chain(en, mem)).right);
        j(hp, λ q _ => match q { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
            KPlain => False, KGone => False }, p1)
    };
    Stepped(m, λ k => Stmt::death_keeps(tys, strs, fns, call, m, x, k, Inr(Exists(Env::get(tys, e, x), pv))),
        Inv::gone(tys, strs, inv, l, s.lvl_below(x, l, hl), notreg, nolvl, nopar))
}

theorem Stmt::stage_death_hold(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, x: Var, l, o: Nat, a: Acc, hl: s.lvl(x) = Some(l), hr: s.role(l) = KHold(o, a), nov: s.has_obj_views(o) = False):
    Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.set(l, KGone), e, m, h0, lent)
{
    let c = REnv::get(tys, m.env, x);
    let b = s.lvl_below(x, l, hl);
    let hf = Inv::hold_facts(tys, strs, inv, l, o, a, hr, nov);
    let gone = Inv::gone(tys, strs, inv, l, b, hf.left, hf.right.left, hf.right.right);
    let live: ¬((s.role(l)).same(KGone) = True) = λ g => absurd(trans(sym(g), cong_fn(λ (q: Role) => q.same(KGone), hr)));
    (match c.own as λ ow => c.own = ow → Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.set(l, KGone), e, m, h0, lent) {
        False => λ co => Stepped(m, λ k => Stmt::death_keeps(tys, strs, fns, call, m, x, k, Inl(co)), gone),
        True => λ co => (match c.v as λ v => c.v = v → Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.set(l, KGone), e, m, h0, lent) {
            Plain(d) => λ cv => Stepped(m, λ k => Stmt::death_keeps(tys, strs, fns, call, m, x, k, Inr(Exists(d, cv))), gone),
            Refer(r) => λ cr => match inv.own(x, l, hl, live, co, r, cr) {
                ⟨o1, po⟩ => {
                    let oo: (o1 = o) = cong_fn(Role::held, trans(sym(po.left), hr));
                    let hr1: (s.role(l) = KHold(o, AcOwn)) = j(oo, λ q _ => s.role(l) = KHold(q, AcOwn), po.left);
                    let rt: (inv.root(o) = Some(r)) = j(oo, λ q _ => inv.root(q) = Some(r), po.right.left);
                    let ex = λ (o2: Nat) (ne: ¬(o2 = o)) => po.right.right.right(o2, λ eq => ne(trans(eq, oo)));
                    let sim = Inv::sim_now(tys, strs, inv, none);
                    let rd: Value::Reads(tys, strs, m.heap, Refer(r), Env::get(tys, e, x)) =
                        j(cr, λ v _ => Value::Reads(tys, strs, m.heap, v, Env::get(tys, e, x)), Cell::agrees_val(tys, strs, m.heap, s.role(l), c, Env::get(tys, e, x), sim.vars(x, l, hl), live));
                    match Value::reads_live(tys, strs, m.heap, r, Env::get(tys, e, x), rd) {
                        ⟨ob, pob⟩ => Stepped(Mach(Heap::kill(tys, m.heap, r.b), m.env, m.io), λ k => Stmt::death_kills(tys, strs, fns, call, m, x, r, k, co, cr, ob, pob),
                            Inv::kill(tys, strs, inv, none, l, o, r, b, hr1, rt, ex, nov)),
                    }
                },
            },
        })(refl),
    })(refl)
}

// ---------------------------------------------------------------------------
// A binding of a holder: an object no live variable holds, its cell as a
// holder's is

theorem CSt::changes_push_hold(self s: CSt, code: Shape, o: Nat, a: Acc, o1: Nat, h: (s.push(CVar(code, KHold(o, a)))).Changes(o1)): s.Changes(o1) ∨ ((o1 = o) ∧ (a.writes() = True)) {
    let cv = CVar(code, KHold(o, a));
    match h {
        Inl(ex) => match ex {
            ⟨l, pl⟩ => match pl.right {
                ⟨a1, pa⟩ => match Nat::below_succ(l, s.na + s.nd, pl.left) {
                    Inr(at) => {
                        let e1: (KHold(o, a) = KHold(o1, a1)) = trans(sym(j(sym(at), λ q _ => (s.push(cv)).role(q) = cv.role, cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv)))), pa.left);
                        let ea: (a = a1) = cong_fn(λ (r: Role) => match r { KHold(_, x) => x, KPlain => AcRead, KView => AcRead, KGone => AcRead }, e1);
                        Inr(⟨sym(cong_fn(Role::held, e1)), j(sym(ea), λ q _ => q.writes() = True, pa.right)⟩)
                    },
                    Inl(c1) => Inl(Inl(Exists(l, ⟨c1, Exists(a1, ⟨trans(sym(s.role_push(cv, l, c1)), pa.left), pa.right⟩)⟩))),
                },
            },
        },
        Inr(ev) => Inl(Inr(ev)),
    }
}

theorem Inv::push_hold(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, code: Shape, o: Nat, a: Acc, c: Cell(tys), d: Dyn(tys), rd: Value::Reads(tys, strs, m.heap, c.v, d), okc: d.code = code,
    rf: (r: Ref) → c.v = Refer(r) → inv.root(o) = Some(r),
    ow: c.own = True → (r: Ref) → c.v = Refer(r) → (a = AcOwn) ∧ ((r.sels = Nil) ∧ ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → inv.root(o2) = Some(r2) → ¬(r2.b = r.b))),
    noh: (l: Nat) → (a2: Acc) → l < s.na + s.nd → s.role(l) = KHold(o, a2) → False,
    ho: o < s.nobj,
    wr: a.writes() = True → ((r: Ref) → inv.root(o) = Some(r) → (lent(r.b) = True) ∨ (h0.len() <= r.b)) ∧
        ((o2: Nat) → ¬(o2 = o) → (r1, r2: Ref) → inv.root(o) = Some(r1) → inv.root(o2) = Some(r2) → Ref::Apart(tys, strs, r1, r2))):
    Inv(tys, strs, s.push(CVar(code, KHold(o, a))), Env::push(tys, e, d), Mach::push(tys, m, c), h0, lent)
{
    let cv = CVar(code, KHold(o, a));
    let s2 = s.push(cv);
    let m2 = Mach::push(tys, m, c);
    let sim0 = Inv::sim_now(tys, strs, inv, none);
    let sim1: Sim(tys, strs, s2, Env::push(tys, e, d), m2) = Sim::push(tys, strs, sim0, cv, c, d, rd, okc);
    let sim2 = j(sym(s2.patched_none(tys, strs, Env::push(tys, e, d), m2, none)), λ q _ => Sim(tys, strs, s2, q, m2), sim1);
    let ws = Mach::ixs(tys, strs, m);
    let ws2 = Mach::ixs(tys, strs, m2);
    let rolen: (s2.role(s.na + s.nd) = KHold(o, a)) = cong_fn(λ (v: CVar) => v.role, s.var_pushed(cv));
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws)) = λ en mem =>
        CSt::sels_keep(en.reg, s2, ws2, s, ws, λ l2 m2l => CSt::ixs_push(tys, strs, s, cv, m, c, sim0.margs, l2, (inv.words(l2, s.region_lvl(en, mem, l2, m2l))).left));
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)) = λ en mem =>
        CSt::sels_keep(en.at, s2, ws2, s, ws, λ l2 m2l => CSt::ixs_push(tys, strs, s, cv, m, c, sim0.margs, l2, (inv.words(l2, s.at_lvl(en, mem, l2, m2l))).left));
    let newrole = λ (l: Nat) (at: l = s.na + s.nd) => j(sym(at), λ q _ => s2.role(q) = KHold(o, a), rolen);
    Inv(sim2, inv.root,
        λ x l h r cr => match s.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let cr1: (c.v = Refer(r)) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr);
                j(sym(newrole(l, nw.right)), λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s2.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r)),
                    KPlain => False, KGone => True }, rf(r, cr1))
            },
            Inr(⟨x0, p⟩) => {
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, m.env, c, x0))), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let below = s.lvl_below(x0, l, p.right);
                CSt::refok_keep(s, s2, inv.root, inv.root, ws, ws2, l, r, s.role_push(cv, l, below), refl, λ _ _ _ => refl, λ _ _ => refl,
                    λ en mem => regs(en, s.views.mem_filter(en, λ q => q.lvl.same(l), mem)),
                    inv.refs(x0, l, p.right, r, cr0))
            },
        },
        λ o1 o2 ne h1 r1 r2 e1 e2 => match s.changes_push_hold(code, o, a, o1, h1) {
            Inl(c0) => inv.apart(o1, o2, ne, c0, r1, r2, e1, e2),
            Inr(eq) => (wr(eq.right)).right(o2, λ e3 => ne(trans(eq.left, sym(e3))), r1, r2, j(eq.left, λ q _ => inv.root(q) = Some(r1), e1), e2),
        },
        inv.inheap,
        λ o1 h1 r1 e1 => match s.changes_push_hold(code, o, a, o1, h1) {
            Inl(c0) => inv.owned(o1, c0, r1, e1),
            Inr(eq) => (wr(eq.right)).left(r1, j(eq.left, λ q _ => inv.root(q) = Some(r1), e1)),
        },
        λ x l h lv co r cr => match s.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let cr1: (c.v = Refer(r)) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr);
                let co1: (c.own = True) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).own = True, co);
                let w = ow(co1, r, cr1);
                Exists(o, ⟨trans(newrole(l, nw.right), j(w.left, λ q _ => KHold(o, a) = KHold(o, q), refl)), ⟨rf(r, cr1), w.right⟩⟩)
            },
            Inr(⟨x0, p⟩) => {
                let get0 = REnv::get_push_up(tys, m.env, c, x0);
                let co0: ((REnv::get(tys, m.env, x0)).own = True) = trans(cong_fn(λ (q: Cell(tys)) => q.own, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).own = True, co));
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let rp = s.role_push(cv, l, s.lvl_below(x0, l, p.right));
                let lv0: ¬((s.role(l)).same(KGone) = True) = λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), rp), g));
                match inv.own(x0, l, p.right, lv0, co0, r, cr0) { ⟨o2, po⟩ => Exists(o2, ⟨trans(rp, po.left), po.right⟩) }
            },
        },
        λ l1 l2 o1 a1 a2 b1 b2 ne h1 h2 => match Nat::below_succ(l1, s.na + s.nd, b1) {
            Inr(at1) => match Nat::below_succ(l2, s.na + s.nd, b2) {
                Inr(at2) => ne(trans(at1, sym(at2))),
                Inl(c2) => {
                    let oo: (o = o1) = cong_fn(Role::held, trans(sym(newrole(l1, at1)), h1));
                    noh(l2, a2, c2, j(sym(oo), λ q _ => s.role(l2) = KHold(q, a2), trans(sym(s.role_push(cv, l2, c2)), h2)))
                },
            },
            Inl(c1) => match Nat::below_succ(l2, s.na + s.nd, b2) {
                Inr(at2) => {
                    let oo: (o = o1) = cong_fn(Role::held, trans(sym(newrole(l2, at2)), h2));
                    noh(l1, a1, c1, j(sym(oo), λ q _ => s.role(l1) = KHold(q, a1), trans(sym(s.role_push(cv, l1, c1)), h1)))
                },
                Inl(c2) => inv.one(l1, l2, o1, a1, a2, c1, c2, ne, trans(sym(s.role_push(cv, l1, c1)), h1), trans(sym(s.role_push(cv, l2, c2)), h2)),
            },
        },
        λ l w => {
            let ww = inv.words(l, w);
            ⟨omega(ww.left), trans(cong_fn(λ (q: Role) => q.plain(), s.role_push(cv, l, ww.left)), ww.right)⟩
        },
        inv.frame,
        inv.grows,
        inv.young,
        λ l o1 a1 b hr => match Nat::below_succ(l, s.na + s.nd, b) {
            Inr(at) => j(cong_fn(Role::held, trans(sym(newrole(l, at)), hr)), λ q _ => q < s.nobj, ho),
            Inl(c1) => inv.held(l, o1, a1, c1, trans(sym(s.role_push(cv, l, c1)), hr)),
        },
        λ en mem => {
            let vv = inv.vents(en, mem);
            ⟨vv.left, ⟨omega(vv.right.left), trans(s.role_push(cv, en.lvl, vv.right.left), vv.right.right)⟩⟩
        },
        inv.bare,
        λ en mem => {
            let cc = inv.chain(en, mem);
            ⟨cc.left, CSt::parent_keep(s, s2, en, s.role_push(cv, en.par, omega(cc.left, (inv.vents(en, mem)).right.left)), refl, cc.right)⟩
        },
        CSt::excl_keep(tys, strs, s, s2, ws, ws2, refl, omega(), λ en mem => (inv.chain(en, mem)).left, λ en mem => (inv.vents(en, mem)).right.left, regs, inv.excl),
        λ en mem w => CSt::wpar_keep(s, s2, en, s.role_push(cv, en.par, omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left)), refl, inv.wpar(en, mem, w)),
        CSt::uni_push(tys, s, cv, m.env, c, inv.uni, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at)))), inv.pone,
        CSt::cfit_push(tys, strs, s, cv, m.env, c, ws, ws2, inv.cfit, λ en mem => omega((inv.chain(en, mem)).left, (inv.vents(en, mem)).right.left),
            λ en mem at => false_elim(Nat::lt_irrefl(en.lvl, omega((inv.vents(en, mem)).right.left, at))), ats),
        CSt::sib_keep(tys, strs, s, s2, ws, ws2, refl, ats, inv.sib))
}

// ---------------------------------------------------------------------------
// The take stages: of a part (a copy), of a plain variable, of a holder

theorem Stmt::stage_take_part(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, x: Var, a: Step, rest: List<Step>, g: Got, ok: s.read(tys, cx.strs, Place(x, Cons(a, rest))) = Some(g),
    tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, Take(Place(x, Cons(a, rest))), s.push(CVar(g.code, KPlain)), Env::push(tys, e, (Place(x, Cons(a, rest))).val(tys, cx.strs, e)), m, h0, lent)
{
    let p = Place(x, Cons(a, rest));
    let sim = Inv::sim_now(tys, cx.strs, inv, none);
    let d = p.val(tys, cx.strs, e);
    let at = Sim::place(tys, cx, sl, sim, p, g, ok, tail, res);
    Stepped(Mach::push(tys, m, Cell::plain(tys, d)),
        λ k => j(sym(at), λ o _ => (match o { Some(x2) => k(Mach::push(tys, m, Cell::plain(tys, x2))), None => Stuck }) = k(Mach::push(tys, m, Cell::plain(tys, d))), refl),
        Inv::push_plain(tys, cx.strs, inv, none, g.code, d, False, Sim::place_code(tys, cx.strs, sim, p, g, ok)))
}

// A take of a whole variable pushes its cell.
theorem Stmt::take_runs(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), x: Var, d: Dyn(tys), v: Mach::val(tys, strs, m, x) = Some(d), k: Mach(tys) → Ran(tys)):
    (Take(Place(x, Nil))).run(tys, strs, fns, call, m, k) = k(Mach::push(tys, m, REnv::get(tys, m.env, x)))
{
    j(sym(v), λ o _ => (match o { Some(_) => k(Mach::push(tys, m, REnv::get(tys, m.env, x))), None => Stuck }) = k(Mach::push(tys, m, REnv::get(tys, m.env, x))), refl)
}

theorem Stmt::stage_take_plain(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, x: Var, g: Got, ok: s.read_var(tys, strs, x) = Some(g), hp: s.role(g.root) = KPlain):
    Stepped(tys, strs, fns, call, Take(Place(x, Nil)), s.push(CVar(g.code, KPlain)), Env::push(tys, e, Env::get(tys, e, x)), m, h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ri = s.read_inv(tys, strs, Place(x, Nil), g, ok);
    let c = REnv::get(tys, m.env, x);
    let d = Env::get(tys, e, x);
    let pv: (c.v = level2::Plain(d)) = Sim::plain_cell(tys, strs, sim, x, g.root, ri.lvl, j(sym(hp), λ q _ => q.plain() = True, refl));
    let iv = Inv::push_plain(tys, strs, inv, none, g.code, d, c.own, Sim::read_code(tys, strs, sim, x, g, ok));
    Stepped(Mach::push(tys, m, c), λ k => Stmt::take_runs(tys, strs, fns, call, m, x, d, Sim::read_val(tys, strs, sim, x, g, ok), k),
        j(sym(pv), λ v _ => Inv(tys, strs, s.push(CVar(g.code, KPlain)), Env::push(tys, e, d), Mach::push(tys, m, Cell(v, c.own)), h0, lent), iv))
}

theorem Stmt::stage_take_hold(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), none: s.pending() = False, x: Var, g: Got, ok: s.read_var(tys, strs, x) = Some(g), o: Nat, a: Acc,
    hr: s.role(g.root) = KHold(o, a), nov: s.has_obj_views(o) = False):
    Stepped(tys, strs, fns, call, Take(Place(x, Nil)), (s.set(g.root, KGone)).push(CVar(g.code, KHold(o, a))), Env::push(tys, e, Env::get(tys, e, x)), m, h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ri = s.read_inv(tys, strs, Place(x, Nil), g, ok);
    let l = g.root;
    let b = s.lvl_below(x, l, ri.lvl);
    let c = REnv::get(tys, m.env, x);
    let d = Env::get(tys, e, x);
    let live: ¬((s.role(l)).same(KGone) = True) = λ gg => absurd(trans(sym(gg), cong_fn(λ (q: Role) => q.same(KGone), hr)));
    let hf = Inv::hold_facts(tys, strs, inv, l, o, a, hr, nov);
    let ig = Inv::gone(tys, strs, inv, l, b, hf.left, hf.right.left, hf.right.right);
    let s1 = s.set(l, KGone);
    let rd: Value::Reads(tys, strs, m.heap, c.v, d) = Cell::agrees_val(tys, strs, m.heap, s.role(l), c, d, sim.vars(x, l, ri.lvl), live);
    let okc: (d.code = g.code) = Sim::read_code(tys, strs, sim, x, g, ok);
    let rf: ((r: Ref) → c.v = Refer(r) → inv.root(o) = Some(r)) = λ r cr =>
        j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(Mach::ixs(tys, strs, m), s.unsteps(en.reg))) = Some(r)),
            KPlain => False, KGone => True }, inv.refs(x, l, ri.lvl, r, cr));
    let ow: (c.own = True → (r: Ref) → c.v = Refer(r) → (a = AcOwn) ∧ ((r.sels = Nil) ∧ ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → inv.root(o2) = Some(r2) → ¬(r2.b = r.b)))) =
        λ co r cr => match inv.own(x, l, ri.lvl, live, co, r, cr) {
        ⟨o1, po⟩ => {
            let e1: (KHold(o1, AcOwn) = KHold(o, a)) = trans(sym(po.left), hr);
            let oo: (o1 = o) = cong_fn(Role::held, e1);
            let aa: (AcOwn = a) = cong_fn(λ (q: Role) => match q { KHold(_, y) => y, KPlain => AcRead, KView => AcRead, KGone => AcRead }, e1);
            ⟨sym(aa), ⟨po.right.right.left, λ o2 ne => po.right.right.right(o2, λ eq => ne(trans(eq, oo)))⟩⟩
        },
    };
    let noh: ((l2: Nat) → (a2: Acc) → l2 < s1.na + s1.nd → s1.role(l2) = KHold(o, a2) → False) = λ l2 a2 b2 h2 => match Nat::eq_or_ne(l2, l) {
        Inl(eq) => absurd(trans(sym(h2), j(sym(eq), λ q _ => s1.role(q) = KGone, s.set_gone_role(l)))),
        Inr(ne) => inv.one(l2, l, o, a2, a, b2, b, ne, trans(sym(s.role_set_other(l, l2, KGone, ne, b, b2)), h2), hr),
    };
    let wr: (a.writes() = True → ((r: Ref) → inv.root(o) = Some(r) → (lent(r.b) = True) ∨ (h0.len() <= r.b)) ∧
            ((o2: Nat) → ¬(o2 = o) → (r1, r2: Ref) → inv.root(o) = Some(r1) → inv.root(o2) = Some(r2) → Ref::Apart(tys, strs, r1, r2))) = λ w => {
        let chg: s.Changes(o) = Inl(Exists(l, ⟨b, Exists(a, ⟨hr, w⟩)⟩));
        ⟨λ r rt => inv.owned(o, chg, r, rt), λ o2 ne r1 r2 e1 e2 => inv.apart(o, o2, λ eq => ne(sym(eq)), chg, r1, r2, e1, e2)⟩
    };
    let ip = Inv::push_hold(tys, strs, ig, none, g.code, o, a, c, d, rd, okc, rf, ow, noh, inv.held(l, o, a, b, hr), wr);
    Stepped(Mach::push(tys, m, c), λ k => Stmt::take_runs(tys, strs, fns, call, m, x, d, Sim::read_val(tys, strs, sim, x, g, ok), k), ip)
}

// ---------------------------------------------------------------------------
// The licence's apartness: the decider on regions at levels is the decider
// on the same regions at indices, so its obligations, owed as residuals at
// the site, give the regions apart at the words

fn CSt::unobl(self s: CSt, o: Obligation) → Obligation {
    match o { Spans(a, b, c, d) => Spans(s.unatom(a), s.unatom(b), s.unatom(c), s.unatom(d)), Keys(a, b, c, d) => Keys(s.unatom(a), s.unatom(b), s.unatom(c), s.unatom(d)) }
}

fn CSt::InRange(self s: CSt, ls: List<Nat>) → Type { (l: Nat) → l.member(ls) = True → l < s.na + s.nd }

theorem CSt::range_app(self s: CSt, xs, ys: List<Nat>, h: s.InRange(xs ++ ys)): s.InRange(xs) ∧ s.InRange(ys) {
    ⟨λ l m => h(l, l.member_app_l(xs, ys, m)), λ l m => h(l, l.member_app_r(xs, ys, m))⟩
}

theorem CSt::ix_of_inj(self s: CSt, l, l2: Nat, b: l < s.na + s.nd, b2: l2 < s.na + s.nd, e: s.ix_of(l) = s.ix_of(l2)): l = l2 {
    (match (l + 1).leb(s.na) as λ c1 => (l + 1).leb(s.na) = c1 → (match c1 as λ _ => Nat { True => l, False => s.na + (s.nd - 1 - (l - s.na)) }) = s.ix_of(l2) → l = l2 {
        True => λ e1 eq => (match (l2 + 1).leb(s.na) as λ c2 => (l2 + 1).leb(s.na) = c2 → l = (match c2 as λ _ => Nat { True => l2, False => s.na + (s.nd - 1 - (l2 - s.na)) }) → l = l2 {
            True => λ _ q => q,
            False => λ e2 q => {
                let ge2: ¬(l2 + 1 <= s.na) = λ le => absurd(trans(sym(e2), Nat::leb_true(l2 + 1, s.na, le)));
                let na = s.na;
                let nd = s.nd;
                let q2: (l = na + (nd - 1 - (l2 - na))) = q;
                let b4: (l2 < na + nd) = b2;
                omega(Nat::le_of_leb(l + 1, s.na, e1), q2, ge2, b4)
            },
        })(refl, eq),
        False => λ e1 eq => (match (l2 + 1).leb(s.na) as λ c2 => (l2 + 1).leb(s.na) = c2 → s.na + (s.nd - 1 - (l - s.na)) = (match c2 as λ _ => Nat { True => l2, False => s.na + (s.nd - 1 - (l2 - s.na)) }) → l = l2 {
            True => λ e2 q => {
                let ge: ¬(l + 1 <= s.na) = λ le => absurd(trans(sym(e1), Nat::leb_true(l + 1, s.na, le)));
                let na = s.na;
                let nd = s.nd;
                let q2: (na + (nd - 1 - (l - na)) = l2) = q;
                let b3: (l < na + nd) = b;
                omega(Nat::le_of_leb(l2 + 1, s.na, e2), q2, ge, b3)
            },
            False => λ e2 q => {
                let ge: ¬(l + 1 <= s.na) = λ le => absurd(trans(sym(e1), Nat::leb_true(l + 1, s.na, le)));
                let ge2: ¬(l2 + 1 <= s.na) = λ le => absurd(trans(sym(e2), Nat::leb_true(l2 + 1, s.na, le)));
                let na = s.na;
                let nd = s.nd;
                let q2: (na + (nd - 1 - (l - na)) = na + (nd - 1 - (l2 - na))) = q;
                let b3: (l < na + nd) = b;
                let b4: (l2 < na + nd) = b2;
                omega(q2, ge, ge2, b3, b4)
            },
        })(refl, eq),
    })(refl, e)
}

// Unatoms of atoms at levels in range compare as the atoms.
theorem CSt::unatom_same(self s: CSt, a, b: Atom, ra: s.InRange(a.lvls()), rb: s.InRange(b.lvls())): (s.unatom(a)).same(s.unatom(b)) = a.same(b) {
    (match a as λ x => s.InRange(x.lvls()) → (s.unatom(x)).same(s.unatom(b)) = x.same(b) {
        Lit(n) => λ _ => (match b as λ y => s.InRange(y.lvls()) → Atom::same(Lit(n), s.unatom(y)) = Atom::same(Lit(n), y) {
            Lit(_) => λ _ => refl,
            Var(l2) => λ _ => j(sym(s.unatom_var(l2)), λ q _ => Atom::same(Lit(n), q) = False, refl),
        })(rb),
        Var(l) => λ rl => (match b as λ y => s.InRange(y.lvls()) → Atom::same(s.unatom(Var(l)), s.unatom(y)) = Atom::same(Var(l), y) {
            Lit(m) => λ _ => j(sym(s.unatom_var(l)), λ q _ => Atom::same(q, Lit(m)) = False, refl),
            Var(l2) => λ rl2 => {
                let b1: (l < s.na + s.nd) = rl(l, trans(cong_fn(λ (c: Bool) => c || False, l.same_self()), refl));
                let b2: (l2 < s.na + s.nd) = rl2(l2, trans(cong_fn(λ (c: Bool) => c || False, l2.same_self()), refl));
                let lhs: ((s.unatom(Var(l))).same(s.unatom(Var(l2))) = (s.ix_of(l)).same(s.ix_of(l2))) =
                    trans(cong_fn(λ (q: Atom) => Atom::same(q, s.unatom(Var(l2))), s.unatom_var(l)), cong_fn(λ (q: Atom) => Atom::same(Var(s.ix_of(l)), q), s.unatom_var(l2)));
                trans(lhs, match Nat::eq_or_ne(l, l2) {
                    Inl(eq) => trans(j(eq, λ q _ => (s.ix_of(l)).same(s.ix_of(q)) = True, (s.ix_of(l)).same_self()), sym(j(eq, λ q _ => l.same(q) = True, l.same_self()))),
                    Inr(ne) => trans(Nat::same_false(s.ix_of(l), s.ix_of(l2), λ e => ne(s.ix_of_inj(l, l2, b1, b2, e))), sym(Nat::same_false(l, l2, ne))),
                })
            },
        })(rb),
    })(ra)
}

theorem Span::apart_of(lo1, n1, lo2, n2: Nat, h: (lo1 + n1 <= lo2) ∨ (lo2 + n2 <= lo1)): Span(lo1, n1).apart(Span(lo2, n2)).IsTrue() {
    match h { Inl(le) => omega(le), Inr(le) => omega(le) }
}

theorem CSt::unatom_closed(self s: CSt, a: Atom): (s.unatom(a)).closed() = a.closed() {
    match a { Lit(_) => refl, Var(l) => j(sym(s.unatom_var(l)), λ q _ => q.closed() = False, refl) }
}

theorem CSt::unatom_lit(self s: CSt, a: Atom, h: a.closed() = True): s.unatom(a) = a {
    (match a as λ x => x.closed() = True → s.unatom(x) = x { Lit(_) => λ _ => refl, Var(_) => λ no => absurd(no) })(h)
}

theorem Bool::and4_parts(a, b, c, d: Bool, h: (a && b && c && d) = True): (a = True) ∧ ((b = True) ∧ ((c = True) ∧ (d = True))) {
    let p3 = Bool::and_true_parts(a && b && c, d, h);
    let p2 = Bool::and_true_parts(a && b, c, p3.left);
    let p1 = Bool::and_true_parts(a, b, p2.left);
    ⟨p1.left, ⟨p1.right, ⟨p2.right, p3.right⟩⟩⟩
}

// A closed obligation is its own unatom.
theorem CSt::unobl_closed(self s: CSt, o: Obligation, h: o.closed() = True): s.unobl(o) = o {
    (match o as λ x => x.closed() = True → s.unobl(x) = x {
        Spans(a, b, c, d) => λ hc => {
            let p = Bool::and4_parts(a.closed(), b.closed(), c.closed(), d.closed(), hc);
            rewrite(s.unatom_lit(a, p.left), s.unatom_lit(b, p.right.left), s.unatom_lit(c, p.right.right.left), s.unatom_lit(d, p.right.right.right), refl)
        },
        Keys(a, b, c, d) => λ hc => {
            let p = Bool::and4_parts(a.closed(), b.closed(), c.closed(), d.closed(), hc);
            rewrite(s.unatom_lit(a, p.left), s.unatom_lit(b, p.right.left), s.unatom_lit(c, p.right.right.left), s.unatom_lit(d, p.right.right.right), refl)
        },
    })(h)
}

theorem CSt::unobl_closed_bit(self s: CSt, o: Obligation): (s.unobl(o)).closed() = o.closed() {
    match o {
        Spans(a, b, c, d) => {
            let r: (((s.unatom(a)).closed() && (s.unatom(b)).closed() && (s.unatom(c)).closed() && (s.unatom(d)).closed()) = (a.closed() && b.closed() && c.closed() && d.closed())) =
                rewrite(s.unatom_closed(a), s.unatom_closed(b), s.unatom_closed(c), s.unatom_closed(d), refl);
            r
        },
        Keys(a, b, c, d) => {
            let r: (((s.unatom(a)).closed() && (s.unatom(b)).closed() && (s.unatom(c)).closed() && (s.unatom(d)).closed()) = (a.closed() && b.closed() && c.closed() && d.closed())) =
                rewrite(s.unatom_closed(a), s.unatom_closed(b), s.unatom_closed(c), s.unatom_closed(d), refl);
            r
        },
    }
}

// Settling an obligation at indices settles it at levels, unatomed.
theorem CSt::settle_un(self s: CSt, o: Obligation): (s.unobl(o)).settle() = (o.settle()).map(λ os => os.map(λ x => s.unobl(x))) {
    (match o.closed() as λ c => o.closed() = c → (match (s.unobl(o)).closed() { True => (s.unobl(o)).verdict(Nil).then(Some(Nil<Obligation>)), False => Some([s.unobl(o)]) }) =
            (match c { True => o.verdict(Nil).then(Some(Nil<Obligation>)), False => Some([o]) }).map(λ os => os.map(λ x => s.unobl(x))) {
        True => λ hc => {
            let same: (s.unobl(o) = o) = s.unobl_closed(o, hc);
            j(sym(same), λ q _ => (match q.closed() { True => q.verdict(Nil).then(Some(Nil<Obligation>)), False => Some([q]) }) = (o.verdict(Nil).then(Some(Nil<Obligation>))).map(λ os => os.map(λ x => s.unobl(x))),
                j(sym(hc), λ c2 _ => (match c2 { True => o.verdict(Nil).then(Some(Nil<Obligation>)), False => Some([o]) }) = (o.verdict(Nil).then(Some(Nil<Obligation>))).map(λ os => os.map(λ x => s.unobl(x))),
                    match o.verdict(Nil) { True => refl, False => refl }))
        },
        False => λ hc => j(sym(trans(s.unobl_closed_bit(o), hc)), λ c2 _ => (match c2 { True => (s.unobl(o)).verdict(Nil).then(Some(Nil<Obligation>)), False => Some([s.unobl(o)]) }) = Some([s.unobl(o)]), refl),
    })(refl)
}

theorem CSt::unstep_same(self s: CSt, a, b: Step, ra: s.InRange(a.lvls()), rb: s.InRange(b.lvls())): (s.unstep(a)).same(s.unstep(b)) = a.same(b) {
    (match a as λ x => s.InRange(x.lvls()) → (s.unstep(x)).same(s.unstep(b)) = x.same(b) {
        SField(_) => λ _ => match b { SField(_) => refl, SElem(_) => refl, SWindow(_, _) => refl, SKey(_, _) => refl, SVariant(_) => refl },
        SVariant(_) => λ _ => match b { SField(_) => refl, SElem(_) => refl, SWindow(_, _) => refl, SKey(_, _) => refl, SVariant(_) => refl },
        SElem(i) => λ ri => (match b as λ y => s.InRange(y.lvls()) → (SElem(s.unatom(i))).same(s.unstep(y)) = (SElem(i)).same(y) {
            SElem(k) => λ rk => s.unatom_same(i, k, ri, rk),
            SField(_) => λ _ => refl, SWindow(_, _) => λ _ => refl, SKey(_, _) => λ _ => refl, SVariant(_) => λ _ => refl,
        })(rb),
        SWindow(lo, n) => λ rw => (match b as λ y => s.InRange(y.lvls()) → (SWindow(s.unatom(lo), s.unatom(n))).same(s.unstep(y)) = (SWindow(lo, n)).same(y) {
            SWindow(lo2, n2) => λ rw2 => {
                let p1 = s.range_app(lo.lvls(), n.lvls(), rw);
                let p2 = s.range_app(lo2.lvls(), n2.lvls(), rw2);
                let r: ((Atom::same(s.unatom(lo), s.unatom(lo2)) && Atom::same(s.unatom(n), s.unatom(n2))) = (Atom::same(lo, lo2) && Atom::same(n, n2))) =
                    rewrite(s.unatom_same(lo, lo2, p1.left, p2.left), s.unatom_same(n, n2, p1.right, p2.right), refl);
                r
            },
            SField(_) => λ _ => refl, SElem(_) => λ _ => refl, SKey(_, _) => λ _ => refl, SVariant(_) => λ _ => refl,
        })(rb),
        SKey(i, g) => λ rk => (match b as λ y => s.InRange(y.lvls()) → (SKey(s.unatom(i), s.unatom(g))).same(s.unstep(y)) = (SKey(i, g)).same(y) {
            SKey(i2, g2) => λ rk2 => {
                let p1 = s.range_app(i.lvls(), g.lvls(), rk);
                let p2 = s.range_app(i2.lvls(), g2.lvls(), rk2);
                let r: ((Atom::same(s.unatom(i), s.unatom(i2)) && Atom::same(s.unatom(g), s.unatom(g2))) = (Atom::same(i, i2) && Atom::same(g, g2))) =
                    rewrite(s.unatom_same(i, i2, p1.left, p2.left), s.unatom_same(g, g2, p1.right, p2.right), refl);
                r
            },
            SField(_) => λ _ => refl, SElem(_) => λ _ => refl, SWindow(_, _) => λ _ => refl, SVariant(_) => λ _ => refl,
        })(rb),
    })(ra)
}

fn CSt::unobls(self s: CSt, oo: Option<List<Obligation>>) → Option<List<Obligation>> { oo.map(λ os => os.map(λ x => s.unobl(x))) }

theorem Bool::then_nil_un(self c: Bool, s: CSt): s.unobls(c.then(Some(Nil<Obligation>))) = c.then(Some(Nil<Obligation>)) { match c { True => refl, False => refl } }

theorem CSt::unstep_apart(self s: CSt, a, b: Step): (s.unstep(a)).apart(s.unstep(b)) = s.unobls(a.apart(b)) {
    match a {
        SField(i) => match b { SField(k) => sym(Span(i, 1).apart(Span(k, 1)).then_nil_un(s)), SElem(_) => refl, SWindow(_, _) => refl, SKey(_, _) => refl, SVariant(_) => refl },
        SVariant(c) => match b { SVariant(d) => sym((!c.same(d)).then_nil_un(s)), SField(_) => refl, SElem(_) => refl, SWindow(_, _) => refl, SKey(_, _) => refl },
        SElem(i) => match b {
            SElem(k) => s.settle_un(Spans(i, Lit(1), k, Lit(1))),
            SWindow(lo, n) => s.settle_un(Spans(i, Lit(1), lo, n)),
            SField(_) => refl, SKey(_, _) => refl, SVariant(_) => refl,
        },
        SWindow(lo, n) => match b {
            SElem(k) => s.settle_un(Spans(lo, n, k, Lit(1))),
            SWindow(lo2, n2) => s.settle_un(Spans(lo, n, lo2, n2)),
            SField(_) => refl, SKey(_, _) => refl, SVariant(_) => refl,
        },
        SKey(i, g) => match b { SKey(i2, g2) => s.settle_un(Keys(i, g, i2, g2)), SField(_) => refl, SElem(_) => refl, SWindow(_, _) => refl, SVariant(_) => refl },
    }
}

// The decider on regions at indices is the decider at levels, unatomed,
// where every level is in range.
theorem CSt::unsteps_apart(self xs: List<Step>, s: CSt): (ys: List<Step>) → s.InRange(Steps::lvls(xs)) → s.InRange(Steps::lvls(ys)) →
    Steps::apart(s.unsteps(xs), s.unsteps(ys)) = s.unobls(Steps::apart(xs, ys))
{
    match xs {
        Nil => λ ys _ _ => refl,
        Cons(a, xr) => λ ys => match ys {
            Nil => λ _ _ => refl,
            Cons(b, yr) => λ rx ry => {
                let px = s.range_app(a.lvls(), Steps::lvls(xr), rx);
                let py = s.range_app(b.lvls(), Steps::lvls(yr), ry);
                trans(cong_fn(λ (c: Bool) => match c { True => Steps::apart(s.unsteps(xr), s.unsteps(yr)), False => (s.unstep(a)).apart(s.unstep(b)) }, s.unstep_same(a, b, px.left, py.left)),
                    (match a.same(b) as λ c => (match c { True => Steps::apart(s.unsteps(xr), s.unsteps(yr)), False => (s.unstep(a)).apart(s.unstep(b)) }) =
                            s.unobls(match c { True => Steps::apart(xr, yr), False => a.apart(b) }) {
                        True => CSt::unsteps_apart(xr, s, yr, px.right, py.right),
                        False => s.unstep_apart(a, b),
                    }))
            },
        },
    }
}

// What the checker owes for an obligation holds of it at indices, unatomed.
theorem CSt::owed_one(self s: CSt, tys: Nat → Type, cx: Ctx(tys), env: Env(tys), o: Obligation, r: Residual, h: s.owed(o) = Some(r), hr: r.Holds(tys, cx, env)):
    (s.unobl(o)).Holds(Ix::nats(Env::ixs(tys, env)))
{
    (match o as λ x => s.owed(x) = Some(r) → (s.unobl(x)).Holds(Ix::nats(Env::ixs(tys, env))) {
        Spans(a, b, c, d) => λ e => {
            let eq: (RApart(s.unatom(a), s.unatom(b), s.unatom(c), s.unatom(d)) = r) = Option::some_inj(RApart(s.unatom(a), s.unatom(b), s.unatom(c), s.unatom(d)), r, e);
            let ns = Ix::nats(Env::ixs(tys, env));
            let h2: (((s.unatom(a)).val(ns) + (s.unatom(b)).val(ns) <= (s.unatom(c)).val(ns)) ∨ ((s.unatom(c)).val(ns) + (s.unatom(d)).val(ns) <= (s.unatom(a)).val(ns))) =
                j(sym(eq), λ q _ => q.Holds(tys, cx, env), hr);
            Span::apart_of((s.unatom(a)).val(ns), (s.unatom(b)).val(ns), (s.unatom(c)).val(ns), (s.unatom(d)).val(ns), h2)
        },
        Keys(_, _, _, _) => λ no => absurd(no),
    })(h)
}

theorem CSt::owed_holds(self os: List<Obligation>, s: CSt, tys: Nat → Type, cx: Ctx(tys), env: Env(tys)): (rs: List<Residual>) → s.owed_all(os) = Some(rs) →
    Residual::All(rs, tys, cx, env, True) → Obligation::All(os.map(λ o => s.unobl(o)), Ix::nats(Env::ixs(tys, env)))
{
    match os {
        Nil => λ rs _ _ => trivial,
        Cons(o, rest) => λ rs h hold => {
            let p1 = Option::and_then_some(s.owed(o), λ r => s.owed_all(rest).map(λ rs2 => Cons(r, rs2)), rs, h);
            let r = p1.witness;
            let p2 = Option::map_some_inv(s.owed_all(rest), λ (rs2: List<Residual>) => Cons(r, rs2), rs, p1.proof.right);
            let hold2: Residual::All(Cons(r, p2.witness), tys, cx, env, True) = j(sym(p2.proof.right), λ q _ => Residual::All(q, tys, cx, env, True), hold);
            ⟨s.owed_one(tys, cx, env, o, r, p1.proof.left, hold2.left), CSt::owed_holds(rest, s, tys, cx, env, p2.witness, p2.proof.left, hold2.right)⟩
        },
    }
}

// Apartness carried along pointwise equal reads and modifications.
theorem ApartAt::transfer<S>({at1, at2: S → S}, {over1, over2: (S → S) → S → S}, at1b, at2b: S → S, over1b, over2b: (S → S) → S → S,
    e1: (s: S) → at1(s) = at1b(s), e2: (s: S) → at2(s) = at2b(s), o1: (g: S → S) → (s: S) → over1(g, s) = over1b(g, s), o2: (g: S → S) → (s: S) → over2(g, s) = over2b(g, s),
    h: ApartAt<S>(at1, over1, at2, over2)): ApartAt<S>(at1b, over1b, at2b, over2b)
{
    ApartAt(
        λ g s => trans(cong_fn(at1b, sym(o2(g, s))), trans(sym(e1(over2(g, s))), trans(h.left_after_right(g, s), e1(s)))),
        λ g s => trans(cong_fn(at2b, sym(o1(g, s))), trans(sym(e2(over1(g, s))), trans(h.right_after_left(g, s), e2(s)))),
        λ f g s => trans(cong_fn(λ (x: S) => over1b(f, x), sym(o2(g, s))), trans(sym(o1(f, over2(g, s))), trans(h.commute(f, g, s),
            trans(o2(g, over1(f, s)), cong_fn(λ (x: S) => over2b(g, x), o1(f, s)))))))
}

// Whether a place fits, as the run reads it: the model's, at the place's
// selections; and a path extended, fits as its two parts.
theorem Steps::fit_sels(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs: List<Step>): (d: Dyn(tys)) →
    Steps::fit(Dyn::model(tys, strs), ws, xs, d) = Sel::fit(tys, strs, Steps::sels(xs, ws), d)
{
    match xs {
        Nil => λ d => refl,
        Cons(a, rest) => λ d => cong_fn(λ (q: Bool) => Dyn::fits(tys, strs, a.sel(ws), d) && q, Steps::fit_sels(tys, strs, ws, rest, Dyn::at(tys, strs, a.sel(ws), d))),
    }
}

theorem Steps::apart_reads(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs, ys: List<Step>, h: Steps::Apart(Dyn::model(tys, strs), ws, xs, ys)):
    ApartAt<Dyn(tys)>(λ d => Sel::read_at(tys, strs, Steps::sels(xs, ws), d), λ g d => Sel::write_at(tys, strs, Steps::sels(xs, ws), g, d),
        λ d => Sel::read_at(tys, strs, Steps::sels(ys, ws), d), λ g d => Sel::write_at(tys, strs, Steps::sels(ys, ws), g, d))
{
    ApartAt::transfer(λ d => Sel::read_at(tys, strs, Steps::sels(xs, ws), d), λ d => Sel::read_at(tys, strs, Steps::sels(ys, ws), d),
        λ g d => Sel::write_at(tys, strs, Steps::sels(xs, ws), g, d), λ g d => Sel::write_at(tys, strs, Steps::sels(ys, ws), g, d),
        Steps::read_sels(tys, strs, ws, xs), Steps::read_sels(tys, strs, ws, ys),
        λ g => Steps::write_sels(tys, strs, ws, xs, g), λ g => Steps::write_sels(tys, strs, ws, ys, g), h)
}

theorem Steps::apart_sels(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, xs, ys: List<Step>, h: Steps::Apart(Dyn::model(tys, strs), ws, xs, ys),
    kf: And<Steps::KeepsFit(Dyn::model(tys, strs), ws, xs, ys), Steps::KeepsFit(Dyn::model(tys, strs), ws, ys, xs)>):
    Sel::Apart(tys, strs, Steps::sels(xs, ws), Steps::sels(ys, ws))
{
    let f1 = λ (g: Dyn(tys) → Dyn(tys)) (d: Dyn(tys)) =>
        trans(sym(Steps::fit_sels(tys, strs, ws, xs, Sel::write_at(tys, strs, Steps::sels(ys, ws), g, d))),
            trans(cong_fn(λ (t: Dyn(tys)) => Steps::fit(Dyn::model(tys, strs), ws, xs, t), sym(Steps::write_sels(tys, strs, ws, ys, g, d))),
                trans(kf.right(g, d), Steps::fit_sels(tys, strs, ws, xs, d))));
    let f2 = λ (g: Dyn(tys) → Dyn(tys)) (d: Dyn(tys)) =>
        trans(sym(Steps::fit_sels(tys, strs, ws, ys, Sel::write_at(tys, strs, Steps::sels(xs, ws), g, d))),
            trans(cong_fn(λ (t: Dyn(tys)) => Steps::fit(Dyn::model(tys, strs), ws, ys, t), sym(Steps::write_sels(tys, strs, ws, xs, g, d))),
                trans(kf.left(g, d), Steps::fit_sels(tys, strs, ws, ys, d))));
    SelApart(Steps::apart_reads(tys, strs, ws, xs, ys, h), f1, f2)
}

// One live entry against one place of its object: what the licence owes,
// holding at the meaning's words, gives their selections apart; and where the
// entry's region and the place share a prefix, the parts after it, the
// decider walking a common prefix as it is (`Steps::apart_prefix`).
theorem CSt::against_sound(self s: CSt, tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), env: Env(tys), en: VEnt, pl: Pl, rs: List<Residual>,
    ok: s.against(en, pl) = Some(rs), hold: Residual::All(rs, tys, cx, env, True), same: en.obj = pl.obj, pre, xa, xb: List<Step>, ea: en.reg = pre ++ xa, eb: pl.at = pre ++ xb,
    r1: s.InRange(Steps::lvls(xa)), r2: s.InRange(Steps::lvls(xb))):
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(xa), Env::ixs(tys, env)), Steps::sels(s.unsteps(xb), Env::ixs(tys, env)))
{
    let w = Env::ixs(tys, env);
    let ok0: (Steps::apart(en.reg, pl.at).and_then(λ os => s.owed_all(os)) = Some(rs)) =
        j(j(same, λ q _ => en.obj.same(q) = True, en.obj.same_self()), λ c _ => (match c { False => Some(Nil<Residual>), True => Steps::apart(en.reg, pl.at).and_then(λ os => s.owed_all(os)) }) = Some(rs), ok);
    let dec: (Steps::apart(en.reg, pl.at) = Steps::apart(xa, xb)) =
        trans(cong_fn(λ (q: List<Step>) => Steps::apart(q, pl.at), ea), trans(cong_fn(λ (q: List<Step>) => Steps::apart(pre ++ xa, q), eb), Steps::apart_prefix(pre, xa, xb)));
    let ok1: (Steps::apart(xa, xb).and_then(λ os => s.owed_all(os)) = Some(rs)) = j(dec, λ q _ => q.and_then(λ os => s.owed_all(os)) = Some(rs), ok0);
    let p = Option::and_then_some(Steps::apart(xa, xb), λ os => s.owed_all(os), rs, ok1);
    let os = p.witness;
    let un: (Steps::apart(s.unsteps(xa), s.unsteps(xb)) = Some(os.map(λ o => s.unobl(o)))) =
        trans(CSt::unsteps_apart(xa, s, xb, r1, r2), cong_fn(λ (q: Option<List<Obligation>>) => s.unobls(q), p.proof.left));
    let oh = CSt::owed_holds(os, s, tys, cx, env, rs, p.proof.right, hold);
    Steps::apart_sels(tys, cx.strs, w, s.unsteps(xa), s.unsteps(xb),
        Steps::apart_sound(Dyn::model(tys, cx.strs), Dyn::model_laws(tys, cx.strs, sl), w, s.unsteps(xa), s.unsteps(xb), os.map(λ o => s.unobl(o)), un, oh),
        Steps::apart_fit(Dyn::model(tys, cx.strs), Dyn::model_laws(tys, cx.strs, sl), w, s.unsteps(xa), s.unsteps(xb), os.map(λ o => s.unobl(o)), un, oh))
}

theorem CSt::against_all_sound(self ps: List<Pl>, s: CSt, tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), env: Env(tys), en: VEnt): (rs: List<Residual>) →
    s.against_all(en, ps) = Some(rs) → Residual::All(rs, tys, cx, env, True) → (pl: Pl) → Mem(pl, ps) → en.obj = pl.obj →
    (pre, xa, xb: List<Step>) → en.reg = pre ++ xa → pl.at = pre ++ xb → s.InRange(Steps::lvls(xa)) → s.InRange(Steps::lvls(xb)) →
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(xa), Env::ixs(tys, env)), Steps::sels(s.unsteps(xb), Env::ixs(tys, env)))
{
    match ps {
        Nil => λ rs _ _ pl m => false_elim(m),
        Cons(p0, rest) => λ rs ok hold pl m same pre xa xb ea eb r1 r2 => {
            let a1 = Option::and_then_some(s.against(en, p0), λ q1 => s.against_all(en, rest).map(λ q2 => q1 ++ q2), rs, ok);
            let a2 = Option::map_some_inv(s.against_all(en, rest), λ (q2: List<Residual>) => a1.witness ++ q2, rs, a1.proof.right);
            let sp = Residual::all_app(tys, cx, env, True, a1.witness, a2.witness, j(sym(a2.proof.right), λ q _ => Residual::All(q, tys, cx, env, True), hold));
            match m {
                Inl(e0) => s.against_sound(tys, cx, sl, env, en, p0, a1.witness, a1.proof.left, sp.left, trans(same, cong_fn(λ (q: Pl) => q.obj, e0)), pre, xa, xb, ea,
                    trans(cong_fn(λ (q: Pl) => q.at, sym(e0)), eb), r1, r2),
                Inr(m2) => CSt::against_all_sound(rest, s, tys, cx, sl, env, en, a2.witness, a2.proof.left, sp.right, pl, m2, same, pre, xa, xb, ea, eb, r1, r2),
            }
        },
    }
}

// The licence's verdict and its residuals: every live entry it meets is
// apart from every place of its object, and after a prefix they share, the
// parts after it.
theorem CSt::license_sound(self vs: List<VEnt>, s: CSt, tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), env: Env(tys), md: Mode, l: Nat, ps: List<Pl>): (rs: List<Residual>) →
    s.license(vs, md, l, ps) = Some(rs) → Residual::All(rs, tys, cx, env, True) → (en: VEnt) → Mem(en, vs) → s.meets(l, md, en) = True → (pl: Pl) → Mem(pl, ps) → en.obj = pl.obj →
    (pre, xa, xb: List<Step>) → en.reg = pre ++ xa → pl.at = pre ++ xb → s.InRange(Steps::lvls(xa)) → s.InRange(Steps::lvls(xb)) →
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(xa), Env::ixs(tys, env)), Steps::sels(s.unsteps(xb), Env::ixs(tys, env)))
{
    match vs {
        Nil => λ rs _ _ en m => false_elim(m),
        Cons(e0, rest) => λ rs ok hold en m mt pl mp same pre xa xb ea eb r1 r2 => {
            let here = match s.meets(l, md, e0) { True => s.against_all(e0, ps), False => Some(Nil<Residual>) };
            let a1 = Option::and_then_some(here, λ q1 => s.license(rest, md, l, ps).map(λ q2 => q1 ++ q2), rs, ok);
            let a2 = Option::map_some_inv(s.license(rest, md, l, ps), λ (q2: List<Residual>) => a1.witness ++ q2, rs, a1.proof.right);
            let sp = Residual::all_app(tys, cx, env, True, a1.witness, a2.witness, j(sym(a2.proof.right), λ q _ => Residual::All(q, tys, cx, env, True), hold));
            match m {
                Inl(e1) => {
                    let mt0: (s.meets(l, md, e0) = True) = j(e1, λ q _ => s.meets(l, md, q) = True, mt);
                    let h0: (s.against_all(e0, ps) = Some(a1.witness)) = j(mt0, λ c _ => (match c { True => s.against_all(e0, ps), False => Some(Nil<Residual>) }) = Some(a1.witness), a1.proof.left);
                    CSt::against_all_sound(ps, s, tys, cx, sl, env, e0, a1.witness, h0, sp.left, pl, mp, trans(cong_fn(λ (q: VEnt) => q.obj, sym(e1)), same),
                        pre, xa, xb, trans(cong_fn(λ (q: VEnt) => q.reg, sym(e1)), ea), eb, r1, r2)
                },
                Inr(m2) => CSt::license_sound(rest, s, tys, cx, sl, env, md, l, ps, a2.witness, a2.proof.left, sp.right, en, m2, mt, pl, mp, same, pre, xa, xb, ea, eb, r1, r2),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A binding of a view: new entries at the next level, its cell a view's

theorem List::filter_nil_of<A>(self xs: List<A>, p: A → Bool): ((x: A) → Mem(x, xs) → p(x) = False) → xs.filter(p) = Nil {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ no => j(sym(no(h, Inl(refl))), λ c _ => (match c { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Nil<A>(), t.filter_nil_of(p, λ x m => no(x, Inr(m)))),
    }
}

theorem List::filter_all_of<A>(self xs: List<A>, p: A → Bool): ((x: A) → Mem(x, xs) → p(x) = True) → xs.filter(p) = xs {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ all => j(sym(all(h, Inl(refl))), λ c _ => (match c { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Cons(h, t),
            cong_fn(λ (q: List<A>) => Cons(h, q), t.filter_all_of(p, λ x m => all(x, Inr(m))))),
    }
}

theorem List::any_bit_app<A>(self xs: List<A>, ys: List<A>, p: A → Bool): (xs ++ ys).any_bit(p) = True → (xs.any_bit(p) = True) ∨ (ys.any_bit(p) = True) {
    match xs {
        Nil => λ h => Inr(h),
        Cons(a, rest) => λ h => match Bool::or_true_parts(p(a), (rest ++ ys).any_bit(p), h) {
            Inl(pa) => Inl(j(sym(pa), λ c _ => (c || rest.any_bit(p)) = True, refl)),
            Inr(hr) => match rest.any_bit_app(ys, p, hr) {
                Inl(q) => Inl(match p(a) { True => refl, False => q }),
                Inr(q) => Inr(q),
            },
        },
    }
}

// The state after a view: new entries, then its variable.
fn CSt::with_view(self s: CSt, ne: List<VEnt>, code: Shape) → CSt { (s.with_views(ne ++ s.views)).push(CVar(code, KView)) }

theorem CSt::ents_view_old(self s: CSt, ne: List<VEnt>, code: Shape, l: Nat, below: l < s.na + s.nd, nlvl: (en: VEnt) → Mem(en, ne) → en.lvl = s.na + s.nd):
    (s.with_view(ne, code)).ents(l) = s.ents(l)
{
    trans(List::filter_append(ne, s.views, λ e => e.lvl.same(l)),
        cong_fn(λ (q: List<VEnt>) => q ++ s.ents(l), ne.filter_nil_of(λ e => e.lvl.same(l), λ en m => Nat::same_false(en.lvl, l, λ eq => Nat::lt_irrefl(l, j(trans(sym(nlvl(en, m)), eq), λ q _ => l < q, below))))))
}

theorem CSt::ents_view_new(self s: CSt, ne: List<VEnt>, code: Shape, nlvl: (en: VEnt) → Mem(en, ne) → en.lvl = s.na + s.nd, lv: (en: VEnt) → Mem(en, s.views) → en.lvl < s.na + s.nd):
    (s.with_view(ne, code)).ents(s.na + s.nd) = ne
{
    trans(List::filter_append(ne, s.views, λ e => e.lvl.same(s.na + s.nd)),
        trans(cong_fn(λ (q: List<VEnt>) => ne.filter(λ e => e.lvl.same(s.na + s.nd)) ++ q, s.views.filter_nil_of(λ e => e.lvl.same(s.na + s.nd), λ en m => Nat::same_false(en.lvl, s.na + s.nd, λ eq => Nat::lt_irrefl(en.lvl, j(sym(eq), λ q _ => en.lvl < q, lv(en, m)))))),
            trans(List::append_nil(ne.filter(λ e => e.lvl.same(s.na + s.nd))), ne.filter_all_of(λ e => e.lvl.same(s.na + s.nd), λ en m => j(sym(nlvl(en, m)), λ q _ => q.same(s.na + s.nd) = True, (s.na + s.nd).same_self())))))
}

// Ancestry through old levels is the same at a state whose old levels have
// the same entries.
theorem CSt::anc_ext(self f: Nat, s, s2: CSt, ents: (l: Nat) → l < s.na + s.nd → s2.ents(l) = s.ents(l), lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl,
    lv: (en: VEnt) → Mem(en, s.views) → en.lvl < s.na + s.nd): (e: VEnt) → e.par < s.na + s.nd → s2.anc_of(e, f) = s.anc_of(e, f)
{
    match f {
        Zero => λ e _ => refl,
        Succ(f1) => λ e pb => match e.par.same(e.lvl) {
            True => refl,
            False => cong_fn(λ (t: List<Nat>) => Cons(e.par, t),
                trans(cong_fn(λ (q: List<VEnt>) => q.foldr(λ (pe: VEnt) (acc: List<Nat>) => s2.anc_of(pe, f1) ++ acc, Nil), ents(e.par, pb)),
                    VEnt::foldr_anc(s.ents(e.par), λ pe => s2.anc_of(pe, f1), λ pe => s.anc_of(pe, f1), λ pe mf => {
                        let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), mf);
                        CSt::anc_ext(f1, s, s2, ents, lt, lv, pe, omega(lt(pe, mv), lv(pe, mv)))
                    }))),
        },
    }
}

theorem List::any_bit_skip<A>(self xs: List<A>, ys: List<A>, p: A → Bool): ((x: A) → Mem(x, xs) → p(x) = False) → (xs ++ ys).any_bit(p) = ys.any_bit(p) {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ no => j(sym(no(h, Inl(refl))), λ c _ => (c || (t ++ ys).any_bit(p)) = ys.any_bit(p), t.any_bit_skip(ys, p, λ x m => no(x, Inr(m)))),
    }
}

// One more fuel than the parent's level needs changes no ancestry.
theorem CSt::anc_one(self f: Nat, s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl, e: VEnt, pb: e.par < f): s.anc_of(e, Succ(f)) = s.anc_of(e, f) {
    match f {
        Zero => false_elim(Nat::not_succ_le_zero(e.par, pb)),
        Succ(f1) => match e.par.same(e.lvl) {
            True => refl,
            False => cong_fn(λ (t: List<Nat>) => Cons(e.par, t),
                VEnt::foldr_anc(s.ents(e.par), λ pe => s.anc_of(pe, Succ(f1)), λ pe => s.anc_of(pe, f1), λ pe mf => {
                    let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), mf);
                    let pl: (pe.lvl = e.par) = pe.lvl.same_sound(e.par, s.views.mem_filter_holds(pe, λ q => q.lvl.same(e.par), mf));
                    sym(CSt::anc_more(f1, s, lt, pe, mv, omega(pl, pb)))
                })),
        },
    }
}

theorem Inv::push_view(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, code: Shape, ne: List<VEnt>, c: Cell(tys), d: Dyn(tys), rd: Value::Reads(tys, strs, m.heap, c.v, d), okc: d.code = code, nown: c.own = False,
    nlvl: (en: VEnt) → Mem(en, ne) → en.lvl = s.na + s.nd,
    nobj: (en: VEnt) → Mem(en, ne) → en.obj < s.nobj,
    nchain: (en: VEnt) → Mem(en, ne) → (en.par < s.na + s.nd) ∧ s.Parent(en),
    nwords: (en: VEnt) → Mem(en, ne) → (l: Nat) → (l.member(Steps::lvls(en.reg)) || l.member(Steps::lvls(en.at))) = True → (l < s.na + s.nd) ∧ ((s.role(l)).plain() = True),
    nback: (en: VEnt) → Mem(en, ne) → (en.mode.writes() && !en.back) = False,
    nchg: (en: VEnt) → Mem(en, ne) → en.mode.writes() = True → s.Changes(en.obj),
    nwpar: (en: VEnt) → Mem(en, ne) → en.mode.writes() = True → s.WPar(en),
    nuni: (en: VEnt) → Mem(en, ne) → (y0: Var) → s.lvl(y0) = Some(en.par) → Value::refers(tys, c.v) = Value::refers(tys, (REnv::get(tys, m.env, y0)).v),
    nref: (r: Ref) → c.v = Refer(r) → VEnt::Any(ne, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(Mach::ixs(tys, strs, m), s.unsteps(en.reg))) = Some(r)),
    nx1: (e1, e2: VEnt) → Mem(e1, ne) → Mem(e2, s.views) → e1.mode.writes() = True → e1.obj = e2.obj → e2.lvl.member(s.anc_of(e1, s.na + s.nd)) = False →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), Mach::ixs(tys, strs, m)), Steps::sels(s.unsteps(e2.reg), Mach::ixs(tys, strs, m))),
    nx2: (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, ne) → e1.mode.writes() = True → e1.obj = e2.obj → e1.lvl.member(s.anc_of(e2, s.na + s.nd)) = False →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), Mach::ixs(tys, strs, m)), Steps::sels(s.unsteps(e2.reg), Mach::ixs(tys, strs, m))),
    ncfit: (en: VEnt) → Mem(en, ne) → (y0: Var) → s.lvl(y0) = Some(en.par) → (dp, dc: Dyn(tys)) → (REnv::get(tys, m.env, y0)).v = level2::Plain(dp) → c.v = level2::Plain(dc) →
        CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m)), dp, dc),
    nsib1: (e1, e2: VEnt) → Mem(e1, ne) → Mem(e2, s.views) → e1.mode.writes() = True → e1.par = e2.par →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), Mach::ixs(tys, strs, m)), Steps::sels(s.unsteps(e2.at), Mach::ixs(tys, strs, m))),
    nsib2: (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, ne) → e1.mode.writes() = True → e1.par = e2.par →
        Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), Mach::ixs(tys, strs, m)), Steps::sels(s.unsteps(e2.at), Mach::ixs(tys, strs, m)))):
    Inv(tys, strs, s.with_view(ne, code), Env::push(tys, e, d), Mach::push(tys, m, c), h0, lent)
{
    let cv = CVar(code, KView);
    let sv = s.with_views(ne ++ s.views);
    let s2 = s.with_view(ne, code);
    let m2 = Mach::push(tys, m, c);
    let e2 = Env::push(tys, e, d);
    let nl = s.na + s.nd;
    let sim0 = Inv::sim_now(tys, strs, inv, none);
    let simv: Sim(tys, strs, sv, e, m) = sim0;
    let sim1: Sim(tys, strs, s2, e2, m2) = Sim::push(tys, strs, simv, cv, c, d, rd, okc);
    let pend: (s2.pending() = False) = trans(ne.any_bit_skip(s.views, λ en => en.mode.writes() && !en.back, nback), none);
    let sim2 = j(sym(s2.patched_none(tys, strs, e2, m2, pend)), λ q _ => Sim(tys, strs, s2, q, m2), sim1);
    let ws = Mach::ixs(tys, strs, m);
    let ws2 = Mach::ixs(tys, strs, m2);
    let lt: ((en: VEnt) → Mem(en, s.views) → en.par < en.lvl) = λ en mem => (inv.chain(en, mem)).left;
    let lv: ((en: VEnt) → Mem(en, s.views) → en.lvl < nl) = λ en mem => (inv.vents(en, mem)).right.left;
    let eold: ((l: Nat) → l < nl → s2.ents(l) = s.ents(l)) = λ l b => s.ents_view_old(ne, code, l, b, nlvl);
    let rolep: ((l: Nat) → l < nl → s2.role(l) = s.role(l)) = λ l b => sv.role_push(cv, l, b);
    let wsel: ((xs: List<Step>) → ((l: Nat) → l.member(Steps::lvls(xs)) = True → l < nl) → Steps::sels(s2.unsteps(xs), ws2) = Steps::sels(s.unsteps(xs), ws)) =
        λ xs rg => CSt::sels_keep(xs, s2, ws2, s, ws, λ l2 m2l => CSt::ixs_push(tys, strs, sv, cv, m, c, sim0.margs, l2, rg(l2, m2l)));
    let rold: ((en: VEnt) → Mem(en, s.views) → (l: Nat) → l.member(Steps::lvls(en.reg)) = True → l < nl) = λ en mem l ml => (inv.words(l, s.region_lvl(en, mem, l, ml))).left;
    let rnew: ((en: VEnt) → Mem(en, ne) → (l: Nat) → l.member(Steps::lvls(en.reg)) = True → l < nl) =
        λ en mem l ml => (nwords(en, mem, l, j(sym(ml), λ q _ => (q || l.member(Steps::lvls(en.at))) = True, refl))).left;
    let rall: ((en: VEnt) → Mem(en, ne ++ s.views) → (l: Nat) → l.member(Steps::lvls(en.reg)) = True → l < nl) = λ en mem => match ne.mem_append(s.views, en, mem) {
        Inl(mn) => rnew(en, mn), Inr(mo) => rold(en, mo),
    };
    let pall: ((en: VEnt) → Mem(en, ne ++ s.views) → en.par < nl) = λ en mem => match ne.mem_append(s.views, en, mem) {
        Inl(mn) => (nchain(en, mn)).left, Inr(mo) => omega(lt(en, mo), lv(en, mo)),
    };
    let chg: ((o: Nat) → s2.Changes(o) → s.Changes(o)) = λ o h1 => match h1 {
        Inl(ex) => match ex {
            ⟨l, pl⟩ => match pl.right {
                ⟨a, pa⟩ => match Nat::below_succ(l, nl, pl.left) {
                    Inr(at) => absurd(trans(sym(pa.left), j(sym(at), λ q _ => s2.role(q) = KView, cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv))))),
                    Inl(c1) => Inl(Exists(l, ⟨c1, Exists(a, ⟨trans(sym(rolep(l, c1)), pa.left), pa.right⟩)⟩)),
                },
            },
        },
        Inr(ev) => match ev {
            ⟨en, pe⟩ => match ne.mem_append(s.views, en, pe.left) {
                Inl(mn) => j(pe.right.left, λ q _ => s.Changes(q), nchg(en, mn, pe.right.right)),
                Inr(mo) => Inr(Exists(en, ⟨mo, pe.right⟩)),
            },
        },
    };
    let aall: ((en: VEnt) → Mem(en, ne ++ s.views) → (l: Nat) → l.member(Steps::lvls(en.at)) = True → l < nl) = λ en mem l ml => match ne.mem_append(s.views, en, mem) {
        Inl(mn) => (nwords(en, mn, l, j(sym(ml), λ q _ => (l.member(Steps::lvls(en.reg)) || q) = True, Bool::or_true_right(l.member(Steps::lvls(en.reg)))))).left,
        Inr(mo) => (inv.words(l, s.at_lvl(en, mo, l, ml))).left,
    };
    let ats: ((en: VEnt) → Mem(en, ne ++ s.views) → Steps::sels(s2.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)) = λ en mem => wsel(en.at, aall(en, mem));
    let cfv: CSt::CFit(tys, strs, sv, m.env, ws) = λ en mem y z hy hz dp dc cy cz => match ne.mem_append(s.views, en, mem) {
        Inl(mn) => false_elim(Nat::lt_irrefl(nl, j(nlvl(en, mn), λ q _ => q < nl, s.lvl_below(z, en.lvl, hz)))),
        Inr(mo) => inv.cfit(en, mo, y, z, hy, hz, dp, dc, cy, cz),
    };
    let sib2: CSt::Sib(tys, strs, s2, ws2) = λ e1 e2b m1 m2b w1 pp n12 => {
        let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(e2b.at), ws)) = match ne.mem_append(s.views, e1, m1) {
            Inl(n1) => match ne.mem_append(s.views, e2b, m2b) {
                Inl(n2) => false_elim(n12(trans(nlvl(e1, n1), sym(nlvl(e2b, n2))))),
                Inr(o2) => nsib1(e1, e2b, n1, o2, w1, pp),
            },
            Inr(o1) => match ne.mem_append(s.views, e2b, m2b) {
                Inl(n2) => nsib2(e1, e2b, o1, n2, w1, pp),
                Inr(o2) => inv.sib(e1, e2b, o1, o2, w1, pp, n12),
            },
        };
        j(sym(ats(e2b, m2b)), λ q _ => Sel::Apart(tys, strs, Steps::sels(s2.unsteps(e1.at), ws2), q),
            j(sym(ats(e1, m1)), λ q _ => Sel::Apart(tys, strs, q, Steps::sels(s.unsteps(e2b.at), ws)), ap))
    };
    let anc2: ((en: VEnt) → en.par < nl → s2.anc_of(en, s2.na + s2.nd) = s.anc_of(en, nl)) =
        λ en pb => trans(CSt::anc_ext(nl + 1, s, s2, eold, lt, lv, en, pb), CSt::anc_one(nl, s, lt, en, pb));
    Inv(sim2, inv.root,
        λ x l h r cr => match sv.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let cr1: (c.v = Refer(r)) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr);
                let any0 = VEnt::any_mono(ne, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r),
                    λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r),
                    λ en mem p => trans(cong_fn(λ (ss: List<Sel>) => (inv.root(en.obj)).map(λ r0 => Ref(r0.b, r0.sels ++ ss)), wsel(en.reg, rnew(en, mem))), p), nref(r, cr1));
                let any2 = j(sym(s.ents_view_new(ne, code, nlvl, lv)), λ q _ => VEnt::Any(q, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r)), any0);
                let rolen: (s2.role(nl) = KView) = cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv));
                j(sym(nw.right), λ q _ => s2.RefOk(inv.root, ws2, q, r),
                    j(sym(rolen), λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s2.ents(nl), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws2, s2.unsteps(en.reg))) = Some(r)),
                        KPlain => False, KGone => True }, any2))
            },
            Inr(⟨x0, p⟩) => {
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(REnv::get_push_up(tys, m.env, c, x0))), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let below = s.lvl_below(x0, l, p.right);
                CSt::refok_keep(s, s2, inv.root, inv.root, ws, ws2, l, r, rolep(l, below), eold(l, below), λ _ _ _ => refl, λ _ _ => refl,
                    λ en mem => wsel(en.reg, rold(en, s.views.mem_filter(en, λ q => q.lvl.same(l), mem))),
                    inv.refs(x0, l, p.right, r, cr0))
            },
        },
        λ o1 o2 n1 h1 r1 r2 e1 e2b => inv.apart(o1, o2, n1, chg(o1, h1), r1, r2, e1, e2b),
        inv.inheap,
        λ o h1 => inv.owned(o, chg(o, h1)),
        λ x l h lv co r cr => match sv.push_lvl(cv, x, l, h) {
            Inl(nw) => {
                let co1: (c.own = True) = j(nw.left, λ y _ => (REnv::get(tys, m2.env, y)).own = True, co);
                absurd(trans(sym(nown), co1))
            },
            Inr(⟨x0, p⟩) => {
                let get0 = REnv::get_push_up(tys, m.env, c, x0);
                let co0: ((REnv::get(tys, m.env, x0)).own = True) = trans(cong_fn(λ (q: Cell(tys)) => q.own, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).own = True, co));
                let cr0: ((REnv::get(tys, m.env, x0)).v = Refer(r)) = trans(cong_fn(λ (q: Cell(tys)) => q.v, sym(get0)), j(p.left, λ y _ => (REnv::get(tys, m2.env, y)).v = Refer(r), cr));
                let rp = rolep(l, s.lvl_below(x0, l, p.right));
                let lv0: ¬((s.role(l)).same(KGone) = True) = λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), rp), g));
                match inv.own(x0, l, p.right, lv0, co0, r, cr0) { ⟨o2, po⟩ => Exists(o2, ⟨trans(rp, po.left), po.right⟩) }
            },
        },
        λ l1 l2 o a1 a2 b1 b2 n12 h1 h2 => match Nat::below_succ(l1, nl, b1) {
            Inr(at) => absurd(trans(sym(h1), j(sym(at), λ q _ => s2.role(q) = KView, cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv))))),
            Inl(c1) => match Nat::below_succ(l2, nl, b2) {
                Inr(at) => absurd(trans(sym(h2), j(sym(at), λ q _ => s2.role(q) = KView, cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv))))),
                Inl(c2) => inv.one(l1, l2, o, a1, a2, c1, c2, n12, trans(sym(rolep(l1, c1)), h1), trans(sym(rolep(l2, c2)), h2)),
            },
        },
        λ l w => {
            let ww: ((l < nl) ∧ ((s.role(l)).plain() = True)) = match ne.any_bit_app(s.views, λ en => l.member(Steps::lvls(en.reg)) || l.member(Steps::lvls(en.at)), w) {
                Inl(wn) => match ne.any_bit_sound(λ en => l.member(Steps::lvls(en.reg)) || l.member(Steps::lvls(en.at)), wn) { ⟨en, pe⟩ => nwords(en, pe.left, l, pe.right) },
                Inr(wo) => inv.words(l, wo),
            };
            ⟨omega(ww.left), trans(cong_fn(λ (q: Role) => q.plain(), rolep(l, ww.left)), ww.right)⟩
        },
        inv.frame,
        inv.grows,
        inv.young,
        λ l o a b hr => match Nat::below_succ(l, nl, b) {
            Inr(at) => absurd(trans(sym(hr), j(sym(at), λ q _ => s2.role(q) = KView, cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv))))),
            Inl(c1) => inv.held(l, o, a, c1, trans(sym(rolep(l, c1)), hr)),
        },
        λ en mem => match ne.mem_append(s.views, en, mem) {
            Inl(mn) => ⟨nobj(en, mn), ⟨j(sym(nlvl(en, mn)), λ q _ => q < nl + 1, omega()), j(sym(nlvl(en, mn)), λ q _ => s2.role(q) = KView, cong_fn(λ (v: CVar) => v.role, sv.var_pushed(cv)))⟩⟩,
            Inr(mo) => {
                let vv = inv.vents(en, mo);
                ⟨vv.left, ⟨omega(vv.right.left), trans(rolep(en.lvl, vv.right.left), vv.right.right)⟩⟩
            },
        },
        inv.bare,
        λ en mem => match ne.mem_append(s.views, en, mem) {
            Inl(mn) => {
                let nc = nchain(en, mn);
                ⟨j(sym(nlvl(en, mn)), λ q _ => en.par < q, nc.left), CSt::parent_keep(s, s2, en, rolep(en.par, nc.left), eold(en.par, nc.left), nc.right)⟩
            },
            Inr(mo) => {
                let cc = inv.chain(en, mo);
                let pb: (en.par < nl) = omega(cc.left, lv(en, mo));
                ⟨cc.left, CSt::parent_keep(s, s2, en, rolep(en.par, pb), eold(en.par, pb), cc.right)⟩
            },
        },
        λ e1 e2b m1 m2 w eo n12 a1 a2 => {
            let b1: (e1.lvl.member(s.anc_of(e2b, nl)) = False) = j(anc2(e2b, pall(e2b, m2)), λ q _ => e1.lvl.member(q) = False, a1);
            let b2: (e2b.lvl.member(s.anc_of(e1, nl)) = False) = j(anc2(e1, pall(e1, m1)), λ q _ => e2b.lvl.member(q) = False, a2);
            let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(e2b.reg), ws)) = match ne.mem_append(s.views, e1, m1) {
                Inl(n1) => match ne.mem_append(s.views, e2b, m2) {
                    Inl(n2) => false_elim(n12(trans(nlvl(e1, n1), sym(nlvl(e2b, n2))))),
                    Inr(o2) => nx1(e1, e2b, n1, o2, w, eo, b2),
                },
                Inr(o1) => match ne.mem_append(s.views, e2b, m2) {
                    Inl(n2) => nx2(e1, e2b, o1, n2, w, eo, b1),
                    Inr(o2) => inv.excl(e1, e2b, o1, o2, w, eo, n12, b1, b2),
                },
            };
            j(sym(wsel(e2b.reg, rall(e2b, m2))), λ q _ => Sel::Apart(tys, strs, Steps::sels(s2.unsteps(e1.reg), ws2), q),
                j(sym(wsel(e1.reg, rall(e1, m1))), λ q _ => Sel::Apart(tys, strs, q, Steps::sels(s.unsteps(e2b.reg), ws)), ap))
        },
        λ en mem w => match ne.mem_append(s.views, en, mem) {
            Inl(mn) => CSt::wpar_keep(s, s2, en, rolep(en.par, (nchain(en, mn)).left), eold(en.par, (nchain(en, mn)).left), nwpar(en, mn, w)),
            Inr(mo) => CSt::wpar_keep(s, s2, en, rolep(en.par, pall(en, mem)), eold(en.par, pall(en, mem)), inv.wpar(en, mo, w)),
        },
        CSt::uni_push(tys, sv, cv, m.env, c,
            λ en mem x y hx hy => match ne.mem_append(s.views, en, mem) {
                Inl(mn) => false_elim(Nat::lt_irrefl(nl, j(nlvl(en, mn), λ q _ => q < nl, s.lvl_below(x, en.lvl, hx)))),
                Inr(mo) => inv.uni(en, mo, x, y, hx, hy),
            },
            pall,
            λ en mem at y0 hy => match ne.mem_append(s.views, en, mem) {
                Inl(mn) => nuni(en, mn, y0, hy),
                Inr(mo) => false_elim(Nat::lt_irrefl(en.lvl, omega(lv(en, mo), at))),
            }),
        s2.pone_none(pend),
        CSt::cfit_push(tys, strs, sv, cv, m.env, c, ws, ws2, cfv, pall,
            λ en mem at y0 hy dp dc cy cc => match ne.mem_append(s.views, en, mem) {
                Inl(mn) => ncfit(en, mn, y0, hy, dp, dc, cy, cc),
                Inr(mo) => false_elim(Nat::lt_irrefl(en.lvl, omega(lv(en, mo), at))),
            }, ats),
        sib2)
}

// ---------------------------------------------------------------------------
// Apartness of selection paths: symmetric, and kept by going deeper on
// either side

theorem Sel::apart_sym(tys: Nat → Type, strs: Strs(tys), xs, ys: List<Sel>, h: Sel::Apart(tys, strs, xs, ys)): Sel::Apart(tys, strs, ys, xs) {
    SelApart(ApartAt(h.reads.right_after_left, h.reads.left_after_right, λ f g d => sym(h.reads.commute(g, f, d))), h.fit2, h.fit1)
}

theorem Sel::apart_ext_reads(tys: Nat → Type, strs: Strs(tys), xs, zs, ys: List<Sel>,
    h: ApartAt<Dyn(tys)>(λ d => Sel::read_at(tys, strs, xs, d), λ g d => Sel::write_at(tys, strs, xs, g, d), λ d => Sel::read_at(tys, strs, ys, d), λ g d => Sel::write_at(tys, strs, ys, g, d))):
    ApartAt<Dyn(tys)>(λ d => Sel::read_at(tys, strs, xs ++ zs, d), λ g d => Sel::write_at(tys, strs, xs ++ zs, g, d), λ d => Sel::read_at(tys, strs, ys, d), λ g d => Sel::write_at(tys, strs, ys, g, d))
{
    let w = λ (g: Dyn(tys) → Dyn(tys)) (x: Dyn(tys)) => Sel::write_at(tys, strs, zs, g, x);
    ApartAt(
        λ g d => trans(Sel::read_append(tys, strs, xs, zs, Sel::write_at(tys, strs, ys, g, d)),
            trans(cong_fn(λ (x: Dyn(tys)) => Sel::read_at(tys, strs, zs, x), h.left_after_right(g, d)), sym(Sel::read_append(tys, strs, xs, zs, d)))),
        λ g d => trans(cong_fn(λ (x: Dyn(tys)) => Sel::read_at(tys, strs, ys, x), Sel::write_append(tys, strs, xs, zs, g, d)), h.right_after_left(w(g), d)),
        λ f g d => trans(Sel::write_append(tys, strs, xs, zs, f, Sel::write_at(tys, strs, ys, g, d)),
            trans(h.commute(w(f), g, d), cong_fn(λ (x: Dyn(tys)) => Sel::write_at(tys, strs, ys, g, x), sym(Sel::write_append(tys, strs, xs, zs, f, d))))))
}

theorem Sel::apart_ext_l(tys: Nat → Type, strs: Strs(tys), xs, zs, ys: List<Sel>, h0: Sel::Apart(tys, strs, xs, ys)): Sel::Apart(tys, strs, xs ++ zs, ys) {
    let h = h0.reads;
    let w = λ (g: Dyn(tys) → Dyn(tys)) (x: Dyn(tys)) => Sel::write_at(tys, strs, zs, g, x);
    let f1 = λ (g: Dyn(tys) → Dyn(tys)) (d: Dyn(tys)) => {
        let d2 = Sel::write_at(tys, strs, ys, g, d);
        trans(Sel::fit_append(tys, strs, xs, zs, d2),
            trans(cong_fn(λ (q: Bool) => q && Sel::fit(tys, strs, zs, Sel::read_at(tys, strs, xs, d2)), h0.fit1(g, d)),
                trans(cong_fn(λ (t: Dyn(tys)) => Sel::fit(tys, strs, xs, d) && Sel::fit(tys, strs, zs, t), h.left_after_right(g, d)),
                    sym(Sel::fit_append(tys, strs, xs, zs, d)))))
    };
    let f2 = λ (g: Dyn(tys) → Dyn(tys)) (d: Dyn(tys)) =>
        trans(cong_fn(λ (t: Dyn(tys)) => Sel::fit(tys, strs, ys, t), Sel::write_append(tys, strs, xs, zs, g, d)), h0.fit2(w(g), d));
    SelApart(Sel::apart_ext_reads(tys, strs, xs, zs, ys, h), f1, f2)
}

theorem Sel::apart_ext_r(tys: Nat → Type, strs: Strs(tys), xs, ys, zs: List<Sel>, h: Sel::Apart(tys, strs, xs, ys)): Sel::Apart(tys, strs, xs, ys ++ zs) {
    Sel::apart_sym(tys, strs, ys ++ zs, xs, Sel::apart_ext_l(tys, strs, ys, zs, xs, Sel::apart_sym(tys, strs, xs, ys, h)))
}

// Apart roots are apart references however each is narrowed.
theorem Ref::apart_narrow(tys: Nat → Type, strs: Strs(tys), r, q: Ref, xs, ys: List<Sel>, h: Ref::Apart(tys, strs, r, q)): Ref::Apart(tys, strs, Ref(r.b, r.sels ++ xs), Ref(q.b, q.sels ++ ys)) {
    λ eb => Sel::apart_ext_r(tys, strs, r.sels ++ xs, q.sels, ys, Sel::apart_ext_l(tys, strs, r.sels, xs, q.sels, h(eb)))
}

theorem CSt::unatom_atom(self s: CSt, a, b: Atom, h: s.atom(a) = Some(b)): s.unatom(b) = a {
    (match a as λ x => s.atom(x) = Some(b) → s.unatom(b) = x {
        Lit(n) => λ e => j(Option::some_inj(Lit(n), b, e), λ q _ => s.unatom(q) = Lit(n), refl),
        Var(w) => λ e => (match (w + 1).leb(s.na) as λ c => (w + 1).leb(s.na) = c →
                (match c as λ _ => Option<Atom> { True => Some(Var(w)), False => (w - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (w - s.na)))) }) = Some(b) → s.unatom(b) = Var(w) {
            True => λ ec h2 => j(Option::some_inj(Var(w), b, h2), λ q _ => s.unatom(q) = Var(w), trans(s.unatom_var(w), cong_fn(λ (k: Nat) => Var(k),
                j(sym(ec), λ c2 _ => (match c2 as λ _ => Nat { True => w, False => s.na + (s.nd - 1 - (w - s.na)) }) = w, refl)))),
            False => λ ec h2 => {
                let p = Bool::then_some<Atom>((w - s.na + 1).leb(s.nd), Some(Var(s.na + s.nd - 1 - (w - s.na))), b, h2);
                let ge: ¬(w + 1 <= s.na) = λ le => absurd(trans(sym(ec), Nat::leb_true(w + 1, s.na, le)));
                let inr: (w - s.na + 1 <= s.nd) = Nat::le_of_leb(w - s.na + 1, s.nd, p.left);
                let l = s.na + s.nd - 1 - (w - s.na);
                let notarg: ((l + 1).leb(s.na) = False) = Bool::false_of_not((l + 1).leb(s.na), λ t => omega(Nat::le_of_leb(l + 1, s.na, t), ge, inr));
                let back: (s.na + (s.nd - 1 - (l - s.na)) = w) = omega(ge, inr);
                j(Option::some_inj(Var(l), b, p.right), λ q _ => s.unatom(q) = Var(w),
                    j(sym(notarg), λ c2 _ => (match c2 as λ _ => Atom { True => Var(l), False => Var(s.na + (s.nd - 1 - (l - s.na))) }) = Var(w), cong_fn(λ (k: Nat) => Var(k), back)))
            },
        })(refl, e),
    })(h)
}

theorem CSt::unstep_step(self s: CSt, a, b: Step, h: s.step(a) = Some(b)): s.unstep(b) = a {
    (match a as λ x => s.step(x) = Some(b) → s.unstep(b) = x {
        SField(i) => λ e => j(Option::some_inj(SField(i), b, e), λ q _ => s.unstep(q) = SField(i), refl),
        SElem(i) => λ e => match Option::map_some_inv(s.atom(i), λ (q: Atom) => SElem(q), b, e) {
            ⟨k, pk⟩ => j(pk.right, λ q _ => s.unstep(q) = SElem(i), cong_fn(λ (t: Atom) => SElem(t), s.unatom_atom(i, k, pk.left))),
        },
        SWindow(lo, n) => λ e => match Option::and_then_some(s.atom(lo), λ l2 => s.atom(n).map(λ n2 => SWindow(l2, n2)), b, e) {
            ⟨l2, pl⟩ => match Option::map_some_inv(s.atom(n), λ (n2: Atom) => SWindow(l2, n2), b, pl.right) {
                ⟨n2, pn⟩ => j(pn.right, λ q _ => s.unstep(q) = SWindow(lo, n),
                    trans(cong_fn(λ (t: Atom) => SWindow(t, s.unatom(n2)), s.unatom_atom(lo, l2, pl.left)), cong_fn(λ (t: Atom) => SWindow(lo, t), s.unatom_atom(n, n2, pn.left)))),
            },
        },
        SKey(_, _) => λ no => absurd(no),
        SVariant(_) => λ no => absurd(no),
    })(h)
}

// A place's steps and the checker's levels for them, back: the same steps.
theorem CSt::unsteps_steps(self xs: List<Step>, s: CSt): (ys: List<Step>) → s.steps(xs) = Some(ys) → s.unsteps(ys) = xs {
    match xs {
        Nil => λ ys h => trans(cong_fn(λ (q: List<Step>) => s.unsteps(q), sym(Option::some_inj(Nil<Step>, ys, h))), refl),
        Cons(a, rest) => λ ys h => match Option::and_then_some(s.step(a), λ b => s.steps(rest).map(λ bs => Cons(b, bs)), ys, h) {
            ⟨b, pb⟩ => match Option::map_some_inv(s.steps(rest), λ (bs: List<Step>) => Cons(b, bs), ys, pb.right) {
                ⟨bs, pbs⟩ => j(pbs.right, λ q _ => s.unsteps(q) = Cons(a, rest),
                    trans(cong_fn(λ (t: List<Step>) => Cons(s.unstep(b), t), CSt::unsteps_steps(rest, s, bs, pbs.left)), cong_fn(λ (u: Step) => Cons(u, rest), s.unstep_step(a, b, pb.left)))),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The levels a read's steps name: in range, and plain where the read checked

theorem Nat::member_one(l, l2: Nat, h: l2.member([l]) = True): l2 = l {
    match Bool::or_true_parts(l.same(l2), l2.member(Nil), h) { Inl(e) => sym(l.same_sound(l2, e)), Inr(no) => absurd(no) }
}

theorem Nat::member_app_or(self l: Nat, xs, ys: List<Nat>, h: l.member(xs ++ ys) = True): (l.member(xs) = True) ∨ (l.member(ys) = True) {
    match xs {
        Nil => Inr(h),
        Cons(k, rest) => match Bool::or_true_parts(k.same(l), l.member(rest ++ ys), h) {
            Inl(e) => Inl(j(sym(e), λ c _ => (c || l.member(rest)) = True, refl)),
            Inr(h2) => match l.member_app_or(rest, ys, h2) {
                Inl(q) => Inl(match k.same(l) { True => refl, False => q }),
                Inr(q) => Inr(q),
            },
        },
    }
}

theorem CSt::range_one(self s: CSt, l: Nat, below: l < s.na + s.nd): s.InRange([l]) { λ l2 m => j(sym(Nat::member_one(l, l2, m)), λ q _ => q < s.na + s.nd, below) }

theorem CSt::atom_range(self s: CSt, a, b: Atom, h: s.atom(a) = Some(b)): s.InRange(b.lvls()) {
    (match a as λ x => s.atom(x) = Some(b) → s.InRange(b.lvls()) {
        Lit(n) => λ e => j(Option::some_inj(Lit(n), b, e), λ q _ => s.InRange(q.lvls()), λ l2 no => absurd(no)),
        Var(w) => λ e => (match (w + 1).leb(s.na) as λ c => (w + 1).leb(s.na) = c →
                (match c as λ _ => Option<Atom> { True => Some(Var(w)), False => (w - s.na + 1).leb(s.nd).then(Some(Var(s.na + s.nd - 1 - (w - s.na)))) }) = Some(b) → s.InRange(b.lvls()) {
            True => λ ec h2 => j(Option::some_inj(Var(w), b, h2), λ q _ => s.InRange(q.lvls()), s.range_one(w, omega(Nat::le_of_leb(w + 1, s.na, ec)))),
            False => λ ec h2 => {
                let p = Bool::then_some<Atom>((w - s.na + 1).leb(s.nd), Some(Var(s.na + s.nd - 1 - (w - s.na))), b, h2);
                let ge: ¬(w + 1 <= s.na) = λ le => absurd(trans(sym(ec), Nat::leb_true(w + 1, s.na, le)));
                let inr: (w - s.na + 1 <= s.nd) = Nat::le_of_leb(w - s.na + 1, s.nd, p.left);
                j(Option::some_inj(Var(s.na + s.nd - 1 - (w - s.na)), b, p.right), λ q _ => s.InRange(q.lvls()), s.range_one(s.na + s.nd - 1 - (w - s.na), omega(ge, inr)))
            },
        })(refl, e),
    })(h)
}

theorem CSt::step_range(self s: CSt, a, b: Step, h: s.step(a) = Some(b)): s.InRange(b.lvls()) {
    (match a as λ x => s.step(x) = Some(b) → s.InRange(b.lvls()) {
        SField(i) => λ e => j(Option::some_inj(SField(i), b, e), λ q _ => s.InRange(q.lvls()), λ l2 no => absurd(no)),
        SElem(i) => λ e => match Option::map_some_inv(s.atom(i), λ (q: Atom) => SElem(q), b, e) {
            ⟨k, pk⟩ => j(pk.right, λ q _ => s.InRange(q.lvls()), s.atom_range(i, k, pk.left)),
        },
        SWindow(lo, n) => λ e => match Option::and_then_some(s.atom(lo), λ l2 => s.atom(n).map(λ n2 => SWindow(l2, n2)), b, e) {
            ⟨l2, pl⟩ => match Option::map_some_inv(s.atom(n), λ (n2: Atom) => SWindow(l2, n2), b, pl.right) {
                ⟨n2, pn⟩ => j(pn.right, λ q _ => s.InRange(q.lvls()), λ l3 m => match l3.member_app_or(l2.lvls(), n2.lvls(), m) {
                    Inl(m1) => s.atom_range(lo, l2, pl.left, l3, m1),
                    Inr(m2) => s.atom_range(n, n2, pn.left, l3, m2),
                }),
            },
        },
        SKey(_, _) => λ no => absurd(no),
        SVariant(_) => λ no => absurd(no),
    })(h)
}

theorem CSt::steps_range(self xs: List<Step>, s: CSt): (ys: List<Step>) → s.steps(xs) = Some(ys) → s.InRange(Steps::lvls(ys)) {
    match xs {
        Nil => λ ys h => j(Option::some_inj(Nil<Step>, ys, h), λ q _ => s.InRange(Steps::lvls(q)), λ l no => absurd(no)),
        Cons(a, rest) => λ ys h => match Option::and_then_some(s.step(a), λ b => s.steps(rest).map(λ bs => Cons(b, bs)), ys, h) {
            ⟨b, pb⟩ => match Option::map_some_inv(s.steps(rest), λ (bs: List<Step>) => Cons(b, bs), ys, pb.right) {
                ⟨bs, pbs⟩ => j(pbs.right, λ q _ => s.InRange(Steps::lvls(q)), λ l m => match l.member_app_or(b.lvls(), Steps::lvls(bs), m) {
                    Inl(m1) => s.step_range(a, b, pb.left, l, m1),
                    Inr(m2) => CSt::steps_range(rest, s, bs, pbs.left, l, m2),
                }),
            },
        },
    }
}

theorem CSt::atoms_plain(self ls: List<Nat>, s: CSt): (r: List<Residual>) → s.atoms_ok(ls) = Some(r) → (l: Nat) → l.member(ls) = True → (s.role(l)).plain() = True {
    match ls {
        Nil => λ r _ l no => absurd(no),
        Cons(k, rest) => λ r h l m => {
            let p = Bool::then_some((s.role(k)).plain(), s.atoms_ok(rest), r, h);
            match Bool::or_true_parts(k.same(l), l.member(rest), m) {
                Inl(e) => j(k.same_sound(l, e), λ q _ => (s.role(q)).plain() = True, p.left),
                Inr(m2) => CSt::atoms_plain(rest, s, r, p.right, l, m2),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// The view stage

theorem VEnt::any_of_mem(self es: List<VEnt>, P: VEnt → Type, en: VEnt): Mem(en, es) → P(en) → VEnt::Any(es, P) {
    match es { Nil => λ m _ => false_elim(m), Cons(e0, rest) => λ m p => match m { Inl(eq) => Inl(j(eq, λ q _ => P(q), p)), Inr(m2) => Inr(VEnt::any_of_mem(rest, P, en, m2, p)) } }
}

theorem VEnt::any_map(self es: List<VEnt>, f: VEnt → VEnt, P, Q: VEnt → Type): ((en: VEnt) → Mem(en, es) → P(en) → Q(f(en))) → VEnt::Any(es, P) → VEnt::Any(es.map(f), Q) {
    match es {
        Nil => λ _ no => no,
        Cons(e0, rest) => λ h a => match a { Inl(p) => Inl(h(e0, Inl(refl), p)), Inr(q) => Inr(VEnt::any_map(rest, f, P, Q, λ e m p => h(e, Inr(m), p), q)) },
    }
}

theorem VEnt::member_foldr(self es: List<VEnt>, f: VEnt → List<Nat>, l: Nat, pe: VEnt): Mem(pe, es) → l.member(f(pe)) = True → l.member(es.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil)) = True {
    match es {
        Nil => λ m _ => false_elim(m),
        Cons(e0, rest) => λ m h => match m {
            Inl(eq) => l.member_app_l(f(e0), rest.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil), j(eq, λ q _ => l.member(f(q)) = True, h)),
            Inr(m2) => l.member_app_r(f(e0), rest.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil), VEnt::member_foldr(rest, f, l, pe, m2, h)),
        },
    }
}

// A region whose levels are plain and in range selects alike in the run and
// in the meaning.
theorem Sim::region_sels(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, strs, s, e, m), xs: List<Step>,
    rg: s.InRange(Steps::lvls(xs)), pl: (l: Nat) → l.member(Steps::lvls(xs)) = True → (s.role(l)).plain() = True):
    Steps::sels(s.unsteps(xs), Env::ixs(tys, e)) = Steps::sels(s.unsteps(xs), Mach::ixs(tys, strs, m))
{
    CSt::sels_keep(xs, s, Env::ixs(tys, e), s, Mach::ixs(tys, strs, m), λ l ml => sym(Sim::lvl_ix(tys, strs, sim, l, rg(l, ml), pl(l, ml))))
}

theorem CSt::meets_hold(self s: CSt, l: Nat, md: Mode, en: VEnt, o: Nat, a: Acc, hr: s.role(l) = KHold(o, a), ne: ¬(en.lvl = l), w: (md.writes() || en.mode.writes()) = True): s.meets(l, md, en) = True {
    let nl: (en.lvl.same(l) = False) = Nat::same_false(en.lvl, l, ne);
    j(sym(hr), λ q _ => ((md.writes() || en.mode.writes()) && !en.lvl.same(l) && match q { KView => l.member(s.anc_of(en, s.na + s.nd)), _ => True }) = True,
        j(sym(nl), λ c _ => ((md.writes() || en.mode.writes()) && !c && True) = True, j(sym(w), λ c _ => (c && !False && True) = True, refl)))
}

theorem CSt::meets_view(self s: CSt, l: Nat, md: Mode, en: VEnt, hr: s.role(l) = KView, ne: ¬(en.lvl = l), w: (md.writes() || en.mode.writes()) = True,
    anc: l.member(s.anc_of(en, s.na + s.nd)) = True): s.meets(l, md, en) = True
{
    let nl: (en.lvl.same(l) = False) = Nat::same_false(en.lvl, l, ne);
    j(sym(hr), λ q _ => ((md.writes() || en.mode.writes()) && !en.lvl.same(l) && match q { KView => l.member(s.anc_of(en, s.na + s.nd)), _ => True }) = True,
        j(sym(nl), λ c _ => ((md.writes() || en.mode.writes()) && !c && l.member(s.anc_of(en, s.na + s.nd))) = True,
            j(sym(w), λ c _ => (c && !False && l.member(s.anc_of(en, s.na + s.nd))) = True, anc)))
}

fn Cell::view_of(tys: Nat → Type, v: Value(tys), d: Dyn(tys), ws: List<Ix>, xs: List<Step>) → Cell(tys) { match v { Plain(_) => Cell::plain(tys, d), Refer(r) => Cell(Refer(r.narrow(ws, xs)), False) } }

theorem Value::refers_view(tys: Nat → Type, v: Value(tys), d: Dyn(tys), ws: List<Ix>, xs: List<Step>): Value::refers(tys, (Cell::view_of(tys, v, d, ws, xs)).v) = Value::refers(tys, v) {
    match v { Plain(_) => refl, Refer(_) => refl }
}

theorem Stmt::view_runs(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), p: Place, md: Mode, d: Dyn(tys),
    at: Mach::place(tys, strs, m, p) = Some(d), k: Mach(tys) → Ran(tys)):
    (View(p, md)).run(tys, strs, fns, call, m, k) = k(Mach::push(tys, m, Cell::view_of(tys, (REnv::get(tys, m.env, p.root)).v, d, Mach::ixs(tys, strs, m), p.steps)))
{
    let c = REnv::get(tys, m.env, p.root);
    let ws = Mach::ixs(tys, strs, m);
    j(sym(at), λ o _ => (match o { None => Stuck, Some(x) => match c.v { Plain(_) => k(Mach::push(tys, m, Cell::plain(tys, x))), Refer(r) => k(Mach::push(tys, m, Cell(Refer(r.narrow(ws, p.steps)), False))) } })
        = k(Mach::push(tys, m, Cell::view_of(tys, c.v, d, ws, p.steps))),
        match c.v { Plain(_) => refl, Refer(_) => refl })
}

theorem Stmt::view_reads(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), v: Value(tys), d: Dyn(tys), ws: List<Ix>, xs: List<Step>, at: Value::get(tys, strs, h, v, Steps::sels(xs, ws)) = Some(d)):
    Value::Reads(tys, strs, h, (Cell::view_of(tys, v, d, ws, xs)).v, d)
{
    (match v as λ u => Value::get(tys, strs, h, u, Steps::sels(xs, ws)) = Some(d) → Value::Reads(tys, strs, h, (Cell::view_of(tys, u, d, ws, xs)).v, d) {
        Plain(_) => λ _ => refl,
        Refer(r) => λ g => j(sym(List::append_nil(r.sels ++ Steps::sels(xs, ws))), λ q _ => (match Heap::val(tys, strs, h, r.b) { Some(dv) => Sel::get(tys, strs, q, dv), None => None<Dyn(tys)>() }) = Some(d), g),
    })(at)
}

// A copy opened at a place of a copy: the place fits the parent's copy, and
// the new copy is what it reads there.
theorem Stmt::view_cfit(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), v: Value(tys), d: Dyn(tys), ws: List<Ix>, xs: List<Step>, at: Value::get(tys, strs, h, v, Steps::sels(xs, ws)) = Some(d),
    dp, dc: Dyn(tys), cv: v = level2::Plain(dp), cc: (Cell::view_of(tys, v, d, ws, xs)).v = level2::Plain(dc)): CSt::CFitAt(tys, strs, Steps::sels(xs, ws), dp, dc)
{
    let ss = Steps::sels(xs, ws);
    let at2: (Sel::get(tys, strs, ss, dp) = Some(d)) = j(cv, λ u _ => Value::get(tys, strs, h, u, ss) = Some(d), at);
    let gp = Sel::get_parts(tys, strs, ss, dp, d, at2);
    let cc2: (level2::Plain(d) = level2::Plain(dc)) = j(cv, λ u _ => (Cell::view_of(tys, u, d, ws, xs)).v = level2::Plain(dc), cc);
    let dd: (d = dc) = cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => d }, cc2);
    j(dd, λ q _ => CSt::CFitAt(tys, strs, ss, dp, q),
        ⟨gp.left, ⟨cong_fn(λ (q: Dyn(tys)) => q.code, sym(gp.right)), cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), sym(gp.right))⟩⟩)
}

// The view stage, once the new entries' facts are in hand: the run binds the
// root's reference narrowed (or a copy of a plain root's value), and the
// invariant holds with the new entries.
theorem Stmt::stage_view_core(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, md: Mode, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), tail: Type, res: Residual::All(g.rs, tys, cx, e, tail),
    ne: List<VEnt>,
    npar: (en: VEnt) → Mem(en, ne) → en.par = g.root,
    nlvl: (en: VEnt) → Mem(en, ne) → en.lvl = s.na + s.nd,
    nobj: (en: VEnt) → Mem(en, ne) → en.obj < s.nobj,
    nchain: (en: VEnt) → Mem(en, ne) → (en.par < s.na + s.nd) ∧ s.Parent(en),
    nwords: (en: VEnt) → Mem(en, ne) → (l: Nat) → (l.member(Steps::lvls(en.reg)) || l.member(Steps::lvls(en.at))) = True → (l < s.na + s.nd) ∧ ((s.role(l)).plain() = True),
    nback: (en: VEnt) → Mem(en, ne) → (en.mode.writes() && !en.back) = False,
    nchg: (en: VEnt) → Mem(en, ne) → en.mode.writes() = True → s.Changes(en.obj),
    nwpar: (en: VEnt) → Mem(en, ne) → en.mode.writes() = True → s.WPar(en),
    nref: (r: Ref) → (REnv::get(tys, m.env, p.root)).v = Refer(r) →
        VEnt::Any(ne, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(Mach::ixs(tys, cx.strs, m), s.unsteps(en.reg))) = Some(r.narrow(Mach::ixs(tys, cx.strs, m), p.steps))),
    nx1: (e1, e2: VEnt) → Mem(e1, ne) → Mem(e2, s.views) → e1.mode.writes() = True → e1.obj = e2.obj → e2.lvl.member(s.anc_of(e1, s.na + s.nd)) = False →
        Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(e1.reg), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(e2.reg), Mach::ixs(tys, cx.strs, m))),
    nx2: (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, ne) → e1.mode.writes() = True → e1.obj = e2.obj → e1.lvl.member(s.anc_of(e2, s.na + s.nd)) = False →
        Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(e1.reg), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(e2.reg), Mach::ixs(tys, cx.strs, m))),
    nat: (en: VEnt) → Mem(en, ne) → s.unsteps(en.at) = p.steps,
    nsib1: (e1, e2: VEnt) → Mem(e1, ne) → Mem(e2, s.views) → e1.mode.writes() = True → e1.par = e2.par →
        Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(e1.at), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(e2.at), Mach::ixs(tys, cx.strs, m))),
    nsib2: (e1, e2: VEnt) → Mem(e1, s.views) → Mem(e2, ne) → e1.mode.writes() = True → e1.par = e2.par →
        Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(e1.at), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(e2.at), Mach::ixs(tys, cx.strs, m)))):
    Stepped(tys, cx.strs, fns, call, View(p, md), s.with_view(ne, g.code), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let d = p.val(tys, strs, e);
    let at = Sim::place(tys, cx, sl, sim, p, g, ok, tail, res);
    let ws = Mach::ixs(tys, strs, m);
    let c = Cell::view_of(tys, (REnv::get(tys, m.env, p.root)).v, d, ws, p.steps);
    let rd = Stmt::view_reads(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, d, ws, p.steps, at);
    let nown: (c.own = False) = (match (REnv::get(tys, m.env, p.root)).v as λ u => (Cell::view_of(tys, u, d, ws, p.steps)).own = False { Plain(_) => refl, Refer(_) => refl });
    let nref2: ((r: Ref) → c.v = Refer(r) → VEnt::Any(ne, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r))) =
        (match (REnv::get(tys, m.env, p.root)).v as λ u => (REnv::get(tys, m.env, p.root)).v = u →
                ((r: Ref) → (Cell::view_of(tys, u, d, ws, p.steps)).v = Refer(r) → VEnt::Any(ne, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r))) {
            Plain(_) => λ _ r no => absurd(no),
            Refer(r0) => λ ev r cr => {
                let re: (r0.narrow(ws, p.steps) = r) = cong_fn(λ (v: Value(tys)) => match v { Refer(q) => q, Plain(_) => Ref(0, Nil) }, cr);
                j(re, λ q _ => VEnt::Any(ne, λ en => (inv.root(en.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(en.reg))) = Some(q)), nref(r0, ev))
            },
        })(refl);
    let hroot: (s.lvl(p.root) = Some(g.root)) = (s.read_inv(tys, strs, p, g, ok)).lvl;
    let nuni: ((en: VEnt) → Mem(en, ne) → (y0: Var) → s.lvl(y0) = Some(en.par) → Value::refers(tys, c.v) = Value::refers(tys, (REnv::get(tys, m.env, y0)).v)) = λ en mem y0 hy => {
        let yr: (y0 = p.root) = trans(sym(s.lvl_var(y0, en.par, hy)), trans(cong_fn(λ (q: Nat) => s.var_at(q), npar(en, mem)), s.lvl_var(p.root, g.root, hroot)));
        j(sym(yr), λ z _ => Value::refers(tys, c.v) = Value::refers(tys, (REnv::get(tys, m.env, z)).v), Value::refers_view(tys, (REnv::get(tys, m.env, p.root)).v, d, ws, p.steps))
    };
    let ncfit: ((en: VEnt) → Mem(en, ne) → (y0: Var) → s.lvl(y0) = Some(en.par) → (dp, dc: Dyn(tys)) → (REnv::get(tys, m.env, y0)).v = level2::Plain(dp) → c.v = level2::Plain(dc) →
            CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), ws), dp, dc)) = λ en mem y0 hy dp dc cy cc => {
        let yr: (y0 = p.root) = trans(sym(s.lvl_var(y0, en.par, hy)), trans(cong_fn(λ (q: Nat) => s.var_at(q), npar(en, mem)), s.lvl_var(p.root, g.root, hroot)));
        j(sym(nat(en, mem)), λ q _ => CSt::CFitAt(tys, strs, Steps::sels(q, ws), dp, dc),
            Stmt::view_cfit(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, d, ws, p.steps, at, dp, dc, j(yr, λ z _ => (REnv::get(tys, m.env, z)).v = level2::Plain(dp), cy), cc))
    };
    Stepped(Mach::push(tys, m, c), λ k => Stmt::view_runs(tys, strs, fns, call, m, p, md, d, at, k),
        Inv::push_view(tys, strs, inv, none, g.code, ne, c, d, rd, Sim::place_code(tys, strs, sim, p, g, ok), nown, nlvl, nobj, nchain, nwords, nback, nchg, nwpar, nuni, nref2, nx1, nx2, ncfit, nsib1, nsib2))
}

theorem List::mem_map_inv<A, B>(self xs: List<A>, f: A → B, b: B): Mem(b, xs.map(f)) → Exists<A>(λ a => Mem(a, xs) ∧ (b = f(a))) {
    match xs {
        Nil => λ m => false_elim(m),
        Cons(h, t) => λ m => match m { Inl(e) => Exists(h, ⟨Inl(refl), e⟩), Inr(m2) => match List::mem_map_inv(t, f, b, m2) { ⟨a, pa⟩ => Exists(a, ⟨Inr(pa.left), pa.right⟩) } },
    }
}

theorem Ref::narrow_app(r: Ref, ws: List<Ix>, xs, ys: List<Step>): r.narrow(ws, xs ++ ys) = (r.narrow(ws, xs)).narrow(ws, ys) {
    cong_fn(λ (q: List<Sel>) => Ref(r.b, q), trans(cong_fn(λ (q: List<Sel>) => r.sels ++ q, List::map_append(xs, ys, λ (a: Step) => a.sel(ws))),
        sym(List::append_assoc(r.sels, Steps::sels(xs, ws), Steps::sels(ys, ws)))))
}

theorem CSt::unsteps_app(self s: CSt, xs, ys: List<Step>): s.unsteps(xs ++ ys) = s.unsteps(xs) ++ s.unsteps(ys) { List::map_append(xs, ys, λ a => s.unstep(a)) }

// A read's levels: in range, and plain.
theorem CSt::read_lvls(self s: CSt, tys: Nat → Type, strs: Strs(tys), p: Place, g: Got, ri: ReadInv(tys, strs, s, p, g)):
    s.InRange(Steps::lvls(g.at)) ∧ ((l: Nat) → l.member(Steps::lvls(g.at)) = True → (s.role(l)).plain() = True)
{
    ⟨CSt::steps_range(p.steps, s, g.at, ri.steps), CSt::atoms_plain(Steps::lvls(g.at), s, ri.ra, ri.atoms)⟩
}

theorem CSt::read_lic_hold(self s: CSt, l: Nat, xs: List<Step>, rl: List<Residual>, h: s.read_at(l, xs) = Some(rl), o: Nat, a: Acc, hr: s.role(l) = KHold(o, a)):
    s.license(s.views, Reading, l, [Pl(o, xs)]) = Some(rl)
{
    j(hr, λ q _ => (match q { KGone => None<List<Residual>>(), _ => s.license(s.views, Reading, l, match q { KHold(o2, _) => [Pl(o2, xs)], KView => (s.ents(l)).map(λ e => Pl(e.obj, e.reg ++ xs)), KPlain => Nil, KGone => Nil }) }) = Some(rl), h)
}

theorem CSt::read_lic_view(self s: CSt, l: Nat, xs: List<Step>, rl: List<Residual>, h: s.read_at(l, xs) = Some(rl), hr: s.role(l) = KView):
    s.license(s.views, Reading, l, (s.ents(l)).map(λ e => Pl(e.obj, e.reg ++ xs))) = Some(rl)
{
    j(hr, λ q _ => (match q { KGone => None<List<Residual>>(), _ => s.license(s.views, Reading, l, match q { KHold(o2, _) => [Pl(o2, xs)], KView => (s.ents(l)).map(λ e => Pl(e.obj, e.reg ++ xs)), KPlain => Nil, KGone => Nil }) }) = Some(rl), h)
}

// What the licence's verdict gives at the run's words, after a prefix the
// entry's region and the place share.
theorem Inv::lic_suffix(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, md: Mode, l: Nat, ps: List<Pl>, rs: List<Residual>, ok: s.license(s.views, md, l, ps) = Some(rs), hold: Residual::All(rs, tys, cx, e, True),
    en: VEnt, mem: Mem(en, s.views), mt: s.meets(l, md, en) = True, pl: Pl, mp: Mem(pl, ps), same: en.obj = pl.obj, pre, xa, xb: List<Step>, ea: en.reg = pre ++ xa, eb: pl.at = pre ++ xb,
    ra: s.InRange(Steps::lvls(xa)), pa: (l2: Nat) → l2.member(Steps::lvls(xa)) = True → (s.role(l2)).plain() = True,
    rb: s.InRange(Steps::lvls(xb)), pb: (l2: Nat) → l2.member(Steps::lvls(xb)) = True → (s.role(l2)).plain() = True):
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(xa), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(xb), Mach::ixs(tys, cx.strs, m)))
{
    let sim = Inv::sim_now(tys, cx.strs, inv, none);
    let ap = CSt::license_sound(s.views, s, tys, cx, sl, e, md, l, ps, rs, ok, hold, en, mem, mt, pl, mp, same, pre, xa, xb, ea, eb, ra, rb);
    j(Sim::region_sels(tys, cx.strs, sim, xb, rb, pb), λ q _ => Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(xa), Mach::ixs(tys, cx.strs, m)), q),
        j(Sim::region_sels(tys, cx.strs, sim, xa, ra, pa), λ q _ => Sel::Apart(tys, cx.strs, q, Steps::sels(s.unsteps(xb), Env::ixs(tys, e))), ap))
}

// The same with no prefix: the entry's whole region against the place.
theorem Inv::lic_apart(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, md: Mode, l: Nat, ps: List<Pl>, rs: List<Residual>, ok: s.license(s.views, md, l, ps) = Some(rs), hold: Residual::All(rs, tys, cx, e, True),
    en: VEnt, mem: Mem(en, s.views), mt: s.meets(l, md, en) = True, pl: Pl, mp: Mem(pl, ps), same: en.obj = pl.obj,
    rp: s.InRange(Steps::lvls(pl.at)), pp: (l2: Nat) → l2.member(Steps::lvls(pl.at)) = True → (s.role(l2)).plain() = True):
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(en.reg), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(pl.at), Mach::ixs(tys, cx.strs, m)))
{
    Inv::lic_suffix(tys, cx, sl, inv, none, md, l, ps, rs, ok, hold, en, mem, mt, pl, mp, same, Nil, en.reg, pl.at, refl, refl,
        λ l2 ml => (inv.words(l2, s.region_lvl(en, mem, l2, ml))).left, λ l2 ml => (inv.words(l2, s.region_lvl(en, mem, l2, ml))).right, rp, pp)
}

theorem CSt::anc_step(self s: CSt, en: VEnt, k: Nat, ne: ¬(en.par = en.lvl)): s.anc_of(en, Succ(k)) = Cons(en.par, (s.ents(en.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, k) ++ acc, Nil)) {
    j(sym(Nat::same_false(en.par, en.lvl, ne)), λ c _ => (match c { True => Nil<Nat>(), False => Cons(en.par, (s.ents(en.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, k) ++ acc, Nil)) })
        = Cons(en.par, (s.ents(en.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, k) ++ acc, Nil)), refl)
}

// A level not an ancestor of a new entry opened on `l` is not `l`, nor an
// ancestor of any of `l`'s entries.
theorem CSt::anc_new(self s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl, nen: VEnt, l: Nat, npar: nen.par = l, nlv: nen.lvl = s.na + s.nd, below: l < s.na + s.nd,
    x: Nat, h: x.member(s.anc_of(nen, s.na + s.nd)) = False): (¬(x = l)) ∧ ((pe: VEnt) → Mem(pe, s.ents(l)) → x.member(s.anc_of(pe, s.na + s.nd)) = False)
{
    let k = s.na + s.nd - 1;
    let kk: (s.na + s.nd = Succ(k)) = omega(below);
    let ne: ¬(nen.par = nen.lvl) = λ eq => Nat::lt_irrefl(l, j(sym(trans(trans(sym(npar), eq), nlv)), λ q _ => l < q, below));
    let f = (s.ents(nen.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, k) ++ acc, Nil);
    let h1: (x.member(Cons(nen.par, f)) = False) = j(trans(cong_fn(λ (q: Nat) => s.anc_of(nen, q), kk), s.anc_step(nen, k, ne)), λ q _ => x.member(q) = False, h);
    let parts = Bool::or_false_parts(nen.par.same(x), x.member(f), h1);
    ⟨λ eq => absurd(trans(sym(parts.left), j(sym(trans(npar, sym(eq))), λ q _ => q.same(x) = True, x.same_self()))),
     λ pe mpe => {
         let mpe2: Mem(pe, s.ents(nen.par)) = j(sym(npar), λ q _ => Mem(pe, s.ents(q)), mpe);
         let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(nen.par), mpe2);
         let pl: (pe.lvl = nen.par) = pe.lvl.same_sound(nen.par, s.views.mem_filter_holds(pe, λ q => q.lvl.same(nen.par), mpe2));
         let at_k: (x.member(s.anc_of(pe, k)) = False) = Bool::false_of_not(x.member(s.anc_of(pe, k)),
             λ t => absurd(trans(sym(parts.right), VEnt::member_foldr(s.ents(nen.par), λ q => s.anc_of(q, k), x, pe, mpe2, t))));
         let one: (s.anc_of(pe, Succ(k)) = s.anc_of(pe, k)) = CSt::anc_one(k, s, lt, pe, omega(lt(pe, mv), pl, npar, below));
         j(sym(trans(cong_fn(λ (q: Nat) => s.anc_of(pe, q), kk), one)), λ q _ => x.member(q) = False, at_k)
     }⟩
}

theorem VEnt::mem_one(en, e0: VEnt, m: Mem(en, [e0])): en = e0 { match m { Inl(eq) => eq, Inr(no) => false_elim(no) } }

// The residuals of a read: those of its licence.
theorem ReadInv::lic_res(tys: Nat → Type, cx: Ctx(tys), {s: CSt}, {p: Place}, {g: Got}, ri: ReadInv(tys, cx.strs, s, p, g), env: Env(tys), tail: Type, res: Residual::All(g.rs, tys, cx, env, tail)):
    Residual::All(ri.rl, tys, cx, env, True)
{
    let r1 = Residual::all_app(tys, cx, env, tail, ri.ra, ri.rl ++ p.accesses(), j(ri.rs, λ q _ => Residual::All(q, tys, cx, env, tail), res)).right;
    (Residual::all_app(tys, cx, env, tail, ri.rl, p.accesses(), r1)).left
}

theorem Steps::lvls_append(xs, ys: List<Step>): Steps::lvls(xs ++ ys) = Steps::lvls(xs) ++ Steps::lvls(ys) {
    match xs { Nil => refl, Cons(a, rest) => trans(cong_fn(λ (q: List<Nat>) => a.lvls() ++ q, Steps::lvls_append(rest, ys)), sym(List::append_assoc(a.lvls(), Steps::lvls(rest), Steps::lvls(ys)))) }
}

// A level plain or in range across an appended region.
theorem CSt::lvls_app(self s: CSt, xs, ys: List<Step>, P: Nat → Type, hx: (l: Nat) → l.member(Steps::lvls(xs)) = True → P(l), hy: (l: Nat) → l.member(Steps::lvls(ys)) = True → P(l)):
    (l: Nat) → l.member(Steps::lvls(xs ++ ys)) = True → P(l)
{
    λ l m => match l.member_app_or(Steps::lvls(xs), Steps::lvls(ys), j(Steps::lvls_append(xs, ys), λ q _ => l.member(q) = True, m)) { Inl(a) => hx(l, a), Inr(b) => hy(l, b) }
}

// A live entry under a holder: of its object, its region its place.
theorem CSt::parent_hold(self s: CSt, en: VEnt, o: Nat, a: Acc, hr: s.role(en.par) = KHold(o, a), p: s.Parent(en)): (o = en.obj) ∧ (en.reg = en.at) {
    j(hr, λ q _ => match q { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
        KPlain => False, KGone => False }, p)
}

// A live entry under a view of one entry: its region that entry's then its
// place.
theorem CSt::parent_one(self s: CSt, en, pw: VEnt, hr: s.role(en.par) = KView, eo: s.ents(en.par) = [pw], p: s.Parent(en)): (pw.obj = en.obj) ∧ (en.reg = pw.reg ++ en.at) {
    let a: VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)) =
        j(hr, λ q _ => match q { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
            KPlain => False, KGone => False }, p);
    match j(eo, λ q _ => VEnt::Any(q, λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), a) { Inl(x) => x, Inr(no) => false_elim(no) }
}

// An entry's parent is its first ancestor.
theorem CSt::anc_par(self s: CSt, en: VEnt, lt: en.par < en.lvl, lv: en.lvl < s.na + s.nd): en.par.member(s.anc_of(en, s.na + s.nd)) = True {
    let k = s.na + s.nd - 1;
    let kk: (s.na + s.nd = Succ(k)) = omega(lv);
    let ne: ¬(en.par = en.lvl) = λ eq => Nat::lt_irrefl(en.par, j(sym(eq), λ q _ => en.par < q, lt));
    let rest = (s.ents(en.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, k) ++ acc, Nil);
    let hd: (en.par.member(Cons(en.par, rest)) = True) = j(sym(en.par.same_self()), λ c _ => (c || en.par.member(rest)) = True, refl);
    j(sym(trans(cong_fn(λ (q: Nat) => s.anc_of(en, q), kk), s.anc_step(en, k, ne))), λ q _ => en.par.member(q) = True, hd)
}

// The licence's verdict against a live entry whose region is a prefix then
// its place, at a place of the same prefix: their places apart.
theorem Inv::sib_lic(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, md: Mode, l: Nat, ps: List<Pl>, rs: List<Residual>, ok: s.license(s.views, md, l, ps) = Some(rs), hold: Residual::All(rs, tys, cx, e, True),
    en: VEnt, mem: Mem(en, s.views), mt: s.meets(l, md, en) = True, pl: Pl, mp: Mem(pl, ps), same: en.obj = pl.obj, pre, xb: List<Step>, ea: en.reg = pre ++ en.at, eb: pl.at = pre ++ xb,
    rb: s.InRange(Steps::lvls(xb)), pb: (l2: Nat) → l2.member(Steps::lvls(xb)) = True → (s.role(l2)).plain() = True):
    Sel::Apart(tys, cx.strs, Steps::sels(s.unsteps(en.at), Mach::ixs(tys, cx.strs, m)), Steps::sels(s.unsteps(xb), Mach::ixs(tys, cx.strs, m)))
{
    Inv::lic_suffix(tys, cx, sl, inv, none, md, l, ps, rs, ok, hold, en, mem, mt, pl, mp, same, pre, en.at, xb, ea, eb,
        λ l2 ml => (inv.words(l2, s.at_lvl(en, mem, l2, ml))).left, λ l2 ml => (inv.words(l2, s.at_lvl(en, mem, l2, ml))).right, rb, pb)
}

// A view to read of a holder.
theorem Stmt::stage_view_hold_read(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), o: Nat, a: Acc, hr: s.role(g.root) = KHold(o, a),
    tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, View(p, Reading), s.with_view([VEnt(s.na + s.nd, o, g.at, Reading, g.root, g.at, True)], g.code), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let ri = s.read_inv(tys, strs, p, g, ok);
    let l = g.root;
    let nl = s.na + s.nd;
    let below: (l < nl) = s.lvl_below(p.root, l, ri.lvl);
    let rlv = s.read_lvls(tys, strs, p, g, ri);
    let resl = ReadInv::lic_res(tys, cx, ri, e, tail, res);
    let en0 = VEnt(nl, o, g.at, Reading, l, g.at, True);
    let ws = Mach::ixs(tys, strs, m);
    let lic = s.read_lic_hold(l, g.at, ri.rl, ri.rat, o, a, hr);
    let parent: s.Parent(en0) = j(sym(hr), λ q _ => match q { KHold(o2, _) => (o2 = o) ∧ (g.at = g.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = o) ∧ (g.at = pe.reg ++ g.at)),
        KPlain => False, KGone => False }, ⟨refl, refl⟩);
    let unst: (s.unsteps(g.at) = p.steps) = CSt::unsteps_steps(p.steps, s, g.at, ri.steps);
    Stmt::stage_view_core(tys, cx, sl, fns, call, inv, none, p, Reading, g, ok, tail, res, [en0],
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.par = g.root, refl),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.lvl = nl, refl),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.obj < s.nobj, inv.held(l, o, a, below, hr)),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.par < nl) ∧ s.Parent(q), ⟨below, parent⟩),
        λ en mem l2 m2 => {
            let m3: ((l2.member(Steps::lvls(g.at)) || l2.member(Steps::lvls(g.at))) = True) = j(VEnt::mem_one(en, en0, mem), λ q _ => (l2.member(Steps::lvls(q.reg)) || l2.member(Steps::lvls(q.at))) = True, m2);
            match Bool::or_true_parts(l2.member(Steps::lvls(g.at)), l2.member(Steps::lvls(g.at)), m3) { Inl(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩, Inr(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩ }
        },
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.mode.writes() && !q.back) = False, refl),
        λ en mem w => absurd(trans(sym(w), j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.mode.writes() = False, refl))),
        λ en mem w => absurd(trans(sym(w), j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.mode.writes() = False, refl))),
        λ r cr => {
            let rt: (inv.root(o) = Some(r)) = j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
                KPlain => False, KGone => True }, inv.refs(p.root, l, ri.lvl, r, cr));
            Inl(j(sym(rt), λ q _ => q.map(λ r0 => r0.narrow(ws, s.unsteps(g.at))) = Some(r.narrow(ws, p.steps)), cong_fn(λ (xs: List<Step>) => Some(r.narrow(ws, xs)), unst)))
        },
        λ e1 e2 m1 m2 w => absurd(trans(sym(w), j(sym(VEnt::mem_one(e1, en0, m1)), λ q _ => q.mode.writes() = False, refl))),
        λ e1 e2 m1 m2 w eo _ => {
            let e2is = VEnt::mem_one(e2, en0, m2);
            let ne1: ¬(e1.lvl = l) = λ eq => absurd(trans(sym((inv.vents(e1, m1)).right.right), trans(cong_fn(λ (q: Nat) => s.role(q), eq), hr)));
            let mt = s.meets_hold(l, Reading, e1, o, a, hr, ne1, j(sym(w), λ c _ => (False || c) = True, refl));
            let ap = Inv::lic_apart(tys, cx, sl, inv, none, Reading, l, [Pl(o, g.at)], ri.rl, lic, resl, e1, m1, mt, Pl(o, g.at), Inl(refl),
                trans(eo, cong_fn(λ (q: VEnt) => q.obj, e2is)), rlv.left, rlv.right);
            j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(q.reg), ws)), ap)
        },
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.unsteps(q.at) = p.steps, unst),
        λ e1 e2 m1 m2 w => absurd(trans(sym(w), j(sym(VEnt::mem_one(e1, en0, m1)), λ q _ => q.mode.writes() = False, refl))),
        λ e1 e2 m1 m2 w pp => {
            let e2is = VEnt::mem_one(e2, en0, m2);
            let pl1: (e1.par = l) = trans(pp, cong_fn(λ (q: VEnt) => q.par, e2is));
            let ph = s.parent_hold(e1, o, a, j(sym(pl1), λ q _ => s.role(q) = KHold(o, a), hr), (inv.chain(e1, m1)).right);
            let ne1: ¬(e1.lvl = l) = λ eq => absurd(trans(sym((inv.vents(e1, m1)).right.right), trans(cong_fn(λ (q: Nat) => s.role(q), eq), hr)));
            let mt = s.meets_hold(l, Reading, e1, o, a, hr, ne1, j(sym(w), λ c _ => (False || c) = True, refl));
            let ap = Inv::sib_lic(tys, cx, sl, inv, none, Reading, l, [Pl(o, g.at)], ri.rl, lic, resl, e1, m1, mt, Pl(o, g.at), Inl(refl), sym(ph.left), Nil, g.at, ph.right, refl, rlv.left, rlv.right);
            j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(q.at), ws)), ap)
        })
}

// A view to read of a view: an entry through each of the view's.
theorem Stmt::stage_view_view_read(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), hr: s.role(g.root) = KView,
    tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, View(p, Reading), s.with_view((s.ents(g.root)).map(λ e2 => VEnt(s.na + s.nd, e2.obj, e2.reg ++ g.at, Reading, g.root, g.at, True)), g.code),
        Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let ri = s.read_inv(tys, strs, p, g, ok);
    let l = g.root;
    let nl = s.na + s.nd;
    let below: (l < nl) = s.lvl_below(p.root, l, ri.lvl);
    let rlv = s.read_lvls(tys, strs, p, g, ri);
    let resl = ReadInv::lic_res(tys, cx, ri, e, tail, res);
    let mk = λ (e2: VEnt) => VEnt(nl, e2.obj, e2.reg ++ g.at, Reading, l, g.at, True);
    let ne = (s.ents(l)).map(mk);
    let ws = Mach::ixs(tys, strs, m);
    let lic = s.read_lic_view(l, g.at, ri.rl, ri.rat, hr);
    let lt: ((en: VEnt) → Mem(en, s.views) → en.par < en.lvl) = λ en mem => (inv.chain(en, mem)).left;
    let unst: (s.unsteps(g.at) = p.steps) = CSt::unsteps_steps(p.steps, s, g.at, ri.steps);
    let inv_of = λ (en: VEnt) (mem: Mem(en, ne)) => List::mem_map_inv(s.ents(l), mk, en, mem);
    let mv = λ (pe: VEnt) (mp: Mem(pe, s.ents(l))) => s.views.mem_filter(pe, λ q => q.lvl.same(l), mp);
    let pel = λ (pe: VEnt) (mp: Mem(pe, s.ents(l))) => pe.lvl.same_sound(l, s.views.mem_filter_holds(pe, λ q => q.lvl.same(l), mp));
    let pew = λ (pe: VEnt) (mp: Mem(pe, s.ents(l))) (l2: Nat) (ml: l2.member(Steps::lvls(pe.reg)) = True) => inv.words(l2, s.region_lvl(pe, mv(pe, mp), l2, ml));
    let regw = λ (pe: VEnt) (mp: Mem(pe, s.ents(l))) => s.lvls_app(pe.reg, g.at, λ l2 => (l2 < nl) ∧ ((s.role(l2)).plain() = True), λ l2 ml => pew(pe, mp, l2, ml), λ l2 ml => ⟨rlv.left(l2, ml), rlv.right(l2, ml)⟩);
    let selapp = λ (pe: VEnt) => trans(cong_fn(λ (xs: List<Step>) => Steps::sels(xs, ws), s.unsteps_app(pe.reg, g.at)), List::map_append(s.unsteps(pe.reg), s.unsteps(g.at), λ (a: Step) => a.sel(ws)));
    Stmt::stage_view_core(tys, cx, sl, fns, call, inv, none, p, Reading, g, ok, tail, res, ne,
        λ en mem => match inv_of(en, mem) { ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => q.par = g.root, refl) },
        λ en mem => match inv_of(en, mem) { ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => q.lvl = nl, refl) },
        λ en mem => match inv_of(en, mem) { ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => q.obj < s.nobj, (inv.vents(pe, mv(pe, pp.left))).left) },
        λ en mem => match inv_of(en, mem) {
            ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => (q.par < nl) ∧ s.Parent(q), ⟨below,
                j(sym(hr), λ q _ => match q { KHold(o2, _) => (o2 = pe.obj) ∧ (pe.reg ++ g.at = g.at), KView => VEnt::Any(s.ents(l), λ pe2 => (pe2.obj = pe.obj) ∧ (pe.reg ++ g.at = pe2.reg ++ g.at)),
                    KPlain => False, KGone => False }, VEnt::any_of_mem(s.ents(l), λ pe2 => (pe2.obj = pe.obj) ∧ (pe.reg ++ g.at = pe2.reg ++ g.at), pe, pp.left, ⟨refl, refl⟩))⟩),
        },
        λ en mem l2 m2 => match inv_of(en, mem) {
            ⟨pe, pp⟩ => {
                let m3: ((l2.member(Steps::lvls(pe.reg ++ g.at)) || l2.member(Steps::lvls(g.at))) = True) = j(pp.right, λ q _ => (l2.member(Steps::lvls(q.reg)) || l2.member(Steps::lvls(q.at))) = True, m2);
                match Bool::or_true_parts(l2.member(Steps::lvls(pe.reg ++ g.at)), l2.member(Steps::lvls(g.at)), m3) { Inl(x) => regw(pe, pp.left, l2, x), Inr(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩ }
            },
        },
        λ en mem => match inv_of(en, mem) { ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => (q.mode.writes() && !q.back) = False, refl) },
        λ en mem w => match inv_of(en, mem) { ⟨pe, pp⟩ => absurd(trans(sym(w), j(sym(pp.right), λ q _ => q.mode.writes() = False, refl))) },
        λ en mem w => match inv_of(en, mem) { ⟨pe, pp⟩ => absurd(trans(sym(w), j(sym(pp.right), λ q _ => q.mode.writes() = False, refl))) },
        λ r cr => {
            let ok0: (VEnt::Any(s.ents(l), λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r))) =
                j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r)),
                    KPlain => False, KGone => True }, inv.refs(p.root, l, ri.lvl, r, cr));
            VEnt::any_map(s.ents(l), mk, λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r),
                λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r.narrow(ws, p.steps)),
                λ pe mp h1 => match Option::map_some_inv(inv.root(pe.obj), λ r0 => r0.narrow(ws, s.unsteps(pe.reg)), r, h1) {
                    ⟨r0, pr⟩ => {
                        let nar: (r0.narrow(ws, s.unsteps(pe.reg ++ g.at)) = r.narrow(ws, p.steps)) =
                            trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, xs), trans(s.unsteps_app(pe.reg, g.at), cong_fn(λ (xs: List<Step>) => s.unsteps(pe.reg) ++ xs, unst))),
                                trans(Ref::narrow_app(r0, ws, s.unsteps(pe.reg), p.steps), cong_fn(λ (q: Ref) => q.narrow(ws, p.steps), pr.right)));
                        j(sym(pr.left), λ q _ => q.map(λ r1 => r1.narrow(ws, s.unsteps(pe.reg ++ g.at))) = Some(r.narrow(ws, p.steps)), cong_fn(λ (q: Ref) => Some(q), nar))
                    },
                }, ok0)
        },
        λ e1 e2 m1 m2 w => match inv_of(e1, m1) { ⟨pe, pp⟩ => absurd(trans(sym(w), j(sym(pp.right), λ q _ => q.mode.writes() = False, refl))) },
        λ e1 e2 m1 m2 w eo a1 => match inv_of(e2, m2) {
            ⟨pe, pp⟩ => {
                let an = s.anc_new(lt, e2, l, j(sym(pp.right), λ q _ => q.par = l, refl), j(sym(pp.right), λ q _ => q.lvl = nl, refl), below, e1.lvl, a1);
                let eo2: (e1.obj = pe.obj) = trans(eo, cong_fn(λ (q: VEnt) => q.obj, pp.right));
                let rg: s.InRange(Steps::lvls(pe.reg ++ g.at)) = λ l2 ml => (regw(pe, pp.left, l2, ml)).left;
                let pg: ((l2: Nat) → l2.member(Steps::lvls(pe.reg ++ g.at)) = True → (s.role(l2)).plain() = True) = λ l2 ml => (regw(pe, pp.left, l2, ml)).right;
                let goal_reg: (Steps::sels(s.unsteps(e2.reg), ws) = Steps::sels(s.unsteps(pe.reg ++ g.at), ws)) = cong_fn(λ (q: VEnt) => Steps::sels(s.unsteps(q.reg), ws), pp.right);
                let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe.reg ++ g.at), ws)) =
                    (match l.member(s.anc_of(e1, nl)) as λ c => l.member(s.anc_of(e1, nl)) = c → Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe.reg ++ g.at), ws)) {
                        True => λ ac => Inv::lic_apart(tys, cx, sl, inv, none, Reading, l, (s.ents(l)).map(λ e3 => Pl(e3.obj, e3.reg ++ g.at)), ri.rl, lic, resl, e1, m1,
                            s.meets_view(l, Reading, e1, hr, an.left, j(sym(w), λ c2 _ => (False || c2) = True, refl), ac),
                            Pl(pe.obj, pe.reg ++ g.at), List::mem_map(s.ents(l), pe, λ e3 => Pl(e3.obj, e3.reg ++ g.at), pp.left), eo2, rg, pg),
                        False => λ ac => {
                            let pl0 = pel(pe, pp.left);
                            let ex = inv.excl(e1, pe, m1, mv(pe, pp.left), w, eo2, λ eq => an.left(trans(eq, pl0)), an.right(pe, pp.left), j(sym(pl0), λ q _ => q.member(s.anc_of(e1, nl)) = False, ac));
                            j(sym(selapp(pe)), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), q),
                                Sel::apart_ext_r(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe.reg), ws), Steps::sels(s.unsteps(g.at), ws), ex))
                        },
                    })(refl);
                j(sym(goal_reg), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), q), ap)
            },
        },
        λ en mem => match inv_of(en, mem) { ⟨pe, pp⟩ => j(sym(pp.right), λ q _ => s.unsteps(q.at) = p.steps, unst) },
        λ e1 e2 m1 m2 w => match inv_of(e1, m1) { ⟨pe, pp⟩ => absurd(trans(sym(w), j(sym(pp.right), λ q _ => q.mode.writes() = False, refl))) },
        λ e1 e2 m1 m2 w pq => match inv_of(e2, m2) {
            ⟨pe, pp⟩ => {
                let pl1: (e1.par = l) = trans(pq, cong_fn(λ (q: VEnt) => q.par, pp.right));
                let rv: (s.role(e1.par) = KView) = j(sym(pl1), λ q _ => s.role(q) = KView, hr);
                match inv.wpar(e1, m1, w)(rv) {
                    ⟨pw, ppw⟩ => {
                        let eo: (s.ents(l) = [pw]) = j(pl1, λ q _ => s.ents(q) = [pw], ppw.left);
                        let pep: (pe = pw) = VEnt::mem_one(pe, pw, j(eo, λ q _ => Mem(pe, q), pp.left));
                        let po = s.parent_one(e1, pw, rv, ppw.left, (inv.chain(e1, m1)).right);
                        let ch = inv.chain(e1, m1);
                        let lv1 = (inv.vents(e1, m1)).right.left;
                        let ne1: ¬(e1.lvl = l) = λ eq => Nat::lt_irrefl(l, j(eq, λ q _ => l < q, j(pl1, λ q _ => q < e1.lvl, ch.left)));
                        let anc: (l.member(s.anc_of(e1, nl)) = True) = j(pl1, λ q _ => q.member(s.anc_of(e1, nl)) = True, s.anc_par(e1, ch.left, lv1));
                        let mt = s.meets_view(l, Reading, e1, hr, ne1, j(sym(w), λ c2 _ => (False || c2) = True, refl), anc);
                        let ap = Inv::sib_lic(tys, cx, sl, inv, none, Reading, l, (s.ents(l)).map(λ e3 => Pl(e3.obj, e3.reg ++ g.at)), ri.rl, lic, resl, e1, m1, mt,
                            Pl(pe.obj, pe.reg ++ g.at), List::mem_map(s.ents(l), pe, λ e3 => Pl(e3.obj, e3.reg ++ g.at), pp.left),
                            trans(sym(po.left), cong_fn(λ (q: VEnt) => q.obj, sym(pep))), pw.reg, g.at, po.right, cong_fn(λ (q: VEnt) => q.reg ++ g.at, pep), rlv.left, rlv.right);
                        j(sym(pp.right), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(q.at), ws)), ap)
                    },
                }
            },
        })
}

theorem CSt::write_lic_hold(self s: CSt, l: Nat, xs: List<Step>, rw: List<Residual>, h: s.write_at(l, xs) = Some(rw), o: Nat, a: Acc, hr: s.role(l) = KHold(o, a)):
    (a.writes() = True) ∧ (s.license(s.views, Writing, l, [Pl(o, xs)]) = Some(rw))
{
    let h2: (a.writes().then(s.license(s.views, Writing, l, [Pl(o, xs)])) = Some(rw)) =
        j(hr, λ q _ => (match q { KGone => None<List<Residual>>(), KPlain => Some(Nil<Residual>), KHold(o2, a2) => a2.writes().then(s.license(s.views, Writing, l, [Pl(o2, xs)])),
            KView => match s.ents(l) { Cons(e1, rest) => match rest { Nil => e1.mode.writes().then(s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)])), Cons(_, _) => None<List<Residual>>() }, Nil => None<List<Residual>>() } }) = Some(rw), h);
    Bool::then_some(a.writes(), s.license(s.views, Writing, l, [Pl(o, xs)]), rw, h2)
}

theorem CSt::write_lic_view(self s: CSt, l: Nat, xs: List<Step>, rw: List<Residual>, h: s.write_at(l, xs) = Some(rw), hr: s.role(l) = KView):
    Exists<VEnt>(λ pe => (s.ents(l) = [pe]) ∧ ((pe.mode.writes() = True) ∧ (s.license(s.views, Writing, l, [Pl(pe.obj, pe.reg ++ xs)]) = Some(rw))))
{
    let h2: ((match s.ents(l) { Cons(e1, rest) => match rest { Nil => e1.mode.writes().then(s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)])), Cons(_, _) => None<List<Residual>>() }, Nil => None<List<Residual>>() }) = Some(rw)) =
        j(hr, λ q _ => (match q { KGone => None<List<Residual>>(), KPlain => Some(Nil<Residual>), KHold(o2, a2) => a2.writes().then(s.license(s.views, Writing, l, [Pl(o2, xs)])),
            KView => match s.ents(l) { Cons(e1, rest) => match rest { Nil => e1.mode.writes().then(s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)])), Cons(_, _) => None<List<Residual>>() }, Nil => None<List<Residual>>() } }) = Some(rw), h);
    (match s.ents(l) as λ q => s.ents(l) = q → (match q { Cons(e1, rest) => match rest { Nil => e1.mode.writes().then(s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)])), Cons(_, _) => None<List<Residual>>() }, Nil => None<List<Residual>>() }) = Some(rw) →
            Exists<VEnt>(λ pe => (s.ents(l) = [pe]) ∧ ((pe.mode.writes() = True) ∧ (s.license(s.views, Writing, l, [Pl(pe.obj, pe.reg ++ xs)]) = Some(rw)))) {
        Nil => λ _ no => absurd(no),
        Cons(e1, rest) => λ eq => (match rest as λ r2 => s.ents(l) = Cons(e1, r2) → (match r2 { Nil => e1.mode.writes().then(s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)])), Cons(_, _) => None<List<Residual>>() }) = Some(rw) →
                Exists<VEnt>(λ pe => (s.ents(l) = [pe]) ∧ ((pe.mode.writes() = True) ∧ (s.license(s.views, Writing, l, [Pl(pe.obj, pe.reg ++ xs)]) = Some(rw)))) {
            Nil => λ eq2 h3 => Exists(e1, ⟨eq2, Bool::then_some(e1.mode.writes(), s.license(s.views, Writing, l, [Pl(e1.obj, e1.reg ++ xs)]), rw, h3)⟩),
            Cons(_, _) => λ _ no => absurd(no),
        })(eq),
    })(refl, h2)
}

// A view to write of a holder.
theorem Stmt::stage_view_hold_write(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), o: Nat, a: Acc, hr: s.role(g.root) = KHold(o, a),
    rw: List<Residual>, okw: s.write_at(g.root, g.at) = Some(rw), tail: Type, res: Residual::All(g.rs ++ rw, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, View(p, Writing), s.with_view([VEnt(s.na + s.nd, o, g.at, Writing, g.root, g.at, True)], g.code), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let ri = s.read_inv(tys, strs, p, g, ok);
    let l = g.root;
    let nl = s.na + s.nd;
    let below: (l < nl) = s.lvl_below(p.root, l, ri.lvl);
    let rlv = s.read_lvls(tys, strs, p, g, ri);
    let sp = Residual::all_app(tys, cx, e, tail, g.rs, rw, res);
    let resl = ReadInv::lic_res(tys, cx, ri, e, True, sp.left);
    let resw = Residual::all_true(tys, cx, e, tail, rw, sp.right);
    let en0 = VEnt(nl, o, g.at, Writing, l, g.at, True);
    let ws = Mach::ixs(tys, strs, m);
    let lic = s.read_lic_hold(l, g.at, ri.rl, ri.rat, o, a, hr);
    let wl = s.write_lic_hold(l, g.at, rw, okw, o, a, hr);
    let parent: s.Parent(en0) = j(sym(hr), λ q _ => match q { KHold(o2, _) => (o2 = o) ∧ (g.at = g.at), KView => VEnt::Any(s.ents(l), λ pe => (pe.obj = o) ∧ (g.at = pe.reg ++ g.at)),
        KPlain => False, KGone => False }, ⟨refl, refl⟩);
    let unst: (s.unsteps(g.at) = p.steps) = CSt::unsteps_steps(p.steps, s, g.at, ri.steps);
    let ne_view: ((e1: VEnt) → Mem(e1, s.views) → ¬(e1.lvl = l)) = λ e1 m1 eq => absurd(trans(sym((inv.vents(e1, m1)).right.right), trans(cong_fn(λ (q: Nat) => s.role(q), eq), hr)));
    Stmt::stage_view_core(tys, cx, sl, fns, call, inv, none, p, Writing, g, ok, True, sp.left, [en0],
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.par = g.root, refl),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.lvl = nl, refl),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.obj < s.nobj, inv.held(l, o, a, below, hr)),
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.par < nl) ∧ s.Parent(q), ⟨below, parent⟩),
        λ en mem l2 m2 => {
            let m3: ((l2.member(Steps::lvls(g.at)) || l2.member(Steps::lvls(g.at))) = True) = j(VEnt::mem_one(en, en0, mem), λ q _ => (l2.member(Steps::lvls(q.reg)) || l2.member(Steps::lvls(q.at))) = True, m2);
            match Bool::or_true_parts(l2.member(Steps::lvls(g.at)), l2.member(Steps::lvls(g.at)), m3) { Inl(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩, Inr(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩ }
        },
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.mode.writes() && !q.back) = False, refl),
        λ en mem w => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.Changes(q.obj), Inl(Exists(l, ⟨below, Exists(a, ⟨hr, wl.left⟩)⟩))),
        λ en mem w => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.WPar(q), λ rv => absurd(trans(sym(rv), hr))),
        λ r cr => {
            let rt: (inv.root(o) = Some(r)) = j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
                KPlain => False, KGone => True }, inv.refs(p.root, l, ri.lvl, r, cr));
            Inl(j(sym(rt), λ q _ => q.map(λ r0 => r0.narrow(ws, s.unsteps(g.at))) = Some(r.narrow(ws, p.steps)), cong_fn(λ (xs: List<Step>) => Some(r.narrow(ws, xs)), unst)))
        },
        λ e1 e2 m1 m2 w eo _ => {
            let e1is = VEnt::mem_one(e1, en0, m1);
            let mt = s.meets_hold(l, Writing, e2, o, a, hr, ne_view(e2, m2), refl);
            let ap = Inv::lic_apart(tys, cx, sl, inv, none, Writing, l, [Pl(o, g.at)], rw, wl.right, resw, e2, m2, mt, Pl(o, g.at), Inl(refl),
                trans(sym(eo), cong_fn(λ (q: VEnt) => q.obj, e1is)), rlv.left, rlv.right);
            j(sym(e1is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q.reg), ws), Steps::sels(s.unsteps(e2.reg), ws)),
                Sel::apart_sym(tys, strs, Steps::sels(s.unsteps(e2.reg), ws), Steps::sels(s.unsteps(g.at), ws), ap))
        },
        λ e1 e2 m1 m2 w eo _ => {
            let e2is = VEnt::mem_one(e2, en0, m2);
            let mt = s.meets_hold(l, Reading, e1, o, a, hr, ne_view(e1, m1), j(sym(w), λ c _ => (False || c) = True, refl));
            let ap = Inv::lic_apart(tys, cx, sl, inv, none, Reading, l, [Pl(o, g.at)], ri.rl, lic, resl, e1, m1, mt, Pl(o, g.at), Inl(refl),
                trans(eo, cong_fn(λ (q: VEnt) => q.obj, e2is)), rlv.left, rlv.right);
            j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(q.reg), ws)), ap)
        },
        λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.unsteps(q.at) = p.steps, unst),
        λ e1 e2 m1 m2 w pp => {
            let e1is = VEnt::mem_one(e1, en0, m1);
            let pl2: (e2.par = l) = trans(sym(pp), cong_fn(λ (q: VEnt) => q.par, e1is));
            let ph = s.parent_hold(e2, o, a, j(sym(pl2), λ q _ => s.role(q) = KHold(o, a), hr), (inv.chain(e2, m2)).right);
            let mt = s.meets_hold(l, Writing, e2, o, a, hr, ne_view(e2, m2), refl);
            let ap = Inv::sib_lic(tys, cx, sl, inv, none, Writing, l, [Pl(o, g.at)], rw, wl.right, resw, e2, m2, mt, Pl(o, g.at), Inl(refl), sym(ph.left), Nil, g.at, ph.right, refl, rlv.left, rlv.right);
            j(sym(e1is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q.at), ws), Steps::sels(s.unsteps(e2.at), ws)),
                Sel::apart_sym(tys, strs, Steps::sels(s.unsteps(e2.at), ws), Steps::sels(s.unsteps(g.at), ws), ap))
        },
        λ e1 e2 m1 m2 w pp => {
            let e2is = VEnt::mem_one(e2, en0, m2);
            let pl1: (e1.par = l) = trans(pp, cong_fn(λ (q: VEnt) => q.par, e2is));
            let ph = s.parent_hold(e1, o, a, j(sym(pl1), λ q _ => s.role(q) = KHold(o, a), hr), (inv.chain(e1, m1)).right);
            let mt = s.meets_hold(l, Reading, e1, o, a, hr, ne_view(e1, m1), j(sym(w), λ c _ => (False || c) = True, refl));
            let ap = Inv::sib_lic(tys, cx, sl, inv, none, Reading, l, [Pl(o, g.at)], ri.rl, lic, resl, e1, m1, mt, Pl(o, g.at), Inl(refl), sym(ph.left), Nil, g.at, ph.right, refl, rlv.left, rlv.right);
            j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(q.at), ws)), ap)
        })
}

// A view to write of a view to write: through its one entry.
theorem Stmt::stage_view_view_write(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), hr: s.role(g.root) = KView,
    rw: List<Residual>, okw: s.write_at(g.root, g.at) = Some(rw), pe1: VEnt, eone: s.ents(g.root) = [pe1], tail: Type, res: Residual::All(g.rs ++ rw, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, View(p, Writing), s.with_view([VEnt(s.na + s.nd, pe1.obj, pe1.reg ++ g.at, Writing, g.root, g.at, True)], g.code), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let ri = s.read_inv(tys, strs, p, g, ok);
    let l = g.root;
    let nl = s.na + s.nd;
    let below: (l < nl) = s.lvl_below(p.root, l, ri.lvl);
    let rlv = s.read_lvls(tys, strs, p, g, ri);
    let sp = Residual::all_app(tys, cx, e, tail, g.rs, rw, res);
    let resl = ReadInv::lic_res(tys, cx, ri, e, True, sp.left);
    let resw = Residual::all_true(tys, cx, e, tail, rw, sp.right);
    let en0 = VEnt(nl, pe1.obj, pe1.reg ++ g.at, Writing, l, g.at, True);
    let ws = Mach::ixs(tys, strs, m);
    let lic = s.read_lic_view(l, g.at, ri.rl, ri.rat, hr);
    let wl0 = s.write_lic_view(l, g.at, rw, okw, hr);
    let lt: ((en: VEnt) → Mem(en, s.views) → en.par < en.lvl) = λ en mem => (inv.chain(en, mem)).left;
    let unst: (s.unsteps(g.at) = p.steps) = CSt::unsteps_steps(p.steps, s, g.at, ri.steps);
    let mp1: Mem(pe1, s.ents(l)) = j(sym(eone), λ q _ => Mem(pe1, q), Inl(refl));
    let mv1: Mem(pe1, s.views) = s.views.mem_filter(pe1, λ q => q.lvl.same(l), mp1);
    let pl1: (pe1.lvl = l) = pe1.lvl.same_sound(l, s.views.mem_filter_holds(pe1, λ q => q.lvl.same(l), mp1));
    match wl0 {
        ⟨pw, ppw⟩ => {
            let same1: (pw = pe1) = cong_fn(λ (q: List<VEnt>) => q.nth(0).unwrap_or(pe1), trans(sym(ppw.left), eone));
            let w1: (pe1.mode.writes() = True) = j(same1, λ q _ => q.mode.writes() = True, ppw.right.left);
            let licw: (s.license(s.views, Writing, l, [Pl(pe1.obj, pe1.reg ++ g.at)]) = Some(rw)) = j(same1, λ q _ => s.license(s.views, Writing, l, [Pl(q.obj, q.reg ++ g.at)]) = Some(rw), ppw.right.right);
            let regw = s.lvls_app(pe1.reg, g.at, λ l2 => (l2 < nl) ∧ ((s.role(l2)).plain() = True), λ l2 ml => inv.words(l2, s.region_lvl(pe1, mv1, l2, ml)), λ l2 ml => ⟨rlv.left(l2, ml), rlv.right(l2, ml)⟩);
            let rg: s.InRange(Steps::lvls(pe1.reg ++ g.at)) = λ l2 ml => (regw(l2, ml)).left;
            let pg: ((l2: Nat) → l2.member(Steps::lvls(pe1.reg ++ g.at)) = True → (s.role(l2)).plain() = True) = λ l2 ml => (regw(l2, ml)).right;
            let selapp: (Steps::sels(s.unsteps(pe1.reg ++ g.at), ws) = Steps::sels(s.unsteps(pe1.reg), ws) ++ Steps::sels(s.unsteps(g.at), ws)) =
                trans(cong_fn(λ (xs: List<Step>) => Steps::sels(xs, ws), s.unsteps_app(pe1.reg, g.at)), List::map_append(s.unsteps(pe1.reg), s.unsteps(g.at), λ (a: Step) => a.sel(ws)));
            let ne_l: ((e1: VEnt) → Mem(e1, s.views) → e1.lvl.member(s.anc_of(en0, nl)) = False → ¬(e1.lvl = l)) = λ e1 m1 a1 => (s.anc_new(lt, en0, l, refl, refl, below, e1.lvl, a1)).left;
            Stmt::stage_view_core(tys, cx, sl, fns, call, inv, none, p, Writing, g, ok, True, sp.left, [en0],
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.par = g.root, refl),
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.lvl = nl, refl),
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => q.obj < s.nobj, (inv.vents(pe1, mv1)).left),
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.par < nl) ∧ s.Parent(q), ⟨below,
                    j(sym(hr), λ q _ => match q { KHold(o2, _) => (o2 = pe1.obj) ∧ (pe1.reg ++ g.at = g.at), KView => VEnt::Any(s.ents(l), λ pe2 => (pe2.obj = pe1.obj) ∧ (pe1.reg ++ g.at = pe2.reg ++ g.at)),
                        KPlain => False, KGone => False }, VEnt::any_of_mem(s.ents(l), λ pe2 => (pe2.obj = pe1.obj) ∧ (pe1.reg ++ g.at = pe2.reg ++ g.at), pe1, mp1, ⟨refl, refl⟩))⟩),
                λ en mem l2 m2 => {
                    let m3: ((l2.member(Steps::lvls(pe1.reg ++ g.at)) || l2.member(Steps::lvls(g.at))) = True) = j(VEnt::mem_one(en, en0, mem), λ q _ => (l2.member(Steps::lvls(q.reg)) || l2.member(Steps::lvls(q.at))) = True, m2);
                    match Bool::or_true_parts(l2.member(Steps::lvls(pe1.reg ++ g.at)), l2.member(Steps::lvls(g.at)), m3) { Inl(x) => regw(l2, x), Inr(x) => ⟨rlv.left(l2, x), rlv.right(l2, x)⟩ }
                },
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => (q.mode.writes() && !q.back) = False, refl),
                λ en mem w => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.Changes(q.obj), Inr(Exists(pe1, ⟨mv1, ⟨refl, w1⟩⟩))),
                λ en mem w => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.WPar(q), λ _ => Exists(pe1, ⟨eone, w1⟩)),
                λ r cr => {
                    let ok0: (VEnt::Any(s.ents(l), λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r))) =
                        j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r)),
                            KPlain => False, KGone => True }, inv.refs(p.root, l, ri.lvl, r, cr));
                    let ok1: (VEnt::Any([pe1], λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r))) =
                        j(eone, λ q _ => VEnt::Any(q, λ pe => (inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(r)), ok0);
                    let h1: ((inv.root(pe1.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe1.reg))) = Some(r)) = match ok1 { Inl(x) => x, Inr(no) => false_elim(no) };
                    match Option::map_some_inv(inv.root(pe1.obj), λ r0 => r0.narrow(ws, s.unsteps(pe1.reg)), r, h1) {
                        ⟨r0, pr⟩ => {
                            let nar: (r0.narrow(ws, s.unsteps(pe1.reg ++ g.at)) = r.narrow(ws, p.steps)) =
                                trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, xs), trans(s.unsteps_app(pe1.reg, g.at), cong_fn(λ (xs: List<Step>) => s.unsteps(pe1.reg) ++ xs, unst))),
                                    trans(Ref::narrow_app(r0, ws, s.unsteps(pe1.reg), p.steps), cong_fn(λ (q: Ref) => q.narrow(ws, p.steps), pr.right)));
                            Inl(j(sym(pr.left), λ q _ => q.map(λ r1 => r1.narrow(ws, s.unsteps(pe1.reg ++ g.at))) = Some(r.narrow(ws, p.steps)), cong_fn(λ (q: Ref) => Some(q), nar)))
                        },
                    }
                },
                λ e1 e2 m1 m2 w eo a2 => {
                    let e1is = VEnt::mem_one(e1, en0, m1);
                    let a2b: (e2.lvl.member(s.anc_of(en0, nl)) = False) = j(e1is, λ q _ => e2.lvl.member(s.anc_of(q, nl)) = False, a2);
                    let an = s.anc_new(lt, en0, l, refl, refl, below, e2.lvl, a2b);
                    let eo2: (pe1.obj = e2.obj) = trans(cong_fn(λ (q: VEnt) => q.obj, sym(e1is)), eo);
                    let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(pe1.reg ++ g.at), ws), Steps::sels(s.unsteps(e2.reg), ws)) =
                        (match l.member(s.anc_of(e2, nl)) as λ c => l.member(s.anc_of(e2, nl)) = c → Sel::Apart(tys, strs, Steps::sels(s.unsteps(pe1.reg ++ g.at), ws), Steps::sels(s.unsteps(e2.reg), ws)) {
                            True => λ ac => Sel::apart_sym(tys, strs, Steps::sels(s.unsteps(e2.reg), ws), Steps::sels(s.unsteps(pe1.reg ++ g.at), ws),
                                Inv::lic_apart(tys, cx, sl, inv, none, Writing, l, [Pl(pe1.obj, pe1.reg ++ g.at)], rw, licw, resw, e2, m2,
                                    s.meets_view(l, Writing, e2, hr, an.left, refl, ac), Pl(pe1.obj, pe1.reg ++ g.at), Inl(refl), sym(eo2), rg, pg)),
                            False => λ ac => {
                                let ex = inv.excl(pe1, e2, mv1, m2, w1, eo2, λ eq => an.left(trans(sym(eq), pl1)), j(sym(pl1), λ q _ => q.member(s.anc_of(e2, nl)) = False, ac), an.right(pe1, mp1));
                                j(sym(selapp), λ q _ => Sel::Apart(tys, strs, q, Steps::sels(s.unsteps(e2.reg), ws)),
                                    Sel::apart_ext_l(tys, strs, Steps::sels(s.unsteps(pe1.reg), ws), Steps::sels(s.unsteps(g.at), ws), Steps::sels(s.unsteps(e2.reg), ws), ex))
                            },
                        })(refl);
                    j(sym(e1is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q.reg), ws), Steps::sels(s.unsteps(e2.reg), ws)), ap)
                },
                λ e1 e2 m1 m2 w eo a1 => {
                    let e2is = VEnt::mem_one(e2, en0, m2);
                    let a1b: (e1.lvl.member(s.anc_of(en0, nl)) = False) = j(e2is, λ q _ => e1.lvl.member(s.anc_of(q, nl)) = False, a1);
                    let an = s.anc_new(lt, en0, l, refl, refl, below, e1.lvl, a1b);
                    let eo2: (e1.obj = pe1.obj) = trans(eo, cong_fn(λ (q: VEnt) => q.obj, e2is));
                    let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe1.reg ++ g.at), ws)) =
                        (match l.member(s.anc_of(e1, nl)) as λ c => l.member(s.anc_of(e1, nl)) = c → Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe1.reg ++ g.at), ws)) {
                            True => λ ac => Inv::lic_apart(tys, cx, sl, inv, none, Reading, l, (s.ents(l)).map(λ e3 => Pl(e3.obj, e3.reg ++ g.at)), ri.rl, lic, resl, e1, m1,
                                s.meets_view(l, Reading, e1, hr, an.left, j(sym(w), λ c2 _ => (False || c2) = True, refl), ac),
                                Pl(pe1.obj, pe1.reg ++ g.at), List::mem_map(s.ents(l), pe1, λ e3 => Pl(e3.obj, e3.reg ++ g.at), mp1), eo2, rg, pg),
                            False => λ ac => {
                                let ex = inv.excl(e1, pe1, m1, mv1, w, eo2, λ eq => an.left(trans(eq, pl1)), an.right(pe1, mp1), j(sym(pl1), λ q _ => q.member(s.anc_of(e1, nl)) = False, ac));
                                j(sym(selapp), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), q),
                                    Sel::apart_ext_r(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(pe1.reg), ws), Steps::sels(s.unsteps(g.at), ws), ex))
                            },
                        })(refl);
                    j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.reg), ws), Steps::sels(s.unsteps(q.reg), ws)), ap)
                },
                λ en mem => j(sym(VEnt::mem_one(en, en0, mem)), λ q _ => s.unsteps(q.at) = p.steps, unst),
                λ e1 e2 m1 m2 w pp => {
                    let e1is = VEnt::mem_one(e1, en0, m1);
                    let pl2: (e2.par = l) = trans(sym(pp), cong_fn(λ (q: VEnt) => q.par, e1is));
                    let rv: (s.role(e2.par) = KView) = j(sym(pl2), λ q _ => s.role(q) = KView, hr);
                    let po = s.parent_one(e2, pe1, rv, j(sym(pl2), λ q _ => s.ents(q) = [pe1], eone), (inv.chain(e2, m2)).right);
                    let ch = inv.chain(e2, m2);
                    let ne2: ¬(e2.lvl = l) = λ eq => Nat::lt_irrefl(l, j(eq, λ q _ => l < q, j(pl2, λ q _ => q < e2.lvl, ch.left)));
                    let anc: (l.member(s.anc_of(e2, nl)) = True) = j(pl2, λ q _ => q.member(s.anc_of(e2, nl)) = True, s.anc_par(e2, ch.left, (inv.vents(e2, m2)).right.left));
                    let mt = s.meets_view(l, Writing, e2, hr, ne2, refl, anc);
                    let ap = Inv::sib_lic(tys, cx, sl, inv, none, Writing, l, [Pl(pe1.obj, pe1.reg ++ g.at)], rw, licw, resw, e2, m2, mt, Pl(pe1.obj, pe1.reg ++ g.at), Inl(refl),
                        sym(po.left), pe1.reg, g.at, po.right, refl, rlv.left, rlv.right);
                    j(sym(e1is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q.at), ws), Steps::sels(s.unsteps(e2.at), ws)),
                        Sel::apart_sym(tys, strs, Steps::sels(s.unsteps(e2.at), ws), Steps::sels(s.unsteps(g.at), ws), ap))
                },
                λ e1 e2 m1 m2 w pp => {
                    let e2is = VEnt::mem_one(e2, en0, m2);
                    let pl1: (e1.par = l) = trans(pp, cong_fn(λ (q: VEnt) => q.par, e2is));
                    let rv: (s.role(e1.par) = KView) = j(sym(pl1), λ q _ => s.role(q) = KView, hr);
                    let po = s.parent_one(e1, pe1, rv, j(sym(pl1), λ q _ => s.ents(q) = [pe1], eone), (inv.chain(e1, m1)).right);
                    let ch = inv.chain(e1, m1);
                    let ne1: ¬(e1.lvl = l) = λ eq => Nat::lt_irrefl(l, j(eq, λ q _ => l < q, j(pl1, λ q _ => q < e1.lvl, ch.left)));
                    let anc: (l.member(s.anc_of(e1, nl)) = True) = j(pl1, λ q _ => q.member(s.anc_of(e1, nl)) = True, s.anc_par(e1, ch.left, (inv.vents(e1, m1)).right.left));
                    let mt = s.meets_view(l, Reading, e1, hr, ne1, j(sym(w), λ c2 _ => (False || c2) = True, refl), anc);
                    let ap = Inv::sib_lic(tys, cx, sl, inv, none, Reading, l, (s.ents(l)).map(λ e3 => Pl(e3.obj, e3.reg ++ g.at)), ri.rl, lic, resl, e1, m1, mt,
                        Pl(pe1.obj, pe1.reg ++ g.at), List::mem_map(s.ents(l), pe1, λ e3 => Pl(e3.obj, e3.reg ++ g.at), mp1), sym(po.left), pe1.reg, g.at, po.right, refl, rlv.left, rlv.right);
                    j(sym(e2is), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(e1.at), ws), Steps::sels(s.unsteps(q.at), ws)), ap)
                })
        },
    }
}

// A view of a plain variable: a copy.
theorem Stmt::stage_view_plain(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, md: Mode, g: Got, ok: s.read(tys, cx.strs, p) = Some(g), hp: s.role(g.root) = KPlain,
    tail: Type, res: Residual::All(g.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, View(p, md), s.push(CVar(g.code, KPlain)), Env::push(tys, e, p.val(tys, cx.strs, e)), m, h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ri = s.read_inv(tys, strs, p, g, ok);
    let d = p.val(tys, strs, e);
    let at = Sim::place(tys, cx, sl, sim, p, g, ok, tail, res);
    let pv = Sim::plain_cell(tys, strs, sim, p.root, g.root, ri.lvl, j(sym(hp), λ q _ => q.plain() = True, refl));
    let cell: (Cell::view_of(tys, (REnv::get(tys, m.env, p.root)).v, d, Mach::ixs(tys, strs, m), p.steps) = Cell::plain(tys, d)) =
        j(sym(pv), λ v _ => Cell::view_of(tys, v, d, Mach::ixs(tys, strs, m), p.steps) = Cell::plain(tys, d), refl);
    Stepped(Mach::push(tys, m, Cell::plain(tys, d)),
        λ k => trans(Stmt::view_runs(tys, strs, fns, call, m, p, md, d, at, k), cong_fn(λ (c: Cell(tys)) => k(Mach::push(tys, m, c)), cell)),
        Inv::push_plain(tys, strs, inv, none, g.code, d, False, Sim::place_code(tys, strs, sim, p, g, ok)))
}

// ---------------------------------------------------------------------------
// A write: one variable's cell, or one block, changed

theorem CSt::lvl_var_at(self s: CSt, l: Nat, below: l < s.na + s.nd): s.lvl(s.var_at(l)) = Some(l) {
    (match (l + 1).leb(s.na) as λ c => (l + 1).leb(s.na) = c → s.lvl(match c { True => Arg(l), False => Loc(s.na + s.nd - 1 - l) }) = Some(l) {
        True => λ e => j(sym(e), λ c _ => c.then(Some(l)) = Some(l), refl),
        False => λ e => {
            let na = s.na;
            let nd = s.nd;
            let ge: ¬(l + 1 <= na) = λ le => absurd(trans(sym(e), Nat::leb_true(l + 1, na, le)));
            let b2: (l < na + nd) = below;
            let kb: ((na + nd - 1 - l) + 1 <= nd) = omega(ge, b2);
            let back: (na + nd - 1 - (na + nd - 1 - l) = l) = omega(ge, b2);
            j(sym(Nat::leb_true((na + nd - 1 - l) + 1, nd, kb)), λ c _ => c.then(Some(na + nd - 1 - (na + nd - 1 - l))) = Some(l), cong_fn(λ (n: Nat) => Some(n), back))
        },
    })(refl)
}

theorem CSt::var_ne(self s: CSt, x, y: Var, l, l2: Nat, hx: s.lvl(x) = Some(l), hy: s.lvl(y) = Some(l2), ne: ¬(l = l2)): ¬(x = y) {
    λ eq => ne(Option::some_inj(l, l2, trans(sym(hx), trans(cong_fn(λ (v: Var) => s.lvl(v), eq), hy))))
}

fn Var::In(x: Var, na, nd: Nat) → Type { match x { Arg(i) => i < na, Loc(k) => k < nd } }

theorem CSt::var_inside(self s: CSt, x: Var, l: Nat, hl: s.lvl(x) = Some(l)): Var::In(x, s.na, s.nd) {
    (match x as λ y => s.lvl(y) = Some(l) → Var::In(y, s.na, s.nd) {
        Arg(i) => λ h => { let q: (i + 1 <= s.na) = Nat::le_of_leb(i + 1, s.na, (Bool::then_some((i + 1).leb(s.na), Some(i), l, h)).left); omega(q) },
        Loc(k) => λ h => { let q: (k + 1 <= s.nd) = Nat::le_of_leb(k + 1, s.nd, (Bool::then_some((k + 1).leb(s.nd), Some(s.na + s.nd - 1 - k), l, h)).left); omega(q) },
    })(hl)
}

theorem Env::get_set_other(tys: Nat → Type, e: Env(tys), x, y: Var, f: Dyn(tys) → Dyn(tys), ne: ¬(x = y)): Env::get(tys, Env::set(tys, e, x, f), y) = Env::get(tys, e, y) {
    (match x as λ x0 => ¬(x0 = y) → Env::get(tys, Env::set(tys, e, x0, f), y) = Env::get(tys, e, y) {
        Arg(i) => (match y as λ y0 => ¬(Arg(i) = y0) → Env::get(tys, Env::set(tys, e, Arg(i), f), y0) = Env::get(tys, e, y0) {
            Arg(k) => λ n => cong_fn(λ (o: Option<Dyn(tys)>) => o.unwrap_or(Dyn::none(tys)), e.args.nth_update_other(i, f, k, λ eq => n(cong_fn(λ (q: Nat) => Arg(q), sym(eq))))),
            Loc(_) => λ _ => refl,
        }),
        Loc(i) => (match y as λ y0 => ¬(Loc(i) = y0) → Env::get(tys, Env::set(tys, e, Loc(i), f), y0) = Env::get(tys, e, y0) {
            Arg(_) => λ _ => refl,
            Loc(k) => λ n => cong_fn(λ (o: Option<Dyn(tys)>) => o.unwrap_or(Dyn::none(tys)), e.locs.nth_update_other(i, f, k, λ eq => n(cong_fn(λ (q: Nat) => Loc(q), sym(eq))))),
        }),
    })(ne)
}

theorem Env::get_set_same(tys: Nat → Type, e: Env(tys), x: Var, f: Dyn(tys) → Dyn(tys), b: Var::In(x, e.args.len(), e.locs.len())):
    Env::get(tys, Env::set(tys, e, x, f), x) = f(Env::get(tys, e, x))
{
    (match x as λ y => Var::In(y, e.args.len(), e.locs.len()) → Env::get(tys, Env::set(tys, e, y, f), y) = f(Env::get(tys, e, y)) {
        Arg(i) => λ bi => match e.args.nth_present(i, bi) {
            ⟨d, pd⟩ => trans(cong_fn(λ (o: Option<Dyn(tys)>) => o.unwrap_or(Dyn::none(tys)), e.args.nth_update_here(i, f, d, pd)),
                cong_fn(λ (q: Option<Dyn(tys)>) => f(q.unwrap_or(Dyn::none(tys))), sym(pd))),
        },
        Loc(k) => λ bk => match e.locs.nth_present(k, bk) {
            ⟨d, pd⟩ => trans(cong_fn(λ (o: Option<Dyn(tys)>) => o.unwrap_or(Dyn::none(tys)), e.locs.nth_update_here(k, f, d, pd)),
                cong_fn(λ (q: Option<Dyn(tys)>) => f(q.unwrap_or(Dyn::none(tys))), sym(pd))),
        },
    })(b)
}

theorem Env::set_args(tys: Nat → Type, e: Env(tys), x: Var, f: Dyn(tys) → Dyn(tys)): (Env::set(tys, e, x, f)).args.len() = e.args.len() {
    match x { Arg(i) => e.args.len_update(i, f), Loc(_) => refl }
}

theorem Env::set_locs(tys: Nat → Type, e: Env(tys), x: Var, f: Dyn(tys) → Dyn(tys)): (Env::set(tys, e, x, f)).locs.len() = e.locs.len() {
    match x { Arg(_) => refl, Loc(k) => e.locs.len_update(k, f) }
}

theorem REnv::get_set_other(tys: Nat → Type, e: REnv(tys), x, y: Var, c: Cell(tys), ne: ¬(x = y)): REnv::get(tys, REnv::set(tys, e, x, c), y) = REnv::get(tys, e, y) {
    (match x as λ x0 => ¬(x0 = y) → REnv::get(tys, REnv::set(tys, e, x0, c), y) = REnv::get(tys, e, y) {
        Arg(i) => (match y as λ y0 => ¬(Arg(i) = y0) → REnv::get(tys, REnv::set(tys, e, Arg(i), c), y0) = REnv::get(tys, e, y0) {
            Arg(k) => λ n => cong_fn(λ (o: Option<Cell(tys)>) => o.unwrap_or(Cell::none(tys)), e.args.nth_update_other(i, λ _ => c, k, λ eq => n(cong_fn(λ (q: Nat) => Arg(q), sym(eq))))),
            Loc(_) => λ _ => refl,
        }),
        Loc(i) => (match y as λ y0 => ¬(Loc(i) = y0) → REnv::get(tys, REnv::set(tys, e, Loc(i), c), y0) = REnv::get(tys, e, y0) {
            Arg(_) => λ _ => refl,
            Loc(k) => λ n => cong_fn(λ (o: Option<Cell(tys)>) => o.unwrap_or(Cell::none(tys)), e.locs.nth_update_other(i, λ _ => c, k, λ eq => n(cong_fn(λ (q: Nat) => Loc(q), sym(eq))))),
        }),
    })(ne)
}

theorem REnv::get_set_same(tys: Nat → Type, e: REnv(tys), x: Var, c: Cell(tys), b: Var::In(x, e.args.len(), e.locs.len())): REnv::get(tys, REnv::set(tys, e, x, c), x) = c {
    (match x as λ y => Var::In(y, e.args.len(), e.locs.len()) → REnv::get(tys, REnv::set(tys, e, y, c), y) = c {
        Arg(i) => λ bi => match e.args.nth_present(i, bi) {
            ⟨d, pd⟩ => cong_fn(λ (o: Option<Cell(tys)>) => o.unwrap_or(Cell::none(tys)), e.args.nth_update_here(i, λ _ => c, d, pd)),
        },
        Loc(k) => λ bk => match e.locs.nth_present(k, bk) {
            ⟨d, pd⟩ => cong_fn(λ (o: Option<Cell(tys)>) => o.unwrap_or(Cell::none(tys)), e.locs.nth_update_here(k, λ _ => c, d, pd)),
        },
    })(b)
}

theorem REnv::set_args(tys: Nat → Type, e: REnv(tys), x: Var, c: Cell(tys)): (REnv::set(tys, e, x, c)).args.len() = e.args.len() {
    match x { Arg(i) => e.args.len_update(i, λ _ => c), Loc(_) => refl }
}

theorem REnv::set_locs(tys: Nat → Type, e: REnv(tys), x: Var, c: Cell(tys)): (REnv::set(tys, e, x, c)).locs.len() = e.locs.len() {
    match x { Arg(_) => refl, Loc(k) => e.locs.len_update(k, λ _ => c) }
}

// The meaning's word at a level is its variable's.
theorem CSt::env_ix(self s: CSt, tys: Nat → Type, e: Env(tys), ea: e.args.len() = s.na, el: e.locs.len() = s.nd, l: Nat, below: l < s.na + s.nd):
    (Env::ixs(tys, e)).nth(s.ix_of(l)) = Some(Dyn::ix(tys, Env::get(tys, e, s.var_at(l))))
{
    let ixf = λ (x: Dyn(tys)) => Dyn::ix(tys, x);
    (match (l + 1).leb(s.na) as λ c => (l + 1).leb(s.na) = c →
            (Env::ixs(tys, e)).nth(match c { True => l, False => s.na + (s.nd - 1 - (l - s.na)) }) =
                Some(Dyn::ix(tys, Env::get(tys, e, match c { True => Arg(l), False => Loc(s.na + s.nd - 1 - l) }))) {
        True => λ c1 => {
            let lt: (l + 1 <= s.na) = Nat::le_of_leb(l + 1, s.na, c1);
            match e.args.nth_present(l, omega(lt, ea)) {
                ⟨d, pd⟩ => trans(List::nth_append_l(Dyn::ixs(tys, e.args), Dyn::ixs(tys, e.locs), l, Dyn::ix(tys, d), e.args.nth_map_some(ixf, l, d, pd)),
                    cong_fn(λ (q: Option<Dyn(tys)>) => Some(Dyn::ix(tys, q.unwrap_or(Dyn::none(tys)))), sym(pd))),
            }
        },
        False => λ c1 => {
            let na = s.na;
            let nd = s.nd;
            let ge: ¬(l + 1 <= na) = λ le => absurd(trans(sym(c1), Nat::leb_true(l + 1, na, le)));
            let b2: (l < na + nd) = below;
            let lm: ((Dyn::ixs(tys, e.args)).len() = e.args.len()) = e.args.len_map(ixf);
            let e1: (na + (nd - 1 - (l - na)) = (na + nd - 1 - l) + (Dyn::ixs(tys, e.args)).len()) = omega(ge, b2, ea, lm);
            match e.locs.nth_present(na + nd - 1 - l, omega(ge, b2, el)) {
                ⟨d, pd⟩ => trans(cong_fn(λ (q: Nat) => (Dyn::ixs(tys, e.args) ++ Dyn::ixs(tys, e.locs)).nth(q), e1),
                    trans((Dyn::ixs(tys, e.args)).nth_append_r(Dyn::ixs(tys, e.locs), na + nd - 1 - l),
                        trans(e.locs.nth_map_some(ixf, na + nd - 1 - l, d, pd), cong_fn(λ (q: Option<Dyn(tys)>) => Some(Dyn::ix(tys, q.unwrap_or(Dyn::none(tys)))), sym(pd))))),
            }
        },
    })(refl)
}

// What is written is like what was read where its code and length are.
theorem Dyn::like_of(tys: Nat → Type, strs: Strs(tys), sel: Sel, x, w: Dyn(tys), ec: w.code = x.code, el: Dyn::len(tys, strs, w) = Dyn::len(tys, strs, x)):
    Dyn::like(tys, strs, sel, x, w) = True
{
    let sc: (w.code.same(x.code) = True) = j(sym(ec), λ q _ => q.same(x.code) = True, x.code.same_self());
    let sn: (Dyn::len(tys, strs, w).same(Dyn::len(tys, strs, x)) = True) = j(sym(el), λ q _ => q.same(Dyn::len(tys, strs, x)) = True, Dyn::len(tys, strs, x).same_self());
    (match sel.run() as λ b => (match b { False => w.code.same(x.code), True => w.code.same(x.code) && Dyn::len(tys, strs, w).same(Dyn::len(tys, strs, x)) }) = True {
        False => sc,
        True => Bool::and_true_of(w.code.same(x.code), Dyn::len(tys, strs, w).same(Dyn::len(tys, strs, x)), sc, sn),
    })
}

// A write along a path keeps the value's code and length, where what it
// writes at the end keeps the code and length read there.
theorem Sel::write_keeps(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), g: Dyn(tys) → Dyn(tys)): (ss: List<Sel>) → (y: Dyn(tys)) →
    (g(Sel::read_at(tys, strs, ss, y))).code = (Sel::read_at(tys, strs, ss, y)).code → Dyn::len(tys, strs, g(Sel::read_at(tys, strs, ss, y))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, y)) →
    ((Sel::write_at(tys, strs, ss, g, y)).code = y.code) ∧ (Dyn::len(tys, strs, Sel::write_at(tys, strs, ss, g, y)) = Dyn::len(tys, strs, y))
{
    λ ss => match ss {
        Nil => λ y hc hl => ⟨hc, hl⟩,
        Cons(b, r) => λ y _ _ => ⟨refl, Dyn::in_len(tys, strs, b, Dyn::len_at(tys, strs, y.code), Dyn::part(tys, strs, b, y.code), Dyn::part_ok(tys, strs, sl, b, y.code),
            λ x => Sel::write_at(tys, strs, r, g, x), y.val)⟩,
    }
}

// A write along a path that fits keeps the path fitting, and the path then
// reads what was written.
theorem Sel::write_get(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), g: Dyn(tys) → Dyn(tys), ss: List<Sel>): (d: Dyn(tys)) → Sel::fit(tys, strs, ss, d) = True →
    (g(Sel::read_at(tys, strs, ss, d))).code = (Sel::read_at(tys, strs, ss, d)).code → Dyn::len(tys, strs, g(Sel::read_at(tys, strs, ss, d))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, d)) →
    (Sel::fit(tys, strs, ss, Sel::write_at(tys, strs, ss, g, d)) = True) ∧ (Sel::read_at(tys, strs, ss, Sel::write_at(tys, strs, ss, g, d)) = g(Sel::read_at(tys, strs, ss, d)))
{
    match ss {
        Nil => λ d _ _ _ => ⟨refl, refl⟩,
        Cons(a, rest) => λ d f hc hl => {
            let at0 = Dyn::at(tys, strs, a, d);
            let ff = λ (y: Dyn(tys)) => Sel::write_at(tys, strs, rest, g, y);
            let parts = Bool::and_true_parts(Dyn::fits(tys, strs, a, d), Sel::fit(tys, strs, rest, at0), f);
            let wk = Sel::write_keeps(tys, strs, sl, g, rest, at0, hc, hl);
            let lk = Dyn::like_of(tys, strs, a, at0, ff(at0), wk.left, wk.right);
            let ov: (Dyn::at(tys, strs, a, Dyn::over(tys, strs, a, ff, d)) = ff(at0)) = (Dyn::model_laws(tys, strs, sl)).over_at(a, ff, d, parts.left, lk);
            let ih = Sel::write_get(tys, strs, sl, g, rest, at0, parts.right, hc, hl);
            let fo: (Dyn::fits(tys, strs, a, Dyn::over(tys, strs, a, ff, d)) = True) = trans(Dyn::fits_over(tys, strs, sl, a, a, ff, d), parts.left);
            let fr: (Sel::fit(tys, strs, rest, Dyn::at(tys, strs, a, Dyn::over(tys, strs, a, ff, d))) = True) = j(sym(ov), λ q _ => Sel::fit(tys, strs, rest, q) = True, ih.left);
            ⟨Bool::and_true_of(Dyn::fits(tys, strs, a, Dyn::over(tys, strs, a, ff, d)), Sel::fit(tys, strs, rest, Dyn::at(tys, strs, a, Dyn::over(tys, strs, a, ff, d))), fo, fr),
                trans(cong_fn(λ (q: Dyn(tys)) => Sel::read_at(tys, strs, rest, q), ov), ih.right)⟩
        },
    }
}

theorem Sel::put_fit(tys: Nat → Type, strs: Strs(tys), ss: List<Sel>, x, d: Dyn(tys), f: Sel::fit(tys, strs, ss, d) = True):
    Sel::put(tys, strs, ss, x, d) = Some(Sel::write_at(tys, strs, ss, λ _ => x, d))
{
    j(sym(f), λ c _ => (match c { True => Some(Sel::write_at(tys, strs, ss, λ _ => x, d)), False => None<Dyn(tys)>() }) = Some(Sel::write_at(tys, strs, ss, λ _ => x, d)), refl)
}

// The run's write: into the cell of a plain root, into the block of a root
// that refers.
theorem Stmt::write_runs_plain(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), p: Place, x: Var, d: Dyn(tys),
    vx: Mach::val(tys, strs, m, x) = Some(d), old: Dyn(tys), cv: (REnv::get(tys, m.env, p.root)).v = Plain(old), nw: Dyn(tys),
    put: Sel::put(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), d, old) = Some(nw), k: Mach(tys) → Ran(tys)):
    (Write(p, x)).run(tys, strs, fns, call, m, k) = k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(nw), (REnv::get(tys, m.env, p.root)).own)), m.io))
{
    let ss = Steps::sels(p.steps, Mach::ixs(tys, strs, m));
    let c = REnv::get(tys, m.env, p.root);
    let goal = k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(nw), c.own)), m.io));
    let body: Dyn(tys) → Ran(tys) = λ d0 => match c.v {
        Plain(o0) => match Sel::put(tys, strs, ss, d0, o0) { Some(n0) => k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(n0), c.own)), m.io)), None => Stuck },
        Refer(r) => match Heap::val(tys, strs, m.heap, r.b) {
            Some(o0) => match Sel::put(tys, strs, r.sels ++ ss, d0, o0) { Some(n0) => k(Mach(Heap::store(tys, m.heap, r.b, n0), m.env, m.io)), None => Stuck },
            None => Stuck,
        },
    };
    let inner: (body(d) = goal) =
        j(sym(cv), λ q _ => (match q {
                Plain(o0) => match Sel::put(tys, strs, ss, d, o0) { Some(n0) => k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(n0), c.own)), m.io)), None => Stuck },
                Refer(r) => match Heap::val(tys, strs, m.heap, r.b) {
                    Some(o0) => match Sel::put(tys, strs, r.sels ++ ss, d, o0) { Some(n0) => k(Mach(Heap::store(tys, m.heap, r.b, n0), m.env, m.io)), None => Stuck },
                    None => Stuck,
                },
            }) = goal,
            j(sym(put), λ o _ => (match o { Some(n0) => k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(n0), c.own)), m.io)), None => Stuck }) = goal, refl));
    j(sym(vx), λ o _ => (match o { None => Stuck, Some(d0) => body(d0) }) = goal, inner)
}

theorem Stmt::write_runs_ref(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), p: Place, x: Var, d: Dyn(tys),
    vx: Mach::val(tys, strs, m, x) = Some(d), r: Ref, cv: (REnv::get(tys, m.env, p.root)).v = Refer(r), old: Dyn(tys), hv: Heap::val(tys, strs, m.heap, r.b) = Some(old), nw: Dyn(tys),
    put: Sel::put(tys, strs, r.sels ++ Steps::sels(p.steps, Mach::ixs(tys, strs, m)), d, old) = Some(nw), k: Mach(tys) → Ran(tys)):
    (Write(p, x)).run(tys, strs, fns, call, m, k) = k(Mach(Heap::store(tys, m.heap, r.b, nw), m.env, m.io))
{
    let ss = Steps::sels(p.steps, Mach::ixs(tys, strs, m));
    let c = REnv::get(tys, m.env, p.root);
    let goal = k(Mach(Heap::store(tys, m.heap, r.b, nw), m.env, m.io));
    let body: Dyn(tys) → Ran(tys) = λ d0 => match c.v {
        Plain(o0) => match Sel::put(tys, strs, ss, d0, o0) { Some(n0) => k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(n0), c.own)), m.io)), None => Stuck },
        Refer(r0) => match Heap::val(tys, strs, m.heap, r0.b) {
            Some(o0) => match Sel::put(tys, strs, r0.sels ++ ss, d0, o0) { Some(n0) => k(Mach(Heap::store(tys, m.heap, r0.b, n0), m.env, m.io)), None => Stuck },
            None => Stuck,
        },
    };
    let inner: (body(d) = goal) =
        j(sym(cv), λ q _ => (match q {
                Plain(o0) => match Sel::put(tys, strs, ss, d, o0) { Some(n0) => k(Mach(m.heap, REnv::set(tys, m.env, p.root, Cell(Plain(n0), c.own)), m.io)), None => Stuck },
                Refer(r0) => match Heap::val(tys, strs, m.heap, r0.b) {
                    Some(o0) => match Sel::put(tys, strs, r0.sels ++ ss, d, o0) { Some(n0) => k(Mach(Heap::store(tys, m.heap, r0.b, n0), m.env, m.io)), None => Stuck },
                    None => Stuck,
                },
            }) = goal,
            j(sym(hv), λ o _ => (match o {
                    Some(o0) => match Sel::put(tys, strs, r.sels ++ ss, d, o0) { Some(n0) => k(Mach(Heap::store(tys, m.heap, r.b, n0), m.env, m.io)), None => Stuck },
                    None => Stuck,
                }) = goal,
                j(sym(put), λ o _ => (match o { Some(n0) => k(Mach(Heap::store(tys, m.heap, r.b, n0), m.env, m.io)), None => Stuck }) = goal, refl)));
    j(sym(vx), λ o _ => (match o { None => Stuck, Some(d0) => body(d0) }) = goal, inner)
}

// What a write the checker accepts knows.
record WriteInv(tys: Nat → Type, strs: Strs(tys), s: CSt, p: Place, v: Var, n: Next) {
    gv: Got,
    okv: s.read_var(tys, strs, v) = Some(gv),
    lv: Nat,
    hlv: s.lvl(v) = Some(lv),
    l: Nat,
    hl: s.lvl(p.root) = Some(l),
    xs: List<Step>,
    hxs: s.steps(p.steps) = Some(xs),
    c: Shape,
    hc: Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code) = Some(c),
    ra: List<Residual>,
    hra: s.atoms_ok(Steps::lvls(xs)) = Some(ra),
    last: s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra) = Some(n),
}

theorem CSt::write_inv(self s: CSt, tys: Nat → Type, strs: Strs(tys), p: Place, v: Var, n: Next, ok: s.write(tys, strs, p, v) = Some(n)): WriteInv(tys, strs, s, p, v, n) {
    let a1 = Option::and_then_some<Got, Next>(s.read_var(tys, strs, v), λ gv => s.lvl(v).and_then(λ lv => s.lvl(p.root).and_then(λ l => s.steps(p.steps).and_then(λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c => s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra)))))), n, ok);
    let gv = a1.witness;
    let a2 = Option::and_then_some<Nat, Next>(s.lvl(v), λ lv => s.lvl(p.root).and_then(λ l => s.steps(p.steps).and_then(λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c => s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra))))), n, a1.proof.right);
    let lv = a2.witness;
    let a3 = Option::and_then_some<Nat, Next>(s.lvl(p.root), λ l => s.steps(p.steps).and_then(λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c => s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra)))), n, a2.proof.right);
    let l = a3.witness;
    let a4 = Option::and_then_some<List<Step>, Next>(s.steps(p.steps), λ xs => Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code).and_then(λ c => s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra))), n, a3.proof.right);
    let xs = a4.witness;
    let a5 = Option::and_then_some<Shape, Next>(Shape::steps_ok(tys, strs, p.steps, (s.var(l)).code), λ c => s.atoms_ok(Steps::lvls(xs)).and_then(λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra)), n, a4.proof.right);
    let c = a5.witness;
    let a6 = Option::and_then_some<List<Residual>, Next>(s.atoms_ok(Steps::lvls(xs)), λ ra => s.write_last(tys, strs, p, v, gv, lv, l, xs, c, ra), n, a5.proof.right);
    WriteInv(gv, a1.proof.left, lv, a2.proof.left, l, a3.proof.left, xs, a4.proof.left, c, a5.proof.left, a6.witness, a6.proof.left, a6.proof.right)
}

// The write's condition: its root is no region's word and not gone.
theorem WriteInv::cond(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {p: Place}, {v: Var}, {n: Next}, self wi: WriteInv(tys, strs, s, p, v, n)):
    (!s.in_regions(wi.l) && !(s.role(wi.l)).same(KGone)) = True
{
    (Bool::then_some(!s.in_regions(wi.l) && !(s.role(wi.l)).same(KGone), match s.is_back(wi.l, wi.xs, wi.lv) as λ _ => Option<Next> {
            True => Some(Next(s.backed(wi.lv).wrote_to(wi.l), wi.gv.rs ++ wi.ra)),
            False => s.write_at(wi.l, wi.xs).map(λ rl => Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })),
        }, n, wi.last)).left
}

// A write that is not a write-back: the licence's residuals, and the state
// it leaves.
theorem WriteInv::plain_last(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {p: Place}, {v: Var}, {n: Next}, self wi: WriteInv(tys, strs, s, p, v, n), nb: s.is_back(wi.l, wi.xs, wi.lv) = False):
    Exists<List<Residual>>(λ rl => (s.write_at(wi.l, wi.xs) = Some(rl)) ∧
        (n = Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })))
{
    let h: ((s.write_at(wi.l, wi.xs)).map(λ rl => Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })) = Some(n)) =
        j(nb, λ b _ => (match b { True => Some(Next(s.backed(wi.lv).wrote_to(wi.l), wi.gv.rs ++ wi.ra)), False => (s.write_at(wi.l, wi.xs)).map(λ rl => Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })) }) = Some(n), (Bool::then_some(!s.in_regions(wi.l) && !(s.role(wi.l)).same(KGone), match s.is_back(wi.l, wi.xs, wi.lv) as λ _ => Option<Next> { True => Some(Next(s.backed(wi.lv).wrote_to(wi.l), wi.gv.rs ++ wi.ra)), False => s.write_at(wi.l, wi.xs).map(λ rl => Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })) }, n, wi.last)).right);
    match Option::map_some_inv(s.write_at(wi.l, wi.xs), λ rl => Next(s.wrote_to(wi.l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() }), n, h) {
        ⟨rl, pr⟩ => Exists(rl, ⟨pr.left, sym(pr.right)⟩),
    }
}

// A value whose code is not a sequence has length 0.
theorem Dyn::len_non_seq(tys: Nat → Type, strs: Strs(tys), d: Dyn(tys), ns: Shape::is_seq(tys, strs, d.code) = False): Dyn::len(tys, strs, d) = 0 {
    (match d.code as λ c => (v: El(tys, c)) → Shape::is_seq(tys, strs, c) = False → Dyn::len_at(tys, strs, c)(v) = 0 {
        SWord(_) => λ _ _ => refl,
        SNamed(k) => λ v n0 => (match strs(k).kind as λ kd => (match kd as λ _ => Bool { Sequence(_) => True, Opaque => False, Record(_) => False }) = False → Kind::len(tys, kd, v) = 0 {
            Sequence(_) => λ no => absurd(no),
            Opaque => λ _ => refl,
            Record(_) => λ _ => refl,
        })(n0),
    })(d.val, ns)
}

theorem Bool::not_true_false(b: Bool, h: (!b) = True): b = False { (match b as λ c => (!c) = True → c = False { True => λ no => absurd(no), False => λ _ => refl })(h) }

// What a write reads and writes, as codes: the written variable's code is
// the place's, and with its length (a sequence's fit, otherwise none) it is
// like what the place read.
record WriteVal(tys: Nat → Type, strs: Strs(tys), ws: List<Ix>, p: Place, old, vd: Dyn(tys)) {
    code: vd.code = (Sel::read_at(tys, strs, Steps::sels(p.steps, ws), old)).code,
    len: Dyn::len(tys, strs, vd) = Dyn::len(tys, strs, Sel::read_at(tys, strs, Steps::sels(p.steps, ws), old)),
}

theorem WriteInv::val(tys: Nat → Type, cx: Ctx(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, cx.strs, s, e, m), {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n),
    cok: (match Shape::steps_ok(tys, cx.strs, p.steps, s.code(p.root)) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True, tail: Type,
    frs: Residual::All(match Shape::is_seq(tys, cx.strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() }, tys, cx, e, tail)):
    WriteVal(tys, cx.strs, Env::ixs(tys, e), p, Env::get(tys, e, p.root), Env::get(tys, e, v))
{
    let strs = cx.strs;
    let ws = Env::ixs(tys, e);
    let old = Env::get(tys, e, p.root);
    let vd = Env::get(tys, e, v);
    let ss = Steps::sels(p.steps, ws);
    let rootc: (old.code = (s.var(wi.l)).code) = sim.codes(p.root, wi.l, wi.hl);
    let pvr: (p.val(tys, strs, e) = Sel::read_at(tys, strs, ss, old)) = Steps::read_sels(tys, strs, ws, p.steps, old);
    let pcode: ((p.val(tys, strs, e)).code = wi.c) = Dyn::read_code(tys, strs, ws, p.steps, old, (s.var(wi.l)).code, wi.c, rootc, wi.hc);
    let rc: ((Sel::read_at(tys, strs, ss, old)).code = wi.c) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, sym(pvr)), pcode);
    let cr: (s.code(p.root) = (s.var(wi.l)).code) = j(sym(wi.hl), λ o _ => (match o as λ _ => Shape { Some(l2) => (s.var(l2)).code, None => SWord(WNat) }) = (s.var(wi.l)).code, refl);
    let cv: (s.code(v) = (s.var(wi.lv)).code) = j(sym(wi.hlv), λ o _ => (match o as λ _ => Shape { Some(l2) => (s.var(l2)).code, None => SWord(WNat) }) = (s.var(wi.lv)).code, refl);
    let c1: ((match Shape::steps_ok(tys, strs, p.steps, (s.var(wi.l)).code) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True) =
        j(cr, λ q _ => (match Shape::steps_ok(tys, strs, p.steps, q) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True, cok);
    let c2: (s.code(v).same(wi.c) = True) = j(wi.hc, λ o _ => (match o as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True, c1);
    let vcode: (vd.code = wi.c) = trans(sim.codes(v, wi.lv, wi.hlv), trans(sym(cv), Shape::same_eq(s.code(v), wi.c, c2)));
    let wlen: (Dyn::len(tys, strs, vd) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, old))) =
        (match Shape::is_seq(tys, strs, wi.c) as λ b => Shape::is_seq(tys, strs, wi.c) = b →
                Residual::All(match b as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() }, tys, cx, e, tail) →
                Dyn::len(tys, strs, vd) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, old)) {
            True => λ _ h => trans(h.left.right, cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), pvr)),
            False => λ n0 _ => trans(Dyn::len_non_seq(tys, strs, vd, j(sym(vcode), λ q _ => Shape::is_seq(tys, strs, q) = False, n0)),
                sym(Dyn::len_non_seq(tys, strs, Sel::read_at(tys, strs, ss, old), j(sym(rc), λ q _ => Shape::is_seq(tys, strs, q) = False, n0)))),
        })(refl, frs);
    WriteVal(trans(vcode, sym(rc)), wlen)
}

// ---------------------------------------------------------------------------
// A block stored: what it reads, what every other block reads

theorem Heap::store_len(tys: Nat → Type, h: Heap(tys), b: Nat, d: Dyn(tys)): (Heap::store(tys, h, b, d)).len() = h.len() {
    h.len_update(b, λ bl => match bl { Live(o) => Live(Obj(d, o.holes)), Dead => Dead })
}

theorem Heap::obj_store_other(tys: Nat → Type, h: Heap(tys), sb, b: Nat, d: Dyn(tys), ne: ¬(b = sb)): Heap::obj(tys, Heap::store(tys, h, sb, d), b) = Heap::obj(tys, h, b) {
    cong_fn(λ (q: Option<Block(tys)>) => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() },
        h.nth_update_other(sb, λ bl => match bl { Live(o) => Live(Obj(d, o.holes)), Dead => Dead }, b, ne))
}

theorem Heap::obj_store_here(tys: Nat → Type, h: Heap(tys), b: Nat, d: Dyn(tys), ob: Obj(tys), ho: Heap::obj(tys, h, b) = Some(ob)): Heap::obj(tys, Heap::store(tys, h, b, d), b) = Some(Obj(d, ob.holes)) {
    let f: Block(tys) → Block(tys) = λ bl => match bl { Live(o) => Live(Obj(d, o.holes)), Dead => Dead };
    let ob2: Option<Block(tys)> → Option<Obj(tys)> = λ q => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() };
    (match h.nth(b) as λ q => h.nth(b) = q → ob2(q) = Some(ob) → ob2((h.update(b, f)).nth(b)) = Some(Obj(d, ob.holes)) {
        None => λ _ no => absurd(no),
        Some(bl) => λ e1 => (match bl as λ x => h.nth(b) = Some(x) → ob2(Some(x)) = Some(ob) → ob2((h.update(b, f)).nth(b)) = Some(Obj(d, ob.holes)) {
            Dead => λ _ no => absurd(no),
            Live(o) => λ e2 eo => {
                let oo: (o = ob) = Option::some_inj(o, ob, eo);
                trans(cong_fn(ob2, h.nth_update_here(b, f, Live(o), e2)), cong_fn(λ (q: Obj(tys)) => Some(Obj(d, q.holes)), oo))
            },
        })(e1),
    })(refl, ho)
}

theorem Heap::val_store_here(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), b: Nat, d: Dyn(tys), ob: Obj(tys), ho: Heap::obj(tys, h, b) = Some(ob), hn: ob.holes = Nil):
    Heap::val(tys, strs, Heap::store(tys, h, b, d), b) = Some(d)
{
    let h2 = Heap::store(tys, h, b, d);
    trans(cong_fn(λ (q: Option<Obj(tys)>) => match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }, Heap::obj_store_here(tys, h, b, d, ob, ho)),
        Obj::read_bare(tys, strs, h2, h2.len(), Obj(d, ob.holes), hn))
}

theorem Heap::val_store_other(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), sb, b: Nat, d: Dyn(tys), ne: ¬(b = sb), bare: (ob: Obj(tys)) → Heap::obj(tys, h, b) = Some(ob) → ob.holes = Nil):
    Heap::val(tys, strs, Heap::store(tys, h, sb, d), b) = Heap::val(tys, strs, h, b)
{
    let h2 = Heap::store(tys, h, sb, d);
    let lhs: (Heap::val(tys, strs, h2, b) = (match Heap::obj(tys, h, b) { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() })) =
        cong_fn(λ (q: Option<Obj(tys)>) => match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }, Heap::obj_store_other(tys, h, sb, b, d, ne));
    trans(lhs, (match Heap::obj(tys, h, b) as λ q => Heap::obj(tys, h, b) = q →
            (match q { Some(o) => Obj::read(tys, strs, h2, h2.len(), o), None => None<Dyn(tys)>() }) = (match q { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None<Dyn(tys)>() }) {
        None => λ _ => refl,
        Some(o) => λ e1 => trans(Obj::read_bare(tys, strs, h2, h2.len(), o, bare(o, e1)), sym(Obj::read_bare(tys, strs, h, h.len(), o, bare(o, e1)))),
    })(refl))
}

theorem Heap::obj_store_none(tys: Nat → Type, h: Heap(tys), b: Nat, d: Dyn(tys), hn: Heap::obj(tys, h, b) = None): Heap::obj(tys, Heap::store(tys, h, b, d), b) = None {
    let f: Block(tys) → Block(tys) = λ bl => match bl { Live(o) => Live(Obj(d, o.holes)), Dead => Dead };
    let ob2: Option<Block(tys)> → Option<Obj(tys)> = λ q => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() };
    (match h.nth(b) as λ q => h.nth(b) = q → ob2(q) = None<Obj(tys)>() → ob2((h.update(b, f)).nth(b)) = None<Obj(tys)>() {
        None => λ e1 _ => cong_fn(ob2, h.nth_update_none(b, f, e1)),
        Some(bl) => λ e1 => (match bl as λ x => h.nth(b) = Some(x) → ob2(Some(x)) = None<Obj(tys)>() → ob2((h.update(b, f)).nth(b)) = None<Obj(tys)>() {
            Dead => λ e2 _ => cong_fn(ob2, h.nth_update_here(b, f, Dead, e2)),
            Live(_) => λ _ no => absurd(no),
        })(e1),
    })(refl, hn)
}

// The holes of every block are as they were.
theorem Heap::obj_store_holes(tys: Nat → Type, h: Heap(tys), sb, b: Nat, d: Dyn(tys), ob: Obj(tys), ho: Heap::obj(tys, Heap::store(tys, h, sb, d), b) = Some(ob)):
    Exists<Obj(tys)>(λ o0 => (Heap::obj(tys, h, b) = Some(o0)) ∧ (ob.holes = o0.holes))
{
    match Nat::eq_or_ne(b, sb) {
        Inl(eq) => {
            let ho2: (Heap::obj(tys, Heap::store(tys, h, sb, d), sb) = Some(ob)) = j(eq, λ q _ => Heap::obj(tys, Heap::store(tys, h, sb, d), q) = Some(ob), ho);
            (match Heap::obj(tys, h, sb) as λ q => Heap::obj(tys, h, sb) = q → Exists<Obj(tys)>(λ o0 => (Heap::obj(tys, h, b) = Some(o0)) ∧ (ob.holes = o0.holes)) {
                Some(o0) => λ e1 => {
                    let e3: (Obj(d, o0.holes) = ob) = Option::some_inj(Obj(d, o0.holes), ob, trans(sym(Heap::obj_store_here(tys, h, sb, d, o0, e1)), ho2));
                    Exists(o0, ⟨j(sym(eq), λ q _ => Heap::obj(tys, h, q) = Some(o0), e1), cong_fn(λ (q: Obj(tys)) => q.holes, sym(e3))⟩)
                },
                None => λ e1 => absurd(trans(sym(ho2), Heap::obj_store_none(tys, h, sb, d, e1))),
            })(refl)
        },
        Inr(ne) => Exists(ob, ⟨trans(sym(Heap::obj_store_other(tys, h, sb, b, d, ne)), ho), refl⟩),
    }
}

// What a path apart from a write reads after it: what it read.
theorem Sel::get_apart(tys: Nat → Type, strs: Strs(tys), xs, ys: List<Sel>, ap: Sel::Apart(tys, strs, xs, ys), g: Dyn(tys) → Dyn(tys), d: Dyn(tys)):
    Sel::get(tys, strs, ys, Sel::write_at(tys, strs, xs, g, d)) = Sel::get(tys, strs, ys, d)
{
    let d2 = Sel::write_at(tys, strs, xs, g, d);
    trans(cong_fn(λ (b: Bool) => match b as λ _ => Option<Dyn(tys)> { True => Some(Sel::read_at(tys, strs, ys, d2)), False => None<Dyn(tys)>() }, ap.fit2(g, d)),
        cong_fn(λ (x: Dyn(tys)) => match Sel::fit(tys, strs, ys, d) as λ _ => Option<Dyn(tys)> { True => Some(x), False => None<Dyn(tys)>() }, ap.reads.right_after_left(g, d)))
}

// A write under a prefix that fits, and a path under the same prefix apart
// from it: the path reads what it read.
theorem Sel::get_under(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), r, ss, vs: List<Sel>, ap: Sel::Apart(tys, strs, vs, ss), g: Dyn(tys) → Dyn(tys), d: Dyn(tys),
    fr: Sel::fit(tys, strs, r, d) = True,
    hc: (g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r, d)))).code = (Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r, d))).code,
    hl: Dyn::len(tys, strs, g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r, d)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r, d)))):
    Sel::get(tys, strs, r ++ vs, Sel::write_at(tys, strs, r ++ ss, g, d)) = Sel::get(tys, strs, r ++ vs, d)
{
    let rd = Sel::read_at(tys, strs, r, d);
    let ff = λ (x: Dyn(tys)) => Sel::write_at(tys, strs, ss, g, x);
    let nw = Sel::write_at(tys, strs, r, ff, d);
    let wa: (Sel::write_at(tys, strs, r ++ ss, g, d) = nw) = Sel::write_append(tys, strs, r, ss, g, d);
    let wk = Sel::write_keeps(tys, strs, sl, g, ss, rd, hc, hl);
    let wg = Sel::write_get(tys, strs, sl, ff, r, d, fr, wk.left, wk.right);
    let fit1: (Sel::fit(tys, strs, r ++ vs, nw) = Sel::fit(tys, strs, r ++ vs, d)) =
        trans(Sel::fit_append(tys, strs, r, vs, nw),
            trans(cong_fn(λ (b: Bool) => b && Sel::fit(tys, strs, vs, Sel::read_at(tys, strs, r, nw)), trans(wg.left, sym(fr))),
                trans(cong_fn(λ (x: Dyn(tys)) => Sel::fit(tys, strs, r, d) && Sel::fit(tys, strs, vs, x), wg.right),
                    trans(cong_fn(λ (b: Bool) => Sel::fit(tys, strs, r, d) && b, ap.fit1(g, rd)), sym(Sel::fit_append(tys, strs, r, vs, d))))));
    let read1: (Sel::read_at(tys, strs, r ++ vs, nw) = Sel::read_at(tys, strs, r ++ vs, d)) =
        trans(Sel::read_append(tys, strs, r, vs, nw),
            trans(cong_fn(λ (x: Dyn(tys)) => Sel::read_at(tys, strs, vs, x), wg.right),
                trans(ap.reads.left_after_right(g, rd), sym(Sel::read_append(tys, strs, r, vs, d)))));
    trans(cong_fn(λ (x: Dyn(tys)) => Sel::get(tys, strs, r ++ vs, x), wa),
        trans(cong_fn(λ (b: Bool) => match b as λ _ => Option<Dyn(tys)> { True => Some(Sel::read_at(tys, strs, r ++ vs, nw)), False => None<Dyn(tys)>() }, fit1),
            cong_fn(λ (x: Dyn(tys)) => match Sel::fit(tys, strs, r ++ vs, d) as λ _ => Option<Dyn(tys)> { True => Some(x), False => None<Dyn(tys)>() }, read1)))
}

// ---------------------------------------------------------------------------
// Writes through a variable: what every write shares

// The invariant at a state with other `touched` and `wrote` lists: it reads
// neither, and every function of the state it reads converts between the
// two (the state's other fields are the same projections).
theorem Inv::touch(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    t, w: List<Nat>): Inv(tys, strs, CSt(s.args, s.locs, s.na, s.nd, s.views, s.nobj, t, w), e, m, h0, lent)
{
    inv
}

// No entry at a level: marking its entries not written back changes none.
theorem VEnt::unback_none(self es: List<VEnt>, l: Nat): ((en: VEnt) → Mem(en, es) → ¬(en.lvl = l)) →
    es.map(λ e => match e.lvl.same(l) { True => VEnt(e.lvl, e.obj, e.reg, e.mode, e.par, e.at, False), False => e }) = es
{
    match es {
        Nil => λ _ => refl,
        Cons(e0, rest) => λ h => {
            let nl: (e0.lvl.same(l) = False) = Nat::same_false(e0.lvl, l, h(e0, Inl(refl)));
            let hd: ((match e0.lvl.same(l) { True => VEnt(e0.lvl, e0.obj, e0.reg, e0.mode, e0.par, e0.at, False), False => e0 }) = e0) =
                j(sym(nl), λ c _ => (match c { True => VEnt(e0.lvl, e0.obj, e0.reg, e0.mode, e0.par, e0.at, False), False => e0 }) = e0, refl);
            trans(cong_fn(λ (q: VEnt) => Cons(q, rest.map(λ e => match e.lvl.same(l) { True => VEnt(e.lvl, e.obj, e.reg, e.mode, e.par, e.at, False), False => e })), hd),
                cong_fn(λ (t: List<VEnt>) => Cons(e0, t), VEnt::unback_none(rest, l, λ en m => h(en, Inr(m)))))
        },
    }
}

// The state after a write through a variable no entry is at: the same but
// for `touched` and `wrote`.
theorem CSt::wrote_none(self s: CSt, l: Nat, nolvl: (en: VEnt) → Mem(en, s.views) → ¬(en.lvl = l)):
    s.written(l).unback(l) = CSt(s.args, s.locs, s.na, s.nd, s.views, s.nobj, Cons(l, s.touched), Cons(l, s.wrote))
{
    cong_fn(λ (vs: List<VEnt>) => CSt(s.args, s.locs, s.na, s.nd, vs, s.nobj, Cons(l, s.touched), Cons(l, s.wrote)), VEnt::unback_none(s.views, l, nolvl))
}

theorem VEnt::any_mem(self es: List<VEnt>, P: VEnt → Type): VEnt::Any(es, P) → Exists<VEnt>(λ en => Mem(en, es) ∧ P(en)) {
    match es {
        Nil => λ no => false_elim(no),
        Cons(e0, rest) => λ h => match h {
            Inl(p) => Exists(e0, ⟨Inl(refl), p⟩),
            Inr(q) => match VEnt::any_mem(rest, P, q) { ⟨en, pe⟩ => Exists(en, ⟨Inr(pe.left), pe.right⟩) },
        },
    }
}

// What a referring value reads at no selections: its block's value, the
// selections fitting there.
theorem Value::refer_inv(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Ref, d: Dyn(tys), g: Value::Reads(tys, strs, h, Refer(r), d)):
    Exists<Dyn(tys)>(λ ob => (Heap::val(tys, strs, h, r.b) = Some(ob)) ∧ ((Sel::fit(tys, strs, r.sels, ob) = True) ∧ (Sel::read_at(tys, strs, r.sels, ob) = d)))
{
    (match Heap::val(tys, strs, h, r.b) as λ q => Heap::val(tys, strs, h, r.b) = q → (match q { Some(dv) => Sel::get(tys, strs, r.sels ++ Nil, dv), None => None<Dyn(tys)>() }) = Some(d) →
            Exists<Dyn(tys)>(λ ob => (Heap::val(tys, strs, h, r.b) = Some(ob)) ∧ ((Sel::fit(tys, strs, r.sels, ob) = True) ∧ (Sel::read_at(tys, strs, r.sels, ob) = d))) {
        Some(dv) => λ hv g2 => {
            let nil: (r.sels ++ Nil = r.sels) = List::append_nil(r.sels);
            let pre = Sel::get_parts(tys, strs, r.sels, dv, d, j(nil, λ t _ => Sel::get(tys, strs, t, dv) = Some(d), g2));
            Exists(dv, ⟨hv, pre⟩)
        },
        None => λ _ no => absurd(no),
    })(refl, g)
}

// A reference read after a block is stored: as before, where the stored
// block is not its own or its selections read there what they read.
theorem Value::get_store(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), sb: Nat, old, nw: Dyn(tys), hv: Heap::val(tys, strs, h, sb) = Some(old),
    hn: (ob: Obj(tys)) → Heap::obj(tys, h, sb) = Some(ob) → ob.holes = Nil, q: Ref, bq: (ob: Obj(tys)) → Heap::obj(tys, h, q.b) = Some(ob) → ob.holes = Nil,
    same: q.b = sb → Sel::get(tys, strs, q.sels, nw) = Sel::get(tys, strs, q.sels, old)):
    Value::get(tys, strs, Heap::store(tys, h, sb, nw), Refer(q), Nil) = Value::get(tys, strs, h, Refer(q), Nil)
{
    let h2 = Heap::store(tys, h, sb, nw);
    let rd = λ (o: Option<Dyn(tys)>) => match o { Some(d) => Sel::get(tys, strs, q.sels ++ Nil, d), None => None<Dyn(tys)>() };
    match Nat::eq_or_ne(q.b, sb) {
        Inl(eq) => match Heap::obj_of_val(tys, strs, h, sb, old, hv) {
            ⟨ob, pob⟩ => {
                let v2: (Heap::val(tys, strs, h2, sb) = Some(nw)) = Heap::val_store_here(tys, strs, h, sb, nw, ob, pob, hn(ob, pob));
                let nil: (q.sels ++ Nil = q.sels) = List::append_nil(q.sels);
                let mid: (Sel::get(tys, strs, q.sels ++ Nil, nw) = Sel::get(tys, strs, q.sels ++ Nil, old)) =
                    trans(cong_fn(λ (t: List<Sel>) => Sel::get(tys, strs, t, nw), nil), trans(same(eq), cong_fn(λ (t: List<Sel>) => Sel::get(tys, strs, t, old), sym(nil))));
                let at: (rd(Heap::val(tys, strs, h2, sb)) = rd(Heap::val(tys, strs, h, sb))) = trans(cong_fn(rd, v2), trans(mid, sym(cong_fn(rd, hv))));
                j(sym(eq), λ b _ => rd(Heap::val(tys, strs, h2, b)) = rd(Heap::val(tys, strs, h, b)), at)
            },
        },
        Inr(ne) => cong_fn(rd, Heap::val_store_other(tys, strs, h, sb, q.b, nw, ne, bq)),
    }
}

// A cell that agrees on a heap agrees on another where its reference reads
// the same.
theorem Cell::agrees_store(tys: Nat → Type, strs: Strs(tys), h, h2: Heap(tys), rl: Role, c: Cell(tys), d: Dyn(tys), ag: Cell::Agrees(tys, strs, h, rl, c, d),
    keep: (q: Ref) → c.v = Refer(q) → ¬(rl.same(KGone) = True) → Value::get(tys, strs, h2, Refer(q), Nil) = Value::get(tys, strs, h, Refer(q), Nil)):
    Cell::Agrees(tys, strs, h2, rl, c, d)
{
    let reads = λ (kp: (q: Ref) → c.v = Refer(q) → Value::get(tys, strs, h2, Refer(q), Nil) = Value::get(tys, strs, h, Refer(q), Nil)) =>
        (match c.v as λ u => ((q: Ref) → u = Refer(q) → Value::get(tys, strs, h2, Refer(q), Nil) = Value::get(tys, strs, h, Refer(q), Nil)) →
                Value::Reads(tys, strs, h, u, d) → Value::Reads(tys, strs, h2, u, d) {
            Plain(_) => λ _ g => g,
            Refer(q) => λ kp2 g => trans(kp2(q, refl), g),
        })(kp);
    (match rl as λ rr => Cell::Agrees(tys, strs, h, rr, c, d) → ((q: Ref) → c.v = Refer(q) → ¬(rr.same(KGone) = True) → Value::get(tys, strs, h2, Refer(q), Nil) = Value::get(tys, strs, h, Refer(q), Nil)) →
            Cell::Agrees(tys, strs, h2, rr, c, d) {
        KPlain => λ g _ => g,
        KGone => λ g _ => g,
        KHold(_, _) => λ g kp => reads(λ q eq => kp(q, eq, λ no => absurd(no)), g),
        KView => λ g kp => reads(λ q eq => kp(q, eq, λ no => absurd(no)), g),
    })(ag, keep)
}

// The words regions read, after a write to a variable no region reads that
// changes no other variable's meaning.
theorem Inv::words_after(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    sim: Sim(tys, strs, s, e, m), {e2: Env(tys)}, {m2: Mach(tys)}, sim2: Sim(tys, strs, s, e2, m2),
    ecw: (k: Nat) → s.in_regions(k) = True → Env::get(tys, e2, s.var_at(k)) = Env::get(tys, e, s.var_at(k))):
    (l2: Nat) → s.in_regions(l2) = True → (Mach::ixs(tys, strs, m2)).nth(s.ix_of(l2)) = (Mach::ixs(tys, strs, m)).nth(s.ix_of(l2))
{
    λ l2 ir => {
        let wd = inv.words(l2, ir);
        trans(Sim::lvl_ix(tys, strs, sim2, l2, wd.left, wd.right),
            trans(s.env_ix(tys, e2, sim2.eargs, sim2.elocs, l2, wd.left),
                trans(cong_fn(λ (d: Dyn(tys)) => Some(Dyn::ix(tys, d)), ecw(l2, ir)),
                    trans(sym(s.env_ix(tys, e, sim.eargs, sim.elocs, l2, wd.left)), sym(Sim::lvl_ix(tys, strs, sim, l2, wd.left, wd.right))))))
    }
}

// A meaning set at one variable no region reads agrees with the old at
// every level a region reads.
theorem CSt::regions_other(self s: CSt, tys: Nat → Type, e, e2: Env(tys), x: Var, l: Nat, hl: s.lvl(x) = Some(l), nrf: s.in_regions(l) = False,
    words: (k: Nat) → s.in_regions(k) = True → k < s.na + s.nd,
    ecell: (y: Var) → ¬(x = y) → Env::get(tys, e2, y) = Env::get(tys, e, y)):
    (k: Nat) → s.in_regions(k) = True → Env::get(tys, e2, s.var_at(k)) = Env::get(tys, e, s.var_at(k))
{
    λ k ir => {
        let ne: ¬(k = l) = λ eq => absurd(trans(sym(j(eq, λ q _ => s.in_regions(q) = True, ir)), nrf));
        ecell(s.var_at(k), λ eq => s.var_ne(s.var_at(k), x, k, l, s.lvl_var_at(k, words(k, ir)), hl, ne)(sym(eq)))
    }
}

// One variable's cell set to a value that refers nowhere, agreeing with its
// new meaning; no region reads it, and the heap is as it was.
theorem Inv::set_cell(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    x: Var, l: Nat, hl: s.lvl(x) = Some(l), nrf: s.in_regions(l) = False, f: Dyn(tys) → Dyn(tys), c: Cell(tys),
    pn: s.patched(tys, strs, e, m) = e, pn2: s.patched(tys, strs, Env::set(tys, e, x, f), Mach(m.heap, REnv::set(tys, m.env, x, c), m.io)) = Env::set(tys, e, x, f),
    agr: Cell::Agrees(tys, strs, m.heap, s.role(l), c, f(Env::get(tys, e, x))), code: (f(Env::get(tys, e, x))).code = (s.var(l)).code, nref: (r: Ref) → c.v = Refer(r) → False,
    cref: Value::refers(tys, (REnv::get(tys, m.env, x)).v) = False,
    cpar: (en: VEnt) → Mem(en, s.views) → en.par = l → (z: Var) → s.lvl(z) = Some(en.lvl) → (dp, dc: Dyn(tys)) → c.v = level2::Plain(dp) → (REnv::get(tys, m.env, z)).v = level2::Plain(dc) →
        CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m)), dp, dc),
    cself: (en: VEnt) → Mem(en, s.views) → en.lvl = l → (y: Var) → s.lvl(y) = Some(en.par) → (dp, dc: Dyn(tys)) → (REnv::get(tys, m.env, y)).v = level2::Plain(dp) → c.v = level2::Plain(dc) →
        CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m)), dp, dc)):
    Inv(tys, strs, s, Env::set(tys, e, x, f), Mach(m.heap, REnv::set(tys, m.env, x, c), m.io), h0, lent)
{
    let sim: Sim(tys, strs, s, e, m) = j(pn, λ z _ => Sim(tys, strs, s, z, m), inv.sim);
    let m2: Mach(tys) = Mach(m.heap, REnv::set(tys, m.env, x, c), m.io);
    let e2 = Env::set(tys, e, x, f);
    let rin = s.var_inside(x, l, hl);
    let ein: Var::In(x, e.args.len(), e.locs.len()) = j(sym(sim.elocs), λ q _ => Var::In(x, e.args.len(), q), j(sym(sim.eargs), λ q _ => Var::In(x, q, s.nd), rin));
    let min: Var::In(x, (m.env).args.len(), (m.env).locs.len()) =
        j(sym(sim.mlocs), λ q _ => Var::In(x, (m.env).args.len(), q), j(sym(sim.margs), λ q _ => Var::In(x, q, s.nd), rin));
    let e2root: (Env::get(tys, e2, x) = f(Env::get(tys, e, x))) = Env::get_set_same(tys, e, x, f, ein);
    let m2root: (REnv::get(tys, m2.env, x) = c) = REnv::get_set_same(tys, m.env, x, c, min);
    let other: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → ¬(l2 = l) → ¬(x = y)) = λ y l2 hy ne eq => s.var_ne(y, x, l2, l, hy, hl, ne)(sym(eq));
    let isroot: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → l2 = l → y = x) = λ y l2 hy eq =>
        trans(sym(s.lvl_var(y, l2, hy)), trans(cong_fn(λ (q: Nat) => s.var_at(q), eq), s.lvl_var(x, l, hl)));
    let notref: ((y: Var) → (r: Ref) → (REnv::get(tys, m2.env, y)).v = Refer(r) → ¬(x = y)) = λ y r hr eq =>
        nref(r, trans(sym(cong_fn(λ (cc: Cell(tys)) => cc.v, m2root)), j(sym(eq), λ z _ => (REnv::get(tys, m2.env, z)).v = Refer(r), hr)));
    let mcell: ((y: Var) → ¬(x = y) → REnv::get(tys, m2.env, y) = REnv::get(tys, m.env, y)) = λ y yn => REnv::get_set_other(tys, m.env, x, y, c, yn);
    let ecell: ((y: Var) → ¬(x = y) → Env::get(tys, e2, y) = Env::get(tys, e, y)) = λ y yn => Env::get_set_other(tys, e, x, y, f, yn);
    let vars2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → Cell::Agrees(tys, strs, m2.heap, s.role(l2), REnv::get(tys, m2.env, y), Env::get(tys, e2, y))) = λ y l2 hy =>
        match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(isroot(y, l2, hy, eq)), λ z _ => Cell::Agrees(tys, strs, m.heap, s.role(l2), REnv::get(tys, m2.env, z), Env::get(tys, e2, z)),
                j(sym(eq), λ q _ => Cell::Agrees(tys, strs, m.heap, s.role(q), REnv::get(tys, m2.env, x), Env::get(tys, e2, x)),
                    j(sym(m2root), λ cc _ => Cell::Agrees(tys, strs, m.heap, s.role(l), cc, Env::get(tys, e2, x)),
                        j(sym(e2root), λ dd _ => Cell::Agrees(tys, strs, m.heap, s.role(l), c, dd), agr)))),
            Inr(ne) => {
                let yn = other(y, l2, hy, ne);
                j(sym(mcell(y, yn)), λ cc _ => Cell::Agrees(tys, strs, m.heap, s.role(l2), cc, Env::get(tys, e2, y)),
                    j(sym(ecell(y, yn)), λ dd _ => Cell::Agrees(tys, strs, m.heap, s.role(l2), REnv::get(tys, m.env, y), dd), sim.vars(y, l2, hy)))
            },
        };
    let codes2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → (Env::get(tys, e2, y)).code = (s.var(l2)).code) = λ y l2 hy =>
        match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(isroot(y, l2, hy, eq)), λ z _ => (Env::get(tys, e2, z)).code = (s.var(l2)).code,
                trans(cong_fn(λ (d: Dyn(tys)) => d.code, e2root), trans(code, cong_fn(λ (q: Nat) => (s.var(q)).code, sym(eq))))),
            Inr(ne) => trans(cong_fn(λ (d: Dyn(tys)) => d.code, ecell(y, other(y, l2, hy, ne))), sim.codes(y, l2, hy)),
        };
    let sim2: Sim(tys, strs, s, e2, m2) = Sim(trans(Env::set_args(tys, e, x, f), sim.eargs), trans(REnv::set_args(tys, m.env, x, c), sim.margs),
        trans(Env::set_locs(tys, e, x, f), sim.elocs), trans(REnv::set_locs(tys, m.env, x, c), sim.mlocs), vars2, codes2);
    let wsame = Inv::words_after(tys, strs, inv, sim, sim2, s.regions_other(tys, e, e2, x, l, hl, nrf, λ k ir => (inv.words(k, ir)).left, ecell));
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s.unsteps(en.reg), Mach::ixs(tys, strs, m2)) = Steps::sels(s.unsteps(en.reg), Mach::ixs(tys, strs, m))) =
        λ en me => CSt::sels_keep(en.reg, s, Mach::ixs(tys, strs, m2), s, Mach::ixs(tys, strs, m), λ l2 ml => wsame(l2, s.region_lvl(en, me, l2, ml)));
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m2)) = Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m))) =
        λ en me => CSt::sels_keep(en.at, s, Mach::ixs(tys, strs, m2), s, Mach::ixs(tys, strs, m), λ l2 ml => wsame(l2, s.at_lvl(en, me, l2, ml)));
    let cf2: CSt::CFit(tys, strs, s, m2.env, Mach::ixs(tys, strs, m2)) = λ en me y z hy hz dp dc cy cz => {
        let old_v = λ (w0: Var) (k0: Nat) (hw: s.lvl(w0) = Some(k0)) (ne: ¬(k0 = l)) (dd: Dyn(tys)) (cw: (REnv::get(tys, m2.env, w0)).v = level2::Plain(dd)) =>
            trans(cong_fn(λ (cc: Cell(tys)) => cc.v, sym(mcell(w0, other(w0, k0, hw, ne)))), cw);
        let new_v = λ (w0: Var) (k0: Nat) (hw: s.lvl(w0) = Some(k0)) (eq: k0 = l) (dd: Dyn(tys)) (cw: (REnv::get(tys, m2.env, w0)).v = level2::Plain(dd)) =>
            trans(cong_fn(λ (cc: Cell(tys)) => cc.v, sym(m2root)), j(isroot(w0, k0, hw, eq), λ u _ => (REnv::get(tys, m2.env, u)).v = level2::Plain(dd), cw));
        let lt0: (en.par < en.lvl) = (inv.chain(en, me)).left;
        j(sym(ats(en, me)), λ q _ => CSt::CFitAt(tys, strs, q, dp, dc), match Nat::eq_or_ne(en.par, l) {
            Inl(eq) => cpar(en, me, eq, z, hz, dp, dc, new_v(y, en.par, hy, eq, dp, cy), old_v(z, en.lvl, hz, λ e3 => Nat::lt_irrefl(l, j(eq, λ q _ => q < l, j(e3, λ q _ => en.par < q, lt0))), dc, cz)),
            Inr(np) => match Nat::eq_or_ne(en.lvl, l) {
                Inl(eq) => cself(en, me, eq, y, hy, dp, dc, old_v(y, en.par, hy, np, dp, cy), new_v(z, en.lvl, hz, eq, dc, cz)),
                Inr(nv) => inv.cfit(en, me, y, z, hy, hz, dp, dc, old_v(y, en.par, hy, np, dp, cy), old_v(z, en.lvl, hz, nv, dc, cz)),
            },
        })
    };
    let refs2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → (r: Ref) → (REnv::get(tys, m2.env, y)).v = Refer(r) → s.RefOk(inv.root, Mach::ixs(tys, strs, m2), l2, r)) =
        λ y l2 hy r hr => {
            let hr1: ((REnv::get(tys, m.env, y)).v = Refer(r)) = trans(cong_fn(λ (cc: Cell(tys)) => cc.v, sym(mcell(y, notref(y, r, hr)))), hr);
            CSt::refok_keep(s, s, inv.root, inv.root, Mach::ixs(tys, strs, m), Mach::ixs(tys, strs, m2), l2, r, refl, refl, λ _ _ _ => refl, λ _ _ => refl,
                λ en me => regs(en, s.views.mem_filter(en, λ e0 => e0.lvl.same(l2), me)), inv.refs(y, l2, hy, r, hr1))
        };
    let own2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → ¬((s.role(l2)).same(KGone) = True) → (REnv::get(tys, m2.env, y)).own = True → (r: Ref) → (REnv::get(tys, m2.env, y)).v = Refer(r) →
            Exists<Nat>(λ o => (s.role(l2) = KHold(o, AcOwn)) ∧ ((inv.root(o) = Some(r)) ∧ ((r.sels = Nil) ∧ ((o2: Nat) → ¬(o2 = o) → (r2: Ref) → inv.root(o2) = Some(r2) → ¬(r2.b = r.b)))))) =
        λ y l2 hy ng co r hr => {
            let mc = mcell(y, notref(y, r, hr));
            inv.own(y, l2, hy, ng, trans(cong_fn(λ (cc: Cell(tys)) => cc.own, sym(mc)), co), r, trans(cong_fn(λ (cc: Cell(tys)) => cc.v, sym(mc)), hr))
        };
    let le0: (s.na + s.nd <= s.na + s.nd) = omega();
    Inv(j(sym(pn2), λ q _ => Sim(tys, strs, s, q, m2), sim2), inv.root,
        refs2, inv.apart, inv.inheap, inv.owned, own2, inv.one, inv.words, inv.frame, inv.grows, inv.young, inv.held, inv.vents, inv.bare, inv.chain,
        CSt::excl_keep(tys, strs, s, s, Mach::ixs(tys, strs, m), Mach::ixs(tys, strs, m2), refl, le0, λ en me => (inv.chain(en, me)).left, λ en me => (inv.vents(en, me)).right.left, regs, inv.excl), inv.wpar,
        λ en me y z hy hz => {
            let rk = λ (w: Var) (k: Nat) (hw: s.lvl(w) = Some(k)) => match Nat::eq_or_ne(k, l) {
                Inl(eq) => {
                    let wx: (w = x) = isroot(w, k, hw, eq);
                    let cf: (Value::refers(tys, c.v) = False) = match c.v as λ u => ((r: Ref) → u = Refer(r) → False) → Value::refers(tys, u) = False {
                        Plain(_) => λ _ => refl, Refer(r) => λ no => false_elim(no(r, refl)) }(nref);
                    j(sym(wx), λ q _ => Value::refers(tys, (REnv::get(tys, m2.env, q)).v) = Value::refers(tys, (REnv::get(tys, m.env, q)).v),
                        trans(cong_fn(λ (cc: Cell(tys)) => Value::refers(tys, cc.v), m2root), trans(cf, sym(cref))))
                },
                Inr(ne) => cong_fn(λ (cc: Cell(tys)) => Value::refers(tys, cc.v), mcell(w, other(w, k, hw, ne))),
            };
            trans(rk(y, en.lvl, hy), trans(inv.uni(en, me, y, z, hy, hz), sym(rk(z, en.par, hz))))
        },
        inv.pone, cf2, CSt::sib_keep(tys, strs, s, s, Mach::ixs(tys, strs, m), Mach::ixs(tys, strs, m2), refl, ats, inv.sib))
}

// A holder's block stored: the holder reads its new meaning; every other
// live reference reads what it read, a reference of another object being
// apart from the holder's root (`away`), a view of the holder's object apart
// from the written path under the root (`under`, by the licence `lic`).
// A root's block stored, with a meaning every variable agrees with and that
// keeps the words regions read: the invariant's other clauses.
theorem Inv::store_rest(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, o: Nat, r: Ref, rt: inv.root(o) = Some(r), ch: s.Changes(o), nw: Dyn(tys), ex: Env(tys),
    sim2: Sim(tys, strs, s, ex, Mach(Heap::store(tys, m.heap, r.b, nw), m.env, m.io)),
    ecw: (k: Nat) → s.in_regions(k) = True → Env::get(tys, ex, s.var_at(k)) = Env::get(tys, e, s.var_at(k))):
    Inv(tys, strs, s, ex, Mach(Heap::store(tys, m.heap, r.b, nw), m.env, m.io), h0, lent)
{
    let h2 = Heap::store(tys, m.heap, r.b, nw);
    let m2: Mach(tys) = Mach(h2, m.env, m.io);
    let ws = Mach::ixs(tys, strs, m);
    let wsame = Inv::words_after(tys, strs, inv, Inv::sim_now(tys, strs, inv, none), sim2, ecw);
    let ws2 = Mach::ixs(tys, strs, m2);
    let regs: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s.unsteps(en.reg), ws2) = Steps::sels(s.unsteps(en.reg), ws)) =
        λ en me => CSt::sels_keep(en.reg, s, ws2, s, ws, λ l2 ml => wsame(l2, s.region_lvl(en, me, l2, ml)));
    let ats: ((en: VEnt) → Mem(en, s.views) → Steps::sels(s.unsteps(en.at), ws2) = Steps::sels(s.unsteps(en.at), ws)) =
        λ en me => CSt::sels_keep(en.at, s, ws2, s, ws, λ l2 ml => wsame(l2, s.at_lvl(en, me, l2, ml)));
    let lenh: (h2.len() = m.heap.len()) = Heap::store_len(tys, m.heap, r.b, nw);
    let le0: (s.na + s.nd <= s.na + s.nd) = omega();
    Inv(j(sym(s.patched_none(tys, strs, ex, m2, none)), λ q _ => Sim(tys, strs, s, q, m2), sim2), inv.root,
        λ y l2 hy q cq => CSt::refok_keep(s, s, inv.root, inv.root, ws, ws2, l2, q, refl, refl, λ _ _ _ => refl, λ _ _ => refl,
            λ en me => regs(en, s.views.mem_filter(en, λ e0 => e0.lvl.same(l2), me)), inv.refs(y, l2, hy, q, cq)),
        inv.apart,
        λ o3 r3 h3 => j(sym(lenh), λ n _ => r3.b < n, inv.inheap(o3, r3, h3)),
        inv.owned, inv.own, inv.one, inv.words,
        λ bb bl nl => match Nat::eq_or_ne(bb, r.b) {
            Inl(eq) => match inv.owned(o, ch, r, rt) {
                Inl(lt) => absurd(trans(sym(nl), j(sym(eq), λ q _ => lent(q) = True, lt))),
                Inr(ge) => false_elim(Nat::lt_irrefl(bb, omega(bl, ge, eq))),
            },
            Inr(ne) => trans(m.heap.nth_update_other(r.b, λ bl0 => match bl0 { Live(ob) => Live(Obj(nw, ob.holes)), Dead => Dead }, bb, ne), inv.frame(bb, bl, nl)),
        },
        j(sym(lenh), λ n _ => h0.len() <= n, inv.grows),
        inv.young, inv.held, inv.vents,
        λ o3 r3 h3 ob ho => match Heap::obj_store_holes(tys, m.heap, r.b, r3.b, nw, ob, ho) { ⟨o0, po⟩ => trans(po.right, inv.bare(o3, r3, h3, o0, po.left)) },
        inv.chain,
        CSt::excl_keep(tys, strs, s, s, ws, ws2, refl, le0, λ en me => (inv.chain(en, me)).left, λ en me => (inv.vents(en, me)).right.left, regs, inv.excl), inv.wpar, inv.uni, inv.pone,
        CSt::cfit_ws(tys, strs, s, m.env, ws, ws2, ats, inv.cfit), CSt::sib_keep(tys, strs, s, s, ws, ws2, refl, ats, inv.sib))
}

theorem Inv::store(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, x: Var, l: Nat, hl: s.lvl(x) = Some(l), nrf: s.in_regions(l) = False, o: Nat, a: Acc, hr: s.role(l) = KHold(o, a), aw: a.writes() = True,
    r: Ref, cr: (REnv::get(tys, m.env, x)).v = Refer(r), old: Dyn(tys), hv: Heap::val(tys, strs, m.heap, r.b) = Some(old), ss: List<Sel>, nw: Dyn(tys), f: Dyn(tys) → Dyn(tys),
    agr: Sel::get(tys, strs, r.sels, nw) = Some(f(Env::get(tys, e, x))), code: (f(Env::get(tys, e, x))).code = (s.var(l)).code,
    away: (q: List<Sel>) → Sel::Apart(tys, strs, r.sels, q) → Sel::get(tys, strs, q, nw) = Sel::get(tys, strs, q, old),
    under: (vs: List<Sel>) → Sel::Apart(tys, strs, vs, ss) → Sel::get(tys, strs, r.sels ++ vs, nw) = Sel::get(tys, strs, r.sels ++ vs, old),
    lic: (en: VEnt) → Mem(en, s.views) → en.obj = o → Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.reg), Mach::ixs(tys, strs, m)), ss)):
    Inv(tys, strs, s, Env::set(tys, e, x, f), Mach(Heap::store(tys, m.heap, r.b, nw), m.env, m.io), h0, lent)
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let h2 = Heap::store(tys, m.heap, r.b, nw);
    let m2: Mach(tys) = Mach(h2, m.env, m.io);
    let e2 = Env::set(tys, e, x, f);
    let ws = Mach::ixs(tys, strs, m);
    let b = s.lvl_below(x, l, hl);
    let rt: (inv.root(o) = Some(r)) = j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r),
        KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)), KPlain => False, KGone => True }, inv.refs(x, l, hl, r, cr));
    let ch: s.Changes(o) = Inl(Exists(l, ⟨b, Exists(a, ⟨hr, aw⟩)⟩));
    let hn: ((ob: Obj(tys)) → Heap::obj(tys, m.heap, r.b) = Some(ob) → ob.holes = Nil) = inv.bare(o, r, rt);
    let same: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → ¬(l2 = l) → (q: Ref) → (REnv::get(tys, m.env, y)).v = Refer(q) → ¬((s.role(l2)).same(KGone) = True) → q.b = r.b →
            Sel::get(tys, strs, q.sels, nw) = Sel::get(tys, strs, q.sels, old)) = λ y l2 hy ne q cq live eb =>
        (match s.role(l2) as λ rr => s.role(l2) = rr → (match rr { KHold(o2, _) => inv.root(o2) = Some(q),
                KView => VEnt::Any(s.ents(l2), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(q)), KPlain => False, KGone => True }) →
                ¬(rr.same(KGone) = True) → Sel::get(tys, strs, q.sels, nw) = Sel::get(tys, strs, q.sels, old) {
            KHold(o2, a2) => λ er ok _ => {
                let no: ¬(o2 = o) = λ eo => inv.one(l2, l, o, a2, a, s.lvl_below(y, l2, hy), b, ne, j(eo, λ z _ => s.role(l2) = KHold(z, a2), er), hr);
                away(q.sels, inv.apart(o, o2, λ eo => no(sym(eo)), ch, r, q, rt, ok)(sym(eb)))
            },
            KView => λ _ ok _ => match VEnt::any_mem(s.ents(l2), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(q), ok) {
                ⟨en, pen⟩ => {
                    let me: Mem(en, s.views) = s.views.mem_filter(en, λ e0 => e0.lvl.same(l2), pen.left);
                    match Option::map_some_inv(inv.root(en.obj), λ r0 => r0.narrow(ws, s.unsteps(en.reg)), q, pen.right) {
                        ⟨r0, pr⟩ => {
                            let regsels = Steps::sels(s.unsteps(en.reg), ws);
                            let qs: (q.sels = r0.sels ++ regsels) = cong_fn(λ (z: Ref) => z.sels, sym(pr.right));
                            let qb: (q.b = r0.b) = cong_fn(λ (z: Ref) => z.b, sym(pr.right));
                            let at: (Sel::get(tys, strs, r0.sels ++ regsels, nw) = Sel::get(tys, strs, r0.sels ++ regsels, old)) = match Nat::eq_or_ne(en.obj, o) {
                                Inl(eo) => {
                                    let r0r: (r0 = r) = Option::some_inj(r0, r, trans(sym(pr.left), trans(cong_fn(λ (z: Nat) => inv.root(z), eo), rt)));
                                    j(sym(r0r), λ z _ => Sel::get(tys, strs, z.sels ++ regsels, nw) = Sel::get(tys, strs, z.sels ++ regsels, old), under(regsels, lic(en, me, eo)))
                                },
                                Inr(no) => away(r0.sels ++ regsels,
                                    Sel::apart_ext_r(tys, strs, r.sels, r0.sels, regsels, inv.apart(o, en.obj, λ eo => no(sym(eo)), ch, r, r0, rt, pr.left)(trans(sym(eb), qb)))),
                            };
                            j(sym(qs), λ t _ => Sel::get(tys, strs, t, nw) = Sel::get(tys, strs, t, old), at)
                        },
                    }
                },
            },
            KPlain => λ _ no _ => false_elim(no),
            KGone => λ _ _ no => false_elim(no(refl)),
        })(refl, inv.refs(y, l2, hy, q, cq), live);
    let keep: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → ¬(l2 = l) → (q: Ref) → (REnv::get(tys, m.env, y)).v = Refer(q) → ¬((s.role(l2)).same(KGone) = True) →
            Value::get(tys, strs, h2, Refer(q), Nil) = Value::get(tys, strs, m.heap, Refer(q), Nil)) = λ y l2 hy ne q cq live =>
        match s.refok_block(inv.root, ws, l2, q, inv.refs(y, l2, hy, q, cq), live) {
            ⟨o3, ⟨r3, pr⟩⟩ => Value::get_store(tys, strs, m.heap, r.b, old, nw, hv, hn, q,
                j(pr.right, λ bb _ => (ob: Obj(tys)) → Heap::obj(tys, m.heap, bb) = Some(ob) → ob.holes = Nil, inv.bare(o3, r3, pr.left)), same(y, l2, hy, ne, q, cq, live)),
        };
    let rin = s.var_inside(x, l, hl);
    let ein: Var::In(x, e.args.len(), e.locs.len()) = j(sym(sim.elocs), λ q _ => Var::In(x, e.args.len(), q), j(sym(sim.eargs), λ q _ => Var::In(x, q, s.nd), rin));
    let e2root: (Env::get(tys, e2, x) = f(Env::get(tys, e, x))) = Env::get_set_same(tys, e, x, f, ein);
    let other: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → ¬(l2 = l) → ¬(x = y)) = λ y l2 hy ne eq => s.var_ne(y, x, l2, l, hy, hl, ne)(sym(eq));
    let isroot: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → l2 = l → y = x) = λ y l2 hy eq =>
        trans(sym(s.lvl_var(y, l2, hy)), trans(cong_fn(λ (q: Nat) => s.var_at(q), eq), s.lvl_var(x, l, hl)));
    let ecell: ((y: Var) → ¬(x = y) → Env::get(tys, e2, y) = Env::get(tys, e, y)) = λ y yn => Env::get_set_other(tys, e, x, y, f, yn);
    let rdr = λ (q: Option<Dyn(tys)>) => match q { Some(d) => Sel::get(tys, strs, r.sels ++ Nil, d), None => None<Dyn(tys)>() };
    let rootreads: (Value::get(tys, strs, h2, Refer(r), Nil) = Some(f(Env::get(tys, e, x)))) = match Heap::obj_of_val(tys, strs, m.heap, r.b, old, hv) {
        ⟨ob, pob⟩ => trans(cong_fn(rdr, Heap::val_store_here(tys, strs, m.heap, r.b, nw, ob, pob, hn(ob, pob))),
            trans(cong_fn(λ (t: List<Sel>) => Sel::get(tys, strs, t, nw), List::append_nil(r.sels)), agr)),
    };
    let rootag: Cell::Agrees(tys, strs, h2, s.role(l), REnv::get(tys, m.env, x), f(Env::get(tys, e, x))) =
        j(sym(hr), λ rr _ => Cell::Agrees(tys, strs, h2, rr, REnv::get(tys, m.env, x), f(Env::get(tys, e, x))),
            j(sym(cr), λ u _ => Value::get(tys, strs, h2, u, Nil) = Some(f(Env::get(tys, e, x))), rootreads));
    let vars2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → Cell::Agrees(tys, strs, h2, s.role(l2), REnv::get(tys, m.env, y), Env::get(tys, e2, y))) = λ y l2 hy =>
        match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(isroot(y, l2, hy, eq)), λ z _ => Cell::Agrees(tys, strs, h2, s.role(l2), REnv::get(tys, m.env, z), Env::get(tys, e2, z)),
                j(sym(eq), λ q _ => Cell::Agrees(tys, strs, h2, s.role(q), REnv::get(tys, m.env, x), Env::get(tys, e2, x)),
                    j(sym(e2root), λ dd _ => Cell::Agrees(tys, strs, h2, s.role(l), REnv::get(tys, m.env, x), dd), rootag))),
            Inr(ne) => j(sym(ecell(y, other(y, l2, hy, ne))), λ dd _ => Cell::Agrees(tys, strs, h2, s.role(l2), REnv::get(tys, m.env, y), dd),
                Cell::agrees_store(tys, strs, m.heap, h2, s.role(l2), REnv::get(tys, m.env, y), Env::get(tys, e, y), sim.vars(y, l2, hy),
                    λ q cq live => keep(y, l2, hy, ne, q, cq, live))),
        };
    let codes2: ((y: Var) → (l2: Nat) → s.lvl(y) = Some(l2) → (Env::get(tys, e2, y)).code = (s.var(l2)).code) = λ y l2 hy =>
        match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(isroot(y, l2, hy, eq)), λ z _ => (Env::get(tys, e2, z)).code = (s.var(l2)).code,
                trans(cong_fn(λ (d: Dyn(tys)) => d.code, e2root), trans(code, cong_fn(λ (q: Nat) => (s.var(q)).code, sym(eq))))),
            Inr(ne) => trans(cong_fn(λ (d: Dyn(tys)) => d.code, ecell(y, other(y, l2, hy, ne))), sim.codes(y, l2, hy)),
        };
    let sim2: Sim(tys, strs, s, e2, m2) = Sim(trans(Env::set_args(tys, e, x, f), sim.eargs), sim.margs, trans(Env::set_locs(tys, e, x, f), sim.elocs), sim.mlocs, vars2, codes2);
    Inv::store_rest(tys, strs, inv, none, o, r, rt, ch, nw, e2, sim2, s.regions_other(tys, e, e2, x, l, hl, nrf, λ k ir => (inv.words(k, ir)).left, ecell))
}

// ---------------------------------------------------------------------------
// The write stages

// What every write that is not a write-back knows, its residuals split: the
// path fits the root's meaning, the written value is like what it read, and
// the run's selections are the meaning's.
record WriteFacts(tys: Nat → Type, cx: Ctx(tys), s: CSt, e: Env(tys), m: Mach(tys), p: Place, v: Var, n: Next, wi: WriteInv(tys, cx.strs, s, p, v, n)) {
    rl: List<Residual>,
    hrl: s.write_at(wi.l, wi.xs) = Some(rl),
    nst: n.st = s.wrote_to(wi.l),
    resl: Residual::All(rl, tys, cx, e, True),
    fit: Sel::fit(tys, cx.strs, Steps::sels(p.steps, Env::ixs(tys, e)), Env::get(tys, e, p.root)) = True,
    wv: WriteVal(tys, cx.strs, Env::ixs(tys, e), p, Env::get(tys, e, p.root), Env::get(tys, e, v)),
    same: Steps::sels(p.steps, Mach::ixs(tys, cx.strs, m)) = Steps::sels(p.steps, Env::ixs(tys, e)),
    vx: Mach::val(tys, cx.strs, m, v) = Some(Env::get(tys, e, v)),
    nrf: s.in_regions(wi.l) = False,
}

theorem WriteInv::facts(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, sim: Sim(tys, cx.strs, s, e, m), {p: Place}, {v: Var}, {n: Next},
    wi: WriteInv(tys, cx.strs, s, p, v, n), nb: s.is_back(wi.l, wi.xs, wi.lv) = False,
    cok: (match Shape::steps_ok(tys, cx.strs, p.steps, s.code(p.root)) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True,
    tail: Type, res: Residual::All(n.rs, tys, cx, e, tail)): WriteFacts(tys, cx, s, e, m, p, v, n, wi)
{
    let strs = cx.strs;
    let pl = wi.plain_last(tys, strs, nb);
    let rl = pl.witness;
    let fr = match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() };
    let res1: Residual::All(wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ fr, tys, cx, e, tail) = j(pl.proof.right, λ q _ => Residual::All(q.rs, tys, cx, e, tail), res);
    let r2 = (Residual::all_app(tys, cx, e, tail, wi.gv.rs, wi.ra ++ rl ++ p.accesses() ++ fr, res1)).right;
    let r3 = (Residual::all_app(tys, cx, e, tail, wi.ra, rl ++ p.accesses() ++ fr, r2)).right;
    let r4 = Residual::all_app(tys, cx, e, tail, rl, p.accesses() ++ fr, r3);
    let r5 = Residual::all_app(tys, cx, e, tail, p.accesses(), fr, r4.right);
    let rootc: (((Place(p.root, Nil)).val(tys, strs, e)).code = (s.var(wi.l)).code) = sim.codes(p.root, wi.l, wi.hl);
    let cp = Bool::and_true_parts(!s.in_regions(wi.l), !(s.role(wi.l)).same(KGone), wi.cond(tys, strs));
    WriteFacts(rl, pl.proof.left, cong_fn(λ (q: Next) => q.st, pl.proof.right), r4.left,
        Place::fit_from(tys, cx, sl, e, p.root, p.steps, Nil, (s.var(wi.l)).code, wi.c, rootc, wi.hc, r5.left),
        WriteInv::val(tys, cx, sim, wi, cok, tail, r5.right),
        Sim::steps_same(p.steps, tys, strs, s, e, m, sim, wi.xs, wi.hxs, wi.ra, wi.hra),
        Sim::read_val(tys, strs, sim, v, wi.gv, wi.okv),
        Bool::not_true_false(s.in_regions(wi.l), cp.left))
}

// A copy's place kept by a write at a path apart from it, and by its own
// copy changed to one with the same code and length.
theorem CSt::cfit_apart(tys: Nat → Type, strs: Strs(tys), a, ss: List<Sel>, ap: Sel::Apart(tys, strs, a, ss), g: Dyn(tys) → Dyn(tys), dp, dc: Dyn(tys), cf: CSt::CFitAt(tys, strs, a, dp, dc)):
    CSt::CFitAt(tys, strs, a, Sel::write_at(tys, strs, ss, g, dp), dc)
{
    let rd: (Sel::read_at(tys, strs, a, Sel::write_at(tys, strs, ss, g, dp)) = Sel::read_at(tys, strs, a, dp)) = ap.reads.left_after_right(g, dp);
    ⟨trans(ap.fit1(g, dp), cf.left), ⟨trans(cf.right.left, cong_fn(λ (q: Dyn(tys)) => q.code, sym(rd))), trans(cf.right.right, cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), sym(rd)))⟩⟩
}

theorem CSt::cfit_like(tys: Nat → Type, strs: Strs(tys), a: List<Sel>, dp, dc, dc2: Dyn(tys), cf: CSt::CFitAt(tys, strs, a, dp, dc), ec: dc2.code = dc.code, el: Dyn::len(tys, strs, dc2) = Dyn::len(tys, strs, dc)):
    CSt::CFitAt(tys, strs, a, dp, dc2)
{
    ⟨cf.left, ⟨trans(ec, cf.right.left), trans(el, cf.right.right)⟩⟩
}

theorem CSt::parent_plain(self s: CSt, en: VEnt, hr: s.role(en.par) = KPlain, p: s.Parent(en)): False {
    j(hr, λ q _ => match q { KHold(o2, _) => (o2 = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)),
        KPlain => False, KGone => False }, p)
}

// A write to a plain variable: its cell holds the new value; no block, no
// region and no other cell changes.
theorem Stmt::stage_write_plain(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, v: Var, n: Next, ok: s.write(tys, cx.strs, p, v) = Some(n),
    cok: (match Shape::steps_ok(tys, cx.strs, p.steps, s.code(p.root)) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True,
    l: Nat, hl: s.lvl(p.root) = Some(l), hp: s.role(l) = KPlain,
    nb: (xs: List<Step>) → s.steps(p.steps) = Some(xs) → (lv: Nat) → s.lvl(v) = Some(lv) → s.is_back(l, xs, lv) = False,
    tail: Type, res: Residual::All(n.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let wi = s.write_inv(tys, strs, p, v, n, ok);
    let ll: (l = wi.l) = Option::some_inj(l, wi.l, trans(sym(hl), wi.hl));
    let hp2: (s.role(wi.l) = KPlain) = j(ll, λ q _ => s.role(q) = KPlain, hp);
    let wf = WriteInv::facts(tys, cx, sl, sim, wi, j(ll, λ q _ => s.is_back(q, wi.xs, wi.lv) = False, nb(wi.xs, wi.hxs, wi.lv, wi.hlv)), cok, tail, res);
    let ws = Env::ixs(tys, e);
    let vd = Env::get(tys, e, v);
    let old = Env::get(tys, e, p.root);
    let ss = Steps::sels(p.steps, ws);
    let nw = Sel::write_at(tys, strs, ss, λ _ => vd, old);
    let wk = Sel::write_keeps(tys, strs, sl, λ _ => vd, ss, old, wf.wv.code, wf.wv.len);
    let pc: ((REnv::get(tys, m.env, p.root)).v = level2::Plain(old)) = Sim::plain_cell(tys, strs, sim, p.root, wi.l, wi.hl, j(sym(hp2), λ q _ => q.plain() = True, refl));
    let put: (Sel::put(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), vd, old) = Some(nw)) =
        j(sym(wf.same), λ q _ => Sel::put(tys, strs, q, vd, old) = Some(nw), Sel::put_fit(tys, strs, ss, vd, old, wf.fit));
    let c2 = Cell(level2::Plain(nw), (REnv::get(tys, m.env, p.root)).own);
    let f2 = λ (d: Dyn(tys)) => Dyn::write(tys, strs, ws, p.steps, λ _ => vd, d);
    let wsv: (f2(old) = nw) = Steps::write_sels(tys, strs, ws, p.steps, λ _ => vd, old);
    let agr: Cell::Agrees(tys, strs, m.heap, s.role(wi.l), c2, f2(old)) =
        j(sym(hp2), λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, c2, f2(old)), cong_fn(λ (q: Dyn(tys)) => level2::Plain(q), sym(wsv)));
    let code: ((f2(old)).code = (s.var(wi.l)).code) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, wsv), trans(wk.left, sim.codes(p.root, wi.l, wi.hl)));
    let iv = Inv::set_cell(tys, strs, inv, p.root, wi.l, wi.hl, wf.nrf, f2, c2, s.patched_none(tys, strs, e, m, none), s.patched_none(tys, strs, Env::set(tys, e, p.root, f2), Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io), none), agr, code, λ r0 eq => absurd(eq), cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), pc),
        λ en me pq z hz dp dc _ _ => false_elim(s.parent_plain(en, j(sym(pq), λ q _ => s.role(q) = KPlain, hp2), (inv.chain(en, me)).right)),
        λ en me lq y hy dp dc _ _ => absurd(trans(sym((inv.vents(en, me)).right.right), trans(cong_fn(λ (q: Nat) => s.role(q), lq), hp2))));
    let wt: (s.wrote_to(wi.l) = s) = j(sym(hp2), λ r _ => (match r as λ _ => CSt { KPlain => s, KHold(_, _) => s.written(wi.l).unback(wi.l), KView => s.written(wi.l).unback(wi.l), KGone => s.written(wi.l).unback(wi.l) }) = s, refl);
    Stepped(Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io), λ k => Stmt::write_runs_plain(tys, strs, fns, call, m, p, v, vd, wf.vx, old, pc, nw, put, k),
        j(sym(trans(wf.nst, wt)), λ q _ => Inv(tys, strs, q, Env::set(tys, e, p.root, f2), Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io), h0, lent), iv))
}

// A write through a holder: into its cell where it holds its object by
// value, into its object's block where it refers to it. No entry is the
// holder's, so the state after is the same but for what it touched.
theorem Stmt::stage_write_hold(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, v: Var, n: Next, ok: s.write(tys, cx.strs, p, v) = Some(n),
    cok: (match Shape::steps_ok(tys, cx.strs, p.steps, s.code(p.root)) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True,
    l: Nat, hl: s.lvl(p.root) = Some(l), o: Nat, a: Acc, hr: s.role(l) = KHold(o, a),
    nb: (xs: List<Step>) → s.steps(p.steps) = Some(xs) → (lv: Nat) → s.lvl(v) = Some(lv) → s.is_back(l, xs, lv) = False,
    tail: Type, res: Residual::All(n.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let wi = s.write_inv(tys, strs, p, v, n, ok);
    let ll: (l = wi.l) = Option::some_inj(l, wi.l, trans(sym(hl), wi.hl));
    let hr2: (s.role(wi.l) = KHold(o, a)) = j(ll, λ q _ => s.role(q) = KHold(o, a), hr);
    let wf = WriteInv::facts(tys, cx, sl, sim, wi, j(ll, λ q _ => s.is_back(q, wi.xs, wi.lv) = False, nb(wi.xs, wi.hxs, wi.lv, wi.hlv)), cok, tail, res);
    let wl = s.write_lic_hold(wi.l, wi.xs, wf.rl, wf.hrl, o, a, hr2);
    let ws = Env::ixs(tys, e);
    let wsm = Mach::ixs(tys, strs, m);
    let vd = Env::get(tys, e, v);
    let old = Env::get(tys, e, p.root);
    let ss = Steps::sels(p.steps, ws);
    let g = λ (_: Dyn(tys)) => vd;
    let nw = Sel::write_at(tys, strs, ss, g, old);
    let wk = Sel::write_keeps(tys, strs, sl, g, ss, old, wf.wv.code, wf.wv.len);
    let f2 = λ (d: Dyn(tys)) => Dyn::write(tys, strs, ws, p.steps, g, d);
    let e2 = Env::set(tys, e, p.root, f2);
    let wsv: (f2(old) = nw) = Steps::write_sels(tys, strs, ws, p.steps, g, old);
    let code: ((f2(old)).code = (s.var(wi.l)).code) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, wsv), trans(wk.left, sim.codes(p.root, wi.l, wi.hl)));
    let nolvl: ((en: VEnt) → Mem(en, s.views) → ¬(en.lvl = wi.l)) = λ en me eq =>
        absurd(trans(sym((inv.vents(en, me)).right.right), trans(cong_fn(λ (q: Nat) => s.role(q), eq), hr2)));
    let wt: (s.wrote_to(wi.l) = s.written(wi.l).unback(wi.l)) = j(sym(hr2), λ rr _ => (match rr as λ _ => CSt { KPlain => s, KHold(_, _) => s.written(wi.l).unback(wi.l),
        KView => s.written(wi.l).unback(wi.l), KGone => s.written(wi.l).unback(wi.l) }) = s.written(wi.l).unback(wi.l), refl);
    let s2 = CSt(s.args, s.locs, s.na, s.nd, s.views, s.nobj, Cons(wi.l, s.touched), Cons(wi.l, s.wrote));
    let nst: (s2 = n.st) = sym(trans(wf.nst, trans(wt, s.wrote_none(wi.l, nolvl))));
        let unst: (s.unsteps(wi.xs) = p.steps) = CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs);
        let rp = CSt::steps_range(p.steps, s, wi.xs, wi.hxs);
        let pp = CSt::atoms_plain(Steps::lvls(wi.xs), s, wi.ra, wi.hra);
        let lic: ((en: VEnt) → Mem(en, s.views) → en.obj = o → Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.reg), wsm), ss)) = λ en me eo => {
            let mt = s.meets_hold(wi.l, Writing, en, o, a, hr2, nolvl(en, me), refl);
            let ap = Inv::lic_apart(tys, cx, sl, inv, none, Writing, wi.l, [Pl(o, wi.xs)], wf.rl, wl.right, wf.resl, en, me, mt, Pl(o, wi.xs), Inl(refl), eo, rp, pp);
            j(trans(cong_fn(λ (q: List<Step>) => Steps::sels(q, wsm), unst), wf.same), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.reg), wsm), q), ap)
        };
    let rd0: Value::Reads(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, old) =
        j(hr2, λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, REnv::get(tys, m.env, p.root), old), sim.vars(p.root, wi.l, wi.hl));
    (match (REnv::get(tys, m.env, p.root)).v as λ u => (REnv::get(tys, m.env, p.root)).v = u → Value::Reads(tys, strs, m.heap, u, old) →
            Stepped(tys, strs, fns, call, Write(p, v), n.st, e2, m, h0, lent) {
        Plain(dh) => λ cv rdh => {
            let pc: ((REnv::get(tys, m.env, p.root)).v = level2::Plain(old)) = trans(cv, cong_fn(λ (q: Dyn(tys)) => level2::Plain(q), Option::some_inj(dh, old, rdh)));
            let put: (Sel::put(tys, strs, Steps::sels(p.steps, wsm), vd, old) = Some(nw)) =
                j(sym(wf.same), λ q _ => Sel::put(tys, strs, q, vd, old) = Some(nw), Sel::put_fit(tys, strs, ss, vd, old, wf.fit));
            let c2 = Cell(level2::Plain(nw), (REnv::get(tys, m.env, p.root)).own);
            let m2: Mach(tys) = Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io);
            let agr: Cell::Agrees(tys, strs, m.heap, s.role(wi.l), c2, f2(old)) =
                j(sym(hr2), λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, c2, f2(old)), cong_fn(λ (q: Dyn(tys)) => Some(q), sym(wsv)));
            let iv = Inv::set_cell(tys, strs, inv, p.root, wi.l, wi.hl, wf.nrf, f2, c2, s.patched_none(tys, strs, e, m, none), s.patched_none(tys, strs, Env::set(tys, e, p.root, f2), Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io), none), agr, code, λ r0 eq => absurd(eq), cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), pc),
                λ en me pq z hz dp dc cp cz => {
                    let ph = s.parent_hold(en, o, a, j(sym(pq), λ q _ => s.role(q) = KHold(o, a), hr2), (inv.chain(en, me)).right);
                    let cf0 = inv.cfit(en, me, p.root, z, j(sym(pq), λ q _ => s.lvl(p.root) = Some(q), wi.hl), hz, old, dc, pc, cz);
                    let ap = j(ph.right, λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q), wsm), ss), lic(en, me, sym(ph.left)));
                    let nwe: (nw = dp) = cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => nw }, cp);
                    j(nwe, λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), wsm), q, dc), CSt::cfit_apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), ss, ap, g, old, dc, cf0))
                },
                λ en me lq _ _ _ _ _ _ => false_elim(nolvl(en, me, lq)));
            Stepped(m2, λ k => Stmt::write_runs_plain(tys, strs, fns, call, m, p, v, vd, wf.vx, old, pc, nw, put, k),
                j(nst, λ q _ => Inv(tys, strs, q, e2, m2, h0, lent), Inv::touch(tys, strs, iv, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))))
        },
        Refer(r) => λ cv rdr => match Value::refer_inv(tys, strs, m.heap, r, old, rdr) {
            ⟨ob, pob⟩ => {
                let fr = pob.right.left;
                let rdo: (Sel::read_at(tys, strs, r.sels, ob) = old) = pob.right.right;
                let nwb = Sel::write_at(tys, strs, r.sels ++ ss, g, ob);
                let fss: (Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob)) = True) = j(sym(rdo), λ t _ => Sel::fit(tys, strs, ss, t) = True, wf.fit);
                let fall: (Sel::fit(tys, strs, r.sels ++ ss, ob) = True) =
                    trans(Sel::fit_append(tys, strs, r.sels, ss, ob), Bool::and_of(Sel::fit(tys, strs, r.sels, ob), Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob)), fr, fss));
                let put: (Sel::put(tys, strs, r.sels ++ Steps::sels(p.steps, wsm), vd, ob) = Some(nwb)) =
                    j(sym(wf.same), λ q _ => Sel::put(tys, strs, r.sels ++ q, vd, ob) = Some(nwb), Sel::put_fit(tys, strs, r.sels ++ ss, vd, ob, fall));
                let hc: ((g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob)))).code = (Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob))).code) =
                    j(sym(rdo), λ t _ => vd.code = (Sel::read_at(tys, strs, ss, t)).code, wf.wv.code);
                let hln: (Dyn::len(tys, strs, g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r.sels, ob)))) =
                    j(sym(rdo), λ t _ => Dyn::len(tys, strs, vd) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, t)), wf.wv.len);
                let ff = λ (y: Dyn(tys)) => Sel::write_at(tys, strs, ss, g, y);
                let wa: (nwb = Sel::write_at(tys, strs, r.sels, ff, ob)) = Sel::write_append(tys, strs, r.sels, ss, g, ob);
                let wk2 = Sel::write_keeps(tys, strs, sl, g, ss, Sel::read_at(tys, strs, r.sels, ob), hc, hln);
                let wg = Sel::write_get(tys, strs, sl, ff, r.sels, ob, fr, wk2.left, wk2.right);
                let rdn: (Sel::read_at(tys, strs, r.sels, nwb) = f2(old)) =
                    trans(cong_fn(λ (t: Dyn(tys)) => Sel::read_at(tys, strs, r.sels, t), wa), trans(wg.right, trans(cong_fn(ff, rdo), sym(wsv))));
                let fnw: (Sel::fit(tys, strs, r.sels, nwb) = True) = j(sym(wa), λ t _ => Sel::fit(tys, strs, r.sels, t) = True, wg.left);
                let agr: (Sel::get(tys, strs, r.sels, nwb) = Some(f2(old))) = trans(Sel::get_fit(tys, strs, r.sels, nwb, fnw), cong_fn(λ (t: Dyn(tys)) => Some(t), rdn));
                let iv = Inv::store(tys, strs, inv, none, p.root, wi.l, wi.hl, wf.nrf, o, a, hr2, wl.left, r, cv, ob, pob.left, ss, nwb, f2, agr, code,
                    λ q ap => Sel::get_apart(tys, strs, r.sels ++ ss, q, Sel::apart_ext_l(tys, strs, r.sels, ss, q, ap), g, ob),
                    λ vs ap => Sel::get_under(tys, strs, sl, r.sels, ss, vs, ap, g, ob, fr, hc, hln),
                    lic);
                let m2: Mach(tys) = Mach(Heap::store(tys, m.heap, r.b, nwb), m.env, m.io);
                Stepped(m2, λ k => Stmt::write_runs_ref(tys, strs, fns, call, m, p, v, vd, wf.vx, r, cv, ob, pob.left, nwb, put, k),
                    j(nst, λ q _ => Inv(tys, strs, q, e2, m2, h0, lent), Inv::touch(tys, strs, iv, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))))
            },
        },
    })(refl, rd0)
}

// ---------------------------------------------------------------------------
// A view written: its entry no longer written back. The invariant's clauses
// but `sim` read an entry's level, object, region, mode, parent and place,
// never whether it is written back, so they carry over.

fn VEnt::unbacked(self en: VEnt, l: Nat) → VEnt { match en.lvl.same(l) { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), False => en } }

// Two entries alike but perhaps for whether they are written back.
record Kin(a, b: VEnt) { lvl: a.lvl = b.lvl, obj: a.obj = b.obj, reg: a.reg = b.reg, mode: a.mode = b.mode, par: a.par = b.par, at: a.at = b.at }

theorem VEnt::unbacked_kin(self en: VEnt, l: Nat): Kin(en.unbacked(l), en) {
    (match en.lvl.same(l) as λ c => Kin(match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), False => en }, en) {
        True => Kin(refl, refl, refl, refl, refl, refl),
        False => Kin(refl, refl, refl, refl, refl, refl),
    })
}

// A state whose entries are mapped by , alike but perhaps for whether
// they are written back, its other lists set.
fn CSt::rekin(self s: CSt, f: VEnt → VEnt, tl, wl: List<Nat>) → CSt { CSt(s.args, s.locs, s.na, s.nd, s.views.map(f), s.nobj, tl, wl) }

theorem CSt::pre_rekin(self s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, x: VEnt, mx: Mem(x, s.rekin(f, tl, wl).views)): Exists<VEnt>(λ en => Mem(en, s.views) ∧ Kin(x, en)) {
    match List::mem_map_inv(s.views, f, x, mx) {
        ⟨en, pen⟩ => Exists(en, ⟨pen.left, j(sym(pen.right), λ q _ => Kin(q, en), kf(en))⟩),
    }
}

theorem VEnt::ents_map(self es: List<VEnt>, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), k: Nat):
    (es.map(f)).filter(λ e => e.lvl.same(k)) = (es.filter(λ e => e.lvl.same(k))).map(f)
{
    match es {
        Nil => refl,
        Cons(e0, rest) => {
            let u = f;
            let ih = VEnt::ents_map(rest, f, kf, k);
            let br = λ (b: Bool) => match b as λ _ => List<VEnt> { True => Cons(u(e0), (rest.map(u)).filter(λ e => e.lvl.same(k))), False => (rest.map(u)).filter(λ e => e.lvl.same(k)) };
            let kl: ((u(e0)).lvl.same(k) = e0.lvl.same(k)) = cong_fn(λ (n: Nat) => n.same(k), (kf(e0)).lvl);
            (match e0.lvl.same(k) as λ c => e0.lvl.same(k) = c →
                    br((u(e0)).lvl.same(k)) = (match c as λ _ => List<VEnt> { True => Cons(e0, rest.filter(λ e => e.lvl.same(k))), False => rest.filter(λ e => e.lvl.same(k)) }).map(u) {
                True => λ ec => trans(cong_fn(br, trans(kl, ec)), cong_fn(λ (t: List<VEnt>) => Cons(u(e0), t), ih)),
                False => λ ec => trans(cong_fn(br, trans(kl, ec)), ih),
            })(refl)
        },
    }
}

theorem VEnt::foldr_map(self es: List<VEnt>, u: VEnt → VEnt, F: VEnt → List<Nat>):
    (es.map(u)).foldr(λ (pe: VEnt) (acc: List<Nat>) => F(pe) ++ acc, Nil) = es.foldr(λ (pe: VEnt) (acc: List<Nat>) => F(u(pe)) ++ acc, Nil)
{
    match es { Nil => refl, Cons(e0, rest) => cong_fn(λ (t: List<Nat>) => F(u(e0)) ++ t, VEnt::foldr_map(rest, u, F)) }
}

theorem VEnt::any_bit_map(self es: List<VEnt>, u: VEnt → VEnt, q: VEnt → Bool, h: (e: VEnt) → q(u(e)) = q(e)): (es.map(u)).any_bit(q) = es.any_bit(q) {
    match es {
        Nil => refl,
        Cons(e0, rest) => trans(cong_fn(λ (b: Bool) => b || (rest.map(u)).any_bit(q), h(e0)), cong_fn(λ (b: Bool) => q(e0) || b, VEnt::any_bit_map(rest, u, q, h))),
    }
}

// An ancestry reads an entry's parent and level only.
theorem CSt::anc_kin(self f: Nat, s: CSt, a, b: VEnt, kp: a.par = b.par, kl: a.lvl = b.lvl): s.anc_of(a, f) = s.anc_of(b, f) {
    match f {
        Zero => refl,
        Succ(f1) => {
            let g = λ (p: Nat) (lv: Nat) => match p.same(lv) as λ _ => List<Nat> { True => Nil<Nat>(), False => Cons(p, (s.ents(p)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, f1) ++ acc, Nil)) };
            trans(cong_fn(λ (p: Nat) => g(p, a.lvl), kp), cong_fn(λ (lv: Nat) => g(b.par, lv), kl))
        },
    }
}

theorem CSt::anc_rekin(self fu: Nat, s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>): (e: VEnt) → (s.rekin(f, tl, wl)).anc_of(e, fu) = s.anc_of(e, fu) {
    match fu {
        Zero => λ e => refl,
        Succ(f1) => λ e => match e.par.same(e.lvl) {
            True => refl,
            False => {
                let s1 = s.rekin(f, tl, wl);
                cong_fn(λ (q: List<Nat>) => Cons(e.par, q),
                    trans(cong_fn(λ (q: List<VEnt>) => q.foldr(λ (pe: VEnt) (acc: List<Nat>) => s1.anc_of(pe, f1) ++ acc, Nil), VEnt::ents_map(s.views, f, kf, e.par)),
                        trans(VEnt::foldr_map(s.ents(e.par), f, λ pe => s1.anc_of(pe, f1)),
                            VEnt::foldr_anc(s.ents(e.par), λ pe => s1.anc_of(f(pe), f1), λ pe => s.anc_of(pe, f1), λ pe _ =>
                                trans(CSt::anc_rekin(f1, s, f, kf, tl, wl, f(pe)), CSt::anc_kin(f1, s, f(pe), pe, (kf(pe)).par, (kf(pe)).lvl))))))
            },
        },
    }
}

theorem CSt::regions_rekin(self s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, k: Nat): s.rekin(f, tl, wl).in_regions(k) = s.in_regions(k) {
    VEnt::any_bit_map(s.views, f, λ e => k.member(Steps::lvls(e.reg)) || k.member(Steps::lvls(e.at)), λ e => {
        let kk = kf(e);
        trans(cong_fn(λ (r: List<Step>) => k.member(Steps::lvls(r)) || k.member(Steps::lvls(f(e).at)), kk.reg),
            cong_fn(λ (a: List<Step>) => k.member(Steps::lvls(e.reg)) || k.member(Steps::lvls(a)), kk.at))
    })
}

theorem CSt::changes_rekin(self s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, o: Nat, h: s.rekin(f, tl, wl).Changes(o)): s.Changes(o) {
    match h {
        Inl(x) => Inl(x),
        Inr(ex) => match ex {
            ⟨x, px⟩ => match s.pre_rekin(f, kf, tl, wl, x, px.left) {
                ⟨en, pe⟩ => Inr(Exists(en, ⟨pe.left, ⟨trans(sym(pe.right.obj), px.right.left), trans(cong_fn(λ (md: Mode) => md.writes(), sym(pe.right.mode)), px.right.right)⟩⟩)),
            },
        },
    }
}

theorem CSt::refok_rekin(self s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, root: Nat → Option<Ref>, ws: List<Ix>, k: Nat, r: Ref, ok: s.RefOk(root, ws, k, r)): s.rekin(f, tl, wl).RefOk(root, ws, k, r) {
    let s1 = s.rekin(f, tl, wl);
    let u = f;
    let kv1 = VEnt::Any(s1.ents(k), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s1.unsteps(en.reg))) = Some(r));
    let kv = VEnt::Any(s.ents(k), λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r));
    let to: (kv → kv1) = λ h => j(sym(VEnt::ents_map(s.views, f, kf, k)), λ es _ => VEnt::Any(es, λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s1.unsteps(en.reg))) = Some(r)),
        VEnt::any_map(s.ents(k), u, λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r),
            λ en => (root(en.obj)).map(λ r0 => r0.narrow(ws, s1.unsteps(en.reg))) = Some(r),
            λ en _ p => {
                let kk = kf(en);
                j(sym(kk.reg), λ rg _ => (root((u(en)).obj)).map(λ r0 => r0.narrow(ws, s.unsteps(rg))) = Some(r),
                    j(sym(kk.obj), λ ob _ => (root(ob)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r), p))
            }, h));
    (match s.role(k) as λ q => (match q { KHold(o, _) => root(o) = Some(r), KView => kv, KPlain => False, KGone => True }) →
            (match q { KHold(o, _) => root(o) = Some(r), KView => kv1, KPlain => False, KGone => True }) {
        KHold(_, _) => λ h => h, KView => to, KPlain => λ h => h, KGone => λ h => h,
    })(ok)
}

theorem CSt::parent_rekin(self s: CSt, f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, x, en: VEnt, kk: Kin(x, en), p: s.Parent(en)): s.rekin(f, tl, wl).Parent(x) {
    let s1 = s.rekin(f, tl, wl);
    let u = f;
    let q1 = λ (pe: VEnt) => (pe.obj = x.obj) ∧ (x.reg = pe.reg ++ x.at);
    let p1 = λ (r: Role) => match r { KHold(o, _) => (o = x.obj) ∧ (x.reg = x.at), KView => VEnt::Any(s1.ents(x.par), q1), KPlain => False, KGone => False };
    let p0 = λ (r: Role) => match r { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at), KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False };
    let mid: p1(s.role(en.par)) = (match s.role(en.par) as λ r => p0(r) → p1(r) {
        KHold(_, _) => λ h => ⟨trans(h.left, sym(kk.obj)), trans(kk.reg, trans(h.right, sym(kk.at)))⟩,
        KView => λ h => {
            let a1 = VEnt::any_map(s.ents(en.par), u, λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at), q1, λ pe _ hp => {
                let kp = kf(pe);
                ⟨trans(kp.obj, trans(hp.left, sym(kk.obj))),
                 trans(kk.reg, trans(hp.right, trans(cong_fn(λ (t: List<Step>) => t ++ en.at, sym(kp.reg)), cong_fn(λ (t: List<Step>) => (u(pe)).reg ++ t, sym(kk.at)))))⟩
            }, h);
            j(sym(kk.par), λ q _ => VEnt::Any(s1.ents(q), q1), j(sym(VEnt::ents_map(s.views, f, kf, en.par)), λ es _ => VEnt::Any(es, q1), a1))
        },
        KPlain => λ h => h,
        KGone => λ h => h,
    })(p);
    j(sym(kk.par), λ q _ => p1(s.role(q)), mid)
}

// After a write through `l` from nothing pending, an entry pending is `l`'s.
theorem CSt::pend_unback(self s: CSt, l: Nat, none: s.pending() = False, x: VEnt, mx: Mem(x, (s.written(l).unback(l)).views), w: (x.mode.writes() && !x.back) = True): x.lvl = l {
    match List::mem_map_inv(s.views, λ (y: VEnt) => y.unbacked(l), x, mx) {
        ⟨en, pen⟩ => {
            let kk = en.unbacked_kin(l);
            let xl: (x.lvl = en.lvl) = trans(cong_fn(λ (q: VEnt) => q.lvl, pen.right), kk.lvl);
            (match en.lvl.same(l) as λ c => en.lvl.same(l) = c → x.lvl = l {
                True => λ ec => trans(xl, en.lvl.same_sound(l, ec)),
                False => λ ec => {
                    let ux: (en.unbacked(l) = en) = j(sym(ec), λ c _ => (match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), False => en }) = en, refl);
                    let we: ((en.mode.writes() && !en.back) = True) = j(trans(pen.right, ux), λ q _ => (q.mode.writes() && !q.back) = True, w);
                    absurd(trans(sym(none), s.views.any_bit_mem(λ y => y.mode.writes() && !y.back, en, pen.left, we)))
                },
            })(refl)
        },
    }
}

// The invariant at a state whose entries differ at most in being written
// back, from its clauses at the state before (any meaning: they do not read
// it),  against the new patch, and its pending entries at one level.
// Formerly at a write's state only:
// (any meaning: they do not read it) and `Sim` against the new patch.
theorem Inv::rekin(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {ex: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, ex, m, h0, lent),
    f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>, e2: Env(tys), pone: (s.rekin(f, tl, wl)).POne(), sim1: Sim(tys, strs, s.rekin(f, tl, wl), s.rekin(f, tl, wl).patched(tys, strs, e2, m), m)):
    Inv(tys, strs, s.rekin(f, tl, wl), e2, m, h0, lent)
{
    let s1 = s.rekin(f, tl, wl);
    let ws = Mach::ixs(tys, strs, m);
    let nl = s.na + s.nd;
    Inv(sim1, inv.root,
        λ y k hy r cr => s.refok_rekin(f, kf, tl, wl, inv.root, ws, k, r, inv.refs(y, k, hy, r, cr)),
        λ o1 o2 ne ch => inv.apart(o1, o2, ne, s.changes_rekin(f, kf, tl, wl, o1, ch)),
        inv.inheap,
        λ o ch => inv.owned(o, s.changes_rekin(f, kf, tl, wl, o, ch)),
        inv.own, inv.one,
        λ k w => inv.words(k, trans(sym(s.regions_rekin(f, kf, tl, wl, k)), w)),
        inv.frame, inv.grows, inv.young, inv.held,
        λ x mx => match s.pre_rekin(f, kf, tl, wl, x, mx) {
            ⟨en, pe⟩ => {
                let vv = inv.vents(en, pe.left);
                let kk = pe.right;
                ⟨j(sym(kk.obj), λ n _ => n < s.nobj, vv.left), ⟨j(sym(kk.lvl), λ n _ => n < nl, vv.right.left), j(sym(kk.lvl), λ n _ => s.role(n) = KView, vv.right.right)⟩⟩
            },
        },
        inv.bare,
        λ x mx => match s.pre_rekin(f, kf, tl, wl, x, mx) {
            ⟨en, pe⟩ => {
                let cc = inv.chain(en, pe.left);
                let kk = pe.right;
                ⟨j(sym(kk.par), λ n _ => n < x.lvl, j(sym(kk.lvl), λ n _ => en.par < n, cc.left)), s.parent_rekin(f, kf, tl, wl, x, en, kk, cc.right)⟩
            },
        },
        λ x1 x2 m1 m2 w eo ne a1 a2 => match s.pre_rekin(f, kf, tl, wl, x1, m1) {
            ⟨en1, p1⟩ => match s.pre_rekin(f, kf, tl, wl, x2, m2) {
                ⟨en2, p2⟩ => {
                    let k1 = p1.right;
                    let k2 = p2.right;
                    let anc2: (s1.anc_of(x2, nl) = s.anc_of(en2, nl)) = trans(CSt::anc_rekin(nl, s, f, kf, tl, wl, x2), CSt::anc_kin(nl, s, x2, en2, k2.par, k2.lvl));
                    let anc1: (s1.anc_of(x1, nl) = s.anc_of(en1, nl)) = trans(CSt::anc_rekin(nl, s, f, kf, tl, wl, x1), CSt::anc_kin(nl, s, x1, en1, k1.par, k1.lvl));
                    let b1: (en1.lvl.member(s.anc_of(en2, nl)) = False) = trans(cong_fn(λ (n: Nat) => n.member(s.anc_of(en2, nl)), sym(k1.lvl)), j(anc2, λ q _ => x1.lvl.member(q) = False, a1));
                    let b2: (en2.lvl.member(s.anc_of(en1, nl)) = False) = trans(cong_fn(λ (n: Nat) => n.member(s.anc_of(en1, nl)), sym(k2.lvl)), j(anc1, λ q _ => x2.lvl.member(q) = False, a2));
                    let ap = inv.excl(en1, en2, p1.left, p2.left, trans(cong_fn(λ (md: Mode) => md.writes(), sym(k1.mode)), w), trans(sym(k1.obj), trans(eo, k2.obj)),
                        λ eq => ne(trans(k1.lvl, trans(eq, sym(k2.lvl)))), b1, b2);
                    j(sym(k2.reg), λ rg _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(x1.reg), ws), Steps::sels(s.unsteps(rg), ws)),
                        j(sym(k1.reg), λ rg _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(rg), ws), Steps::sels(s.unsteps(en2.reg), ws)), ap))
                },
            },
        },
        λ x mx w => match s.pre_rekin(f, kf, tl, wl, x, mx) {
            ⟨en, pe⟩ => {
                let kk = pe.right;
                λ rv => match inv.wpar(en, pe.left, trans(cong_fn(λ (md: Mode) => md.writes(), sym(kk.mode)), w))(trans(cong_fn(λ (q: Nat) => s.role(q), sym(kk.par)), rv)) {
                    ⟨pw, pp⟩ => Exists(f(pw), ⟨trans(cong_fn(λ (q: Nat) => s1.ents(q), kk.par), trans(VEnt::ents_map(s.views, f, kf, en.par), cong_fn(λ (es: List<VEnt>) => es.map(f), pp.left))),
                        trans(cong_fn(λ (md: Mode) => md.writes(), (kf(pw)).mode), pp.right)⟩),
                }
            },
        },
        λ x mx y z hy hz => match s.pre_rekin(f, kf, tl, wl, x, mx) {
            ⟨en, pe⟩ => inv.uni(en, pe.left, y, z, trans(hy, cong_fn(λ (n: Nat) => Some(n), pe.right.lvl)), trans(hz, cong_fn(λ (n: Nat) => Some(n), pe.right.par))),
        },
        pone,
        λ x mx y z hy hz dp dc cy cz => match s.pre_rekin(f, kf, tl, wl, x, mx) {
            ⟨en, pe⟩ => j(sym(pe.right.at), λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(q), ws), dp, dc),
                inv.cfit(en, pe.left, y, z, trans(hy, cong_fn(λ (n: Nat) => Some(n), pe.right.par)), trans(hz, cong_fn(λ (n: Nat) => Some(n), pe.right.lvl)), dp, dc, cy, cz)),
        },
        λ x1 x2 m1 m2 w pp ne => match s.pre_rekin(f, kf, tl, wl, x1, m1) {
            ⟨en1, p1⟩ => match s.pre_rekin(f, kf, tl, wl, x2, m2) {
                ⟨en2, p2⟩ => {
                    let ap = inv.sib(en1, en2, p1.left, p2.left, trans(cong_fn(λ (md: Mode) => md.writes(), sym(p1.right.mode)), w), trans(sym(p1.right.par), trans(pp, p2.right.par)),
                        λ eq => ne(trans(p1.right.lvl, trans(eq, sym(p2.right.lvl)))));
                    j(sym(p2.right.at), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(x1.at), ws), Steps::sels(s.unsteps(q), ws)),
                        j(sym(p1.right.at), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(q), ws), Steps::sels(s.unsteps(en2.at), ws)), ap))
                },
            },
        })
}

// The invariant at a write's state.
theorem Inv::unback(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {ex: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, ex, m, h0, lent),
    none: s.pending() = False, l: Nat, e2: Env(tys), sim1: Sim(tys, strs, s.written(l).unback(l), (s.written(l).unback(l)).patched(tys, strs, e2, m), m)):
    Inv(tys, strs, s.written(l).unback(l), e2, m, h0, lent)
{
    Inv::rekin(tys, strs, inv, λ (y: VEnt) => y.unbacked(l), λ x => x.unbacked_kin(l), Cons(l, s.touched), Cons(l, s.wrote), e2,
        λ x1 x2 m1 m2 w1 w2 => trans(s.pend_unback(l, none, x1, m1, w1), sym(s.pend_unback(l, none, x2, m2, w2))), sim1)
}

theorem VEnt::mem_filter_lvl(self es: List<VEnt>, l: Nat, a: VEnt, h: a.lvl.same(l) = True): Mem(a, es) → Mem(a, es.filter(λ e => e.lvl.same(l))) {
    match es {
        Nil => λ m => m,
        Cons(e0, rest) => λ m => (match e0.lvl.same(l) as λ c => e0.lvl.same(l) = c →
                Mem(a, match c as λ _ => List<VEnt> { True => Cons(e0, rest.filter(λ e => e.lvl.same(l))), False => rest.filter(λ e => e.lvl.same(l)) }) {
            True => λ _ => match m { Inl(eq) => Inl(eq), Inr(m2) => Inr(VEnt::mem_filter_lvl(rest, l, a, h, m2)) },
            False => λ ec => match m { Inl(eq) => absurd(trans(sym(ec), j(eq, λ q _ => q.lvl.same(l) = True, h))), Inr(m2) => VEnt::mem_filter_lvl(rest, l, a, h, m2) },
        })(refl),
    }
}

// Nothing pending before a write through the view at `l`, its one entry to
// write: after it, the first entry pending is that view's.
theorem CSt::find_unback(self xs: List<VEnt>, l: Nat, pe: VEnt, pl: pe.lvl = l, pw: pe.mode.writes() = True,
    only: (x: VEnt) → Mem(x, xs) → x.lvl.same(l) = True → x = pe, fls: xs.any_bit(λ en => en.mode.writes() && !en.back) = False, mp: Mem(pe, xs)):
    Exists<VEnt>(λ y => ((xs.map(λ (e: VEnt) => e.unbacked(l))).find(λ en => en.mode.writes() && !en.back) = Some(y)) ∧ (y.lvl = l))
{
    match xs {
        Nil => false_elim(mp),
        Cons(x, rest) => {
            let u = λ (e: VEnt) => e.unbacked(l);
            let fp = Bool::or_false_parts(x.mode.writes() && !x.back, rest.any_bit(λ en => en.mode.writes() && !en.back), fls);
            let f = λ (y: VEnt) => match (y.mode.writes() && !y.back) as λ _ => Option<VEnt> { True => Some(y), False => (rest.map(u)).find(λ en => en.mode.writes() && !en.back) };
            (match x.lvl.same(l) as λ c => x.lvl.same(l) = c → Exists<VEnt>(λ y => (f(u(x)) = Some(y)) ∧ (y.lvl = l)) {
                True => λ ec => {
                    let xe: (x = pe) = only(x, Inl(refl), ec);
                    let y0 = VEnt(x.lvl, x.obj, x.reg, x.mode, x.par, x.at, False);
                    let ux: (u(x) = y0) = j(sym(ec), λ c _ => (match c as λ _ => VEnt { True => y0, False => x }) = y0, refl);
                    let wx: (x.mode.writes() = True) = j(sym(xe), λ q _ => q.mode.writes() = True, pw);
                    let fy: (f(y0) = Some(y0)) = j(sym(wx), λ b _ => (match (b && !False) as λ _ => Option<VEnt> { True => Some(y0), False => (rest.map(u)).find(λ en => en.mode.writes() && !en.back) }) = Some(y0), refl);
                    Exists(y0, ⟨trans(cong_fn(f, ux), fy), x.lvl.same_sound(l, ec)⟩)
                },
                False => λ ec => {
                    let ux: (u(x) = x) = j(sym(ec), λ c _ => (match c as λ _ => VEnt { True => VEnt(x.lvl, x.obj, x.reg, x.mode, x.par, x.at, False), False => x }) = x, refl);
                    let fx: (f(x) = (rest.map(u)).find(λ en => en.mode.writes() && !en.back)) =
                        j(sym(fp.left), λ b _ => (match b as λ _ => Option<VEnt> { True => Some(x), False => (rest.map(u)).find(λ en => en.mode.writes() && !en.back) }) = (rest.map(u)).find(λ en => en.mode.writes() && !en.back), refl);
                    let mr: Mem(pe, rest) = match mp {
                        Inl(eq) => absurd(trans(sym(ec), trans(cong_fn(λ (n: Nat) => n.same(l), trans(cong_fn(λ (q: VEnt) => q.lvl, sym(eq)), pl)), l.same_self()))),
                        Inr(m2) => m2,
                    };
                    match CSt::find_unback(rest, l, pe, pl, pw, λ y my => only(y, Inr(my)), fp.right, mr) {
                        ⟨y, py⟩ => Exists(y, ⟨trans(cong_fn(f, ux), trans(fx, py.left)), py.right⟩),
                    }
                },
            })(refl)
        },
    }
}

// What the patch is at a write's state: the chain from the written view
// written up where its cell refers, nothing where it is a copy.
theorem CSt::patched_unback(self s: CSt, tys: Nat → Type, strs: Strs(tys), l: Nat, pe: VEnt, none: s.pending() = False, hents: s.ents(l) = [pe], pw: pe.mode.writes() = True,
    e2: Env(tys), m: Mach(tys)):
    (s.written(l).unback(l)).patched(tys, strs, e2, m) =
        (match (REnv::get(tys, m.env, s.var_at(l))).v as λ _ => Env(tys) { Refer(_) => (s.written(l).unback(l)).up(tys, strs, e2, l, s.na + s.nd), Plain(_) => e2 })
{
    let s1 = s.written(l).unback(l);
    let q = λ (en: VEnt) => en.mode.writes() && !en.back;
    let mpe: Mem(pe, s.ents(l)) = j(sym(hents), λ es _ => Mem(pe, es), Inl(refl));
    let mp: Mem(pe, s.views) = s.views.mem_filter(pe, λ x => x.lvl.same(l), mpe);
    let pl: (pe.lvl = l) = pe.lvl.same_sound(l, s.views.mem_filter_holds(pe, λ x => x.lvl.same(l), mpe));
    let only: ((x: VEnt) → Mem(x, s.views) → x.lvl.same(l) = True → x = pe) = λ x mx h =>
        match j(hents, λ es _ => Mem(x, es), VEnt::mem_filter_lvl(s.views, l, x, h, mx)) { Inl(eq) => eq, Inr(no) => false_elim(no) };
    match CSt::find_unback(s.views, l, pe, pl, pw, only, none, mp) {
        ⟨y, py⟩ => {
            let fs = List::find_sound(s1.views, q, y, py.left);
            let pend1: (s1.pending() = True) = s1.views.any_bit_mem(q, y, fs.left, fs.right);
            let hh = λ (o: Option<VEnt>) => match o as λ _ => Env(tys) {
                Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v as λ _ => Env(tys) { Refer(_) => s1.up(tys, strs, e2, en.lvl, s.na + s.nd), Plain(_) => e2 },
                None => e2,
            };
            trans(j(sym(pend1), λ b _ => (match b as λ _ => Env(tys) { False => e2, True => hh(s1.views.find(q)) }) = hh(s1.views.find(q)), refl),
                trans(cong_fn(hh, py.left), cong_fn(λ (k: Nat) => match (REnv::get(tys, m.env, s.var_at(k))).v as λ _ => Env(tys) { Refer(_) => s1.up(tys, strs, e2, k, s.na + s.nd), Plain(_) => e2 }, py.right)))
        },
    }
}

// ---------------------------------------------------------------------------
// The pending chain written up: what each ancestor's reference reads after a
// write below it

// A write along a path reads only what the path read.
theorem Sel::write_read(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), xs: List<Sel>): (g1, g2: Dyn(tys) → Dyn(tys)) → (d: Dyn(tys)) →
    g1(Sel::read_at(tys, strs, xs, d)) = g2(Sel::read_at(tys, strs, xs, d)) → Sel::write_at(tys, strs, xs, g1, d) = Sel::write_at(tys, strs, xs, g2, d)
{
    match xs {
        Nil => λ g1 g2 d h => h,
        Cons(a, rest) => λ g1 g2 d h => (Dyn::model_laws(tys, strs, sl)).over_read(a, λ y => Sel::write_at(tys, strs, rest, g1, y), λ y => Sel::write_at(tys, strs, rest, g2, y), d,
            Sel::write_read(tys, strs, sl, rest, g1, g2, Dyn::at(tys, strs, a, d), h)),
    }
}

// A write at `qp ++ a ++ t`, read at `qp`: what `qp` read, with what `qp ++ a`
// reads now written at `a`. The path `qp` still fits, and reads a value of
// the code and length it read.
theorem Sel::read_under(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), qp, a, t: List<Sel>, g: Dyn(tys) → Dyn(tys), ob: Dyn(tys),
    fqa: Sel::fit(tys, strs, qp ++ a, ob) = True,
    hc: (g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qp ++ a, ob)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qp ++ a, ob))).code,
    hl: Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qp ++ a, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qp ++ a, ob)))):
    (Sel::fit(tys, strs, qp, Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob)) = True) ∧
    ((Sel::read_at(tys, strs, qp, Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob)) =
        Sel::write_at(tys, strs, a, λ _ => Sel::read_at(tys, strs, qp ++ a, Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob)), Sel::read_at(tys, strs, qp, ob))) ∧
     (((Sel::read_at(tys, strs, qp, Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob))).code = (Sel::read_at(tys, strs, qp, ob)).code) ∧
      (Dyn::len(tys, strs, Sel::read_at(tys, strs, qp, Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, qp, ob)))))
{
    let b2 = Sel::write_at(tys, strs, qp ++ (a ++ t), g, ob);
    let x = Sel::read_at(tys, strs, qp, ob);
    let fp = Bool::and_true_parts(Sel::fit(tys, strs, qp, ob), Sel::fit(tys, strs, a, x), trans(sym(Sel::fit_append(tys, strs, qp, a, ob)), fqa));
    let rax: (Sel::read_at(tys, strs, qp ++ a, ob) = Sel::read_at(tys, strs, a, x)) = Sel::read_append(tys, strs, qp, a, ob);
    let rat: (Sel::read_at(tys, strs, a ++ t, x) = Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, a, x))) = Sel::read_append(tys, strs, a, t, x);
    let hc1: ((g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, a, x)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, a, x))).code) =
        j(rax, λ q _ => (g(Sel::read_at(tys, strs, t, q))).code = (Sel::read_at(tys, strs, t, q)).code, hc);
    let hl1: (Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, a, x)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, a, x)))) =
        j(rax, λ q _ => Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, q))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, q)), hl);
    let h = λ (y: Dyn(tys)) => Sel::write_at(tys, strs, t, g, y);
    let k = λ (y: Dyn(tys)) => Sel::write_at(tys, strs, a ++ t, g, y);
    let wkt = Sel::write_keeps(tys, strs, sl, g, t, Sel::read_at(tys, strs, a, x), hc1, hl1);
    let wka = Sel::write_keeps(tys, strs, sl, g, a ++ t, x, j(sym(rat), λ q _ => (g(q)).code = q.code, hc1), j(sym(rat), λ q _ => Dyn::len(tys, strs, g(q)) = Dyn::len(tys, strs, q), hl1));
    let wa1: (b2 = Sel::write_at(tys, strs, qp, k, ob)) = Sel::write_append(tys, strs, qp, a ++ t, g, ob);
    let wg1 = Sel::write_get(tys, strs, sl, k, qp, ob, fp.left, wka.left, wka.right);
    let rq: (Sel::read_at(tys, strs, qp, b2) = k(x)) = trans(cong_fn(λ (q: Dyn(tys)) => Sel::read_at(tys, strs, qp, q), wa1), wg1.right);
    let wa2: (k(x) = Sel::write_at(tys, strs, a, h, x)) = Sel::write_append(tys, strs, a, t, g, x);
    let wg2 = Sel::write_get(tys, strs, sl, h, a, x, fp.right, wkt.left, wkt.right);
    let rqa: (Sel::read_at(tys, strs, qp ++ a, b2) = h(Sel::read_at(tys, strs, a, x))) =
        trans(Sel::read_append(tys, strs, qp, a, b2), trans(cong_fn(λ (q: Dyn(tys)) => Sel::read_at(tys, strs, a, q), trans(rq, wa2)), wg2.right));
    let back: (Sel::write_at(tys, strs, a, λ _ => Sel::read_at(tys, strs, qp ++ a, b2), x) = Sel::write_at(tys, strs, a, h, x)) =
        Sel::write_read(tys, strs, sl, a, λ _ => Sel::read_at(tys, strs, qp ++ a, b2), h, x, rqa);
    ⟨j(sym(wa1), λ q _ => Sel::fit(tys, strs, qp, q) = True, wg1.left),
     ⟨trans(rq, trans(wa2, sym(back))),
      ⟨trans(cong_fn(λ (q: Dyn(tys)) => q.code, rq), wka.left), trans(cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), rq), wka.right)⟩⟩⟩
}

theorem Value::refers_inv(tys: Nat → Type, v: Value(tys), h: Value::refers(tys, v) = True): Exists<Ref>(λ q => v = Refer(q)) {
    (match v as λ u => Value::refers(tys, u) = True → Exists<Ref>(λ q => u = Refer(q)) { Plain(_) => λ no => absurd(no), Refer(q) => λ _ => Exists(q, refl) })(h)
}

theorem VEnt::foldr_member(self es: List<VEnt>, f: VEnt → List<Nat>, k: Nat): k.member(es.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil)) = True →
    Exists<VEnt>(λ pe => Mem(pe, es) ∧ (k.member(f(pe)) = True))
{
    match es {
        Nil => λ no => absurd(no),
        Cons(e0, rest) => λ h => match k.member_app_or(f(e0), rest.foldr(λ (q: VEnt) (acc: List<Nat>) => f(q) ++ acc, Nil), h) {
            Inl(h1) => Exists(e0, ⟨Inl(refl), h1⟩),
            Inr(h2) => match VEnt::foldr_member(rest, f, k, h2) { ⟨pe, pp⟩ => Exists(pe, ⟨Inr(pp.left), pp.right⟩) },
        },
    }
}

// Every ancestor of a live entry is below its level.
theorem CSt::anc_below(self f: Nat, s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl): (e: VEnt) → Mem(e, s.views) → (k: Nat) → k.member(s.anc_of(e, f)) = True → k < e.lvl {
    match f {
        Zero => λ e _ k no => absurd(no),
        Succ(f1) => λ e me k h => (match e.par.same(e.lvl) as λ c => (match c as λ _ => List<Nat> { True => Nil<Nat>(), False => Cons(e.par, (s.ents(e.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, f1) ++ acc, Nil)) }) = s.anc_of(e, Succ(f1)) → k < e.lvl {
            True => λ eq => absurd(trans(sym(h), sym(cong_fn(λ (q: List<Nat>) => k.member(q), eq)))),
            False => λ eq => {
                let h1: (k.member(Cons(e.par, (s.ents(e.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, f1) ++ acc, Nil))) = True) = trans(cong_fn(λ (q: List<Nat>) => k.member(q), eq), h);
                match Bool::or_true_parts(e.par.same(k), k.member((s.ents(e.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, f1) ++ acc, Nil)), h1) {
                    Inl(ek) => j(e.par.same_sound(k, ek), λ q _ => q < e.lvl, lt(e, me)),
                    Inr(hr) => match VEnt::foldr_member(s.ents(e.par), λ pe => s.anc_of(pe, f1), k, hr) {
                        ⟨pe, pp⟩ => {
                            let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), pp.left);
                            let pl: (pe.lvl = e.par) = pe.lvl.same_sound(e.par, s.views.mem_filter_holds(pe, λ q => q.lvl.same(e.par), pp.left));
                            let below = CSt::anc_below(f1, s, lt, pe, mv, k, pp.right);
                            omega(below, pl, lt(e, me))
                        },
                    },
                }
            },
        })(refl),
    }
}

// The chain of a live entry reaches a holder of its object.
theorem CSt::anc_holder(self f: Nat, s: CSt, ch: (en: VEnt) → Mem(en, s.views) → (en.par < en.lvl) ∧ s.Parent(en)): (e: VEnt) → Mem(e, s.views) → e.lvl <= f →
    Exists<Nat>(λ k => (k.member(s.anc_of(e, f)) = True) ∧ Exists<Acc>(λ a => s.role(k) = KHold(e.obj, a)))
{
    match f {
        Zero => λ e me le => false_elim(Nat::not_succ_le_zero(e.par, omega((ch(e, me)).left, le))),
        Succ(f1) => λ e me le => {
            let cc = ch(e, me);
            let ne: ¬(e.par = e.lvl) = λ eq => Nat::lt_irrefl(e.par, omega(cc.left, eq));
            let st = s.anc_step(e, f1, ne);
            let tl = (s.ents(e.par)).foldr(λ (pe: VEnt) (acc: List<Nat>) => s.anc_of(pe, f1) ++ acc, Nil);
            let hd: (e.par.member(s.anc_of(e, Succ(f1))) = True) = j(sym(st), λ q _ => e.par.member(q) = True, j(sym(e.par.same_self()), λ c _ => (c || e.par.member(tl)) = True, refl));
            (match s.role(e.par) as λ r => s.role(e.par) = r → (match r { KHold(o, _) => (o = e.obj) ∧ (e.reg = e.at), KView => VEnt::Any(s.ents(e.par), λ pe => (pe.obj = e.obj) ∧ (e.reg = pe.reg ++ e.at)),
                    KPlain => False, KGone => False }) → Exists<Nat>(λ k => (k.member(s.anc_of(e, Succ(f1))) = True) ∧ Exists<Acc>(λ a => s.role(k) = KHold(e.obj, a))) {
                KHold(o, a) => λ er p => Exists(e.par, ⟨hd, Exists(a, j(p.left, λ q _ => s.role(e.par) = KHold(q, a), er))⟩),
                KView => λ _ p => match VEnt::any_mem(s.ents(e.par), λ pe => (pe.obj = e.obj) ∧ (e.reg = pe.reg ++ e.at), p) {
                    ⟨pe, pp⟩ => {
                        let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), pp.left);
                        let pl: (pe.lvl = e.par) = pe.lvl.same_sound(e.par, s.views.mem_filter_holds(pe, λ q => q.lvl.same(e.par), pp.left));
                        match CSt::anc_holder(f1, s, ch, pe, mv, omega(pl, cc.left, le)) {
                            ⟨k, pk⟩ => {
                                let inl: (k.member(tl) = True) = VEnt::member_foldr(s.ents(e.par), λ q => s.anc_of(q, f1), k, pe, pp.left, pk.left);
                                let inn: (k.member(s.anc_of(e, Succ(f1))) = True) = j(sym(st), λ q _ => k.member(q) = True, j(sym(inl), λ c _ => (e.par.same(k) || c) = True, Bool::or_true_right(e.par.same(k))));
                                match pk.right { ⟨a, pa⟩ => Exists(k, ⟨inn, Exists(a, j(pp.right.left, λ q _ => s.role(k) = KHold(q, a), pa))⟩) }
                            },
                        }
                    },
                },
                KPlain => λ _ no => false_elim(no),
                KGone => λ _ no => false_elim(no),
            })(refl, cc.right)
        },
    }
}

theorem CSt::up_nil(self f: Nat, s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), c: Nat, h: s.ents(c) = Nil): s.up(tys, strs, e, c, f) = e {
    match f {
        Zero => refl,
        Succ(f1) => j(sym(h), λ es _ => (match es as λ _ => Env(tys) { Nil => e, Cons(en, _) => match en.par.same(c) as λ _ => Env(tys) { True => e,
            False => s.up(tys, strs, Env::set(tys, e, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(en.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), en.par, f1) } }) = e, refl),
    }
}

theorem CSt::up_step(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), c, f1: Nat, x: VEnt, rest: List<VEnt>, h: s.ents(c) = Cons(x, rest), np: x.par.same(c) = False):
    s.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), x.par, f1)
{
    let br = λ (es: List<VEnt>) => match es as λ _ => Env(tys) { Nil => e, Cons(en, _) => match en.par.same(c) as λ _ => Env(tys) { True => e,
        False => s.up(tys, strs, Env::set(tys, e, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(en.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), en.par, f1) } };
    let goal = s.up(tys, strs, Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), x.par, f1);
    trans(cong_fn(br, h), j(sym(np), λ b _ => (match b as λ _ => Env(tys) { True => e, False => goal }) = goal, refl))
}

// A holder has no entries: every live entry is a view's.
theorem CSt::ents_hold_nil(self s: CSt, vents: (en: VEnt) → Mem(en, s.views) → s.role(en.lvl) = KView, p, o: Nat, a: Acc, hr: s.role(p) = KHold(o, a)): s.ents(p) = Nil {
    (match s.ents(p) as λ es => s.ents(p) = es → es = Nil {
        Nil => λ _ => refl,
        Cons(x, _) => λ h => {
            let mx: Mem(x, s.ents(p)) = j(sym(h), λ es _ => Mem(x, es), Inl(refl));
            let xl: (x.lvl = p) = x.lvl.same_sound(p, s.views.mem_filter_holds(x, λ q => q.lvl.same(p), mx));
            absurd(trans(sym(j(xl, λ q _ => s.role(q) = KView, vents(x, s.views.mem_filter(x, λ q => q.lvl.same(p), mx)))), hr))
        },
    })(refl)
}

// The ancestors of an entry whose parent is a view with one entry: the
// parent, and that entry's.
theorem CSt::anc_mem_view(self s: CSt, lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl, en: VEnt, below: en.lvl < s.na + s.nd, ne: ¬(en.par = en.lvl),
    pe: VEnt, h: s.ents(en.par) = [pe], mpe: Mem(pe, s.views), pl: pe.lvl = en.par, plt: en.par < en.lvl, k: Nat):
    k.member(s.anc_of(en, s.na + s.nd)) = (en.par.same(k) || k.member(s.anc_of(pe, s.na + s.nd)))
{
    let f1 = s.na + s.nd - 1;
    let fe: (s.na + s.nd = Succ(f1)) = omega(below);
    let st = s.anc_step(en, f1, ne);
    let tl: ((s.ents(en.par)).foldr(λ (q: VEnt) (acc: List<Nat>) => s.anc_of(q, f1) ++ acc, Nil) = s.anc_of(pe, f1)) =
        trans(cong_fn(λ (es: List<VEnt>) => es.foldr(λ (q: VEnt) (acc: List<Nat>) => s.anc_of(q, f1) ++ acc, Nil), h), List::append_nil(s.anc_of(pe, f1)));
    let mo: (s.anc_of(pe, f1) = s.anc_of(pe, s.na + s.nd)) = trans(CSt::anc_more(f1, s, lt, pe, mpe, omega(pl, plt, below, fe)), cong_fn(λ (n: Nat) => s.anc_of(pe, n), sym(fe)));
    trans(cong_fn(λ (n: Nat) => k.member(s.anc_of(en, n)), fe),
        trans(cong_fn(λ (q: List<Nat>) => k.member(q), st), cong_fn(λ (q: List<Nat>) => en.par.same(k) || k.member(q), trans(tl, mo))))
}

theorem CSt::anc_mem_hold(self s: CSt, en: VEnt, below: en.lvl < s.na + s.nd, ne: ¬(en.par = en.lvl), h: s.ents(en.par) = Nil, k: Nat):
    k.member(s.anc_of(en, s.na + s.nd)) = (en.par.same(k) || False)
{
    let f1 = s.na + s.nd - 1;
    let fe: (s.na + s.nd = Succ(f1)) = omega(below);
    trans(cong_fn(λ (n: Nat) => k.member(s.anc_of(en, n)), fe),
        trans(cong_fn(λ (q: List<Nat>) => k.member(q), s.anc_step(en, f1, ne)),
            cong_fn(λ (es: List<VEnt>) => en.par.same(k) || k.member(es.foldr(λ (q: VEnt) (acc: List<Nat>) => s.anc_of(q, f1) ++ acc, Nil)), h)))
}

// One step of the walk: the parent's reference, which the child's extends
// by `a`, reads after the write what it read with what the child reads now
// written at `a`.
theorem CSt::up_core(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), h, h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys),
    hv: Heap::val(tys, strs, h, blk) = Some(ob), hv2: Heap::val(tys, strs, h2, blk) = Some(b2), qp, qc: Ref, a, t: List<Sel>, qb: qp.b = blk, qcb: qc.b = qp.b, qcs: qc.sels = qp.sels ++ a,
    hb: b2 = Sel::write_at(tys, strs, qc.sels ++ t, g, ob), hqf: Sel::fit(tys, strs, qc.sels, ob) = True,
    hc: (g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))).code,
    hl: Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))),
    dc, dp: Dyn(tys), agc: Value::Reads(tys, strs, h2, Refer(qc), dc), agp: Value::Reads(tys, strs, h, Refer(qp), dp)):
    (Value::Reads(tys, strs, h2, Refer(qp), Sel::write_at(tys, strs, a, λ _ => dc, dp))) ∧ ((Sel::write_at(tys, strs, a, λ _ => dc, dp)).code = dp.code) ∧
        (Sel::fit(tys, strs, qp.sels, ob) = True)
{
    let qs = qp.sels;
    match Value::refer_inv(tys, strs, h, qp, dp, agp) {
        ⟨op, pp⟩ => match Value::refer_inv(tys, strs, h2, qc, dc, agc) {
            ⟨oc, pc⟩ => {
                let opo: (op = ob) = Option::some_inj(op, ob, trans(sym(pp.left), j(sym(qb), λ b _ => Heap::val(tys, strs, h, b) = Some(ob), hv)));
                let ocb: (oc = b2) = Option::some_inj(oc, b2, trans(sym(pc.left), j(sym(trans(qcb, qb)), λ b _ => Heap::val(tys, strs, h2, b) = Some(b2), hv2)));
                let fpo: (Sel::fit(tys, strs, qs, ob) = True) = j(opo, λ o _ => Sel::fit(tys, strs, qs, o) = True, pp.right.left);
                let rpo: (Sel::read_at(tys, strs, qs, ob) = dp) = j(opo, λ o _ => Sel::read_at(tys, strs, qs, o) = dp, pp.right.right);
                let rcb: (Sel::read_at(tys, strs, qs ++ a, b2) = dc) = j(qcs, λ q _ => Sel::read_at(tys, strs, q, b2) = dc, j(ocb, λ o _ => Sel::read_at(tys, strs, qc.sels, o) = dc, pc.right.right));
                let rq = Sel::read_under(tys, strs, sl, qs, a, t, g, ob, j(qcs, λ q _ => Sel::fit(tys, strs, q, ob) = True, hqf),
                    j(qcs, λ q _ => (g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, q, ob)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, q, ob))).code, hc),
                    j(qcs, λ q _ => Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, q, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, q, ob))), hl));
                let hb3: (b2 = Sel::write_at(tys, strs, qs ++ (a ++ t), g, ob)) =
                    trans(hb, trans(cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q ++ t, g, ob), qcs), cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q, g, ob), List::append_assoc(qs, a, t))));
                let w: Dyn(tys) = Sel::write_at(tys, strs, a, λ _ => dc, dp);
                let rqb: (Sel::read_at(tys, strs, qs, b2) = w) = j(sym(hb3), λ bb _ => Sel::read_at(tys, strs, qs, bb) = Sel::write_at(tys, strs, a, λ _ => dc, dp),
                    trans(rq.right.left, trans(cong_fn(λ (x: Dyn(tys)) => Sel::write_at(tys, strs, a, λ _ => x, Sel::read_at(tys, strs, qs, ob)), j(hb3, λ bb _ => Sel::read_at(tys, strs, qs ++ a, bb) = dc, rcb)),
                        cong_fn(λ (x: Dyn(tys)) => Sel::write_at(tys, strs, a, λ _ => dc, x), rpo))));
                let fqb: (Sel::fit(tys, strs, qs, b2) = True) = j(sym(hb3), λ bb _ => Sel::fit(tys, strs, qs, bb) = True, rq.left);
                let rd = λ (o: Option<Dyn(tys)>) => match o { Some(d) => Sel::get(tys, strs, qs ++ Nil, d), None => None<Dyn(tys)>() };
                let reads: (Value::get(tys, strs, h2, Refer(qp), Nil) = Some(w)) =
                    trans(cong_fn(rd, j(sym(qb), λ b _ => Heap::val(tys, strs, h2, b) = Some(b2), hv2)),
                        trans(cong_fn(λ (q: List<Sel>) => Sel::get(tys, strs, q, b2), List::append_nil(qs)), trans(Sel::get_fit(tys, strs, qs, b2, fqb), cong_fn(λ (x: Dyn(tys)) => Some(x), rqb))));
                let code: (w.code = dp.code) = trans(cong_fn(λ (x: Dyn(tys)) => x.code, sym(rqb)), trans(j(sym(hb3), λ bb _ => (Sel::read_at(tys, strs, qs, bb)).code = (Sel::read_at(tys, strs, qs, ob)).code, rq.right.right.left), cong_fn(λ (x: Dyn(tys)) => x.code, rpo)));
                ⟨reads, ⟨code, fpo⟩⟩
            },
        },
    }
}

// The words an entry's place reads, in a meaning that agrees with `e` at
// every level a region reads: the run's.
theorem CSt::at_words(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, ee: Env(tys), hwd: (k: Nat) → s.in_regions(k) = True → Env::get(tys, ee, s.var_at(k)) = Env::get(tys, e, s.var_at(k)),
    hla: ee.args.len() = s.na, hlo: ee.locs.len() = s.nd, en: VEnt, mem: Mem(en, s.views)):
    Steps::sels(s.unsteps(en.at), Env::ixs(tys, ee)) = Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m))
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    CSt::sels_keep(en.at, s, Env::ixs(tys, ee), s, Mach::ixs(tys, strs, m), λ k mk => {
        let ir: (s.in_regions(k) = True) = s.views.any_bit_mem(λ x => k.member(Steps::lvls(x.reg)) || k.member(Steps::lvls(x.at)), en, mem,
            j(sym(mk), λ b _ => (k.member(Steps::lvls(en.reg)) || b) = True, Bool::or_true_right(k.member(Steps::lvls(en.reg)))));
        let wd = inv.words(k, ir);
        trans(s.env_ix(tys, ee, hla, hlo, k, wd.left),
            trans(cong_fn(λ (d: Dyn(tys)) => Some(Dyn::ix(tys, d)), hwd(k, ir)),
                trans(sym(s.env_ix(tys, e, sim.eargs, sim.elocs, k, wd.left)), sym(Sim::lvl_ix(tys, strs, sim, k, wd.left, wd.right)))))
    })
}

// The walk's step at a parent: what its reference reads after the write is
// the meaning the walk writes into it.
theorem CSt::up_parent(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys),
    hv: Heap::val(tys, strs, m.heap, blk) = Some(ob), hv2: Heap::val(tys, strs, h2, blk) = Some(b2),
    c: Nat, ee: Env(tys), en: VEnt, mem: Mem(en, s.views), qc, qp: Ref, t: List<Sel>, qb: qc.b = blk, qf: Sel::fit(tys, strs, qc.sels, ob) = True,
    hb: b2 = Sel::write_at(tys, strs, qc.sels ++ t, g, ob),
    hc: (g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))).code,
    hl: Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))),
    agc: Value::Reads(tys, strs, h2, Refer(qc), Env::get(tys, ee, s.var_at(c))),
    hop: Env::get(tys, ee, s.var_at(en.par)) = Env::get(tys, e, s.var_at(en.par)),
    hwd: (k: Nat) → s.in_regions(k) = True → Env::get(tys, ee, s.var_at(k)) = Env::get(tys, e, s.var_at(k)),
    hla: ee.args.len() = s.na, hlo: ee.locs.len() = s.nd,
    qce: qc = qp.narrow(Mach::ixs(tys, strs, m), s.unsteps(en.at)),
    agp: Value::Reads(tys, strs, m.heap, Refer(qp), Env::get(tys, e, s.var_at(en.par)))):
    (Value::Reads(tys, strs, h2, Refer(qp), Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), Env::get(tys, ee, s.var_at(en.par))))) ∧
    (((Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), Env::get(tys, ee, s.var_at(en.par)))).code = (Env::get(tys, e, s.var_at(en.par))).code) ∧
     (Sel::fit(tys, strs, qp.sels, ob) = True))
{
    let ws = Mach::ixs(tys, strs, m);
    let a = Steps::sels(s.unsteps(en.at), ws);
    let dc = Env::get(tys, ee, s.var_at(c));
    let dp = Env::get(tys, e, s.var_at(en.par));
    let wds: (Steps::sels(s.unsteps(en.at), Env::ixs(tys, ee)) = a) = CSt::at_words(tys, strs, inv, none, ee, hwd, hla, hlo, en, mem);
    let wv: (Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => dc, Env::get(tys, ee, s.var_at(en.par))) = Sel::write_at(tys, strs, a, λ _ => dc, dp)) =
        trans(Steps::write_sels(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => dc, Env::get(tys, ee, s.var_at(en.par))),
            trans(cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q, λ _ => dc, Env::get(tys, ee, s.var_at(en.par))), wds), cong_fn(λ (d: Dyn(tys)) => Sel::write_at(tys, strs, a, λ _ => dc, d), hop)));
    let qcb: (qc.b = qp.b) = cong_fn(λ (z: Ref) => z.b, qce);
    let qcs: (qc.sels = qp.sels ++ a) = cong_fn(λ (z: Ref) => z.sels, qce);
    let core = CSt::up_core(tys, strs, sl, m.heap, h2, blk, ob, b2, g, hv, hv2, qp, qc, a, t, trans(sym(qcb), qb), qcb, qcs, hb, qf, hc, hl, dc, dp, agc, agp);
    ⟨j(sym(wv), λ d _ => Value::Reads(tys, strs, h2, Refer(qp), d), core.left), ⟨trans(cong_fn(λ (d: Dyn(tys)) => d.code, wv), core.right.left), core.right.right⟩⟩
}

// What the walk knows at a view `c` of the pending chain, its meaning so far
// `ee`: its entry, its reference into the stored block and the write below
// it, every variable not an ancestor agreeing, the ancestors and the words
// regions read as they were.
record UpAt(tys: Nat → Type, strs: Strs(tys), s: CSt, e: Env(tys), m: Mach(tys), h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys), c: Nat, ee: Env(tys), en: VEnt, qc: Ref, t: List<Sel>) {
    he: s.ents(c) = [en],
    mem: Mem(en, s.views),
    w: en.mode.writes() = True,
    hq: (REnv::get(tys, m.env, s.var_at(c))).v = Refer(qc),
    qb: qc.b = blk,
    qf: Sel::fit(tys, strs, qc.sels, ob) = True,
    hb: b2 = Sel::write_at(tys, strs, qc.sels ++ t, g, ob),
    hc: (g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))).code = (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))).code,
    hl: Dyn::len(tys, strs, g(Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob))),
    hv: (y: Var) → (k: Nat) → s.lvl(y) = Some(k) → k.member(s.anc_of(en, s.na + s.nd)) = False → Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, y), Env::get(tys, ee, y)),
    ho: (k: Nat) → k.member(s.anc_of(en, s.na + s.nd)) = True → Env::get(tys, ee, s.var_at(k)) = Env::get(tys, e, s.var_at(k)),
    hwd: (k: Nat) → s.in_regions(k) = True → Env::get(tys, ee, s.var_at(k)) = Env::get(tys, e, s.var_at(k)),
    hcd: (y: Var) → (k: Nat) → s.lvl(y) = Some(k) → (Env::get(tys, ee, y)).code = (s.var(k)).code,
    hla: ee.args.len() = s.na,
    hlo: ee.locs.len() = s.nd,
}

theorem UpAt::lvl(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h2: Heap(tys)}, {blk: Nat}, {ob, b2: Dyn(tys)}, {g: Dyn(tys) → Dyn(tys)}, {c: Nat}, {ee: Env(tys)}, {en: VEnt}, {qc: Ref}, {t: List<Sel>},
    self u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t)): en.lvl = c
{
    en.lvl.same_sound(c, s.views.mem_filter_holds(en, λ q => q.lvl.same(c), j(sym(u.he), λ es _ => Mem(en, es), Inl(refl))))
}

// The view itself reads its meaning so far.
theorem UpAt::agc(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {h2: Heap(tys)}, {blk: Nat}, {ob, b2: Dyn(tys)}, {g: Dyn(tys) → Dyn(tys)}, {c: Nat}, {ee: Env(tys)}, {en: VEnt}, {qc: Ref}, {t: List<Sel>},
    u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t)): Value::Reads(tys, strs, h2, Refer(qc), Env::get(tys, ee, s.var_at(c)))
{
    let nl = s.na + s.nd;
    let lc = UpAt::lvl(tys, strs, u);
    let vv = inv.vents(en, u.mem);
    let cb: (c < nl) = j(lc, λ n _ => n < nl, vv.right.left);
    let hxc = s.lvl_var_at(c, cb);
    let nc: (c.member(s.anc_of(en, nl)) = False) = Bool::false_of_not(c.member(s.anc_of(en, nl)),
        λ h => Nat::lt_irrefl(c, j(lc, λ n _ => c < n, CSt::anc_below(nl, s, λ x mx => (inv.chain(x, mx)).left, en, u.mem, c, h))));
    let rvc: (s.role(c) = KView) = j(lc, λ n _ => s.role(n) = KView, vv.right.right);
    let ag = j(rvc, λ rr _ => Cell::Agrees(tys, strs, h2, rr, REnv::get(tys, m.env, s.var_at(c)), Env::get(tys, ee, s.var_at(c))), u.hv(s.var_at(c), c, hxc, nc));
    j(u.hq, λ v _ => Value::Reads(tys, strs, h2, v, Env::get(tys, ee, s.var_at(c))), ag)
}

// The view's reference: its object's root narrowed by its entry's region.
theorem UpAt::qroot(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {h2: Heap(tys)}, {blk: Nat}, {ob, b2: Dyn(tys)}, {g: Dyn(tys) → Dyn(tys)}, {c: Nat}, {ee: Env(tys)}, {en: VEnt}, {qc: Ref}, {t: List<Sel>},
    u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t)):
    Exists<Ref>(λ r0 => (inv.root(en.obj) = Some(r0)) ∧ (r0.narrow(Mach::ixs(tys, strs, m), s.unsteps(en.reg)) = qc))
{
    let ws = Mach::ixs(tys, strs, m);
    let nl = s.na + s.nd;
    let lc = UpAt::lvl(tys, strs, u);
    let vv = inv.vents(en, u.mem);
    let cb: (c < nl) = j(lc, λ n _ => n < nl, vv.right.left);
    let rvc: (s.role(c) = KView) = j(lc, λ n _ => s.role(n) = KView, vv.right.right);
    let okc = inv.refs(s.var_at(c), c, s.lvl_var_at(c, cb), qc, u.hq);
    let anyc: VEnt::Any(s.ents(c), λ y => ((inv.root(y.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(y.reg))) = Some(qc))) =
        j(rvc, λ q _ => match q { KHold(o, _) => inv.root(o) = Some(qc), KView => VEnt::Any(s.ents(c), λ y => (inv.root(y.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(y.reg))) = Some(qc)),
            KPlain => False, KGone => True }, okc);
    let any1: VEnt::Any([en], λ y => ((inv.root(y.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(y.reg))) = Some(qc))) =
        j(u.he, λ es _ => VEnt::Any(es, λ y => (inv.root(y.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(y.reg))) = Some(qc)), anyc);
    let h1: ((inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qc)) = match any1 { Inl(x) => x, Inr(no) => false_elim(no) };
    match Option::map_some_inv(inv.root(en.obj), λ r0 => r0.narrow(ws, s.unsteps(en.reg)), qc, h1) { ⟨r0, pr⟩ => Exists(r0, ⟨pr.left, pr.right⟩) }
}

// The parent's cell refers: the chain refers throughout.
theorem UpAt::par_ref(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {h2: Heap(tys)}, {blk: Nat}, {ob, b2: Dyn(tys)}, {g: Dyn(tys) → Dyn(tys)}, {c: Nat}, {ee: Env(tys)}, {en: VEnt}, {qc: Ref}, {t: List<Sel>},
    u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t)): Exists<Ref>(λ qp => (REnv::get(tys, m.env, s.var_at(en.par))).v = Refer(qp))
{
    let nl = s.na + s.nd;
    let lc = UpAt::lvl(tys, strs, u);
    let vv = inv.vents(en, u.mem);
    let cc = inv.chain(en, u.mem);
    let cb: (c < nl) = j(lc, λ n _ => n < nl, vv.right.left);
    let pb: (en.par < nl) = omega(cc.left, vv.right.left);
    let un = inv.uni(en, u.mem, s.var_at(c), s.var_at(en.par), j(sym(lc), λ n _ => s.lvl(s.var_at(c)) = Some(n), s.lvl_var_at(c, cb)), s.lvl_var_at(en.par, pb));
    Value::refers_inv(tys, (REnv::get(tys, m.env, s.var_at(en.par))).v, trans(sym(un), cong_fn(λ (v: Value(tys)) => Value::refers(tys, v), u.hq)))
}

// The walk's last step, at the chain's holder: every variable agrees.
theorem CSt::up_last(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys),
    hv: Heap::val(tys, strs, m.heap, blk) = Some(ob), hv2: Heap::val(tys, strs, h2, blk) = Some(b2),
    c: Nat, ee: Env(tys), en: VEnt, qc: Ref, t: List<Sel>, u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t), o2: Nat, a2: Acc, rh: s.role(en.par) = KHold(o2, a2)):
    Sim(tys, strs, s, Env::set(tys, ee, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), d)), Mach(h2, m.env, m.io))
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ws = Mach::ixs(tys, strs, m);
    let nl = s.na + s.nd;
    let p = en.par;
    let cc = inv.chain(en, u.mem);
    let vv = inv.vents(en, u.mem);
    let pb: (p < nl) = omega(cc.left, vv.right.left);
    let ne: ¬(en.par = en.lvl) = λ eq => Nat::lt_irrefl(en.par, omega(cc.left, eq));
    let hxp = s.lvl_var_at(p, pb);
    let par: ((o2 = en.obj) ∧ (en.reg = en.at)) = j(rh, λ q _ => match q { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
        KView => VEnt::Any(s.ents(p), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False }, cc.right);
    let ehn: (s.ents(p) = Nil) = s.ents_hold_nil(λ x mx => (inv.vents(x, mx)).right.right, p, o2, a2, rh);
    let fw = λ (d: Dyn(tys)) => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), d);
    let e1 = Env::set(tys, ee, s.var_at(p), fw);
    match UpAt::par_ref(tys, strs, inv, u) {
        ⟨qp, hqp⟩ => match UpAt::qroot(tys, strs, inv, u) {
            ⟨r0, pr⟩ => {
                let okp = inv.refs(s.var_at(p), p, hxp, qp, hqp);
                let rtp: (inv.root(o2) = Some(qp)) = j(rh, λ q _ => match q { KHold(o, _) => inv.root(o) = Some(qp),
                    KView => VEnt::Any(s.ents(p), λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(y.reg))) = Some(qp))), KPlain => False, KGone => True }, okp);
                let r0q: (r0 = qp) = Option::some_inj(r0, qp, trans(sym(pr.left), trans(cong_fn(λ (z: Nat) => inv.root(z), sym(par.left)), rtp)));
                let qce: (qc = qp.narrow(ws, s.unsteps(en.at))) = trans(sym(pr.right),
                    trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, s.unsteps(xs)), par.right), cong_fn(λ (z: Ref) => z.narrow(ws, s.unsteps(en.at)), r0q)));
                let inp: (p.member(s.anc_of(en, nl)) = True) = trans(s.anc_mem_hold(en, vv.right.left, ne, ehn, p), cong_fn(λ (b: Bool) => b || False, p.same_self()));
                let agp: Value::Reads(tys, strs, m.heap, Refer(qp), Env::get(tys, e, s.var_at(p))) = j(hqp, λ v _ => Value::Reads(tys, strs, m.heap, v, Env::get(tys, e, s.var_at(p))),
                    j(rh, λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e, s.var_at(p))), sim.vars(s.var_at(p), p, hxp)));
                let core = CSt::up_parent(tys, strs, sl, inv, none, h2, blk, ob, b2, g, hv, hv2, c, ee, en, u.mem, qc, qp, t, u.qb, u.qf, u.hb, u.hc, u.hl, UpAt::agc(tys, strs, inv, u),
                    u.ho(p, inp), u.hwd, u.hla, u.hlo, qce, agp);
                let rin = s.var_inside(s.var_at(p), p, hxp);
                let ein: Var::In(s.var_at(p), ee.args.len(), ee.locs.len()) = j(sym(u.hlo), λ q _ => Var::In(s.var_at(p), ee.args.len(), q), j(sym(u.hla), λ q _ => Var::In(s.var_at(p), q, s.nd), rin));
                let e1p: (Env::get(tys, e1, s.var_at(p)) = fw(Env::get(tys, ee, s.var_at(p)))) = Env::get_set_same(tys, ee, s.var_at(p), fw, ein);
                let other = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (kne: ¬(k = p)) => λ (eq: s.var_at(p) = y) => s.var_ne(y, s.var_at(p), k, p, hy, hxp, kne)(sym(eq));
                let isp = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (eq: k = p) => trans(sym(s.lvl_var(y, k, hy)), cong_fn(λ (q: Nat) => s.var_at(q), eq));
                let notanc = λ (k: Nat) (kne: ¬(k = p)) => trans(s.anc_mem_hold(en, vv.right.left, ne, ehn, k), cong_fn(λ (b: Bool) => b || False, Nat::same_false(p, k, λ eq => kne(sym(eq)))));
                Sim(trans(Env::set_args(tys, ee, s.var_at(p), fw), u.hla), sim.margs, trans(Env::set_locs(tys, ee, s.var_at(p), fw), u.hlo), sim.mlocs,
                    λ y k hy => match Nat::eq_or_ne(k, p) {
                        Inl(eq) => j(sym(isp(y, k, hy, eq)), λ z _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, z), Env::get(tys, e1, z)),
                            j(sym(eq), λ q _ => Cell::Agrees(tys, strs, h2, s.role(q), REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e1, s.var_at(p))),
                                j(sym(rh), λ rr _ => Cell::Agrees(tys, strs, h2, rr, REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e1, s.var_at(p))),
                                    j(sym(hqp), λ v _ => Value::Reads(tys, strs, h2, v, Env::get(tys, e1, s.var_at(p))),
                                        j(sym(e1p), λ d _ => Value::Reads(tys, strs, h2, Refer(qp), d), core.left))))),
                        Inr(kne) => j(sym(Env::get_set_other(tys, ee, s.var_at(p), y, fw, other(y, k, hy, kne))), λ d _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, y), d),
                            u.hv(y, k, hy, notanc(k, kne))),
                    },
                    λ y k hy => match Nat::eq_or_ne(k, p) {
                        Inl(eq) => j(sym(isp(y, k, hy, eq)), λ z _ => (Env::get(tys, e1, z)).code = (s.var(k)).code,
                            trans(cong_fn(λ (d: Dyn(tys)) => d.code, e1p), trans(core.right.left, trans(sim.codes(s.var_at(p), p, hxp), cong_fn(λ (q: Nat) => (s.var(q)).code, sym(eq)))))),
                        Inr(kne) => trans(cong_fn(λ (d: Dyn(tys)) => d.code, Env::get_set_other(tys, ee, s.var_at(p), y, fw, other(y, k, hy, kne))), u.hcd(y, k, hy)),
                    })
            },
        },
    }
}

// The walk's step to a parent that is a view: what it knows there.
theorem CSt::up_next(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys),
    hv: Heap::val(tys, strs, m.heap, blk) = Some(ob), hv2: Heap::val(tys, strs, h2, blk) = Some(b2),
    c: Nat, ee: Env(tys), en: VEnt, qc: Ref, t: List<Sel>, u: UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t), rv: s.role(en.par) = KView):
    Exists<VEnt>(λ enp => Exists<Ref>(λ qp => UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, en.par,
        Env::set(tys, ee, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), d)), enp, qp,
        Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m)) ++ t)))
{
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ws = Mach::ixs(tys, strs, m);
    let nl = s.na + s.nd;
    let p = en.par;
    let a = Steps::sels(s.unsteps(en.at), ws);
    let lt = λ (x: VEnt) (mx: Mem(x, s.views)) => (inv.chain(x, mx)).left;
    let cc = inv.chain(en, u.mem);
    let vv = inv.vents(en, u.mem);
    let pb: (p < nl) = omega(cc.left, vv.right.left);
    let ne: ¬(en.par = en.lvl) = λ eq => Nat::lt_irrefl(en.par, omega(cc.left, eq));
    let hxp = s.lvl_var_at(p, pb);
    let fw = λ (d: Dyn(tys)) => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), d);
    let e1 = Env::set(tys, ee, s.var_at(p), fw);
    match inv.wpar(en, u.mem, u.w)(rv) {
        ⟨enp, pw⟩ => match UpAt::par_ref(tys, strs, inv, u) {
            ⟨qp, hqp⟩ => match UpAt::qroot(tys, strs, inv, u) {
                ⟨r0, pr⟩ => {
                    let hep = pw.left;
                    let mpe: Mem(enp, s.ents(p)) = j(sym(hep), λ es _ => Mem(enp, es), Inl(refl));
                    let menp: Mem(enp, s.views) = s.views.mem_filter(enp, λ q => q.lvl.same(p), mpe);
                    let lp: (enp.lvl = p) = enp.lvl.same_sound(p, s.views.mem_filter_holds(enp, λ q => q.lvl.same(p), mpe));
                    let okp = inv.refs(s.var_at(p), p, hxp, qp, hqp);
                    let anyp: VEnt::Any(s.ents(p), λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(y.reg))) = Some(qp))) =
                        j(rv, λ q _ => match q { KHold(o, _) => inv.root(o) = Some(qp), KView => VEnt::Any(s.ents(p), λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(y.reg))) = Some(qp))),
                            KPlain => False, KGone => True }, okp);
                    let any1: VEnt::Any([enp], λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(y.reg))) = Some(qp))) =
                        j(hep, λ es _ => VEnt::Any(es, λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(y.reg))) = Some(qp))), anyp);
                    let h1: ((inv.root(enp.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(enp.reg))) = Some(qp)) = match any1 { Inl(x) => x, Inr(no) => false_elim(no) };
                    let parv: VEnt::Any(s.ents(p), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)) = j(rv, λ q _ => match q { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
                        KView => VEnt::Any(s.ents(p), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False }, cc.right);
                    let par1: VEnt::Any([enp], λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)) = j(hep, λ es _ => VEnt::Any(es, λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), parv);
                    let pp: ((enp.obj = en.obj) ∧ (en.reg = enp.reg ++ en.at)) = match par1 { Inl(x) => x, Inr(no) => false_elim(no) };
                    match Option::map_some_inv(inv.root(enp.obj), λ r1 => r1.narrow(ws, s.unsteps(enp.reg)), qp, h1) {
                        ⟨r1, pr1⟩ => {
                            let r0r1: (r0 = r1) = Option::some_inj(r0, r1, trans(sym(pr.left), trans(cong_fn(λ (z: Nat) => inv.root(z), sym(pp.left)), pr1.left)));
                            let qce: (qc = qp.narrow(ws, s.unsteps(en.at))) = trans(sym(pr.right),
                                trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, s.unsteps(xs)), pp.right),
                                    trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, xs), s.unsteps_app(enp.reg, en.at)),
                                        trans(Ref::narrow_app(r0, ws, s.unsteps(enp.reg), s.unsteps(en.at)),
                                            cong_fn(λ (z: Ref) => z.narrow(ws, s.unsteps(en.at)), trans(cong_fn(λ (z: Ref) => z.narrow(ws, s.unsteps(enp.reg)), r0r1), pr1.right))))));
                            let mem_at = λ (k: Nat) => s.anc_mem_view(lt, en, vv.right.left, ne, enp, hep, menp, lp, cc.left, k);
                            let inp: (p.member(s.anc_of(en, nl)) = True) = trans(mem_at(p), cong_fn(λ (b: Bool) => b || p.member(s.anc_of(enp, nl)), p.same_self()));
                            let agp: Value::Reads(tys, strs, m.heap, Refer(qp), Env::get(tys, e, s.var_at(p))) = j(hqp, λ v _ => Value::Reads(tys, strs, m.heap, v, Env::get(tys, e, s.var_at(p))),
                                j(rv, λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e, s.var_at(p))), sim.vars(s.var_at(p), p, hxp)));
                            let core = CSt::up_parent(tys, strs, sl, inv, none, h2, blk, ob, b2, g, hv, hv2, c, ee, en, u.mem, qc, qp, t, u.qb, u.qf, u.hb, u.hc, u.hl, UpAt::agc(tys, strs, inv, u),
                                u.ho(p, inp), u.hwd, u.hla, u.hlo, qce, agp);
                            let qcb: (qc.b = qp.b) = cong_fn(λ (z: Ref) => z.b, qce);
                            let qcs: (qc.sels = qp.sels ++ a) = cong_fn(λ (z: Ref) => z.sels, qce);
                            let rin = s.var_inside(s.var_at(p), p, hxp);
                            let ein: Var::In(s.var_at(p), ee.args.len(), ee.locs.len()) = j(sym(u.hlo), λ q _ => Var::In(s.var_at(p), ee.args.len(), q), j(sym(u.hla), λ q _ => Var::In(s.var_at(p), q, s.nd), rin));
                            let e1p: (Env::get(tys, e1, s.var_at(p)) = fw(Env::get(tys, ee, s.var_at(p)))) = Env::get_set_same(tys, ee, s.var_at(p), fw, ein);
                            let other = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (kne: ¬(k = p)) => λ (eq: s.var_at(p) = y) => s.var_ne(y, s.var_at(p), k, p, hy, hxp, kne)(sym(eq));
                            let isp = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (eq: k = p) => trans(sym(s.lvl_var(y, k, hy)), cong_fn(λ (q: Nat) => s.var_at(q), eq));
                            let rr: (Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, qc.sels, ob)) = Sel::read_at(tys, strs, a ++ t, Sel::read_at(tys, strs, qp.sels, ob))) =
                                trans(cong_fn(λ (q: List<Sel>) => Sel::read_at(tys, strs, t, Sel::read_at(tys, strs, q, ob)), qcs),
                                    trans(cong_fn(λ (z: Dyn(tys)) => Sel::read_at(tys, strs, t, z), Sel::read_append(tys, strs, qp.sels, a, ob)), sym(Sel::read_append(tys, strs, a, t, Sel::read_at(tys, strs, qp.sels, ob)))));
                            Exists(enp, Exists(qp, UpAt(hep, menp, pw.right, hqp, trans(sym(qcb), u.qb), core.right.right,
                                trans(u.hb, trans(cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q ++ t, g, ob), qcs), cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q, g, ob), List::append_assoc(qp.sels, a, t)))),
                                j(rr, λ z _ => (g(z)).code = z.code, u.hc),
                                j(rr, λ z _ => Dyn::len(tys, strs, g(z)) = Dyn::len(tys, strs, z), u.hl),
                                λ y k hy nk => match Nat::eq_or_ne(k, p) {
                                    Inl(eq) => j(sym(isp(y, k, hy, eq)), λ z _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, z), Env::get(tys, e1, z)),
                                        j(sym(eq), λ q _ => Cell::Agrees(tys, strs, h2, s.role(q), REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e1, s.var_at(p))),
                                            j(sym(rv), λ rr0 _ => Cell::Agrees(tys, strs, h2, rr0, REnv::get(tys, m.env, s.var_at(p)), Env::get(tys, e1, s.var_at(p))),
                                                j(sym(hqp), λ v _ => Value::Reads(tys, strs, h2, v, Env::get(tys, e1, s.var_at(p))),
                                                    j(sym(e1p), λ d _ => Value::Reads(tys, strs, h2, Refer(qp), d), core.left))))),
                                    Inr(kne) => j(sym(Env::get_set_other(tys, ee, s.var_at(p), y, fw, other(y, k, hy, kne))), λ d _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, y), d),
                                        u.hv(y, k, hy, trans(mem_at(k), j(sym(Nat::same_false(p, k, λ eq => kne(sym(eq)))), λ b _ => (b || k.member(s.anc_of(enp, nl))) = False, nk)))),
                                },
                                λ k hk => {
                                    let kp: (k < p) = j(lp, λ n _ => k < n, CSt::anc_below(nl, s, lt, enp, menp, k, hk));
                                    let kne: ¬(k = p) = λ eq => Nat::lt_irrefl(k, omega(kp, eq));
                                    let hxk = s.lvl_var_at(k, omega(kp, pb));
                                    trans(Env::get_set_other(tys, ee, s.var_at(p), s.var_at(k), fw, other(s.var_at(k), k, hxk, kne)),
                                        u.ho(k, trans(mem_at(k), j(sym(hk), λ b _ => (p.same(k) || b) = True, Bool::or_true_right(p.same(k))))))
                                },
                                λ k ir => {
                                    let wd = inv.words(k, ir);
                                    let kne: ¬(k = p) = λ eq => absurd(trans(sym(wd.right), trans(cong_fn(λ (q: Nat) => (s.role(q)).plain(), eq), cong_fn(λ (r: Role) => r.plain(), rv))));
                                    trans(Env::get_set_other(tys, ee, s.var_at(p), s.var_at(k), fw, other(s.var_at(k), k, s.lvl_var_at(k, wd.left), kne)), u.hwd(k, ir))
                                },
                                λ y k hy => match Nat::eq_or_ne(k, p) {
                                    Inl(eq) => j(sym(isp(y, k, hy, eq)), λ z _ => (Env::get(tys, e1, z)).code = (s.var(k)).code,
                                        trans(cong_fn(λ (d: Dyn(tys)) => d.code, e1p), trans(core.right.left, trans(sim.codes(s.var_at(p), p, hxp), cong_fn(λ (q: Nat) => (s.var(q)).code, sym(eq)))))),
                                    Inr(kne) => trans(cong_fn(λ (d: Dyn(tys)) => d.code, Env::get_set_other(tys, ee, s.var_at(p), y, fw, other(y, k, hy, kne))), u.hcd(y, k, hy)),
                                },
                                trans(Env::set_args(tys, ee, s.var_at(p), fw), u.hla), trans(Env::set_locs(tys, ee, s.var_at(p), fw), u.hlo))))
                        },
                    }
                },
            },
        },
    }
}

// The walk: from a view of the pending chain up to its holder, every
// variable agrees with the meaning written up.
theorem CSt::up_sim(self f: Nat, tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    none: s.pending() = False, l: Nat, h2: Heap(tys), blk: Nat, ob, b2: Dyn(tys), g: Dyn(tys) → Dyn(tys),
    hv: Heap::val(tys, strs, m.heap, blk) = Some(ob), hv2: Heap::val(tys, strs, h2, blk) = Some(b2)):
    (c: Nat) → (ee: Env(tys)) → (en: VEnt) → (qc: Ref) → (t: List<Sel>) → c < f → UpAt(tys, strs, s, e, m, h2, blk, ob, b2, g, c, ee, en, qc, t) →
        Sim(tys, strs, s, (s.written(l).unback(l)).up(tys, strs, ee, c, f), Mach(h2, m.env, m.io))
{
    match f {
        Zero => λ c ee en qc t lt _ => false_elim(Nat::not_succ_le_zero(c, lt)),
        Succ(f1) => λ c ee en qc t lt u => {
            let s1 = s.written(l).unback(l);
            let m2: Mach(tys) = Mach(h2, m.env, m.io);
            let cc = inv.chain(en, u.mem);
            let lc = UpAt::lvl(tys, strs, u);
            let kin = en.unbacked_kin(l);
            let x = en.unbacked(l);
            let hx: (s1.ents(c) = Cons(x, Nil)) = trans(VEnt::ents_map(s.views, λ (y: VEnt) => y.unbacked(l), λ x => x.unbacked_kin(l), c), cong_fn(λ (es: List<VEnt>) => es.map(λ (y: VEnt) => y.unbacked(l)), u.he));
            let pc: (en.par < c) = j(lc, λ n _ => en.par < n, cc.left);
            let np: (x.par.same(c) = False) = Nat::same_false(x.par, c, λ eq => Nat::lt_irrefl(c, omega(pc, eq, kin.par)));
            let wr = λ (pp: Nat) (aa: List<Step>) => s1.up(tys, strs, Env::set(tys, ee, s.var_at(pp), λ d => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(aa), λ _ => Env::get(tys, ee, s.var_at(c)), d)), pp, f1);
            let step2: (s1.up(tys, strs, ee, c, Succ(f1)) = wr(en.par, en.at)) =
                trans(s1.up_step(tys, strs, ee, c, f1, x, Nil, hx, np), trans(cong_fn(λ (pp: Nat) => wr(pp, x.at), kin.par), cong_fn(λ (aa: List<Step>) => wr(en.par, aa), kin.at)));
            let fw = λ (d: Dyn(tys)) => Dyn::write(tys, strs, Env::ixs(tys, ee), s.unsteps(en.at), λ _ => Env::get(tys, ee, s.var_at(c)), d);
            let e1 = Env::set(tys, ee, s.var_at(en.par), fw);
            let rest: Sim(tys, strs, s, s1.up(tys, strs, e1, en.par, f1), m2) = (match s.role(en.par) as λ rr => s.role(en.par) = rr → Sim(tys, strs, s, s1.up(tys, strs, e1, en.par, f1), m2) {
                KHold(o2, a2) => λ rh => {
                    let ehn1: (s1.ents(en.par) = Nil) = trans(VEnt::ents_map(s.views, λ (y: VEnt) => y.unbacked(l), λ x => x.unbacked_kin(l), en.par),
                        cong_fn(λ (es: List<VEnt>) => es.map(λ (y: VEnt) => y.unbacked(l)), s.ents_hold_nil(λ y my => (inv.vents(y, my)).right.right, en.par, o2, a2, rh)));
                    j(sym(CSt::up_nil(f1, s1, tys, strs, e1, en.par, ehn1)), λ q _ => Sim(tys, strs, s, q, m2), CSt::up_last(tys, strs, sl, inv, none, h2, blk, ob, b2, g, hv, hv2, c, ee, en, qc, t, u, o2, a2, rh))
                },
                KView => λ rv => match CSt::up_next(tys, strs, sl, inv, none, h2, blk, ob, b2, g, hv, hv2, c, ee, en, qc, t, u, rv) {
                    ⟨enp, eq0⟩ => match eq0 {
                        ⟨qp, un⟩ => CSt::up_sim(f1, tys, strs, sl, inv, none, l, h2, blk, ob, b2, g, hv, hv2, en.par, e1, enp, qp,
                            Steps::sels(s.unsteps(en.at), Mach::ixs(tys, strs, m)) ++ t, omega(pc, lt), un),
                    },
                },
                KPlain => λ rp => false_elim(j(rp, λ q _ => match q { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
                    KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False }, cc.right)),
                KGone => λ rp => false_elim(j(rp, λ q _ => match q { KHold(o, _) => (o = en.obj) ∧ (en.reg = en.at),
                    KView => VEnt::Any(s.ents(en.par), λ pe => (pe.obj = en.obj) ∧ (en.reg = pe.reg ++ en.at)), KPlain => False, KGone => False }, cc.right)),
            })(refl);
            j(sym(step2), λ q _ => Sim(tys, strs, s, q, m2), rest)
        },
    }
}

// ---------------------------------------------------------------------------
// A write through a view

// Two meanings both agreeing with machines of one environment are the same
// at a plain level.
theorem Sim::plain_same(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e1, e2: Env(tys)}, {m1, m2: Mach(tys)}, sim1: Sim(tys, strs, s, e1, m1), sim2: Sim(tys, strs, s, e2, m2),
    envs: m2.env = m1.env, k: Nat, kb: k < s.na + s.nd, pl: (s.role(k)).plain() = True): Env::get(tys, e2, s.var_at(k)) = Env::get(tys, e1, s.var_at(k))
{
    let hx = s.lvl_var_at(k, kb);
    let c1 = Sim::plain_cell(tys, strs, sim1, s.var_at(k), k, hx, pl);
    let c2 = Sim::plain_cell(tys, strs, sim2, s.var_at(k), k, hx, pl);
    let un: (level2::Plain(Env::get(tys, e2, s.var_at(k))) = level2::Plain(Env::get(tys, e1, s.var_at(k)))) =
        trans(sym(c2), trans(cong_fn(λ (env: REnv(tys)) => (REnv::get(tys, env, s.var_at(k))).v, envs), c1));
    cong_fn(λ (v: Value(tys)) => match v { Plain(d) => d, Refer(_) => Env::get(tys, e1, s.var_at(k)) }, un)
}

// A write through a view to write `l` (its one entry `pe`) into its block:
// every variable that is neither `l` nor an ancestor of it reads what it
// read. Another object's references are apart from the root; a view of the
// same object is a descendant of `l`, which the licence found apart, or
// neither, which `excl` says is apart; a holder of the object is the chain's
// top, an ancestor.
theorem Inv::view_off(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, l: Nat, hr: s.role(l) = KView, pe: VEnt, hents: s.ents(l) = [pe], pw: pe.mode.writes() = True, xs: List<Step>, rl: List<Residual>,
    lic: s.license(s.views, Writing, l, [Pl(pe.obj, pe.reg ++ xs)]) = Some(rl), resl: Residual::All(rl, tys, cx, e, True),
    rpw: s.InRange(Steps::lvls(pe.reg ++ xs)), ppw: (k: Nat) → k.member(Steps::lvls(pe.reg ++ xs)) = True → (s.role(k)).plain() = True,
    r0: Ref, rt0: inv.root(pe.obj) = Some(r0), ss: List<Sel>, sxs: Steps::sels(s.unsteps(xs), Mach::ixs(tys, cx.strs, m)) = ss,
    ob: Dyn(tys), hv: Heap::val(tys, cx.strs, m.heap, r0.b) = Some(ob), g: Dyn(tys) → Dyn(tys),
    fq: Sel::fit(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob) = True,
    hc: (g(Sel::read_at(tys, cx.strs, ss, Sel::read_at(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob)))).code =
        (Sel::read_at(tys, cx.strs, ss, Sel::read_at(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob))).code,
    hl: Dyn::len(tys, cx.strs, g(Sel::read_at(tys, cx.strs, ss, Sel::read_at(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob)))) =
        Dyn::len(tys, cx.strs, Sel::read_at(tys, cx.strs, ss, Sel::read_at(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob)))):
    (y: Var) → (k: Nat) → s.lvl(y) = Some(k) → ¬(k = l) → k.member(s.anc_of(pe, s.na + s.nd)) = False →
        Cell::Agrees(tys, cx.strs, Heap::store(tys, m.heap, r0.b, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ ss, g, ob)),
            s.role(k), REnv::get(tys, m.env, y), Env::get(tys, e, y))
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let ws = Mach::ixs(tys, strs, m);
    let nl = s.na + s.nd;
    let rp = Steps::sels(s.unsteps(pe.reg), ws);
    let nw = Sel::write_at(tys, strs, (r0.sels ++ rp) ++ ss, g, ob);
    let h2 = Heap::store(tys, m.heap, r0.b, nw);
    let lt = λ (x: VEnt) (mx: Mem(x, s.views)) => (inv.chain(x, mx)).left;
    let mpe: Mem(pe, s.ents(l)) = j(sym(hents), λ es _ => Mem(pe, es), Inl(refl));
    let pmem: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(l), mpe);
    let pl: (pe.lvl = l) = pe.lvl.same_sound(l, s.views.mem_filter_holds(pe, λ q => q.lvl.same(l), mpe));
    let ch: s.Changes(pe.obj) = Inr(Exists(pe, ⟨pmem, ⟨refl, pw⟩⟩));
    let hn: ((obj: Obj(tys)) → Heap::obj(tys, m.heap, r0.b) = Some(obj) → obj.holes = Nil) = inv.bare(pe.obj, r0, rt0);
    let nwa: (nw = Sel::write_at(tys, strs, r0.sels ++ (rp ++ ss), g, ob)) = cong_fn(λ (q: List<Sel>) => Sel::write_at(tys, strs, q, g, ob), List::append_assoc(r0.sels, rp, ss));
    let fpr = Bool::and_true_parts(Sel::fit(tys, strs, r0.sels, ob), Sel::fit(tys, strs, rp, Sel::read_at(tys, strs, r0.sels, ob)), trans(sym(Sel::fit_append(tys, strs, r0.sels, rp, ob)), fq));
    let rr: (Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, r0.sels ++ rp, ob)) = Sel::read_at(tys, strs, rp ++ ss, Sel::read_at(tys, strs, r0.sels, ob))) =
        trans(cong_fn(λ (z: Dyn(tys)) => Sel::read_at(tys, strs, ss, z), Sel::read_append(tys, strs, r0.sels, rp, ob)), sym(Sel::read_append(tys, strs, rp, ss, Sel::read_at(tys, strs, r0.sels, ob))));
    let away = λ (x: List<Sel>) (ap: Sel::Apart(tys, strs, r0.sels, x)) =>
        trans(cong_fn(λ (d: Dyn(tys)) => Sel::get(tys, strs, x, d), nwa), Sel::get_apart(tys, strs, r0.sels ++ (rp ++ ss), x, Sel::apart_ext_l(tys, strs, r0.sels, rp ++ ss, x, ap), g, ob));
    let under = λ (vs: List<Sel>) (ap: Sel::Apart(tys, strs, vs, rp ++ ss)) =>
        trans(cong_fn(λ (d: Dyn(tys)) => Sel::get(tys, strs, r0.sels ++ vs, d), nwa),
            Sel::get_under(tys, strs, sl, r0.sels, rp ++ ss, vs, ap, g, ob, fpr.left, j(rr, λ z _ => (g(z)).code = z.code, hc), j(rr, λ z _ => Dyn::len(tys, strs, g(z)) = Dyn::len(tys, strs, z), hl)));
    let wsel: (Steps::sels(s.unsteps(pe.reg ++ xs), ws) = rp ++ ss) =
        trans(cong_fn(λ (q: List<Step>) => Steps::sels(q, ws), s.unsteps_app(pe.reg, xs)), trans(List::map_append(s.unsteps(pe.reg), s.unsteps(xs), λ (a: Step) => a.sel(ws)), cong_fn(λ (q: List<Sel>) => rp ++ q, sxs)));
    let ah = CSt::anc_holder(nl, s, inv.chain, pe, pmem, omega((inv.vents(pe, pmem)).right.left));
    λ y k hy kne nk => {
        let kb = s.lvl_below(y, k, hy);
        let same = λ (q2: Ref) (cq: (REnv::get(tys, m.env, y)).v = Refer(q2)) (live: ¬((s.role(k)).same(KGone) = True)) (eb: q2.b = r0.b) =>
            (match s.role(k) as λ rr0 => s.role(k) = rr0 → (match rr0 { KHold(o, _) => inv.root(o) = Some(q2),
                    KView => VEnt::Any(s.ents(k), λ en => ((inv.root(en.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(en.reg))) = Some(q2))), KPlain => False, KGone => True }) →
                    ¬(rr0.same(KGone) = True) → Sel::get(tys, strs, q2.sels, nw) = Sel::get(tys, strs, q2.sels, ob) {
                KHold(o2, a2) => λ er ok _ => {
                    let no: ¬(o2 = pe.obj) = λ eo => match ah {
                        ⟨k2, pk⟩ => match pk.right {
                            ⟨a3, pa⟩ => match Nat::eq_or_ne(k, k2) {
                                Inl(eq) => absurd(trans(sym(nk), trans(cong_fn(λ (n: Nat) => n.member(s.anc_of(pe, nl)), eq), pk.left))),
                                Inr(ne) => inv.one(k, k2, pe.obj, a2, a3, kb, omega(CSt::anc_below(nl, s, lt, pe, pmem, k2, pk.left), (inv.vents(pe, pmem)).right.left), ne,
                                    j(eo, λ z _ => s.role(k) = KHold(z, a2), er), pa),
                            },
                        },
                    };
                    away(q2.sels, inv.apart(pe.obj, o2, λ eo => no(sym(eo)), ch, r0, q2, rt0, ok)(sym(eb)))
                },
                KView => λ _ ok _ => match VEnt::any_mem(s.ents(k), λ en => ((inv.root(en.obj)).map(λ r1 => r1.narrow(ws, s.unsteps(en.reg))) = Some(q2)), ok) {
                    ⟨ey, pey⟩ => {
                        let my: Mem(ey, s.views) = s.views.mem_filter(ey, λ q => q.lvl.same(k), pey.left);
                        let yl: (ey.lvl = k) = ey.lvl.same_sound(k, s.views.mem_filter_holds(ey, λ q => q.lvl.same(k), pey.left));
                        match Option::map_some_inv(inv.root(ey.obj), λ r1 => r1.narrow(ws, s.unsteps(ey.reg)), q2, pey.right) {
                            ⟨r3, pr3⟩ => {
                                let ry = Steps::sels(s.unsteps(ey.reg), ws);
                                let qs: (q2.sels = r3.sels ++ ry) = cong_fn(λ (z: Ref) => z.sels, sym(pr3.right));
                                let qb: (q2.b = r3.b) = cong_fn(λ (z: Ref) => z.b, sym(pr3.right));
                                let at: (Sel::get(tys, strs, r3.sels ++ ry, nw) = Sel::get(tys, strs, r3.sels ++ ry, ob)) = match Nat::eq_or_ne(ey.obj, pe.obj) {
                                    Inr(no) => away(r3.sels ++ ry, Sel::apart_ext_r(tys, strs, r0.sels, r3.sels, ry, inv.apart(pe.obj, ey.obj, λ eo => no(sym(eo)), ch, r0, r3, rt0, pr3.left)(trans(sym(eb), qb)))),
                                    Inl(eo) => {
                                        let r3r: (r3 = r0) = Option::some_inj(r3, r0, trans(sym(pr3.left), trans(cong_fn(λ (z: Nat) => inv.root(z), eo), rt0)));
                                        let yne: ¬(ey.lvl = l) = λ eq => kne(trans(sym(yl), eq));
                                        let ap: Sel::Apart(tys, strs, ry, rp ++ ss) = (match l.member(s.anc_of(ey, nl)) as λ b => l.member(s.anc_of(ey, nl)) = b → Sel::Apart(tys, strs, ry, rp ++ ss) {
                                            True => λ an => {
                                                let mt = s.meets_view(l, Writing, ey, hr, yne, refl, an);
                                                j(wsel, λ q _ => Sel::Apart(tys, strs, ry, q),
                                                    Inv::lic_apart(tys, cx, sl, inv, none, Writing, l, [Pl(pe.obj, pe.reg ++ xs)], rl, lic, resl, ey, my, mt, Pl(pe.obj, pe.reg ++ xs), Inl(refl), eo, rpw, ppw))
                                            },
                                            False => λ an => {
                                                let ex = inv.excl(pe, ey, pmem, my, pw, sym(eo), λ eq => yne(trans(sym(eq), pl)),
                                                    j(sym(pl), λ n _ => n.member(s.anc_of(ey, nl)) = False, an), j(sym(yl), λ n _ => n.member(s.anc_of(pe, nl)) = False, nk));
                                                Sel::apart_sym(tys, strs, rp ++ ss, ry, Sel::apart_ext_l(tys, strs, rp, ss, ry, ex))
                                            },
                                        })(refl);
                                        j(sym(r3r), λ z _ => Sel::get(tys, strs, z.sels ++ ry, nw) = Sel::get(tys, strs, z.sels ++ ry, ob), under(ry, ap))
                                    },
                                };
                                j(sym(qs), λ q _ => Sel::get(tys, strs, q, nw) = Sel::get(tys, strs, q, ob), at)
                            },
                        }
                    },
                },
                KPlain => λ _ no _ => false_elim(no),
                KGone => λ _ _ no => false_elim(no(refl)),
            })(refl, inv.refs(y, k, hy, q2, cq), live);
        Cell::agrees_store(tys, strs, m.heap, h2, s.role(k), REnv::get(tys, m.env, y), Env::get(tys, e, y), sim.vars(y, k, hy), λ q2 cq live =>
            match s.refok_block(inv.root, ws, k, q2, inv.refs(y, k, hy, q2, cq), live) {
                ⟨o3, ⟨r3, pr⟩⟩ => Value::get_store(tys, strs, m.heap, r0.b, ob, nw, hv, hn, q2,
                    j(pr.right, λ bb _ => (obj: Obj(tys)) → Heap::obj(tys, m.heap, bb) = Some(obj) → obj.holes = Nil, inv.bare(o3, r3, pr.left)), same(q2, cq, live)),
            })
    }
}

// The walk's start at a write through a view whose cell refers, `qq` its
// reference: the view reads its new meaning, every other variable that is not
// an ancestor reads what it read (`Inv::view_off`).
theorem Stmt::write_view_upat(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n), wf: WriteFacts(tys, cx, s, e, m, p, v, n, wi), hr2: s.role(wi.l) = KView,
    pe: VEnt, hents: s.ents(wi.l) = [pe], pw: pe.mode.writes() = True, lic: s.license(s.views, Writing, wi.l, [Pl(pe.obj, pe.reg ++ wi.xs)]) = Some(wf.rl),
    r0: Ref, rt0: inv.root(pe.obj) = Some(r0), ob: Dyn(tys), hv: Heap::val(tys, cx.strs, m.heap, r0.b) = Some(ob),
    cv2: (REnv::get(tys, m.env, p.root)).v = Refer(r0.narrow(Mach::ixs(tys, cx.strs, m), s.unsteps(pe.reg))),
    fr: Sel::fit(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob) = True,
    rdo: Sel::read_at(tys, cx.strs, r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m)), ob) = Env::get(tys, e, p.root)):
    UpAt(tys, cx.strs, s, e, m,
        Heap::store(tys, m.heap, r0.b, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ Steps::sels(p.steps, Env::ixs(tys, e)), λ _ => Env::get(tys, e, v), ob)),
        r0.b, ob, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ Steps::sels(p.steps, Env::ixs(tys, e)), λ _ => Env::get(tys, e, v), ob),
        λ _ => Env::get(tys, e, v), wi.l, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), pe,
        r0.narrow(Mach::ixs(tys, cx.strs, m), s.unsteps(pe.reg)), Steps::sels(p.steps, Env::ixs(tys, e)))
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let nl = s.na + s.nd;
    let ws = Env::ixs(tys, e);
    let wsm = Mach::ixs(tys, strs, m);
    let vd = Env::get(tys, e, v);
    let old = Env::get(tys, e, p.root);
    let ss = Steps::sels(p.steps, ws);
    let g = λ (_: Dyn(tys)) => vd;
    let qq = r0.narrow(wsm, s.unsteps(pe.reg));
    let nwb = Sel::write_at(tys, strs, qq.sels ++ ss, g, ob);
    let h2 = Heap::store(tys, m.heap, qq.b, nwb);
    let f2 = λ (d: Dyn(tys)) => Dyn::write(tys, strs, ws, p.steps, g, d);
    let e2 = Env::set(tys, e, p.root, f2);
    let wk = Sel::write_keeps(tys, strs, sl, g, ss, old, wf.wv.code, wf.wv.len);
    let wsv: (f2(old) = Sel::write_at(tys, strs, ss, g, old)) = Steps::write_sels(tys, strs, ws, p.steps, g, old);
    let code: ((f2(old)).code = (s.var(wi.l)).code) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, wsv), trans(wk.left, sim.codes(p.root, wi.l, wi.hl)));
    let mpe: Mem(pe, s.ents(wi.l)) = j(sym(hents), λ es _ => Mem(pe, es), Inl(refl));
    let pmem: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(wi.l), mpe);
    let pl: (pe.lvl = wi.l) = pe.lvl.same_sound(wi.l, s.views.mem_filter_holds(pe, λ q => q.lvl.same(wi.l), mpe));
    let xr: (s.var_at(wi.l) = p.root) = s.lvl_var(p.root, wi.l, wi.hl);
    let rin = s.var_inside(p.root, wi.l, wi.hl);
    let ein: Var::In(p.root, e.args.len(), e.locs.len()) = j(sym(sim.elocs), λ q _ => Var::In(p.root, e.args.len(), q), j(sym(sim.eargs), λ q _ => Var::In(p.root, q, s.nd), rin));
    let hc: ((g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob)))).code = (Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob))).code) =
        j(sym(rdo), λ t _ => vd.code = (Sel::read_at(tys, strs, ss, t)).code, wf.wv.code);
    let hln: (Dyn::len(tys, strs, g(Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob)))) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob)))) =
        j(sym(rdo), λ t _ => Dyn::len(tys, strs, vd) = Dyn::len(tys, strs, Sel::read_at(tys, strs, ss, t)), wf.wv.len);
    let ff = λ (y: Dyn(tys)) => Sel::write_at(tys, strs, ss, g, y);
    let wa: (nwb = Sel::write_at(tys, strs, qq.sels, ff, ob)) = Sel::write_append(tys, strs, qq.sels, ss, g, ob);
    let wk2 = Sel::write_keeps(tys, strs, sl, g, ss, Sel::read_at(tys, strs, qq.sels, ob), hc, hln);
    let wg = Sel::write_get(tys, strs, sl, ff, qq.sels, ob, fr, wk2.left, wk2.right);
    let rdn: (Sel::read_at(tys, strs, qq.sels, nwb) = f2(old)) =
        trans(cong_fn(λ (t: Dyn(tys)) => Sel::read_at(tys, strs, qq.sels, t), wa), trans(wg.right, trans(cong_fn(ff, rdo), sym(wsv))));
    let fnw: (Sel::fit(tys, strs, qq.sels, nwb) = True) = j(sym(wa), λ t _ => Sel::fit(tys, strs, qq.sels, t) = True, wg.left);
    let hn: ((obj: Obj(tys)) → Heap::obj(tys, m.heap, qq.b) = Some(obj) → obj.holes = Nil) = inv.bare(pe.obj, r0, rt0);
    let rdh = λ (o: Option<Dyn(tys)>) => match o { Some(d) => Sel::get(tys, strs, qq.sels ++ Nil, d), None => None<Dyn(tys)>() };
    let hv2: (Heap::val(tys, strs, h2, qq.b) = Some(nwb)) = match Heap::obj_of_val(tys, strs, m.heap, qq.b, ob, hv) {
        ⟨obj, pobj⟩ => Heap::val_store_here(tys, strs, m.heap, qq.b, nwb, obj, pobj, hn(obj, pobj)),
    };
    let rootreads: (Value::get(tys, strs, h2, Refer(qq), Nil) = Some(f2(old))) =
        trans(cong_fn(rdh, hv2), trans(cong_fn(λ (t: List<Sel>) => Sel::get(tys, strs, t, nwb), List::append_nil(qq.sels)), trans(Sel::get_fit(tys, strs, qq.sels, nwb, fnw), cong_fn(λ (t: Dyn(tys)) => Some(t), rdn))));
    let unst: (s.unsteps(wi.xs) = p.steps) = CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs);
    let sxs: (Steps::sels(s.unsteps(wi.xs), wsm) = ss) = trans(cong_fn(λ (z: List<Step>) => Steps::sels(z, wsm), unst), wf.same);
    let rlv = CSt::steps_range(p.steps, s, wi.xs, wi.hxs);
    let plv = CSt::atoms_plain(Steps::lvls(wi.xs), s, wi.ra, wi.hra);
    let regw = s.lvls_app(pe.reg, wi.xs, λ k => (k < nl) ∧ ((s.role(k)).plain() = True), λ k mk => inv.words(k, s.region_lvl(pe, pmem, k, mk)), λ k mk => ⟨rlv(k, mk), plv(k, mk)⟩);
    let vo = Inv::view_off(tys, cx, sl, inv, none, wi.l, hr2, pe, hents, pw, wi.xs, wf.rl, lic, wf.resl, λ k mk => (regw(k, mk)).left, λ k mk => (regw(k, mk)).right,
        r0, rt0, ss, sxs, ob, hv, g, fr, hc, hln);
    let other = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (kne: ¬(k = wi.l)) => λ (eq: p.root = y) => s.var_ne(y, p.root, k, wi.l, hy, wi.hl, kne)(sym(eq));
    let isroot = λ (y: Var) (k: Nat) (hy: s.lvl(y) = Some(k)) (eq: k = wi.l) => trans(sym(s.lvl_var(y, k, hy)), trans(cong_fn(λ (z: Nat) => s.var_at(z), eq), xr));
    let ecell = λ (y: Var) (yn: ¬(p.root = y)) => Env::get_set_other(tys, e, p.root, y, f2, yn);
    let e2root: (Env::get(tys, e2, p.root) = f2(old)) = Env::get_set_same(tys, e, p.root, f2, ein);
    UpAt(hents, pmem, pw, trans(cong_fn(λ (x: Var) => (REnv::get(tys, m.env, x)).v, xr), cv2), refl, fr, refl, hc, hln,
        λ y k hy nk => match Nat::eq_or_ne(k, wi.l) {
            Inl(eq) => j(sym(isroot(y, k, hy, eq)), λ z _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, z), Env::get(tys, e2, z)),
                j(sym(eq), λ z _ => Cell::Agrees(tys, strs, h2, s.role(z), REnv::get(tys, m.env, p.root), Env::get(tys, e2, p.root)),
                    j(sym(hr2), λ rr _ => Cell::Agrees(tys, strs, h2, rr, REnv::get(tys, m.env, p.root), Env::get(tys, e2, p.root)),
                        j(sym(cv2), λ u _ => Value::Reads(tys, strs, h2, u, Env::get(tys, e2, p.root)),
                            j(sym(e2root), λ d _ => Value::Reads(tys, strs, h2, Refer(qq), d), rootreads))))),
            Inr(kne) => j(sym(ecell(y, other(y, k, hy, kne))), λ d _ => Cell::Agrees(tys, strs, h2, s.role(k), REnv::get(tys, m.env, y), d), vo(y, k, hy, kne, nk)),
        },
        λ k hk => {
            let kl: (k < wi.l) = j(pl, λ z _ => k < z, CSt::anc_below(nl, s, λ x mx => (inv.chain(x, mx)).left, pe, pmem, k, hk));
            ecell(s.var_at(k), other(s.var_at(k), k, s.lvl_var_at(k, omega(kl, s.lvl_below(p.root, wi.l, wi.hl))), λ eq => Nat::lt_irrefl(k, omega(kl, eq))))
        },
        s.regions_other(tys, e, e2, p.root, wi.l, wi.hl, wf.nrf, λ k ir => (inv.words(k, ir)).left, ecell),
        λ y k hy => match Nat::eq_or_ne(k, wi.l) {
            Inl(eq) => j(sym(isroot(y, k, hy, eq)), λ z _ => (Env::get(tys, e2, z)).code = (s.var(k)).code,
                trans(cong_fn(λ (d: Dyn(tys)) => d.code, e2root), trans(code, cong_fn(λ (z: Nat) => (s.var(z)).code, sym(eq))))),
            Inr(kne) => trans(cong_fn(λ (d: Dyn(tys)) => d.code, ecell(y, other(y, k, hy, kne))), sim.codes(y, k, hy)),
        },
        trans(Env::set_args(tys, e, p.root, f2), sim.eargs), trans(Env::set_locs(tys, e, p.root, f2), sim.elocs))
}

// The invariant after a write through a view whose cell refers: the chain
// walked up (`CSt::up_sim`), the store's clauses, the view's entry no longer
// written back.
theorem Stmt::write_view_inv(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, cx.strs, s, e, m, h0, lent),
    none: s.pending() = False, {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n),
    pe: VEnt, hents: s.ents(wi.l) = [pe], pw: pe.mode.writes() = True, r0: Ref, rt0: inv.root(pe.obj) = Some(r0), ob: Dyn(tys), hv: Heap::val(tys, cx.strs, m.heap, r0.b) = Some(ob),
    cv2: (REnv::get(tys, m.env, p.root)).v = Refer(r0.narrow(Mach::ixs(tys, cx.strs, m), s.unsteps(pe.reg))),
    u: UpAt(tys, cx.strs, s, e, m,
        Heap::store(tys, m.heap, r0.b, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ Steps::sels(p.steps, Env::ixs(tys, e)), λ _ => Env::get(tys, e, v), ob)),
        r0.b, ob, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ Steps::sels(p.steps, Env::ixs(tys, e)), λ _ => Env::get(tys, e, v), ob),
        λ _ => Env::get(tys, e, v), wi.l, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), pe,
        r0.narrow(Mach::ixs(tys, cx.strs, m), s.unsteps(pe.reg)), Steps::sels(p.steps, Env::ixs(tys, e)))):
    Inv(tys, cx.strs, s.written(wi.l).unback(wi.l), Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)),
        Mach(Heap::store(tys, m.heap, r0.b, Sel::write_at(tys, cx.strs, (r0.sels ++ Steps::sels(s.unsteps(pe.reg), Mach::ixs(tys, cx.strs, m))) ++ Steps::sels(p.steps, Env::ixs(tys, e)), λ _ => Env::get(tys, e, v), ob)), m.env, m.io),
        h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let nl = s.na + s.nd;
    let s1 = s.written(wi.l).unback(wi.l);
    let wsm = Mach::ixs(tys, strs, m);
    let qq = r0.narrow(wsm, s.unsteps(pe.reg));
    let ss = Steps::sels(p.steps, Env::ixs(tys, e));
    let g = λ (_: Dyn(tys)) => Env::get(tys, e, v);
    let nwb = Sel::write_at(tys, strs, qq.sels ++ ss, g, ob);
    let e2 = Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, Env::ixs(tys, e), p.steps, g, d));
    let h2 = Heap::store(tys, m.heap, r0.b, nwb);
    let m2: Mach(tys) = Mach(h2, m.env, m.io);
    let hn: ((obj: Obj(tys)) → Heap::obj(tys, m.heap, r0.b) = Some(obj) → obj.holes = Nil) = inv.bare(pe.obj, r0, rt0);
    let hv2: (Heap::val(tys, strs, h2, r0.b) = Some(nwb)) = match Heap::obj_of_val(tys, strs, m.heap, r0.b, ob, hv) {
        ⟨obj, pobj⟩ => Heap::val_store_here(tys, strs, m.heap, r0.b, nwb, obj, pobj, hn(obj, pobj)),
    };
    let mpe: Mem(pe, s.ents(wi.l)) = j(sym(hents), λ es _ => Mem(pe, es), Inl(refl));
    let pmem: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(wi.l), mpe);
    let us: Sim(tys, strs, s, s1.up(tys, strs, e2, wi.l, nl), m2) =
        CSt::up_sim(nl, tys, strs, sl, inv, none, wi.l, h2, r0.b, ob, nwb, g, hv, hv2, wi.l, e2, pe, qq, ss, s.lvl_below(p.root, wi.l, wi.hl), u);
    let ivp = Inv::store_rest(tys, strs, inv, none, pe.obj, r0, rt0, Inr(Exists(pe, ⟨pmem, ⟨refl, pw⟩⟩)), nwb, s1.up(tys, strs, e2, wi.l, nl), us,
        λ k ir => Sim::plain_same(tys, strs, sim, us, refl, k, (inv.words(k, ir)).left, (inv.words(k, ir)).right));
    let cl: ((REnv::get(tys, m2.env, s.var_at(wi.l))).v = Refer(qq)) = trans(cong_fn(λ (x: Var) => (REnv::get(tys, m.env, x)).v, s.lvl_var(p.root, wi.l, wi.hl)), cv2);
    let pe2: (s1.patched(tys, strs, e2, m2) = s1.up(tys, strs, e2, wi.l, nl)) =
        trans(s.patched_unback(tys, strs, wi.l, pe, none, hents, pw, e2, m2), cong_fn(λ (w: Value(tys)) => match w as λ _ => Env(tys) { Refer(_) => s1.up(tys, strs, e2, wi.l, s.na + s.nd), Plain(_) => e2 }, cl));
    Inv::unback(tys, strs, ivp, none, wi.l, e2, j(sym(pe2), λ z _ => Sim(tys, strs, s1, z, m2), us))
}

// The referring case of a write through a view: its reference is its
// entry's object's root narrowed; the run stores into that block.
theorem Stmt::write_view_ref(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, v: Var, n: Next, wi: WriteInv(tys, cx.strs, s, p, v, n), wf: WriteFacts(tys, cx, s, e, m, p, v, n, wi),
    hr2: s.role(wi.l) = KView, pe: VEnt, hents: s.ents(wi.l) = [pe], pw: pe.mode.writes() = True, lic: s.license(s.views, Writing, wi.l, [Pl(pe.obj, pe.reg ++ wi.xs)]) = Some(wf.rl),
    nst: s.written(wi.l).unback(wi.l) = n.st, q: Ref, cv: (REnv::get(tys, m.env, p.root)).v = Refer(q), rdr: Value::Reads(tys, cx.strs, m.heap, Refer(q), Env::get(tys, e, p.root))):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let wsm = Mach::ixs(tys, strs, m);
    let vd = Env::get(tys, e, v);
    let old = Env::get(tys, e, p.root);
    let ss = Steps::sels(p.steps, Env::ixs(tys, e));
    let e2 = Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, Env::ixs(tys, e), p.steps, λ _ => vd, d));
    let okq = inv.refs(p.root, wi.l, wi.hl, q, cv);
    let anyq: VEnt::Any(s.ents(wi.l), λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(wsm, s.unsteps(y.reg))) = Some(q))) =
        j(hr2, λ rr _ => match rr { KHold(o, _) => inv.root(o) = Some(q), KView => VEnt::Any(s.ents(wi.l), λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(wsm, s.unsteps(y.reg))) = Some(q))),
            KPlain => False, KGone => True }, okq);
    let any1: VEnt::Any([pe], λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(wsm, s.unsteps(y.reg))) = Some(q))) =
        j(hents, λ es _ => VEnt::Any(es, λ y => ((inv.root(y.obj)).map(λ r1 => r1.narrow(wsm, s.unsteps(y.reg))) = Some(q))), anyq);
    let h1: ((inv.root(pe.obj)).map(λ r1 => r1.narrow(wsm, s.unsteps(pe.reg))) = Some(q)) = match any1 { Inl(x) => x, Inr(no) => false_elim(no) };
    match Option::map_some_inv(inv.root(pe.obj), λ r1 => r1.narrow(wsm, s.unsteps(pe.reg)), q, h1) {
        ⟨r0, pr0⟩ => {
            let qq = r0.narrow(wsm, s.unsteps(pe.reg));
            let cv2: ((REnv::get(tys, m.env, p.root)).v = Refer(qq)) = trans(cv, cong_fn(λ (z: Ref) => Refer(z), sym(pr0.right)));
            let rdq: Value::Reads(tys, strs, m.heap, Refer(qq), old) = j(sym(pr0.right), λ z _ => Value::Reads(tys, strs, m.heap, Refer(z), old), rdr);
            match Value::refer_inv(tys, strs, m.heap, qq, old, rdq) {
                ⟨ob, pob⟩ => {
                    let fr = pob.right.left;
                    let rdo: (Sel::read_at(tys, strs, qq.sels, ob) = old) = pob.right.right;
                    let nwb = Sel::write_at(tys, strs, qq.sels ++ ss, λ _ => vd, ob);
                    let fss: (Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob)) = True) = j(sym(rdo), λ t _ => Sel::fit(tys, strs, ss, t) = True, wf.fit);
                    let fall: (Sel::fit(tys, strs, qq.sels ++ ss, ob) = True) =
                        trans(Sel::fit_append(tys, strs, qq.sels, ss, ob), Bool::and_of(Sel::fit(tys, strs, qq.sels, ob), Sel::fit(tys, strs, ss, Sel::read_at(tys, strs, qq.sels, ob)), fr, fss));
                    let put: (Sel::put(tys, strs, qq.sels ++ Steps::sels(p.steps, wsm), vd, ob) = Some(nwb)) =
                        j(sym(wf.same), λ z _ => Sel::put(tys, strs, qq.sels ++ z, vd, ob) = Some(nwb), Sel::put_fit(tys, strs, qq.sels ++ ss, vd, ob, fall));
                    let u = Stmt::write_view_upat(tys, cx, sl, inv, none, wi, wf, hr2, pe, hents, pw, lic, r0, pr0.left, ob, pob.left, cv2, fr, rdo);
                    let iv = Stmt::write_view_inv(tys, cx, sl, inv, none, wi, pe, hents, pw, r0, pr0.left, ob, pob.left, cv2, u);
                    let m2: Mach(tys) = Mach(Heap::store(tys, m.heap, r0.b, nwb), m.env, m.io);
                    Stepped(m2, λ k => Stmt::write_runs_ref(tys, strs, fns, call, m, p, v, vd, wf.vx, qq, cv2, ob, pob.left, nwb, put, k),
                        j(nst, λ z _ => Inv(tys, strs, z, e2, m2, h0, lent), iv))
                },
            }
        },
    }
}

// A write through a view to write: into its cell where it is a copy, into
// its object's block where it refers. Its entry is then not written back; the
// invariant's meaning is the chain written up where the view refers, the
// meaning itself where it is a copy.
theorem Stmt::stage_write_view(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, p: Place, v: Var, n: Next, ok: s.write(tys, cx.strs, p, v) = Some(n),
    cok: (match Shape::steps_ok(tys, cx.strs, p.steps, s.code(p.root)) as λ _ => Bool { Some(c) => s.code(v).same(c), None => False }) = True,
    l: Nat, hl: s.lvl(p.root) = Some(l), hr: s.role(l) = KView,
    nb: (xs: List<Step>) → s.steps(p.steps) = Some(xs) → (lv: Nat) → s.lvl(v) = Some(lv) → s.is_back(l, xs, lv) = False,
    tail: Type, res: Residual::All(n.rs, tys, cx, e, tail)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let wi = s.write_inv(tys, strs, p, v, n, ok);
    let ll: (l = wi.l) = Option::some_inj(l, wi.l, trans(sym(hl), wi.hl));
    let hr2: (s.role(wi.l) = KView) = j(ll, λ q _ => s.role(q) = KView, hr);
    let wf = WriteInv::facts(tys, cx, sl, sim, wi, j(ll, λ q _ => s.is_back(q, wi.xs, wi.lv) = False, nb(wi.xs, wi.hxs, wi.lv, wi.hlv)), cok, tail, res);
    let ws = Env::ixs(tys, e);
    let wsm = Mach::ixs(tys, strs, m);
    let vd = Env::get(tys, e, v);
    let old = Env::get(tys, e, p.root);
    let ss = Steps::sels(p.steps, ws);
    let g = λ (_: Dyn(tys)) => vd;
    let nw = Sel::write_at(tys, strs, ss, g, old);
    let wk = Sel::write_keeps(tys, strs, sl, g, ss, old, wf.wv.code, wf.wv.len);
    let f2 = λ (d: Dyn(tys)) => Dyn::write(tys, strs, ws, p.steps, g, d);
    let e2 = Env::set(tys, e, p.root, f2);
    let wsv: (f2(old) = nw) = Steps::write_sels(tys, strs, ws, p.steps, g, old);
    let s1 = s.written(wi.l).unback(wi.l);
    let wt: (s.wrote_to(wi.l) = s1) = j(sym(hr2), λ rr _ => (match rr as λ _ => CSt { KPlain => s, KHold(_, _) => s.written(wi.l).unback(wi.l),
        KView => s.written(wi.l).unback(wi.l), KGone => s.written(wi.l).unback(wi.l) }) = s.written(wi.l).unback(wi.l), refl);
    let nst: (s1 = n.st) = sym(trans(wf.nst, wt));
    let rd0: Value::Reads(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, old) =
        j(hr2, λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, REnv::get(tys, m.env, p.root), old), sim.vars(p.root, wi.l, wi.hl));
    match s.write_lic_view(wi.l, wi.xs, wf.rl, wf.hrl, hr2) {
        ⟨pe, ppe⟩ => (match (REnv::get(tys, m.env, p.root)).v as λ u => (REnv::get(tys, m.env, p.root)).v = u → Value::Reads(tys, strs, m.heap, u, old) →
                Stepped(tys, strs, fns, call, Write(p, v), n.st, e2, m, h0, lent) {
            Plain(dh) => λ cv rdh => {
                let pc: ((REnv::get(tys, m.env, p.root)).v = level2::Plain(old)) = trans(cv, cong_fn(λ (q: Dyn(tys)) => level2::Plain(q), Option::some_inj(dh, old, rdh)));
                let put: (Sel::put(tys, strs, Steps::sels(p.steps, wsm), vd, old) = Some(nw)) =
                    j(sym(wf.same), λ q _ => Sel::put(tys, strs, q, vd, old) = Some(nw), Sel::put_fit(tys, strs, ss, vd, old, wf.fit));
                let c2 = Cell(level2::Plain(nw), (REnv::get(tys, m.env, p.root)).own);
                let m2: Mach(tys) = Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io);
                let agr: Cell::Agrees(tys, strs, m.heap, s.role(wi.l), c2, f2(old)) =
                    j(sym(hr2), λ rr _ => Cell::Agrees(tys, strs, m.heap, rr, c2, f2(old)), cong_fn(λ (q: Dyn(tys)) => Some(q), sym(wsv)));
                let code: ((f2(old)).code = (s.var(wi.l)).code) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, wsv), trans(wk.left, sim.codes(p.root, wi.l, wi.hl)));
                let unst: (s.unsteps(wi.xs) = p.steps) = CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs);
                let rp = CSt::steps_range(p.steps, s, wi.xs, wi.hxs);
                let pp = CSt::atoms_plain(Steps::lvls(wi.xs), s, wi.ra, wi.hra);
                let nlv = s.na + s.nd;
                let iv = Inv::set_cell(tys, strs, inv, p.root, wi.l, wi.hl, wf.nrf, f2, c2, s.patched_none(tys, strs, e, m, none), s.patched_none(tys, strs, Env::set(tys, e, p.root, f2), Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io), none), agr, code, λ r0 eq => absurd(eq), cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), pc),
                    λ en me pq z hz dp dc cp cz => {
                        let rv: (s.role(en.par) = KView) = j(sym(pq), λ q _ => s.role(q) = KView, hr2);
                        let eo: (s.ents(en.par) = [pe]) = j(sym(pq), λ q _ => s.ents(q) = [pe], ppe.left);
                        let po = s.parent_one(en, pe, rv, eo, (inv.chain(en, me)).right);
                        let ch = inv.chain(en, me);
                        let nev: ¬(en.lvl = wi.l) = λ eq => Nat::lt_irrefl(wi.l, j(eq, λ q _ => wi.l < q, j(pq, λ q _ => q < en.lvl, ch.left)));
                        let anc: (wi.l.member(s.anc_of(en, nlv)) = True) = j(pq, λ q _ => q.member(s.anc_of(en, nlv)) = True, s.anc_par(en, ch.left, (inv.vents(en, me)).right.left));
                        let mt = s.meets_view(wi.l, Writing, en, hr2, nev, refl, anc);
                        let ap0 = Inv::sib_lic(tys, cx, sl, inv, none, Writing, wi.l, [Pl(pe.obj, pe.reg ++ wi.xs)], wf.rl, ppe.right.right, wf.resl, en, me, mt, Pl(pe.obj, pe.reg ++ wi.xs), Inl(refl),
                            sym(po.left), pe.reg, wi.xs, po.right, refl, rp, pp);
                        let ap = j(trans(cong_fn(λ (q: List<Step>) => Steps::sels(q, wsm), unst), wf.same), λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), q), ap0);
                        let cf0 = inv.cfit(en, me, p.root, z, j(sym(pq), λ q _ => s.lvl(p.root) = Some(q), wi.hl), hz, old, dc, pc, cz);
                        let nwe: (nw = dp) = cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => nw }, cp);
                        j(nwe, λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), wsm), q, dc), CSt::cfit_apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), ss, ap, g, old, dc, cf0))
                    },
                    λ en me lq y hy dp dc cy cc => {
                        let cf0 = inv.cfit(en, me, y, p.root, hy, j(sym(lq), λ q _ => s.lvl(p.root) = Some(q), wi.hl), dp, old, cy, pc);
                        let nwe: (nw = dc) = cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => nw }, cc);
                        j(nwe, λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), wsm), dp, q), CSt::cfit_like(tys, strs, Steps::sels(s.unsteps(en.at), wsm), dp, old, nw, cf0, wk.left, wk.right))
                    });
                let rin = s.var_inside(p.root, wi.l, wi.hl);
                let min: Var::In(p.root, (m.env).args.len(), (m.env).locs.len()) =
                    j(sym(sim.mlocs), λ q _ => Var::In(p.root, (m.env).args.len(), q), j(sym(sim.margs), λ q _ => Var::In(p.root, q, s.nd), rin));
                let cl: ((REnv::get(tys, m2.env, s.var_at(wi.l))).v = level2::Plain(nw)) =
                    trans(cong_fn(λ (x: Var) => (REnv::get(tys, m2.env, x)).v, s.lvl_var(p.root, wi.l, wi.hl)), cong_fn(λ (c: Cell(tys)) => c.v, REnv::get_set_same(tys, m.env, p.root, c2, min)));
                let pe2: (s1.patched(tys, strs, e2, m2) = e2) = trans(s.patched_unback(tys, strs, wi.l, pe, none, ppe.left, ppe.right.left, e2, m2),
                    cong_fn(λ (u: Value(tys)) => match u as λ _ => Env(tys) { Refer(_) => s1.up(tys, strs, e2, wi.l, s.na + s.nd), Plain(_) => e2 }, cl));
                let sim1: Sim(tys, strs, s1, s1.patched(tys, strs, e2, m2), m2) = j(sym(pe2), λ q _ => Sim(tys, strs, s1, q, m2), Inv::sim_now(tys, strs, iv, none));
                Stepped(m2, λ k => Stmt::write_runs_plain(tys, strs, fns, call, m, p, v, vd, wf.vx, old, pc, nw, put, k),
                    j(nst, λ q _ => Inv(tys, strs, q, e2, m2, h0, lent), Inv::unback(tys, strs, iv, none, wi.l, e2, sim1)))
            },
            Refer(q) => λ cv rdr => Stmt::write_view_ref(tys, cx, sl, fns, call, inv, none, p, v, n, wi, wf, hr2, pe, ppe.left, ppe.right.left, ppe.right.right, nst, q, cv, rdr),
        })(refl, rd0),
    }
}

// ---------------------------------------------------------------------------
// The write-back: what it needs of paths and of the walk

// Writing back what a path reads changes nothing (the model's `put_back`
// along the path, by `over_read`).
theorem Sel::put_back_path(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), xs: List<Sel>): (d: Dyn(tys)) → Sel::write_at(tys, strs, xs, λ _ => Sel::read_at(tys, strs, xs, d), d) = d {
    match xs {
        Nil => λ d => refl,
        Cons(a, rest) => λ d => {
            let ml = Dyn::model_laws(tys, strs, sl);
            let x = Dyn::at(tys, strs, a, d);
            trans(ml.over_read(a, λ y => Sel::write_at(tys, strs, rest, λ _ => Sel::read_at(tys, strs, rest, x), y), λ _ => x, d, Sel::put_back_path(tys, strs, sl, rest, x)),
                ml.put_back(a, d))
        },
    }
}

theorem CSt::up_stop(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), c, f1: Nat, x: VEnt, rest: List<VEnt>, h: s.ents(c) = Cons(x, rest), sp: x.par.same(c) = True):
    s.up(tys, strs, e, c, Succ(f1)) = e
{
    let br = λ (es: List<VEnt>) => match es as λ _ => Env(tys) { Nil => e, Cons(en, _) => match en.par.same(c) as λ _ => Env(tys) { True => e,
        False => s.up(tys, strs, Env::set(tys, e, s.var_at(en.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(en.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), en.par, f1) } };
    trans(cong_fn(br, h), j(sym(sp), λ b _ => (match b as λ _ => Env(tys) { True => e, False => s.up(tys, strs, Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), x.par, f1) }) = e, refl))
}

// The walk reads an entry's parent and place, not whether it is written back.
theorem CSt::up_rekin(self fu: Nat, s: CSt, tys: Nat → Type, strs: Strs(tys), f: VEnt → VEnt, kf: (x: VEnt) → Kin(f(x), x), tl, wl: List<Nat>): (e: Env(tys)) → (c: Nat) →
    (s.rekin(f, tl, wl)).up(tys, strs, e, c, fu) = s.up(tys, strs, e, c, fu)
{
    match fu {
        Zero => λ e c => refl,
        Succ(f1) => λ e c => {
            let s1 = s.rekin(f, tl, wl);
            (match s.ents(c) as λ es => s.ents(c) = es → s1.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, e, c, Succ(f1)) {
                Nil => λ h => trans(CSt::up_nil(Succ(f1), s1, tys, strs, e, c, trans(VEnt::ents_map(s.views, f, kf, c), cong_fn(λ (es: List<VEnt>) => es.map(f), h))),
                    sym(CSt::up_nil(Succ(f1), s, tys, strs, e, c, h))),
                Cons(x, rest) => λ h => {
                    let h1: (s1.ents(c) = Cons(f(x), rest.map(f))) = trans(VEnt::ents_map(s.views, f, kf, c), cong_fn(λ (es: List<VEnt>) => es.map(f), h));
                    let kx = kf(x);
                    (match x.par.same(c) as λ b => x.par.same(c) = b → s1.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, e, c, Succ(f1)) {
                        True => λ sp => trans(s1.up_stop(tys, strs, e, c, f1, f(x), rest.map(f), h1, trans(cong_fn(λ (n: Nat) => n.same(c), kx.par), sp)),
                            sym(s.up_stop(tys, strs, e, c, f1, x, rest, h, sp))),
                        False => λ np => {
                            let wr = λ (pp: Nat) (aa: List<Step>) => s1.up(tys, strs, Env::set(tys, e, s.var_at(pp), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(aa), λ _ => Env::get(tys, e, s.var_at(c)), d)), pp, f1);
                            trans(s1.up_step(tys, strs, e, c, f1, f(x), rest.map(f), h1, trans(cong_fn(λ (n: Nat) => n.same(c), kx.par), np)),
                                trans(trans(cong_fn(λ (pp: Nat) => wr(pp, (f(x)).at), kx.par), cong_fn(λ (aa: List<Step>) => wr(x.par, aa), kx.at)),
                                    trans(CSt::up_rekin(f1, s, tys, strs, f, kf, tl, wl, Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d)), x.par),
                                        sym(s.up_step(tys, strs, e, c, f1, x, rest, h, np)))))
                        },
                    })(refl)
                },
            })(refl)
        },
    }
}

// The walk past its chain: more fuel changes nothing once it exceeds the level.
theorem CSt::up_more(self fu: Nat, s: CSt, tys: Nat → Type, strs: Strs(tys), lt: (en: VEnt) → Mem(en, s.views) → en.par < en.lvl): (e: Env(tys)) → (c: Nat) → c < fu →
    s.up(tys, strs, e, c, fu) = s.up(tys, strs, e, c, Succ(fu))
{
    match fu {
        Zero => λ e c no => false_elim(Nat::not_succ_le_zero(c, no)),
        Succ(f1) => λ e c cl => (match s.ents(c) as λ es => s.ents(c) = es → s.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, e, c, Succ(Succ(f1))) {
            Nil => λ h => trans(CSt::up_nil(Succ(f1), s, tys, strs, e, c, h), sym(CSt::up_nil(Succ(Succ(f1)), s, tys, strs, e, c, h))),
            Cons(x, rest) => λ h => {
                let mx: Mem(x, s.ents(c)) = j(sym(h), λ es _ => Mem(x, es), Inl(refl));
                let xl: (x.lvl = c) = x.lvl.same_sound(c, s.views.mem_filter_holds(x, λ q => q.lvl.same(c), mx));
                let pc: (x.par < c) = j(xl, λ n _ => x.par < n, lt(x, s.views.mem_filter(x, λ q => q.lvl.same(c), mx)));
                let np: (x.par.same(c) = False) = Nat::same_false(x.par, c, λ eq => Nat::lt_irrefl(c, omega(pc, eq)));
                let e1 = Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d));
                trans(s.up_step(tys, strs, e, c, f1, x, rest, h, np),
                    trans(CSt::up_more(f1, s, tys, strs, lt, e1, x.par, omega(pc, cl)), sym(s.up_step(tys, strs, e, c, Succ(f1), x, rest, h, np))))
            },
        })(refl),
    }
}

// ---------------------------------------------------------------------------
// The write-back: its facts, the state it leaves, the patch at that state

theorem Steps::same_sound(xs: List<Step>): (ys: List<Step>) → Steps::same(xs, ys) = True → xs = ys {
    match xs {
        Nil => λ ys => match ys { Nil => λ _ => refl, Cons(_, _) => λ no => absurd(no) },
        Cons(a, xr) => λ ys => match ys {
            Nil => λ no => absurd(no),
            Cons(b, yr) => λ h => {
                let pp = Bool::and_true_parts(a.same(b), Steps::same(xr, yr), h);
                trans(cong_fn(λ (q: Step) => Cons(q, xr), a.same_sound(b, pp.left)), cong_fn(λ (q: List<Step>) => Cons(b, q), Steps::same_sound(xr, yr, pp.right)))
            },
        },
    }
}

fn VEnt::backed(self en: VEnt, l: Nat) → VEnt { match en.lvl.same(l) { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, True), False => en } }

theorem VEnt::backed_kin(self en: VEnt, l: Nat): Kin(en.backed(l), en) {
    (match en.lvl.same(l) as λ c => Kin(match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, True), False => en }, en) {
        True => Kin(refl, refl, refl, refl, refl, refl),
        False => Kin(refl, refl, refl, refl, refl, refl),
    })
}

theorem VEnt::backed_other(self en: VEnt, l: Nat, ne: ¬(en.lvl = l)): en.backed(l) = en {
    j(sym(Nat::same_false(en.lvl, l, ne)), λ c _ => (match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, True), False => en }) = en, refl)
}

theorem VEnt::backed_back(self en: VEnt, l: Nat, eq: en.lvl = l): (en.backed(l)).back = True {
    let st: (en.lvl.same(l) = True) = j(eq, λ q _ => en.lvl.same(q) = True, en.lvl.same_self());
    j(sym(st), λ c _ => (match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, True), False => en }).back = True, refl)
}

theorem VEnt::unbacked_other(self en: VEnt, l: Nat, ne: ¬(en.lvl = l)): en.unbacked(l) = en {
    j(sym(Nat::same_false(en.lvl, l, ne)), λ c _ => (match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), False => en }) = en, refl)
}

theorem VEnt::unbacked_here(self en: VEnt, l: Nat, eq: en.lvl = l): en.unbacked(l) = VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False) {
    let st: (en.lvl.same(l) = True) = j(eq, λ q _ => en.lvl.same(q) = True, en.lvl.same_self());
    j(sym(st), λ c _ => (match c as λ _ => VEnt { True => VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), False => en }) = VEnt(en.lvl, en.obj, en.reg, en.mode, en.par, en.at, False), refl)
}

// A write-back's flags: the child written back, the parent changed.
fn VEnt::reback(self en: VEnt, lv, l: Nat) → VEnt { (en.backed(lv)).unbacked(l) }

theorem VEnt::reback_kin(self en: VEnt, lv, l: Nat): Kin(en.reback(lv, l), en) {
    let a = (en.backed(lv)).unbacked_kin(l);
    let b = en.backed_kin(lv);
    Kin(trans(a.lvl, b.lvl), trans(a.obj, b.obj), trans(a.reg, b.reg), trans(a.mode, b.mode), trans(a.par, b.par), trans(a.at, b.at))
}

// The state a write-back leaves, as the flags changed by one map.
theorem CSt::back_state(self s: CSt, lv, l: Nat, np: ¬(s.role(l) = KPlain)):
    s.backed(lv).wrote_to(l) = s.rekin(λ (y: VEnt) => y.reback(lv, l), Cons(l, s.touched), Cons(l, s.wrote))
{
    let x = s.backed(lv).written(l).unback(l);
    let wt: (s.backed(lv).wrote_to(l) = x) = (match s.role(l) as λ r => s.role(l) = r → s.backed(lv).wrote_to(l) = x {
        KPlain => λ e => false_elim(np(e)),
        KHold(o, a) => λ e => j(sym(e), λ r _ => (match r as λ _ => CSt { KPlain => s.backed(lv), KHold(_, _) => x, KView => x, KGone => x }) = x, refl),
        KView => λ e => j(sym(e), λ r _ => (match r as λ _ => CSt { KPlain => s.backed(lv), KHold(_, _) => x, KView => x, KGone => x }) = x, refl),
        KGone => λ e => j(sym(e), λ r _ => (match r as λ _ => CSt { KPlain => s.backed(lv), KHold(_, _) => x, KView => x, KGone => x }) = x, refl),
    })(refl);
    trans(wt, cong_fn(λ (vs: List<VEnt>) => CSt(s.args, s.locs, s.na, s.nd, vs, s.nobj, Cons(l, s.touched), Cons(l, s.wrote)),
        List::map_map(s.views, λ (y: VEnt) => y.backed(lv), λ (y: VEnt) => y.unbacked(l))))
}

// After a write-back, an entry pending is at the parent's level, where every
// entry pending before was at the child's.
theorem CSt::pend_back(self s: CSt, lv, l: Nat, at: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = lv,
    x: VEnt, mx: Mem(x, s.views.map(λ (y: VEnt) => y.reback(lv, l))), w: (x.mode.writes() && !x.back) = True): x.lvl = l
{
    match List::mem_map_inv(s.views, λ (y: VEnt) => y.reback(lv, l), x, mx) {
        ⟨en, pen⟩ => {
            let kb = en.backed_kin(lv);
            let xl: (x.lvl = en.lvl) = trans(cong_fn(λ (q: VEnt) => q.lvl, pen.right), (en.reback_kin(lv, l)).lvl);
            match Nat::eq_or_ne(en.lvl, l) {
                Inl(el) => trans(xl, el),
                Inr(nl) => {
                    let xb: (x = en.backed(lv)) = trans(pen.right, (en.backed(lv)).unbacked_other(l, λ eq => nl(trans(sym(kb.lvl), eq))));
                    match Nat::eq_or_ne(en.lvl, lv) {
                        Inl(ev) => {
                            let bk: (x.back = True) = trans(cong_fn(λ (q: VEnt) => q.back, xb), en.backed_back(lv, ev));
                            let w2: ((x.mode.writes() && !True) = True) = j(bk, λ q _ => (x.mode.writes() && !q) = True, w);
                            absurd(trans(sym(w2), Bool::and_false_r(x.mode.writes())))
                        },
                        Inr(nv) => {
                            let xe: (x = en) = trans(xb, en.backed_other(lv, nv));
                            false_elim(nv(at(en, pen.left, j(xe, λ q _ => (q.mode.writes() && !q.back) = True, w))))
                        },
                    }
                },
            }
        },
    }
}

theorem CSt::pending_false(self s: CSt, h: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → False): s.pending() = False {
    Bool::false_of_not(s.pending(), λ t => match s.views.any_bit_sound(λ en => en.mode.writes() && !en.back, t) { ⟨x, px⟩ => h(x, px.left, px.right) })
}

// The patch where every pending entry is at one level: none where that
// level's cell is a copy, its walk where it refers.
theorem CSt::patched_copy(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), k: Nat,
    at: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = k, d: Dyn(tys), pl: (REnv::get(tys, m.env, s.var_at(k))).v = level2::Plain(d)):
    s.patched(tys, strs, e, m) = e
{
    let q = λ (en: VEnt) => en.mode.writes() && !en.back;
    let hh = λ (o: Option<VEnt>) => match o as λ _ => Env(tys) {
        Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, en.lvl, s.na + s.nd), Plain(_) => e },
        None => e,
    };
    (match s.pending() as λ b => s.pending() = b → s.patched(tys, strs, e, m) = e {
        False => λ hp => s.patched_none(tys, strs, e, m, hp),
        True => λ hp => {
            let p1: (s.patched(tys, strs, e, m) = hh(s.views.find(q))) = j(sym(hp), λ b _ => (match b as λ _ => Env(tys) { False => e, True => hh(s.views.find(q)) }) = hh(s.views.find(q)), refl);
            trans(p1, (match s.views.find(q) as λ o => s.views.find(q) = o → hh(o) = e {
                None => λ _ => refl,
                Some(y) => λ hy => {
                    let fs = List::find_sound(s.views, q, y, hy);
                    let yl: (y.lvl = k) = at(y, fs.left, fs.right);
                    j(sym(yl), λ kk _ => (match (REnv::get(tys, m.env, s.var_at(kk))).v as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, kk, s.na + s.nd), Plain(_) => e }) = e,
                        j(sym(pl), λ u _ => (match u as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, k, s.na + s.nd), Plain(_) => e }) = e, refl))
                },
            })(refl))
        },
    })(refl)
}

theorem CSt::patched_pend(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), k: Nat,
    at: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = k, x0: VEnt, mx0: Mem(x0, s.views), w0: (x0.mode.writes() && !x0.back) = True,
    r: Ref, rl: (REnv::get(tys, m.env, s.var_at(k))).v = Refer(r)):
    s.patched(tys, strs, e, m) = s.up(tys, strs, e, k, s.na + s.nd)
{
    let q = λ (en: VEnt) => en.mode.writes() && !en.back;
    let tg = s.up(tys, strs, e, k, s.na + s.nd);
    let hh = λ (o: Option<VEnt>) => match o as λ _ => Env(tys) {
        Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, en.lvl, s.na + s.nd), Plain(_) => e },
        None => e,
    };
    let hp: (s.pending() = True) = s.views.any_bit_mem(q, x0, mx0, w0);
    let p1: (s.patched(tys, strs, e, m) = hh(s.views.find(q))) = j(sym(hp), λ b _ => (match b as λ _ => Env(tys) { False => e, True => hh(s.views.find(q)) }) = hh(s.views.find(q)), refl);
    trans(p1, (match s.views.find(q) as λ o => s.views.find(q) = o → hh(o) = tg {
        None => λ hn => absurd(trans(sym(w0), List::find_none(s.views, q, hn, x0, mx0))),
        Some(y) => λ hy => {
            let fs = List::find_sound(s.views, q, y, hy);
            let yl: (y.lvl = k) = at(y, fs.left, fs.right);
            j(sym(yl), λ kk _ => (match (REnv::get(tys, m.env, s.var_at(kk))).v as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, kk, s.na + s.nd), Plain(_) => e }) = tg,
                j(sym(rl), λ u _ => (match u as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, k, s.na + s.nd), Plain(_) => e }) = tg, refl))
        },
    })(refl))
}

// What a write-back is: the child's one entry, to write, opened on the
// written root at the written place; and the state it leaves.
record BackFacts(tys: Nat → Type, strs: Strs(tys), s: CSt, p: Place, v: Var, n: Next, wi: WriteInv(tys, strs, s, p, v, n)) {
    ce: VEnt,
    he: s.ents(wi.lv) = [ce],
    cw: ce.mode.writes() = True,
    cpar: ce.par = wi.l,
    cat: ce.at = wi.xs,
    nlv: ¬(wi.lv = wi.l),
    nst: n.st = s.backed(wi.lv).wrote_to(wi.l),
}

theorem WriteInv::back_facts(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {p: Place}, {v: Var}, {n: Next}, self wi: WriteInv(tys, strs, s, p, v, n), bk: s.is_back(wi.l, wi.xs, wi.lv) = True):
    BackFacts(tys, strs, s, p, v, n, wi)
{
    let l = wi.l;
    let lv = wi.lv;
    let xs = wi.xs;
    let mt = Bool::then_some(!s.in_regions(l) && !(s.role(l)).same(KGone), match s.is_back(l, xs, lv) as λ _ => Option<Next> { True => Some(checker::Next(s.backed(lv).wrote_to(l), wi.gv.rs ++ wi.ra)),
        False => s.write_at(l, xs).map(λ rl => Next(s.wrote_to(l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })) }, n, wi.last);
    let h1: (Some(checker::Next(s.backed(lv).wrote_to(l), wi.gv.rs ++ wi.ra)) = Some(n)) = j(bk, λ b _ => (match b as λ _ => Option<Next> { True => Some(checker::Next(s.backed(lv).wrote_to(l), wi.gv.rs ++ wi.ra)),
        False => s.write_at(l, xs).map(λ rl => Next(s.wrote_to(l), wi.gv.rs ++ wi.ra ++ rl ++ p.accesses() ++ match Shape::is_seq(tys, strs, wi.c) as λ _ => List<Residual> { True => [RFits(p, v)], False => Nil<Residual>() })) }) = Some(n), mt.right);
    let nst: (n.st = s.backed(lv).wrote_to(l)) = cong_fn(λ (q: Next) => q.st, sym(Option::some_inj(checker::Next(s.backed(lv).wrote_to(l), wi.gv.rs ++ wi.ra), n, h1)));
    let body = λ (es: List<VEnt>) => match es as λ _ => Bool { Cons(e1, rest) => match rest as λ _ => Bool { Nil => e1.mode.writes() && e1.par.same(l) && Steps::same(e1.at, xs) && !lv.same(l), Cons(_, _) => False }, Nil => False };
    (match s.ents(lv) as λ es => s.ents(lv) = es → body(es) = True → BackFacts(tys, strs, s, p, v, n, wi) {
        Nil => λ _ no => absurd(no),
        Cons(ce, rest) => λ eq => (match rest as λ r => s.ents(lv) = Cons(ce, r) → body(Cons(ce, r)) = True → BackFacts(tys, strs, s, p, v, n, wi) {
            Nil => λ eq2 h => {
                let p1 = Bool::and_true_parts(ce.mode.writes() && ce.par.same(l) && Steps::same(ce.at, xs), !lv.same(l), h);
                let p2 = Bool::and_true_parts(ce.mode.writes() && ce.par.same(l), Steps::same(ce.at, xs), p1.left);
                let p3 = Bool::and_true_parts(ce.mode.writes(), ce.par.same(l), p2.left);
                let nf: (lv.same(l) = False) = Bool::not_true_false(lv.same(l), p1.right);
                BackFacts(ce, eq2, p3.left, ce.par.same_sound(l, p3.right), Steps::same_sound(ce.at, xs, p2.right),
                    λ e3 => absurd(trans(sym(j(e3, λ q _ => lv.same(q) = True, lv.same_self())), nf)), nst)
            },
            Cons(_, _) => λ _ no => absurd(no),
        })(eq),
    })(refl, bk)
}

// Setting what is there changes nothing: a list's index, a meaning's
// variable, a block's value.
theorem List::update_fix<A>(self xs: List<A>, f: A → A, x: A, fx: f(x) = x): (i: Nat) → xs.nth(i) = Some(x) → xs.update(i, f) = xs {
    match xs {
        Nil => λ i _ => refl,
        Cons(h, t) => λ i => match i {
            Zero => λ at => {
                let hx: (h = x) = Option::some_inj(h, x, at);
                cong_fn(λ (q: A) => Cons(q, t), trans(cong_fn(f, hx), trans(fx, sym(hx))))
            },
            Succ(k) => λ at => cong_fn(λ (q: List<A>) => Cons(h, q), t.update_fix(f, x, fx, k, at)),
        },
    }
}

theorem Env::set_fix(tys: Nat → Type, e: Env(tys), x: Var, f: Dyn(tys) → Dyn(tys), b: Var::In(x, e.args.len(), e.locs.len()), fx: f(Env::get(tys, e, x)) = Env::get(tys, e, x)):
    Env::set(tys, e, x, f) = e
{
    (match x as λ y => Var::In(y, e.args.len(), e.locs.len()) → f(Env::get(tys, e, y)) = Env::get(tys, e, y) → Env::set(tys, e, y, f) = e {
        Arg(i) => λ bi fx2 => match e.args.nth_present(i, bi) {
            ⟨d, pd⟩ => {
                let fd: (f(d) = d) = j(pd, λ o _ => f(o.unwrap_or(Dyn::none(tys))) = o.unwrap_or(Dyn::none(tys)), fx2);
                cong_fn(λ (q: List<Dyn(tys)>) => Env(q, e.locs), e.args.update_fix(f, d, fd, i, pd))
            },
        },
        Loc(k) => λ bi fx2 => match e.locs.nth_present(k, bi) {
            ⟨d, pd⟩ => {
                let fd: (f(d) = d) = j(pd, λ o _ => f(o.unwrap_or(Dyn::none(tys))) = o.unwrap_or(Dyn::none(tys)), fx2);
                cong_fn(λ (q: List<Dyn(tys)>) => Env(e.args, q), e.locs.update_fix(f, d, fd, k, pd))
            },
        },
    })(b, fx)
}

theorem Heap::store_val(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), b: Nat, d: Dyn(tys), hv: Heap::val(tys, strs, h, b) = Some(d),
    bare: (ob: Obj(tys)) → Heap::obj(tys, h, b) = Some(ob) → ob.holes = Nil): Heap::store(tys, h, b, d) = h
{
    let f: Block(tys) → Block(tys) = λ bl => match bl { Live(o) => Live(Obj(d, o.holes)), Dead => Dead };
    let ob2: Option<Block(tys)> → Option<Obj(tys)> = λ q => match q { Some(bl) => match bl { Live(o) => Some(o), Dead => None<Obj(tys)>() }, None => None<Obj(tys)>() };
    let rd = λ (q: Option<Block(tys)>) => match ob2(q) as λ _ => Option<Dyn(tys)> { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None<Dyn(tys)>() };
    (match h.nth(b) as λ q => h.nth(b) = q → rd(q) = Some(d) → Heap::store(tys, h, b, d) = h {
        None => λ _ no => absurd(no),
        Some(bl) => λ e1 => (match bl as λ x => h.nth(b) = Some(x) → rd(Some(x)) = Some(d) → Heap::store(tys, h, b, d) = h {
            Dead => λ _ no => absurd(no),
            Live(o) => λ e2 r2 => {
                let hn: (o.holes = Nil) = bare(o, cong_fn(ob2, e2));
                let dv: (o.val = d) = Option::some_inj(o.val, d, trans(sym(Obj::read_bare(tys, strs, h, h.len(), o, hn)), r2));
                h.update_fix(f, Live(o), cong_fn(λ (q: Dyn(tys)) => Live(Obj(q, o.holes)), sym(dv)), b, e2)
            },
        })(e1),
    })(refl, hv)
}

// A child's reference, where the chain refers: its parent's, narrowed by its
// place.
theorem Inv::ref_child(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    l, lv: Nat, ce: VEnt, he: s.ents(lv) = [ce], cw: ce.mode.writes() = True, cpar: ce.par = l, lvb: lv < s.na + s.nd, qp, qc: Ref,
    hp: (REnv::get(tys, m.env, s.var_at(l))).v = Refer(qp), hc: (REnv::get(tys, m.env, s.var_at(lv))).v = Refer(qc)):
    qc = qp.narrow(Mach::ixs(tys, strs, m), s.unsteps(ce.at))
{
    let ws = Mach::ixs(tys, strs, m);
    let mpe: Mem(ce, s.ents(lv)) = j(sym(he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(lv), mpe);
    let cl: (ce.lvl = lv) = ce.lvl.same_sound(lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(lv), mpe));
    let roc: (s.role(lv) = KView) = j(cl, λ q _ => s.role(q) = KView, (inv.vents(ce, mce)).right.right);
    let ch = inv.chain(ce, mce);
    let lb: (l < s.na + s.nd) = j(cpar, λ q _ => q < s.na + s.nd, omega(ch.left, (inv.vents(ce, mce)).right.left));
    let rc0: VEnt::Any(s.ents(lv), λ en => ((inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qc))) =
        j(roc, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(qc), KView => VEnt::Any(s.ents(lv), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qc)),
            KPlain => False, KGone => True }, inv.refs(s.var_at(lv), lv, s.lvl_var_at(lv, lvb), qc, hc));
    let rc1: ((inv.root(ce.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(ce.reg))) = Some(qc)) =
        match j(he, λ q _ => VEnt::Any(q, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qc)), rc0) { Inl(x) => x, Inr(no) => false_elim(no) };
    let rp0 = inv.refs(s.var_at(l), l, s.lvl_var_at(l, lb), qp, hp);
    let rv0: (s.role(ce.par) = s.role(l)) = cong_fn(λ (q: Nat) => s.role(q), cpar);
    (match s.role(l) as λ r => s.role(l) = r → qc = qp.narrow(ws, s.unsteps(ce.at)) {
        KHold(o, a) => λ hr => {
            let ph = s.parent_hold(ce, o, a, trans(rv0, hr), ch.right);
            let rt: (inv.root(o) = Some(qp)) = j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(qp), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qp)),
                KPlain => False, KGone => True }, rp0);
            let rt2: (inv.root(ce.obj) = Some(qp)) = j(ph.left, λ q _ => inv.root(q) = Some(qp), rt);
            let c1: (Some(qp.narrow(ws, s.unsteps(ce.reg))) = Some(qc)) = j(rt2, λ q _ => q.map(λ r0 => r0.narrow(ws, s.unsteps(ce.reg))) = Some(qc), rc1);
            trans(sym(Option::some_inj(qp.narrow(ws, s.unsteps(ce.reg)), qc, c1)), cong_fn(λ (xs: List<Step>) => qp.narrow(ws, s.unsteps(xs)), ph.right))
        },
        KView => λ hr => {
            let rv: (s.role(ce.par) = KView) = trans(rv0, hr);
            match inv.wpar(ce, mce, cw)(rv) {
                ⟨pe, ppe⟩ => {
                    let po = s.parent_one(ce, pe, rv, ppe.left, ch.right);
                    let rp1: VEnt::Any(s.ents(l), λ en => ((inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qp))) =
                        j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(qp), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qp)),
                            KPlain => False, KGone => True }, rp0);
                    let eo: (s.ents(l) = [pe]) = j(cpar, λ q _ => s.ents(q) = [pe], ppe.left);
                    let rp2: ((inv.root(pe.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(pe.reg))) = Some(qp)) =
                        match j(eo, λ q _ => VEnt::Any(q, λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(qp)), rp1) { Inl(x) => x, Inr(no) => false_elim(no) };
                    match Option::map_some_inv(inv.root(pe.obj), λ r0 => r0.narrow(ws, s.unsteps(pe.reg)), qp, rp2) {
                        ⟨r0, pr⟩ => {
                            let rt2: (inv.root(ce.obj) = Some(r0)) = j(po.left, λ q _ => inv.root(q) = Some(r0), pr.left);
                            let c1: (Some(r0.narrow(ws, s.unsteps(ce.reg))) = Some(qc)) = j(rt2, λ q _ => q.map(λ r1 => r1.narrow(ws, s.unsteps(ce.reg))) = Some(qc), rc1);
                            let nar: (r0.narrow(ws, s.unsteps(ce.reg)) = qp.narrow(ws, s.unsteps(ce.at))) =
                                trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, s.unsteps(xs)), po.right),
                                    trans(cong_fn(λ (xs: List<Step>) => r0.narrow(ws, xs), s.unsteps_app(pe.reg, ce.at)),
                                        trans(Ref::narrow_app(r0, ws, s.unsteps(pe.reg), s.unsteps(ce.at)), cong_fn(λ (q: Ref) => q.narrow(ws, s.unsteps(ce.at)), pr.right))));
                            trans(sym(Option::some_inj(r0.narrow(ws, s.unsteps(ce.reg)), qc, c1)), nar)
                        },
                    }
                },
            }
        },
        KPlain => λ hr => false_elim(s.parent_plain(ce, trans(rv0, hr), ch.right)),
        KGone => λ hr => false_elim(j(trans(rv0, hr), λ q _ => match q { KHold(o2, _) => (o2 = ce.obj) ∧ (ce.reg = ce.at), KView => VEnt::Any(s.ents(ce.par), λ pe => (pe.obj = ce.obj) ∧ (ce.reg = pe.reg ++ ce.at)),
            KPlain => False, KGone => False }, ch.right)),
    })(refl)
}

// The run of a write-back where the chain refers: it stores into the
// block what the block holds at the place, and so changes nothing; what the
// child reads is what the parent reads at the place.
theorem Stmt::back_runs_ref(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), fns: Nat → Func, call: Caller(tys), m: Mach(tys), p: Place, v: Var, dp, dv: Dyn(tys), qp: Ref,
    hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp), hc: (REnv::get(tys, m.env, v)).v = Refer(qp.narrow(Mach::ixs(tys, strs, m), p.steps)),
    rp: Value::Reads(tys, strs, m.heap, Refer(qp), dp), rc: Value::Reads(tys, strs, m.heap, Refer(qp.narrow(Mach::ixs(tys, strs, m), p.steps)), dv),
    bare: (ob: Obj(tys)) → Heap::obj(tys, m.heap, qp.b) = Some(ob) → ob.holes = Nil):
    Stmt::Continues(tys, strs, fns, call, Write(p, v), m, m) ∧ ((dv = Sel::read_at(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), dp)) ∧ (Sel::fit(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), dp) = True))
{
    let a = Steps::sels(p.steps, Mach::ixs(tys, strs, m));
    let qc = qp.narrow(Mach::ixs(tys, strs, m), p.steps);
    match Value::refer_inv(tys, strs, m.heap, qp, dp, rp) {
        ⟨ob, pob⟩ => match Value::refer_inv(tys, strs, m.heap, qc, dv, rc) {
            ⟨ob2, pob2⟩ => {
                let same: (ob2 = ob) = Option::some_inj(ob2, ob, trans(sym(pob2.left), pob.left));
                let fc: (Sel::fit(tys, strs, qp.sels ++ a, ob) = True) = j(same, λ q _ => Sel::fit(tys, strs, qp.sels ++ a, q) = True, pob2.right.left);
                let rcv: (Sel::read_at(tys, strs, qp.sels ++ a, ob) = dv) = j(same, λ q _ => Sel::read_at(tys, strs, qp.sels ++ a, q) = dv, pob2.right.right);
                let fparts = Bool::and_true_parts(Sel::fit(tys, strs, qp.sels, ob), Sel::fit(tys, strs, a, Sel::read_at(tys, strs, qp.sels, ob)), trans(sym(Sel::fit_append(tys, strs, qp.sels, a, ob)), fc));
                let fa: (Sel::fit(tys, strs, a, dp) = True) = j(pob.right.right, λ q _ => Sel::fit(tys, strs, a, q) = True, fparts.right);
                let ra: (dv = Sel::read_at(tys, strs, a, dp)) = trans(sym(rcv), trans(Sel::read_append(tys, strs, qp.sels, a, ob), cong_fn(λ (q: Dyn(tys)) => Sel::read_at(tys, strs, a, q), pob.right.right)));
                let pb: (Sel::write_at(tys, strs, qp.sels ++ a, λ _ => dv, ob) = ob) =
                    j(rcv, λ q _ => Sel::write_at(tys, strs, qp.sels ++ a, λ _ => q, ob) = ob, Sel::put_back_path(tys, strs, sl, qp.sels ++ a, ob));
                let put: (Sel::put(tys, strs, qp.sels ++ a, dv, ob) = Some(ob)) = trans(Sel::put_fit(tys, strs, qp.sels ++ a, dv, ob, fc), cong_fn(λ (q: Dyn(tys)) => Some(q), pb));
                let vx: (Mach::val(tys, strs, m, v) = Some(dv)) = j(sym(hc), λ u _ => Value::get(tys, strs, m.heap, u, Nil) = Some(dv), rc);
                let st: (Heap::store(tys, m.heap, qp.b, ob) = m.heap) = Heap::store_val(tys, strs, m.heap, qp.b, ob, pob.left, bare);
                ⟨λ k => trans(Stmt::write_runs_ref(tys, strs, fns, call, m, p, v, dv, vx, qp, hp, ob, pob.left, ob, put, k), cong_fn(λ (hh: Heap(tys)) => k(Mach(hh, m.env, m.io)), st)), ⟨ra, fa⟩⟩
            },
        },
    }
}

theorem Cell::agrees_reads(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Role, c: Cell(tys), d: Dyn(tys), ag: Cell::Agrees(tys, strs, h, r, c, d), nr: ¬(r = KPlain), ng: ¬(r = KGone)):
    Value::Reads(tys, strs, h, c.v, d)
{
    (match r as λ q => Cell::Agrees(tys, strs, h, q, c, d) → ¬(q = KPlain) → ¬(q = KGone) → Value::Reads(tys, strs, h, c.v, d) {
        KPlain => λ _ no _ => false_elim(no(refl)),
        KGone => λ _ _ no => false_elim(no(refl)),
        KHold(_, _) => λ a _ _ => a,
        KView => λ a _ _ => a,
    })(ag, nr, ng)
}

theorem VEnt::any_ex(self es: List<VEnt>, P: VEnt → Type): VEnt::Any(es, P) → Exists<VEnt>(λ en => P(en)) {
    match es {
        Nil => λ no => false_elim(no),
        Cons(en, rest) => λ a => match a { Inl(x) => Exists(en, x), Inr(y) => VEnt::any_ex(rest, P, y) },
    }
}

// Every live reference is into a block with no holes.
theorem Inv::ref_bare(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    x: Var, l: Nat, hx: s.lvl(x) = Some(l), ng: ¬(s.role(l) = KGone), r: Ref, cr: (REnv::get(tys, m.env, x)).v = Refer(r)):
    (ob: Obj(tys)) → Heap::obj(tys, m.heap, r.b) = Some(ob) → ob.holes = Nil
{
    let ws = Mach::ixs(tys, strs, m);
    let ro = inv.refs(x, l, hx, r, cr);
    (match s.role(l) as λ q => s.role(l) = q → (ob: Obj(tys)) → Heap::obj(tys, m.heap, r.b) = Some(ob) → ob.holes = Nil {
        KHold(o, a) => λ hr => inv.bare(o, r, j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
        KPlain => False, KGone => True }, ro)),
        KView => λ hr => match VEnt::any_ex(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r), j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
        KPlain => False, KGone => True }, ro)) {
            ⟨en, pe⟩ => match Option::map_some_inv(inv.root(en.obj), λ r0 => r0.narrow(ws, s.unsteps(en.reg)), r, pe) {
                ⟨r0, pr⟩ => j(cong_fn(λ (q: Ref) => q.b, pr.right), λ bb _ => (ob: Obj(tys)) → Heap::obj(tys, m.heap, bb) = Some(ob) → ob.holes = Nil, inv.bare(en.obj, r0, pr.left)),
            },
        },
        KPlain => λ hr => false_elim(j(hr, λ q _ => match q { KHold(o2, _) => inv.root(o2) = Some(r), KView => VEnt::Any(s.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s.unsteps(en.reg))) = Some(r)),
        KPlain => False, KGone => True }, ro)),
        KGone => λ hr => false_elim(ng(hr)),
    })(refl)
}

// The state after a write-back: its pending entries at one level; the patch
// there where the parent is a holder (none) or a view to write (its walk).
theorem CSt::back_pone(self s: CSt, lv, l: Nat, at0: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = lv, tl, wl: List<Nat>):
    (s.rekin(λ (y: VEnt) => y.reback(lv, l), tl, wl)).POne()
{
    λ x1 x2 m1 m2 w1 w2 => trans(s.pend_back(lv, l, at0, x1, m1, w1), sym(s.pend_back(lv, l, at0, x2, m2, w2)))
}

theorem CSt::back_patched_hold(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), lv, l, o: Nat, a: Acc, hr: s.role(l) = KHold(o, a),
    at0: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = lv, vents: (en: VEnt) → Mem(en, s.views) → s.role(en.lvl) = KView, tl, wl: List<Nat>):
    (s.rekin(λ (y: VEnt) => y.reback(lv, l), tl, wl)).patched(tys, strs, e, m) = e
{
    let f = λ (y: VEnt) => y.reback(lv, l);
    let s1 = s.rekin(f, tl, wl);
    s1.patched_none(tys, strs, e, m, s1.pending_false(λ x mx w => {
        let xl = s.pend_back(lv, l, at0, x, mx, w);
        match s.pre_rekin(f, λ y => y.reback_kin(lv, l), tl, wl, x, mx) {
            ⟨en, pe⟩ => absurd(trans(sym(hr), j(trans(sym(pe.right.lvl), xl), λ q _ => s.role(q) = KView, vents(en, pe.left)))),
        }
    }))
}

theorem CSt::back_patched_view(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), lv, l: Nat, pe: VEnt, hpe: s.ents(l) = [pe], pw: pe.mode.writes() = True,
    nlv: ¬(l = lv), at0: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = lv, r: Ref, rl: (REnv::get(tys, m.env, s.var_at(l))).v = Refer(r), tl, wl: List<Nat>):
    (s.rekin(λ (y: VEnt) => y.reback(lv, l), tl, wl)).patched(tys, strs, e, m) = s.up(tys, strs, e, l, s.na + s.nd)
{
    let f = λ (y: VEnt) => y.reback(lv, l);
    let s1 = s.rekin(f, tl, wl);
    let mpe: Mem(pe, s.ents(l)) = j(sym(hpe), λ es _ => Mem(pe, es), Inl(refl));
    let pmem: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(l), mpe);
    let pl: (pe.lvl = l) = pe.lvl.same_sound(l, s.views.mem_filter_holds(pe, λ q => q.lvl.same(l), mpe));
    let x0 = VEnt(pe.lvl, pe.obj, pe.reg, pe.mode, pe.par, pe.at, False);
    let fx: (pe.reback(lv, l) = x0) = trans(cong_fn(λ (q: VEnt) => q.unbacked(l), pe.backed_other(lv, λ eq => nlv(trans(sym(pl), eq)))), pe.unbacked_here(l, pl));
    let mx0: Mem(x0, s1.views) = j(fx, λ q _ => Mem(q, s.views.map(f)), List::mem_map(s.views, pe, f, pmem));
    let w0: ((x0.mode.writes() && !x0.back) = True) = j(sym(pw), λ c _ => (c && !False) = True, refl);
    trans(s1.patched_pend(tys, strs, e, m, l, λ x mx w => s.pend_back(lv, l, at0, x, mx, w), x0, mx0, w0, r, rl),
        CSt::up_rekin(s.na + s.nd, s, tys, strs, f, λ y => y.reback_kin(lv, l), tl, wl, e, l))
}

// The invariant at the state a write-back leaves, given the meaning's
// agreement there.
theorem Inv::back_finish(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {ex: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, ex, m, h0, lent),
    lv, l: Nat, np: ¬(s.role(l) = KPlain), at0: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = lv, e2: Env(tys),
    sim1: Sim(tys, strs, s.rekin(λ (y: VEnt) => y.reback(lv, l), Cons(l, s.touched), Cons(l, s.wrote)),
        (s.rekin(λ (y: VEnt) => y.reback(lv, l), Cons(l, s.touched), Cons(l, s.wrote))).patched(tys, strs, e2, m), m)):
    Inv(tys, strs, s.backed(lv).wrote_to(l), e2, m, h0, lent)
{
    j(sym(s.back_state(lv, l, np)), λ q _ => Inv(tys, strs, q, e2, m, h0, lent),
        Inv::rekin(tys, strs, inv, λ (y: VEnt) => y.reback(lv, l), λ x => x.reback_kin(lv, l), Cons(l, s.touched), Cons(l, s.wrote), e2,
            s.back_pone(lv, l, at0, Cons(l, s.touched), Cons(l, s.wrote)), sim1))
}

// A write-back's parent is neither plain nor gone; where the parent refers,
// so does the child.
theorem Stmt::back_roles(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, strs, s, p, v, n), bf: BackFacts(tys, strs, s, p, v, n, wi)):
    (¬(s.role(wi.l) = KPlain)) ∧ (¬(s.role(wi.l) = KGone))
{
    let ce = bf.ce;
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cp = Bool::and_true_parts(!s.in_regions(wi.l), !(s.role(wi.l)).same(KGone), wi.cond(tys, strs));
    let nf: ((s.role(wi.l)).same(KGone) = False) = Bool::not_true_false((s.role(wi.l)).same(KGone), cp.right);
    ⟨λ eq => s.parent_plain(ce, trans(cong_fn(λ (q: Nat) => s.role(q), bf.cpar), eq), (inv.chain(ce, mce)).right),
     λ eq => absurd(trans(sym(j(sym(eq), λ q _ => q.same(KGone) = True, refl)), nf))⟩
}

theorem Stmt::back_child_refers(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, strs, s, p, v, n), bf: BackFacts(tys, strs, s, p, v, n, wi), qp: Ref, hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp)):
    Exists<Ref>(λ qc => (REnv::get(tys, m.env, v)).v = Refer(qc))
{
    let ce = bf.ce;
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cl: (ce.lvl = wi.lv) = ce.lvl.same_sound(wi.lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(wi.lv), mpe));
    let un = inv.uni(ce, mce, v, p.root, trans(wi.hlv, cong_fn(λ (q: Nat) => Some(q), sym(cl))), trans(wi.hl, cong_fn(λ (q: Nat) => Some(q), sym(bf.cpar))));
    let rt: (Value::refers(tys, (REnv::get(tys, m.env, v)).v) = True) = trans(un, cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), hp));
    (match (REnv::get(tys, m.env, v)).v as λ u => (REnv::get(tys, m.env, v)).v = u → Value::refers(tys, u) = True → Exists<Ref>(λ qc => (REnv::get(tys, m.env, v)).v = Refer(qc)) {
        Plain(_) => λ _ no => absurd(no),
        Refer(qc) => λ hc _ => Exists(qc, hc),
    })(refl, rt)
}

// What the run of a write-back where the chain refers reads and leaves.
record BackRun(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), m: Mach(tys), p: Place, v: Var, dp, dv: Dyn(tys)) {
    ob: Dyn(tys),
    qp: Ref,
    hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp),
    hv: Heap::val(tys, strs, m.heap, qp.b) = Some(ob),
    fp: Sel::fit(tys, strs, qp.sels, ob) = True,
    rdp: Sel::read_at(tys, strs, qp.sels, ob) = dp,
    runs: Stmt::Continues(tys, strs, fns, call, Write(p, v), m, m),
    rv: dv = Sel::read_at(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), dp),
    fa: Sel::fit(tys, strs, Steps::sels(p.steps, Mach::ixs(tys, strs, m)), dp) = True,
}

theorem Stmt::back_ref_run(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), ee: Env(tys), sim: Sim(tys, cx.strs, s, ee, m), {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n),
    bf: BackFacts(tys, cx.strs, s, p, v, n, wi), qp: Ref, hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp)):
    BackRun(tys, cx.strs, fns, call, m, p, v, Env::get(tys, ee, p.root), Env::get(tys, ee, v))
{
    let strs = cx.strs;
    let ws = Mach::ixs(tys, strs, m);
    let ce = bf.ce;
    let lvb: (wi.lv < s.na + s.nd) = s.lvl_below(v, wi.lv, wi.hlv);
    let vat: (s.var_at(wi.lv) = v) = s.lvl_var(v, wi.lv, wi.hlv);
    let rat: (s.var_at(wi.l) = p.root) = s.lvl_var(p.root, wi.l, wi.hl);
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cl: (ce.lvl = wi.lv) = ce.lvl.same_sound(wi.lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(wi.lv), mpe));
    let rov: (s.role(wi.lv) = KView) = j(cl, λ q _ => s.role(q) = KView, (inv.vents(ce, mce)).right.right);
    let ro = Stmt::back_roles(tys, strs, inv, wi, bf);
    let hp2: ((REnv::get(tys, m.env, s.var_at(wi.l))).v = Refer(qp)) = j(sym(rat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(qp), hp);
    let unst: (s.unsteps(ce.at) = p.steps) = j(sym(bf.cat), λ q _ => s.unsteps(q) = p.steps, CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs));
    match Stmt::back_child_refers(tys, strs, inv, wi, bf, qp, hp) {
        ⟨qc, hc⟩ => {
            let qeq: (qc = qp.narrow(ws, p.steps)) = trans(Inv::ref_child(tys, strs, inv, wi.l, wi.lv, ce, bf.he, bf.cw, bf.cpar, lvb, qp, qc, hp2,
                j(sym(vat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(qc), hc)), cong_fn(λ (xs: List<Step>) => qp.narrow(ws, xs), unst));
            let hc2: ((REnv::get(tys, m.env, v)).v = Refer(qp.narrow(ws, p.steps))) = trans(hc, cong_fn(λ (q: Ref) => Refer(q), qeq));
            let rp0 = Cell::agrees_reads(tys, strs, m.heap, s.role(wi.l), REnv::get(tys, m.env, p.root), Env::get(tys, ee, p.root), sim.vars(p.root, wi.l, wi.hl), ro.left, ro.right);
            let rp: Value::Reads(tys, strs, m.heap, Refer(qp), Env::get(tys, ee, p.root)) = j(hp, λ u _ => Value::Reads(tys, strs, m.heap, u, Env::get(tys, ee, p.root)), rp0);
            let rc0: Value::Reads(tys, strs, m.heap, (REnv::get(tys, m.env, v)).v, Env::get(tys, ee, v)) =
                j(rov, λ q _ => Cell::Agrees(tys, strs, m.heap, q, REnv::get(tys, m.env, v), Env::get(tys, ee, v)), sim.vars(v, wi.lv, wi.hlv));
            let rc: Value::Reads(tys, strs, m.heap, Refer(qp.narrow(ws, p.steps)), Env::get(tys, ee, v)) = j(hc2, λ u _ => Value::Reads(tys, strs, m.heap, u, Env::get(tys, ee, v)), rc0);
            let rr = Stmt::back_runs_ref(tys, strs, sl, fns, call, m, p, v, Env::get(tys, ee, p.root), Env::get(tys, ee, v), qp, hp, hc2, rp, rc,
                Inv::ref_bare(tys, strs, inv, p.root, wi.l, wi.hl, ro.right, qp, hp));
            match Value::refer_inv(tys, strs, m.heap, qp, Env::get(tys, ee, p.root), rp) {
                ⟨ob, pob⟩ => BackRun(ob, qp, hp, pob.left, pob.right.left, pob.right.right, rr.left, rr.right.left, rr.right.right),
            }
        },
    }
}

// A write-back where the chain refers and nothing is pending: the run
// changes nothing and so does the meaning; the parent, if a view, is now
// pending, its walk writing up what its ancestors already hold.
theorem Stmt::stage_back_ref_none(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), none: s.pending() = False, {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n), bf: BackFacts(tys, cx.strs, s, p, v, n, wi),
    qp: Ref, hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let nl = s.na + s.nd;
    let ce = bf.ce;
    let sim = Inv::sim_now(tys, strs, inv, none);
    let br = Stmt::back_ref_run(tys, cx, sl, fns, call, inv, e, sim, wi, bf, qp, hp);
    let wsm = Mach::ixs(tys, strs, m);
    let wse = Env::ixs(tys, e);
    let a = Steps::sels(p.steps, wsm);
    let er = Env::get(tys, e, p.root);
    let g = λ (_: Dyn(tys)) => Env::get(tys, e, v);
    let same: (Steps::sels(p.steps, wsm) = Steps::sels(p.steps, wse)) = Sim::steps_same(p.steps, tys, strs, s, e, m, sim, wi.xs, wi.hxs, wi.ra, wi.hra);
    let fx: (Dyn::write(tys, strs, wse, p.steps, g, er) = er) =
        trans(Steps::write_sels(tys, strs, wse, p.steps, g, er), trans(cong_fn(λ (ss: List<Sel>) => Sel::write_at(tys, strs, ss, g, er), sym(same)),
            j(sym(br.rv), λ q _ => Sel::write_at(tys, strs, a, λ _ => q, er) = er, Sel::put_back_path(tys, strs, sl, a, er))));
    let rin = s.var_inside(p.root, wi.l, wi.hl);
    let ein: Var::In(p.root, e.args.len(), e.locs.len()) = j(sym(sim.elocs), λ q _ => Var::In(p.root, e.args.len(), q), j(sym(sim.eargs), λ q _ => Var::In(p.root, q, s.nd), rin));
    let e3e: (Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, wse, p.steps, g, d)) = e) = Env::set_fix(tys, e, p.root, λ d => Dyn::write(tys, strs, wse, p.steps, g, d), ein, fx);
    let at0: ((x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = wi.lv) =
        λ x mx w => absurd(trans(sym(none), s.views.any_bit_mem(λ en => en.mode.writes() && !en.back, x, mx, w)));
    let ro = Stmt::back_roles(tys, strs, inv, wi, bf);
    let rat: (s.var_at(wi.l) = p.root) = s.lvl_var(p.root, wi.l, wi.hl);
    let hp2: ((REnv::get(tys, m.env, s.var_at(wi.l))).v = Refer(qp)) = j(sym(rat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(qp), hp);
    let s1 = s.rekin(λ (y: VEnt) => y.reback(wi.lv, wi.l), Cons(wi.l, s.touched), Cons(wi.l, s.wrote));
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let lb: (wi.l < nl) = j(bf.cpar, λ q _ => q < nl, omega((inv.chain(ce, mce)).left, (inv.vents(ce, mce)).right.left));
    let sim1: Sim(tys, strs, s1, s1.patched(tys, strs, e, m), m) = (match s.role(wi.l) as λ r => s.role(wi.l) = r → Sim(tys, strs, s1, s1.patched(tys, strs, e, m), m) {
        KHold(o, ac) => λ hr => j(sym(s.back_patched_hold(tys, strs, e, m, wi.lv, wi.l, o, ac, hr, at0, λ en mem => (inv.vents(en, mem)).right.right, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))),
            λ z _ => Sim(tys, strs, s1, z, m), sim),
        KView => λ hr => match inv.wpar(ce, mce, bf.cw)(trans(cong_fn(λ (q: Nat) => s.role(q), bf.cpar), hr)) {
            ⟨pe, ppe⟩ => {
                let hpe: (s.ents(wi.l) = [pe]) = j(bf.cpar, λ q _ => s.ents(q) = [pe], ppe.left);
                let mpp: Mem(pe, s.ents(wi.l)) = j(sym(hpe), λ es _ => Mem(pe, es), Inl(refl));
                let pmem: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(wi.l), mpp);
                let ev1: (Env::get(tys, e, v) = Sel::read_at(tys, strs, a, Sel::read_at(tys, strs, br.qp.sels, br.ob))) = trans(br.rv, cong_fn(λ (q: Dyn(tys)) => Sel::read_at(tys, strs, a, q), sym(br.rdp)));
                let ev2: (Env::get(tys, e, v) = Sel::read_at(tys, strs, br.qp.sels ++ a, br.ob)) = trans(ev1, sym(Sel::read_append(tys, strs, br.qp.sels, a, br.ob)));
                let pb: (Sel::write_at(tys, strs, br.qp.sels ++ a, g, br.ob) = br.ob) =
                    j(sym(ev2), λ q _ => Sel::write_at(tys, strs, br.qp.sels ++ a, λ _ => q, br.ob) = br.ob, Sel::put_back_path(tys, strs, sl, br.qp.sels ++ a, br.ob));
                let hq: ((REnv::get(tys, m.env, s.var_at(wi.l))).v = Refer(br.qp)) = j(sym(rat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(br.qp), br.hp);
                let u: UpAt(tys, strs, s, e, m, m.heap, br.qp.b, br.ob, br.ob, g, wi.l, e, pe, br.qp, a) = UpAt(hpe, pmem, ppe.right, hq, refl, br.fp, sym(pb),
                    cong_fn(λ (q: Dyn(tys)) => q.code, ev1), cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), ev1),
                    λ y k hy _ => sim.vars(y, k, hy), λ k _ => refl, λ k _ => refl, sim.codes, sim.eargs, sim.elocs);
                let us = CSt::up_sim(nl, tys, strs, sl, inv, none, wi.l, m.heap, br.qp.b, br.ob, br.ob, g, br.hv, br.hv, wi.l, e, pe, br.qp, a, lb, u);
                let us2: Sim(tys, strs, s, s.up(tys, strs, e, wi.l, nl), m) =
                    j(CSt::up_rekin(nl, s, tys, strs, λ (y: VEnt) => y.unbacked(wi.l), λ x => x.unbacked_kin(wi.l), Cons(wi.l, s.touched), Cons(wi.l, s.wrote), e, wi.l),
                        λ z _ => Sim(tys, strs, s, z, m), us);
                j(sym(s.back_patched_view(tys, strs, e, m, wi.lv, wi.l, pe, hpe, ppe.right, λ eq => bf.nlv(sym(eq)), at0, qp, hp2, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))),
                    λ z _ => Sim(tys, strs, s1, z, m), us2)
            },
        },
        KPlain => λ hr => false_elim(ro.left(hr)),
        KGone => λ hr => false_elim(ro.right(hr)),
    })(refl);
    let iv = Inv::back_finish(tys, strs, inv, wi.lv, wi.l, ro.left, at0, e, sim1);
    Stepped(m, br.runs, j(sym(e3e), λ z _ => Inv(tys, strs, n.st, z, m, h0, lent), j(sym(bf.nst), λ q _ => Inv(tys, strs, q, e, m, h0, lent), iv)))
}

// A write-back where the chain refers and the child is pending: the run
// changes nothing, the heap holding the walk already; the meaning takes the
// walk's first step, and what is pending after is the walk's rest.
theorem Stmt::stage_back_ref_pend(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n), bf: BackFacts(tys, cx.strs, s, p, v, n, wi), cb: bf.ce.back = False,
    qp: Ref, hp: (REnv::get(tys, m.env, p.root)).v = Refer(qp)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let nl = s.na + s.nd;
    let ce = bf.ce;
    let wse = Env::ixs(tys, e);
    let e3 = Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, wse, p.steps, λ _ => Env::get(tys, e, v), d));
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cl: (ce.lvl = wi.lv) = ce.lvl.same_sound(wi.lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(wi.lv), mpe));
    let wce: ((ce.mode.writes() && !ce.back) = True) = j(sym(cb), λ b _ => (ce.mode.writes() && !b) = True, j(sym(bf.cw), λ c _ => (c && !False) = True, refl));
    let at0: ((x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = wi.lv) = λ x mx w => trans(inv.pone(x, ce, mx, mce, w, wce), cl);
    let lvb: (wi.lv < nl) = s.lvl_below(v, wi.lv, wi.hlv);
    let vat: (s.var_at(wi.lv) = v) = s.lvl_var(v, wi.lv, wi.hlv);
    let rat: (s.var_at(wi.l) = p.root) = s.lvl_var(p.root, wi.l, wi.hl);
    let ltc: (ce.par < ce.lvl) = (inv.chain(ce, mce)).left;
    let lb: (wi.l < wi.lv) = j(bf.cpar, λ q _ => q < wi.lv, j(cl, λ q _ => ce.par < q, ltc));
    let ro = Stmt::back_roles(tys, strs, inv, wi, bf);
    let hp2: ((REnv::get(tys, m.env, s.var_at(wi.l))).v = Refer(qp)) = j(sym(rat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(qp), hp);
    match Stmt::back_child_refers(tys, strs, inv, wi, bf, qp, hp) {
        ⟨qc, hc⟩ => {
            let ep = s.up(tys, strs, e, wi.lv, nl);
            let peq: (s.patched(tys, strs, e, m) = ep) = s.patched_pend(tys, strs, e, m, wi.lv, at0, ce, mce, wce, qc, j(sym(vat), λ x _ => (REnv::get(tys, m.env, x)).v = Refer(qc), hc));
            let sim: Sim(tys, strs, s, ep, m) = j(peq, λ z _ => Sim(tys, strs, s, z, m), inv.sim);
            let br = Stmt::back_ref_run(tys, cx, sl, fns, call, inv, ep, sim, wi, bf, qp, hp);
            let k1 = nl - 1;
            let kk: (nl = Succ(k1)) = omega(lvb);
            let np0: (ce.par.same(wi.lv) = False) = Nat::same_false(ce.par, wi.lv, λ eq => bf.nlv(trans(sym(eq), bf.cpar)));
            let us: (s.up(tys, strs, e, wi.lv, Succ(k1)) = s.up(tys, strs, Env::set(tys, e, s.var_at(ce.par), λ d => Dyn::write(tys, strs, wse, s.unsteps(ce.at), λ _ => Env::get(tys, e, s.var_at(wi.lv)), d)), ce.par, k1)) =
                s.up_step(tys, strs, e, wi.lv, k1, ce, Nil, bf.he, np0);
            let xx = λ (a: Var) (xs: List<Step>) (b: Var) => Env::set(tys, e, a, λ d => Dyn::write(tys, strs, wse, xs, λ _ => Env::get(tys, e, b), d));
            let parroot: (s.var_at(ce.par) = p.root) = trans(cong_fn(λ (q: Nat) => s.var_at(q), bf.cpar), rat);
            let unst: (s.unsteps(ce.at) = p.steps) = j(sym(bf.cat), λ q _ => s.unsteps(q) = p.steps, CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs));
            let e3eq: (xx(s.var_at(ce.par), s.unsteps(ce.at), s.var_at(wi.lv)) = e3) =
                trans(cong_fn(λ (a: Var) => xx(a, s.unsteps(ce.at), s.var_at(wi.lv)), parroot), trans(cong_fn(λ (xs: List<Step>) => xx(p.root, xs, s.var_at(wi.lv)), unst),
                    cong_fn(λ (b: Var) => xx(p.root, p.steps, b), vat)));
            let epe: (ep = s.up(tys, strs, e3, wi.l, k1)) = trans(cong_fn(λ (q: Nat) => s.up(tys, strs, e, wi.lv, q), kk),
                trans(us, trans(cong_fn(λ (q: Env(tys)) => s.up(tys, strs, q, ce.par, k1), e3eq), cong_fn(λ (c: Nat) => s.up(tys, strs, e3, c, k1), bf.cpar))));
            let s1 = s.rekin(λ (y: VEnt) => y.reback(wi.lv, wi.l), Cons(wi.l, s.touched), Cons(wi.l, s.wrote));
            let sim1: Sim(tys, strs, s1, s1.patched(tys, strs, e3, m), m) = (match s.role(wi.l) as λ r => s.role(wi.l) = r → Sim(tys, strs, s1, s1.patched(tys, strs, e3, m), m) {
                KHold(o, ac) => λ hr => {
                    let nil: (s.up(tys, strs, e3, wi.l, k1) = e3) = CSt::up_nil(k1, s, tys, strs, e3, wi.l, s.ents_hold_nil(λ en mem => (inv.vents(en, mem)).right.right, wi.l, o, ac, hr));
                    j(sym(s.back_patched_hold(tys, strs, e3, m, wi.lv, wi.l, o, ac, hr, at0, λ en mem => (inv.vents(en, mem)).right.right, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))),
                        λ z _ => Sim(tys, strs, s1, z, m), j(trans(epe, nil), λ z _ => Sim(tys, strs, s, z, m), sim))
                },
                KView => λ hr => match inv.wpar(ce, mce, bf.cw)(trans(cong_fn(λ (q: Nat) => s.role(q), bf.cpar), hr)) {
                    ⟨pe, ppe⟩ => {
                        let hpe: (s.ents(wi.l) = [pe]) = j(bf.cpar, λ q _ => s.ents(q) = [pe], ppe.left);
                        let more: (s.up(tys, strs, e3, wi.l, k1) = s.up(tys, strs, e3, wi.l, Succ(k1))) =
                            CSt::up_more(k1, s, tys, strs, λ en mem => (inv.chain(en, mem)).left, e3, wi.l, omega(lb, lvb));
                        let eq2: (ep = s.up(tys, strs, e3, wi.l, nl)) = trans(epe, trans(more, cong_fn(λ (q: Nat) => s.up(tys, strs, e3, wi.l, q), sym(kk))));
                        j(sym(s.back_patched_view(tys, strs, e3, m, wi.lv, wi.l, pe, hpe, ppe.right, λ eq => bf.nlv(sym(eq)), at0, qp, hp2, Cons(wi.l, s.touched), Cons(wi.l, s.wrote))),
                            λ z _ => Sim(tys, strs, s1, z, m), j(eq2, λ z _ => Sim(tys, strs, s, z, m), sim))
                    },
                },
                KPlain => λ hr => false_elim(ro.left(hr)),
                KGone => λ hr => false_elim(ro.right(hr)),
            })(refl);
            let iv = Inv::back_finish(tys, strs, inv, wi.lv, wi.l, ro.left, at0, e3, sim1);
            Stepped(m, br.runs, j(sym(bf.nst), λ q _ => Inv(tys, strs, q, e3, m, h0, lent), iv))
        },
    }
}

theorem Cell::reads_agrees(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Role, c: Cell(tys), d: Dyn(tys), rd: Value::Reads(tys, strs, h, c.v, d), nr: ¬(r = KPlain), ng: ¬(r = KGone)):
    Cell::Agrees(tys, strs, h, r, c, d)
{
    (match r as λ q => ¬(q = KPlain) → ¬(q = KGone) → Cell::Agrees(tys, strs, h, q, c, d) {
        KPlain => λ no _ => false_elim(no(refl)),
        KGone => λ _ no => false_elim(no(refl)),
        KHold(_, _) => λ _ _ => rd,
        KView => λ _ _ => rd,
    })(nr, ng)
}

// Where everything pending is at the child's level: nothing, or the child.
theorem Stmt::back_at0(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, strs, s, p, v, n), bf: BackFacts(tys, strs, s, p, v, n, wi), wb: s.pending() = True → bf.ce.back = False):
    (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = wi.lv
{
    let ce = bf.ce;
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cl: (ce.lvl = wi.lv) = ce.lvl.same_sound(wi.lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(wi.lv), mpe));
    λ x mx w => {
        let pend: (s.pending() = True) = s.views.any_bit_mem(λ en => en.mode.writes() && !en.back, x, mx, w);
        let wce: ((ce.mode.writes() && !ce.back) = True) = j(sym(wb(pend)), λ b _ => (ce.mode.writes() && !b) = True, j(sym(bf.cw), λ c _ => (c && !False) = True, refl));
        trans(inv.pone(x, ce, mx, mce, w, wce), cl)
    }
}

// A write-back where the chain is copies: the parent's copy takes the
// child's at the place, which `cfit` says fits; nothing is patched before
// or after.
theorem Stmt::stage_back_copy(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), {p: Place}, {v: Var}, {n: Next}, wi: WriteInv(tys, cx.strs, s, p, v, n), bf: BackFacts(tys, cx.strs, s, p, v, n, wi),
    at0: (x: VEnt) → Mem(x, s.views) → (x.mode.writes() && !x.back) = True → x.lvl = wi.lv, dp: Dyn(tys), hp: (REnv::get(tys, m.env, p.root)).v = level2::Plain(dp)):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let nl = s.na + s.nd;
    let ce = bf.ce;
    let wsm = Mach::ixs(tys, strs, m);
    let wse = Env::ixs(tys, e);
    let mpe: Mem(ce, s.ents(wi.lv)) = j(sym(bf.he), λ es _ => Mem(ce, es), Inl(refl));
    let mce: Mem(ce, s.views) = s.views.mem_filter(ce, λ q => q.lvl.same(wi.lv), mpe);
    let cl: (ce.lvl = wi.lv) = ce.lvl.same_sound(wi.lv, s.views.mem_filter_holds(ce, λ q => q.lvl.same(wi.lv), mpe));
    let vat: (s.var_at(wi.lv) = v) = s.lvl_var(v, wi.lv, wi.hlv);
    let rat: (s.var_at(wi.l) = p.root) = s.lvl_var(p.root, wi.l, wi.hl);
    let ro = Stmt::back_roles(tys, strs, inv, wi, bf);
    let rov: (s.role(wi.lv) = KView) = j(cl, λ q _ => s.role(q) = KView, (inv.vents(ce, mce)).right.right);
    let hlc: (s.lvl(v) = Some(ce.lvl)) = trans(wi.hlv, cong_fn(λ (q: Nat) => Some(q), sym(cl)));
    let hlp: (s.lvl(p.root) = Some(ce.par)) = trans(wi.hl, cong_fn(λ (q: Nat) => Some(q), sym(bf.cpar)));
    let un = inv.uni(ce, mce, v, p.root, hlc, hlp);
    let rf: (Value::refers(tys, (REnv::get(tys, m.env, v)).v) = False) = trans(un, cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), hp));
    let unst: (s.unsteps(ce.at) = p.steps) = j(sym(bf.cat), λ q _ => s.unsteps(q) = p.steps, CSt::unsteps_steps(p.steps, s, wi.xs, wi.hxs));
    let cp = Bool::and_true_parts(!s.in_regions(wi.l), !(s.role(wi.l)).same(KGone), wi.cond(tys, strs));
    let nrf: (s.in_regions(wi.l) = False) = Bool::not_true_false(s.in_regions(wi.l), cp.left);
    (match (REnv::get(tys, m.env, v)).v as λ u => (REnv::get(tys, m.env, v)).v = u → Value::refers(tys, u) = False →
            Stepped(tys, strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, wse, p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent) {
        Refer(_) => λ _ no => absurd(no),
        Plain(dc) => λ hc _ => {
            let pn: (s.patched(tys, strs, e, m) = e) = s.patched_copy(tys, strs, e, m, wi.lv, at0, dc, j(sym(vat), λ x _ => (REnv::get(tys, m.env, x)).v = level2::Plain(dc), hc));
            let sim: Sim(tys, strs, s, e, m) = j(pn, λ z _ => Sim(tys, strs, s, z, m), inv.sim);
            let old = Env::get(tys, e, p.root);
            let vd = Env::get(tys, e, v);
            let rp0: Value::Reads(tys, strs, m.heap, (REnv::get(tys, m.env, p.root)).v, old) =
                Cell::agrees_reads(tys, strs, m.heap, s.role(wi.l), REnv::get(tys, m.env, p.root), old, sim.vars(p.root, wi.l, wi.hl), ro.left, ro.right);
            let dpo: (dp = old) = Option::some_inj(dp, old, j(hp, λ u _ => Value::Reads(tys, strs, m.heap, u, old), rp0));
            let rc0: Value::Reads(tys, strs, m.heap, (REnv::get(tys, m.env, v)).v, vd) =
                j(rov, λ q _ => Cell::Agrees(tys, strs, m.heap, q, REnv::get(tys, m.env, v), vd), sim.vars(v, wi.lv, wi.hlv));
            let dcv: (dc = vd) = Option::some_inj(dc, vd, j(hc, λ u _ => Value::Reads(tys, strs, m.heap, u, vd), rc0));
            let hpe: ((REnv::get(tys, m.env, p.root)).v = level2::Plain(old)) = trans(hp, cong_fn(λ (q: Dyn(tys)) => level2::Plain(q), dpo));
            let hce: ((REnv::get(tys, m.env, v)).v = level2::Plain(vd)) = trans(hc, cong_fn(λ (q: Dyn(tys)) => level2::Plain(q), dcv));
            let ss = Steps::sels(p.steps, wse);
            let same: (Steps::sels(p.steps, wsm) = ss) = Sim::steps_same(p.steps, tys, strs, s, e, m, sim, wi.xs, wi.hxs, wi.ra, wi.hra);
            let ase: (Steps::sels(s.unsteps(ce.at), wsm) = ss) = trans(cong_fn(λ (xs: List<Step>) => Steps::sels(xs, wsm), unst), same);
            let cf0: CSt::CFitAt(tys, strs, ss, old, vd) = j(ase, λ q _ => CSt::CFitAt(tys, strs, q, old, vd), inv.cfit(ce, mce, p.root, v, hlp, hlc, old, vd, hpe, hce));
            let g = λ (_: Dyn(tys)) => vd;
            let nw = Sel::write_at(tys, strs, ss, g, old);
            let wk = Sel::write_keeps(tys, strs, sl, g, ss, old, cf0.right.left, cf0.right.right);
            let wg = Sel::write_get(tys, strs, sl, g, ss, old, cf0.left, cf0.right.left, cf0.right.right);
            let put: (Sel::put(tys, strs, Steps::sels(p.steps, wsm), vd, old) = Some(nw)) = j(sym(same), λ q _ => Sel::put(tys, strs, q, vd, old) = Some(nw), Sel::put_fit(tys, strs, ss, vd, old, cf0.left));
            let vx: (Mach::val(tys, strs, m, v) = Some(vd)) = j(sym(hce), λ u _ => Value::get(tys, strs, m.heap, u, Nil) = Some(vd), refl);
            let c2 = Cell(level2::Plain(nw), (REnv::get(tys, m.env, p.root)).own);
            let m2: Mach(tys) = Mach(m.heap, REnv::set(tys, m.env, p.root, c2), m.io);
            let f2 = λ (d: Dyn(tys)) => Dyn::write(tys, strs, wse, p.steps, g, d);
            let e2 = Env::set(tys, e, p.root, f2);
            let wsv: (f2(old) = nw) = Steps::write_sels(tys, strs, wse, p.steps, g, old);
            let agr: Cell::Agrees(tys, strs, m.heap, s.role(wi.l), c2, f2(old)) =
                Cell::reads_agrees(tys, strs, m.heap, s.role(wi.l), c2, f2(old), cong_fn(λ (q: Dyn(tys)) => Some(q), sym(wsv)), ro.left, ro.right);
            let code: ((f2(old)).code = (s.var(wi.l)).code) = trans(cong_fn(λ (q: Dyn(tys)) => q.code, wsv), trans(wk.left, sim.codes(p.root, wi.l, wi.hl)));
            let vne: ¬(p.root = s.var_at(wi.lv)) = λ eq => s.var_ne(v, p.root, wi.lv, wi.l, wi.hlv, wi.hl, bf.nlv)(trans(sym(vat), sym(eq)));
            let hcm2: ((REnv::get(tys, m2.env, s.var_at(wi.lv))).v = level2::Plain(vd)) =
                trans(cong_fn(λ (q: Cell(tys)) => q.v, REnv::get_set_other(tys, m.env, p.root, s.var_at(wi.lv), c2, vne)), j(sym(vat), λ x _ => (REnv::get(tys, m.env, x)).v = level2::Plain(vd), hce));
            let pn2: (s.patched(tys, strs, e2, m2) = e2) = s.patched_copy(tys, strs, e2, m2, wi.lv, at0, vd, hcm2);
            let nwq = λ (dq: Dyn(tys)) (cq: c2.v = level2::Plain(dq)) => cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => nw }, cq);
            let iv = Inv::set_cell(tys, strs, inv, p.root, wi.l, wi.hl, nrf, f2, c2, pn, pn2, agr, code, λ r0 eq => absurd(eq), cong_fn(λ (u: Value(tys)) => Value::refers(tys, u), hpe),
                λ en me pq z hz dpn dcn cpn czn => match Nat::eq_or_ne(en.lvl, wi.lv) {
                    Inl(el) => {
                        let ence: (en = ce) = VEnt::mem_one(en, ce, j(bf.he, λ q _ => Mem(en, q),
                            VEnt::mem_filter_lvl(s.views, wi.lv, en, j(el, λ q _ => en.lvl.same(q) = True, en.lvl.same_self()), me)));
                        let zv: (z = v) = trans(sym(s.lvl_var(z, en.lvl, hz)), trans(cong_fn(λ (q: Nat) => s.var_at(q), el), vat));
                        let dce: (vd = dcn) = cong_fn(λ (u: Value(tys)) => match u { Plain(q) => q, Refer(_) => vd }, trans(sym(hce), j(zv, λ x _ => (REnv::get(tys, m.env, x)).v = level2::Plain(dcn), czn)));
                        let base: CSt::CFitAt(tys, strs, ss, nw, vd) = ⟨wg.left, ⟨cong_fn(λ (q: Dyn(tys)) => q.code, sym(wg.right)), cong_fn(λ (q: Dyn(tys)) => Dyn::len(tys, strs, q), sym(wg.right))⟩⟩;
                        let b2: CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(ce.at), wsm), dpn, dcn) =
                            j(sym(ase), λ q _ => CSt::CFitAt(tys, strs, q, dpn, dcn), j(nwq(dpn, cpn), λ q _ => CSt::CFitAt(tys, strs, ss, q, dcn), j(dce, λ q _ => CSt::CFitAt(tys, strs, ss, nw, q), base)));
                        j(sym(ence), λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(q.at), wsm), dpn, dcn), b2)
                    },
                    Inr(nv) => {
                        let ap0 = inv.sib(ce, en, mce, me, bf.cw, trans(bf.cpar, sym(pq)), λ eq => nv(trans(sym(eq), cl)));
                        let ap: Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), ss) =
                            j(ase, λ q _ => Sel::Apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), q), Sel::apart_sym(tys, strs, Steps::sels(s.unsteps(ce.at), wsm), Steps::sels(s.unsteps(en.at), wsm), ap0));
                        let cfe = inv.cfit(en, me, p.root, z, trans(wi.hl, cong_fn(λ (q: Nat) => Some(q), sym(pq))), hz, old, dcn, hpe, czn);
                        j(nwq(dpn, cpn), λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), wsm), q, dcn), CSt::cfit_apart(tys, strs, Steps::sels(s.unsteps(en.at), wsm), ss, ap, g, old, dcn, cfe))
                    },
                },
                λ en me lq y hy dpp dcs cy ccs => {
                    let cfe = inv.cfit(en, me, y, p.root, hy, trans(wi.hl, cong_fn(λ (q: Nat) => Some(q), sym(lq))), dpp, old, cy, hpe);
                    j(nwq(dcs, ccs), λ q _ => CSt::CFitAt(tys, strs, Steps::sels(s.unsteps(en.at), wsm), dpp, q), CSt::cfit_like(tys, strs, Steps::sels(s.unsteps(en.at), wsm), dpp, old, nw, cfe, wk.left, wk.right))
                });
            let rin = s.var_inside(p.root, wi.l, wi.hl);
            let min: Var::In(p.root, (m.env).args.len(), (m.env).locs.len()) =
                j(sym(sim.mlocs), λ q _ => Var::In(p.root, (m.env).args.len(), q), j(sym(sim.margs), λ q _ => Var::In(p.root, q, s.nd), rin));
            let clm: ((REnv::get(tys, m2.env, s.var_at(wi.l))).v = level2::Plain(nw)) =
                trans(cong_fn(λ (x: Var) => (REnv::get(tys, m2.env, x)).v, rat), cong_fn(λ (c: Cell(tys)) => c.v, REnv::get_set_same(tys, m.env, p.root, c2, min)));
            let s1 = s.rekin(λ (y: VEnt) => y.reback(wi.lv, wi.l), Cons(wi.l, s.touched), Cons(wi.l, s.wrote));
            let pn3: (s1.patched(tys, strs, e2, m2) = e2) = s1.patched_copy(tys, strs, e2, m2, wi.l, λ x mx w => s.pend_back(wi.lv, wi.l, at0, x, mx, w), nw, clm);
            let sim2: Sim(tys, strs, s, e2, m2) = j(pn2, λ z _ => Sim(tys, strs, s, z, m2), iv.sim);
            let fin = Inv::back_finish(tys, strs, iv, wi.lv, wi.l, ro.left, at0, e2, j(sym(pn3), λ z _ => Sim(tys, strs, s1, z, m2), sim2));
            Stepped(m2, λ k => Stmt::write_runs_plain(tys, strs, fns, call, m, p, v, vd, vx, old, hpe, nw, put, k),
                j(sym(bf.nst), λ q _ => Inv(tys, strs, q, e2, m2, h0, lent), fin))
        },
    })(refl, rf)
}

// The write-back stage: a write of a view to write onto its own parent at
// its own place. While something is pending the checker allows it only of
// the pending child (`writes_back`). Four cases: the chain refers, the child
// pending or not; the chain is copies; the parent a holder or a view in each.
theorem Stmt::stage_back(tys: Nat → Type, cx: Ctx(tys), sl: StrsLaws(tys, cx.strs), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, cx.strs, s, e, m, h0, lent), p: Place, v: Var, n: Next, ok: s.write(tys, cx.strs, p, v) = Some(n), wb: s.pending() = True → s.writes_back(Write(p, v)) = True,
    l: Nat, hl: s.lvl(p.root) = Some(l), bk: (xs: List<Step>) → s.steps(p.steps) = Some(xs) → (lv: Nat) → s.lvl(v) = Some(lv) → s.is_back(l, xs, lv) = True):
    Stepped(tys, cx.strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, cx.strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent)
{
    let strs = cx.strs;
    let wi = s.write_inv(tys, strs, p, v, n, ok);
    let ll: (l = wi.l) = Option::some_inj(l, wi.l, trans(sym(hl), wi.hl));
    let bf = wi.back_facts(tys, strs, j(ll, λ q _ => s.is_back(q, wi.xs, wi.lv) = True, bk(wi.xs, wi.hxs, wi.lv, wi.hlv)));
    let wb2: (s.pending() = True → bf.ce.back = False) = λ pend => {
        let st1 = j(wi.hl, λ o _ => (match o as λ _ => Bool { Some(l0) => match s.lvl(v) as λ _ => Bool { Some(lv0) => match s.steps(p.steps) as λ _ => Bool {
            Some(xs) => s.is_back(l0, xs, lv0) && (s.ents(lv0)).any_bit(λ e => !e.back), None => False }, None => False }, None => False }) = True, wb(pend));
        let st2 = j(wi.hlv, λ o _ => (match o as λ _ => Bool { Some(lv0) => match s.steps(p.steps) as λ _ => Bool {
            Some(xs) => s.is_back(wi.l, xs, lv0) && (s.ents(lv0)).any_bit(λ e => !e.back), None => False }, None => False }) = True, st1);
        let st3 = j(wi.hxs, λ o _ => (match o as λ _ => Bool { Some(xs) => s.is_back(wi.l, xs, wi.lv) && (s.ents(wi.lv)).any_bit(λ e => !e.back), None => False }) = True, st2);
        let anyb = (Bool::and_true_parts(s.is_back(wi.l, wi.xs, wi.lv), (s.ents(wi.lv)).any_bit(λ e => !e.back), st3)).right;
        let one: (((!bf.ce.back) || False) = True) = j(bf.he, λ es _ => es.any_bit(λ e => !e.back) = True, anyb);
        (match bf.ce.back as λ b => ((!b) || False) = True → b = False { True => λ no => absurd(no), False => λ _ => refl })(one)
    };
    let at0 = Stmt::back_at0(tys, strs, inv, wi, bf, wb2);
    (match (REnv::get(tys, m.env, p.root)).v as λ u => (REnv::get(tys, m.env, p.root)).v = u →
            Stepped(tys, strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent) {
        Plain(dp) => λ hp => Stmt::stage_back_copy(tys, cx, sl, fns, call, inv, wi, bf, at0, dp, hp),
        Refer(qp) => λ hp => (match s.pending() as λ b => s.pending() = b →
                Stepped(tys, strs, fns, call, Write(p, v), n.st, Env::set(tys, e, p.root, λ d => Dyn::write(tys, strs, Env::ixs(tys, e), p.steps, λ _ => Env::get(tys, e, v), d)), m, h0, lent) {
            False => λ none => Stmt::stage_back_ref_none(tys, cx, sl, fns, call, inv, none, wi, bf, qp, hp),
            True => λ pend => Stmt::stage_back_ref_pend(tys, cx, sl, fns, call, inv, wi, bf, wb2(pend), qp, hp),
        })(refl),
    })(refl)
}

// ---------------------------------------------------------------------------
// The death of a view: its entries dropped, its level gone

theorem List::filter_keep<A>(self xs: List<A>, p, q: A → Bool): ((x: A) → q(x) = True → p(x) = True) → xs.filter(p).filter(q) = xs.filter(q) {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ k => {
            let ih = t.filter_keep(p, q, k);
            (match q(h) as λ c => q(h) = c → (Cons(h, t)).filter(p).filter(q) = (Cons(h, t)).filter(q) {
                True => λ eq => {
                    let pe = k(h, eq);
                    let l1: ((Cons(h, t)).filter(p) = Cons(h, t.filter(p))) = j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Cons(h, t.filter(p)), refl);
                    let l2: ((Cons(h, t.filter(p))).filter(q) = Cons(h, t.filter(p).filter(q))) =
                        j(sym(eq), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p).filter(q)), False => t.filter(p).filter(q) }) = Cons(h, t.filter(p).filter(q)), refl);
                    let r1: ((Cons(h, t)).filter(q) = Cons(h, t.filter(q))) = j(sym(eq), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(q)), False => t.filter(q) }) = Cons(h, t.filter(q)), refl);
                    trans(cong_fn(λ (r: List<A>) => r.filter(q), l1), trans(l2, trans(cong_fn(λ (r: List<A>) => Cons(h, r), ih), sym(r1))))
                },
                False => λ eq => {
                    let r1: ((Cons(h, t)).filter(q) = t.filter(q)) = j(sym(eq), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(q)), False => t.filter(q) }) = t.filter(q), refl);
                    let lft: ((Cons(h, t)).filter(p).filter(q) = t.filter(p).filter(q)) = (match p(h) as λ c => p(h) = c → (Cons(h, t)).filter(p).filter(q) = t.filter(p).filter(q) {
                        True => λ pe => {
                            let l1: ((Cons(h, t)).filter(p) = Cons(h, t.filter(p))) = j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Cons(h, t.filter(p)), refl);
                            let l2: ((Cons(h, t.filter(p))).filter(q) = t.filter(p).filter(q)) =
                                j(sym(eq), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p).filter(q)), False => t.filter(p).filter(q) }) = t.filter(p).filter(q), refl);
                            trans(cong_fn(λ (r: List<A>) => r.filter(q), l1), l2)
                        },
                        False => λ pe => cong_fn(λ (r: List<A>) => r.filter(q), j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = t.filter(p), refl)),
                    })(refl);
                    trans(lft, trans(ih, sym(r1)))
                },
            })(refl)
        },
    }
}

// Dropping what no test picks changes neither whether one is picked nor
// which is first.
theorem List::any_bit_drop<A>(self xs: List<A>, p, q: A → Bool): ((x: A) → Mem(x, xs) → p(x) = False → q(x) = False) → xs.filter(p).any_bit(q) = xs.any_bit(q) {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ k => {
            let ih = t.any_bit_drop(p, q, λ x mx => k(x, Inr(mx)));
            (match p(h) as λ c => p(h) = c → (Cons(h, t)).filter(p).any_bit(q) = (Cons(h, t)).any_bit(q) {
                True => λ pe => trans(cong_fn(λ (r: List<A>) => r.any_bit(q), j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Cons(h, t.filter(p)), refl)),
                    cong_fn(λ (b: Bool) => q(h) || b, ih)),
                False => λ pe => trans(cong_fn(λ (r: List<A>) => r.any_bit(q), j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = t.filter(p), refl)),
                    trans(ih, j(sym(k(h, Inl(refl), pe)), λ y _ => t.any_bit(q) = (y || t.any_bit(q)), refl))),
            })(refl)
        },
    }
}

theorem List::find_drop<A>(self xs: List<A>, p, q: A → Bool): ((x: A) → Mem(x, xs) → p(x) = False → q(x) = False) → xs.filter(p).find(q) = xs.find(q) {
    match xs {
        Nil => λ _ => refl,
        Cons(h, t) => λ k => {
            let ih = t.find_drop(p, q, λ x mx => k(x, Inr(mx)));
            (match p(h) as λ c => p(h) = c → (Cons(h, t)).filter(p).find(q) = (Cons(h, t)).find(q) {
                True => λ pe => trans(cong_fn(λ (r: List<A>) => r.find(q), j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = Cons(h, t.filter(p)), refl)),
                    cong_fn(λ (r: Option<A>) => match q(h) as λ _ => Option<A> { True => Some(h), False => r }, ih)),
                False => λ pe => trans(cong_fn(λ (r: List<A>) => r.find(q), j(sym(pe), λ y _ => (match y as λ _ => List<A> { True => Cons(h, t.filter(p)), False => t.filter(p) }) = t.filter(p), refl)),
                    trans(ih, j(sym(k(h, Inl(refl), pe)), λ y _ => t.find(q) = (match y as λ _ => Option<A> { True => Some(h), False => t.find(q) }), refl))),
            })(refl)
        },
    }
}

theorem List::any_bit_sub<A>(self xs: List<A>, p, q: A → Bool, h: xs.filter(p).any_bit(q) = True): xs.any_bit(q) = True {
    match xs.filter(p).any_bit_sound(q, h) { ⟨a, pa⟩ => xs.any_bit_mem(q, a, xs.mem_filter(a, p, pa.left), pa.right) }
}

// The state a view's death leaves, and what does not change: its other
// levels' entries, the walk from a level not its own, ancestry from an entry
// not its child.
fn CSt::drop(self s: CSt, l: Nat) → CSt { (s.with_views(s.views.filter(λ e => !e.lvl.same(l)))).set(l, KGone) }

theorem CSt::drop_ents(self s: CSt, l, k: Nat, ne: ¬(k = l)): (s.drop(l)).ents(k) = s.ents(k) {
    s.views.filter_keep(λ e => !e.lvl.same(l), λ e => e.lvl.same(k), λ x hx => {
        let sf: (x.lvl.same(l) = False) = Nat::same_false(x.lvl, l, λ eq => ne(trans(sym(x.lvl.same_sound(k, hx)), eq)));
        j(sym(sf), λ c _ => (!c) = True, refl)
    })
}

theorem CSt::drop_mem(self s: CSt, l: Nat, en: VEnt, mem: Mem(en, (s.drop(l)).views)): Mem(en, s.views) ∧ ¬(en.lvl = l) {
    let np = λ (e: VEnt) => !e.lvl.same(l);
    let hn: ((!en.lvl.same(l)) = True) = s.views.mem_filter_holds(en, np, mem);
    ⟨s.views.mem_filter(en, np, mem), λ eq => absurd(trans(sym(hn), j(sym(eq), λ q _ => (!q.same(l)) = False, j(sym(l.same_self()), λ c _ => (!c) = False, refl))))⟩
}

theorem CSt::up_drop(self fu: Nat, s: CSt, tys: Nat → Type, strs: Strs(tys), l: Nat, noch: (en: VEnt) → Mem(en, s.views) → ¬(en.par = l)):
    (e: Env(tys)) → (c: Nat) → ¬(c = l) → (s.drop(l)).up(tys, strs, e, c, fu) = s.up(tys, strs, e, c, fu)
{
    match fu {
        Zero => λ e c _ => refl,
        Succ(f1) => λ e c ne => {
            let s2 = s.drop(l);
            let he = s.drop_ents(l, c, ne);
            (match s.ents(c) as λ es => s.ents(c) = es → s2.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, e, c, Succ(f1)) {
                Nil => λ h => trans(CSt::up_nil(Succ(f1), s2, tys, strs, e, c, trans(he, h)), sym(CSt::up_nil(Succ(f1), s, tys, strs, e, c, h))),
                Cons(x, rest) => λ h => {
                    let h2: (s2.ents(c) = Cons(x, rest)) = trans(he, h);
                    let mx: Mem(x, s.ents(c)) = j(sym(h), λ es _ => Mem(x, es), Inl(refl));
                    let xm: Mem(x, s.views) = s.views.mem_filter(x, λ q => q.lvl.same(c), mx);
                    (match x.par.same(c) as λ b => x.par.same(c) = b → s2.up(tys, strs, e, c, Succ(f1)) = s.up(tys, strs, e, c, Succ(f1)) {
                        True => λ sp => trans(s2.up_stop(tys, strs, e, c, f1, x, rest, h2, sp), sym(s.up_stop(tys, strs, e, c, f1, x, rest, h, sp))),
                        False => λ np => {
                            let e1 = Env::set(tys, e, s.var_at(x.par), λ d => Dyn::write(tys, strs, Env::ixs(tys, e), s.unsteps(x.at), λ _ => Env::get(tys, e, s.var_at(c)), d));
                            trans(s2.up_step(tys, strs, e, c, f1, x, rest, h2, np),
                                trans(CSt::up_drop(f1, s, tys, strs, l, noch, e1, x.par, noch(x, xm)), sym(s.up_step(tys, strs, e, c, f1, x, rest, h, np))))
                        },
                    })(refl)
                },
            })(refl)
        },
    }
}

theorem CSt::anc_drop(self f: Nat, s: CSt, l: Nat, noch: (en: VEnt) → Mem(en, s.views) → ¬(en.par = l)): (e: VEnt) → ¬(e.par = l) → (s.drop(l)).anc_of(e, f) = s.anc_of(e, f) {
    match f {
        Zero => λ e _ => refl,
        Succ(f1) => λ e np => match e.par.same(e.lvl) {
            True => refl,
            False => cong_fn(λ (t: List<Nat>) => Cons(e.par, t),
                trans(cong_fn(λ (q: List<VEnt>) => q.foldr(λ (pe: VEnt) (acc: List<Nat>) => (s.drop(l)).anc_of(pe, f1) ++ acc, Nil), s.drop_ents(l, e.par, np)),
                    VEnt::foldr_anc(s.ents(e.par), λ pe => (s.drop(l)).anc_of(pe, f1), λ pe => s.anc_of(pe, f1), λ pe mf => {
                        let mv: Mem(pe, s.views) = s.views.mem_filter(pe, λ q => q.lvl.same(e.par), mf);
                        CSt::anc_drop(f1, s, l, noch, pe, noch(pe, mv))
                    }))),
        },
    }
}

theorem CSt::patched_drop(self s: CSt, tys: Nat → Type, strs: Strs(tys), e: Env(tys), m: Mach(tys), l: Nat, noch: (en: VEnt) → Mem(en, s.views) → ¬(en.par = l),
    nwp: (en: VEnt) → Mem(en, s.views) → en.lvl = l → (en.mode.writes() && !en.back) = False): (s.drop(l)).patched(tys, strs, e, m) = s.patched(tys, strs, e, m)
{
    let s2 = s.drop(l);
    let nl = s.na + s.nd;
    let q = λ (en: VEnt) => en.mode.writes() && !en.back;
    let np = λ (en: VEnt) => !en.lvl.same(l);
    let kq: ((x: VEnt) → Mem(x, s.views) → np(x) = False → q(x) = False) = λ x mx hx => {
        let st: (x.lvl.same(l) = True) = (match x.lvl.same(l) as λ c => (!c) = False → c = True { True => λ _ => refl, False => λ no => absurd(no) })(hx);
        nwp(x, mx, x.lvl.same_sound(l, st))
    };
    let pe: (s2.pending() = s.pending()) = s.views.any_bit_drop(np, q, kq);
    let fe: (s2.views.find(q) = s.views.find(q)) = s.views.find_drop(np, q, kq);
    let h2 = λ (o: Option<VEnt>) => match o as λ _ => Env(tys) {
        Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v as λ _ => Env(tys) { Refer(_) => s2.up(tys, strs, e, en.lvl, nl), Plain(_) => e },
        None => e,
    };
    let h1 = λ (o: Option<VEnt>) => match o as λ _ => Env(tys) {
        Some(en) => match (REnv::get(tys, m.env, s.var_at(en.lvl))).v as λ _ => Env(tys) { Refer(_) => s.up(tys, strs, e, en.lvl, nl), Plain(_) => e },
        None => e,
    };
    let a1: (s2.patched(tys, strs, e, m) = (match s.pending() as λ _ => Env(tys) { False => e, True => h2(s2.views.find(q)) })) =
        j(pe, λ b _ => (match s2.pending() as λ _ => Env(tys) { False => e, True => h2(s2.views.find(q)) }) = (match b as λ _ => Env(tys) { False => e, True => h2(s2.views.find(q)) }), refl);
    let a2 = cong_fn(λ (o: Option<VEnt>) => match s.pending() as λ _ => Env(tys) { False => e, True => h2(o) }, fe);
    let a3: (h2(s.views.find(q)) = h1(s.views.find(q))) = (match s.views.find(q) as λ o => s.views.find(q) = o → h2(o) = h1(o) {
        None => λ _ => refl,
        Some(y) => λ hy => {
            let fs = List::find_sound(s.views, q, y, hy);
            let ny: ¬(y.lvl = l) = λ eq => absurd(trans(sym(fs.right), nwp(y, fs.left, eq)));
            cong_fn(λ (z: Env(tys)) => match (REnv::get(tys, m.env, s.var_at(y.lvl))).v as λ _ => Env(tys) { Refer(_) => z, Plain(_) => e },
                CSt::up_drop(nl, s, tys, strs, l, noch, e, y.lvl, ny))
        },
    })(refl);
    trans(a1, trans(a2, cong_fn(λ (z: Env(tys)) => match s.pending() as λ _ => Env(tys) { False => e, True => z }, a3)))
}

theorem CSt::changes_drop(self s: CSt, l: Nat, b: l < s.na + s.nd, o: Nat, h: (s.drop(l)).Changes(o)): s.Changes(o) {
    let sw = s.with_views(s.views.filter(λ e => !e.lvl.same(l)));
    match sw.changes_gone(l, b, o, h) {
        Inl(x) => Inl(x),
        Inr(ev) => match ev { ⟨en, pe⟩ => Inr(Exists(en, ⟨s.views.mem_filter(en, λ e => !e.lvl.same(l), pe.left), pe.right⟩)) },
    }
}

// A view without children and with nothing pending dropped: the invariant
// at the state it leaves, the patch the same.
theorem Inv::drop_view(tys: Nat → Type, strs: Strs(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool}, inv: Inv(tys, strs, s, e, m, h0, lent),
    l: Nat, b: l < s.na + s.nd, hr: s.role(l) = KView, noch: (en: VEnt) → Mem(en, s.views) → ¬(en.par = l),
    nwp: (en: VEnt) → Mem(en, s.views) → en.lvl = l → (en.mode.writes() && !en.back) = False):
    Inv(tys, strs, s.drop(l), e, m, h0, lent)
{
    let sw = s.with_views(s.views.filter(λ e => !e.lvl.same(l)));
    let s2 = s.drop(l);
    let nl = s.na + s.nd;
    let ws = Mach::ixs(tys, strs, m);
    let other = λ (l2: Nat) (b2: l2 < s.na + s.nd) (ne: ¬(l2 = l)) => sw.role_set_other(l, l2, KGone, ne, b, b2);
    let notl = λ (l2: Nat) (r: Role) (h2: s2.role(l2) = r) (ng: ¬(r = KGone)) => λ (eq: l2 = l) => ng(trans(sym(h2), j(sym(eq), λ q _ => s2.role(q) = KGone, sw.set_gone_role(l))));
    let simw: Sim(tys, strs, sw, s.patched(tys, strs, e, m), m) = inv.sim;
    let sim2 = j(sym(s.patched_drop(tys, strs, e, m, l, noch, nwp)), λ q _ => Sim(tys, strs, s2, q, m), Sim::gone(tys, strs, simw, l, b));
    let dm = λ (en: VEnt) (mem: Mem(en, s2.views)) => s.drop_mem(l, en, mem);
    Inv(sim2, inv.root,
        λ x l2 h r cr => match Nat::eq_or_ne(l2, l) {
            Inl(eq) => j(sym(eq), λ q _ => s2.RefOk(inv.root, ws, q, r),
                j(sym(sw.set_gone_role(l)), λ q _ => match q { KHold(o, _) => inv.root(o) = Some(r), KView => VEnt::Any(s2.ents(l), λ en => (inv.root(en.obj)).map(λ r0 => r0.narrow(ws, s2.unsteps(en.reg))) = Some(r)),
                    KPlain => False, KGone => True }, trivial)),
            Inr(ne) => CSt::refok_keep(s, s2, inv.root, inv.root, ws, ws, l2, r, other(l2, s.lvl_below(x, l2, h), ne), s.drop_ents(l, l2, ne), λ _ _ _ => refl, λ _ _ => refl, λ _ _ => refl,
                inv.refs(x, l2, h, r, cr)),
        },
        λ o1 o2 ne ch => inv.apart(o1, o2, ne, s.changes_drop(l, b, o1, ch)),
        inv.inheap,
        λ o ch => inv.owned(o, s.changes_drop(l, b, o, ch)),
        λ x l2 h lv co r cr => {
            let b2 = s.lvl_below(x, l2, h);
            let ne: ¬(l2 = l) = λ eq => lv(j(sym(eq), λ q _ => (s2.role(q)).same(KGone) = True, j(sym(sw.set_gone_role(l)), λ q _ => q.same(KGone) = True, refl)));
            let ro = other(l2, b2, ne);
            match inv.own(x, l2, h, λ g => lv(trans(cong_fn(λ (q: Role) => q.same(KGone), ro), g)), co, r, cr) { ⟨o, po⟩ => Exists(o, ⟨trans(ro, po.left), po.right⟩) }
        },
        λ l1 l2 o a1 a2 b1 b2 ne h1 h2 => inv.one(l1, l2, o, a1, a2, b1, b2, ne,
            trans(sym(other(l1, b1, notl(l1, KHold(o, a1), h1, λ no => absurd(no)))), h1), trans(sym(other(l2, b2, notl(l2, KHold(o, a2), h2, λ no => absurd(no)))), h2)),
        λ l2 w => {
            let ww = inv.words(l2, s.views.any_bit_sub(λ e => !e.lvl.same(l), λ e => l2.member(Steps::lvls(e.reg)) || l2.member(Steps::lvls(e.at)), w));
            let ne: ¬(l2 = l) = λ eq => absurd(trans(sym(ww.right), trans(cong_fn(λ (q: Nat) => (s.role(q)).plain(), eq), cong_fn(λ (q: Role) => q.plain(), hr))));
            ⟨ww.left, trans(cong_fn(λ (q: Role) => q.plain(), other(l2, ww.left, ne)), ww.right)⟩
        },
        inv.frame,
        inv.grows,
        inv.young,
        λ l2 o a b2 hr2 => inv.held(l2, o, a, b2, trans(sym(other(l2, b2, notl(l2, KHold(o, a), hr2, λ no => absurd(no)))), hr2)),
        λ en mem => {
            let d = dm(en, mem);
            let vv = inv.vents(en, d.left);
            ⟨vv.left, ⟨vv.right.left, trans(other(en.lvl, vv.right.left, d.right), vv.right.right)⟩⟩
        },
        inv.bare,
        λ en mem => {
            let d = dm(en, mem);
            let cc = inv.chain(en, d.left);
            let pb: (en.par < nl) = omega(cc.left, (inv.vents(en, d.left)).right.left);
            ⟨cc.left, CSt::parent_keep(s, s2, en, other(en.par, pb, noch(en, d.left)), s.drop_ents(l, en.par, noch(en, d.left)), cc.right)⟩
        },
        λ e1 e2 m1 m2 w eo n12 a1 a2 => {
            let d1 = dm(e1, m1);
            let d2 = dm(e2, m2);
            inv.excl(e1, e2, d1.left, d2.left, w, eo, n12,
                j(CSt::anc_drop(nl, s, l, noch, e2, noch(e2, d2.left)), λ q _ => e1.lvl.member(q) = False, a1),
                j(CSt::anc_drop(nl, s, l, noch, e1, noch(e1, d1.left)), λ q _ => e2.lvl.member(q) = False, a2))
        },
        λ en mem w => {
            let d = dm(en, mem);
            let pb: (en.par < nl) = omega((inv.chain(en, d.left)).left, (inv.vents(en, d.left)).right.left);
            CSt::wpar_keep(s, s2, en, other(en.par, pb, noch(en, d.left)), s.drop_ents(l, en.par, noch(en, d.left)), inv.wpar(en, d.left, w))
        },
        λ en mem x y hx hy => inv.uni(en, (dm(en, mem)).left, x, y, hx, hy),
        λ e1 e2 m1 m2 => inv.pone(e1, e2, (dm(e1, m1)).left, (dm(e2, m2)).left),
        λ en mem y z hy hz dp dc cy cz => inv.cfit(en, (dm(en, mem)).left, y, z, hy, hz, dp, dc, cy, cz),
        λ e1 e2 m1 m2 => inv.sib(e1, e2, (dm(e1, m1)).left, (dm(e2, m2)).left))
}

// The death of a view: it has no children, and is not pending; the run
// changes nothing (a view's cell does not own).
theorem Stmt::stage_death_view(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), {s: CSt}, {e: Env(tys)}, {m: Mach(tys)}, {h0: Heap(tys)}, {lent: Nat → Bool},
    inv: Inv(tys, strs, s, e, m, h0, lent), x: Var, l: Nat, hl: s.lvl(x) = Some(l), hr: s.role(l) = KView, nch: s.has_children(l) = False,
    allb: (s.ents(l)).all_bit(λ e => !e.mode.writes() || e.back) = True):
    Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.with_views(s.views.filter(λ e => !e.lvl.same(l))).set(l, KGone), e, m, h0, lent)
{
    let b = s.lvl_below(x, l, hl);
    let noch: ((en: VEnt) → Mem(en, s.views) → ¬(en.par = l)) = λ en mem eq => {
        let lt = (inv.chain(en, mem)).left;
        let nls: (en.lvl.same(l) = False) = Nat::same_false(en.lvl, l, λ e2 => Nat::lt_irrefl(l, j(eq, λ q _ => q < l, j(e2, λ q _ => en.par < q, lt))));
        let pt: ((en.par.same(l) && !en.lvl.same(l)) = True) = j(sym(nls), λ c _ => (en.par.same(l) && !c) = True, j(sym(eq), λ q _ => (q.same(l) && !False) = True, j(sym(l.same_self()), λ c _ => (c && !False) = True, refl)));
        absurd(trans(sym(nch), s.views.any_bit_mem(λ e2 => e2.par.same(l) && !e2.lvl.same(l), en, mem, pt)))
    };
    let nwp: ((en: VEnt) → Mem(en, s.views) → en.lvl = l → (en.mode.writes() && !en.back) = False) = λ en mem el => {
        let me: Mem(en, s.ents(l)) = VEnt::mem_filter_lvl(s.views, l, en, j(el, λ q _ => en.lvl.same(q) = True, en.lvl.same_self()), mem);
        let ok = (s.ents(l)).all_bit_sound(λ e => !e.mode.writes() || e.back, allb, en, me);
        (match en.mode.writes() as λ a => ((!a) || en.back) = True → (a && !en.back) = False {
            False => λ _ => refl,
            True => λ h => j(sym(h), λ c _ => (True && !c) = False, refl),
        })(ok)
    };
    let gone = Inv::drop_view(tys, strs, inv, l, b, hr, noch, nwp);
    let live: ¬((s.role(l)).same(KGone) = True) = λ g => absurd(trans(sym(g), cong_fn(λ (q: Role) => q.same(KGone), hr)));
    let c = REnv::get(tys, m.env, x);
    (match c.own as λ ow => c.own = ow → Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.drop(l), e, m, h0, lent) {
        False => λ co => Stepped(m, λ k => Stmt::death_keeps(tys, strs, fns, call, m, x, k, Inl(co)), gone),
        True => λ co => (match c.v as λ v => c.v = v → Stepped(tys, strs, fns, call, Death(Place(x, Nil)), s.drop(l), e, m, h0, lent) {
            Plain(d) => λ cv => Stepped(m, λ k => Stmt::death_keeps(tys, strs, fns, call, m, x, k, Inr(Exists(d, cv))), gone),
            Refer(r) => λ cr => match inv.own(x, l, hl, live, co, r, cr) { ⟨o1, po⟩ => absurd(trans(sym(hr), po.left)) },
        })(refl),
    })(refl)
}

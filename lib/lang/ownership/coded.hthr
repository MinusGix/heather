// The universal value as a native value tagged with its code
// (docs/language/ownership-design.md §18.4 item 4,
// issues/ownership-coded-values.md).
//
// A `Shape` is a closed, first-order code: a word, a sequence of a shape,
// or a named type, an index into an environment of types. `El(tys, c)`
// decodes a code by large elimination: `El(tys, SSeq(c))` is
// `List<El(tys, c)>` and `El(tys, SNamed(k))` the `k`th type of `tys`,
// definitionally. A type parameter `T` of a generic function and a user
// record are both named. A second environment, after the first, gives each
// named type its structure (`Struct`): opaque, or a record's fields, each
// a shape and a `Path` from the record to the field's decoding, with an
// inhabitant either way. `Dyn(tys)` is a code with a value of its decoding.
//
// - **The decision computes.** `Shape::dec` is a `fn` whose `Inl` holds a
//   proof built from `refl` by `fn`s (`Shape::cong_seq`, `Nat::cong_succ`),
//   so at two closed equal codes it is `Inl(refl)` by evaluation, and the
//   cast `Shape::cast` (`j` along it) is the identity there. At one code,
//   `Shape::dec_self` is `Inl(refl)` by induction on the code: no unique
//   identity proofs.
// - **Reads and writes whose code is the code's alone.** The meaning reads
//   a step totally (`Dyn::at`: an absent element is the code's inhabitant,
//   `Dyn::dflt`) and writes by modifying (`Dyn::over`: the step's part
//   handed to a function, put back where its result has the part's code).
//   The code of what either produces is a function of the codes alone, so
//   along a place of closed codes every code stays closed and every
//   dispatch reduces, and what is left is the native operation on the
//   value inside: `ps[i].x` is `ps.nth(i).unwrap_or(d).x`.
// - **The step model.** `Dyn::path` is each selection as a `Path<Dyn, Dyn>`:
//   the owner's code dispatches to a native part (`Dyn::part`: an element is
//   `Path::elem`, a window the library's window as a list, a field the
//   structure's path), and a write decides the written value's code once,
//   outside the part. Its laws as `StepModelLaws` states them cannot hold: a
//   fit there is a property of the written value alone (`fits: Sel → S →
//   Bool`), and here whether a write is read back depends on the code of the
//   part it replaces (`Dyn::elem_not_lawful`, for every fit).
// - **Laws relative to the read.** With the fit comparing the written value
//   to what the step read (`PathLawsRel`, `StepModelLawsRel`), every model
//   lawful as `steps.hthr` states it stays lawful (`StepModelLawsRel::of_laws`),
//   the decider stays sound by the same proof (`Steps::apart_sound_rel`), and
//   `Dyn`'s model is lawful from the structures' laws alone
//   (`Dyn::model_laws_rel`): each part's laws carry over through the tag, a
//   write keeps the owner's code by construction, and two selections apart
//   are apart by the parts' spans or the fields' apartness.
// - **A branch that names its output** (`Join`): each arm's bindings end with
//   it, the output is the convoy of the arms' values, and what follows runs
//   once, as a source's `let x = if h: … else …; rest` does.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import vector;
import span_set;
import store;
import path;
import list_path;
import store_path;
import atom;
import steps;
import value_steps;

// ---------------------------------------------------------------------------
// Codes, and their decision

inductive Shape { SWord, SSeq(a: Shape), SNamed(k: Nat) }

fn Nat::cong_succ({a, b: Nat}, e: a = b) → Succ(a) = Succ(b) { j(e, λ c _ => Succ(a) = Succ(c), refl) }

fn Nat::pred_eq({a, b: Nat}, e: Succ(a) = Succ(b)) → a = b { j(e, λ c _ => a = c.pred(), refl) }

// Equality of two numbers, decided with a proof the kernel reduces: at two
// equal literals, `Inl(refl)`.
fn Nat::dec(a, b: Nat) → Or<a = b, ¬(a = b)> {
    match a {
        Zero => match b { Zero => Inl(refl), Succ(_) => Inr(λ no => absurd(no)) },
        Succ(a1) => match b {
            Zero => Inr(λ no => absurd(no)),
            Succ(b1) => match Nat::dec(a1, b1) { Inl(e) => Inl(Nat::cong_succ(e)), Inr(ne) => Inr(λ h => ne(Nat::pred_eq(h))) },
        },
    }
}

fn Shape::cong_seq({a, b: Shape}, e: a = b) → SSeq(a) = SSeq(b) { j(e, λ c _ => SSeq(a) = SSeq(c), refl) }

fn Shape::cong_named({k, l: Nat}, e: k = l) → SNamed(k) = SNamed(l) { j(e, λ c _ => SNamed(k) = SNamed(c), refl) }

fn Shape::elem_of(self c: Shape) → Shape { match c { SSeq(a) => a, _ => SWord } }

fn Shape::name_of(self c: Shape) → Nat { match c { SNamed(k) => k, _ => 0 } }

fn Shape::seq_inj({a, b: Shape}, e: SSeq(a) = SSeq(b)) → a = b { j(e, λ c _ => a = c.elem_of(), refl) }

fn Shape::named_inj({k, l: Nat}, e: SNamed(k) = SNamed(l)) → k = l { j(e, λ c _ => k = c.name_of(), refl) }

fn Shape::dec(a, b: Shape) → Or<a = b, ¬(a = b)> {
    match a {
        SWord => match b { SWord => Inl(refl), SSeq(_) => Inr(λ no => absurd(no)), SNamed(_) => Inr(λ no => absurd(no)) },
        SSeq(a1) => match b {
            SSeq(b1) => match Shape::dec(a1, b1) { Inl(e) => Inl(Shape::cong_seq(e)), Inr(ne) => Inr(λ h => ne(Shape::seq_inj(h))) },
            SWord => Inr(λ no => absurd(no)),
            SNamed(_) => Inr(λ no => absurd(no)),
        },
        SNamed(k) => match b {
            SNamed(l) => match Nat::dec(k, l) { Inl(e) => Inl(Shape::cong_named(e)), Inr(ne) => Inr(λ h => ne(Shape::named_inj(h))) },
            SWord => Inr(λ no => absurd(no)),
            SSeq(_) => Inr(λ no => absurd(no)),
        },
    }
}

// At one number, the decision is `refl`: by induction, no unique identity
// proofs.
theorem Nat::dec_self(k: Nat): Nat::dec(k, k) = Inl(refl) {
    match k {
        Zero => refl,
        Succ(k1) => j(sym(Nat::dec_self(k1)), λ o _ => (match o { Inl(e) => Inl(Nat::cong_succ(e)), Inr(ne) => Inr(λ h => ne(Nat::pred_eq(h))) }) = Inl<(Succ(k1) = Succ(k1)), ¬(Succ(k1) = Succ(k1))>(refl), refl),
    }
}

theorem Shape::dec_self(c: Shape): Shape::dec(c, c) = Inl(refl) {
    match c {
        SWord => refl,
        SSeq(a) => j(sym(Shape::dec_self(a)), λ o _ => (match o { Inl(e) => Inl(Shape::cong_seq(e)), Inr(ne) => Inr(λ h => ne(Shape::seq_inj(h))) }) = Inl<(SSeq(a) = SSeq(a)), ¬(SSeq(a) = SSeq(a))>(refl), refl),
        SNamed(k) => j(sym(Nat::dec_self(k)), λ o _ => (match o { Inl(e) => Inl(Shape::cong_named(e)), Inr(ne) => Inr(λ h => ne(Shape::named_inj(h))) }) = Inl<(SNamed(k) = SNamed(k)), ¬(SNamed(k) = SNamed(k))>(refl), refl),
    }
}

// ---------------------------------------------------------------------------
// The decoding, and the two environments

fn El(tys: Nat → Type, c: Shape) → Type {
    match c { SWord => Nat, SSeq(a) => List<El(tys, a)>, SNamed(k) => tys(k) }
}

// The cast between two codes found equal: the identity at `refl`.
fn Shape::cast(tys: Nat → Type, {a, b: Shape}, e: a = b, x: El(tys, a)) → El(tys, b) { j(e, λ c _ => El(tys, c), x) }

// A record's field: its shape, and the path from the record to it.
record Field(tys: Nat → Type, T: Type) { shape: Shape, path: Path<T, El(tys, shape)> }

// A named type's structure, with an inhabitant: what a derived instance
// supplies. Opaque (a type parameter), or a record's fields.
inductive Struct(tys: Nat → Type, T: Type) { Opaque(d: T), Fields(d: T, fs: List<Field(tys, T)>) }

fn Struct::dflt(tys: Nat → Type, {T: Type}, self st: Struct(tys, T)) → T { match st { Opaque(d) => d, Fields(d, _) => d } }

// The structures of an environment's types, stated after it.
fn Strs(tys: Nat → Type) → Type { (k: Nat) → Struct(tys, tys(k)) }

// A code with a value of its decoding.
record Dyn(tys: Nat → Type) { code: Shape, val: El(tys, code) }

// Every code's inhabitant: a word's 0, an empty sequence, a named type's
// own.
fn Dyn::dflt(tys: Nat → Type, strs: Strs(tys), c: Shape) → El(tys, c) {
    match c { SWord => 0, SSeq(_) => Nil, SNamed(k) => Struct::dflt(tys, strs(k)) }
}

// What `e` holds, where its code is `a`; `x` otherwise.
fn Dyn::back(tys: Nat → Type, a: Shape, e: Dyn(tys), x: El(tys, a)) → El(tys, a) {
    match Shape::dec(e.code, a) { Inl(h) => Shape::cast(tys, h, e.val), Inr(_) => x }
}

// What `e` holds as a value at code `a`, the inhabitant otherwise: how a
// native callee takes its argument.
fn Dyn::as_code(tys: Nat → Type, strs: Strs(tys), a: Shape, e: Dyn(tys)) → El(tys, a) { Dyn::back(tys, a, e, Dyn::dflt(tys, strs, a)) }

fn Dyn::word(tys: Nat → Type, e: Dyn(tys)) → Nat { Dyn::back(tys, SWord, e, 0) }

fn Dyn::size(tys: Nat → Type, e: Dyn(tys)) → Nat {
    (match e.code as λ c => El(tys, c) → Nat { SSeq(_) => λ v => List::len(v), SWord => λ _ => 0, SNamed(_) => λ _ => 0 })(e.val)
}

// ---------------------------------------------------------------------------
// The words: parameters by position, the body's newest first

record Env { args: List<Nat>, m: Nat, locals: List<Nat> }

fn Env::start(ws: List<Nat>) → Env { Env(ws, 0, Nil) }

fn Env::n(self e: Env) → Nat { e.args.len() + e.m }

fn Env::push(self e: Env, a: Nat) → Env { Env(e.args, e.m + 1, Cons(a, e.locals)) }

fn Env::get(self e: Env, w: Nat) → Nat {
    match (w + 1).leb(e.args.len()) { True => word(e.args, w), False => word(e.locals, e.n() - (w + 1)) }
}

fn Atom::at(self a: Atom, e: Env) → Nat { match a { Lit(n) => n, Var(w) => e.get(w) } }

fn Step::sel_in(self a: Step, e: Env) → Sel {
    match a {
        SField(i) => OnField(i),
        SElem(i) => OnSeq(SeqOne(i.at(e))),
        SWindow(lo, n) => OnSeq(SeqRun(lo.at(e), n.at(e))),
        SKey(i, g) => OnKey(Key(i.at(e), g.at(e))),
        SVariant(c) => OnVariant(c),
    }
}

// ---------------------------------------------------------------------------
// One step, read and modified: the meaning's
//
// The code of what each produces is a function of the code and the
// selection alone: a step that does not fit reads the word 0 and writes
// nothing.

fn Dyn::field_at(tys: Nat → Type, strs: Strs(tys), {T: Type}, st: Struct(tys, T), i: Nat, v: T) → Dyn(tys) {
    match st {
        Opaque(_) => Dyn(SWord, 0),
        Fields(_, fs) => match fs.nth(i) { Some(f) => Dyn(f.shape, f.path.get(v).unwrap_or(Dyn::dflt(tys, strs, f.shape))), None => Dyn(SWord, 0) },
    }
}

fn Dyn::at(tys: Nat → Type, strs: Strs(tys), sel: Sel, d: Dyn(tys)) → Dyn(tys) {
    (match d.code as λ c => El(tys, c) → Dyn(tys) {
        SWord => λ _ => Dyn(SWord, 0),
        SSeq(a) => λ v => match sel {
            OnSeq(x) => match x { SeqOne(i) => Dyn(a, v.nth(i).unwrap_or(Dyn::dflt(tys, strs, a))), SeqRun(lo, n) => Dyn(SSeq(a), v.drop(lo).take(n)) },
            _ => Dyn(SWord, 0),
        },
        SNamed(k) => λ v => match sel { OnField(i) => Dyn::field_at(tys, strs, strs(k), i, v), _ => Dyn(SWord, 0) },
    })(d.val)
}

fn Dyn::field_over(tys: Nat → Type, {T: Type}, st: Struct(tys, T), i: Nat, g: Dyn(tys) → Dyn(tys), v: T) → T {
    match st {
        Opaque(_) => v,
        Fields(_, fs) => match fs.nth(i) {
            Some(f) => match f.path.get(v) { Some(y) => f.path.set(v, Dyn::back(tys, f.shape, g(Dyn(f.shape, y)), y)), None => v },
            None => v,
        },
    }
}

fn Dyn::over(tys: Nat → Type, strs: Strs(tys), sel: Sel, g: Dyn(tys) → Dyn(tys), d: Dyn(tys)) → Dyn(tys) {
    (match d.code as λ c => El(tys, c) → Dyn(tys) {
        SWord => λ v => Dyn(SWord, v),
        SSeq(a) => λ v => Dyn(SSeq(a), match sel {
            OnSeq(x) => match x {
                SeqOne(i) => v.update(i, λ y => Dyn::back(tys, a, g(Dyn(a, y)), y)),
                SeqRun(lo, n) => v.put_window(lo, Dyn::back(tys, SSeq(a), g(Dyn(SSeq(a), v.drop(lo).take(n))), v.drop(lo).take(n))),
            },
            _ => v,
        }),
        SNamed(k) => λ v => Dyn(SNamed(k), match sel { OnField(i) => Dyn::field_over(tys, strs(k), i, g, v), _ => v }),
    })(d.val)
}

// A place's steps from a root, read and modified.
fn Dyn::read(tys: Nat → Type, strs: Strs(tys), e: Env, xs: List<Step>, d: Dyn(tys)) → Dyn(tys) {
    match xs { Nil => d, Cons(a, rest) => Dyn::read(tys, strs, e, rest, Dyn::at(tys, strs, a.sel_in(e), d)) }
}

fn Dyn::write(tys: Nat → Type, strs: Strs(tys), e: Env, xs: List<Step>, g: Dyn(tys) → Dyn(tys), d: Dyn(tys)) → Dyn(tys) {
    match xs { Nil => g(d), Cons(a, rest) => Dyn::over(tys, strs, a.sel_in(e), λ x => Dyn::write(tys, strs, e, rest, g, x), d) }
}

// ---------------------------------------------------------------------------
// A small meaning over an environment of `Dyn`s
//
// A fixture, only as large as the probes need: objects are the function's
// object parameters, each a `Dyn`; words are an `Env`. A place is an
// object and steps. A statement reads the word at a place, writes a word or
// the value at another place at a place, adds two words, or calls a native
// callee with the values at places and words, binding its word. A branch is
// the convoy a source's `if h: i < p.len()` elaborates to, carrying what
// follows into each arm (`mean_then`, as in the checker's).

record Place { root: Nat, steps: List<Step> }

inductive Src { FromWord(a: Atom), FromPlace(p: Place) }

inductive Stmt { Get(p: Place), Put(p: Place, v: Src), Add(a: Atom, b: Atom), Call(g: Nat, ps: List<Place>, args: List<Atom>) }

// A branch's test: the word `a` is below the length at `p`.
inductive Cond { LtLen(a: Atom, p: Place) }

// `If` carries what follows into each arm. `Join` names its output: each
// arm runs from the branch's state and its bindings end with it; after
// the join the output is the convoy of the arms' values, the term a
// source's `let x = if h: … { … } else { … }; rest` elaborates to, and
// `rest` runs once. The arms here bind words only; the objects pass
// through.
inductive Body { End, Do(o: Stmt, rest: Body), If(cd: Cond, a: Body, b: Body, rest: Body), Join(cd: Cond, a: Body, wa: Atom, b: Body, wb: Atom, rest: Body) }

fn seq(ops: List<Stmt>) → Body { match ops { Nil => End, Cons(o, rest) => Do(o, seq(rest)) } }

inductive Ret { RWord(a: Atom), RPlace(p: Place) }

record Func { body: Body, ret: Ret }

// The native callees: from the values passed and the words, a word.
fn World(tys: Nat → Type) → Type { Nat → List<Dyn(tys)> → List<Nat> → Nat }

record Sem(tys: Nat → Type) { objs: List<Dyn(tys)>, words: Env }

fn obj_at(tys: Nat → Type, objs: List<Dyn(tys)>, r: Nat) → Dyn(tys) { objs.nth(r).unwrap_or(Dyn(SWord, 0)) }

fn Place::val(self p: Place, tys: Nat → Type, strs: Strs(tys), s: Sem(tys)) → Dyn(tys) { Dyn::read(tys, strs, s.words, p.steps, obj_at(tys, s.objs, p.root)) }

fn Src::val(self v: Src, tys: Nat → Type, strs: Strs(tys), s: Sem(tys)) → Dyn(tys) { match v { FromWord(a) => Dyn(SWord, a.at(s.words)), FromPlace(p) => p.val(tys, strs, s) } }

fn Sem::bind(tys: Nat → Type, self s: Sem(tys), a: Nat) → Sem(tys) { Sem(s.objs, s.words.push(a)) }

fn Stmt::eval1(self o: Stmt, tys: Nat → Type, strs: Strs(tys), w: World(tys), s: Sem(tys)) → Sem(tys) {
    match o {
        Get(p) => Sem::bind(tys, s, Dyn::word(tys, p.val(tys, strs, s))),
        Put(p, v) => Sem(s.objs.update(p.root, λ d => Dyn::write(tys, strs, s.words, p.steps, λ _ => v.val(tys, strs, s), d)), s.words),
        Add(a, b) => Sem::bind(tys, s, a.at(s.words) + b.at(s.words)),
        Call(g, ps, args) => Sem::bind(tys, s, w(g, ps.map(λ p => p.val(tys, strs, s)), args.map(λ a => a.at(s.words)))),
    }
}

// What `if h: c { y } else { n }` elaborates to: a match on the test's bit
// that hands each arm the bit's equation.
fn convoy<A>(c: Bool, y, n: A) → A { (match c as λ d => c = d → A { True => λ _ => y, False => λ _ => n })(refl) }

fn Cond::test(self cd: Cond, tys: Nat → Type, strs: Strs(tys), s: Sem(tys)) → Bool {
    match cd { LtLen(a, p) => decide_bit<a.at(s.words) < Dyn::size(tys, p.val(tys, strs, s))>() }
}

// After a join: the branch's state with its output bound, the convoy of
// what each arm's state reads (each arm's state an argument, so evaluated
// once).
fn Sem::joined(tys: Nat → Type, s: Sem(tys), t: Bool, sa: Sem(tys), wa: Atom, sb: Sem(tys), wb: Atom) → Sem(tys) { Sem::bind(tys, s, convoy(t, wa.at(sa.words), wb.at(sb.words))) }

fn mean_then(R: Type, tys: Nat → Type, strs: Strs(tys), w: World(tys), ops: Body, s: Sem(tys), k: Sem(tys) → R) → R {
    match ops {
        End => k(s),
        Do(o, rest) => mean_then(R, tys, strs, w, rest, o.eval1(tys, strs, w, s), k),
        If(cd, a, b, rest) => convoy(cd.test(tys, strs, s), mean_then(R, tys, strs, w, a, s, λ x => mean_then(R, tys, strs, w, rest, x, k)),
            mean_then(R, tys, strs, w, b, s, λ x => mean_then(R, tys, strs, w, rest, x, k))),
        Join(cd, a, wa, b, wb, rest) =>
            mean_then(R, tys, strs, w, rest, Sem::joined(tys, s, cd.test(tys, strs, s), mean_then(Sem(tys), tys, strs, w, a, s, λ x => x), wa, mean_then(Sem(tys), tys, strs, w, b, s, λ x => x), wb), k),
    }
}

// What a function means: its objects afterwards, the word it answers, and
// the value at the place it answers.
record MOut(tys: Nat → Type) { objs: List<Dyn(tys)>, word: Nat, val: Dyn(tys) }

fn Ret::out(self r: Ret, tys: Nat → Type, strs: Strs(tys), s: Sem(tys)) → MOut(tys) {
    match r { RWord(a) => MOut(s.objs, a.at(s.words), Dyn(SWord, a.at(s.words))), RPlace(p) => MOut(s.objs, 0, p.val(tys, strs, s)) }
}

fn mean_fn(tys: Nat → Type, strs: Strs(tys), w: World(tys), f: Func, objs: List<Dyn(tys)>, ws: List<Nat>) → MOut(tys) {
    mean_then(MOut(tys), tys, strs, w, f.body, Sem(objs, Env::start(ws)), λ s => f.ret.out(tys, strs, s))
}

// ---------------------------------------------------------------------------
// Residuals, as the source writes them, at the state their site reads

// An index inside what a place holds; a callee's precondition at the values
// passed and the words.
inductive Owed { Inside(p: Place, i: Atom), Pre(g: Nat, ps: List<Place>, args: List<Atom>) }

fn Pres(tys: Nat → Type) → Type<1> { Nat → List<Dyn(tys)> → List<Nat> → Type }

fn Owed::Holds(self o: Owed, tys: Nat → Type, strs: Strs(tys), pres: Pres(tys), s: Sem(tys)) → Type {
    match o {
        Inside(p, i) => ∥i.at(s.words) < Dyn::size(tys, p.val(tys, strs, s))∥,
        Pre(g, ps, args) => pres(g, ps.map(λ p => p.val(tys, strs, s)), args.map(λ a => a.at(s.words))),
    }
}

fn Owed::Then(rs: List<Owed>, tys: Nat → Type, strs: Strs(tys), pres: Pres(tys), s: Sem(tys), tail: Type) → Type {
    match rs { Nil => tail, Cons(r, rest) => r.Holds(tys, strs, pres, s) ∧ Owed::Then(rest, tys, strs, pres, s, tail) }
}

fn Cases(c: Bool, x, y: Type) → Type { match c { True => x, False => y } }

theorem cases(c: Bool, {x, y: Type}, yes: c = True → x, no: c = False → y): Cases(c, x, y) {
    (match c as λ d => c = d → Cases(d, x, y) { True => λ e => yes(e), False => λ e => no(e) })(refl)
}

inductive Owes { OEnd, ODo(here: List<Owed>, rest: Owes), OIf(a: Owes, b: Owes, rest: Owes), OJoin(a: Owes, b: Owes, rest: Owes) }

fn Owes::Holds(self d: Owes, tys: Nat → Type, strs: Strs(tys), w: World(tys), pres: Pres(tys), ops: Body, s: Sem(tys), after: Sem(tys) → Type) → Type {
    match ops {
        End => after(s),
        Do(o, r) => match d { ODo(here, dr) => Owed::Then(here, tys, strs, pres, s, dr.Holds(tys, strs, w, pres, r, o.eval1(tys, strs, w, s), after)), _ => False },
        If(cd, a, b, r) => match d {
            OIf(da, db, dr) => Cases(cd.test(tys, strs, s), da.Holds(tys, strs, w, pres, a, s, λ x => dr.Holds(tys, strs, w, pres, r, x, after)),
                db.Holds(tys, strs, w, pres, b, s, λ x => dr.Holds(tys, strs, w, pres, r, x, after))),
            _ => False,
        },
        Join(cd, a, wa, b, wb, r) => match d {
            OJoin(da, db, dr) => Cases(cd.test(tys, strs, s), da.Holds(tys, strs, w, pres, a, s, λ _ => True), db.Holds(tys, strs, w, pres, b, s, λ _ => True)) ∧
                dr.Holds(tys, strs, w, pres, r,
                    Sem::joined(tys, s, cd.test(tys, strs, s), mean_then(Sem(tys), tys, strs, w, a, s, λ x => x), wa, mean_then(Sem(tys), tys, strs, w, b, s, λ x => x), wb), after),
            _ => False,
        },
    }
}

fn Owes::Due(self d: Owes, tys: Nat → Type, strs: Strs(tys), w: World(tys), pres: Pres(tys), f: Func, objs: List<Dyn(tys)>, ws: List<Nat>) → Type {
    d.Holds(tys, strs, w, pres, f.body, Sem(objs, Env::start(ws)), λ _ => True)
}

// The word a function answers, read inside the continuation: a branch is
// then a convoy at `Nat`, as the source's `if h:` is, where `.word` of
// `mean_fn`'s would project out of a convoy over the whole output and stop.
fn mean_word(tys: Nat → Type, strs: Strs(tys), w: World(tys), f: Func, objs: List<Dyn(tys)>, ws: List<Nat>) → Nat {
    mean_then(Nat, tys, strs, w, f.body, Sem(objs, Env::start(ws)), λ s => f.ret.out(tys, strs, s).word)
}

// ---------------------------------------------------------------------------
// The step model at `Dyn`, and why its laws cannot hold as `steps.hthr`
// states them
//
// Each selection is a `Path<Dyn, Dyn>`: its read the part with its code
// where the step fits the owner's code (`None` otherwise), its write the
// meaning's modification. That instantiates `PathModel<Dyn>`. Its laws do
// not hold for any fit: `StepModelLaws` asks `PathLawsOn(path(a), fits(a))`
// with `fits(a): Dyn → Bool` a property of the written value alone, and
// `reads_fit` makes every value read through the step fit. An element of a
// list of words and an element of a list of lists are both read through
// `OnSeq(SeqOne(0))`, so both codes fit, and writing the list into the list
// of words must then read it back (`set_get`), which a native list of
// words cannot hold. `Dyn::elem_not_lawful` is the refutation, at an environment of no
// named types. The universal `Val` passes only because a sequence there
// holds values of any shape.

// A step's part at an owner of code `c`: the part's code, and the native
// path to it. An element is `Path::elem`, a window the library's window
// read as a list of its length, a field the structure's path.
record Part(tys: Nat → Type, c: Shape) { t: Shape, p: Path<El(tys, c), El(tys, t)> }

// A vector as the list of its entries: a write of a list of its length.
fn Dyn::vec_list<A>(n: Nat, pad: A) → Path<[A; n], List<A>> {
    Path<[A; n], List<A>>(get := λ (v: [A; n]) => Some(vector_entries(v)), set := λ (v: [A; n]) => λ (r: List<A>) => match r.len().same(n) { True => r.vector_of(n, pad), False => v })
}

fn Dyn::win(tys: Nat → Type, strs: Strs(tys), x: Shape, lo, n: Nat) → Path<List<El(tys, x)>, List<El(tys, x)>> {
    Path::window<El(tys, x)>(lo, n).then(Dyn::vec_list<El(tys, x)>(n, Dyn::dflt(tys, strs, x)))
}

fn Dyn::field_part(tys: Nat → Type, k: Nat, st: Struct(tys, tys(k)), i: Nat) → Option<Part(tys, SNamed(k))> {
    match st { Opaque(_) => None, Fields(_, fs) => match fs.nth(i) { Some(f) => Some(Part(f.shape, f.path)), None => None } }
}

fn Dyn::seq_part(tys: Nat → Type, strs: Strs(tys), x: Shape, q: SeqSel) → Part(tys, SSeq(x)) {
    match q { SeqOne(i) => Part(x, Path::elem<El(tys, x)>(i)), SeqRun(lo, n) => Part(SSeq(x), Dyn::win(tys, strs, x, lo, n)) }
}

fn Dyn::part(tys: Nat → Type, strs: Strs(tys), sel: Sel, c: Shape) → Option<Part(tys, c)> {
    match c {
        SWord => None,
        SSeq(x) => match sel { OnSeq(q) => Some(Dyn::seq_part(tys, strs, x, q)), _ => None },
        SNamed(k) => match sel { OnField(i) => Dyn::field_part(tys, k, strs(k), i), _ => None },
    }
}

// Through a part: the read, tagged with the part's code; the write, where
// the written value has the part's code (decided once, outside the part).
fn Dyn::take_in(tys: Nat → Type, {c: Shape}, pt: Part(tys, c), v: El(tys, c)) → Option<Dyn(tys)> { pt.p.get(v).map(λ y => Dyn(pt.t, y)) }

fn Dyn::put_in(tys: Nat → Type, {c: Shape}, pt: Part(tys, c), v: El(tys, c), w: Dyn(tys)) → El(tys, c) {
    match Shape::dec(w.code, pt.t) { Inl(h) => pt.p.set(v, Shape::cast(tys, h, w.val)), Inr(_) => v }
}

fn Dyn::take(tys: Nat → Type, {c: Shape}, o: Option<Part(tys, c)>, v: El(tys, c)) → Option<Dyn(tys)> { match o { Some(pt) => Dyn::take_in(tys, pt, v), None => None } }

fn Dyn::put(tys: Nat → Type, {c: Shape}, o: Option<Part(tys, c)>, v: El(tys, c), w: Dyn(tys)) → El(tys, c) { match o { Some(pt) => Dyn::put_in(tys, pt, v, w), None => v } }

fn Dyn::path(tys: Nat → Type, strs: Strs(tys), sel: Sel) → Path<Dyn(tys), Dyn(tys)> {
    Path<Dyn(tys), Dyn(tys)>(
        get := λ (d: Dyn(tys)) => Dyn::take(tys, Dyn::part(tys, strs, sel, d.code), d.val),
        set := λ (d: Dyn(tys)) => λ (w: Dyn(tys)) => Dyn(d.code, Dyn::put(tys, Dyn::part(tys, strs, sel, d.code), d.val, w)),
    )
}

// What a step's write must be beyond the part's code: a window's, a list of
// its length.
fn Sel::ok(self sel: Sel, tys: Nat → Type, t: Shape, w: El(tys, t)) → Bool {
    match sel { OnSeq(q) => match q { SeqRun(_, n) => Dyn::size(tys, Dyn(t, w)).same(n), SeqOne(_) => True }, _ => True }
}

// The fit, relative to what the step read: the read's code, and the
// selection's own condition.
fn Dyn::fits(tys: Nat → Type, sel: Sel, a, w: Dyn(tys)) → Bool {
    match Shape::dec(w.code, a.code) { Inl(h) => sel.ok(tys, a.code, Shape::cast(tys, h, w.val)), Inr(_) => False }
}

// The absolute model: no fit over the written value alone makes it lawful.
fn Dyn::model(tys: Nat → Type, strs: Strs(tys)) → PathModel<Dyn(tys)> { PathModel<Dyn(tys)>(λ sel => Dyn::path(tys, strs, sel), λ _ _ => True) }

fn Dyn::no_tys() → Nat → Type { λ _ => True }

fn Dyn::no_strs() → Strs(Dyn::no_tys()) { λ k => Opaque(trivial) }

// No fit makes the element step lawful.
theorem Dyn::elem_not_lawful(fits: Dyn(Dyn::no_tys()) → Bool): ¬PathLawsOn<Dyn(Dyn::no_tys()), Dyn(Dyn::no_tys())>(Dyn::path(Dyn::no_tys(), Dyn::no_strs(), OnSeq(SeqOne(0))), fits) {
    λ laws => {
        let lists: Dyn(Dyn::no_tys()) = Dyn(SSeq(SSeq(SWord)), [Nil<Nat>]);
        let a_list: Dyn(Dyn::no_tys()) = Dyn(SSeq(SWord), Nil);
        let fit: (fits(a_list) = True) = laws.reads_fit(lists, a_list, refl);
        let back: (Dyn::path(Dyn::no_tys(), Dyn::no_strs(), OnSeq(SeqOne(0))).get(Dyn::path(Dyn::no_tys(), Dyn::no_strs(), OnSeq(SeqOne(0))).set(Dyn(SSeq(SWord), [0]), a_list)) = Some(a_list)) =
            laws.set_get(Dyn(SSeq(SWord), [0]), Dyn(SWord, 0), a_list, refl, fit);
        let codes: (SWord = SSeq(SWord)) = cong_fn(λ (o: Option<Dyn(Dyn::no_tys())>) => o.unwrap_or(Dyn(SWord, 0)).code, back);
        absurd(codes)
    }
}

// So `StepModelLaws` at `Dyn` is false for every model built of these
// steps, whatever its fits.
theorem Dyn::model_not_lawful(fits: Sel → Dyn(Dyn::no_tys()) → Bool): ¬PathModelLaws<Dyn(Dyn::no_tys())>(PathModel<Dyn(Dyn::no_tys())>(λ sel => Dyn::path(Dyn::no_tys(), Dyn::no_strs(), sel), fits)) {
    λ ml => Dyn::elem_not_lawful(fits(OnSeq(SeqOne(0))), ml.laws(OnSeq(SeqOne(0))))
}

// ---------------------------------------------------------------------------
// Laws with the fit relative to what the step read: the candidate
// replacement for `StepModelLaws`
//
// A fit compares the written value with the value the step read
// (`fits(read, written)`): a `Dyn` write fits where it has the read part's
// code, a `Val` window write where it is a sequence of the window's length.
// A write through a step keeps the owner fitting against anything it fit
// against (`KeepsFitRel`). Any model lawful under the absolute laws is
// lawful under these with its fit ignoring the read (`StepModelLawsRel::of_laws`;
// `Val`'s is `val_model_laws_rel` in the probes), and the decider's soundness holds
// over them (`Steps::apart_sound_rel`), by the same proof with the fit read
// against the outer step's read.

record PathLawsRel<S, V>(p: Path<S, V>, fits: V → V → Bool) {
    set_get: (s: S) → (a, v: V) → p.get(s) = Some(a) → fits(a, v) = True → p.get(p.set(s, v)) = Some(v),
    get_set: (s: S) → (a: V) → p.get(s) = Some(a) → p.set(s, a) = s,
    set_set: (s: S) → (a, v, w: V) → p.get(s) = Some(a) → fits(a, v) = True → fits(a, w) = True → p.set(p.set(s, v), w) = p.set(s, w),
    set_none: (s: S) → (v: V) → p.get(s) = None → p.set(s, v) = s,
    reads_fit: (s: S) → (a: V) → p.get(s) = Some(a) → fits(a, a) = True,
}

// A write through `q` keeps an owner fitting against `x` fitting against it.
fn Path::KeepsFitRel<S, V>(q: Path<S, V>, fits: S → S → Bool) → Type { (x, s: S) → fits(x, s) = True → (v: V) → fits(x, q.set(s, v)) = True }

// The absolute laws are the relative ones with the read ignored.
theorem PathLawsRel::of_on<S, V>({p: Path<S, V>}, {fits: V → Bool}, laws: PathLawsOn<S, V>(p, fits)): PathLawsRel<S, V>(p, λ _ w => fits(w)) {
    PathLawsRel(λ s a v h f => laws.set_get(s, a, v, h, f), laws.get_set, λ s a v w _ fv fw => laws.set_set(s, v, w, fv, fw), laws.set_none, laws.reads_fit)
}

theorem Path::keeps_fit_rel_of<S, V>(q: Path<S, V>, fits: S → Bool, k: Path::KeepsFit(q, fits)): Path::KeepsFitRel(q, λ _ w => fits(w)) { λ x s f v => k(s, f, v) }

record StepModelRel<S> { path: Sel → Path<S, S>, fits: Sel → S → S → Bool }

record StepModelLawsRel<S>(m: StepModelRel<S>) {
    laws: (a: Sel) → PathLawsRel<S, S>(m.path(a), m.fits(a)),
    keeps: (a, b: Sel) → Path::KeepsFitRel(m.path(b), m.fits(a)),
    apart: (a, b: Sel) → a.apart(b).IsTrue() → Apart<S, S, S>(m.path(a), m.path(b)),
}

// The denotation is `steps.hthr`'s: it reads only the paths.
fn StepModelRel::steps<S>(self m: StepModelRel<S>) → PathModel<S> { PathModel<S>(m.path, λ _ _ => True) }

fn StepModelRel::of<S>(m: PathModel<S>) → StepModelRel<S> { StepModelRel<S>(m.path, λ a _ w => m.fits(a)(w)) }

// Nothing is lost: a model lawful as `steps.hthr` states it is lawful here.
theorem StepModelLawsRel::of_laws<S>(m: PathModel<S>, ml: PathModelLaws<S>(m)): StepModelLawsRel<S>(StepModelRel::of(m)) {
    StepModelLawsRel(λ a => PathLawsRel::of_on(ml.laws(a)), λ a b => Path::keeps_fit_rel_of(m.path(b), m.fits(a), ml.keeps(a, b)), ml.apart)
}

// `Apart::under_on`, with the fit against the outer step's read.
theorem Apart::under_read_rel<S, A, B, C>(p: Path<S, A>, fits: A → A → Bool, pl: PathLawsRel<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kr: Path::KeepsFitRel(r, fits), s: S, v: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).get(p.then(r).set(s, v)) = p.then(q).get(s)
{
    λ o => match o {
        Some(a) => λ e => {
            let written: (p.then(r).set(s, v) = p.set(s, r.set(a, v))) = p.then_set_at(r, s, a, e, v);
            let read: (p.get(p.set(s, r.set(a, v))) = Some(r.set(a, v))) = pl.set_get(s, a, r.set(a, v), e, kr(a, a, pl.reads_fit(s, a, e), v));
            trans(cong_fn(λ (t: S) => p.then(q).get(t), written),
                trans(p.then_get_at(q, p.set(s, r.set(a, v)), r.set(a, v), read), trans(inner.left_after_right(a, v), sym(p.then_get_at(q, s, a, e)))))
        },
        None => λ e => cong_fn(λ (t: S) => p.then(q).get(t), p.then_set_none(r, s, e, v)),
    }
}

theorem Apart::under_commute_rel<S, A, B, C>(p: Path<S, A>, fits: A → A → Bool, pl: PathLawsRel<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kq: Path::KeepsFitRel(q, fits), kr: Path::KeepsFitRel(r, fits), s: S, b: B, c: C):
    (o: Option<A>) → p.get(s) = o → p.then(q).set(p.then(r).set(s, c), b) = p.then(r).set(p.then(q).set(s, b), c)
{
    λ o => match o {
        Some(a) => λ e => {
            let fa: (fits(a, a) = True) = pl.reads_fit(s, a, e);
            let fr: (fits(a, r.set(a, c)) = True) = kr(a, a, fa, c);
            let fq: (fits(a, q.set(a, b)) = True) = kq(a, a, fa, b);
            let sr = p.set(s, r.set(a, c));
            let sq = p.set(s, q.set(a, b));
            let read_r: (p.get(sr) = Some(r.set(a, c))) = pl.set_get(s, a, r.set(a, c), e, fr);
            let read_q: (p.get(sq) = Some(q.set(a, b))) = pl.set_get(s, a, q.set(a, b), e, fq);
            let left: (p.then(q).set(p.then(r).set(s, c), b) = p.set(s, q.set(r.set(a, c), b))) =
                trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_at(r, s, a, e, c)),
                    trans(p.then_set_at(q, sr, r.set(a, c), read_r, b), pl.set_set(s, a, r.set(a, c), q.set(r.set(a, c), b), e, fr, kq(a, r.set(a, c), fr, b))));
            let right: (p.then(r).set(p.then(q).set(s, b), c) = p.set(s, r.set(q.set(a, b), c))) =
                trans(cong_fn(λ (t: S) => p.then(r).set(t, c), p.then_set_at(q, s, a, e, b)),
                    trans(p.then_set_at(r, sq, q.set(a, b), read_q, c), pl.set_set(s, a, q.set(a, b), r.set(q.set(a, b), c), e, fq, kr(a, q.set(a, b), fq, c))));
            trans(left, trans(cong_fn(λ (x: A) => p.set(s, x), inner.writes_commute(a, b, c)), sym(right)))
        },
        None => λ e => trans(cong_fn(λ (t: S) => p.then(q).set(t, b), p.then_set_none(r, s, e, c)),
            trans(p.then_set_none(q, s, e, b), trans(sym(p.then_set_none(r, s, e, c)), cong_fn(λ (t: S) => p.then(r).set(t, c), sym(p.then_set_none(q, s, e, b)))))),
    }
}

theorem Apart::under_rel<S, A, B, C>(p: Path<S, A>, fits: A → A → Bool, pl: PathLawsRel<S, A>(p, fits), {q: Path<A, B>}, {r: Path<A, C>}, inner: Apart<A, B, C>(q, r),
    kq: Path::KeepsFitRel(q, fits), kr: Path::KeepsFitRel(r, fits)): Apart<S, B, C>(p.then(q), p.then(r))
{
    Apart(
        λ s v => Apart::under_read_rel(p, fits, pl, inner, kr, s, v, p.get(s), refl),
        λ s v => Apart::under_read_rel(p, fits, pl, Apart::symm(inner), kq, s, v, p.get(s), refl),
        λ s b c => Apart::under_commute_rel(p, fits, pl, inner, kq, kr, s, b, c, p.get(s), refl),
    )
}

theorem Path::then_keeps_fit_rel<S, A, B>(p: Path<S, A>, q: Path<A, B>, fits: S → S → Bool, kp: Path::KeepsFitRel(p, fits)): Path::KeepsFitRel(p.then(q), fits) {
    λ x s fs b => (match p.get(s) as λ o => p.get(s) = o → fits(x, p.then(q).set(s, b)) = True {
        Some(a) => λ e => j(sym(p.then_set_at(q, s, a, e, b)), λ t _ => fits(x, t) = True, kp(x, s, fs, q.set(a, b))),
        None => λ e => j(sym(p.then_set_none(q, s, e, b)), λ t _ => fits(x, t) = True, fs),
    })(refl)
}

theorem Steps::keeps_fit_rel<S>(m: StepModelRel<S>, ml: StepModelLawsRel<S>(m), ws: List<Nat>, f: Sel, a: Step, rest: List<Step>):
    Path::KeepsFitRel(PathModel::denote(m.steps(), ws, Cons(a, rest)), m.fits(f))
{
    Path::then_keeps_fit_rel(m.path(a.sel(ws)), PathModel::denote(m.steps(), ws, rest), m.fits(f), ml.keeps(f, a.sel(ws)))
}

theorem Steps::verdict_keeps_rel<S>(m: StepModelRel<S>, ml: StepModelLawsRel<S>(m), ws: List<Nat>, f: Sel, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) →
        And<Path::KeepsFitRel(PathModel::denote(m.steps(), ws, xs), m.fits(f)), Path::KeepsFitRel(PathModel::denote(m.steps(), ws, ys), m.fits(f))>
{
    match xs {
        Nil => λ ys rs no => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no => absurd(no),
            Cons(b, yr) => λ rs _ => And(Steps::keeps_fit_rel(m, ml, ws, f, a, xr), Steps::keeps_fit_rel(m, ml, ws, f, b, yr)),
        },
    }
}

// The decider is sound over the relative laws: `Steps::apart_sound`'s
// proof, with `Apart::under_rel` for `Apart::under_on`.
theorem Steps::apart_sound_rel<S>(m: StepModelRel<S>, ml: StepModelLawsRel<S>(m), ws: List<Nat>, xs: List<Step>):
    (ys: List<Step>) → (rs: List<Obligation>) → Steps::apart(xs, ys) = Some(rs) → Obligation::All(rs, ws) →
        Apart<S, S, S>(PathModel::denote(m.steps(), ws, xs), PathModel::denote(m.steps(), ws, ys))
{
    match xs {
        Nil => λ ys rs no _ => absurd(no),
        Cons(a, xr) => λ ys => match ys {
            Nil => λ rs no _ => absurd(no),
            Cons(b, yr) => λ rs => (match a.same(b) as λ c => a.same(b) = c → (match c { True => Steps::apart(xr, yr), False => a.apart(b) }) = Some(rs) →
                    Obligation::All(rs, ws) → Apart<S, S, S>(PathModel::denote(m.steps(), ws, Cons(a, xr)), PathModel::denote(m.steps(), ws, Cons(b, yr))) {
                True => λ e ok hold => {
                    let same: (a = b) = a.same_sound(b, e);
                    let fit = Steps::verdict_keeps_rel(m, ml, ws, a.sel(ws), xr, yr, rs, ok);
                    let here: Apart<S, S, S>(m.path(a.sel(ws)).then(PathModel::denote(m.steps(), ws, xr)), m.path(a.sel(ws)).then(PathModel::denote(m.steps(), ws, yr))) =
                        Apart::under_rel(m.path(a.sel(ws)), m.fits(a.sel(ws)), ml.laws(a.sel(ws)), Steps::apart_sound_rel(m, ml, ws, xr, yr, rs, ok, hold), fit.left, fit.right);
                    j(same, λ c _ => Apart<S, S, S>(m.path(a.sel(ws)).then(PathModel::denote(m.steps(), ws, xr)), m.path(c.sel(ws)).then(PathModel::denote(m.steps(), ws, yr))), here)
                },
                False => λ e ok hold =>
                    Apart::then_both(ml.apart(a.sel(ws), b.sel(ws), a.apart_sound(b, ws, rs, ok, hold)), PathModel::denote(m.steps(), ws, xr), PathModel::denote(m.steps(), ws, yr)),
            })(refl)
        },
    }
}

// ---------------------------------------------------------------------------
// `Dyn`'s laws, relative to the read, from the dictionaries' laws
//
// One part's laws carry over to the tagged step: a read is the part's read
// with its code, and a write that fits is a value of the part's code
// (`Dyn::fit_at`), which the write casts by a decision that is `refl` at one
// code (`Shape::dec_self`). The cast back (`Dyn::cast_back`) is `J` on the
// decision's proof with the code free: no unique identity proofs.

theorem Dyn::cast_back(tys: Nat → Type, c: Shape, wv: El(tys, c)): (t: Shape) → (h: c = t) → Dyn(t, Shape::cast(tys, h, wv)) = Dyn(c, wv) {
    λ t h => j(h, λ t2 h2 => Dyn(t2, Shape::cast(tys, h2, wv)) = Dyn(c, wv), refl)
}

theorem Dyn::put_in_at(tys: Nat → Type, {c: Shape}, pt: Part(tys, c), v: El(tys, c), w0: El(tys, pt.t)): Dyn::put_in(tys, pt, v, Dyn(pt.t, w0)) = pt.p.set(v, w0) {
    j(sym(Shape::dec_self(pt.t)), λ r _ => (match r { Inl(h) => pt.p.set(v, Shape::cast(tys, h, w0)), Inr(_) => v }) = pt.p.set(v, w0), refl)
}

// A write that fits a read of code `t` is a value of code `t`.
record FitAt(tys: Nat → Type, sel: Sel, t: Shape, w: Dyn(tys)) { w0: El(tys, t), is: w = Dyn(t, w0), ok: sel.ok(tys, t, w0) = True }

theorem Dyn::fit_at(tys: Nat → Type, sel: Sel, t: Shape, y0: El(tys, t), w: Dyn(tys), f: Dyn::fits(tys, sel, Dyn(t, y0), w) = True): FitAt(tys, sel, t, w) {
    (match Shape::dec(w.code, t) as λ r => (match r { Inl(h) => sel.ok(tys, t, Shape::cast(tys, h, w.val)), Inr(_) => False }) = True → FitAt(tys, sel, t, w) {
        Inl(h) => λ ok => FitAt(Shape::cast(tys, h, w.val), sym(Dyn::cast_back(tys, w.code, w.val, t, h)), ok),
        Inr(_) => λ no => absurd(no),
    })(f)
}

// What a part read: a value of the part's code.
record ReadAt(tys: Nat → Type, c: Shape, pt: Part(tys, c), v: El(tys, c), a: Dyn(tys)) { y0: El(tys, pt.t), got: pt.p.get(v) = Some(y0), is: a = Dyn(pt.t, y0) }

theorem Dyn::read_at(tys: Nat → Type, {c: Shape}, pt: Part(tys, c), v: El(tys, c), a: Dyn(tys), h: Dyn::take_in(tys, pt, v) = Some(a)): ReadAt(tys, c, pt, v, a) {
    (match pt.p.get(v) as λ o => pt.p.get(v) = o → o.map(λ y => Dyn(pt.t, y)) = Some(a) → ReadAt(tys, c, pt, v, a) {
        Some(y) => λ e m => ReadAt(y, e, sym(Option::some_inj(Dyn(pt.t, y), a, m))),
        None => λ _ no => absurd(no),
    })(refl, h)
}

theorem Dyn::none_at(tys: Nat → Type, {c: Shape}, pt: Part(tys, c), v: El(tys, c), h: Dyn::take_in(tys, pt, v) = None): pt.p.get(v) = None {
    (match pt.p.get(v) as λ o => pt.p.get(v) = o → o.map(λ y => Dyn(pt.t, y)) = None → pt.p.get(v) = None { Some(_) => λ _ no => absurd(no), None => λ e _ => e })(refl, h)
}

// The part's laws, where what is written meets the selection's condition.
fn Dyn::PartLaws(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c)) → Type { PathLawsOn<El(tys, c), El(tys, pt.t)>(pt.p, λ w0 => sel.ok(tys, pt.t, w0)) }

theorem Dyn::in_set_get(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c), pl: Dyn::PartLaws(tys, sel, pt), v: El(tys, c), a, w: Dyn(tys),
    h: Dyn::take_in(tys, pt, v) = Some(a), f: Dyn::fits(tys, sel, a, w) = True): Dyn::take_in(tys, pt, Dyn::put_in(tys, pt, v, w)) = Some(w)
{
    let r = Dyn::read_at(tys, pt, v, a, h);
    let fa = Dyn::fit_at(tys, sel, pt.t, r.y0, w, j(r.is, λ x _ => Dyn::fits(tys, sel, x, w) = True, f));
    let back: (Dyn::take_in(tys, pt, Dyn::put_in(tys, pt, v, Dyn(pt.t, fa.w0))) = Some(Dyn(pt.t, fa.w0))) =
        trans(cong_fn(λ (u: El(tys, c)) => Dyn::take_in(tys, pt, u), Dyn::put_in_at(tys, pt, v, fa.w0)),
            cong_fn(λ (o: Option<El(tys, pt.t)>) => o.map(λ y => Dyn(pt.t, y)), pl.set_get(v, r.y0, fa.w0, r.got, fa.ok)));
    j(sym(fa.is), λ x _ => Dyn::take_in(tys, pt, Dyn::put_in(tys, pt, v, x)) = Some(x), back)
}

theorem Dyn::in_get_set(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c), pl: Dyn::PartLaws(tys, sel, pt), v: El(tys, c), a: Dyn(tys),
    h: Dyn::take_in(tys, pt, v) = Some(a)): Dyn::put_in(tys, pt, v, a) = v
{
    let r = Dyn::read_at(tys, pt, v, a, h);
    j(sym(r.is), λ x _ => Dyn::put_in(tys, pt, v, x) = v, trans(Dyn::put_in_at(tys, pt, v, r.y0), pl.get_set(v, r.y0, r.got)))
}

theorem Dyn::in_set_set(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c), pl: Dyn::PartLaws(tys, sel, pt), v: El(tys, c), a, w1, w2: Dyn(tys),
    h: Dyn::take_in(tys, pt, v) = Some(a), f1: Dyn::fits(tys, sel, a, w1) = True, f2: Dyn::fits(tys, sel, a, w2) = True):
    Dyn::put_in(tys, pt, Dyn::put_in(tys, pt, v, w1), w2) = Dyn::put_in(tys, pt, v, w2)
{
    let r = Dyn::read_at(tys, pt, v, a, h);
    let fa1 = Dyn::fit_at(tys, sel, pt.t, r.y0, w1, j(r.is, λ x _ => Dyn::fits(tys, sel, x, w1) = True, f1));
    let fa2 = Dyn::fit_at(tys, sel, pt.t, r.y0, w2, j(r.is, λ x _ => Dyn::fits(tys, sel, x, w2) = True, f2));
    let at: (Dyn::put_in(tys, pt, Dyn::put_in(tys, pt, v, Dyn(pt.t, fa1.w0)), Dyn(pt.t, fa2.w0)) = Dyn::put_in(tys, pt, v, Dyn(pt.t, fa2.w0))) =
        trans(Dyn::put_in_at(tys, pt, Dyn::put_in(tys, pt, v, Dyn(pt.t, fa1.w0)), fa2.w0),
            trans(cong_fn(λ (u: El(tys, c)) => pt.p.set(u, fa2.w0), Dyn::put_in_at(tys, pt, v, fa1.w0)),
                trans(pl.set_set(v, fa1.w0, fa2.w0, fa1.ok, fa2.ok), sym(Dyn::put_in_at(tys, pt, v, fa2.w0)))));
    j(sym(fa2.is), λ x2 _ => Dyn::put_in(tys, pt, Dyn::put_in(tys, pt, v, w1), x2) = Dyn::put_in(tys, pt, v, x2),
        j(sym(fa1.is), λ x1 _ => Dyn::put_in(tys, pt, Dyn::put_in(tys, pt, v, x1), Dyn(pt.t, fa2.w0)) = Dyn::put_in(tys, pt, v, Dyn(pt.t, fa2.w0)), at))
}

theorem Dyn::in_set_none(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c), pl: Dyn::PartLaws(tys, sel, pt), v: El(tys, c), w: Dyn(tys),
    h: Dyn::take_in(tys, pt, v) = None): Dyn::put_in(tys, pt, v, w) = v
{
    let none: (pt.p.get(v) = None) = Dyn::none_at(tys, pt, v, h);
    match Shape::dec(w.code, pt.t) {
        Inl(h2) => pl.set_none(v, Shape::cast(tys, h2, w.val), none),
        Inr(_) => refl,
    }
}

theorem Dyn::in_reads_fit(tys: Nat → Type, sel: Sel, {c: Shape}, pt: Part(tys, c), pl: Dyn::PartLaws(tys, sel, pt), v: El(tys, c), a: Dyn(tys),
    h: Dyn::take_in(tys, pt, v) = Some(a)): Dyn::fits(tys, sel, a, a) = True
{
    let r = Dyn::read_at(tys, pt, v, a, h);
    let at: (Dyn::fits(tys, sel, Dyn(pt.t, r.y0), Dyn(pt.t, r.y0)) = True) =
        j(sym(Shape::dec_self(pt.t)), λ o _ => (match o { Inl(h2) => sel.ok(tys, pt.t, Shape::cast(tys, h2, r.y0)), Inr(_) => False }) = True, pl.reads_fit(v, r.y0, r.got));
    j(sym(r.is), λ x _ => Dyn::fits(tys, sel, x, x) = True, at)
}

// Where the step has no part at the owner's code, it reads nothing and
// writes nothing.
fn Dyn::OptLaws(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>) → Type { match o { Some(pt) => Dyn::PartLaws(tys, sel, pt), None => True } }

theorem Dyn::opt_set_get(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>, ol: Dyn::OptLaws(tys, sel, o), v: El(tys, c), a, w: Dyn(tys),
    h: Dyn::take(tys, o, v) = Some(a), f: Dyn::fits(tys, sel, a, w) = True): Dyn::take(tys, o, Dyn::put(tys, o, v, w)) = Some(w)
{
    (match o as λ o2 => Dyn::OptLaws(tys, sel, o2) → Dyn::take(tys, o2, v) = Some(a) → Dyn::take(tys, o2, Dyn::put(tys, o2, v, w)) = Some(w) {
        Some(pt) => λ pl h2 => Dyn::in_set_get(tys, sel, pt, pl, v, a, w, h2, f),
        None => λ _ no => absurd(no),
    })(ol, h)
}

theorem Dyn::opt_get_set(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>, ol: Dyn::OptLaws(tys, sel, o), v: El(tys, c), a: Dyn(tys),
    h: Dyn::take(tys, o, v) = Some(a)): Dyn::put(tys, o, v, a) = v
{
    (match o as λ o2 => Dyn::OptLaws(tys, sel, o2) → Dyn::take(tys, o2, v) = Some(a) → Dyn::put(tys, o2, v, a) = v {
        Some(pt) => λ pl h2 => Dyn::in_get_set(tys, sel, pt, pl, v, a, h2),
        None => λ _ no => absurd(no),
    })(ol, h)
}

theorem Dyn::opt_set_set(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>, ol: Dyn::OptLaws(tys, sel, o), v: El(tys, c), a, w1, w2: Dyn(tys),
    h: Dyn::take(tys, o, v) = Some(a), f1: Dyn::fits(tys, sel, a, w1) = True, f2: Dyn::fits(tys, sel, a, w2) = True):
    Dyn::put(tys, o, Dyn::put(tys, o, v, w1), w2) = Dyn::put(tys, o, v, w2)
{
    (match o as λ o2 => Dyn::OptLaws(tys, sel, o2) → Dyn::take(tys, o2, v) = Some(a) → Dyn::put(tys, o2, Dyn::put(tys, o2, v, w1), w2) = Dyn::put(tys, o2, v, w2) {
        Some(pt) => λ pl h2 => Dyn::in_set_set(tys, sel, pt, pl, v, a, w1, w2, h2, f1, f2),
        None => λ _ _ => refl,
    })(ol, h)
}

theorem Dyn::opt_set_none(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>, ol: Dyn::OptLaws(tys, sel, o), v: El(tys, c), w: Dyn(tys),
    h: Dyn::take(tys, o, v) = None): Dyn::put(tys, o, v, w) = v
{
    (match o as λ o2 => Dyn::OptLaws(tys, sel, o2) → Dyn::take(tys, o2, v) = None → Dyn::put(tys, o2, v, w) = v {
        Some(pt) => λ pl h2 => Dyn::in_set_none(tys, sel, pt, pl, v, w, h2),
        None => λ _ _ => refl,
    })(ol, h)
}

theorem Dyn::opt_reads_fit(tys: Nat → Type, sel: Sel, {c: Shape}, o: Option<Part(tys, c)>, ol: Dyn::OptLaws(tys, sel, o), v: El(tys, c), a: Dyn(tys),
    h: Dyn::take(tys, o, v) = Some(a)): Dyn::fits(tys, sel, a, a) = True
{
    (match o as λ o2 => Dyn::OptLaws(tys, sel, o2) → Dyn::take(tys, o2, v) = Some(a) → Dyn::fits(tys, sel, a, a) = True {
        Some(pt) => λ pl h2 => Dyn::in_reads_fit(tys, sel, pt, pl, v, a, h2),
        None => λ _ no => absurd(no),
    })(ol, h)
}

// A step's laws at every owner, from its part's laws at every code.
theorem Dyn::path_laws(tys: Nat → Type, strs: Strs(tys), sel: Sel, ol: (c: Shape) → Dyn::OptLaws(tys, sel, Dyn::part(tys, strs, sel, c))):
    PathLawsRel<Dyn(tys), Dyn(tys)>(Dyn::path(tys, strs, sel), λ a w => Dyn::fits(tys, sel, a, w))
{
    PathLawsRel(
        λ s a w h f => Dyn::opt_set_get(tys, sel, Dyn::part(tys, strs, sel, s.code), ol(s.code), s.val, a, w, h, f),
        λ s a h => cong_fn(λ (u: El(tys, s.code)) => Dyn(s.code, u), Dyn::opt_get_set(tys, sel, Dyn::part(tys, strs, sel, s.code), ol(s.code), s.val, a, h)),
        λ s a w1 w2 h f1 f2 => cong_fn(λ (u: El(tys, s.code)) => Dyn(s.code, u), Dyn::opt_set_set(tys, sel, Dyn::part(tys, strs, sel, s.code), ol(s.code), s.val, a, w1, w2, h, f1, f2)),
        λ s w h => cong_fn(λ (u: El(tys, s.code)) => Dyn(s.code, u), Dyn::opt_set_none(tys, sel, Dyn::part(tys, strs, sel, s.code), ol(s.code), s.val, w, h)),
        λ s a h => Dyn::opt_reads_fit(tys, sel, Dyn::part(tys, strs, sel, s.code), ol(s.code), s.val, a, h),
    )
}

// ---------------------------------------------------------------------------
// The dictionaries' laws: the window's list step, and the structures'

theorem Dyn::vec_list_fits<A>(n: Nat, pad: A, v: [A; n], r: List<A>, f: r.len().same(n) = True): Dyn::vec_list<A>(n, pad).set(v, r) = r.vector_of(n, pad) {
    j(sym(f), λ b _ => (match b { True => r.vector_of(n, pad), False => v }) = r.vector_of(n, pad), refl)
}

theorem Dyn::entries_fit<A>(n: Nat, v: [A; n]): vector_entries(v).len().same(n) = True {
    trans(cong_fn(λ (k: Nat) => k.same(n), vector_entries_len(n, v)), n.same_self())
}

theorem Dyn::vec_list_laws<A>(n: Nat, pad: A): PathLawsOn<[A; n], List<A>>(Dyn::vec_list<A>(n, pad), λ r => r.len().same(n)) {
    PathLawsOn(
        λ v a r h f => trans(cong_fn(λ (u: [A; n]) => Some(vector_entries(u)), Dyn::vec_list_fits(n, pad, v, r, f)),
            cong_fn(λ (ys: List<A>) => Some(ys), List::entries_vector_of(n, pad, r, r.len().same_sound(n, f)))),
        λ v a h => j(Option::some_inj(vector_entries(v), a, h), λ x _ => Dyn::vec_list<A>(n, pad).set(v, x) = v,
            trans(Dyn::vec_list_fits(n, pad, v, vector_entries(v), Dyn::entries_fit(n, v)), vector_of_entries_exact(n, pad, v))),
        λ v r1 r2 f1 f2 => trans(Dyn::vec_list_fits(n, pad, Dyn::vec_list<A>(n, pad).set(v, r1), r2, f2), sym(Dyn::vec_list_fits(n, pad, v, r2, f2))),
        λ v r no => absurd(no),
        λ v a h => j(Option::some_inj(vector_entries(v), a, h), λ x _ => x.len().same(n) = True, Dyn::entries_fit(n, v)),
    )
}

// A record's fields are lawful paths, pairwise apart: what a derived
// instance proves once per record.
record FieldsLaws(tys: Nat → Type, T: Type, fs: List<Field(tys, T)>) {
    lawful: (i: Nat) → (f: Field(tys, T)) → fs.nth(i) = Some(f) → PathLaws<T, El(tys, f.shape)>(f.path),
    apart: (i, k: Nat) → (f, g: Field(tys, T)) → fs.nth(i) = Some(f) → fs.nth(k) = Some(g) → ¬(i = k) → Apart<T, El(tys, f.shape), El(tys, g.shape)>(f.path, g.path),
}

fn StructLaws(tys: Nat → Type, {T: Type}, st: Struct(tys, T)) → Type { match st { Opaque(_) => True, Fields(_, fs) => FieldsLaws(tys, T, fs) } }

fn StrsLaws(tys: Nat → Type, strs: Strs(tys)) → Type { (k: Nat) → StructLaws(tys, strs(k)) }

theorem Dyn::seq_part_laws(tys: Nat → Type, strs: Strs(tys), x: Shape, q: SeqSel): Dyn::PartLaws(tys, OnSeq(q), Dyn::seq_part(tys, strs, x, q)) {
    match q {
        SeqOne(i) => Path::elem_laws<El(tys, x)>(i).on(),
        SeqRun(lo, n) => Path::window<El(tys, x)>(lo, n).then_laws_on(Dyn::vec_list<El(tys, x)>(n, Dyn::dflt(tys, strs, x)), λ r => r.len().same(n),
            Path::window_laws<El(tys, x)>(lo, n), Dyn::vec_list_laws<El(tys, x)>(n, Dyn::dflt(tys, strs, x))),
    }
}

theorem Dyn::field_part_laws(tys: Nat → Type, k: Nat, i: Nat): (st: Struct(tys, tys(k))) → StructLaws(tys, st) → Dyn::OptLaws(tys, OnField(i), Dyn::field_part(tys, k, st, i)) {
    λ st => match st {
        Opaque(_) => λ _ => trivial,
        Fields(_, fs) => λ fl => (match fs.nth(i) as λ o => fs.nth(i) = o →
                Dyn::OptLaws(tys, OnField(i), match o { Some(f) => Some(Part(f.shape, f.path)), None => None<Part(tys, SNamed(k))>() }) {
            Some(f) => λ e => fl.lawful(i, f, e).on(),
            None => λ _ => trivial,
        })(refl),
    }
}

theorem Dyn::part_laws(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), sel: Sel): (c: Shape) → Dyn::OptLaws(tys, sel, Dyn::part(tys, strs, sel, c)) {
    λ c => match c {
        SWord => trivial,
        SSeq(x) => match sel { OnSeq(q) => Dyn::seq_part_laws(tys, strs, x, q), OnField(_) => trivial, OnKey(_) => trivial, OnVariant(_) => trivial },
        SNamed(k) => match sel { OnField(i) => Dyn::field_part_laws(tys, k, i, strs(k), sl(k)), OnSeq(_) => trivial, OnKey(_) => trivial, OnVariant(_) => trivial },
    }
}

// ---------------------------------------------------------------------------
// Every write keeps the owner's code (by construction) and a list's
// length, so it keeps every fit against anything

theorem Dyn::seq_part_in(tys: Nat → Type, strs: Strs(tys), x: Shape, q: SeqSel):
    PathIn<El(tys, x), El(tys, Dyn::seq_part(tys, strs, x, q).t)>(Dyn::seq_part(tys, strs, x, q).p, q.span())
{
    match q { SeqOne(i) => Path::elem_in<El(tys, x)>(i), SeqRun(lo, n) => Path::window_in<El(tys, x)>(lo, n).then(Dyn::vec_list<El(tys, x)>(n, Dyn::dflt(tys, strs, x))) }
}

theorem Dyn::size_cast(tys: Nat → Type, c: Shape, w: El(tys, c)): (t: Shape) → (h: c = t) → Dyn::size(tys, Dyn(t, Shape::cast(tys, h, w))) = Dyn::size(tys, Dyn(c, w)) {
    λ t h => j(h, λ t2 h2 => Dyn::size(tys, Dyn(t2, Shape::cast(tys, h2, w))) = Dyn::size(tys, Dyn(c, w)), refl)
}

theorem Dyn::seq_put_len(tys: Nat → Type, strs: Strs(tys), x: Shape, q: SeqSel, w: List<El(tys, x)>, v: Dyn(tys)):
    List::len(Dyn::put_in(tys, Dyn::seq_part(tys, strs, x, q), w, v)) = List::len(w)
{
    match Shape::dec(v.code, Dyn::seq_part(tys, strs, x, q).t) {
        Inl(h) => Dyn::seq_part_in(tys, strs, x, q).shape(w, Shape::cast(tys, h, v.val)),
        Inr(_) => refl,
    }
}

theorem Dyn::put_size(tys: Nat → Type, strs: Strs(tys), b: Sel, c: Shape, w: El(tys, c), v: Dyn(tys)):
    Dyn::size(tys, Dyn(c, Dyn::put(tys, Dyn::part(tys, strs, b, c), w, v))) = Dyn::size(tys, Dyn(c, w))
{
    (match c as λ c2 => (w2: El(tys, c2)) → Dyn::size(tys, Dyn(c2, Dyn::put(tys, Dyn::part(tys, strs, b, c2), w2, v))) = Dyn::size(tys, Dyn(c2, w2)) {
        SWord => λ _ => refl,
        SSeq(x) => λ w2 => match b { OnSeq(q) => Dyn::seq_put_len(tys, strs, x, q, w2, v), OnField(_) => refl, OnKey(_) => refl, OnVariant(_) => refl },
        SNamed(_) => λ _ => refl,
    })(w)
}

theorem Sel::ok_size(self a: Sel, tys: Nat → Type, t: Shape, w1, w2: El(tys, t), same: Dyn::size(tys, Dyn(t, w1)) = Dyn::size(tys, Dyn(t, w2))): a.ok(tys, t, w1) = a.ok(tys, t, w2) {
    match a {
        OnSeq(q) => match q { SeqRun(_, n) => cong_fn(λ (k: Nat) => k.same(n), same), SeqOne(_) => refl },
        OnField(_) => refl,
        OnKey(_) => refl,
        OnVariant(_) => refl,
    }
}

theorem Dyn::keeps(tys: Nat → Type, strs: Strs(tys), a, b: Sel): Path::KeepsFitRel(Dyn::path(tys, strs, b), λ x w => Dyn::fits(tys, a, x, w)) {
    λ x s f v => (match Shape::dec(s.code, x.code) as λ r =>
            (match r { Inl(h) => a.ok(tys, x.code, Shape::cast(tys, h, s.val)), Inr(_) => False }) = True →
            (match r { Inl(h) => a.ok(tys, x.code, Shape::cast(tys, h, Dyn::put(tys, Dyn::part(tys, strs, b, s.code), s.val, v))), Inr(_) => False }) = True {
        Inl(h) => λ ok => trans(a.ok_size(tys, x.code, Shape::cast(tys, h, Dyn::put(tys, Dyn::part(tys, strs, b, s.code), s.val, v)), Shape::cast(tys, h, s.val),
                trans(Dyn::size_cast(tys, s.code, Dyn::put(tys, Dyn::part(tys, strs, b, s.code), s.val, v), x.code, h),
                    trans(Dyn::put_size(tys, strs, b, s.code, s.val, v), sym(Dyn::size_cast(tys, s.code, s.val, x.code, h))))), ok),
        Inr(_) => λ no => absurd(no),
    })(f)
}

// ---------------------------------------------------------------------------
// Two selections apart are apart at `Dyn`: by the parts' spans, or by the
// fields' apartness the structure states; a part absent at the owner's
// code reads and writes nothing

fn Dyn::OptApart(tys: Nat → Type, {c: Shape}, o1, o2: Option<Part(tys, c)>) → Type {
    match o1 { Some(p1) => match o2 { Some(p2) => Apart<El(tys, c), El(tys, p1.t), El(tys, p2.t)>(p1.p, p2.p), None => True }, None => True }
}

theorem Dyn::opt_apart_symm(tys: Nat → Type, {c: Shape}, o1, o2: Option<Part(tys, c)>, ap: Dyn::OptApart(tys, o1, o2)): Dyn::OptApart(tys, o2, o1) {
    (match o1 as λ x1 => Dyn::OptApart(tys, x1, o2) → Dyn::OptApart(tys, o2, x1) {
        None => λ _ => match o2 { Some(_) => trivial, None => trivial },
        Some(_) => match o2 {
            None => λ _ => trivial,
            Some(_) => λ a2 => Apart::symm(a2),
        },
    })(ap)
}

theorem Dyn::in_after(tys: Nat → Type, {c: Shape}, p1, p2: Part(tys, c), ap: Apart<El(tys, c), El(tys, p1.t), El(tys, p2.t)>(p1.p, p2.p), v: El(tys, c), w: Dyn(tys)):
    Dyn::take_in(tys, p1, Dyn::put_in(tys, p2, v, w)) = Dyn::take_in(tys, p1, v)
{
    (match Shape::dec(w.code, p2.t) as λ r => Dyn::take_in(tys, p1, match r { Inl(h) => p2.p.set(v, Shape::cast(tys, h, w.val)), Inr(_) => v }) = Dyn::take_in(tys, p1, v) {
        Inl(h) => cong_fn(λ (o: Option<El(tys, p1.t)>) => o.map(λ y => Dyn(p1.t, y)), ap.left_after_right(v, Shape::cast(tys, h, w.val))),
        Inr(_) => refl,
    })
}

theorem Dyn::opt_after(tys: Nat → Type, {c: Shape}, o1, o2: Option<Part(tys, c)>, ap: Dyn::OptApart(tys, o1, o2), v: El(tys, c), w: Dyn(tys)):
    Dyn::take(tys, o1, Dyn::put(tys, o2, v, w)) = Dyn::take(tys, o1, v)
{
    (match o1 as λ x1 => Dyn::OptApart(tys, x1, o2) → Dyn::take(tys, x1, Dyn::put(tys, o2, v, w)) = Dyn::take(tys, x1, v) {
        None => λ _ => refl,
        Some(p1) => match o2 {
            None => λ _ => refl,
            Some(p2) => λ a2 => Dyn::in_after(tys, p1, p2, a2, v, w),
        },
    })(ap)
}

theorem Dyn::in_commute(tys: Nat → Type, {c: Shape}, p1, p2: Part(tys, c), ap: Apart<El(tys, c), El(tys, p1.t), El(tys, p2.t)>(p1.p, p2.p), v: El(tys, c), w1, w2: Dyn(tys)):
    Dyn::put_in(tys, p1, Dyn::put_in(tys, p2, v, w2), w1) = Dyn::put_in(tys, p2, Dyn::put_in(tys, p1, v, w1), w2)
{
    (match Shape::dec(w1.code, p1.t) as λ r1 =>
            (match r1 { Inl(h1) => p1.p.set(Dyn::put_in(tys, p2, v, w2), Shape::cast(tys, h1, w1.val)), Inr(_) => Dyn::put_in(tys, p2, v, w2) }) =
            Dyn::put_in(tys, p2, match r1 { Inl(h1) => p1.p.set(v, Shape::cast(tys, h1, w1.val)), Inr(_) => v }, w2) {
        Inl(h1) => (match Shape::dec(w2.code, p2.t) as λ r2 =>
                p1.p.set(match r2 { Inl(h2) => p2.p.set(v, Shape::cast(tys, h2, w2.val)), Inr(_) => v }, Shape::cast(tys, h1, w1.val)) =
                (match r2 { Inl(h2) => p2.p.set(p1.p.set(v, Shape::cast(tys, h1, w1.val)), Shape::cast(tys, h2, w2.val)), Inr(_) => p1.p.set(v, Shape::cast(tys, h1, w1.val)) }) {
            Inl(h2) => ap.writes_commute(v, Shape::cast(tys, h1, w1.val), Shape::cast(tys, h2, w2.val)),
            Inr(_) => refl,
        }),
        Inr(_) => refl,
    })
}

theorem Dyn::opt_commute(tys: Nat → Type, {c: Shape}, o1, o2: Option<Part(tys, c)>, ap: Dyn::OptApart(tys, o1, o2), v: El(tys, c), w1, w2: Dyn(tys)):
    Dyn::put(tys, o1, Dyn::put(tys, o2, v, w2), w1) = Dyn::put(tys, o2, Dyn::put(tys, o1, v, w1), w2)
{
    (match o1 as λ x1 => Dyn::OptApart(tys, x1, o2) → Dyn::put(tys, x1, Dyn::put(tys, o2, v, w2), w1) = Dyn::put(tys, o2, Dyn::put(tys, x1, v, w1), w2) {
        None => λ _ => refl,
        Some(p1) => match o2 {
            None => λ _ => refl,
            Some(p2) => λ a2 => Dyn::in_commute(tys, p1, p2, a2, v, w1, w2),
        },
    })(ap)
}

theorem Dyn::path_apart(tys: Nat → Type, strs: Strs(tys), a, b: Sel, oa: (c: Shape) → Dyn::OptApart(tys, Dyn::part(tys, strs, a, c), Dyn::part(tys, strs, b, c))):
    Apart<Dyn(tys), Dyn(tys), Dyn(tys)>(Dyn::path(tys, strs, a), Dyn::path(tys, strs, b))
{
    Apart(
        λ s w => Dyn::opt_after(tys, Dyn::part(tys, strs, a, s.code), Dyn::part(tys, strs, b, s.code), oa(s.code), s.val, w),
        λ s w => Dyn::opt_after(tys, Dyn::part(tys, strs, b, s.code), Dyn::part(tys, strs, a, s.code),
            Dyn::opt_apart_symm(tys, Dyn::part(tys, strs, a, s.code), Dyn::part(tys, strs, b, s.code), oa(s.code)), s.val, w),
        λ s w1 w2 => cong_fn(λ (u: El(tys, s.code)) => Dyn(s.code, u),
            Dyn::opt_commute(tys, Dyn::part(tys, strs, a, s.code), Dyn::part(tys, strs, b, s.code), oa(s.code), s.val, w1, w2)),
    )
}

theorem Dyn::opt_apart_none(tys: Nat → Type, {c: Shape}, o: Option<Part(tys, c)>): Dyn::OptApart(tys, o, None) { match o { Some(_) => trivial, None => trivial } }

theorem Dyn::span_ne(i, l: Nat, v: Span(i, 1).apart(Span(l, 1)).IsTrue()): ¬(i = l) { λ e => omega(v, e) }

theorem Dyn::fields_apart(tys: Nat → Type, k, i, l: Nat, ne: ¬(i = l)): (st: Struct(tys, tys(k))) → StructLaws(tys, st) →
    Dyn::OptApart(tys, Dyn::field_part(tys, k, st, i), Dyn::field_part(tys, k, st, l))
{
    λ st => match st {
        Opaque(_) => λ _ => trivial,
        Fields(_, fs) => λ fl => (match fs.nth(i) as λ o1 => fs.nth(i) = o1 →
                Dyn::OptApart(tys, match o1 { Some(f) => Some(Part(f.shape, f.path)), None => None<Part(tys, SNamed(k))>() },
                    match fs.nth(l) { Some(g) => Some(Part(g.shape, g.path)), None => None<Part(tys, SNamed(k))>() }) {
            None => λ _ => trivial,
            Some(f) => λ ei => (match fs.nth(l) as λ o2 => fs.nth(l) = o2 →
                    Dyn::OptApart(tys, Some(Part(f.shape, f.path)), match o2 { Some(g) => Some(Part(g.shape, g.path)), None => None<Part(tys, SNamed(k))>() }) {
                None => λ _ => trivial,
                Some(g) => λ el => fl.apart(i, l, f, g, ei, el, ne),
            })(refl),
        })(refl),
    }
}

theorem Dyn::parts_apart(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), a, b: Sel, v: a.apart(b).IsTrue()):
    (c: Shape) → Dyn::OptApart(tys, Dyn::part(tys, strs, a, c), Dyn::part(tys, strs, b, c))
{
    λ c => match c {
        SWord => trivial,
        SSeq(x) => (match a as λ a2 => a2.apart(b).IsTrue() → Dyn::OptApart(tys, Dyn::part(tys, strs, a2, SSeq(x)), Dyn::part(tys, strs, b, SSeq(x))) {
            OnSeq(qa) => match b {
                OnSeq(qb) => λ v2 => PathIn::apart_sound(Dyn::seq_part_in(tys, strs, x, qa), Dyn::seq_part_in(tys, strs, x, qb), v2),
                OnField(_) => λ _ => trivial,
                OnKey(_) => λ _ => trivial,
                OnVariant(_) => λ _ => trivial,
            },
            OnField(_) => λ _ => trivial,
            OnKey(_) => λ _ => trivial,
            OnVariant(_) => λ _ => trivial,
        })(v),
        SNamed(k) => (match a as λ a2 => a2.apart(b).IsTrue() → Dyn::OptApart(tys, Dyn::part(tys, strs, a2, SNamed(k)), Dyn::part(tys, strs, b, SNamed(k))) {
            OnField(i) => match b {
                OnField(l) => λ v2 => Dyn::fields_apart(tys, k, i, l, Dyn::span_ne(i, l, v2), strs(k), sl(k)),
                OnSeq(_) => λ _ => Dyn::opt_apart_none(tys, Dyn::field_part(tys, k, strs(k), i)),
                OnKey(_) => λ _ => Dyn::opt_apart_none(tys, Dyn::field_part(tys, k, strs(k), i)),
                OnVariant(_) => λ _ => Dyn::opt_apart_none(tys, Dyn::field_part(tys, k, strs(k), i)),
            },
            OnSeq(_) => λ _ => trivial,
            OnKey(_) => λ _ => trivial,
            OnVariant(_) => λ _ => trivial,
        })(v),
    }
}

// ---------------------------------------------------------------------------
// The model, lawful relative to the read, from the structures' laws alone

fn Dyn::model_rel(tys: Nat → Type, strs: Strs(tys)) → StepModelRel<Dyn(tys)> {
    StepModelRel<Dyn(tys)>(λ sel => Dyn::path(tys, strs, sel), λ sel a w => Dyn::fits(tys, sel, a, w))
}

theorem Dyn::model_laws_rel(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs)): StepModelLawsRel<Dyn(tys)>(Dyn::model_rel(tys, strs)) {
    StepModelLawsRel(
        λ a => Dyn::path_laws(tys, strs, a, Dyn::part_laws(tys, strs, sl, a)),
        λ a b => Dyn::keeps(tys, strs, a, b),
        λ a b v => Dyn::path_apart(tys, strs, a, b, Dyn::parts_apart(tys, strs, sl, a, b, v)),
    )
}

// The decider's verdict, its obligations holding, gives two places of a
// `Dyn` apart.
theorem Dyn::apart(tys: Nat → Type, strs: Strs(tys), sl: StrsLaws(tys, strs), ws: List<Nat>, xs, ys: List<Step>, rs: List<Obligation>,
    ok: Steps::apart(xs, ys) = Some(rs), hold: Obligation::All(rs, ws)):
    Apart<Dyn(tys), Dyn(tys), Dyn(tys)>(PathModel::denote(Dyn::model_rel(tys, strs).steps(), ws, xs), PathModel::denote(Dyn::model_rel(tys, strs).steps(), ws, ys))
{
    Steps::apart_sound_rel(Dyn::model_rel(tys, strs), Dyn::model_laws_rel(tys, strs, sl), ws, xs, ys, rs, ok, hold)
}

// ---------------------------------------------------------------------------
// Level 2 in miniature: a heap of blocks of one sort, a view as a block and
// steps, and the step lemma a single-sorted soundness proof rests on, from
// the relative laws alone
//
// A store through a view leaves every view the decider finds apart from it
// reading what it read: in another block by the heap's frame, in the same
// block by `Steps::apart_sound_rel`. Nothing here looks inside a value of
// `S`, so at `S = Dyn` nothing looks inside a code.

record View { b: Nat, steps: List<Step> }

fn View::read<S>(self r: View, m: StepModelRel<S>, ws: List<Nat>, heap: List<S>) → Option<S> {
    heap.nth(r.b).and_then(λ o => PathModel::denote(m.steps(), ws, r.steps).get(o))
}

fn View::write<S>(self r: View, m: StepModelRel<S>, ws: List<Nat>, heap: List<S>, x: S) → List<S> {
    heap.update(r.b, λ o => PathModel::denote(m.steps(), ws, r.steps).set(o, x))
}

theorem List::nth_update_map<A>(self xs: List<A>): (i: Nat) → (f: A → A) → xs.update(i, f).nth(i) = xs.nth(i).map(f) {
    match xs { Nil => λ i f => refl, Cons(_, t) => λ i => match i { Zero => λ f => refl, Succ(k) => λ f => t.nth_update_map(k, f) } }
}

// Two views apart: in different blocks, or in one block where the decider
// answers and its obligations hold.
inductive ViewsApart(ws: List<Nat>, r, r2: View) {
    Blocks(ne: ¬(r2.b = r.b)),
    Places(same: r2.b = r.b, rs: List<Obligation>, ok: Steps::apart(r2.steps, r.steps) = Some(rs), hold: Obligation::All(rs, ws)),
}

theorem View::same_block<S>(m: StepModelRel<S>, ws: List<Nat>, heap: List<S>, r, r2: View, x: S, same: r2.b = r.b,
    ap: Apart<S, S, S>(PathModel::denote(m.steps(), ws, r2.steps), PathModel::denote(m.steps(), ws, r.steps))): r2.read(m, ws, r.write(m, ws, heap, x)) = r2.read(m, ws, heap)
{
    let f = λ (o: S) => PathModel::denote(m.steps(), ws, r.steps).set(o, x);
    let at: (heap.update(r.b, f).nth(r2.b) = heap.nth(r2.b).map(f)) =
        j(same, λ c _ => heap.update(c, f).nth(r2.b) = heap.nth(r2.b).map(f), heap.nth_update_map(r2.b, f));
    trans(cong_fn(λ (o: Option<S>) => o.and_then(λ y => PathModel::denote(m.steps(), ws, r2.steps).get(y)), at),
        (match heap.nth(r2.b) as λ o => o.map(f).and_then(λ y => PathModel::denote(m.steps(), ws, r2.steps).get(y)) = o.and_then(λ y => PathModel::denote(m.steps(), ws, r2.steps).get(y)) {
            Some(y) => ap.left_after_right(y, x),
            None => refl,
        }))
}

// The step lemma: a store through `r` keeps every view apart from it.
theorem View::write_keeps<S>(m: StepModelRel<S>, ml: StepModelLawsRel<S>(m), ws: List<Nat>, heap: List<S>, r, r2: View, x: S, apart: ViewsApart(ws, r, r2)):
    r2.read(m, ws, r.write(m, ws, heap, x)) = r2.read(m, ws, heap)
{
    match apart {
        Blocks(ne) => cong_fn(λ (o: Option<S>) => o.and_then(λ y => PathModel::denote(m.steps(), ws, r2.steps).get(y)),
            heap.nth_update_other(r.b, λ o => PathModel::denote(m.steps(), ws, r.steps).set(o, x), r2.b, ne)),
        Places(same, rs, ok, hold) => View::same_block(m, ws, heap, r, r2, x, same, Steps::apart_sound_rel(m, ml, ws, r2.steps, r.steps, rs, ok, hold)),
    }
}

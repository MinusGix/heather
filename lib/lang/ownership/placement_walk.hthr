// A place's code, against level 2's read of it (docs/language/
// ownership-design.md §25.10; issues/ownership-end-to-end-slice.md): what
// `PEnv::locate` and `PEnv::walk` (placement.hthr) leave, where
// `Sel::locate` (placement_seam.hthr) reaches, and what a load there reads.
//
// - **Words in bytes**: a word of `s` bytes stored as the encoding lays it
//   (`low_bytes`) reads back as itself (`round_bytes`, definitional at
//   each size from `ofNat`); a load from a block the injection lays out, no
//   reference in it and every byte defined, reads its bytes there
//   (`load_injected`).
// - **The scaled index** (`shl_toNat`): shifted left without overflow, a
//   word's number is multiplied by the power.
// - **The walk** (`walk_sound`): each step's code ends with a reference to
//   `inj` of the block at the offset `Sel::locate` reaches through the
//   selections level 2 reads, the length word of a sequence beside it, and
//   leaves every id below where it started as it was.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import pair;
import bitvec;
import bitvec_nat;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import level2;
import run;
import placement;
import placement_seam;
import placement_inject;
import placement_stages;
import bytes_memory;
import bytes_level;
import function_ir;
import function_ir_eval;
import x86_64;
import x86_64_store;
import x86_64_memory_contract;
import x86_64_call_contract;

// ---------------------------------------------------------------------------
// Words in bytes

theorem round_1(k: Nat, lt: k < Nat::pow(2, 8)): word_of_bytes(low_bytes(1, BitVec::ofNat(k, n := 64))) = BitVec::ofNat(k, n := 64) {
    let a: (word_of_bytes(low_bytes(1, BitVec::ofNat(k, n := 64))) = (BitVec::ofNat(k, n := 8)).zero_extend(56)) = refl;
    trans(a, trans(sym(BitVec::ofNat_toNat_zero_extend(8, 56, BitVec::ofNat(k, n := 8))), cong_fn(λ (x: Nat) => BitVec::ofNat(x, n := 64), BitVec::toNat_ofNat(8, k, lt))))
}

theorem round_2(k: Nat, lt: k < Nat::pow(2, 16)): word_of_bytes(low_bytes(2, BitVec::ofNat(k, n := 64))) = BitVec::ofNat(k, n := 64) {
    let a: (word_of_bytes(low_bytes(2, BitVec::ofNat(k, n := 64))) = (BitVec::ofNat(k, n := 16)).zero_extend(48)) = refl;
    trans(a, trans(sym(BitVec::ofNat_toNat_zero_extend(16, 48, BitVec::ofNat(k, n := 16))), cong_fn(λ (x: Nat) => BitVec::ofNat(x, n := 64), BitVec::toNat_ofNat(16, k, lt))))
}

theorem round_4(k: Nat, lt: k < Nat::pow(2, 32)): word_of_bytes(low_bytes(4, BitVec::ofNat(k, n := 64))) = BitVec::ofNat(k, n := 64) {
    let a: (word_of_bytes(low_bytes(4, BitVec::ofNat(k, n := 64))) = (BitVec::ofNat(k, n := 32)).zero_extend(32)) = refl;
    trans(a, trans(sym(BitVec::ofNat_toNat_zero_extend(32, 32, BitVec::ofNat(k, n := 32))), cong_fn(λ (x: Nat) => BitVec::ofNat(x, n := 64), BitVec::toNat_ofNat(32, k, lt))))
}

theorem round_8(x: BitVec(64)): word_of_bytes(low_bytes(8, x)) = x { immediate_bytes_roundtrip(x) }

// A word of a width with a size, below its bound, stored as the encoding
// lays it, reads back as itself.
theorem round_bytes(b, s, k: Nat, sz: (WBits(b)).size() = Some(s), lt: k < Nat::pow(2, b)): word_of_bytes(low_bytes(s, BitVec::ofNat(k, n := 64))) = BitVec::ofNat(k, n := 64) {
    let goal = λ (z: Nat) => word_of_bytes(low_bytes(z, BitVec::ofNat(k, n := 64))) = BitVec::ofNat(k, n := 64);
    match bool_arm(b.same(8), Some(1), size_from16(b), s, sz) {
        Inl(p) => j(Option::some_inj(1, s, p.right), λ z _ => goal(z), round_1(k, j(Nat::same_sound(b, 8, p.left), λ z _ => k < Nat::pow(2, z), lt))),
        Inr(p) => match bool_arm(b.same(16), Some(2), size_from32(b), s, p.right) {
            Inl(p2) => j(Option::some_inj(2, s, p2.right), λ z _ => goal(z), round_2(k, j(Nat::same_sound(b, 16, p2.left), λ z _ => k < Nat::pow(2, z), lt))),
            Inr(p2) => match bool_arm(b.same(32), Some(4), size_from64(b), s, p2.right) {
                Inl(p3) => j(Option::some_inj(4, s, p3.right), λ z _ => goal(z), round_4(k, j(Nat::same_sound(b, 32, p3.left), λ z _ => k < Nat::pow(2, z), lt))),
                Inr(p3) => match bool_arm(b.same(64), Some(8), None, s, p3.right) {
                    Inl(p4) => j(Option::some_inj(8, s, p4.right), λ z _ => goal(z), round_8(BitVec::ofNat(k, n := 64))),
                    Inr(p4) => absurd(p4.right),
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A load from a block with no reference in it and every byte defined

theorem cuts_other(e: Pointer, c, k, n: Nat, ne: ¬(e.block = c)): e.cuts(c, k, n) = False {
    j(sym(Nat::same_false_of(e.block, c, ne)), λ bb _ => (bb && ((e.at + 1).leb(k + n) && (k + 1).leb(e.at + 8))) && !(bb && (k.leb(e.at) && (e.at + 8).leb(k + n))) = False, refl)
}

theorem within_other(e: Pointer, c, k, n: Nat, ne: ¬(e.block = c)): e.within(c, k, n) = False {
    j(sym(Nat::same_false_of(e.block, c, ne)), λ bb _ => (bb && (k.leb(e.at) && (e.at + 8).leb(k + n))) = False, refl)
}

theorem cut_none(c, k, n: Nat, sh: List<Pointer>): ((e: Pointer) → Mem(e, sh) → ¬(e.block = c)) → cut(sh, c, k, n) = False {
    match sh {
        Nil => λ _ => refl,
        Cons(e, rest) => λ np => eq2(λ (x: Bool) (y: Bool) => x || y, cuts_other(e, c, k, n, np(e, Inl(refl))), cut_none(c, k, n, rest, λ e2 m => np(e2, Inr(m)))),
    }
}

theorem slots_none(c, k, n: Nat, sh: List<Pointer>): ((e: Pointer) → Mem(e, sh) → ¬(e.block = c)) → slots_within(sh, c, k, n) = Nil {
    match sh {
        Nil => λ _ => refl,
        Cons(e, rest) => λ np => trans(cong_fn(λ (bb: Bool) => match bb as λ _ => List<x86_64_memory_contract::Slot> { True => Cons(x86_64_memory_contract::Slot(e.at - k, e.target), slots_within(rest, c, k, n)), False => slots_within(rest, c, k, n) },
            within_other(e, c, k, n, np(e, Inl(refl)))), slots_none(c, k, n, rest, λ e2 m => np(e2, Inr(m)))),
    }
}

theorem flags_none(hb: x86_64_memory_contract::Heap, c: Nat, df: (j: Nat) → hb.undefined(c, j) = False, n: Nat): (k: Nat) → none_set(hb.flags_at(c, k, n)) = True {
    match n {
        Zero => λ k => refl,
        Succ(m) => λ k => eq2(λ (x: Bool) (y: Bool) => !x && y, df(k), flags_none(hb, c, df, m, k + 1)),
    }
}

theorem load_injected(hb: x86_64_memory_contract::Heap, c, off, n: Nat, np: Heap::NoPointerIn(hb, c), df: (j: Nat) → hb.undefined(c, j) = False,
    fits: off + n <= hb.bytes(c).len()): hb.load(x86_64_memory_contract::Loc(c, off), n) = Some(word_of_bytes(hb.bytes(c).window(off, off + n)))
{
    let loc = x86_64_memory_contract::Loc(c, off);
    let fit: (hb.fits(loc, n) = True) = eq2(λ (x: Bool) (y: Bool) => x && !y, eq_true_of_is_true((off + n).leb(hb.bytes(c).len()), Nat::leb_complete(off + n, hb.bytes(c).len(), fits)),
        cut_none(c, off, n, hb.shadow, np));
    let taken: (hb.take(loc, n) = Some(hb.piece(loc, n))) =
        cong_fn(λ (bb: Bool) => match bb as λ _ => Option<Piece> { False => None, True => Some(hb.piece(loc, n)) }, fit);
    let plain: ((hb.piece(loc, n)).plain_bytes() = Some(hb.bytes(c).window(off, off + n))) =
        trans(cong_fn(λ (sl: List<x86_64_memory_contract::Slot>) => (Piece(hb.bytes(c).window(off, off + n), sl, hb.flags_at(c, off, n))).plain_bytes(), slots_none(c, off, n, hb.shadow, np)),
            cong_fn(λ (bb: Bool) => match bb as λ _ => Option<List<BitVec(8)>> { True => Some(hb.bytes(c).window(off, off + n)), False => None }, flags_none(hb, c, df, n, off)));
    let read: (hb.read_bytes(loc, n) = Some(hb.bytes(c).window(off, off + n))) =
        trans(cong_fn(λ (o: Option<Piece>) => match o as λ _ => Option<List<BitVec(8)>> { None => None, Some(piece) => piece.plain_bytes() }, taken), plain);
    cong_fn(λ (o: Option<List<BitVec(8)>>) => match o as λ _ => Option<BitVec(64)> { None => None, Some(bytes) => Some(word_of_bytes(bytes)) }, read)
}

// ---------------------------------------------------------------------------
// An index atom: its word is level 2's index, modulo 2^64

theorem ix_index(tys: Nat → Type, d: Dyn(tys)): (Dyn::ix(tys, d)).toNat() = Dyn::index(tys, d) {
    match d {
        Dyn(c, v) => (match c as λ c2 => (v2: El(tys, c2)) → (Dyn::ix(tys, Dyn(c2, v2))).toNat() = Dyn::index(tys, Dyn(c2, v2)) {
            SWord(wd) => (match wd as λ w2 => (v2: El(tys, SWord(w2))) → (Dyn::ix(tys, Dyn(SWord(w2), v2))).toNat() = Dyn::index(tys, Dyn(SWord(w2), v2)) {
                WNat => λ v2 => refl,
                WBits(_) => λ v2 => refl,
            }),
            SNamed(_) => λ v2 => refl,
        })(v),
    }
}

fn word_of_value(o: Option<x86_64_call_contract::Value>) → BitVec(64) {
    match o { Some(v) => match v { Word(w) => w, Ref(_) => BitVec::ofNat(0) }, None => BitVec::ofNat(0) }
}

// A word id below where two locals agree reads the same word in both.
theorem agree_word(l, l2: Locals, next: Nat, ag: Locals::Agree(l, l2, next), t: Typed, k: t.kind = WordKind, lt: t.id < next): l2.word(t.id) = l.word(t.id) {
    let at = λ (lx: Locals) => cong_fn(λ (kd: ValueKind) => word_of_value(match kd as λ _ => Option<x86_64_call_contract::Value> {
        WordKind => Some(x86_64_call_contract::Word(lx.words(64, t.id))), RefKind => lx.refs(t.id).map(λ (loc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(loc)) }), k);
    trans(sym(at(l2)), trans(cong_fn(λ (o: Option<x86_64_call_contract::Value>) => word_of_value(o), ag(t, lt)), at(l)))
}

theorem agree_weaken(l, l2: Locals, a, b: Nat, ag: Locals::Agree(l, l2, b), le: a <= b): Locals::Agree(l, l2, a) { λ t lt => ag(t, { omega }) }

// Where `level` finds a local, it is below the environment's length.
theorem level_loc(e: PEnv, jj, l: Nat, h: e.level(Loc(jj)) = Some(l)): e.na + jj + 1 <= e.vars.len() {
    (match q: (e.na + jj + 1).leb(e.vars.len()) as λ bq => (match bq { True => Some(e.vars.len() - 1 - jj), False => None }) = Some(l) → e.na + jj + 1 <= e.vars.len() {
        True => λ _ => omega(q),
        False => λ no => absurd(no),
    })(h)
}

// The variable an atom names, where `PEnv::get` finds it, is the one level
// 2's words list holds at the atom's number.
theorem ixs_at(tys: Nat → Type, e: PEnv, env: REnv(tys), na: e.na = env.args.len(), len: e.vars.len() = (env.args ++ env.locs.rev()).len(), w: Nat, s: PSlot,
    eg: e.get(atom_var_of(e.na, w)) = Some(s)): (env.args ++ env.locs).nth(w) = Some(REnv::get(tys, env, atom_var_of(e.na, w)))
{
    (match q: (w + 1).leb(e.na) as λ bq => e.get(match bq { True => Arg(w), False => Loc(w - e.na) }) = Some(s) →
            (env.args ++ env.locs).nth(w) = Some(REnv::get(tys, env, match bq { True => Arg(w), False => Loc(w - e.na) })) {
        True => λ _ => {
            let lt: (w < env.args.len()) = omega(q, na);
            trans(List::nth_append_below(env.args, env.locs, w, lt), nth_unwrap(env.args, w, Cell::none(tys), lt))
        },
        False => λ eg2 => {
            let lv = Option::bind_some(eg2);
            let below = level_loc(e, w - e.na, lv.witness, lv.proof.left);
            let la = List::len_append(env.args, env.locs.rev());
            let lr = List::rev_len(env.locs);
            let lt: (w - e.na < env.locs.len()) = omega(below, na, len, la, lr, q);
            let at: (w - e.na + env.args.len() = w) = omega(q, na);
            trans(cong_fn(λ (k: Nat) => (env.args ++ env.locs).nth(k), sym(at)), trans(List::nth_append_r(env.args, env.locs, w - e.na), nth_unwrap(env.locs, w - e.na, Cell::none(tys), lt)))
        },
    })(eg)
}

// What an atom's code leaves.
fn AtomRan(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, m: Mach(tys), a: Atom, nx: Nat, w1: Word1, cw: Config) → Type {
    Exists<Config>(λ cw2 => (run_instrs(blocks, w1.instrs, cw) = Some(cw2)) ∧ ((cw2.memory = cw.memory) ∧ ((cw2.io = cw.io) ∧ (Locals::Agree(cw.locals, cw2.locals, nx) ∧
        ((nx <= w1.next) ∧ ((w1.id < w1.next) ∧ ((cw2.locals.word(w1.id)).toNat() = ((a.ix(Mach::ixs(tys, strs, m))).toNat()).mod(Nat::pow(2, 64)))))))))
}

theorem atom_lit(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, m: Mach(tys), n, nx: Nat, cw: Config):
    AtomRan(tys, strs, blocks, m, Lit(n), nx, Word1([Compute(Const(64, nx, n))], nx, nx + 1), cw)
{
    let value = λ (w: Nat) => BitVec::ofNat(n, n := w);
    let l2 = Locals(Valuation::set(cw.locals.words, nx, value), cw.locals.refs);
    Exists(Config(l2, cw.memory, cw.io), ⟨refl, ⟨refl, ⟨refl, ⟨Locals::agree_set(cw.locals, nx, value, nx, { omega }), ⟨{ omega }, ⟨{ omega },
        trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), Valuation::set_here(cw.locals.words, nx, value, 64)), BitVec::toNat_ofNat_mod(64, n))⟩⟩⟩⟩⟩⟩)
}

theorem atom_sound(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c0: Config, next0: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c0, next0), cw: Config, ag: Locals::Agree(c0.locals, cw.locals, next0), a: Atom, nx: Nat, le: next0 <= nx,
    w1: Word1, h: e.atom(a, nx) = Some(w1)): AtomRan(tys, strs, blocks, m, a, nx, w1, cw)
{
    (match a as λ a2 => e.atom(a2, nx) = Some(w1) → AtomRan(tys, strs, blocks, m, a2, nx, w1, cw) {
        Lit(n) => λ h2 => j(Option::some_inj(Word1([Compute(Const(64, nx, n))], nx, nx + 1), w1, h2), λ w2 _ => AtomRan(tys, strs, blocks, m, Lit(n), nx, w2, cw),
            atom_lit(tys, strs, blocks, m, n, nx, cw)),
        Var(w) => λ h2 => match Option::bind_some(h2) as λ _ => AtomRan(tys, strs, blocks, m, Var(w), nx, w1, cw) { Exists(s, p) =>
            match Option::bind_some(p.right) as λ _ => AtomRan(tys, strs, blocks, m, Var(w), nx, w1, cw) { Exists(t, p2) => {
                let g = Bool::guard_some(p2.right);
                let x = atom_var_of(e.na, w);
                let sl = slot_of(tys, strs, inj, blocks, act, e, m, c0, next0, rel, x, s, p.left);
                let cell = REnv::get(tys, m.env, x);
                let wi = one_word_is(s.ids, t, p2.left);
                let tlt: (t.id < next0) = sl.right(t, j(sym(wi.left), λ ids _ => Mem(t, ids), Inl(refl)));
                let pd = word_cell(tys, strs, inj, m.heap, s, cell, c0.locals, sl.left, t, p2.left);
                let d = pd.witness;
                let wd: (c0.locals.word(t.id) = BitVec::ofNat(Dyn::index(tys, d))) = match word_slot(tys, strs, inj, m.heap, s, cell, c0.locals, sl.left, t, p2.left) {
                    Inl(none) => absurd(trans(sym(cong_fn(λ (v: level2::Value(tys)) => Value::get(tys, strs, m.heap, v, Nil), pd.proof)), none)),
                    Inr(dd) => trans(dd.proof.right.right, cong_fn(λ (z: Dyn(tys)) => BitVec::ofNat(Dyn::index(tys, z), n := 64),
                        Option::some_inj(dd.witness, d, cong_fn(λ (v: level2::Value(tys)) => Value::get(tys, strs, m.heap, v, Nil), trans(sym(dd.proof.left), pd.proof))))),
                };
                let cs = m.env.args ++ m.env.locs.rev();
                let at = ixs_at(tys, e, m.env, rel.right.left, holds_len(tys, strs, inj, m.heap, c0.locals, e.vars, cs, rel.right.right.left), w, s, p.left);
                let f = λ (cl: Cell(tys)) => Dyn::ix(tys, Value::get(tys, strs, m.heap, cl.v, Nil).unwrap_or(Dyn::none(tys)));
                let ixe: (Atom::ix(Var(w), Mach::ixs(tys, strs, m)) = Dyn::ix(tys, d)) =
                    trans(cong_fn(λ (o: Option<Ix>) => o.unwrap_or(INat(0)), List::nth_map_some(m.env.args ++ m.env.locs, f, w, cell, at)),
                        cong_fn(λ (v: level2::Value(tys)) => Dyn::ix(tys, Value::get(tys, strs, m.heap, v, Nil).unwrap_or(Dyn::none(tys))), pd.proof));
                let word: ((cw.locals.word(t.id)).toNat() = ((Atom::ix(Var(w), Mach::ixs(tys, strs, m))).toNat()).mod(Nat::pow(2, 64))) =
                    trans(cong_fn(λ (z: BitVec(64)) => z.toNat(), trans(agree_word(c0.locals, cw.locals, next0, ag, t, wi.right, tlt), wd)),
                        trans(BitVec::toNat_ofNat_mod(64, Dyn::index(tys, d)), cong_fn(λ (k: Nat) => k.mod(Nat::pow(2, 64)), sym(trans(cong_fn(λ (i: Ix) => i.toNat(), ixe), ix_index(tys, d))))));
                j(Option::some_inj(Word1(Nil, t.id, nx), w1, g.right), λ w2 _ => AtomRan(tys, strs, blocks, m, Var(w), nx, w2, cw),
                    Exists(cw, ⟨refl, ⟨refl, ⟨refl, ⟨Locals::agree_refl(cw.locals, nx), ⟨{ omega }, ⟨{ omega }, word⟩⟩⟩⟩⟩⟩))
            } } },
    })(h)
}

// ---------------------------------------------------------------------------
// Leaves run in parts, locals agreeing

theorem run_app(blocks: Blocks, xs: List<Instr>): (ys: List<Instr>) → (c: Config) →
    run_instrs(blocks, xs ++ ys, c) = run_instrs(blocks, xs, c).and_then(λ (m: Config) => run_instrs(blocks, ys, m)) {
    match xs {
        Nil => λ ys c => refl,
        Cons(x, rest) => λ ys c => (match x.step(blocks, c) as λ o => o.and_then(λ (m: Config) => run_instrs(blocks, rest ++ ys, m)) =
                o.and_then(λ (m: Config) => run_instrs(blocks, rest, m)).and_then(λ (m: Config) => run_instrs(blocks, ys, m)) {
            None => refl,
            Some(m) => run_app(blocks, rest, ys, m),
        }),
    }
}

theorem run_app_some(blocks: Blocks, xs, ys: List<Instr>, c, c1: Config, h: run_instrs(blocks, xs, c) = Some(c1)): run_instrs(blocks, xs ++ ys, c) = run_instrs(blocks, ys, c1) {
    trans(run_app(blocks, xs, ys, c), cong_fn(λ (o: Option<Config>) => o.and_then(λ (m: Config) => run_instrs(blocks, ys, m)), h))
}

fn ref_of(o: Option<x86_64_call_contract::Value>) → Option<x86_64_memory_contract::Loc> {
    match o { Some(v) => match v { Word(_) => None, Ref(loc) => Some(loc) }, None => None }
}

theorem ref_of_map(o: Option<x86_64_memory_contract::Loc>): ref_of(o.map(λ (loc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(loc))) = o {
    match o { Some(_) => refl, None => refl }
}

// A reference id below where two locals agree holds the same in both.
theorem agree_ref(l, l2: Locals, next: Nat, ag: Locals::Agree(l, l2, next), id: Nat, lt: id < next): l2.refs(id) = l.refs(id) {
    trans(sym(ref_of_map(l2.refs(id))), trans(cong_fn(λ (o: Option<x86_64_call_contract::Value>) => ref_of(o), ag(ref_id(id), lt)), ref_of_map(l.refs(id))))
}

// ---------------------------------------------------------------------------
// The scaled index

theorem shl1_toNat(x: BitVec(64), small: 2 * x.toNat() < Nat::pow(2, 64)): (x.shift_left_one()).toNat() = 2 * x.toNat() {
    let pw: (Nat::pow(2, 64) = Nat::pow(2, 63) * 2) = refl;
    let i = BitVec::init_toNat(63, x, omega(small, pw));
    let a: ((x.shift_left_one()).toNat() = 0 + (x.init().toNat()).twice()) = refl;
    let t = Nat::twice_add_self(x.init().toNat());
    omega(a, t, i)
}

// Element sizes are 1, 2, 4 and 8 bytes.
theorem size_cases(c: Shape, s: Nat, h: c.word_size() = Some(s)): (s = 1) ∨ ((s = 2) ∨ ((s = 4) ∨ (s = 8))) {
    (match c as λ c2 => c2.word_size() = Some(s) → (s = 1) ∨ ((s = 2) ∨ ((s = 4) ∨ (s = 8))) {
        SNamed(_) => λ no => absurd(no),
        SWord(w) => (match w as λ w2 => (SWord(w2)).word_size() = Some(s) → (s = 1) ∨ ((s = 2) ∨ ((s = 4) ∨ (s = 8))) {
            WNat => λ no => absurd(no),
            WBits(b) => λ e => match bool_arm(b.same(8), Some(1), size_from16(b), s, e) {
                Inl(p) => Inl(sym(Option::some_inj(1, s, p.right))),
                Inr(p) => match bool_arm(b.same(16), Some(2), size_from32(b), s, p.right) {
                    Inl(p2) => Inr(Inl(sym(Option::some_inj(2, s, p2.right)))),
                    Inr(p2) => match bool_arm(b.same(32), Some(4), size_from64(b), s, p2.right) {
                        Inl(p3) => Inr(Inr(Inl(sym(Option::some_inj(4, s, p3.right))))),
                        Inr(p3) => match bool_arm(b.same(64), Some(8), None, s, p3.right) {
                            Inl(p4) => Inr(Inr(Inr(sym(Option::some_inj(8, s, p4.right))))),
                            Inr(p4) => absurd(p4.right),
                        },
                    },
                },
            },
        }),
    })(h)
}

// What the scaling adds after the index's code.
fn ScaledAt(blocks: Blocks, i, sc: Word1, size: Nat, cwa: Config) → Type {
    Exists<List<Instr>>(λ extra => (sc.instrs = i.instrs ++ extra) ∧ Exists<Config>(λ cws => (run_instrs(blocks, extra, cwa) = Some(cws)) ∧
        ((cws.memory = cwa.memory) ∧ ((cws.io = cwa.io) ∧ (Locals::Agree(cwa.locals, cws.locals, i.next) ∧ ((i.next <= sc.next) ∧
            ((sc.id < sc.next) ∧ ((cws.locals.word(sc.id)).toNat() = (cwa.locals.word(i.id)).toNat() * size))))))))
}

fn ScaledRan(blocks: Blocks, i: Word1, size: Nat, cwa: Config) → Type { ScaledAt(blocks, i, scaled(i, size), size, cwa) }

fn shl_config(cwa: Config, out, src, k: Nat) → Config {
    Config(Locals(Valuation::set(cwa.locals.words, out, λ (w: Nat) => (cwa.locals.words(w, src)).shift_left(k)), cwa.locals.refs), cwa.memory, cwa.io)
}

theorem shl_word(cwa: Config, out, src, k: Nat): ((shl_config(cwa, out, src, k)).locals.word(out)) = (cwa.locals.word(src)).shift_left(k) {
    Valuation::set_here(cwa.locals.words, out, λ (w: Nat) => (cwa.locals.words(w, src)).shift_left(k), 64)
}

theorem scaled_shl(blocks: Blocks, i: Word1, size, k: Nat, cwa: Config, ei: scaled(i, size) = Word1(i.instrs ++ Cons(Compute(ShiftLeft(64, i.next, i.id, k)), Nil), i.next, i.next + 1),
    tn: ((shl_config(cwa, i.next, i.id, k)).locals.word(i.next)).toNat() = (cwa.locals.word(i.id)).toNat() * size): ScaledRan(blocks, i, size, cwa)
{
    j(sym(ei), λ sc _ => ScaledAt(blocks, i, sc, size, cwa),
        Exists(Cons(Compute(ShiftLeft(64, i.next, i.id, k)), Nil), ⟨refl, Exists(shl_config(cwa, i.next, i.id, k), ⟨refl, ⟨refl, ⟨refl,
            ⟨Locals::agree_set(cwa.locals, i.next, λ (w: Nat) => (cwa.locals.words(w, i.id)).shift_left(k), i.next, { omega }), ⟨{ omega }, ⟨{ omega }, tn⟩⟩⟩⟩⟩⟩)⟩))
}

theorem scaled_ran(blocks: Blocks, i: Word1, size: Nat, cwa: Config, cs: (size = 1) ∨ ((size = 2) ∨ ((size = 4) ∨ (size = 8))), lt: i.id < i.next,
    small: (cwa.locals.word(i.id)).toNat() * size < Nat::pow(2, 64)): ScaledRan(blocks, i, size, cwa)
{
    let x = cwa.locals.word(i.id);
    match cs {
        Inl(e1) => j(sym(e1), λ z _ => ScaledRan(blocks, i, z, cwa), Exists(Nil, ⟨sym(List::append_nil(i.instrs)), Exists(cwa, ⟨refl, ⟨refl, ⟨refl, ⟨Locals::agree_refl(cwa.locals, i.next),
            ⟨(i.next).le_refl(), ⟨lt, {
                let t = (cwa.locals.word(i.id)).toNat();
                let one: (t = t * 1) = omega();
                one
            }⟩⟩⟩⟩⟩⟩)⟩)),
        Inr(c2) => match c2 {
            Inl(e2) => j(sym(e2), λ z _ => ScaledRan(blocks, i, z, cwa), scaled_shl(blocks, i, 2, 1, cwa, refl, {
                let sm = j(e2, λ z _ => x.toNat() * z < Nat::pow(2, 64), small);
                let s1 = shl1_toNat(x, omega(sm));
                let fin: (2 * x.toNat() = x.toNat() * 2) = omega();
                trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), shl_word(cwa, i.next, i.id, 1)), trans(s1, fin))
            })),
            Inr(c4) => match c4 {
                Inl(e4) => j(sym(e4), λ z _ => ScaledRan(blocks, i, z, cwa), scaled_shl(blocks, i, 4, 2, cwa, refl, {
                    let sm = j(e4, λ z _ => x.toNat() * z < Nat::pow(2, 64), small);
                    let y1 = x.shift_left_one();
                    let s1: (y1.toNat() = 2 * x.toNat()) = shl1_toNat(x, omega(sm));
                    let s2: ((y1.shift_left_one()).toNat() = 2 * y1.toNat()) = shl1_toNat(y1, omega(sm, s1));
                    let fin: (2 * y1.toNat() = x.toNat() * 4) = omega(s1);
                    trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), shl_word(cwa, i.next, i.id, 2)), trans(s2, fin))
                })),
                Inr(e8) => j(sym(e8), λ z _ => ScaledRan(blocks, i, z, cwa), scaled_shl(blocks, i, 8, 3, cwa, refl, {
                    let sm = j(e8, λ z _ => x.toNat() * z < Nat::pow(2, 64), small);
                    let y1 = x.shift_left_one();
                    let y2 = y1.shift_left_one();
                    let s1: (y1.toNat() = 2 * x.toNat()) = shl1_toNat(x, omega(sm));
                    let s2: (y2.toNat() = 2 * y1.toNat()) = shl1_toNat(y1, omega(sm, s1));
                    let s3: ((y2.shift_left_one()).toNat() = 2 * y2.toNat()) = shl1_toNat(y2, omega(sm, s1, s2));
                    let fin: (2 * y2.toNat() = x.toNat() * 8) = omega(s1, s2);
                    trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), shl_word(cwa, i.next, i.id, 3)), trans(s3, fin))
                })),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The walk's invariant

fn LenBelow(len: Option<Nat>, n: Nat) → Type { match len { Some(l) => l < n, None => True } }

fn LenAt(tys: Nat → Type, strs: Strs(tys), len: Option<Nat>, l: Locals, x: Dyn(tys)) → Type {
    match len { Some(id) => l.word(id) = BitVec::ofNat(Dyn::len(tys, strs, x)), None => True }
}

// The walk so far, from `c0`: its code ran to `cw`, writing only ids at or
// past `next0`; its reference is to `inj(b)` where `Sel::locate` reaches
// through the selections `ss` in the block's value `d`, of the code the
// walk reached, its length word beside it for a sequence.
record WalkAt(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, b: Nat, d: Dyn(tys), ss: List<Sel>, at: Walk, c0: Config, next0: Nat, cw: Config) {
    ran: run_instrs(blocks, at.instrs, c0) = Some(cw),
    mem: cw.memory = c0.memory,
    io: cw.io = c0.io,
    kept: Locals::Agree(c0.locals, cw.locals, next0),
    ge: next0 <= at.next,
    place_lt: at.place < at.next,
    len_lt: LenBelow(at.len, at.next),
    off: Nat,
    x: Dyn(tys),
    located: Sel::locate(tys, strs, d, ss, 0) = Some(Pair(off, x)),
    code: x.code = at.code,
    refers: cw.locals.refs(at.place) = Some(x86_64_memory_contract::Loc(inj(b), off)),
    len: LenAt(tys, strs, at.len, cw.locals, x),
}

theorem below_of_mul(n, s, p: Nat, cs: (s = 1) ∨ ((s = 2) ∨ ((s = 4) ∨ (s = 8))), h: n * s < p): n < p {
    match cs {
        Inl(e1) => { let h1 = j(e1, λ z _ => n * z < p, h); omega(h1) },
        Inr(c2) => match c2 {
            Inl(e2) => { let h1 = j(e2, λ z _ => n * z < p, h); omega(h1) },
            Inr(c4) => match c4 {
                Inl(e4) => { let h1 = j(e4, λ z _ => n * z < p, h); omega(h1) },
                Inr(e8) => { let h1 = j(e8, λ z _ => n * z < p, h); omega(h1) },
            },
        },
    }
}

// One selection more, at the layout the walk reached: where `locate` goes.
theorem locate_one(tys: Nat → Type, strs: Strs(tys), d, x: Dyn(tys), ss: List<Sel>, off: Nat, at: Sel::locate(tys, strs, d, ss, 0) = Some(Pair(off, x)), s: Sel, k: Nat,
    step: Sel::step_off(tys, strs, x, s) = Some(k)): Sel::locate(tys, strs, d, ss ++ [s], 0) = Some(Pair(off + k, Dyn::at(tys, strs, s, x)))
{
    trans(locate_append(tys, strs, ss, [s], d, 0), trans(cong_fn(λ (o: Option<Pair<Nat, Dyn(tys)>>) => o.and_then(λ (p: Pair<Nat, Dyn(tys)>) => Sel::locate(tys, strs, p.snd, [s], p.fst)), at),
        trans(locate_cons(tys, strs, x, s, Nil, off), cong_fn(λ (o: Option<Nat>) => o.and_then(λ (k2: Nat) => Sel::locate(tys, strs, Dyn::at(tys, strs, s, x), Nil, off + k2)), step))))
}

// Located in a value encoded in fewer than 2^64 bytes, an offset is below
// 2^64.
theorem located_small(tys: Nat → Type, strs: Strs(tys), laid: Strs::Laid(tys, strs), d: Dyn(tys), bs: List<BitVec(8)>, enc: Dyn::encode(tys, strs, d) = Some(bs),
    short: bs.len() < Nat::pow(2, 64), ss: List<Sel>, fit: Sel::fit(tys, strs, ss, d) = True, q: Pair<Nat, Dyn(tys)>, at: Sel::locate(tys, strs, d, ss, 0) = Some(q)): q.fst < Nat::pow(2, 64)
{
    let lc = locate_image(tys, strs, laid, ss, d, bs, enc, short, fit, 0, q, at);
    let e0 = lc.proof.left;
    let fr = lc.proof.right.proof.right.left;
    omega(e0, fr, short)
}

// The offset node's run, from a reference known at `place`.
theorem offset_ran(blocks: Blocks, c: Config, out, place, amount: Nat, loc: x86_64_memory_contract::Loc, at: c.locals.refs(place) = Some(loc)):
    run_instrs(blocks, [bytes_level::Offset(out, place, amount)], c) =
        Some(Config(c.locals.set_ref(out, x86_64_memory_contract::Loc(loc.block, loc.offset + (c.locals.word(amount)).toNat())), c.memory, c.io))
{
    cong_fn(λ (o: Option<x86_64_memory_contract::Loc>) => o.and_then(λ (lc: x86_64_memory_contract::Loc) =>
        Some(Config(c.locals.set_ref(out, x86_64_memory_contract::Loc(lc.block, lc.offset + (c.locals.word(amount)).toNat())), c.memory, c.io))).and_then(λ (after: Config) => run_instrs(blocks, Nil, after)), at)
}

theorem set_ref_here(l: Locals, id: Nat, loc: x86_64_memory_contract::Loc): (l.set_ref(id, loc)).refs(id) = Some(loc) {
    cong_fn(λ (bb: Bool) => match bb as λ _ => Option<x86_64_memory_contract::Loc> { True => Some(loc), False => l.refs(id) }, Nat::same_self(id))
}

// ---------------------------------------------------------------------------
// An element

theorem elem_walk_goal(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c0: Config, next0: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c0, next0), laid: Strs::Laid(tys, strs), b: Nat, d: Dyn(tys), bs: List<BitVec(8)>, enc: Dyn::encode(tys, strs, d) = Some(bs),
    short: bs.len() < Nat::pow(2, 64), ss: List<Sel>, at: Walk, cw: Config, wa: WalkAt(tys, strs, inj, blocks, b, d, ss, at, c0, next0, cw), a: Atom,
    el: Shape, size: Nat, wc: Option<Shape>, lay: Shape::layout(tys, strs, at.code) = LSeq(el, size, wc), i: Word1, ea: e.atom(a, at.next) = Some(i),
    fit: Sel::fit(tys, strs, ss ++ [el_sel(a.ix(Mach::ixs(tys, strs, m)))], d) = True):
    Exists<Config>(λ cw2 => WalkAt(tys, strs, inj, blocks, b, d, ss ++ [el_sel(a.ix(Mach::ixs(tys, strs, m)))], elem_walk(at, el, size, i), c0, next0, cw2))
{
    let ix = a.ix(Mach::ixs(tys, strs, m));
    let x = wa.x;
    let off = wa.off;
    let layx: (Shape::layout(tys, strs, x.code) = LSeq(el, size, wc)) = trans(cong_fn(λ (c: Shape) => Shape::layout(tys, strs, c), wa.code), lay);
    let sl = (laid.left(x.code, el, size, wc, layx)).left;
    let cs = size_cases(el, size, sl.el_size);
    let loc2 = locate_one(tys, strs, d, x, ss, off, wa.located, el_sel(ix), ix.toNat() * size, cong_fn(λ (l: Layout) => Sel::step_at(l, el_sel(ix)), layx));
    let big = located_small(tys, strs, laid, d, bs, enc, short, ss ++ [el_sel(ix)], fit, Pair(off + ix.toNat() * size, Dyn::at(tys, strs, el_sel(ix), x)), loc2);
    let prod: (ix.toNat() * size < Nat::pow(2, 64)) = omega(big);
    let ar = atom_sound(tys, strs, inj, blocks, act, e, m, c0, next0, rel, cw, wa.kept, a, at.next, wa.ge, i, ea);
    let cwa = ar.witness;
    let af = ar.proof;
    let wix: ((cwa.locals.word(i.id)).toNat() = ix.toNat()) = trans(af.right.right.right.right.right.right, Nat::mod_of_lt(ix.toNat(), Nat::pow(2, 64), below_of_mul(ix.toNat(), size, Nat::pow(2, 64), cs, prod)));
    let sr = scaled_ran(blocks, i, size, cwa, cs, af.right.right.right.right.right.left, j(sym(wix), λ z _ => z * size < Nat::pow(2, 64), prod));
    let sc = scaled(i, size);
    let extra = sr.witness;
    let cws = sr.proof.right.witness;
    let sf = sr.proof.right.proof;
    let rr: (cws.locals.refs(at.place) = Some(x86_64_memory_contract::Loc(inj(b), off))) =
        trans(agree_ref(cwa.locals, cws.locals, i.next, sf.right.right.right.left, at.place, { let p = wa.place_lt; let q = af.right.right.right.right.left; omega(p, q) }),
            trans(agree_ref(cw.locals, cwa.locals, at.next, af.right.right.right.left, at.place, wa.place_lt), wa.refers));
    let cw2 = Config(cws.locals.set_ref(sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat())), cws.memory, cws.io);
    let r_off = offset_ran(blocks, cws, sc.next, at.place, sc.id, x86_64_memory_contract::Loc(inj(b), off), rr);
    let r_sc: (run_instrs(blocks, sc.instrs ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw) = Some(cw2)) =
        trans(cong_fn(λ (is: List<Instr>) => run_instrs(blocks, is ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw), sr.proof.left),
            trans(cong_fn(λ (is: List<Instr>) => run_instrs(blocks, is, cw), List::append_assoc(i.instrs, extra, [bytes_level::Offset(sc.next, at.place, sc.id)])),
                trans(run_app_some(blocks, i.instrs, extra ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw, cwa, af.left),
                    trans(run_app_some(blocks, extra, [bytes_level::Offset(sc.next, at.place, sc.id)], cwa, cws, sf.left), r_off))));
    let ran: (run_instrs(blocks, (elem_walk(at, el, size, i)).instrs, c0) = Some(cw2)) = trans(run_app_some(blocks, at.instrs, sc.instrs ++ [bytes_level::Offset(sc.next, at.place, sc.id)], c0, cw, wa.ran), r_sc);
    let lt1 = af.right.right.right.right.left;
    let lt2 = sf.right.right.right.right.left;
    let ge0 = wa.ge;
    let kept: Locals::Agree(c0.locals, cw2.locals, next0) =
        Locals::agree_trans(c0.locals, cws.locals, cw2.locals, next0,
            Locals::agree_trans(c0.locals, cwa.locals, cws.locals, next0,
                Locals::agree_trans(c0.locals, cw.locals, cwa.locals, next0, wa.kept, agree_weaken(cw.locals, cwa.locals, next0, at.next, af.right.right.right.left, ge0)),
                agree_weaken(cwa.locals, cws.locals, next0, i.next, sf.right.right.right.left, omega(ge0, lt1))),
            Locals::agree_set_ref(cws.locals, sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat()), next0, omega(ge0, lt1, lt2)));
    let wsc: ((cws.locals.word(sc.id)).toNat() = ix.toNat() * size) = trans(sf.right.right.right.right.right.right, cong_fn(λ (z: Nat) => z * size, wix));
    let refers: (cw2.locals.refs(sc.next) = Some(x86_64_memory_contract::Loc(inj(b), off + ix.toNat() * size))) =
        trans(set_ref_here(cws.locals, sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat())),
            cong_fn(λ (z: Nat) => Some(x86_64_memory_contract::Loc(inj(b), off + z)), wsc));
    Exists(cw2, WalkAt(ran, trans(sf.right.left, trans(af.right.left, wa.mem)), trans(sf.right.right.left, trans(af.right.right.left, wa.io)), kept,
        omega(ge0, lt1, lt2), omega(), trivial, off + ix.toNat() * size, Dyn::at(tys, strs, el_sel(ix), x), loc2, sl.elem_code(x.val, ix), refers, trivial))
}

// ---------------------------------------------------------------------------
// Selections fitting, the last one at what is located

theorem fit_app(tys: Nat → Type, strs: Strs(tys), xs: List<Sel>): (ys: List<Sel>) → (d: Dyn(tys)) →
    Sel::fit(tys, strs, xs ++ ys, d) = (Sel::fit(tys, strs, xs, d) && Sel::fit(tys, strs, ys, Sel::read_at(tys, strs, xs, d)))
{
    match xs {
        Nil => λ ys d => refl,
        Cons(a, rest) => λ ys d => {
            let ih = fit_app(tys, strs, rest, ys, Dyn::at(tys, strs, a, d));
            match Dyn::fits(tys, strs, a, d) { True => ih, False => refl }
        },
    }
}

theorem fit_last(tys: Nat → Type, strs: Strs(tys), ss: List<Sel>, s: Sel, d, x: Dyn(tys), off: Nat, at: Sel::locate(tys, strs, d, ss, 0) = Some(Pair(off, x)),
    fit: Sel::fit(tys, strs, ss ++ [s], d) = True): (Sel::fit(tys, strs, ss, d) = True) ∧ (Dyn::fits(tys, strs, s, x) = True)
{
    let r = Sel::read_at(tys, strs, ss, d);
    let parts = Bool::and_true_parts(Sel::fit(tys, strs, ss, d), Sel::fit(tys, strs, [s], r), trans(sym(fit_app(tys, strs, ss, [s], d)), fit));
    let one = Bool::and_true_parts(Dyn::fits(tys, strs, s, r), True, parts.right);
    let xr: (x = r) = locate_reads(tys, strs, ss, d, 0, Pair(off, x), at);
    ⟨parts.left, j(sym(xr), λ z _ => Dyn::fits(tys, strs, s, z) = True, one.left)⟩
}

// A located sequence's length is below 2^64.
theorem seq_len_small(tys: Nat → Type, strs: Strs(tys), laid: Strs::Laid(tys, strs), d: Dyn(tys), bs: List<BitVec(8)>, enc: Dyn::encode(tys, strs, d) = Some(bs),
    short: bs.len() < Nat::pow(2, 64), ss: List<Sel>, fit: Sel::fit(tys, strs, ss, d) = True, x: Dyn(tys), off: Nat, at: Sel::locate(tys, strs, d, ss, 0) = Some(Pair(off, x)),
    el: Shape, size: Nat, wc: Option<Shape>, layx: Shape::layout(tys, strs, x.code) = LSeq(el, size, wc), rng: (1 <= size) ∧ (size <= 8)): Dyn::len(tys, strs, x) < Nat::pow(2, 64)
{
    let lc = locate_image(tys, strs, laid, ss, d, bs, enc, short, fit, 0, Pair(off, x), at);
    let ys = lc.proof.right.witness;
    let im = lc.proof.right.proof.left;
    let fr = lc.proof.right.proof.right.left;
    let is: (Dyn::encode_elems(tys, strs, x, size, 0, Dyn::len(tys, strs, x)) = ys) =
        Option::some_inj(Dyn::encode_elems(tys, strs, x, size, 0, Dyn::len(tys, strs, x)), ys,
            trans(sym(encode_seq(tys, strs, x, el, size, wc, layx)), trans(sym(image_laid(tys, strs, x, LSeq(el, size, wc), layx, λ no => absurd(no))), im)));
    let lb = len_below(tys, strs, x, size, rng, ys, is);
    omega(lb, fr, short)
}

// ---------------------------------------------------------------------------
// A window

theorem win_walk_goal(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c0: Config, next0: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c0, next0), laid: Strs::Laid(tys, strs), b: Nat, d: Dyn(tys), bs: List<BitVec(8)>, enc: Dyn::encode(tys, strs, d) = Some(bs),
    short: bs.len() < Nat::pow(2, 64), ss: List<Sel>, at: Walk, cw: Config, wa: WalkAt(tys, strs, inj, blocks, b, d, ss, at, c0, next0, cw), lo, n: Atom,
    el: Shape, size: Nat, wc: Shape, lay: Shape::layout(tys, strs, at.code) = LSeq(el, size, Some(wc)), la, ka: Word1, el1: e.atom(lo, at.next) = Some(la), ek: e.atom(n, la.next) = Some(ka),
    fit: Sel::fit(tys, strs, ss ++ [win_sel(lo.ix(Mach::ixs(tys, strs, m)), n.ix(Mach::ixs(tys, strs, m)))], d) = True):
    Exists<Config>(λ cw2 => WalkAt(tys, strs, inj, blocks, b, d, ss ++ [win_sel(lo.ix(Mach::ixs(tys, strs, m)), n.ix(Mach::ixs(tys, strs, m)))], win_walk(at, size, wc, la, ka), c0, next0, cw2))
{
    let lix = lo.ix(Mach::ixs(tys, strs, m));
    let nix = n.ix(Mach::ixs(tys, strs, m));
    let x = wa.x;
    let off = wa.off;
    let layx: (Shape::layout(tys, strs, x.code) = LSeq(el, size, Some(wc))) = trans(cong_fn(λ (c: Shape) => Shape::layout(tys, strs, c), wa.code), lay);
    let both = laid.left(x.code, el, size, Some(wc), layx);
    let sl = both.left;
    let wl: WinLaid(tys, strs, x.code, el, size, wc) = both.right;
    let cs = size_cases(el, size, sl.el_size);
    let rng = Shape::size_range(el, size, sl.el_size);
    let fl = fit_last(tys, strs, ss, win_sel(lix, nix), d, x, off, wa.located, fit);
    let inside = wl.win_fits(x.val, lix, nix, fl.right);
    let lenx = seq_len_small(tys, strs, laid, d, bs, enc, short, ss, fl.left, x, off, wa.located, el, size, Some(wc), layx, rng);
    let loc2 = locate_one(tys, strs, d, x, ss, off, wa.located, win_sel(lix, nix), lix.toNat() * size, cong_fn(λ (l: Layout) => Sel::step_at(l, win_sel(lix, nix)), layx));
    let big = located_small(tys, strs, laid, d, bs, enc, short, ss ++ [win_sel(lix, nix)], fit, Pair(off + lix.toNat() * size, Dyn::at(tys, strs, win_sel(lix, nix), x)), loc2);
    let prod: (lix.toNat() * size < Nat::pow(2, 64)) = omega(big);
    // The two atoms, one after the other.
    let a1 = atom_sound(tys, strs, inj, blocks, act, e, m, c0, next0, rel, cw, wa.kept, lo, at.next, wa.ge, la, el1);
    let cwa1 = a1.witness;
    let f1 = a1.proof;
    let ge1 = wa.ge;
    let lt1 = f1.right.right.right.right.left;
    let kept1: Locals::Agree(c0.locals, cwa1.locals, next0) =
        Locals::agree_trans(c0.locals, cw.locals, cwa1.locals, next0, wa.kept, agree_weaken(cw.locals, cwa1.locals, next0, at.next, f1.right.right.right.left, ge1));
    let a2 = atom_sound(tys, strs, inj, blocks, act, e, m, c0, next0, rel, cwa1, kept1, n, la.next, omega(ge1, lt1), ka, ek);
    let cwa2 = a2.witness;
    let f2 = a2.proof;
    let lt2 = f2.right.right.right.right.left;
    let ii = Word1(la.instrs ++ ka.instrs, la.id, ka.next);
    let r_ii: (run_instrs(blocks, ii.instrs, cw) = Some(cwa2)) = trans(run_app_some(blocks, la.instrs, ka.instrs, cw, cwa1, f1.left), f2.left);
    let wl_kept: (cwa2.locals.word(la.id) = cwa1.locals.word(la.id)) = {
        let lid = f1.right.right.right.right.right.left;
        agree_word(cwa1.locals, cwa2.locals, la.next, f2.right.right.right.left, word_id(la.id), refl, lid)
    };
    let wlo: ((cwa2.locals.word(la.id)).toNat() = lix.toNat()) =
        trans(cong_fn(λ (z: BitVec(64)) => z.toNat(), wl_kept), trans(f1.right.right.right.right.right.right, Nat::mod_of_lt(lix.toNat(), Nat::pow(2, 64), below_of_mul(lix.toNat(), size, Nat::pow(2, 64), cs, prod))));
    let nlt: (nix.toNat() < Nat::pow(2, 64)) = omega(inside, lenx);
    let wn: ((cwa2.locals.word(ka.id)).toNat() = nix.toNat()) = trans(f2.right.right.right.right.right.right, Nat::mod_of_lt(nix.toNat(), Nat::pow(2, 64), nlt));
    let idlt = f1.right.right.right.right.right.left;
    let kidlt = f2.right.right.right.right.right.left;
    let sr = scaled_ran(blocks, ii, size, cwa2, cs, omega(idlt, lt2), j(sym(wlo), λ z _ => z * size < Nat::pow(2, 64), prod));
    let sc = scaled(ii, size);
    let extra = sr.witness;
    let cws = sr.proof.right.witness;
    let sf = sr.proof.right.proof;
    let lt3 = sf.right.right.right.right.left;
    let pl = wa.place_lt;
    let rr: (cws.locals.refs(at.place) = Some(x86_64_memory_contract::Loc(inj(b), off))) =
        trans(agree_ref(cwa2.locals, cws.locals, ka.next, sf.right.right.right.left, at.place, omega(pl, lt1, lt2)),
            trans(agree_ref(cwa1.locals, cwa2.locals, la.next, f2.right.right.right.left, at.place, omega(pl, lt1)),
                trans(agree_ref(cw.locals, cwa1.locals, at.next, f1.right.right.right.left, at.place, pl), wa.refers)));
    let cw2 = Config(cws.locals.set_ref(sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat())), cws.memory, cws.io);
    let r_off = offset_ran(blocks, cws, sc.next, at.place, sc.id, x86_64_memory_contract::Loc(inj(b), off), rr);
    let r_sc: (run_instrs(blocks, sc.instrs ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw) = Some(cw2)) =
        trans(cong_fn(λ (is: List<Instr>) => run_instrs(blocks, is ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw), sr.proof.left),
            trans(cong_fn(λ (is: List<Instr>) => run_instrs(blocks, is, cw), List::append_assoc(ii.instrs, extra, [bytes_level::Offset(sc.next, at.place, sc.id)])),
                trans(run_app_some(blocks, ii.instrs, extra ++ [bytes_level::Offset(sc.next, at.place, sc.id)], cw, cwa2, r_ii),
                    trans(run_app_some(blocks, extra, [bytes_level::Offset(sc.next, at.place, sc.id)], cwa2, cws, sf.left), r_off))));
    let ran: (run_instrs(blocks, (win_walk(at, size, wc, la, ka)).instrs, c0) = Some(cw2)) =
        trans(run_app_some(blocks, at.instrs, sc.instrs ++ [bytes_level::Offset(sc.next, at.place, sc.id)], c0, cw, wa.ran), r_sc);
    let kept: Locals::Agree(c0.locals, cw2.locals, next0) =
        Locals::agree_trans(c0.locals, cws.locals, cw2.locals, next0,
            Locals::agree_trans(c0.locals, cwa2.locals, cws.locals, next0,
                Locals::agree_trans(c0.locals, cwa1.locals, cwa2.locals, next0, kept1, agree_weaken(cwa1.locals, cwa2.locals, next0, la.next, f2.right.right.right.left, omega(ge1, lt1))),
                agree_weaken(cwa2.locals, cws.locals, next0, ka.next, sf.right.right.right.left, omega(ge1, lt1, lt2))),
            Locals::agree_set_ref(cws.locals, sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat()), next0, omega(ge1, lt1, lt2, lt3)));
    let wsc: ((cws.locals.word(sc.id)).toNat() = lix.toNat() * size) = trans(sf.right.right.right.right.right.right, cong_fn(λ (z: Nat) => z * size, wlo));
    let refers: (cw2.locals.refs(sc.next) = Some(x86_64_memory_contract::Loc(inj(b), off + lix.toNat() * size))) =
        trans(set_ref_here(cws.locals, sc.next, x86_64_memory_contract::Loc(inj(b), off + (cws.locals.word(sc.id)).toNat())),
            cong_fn(λ (z: Nat) => Some(x86_64_memory_contract::Loc(inj(b), off + z)), wsc));
    // The length word: the window's own, kept past the scaling and the offset.
    let wk: (cws.locals.word(ka.id) = cwa2.locals.word(ka.id)) = agree_word(cwa2.locals, cws.locals, ka.next, sf.right.right.right.left, word_id(ka.id), refl, kidlt);
    let len: (cw2.locals.word(ka.id) = BitVec::ofNat(Dyn::len(tys, strs, Dyn::at(tys, strs, win_sel(lix, nix), x)))) =
        trans(wk, trans(sym(BitVec::ofNat_toNat(64, cwa2.locals.word(ka.id))), cong_fn(λ (z: Nat) => BitVec::ofNat(z, n := 64),
            trans(wn, sym(wl.win_len(x.val, lix, nix, fl.right))))));
    Exists(cw2, WalkAt(ran, trans(sf.right.left, trans(f2.right.left, trans(f1.right.left, wa.mem))), trans(sf.right.right.left, trans(f2.right.right.left, trans(f1.right.right.left, wa.io))), kept,
        omega(ge1, lt1, lt2, lt3), omega(), omega(kidlt, lt3), off + lix.toNat() * size, Dyn::at(tys, strs, win_sel(lix, nix), x), loc2, wl.win_code(x.val, lix, nix), refers, len))
}

// ---------------------------------------------------------------------------
// A field

theorem field_walk_goal(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, laid: Strs::Laid(tys, strs), b: Nat, d: Dyn(tys), bs: List<BitVec(8)>,
    enc: Dyn::encode(tys, strs, d) = Some(bs), short: bs.len() < Nat::pow(2, 64), ss: List<Sel>, at: Walk, c0: Config, next0: Nat, cw: Config,
    wa: WalkAt(tys, strs, inj, blocks, b, d, ss, at, c0, next0, cw), i: Nat, fs: List<Shape>, lay: Shape::layout(tys, strs, at.code) = LRecord(fs), off2: Nat,
    eo: fields_offset(fs, i) = Some(off2), fc: Shape, ef: fs.nth(i) = Some(fc), fit: Sel::fit(tys, strs, ss ++ [OnField(i)], d) = True):
    Exists<Config>(λ cw2 => WalkAt(tys, strs, inj, blocks, b, d, ss ++ [OnField(i)], field_walk(at, off2, fc), c0, next0, cw2))
{
    let x = wa.x;
    let off = wa.off;
    let layx: (Shape::layout(tys, strs, x.code) = LRecord(fs)) = trans(cong_fn(λ (c: Shape) => Shape::layout(tys, strs, c), wa.code), lay);
    let rl = laid.right(x.code, fs, layx);
    let loc2 = locate_one(tys, strs, d, x, ss, off, wa.located, OnField(i), off2, trans(cong_fn(λ (l: Layout) => Sel::step_at(l, OnField(i)), layx), eo));
    let big = located_small(tys, strs, laid, d, bs, enc, short, ss ++ [OnField(i)], fit, Pair(off + off2, Dyn::at(tys, strs, OnField(i), x)), loc2);
    let value = λ (w: Nat) => BitVec::ofNat(off2, n := w);
    let cc = Config(Locals(Valuation::set(cw.locals.words, at.next, value), cw.locals.refs), cw.memory, cw.io);
    let wcc: ((cc.locals.word(at.next)).toNat() = off2) =
        trans(cong_fn(λ (z: BitVec(64)) => z.toNat(), Valuation::set_here(cw.locals.words, at.next, value, 64)), BitVec::toNat_ofNat(64, off2, omega(big)));
    let cw2 = Config(cc.locals.set_ref(at.next + 1, x86_64_memory_contract::Loc(inj(b), off + (cc.locals.word(at.next)).toNat())), cc.memory, cc.io);
    let r_off = offset_ran(blocks, cc, at.next + 1, at.place, at.next, x86_64_memory_contract::Loc(inj(b), off), wa.refers);
    let r_new: (run_instrs(blocks, [Compute(Const(64, at.next, off2)), bytes_level::Offset(at.next + 1, at.place, at.next)], cw) = Some(cw2)) = r_off;
    let ran: (run_instrs(blocks, (field_walk(at, off2, fc)).instrs, c0) = Some(cw2)) =
        trans(run_app_some(blocks, at.instrs, [Compute(Const(64, at.next, off2)), bytes_level::Offset(at.next + 1, at.place, at.next)], c0, cw, wa.ran), r_new);
    let ge0 = wa.ge;
    let kept: Locals::Agree(c0.locals, cw2.locals, next0) =
        Locals::agree_trans(c0.locals, cc.locals, cw2.locals, next0,
            Locals::agree_trans(c0.locals, cw.locals, cc.locals, next0, wa.kept, Locals::agree_set(cw.locals, at.next, value, next0, ge0)),
            Locals::agree_set_ref(cc.locals, at.next + 1, x86_64_memory_contract::Loc(inj(b), off + (cc.locals.word(at.next)).toNat()), next0, omega(ge0)));
    let refers: (cw2.locals.refs(at.next + 1) = Some(x86_64_memory_contract::Loc(inj(b), off + off2))) =
        trans(set_ref_here(cc.locals, at.next + 1, x86_64_memory_contract::Loc(inj(b), off + (cc.locals.word(at.next)).toNat())),
            cong_fn(λ (z: Nat) => Some(x86_64_memory_contract::Loc(inj(b), off + z)), wcc));
    Exists(cw2, WalkAt(ran, wa.mem, wa.io, kept, omega(ge0), omega(), trivial, off + off2, Dyn::at(tys, strs, OnField(i), x), loc2, rl.field_code(x.val, i, fc, ef), refers, trivial))
}

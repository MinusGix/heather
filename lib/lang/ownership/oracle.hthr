// `SafeAt` read at closed data (docs/language/ownership-design.md §24;
// issues/ownership-soundness-oracle.md): a `Bool` decider beside each clause
// of `verdict.hthr`'s `Type`-valued statement, so that the statement of
// `check_sound` can be evaluated at a closed program, argument list, heap
// and fuel, and a checked program that breaks it searched for
// (`oracle_search.hthr`).
//
// Nothing here is proved. A decider answers what its clause says only where
// the environment's two decidable parts say what they are asked: `eq`, the
// equality of two values (a `Dyn` of a closed environment has no decidable
// equality in general), and each sequence instance's accessor proposition
// being its `inside` bit (`Dyn::pre_b`; true of the list, `[A; n]` and
// `Bytes(n)` instances of `sequences.hthr`). A finding is therefore
// confirmed by hand, as a refusal probe or a `¬` theorem, before it is
// believed.
//
// - **The premises** (`Prog::owed_b`): `ReadAll` of the arguments, their
//   codes, and `Lendable`. `Lendable.apart` asks the semantic apartness of
//   two references (`Sel::Apart`, a record over every modification); its
//   decider here is the syntactic one (`Ref::apart_b`: other blocks, or a
//   common prefix and then two selections `Sel::apart` finds apart), which
//   implies it. So an argument list the decider calls lendable is lendable,
//   and the search can only under-try, never try an input the theorem does
//   not cover.
// - **What a verdict owes** (`Owes::holds_b`): `Owes::Holds` with each
//   residual decided (`Residual::holds_b`), the precondition a `Bool`.
// - **The conclusions** (`Prog::verdict_b`): the run not stuck; a measured
//   run done from its need; where done, `ReadAll` of the answer against the
//   meaning, `Value::Written`, `Heap::Frame`, `Heap::Kept`, `Value::Views`,
//   `Value::OwnedApart`, the results coded. The `Going` clause's histories are the program's
//   own (`Prog.reaches`), which a counterexample may choose, so it is not
//   decided. The first clause broken is answered (`Clause`).
import logic;
import pair;
import bool;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import level2;
import run;
import verdict;
import linux_world;

// ---------------------------------------------------------------------------
// Equalities at closed data

fn Sel::same_list(xs, ys: List<Sel>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, ar) => match ys { Nil => False, Cons(b, br) => a.same(b) && Sel::same_list(ar, br) } }
}

fn Ref::same(self r, q: Ref) → Bool { r.b.same(q.b) && Sel::same_list(r.sels, q.sels) }

// Two run values alike: two plain values equal by `eq`, or one reference.
fn Value::same(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, a, b: Value(tys)) → Bool {
    match a { Plain(x) => match b { Plain(y) => eq(x, y), Refer(_) => False }, Refer(r) => match b { Plain(_) => False, Refer(q) => r.same(q) } }
}

fn Option::same_by<A>(eqa: A → A → Bool, x, y: Option<A>) → Bool {
    match x { None => match y { None => True, Some(_) => False }, Some(u) => match y { None => False, Some(v) => eqa(u, v) } }
}

// ---------------------------------------------------------------------------
// Apartness of references, syntactically (it implies `Ref::Apart`)

// Past a common prefix, two selections the step decider finds apart.
fn Sel::apart_list(xs, ys: List<Sel>) → Bool {
    match xs {
        Nil => False,
        Cons(a, ar) => match ys { Nil => False, Cons(b, br) => match a.same(b) { True => Sel::apart_list(ar, br), False => a.apart(b) } },
    }
}

fn Ref::apart_b(self r, q: Ref) → Bool { !r.b.same(q.b) || Sel::apart_list(r.sels, q.sels) }

// ---------------------------------------------------------------------------
// The premises

fn Value::read_all_b(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, strs: Strs(tys), h: Heap(tys), fuel: Nat, vs: List<Value(tys)>, ds: List<Dyn(tys)>) → Bool {
    match vs {
        Nil => match ds { Nil => True, Cons(_, _) => False },
        Cons(v, vr) => match ds { Nil => False, Cons(d, dr) => Option::same_by(eq, Value::read(tys, v, strs, h, fuel), Some(d)) && Value::read_all_b(tys, eq, strs, h, fuel, vr, dr) },
    }
}

fn Ref::live_b(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), r: Ref) → Bool {
    match Heap::obj(tys, h, r.b) { Some(o) => match o.holes { Nil => Sel::fit(tys, strs, r.sels, o.val), Cons(_, _) => False }, None => False }
}

fn Value::ref_of(tys: Nat → Type, v: Value(tys)) → Option<Ref> { match v { Plain(_) => None, Refer(r) => Some(r) } }

// Each argument with its position and parameter.
fn Lendable::live_b(tys: Nat → Type, strs: Strs(tys), h: Heap(tys), vs: List<Value(tys)>) → Bool {
    vs.all_bit(λ v => match v { Plain(_) => True, Refer(r) => Ref::live_b(tys, strs, h, r) })
}

fn Lendable::plain_b(tys: Nat → Type, strs: Strs(tys), ps: List<Param>, vs: List<Value(tys)>) → Bool {
    match ps {
        Nil => True,
        Cons(p, pr) => match vs {
            Nil => True,
            Cons(v, vr) => (match p.mode { ByTake => !(Shape::plain(tys, strs, p.code) && Value::refers(tys, v)), ByRead => True, ByWrite => True }) && Lendable::plain_b(tys, strs, pr, vr),
        },
    }
}

// Argument `i` (at `r`, lent at `p`) against every other argument.
fn Lendable::apart_one(tys: Nat → Type, i: Nat, p: Param, r: Ref, vs: List<Value(tys)>, k: Nat) → Bool {
    match vs {
        Nil => True,
        Cons(v, vr) => (i.same(k) || match v { Plain(_) => True, Refer(q) => Ref::apart_b(r, q) }) && Lendable::apart_one(tys, i, p, r, vr, k + 1),
    }
}

// The same for `whole`: no other argument in the block.
fn Lendable::alone(tys: Nat → Type, i: Nat, r: Ref, vs: List<Value(tys)>, k: Nat) → Bool {
    match vs {
        Nil => True,
        Cons(v, vr) => (i.same(k) || match v { Plain(_) => True, Refer(q) => !q.b.same(r.b) }) && Lendable::alone(tys, i, r, vr, k + 1),
    }
}

fn Lendable::each(tys: Nat → Type, strs: Strs(tys), ps: List<Param>, all, vs: List<Value(tys)>, i: Nat) → Bool {
    match ps {
        Nil => True,
        Cons(p, pr) => match vs {
            Nil => True,
            Cons(v, vr) => (match v {
                Plain(_) => True,
                Refer(r) => (!p.mode.changes() || Lendable::apart_one(tys, i, p, r, all, 0)) &&
                    (match p.mode { ByTake => Shape::plain(tys, strs, p.code) || (Sel::same_list(r.sels, Nil) && Lendable::alone(tys, i, r, all, 0)), ByRead => True, ByWrite => True }),
            }) && Lendable::each(tys, strs, pr, all, vr, i + 1),
        },
    }
}

// `Lendable`, with `apart` read syntactically (which implies it).
fn Lendable::b(tys: Nat → Type, strs: Strs(tys), ps: List<Param>, h: Heap(tys), vs: List<Value(tys)>) → Bool {
    vs.len().same(ps.len()) && Lendable::live_b(tys, strs, h, vs) && Lendable::plain_b(tys, strs, ps, vs) && Lendable::each(tys, strs, ps, vs, vs, 0)
}

// ---------------------------------------------------------------------------
// What a verdict owes, decided

// What a sequence's accessor asks, as its `inside` bit (each instance's
// proposition is that bit: `List::ix_pre` and `ix_inside`, and the others').
fn Dyn::pre_b(tys: Nat → Type, strs: Strs(tys), sel: Sel, d: Dyn(tys)) → Bool {
    (match d.code as λ c => El(tys, c) → Bool {
        SWord(_) => λ _ => True,
        SNamed(k) => λ v => match strs(k).kind {
            Sequence(q) => match sel {
                OnSeq(a) => match a { SeqOne(i) => q.inside(v, i), SeqRun(lo, n) => match q.win { Some(w) => w.inside(v, lo, n), None => True } },
                OnField(_) => True, OnKey(_) => True, OnVariant(_) => True,
            },
            Opaque => True,
            Record(_) => True,
        },
    })(d.val)
}

record CtxB(tys: Nat → Type) { strs: Strs(tys), w: Callees(tys), me: Nat, pres: Nat → List<Dyn(tys)> → Bool, need: Need(tys), args: List<Dyn(tys)> }

fn Residual::holds_b(self r: Residual, tys: Nat → Type, cx: CtxB(tys), env: Env(tys)) → Bool {
    match r {
        RApart(lo1, n1, lo2, n2) => {
            let ns = Ix::nats(Env::ixs(tys, env));
            (lo1.val(ns) + n1.val(ns)).leb(lo2.val(ns)) || (lo2.val(ns) + n2.val(ns)).leb(lo1.val(ns))
        },
        RPre(g, args) => cx.pres(g, args.map(λ x => Env::get(tys, env, x))),
        RAccess(p) => match Steps::last(p.steps) {
            Some(a) => Dyn::pre_b(tys, cx.strs, a.sel(Env::ixs(tys, env)), Place(p.root, Steps::init(p.steps)).val(tys, cx.strs, env)),
            None => True,
        },
        RFits(p, v) => {
            let old = p.val(tys, cx.strs, env);
            let new = Env::get(tys, env, v);
            new.code.same(old.code) && (Dyn::len(tys, cx.strs, new)).same(Dyn::len(tys, cx.strs, old))
        },
        RLen(p, w) => match w { WNat => True, WBits(k) => (Dyn::len(tys, cx.strs, p.val(tys, cx.strs, env)) + 1).leb(Nat::pow(2, k)) },
        RMeasure(g, args) => (cx.need(g, args.map(λ x => Env::get(tys, env, x))) + 1).leb(cx.need(cx.me, cx.args)),
    }
}

fn Residual::all_b(rs: List<Residual>, tys: Nat → Type, cx: CtxB(tys), env: Env(tys)) → Bool { rs.all_bit(λ r => r.holds_b(tys, cx, env)) }

fn Owes::holds_b(self d: Owes, tys: Nat → Type, cx: CtxB(tys), b: Body, env: Env(tys), after: List<Dyn(tys)> → Bool) → Bool {
    match b {
        Ret(_) => True,
        Yield(os) => after(os.map(λ x => Env::get(tys, env, x))),
        Jump(_) => match d { OJump(here) => Residual::all_b(here, tys, cx, env), _ => False },
        Do(s, rest) => match d {
            ODo(here, dr) => Residual::all_b(here, tys, cx, env) && dr.holds_b(tys, cx, rest, s.eval(Env(tys), tys, cx.strs, cx.w, env, λ e => e), after),
            _ => False,
        },
        Join(t, yes, no, rest) => match d {
            OJoin(dy, dn, dr) => match yes.exits() || no.exits() {
                False => (match t.bit(tys, env) { True => dy.holds_b(tys, cx, yes, env, λ _ => True), False => dn.holds_b(tys, cx, no, env, λ _ => True) }) &&
                    dr.holds_b(tys, cx, rest, Env::push_all(tys, env, Body::joined(tys, t.bit(tys, env),
                        yes.mean(List<Dyn(tys)>, tys, cx.strs, cx.w, cx.me, env, λ _ => Nil, λ ds => ds), no.mean(List<Dyn(tys)>, tys, cx.strs, cx.w, cx.me, env, λ _ => Nil, λ ds => ds))), after),
                True => {
                    let next = λ (ds: List<Dyn(tys)>) => dr.holds_b(tys, cx, rest, Env::push_all(tys, env, ds), after);
                    match t.bit(tys, env) { True => dy.holds_b(tys, cx, yes, env, next), False => dn.holds_b(tys, cx, no, env, next) }
                },
            },
            _ => False,
        },
    }
}

fn Owes::due_b(self d: Owes, tys: Nat → Type, cx: CtxB(tys), f: Func) → Bool { d.holds_b(tys, cx, f.body, Env::start(tys, cx.args), λ _ => True) }

// ---------------------------------------------------------------------------
// The conclusions

fn Value::written_b(tys: Nat → Type, strs: Strs(tys), vs: List<Value(tys)>, ds: List<Dyn(tys)>, is: List<Nat>, slots: List<Value(tys)>, outs: List<Dyn(tys)>) → Bool {
    match is {
        Nil => True,
        Cons(i, rest) => match slots {
            Nil => False,
            Cons(a, arest) => match outs {
                Nil => False,
                Cons(o, orest) => {
                    let old = ds.nth(i).unwrap_or(Dyn::none(tys));
                    (match vs.nth(i).unwrap_or(Plain(Dyn::none(tys))) { Refer(r) => match a { Refer(q) => q.same(r), Plain(_) => False }, Plain(_) => !Value::refers(tys, a) }) &&
                    o.code.same(old.code) && (Dyn::len(tys, strs, o)).same(Dyn::len(tys, strs, old)) &&
                    Value::written_b(tys, strs, vs, ds, rest, arest, orest)
                },
            },
        },
    }
}

// `Heap::Frame` at each block below `n`.
fn Heap::frame_from(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, strs: Strs(tys), before, after: Heap(tys), rs: List<Ref>, b, n: Nat) → Bool {
    match n {
        Zero => True,
        Succ(k) => (match rs.all_bit(λ r => !r.b.same(b) || !Sel::same_list(r.sels, Nil)) {
            False => True,
            True => match Heap::obj(tys, before, b) {
                None => True,
                Some(ob) => match Heap::obj(tys, after, b) { None => False, Some(ob2) => eq(ob2.val, Sel::put_lent(tys, strs, rs, b, ob2.val, ob.val)) },
            },
        }) && Heap::frame_from(tys, eq, strs, before, after, rs, b + 1, k),
    }
}

fn Heap::frame_b(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, strs: Strs(tys), before, after: Heap(tys), rs: List<Ref>) → Bool { Heap::frame_from(tys, eq, strs, before, after, rs, 0, before.len()) }

fn Heap::stays_from(tys: Nat → Type, before, after: Heap(tys), b, n: Nat) → Bool {
    match n {
        Zero => True,
        Succ(k) => (match Heap::obj(tys, after, b) {
            None => True,
            Some(ob2) => match Heap::obj(tys, before, b) { None => False, Some(ob) => match ob.holes { Nil => match ob2.holes { Nil => True, Cons(_, _) => False }, Cons(_, _) => True } },
        }) && Heap::stays_from(tys, before, after, b + 1, k),
    }
}

fn Heap::kept_b(tys: Nat → Type, before, after: Heap(tys)) → Bool { before.len().leb(after.len()) && Heap::stays_from(tys, before, after, 0, before.len()) }

fn Heap::bare_b(tys: Nat → Type, h: Heap(tys), b: Nat) → Bool { match Heap::obj(tys, h, b) { Some(ob) => match ob.holes { Nil => True, Cons(_, _) => False }, None => False } }

fn Value::view_is_b(tys: Nat → Type, strs: Strs(tys), n: Nat, h: Heap(tys), vs: List<Value(tys)>, ws: List<Ix>, code: Shape, org: Origin, o: Value(tys)) → Bool {
    match org {
        OView(i, xs) => match vs.nth(i) { Some(v) => match v { Refer(r) => match o { Refer(q) => q.same(r.narrow(ws, xs)), Plain(_) => False }, Plain(_) => !Value::refers(tys, o) }, None => False },
        OFresh => match o { Plain(_) => True, Refer(r) => !Shape::plain(tys, strs, code) && n.leb(r.b) && Sel::same_list(r.sels, Nil) && Heap::bare_b(tys, h, r.b) },
        OParam(i) => match vs.nth(i) { Some(v) => match v { Refer(r) => match o { Refer(q) => q.same(r), Plain(_) => False }, Plain(_) => !Value::refers(tys, o) }, None => False },
    }
}

fn Value::views_b(tys: Nat → Type, strs: Strs(tys), n: Nat, h: Heap(tys), vs: List<Value(tys)>, ws: List<Ix>, rs: List<Result>, outs: List<Value(tys)>) → Bool {
    match rs {
        Nil => True,
        Cons(r, rest) => match outs { Nil => False, Cons(o, orest) => Value::view_is_b(tys, strs, n, h, vs, ws, r.code, r.origin, o) && Value::views_b(tys, strs, n, h, vs, ws, rest, orest) },
    }
}

fn Value::not_owned_b(tys: Nat → Type, b: Nat, rs: List<Result>, outs: List<Value(tys)>) → Bool {
    match rs { Nil => True, Cons(r, rest) => match outs { Nil => True, Cons(o, orest) => !Option::same_by(Nat::same, Value::owned_b(tys, r.origin, o), Some(b)) && Value::not_owned_b(tys, b, rest, orest) } }
}

fn Value::owned_apart_b(tys: Nat → Type, rs: List<Result>, outs: List<Value(tys)>) → Bool {
    match rs {
        Nil => True,
        Cons(r, rest) => match outs {
            Nil => True,
            Cons(o, orest) => (match Value::owned_b(tys, r.origin, o) { Some(b) => Value::not_owned_b(tys, b, rest, orest), None => True }) && Value::owned_apart_b(tys, rest, orest),
        },
    }
}

// ---------------------------------------------------------------------------
// One instance: a program, a function, a fuel, the inputs

// Which clause an instance breaks.
inductive Clause { CStuck, CNeed, CReadAll, CWritten, CFrame, CKept, CViews, COwnedApart, CCoded }

fn Clause::tag(self c: Clause) → Nat { match c { CStuck => 1, CNeed => 2, CReadAll => 3, CWritten => 4, CFrame => 5, CKept => 6, CViews => 7, COwnedApart => 8, CCoded => 9 } }

// The first of a list of checks that fails.
fn Clause::first(cs: List<Pair<Clause, Bool>>) → Option<Clause> { match cs { Nil => None, Cons(c, rest) => match c.snd { True => Clause::first(rest), False => Some(c.fst) } } }

// What `SafeAt` assumes of the inputs, decided: `ReadAll`, the codes and
// `Lendable` (the precondition is the search's to choose).
fn Prog::owed_b(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, p: Prog(tys), g: Nat, vs: List<Value(tys)>, h: Heap(tys), ds: List<Dyn(tys)>) → Bool {
    Value::read_all_b(tys, eq, p.strs, h, h.len(), vs, ds) && Dyn::coded(tys, ds, (p.fns(g)).sig.params) && Lendable::b(tys, p.strs, (p.fns(g)).sig.params, h, vs)
}

// What a `Done` answer owes.
fn Prog::done_b(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, p: Prog(tys), g: Nat, vs: List<Value(tys)>, h: Heap(tys), ds: List<Dyn(tys)>, a: Answer(tys)) → Option<Clause> {
    let sg = (p.fns(g)).sig;
    let mean = p.w(g, ds);
    Clause::first([
        Pair(CReadAll, Value::read_all_b(tys, eq, p.strs, a.heap, a.heap.len(), a.results, mean)),
        Pair(CWritten, Value::written_b(tys, p.strs, vs, ds, sg.written(), a.results.drop(sg.results.len()), mean.drop(sg.results.len()))),
        Pair(CFrame, Heap::frame_b(tys, eq, p.strs, h, a.heap, Value::lent(tys, sg.params, vs))),
        Pair(CKept, Heap::kept_b(tys, h, a.heap)),
        Pair(CViews, Value::views_b(tys, p.strs, h.len(), a.heap, vs, Dyn::ixs(tys, ds ++ mean), sg.results, a.results)),
        Pair(COwnedApart, Value::owned_apart_b(tys, sg.results, a.results)),
        Pair(CCoded, Dyn::coded(tys, mean.take(sg.results.len()), sg.res_params())),
    ])
}

// A run not done: a measured function owes `Done` from its need on.
fn Prog::need_b(tys: Nat → Type, p: Prog(tys), g, fuel: Nat, ds: List<Dyn(tys)>) → Option<Clause> {
    match p.need(g) { Some(n) => match (n(g, ds)).leb(fuel) { True => Some(CNeed), False => None }, None => None }
}

// What `SafeAt` concludes at one fuel, at inputs it is owed at: the first
// clause broken, if any.
fn Prog::verdict_b(tys: Nat → Type, eq: Dyn(tys) → Dyn(tys) → Bool, p: Prog(tys), g: Nat, fuel: Nat, vs: List<Value(tys)>, h: Heap(tys), io: Io, ds: List<Dyn(tys)>) → Option<Clause> {
    match p.run(tys, fuel, g, vs, h, io) {
        Stuck => Some(CStuck),
        Done(a) => Prog::done_b(tys, eq, p, g, vs, h, ds, a),
        Exited(_, _) => Prog::need_b(tys, p, g, fuel, ds),
        Going(_) => Prog::need_b(tys, p, g, fuel, ds),
    }
}

// ---------------------------------------------------------------------------
// A program written as numbers, for a driver to print (`scripts/ownership-oracle`
// reads this encoding back): each node its constructor's tag, then its
// fields, a list its length first.

fn enc_flat<A>(f: A → List<Nat>, xs: List<A>) → List<Nat> { match xs { Nil => Nil, Cons(x, r) => f(x) ++ enc_flat(f, r) } }

fn enc_list<A>(f: A → List<Nat>, xs: List<A>) → List<Nat> { Cons(xs.len(), enc_flat(f, xs)) }

fn enc_width(w: Width) → List<Nat> { match w { WNat => [0], WBits(n) => [1, n] } }

fn enc_shape(c: Shape) → List<Nat> { match c { SWord(w) => Cons(0, enc_width(w)), SNamed(k) => [1, k] } }

fn enc_atom(a: Atom) → List<Nat> { match a { Lit(n) => [0, n], Var(w) => [1, w] } }

fn enc_step(a: Step) → List<Nat> {
    match a { SField(i) => [0, i], SElem(i) => Cons(1, enc_atom(i)), SWindow(lo, n) => Cons(2, enc_atom(lo) ++ enc_atom(n)), SKey(i, g) => Cons(3, enc_atom(i) ++ enc_atom(g)), SVariant(c) => [4, c] }
}

fn enc_var(x: Var) → List<Nat> { match x { Arg(i) => [0, i], Loc(j) => [1, j] } }

fn enc_place(p: Place) → List<Nat> { enc_var(p.root) ++ enc_list(λ (a: Step) => enc_step(a), p.steps) }

fn enc_prim(o: Prim) → Nat { match o { PAdd => 0, PSub => 1, PMul => 2 } }

fn enc_stmt(s: Stmt) → List<Nat> {
    match s {
        Op(o, a, b) => Cons(0, Cons(enc_prim(o), enc_var(a) ++ enc_var(b))),
        Lit(w, n) => Cons(1, enc_width(w) ++ [n]),
        Read(p) => Cons(2, enc_place(p)),
        Write(p, v) => Cons(3, enc_place(p) ++ enc_var(v)),
        View(p, m) => Cons(4, enc_place(p) ++ [match m { Reading => 0, Writing => 1 }]),
        Take(p) => Cons(5, enc_place(p)),
        Fresh(c, n, v) => Cons(6, enc_shape(c) ++ enc_var(n) ++ enc_var(v)),
        Call(g, args, n) => Cons(7, Cons(g, enc_list(λ (x: Var) => enc_var(x), args) ++ [n])),
        Death(p) => Cons(8, enc_place(p)),
        Back(p, v) => Cons(9, enc_place(p) ++ enc_var(v)),
        Len(p, w) => Cons(10, enc_place(p) ++ enc_width(w)),
    }
}

fn enc_test(t: Test) → List<Nat> { match t { TLt(a, b) => Cons(0, enc_var(a) ++ enc_var(b)), TLe(a, b) => Cons(1, enc_var(a) ++ enc_var(b)) } }

fn enc_body(b: Body) → List<Nat> {
    match b {
        Ret(xs) => Cons(0, enc_list(λ (x: Var) => enc_var(x), xs)),
        Yield(xs) => Cons(1, enc_list(λ (x: Var) => enc_var(x), xs)),
        Do(s, rest) => Cons(2, enc_stmt(s) ++ enc_body(rest)),
        Join(t, y, n, rest) => Cons(3, enc_test(t) ++ enc_body(y) ++ enc_body(n) ++ enc_body(rest)),
        Jump(xs) => Cons(4, enc_list(λ (x: Var) => enc_var(x), xs)),
    }
}

fn enc_mode(m: PMode) → Nat { match m { ByTake => 0, ByRead => 1, ByWrite => 2 } }

fn enc_origin(o: Origin) → List<Nat> { match o { OFresh => [0], OParam(i) => [1, i], OView(i, xs) => Cons(2, Cons(i, enc_list(λ (a: Step) => enc_step(a), xs))) } }

fn enc_sig(s: Sig) → List<Nat> {
    enc_list(λ (p: Param) => enc_shape(p.code) ++ [enc_mode(p.mode)], s.params) ++ enc_list(λ (r: Result) => enc_shape(r.code) ++ enc_origin(r.origin), s.results)
}

fn enc_func(f: Func) → List<Nat> { enc_sig(f.sig) ++ enc_body(f.body) }

fn enc_ix(i: Ix) → List<Nat> { match i { INat(n) => [0, n], IWord(w, v) => [1, w, v.toNat()] } }

fn enc_sel(a: Sel) → List<Nat> {
    match a { OnField(i) => [0, i], OnSeq(q) => match q { SeqOne(i) => Cons(1, enc_ix(i)), SeqRun(lo, n) => Cons(2, enc_ix(lo) ++ enc_ix(n)) }, OnKey(_) => [3], OnVariant(c) => [4, c] }
}

fn enc_value(tys: Nat → Type, encd: Dyn(tys) → List<Nat>, v: Value(tys)) → List<Nat> {
    match v { Plain(d) => Cons(0, enc_shape(d.code) ++ encd(d)), Refer(r) => Cons(1, Cons(r.b, enc_list(λ (a: Sel) => enc_sel(a), r.sels))) }
}

// The leaf stages of `placement_sound` (docs/language/ownership-design.md
// §25.6, §25.8 F6, §25.9; issues/ownership-end-to-end-slice.md): each a
// `LeafStage` (placement_seam.hthr) for one statement kind, concluding that
// level 2 is stuck there for every continuation, or steps to a machine the
// stage names, related by `StageRel` to the configuration the leaf runs to.
//
// - **What the leaves share** (`rel_push`): a leaf that binds one new slot
//   writes only ids at or past `next` (`Locals::Agree`), so every slot
//   already bound reads what it read; the environment grows by the slot at
//   the end, level 2's by the cell at the front of its locals, which is the
//   end of the environment by level.
// - **Each stage cases on the run's own scrutinee**, never on a fact
//   assumed about level 2's machine: where level 2's read is `None` it is
//   stuck, whatever follows.
// - **"The codes agree"** comes through one named lemma per site, sourced
//   today from `place`'s interim comparison (§25.8, F4), so that its source
//   can become the run's not being stuck at a mismatch (§26.5) without
//   touching the stage.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import pair;
import bitvec;
import bitvec_nat;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import level2;
import run;
import placement;
import placement_seam;
import placement_inject;
import bytes_memory;
import bytes_level;
import function_ir;
import function_ir_eval;
import function_ir_state;
import x86_64_memory_contract;
import x86_64_call_contract;

// ---------------------------------------------------------------------------
// Locals agreeing below an id

fn Locals::Agree(l, l2: Locals, next: Nat) → Type { (t: Typed) → t.id < next → l2.read(t) = l.read(t) }

theorem Locals::agree_trans(l, l2, l3: Locals, next: Nat, a: Locals::Agree(l, l2, next), b: Locals::Agree(l2, l3, next)): Locals::Agree(l, l3, next) {
    λ t lt => trans(b(t, lt), a(t, lt))
}

theorem Locals::agree_refl(l: Locals, next: Nat): Locals::Agree(l, l, next) { λ t lt => refl }

// A word set at an id at or past `next`.
theorem Locals::agree_set(l: Locals, id: Nat, value: (w: Nat) → BitVec(w), next: Nat, ge: next <= id): Locals::Agree(l, Locals(Valuation::set(l.words, id, value), l.refs), next) {
    λ t lt => (match t.kind as λ kd =>
            (match kd { WordKind => Some(x86_64_call_contract::Word(Valuation::set(l.words, id, value, 64, t.id))), RefKind => l.refs(t.id).map(λ (loc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(loc)) })
            = (match kd { WordKind => Some(x86_64_call_contract::Word(l.words(64, t.id))), RefKind => l.refs(t.id).map(λ (loc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(loc)) }) {
        WordKind => cong_fn(λ (x: BitVec(64)) => Some(x86_64_call_contract::Word(x)), Valuation::set_other(l.words, id, value, 64, t.id, λ e2 => { omega })),
        RefKind => refl,
    })
}

// A reference set at an id at or past `next`.
theorem Locals::agree_set_ref(l: Locals, id: Nat, loc: x86_64_memory_contract::Loc, next: Nat, ge: next <= id): Locals::Agree(l, l.set_ref(id, loc), next) {
    λ t lt => (match t.kind as λ kd =>
            (match kd { WordKind => Some(x86_64_call_contract::Word(l.words(64, t.id))),
                RefKind => (match t.id.same(id) { True => Some(loc), False => l.refs(t.id) }).map(λ (lc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(lc)) })
            = (match kd { WordKind => Some(x86_64_call_contract::Word(l.words(64, t.id))), RefKind => l.refs(t.id).map(λ (lc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(lc)) }) {
        WordKind => refl,
        RefKind => cong_fn(λ (b: Bool) => (match b { True => Some(loc), False => l.refs(t.id) }).map(λ (lc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(lc)),
            Nat::same_false_of(t.id, id, λ e2 => { omega })),
    })
}

theorem read_values_agree(l, l2: Locals, next: Nat, a: Locals::Agree(l, l2, next), ids: List<Typed>): ((t: Typed) → Mem(t, ids) → t.id < next) → read_values(ids, l2) = read_values(ids, l) {
    match ids {
        Nil => λ _ => refl,
        Cons(v, rest) => λ b => eq2(λ (x: Option<x86_64_call_contract::Value>) (xs: Option<List<x86_64_call_contract::Value>>) =>
                x.and_then(λ (y: x86_64_call_contract::Value) => xs.and_then(λ (ys: List<x86_64_call_contract::Value>) => Some(Cons(y, ys)))),
            a(v, b(v, Inl(refl))), read_values_agree(l, l2, next, a, rest, λ t m2 => b(t, Inr(m2)))),
    }
}

// ---------------------------------------------------------------------------
// Slots kept, and one added at the end

fn slots_below(ss: List<PSlot>, next: Nat) → Type { (k: Nat) → (s: PSlot) → ss.nth(k) = Some(s) → (t: Typed) → Mem(t, s.ids) → t.id < next }

theorem holds_agree(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), l, l2: Locals, next: Nat, a: Locals::Agree(l, l2, next), ss: List<PSlot>):
    slots_below(ss, next) → (cs: List<Cell(tys)>) → SlotsHold(tys, strs, inj, h, ss, cs, l) → SlotsHold(tys, strs, inj, h, ss, cs, l2)
{
    match ss {
        Nil => λ _ cs hs => hs,
        Cons(s, sr) => λ b cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Cons(s, sr), c2, l) → SlotsHold(tys, strs, inj, h, Cons(s, sr), c2, l2) {
            Nil => λ hs => hs,
            Cons(c, cr) => λ hs => ⟨λ live => ⟨trans(read_values_agree(l, l2, next, a, s.ids, b(0, s, refl)), (hs.left(live)).left), (hs.left(live)).right⟩,
                holds_agree(tys, strs, inj, h, l, l2, next, a, sr, λ k s2 e2 => b(Succ(k), s2, e2), cr, hs.right)⟩,
        }),
    }
}

theorem holds_len(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), l: Locals, ss: List<PSlot>):
    (cs: List<Cell(tys)>) → SlotsHold(tys, strs, inj, h, ss, cs, l) → ss.len() = cs.len()
{
    match ss {
        Nil => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Nil, c2, l) → 0 = c2.len() { Nil => λ _ => refl, Cons(_, _) => λ f => false_elim(f) }),
        Cons(s, sr) => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Cons(s, sr), c2, l) → Succ(sr.len()) = c2.len() {
            Nil => λ f => false_elim(f),
            Cons(c, cr) => λ hs => cong_fn(λ (n: Nat) => Succ(n), holds_len(tys, strs, inj, h, l, sr, cr, hs.right)),
        }),
    }
}

theorem holds_snoc(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), l: Locals, ss: List<PSlot>):
    (cs: List<Cell(tys)>) → SlotsHold(tys, strs, inj, h, ss, cs, l) → (s: PSlot) → (c: Cell(tys)) → SlotHolds(tys, strs, inj, h, s, c, l) →
    SlotsHold(tys, strs, inj, h, ss ++ [s], cs ++ [c], l)
{
    match ss {
        Nil => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Nil, c2, l) → (s: PSlot) → (c: Cell(tys)) → SlotHolds(tys, strs, inj, h, s, c, l) →
                SlotsHold(tys, strs, inj, h, [s], c2 ++ [c], l) {
            Nil => λ _ s c sh => ⟨sh, trivial⟩,
            Cons(_, _) => λ f => false_elim(f),
        }),
        Cons(s0, sr) => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Cons(s0, sr), c2, l) → (s: PSlot) → (c: Cell(tys)) → SlotHolds(tys, strs, inj, h, s, c, l) →
                SlotsHold(tys, strs, inj, h, Cons(s0, sr ++ [s]), c2 ++ [c], l) {
            Nil => λ f => false_elim(f),
            Cons(c0, cr) => λ hs s c sh => ⟨hs.left, holds_snoc(tys, strs, inj, h, l, sr, cr, hs.right, s, c, sh)⟩,
        }),
    }
}

// An element of a list with one more at its end: one of the list's, or the
// one added.
theorem nth_snoc<A>(xs: List<A>, x: A): (k: Nat) → (y: A) → (xs ++ [x]).nth(k) = Some(y) → ((k < xs.len()) ∧ (xs.nth(k) = Some(y))) ∨ ((k = xs.len()) ∧ (y = x)) {
    match xs {
        Nil => λ k y e => (match k as λ k2 => ([x]).nth(k2) = Some(y) → ((k2 < 0) ∧ (List::nth<A>(Nil, k2) = Some(y))) ∨ ((k2 = 0) ∧ (y = x)) {
            Zero => λ e2 => Inr(⟨refl, sym(Option::some_inj(x, y, e2))⟩),
            Succ(_) => λ e2 => absurd(e2),
        })(e),
        Cons(h0, t) => λ k y e => (match k as λ k2 => (Cons(h0, t ++ [x])).nth(k2) = Some(y) →
                ((k2 < Succ(t.len())) ∧ ((Cons(h0, t)).nth(k2) = Some(y))) ∨ ((k2 = Succ(t.len())) ∧ (y = x)) {
            Zero => λ e2 => Inl(⟨{ omega }, e2⟩),
            Succ(k1) => λ e2 => match nth_snoc(t, x, k1, y, e2) {
                Inl(p) => { let pl = p.left; Inl(⟨omega(pl), p.right⟩) },
                Inr(p) => Inr(⟨cong_fn(λ (n: Nat) => Succ(n), p.left), p.right⟩),
            },
        })(e),
    }
}

theorem nth_snoc_at<A>(xs: List<A>, x: A): (xs ++ [x]).nth(xs.len()) = Some(x) { List::nth_append_at(xs, [x], xs.len(), refl) }

theorem below_snoc(ss: List<PSlot>, s: PSlot, next, next2: Nat, b: slots_below(ss, next), le: next <= next2, sb: (t: Typed) → Mem(t, s.ids) → t.id < next2):
    slots_below(ss ++ [s], next2)
{
    λ k s2 e2 t m => match nth_snoc(ss, s, k, s2, e2) {
        Inl(p) => { let x = b(k, s2, p.right, t, m); omega(x, le) },
        Inr(p) => sb(t, j(p.right, λ y _ => Mem(t, y.ids), m)),
    }
}

// A leaf that binds one slot: the relation kept, at the ids the leaf leaves
// below `next` untouched.
theorem rel_push(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c: Config, next: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c, next), l2: Locals, ag: Locals::Agree(c.locals, l2, next), s: PSlot, cell: Cell(tys), next2: Nat, le: next <= next2,
    sb: (t: Typed) → Mem(t, s.ids) → t.id < next2, sh: SlotHolds(tys, strs, inj, m.heap, s, cell, l2)):
    StageRel(tys, strs, inj, blocks, act, e.push(s), Mach::push(tys, m, cell), Config(l2, c.memory, c.io), next2)
{
    let cs = m.env.args ++ m.env.locs.rev();
    let assoc = List::append_assoc(m.env.args, m.env.locs.rev(), [cell]);
    let held = holds_agree(tys, strs, inj, m.heap, c.locals, l2, next, ag, e.vars, rel.right.right.right.right.right, cs, rel.right.right.left);
    let held2 = holds_snoc(tys, strs, inj, m.heap, l2, e.vars, cs, held, s, cell, sh);
    ⟨rel.left, ⟨rel.right.left, ⟨j(assoc, λ x _ => SlotsHold(tys, strs, inj, m.heap, e.vars ++ [s], x, l2), held2),
        ⟨rel.right.right.right.left, ⟨rel.right.right.right.right.left,
            below_snoc(e.vars, s, next, next2, rel.right.right.right.right.right, le, sb)⟩⟩⟩⟩⟩
}

// A slot of one word id at `next`.
theorem one_below(next: Nat): (t: Typed) → Mem(t, [word_id(next)]) → t.id < next + 1 {
    λ t m => match m { Inl(e) => j(sym(e), λ x _ => x.id < next + 1, { omega }), Inr(f) => false_elim(f) }
}

// What a leaf concludes, by its placed statement's output.
fn LeafGoal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, s: Stmt, e: PEnv, next: Nat, o: SOut) → Type {
    (act: Act) → (inj: Nat → Nat) → (m: Mach(tys)) → (c: Config) → StageRel(tys, strs, inj, blocks, act, e, m, c, next) →
        (match o.code as λ _ => Type {
            Leaf(is) => ((k: Mach(tys) → level2::Ran(tys)) → s.run(tys, strs, fns, call, act, m, k) = level2::Stuck) ∨
                Exists<Mach(tys)>(λ m2 => Stmt::Steps(tys, strs, fns, call, act, s, m, m2) ∧
                    Exists<Config>(λ c2 => (run_instrs(blocks, is, c) = Some(c2)) ∧ StageRel(tys, strs, inj, blocks, act, o.env, m2, c2, o.next))),
            _ => False,
        })
}

// ---------------------------------------------------------------------------
// `Lit`: a constant at the literal reduced to its width

theorem lit_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, b, n: Nat, sz0: Nat, sz: (WBits(b)).size() = Some(sz0), e: PEnv, next: Nat):
    LeafGoal(tys, strs, fns, call, blocks, Stmt::Lit(WBits(b), n), e, next,
        SOut(leaf([Compute(Const(64, next, n % Nat::pow(2, b)))]), e.push(PSlot(SWord(WBits(b)), [word_id(next)])), next + 1))
{
    λ act inj m c rel => {
        let v = n % Nat::pow(2, b);
        let l2 = Locals(Valuation::set(c.locals.words, next, λ (w: Nat) => BitVec::ofNat(v)), c.locals.refs);
        let cell = Cell::plain(tys, Dyn(SWord(WBits(b)), BitVec::ofNat(n)));
        let read: (read_values([word_id(next)], l2) = Some([x86_64_call_contract::Word(BitVec::ofNat(v))])) =
            cong_fn(λ (x: BitVec(64)) => Some([x86_64_call_contract::Word(x)]), Valuation::set_here(c.locals.words, next, λ (w: Nat) => BitVec::ofNat(v), 64));
        let lowered: (value_lower(tys, strs, inj, m.heap, cell.v) = Some([x86_64_call_contract::Word(BitVec::ofNat(v))])) =
            trans(cong_fn(λ (z: Option<Nat>) => match z as λ _ => Option<List<x86_64_call_contract::Value>> { Some(_) => Some([x86_64_call_contract::Word(BitVec::ofNat((BitVec::ofNat(n, n := b)).toNat()))]), None => None }, sz),
                cong_fn(λ (x: Nat) => Some([x86_64_call_contract::Word(BitVec::ofNat(x))]), BitVec::toNat_ofNat_mod(b, n)));
        let sh: SlotHolds(tys, strs, inj, m.heap, PSlot(SWord(WBits(b)), [word_id(next)]), cell, l2) = λ _ => ⟨trans(read, sym(lowered)), refl⟩;
        Inr(Exists(Mach::push(tys, m, cell), ⟨λ k => refl, Exists(Config(l2, c.memory, c.io), ⟨refl,
            rel_push(tys, strs, inj, blocks, act, e, m, c, next, rel, l2, Locals::agree_set(c.locals, next, λ (w: Nat) => BitVec::ofNat(v), next, { omega }),
                PSlot(SWord(WBits(b)), [word_id(next)]), cell, next + 1, { omega }, one_below(next), sh)⟩)⟩))
    }
}

theorem stage_lit(tys: Nat → Type, strs: Strs(tys), sigs: Nat → Sig, prim: Nat → Bool, fns: Nat → Func, call: Caller(tys), blocks: Blocks):
    StageLit(tys, strs, sigs, prim, fns, call, blocks)
{
    λ w n e next o hp => (match w as λ w2 => (Stmt::Lit(w2, n)).place(tys, PCx(strs, sigs, prim), e, next) = Some(o) → LeafGoal(tys, strs, fns, call, blocks, Stmt::Lit(w2, n), e, next, o) {
        WNat => λ hp2 => absurd(hp2),
        WBits(b) => λ hp2 => (match sz: (WBits(b)).size() as λ z => (match z {
                    None => None,
                    Some(_) => Some(SOut(leaf([Compute(Const(64, next, n % Nat::pow(2, b)))]), e.push(PSlot(SWord(WBits(b)), [word_id(next)])), next + 1)),
                }) = Some(o) → LeafGoal(tys, strs, fns, call, blocks, Stmt::Lit(WBits(b), n), e, next, o) {
            None => λ never => absurd(never),
            Some(sz0) => λ hp3 => j(Option::some_inj(SOut(leaf([Compute(Const(64, next, n % Nat::pow(2, b)))]), e.push(PSlot(SWord(WBits(b)), [word_id(next)])), next + 1), o, hp3),
                λ o2 _ => LeafGoal(tys, strs, fns, call, blocks, Stmt::Lit(WBits(b), n), e, next, o2), lit_goal(tys, strs, fns, call, blocks, b, n, sz0, sz, e, next)),
        })(hp2),
    })(hp)
}

// ---------------------------------------------------------------------------
// `Death`: no code; level 2 kills an owner's block

theorem holds_map(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h1, h2: level2::Heap(tys), l1, l2: Locals,
    f: (s: PSlot) → (c: Cell(tys)) → SlotHolds(tys, strs, inj, h1, s, c, l1) → SlotHolds(tys, strs, inj, h2, s, c, l2), ss: List<PSlot>):
    (cs: List<Cell(tys)>) → SlotsHold(tys, strs, inj, h1, ss, cs, l1) → SlotsHold(tys, strs, inj, h2, ss, cs, l2)
{
    match ss {
        Nil => λ cs hs => hs,
        Cons(s, sr) => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h1, Cons(s, sr), c2, l1) → SlotsHold(tys, strs, inj, h2, Cons(s, sr), c2, l2) {
            Nil => λ hs => hs,
            Cons(c, cr) => λ hs => ⟨f(s, c, hs.left), holds_map(tys, strs, inj, h1, h2, l1, l2, f, sr, cr, hs.right)⟩,
        }),
    }
}

// The relation after a kill, at the same configuration.
theorem rel_kill(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c: Config, next: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c, next), b: Nat): StageRel(tys, strs, inj, blocks, act, e, Mach(run::Heap::kill(tys, m.heap, b), m.env, m.io), c, next)
{
    ⟨injects_kill(tys, strs, inj, m.heap, c.memory, rel.left, b), ⟨rel.right.left,
        ⟨holds_map(tys, strs, inj, m.heap, run::Heap::kill(tys, m.heap, b), c.locals, c.locals,
            λ s cl hs => slot_kill(tys, strs, inj, m.heap, c.memory, rel.left, b, s, cl, c.locals, hs), e.vars, m.env.args ++ m.env.locs.rev(), rel.right.right.left),
        ⟨rel.right.right.right.left, ⟨λ b2 ss may o2 after => rel.right.right.right.right.left(b2, ss, may, o2, (obj_kill(tys, m.heap, b, b2, o2, after)).right),
            rel.right.right.right.right.right⟩⟩⟩⟩⟩
}

// The run of a death, as `Stmt::run` spells it.
fn death_go(tys: Nat → Type, m: Mach(tys), k: Mach(tys) → level2::Ran(tys), st: List<Step>, v: level2::Value(tys), own: Bool) → level2::Ran(tys) {
    match st {
        Cons(_, _) => k(m),
        Nil => match own {
            False => k(m),
            True => match v {
                Plain(_) => k(m),
                Refer(r) => match level2::Heap::obj(tys, m.heap, r.b) { Some(_) => k(Mach(run::Heap::kill(tys, m.heap, r.b), m.env, m.io)), None => level2::Stuck },
            },
        },
    }
}

// Stuck, or the machine as it was, or a block killed: for every continuation.
fn DeathRuns(tys: Nat → Type, m: Mach(tys), st: List<Step>, v: level2::Value(tys), own: Bool) → Type {
    ((k: Mach(tys) → level2::Ran(tys)) → death_go(tys, m, k, st, v, own) = level2::Stuck) ∨
        (((k: Mach(tys) → level2::Ran(tys)) → death_go(tys, m, k, st, v, own) = k(m)) ∨
            Exists<Nat>(λ b => (k: Mach(tys) → level2::Ran(tys)) → death_go(tys, m, k, st, v, own) = k(Mach(run::Heap::kill(tys, m.heap, b), m.env, m.io))))
}

theorem death_cases(tys: Nat → Type, m: Mach(tys), st: List<Step>, v: level2::Value(tys), own: Bool): DeathRuns(tys, m, st, v, own) {
    match st {
        Cons(_, _) => Inr(Inl(λ k => refl)),
        Nil => match own {
            False => Inr(Inl(λ k => refl)),
            True => match v {
                Plain(_) => Inr(Inl(λ k => refl)),
                Refer(r) => (match level2::Heap::obj(tys, m.heap, r.b) as λ ob =>
                        ((k: Mach(tys) → level2::Ran(tys)) → (match ob { Some(_) => k(Mach(run::Heap::kill(tys, m.heap, r.b), m.env, m.io)), None => level2::Stuck }) = level2::Stuck) ∨
                        (((k: Mach(tys) → level2::Ran(tys)) → (match ob { Some(_) => k(Mach(run::Heap::kill(tys, m.heap, r.b), m.env, m.io)), None => level2::Stuck }) = k(m)) ∨
                            Exists<Nat>(λ b => (k: Mach(tys) → level2::Ran(tys)) →
                                (match ob { Some(_) => k(Mach(run::Heap::kill(tys, m.heap, r.b), m.env, m.io)), None => level2::Stuck }) = k(Mach(run::Heap::kill(tys, m.heap, b), m.env, m.io)))) {
                    Some(_) => Inr(Inr(Exists(r.b, λ k => refl))),
                    None => Inl(λ k => refl),
                }),
            },
        },
    }
}

theorem death_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, p: body::Place, e: PEnv, next: Nat):
    LeafGoal(tys, strs, fns, call, blocks, Death(p), e, next, SOut(leaf(Nil), e, next))
{
    λ act inj m c rel => {
        let cl = REnv::get(tys, m.env, p.root);
        match death_cases(tys, m, p.steps, cl.v, cl.own) {
            Inl(stuck) => Inl(stuck),
            Inr(more) => match more {
                Inl(same) => Inr(Exists(m, ⟨same, Exists(c, ⟨refl, rel⟩)⟩)),
                Inr(killed) => Inr(Exists(Mach(run::Heap::kill(tys, m.heap, killed.witness), m.env, m.io),
                    ⟨killed.proof, Exists(c, ⟨refl, rel_kill(tys, strs, inj, blocks, act, e, m, c, next, rel, killed.witness)⟩)⟩)),
            },
        }
    }
}

theorem stage_death(tys: Nat → Type, strs: Strs(tys), sigs: Nat → Sig, prim: Nat → Bool, fns: Nat → Func, call: Caller(tys), blocks: Blocks):
    StageDeath(tys, strs, sigs, prim, fns, call, blocks)
{
    λ p e next o hp => j(Option::some_inj(SOut(leaf(Nil), e, next), o, hp), λ o2 _ => LeafGoal(tys, strs, fns, call, blocks, Death(p), e, next, o2),
        death_goal(tys, strs, fns, call, blocks, p, e, next))
}

// ---------------------------------------------------------------------------
// Inverting `place`: each statement kind's placing is an `and_then` chain

theorem Option::bind_some<A, B>({x: Option<A>}, {f: A → Option<B>}, {o: B}, h: x.and_then(f) = Some(o)): Exists<A>(λ a => (x = Some(a)) ∧ (f(a) = Some(o))) {
    (match x as λ x2 => x2.and_then(f) = Some(o) → Exists<A>(λ a => (x2 = Some(a)) ∧ (f(a) = Some(o))) {
        None => λ no => absurd(no),
        Some(a) => λ e2 => Exists(a, ⟨refl, e2⟩),
    })(h)
}

theorem Bool::guard_some<B>({b: Bool}, {x: Option<B>}, {o: B}, h: Bool::guard(b, x) = Some(o)): (b = True) ∧ (x = Some(o)) {
    (match b as λ b2 => Bool::guard(b2, x) = Some(o) → (b2 = True) ∧ (x = Some(o)) { True => λ e2 => ⟨refl, e2⟩, False => λ no => absurd(no) })(h)
}

// ---------------------------------------------------------------------------
// A variable's slot, by level, and the cell level 2 holds there

theorem nth_unwrap<A>(xs: List<A>): (i: Nat) → (d: A) → i < xs.len() → xs.nth(i) = Some(xs.nth(i).unwrap_or(d)) {
    match xs {
        Nil => λ i d lt => false_elim({ omega }),
        Cons(h, t) => λ i d => (match i as λ i2 => i2 < Succ(t.len()) → (Cons(h, t)).nth(i2) = Some((Cons(h, t)).nth(i2).unwrap_or(d)) {
            Zero => λ _ => refl,
            Succ(k) => λ lt => nth_unwrap(t, k, d, omega(lt)),
        }),
    }
}

theorem holds_nth(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), l: Locals, ss: List<PSlot>):
    (cs: List<Cell(tys)>) → SlotsHold(tys, strs, inj, h, ss, cs, l) → (k: Nat) → (s: PSlot) → (c: Cell(tys)) → ss.nth(k) = Some(s) → cs.nth(k) = Some(c) →
    SlotHolds(tys, strs, inj, h, s, c, l)
{
    match ss {
        Nil => λ cs hs k s c no => absurd(no),
        Cons(s0, sr) => λ cs => (match cs as λ c2 => SlotsHold(tys, strs, inj, h, Cons(s0, sr), c2, l) → (k: Nat) → (s: PSlot) → (c: Cell(tys)) →
                (Cons(s0, sr)).nth(k) = Some(s) → c2.nth(k) = Some(c) → SlotHolds(tys, strs, inj, h, s, c, l) {
            Nil => λ f => false_elim(f),
            Cons(c0, cr) => λ hs k => (match k as λ k2 => (s: PSlot) → (c: Cell(tys)) → (Cons(s0, sr)).nth(k2) = Some(s) → (Cons(c0, cr)).nth(k2) = Some(c) →
                    SlotHolds(tys, strs, inj, h, s, c, l) {
                Zero => λ s c es ec => j(Option::some_inj(c0, c, ec), λ cc _ => SlotHolds(tys, strs, inj, h, s, cc, l),
                    j(Option::some_inj(s0, s, es), λ sx _ => SlotHolds(tys, strs, inj, h, sx, c0, l), hs.left)),
                Succ(k1) => λ s c es ec => holds_nth(tys, strs, inj, h, l, sr, cr, hs.right, k1, s, c, es, ec),
            }),
        }),
    }
}

// The environment by level holds, at a variable's level, the cell level 2
// reads the variable at.
theorem cells_at(tys: Nat → Type, e: PEnv, env: REnv(tys), na: e.na = env.args.len(), len: e.vars.len() = (env.args ++ env.locs.rev()).len()):
    (x: Var) → (l: Nat) → e.level(x) = Some(l) → (env.args ++ env.locs.rev()).nth(l) = Some(REnv::get(tys, env, x))
{
    λ x => match x {
        Arg(i) => λ l lv => (match q: (i + 1).leb(e.na) as λ bq => (match bq { True => Some(i), False => None }) = Some(l) →
                (env.args ++ env.locs.rev()).nth(l) = Some(REnv::get(tys, env, Arg(i))) {
            True => λ e2 => {
                let lt: (i < env.args.len()) = omega(q, na);
                j(Option::some_inj(i, l, e2), λ ll _ => (env.args ++ env.locs.rev()).nth(ll) = Some(REnv::get(tys, env, Arg(i))),
                    trans(List::nth_append_below(env.args, env.locs.rev(), i, lt), nth_unwrap(env.args, i, Cell::none(tys), lt)))
            },
            False => λ no => absurd(no),
        })(lv),
        Loc(jj) => λ l lv => (match q: (e.na + jj + 1).leb(e.vars.len()) as λ bq => (match bq { True => Some(e.vars.len() - 1 - jj), False => None }) = Some(l) →
                (env.args ++ env.locs.rev()).nth(l) = Some(REnv::get(tys, env, Loc(jj))) {
            True => λ e2 => {
                let la = List::len_append(env.args, env.locs.rev());
                let lr = List::rev_len(env.locs);
                let lt: (jj < env.locs.len()) = omega(q, na, len, la, lr);
                let cut: (e.vars.len() - 1 - jj = (env.locs.len() - 1 - jj) + env.args.len()) = omega(q, na, len, la, lr);
                let at: ((env.args ++ env.locs.rev()).nth((env.locs.len() - 1 - jj) + env.args.len()) = env.locs.nth(jj)) =
                    trans(List::nth_append_r(env.args, env.locs.rev(), env.locs.len() - 1 - jj), List::nth_rev(env.locs, env.locs.len() - 1 - jj, jj, { omega }));
                j(trans(sym(cut), Option::some_inj(e.vars.len() - 1 - jj, l, e2)), λ ll _ => (env.args ++ env.locs.rev()).nth(ll) = Some(REnv::get(tys, env, Loc(jj))),
                    trans(at, nth_unwrap(env.locs, jj, Cell::none(tys), lt)))
            },
            False => λ no => absurd(no),
        })(lv),
    }
}

// A variable placed: its slot holds the cell level 2 reads it at, its ids
// below `next`.
theorem slot_of(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c: Config, next: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c, next), x: Var, s: PSlot, eg: e.get(x) = Some(s)):
    SlotHolds(tys, strs, inj, m.heap, s, REnv::get(tys, m.env, x), c.locals) ∧ ((t: Typed) → Mem(t, s.ids) → t.id < next)
{
    let lv = Option::bind_some(eg);
    let cs = m.env.args ++ m.env.locs.rev();
    let len = holds_len(tys, strs, inj, m.heap, c.locals, e.vars, cs, rel.right.right.left);
    let at = cells_at(tys, e, m.env, rel.right.left, len, x, lv.witness, lv.proof.left);
    ⟨holds_nth(tys, strs, inj, m.heap, c.locals, e.vars, cs, rel.right.right.left, lv.witness, s, REnv::get(tys, m.env, x), lv.proof.right, at),
        rel.right.right.right.right.right(lv.witness, s, lv.proof.right)⟩
}

// ---------------------------------------------------------------------------
// A word slot: level 2's value there is a plain word, its 64-bit view the
// slot's word (or level 2 reads nothing there and is stuck)

theorem one_word_is(ids: List<Typed>, t: Typed): Typed::one_word(ids) = Some(t) → (ids = [t]) ∧ (t.kind = WordKind) {
    match ids {
        Nil => λ no => absurd(no),
        Cons(t0, rest) => match rest {
            Cons(_, _) => λ no => absurd(no),
            Nil => (match k: t0.kind as λ kd => (match kd { WordKind => Some(t0), RefKind => None }) = Some(t) → (Cons(t0, Nil) = Cons(t, Nil)) ∧ (t.kind = WordKind) {
                WordKind => λ e2 => {
                    let tt = Option::some_inj(t0, t, e2);
                    ⟨cong_fn(λ (y: Typed) => Cons(y, Nil), tt), j(tt, λ y _ => y.kind = WordKind, k)⟩
                },
                RefKind => λ no => absurd(no),
            }),
        },
    }
}

theorem read_word(t: Typed, l: Locals, k: t.kind = WordKind): read_values([t], l) = Some([x86_64_call_contract::Word(l.word(t.id))]) {
    cong_fn(λ (kd: ValueKind) => (match kd { WordKind => Some(x86_64_call_contract::Word(l.words(64, t.id))), RefKind => l.refs(t.id).map(λ (loc: x86_64_memory_contract::Loc) => x86_64_call_contract::Ref(loc)) })
        .and_then(λ (y: x86_64_call_contract::Value) => Some([y])), k)
}

fn first_word(o: Option<List<x86_64_call_contract::Value>>) → BitVec(64) {
    match o { Some(vs) => match vs { Cons(v, _) => match v { Word(w) => w, Ref(_) => BitVec::ofNat(0) }, Nil => BitVec::ofNat(0) }, None => BitVec::ofNat(0) }
}

fn heads_word(o: Option<List<x86_64_call_contract::Value>>) → Bool {
    match o { Some(vs) => match vs { Cons(v, _) => match v { Word(_) => True, Ref(_) => False }, Nil => False }, None => False }
}

// A reference lowers to a reference first, or to nothing.
theorem ref_lower_not_word(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, r: level2::Ref, o: Obj(tys)): heads_word(Ref::lower(tys, strs, inj, r, Some(o))) = False {
    match Sel::locate(tys, strs, o.val, r.sels, 0) as λ lo => heads_word(match lo {
            None => None,
            Some(at) => match Shape::layout(tys, strs, at.snd.code) {
                LSeq(_, _, _) => Some([x86_64_call_contract::Ref(Loc(inj(r.b), at.fst)), x86_64_call_contract::Word(BitVec::ofNat(Dyn::len(tys, strs, at.snd)))]),
                LRecord(_) => Some([x86_64_call_contract::Ref(Loc(inj(r.b), at.fst))]),
                LNone => None,
            },
        }) = False {
        None => refl,
        Some(at) => match Shape::layout(tys, strs, at.snd.code) as λ ly => heads_word(match ly {
                LSeq(_, _, _) => Some([x86_64_call_contract::Ref(Loc(inj(r.b), at.fst)), x86_64_call_contract::Word(BitVec::ofNat(Dyn::len(tys, strs, at.snd)))]),
                LRecord(_) => Some([x86_64_call_contract::Ref(Loc(inj(r.b), at.fst))]),
                LNone => None,
            }) = False {
            LSeq(_, _, _) => refl, LRecord(_) => refl, LNone => refl,
        },
    }
}

fn WordAt(tys: Nat → Type, strs: Strs(tys), h: level2::Heap(tys), v: level2::Value(tys), s: PSlot, w: BitVec(64)) → Type {
    (Value::get(tys, strs, h, v, Nil) = None) ∨
        Exists<Dyn(tys)>(λ d => (v = Plain(d)) ∧ ((d.code = s.code) ∧ (w = BitVec::ofNat(Dyn::index(tys, d)))))
}

theorem word_slot(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), s: PSlot, cell: Cell(tys), l: Locals,
    hs: SlotHolds(tys, strs, inj, h, s, cell, l), t: Typed, sw: s.word() = Some(t)): WordAt(tys, strs, h, cell.v, s, l.word(t.id))
{
    let wi = one_word_is(s.ids, t, sw);
    let rd: (read_values(s.ids, l) = Some([x86_64_call_contract::Word(l.word(t.id))])) =
        trans(cong_fn(λ (ids: List<Typed>) => read_values(ids, l), wi.left), read_word(t, l, wi.right));
    (match cell.v as λ v => (value_live(tys, h, v) = True → (read_values(s.ids, l) = value_lower(tys, strs, inj, h, v)) ∧
            ((Value::get(tys, strs, h, v, Nil)).map(λ (d: Dyn(tys)) => d.code) = Some(s.code))) → WordAt(tys, strs, h, v, s, l.word(t.id)) {
        Plain(d) => λ p => {
            let q = p(refl);
            let low: (Some([x86_64_call_contract::Word(l.word(t.id))]) = value_lower(tys, strs, inj, h, Plain(d))) = trans(sym(rd), q.left);
            let w: (l.word(t.id) = BitVec::ofNat(Dyn::index(tys, d))) = (match d.code.word_size() as λ z =>
                    Some(Cons(x86_64_call_contract::Word(l.word(t.id)), Nil)) = (match z as λ _ => Option<List<x86_64_call_contract::Value>> { Some(_) => Some(Cons(x86_64_call_contract::Word(BitVec::ofNat(Dyn::index(tys, d))), Nil)), None => None }) →
                    l.word(t.id) = BitVec::ofNat(Dyn::index(tys, d)) {
                Some(_) => λ e2 => cong_fn(λ (o: Option<List<x86_64_call_contract::Value>>) => first_word(o), e2),
                None => λ no => absurd(no),
            })(low);
            Inr(Exists(d, ⟨refl, ⟨Option::some_inj(d.code, s.code, q.right), w⟩⟩))
        },
        Refer(r) => λ p => (match ob: level2::Heap::obj(tys, h, r.b) as λ o2 => (o2.is_some() = True → (read_values(s.ids, l) = Ref::lower(tys, strs, inj, r, o2)) ∧
                ((Value::get(tys, strs, h, Refer(r), Nil)).map(λ (d: Dyn(tys)) => d.code) = Some(s.code))) → WordAt(tys, strs, h, Refer(r), s, l.word(t.id)) {
            None => λ _ => Inl(cong_fn(λ (z: Option<Obj(tys)>) => match match z as λ _ => Option<Dyn(tys)> { Some(o) => Obj::read(tys, strs, h, h.len(), o), None => None } as λ _ => Option<Dyn(tys)> {
                    Some(d) => run::Sel::get(tys, strs, r.sels ++ Nil, d), None => None }, ob)),
            Some(o) => λ p2 => {
                let bad = cong_fn(λ (z: Option<List<x86_64_call_contract::Value>>) => heads_word(z), trans(sym(rd), (p2(refl)).left));
                false_elim(absurd(trans(bad, ref_lower_not_word(tys, strs, inj, r, o))))
            },
        })(p),
    })(hs)
}

// ---------------------------------------------------------------------------
// `Op`: a word operation at 64 bits

theorem Shape::eq_of_same(a, b: Shape, h: a.same(b) = True): a = b {
    (match Shape::dec(a, b) as λ o => (match o { Inl(_) => True, Inr(_) => False }) = True → a = b {
        Inl(e) => λ _ => e,
        Inr(_) => λ no => absurd(no),
    })(h)
}

theorem Shape::word_of_is(c: Shape, w: Width): c.word_of() = Some(w) → c = SWord(w) {
    match c {
        SWord(w0) => λ e => cong_fn(λ (x: Width) => SWord(x), Option::some_inj(w0, w, e)),
        SNamed(_) => λ no => absurd(no),
    }
}

// One arm of a test on a bit, by which way it went.
theorem bool_arm(b: Bool, x, y: Option<Nat>, z: Nat, e: (match b { True => x, False => y }) = Some(z)): ((b = True) ∧ (x = Some(z))) ∨ ((b = False) ∧ (y = Some(z))) {
    (match b as λ b2 => (match b2 { True => x, False => y }) = Some(z) → ((b2 = True) ∧ (x = Some(z))) ∨ ((b2 = False) ∧ (y = Some(z))) {
        True => λ e2 => Inl(⟨refl, e2⟩),
        False => λ e2 => Inr(⟨refl, e2⟩),
    })(e)
}

// A word of eight bytes is a 64-bit word.
fn size_from64(n: Nat) → Option<Nat> { match n.same(64) { True => Some(8), False => None } }
fn size_from32(n: Nat) → Option<Nat> { match n.same(32) { True => Some(4), False => size_from64(n) } }
fn size_from16(n: Nat) → Option<Nat> { match n.same(16) { True => Some(2), False => size_from32(n) } }

theorem Width::is_64(w: Width): w.size() = Some(8) → w = WBits(64) {
    match w {
        WNat => λ no => absurd(no),
        WBits(n) => λ e8 => match bool_arm(n.same(8), Some(1), size_from16(n), 8, e8) {
            Inl(p) => { let q = Option::some_inj(1, 8, p.right); false_elim(omega(q)) },
            Inr(p) => match bool_arm(n.same(16), Some(2), size_from32(n), 8, p.right) {
                Inl(p2) => { let q = Option::some_inj(2, 8, p2.right); false_elim(omega(q)) },
                Inr(p2) => match bool_arm(n.same(32), Some(4), size_from64(n), 8, p2.right) {
                    Inl(p3) => { let q = Option::some_inj(4, 8, p3.right); false_elim(omega(q)) },
                    Inr(p3) => match bool_arm(n.same(64), Some(8), None, 8, p3.right) {
                        Inl(p4) => cong_fn(λ (k: Nat) => WBits(k), Nat::same_sound(n, 64, p4.left)),
                        Inr(p4) => absurd(p4.right),
                    },
                },
            },
        },
    }
}

// The run of an operation, as `Stmt::run` spells it.
fn op_go(tys: Nat → Type, m: Mach(tys), k: Mach(tys) → level2::Ran(tys), op: Prim, ox, oy: Option<Dyn(tys)>) → level2::Ran(tys) {
    match ox {
        Some(x) => match oy {
            Some(y) => k(Mach::push(tys, m, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, x, y, λ wd p q => Dyn(SWord(wd), Width::op(wd, op, p, q)))))),
            None => level2::Stuck,
        },
        None => level2::Stuck,
    }
}

// The operation on 64-bit words, as `Width::op` reads it at a width.
fn bv_op(op: Prim, n: Nat, x, y: BitVec(n)) → BitVec(n) { match op { PAdd => x + y, PSub => x - y, PMul => x * y } }

// The operation's node, run.
theorem node_runs(blocks: Blocks, op: Prim, out, ia, ib: Nat, nd: Node, c: Config): op.node(64, out, ia, ib) = Some(nd) →
    run_instrs(blocks, [Compute(nd)], c) = Some(Config(Locals(Valuation::set(c.locals.words, out, λ (wd: Nat) => bv_op(op, wd, c.locals.words(wd, ia), c.locals.words(wd, ib))),
        c.locals.refs), c.memory, c.io))
{
    match op {
        PAdd => λ en => j(Option::some_inj(Add(64, out, ia, ib), nd, en), λ n2 _ => run_instrs(blocks, [Compute(n2)], c) =
            Some(Config(Locals(Valuation::set(c.locals.words, out, λ (wd: Nat) => bv_op(PAdd, wd, c.locals.words(wd, ia), c.locals.words(wd, ib))), c.locals.refs), c.memory, c.io)), refl),
        PSub => λ en => j(Option::some_inj(Sub(64, out, ia, ib), nd, en), λ n2 _ => run_instrs(blocks, [Compute(n2)], c) =
            Some(Config(Locals(Valuation::set(c.locals.words, out, λ (wd: Nat) => bv_op(PSub, wd, c.locals.words(wd, ia), c.locals.words(wd, ib))), c.locals.refs), c.memory, c.io)), refl),
        PMul => λ no => absurd(no),
    }
}

// A value of the 64-bit word code is the word `Dyn::back` reads it at, and
// a slot's word reading it is that word.
theorem word64_back(tys: Nat → Type, d: Dyn(tys), cd: d.code = SWord(WBits(64))): Dyn(SWord(WBits(64)), Dyn::back(tys, SWord(WBits(64)), d, BitVec::ofNat(0))) = d {
    Dyn::back_like(tys, SWord(WBits(64)), d, BitVec::ofNat(0), j(sym(cd), λ c2 _ => c2.same(SWord(WBits(64))) = True, Shape::same_self(SWord(WBits(64)))))
}

theorem word64_is(tys: Nat → Type, d: Dyn(tys), cd: d.code = SWord(WBits(64)), w: BitVec(64), wd: w = BitVec::ofNat(Dyn::index(tys, d))):
    w = Dyn::back(tys, SWord(WBits(64)), d, BitVec::ofNat(0))
{
    let x = Dyn::back(tys, SWord(WBits(64)), d, BitVec::ofNat(0));
    trans(trans(wd, cong_fn(λ (d2: Dyn(tys)) => BitVec::ofNat(Dyn::index(tys, d2), n := 64), sym(word64_back(tys, d, cd)))), BitVec::ofNat_toNat(64, x))
}

// A slot's variable read: its value, where it is the plain one the slot
// reads.
theorem val_plain(tys: Nat → Type, strs: Strs(tys), m: Mach(tys), x: Var, d: Dyn(tys), e: (REnv::get(tys, m.env, x)).v = Plain(d)): Mach::val(tys, strs, m, x) = Some(d) {
    cong_fn(λ (v: level2::Value(tys)) => Value::get(tys, strs, m.heap, v, Nil), e)
}

theorem op_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat,
    sa, sb: PSlot, ta, tb: Typed, nd: Node, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb), ca: sa.code = SWord(WBits(64)), cb: sb.code = sa.code,
    wa: sa.word() = Some(ta), wb: sb.word() = Some(tb), en: op.node(64, next, ta.id, tb.id) = Some(nd)):
    LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, SOut(leaf([Compute(nd)]), e.push(PSlot(SWord(WBits(64)), [word_id(next)])), next + 1))
{
    λ act inj m c rel => {
        let sla = slot_of(tys, strs, inj, blocks, act, e, m, c, next, rel, a, sa, ega);
        let slb = slot_of(tys, strs, inj, blocks, act, e, m, c, next, rel, b, sb, egb);
        match word_slot(tys, strs, inj, m.heap, sa, REnv::get(tys, m.env, a), c.locals, sla.left, ta, wa) {
            Inl(none_a) => Inl(λ k => cong_fn(λ (ox: Option<Dyn(tys)>) => op_go(tys, m, k, op, ox, Mach::val(tys, strs, m, b)), none_a)),
            Inr(da) => {
                let x = da.witness;
                let va = val_plain(tys, strs, m, a, x, da.proof.left);
                match word_slot(tys, strs, inj, m.heap, sb, REnv::get(tys, m.env, b), c.locals, slb.left, tb, wb) {
                    Inl(none_b) => Inl(λ k => eq2(λ (ox: Option<Dyn(tys)>) (oy: Option<Dyn(tys)>) => op_go(tys, m, k, op, ox, oy), va, none_b)),
                    Inr(db) => {
                        let y = db.witness;
                        let vb = val_plain(tys, strs, m, b, y, db.proof.left);
                        let cx: (x.code = SWord(WBits(64))) = trans(da.proof.right.left, ca);
                        let cy: (y.code = SWord(WBits(64))) = trans(db.proof.right.left, trans(cb, ca));
                        let u = Dyn::back(tys, SWord(WBits(64)), x, BitVec::ofNat(0));
                        let v = Dyn::back(tys, SWord(WBits(64)), y, BitVec::ofNat(0));
                        let wu: (c.locals.words(64, ta.id) = u) = word64_is(tys, x, cx, c.locals.word(ta.id), da.proof.right.right);
                        let wv: (c.locals.words(64, tb.id) = v) = word64_is(tys, y, cy, c.locals.word(tb.id), db.proof.right.right);
                        let value = λ (wd: Nat) => bv_op(op, wd, c.locals.words(wd, ta.id), c.locals.words(wd, tb.id));
                        let l2 = Locals(Valuation::set(c.locals.words, next, value), c.locals.refs);
                        let s = PSlot(SWord(WBits(64)), [word_id(next)]);
                        let rd: (read_values([word_id(next)], l2) = Some([x86_64_call_contract::Word(bv_op(op, 64, c.locals.words(64, ta.id), c.locals.words(64, tb.id)))])) =
                            cong_fn(λ (z: BitVec(64)) => Some([x86_64_call_contract::Word(z)]), Valuation::set_here(c.locals.words, next, value, 64));
                        let ww: (bv_op(op, 64, c.locals.words(64, ta.id), c.locals.words(64, tb.id)) = BitVec::ofNat((bv_op(op, 64, u, v)).toNat())) =
                            trans(eq2(λ (p: BitVec(64)) (q: BitVec(64)) => bv_op(op, 64, p, q), wu, wv), sym(BitVec::ofNat_toNat(64, bv_op(op, 64, u, v))));
                        let sh0: SlotHolds(tys, strs, inj, m.heap, s, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, Dyn(SWord(WBits(64)), u), y, λ wd p q => Dyn(SWord(wd), Width::op(wd, op, p, q)))), l2) =
                            λ _ => ⟨trans(rd, cong_fn(λ (z: BitVec(64)) => Some([x86_64_call_contract::Word(z)]), ww)), refl⟩;
                        let sh: SlotHolds(tys, strs, inj, m.heap, s, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, x, y, λ wd p q => Dyn(SWord(wd), Width::op(wd, op, p, q)))), l2) =
                            j(word64_back(tys, x, cx), λ x2 _ => SlotHolds(tys, strs, inj, m.heap, s, Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, x2, y, λ wd p q => Dyn(SWord(wd), Width::op(wd, op, p, q)))), l2), sh0);
                        let cell = Cell::plain(tys, Dyn::words<Dyn(tys)>(tys, x, y, λ wd p q => Dyn(SWord(wd), Width::op(wd, op, p, q))));
                        Inr(Exists(Mach::push(tys, m, cell), ⟨λ k => eq2(λ (ox: Option<Dyn(tys)>) (oy: Option<Dyn(tys)>) => op_go(tys, m, k, op, ox, oy), va, vb),
                            Exists(Config(l2, c.memory, c.io), ⟨node_runs(blocks, op, next, ta.id, tb.id, nd, c, en),
                                rel_push(tys, strs, inj, blocks, act, e, m, c, next, rel, l2, Locals::agree_set(c.locals, next, value, next, { omega }),
                                    s, cell, next + 1, { omega }, one_below(next), sh)⟩)⟩))
                    },
                }
            },
        }
    }
}

// `place` of an operation is `PEnv::place_op`.
theorem place_is_op(tys: Nat → Type, strs: Strs(tys), sigs: Nat → Sig, prim: Nat → Bool, op: Prim, a, b: Var, e: PEnv, next: Nat):
    (Op(op, a, b)).place(tys, PCx(strs, sigs, prim), e, next) = PEnv::place_op(tys, strs, e, op, a, b, next) { refl }

// The inversion, one named step of `PEnv::place_op` per lemma: each a
// single match on what `Option::bind_some` found, so the kernel types each
// step's equation once (nested, it re-types every one before it at each).
theorem op_sized_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa, sb: PSlot, ta, tb: Typed, w: Width, nd: Node, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb),
    cw: sa.code = SWord(w), cb: sb.code = sa.code, wa: sa.word() = Some(ta), wb: sb.word() = Some(tb), en0: op.node(w.bits(), next, ta.id, tb.id) = Some(nd),
    h: e.op_sized(w, nd, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(size, p) => {
        let g = Bool::guard_some(p.right);
        let w64: (w = WBits(64)) = Width::is_64(w, j(Nat::same_sound(size, 8, g.left), λ z _ => w.size() = Some(z), p.left));
        let en: (op.node(64, next, ta.id, tb.id) = Some(nd)) = j(w64, λ w2 _ => op.node(w2.bits(), next, ta.id, tb.id) = Some(nd), en0);
        let eo = Option::some_inj(SOut(leaf([Compute(nd)]), e.push(PSlot(SWord(WBits(64)), [word_id(next)])), next + 1), o,
            j(w64, λ w2 _ => Some(SOut(leaf([Compute(nd)]), e.push(PSlot(SWord(w2), [word_id(next)])), next + 1)) = Some(o), g.right));
        j(eo, λ o2 _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o2),
            op_goal(tys, strs, fns, call, blocks, op, a, b, e, next, sa, sb, ta, tb, nd, ega, egb, trans(cw, cong_fn(λ (x: Width) => SWord(x), w64)), cb, wa, wb, en))
    } }
}

theorem op_node_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa, sb: PSlot, ta, tb: Typed, w: Width, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb),
    cw: sa.code = SWord(w), cb: sb.code = sa.code, wa: sa.word() = Some(ta), wb: sb.word() = Some(tb), h: e.op_node(op, w, ta, tb, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(nd, p) => op_sized_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, sb, ta, tb, w, nd, ega, egb, cw, cb, wa, wb, p.left, p.right) }
}

theorem op_ta_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa, sb: PSlot, ta: Typed, w: Width, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb),
    cw: sa.code = SWord(w), wa: sa.word() = Some(ta), h: e.op_ta(op, sa, sb, w, ta, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(tb, p) => {
        let g = Bool::guard_some(p.right);
        op_node_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, sb, ta, tb, w, ega, egb, cw, Shape::eq_of_same(sb.code, sa.code, g.left), wa, p.left, g.right)
    } }
}

theorem op_w_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa, sb: PSlot, w: Width, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb), cw: sa.code = SWord(w), h: e.op_w(op, sa, sb, w, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(ta, p) => op_ta_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, sb, ta, w, ega, egb, cw, p.left, p.right) }
}

theorem op_b_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa, sb: PSlot, ega: e.get(a) = Some(sa), egb: e.get(b) = Some(sb), h: e.op_b(op, sa, sb, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(w, p) => op_w_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, sb, w, ega, egb, Shape::word_of_is(sa.code, w, p.left), p.right) }
}

theorem op_a_goal(tys: Nat → Type, strs: Strs(tys), fns: Nat → Func, call: Caller(tys), blocks: Blocks, op: Prim, a, b: Var, e: PEnv, next: Nat, o: SOut, sa: PSlot, ega: e.get(a) = Some(sa), h: e.op_a(op, sa, b, next) = Some(o)): LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o)
{
    match Option::bind_some(h) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) { Exists(sb, p) => op_b_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, sb, ega, p.left, p.right) }
}

theorem stage_op(tys: Nat → Type, strs: Strs(tys), sigs: Nat → Sig, prim: Nat → Bool, fns: Nat → Func, call: Caller(tys), blocks: Blocks):
    StageOp(tys, strs, sigs, prim, fns, call, blocks)
{
    λ op a b e next o hp => match Option::bind_some(trans(sym(place_is_op(tys, strs, sigs, prim, op, a, b, e, next)), hp)) as λ _ => LeafGoal(tys, strs, fns, call, blocks, Op(op, a, b), e, next, o) {
        Exists(sa, p) => op_a_goal(tys, strs, fns, call, blocks, op, a, b, e, next, o, sa, p.left, p.right),
    }
}

// ---------------------------------------------------------------------------
// A join's test: an unsigned comparison at 64 bits of zero-extended words

// A word with a size is of a width at most 64.
theorem Width::sized(w: Width, sz: Nat): w.size() = Some(sz) → Exists<Nat>(λ n => (w = WBits(n)) ∧ (n <= 64)) {
    match w {
        WNat => λ no => absurd(no),
        WBits(n) => λ e => Exists(n, ⟨refl, match bool_arm(n.same(8), Some(1), size_from16(n), sz, e) {
            Inl(p) => { let q = Nat::same_sound(n, 8, p.left); omega(q) },
            Inr(p) => match bool_arm(n.same(16), Some(2), size_from32(n), sz, p.right) {
                Inl(p2) => { let q = Nat::same_sound(n, 16, p2.left); omega(q) },
                Inr(p2) => match bool_arm(n.same(32), Some(4), size_from64(n), sz, p2.right) {
                    Inl(p3) => { let q = Nat::same_sound(n, 32, p3.left); omega(q) },
                    Inr(p3) => match bool_arm(n.same(64), Some(8), None, sz, p3.right) {
                        Inl(p4) => { let q = Nat::same_sound(n, 64, p4.left); omega(q) },
                        Inr(p4) => absurd(p4.right),
                    },
                },
            },
        }⟩),
    }
}

// A word of at most 64 bits, zero-extended, compares as it did.
theorem widen_lt(n: Nat, a, b: BitVec(n), le: n <= 64):
    (BitVec::ofNat(a.toNat(), n := 64)).unsigned_lt_bit(BitVec::ofNat(b.toNat(), n := 64)) = a.unsigned_lt_bit(b)
{
    let pw = Nat::pow_le_pow_r(2, n, 64, { omega }, le);
    let la = BitVec::toNat_lt_pow(n, a);
    let lb = BitVec::toNat_lt_pow(n, b);
    let wa: ((BitVec::ofNat(a.toNat(), n := 64)).toNat() = a.toNat()) = BitVec::toNat_ofNat(64, a.toNat(), omega(la, pw));
    let wb: ((BitVec::ofNat(b.toNat(), n := 64)).toNat() = b.toNat()) = BitVec::toNat_ofNat(64, b.toNat(), omega(lb, pw));
    trans(bitvec_nat::unsigned_lt_nat(64, BitVec::ofNat(a.toNat(), n := 64), BitVec::ofNat(b.toNat(), n := 64)),
        trans(eq2(λ (p: Nat) (q: Nat) => (p + 1).leb(q), wa, wb), sym(bitvec_nat::unsigned_lt_nat(n, a, b))))
}

// Two values of one word code compared at 64 bits, as level 2 compares
// them at their width.
theorem cmp_word(tys: Nat → Type, x, y: Dyn(tys), n: Nat, le: n <= 64, cx: x.code = SWord(WBits(n)), cy: y.code = SWord(WBits(n))):
    (BitVec::ofNat(Dyn::index(tys, x), n := 64)).unsigned_lt_bit(BitVec::ofNat(Dyn::index(tys, y), n := 64)) = Dyn::words(tys, x, y, Width::lt)
{
    let c = SWord(WBits(n));
    let u = Dyn::back(tys, c, x, BitVec::ofNat(0));
    let v = Dyn::back(tys, c, y, BitVec::ofNat(0));
    let bx = Dyn::back_like(tys, c, x, BitVec::ofNat(0), j(sym(cx), λ c2 _ => c2.same(c) = True, Shape::same_self(c)));
    let by = Dyn::back_like(tys, c, y, BitVec::ofNat(0), j(sym(cy), λ c2 _ => c2.same(c) = True, Shape::same_self(c)));
    let base: ((BitVec::ofNat(Dyn::index(tys, Dyn(c, u)), n := 64)).unsigned_lt_bit(BitVec::ofNat(Dyn::index(tys, Dyn(c, v)), n := 64)) = Dyn::words(tys, Dyn(c, u), Dyn(c, v), Width::lt)) =
        trans(widen_lt(n, u, v, le), cong_fn(λ (q: BitVec(n)) => u.unsigned_lt_bit(q), sym(Dyn::back_self(tys, c, v, BitVec::ofNat(0)))));
    j(bx, λ x2 _ => (BitVec::ofNat(Dyn::index(tys, x2), n := 64)).unsigned_lt_bit(BitVec::ofNat(Dyn::index(tys, y), n := 64)) = Dyn::words(tys, x2, y, Width::lt),
        j(by, λ y2 _ => (BitVec::ofNat(Dyn::index(tys, Dyn(c, u)), n := 64)).unsigned_lt_bit(BitVec::ofNat(Dyn::index(tys, y2), n := 64)) = Dyn::words(tys, Dyn(c, u), y2, Width::lt), base))
}

// `a <= b` is `!(b < a)`, at one word code.
theorem le_flip(tys: Nat → Type, x, y: Dyn(tys), n: Nat, cx: x.code = SWord(WBits(n)), cy: y.code = SWord(WBits(n))):
    Dyn::words(tys, x, y, Width::le) = !Dyn::words(tys, y, x, Width::lt)
{
    let c = SWord(WBits(n));
    let u = Dyn::back(tys, c, x, BitVec::ofNat(0));
    let v = Dyn::back(tys, c, y, BitVec::ofNat(0));
    let bx = Dyn::back_like(tys, c, x, BitVec::ofNat(0), j(sym(cx), λ c2 _ => c2.same(c) = True, Shape::same_self(c)));
    let by = Dyn::back_like(tys, c, y, BitVec::ofNat(0), j(sym(cy), λ c2 _ => c2.same(c) = True, Shape::same_self(c)));
    let base: (Dyn::words(tys, Dyn(c, u), Dyn(c, v), Width::le) = !Dyn::words(tys, Dyn(c, v), Dyn(c, u), Width::lt)) =
        trans(cong_fn(λ (q: BitVec(n)) => !q.unsigned_lt_bit(u), Dyn::back_self(tys, c, v, BitVec::ofNat(0))),
            cong_fn(λ (q: BitVec(n)) => !v.unsigned_lt_bit(q), sym(Dyn::back_self(tys, c, u, BitVec::ofNat(0)))));
    j(bx, λ x2 _ => Dyn::words(tys, x2, y, Width::le) = !Dyn::words(tys, y, x2, Width::lt),
        j(by, λ y2 _ => Dyn::words(tys, Dyn(c, u), y2, Width::le) = !Dyn::words(tys, y2, Dyn(c, u), Width::lt), base))
}

theorem Bool::not_not(b: Bool): !!b = b { match b { True => refl, False => refl } }

// A plain value a word slot holds has a word code with a size.
theorem word_sized(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, h: level2::Heap(tys), s: PSlot, cell: Cell(tys), l: Locals,
    hs: SlotHolds(tys, strs, inj, h, s, cell, l), t: Typed, sw: s.word() = Some(t), d: Dyn(tys), ev: cell.v = Plain(d)): Exists<Nat>(λ sz => d.code.word_size() = Some(sz))
{
    let wi = one_word_is(s.ids, t, sw);
    let rd: (read_values(s.ids, l) = Some([x86_64_call_contract::Word(l.word(t.id))])) =
        trans(cong_fn(λ (ids: List<Typed>) => read_values(ids, l), wi.left), read_word(t, l, wi.right));
    let q = hs(j(sym(ev), λ v _ => value_live(tys, h, v) = True, refl));
    let low: (Some([x86_64_call_contract::Word(l.word(t.id))]) = value_lower(tys, strs, inj, h, Plain(d))) =
        trans(sym(rd), trans(q.left, cong_fn(λ (v: level2::Value(tys)) => value_lower(tys, strs, inj, h, v), ev)));
    (match d.code.word_size() as λ z => Some(Cons(x86_64_call_contract::Word(l.word(t.id)), Nil)) =
            (match z as λ _ => Option<List<x86_64_call_contract::Value>> { Some(_) => Some(Cons(x86_64_call_contract::Word(BitVec::ofNat(Dyn::index(tys, d))), Nil)), None => None }) →
            Exists<Nat>(λ sz => z = Some(sz)) {
        Some(sz) => λ _ => Exists(sz, refl),
        None => λ no => absurd(no),
    })(low)
}

// A word variable level 2 reads: the code its slot has, the slot's word
// its 64-bit view, and its width at most 64.
theorem word_of_var(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c: Config, next: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c, next), f: Var, s: PSlot, t: Typed, w: Width, ef: e.get(f) = Some(s), sw: s.word() = Some(t),
    cw: s.code = SWord(w), x: Dyn(tys), vx: Mach::val(tys, strs, m, f) = Some(x)):
    (x.code = SWord(w)) ∧ ((c.locals.word(t.id) = BitVec::ofNat(Dyn::index(tys, x))) ∧ Exists<Nat>(λ n => (w = WBits(n)) ∧ (n <= 64)))
{
    let sl = slot_of(tys, strs, inj, blocks, act, e, m, c, next, rel, f, s, ef);
    match word_slot(tys, strs, inj, m.heap, s, REnv::get(tys, m.env, f), c.locals, sl.left, t, sw) {
        Inl(none) => absurd(trans(sym(vx), none)),
        Inr(da) => {
            let d = da.witness;
            let xd: (d = x) = Option::some_inj(d, x, trans(sym(val_plain(tys, strs, m, f, d, da.proof.left)), vx));
            let cd: (d.code = SWord(w)) = trans(da.proof.right.left, cw);
            let sz = word_sized(tys, strs, inj, m.heap, s, REnv::get(tys, m.env, f), c.locals, sl.left, t, sw, d, da.proof.left);
            let wn = Width::sized(w, sz.witness, j(cd, λ z _ => z.word_size() = Some(sz.witness), sz.proof));
            j(xd, λ z _ => (z.code = SWord(w)) ∧ ((c.locals.word(t.id) = BitVec::ofNat(Dyn::index(tys, z))) ∧ Exists<Nat>(λ n => (w = WBits(n)) ∧ (n <= 64))),
                ⟨cd, ⟨da.proof.right.right, wn⟩⟩)
        },
    }
}

// The relation at a configuration whose ids below `next` read as before.
theorem rel_same(tys: Nat → Type, strs: Strs(tys), inj: Nat → Nat, blocks: Blocks, act: Act, e: PEnv, m: Mach(tys), c: Config, next: Nat,
    rel: StageRel(tys, strs, inj, blocks, act, e, m, c, next), l2: Locals, ag: Locals::Agree(c.locals, l2, next), next2: Nat, le: next <= next2):
    StageRel(tys, strs, inj, blocks, act, e, m, Config(l2, c.memory, c.io), next2)
{
    ⟨rel.left, ⟨rel.right.left, ⟨holds_agree(tys, strs, inj, m.heap, c.locals, l2, next, ag, e.vars, rel.right.right.right.right.right, m.env.args ++ m.env.locs.rev(), rel.right.right.left),
        ⟨rel.right.right.right.left, ⟨rel.right.right.right.right.left, λ k s e2 t mm => { let x = rel.right.right.right.right.right(k, s, e2, t, mm); omega(x, le) }⟩⟩⟩⟩⟩
}

theorem bit_head(words: Valuation(), next: Nat, b: Bool): (Valuation::set(words, next, bit_value(b), 1, next)).head_bit() = b {
    trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), Valuation::set_here(words, next, bit_value(b), 1)), match b { True => refl, False => refl })
}

// What a comparison's leaf concludes, for the variables level 2 reads.
fn LessGoal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>) → Type {
    (act: Act) → (inj: Nat → Nat) → (m: Mach(tys)) → (c: Config) → StageRel(tys, strs, inj, blocks, act, e, m, c, next) →
        (x: Dyn(tys)) → (y: Dyn(tys)) → Mach::val(tys, strs, m, f) = Some(x) → Mach::val(tys, strs, m, g) = Some(y) →
        (tested.snd = swap) ∧ (Exists<Nat>(λ n => (x.code = SWord(WBits(n))) ∧ (y.code = SWord(WBits(n)))) ∧
            Exists<Config>(λ c2 => (run_instrs(blocks, tested.fst, c) = Some(c2)) ∧ ((c2.locals.words(1, next).head_bit() = Dyn::words(tys, x, y, Width::lt)) ∧
                StageRel(tys, strs, inj, blocks, act, e, m, c2, next + 1))))
}

theorem less_core(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, s1, s2: PSlot, t1, t2: Typed, w: Width,
    e1: e.get(f) = Some(s1), e2: e.get(g) = Some(s2), cw: s1.code = SWord(w), cs: s2.code = s1.code, w1: s1.word() = Some(t1), w2: s2.word() = Some(t2)):
    LessGoal(tys, strs, blocks, e, f, g, swap, next, Pair([Compute(UnsignedLessThan(64, next, t1.id, t2.id))], swap))
{
    λ act inj m c rel x y vx vy => {
        let fx = word_of_var(tys, strs, inj, blocks, act, e, m, c, next, rel, f, s1, t1, w, e1, w1, cw, x, vx);
        let fy = word_of_var(tys, strs, inj, blocks, act, e, m, c, next, rel, g, s2, t2, w, e2, w2, trans(cs, cw), y, vy);
        let wn = fx.right.right;
        let n = wn.witness;
        let cx: (x.code = SWord(WBits(n))) = trans(fx.left, cong_fn(λ (z: Width) => SWord(z), wn.proof.left));
        let cy: (y.code = SWord(WBits(n))) = trans(fy.left, cong_fn(λ (z: Width) => SWord(z), wn.proof.left));
        let bit = c.locals.words(64, t1.id).unsigned_lt_bit(c.locals.words(64, t2.id));
        let l2 = Locals(Valuation::set(c.locals.words, next, bit_value(bit)), c.locals.refs);
        let head: (l2.words(1, next).head_bit() = Dyn::words(tys, x, y, Width::lt)) =
            trans(bit_head(c.locals.words, next, bit), trans(eq2(λ (p: BitVec(64)) (q: BitVec(64)) => p.unsigned_lt_bit(q), fx.right.left, fy.right.left),
                cmp_word(tys, x, y, n, wn.proof.right, cx, cy)));
        ⟨refl, ⟨Exists(n, ⟨cx, cy⟩), Exists(Config(l2, c.memory, c.io), ⟨refl, ⟨head,
            rel_same(tys, strs, inj, blocks, act, e, m, c, next, rel, l2, Locals::agree_set(c.locals, next, bit_value(bit), next, { omega }), next + 1, { omega })⟩⟩)⟩⟩
    }
}

// The inversion of `PEnv::less`, one step per lemma.
theorem less_ta_goal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>, s1, s2: PSlot, t1: Typed, w: Width,
    e1: e.get(f) = Some(s1), e2: e.get(g) = Some(s2), cw: s1.code = SWord(w), w1: s1.word() = Some(t1), h: e.less_ta(s1, s2, t1, swap, next) = Some(tested)):
    LessGoal(tys, strs, blocks, e, f, g, swap, next, tested)
{
    match Option::bind_some(h) as λ _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, tested) { Exists(t2, p) => {
        let gd = Bool::guard_some(p.right);
        j(Option::some_inj(Pair([Compute(UnsignedLessThan(64, next, t1.id, t2.id))], swap), tested, gd.right), λ o2 _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, o2),
            less_core(tys, strs, blocks, e, f, g, swap, next, s1, s2, t1, t2, w, e1, e2, cw, Shape::eq_of_same(s2.code, s1.code, gd.left), w1, p.left))
    } }
}

theorem less_w_goal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>, s1, s2: PSlot, w: Width,
    e1: e.get(f) = Some(s1), e2: e.get(g) = Some(s2), cw: s1.code = SWord(w), h: e.less_w(s1, s2, swap, next) = Some(tested)):
    LessGoal(tys, strs, blocks, e, f, g, swap, next, tested)
{
    match Option::bind_some(h) as λ _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, tested) {
        Exists(t1, p) => less_ta_goal(tys, strs, blocks, e, f, g, swap, next, tested, s1, s2, t1, w, e1, e2, cw, p.left, p.right),
    }
}

theorem less_b_goal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>, s1, s2: PSlot,
    e1: e.get(f) = Some(s1), e2: e.get(g) = Some(s2), h: e.less_b(s1, s2, swap, next) = Some(tested)):
    LessGoal(tys, strs, blocks, e, f, g, swap, next, tested)
{
    match Option::bind_some(h) as λ _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, tested) {
        Exists(w, p) => less_w_goal(tys, strs, blocks, e, f, g, swap, next, tested, s1, s2, w, e1, e2, Shape::word_of_is(s1.code, w, p.left), p.right),
    }
}

theorem less_a_goal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>, s1: PSlot,
    e1: e.get(f) = Some(s1), h: e.less_a(s1, g, swap, next) = Some(tested)):
    LessGoal(tys, strs, blocks, e, f, g, swap, next, tested)
{
    match Option::bind_some(h) as λ _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, tested) {
        Exists(s2, p) => less_b_goal(tys, strs, blocks, e, f, g, swap, next, tested, s1, s2, e1, p.left, p.right),
    }
}

theorem less_goal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, e: PEnv, f, g: Var, swap: Bool, next: Nat, tested: Pair<List<Instr>, Bool>,
    h: e.less(f, g, swap, next) = Some(tested)): LessGoal(tys, strs, blocks, e, f, g, swap, next, tested)
{
    match Option::bind_some(h) as λ _ => LessGoal(tys, strs, blocks, e, f, g, swap, next, tested) {
        Exists(s1, p) => less_a_goal(tys, strs, blocks, e, f, g, swap, next, tested, s1, p.left, p.right),
    }
}

// What `StageTest` concludes.
fn TestGoal(tys: Nat → Type, strs: Strs(tys), blocks: Blocks, act: Act, inj: Nat → Nat, e: PEnv, m: Mach(tys), c: Config, next: Nat, tested: Pair<List<Instr>, Bool>, bit: Bool) → Type {
    Exists<Config>(λ c2 => (run_instrs(blocks, tested.fst, c) = Some(c2)) ∧ ((c2.locals.words(1, next).head_bit() = (match tested.snd { False => bit, True => !bit })) ∧
        StageRel(tys, strs, inj, blocks, act, e, m, c2, next + 1)))
}

// Level 2's test, read where it answers.
theorem test_vals(tys: Nat → Type, strs: Strs(tys), m: Mach(tys), a, b: Var, r: Dyn(tys) → Dyn(tys) → Bool, bit: Bool):
    (match Mach::val(tys, strs, m, a) { Some(x) => Mach::val(tys, strs, m, b).map(λ y => r(x, y)), None => None }) = Some(bit) →
    Exists<Dyn(tys)>(λ x => Exists<Dyn(tys)>(λ y => (Mach::val(tys, strs, m, a) = Some(x)) ∧ ((Mach::val(tys, strs, m, b) = Some(y)) ∧ (r(x, y) = bit))))
{
    match ea: Mach::val(tys, strs, m, a) {
        None => λ no => absurd(no),
        Some(x) => match eb: Mach::val(tys, strs, m, b) {
            None => λ no => absurd(no),
            Some(y) => λ e2 => Exists(x, Exists(y, ⟨refl, ⟨refl, Option::some_inj(r(x, y), bit, e2)⟩⟩)),
        },
    }
}

theorem stage_test(tys: Nat → Type, strs: Strs(tys), blocks: Blocks): StageTest(tys, strs, blocks) {
    λ t e next tested hp act inj m c rel bit hr => (match t as λ t2 => t2.place(e, next) = Some(tested) → t2.run(tys, strs, m) = Some(bit) →
            TestGoal(tys, strs, blocks, act, inj, e, m, c, next, tested, bit) {
        TLt(a, b) => λ h1 h2 => {
            let tv = test_vals(tys, strs, m, a, b, λ x y => Dyn::words(tys, x, y, Width::lt), bit, h2);
            let x = tv.witness;
            let y = tv.proof.witness;
            let q = tv.proof.proof;
            let lg = less_goal(tys, strs, blocks, e, a, b, False, next, tested, h1, act, inj, m, c, rel, x, y, q.left, q.right.left);
            let c2 = lg.right.right;
            Exists(c2.witness, ⟨c2.proof.left, ⟨j(sym(lg.left), λ sw _ => c2.witness.locals.words(1, next).head_bit() = (match sw { False => bit, True => !bit }),
                trans(c2.proof.right.left, q.right.right)), c2.proof.right.right⟩⟩)
        },
        TLe(a, b) => λ h1 h2 => {
            let tv = test_vals(tys, strs, m, a, b, λ x y => Dyn::words(tys, x, y, Width::le), bit, h2);
            let x = tv.witness;
            let y = tv.proof.witness;
            let q = tv.proof.proof;
            let lg = less_goal(tys, strs, blocks, e, b, a, True, next, tested, h1, act, inj, m, c, rel, y, x, q.right.left, q.left);
            let c2 = lg.right.right;
            let cs = lg.right.left;
            let flip: (!bit = Dyn::words(tys, y, x, Width::lt)) =
                trans(cong_fn(λ (z: Bool) => !z, trans(sym(q.right.right), le_flip(tys, x, y, cs.witness, cs.proof.right, cs.proof.left))), Bool::not_not(Dyn::words(tys, y, x, Width::lt)));
            Exists(c2.witness, ⟨c2.proof.left, ⟨j(sym(lg.left), λ sw _ => c2.witness.locals.words(1, next).head_bit() = (match sw { False => bit, True => !bit }),
                trans(c2.proof.right.left, sym(flip))), c2.proof.right.right⟩⟩)
        },
    })(hp, hr)
}

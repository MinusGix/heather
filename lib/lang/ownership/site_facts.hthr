// Site facts: a checker's residual discharged from the proof the source
// carries at that site (docs/language/ownership-design.md §14 item 1, §18.4
// item 1, issues/ownership-residuals-from-source-proofs.md).
//
// Over `call_check.hthr`'s fragment, the three things a source's proof
// needed to reach a residual and that module does not have:
//
// - **`Fact`**, a residual stated over the meaning's final state (every
//   version of the object and every word), not over its words alone, and in
//   the source's vocabulary. `Inside(x, i)` is an element read's bound,
//   `∥i < xs.len()∥` of the version `x` read: a squashed `Lt`, the type a
//   source writes for an erased index proof, so that proof is the discharge
//   by conversion. `Owe(o)` is one of `call_check`'s residuals. `bounds`
//   emits one bound per element read and `check_site` is `check_fn`'s
//   residuals and those. In this fragment the run's read is total (zero past
//   the reference, as the meaning's past the list), so agreement holds
//   without the bound and `site_sound` drops it; it is what the bytes level
//   owes (a load past a block has no meaning, §18.3).
// - **`FnSafeAt`**, `FnSafe` whose precondition reads the parameter's value
//   as well as the words: `inside: ∥i < xs.len()∥` is a precondition over
//   the list. `site_sound` gives it; its proof is `check_sound`'s at one
//   argument (`check_body_sound` is pointwise already).
// - **`Branch`**, `if h: a <= b { yes } else { no }` over the words a
//   function was given, each arm a whole straight body (what precedes the
//   test is repeated in both). Its meaning is a convoy on the test's bit,
//   `convoy`, which is what the source's `if h:` elaborates to, so its pin
//   is a conversion like a straight body's.
//
// And the bridge every discharge goes through: `check_sound` asks for the
// residuals at open words `ws`, where the meaning's word spine `ws ++ [x]`
// is stuck, so nothing reads off it. `words_eta` spells `ws` as
// `[word(ws, 0), …, word(ws, n - 1)]` from its length, and `at_words` moves a
// discharge stated at the spelled words (the source's locals) to open ones.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import span_set;
import atom;
import call_check;

// ---------------------------------------------------------------------------
// Facts

inductive Fact { Owe(o: Owed), Inside(x: Nat, i: Atom) }

fn Fact::Holds(self f: Fact, pres: Nat → List<Nat> → Type, s: Sem) → Type {
    match f {
        Owe(o) => o.Holds(pres, s.words),
        Inside(x, i) => ∥i.val(s.words) < list_at(s.objs, x).len()∥,
    }
}

fn Fact::All(fs: List<Fact>, pres: Nat → List<Nat> → Type, s: Sem) → Type {
    match fs { Nil => True, Cons(f, rest) => f.Holds(pres, s) ∧ Fact::All(rest, pres, s) }
}

fn Stmt::bounds(self o: Stmt) → List<Fact> {
    match o {
        Get(_, x, i) => [Inside(x, i)],
        Set(_, _, _, _) => Nil,
        View(_, _, _, _) => Nil,
        Read(_, _, _) => Nil,
        Die(_) => Nil,
        CallMut(_, _, _, _, _, _, _) => Nil,
        CallView(_, _, _, _) => Nil,
    }
}

fn bounds(ops: List<Stmt>) → List<Fact> { match ops { Nil => Nil, Cons(o, rest) => o.bounds() ++ bounds(rest) } }

fn owes(rs: List<Owed>) → List<Fact> { rs.map(λ o => Owe(o)) }

// The checker's residuals, then the bounds of its reads.
fn check_site(sigs: List<Sig>, f: Func) → Option<List<Fact>> { check_fn(sigs, f).map(λ rs => owes(rs) ++ bounds(f.body)) }

theorem Fact::owed_of(rs: List<Owed>, pres: Nat → List<Nat> → Type, s: Sem): (bs: List<Fact>) → Fact::All(owes(rs) ++ bs, pres, s) → Owed::All(rs, pres, s.words) {
    match rs {
        Nil => λ bs _ => trivial,
        Cons(_, rest) => λ bs h => ⟨h.left, Fact::owed_of(rest, pres, s, bs, h.right)⟩,
    }
}

// ---------------------------------------------------------------------------
// A precondition over the parameter too

fn FnSafeAt(sig: Sig, pre: List<Nat> → List<Nat> → Type, mean: List<Nat> → List<Nat> → MOut, run: List<List<Nat>> → Ref → List<Nat> → ROut) → Type {
    (file: List<List<Nat>>) → (r: Ref) → (ws: List<Nat>) → InRef(file, r) → ws.len() = sig.words → pre(window(list_at(file, r.b), r.base, r.len), ws) →
        Safe(sig.mode, file, r, window(list_at(file, r.b), r.base, r.len), mean(window(list_at(file, r.b), r.base, r.len), ws), run(file, r, ws))
}

// A precondition over the words alone is `FnSafe`'s.
theorem FnSafeAt::words(sig: Sig, pre: List<Nat> → Type, mean: List<Nat> → List<Nat> → MOut, run: List<List<Nat>> → Ref → List<Nat> → ROut,
    h: FnSafeAt(sig, λ _ ws => pre(ws), mean, run)): FnSafe(sig, pre, mean, run)
{
    h
}

// `check_sound` at one argument: the residuals are owed only of the
// argument the function is given.
theorem site_sound(sigs: List<Sig>, pres: Nat → List<Nat> → Type, f: Func, rs: List<Fact>, ok: check_site(sigs, f) = Some(rs), pre: List<Nat> → List<Nat> → Type, w: World,
    discharge: (arg, ws: List<Nat>) → ws.len() = f.words → pre(arg, ws) → Fact::All(rs, pres, mean_body(w, f.body, Sem([arg], Nil, ws))),
    callees: (g: Nat) → calls(f.body, g) = True → FnSafe(sig_at(sigs, g), pres(g), w.mean(g), w.run(g))):
    FnSafeAt(f.sig(), pre, λ arg ws => mean_fn(w, f, arg, ws), λ file r ws => run_fn(w, f, file, r, ws))
{
    let got = option_map_some(check_fn(sigs, f), λ q => owes(q) ++ bounds(f.body), rs, ok);
    λ file r ws inr nw p => {
        let arg = window(list_at(file, r.b), r.base, r.len);
        let s0 = Sem([arg], Nil, ws);
        let all: Fact::All(owes(got.witness) ++ bounds(f.body), pres, mean_body(w, f.body, s0)) =
            j(sym(got.proof.right), λ q _ => Fact::All(q, pres, mean_body(w, f.body, s0)), discharge(arg, ws, nw, p));
        let hold = Fact::owed_of(got.witness, pres, mean_body(w, f.body, s0), bounds(f.body), all);
        let k = Frame(f.mode, sigs, pres, w, r, file, arg);
        let m0 = Exec(file, Nil, ws);
        let c0 = Places(0, Nil, 0, f.words);
        let sim0: Sim(k, c0, s0, m0, mean_body(w, f.body, s0).words) = Sim(refl, sym(nw), refl, refl, refl, OnRef::start(file, r, inr), λ _ => refl, λ lv mem => false_elim(mem));
        let fin = check_body_sound(k, inr, f.body, c0, s0, m0, sim0, got.witness, got.proof.left, hold, callees);
        let at_end: Sim(k, fin.witness, mean_body(w, f.body, s0), run_body(w, r, f.body, m0), mean_body(w, f.body, s0).words) = fin.proof;
        at_end.ends(f, refl)
    }
}

// ---------------------------------------------------------------------------
// Open words, spelled

// `[word(ws, k), …, word(ws, k + n - 1)]`.
fn spell(ws: List<Nat>, k, n: Nat) → List<Nat> { match n { Zero => Nil, Succ(m) => Cons(word(ws, k), spell(ws, k + 1, m)) } }

theorem spell_shift(x: Nat, t: List<Nat>, n: Nat): (k: Nat) → spell(Cons(x, t), k + 1, n) = spell(t, k, n) {
    match n {
        Zero => λ k => refl,
        Succ(m) => λ k => cong_fn(λ (q: List<Nat>) => Cons(word(t, k), q), spell_shift(x, t, m, k + 1)),
    }
}

theorem spell_all(ws: List<Nat>): ws = spell(ws, 0, ws.len()) {
    match ws {
        Nil => refl,
        Cons(x, t) => trans(cong_fn(λ (q: List<Nat>) => Cons(x, q), spell_all(t)), cong_fn(λ (q: List<Nat>) => Cons(x, q), sym(spell_shift(x, t, t.len(), 0)))),
    }
}

theorem words_eta(ws: List<Nat>, n: Nat, e: ws.len() = n): ws = spell(ws, 0, n) {
    j(e, λ m _ => ws = spell(ws, 0, m), spell_all(ws))
}

// A discharge at the spelled words is one at open words: what a generator
// states per function is `site`, at the source's locals.
theorem at_words(w: World, body: List<Stmt>, rs: List<Fact>, pres: Nat → List<Nat> → Type, pre: List<Nat> → List<Nat> → Type, n: Nat,
    site: (arg, ws: List<Nat>) → pre(arg, spell(ws, 0, n)) → Fact::All(rs, pres, mean_body(w, body, Sem([arg], Nil, spell(ws, 0, n))))):
    (arg, ws: List<Nat>) → ws.len() = n → pre(arg, ws) → Fact::All(rs, pres, mean_body(w, body, Sem([arg], Nil, ws)))
{
    λ arg ws e p => {
        let q = words_eta(ws, n, e);
        j(sym(q), λ v _ => Fact::All(rs, pres, mean_body(w, body, Sem([arg], Nil, v))), site(arg, ws, j(q, λ v _ => pre(arg, v), p)))
    }
}

// ---------------------------------------------------------------------------
// A branch on the given words

// What `if h: c { y } else { n }` elaborates to: a match on the test's bit
// that hands each arm the bit's equation.
fn convoy<A>(c: Bool, y, n: A) → A { (match c as λ d => c = d → A { True => λ _ => y, False => λ _ => n })(refl) }

record Branch { a: Atom, b: Atom, yes: Func, no: Func }

fn Branch::bit(self br: Branch, ws: List<Nat>) → Bool { br.a.val(ws).leb(br.b.val(ws)) }

fn mean_branch(w: World, br: Branch, arg, ws: List<Nat>) → MOut { convoy(br.bit(ws), mean_fn(w, br.yes, arg, ws), mean_fn(w, br.no, arg, ws)) }

fn run_branch(w: World, br: Branch, file: List<List<Nat>>, r: Ref, ws: List<Nat>) → ROut { convoy(br.bit(ws), run_fn(w, br.yes, file, r, ws), run_fn(w, br.no, file, r, ws)) }

// Each arm under its side of the test gives the branch.
theorem branch_sound(br: Branch, sig: Sig, pre: List<Nat> → List<Nat> → Type, w: World,
    yes: FnSafeAt(sig, λ arg ws => pre(arg, ws) ∧ (br.bit(ws) = True), λ arg ws => mean_fn(w, br.yes, arg, ws), λ file r ws => run_fn(w, br.yes, file, r, ws)),
    no: FnSafeAt(sig, λ arg ws => pre(arg, ws) ∧ (br.bit(ws) = False), λ arg ws => mean_fn(w, br.no, arg, ws), λ file r ws => run_fn(w, br.no, file, r, ws))):
    FnSafeAt(sig, pre, λ arg ws => mean_branch(w, br, arg, ws), λ file r ws => run_branch(w, br, file, r, ws))
{
    λ file r ws inr nw p => {
        let arg = window(list_at(file, r.b), r.base, r.len);
        (match br.bit(ws) as λ c => br.bit(ws) = c →
                Safe(sig.mode, file, r, arg, convoy(c, mean_fn(w, br.yes, arg, ws), mean_fn(w, br.no, arg, ws)), convoy(c, run_fn(w, br.yes, file, r, ws), run_fn(w, br.no, file, r, ws))) {
            True => λ q => yes(file, r, ws, inr, nw, ⟨p, q⟩),
            False => λ q => no(file, r, ws, inr, nw, ⟨p, q⟩),
        })(refl)
    }
}

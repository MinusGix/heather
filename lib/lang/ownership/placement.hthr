// Placement, its translation half (docs/language/ownership-design.md §25,
// §15.5, §17.3, §19; issues/ownership-end-to-end-slice.md): a checked
// function's body (`body.hthr`) as a bytes-level routine (`bytes_level`),
// each object's layout read from its code through the structures (`Strs`).
// The seam's statement over it is `placement_seam.hthr`; nothing is proved
// over `place` here.
//
// The fragment: words of 8, 16, 32 and 64 bits; sequences of such words in
// blocks (an instance whose element is a word), with their windows; a
// record of words reached through a reference (its fields at offsets, in
// order, packed). No holes, no `Fresh` (the allocator is later), no
// primitive (a world entry has no code to place), no `WNat` (a number has
// no layout), no multiply (the bytes level has no such node).
//
// - **A variable is slots.** A word is one word id. A sequence held by
//   reference is two: the reference and its length as a word (§17.3: "a
//   length is a word beside a reference"), so a window is a reference moved
//   forward and its length. The environment mirrors the meaning's by level:
//   the arguments, then the locals in the order they were bound
//   (`PEnv`), so a `Var` and an atom read the same slot at every point.
// - **A place is code.** A root's reference walked by its steps: an element
//   `Offset`s by the index scaled to the element's size, a window by its
//   start scaled and takes its length word, a field by its offset. A read
//   of a word place is a `Load`, a write a `Store`, of the element's size.
// - **A view is its reference.** Its write-back (`Back`, §23.23) is
//   nothing where the view refers (the run's identity: its writes went
//   through in place) and a store where it is a word copy. A `Write` of a
//   sequence would be a typed copy, which the bytes level does not lower:
//   refused. A word variable written whole rebinds its slot.
// - **A length** (`Len`) is the word the slot already carries beside the
//   reference, at 64 bits: a narrower width owes the checker's `RLen`,
//   which a translation of every program does not see.
// - **A call** passes each word, and each sequence lent to read or write as
//   its two slots; it binds the results (a word, or a returned view's two
//   slots) then each written word. **A written sequence comes back as the
//   argument itself and is not returned**: the slot is bound to the
//   argument's own slots, as the run binds the argument's own cell
//   (`Value::slots`, §23.22).
// - **A store needs no test here**: the run is stuck at a store outside
//   what the activation may change (`Act::may`, §23.22), and the seam
//   relates what it may change to the blocks the bytes level may write.
// - **A narrow word is held zero-extended**: a load leaves its bytes zero
//   above them (`MOVZX`), a literal is a 64-bit constant, so a test on two
//   narrow words is the unsigned comparison of their 64-bit views, which the
//   lowering can test (it holds a loaded byte as a word, not at 8 bits).
//   Narrow arithmetic, which would leave bits above the width, is refused.
// - **A join both of whose arms yield is the bytes level's branch**: each
//   arm copies its outputs into one set of ids (fixed by the first `Yield`
//   placed), and what follows is placed once after the branch, so `k` joins
//   in a row cost `k` branches (the body's own reason for `Yield`, §20.3).
//   A join with an arm that leaves (a `Ret` or a `Jump` inside it) copies
//   what follows into each arm that yields, until the bytes level has
//   leaves that leave (`issues/bytes-level-loop-exits.md`). A test is an
//   unsigned comparison at its words' width.
// - **A `Jump` makes the routine a loop**: the routine's body is one plain
//   loop whose state is the parameters' slots then the results' slots. A
//   `Jump` sets the next state to its arguments (the results' slots zero)
//   and a flag word to zero; a `Ret` keeps the parameters, sets the results
//   and the flag to one. After every path the pass compares the flag with
//   one: that comparison is the exit bit, since the lowering tests an exit
//   bit only where a comparison made it. Level 2 spends a fuel at each `Jump` (a call), and
//   the bytes level one at each turn back: the same count (§25 on fuel).
// - **A `Ret`** moves its values into the routine's result ids, fixed for
//   the routine, so every path binds the same ones.
// - **Codes are compared where level 2 reads two things at one code**
//   (§25.8): an operation's and a test's second operand at the first's, a
//   stored word at the element's, a call's argument at the parameter's, a
//   `Ret`'s values at the results' and written parameters', a `Jump`'s at
//   the parameters', a shared join's second arm at the first's. Level 2
//   reads a word of another code as zero (`Dyn::words`) and ignores a store
//   of one (`Dyn::back`), which no node does: refused. An interim (the
//   coordinator's ruling on §25.8, F4): the run is to be stuck wherever the
//   meaning takes a fallback, and then these comparisons go, since a second
//   statement of the checker's code rule here would make `PlaceComplete`
//   owe a lemma tying the two. Each is marked.
//
// Ids are numbered once per routine from one counter, so no id is bound
// twice along any path (`Body::fresh`).
import logic;
import bool;
import pair;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import body;
import sequences;
import function_ir;
import bytes_level;

// ---------------------------------------------------------------------------
// Layout, read from codes through the structures

// A word's size in bytes; a number has none.
fn Width::size(self w: Width) → Option<Nat> {
    match w {
        WNat => None,
        WBits(n) => match n.same(8) { True => Some(1), False => match n.same(16) { True => Some(2), False => match n.same(32) { True => Some(4),
            False => match n.same(64) { True => Some(8), False => None } } } },
    }
}

fn Width::bits(self w: Width) → Nat { match w { WNat => 0, WBits(n) => n } }

// The shift that scales an index to an element of `size` bytes.
fn size_shift(size: Nat) → Nat { match size.same(1) { True => 0, False => match size.same(2) { True => 1, False => match size.same(4) { True => 2, False => 3 } } } }

// A code's word size, where it is a word with one.
fn Shape::word_size(self c: Shape) → Option<Nat> { match c { SWord(w) => w.size(), SNamed(_) => None } }

// The layout of a named code: a sequence of words (its element's size,
// and its windows' code where it has them), a record of words (its fields'
// codes, packed in order), or none in this fragment.
inductive Layout { LSeq(elem: Shape, size: Nat, win: Option<Shape>), LRecord(fields: List<Shape>), LNone }

fn Shape::layout(tys: Nat → Type, strs: Strs(tys), c: Shape) → Layout {
    match c {
        SWord(_) => LNone,
        SNamed(k) => match strs(k).kind {
            Opaque => LNone,
            Sequence(q) => match q.elem.word_size() { Some(s) => LSeq(q.elem, s, match q.win { Some(w) => Some(w.shape), None => None }), None => LNone },
            Record(fs) => match fs.all_bit(λ (f: Field(tys, tys(k))) => f.shape.word_size().is_some()) {
                True => LRecord(fs.map(λ (f: Field(tys, tys(k))) => f.shape)),
                False => LNone,
            },
        },
    }
}

// A field's offset: the sizes of the fields before it.
fn fields_offset(fs: List<Shape>, i: Nat) → Option<Nat> {
    match fs {
        Nil => None,
        Cons(f, rest) => match i {
            Zero => Some(0),
            Succ(j) => match f.word_size() { None => None, Some(s) => fields_offset(rest, j).map(λ o => s + o) },
        },
    }
}

fn fields_nth(fs: List<Shape>, i: Nat) → Option<Shape> { fs.nth(i) }

// ---------------------------------------------------------------------------
// The layout's law (docs/language/ownership-design.md §25.8, §19): what a
// structure owes the layout `Shape::layout` reads from it, stated in the
// model the run reads it through (`Dyn::at`, `Dyn::over`, `Dyn::fits`,
// `Dyn::len`). `StrsLaws` does not say the positional part: the library's
// lawful `Seq::list` reads only at a number and does not meet it (§25.8,
// F1), `Seq::words` and `Seq::vec` do.

fn el_sel(i: Ix) → Sel { OnSeq(SeqOne(i)) }

fn win_sel(lo, n: Ix) → Sel { OnSeq(SeqRun(lo, n)) }

// A sequence of words, read through the model: an element is of the
// element's code and read at the index's number; it fits only below the
// length; a write at one element is read back there and leaves the others;
// no write changes the length, and whether a selection fits reads only it.
record SeqLaid(tys: Nat → Type, strs: Strs(tys), c, el: Shape, size: Nat) {
    el_size: el.word_size() = Some(size),
    elem_code: (v: El(tys, c)) → (i: Ix) → (Dyn::at(tys, strs, el_sel(i), Dyn(c, v))).code = el,
    elem_num: (v: El(tys, c)) → (i, j: Ix) → i.toNat() = j.toNat() → Dyn::at(tys, strs, el_sel(i), Dyn(c, v)) = Dyn::at(tys, strs, el_sel(j), Dyn(c, v)),
    elem_fits: (v: El(tys, c)) → (i: Ix) → Dyn::fits(tys, strs, el_sel(i), Dyn(c, v)) = True → i.toNat() < Dyn::len(tys, strs, Dyn(c, v)),
    elem_put: (v: El(tys, c)) → (i: Ix) → Dyn::fits(tys, strs, el_sel(i), Dyn(c, v)) = True → (x: Dyn(tys)) → x.code = el →
        Dyn::at(tys, strs, el_sel(i), Dyn::over(tys, strs, el_sel(i), λ _ => x, Dyn(c, v))) = x,
    elem_other: (v: El(tys, c)) → (i, j: Ix) → ¬(i.toNat() = j.toNat()) → (g: Dyn(tys) → Dyn(tys)) →
        Dyn::at(tys, strs, el_sel(i), Dyn::over(tys, strs, el_sel(j), g, Dyn(c, v))) = Dyn::at(tys, strs, el_sel(i), Dyn(c, v)),
    len_over: (v: El(tys, c)) → (s: Sel) → (g: Dyn(tys) → Dyn(tys)) → Dyn::len(tys, strs, Dyn::over(tys, strs, s, g, Dyn(c, v))) = Dyn::len(tys, strs, Dyn(c, v)),
    fits_len: (v, u: El(tys, c)) → (s: Sel) → Dyn::len(tys, strs, Dyn(c, v)) = Dyn::len(tys, strs, Dyn(c, u)) →
        Dyn::fits(tys, strs, s, Dyn(c, v)) = Dyn::fits(tys, strs, s, Dyn(c, u)),
}

// Its windows, of code `w`: a sequence of the same element, inside the
// length, as long as it says, its elements its parent's from its start; a
// write of the window is read back there and leaves the elements outside it.
record WinLaid(tys: Nat → Type, strs: Strs(tys), c, el: Shape, size: Nat, w: Shape) {
    win_layout: Exists<Option<Shape>>(λ wc => Shape::layout(tys, strs, w) = LSeq(el, size, wc)),
    win_code: (v: El(tys, c)) → (lo, n: Ix) → (Dyn::at(tys, strs, win_sel(lo, n), Dyn(c, v))).code = w,
    win_fits: (v: El(tys, c)) → (lo, n: Ix) → Dyn::fits(tys, strs, win_sel(lo, n), Dyn(c, v)) = True → lo.toNat() + n.toNat() <= Dyn::len(tys, strs, Dyn(c, v)),
    win_len: (v: El(tys, c)) → (lo, n: Ix) → Dyn::fits(tys, strs, win_sel(lo, n), Dyn(c, v)) = True →
        Dyn::len(tys, strs, Dyn::at(tys, strs, win_sel(lo, n), Dyn(c, v))) = n.toNat(),
    win_elem: (v: El(tys, c)) → (lo, n: Ix) → Dyn::fits(tys, strs, win_sel(lo, n), Dyn(c, v)) = True → (i, j: Ix) → i.toNat() < n.toNat() →
        j.toNat() = lo.toNat() + i.toNat() → Dyn::at(tys, strs, el_sel(i), Dyn::at(tys, strs, win_sel(lo, n), Dyn(c, v))) = Dyn::at(tys, strs, el_sel(j), Dyn(c, v)),
    win_put: (v: El(tys, c)) → (lo, n: Ix) → Dyn::fits(tys, strs, win_sel(lo, n), Dyn(c, v)) = True → (x: Dyn(tys)) → x.code = w → Dyn::len(tys, strs, x) = n.toNat() →
        Dyn::at(tys, strs, win_sel(lo, n), Dyn::over(tys, strs, win_sel(lo, n), λ _ => x, Dyn(c, v))) = x,
    win_other: (v: El(tys, c)) → (lo, n, j: Ix) → (j.toNat() < lo.toNat()) ∨ (lo.toNat() + n.toNat() <= j.toNat()) → (g: Dyn(tys) → Dyn(tys)) →
        Dyn::at(tys, strs, el_sel(j), Dyn::over(tys, strs, win_sel(lo, n), g, Dyn(c, v))) = Dyn::at(tys, strs, el_sel(j), Dyn(c, v)),
}

// A record of words: its fields are lenses of their codes, apart, and fit.
record RecLaid(tys: Nat → Type, strs: Strs(tys), c: Shape, fs: List<Shape>) {
    field_sized: (i: Nat) → (f: Shape) → fs.nth(i) = Some(f) → f.word_size().is_some() = True,
    field_code: (v: El(tys, c)) → (i: Nat) → (f: Shape) → fs.nth(i) = Some(f) → (Dyn::at(tys, strs, OnField(i), Dyn(c, v))).code = f,
    field_fits: (v: El(tys, c)) → (i: Nat) → (f: Shape) → fs.nth(i) = Some(f) → Dyn::fits(tys, strs, OnField(i), Dyn(c, v)) = True,
    field_put: (v: El(tys, c)) → (i: Nat) → (f: Shape) → fs.nth(i) = Some(f) → (x: Dyn(tys)) → x.code = f →
        Dyn::at(tys, strs, OnField(i), Dyn::over(tys, strs, OnField(i), λ _ => x, Dyn(c, v))) = x,
    field_other: (v: El(tys, c)) → (i, j: Nat) → ¬(i = j) → (g: Dyn(tys) → Dyn(tys)) →
        Dyn::at(tys, strs, OnField(i), Dyn::over(tys, strs, OnField(j), g, Dyn(c, v))) = Dyn::at(tys, strs, OnField(i), Dyn(c, v)),
}

fn WinsLaid(tys: Nat → Type, strs: Strs(tys), c, el: Shape, size: Nat, wc: Option<Shape>) → Type {
    match wc { None => (v: El(tys, c)) → (lo, n: Ix) → Dyn::fits(tys, strs, win_sel(lo, n), Dyn(c, v)) = False, Some(w) => WinLaid(tys, strs, c, el, size, w) }
}

// The seam's premise on the structures: every code with a layout is laid
// out as `Dyn::encode` reads it.
fn Strs::Laid(tys: Nat → Type, strs: Strs(tys)) → Type {
    ((c, el: Shape) → (size: Nat) → (wc: Option<Shape>) → Shape::layout(tys, strs, c) = LSeq(el, size, wc) →
        SeqLaid(tys, strs, c, el, size) ∧ WinsLaid(tys, strs, c, el, size, wc)) ∧
    ((c: Shape) → (fs: List<Shape>) → Shape::layout(tys, strs, c) = LRecord(fs) → RecLaid(tys, strs, c, fs))
}

// What name `k`'s kind owes: a sequence its positional laws, a record of
// words its layout's law directly (not yet derived from `RecordLaws`).
fn KindNum(tys: Nat → Type, strs: Strs(tys), k: Nat, kd: Kind(tys, tys(k))) → Type {
    match kd {
        Opaque => True,
        Record(fs) => RecLaid(tys, strs, SNamed(k), fs.map(λ (f: Field(tys, tys(k))) => f.shape)),
        Sequence(q) => SeqNum(tys, tys(k), q) ∧ WinsNum(tys, k, q, q.win),
    }
}

// A name's layout, by its kind: `Shape::layout` at `SNamed(k)`.
fn Kind::layout_of(tys: Nat → Type, k: Nat, kd: Kind(tys, tys(k))) → Layout {
    match kd {
        Opaque => LNone,
        Sequence(q) => match q.elem.word_size() { Some(s) => LSeq(q.elem, s, match q.win { Some(w) => Some(w.shape), None => None }), None => LNone },
        Record(fs) => match fs.all_bit(λ (f: Field(tys, tys(k))) => f.shape.word_size().is_some()) {
            True => LRecord(fs.map(λ (f: Field(tys, tys(k))) => f.shape)),
            False => LNone,
        },
    }
}

// ---------------------------------------------------------------------------
// Slots

// A variable's slots: its code and its ids.
record PSlot { code: Shape, ids: List<Typed> }

// The environment by level: the arguments, then the locals as bound.
record PEnv { na: Nat, vars: List<PSlot> }

fn PEnv::level(self e: PEnv, v: Var) → Option<Nat> {
    match v {
        Arg(i) => match (i + 1).leb(e.na) { True => Some(i), False => None },
        Loc(j) => match (e.na + j + 1).leb(e.vars.len()) { True => Some(e.vars.len() - 1 - j), False => None },
    }
}

fn PEnv::get(self e: PEnv, v: Var) → Option<PSlot> { e.level(v).and_then(λ l => e.vars.nth(l)) }

// The slot at a level replaced.
fn PEnv::set(self e: PEnv, l: Nat, s: PSlot) → PEnv { PEnv(e.na, e.vars.update(l, λ _ => s)) }

fn PEnv::push(self e: PEnv, s: PSlot) → PEnv { PEnv(e.na, e.vars ++ [s]) }

fn PEnv::push_all(self e: PEnv, ss: List<PSlot>) → PEnv { match ss { Nil => e, Cons(s, rest) => e.push(s).push_all(rest) } }

// A fresh slot of a code: a word one id, a sequence by reference two.
record Ids { ids: List<Typed>, next: Nat }

fn PSlot::fresh(tys: Nat → Type, strs: Strs(tys), c: Shape, next: Nat) → Option<Ids> {
    match c.word_size() {
        Some(_) => Some(Ids([word_id(next)], next + 1)),
        None => match Shape::layout(tys, strs, c) {
            LSeq(_, _, _) => Some(Ids([ref_id(next), word_id(next + 1)], next + 2)),
            LRecord(_) => Some(Ids([ref_id(next)], next + 1)),
            LNone => None,
        },
    }
}

fn PSlot::fresh_all(tys: Nat → Type, strs: Strs(tys), cs: List<Shape>, next: Nat) → Option<Ids> {
    match cs {
        Nil => Some(Ids(Nil, next)),
        Cons(c, rest) => match PSlot::fresh(tys, strs, c, next) {
            None => None,
            Some(a) => PSlot::fresh_all(tys, strs, rest, a.next).map(λ b => Ids(a.ids ++ b.ids, b.next)),
        },
    }
}

// The slots of codes, one per code, over fresh ids.
// The parameters' slots: a store may go through one lent to write or
// given.
fn PSlot::many(tys: Nat → Type, strs: Strs(tys), cs: List<Param>, next: Nat) → Option<Pair<List<PSlot>, Nat>> {
    match cs {
        Nil => Some(Pair(Nil, next)),
        Cons(c, rest) => match PSlot::fresh(tys, strs, c.code, next) {
            None => None,
            Some(a) => PSlot::many(tys, strs, rest, a.next).map(λ b => Pair(Cons(PSlot(c.code, a.ids), b.fst), b.snd)),
        },
    }
}

fn PSlot::ids_of(ss: List<PSlot>) → List<Typed> { match ss { Nil => Nil, Cons(s, rest) => s.ids ++ PSlot::ids_of(rest) } }

fn PSlot::word(self s: PSlot) → Option<Typed> { match s.ids { Cons(t, rest) => match rest { Nil => match t.kind { WordKind => Some(t), RefKind => None }, Cons(_, _) => None }, Nil => None } }

fn PSlot::reference(self s: PSlot) → Option<Typed> { match s.ids { Cons(t, _) => match t.kind { RefKind => Some(t), WordKind => None }, Nil => None } }

// ---------------------------------------------------------------------------
// Code for places

// What a walk leaves: the code, the reference and (for a sequence) its
// length word, the code reached, the next id.
record Walk { instrs: List<Instr>, place: Nat, len: Option<Nat>, code: Shape, next: Nat }

// An atom's word id: a literal is a constant, a variable its word.
record Word1 { instrs: List<Instr>, id: Nat, next: Nat }

fn PEnv::atom(self e: PEnv, a: Atom, next: Nat) → Option<Word1> {
    match a {
        Lit(n) => Some(Word1([Compute(Const(64, next, n))], next, next + 1)),
        Var(w) => {
            let v = match (w + 1).leb(e.na) { True => Arg(w), False => Loc(w - e.na) };
            match e.get(v) {
                None => None,
                // A narrow word is held zero-extended: its 64-bit view is its value.
                Some(s) => match s.code { SWord(wd) => match wd.size() { Some(_) => s.word().map(λ t => Word1(Nil, t.id, next)), None => None }, SNamed(_) => None },
            }
        },
    }
}

// An index scaled to bytes.
fn scaled(i: Word1, size: Nat) → Word1 {
    match size.same(1) {
        True => i,
        False => Word1(i.instrs ++ [Compute(Const(64, i.next, size_shift(size))), Compute(ShiftLeft(64, i.next + 1, i.id, i.next))], i.next + 1, i.next + 2),
    }
}

fn PEnv::walk(tys: Nat → Type, strs: Strs(tys), self e: PEnv, xs: List<Step>, at: Walk) → Option<Walk> {
    match xs {
        Nil => Some(at),
        Cons(x, rest) => match x {
            SElem(a) => match Shape::layout(tys, strs, at.code) {
                LSeq(el, size, _) => match e.atom(a, at.next) {
                    None => None,
                    Some(i) => {
                        let s = scaled(i, size);
                        e.walk(tys, strs, rest, Walk(at.instrs ++ s.instrs ++ [bytes_level::Offset(s.next, at.place, s.id)], s.next, None, el, s.next + 1))
                    },
                },
                _ => None,
            },
            SWindow(lo, n) => match Shape::layout(tys, strs, at.code) {
                LSeq(_, size, win) => match win {
                    None => None,
                    Some(wc) => match e.atom(lo, at.next) {
                        None => None,
                        Some(l) => match e.atom(n, l.next) {
                            None => None,
                            Some(k) => {
                                let s = scaled(Word1(l.instrs ++ k.instrs, l.id, k.next), size);
                                e.walk(tys, strs, rest, Walk(at.instrs ++ s.instrs ++ [bytes_level::Offset(s.next, at.place, s.id)], s.next, Some(k.id), wc, s.next + 1))
                            },
                        },
                    },
                },
                _ => None,
            },
            SField(i) => match Shape::layout(tys, strs, at.code) {
                LRecord(fs) => match fields_offset(fs, i) {
                    None => None,
                    Some(off) => match fields_nth(fs, i) {
                        None => None,
                        Some(fc) => e.walk(tys, strs, rest,
                            Walk(at.instrs ++ [Compute(Const(64, at.next, off)), bytes_level::Offset(at.next + 1, at.place, at.next)], at.next + 1, None, fc, at.next + 2)),
                    },
                },
                _ => None,
            },
            SKey(_, _) => None,
            SVariant(_) => None,
        },
    }
}

// A place's code, from a root that holds a reference.
fn PEnv::locate(tys: Nat → Type, strs: Strs(tys), self e: PEnv, p: Place, next: Nat) → Option<Walk> {
    match e.get(p.root) {
        None => None,
        Some(s) => match s.reference() {
            None => None,
            Some(r) => {
                let len: Option<Nat> = match s.ids { Cons(_, rest) => match rest { Cons(l, _) => Some(l.id), Nil => None }, Nil => None };
                e.walk(tys, strs, p.steps, Walk(Nil, r.id, len, s.code, next))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Statements

fn Prim::node(self op: Prim, width, out, a, b: Nat) → Option<Node> {
    match op { PAdd => Some(Add(width, out, a, b)), PSub => Some(Sub(width, out, a, b)), PMul => None }
}

// What a statement leaves: its code (a region, since a call is one), the
// environment after, the next id.
record SOut { code: bytes_level::Body, env: PEnv, next: Nat }

record PCx(tys: Nat → Type) { strs: Strs(tys), sigs: Nat → Sig, prim: Nat → Bool }

fn leaf(instrs: List<Instr>) → bytes_level::Body { Leaf(instrs) }

// A call's arguments, by the callee's parameters: a word its id, a sequence
// lent to read or write its two slots; a taken object is refused.
fn PEnv::call_args(self e: PEnv, ps: List<Param>, xs: List<Var>) → Option<List<Typed>> {
    match ps {
        Nil => match xs { Nil => Some(Nil), Cons(_, _) => None },
        Cons(p, pr) => match xs {
            Nil => None,
            Cons(x, xr) => match e.get(x) {
                None => None,
                // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
                Some(s) => match !s.code.same(p.code) { True => None, False => match p.code.word_size() {
                    Some(_) => match s.word() { None => None, Some(t) => e.call_args(pr, xr).map(λ rest => Cons(t, rest)) },
                    None => match p.mode {
                        ByTake => None,
                        ByRead => e.call_args(pr, xr).map(λ rest => s.ids ++ rest),
                        ByWrite => e.call_args(pr, xr).map(λ rest => s.ids ++ rest),
                    },
                } },
            },
        },
    }
}

// A callee's results' slots: a word fresh (made or a taken word answered
// back), a returned view fresh (its reference and length come back); a
// fresh object, or an object answered back, refused.
fn Result::slots(tys: Nat → Type, strs: Strs(tys), rs: List<Result>, next: Nat) → Option<Pair<List<PSlot>, Nat>> {
    match rs {
        Nil => Some(Pair(Nil, next)),
        Cons(r, rest) => match r.origin {
            OFresh => match r.code.word_size() {
                None => None,
                Some(_) => Result::slots(tys, strs, rest, next + 1).map(λ b => Pair(Cons(PSlot(r.code, [word_id(next)]), b.fst), b.snd)),
            },
            // A taken word answered back is a word the routine returns.
            OParam(_) => match r.code.word_size() {
                None => None,
                Some(_) => Result::slots(tys, strs, rest, next + 1).map(λ b => Pair(Cons(PSlot(r.code, [word_id(next)]), b.fst), b.snd)),
            },
            OView(_, _) => match PSlot::fresh(tys, strs, r.code, next) {
                None => None,
                Some(a) => Result::slots(tys, strs, rest, a.next).map(λ b => Pair(Cons(PSlot(r.code, a.ids), b.fst), b.snd)),
            },
        },
    }
}

// The written parameters' slots after a call: a word fresh (returned), a
// sequence the argument's own slots (not returned: §25).
fn PEnv::written_slots(self e: PEnv, ps: List<Param>, xs: List<Var>, is: List<Nat>, next: Nat) → Option<Pair<List<PSlot>, Nat>> {
    match is {
        Nil => Some(Pair(Nil, next)),
        Cons(i, rest) => match ps.nth(i) {
            None => None,
            Some(p) => match xs.nth(i) {
                None => None,
                Some(x) => match p.code.word_size() {
                    Some(_) => e.written_slots(ps, xs, rest, next + 1).map(λ b => Pair(Cons(PSlot(p.code, [word_id(next)]), b.fst), b.snd)),
                    None => match e.get(x) {
                        None => None,
                        Some(s) => e.written_slots(ps, xs, rest, next).map(λ b => Pair(Cons(s, b.fst), b.snd)),
                    },
                },
            },
        },
    }
}

// The ids a call binds: its results' slots, then the written words.
fn PSlot::returned(ss: List<PSlot>, ws: List<PSlot>) → List<Typed> { PSlot::ids_of(ss) ++ PSlot::ids_of(ws.filter(λ s => s.code.word_size().is_some())) }

// A read of a word place: a word variable is its own slot (a copy), a
// place through a reference a load of the element's size.
fn PEnv::read_place(tys: Nat → Type, strs: Strs(tys), self e: PEnv, p: Place, next: Nat) → Option<SOut> {
    match p.steps {
        Nil => match e.get(p.root) { None => None, Some(s) => match s.word() { None => None, Some(_) => Some(SOut(leaf(Nil), e.push(PSlot(s.code, s.ids)), next)) } },
        Cons(_, _) => match e.locate(tys, strs, p, next) {
            None => None,
            Some(at) => match at.code.word_size() {
                None => None,
                Some(size) => Some(SOut(leaf(at.instrs ++ [bytes_level::Load(size, 64, at.next, at.place)]), e.push(PSlot(at.code, [word_id(at.next)])), at.next + 1)),
            },
        },
    }
}

// A word written at a place: a word variable whole, its slot rebound to the
// value's; a place through a reference, a store of the element's size. A
// sequence written is a typed copy: refused.
fn PEnv::write_word(tys: Nat → Type, strs: Strs(tys), self e: PEnv, p: Place, sv: PSlot, next: Nat) → Option<SOut> {
    match sv.word() {
        None => None,
        Some(tv) => match p.steps {
            Nil => match e.level(p.root) {
                None => None,
                Some(l) => match e.get(p.root) { None => None, Some(sr) => match sr.word() { None => None, Some(_) => Some(SOut(leaf(Nil), e.set(l, sv), next)) } },
            },
            Cons(_, _) => match e.locate(tys, strs, p, next) {
                None => None,
                // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
                // Level 2 stores only a value of the element's code.
                Some(at) => match at.code.word_size() {
                    None => None,
                    Some(size) => match sv.code.same(at.code) {
                        False => None,
                        True => Some(SOut(leaf(at.instrs ++ [bytes_level::Store(size, 64, at.place, tv.id)]), e, at.next)),
                    },
                },
            },
        },
    }
}

fn Stmt::place(self st: Stmt, tys: Nat → Type, cx: PCx(tys), e: PEnv, next: Nat) → Option<SOut> {
    let strs = cx.strs;
    match st {
        Op(op, a, b) => match e.get(a) {
            None => None,
            Some(sa) => match e.get(b) {
                None => None,
                Some(sb) => match sa.code {
                    SNamed(_) => None,
                    SWord(w) => match sa.word() {
                        None => None,
                        Some(ta) => match sb.word() {
                            None => None,
                            // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
                            // Level 2 reads the second at the first's code.
                            Some(tb) => match !sb.code.same(sa.code) { True => None, False => match op.node(w.bits(), next, ta.id, tb.id) {
                                None => None,
                                Some(nd) => match w.size() {
                                    // Narrow arithmetic would leave a word not
                                    // zero above its width: refused here.
                                    Some(size) => match size.same(8) {
                                        False => None,
                                        True => Some(SOut(leaf([Compute(nd)]), e.push(PSlot(SWord(w), [word_id(next)])), next + 1)),
                                    },
                                    None => None,
                                },
                            } },
                        },
                    },
                },
            },
        },
        Stmt::Lit(w, n) => match w.size() {
            None => None,
            Some(_) => Some(SOut(leaf([Compute(Const(64, next, n % Nat::pow(2, w.bits())))]), e.push(PSlot(SWord(w), [word_id(next)])), next + 1)),
        },
        Stmt::Read(p) => e.read_place(tys, strs, p, next),
        Stmt::Write(p, v) => match e.get(v) { None => None, Some(sv) => e.write_word(tys, strs, p, sv, next) },
        // A write-back: nothing where the view refers, a store of a word copy.
        Stmt::Back(p, v) => match e.get(v) {
            None => None,
            Some(sv) => match sv.word() {
                Some(_) => e.write_word(tys, strs, p, sv, next),
                None => match sv.reference() { Some(_) => Some(SOut(leaf(Nil), e, next)), None => None },
            },
        },
        // The length word the place's slot carries, at 64 bits.
        Stmt::Len(p, w) => match w {
            WNat => None,
            WBits(b) => match b.same(64) {
                False => None,
                True => match e.locate(tys, strs, p, next) {
                    None => None,
                    Some(at) => match at.len { None => None, Some(len) => Some(SOut(leaf(at.instrs), e.push(PSlot(SWord(w), [word_id(len)])), at.next)) },
                },
            },
        },
        View(p, _) => match e.locate(tys, strs, p, next) {
            None => None,
            Some(at) => match Shape::layout(tys, strs, at.code) {
                LSeq(_, _, _) => match at.len {
                    None => None,
                    Some(len) => Some(SOut(leaf(at.instrs), e.push(PSlot(at.code, [ref_id(at.place), word_id(len)])), at.next)),
                },
                _ => None,
            },
        },
        Take(p) => match p.steps {
            Nil => match e.get(p.root) { None => None, Some(s) => Some(SOut(leaf(Nil), e.push(s), next)) },
            Cons(_, _) => e.read_place(tys, strs, p, next),
        },
        Stmt::Fresh(_, _, _) => None,
        Stmt::Call(g, args, n) => match cx.prim(g) {
            True => None,
            False => {
                let sg = cx.sigs(g);
                match e.call_args(sg.params, args) {
                    None => None,
                    Some(passed) => match Result::slots(tys, strs, sg.results, next) {
                        None => None,
                        Some(rs) => match e.written_slots(sg.params, args, sg.written(), rs.snd) {
                            None => None,
                            Some(ws) => match n.same(rs.fst.len() + ws.fst.len()) {
                                False => None,
                                True => Some(SOut(bytes_level::Call(g, passed, PSlot::returned(rs.fst, ws.fst)), e.push_all(rs.fst ++ ws.fst), ws.snd)),
                            },
                        },
                    },
                }
            },
        },
        Death(_) => Some(SOut(leaf(Nil), e, next)),
    }
}

// ---------------------------------------------------------------------------
// Bodies

// A copy of a value into a fixed id: a word moved, a reference offset by a
// zero word.
fn copy_into(dst, src: Typed, zero: Nat) → Instr {
    match dst.kind { WordKind => Compute(Move(64, dst.id, src.id)), RefKind => bytes_level::Offset(dst.id, src.id, zero) }
}

fn copies(dsts, srcs: List<Typed>, zero: Nat) → Option<List<Instr>> {
    match dsts {
        Nil => match srcs { Nil => Some(Nil), Cons(_, _) => None },
        Cons(d, dr) => match srcs {
            Nil => None,
            Cons(s, sr) => match d.kind.same(s.kind) { False => None, True => copies(dr, sr, zero).map(λ rest => Cons(copy_into(d, s, zero), rest)) },
        },
    }
}

// How a path leaves the routine: into its result ids, or (a loop's pass)
// into the next state with the exit flag, a word one where the loop ends.
inductive Leave { TRet(results: List<Typed>), TLoop(params: List<Typed>, results: List<Typed>, next: List<Typed>, flag: Nat) }

fn shapes_same(xs, ys: List<Shape>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, xr) => match ys { Nil => False, Cons(b, yr) => a.same(b) && shapes_same(xr, yr) } }
}

fn PSlot::codes(ss: List<PSlot>) → List<Shape> { ss.map(λ (s: PSlot) => s.code) }

// The codes a `Ret` answers at: the results', then the written parameters'.
fn Sig::ret_codes(self s: Sig) → List<Shape> { s.results.map(λ r => r.code) ++ s.written().map(λ i => s.params.nth(i).map(λ p => p.code).unwrap_or(SWord(WNat))) }

// A `Ret`'s values as the routine answers them: the results' slots, then
// each written word (a written sequence is the argument itself).
fn ret_values(rs: List<PSlot>, nres: Nat) → List<Typed> {
    PSlot::ids_of(rs.take(nres)) ++ PSlot::ids_of(rs.drop(nres).filter(λ s => s.code.word_size().is_some()))
}

fn PEnv::gets(self e: PEnv, xs: List<Var>) → Option<List<PSlot>> {
    match xs { Nil => Some(Nil), Cons(x, rest) => e.get(x).and_then(λ s => e.gets(rest).map(λ ss => Cons(s, ss))) }
}

fn zeros(ts: List<Typed>) → Option<List<Instr>> {
    match ts {
        Nil => Some(Nil),
        Cons(t, rest) => match t.kind { WordKind => zeros(rest).map(λ is => Cons(Compute(Const(64, t.id, 0)), is)), RefKind => None },
    }
}

// The zero word a reference's copy adds, where a reference is copied.
fn zero_for(dsts: List<Typed>, next: Nat) → List<Instr> { match dsts.any_bit(λ (t: Typed) => !t.kind.same(WordKind)) { True => [Compute(Const(64, next, 0))], False => Nil } }

fn Leave::ret(self t: Leave, vals: List<Typed>, next: Nat) → Option<bytes_level::Body> {
    match t {
        TRet(res) => copies(res, vals, next).map(λ is => leaf(zero_for(res, next) ++ is)),
        // The results first: a parameter's copy is to its own state
        // register, after which the register holds the next state's id.
        TLoop(ps, res, nx, exit) => match copies(nx.drop(ps.len()), match res { Nil => Nil, Cons(_, _) => vals }, next) {
            None => None,
            Some(rs) => copies(nx.take(ps.len()), ps, next).map(λ is => leaf(zero_for(nx, next) ++ rs ++ is ++ [Compute(Const(64, exit, 1))])),
        },
    }
}

fn Leave::jump(self t: Leave, vals: List<Typed>, next: Nat) → Option<bytes_level::Body> {
    match t {
        TRet(_) => None,
        TLoop(ps, res, nx, exit) => match copies(nx.take(ps.len()), vals, next) {
            None => None,
            Some(is) => zeros(nx.drop(ps.len())).map(λ zs => leaf(zero_for(nx.take(ps.len()), next) ++ is ++ zs ++ [Compute(Const(64, exit, 0))])),
        },
    }
}

fn Typed::same(self a, b: Typed) → Bool { a.id.same(b.id) && a.kind.same(b.kind) }

fn Typed::all_same(xs, ys: List<Typed>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, xr) => match ys { Nil => False, Cons(b, yr) => a.same(b) && Typed::all_same(xr, yr) } }
}

// What follows a join, and the environment it starts from.
// What a `Yield` reaches: a join whose arm leaves, with what follows it,
// copied into the arm (`JCopy`); or a join both of whose arms yield, its
// outputs bound in each arm at one set of ids (`JShare`: the ids once the
// first arm has bound them) and what follows placed once after it.
inductive JFrame { JCopy(rest: body::Body, env: PEnv), JShare(env: PEnv, outs: Option<List<PSlot>>) }

// A body's code, the next id, and the frames as it leaves them (a shared
// join's outputs fixed by the first `Yield` that reached it).
record BOut { code: bytes_level::Body, next: Nat, frames: List<JFrame> }

// A comparison of two words at the first's width: its one-bit word at
// `next`, and whether the arms swap (`a <= b` is `!(b < a)`).
fn PEnv::less(self e: PEnv, a, b: Var, swap: Bool, next: Nat) → Option<Pair<List<Instr>, Bool>> {
    match e.get(a) {
        None => None,
        Some(sa) => match e.get(b) {
            None => None,
            Some(sb) => match sa.code {
                SNamed(_) => None,
                SWord(w) => match sa.word() {
                    None => None,
                    Some(ta) => match sb.word() {
                        None => None,
                        // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
                        Some(tb) => match sb.code.same(sa.code) { False => None, True => Some(Pair([Compute(UnsignedLessThan(64, next, ta.id, tb.id))], swap)) },
                    },
                },
            },
        },
    }
}

fn Test::place(self t: Test, e: PEnv, next: Nat) → Option<Pair<List<Instr>, Bool>> {
    match t { TLt(a, b) => e.less(a, b, False, next), TLe(a, b) => e.less(b, a, True, next) }
}

// A body's code, at a fuel that bounds the copies of what follows a join.
// Fresh slots of the codes of `ss`, for a shared join's outputs.
fn PSlot::fresh_like(tys: Nat → Type, strs: Strs(tys), ss: List<PSlot>, next: Nat) → Option<Pair<List<PSlot>, Nat>> {
    match ss {
        Nil => Some(Pair(Nil, next)),
        Cons(s, rest) => match PSlot::fresh(tys, strs, s.code, next) {
            None => None,
            Some(a) => PSlot::fresh_like(tys, strs, rest, a.next).map(λ b => Pair(Cons(PSlot(s.code, a.ids), b.fst), b.snd)),
        },
    }
}

// The outputs `ss` copied into a shared join's ids (fresh where no arm has
// bound them yet): the leaf, the ids, the next id.
fn share(tys: Nat → Type, strs: Strs(tys), outs: Option<List<PSlot>>, ss: List<PSlot>, next: Nat) → Option<Pair<bytes_level::Body, Pair<List<PSlot>, Nat>>> {
    let zero = next;
    let target: Option<Pair<List<PSlot>, Nat>> = match outs {
        // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
        // The second arm's outputs of the first's codes.
        Some(ts) => match shapes_same(PSlot::codes(ss), PSlot::codes(ts)) {
            False => None,
            True => Some(Pair(ts, next + 1)),
        },
        None => PSlot::fresh_like(tys, strs, ss, next + 1),
    };
    match target {
        None => None,
        Some(t) => copies(PSlot::ids_of(t.fst), PSlot::ids_of(ss), zero).map(λ is => Pair(leaf(zero_for(PSlot::ids_of(t.fst), zero) ++ is), Pair(t.fst, t.snd))),
    }
}

fn body_exits(b: body::Body) → Bool {
    match b { Ret(_) => True, Yield(_) => False, Jump(_) => True, Do(_, rest) => body_exits(rest), Join(_, y, n, rest) => body_exits(y) || body_exits(n) || body_exits(rest) }
}

// A body's code, at a fuel that bounds the copies of what follows a join
// whose arm leaves.
fn place_go(fuel: Nat, b: body::Body, tys: Nat → Type, cx: PCx(tys), sig: Sig, tail: Leave, frames: List<JFrame>, e: PEnv, next: Nat) → Option<BOut> {
    match fuel {
        Zero => None,
        Succ(f) => match b {
            // Interim (§25.8, F4): goes when the run is stuck at a code mismatch.
            // A `Ret`'s values at the codes it answers, a `Jump`'s at the
            // parameters'.
            Ret(rs) => match e.gets(rs) {
                None => None,
                Some(ss) => match shapes_same(PSlot::codes(ss), sig.ret_codes()) {
                    False => None,
                    True => tail.ret(ret_values(ss, sig.results.len()), next).map(λ c => BOut(c, next + 1, frames)),
                },
            },
            Jump(xs) => match e.gets(xs) {
                None => None,
                Some(ss) => match shapes_same(PSlot::codes(ss), sig.params.map(λ p => p.code)) { False => None, True => tail.jump(PSlot::ids_of(ss), next).map(λ c => BOut(c, next + 1, frames)) },
            },
            Yield(os) => match frames {
                Nil => None,
                Cons(fr, outer) => match e.gets(os) {
                    None => None,
                    Some(ss) => match fr {
                        // What follows, placed here; the join's frame stays for the
                        // join to pop, over the outer frames as it left them.
                        JCopy(rest, env) => place_go(f, rest, tys, cx, sig, tail, outer, env.push_all(ss), next).map(λ r => BOut(r.code, r.next, Cons(fr, r.frames))),
                        JShare(env, outs) => share(tys, cx.strs, outs, ss, next).map(λ sh => BOut(sh.fst, sh.snd.snd, Cons(JShare(env, Some(sh.snd.fst)), outer))),
                    },
                },
            },
            Do(s, rest) => match s.place(tys, cx, e, next) {
                None => None,
                Some(o) => place_go(f, rest, tys, cx, sig, tail, frames, o.env, o.next).map(λ r => BOut(bytes_level::Seq(o.code, r.code), r.next, r.frames)),
            },
            Join(t, yes, no, rest) => match t.place(e, next) {
                None => None,
                Some(tested) => {
                    let branch = λ (y: bytes_level::Body) (n: bytes_level::Body) => bytes_level::Seq(leaf(tested.fst), match tested.snd { False => Branch(next, y, n), True => Branch(next, n, y) });
                    match body_exits(yes) || body_exits(no) {
                        // An arm leaves: what follows is copied into each arm.
                        True => match place_go(f, yes, tys, cx, sig, tail, Cons(JCopy(rest, e), frames), e, next + 1) {
                            None => None,
                            Some(y) => match y.frames {
                                Nil => None,
                                Cons(_, fy) => place_go(f, no, tys, cx, sig, tail, Cons(JCopy(rest, e), fy), e, y.next).and_then(λ n => match n.frames {
                                    Nil => None,
                                    Cons(_, fn2) => Some(BOut(branch(y.code, n.code), n.next, fn2)),
                                }),
                            },
                        },
                        // Both arms yield: the outputs at one set of ids,
                        // what follows once after the branch.
                        False => match place_go(f, yes, tys, cx, sig, tail, Cons(JShare(e, None), frames), e, next + 1) {
                            None => None,
                            Some(y) => match y.frames {
                                Nil => None,
                                Cons(fry, fy) => match fry {
                                    JCopy(_, _) => None,
                                    JShare(_, oy) => match place_go(f, no, tys, cx, sig, tail, Cons(JShare(e, oy), fy), e, y.next) {
                                        None => None,
                                        Some(n) => match n.frames {
                                            Nil => None,
                                            Cons(frn, fn2) => match frn {
                                                JCopy(_, _) => None,
                                                JShare(_, on) => match on {
                                                    None => None,
                                                    Some(outs) => place_go(f, rest, tys, cx, sig, tail, fn2, e.push_all(outs), n.next).map(λ r =>
                                                        BOut(bytes_level::Seq(branch(y.code, n.code), r.code), r.next, r.frames)),
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        },
                    }
                },
            },
        },
    }
}

fn body_size(b: body::Body) → Nat {
    match b { Ret(_) => 1, Yield(_) => 1, Jump(_) => 1, Do(_, rest) => body_size(rest) + 1, Join(_, y, n, rest) => body_size(y) + body_size(n) + body_size(rest) + 1 }
}

fn body_jumps(b: body::Body) → Bool {
    match b { Ret(_) => False, Yield(_) => False, Jump(_) => True, Do(_, rest) => body_jumps(rest), Join(_, y, n, rest) => body_jumps(y) || body_jumps(n) || body_jumps(rest) }
}

// The codes a routine answers: its results', then its written words'.
fn Sig::placed_codes(self s: Sig) → List<Shape> {
    s.results.map(λ r => r.code) ++ s.written().map(λ i => s.params.nth(i).map(λ p => p.code).unwrap_or(SWord(WNat))).filter(λ c => c.word_size().is_some())
}

// Where every `Ret` answers, as its results, parameters themselves at the
// same positions: those positions. A loop whose answers are its state
// needs no results in its state.
fn arg_of(v: Var) → Option<Nat> { match v { Arg(i) => Some(i), Loc(_) => None } }

fn args_of(vs: List<Var>) → Option<List<Nat>> {
    match vs { Nil => Some(Nil), Cons(v, rest) => match arg_of(v) { None => None, Some(i) => args_of(rest).map(λ is => Cons(i, is)) } }
}

fn nats_eqb(xs, ys: List<Nat>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, xr) => match ys { Nil => False, Cons(b, yr) => a.same(b) && nats_eqb(xr, yr) } }
}

fn agree_rets(a, b: Option<Option<List<Nat>>>) → Option<Option<List<Nat>>> {
    match a {
        None => b,
        Some(x) => match b {
            None => a,
            Some(y) => match x { None => Some(None), Some(xs) => match y { None => Some(None), Some(ys) => match nats_eqb(xs, ys) { True => a, False => Some(None) } } },
        },
    }
}

// `None`: no `Ret`; `Some(None)`: some `Ret` answers another value.
fn rets_args(b: body::Body, nres: Nat) → Option<Option<List<Nat>>> {
    match b {
        Ret(rs) => Some(args_of(rs.take(nres))),
        Yield(_) => None,
        Jump(_) => None,
        Do(_, rest) => rets_args(rest, nres),
        Join(_, y, n, rest) => agree_rets(agree_rets(rets_args(y, nres), rets_args(n, nres)), rets_args(rest, nres)),
    }
}

// The ids of the parameters at positions `is` among slots.
fn PSlot::at(ss: List<PSlot>, is: List<Nat>) → Option<List<Typed>> {
    match is { Nil => Some(Nil), Cons(i, rest) => match ss.nth(i) { None => None, Some(s) => PSlot::at(ss, rest).map(λ ts => s.ids ++ ts) } }
}

// A function as a routine.
fn Func::place(self f: Func, tys: Nat → Type, cx: PCx(tys)) → Option<Routine> {
    let strs = cx.strs;
    let fuel = body_size(f.body) * body_size(f.body) + 1;
    match PSlot::many(tys, strs, f.sig.params, 0) {
        None => None,
        Some(ps) => {
            let pids = PSlot::ids_of(ps.fst);
            match PSlot::fresh_all(tys, strs, f.sig.placed_codes(), ps.snd) {
                None => None,
                Some(rs) => match body_jumps(f.body) {
                    False => place_go(fuel, f.body, tys, cx, f.sig, TRet(rs.ids), Nil, PEnv(f.sig.params.len(), ps.fst), rs.next)
                        .map(λ o => Routine(pids, o.code, rs.ids)),
                    // The loop: inputs the parameters and zero results; a
                    // pass from its own parameters; the next state; the
                    // outputs, whose results part the routine answers.
                    True => {
                        // The state's results part: none where every `Ret`
                        // answers parameters (the answer is then read from
                        // the outputs at their positions), else the codes
                        // the routine answers, zero to start.
                        let kept: Option<List<Nat>> = match rets_args(f.body, f.sig.results.len()) {
                            Some(o) => match f.sig.placed_codes().len().same(f.sig.results.len()) { True => o, False => None },
                            None => None,
                        };
                        let rcodes = match kept { Some(_) => Nil, None => f.sig.placed_codes() };
                        match PSlot::fresh_all(tys, strs, rcodes, ps.snd) {
                            None => None,
                            Some(zr) => match zeros(zr.ids) {
                                None => None,
                                Some(zs) => match PSlot::many(tys, strs, f.sig.params, zr.next) {
                                    None => None,
                                    Some(qs) => match PSlot::fresh_all(tys, strs, rcodes, qs.snd) {
                                        None => None,
                                        Some(qr) => match PSlot::fresh_all(tys, strs, f.sig.params.map(λ p => p.code) ++ rcodes, qr.next) {
                                            None => None,
                                            // The flag at `nx.next`; the exit bit, the
                                            // flag's comparison with one after every
                                            // path, past it.
                                            Some(nx) => match PSlot::many(tys, strs, f.sig.params, nx.next + 3) {
                                                None => None,
                                                Some(op) => match PSlot::fresh_all(tys, strs, rcodes, op.snd) {
                                                    None => None,
                                                    Some(orr) => {
                                                        let qids = PSlot::ids_of(qs.fst);
                                                        let outs = PSlot::ids_of(op.fst) ++ orr.ids;
                                                        let answer = match kept { Some(ks) => PSlot::at(op.fst, ks), None => Some(orr.ids) };
                                                        let tail = TLoop(qids, qr.ids, nx.ids, nx.next);
                                                        let test = leaf([Compute(Const(64, nx.next + 1, 1)), Compute(Equal(64, nx.next + 2, nx.next, nx.next + 1))]);
                                                        match answer {
                                                            None => None,
                                                            Some(res) => place_go(fuel, f.body, tys, cx, f.sig, tail, Nil, PEnv(f.sig.params.len(), qs.fst), orr.next).map(λ o =>
                                                                Routine(pids,
                                                                    bytes_level::Seq(leaf(zs), bytes_level::Loop(pids ++ zr.ids, qids ++ qr.ids, bytes_level::Seq(o.code, test), nx.next + 2, nx.ids, outs)),
                                                                    res)),
                                                        }
                                                    },
                                                },
                                            },
                                        },
                                    },
                                },
                            },
                        }
                    },
                },
            }
        },
    }
}

// A program: each function a routine, by its index.
fn place_all(tys: Nat → Type, cx: PCx(tys), fs: List<Func>) → Option<List<Routine>> {
    match fs { Nil => Some(Nil), Cons(f, rest) => f.place(tys, cx).and_then(λ r => place_all(tys, cx, rest).map(λ rs => Cons(r, rs))) }
}

fn place(tys: Nat → Type, strs: Strs(tys), prim: Nat → Bool, fs: List<Func>) → Option<Program> {
    place_all(tys, PCx(strs, λ g => (fs.nth(g).unwrap_or(Func(Sig(Nil, Nil), Ret(Nil)))).sig, prim), fs).map(λ rs => Program(rs))
}

// The ownership checker over a function and the functions it calls: write
// views held across statements, read views, calls that lend a write view or
// answer a read view, and the once-theorem over all of them
// (docs/language/ownership-design.md §15.3, §15.6;
// issues/ownership-checker-call-and-write-view.md,
// issues/ownership-checker-loans-and-joins.md).
//
// A function takes one list parameter, to read or to write (its `Mode`),
// and words, and answers a word or a read view of its parameter. The
// parameter is a place, the function's one object: a write to it is
// `x := x.set(i, v)` in the meaning. Its body binds, in order, views and
// words:
//
// - `Set(i, v)` is `x[i] := v`; `Get(z, i)` reads `x[i]`.
// - `View(t, md, lo, n)` is `let t = &x[lo..lo+n]` (`md = Reads`) or
//   `let t = &mut x[lo..lo+n]` (`md = Writes`): a loan, held until `t`
//   dies.
// - `Read(z, t, i)` reads `t[i]`; `Put(t, i, v)` is `t[i] := v` through a
//   write view.
// - `Die(t)` is the annotation that `t` dies here (§15.3): no code.
// - `CallMut(g, t, args, z)` is `let z = g(t, args)`, lending the write view
//   `t` to `g` for the call.
// - `CallView(g, args, t)` is `let t = g(&x, args)`, a read view of `x`
//   that `g` answers.
//
// `mean_fn` is the meaning: lists are values, a view is its window's value,
// and a write view is its value and an erased slot, the place it goes back
// to (§15.2). Write-back is eager: after `Put` or `CallMut` the place is
// updated, `x := x.put_window(slot, t)`, so no point of death enters the
// meaning. `run_fn` is the run: the function works on a reference (a buffer
// of the file, a base and a length) with no copy; a view is the reference
// narrowed, a write through it is a store in place, and a view a callee
// answers is two words relative to the reference it was given, which the
// caller rebases. Both are stated over a `World`, the meanings and runs of
// the functions called, so a body's meaning and run never see a callee's
// body.
//
// `check_fn` reads the signatures only. Its state is the one object's live
// views, each with its mode and the region it covers (a window, or the
// whole object for a view a callee answered): a place is `out` while a
// live write view covers it and `frozen` while a read view does. An access
// to write (a `Set`, a new write view) needs every live view apart from it;
// an access to read (a `Get`, a new read view) needs every live write view
// apart from it: decided at literals, deferred as a residual otherwise. A
// write view itself is written through freely; a call defers its callee's
// precondition.
//
// `FnSafe(sig, pre, mean, run)` is what a function promises a caller: from
// any file, a reference in bounds and words meeting `pre`, the run answers
// the meaning's word, its reference's window holds the meaning's value
// afterwards and the file is unchanged outside it, and a view it answers
// lies inside the reference and reads the meaning's view value.
// `check_sound` gives `FnSafe` of a function whose verdict is `Some(rs)`,
// whose residuals hold under its precondition, in any world whose functions
// it calls are `FnSafe`. `prog_sound` ties the knot: in the world of a
// program at any depth of calls, every function is `FnSafe`.
import logic;
import bool;
import nat;
import omega;
import option;
import list;
import list_window;
import span_set;
import atom;

// ---------------------------------------------------------------------------
// The fragment

fn list_at(xs: List<List<Nat>>, k: Nat) → List<Nat> { xs.nth(k).unwrap_or(Nil) }

fn Atom::all_bound(args: List<Atom>, nw: Nat) → Bool {
    match args { Nil => True, Cons(a, rest) => a.bound(nw) && Atom::all_bound(rest, nw) }
}

// A call's arguments, read.
fn vals(args: List<Atom>, ws: List<Nat>) → List<Nat> { args.map(λ a => a.val(ws)) }

inductive Mode { Reads, Writes }

fn Mode::writes(self m: Mode) → Bool { match m { Reads => False, Writes => True } }

inductive Stmt {
    Set(i: Atom, v: Atom),
    Get(z: Nat, i: Atom),
    View(t: Nat, md: Mode, lo: Atom, n: Atom),
    Read(z: Nat, t: Nat, i: Atom),
    Put(t: Nat, i: Atom, v: Atom),
    Die(t: Nat),
    CallMut(g: Nat, t: Nat, args: List<Atom>, z: Nat),
    CallView(g: Nat, args: List<Atom>, t: Nat),
}

// A branch's test, on words bound before it: `a <= b`.
inductive Cond { Le(a: Atom, b: Atom) }

fn Cond::test(self cd: Cond, ws: List<Nat>) → Bool { match cd { Le(a, b) => a.val(ws).leb(b.val(ws)) } }

fn Cond::bound(self cd: Cond, nw: Nat) → Bool { match cd { Le(a, b) => a.bound(nw) && b.bound(nw) } }

// A body: statements in order, and branches. `If(cd, a, b, rest)` runs `a`
// where the test holds and `b` where it does not, then `rest` from the
// join. The arms bind as many words and views as each other (the words an
// arm binds are the join's values, as a phi's are).
inductive Body { End, Do(o: Stmt, rest: Body), If(cd: Cond, a: Body, b: Body, rest: Body) }

// Statements, then a body.
fn block(ops: List<Stmt>, last: Body) → Body { match ops { Nil => last, Cons(o, rest) => Do(o, block(rest, last)) } }

fn seq(ops: List<Stmt>) → Body { block(ops, End) }

// What a function answers: a word, or the window `lo..lo+n` of its
// parameter as a read view.
inductive Ret { RWord(a: Atom), RView(lo: Atom, n: Atom) }

record Func { mode: Mode, words: Nat, body: Body, ret: Ret }

// The function a table has nowhere: it reads its parameter and answers 0.
fn Func::none() → Func { Func(Reads, 0, End, RWord(Lit(0))) }

// ---------------------------------------------------------------------------
// The meaning and the run of a call, as a world

// What a call means: the parameter's value afterwards (a read parameter's
// is what it was), the word answered, the view's value.
record MOut { val: List<Nat>, word: Nat, view: List<Nat> }

// What a call does: the file afterwards, the word answered, and the view
// answered, relative to the reference the call was given.
record ROut { file: List<List<Nat>>, word: Nat, lo: Nat, n: Nat }

// A reference: a buffer of the file, a base and a length.
record Ref { b: Nat, base: Nat, len: Nat }

record World {
    mean: Nat → List<Nat> → List<Nat> → MOut,
    run: Nat → List<List<Nat>> → Ref → List<Nat> → ROut,
}

// ---------------------------------------------------------------------------
// The meaning: lists are values, and a write view goes back eagerly

fn window(xs: List<Nat>, lo, n: Nat) → List<Nat> { xs.drop(lo).take(n) }

// The place's value, each view's value, each view's slot (where a write
// view goes back: erased, the meaning's own), and the words bound.
record Sem { cur: List<Nat>, views: List<List<Nat>>, slots: List<Nat>, words: List<Nat> }

fn Sem::bind(self s: Sem, a: Nat) → Sem { Sem(s.cur, s.views, s.slots, s.words ++ [a]) }

fn Sem::open(self s: Sem, val: List<Nat>, slot: Nat) → Sem { Sem(s.cur, s.views ++ [val], s.slots ++ [slot], s.words) }

// The write view `t` now holds `nv`, and the place has it back at once.
fn Sem::back(self s: Sem, t: Nat, nv: List<Nat>) → Sem { Sem(s.cur.put_window(word(s.slots, t), nv), s.views.update(t, λ _ => nv), s.slots, s.words) }

// After a call lent the write view `t`: its value back, and the word.
fn Sem::called(self s: Sem, t: Nat, o: MOut) → Sem { s.back(t, o.val).bind(o.word) }

fn Stmt::eval1(self o: Stmt, w: World, s: Sem) → Sem {
    match o {
        Set(i, v) => Sem(s.cur.update(i.val(s.words), λ _ => v.val(s.words)), s.views, s.slots, s.words),
        Get(_, i) => s.bind(word(s.cur, i.val(s.words))),
        View(_, _, lo, n) => s.open(window(s.cur, lo.val(s.words), n.val(s.words)), lo.val(s.words)),
        Read(_, t, i) => s.bind(word(list_at(s.views, t), i.val(s.words))),
        Put(t, i, v) => s.back(t, list_at(s.views, t).update(i.val(s.words), λ _ => v.val(s.words))),
        Die(_) => s,
        CallMut(g, t, args, _) => s.called(t, w.mean(g, list_at(s.views, t), vals(args, s.words))),
        CallView(g, args, _) => s.open(w.mean(g, s.cur, vals(args, s.words)).view, 0),
    }
}

fn mean_body(w: World, ops: Body, s: Sem) → Sem {
    match ops {
        End => s,
        Do(o, rest) => mean_body(w, rest, o.eval1(w, s)),
        If(cd, a, b, rest) => mean_body(w, rest, match cd.test(s.words) { True => mean_body(w, a, s), False => mean_body(w, b, s) }),
    }
}

fn Ret::word(self r: Ret, ws: List<Nat>) → Nat { match r { RWord(a) => a.val(ws), RView(_, _) => 0 } }

fn Ret::view(self r: Ret, cur: List<Nat>, ws: List<Nat>) → List<Nat> { match r { RWord(_) => Nil, RView(lo, n) => window(cur, lo.val(ws), n.val(ws)) } }

// A read parameter comes back as it went in: `&x` is `T` in and nothing
// out (§15.2).
fn Mode::back(self m: Mode, arg, cur: List<Nat>) → List<Nat> { match m { Reads => arg, Writes => cur } }

fn mean_out(f: Func, arg: List<Nat>, s: Sem) → MOut { MOut(f.mode.back(arg, s.cur), f.ret.word(s.words), f.ret.view(s.cur, s.words)) }

fn mean_fn(w: World, f: Func, arg, ws: List<Nat>) → MOut { mean_out(f, arg, mean_body(w, f.body, Sem(arg, Nil, Nil, ws))) }

// ---------------------------------------------------------------------------
// The run: one reference, no copy

// A read through a reference: past its length, zero, as a window's value
// reads.
fn rget(file: List<List<Nat>>, v: Ref, i: Nat) → Nat {
    match (i + 1).leb(v.len) { True => word(list_at(file, v.b), v.base + i), False => 0 }
}

// A store through a reference: past its length, nothing.
fn store(xs: List<Nat>, r: Ref, i, v: Nat) → List<Nat> {
    match (i + 1).leb(r.len) { True => xs.update(r.base + i, λ _ => v), False => xs }
}

// The window `lo..lo+n` of a reference, cut to it as the meaning's window
// is cut to the list.
fn narrow(r: Ref, lo, n: Nat) → Ref { Ref(r.b, r.base + lo.min(r.len), n.min(r.len - lo)) }

fn ref_at(vs: List<Ref>, t: Nat) → Ref { vs.nth(t).unwrap_or(Ref(0, 0, 0)) }

record Exec { file: List<List<Nat>>, views: List<Ref>, words: List<Nat> }

fn Exec::bind(self m: Exec, a: Nat) → Exec { Exec(m.file, m.views, m.words ++ [a]) }

// A store in place through the reference `v`.
fn Exec::put(self m: Exec, v: Ref, i, x: Nat) → Exec { Exec(m.file.update(v.b, λ xs => store(xs, v, i, x)), m.views, m.words) }

fn Exec::lent(m: Exec, o: ROut) → Exec { Exec(o.file, m.views, m.words ++ [o.word]) }

// A view a callee answered, rebased on the reference the caller gave it.
fn Exec::viewed(m: Exec, r: Ref, o: ROut) → Exec { Exec(o.file, m.views ++ [Ref(r.b, r.base + o.lo, o.n)], m.words) }

fn Stmt::run2(self o: Stmt, w: World, r: Ref, m: Exec) → Exec {
    match o {
        Set(i, v) => m.put(r, i.val(m.words), v.val(m.words)),
        Get(_, i) => m.bind(rget(m.file, r, i.val(m.words))),
        View(_, _, lo, n) => Exec(m.file, m.views ++ [narrow(r, lo.val(m.words), n.val(m.words))], m.words),
        Read(_, t, i) => m.bind(rget(m.file, ref_at(m.views, t), i.val(m.words))),
        Put(t, i, v) => m.put(ref_at(m.views, t), i.val(m.words), v.val(m.words)),
        Die(_) => m,
        CallMut(g, t, args, _) => Exec::lent(m, w.run(g, m.file, ref_at(m.views, t), vals(args, m.words))),
        CallView(g, args, _) => Exec::viewed(m, r, w.run(g, m.file, r, vals(args, m.words))),
    }
}

fn run_body(w: World, r: Ref, ops: Body, m: Exec) → Exec {
    match ops {
        End => m,
        Do(o, rest) => run_body(w, r, rest, o.run2(w, r, m)),
        If(cd, a, b, rest) => run_body(w, r, rest, match cd.test(m.words) { True => run_body(w, r, a, m), False => run_body(w, r, b, m) }),
    }
}

// The view a function answers, relative to its reference: the window cut
// to it.
fn Ret::vlo(self ret: Ret, r: Ref, ws: List<Nat>) → Nat { match ret { RWord(_) => 0, RView(lo, _) => lo.val(ws).min(r.len) } }

fn Ret::vn(self ret: Ret, r: Ref, ws: List<Nat>) → Nat { match ret { RWord(_) => 0, RView(lo, n) => n.val(ws).min(r.len - lo.val(ws)) } }

fn run_out(f: Func, r: Ref, m: Exec) → ROut { ROut(m.file, f.ret.word(m.words), f.ret.vlo(r, m.words), f.ret.vn(r, m.words)) }

fn run_fn(w: World, f: Func, file: List<List<Nat>>, r: Ref, ws: List<Nat>) → ROut { run_out(f, r, run_body(w, r, f.body, Exec(file, Nil, ws))) }

// ---------------------------------------------------------------------------
// A program: functions by number, and its world at a depth of calls

fn fn_at(fns: List<Func>, g: Nat) → Func { fns.nth(g).unwrap_or(Func::none()) }

// At depth zero a call does nothing and answers zero; at depth `d + 1` it
// runs the callee's body at depth `d`.
fn world(fns: List<Func>, d: Nat) → World {
    match d {
        Zero => World(λ _ arg _ => MOut(arg, 0, Nil), λ _ file _ _ => ROut(file, 0, 0, 0)),
        Succ(e) => World(λ g arg ws => mean_fn(world(fns, e), fn_at(fns, g), arg, ws), λ g file r ws => run_fn(world(fns, e), fn_at(fns, g), file, r, ws)),
    }
}

// ---------------------------------------------------------------------------
// The checker

// What a caller reads of a callee: its mode, how many words it takes, and
// what it answers (§15.8). Nothing of its body.
// What a live view covers: a window of the object, the whole of it (a view
// a callee answered whose signature cannot place it more finely), or
// the union of two regions (a view the arms of a branch opened on different
// windows: the join's union of their place sets).
inductive Region { Whole, Win(lo: Atom, n: Atom), Both(a: Region, b: Region) }

// A region in another frame of words: a callee's, read at a call's
// arguments.
fn Atom::subst(self a: Atom, args: List<Atom>) → Atom { match a { Lit(n) => Lit(n), Var(i) => args.nth(i).unwrap_or(Lit(0)) } }

fn Region::subst(self rg: Region, args: List<Atom>) → Region {
    match rg { Whole => Whole, Win(lo, n) => Win(lo.subst(args), n.subst(args)), Both(a, b) => Both(a.subst(args), b.subst(args)) }
}

// Whether a region covers position `p` of the reference's buffer, in the
// words.
fn Region::hits(self rg: Region, r: Ref, ws: List<Nat>, p: Nat) → Bool {
    match rg {
        Whole => Span(r.base, r.len).has(p),
        Win(lo, n) => Span(r.base + lo.val(ws), n.val(ws)).has(p),
        Both(a, b) => a.hits(r, ws, p) || b.hits(r, ws, p),
    }
}

// What a signature says a function answers: a word, or a read view lying
// in a region of its parameter, stated in its parameter words.
inductive RetKind { KWord, KView(rg: Region) }

fn RetKind::is_view(self k: RetKind) → Bool { match k { KWord => False, KView(_) => True } }

// Where a function's answered view lies (a word answers an empty one).
fn RetKind::region(self k: RetKind) → Region { match k { KWord => Whole, KView(rg) => rg } }

record Sig { mode: Mode, words: Nat, ret: RetKind }

// A view's window is its signature's region where it reads only the
// parameter words; otherwise the signature places it only in the whole
// parameter.
fn Ret::kind(self r: Ret, words: Nat) → RetKind {
    match r { RWord(_) => KWord, RView(lo, n) => KView(match lo.bound(words) && n.bound(words) { True => Win(lo, n), False => Whole }) }
}

fn Func::sig(self f: Func) → Sig { Sig(f.mode, f.words, f.ret.kind(f.words)) }

fn sig_at(sigs: List<Sig>, g: Nat) → Sig { sigs.nth(g).unwrap_or(Func::none().sig()) }

fn sigs_of(fns: List<Func>) → List<Sig> { fns.map(λ f => f.sig()) }

record LView { t: Nat, md: Mode, region: Region }

// What the checker defers: an obligation of `atom.hthr` (here two windows
// apart, `Spans`), a callee's precondition at the call's arguments, or
// either owed in an arm of a branch, under the arm's test.
inductive Owed { Due(o: Obligation), Pre(g: Nat, args: List<Atom>), Under(cd: Cond, yes: Bool, o: Owed) }

fn Owed::Holds(self o: Owed, pres: Nat → List<Nat> → Type, ws: List<Nat>) → Type {
    match o {
        Due(ob) => ob.Holds(ws),
        Pre(g, args) => pres(g, vals(args, ws)),
        Under(cd, yes, o2) => cd.test(ws) = yes → o2.Holds(pres, ws),
    }
}

fn under(cd: Cond, yes: Bool, rs: List<Owed>) → List<Owed> { rs.map(λ o => Under(cd, yes, o)) }

fn dues(r: Option<List<Obligation>>) → Option<List<Owed>> { r.map(λ os => os.map(λ ob => Due(ob))) }

fn Owed::All(rs: List<Owed>, pres: Nat → List<Nat> → Type, ws: List<Nat>) → Type {
    match rs { Nil => True, Cons(r, rest) => r.Holds(pres, ws) ∧ Owed::All(rest, pres, ws) }
}

// Two regions apart: never with the whole object, decided or owed for two
// windows, piece by piece for a union.
fn Region::license_win(lo1, n1: Atom, b: Region) → Option<List<Owed>> {
    match b {
        Whole => None,
        Win(lo2, n2) => dues(Spans(lo1, n1, lo2, n2).settle()),
        Both(b1, b2) => Region::license_win(lo1, n1, b1).and_then(λ r1 => Region::license_win(lo1, n1, b2).map(λ r2 => r1 ++ r2)),
    }
}

fn Region::license(self a: Region, b: Region) → Option<List<Owed>> {
    match a {
        Whole => None,
        Win(lo1, n1) => Region::license_win(lo1, n1, b),
        Both(a1, a2) => a1.license(b).and_then(λ r1 => a2.license(b).map(λ r2 => r1 ++ r2)),
    }
}

// An access in mode `md` meets a live view when either writes: two reads
// share a place, and anything else needs it to itself.
fn LView::meets(self lv: LView, md: Mode) → Bool { md.writes() || lv.md.writes() }

fn LView::license(self lv: LView, md: Mode, rg: Region) → Option<List<Owed>> {
    match lv.meets(md) { True => lv.region.license(rg), False => Some(Nil) }
}

// An access in mode `md` of the region `rg`, against every live view.
fn license_live(live: List<LView>, md: Mode, rg: Region) → Option<List<Owed>> {
    match live {
        Nil => Some(Nil),
        Cons(lv, rest) => lv.license(md, rg).and_then(λ r1 => license_live(rest, md, rg).map(λ r2 => r1 ++ r2)),
    }
}

fn find_live(live: List<LView>, t: Nat) → Option<LView> {
    match live { Nil => None, Cons(lv, rest) => match lv.t.same(t) { True => Some(lv), False => find_live(rest, t) } }
}

// `t` is a live write view.
fn is_lent(live: List<LView>, t: Nat) → Bool { match find_live(live, t) { None => False, Some(lv) => lv.md.writes() } }

fn kill(live: List<LView>, t: Nat) → List<LView> { live.filter(λ lv => !lv.t.same(t)) }

// The one object's state: its live views, and the next view and word to
// bind.
record Places { live: List<LView>, nviews: Nat, nw: Nat }

fn Places::said(self c: Places) → Places { Places(c.live, c.nviews, c.nw + 1) }

record Next { next: Places, rs: List<Owed> }

fn check_mut(sg: Sig, c: Places, g, t: Nat, args: List<Atom>, z: Nat) → Option<Next> {
    (((!sg.ret.is_view() && is_lent(c.live, t)) && z.same(c.nw)) && (Atom::all_bound(args, c.nw) && args.len().same(sg.words))).then(
        Some(Next(c.said(), [Pre(g, args)])))
}

fn check_view(sg: Sig, c: Places, g: Nat, args: List<Atom>, t: Nat) → Option<Next> {
    (((!sg.mode.writes() && sg.ret.is_view()) && t.same(c.nviews)) && (Atom::all_bound(args, c.nw) && args.len().same(sg.words))).then(
        license_live(c.live, Reads, Whole).map(λ rs => Next(Places(Cons(LView(t, Reads, sg.ret.region().subst(args)), c.live), c.nviews + 1, c.nw), rs ++ [Pre(g, args)])))
}

fn Stmt::check(self o: Stmt, mode: Mode, sigs: List<Sig>, c: Places) → Option<Next> {
    match o {
        Set(i, v) => ((mode.writes() && i.bound(c.nw)) && v.bound(c.nw)).then(license_live(c.live, Writes, Win(i, Lit(1))).map(λ rs => Next(c, rs))),
        Get(z, i) => (z.same(c.nw) && i.bound(c.nw)).then(license_live(c.live, Reads, Win(i, Lit(1))).map(λ rs => Next(c.said(), rs))),
        View(t, md, lo, n) =>
            ((((!md.writes() || mode.writes()) && t.same(c.nviews)) && lo.bound(c.nw)) && n.bound(c.nw)).then(
                license_live(c.live, md, Win(lo, n)).map(λ rs => Next(Places(Cons(LView(t, md, Win(lo, n)), c.live), c.nviews + 1, c.nw), rs))),
        Read(z, t, i) => ((z.same(c.nw) && find_live(c.live, t).is_some()) && i.bound(c.nw)).then(Some(Next(c.said(), Nil))),
        Put(t, i, v) => ((is_lent(c.live, t) && i.bound(c.nw)) && v.bound(c.nw)).then(Some(Next(c, Nil))),
        Die(t) => find_live(c.live, t).is_some().then(Some(Next(Places(kill(c.live, t), c.nviews, c.nw), Nil))),
        CallMut(g, t, args, z) => check_mut(sig_at(sigs, g), c, g, t, args, z),
        CallView(g, args, t) => check_view(sig_at(sigs, g), c, g, args, t),
    }
}

// The join of two arms: the meet of their live views. A view live on both
// arms with one mode stays, its region the union of the arms' where they
// disagree on it; any other view is dead after the join.
fn Mode::alike(self a, b: Mode) → Bool { match a { Reads => match b { Reads => True, Writes => False }, Writes => match b { Reads => False, Writes => True } } }

fn Region::alike(self a, b: Region) → Bool {
    match a {
        Whole => match b { Whole => True, Win(_, _) => False, Both(_, _) => False },
        Win(lo1, n1) => match b { Whole => False, Win(lo2, n2) => lo1.same(lo2) && n1.same(n2), Both(_, _) => False },
        Both(_, _) => False,
    }
}

fn Region::coarsen(self a, b: Region) → Region { match a.alike(b) { True => a, False => Both(a, b) } }

fn LView::met(self lv: LView, other: List<LView>) → List<LView> {
    match find_live(other, lv.t) {
        None => Nil,
        Some(o) => match lv.md.alike(o.md) { True => [LView(lv.t, lv.md, lv.region.coarsen(o.region))], False => Nil },
    }
}

fn meet(la, lb: List<LView>) → List<LView> { match la { Nil => Nil, Cons(lv, rest) => lv.met(lb) ++ meet(rest, lb) } }

fn join(ca, cb: Places) → Option<Places> {
    (ca.nviews.same(cb.nviews) && ca.nw.same(cb.nw)).then(Some(Places(meet(ca.live, cb.live), ca.nviews, ca.nw)))
}

// The arms joined: each arm's residuals owed under its test.
fn check_join(cd: Cond, sa, sb: Next) → Option<Next> { join(sa.next, sb.next).map(λ cj => Next(cj, under(cd, True, sa.rs) ++ under(cd, False, sb.rs))) }

// A step, then the rest from where it leaves the places.
fn Next::then(h: Option<Next>, k: Places → Option<Next>) → Option<Next> { h.and_then(λ st => k(st.next).map(λ sr => Next(sr.next, st.rs ++ sr.rs))) }

fn check_body(ops: Body, mode: Mode, sigs: List<Sig>, c: Places) → Option<Next> {
    match ops {
        End => Some(Next(c, Nil)),
        Do(o, rest) => Next::then(o.check(mode, sigs, c), λ c2 => check_body(rest, mode, sigs, c2)),
        If(cd, a, b, rest) => Next::then(cd.bound(c.nw).then(check_body(a, mode, sigs, c).and_then(λ sa => check_body(b, mode, sigs, c).and_then(λ sb => check_join(cd, sa, sb)))),
            λ c2 => check_body(rest, mode, sigs, c2)),
    }
}

fn check_fn(sigs: List<Sig>, f: Func) → Option<List<Owed>> { check_body(f.body, f.mode, sigs, Places(Nil, 0, f.words)).map(λ st => st.rs) }

// ---------------------------------------------------------------------------
// What a function promises

// What a buffer holds at a reference, read as a list.
fn Holds(buf: List<Nat>, base: Nat, cur: List<Nat>) → Type { (i: Nat) → i < cur.len() → buf.nth(base + i) = cur.nth(i) }

// The reference is in the file.
record InRef(file: List<List<Nat>>, r: Ref) {
    buf: r.b < file.len(),
    fits: r.base + r.len <= list_at(file, r.b).len(),
}

// `file` holds `cur` in the reference's window and is `file0` everywhere
// else: the window holds the value, and outside it nothing changed.
record OnRef(file0, file: List<List<Nat>>, r: Ref, cur: List<Nat>) {
    len: cur.len() = r.len,
    holds: Holds(list_at(file, r.b), r.base, cur),
    out: (p: Nat) → ¬Span(r.base, r.len).has(p).IsTrue() → list_at(file, r.b).nth(p) = list_at(file0, r.b).nth(p),
    other: (k: Nat) → k ≠ r.b → list_at(file, k) = list_at(file0, k),
    shape: file.len() = file0.len(),
    blen: list_at(file, r.b).len() = list_at(file0, r.b).len(),
}

// A call's promise at one file, reference and words: the run answers the
// meaning's word; the window holds the meaning's value and nothing outside
// it changed; a read parameter's value is what went in; and the view it
// answers lies in the region its signature names, at these words, and
// reads the meaning's view value; and the word it answers meets its
// postcondition.
record Safe(mode: Mode, rg: Region, ws: List<Nat>, post: Nat → Type, file: List<List<Nat>>, r: Ref, arg: List<Nat>, mo: MOut, ro: ROut) {
    answer: ro.word = mo.word,
    posted: post(mo.word),
    on: OnRef(file, ro.file, r, mo.val),
    keeps: mode.writes() = False → mo.val = arg,
    view_in: (p: Nat) → Span(r.base + ro.lo, ro.n).has(p).IsTrue() → rg.hits(r, ws, p).IsTrue(),
    view_reads: (i: Nat) → word(mo.view, i) = rget(ro.file, Ref(r.b, r.base + ro.lo, ro.n), i),
}

// A function's safety statement: from any file, a reference in bounds and
// words meeting its precondition, the run and the meaning keep the promise,
// and the answer meets the postcondition (a proposition about the words and
// the answer, which callers may assume: §15.8's proof parameters).
fn FnSafe(sig: Sig, pre: List<Nat> → Type, post: List<Nat> → Nat → Type, mean: List<Nat> → List<Nat> → MOut, run: List<List<Nat>> → Ref → List<Nat> → ROut) → Type {
    (file: List<List<Nat>>) → (r: Ref) → (ws: List<Nat>) → InRef(file, r) → ws.len() = sig.words → pre(ws) →
        Safe(sig.mode, sig.ret.region(), ws, post(ws), file, r, window(list_at(file, r.b), r.base, r.len), mean(window(list_at(file, r.b), r.base, r.len), ws), run(file, r, ws))
}

// ---------------------------------------------------------------------------
// Small facts

fn Prefix(ws, big: List<Nat>) → Type { (ws.len() <= big.len()) ∧ ((w: Nat) → w < ws.len() → big.nth(w) = ws.nth(w)) }

theorem Prefix::same(ws: List<Nat>): Prefix(ws, ws) { ⟨ws.len().le_refl(), λ w _ => refl⟩ }

theorem Prefix::snoc(ws: List<Nat>, a: Nat): Prefix(ws, ws ++ [a]) {
    ⟨j(sym(ws.len_append([a])), λ n _ => ws.len() <= n, omega()), λ w lt => ws.nth_append_below([a], w, lt)⟩
}

theorem Prefix::chain(a, b, c: List<Nat>, ab: Prefix(a, b), bc: Prefix(b, c)): Prefix(a, c) {
    ⟨Nat::le_trans(a.len(), b.len(), c.len(), ab.left, bc.left),
        λ w lt => prelude::trans(bc.right(w, Nat::lt_of_lt_of_le(w, a.len(), b.len(), lt, ab.left)), ab.right(w, lt))⟩
}

theorem Atom::val_stable(self a: Atom, ws, big: List<Nat>, pre: Prefix(ws, big), b: a.bound(ws.len()) = True): a.val(big) = a.val(ws) {
    (match a as λ e => e.bound(ws.len()) = True → e.val(big) = e.val(ws) {
        Lit(_) => λ _ => refl,
        Var(w) => λ lt => cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), pre.right(w, omega(lt))),
    })(b)
}

theorem Atom::vals_stable(args: List<Atom>, ws, big: List<Nat>, pre: Prefix(ws, big)): Atom::all_bound(args, ws.len()) = True → vals(args, big) = vals(args, ws) {
    match args {
        Nil => λ _ => refl,
        Cons(a, rest) => λ b => {
            let p = Bool::and_true_parts(a.bound(ws.len()), Atom::all_bound(rest, ws.len()), b);
            prelude::trans(cong_fn(λ (x: Nat) => Cons(x, vals(rest, big)), a.val_stable(ws, big, pre, p.left)),
                cong_fn(λ (xs: List<Nat>) => Cons(a.val(ws), xs), Atom::vals_stable(rest, ws, big, pre, p.right)))
        },
    }
}

theorem vals_len(args: List<Atom>, ws: List<Nat>): vals(args, ws).len() = args.len() { args.len_map(λ a => a.val(ws)) }

theorem len_snoc<A>(xs: List<A>, a: A): (xs ++ [a]).len() = xs.len() + 1 { xs.len_append([a]) }

theorem list_at_update_here(file: List<List<Nat>>, b: Nat, g: List<Nat> → List<Nat>, inside: b < file.len()): list_at(file.update(b, g), b) = g(list_at(file, b)) {
    let at = file.nth_present(b, inside);
    trans(cong_fn(λ (o: Option<List<Nat>>) => o.unwrap_or(Nil), file.nth_update_here(b, g, at.witness, at.proof)),
        cong_fn(λ (o: Option<List<Nat>>) => g(o.unwrap_or(Nil)), sym(at.proof)))
}

theorem list_at_update_other(file: List<List<Nat>>, b: Nat, g: List<Nat> → List<Nat>, k: Nat, ne: k ≠ b): list_at(file.update(b, g), k) = list_at(file, k) {
    cong_fn(λ (o: Option<List<Nat>>) => o.unwrap_or(Nil), file.nth_update_other(b, g, k, ne))
}

theorem list_at_snoc_below(xs: List<List<Nat>>, a: List<Nat>, k: Nat, lt: k < xs.len()): list_at(xs ++ [a], k) = list_at(xs, k) {
    cong_fn(λ (o: Option<List<Nat>>) => o.unwrap_or(Nil), xs.nth_append_below([a], k, lt))
}

theorem list_at_snoc_at(xs: List<List<Nat>>, a: List<Nat>, k: Nat, at: xs.len() = k): list_at(xs ++ [a], k) = a {
    cong_fn(λ (o: Option<List<Nat>>) => o.unwrap_or(Nil), xs.nth_append_at([a], k, at))
}

theorem ref_at_snoc_below(vs: List<Ref>, a: Ref, k: Nat, lt: k < vs.len()): ref_at(vs ++ [a], k) = ref_at(vs, k) {
    cong_fn(λ (o: Option<Ref>) => o.unwrap_or(Ref(0, 0, 0)), vs.nth_append_below([a], k, lt))
}

theorem ref_at_snoc_at(vs: List<Ref>, a: Ref, k: Nat, at: vs.len() = k): ref_at(vs ++ [a], k) = a {
    cong_fn(λ (o: Option<Ref>) => o.unwrap_or(Ref(0, 0, 0)), vs.nth_append_at([a], k, at))
}

theorem option_map_some<A, B>(o: Option<A>, f: A → B, b: B): o.map(f) = Some(b) → Exists<A>(λ a => (o = Some(a)) ∧ (f(a) = b)) {
    match o { None => λ h => absurd(h), Some(a) => λ h => Exists(a, ⟨refl, Option::some_inj(f(a), b, h)⟩) }
}

theorem Next::of(g: Bool, next, st: Next, ok: g.then(Some(next)) = Some(st)): (g = True) ∧ (next = st) {
    let p = g.then_some(Some(next), st, ok);
    ⟨p.left, Option::some_inj(next, st, p.right)⟩
}

// ---------------------------------------------------------------------------
// Windows

theorem take_nth_past(xs: List<Nat>): (n, i: Nat) → n <= i → xs.take(n).nth(i) = None {
    match xs {
        Nil => λ n i _ => refl,
        Cons(_, t) => λ n => match n {
            Zero => λ i _ => refl,
            Succ(m) => λ i => match i {
                Zero => λ no => false_elim(no),
                Succ(k) => λ le => take_nth_past(t, m, k, le),
            },
        },
    }
}

theorem window_nth_in(xs: List<Nat>, lo, n, i: Nat, lt: i < n): window(xs, lo, n).nth(i) = xs.nth(i + lo) {
    trans(xs.drop(lo).nth_take(n, i, lt), xs.nth_drop_add(lo, i))
}

theorem window_nth_out(xs: List<Nat>, lo, n, i: Nat, ge: n <= i): window(xs, lo, n).nth(i) = None { take_nth_past(xs.drop(lo), n, i, ge) }

// Past the list, a window reads nothing either.
theorem window_nth_end(xs: List<Nat>, lo, n, i: Nat, ge: xs.len() <= i + lo): window(xs, lo, n).nth(i) = None {
    match q: (i + 1).leb(n) {
        True => trans(window_nth_in(xs, lo, n, i, omega(q)), xs.nth_past_end(i + lo, ge)),
        False => window_nth_out(xs, lo, n, i, omega(q)),
    }
}

theorem window_len(xs: List<Nat>, lo, n: Nat): window(xs, lo, n).len() = n.min(xs.len() - lo) {
    match q: n.leb(xs.drop(lo).len()) {
        True => omega(xs.drop(lo).len_take(n, omega(q)), xs.len_drop(lo), q),
        False => {
            let e: (window(xs, lo, n).len() = xs.drop(lo).len()) = cong_fn(λ (l: List<Nat>) => l.len(), xs.drop(lo).take_all(n, omega(q)));
            omega(e, xs.len_drop(lo), q)
        },
    }
}

// ---------------------------------------------------------------------------
// A reference that holds a value

// The reference's own window reads the value it holds.
theorem whole_window(buf: List<Nat>, base: Nat, cur: List<Nat>, h: Holds(buf, base, cur), fits: base + cur.len() <= buf.len()): window(buf, base, cur.len()) = cur {
    window(buf, base, cur.len()).ext_nth(cur, omega(window_len(buf, base, cur.len())),
        λ k lt => {
            let in_cur: (k < cur.len()) = omega(lt, window_len(buf, base, cur.len()));
            let at: (k + base = base + k) = omega();
            prelude::trans(window_nth_in(buf, base, cur.len(), k, in_cur),
                prelude::trans(cong_fn(λ (p: Nat) => buf.nth(p), at), h(k, in_cur)))
        })
}

// A window of it, cut to it, reads the value's window: narrowing a
// reference is taking the meaning's window.
theorem narrow_window(buf: List<Nat>, base: Nat, cur: List<Nat>, h: Holds(buf, base, cur), fits: base + cur.len() <= buf.len(), lo, n: Nat):
    window(buf, base + lo.min(cur.len()), n.min(cur.len() - lo)) = window(cur, lo, n)
{
    let lens: (window(buf, base + lo.min(cur.len()), n.min(cur.len() - lo)).len() = window(cur, lo, n).len()) =
        omega(window_len(buf, base + lo.min(cur.len()), n.min(cur.len() - lo)), window_len(cur, lo, n), fits);
    window(buf, base + lo.min(cur.len()), n.min(cur.len() - lo)).ext_nth(window(cur, lo, n), lens,
        λ k lt => {
            let in_w: (k < n.min(cur.len() - lo)) = omega(lt, window_len(buf, base + lo.min(cur.len()), n.min(cur.len() - lo)));
            let at: (k + (base + lo.min(cur.len())) = base + (k + lo)) = omega(in_w);
            prelude::trans(window_nth_in(buf, base + lo.min(cur.len()), n.min(cur.len() - lo), k, in_w),
                prelude::trans(cong_fn(λ (p: Nat) => buf.nth(p), at),
                    prelude::trans(h(k + lo, omega(in_w)), sym(window_nth_in(cur, lo, n, k, omega(in_w))))))
        })
}

// The narrowed reference reads the value's window, element by element.
theorem narrow_reads(file: List<List<Nat>>, r: Ref, cur: List<Nat>, h: Holds(list_at(file, r.b), r.base, cur), len: cur.len() = r.len, lo, n: Nat):
    (i: Nat) → word(window(cur, lo, n), i) = rget(file, narrow(r, lo, n), i)
{
    λ i => match q: (i + 1).leb(n.min(r.len - lo)) {
        True => {
            let inside: (i + lo < cur.len()) = omega(q, len);
            let at: (r.base + (i + lo) = r.base + lo.min(r.len) + i) = omega(q);
            cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0),
                prelude::trans(window_nth_in(cur, lo, n, i, omega(q)),
                    prelude::trans(sym(h(i + lo, inside)), cong_fn(λ (p: Nat) => list_at(file, r.b).nth(p), at))))
        },
        False => match q2: (i + 1).leb(n) {
            True => cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), window_nth_end(cur, lo, n, i, omega(q, q2, len))),
            False => cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), window_nth_out(cur, lo, n, i, omega(q2))),
        },
    }
}

theorem narrow_window_at(buf: List<Nat>, base: Nat, cur: List<Nat>, h: Holds(buf, base, cur), fits: base + cur.len() <= buf.len(), len, lo, n: Nat, e: cur.len() = len):
    window(buf, base + lo.min(len), n.min(len - lo)) = window(cur, lo, n)
{
    j(e, λ l _ => window(buf, base + lo.min(l), n.min(l - lo)) = window(cur, lo, n), narrow_window(buf, base, cur, h, fits, lo, n))
}

// A read through the reference reads the value it holds.
theorem rget_holds(file: List<List<Nat>>, r: Ref, cur: List<Nat>, h: Holds(list_at(file, r.b), r.base, cur), len: cur.len() = r.len):
    (i: Nat) → rget(file, r, i) = word(cur, i)
{
    λ i => match q: (i + 1).leb(r.len) {
        True => cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), h(i, omega(q, len))),
        False => cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), sym(cur.nth_past_end(i, omega(q, len)))),
    }
}

// ---------------------------------------------------------------------------
// The write-back: a value's window replaced by what a call left there

// A window written back where it was cut: an empty one changes nothing,
// and the list keeps its length.
theorem put_cut_nil(cur: List<Nat>, lo: Nat, ys: List<Nat>, e: ys.len() = 0): cur.put_window(lo, ys) = cur {
    prelude::trans(cong_fn(λ (l: List<Nat>) => cur.put_window(lo, l), ys.nil_of_len_zero(e)), cur.put_window_nil(lo))
}

theorem put_cut_length(cur: List<Nat>, lo, n: Nat, ys: List<Nat>, e: ys.len() = n.min(cur.len() - lo)): cur.put_window(lo, ys).len() = cur.len() {
    match q: (ys.len()).leb(0) {
        True => cong_fn(λ (l: List<Nat>) => l.len(), put_cut_nil(cur, lo, ys, omega(q))),
        False => cur.len_put_window(lo, ys, omega(q, e)),
    }
}

// Inside the window, what the call left; outside it, what was there.
theorem put_cut_in(cur: List<Nat>, lo, n: Nat, ys: List<Nat>, e: ys.len() = n.min(cur.len() - lo), i: Nat,
    low: lo.min(cur.len()) <= i, high: i < lo.min(cur.len()) + ys.len()): cur.put_window(lo, ys).nth(i) = ys.nth(i - lo.min(cur.len()))
{
    let at: (i = (i - lo.min(cur.len())) + lo) = omega(low, high, e);
    prelude::trans(cong_fn(λ (k: Nat) => cur.put_window(lo, ys).nth(k), at),
        cur.nth_put_window_inside(lo, ys, i - lo.min(cur.len()), omega(low, high), omega(high, e)))
}

theorem put_cut_out(cur: List<Nat>, lo, n: Nat, ys: List<Nat>, e: ys.len() = n.min(cur.len() - lo), i: Nat,
    out: ¬Span(lo.min(cur.len()), ys.len()).has(i).IsTrue()): cur.put_window(lo, ys).nth(i) = cur.nth(i)
{
    match q: (ys.len()).leb(0) {
        True => cong_fn(λ (l: List<Nat>) => l.nth(i), put_cut_nil(cur, lo, ys, omega(q))),
        False => match q2: (i + 1).leb(lo) {
            True => cur.nth_put_window_before(lo, ys, i, omega(q2), omega(q, e)),
            False => {
                let at: (i = (i - (ys.len() + lo)) + (ys.len() + lo)) = omega(q, q2, e, out);
                prelude::trans(cong_fn(λ (k: Nat) => cur.put_window(lo, ys).nth(k), at),
                    prelude::trans(cur.nth_put_window_after(lo, ys, i - (ys.len() + lo), omega(q, e)), cong_fn(λ (k: Nat) => cur.nth(k), sym(at))))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Facts about a held reference

// At the start, the file holds the reference's own window.
theorem OnRef::start(file: List<List<Nat>>, r: Ref, inr: InRef(file, r)): OnRef(file, file, r, window(list_at(file, r.b), r.base, r.len)) {
    let wl: (window(list_at(file, r.b), r.base, r.len).len() = r.len) = omega(window_len(list_at(file, r.b), r.base, r.len), inr.fits);
    OnRef(wl,
        λ i lt => {
            let at: (r.base + i = i + r.base) = omega();
            prelude::trans(cong_fn(λ (k: Nat) => list_at(file, r.b).nth(k), at), sym(window_nth_in(list_at(file, r.b), r.base, r.len, i, omega(lt, wl))))
        },
        λ p _ => refl, λ k _ => refl, refl, refl)
}

// Two holds in a row, at one reference: the second one's.
theorem OnRef::chain(file0, file1, file2: List<List<Nat>>, r: Ref, c1, c2: List<Nat>, a: OnRef(file0, file1, r, c1), b: OnRef(file1, file2, r, c2)): OnRef(file0, file2, r, c2) {
    OnRef(b.len, b.holds,
        λ p out => prelude::trans(b.out(p, out), a.out(p, out)),
        λ k ne => prelude::trans(b.other(k, ne), a.other(k, ne)),
        prelude::trans(b.shape, a.shape), prelude::trans(b.blen, a.blen))
}

// A file that holds what another held, at the same reference, is that file
// in the reference's buffer.
theorem OnRef::unchanged(file1, file2: List<List<Nat>>, r: Ref, cur: List<Nat>, before: Holds(list_at(file1, r.b), r.base, cur), on: OnRef(file1, file2, r, cur)):
    (p: Nat) → list_at(file2, r.b).nth(p) = list_at(file1, r.b).nth(p)
{
    λ p => match q: Span(r.base, r.len).has(p) {
        True => {
            let at: (p = r.base + (p - r.base)) = omega(q);
            let inside: (p - r.base < cur.len()) = omega(q, on.len);
            prelude::trans(cong_fn(λ (k: Nat) => list_at(file2, r.b).nth(k), at),
                prelude::trans(on.holds(p - r.base, inside), prelude::trans(sym(before(p - r.base, inside)), cong_fn(λ (k: Nat) => list_at(file1, r.b).nth(k), sym(at)))))
        },
        False => on.out(p, omega(q)),
    }
}

theorem word_snoc_below(xs: List<Nat>, a: Nat, k: Nat, lt: k < xs.len()): word(xs ++ [a], k) = word(xs, k) {
    cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), xs.nth_append_below([a], k, lt))
}

theorem word_snoc_at(xs: List<Nat>, a: Nat, k: Nat, at: xs.len() = k): word(xs ++ [a], k) = a {
    cong_fn(λ (o: Option<Nat>) => o.unwrap_or(0), xs.nth_append_at([a], k, at))
}

theorem some_of_is_some<A>(o: Option<A>, h: o.is_some() = True): Exists<A>(λ a => o = Some(a)) {
    (match o as λ x => x.is_some() = True → Exists<A>(λ a => x = Some(a)) { None => λ no => absurd(no), Some(a) => λ _ => Exists(a, refl) })(h)
}

theorem false_of_not(b: Bool, h: (!b) = True): b = False {
    (match b as λ x => (!x) = True → x = False { True => λ no => absurd(no), False => λ _ => refl })(h)
}

// `!a || b` and `a`: `b`.
theorem Bool::implies_of(a, b: Bool, h: (!a || b) = True, ha: a = True): b = True { j(ha, λ x _ => (!x || b) = True, h) }

theorem Bool::or_of_right(a, b: Bool, h: b = True): (a || b) = True { (match a as λ x => (x || b) = True { True => refl, False => h }) }

theorem Bool::or_of_left(a, b: Bool, h: a = True): (a || b) = True { j(sym(h), λ x _ => (x || b) = True, refl) }

// ---------------------------------------------------------------------------
// The write-back: a value's window replaced by what was left there

// One element of the write-back: inside the lent window, what the call
// left; outside it, what the file held before.
theorem written_at(file1, file2: List<List<Nat>>, r: Ref, cur: List<Nat>, lov, nv: Nat, ys: List<Nat>,
    h1: Holds(list_at(file1, r.b), r.base, cur), len: cur.len() = r.len,
    h2: Holds(list_at(file2, r.b), r.base + lov.min(r.len), ys),
    out2: (p: Nat) → ¬Span(r.base + lov.min(r.len), nv.min(r.len - lov)).has(p).IsTrue() → list_at(file2, r.b).nth(p) = list_at(file1, r.b).nth(p),
    ylen: ys.len() = nv.min(cur.len() - lov), i: Nat, lt: i < cur.len()): list_at(file2, r.b).nth(r.base + i) = cur.put_window(lov, ys).nth(i)
{
    match q: Span(lov.min(cur.len()), ys.len()).has(i) {
        True => {
            let inside: (i - lov.min(cur.len()) < ys.len()) = omega(q);
            let at: (r.base + lov.min(r.len) + (i - lov.min(cur.len())) = r.base + i) = omega(q, len);
            prelude::trans(cong_fn(λ (p: Nat) => list_at(file2, r.b).nth(p), sym(at)),
                prelude::trans(h2(i - lov.min(cur.len()), inside), sym(put_cut_in(cur, lov, nv, ys, ylen, i, omega(q), omega(q)))))
        },
        False => {
            let outside: (¬Span(r.base + lov.min(r.len), nv.min(r.len - lov)).has(r.base + i).IsTrue()) = λ hit => omega(hit, q, ylen, len);
            prelude::trans(out2(r.base + i, outside), prelude::trans(h1(i, lt), sym(put_cut_out(cur, lov, nv, ys, ylen, i, omega(q)))))
        },
    }
}

// The write-back, over bare data: a file that holds `cur` at `r`, then a
// write through the window `lov..lov+nv` of `r` (a store, or a call it was
// lent to) that leaves `ys` there and nothing changed outside it, give a
// file that holds `cur` with that window replaced by `ys`. This is the frame
// of a window of a window: "outside the window nothing changed" is all the
// holder needs.
theorem written_back(file0, file1, file2: List<List<Nat>>, r: Ref, cur: List<Nat>, lov, nv: Nat, ys: List<Nat>,
    before: OnRef(file0, file1, r, cur), call: OnRef(file1, file2, narrow(r, lov, nv), ys)): OnRef(file0, file2, r, cur.put_window(lov, ys))
{
    let ylen: (ys.len() = nv.min(cur.len() - lov)) = omega(call.len, before.len);
    let nlen: (cur.put_window(lov, ys).len() = r.len) = prelude::trans(put_cut_length(cur, lov, nv, ys, ylen), before.len);
    OnRef(nlen, λ i lt => written_at(file1, file2, r, cur, lov, nv, ys, before.holds, before.len, call.holds, call.out, ylen, i, omega(lt, nlen, before.len)),
        λ p out => prelude::trans(call.out(p, λ h => out(omega(h))), before.out(p, out)),
        λ k2 ne => prelude::trans(call.other(k2, ne), before.other(k2, ne)),
        prelude::trans(call.shape, before.shape), prelude::trans(call.blen, before.blen))
}

// ---------------------------------------------------------------------------
// Stores through a reference

theorem store_len(xs: List<Nat>, r: Ref, iv, vv: Nat): store(xs, r, iv, vv).len() = xs.len() {
    match q: (iv + 1).leb(r.len) { True => xs.len_update(r.base + iv, λ _ => vv), False => refl }
}

theorem store_other(xs: List<Nat>, r: Ref, iv, vv, p: Nat, ne: iv < r.len → p ≠ r.base + iv): store(xs, r, iv, vv).nth(p) = xs.nth(p) {
    match q: (iv + 1).leb(r.len) { True => xs.nth_update_other(r.base + iv, λ _ => vv, p, ne(omega(q))), False => refl }
}

theorem store_here(xs: List<Nat>, r: Ref, iv, vv: Nat, lt: iv < r.len, fits: r.base + iv < xs.len()): store(xs, r, iv, vv).nth(r.base + iv) = Some(vv) {
    j(sym(Nat::leb_true(iv + 1, r.len, lt)), λ b _ => (match b { True => xs.update(r.base + iv, λ _ => vv), False => xs }).nth(r.base + iv) = Some(vv),
        xs.nth_update_set(r.base + iv, vv, fits))
}

// A reference that holds a value, read as a hold that changed nothing.
theorem OnRef::here(file: List<List<Nat>>, v: Ref, val: List<Nat>, h: Holds(list_at(file, v.b), v.base, val), len: val.len() = v.len): OnRef(file, file, v, val) {
    OnRef(len, h, λ p _ => refl, λ k _ => refl, refl, refl)
}

// A store through a reference that holds a value: it holds the value
// updated, and nothing outside it changed.
theorem OnRef::stored(file0, file: List<List<Nat>>, v: Ref, cur: List<Nat>, on: OnRef(file0, file, v, cur), buf: v.b < file.len(), fits: v.base + v.len <= list_at(file, v.b).len(), iv, vv: Nat):
    OnRef(file0, file.update(v.b, λ xs => store(xs, v, iv, vv)), v, cur.update(iv, λ _ => vv))
{
    let gs = λ (xs: List<Nat>) => store(xs, v, iv, vv);
    let nv = cur.update(iv, λ _ => vv);
    let here: (list_at(file.update(v.b, gs), v.b) = store(list_at(file, v.b), v, iv, vv)) = list_at_update_here(file, v.b, gs, buf);
    let nlen: (nv.len() = v.len) = prelude::trans(cur.len_update(iv, λ _ => vv), on.len);
    let holds: Holds(list_at(file.update(v.b, gs), v.b), v.base, nv) = λ i lt => prelude::trans(cong_fn(λ (l: List<Nat>) => l.nth(v.base + i), here),
        match q: i.same(iv) {
            True => {
                let e: (i = iv) = i.same_sound(iv, q);
                let lt2: (iv < v.len) = omega(e, lt, nlen);
                j(sym(e), λ a _ => store(list_at(file, v.b), v, iv, vv).nth(v.base + a) = nv.nth(a),
                    prelude::trans(store_here(list_at(file, v.b), v, iv, vv, lt2, omega(lt2, fits)), sym(cur.nth_update_set(iv, vv, omega(lt2, on.len)))))
            },
            False => {
                let ne: (i ≠ iv) = i.ne_of_same(iv, q);
                prelude::trans(store_other(list_at(file, v.b), v, iv, vv, v.base + i, λ _ h => ne(omega(h))),
                    prelude::trans(on.holds(i, omega(lt, nlen, on.len)), sym(cur.nth_update_other(iv, λ _ => vv, i, ne))))
            },
        });
    OnRef(nlen, holds,
        λ p out => prelude::trans(cong_fn(λ (l: List<Nat>) => l.nth(p), here),
            prelude::trans(store_other(list_at(file, v.b), v, iv, vv, p, λ lt h => out(omega(h, lt))), on.out(p, out))),
        λ k2 ne => prelude::trans(list_at_update_other(file, v.b, gs, k2, ne), on.other(k2, ne)),
        prelude::trans(file.len_update(v.b, gs), on.shape),
        prelude::trans(cong_fn(λ (l: List<Nat>) => l.len(), here), prelude::trans(store_len(list_at(file, v.b), v, iv, vv), on.blen)))
}

// ---------------------------------------------------------------------------
// What a reference keeps

// `file2` agrees with `file` on the reference's span.
fn Keeps(file, file2: List<List<Nat>>, v: Ref) → Type { (p: Nat) → Span(v.base, v.len).has(p).IsTrue() → list_at(file2, v.b).nth(p) = list_at(file, v.b).nth(p) }

// Two references apart: no position of the first is in the second.
fn Ref::Apart(self u: Ref, v: Ref) → Type { (p: Nat) → Span(u.base, u.len).has(p).IsTrue() → ¬Span(v.base, v.len).has(p).IsTrue() }

theorem Ref::apart_moved(u, u2, v, v2: Ref, e1: u = u2, e2: v = v2, ap: u.Apart(v)): u2.Apart(v2) { j(e2, λ q _ => u2.Apart(q), j(e1, λ q _ => q.Apart(v), ap)) }

// A store misses a reference whose span does not hold its position.
theorem stored_keeps(file: List<List<Nat>>, w: Ref, iv, vv: Nat, buf: w.b < file.len(), v: Ref, eb: v.b = w.b,
    miss: (p: Nat) → Span(v.base, v.len).has(p).IsTrue() → iv < w.len → p ≠ w.base + iv): Keeps(file, file.update(w.b, λ xs => store(xs, w, iv, vv)), v)
{
    λ p hp => j(sym(eb), λ b _ => list_at(file.update(w.b, λ xs => store(xs, w, iv, vv)), b).nth(p) = list_at(file, b).nth(p),
        prelude::trans(cong_fn(λ (l: List<Nat>) => l.nth(p), list_at_update_here(file, w.b, λ xs => store(xs, w, iv, vv), buf)),
            store_other(list_at(file, w.b), w, iv, vv, p, miss(p, hp))))
}

// A write through `u` keeps a reference apart from it.
theorem OnRef::keeps_apart({file, file2: List<List<Nat>>}, {u: Ref}, {val: List<Nat>}, self on: OnRef(file, file2, u, val), v: Ref, eb: v.b = u.b, ap: v.Apart(u)): Keeps(file, file2, v) {
    λ p hp => j(sym(eb), λ b _ => list_at(file2, b).nth(p) = list_at(file, b).nth(p), on.out(p, ap(p, hp)))
}

// A buffer that changed nothing keeps every reference into it.
theorem keeps_all(file1, file2: List<List<Nat>>, r: Ref, same: (p: Nat) → list_at(file2, r.b).nth(p) = list_at(file1, r.b).nth(p), v: Ref, eb: v.b = r.b): Keeps(file1, file2, v) {
    λ p _ => j(sym(eb), λ b _ => list_at(file2, b).nth(p) = list_at(file1, b).nth(p), same(p))
}

// ---------------------------------------------------------------------------
// The licence

// Two regions apart, in the words: no position covered by both.
fn Region::Clear(self a: Region, b: Region, r: Ref, ws: List<Nat>) → Type { (p: Nat) → a.hits(r, ws, p).IsTrue() → ¬b.hits(r, ws, p).IsTrue() }

// An access the live view meets is clear of it.
fn LView::Clear(self lv: LView, md: Mode, rg: Region, r: Ref, ws: List<Nat>) → Type { lv.meets(md) = True → lv.region.Clear(rg, r, ws) }

// A callee's atom read at a call's arguments.
theorem subst_var(args: List<Atom>, ws: List<Nat>): (i: Nat) → args.nth(i).unwrap_or(Lit(0)).val(ws) = word(vals(args, ws), i) {
    match args {
        Nil => λ i => refl,
        Cons(a, rest) => λ i => match i { Zero => refl, Succ(j1) => subst_var(rest, ws, j1) },
    }
}

theorem Atom::subst_val(self a: Atom, args: List<Atom>, ws: List<Nat>): a.subst(args).val(ws) = a.val(vals(args, ws)) {
    match a { Lit(_) => refl, Var(i) => subst_var(args, ws, i) }
}

theorem Region::subst_hits(self rg: Region, args: List<Atom>, r: Ref, ws: List<Nat>, p: Nat): rg.subst(args).hits(r, ws, p) = rg.hits(r, vals(args, ws), p) {
    match rg {
        Whole => refl,
        Win(lo, n) => prelude::trans(cong_fn(λ (x: Nat) => Span(r.base + x, n.subst(args).val(ws)).has(p), lo.subst_val(args, ws)),
            cong_fn(λ (y: Nat) => Span(r.base + lo.val(vals(args, ws)), y).has(p), n.subst_val(args, ws))),
        Both(a, b) => prelude::trans(cong_fn(λ (x: Bool) => x || b.subst(args).hits(r, ws, p), a.subst_hits(args, r, ws, p)),
            cong_fn(λ (y: Bool) => a.hits(r, vals(args, ws), p) || y, b.subst_hits(args, r, ws, p))),
    }
}

theorem Bool::or_true_cases(a, b: Bool, h: (a || b).IsTrue()): a.IsTrue() ∨ b.IsTrue() {
    (match a as λ x => (x || b).IsTrue() → x.IsTrue() ∨ b.IsTrue() { True => λ _ => Inl(trivial), False => λ hb => Inr(hb) })(h)
}

theorem Bool::or_not_true(a, b: Bool, na: ¬a.IsTrue(), nb: ¬b.IsTrue()): ¬(a || b).IsTrue() {
    λ h => match Bool::or_true_cases(a, b, h) { Inl(x) => na(x), Inr(y) => nb(y) }
}

theorem Bool::or_true_left(a, b: Bool, h: a.IsTrue()): (a || b).IsTrue() {
    (match a as λ x => x.IsTrue() → (x || b).IsTrue() { True => λ _ => trivial, False => λ no => false_elim(no) })(h)
}

theorem Bool::or_true_right(a, b: Bool, h: b.IsTrue()): (a || b).IsTrue() {
    (match a as λ x => (x || b).IsTrue() { True => trivial, False => h })
}

theorem Owed::all_append(rs: List<Owed>, pres: Nat → List<Nat> → Type): (qs: List<Owed>) → (ws: List<Nat>) → Owed::All(rs ++ qs, pres, ws) → Owed::All(rs, pres, ws) ∧ Owed::All(qs, pres, ws) {
    match rs {
        Nil => λ qs ws h => ⟨trivial, h⟩,
        Cons(_, rest) => λ qs ws h => {
            let p = Owed::all_append(rest, pres, qs, ws, h.right);
            ⟨⟨h.left, p.left⟩, p.right⟩
        },
    }
}

theorem Owed::all_dues(os: List<Obligation>, pres: Nat → List<Nat> → Type, ws: List<Nat>): Owed::All(os.map(λ ob => Due(ob)), pres, ws) → Obligation::All(os, ws) {
    match os {
        Nil => λ _ => trivial,
        Cons(_, rest) => λ h => ⟨h.left, Owed::all_dues(rest, pres, ws, h.right)⟩,
    }
}

theorem spans_license_sound(lo1, n1, lo2, n2: Atom, pres: Nat → List<Nat> → Type, ws: List<Nat>, r1: List<Owed>, ok: dues(Spans(lo1, n1, lo2, n2).settle()) = Some(r1),
    hold: Owed::All(r1, pres, ws)): Span(lo1.val(ws), n1.val(ws)).apart(Span(lo2.val(ws), n2.val(ws))).IsTrue()
{
    let st = option_map_some(Spans(lo1, n1, lo2, n2).settle(), λ os => os.map(λ ob => Due(ob)), r1, ok);
    let owed: Owed::All(st.witness.map(λ ob => Due(ob)), pres, ws) = j(sym(st.proof.right), λ q _ => Owed::All(q, pres, ws), hold);
    Spans(lo1, n1, lo2, n2).settle_sound(ws, st.witness, st.proof.left, Owed::all_dues(st.witness, pres, ws, owed))
}

theorem Region::license_win_sound(lo1, n1: Atom, b: Region, pres: Nat → List<Nat> → Type, ws: List<Nat>, r: Ref): (r1: List<Owed>) →
    Region::license_win(lo1, n1, b) = Some(r1) → Owed::All(r1, pres, ws) → Win(lo1, n1).Clear(b, r, ws)
{
    match b {
        Whole => λ r1 no _ => absurd(no),
        Win(lo2, n2) => λ r1 ok hold => {
            let ap = spans_license_sound(lo1, n1, lo2, n2, pres, ws, r1, ok, hold);
            λ p h1 h2 => {
                let x1: (Span(r.base + lo1.val(ws), n1.val(ws)).has(p).IsTrue()) = h1;
                let x2: (Span(r.base + lo2.val(ws), n2.val(ws)).has(p).IsTrue()) = h2;
                omega(ap, x1, x2)
            }
        },
        Both(b1, b2) => λ r1 ok hold => {
            let st = Option::and_then_some(Region::license_win(lo1, n1, b1), λ q1 => Region::license_win(lo1, n1, b2).map(λ q2 => q1 ++ q2), r1, ok);
            let mp = option_map_some(Region::license_win(lo1, n1, b2), λ q2 => st.witness ++ q2, r1, st.proof.right);
            let parts = Owed::all_append(st.witness, pres, mp.witness, ws, j(sym(mp.proof.right), λ q _ => Owed::All(q, pres, ws), hold));
            let c1 = Region::license_win_sound(lo1, n1, b1, pres, ws, r, st.witness, st.proof.left, parts.left);
            let c2 = Region::license_win_sound(lo1, n1, b2, pres, ws, r, mp.witness, mp.proof.left, parts.right);
            λ p h1 => Bool::or_not_true(b1.hits(r, ws, p), b2.hits(r, ws, p), c1(p, h1), c2(p, h1))
        },
    }
}

theorem Region::license_sound(self a: Region, b: Region, pres: Nat → List<Nat> → Type, ws: List<Nat>, r: Ref): (r1: List<Owed>) → a.license(b) = Some(r1) →
    Owed::All(r1, pres, ws) → a.Clear(b, r, ws)
{
    match a {
        Whole => λ r1 no _ => absurd(no),
        Win(lo1, n1) => λ r1 ok hold => Region::license_win_sound(lo1, n1, b, pres, ws, r, r1, ok, hold),
        Both(a1, a2) => λ r1 ok hold => {
            let st = Option::and_then_some(a1.license(b), λ q1 => a2.license(b).map(λ q2 => q1 ++ q2), r1, ok);
            let mp = option_map_some(a2.license(b), λ q2 => st.witness ++ q2, r1, st.proof.right);
            let parts = Owed::all_append(st.witness, pres, mp.witness, ws, j(sym(mp.proof.right), λ q _ => Owed::All(q, pres, ws), hold));
            let c1 = a1.license_sound(b, pres, ws, r, st.witness, st.proof.left, parts.left);
            let c2 = a2.license_sound(b, pres, ws, r, mp.witness, mp.proof.left, parts.right);
            λ p h => match Bool::or_true_cases(a1.hits(r, ws, p), a2.hits(r, ws, p), h) { Inl(x) => c1(p, x), Inr(y) => c2(p, y) }
        },
    }
}

// Nothing is licensed against the whole object.
theorem Region::license_whole(self a: Region): a.license(Whole) = None {
    match a {
        Whole => refl,
        Win(_, _) => refl,
        Both(a1, a2) => j(sym(a1.license_whole()), λ o _ => o.and_then(λ r1 => a2.license(Whole).map(λ r2 => r1 ++ r2)) = None, refl),
    }
}

theorem LView::license_sound(self lv: LView, md: Mode, rg: Region, pres: Nat → List<Nat> → Type, ws: List<Nat>, r: Ref, r1: List<Owed>, ok: lv.license(md, rg) = Some(r1),
    hold: Owed::All(r1, pres, ws)): lv.Clear(md, rg, r, ws)
{
    λ meets => lv.region.license_sound(rg, pres, ws, r, r1, j(meets, λ b _ => (match b { True => lv.region.license(rg), False => Some(Nil<Owed>) }) = Some(r1), ok), hold)
}

// Every live view the access meets is clear of it.
theorem license_live_sound(live: List<LView>, md: Mode, rg: Region, pres: Nat → List<Nat> → Type, ws: List<Nat>, r: Ref): (rs: List<Owed>) → license_live(live, md, rg) = Some(rs) →
    Owed::All(rs, pres, ws) → (lv: LView) → Mem(lv, live) → lv.Clear(md, rg, r, ws)
{
    match live {
        Nil => λ rs ok hold lv m => false_elim(m),
        Cons(h, rest) => λ rs ok hold => {
            let st = Option::and_then_some(h.license(md, rg), λ r1 => license_live(rest, md, rg).map(λ r2 => r1 ++ r2), rs, ok);
            let mp = option_map_some(license_live(rest, md, rg), λ r2 => st.witness ++ r2, rs, st.proof.right);
            let parts = Owed::all_append(st.witness, pres, mp.witness, ws, j(sym(mp.proof.right), λ q _ => Owed::All(q, pres, ws), hold));
            λ lv m => match m {
                Inl(e) => j(sym(e), λ x _ => x.Clear(md, rg, r, ws), h.license_sound(md, rg, pres, ws, r, st.witness, st.proof.left, parts.left)),
                Inr(m2) => license_live_sound(rest, md, rg, pres, ws, r, mp.witness, mp.proof.left, parts.right, lv, m2),
            }
        },
    }
}

// Each live view the licence passed answered it.
theorem license_live_each(live: List<LView>, md: Mode, rg: Region): (rs: List<Owed>) → license_live(live, md, rg) = Some(rs) →
    (lv: LView) → Mem(lv, live) → Exists<List<Owed>>(λ r1 => lv.license(md, rg) = Some(r1))
{
    match live {
        Nil => λ rs ok lv m => false_elim(m),
        Cons(h, rest) => λ rs ok => {
            let st = Option::and_then_some(h.license(md, rg), λ r1 => license_live(rest, md, rg).map(λ r2 => r1 ++ r2), rs, ok);
            let mp = option_map_some(license_live(rest, md, rg), λ r2 => st.witness ++ r2, rs, st.proof.right);
            λ lv m => match m {
                Inl(e) => j(sym(e), λ x _ => Exists<List<Owed>>(λ r1 => x.license(md, rg) = Some(r1)), Exists(st.witness, st.proof.left)),
                Inr(m2) => license_live_each(rest, md, rg, mp.witness, mp.proof.left, lv, m2),
            }
        },
    }
}

theorem find_live_sound(live: List<LView>, t: Nat): (lv: LView) → find_live(live, t) = Some(lv) → Mem(lv, live) ∧ (lv.t = t) {
    match live {
        Nil => λ lv no => absurd(no),
        Cons(h, rest) => match q: h.t.same(t) {
            True => λ lv e => {
                let eh: (h = lv) = Option::some_inj(h, lv, e);
                j(eh, λ x _ => Mem(x, Cons(h, rest)) ∧ (x.t = t), ⟨Inl(refl), h.t.same_sound(t, q)⟩)
            },
            False => λ lv e => {
                let p = find_live_sound(rest, t, lv, e);
                ⟨Inr(p.left), p.right⟩
            },
        },
    }
}

// A lent name is a live write view.
theorem is_lent_sound(live: List<LView>, t: Nat, h: is_lent(live, t) = True): Exists<LView>(λ lv => (Mem(lv, live) ∧ (lv.t = t)) ∧ (lv.md.writes() = True)) {
    (match find_live(live, t) as λ o => find_live(live, t) = o → (match o { None => False, Some(lv) => lv.md.writes() }) = True →
            Exists<LView>(λ lv => (Mem(lv, live) ∧ (lv.t = t)) ∧ (lv.md.writes() = True)) {
        None => λ _ no => absurd(no),
        Some(lv) => λ e w => Exists(lv, ⟨find_live_sound(live, t, lv, e), w⟩),
    })(refl, h)
}

// ---------------------------------------------------------------------------
// The invariant: a usable place reads its value

// A live view of the checker, of the run and of the meaning agree: the
// run's view is in the reference's buffer, inside the span the checker
// says it covers, and reads what the meaning's view holds.
record ViewOk(rg: Region, v: Ref, val: List<Nat>, r: Ref, file: List<List<Nat>>, ws: List<Nat>) {
    at_b: v.b = r.b,
    within: (p: Nat) → Span(v.base, v.len).has(p).IsTrue() → rg.hits(r, ws, p).IsTrue(),
    reads: (i: Nat) → word(val, i) = rget(file, v, i),
}

// A view reads only its window: a file that agrees there keeps it.
theorem ViewOk::reframe({rg: Region}, {v: Ref}, {val: List<Nat>}, {r: Ref}, {file: List<List<Nat>>}, {ws: List<Nat>}, self o: ViewOk(rg, v, val, r, file, ws),
    file2: List<List<Nat>>, same: Keeps(file, file2, v)): ViewOk(rg, v, val, r, file2, ws)
{
    ViewOk(o.at_b, o.within, λ i => prelude::trans(o.reads(i), match q: (i + 1).leb(v.len) {
        True => cong_fn(λ (x: Option<Nat>) => x.unwrap_or(0), sym(same(v.base + i, Span(v.base, v.len).has_intro(v.base + i, omega(), omega(q))))),
        False => refl,
    }))
}

// A view whose reference now holds another value reads that one.
theorem ViewOk::rewritten({rg: Region}, {v: Ref}, {val: List<Nat>}, {r: Ref}, {file: List<List<Nat>>}, {ws: List<Nat>}, self o: ViewOk(rg, v, val, r, file, ws),
    file2: List<List<Nat>>, nv: List<Nat>, h: Holds(list_at(file2, v.b), v.base, nv), len: nv.len() = v.len): ViewOk(rg, v, nv, r, file2, ws)
{
    ViewOk(o.at_b, o.within, λ i => sym(rget_holds(file2, v, nv, h, len, i)))
}

theorem ViewOk::moved(rg: Region, v, v2: Ref, val, val2: List<Nat>, r: Ref, file: List<List<Nat>>, ws: List<Nat>, e1: v = v2, e2: val = val2,
    o: ViewOk(rg, v, val, r, file, ws)): ViewOk(rg, v2, val2, r, file, ws)
{
    j(e2, λ q _ => ViewOk(rg, v2, q, r, file, ws), j(e1, λ q _ => ViewOk(rg, q, val, r, file, ws), o))
}

// A write view: its reference is the window its slot names, cut to the
// holder's reference, and it holds the viewer's value. With eager
// write-back the holder holds the same value there (`Sim.on`): the
// viewer's value is current and so is the holder's.
record Lent(v: Ref, val: List<Nat>, slot: Nat, r: Ref, file: List<List<Nat>>) {
    n: Nat,
    at: v = narrow(r, slot, n),
    len: val.len() = v.len,
    holds: Holds(list_at(file, v.b), v.base, val),
}

theorem Lent::reframe({v: Ref}, {val: List<Nat>}, {slot: Nat}, {r: Ref}, {file: List<List<Nat>>}, self l: Lent(v, val, slot, r, file),
    file2: List<List<Nat>>, same: Keeps(file, file2, v)): Lent(v, val, slot, r, file2)
{
    Lent(l.n, l.at, l.len, λ i lt => prelude::trans(same(v.base + i, Span(v.base, v.len).has_intro(v.base + i, omega(), omega(lt, l.len))), l.holds(i, lt)))
}

theorem Lent::moved(v, v2: Ref, val, val2: List<Nat>, slot, slot2: Nat, r: Ref, file: List<List<Nat>>, e1: v = v2, e2: val = val2, e3: slot = slot2,
    l: Lent(v, val, slot, r, file)): Lent(v2, val2, slot2, r, file)
{
    j(e3, λ q _ => Lent(v2, val2, q, r, file), j(e2, λ q _ => Lent(v2, q, slot, r, file), j(e1, λ q _ => Lent(q, val, slot, r, file), l)))
}

// Where a write view lies: in the holder's buffer, inside its reference.
theorem Lent::inside({v: Ref}, {val: List<Nat>}, {slot: Nat}, {r: Ref}, {file: List<List<Nat>>}, self l: Lent(v, val, slot, r, file)):
    (v.b = r.b) ∧ ((r.base <= v.base) ∧ (v.base + v.len <= r.base + r.len))
{
    let lo_in: (r.base <= r.base + slot.min(r.len)) = omega();
    let hi_in: (r.base + slot.min(r.len) + l.n.min(r.len - slot) <= r.base + r.len) = omega();
    j(sym(l.at), λ q _ => (q.b = r.b) ∧ ((r.base <= q.base) ∧ (q.base + q.len <= r.base + r.len)), ⟨refl, ⟨lo_in, hi_in⟩⟩)
}

// What a function's body keeps fixed: its frame.
record Frame { mode: Mode, sigs: List<Sig>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, w: World, r: Ref, file0: List<List<Nat>>, arg: List<Nat> }

// The simulation's invariant, in the words `ws` the meaning ends with: the
// counts agree; the file holds the place's value in the reference and its
// first contents elsewhere; a read parameter is what it was; each live view
// reads its value; each live write view holds its value at the window its
// slot names; and a live write view is apart from every other live view
// (the place is `out` to it alone). No state beyond the place states: the
// file holds the holder's value inside the out windows too, since
// write-back is eager.
record Sim(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>) {
    words: m.words = s.words,
    nw: c.nw = s.words.len(),
    nviews: s.views.len() = c.nviews,
    nslots: s.slots.len() = c.nviews,
    mviews: m.views.len() = c.nviews,
    on: OnRef(k.file0, m.file, k.r, s.cur),
    fixed: k.mode.writes() = False → s.cur = k.arg,
    views: (lv: LView) → Mem(lv, c.live) → (lv.t < c.nviews) ∧ ViewOk(lv.region, ref_at(m.views, lv.t), list_at(s.views, lv.t), k.r, m.file, ws),
    lent: (lv: LView) → Mem(lv, c.live) → lv.md.writes() = True → (k.mode.writes() = True) ∧ Lent(ref_at(m.views, lv.t), list_at(s.views, lv.t), word(s.slots, lv.t), k.r, m.file),
    excl: (a, b: LView) → Mem(a, c.live) → Mem(b, c.live) → a.md.writes() = True → a.t ≠ b.t → ref_at(m.views, a.t).Apart(ref_at(m.views, b.t)),
}

// ---------------------------------------------------------------------------
// The cores: what each kind of statement does to the invariant

// The narrowed reference holds the value's window.
theorem narrow_holds(buf: List<Nat>, r: Ref, cur: List<Nat>, h: Holds(buf, r.base, cur), len: cur.len() = r.len, lo, n: Nat):
    (window(cur, lo, n).len() = narrow(r, lo, n).len) ∧ Holds(buf, narrow(r, lo, n).base, window(cur, lo, n))
{
    let wl: (window(cur, lo, n).len() = n.min(cur.len() - lo)) = window_len(cur, lo, n);
    ⟨omega(wl, len), λ i lt => {
        let in_w: (i < n) = omega(lt, wl);
        let in_cur: (i + lo < cur.len()) = omega(lt, wl);
        let at: (r.base + lo.min(r.len) + i = r.base + (i + lo)) = omega(lt, wl, len);
        prelude::trans(cong_fn(λ (p: Nat) => buf.nth(p), at), prelude::trans(h(i + lo, in_cur), sym(window_nth_in(cur, lo, n, i, in_w))))
    }⟩
}

theorem Atom::bound_at(self a: Atom, c: Places, s: Sem, e: a.bound(c.nw) = True, nw: c.nw = s.words.len()): a.bound(s.words.len()) = True {
    j(nw, λ n _ => a.bound(n) = True, e)
}

// A statement that binds a word and changes nothing else.
theorem Sim::said({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), a, b: Nat, e: a = b):
    Sim(k, c.said(), s.bind(b), m.bind(a), ws)
{
    Sim(prelude::trans(cong_fn(λ (w: List<Nat>) => w ++ [a], sim.words), cong_fn(λ (x: Nat) => s.words ++ [x], e)),
        prelude::trans(cong_fn(λ (n: Nat) => n + 1, sim.nw), sym(len_snoc(s.words, b))),
        sim.nviews, sim.nslots, sim.mviews, sim.on, sim.fixed, sim.views, sim.lent, sim.excl)
}

// The owner reads its place's value wherever it reads, whatever is lent:
// with eager write-back the buffer holds the holder's value inside its out
// windows as well. So refusing an owner's read of a lent part is policy,
// not soundness (§15.7, open item 4).
theorem Sim::owner_reads({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), i: Nat): rget(m.file, k.r, i) = word(s.cur, i) {
    rget_holds(m.file, k.r, s.cur, sim.on.holds, sim.on.len, i)
}

// A store by the owner, apart from every live view.
theorem Sim::set_at({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), inr: InRef(k.file0, k.r), writes: k.mode.writes() = True,
    iv, vv: Nat, misses: (lv: LView) → Mem(lv, c.live) → (p: Nat) → Span(ref_at(m.views, lv.t).base, ref_at(m.views, lv.t).len).has(p).IsTrue() → iv < k.r.len → p ≠ k.r.base + iv):
    Sim(k, c, Sem(s.cur.update(iv, λ _ => vv), s.views, s.slots, s.words), m.put(k.r, iv, vv), ws)
{
    let r = k.r;
    let buf: (r.b < m.file.len()) = omega(inr.buf, sim.on.shape);
    let fits: (r.base + r.len <= list_at(m.file, r.b).len()) = omega(inr.fits, sim.on.blen);
    let file2 = m.file.update(r.b, λ xs => store(xs, r, iv, vv));
    Sim(sim.words, sim.nw, sim.nviews, sim.nslots, sim.mviews, OnRef::stored(k.file0, m.file, r, s.cur, sim.on, buf, fits, iv, vv),
        λ no => absurd(prelude::trans(sym(writes), no)),
        λ lv mem => ⟨sim.views(lv, mem).left,
            sim.views(lv, mem).right.reframe(file2, stored_keeps(m.file, r, iv, vv, buf, ref_at(m.views, lv.t), sim.views(lv, mem).right.at_b, misses(lv, mem)))⟩,
        λ lv mem w => ⟨sim.lent(lv, mem, w).left,
            sim.lent(lv, mem, w).right.reframe(file2, stored_keeps(m.file, r, iv, vv, buf, ref_at(m.views, lv.t), sim.views(lv, mem).right.at_b, misses(lv, mem)))⟩,
        sim.excl)
}

// The live views after a new one: the old ones keep their references and
// values.
theorem opened_views(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), nlv: LView, et: nlv.t = c.nviews, nr: Ref, val: List<Nat>,
    fresh: ViewOk(nlv.region, nr, val, k.r, m.file, ws)):
    (lv: LView) → Mem(lv, Cons(nlv, c.live)) → (lv.t < c.nviews + 1) ∧ ViewOk(lv.region, ref_at(m.views ++ [nr], lv.t), list_at(s.views ++ [val], lv.t), k.r, m.file, ws)
{
    λ lv mem => match mem {
        Inl(e) => j(sym(e), λ l _ => (l.t < c.nviews + 1) ∧ ViewOk(l.region, ref_at(m.views ++ [nr], l.t), list_at(s.views ++ [val], l.t), k.r, m.file, ws),
            ⟨omega(et), ViewOk::moved(nlv.region, nr, ref_at(m.views ++ [nr], nlv.t), val, list_at(s.views ++ [val], nlv.t), k.r, m.file, ws,
                sym(ref_at_snoc_at(m.views, nr, nlv.t, prelude::trans(sim.mviews, sym(et)))),
                sym(list_at_snoc_at(s.views, val, nlv.t, prelude::trans(sim.nviews, sym(et)))), fresh)⟩),
        Inr(m2) => {
            let old = sim.views(lv, m2);
            ⟨omega(old.left), ViewOk::moved(lv.region, ref_at(m.views, lv.t), ref_at(m.views ++ [nr], lv.t), list_at(s.views, lv.t), list_at(s.views ++ [val], lv.t), k.r, m.file, ws,
                sym(ref_at_snoc_below(m.views, nr, lv.t, omega(old.left, sim.mviews))),
                sym(list_at_snoc_below(s.views, val, lv.t, omega(old.left, sim.nviews))), old.right)⟩
        },
    }
}

theorem opened_lent(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), nlv: LView, et: nlv.t = c.nviews, nr: Ref, val: List<Nat>, slot: Nat,
    fresh: nlv.md.writes() = True → (k.mode.writes() = True) ∧ Lent(nr, val, slot, k.r, m.file)):
    (lv: LView) → Mem(lv, Cons(nlv, c.live)) → lv.md.writes() = True →
        (k.mode.writes() = True) ∧ Lent(ref_at(m.views ++ [nr], lv.t), list_at(s.views ++ [val], lv.t), word(s.slots ++ [slot], lv.t), k.r, m.file)
{
    λ lv mem => match mem {
        Inl(e) => j(sym(e), λ l _ => l.md.writes() = True →
                (k.mode.writes() = True) ∧ Lent(ref_at(m.views ++ [nr], l.t), list_at(s.views ++ [val], l.t), word(s.slots ++ [slot], l.t), k.r, m.file),
            λ w => {
                let f = fresh(w);
                ⟨f.left, Lent::moved(nr, ref_at(m.views ++ [nr], nlv.t), val, list_at(s.views ++ [val], nlv.t), slot, word(s.slots ++ [slot], nlv.t), k.r, m.file,
                    sym(ref_at_snoc_at(m.views, nr, nlv.t, prelude::trans(sim.mviews, sym(et)))),
                    sym(list_at_snoc_at(s.views, val, nlv.t, prelude::trans(sim.nviews, sym(et)))),
                    sym(word_snoc_at(s.slots, slot, nlv.t, prelude::trans(sim.nslots, sym(et)))), f.right)⟩
            }),
        Inr(m2) => λ w => {
            let lt: (lv.t < c.nviews) = sim.views(lv, m2).left;
            let old = sim.lent(lv, m2, w);
            ⟨old.left, Lent::moved(ref_at(m.views, lv.t), ref_at(m.views ++ [nr], lv.t), list_at(s.views, lv.t), list_at(s.views ++ [val], lv.t),
                word(s.slots, lv.t), word(s.slots ++ [slot], lv.t), k.r, m.file,
                sym(ref_at_snoc_below(m.views, nr, lv.t, omega(lt, sim.mviews))),
                sym(list_at_snoc_below(s.views, val, lv.t, omega(lt, sim.nviews))),
                sym(word_snoc_below(s.slots, slot, lv.t, omega(lt, sim.nslots))), old.right)⟩
        },
    }
}

// The new view is apart from each old one it meets, both ways.
theorem opened_excl(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), nlv: LView, et: nlv.t = c.nviews, nr: Ref,
    clear: (lv: LView) → Mem(lv, c.live) → (nlv.md.writes() || lv.md.writes()) = True → nr.Apart(ref_at(m.views, lv.t)) ∧ ref_at(m.views, lv.t).Apart(nr)):
    (a, b: LView) → Mem(a, Cons(nlv, c.live)) → Mem(b, Cons(nlv, c.live)) → a.md.writes() = True → a.t ≠ b.t → ref_at(m.views ++ [nr], a.t).Apart(ref_at(m.views ++ [nr], b.t))
{
    let at_new: (ref_at(m.views ++ [nr], nlv.t) = nr) = ref_at_snoc_at(m.views, nr, nlv.t, prelude::trans(sim.mviews, sym(et)));
    λ a b ma mb w ne => match ma {
        Inl(ea) => match mb {
            Inl(eb) => false_elim(ne(prelude::trans(cong_fn(λ (x: LView) => x.t, ea), sym(cong_fn(λ (x: LView) => x.t, eb))))),
            Inr(mb2) => {
                let wn: (nlv.md.writes() = True) = prelude::trans(sym(cong_fn(λ (x: LView) => x.md.writes(), ea)), w);
                let ap = clear(b, mb2, Bool::or_of_left(nlv.md.writes(), b.md.writes(), wn));
                Ref::apart_moved(nr, ref_at(m.views ++ [nr], a.t), ref_at(m.views, b.t), ref_at(m.views ++ [nr], b.t),
                    sym(prelude::trans(cong_fn(λ (x: LView) => ref_at(m.views ++ [nr], x.t), ea), at_new)),
                    sym(ref_at_snoc_below(m.views, nr, b.t, omega(sim.views(b, mb2).left, sim.mviews))), ap.left)
            },
        },
        Inr(ma2) => match mb {
            Inl(eb) => {
                let ap = clear(a, ma2, Bool::or_of_right(nlv.md.writes(), a.md.writes(), w));
                Ref::apart_moved(ref_at(m.views, a.t), ref_at(m.views ++ [nr], a.t), nr, ref_at(m.views ++ [nr], b.t),
                    sym(ref_at_snoc_below(m.views, nr, a.t, omega(sim.views(a, ma2).left, sim.mviews))),
                    sym(prelude::trans(cong_fn(λ (x: LView) => ref_at(m.views ++ [nr], x.t), eb), at_new)), ap.right)
            },
            Inr(mb2) => Ref::apart_moved(ref_at(m.views, a.t), ref_at(m.views ++ [nr], a.t), ref_at(m.views, b.t), ref_at(m.views ++ [nr], b.t),
                sym(ref_at_snoc_below(m.views, nr, a.t, omega(sim.views(a, ma2).left, sim.mviews))),
                sym(ref_at_snoc_below(m.views, nr, b.t, omega(sim.views(b, mb2).left, sim.mviews))),
                sim.excl(a, b, ma2, mb2, w, ne)),
        },
    }
}

// A new view: it reads its value, a write view holds it at its slot, and
// it is apart from each live view it meets.
theorem Sim::opened({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), nlv: LView, et: nlv.t = c.nviews, nr: Ref, val: List<Nat>, slot: Nat,
    fresh: ViewOk(nlv.region, nr, val, k.r, m.file, ws),
    flent: nlv.md.writes() = True → (k.mode.writes() = True) ∧ Lent(nr, val, slot, k.r, m.file),
    clear: (lv: LView) → Mem(lv, c.live) → (nlv.md.writes() || lv.md.writes()) = True → nr.Apart(ref_at(m.views, lv.t)) ∧ ref_at(m.views, lv.t).Apart(nr)):
    Sim(k, Places(Cons(nlv, c.live), c.nviews + 1, c.nw), s.open(val, slot), Exec(m.file, m.views ++ [nr], m.words), ws)
{
    Sim(sim.words, sim.nw,
        prelude::trans(len_snoc(s.views, val), cong_fn(λ (q: Nat) => q + 1, sim.nviews)),
        prelude::trans(len_snoc(s.slots, slot), cong_fn(λ (q: Nat) => q + 1, sim.nslots)),
        prelude::trans(len_snoc(m.views, nr), cong_fn(λ (q: Nat) => q + 1, sim.mviews)),
        sim.on, sim.fixed,
        opened_views(k, c, s, m, ws, sim, nlv, et, nr, val, fresh),
        opened_lent(k, c, s, m, ws, sim, nlv, et, nr, val, slot, flent),
        opened_excl(k, c, s, m, ws, sim, nlv, et, nr, clear))
}

// A file whose buffer changed nothing keeps the invariant.
theorem Sim::refile({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), file2: List<List<Nat>>, after: OnRef(m.file, file2, k.r, s.cur)):
    Sim(k, c, s, Exec(file2, m.views, m.words), ws)
{
    let unchanged = OnRef::unchanged(m.file, file2, k.r, s.cur, sim.on.holds, after);
    Sim(sim.words, sim.nw, sim.nviews, sim.nslots, sim.mviews, OnRef::chain(k.file0, m.file, file2, k.r, s.cur, s.cur, sim.on, after), sim.fixed,
        λ lv mem => ⟨sim.views(lv, mem).left, sim.views(lv, mem).right.reframe(file2, keeps_all(m.file, file2, k.r, unchanged, ref_at(m.views, lv.t), sim.views(lv, mem).right.at_b))⟩,
        λ lv mem w => ⟨sim.lent(lv, mem, w).left, sim.lent(lv, mem, w).right.reframe(file2, keeps_all(m.file, file2, k.r, unchanged, ref_at(m.views, lv.t), sim.views(lv, mem).right.at_b))⟩,
        sim.excl)
}

// After a write through the write view `t`: each live view reads its value.
theorem backed_view(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), t: Nat, tlt: t < s.views.len(), nv: List<Nat>, file2: List<List<Nat>>,
    call: OnRef(m.file, file2, ref_at(m.views, t), nv), kept: (lv2: LView) → Mem(lv2, c.live) → t ≠ lv2.t → Keeps(m.file, file2, ref_at(m.views, lv2.t)),
    lv2: LView, mem2: Mem(lv2, c.live)): ViewOk(lv2.region, ref_at(m.views, lv2.t), list_at(s.views.update(t, λ _ => nv), lv2.t), k.r, file2, ws)
{
    let old = sim.views(lv2, mem2).right;
    match q: lv2.t.same(t) {
        True => {
            let e: (lv2.t = t) = lv2.t.same_sound(t, q);
            let here: (list_at(s.views.update(t, λ _ => nv), t) = nv) = list_at_update_here(s.views, t, λ _ => nv, tlt);
            let at_t: ViewOk(lv2.region, ref_at(m.views, t), list_at(s.views, t), k.r, m.file, ws) =
                j(e, λ u _ => ViewOk(lv2.region, ref_at(m.views, u), list_at(s.views, u), k.r, m.file, ws), old);
            let fresh: ViewOk(lv2.region, ref_at(m.views, t), list_at(s.views.update(t, λ _ => nv), t), k.r, file2, ws) =
                j(sym(here), λ x _ => ViewOk(lv2.region, ref_at(m.views, t), x, k.r, file2, ws), at_t.rewritten(file2, nv, call.holds, call.len));
            j(sym(e), λ u _ => ViewOk(lv2.region, ref_at(m.views, u), list_at(s.views.update(t, λ _ => nv), u), k.r, file2, ws), fresh)
        },
        False => {
            let ne: (lv2.t ≠ t) = lv2.t.ne_of_same(t, q);
            j(sym(list_at_update_other(s.views, t, λ _ => nv, lv2.t, ne)), λ x _ => ViewOk(lv2.region, ref_at(m.views, lv2.t), x, k.r, file2, ws),
                old.reframe(file2, kept(lv2, mem2, λ e => ne(sym(e)))))
        },
    }
}

// After a write through the write view `t`: each live write view holds its
// value.
theorem backed_lent(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), t: Nat, tlt: t < s.views.len(), nv: List<Nat>, file2: List<List<Nat>>,
    call: OnRef(m.file, file2, ref_at(m.views, t), nv), kept: (lv2: LView) → Mem(lv2, c.live) → t ≠ lv2.t → Keeps(m.file, file2, ref_at(m.views, lv2.t)),
    lv2: LView, mem2: Mem(lv2, c.live), w2: lv2.md.writes() = True):
    Lent(ref_at(m.views, lv2.t), list_at(s.views.update(t, λ _ => nv), lv2.t), word(s.slots, lv2.t), k.r, file2)
{
    let old = sim.lent(lv2, mem2, w2).right;
    match q: lv2.t.same(t) {
        True => {
            let e: (lv2.t = t) = lv2.t.same_sound(t, q);
            let here: (list_at(s.views.update(t, λ _ => nv), t) = nv) = list_at_update_here(s.views, t, λ _ => nv, tlt);
            let at_t: Lent(ref_at(m.views, t), list_at(s.views, t), word(s.slots, t), k.r, m.file) =
                j(e, λ u _ => Lent(ref_at(m.views, u), list_at(s.views, u), word(s.slots, u), k.r, m.file), old);
            let fresh: Lent(ref_at(m.views, t), list_at(s.views.update(t, λ _ => nv), t), word(s.slots, t), k.r, file2) =
                j(sym(here), λ x _ => Lent(ref_at(m.views, t), x, word(s.slots, t), k.r, file2), Lent(at_t.n, at_t.at, call.len, call.holds));
            j(sym(e), λ u _ => Lent(ref_at(m.views, u), list_at(s.views.update(t, λ _ => nv), u), word(s.slots, u), k.r, file2), fresh)
        },
        False => {
            let ne: (lv2.t ≠ t) = lv2.t.ne_of_same(t, q);
            j(sym(list_at_update_other(s.views, t, λ _ => nv, lv2.t, ne)), λ x _ => Lent(ref_at(m.views, lv2.t), x, word(s.slots, lv2.t), k.r, file2),
                old.reframe(file2, kept(lv2, mem2, λ e => ne(sym(e)))))
        },
    }
}

// A write through the live write view `lv` that leaves `nv` in its window
// and nothing changed outside it: the eager write-back puts `nv` at the
// view's slot, and every other view, apart from it, is kept.
theorem Sim::backed({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), lv: LView, mem: Mem(lv, c.live), w: lv.md.writes() = True,
    nv: List<Nat>, file2: List<List<Nat>>, call: OnRef(m.file, file2, ref_at(m.views, lv.t), nv)):
    Sim(k, c, s.back(lv.t, nv), Exec(file2, m.views, m.words), ws)
{
    let t = lv.t;
    let own = sim.lent(lv, mem, w);
    let l = own.right;
    let tlt: (t < s.views.len()) = omega(sim.views(lv, mem).left, sim.nviews);
    let call2: OnRef(m.file, file2, narrow(k.r, word(s.slots, t), l.n), nv) = j(l.at, λ q _ => OnRef(m.file, file2, q, nv), call);
    let on: OnRef(k.file0, file2, k.r, s.cur.put_window(word(s.slots, t), nv)) = written_back(k.file0, m.file, file2, k.r, s.cur, word(s.slots, t), l.n, nv, sim.on, call2);
    let vb: (ref_at(m.views, t).b = k.r.b) = l.inside().left;
    let kept = λ (lv2: LView) (mem2: Mem(lv2, c.live)) (ne: t ≠ lv2.t) =>
        call.keeps_apart(ref_at(m.views, lv2.t), prelude::trans(sim.views(lv2, mem2).right.at_b, sym(vb)), λ p hp hv => sim.excl(lv, lv2, mem, mem2, w, ne, p, hv, hp));
    Sim(sim.words, sim.nw, prelude::trans(s.views.len_update(t, λ _ => nv), sim.nviews), sim.nslots, sim.mviews, on,
        λ no => absurd(prelude::trans(sym(own.left), no)),
        λ lv2 mem2 => ⟨sim.views(lv2, mem2).left, backed_view(k, c, s, m, ws, sim, t, tlt, nv, file2, call, kept, lv2, mem2)⟩,
        λ lv2 mem2 w2 => ⟨sim.lent(lv2, mem2, w2).left, backed_lent(k, c, s, m, ws, sim, t, tlt, nv, file2, call, kept, lv2, mem2, w2)⟩,
        sim.excl)
}

// A call that was lent the write view `lv`: its promise, and nothing else
// of it, gives the eager write-back and the word it answers.
theorem Sim::called_core({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), inr: InRef(k.file0, k.r),
    lv: LView, mem: Mem(lv, c.live), w: lv.md.writes() = True, g: Nat, vs: List<Nat>, callee_pre: k.pres(g, vs), nargs: vs.len() = sig_at(k.sigs, g).words,
    safe_g: FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g))):
    Sim(k, c.said(), s.called(lv.t, k.w.mean(g, list_at(s.views, lv.t), vs)), Exec::lent(m, k.w.run(g, m.file, ref_at(m.views, lv.t), vs)), ws)
{
    let vr = ref_at(m.views, lv.t);
    let val = list_at(s.views, lv.t);
    let l = sim.lent(lv, mem, w).right;
    let ins = l.inside();
    let buf: (vr.b < m.file.len()) = omega(ins.left, inr.buf, sim.on.shape);
    let fits0: (vr.base + vr.len <= list_at(m.file, k.r.b).len()) = omega(ins.right, inr.fits, sim.on.blen);
    let fits: (vr.base + vr.len <= list_at(m.file, vr.b).len()) = j(sym(ins.left), λ b _ => vr.base + vr.len <= list_at(m.file, b).len(), fits0);
    let arg_is: (window(list_at(m.file, vr.b), vr.base, vr.len) = val) =
        j(l.len, λ q _ => window(list_at(m.file, vr.b), vr.base, q) = val, whole_window(list_at(m.file, vr.b), vr.base, val, l.holds, omega(fits, l.len)));
    let ro = k.w.run(g, m.file, vr, vs);
    let safe: Safe(sig_at(k.sigs, g).mode, sig_at(k.sigs, g).ret.region(), vs, k.posts(g, vs), m.file, vr, val, k.w.mean(g, val, vs), ro) =
        j(arg_is, λ q _ => Safe(sig_at(k.sigs, g).mode, sig_at(k.sigs, g).ret.region(), vs, k.posts(g, vs), m.file, vr, q, k.w.mean(g, q, vs), ro), safe_g(m.file, vr, vs, InRef(buf, fits), nargs, callee_pre));
    sim.backed(lv, mem, w, k.w.mean(g, val, vs).val, ro.file, safe.on).said(ro.word, k.w.mean(g, val, vs).word, safe.answer)
}

// A call that answered a read view of the object: the file is as it was,
// and the view, rebased on the caller's reference, lies where the callee's
// signature places it, read at the call's arguments (`rgc`).
theorem Sim::viewed_core({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), inr: InRef(k.file0, k.r),
    g: Nat, vs: List<Nat>, callee_pre: k.pres(g, vs), nargs: vs.len() = sig_at(k.sigs, g).words, safe_g: FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g)),
    reads_only: sig_at(k.sigs, g).mode.writes() = False, t: Nat, et: t = c.nviews, none_lent: (lv: LView) → Mem(lv, c.live) → lv.md.writes() = True → False,
    rgc: Region, place: (p: Nat) → sig_at(k.sigs, g).ret.region().hits(k.r, vs, p).IsTrue() → rgc.hits(k.r, ws, p).IsTrue()):
    Sim(k, Places(Cons(LView(t, Reads, rgc), c.live), c.nviews + 1, c.nw), s.open(k.w.mean(g, s.cur, vs).view, 0), Exec::viewed(m, k.r, k.w.run(g, m.file, k.r, vs)), ws)
{
    let r = k.r;
    let fits: (r.base + s.cur.len() <= list_at(m.file, r.b).len()) = omega(inr.fits, sim.on.blen, sim.on.len);
    let inref: InRef(m.file, r) = InRef(omega(inr.buf, sim.on.shape), omega(inr.fits, sim.on.blen));
    let arg_is: (window(list_at(m.file, r.b), r.base, r.len) = s.cur) =
        j(sim.on.len, λ l _ => window(list_at(m.file, r.b), r.base, l) = s.cur, whole_window(list_at(m.file, r.b), r.base, s.cur, sim.on.holds, fits));
    let ro = k.w.run(g, m.file, r, vs);
    let mo = k.w.mean(g, s.cur, vs);
    let safe: Safe(sig_at(k.sigs, g).mode, sig_at(k.sigs, g).ret.region(), vs, k.posts(g, vs), m.file, r, s.cur, mo, ro) =
        j(arg_is, λ q _ => Safe(sig_at(k.sigs, g).mode, sig_at(k.sigs, g).ret.region(), vs, k.posts(g, vs), m.file, r, q, k.w.mean(g, q, vs), ro), safe_g(m.file, r, vs, inref, nargs, callee_pre));
    let after: OnRef(m.file, ro.file, r, s.cur) = j(safe.keeps(reads_only), λ l _ => OnRef(m.file, ro.file, r, l), safe.on);
    let nr = Ref(r.b, r.base + ro.lo, ro.n);
    let fresh: ViewOk(rgc, nr, mo.view, r, ro.file, ws) = ViewOk(refl, λ p h => place(p, safe.view_in(p, h)), safe.view_reads);
    sim.refile(ro.file, after).opened(LView(t, Reads, rgc), et, nr, mo.view, 0, fresh, λ no => absurd(no),
        λ lv mem meets => false_elim(none_lent(lv, mem, meets)))
}

// ---------------------------------------------------------------------------
// Each statement keeps the invariant

theorem step_get(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), z: Nat, i: Atom, st: Next,
    ok: Get(z, i).check(k.mode, k.sigs, c) = Some(st)): Sim(k, st.next, Get(z, i).eval1(k.w, s), Get(z, i).run2(k.w, k.r, m), ws)
{
    let mk = λ (rs: List<Owed>) => Next(c.said(), rs);
    let p = (z.same(c.nw) && i.bound(c.nw)).then_some(license_live(c.live, Reads, Win(i, Lit(1))).map(mk), st, ok);
    let lic = option_map_some(license_live(c.live, Reads, Win(i, Lit(1))), mk, st, p.right);
    let reads: (rget(m.file, k.r, i.val(m.words)) = word(s.cur, i.val(s.words))) =
        prelude::trans(sim.owner_reads(i.val(m.words)), cong_fn(λ (w: List<Nat>) => word(s.cur, i.val(w)), sim.words));
    j(lic.proof.right, λ q _ => Sim(k, q.next, Get(z, i).eval1(k.w, s), Get(z, i).run2(k.w, k.r, m), ws),
        sim.said(rget(m.file, k.r, i.val(m.words)), word(s.cur, i.val(s.words)), reads))
}

theorem step_read(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), z, t: Nat, i: Atom, st: Next,
    ok: Read(z, t, i).check(k.mode, k.sigs, c) = Some(st)): Sim(k, st.next, Read(z, t, i).eval1(k.w, s), Read(z, t, i).run2(k.w, k.r, m), ws)
{
    let g = Next::of((z.same(c.nw) && find_live(c.live, t).is_some()) && i.bound(c.nw), Next(c.said(), Nil), st, ok);
    let g1 = Bool::and_true_parts(z.same(c.nw) && find_live(c.live, t).is_some(), i.bound(c.nw), g.left);
    let g2 = Bool::and_true_parts(z.same(c.nw), find_live(c.live, t).is_some(), g1.left);
    let found = some_of_is_some(find_live(c.live, t), g2.right);
    let fm = find_live_sound(c.live, t, found.witness, found.proof);
    let o: ViewOk(found.witness.region, ref_at(m.views, t), list_at(s.views, t), k.r, m.file, ws) =
        j(fm.right, λ u _ => ViewOk(found.witness.region, ref_at(m.views, u), list_at(s.views, u), k.r, m.file, ws), sim.views(found.witness, fm.left).right);
    let reads: (rget(m.file, ref_at(m.views, t), i.val(m.words)) = word(list_at(s.views, t), i.val(s.words))) =
        j(sym(sim.words), λ q _ => rget(m.file, ref_at(m.views, t), i.val(q)) = word(list_at(s.views, t), i.val(s.words)), sym(o.reads(i.val(s.words))));
    j(g.right, λ q _ => Sim(k, q.next, Read(z, t, i).eval1(k.w, s), Read(z, t, i).run2(k.w, k.r, m), ws),
        sim.said(rget(m.file, ref_at(m.views, t), i.val(m.words)), word(list_at(s.views, t), i.val(s.words)), reads))
}

theorem step_die(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), t: Nat, st: Next,
    ok: Die(t).check(k.mode, k.sigs, c) = Some(st)): Sim(k, st.next, Die(t).eval1(k.w, s), Die(t).run2(k.w, k.r, m), ws)
{
    let next = Next(Places(kill(c.live, t), c.nviews, c.nw), Nil);
    let g = Next::of(find_live(c.live, t).is_some(), next, st, ok);
    j(g.right, λ q _ => Sim(k, q.next, s, m, ws),
        Sim(sim.words, sim.nw, sim.nviews, sim.nslots, sim.mviews, sim.on, sim.fixed,
            λ lv mem => sim.views(lv, c.live.mem_filter(lv, λ (l: LView) => !l.t.same(t), mem)),
            λ lv mem w => sim.lent(lv, c.live.mem_filter(lv, λ (l: LView) => !l.t.same(t), mem), w),
            λ a b ma mb => sim.excl(a, b, c.live.mem_filter(a, λ (l: LView) => !l.t.same(t), ma), c.live.mem_filter(b, λ (l: LView) => !l.t.same(t), mb))))
}

theorem step_set(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), pre: Prefix(s.words, ws), inr: InRef(k.file0, k.r),
    i, v: Atom, st: Next, ok: Set(i, v).check(k.mode, k.sigs, c) = Some(st), hold: Owed::All(st.rs, k.pres, ws)):
    Sim(k, st.next, Set(i, v).eval1(k.w, s), Set(i, v).run2(k.w, k.r, m), ws)
{
    let mk = λ (rs: List<Owed>) => Next(c, rs);
    let p = ((k.mode.writes() && i.bound(c.nw)) && v.bound(c.nw)).then_some(license_live(c.live, Writes, Win(i, Lit(1))).map(mk), st, ok);
    let lic = option_map_some(license_live(c.live, Writes, Win(i, Lit(1))), mk, st, p.right);
    let hold_rs: Owed::All(lic.witness, k.pres, ws) = j(sym(lic.proof.right), λ q _ => Owed::All(q.rs, k.pres, ws), hold);
    let g1 = Bool::and_true_parts(k.mode.writes() && i.bound(c.nw), v.bound(c.nw), p.left);
    let g2 = Bool::and_true_parts(k.mode.writes(), i.bound(c.nw), g1.left);
    let i_ws: (i.val(ws) = i.val(s.words)) = i.val_stable(s.words, ws, pre, i.bound_at(c, s, g2.right, sim.nw));
    let misses = λ (lv: LView) (mem: Mem(lv, c.live)) (q: Nat) (hq: Span(ref_at(m.views, lv.t).base, ref_at(m.views, lv.t).len).has(q).IsTrue()) (_: i.val(s.words) < k.r.len) => {
        let cl = license_live_sound(c.live, Writes, Win(i, Lit(1)), k.pres, ws, k.r, lic.witness, lic.proof.left, hold_rs, lv, mem, refl);
        let no: (¬Span(k.r.base + i.val(ws), 1).has(q).IsTrue()) = cl(q, sim.views(lv, mem).right.within(q, hq));
        let ne: (q ≠ k.r.base + i.val(s.words)) = λ e => no(omega(e, i_ws));
        ne
    };
    let after = sim.set_at(inr, g2.left, i.val(s.words), v.val(s.words), misses);
    let at_m: Sim(k, c, Sem(s.cur.update(i.val(s.words), λ _ => v.val(s.words)), s.views, s.slots, s.words), m.put(k.r, i.val(m.words), v.val(m.words)), ws) =
        j(sym(sim.words), λ q _ => Sim(k, c, Sem(s.cur.update(i.val(s.words), λ _ => v.val(s.words)), s.views, s.slots, s.words), m.put(k.r, i.val(q), v.val(q)), ws), after);
    j(lic.proof.right, λ q _ => Sim(k, q.next, Set(i, v).eval1(k.w, s), Set(i, v).run2(k.w, k.r, m), ws), at_m)
}

// A narrowed reference lies in its window, read in the final words.
theorem narrow_within(r: Ref, lo, n: Atom, ws: List<Nat>, lov, nv: Nat, lo_ws: lo.val(ws) = lov, n_ws: n.val(ws) = nv):
    (q: Nat) → Span(narrow(r, lov, nv).base, narrow(r, lov, nv).len).has(q).IsTrue() → Win(lo, n).hits(r, ws, q).IsTrue()
{
    λ q h => {
        let inside: (Span(r.base + lo.val(ws), n.val(ws)).has(q).IsTrue()) = omega(h, lo_ws, n_ws);
        inside
    }
}

// A live view clear of a new view's window is apart from its reference,
// both ways.
theorem clear_apart(r: Ref, lo, n: Atom, ws: List<Nat>, lov, nv: Nat, lo_ws: lo.val(ws) = lov, n_ws: n.val(ws) = nv, rg: Region, v: Ref,
    cl: rg.Clear(Win(lo, n), r, ws), within: (p: Nat) → Span(v.base, v.len).has(p).IsTrue() → rg.hits(r, ws, p).IsTrue()): narrow(r, lov, nv).Apart(v) ∧ v.Apart(narrow(r, lov, nv))
{
    let inwin = narrow_within(r, lo, n, ws, lov, nv, lo_ws, n_ws);
    let gap: v.Apart(narrow(r, lov, nv)) = λ q hv hn => cl(q, within(q, hv))(inwin(q, hn));
    ⟨λ q hn hv => gap(q, hv, hn), gap⟩
}

// A new view of the window `lo..lo+n`: it reads the place's window, a write
// view holds it at its slot, and it is apart from each live view it meets.
theorem Sim::view_core({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), t: Nat, md: Mode, lo, n: Atom, et: t = c.nviews,
    lov, nv: Nat, lo_ws: lo.val(ws) = lov, n_ws: n.val(ws) = nv, mdok: md.writes() = True → k.mode.writes() = True,
    clears: (lv: LView) → Mem(lv, c.live) → (md.writes() || lv.md.writes()) = True → lv.region.Clear(Win(lo, n), k.r, ws)):
    Sim(k, Places(Cons(LView(t, md, Win(lo, n)), c.live), c.nviews + 1, c.nw), s.open(window(s.cur, lov, nv), lov), Exec(m.file, m.views ++ [narrow(k.r, lov, nv)], m.words), ws)
{
    let nh = narrow_holds(list_at(m.file, k.r.b), k.r, s.cur, sim.on.holds, sim.on.len, lov, nv);
    sim.opened(LView(t, md, Win(lo, n)), et, narrow(k.r, lov, nv), window(s.cur, lov, nv), lov,
        ViewOk(refl, narrow_within(k.r, lo, n, ws, lov, nv, lo_ws, n_ws), narrow_reads(m.file, k.r, s.cur, sim.on.holds, sim.on.len, lov, nv)),
        λ w => ⟨mdok(w), Lent(nv, refl, nh.left, nh.right)⟩,
        λ lv mem meets => clear_apart(k.r, lo, n, ws, lov, nv, lo_ws, n_ws, lv.region, ref_at(m.views, lv.t), clears(lv, mem, meets), sim.views(lv, mem).right.within))
}

theorem step_view(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), pre: Prefix(s.words, ws),
    t: Nat, md: Mode, lo, n: Atom, st: Next, ok: View(t, md, lo, n).check(k.mode, k.sigs, c) = Some(st), hold: Owed::All(st.rs, k.pres, ws)):
    Sim(k, st.next, View(t, md, lo, n).eval1(k.w, s), View(t, md, lo, n).run2(k.w, k.r, m), ws)
{
    let mk = λ (rs: List<Owed>) => Next(Places(Cons(LView(t, md, Win(lo, n)), c.live), c.nviews + 1, c.nw), rs);
    let p = ((((!md.writes() || k.mode.writes()) && t.same(c.nviews)) && lo.bound(c.nw)) && n.bound(c.nw)).then_some(license_live(c.live, md, Win(lo, n)).map(mk), st, ok);
    let lic = option_map_some(license_live(c.live, md, Win(lo, n)), mk, st, p.right);
    let hold_rs: Owed::All(lic.witness, k.pres, ws) = j(sym(lic.proof.right), λ q _ => Owed::All(q.rs, k.pres, ws), hold);
    let g1 = Bool::and_true_parts(((!md.writes() || k.mode.writes()) && t.same(c.nviews)) && lo.bound(c.nw), n.bound(c.nw), p.left);
    let g2 = Bool::and_true_parts((!md.writes() || k.mode.writes()) && t.same(c.nviews), lo.bound(c.nw), g1.left);
    let g3 = Bool::and_true_parts(!md.writes() || k.mode.writes(), t.same(c.nviews), g2.left);
    let core = sim.view_core(t, md, lo, n, t.same_sound(c.nviews, g3.right), lo.val(s.words), n.val(s.words),
        lo.val_stable(s.words, ws, pre, lo.bound_at(c, s, g2.right, sim.nw)), n.val_stable(s.words, ws, pre, n.bound_at(c, s, g1.right, sim.nw)),
        λ w => Bool::implies_of(md.writes(), k.mode.writes(), g3.left, w),
        λ lv mem meets => license_live_sound(c.live, md, Win(lo, n), k.pres, ws, k.r, lic.witness, lic.proof.left, hold_rs, lv, mem, meets));
    let at_m: Sim(k, mk(lic.witness).next, s.open(window(s.cur, lo.val(s.words), n.val(s.words)), lo.val(s.words)),
        Exec(m.file, m.views ++ [narrow(k.r, lo.val(m.words), n.val(m.words))], m.words), ws) =
        j(sym(sim.words), λ q _ => Sim(k, mk(lic.witness).next, s.open(window(s.cur, lo.val(s.words), n.val(s.words)), lo.val(s.words)),
            Exec(m.file, m.views ++ [narrow(k.r, lo.val(q), n.val(q))], m.words), ws), core);
    j(lic.proof.right, λ q _ => Sim(k, q.next, View(t, md, lo, n).eval1(k.w, s), View(t, md, lo, n).run2(k.w, k.r, m), ws), at_m)
}

// A store through a live write view: the store in place, and the eager
// write-back of the view's new value in the meaning.
theorem put_core(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), inr: InRef(k.file0, k.r),
    lv: LView, mem: Mem(lv, c.live), w: lv.md.writes() = True, iv, vv: Nat):
    Sim(k, c, s.back(lv.t, list_at(s.views, lv.t).update(iv, λ _ => vv)), m.put(ref_at(m.views, lv.t), iv, vv), ws)
{
    let vr = ref_at(m.views, lv.t);
    let val = list_at(s.views, lv.t);
    let l = sim.lent(lv, mem, w).right;
    let ins = l.inside();
    let buf: (vr.b < m.file.len()) = omega(ins.left, inr.buf, sim.on.shape);
    let fits0: (vr.base + vr.len <= list_at(m.file, k.r.b).len()) = omega(ins.right, inr.fits, sim.on.blen);
    let fits: (vr.base + vr.len <= list_at(m.file, vr.b).len()) = j(sym(ins.left), λ b _ => vr.base + vr.len <= list_at(m.file, b).len(), fits0);
    let call = OnRef::stored(m.file, m.file, vr, val, OnRef::here(m.file, vr, val, l.holds, l.len), buf, fits, iv, vv);
    sim.backed(lv, mem, w, val.update(iv, λ _ => vv), m.file.update(vr.b, λ xs => store(xs, vr, iv, vv)), call)
}

theorem step_put(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), inr: InRef(k.file0, k.r),
    t: Nat, i, v: Atom, st: Next, ok: Put(t, i, v).check(k.mode, k.sigs, c) = Some(st)):
    Sim(k, st.next, Put(t, i, v).eval1(k.w, s), Put(t, i, v).run2(k.w, k.r, m), ws)
{
    let g = Next::of((is_lent(c.live, t) && i.bound(c.nw)) && v.bound(c.nw), Next(c, Nil), st, ok);
    let g1 = Bool::and_true_parts(is_lent(c.live, t) && i.bound(c.nw), v.bound(c.nw), g.left);
    let g2 = Bool::and_true_parts(is_lent(c.live, t), i.bound(c.nw), g1.left);
    let found = is_lent_sound(c.live, t, g2.left);
    let core = put_core(k, c, s, m, ws, sim, inr, found.witness, found.proof.left.left, found.proof.right, i.val(s.words), v.val(s.words));
    let at_t = j(found.proof.left.right, λ u _ => Sim(k, c, s.back(u, list_at(s.views, u).update(i.val(s.words), λ _ => v.val(s.words))),
        m.put(ref_at(m.views, u), i.val(s.words), v.val(s.words)), ws), core);
    let at_m: Sim(k, c, s.back(t, list_at(s.views, t).update(i.val(s.words), λ _ => v.val(s.words))), m.put(ref_at(m.views, t), i.val(m.words), v.val(m.words)), ws) =
        j(sym(sim.words), λ q _ => Sim(k, c, s.back(t, list_at(s.views, t).update(i.val(s.words), λ _ => v.val(s.words))), m.put(ref_at(m.views, t), i.val(q), v.val(q)), ws), at_t);
    j(g.right, λ q _ => Sim(k, q.next, Put(t, i, v).eval1(k.w, s), Put(t, i, v).run2(k.w, k.r, m), ws), at_m)
}

// The callee's precondition at the call's arguments, from its residual.
theorem pre_at(pres: Nat → List<Nat> → Type, g: Nat, args: List<Atom>, ws, big: List<Nat>, pre: Prefix(ws, big), b: Atom::all_bound(args, ws.len()) = True,
    h: Pre(g, args).Holds(pres, big)): pres(g, vals(args, ws))
{
    j(Atom::vals_stable(args, ws, big, pre, b), λ q _ => pres(g, q), h)
}

theorem step_mut(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), pre: Prefix(s.words, ws), inr: InRef(k.file0, k.r),
    g, t: Nat, args: List<Atom>, z: Nat, safe_g: FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g)),
    st: Next, ok: CallMut(g, t, args, z).check(k.mode, k.sigs, c) = Some(st), hold: Owed::All(st.rs, k.pres, ws)):
    Sim(k, st.next, CallMut(g, t, args, z).eval1(k.w, s), CallMut(g, t, args, z).run2(k.w, k.r, m), ws)
{
    let sg = sig_at(k.sigs, g);
    let gd = Next::of(((!sg.ret.is_view() && is_lent(c.live, t)) && z.same(c.nw)) && (Atom::all_bound(args, c.nw) && args.len().same(sg.words)),
        Next(c.said(), [Pre(g, args)]), st, ok);
    let g1 = Bool::and_true_parts((!sg.ret.is_view() && is_lent(c.live, t)) && z.same(c.nw), Atom::all_bound(args, c.nw) && args.len().same(sg.words), gd.left);
    let g2 = Bool::and_true_parts(!sg.ret.is_view() && is_lent(c.live, t), z.same(c.nw), g1.left);
    let g3 = Bool::and_true_parts(!sg.ret.is_view(), is_lent(c.live, t), g2.left);
    let g9 = Bool::and_true_parts(Atom::all_bound(args, c.nw), args.len().same(sg.words), g1.right);
    let found = is_lent_sound(c.live, t, g3.right);
    let hold2: Owed::All([Pre(g, args)], k.pres, ws) = j(sym(gd.right), λ q _ => Owed::All(q.rs, k.pres, ws), hold);
    let vs = vals(args, s.words);
    let callee_pre: k.pres(g, vs) = pre_at(k.pres, g, args, s.words, ws, pre, j(sim.nw, λ q _ => Atom::all_bound(args, q) = True, g9.left), hold2.left);
    let nargs: (vs.len() = sg.words) = prelude::trans(vals_len(args, s.words), args.len().same_sound(sg.words, g9.right));
    let core = sim.called_core(inr, found.witness, found.proof.left.left, found.proof.right, g, vs, callee_pre, nargs, safe_g);
    let at_t = j(found.proof.left.right, λ u _ => Sim(k, c.said(), s.called(u, k.w.mean(g, list_at(s.views, u), vs)), Exec::lent(m, k.w.run(g, m.file, ref_at(m.views, u), vs)), ws), core);
    let at_m: Sim(k, c.said(), s.called(t, k.w.mean(g, list_at(s.views, t), vs)), Exec::lent(m, k.w.run(g, m.file, ref_at(m.views, t), vals(args, m.words))), ws) =
        j(sym(sim.words), λ q _ => Sim(k, c.said(), s.called(t, k.w.mean(g, list_at(s.views, t), vs)), Exec::lent(m, k.w.run(g, m.file, ref_at(m.views, t), vals(args, q))), ws), at_t);
    j(gd.right, λ q _ => Sim(k, q.next, CallMut(g, t, args, z).eval1(k.w, s), CallMut(g, t, args, z).run2(k.w, k.r, m), ws), at_m)
}

theorem step_view_call(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), pre: Prefix(s.words, ws), inr: InRef(k.file0, k.r),
    g: Nat, args: List<Atom>, t: Nat, safe_g: FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g)),
    st: Next, ok: CallView(g, args, t).check(k.mode, k.sigs, c) = Some(st), hold: Owed::All(st.rs, k.pres, ws)):
    Sim(k, st.next, CallView(g, args, t).eval1(k.w, s), CallView(g, args, t).run2(k.w, k.r, m), ws)
{
    let sg = sig_at(k.sigs, g);
    let mk = λ (rs: List<Owed>) => Next(Places(Cons(LView(t, Reads, sg.ret.region().subst(args)), c.live), c.nviews + 1, c.nw), rs ++ [Pre(g, args)]);
    let p = (((!sg.mode.writes() && sg.ret.is_view()) && t.same(c.nviews)) && (Atom::all_bound(args, c.nw) && args.len().same(sg.words))).then_some(
        license_live(c.live, Reads, Whole).map(mk), st, ok);
    let lic = option_map_some(license_live(c.live, Reads, Whole), mk, st, p.right);
    let parts = Owed::all_append(lic.witness, k.pres, [Pre(g, args)], ws, j(sym(lic.proof.right), λ q _ => Owed::All(q.rs, k.pres, ws), hold));
    let g1 = Bool::and_true_parts((!sg.mode.writes() && sg.ret.is_view()) && t.same(c.nviews), Atom::all_bound(args, c.nw) && args.len().same(sg.words), p.left);
    let g2 = Bool::and_true_parts(!sg.mode.writes() && sg.ret.is_view(), t.same(c.nviews), g1.left);
    let g4 = Bool::and_true_parts(!sg.mode.writes(), sg.ret.is_view(), g2.left);
    let g9 = Bool::and_true_parts(Atom::all_bound(args, c.nw), args.len().same(sg.words), g1.right);
    let vs = vals(args, s.words);
    let callee_pre: k.pres(g, vs) = pre_at(k.pres, g, args, s.words, ws, pre, j(sim.nw, λ q _ => Atom::all_bound(args, q) = True, g9.left), parts.right.left);
    let nargs: (vs.len() = sg.words) = prelude::trans(vals_len(args, s.words), args.len().same_sound(sg.words, g9.right));
    let none_lent: ((lv: LView) → Mem(lv, c.live) → lv.md.writes() = True → False) = λ lv mem w => {
        let e = license_live_each(c.live, Reads, Whole, lic.witness, lic.proof.left, lv, mem);
        let lic_none: (lv.license(Reads, Whole) = None) = j(sym(w), λ b _ => (match b { True => lv.region.license(Whole), False => Some(Nil<Owed>) }) = None, lv.region.license_whole());
        absurd(prelude::trans(sym(e.proof), lic_none))
    };
    let vs_ws: (vals(args, ws) = vs) = Atom::vals_stable(args, s.words, ws, pre, j(sim.nw, λ q _ => Atom::all_bound(args, q) = True, g9.left));
    let place: ((p: Nat) → sg.ret.region().hits(k.r, vs, p).IsTrue() → sg.ret.region().subst(args).hits(k.r, ws, p).IsTrue()) =
        λ p h => j(sym(prelude::trans(sg.ret.region().subst_hits(args, k.r, ws, p), cong_fn(λ (q: List<Nat>) => sg.ret.region().hits(k.r, q, p), vs_ws))), λ b _ => b.IsTrue(), h);
    let core = sim.viewed_core(inr, g, vs, callee_pre, nargs, safe_g, false_of_not(sg.mode.writes(), g4.left), t, t.same_sound(c.nviews, g2.right), none_lent,
        sg.ret.region().subst(args), place);
    let at_m: Sim(k, mk(lic.witness).next, s.open(k.w.mean(g, s.cur, vs).view, 0), Exec::viewed(m, k.r, k.w.run(g, m.file, k.r, vals(args, m.words))), ws) =
        j(sym(sim.words), λ q _ => Sim(k, mk(lic.witness).next, s.open(k.w.mean(g, s.cur, vs).view, 0), Exec::viewed(m, k.r, k.w.run(g, m.file, k.r, vals(args, q))), ws), core);
    j(lic.proof.right, λ q _ => Sim(k, q.next, CallView(g, args, t).eval1(k.w, s), CallView(g, args, t).run2(k.w, k.r, m), ws), at_m)
}

// ---------------------------------------------------------------------------
// The join

theorem Owed::all_under(rs: List<Owed>, cd: Cond, yes: Bool, pres: Nat → List<Nat> → Type, ws: List<Nat>, h: cd.test(ws) = yes):
    Owed::All(under(cd, yes, rs), pres, ws) → Owed::All(rs, pres, ws)
{
    match rs {
        Nil => λ _ => trivial,
        Cons(_, rest) => λ a => ⟨a.left(h), Owed::all_under(rest, cd, yes, pres, ws, h, a.right)⟩,
    }
}

// A test on words bound before it reads alike in the final words.
theorem Cond::test_stable(self cd: Cond, ws, big: List<Nat>, pre: Prefix(ws, big), b: cd.bound(ws.len()) = True): cd.test(big) = cd.test(ws) {
    (match cd as λ x => x.bound(ws.len()) = True → x.test(big) = x.test(ws) {
        Le(a1, b1) => λ h => {
            let p = Bool::and_true_parts(a1.bound(ws.len()), b1.bound(ws.len()), h);
            prelude::trans(cong_fn(λ (x: Nat) => x.leb(b1.val(big)), a1.val_stable(ws, big, pre, p.left)),
                cong_fn(λ (y: Nat) => a1.val(ws).leb(y), b1.val_stable(ws, big, pre, p.right)))
        },
    })(b)
}

theorem Mode::alike_sound(self a: Mode, b: Mode, h: a.alike(b) = True): a = b {
    (match a as λ x => x.alike(b) = True → x = b {
        Reads => match b as λ y => Reads.alike(y) = True → Reads = y { Reads => λ _ => refl, Writes => λ no => absurd(no) },
        Writes => match b as λ y => Writes.alike(y) = True → Writes = y { Reads => λ no => absurd(no), Writes => λ _ => refl },
    })(h)
}

theorem Region::alike_sound(self a: Region, b: Region, h: a.alike(b) = True): a = b {
    (match a as λ x => x.alike(b) = True → x = b {
        Whole => match b as λ y => Whole.alike(y) = True → Whole = y { Whole => λ _ => refl, Win(_, _) => λ no => absurd(no), Both(_, _) => λ no => absurd(no) },
        Win(lo1, n1) => match b as λ y => Win(lo1, n1).alike(y) = True → Win(lo1, n1) = y {
            Whole => λ no => absurd(no),
            Win(lo2, n2) => λ h2 => {
                let p = Bool::and_true_parts(lo1.same(lo2), n1.same(n2), h2);
                prelude::trans(cong_fn(λ (x: Atom) => Win(x, n1), lo1.same_sound(lo2, p.left)), cong_fn(λ (y: Atom) => Win(lo2, y), n1.same_sound(n2, p.right)))
            },
            Both(_, _) => λ no => absurd(no),
        },
        Both(_, _) => λ no => absurd(no),
    })(h)
}

// A region that covers another: every position of the second.
fn Coarser(a, b: Region) → Type { (r: Ref) → (ws: List<Nat>) → (p: Nat) → b.hits(r, ws, p).IsTrue() → a.hits(r, ws, p).IsTrue() }

theorem Region::coarsen_left(self a: Region, b: Region): Coarser(a.coarsen(b), a) {
    (match a.alike(b) as λ bb => a.alike(b) = bb → Coarser(match bb { True => a, False => Both(a, b) }, a) {
        True => λ _ r ws p h => h,
        False => λ _ r ws p h => Bool::or_true_left(a.hits(r, ws, p), b.hits(r, ws, p), h),
    })(refl)
}

theorem Region::coarsen_right(self a: Region, b: Region): Coarser(a.coarsen(b), b) {
    (match a.alike(b) as λ bb => a.alike(b) = bb → Coarser(match bb { True => a, False => Both(a, b) }, b) {
        True => λ q r ws p h => j(sym(a.alike_sound(b, q)), λ x _ => x.hits(r, ws, p).IsTrue(), h),
        False => λ _ r ws p h => Bool::or_true_right(a.hits(r, ws, p), b.hits(r, ws, p), h),
    })(refl)
}

// `lv` stands for a live view of `l`: the same name and mode, and a region
// that covers the other's.
record Covers(l: List<LView>, lv: LView) {
    from: LView,
    mem: Mem(from, l),
    t: from.t = lv.t,
    md: from.md = lv.md,
    coarser: Coarser(lv.region, from.region),
}

theorem Covers::cons({l: List<LView>}, {x: LView}, self cv: Covers(l, x), h: LView): Covers(Cons(h, l), x) { Covers(cv.from, Inr(cv.mem), cv.t, cv.md, cv.coarser) }

theorem LView::met_covers(self lv: LView, la, lb: List<LView>, mem: Mem(lv, la), x: LView, h: Mem(x, lv.met(lb))): Covers(la, x) ∧ Covers(lb, x) {
    (match find_live(lb, lv.t) as λ o => find_live(lb, lv.t) = o →
            Mem(x, match o { None => Nil, Some(o2) => match lv.md.alike(o2.md) { True => [LView(lv.t, lv.md, lv.region.coarsen(o2.region))], False => Nil } }) →
            Covers(la, x) ∧ Covers(lb, x) {
        None => λ _ no => false_elim(no),
        Some(o) => λ e => {
            let fo = find_live_sound(lb, lv.t, o, e);
            (match lv.md.alike(o.md) as λ bb => lv.md.alike(o.md) = bb →
                    Mem(x, match bb { True => [LView(lv.t, lv.md, lv.region.coarsen(o.region))], False => Nil }) → Covers(la, x) ∧ Covers(lb, x) {
                True => λ q hm => match hm {
                    Inl(ex) => j(sym(ex), λ y _ => Covers(la, y) ∧ Covers(lb, y),
                        ⟨Covers(lv, mem, refl, refl, lv.region.coarsen_left(o.region)),
                            Covers(o, fo.left, fo.right, sym(lv.md.alike_sound(o.md, q)), lv.region.coarsen_right(o.region))⟩),
                    Inr(no) => false_elim(no),
                },
                False => λ _ no => false_elim(no),
            })(refl)
        },
    })(refl, h)
}

theorem meet_covers(la, lb: List<LView>): (x: LView) → Mem(x, meet(la, lb)) → Covers(la, x) ∧ Covers(lb, x) {
    match la {
        Nil => λ x no => false_elim(no),
        Cons(lv, rest) => λ x h => match lv.met(lb).mem_append(meet(rest, lb), x, h) {
            Inl(hm) => lv.met_covers(Cons(lv, rest), lb, Inl(refl), x, hm),
            Inr(hr) => {
                let p = meet_covers(rest, lb, x, hr);
                ⟨p.left.cons(lv), p.right⟩
            },
        },
    }
}

// `c2` is a join of `c` with another arm: the same counts, and each live
// view stands for one of `c`'s.
record Joins(c, c2: Places) {
    nviews: c2.nviews = c.nviews,
    nw: c2.nw = c.nw,
    cov: (lv: LView) → Mem(lv, c2.live) → Covers(c.live, lv),
}

theorem check_join_sound(cd: Cond, sa, sb, sj: Next, ok: check_join(cd, sa, sb) = Some(sj)):
    Joins(sa.next, sj.next) ∧ (Joins(sb.next, sj.next) ∧ (sj.rs = under(cd, True, sa.rs) ++ under(cd, False, sb.rs)))
{
    let p = option_map_some(join(sa.next, sb.next), λ cj => Next(cj, under(cd, True, sa.rs) ++ under(cd, False, sb.rs)), sj, ok);
    let g = Bool::then_some(sa.next.nviews.same(sb.next.nviews) && sa.next.nw.same(sb.next.nw), Some(Places(meet(sa.next.live, sb.next.live), sa.next.nviews, sa.next.nw)), p.witness, p.proof.left);
    let gg = Bool::and_true_parts(sa.next.nviews.same(sb.next.nviews), sa.next.nw.same(sb.next.nw), g.left);
    let ecj: (Places(meet(sa.next.live, sb.next.live), sa.next.nviews, sa.next.nw) = p.witness) = Option::some_inj(Places(meet(sa.next.live, sb.next.live), sa.next.nviews, sa.next.nw), p.witness, g.right);
    let ja: Joins(sa.next, Places(meet(sa.next.live, sb.next.live), sa.next.nviews, sa.next.nw)) = Joins(refl, refl, λ lv mem => meet_covers(sa.next.live, sb.next.live, lv, mem).left);
    let jb: Joins(sb.next, Places(meet(sa.next.live, sb.next.live), sa.next.nviews, sa.next.nw)) =
        Joins(sa.next.nviews.same_sound(sb.next.nviews, gg.left), sa.next.nw.same_sound(sb.next.nw, gg.right), λ lv mem => meet_covers(sa.next.live, sb.next.live, lv, mem).right);
    let both: Joins(sa.next, p.witness) ∧ Joins(sb.next, p.witness) = j(ecj, λ q _ => Joins(sa.next, q) ∧ Joins(sb.next, q), ⟨ja, jb⟩);
    j(p.proof.right, λ q _ => Joins(sa.next, q.next) ∧ (Joins(sb.next, q.next) ∧ (q.rs = under(cd, True, sa.rs) ++ under(cd, False, sb.rs))), ⟨both.left, ⟨both.right, refl⟩⟩)
}

// A view whose region covers the one it had reads the same.
theorem ViewOk::coarsened({rg: Region}, {v: Ref}, {val: List<Nat>}, {r: Ref}, {file: List<List<Nat>>}, {ws: List<Nat>}, self o: ViewOk(rg, v, val, r, file, ws),
    rg2: Region, c: Coarser(rg2, rg)): ViewOk(rg2, v, val, r, file, ws)
{
    ViewOk(o.at_b, λ p h => c(r, ws, p, o.within(p, h)), o.reads)
}

theorem weaken_view(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), c2: Places, jn: Joins(c, c2), lv: LView, mem: Mem(lv, c2.live)):
    (lv.t < c2.nviews) ∧ ViewOk(lv.region, ref_at(m.views, lv.t), list_at(s.views, lv.t), k.r, m.file, ws)
{
    let cv = jn.cov(lv, mem);
    let o = sim.views(cv.from, cv.mem);
    let at: ViewOk(cv.from.region, ref_at(m.views, lv.t), list_at(s.views, lv.t), k.r, m.file, ws) =
        j(cv.t, λ u _ => ViewOk(cv.from.region, ref_at(m.views, u), list_at(s.views, u), k.r, m.file, ws), o.right);
    ⟨omega(o.left, cv.t, jn.nviews), at.coarsened(lv.region, cv.coarser)⟩
}

theorem weaken_lent(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), c2: Places, jn: Joins(c, c2), lv: LView, mem: Mem(lv, c2.live),
    w: lv.md.writes() = True): (k.mode.writes() = True) ∧ Lent(ref_at(m.views, lv.t), list_at(s.views, lv.t), word(s.slots, lv.t), k.r, m.file)
{
    let cv = jn.cov(lv, mem);
    let w2: (cv.from.md.writes() = True) = prelude::trans(cong_fn(λ (x: Mode) => x.writes(), cv.md), w);
    j(cv.t, λ u _ => (k.mode.writes() = True) ∧ Lent(ref_at(m.views, u), list_at(s.views, u), word(s.slots, u), k.r, m.file), sim.lent(cv.from, cv.mem, w2))
}

theorem weaken_excl(k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), c2: Places, jn: Joins(c, c2), a, b: LView,
    ma: Mem(a, c2.live), mb: Mem(b, c2.live), w: a.md.writes() = True, ne: a.t ≠ b.t): ref_at(m.views, a.t).Apart(ref_at(m.views, b.t))
{
    let ca = jn.cov(a, ma);
    let cb = jn.cov(b, mb);
    let w2: (ca.from.md.writes() = True) = prelude::trans(cong_fn(λ (x: Mode) => x.writes(), ca.md), w);
    let ne2: (ca.from.t ≠ cb.from.t) = λ e => ne(prelude::trans(sym(ca.t), prelude::trans(e, cb.t)));
    Ref::apart_moved(ref_at(m.views, ca.from.t), ref_at(m.views, a.t), ref_at(m.views, cb.from.t), ref_at(m.views, b.t),
        cong_fn(λ (u: Nat) => ref_at(m.views, u), ca.t), cong_fn(λ (u: Nat) => ref_at(m.views, u), cb.t), sim.excl(ca.from, cb.from, ca.mem, cb.mem, w2, ne2))
}

// The invariant at an arm's places gives it at the join's: the meet only
// drops views, and a coarsened region still holds its view.
theorem Sim::weaken({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), c2: Places, jn: Joins(c, c2)): Sim(k, c2, s, m, ws) {
    Sim(sim.words, prelude::trans(jn.nw, sim.nw), prelude::trans(sim.nviews, sym(jn.nviews)), prelude::trans(sim.nslots, sym(jn.nviews)), prelude::trans(sim.mviews, sym(jn.nviews)),
        sim.on, sim.fixed,
        λ lv mem => weaken_view(k, c, s, m, ws, sim, c2, jn, lv, mem),
        λ lv mem w => weaken_lent(k, c, s, m, ws, sim, c2, jn, lv, mem, w),
        λ a b ma mb w ne => weaken_excl(k, c, s, m, ws, sim, c2, jn, a, b, ma, mb, w, ne))
}

// ---------------------------------------------------------------------------
// The checker is proved once

// The functions a body calls.
fn Stmt::calls(self o: Stmt, g: Nat) → Bool {
    match o { CallMut(h, _, _, _) => h.same(g), CallView(h, _, _) => h.same(g), _ => False }
}

fn calls(ops: Body, g: Nat) → Bool {
    match ops {
        End => False,
        Do(o, rest) => o.calls(g) || calls(rest, g),
        If(_, a, b, rest) => (calls(a, g) || calls(b, g)) || calls(rest, g),
    }
}

// What a callee promises, for every function the statement calls.
fn Callees(k: Frame, o: Stmt) → Type { (g: Nat) → o.calls(g) = True → FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g)) }

// What a callee promises, for every function the body calls.
fn BodyCallees(k: Frame, ops: Body) → Type { (g: Nat) → calls(ops, g) = True → FnSafe(sig_at(k.sigs, g), k.pres(g), k.posts(g), k.w.mean(g), k.w.run(g)) }

theorem Stmt::step(self o: Stmt, k: Frame, c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws), pre: Prefix(s.words, ws), inr: InRef(k.file0, k.r),
    callees: Callees(k, o), st: Next, ok: o.check(k.mode, k.sigs, c) = Some(st), hold: Owed::All(st.rs, k.pres, ws)):
    Sim(k, st.next, o.eval1(k.w, s), o.run2(k.w, k.r, m), ws)
{
    (match o as λ e => Callees(k, e) → e.check(k.mode, k.sigs, c) = Some(st) → Sim(k, st.next, e.eval1(k.w, s), e.run2(k.w, k.r, m), ws) {
        Set(i, v) => λ _ ok2 => step_set(k, c, s, m, ws, sim, pre, inr, i, v, st, ok2, hold),
        Get(z, i) => λ _ ok2 => step_get(k, c, s, m, ws, sim, z, i, st, ok2),
        View(t, md, lo, n) => λ _ ok2 => step_view(k, c, s, m, ws, sim, pre, t, md, lo, n, st, ok2, hold),
        Read(z, t, i) => λ _ ok2 => step_read(k, c, s, m, ws, sim, z, t, i, st, ok2),
        Put(t, i, v) => λ _ ok2 => step_put(k, c, s, m, ws, sim, inr, t, i, v, st, ok2),
        Die(t) => λ _ ok2 => step_die(k, c, s, m, ws, sim, t, st, ok2),
        CallMut(g, t, args, z) => λ cl ok2 => step_mut(k, c, s, m, ws, sim, pre, inr, g, t, args, z, cl(g, g.same_self()), st, ok2, hold),
        CallView(g, args, t) => λ cl ok2 => step_view_call(k, c, s, m, ws, sim, pre, inr, g, args, t, cl(g, g.same_self()), st, ok2, hold),
    })(callees, ok)
}

theorem Stmt::eval1_grows(self o: Stmt, w: World, s: Sem): Prefix(s.words, o.eval1(w, s).words) {
    match o {
        Set(_, _) => Prefix::same(s.words),
        Get(_, i) => Prefix::snoc(s.words, word(s.cur, i.val(s.words))),
        View(_, _, _, _) => Prefix::same(s.words),
        Read(_, t, i) => Prefix::snoc(s.words, word(list_at(s.views, t), i.val(s.words))),
        Put(_, _, _) => Prefix::same(s.words),
        Die(_) => Prefix::same(s.words),
        CallMut(g, t, args, _) => Prefix::snoc(s.words, w.mean(g, list_at(s.views, t), vals(args, s.words)).word),
        CallView(_, _, _) => Prefix::same(s.words),
    }
}

theorem mean_if_true(w: World, cd: Cond, a, b, rest: Body, s: Sem, h: cd.test(s.words) = True): mean_body(w, If(cd, a, b, rest), s) = mean_body(w, rest, mean_body(w, a, s)) {
    j(sym(h), λ x _ => mean_body(w, rest, match x { True => mean_body(w, a, s), False => mean_body(w, b, s) }) = mean_body(w, rest, mean_body(w, a, s)), refl)
}

theorem mean_if_false(w: World, cd: Cond, a, b, rest: Body, s: Sem, h: cd.test(s.words) = False): mean_body(w, If(cd, a, b, rest), s) = mean_body(w, rest, mean_body(w, b, s)) {
    j(sym(h), λ x _ => mean_body(w, rest, match x { True => mean_body(w, a, s), False => mean_body(w, b, s) }) = mean_body(w, rest, mean_body(w, b, s)), refl)
}

theorem run_if_true(w: World, r: Ref, cd: Cond, a, b, rest: Body, m: Exec, h: cd.test(m.words) = True): run_body(w, r, If(cd, a, b, rest), m) = run_body(w, r, rest, run_body(w, r, a, m)) {
    j(sym(h), λ x _ => run_body(w, r, rest, match x { True => run_body(w, r, a, m), False => run_body(w, r, b, m) }) = run_body(w, r, rest, run_body(w, r, a, m)), refl)
}

theorem run_if_false(w: World, r: Ref, cd: Cond, a, b, rest: Body, m: Exec, h: cd.test(m.words) = False): run_body(w, r, If(cd, a, b, rest), m) = run_body(w, r, rest, run_body(w, r, b, m)) {
    j(sym(h), λ x _ => run_body(w, r, rest, match x { True => run_body(w, r, a, m), False => run_body(w, r, b, m) }) = run_body(w, r, rest, run_body(w, r, b, m)), refl)
}

theorem mean_body_grows(w: World, ops: Body): (s: Sem) → Prefix(s.words, mean_body(w, ops, s).words) {
    match ops {
        End => λ s => Prefix::same(s.words),
        Do(o, rest) => λ s => Prefix::chain(s.words, o.eval1(w, s).words, mean_body(w, rest, o.eval1(w, s)).words, o.eval1_grows(w, s), mean_body_grows(w, rest, o.eval1(w, s))),
        If(cd, a, b, rest) => λ s => match q: cd.test(s.words) as λ _ => Prefix(s.words, mean_body(w, If(cd, a, b, rest), s).words) {
            True => j(sym(mean_if_true(w, cd, a, b, rest, s, q)), λ x _ => Prefix(s.words, x.words),
                Prefix::chain(s.words, mean_body(w, a, s).words, mean_body(w, rest, mean_body(w, a, s)).words, mean_body_grows(w, a, s), mean_body_grows(w, rest, mean_body(w, a, s)))),
            False => j(sym(mean_if_false(w, cd, a, b, rest, s, q)), λ x _ => Prefix(s.words, x.words),
                Prefix::chain(s.words, mean_body(w, b, s).words, mean_body(w, rest, mean_body(w, b, s)).words, mean_body_grows(w, b, s), mean_body_grows(w, rest, mean_body(w, b, s)))),
        },
    }
}

theorem calls_head(o: Stmt, rest: Body, g: Nat, h: o.calls(g) = True): calls(Do(o, rest), g) = True { Bool::or_of_left(o.calls(g), calls(rest, g), h) }

theorem calls_rest(o: Stmt, rest: Body, g: Nat, h: calls(rest, g) = True): calls(Do(o, rest), g) = True { Bool::or_of_right(o.calls(g), calls(rest, g), h) }

theorem calls_if_a(cd: Cond, a, b, rest: Body, g: Nat, h: calls(a, g) = True): calls(If(cd, a, b, rest), g) = True {
    Bool::or_of_left(calls(a, g) || calls(b, g), calls(rest, g), Bool::or_of_left(calls(a, g), calls(b, g), h))
}

theorem calls_if_b(cd: Cond, a, b, rest: Body, g: Nat, h: calls(b, g) = True): calls(If(cd, a, b, rest), g) = True {
    Bool::or_of_left(calls(a, g) || calls(b, g), calls(rest, g), Bool::or_of_right(calls(a, g), calls(b, g), h))
}

theorem calls_if_rest(cd: Cond, a, b, rest: Body, g: Nat, h: calls(rest, g) = True): calls(If(cd, a, b, rest), g) = True {
    Bool::or_of_right(calls(a, g) || calls(b, g), calls(rest, g), h)
}

// What a body promises: from the invariant, in any words the meaning's
// words reach, a verdict and its residuals give the invariant at the
// checker's final places.
fn BodyOk(k: Frame, ops: Body) → Type {
    (c: Places) → (s: Sem) → (m: Exec) → (ws: List<Nat>) → Prefix(mean_body(k.w, ops, s).words, ws) → Sim(k, c, s, m, ws) →
    (st: Next) → check_body(ops, k.mode, k.sigs, c) = Some(st) → Owed::All(st.rs, k.pres, ws) → BodyCallees(k, ops) →
    Sim(k, st.next, mean_body(k.w, ops, s), run_body(k.w, k.r, ops, m), ws)
}

// A step, then the rest: each answered.
theorem Next::then_some(h: Option<Next>, kf: Places → Option<Next>, st: Next, ok: Next::then(h, kf) = Some(st)):
    Exists<Next>(λ a => (h = Some(a)) ∧ Exists<Next>(λ b => (kf(a.next) = Some(b)) ∧ (st = Next(b.next, a.rs ++ b.rs))))
{
    let p = Option::and_then_some(h, λ a => kf(a.next).map(λ sr => Next(sr.next, a.rs ++ sr.rs)), st, ok);
    let q = option_map_some(kf(p.witness.next), λ sr => Next(sr.next, p.witness.rs ++ sr.rs), st, p.proof.right);
    Exists(p.witness, ⟨p.proof.left, Exists(q.witness, ⟨q.proof.left, sym(q.proof.right)⟩)⟩)
}

theorem end_ok(k: Frame): BodyOk(k, End) {
    λ c s m ws pre sim st ok hold callees => j(Option::some_inj(Next(c, Nil), st, ok), λ q _ => Sim(k, q.next, s, m, ws), sim)
}

theorem do_ok(k: Frame, inr: InRef(k.file0, k.r), o: Stmt, rest: Body, ih: BodyOk(k, rest)): BodyOk(k, Do(o, rest)) {
    λ c s m ws pre sim st ok hold callees => {
        let sp = Next::then_some(o.check(k.mode, k.sigs, c), λ c2 => check_body(rest, k.mode, k.sigs, c2), st, ok);
        let bx = sp.proof.right;
        let parts = Owed::all_append(sp.witness.rs, k.pres, bx.witness.rs, ws, j(bx.proof.right, λ q _ => Owed::All(q.rs, k.pres, ws), hold));
        let pre1: Prefix(s.words, ws) = Prefix::chain(s.words, mean_body(k.w, Do(o, rest), s).words, ws, mean_body_grows(k.w, Do(o, rest), s), pre);
        let sim2 = o.step(k, c, s, m, ws, sim, pre1, inr, λ g h => callees(g, calls_head(o, rest, g, h)), sp.witness, sp.proof.left, parts.left);
        let fin = ih(sp.witness.next, o.eval1(k.w, s), o.run2(k.w, k.r, m), ws, pre, sim2, bx.witness, bx.proof.left, parts.right, λ g h => callees(g, calls_rest(o, rest, g, h)));
        j(sym(bx.proof.right), λ q _ => Sim(k, q.next, mean_body(k.w, rest, o.eval1(k.w, s)), run_body(k.w, k.r, rest, o.run2(k.w, k.r, m)), ws), fin)
    }
}

// What a branch's verdict says: its test is bound, both arms check, and
// they join.
theorem if_head(cd: Cond, a, b: Body, mode: Mode, sigs: List<Sig>, c: Places, sj: Next,
    ok: cd.bound(c.nw).then(check_body(a, mode, sigs, c).and_then(λ sa => check_body(b, mode, sigs, c).and_then(λ sb => check_join(cd, sa, sb)))) = Some(sj)):
    (cd.bound(c.nw) = True) ∧ Exists<Next>(λ sa => (check_body(a, mode, sigs, c) = Some(sa)) ∧ Exists<Next>(λ sb => (check_body(b, mode, sigs, c) = Some(sb)) ∧ (check_join(cd, sa, sb) = Some(sj))))
{
    let p = cd.bound(c.nw).then_some(check_body(a, mode, sigs, c).and_then(λ sa => check_body(b, mode, sigs, c).and_then(λ sb => check_join(cd, sa, sb))), sj, ok);
    let qa = Option::and_then_some(check_body(a, mode, sigs, c), λ sa => check_body(b, mode, sigs, c).and_then(λ sb => check_join(cd, sa, sb)), sj, p.right);
    let qb = Option::and_then_some(check_body(b, mode, sigs, c), λ sb => check_join(cd, qa.witness, sb), sj, qa.proof.right);
    ⟨p.left, Exists(qa.witness, ⟨qa.proof.left, Exists(qb.witness, ⟨qb.proof.left, qb.proof.right⟩)⟩)⟩
}

// The arm the test chose, then the rest: the arm's invariant at its own
// places, weakened to the join's.
theorem if_taken(k: Frame, x, rest: Body, ihx: BodyOk(k, x), ihr: BodyOk(k, rest), c: Places, s: Sem, m: Exec, ws: List<Nat>, sim: Sim(k, c, s, m, ws),
    sx: Next, okx: check_body(x, k.mode, k.sigs, c) = Some(sx), cj: Places, jn: Joins(sx.next, cj), sr: Next, okr: check_body(rest, k.mode, k.sigs, cj) = Some(sr),
    pre: Prefix(mean_body(k.w, rest, mean_body(k.w, x, s)).words, ws), hold_x: Owed::All(sx.rs, k.pres, ws), hold_r: Owed::All(sr.rs, k.pres, ws),
    callees_x: BodyCallees(k, x), callees_r: BodyCallees(k, rest)):
    Sim(k, sr.next, mean_body(k.w, rest, mean_body(k.w, x, s)), run_body(k.w, k.r, rest, run_body(k.w, k.r, x, m)), ws)
{
    let pre_x = Prefix::chain(mean_body(k.w, x, s).words, mean_body(k.w, rest, mean_body(k.w, x, s)).words, ws, mean_body_grows(k.w, rest, mean_body(k.w, x, s)), pre);
    let at_x: Sim(k, sx.next, mean_body(k.w, x, s), run_body(k.w, k.r, x, m), ws) = ihx(c, s, m, ws, pre_x, sim, sx, okx, hold_x, callees_x);
    let arm = at_x.weaken(cj, jn);
    ihr(cj, mean_body(k.w, x, s), run_body(k.w, k.r, x, m), ws, pre, arm, sr, okr, hold_r, callees_r)
}

theorem if_ok(k: Frame, cd: Cond, a, b, rest: Body, iha: BodyOk(k, a), ihb: BodyOk(k, b), ihr: BodyOk(k, rest)): BodyOk(k, If(cd, a, b, rest)) {
    λ c s m ws pre sim st ok hold callees => {
        let sp = Next::then_some(cd.bound(c.nw).then(check_body(a, k.mode, k.sigs, c).and_then(λ sa => check_body(b, k.mode, k.sigs, c).and_then(λ sb => check_join(cd, sa, sb)))),
            λ c2 => check_body(rest, k.mode, k.sigs, c2), st, ok);
        let bx = sp.proof.right;
        let parts = Owed::all_append(sp.witness.rs, k.pres, bx.witness.rs, ws, j(bx.proof.right, λ q _ => Owed::All(q.rs, k.pres, ws), hold));
        let hd = if_head(cd, a, b, k.mode, k.sigs, c, sp.witness, sp.proof.left);
        let ax = hd.right;
        let bxx = ax.proof.right;
        let jn = check_join_sound(cd, ax.witness, bxx.witness, sp.witness, bxx.proof.right);
        let owed = Owed::all_append(under(cd, True, ax.witness.rs), k.pres, under(cd, False, bxx.witness.rs), ws, j(jn.right.right, λ q _ => Owed::All(q, k.pres, ws), parts.left));
        let pre_s = Prefix::chain(s.words, mean_body(k.w, If(cd, a, b, rest), s).words, ws, mean_body_grows(k.w, If(cd, a, b, rest), s), pre);
        let tst: (cd.test(ws) = cd.test(s.words)) = cd.test_stable(s.words, ws, pre_s, j(sim.nw, λ n _ => cd.bound(n) = True, hd.left));
        let em: (cd.test(m.words) = cd.test(s.words)) = cong_fn(λ (w: List<Nat>) => cd.test(w), sim.words);
        let fin = match q: cd.test(s.words) as λ _ => Sim(k, bx.witness.next, mean_body(k.w, If(cd, a, b, rest), s), run_body(k.w, k.r, If(cd, a, b, rest), m), ws) {
            True => {
                let e1 = mean_if_true(k.w, cd, a, b, rest, s, q);
                let e2 = run_if_true(k.w, k.r, cd, a, b, rest, m, prelude::trans(em, q));
                let taken = if_taken(k, a, rest, iha, ihr, c, s, m, ws, sim, ax.witness, ax.proof.left, sp.witness.next, jn.left, bx.witness, bx.proof.left,
                    j(e1, λ x _ => Prefix(x.words, ws), pre), Owed::all_under(ax.witness.rs, cd, True, k.pres, ws, prelude::trans(tst, q), owed.left), parts.right,
                    λ g h => callees(g, calls_if_a(cd, a, b, rest, g, h)), λ g h => callees(g, calls_if_rest(cd, a, b, rest, g, h)));
                j(sym(e2), λ x _ => Sim(k, bx.witness.next, mean_body(k.w, If(cd, a, b, rest), s), x, ws),
                    j(sym(e1), λ x _ => Sim(k, bx.witness.next, x, run_body(k.w, k.r, rest, run_body(k.w, k.r, a, m)), ws), taken))
            },
            False => {
                let e1 = mean_if_false(k.w, cd, a, b, rest, s, q);
                let e2 = run_if_false(k.w, k.r, cd, a, b, rest, m, prelude::trans(em, q));
                let taken = if_taken(k, b, rest, ihb, ihr, c, s, m, ws, sim, bxx.witness, bxx.proof.left, sp.witness.next, jn.right.left, bx.witness, bx.proof.left,
                    j(e1, λ x _ => Prefix(x.words, ws), pre), Owed::all_under(bxx.witness.rs, cd, False, k.pres, ws, prelude::trans(tst, q), owed.right), parts.right,
                    λ g h => callees(g, calls_if_b(cd, a, b, rest, g, h)), λ g h => callees(g, calls_if_rest(cd, a, b, rest, g, h)));
                j(sym(e2), λ x _ => Sim(k, bx.witness.next, mean_body(k.w, If(cd, a, b, rest), s), x, ws),
                    j(sym(e1), λ x _ => Sim(k, bx.witness.next, x, run_body(k.w, k.r, rest, run_body(k.w, k.r, b, m)), ws), taken))
            },
        };
        j(sym(bx.proof.right), λ q _ => Sim(k, q.next, mean_body(k.w, If(cd, a, b, rest), s), run_body(k.w, k.r, If(cd, a, b, rest), m), ws), fin)
    }
}

// The body, by its shape.
theorem check_body_sound(k: Frame, inr: InRef(k.file0, k.r), ops: Body): BodyOk(k, ops) {
    match ops {
        End => end_ok(k),
        Do(o, rest) => do_ok(k, inr, o, rest, check_body_sound(k, inr, rest)),
        If(cd, a, b, rest) => if_ok(k, cd, a, b, rest, check_body_sound(k, inr, a), check_body_sound(k, inr, b), check_body_sound(k, inr, rest)),
    }
}

// What a function answers, from the invariant at the end of its body.
theorem Ret::answers(self ret: Ret, r: Ref, file: List<List<Nat>>, cur: List<Nat>, h: Holds(list_at(file, r.b), r.base, cur), len: cur.len() = r.len, ws, mws: List<Nat>, e: mws = ws):
    (i: Nat) → atom::word(ret.view(cur, ws), i) = rget(file, Ref(r.b, r.base + ret.vlo(r, mws), ret.vn(r, mws)), i)
{
    j(sym(e), λ q _ => (i: Nat) → atom::word(ret.view(cur, ws), i) = rget(file, Ref(r.b, r.base + ret.vlo(r, q), ret.vn(r, q)), i),
        match ret {
            RWord(_) => λ i => refl,
            RView(lo, n) => narrow_reads(file, r, cur, h, len, lo.val(ws), n.val(ws)),
        })
}

// Where a function's answered view lies: in its signature's region, read in
// the words it was called with. A window that reads only the parameter
// words is where it was in the words the body ends with.
theorem Ret::placed(self ret: Ret, words: Nat, r: Ref, ws, init: List<Nat>, pre: Prefix(init, ws), nw: init.len() = words):
    (p: Nat) → Span(r.base + ret.vlo(r, ws), ret.vn(r, ws)).has(p).IsTrue() → ret.kind(words).region().hits(r, init, p).IsTrue()
{
    match ret {
        RWord(_) => λ p h => {
            let no: False = omega(h);
            false_elim(no)
        },
        RView(lo, n) => (match lo.bound(words) && n.bound(words) as λ bb => (lo.bound(words) && n.bound(words)) = bb →
                (p: Nat) → Span(r.base + lo.val(ws).min(r.len), n.val(ws).min(r.len - lo.val(ws))).has(p).IsTrue() →
                (match bb { True => Win(lo, n), False => Whole }).hits(r, init, p).IsTrue() {
            True => λ q p h => {
                let parts = Bool::and_true_parts(lo.bound(words), n.bound(words), q);
                let el: (lo.val(ws) = lo.val(init)) = lo.val_stable(init, ws, pre, j(sym(nw), λ k _ => lo.bound(k) = True, parts.left));
                let en: (n.val(ws) = n.val(init)) = n.val_stable(init, ws, pre, j(sym(nw), λ k _ => n.bound(k) = True, parts.right));
                let x: (Span(r.base + lo.val(init), n.val(init)).has(p).IsTrue()) = omega(h, el, en);
                x
            },
            False => λ _ p h => {
                let x: (Span(r.base, r.len).has(p).IsTrue()) = omega(h);
                x
            },
        })(refl),
    }
}

theorem Mode::gives_back(self md: Mode, file0, file: List<List<Nat>>, r: Ref, arg, cur: List<Nat>, on: OnRef(file0, file, r, cur), fixed: md.writes() = False → cur = arg):
    OnRef(file0, file, r, md.back(arg, cur)) ∧ (md.writes() = False → md.back(arg, cur) = arg)
{
    (match md as λ q => (q.writes() = False → cur = arg) → OnRef(file0, file, r, q.back(arg, cur)) ∧ (q.writes() = False → q.back(arg, cur) = arg) {
        Reads => λ fx => ⟨j(fx(refl), λ l _ => OnRef(file0, file, r, l), on), λ _ => refl⟩,
        Writes => λ _ => ⟨on, λ no => absurd(no)⟩,
    })(fixed)
}

theorem Sim::ends({k: Frame}, {c: Places}, {s: Sem}, {m: Exec}, {ws: List<Nat>}, self sim: Sim(k, c, s, m, ws), f: Func, em: k.mode = f.mode,
    init: List<Nat>, pre: Prefix(init, s.words), nw: init.len() = f.words, post: Nat → Type, posted: post(mean_out(f, k.arg, s).word)):
    Safe(f.mode, f.sig().ret.region(), init, post, k.file0, k.r, k.arg, mean_out(f, k.arg, s), run_out(f, k.r, m))
{
    let md = f.mode.gives_back(k.file0, m.file, k.r, k.arg, s.cur, sim.on, j(em, λ q _ => q.writes() = False → s.cur = k.arg, sim.fixed));
    let placed: ((p: Nat) → Span(k.r.base + f.ret.vlo(k.r, m.words), f.ret.vn(k.r, m.words)).has(p).IsTrue() → f.ret.kind(f.words).region().hits(k.r, init, p).IsTrue()) =
        j(sym(sim.words), λ q _ => (p: Nat) → Span(k.r.base + f.ret.vlo(k.r, q), f.ret.vn(k.r, q)).has(p).IsTrue() → f.ret.kind(f.words).region().hits(k.r, init, p).IsTrue(),
            f.ret.placed(f.words, k.r, s.words, init, pre, nw));
    Safe(cong_fn(λ (w: List<Nat>) => f.ret.word(w), sim.words), posted, md.left, md.right, placed,
        f.ret.answers(k.r, m.file, s.cur, sim.on.holds, sim.on.len, s.words, m.words, sim.words))
}

// The world's callees answer what their postconditions say, wherever their
// preconditions hold: what a caller may assume of a call's answer.
fn Posted(w: World, sigs: List<Sig>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, ops: Body) → Type {
    (g: Nat) → calls(ops, g) = True → (arg, ws: List<Nat>) → ws.len() = sig_at(sigs, g).words → pres(g, ws) → posts(g, ws, w.mean(g, arg, ws).word)
}

// A function's promise gives its postcondition of its meaning, at any
// argument: lend it a file holding only that argument.
theorem drop_zero(xs: List<Nat>): xs.drop(0) = xs { match xs { Nil => refl, Cons(_, _) => refl } }

theorem fn_safe_answers(sig: Sig, pre: List<Nat> → Type, post: List<Nat> → Nat → Type, mean: List<Nat> → List<Nat> → MOut, run: List<List<Nat>> → Ref → List<Nat> → ROut,
    safe: FnSafe(sig, pre, post, mean, run)): (arg, ws: List<Nat>) → ws.len() = sig.words → pre(ws) → post(ws, mean(arg, ws).word)
{
    λ arg ws len p => {
        let fits: (0 + arg.len() <= arg.len()) = omega();
        let whole: (arg.drop(0).take(arg.len()) = arg) = prelude::trans(cong_fn(λ (l: List<Nat>) => l.take(arg.len()), drop_zero(arg)), arg.take_all(arg.len(), omega()));
        j(whole, λ q _ => post(ws, mean(q, ws).word), safe([arg], Ref(0, 0, arg.len()), ws, InRef(omega(), fits), len, p).posted)
    }
}

theorem check_sound(sigs: List<Sig>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, f: Func, rs: List<Owed>, ok: check_fn(sigs, f) = Some(rs),
    pre: List<Nat> → Type, post: List<Nat> → Nat → Type, w: World,
    discharge: (arg, ws: List<Nat>) → ws.len() = f.words → pre(ws) → Posted(w, sigs, pres, posts, f.body) → Owed::All(rs, pres, mean_body(w, f.body, Sem(arg, Nil, Nil, ws)).words),
    post_ok: (arg, ws: List<Nat>) → ws.len() = f.words → pre(ws) → Posted(w, sigs, pres, posts, f.body) → post(ws, mean_fn(w, f, arg, ws).word),
    callees: (g: Nat) → calls(f.body, g) = True → FnSafe(sig_at(sigs, g), pres(g), posts(g), w.mean(g), w.run(g))):
    FnSafe(f.sig(), pre, post, λ arg ws => mean_fn(w, f, arg, ws), λ file r ws => run_fn(w, f, file, r, ws))
{
    let posted: Posted(w, sigs, pres, posts, f.body) = λ g h => fn_safe_answers(sig_at(sigs, g), pres(g), posts(g), w.mean(g), w.run(g), callees(g, h));
    λ file r ws inr nw p => {
        let arg = window(list_at(file, r.b), r.base, r.len);
        let k = Frame(f.mode, sigs, pres, posts, w, r, file, arg);
        let s0 = Sem(arg, Nil, Nil, ws);
        let m0 = Exec(file, Nil, ws);
        let c0 = Places(Nil, 0, f.words);
        let fin_ws = mean_body(w, f.body, s0).words;
        let sim0: Sim(k, c0, s0, m0, fin_ws) = Sim(refl, sym(nw), refl, refl, refl, OnRef::start(file, r, inr), λ _ => refl,
            λ lv mem => false_elim(mem), λ lv mem => false_elim(mem), λ a b ma => false_elim(ma));
        let st = option_map_some(check_body(f.body, f.mode, sigs, c0), λ q => q.rs, rs, ok);
        let fin: Sim(k, st.witness.next, mean_body(w, f.body, s0), run_body(w, r, f.body, m0), fin_ws) =
            check_body_sound(k, inr, f.body, c0, s0, m0, fin_ws, Prefix::same(fin_ws), sim0, st.witness, st.proof.left,
            j(sym(st.proof.right), λ q _ => Owed::All(q, pres, fin_ws), discharge(arg, ws, nw, p, posted)), callees);
        fin.ends(f, refl, ws, mean_body_grows(w, f.body, s0), nw, post(ws), post_ok(arg, ws, nw, p, posted))
    }
}

// A call at depth zero: it does nothing and answers zero, and keeps the
// promise of every signature whose postcondition zero meets.
theorem idle_safe(sig: Sig, pre: List<Nat> → Type, post: List<Nat> → Nat → Type, idle: (ws: List<Nat>) → pre(ws) → post(ws, 0)):
    FnSafe(sig, pre, post, λ arg _ => MOut(arg, 0, Nil), λ file _ _ => ROut(file, 0, 0, 0))
{
    λ file r ws inr _ p => Safe(refl, idle(ws, p), OnRef::start(file, r, inr), λ _ => refl, λ p h => {
        let no: False = omega(h);
        false_elim(no)
    }, λ i => refl)
}

// ---------------------------------------------------------------------------
// A program: every function checked gives every function safe

theorem sig_at_of(fns: List<Func>): (g: Nat) → sig_at(sigs_of(fns), g) = fn_at(fns, g).sig() {
    match fns {
        Nil => λ g => refl,
        Cons(_, rest) => λ g => match g { Zero => refl, Succ(h) => sig_at_of(rest, h) },
    }
}

theorem fn_at_past(fns: List<Func>, g: Nat, past: fns.len() <= g): fn_at(fns, g) = Func::none() {
    cong_fn(λ (o: Option<Func>) => o.unwrap_or(Func::none()), fns.nth_past_end(g, past))
}

// Function `g` checks, its residuals hold under its precondition in every
// world whose callees meet their postconditions, and so does its own
// postcondition of its answer.
record Checks(fns: List<Func>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, g: Nat) {
    rs: List<Owed>,
    ok: check_fn(sigs_of(fns), fn_at(fns, g)) = Some(rs),
    discharge: (w: World) → (arg, ws: List<Nat>) → ws.len() = fn_at(fns, g).words → pres(g, ws) → Posted(w, sigs_of(fns), pres, posts, fn_at(fns, g).body) →
        Owed::All(rs, pres, mean_body(w, fn_at(fns, g).body, Sem(arg, Nil, Nil, ws)).words),
    post_ok: (w: World) → (arg, ws: List<Nat>) → ws.len() = fn_at(fns, g).words → pres(g, ws) → Posted(w, sigs_of(fns), pres, posts, fn_at(fns, g).body) →
        posts(g, ws, mean_fn(w, fn_at(fns, g), arg, ws).word),
}

fn ProgOk(fns: List<Func>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type) → Type { (g: Nat) → g < fns.len() → Checks(fns, pres, posts, g) }

// The answer of a call at depth zero, zero, meets every postcondition.
fn IdleOk(pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type) → Type { (g: Nat) → (ws: List<Nat>) → pres(g, ws) → posts(g, ws, 0) }

// Past the table, the function a table has nowhere checks with nothing owed,
// and answers zero.
theorem prog_checks(fns: List<Func>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, ok: ProgOk(fns, pres, posts), idle: IdleOk(pres, posts), g: Nat):
    Checks(fns, pres, posts, g)
{
    match q: (g + 1).leb(fns.len()) {
        True => ok(g, omega(q)),
        False => {
            let e = fn_at_past(fns, g, omega(q));
            Checks(Nil, j(sym(e), λ f _ => check_fn(sigs_of(fns), f) = Some(Nil), refl), λ w arg ws _ _ _ => trivial,
                λ w arg ws _ p _ => j(sym(e), λ f _ => posts(g, ws, mean_fn(w, f, arg, ws).word), idle(g, ws, p)))
        },
    }
}

// At every depth of calls, every function of a checked program keeps its
// promise: the caller's proof cites only the callees' promises. Depth zero
// answers zero, so the postconditions must allow it; a program whose
// postconditions do not is composed from `check_sound` depth by depth.
theorem prog_sound(fns: List<Func>, pres: Nat → List<Nat> → Type, posts: Nat → List<Nat> → Nat → Type, ok: ProgOk(fns, pres, posts), idle: IdleOk(pres, posts), d: Nat): (g: Nat) →
    FnSafe(sig_at(sigs_of(fns), g), pres(g), posts(g), world(fns, d).mean(g), world(fns, d).run(g))
{
    match d {
        Zero => λ g => idle_safe(sig_at(sigs_of(fns), g), pres(g), posts(g), idle(g)),
        Succ(e) => λ g => {
            let ch = prog_checks(fns, pres, posts, ok, idle, g);
            let safe = check_sound(sigs_of(fns), pres, posts, fn_at(fns, g), ch.rs, ch.ok, pres(g), posts(g), world(fns, e), ch.discharge(world(fns, e)), ch.post_ok(world(fns, e)),
                λ h _ => prog_sound(fns, pres, posts, ok, idle, e, h));
            j(sym(sig_at_of(fns, g)), λ sg _ => FnSafe(sg, pres(g), posts(g), world(fns, Succ(e)).mean(g), world(fns, Succ(e)).run(g)), safe)
        },
    }
}

// The search for a checked program that breaks `SafeAt`
// (issues/ownership-soundness-oracle.md; the deciders are `oracle.hthr`).
//
// Run by `scripts/ownership-oracle` through `heather eval`, on the untrusted
// evaluator: it reads the real checker, run and meaning, and nothing here is
// a theorem. A mutant of the checker is a copy of `checker.hthr` placed
// beside a copy of this file, which then imports it (a module beside its
// importer is found first).
//
// - **The environment**: a word, a record of two words held as an object
//   (`Pt`) and the same record as plain data (`QPt`), and a list of words
//   with windows.
// - **The generator** grows a body a statement at a time from a menu over
//   the variables in scope and the places of each by its code, and keeps a
//   prefix only where the checker's pass accepts its last statement (the
//   pass refuses a prefix whatever follows it, so this prunes nothing the
//   checker would accept). Every prefix is closed by every `Ret` whose
//   variables and origins the roles allow, the signature's results read off
//   it; the whole function is then checked by `check` itself.
// - **The inputs**: every argument list over a fixed heap, references
//   aliasing included; `Prog::owed_b` keeps those `SafeAt` is owed at.
// - **The precondition** is the singleton of the arguments tried, so the
//   verdict is owed exactly there (`CheckSound` quantifies over programs).
import logic;
import pair;
import bool;
import nat;
import option;
import list;
import bitvec;
import span_set;
import store;
import atom;
import steps;
import shape;
import sequences;
import body;
import level2;
import run;
import verdict;
import checker;
import oracle;
import linux_world;

// ---------------------------------------------------------------------------
// The environment

record Pt { x: Nat, y: Nat }

fn tys() → Nat → Type { λ k => match k { Zero => Pt, Succ(k1) => match k1 { Zero => List<Nat>, Succ(k2) => match k2 { Zero => Pt, Succ(_) => True } } } }

fn nat_s() → Shape { SWord(WNat) }

fn pt_s() → Shape { SNamed(0) }

fn ns_s() → Shape { SNamed(1) }

fn qpt_s() → Shape { SNamed(2) }

fn Pt::fx() → Field(tys(), Pt) { Field(nat_s(), λ (p: Pt) => p.x, λ (p: Pt) => λ (v: Nat) => Pt(v, p.y)) }

fn Pt::fy() → Field(tys(), Pt) { Field(nat_s(), λ (p: Pt) => p.y, λ (p: Pt) => λ (v: Nat) => Pt(p.x, v)) }

fn strs() → Strs(tys()) {
    λ k => match k {
        Zero => Struct(Object, Some(Pt(0, 0)), Record([Pt::fx(), Pt::fy()])),
        Succ(k1) => match k1 {
            Zero => Struct(Object, None, Sequence(Seq::list(tys(), nat_s(), 0, Some(Seq::list_win(tys(), nat_s(), ns_s(), λ (l: List<Nat>) => l, λ (l: List<Nat>) => l))))),
            Succ(k2) => match k2 {
                Zero => Struct(Plain, Some(Pt(0, 0)), Record([Pt::fx(), Pt::fy()])),
                Succ(_) => Struct(Plain, None, Opaque),
            },
        },
    }
}

fn Pt::same(self a, b: Pt) → Bool { a.x.same(b.x) && a.y.same(b.y) }

fn Nat::same_list(xs, ys: List<Nat>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, ar) => match ys { Nil => False, Cons(b, br) => a.same(b) && Nat::same_list(ar, br) } }
}

// Two values equal: one code, and equal at it.
fn deq(a, b: Dyn(tys())) → Bool {
    a.code.same(b.code) &&
    Option::same_by(Nat::same, Dyn::get(tys(), nat_s(), a), Dyn::get(tys(), nat_s(), b)) &&
    Option::same_by(Pt::same, Dyn::get(tys(), pt_s(), a), Dyn::get(tys(), pt_s(), b)) &&
    Option::same_by(Pt::same, Dyn::get(tys(), qpt_s(), a), Dyn::get(tys(), qpt_s(), b)) &&
    Option::same_by(Nat::same_list, Dyn::get(tys(), ns_s(), a), Dyn::get(tys(), ns_s(), b))
}

fn nat(n: Nat) → Dyn(tys()) { Dyn(nat_s(), n) }

fn pt(x, y: Nat) → Dyn(tys()) { Dyn(pt_s(), Pt(x, y)) }

fn qpt(x, y: Nat) → Dyn(tys()) { Dyn(qpt_s(), Pt(x, y)) }

fn ns(xs: List<Nat>) → Dyn(tys()) { Dyn(ns_s(), xs) }

// ---------------------------------------------------------------------------
// Enumeration helpers

fn gen_flat<A, B>(xs: List<A>, f: A → List<B>) → List<B> { match xs { Nil => Nil, Cons(x, r) => f(x) ++ gen_flat(r, f) } }

// Every choice of one element from each list.
fn gen_product<A>(xss: List<List<A>>) → List<List<A>> {
    match xss { Nil => [Nil], Cons(xs, rest) => gen_flat(xs, λ x => (gen_product(rest)).map(λ ys => Cons(x, ys))) }
}

// Every list of at most `n` elements of `xs`.
fn gen_lists<A>(xs: List<A>, n: Nat) → List<List<A>> {
    match n { Zero => [Nil], Succ(k) => Cons(Nil, gen_flat(xs, λ x => (gen_lists(xs, k)).map(λ ys => Cons(x, ys)))) }
}

// Every list of exactly `n` elements of `xs`.
fn gen_exactly<A>(xs: List<A>, n: Nat) → List<List<A>> {
    match n { Zero => [Nil], Succ(k) => gen_flat(xs, λ x => (gen_exactly(xs, k)).map(λ ys => Cons(x, ys))) }
}

// ---------------------------------------------------------------------------
// The program: the function under test, a catalogue of callees, a primitive

fn none_f() → Func { Func(Sig(Nil, Nil), Ret(Nil)) }

fn p_(c: Shape, m: PMode) → Param { Param(c, m) }

// The callees, at indices 1 to 8: a read view of an element and of a
// window; an element and a field written; a list taken and given back; a
// fresh list; a field read; and a primitive, the list's length (index 8).
fn cat() → List<Func> {
    [Func(Sig([p_(ns_s(), ByRead), p_(nat_s(), ByTake)], [Result(nat_s(), OView(0, [SElem(Var(1))]))]), seq([View(Place(Arg(0), [SElem(Var(1))]), Reading)], Ret([Loc(0)]))),
     Func(Sig([p_(ns_s(), ByRead)], [Result(ns_s(), OView(0, [SWindow(Lit(0), Lit(1))]))]), seq([View(Place(Arg(0), [SWindow(Lit(0), Lit(1))]), Reading)], Ret([Loc(0)]))),
     Func(Sig([p_(ns_s(), ByWrite), p_(nat_s(), ByTake)], Nil), seq([Write(Place(Arg(0), [SElem(Var(1))]), Arg(1))], Ret([Arg(0)]))),
     Func(Sig([p_(pt_s(), ByWrite), p_(nat_s(), ByTake)], Nil), seq([Write(Place(Arg(0), [SField(0)]), Arg(1))], Ret([Arg(0)]))),
     Func(Sig([p_(ns_s(), ByTake)], [Result(ns_s(), OParam(0))]), Ret([Arg(0)])),
     Func(Sig([p_(nat_s(), ByTake), p_(nat_s(), ByTake)], [Result(ns_s(), OFresh)]), seq([Fresh(ns_s(), Arg(0), Arg(1))], Ret([Loc(0)]))),
     Func(Sig([p_(pt_s(), ByRead)], [Result(nat_s(), OFresh)]), seq([Read(Place(Arg(0), [SField(1)]))], Ret([Loc(0)]))),
     Func(Sig([p_(ns_s(), ByRead)], [Result(nat_s(), OFresh)]), Ret(Nil))]
}

fn prim() → Nat → Bool { λ g => g.same(8) }

fn fns_of(f: Func) → Nat → Func { λ g => match g { Zero => f, Succ(g1) => (cat().nth(g1)).unwrap_or(none_f()) } }

fn sigs_of(f: Func) → Nat → Sig { λ g => (fns_of(f)(g)).sig }

// The primitive's meaning: a list's length.
fn prim_w(ds: List<Dyn(tys())>) → List<Dyn(tys())> {
    match ds { Cons(d, _) => match Dyn::get(tys(), ns_s(), d) { Some(xs) => [nat(xs.len())], None => Nil }, Nil => Nil }
}

// The world as the meanings unfolded `d` deep: a fixpoint wherever the
// recursion it reads is shallower (`gen_pinned` checks that at the point
// tried).
fn world(f: Func, d: Nat) → Callees(tys()) {
    λ g ds => match prim()(g) {
        True => prim_w(ds),
        False => match d { Zero => Nil, Succ(d1) => (fns_of(f)(g)).denote(tys(), strs(), world(f, d1), g, ds) },
    }
}

fn depth() → Nat { 8 }

fn List::same_by<A>(eqa: A → A → Bool, xs, ys: List<A>) → Bool {
    match xs { Nil => match ys { Nil => True, Cons(_, _) => False }, Cons(a, ar) => match ys { Nil => False, Cons(b, br) => eqa(a, b) && List::same_by(eqa, ar, br) } }
}

// The pin at the arguments tried: one more unfolding changes nothing.
fn gen_pinned(f: Func, ds: List<Dyn(tys())>) → Bool { List::same_by(deq, world(f, depth())(0, ds), world(f, depth() + 1)(0, ds)) }

fn gen_prog(f: Func) → Prog(tys()) { Prog(strs(), fns_of(f), world(f, depth()), λ _ _ => True, λ _ => None, prim(), λ _ _ _ => True) }

fn verdict_of(f: Func, g: Nat) → Option<Owes> { check(tys())(strs(), sigs_of(f), prim(), λ _ => False, g, fns_of(f)(g)) }

// The precondition the search gives each function: its arguments coded and
// its verdict holding there (a primitive's: anything). With it every
// function's `Due` holds wherever its precondition does, which is what
// `CheckSound` asks of every argument list; a recursion deeper than `d` is
// refused, which only tries less.
fn pres_b(f: Func, d, g: Nat, args: List<Dyn(tys())>) → Bool {
    match prim()(g) {
        True => True,
        False => match d {
            Zero => False,
            Succ(d1) => Dyn::coded(tys(), args, (sigs_of(f)(g)).params) && match verdict_of(f, g) {
                Some(o) => o.due_b(tys(), CtxB(strs(), world(f, depth()), g, λ g2 a2 => pres_b(f, d1, g2, a2), λ _ _ => 0, args), fns_of(f)(g)),
                None => False,
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Signatures' parameters, places, statements

// What the generator offers: calls, joins, a `Jump`, and signatures fixed
// first (so an arm may return), as bits of `fl`.
fn bit(fl, m: Nat) → Bool { ((fl.div(m)).mod(2)).same(1) }

fn gen_params() → List<Param> {
    [Param(nat_s(), ByTake), Param(nat_s(), ByWrite), Param(pt_s(), ByRead), Param(pt_s(), ByWrite), Param(pt_s(), ByTake),
     Param(ns_s(), ByRead), Param(ns_s(), ByWrite), Param(ns_s(), ByTake), Param(qpt_s(), ByRead), Param(qpt_s(), ByWrite), Param(qpt_s(), ByTake)]
}

fn gen_vars(na, nl: Nat) → List<Var> { (List::range(na)).map(λ i => Arg(i)) ++ (List::range(nl)).map(λ j => Loc(j)) }

// The variables of a code that are not gone.
fn gen_of(s: CSt, vs: List<Var>, c: Shape) → List<Var> {
    vs.filter(λ v => (s.code(v)).same(c) && match s.lvl(v) { Some(l) => match s.role(l) { KGone => False, _ => True }, None => False })
}

fn gen_live(s: CSt, vs: List<Var>) → List<Var> { vs.filter(λ v => match s.lvl(v) { Some(l) => match s.role(l) { KGone => False, _ => True }, None => False }) }

fn gen_atoms(s: CSt) → List<Atom> { [Lit(0), Lit(1)] ++ ((List::range(s.na)).filter(λ i => (s.code(Arg(i))).is_word())).map(λ i => Var(i)) }

fn gen_steps(s: CSt, c: Shape) → List<List<Step>> {
    Cons(Nil, match c {
        SWord(_) => Nil,
        SNamed(k) => match k {
            Zero => [[SField(0)], [SField(1)]],
            Succ(k1) => match k1 {
                Zero => (gen_atoms(s)).map(λ a => Cons(SElem(a), Nil)) ++ [[SWindow(Lit(0), Lit(1))], [SWindow(Lit(1), Lit(1))], [SWindow(Lit(0), Lit(2))], [SWindow(Lit(0), Lit(2)), SElem(Lit(1))]],
                Succ(k2) => match k2 { Zero => [[SField(0)], [SField(1)]], Succ(_) => Nil },
            },
        },
    })
}

// What a place's steps reach, at a root of code `c`.
fn gen_code_at(c: Shape, xs: List<Step>) → Shape {
    match Steps::last(xs) { None => c, Some(a) => match a { SWindow(_, _) => ns_s(), SField(_) => nat_s(), SElem(_) => nat_s(), SKey(_, _) => nat_s(), SVariant(_) => nat_s() } }
}

fn gen_places(s: CSt, x: Var) → List<Place> { (gen_steps(s, s.code(x))).map(λ xs => Place(x, xs)) }

fn gen_stmts(fl: Nat, sigs: Nat → Sig, s: CSt, na, nl: Nat) → List<Stmt> {
    let vs = gen_vars(na, nl);
    let lv = gen_live(s, vs);
    let ws = gen_of(s, vs, nat_s());
    [Lit(WNat, 0), Lit(WNat, 1)] ++
    gen_flat(ws, λ a => ws.map(λ b => Op(PAdd, a, b))) ++
    gen_flat(lv, λ x => (gen_places(s, x)).map(λ p => Read(p))) ++
    gen_flat(lv, λ x => gen_flat(gen_places(s, x), λ p => (gen_of(s, vs, gen_code_at(s.code(x), p.steps))).map(λ v => Write(p, v)))) ++
    gen_flat(lv, λ x => gen_flat(gen_places(s, x), λ p => Cons(View(p, Reading), Cons(View(p, Writing), Nil)))) ++
    gen_flat(lv, λ x => (gen_places(s, x)).map(λ p => Take(p))) ++
    gen_flat(ws, λ n => ws.map(λ v => Fresh(ns_s(), n, v))) ++
    lv.map(λ x => Death(Place(x, Nil))) ++
    (match bit(fl, 1) {
        False => Nil,
        True => gen_flat(List::range_from(1, 8), λ g => (gen_product((sigs(g)).params.map(λ p => gen_of(s, vs, p.code)))).map(λ xs => Call(g, xs, ((sigs(g)).ret_codes()).len()))),
    })
}

fn Stmt::binds(self st: Stmt) → Nat { match st { Write(_, _) => 0, Death(_) => 0, Call(_, _, n) => n, _ => 1 } }

fn gen_next(sigs: Nat → Sig, s: CSt, st: Stmt) → Option<CSt> {
    match st.code_ok(tys(), strs(), sigs, s) {
        False => None,
        True => match st.unmeasured(prim(), λ _ => False, 0) {
            True => None,
            False => ((!s.pending() || s.writes_back(st)).then(st.verdict(tys(), strs(), sigs, prim(), False, s))).map(λ nx => nx.st),
        },
    }
}

// A body under construction: a statement, or a join with its arms whose
// rest is what follows.
inductive Item { IStmt(s: Stmt), IJoin(t: Test, yes: Body, no: Body) }

fn Item::close(items: List<Item>, last: Body) → Body {
    match items { Nil => last, Cons(it, rest) => match it { IStmt(st) => Do(st, Item::close(rest, last)), IJoin(t, y, n) => Join(t, y, n, Item::close(rest, last)) } }
}

// A prefix: its items newest first, the state after them, the count of
// locals.
record Prefix { items: List<Item>, st: CSt, nl: Nat }

fn Prefix::body(self p: Prefix, last: Body) → Body { Item::close(p.items.rev(), last) }

// The written parameters' positions.
fn gen_written(ps: List<Param>) → List<Nat> { Param::written_from(ps)(0) }

// The holders of each written parameter's code, one per written parameter.
fn gen_backs(ps: List<Param>, s: CSt, vs: List<Var>) → List<List<Var>> {
    gen_product((gen_written(ps)).map(λ i => gen_of(s, vs, (ps.nth(i).map(λ p => p.code)).unwrap_or(nat_s()))))
}

// The leaves a fixed signature allows: a `Ret` of its codes, and a `Jump`.
fn gen_fixed_leaves(fl: Nat, sg: Sig, s: CSt, vs: List<Var>) → List<Body> {
    (gen_product((sg.ret_codes()).map(λ c => gen_of(s, vs, c)))).map(λ xs => Ret(xs)) ++
    (match bit(fl, 4) { True => (gen_product((sg.param_codes()).map(λ c => gen_of(s, vs, c)))).map(λ xs => Jump(xs)), False => Nil })
}

// Prefixes of statements only (an arm's).
fn gen_prefixes_plain(fl: Nat, sigs: Nat → Sig, na, k: Nat, pre: Prefix) → List<Prefix> {
    Cons(pre, match k {
        Zero => Nil,
        Succ(k1) => gen_flat(gen_stmts(fl, sigs, pre.st, na, pre.nl), λ st => match gen_next(sigs, pre.st, st) {
            None => Nil,
            Some(s2) => gen_prefixes_plain(fl, sigs, na, k1, Prefix(Cons(IStmt(st), pre.items), s2, pre.nl + st.binds())),
        }),
    })
}

// An arm: at most `k` statements, then a `Yield` of at most two
// variables, or (where the signature is fixed) a leaf that leaves.
fn gen_arms(fl: Nat, sigs: Nat → Sig, fixed: Bool, na, k: Nat, s: CSt, nl: Nat) → List<Pair<Body, Vd>> {
    gen_flat(gen_prefixes_plain(fl, sigs, na, k, Prefix(Nil, s, nl)), λ pre => {
        let vs = gen_vars(na, pre.nl);
        let leaves = ((gen_lists(gen_live(pre.st, vs), 2)).map(λ xs => Yield(xs))) ++ (match fixed { True => gen_fixed_leaves(fl, sigs(0), pre.st, vs), False => Nil });
        gen_flat(leaves, λ lf => match lf.verdict(tys(), strs(), sigs, prim(), λ _ => False, 0, pre.st) {
            VOk(r) => [Pair(pre.body(lf), VOk(r))],
            VNo(_) => Nil,
        })
    })
}

fn Yd::count(o: Option<Yd>) → Option<Nat> { o.map(λ y => y.outs.len()) }

// Every join at a state: a test on two words, a yes arm of at most `ka`
// statements, a no arm of at most `kb`, accepted by the checker's meet; the
// state after it and the count of outputs bound.
fn gen_joins(fl: Nat, sigs: Nat → Sig, fixed: Bool, na, ka, kb: Nat, s: CSt, nl: Nat) → List<Pair<Item, Pair<CSt, Nat>>> {
    let ws = gen_of(s, gen_vars(na, nl), nat_s());
    match s.pending() {
        True => Nil,
        False => gen_flat(ws, λ a => gen_flat(ws, λ b => {
            let ys = gen_arms(fl, sigs, fixed, na, ka, s.arm(), nl);
            let ns = gen_arms(fl, sigs, fixed, na, kb, s.arm(), nl);
            gen_flat(ys, λ y => gen_flat(ns, λ n => match y.snd {
                VNo(_) => Nil,
                VOk(cy) => match n.snd {
                    VNo(_) => Nil,
                    VOk(cn) => match Yd::alike(cy.yld, cn.yld) {
                        False => Nil,
                        True => match CSt::joined(s, cy.yld, cn.yld) {
                            None => Nil,
                            Some(s1) => match Yd::count(cy.yld) {
                                Some(m) => [Pair(IJoin(TLt(a, b), y.fst, n.fst), Pair(s1, nl + m))],
                                None => match Yd::count(cn.yld) { Some(m) => [Pair(IJoin(TLt(a, b), y.fst, n.fst), Pair(s1, nl + m))], None => Nil },
                            },
                        },
                    },
                },
            }))
        })),
    }
}

// Every accepted prefix of at most `k` items after `pre` (a join counts
// as one).
fn gen_prefixes(fl: Nat, sigs: Nat → Sig, fixed: Bool, na, k, ka, kb: Nat, pre: Prefix) → List<Prefix> {
    Cons(pre, match k {
        Zero => Nil,
        Succ(k1) =>
            gen_flat<Stmt, Prefix>(gen_stmts(fl, sigs, pre.st, na, pre.nl), λ st => match gen_next(sigs, pre.st, st) {
                None => Nil,
                Some(s2) => gen_prefixes(fl, sigs, fixed, na, k1, ka, kb, Prefix(Cons(IStmt(st), pre.items), s2, pre.nl + st.binds())),
            }) ++
            (match bit(fl, 2) {
                False => Nil,
                True => gen_flat(gen_joins(fl, sigs, fixed, na, ka, kb, pre.st, pre.nl), λ j => gen_prefixes(fl, sigs, fixed, na, k1, ka, kb, Prefix(Cons(j.fst, pre.items), j.snd.fst, j.snd.snd))),
            }),
    })
}

// The origins a returned variable may be given: by its role, and ones the
// role does not allow (a mutant may accept them).
fn gen_origins(s: CSt, x: Var) → List<Origin> {
    let ps = List::range(s.na);
    match s.lvl(x) {
        None => Nil,
        Some(l) => match s.role(l) {
            KPlain => [OFresh],
            KHold(_, _) => Cons(OFresh, ps.map(λ i => OParam(i))),
            KView => Cons(OFresh, gen_flat(ps, λ i => (gen_steps(s, s.code(Arg(i)))).map(λ xs => OView(i, xs)))),
            KGone => Nil,
        },
    }
}

// Every `Ret` of at most two results with their origins, then a holder of
// each written parameter's code.
fn gen_rets(ps: List<Param>, s: CSt, na, nl: Nat) → List<Pair<List<Result>, List<Var>>> {
    let vs = gen_vars(na, nl);
    let outs = gen_flat(gen_lists(gen_live(s, vs), 2), λ xs => (gen_product(xs.map(λ x => gen_origins(s, x)))).map(λ os => Pair(xs, os)));
    let backs = gen_backs(ps, s, vs);
    gen_flat(outs, λ ro => backs.map(λ bs => Pair(List::zip<Var, Origin>(ro.fst)(ro.snd).map(λ xo => Result(s.code(xo.fst), xo.snd)), ro.fst ++ bs)))
}

fn gen_leaf_ok(sg: Sig, s: CSt, b: Body) → Bool {
    match b.verdict(tys(), strs(), λ g => match g { Zero => sg, Succ(_) => (fns_of(none_f())(g)).sig }, prim(), λ _ => False, 0, s) { VOk(_) => True, VNo(_) => False }
}

// The signatures fixed first: no result or one fresh word.
fn gen_fixed_results() → List<List<Result>> { [Nil, [Result(nat_s(), OFresh)]] }

// Every function over the parameters `ps` with at most `k` items before its
// leaf. Unfixed, the leaf is a `Ret` whose results the signature reads off
// (or a `Jump`, with no results); fixed, each signature of
// `gen_fixed_results` in turn, its arms free to return.
fn gen_funcs(fl: Nat, ps: List<Param>, k, ka, kb: Nat) → List<Func> {
    let na = ps.len();
    match bit(fl, 8) {
        False => {
            let sg0 = Sig(ps, Nil);
            let sigs = λ (g: Nat) => match g { Zero => sg0, Succ(_) => (fns_of(none_f())(g)).sig };
            gen_flat(gen_prefixes(fl, sigs, False, na, k, ka, kb, Prefix(Nil, CSt::start(tys(), strs(), sg0), 0)), λ pre =>
                (((gen_rets(ps, pre.st, na, pre.nl)).filter(λ ro => gen_leaf_ok(Sig(ps, ro.fst), pre.st, Ret(ro.snd)))).map(λ ro => Func(Sig(ps, ro.fst), pre.body(Ret(ro.snd))))) ++
                (match bit(fl, 4) {
                    True => ((gen_fixed_leaves(4, sg0, pre.st, gen_vars(na, pre.nl))).filter(λ lf => match lf { Jump(_) => gen_leaf_ok(sg0, pre.st, lf), _ => False })).map(λ lf => Func(sg0, pre.body(lf))),
                    False => Nil,
                }))
        },
        True => gen_flat(gen_fixed_results(), λ rs => {
            let sg = Sig(ps, rs);
            let sigs = λ (g: Nat) => match g { Zero => sg, Succ(_) => (fns_of(none_f())(g)).sig };
            gen_flat(gen_prefixes(fl, sigs, True, na, k, ka, kb, Prefix(Nil, CSt::start(tys(), strs(), sg), 0)), λ pre =>
                ((gen_fixed_leaves(fl, sg, pre.st, gen_vars(na, pre.nl))).filter(λ lf => gen_leaf_ok(sg, pre.st, lf))).map(λ lf => Func(sg, pre.body(lf))))
        }),
    }
}

// ---------------------------------------------------------------------------
// Inputs

fn heap0() → Heap(tys()) { [Live(Obj(pt(1, 2), Nil)), Live(Obj(pt(3, 4), Nil)), Live(Obj(ns([1, 2]), Nil)), Live(Obj(ns([7]), Nil)), Live(Obj(qpt(8, 9), Nil))] }

fn at(b: Nat, ss: List<Sel>) → Value(tys()) { Refer(Ref(b, ss)) }

fn gen_values(p: Param) → List<Value(tys())> {
    match p.code {
        SWord(_) => [Plain(nat(0)), Plain(nat(1)), at(0, [OnField(0)]), at(2, [OnSeq(SeqOne(INat(0)))])],
        SNamed(k) => match k {
            Zero => [at(0, Nil), at(1, Nil), Plain(pt(5, 6))],
            Succ(k1) => match k1 {
                Zero => [at(2, Nil), at(3, Nil), at(2, [OnSeq(SeqRun(INat(1), INat(1)))]), Plain(ns([4, 5]))],
                Succ(_) => [Plain(qpt(5, 6)), at(4, Nil)],
            },
        },
    }
}

fn gen_args(ps: List<Param>) → List<List<Value(tys())>> { gen_product(ps.map(λ p => gen_values(p))) }

fn reads(h: Heap(tys()), vs: List<Value(tys())>) → List<Dyn(tys())> { vs.map(λ v => (Value::read(tys(), v, strs(), h, h.len())).unwrap_or(Dyn::none(tys()))) }

// ---------------------------------------------------------------------------
// One instance, and the stream

// A finding: the function, the arguments, the fuel, the clause broken.
record Finding { f: Func, vs: List<Value(tys())>, fuel: Nat, clause: Nat }

// What one function gives: the inputs tried, owed (`Lendable`, the codes,
// `ReadAll`), owing (its verdict held, the pin holding there), and its
// findings.
record Tally { tried: Nat, owed: Nat, due: Nat, found: List<Finding> }

fn Tally::zero() → Tally { Tally(0, 0, 0, Nil) }

fn Tally::add(self a, b: Tally) → Tally { Tally(a.tried + b.tried, a.owed + b.owed, a.due + b.due, b.found ++ a.found) }

fn gen_sum<A>(xs: List<A>, f: A → Tally) → Tally { match xs { Nil => Tally::zero(), Cons(x, r) => (f(x)).add(gen_sum(r, f)) } }

fn fuels() → List<Nat> { [0, 1, 2, 5] }

fn gen_try(f: Func, vs: List<Value(tys())>) → Tally {
    let p = gen_prog(f);
    let h = heap0();
    let ds = reads(h, vs);
    match Prog::owed_b(tys(), deq, p, 0, vs, h, ds) {
        False => Tally(1, 0, 0, Nil),
        True => match pres_b(f, depth(), 0, ds) && gen_pinned(f, ds) {
            False => Tally(1, 1, 0, Nil),
            True => Tally(1, 1, 1, gen_flat(fuels(), λ fu => match Prog::verdict_b(tys(), deq, p, 0, fu, vs, h, Io::of(World::piped(Nil)), ds) {
                None => Nil,
                Some(c) => [Finding(f, vs, fu, c.tag())],
            })),
        },
    }
}

fn gen_param_lists(np: Nat) → List<List<Param>> { gen_lists(gen_params(), np) }

fn count_funcs(fl, np, k, ka, kb, lo, n: Nat) → Nat { (((gen_param_lists(np)).drop(lo)).take(n)).foldl(λ (c: Nat) (ps: List<Param>) => c + (gen_funcs(fl, ps, k, ka, kb)).len(), 0) }

// A value of the environment as numbers: a word; a record's two fields; a
// list's length and elements.
fn encd(d: Dyn(tys())) → List<Nat> {
    match Dyn::get(tys(), nat_s(), d) {
        Some(n) => [n],
        None => match Dyn::get(tys(), ns_s(), d) {
            Some(xs) => Cons(xs.len(), xs),
            None => match Dyn::get(tys(), pt_s(), d) { Some(p) => [p.x, p.y], None => match Dyn::get(tys(), qpt_s(), d) { Some(p) => [p.x, p.y], None => Nil } },
        },
    }
}

fn enc_finding(x: Finding) → List<Nat> { Cons(x.clause, Cons(x.fuel, enc_func(x.f) ++ enc_list(λ (v: Value(tys())) => enc_value(tys(), encd, v), x.vs))) }

// The search as a stream of numbers, one record per checked function: the
// inputs tried, owed, and owing, then its findings. Nothing accumulates:
// the driver reads the stream as it is made and sums it. `fl`'s bits:
// calls, joins, `Jump`, signatures fixed first.
fn search_stream(fl, np, k, ka, kb, lo, n: Nat) → List<Nat> {
    gen_flat(((gen_param_lists(np)).drop(lo)).take(n), λ ps => gen_flat(gen_funcs(fl, ps, k, ka, kb), λ f => match verdict_of(f, 0) {
        None => Nil,
        Some(_) => {
            let t = gen_sum(gen_args(f.sig.params), λ vs => gen_try(f, vs));
            [t.tried, t.owed, t.due] ++ enc_list(enc_finding, t.found)
        },
    }))
}

// The findings of a search, counted: what the library gate checks at the
// smallest size (`oracle_tests.hthr`), by the kernel's own evaluation.
fn search_found(fl, np, k, ka, kb, lo, n: Nat) → Nat {
    (((gen_param_lists(np)).drop(lo)).take(n)).foldl(λ (c: Nat) (ps: List<Param>) => (gen_funcs(fl, ps, k, ka, kb)).foldl(λ (c2: Nat) (f: Func) => c2 + match verdict_of(f, 0) {
        None => 0,
        Some(_) => (gen_sum(gen_args(f.sig.params), λ vs => gen_try(f, vs))).found.len(),
    }, c), 0)
}

// Heather's scanner over a whole source: the loop around the automaton of
// `lexer_scan.hthr`, as a function the kernel evaluates
// (issues/heather-lexer-evaluated.md, stage L0 of
// docs/native-lexer-crypto-roadmap.md §3, the scanner's half of it).
//
// `Scanned::of(source)` is the tokens of a source: for each, its kind and
// the bytes it spans, whitespace and comments dropped, and an end-of-file
// token at the source's length; or the offset of the token that is refused.
// A token is the longest run of bytes the automaton accepts from where the
// last one ended (`Accepted::longest`), and the state it starts in depends
// on the kind before it (`scan_begin`). Nothing else is decided here: which
// bytes make which token is the automaton's.
//
// This is the specification of the linked scanner. Its automaton is the
// compiled one by the compiler's theorems, and its loop is the loop
// `crates/linked/src/scanner.rs` writes in Rust, which stays Rust until a
// compiled function can read memory its caller lends
// (issues/native-library-exports-design.md); the two loops are held
// together by test, on the sources `lib/_tests/lang/lexer` proves by
// evaluation here and `crates/linked/tests/scanner.rs` runs there.
//
// Offsets are natural numbers and the source is a list, because this is
// read and evaluated, not run. The compiled loop will hold both in words.

import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import string;
import utf8;
import lexer_scan;

// A token: its kind (a `KIND_*` of `lexer_scan`) and the bytes `start..end`.
record Token { kind: u64, start: Nat, end: Nat }

// Where the automaton last accepted: the kind, the offset just past the
// token, and the source from there on.
record Accepted { kind: u64, end: Nat, rest: List<u8> }

// A source scanned: its tokens, or the offset of the one that is refused.
inductive Scanned { Tokens(tokens: List<Token>), Refused(at: Nat) }

// What is remembered after stepping into `state` with `rest` left at `at`:
// this position if the state accepts a kind, and what was remembered before
// if it does not.
fn Accepted::after(state: u64, rest: List<u8>, at: Nat, last: Option<Accepted>) → Option<Accepted> {
    let kind = scan_accept(state);
    if kind.eq_bit(0) { last } else { Some(Accepted(kind, at, rest)) }
}

// The longest token the automaton accepts from `state` over `rest`, which
// begins at offset `at`: it steps until the state is `DEAD` and answers the
// last position it accepted at. `None` is a refusal: the automaton went to
// `FAIL`, or it stopped having accepted nothing. At the end of the source it
// is given `END` once, which no state goes on from.
fn Accepted::longest(state: u64, rest: List<u8>, at: Nat, last: Option<Accepted>) → Option<Accepted> {
    match rest {
        Nil => if scan_step(state, END).eq_bit(FAIL) { None } else { last },
        Cons(byte, tail) => {
            let next = scan_step(state, byte.zero_extend(56));
            if next.eq_bit(FAIL) {
                None
            } else if next.eq_bit(DEAD) {
                last
            } else {
                Accepted::longest(next, tail, Succ(at), Accepted::after(next, tail, Succ(at), last))
            }
        },
    }
}

// Whitespace and comments are scanned and not kept.
fn Token::kept(kind: u64) → Bool { !(kind.eq_bit(KIND_SPACE) || kind.eq_bit(KIND_COMMENT)) }

fn Scanned::push(self later: Scanned, token: Token) → Scanned {
    match later {
        Tokens(tokens) => Scanned::Tokens(Cons(token, tokens)),
        Refused(at) => Scanned::Refused(at),
    }
}

// The tokens of `rest`, which begins at offset `at`, after a token of kind
// `previous` (zero at the start of the source). `fuel` bounds the number of
// tokens: every token is at least one byte, so the source's length is
// enough, and running out is reported as a refusal that does not happen.
fn Scanned::from(fuel: Nat, previous: u64, rest: List<u8>, at: Nat) → Scanned {
    match fuel {
        Zero => match rest {
            Nil => Scanned::Tokens([Token(KIND_EOF, at, at)]),
            Cons(_, _) => Scanned::Refused(at),
        },
        Succ(more) => match rest {
            Nil => Scanned::Tokens([Token(KIND_EOF, at, at)]),
            Cons(_, _) => match Accepted::longest(scan_begin(previous), rest, at, None) {
                None => Scanned::Refused(at),
                Some(found) => {
                    let later = Scanned::from(more, found.kind, found.rest, found.end);
                    if Token::kept(found.kind) { later.push(Token(found.kind, at, found.end)) } else { later }
                },
            },
        },
    }
}

// The tokens of a source.
fn Scanned::of(source: List<u8>) → Scanned { Scanned::from(source.len(), 0, source, 0) }

// The tokens of a source given as text, by its UTF-8 bytes.
fn Scanned::of_text(text: String) → Scanned { Scanned::of(utf8::encode(text)) }

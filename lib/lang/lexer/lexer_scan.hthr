// Heather's scanner: the automaton that cuts a source file into tokens, a
// byte at a time, as compiled code (issues/self-lexer-linked.md, stage L1 of
// docs/native-lexer-crypto-roadmap.md §3).
//
// A scanner says where each token starts and ends and which kind it is. It
// is the half of a lexer that reads every byte, and it holds no values: a
// numeral's value and a string's characters are functions of the span,
// computed apart. Everything here is a function of 64-bit words with no
// memory, which is what a `runtime fn` can be today, so the whole automaton
// compiles: `scan_step` is one program of two dozen functions, linked into
// Rust (`crates/linked/src/scanner.rs`). The loop that feeds it the bytes is
// `lexer_tokens.hthr`, evaluated by the kernel, and Rust's copy of that
// loop beside the linked code until a compiled function can be lent the
// source (issues/native-library-exports-design.md).
//
// # The automaton
//
// `scan_step(s, b)` is the state after byte `b` in state `s`. A token is
// the longest run of bytes the automaton accepts: the loop steps until the
// state is `DEAD` and takes the last position where `scan_accept` named a
// kind, so a state may run past a token's end to find out where it is
// (`0xff.f` is a numeral, a point and a name unless a `p` exponent follows,
// and `a::` is a name and a `::` unless a name follows). `FAIL` is a refusal
// that no earlier accept excuses: `12abc` is refused, not cut into `12` and
// `abc`. After the last byte the loop gives `END` once; every state answers
// it with `DEAD` or `FAIL`.
//
// A state is a word: its number in the low byte and, above it, the kind it
// accepts (zero for none), so `scan_accept` is a shift. A token that ends
// where it is first accepted (`(`, `->`, a closed string) needs no state of
// its own: it is state 1 with its kind above, which has no way on.
//
// The states are numbered family by family (the names, the decimal
// numerals, the string literals), eight numbers to a family, so
// `scan_family` finds a state's family by a shift, `scan_step` calls that
// family's function, and the function finds the state. The families are
// functions of their own for two reasons. There are no tables in compiled
// code yet (issues/rt-fixed-arrays-and-tables.md), so a state is found by
// comparisons, and a family keeps those few. And a function's machine code
// is checked in one kernel statement, which has room for a few dozen arms
// (issues/native-function-emission-one-statement.md); a program's size has
// no such limit, since each function is planned, emitted and checked apart.
//
// # Reading the byte tests
//
// A byte arrives zero-extended in a word, and `END` (256) is no byte, so a
// test must be false at 256 and above. Subtraction wraps, which makes a
// range one comparison:
//
// - `b.sub(48).unsigned_lt_bit(10)`: a digit, 48 `0` to 57 `9`.
// - `b.bor(32).sub(97).unsigned_lt_bit(26)`: a letter of either case, bit
//   32 being the one the cases differ in; with 6 for 26, a hexadecimal
//   letter. `b.bor(32).eq_bit(101)` is `e` or `E`, and 112 is `p`.
// - `b.eq_bit(32) || b.sub(9).unsigned_lt_bit(2) || b.sub(12).unsigned_lt_bit(2)`:
//   whitespace as the Rust lexer has it (space, tab, line feed, form feed,
//   carriage return; not the vertical tab, 11).
// - `b.unsigned_lt_bit(256)`: any byte, which is how a comment and a string
//   stop at `END`.
//
// The source is taken to be UTF-8, as the Rust lexer's `&str` is: the
// symbols past ASCII are matched by their bytes, and a character literal
// counts its one scalar value by its first byte.
//
// # What is proved and what is tested
//
// Each function's `::agrees` (the `runtime` generator) and the certificate
// of the compiled program say the machine code computes these functions.
// That these functions are Heather's lexical grammar is not a theorem: the
// Rust lexer (`crates/syntax/src/lexer.rs`) is the definition today, and
// `crates/linked/tests/scanner.rs` holds the two to each other on every
// source in the repository and on every edge of the automaton.

import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// ---------------------------------------------------------------------------
// Kinds. The names and their order are `TokKind`'s (`crates/syntax/src/lexer.rs`),
// with the two a scanner has and a lexer drops at the end.

def KIND_IDENT: u64 = 1;
def KIND_NUM: u64 = 2;
def KIND_SCALED: u64 = 3;
def KIND_CHAR: u64 = 4;
def KIND_STR: u64 = 5;
def KIND_ARG_SLOT: u64 = 6;
def KIND_HOLE: u64 = 7;
def KIND_LPAREN: u64 = 8;
def KIND_RPAREN: u64 = 9;
def KIND_LBRACE: u64 = 10;
def KIND_RBRACE: u64 = 11;
def KIND_COMMA: u64 = 12;
def KIND_COLON: u64 = 13;
def KIND_SEMI: u64 = 14;
def KIND_AT: u64 = 15;
def KIND_DOT: u64 = 16;
def KIND_PLUS: u64 = 17;
def KIND_MINUS: u64 = 18;
def KIND_BANG: u64 = 19;
def KIND_PLUS_PLUS: u64 = 20;
def KIND_STAR: u64 = 21;
def KIND_LT: u64 = 22;
def KIND_LT_EQ: u64 = 23;
def KIND_GT: u64 = 24;
def KIND_LBRACKET: u64 = 25;
def KIND_RBRACKET: u64 = 26;
def KIND_LSEMANTIC: u64 = 27;
def KIND_RSEMANTIC: u64 = 28;
def KIND_LANGLE: u64 = 29;
def KIND_RANGLE: u64 = 30;
def KIND_PIPE: u64 = 31;
def KIND_AMP: u64 = 32;
def KIND_SLASH: u64 = 33;
def KIND_PERCENT: u64 = 34;
def KIND_SHL: u64 = 35;
def KIND_SHR: u64 = 36;
def KIND_ARROW: u64 = 37;
def KIND_FAT_ARROW: u64 = 38;
def KIND_TURNSTILE: u64 = 39;
def KIND_AMP_AMP: u64 = 40;
def KIND_PIPE_PIPE: u64 = 41;
def KIND_NORM_BAR: u64 = 42;
def KIND_BULLET: u64 = 43;
def KIND_APPROX: u64 = 44;
def KIND_CARET: u64 = 45;
def KIND_SUP_INVERSE: u64 = 46;
def KIND_JOIN: u64 = 47;
def KIND_MEET: u64 = 48;
def KIND_NEG: u64 = 49;
def KIND_WEDGE: u64 = 50;
def KIND_VEE: u64 = 51;
def KIND_IFF: u64 = 52;
def KIND_LARROW: u64 = 53;
def KIND_EXISTS: u64 = 54;
def KIND_BIG_SUM: u64 = 55;
def KIND_BIG_PROD: u64 = 56;
def KIND_UP_ARROW: u64 = 57;
def KIND_FORALL: u64 = 58;
def KIND_DOLLAR: u64 = 59;
def KIND_LAMBDA: u64 = 60;
def KIND_EQ: u64 = 61;
def KIND_NE: u64 = 62;
def KIND_EQ_EQ: u64 = 63;
def KIND_COLON_EQ: u64 = 64;
def KIND_COLON_COLON: u64 = 65;
def KIND_EOF: u64 = 66;
def KIND_SPACE: u64 = 67;
def KIND_COMMENT: u64 = 68;
// Added after the two a scanner has, so no code above moves.
def KIND_OPLUS: u64 = 69;
def KIND_TILDE: u64 = 70;

// ---------------------------------------------------------------------------
// States: the number in the low byte, the accepted kind above it.

// No way on: the token is the last one accepted.
def DEAD: u64 = 0;
// A refusal no earlier accept excuses. It is its own successor.
def FAIL: u64 = 2;
// What the loop gives after the last byte.
def END: u64 = 256;
// A token starts here; in `START_SHIFT`, a `>` may open the shift `>>`.
def START: u64 = 8;
def START_SHIFT: u64 = 9;

def SPACE: u64 = 0x4310;
def SLASH: u64 = 0x2111;
def COMMENT: u64 = 0x4412;
def IDENT: u64 = 0x0118;
def ID_COLON: u64 = 0x0019;
def ID_JOIN: u64 = 0x001a;
def HOLE: u64 = 0x071b;
def HOLE_NAME: u64 = 0x071c;
def MINUS: u64 = 0x1220;
def LT: u64 = 0x1621;
def LARROW: u64 = 0x3522;
def GT_SHIFT: u64 = 0x1823;
def EQ: u64 = 0x3d24;
def PLUS: u64 = 0x1128;
def BANG: u64 = 0x1329;
def PIPE: u64 = 0x1f2a;
def AMP: u64 = 0x202b;
def COLON: u64 = 0x0d2c;
def ZERO: u64 = 0x0230;
def DEC: u64 = 0x0231;
def DEC_UNDER: u64 = 0x0032;
def DEC_DOT: u64 = 0x0033;
def DEC_FRAC: u64 = 0x0338;
def DEC_FRAC_UNDER: u64 = 0x0039;
def EXP_MARK: u64 = 0x003a;
def EXP_SIGN: u64 = 0x003b;
def EXP: u64 = 0x033c;
def EXP_UNDER: u64 = 0x003d;
def OCT_START: u64 = 0x0040;
def OCT: u64 = 0x0241;
def OCT_UNDER: u64 = 0x0042;
def SUF_LETTER: u64 = 0x0043;
def SUF: u64 = 0x0244;
def SUF_ZERO: u64 = 0x0245;
def BIN_START: u64 = 0x0048;
def BIN: u64 = 0x0249;
def BIN_UNDER: u64 = 0x004a;
def HEX_START: u64 = 0x0050;
def HEX: u64 = 0x0251;
def HEX_UNDER: u64 = 0x0052;
def HEX_DOT: u64 = 0x0053;
def HEX_FRAC: u64 = 0x0058;
def HEX_FRAC_UNDER: u64 = 0x0059;
def HEX_FRAC_BAD: u64 = 0x005a;
def FRAC_MARK: u64 = 0x0060;
def FRAC_SIGN: u64 = 0x0061;
def BAD_MARK: u64 = 0x0062;
def BAD_SIGN: u64 = 0x0063;
def STR: u64 = 0x0068;
def STR_ESC: u64 = 0x0069;
def STR_U: u64 = 0x006a;
def STR_BRACE: u64 = 0x006b;
def STR_HEX: u64 = 0x006c;
def CHR: u64 = 0x0070;
def CHR_3: u64 = 0x0071;
def CHR_2: u64 = 0x0072;
def CHR_1: u64 = 0x0073;
def CHR_CLOSE: u64 = 0x0074;
def CHR_ESC: u64 = 0x0078;
def CHR_U: u64 = 0x0079;
def CHR_BRACE: u64 = 0x007a;
def CHR_HEX: u64 = 0x007b;
def LEAD_CE: u64 = 0x0080;
def LEAD_C2: u64 = 0x0081;
def SLOT: u64 = 0x0682;
def SLOT_E2: u64 = 0x0083;
def SLOT_82: u64 = 0x0084;
def LEAD_E2: u64 = 0x0088;
def SUP_MINUS: u64 = 0x0089;
def SUP_LEAD: u64 = 0x008a;
def SUP_ONE: u64 = 0x008b;
def ARROWS: u64 = 0x0090;
def RELATIONS: u64 = 0x0091;
def LATTICE: u64 = 0x0092;
def BRACKETS: u64 = 0x0093;
def OPERATORS: u64 = 0x0098;

// A finished token of each kind that ends where it is first accepted: state 1,
// which has no way on.
def DONE_CHAR: u64 = 0x0401;
def DONE_STR: u64 = 0x0501;
def DONE_LPAREN: u64 = 0x0801;
def DONE_RPAREN: u64 = 0x0901;
def DONE_LBRACE: u64 = 0x0a01;
def DONE_RBRACE: u64 = 0x0b01;
def DONE_COMMA: u64 = 0x0c01;
def DONE_SEMI: u64 = 0x0e01;
def DONE_AT: u64 = 0x0f01;
def DONE_DOT: u64 = 0x1001;
def DONE_PLUS_PLUS: u64 = 0x1401;
def DONE_STAR: u64 = 0x1501;
def DONE_LT_EQ: u64 = 0x1701;
def DONE_GT: u64 = 0x1801;
def DONE_LBRACKET: u64 = 0x1901;
def DONE_RBRACKET: u64 = 0x1a01;
def DONE_LSEMANTIC: u64 = 0x1b01;
def DONE_RSEMANTIC: u64 = 0x1c01;
def DONE_LANGLE: u64 = 0x1d01;
def DONE_RANGLE: u64 = 0x1e01;
def DONE_PERCENT: u64 = 0x2201;
def DONE_SHL: u64 = 0x2301;
def DONE_SHR: u64 = 0x2401;
def DONE_ARROW: u64 = 0x2501;
def DONE_FAT_ARROW: u64 = 0x2601;
def DONE_TURNSTILE: u64 = 0x2701;
def DONE_AMP_AMP: u64 = 0x2801;
def DONE_PIPE_PIPE: u64 = 0x2901;
def DONE_NORM_BAR: u64 = 0x2a01;
def DONE_BULLET: u64 = 0x2b01;
def DONE_APPROX: u64 = 0x2c01;
def DONE_CARET: u64 = 0x2d01;
def DONE_SUP_INVERSE: u64 = 0x2e01;
def DONE_JOIN: u64 = 0x2f01;
def DONE_MEET: u64 = 0x3001;
def DONE_NEG: u64 = 0x3101;
def DONE_WEDGE: u64 = 0x3201;
def DONE_VEE: u64 = 0x3301;
def DONE_IFF: u64 = 0x3401;
def DONE_LARROW: u64 = 0x3501;
def DONE_EXISTS: u64 = 0x3601;
def DONE_BIG_SUM: u64 = 0x3701;
def DONE_BIG_PROD: u64 = 0x3801;
def DONE_UP_ARROW: u64 = 0x3901;
def DONE_FORALL: u64 = 0x3a01;
def DONE_DOLLAR: u64 = 0x3b01;
def DONE_LAMBDA: u64 = 0x3c01;
def DONE_NE: u64 = 0x3e01;
def DONE_EQ_EQ: u64 = 0x3f01;
def DONE_COLON_EQ: u64 = 0x4001;
def DONE_COLON_COLON: u64 = 0x4101;
def DONE_OPLUS: u64 = 0x4501;
def DONE_TILDE: u64 = 0x4601;

// ---------------------------------------------------------------------------
// The families: each state's way on, one byte further.

// The three states with no way on: `DEAD`, a finished token, and `FAIL`,
// which stays a refusal.
runtime fn step_stop(s, b: u64) → u64 { if s.eq_bit(FAIL) { FAIL } else { DEAD } }

// The start of a token is the one state with a way on for every kind of
// first byte, more than one function of a size that certifies holds. So it
// is four, split by the byte: below 40 (whitespace and the quotes), 40 to 47
// (`( ) * + , - . /`), 48 to 63 (the digits and `: ; < = > ?`), and from 64
// (the letters, the brackets, and the bytes a symbol past ASCII begins
// with). `scan_family` chooses among them. Each is the same in `START` and
// `START_SHIFT` but for one byte.

// A token's first byte, below 40.
// Bytes: 34 `"`, 39 `'`, 38 `&`, 33 `!`, 36 `$`, 37 `%`.
runtime fn step_start_space(s, b: u64) → u64 {
    if b.eq_bit(32) || b.sub(9).unsigned_lt_bit(2) || b.sub(12).unsigned_lt_bit(2) { SPACE }
    else if b.eq_bit(34) { STR }
    else if b.eq_bit(39) { CHR }
    else if b.eq_bit(38) { AMP }
    else if b.eq_bit(33) { BANG }
    else if b.eq_bit(36) { DONE_DOLLAR }
    else if b.eq_bit(37) { DONE_PERCENT }
    else { DEAD }
}

// A token's first byte, 40 to 47.
// Bytes: 40 `(`, 41 `)`, 44 `,`, 46 `.`, 45 `-`, 43 `+`, 42 `*`, 47 `/`.
runtime fn step_start_punct(s, b: u64) → u64 {
    if b.eq_bit(40) { DONE_LPAREN }
    else if b.eq_bit(41) { DONE_RPAREN }
    else if b.eq_bit(44) { DONE_COMMA }
    else if b.eq_bit(46) { DONE_DOT }
    else if b.eq_bit(45) { MINUS }
    else if b.eq_bit(43) { PLUS }
    else if b.eq_bit(42) { DONE_STAR }
    else if b.eq_bit(47) { SLASH }
    else { DEAD }
}

// A token's first byte, 48 to 63. Where `>>` is a shift (`START_SHIFT`: the
// start of the source, after whitespace, after `(` and after `,`), a `>`
// (62) waits for a second one. Everywhere else `>` is a token at once, so
// `List<List<A>>` closes twice.
// Bytes: 48 `0`, 58 `:`, 61 `=`, 59 `;`, 60 `<`, 63 `?`.
runtime fn step_start_mid(s, b: u64) → u64 {
    if b.eq_bit(48) { ZERO }
    else if b.sub(48).unsigned_lt_bit(10) { DEC }
    else if b.eq_bit(58) { COLON }
    else if b.eq_bit(61) { EQ }
    else if b.eq_bit(59) { DONE_SEMI }
    else if b.eq_bit(60) { LT }
    else if b.eq_bit(63) { HOLE }
    else if b.eq_bit(62) { if s.eq_bit(START_SHIFT) { GT_SHIFT } else { DONE_GT } }
    else { DEAD }
}

// A token's first byte, from 64; `END` comes here too, and begins nothing.
// Bytes: 95 `_`, 123 `{`, 125 `}`, 91 `[`, 93 `]`, 124 `|`, 64 `@`, 94 `^`,
// 126 `~`.
runtime fn step_start_high(s, b: u64) → u64 {
    if b.bor(32).sub(97).unsigned_lt_bit(26) || b.eq_bit(95) { IDENT }
    else if b.eq_bit(123) { DONE_LBRACE }
    else if b.eq_bit(125) { DONE_RBRACE }
    else if b.eq_bit(91) { DONE_LBRACKET }
    else if b.eq_bit(93) { DONE_RBRACKET }
    else if b.eq_bit(124) { PIPE }
    else if b.eq_bit(64) { DONE_AT }
    else if b.eq_bit(94) { DONE_CARET }
    else if b.eq_bit(126) { DONE_TILDE }
    else if b.eq_bit(0xe2) { LEAD_E2 }
    else if b.eq_bit(0xce) { LEAD_CE }
    else if b.eq_bit(0xc2) { LEAD_C2 }
    else { DEAD }
}

// Whitespace, `/` and comments.
runtime fn step_trivia(s, b: u64) → u64 {
    if s.eq_bit(SPACE) {
        // In a run of whitespace.
        if b.eq_bit(32) || b.sub(9).unsigned_lt_bit(2) || b.sub(12).unsigned_lt_bit(2) { SPACE }
        else { DEAD }
    } else if s.eq_bit(SLASH) {
        // After `/`: a second one (47) opens a comment.
        if b.eq_bit(47) { COMMENT }
        else { DEAD }
    } else if s.eq_bit(COMMENT) {
        // In a `//` comment, which runs up to the line feed (10) or the
        // end.
        if b.eq_bit(10) { DEAD }
        else if b.unsigned_lt_bit(256) { COMMENT }
        else { DEAD }
    } else {
        DEAD
    }
}

// Identifiers and holes.
runtime fn step_names(s, b: u64) → u64 {
    if s.eq_bit(IDENT) {
        // In an identifier: more of it, or a `:` (58) that may begin a
        // `::` join.
        // Bytes: 95 `_`.
        if b.bor(32).sub(97).unsigned_lt_bit(26) || b.sub(48).unsigned_lt_bit(10) || b.eq_bit(95) { IDENT }
        else if b.eq_bit(58) { ID_COLON }
        else { DEAD }
    } else if s.eq_bit(ID_COLON) {
        // After an identifier and one `:`.
        // Bytes: 58 `:`.
        if b.eq_bit(58) { ID_JOIN }
        else { DEAD }
    } else if s.eq_bit(ID_JOIN) {
        // After an identifier and `::`: an identifier start joins the
        // next segment on.
        // Bytes: 95 `_`.
        if b.bor(32).sub(97).unsigned_lt_bit(26) || b.eq_bit(95) { IDENT }
        else { DEAD }
    } else if s.eq_bit(HOLE) {
        // After `?`: an identifier start right behind it names the hole.
        // Bytes: 95 `_`.
        if b.bor(32).sub(97).unsigned_lt_bit(26) || b.eq_bit(95) { HOLE_NAME }
        else { DEAD }
    } else if s.eq_bit(HOLE_NAME) {
        // In a hole's name.
        // Bytes: 95 `_`.
        if b.bor(32).sub(97).unsigned_lt_bit(26) || b.sub(48).unsigned_lt_bit(10) || b.eq_bit(95) { HOLE_NAME }
        else { DEAD }
    } else {
        DEAD
    }
}

// The operators that begin with `-`, `<`, `>` and `=`.
runtime fn step_arrows(s, b: u64) → u64 {
    if s.eq_bit(MINUS) {
        // After `-`: `->`.
        // Bytes: 62 `>`.
        if b.eq_bit(62) { DONE_ARROW }
        else { DEAD }
    } else if s.eq_bit(LT) {
        // After `<`: `<=`, `<<`, or `<-`.
        // Bytes: 61 `=`, 60 `<`, 45 `-`.
        if b.eq_bit(61) { DONE_LT_EQ }
        else if b.eq_bit(60) { DONE_SHL }
        else if b.eq_bit(45) { LARROW }
        else { DEAD }
    } else if s.eq_bit(LARROW) {
        // After `<-`: `<->`.
        // Bytes: 62 `>`.
        if b.eq_bit(62) { DONE_IFF }
        else { DEAD }
    } else if s.eq_bit(GT_SHIFT) {
        // After a `>` that may open a shift: `>>`.
        // Bytes: 62 `>`.
        if b.eq_bit(62) { DONE_SHR }
        else { DEAD }
    } else if s.eq_bit(EQ) {
        // After `=`: `=>` or `==`.
        // Bytes: 62 `>`, 61 `=`.
        if b.eq_bit(62) { DONE_FAT_ARROW }
        else if b.eq_bit(61) { DONE_EQ_EQ }
        else { DEAD }
    } else {
        DEAD
    }
}

// The operators that begin with `+`, `!`, `|`, `&` and `:`.
runtime fn step_doubles(s, b: u64) → u64 {
    if s.eq_bit(PLUS) {
        // After `+`: `++`.
        // Bytes: 43 `+`.
        if b.eq_bit(43) { DONE_PLUS_PLUS }
        else { DEAD }
    } else if s.eq_bit(BANG) {
        // After `!`: `!=` is refused, since `≠` is the only spelling of
        // inequality.
        // Bytes: 61 `=`.
        if b.eq_bit(61) { FAIL }
        else { DEAD }
    } else if s.eq_bit(PIPE) {
        // After `|`: `|-` or `||`.
        // Bytes: 45 `-`, 124 `|`.
        if b.eq_bit(45) { DONE_TURNSTILE }
        else if b.eq_bit(124) { DONE_PIPE_PIPE }
        else { DEAD }
    } else if s.eq_bit(AMP) {
        // After `&`: `&&`.
        // Bytes: 38 `&`.
        if b.eq_bit(38) { DONE_AMP_AMP }
        else { DEAD }
    } else if s.eq_bit(COLON) {
        // After `:`: `:=` or `::`.
        // Bytes: 61 `=`, 58 `:`.
        if b.eq_bit(61) { DONE_COLON_EQ }
        else if b.eq_bit(58) { DONE_COLON_COLON }
        else { DEAD }
    } else {
        DEAD
    }
}

// Decimal numerals.
runtime fn step_decimal(s, b: u64) → u64 {
    if s.eq_bit(ZERO) {
        // After a leading `0`: a radix prefix `x` (120), `o` (111) or
        // `b` (98), a width suffix's `u` (117) or `i` (105), or a decimal
        // numeral going on.
        // Bytes: 95 `_`, 46 `.`.
        if b.sub(48).unsigned_lt_bit(10) { DEC }
        else if b.eq_bit(95) { DEC_UNDER }
        else if b.eq_bit(120) { HEX_START }
        else if b.eq_bit(111) { OCT_START }
        else if b.eq_bit(98) { BIN_START }
        else if b.bor(32).eq_bit(101) { EXP_MARK }
        else if b.eq_bit(117) || b.eq_bit(105) { SUF_LETTER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) { FAIL }
        else if b.eq_bit(46) { DEC_DOT }
        else { DEAD }
    } else if s.eq_bit(DEC) {
        // In a decimal numeral. A letter cannot follow a digit, except
        // `e` or `E` as an exponent and `u` (117) or `i` (105) as a width
        // suffix; a `.` (46) may begin a fraction.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) { DEC }
        else if b.eq_bit(95) { DEC_UNDER }
        else if b.bor(32).eq_bit(101) { EXP_MARK }
        else if b.eq_bit(117) || b.eq_bit(105) { SUF_LETTER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) { FAIL }
        else if b.eq_bit(46) { DEC_DOT }
        else { DEAD }
    } else if s.eq_bit(DEC_UNDER) {
        // After a `_` in a decimal numeral: it sits between two digits,
        // or before an exponent.
        if b.sub(48).unsigned_lt_bit(10) { DEC }
        else if b.bor(32).eq_bit(101) { EXP_MARK }
        else { FAIL }
    } else if s.eq_bit(DEC_DOT) {
        // After a decimal numeral and a `.`: a digit makes it a
        // fraction, and anything else leaves the point to the next
        // token.
        if b.sub(48).unsigned_lt_bit(10) { DEC_FRAC }
        else { DEAD }
    } else {
        DEAD
    }
}

// Decimal fractions, and the exponent of a decimal or hexadecimal literal.
runtime fn step_fraction(s, b: u64) → u64 {
    if s.eq_bit(DEC_FRAC) {
        // In a decimal fraction.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) { DEC_FRAC }
        else if b.eq_bit(95) { DEC_FRAC_UNDER }
        else if b.bor(32).eq_bit(101) { EXP_MARK }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) { FAIL }
        else { DEAD }
    } else if s.eq_bit(DEC_FRAC_UNDER) {
        // After a `_` in a decimal fraction: only a digit may follow.
        if b.sub(48).unsigned_lt_bit(10) { DEC_FRAC }
        else { FAIL }
    } else if s.eq_bit(EXP_MARK) {
        // After an exponent letter that a numeral cannot otherwise hold:
        // a digit or a signed digit must follow.
        // Bytes: 43 `+`, 45 `-`.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else if b.eq_bit(43) || b.eq_bit(45) { EXP_SIGN }
        else { FAIL }
    } else if s.eq_bit(EXP_SIGN) {
        // After an exponent letter and its sign.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else { FAIL }
    } else if s.eq_bit(EXP) {
        // In an exponent's digits. Nothing a name could continue with
        // may follow the literal.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else if b.eq_bit(95) { EXP_UNDER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) { FAIL }
        else { DEAD }
    } else if s.eq_bit(EXP_UNDER) {
        // After a `_` in an exponent.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else { FAIL }
    } else {
        DEAD
    }
}

// Octal numerals, and the width suffix any whole numeral may end in
// (`42u64`, `0x1fi8`: `u` or `i` and a decimal width without leading zeros,
// issues/integer-literal-width-suffix.md). The suffix is part of the
// numeral's token.
runtime fn step_octal(s, b: u64) → u64 {
    if s.eq_bit(OCT_START) {
        // After `0o`: at least one digit.
        if b.sub(48).unsigned_lt_bit(8) { OCT }
        else { FAIL }
    } else if s.eq_bit(OCT) {
        // In an octal numeral.
        // Bytes: 95 `_`, 117 `u`, 105 `i`.
        if b.sub(48).unsigned_lt_bit(8) { OCT }
        else if b.eq_bit(95) { OCT_UNDER }
        else if b.eq_bit(117) || b.eq_bit(105) { SUF_LETTER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) || b.sub(48).unsigned_lt_bit(10) { FAIL }
        else { DEAD }
    } else if s.eq_bit(OCT_UNDER) {
        // After a `_` in an octal numeral.
        if b.sub(48).unsigned_lt_bit(8) { OCT }
        else { FAIL }
    } else if s.eq_bit(SUF_LETTER) {
        // After a numeral and a suffix's letter: the width's first digit,
        // since `42u` is no numeral.
        if b.eq_bit(48) { SUF_ZERO }
        else if b.sub(48).unsigned_lt_bit(10) { SUF }
        else { FAIL }
    } else if s.eq_bit(SUF) {
        // In a width. Nothing a name could continue with may follow it.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) { SUF }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) || b.eq_bit(95) { FAIL }
        else { DEAD }
    } else if s.eq_bit(SUF_ZERO) {
        // A width of `0`, which no digit may follow: a width is written
        // without leading zeros.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(26) || b.eq_bit(95) { FAIL }
        else { DEAD }
    } else {
        DEAD
    }
}

// Binary numerals.
runtime fn step_binary(s, b: u64) → u64 {
    if s.eq_bit(BIN_START) {
        // After `0b`: at least one digit.
        if b.sub(48).unsigned_lt_bit(2) { BIN }
        else { FAIL }
    } else if s.eq_bit(BIN) {
        // In a binary numeral.
        // Bytes: 95 `_`, 117 `u`, 105 `i`.
        if b.sub(48).unsigned_lt_bit(2) { BIN }
        else if b.eq_bit(95) { BIN_UNDER }
        else if b.eq_bit(117) || b.eq_bit(105) { SUF_LETTER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) || b.sub(48).unsigned_lt_bit(10) { FAIL }
        else { DEAD }
    } else if s.eq_bit(BIN_UNDER) {
        // After a `_` in a binary numeral.
        if b.sub(48).unsigned_lt_bit(2) { BIN }
        else { FAIL }
    } else {
        DEAD
    }
}

// Hexadecimal numerals.
runtime fn step_hex(s, b: u64) → u64 {
    if s.eq_bit(HEX_START) {
        // After `0x`: at least one digit.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX }
        else { FAIL }
    } else if s.eq_bit(HEX) {
        // In a hexadecimal numeral. `p` or `P` is its exponent letter,
        // `u` or `i` (no digit here) begins a width suffix, and a `.` may
        // begin a fraction, which only an exponent after it confirms.
        // Bytes: 95 `_`, 46 `.`, 117 `u`, 105 `i`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX }
        else if b.eq_bit(95) { HEX_UNDER }
        else if b.bor(32).eq_bit(112) { EXP_MARK }
        else if b.eq_bit(117) || b.eq_bit(105) { SUF_LETTER }
        else if b.bor(32).sub(97).unsigned_lt_bit(26) { FAIL }
        else if b.eq_bit(46) { HEX_DOT }
        else { DEAD }
    } else if s.eq_bit(HEX_UNDER) {
        // After a `_` in a hexadecimal numeral.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX }
        else if b.bor(32).eq_bit(112) { EXP_MARK }
        else { FAIL }
    } else if s.eq_bit(HEX_DOT) {
        // After a hexadecimal numeral and a `.`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX_FRAC }
        else { DEAD }
    } else {
        DEAD
    }
}

// Hexadecimal fractions, before the exponent that makes one a literal.
runtime fn step_hex_fraction(s, b: u64) → u64 {
    if s.eq_bit(HEX_FRAC) {
        // In a hexadecimal fraction that is well formed so far. It is a
        // literal only if an exponent follows, so this state accepts
        // nothing: without one the scan falls back to the numeral before
        // the point.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX_FRAC }
        else if b.eq_bit(95) { HEX_FRAC_UNDER }
        else if b.bor(32).eq_bit(112) { FRAC_MARK }
        else { DEAD }
    } else if s.eq_bit(HEX_FRAC_UNDER) {
        // After a `_` in a hexadecimal fraction: a digit keeps it well
        // formed, anything else in the fraction's alphabet does not.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX_FRAC }
        else if b.eq_bit(95) { HEX_FRAC_BAD }
        else if b.bor(32).eq_bit(112) { BAD_MARK }
        else { DEAD }
    } else if s.eq_bit(HEX_FRAC_BAD) {
        // In a hexadecimal fraction with a misplaced `_`: refused if an
        // exponent confirms it as a literal, and otherwise not a
        // fraction at all.
        // Bytes: 95 `_`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { HEX_FRAC_BAD }
        else if b.eq_bit(95) { HEX_FRAC_BAD }
        else if b.bor(32).eq_bit(112) { BAD_MARK }
        else { DEAD }
    } else {
        DEAD
    }
}

// The `p` after a hexadecimal fraction.
runtime fn step_hex_exponent(s, b: u64) → u64 {
    if s.eq_bit(FRAC_MARK) {
        // After a well-formed hexadecimal fraction and `p`: a digit or a
        // signed digit confirms the literal.
        // Bytes: 43 `+`, 45 `-`.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else if b.eq_bit(43) || b.eq_bit(45) { FRAC_SIGN }
        else { DEAD }
    } else if s.eq_bit(FRAC_SIGN) {
        // After a well-formed hexadecimal fraction, `p` and a sign.
        if b.sub(48).unsigned_lt_bit(10) { EXP }
        else { DEAD }
    } else if s.eq_bit(BAD_MARK) {
        // After an ill-formed hexadecimal fraction and `p`: the exponent
        // that would confirm it refuses it.
        // Bytes: 43 `+`, 45 `-`.
        if b.sub(48).unsigned_lt_bit(10) { FAIL }
        else if b.eq_bit(43) || b.eq_bit(45) { BAD_SIGN }
        else { DEAD }
    } else if s.eq_bit(BAD_SIGN) {
        // After an ill-formed hexadecimal fraction, `p` and a sign.
        if b.sub(48).unsigned_lt_bit(10) { FAIL }
        else { DEAD }
    } else {
        DEAD
    }
}

// String literals.
runtime fn step_string(s, b: u64) → u64 {
    if s.eq_bit(STR) {
        // In a string literal: the closing quote (34), an escape (92),
        // or any byte but a line feed. The literal does not span lines
        // or the end.
        if b.eq_bit(34) { DONE_STR }
        else if b.eq_bit(92) { STR_ESC }
        else if b.eq_bit(10) { FAIL }
        else if b.unsigned_lt_bit(256) { STR }
        else { FAIL }
    } else if s.eq_bit(STR_ESC) {
        // After `\` in a string: `n t r \ ' " 0`, or `u` (117) for a
        // braced scalar value.
        // Bytes: 110 `n`, 116 `t`, 114 `r`, 92 `\`, 39 `'`, 34 `"`, 48
        // `0`.
        if b.eq_bit(110) || b.eq_bit(116) || b.eq_bit(114) || b.eq_bit(92) || b.eq_bit(39) || b.eq_bit(34) || b.eq_bit(48) { STR }
        else if b.eq_bit(117) { STR_U }
        else { FAIL }
    } else if s.eq_bit(STR_U) {
        // After `\u` in a string.
        // Bytes: 123 `{`.
        if b.eq_bit(123) { STR_BRACE }
        else { FAIL }
    } else if s.eq_bit(STR_BRACE) {
        // After `\u{` in a string: at least one hexadecimal digit.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { STR_HEX }
        else { FAIL }
    } else if s.eq_bit(STR_HEX) {
        // In the digits of a `\u{…}` escape in a string.
        // Bytes: 125 `}`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { STR_HEX }
        else if b.eq_bit(125) { STR }
        else { FAIL }
    } else {
        DEAD
    }
}

// Character literals: the one scalar value.
runtime fn step_char(s, b: u64) → u64 {
    if s.eq_bit(CHR) {
        // After the opening `'`: an escape, or one scalar value, whose
        // first byte says how many continuation bytes follow.
        // Bytes: 92 `\`, 39 `'`.
        if b.eq_bit(92) { CHR_ESC }
        else if b.eq_bit(39) { FAIL }
        else if b.eq_bit(10) { FAIL }
        else if b.unsigned_lt_bit(128) { CHR_CLOSE }
        else if b.sub(0xc2).unsigned_lt_bit(30) { CHR_1 }
        else if b.sub(0xe0).unsigned_lt_bit(16) { CHR_2 }
        else if b.sub(0xf0).unsigned_lt_bit(5) { CHR_3 }
        else { FAIL }
    } else if s.eq_bit(CHR_3) {
        // In a character literal's scalar value, three continuation
        // bytes to go.
        if b.sub(0x80).unsigned_lt_bit(64) { CHR_2 }
        else { FAIL }
    } else if s.eq_bit(CHR_2) {
        // In a character literal's scalar value, two continuation bytes
        // to go.
        if b.sub(0x80).unsigned_lt_bit(64) { CHR_1 }
        else { FAIL }
    } else if s.eq_bit(CHR_1) {
        // In a character literal's scalar value, one continuation byte
        // to go.
        if b.sub(0x80).unsigned_lt_bit(64) { CHR_CLOSE }
        else { FAIL }
    } else if s.eq_bit(CHR_CLOSE) {
        // After a character literal's one scalar value: only the closing
        // `'` (39).
        if b.eq_bit(39) { DONE_CHAR }
        else { FAIL }
    } else {
        DEAD
    }
}

// Character literals: an escape.
runtime fn step_char_escape(s, b: u64) → u64 {
    if s.eq_bit(CHR_ESC) {
        // After `\` in a character literal.
        // Bytes: 110 `n`, 116 `t`, 114 `r`, 92 `\`, 39 `'`, 34 `"`, 48
        // `0`, 117 `u`.
        if b.eq_bit(110) || b.eq_bit(116) || b.eq_bit(114) || b.eq_bit(92) || b.eq_bit(39) || b.eq_bit(34) || b.eq_bit(48) { CHR_CLOSE }
        else if b.eq_bit(117) { CHR_U }
        else { FAIL }
    } else if s.eq_bit(CHR_U) {
        // After `\u` in a character literal.
        // Bytes: 123 `{`.
        if b.eq_bit(123) { CHR_BRACE }
        else { FAIL }
    } else if s.eq_bit(CHR_BRACE) {
        // After `\u{` in a character literal.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { CHR_HEX }
        else { FAIL }
    } else if s.eq_bit(CHR_HEX) {
        // In the digits of a `\u{…}` escape in a character literal.
        // Bytes: 125 `}`.
        if b.sub(48).unsigned_lt_bit(10) || b.bor(32).sub(97).unsigned_lt_bit(6) { CHR_HEX }
        else if b.eq_bit(125) { CHR_CLOSE }
        else { FAIL }
    } else {
        DEAD
    }
}

// `λ`, `¬` and argument slots.
runtime fn step_two_byte(s, b: u64) → u64 {
    if s.eq_bit(LEAD_CE) {
        // After the byte CE: `λ` is CE BB.
        if b.eq_bit(0xbb) { DONE_LAMBDA }
        else { DEAD }
    } else if s.eq_bit(LEAD_C2) {
        // After the byte C2: `¬` is C2 AC and `·` is C2 B7.
        if b.eq_bit(0xac) { DONE_NEG }
        else if b.eq_bit(0xb7) { SLOT }
        else { DEAD }
    } else if s.eq_bit(SLOT) {
        // After `·`: subscript digits `₀` to `₉` (E2 82 80 to E2 82 89)
        // are its index.
        if b.eq_bit(0xe2) { SLOT_E2 }
        else { DEAD }
    } else if s.eq_bit(SLOT_E2) {
        // After `·`, its digits so far, and E2.
        if b.eq_bit(0x82) { SLOT_82 }
        else { DEAD }
    } else if s.eq_bit(SLOT_82) {
        // After `·`, its digits so far, and E2 82.
        if b.sub(0x80).unsigned_lt_bit(10) { SLOT }
        else { DEAD }
    } else {
        DEAD
    }
}

// The second byte of a three-byte symbol, and `⁻¹`.
runtime fn step_three_byte(s, b: u64) → u64 {
    if s.eq_bit(LEAD_E2) {
        // After the byte E2, which begins every three-byte symbol and
        // `⁻¹`.
        if b.eq_bit(0x86) { ARROWS }
        else if b.eq_bit(0x88) { OPERATORS }
        else if b.eq_bit(0x89) { RELATIONS }
        else if b.eq_bit(0x8a) { LATTICE }
        else if b.eq_bit(0x9f) { BRACKETS }
        else if b.eq_bit(0x81) { SUP_MINUS }
        else { DEAD }
    } else if s.eq_bit(SUP_MINUS) {
        // After E2 81: `⁻` is E2 81 BB.
        if b.eq_bit(0xbb) { SUP_LEAD }
        else { DEAD }
    } else if s.eq_bit(SUP_LEAD) {
        // After `⁻`: `¹` is C2 B9, and nothing else may follow.
        if b.eq_bit(0xc2) { SUP_ONE }
        else { DEAD }
    } else if s.eq_bit(SUP_ONE) {
        // After `⁻` and C2.
        if b.eq_bit(0xb9) { DONE_SUP_INVERSE }
        else { DEAD }
    } else {
        DEAD
    }
}

// The third byte of a three-byte symbol: arrows, relations, lattice
// operations and brackets.
runtime fn step_symbols(s, b: u64) → u64 {
    if s.eq_bit(ARROWS) {
        // After E2 86: `←` 90, `↑` 91, `→` 92, `↔` 94.
        if b.eq_bit(0x90) { DONE_LARROW }
        else if b.eq_bit(0x91) { DONE_UP_ARROW }
        else if b.eq_bit(0x92) { DONE_ARROW }
        else if b.eq_bit(0x94) { DONE_IFF }
        else { DEAD }
    } else if s.eq_bit(RELATIONS) {
        // After E2 89: `≈` 88, `≠` A0.
        if b.eq_bit(0x88) { DONE_APPROX }
        else if b.eq_bit(0xa0) { DONE_NE }
        else { DEAD }
    } else if s.eq_bit(LATTICE) {
        // After E2 8A: `⊓` 93, `⊔` 94, `⊕` 95, `⊢` A2.
        if b.eq_bit(0x93) { DONE_MEET }
        else if b.eq_bit(0x94) { DONE_JOIN }
        else if b.eq_bit(0x95) { DONE_OPLUS }
        else if b.eq_bit(0xa2) { DONE_TURNSTILE }
        else { DEAD }
    } else if s.eq_bit(BRACKETS) {
        // After E2 9F: `⟦` A6, `⟧` A7, `⟨` A8, `⟩` A9.
        if b.eq_bit(0xa6) { DONE_LSEMANTIC }
        else if b.eq_bit(0xa7) { DONE_RSEMANTIC }
        else if b.eq_bit(0xa8) { DONE_LANGLE }
        else if b.eq_bit(0xa9) { DONE_RANGLE }
        else { DEAD }
    } else {
        DEAD
    }
}

// The third byte of a three-byte symbol: the quantifiers, the connectives
// and their neighbours.
runtime fn step_logic(s, b: u64) → u64 {
    if s.eq_bit(OPERATORS) {
        // After E2 88: `∀` 80, `∃` 83, `∏` 8F, `∑` 91, `∙` 99, `∥` A5,
        // `∧` A7, `∨` A8.
        if b.eq_bit(0x80) { DONE_FORALL }
        else if b.eq_bit(0x83) { DONE_EXISTS }
        else if b.eq_bit(0x8f) { DONE_BIG_PROD }
        else if b.eq_bit(0x91) { DONE_BIG_SUM }
        else if b.eq_bit(0x99) { DONE_BULLET }
        else if b.eq_bit(0xa5) { DONE_NORM_BAR }
        else if b.eq_bit(0xa7) { DONE_WEDGE }
        else if b.eq_bit(0xa8) { DONE_VEE }
        else { DEAD }
    } else {
        DEAD
    }
}

// ---------------------------------------------------------------------------
// The automaton.

// The family that takes byte `b` in state `s`, as its position among the
// families `scan_step` chooses from. A family's states are numbered from
// eight times its position among the state families, so a state's family is
// its number shifted; the start of a token, the second of them, is four functions
// chosen by the byte, which moves every family after it three places on.
runtime fn scan_family(s, b: u64) → u64 {
    let family = s.band(255).shift_right(3);
    if family.eq_bit(0) { 0 }
    else if family.eq_bit(1) {
        if b.unsigned_lt_bit(40) { 1 } else if b.unsigned_lt_bit(48) { 2 } else if b.unsigned_lt_bit(64) { 3 } else { 4 }
    }
    else { family.add(3) }
}

// The family numbered `f` takes byte `b` in state `s`. The families are in
// the order `scan_family` numbers them, found by halving, so the choice is
// five comparisons whichever family it is. A number past the last is no
// family: there is no way on.
runtime fn scan_choose(f, s, b: u64) → u64 {
    if f.unsigned_lt_bit(12) {
        if f.unsigned_lt_bit(6) {
            if f.unsigned_lt_bit(3) {
                if f.unsigned_lt_bit(1) { step_stop(s, b) } else if f.unsigned_lt_bit(2) { step_start_space(s, b) } else { step_start_punct(s, b) }
            } else {
                if f.unsigned_lt_bit(4) { step_start_mid(s, b) } else if f.unsigned_lt_bit(5) { step_start_high(s, b) } else { step_trivia(s, b) }
            }
        } else {
            if f.unsigned_lt_bit(9) {
                if f.unsigned_lt_bit(7) { step_names(s, b) } else if f.unsigned_lt_bit(8) { step_arrows(s, b) } else { step_doubles(s, b) }
            } else {
                if f.unsigned_lt_bit(10) { step_decimal(s, b) } else if f.unsigned_lt_bit(11) { step_fraction(s, b) } else { step_octal(s, b) }
            }
        }
    } else {
        if f.unsigned_lt_bit(18) {
            if f.unsigned_lt_bit(15) {
                if f.unsigned_lt_bit(13) { step_binary(s, b) } else if f.unsigned_lt_bit(14) { step_hex(s, b) } else { step_hex_fraction(s, b) }
            } else {
                if f.unsigned_lt_bit(16) { step_hex_exponent(s, b) } else if f.unsigned_lt_bit(17) { step_string(s, b) } else { step_char(s, b) }
            }
        } else {
            if f.unsigned_lt_bit(21) {
                if f.unsigned_lt_bit(19) { step_char_escape(s, b) } else if f.unsigned_lt_bit(20) { step_two_byte(s, b) } else { step_three_byte(s, b) }
            } else {
                if f.unsigned_lt_bit(22) { step_symbols(s, b) } else if f.unsigned_lt_bit(23) { step_logic(s, b) } else { DEAD }
            }
        }
    }
}

// One byte in a state: the state's family takes it. A word that is no state
// has no family and no way on (and neither `DEAD` nor a finished token has
// one in theirs).
//
// This is the automaton, and it is one compiled program: `scan_step::program`
// holds this function, `scan_family`, `scan_choose` and every family, and
// `scan_step::agrees` says the program computes this function, put together
// from each function's own `::compile` with no function's code read twice
// (`runtime.hthr`, "Linking").
//
// The choice is a function of its own, given the family, and not a `let`
// here: the kernel computes a `let` again at each place it is read
// (issues/elaborated-let-sharing-lost.md) and an argument once, and the
// kernel runs this function too (`lexer_tokens.hthr`).
runtime fn scan_step(s, b: u64) → u64 { scan_choose(scan_family(s, b), s, b) }

// The kind of the token that ends in a state, zero for none.
runtime fn scan_accept(s: u64) → u64 { s.shift_right(8) }

// The state a token starts in, from the kind of what was scanned before it,
// zero at the start of the source. `>>` is a shift only after a gap: the Rust
// lexer looks at the byte before the token (whitespace, `(` or `,`), and that
// byte is the end of the token before, whose kind says the same.
runtime fn scan_begin(previous: u64) → u64 {
    if previous.eq_bit(0) || previous.eq_bit(KIND_SPACE) || previous.eq_bit(KIND_LPAREN) || previous.eq_bit(KIND_COMMA) {
        START_SHIFT
    } else {
        START
    }
}

// Planning a function's byte writes with the facts found on demand
// (docs/facts-on-demand-design.md §7).
//
// `generate plan_writes(p, f, "name", fallback);` publishes `fn name() →
// WritePlan(p, f)`: each byte write of function `f` of the `rt` program `p`
// with a proof that it may be built in place where one is found, and as a
// copy where none is. For each write it asks for `Unique`
// (lib/std/tactic/fact_request.hthr): the fact's producers first (a
// published ownership verdict, through `Unique::of_owned`), then, when
// `fallback` is set, this planner's own, the one write's check by
// evaluation. A write nothing proves is copied. The plan is an ordinary
// declaration the host checks, and the kernel with it; the lowering that
// builds an in-place write from it is the runtime setup's
// (issues/runtime-default-setup-soundness.md).
import list;
import logic;
import bool;
import nat;
import option;
import string;
import tactic;
import fact_request;
import rt;
import unique;

fn fail_writes<A>(why: String) → Tac<A> { fail("plan_writes: " ++ why, []) }

fn writes_global(name: String) → Tac<Expr> {
    lookup(name).bind(λ c => match c { Accepted(g) => pure(Global(g)), Refused(why) => fail_writes(why) })
}

fn writes_apps(f: Expr, args: List<Expr>) → Expr {
    match args { Nil => f, Cons(a, rest) => writes_apps(App(f, a), rest) }
}

// How many writes the function has, by comparing the count with each
// numeral in turn.
fn write_count_from(count: Expr, i: Nat, fuel: Nat) → Tac<Nat> {
    match fuel {
        Zero => fail_writes("more writes than the walk allows"),
        Succ(f) => defeq(count, NatLit(i)).bind(λ same => match same { True => pure(i), False => write_count_from(count, Succ(i), f) }),
    }
}

// What the generator builds a plan from, as functions it can name.
fn write_found(p: Program, f: Nat, k: Nat, fact: Unique(p, f, k)) → WriteSite(p, f) { WriteSite(k, Some(fact)) }
fn write_copied(p: Program, f: Nat, k: Nat) → WriteSite(p, f) { WriteSite(k, None) }
fn write_sites_cons(p: Program, f: Nat, s: WriteSite(p, f), rest: List<WriteSite(p, f)>) → List<WriteSite(p, f)> { Cons(s, rest) }
fn write_sites_nil(p: Program, f: Nat) → List<WriteSite(p, f)> { Nil }
fn write_plan_of(p: Program, f: Nat, sites: List<WriteSite(p, f)>, all: WriteSite::ks(p, f, sites) = List::range(p.write_count(f))) → WritePlan(p, f) {
    WritePlan(sites, all)
}
theorem write_facts_true(): True { trivial }
fn PlannedWrites(p: Program, f: Nat) → Type { WritePlan(p, f) }

record WriteGlobals { unique: Expr, check: Expr, triv: Expr, found: Expr, copied: Expr, cons: Expr, nil: Expr }

fn write_globals() → Tac<WriteGlobals> {
    writes_global("Unique").bind(λ a => writes_global("Unique::by_check").bind(λ b => writes_global("write_facts_true").bind(λ c =>
    writes_global("write_found").bind(λ d => writes_global("write_copied").bind(λ e => writes_global("write_sites_cons").bind(λ f =>
    writes_global("write_sites_nil").bind(λ g => pure(WriteGlobals(a, b, c, d, e, f, g)))))))))
}

// The planner's own fallback: this write's verdict, by evaluation.
fn writes_fallbacks(gs: WriteGlobals, p, f, k: Expr, fallback: Bool) → List<Tac<Expr>> {
    match fallback { True => [pure(writes_apps(gs.check, [p, f, k, gs.triv]))], False => [] }
}

// One write, with its fact if one is found. The program is left as written:
// a published verdict is keyed by the program's name, which reducing it
// would hide from the evidence rules' prefilter.
fn write_site_for(gs: WriteGlobals, p, f: Expr, k: Nat, fallback: Bool) → Tac<Expr> {
    as_type(writes_apps(gs.unique, [p, f, NatLit(k)])).bind(λ c => match c {
        Refused(why) => fail_writes(why),
        Accepted(goal) => request(goal, writes_fallbacks(gs, p, f, NatLit(k), fallback), 64).bind(λ found => Pure(match found {
            Some(fact) => writes_apps(gs.found, [p, f, NatLit(k), fact]),
            None => writes_apps(gs.copied, [p, f, NatLit(k)]),
        })),
    })
}

// Writes `k` to `k + n` of the function.
fn write_sites_for(gs: WriteGlobals, p, f: Expr, k: Nat, n: Nat, fallback: Bool) → Tac<Expr> {
    match n {
        Zero => pure(writes_apps(gs.nil, [p, f])),
        Succ(m) => write_site_for(gs, p, f, k, fallback).bind(λ s =>
            write_sites_for(gs, p, f, Succ(k), m, fallback).bind(λ ss => pure(writes_apps(gs.cons, [p, f, s, ss])))),
    }
}

fn plan_writes(p: Expr, f: Nat, name: String, fallback: Bool) → Tac<List<Decl>> {
    write_globals().bind(λ gs =>
    writes_global("Program::write_count").bind(λ count_of =>
    writes_global("PlannedWrites").bind(λ ty => writes_global("write_plan_of").bind(λ mk => writes_global("tactic::rfl").bind(λ rfl =>
    write_count_from(writes_apps(count_of, [p, NatLit(f)]), 0, 1024).bind(λ n =>
    write_sites_for(gs, p, NatLit(f), 0, n, fallback).bind(λ sites =>
    Pure([Decl(AsFunction, name, [], writes_apps(ty, [p, NatLit(f)]),
        writes_apps(mk, [p, NatLit(f), sites, writes_apps(rfl, [Blank, Blank])]))]))))))))
}

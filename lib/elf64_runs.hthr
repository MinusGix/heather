// Straight native code, proved once (issues/native-straight-code-triples.md):
// where code is (`Placed`, `AsmPlaced`), what one block or near jump does
// (`Ran`, `run_block`, `run_near`), and the triple the process libraries
// compose phases with.
//
// `Runs(P, from, Q, to)`: from any state at `from` that satisfies `P`, Linux
// steps reach a state at `to` that satisfies `Q`. Facts that relate the end to
// the start are stated over ghost values the caller binds (a theorem's
// parameters), so `P` and `Q` are predicates on one state and sequencing is
// plain composition. Its rules: `runs_seq`, `runs_pre`/`runs_post`
// (consequence), `runs_here` (no step), `runs_block` (a straight block, its
// postcondition evaluated on `execute_block_normal`), `runs_ran` (any of the
// libraries' one-piece results), and `runs_branch` (a Jcc decided by a flag
// fact). `Keeps(regs, after, before)` and `SlotsKeep(slots, after, before)` are
// the frame conditions: registers and frame slots a phase leaves alone,
// transitive and weakened by list induction.

import elf64_io;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Where code is.

// Code at `at` whatever the page holds.
fn Placed(file: IoImage, code: List<BitVec(8)>, at: BitVec(64)) → Type {
    (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), code, at)
}
theorem placed_split(file: IoImage, front, back: List<BitVec(8)>, at: BitVec(64), placed: Placed(file, front ++ back, at)):
    Placed(file, front, at) ∧ Placed(file, back, next_rip(at, front.len())) {
    ⟨λ page => resident_split(io_fetch_access(), IoMemory(file, page), front, back, at, placed(page)).left,
     λ page => resident_split(io_fetch_access(), IoMemory(file, page), front, back, at, placed(page)).right⟩
}
// A piece of a laid-out block, placed where the layout puts it.
theorem placed_piece(file: IoImage, pieces: List<List<BitVec(8)>>, last: List<BitVec(8)>, lens: List<Nat>,
    measured: LayoutMeasured(pieces, lens), at: BitVec(64), placed: Placed(file, layout_code(pieces, last), at), i: Nat):
    Placed(file, layout_piece(pieces, last, i), next_rip(at, layout_at(0, lens, i))) {
    λ page => layout_resident(io_fetch_access(), IoMemory(file, page), at, last, pieces, lens, measured, 0, placed(page), i)
}

// A program's items, each placed at its label, wherever the program is.
fn AsmPlaced(file: IoImage, fills: Nat → List<BitVec(8)>, p: Prog, at: BitVec(64)) → Type {
    (l: Prog) → Placed(file, item_bytes(fills, asm_labels(p), asm_find(p, l)), next_rip(at, asm_at(asm_find(p, l))))
}
theorem asm_placed(file: IoImage, fills: Nat → List<BitVec(8)>, p: Prog, fits: FillsFit(p, fills), at: BitVec(64),
    placed: Placed(file, assemble(fills, p, Nil), at)): AsmPlaced(file, fills, p, at) {
    λ l page => asm_resident(io_fetch_access(), IoMemory(file, page), at, fills, asm_labels(p), p, fits, Nil, placed(page), l)
}

// ---------------------------------------------------------------------------
// One piece run.

// A straight block run from its start: memory unchanged, RIP past it.
record Ran(file: IoImage, page: Nat → BitVec(8), before, after: MachineState<IoMemory>, to: BitVec(64)) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), before, after),
    memory_is: after.memory = IoMemory(file, page),
    rip_is: after.rip = to,
}
theorem run_block(file: IoImage, page: Nat → BitVec(8), instructions: List<Instruction>, at: BitVec(64), k: Nat,
    placed: Placed(file, canonical_block_bytes(instructions), next_rip(at, k)), state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, k)):
    Ran(file, page, state, execute_block_normal(instructions, state), next_rip(at, k + canonical_block_bytes(instructions).len())) {
    let fetch = io_fetch_access();
    let ran = block_fetched(fetch, io_data_access(), instructions, state, trivial,
        resident_state(fetch, canonical_block_bytes(instructions), IoMemory(file, page), next_rip(at, k), state, memory_is, rip_is, placed(page)));
    Ran(steps := ran.left, memory_is := trans(pure_block_memory(instructions, state), memory_is),
        rip_is := trans(ran.right, rip_advance(at, state.rip, k, canonical_block_bytes(instructions).len(), rip_is)))
}
theorem run_near(file: IoImage, page: Nat → BitVec(8), control: NearControl, at: BitVec(64), k: Nat,
    placed: Placed(file, near_control_bytes(control), next_rip(at, k)), state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, k)):
    FetchedSteps(io_fetch_access(), io_data_access(), state, execute_near_control(control, state)) {
    let fetch = io_fetch_access();
    fetched_steps_one(fetch, io_data_access(), state, execute_near_control(control, state),
        near_fetched_step(fetch, io_data_access(), control, state,
            resident_state(fetch, near_control_bytes(control), IoMemory(file, page), next_rip(at, k), state, memory_is, rip_is, placed(page))))
}

// ---------------------------------------------------------------------------
// The triple.

fn Runs(pre: MachineState<IoMemory> → Type, from: BitVec(64), post: MachineState<IoMemory> → Type, to: BitVec(64)) → Type {
    (state: MachineState<IoMemory>) → state.rip = from → pre(state) →
        Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧ ((after.rip = to) ∧ post(after)))
}

theorem runs_seq(p: MachineState<IoMemory> → Type, a: BitVec(64), q: MachineState<IoMemory> → Type, b: BitVec(64),
    r: MachineState<IoMemory> → Type, c: BitVec(64), first: Runs(p, a, q, b), second: Runs(q, b, r, c)): Runs(p, a, r, c) {
    λ state at holds => {
        let one = first(state, at, holds);
        let two = second(one.witness, one.proof.right.left, one.proof.right.right);
        Exists(two.witness, ⟨linux_steps_trans(io_linux(), state, one.witness, two.witness, one.proof.left, two.proof.left), two.proof.right⟩)
    }
}
theorem runs_pre(p, q: MachineState<IoMemory> → Type, a: BitVec(64), r: MachineState<IoMemory> → Type, b: BitVec(64),
    weaker: (state: MachineState<IoMemory>) → p(state) → q(state), runs: Runs(q, a, r, b)): Runs(p, a, r, b) {
    λ state at holds => runs(state, at, weaker(state, holds))
}
theorem runs_post(p: MachineState<IoMemory> → Type, a: BitVec(64), q, r: MachineState<IoMemory> → Type, b: BitVec(64),
    runs: Runs(p, a, q, b), weaker: (state: MachineState<IoMemory>) → q(state) → r(state)): Runs(p, a, r, b) {
    λ state at holds => {
        let ran = runs(state, at, holds);
        Exists(ran.witness, ⟨ran.proof.left, ⟨ran.proof.right.left, weaker(ran.witness, ran.proof.right.right)⟩⟩)
    }
}
// No step.
theorem runs_here(p: MachineState<IoMemory> → Type, a: BitVec(64)): Runs(p, a, p, a) {
    λ state at holds => Exists(state, ⟨Exists(0, refl), ⟨at, holds⟩⟩)
}
// Any step the libraries prove one piece at a time: from each state the
// precondition admits, some Linux steps to `to` and the postcondition.
theorem runs_steps(p: MachineState<IoMemory> → Type, a: BitVec(64), q: MachineState<IoMemory> → Type, b: BitVec(64),
    step: (state: MachineState<IoMemory>) → state.rip = a → p(state) →
        Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧ ((after.rip = b) ∧ q(after)))): Runs(p, a, q, b) {
    step
}

// A straight block, wherever the precondition's memory holds it: the
// postcondition is met by the block's own result, which the kernel computes.
theorem runs_block(instructions: List<Instruction>, at: BitVec(64), k: Nat, p, q: MachineState<IoMemory> → Type,
    resident: (state: MachineState<IoMemory>) → p(state) →
        CodeResident(io_fetch_access(), state.memory, canonical_block_bytes(instructions), next_rip(at, k)),
    post: (state: MachineState<IoMemory>) → p(state) →
        execute_block_normal(instructions, state).memory = state.memory → q(execute_block_normal(instructions, state))):
    Runs(p, next_rip(at, k), q, next_rip(at, k + canonical_block_bytes(instructions).len())) {
    λ state rip_is holds => {
        let fetch = io_fetch_access();
        let ran = block_fetched(fetch, io_data_access(), instructions, state, trivial,
            j(sym(rip_is), λ here _ => CodeResident(fetch, state.memory, canonical_block_bytes(instructions), here), resident(state, holds)));
        Exists(execute_block_normal(instructions, state),
            ⟨linux_steps_of_fetched(io_linux(), state, execute_block_normal(instructions, state), ran.left),
             ⟨trans(ran.right, rip_advance(at, state.rip, k, canonical_block_bytes(instructions).len(), rip_is)),
              post(state, holds, pure_block_memory(instructions, state))⟩⟩)
    }
}

// A Jcc: the precondition's flags decide it. Each side runs on to `end` from
// the state the jump leaves; `stays` carries the precondition over the jump,
// which changes only RIP (`λ _ held => held` for a precondition that does not
// read RIP).
theorem runs_branch(cc: ConditionCode, d: BitVec(32), at: BitVec(64), from, to: Nat, lands: JumpsForward(from, 6, d, to),
    p: MachineState<IoMemory> → Type, r: MachineState<IoMemory> → Type, end: BitVec(64),
    resident: (state: MachineState<IoMemory>) → p(state) →
        CodeResident(io_fetch_access(), state.memory, near_control_bytes(JumpIfNear(cc, d)), next_rip(at, from)),
    stays: (state: MachineState<IoMemory>) → p(state) → p(execute_near_control(JumpIfNear(cc, d), state)),
    taken: Runs(λ state => p(state) ∧ (condition_holds(cc, state.flags) = True), next_rip(at, to), r, end),
    passed: Runs(λ state => p(state) ∧ (condition_holds(cc, state.flags) = False), next_rip(at, from + 6), r, end)):
    Runs(p, next_rip(at, from), r, end) {
    λ state rip_is holds => {
        let fetch = io_fetch_access();
        let jcc = JumpIfNear(cc, d);
        let s1 = execute_near_control(jcc, state);
        let step = linux_steps_of_fetched(io_linux(), state, s1,
            fetched_steps_one(fetch, io_data_access(), state, s1,
                near_fetched_step(fetch, io_data_access(), jcc, state,
                    j(sym(rip_is), λ here _ => CodeResident(fetch, state.memory, near_control_bytes(jcc), here), resident(state, holds)))));
        let rest = (match condition_holds(cc, state.flags) as λ b => (condition_holds(cc, state.flags) = b) →
                Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), s1, after) ∧ ((after.rip = end) ∧ r(after))) {
            True => λ yes => taken(s1,
                trans(near_if_taken_rip(cc, d, state, yes),
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 6, d), rip_is), jumps_forward(at, from, 6, d, to, lands))),
                ⟨stays(state, holds), yes⟩),
            False => λ no => passed(s1, trans(near_if_not_taken_rip(cc, d, state, no), rip_advance(at, state.rip, from, 6, rip_is)), ⟨stays(state, holds), no⟩),
        })(refl);
        Exists(rest.witness, ⟨linux_steps_trans(io_linux(), state, s1, rest.witness, step, rest.proof.left), rest.proof.right⟩)
    }
}

// A Jcc the precondition decides: not taken, on past it; taken, to its
// target. `stays` as in `runs_branch`.
theorem runs_jcc_passed(cc: ConditionCode, d: BitVec(32), at: BitVec(64), from: Nat, p, q: MachineState<IoMemory> → Type,
    resident: (state: MachineState<IoMemory>) → p(state) →
        CodeResident(io_fetch_access(), state.memory, near_control_bytes(JumpIfNear(cc, d)), next_rip(at, from)),
    fails: (state: MachineState<IoMemory>) → p(state) → condition_holds(cc, state.flags) = False,
    post: (state: MachineState<IoMemory>) → p(state) → q(execute_near_control(JumpIfNear(cc, d), state))):
    Runs(p, next_rip(at, from), q, next_rip(at, from + 6)) {
    λ state rip_is holds => {
        let fetch = io_fetch_access();
        let jcc = JumpIfNear(cc, d);
        Exists(execute_near_control(jcc, state),
            ⟨linux_steps_of_fetched(io_linux(), state, execute_near_control(jcc, state),
                fetched_steps_one(fetch, io_data_access(), state, execute_near_control(jcc, state),
                    near_fetched_step(fetch, io_data_access(), jcc, state,
                        j(sym(rip_is), λ here _ => CodeResident(fetch, state.memory, near_control_bytes(jcc), here), resident(state, holds))))),
             ⟨trans(near_if_not_taken_rip(cc, d, state, fails(state, holds)), rip_advance(at, state.rip, from, 6, rip_is)), post(state, holds)⟩⟩)
    }
}
theorem runs_jcc_taken(cc: ConditionCode, d: BitVec(32), at: BitVec(64), from, to: Nat, lands: JumpsForward(from, 6, d, to),
    p, q: MachineState<IoMemory> → Type,
    resident: (state: MachineState<IoMemory>) → p(state) →
        CodeResident(io_fetch_access(), state.memory, near_control_bytes(JumpIfNear(cc, d)), next_rip(at, from)),
    holds_there: (state: MachineState<IoMemory>) → p(state) → condition_holds(cc, state.flags) = True,
    post: (state: MachineState<IoMemory>) → p(state) → q(execute_near_control(JumpIfNear(cc, d), state))):
    Runs(p, next_rip(at, from), q, next_rip(at, to)) {
    λ state rip_is holds => {
        let fetch = io_fetch_access();
        let jcc = JumpIfNear(cc, d);
        Exists(execute_near_control(jcc, state),
            ⟨linux_steps_of_fetched(io_linux(), state, execute_near_control(jcc, state),
                fetched_steps_one(fetch, io_data_access(), state, execute_near_control(jcc, state),
                    near_fetched_step(fetch, io_data_access(), jcc, state,
                        j(sym(rip_is), λ here _ => CodeResident(fetch, state.memory, near_control_bytes(jcc), here), resident(state, holds))))),
             ⟨trans(near_if_taken_rip(cc, d, state, holds_there(state, holds)),
                 trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 6, d), rip_is), jumps_forward(at, from, 6, d, to, lands))),
              post(state, holds)⟩⟩)
    }
}

// A run ending where a process goes on: its steps are part of the process.
theorem runs_into(p: MachineState<IoMemory> → Type, a: BitVec(64), q: MachineState<IoMemory> → Type, b: BitVec(64),
    events: List<LinuxEvent>, runs: Runs(p, a, q, b), state: MachineState<IoMemory>, rip_is: state.rip = a, holds: p(state),
    then: (after: MachineState<IoMemory>) → after.rip = b → q(after) → LinuxRuns(io_linux(), events, after)): LinuxRuns(io_linux(), events, state) {
    let ran = runs(state, rip_is, holds);
    linux_runs_after_linux_steps(io_linux(), events, state, ran.witness, ran.proof.left, then(ran.witness, ran.proof.right.left, ran.proof.right.right))
}

// ---------------------------------------------------------------------------
// Frame conditions.

// The registers `regs` are the same after as before.
fn Keeps(regs: List<Gpr>, after, before: Gprs) → Type {
    match regs { Nil => True, Cons(r, rest) => (read_gpr(r, after) = read_gpr(r, before)) ∧ Keeps(rest, after, before) }
}
theorem keeps_refl(regs: List<Gpr>, gprs: Gprs): Keeps(regs, gprs, gprs) {
    match regs as λ rs => Keeps(rs, gprs, gprs) { Nil => trivial, Cons(_, rest) => ⟨refl, keeps_refl(rest, gprs)⟩ }
}
theorem keeps_trans(regs: List<Gpr>, after, middle, before: Gprs): Keeps(regs, after, middle) → Keeps(regs, middle, before) → Keeps(regs, after, before) {
    match regs as λ rs => Keeps(rs, after, middle) → Keeps(rs, middle, before) → Keeps(rs, after, before) {
        Nil => λ _ _ => trivial,
        Cons(_, rest) => λ late early => ⟨trans(late.left, early.left), keeps_trans(rest, after, middle, before, late.right, early.right)⟩,
    }
}
// Fewer registers: a prefix, or one register dropped from the front.
theorem keeps_tail(r: Gpr, regs: List<Gpr>, after, before: Gprs, kept: Keeps(Cons(r, regs), after, before)): Keeps(regs, after, before) {
    kept.right
}
theorem keeps_front(front, back: List<Gpr>, after, before: Gprs): Keeps(front ++ back, after, before) → Keeps(front, after, before) {
    match front as λ fs => Keeps(fs ++ back, after, before) → Keeps(fs, after, before) {
        Nil => λ _ => trivial,
        Cons(_, rest) => λ kept => ⟨kept.left, keeps_front(rest, back, after, before, kept.right)⟩,
    }
}
theorem keeps_back(front, back: List<Gpr>, after, before: Gprs): Keeps(front ++ back, after, before) → Keeps(back, after, before) {
    match front as λ fs => Keeps(fs ++ back, after, before) → Keeps(back, after, before) {
        Nil => λ kept => kept,
        Cons(_, rest) => λ kept => keeps_back(rest, back, after, before, kept.right),
    }
}

// The frame slots `slots` hold the same words after as before.
fn SlotsKeep(slots: List<Nat>, after, before: Nat → BitVec(64)) → Type {
    match slots { Nil => True, Cons(q, rest) => (after(q) = before(q)) ∧ SlotsKeep(rest, after, before) }
}
theorem slots_keep_refl(slots: List<Nat>, vars: Nat → BitVec(64)): SlotsKeep(slots, vars, vars) {
    match slots as λ qs => SlotsKeep(qs, vars, vars) { Nil => trivial, Cons(_, rest) => ⟨refl, slots_keep_refl(rest, vars)⟩ }
}
theorem slots_keep_trans(slots: List<Nat>, after, middle, before: Nat → BitVec(64)):
    SlotsKeep(slots, after, middle) → SlotsKeep(slots, middle, before) → SlotsKeep(slots, after, before) {
    match slots as λ qs => SlotsKeep(qs, after, middle) → SlotsKeep(qs, middle, before) → SlotsKeep(qs, after, before) {
        Nil => λ _ _ => trivial,
        Cons(_, rest) => λ late early => ⟨trans(late.left, early.left), slots_keep_trans(rest, after, middle, before, late.right, early.right)⟩,
    }
}
// A change at one slot `q` that keeps every other slot keeps a slot list that
// avoids `q`, decided by evaluation: `avoids` is `refl` on a closed list.
fn slots_avoid(slots: List<Nat>, q: Nat) → Bool {
    match slots { Nil => True, Cons(s, rest) => match Nat::eq_dec(s, q) { Inl(_) => False, Inr(_) => slots_avoid(rest, q) } }
}
theorem slots_keep_apart(q: Nat, after, before: Nat → BitVec(64), other: (i: Nat) → Not(i = q) → after(i) = before(i), slots: List<Nat>):
    slots_avoid(slots, q) = True → SlotsKeep(slots, after, before) {
    match slots as λ qs => slots_avoid(qs, q) = True → SlotsKeep(qs, after, before) {
        Nil => λ _ => trivial,
        Cons(s, rest) => (match Nat::eq_dec(s, q) as λ d =>
                (match d { Inl(_) => False, Inr(_) => slots_avoid(rest, q) }) = True → SlotsKeep(Cons(s, rest), after, before) {
            Inl(_) => λ never => absurd(never),
            Inr(apart) => λ avoids => ⟨other(s, apart), slots_keep_apart(q, after, before, other, rest, avoids)⟩,
        }),
    }
}

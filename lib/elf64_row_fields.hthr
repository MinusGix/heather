// A row's counts (docs/native-wc-command-design.md §6.1 `row`, §6.2 "columns
// are a table"): for each of the eight column slots in order, when the
// selection has the slot's bit, `%*d` of the slot's count at the cursor in
// the page, a space before every field but the first. The counts are words
// in the frame, one per slot, wherever the command keeps them; the same code
// writes a file's row and the total row. The code is library code with no
// program-specific bytes; it runs the formatter (elf64_format_width) once per
// selected slot, in a loop. The claim is `row_runs`, against
// `command_program`'s `row_counts`.
import command_program;
import decimal_line;
import elf64_arg_scan;
import elf64_format_width;
import elf64_runs;
import elf64_stretch;
import elf64_io;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The counts: slot `i`'s word at `slots + 8i`, in the frame (or anywhere the
// page is not), so whatever the page holds.

fn CountsAt(file: IoImage, slots: BitVec(64), counts: Nat → BitVec(64)) → Type {
    (page: Nat → BitVec(8)) → (i: Nat) → i < column_slots() → WordAt(io_data_access(), IoMemory(file, page), argv_slot(slots, i), counts(i))
}

// One slot's field, and whether a field has been written after it.
fn slot_field(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i: Nat) → List<BitVec(8)> {
    match column_selected(mask, i) { True => field_lead(first) ++ pad_left(width, field_gap(), decimal(counts(i).toNat())), False => Nil }
}
fn first_after(mask: BitVec(64), first: Bool, i: Nat) → Bool { match column_selected(mask, i) { True => False, False => first } }

theorem row_unfold(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i, k: Nat):
    row_fields(width, mask, counts, first, i, Succ(k)) =
        slot_field(width, mask, counts, first, i) ++ row_fields(width, mask, counts, first_after(mask, first, i), Succ(i), k) {
    let lead = field_lead(first);
    let pad = pad_left(width, field_gap(), decimal(counts(i).toNat()));
    match column_selected(mask, i) as λ c =>
            (match c { False => row_fields(width, mask, counts, first, Succ(i), k),
                       True => lead ++ (pad ++ row_fields(width, mask, counts, False, Succ(i), k)) }) =
            (match c as λ _ => List<BitVec(8)> { True => lead ++ pad, False => Nil }) ++
                row_fields(width, mask, counts, match c { True => False, False => first }, Succ(i), k) {
        True => sym(List::append_assoc(lead, pad, row_fields(width, mask, counts, False, Succ(i), k))),
        False => refl,
    }
}

// ---------------------------------------------------------------------------
// The code. The caller sets R12 to slot 0's address, R13 to the selection,
// R14 to the width and RDI to the cursor.
//
//   setup:  R15 := 1 (slot 0's bit), R9 := 1 (no field yet)
//   head:   R13 & R15 zero: skip
//           R9 set: field.  Otherwise store ' ' at RDI; RDI += 1
//   field:  R9 := 0; RDX := R14; RAX := the word at R12; %*d (the formatter)
//   skip:   R12 += 8; R15 += R15; R15 below 256: head
//
// RDI ends past the fields. RSP, RBP, R8 and R10 are kept.

fn row_setup_block() → List<Instruction> { [MovRI(R15, BitVec::ofNat(1)), MovRI(R9, BitVec::ofNat(1))] }
fn row_test_block() → List<Instruction> { [MovRR(R11, R13), AndRR(R11, R15), MovRI(Rax, word_zero()), CmpRR(R11, Rax)] }
fn row_lead_block() → List<Instruction> { [MovRI(Rax, word_zero()), CmpRR(R9, Rax)] }
fn row_gap_block() → List<Instruction> { [MovRI(R11, BitVec::ofNat(32))] }
fn row_gap_store() → ByteStore { ByteStore(base := Rdi, source := R11) }
fn row_step_block() → List<Instruction> { [AddRI8(Rdi, one_byte())] }
fn row_field_block() → List<Instruction> { [MovRI(R9, word_zero()), MovRR(Rdx, R14)] }
fn row_count_load() → WordLoad { WordLoad(destination := Rax, base := R12) }
fn row_next_block() → List<Instruction> { [AddRI8(R12, eight_byte()), AddRR(R15, R15), MovRI(R11, BitVec::ofNat(256)), CmpRR(R15, R11)] }

// The row as a program (x86_64_asm). The jumps' targets, named.
fn tr_head() → Nat { 1 }
fn tr_field() → Nat { 2 }
fn tr_skip() → Nat { 3 }
fn lr_setup() → Prog { then(Start, Block(row_setup_block())) }
// head: a slot not selected is skipped; a field after the first is led by ' '
fn lr_head() → Prog { At(lr_setup(), tr_head(), Block(row_test_block())) }
fn lr_skip_je() → Prog { then(lr_head(), Jcc(E, tr_skip())) }
fn lr_lead() → Prog { then(lr_skip_je(), Block(row_lead_block())) }
fn lr_field_jne() → Prog { then(lr_lead(), Jcc(NE, tr_field())) }
fn lr_gap() → Prog { then(lr_field_jne(), Block(row_gap_block())) }
fn lr_gap_store() → Prog { then(lr_gap(), StoreByte(row_gap_store())) }
fn lr_step() → Prog { then(lr_gap_store(), Block(row_step_block())) }
// field: the count, by the formatter
fn lr_field() → Prog { At(lr_step(), tr_field(), Block(row_field_block())) }
fn lr_load() → Prog { then(lr_field(), Load(row_count_load())) }
fn lr_format() → Prog { then(lr_load(), Piece(format_code(), format_len(), format_code_len())) }
// skip: the next slot, until the last
fn lr_skip() → Prog { At(lr_format(), tr_skip(), Block(row_next_block())) }
fn lr_back() → Prog { then(lr_skip(), Jcc(NE, tr_head())) }
fn lr_end() → Prog { then(lr_back(), Block(Nil)) }
fn row_prog() → Prog { lr_end() }
fn row_labels() → Nat → Nat { asm_labels(row_prog()) }
fn row_code() → List<BitVec(8)> { assemble(no_fills(), row_prog(), Nil) }
// The program's size, closed: a client's offsets add it without evaluating
// the program.
fn row_len() → Nat { 1712 }
theorem row_len_closed(): prog_len(row_prog()) = row_len() { refl }
// Label `l`'s offset in the row, and the displacement of the jump there.
fn ra(l: Prog) → Nat { asm_at(l) }
fn rd(l: Prog) → BitVec(32) { asm_jump(row_labels(), l) }
theorem row_code_len(): row_code().len() = row_len() { trans(asm_len_is(no_fills(), row_labels(), row_prog(), trivial, Nil, 0, refl), row_len_closed()) }

theorem rj_skip_je(): JumpsForward(ra(lr_skip_je()), 6, rd(lr_skip_je()), ra(lr_skip())) { asm_jump_lands(row_labels(), lr_skip_je(), 6, ra(lr_skip()), refl) }
theorem rj_field_jne(): JumpsForward(ra(lr_field_jne()), 6, rd(lr_field_jne()), ra(lr_field())) { asm_jump_lands(row_labels(), lr_field_jne(), 6, ra(lr_field()), refl) }
theorem rj_back(): JumpsBack(ra(lr_back()), 6, rd(lr_back()), ra(lr_head())) { asm_jump_lands_back(row_labels(), lr_back(), 6, ra(lr_head()), refl) }

fn RowPieces(file: IoImage, at: BitVec(64)) → Type { AsmPlaced(file, no_fills(), row_prog(), at) }
theorem row_pieces(file: IoImage, at: BitVec(64), placed: Placed(file, row_code(), at)): RowPieces(file, at) {
    asm_placed(file, no_fills(), row_prog(), trivial, at, placed)
}
// The row's stretches (elf64_stretch): the `n` items ending at label `l`.
theorem row_straight(file: IoImage, at: BitVec(64), placed: Placed(file, row_code(), at), page: Nat → BitVec(8),
    goal: MachineState<IoMemory> → Type, back: StepsBack(goal), l: Prog, found: asm_find(row_prog(), l) = l, n: Nat,
    state: MachineState<IoMemory>, rip: state.rip = next_rip(at, straight_from(l, n)), memory_is: state.memory = IoMemory(file, page),
    held: Stretch(file, at, goal, row_labels(), l, n, page, state)): goal(state) {
    let k = prog_depth(row_prog()) -prog_depth(l);
    let fills = no_fills();
    let front = asm_code(fills, row_labels(), asm_back(row_prog(), k));
    let after = asm_code_after(fills, row_labels(), row_prog(), k);
    stretch_runs(file, page, at, goal, back, fills, row_labels(), l, n,
        j(found, λ x _ => FillsFit(x, fills), fills_fit_back(fills, k, row_prog(), trivial)), after ++ Nil,
        j(found, λ x _ => Placed(file, asm_code(fills, row_labels(), x) ++ (after ++ Nil), at),
            j(trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ c => c ++ Nil, asm_code_back(fills, row_labels(), k, row_prog())),
                List::append_assoc(front, after, Nil)), λ c _ => Placed(file, c, at), placed)),
        state, rip, memory_is, held)
}
// A jump's landing as a stretch spells its leaf, by its target's name; the
// landing facts (`rj_*`) spell it by the jump's own label.
theorem row_lands(at: BitVec(64), before: Prog, size, target, to: Nat,
    lands: JumpsForward(prog_len(before), size, near_rel(prog_len(before) + size, row_labels()(target)), to)):
    near_branch_target(next_rip(at, prog_len(before)), size, near_rel(prog_len(before) + size, row_labels()(target))) = next_rip(at, to) {
    jumps_forward(at, prog_len(before), size, near_rel(prog_len(before) + size, row_labels()(target)), to, lands)
}
theorem row_lands_back(at: BitVec(64), before: Prog, size, target, to: Nat,
    lands: JumpsBack(prog_len(before), size, near_rel(prog_len(before) + size, row_labels()(target)), to)):
    near_branch_target(next_rip(at, prog_len(before)), size, near_rel(prog_len(before) + size, row_labels()(target))) = next_rip(at, to) {
    jumps_back(at, prog_len(before), size, near_rel(prog_len(before) + size, row_labels()(target)), to, lands)
}

// ---------------------------------------------------------------------------
// Bits, lengths and the page.

// R15 doubled: the next slot's bit, and 256 only past the last slot.
fn doubled(i: Nat) → BitVec(64) { column_bit(i).add(column_bit(i)) }
fn BitsMore(i: Nat) → Type { (doubled(i) = column_bit(Succ(i))) ∧ (is_zero_bits(64, doubled(i).sub(BitVec::ofNat(256))) = False) }
theorem bits_more(i: Nat): i < 7 → BitsMore(i) {
    match i as λ v => v < 7 → BitsMore(v) {
        Zero => λ _ => ⟨refl, refl⟩,
        Succ(m1) => match m1 as λ v => Succ(v) < 7 → BitsMore(Succ(v)) {
            Zero => λ _ => ⟨refl, refl⟩,
            Succ(m2) => match m2 as λ v => Succ(Succ(v)) < 7 → BitsMore(Succ(Succ(v))) {
                Zero => λ _ => ⟨refl, refl⟩,
                Succ(m3) => match m3 as λ v => Succ(Succ(Succ(v))) < 7 → BitsMore(Succ(Succ(Succ(v)))) {
                    Zero => λ _ => ⟨refl, refl⟩,
                    Succ(m4) => match m4 as λ v => Succ(Succ(Succ(Succ(v)))) < 7 → BitsMore(Succ(Succ(Succ(Succ(v))))) {
                        Zero => λ _ => ⟨refl, refl⟩,
                        Succ(m5) => match m5 as λ v => Succ(Succ(Succ(Succ(Succ(v))))) < 7 → BitsMore(Succ(Succ(Succ(Succ(Succ(v)))))) {
                            Zero => λ _ => ⟨refl, refl⟩,
                            Succ(m6) => match m6 as λ v => Succ(Succ(Succ(Succ(Succ(Succ(v)))))) < 7 →
                                    BitsMore(Succ(Succ(Succ(Succ(Succ(Succ(v))))))) {
                                Zero => λ _ => ⟨refl, refl⟩,
                                Succ(_) => λ below => false_elim(Nat::lt_irrefl(0, { omega })),
                            },
                        },
                    },
                },
            },
        },
    }
}
theorem bits_last(): is_zero_bits(64, doubled(7).sub(BitVec::ofNat(256))) = True { refl }

// A count has at most twenty digits, so a field is at most the width and
// twenty-one bytes.
theorem places_le(n: Nat, j: Nat): places_reached(j, n) <= j {
    match j as λ m => places_reached(m, n) <= m {
        Zero => Nat::le_refl(0),
        Succ(i) => {
            let one = reaches_le(ten_pow(Succ(i)), n);
            let rest = places_le(n, i);
            let sum: (places_reached(Succ(i), n) = reaches(ten_pow(Succ(i)), n) + places_reached(i, n)) = refl;
            let bound: (places_reached(Succ(i), n) <= Succ(i)) = omega;
            bound
        },
    }
}
theorem padded_le(w: Nat, x: BitVec(64)): padded_decimal(w, x.toNat()).len() <= w + 20 {
    let n = x.toNat();
    let digits: (decimal(n).len() = Succ(places_reached(19, n))) = decimal_len(n, BitVec::toNat_lt_pow(64, x));
    let few = places_le(n, 19);
    let len = padded_len(w, n);
    let cut = Nat::sub_le(w, decimal(n).len());
    let bound: (padded_decimal(w, n).len() <= w + 20) = omega;
    bound
}
theorem slot_field_le(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i: Nat):
    slot_field(width, mask, counts, first, i).len() <= width + 21 {
    let pad = padded_decimal(width, counts(i).toNat());
    let short = padded_le(width, counts(i));
    let lead: (field_lead(first).len() <= 1) = match first as λ f => field_lead(f).len() <= 1 { True => { omega }, False => { omega } };
    let both: ((field_lead(first) ++ pad).len() = field_lead(first).len() + pad.len()) = List::len_append(field_lead(first), pad);
    match column_selected(mask, i) as λ c => (match c as λ _ => List<BitVec(8)> { True => field_lead(first) ++ pad, False => Nil }).len() <= width + 21 {
        True => { let bound: ((field_lead(first) ++ pad).len() <= width + 21) = omega; bound },
        False => { let none: (0 <= width + 21) = omega; none },
    }
}
// Room for `k + 1` more fields.
fn fields_room(width, k: Nat) → Nat { match k { Zero => width + 21, Succ(j) => (width + 21) + fields_room(width, j) } }

// Two stores in turn: the page holds both, and nothing else changed.
theorem page_join(page0, page1, page2: Nat → BitVec(8), o: Nat, a, b: List<BitVec(8)>, first: PageNext(page0, page1, o, a),
    second: PageNext(page1, page2, o + a.len(), b)): PageNext(page0, page2, o, a ++ b) {
    let kept: Stored(page2, o, a) = λ i byte present => {
        let inside: (i < a.len()) = nth_some_below(a, i, byte, present);
        trans(second.below(i + o, { omega }), first.held(i, byte, present))
    };
    let grown: ((a ++ b).len() = a.len() + b.len()) = List::len_append(a, b);
    PageNext(held := stored_join(page2, o, a, b, kept, second.held),
        below := λ q short => trans(second.below(q, { omega }), first.below(q, short)),
        above := λ q past => trans(second.above(q, { omega }), first.above(q, { omega })))
}
theorem page_same(page0: Nat → BitVec(8), o: Nat): PageNext(page0, page0, o, Nil) {
    PageNext(held := stored_nothing(page0, o), below := λ q _ => refl, above := λ q _ => refl)
}

// ---------------------------------------------------------------------------
// The loop's state.

record RowKept(after, before: Gprs) {
    rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before),
    rbp: read_gpr(Rbp, after) = read_gpr(Rbp, before),
    r8: read_gpr(R8, after) = read_gpr(R8, before),
    r10: read_gpr(R10, after) = read_gpr(R10, before),
}

// RDI at offset `c` of the page, R9 saying whether no field has been
// written, R12 at slot `k`, R13 the selection, R14 the width, R15 the slot's
// bit; RSP, RBP, R8 and R10 kept.
fn RowRegs(width: Nat, mask, slots: BitVec(64), c, k: Nat, bit: BitVec(64), first: Bool, origin, gprs: Gprs) → Type {
    (read_gpr(Rdi, gprs).toNat() = io_page_base() + c) ∧ ((read_gpr(R9, gprs) = ended_word(first)) ∧
    ((read_gpr(R12, gprs) = argv_slot(slots, k)) ∧ ((read_gpr(R13, gprs) = mask) ∧ ((read_gpr(R14, gprs).toNat() = width) ∧
    ((read_gpr(R15, gprs) = bit) ∧ ((read_gpr(Rsp, gprs) = read_gpr(Rsp, origin)) ∧ ((read_gpr(Rbp, gprs) = read_gpr(Rbp, origin)) ∧
    ((read_gpr(R8, gprs) = read_gpr(R8, origin)) ∧ (read_gpr(R10, gprs) = read_gpr(R10, origin))))))))))
}
// The formatter keeps all but RDI.
theorem row_regs_fmt(width: Nat, mask, slots: BitVec(64), c, c2, k: Nat, bit: BitVec(64), first: Bool, origin, before, after: Gprs,
    fk: FmtKept(after, before), r: RowRegs(width, mask, slots, c, k, bit, first, origin, before),
    rdi: read_gpr(Rdi, after).toNat() = io_page_base() + c2): RowRegs(width, mask, slots, c2, k, bit, first, origin, after) {
    ⟨rdi, ⟨trans(fk.right.right.right.left, r.right.left), ⟨trans(fk.right.right.right.right.right.left, r.right.right.left),
    ⟨trans(fk.right.right.right.right.right.right.left, r.right.right.right.left),
    ⟨trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), fk.right.right.right.right.right.right.right.left), r.right.right.right.right.left),
    ⟨trans(fk.right.right.right.right.right.right.right.right, r.right.right.right.right.right.left),
    ⟨trans(fk.left, r.right.right.right.right.right.right.left), ⟨trans(fk.right.left, r.right.right.right.right.right.right.right.left),
    ⟨trans(fk.right.right.left, r.right.right.right.right.right.right.right.right.left),
    trans(fk.right.right.right.right.left, r.right.right.right.right.right.right.right.right.right)⟩⟩⟩⟩⟩⟩⟩⟩⟩
}

// At `rip`, `bytes` stored from `o`, R12 at slot `k`, R15 as `bit`, and
// `first` saying no field has been written.
record RowAt(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), rip, width: Nat, mask, slots: BitVec(64), o: Nat,
    bytes: List<BitVec(8)>, k: Nat, bit: BitVec(64), first: Bool, origin: Gprs, state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, rip),
    holds: PageNext(page0, page, o, bytes),
    regs: RowRegs(width, mask, slots, o + bytes.len(), k, bit, first, origin, state.gprs),
}
// Past the code: the fields stored, the cursor past them.
record RowOut(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), o: Nat, bytes: List<BitVec(8)>, origin: Gprs,
    state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, row_len()),
    holds: PageNext(page0, page, o, bytes),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (o + bytes.len()),
    kept: RowKept(state.gprs, origin),
}
fn RowReach(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), o: Nat, bytes: List<BitVec(8)>, origin: Gprs,
    state: MachineState<IoMemory>) → Type {
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧ RowOut(file, page0, at, o, bytes, origin, after))
}
theorem row_back(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), o: Nat, bytes: List<BitVec(8)>, origin: Gprs):
    StepsBack(λ s => RowReach(file, page0, at, o, bytes, origin, s)) {
    λ before middle steps reach => Exists(reach.witness, ⟨linux_steps_trans(io_linux(), before, middle, reach.witness, steps, reach.proof.left),
        reach.proof.right⟩)
}
// What follows slot `i` from `skip`, `bytes` stored by then.
fn SkipThen(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), width: Nat, mask, slots: BitVec(64), o: Nat, bytes: List<BitVec(8)>,
    i: Nat, first: Bool, origin: Gprs, goal: MachineState<IoMemory> → Type) → Type {
    (state: MachineState<IoMemory>) → RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state) →
        goal(state)
}

// ---------------------------------------------------------------------------
// One slot.

// The phases' side conditions, each in a context of its own: an `omega`
// inside a phase reads every fact in scope, the phases' states too
// (docs/native-straight-runs-design.md).
theorem field_fits(a, p, w: Nat, short: p <= w + 20, room: a + (w + 20) <= 4096): a + p <= 4096 { omega }
theorem field_sum(o, b, p, l: Nat, grown: l = b + p): (o + b) + p = o + l { omega }
theorem room_less(a, w: Nat, room: a + (w + 21) <= 4096): a + (w + 20) <= 4096 { omega }
theorem room_inside(a, w: Nat, room: a + (w + 21) <= 4096): a < 4096 { omega }
theorem gap_room(o, b, w: Nat, room: (o + b) + (w + 21) <= 4096): (o + Succ(b)) + (w + 20) <= 4096 { omega }
theorem slot_room(a, w, r: Nat, room: a + ((w + 21) + r) <= 4096): a + (w + 21) <= 4096 { omega }
theorem rest_room(o, b, f, l, w, r: Nat, grown: l = b + f, short: f <= w + 21, room: (o + b) + ((w + 21) + r) <= 4096): (o + l) + r <= 4096 { omega }
theorem last_slot(i: Nat, count: i + 1 = column_slots()): (i = 7) ∧ (i < column_slots()) { ⟨omega, omega⟩ }
theorem slot_more(i, m: Nat, count: i + Succ(Succ(m)) = column_slots()): (i < 7) ∧ ((i < column_slots()) ∧ (Succ(i) + Succ(m) = column_slots())) {
    ⟨omega, ⟨omega, omega⟩⟩
}
theorem row_room(o, w: Nat, room: o + 8 * (w + 21) <= 4096): o + fields_room(w, 7) <= 4096 {
    let rooms: (fields_room(w, 7) = (w + 21) + ((w + 21) + ((w + 21) + ((w + 21) + ((w + 21) + ((w + 21) + ((w + 21) + (w + 21)))))))) = refl;
    omega
}

// The count's field, by the formatter, from `format` to `skip`: R9 cleared,
// RDX the width and RAX the count.
theorem row_format(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    o: Nat, bytes: List<BitVec(8)>, i: Nat, origin: Gprs, count: BitVec(64), goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    then: SkipThen(file, page0, at, width, mask, slots, o, bytes ++ padded_decimal(width, count.toNat()), i, False, origin, goal),
    state: MachineState<IoMemory>, room: (o + bytes.len()) + (width + 20) <= 4096,
    head: RowAt(file, page0, at, ra(lr_format()), width, mask, slots, o, bytes, i, column_bit(i), False, origin, state),
    rdx: read_gpr(Rdx, state.gprs).toNat() = width, rax: read_gpr(Rax, state.gprs) = count): goal(state) {
    let c = o + bytes.len();
    let pad = padded_decimal(width, count.toNat());
    let fits: (c + padded_decimal(width, read_gpr(Rax, state.gprs).toNat()).len() <= 4096) =
        j(sym(rax), λ x _ => c + padded_decimal(width, x.toNat()).len() <= 4096, field_fits(c, pad.len(), width, padded_le(width, count), room));
    have formatted = format_runs(file, next_rip(at, ra(lr_format())), piece(lr_format()), head.page, width, c, state, head.memory_is, head.rip_is,
        rdx, head.regs.left, fits);
    let s1 = formatted.witness;
    let out = j(rax, λ x _ => FmtOut(file, head.page, c, padded_decimal(width, x.toNat()), next_rip(next_rip(at, ra(lr_format())), format_len()),
        state.gprs, s1), formatted.proof.right);
    let joined = page_join(page0, head.page, out.page, o, bytes, pad, head.holds, PageNext(held := out.held, below := out.below, above := out.above));
    let grown: ((bytes ++ pad).len() = bytes.len() + pad.len()) = List::len_append(bytes, pad);
    let sum: (c + pad.len() = o + (bytes ++ pad).len()) = field_sum(o, bytes.len(), pad.len(), (bytes ++ pad).len(), grown);
    let rdi: (read_gpr(Rdi, s1.gprs).toNat() = io_page_base() + (o + (bytes ++ pad).len())) =
        trans(out.rdi, cong_fn<Nat, Nat>(λ l => io_page_base() + l, sum));
    back(state, s1, formatted.proof.left, then(s1, RowAt(page := out.page, memory_is := out.memory_is,
        rip_is := trans(out.rip_is, rip_compose(at, ra(lr_format()), format_len())), holds := joined,
        regs := row_regs_fmt(width, mask, slots, c, o + (bytes ++ pad).len(), i, column_bit(i), False, origin, state.gprs, s1.gprs, out.kept,
            head.regs, rdi))))
}

// The first field, from `field`: one stretch of two items to the count's
// load, then the formatter.
theorem row_field(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, row_code(), at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, bytes: List<BitVec(8)>, i: Nat, below: i < column_slots(),
    origin: Gprs, goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    then: SkipThen(file, page0, at, width, mask, slots, o, bytes ++ padded_decimal(width, counts(i).toNat()), i, False, origin, goal),
    state: MachineState<IoMemory>, room: (o + bytes.len()) + (width + 20) <= 4096,
    head: RowAt(file, page0, at, ra(lr_field()), width, mask, slots, o, bytes, i, column_bit(i), True, origin, state)): goal(state) {
    let r = head.regs;
    row_straight(file, at, placed, head.page, goal, back, lr_load(), refl, 2, state, head.rip_is, head.memory_is,
        Exists(counts(i), Exists(argv_slot(slots, i), ⟨r.right.right.left, ⟨held(head.page, i, below),
            λ e rip m same => row_format(file, page0, at, row_pieces(file, at, placed), width, mask, slots, o, bytes, i, origin, counts(i), goal, back,
                then, e, room,
                RowAt(page := head.page, memory_is := m, rip_is := rip, holds := head.holds,
                    regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + bytes.len(), i, column_bit(i), False, origin, s.gprs),
                        ⟨r.left, ⟨refl, r.right.right⟩⟩)),
                j(sym(same), λ s _ => read_gpr(Rdx, s.gprs).toNat() = width, r.right.right.right.right.left),
                j(sym(same), λ s _ => read_gpr(Rax, s.gprs) = counts(i), refl))⟩⟩)))
}

// One slot, from `head`: a slot not selected is one stretch to the JE; the
// first field one to the JNE, then `row_field`; any other field one of nine
// items, its space stored, to the count's load. Then the formatter.
theorem row_slot(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, row_code(), at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, bytes: List<BitVec(8)>, i: Nat, below: i < column_slots(),
    first: Bool, origin: Gprs, goal: MachineState<IoMemory> → Type, back: StepsBack(goal), state: MachineState<IoMemory>,
    room: (o + bytes.len()) + (width + 21) <= 4096,
    head: RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state),
    then: SkipThen(file, page0, at, width, mask, slots, o, bytes ++ slot_field(width, mask, counts, first, i), i, first_after(mask, first, i), origin,
        goal)): goal(state) {
    let page = head.page;
    let pad = padded_decimal(width, counts(i).toNat());
    let anded: (read_gpr(R13, state.gprs).band(read_gpr(R15, state.gprs)) = mask.band(column_bit(i))) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ m => m.band(read_gpr(R15, state.gprs)), head.regs.right.right.right.left),
            cong_fn<BitVec(64), BitVec(64)>(λ b => mask.band(b), head.regs.right.right.right.right.right.left));
    let zf: (is_zero_bits(64, read_gpr(R13, state.gprs).band(read_gpr(R15, state.gprs)).sub(word_zero())) = mask.band(column_bit(i)).eq_bit(word_zero())) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), anded), zero_bits_sub(64, mask.band(column_bit(i)), word_zero()));
    (match mask.band(column_bit(i)).eq_bit(word_zero()) as λ c =>
            (is_zero_bits(64, read_gpr(R13, state.gprs).band(read_gpr(R15, state.gprs)).sub(word_zero())) = c) →
            SkipThen(file, page0, at, width, mask, slots, o, bytes ++ (match !c as λ _ => List<BitVec(8)> { True => field_lead(first) ++ pad, False => Nil }),
                i, match !c { True => False, False => first }, origin, goal) → goal(state) {
        True => λ none skip => row_straight(file, at, placed, page, goal, back, lr_skip_je(), refl, 2, state, head.rip_is, head.memory_is,
            ⟨λ _ e rip m same => skip(e, j(sym(List::append_nil(bytes)),
                    λ l _ => RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, l, i, column_bit(i), first, origin, e),
                    RowAt(page := page, memory_is := m, rip_is := trans(rip, row_lands(at, lr_head(), 6, tr_skip(), ra(lr_skip()), rj_skip_je())),
                        holds := head.holds,
                        regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + bytes.len(), i, column_bit(i), first, origin, s.gprs), head.regs)))),
             λ passed => absurd(trans(sym(passed), none))⟩),
        False => λ some skip0 => (match first as λ f => RowRegs(width, mask, slots, o + bytes.len(), i, column_bit(i), f, origin, state.gprs) →
                SkipThen(file, page0, at, width, mask, slots, o, bytes ++ (field_lead(f) ++ pad), i, False, origin, goal) → goal(state) {
            True => λ r skip => {
                let z2: (is_zero_bits(64, read_gpr(R9, state.gprs).sub(word_zero())) = False) =
                    trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), r.right.left), ended_flag(True));
                row_straight(file, at, placed, page, goal, back, lr_field_jne(), refl, 4, state, head.rip_is, head.memory_is,
                    ⟨λ taken => absurd(trans(sym(taken), some)),
                     λ _ => ⟨λ _ e rip m same => row_field(file, page0, at, placed, width, mask, slots, counts, held, o, bytes, i, below, origin, goal, back,
                            skip, e, room_less(o + bytes.len(), width, room),
                            RowAt(page := page, memory_is := m, rip_is := trans(rip, row_lands(at, lr_lead(), 6, tr_field(), ra(lr_field()), rj_field_jne())),
                                holds := head.holds,
                                regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + bytes.len(), i, column_bit(i), True, origin, s.gprs), r))),
                        λ passed => absurd(trans(sym(passed), cong_fn<Bool, Bool>(λ x => !x, z2)))⟩⟩)
            },
            False => λ r skip => {
                let c = o + bytes.len();
                let z2: (is_zero_bits(64, read_gpr(R9, state.gprs).sub(word_zero())) = True) =
                    trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), r.right.left), ended_flag(False));
                let lead = bytes ++ [field_gap()];
                let grown: (lead.len() = Succ(bytes.len())) = List::len_append(bytes, [field_gap()]);
                let paged = page_next(file, page0, page, o, bytes, field_gap(), head.holds.held, head.holds.below, head.holds.above);
                let next = io_store_offset(IoMemory(file, page), c, [field_gap()]).page;
                let rdi: (read_gpr(Rdi, state.gprs).add(one_byte().sign_extend(56)).toNat() = io_page_base() + (o + lead.len())) =
                    trans(add_one_value(read_gpr(Rdi, state.gprs), io_page_base() + c, r.left, page_succ_room(c, room_inside(c, width, room))),
                        cong_fn<Nat, Nat>(λ l => io_page_base() + (o + l), sym(grown)));
                let fits: ((o + lead.len()) + (width + 20) <= 4096) =
                    j(sym(grown), λ l _ => (o + l) + (width + 20) <= 4096, gap_room(o, bytes.len(), width, room));
                let rest = j(sym(List::append_assoc(bytes, [field_gap()], pad)),
                    λ l _ => SkipThen(file, page0, at, width, mask, slots, o, l, i, False, origin, goal), skip);
                row_straight(file, at, placed, page, goal, back, lr_load(), refl, 9, state, head.rip_is, head.memory_is,
                    ⟨λ taken => absurd(trans(sym(taken), some)),
                     λ _ => ⟨λ taken2 => absurd(trans(sym(taken2), cong_fn<Bool, Bool>(λ x => !x, z2))),
                        λ _ => Exists(c, ⟨room_inside(c, width, room), ⟨r.left,
                            Exists(counts(i), Exists(argv_slot(slots, i), ⟨r.right.right.left, ⟨held(next, i, below),
                                λ e rip m same => row_format(file, page0, at, row_pieces(file, at, placed), width, mask, slots, o, lead, i, origin, counts(i),
                                    goal, back, rest, e, fits,
                                    RowAt(page := next, memory_is := m, rip_is := rip, holds := paged,
                                        regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + lead.len(), i, column_bit(i), False, origin, s.gprs),
                                            ⟨rdi, ⟨refl, r.right.right⟩⟩)),
                                    j(sym(same), λ s _ => read_gpr(Rdx, s.gprs).toNat() = width, r.right.right.right.right.left),
                                    j(sym(same), λ s _ => read_gpr(Rax, s.gprs) = counts(i), refl))⟩⟩))⟩⟩)⟩⟩)
            },
        })(head.regs, skip0),
    })(zf, then)
}

// From `skip` past the last slot: R12 and R15 on, and the row done.
theorem row_last(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, row_code(), at), width: Nat, mask, slots: BitVec(64),
    o: Nat, bytes: List<BitVec(8)>, i: Nat, seven: i = 7, first: Bool, origin: Gprs, state: MachineState<IoMemory>,
    head: RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state)):
    RowReach(file, page0, at, o, bytes, origin, state) {
    let r = head.regs;
    let last: (is_zero_bits(64, read_gpr(R15, state.gprs).add(read_gpr(R15, state.gprs)).sub(BitVec::ofNat(256))) = True) =
        trans(cong_fn<BitVec(64), Bool>(λ b => is_zero_bits(64, b.add(b).sub(BitVec::ofNat(256))), r.right.right.right.right.right.left),
            j(sym(seven), λ m _ => is_zero_bits(64, doubled(m).sub(BitVec::ofNat(256))) = True, bits_last()));
    row_straight(file, at, placed, head.page, λ s => RowReach(file, page0, at, o, bytes, origin, s), row_back(file, page0, at, o, bytes, origin),
        lr_back(), refl, 2, state, head.rip_is, head.memory_is,
        ⟨λ taken => absurd(trans(sym(taken), cong_fn<Bool, Bool>(λ x => !x, last))),
         λ _ e rip m same => Exists(e, ⟨Exists(Zero, refl), RowOut(page := head.page, memory_is := m, rip_is := rip, holds := head.holds,
            rdi := j(sym(same), λ s _ => read_gpr(Rdi, s.gprs).toNat() = io_page_base() + (o + bytes.len()), r.left),
            kept := j(sym(same), λ s _ => RowKept(s.gprs, origin), RowKept(rsp := r.right.right.right.right.right.right.left,
                rbp := r.right.right.right.right.right.right.right.left, r8 := r.right.right.right.right.right.right.right.right.left,
                r10 := r.right.right.right.right.right.right.right.right.right)))⟩)⟩)
}

// From `skip` with slots left: R12 and R15 on, and back to `head`.
theorem row_more(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, row_code(), at), width: Nat, mask, slots: BitVec(64),
    o: Nat, bytes: List<BitVec(8)>, i: Nat, more: i < 7, first: Bool, origin: Gprs, goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    state: MachineState<IoMemory>, head: RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state),
    next: (s: MachineState<IoMemory>) → RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, Succ(i), column_bit(Succ(i)), first, origin, s) →
        goal(s)): goal(state) {
    let r = head.regs;
    let bits = bits_more(i, more);
    let r15 = r.right.right.right.right.right.left;
    row_straight(file, at, placed, head.page, goal, back, lr_back(), refl, 2, state, head.rip_is, head.memory_is,
        ⟨λ _ e rip m same => next(e, RowAt(page := head.page, memory_is := m,
                rip_is := trans(rip, row_lands_back(at, lr_skip(), 6, tr_head(), ra(lr_head()), rj_back())), holds := head.holds,
                regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + bytes.len(), Succ(i), column_bit(Succ(i)), first, origin, s.gprs),
                    ⟨r.left, ⟨r.right.left, ⟨slot_next(slots, i, read_gpr(R12, state.gprs), r.right.right.left), ⟨r.right.right.right.left,
                    ⟨r.right.right.right.right.left, ⟨trans(cong_fn<BitVec(64), BitVec(64)>(λ b => b.add(b), r15), bits.left),
                    r.right.right.right.right.right.right⟩⟩⟩⟩⟩⟩))),
         λ passed => absurd(trans(sym(passed), cong_fn<Bool, Bool>(λ x => !x,
            trans(cong_fn<BitVec(64), Bool>(λ b => is_zero_bits(64, b.add(b).sub(BitVec::ofNat(256))), r15), bits.right))))⟩)
}

// ---------------------------------------------------------------------------
// The loop, by the slots left: `Succ(k)` of them from slot `i`.

theorem row_loop(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, row_code(), at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, origin: Gprs, k: Nat):
    (i: Nat) → (first: Bool) → (bytes: List<BitVec(8)>) → (state: MachineState<IoMemory>) → i + Succ(k) = column_slots() →
    (o + bytes.len()) + fields_room(width, k) <= 4096 →
    RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state) →
    RowReach(file, page0, at, o, bytes ++ row_fields(width, mask, counts, first, i, Succ(k)), origin, state) {
    match k as λ m => (i: Nat) → (first: Bool) → (bytes: List<BitVec(8)>) → (state: MachineState<IoMemory>) → i + Succ(m) = column_slots() →
            (o + bytes.len()) + fields_room(width, m) <= 4096 →
            RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state) →
            RowReach(file, page0, at, o, bytes ++ row_fields(width, mask, counts, first, i, Succ(m)), origin, state) {
        Zero => λ i first bytes state count room head => {
            let last = last_slot(i, count);
            let field = slot_field(width, mask, counts, first, i);
            let total = bytes ++ row_fields(width, mask, counts, first, i, 1);
            let fields: (bytes ++ field = total) = cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => bytes ++ l,
                sym(trans(row_unfold(width, mask, counts, first, i, 0), List::append_nil(field))));
            row_slot(file, page0, at, placed, width, mask, slots, counts, held, o, bytes, i, last.right, first, origin,
                λ s => RowReach(file, page0, at, o, total, origin, s), row_back(file, page0, at, o, total, origin), state, room, head,
                λ s at_skip => j(fields, λ l _ => RowReach(file, page0, at, o, l, origin, s),
                    row_last(file, page0, at, placed, width, mask, slots, o, bytes ++ field, i, last.left, first_after(mask, first, i), origin, s, at_skip)))
        },
        Succ(m) => λ i first bytes state count room head => {
            let counted = slot_more(i, m, count);
            let field = slot_field(width, mask, counts, first, i);
            let front = bytes ++ field;
            let after = first_after(mask, first, i);
            let tail = row_fields(width, mask, counts, after, Succ(i), Succ(m));
            let total = bytes ++ row_fields(width, mask, counts, first, i, Succ(Succ(m)));
            let whole: (front ++ tail = total) =
                trans(List::append_assoc(bytes, field, tail),
                    cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => bytes ++ l, sym(row_unfold(width, mask, counts, first, i, Succ(m)))));
            let goal = λ (s: MachineState<IoMemory>) => RowReach(file, page0, at, o, total, origin, s);
            let back = row_back(file, page0, at, o, total, origin);
            let fits = rest_room(o, bytes.len(), field.len(), front.len(), width, fields_room(width, m), List::len_append(bytes, field),
                slot_field_le(width, mask, counts, first, i), room);
            row_slot(file, page0, at, placed, width, mask, slots, counts, held, o, bytes, i, counted.right.left, first, origin, goal, back, state,
                slot_room(o + bytes.len(), width, fields_room(width, m), room), head,
                λ s1 at_skip => row_more(file, page0, at, placed, width, mask, slots, o, front, i, counted.left, after, origin, goal, back, s1, at_skip,
                    λ s2 at_head => j(whole, λ l _ => RowReach(file, page0, at, o, l, origin, s2),
                        row_loop(file, page0, at, placed, width, mask, slots, counts, held, o, origin, m, Succ(i), after, front, s2, counted.right.right,
                            fits, at_head))))
        },
    }
}

// ---------------------------------------------------------------------------
// The claim: placed anywhere in the file, entered with R12 at slot 0's word,
// R13 the selection, R14 the width and RDI at offset `o` of the page, the
// code stores `row_counts` from `o` and leaves the rest of the page alone.

theorem row_runs(file: IoImage, at: BitVec(64), placed: Placed(file, row_code(), at), page0: Nat → BitVec(8), width: Nat,
    mask, slots: BitVec(64), counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(file, page0), rip_is: state.rip = at,
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + o, r12: read_gpr(R12, state.gprs) = slots,
    r13: read_gpr(R13, state.gprs) = mask, r14: read_gpr(R14, state.gprs).toNat() = width, room: o + 8 * (width + 21) <= 4096):
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        RowOut(file, page0, at, o, row_counts(width, mask, counts), state.gprs, after)) {
    let origin = state.gprs;
    let total = row_counts(width, mask, counts);
    row_straight(file, at, placed, page0, λ s => RowReach(file, page0, at, o, total, origin, s), row_back(file, page0, at, o, total, origin),
        lr_setup(), refl, 1, state, rip_is, memory_is,
        λ e rip m same => row_loop(file, page0, at, placed, width, mask, slots, counts, held, o, origin, 7, 0, True, Nil, e, refl,
            row_room(o, width, room),
            RowAt(page := page0, memory_is := m, rip_is := rip, holds := page_same(page0, o),
                regs := j(sym(same), λ s _ => RowRegs(width, mask, slots, o + 0, 0, column_bit(0), True, origin, s.gprs),
                    ⟨rdi, ⟨refl, ⟨trans(r12, slot_zero(slots)), ⟨r13, ⟨r14, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩⟩⟩⟩⟩))))
}

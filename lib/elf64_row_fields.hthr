// A row's counts (docs/native-wc-command-design.md §6.1 `row`, §6.2 "columns
// are a table"): for each of the eight column slots in order, when the
// selection has the slot's bit, `%*d` of the slot's count at the cursor in
// the page, a space before every field but the first. The counts are words
// in the frame, one per slot, wherever the command keeps them; the same code
// writes a file's row and the total row. The code is library code with no
// program-specific bytes; it runs the formatter (elf64_format_width) once per
// selected slot, in a loop. The claim is `row_runs`, against
// `command_program`'s `row_counts`.
import command_program;
import decimal_line;
import elf64_arg_scan;
import elf64_format_width;
import elf64_io;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The counts: slot `i`'s word at `slots + 8i`, in the frame (or anywhere the
// page is not), so whatever the page holds.

fn CountsAt(file: IoImage, slots: BitVec(64), counts: Nat → BitVec(64)) → Type {
    (page: Nat → BitVec(8)) → (i: Nat) → i < column_slots() → WordAt(io_data_access(), IoMemory(file, page), argv_slot(slots, i), counts(i))
}

// One slot's field, and whether a field has been written after it.
fn slot_field(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i: Nat) → List<BitVec(8)> {
    match column_selected(mask, i) { True => field_lead(first) ++ pad_left(width, field_gap(), decimal(counts(i).toNat())), False => Nil }
}
fn first_after(mask: BitVec(64), first: Bool, i: Nat) → Bool { match column_selected(mask, i) { True => False, False => first } }

theorem row_unfold(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i, k: Nat):
    row_fields(width, mask, counts, first, i, Succ(k)) =
        slot_field(width, mask, counts, first, i) ++ row_fields(width, mask, counts, first_after(mask, first, i), Succ(i), k) {
    let lead = field_lead(first);
    let pad = pad_left(width, field_gap(), decimal(counts(i).toNat()));
    match column_selected(mask, i) as λ c =>
            (match c { False => row_fields(width, mask, counts, first, Succ(i), k),
                       True => lead ++ (pad ++ row_fields(width, mask, counts, False, Succ(i), k)) }) =
            (match c as λ _ => List<BitVec(8)> { True => lead ++ pad, False => Nil }) ++
                row_fields(width, mask, counts, match c { True => False, False => first }, Succ(i), k) {
        True => sym(List::append_assoc(lead, pad, row_fields(width, mask, counts, False, Succ(i), k))),
        False => refl,
    }
}

// ---------------------------------------------------------------------------
// The code. The caller sets R12 to slot 0's address, R13 to the selection,
// R14 to the width and RDI to the cursor.
//
//   setup:  R15 := 1 (slot 0's bit), R9 := 1 (no field yet)
//   head:   R13 & R15 zero: skip
//           R9 set: field.  Otherwise store ' ' at RDI; RDI += 1
//   field:  R9 := 0; RDX := R14; RAX := the word at R12; %*d (the formatter)
//   skip:   R12 += 8; R15 += R15; R15 below 256: head
//
// RDI ends past the fields. RSP, RBP, R8 and R10 are kept.

fn row_setup_block() → List<Instruction> { [MovRI(R15, BitVec::ofNat(1)), MovRI(R9, BitVec::ofNat(1))] }
fn row_test_block() → List<Instruction> { [MovRR(R11, R13), AndRR(R11, R15), MovRI(Rax, word_zero()), CmpRR(R11, Rax)] }
fn row_lead_block() → List<Instruction> { [MovRI(Rax, word_zero()), CmpRR(R9, Rax)] }
fn row_gap_block() → List<Instruction> { [MovRI(R11, BitVec::ofNat(32))] }
fn row_gap_store() → ByteStore { ByteStore(base := Rdi, source := R11) }
fn row_step_block() → List<Instruction> { [AddRI8(Rdi, one_byte())] }
fn row_field_block() → List<Instruction> { [MovRI(R9, word_zero()), MovRR(Rdx, R14)] }
fn row_count_load() → WordLoad { WordLoad(destination := Rax, base := R12) }
fn row_next_block() → List<Instruction> { [AddRI8(R12, eight_byte()), AddRR(R15, R15), MovRI(R11, BitVec::ofNat(256)), CmpRR(R15, R11)] }

// The row as a program (x86_64_asm). The jumps' targets, named.
fn tr_head() → Nat { 1 }
fn tr_field() → Nat { 2 }
fn tr_skip() → Nat { 3 }
fn lr_setup() → Prog { then(Start, Block(row_setup_block())) }
// head: a slot not selected is skipped; a field after the first is led by ' '
fn lr_head() → Prog { At(lr_setup(), tr_head(), Block(row_test_block())) }
fn lr_skip_je() → Prog { then(lr_head(), Jcc(E, tr_skip())) }
fn lr_lead() → Prog { then(lr_skip_je(), Block(row_lead_block())) }
fn lr_field_jne() → Prog { then(lr_lead(), Jcc(NE, tr_field())) }
fn lr_gap() → Prog { then(lr_field_jne(), Block(row_gap_block())) }
fn lr_gap_store() → Prog { then(lr_gap(), Code(byte_store_bytes(row_gap_store()))) }
fn lr_step() → Prog { then(lr_gap_store(), Block(row_step_block())) }
// field: the count, by the formatter
fn lr_field() → Prog { At(lr_step(), tr_field(), Block(row_field_block())) }
fn lr_load() → Prog { then(lr_field(), Code(word_load_bytes(row_count_load()))) }
fn lr_format() → Prog { then(lr_load(), Piece(format_code(), format_len(), format_code_len())) }
// skip: the next slot, until the last
fn lr_skip() → Prog { At(lr_format(), tr_skip(), Block(row_next_block())) }
fn lr_back() → Prog { then(lr_skip(), Jcc(NE, tr_head())) }
fn lr_end() → Prog { then(lr_back(), Block(Nil)) }
fn row_prog() → Prog { lr_end() }
fn row_labels() → Nat → Nat { asm_labels(row_prog()) }
fn row_code() → List<BitVec(8)> { assemble(no_fills(), row_prog(), Nil) }
// The program's size, closed: a client's offsets add it without evaluating
// the program.
fn row_len() → Nat { 1712 }
theorem row_len_closed(): prog_len(row_prog()) = row_len() { refl }
// Label `l`'s offset in the row, and the displacement of the jump there.
fn ra(l: Prog) → Nat { asm_at(l) }
fn rd(l: Prog) → BitVec(32) { asm_jump(row_labels(), l) }
theorem row_code_len(): row_code().len() = row_len() { trans(asm_len_is(no_fills(), row_labels(), row_prog(), trivial, Nil, 0, refl), row_len_closed()) }

theorem rj_skip_je(): JumpsForward(ra(lr_skip_je()), 6, rd(lr_skip_je()), ra(lr_skip())) { asm_jump_lands(row_labels(), lr_skip_je(), 6, ra(lr_skip()), refl) }
theorem rj_field_jne(): JumpsForward(ra(lr_field_jne()), 6, rd(lr_field_jne()), ra(lr_field())) { asm_jump_lands(row_labels(), lr_field_jne(), 6, ra(lr_field()), refl) }
theorem rj_back(): JumpsBack(ra(lr_back()), 6, rd(lr_back()), ra(lr_head())) { asm_jump_lands_back(row_labels(), lr_back(), 6, ra(lr_head()), refl) }

fn RowPieces(file: IoImage, at: BitVec(64)) → Type { AsmPlaced(file, no_fills(), row_prog(), at) }
theorem row_pieces(file: IoImage, at: BitVec(64), placed: Placed(file, row_code(), at)): RowPieces(file, at) {
    asm_placed(file, no_fills(), row_prog(), trivial, at, placed)
}

// ---------------------------------------------------------------------------
// Bits, lengths and the page.

// R15 doubled: the next slot's bit, and 256 only past the last slot.
fn doubled(i: Nat) → BitVec(64) { column_bit(i).add(column_bit(i)) }
fn BitsMore(i: Nat) → Type { (doubled(i) = column_bit(Succ(i))) ∧ (is_zero_bits(64, doubled(i).sub(BitVec::ofNat(256))) = False) }
theorem bits_more(i: Nat): i < 7 → BitsMore(i) {
    match i as λ v => v < 7 → BitsMore(v) {
        Zero => λ _ => ⟨refl, refl⟩,
        Succ(m1) => match m1 as λ v => Succ(v) < 7 → BitsMore(Succ(v)) {
            Zero => λ _ => ⟨refl, refl⟩,
            Succ(m2) => match m2 as λ v => Succ(Succ(v)) < 7 → BitsMore(Succ(Succ(v))) {
                Zero => λ _ => ⟨refl, refl⟩,
                Succ(m3) => match m3 as λ v => Succ(Succ(Succ(v))) < 7 → BitsMore(Succ(Succ(Succ(v)))) {
                    Zero => λ _ => ⟨refl, refl⟩,
                    Succ(m4) => match m4 as λ v => Succ(Succ(Succ(Succ(v)))) < 7 → BitsMore(Succ(Succ(Succ(Succ(v))))) {
                        Zero => λ _ => ⟨refl, refl⟩,
                        Succ(m5) => match m5 as λ v => Succ(Succ(Succ(Succ(Succ(v))))) < 7 → BitsMore(Succ(Succ(Succ(Succ(Succ(v)))))) {
                            Zero => λ _ => ⟨refl, refl⟩,
                            Succ(m6) => match m6 as λ v => Succ(Succ(Succ(Succ(Succ(Succ(v)))))) < 7 →
                                    BitsMore(Succ(Succ(Succ(Succ(Succ(Succ(v))))))) {
                                Zero => λ _ => ⟨refl, refl⟩,
                                Succ(_) => λ below => false_elim(Nat::lt_irrefl(0, { omega })),
                            },
                        },
                    },
                },
            },
        },
    }
}
theorem bits_last(): is_zero_bits(64, doubled(7).sub(BitVec::ofNat(256))) = True { refl }

// A count has at most twenty digits, so a field is at most the width and
// twenty-one bytes.
theorem places_le(n: Nat, j: Nat): places_reached(j, n) <= j {
    match j as λ m => places_reached(m, n) <= m {
        Zero => Nat::le_refl(0),
        Succ(i) => {
            let one = reaches_le(ten_pow(Succ(i)), n);
            let rest = places_le(n, i);
            let sum: (places_reached(Succ(i), n) = reaches(ten_pow(Succ(i)), n) + places_reached(i, n)) = refl;
            let bound: (places_reached(Succ(i), n) <= Succ(i)) = omega;
            bound
        },
    }
}
theorem padded_le(w: Nat, x: BitVec(64)): padded_decimal(w, x.toNat()).len() <= w + 20 {
    let n = x.toNat();
    let digits: (decimal(n).len() = Succ(places_reached(19, n))) = decimal_len(n, BitVec::toNat_lt_pow(64, x));
    let few = places_le(n, 19);
    let len = padded_len(w, n);
    let cut = Nat::sub_le(w, decimal(n).len());
    let bound: (padded_decimal(w, n).len() <= w + 20) = omega;
    bound
}
theorem slot_field_le(width: Nat, mask: BitVec(64), counts: Nat → BitVec(64), first: Bool, i: Nat):
    slot_field(width, mask, counts, first, i).len() <= width + 21 {
    let pad = padded_decimal(width, counts(i).toNat());
    let short = padded_le(width, counts(i));
    let lead: (field_lead(first).len() <= 1) = match first as λ f => field_lead(f).len() <= 1 { True => { omega }, False => { omega } };
    let both: ((field_lead(first) ++ pad).len() = field_lead(first).len() + pad.len()) = List::len_append(field_lead(first), pad);
    match column_selected(mask, i) as λ c => (match c as λ _ => List<BitVec(8)> { True => field_lead(first) ++ pad, False => Nil }).len() <= width + 21 {
        True => { let bound: ((field_lead(first) ++ pad).len() <= width + 21) = omega; bound },
        False => { let none: (0 <= width + 21) = omega; none },
    }
}
// Room for `k + 1` more fields.
fn fields_room(width, k: Nat) → Nat { match k { Zero => width + 21, Succ(j) => (width + 21) + fields_room(width, j) } }

// Two stores in turn: the page holds both, and nothing else changed.
theorem page_join(page0, page1, page2: Nat → BitVec(8), o: Nat, a, b: List<BitVec(8)>, first: PageNext(page0, page1, o, a),
    second: PageNext(page1, page2, o + a.len(), b)): PageNext(page0, page2, o, a ++ b) {
    let kept: Stored(page2, o, a) = λ i byte present => {
        let inside: (i < a.len()) = nth_some_below(a, i, byte, present);
        trans(second.below(i + o, { omega }), first.held(i, byte, present))
    };
    let grown: ((a ++ b).len() = a.len() + b.len()) = List::len_append(a, b);
    PageNext(held := stored_join(page2, o, a, b, kept, second.held),
        below := λ q short => trans(second.below(q, { omega }), first.below(q, short)),
        above := λ q past => trans(second.above(q, { omega }), first.above(q, { omega })))
}
theorem page_same(page0: Nat → BitVec(8), o: Nat): PageNext(page0, page0, o, Nil) {
    PageNext(held := stored_nothing(page0, o), below := λ q _ => refl, above := λ q _ => refl)
}

// ---------------------------------------------------------------------------
// The loop's state.

record RowKept(after, before: Gprs) {
    rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before),
    rbp: read_gpr(Rbp, after) = read_gpr(Rbp, before),
    r8: read_gpr(R8, after) = read_gpr(R8, before),
    r10: read_gpr(R10, after) = read_gpr(R10, before),
}
theorem row_kept_fmt(after, middle, before: Gprs, late: FmtKept(after, middle), early: RowKept(middle, before)): RowKept(after, before) {
    RowKept(rsp := trans(late.left, early.rsp), rbp := trans(late.right.left, early.rbp), r8 := trans(late.right.right.left, early.r8),
        r10 := trans(late.right.right.right.right.left, early.r10))
}

// At `rip`, `bytes` stored from `o`, R12 at slot `k`, R15 as `bit`, and
// `first` saying no field has been written.
record RowAt(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), rip, width: Nat, mask, slots: BitVec(64), o: Nat,
    bytes: List<BitVec(8)>, k: Nat, bit: BitVec(64), first: Bool, origin: Gprs, state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, rip),
    holds: PageNext(page0, page, o, bytes),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (o + bytes.len()),
    r9: read_gpr(R9, state.gprs) = ended_word(first),
    r12: read_gpr(R12, state.gprs) = argv_slot(slots, k),
    r13: read_gpr(R13, state.gprs) = mask,
    r14: read_gpr(R14, state.gprs).toNat() = width,
    r15: read_gpr(R15, state.gprs) = bit,
    kept: RowKept(state.gprs, origin),
}
// Past the code: the fields stored, the cursor past them.
record RowOut(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), o: Nat, bytes: List<BitVec(8)>, origin: Gprs,
    state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, row_len()),
    holds: PageNext(page0, page, o, bytes),
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + (o + bytes.len()),
    kept: RowKept(state.gprs, origin),
}
fn RowRan(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), rip, width: Nat, mask, slots: BitVec(64), o: Nat,
    bytes: List<BitVec(8)>, k: Nat, bit: BitVec(64), first: Bool, origin: Gprs, state: MachineState<IoMemory>) → Type {
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        RowAt(file, page0, at, rip, width, mask, slots, o, bytes, k, bit, first, origin, after))
}

// ---------------------------------------------------------------------------
// One slot.

// Skip: R12 to the next slot, R15 doubled, compared with 256.
theorem row_next(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    o: Nat, bytes: List<BitVec(8)>, i: Nat, first: Bool, origin: Gprs, state: MachineState<IoMemory>,
    head: RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state)):
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        (RowAt(file, page0, at, ra(lr_back()), width, mask, slots, o, bytes, Succ(i), doubled(i), first, origin, after) ∧
        (after.flags.zf = is_zero_bits(64, doubled(i).sub(BitVec::ofNat(256)))))) {
    let set = run_block(file, head.page, row_next_block(), at, ra(lr_skip()), piece(lr_skip()), state, head.memory_is, head.rip_is);
    let s1 = execute_block_normal(row_next_block(), state);
    let r15: (read_gpr(R15, s1.gprs) = doubled(i)) = cong_fn<BitVec(64), BitVec(64)>(λ b => b.add(b), head.r15);
    Exists(s1, ⟨linux_steps_of_fetched(io_linux(), state, s1, set.steps),
        ⟨RowAt(page := head.page, memory_is := set.memory_is, rip_is := set.rip_is, holds := head.holds, rdi := head.rdi, r9 := head.r9,
            r12 := slot_next(slots, i, read_gpr(R12, state.gprs), head.r12), r13 := head.r13, r14 := head.r14, r15 := r15,
            kept := RowKept(rsp := head.kept.rsp, rbp := head.kept.rbp, r8 := head.kept.r8, r10 := head.kept.r10)),
         cong_fn<BitVec(64), Bool>(λ b => is_zero_bits(64, b.sub(BitVec::ofNat(256))), r15)⟩⟩)
}

// A selected slot's field, from `field`: the count of the slot, padded to
// the width, at the cursor.
theorem row_field(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, bytes: List<BitVec(8)>, i: Nat, below: i < column_slots(),
    first: Bool, origin: Gprs, state: MachineState<IoMemory>, room: (o + bytes.len()) + (width + 20) <= 4096,
    head: RowAt(file, page0, at, ra(lr_field()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state)):
    RowRan(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes ++ padded_decimal(width, counts(i).toNat()), i, column_bit(i), False, origin, state) {
    let io = io_linux();
    let page = head.page;
    let set = run_block(file, page, row_field_block(), at, ra(lr_field()), piece(lr_field()), state, head.memory_is, head.rip_is);
    let s1 = execute_block_normal(row_field_block(), state);
    let word: WordAt(io_data_access(), IoMemory(file, page), read_gpr(R12, s1.gprs), counts(i)) =
        j(sym(head.r12), λ a _ => WordAt(io_data_access(), IoMemory(file, page), a, counts(i)), held(page, i, below));
    let loaded = run_word_load(file, page, row_count_load(), at, ra(lr_load()), piece(lr_load()), s1, set.memory_is, set.rip_is, counts(i), word);
    let s2 = word_load_after(row_count_load(), counts(i), s1);
    let c = o + bytes.len();
    let pad = padded_decimal(width, counts(i).toNat());
    let short = padded_le(width, counts(i));
    let fits: (c + pad.len() <= 4096) = omega;
    have formatted = format_runs(file, next_rip(at, ra(lr_format())), piece(lr_format()), page, width, c, s2, loaded.memory_is, loaded.rip_is, head.r14, head.rdi,
        fits);
    let s3 = formatted.witness;
    let out = formatted.proof.right;
    let joined = page_join(page0, page, out.page, o, bytes, pad, head.holds, PageNext(held := out.held, below := out.below, above := out.above));
    let grown: ((bytes ++ pad).len() = bytes.len() + pad.len()) = List::len_append(bytes, pad);
    let sum: (c + pad.len() = o + (bytes ++ pad).len()) = omega;
    let rdi: (read_gpr(Rdi, s3.gprs).toNat() = io_page_base() + (o + (bytes ++ pad).len())) =
        trans(out.rdi, cong_fn<Nat, Nat>(λ l => io_page_base() + l, sum));
    let rip: (s3.rip = next_rip(at, ra(lr_skip()))) = trans(out.rip_is, rip_compose(at, ra(lr_format()), format_len()));
    let fk = out.kept;
    Exists(s3, ⟨linux_steps_trans(io, state, s2, s3,
            linux_steps_of_fetched(io, state, s2, fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2, set.steps, loaded.steps)),
            formatted.proof.left),
        RowAt(page := out.page, memory_is := out.memory_is, rip_is := rip, holds := joined, rdi := rdi,
            r9 := fk.right.right.right.left, r12 := trans(fk.right.right.right.right.right.left, head.r12),
            r13 := trans(fk.right.right.right.right.right.right.left, head.r13),
            r14 := trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), fk.right.right.right.right.right.right.right.left), head.r14),
            r15 := trans(fk.right.right.right.right.right.right.right.right, head.r15),
            kept := row_kept_fmt(s3.gprs, s2.gprs, origin, fk, head.kept))⟩)
}

// The space before a field that is not the first, from `head` (64) to `field`.
theorem row_gap(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    o: Nat, bytes: List<BitVec(8)>, i: Nat, origin: Gprs, state: MachineState<IoMemory>, room: (o + bytes.len()) < 4096,
    head: RowAt(file, page0, at, ra(lr_gap()), width, mask, slots, o, bytes, i, column_bit(i), False, origin, state)):
    RowRan(file, page0, at, ra(lr_field()), width, mask, slots, o, bytes ++ [field_gap()], i, column_bit(i), False, origin, state) {
    let io = io_linux();
    let page = head.page;
    let c = o + bytes.len();
    let set = run_block(file, page, row_gap_block(), at, ra(lr_gap()), piece(lr_gap()), state, head.memory_is, head.rip_is);
    let s1 = execute_block_normal(row_gap_block(), state);
    let stored = run_store(file, page, row_gap_store(), refl, at, ra(lr_gap_store()), piece(lr_gap_store()), c, room, field_gap(), s1, set.memory_is, set.rip_is, head.rdi, refl);
    let s2 = byte_store_after(linux_writes(io), row_gap_store(), s1);
    let next = io_store_offset(IoMemory(file, page), c, [field_gap()]).page;
    let stepped = run_block(file, next, row_step_block(), at, ra(lr_step()), piece(lr_step()), s2, stored.memory_is, stored.rip_is);
    let s3 = execute_block_normal(row_step_block(), s2);
    let paged = page_next(file, page0, page, o, bytes, field_gap(), head.holds.held, head.holds.below, head.holds.above);
    let grown: ((bytes ++ [field_gap()]).len() = Succ(bytes.len())) = List::len_append(bytes, [field_gap()]);
    let page_low: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    let rdi: (read_gpr(Rdi, s3.gprs).toNat() = io_page_base() + (o + (bytes ++ [field_gap()]).len())) =
        trans(add_one_value(read_gpr(Rdi, s2.gprs), io_page_base() + c, head.rdi, { omega }),
            cong_fn<Nat, Nat>(λ l => io_page_base() + (o + l), sym(grown)));
    Exists(s3, ⟨linux_steps_trans(io, state, s2, s3,
            linux_steps_trans(io, state, s1, s2, linux_steps_of_fetched(io, state, s1, set.steps), stored.step),
            linux_steps_of_fetched(io, s2, s3, stepped.steps)),
        RowAt(page := next, memory_is := stepped.memory_is, rip_is := stepped.rip_is,
            holds := PageNext(held := paged.held, below := paged.below, above := paged.above), rdi := rdi, r9 := head.r9,
            r12 := head.r12, r13 := head.r13, r14 := head.r14, r15 := head.r15,
            kept := RowKept(rsp := head.kept.rsp, rbp := head.kept.rbp, r8 := head.kept.r8, r10 := head.kept.r10))⟩)
}

theorem gap_room(o, b, w: Nat, room: (o + b) + (w + 21) <= 4096): (o + Succ(b)) + (w + 20) <= 4096 { omega }

// A selected slot, from the lead test (45) to `skip`.
theorem row_selected(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, bytes: List<BitVec(8)>, i: Nat, below: i < column_slots(),
    first: Bool, origin: Gprs, state: MachineState<IoMemory>, room: (o + bytes.len()) + (width + 21) <= 4096,
    head: RowAt(file, page0, at, ra(lr_lead()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state)):
    RowRan(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes ++ (field_lead(first) ++ padded_decimal(width, counts(i).toNat())), i,
        column_bit(i), False, origin, state) {
    let io = io_linux();
    let page = head.page;
    let pad = padded_decimal(width, counts(i).toNat());
    let tested = run_block(file, page, row_lead_block(), at, ra(lr_lead()), piece(lr_lead()), state, head.memory_is, head.rip_is);
    let s1 = execute_block_normal(row_lead_block(), state);
    let jne = JumpIfNear(NE, rd(lr_field_jne()));
    let jumped = run_near(file, page, jne, at, ra(lr_field_jne()), piece(lr_field_jne()), s1, tested.memory_is, tested.rip_is);
    let s2 = execute_near_control(jne, s1);
    let to_s2: LinuxSteps(io, state, s2) =
        linux_steps_of_fetched(io, state, s2, fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2, tested.steps, jumped));
    let zf: (s1.flags.zf = ended_zf(first)) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), head.r9), ended_flag(first));
    let same: RowKept(state.gprs, origin) = RowKept(rsp := head.kept.rsp, rbp := head.kept.rbp, r8 := head.kept.r8, r10 := head.kept.r10);
    (match first as λ f => (s1.flags.zf = ended_zf(f)) → (read_gpr(R9, state.gprs) = ended_word(f)) →
            RowRan(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes ++ (field_lead(f) ++ pad), i, column_bit(i), False, origin, state) {
        True => λ none r9 => {
            let s2_rip = jcc_taken(NE, rd(lr_field_jne()), s1, at, ra(lr_field_jne()), ra(lr_field()), tested.rip_is, ne_holds(s1.flags, none), rj_field_jne());
            let at_field: RowAt(file, page0, at, ra(lr_field()), width, mask, slots, o, bytes, i, column_bit(i), True, origin, s2) =
                RowAt(page := page, memory_is := tested.memory_is, rip_is := s2_rip, holds := head.holds, rdi := head.rdi, r9 := r9,
                    r12 := head.r12, r13 := head.r13, r14 := head.r14, r15 := head.r15, kept := same);
            have fielded = row_field(file, page0, at, piece, width, mask, slots, counts, held, o, bytes, i, below, True, origin, s2, { omega },
                at_field);
            Exists(fielded.witness, ⟨linux_steps_trans(io, state, s2, fielded.witness, to_s2, fielded.proof.left), fielded.proof.right⟩)
        },
        False => λ some r9 => {
            let s2_rip = jcc_passed(NE, rd(lr_field_jne()), s1, at, ra(lr_field_jne()), tested.rip_is, ne_fails(s1.flags, some));
            let at_gap: RowAt(file, page0, at, ra(lr_gap()), width, mask, slots, o, bytes, i, column_bit(i), False, origin, s2) =
                RowAt(page := page, memory_is := tested.memory_is, rip_is := s2_rip, holds := head.holds, rdi := head.rdi, r9 := r9,
                    r12 := head.r12, r13 := head.r13, r14 := head.r14, r15 := head.r15, kept := same);
            have gapped = row_gap(file, page0, at, piece, width, mask, slots, o, bytes, i, origin, s2, { omega }, at_gap);
            let lead = bytes ++ [field_gap()];
            let grown: (lead.len() = Succ(bytes.len())) = List::len_append(bytes, [field_gap()]);
            let fits: ((o + lead.len()) + (width + 20) <= 4096) =
                j(sym(grown), λ l _ => (o + l) + (width + 20) <= 4096, gap_room(o, bytes.len(), width, room));
            have fielded = row_field(file, page0, at, piece, width, mask, slots, counts, held, o, lead, i, below, False, origin, gapped.witness,
                fits, gapped.proof.right);
            let assoc: (lead ++ pad = bytes ++ (field_lead(False) ++ pad)) = List::append_assoc(bytes, field_lead(False), pad);
            Exists(fielded.witness, ⟨linux_steps_trans(io, state, s2, fielded.witness, to_s2,
                    linux_steps_trans(io, s2, gapped.witness, fielded.witness, gapped.proof.left, fielded.proof.left)),
                j(assoc, λ l _ => RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, l, i, column_bit(i), False, origin, fielded.witness),
                    fielded.proof.right)⟩)
        },
    })(zf, head.r9)
}

// One slot, from `head` to the back jump (`lr_back`): its field when selected.
theorem row_slot(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, bytes: List<BitVec(8)>, i: Nat, below: i < column_slots(),
    first: Bool, origin: Gprs, state: MachineState<IoMemory>, room: (o + bytes.len()) + (width + 21) <= 4096,
    head: RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state)):
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        (RowAt(file, page0, at, ra(lr_back()), width, mask, slots, o, bytes ++ slot_field(width, mask, counts, first, i), Succ(i), doubled(i),
            first_after(mask, first, i), origin, after) ∧
        (after.flags.zf = is_zero_bits(64, doubled(i).sub(BitVec::ofNat(256)))))) {
    let io = io_linux();
    let page = head.page;
    let tested = run_block(file, page, row_test_block(), at, ra(lr_head()), piece(lr_head()), state, head.memory_is, head.rip_is);
    let s1 = execute_block_normal(row_test_block(), state);
    let je = JumpIfNear(E, rd(lr_skip_je()));
    let jumped = run_near(file, page, je, at, ra(lr_skip_je()), piece(lr_skip_je()), s1, tested.memory_is, tested.rip_is);
    let s2 = execute_near_control(je, s1);
    let to_s2: LinuxSteps(io, state, s2) =
        linux_steps_of_fetched(io, state, s2, fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2, tested.steps, jumped));
    let anded: (read_gpr(R13, state.gprs).band(read_gpr(R15, state.gprs)) = mask.band(column_bit(i))) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ m => m.band(read_gpr(R15, state.gprs)), head.r13),
            cong_fn<BitVec(64), BitVec(64)>(λ b => mask.band(b), head.r15));
    let zf: (s1.flags.zf = mask.band(column_bit(i)).eq_bit(word_zero())) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), anded), zero_bits_sub(64, mask.band(column_bit(i)), word_zero()));
    let same: RowKept(state.gprs, origin) = RowKept(rsp := head.kept.rsp, rbp := head.kept.rbp, r8 := head.kept.r8, r10 := head.kept.r10);
    let pad = padded_decimal(width, counts(i).toNat());
    (match mask.band(column_bit(i)).eq_bit(word_zero()) as λ c => (s1.flags.zf = c) →
            Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io, state, after) ∧
                (RowAt(file, page0, at, ra(lr_back()), width, mask, slots, o,
                    bytes ++ (match !c as λ _ => List<BitVec(8)> { True => field_lead(first) ++ pad, False => Nil }), Succ(i), doubled(i),
                    match !c { True => False, False => first }, origin, after) ∧
                (after.flags.zf = is_zero_bits(64, doubled(i).sub(BitVec::ofNat(256)))))) {
        True => λ none => {
            let s2_rip = jcc_taken(E, rd(lr_skip_je()), s1, at, ra(lr_skip_je()), ra(lr_skip()), tested.rip_is, e_holds(s1.flags, none), rj_skip_je());
            let at_skip: RowAt(file, page0, at, ra(lr_skip()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, s2) =
                RowAt(page := page, memory_is := tested.memory_is, rip_is := s2_rip, holds := head.holds, rdi := head.rdi, r9 := head.r9,
                    r12 := head.r12, r13 := head.r13, r14 := head.r14, r15 := head.r15, kept := same);
            have next = row_next(file, page0, at, piece, width, mask, slots, o, bytes, i, first, origin, s2, at_skip);
            let nothing: (bytes ++ Nil = bytes) = List::append_nil(bytes);
            Exists(next.witness, ⟨linux_steps_trans(io, state, s2, next.witness, to_s2, next.proof.left),
                ⟨j(sym(nothing), λ l _ => RowAt(file, page0, at, ra(lr_back()), width, mask, slots, o, l, Succ(i), doubled(i), first, origin, next.witness),
                    next.proof.right.left), next.proof.right.right⟩⟩)
        },
        False => λ some => {
            let s2_rip = jcc_passed(E, rd(lr_skip_je()), s1, at, ra(lr_skip_je()), tested.rip_is, e_fails(s1.flags, some));
            let at_lead: RowAt(file, page0, at, ra(lr_lead()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, s2) =
                RowAt(page := page, memory_is := tested.memory_is, rip_is := s2_rip, holds := head.holds, rdi := head.rdi, r9 := head.r9,
                    r12 := head.r12, r13 := head.r13, r14 := head.r14, r15 := head.r15, kept := same);
            have fielded = row_selected(file, page0, at, piece, width, mask, slots, counts, held, o, bytes, i, below, first, origin, s2, room,
                at_lead);
            have next = row_next(file, page0, at, piece, width, mask, slots, o, bytes ++ (field_lead(first) ++ pad), i, False, origin,
                fielded.witness, fielded.proof.right);
            Exists(next.witness, ⟨linux_steps_trans(io, state, s2, next.witness, to_s2,
                    linux_steps_trans(io, s2, fielded.witness, next.witness, fielded.proof.left, next.proof.left)),
                next.proof.right⟩)
        },
    })(zf)
}

// ---------------------------------------------------------------------------
// The loop, by the slots left: `Succ(k)` of them from slot `i`.

theorem row_loop(file: IoImage, page0: Nat → BitVec(8), at: BitVec(64), piece: RowPieces(file, at), width: Nat, mask, slots: BitVec(64),
    counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, origin: Gprs, k: Nat):
    (i: Nat) → (first: Bool) → (bytes: List<BitVec(8)>) → (state: MachineState<IoMemory>) → i + Succ(k) = column_slots() →
    (o + bytes.len()) + fields_room(width, k) <= 4096 →
    RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state) →
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        RowOut(file, page0, at, o, bytes ++ row_fields(width, mask, counts, first, i, Succ(k)), origin, after)) {
    let io = io_linux();
    match k as λ m => (i: Nat) → (first: Bool) → (bytes: List<BitVec(8)>) → (state: MachineState<IoMemory>) → i + Succ(m) = column_slots() →
            (o + bytes.len()) + fields_room(width, m) <= 4096 →
            RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, bytes, i, column_bit(i), first, origin, state) →
            Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io, state, after) ∧
                RowOut(file, page0, at, o, bytes ++ row_fields(width, mask, counts, first, i, Succ(m)), origin, after)) {
        Zero => λ i first bytes state count room head => {
            let seven: (i = 7) = omega;
            let field = slot_field(width, mask, counts, first, i);
            have slot = row_slot(file, page0, at, piece, width, mask, slots, counts, held, o, bytes, i, { omega }, first, origin, state, room, head);
            let s1 = slot.witness;
            let at1 = slot.proof.right.left;
            let jne = JumpIfNear(NE, rd(lr_back()));
            let jumped = run_near(file, at1.page, jne, at, ra(lr_back()), piece(lr_back()), s1, at1.memory_is, at1.rip_is);
            let s2 = execute_near_control(jne, s1);
            let last: (s1.flags.zf = True) = trans(slot.proof.right.right,
                j(sym(seven), λ m _ => is_zero_bits(64, doubled(m).sub(BitVec::ofNat(256))) = True, bits_last()));
            let s2_rip = jcc_passed(NE, rd(lr_back()), s1, at, ra(lr_back()), at1.rip_is, ne_fails(s1.flags, last));
            let fields: (row_fields(width, mask, counts, first, i, 1) = field) =
                trans(row_unfold(width, mask, counts, first, i, 0), List::append_nil(field));
            let out: RowOut(file, page0, at, o, bytes ++ field, origin, s2) =
                RowOut(page := at1.page, memory_is := at1.memory_is, rip_is := s2_rip, holds := at1.holds, rdi := at1.rdi,
                    kept := RowKept(rsp := at1.kept.rsp, rbp := at1.kept.rbp, r8 := at1.kept.r8, r10 := at1.kept.r10));
            Exists(s2, ⟨linux_steps_trans(io, state, s1, s2, slot.proof.left, linux_steps_of_fetched(io, s1, s2, jumped)),
                j(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => bytes ++ l, sym(fields)),
                    λ l _ => RowOut(file, page0, at, o, l, origin, s2), out)⟩)
        },
        Succ(m) => λ i first bytes state count room head => {
            let more: (i < 7) = omega;
            let field = slot_field(width, mask, counts, first, i);
            let short = slot_field_le(width, mask, counts, first, i);
            let unfold: (fields_room(width, Succ(m)) = (width + 21) + fields_room(width, m)) = refl;
            have slot = row_slot(file, page0, at, piece, width, mask, slots, counts, held, o, bytes, i, { omega }, first, origin, state, { omega },
                head);
            let s1 = slot.witness;
            let at1 = slot.proof.right.left;
            let jne = JumpIfNear(NE, rd(lr_back()));
            let jumped = run_near(file, at1.page, jne, at, ra(lr_back()), piece(lr_back()), s1, at1.memory_is, at1.rip_is);
            let s2 = execute_near_control(jne, s1);
            let bits = bits_more(i, more);
            let going: (s1.flags.zf = False) = trans(slot.proof.right.right, bits.right);
            let s2_rip = jcc_taken_back(NE, rd(lr_back()), s1, at, ra(lr_back()), ra(lr_head()), at1.rip_is, ne_holds(s1.flags, going), rj_back());
            let front = bytes ++ field;
            let grown: (front.len() = bytes.len() + field.len()) = List::len_append(bytes, field);
            let at2: RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, front, Succ(i), column_bit(Succ(i)), first_after(mask, first, i), origin, s2) =
                RowAt(page := at1.page, memory_is := at1.memory_is, rip_is := s2_rip, holds := at1.holds, rdi := at1.rdi, r9 := at1.r9,
                    r12 := at1.r12, r13 := at1.r13, r14 := at1.r14, r15 := trans(at1.r15, bits.left),
                    kept := RowKept(rsp := at1.kept.rsp, rbp := at1.kept.rbp, r8 := at1.kept.r8, r10 := at1.kept.r10));
            have rest = row_loop(file, page0, at, piece, width, mask, slots, counts, held, o, origin, m, Succ(i), first_after(mask, first, i), front,
                s2, { omega }, { omega }, at2);
            let tail = row_fields(width, mask, counts, first_after(mask, first, i), Succ(i), Succ(m));
            let whole: (front ++ tail = bytes ++ row_fields(width, mask, counts, first, i, Succ(Succ(m)))) =
                trans(List::append_assoc(bytes, field, tail),
                    cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ l => bytes ++ l, sym(row_unfold(width, mask, counts, first, i, Succ(m)))));
            Exists(rest.witness, ⟨linux_steps_trans(io, state, s2, rest.witness,
                    linux_steps_trans(io, state, s1, s2, slot.proof.left, linux_steps_of_fetched(io, s1, s2, jumped)), rest.proof.left),
                j(whole, λ l _ => RowOut(file, page0, at, o, l, origin, rest.witness), rest.proof.right)⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// The claim: placed anywhere in the file, entered with R12 at slot 0's word,
// R13 the selection, R14 the width and RDI at offset `o` of the page, the
// code stores `row_counts` from `o` and leaves the rest of the page alone.

theorem row_runs(file: IoImage, at: BitVec(64), placed: Placed(file, row_code(), at), page0: Nat → BitVec(8), width: Nat,
    mask, slots: BitVec(64), counts: Nat → BitVec(64), held: CountsAt(file, slots, counts), o: Nat, state: MachineState<IoMemory>,
    memory_is: state.memory = IoMemory(file, page0), rip_is: state.rip = at,
    rdi: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + o, r12: read_gpr(R12, state.gprs) = slots,
    r13: read_gpr(R13, state.gprs) = mask, r14: read_gpr(R14, state.gprs).toNat() = width, room: o + 8 * (width + 21) <= 4096):
    Exists<MachineState<IoMemory>>(λ after => LinuxSteps(io_linux(), state, after) ∧
        RowOut(file, page0, at, o, row_counts(width, mask, counts), state.gprs, after)) {
    let io = io_linux();
    let piece = row_pieces(file, at, placed);
    let set = run_block(file, page0, row_setup_block(), at, ra(lr_setup()), piece(lr_setup()), state, memory_is, rip_is);
    let s1 = execute_block_normal(row_setup_block(), state);
    let head: RowAt(file, page0, at, ra(lr_head()), width, mask, slots, o, Nil, 0, column_bit(0), True, state.gprs, s1) =
        RowAt(page := page0, memory_is := set.memory_is, rip_is := set.rip_is, holds := page_same(page0, o), rdi := rdi, r9 := refl,
            r12 := trans(r12, slot_zero(slots)), r13 := r13, r14 := r14, r15 := refl,
            kept := RowKept(rsp := refl, rbp := refl, r8 := refl, r10 := refl));
    let rooms: (fields_room(width, 7) = (width + 21) + ((width + 21) + ((width + 21) + ((width + 21) + ((width + 21) + ((width + 21) +
        ((width + 21) + (width + 21)))))))) = refl;
    let fits: (o + fields_room(width, 7) <= 4096) = omega;
    have ran = row_loop(file, page0, at, piece, width, mask, slots, counts, held, o, state.gprs, 7, 0, True, Nil, s1, refl, fits, head);
    Exists(ran.witness, ⟨linux_steps_trans(io, state, s1, ran.witness, linux_steps_of_fetched(io, state, s1, set.steps), ran.proof.left),
        ran.proof.right⟩)
}

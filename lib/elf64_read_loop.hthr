// The read-until-end-of-file process shape (docs/native-read-until-eof-design.md):
// read stdin a page at a time into the page, count each chunk with a
// certified counting loop into a running total, stop at the empty read, and
// hand the total to a tail (exit with it, here; elf64_read_print writes it).
// A failed read (docs/native-syscall-failures-design.md) is retried when it
// is EINTR and otherwise exits with status 1.
// Nothing here is about any one program: the loop, its source function, and
// the specification its count meets are parameters, and a program supplies
// its loop certificate and two facts about its source. The profile fixes the
// loop's head registers (base RDI, length RBP, needle RCX, cursor RSI, budget
// R12, carry R11); between reads the total lives in R13, since SYSCALL
// clobbers R11.
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// How much one read asks for: the whole page. The claim covers every length
// the read may return, so this is also its input bound.
fn read_capacity() → Nat { 4096 }

// read(0, page, capacity).
fn read_entry_block() → List<Instruction> {
    [MovRI(Rax, BitVec::ofNat(0)), MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rsi, BitVec::ofNat(0x401000)),
     MovRI(Rdx, BitVec::ofNat(read_capacity()))]
}
// The outer loop's blocks. The total starts at zero; each chunk's setup
// copies it into the loop's carry, and the save keeps it across the next
// SYSCALL.
fn eof_init_block() → List<Instruction> { [MovRI(R13, BitVec::ofNat(0))] }
fn eof_test_block() → List<Instruction> { [TestRR(Rax, Rax)] }
fn eof_setup_block(needle: BitVec(8)) → List<Instruction> {
    [MovRR(Rbp, Rax), MovRR(R12, Rax), MovRI(Rdi, BitVec::ofNat(0x401000)), MovRI(Rcx, needle.zero_extend(56)),
     MovRI(Rsi, BitVec::ofNat(0)), MovRR(R11, R13)]
}
fn eof_save_block() → List<Instruction> { [MovRR(R13, R11)] }
// exit(total).
fn eof_exit_block() → List<Instruction> { [MovRR(Rdi, R13), MovRI(Rax, BitVec::ofNat(60))] }
// A failed read: RAX + 4 is zero exactly at -EINTR, which retries the read;
// anything else is exit(1). RBX is free between reads.
fn eof_retry_block() → List<Instruction> { [MovRI(Rbx, BitVec::ofNat(4)), AddRR(Rax, Rbx)] }
fn eof_fail_block() → List<Instruction> { [MovRI(Rdi, BitVec::ofNat(1)), MovRI(Rax, BitVec::ofNat(60))] }

fn read_entry_len() → Nat { canonical_block_bytes(read_entry_block()).len() }
fn eof_init_len() → Nat { canonical_block_bytes(eof_init_block()).len() }
fn eof_test_len() → Nat { canonical_block_bytes(eof_test_block()).len() }
fn eof_setup_len(needle: BitVec(8)) → Nat { canonical_block_bytes(eof_setup_block(needle)).len() }
fn eof_save_len() → Nat { canonical_block_bytes(eof_save_block()).len() }
fn eof_exit_len() → Nat { canonical_block_bytes(eof_exit_block()).len() }
fn eof_retry_len() → Nat { canonical_block_bytes(eof_retry_block()).len() }
fn eof_fail_len() → Nat { canonical_block_bytes(eof_fail_block()).len() }

// The jumps' displacements: JZ to the tail at end of file, JS to the failure
// path, JMP back after a chunk, JZ back to the read after EINTR.
record EofJumps { ed: BitVec(32), sd: BitVec(32), bd: BitVec(32), rd: BitVec(32) }

// The program: init, then the read, the test and its jumps to the tail and
// the failure path, the chunk's setup and loop, the save and the jump back,
// the failure path (retry test, jump back, exit(1)), then the tail.
fn eof_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>) → List<BitVec(8)> {
    canonical_block_bytes(eof_init_block()) ++ (canonical_block_bytes(read_entry_block()) ++ (linux_syscall_bytes() ++
    (canonical_block_bytes(eof_test_block()) ++ (near_control_bytes(JumpZeroNear(jumps.ed)) ++
    (near_control_bytes(JumpSignNear(jumps.sd)) ++
    (canonical_block_bytes(eof_setup_block(needle)) ++ (loop_bytes ++ (canonical_block_bytes(eof_save_block()) ++
    (near_control_bytes(JumpNear(jumps.bd)) ++
    (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(jumps.rd)) ++
    (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ tail)))))))))))))
}
fn eof_exit_code() → List<BitVec(8)> { canonical_block_bytes(eof_exit_block()) ++ linux_syscall_bytes() }
fn read_loop_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps) → List<BitVec(8)> {
    eof_code(needle, loop_bytes, jumps, eof_exit_code())
}

// Offsets from the entry, piece by piece.
fn eof_rip(at: Nat) → BitVec(64) { next_rip(BitVec::ofNat(0x4000e8), at) }
fn eof_at_read() → Nat { 0 + eof_init_len() }
fn eof_at_call() → Nat { eof_at_read() + read_entry_len() }
fn eof_at_test() → Nat { eof_at_call() + 2 }
fn eof_at_jz() → Nat { eof_at_test() + eof_test_len() }
fn eof_at_js() → Nat { eof_at_jz() + 6 }
fn eof_at_setup() → Nat { eof_at_js() + 6 }
fn eof_at_loop(needle: BitVec(8)) → Nat { eof_at_setup() + eof_setup_len(needle) }
fn eof_at_save(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_loop(needle) + loop_bytes.len() }
fn eof_at_jmp(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_save(needle, loop_bytes) + eof_save_len() }
fn eof_at_failed(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_jmp(needle, loop_bytes) + 5 }
fn eof_at_retry(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_failed(needle, loop_bytes) + eof_retry_len() }
fn eof_at_fail(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_retry(needle, loop_bytes) + 6 }
fn eof_at_fail_call(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_fail(needle, loop_bytes) + eof_fail_len() }
fn eof_at_done(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_fail_call(needle, loop_bytes) + 2 }

// The program's pieces, resident at their offsets from the entry.
record EofPieces(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>) {
    init_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_init_block()), eof_rip(0)),
    entry_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(read_entry_block()), eof_rip(eof_at_read())),
    call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(), eof_rip(eof_at_call())),
    test_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_test_block()), eof_rip(eof_at_test())),
    jz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(jumps.ed)), eof_rip(eof_at_jz())),
    js_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpSignNear(jumps.sd)), eof_rip(eof_at_js())),
    setup_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_setup_block(needle)), eof_rip(eof_at_setup())),
    loop_at: CodeResident(io_fetch_access(), memory, loop_bytes, eof_rip(eof_at_loop(needle))),
    save_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_save_block()), eof_rip(eof_at_save(needle, loop_bytes))),
    jmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(jumps.bd)), eof_rip(eof_at_jmp(needle, loop_bytes))),
    retry_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_retry_block()), eof_rip(eof_at_failed(needle, loop_bytes))),
    retry_jz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(jumps.rd)), eof_rip(eof_at_retry(needle, loop_bytes))),
    fail_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_fail_block()), eof_rip(eof_at_fail(needle, loop_bytes))),
    fail_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(), eof_rip(eof_at_fail_call(needle, loop_bytes))),
    tail_at: CodeResident(io_fetch_access(), memory, tail, eof_rip(eof_at_done(needle, loop_bytes))),
}

theorem eof_pieces(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>,
    resident: CodeResident(io_fetch_access(), memory, eof_code(needle, loop_bytes, jumps, tail), BitVec::ofNat(0x4000e8))):
    EofPieces(memory, needle, loop_bytes, jumps, tail) {
    let fetch = io_fetch_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let i = canonical_block_bytes(eof_init_block());
    let e = canonical_block_bytes(read_entry_block());
    let call = linux_syscall_bytes();
    let t = canonical_block_bytes(eof_test_block());
    let z = near_control_bytes(JumpZeroNear(jumps.ed));
    let sg = near_control_bytes(JumpSignNear(jumps.sd));
    let s = canonical_block_bytes(eof_setup_block(needle));
    let v = canonical_block_bytes(eof_save_block());
    let b = near_control_bytes(JumpNear(jumps.bd));
    let rt = canonical_block_bytes(eof_retry_block());
    let rz = near_control_bytes(JumpZeroNear(jumps.rd));
    let f = canonical_block_bytes(eof_fail_block());
    let after_jmp = rt ++ (rz ++ (f ++ (call ++ tail)));
    let r0 = resident_split_at(fetch, memory, i, e ++ (call ++ (t ++ (z ++ (sg ++ (s ++ (loop_bytes ++ (v ++ (b ++ after_jmp)))))))), entry, 0, resident);
    let r1 = resident_split_at(fetch, memory, e, call ++ (t ++ (z ++ (sg ++ (s ++ (loop_bytes ++ (v ++ (b ++ after_jmp))))))), entry, eof_at_read(), r0.right);
    let r2 = resident_split_at(fetch, memory, call, t ++ (z ++ (sg ++ (s ++ (loop_bytes ++ (v ++ (b ++ after_jmp)))))), entry, eof_at_call(), r1.right);
    let r3 = resident_split_at(fetch, memory, t, z ++ (sg ++ (s ++ (loop_bytes ++ (v ++ (b ++ after_jmp))))), entry, eof_at_test(), r2.right);
    let r4 = resident_split_at(fetch, memory, z, sg ++ (s ++ (loop_bytes ++ (v ++ (b ++ after_jmp)))), entry, eof_at_jz(), r3.right);
    let r4s = resident_split_at(fetch, memory, sg, s ++ (loop_bytes ++ (v ++ (b ++ after_jmp))), entry, eof_at_js(), r4.right);
    let r5 = resident_split_at(fetch, memory, s, loop_bytes ++ (v ++ (b ++ after_jmp)), entry, eof_at_setup(), r4s.right);
    let r6 = resident_split_at(fetch, memory, loop_bytes, v ++ (b ++ after_jmp), entry, eof_at_loop(needle), r5.right);
    let r7 = resident_split_at(fetch, memory, v, b ++ after_jmp, entry, eof_at_save(needle, loop_bytes), r6.right);
    let r8 = resident_split_at(fetch, memory, b, after_jmp, entry, eof_at_jmp(needle, loop_bytes), r7.right);
    let r9 = resident_split_at(fetch, memory, rt, rz ++ (f ++ (call ++ tail)), entry, eof_at_failed(needle, loop_bytes), r8.right);
    let r10 = resident_split_at(fetch, memory, rz, f ++ (call ++ tail), entry, eof_at_retry(needle, loop_bytes), r9.right);
    let r11 = resident_split_at(fetch, memory, f, call ++ tail, entry, eof_at_fail(needle, loop_bytes), r10.right);
    let r12 = resident_split_at(fetch, memory, call, tail, entry, eof_at_fail_call(needle, loop_bytes), r11.right);
    EofPieces(r0.left, r1.left, r2.left, r3.left, r4.left, r4s.left, r5.left, r6.left, r7.left, r8.left,
        r9.left, r10.left, r11.left, r12.left, r12.right)
}

theorem nth_some_below<A>(xs: List<A>, i: Nat, x: A, present: xs.nth(i) = Some(x)): i < xs.len() {
    Nat::lt_of_not_le(i, xs.len(), λ past => absurd(trans(sym(present), xs.nth_past_end(i, past))))
}

// The profile's head registers, as the loop certificate's placement names them.
record ReadLoopPlacement(p: LoopPlacement) {
    base: p.base = Rdi, length: p.length = Rbp, needle: p.needle = Rcx,
    cursor: p.cursor = Rsi, budget: p.budget = R12, carry: p.carry = R11,
}

// A certified Nat-carry loop, as the loop generator publishes one, over this
// profile's memory.
fn ReadLoopCertificate(p: LoopPlacement, region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>) → Type {
    (access: ByteReadAccess<IoMemory>) → (before: MachineState<IoMemory>) → (buffer: ReadonlyBytes) →
    (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
    LoopAddressBound(64, buffer) → buffer.base + buffer.length <= Nat::pow(2, 47) →
    LoopHead<IoMemory, Nat>(p, loop_nat_rep, access, buffer, needle, before, cursor, budget, carry) →
    LoopReadable(budget, region, buffer, needle, cursor, carry) → loop_fits(cursor, budget, carry) →
    Exists<MachineState<IoMemory>>(λ after => AccessArtifact<IoMemory>(access, loop_code, loop_bytes, before, after) ∧
        LoopObserved<IoMemory, Nat>(p, loop_nat_rep, after, source(buffer, needle, budget, cursor, carry)))
}

// What a counting program proves: from any count, the loop over a buffer
// holding `bytes` adds `spec(bytes)`; and the specification adds over
// concatenation, so counting chunk by chunk counts the whole input.
fn ReadEofComputes(source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8),
    spec: List<BitVec(8)> → Nat) → Type {
    (carry: Nat) → (bytes: List<BitVec(8)>) → (buffer: ReadonlyBytes) → buffer.length = bytes.len() →
    ((i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → buffer.read(buffer.base + i) = Some(byte)) →
    source(buffer, needle, bytes.len(), 0, carry) = End(bytes.len(), 0, carry + spec(bytes))
}

fn eof_after_setup(needle: BitVec(8), state: MachineState<IoMemory>) → MachineState<IoMemory> {
    execute_block_normal(eof_setup_block(needle), state)
}

theorem eof_loop_head(p: LoopPlacement, at: ReadLoopPlacement(p), needle: BitVec(8), bytes: List<BitVec(8)>,
    fits: bytes.len() <= 4096, carry: Nat, carry_small: carry < Nat::pow(2, 64), state: MachineState<IoMemory>,
    length_word: read_gpr(Rax, state.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    carry_word: read_gpr(R13, state.gprs) = bitvec_nat::word_of_nat(64, carry)):
    LoopHead<IoMemory, Nat>(p, loop_nat_rep, io_data_access(), io_buffer(state.memory, bytes.len()), needle,
        eof_after_setup(needle, state), 0, bytes.len(), carry) {
    let ready = eof_after_setup(needle, state);
    let n = bytes.len();
    let below: (n < Nat::pow(2, 64)) = Succ(n).le_trans(4097, Nat::pow(2, 64), fits, Nat::leb_sound(4097, Nat::pow(2, 64), trivial));
    let counted: (read_gpr(Rbp, ready.gprs).toNat() = n) =
        trans(cong_fn<BitVec(64), Nat>(λ word => word.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, n, below));
    let budgeted: (read_gpr(R12, ready.gprs).toNat() = n) = counted;
    let carried: (read_gpr(R11, ready.gprs).toNat() = carry) =
        trans(cong_fn<BitVec(64), Nat>(λ word => word.toNat(), carry_word), bitvec_nat::toNat_word_of_nat(64, carry, carry_small));
    LoopHead(
        base_placed := j(sym(at.base), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), io_page_base()), refl),
        length_placed := j(sym(at.length), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), counted),
        needle_placed := j(sym(at.needle), λ r _ => read_gpr(r, ready.gprs) = needle.zero_extend(56), refl),
        cursor_placed := j(sym(at.cursor), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), 0), refl),
        budget_placed := j(sym(at.budget), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), budgeted),
        carry_placed := j(sym(at.carry), λ r _ => loop_nat_rep(read_gpr(r, ready.gprs), carry), carried),
        inside := trivial,
        memory_agrees := λ word => io_buffer_agrees(state.memory, n, word))
}

// Set up and run: the count is in R11, memory is what the read left, and RIP
// is past the loop.
fn ReadLoopCounted(returned: MachineState<IoMemory>, stored: IoMemory, count: Nat, done_at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ done => FetchedSteps(io_fetch_access(), io_data_access(), returned, done) ∧
        ((done.memory = stored) ∧ ((done.rip = done_at) ∧ (read_gpr(R11, done.gprs) = bitvec_nat::word_of_nat(64, count)))))
}

// After a read returned `bytes`, from `at_setup`: set up the loop's head from
// the count in R13, run the loop. R11 then holds the count plus the chunk's.
theorem eof_counts(file: List<BitVec(8)>, page: Nat → BitVec(8), p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(source, needle, spec),
    bytes: List<BitVec(8)>, fits: bytes.len() <= read_capacity(), carry: Nat, room: carry + bytes.len() < Nat::pow(2, 64),
    ready_in: MachineState<IoMemory>, at_setup: Nat,
    memory_is: ready_in.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: ready_in.rip = eof_rip(at_setup),
    length_word: read_gpr(Rax, ready_in.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    carry_word: read_gpr(R13, ready_in.gprs) = bitvec_nat::word_of_nat(64, carry),
    setup_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(eof_setup_block(needle)), eof_rip(at_setup)),
    loop_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        loop_bytes, eof_rip(at_setup + eof_setup_len(needle)))):
    ReadLoopCounted(ready_in, io_store_offset(IoMemory(file, page), 0, bytes), carry + spec(bytes),
        eof_rip((at_setup + eof_setup_len(needle)) + loop_bytes.len())) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let n = bytes.len();
    let capped: (n <= 4096) = fits;
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let at_loop = at_setup + eof_setup_len(needle);
    let at_exit = at_loop + loop_bytes.len();
    let carry_small: (carry < Nat::pow(2, 64)) = Succ(carry).le_trans(Succ(carry + n), Nat::pow(2, 64), carry.le_add_l(n), room);
    let setup = block_fetched(fetch, data, eof_setup_block(needle), ready_in, trivial,
        resident_state(fetch, canonical_block_bytes(eof_setup_block(needle)), stored, eof_rip(at_setup),
            ready_in, memory_is, rip_is, setup_at));
    let ready = eof_after_setup(needle, ready_in);
    let ready_memory: (ready.memory = stored) = trans(pure_block_memory(eof_setup_block(needle), ready_in), memory_is);
    let ready_rip: (ready.rip = eof_rip(at_loop)) =
        trans(setup.right, rip_advance(entry, ready_in.rip, at_setup, eof_setup_len(needle), rip_is));
    let buffer = io_buffer(ready_in.memory, n);
    let reads = λ (i: Nat) (byte: BitVec(8)) (present: bytes.nth(i) = Some(byte)) =>
        j(sym(memory_is), λ memory _ => io_read(memory, bitvec_nat::word_of_nat(64, io_page_base() + i)) = Some(byte),
            io_read_stored(IoMemory(file, page), bytes, i, byte,
                Succ(i).le_trans(n, 4096, nth_some_below(bytes, i, byte, present), fits), present));
    let computed = computes(carry, bytes, buffer, refl, reads);
    let readable: LoopReadable(n, region, buffer, needle, 0, carry) =
        j(sym(trans(agreement(buffer, needle, n, 0, carry), computed)), λ outcome _ => LoopFinishedNormally(outcome), trivial);
    let within: (Succ(io_page_base() + n) <= io_page_base() + 4097) = omega;
    let bounded: LoopAddressBound(64, buffer) =
        Succ(io_page_base() + n).le_trans(io_page_base() + 4097, Nat::pow(2, 64), within,
            Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial));
    let low: (buffer.base + buffer.length <= Nat::pow(2, 47)) =
        (io_page_base() + n).le_trans(io_page_base() + 4096, Nat::pow(2, 47), Nat::add_le_mono_l(io_page_base(), n, 4096, fits),
            Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial));
    let ran = native(data, ready, buffer, needle, n, 0, carry, bounded, low,
        eof_loop_head(p, at, needle, bytes, fits, carry, carry_small, ready_in, length_word, carry_word), readable, room);
    let done = ran.witness;
    let looped = access_artifact_fetched(fetch, data, loop_code, loop_bytes, ready, done, ran.proof.left,
        resident_state(fetch, loop_bytes, stored, eof_rip(at_loop), ready, ready_memory, ready_rip, loop_at));
    let done_memory: (done.memory = stored) = trans(access_memory(data, loop_code, ready, done, ran.proof.left.execution), ready_memory);
    let done_rip: (done.rip = eof_rip(at_exit)) =
        trans(looped.right, rip_advance(entry, ready.rip, at_loop, loop_bytes.len(), ready_rip));
    let observed = j(computed, λ outcome _ => LoopObserved<IoMemory, Nat>(p, loop_nat_rep, done, outcome), ran.proof.right);
    let carried: (read_gpr(R11, done.gprs).toNat() = carry + spec(bytes)) =
        j(at.carry, λ r _ => read_gpr(r, done.gprs).toNat() = carry + spec(bytes), observed.right.right.right);
    let word: (read_gpr(R11, done.gprs) = bitvec_nat::word_of_nat(64, carry + spec(bytes))) =
        trans(sym(bitvec_nat::word_of_nat_toNat(64, read_gpr(R11, done.gprs))),
            cong_fn<Nat, BitVec(64)>(λ count => bitvec_nat::word_of_nat(64, count), carried));
    Exists(done, ⟨fetched_steps_trans(fetch, data, ready_in, ready, done, setup.left, looped.left), ⟨done_memory, ⟨done_rip, word⟩⟩⟩)
}

// Where the loop is again after a chunk: back at the read, the chunk stored,
// its count added in R13.
fn EofBack(returned: MachineState<IoMemory>, stored: IoMemory, count: Nat, read_at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ back => FetchedSteps(io_fetch_access(), io_data_access(), returned, back) ∧
        ((back.memory = stored) ∧ ((back.rip = read_at) ∧ (read_gpr(R13, back.gprs) = bitvec_nat::word_of_nat(64, count)))))
}

theorem eof_test_clear(returned: MachineState<IoMemory>, n: Nat, below: n < Nat::pow(2, 64), some: 0 < n,
    length_word: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, n)):
    execute_block_normal(eof_test_block(), returned).flags.zf = False {
    let n_word = bitvec_nat::word_of_nat(64, n);
    let positive: (0 < n_word.toNat()) = j(sym(bitvec_nat::toNat_word_of_nat(64, n, below)), λ v _ => 0 < v, some);
    j(sym(length_word), λ w _ => is_zero_bits(64, w.band(w)) = False, test_self_nonzero(64, n_word, positive))
}

theorem eof_test_count(returned: MachineState<IoMemory>, n: Nat, fits: n <= 4096,
    length_word: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, n)):
    execute_block_normal(eof_test_block(), returned).flags.sf = False {
    let n_word = bitvec_nat::word_of_nat(64, n);
    let value: (n_word.toNat() = n) = bitvec_nat::toNat_word_of_nat(64, n, { omega });
    j(sym(length_word), λ w _ => w.band(w).sign_bit() = False, test_self_nonnegative(n_word, { omega }))
}

// The chunk's steps: after entry at `going`, what the jumps passed.
fn EofEntered(returned, going: MachineState<IoMemory>, stored: IoMemory, at: BitVec(64)) → Type {
    FetchedSteps(io_fetch_access(), io_data_access(), returned, going) ∧ ((going.memory = stored) ∧ (going.rip = at))
}

// TEST RAX, RAX, then JZ to the tail and JS to the failure path, neither
// taken: the chunk is not empty, and a count is not an error.
theorem eof_enter(file: List<BitVec(8)>, page: Nat → BitVec(8), ed, sd: BitVec(32), at_test: Nat, bytes: List<BitVec(8)>,
    some: 0 < bytes.len(), fits: bytes.len() <= 4096, returned: MachineState<IoMemory>,
    memory_is: returned.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: returned.rip = eof_rip(at_test),
    length_word: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    test_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(eof_test_block()), eof_rip(at_test)),
    jz_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        near_control_bytes(JumpZeroNear(ed)), eof_rip(at_test + eof_test_len())),
    js_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        near_control_bytes(JumpSignNear(sd)), eof_rip((at_test + eof_test_len()) + 6))):
    EofEntered(returned,
        execute_near_control(JumpSignNear(sd), execute_near_control(JumpZeroNear(ed), execute_block_normal(eof_test_block(), returned))),
        io_store_offset(IoMemory(file, page), 0, bytes), eof_rip(((at_test + eof_test_len()) + 6) + 6)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let at_jz = at_test + eof_test_len();
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), stored, eof_rip(at_test), returned, memory_is, rip_is, test_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = stored) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = eof_rip(at_jz)) = trans(test.right, rip_advance(entry, returned.rip, at_test, eof_test_len(), rip_is));
    let below: (bytes.len() < Nat::pow(2, 64)) = omega;
    let clear = eof_test_clear(returned, bytes.len(), below, some, length_word);
    let positive = eof_test_count(returned, bytes.len(), fits, length_word);
    let jz = near_fetched_step(fetch, data, JumpZeroNear(ed), tested,
        resident_state(fetch, near_control_bytes(JumpZeroNear(ed)), stored, eof_rip(at_jz), tested, tested_memory, tested_rip, jz_at));
    let passed = execute_near_control(JumpZeroNear(ed), tested);
    let passed_rip: (passed.rip = eof_rip(at_jz + 6)) = trans(near_not_taken_rip(ed, tested, clear), rip_advance(entry, tested.rip, at_jz, 6, tested_rip));
    let js = near_fetched_step(fetch, data, JumpSignNear(sd), passed,
        resident_state(fetch, near_control_bytes(JumpSignNear(sd)), stored, eof_rip(at_jz + 6), passed, tested_memory, passed_rip, js_at));
    let going = execute_near_control(JumpSignNear(sd), passed);
    ⟨fetched_steps_trans(fetch, data, returned, tested, going, test.left,
        fetched_steps_trans(fetch, data, tested, passed, going, fetched_steps_one(fetch, data, tested, passed, jz),
            fetched_steps_one(fetch, data, passed, going, js))),
     ⟨tested_memory, trans(near_sign_not_taken_rip(sd, passed, positive), rip_advance(entry, passed.rip, at_jz + 6, 6, passed_rip))⟩⟩
}

// The chunk's close: keep the count across the next SYSCALL and jump back to
// the read. The count's run is an argument, so the proof mentions it once.
theorem eof_chunk_close(returned, going: MachineState<IoMemory>, stored: IoMemory, count: Nat, bd: BitVec(32), at_save, at_read: Nat,
    back_target: near_branch_target(eof_rip(at_save + eof_save_len()), 5, bd) = eof_rip(at_read),
    entered: FetchedSteps(io_fetch_access(), io_data_access(), returned, going),
    counted: ReadLoopCounted(going, stored, count, eof_rip(at_save)),
    save_at: CodeResident(io_fetch_access(), stored, canonical_block_bytes(eof_save_block()), eof_rip(at_save)),
    jmp_at: CodeResident(io_fetch_access(), stored, near_control_bytes(JumpNear(bd)), eof_rip(at_save + eof_save_len()))):
    EofBack(returned, stored, count, eof_rip(at_read)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let done = counted.witness;
    let save = block_fetched(fetch, data, eof_save_block(), done, trivial,
        resident_state(fetch, canonical_block_bytes(eof_save_block()), stored, eof_rip(at_save), done,
            counted.proof.right.left, counted.proof.right.right.left, save_at));
    let saved = execute_block_normal(eof_save_block(), done);
    let saved_memory: (saved.memory = stored) = trans(pure_block_memory(eof_save_block(), done), counted.proof.right.left);
    let saved_rip: (saved.rip = eof_rip(at_save + eof_save_len())) =
        trans(save.right, rip_advance(entry, done.rip, at_save, eof_save_len(), counted.proof.right.right.left));
    let jump = near_fetched_step(fetch, data, JumpNear(bd), saved,
        resident_state(fetch, near_control_bytes(JumpNear(bd)), stored, eof_rip(at_save + eof_save_len()), saved, saved_memory, saved_rip, jmp_at));
    let back = execute_near_control(JumpNear(bd), saved);
    let back_rip: (back.rip = eof_rip(at_read)) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, bd), saved_rip), back_target);
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, going, back, entered,
            fetched_steps_trans(fetch, data, going, done, back, counted.proof.left,
                fetched_steps_trans(fetch, data, done, saved, back, save.left, fetched_steps_one(fetch, data, saved, back, jump)))),
        ⟨saved_memory, ⟨back_rip, counted.proof.right.right.right⟩⟩⟩)
}

// One chunk, from the read's return: back at the read with the chunk counted.
theorem eof_chunk(file: List<BitVec(8)>, page: Nat → BitVec(8), p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(source, needle, spec),
    ed, sd, bd: BitVec(32), at_read, at_test: Nat,
    back_target: near_branch_target(eof_rip(((((((at_test + eof_test_len()) + 6) + 6) + eof_setup_len(needle)) + loop_bytes.len()) + eof_save_len())), 5, bd)
        = eof_rip(at_read),
    bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= read_capacity(), carry: Nat,
    room: carry + bytes.len() < Nat::pow(2, 64), returned: MachineState<IoMemory>,
    memory_is: returned.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: returned.rip = eof_rip(at_test),
    length_word: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    carry_word: read_gpr(R13, returned.gprs) = bitvec_nat::word_of_nat(64, carry),
    test_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(eof_test_block()), eof_rip(at_test)),
    jz_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        near_control_bytes(JumpZeroNear(ed)), eof_rip(at_test + eof_test_len())),
    js_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        near_control_bytes(JumpSignNear(sd)), eof_rip((at_test + eof_test_len()) + 6)),
    setup_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(eof_setup_block(needle)), eof_rip(((at_test + eof_test_len()) + 6) + 6)),
    loop_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        loop_bytes, eof_rip((((at_test + eof_test_len()) + 6) + 6) + eof_setup_len(needle))),
    save_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(eof_save_block()), eof_rip(((((at_test + eof_test_len()) + 6) + 6) + eof_setup_len(needle)) + loop_bytes.len())),
    jmp_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        near_control_bytes(JumpNear(bd)), eof_rip((((((at_test + eof_test_len()) + 6) + 6) + eof_setup_len(needle)) + loop_bytes.len()) + eof_save_len()))):
    EofBack(returned, io_store_offset(IoMemory(file, page), 0, bytes), carry + spec(bytes), eof_rip(at_read)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let at_setup = ((at_test + eof_test_len()) + 6) + 6;
    let at_save = (at_setup + eof_setup_len(needle)) + loop_bytes.len();
    let entered = eof_enter(file, page, ed, sd, at_test, bytes, some, fits, returned, memory_is, rip_is, length_word, test_at, jz_at, js_at);
    let going = execute_near_control(JumpSignNear(sd), execute_near_control(JumpZeroNear(ed), execute_block_normal(eof_test_block(), returned)));
    eof_chunk_close(returned, going, stored, carry + spec(bytes), bd, at_save, at_read, back_target, entered.left,
        eof_counts(file, page, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes,
            bytes, fits, carry, room, going, at_setup, entered.right.left, entered.right.right,
            length_word, carry_word, setup_at, loop_at),
        save_at, jmp_at)
}

// What the reads return, in order: chunks, and EINTRs that are retried; then
// how the reading ended, at the empty read or at a failure other than EINTR.
inductive ReadStep {
    Chunk(bytes: List<BitVec(8)>),
    Interrupted,
}
inductive ReadEnding {
    AtEnd,
    FailedWith(errno: Nat),
}

// The trace of the reads: at end of file the tail follows; a failed read
// exits 1.
fn eof_events(steps: List<ReadStep>, ending: ReadEnding, tail: List<LinuxEvent>) → List<LinuxEvent> {
    match steps {
        Nil => match ending {
            AtEnd => Cons(ReadEvent(BitVec::ofNat(0), ReadBytes(Nil)), tail),
            FailedWith(errno) => [ReadEvent(BitVec::ofNat(0), ReadFailed(errno)), ExitEvent(BitVec::ofNat(1))],
        },
        Cons(step, rest) => match step {
            Chunk(chunk) => Cons(ReadEvent(BitVec::ofNat(0), ReadBytes(chunk)), eof_events(rest, ending, tail)),
            Interrupted => Cons(ReadEvent(BitVec::ofNat(0), ReadFailed(eintr())), eof_events(rest, ending, tail)),
        },
    }
}
fn eof_input(steps: List<ReadStep>) → List<BitVec(8)> {
    match steps {
        Nil => Nil,
        Cons(step, rest) => match step { Chunk(chunk) => chunk ++ eof_input(rest), Interrupted => eof_input(rest) },
    }
}
// A read before end of file returns at least one byte, and at most the page.
fn EofChunks(steps: List<ReadStep>) → Type {
    match steps {
        Nil => True,
        Cons(step, rest) => match step {
            Chunk(chunk) => (0 < chunk.len()) ∧ ((chunk.len() <= read_capacity()) ∧ EofChunks(rest)),
            Interrupted => EofChunks(rest),
        },
    }
}
// A failure that ends the reading is an errno, and not EINTR, which retries.
fn EofEnding(ending: ReadEnding) → Type {
    match ending { AtEnd => True, FailedWith(errno) => Errno(errno) ∧ Not(errno = eintr()) }
}

fn EofTail(file: List<BitVec(8)>, needle: BitVec(8), loop_bytes: List<BitVec(8)>, total: Nat, events: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.rip = eof_rip(eof_at_done(needle, loop_bytes)) →
    state.memory = IoMemory(file, page) → read_gpr(R13, state.gprs) = bitvec_nat::word_of_nat(64, total) →
    LinuxRuns(io_linux(), events, state)
}

// The count's arithmetic, kept to Nat.
theorem eof_room(carry, len, first, rest, total: Nat, sum: carry + (first + rest) = total, capped: len <= 4096,
    room: total + 4096 < Nat::pow(2, 64)): carry + len < Nat::pow(2, 64) { omega }
theorem eof_later(carry, first, rest, total: Nat, sum: carry + (first + rest) = total): carry + first + rest = total { omega }

// ---------------------------------------------------------------------------
// A failed read.

// From the read's return with a negated errno in RAX: TEST, JZ not taken, JS
// taken, the retry test. The total in R13 is untouched.
fn EofFailedAt(returned: MachineState<IoMemory>, stored: IoMemory, errno: Nat, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ fixed => FetchedSteps(io_fetch_access(), io_data_access(), returned, fixed) ∧
        ((fixed.memory = stored) ∧ ((fixed.rip = at) ∧
        ((fixed.flags.zf = is_zero_bits(64, errno_word(errno).add(BitVec::ofNat(4)))) ∧
        (read_gpr(R13, fixed.gprs) = read_gpr(R13, returned.gprs))))))
}

theorem eof_failed(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail_code: List<BitVec(8)>,
    pieces: EofPieces(stored, needle, loop_bytes, jumps, tail_code),
    js_target: near_branch_target(eof_rip(eof_at_js()), 6, jumps.sd) = eof_rip(eof_at_failed(needle, loop_bytes)),
    errno: Nat, error: Errno(errno), returned: MachineState<IoMemory>,
    memory_is: returned.memory = stored, rip_is: returned.rip = eof_rip(eof_at_test()),
    rax: read_gpr(Rax, returned.gprs) = errno_word(errno)):
    EofFailedAt(returned, stored, errno, eof_rip(eof_at_retry(needle, loop_bytes))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let w = errno_word(errno);
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), stored, eof_rip(eof_at_test()), returned, memory_is, rip_is,
            pieces.test_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = stored) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = eof_rip(eof_at_jz())) =
        trans(test.right, rip_advance(entry, returned.rip, eof_at_test(), eof_test_len(), rip_is));
    let nonzero: (tested.flags.zf = False) =
        j(sym(rax), λ v _ => is_zero_bits(64, v.band(v)) = False, test_self_nonzero(64, w, errno_nonzero(errno, error)));
    let negative: (tested.flags.sf = True) =
        j(sym(rax), λ v _ => v.band(v).sign_bit() = True, test_self_negative(w, errno_negative(errno, error)));
    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.ed), tested,
        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.ed)), stored, eof_rip(eof_at_jz()), tested, tested_memory, tested_rip,
            pieces.jz_at));
    let passed = execute_near_control(JumpZeroNear(jumps.ed), tested);
    let passed_rip: (passed.rip = eof_rip(eof_at_js())) =
        trans(near_not_taken_rip(jumps.ed, tested, nonzero), rip_advance(entry, tested.rip, eof_at_jz(), 6, tested_rip));
    let js = near_fetched_step(fetch, data, JumpSignNear(jumps.sd), passed,
        resident_state(fetch, near_control_bytes(JumpSignNear(jumps.sd)), stored, eof_rip(eof_at_js()), passed, tested_memory, passed_rip,
            pieces.js_at));
    let failing = execute_near_control(JumpSignNear(jumps.sd), passed);
    let failing_rip: (failing.rip = eof_rip(eof_at_failed(needle, loop_bytes))) =
        trans(near_sign_taken_rip(jumps.sd, passed, negative),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.sd), passed_rip), js_target));
    let retry = block_fetched(fetch, data, eof_retry_block(), failing, trivial,
        resident_state(fetch, canonical_block_bytes(eof_retry_block()), stored, eof_rip(eof_at_failed(needle, loop_bytes)), failing,
            tested_memory, failing_rip, pieces.retry_at));
    let fixed = execute_block_normal(eof_retry_block(), failing);
    let fixed_memory: (fixed.memory = stored) = trans(pure_block_memory(eof_retry_block(), failing), tested_memory);
    let fixed_rip: (fixed.rip = eof_rip(eof_at_retry(needle, loop_bytes))) =
        trans(retry.right, rip_advance(entry, failing.rip, eof_at_failed(needle, loop_bytes), eof_retry_len(), failing_rip));
    let flag: (fixed.flags.zf = is_zero_bits(64, w.add(BitVec::ofNat(4)))) =
        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.add(BitVec::ofNat(4))), rax);
    Exists(fixed, ⟨fetched_steps_trans(fetch, data, returned, tested, fixed, test.left,
            fetched_steps_trans(fetch, data, tested, passed, fixed, fetched_steps_one(fetch, data, tested, passed, jz),
                fetched_steps_trans(fetch, data, passed, failing, fixed, fetched_steps_one(fetch, data, passed, failing, js), retry.left))),
        ⟨fixed_memory, ⟨fixed_rip, ⟨flag, refl⟩⟩⟩⟩)
}

// Back at the read with the total kept: what EINTR's retry reaches.
fn EofRetried(returned: MachineState<IoMemory>, stored: IoMemory, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ back => FetchedSteps(io_fetch_access(), io_data_access(), returned, back) ∧
        ((back.memory = stored) ∧ ((back.rip = at) ∧ (read_gpr(R13, back.gprs) = read_gpr(R13, returned.gprs)))))
}

theorem eof_retry(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail_code: List<BitVec(8)>,
    pieces: EofPieces(stored, needle, loop_bytes, jumps, tail_code),
    retry_target: near_branch_target(eof_rip(eof_at_retry(needle, loop_bytes)), 6, jumps.rd) = eof_rip(eof_at_read()),
    returned: MachineState<IoMemory>, failed: EofFailedAt(returned, stored, eintr(), eof_rip(eof_at_retry(needle, loop_bytes)))):
    EofRetried(returned, stored, eof_rip(eof_at_read())) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let fixed = failed.witness;
    let set: (fixed.flags.zf = True) = trans(failed.proof.right.right.right.left, eintr_plus_four());
    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.rd)), stored, eof_rip(eof_at_retry(needle, loop_bytes)), fixed,
            failed.proof.right.left, failed.proof.right.right.left, pieces.retry_jz_at));
    let back = execute_near_control(JumpZeroNear(jumps.rd), fixed);
    let back_rip: (back.rip = eof_rip(eof_at_read())) =
        trans(near_taken_rip(jumps.rd, fixed, set),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.rd), failed.proof.right.right.left),
                retry_target));
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, fixed, back, failed.proof.left, fetched_steps_one(fetch, data, fixed, back, jz)),
        ⟨failed.proof.right.left, ⟨back_rip, failed.proof.right.right.right.right⟩⟩⟩)
}

// Any other errno: exit(1).
theorem eof_fail_exit(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail_code: List<BitVec(8)>,
    pieces: EofPieces(stored, needle, loop_bytes, jumps, tail_code),
    errno: Nat, error: Errno(errno), other: Not(errno = eintr()),
    returned: MachineState<IoMemory>, failed: EofFailedAt(returned, stored, errno, eof_rip(eof_at_retry(needle, loop_bytes)))):
    LinuxRuns(io_linux(), [ExitEvent(BitVec::ofNat(1))], returned) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let fixed = failed.witness;
    let fixed_memory: (fixed.memory = stored) = failed.proof.right.left;
    let fixed_rip: (fixed.rip = eof_rip(eof_at_retry(needle, loop_bytes))) = failed.proof.right.right.left;
    let clear: (fixed.flags.zf = False) = trans(failed.proof.right.right.right.left, other_errno_plus_four(errno, error, other));
    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.rd)), stored, eof_rip(eof_at_retry(needle, loop_bytes)), fixed,
            fixed_memory, fixed_rip, pieces.retry_jz_at));
    let going = execute_near_control(JumpZeroNear(jumps.rd), fixed);
    let going_rip: (going.rip = eof_rip(eof_at_fail(needle, loop_bytes))) =
        trans(near_not_taken_rip(jumps.rd, fixed, clear), rip_advance(entry, fixed.rip, eof_at_retry(needle, loop_bytes), 6, fixed_rip));
    let exiting = block_fetched(fetch, data, eof_fail_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(eof_fail_block()), stored, eof_rip(eof_at_fail(needle, loop_bytes)), going,
            fixed_memory, going_rip, pieces.fail_at));
    let last = execute_block_normal(eof_fail_block(), going);
    let last_memory: (last.memory = stored) = trans(pure_block_memory(eof_fail_block(), going), fixed_memory);
    let last_rip: (last.rip = eof_rip(eof_at_fail_call(needle, loop_bytes))) =
        trans(exiting.right, rip_advance(entry, going.rip, eof_at_fail(needle, loop_bytes), eof_fail_len(), going_rip));
    let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
        resident_state(fetch, linux_syscall_bytes(), stored, eof_rip(eof_at_fail_call(needle, loop_bytes)), last, last_memory, last_rip,
            pieces.fail_call_at)));
    linux_runs_exit(io_linux(), returned, last, BitVec::ofNat(1),
        fetched_steps_trans(fetch, data, returned, fixed, last, failed.proof.left,
            fetched_steps_trans(fetch, data, fixed, going, last, fetched_steps_one(fetch, data, fixed, going, jz), exiting.left)),
        call, refl, refl)
}

// ---------------------------------------------------------------------------
// The loop.

// From the read with the count so far in R13, the rest of the run.
fn EofFrom(file: List<BitVec(8)>, spec: List<BitVec(8)> → Nat, total: Nat, ending: ReadEnding, tail_events: List<LinuxEvent>,
    steps: List<ReadStep>) → Type {
    EofChunks(steps) → (page: Nat → BitVec(8)) → (carry: Nat) → (state: MachineState<IoMemory>) →
    state.rip = eof_rip(eof_at_read()) → state.memory = IoMemory(file, page) →
    read_gpr(R13, state.gprs) = bitvec_nat::word_of_nat(64, carry) → carry + spec(eof_input(steps)) = total →
    LinuxRuns(io_linux(), eof_events(steps, ending, tail_events), state)
}

// The read, from the read label: the entry block runs, and the SYSCALL is
// fetched where the next step starts.
fn EofAsked(file: List<BitVec(8)>, page: Nat → BitVec(8), state: MachineState<IoMemory>) → Type {
    FetchedSteps(io_fetch_access(), io_data_access(), state, execute_block_normal(read_entry_block(), state)) ∧
    ((execute_block_normal(read_entry_block(), state).memory = IoMemory(file, page)) ∧
    ((execute_block_normal(read_entry_block(), state).rip = eof_rip(eof_at_call())) ∧
    LinuxSyscallAt(io_linux(), execute_block_normal(read_entry_block(), state))))
}
theorem eof_ask(file: List<BitVec(8)>, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail_code: List<BitVec(8)>,
    page: Nat → BitVec(8), here: EofPieces(IoMemory(file, page), needle, loop_bytes, jumps, tail_code),
    state: MachineState<IoMemory>, at_read: state.rip = eof_rip(eof_at_read()), memory_is: state.memory = IoMemory(file, page)):
    EofAsked(file, page, state) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let entered = block_fetched(fetch, data, read_entry_block(), state, trivial,
        resident_state(fetch, canonical_block_bytes(read_entry_block()), IoMemory(file, page), eof_rip(eof_at_read()),
            state, memory_is, at_read, here.entry_at));
    let asked = execute_block_normal(read_entry_block(), state);
    let asked_memory: (asked.memory = IoMemory(file, page)) = trans(pure_block_memory(read_entry_block(), state), memory_is);
    let asked_rip: (asked.rip = eof_rip(eof_at_call())) =
        trans(entered.right, rip_advance(entry, state.rip, eof_at_read(), read_entry_len(), at_read));
    ⟨entered.left, ⟨asked_memory, ⟨asked_rip, FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip,
        resident_state(fetch, linux_syscall_bytes(), IoMemory(file, page), eof_rip(eof_at_call()), asked,
            asked_memory, asked_rip, here.call_at)))⟩⟩⟩
}

// The loop, by recursion on the steps: every chunk is read and counted, every
// EINTR retried, and then the empty read runs the tail or the failure exits 1.
theorem eof_from(file: List<BitVec(8)>, p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(source, needle, spec),
    adds: (a, b: List<BitVec(8)>) → spec(a ++ b) = spec(a) + spec(b),
    jumps: EofJumps,
    exit_target: near_branch_target(eof_rip(eof_at_jz()), 6, jumps.ed) = eof_rip(eof_at_done(needle, loop_bytes)),
    js_target: near_branch_target(eof_rip(eof_at_js()), 6, jumps.sd) = eof_rip(eof_at_failed(needle, loop_bytes)),
    back_target: near_branch_target(eof_rip(eof_at_jmp(needle, loop_bytes)), 5, jumps.bd) = eof_rip(eof_at_read()),
    retry_target: near_branch_target(eof_rip(eof_at_retry(needle, loop_bytes)), 6, jumps.rd) = eof_rip(eof_at_read()),
    tail_code: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → EofPieces(IoMemory(file, page), needle, loop_bytes, jumps, tail_code),
    total: Nat, room: total + 4096 < Nat::pow(2, 64), tail_events: List<LinuxEvent>,
    tail: EofTail(file, needle, loop_bytes, total, tail_events), ending: ReadEnding, ending_ok: EofEnding(ending),
    chunks: List<ReadStep>):
    EofFrom(file, spec, total, ending, tail_events, chunks) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let spec_nil: (spec(Nil) = 0) = { let twice = adds(Nil, Nil); omega };
    match chunks as λ cs => EofFrom(file, spec, total, ending, tail_events, cs) {
        Nil => λ ok page carry state at_read memory_is carry_word counted =>
            (match ending as λ en => EofEnding(en) → LinuxRuns(io_linux(), eof_events(Nil, en, tail_events), state) {
                AtEnd => λ _ => {
            let here = pieces(page);
            let entered = block_fetched(fetch, data, read_entry_block(), state, trivial,
                resident_state(fetch, canonical_block_bytes(read_entry_block()), IoMemory(file, page), eof_rip(eof_at_read()),
                    state, memory_is, at_read, here.entry_at));
            let asked = execute_block_normal(read_entry_block(), state);
            let asked_memory: (asked.memory = IoMemory(file, page)) = trans(pure_block_memory(read_entry_block(), state), memory_is);
            let asked_rip: (asked.rip = eof_rip(eof_at_call())) =
                trans(entered.right, rip_advance(entry, state.rip, eof_at_read(), read_entry_len(), at_read));
            let writable: IoWritable(asked.memory, read_gpr(Rsi, asked.gprs), 0) =
                ⟨Nat::le_refl(io_page_base()), Nat::add_le_mono_l(io_page_base(), 0, 4096, trivial)⟩;
            linux_runs_read(io_linux(), state, asked, BitVec::ofNat(0), Nil, tail_events, entered.left,
                FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip,
                    resident_state(fetch, linux_syscall_bytes(), IoMemory(file, page), eof_rip(eof_at_call()), asked,
                        asked_memory, asked_rip, here.call_at))),
                refl, refl, trivial, writable,
                λ rcx r11 => {
                    let returned = linux_read_return(io_linux(), asked, Nil, rcx, r11);
                    let stored = io_store_offset(IoMemory(file, page), 0, Nil);
                    let returned_memory: (returned.memory = stored) =
                        cong_fn<IoMemory, IoMemory>(λ m => io_store(m, BitVec::ofNat(0x401000), Nil), asked_memory);
                    let returned_rip: (returned.rip = eof_rip(eof_at_test())) = rip_advance(entry, asked.rip, eof_at_call(), 2, asked_rip);
                    let there = pieces(stored.page);
                    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
                        resident_state(fetch, canonical_block_bytes(eof_test_block()), stored, eof_rip(eof_at_test()), returned,
                            returned_memory, returned_rip, there.test_at));
                    let tested = execute_block_normal(eof_test_block(), returned);
                    let tested_memory: (tested.memory = stored) = trans(pure_block_memory(eof_test_block(), returned), returned_memory);
                    let tested_rip: (tested.rip = eof_rip(eof_at_jz())) =
                        trans(test.right, rip_advance(entry, returned.rip, eof_at_test(), eof_test_len(), returned_rip));
                    let set: (tested.flags.zf = True) = test_self_zero(64, bitvec_nat::word_of_nat(64, 0), refl);
                    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.ed), tested,
                        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.ed)), stored, eof_rip(eof_at_jz()), tested,
                            tested_memory, tested_rip, there.jz_at));
                    let ended = execute_near_control(JumpZeroNear(jumps.ed), tested);
                    let ended_rip: (ended.rip = eof_rip(eof_at_done(needle, loop_bytes))) =
                        trans(near_taken_rip(jumps.ed, tested, set),
                            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.ed), tested_rip), exit_target));
                    let finished: (carry = total) = { omega };
                    let kept: (read_gpr(R13, ended.gprs) = bitvec_nat::word_of_nat(64, total)) =
                        trans(carry_word, cong_fn<Nat, BitVec(64)>(λ n => bitvec_nat::word_of_nat(64, n), finished));
                    linux_runs_after_steps(io_linux(), tail_events, returned, ended,
                        fetched_steps_trans(fetch, data, returned, tested, ended, test.left, fetched_steps_one(fetch, data, tested, ended, jz)),
                        tail(stored.page, ended, ended_rip, tested_memory, kept))
                })
        },
                FailedWith(errno) => λ bad => {
                    let asked = execute_block_normal(read_entry_block(), state);
                    let read = eof_ask(file, needle, loop_bytes, jumps, tail_code, page, pieces(page), state, at_read, memory_is);
                    let writable: IoWritable(asked.memory, read_gpr(Rsi, asked.gprs), read_gpr(Rdx, asked.gprs).toNat()) =
                        ⟨Nat::le_refl(io_page_base()), Nat::le_refl(io_page_base() + 4096)⟩;
                    linux_runs_read_failed(io_linux(), state, asked, BitVec::ofNat(0), errno, [ExitEvent(BitVec::ofNat(1))],
                        linux_steps_of_fetched(io_linux(), state, asked, read.left), read.right.right.right, refl, refl, bad.left, writable,
                        λ junk short rcx r11 => {
                            let returned = linux_read_failed_return(io_linux(), asked, errno, junk, rcx, r11);
                            let stored = io_store_offset(IoMemory(file, page), 0, junk);
                            let returned_memory: (returned.memory = stored) =
                                cong_fn<IoMemory, IoMemory>(λ m => io_store(m, BitVec::ofNat(0x401000), junk), read.right.left);
                            let returned_rip: (returned.rip = eof_rip(eof_at_test())) =
                                rip_advance(entry, asked.rip, eof_at_call(), 2, read.right.right.left);
                            let there = pieces(stored.page);
                            eof_fail_exit(stored, needle, loop_bytes, jumps, tail_code, there, errno, bad.left, bad.right, returned,
                                eof_failed(stored, needle, loop_bytes, jumps, tail_code, there, js_target, errno, bad.left, returned,
                                    returned_memory, returned_rip, refl))
                        })
                },
            })(ending_ok),
        Cons(step, rest) => (match step as λ st => EofFrom(file, spec, total, ending, tail_events, Cons(st, rest)) {
            Chunk(chunk) => λ ok page carry state at_read memory_is carry_word counted => {
            let here = pieces(page);
            let some: (0 < chunk.len()) = ok.left;
            let fits: (chunk.len() <= read_capacity()) = ok.right.left;
            let capped: (chunk.len() <= 4096) = fits;
            let parts = adds(chunk, eof_input(rest));
            let whole: (carry + spec(chunk ++ eof_input(rest)) = total) = counted;
            let sum: (carry + (spec(chunk) + spec(eof_input(rest))) = total) =
                trans(sym(cong_fn<Nat, Nat>(λ v => carry + v, parts)), whole);
            let room_here: (carry + chunk.len() < Nat::pow(2, 64)) =
                eof_room(carry, chunk.len(), spec(chunk), spec(eof_input(rest)), total, sum, capped, room);
            let entered = block_fetched(fetch, data, read_entry_block(), state, trivial,
                resident_state(fetch, canonical_block_bytes(read_entry_block()), IoMemory(file, page), eof_rip(eof_at_read()),
                    state, memory_is, at_read, here.entry_at));
            let asked = execute_block_normal(read_entry_block(), state);
            let asked_memory: (asked.memory = IoMemory(file, page)) = trans(pure_block_memory(read_entry_block(), state), memory_is);
            let asked_rip: (asked.rip = eof_rip(eof_at_call())) =
                trans(entered.right, rip_advance(entry, state.rip, eof_at_read(), read_entry_len(), at_read));
            let writable: IoWritable(asked.memory, read_gpr(Rsi, asked.gprs), chunk.len()) =
                ⟨Nat::le_refl(io_page_base()), Nat::add_le_mono_l(io_page_base(), chunk.len(), 4096, fits)⟩;
            linux_runs_read(io_linux(), state, asked, BitVec::ofNat(0), chunk, eof_events(rest, ending, tail_events), entered.left,
                FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip,
                    resident_state(fetch, linux_syscall_bytes(), IoMemory(file, page), eof_rip(eof_at_call()), asked,
                        asked_memory, asked_rip, here.call_at))),
                refl, refl, fits, writable,
                λ rcx r11 => {
                    let returned = linux_read_return(io_linux(), asked, chunk, rcx, r11);
                    let stored = io_store_offset(IoMemory(file, page), 0, chunk);
                    let returned_memory: (returned.memory = stored) =
                        cong_fn<IoMemory, IoMemory>(λ m => io_store(m, BitVec::ofNat(0x401000), chunk), asked_memory);
                    let returned_rip: (returned.rip = eof_rip(eof_at_test())) = rip_advance(entry, asked.rip, eof_at_call(), 2, asked_rip);
                    let there = pieces(stored.page);
                    let back = eof_chunk(file, page, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes,
                        jumps.ed, jumps.sd, jumps.bd, eof_at_read(), eof_at_test(), back_target, chunk, some, fits, carry, room_here, returned,
                        returned_memory, returned_rip, refl, carry_word,
                        there.test_at, there.jz_at, there.js_at, there.setup_at, there.loop_at, there.save_at, there.jmp_at);
                    let later: (carry + spec(chunk) + spec(eof_input(rest)) = total) =
                        eof_later(carry, spec(chunk), spec(eof_input(rest)), total, sum);
                    linux_runs_after_steps(io_linux(), eof_events(rest, ending, tail_events), returned, back.witness, back.proof.left,
                        eof_from(file, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes, adds,
                            jumps, exit_target, js_target, back_target, retry_target, tail_code, pieces, total, room, tail_events, tail,
                            ending, ending_ok, rest)(ok.right.right, stored.page, carry + spec(chunk), back.witness, back.proof.right.right.left,
                            back.proof.right.left, back.proof.right.right.right, later))
                })
        },
            Interrupted => λ ok page carry state at_read memory_is carry_word counted => {
                let asked = execute_block_normal(read_entry_block(), state);
                let read = eof_ask(file, needle, loop_bytes, jumps, tail_code, page, pieces(page), state, at_read, memory_is);
                let writable: IoWritable(asked.memory, read_gpr(Rsi, asked.gprs), read_gpr(Rdx, asked.gprs).toNat()) =
                    ⟨Nat::le_refl(io_page_base()), Nat::le_refl(io_page_base() + 4096)⟩;
                let eintr_errno: Errno(eintr()) = ⟨trivial, trivial⟩;
                linux_runs_read_failed(io_linux(), state, asked, BitVec::ofNat(0), eintr(), eof_events(rest, ending, tail_events),
                    linux_steps_of_fetched(io_linux(), state, asked, read.left), read.right.right.right, refl, refl, eintr_errno, writable,
                    λ junk short rcx r11 => {
                        let returned = linux_read_failed_return(io_linux(), asked, eintr(), junk, rcx, r11);
                        let stored = io_store_offset(IoMemory(file, page), 0, junk);
                        let returned_memory: (returned.memory = stored) =
                            cong_fn<IoMemory, IoMemory>(λ m => io_store(m, BitVec::ofNat(0x401000), junk), read.right.left);
                        let returned_rip: (returned.rip = eof_rip(eof_at_test())) =
                            rip_advance(entry, asked.rip, eof_at_call(), 2, read.right.right.left);
                        let there = pieces(stored.page);
                        let back = eof_retry(stored, needle, loop_bytes, jumps, tail_code, there, retry_target, returned,
                            eof_failed(stored, needle, loop_bytes, jumps, tail_code, there, js_target, eintr(), eintr_errno, returned,
                                returned_memory, returned_rip, refl));
                        let kept: (read_gpr(R13, back.witness.gprs) = bitvec_nat::word_of_nat(64, carry)) =
                            trans(back.proof.right.right.right, carry_word);
                        linux_runs_after_steps(io_linux(), eof_events(rest, ending, tail_events), returned, back.witness, back.proof.left,
                            eof_from(file, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes, adds,
                                jumps, exit_target, js_target, back_target, retry_target, tail_code, pieces, total, room, tail_events, tail,
                                ending, ending_ok, rest)(ok, stored.page, carry, back.witness, back.proof.right.right.left,
                                back.proof.right.left, kept, counted))
                    })
            },
        }),
    }
}

// ---------------------------------------------------------------------------
// The four jumps' targets, from a closed fact about each displacement that the
// producer proves at the written bytes.

theorem eof_skip_sum(z, s, l, v: Nat): z + (6 + (((s + l) + v) + 5)) = ((((z + 6) + s) + l) + v) + 5 { omega }
theorem eof_exit_sum(z, s, l, v, r, f: Nat):
    z + (6 + ((((((((6 + s) + l) + v) + 5) + r) + 6) + f) + 2)) = (((((((((z + 6) + 6) + s) + l) + v) + 5) + r) + 6) + f) + 2 { omega }
theorem eof_back_sum(r, e, t, s, l, v: Nat):
    r + (((((((e + 2) + t) + 6) + 6) + s) + l) + v) = (((((((r + e) + 2) + t) + 6) + 6) + s) + l) + v { omega }
theorem eof_retry_sum(r, e, t, s, l, v, q: Nat):
    r + (((((((((e + 2) + t) + 6) + 6) + s) + l) + v) + 5) + q) = (((((((((r + e) + 2) + t) + 6) + 6) + s) + l) + v) + 5) + q { omega }

// What JZ skips at end of file: the JS, the chunk, and the failure path.
fn eof_exit_skip(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat {
    (((((((6 + eof_setup_len(needle)) + loop_bytes.len()) + eof_save_len()) + 5) + eof_retry_len()) + 6) + eof_fail_len()) + 2
}
// What JS skips on a failed read: the chunk's setup, loop, save and jump back.
fn eof_fail_skip(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat {
    ((eof_setup_len(needle) + loop_bytes.len()) + eof_save_len()) + 5
}

theorem eof_exit_target(needle: BitVec(8), loop_bytes: List<BitVec(8)>, ed: BitVec(32),
    reads: ed.sign_extend(32).toNat() = eof_exit_skip(needle, loop_bytes)):
    near_branch_target(eof_rip(eof_at_jz()), 6, ed) = eof_rip(eof_at_done(needle, loop_bytes)) {
    let skip = eof_exit_skip(needle, loop_bytes);
    let lands: (eof_at_jz() + (6 + skip) = eof_at_done(needle, loop_bytes)) =
        eof_exit_sum(eof_at_jz(), eof_setup_len(needle), loop_bytes.len(), eof_save_len(), eof_retry_len(), eof_fail_len());
    trans(near_branch_forward(eof_rip(eof_at_jz()), 6, skip, ed, reads),
        trans(rip_compose(BitVec::ofNat(0x4000e8), eof_at_jz(), 6 + skip), rip_count(BitVec::ofNat(0x4000e8), lands)))
}

theorem eof_js_target(needle: BitVec(8), loop_bytes: List<BitVec(8)>, sd: BitVec(32),
    reads: sd.sign_extend(32).toNat() = eof_fail_skip(needle, loop_bytes)):
    near_branch_target(eof_rip(eof_at_js()), 6, sd) = eof_rip(eof_at_failed(needle, loop_bytes)) {
    let skip = eof_fail_skip(needle, loop_bytes);
    let lands: (eof_at_js() + (6 + skip) = eof_at_failed(needle, loop_bytes)) =
        eof_skip_sum(eof_at_js(), eof_setup_len(needle), loop_bytes.len(), eof_save_len());
    trans(near_branch_forward(eof_rip(eof_at_js()), 6, skip, sd, reads),
        trans(rip_compose(BitVec::ofNat(0x4000e8), eof_at_js(), 6 + skip), rip_count(BitVec::ofNat(0x4000e8), lands)))
}

// From the read to the end of the jump back, and to the retry's JZ.
fn eof_loop_span(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat {
    ((((((read_entry_len() + 2) + eof_test_len()) + 6) + 6) + eof_setup_len(needle)) + loop_bytes.len()) + eof_save_len()
}
fn eof_retry_span(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat {
    (eof_loop_span(needle, loop_bytes) + 5) + eof_retry_len()
}

// JMP returns to the read: its displacement completes the span to 2^64.
theorem eof_back_target(needle: BitVec(8), loop_bytes: List<BitVec(8)>, bd: BitVec(32),
    closes: eof_loop_span(needle, loop_bytes) + 5 + bd.sign_extend(32).toNat() = Nat::pow(2, 64)):
    near_branch_target(eof_rip(eof_at_jmp(needle, loop_bytes)), 5, bd) = eof_rip(eof_at_read()) {
    let at_jmp: (eof_rip(eof_at_jmp(needle, loop_bytes)) = next_rip(eof_rip(eof_at_read()), eof_loop_span(needle, loop_bytes))) =
        trans(rip_count(BitVec::ofNat(0x4000e8), sym(eof_back_sum(eof_at_read(), read_entry_len(), eof_test_len(), eof_setup_len(needle),
            loop_bytes.len(), eof_save_len()))), sym(rip_compose(BitVec::ofNat(0x4000e8), eof_at_read(), eof_loop_span(needle, loop_bytes))));
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, bd), at_jmp),
        near_branch_returns(eof_rip(eof_at_read()), eof_loop_span(needle, loop_bytes), 5, bd, closes))
}

// The retry's JZ returns to the read the same way.
theorem eof_retry_target(needle: BitVec(8), loop_bytes: List<BitVec(8)>, rd: BitVec(32),
    closes: eof_retry_span(needle, loop_bytes) + 6 + rd.sign_extend(32).toNat() = Nat::pow(2, 64)):
    near_branch_target(eof_rip(eof_at_retry(needle, loop_bytes)), 6, rd) = eof_rip(eof_at_read()) {
    let at_retry: (eof_rip(eof_at_retry(needle, loop_bytes)) = next_rip(eof_rip(eof_at_read()), eof_retry_span(needle, loop_bytes))) =
        trans(rip_count(BitVec::ofNat(0x4000e8), sym(eof_retry_sum(eof_at_read(), read_entry_len(), eof_test_len(), eof_setup_len(needle),
            loop_bytes.len(), eof_save_len(), eof_retry_len()))),
            sym(rip_compose(BitVec::ofNat(0x4000e8), eof_at_read(), eof_retry_span(needle, loop_bytes))));
    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, rd), at_retry),
        near_branch_returns(eof_rip(eof_at_read()), eof_retry_span(needle, loop_bytes), 6, rd, closes))
}

// ---------------------------------------------------------------------------
// The exit profile.

// From the tail, the total in R13: exit(total).
theorem eof_exit_tail(file: List<BitVec(8)>, needle: BitVec(8), loop_bytes: List<BitVec(8)>, total: Nat,
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), eof_exit_code(),
        eof_rip(eof_at_done(needle, loop_bytes)))):
    EofTail(file, needle, loop_bytes, total, [ExitEvent(bitvec_nat::word_of_nat(64, total))]) {
    λ page state at_done memory_is total_word => {
        let fetch = io_fetch_access();
        let data = io_data_access();
        let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
        let x = canonical_block_bytes(eof_exit_block());
        let parts = resident_split_at(fetch, IoMemory(file, page), x, linux_syscall_bytes(), entry, eof_at_done(needle, loop_bytes), resident(page));
        let exited = block_fetched(fetch, data, eof_exit_block(), state, trivial,
            resident_state(fetch, x, IoMemory(file, page), eof_rip(eof_at_done(needle, loop_bytes)), state, memory_is, at_done, parts.left));
        let last = execute_block_normal(eof_exit_block(), state);
        let last_memory: (last.memory = IoMemory(file, page)) = trans(pure_block_memory(eof_exit_block(), state), memory_is);
        let last_rip: (last.rip = eof_rip(eof_at_done(needle, loop_bytes) + eof_exit_len())) =
            trans(exited.right, rip_advance(entry, state.rip, eof_at_done(needle, loop_bytes), eof_exit_len(), at_done));
        let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
            resident_state(fetch, linux_syscall_bytes(), IoMemory(file, page), eof_rip(eof_at_done(needle, loop_bytes) + eof_exit_len()),
                last, last_memory, last_rip, parts.right)));
        linux_runs_exit(io_linux(), state, last, bitvec_nat::word_of_nat(64, total), exited.left, call, refl, total_word)
    }
}

// Init, then the loop from a zero total.
theorem eof_start(file: List<BitVec(8)>, p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(source, needle, spec),
    adds: (a, b: List<BitVec(8)>) → spec(a ++ b) = spec(a) + spec(b),
    jumps: EofJumps,
    exit_target: near_branch_target(eof_rip(eof_at_jz()), 6, jumps.ed) = eof_rip(eof_at_done(needle, loop_bytes)),
    js_target: near_branch_target(eof_rip(eof_at_js()), 6, jumps.sd) = eof_rip(eof_at_failed(needle, loop_bytes)),
    back_target: near_branch_target(eof_rip(eof_at_jmp(needle, loop_bytes)), 5, jumps.bd) = eof_rip(eof_at_read()),
    retry_target: near_branch_target(eof_rip(eof_at_retry(needle, loop_bytes)), 6, jumps.rd) = eof_rip(eof_at_read()),
    tail_code: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → EofPieces(IoMemory(file, page), needle, loop_bytes, jumps, tail_code),
    chunks: List<ReadStep>, ok: EofChunks(chunks), ending: ReadEnding, ending_ok: EofEnding(ending),
    room: spec(eof_input(chunks)) + 4096 < Nat::pow(2, 64),
    tail_events: List<LinuxEvent>, tail: EofTail(file, needle, loop_bytes, spec(eof_input(chunks)), tail_events),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending, tail_events), io_initial(file, page, gprs, flags)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let start = io_initial(file, page, gprs, flags);
    let started = block_fetched(fetch, data, eof_init_block(), start, trivial, pieces(page).init_at);
    let ready = execute_block_normal(eof_init_block(), start);
    linux_runs_after_steps(io_linux(), eof_events(chunks, ending, tail_events), start, ready, started.left,
        eof_from(file, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes, adds,
            jumps, exit_target, js_target, back_target, retry_target, tail_code, pieces, spec(eof_input(chunks)), room, tail_events, tail,
            ending, ending_ok, chunks)(
            ok, page, 0, ready, started.right, refl, refl, Nat::add_left_zero(spec(eof_input(chunks)))))
}

// The process claim: for every way the reads may split the input into
// non-empty chunks, with EINTRs anywhere between them, ending at the empty
// read or at a failed read, the file has a run that reads them all, retries
// every EINTR, and then exits with the specification's count of the chunks'
// concatenation or, after the failure, with 1.
theorem read_loop_runs(file: List<BitVec(8)>, p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(source, needle, spec),
    adds: (a, b: List<BitVec(8)>) → spec(a ++ b) = spec(a) + spec(b),
    jumps: EofJumps,
    exit_reads: jumps.ed.sign_extend(32).toNat() = eof_exit_skip(needle, loop_bytes),
    fail_reads: jumps.sd.sign_extend(32).toNat() = eof_fail_skip(needle, loop_bytes),
    back_closes: eof_loop_span(needle, loop_bytes) + 5 + jumps.bd.sign_extend(32).toNat() = Nat::pow(2, 64),
    retry_closes: eof_retry_span(needle, loop_bytes) + 6 + jumps.rd.sign_extend(32).toNat() = Nat::pow(2, 64),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), read_loop_code(needle, loop_bytes, jumps),
        BitVec::ofNat(0x4000e8)),
    chunks: List<ReadStep>, ok: EofChunks(chunks), ending: ReadEnding, ending_ok: EofEnding(ending),
    room: spec(eof_input(chunks)) + 4096 < Nat::pow(2, 64),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending, [ExitEvent(bitvec_nat::word_of_nat(64, spec(eof_input(chunks))))]),
        io_initial(file, page, gprs, flags)) {
    let pieces = λ (page: Nat → BitVec(8)) => eof_pieces(IoMemory(file, page), needle, loop_bytes, jumps, eof_exit_code(), resident(page));
    eof_start(file, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes, adds, jumps,
        eof_exit_target(needle, loop_bytes, jumps.ed, exit_reads), eof_js_target(needle, loop_bytes, jumps.sd, fail_reads),
        eof_back_target(needle, loop_bytes, jumps.bd, back_closes), eof_retry_target(needle, loop_bytes, jumps.rd, retry_closes),
        eof_exit_code(), pieces, chunks, ok, ending, ending_ok, room, [ExitEvent(bitvec_nat::word_of_nat(64, spec(eof_input(chunks))))],
        eof_exit_tail(file, needle, loop_bytes, spec(eof_input(chunks)), λ page => pieces(page).tail_at), page, gprs, flags)
}

// A file of the call profile's shape, a 232-byte header then the program:
// the program is resident at the entry (elf64_io's io_code_resident).
theorem eof_file_resident(header, code: List<BitVec(8)>, header_length: header.len() = 232, fits: 232 + code.len() <= 4096):
    (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(header ++ code, page), code, BitVec::ofNat(0x4000e8)) {
    λ page => {
        let placed = io_code_resident(header, code, page, j(sym(header_length), λ n _ => n + code.len() <= 4096, fits));
        let entry: (bitvec_nat::word_of_nat(64, 0x400000 + header.len()) = BitVec::ofNat(0x4000e8)) =
            trans(cong_fn<Nat, BitVec(64)>(λ n => bitvec_nat::word_of_nat(64, 0x400000 + n), header_length),
                bitvec_nat::word_of_nat_toNat(64, BitVec::ofNat(0x4000e8)));
        j(entry, λ at _ => CodeResident(io_fetch_access(), IoMemory(header ++ code, page), code, at), placed)
    }
}

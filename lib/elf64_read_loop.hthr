// The read-once process shape (docs/native-first-program-design.md §5): read
// stdin once into the page, run a certified counting loop over what arrived,
// exit with its count. Nothing here is about any one program: the loop, its
// source function, and the specification its count meets are parameters,
// and a program supplies its loop certificate and one fact about its source.
// The profile fixes the loop's head registers (base RDI, length RBP, needle
// RCX, cursor RSI, budget R12, carry R11), as the exit profile fixes RDI.
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// How much one read asks for: the whole page. The claim covers every length
// the read may return, so this is also its input bound.
fn read_capacity() → Nat { 4096 }

// read(0, page, capacity).
fn read_entry_block() → List<Instruction> {
    [MovRI(Rax, BitVec::ofNat(0)), MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rsi, BitVec::ofNat(0x401000)),
     MovRI(Rdx, BitVec::ofNat(read_capacity()))]
}
// The loop's head from what the read returned: the count in RAX is both the
// length and the budget; cursor and count start at zero.
fn read_setup_block(needle: BitVec(8)) → List<Instruction> {
    [MovRR(Rbp, Rax), MovRR(R12, Rax), MovRI(Rdi, BitVec::ofNat(0x401000)), MovRI(Rcx, needle.zero_extend(56)),
     MovRI(Rsi, BitVec::ofNat(0)), MovRI(R11, BitVec::ofNat(0))]
}
// exit(count).
fn read_exit_block() → List<Instruction> { [MovRR(Rdi, R11), MovRI(Rax, BitVec::ofNat(60))] }

fn read_loop_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → List<BitVec(8)> {
    canonical_block_bytes(read_entry_block()) ++ (linux_syscall_bytes() ++
        (canonical_block_bytes(read_setup_block(needle)) ++ (loop_bytes ++
        (canonical_block_bytes(read_exit_block()) ++ linux_syscall_bytes()))))
}

fn read_entry_len() → Nat { canonical_block_bytes(read_entry_block()).len() }
fn read_setup_len(needle: BitVec(8)) → Nat { canonical_block_bytes(read_setup_block(needle)).len() }
fn read_exit_len() → Nat { canonical_block_bytes(read_exit_block()).len() }

// The program's pieces, resident at their offsets from the entry.
record ReadLoopResident(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>) {
    entry_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(read_entry_block()), BitVec::ofNat(0x4000e8)),
    read_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(),
        next_rip(BitVec::ofNat(0x4000e8), 0 + read_entry_len())),
    setup_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(read_setup_block(needle)),
        next_rip(BitVec::ofNat(0x4000e8), (0 + read_entry_len()) + 2)),
    loop_at: CodeResident(io_fetch_access(), memory, loop_bytes,
        next_rip(BitVec::ofNat(0x4000e8), ((0 + read_entry_len()) + 2) + read_setup_len(needle))),
    exit_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(read_exit_block()),
        next_rip(BitVec::ofNat(0x4000e8), (((0 + read_entry_len()) + 2) + read_setup_len(needle)) + loop_bytes.len())),
    exit_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(),
        next_rip(BitVec::ofNat(0x4000e8), ((((0 + read_entry_len()) + 2) + read_setup_len(needle)) + loop_bytes.len()) + read_exit_len())),
}

theorem read_loop_resident(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>,
    resident: CodeResident(io_fetch_access(), memory, read_loop_code(needle, loop_bytes), BitVec::ofNat(0x4000e8))):
    ReadLoopResident(memory, needle, loop_bytes) {
    let fetch = io_fetch_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let e = canonical_block_bytes(read_entry_block());
    let call = linux_syscall_bytes();
    let s = canonical_block_bytes(read_setup_block(needle));
    let x = canonical_block_bytes(read_exit_block());
    let r0 = resident_split_at(fetch, memory, e, call ++ (s ++ (loop_bytes ++ (x ++ call))), entry, 0, resident);
    let r1 = resident_split_at(fetch, memory, call, s ++ (loop_bytes ++ (x ++ call)), entry, 0 + e.len(), r0.right);
    let r2 = resident_split_at(fetch, memory, s, loop_bytes ++ (x ++ call), entry, (0 + e.len()) + 2, r1.right);
    let r3 = resident_split_at(fetch, memory, loop_bytes, x ++ call, entry, ((0 + e.len()) + 2) + s.len(), r2.right);
    let r4 = resident_split_at(fetch, memory, x, call, entry, (((0 + e.len()) + 2) + s.len()) + loop_bytes.len(), r3.right);
    ReadLoopResident(r0.left, r1.left, r2.left, r3.left, r4.left, r4.right)
}

theorem nth_some_below<A>(xs: List<A>, i: Nat, x: A, present: xs.nth(i) = Some(x)): i < xs.len() {
    Nat::lt_of_not_le(i, xs.len(), λ past => absurd(trans(sym(present), xs.nth_past_end(i, past))))
}

// The profile's head registers, as the loop certificate's placement names them.
record ReadLoopPlacement(p: LoopPlacement) {
    base: p.base = Rdi, length: p.length = Rbp, needle: p.needle = Rcx,
    cursor: p.cursor = Rsi, budget: p.budget = R12, carry: p.carry = R11,
}

// A certified Nat-carry loop, as the loop generator publishes one, over this
// profile's memory.
fn ReadLoopCertificate(p: LoopPlacement, region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>) → Type {
    (access: ByteReadAccess<IoMemory>) → (before: MachineState<IoMemory>) → (buffer: ReadonlyBytes) →
    (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
    LoopAddressBound(64, buffer) → buffer.base + buffer.length <= Nat::pow(2, 47) →
    LoopHead<IoMemory, Nat>(p, loop_nat_rep, access, buffer, needle, before, cursor, budget, carry) →
    LoopReadable(budget, region, buffer, needle, cursor, carry) → loop_fits(cursor, budget, carry) →
    Exists<MachineState<IoMemory>>(λ after => AccessArtifact<IoMemory>(access, loop_code, loop_bytes, before, after) ∧
        LoopObserved<IoMemory, Nat>(p, loop_nat_rep, after, source(buffer, needle, budget, cursor, carry)))
}

// The one fact a program proves about its own source: over a buffer holding
// `bytes`, the loop from the start computes `spec(bytes)`.
fn ReadLoopComputes(source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8),
    spec: List<BitVec(8)> → Nat) → Type {
    (bytes: List<BitVec(8)>) → (buffer: ReadonlyBytes) → buffer.length = bytes.len() →
    ((i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → buffer.read(buffer.base + i) = Some(byte)) →
    source(buffer, needle, bytes.len(), 0, 0) = End(bytes.len(), 0, spec(bytes))
}

fn read_after_setup(needle: BitVec(8), state: MachineState<IoMemory>) → MachineState<IoMemory> {
    execute_block_normal(read_setup_block(needle), state)
}

theorem read_loop_head(p: LoopPlacement, at: ReadLoopPlacement(p), needle: BitVec(8), bytes: List<BitVec(8)>,
    fits: bytes.len() <= 4096, state: MachineState<IoMemory>,
    length_word: read_gpr(Rax, state.gprs) = bitvec_nat::word_of_nat(64, bytes.len())):
    LoopHead<IoMemory, Nat>(p, loop_nat_rep, io_data_access(), io_buffer(state.memory, bytes.len()), needle,
        read_after_setup(needle, state), 0, bytes.len(), 0) {
    let ready = read_after_setup(needle, state);
    let n = bytes.len();
    let below: (n < Nat::pow(2, 64)) = Succ(n).le_trans(4097, Nat::pow(2, 64), fits, Nat::leb_sound(4097, Nat::pow(2, 64), trivial));
    let counted: (read_gpr(Rbp, ready.gprs).toNat() = n) =
        trans(cong_fn<BitVec(64), Nat>(λ word => word.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, n, below));
    let budgeted: (read_gpr(R12, ready.gprs).toNat() = n) = counted;
    LoopHead(
        base_placed := j(sym(at.base), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), io_page_base()), refl),
        length_placed := j(sym(at.length), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), counted),
        needle_placed := j(sym(at.needle), λ r _ => read_gpr(r, ready.gprs) = needle.zero_extend(56), refl),
        cursor_placed := j(sym(at.cursor), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), 0), refl),
        budget_placed := j(sym(at.budget), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), budgeted),
        carry_placed := j(sym(at.carry), λ r _ => loop_nat_rep(read_gpr(r, ready.gprs), 0), refl),
        inside := trivial,
        memory_agrees := λ word => io_buffer_agrees(state.memory, n, word))
}

// After the read returned `bytes`: set up, loop, exit with the count. The
// state is the read's return, with the facts about it the rule fixes.
theorem read_loop_after_read(file: List<BitVec(8)>, page: Nat → BitVec(8), p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadLoopComputes(source, needle, spec),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), read_loop_code(needle, loop_bytes), BitVec::ofNat(0x4000e8)),
    bytes: List<BitVec(8)>, fits: bytes.len() <= read_capacity(), returned: MachineState<IoMemory>,
    memory_is: returned.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: returned.rip = next_rip(BitVec::ofNat(0x4000e8), (0 + read_entry_len()) + 2),
    length_word: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, bytes.len())):
    LinuxRuns(io_linux(), [ExitEvent(bitvec_nat::word_of_nat(64, spec(bytes)))], returned) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let n = bytes.len();
    let capped: (n <= 4096) = fits;
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let pieces = read_loop_resident(stored, needle, loop_bytes, resident(stored.page));
    let at_setup = (0 + read_entry_len()) + 2;
    let at_loop = at_setup + read_setup_len(needle);
    let at_exit = at_loop + loop_bytes.len();
    // Set up the loop's head.
    let setup = block_fetched(fetch, data, read_setup_block(needle), returned, trivial,
        resident_state(fetch, canonical_block_bytes(read_setup_block(needle)), stored, next_rip(entry, at_setup),
            returned, memory_is, rip_is, pieces.setup_at));
    let ready = read_after_setup(needle, returned);
    let ready_memory: (ready.memory = stored) = trans(pure_block_memory(read_setup_block(needle), returned), memory_is);
    let ready_rip: (ready.rip = next_rip(entry, at_loop)) =
        trans(setup.right, rip_advance(entry, returned.rip, at_setup, read_setup_len(needle), rip_is));
    let buffer = io_buffer(returned.memory, n);
    let reads = λ (i: Nat) (byte: BitVec(8)) (present: bytes.nth(i) = Some(byte)) =>
        j(sym(memory_is), λ memory _ => io_read(memory, bitvec_nat::word_of_nat(64, io_page_base() + i)) = Some(byte),
            io_read_stored(IoMemory(file, page), bytes, i, byte,
                Succ(i).le_trans(n, 4096, nth_some_below(bytes, i, byte, present), fits), present));
    let computed = computes(bytes, buffer, refl, reads);
    let readable: LoopReadable(n, region, buffer, needle, 0, 0) =
        j(sym(trans(agreement(buffer, needle, n, 0, 0), computed)), λ outcome _ => LoopFinishedNormally(outcome), trivial);
    let within: (Succ(io_page_base() + n) <= io_page_base() + 4097) = omega;
    let bounded: LoopAddressBound(64, buffer) =
        Succ(io_page_base() + n).le_trans(io_page_base() + 4097, Nat::pow(2, 64), within,
            Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial));
    let low: (buffer.base + buffer.length <= Nat::pow(2, 47)) =
        (io_page_base() + n).le_trans(io_page_base() + 4096, Nat::pow(2, 47), Nat::add_le_mono_l(io_page_base(), n, 4096, fits),
            Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial));
    let small: (0 + n <= 4096) = j(sym(Nat::add_left_zero(n)), λ k _ => k <= 4096, fits);
    let counted: loop_fits(0, n, 0) = Succ(0 + n).le_trans(4097, Nat::pow(2, 64), small, Nat::leb_sound(4097, Nat::pow(2, 64), trivial));
    // The loop.
    let ran = native(data, ready, buffer, needle, n, 0, 0, bounded, low,
        read_loop_head(p, at, needle, bytes, fits, returned, length_word), readable, counted);
    let done = ran.witness;
    let looped = access_artifact_fetched(fetch, data, loop_code, loop_bytes, ready, done, ran.proof.left,
        resident_state(fetch, loop_bytes, stored, next_rip(entry, at_loop), ready, ready_memory, ready_rip, pieces.loop_at));
    let done_memory: (done.memory = stored) = trans(access_memory(data, loop_code, ready, done, ran.proof.left.execution), ready_memory);
    let done_rip: (done.rip = next_rip(entry, at_exit)) =
        trans(looped.right, rip_advance(entry, ready.rip, at_loop, loop_bytes.len(), ready_rip));
    let observed = j(computed, λ outcome _ => LoopObserved<IoMemory, Nat>(p, loop_nat_rep, done, outcome), ran.proof.right);
    let carried: (read_gpr(R11, done.gprs).toNat() = spec(bytes)) =
        j(at.carry, λ r _ => read_gpr(r, done.gprs).toNat() = spec(bytes), observed.right.right.right);
    // exit(count).
    let exited = block_fetched(fetch, data, read_exit_block(), done, trivial,
        resident_state(fetch, canonical_block_bytes(read_exit_block()), stored, next_rip(entry, at_exit), done,
            done_memory, done_rip, pieces.exit_at));
    let last = execute_block_normal(read_exit_block(), done);
    let last_memory: (last.memory = stored) = trans(pure_block_memory(read_exit_block(), done), done_memory);
    let last_rip: (last.rip = next_rip(entry, at_exit + read_exit_len())) =
        trans(exited.right, rip_advance(entry, done.rip, at_exit, read_exit_len(), done_rip));
    let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
        resident_state(fetch, linux_syscall_bytes(), stored, next_rip(entry, at_exit + read_exit_len()), last,
            last_memory, last_rip, pieces.exit_call_at)));
    let status: (read_gpr(Rdi, last.gprs) = bitvec_nat::word_of_nat(64, spec(bytes))) =
        trans(sym(bitvec_nat::word_of_nat_toNat(64, read_gpr(R11, done.gprs))),
            cong_fn<Nat, BitVec(64)>(λ count => bitvec_nat::word_of_nat(64, count), carried));
    linux_runs_exit(io_linux(), returned, last, bitvec_nat::word_of_nat(64, spec(bytes)),
        fetched_steps_trans(fetch, data, returned, ready, last, setup.left,
            fetched_steps_trans(fetch, data, ready, done, last, looped.left, exited.left)),
        call, refl, status)
}

// The process claim: for every input a successful read may return, the file
// has a run that reads it and exits with the specification's count.
theorem read_loop_runs(file: List<BitVec(8)>, p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadLoopComputes(source, needle, spec),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), read_loop_code(needle, loop_bytes), BitVec::ofNat(0x4000e8)),
    bytes: List<BitVec(8)>, fits: bytes.len() <= read_capacity(), page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), [ReadEvent(BitVec::ofNat(0), bytes), ExitEvent(bitvec_nat::word_of_nat(64, spec(bytes)))],
        io_initial(file, page, gprs, flags)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let start = io_initial(file, page, gprs, flags);
    let pieces = read_loop_resident(IoMemory(file, page), needle, loop_bytes, resident(page));
    let entered = block_fetched(fetch, data, read_entry_block(), start, trivial, pieces.entry_at);
    let asked = execute_block_normal(read_entry_block(), start);
    let writable: IoWritable(asked.memory, read_gpr(Rsi, asked.gprs), bytes.len()) =
        ⟨Nat::le_refl(io_page_base()), Nat::add_le_mono_l(io_page_base(), bytes.len(), 4096, fits)⟩;
    linux_runs_read(io_linux(), start, asked, BitVec::ofNat(0), bytes, [ExitEvent(bitvec_nat::word_of_nat(64, spec(bytes)))],
        entered.left, FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip, pieces.read_at)),
        refl, refl, fits, writable,
        λ rcx r11 => read_loop_after_read(file, page, p, at, region, loop_code, loop_bytes, source, needle, spec,
            agreement, native, computes, resident, bytes, fits, linux_read_return(io_linux(), asked, bytes, rcx, r11),
            refl, refl, refl))
}

// A file of the call profile's shape, a 232-byte header then the program:
// the program is resident at the entry (elf64_io's io_code_resident).
theorem read_loop_file_resident(header: List<BitVec(8)>, needle: BitVec(8), loop_bytes: List<BitVec(8)>,
    header_length: header.len() = 232, fits: 232 + read_loop_code(needle, loop_bytes).len() <= 4096):
    (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(header ++ read_loop_code(needle, loop_bytes), page),
        read_loop_code(needle, loop_bytes), BitVec::ofNat(0x4000e8)) {
    λ page => {
        let placed = io_code_resident(header, read_loop_code(needle, loop_bytes), page,
            j(sym(header_length), λ n _ => n + read_loop_code(needle, loop_bytes).len() <= 4096, fits));
        let entry: (bitvec_nat::word_of_nat(64, 0x400000 + header.len()) = BitVec::ofNat(0x4000e8)) =
            trans(cong_fn<Nat, BitVec(64)>(λ n => bitvec_nat::word_of_nat(64, 0x400000 + n), header_length),
                bitvec_nat::word_of_nat_toNat(64, BitVec::ofNat(0x4000e8)));
        j(entry, λ at _ => CodeResident(io_fetch_access(), IoMemory(header ++ read_loop_code(needle, loop_bytes), page),
            read_loop_code(needle, loop_bytes), at), placed)
    }
}

// The program spelled as the pieces a producer writes: each fixed block's
// bytes, the two SYSCALLs, and the loop's.
theorem read_loop_code_spelled(needle: BitVec(8), loop_bytes, entry, setup, exit: List<BitVec(8)>,
    entry_is: canonical_block_bytes(read_entry_block()) = entry,
    setup_is: canonical_block_bytes(read_setup_block(needle)) = setup,
    exit_is: canonical_block_bytes(read_exit_block()) = exit):
    read_loop_code(needle, loop_bytes) =
        entry ++ (linux_syscall_bytes() ++ (setup ++ (loop_bytes ++ (exit ++ linux_syscall_bytes())))) {
    j(entry_is, λ e _ => read_loop_code(needle, loop_bytes) =
            e ++ (linux_syscall_bytes() ++ (setup ++ (loop_bytes ++ (exit ++ linux_syscall_bytes())))),
        j(setup_is, λ s _ => read_loop_code(needle, loop_bytes) =
                canonical_block_bytes(read_entry_block()) ++ (linux_syscall_bytes() ++ (s ++ (loop_bytes ++ (exit ++ linux_syscall_bytes())))),
            j(exit_is, λ x _ => read_loop_code(needle, loop_bytes) =
                    canonical_block_bytes(read_entry_block()) ++ (linux_syscall_bytes() ++
                        (canonical_block_bytes(read_setup_block(needle)) ++ (loop_bytes ++ (x ++ linux_syscall_bytes())))),
                refl)))
}

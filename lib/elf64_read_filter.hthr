// The read profile's one process (docs/native-stream-filter-design.md §4): a
// stream filter. Read stdin a page at a time; run the program's step over
// each byte of the chunk, the state in its registers (R13, R14, R15, R8) and
// whatever the byte emits stored behind the read cursor in the same page;
// write what the chunk emitted, if anything, and read again; at end of file
// run the program's finish. Failed reads and writes are elf64_read_pieces's
// and elf64_write_loop's: EINTR retries, anything else exits 1. The step is
// the program's, a generated piece (filter_step_piece's `StepPiece`); the
// loop around it, the process and the claim are proved here once.
import filter_step_piece;
import stream_filter;
import elf64_write_loop;
import elf64_print_pieces;
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_asm;
import elf64_runs;
import elf64_stretch;
import x86_64_structured_block;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The code.

// After a read of n > 0 bytes: the read cursor at the page, n to go, the
// write cursor at the page, and the step's 1.
fn filter_setup_block() → List<Instruction> {
    [MovRI(Rsi, BitVec::ofNat(io_page_base())), MovRR(Rcx, Rax), MovRI(Rdi, BitVec::ofNat(io_page_base())), MovRI(R12, BitVec::ofNat(1))]
}
fn filter_load() → ByteLoad { ByteLoad(destination := Rax, base := Rsi) }
// The emitted byte, stored at the write cursor whether or not it is emitted:
// the cursor never passes the byte just loaded, so nothing still to be read
// is overwritten, and the flag says whether the cursor moves past it.
fn filter_store() → ByteStore { ByteStore(base := Rdi, source := Rdx) }
// The write cursor on by the flag, the read cursor on by one, one fewer to
// go; ZF says whether none is.
fn filter_advance_block() → List<Instruction> { [AddRR(Rdi, Rbx), AddRR(Rsi, R12), SubRR(Rcx, R12)] }
// The chunk's output for the write loop: from the page, as long as the write
// cursor has moved; ZF says whether it is empty.
fn filter_close_block() → List<Instruction> {
    [MovRR(R10, Rdi), MovRI(R9, BitVec::ofNat(io_page_base())), SubRR(R10, R9)]
}

// The jumps: JZ to the finish at end of file, JS to the failure path, JZ
// back to the read when a chunk emitted nothing, JZ back to the read after
// EINTR. The JNZ back to the next byte is the loop program's own.
record FilterJumps { ed: BitVec(32), sd: BitVec(32), cd: BitVec(32), rd: BitVec(32) }

// The loop over the chunk as a program (x86_64_asm), the step its hole, `p`
// bytes long: the setup, then load, step, store, advance and JNZ back to
// the load while bytes are left, then the close.
fn tf_load() → Nat { 1 }
fn lf_setup() → Prog { then(Start, Block(filter_setup_block())) }
fn lf_load() → Prog { At(lf_setup(), tf_load(), LoadByte(filter_load())) }
fn lf_step(p: Nat) → Prog { then(lf_load(), Hole(0, p)) }
fn lf_store(p: Nat) → Prog { then(lf_step(p), StoreByte(filter_store())) }
fn lf_advance(p: Nat) → Prog { then(lf_store(p), Block(filter_advance_block())) }
fn lf_jnz(p: Nat) → Prog { then(lf_advance(p), Jcc(NE, tf_load())) }
fn lf_close(p: Nat) → Prog { then(lf_jnz(p), Block(filter_close_block())) }
fn loop_prog(p: Nat) → Prog { lf_close(p) }
fn loop_labels(p: Nat) → Nat → Nat { asm_labels(loop_prog(p)) }
fn loop_fills(step: List<BitVec(8)>) → Nat → List<BitVec(8)> { λ _ => step }
fn loop_bytes(step: List<BitVec(8)>) → List<BitVec(8)> { assemble(loop_fills(step), loop_prog(step.len()), Nil) }
fn loop_len(p: Nat) → Nat { prog_len(loop_prog(p)) }
theorem loop_fits(step: List<BitVec(8)>): FillsFit(loop_prog(step.len()), loop_fills(step)) { ⟨refl, trivial⟩ }
theorem loop_bytes_len(step: List<BitVec(8)>): loop_bytes(step).len() = loop_len(step.len()) {
    asm_len_is(loop_fills(step), loop_labels(step.len()), loop_prog(step.len()), loop_fits(step), Nil, 0, refl)
}

// The JNZ lands on the load: closed once the step's length is known, so the
// producer proves it by evaluation (`loop_again`).
fn LoopAgain(p: Nat) → Type {
    JumpsBack(prog_len(lf_advance(p)), 6, near_rel(prog_len(lf_advance(p)) + 6, loop_labels(p, tf_load())), asm_at(lf_load()))
}
fn loop_lands(p: Nat) → Bool {
    asm_same(prog_len(lf_advance(p)) + 6 + near_rel(prog_len(lf_advance(p)) + 6, loop_labels(p, tf_load())).sign_extend(32).toNat(),
        asm_at(lf_load()) + Nat::pow(2, 64))
}
theorem loop_again(p: Nat, same: loop_lands(p) = True): LoopAgain(p) {
    asm_lands_back(prog_len(lf_advance(p)), 6, near_rel(prog_len(lf_advance(p)) + 6, loop_labels(p, tf_load())), asm_at(lf_load()), same)
}

// The chunk loop, placeable: the loop program, the close's JZ, then the
// write loop, whose end jumps back to the read. Every jump in it is
// relative, so it runs wherever it is placed and whatever read head is
// before it: a filter's, which reads stdin, or a command's, which reads its
// operand's fd from RSP (docs/native-wc-command-design.md §6.1). A layout
// (x86_64_layout) whose step is measured by its length `p`; over the step's
// bytes, as the producer evaluates and spells it (`filter_core_bytes`).
fn filter_core_parts(step: List<BitVec(8)>, jumps: FilterJumps) → List<List<BitVec(8)>> {
    [loop_bytes(step), near_control_bytes(JumpZeroNear(jumps.cd))]
}
fn filter_core_lens(p: Nat) → List<Nat> { [loop_len(p), 6] }
fn filter_core_bytes(step: List<BitVec(8)>, jumps: FilterJumps, pj: PrintJumps) → List<BitVec(8)> {
    layout_code(filter_core_parts(step, jumps), write_loop_code(pj))
}
fn filter_core_code(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps) → List<BitVec(8)> {
    filter_core_bytes(structured_bytes(code), jumps, pj)
}
fn filter_core_len(p: Nat) → Nat { layout_end(0, filter_core_lens(p)) + write_loop_len() }
theorem filter_core_measured(code: StructuredCode, jumps: FilterJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    LayoutMeasured(filter_core_parts(structured_bytes(code), jumps), filter_core_lens(p)) {
    ⟨j(p_is, λ n _ => loop_bytes(structured_bytes(code)).len() = loop_len(n), loop_bytes_len(structured_bytes(code))), ⟨refl, trivial⟩⟩
}
theorem filter_core_code_len(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    filter_core_code(code, jumps, pj).len() = filter_core_len(p) {
    layout_len(filter_core_parts(structured_bytes(code), jumps), write_loop_code(pj), filter_core_lens(p), filter_core_measured(code, jumps, p, p_is),
        write_loop_len(), write_loop_code_len(pj))
}

// Where the close's JZ and the write loop start, for a loop placed at `c`
// with a step `p` bytes long; and where the loop's load and close are.
fn fc_at(c, p, i: Nat) → Nat { layout_at(c, filter_core_lens(p), i) }
fn fc_at_cjz(c, p: Nat) → Nat { fc_at(c, p, 1) }
fn fc_at_write(c, p: Nat) → Nat { fc_at(c, p, 2) }
fn load_rip(c: Nat) → BitVec(64) { next_rip(eof_rip(c), asm_at(lf_load())) }
fn close_rip(c, p: Nat) → BitVec(64) { next_rip(eof_rip(c), asm_at(lf_close(p))) }

// The loop's pieces, resident where they start.
record FilterCore(memory: IoMemory, c: Nat, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps) {
    loop_at: CodeResident(io_fetch_access(), memory, loop_bytes(structured_bytes(code)), eof_rip(c)),
    cjz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(jumps.cd)), eof_rip(fc_at_cjz(c, structured_bytes(code).len()))),
    write: WriteLoopResident(memory, fc_at_write(c, structured_bytes(code).len()), pj),
}
theorem filter_core(memory: IoMemory, c: Nat, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps,
    resident: CodeResident(io_fetch_access(), memory, filter_core_code(code, jumps, pj), eof_rip(c))): FilterCore(memory, c, code, jumps, pj) {
    let p = structured_bytes(code).len();
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), write_loop_code(pj), filter_core_parts(structured_bytes(code), jumps), filter_core_lens(p),
        filter_core_measured(code, jumps, p, refl), c, resident);
    FilterCore(piece(0), piece(1), write_loop_resident(memory, fc_at_write(c, p), pj, piece(2)))
}

// The loop's stretches (elf64_stretch): the `n` items ending at label `l`,
// for a loop placed at `c`.
theorem loop_straight(file: IoImage, c: Nat, step: List<BitVec(8)>, placed: Placed(file, loop_bytes(step), eof_rip(c)), page: Nat → BitVec(8),
    goal: MachineState<IoMemory> → Type, back: StepsBack(goal), l: Prog, found: asm_find(loop_prog(step.len()), l) = l, n: Nat,
    state: MachineState<IoMemory>, rip: state.rip = next_rip(eof_rip(c), straight_from(l, n)), memory_is: state.memory = IoMemory(file, page),
    held: Stretch(file, eof_rip(c), goal, loop_labels(step.len()), l, n, page, state)): goal(state) {
    let prog = loop_prog(step.len());
    let k = prog_depth(prog) -prog_depth(l);
    let fills = loop_fills(step);
    let labels = loop_labels(step.len());
    let front = asm_code(fills, labels, asm_back(prog, k));
    let after = asm_code_after(fills, labels, prog, k);
    stretch_runs(file, page, eof_rip(c), goal, back, fills, labels, l, n,
        j(found, λ x _ => FillsFit(x, fills), fills_fit_back(fills, k, prog, loop_fits(step))), after ++ Nil,
        j(found, λ x _ => Placed(file, asm_code(fills, labels, x) ++ (after ++ Nil), eof_rip(c)),
            j(trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ code => code ++ Nil, asm_code_back(fills, labels, k, prog)),
                List::append_assoc(front, after, Nil)), λ code _ => Placed(file, code, eof_rip(c)), placed)),
        state, rip, memory_is, held)
}

// The loop's jumps: the close's JZ and the write loop's end back to the
// read head at `ar`, and the JNZ back to the load.
record CoreTargets(c, ar, p: Nat, jumps: FilterJumps, pj: PrintJumps) {
    again: LoopAgain(p),
    quiet: near_branch_target(eof_rip(fc_at_cjz(c, p)), 6, jumps.cd) = eof_rip(ar),
    write: WriteLoopTargets(fc_at_write(c, p), ar, pj),
}

// The loop's jumps, from where its layout places them (x86_64_layout's
// `near_rel`), for a loop at `c` after a read head at `ar`. A command's own
// head and failure tail are its library's, so the filter's other three are
// not the loop's.
fn core_jumps(c, ar, p: Nat) → FilterJumps {
    FilterJumps(BitVec::ofNat(0), BitVec::ofNat(0), near_rel(fc_at_cjz(c, p) + 6, ar), BitVec::ofNat(0))
}
fn core_print_jumps(c, ar, p: Nat) → PrintJumps { wl_jumps(near_rel(wl_at_wjz(fc_at_write(c, p)) + 6, ar)) }
// Where they land, by evaluation (x86_64_layout's `asm_lands_back`): closed
// once the loop is placed and the step's length known, so the producer proves
// each `refl`.
theorem core_jumps_land(c, ar, p: Nat, again: loop_lands(p) = True,
    quiet: asm_same(fc_at_cjz(c, p) + 6 + core_jumps(c, ar, p).cd.sign_extend(32).toNat(), ar + Nat::pow(2, 64)) = True,
    write: asm_same(wl_at_wjz(fc_at_write(c, p)) + 6 + core_print_jumps(c, ar, p).zd.sign_extend(32).toNat(), ar + Nat::pow(2, 64)) = True):
    CoreTargets(c, ar, p, core_jumps(c, ar, p), core_print_jumps(c, ar, p)) {
    let entry = io_entry();
    let jumps = core_jumps(c, ar, p);
    let pj = core_print_jumps(c, ar, p);
    CoreTargets(
        again := loop_again(p, again),
        quiet := jumps_back(entry, fc_at_cjz(c, p), 6, jumps.cd, ar, asm_lands_back(fc_at_cjz(c, p), 6, jumps.cd, ar, quiet)),
        write := write_targets_to(fc_at_write(c, p), ar, pj, wl_jumps_land(near_rel(wl_at_wjz(fc_at_write(c, p)) + 6, ar)),
            jumps_back(entry, wl_at_wjz(fc_at_write(c, p)), 6, pj.zd, ar, asm_lands_back(wl_at_wjz(fc_at_write(c, p)), 6, pj.zd, ar, write))))
}

// The program: init, the read head (elf64_read_pieces), the chunk loop, the
// failure tail, then the finish.
fn filter_parts(step: List<BitVec(8)>, jumps: FilterJumps, pj: PrintJumps) → List<List<BitVec(8)>> {
    [canonical_block_bytes(state_init_block()), read_head_code(FdStdin, jumps.ed, jumps.sd), filter_core_bytes(step, jumps, pj),
     fail_tail_code(jumps.rd)]
}
fn filter_lens(p: Nat) → List<Nat> { [state_init_len(), read_head_len(FdStdin), filter_core_len(p), fail_tail_len()] }
fn filter_bytes(step: List<BitVec(8)>, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>) → List<BitVec(8)> {
    layout_code(filter_parts(step, jumps, pj), finish)
}
fn filter_code(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>) → List<BitVec(8)> {
    filter_bytes(structured_bytes(code), jumps, pj, finish)
}
theorem filter_measured(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    LayoutMeasured(filter_parts(structured_bytes(code), jumps, pj), filter_lens(p)) {
    ⟨refl, ⟨read_head_code_len(FdStdin, jumps.ed, jumps.sd), ⟨filter_core_code_len(code, jumps, pj, p, p_is), ⟨fail_tail_code_len(jumps.rd), trivial⟩⟩⟩⟩
}
// The code's length from the step's and the finish's, over open parts.
theorem filter_code_len(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>, p, finish_len: Nat,
    p_is: structured_bytes(code).len() = p, finish_is: finish.len() = finish_len):
    filter_code(code, jumps, pj, finish).len() = layout_end(0, filter_lens(p)) + finish_len {
    layout_len(filter_parts(structured_bytes(code), jumps, pj), finish, filter_lens(p), filter_measured(code, jumps, pj, p, p_is), finish_len, finish_is)
}

// Where each piece starts, from the entry, for a step `p` bytes long.
fn fl_at(p, i: Nat) → Nat { layout_at(0, filter_lens(p), i) }
fn fl_at_read(p: Nat) → Nat { fl_at(p, 1) }
fn fl_at_setup(p: Nat) → Nat { fl_at(p, 2) }
fn fl_at_cjz(p: Nat) → Nat { fc_at_cjz(fl_at_setup(p), p) }
fn fl_at_write(p: Nat) → Nat { fc_at_write(fl_at_setup(p), p) }
fn fl_at_failed(p: Nat) → Nat { fl_at(p, 3) }
fn fl_at_finish(p: Nat) → Nat { fl_at(p, 4) }
fn fl_at_retry(p: Nat) → Nat { ft_at_jz(fl_at_failed(p)) }

// The program's pieces, resident at their offsets.
record FilterPieces(memory: IoMemory, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>) {
    init_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(state_init_block()), eof_rip(fl_at(structured_bytes(code).len(), 0))),
    head: ReadHead(FdStdin, memory, fl_at_read(structured_bytes(code).len()), jumps.ed, jumps.sd),
    core: FilterCore(memory, fl_at_setup(structured_bytes(code).len()), code, jumps, pj),
    fail: FailTail(memory, fl_at_failed(structured_bytes(code).len()), jumps.rd),
    finish_at: CodeResident(io_fetch_access(), memory, finish, eof_rip(fl_at_finish(structured_bytes(code).len()))),
}

theorem filter_pieces(memory: IoMemory, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    resident: CodeResident(io_fetch_access(), memory, filter_code(code, jumps, pj, finish), io_entry())):
    FilterPieces(memory, code, jumps, pj, finish) {
    let p = structured_bytes(code).len();
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), finish, filter_parts(structured_bytes(code), jumps, pj), filter_lens(p),
        filter_measured(code, jumps, pj, p, refl), 0, resident);
    FilterPieces(piece(0), read_head(FdStdin, memory, fl_at_read(p), jumps.ed, jumps.sd, piece(1)), filter_core(memory, fl_at_setup(p), code, jumps, pj, piece(2)),
        fail_tail(memory, fl_at_failed(p), jumps.rd, piece(3)), piece(4))
}

// ---------------------------------------------------------------------------
// The jumps' targets, from a closed fact about each displacement that the
// producer proves at the written bytes. The finish starts at `done`: the
// write loop's own exit(0) for a program that prints nothing more, or the
// finish's first byte.

record FilterTargets(p, done: Nat, jumps: FilterJumps, pj: PrintJumps) {
    finish: near_branch_target(eof_rip(rh_at_jz(FdStdin, fl_at_read(p))), 6, jumps.ed) = eof_rip(done),
    fail: near_branch_target(eof_rip(rh_at_js(FdStdin, fl_at_read(p))), 6, jumps.sd) = eof_rip(fl_at_failed(p)),
    retry: near_branch_target(eof_rip(fl_at_retry(p)), 6, jumps.rd) = eof_rip(fl_at_read(p)),
    core: CoreTargets(fl_at_setup(p), fl_at_read(p), p, jumps, pj),
}
record FilterJumpFacts(p, done: Nat, jumps: FilterJumps, pj: PrintJumps) {
    finish: JumpsForward(rh_at_jz(FdStdin, fl_at_read(p)), 6, jumps.ed, done),
    fail: JumpsForward(rh_at_js(FdStdin, fl_at_read(p)), 6, jumps.sd, fl_at_failed(p)),
    again: LoopAgain(p),
    quiet: JumpsBack(fl_at_cjz(p), 6, jumps.cd, fl_at_read(p)),
    retry: JumpsBack(fl_at_retry(p), 6, jumps.rd, fl_at_read(p)),
    write: WriteJumpFacts(pj),
    write_read: JumpsBack(wl_at_wjz(fl_at_write(p)), 6, pj.zd, fl_at_read(p)),
}
theorem filter_targets(p, done: Nat, jumps: FilterJumps, pj: PrintJumps, facts: FilterJumpFacts(p, done, jumps, pj)):
    FilterTargets(p, done, jumps, pj) {
    let entry = io_entry();
    FilterTargets(
        finish := jumps_forward(entry, rh_at_jz(FdStdin, fl_at_read(p)), 6, jumps.ed, done, facts.finish),
        fail := jumps_forward(entry, rh_at_js(FdStdin, fl_at_read(p)), 6, jumps.sd, fl_at_failed(p), facts.fail),
        retry := jumps_back(entry, fl_at_retry(p), 6, jumps.rd, fl_at_read(p), facts.retry),
        core := CoreTargets(
            again := facts.again,
            quiet := jumps_back(entry, fl_at_cjz(p), 6, jumps.cd, fl_at_read(p), facts.quiet),
            write := write_targets_to(fl_at_write(p), fl_at_read(p), pj, facts.write,
                jumps_back(entry, wl_at_wjz(fl_at_write(p)), 6, pj.zd, fl_at_read(p), facts.write_read))))
}

// The program's jumps, from where its layout places them, for a step `p`
// bytes long and a finish at `done`; and where they land, by evaluation, as
// for the loop's (`core_jumps_land`).
fn filter_jumps(p, done: Nat) → FilterJumps {
    FilterJumps(near_rel(rh_at_jz(FdStdin, fl_at_read(p)) + 6, done), near_rel(rh_at_js(FdStdin, fl_at_read(p)) + 6, fl_at_failed(p)),
        near_rel(fl_at_cjz(p) + 6, fl_at_read(p)), near_rel(fl_at_retry(p) + 6, fl_at_read(p)))
}
fn filter_print_jumps(p: Nat) → PrintJumps { wl_jumps(near_rel(wl_at_wjz(fl_at_write(p)) + 6, fl_at_read(p))) }
theorem filter_jumps_land(p, done: Nat,
    finish: asm_same(rh_at_jz(FdStdin, fl_at_read(p)) + 6 + filter_jumps(p, done).ed.sign_extend(32).toNat(), done) = True,
    fail: asm_same(rh_at_js(FdStdin, fl_at_read(p)) + 6 + filter_jumps(p, done).sd.sign_extend(32).toNat(), fl_at_failed(p)) = True,
    again: loop_lands(p) = True,
    quiet: asm_same(fl_at_cjz(p) + 6 + filter_jumps(p, done).cd.sign_extend(32).toNat(), fl_at_read(p) + Nat::pow(2, 64)) = True,
    retry: asm_same(fl_at_retry(p) + 6 + filter_jumps(p, done).rd.sign_extend(32).toNat(), fl_at_read(p) + Nat::pow(2, 64)) = True,
    write_read: asm_same(wl_at_wjz(fl_at_write(p)) + 6 + filter_print_jumps(p).zd.sign_extend(32).toNat(), fl_at_read(p) + Nat::pow(2, 64)) = True):
    FilterJumpFacts(p, done, filter_jumps(p, done), filter_print_jumps(p)) {
    let jumps = filter_jumps(p, done);
    FilterJumpFacts(
        finish := asm_lands_forward(rh_at_jz(FdStdin, fl_at_read(p)), 6, jumps.ed, done, finish),
        fail := asm_lands_forward(rh_at_js(FdStdin, fl_at_read(p)), 6, jumps.sd, fl_at_failed(p), fail),
        again := loop_again(p, again),
        quiet := asm_lands_back(fl_at_cjz(p), 6, jumps.cd, fl_at_read(p), quiet),
        retry := asm_lands_back(fl_at_retry(p), 6, jumps.rd, fl_at_read(p), retry),
        write := wl_jumps_land(near_rel(wl_at_wjz(fl_at_write(p)) + 6, fl_at_read(p))),
        write_read := asm_lands_back(wl_at_wjz(fl_at_write(p)), 6, filter_print_jumps(p).zd, fl_at_read(p), write_read))
}

// ---------------------------------------------------------------------------
// A program, as the process takes it: its data (the step, the initial state,
// its counts, its placement over the state registers, the step's code), and
// what the producer proves of them. Two records, so the data's fields are
// independent of each other (a record whose fields depend on earlier ones is
// costly at every projection).

record FilterShape<C> {
    step: C → BitVec(8) → Filtered<C>,
    init: C,
    counts: List<C → Nat>,
    rep: Gprs → C → Type,
    code: StructuredCode,
}
record FilterFacts<C>(shape: FilterShape<C>) {
    piece: StepPiece<IoMemory, C>(shape.code, shape.rep, shape.counts, shape.step),
    framed: StateFramed(shape.rep),
    initialised: StateInitialised(shape.rep, shape.init),
    advances: (state: C) → (byte: BitVec(8)) → counts_advance(shape.counts, shape.step(state, byte).next, state),
    zero: CountsAtMost(shape.counts, shape.init, 0),
}

// Each of `counts` is at most `n`.
fn CountsAtMost<C>(counts: List<C → Nat>, s: C, n: Nat) → Type {
    match counts {
        Nil => True,
        Cons(count, rest) => (count(s) <= n) ∧ CountsAtMost(rest, s, n),
    }
}

// What the chunk loop needs of a program: FilterFacts' without the init (a
// command zeroes its state per operand), with the state framed by the state's
// registers and RSP, which every piece of the loop keeps. A command's
// representation also pins its fd in RSP (docs/native-wc-command-design.md
// §6.2); a filter's reads only the state's registers.
fn LoopFramed<C>(rep: Gprs → C → Type) → Type {
    (before, after: Gprs) → (carry: C) → StateKept(after, before) → read_gpr(Rsp, after) = read_gpr(Rsp, before) →
        rep(before, carry) → rep(after, carry)
}
record LoopFacts<C>(shape: FilterShape<C>) {
    piece: StepPiece<IoMemory, C>(shape.code, shape.rep, shape.counts, shape.step),
    framed: LoopFramed(shape.rep),
    advances: (state: C) → (byte: BitVec(8)) → counts_advance(shape.counts, shape.step(state, byte).next, state),
    zero: CountsAtMost(shape.counts, shape.init, 0),
}
theorem loop_facts<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape)): LoopFacts<C>(shape) {
    LoopFacts(piece := facts.piece, framed := λ before after carry kept _ held => facts.framed(before, after, carry, kept, held),
        advances := facts.advances, zero := facts.zero)
}

// ---------------------------------------------------------------------------
// The counts fit their words: each grows by at most one per byte from zero,
// so after `n` bytes it is at most `n`.

// Over Nats, so omega sees atoms rather than a count applied.
theorem le_succ_of(a, b, n: Nat, grew: a <= Succ(b), below: b <= n): a <= Succ(n) { omega }
theorem lt_of_le_below(a, n, m: Nat, below: a <= n, small: n < m): a < m { omega }
// A chunk's output, stored from the page's start and sent from there.
theorem page_sends(l: Nat, short: l <= 4096): 0 + l <= 4096 { omega }
theorem page_sends_room(r, l: Nat, base: r = io_page_base(), short: l <= 4096): r + l < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}

theorem counts_step<C>(counts: List<C → Nat>): (next, s: C) → (n: Nat) → counts_advance(counts, next, s) → CountsAtMost(counts, s, n) →
    CountsAtMost(counts, next, Succ(n)) {
    match counts {
        Nil => λ next s n _ _ => trivial,
        Cons(count, rest) => (match rest as λ r => ((next, s: C) → (n: Nat) → counts_advance(r, next, s) → CountsAtMost(r, s, n) →
                    CountsAtMost(r, next, Succ(n))) →
                (next, s: C) → (n: Nat) → counts_advance(Cons(count, r), next, s) →
                CountsAtMost(Cons(count, r), s, n) → CountsAtMost(Cons(count, r), next, Succ(n)) {
            Nil => λ _ next s n grew below => ⟨le_succ_of(count(next), count(s), n, grew, below.left), trivial⟩,
            Cons(c, more) => λ later next s n grew below =>
                ⟨le_succ_of(count(next), count(s), n, grew.left, below.left), later(next, s, n, grew.right, below.right)⟩,
        })(counts_step(rest)),
    }
}
theorem counts_grow<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), bytes: List<BitVec(8)>):
    (s: C) → (n: Nat) → CountsAtMost(shape.counts, s, n) → CountsAtMost(shape.counts, filter_state(shape.step, bytes, s), n + bytes.len()) {
    match bytes {
        Nil => λ s n below => below,
        Cons(byte, rest) => λ s n below => {
            let next = shape.step(s, byte).next;
            let stepped = counts_step(shape.counts, next, s, n, facts.advances(s, byte), below);
            let later = counts_grow(shape, facts, rest, next, Succ(n), stepped);
            let same: (Succ(n) + rest.len() = n + Cons(byte, rest).len()) = omega;
            j(same, λ k _ => CountsAtMost(shape.counts, filter_state(shape.step, rest, next), k), later)
        },
    }
}
theorem counts_fit<C>(counts: List<C → Nat>, s: C, n: Nat, small: n < Nat::pow(2, 64)): CountsAtMost(counts, s, n) → CountsFit(counts, s) {
    match counts as λ cs => CountsAtMost(cs, s, n) → CountsFit(cs, s) {
        Nil => λ _ => trivial,
        Cons(count, rest) => λ below => ⟨lt_of_le_below(count(s), n, Nat::pow(2, 64), below.left, small), counts_fit(rest, s, n, small, below.right)⟩,
    }
}

// Room for the counts: none is needed when there are none, so a filter
// without counts has a claim for any input.
fn FilterRoom<C>(counts: List<C → Nat>, input: List<BitVec(8)>) → Type {
    match counts { Nil => True, Cons(_, _) => input.len() + 4096 < Nat::pow(2, 64) }
}
// Every state the input passes through has counts that fit, and so does a
// chunk read past it (one that ends the run in a failed write).
theorem room_fits<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), input, seen: List<BitVec(8)>,
    room: FilterRoom(shape.counts, input), within: seen.len() <= input.len() + 4096):
    CountsFit(shape.counts, filter_state(shape.step, seen, shape.init)) {
    (match shape.counts as λ cs => FilterRoom(cs, input) → CountsAtMost(cs, filter_state(shape.step, seen, shape.init), 0 + seen.len()) →
            CountsFit(cs, filter_state(shape.step, seen, shape.init)) {
        Nil => λ _ _ => trivial,
        Cons(count, rest) => λ big below => counts_fit(Cons(count, rest), filter_state(shape.step, seen, shape.init), 0 + seen.len(),
            { let r: (input.len() + 4096 < Nat::pow(2, 64)) = big; omega }, below),
    })(room, counts_grow(shape, facts, seen, shape.init, 0, facts.zero))
}

// ---------------------------------------------------------------------------
// One chunk's loop. At `rip` with `front` of the chunk done and `back` to
// go: the page holds what `front` emitted from its start and `back` where it
// was read, the state registers hold the state `front` left, RSI is at the
// next byte, RCX counts what is left, RDI is past the output, R12 is 1.

record FilterAt<C>(shape: FilterShape<C>, file: IoImage, s0: C, front, back: List<BitVec(8)>, rip: BitVec(64), state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = rip,
    emitted: Stored(page, 0, filter_emitted(shape.step, front, s0)),
    left: Stored(page, front.len(), back),
    held: shape.rep(state.gprs, filter_state(shape.step, front, s0)),
    cursor: read_gpr(Rsi, state.gprs).toNat() = io_page_base() + front.len(),
    count: read_gpr(Rcx, state.gprs).toNat() = back.len(),
    out: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + filter_emitted(shape.step, front, s0).len(),
    one: read_gpr(R12, state.gprs) = BitVec::ofNat(1),
}

// A step piece's run from offset `at` past `origin`, where its bytes are
// resident (elf64_print_pieces's `piece_runs`, for the step's certificate).
theorem step_runs<C>(code: StructuredCode, before: MachineState<IoMemory>, rep: Gprs → C → Type, out: Filtered<C>,
    ran: StepRan<IoMemory, C>(code, before, rep, out), stored: IoMemory, origin: BitVec(64), at: Nat,
    resident: CodeResident(io_fetch_access(), stored, structured_bytes(code), next_rip(origin, at)),
    memory_is: before.memory = stored, rip_is: before.rip = next_rip(origin, at)):
    FetchedSteps(io_fetch_access(), io_data_access(), before, ran.after) ∧
        ((ran.after.memory = stored) ∧ (ran.after.rip = next_rip(origin, at + structured_bytes(code).len()))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let went = structured_fetched(fetch, data, code, before, ran.layout,
        resident_state(fetch, structured_bytes(code), stored, next_rip(origin, at), before, memory_is, rip_is, resident));
    ⟨j(sym(ran.execution), λ after _ => FetchedSteps(fetch, data, before, after), went.left),
     ⟨trans(ran.memory_preserved, memory_is), trans(ran.rip_correct, rip_advance(origin, before.rip, at, structured_bytes(code).len(), rip_is))⟩⟩
}

// The flag's value is how many bytes the step emitted.
theorem emit_flag_value(emit: Option<BitVec(8)>): emit_flag(emit).toNat() = emitted_byte(emit).len() {
    match emit as λ e => emit_flag(e).toNat() = emitted_byte(e).len() { None => refl, Some(_) => refl }
}
// The byte stored is the emitted one, when one is.
fn emit_low(emit: Option<BitVec(8)>) → BitVec(8) { imm_byte0(emit_word(emit)) }
theorem emit_low_is(emit: Option<BitVec(8)>, x: BitVec(8), some: emit = Some(x)): emit_low(emit) = x {
    j(sym(some), λ e _ => emit_low(e) = x, BitVec::split_concat_low(8, 56, x, BitVec::zero()))
}

// The arithmetic of one byte, over Nats.
theorem filter_inside(f, b: Nat, n: Nat, whole: f + Succ(b) = n, fits: n <= 4096): f < 4096 { omega }
theorem filter_low(i: Nat, inside: i < 4096): io_page_base() + i < Nat::pow(2, 47) {
    let page: (io_page_base() + 4096 <= Nat::pow(2, 47)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial);
    omega
}
theorem filter_word(i: Nat, inside: i < 4096): Succ(io_page_base() + i) < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}

// The page after the store: what came before the cursor, then what the byte
// emitted; and the bytes still to be read, as they were.
theorem filter_emitted_page(memory: IoMemory, emitted: List<BitVec(8)>, emit: Option<BitVec(8)>,
    held: Stored(memory.page, 0, emitted)):
    Stored(io_store_offset(memory, emitted.len(), [emit_low(emit)]).page, 0, emitted ++ emitted_byte(emit)) {
    let o = emitted.len();
    let first: Stored(io_store_offset(memory, o, [emit_low(emit)]).page, 0, emitted) =
        stored_kept(memory, o, [emit_low(emit)], emitted, 0, j(sym(Nat::add_left_zero(o)), λ k _ => k <= o, o.le_refl()), held);
    let second: Stored(io_store_offset(memory, o, [emit_low(emit)]).page, 0 + o, emitted_byte(emit)) =
        (match emit as λ e => Stored(io_store_offset(memory, o, [emit_low(e)]).page, 0 + o, emitted_byte(e)) {
            None => λ i byte none => false_elim(j(none, λ found _ => match found as λ _ => Type { None => True, Some(_) => False }, trivial)),
            Some(x) => j(sym(Nat::add_left_zero(o)), λ k _ => Stored(io_store_offset(memory, o, [emit_low(Some(x))]).page, k, [x]),
                j(emit_low_is(Some(x), x, refl), λ y _ => Stored(io_store_offset(memory, o, [y]).page, o, [x]),
                    stored_store(memory, o, [x]))),
        });
    stored_join(io_store_offset(memory, o, [emit_low(emit)]).page, 0, emitted, emitted_byte(emit), first, second)
}
theorem filter_past_cursor(i, f, o: Nat, below: o <= f): Not(i + Succ(f) = o) {
    λ same => { let s: (i + Succ(f) = o) = same; false_elim(Nat::lt_irrefl(o, { omega })) }
}
theorem filter_left_page(memory: IoMemory, o, f: Nat, below: o <= f, x: BitVec(8), b: BitVec(8), rest: List<BitVec(8)>,
    left: Stored(memory.page, f, Cons(b, rest))): Stored(io_store_offset(memory, o, [x]).page, Succ(f), rest) {
    λ i c present => {
        let other = filter_past_cursor(i, f, o, below);
        let place: (Succ(i) + f = i + Succ(f)) = omega;
        trans(store_byte_other(memory, o, x, i + Succ(f), other), j(place, λ k _ => memory.page(k) = c, left(Succ(i), c, present)))
    }
}

// The cursors' arithmetic.
theorem filter_rsi_next(f: Nat, inside: f < 4096, rsi, one: BitVec(64), at: rsi.toNat() = io_page_base() + f, one_value: one.toNat() = 1):
    rsi.add(one).toNat() = io_page_base() + Succ(f) {
    let w = filter_word(f, inside);
    let sum = bitvec_nat::toNat_add(64, rsi, one, { omega });
    omega
}
theorem filter_rcx_next(r: Nat, rcx, one: BitVec(64), at: rcx.toNat() = Succ(r), one_value: one.toNat() = 1): rcx.sub(one).toNat() = r {
    let difference = bitvec_nat::toNat_sub(64, rcx, one, { omega });
    let back: ((rcx.toNat() -one.toNat()) + one.toNat() = rcx.toNat()) = Nat::sub_add_cancel(one.toNat(), rcx.toNat(), { omega });
    omega
}
theorem filter_rdi_next(o, n: Nat, inside: o < 4096, small: n <= 1, rdi, flag: BitVec(64), at: rdi.toNat() = io_page_base() + o,
    flag_value: flag.toNat() = n): rdi.add(flag).toNat() = io_page_base() + (o + n) {
    let w = filter_word(o, inside);
    let sum = bitvec_nat::toNat_add(64, rdi, flag, { omega });
    omega
}
// What ZF says of the count: some left when it is clear, none when set.
theorem left_of_flag(x: BitVec(64), n: Nat, value: x.toNat() = n, flag: is_zero_bits(64, x) = False): 0 < n {
    (match n as λ k => x.toNat() = k → 0 < k {
        Zero => λ zero => absurd(trans(sym(flag), zero_bits_of_zero(64, x, zero))),
        Succ(_) => λ _ => trivial,
    })(value)
}
theorem none_of_flag(x: BitVec(64), n: Nat, value: x.toNat() = n, flag: is_zero_bits(64, x) = True): n = 0 {
    (match n as λ k => x.toNat() = k → k = 0 {
        Zero => λ _ => refl,
        Succ(_) => λ some => absurd(trans(sym(flag), zero_bits_of_pos(64, x, j(sym(some), λ v _ => 0 < v, trivial)))),
    })(value)
}

// After the byte: back to the load with `rest` left, or on to the close
// with nothing left.
fn ByteAgain<C>(shape: FilterShape<C>, file: IoImage, s0: C, front, rest: List<BitVec(8)>, c: Nat, goal: MachineState<IoMemory> → Type) → Type {
    (state: MachineState<IoMemory>) → FilterAt<C>(shape, file, s0, front, rest, load_rip(c), state) → 0 < rest.len() → goal(state)
}
fn ByteDone<C>(shape: FilterShape<C>, file: IoImage, s0: C, front, rest: List<BitVec(8)>, c: Nat, goal: MachineState<IoMemory> → Type) → Type {
    (state: MachineState<IoMemory>) → FilterAt<C>(shape, file, s0, front, rest, close_rip(c, structured_bytes(shape.code).len()), state) →
        rest.len() = 0 → goal(state)
}

// Byte `front.len()` loaded and stepped, at the store: the next state in the
// state registers, the flag in RBX, the byte in RDX, the page as it was, the
// loop's registers kept.
record FilterStepped<C>(shape: FilterShape<C>, file: IoImage, s0: C, front: List<BitVec(8)>, b: BitVec(8), rip: BitVec(64),
    state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = rip,
    emitted: Stored(page, 0, filter_emitted(shape.step, front, s0)),
    next_held: shape.rep(state.gprs, shape.step(filter_state(shape.step, front, s0), b).next),
    flag_is: read_gpr(Rbx, state.gprs) = emit_flag(shape.step(filter_state(shape.step, front, s0), b).emit),
    byte_is: read_gpr(Rdx, state.gprs) = emit_word(shape.step(filter_state(shape.step, front, s0), b).emit),
    cursor: read_gpr(Rsi, state.gprs).toNat() = io_page_base() + front.len(),
    out: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + filter_emitted(shape.step, front, s0).len(),
    one: read_gpr(R12, state.gprs) = BitVec::ofNat(1),
}

// The store, the advance and the JNZ, from `stepped` to `after`: the byte's
// output stored at the write cursor, the cursors on, the count down.
theorem filter_advanced_at<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), file: IoImage, s0: C, front, rest: List<BitVec(8)>, b: BitVec(8),
    inside: front.len() < 4096, rp0: BitVec(64), stepped: MachineState<IoMemory>, at: FilterStepped<C>(shape, file, s0, front, b, rp0, stepped),
    left: Stored(at.page, front.len(), Cons(b, rest)), d: BitVec(32),
    count: read_gpr(Rcx, execute_block_normal(filter_advance_block(), byte_store_after(linux_writes(io_linux()), filter_store(), stepped)).gprs).toNat() =
        rest.len(),
    rp: BitVec(64), after: MachineState<IoMemory>, rip: after.rip = rp,
    m: after.memory = IoMemory(file, page_stored(file, at.page, filter_emitted(shape.step, front, s0).len(), imm_byte0(read_gpr(Rdx, stepped.gprs)))),
    same: after = execute_near_control(JumpIfNear(NE, d),
        execute_block_normal(filter_advance_block(), byte_store_after(linux_writes(io_linux()), filter_store(), stepped)))):
    FilterAt<C>(shape, file, s0, front ++ [b], rest, rp, after) {
    let s = filter_state(shape.step, front, s0);
    let e = shape.step(s, b).emit;
    let emitted = filter_emitted(shape.step, front, s0);
    let o = emitted.len();
    let short: (o <= front.len()) = filter_emitted_len(shape.step, front, s0);
    let o_inside: (o < 4096) = lt_of_le_below(o, front.len(), 4096, short, inside);
    let ended = execute_near_control(JumpIfNear(NE, d),
        execute_block_normal(filter_advance_block(), byte_store_after(linux_writes(io_linux()), filter_store(), stepped)));
    let next = page_stored(file, at.page, o, emit_low(e));
    let low: (imm_byte0(read_gpr(Rdx, stepped.gprs)) = emit_low(e)) = cong_fn<BitVec(64), BitVec(8)>(λ v => imm_byte0(v), at.byte_is);
    let one_value: (read_gpr(R12, stepped.gprs).toNat() = 1) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), at.one), BitVec::toNat_ofNat(64, 1, trivial));
    let flag: (read_gpr(Rbx, stepped.gprs).toNat() = emitted_byte(e).len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), at.flag_is), emit_flag_value(e));
    // `front.len() + 1` is `Succ(front.len())` by computation: addition
    // recurses on its second argument.
    let grown: ((front ++ [b]).len() = Succ(front.len())) = List::len_append(front, [b]);
    let emitted_next: (filter_emitted(shape.step, front ++ [b], s0) = emitted ++ emitted_byte(e)) = filter_emitted_snoc(shape.step, front, b, s0);
    let out_len: ((emitted ++ emitted_byte(e)).len() = o + emitted_byte(e).len()) = List::len_append(emitted, emitted_byte(e));
    let rdi: (read_gpr(Rdi, ended.gprs).toNat() = io_page_base() + filter_emitted(shape.step, front ++ [b], s0).len()) =
        trans(filter_rdi_next(o, emitted_byte(e).len(), o_inside, emitted_byte_len(e), read_gpr(Rdi, stepped.gprs), read_gpr(Rbx, stepped.gprs), at.out, flag),
            cong_fn<Nat, Nat>(λ k => io_page_base() + k, sym(trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), emitted_next), out_len))));
    let rsi: (read_gpr(Rsi, ended.gprs).toNat() = io_page_base() + (front ++ [b]).len()) =
        trans(filter_rsi_next(front.len(), inside, read_gpr(Rsi, stepped.gprs), read_gpr(R12, stepped.gprs), at.cursor, one_value),
            cong_fn<Nat, Nat>(λ k => io_page_base() + k, sym(grown)));
    let held: shape.rep(ended.gprs, filter_state(shape.step, front ++ [b], s0)) =
        j(sym(filter_state_snoc(shape.step, front, b, s0)), λ t _ => shape.rep(ended.gprs, t),
            facts.framed(stepped.gprs, ended.gprs, shape.step(s, b).next, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, refl, at.next_held));
    let page_emitted: Stored(next, 0, filter_emitted(shape.step, front ++ [b], s0)) =
        j(sym(emitted_next), λ l _ => Stored(next, 0, l), filter_emitted_page(IoMemory(file, at.page), emitted, e, at.emitted));
    let page_left: Stored(next, (front ++ [b]).len(), rest) =
        j(sym(grown), λ k _ => Stored(next, k, rest), filter_left_page(IoMemory(file, at.page), o, front.len(), short, emit_low(e), b, rest, left));
    j(sym(same), λ x _ => FilterAt<C>(shape, file, s0, front ++ [b], rest, rp, x), FilterAt(
        page := next,
        memory_is := trans(j(same, λ x _ => x.memory = IoMemory(file, page_stored(file, at.page, o, imm_byte0(read_gpr(Rdx, stepped.gprs)))), m),
            cong_fn<BitVec(8), IoMemory>(λ y => IoMemory(file, page_stored(file, at.page, o, y)), low)),
        rip_is := j(same, λ x _ => x.rip = rp, rip),
        emitted := page_emitted,
        left := page_left,
        held := held,
        cursor := rsi,
        count := count,
        out := rdi,
        one := at.one))
}

// From the store: one stretch of three items, the store, the advance and the
// JNZ, whose sides are the two ways on.
theorem filter_advanced<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), again: LoopAgain(structured_bytes(shape.code).len()), s0: C,
    front, rest: List<BitVec(8)>, b: BitVec(8), inside: front.len() < 4096, goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    next: ByteAgain<C>(shape, file, s0, front ++ [b], rest, c, goal), done: ByteDone<C>(shape, file, s0, front ++ [b], rest, c, goal),
    stepped: MachineState<IoMemory>,
    at: FilterStepped<C>(shape, file, s0, front, b, next_rip(eof_rip(c), prog_len(lf_step(structured_bytes(shape.code).len()))), stepped),
    count: read_gpr(Rcx, stepped.gprs).toNat() = Succ(rest.len()), left: Stored(at.page, front.len(), Cons(b, rest))): goal(stepped) {
    let p = structured_bytes(shape.code).len();
    let emitted = filter_emitted(shape.step, front, s0);
    let o = emitted.len();
    let o_inside: (o < 4096) = lt_of_le_below(o, front.len(), 4096, filter_emitted_len(shape.step, front, s0), inside);
    let advanced = execute_block_normal(filter_advance_block(), byte_store_after(linux_writes(io_linux()), filter_store(), stepped));
    let one_value: (read_gpr(R12, stepped.gprs).toNat() = 1) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), at.one), BitVec::toNat_ofNat(64, 1, trivial));
    let rcx: (read_gpr(Rcx, advanced.gprs).toNat() = rest.len()) =
        filter_rcx_next(rest.len(), read_gpr(Rcx, stepped.gprs), read_gpr(R12, stepped.gprs), count, one_value);
    let d = near_rel(prog_len(lf_advance(p)) + 6, loop_labels(p, tf_load()));
    let from = next_rip(eof_rip(c), prog_len(lf_step(p)));
    loop_straight(file, c, structured_bytes(shape.code), placed, at.page, goal, back, lf_jnz(p), refl, 3, stepped, at.rip_is, at.memory_is,
        Exists(o, ⟨o_inside, ⟨at.out, ⟨
            λ taken e rip m same => next(e,
                filter_advanced_at(shape, facts, file, s0, front, rest, b, inside, from, stepped, at, left, d, rcx, load_rip(c), e,
                    trans(rip, jumps_back(eof_rip(c), prog_len(lf_advance(p)), 6, d, asm_at(lf_load()), again)), m, same),
                left_of_flag(read_gpr(Rcx, advanced.gprs), rest.len(), rcx, not_true_is(advanced.flags.zf, taken))),
            λ passed e rip m same => done(e,
                filter_advanced_at(shape, facts, file, s0, front, rest, b, inside, from, stepped, at, left, d, rcx, close_rip(c, p), e, rip, m, same),
                none_of_flag(read_gpr(Rcx, advanced.gprs), rest.len(), rcx, not_false_is(advanced.flags.zf, passed)))⟩⟩⟩))
}

// The step, from the load's end: the program's piece, by its certificate.
theorem filter_stepped<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), again: LoopAgain(structured_bytes(shape.code).len()), s0: C,
    front, rest: List<BitVec(8)>, b: BitVec(8), inside: front.len() < 4096,
    fits: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next), goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    next: ByteAgain<C>(shape, file, s0, front ++ [b], rest, c, goal), done: ByteDone<C>(shape, file, s0, front ++ [b], rest, c, goal),
    loaded: MachineState<IoMemory>, at: FilterAt<C>(shape, file, s0, front, Cons(b, rest), next_rip(eof_rip(c), prog_len(lf_load())), loaded),
    rax: read_gpr(Rax, loaded.gprs) = b.zero_extend(56)): goal(loaded) {
    let step = structured_bytes(shape.code);
    let p = step.len();
    let s = filter_state(shape.step, front, s0);
    have ran = facts.piece(loaded, s, b, at.held, rax, fits);
    let resident: CodeResident(io_fetch_access(), IoMemory(file, at.page), step, next_rip(eof_rip(c), prog_len(lf_load()))) =
        asm_placed(file, loop_fills(step), loop_prog(p), loop_fits(step), eof_rip(c), placed)(lf_step(p))(at.page);
    let went = step_runs(shape.code, loaded, shape.rep, shape.step(s, b), ran, IoMemory(file, at.page), eof_rip(c), prog_len(lf_load()), resident,
        at.memory_is, at.rip_is);
    back(loaded, ran.after, linux_steps_of_fetched(io_linux(), loaded, ran.after, went.left),
        filter_advanced(shape, facts, c, file, placed, again, s0, front, rest, b, inside, goal, back, next, done, ran.after,
            FilterStepped(page := at.page, memory_is := went.right.left, rip_is := went.right.right, emitted := at.emitted,
                next_held := ran.next_held, flag_is := ran.flag_is, byte_is := ran.byte_is,
                cursor := trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), ran.registers_preserved(Rsi, trivial)), at.cursor),
                out := trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), ran.registers_preserved(Rdi, trivial)), at.out),
                one := trans(ran.registers_preserved(R12, trivial), at.one)),
            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), ran.registers_preserved(Rcx, trivial)), at.count), at.left))
}

// One byte, from the load: a stretch of one item to the step, the step, then
// the store, advance and JNZ.
theorem filter_byte<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), again: LoopAgain(structured_bytes(shape.code).len()), s0: C,
    front, rest: List<BitVec(8)>, b: BitVec(8), inside: front.len() < 4096,
    fits: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next), goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    next: ByteAgain<C>(shape, file, s0, front ++ [b], rest, c, goal), done: ByteDone<C>(shape, file, s0, front ++ [b], rest, c, goal),
    state: MachineState<IoMemory>, head: FilterAt<C>(shape, file, s0, front, Cons(b, rest), load_rip(c), state)): goal(state) {
    let s = filter_state(shape.step, front, s0);
    let rsi = read_gpr(Rsi, state.gprs);
    let loaded: (head.page(front.len()) = b) = j(Nat::add_left_zero(front.len()), λ k _ => head.page(k) = b, head.left(0, b, refl));
    let present: (io_read(IoMemory(file, head.page), rsi) = Some(b)) =
        trans(io_read_page(file, head.page, rsi, front.len(), inside, head.cursor), cong_fn<BitVec(8), Option<BitVec(8)>>(λ x => Some(x), loaded));
    let low: (rsi.toNat() < Nat::pow(2, 47)) = j(sym(head.cursor), λ v _ => v < Nat::pow(2, 47), filter_low(front.len(), inside));
    let after = byte_load_after(filter_load(), b, state);
    let rip_to = next_rip(eof_rip(c), prog_len(lf_load()));
    loop_straight(file, c, structured_bytes(shape.code), placed, head.page, goal, back, lf_load(), refl, 1, state, head.rip_is, head.memory_is,
        Exists(b, Exists(rsi, ⟨refl, ⟨present, ⟨low, λ e rip m same =>
            filter_stepped(shape, facts, c, file, placed, again, s0, front, rest, b, inside, fits, goal, back, next, done, e,
                j(sym(same), λ x _ => FilterAt<C>(shape, file, s0, front, Cons(b, rest), rip_to, x), FilterAt(
                    page := head.page,
                    memory_is := j(same, λ x _ => x.memory = IoMemory(file, head.page), m),
                    rip_is := j(same, λ x _ => x.rip = rip_to, rip),
                    emitted := head.emitted,
                    left := head.left,
                    held := facts.framed(state.gprs, after.gprs, s, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, refl, head.held),
                    cursor := head.cursor,
                    count := head.count,
                    out := head.out,
                    one := head.one)),
                j(sym(same), λ x _ => read_gpr(Rax, x.gprs) = b.zero_extend(56), refl))⟩⟩⟩)))
}

// Every prefix of the chunk leaves counts that fit.
fn ChunkFits<C>(shape: FilterShape<C>, s0: C, bytes: List<BitVec(8)>) → Type {
    (front, rest: List<BitVec(8)>) → front ++ rest = bytes → CountsFit(shape.counts, filter_state(shape.step, front, s0))
}

theorem filter_front_inside(front, rest: List<BitVec(8)>, b: BitVec(8), bytes: List<BitVec(8)>, prefix: front ++ Cons(b, rest) = bytes,
    fits: bytes.len() <= 4096): front.len() < 4096 {
    let whole: ((front ++ Cons(b, rest)).len() = front.len() + Succ(rest.len())) = List::len_append(front, Cons(b, rest));
    let same: ((front ++ Cons(b, rest)).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), prefix);
    omega
}

// The chunk, by recursion on what is left of it: every byte stepped and its
// output stored, then `done` at the close.
fn LoopDone<C>(shape: FilterShape<C>, c: Nat, file: IoImage, s0: C, bytes: List<BitVec(8)>, goal: MachineState<IoMemory> → Type) → Type {
    (state: MachineState<IoMemory>) → FilterAt<C>(shape, file, s0, bytes, Nil, close_rip(c, structured_bytes(shape.code).len()), state) → goal(state)
}
fn FilterLoopFrom<C>(shape: FilterShape<C>, c: Nat, file: IoImage, s0: C, bytes, back: List<BitVec(8)>, goal: MachineState<IoMemory> → Type) → Type {
    (front: List<BitVec(8)>) → (state: MachineState<IoMemory>) → front ++ back = bytes → 0 < back.len() →
    FilterAt<C>(shape, file, s0, front, back, load_rip(c), state) → goal(state)
}
theorem filter_loop<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), again: LoopAgain(structured_bytes(shape.code).len()), s0: C,
    bytes: List<BitVec(8)>, fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes), goal: MachineState<IoMemory> → Type,
    back: StepsBack(goal), done: LoopDone<C>(shape, c, file, s0, bytes, goal), left: List<BitVec(8)>):
    FilterLoopFrom(shape, c, file, s0, bytes, left, goal) {
    let p = structured_bytes(shape.code).len();
    match left {
        Nil => λ front state prefix none head => false_elim(none),
        Cons(b, rest) => λ front state prefix some head => {
            let inside = filter_front_inside(front, rest, b, bytes, prefix, fits);
            let prefix_next: ((front ++ [b]) ++ rest = bytes) = trans(List::append_assoc(front, [b], rest), prefix);
            let fits_next: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next) =
                j(filter_state_snoc(shape.step, front, b, s0), λ t _ => CountsFit(shape.counts, t), counts_fit(front ++ [b], rest, prefix_next));
            let later = filter_loop(shape, facts, c, file, placed, again, s0, bytes, fits, counts_fit, goal, back, done, rest);
            filter_byte(shape, facts, c, file, placed, again, s0, front, rest, b, inside, fits_next, goal, back,
                λ s at more => later(front ++ [b], s, prefix_next, more, at),
                λ s at none => (match rest as λ r => (front ++ [b]) ++ r = bytes → FilterAt<C>(shape, file, s0, front ++ [b], r, close_rip(c, p), s) →
                        r.len() = 0 → goal(s) {
                    Nil => λ whole closing _ => done(s, j(trans(sym(List::append_nil(front ++ [b])), whole),
                        λ f _ => FilterAt<C>(shape, file, s0, f, Nil, close_rip(c, p), s), closing)),
                    Cons(_, more) => λ _ _ zero => false_elim({ let z: (Succ(more.len()) = 0) = zero; omega }),
                })(prefix_next, at, none),
                state, head)
        },
    }
}

// ---------------------------------------------------------------------------
// One chunk, from past the head: the setup, the chunk stepped with its output
// stored in place, the close, then the output written, unless there is none.

// The read left the chunk at the page's start.
theorem filter_page_read(memory: IoMemory, bytes: List<BitVec(8)>): Stored(io_store_offset(memory, 0, bytes).page, 0, bytes) {
    stored_store(memory, 0, bytes)
}

// The close, at the JZ: R9 at the page, R10 the output's length, ZF whether
// it is empty, the page holding the output, the state the chunk left.
record FilterClosed<C>(shape: FilterShape<C>, c: Nat, file: IoImage, out: List<BitVec(8)>, s: C, closed: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: closed.memory = IoMemory(file, page),
    rip_is: closed.rip = eof_rip(fc_at_cjz(c, structured_bytes(shape.code).len())),
    emitted: Stored(page, 0, out),
    base: read_gpr(R9, closed.gprs).toNat() = io_page_base(),
    length: read_gpr(R10, closed.gprs).toNat() = out.len(),
    flag: closed.flags.zf = is_zero_bits(64, read_gpr(R10, closed.gprs)),
    held: shape.rep(closed.gprs, s),
}
fn ClosedReach<C>(shape: FilterShape<C>, c: Nat, file: IoImage, out: List<BitVec(8)>, s: C, state: MachineState<IoMemory>) → Type {
    Exists<MachineState<IoMemory>>(λ closed => LinuxSteps(io_linux(), state, closed) ∧ FilterClosed<C>(shape, c, file, out, s, closed))
}
theorem closed_back<C>(shape: FilterShape<C>, c: Nat, file: IoImage, out: List<BitVec(8)>, s: C):
    StepsBack(λ state => ClosedReach<C>(shape, c, file, out, s, state)) {
    λ before middle steps reach => Exists(reach.witness, ⟨linux_steps_trans(io_linux(), before, middle, reach.witness, steps, reach.proof.left),
        reach.proof.right⟩)
}

// The output's length, from where the write cursor stopped.
theorem filter_out_len(rdi, r9: BitVec(64), o: Nat, at_out: rdi.toNat() = io_page_base() + o, base: r9.toNat() = io_page_base()):
    rdi.sub(r9).toNat() = o {
    let difference = bitvec_nat::toNat_sub(64, rdi, r9, { omega });
    let back: ((rdi.toNat() -r9.toNat()) + r9.toNat() = rdi.toNat()) = Nat::sub_add_cancel(r9.toNat(), rdi.toNat(), { omega });
    omega
}

// The close, from the loop's end: a stretch of one item to the JZ.
theorem filter_close<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), s0: C, bytes: List<BitVec(8)>, state: MachineState<IoMemory>,
    at: FilterAt<C>(shape, file, s0, bytes, Nil, close_rip(c, structured_bytes(shape.code).len()), state)):
    ClosedReach<C>(shape, c, file, filter_emitted(shape.step, bytes, s0), filter_state(shape.step, bytes, s0), state) {
    let p = structured_bytes(shape.code).len();
    let out = filter_emitted(shape.step, bytes, s0);
    let s = filter_state(shape.step, bytes, s0);
    let closed = execute_block_normal(filter_close_block(), state);
    let base: (read_gpr(R9, closed.gprs).toNat() = io_page_base()) = BitVec::toNat_ofNat(64, io_page_base(), trivial);
    let to = eof_rip(fc_at_cjz(c, p));
    loop_straight(file, c, structured_bytes(shape.code), placed, at.page, λ x => ClosedReach<C>(shape, c, file, out, s, x), closed_back(shape, c, file, out, s),
        lf_close(p), refl, 1, state, at.rip_is, at.memory_is,
        λ e rip m same => Exists(e, ⟨Exists(Zero, refl), j(sym(same), λ x _ => FilterClosed<C>(shape, c, file, out, s, x), FilterClosed(
            page := at.page,
            memory_is := j(same, λ x _ => x.memory = IoMemory(file, at.page), m),
            rip_is := trans(j(same, λ x _ => x.rip = next_rip(eof_rip(c), prog_len(lf_close(p))), rip), rip_compose(io_entry(), c, prog_len(lf_close(p)))),
            emitted := at.emitted,
            base := base,
            length := filter_out_len(read_gpr(Rdi, state.gprs), read_gpr(R9, closed.gprs), out.len(), at.out, base),
            flag := refl,
            held := facts.framed(state.gprs, closed.gprs, s, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, refl, at.held)))⟩))
}

// The chunk from the setup: a stretch of one item, the loop, the close.
theorem filter_closed<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), c: Nat, file: IoImage,
    placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)), again: LoopAgain(structured_bytes(shape.code).len()),
    page: Nat → BitVec(8), s0: C, bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes),
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(c),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()), held: shape.rep(going.gprs, s0)):
    ClosedReach<C>(shape, c, file, filter_emitted(shape.step, bytes, s0), filter_state(shape.step, bytes, s0), going) {
    let out = filter_emitted(shape.step, bytes, s0);
    let s = filter_state(shape.step, bytes, s0);
    let goal = λ (x: MachineState<IoMemory>) => ClosedReach<C>(shape, c, file, out, s, x);
    let back = closed_back(shape, c, file, out, s);
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let ready = execute_block_normal(filter_setup_block(), going);
    let counted: (read_gpr(Rax, going.gprs).toNat() = bytes.len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, bytes.len(), count_below_word(bytes.len(), fits)));
    let page_value: (BitVec::ofNat(io_page_base(), n := 64).toNat() = io_page_base()) = BitVec::toNat_ofNat(64, io_page_base(), trivial);
    loop_straight(file, c, structured_bytes(shape.code), placed, stored.page, goal, back, lf_setup(), refl, 1, going, rip_is, memory_is,
        λ e rip m same => filter_loop(shape, facts, c, file, placed, again, s0, bytes, fits, counts_fit, goal, back,
            λ x closing => filter_close(shape, facts, c, file, placed, s0, bytes, x, closing), bytes, Nil, e, refl, some,
            j(sym(same), λ x _ => FilterAt<C>(shape, file, s0, Nil, bytes, load_rip(c), x), FilterAt(
                page := stored.page,
                memory_is := j(same, λ x _ => x.memory = IoMemory(file, stored.page), m),
                rip_is := j(same, λ x _ => x.rip = load_rip(c), rip),
                emitted := λ i byte none => false_elim(j(none, λ found _ => match found as λ _ => Type { None => True, Some(_) => False }, trivial)),
                left := filter_page_read(IoMemory(file, page), bytes),
                held := facts.framed(going.gprs, ready.gprs, s0, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, refl, held),
                cursor := page_value,
                count := counted,
                out := page_value,
                one := refl))))
}

// What a chunk's history makes: no write when it emitted nothing, else its
// output written, short writes and EINTRs and all, then `after`.
fn chunk_events(out: List<BitVec(8)>, writes: List<WriteStep>, ending: WriteEnding, after: List<LinuxEvent>) → List<LinuxEvent> {
    match out { Nil => after, Cons(_, _) => write_events_then(out, writes, ending, after) }
}
fn WritesFor(out: List<BitVec(8)>, writes: List<WriteStep>) → Type {
    match out { Nil => writes = Nil, Cons(_, _) => WriteSteps(writes, out) }
}
theorem writes_for_of(out: List<BitVec(8)>, writes: List<WriteStep>, some: 0 < out.len(), steps: WriteSteps(writes, out)): WritesFor(out, writes) {
    (match out as λ o => 0 < o.len() → WriteSteps(writes, o) → WritesFor(o, writes) {
        Nil => λ none _ => false_elim(none),
        Cons(_, _) => λ _ ok => ok,
    })(some, steps)
}

// What runs after the chunk: from the read with the state it left. Only a
// chunk whose writes all finish goes on; one whose write fails emitted
// something to write.
fn ChunkThen<C>(shape: FilterShape<C>, ar: Nat, file: IoImage, s: C, after: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.rip = eof_rip(ar) →
    state.memory = IoMemory(file, page) → shape.rep(state.gprs, s) → LinuxRuns(io_linux(), after, state)
}
fn ChunkThenIf<C>(shape: FilterShape<C>, ar: Nat, file: IoImage, s: C, out: List<BitVec(8)>, ending: WriteEnding, after: List<LinuxEvent>) → Type {
    match ending { Finished => ChunkThen(shape, ar, file, s, after), WriteFailedWith(_) => 0 < out.len() }
}

// The JZ after the close: back to the read when the chunk emitted nothing,
// else into the write loop, whose end is the read.
theorem filter_after_close<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, c: Nat,
    ar: Nat, targets: CoreTargets(c, ar, structured_bytes(shape.code).len(), jumps, pj),
    file: IoImage, pieces: (page: Nat → BitVec(8)) → FilterCore(IoMemory(file, page), c, shape.code, jumps, pj),
    out: List<BitVec(8)>, short: out.len() <= 4096, s: C, closed: MachineState<IoMemory>, at: FilterClosed<C>(shape, c, file, out, s, closed),
    writes: List<WriteStep>, written: WritesFor(out, writes), ending: WriteEnding, ending_ok: WriteEndingOk(ending), after: List<LinuxEvent>,
    then: ChunkThenIf(shape, ar, file, s, out, ending, after)):
    LinuxRuns(io_linux(), chunk_events(out, writes, ending, after), closed) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let memory = IoMemory(file, at.page);
    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.cd), closed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.cd)), memory, eof_rip(fc_at_cjz(c, p)), closed, at.memory_is, at.rip_is,
            pieces(at.page).cjz_at));
    let next = execute_near_control(JumpZeroNear(jumps.cd), closed);
    let held: shape.rep(next.gprs, s) = facts.framed(closed.gprs, next.gprs, s, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, refl, at.held);
    (match out as λ o => Stored(at.page, 0, o) → read_gpr(R10, closed.gprs).toNat() = o.len() → o.len() <= 4096 → WritesFor(o, writes) →
            ChunkThenIf(shape, ar, file, s, o, ending, after) → LinuxRuns(io_linux(), chunk_events(o, writes, ending, after), closed) {
        Nil => λ _ none _ _ go => {
            let taken: (closed.flags.zf = True) = trans(at.flag, zero_bits_of_zero(64, read_gpr(R10, closed.gprs), none));
            let back: (next.rip = eof_rip(ar)) =
                trans(near_taken_rip(jumps.cd, closed, taken),
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.cd), at.rip_is), targets.quiet));
            (match ending as λ en => ChunkThenIf(shape, ar, file, s, Nil, en, after) → LinuxRuns(io_linux(), after, closed) {
                Finished => λ go => linux_runs_after_steps(io_linux(), after, closed, next, fetched_steps_one(fetch, data, closed, next, jz),
                    go(at.page, next, back, at.memory_is, held)),
                WriteFailedWith(_) => λ never => false_elim(never),
            })(go)
        },
        Cons(d, more) => λ stored length short written go => {
            let o = Cons(d, more);
            let passed: (closed.flags.zf = False) =
                trans(at.flag, zero_bits_of_pos(64, read_gpr(R10, closed.gprs), j(sym(length), λ v _ => 0 < v, trivial)));
            let on: (next.rip = eof_rip(fc_at_write(c, p))) =
                trans(near_not_taken_rip(jumps.cd, closed, passed), rip_advance(io_entry(), closed.rip, fc_at_cjz(c, p), 6, at.rip_is));
            let sends: LinuxWritesFrom(io_linux(), memory, read_gpr(R9, next.gprs), o) =
                stored_sends(memory, 0, o, stored, read_gpr(R9, next.gprs), at.base, page_sends(o.len(), short));
            let room: (read_gpr(R9, next.gprs).toNat() + o.len() < Nat::pow(2, 64)) =
                page_sends_room(read_gpr(R9, next.gprs).toNat(), o.len(), at.base, short);
            let finished: FinishedThen(ending, memory, ar, after, next.gprs) =
                (match ending as λ en => ChunkThenIf(shape, ar, file, s, o, en, after) → FinishedThen(en, memory, ar, after, next.gprs) {
                    Finished => λ go => λ state at_read in_page kept => go(at.page, state, at_read, in_page,
                        facts.framed(next.gprs, state.gprs, s,
                            ⟨kept.right.right.left, ⟨kept.right.right.right.left, ⟨kept.right.right.right.right.left, kept.left⟩⟩⟩,
                            kept.right.right.right.right.right.right, held)),
                    WriteFailedWith(_) => λ _ => trivial,
                })(go);
            linux_runs_after_steps(io_linux(), chunk_events(o, writes, ending, after), closed, next, fetched_steps_one(fetch, data, closed, next, jz),
                wl_from_then(memory, fc_at_write(c, p), pj, ar, pieces(at.page).write, targets.write, after, ending, ending_ok, next.gprs,
                    finished, writes)(o, written, next, trivial, short, on, at.memory_is, sends, length, room, write_kept_refl(next.gprs)))
        },
    })(at.emitted, at.length, short, written, then)
}

// One chunk, from past the head: the setup, the chunk, the close, its
// output written.
theorem filter_chunk<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, c: Nat,
    ar: Nat, targets: CoreTargets(c, ar, structured_bytes(shape.code).len(), jumps, pj),
    file: IoImage, pieces: (page: Nat → BitVec(8)) → FilterCore(IoMemory(file, page), c, shape.code, jumps, pj),
    page: Nat → BitVec(8), s0: C, bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes),
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(c),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()), held: shape.rep(going.gprs, s0),
    writes: List<WriteStep>, written: WritesFor(filter_emitted(shape.step, bytes, s0), writes),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), after: List<LinuxEvent>,
    then: ChunkThenIf(shape, ar, file, filter_state(shape.step, bytes, s0), filter_emitted(shape.step, bytes, s0), ending, after)):
    LinuxRuns(io_linux(), chunk_events(filter_emitted(shape.step, bytes, s0), writes, ending, after), going) {
    let out = filter_emitted(shape.step, bytes, s0);
    let placed: Placed(file, loop_bytes(structured_bytes(shape.code)), eof_rip(c)) = λ pg => pieces(pg).loop_at;
    have closed = filter_closed(shape, facts, c, file, placed, targets.again, page, s0, bytes, some, fits, counts_fit,
        going, memory_is, rip_is, length_word, held);
    let short: (out.len() <= 4096) = Nat::le_trans(out.len(), bytes.len(), 4096, filter_emitted_len(shape.step, bytes, s0), fits);
    linux_runs_after_linux_steps(io_linux(), chunk_events(out, writes, ending, after), going, closed.witness, closed.proof.left,
        filter_after_close(shape, facts, jumps, pj, c, ar, targets, file, pieces, out, short, filter_state(shape.step, bytes, s0),
            closed.witness, closed.proof.right, writes, written, ending, ending_ok, after, then))
}

// ---------------------------------------------------------------------------
// The histories, the process, and what the run sends.

// A chunk's output: what its bytes emit from the state the input before it
// left.
fn chunk_out<C>(shape: FilterShape<C>, seen, bytes: List<BitVec(8)>) → List<BitVec(8)> {
    filter_emitted(shape.step, bytes, filter_state(shape.step, seen, shape.init))
}
fn filter_body<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → List<WriteStep> → List<LinuxEvent> → List<LinuxEvent> {
    λ seen bytes writes after => chunk_events(chunk_out(shape, seen, bytes), writes, Finished, after)
}
fn filter_ok<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → List<WriteStep> → Type {
    λ seen bytes writes => WritesFor(chunk_out(shape, seen, bytes), writes)
}
fn filter_failed<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → WriteFailure → List<LinuxEvent> {
    λ seen bytes failure => chunk_events(chunk_out(shape, seen, bytes), failure.writes, WriteFailedWith(failure.errno), Nil)
}
fn filter_failed_ok<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → WriteFailure → Type {
    λ seen bytes failure => (0 < chunk_out(shape, seen, bytes).len()) ∧ (WriteSteps(failure.writes, chunk_out(shape, seen, bytes)) ∧
        (Errno(failure.errno) ∧ Not(failure.errno = eintr())))
}
// A run's events: each chunk read and its output written; at end of file,
// the finish's `tail`.
fn filter_events<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>, ending: EofEnd<WriteFailure>, tail: List<LinuxEvent>) → List<LinuxEvent> {
    eof_run(BitVec::ofNat(0), filter_body(shape), filter_failed(shape), read_exits(), steps, ending, tail, Nil)
}
fn FilterSteps<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>) → Type { EofSteps(filter_ok(shape), steps, Nil) }
fn FilterEndingOk<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>, ending: EofEnd<WriteFailure>) → Type {
    EofEndOk(filter_failed_ok(shape), eof_input(steps), ending)
}

// The fold's invariant at the read: the state the input so far left sits in
// the state registers.
fn filter_inv<C>(shape: FilterShape<C>) → List<BitVec(8)> → Gprs → Type {
    λ seen gprs => shape.rep(gprs, filter_state(shape.step, seen, shape.init))
}

theorem chunk_within(seen, front, back, bytes, rest, input: List<BitVec(8)>, chunk: front ++ back = bytes,
    prefix: seen ++ (bytes ++ rest) = input): (seen ++ front).len() <= input.len() + 4096 {
    let a = List::len_append(seen, front);
    let b: ((front ++ back).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), chunk);
    let c = List::len_append(front, back);
    let d: ((seen ++ (bytes ++ rest)).len() = input.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), prefix);
    let e = List::len_append(seen, bytes ++ rest);
    let f = List::len_append(bytes, rest);
    omega
}
theorem ended_within(seen, front, back, bytes, input: List<BitVec(8)>, chunk: front ++ back = bytes, fits: bytes.len() <= 4096,
    all: seen = input): (seen ++ front).len() <= input.len() + 4096 {
    let a = List::len_append(seen, front);
    let b: ((front ++ back).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), chunk);
    let c = List::len_append(front, back);
    let d: (seen.len() = input.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), all);
    omega
}
// A chunk's prefixes leave counts that fit, given room for the input.
theorem chunk_fits<C>(shape: FilterShape<C>, facts: LoopFacts<C>(shape), input, seen, bytes: List<BitVec(8)>, room: FilterRoom(shape.counts, input),
    within: (front, back: List<BitVec(8)>) → front ++ back = bytes → (seen ++ front).len() <= input.len() + 4096):
    ChunkFits(shape, filter_state(shape.step, seen, shape.init), bytes) {
    λ front back chunk => j(filter_state_append(shape.step, seen, front, shape.init), λ t _ => CountsFit(shape.counts, t),
        room_fits(shape, facts, input, seen ++ front, room, within(front, back, chunk)))
}

// The process for the driver: the fold's invariant, a chunk stepped and its
// output written, a chunk whose write fails, and at end of file the finish.
theorem filter_process<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    done: Nat, targets: FilterTargets(structured_bytes(shape.code).len(), done, jumps, pj),
    file: IoImage, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    input: List<BitVec(8)>, room: FilterRoom(shape.counts, input), tail_events: List<LinuxEvent>,
    tail: EofTail(file, done, shape.rep, filter_state(shape.step, input, shape.init), tail_events)):
    EofProcess<List<WriteStep>, WriteFailure>(FdStdin, BitVec::ofNat(0), file, fl_at_read(structured_bytes(shape.code).len()), fl_at_failed(structured_bytes(shape.code).len()),
        done, filter_inv(shape), input, filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape), read_exits(), tail_events) {
    let loop = loop_facts(shape, facts);
    let core = λ (pg: Nat → BitVec(8)) => pieces(pg).core;
    EofProcess(
        reads := λ _ _ _ => refl,
        framed := λ seen before after kept held => facts.framed(before, after, filter_state(shape.step, seen, shape.init),
            ⟨kept.right.right.right.right.right.right.left, ⟨kept.right.right.right.right.right.right.right.left,
                ⟨kept.right.right.right.right.right.right.right.right, kept.right.right.left⟩⟩⟩, held),
        chunk := λ page seen bytes rest writes some fits written prefix going rip_is memory_is length_word held after next =>
            filter_chunk(shape, loop, jumps, pj, fl_at_setup(structured_bytes(shape.code).len()), fl_at_read(structured_bytes(shape.code).len()),
                targets.core, file, core, page, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(shape, loop, input, seen, bytes, room, λ front back chunk => chunk_within(seen, front, back, bytes, rest, input, chunk, prefix)),
                going, memory_is, rip_is, length_word, held, writes, written, Finished, trivial, after,
                λ next_page state at_read in_page placed => next(next_page, state, at_read, in_page,
                    j(sym(filter_state_append(shape.step, seen, bytes, shape.init)), λ t _ => shape.rep(state.gprs, t), placed))),
        ends := λ page seen bytes failure some fits failed all going rip_is memory_is length_word held =>
            filter_chunk(shape, loop, jumps, pj, fl_at_setup(structured_bytes(shape.code).len()), fl_at_read(structured_bytes(shape.code).len()),
                targets.core, file, core, page, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(shape, loop, input, seen, bytes, room, λ front back chunk => ended_within(seen, front, back, bytes, input, chunk, fits, all)),
                going, memory_is, rip_is, length_word, held, failure.writes,
                writes_for_of(chunk_out(shape, seen, bytes), failure.writes, failed.left, failed.right.left),
                WriteFailedWith(failure.errno), failed.right.right, Nil, failed.left),
        fails := tail_exits(file, fl_at_failed(structured_bytes(shape.code).len()), jumps.rd, λ page => pieces(page).fail, filter_inv(shape), input),
        at_end := λ page state at_done in_page placed => tail(page, state, at_done, in_page, placed))
}

// What stdout received on a run that ends at the empty read: what the input
// emitted, from the state what was read before the history left, then what
// the finish sent.
theorem chunk_sends(out: List<BitVec(8)>, writes: List<WriteStep>, after: List<LinuxEvent>, written: WritesFor(out, writes)):
    sent_to(BitVec::ofNat(1), chunk_events(out, writes, Finished, after)) = out ++ sent_to(BitVec::ofNat(1), after) {
    (match out as λ o => WritesFor(o, writes) → sent_to(BitVec::ofNat(1), chunk_events(o, writes, Finished, after)) = o ++ sent_to(BitVec::ofNat(1), after) {
        Nil => λ _ => refl,
        Cons(c, more) => λ ok => stdout_then(writes, after, Cons(c, more), ok),
    })(written)
}
theorem filter_sends_from<C>(shape: FilterShape<C>, tail: List<LinuxEvent>, steps: List<EofStep<List<WriteStep>>>):
    (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), steps, seen) →
    sent_to(BitVec::ofNat(1), eof_run(BitVec::ofNat(0), filter_body(shape), filter_failed(shape), read_exits(), steps, AtEnd, tail, seen)) =
        filter_emitted(shape.step, eof_input(steps), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
    match steps as λ ss => (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), ss, seen) →
            sent_to(BitVec::ofNat(1), eof_run(BitVec::ofNat(0), filter_body(shape), filter_failed(shape), read_exits(), ss, AtEnd, tail, seen)) =
                filter_emitted(shape.step, eof_input(ss), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
        Nil => λ seen _ => refl,
        Cons(step, rest) => match step as λ st => (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), Cons(st, rest), seen) →
                sent_to(BitVec::ofNat(1), eof_run(BitVec::ofNat(0), filter_body(shape), filter_failed(shape), read_exits(), Cons(st, rest), AtEnd, tail, seen)) =
                    filter_emitted(shape.step, eof_input(Cons(st, rest)), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
            Chunk(bytes, writes) => λ seen ok => {
                let s = filter_state(shape.step, seen, shape.init);
                let out = filter_emitted(shape.step, bytes, s);
                let later = eof_run(BitVec::ofNat(0), filter_body(shape), filter_failed(shape), read_exits(), rest, AtEnd, tail, seen ++ bytes);
                let rest_out = filter_emitted(shape.step, eof_input(rest), filter_state(shape.step, seen ++ bytes, shape.init));
                let moved: (filter_state(shape.step, seen ++ bytes, shape.init) = filter_state(shape.step, bytes, s)) =
                    filter_state_append(shape.step, seen, bytes, shape.init);
                trans(chunk_sends(out, writes, later, ok.right.right.left),
                    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ t => out ++ t, filter_sends_from(shape, tail, rest, seen ++ bytes, ok.right.right.right)),
                        trans(sym(List::append_assoc(out, rest_out, sent_to(BitVec::ofNat(1), tail))),
                            cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ e => e ++ sent_to(BitVec::ofNat(1), tail),
                                trans(cong_fn<C, List<BitVec(8)>>(λ t => out ++ filter_emitted(shape.step, eof_input(rest), t), moved),
                                    sym(filter_emitted_append(shape.step, bytes, eof_input(rest), s)))))))
            },
            Interrupted => λ seen ok => filter_sends_from(shape, tail, rest, seen, ok),
        },
    }
}
theorem filter_sends<C>(shape: FilterShape<C>, tail: List<LinuxEvent>, steps: List<EofStep<List<WriteStep>>>, ok: FilterSteps(shape, steps)):
    sent_to(BitVec::ofNat(1), filter_events(shape, steps, AtEnd, tail)) =
        filter_emitted(shape.step, eof_input(steps), shape.init) ++ sent_to(BitVec::ofNat(1), tail) {
    filter_sends_from(shape, tail, steps, Nil, ok)
}

// The run: init, then the driver over the process, from the entry.
theorem read_filter_runs<C>(file: IoImage, shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps,
    finish: List<BitVec(8)>, done: Nat, jump_facts: FilterJumpFacts(structured_bytes(shape.code).len(), done, jumps, pj),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), filter_code(shape.code, jumps, pj, finish), io_entry()),
    steps: List<EofStep<List<WriteStep>>>, ok: FilterSteps(shape, steps), ending: EofEnd<WriteFailure>, ending_ok: FilterEndingOk(shape, steps, ending),
    room: FilterRoom(shape.counts, eof_input(steps)), tail_events: List<LinuxEvent>,
    tail: EofTail(file, done, shape.rep, filter_state(shape.step, eof_input(steps), shape.init), tail_events),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), filter_events(shape, steps, ending, tail_events), io_initial(file, page, gprs, flags)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let input = eof_input(steps);
    let pieces = λ (pg: Nat → BitVec(8)) => filter_pieces(IoMemory(file, pg), shape.code, jumps, pj, finish, resident(pg));
    let targets = filter_targets(p, done, jumps, pj, jump_facts);
    let begin = io_initial(file, page, gprs, flags);
    let started = block_fetched(fetch, data, state_init_block(), begin, trivial, pieces(page).init_at);
    let ready = execute_block_normal(state_init_block(), begin);
    let layout: EofLayout(FdStdin, file, fl_at_read(p), fl_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd) =
        EofLayout(λ pg => pieces(pg).head, λ pg => fail_tail_retries(IoMemory(file, pg), fl_at_failed(p), jumps.rd, pieces(pg).fail), targets.finish, targets.fail, targets.retry);
    linux_runs_after_steps(io_linux(), filter_events(shape, steps, ending, tail_events), begin, ready, started.left,
        eof_from(FdStdin, BitVec::ofNat(0), file, fl_at_read(p), fl_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd, layout, filter_inv(shape), input,
            filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape), read_exits(), tail_events,
            filter_process(shape, facts, jumps, pj, finish, done, targets, file, pieces, input, room, tail_events, tail),
            ending, ending_ok, steps)(Nil, ok, page, refl, ready, started.right, refl, facts.initialised(begin)))
}

// ---------------------------------------------------------------------------
// The finishes: the library's tails, at the end of the program.

// Nothing more: the write loop's own exit(0).
theorem filter_quiet_tail<C>(shape: FilterShape<C>, jumps: FilterJumps, pj: PrintJumps, file: IoImage,
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, Nil), total: C):
    EofTail(file, wl_at_exit(fl_at_write(structured_bytes(shape.code).len())), shape.rep, total, [ExitEvent(BitVec::ofNat(0))]) {
    λ page state at_done in_page _ => wl_exit(IoMemory(file, page), fl_at_write(structured_bytes(shape.code).len()), pj, pieces(page).core.write,
        state.gprs, state, at_done, in_page, write_kept_refl(state.gprs))
}

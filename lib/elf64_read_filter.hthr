// The read profile's one process (docs/native-stream-filter-design.md §4): a
// stream filter. Read stdin a page at a time; run the program's step over
// each byte of the chunk, the state in its registers (R13, R14, R15, R8) and
// whatever the byte emits stored behind the read cursor in the same page;
// write what the chunk emitted, if anything, and read again; at end of file
// run the program's finish. Failed reads and writes are elf64_read_pieces's
// and elf64_write_loop's: EINTR retries, anything else exits 1. The step is
// the program's, a generated piece (filter_step_piece's `StepPiece`); the
// loop around it, the process and the claim are proved here once.
import filter_step_piece;
import stream_filter;
import elf64_write_loop;
import elf64_print_pieces;
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_structured_block;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The code.

// After a read of n > 0 bytes: the read cursor at the page, n to go, the
// write cursor at the page, and the step's 1.
fn filter_setup_block() → List<Instruction> {
    [MovRI(Rsi, BitVec::ofNat(io_page_base())), MovRR(Rcx, Rax), MovRI(Rdi, BitVec::ofNat(io_page_base())), MovRI(R12, BitVec::ofNat(1))]
}
fn filter_load() → ByteLoad { ByteLoad(destination := Rax, base := Rsi) }
// The emitted byte, stored at the write cursor whether or not it is emitted:
// the cursor never passes the byte just loaded, so nothing still to be read
// is overwritten, and the flag says whether the cursor moves past it.
fn filter_store() → ByteStore { ByteStore(base := Rdi, source := Rdx) }
// The write cursor on by the flag, the read cursor on by one, one fewer to
// go; ZF says whether none is.
fn filter_advance_block() → List<Instruction> { [AddRR(Rdi, Rbx), AddRR(Rsi, R12), SubRR(Rcx, R12)] }
// The chunk's output for the write loop: from the page, as long as the write
// cursor has moved; ZF says whether it is empty.
fn filter_close_block() → List<Instruction> {
    [MovRR(R10, Rdi), MovRI(R9, BitVec::ofNat(io_page_base())), SubRR(R10, R9)]
}

fn filter_setup_len() → Nat { canonical_block_bytes(filter_setup_block()).len() }
fn filter_load_len() → Nat { byte_load_bytes(filter_load()).len() }
fn filter_advance_len() → Nat { canonical_block_bytes(filter_advance_block()).len() }
fn filter_close_len() → Nat { canonical_block_bytes(filter_close_block()).len() }

// The jumps: JZ to the finish at end of file, JS to the failure path, JNZ
// back to the next byte, JZ back to the read when a chunk emitted nothing,
// JZ back to the read after EINTR.
record FilterJumps { ed: BitVec(32), sd: BitVec(32), ld: BitVec(32), cd: BitVec(32), rd: BitVec(32) }

// The program: init, the read head (elf64_read_pieces), the setup, the loop
// over the chunk (load, step, store, advance, JNZ), the close and its JZ, the
// write loop (whose end jumps back to the read), the failure tail, then the
// finish. A layout (x86_64_layout) whose step is measured by its length `p`.
fn filter_parts(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps) → List<List<BitVec(8)>> {
    [canonical_block_bytes(state_init_block()), read_head_code(jumps.ed, jumps.sd), canonical_block_bytes(filter_setup_block()),
     byte_load_bytes(filter_load()), structured_bytes(code), byte_store_bytes(filter_store()), canonical_block_bytes(filter_advance_block()),
     near_control_bytes(JumpIfNear(NE, jumps.ld)), canonical_block_bytes(filter_close_block()), near_control_bytes(JumpZeroNear(jumps.cd)),
     write_loop_code(pj), fail_tail_code(jumps.rd)]
}
fn filter_lens(p: Nat) → List<Nat> {
    [state_init_len(), read_head_len(), filter_setup_len(), filter_load_len(), p, 3, filter_advance_len(), 6, filter_close_len(), 6,
     write_loop_len(), fail_tail_len()]
}
fn filter_code(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>) → List<BitVec(8)> {
    layout_code(filter_parts(code, jumps, pj), finish)
}
theorem filter_measured(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, p: Nat, p_is: structured_bytes(code).len() = p):
    LayoutMeasured(filter_parts(code, jumps, pj), filter_lens(p)) {
    ⟨refl, ⟨read_head_code_len(jumps.ed, jumps.sd), ⟨refl, ⟨refl, ⟨p_is, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨write_loop_code_len(pj),
        ⟨fail_tail_code_len(jumps.rd), trivial⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
}
// The code's length from the step's and the finish's, over open parts.
theorem filter_code_len(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>, p, finish_len: Nat,
    p_is: structured_bytes(code).len() = p, finish_is: finish.len() = finish_len):
    filter_code(code, jumps, pj, finish).len() = layout_end(0, filter_lens(p)) + finish_len {
    layout_len(filter_parts(code, jumps, pj), finish, filter_lens(p), filter_measured(code, jumps, pj, p, p_is), finish_len, finish_is)
}

// Where each piece starts, from the entry, for a step `p` bytes long.
fn fl_at(p, i: Nat) → Nat { layout_at(0, filter_lens(p), i) }
fn fl_at_read(p: Nat) → Nat { fl_at(p, 1) }
fn fl_at_setup(p: Nat) → Nat { fl_at(p, 2) }
fn fl_at_load(p: Nat) → Nat { fl_at(p, 3) }
fn fl_at_step(p: Nat) → Nat { fl_at(p, 4) }
fn fl_at_store(p: Nat) → Nat { fl_at(p, 5) }
fn fl_at_advance(p: Nat) → Nat { fl_at(p, 6) }
fn fl_at_jnz(p: Nat) → Nat { fl_at(p, 7) }
fn fl_at_close(p: Nat) → Nat { fl_at(p, 8) }
fn fl_at_cjz(p: Nat) → Nat { fl_at(p, 9) }
fn fl_at_write(p: Nat) → Nat { fl_at(p, 10) }
fn fl_at_failed(p: Nat) → Nat { fl_at(p, 11) }
fn fl_at_finish(p: Nat) → Nat { fl_at(p, 12) }
fn fl_at_retry(p: Nat) → Nat { ft_at_jz(fl_at_failed(p)) }

// The program's pieces, resident at their offsets.
record FilterPieces(memory: IoMemory, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>) {
    init_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(state_init_block()), eof_rip(fl_at(structured_bytes(code).len(), 0))),
    head: ReadHead(memory, fl_at_read(structured_bytes(code).len()), jumps.ed, jumps.sd),
    setup_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(filter_setup_block()), eof_rip(fl_at_setup(structured_bytes(code).len()))),
    load_at: CodeResident(io_fetch_access(), memory, byte_load_bytes(filter_load()), eof_rip(fl_at_load(structured_bytes(code).len()))),
    step_at: CodeResident(io_fetch_access(), memory, structured_bytes(code), eof_rip(fl_at_step(structured_bytes(code).len()))),
    store_at: CodeResident(io_fetch_access(), memory, byte_store_bytes(filter_store()), eof_rip(fl_at_store(structured_bytes(code).len()))),
    advance_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(filter_advance_block()), eof_rip(fl_at_advance(structured_bytes(code).len()))),
    jnz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpIfNear(NE, jumps.ld)), eof_rip(fl_at_jnz(structured_bytes(code).len()))),
    close_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(filter_close_block()), eof_rip(fl_at_close(structured_bytes(code).len()))),
    cjz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(jumps.cd)), eof_rip(fl_at_cjz(structured_bytes(code).len()))),
    write: WriteLoopResident(memory, fl_at_write(structured_bytes(code).len()), pj),
    fail: FailTail(memory, fl_at_failed(structured_bytes(code).len()), jumps.rd),
    finish_at: CodeResident(io_fetch_access(), memory, finish, eof_rip(fl_at_finish(structured_bytes(code).len()))),
}

theorem filter_pieces(memory: IoMemory, code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    resident: CodeResident(io_fetch_access(), memory, filter_code(code, jumps, pj, finish), io_entry())):
    FilterPieces(memory, code, jumps, pj, finish) {
    let p = structured_bytes(code).len();
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), finish, filter_parts(code, jumps, pj), filter_lens(p),
        filter_measured(code, jumps, pj, p, refl), 0, resident);
    FilterPieces(piece(0), read_head(memory, fl_at_read(p), jumps.ed, jumps.sd, piece(1)), piece(2), piece(3), piece(4), piece(5), piece(6),
        piece(7), piece(8), piece(9), write_loop_resident(memory, fl_at_write(p), pj, piece(10)), fail_tail(memory, fl_at_failed(p), jumps.rd, piece(11)),
        piece(12))
}

// ---------------------------------------------------------------------------
// The jumps' targets, from a closed fact about each displacement that the
// producer proves at the written bytes. The finish starts at `done`: the
// write loop's own exit(0) for a program that prints nothing more, or the
// finish's first byte.

record FilterTargets(p, done: Nat, jumps: FilterJumps, pj: PrintJumps) {
    finish: near_branch_target(eof_rip(rh_at_jz(fl_at_read(p))), 6, jumps.ed) = eof_rip(done),
    fail: near_branch_target(eof_rip(rh_at_js(fl_at_read(p))), 6, jumps.sd) = eof_rip(fl_at_failed(p)),
    again: near_branch_target(eof_rip(fl_at_jnz(p)), 6, jumps.ld) = eof_rip(fl_at_load(p)),
    quiet: near_branch_target(eof_rip(fl_at_cjz(p)), 6, jumps.cd) = eof_rip(fl_at_read(p)),
    retry: near_branch_target(eof_rip(fl_at_retry(p)), 6, jumps.rd) = eof_rip(fl_at_read(p)),
    write: WriteLoopTargets(fl_at_write(p), fl_at_read(p), pj),
}
record FilterJumpFacts(p, done: Nat, jumps: FilterJumps, pj: PrintJumps) {
    finish: JumpsForward(rh_at_jz(fl_at_read(p)), 6, jumps.ed, done),
    fail: JumpsForward(rh_at_js(fl_at_read(p)), 6, jumps.sd, fl_at_failed(p)),
    again: JumpsBack(fl_at_jnz(p), 6, jumps.ld, fl_at_load(p)),
    quiet: JumpsBack(fl_at_cjz(p), 6, jumps.cd, fl_at_read(p)),
    retry: JumpsBack(fl_at_retry(p), 6, jumps.rd, fl_at_read(p)),
    write: WriteJumpFacts(pj),
    write_read: JumpsBack(wl_at_wjz(fl_at_write(p)), 6, pj.zd, fl_at_read(p)),
}
theorem filter_targets(p, done: Nat, jumps: FilterJumps, pj: PrintJumps, facts: FilterJumpFacts(p, done, jumps, pj)):
    FilterTargets(p, done, jumps, pj) {
    let entry = io_entry();
    FilterTargets(
        finish := jumps_forward(entry, rh_at_jz(fl_at_read(p)), 6, jumps.ed, done, facts.finish),
        fail := jumps_forward(entry, rh_at_js(fl_at_read(p)), 6, jumps.sd, fl_at_failed(p), facts.fail),
        again := jumps_back(entry, fl_at_jnz(p), 6, jumps.ld, fl_at_load(p), facts.again),
        quiet := jumps_back(entry, fl_at_cjz(p), 6, jumps.cd, fl_at_read(p), facts.quiet),
        retry := jumps_back(entry, fl_at_retry(p), 6, jumps.rd, fl_at_read(p), facts.retry),
        write := write_targets_to(fl_at_write(p), fl_at_read(p), pj, facts.write,
            jumps_back(entry, wl_at_wjz(fl_at_write(p)), 6, pj.zd, fl_at_read(p), facts.write_read)))
}

// ---------------------------------------------------------------------------
// A program, as the process takes it: its data (the step, the initial state,
// its counts, its placement over the state registers, the step's code), and
// what the producer proves of them. Two records, so the data's fields are
// independent of each other (a record whose fields depend on earlier ones is
// costly at every projection).

record FilterShape<C> {
    step: C → BitVec(8) → Filtered<C>,
    init: C,
    counts: List<C → Nat>,
    rep: Gprs → C → Type,
    code: StructuredCode,
}
record FilterFacts<C>(shape: FilterShape<C>) {
    piece: StepPiece<IoMemory, C>(shape.code, shape.rep, shape.counts, shape.step),
    framed: StateFramed(shape.rep),
    initialised: StateInitialised(shape.rep, shape.init),
    advances: (state: C) → (byte: BitVec(8)) → counts_advance(shape.counts, shape.step(state, byte).next, state),
    zero: CountsAtMost(shape.counts, shape.init, 0),
}

// Each of `counts` is at most `n`.
fn CountsAtMost<C>(counts: List<C → Nat>, s: C, n: Nat) → Type {
    match counts {
        Nil => True,
        Cons(count, rest) => (count(s) <= n) ∧ CountsAtMost(rest, s, n),
    }
}

// ---------------------------------------------------------------------------
// The counts fit their words: each grows by at most one per byte from zero,
// so after `n` bytes it is at most `n`.

// Over Nats, so omega sees atoms rather than a count applied.
theorem le_succ_of(a, b, n: Nat, grew: a <= Succ(b), below: b <= n): a <= Succ(n) { omega }
theorem lt_of_le_below(a, n, m: Nat, below: a <= n, small: n < m): a < m { omega }

theorem counts_step<C>(counts: List<C → Nat>): (next, s: C) → (n: Nat) → counts_advance(counts, next, s) → CountsAtMost(counts, s, n) →
    CountsAtMost(counts, next, Succ(n)) {
    match counts {
        Nil => λ next s n _ _ => trivial,
        Cons(count, rest) => (match rest as λ r => ((next, s: C) → (n: Nat) → counts_advance(r, next, s) → CountsAtMost(r, s, n) →
                    CountsAtMost(r, next, Succ(n))) →
                (next, s: C) → (n: Nat) → counts_advance(Cons(count, r), next, s) →
                CountsAtMost(Cons(count, r), s, n) → CountsAtMost(Cons(count, r), next, Succ(n)) {
            Nil => λ _ next s n grew below => ⟨le_succ_of(count(next), count(s), n, grew, below.left), trivial⟩,
            Cons(c, more) => λ later next s n grew below =>
                ⟨le_succ_of(count(next), count(s), n, grew.left, below.left), later(next, s, n, grew.right, below.right)⟩,
        })(counts_step(rest)),
    }
}
theorem counts_grow<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), bytes: List<BitVec(8)>):
    (s: C) → (n: Nat) → CountsAtMost(shape.counts, s, n) → CountsAtMost(shape.counts, filter_state(shape.step, bytes, s), n + bytes.len()) {
    match bytes {
        Nil => λ s n below => below,
        Cons(byte, rest) => λ s n below => {
            let next = shape.step(s, byte).next;
            let stepped = counts_step(shape.counts, next, s, n, facts.advances(s, byte), below);
            let later = counts_grow(shape, facts, rest, next, Succ(n), stepped);
            let same: (Succ(n) + rest.len() = n + Cons(byte, rest).len()) = omega;
            j(same, λ k _ => CountsAtMost(shape.counts, filter_state(shape.step, rest, next), k), later)
        },
    }
}
theorem counts_fit<C>(counts: List<C → Nat>, s: C, n: Nat, small: n < Nat::pow(2, 64)): CountsAtMost(counts, s, n) → CountsFit(counts, s) {
    match counts as λ cs => CountsAtMost(cs, s, n) → CountsFit(cs, s) {
        Nil => λ _ => trivial,
        Cons(count, rest) => λ below => ⟨lt_of_le_below(count(s), n, Nat::pow(2, 64), below.left, small), counts_fit(rest, s, n, small, below.right)⟩,
    }
}

// Room for the counts: none is needed when there are none, so a filter
// without counts has a claim for any input.
fn FilterRoom<C>(counts: List<C → Nat>, input: List<BitVec(8)>) → Type {
    match counts { Nil => True, Cons(_, _) => input.len() + 4096 < Nat::pow(2, 64) }
}
// Every state the input passes through has counts that fit, and so does a
// chunk read past it (one that ends the run in a failed write).
theorem room_fits<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), input, seen: List<BitVec(8)>,
    room: FilterRoom(shape.counts, input), within: seen.len() <= input.len() + 4096):
    CountsFit(shape.counts, filter_state(shape.step, seen, shape.init)) {
    (match shape.counts as λ cs => FilterRoom(cs, input) → CountsAtMost(cs, filter_state(shape.step, seen, shape.init), 0 + seen.len()) →
            CountsFit(cs, filter_state(shape.step, seen, shape.init)) {
        Nil => λ _ _ => trivial,
        Cons(count, rest) => λ big below => counts_fit(Cons(count, rest), filter_state(shape.step, seen, shape.init), 0 + seen.len(),
            { let r: (input.len() + 4096 < Nat::pow(2, 64)) = big; omega }, below),
    })(room, counts_grow(shape, facts, seen, shape.init, 0, facts.zero))
}

// ---------------------------------------------------------------------------
// One chunk's loop. At `at` with `front` of the chunk done and `back` to go:
// the page holds what `front` emitted from its start and `back` where it
// was read, the state registers hold the state `front` left, RSI is at the
// next byte, RCX counts what is left, RDI is past the output, R12 is 1.

record FilterAt<C>(shape: FilterShape<C>, file: List<BitVec(8)>, s0: C, front, back: List<BitVec(8)>, at: Nat, state: MachineState<IoMemory>) {
    page: Nat → BitVec(8),
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = eof_rip(at),
    emitted: Stored(page, 0, filter_emitted(shape.step, front, s0)),
    left: Stored(page, front.len(), back),
    held: shape.rep(state.gprs, filter_state(shape.step, front, s0)),
    cursor: read_gpr(Rsi, state.gprs).toNat() = io_page_base() + front.len(),
    count: read_gpr(Rcx, state.gprs).toNat() = back.len(),
    out: read_gpr(Rdi, state.gprs).toNat() = io_page_base() + filter_emitted(shape.step, front, s0).len(),
    one: read_gpr(R12, state.gprs) = BitVec::ofNat(1),
}

// A step piece's run from offset `at`, where its bytes are resident
// (elf64_print_pieces's `piece_runs`, for the step's certificate).
theorem step_runs<C>(code: StructuredCode, before: MachineState<IoMemory>, rep: Gprs → C → Type, out: Filtered<C>,
    ran: StepRan<IoMemory, C>(code, before, rep, out), stored: IoMemory, at: Nat,
    resident: CodeResident(io_fetch_access(), stored, structured_bytes(code), eof_rip(at)),
    memory_is: before.memory = stored, rip_is: before.rip = eof_rip(at)):
    PieceRan(stored, at + structured_bytes(code).len(), before, ran.after) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let went = structured_fetched(fetch, data, code, before, ran.layout,
        resident_state(fetch, structured_bytes(code), stored, eof_rip(at), before, memory_is, rip_is, resident));
    PieceRan(
        steps := j(sym(ran.execution), λ after _ => FetchedSteps(fetch, data, before, after), went.left),
        memory_is := trans(ran.memory_preserved, memory_is),
        rip_is := trans(ran.rip_correct, rip_advance(io_entry(), before.rip, at, structured_bytes(code).len(), rip_is)))
}

// The flag's value is how many bytes the step emitted.
theorem emit_flag_value(emit: Option<BitVec(8)>): emit_flag(emit).toNat() = emitted_byte(emit).len() {
    match emit as λ e => emit_flag(e).toNat() = emitted_byte(e).len() { None => refl, Some(_) => refl }
}
// The byte stored is the emitted one, when one is.
fn emit_low(emit: Option<BitVec(8)>) → BitVec(8) { imm_byte0(emit_word(emit)) }
theorem emit_low_is(emit: Option<BitVec(8)>, x: BitVec(8), some: emit = Some(x)): emit_low(emit) = x {
    j(sym(some), λ e _ => emit_low(e) = x, BitVec::split_concat_low(8, 56, x, BitVec::zero()))
}

// The arithmetic of one byte, over Nats.
theorem filter_inside(f, b: Nat, n: Nat, whole: f + Succ(b) = n, fits: n <= 4096): f < 4096 { omega }
theorem filter_low(i: Nat, inside: i < 4096): io_page_base() + i < Nat::pow(2, 47) {
    let page: (io_page_base() + 4096 <= Nat::pow(2, 47)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial);
    omega
}
theorem filter_word(i: Nat, inside: i < 4096): Succ(io_page_base() + i) < Nat::pow(2, 64) {
    let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
    omega
}
theorem filter_writable(i: Nat, inside: i < 4096):
    (io_page_base() <= io_page_base() + i) ∧ ((io_page_base() + i) + 1 <= io_page_base() + 4096) { ⟨omega, omega⟩ }

// Byte `front.len()` loaded and stepped: the next state in the state
// registers, the flag in RBX, the byte in RDX, memory untouched, the loop's
// registers kept, at the store.
record FilterStepped<C>(shape: FilterShape<C>, s: C, byte: BitVec(8), state, stepped: MachineState<IoMemory>) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), state, stepped),
    memory_is: stepped.memory = state.memory,
    rip_is: stepped.rip = eof_rip(fl_at_store(structured_bytes(shape.code).len())),
    next_held: shape.rep(stepped.gprs, shape.step(s, byte).next),
    flag_is: read_gpr(Rbx, stepped.gprs) = emit_flag(shape.step(s, byte).emit),
    byte_is: read_gpr(Rdx, stepped.gprs) = emit_word(shape.step(s, byte).emit),
    rsi: read_gpr(Rsi, stepped.gprs) = read_gpr(Rsi, state.gprs),
    rcx: read_gpr(Rcx, stepped.gprs) = read_gpr(Rcx, state.gprs),
    rdi: read_gpr(Rdi, stepped.gprs) = read_gpr(Rdi, state.gprs),
    r12: read_gpr(R12, stepped.gprs) = read_gpr(R12, state.gprs),
}

theorem filter_stepped<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    file: List<BitVec(8)>, s0: C, front, rest: List<BitVec(8)>, b: BitVec(8), inside: front.len() < 4096,
    fits: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next),
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    state: MachineState<IoMemory>, head: FilterAt<C>(shape, file, s0, front, Cons(b, rest), fl_at_load(structured_bytes(shape.code).len()), state)):
    Exists<MachineState<IoMemory>>(λ stepped => FilterStepped<C>(shape, filter_state(shape.step, front, s0), b, state, stepped)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let p = structured_bytes(shape.code).len();
    let here = pieces(head.page);
    let s = filter_state(shape.step, front, s0);
    let rsi = read_gpr(Rsi, state.gprs);
    let loaded: (head.page(front.len()) = b) = j(Nat::add_left_zero(front.len()), λ k _ => head.page(k) = b, head.left(0, b, refl));
    let present: (io_data_access().read(state.memory, rsi) = Some(b)) =
        j(sym(head.memory_is), λ m _ => io_read(m, rsi) = Some(b),
            trans(io_read_page(file, head.page, rsi, front.len(), inside, head.cursor), cong_fn<BitVec(8), Option<BitVec(8)>>(λ x => Some(x), loaded)));
    let canonical: (rsi.drop_low(47, 17) = BitVec::zero()) =
        BitVec::drop_low_zero_of_lt(47, 17, rsi, j(sym(head.cursor), λ v _ => v < Nat::pow(2, 47), filter_low(front.len(), inside)));
    let s1 = byte_load_after(filter_load(), b, state);
    let load_step: FetchedStep(fetch, data, state, s1) = Exists(EmitLoad(filter_load()),
        ⟨FetchedFrom(resident_readable(fetch, state.memory, byte_load_bytes(filter_load()), state.rip,
            resident_state(fetch, byte_load_bytes(filter_load()), IoMemory(file, head.page), eof_rip(fl_at_load(p)), state, head.memory_is, head.rip_is,
                here.load_at))),
         Exists(b, ByteLoadStep(canonical := canonical, present := present, execution := refl))⟩);
    let s1_rip: (s1.rip = eof_rip(fl_at_step(p))) = rip_advance(entry, state.rip, fl_at_load(p), filter_load_len(), head.rip_is);
    let s1_held: shape.rep(s1.gprs, s) = facts.framed(state.gprs, s1.gprs, s, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, head.held);
    have ran = facts.piece(s1, s, b, s1_held, refl, fits);
    let went: PieceRan(IoMemory(file, head.page), fl_at_store(p), s1, ran.after) =
        step_runs(shape.code, s1, shape.rep, shape.step(s, b), ran, IoMemory(file, head.page), fl_at_step(p), here.step_at, head.memory_is, s1_rip);
    Exists(ran.after, FilterStepped(
        steps := fetched_steps_cons(fetch, data, state, s1, ran.after, load_step, went.steps),
        memory_is := ran.memory_preserved,
        rip_is := went.rip_is,
        next_held := ran.next_held,
        flag_is := ran.flag_is,
        byte_is := ran.byte_is,
        rsi := ran.registers_preserved(Rsi, trivial),
        rcx := ran.registers_preserved(Rcx, trivial),
        rdi := ran.registers_preserved(Rdi, trivial),
        r12 := ran.registers_preserved(R12, trivial)))
}

// The byte at the write cursor, `o` bytes into the page, stored.
record FilterStored(file: List<BitVec(8)>, page: Nat → BitVec(8), o: Nat, x: BitVec(8), p: Nat, stepped, stored: MachineState<IoMemory>) {
    step: StoreStep(io_fetch_access(), linux_writes(io_linux()), stepped, stored),
    memory_is: stored.memory = io_store_offset(IoMemory(file, page), o, [x]),
    rip_is: stored.rip = eof_rip(fl_at_advance(p)),
    gprs_is: stored.gprs = stepped.gprs,
}
theorem filter_stored(code: StructuredCode, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>, file: List<BitVec(8)>,
    page: Nat → BitVec(8), o: Nat, inside: o < 4096, x: BitVec(8),
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), code, jumps, pj, finish),
    stepped: MachineState<IoMemory>, memory_is: stepped.memory = IoMemory(file, page),
    rip_is: stepped.rip = eof_rip(fl_at_store(structured_bytes(code).len())),
    at: read_gpr(Rdi, stepped.gprs).toNat() = io_page_base() + o, low: imm_byte0(read_gpr(Rdx, stepped.gprs)) = x):
    Exists<MachineState<IoMemory>>(λ stored => FilterStored(file, page, o, x, structured_bytes(code).len(), stepped, stored)) {
    let fetch = io_fetch_access();
    let writes = linux_writes(io_linux());
    let memory = IoMemory(file, page);
    let room = filter_writable(o, inside);
    let rdi = read_gpr(Rdi, stepped.gprs);
    let writable: IoWritable(stepped.memory, rdi, 1) =
        ⟨j(sym(at), λ v _ => io_page_base() <= v, room.left), j(sym(at), λ v _ => v + 1 <= io_page_base() + 4096, room.right)⟩;
    let stored = byte_store_after(writes, filter_store(), stepped);
    Exists(stored, FilterStored(
        step := byte_store_step(fetch, writes, filter_store(), stepped, refl,
            FetchedFrom(resident_readable(fetch, stepped.memory, byte_store_bytes(filter_store()), stepped.rip,
                resident_state(fetch, byte_store_bytes(filter_store()), memory, eof_rip(fl_at_store(structured_bytes(code).len())), stepped,
                    memory_is, rip_is, pieces(page).store_at))),
            writable),
        memory_is := trans(cong_fn<IoMemory, IoMemory>(λ m => io_store(m, rdi, [imm_byte0(read_gpr(Rdx, stepped.gprs))]), memory_is),
            trans(cong_fn<BitVec(8), IoMemory>(λ y => io_store(memory, rdi, [y]), low), store_at_offset(memory, rdi, o, [x], at))),
        rip_is := rip_advance(io_entry(), stepped.rip, fl_at_store(structured_bytes(code).len()), 3, rip_is),
        gprs_is := refl))
}

// The page after the store: what came before the cursor, then what the byte
// emitted; and the bytes still to be read, as they were.
theorem filter_emitted_page(memory: IoMemory, emitted: List<BitVec(8)>, emit: Option<BitVec(8)>,
    held: Stored(memory.page, 0, emitted)):
    Stored(io_store_offset(memory, emitted.len(), [emit_low(emit)]).page, 0, emitted ++ emitted_byte(emit)) {
    let o = emitted.len();
    let first: Stored(io_store_offset(memory, o, [emit_low(emit)]).page, 0, emitted) =
        stored_kept(memory, o, [emit_low(emit)], emitted, 0, j(sym(Nat::add_left_zero(o)), λ k _ => k <= o, o.le_refl()), held);
    let second: Stored(io_store_offset(memory, o, [emit_low(emit)]).page, 0 + o, emitted_byte(emit)) =
        (match emit as λ e => Stored(io_store_offset(memory, o, [emit_low(e)]).page, 0 + o, emitted_byte(e)) {
            None => λ i byte none => false_elim(j(none, λ found _ => match found as λ _ => Type { None => True, Some(_) => False }, trivial)),
            Some(x) => j(sym(Nat::add_left_zero(o)), λ k _ => Stored(io_store_offset(memory, o, [emit_low(Some(x))]).page, k, [x]),
                j(emit_low_is(Some(x), x, refl), λ y _ => Stored(io_store_offset(memory, o, [y]).page, o, [x]),
                    stored_store(memory, o, [x]))),
        });
    stored_join(io_store_offset(memory, o, [emit_low(emit)]).page, 0, emitted, emitted_byte(emit), first, second)
}
theorem filter_past_cursor(i, f, o: Nat, below: o <= f): Not(i + Succ(f) = o) {
    λ same => { let s: (i + Succ(f) = o) = same; false_elim(Nat::lt_irrefl(o, { omega })) }
}
theorem filter_left_page(memory: IoMemory, o, f: Nat, below: o <= f, x: BitVec(8), b: BitVec(8), rest: List<BitVec(8)>,
    left: Stored(memory.page, f, Cons(b, rest))): Stored(io_store_offset(memory, o, [x]).page, Succ(f), rest) {
    λ i c present => {
        let other = filter_past_cursor(i, f, o, below);
        let place: (Succ(i) + f = i + Succ(f)) = omega;
        trans(store_byte_other(memory, o, x, i + Succ(f), other), j(place, λ k _ => memory.page(k) = c, left(Succ(i), c, present)))
    }
}

// The cursors' arithmetic.
theorem filter_rsi_next(f: Nat, inside: f < 4096, rsi, one: BitVec(64), at: rsi.toNat() = io_page_base() + f, one_value: one.toNat() = 1):
    rsi.add(one).toNat() = io_page_base() + Succ(f) {
    let w = filter_word(f, inside);
    let sum = bitvec_nat::toNat_add(64, rsi, one, { omega });
    omega
}
theorem filter_rcx_next(r: Nat, rcx, one: BitVec(64), at: rcx.toNat() = Succ(r), one_value: one.toNat() = 1): rcx.sub(one).toNat() = r {
    let difference = bitvec_nat::toNat_sub(64, rcx, one, { omega });
    let back: ((rcx.toNat() -one.toNat()) + one.toNat() = rcx.toNat()) = Nat::sub_add_cancel(one.toNat(), rcx.toNat(), { omega });
    omega
}
theorem filter_rdi_next(o, n: Nat, inside: o < 4096, small: n <= 1, rdi, flag: BitVec(64), at: rdi.toNat() = io_page_base() + o,
    flag_value: flag.toNat() = n): rdi.add(flag).toNat() = io_page_base() + (o + n) {
    let w = filter_word(o, inside);
    let sum = bitvec_nat::toNat_add(64, rdi, flag, { omega });
    omega
}

// One byte: load it, step, store what it emits at the write cursor, advance.
// ZF says whether the chunk is done.
theorem filter_byte<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    file: List<BitVec(8)>, s0: C, front, rest: List<BitVec(8)>, b: BitVec(8), inside: front.len() < 4096,
    fits: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next),
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    state: MachineState<IoMemory>, head: FilterAt<C>(shape, file, s0, front, Cons(b, rest), fl_at_load(structured_bytes(shape.code).len()), state)):
    Exists<MachineState<IoMemory>>(λ body => LinuxSteps(io_linux(), state, body) ∧
        (FilterAt<C>(shape, file, s0, front ++ [b], rest, fl_at_jnz(structured_bytes(shape.code).len()), body) ∧
            (body.flags.zf = is_zero_bits(64, read_gpr(Rcx, body.gprs))))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let p = structured_bytes(shape.code).len();
    let s = filter_state(shape.step, front, s0);
    let e = shape.step(s, b).emit;
    let emitted = filter_emitted(shape.step, front, s0);
    let o = emitted.len();
    let short: (o <= front.len()) = filter_emitted_len(shape.step, front, s0);
    let o_inside: (o < 4096) = omega;
    have st = filter_stepped(shape, facts, jumps, pj, finish, file, s0, front, rest, b, inside, fits, pieces, state, head);
    let s2 = st.witness;
    let at_out: (read_gpr(Rdi, s2.gprs).toNat() = io_page_base() + o) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), st.proof.rdi), head.out);
    let low: (imm_byte0(read_gpr(Rdx, s2.gprs)) = emit_low(e)) = cong_fn<BitVec(64), BitVec(8)>(λ v => imm_byte0(v), st.proof.byte_is);
    have sd = filter_stored(shape.code, jumps, pj, finish, file, head.page, o, o_inside, emit_low(e), pieces, s2,
        trans(st.proof.memory_is, head.memory_is), st.proof.rip_is, at_out, low);
    let s3 = sd.witness;
    let next = io_store_offset(IoMemory(file, head.page), o, [emit_low(e)]).page;
    let advanced = block_fetched(fetch, data, filter_advance_block(), s3, trivial,
        resident_state(fetch, canonical_block_bytes(filter_advance_block()), IoMemory(file, next), eof_rip(fl_at_advance(p)), s3,
            sd.proof.memory_is, sd.proof.rip_is, pieces(next).advance_at));
    let s4 = execute_block_normal(filter_advance_block(), s3);
    let reg = λ (r: Gpr) => cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(r, g), sd.proof.gprs_is);
    let one: (read_gpr(R12, s3.gprs) = BitVec::ofNat(1)) = trans(reg(R12), trans(st.proof.r12, head.one));
    let one_value: (read_gpr(R12, s3.gprs).toNat() = 1) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), one), BitVec::toNat_ofNat(64, 1, trivial));
    let rsi3: (read_gpr(Rsi, s3.gprs).toNat() = io_page_base() + front.len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(reg(Rsi), st.proof.rsi)), head.cursor);
    let rcx3: (read_gpr(Rcx, s3.gprs).toNat() = Succ(rest.len())) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(reg(Rcx), st.proof.rcx)), head.count);
    let rdi3: (read_gpr(Rdi, s3.gprs).toNat() = io_page_base() + o) = trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), reg(Rdi)), at_out);
    let flag3: (read_gpr(Rbx, s3.gprs).toNat() = emitted_byte(e).len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), trans(reg(Rbx), st.proof.flag_is)), emit_flag_value(e));
    // `front.len() + 1` is `Succ(front.len())` by computation: addition
    // recurses on its second argument.
    let grown: ((front ++ [b]).len() = Succ(front.len())) = List::len_append(front, [b]);
    let emitted_next: (filter_emitted(shape.step, front ++ [b], s0) = emitted ++ emitted_byte(e)) = filter_emitted_snoc(shape.step, front, b, s0);
    let out_len: ((emitted ++ emitted_byte(e)).len() = o + emitted_byte(e).len()) = List::len_append(emitted, emitted_byte(e));
    let rdi4: (read_gpr(Rdi, s4.gprs).toNat() = io_page_base() + filter_emitted(shape.step, front ++ [b], s0).len()) =
        trans(filter_rdi_next(o, emitted_byte(e).len(), o_inside, emitted_byte_len(e), read_gpr(Rdi, s3.gprs), read_gpr(Rbx, s3.gprs), rdi3, flag3),
            cong_fn<Nat, Nat>(λ k => io_page_base() + k, sym(trans(cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), emitted_next), out_len))));
    let rsi4: (read_gpr(Rsi, s4.gprs).toNat() = io_page_base() + (front ++ [b]).len()) =
        trans(filter_rsi_next(front.len(), inside, read_gpr(Rsi, s3.gprs), read_gpr(R12, s3.gprs), rsi3, one_value),
            cong_fn<Nat, Nat>(λ k => io_page_base() + k, sym(grown)));
    let rcx4: (read_gpr(Rcx, s4.gprs).toNat() = rest.len()) = filter_rcx_next(rest.len(), read_gpr(Rcx, s3.gprs), read_gpr(R12, s3.gprs), rcx3, one_value);
    let held4: shape.rep(s4.gprs, filter_state(shape.step, front ++ [b], s0)) =
        j(sym(filter_state_snoc(shape.step, front, b, s0)), λ t _ => shape.rep(s4.gprs, t),
            facts.framed(s2.gprs, s4.gprs, shape.step(s, b).next,
                ⟨trans(refl, reg(R13)), ⟨trans(refl, reg(R14)), ⟨trans(refl, reg(R15)), trans(refl, reg(R8))⟩⟩⟩, st.proof.next_held));
    let page_emitted: Stored(next, 0, filter_emitted(shape.step, front ++ [b], s0)) =
        j(sym(emitted_next), λ l _ => Stored(next, 0, l), filter_emitted_page(IoMemory(file, head.page), emitted, e, head.emitted));
    let page_left: Stored(next, (front ++ [b]).len(), rest) =
        j(sym(grown), λ k _ => Stored(next, k, rest), filter_left_page(IoMemory(file, head.page), o, front.len(), short, emit_low(e), b, rest, head.left));
    Exists(s4, ⟨linux_steps_trans(io_linux(), state, s2, s4, linux_steps_of_fetched(io_linux(), state, s2, st.proof.steps),
            linux_steps_trans(io_linux(), s2, s3, s4, linux_steps_store(io_linux(), s2, s3, sd.proof.step),
                linux_steps_of_fetched(io_linux(), s3, s4, advanced.left))),
        ⟨FilterAt(
            page := next,
            memory_is := trans(pure_block_memory(filter_advance_block(), s3), sd.proof.memory_is),
            rip_is := trans(advanced.right, rip_advance(entry, s3.rip, fl_at_advance(p), filter_advance_len(), sd.proof.rip_is)),
            emitted := page_emitted,
            left := page_left,
            held := held4,
            cursor := rsi4,
            count := rcx4,
            out := rdi4,
            one := one),
         refl⟩⟩)
}

// The JNZ, taken while bytes are left.
theorem filter_again<C>(shape: FilterShape<C>, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>, file: List<BitVec(8)>, s0: C,
    front, back: List<BitVec(8)>,
    loop_target: near_branch_target(eof_rip(fl_at_jnz(structured_bytes(shape.code).len())), 6, jumps.ld) = eof_rip(fl_at_load(structured_bytes(shape.code).len())),
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    state: MachineState<IoMemory>, body: FilterAt<C>(shape, file, s0, front, back, fl_at_jnz(structured_bytes(shape.code).len()), state),
    flag: state.flags.zf = False):
    Exists<MachineState<IoMemory>>(λ next => FetchedStep(io_fetch_access(), io_data_access(), state, next) ∧
        FilterAt<C>(shape, file, s0, front, back, fl_at_load(structured_bytes(shape.code).len()), next)) {
    let p = structured_bytes(shape.code).len();
    let jump = near_fetched_step(io_fetch_access(), io_data_access(), JumpIfNear(NE, jumps.ld), state,
        resident_state(io_fetch_access(), near_control_bytes(JumpIfNear(NE, jumps.ld)), IoMemory(file, body.page), eof_rip(fl_at_jnz(p)), state,
            body.memory_is, body.rip_is, pieces(body.page).jnz_at));
    let next = execute_near_control(JumpIfNear(NE, jumps.ld), state);
    let taken: (condition_holds(NE, state.flags) = True) = cong_fn<Bool, Bool>(λ z => !z, flag);
    Exists(next, ⟨jump, FilterAt(page := body.page, memory_is := body.memory_is,
        rip_is := trans(near_if_taken_rip(NE, jumps.ld, state, taken),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.ld), body.rip_is), loop_target)),
        emitted := body.emitted, left := body.left, held := body.held, cursor := body.cursor, count := body.count, out := body.out, one := body.one)⟩)
}

// The JNZ, falling through to the close once the chunk is done.
theorem filter_done<C>(shape: FilterShape<C>, jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>, file: List<BitVec(8)>, s0: C,
    front, back: List<BitVec(8)>,
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    state: MachineState<IoMemory>, body: FilterAt<C>(shape, file, s0, front, back, fl_at_jnz(structured_bytes(shape.code).len()), state),
    flag: state.flags.zf = True):
    Exists<MachineState<IoMemory>>(λ next => FetchedStep(io_fetch_access(), io_data_access(), state, next) ∧
        FilterAt<C>(shape, file, s0, front, back, fl_at_close(structured_bytes(shape.code).len()), next)) {
    let p = structured_bytes(shape.code).len();
    let jump = near_fetched_step(io_fetch_access(), io_data_access(), JumpIfNear(NE, jumps.ld), state,
        resident_state(io_fetch_access(), near_control_bytes(JumpIfNear(NE, jumps.ld)), IoMemory(file, body.page), eof_rip(fl_at_jnz(p)), state,
            body.memory_is, body.rip_is, pieces(body.page).jnz_at));
    let next = execute_near_control(JumpIfNear(NE, jumps.ld), state);
    let passed: (condition_holds(NE, state.flags) = False) = cong_fn<Bool, Bool>(λ z => !z, flag);
    Exists(next, ⟨jump, FilterAt(page := body.page, memory_is := body.memory_is,
        rip_is := trans(near_if_not_taken_rip(NE, jumps.ld, state, passed), rip_advance(io_entry(), state.rip, fl_at_jnz(p), 6, body.rip_is)),
        emitted := body.emitted, left := body.left, held := body.held, cursor := body.cursor, count := body.count, out := body.out, one := body.one)⟩)
}

// Every prefix of the chunk leaves counts that fit.
fn ChunkFits<C>(shape: FilterShape<C>, s0: C, bytes: List<BitVec(8)>) → Type {
    (front, rest: List<BitVec(8)>) → front ++ rest = bytes → CountsFit(shape.counts, filter_state(shape.step, front, s0))
}

theorem filter_front_inside(front, rest: List<BitVec(8)>, b: BitVec(8), bytes: List<BitVec(8)>, prefix: front ++ Cons(b, rest) = bytes,
    fits: bytes.len() <= 4096): front.len() < 4096 {
    let whole: ((front ++ Cons(b, rest)).len() = front.len() + Succ(rest.len())) = List::len_append(front, Cons(b, rest));
    let same: ((front ++ Cons(b, rest)).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), prefix);
    omega
}

// The chunk, by recursion on what is left of it: every byte stepped and its
// output stored, and the close reached.
fn FilterLoopFrom<C>(shape: FilterShape<C>, file: List<BitVec(8)>, s0: C, bytes, back: List<BitVec(8)>) → Type {
    (front: List<BitVec(8)>) → (state: MachineState<IoMemory>) → front ++ back = bytes → 0 < back.len() →
    FilterAt<C>(shape, file, s0, front, back, fl_at_load(structured_bytes(shape.code).len()), state) →
    Exists<MachineState<IoMemory>>(λ done => LinuxSteps(io_linux(), state, done) ∧
        FilterAt<C>(shape, file, s0, bytes, Nil, fl_at_close(structured_bytes(shape.code).len()), done))
}
theorem filter_loop<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    loop_target: near_branch_target(eof_rip(fl_at_jnz(structured_bytes(shape.code).len())), 6, jumps.ld) = eof_rip(fl_at_load(structured_bytes(shape.code).len())),
    file: List<BitVec(8)>, s0: C, bytes: List<BitVec(8)>, fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes),
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish), back: List<BitVec(8)>):
    FilterLoopFrom(shape, file, s0, bytes, back) {
    let p = structured_bytes(shape.code).len();
    match back {
        Nil => λ front state prefix none head => false_elim(none),
        Cons(b, rest) => λ front state prefix some head => {
            let inside = filter_front_inside(front, rest, b, bytes, prefix, fits);
            let prefix_next: ((front ++ [b]) ++ rest = bytes) = trans(List::append_assoc(front, [b], rest), prefix);
            let fits_next: CountsFit(shape.counts, shape.step(filter_state(shape.step, front, s0), b).next) =
                j(filter_state_snoc(shape.step, front, b, s0), λ t _ => CountsFit(shape.counts, t), counts_fit(front ++ [b], rest, prefix_next));
            have stepped = filter_byte(shape, facts, jumps, pj, finish, file, s0, front, rest, b, inside, fits_next, pieces, state, head);
            let body = stepped.witness;
            (match rest as λ r => FilterLoopFrom(shape, file, s0, bytes, r) → (front ++ [b]) ++ r = bytes →
                    FilterAt<C>(shape, file, s0, front ++ [b], r, fl_at_jnz(p), body) → body.flags.zf = is_zero_bits(64, read_gpr(Rcx, body.gprs)) →
                    Exists<MachineState<IoMemory>>(λ done => LinuxSteps(io_linux(), state, done) ∧ FilterAt<C>(shape, file, s0, bytes, Nil, fl_at_close(p), done)) {
                Nil => λ _ whole at flag => {
                    have out = filter_done(shape, jumps, pj, finish, file, s0, front ++ [b], Nil, pieces, body, at,
                        trans(flag, zero_bits_of_zero(64, read_gpr(Rcx, body.gprs), at.count)));
                    let all: (front ++ [b] = bytes) = trans(sym(List::append_nil(front ++ [b])), whole);
                    Exists(out.witness, ⟨linux_steps_trans(io_linux(), state, body, out.witness, stepped.proof.left,
                            linux_steps_of_fetched(io_linux(), body, out.witness, fetched_steps_one(io_fetch_access(), io_data_access(), body, out.witness, out.proof.left))),
                        j(all, λ f _ => FilterAt<C>(shape, file, s0, f, Nil, fl_at_close(p), out.witness), out.proof.right)⟩)
                },
                Cons(c, more) => λ later whole at flag => {
                    have again = filter_again(shape, jumps, pj, finish, file, s0, front ++ [b], Cons(c, more), loop_target, pieces, body, at,
                        trans(flag, zero_bits_of_pos(64, read_gpr(Rcx, body.gprs), j(sym(at.count), λ v _ => 0 < v, trivial))));
                    have rest_done = later(front ++ [b], again.witness, whole, trivial, again.proof.right);
                    Exists(rest_done.witness, ⟨linux_steps_trans(io_linux(), state, body, rest_done.witness, stepped.proof.left,
                            linux_steps_cons(io_linux(), body, again.witness, rest_done.witness, Inl(again.proof.left), rest_done.proof.left)),
                        rest_done.proof.right⟩)
                },
            })(filter_loop(shape, facts, jumps, pj, finish, loop_target, file, s0, bytes, fits, counts_fit, pieces, rest), prefix_next,
                stepped.proof.right.left, stepped.proof.right.right)
        },
    }
}

// ---------------------------------------------------------------------------
// One chunk, from past the head: the setup, the chunk stepped with its output
// stored in place, the close, then the output written, unless there is none.

// The read left the chunk at the page's start.
theorem filter_page_read(memory: IoMemory, bytes: List<BitVec(8)>): Stored(io_store_offset(memory, 0, bytes).page, 0, bytes) {
    stored_store(memory, 0, bytes)
}

// After the setup: nothing done, the whole chunk to go.
theorem filter_entered<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    page: Nat → BitVec(8), s0: C, bytes: List<BitVec(8)>, fits: bytes.len() <= 4096,
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(fl_at_setup(structured_bytes(shape.code).len())),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()), held: shape.rep(going.gprs, s0)):
    FetchedSteps(io_fetch_access(), io_data_access(), going, execute_block_normal(filter_setup_block(), going)) ∧
    FilterAt<C>(shape, file, s0, Nil, bytes, fl_at_load(structured_bytes(shape.code).len()), execute_block_normal(filter_setup_block(), going)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let set = block_fetched(fetch, data, filter_setup_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(filter_setup_block()), stored, eof_rip(fl_at_setup(p)), going,
            memory_is, rip_is, pieces(stored.page).setup_at));
    let ready = execute_block_normal(filter_setup_block(), going);
    let counted: (read_gpr(Rax, going.gprs).toNat() = bytes.len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, bytes.len(), count_below_word(bytes.len(), fits)));
    let page_value: (BitVec::ofNat(io_page_base(), n := 64).toNat() = io_page_base()) = BitVec::toNat_ofNat(64, io_page_base(), trivial);
    ⟨set.left, FilterAt(
        page := stored.page,
        memory_is := trans(pure_block_memory(filter_setup_block(), going), memory_is),
        rip_is := trans(set.right, rip_advance(io_entry(), going.rip, fl_at_setup(p), filter_setup_len(), rip_is)),
        emitted := λ i byte none => false_elim(j(none, λ found _ => match found as λ _ => Type { None => True, Some(_) => False }, trivial)),
        left := filter_page_read(IoMemory(file, page), bytes),
        held := facts.framed(going.gprs, ready.gprs, s0, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, held),
        cursor := page_value,
        count := counted,
        out := page_value,
        one := refl)⟩
}

// The close, at the JZ: R9 at the page, R10 the output's length, ZF whether
// it is empty, the page holding the output, the state the chunk left.
record FilterClosed<C>(shape: FilterShape<C>, file: List<BitVec(8)>, out: List<BitVec(8)>, s: C, going, closed: MachineState<IoMemory>) {
    steps: LinuxSteps(io_linux(), going, closed),
    page: Nat → BitVec(8),
    memory_is: closed.memory = IoMemory(file, page),
    rip_is: closed.rip = eof_rip(fl_at_cjz(structured_bytes(shape.code).len())),
    emitted: Stored(page, 0, out),
    base: read_gpr(R9, closed.gprs).toNat() = io_page_base(),
    length: read_gpr(R10, closed.gprs).toNat() = out.len(),
    flag: closed.flags.zf = is_zero_bits(64, read_gpr(R10, closed.gprs)),
    held: shape.rep(closed.gprs, s),
}

// The output's length, from where the write cursor stopped.
theorem filter_out_len(rdi, r9: BitVec(64), o: Nat, at_out: rdi.toNat() = io_page_base() + o, base: r9.toNat() = io_page_base()):
    rdi.sub(r9).toNat() = o {
    let difference = bitvec_nat::toNat_sub(64, rdi, r9, { omega });
    let back: ((rdi.toNat() -r9.toNat()) + r9.toNat() = rdi.toNat()) = Nat::sub_add_cancel(r9.toNat(), rdi.toNat(), { omega });
    omega
}

theorem filter_closed<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    loop_target: near_branch_target(eof_rip(fl_at_jnz(structured_bytes(shape.code).len())), 6, jumps.ld) = eof_rip(fl_at_load(structured_bytes(shape.code).len())),
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    page: Nat → BitVec(8), s0: C, bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes),
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(fl_at_setup(structured_bytes(shape.code).len())),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()), held: shape.rep(going.gprs, s0)):
    Exists<MachineState<IoMemory>>(λ closed =>
        FilterClosed<C>(shape, file, filter_emitted(shape.step, bytes, s0), filter_state(shape.step, bytes, s0), going, closed)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let out = filter_emitted(shape.step, bytes, s0);
    let entered = filter_entered(shape, facts, jumps, pj, finish, file, pieces, page, s0, bytes, fits, going, memory_is, rip_is, length_word, held);
    let ready = execute_block_normal(filter_setup_block(), going);
    have done = filter_loop(shape, facts, jumps, pj, finish, loop_target, file, s0, bytes, fits, counts_fit, pieces, bytes)(Nil, ready, refl, some,
        entered.right);
    let last = done.witness;
    let at = done.proof.right;
    let shut = block_fetched(fetch, data, filter_close_block(), last, trivial,
        resident_state(fetch, canonical_block_bytes(filter_close_block()), IoMemory(file, at.page), eof_rip(fl_at_close(p)), last,
            at.memory_is, at.rip_is, pieces(at.page).close_at));
    let closed = execute_block_normal(filter_close_block(), last);
    let base: (read_gpr(R9, closed.gprs).toNat() = io_page_base()) = BitVec::toNat_ofNat(64, io_page_base(), trivial);
    let rdi = read_gpr(Rdi, last.gprs);
    let r9 = read_gpr(R9, closed.gprs);
    let short: (out.len() <= bytes.len()) = filter_emitted_len(shape.step, bytes, s0);
    let length: (rdi.sub(r9).toNat() = out.len()) = filter_out_len(rdi, r9, out.len(), at.out, base);
    Exists(closed, FilterClosed(
        steps := linux_steps_trans(io_linux(), going, last, closed,
            linux_steps_trans(io_linux(), going, ready, last, linux_steps_of_fetched(io_linux(), going, ready, entered.left), done.proof.left),
            linux_steps_of_fetched(io_linux(), last, closed, shut.left)),
        page := at.page,
        memory_is := trans(pure_block_memory(filter_close_block(), last), at.memory_is),
        rip_is := trans(shut.right, rip_advance(io_entry(), last.rip, fl_at_close(p), filter_close_len(), at.rip_is)),
        emitted := at.emitted,
        base := base,
        length := length,
        flag := refl,
        held := facts.framed(last.gprs, closed.gprs, filter_state(shape.step, bytes, s0), ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, at.held)))
}

// What a chunk's history makes: no write when it emitted nothing, else its
// output written, short writes and EINTRs and all, then `after`.
fn chunk_events(out: List<BitVec(8)>, writes: List<WriteStep>, ending: WriteEnding, after: List<LinuxEvent>) → List<LinuxEvent> {
    match out { Nil => after, Cons(_, _) => write_events_then(out, writes, ending, after) }
}
fn WritesFor(out: List<BitVec(8)>, writes: List<WriteStep>) → Type {
    match out { Nil => writes = Nil, Cons(_, _) => WriteSteps(writes, out) }
}
theorem writes_for_of(out: List<BitVec(8)>, writes: List<WriteStep>, some: 0 < out.len(), steps: WriteSteps(writes, out)): WritesFor(out, writes) {
    (match out as λ o => 0 < o.len() → WriteSteps(writes, o) → WritesFor(o, writes) {
        Nil => λ none _ => false_elim(none),
        Cons(_, _) => λ _ ok => ok,
    })(some, steps)
}

// What runs after the chunk: from the read with the state it left. Only a
// chunk whose writes all finish goes on; one whose write fails emitted
// something to write.
fn ChunkThen<C>(shape: FilterShape<C>, file: List<BitVec(8)>, s: C, after: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.rip = eof_rip(fl_at_read(structured_bytes(shape.code).len())) →
    state.memory = IoMemory(file, page) → shape.rep(state.gprs, s) → LinuxRuns(io_linux(), after, state)
}
fn ChunkThenIf<C>(shape: FilterShape<C>, file: List<BitVec(8)>, s: C, out: List<BitVec(8)>, ending: WriteEnding, after: List<LinuxEvent>) → Type {
    match ending { Finished => ChunkThen(shape, file, s, after), WriteFailedWith(_) => 0 < out.len() }
}

// The JZ after the close: back to the read when the chunk emitted nothing,
// else into the write loop, whose end is the read.
theorem filter_after_close<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    done: Nat, targets: FilterTargets(structured_bytes(shape.code).len(), done, jumps, pj),
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    out: List<BitVec(8)>, short: out.len() <= 4096, s: C, going, closed: MachineState<IoMemory>, at: FilterClosed<C>(shape, file, out, s, going, closed),
    writes: List<WriteStep>, written: WritesFor(out, writes), ending: WriteEnding, ending_ok: WriteEndingOk(ending), after: List<LinuxEvent>,
    then: ChunkThenIf(shape, file, s, out, ending, after)):
    LinuxRuns(io_linux(), chunk_events(out, writes, ending, after), closed) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let memory = IoMemory(file, at.page);
    let jz = near_fetched_step(fetch, data, JumpZeroNear(jumps.cd), closed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(jumps.cd)), memory, eof_rip(fl_at_cjz(p)), closed, at.memory_is, at.rip_is,
            pieces(at.page).cjz_at));
    let next = execute_near_control(JumpZeroNear(jumps.cd), closed);
    let held: shape.rep(next.gprs, s) = facts.framed(closed.gprs, next.gprs, s, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, at.held);
    (match out as λ o => Stored(at.page, 0, o) → read_gpr(R10, closed.gprs).toNat() = o.len() → o.len() <= 4096 → WritesFor(o, writes) →
            ChunkThenIf(shape, file, s, o, ending, after) → LinuxRuns(io_linux(), chunk_events(o, writes, ending, after), closed) {
        Nil => λ _ none _ _ go => {
            let taken: (closed.flags.zf = True) = trans(at.flag, zero_bits_of_zero(64, read_gpr(R10, closed.gprs), none));
            let back: (next.rip = eof_rip(fl_at_read(p))) =
                trans(near_taken_rip(jumps.cd, closed, taken),
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, jumps.cd), at.rip_is), targets.quiet));
            (match ending as λ en => ChunkThenIf(shape, file, s, Nil, en, after) → LinuxRuns(io_linux(), after, closed) {
                Finished => λ go => linux_runs_after_steps(io_linux(), after, closed, next, fetched_steps_one(fetch, data, closed, next, jz),
                    go(at.page, next, back, at.memory_is, held)),
                WriteFailedWith(_) => λ never => false_elim(never),
            })(go)
        },
        Cons(c, more) => λ stored length short written go => {
            let o = Cons(c, more);
            let passed: (closed.flags.zf = False) =
                trans(at.flag, zero_bits_of_pos(64, read_gpr(R10, closed.gprs), j(sym(length), λ v _ => 0 < v, trivial)));
            let on: (next.rip = eof_rip(fl_at_write(p))) =
                trans(near_not_taken_rip(jumps.cd, closed, passed), rip_advance(io_entry(), closed.rip, fl_at_cjz(p), 6, at.rip_is));
            let sends: LinuxWritesFrom(io_linux(), memory, read_gpr(R9, next.gprs), o) =
                stored_sends(memory, 0, o, stored, read_gpr(R9, next.gprs), at.base, { omega });
            let room: (read_gpr(R9, next.gprs).toNat() + o.len() < Nat::pow(2, 64)) = {
                let base: (read_gpr(R9, next.gprs).toNat() = io_page_base()) = at.base;
                let page: (io_page_base() + 4097 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial);
                omega
            };
            let finished: FinishedThen(ending, memory, fl_at_read(p), after, next.gprs) =
                (match ending as λ en => ChunkThenIf(shape, file, s, o, en, after) → FinishedThen(en, memory, fl_at_read(p), after, next.gprs) {
                    Finished => λ go => λ state at_read in_page kept => go(at.page, state, at_read, in_page,
                        facts.framed(next.gprs, state.gprs, s,
                            ⟨kept.right.right.left, ⟨kept.right.right.right.left, ⟨kept.right.right.right.right.left, kept.left⟩⟩⟩, held)),
                    WriteFailedWith(_) => λ _ => trivial,
                })(go);
            linux_runs_after_steps(io_linux(), chunk_events(o, writes, ending, after), closed, next, fetched_steps_one(fetch, data, closed, next, jz),
                wl_from_then(memory, fl_at_write(p), pj, fl_at_read(p), pieces(at.page).write, targets.write, after, ending, ending_ok, next.gprs,
                    finished, writes)(o, written, next, trivial, short, on, at.memory_is, sends, length, room, write_kept_refl(next.gprs)))
        },
    })(at.emitted, at.length, short, written, then)
}

// One chunk, from past the head: the setup, the chunk, the close, its
// output written.
theorem filter_chunk<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    done: Nat, targets: FilterTargets(structured_bytes(shape.code).len(), done, jumps, pj),
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    page: Nat → BitVec(8), s0: C, bytes: List<BitVec(8)>, some: 0 < bytes.len(), fits: bytes.len() <= 4096, counts_fit: ChunkFits(shape, s0, bytes),
    going: MachineState<IoMemory>, memory_is: going.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: going.rip = eof_rip(fl_at_setup(structured_bytes(shape.code).len())),
    length_word: read_gpr(Rax, going.gprs) = bitvec_nat::word_of_nat(64, bytes.len()), held: shape.rep(going.gprs, s0),
    writes: List<WriteStep>, written: WritesFor(filter_emitted(shape.step, bytes, s0), writes),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), after: List<LinuxEvent>,
    then: ChunkThenIf(shape, file, filter_state(shape.step, bytes, s0), filter_emitted(shape.step, bytes, s0), ending, after)):
    LinuxRuns(io_linux(), chunk_events(filter_emitted(shape.step, bytes, s0), writes, ending, after), going) {
    let out = filter_emitted(shape.step, bytes, s0);
    have closed = filter_closed(shape, facts, jumps, pj, finish, targets.again, file, pieces, page, s0, bytes, some, fits, counts_fit,
        going, memory_is, rip_is, length_word, held);
    let short: (out.len() <= 4096) = { let less: (out.len() <= bytes.len()) = filter_emitted_len(shape.step, bytes, s0); omega };
    linux_runs_after_linux_steps(io_linux(), chunk_events(out, writes, ending, after), going, closed.witness, closed.proof.steps,
        filter_after_close(shape, facts, jumps, pj, finish, done, targets, file, pieces, out, short, filter_state(shape.step, bytes, s0),
            going, closed.witness, closed.proof, writes, written, ending, ending_ok, after, then))
}

// ---------------------------------------------------------------------------
// The histories, the process, and what the run sends.

// A chunk's output: what its bytes emit from the state the input before it
// left.
fn chunk_out<C>(shape: FilterShape<C>, seen, bytes: List<BitVec(8)>) → List<BitVec(8)> {
    filter_emitted(shape.step, bytes, filter_state(shape.step, seen, shape.init))
}
fn filter_body<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → List<WriteStep> → List<LinuxEvent> → List<LinuxEvent> {
    λ seen bytes writes after => chunk_events(chunk_out(shape, seen, bytes), writes, Finished, after)
}
fn filter_ok<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → List<WriteStep> → Type {
    λ seen bytes writes => WritesFor(chunk_out(shape, seen, bytes), writes)
}
fn filter_failed<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → WriteFailure → List<LinuxEvent> {
    λ seen bytes failure => chunk_events(chunk_out(shape, seen, bytes), failure.writes, WriteFailedWith(failure.errno), Nil)
}
fn filter_failed_ok<C>(shape: FilterShape<C>) → List<BitVec(8)> → List<BitVec(8)> → WriteFailure → Type {
    λ seen bytes failure => (0 < chunk_out(shape, seen, bytes).len()) ∧ (WriteSteps(failure.writes, chunk_out(shape, seen, bytes)) ∧
        (Errno(failure.errno) ∧ Not(failure.errno = eintr())))
}
// A run's events: each chunk read and its output written; at end of file,
// the finish's `tail`.
fn filter_events<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>, ending: EofEnd<WriteFailure>, tail: List<LinuxEvent>) → List<LinuxEvent> {
    eof_run(filter_body(shape), filter_failed(shape), steps, ending, tail, Nil)
}
fn FilterSteps<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>) → Type { EofSteps(filter_ok(shape), steps, Nil) }
fn FilterEndingOk<C>(shape: FilterShape<C>, steps: List<EofStep<List<WriteStep>>>, ending: EofEnd<WriteFailure>) → Type {
    EofEndOk(filter_failed_ok(shape), eof_input(steps), ending)
}

// The fold's invariant at the read: the state the input so far left sits in
// the state registers.
fn filter_inv<C>(shape: FilterShape<C>) → List<BitVec(8)> → Gprs → Type {
    λ seen gprs => shape.rep(gprs, filter_state(shape.step, seen, shape.init))
}

theorem chunk_within(seen, front, back, bytes, rest, input: List<BitVec(8)>, chunk: front ++ back = bytes,
    prefix: seen ++ (bytes ++ rest) = input): (seen ++ front).len() <= input.len() + 4096 {
    let a = List::len_append(seen, front);
    let b: ((front ++ back).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), chunk);
    let c = List::len_append(front, back);
    let d: ((seen ++ (bytes ++ rest)).len() = input.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), prefix);
    let e = List::len_append(seen, bytes ++ rest);
    let f = List::len_append(bytes, rest);
    omega
}
theorem ended_within(seen, front, back, bytes, input: List<BitVec(8)>, chunk: front ++ back = bytes, fits: bytes.len() <= 4096,
    all: seen = input): (seen ++ front).len() <= input.len() + 4096 {
    let a = List::len_append(seen, front);
    let b: ((front ++ back).len() = bytes.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), chunk);
    let c = List::len_append(front, back);
    let d: (seen.len() = input.len()) = cong_fn<List<BitVec(8)>, Nat>(λ l => l.len(), all);
    omega
}
// A chunk's prefixes leave counts that fit, given room for the input.
theorem chunk_fits<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), input, seen, bytes: List<BitVec(8)>, room: FilterRoom(shape.counts, input),
    within: (front, back: List<BitVec(8)>) → front ++ back = bytes → (seen ++ front).len() <= input.len() + 4096):
    ChunkFits(shape, filter_state(shape.step, seen, shape.init), bytes) {
    λ front back chunk => j(filter_state_append(shape.step, seen, front, shape.init), λ t _ => CountsFit(shape.counts, t),
        room_fits(shape, facts, input, seen ++ front, room, within(front, back, chunk)))
}

// The process for the driver: the fold's invariant, a chunk stepped and its
// output written, a chunk whose write fails, and at end of file the finish.
theorem filter_process<C>(shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps, finish: List<BitVec(8)>,
    done: Nat, targets: FilterTargets(structured_bytes(shape.code).len(), done, jumps, pj),
    file: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, finish),
    input: List<BitVec(8)>, room: FilterRoom(shape.counts, input), tail_events: List<LinuxEvent>,
    tail: EofTail(file, done, shape.rep, filter_state(shape.step, input, shape.init), tail_events)):
    EofProcess<List<WriteStep>, WriteFailure>(file, fl_at_read(structured_bytes(shape.code).len()), done, filter_inv(shape), input,
        filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape), tail_events) {
    EofProcess(
        framed := λ seen before after kept held => facts.framed(before, after, filter_state(shape.step, seen, shape.init),
            ⟨kept.right.right.right.right.right.right.left, ⟨kept.right.right.right.right.right.right.right.left,
                ⟨kept.right.right.right.right.right.right.right.right, kept.right.right.left⟩⟩⟩, held),
        chunk := λ page seen bytes rest writes some fits written prefix going rip_is memory_is length_word held after next =>
            filter_chunk(shape, facts, jumps, pj, finish, done, targets, file, pieces, page, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(shape, facts, input, seen, bytes, room, λ front back chunk => chunk_within(seen, front, back, bytes, rest, input, chunk, prefix)),
                going, memory_is, rip_is, length_word, held, writes, written, Finished, trivial, after,
                λ next_page state at_read in_page placed => next(next_page, state, at_read, in_page,
                    j(sym(filter_state_append(shape.step, seen, bytes, shape.init)), λ t _ => shape.rep(state.gprs, t), placed))),
        ends := λ page seen bytes failure some fits failed all going rip_is memory_is length_word held =>
            filter_chunk(shape, facts, jumps, pj, finish, done, targets, file, pieces, page, filter_state(shape.step, seen, shape.init), bytes,
                some, fits, chunk_fits(shape, facts, input, seen, bytes, room, λ front back chunk => ended_within(seen, front, back, bytes, input, chunk, fits, all)),
                going, memory_is, rip_is, length_word, held, failure.writes,
                writes_for_of(chunk_out(shape, seen, bytes), failure.writes, failed.left, failed.right.left),
                WriteFailedWith(failure.errno), failed.right.right, Nil, failed.left),
        at_end := λ page state at_done in_page placed => tail(page, state, at_done, in_page, placed))
}

// What stdout received on a run that ends at the empty read: what the input
// emitted, from the state what was read before the history left, then what
// the finish sent.
theorem chunk_sends(out: List<BitVec(8)>, writes: List<WriteStep>, after: List<LinuxEvent>, written: WritesFor(out, writes)):
    sent_to(BitVec::ofNat(1), chunk_events(out, writes, Finished, after)) = out ++ sent_to(BitVec::ofNat(1), after) {
    (match out as λ o => WritesFor(o, writes) → sent_to(BitVec::ofNat(1), chunk_events(o, writes, Finished, after)) = o ++ sent_to(BitVec::ofNat(1), after) {
        Nil => λ _ => refl,
        Cons(c, more) => λ ok => stdout_then(writes, after, Cons(c, more), ok),
    })(written)
}
theorem filter_sends_from<C>(shape: FilterShape<C>, tail: List<LinuxEvent>, steps: List<EofStep<List<WriteStep>>>):
    (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), steps, seen) →
    sent_to(BitVec::ofNat(1), eof_run(filter_body(shape), filter_failed(shape), steps, AtEnd, tail, seen)) =
        filter_emitted(shape.step, eof_input(steps), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
    match steps as λ ss => (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), ss, seen) →
            sent_to(BitVec::ofNat(1), eof_run(filter_body(shape), filter_failed(shape), ss, AtEnd, tail, seen)) =
                filter_emitted(shape.step, eof_input(ss), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
        Nil => λ seen _ => refl,
        Cons(step, rest) => match step as λ st => (seen: List<BitVec(8)>) → EofSteps(filter_ok(shape), Cons(st, rest), seen) →
                sent_to(BitVec::ofNat(1), eof_run(filter_body(shape), filter_failed(shape), Cons(st, rest), AtEnd, tail, seen)) =
                    filter_emitted(shape.step, eof_input(Cons(st, rest)), filter_state(shape.step, seen, shape.init)) ++ sent_to(BitVec::ofNat(1), tail) {
            Chunk(bytes, writes) => λ seen ok => {
                let s = filter_state(shape.step, seen, shape.init);
                let out = filter_emitted(shape.step, bytes, s);
                let later = eof_run(filter_body(shape), filter_failed(shape), rest, AtEnd, tail, seen ++ bytes);
                let rest_out = filter_emitted(shape.step, eof_input(rest), filter_state(shape.step, seen ++ bytes, shape.init));
                let moved: (filter_state(shape.step, seen ++ bytes, shape.init) = filter_state(shape.step, bytes, s)) =
                    filter_state_append(shape.step, seen, bytes, shape.init);
                trans(chunk_sends(out, writes, later, ok.right.right.left),
                    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ t => out ++ t, filter_sends_from(shape, tail, rest, seen ++ bytes, ok.right.right.right)),
                        trans(sym(List::append_assoc(out, rest_out, sent_to(BitVec::ofNat(1), tail))),
                            cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ e => e ++ sent_to(BitVec::ofNat(1), tail),
                                trans(cong_fn<C, List<BitVec(8)>>(λ t => out ++ filter_emitted(shape.step, eof_input(rest), t), moved),
                                    sym(filter_emitted_append(shape.step, bytes, eof_input(rest), s)))))))
            },
            Interrupted => λ seen ok => filter_sends_from(shape, tail, rest, seen, ok),
        },
    }
}
theorem filter_sends<C>(shape: FilterShape<C>, tail: List<LinuxEvent>, steps: List<EofStep<List<WriteStep>>>, ok: FilterSteps(shape, steps)):
    sent_to(BitVec::ofNat(1), filter_events(shape, steps, AtEnd, tail)) =
        filter_emitted(shape.step, eof_input(steps), shape.init) ++ sent_to(BitVec::ofNat(1), tail) {
    filter_sends_from(shape, tail, steps, Nil, ok)
}

// The run: init, then the driver over the process, from the entry.
theorem read_filter_runs<C>(file: List<BitVec(8)>, shape: FilterShape<C>, facts: FilterFacts<C>(shape), jumps: FilterJumps, pj: PrintJumps,
    finish: List<BitVec(8)>, done: Nat, jump_facts: FilterJumpFacts(structured_bytes(shape.code).len(), done, jumps, pj),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), filter_code(shape.code, jumps, pj, finish), io_entry()),
    steps: List<EofStep<List<WriteStep>>>, ok: FilterSteps(shape, steps), ending: EofEnd<WriteFailure>, ending_ok: FilterEndingOk(shape, steps, ending),
    room: FilterRoom(shape.counts, eof_input(steps)), tail_events: List<LinuxEvent>,
    tail: EofTail(file, done, shape.rep, filter_state(shape.step, eof_input(steps), shape.init), tail_events),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), filter_events(shape, steps, ending, tail_events), io_initial(file, page, gprs, flags)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let p = structured_bytes(shape.code).len();
    let input = eof_input(steps);
    let pieces = λ (pg: Nat → BitVec(8)) => filter_pieces(IoMemory(file, pg), shape.code, jumps, pj, finish, resident(pg));
    let targets = filter_targets(p, done, jumps, pj, jump_facts);
    let begin = io_initial(file, page, gprs, flags);
    let started = block_fetched(fetch, data, state_init_block(), begin, trivial, pieces(page).init_at);
    let ready = execute_block_normal(state_init_block(), begin);
    let layout: EofLayout(file, fl_at_read(p), fl_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd) =
        EofLayout(λ pg => pieces(pg).head, λ pg => pieces(pg).fail, targets.finish, targets.fail, targets.retry);
    linux_runs_after_steps(io_linux(), filter_events(shape, steps, ending, tail_events), begin, ready, started.left,
        eof_from(file, fl_at_read(p), fl_at_failed(p), done, jumps.ed, jumps.sd, jumps.rd, layout, filter_inv(shape), input,
            filter_ok(shape), filter_body(shape), filter_failed_ok(shape), filter_failed(shape), tail_events,
            filter_process(shape, facts, jumps, pj, finish, done, targets, file, pieces, input, room, tail_events, tail),
            ending, ending_ok, steps)(Nil, ok, page, refl, ready, started.right, refl, facts.initialised(begin)))
}

// ---------------------------------------------------------------------------
// The finishes: the library's tails, at the end of the program.

// Nothing more: the write loop's own exit(0).
theorem filter_quiet_tail<C>(shape: FilterShape<C>, jumps: FilterJumps, pj: PrintJumps, file: List<BitVec(8)>,
    pieces: (page: Nat → BitVec(8)) → FilterPieces(IoMemory(file, page), shape.code, jumps, pj, Nil), total: C):
    EofTail(file, wl_at_exit(fl_at_write(structured_bytes(shape.code).len())), shape.rep, total, [ExitEvent(BitVec::ofNat(0))]) {
    λ page state at_done in_page _ => wl_exit(IoMemory(file, page), fl_at_write(structured_bytes(shape.code).len()), pj, pieces(page).write,
        state.gprs, state, at_done, in_page, write_kept_refl(state.gprs))
}

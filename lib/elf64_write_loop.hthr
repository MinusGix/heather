// The write loop (docs/native-syscall-failures-design.md §4) wherever a
// program puts it (docs/native-wc-design.md §5): write R10 bytes from R9 to
// stdout, advance past what was sent and stop when nothing is left, retry
// EINTR, exit 1 at any other failure, and exit 0 once all is sent. The code
// and its proof are elf64_print_pieces's, restated at an offset `at` from the
// entry instead of past that program's formatter.
import elf64_print_pieces;
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_data_read;
import x86_64_structured_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// The loop's code: write, test, JS to the failure path, advance, JZ to
// exit(0), JMP back; the failure path's retry test, JZ back and exit(1); then
// exit(0).
fn write_loop_code(pj: PrintJumps) → List<BitVec(8)> {
    canonical_block_bytes(print_write_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(eof_test_block()) ++ (near_control_bytes(JumpSignNear(pj.sd)) ++ (canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))))))))))))
}

// Offsets from the entry, piece by piece.
fn wl_at_write(at: Nat) → Nat { at }
fn wl_at_write_call(at: Nat) → Nat { wl_at_write(at) + print_write_len() }
fn wl_at_wtest(at: Nat) → Nat { wl_at_write_call(at) + 2 }
fn wl_at_wjs(at: Nat) → Nat { wl_at_wtest(at) + eof_test_len() }
fn wl_at_advance(at: Nat) → Nat { wl_at_wjs(at) + 6 }
fn wl_at_wjz(at: Nat) → Nat { wl_at_advance(at) + print_advance_len() }
fn wl_at_wjmp(at: Nat) → Nat { wl_at_wjz(at) + 6 }
fn wl_at_wfail(at: Nat) → Nat { wl_at_wjmp(at) + 5 }
fn wl_at_wretry(at: Nat) → Nat { wl_at_wfail(at) + eof_retry_len() }
fn wl_at_wfail_block(at: Nat) → Nat { wl_at_wretry(at) + 6 }
fn wl_at_wfail_call(at: Nat) → Nat { wl_at_wfail_block(at) + eof_fail_len() }
fn wl_at_exit(at: Nat) → Nat { wl_at_wfail_call(at) + 2 }
fn wl_at_exit_call(at: Nat) → Nat { wl_at_exit(at) + print_exit_len() }

// The pieces, resident at their offsets.
record WriteLoopResident(memory: IoMemory, at: Nat, pj: PrintJumps) {
    write_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_write_block()), eof_rip(wl_at_write(at))),
    write_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(), eof_rip(wl_at_write_call(at))),
    wtest_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_test_block()), eof_rip(wl_at_wtest(at))),
    wjs_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpSignNear(pj.sd)), eof_rip(wl_at_wjs(at))),
    advance_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_advance_block()), eof_rip(wl_at_advance(at))),
    wjz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(pj.zd)), eof_rip(wl_at_wjz(at))),
    wjmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(pj.bd)), eof_rip(wl_at_wjmp(at))),
    wretry_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_retry_block()), eof_rip(wl_at_wfail(at))),
    wretry_jz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(pj.rd)), eof_rip(wl_at_wretry(at))),
    wfail_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_fail_block()), eof_rip(wl_at_wfail_block(at))),
    wfail_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(), eof_rip(wl_at_wfail_call(at))),
    exit_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_exit_block()), eof_rip(wl_at_exit(at))),
    exit_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(), eof_rip(wl_at_exit_call(at))),
}

theorem write_loop_resident(memory: IoMemory, at: Nat, pj: PrintJumps,
    resident: CodeResident(io_fetch_access(), memory, write_loop_code(pj), eof_rip(at))): WriteLoopResident(memory, at, pj) {
    let fetch = io_fetch_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let r0 = resident_split_at(fetch, memory, canonical_block_bytes(print_write_block()), linux_syscall_bytes() ++ (canonical_block_bytes(eof_test_block()) ++ (near_control_bytes(JumpSignNear(pj.sd)) ++ (canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))))))))))), entry, wl_at_write(at), resident);
    let r1 = resident_split_at(fetch, memory, linux_syscall_bytes(), canonical_block_bytes(eof_test_block()) ++ (near_control_bytes(JumpSignNear(pj.sd)) ++ (canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes())))))))))), entry, wl_at_write_call(at), r0.right);
    let r2 = resident_split_at(fetch, memory, canonical_block_bytes(eof_test_block()), near_control_bytes(JumpSignNear(pj.sd)) ++ (canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))))))))), entry, wl_at_wtest(at), r1.right);
    let r3 = resident_split_at(fetch, memory, near_control_bytes(JumpSignNear(pj.sd)), canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes())))))))), entry, wl_at_wjs(at), r2.right);
    let r4 = resident_split_at(fetch, memory, canonical_block_bytes(print_advance_block()), near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))))))), entry, wl_at_advance(at), r3.right);
    let r5 = resident_split_at(fetch, memory, near_control_bytes(JumpZeroNear(pj.zd)), near_control_bytes(JumpNear(pj.bd)) ++ (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes())))))), entry, wl_at_wjz(at), r4.right);
    let r6 = resident_split_at(fetch, memory, near_control_bytes(JumpNear(pj.bd)), canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))))), entry, wl_at_wjmp(at), r5.right);
    let r7 = resident_split_at(fetch, memory, canonical_block_bytes(eof_retry_block()), near_control_bytes(JumpZeroNear(pj.rd)) ++ (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes())))), entry, wl_at_wfail(at), r6.right);
    let r8 = resident_split_at(fetch, memory, near_control_bytes(JumpZeroNear(pj.rd)), canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()))), entry, wl_at_wretry(at), r7.right);
    let r9 = resident_split_at(fetch, memory, canonical_block_bytes(eof_fail_block()), linux_syscall_bytes() ++ (canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes())), entry, wl_at_wfail_block(at), r8.right);
    let r10 = resident_split_at(fetch, memory, linux_syscall_bytes(), canonical_block_bytes(print_exit_block()) ++ (linux_syscall_bytes()), entry, wl_at_wfail_call(at), r9.right);
    let r11 = resident_split_at(fetch, memory, canonical_block_bytes(print_exit_block()), linux_syscall_bytes(), entry, wl_at_exit(at), r10.right);
    WriteLoopResident(r0.left, r1.left, r2.left, r3.left, r4.left, r5.left, r6.left, r7.left, r8.left, r9.left, r10.left, r11.left, r11.right)
}

// Where the loop's four jumps land.
record WriteTargets(at: Nat, pj: PrintJumps) {
    to_fail: near_branch_target(eof_rip(wl_at_wjs(at)), 6, pj.sd) = eof_rip(wl_at_wfail(at)),
    to_exit: near_branch_target(eof_rip(wl_at_wjz(at)), 6, pj.zd) = eof_rip(wl_at_exit(at)),
    back: near_branch_target(eof_rip(wl_at_wjmp(at)), 5, pj.bd) = eof_rip(wl_at_write(at)),
    retry: near_branch_target(eof_rip(wl_at_wretry(at)), 6, pj.rd) = eof_rip(wl_at_write(at)),
}

// Where the jumps land when all that was sent goes on at `done` rather than
// at the adjacent exit(0): a program that writes inside its read loop jumps
// back to the read (docs/native-tr-design.md §3.1).
record WriteLoopTargets(at, done: Nat, pj: PrintJumps) {
    to_fail: near_branch_target(eof_rip(wl_at_wjs(at)), 6, pj.sd) = eof_rip(wl_at_wfail(at)),
    to_done: near_branch_target(eof_rip(wl_at_wjz(at)), 6, pj.zd) = eof_rip(done),
    back: near_branch_target(eof_rip(wl_at_wjmp(at)), 5, pj.bd) = eof_rip(wl_at_write(at)),
    retry: near_branch_target(eof_rip(wl_at_wretry(at)), 6, pj.rd) = eof_rip(wl_at_write(at)),
}
theorem exit_targets(at: Nat, pj: PrintJumps, targets: WriteTargets(at, pj)): WriteLoopTargets(at, wl_at_exit(at), pj) {
    WriteLoopTargets(targets.to_fail, targets.to_exit, targets.back, targets.retry)
}

// The loop's head: `bytes` is what is left, readable at R9 and counted in R10.
fn WlThen(memory: IoMemory, at: Nat, after: List<LinuxEvent>,
    ending: WriteEnding, steps: List<WriteStep>) → Type {
    (bytes: List<BitVec(8)>) → WriteSteps(steps)(bytes) → (state: MachineState<IoMemory>) →
    0 < bytes.len() → bytes.len() <= 4096 →
    state.rip = eof_rip(wl_at_write(at)) → state.memory = memory →
    LinuxWritesFrom(io_linux(), memory, read_gpr(R9, state.gprs), bytes) →
    read_gpr(R10, state.gprs).toNat() = bytes.len() → read_gpr(R9, state.gprs).toNat() + bytes.len() < Nat::pow(2, 64) →
    LinuxRuns(io_linux(), write_events_then(bytes, steps, ending, after), state)
}

fn WlFrom(memory: IoMemory, at: Nat, ending: WriteEnding, steps: List<WriteStep>) → Type {
    WlThen(memory, at, [ExitEvent(BitVec::ofNat(0))], ending, steps)
}
// What runs once all is sent: from `done`, with the memory the loop wrote from.
fn WriteThen(memory: IoMemory, done: Nat, after: List<LinuxEvent>) → Type {
    (state: MachineState<IoMemory>) → state.rip = eof_rip(done) → state.memory = memory → LinuxRuns(io_linux(), after, state)
}

// write(1, R9, R10), asked: the block, then the SYSCALL.
fn WlAsked(memory: IoMemory, at: Nat,
    state: MachineState<IoMemory>) → Type {
    FetchedSteps(io_fetch_access(), io_data_access(), state, execute_block_normal(print_write_block(), state)) ∧
    ((execute_block_normal(print_write_block(), state).memory = memory) ∧
    ((execute_block_normal(print_write_block(), state).rip = eof_rip(wl_at_write_call(at))) ∧
    LinuxSyscallAt(io_linux(), execute_block_normal(print_write_block(), state))))
}

theorem wl_ask(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), state: MachineState<IoMemory>,
    at_write: state.rip = eof_rip(wl_at_write(at)), memory_is: state.memory = memory):
    WlAsked(memory, at, state) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let wrote = block_fetched(fetch, data, print_write_block(), state, trivial,
        resident_state(fetch, canonical_block_bytes(print_write_block()), memory,
            eof_rip(wl_at_write(at)), state, memory_is, at_write, pieces.write_at));
    let asked = execute_block_normal(print_write_block(), state);
    let asked_memory: (asked.memory = memory) = trans(pure_block_memory(print_write_block(), state), memory_is);
    let asked_rip: (asked.rip = eof_rip(wl_at_write_call(at))) =
        trans(wrote.right, rip_advance(entry, state.rip, wl_at_write(at), print_write_len(), at_write));
    ⟨wrote.left, ⟨asked_memory, ⟨asked_rip, FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip,
        resident_state(fetch, linux_syscall_bytes(), memory, eof_rip(wl_at_write_call(at)), asked,
            asked_memory, asked_rip, pieces.write_call_at)))⟩⟩⟩
}

theorem wl_advance(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), count: Nat, fits: count <= 4096,
    returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = eof_rip(wl_at_wtest(at)),
    rax: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, count)):
    WriteAdvanced(returned, memory, count, eof_rip(wl_at_wjz(at))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), memory, eof_rip(wl_at_wtest(at)),
            returned, memory_is, rip_is, pieces.wtest_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = memory) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = eof_rip(wl_at_wjs(at))) =
        trans(test.right, rip_advance(entry, returned.rip, wl_at_wtest(at), eof_test_len(), rip_is));
    let positive = eof_test_count(returned, count, fits, rax);
    let js = near_fetched_step(fetch, data, JumpSignNear(pj.sd), tested,
        resident_state(fetch, near_control_bytes(JumpSignNear(pj.sd)), memory, eof_rip(wl_at_wjs(at)),
            tested, tested_memory, tested_rip, pieces.wjs_at));
    let passed = execute_near_control(JumpSignNear(pj.sd), tested);
    let passed_rip: (passed.rip = eof_rip(wl_at_advance(at))) =
        trans(near_sign_not_taken_rip(pj.sd, tested, positive), rip_advance(entry, tested.rip, wl_at_wjs(at), 6, tested_rip));
    let advance = block_fetched(fetch, data, print_advance_block(), passed, trivial,
        resident_state(fetch, canonical_block_bytes(print_advance_block()), memory,
            eof_rip(wl_at_advance(at)), passed, tested_memory, passed_rip, pieces.advance_at));
    let moved = execute_block_normal(print_advance_block(), passed);
    let moved_memory: (moved.memory = memory) = trans(pure_block_memory(print_advance_block(), passed), tested_memory);
    let moved_rip: (moved.rip = eof_rip(wl_at_wjz(at))) =
        trans(advance.right, rip_advance(entry, passed.rip, wl_at_advance(at), print_advance_len(), passed_rip));
    let r9: (read_gpr(R9, moved.gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count))) =
        cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R9, returned.gprs).add(v), rax);
    let r10: (read_gpr(R10, moved.gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count))) =
        cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R10, returned.gprs).sub(v), rax);
    let flag: (moved.flags.zf = is_zero_bits(64, read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)))) =
        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, read_gpr(R10, returned.gprs).sub(v)), rax);
    Exists(moved, ⟨fetched_steps_trans(fetch, data, returned, tested, moved, test.left,
            fetched_steps_trans(fetch, data, tested, passed, moved, fetched_steps_one(fetch, data, tested, passed, js), advance.left)),
        ⟨moved_memory, ⟨moved_rip, ⟨r9, ⟨r10, flag⟩⟩⟩⟩⟩)
}

// All was sent: JZ to `done`.
theorem wl_done(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WriteAdvanced(returned, memory, count, eof_rip(wl_at_wjz(at))),
    none_left: advanced.witness.flags.zf = True):
    Exists<MachineState<IoMemory>>(λ going => FetchedSteps(io_fetch_access(), io_data_access(), returned, going) ∧
        ((going.memory = memory) ∧ (going.rip = eof_rip(done)))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let moved = advanced.witness;
    let moved_memory: (moved.memory = memory) = advanced.proof.right.left;
    let moved_rip: (moved.rip = eof_rip(wl_at_wjz(at))) = advanced.proof.right.right.left;
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, eof_rip(wl_at_wjz(at)),
            moved, moved_memory, moved_rip, pieces.wjz_at));
    let going = execute_near_control(JumpZeroNear(pj.zd), moved);
    let going_rip: (going.rip = eof_rip(done)) =
        trans(near_taken_rip(pj.zd, moved, none_left),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.zd), moved_rip), targets.to_done));
    Exists(going, ⟨fetched_steps_trans(fetch, data, returned, moved, going, advanced.proof.left, fetched_steps_one(fetch, data, moved, going, jz)),
        ⟨moved_memory, going_rip⟩⟩)
}

// A program's last write goes on to the adjacent exit(0).
theorem wl_exit(memory: IoMemory, at: Nat, pj: PrintJumps, pieces: WriteLoopResident(memory, at, pj)):
    WriteThen(memory, wl_at_exit(at), [ExitEvent(BitVec::ofNat(0))]) {
    λ going going_rip going_memory => {
        let fetch = io_fetch_access();
        let data = io_data_access();
        let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
        let exited = block_fetched(fetch, data, print_exit_block(), going, trivial,
            resident_state(fetch, canonical_block_bytes(print_exit_block()), memory, eof_rip(wl_at_exit(at)),
                going, going_memory, going_rip, pieces.exit_at));
        let last = execute_block_normal(print_exit_block(), going);
        let last_memory: (last.memory = memory) = trans(pure_block_memory(print_exit_block(), going), going_memory);
        let last_rip: (last.rip = eof_rip(wl_at_exit_call(at))) =
            trans(exited.right, rip_advance(entry, going.rip, wl_at_exit(at), print_exit_len(), going_rip));
        let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
            resident_state(fetch, linux_syscall_bytes(), memory, eof_rip(wl_at_exit_call(at)), last,
                last_memory, last_rip, pieces.exit_call_at)));
        linux_runs_exit(io_linux(), going, last, BitVec::ofNat(0), exited.left, call, refl, refl)
    }
}

theorem wl_more(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WriteAdvanced(returned, memory, count, eof_rip(wl_at_wjz(at))),
    some_left: advanced.witness.flags.zf = False):
    WriteBack(returned, memory, count, eof_rip(wl_at_write(at))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let moved = advanced.witness;
    let moved_memory: (moved.memory = memory) = advanced.proof.right.left;
    let moved_rip: (moved.rip = eof_rip(wl_at_wjz(at))) = advanced.proof.right.right.left;
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, eof_rip(wl_at_wjz(at)),
            moved, moved_memory, moved_rip, pieces.wjz_at));
    let going = execute_near_control(JumpZeroNear(pj.zd), moved);
    let going_rip: (going.rip = eof_rip(wl_at_wjmp(at))) =
        trans(near_not_taken_rip(pj.zd, moved, some_left), rip_advance(entry, moved.rip, wl_at_wjz(at), 6, moved_rip));
    let jmp = near_fetched_step(fetch, data, JumpNear(pj.bd), going,
        resident_state(fetch, near_control_bytes(JumpNear(pj.bd)), memory, eof_rip(wl_at_wjmp(at)),
            going, moved_memory, going_rip, pieces.wjmp_at));
    let back = execute_near_control(JumpNear(pj.bd), going);
    let back_rip: (back.rip = eof_rip(wl_at_write(at))) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, pj.bd), going_rip), targets.back);
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, moved, back, advanced.proof.left,
            fetched_steps_trans(fetch, data, moved, going, back, fetched_steps_one(fetch, data, moved, going, jz),
                fetched_steps_one(fetch, data, going, back, jmp))),
        ⟨moved_memory, ⟨back_rip, ⟨advanced.proof.right.right.right.left, advanced.proof.right.right.right.right.left⟩⟩⟩⟩)
}

theorem wl_failed(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    errno: Nat, error: Errno(errno), returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = eof_rip(wl_at_wtest(at)),
    rax: read_gpr(Rax, returned.gprs) = errno_word(errno)):
    WriteFailedAt(returned, memory, errno, eof_rip(wl_at_wretry(at))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let w = errno_word(errno);
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), memory, eof_rip(wl_at_wtest(at)),
            returned, memory_is, rip_is, pieces.wtest_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = memory) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = eof_rip(wl_at_wjs(at))) =
        trans(test.right, rip_advance(entry, returned.rip, wl_at_wtest(at), eof_test_len(), rip_is));
    let negative: (tested.flags.sf = True) =
        j(sym(rax), λ v _ => v.band(v).sign_bit() = True, test_self_negative(w, errno_negative(errno, error)));
    let js = near_fetched_step(fetch, data, JumpSignNear(pj.sd), tested,
        resident_state(fetch, near_control_bytes(JumpSignNear(pj.sd)), memory, eof_rip(wl_at_wjs(at)),
            tested, tested_memory, tested_rip, pieces.wjs_at));
    let failing = execute_near_control(JumpSignNear(pj.sd), tested);
    let failing_rip: (failing.rip = eof_rip(wl_at_wfail(at))) =
        trans(near_sign_taken_rip(pj.sd, tested, negative),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.sd), tested_rip), targets.to_fail));
    let retry = block_fetched(fetch, data, eof_retry_block(), failing, trivial,
        resident_state(fetch, canonical_block_bytes(eof_retry_block()), memory, eof_rip(wl_at_wfail(at)),
            failing, tested_memory, failing_rip, pieces.wretry_at));
    let fixed = execute_block_normal(eof_retry_block(), failing);
    let fixed_memory: (fixed.memory = memory) = trans(pure_block_memory(eof_retry_block(), failing), tested_memory);
    let fixed_rip: (fixed.rip = eof_rip(wl_at_wretry(at))) =
        trans(retry.right, rip_advance(entry, failing.rip, wl_at_wfail(at), eof_retry_len(), failing_rip));
    let flag: (fixed.flags.zf = is_zero_bits(64, w.add(BitVec::ofNat(4)))) =
        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.add(BitVec::ofNat(4))), rax);
    Exists(fixed, ⟨fetched_steps_trans(fetch, data, returned, tested, fixed, test.left,
            fetched_steps_trans(fetch, data, tested, failing, fixed, fetched_steps_one(fetch, data, tested, failing, js), retry.left)),
        ⟨fixed_memory, ⟨fixed_rip, ⟨flag, ⟨refl, refl⟩⟩⟩⟩⟩)
}

theorem wl_retry(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    returned: MachineState<IoMemory>,
    failed: WriteFailedAt(returned, memory, eintr(), eof_rip(wl_at_wretry(at)))):
    WriteKept(returned, memory, eof_rip(wl_at_write(at))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let fixed = failed.witness;
    let set: (fixed.flags.zf = True) = trans(failed.proof.right.right.right.left, eintr_plus_four());
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.rd)), memory, eof_rip(wl_at_wretry(at)),
            fixed, failed.proof.right.left, failed.proof.right.right.left, pieces.wretry_jz_at));
    let back = execute_near_control(JumpZeroNear(pj.rd), fixed);
    let back_rip: (back.rip = eof_rip(wl_at_write(at))) =
        trans(near_taken_rip(pj.rd, fixed, set),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.rd), failed.proof.right.right.left), targets.retry));
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, fixed, back, failed.proof.left, fetched_steps_one(fetch, data, fixed, back, jz)),
        ⟨failed.proof.right.left, ⟨back_rip, failed.proof.right.right.right.right⟩⟩⟩)
}

theorem wl_fail_exit(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj),
    errno: Nat, error: Errno(errno), other: Not(errno = eintr()), returned: MachineState<IoMemory>,
    failed: WriteFailedAt(returned, memory, errno, eof_rip(wl_at_wretry(at)))):
    LinuxRuns(io_linux(), [ExitEvent(BitVec::ofNat(1))], returned) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let fixed = failed.witness;
    let fixed_memory: (fixed.memory = memory) = failed.proof.right.left;
    let fixed_rip: (fixed.rip = eof_rip(wl_at_wretry(at))) = failed.proof.right.right.left;
    let clear: (fixed.flags.zf = False) = trans(failed.proof.right.right.right.left, other_errno_plus_four(errno, error, other));
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.rd)), memory, eof_rip(wl_at_wretry(at)),
            fixed, fixed_memory, fixed_rip, pieces.wretry_jz_at));
    let going = execute_near_control(JumpZeroNear(pj.rd), fixed);
    let going_rip: (going.rip = eof_rip(wl_at_wfail_block(at))) =
        trans(near_not_taken_rip(pj.rd, fixed, clear), rip_advance(entry, fixed.rip, wl_at_wretry(at), 6, fixed_rip));
    let exiting = block_fetched(fetch, data, eof_fail_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(eof_fail_block()), memory, eof_rip(wl_at_wfail_block(at)),
            going, fixed_memory, going_rip, pieces.wfail_at));
    let last = execute_block_normal(eof_fail_block(), going);
    let last_memory: (last.memory = memory) = trans(pure_block_memory(eof_fail_block(), going), fixed_memory);
    let last_rip: (last.rip = eof_rip(wl_at_wfail_call(at))) =
        trans(exiting.right, rip_advance(entry, going.rip, wl_at_wfail_block(at), eof_fail_len(), going_rip));
    let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
        resident_state(fetch, linux_syscall_bytes(), memory, eof_rip(wl_at_wfail_call(at)), last,
            last_memory, last_rip, pieces.wfail_call_at)));
    linux_runs_exit(io_linux(), returned, last, BitVec::ofNat(1),
        fetched_steps_trans(fetch, data, returned, fixed, last, failed.proof.left,
            fetched_steps_trans(fetch, data, fixed, going, last, fetched_steps_one(fetch, data, fixed, going, jz), exiting.left)),
        call, refl, refl)
}

// The loop, by recursion on the writes: every short write advances, every
// EINTR retries, and the last write sends the rest (then `after`) or fails
// (exit 1).
theorem wl_from_then(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    after: List<LinuxEvent>, then: WriteThen(memory, done, after),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>):
    WlThen(memory, at, after, ending, steps) {
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    match steps as λ ss => WlThen(memory, at, after, ending, ss) {
        Nil => λ bytes ok state some fits at_write memory_is sends counted room =>
            (match ending as λ en => WriteEndingOk(en) → LinuxRuns(io_linux(), write_events_then(bytes, Nil, en, after), state) {
                Finished => λ _ => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, after,
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        bytes.len(), Nat::le_refl(bytes.len()),
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, bytes.len()), rcx, r11);
                            let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                                rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                            let advanced = wl_advance(memory, at, pj, pieces, bytes.len(), fits,
                                returned, w.right.left, returned_rip, refl);
                            let sent = bitvec_nat::word_of_nat(64, bytes.len());
                            let sent_value: (sent.toNat() = bytes.len()) =
                                bitvec_nat::toNat_word_of_nat(64, bytes.len(), count_below_word(bytes.len(), fits));
                            let left: BitVec(64) = read_gpr(R10, state.gprs);
                            let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                                bitvec_nat::toNat_sub(64, left, sent,
                                    le_by_values(sent.toNat(), left.toNat(), bytes.len(), bytes.len(), sent_value, counted, Nat::le_refl(bytes.len())));
                            let nothing: (left.sub(sent).toNat() = 0) =
                                all_sent(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), remaining, counted, sent_value);
                            let finished = wl_done(memory, at, pj, done, pieces, targets, returned, bytes.len(), advanced,
                                trans(advanced.proof.right.right.right.right.right, zero_bits_of_zero(64, left.sub(sent), nothing)));
                            linux_runs_after_steps(io_linux(), after, returned, finished.witness, finished.proof.left,
                                then(finished.witness, finished.proof.right.right, finished.proof.right.left))
                        })
                },
                WriteFailedWith(errno) => λ bad => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, [ExitEvent(BitVec::ofNat(1))],
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        errno, bad.left,
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, errno_word(errno), rcx, r11);
                            let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                                rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                            wl_fail_exit(memory, at, pj, pieces, errno, bad.left, bad.right, returned,
                                wl_failed(memory, at, pj, done, pieces, targets, errno, bad.left, returned,
                                    w.right.left, returned_rip, refl))
                        })
                },
            })(ending_ok),
        Cons(step, rest) => (match step as λ st => WlThen(memory, at, after, ending, Cons(st, rest)) {
            Partial(count) => λ bytes ok state some fits at_write memory_is sends counted room => {
                let short: (count < bytes.len()) = ok.left;
                let asked = execute_block_normal(print_write_block(), state);
                let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events_then(bytes.drop(count), rest, ending, after),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    count, short_le(count, bytes.len(), short),
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, count), rcx, r11);
                        let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                            rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                        let fits_count: (count <= 4096) = short_fits(count, bytes.len(), short, fits);
                        let advanced = wl_advance(memory, at, pj, pieces, count, fits_count,
                            returned, w.right.left, returned_rip, refl);
                        let sent = bitvec_nat::word_of_nat(64, count);
                        let sent_value: (sent.toNat() = count) = bitvec_nat::toNat_word_of_nat(64, count, count_below_word(count, fits_count));
                        let from: BitVec(64) = read_gpr(R9, state.gprs);
                        let left: BitVec(64) = read_gpr(R10, state.gprs);
                        let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                            bitvec_nat::toNat_sub(64, left, sent,
                                le_by_values(sent.toNat(), left.toNat(), count, bytes.len(), sent_value, counted, short_le(count, bytes.len(), short)));
                        let back = wl_more(memory, at, pj, done, pieces, targets, returned, count, advanced,
                            trans(advanced.proof.right.right.right.right.right, zero_bits_of_pos(64, left.sub(sent),
                                some_left(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, remaining, counted, sent_value, short))));
                        let moved = back.witness;
                        let rest_len: (bytes.drop(count).len() + count = bytes.len()) = drop_len(bytes, count, short_le(count, bytes.len(), short));
                        let moved_at: (read_gpr(R9, moved.gprs).toNat() = from.toNat() + sent.toNat()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.proof.right.right.right.left),
                                bitvec_nat::toNat_add(64, from, sent,
                                    sent_room(from.toNat(), sent.toNat(), count, bytes.len(), Nat::pow(2, 64), sent_value,
                                        short_le(count, bytes.len(), short), room)));
                        let moved_by: (read_gpr(R9, moved.gprs).toNat() = from.toNat() + count) =
                            trans(moved_at, cong_fn<Nat, Nat>(λ c => from.toNat() + c, sent_value));
                        let moved_left: (read_gpr(R10, moved.gprs).toNat() = bytes.drop(count).len()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.proof.right.right.right.right),
                                left_after(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, bytes.drop(count).len(),
                                    remaining, counted, sent_value, rest_len));
                        let sends_rest: LinuxWritesFrom(io_linux(), memory, read_gpr(R9, moved.gprs), bytes.drop(count)) =
                            λ i b present => {
                                let whole: (bytes.nth(i + count) = Some(b)) = trans(sym(drop_nth(bytes, count, i)), present);
                                let place: (from.toNat() + (i + count) = read_gpr(R9, moved.gprs).toNat() + i) =
                                    moved_place(from.toNat(), i, count, read_gpr(R9, moved.gprs).toNat(), moved_by);
                                j(place, λ n _ => io_linux().data.read(memory, bitvec_nat::word_of_nat(64, n)) = Some(b),
                                    sends(i + count, b, whole))
                            };
                        linux_runs_after_steps(io_linux(), write_events_then(bytes.drop(count), rest, ending, after), returned, moved, back.proof.left,
                            wl_from_then(memory, at, pj, done, pieces, targets, after, then, ending, ending_ok, rest)(
                                bytes.drop(count), ok.right, moved, rest_some(bytes.drop(count).len(), count, bytes.len(), rest_len, short),
                                rest_fits(bytes.drop(count).len(), count, bytes.len(), rest_len, fits),
                                back.proof.right.right.left, back.proof.right.left, sends_rest, moved_left,
                                rest_room(read_gpr(R9, moved.gprs).toNat(), from.toNat(), count, bytes.drop(count).len(), bytes.len(), Nat::pow(2, 64),
                                    moved_by, rest_len, room)))
                    })
            },
            WriteInterrupted => λ bytes ok state some fits at_write memory_is sends counted room => {
                let asked = execute_block_normal(print_write_block(), state);
                let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                let eintr_errno: Errno(eintr()) = ⟨trivial, trivial⟩;
                linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events_then(bytes, rest, ending, after),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    eintr(), eintr_errno,
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, errno_word(eintr()), rcx, r11);
                        let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                            rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                        let back = wl_retry(memory, at, pj, done, pieces, targets, returned,
                            wl_failed(memory, at, pj, done, pieces, targets, eintr(), eintr_errno, returned,
                                w.right.left, returned_rip, refl));
                        let kept = back.witness;
                        let same_at: (read_gpr(R9, kept.gprs) = read_gpr(R9, state.gprs)) = back.proof.right.right.right.left;
                        let same_left: (read_gpr(R10, kept.gprs) = read_gpr(R10, state.gprs)) = back.proof.right.right.right.right;
                        linux_runs_after_steps(io_linux(), write_events_then(bytes, rest, ending, after), returned, kept, back.proof.left,
                            wl_from_then(memory, at, pj, done, pieces, targets, after, then, ending, ending_ok, rest)(
                                bytes, ok, kept, some, fits, back.proof.right.right.left, back.proof.right.left,
                                j(sym(same_at), λ v _ => LinuxWritesFrom(io_linux(), memory, v, bytes), sends),
                                trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), same_left), counted),
                                j(sym(same_at), λ v _ => v.toNat() + bytes.len() < Nat::pow(2, 64), room)))
                    })
            },
        }),
    }
}

// A program's last write: all sent, exit 0.
theorem wl_from(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), targets: WriteTargets(at, pj),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>):
    WlFrom(memory, at, ending, steps) {
    wl_from_then(memory, at, pj, wl_at_exit(at), pieces, exit_targets(at, pj, targets), [ExitEvent(BitVec::ofNat(0))],
        wl_exit(memory, at, pj, pieces), ending, ending_ok, steps)
}

theorem write_targets(at: Nat, pj: PrintJumps,
    fail_reads: pj.sd.sign_extend(32).toNat() = print_fail_skip(),
    exit_reads: pj.zd.sign_extend(32).toNat() = print_exit_skip(),
    back_closes: print_loop_span() + 5 + pj.bd.sign_extend(32).toNat() = Nat::pow(2, 64),
    retry_closes: print_retry_span() + 6 + pj.rd.sign_extend(32).toNat() = Nat::pow(2, 64)):
    WriteTargets(at, pj) {
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let at_w = wl_at_write(at);
    let at_js = wl_at_wjs(at);
    let at_jz = wl_at_wjz(at);
    let fail_lands: (at_js + (6 + print_fail_skip()) = wl_at_wfail(at)) =
        print_fail_sum(at_js, print_advance_len());
    let exit_lands: (at_jz + (6 + print_exit_skip()) = wl_at_exit(at)) =
        print_exit_sum(at_jz, eof_retry_len(), eof_fail_len());
    let at_jmp: (eof_rip(wl_at_wjmp(at)) = next_rip(eof_rip(at_w), print_loop_span())) =
        trans(rip_count(entry, sym(print_back_sum(at_w, print_write_len(), eof_test_len(), print_advance_len()))),
            sym(rip_compose(entry, at_w, print_loop_span())));
    let at_retry: (eof_rip(wl_at_wretry(at)) = next_rip(eof_rip(at_w), print_retry_span())) =
        trans(rip_count(entry, sym(print_retry_sum(at_w, print_write_len(), eof_test_len(), print_advance_len(), eof_retry_len()))),
            sym(rip_compose(entry, at_w, print_retry_span())));
    WriteTargets(
        to_fail := trans(near_branch_forward(eof_rip(at_js), 6, print_fail_skip(), pj.sd, fail_reads),
            trans(rip_compose(entry, at_js, 6 + print_fail_skip()), rip_count(entry, fail_lands))),
        to_exit := trans(near_branch_forward(eof_rip(at_jz), 6, print_exit_skip(), pj.zd, exit_reads),
            trans(rip_compose(entry, at_jz, 6 + print_exit_skip()), rip_count(entry, exit_lands))),
        back := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, pj.bd), at_jmp),
            near_branch_returns(eof_rip(at_w), print_loop_span(), 5, pj.bd, back_closes)),
        retry := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.rd), at_retry),
            near_branch_returns(eof_rip(at_w), print_retry_span(), 6, pj.rd, retry_closes)))
}

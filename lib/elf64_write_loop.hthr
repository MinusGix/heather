// The write loop (docs/native-syscall-failures-design.md §4) wherever a
// program puts it (docs/native-wc-design.md §5): write R10 bytes from R9 to
// stdout, advance past what was sent and stop when nothing is left, retry
// EINTR, exit 1 at any other failure, and exit 0 once all is sent. The code
// and its proof are elf64_print_pieces's, restated at an offset `at` from the
// entry instead of past that program's formatter.
import elf64_print_pieces;
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_data_read;
import x86_64_structured_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// The loop's code: write, test, JS to the failure tail, advance, JZ to
// exit(0), JMP back; the failure tail (elf64_read_pieces), whose JZ retries
// the write; then exit(0). A layout (x86_64_layout) placed at `at`.
fn write_loop_parts(pj: PrintJumps) → List<List<BitVec(8)>> {
    [canonical_block_bytes(print_write_block()), syscall_bytes(), canonical_block_bytes(eof_test_block()),
     near_control_bytes(JumpSignNear(pj.sd)), canonical_block_bytes(print_advance_block()), near_control_bytes(JumpZeroNear(pj.zd)),
     near_control_bytes(JumpNear(pj.bd)), fail_tail_code(pj.rd), canonical_block_bytes(print_exit_block())]
}
fn write_loop_lens() → List<Nat> { [print_write_len(), 2, eof_test_len(), 6, print_advance_len(), 6, 5, fail_tail_len(), print_exit_len()] }
fn write_loop_code(pj: PrintJumps) → List<BitVec(8)> { layout_code(write_loop_parts(pj), syscall_bytes()) }
theorem write_loop_measured(pj: PrintJumps): LayoutMeasured(write_loop_parts(pj), write_loop_lens()) {
    ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨fail_tail_code_len(pj.rd), ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩⟩⟩
}
fn write_loop_len() → Nat { layout_end(0, write_loop_lens()) + 2 }
theorem write_loop_code_len(pj: PrintJumps): write_loop_code(pj).len() = write_loop_len() {
    layout_len(write_loop_parts(pj), syscall_bytes(), write_loop_lens(), write_loop_measured(pj), 2, refl)
}

// Where each piece starts, for a loop at `at`.
fn wl_at(at, i: Nat) → Nat { layout_at(at, write_loop_lens(), i) }
fn wl_at_write(at: Nat) → Nat { wl_at(at, 0) }
fn wl_at_write_call(at: Nat) → Nat { wl_at(at, 1) }
fn wl_at_wtest(at: Nat) → Nat { wl_at(at, 2) }
fn wl_at_wjs(at: Nat) → Nat { wl_at(at, 3) }
fn wl_at_advance(at: Nat) → Nat { wl_at(at, 4) }
fn wl_at_wjz(at: Nat) → Nat { wl_at(at, 5) }
fn wl_at_wjmp(at: Nat) → Nat { wl_at(at, 6) }
fn wl_at_wfail(at: Nat) → Nat { wl_at(at, 7) }
fn wl_at_wretry(at: Nat) → Nat { ft_at_jz(wl_at_wfail(at)) }
fn wl_at_exit(at: Nat) → Nat { wl_at(at, 8) }
fn wl_at_exit_call(at: Nat) → Nat { wl_at(at, 9) }

// The pieces, resident at their offsets.
record WriteLoopResident(memory: IoMemory, at: Nat, pj: PrintJumps) {
    write_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_write_block()), eof_rip(wl_at_write(at))),
    write_call_at: CodeResident(io_fetch_access(), memory, syscall_bytes(), eof_rip(wl_at_write_call(at))),
    wtest_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_test_block()), eof_rip(wl_at_wtest(at))),
    wjs_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpSignNear(pj.sd)), eof_rip(wl_at_wjs(at))),
    advance_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_advance_block()), eof_rip(wl_at_advance(at))),
    wjz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(pj.zd)), eof_rip(wl_at_wjz(at))),
    wjmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(pj.bd)), eof_rip(wl_at_wjmp(at))),
    fail: FailTail(memory, wl_at_wfail(at), pj.rd),
    exit_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_exit_block()), eof_rip(wl_at_exit(at))),
    exit_call_at: CodeResident(io_fetch_access(), memory, syscall_bytes(), eof_rip(wl_at_exit_call(at))),
}

theorem write_loop_resident(memory: IoMemory, at: Nat, pj: PrintJumps,
    resident: CodeResident(io_fetch_access(), memory, write_loop_code(pj), eof_rip(at))): WriteLoopResident(memory, at, pj) {
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), syscall_bytes(), write_loop_parts(pj), write_loop_lens(),
        write_loop_measured(pj), at, resident);
    WriteLoopResident(piece(0), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6), fail_tail(memory, wl_at_wfail(at), pj.rd, piece(7)),
        piece(8), piece(9))
}

// Where the loop's four jumps land. All that was sent goes on at `done`: the
// adjacent exit(0) (`wl_at_exit`) for a program's last write, or back to the
// read for a program that writes inside its read loop
// (docs/native-tr-design.md §3.1).
record WriteLoopTargets(at, done: Nat, pj: PrintJumps) {
    to_fail: near_branch_target(eof_rip(wl_at_wjs(at)), 6, pj.sd) = eof_rip(wl_at_wfail(at)),
    to_done: near_branch_target(eof_rip(wl_at_wjz(at)), 6, pj.zd) = eof_rip(done),
    back: near_branch_target(eof_rip(wl_at_wjmp(at)), 5, pj.bd) = eof_rip(wl_at_write(at)),
    retry: near_branch_target(eof_rip(wl_at_wretry(at)), 6, pj.rd) = eof_rip(wl_at_write(at)),
}

// The registers the loop leaves alone (docs/native-stream-filter-design.md
// §4.1): its write block writes RSI, RDX, RDI and RAX, its advance R9 and
// R10, its retry RBX, and Linux returns in RAX, RCX and R11. A program's state
// in R8 and R13–R15 lives through its writes.
fn WriteKept(after, before: Gprs) → Type {
    (read_gpr(R8, after) = read_gpr(R8, before)) ∧ ((read_gpr(R12, after) = read_gpr(R12, before)) ∧
    ((read_gpr(R13, after) = read_gpr(R13, before)) ∧ ((read_gpr(R14, after) = read_gpr(R14, before)) ∧
    ((read_gpr(R15, after) = read_gpr(R15, before)) ∧ (read_gpr(Rbp, after) = read_gpr(Rbp, before))))))
}
theorem write_kept_refl(gprs: Gprs): WriteKept(gprs, gprs) { ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩ }
theorem write_kept_trans(after, middle, before: Gprs, late: WriteKept(after, middle), early: WriteKept(middle, before)): WriteKept(after, before) {
    ⟨trans(late.left, early.left), ⟨trans(late.right.left, early.right.left), ⟨trans(late.right.right.left, early.right.right.left),
        ⟨trans(late.right.right.right.left, early.right.right.right.left),
            ⟨trans(late.right.right.right.right.left, early.right.right.right.right.left),
                trans(late.right.right.right.right.right, early.right.right.right.right.right)⟩⟩⟩⟩⟩
}

// The loop's head: `bytes` is what is left, readable at R9 and counted in R10,
// and the registers it keeps are still `origin`'s.
fn WlThen(memory: IoMemory, at: Nat, after: List<LinuxEvent>,
    ending: WriteEnding, steps: List<WriteStep>, origin: Gprs) → Type {
    (bytes: List<BitVec(8)>) → WriteSteps(steps)(bytes) → (state: MachineState<IoMemory>) →
    0 < bytes.len() → bytes.len() <= 4096 →
    state.rip = eof_rip(wl_at_write(at)) → state.memory = memory →
    LinuxWritesFrom(io_linux(), memory, read_gpr(R9, state.gprs), bytes) →
    read_gpr(R10, state.gprs).toNat() = bytes.len() → read_gpr(R9, state.gprs).toNat() + bytes.len() < Nat::pow(2, 64) →
    WriteKept(state.gprs, origin) →
    LinuxRuns(io_linux(), write_events_then(bytes, steps, ending, after), state)
}

// What runs once all is sent: from `done`, with the memory the loop wrote from
// and the registers it keeps as `origin`'s.
fn WriteThen(memory: IoMemory, done: Nat, after: List<LinuxEvent>, origin: Gprs) → Type {
    (state: MachineState<IoMemory>) → state.rip = eof_rip(done) → state.memory = memory → WriteKept(state.gprs, origin) →
    LinuxRuns(io_linux(), after, state)
}

// write(1, R9, R10), asked: the block, then the SYSCALL.
fn WlAsked(memory: IoMemory, at: Nat,
    state: MachineState<IoMemory>) → Type {
    FetchedSteps(io_fetch_access(), io_data_access(), state, execute_block_normal(print_write_block(), state)) ∧
    ((execute_block_normal(print_write_block(), state).memory = memory) ∧
    ((execute_block_normal(print_write_block(), state).rip = eof_rip(wl_at_write_call(at))) ∧
    LinuxSyscallAt(io_linux(), execute_block_normal(print_write_block(), state))))
}

theorem wl_ask(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), state: MachineState<IoMemory>,
    at_write: state.rip = eof_rip(wl_at_write(at)), memory_is: state.memory = memory):
    WlAsked(memory, at, state) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let wrote = block_fetched(fetch, data, print_write_block(), state, trivial,
        resident_state(fetch, canonical_block_bytes(print_write_block()), memory,
            eof_rip(wl_at_write(at)), state, memory_is, at_write, pieces.write_at));
    let asked = execute_block_normal(print_write_block(), state);
    let asked_memory: (asked.memory = memory) = trans(pure_block_memory(print_write_block(), state), memory_is);
    let asked_rip: (asked.rip = eof_rip(wl_at_write_call(at))) =
        trans(wrote.right, rip_advance(entry, state.rip, wl_at_write(at), print_write_len(), at_write));
    ⟨wrote.left, ⟨asked_memory, ⟨asked_rip, FetchedFrom(resident_readable(fetch, asked.memory, syscall_bytes(), asked.rip,
        resident_state(fetch, syscall_bytes(), memory, eof_rip(wl_at_write_call(at)), asked,
            asked_memory, asked_rip, pieces.write_call_at)))⟩⟩⟩
}

// After a write returned: TEST, JS not taken, the advance (named, so what a
// client knows of the other registers it keeps by conversion).
fn wl_moved(returned: MachineState<IoMemory>, pj: PrintJumps) → MachineState<IoMemory> {
    execute_block_normal(print_advance_block(), execute_near_control(JumpSignNear(pj.sd), execute_block_normal(eof_test_block(), returned)))
}
// R9 has moved past what was sent, R10 counts what is left, and ZF says
// whether anything is.
record WlMoved(returned: MachineState<IoMemory>, memory: IoMemory, count: Nat, to: BitVec(64), pj: PrintJumps) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), returned, wl_moved(returned, pj)),
    memory_is: wl_moved(returned, pj).memory = memory,
    rip_is: wl_moved(returned, pj).rip = to,
    r9: read_gpr(R9, wl_moved(returned, pj).gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count)),
    r10: read_gpr(R10, wl_moved(returned, pj).gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)),
    flag: wl_moved(returned, pj).flags.zf = is_zero_bits(64, read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count))),
}

theorem wl_advance(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), count: Nat, fits: count <= 4096,
    returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = eof_rip(wl_at_wtest(at)),
    rax: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, count)):
    WlMoved(returned, memory, count, eof_rip(wl_at_wjz(at)), pj) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), memory, eof_rip(wl_at_wtest(at)),
            returned, memory_is, rip_is, pieces.wtest_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = memory) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = eof_rip(wl_at_wjs(at))) =
        trans(test.right, rip_advance(entry, returned.rip, wl_at_wtest(at), eof_test_len(), rip_is));
    let positive = eof_test_count(returned, count, fits, rax);
    let js = near_fetched_step(fetch, data, JumpSignNear(pj.sd), tested,
        resident_state(fetch, near_control_bytes(JumpSignNear(pj.sd)), memory, eof_rip(wl_at_wjs(at)),
            tested, tested_memory, tested_rip, pieces.wjs_at));
    let passed = execute_near_control(JumpSignNear(pj.sd), tested);
    let passed_rip: (passed.rip = eof_rip(wl_at_advance(at))) =
        trans(near_sign_not_taken_rip(pj.sd, tested, positive), rip_advance(entry, tested.rip, wl_at_wjs(at), 6, tested_rip));
    let advance = block_fetched(fetch, data, print_advance_block(), passed, trivial,
        resident_state(fetch, canonical_block_bytes(print_advance_block()), memory,
            eof_rip(wl_at_advance(at)), passed, tested_memory, passed_rip, pieces.advance_at));
    let moved = execute_block_normal(print_advance_block(), passed);
    WlMoved(
        steps := fetched_steps_trans(fetch, data, returned, tested, moved, test.left,
            fetched_steps_trans(fetch, data, tested, passed, moved, fetched_steps_one(fetch, data, tested, passed, js), advance.left)),
        memory_is := trans(pure_block_memory(print_advance_block(), passed), tested_memory),
        rip_is := trans(advance.right, rip_advance(entry, passed.rip, wl_at_advance(at), print_advance_len(), passed_rip)),
        r9 := cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R9, returned.gprs).add(v), rax),
        r10 := cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R10, returned.gprs).sub(v), rax),
        flag := cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, read_gpr(R10, returned.gprs).sub(v)), rax))
}

// All was sent: JZ to `done`.
fn wl_going(returned: MachineState<IoMemory>, pj: PrintJumps) → MachineState<IoMemory> {
    execute_near_control(JumpZeroNear(pj.zd), wl_moved(returned, pj))
}
record WlGoing(returned: MachineState<IoMemory>, memory: IoMemory, done: Nat, pj: PrintJumps) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), returned, wl_going(returned, pj)),
    memory_is: wl_going(returned, pj).memory = memory,
    rip_is: wl_going(returned, pj).rip = eof_rip(done),
}
theorem wl_done(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WlMoved(returned, memory, count, eof_rip(wl_at_wjz(at)), pj),
    none_left: wl_moved(returned, pj).flags.zf = True): WlGoing(returned, memory, done, pj) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let moved = wl_moved(returned, pj);
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, eof_rip(wl_at_wjz(at)),
            moved, advanced.memory_is, advanced.rip_is, pieces.wjz_at));
    WlGoing(steps := fetched_steps_trans(fetch, data, returned, moved, wl_going(returned, pj), advanced.steps,
            fetched_steps_one(fetch, data, moved, wl_going(returned, pj), jz)),
        memory_is := advanced.memory_is,
        rip_is := trans(near_taken_rip(pj.zd, moved, none_left),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.zd), advanced.rip_is), targets.to_done)))
}

// A program's last write goes on to the adjacent exit(0).
theorem wl_exit(memory: IoMemory, at: Nat, pj: PrintJumps, pieces: WriteLoopResident(memory, at, pj)):
    (origin: Gprs) → WriteThen(memory, wl_at_exit(at), [ExitEvent(BitVec::ofNat(0))], origin) {
    λ origin going going_rip going_memory _ => {
        let fetch = io_fetch_access();
        let data = io_data_access();
        let entry = io_entry();
        let exited = block_fetched(fetch, data, print_exit_block(), going, trivial,
            resident_state(fetch, canonical_block_bytes(print_exit_block()), memory, eof_rip(wl_at_exit(at)),
                going, going_memory, going_rip, pieces.exit_at));
        let last = execute_block_normal(print_exit_block(), going);
        let last_memory: (last.memory = memory) = trans(pure_block_memory(print_exit_block(), going), going_memory);
        let last_rip: (last.rip = eof_rip(wl_at_exit_call(at))) =
            trans(exited.right, rip_advance(entry, going.rip, wl_at_exit(at), print_exit_len(), going_rip));
        let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, syscall_bytes(), last.rip,
            resident_state(fetch, syscall_bytes(), memory, eof_rip(wl_at_exit_call(at)), last,
                last_memory, last_rip, pieces.exit_call_at)));
        linux_runs_exit(io_linux(), going, last, BitVec::ofNat(0), exited.left, call, refl, refl)
    }
}

// Something is left: JZ not taken, JMP back to the write.
fn wl_back(returned: MachineState<IoMemory>, pj: PrintJumps) → MachineState<IoMemory> {
    execute_near_control(JumpNear(pj.bd), execute_near_control(JumpZeroNear(pj.zd), wl_moved(returned, pj)))
}
record WlBack(returned: MachineState<IoMemory>, memory: IoMemory, count: Nat, to: BitVec(64), pj: PrintJumps) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), returned, wl_back(returned, pj)),
    memory_is: wl_back(returned, pj).memory = memory,
    rip_is: wl_back(returned, pj).rip = to,
    r9: read_gpr(R9, wl_back(returned, pj).gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count)),
    r10: read_gpr(R10, wl_back(returned, pj).gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)),
}
theorem wl_more(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WlMoved(returned, memory, count, eof_rip(wl_at_wjz(at)), pj),
    some_left: wl_moved(returned, pj).flags.zf = False):
    WlBack(returned, memory, count, eof_rip(wl_at_write(at)), pj) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let moved = wl_moved(returned, pj);
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, eof_rip(wl_at_wjz(at)),
            moved, advanced.memory_is, advanced.rip_is, pieces.wjz_at));
    let going = execute_near_control(JumpZeroNear(pj.zd), moved);
    let going_rip: (going.rip = eof_rip(wl_at_wjmp(at))) =
        trans(near_not_taken_rip(pj.zd, moved, some_left), rip_advance(entry, moved.rip, wl_at_wjz(at), 6, advanced.rip_is));
    let jmp = near_fetched_step(fetch, data, JumpNear(pj.bd), going,
        resident_state(fetch, near_control_bytes(JumpNear(pj.bd)), memory, eof_rip(wl_at_wjmp(at)),
            going, advanced.memory_is, going_rip, pieces.wjmp_at));
    WlBack(
        steps := fetched_steps_trans(fetch, data, returned, moved, wl_back(returned, pj), advanced.steps,
            fetched_steps_trans(fetch, data, moved, going, wl_back(returned, pj), fetched_steps_one(fetch, data, moved, going, jz),
                fetched_steps_one(fetch, data, going, wl_back(returned, pj), jmp))),
        memory_is := advanced.memory_is,
        rip_is := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, pj.bd), going_rip), targets.back),
        r9 := advanced.r9,
        r10 := advanced.r10)
}

// A failed write: TEST, then JS to the failure tail.
fn wl_failing(returned: MachineState<IoMemory>, pj: PrintJumps) → MachineState<IoMemory> {
    execute_near_control(JumpSignNear(pj.sd), execute_block_normal(eof_test_block(), returned))
}
record WlFailing(returned: MachineState<IoMemory>, memory: IoMemory, at: Nat, pj: PrintJumps) {
    steps: FetchedSteps(io_fetch_access(), io_data_access(), returned, wl_failing(returned, pj)),
    memory_is: wl_failing(returned, pj).memory = memory,
    rip_is: wl_failing(returned, pj).rip = eof_rip(wl_at_wfail(at)),
}
theorem wl_failed(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    errno: Nat, error: Errno(errno), returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = eof_rip(wl_at_wtest(at)),
    rax: read_gpr(Rax, returned.gprs) = errno_word(errno)): WlFailing(returned, memory, at, pj) {
    have test = block_ran(eof_test_block(), memory, wl_at_wtest(at), pieces.wtest_at, returned, memory_is, rip_is);
    let tested = execute_block_normal(eof_test_block(), returned);
    let negative: (tested.flags.sf = True) =
        j(sym(rax), λ v _ => v.band(v).sign_bit() = True, test_self_negative(errno_word(errno), errno_negative(errno, error)));
    let js = near_ran(JumpSignNear(pj.sd), memory, wl_at_wjs(at), pieces.wjs_at, tested, test.memory_is, test.rip_is);
    WlFailing(steps := fetched_steps_trans(io_fetch_access(), io_data_access(), returned, tested, wl_failing(returned, pj), test.steps, js),
        memory_is := test.memory_is,
        rip_is := trans(near_sign_taken_rip(pj.sd, tested, negative),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.sd), test.rip_is), targets.to_fail)))
}

// The loop, by recursion on the writes: every short write advances, every
// EINTR retries, and the last write sends the rest (then `after`) or fails
// (exit 1).
// What runs once all is sent, for writes that finish; writes that fail exit
// 1 and need nothing after them.
fn FinishedThen(ending: WriteEnding, memory: IoMemory, done: Nat, after: List<LinuxEvent>, origin: Gprs) → Type {
    match ending { Finished => WriteThen(memory, done, after, origin), WriteFailedWith(_) => True }
}
theorem finished_then(ending: WriteEnding, memory: IoMemory, done: Nat, after: List<LinuxEvent>, origin: Gprs,
    then: WriteThen(memory, done, after, origin)): FinishedThen(ending, memory, done, after, origin) {
    match ending as λ en => FinishedThen(en, memory, done, after, origin) { Finished => then, WriteFailedWith(_) => trivial }
}

theorem wl_from_then(memory: IoMemory, at: Nat, pj: PrintJumps,
    done: Nat, pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, done, pj),
    after: List<LinuxEvent>, ending: WriteEnding, ending_ok: WriteEndingOk(ending), origin: Gprs,
    then: FinishedThen(ending, memory, done, after, origin), steps: List<WriteStep>):
    WlThen(memory, at, after, ending, steps, origin) {
    let entry = io_entry();
    match steps as λ ss => WlThen(memory, at, after, ending, ss, origin) {
        Nil => λ bytes ok state some fits at_write memory_is sends counted room kept =>
            (match ending as λ en => WriteEndingOk(en) → FinishedThen(en, memory, done, after, origin) →
                    LinuxRuns(io_linux(), write_events_then(bytes, Nil, en, after), state) {
                Finished => λ _ then => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, after,
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        bytes.len(), Nat::le_refl(bytes.len()),
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, bytes.len()), rcx, r11);
                            let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                                rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                            let advanced = wl_advance(memory, at, pj, pieces, bytes.len(), fits,
                                returned, w.right.left, returned_rip, refl);
                            let sent = bitvec_nat::word_of_nat(64, bytes.len());
                            let sent_value: (sent.toNat() = bytes.len()) =
                                bitvec_nat::toNat_word_of_nat(64, bytes.len(), count_below_word(bytes.len(), fits));
                            let left: BitVec(64) = read_gpr(R10, state.gprs);
                            let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                                bitvec_nat::toNat_sub(64, left, sent,
                                    le_by_values(sent.toNat(), left.toNat(), bytes.len(), bytes.len(), sent_value, counted, Nat::le_refl(bytes.len())));
                            let nothing: (left.sub(sent).toNat() = 0) =
                                all_sent(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), remaining, counted, sent_value);
                            have finished = wl_done(memory, at, pj, done, pieces, targets, returned, bytes.len(), advanced,
                                trans(advanced.flag, zero_bits_of_zero(64, left.sub(sent), nothing)));
                            let going = wl_going(returned, pj);
                            linux_runs_after_steps(io_linux(), after, returned, going, finished.steps,
                                then(going, finished.rip_is, finished.memory_is,
                                    write_kept_trans(going.gprs, state.gprs, origin, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩, kept)))
                        })
                },
                WriteFailedWith(errno) => λ bad _ => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, [ExitEvent(BitVec::ofNat(1))],
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        errno, bad.left,
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, errno_word(errno), rcx, r11);
                            let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                                rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                            have failing = wl_failed(memory, at, pj, done, pieces, targets, errno, bad.left, returned,
                                w.right.left, returned_rip, refl);
                            linux_runs_after_steps(io_linux(), [ExitEvent(BitVec::ofNat(1))], returned, wl_failing(returned, pj), failing.steps,
                                fail_exit(memory, wl_at_wfail(at), pj.rd, pieces.fail, errno, bad.left, bad.right, wl_failing(returned, pj),
                                    failing.memory_is, failing.rip_is, refl))
                        })
                },
            })(ending_ok, then),
        Cons(step, rest) => (match step as λ st => WlThen(memory, at, after, ending, Cons(st, rest), origin) {
            Partial(count) => λ bytes ok state some fits at_write memory_is sends counted room kept => {
                let short: (count < bytes.len()) = ok.left;
                let asked = execute_block_normal(print_write_block(), state);
                let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events_then(bytes.drop(count), rest, ending, after),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    count, short_le(count, bytes.len(), short),
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, count), rcx, r11);
                        let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                            rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                        let fits_count: (count <= 4096) = short_fits(count, bytes.len(), short, fits);
                        let advanced = wl_advance(memory, at, pj, pieces, count, fits_count,
                            returned, w.right.left, returned_rip, refl);
                        let sent = bitvec_nat::word_of_nat(64, count);
                        let sent_value: (sent.toNat() = count) = bitvec_nat::toNat_word_of_nat(64, count, count_below_word(count, fits_count));
                        let from: BitVec(64) = read_gpr(R9, state.gprs);
                        let left: BitVec(64) = read_gpr(R10, state.gprs);
                        let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                            bitvec_nat::toNat_sub(64, left, sent,
                                le_by_values(sent.toNat(), left.toNat(), count, bytes.len(), sent_value, counted, short_le(count, bytes.len(), short)));
                        have back = wl_more(memory, at, pj, done, pieces, targets, returned, count, advanced,
                            trans(advanced.flag, zero_bits_of_pos(64, left.sub(sent),
                                some_left(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, remaining, counted, sent_value, short))));
                        let moved = wl_back(returned, pj);
                        let rest_len: (bytes.drop(count).len() + count = bytes.len()) = drop_len(bytes, count, short_le(count, bytes.len(), short));
                        let moved_at: (read_gpr(R9, moved.gprs).toNat() = from.toNat() + sent.toNat()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.r9),
                                bitvec_nat::toNat_add(64, from, sent,
                                    sent_room(from.toNat(), sent.toNat(), count, bytes.len(), Nat::pow(2, 64), sent_value,
                                        short_le(count, bytes.len(), short), room)));
                        let moved_by: (read_gpr(R9, moved.gprs).toNat() = from.toNat() + count) =
                            trans(moved_at, cong_fn<Nat, Nat>(λ c => from.toNat() + c, sent_value));
                        let moved_left: (read_gpr(R10, moved.gprs).toNat() = bytes.drop(count).len()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.r10),
                                left_after(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, bytes.drop(count).len(),
                                    remaining, counted, sent_value, rest_len));
                        let sends_rest: LinuxWritesFrom(io_linux(), memory, read_gpr(R9, moved.gprs), bytes.drop(count)) =
                            λ i b present => {
                                let whole: (bytes.nth(i + count) = Some(b)) = trans(sym(drop_nth(bytes, count, i)), present);
                                let place: (from.toNat() + (i + count) = read_gpr(R9, moved.gprs).toNat() + i) =
                                    moved_place(from.toNat(), i, count, read_gpr(R9, moved.gprs).toNat(), moved_by);
                                j(place, λ n _ => io_linux().data.read(memory, bitvec_nat::word_of_nat(64, n)) = Some(b),
                                    sends(i + count, b, whole))
                            };
                        linux_runs_after_steps(io_linux(), write_events_then(bytes.drop(count), rest, ending, after), returned, moved, back.steps,
                            wl_from_then(memory, at, pj, done, pieces, targets, after, ending, ending_ok, origin, then, rest)(
                                bytes.drop(count), ok.right, moved, rest_some(bytes.drop(count).len(), count, bytes.len(), rest_len, short),
                                rest_fits(bytes.drop(count).len(), count, bytes.len(), rest_len, fits),
                                back.rip_is, back.memory_is, sends_rest, moved_left,
                                rest_room(read_gpr(R9, moved.gprs).toNat(), from.toNat(), count, bytes.drop(count).len(), bytes.len(), Nat::pow(2, 64),
                                    moved_by, rest_len, room),
                                write_kept_trans(moved.gprs, state.gprs, origin, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩, kept)))
                    })
            },
            WriteInterrupted => λ bytes ok state some fits at_write memory_is sends counted room kept => {
                let asked = execute_block_normal(print_write_block(), state);
                let w = wl_ask(memory, at, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                let eintr_errno: Errno(eintr()) = ⟨trivial, trivial⟩;
                linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events_then(bytes, rest, ending, after),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    eintr(), eintr_errno,
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, errno_word(eintr()), rcx, r11);
                        let returned_rip: (returned.rip = eof_rip(wl_at_wtest(at))) =
                            rip_advance(entry, asked.rip, wl_at_write_call(at), 2, w.right.right.left);
                        have failing = wl_failed(memory, at, pj, done, pieces, targets, eintr(), eintr_errno, returned,
                            w.right.left, returned_rip, refl);
                        have back = fail_retry(memory, wl_at_wfail(at), pj.rd, pieces.fail, wl_at_write(at), targets.retry,
                            wl_failing(returned, pj), failing.memory_is, failing.rip_is, refl);
                        let again = fail_back(wl_failing(returned, pj), pj.rd);
                        let same_at: (read_gpr(R9, again.gprs) = read_gpr(R9, state.gprs)) = refl;
                        let same_left: (read_gpr(R10, again.gprs) = read_gpr(R10, state.gprs)) = refl;
                        linux_runs_after_steps(io_linux(), write_events_then(bytes, rest, ending, after), returned, again,
                            fetched_steps_trans(io_fetch_access(), io_data_access(), returned, wl_failing(returned, pj), again, failing.steps, back.steps),
                            wl_from_then(memory, at, pj, done, pieces, targets, after, ending, ending_ok, origin, then, rest)(
                                bytes, ok, again, some, fits, back.rip_is, back.memory_is,
                                j(sym(same_at), λ v _ => LinuxWritesFrom(io_linux(), memory, v, bytes), sends),
                                trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), same_left), counted),
                                j(sym(same_at), λ v _ => v.toNat() + bytes.len() < Nat::pow(2, 64), room),
                                write_kept_trans(again.gprs, state.gprs, origin, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩⟩⟩, kept)))
                    })
            },
        }),
    }
}

// A program's last write: all sent, exit 0.
theorem wl_from(memory: IoMemory, at: Nat, pj: PrintJumps,
    pieces: WriteLoopResident(memory, at, pj), targets: WriteLoopTargets(at, wl_at_exit(at), pj),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>, origin: Gprs):
    WlThen(memory, at, [ExitEvent(BitVec::ofNat(0))], ending, steps, origin) {
    wl_from_then(memory, at, pj, wl_at_exit(at), pieces, targets, [ExitEvent(BitVec::ofNat(0))], ending, ending_ok, origin,
        finished_then(ending, memory, wl_at_exit(at), [ExitEvent(BitVec::ofNat(0))], origin, wl_exit(memory, at, pj, pieces, origin)), steps)
}

// The loop's own three jumps, as the producer proves them at the written
// bytes: closed facts about the loop's offsets from its start, whatever the
// program it is placed in. JS to the failure tail, JMP and the retry's JZ back
// to the write.
record WriteJumpFacts(pj: PrintJumps) {
    fail: JumpsForward(wl_at_wjs(0), 6, pj.sd, wl_at_wfail(0)),
    back: JumpsBack(wl_at_wjmp(0), 5, pj.bd, wl_at_write(0)),
    retry: JumpsBack(wl_at_wretry(0), 6, pj.rd, wl_at_write(0)),
}
// And a program's last write, whose all-sent JZ goes to the adjacent exit(0).
record PrintJumpFacts(pj: PrintJumps) {
    write: WriteJumpFacts(pj),
    exit: JumpsForward(wl_at_wjz(0), 6, pj.zd, wl_at_exit(0)),
}

// A loop at `at` is `at` past one at 0.
theorem wl_shift(at, i: Nat): wl_at(at, i) = at + wl_at(0, i) { layout_shift(write_loop_lens(), at, 0, i) }
theorem wl_retry_shift(at: Nat): wl_at_wretry(at) = at + wl_at_wretry(0) {
    trans(cong_fn<Nat, Nat>(λ x => x + eof_retry_len(), wl_shift(at, 7)), Nat::add_assoc(at, wl_at(0, 7), eof_retry_len()))
}

// The targets at `at`, the all-sent JZ's target given.
theorem write_targets_to(at, done: Nat, pj: PrintJumps, facts: WriteJumpFacts(pj),
    to_done: near_branch_target(eof_rip(wl_at_wjz(at)), 6, pj.zd) = eof_rip(done)): WriteLoopTargets(at, done, pj) {
    let entry = io_entry();
    WriteLoopTargets(
        to_fail := jumps_forward_at(entry, at, wl_at_wjs(0), 6, pj.sd, wl_at_wfail(0), wl_at_wjs(at), wl_at_wfail(at),
            wl_shift(at, 3), wl_shift(at, 7), facts.fail),
        to_done := to_done,
        back := jumps_back_at(entry, at, wl_at_wjmp(0), 5, pj.bd, wl_at_write(0), wl_at_wjmp(at), wl_at_write(at),
            wl_shift(at, 6), wl_shift(at, 0), facts.back),
        retry := jumps_back_at(entry, at, wl_at_wretry(0), 6, pj.rd, wl_at_write(0), wl_at_wretry(at), wl_at_write(at),
            wl_retry_shift(at), wl_shift(at, 0), facts.retry))
}
theorem write_targets(at: Nat, pj: PrintJumps, facts: PrintJumpFacts(pj)): WriteLoopTargets(at, wl_at_exit(at), pj) {
    write_targets_to(at, wl_at_exit(at), pj, facts.write,
        jumps_forward_at(io_entry(), at, wl_at_wjz(0), 6, pj.zd, wl_at_exit(0), wl_at_wjz(at), wl_at_exit(at), wl_shift(at, 5), wl_shift(at, 8),
            facts.exit))
}

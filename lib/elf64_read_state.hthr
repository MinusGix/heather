// The read-until-end-of-file process over a loop whose state is not one
// count (docs/native-wc-design.md §4.8): read stdin a page at a time, fold
// each chunk into the state with a certified loop, stop at the empty read, and
// hand the state to a tail. The state lives in its own registers, R13, R14,
// R15 and R8, which nothing between reads writes, so the loop updates it in
// place and nothing is copied or saved around a read. Failed reads are
// elf64_read_pieces's: EINTR retries, anything else exits 1.
// Nothing here is about any one program. The state's type, its placement
// over the registers and its invariant are parameters; a program supplies its
// loop certificate, that its step folds, and three facts about the placement:
// it reads only the state registers, init's zeros place the initial state,
// and the state folded over any input fits the next chunk's budget.
import elf64_read_pieces;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_layout;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// Init zeroes the state registers. The chunk's setup is elf64_read_pieces's,
// less the carry's copy: the loop reads its state where it already is.
fn state_init_block() → List<Instruction> {
    [MovRI(R13, BitVec::ofNat(0)), MovRI(R14, BitVec::ofNat(0)), MovRI(R15, BitVec::ofNat(0)), MovRI(R8, BitVec::ofNat(0))]
}
fn state_setup_block(needle: BitVec(8)) → List<Instruction> {
    [MovRR(Rbp, Rax), MovRR(R12, Rax), MovRI(Rdi, BitVec::ofNat(io_page_base())), MovRI(Rcx, needle.zero_extend(56)),
     MovRI(Rsi, BitVec::ofNat(0))]
}
fn state_init_len() → Nat { canonical_block_bytes(state_init_block()).len() }
fn state_setup_len(needle: BitVec(8)) → Nat { canonical_block_bytes(state_setup_block(needle)).len() }

// The program: init, the read head (elf64_read_pieces), the chunk's setup
// and loop and the jump back, the failure tail, then the tail; a layout
// (x86_64_layout) whose loop is measured by its length, never by its bytes.
fn state_parts(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps) → List<List<BitVec(8)>> {
    [canonical_block_bytes(state_init_block()), read_head_code(jumps.ed, jumps.sd), canonical_block_bytes(state_setup_block(needle)),
     loop_bytes, near_control_bytes(JumpNear(jumps.bd)), fail_tail_code(jumps.rd)]
}
fn state_lens(needle: BitVec(8), loop_len: Nat) → List<Nat> {
    [state_init_len(), read_head_len(), state_setup_len(needle), loop_len, 5, fail_tail_len()]
}
fn state_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>) → List<BitVec(8)> {
    layout_code(state_parts(needle, loop_bytes, jumps), tail)
}
fn read_state_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps) → List<BitVec(8)> {
    state_code(needle, loop_bytes, jumps, eof_exit_code())
}
theorem state_measured(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, loop_len: Nat, loop_is: loop_bytes.len() = loop_len):
    LayoutMeasured(state_parts(needle, loop_bytes, jumps), state_lens(needle, loop_len)) {
    ⟨refl, ⟨read_head_code_len(jumps.ed, jumps.sd), ⟨refl, ⟨loop_is, ⟨refl, ⟨fail_tail_code_len(jumps.rd), trivial⟩⟩⟩⟩⟩⟩
}
// The code's length from its loop's and tail's, over open parts: a
// certificate measures its generated pieces by their own lemmas instead of
// evaluating their encodings (docs/native-loop-generator-fold-design.md §3.3).
theorem state_code_len(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>, loop_len, tail_len: Nat,
    loop_is: loop_bytes.len() = loop_len, tail_is: tail.len() = tail_len):
    state_code(needle, loop_bytes, jumps, tail).len() = layout_end(0, state_lens(needle, loop_len)) + tail_len {
    layout_len(state_parts(needle, loop_bytes, jumps), tail, state_lens(needle, loop_len), state_measured(needle, loop_bytes, jumps, loop_len, loop_is),
        tail_len, tail_is)
}

// Where each piece starts, from the entry.
fn state_at(needle: BitVec(8), loop_bytes: List<BitVec(8)>, i: Nat) → Nat { layout_at(0, state_lens(needle, loop_bytes.len()), i) }
fn state_at_read(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 1) }
fn state_at_setup(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 2) }
fn state_at_loop(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 3) }
fn state_at_jmp(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 4) }
fn state_at_failed(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 5) }
fn state_at_done(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { state_at(needle, loop_bytes, 6) }

// The program's pieces, resident at their offsets from the entry.
record StatePieces(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>) {
    init_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(state_init_block()), eof_rip(state_at(needle, loop_bytes, 0))),
    head: ReadHead(memory, state_at_read(needle, loop_bytes), jumps.ed, jumps.sd),
    setup_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(state_setup_block(needle)), eof_rip(state_at_setup(needle, loop_bytes))),
    loop_at: CodeResident(io_fetch_access(), memory, loop_bytes, eof_rip(state_at_loop(needle, loop_bytes))),
    jmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(jumps.bd)), eof_rip(state_at_jmp(needle, loop_bytes))),
    fail: FailTail(memory, state_at_failed(needle, loop_bytes), jumps.rd),
    tail_at: CodeResident(io_fetch_access(), memory, tail, eof_rip(state_at_done(needle, loop_bytes))),
}

theorem state_pieces(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, tail: List<BitVec(8)>,
    resident: CodeResident(io_fetch_access(), memory, state_code(needle, loop_bytes, jumps, tail), io_entry())):
    StatePieces(memory, needle, loop_bytes, jumps, tail) {
    let piece = layout_resident(io_fetch_access(), memory, io_entry(), tail, state_parts(needle, loop_bytes, jumps),
        state_lens(needle, loop_bytes.len()), state_measured(needle, loop_bytes, jumps, loop_bytes.len(), refl), 0, resident);
    StatePieces(piece(0), read_head(memory, state_at_read(needle, loop_bytes), jumps.ed, jumps.sd, piece(1)), piece(2), piece(3), piece(4),
        fail_tail(memory, state_at_failed(needle, loop_bytes), jumps.rd, piece(5)), piece(6))
}

// ---------------------------------------------------------------------------
// What a program says about its state.

// The profile's head registers, as the loop certificate's placement names
// them. The state's registers are the placement's business (`rep`).
record ReadStatePlacement(p: LoopPlacement) {
    base: p.base = Rdi, length: p.length = Rbp, needle: p.needle = Rcx, cursor: p.cursor = Rsi, budget: p.budget = R12,
}

// Two register files agree on the state registers.
fn StateKept(after, before: Gprs) → Type {
    (read_gpr(R13, after) = read_gpr(R13, before)) ∧ ((read_gpr(R14, after) = read_gpr(R14, before)) ∧
    ((read_gpr(R15, after) = read_gpr(R15, before)) ∧ (read_gpr(R8, after) = read_gpr(R8, before))))
}
// The placement reads only the state registers.
fn StateFramed<C>(rep: Gprs → C → Type) → Type {
    (before, after: Gprs) → (carry: C) → StateKept(after, before) → rep(before, carry) → rep(after, carry)
}
// Init's zeros place the initial state.
fn StateInitialised<C>(rep: Gprs → C → Type, init: C) → Type {
    (state: MachineState<IoMemory>) → rep(execute_block_normal(state_init_block(), state).gprs, init)
}
// The state folded over any input read so far fits a loop over the next
// chunk, while the two together are shorter than 2^64.
fn StateRoom<C>(fits: Nat → Nat → C → Type, region: ReadonlyLoop<C>, needle: BitVec(8), init: C) → Type {
    (seen: List<BitVec(8)>) → (n: Nat) → seen.len() + n < Nat::pow(2, 64) → fits(0, n, step_fold(region, needle, seen, init))
}

// A certified loop over the state, as the loop generator publishes
// one, over this profile's memory.
fn ReadStateCertificate<C>(p: LoopPlacement, rep: Gprs → C → Type, fits: Nat → Nat → C → Type, region: ReadonlyLoop<C>,
    loop_code: AccessCode, loop_bytes: List<BitVec(8)>, source: ReadonlyBytes → BitVec(8) → Nat → Nat → C → LoopOutcome<C>) → Type {
    (access: ByteReadAccess<IoMemory>) → (before: MachineState<IoMemory>) → (buffer: ReadonlyBytes) →
    (needle: BitVec(8)) → (budget, cursor: Nat) → (carry: C) →
    LoopAddressBound(64, buffer) → buffer.base + buffer.length <= Nat::pow(2, 47) →
    LoopHead<IoMemory, C>(p, rep, access, buffer, needle, before, cursor, budget, carry) →
    LoopReadable(budget, region, buffer, needle, cursor, carry) → fits(cursor, budget, carry) →
    Exists<MachineState<IoMemory>>(λ after => AccessArtifact<IoMemory>(access, loop_code, loop_bytes, before, after) ∧
        LoopObserved<IoMemory, C>(p, rep, after, source(buffer, needle, budget, cursor, carry)))
}

// The loop, as a program's generated loop certificate supplies it: the
// data (where the head sits, how the state is placed and fits, the step, the
// loop's code and bytes, the source, the needle), none of it depending on
// the rest, and apart from it what is proved about it. A record whose later
// fields depend on its earlier ones costs the kernel far more at every
// projection, so the proofs are a record over the data, not beside it.
record StateShape<C> {
    p: LoopPlacement,
    rep: Gprs → C → Type,
    fits: Nat → Nat → C → Type,
    region: ReadonlyLoop<C>,
    code: AccessCode,
    bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → C → LoopOutcome<C>,
    needle: BitVec(8),
}
record StateLoop<C>(shape: StateShape<C>) {
    at: ReadStatePlacement(shape.p),
    framed: StateFramed(shape.rep),
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor: Nat) → (carry: C) →
        loop_run(budget, shape.region, buffer, needle, cursor, carry) = shape.source(buffer, needle, budget, cursor, carry),
    native: ReadStateCertificate(shape.p, shape.rep, shape.fits, shape.region, shape.code, shape.bytes, shape.source),
    folds: LoopFolds(shape.region),
}

// Where the state starts: init's zeros place `init`, and the state folded
// from it over any input so far fits the next chunk's loop.
record StateStart<C>(shape: StateShape<C>, init: C) {
    initialised: StateInitialised(shape.rep, init),
    room: StateRoom(shape.fits, shape.region, shape.needle, init),
}

// ---------------------------------------------------------------------------
// One chunk.

// The loop over one chunk, from the start of a buffer holding it: the fold
// from the state so far.
theorem state_chunk_folds<C>(region: ReadonlyLoop<C>, source: ReadonlyBytes → BitVec(8) → Nat → Nat → C → LoopOutcome<C>,
    needle: BitVec(8),
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor: Nat) → (carry: C) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    folds: LoopFolds(region), carry: C, bytes: List<BitVec(8)>, buffer: ReadonlyBytes, length: buffer.length = bytes.len(),
    reads: (i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → buffer.read(buffer.base + i) = Some(byte)):
    source(buffer, needle, bytes.len(), 0, carry) = End(bytes.len(), 0, step_fold(region, needle, bytes, carry)) {
    let from_start = Nat::add_left_zero(bytes.len());
    let ran = loop_run_folds(region, folds, needle, bytes, buffer, 0, carry, trans(length, sym(from_start)),
        λ i byte present => j(sym(Nat::add_left_zero(i)), λ at _ => buffer.read(buffer.base + at) = Some(byte), reads(i, byte, present)));
    trans(sym(agreement(buffer, needle, bytes.len(), 0, carry)),
        trans(ran, cong_fn<Nat, LoopOutcome<C>>(λ at => End(at, 0, step_fold(region, needle, bytes, carry)), from_start)))
}

fn state_after_setup(needle: BitVec(8), state: MachineState<IoMemory>) → MachineState<IoMemory> {
    execute_block_normal(state_setup_block(needle), state)
}

theorem state_loop_head<C>(p: LoopPlacement, at: ReadStatePlacement(p), rep: Gprs → C → Type, framed: StateFramed(rep),
    needle: BitVec(8), bytes: List<BitVec(8)>, fits: bytes.len() <= 4096, carry: C, state: MachineState<IoMemory>,
    length_word: read_gpr(Rax, state.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    placed: rep(state.gprs, carry)):
    LoopHead<IoMemory, C>(p, rep, io_data_access(), io_buffer(state.memory, bytes.len()), needle,
        state_after_setup(needle, state), 0, bytes.len(), carry) {
    let ready = state_after_setup(needle, state);
    let n = bytes.len();
    let below: (n < Nat::pow(2, 64)) = Succ(n).le_trans(4097, Nat::pow(2, 64), fits, Nat::leb_sound(4097, Nat::pow(2, 64), trivial));
    let counted: (read_gpr(Rbp, ready.gprs).toNat() = n) =
        trans(cong_fn<BitVec(64), Nat>(λ word => word.toNat(), length_word), bitvec_nat::toNat_word_of_nat(64, n, below));
    let budgeted: (read_gpr(R12, ready.gprs).toNat() = n) = counted;
    LoopHead(
        base_placed := j(sym(at.base), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), io_page_base()), refl),
        length_placed := j(sym(at.length), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), counted),
        needle_placed := j(sym(at.needle), λ r _ => read_gpr(r, ready.gprs) = needle.zero_extend(56), refl),
        cursor_placed := j(sym(at.cursor), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), 0), refl),
        budget_placed := j(sym(at.budget), λ r _ => LoopWord(64, read_gpr(r, ready.gprs), n), budgeted),
        carry_placed := framed(state.gprs, ready.gprs, carry, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, placed),
        inside := trivial,
        memory_agrees := λ word => io_buffer_agrees(state.memory, n, word))
}

// Set up and run: the state is folded over the chunk, memory is what the read
// left, and RIP is past the loop.
fn ReadStateFolded<C>(rep: Gprs → C → Type, returned: MachineState<IoMemory>, stored: IoMemory, carry: C, done_at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ done => FetchedSteps(io_fetch_access(), io_data_access(), returned, done) ∧
        ((done.memory = stored) ∧ ((done.rip = done_at) ∧ rep(done.gprs, carry))))
}

// After a read returned `bytes`, from `at_setup`: set up the loop's head and
// run the loop over the state where it is.
theorem state_folds<C>(file: List<BitVec(8)>, page: Nat → BitVec(8), shape: StateShape<C>, l: StateLoop<C>(shape),
    bytes: List<BitVec(8)>, fits: bytes.len() <= read_capacity(), carry: C, room: shape.fits(0, bytes.len(), carry),
    ready_in: MachineState<IoMemory>, at_setup: Nat,
    memory_is: ready_in.memory = io_store_offset(IoMemory(file, page), 0, bytes),
    rip_is: ready_in.rip = eof_rip(at_setup),
    length_word: read_gpr(Rax, ready_in.gprs) = bitvec_nat::word_of_nat(64, bytes.len()),
    placed: shape.rep(ready_in.gprs, carry),
    setup_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        canonical_block_bytes(state_setup_block(shape.needle)), eof_rip(at_setup)),
    loop_at: CodeResident(io_fetch_access(), io_store_offset(IoMemory(file, page), 0, bytes),
        shape.bytes, eof_rip(at_setup + state_setup_len(shape.needle)))):
    ReadStateFolded(shape.rep, ready_in, io_store_offset(IoMemory(file, page), 0, bytes), step_fold(shape.region, shape.needle, bytes, carry),
        eof_rip((at_setup + state_setup_len(shape.needle)) + shape.bytes.len())) {
    let p = shape.p;
    let at = l.at;
    let rep = shape.rep;
    let fits_of = shape.fits;
    let framed = l.framed;
    let region = shape.region;
    let loop_code = shape.code;
    let loop_bytes = shape.bytes;
    let source = shape.source;
    let needle = shape.needle;
    let agreement = l.agreement;
    let native = l.native;
    let folds = l.folds;
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry = io_entry();
    let n = bytes.len();
    let stored = io_store_offset(IoMemory(file, page), 0, bytes);
    let at_loop = at_setup + state_setup_len(needle);
    let at_exit = at_loop + loop_bytes.len();
    let setup = block_fetched(fetch, data, state_setup_block(needle), ready_in, trivial,
        resident_state(fetch, canonical_block_bytes(state_setup_block(needle)), stored, eof_rip(at_setup),
            ready_in, memory_is, rip_is, setup_at));
    let ready = state_after_setup(needle, ready_in);
    let ready_memory: (ready.memory = stored) = trans(pure_block_memory(state_setup_block(needle), ready_in), memory_is);
    let ready_rip: (ready.rip = eof_rip(at_loop)) =
        trans(setup.right, rip_advance(entry, ready_in.rip, at_setup, state_setup_len(needle), rip_is));
    let buffer = io_buffer(ready_in.memory, n);
    let reads = λ (i: Nat) (byte: BitVec(8)) (present: bytes.nth(i) = Some(byte)) =>
        j(sym(memory_is), λ memory _ => io_read(memory, bitvec_nat::word_of_nat(64, io_page_base() + i)) = Some(byte),
            io_read_stored(IoMemory(file, page), bytes, i, byte,
                Succ(i).le_trans(n, 4096, nth_some_below(bytes, i, byte, present), fits), present));
    let computed = state_chunk_folds(region, source, needle, agreement, folds, carry, bytes, buffer, refl, reads);
    let readable: LoopReadable(n, region, buffer, needle, 0, carry) =
        j(sym(trans(agreement(buffer, needle, n, 0, carry), computed)), λ outcome _ => LoopFinishedNormally(outcome), trivial);
    let within: (Succ(io_page_base() + n) <= io_page_base() + 4097) = omega;
    let bounded: LoopAddressBound(64, buffer) =
        Succ(io_page_base() + n).le_trans(io_page_base() + 4097, Nat::pow(2, 64), within,
            Nat::leb_sound(io_page_base() + 4097, Nat::pow(2, 64), trivial));
    let low: (buffer.base + buffer.length <= Nat::pow(2, 47)) =
        (io_page_base() + n).le_trans(io_page_base() + 4096, Nat::pow(2, 47), Nat::add_le_mono_l(io_page_base(), n, 4096, fits),
            Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 47), trivial));
    have ran = native(data, ready, buffer, needle, n, 0, carry, bounded, low,
        state_loop_head(p, at, rep, framed, needle, bytes, fits, carry, ready_in, length_word, placed), readable, room);
    let done = ran.witness;
    let looped = access_artifact_fetched(fetch, data, loop_code, loop_bytes, ready, done, ran.proof.left,
        resident_state(fetch, loop_bytes, stored, eof_rip(at_loop), ready, ready_memory, ready_rip, loop_at));
    let done_memory: (done.memory = stored) = trans(access_memory(data, loop_code, ready, done, ran.proof.left.execution), ready_memory);
    let done_rip: (done.rip = eof_rip(at_exit)) =
        trans(looped.right, rip_advance(entry, ready.rip, at_loop, loop_bytes.len(), ready_rip));
    let observed = j(computed, λ outcome _ => LoopObserved<IoMemory, C>(p, rep, done, outcome), ran.proof.right);
    Exists(done, ⟨fetched_steps_trans(fetch, data, ready_in, ready, done, setup.left, looped.left),
        ⟨done_memory, ⟨done_rip, observed.right.right.right⟩⟩⟩)
}

// Where the loop is again after a chunk: back at the read, the chunk stored,
// the state folded over it.
fn StateBack<C>(rep: Gprs → C → Type, returned: MachineState<IoMemory>, stored: IoMemory, carry: C, read_at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ back => FetchedSteps(io_fetch_access(), io_data_access(), returned, back) ∧
        ((back.memory = stored) ∧ ((back.rip = read_at) ∧ rep(back.gprs, carry))))
}

// The chunk's close: jump back to the read. The loop's run is an argument, so
// the proof mentions it once.
theorem state_chunk_close<C>(rep: Gprs → C → Type, framed: StateFramed(rep),
    returned, going: MachineState<IoMemory>, stored: IoMemory, carry: C, bd: BitVec(32), at_jmp, at_read: Nat,
    back_target: near_branch_target(eof_rip(at_jmp), 5, bd) = eof_rip(at_read),
    entered: FetchedSteps(io_fetch_access(), io_data_access(), returned, going),
    folded: ReadStateFolded(rep, going, stored, carry, eof_rip(at_jmp)),
    jmp_at: CodeResident(io_fetch_access(), stored, near_control_bytes(JumpNear(bd)), eof_rip(at_jmp))):
    StateBack(rep, returned, stored, carry, eof_rip(at_read)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let done = folded.witness;
    let jump = near_fetched_step(fetch, data, JumpNear(bd), done,
        resident_state(fetch, near_control_bytes(JumpNear(bd)), stored, eof_rip(at_jmp), done,
            folded.proof.right.left, folded.proof.right.right.left, jmp_at));
    let back = execute_near_control(JumpNear(bd), done);
    let back_rip: (back.rip = eof_rip(at_read)) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, bd), folded.proof.right.right.left), back_target);
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, going, back, entered,
            fetched_steps_trans(fetch, data, going, done, back, folded.proof.left, fetched_steps_one(fetch, data, done, back, jump))),
        ⟨folded.proof.right.left, ⟨back_rip,
            framed(done.gprs, back.gprs, carry, ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩, folded.proof.right.right.right)⟩⟩⟩)
}

// ---------------------------------------------------------------------------
// The loop.

// A tail placed at `at`, from there with the final state in its registers:
// what runs after the empty read, whatever process read to it.
fn EofTail<C>(file: List<BitVec(8)>, at: Nat, rep: Gprs → C → Type, total: C, events: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.rip = eof_rip(at) →
    state.memory = IoMemory(file, page) → rep(state.gprs, total) → LinuxRuns(io_linux(), events, state)
}

// Where the process's four jumps land: JZ to the tail at end of file, JS to
// the failure tail, JMP back to the read after a chunk, and the retry's JZ
// back to the read.
record StateTargets(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps) {
    exit: near_branch_target(eof_rip(rh_at_jz(state_at_read(needle, loop_bytes))), 6, jumps.ed) = eof_rip(state_at_done(needle, loop_bytes)),
    fail: near_branch_target(eof_rip(rh_at_js(state_at_read(needle, loop_bytes))), 6, jumps.sd) = eof_rip(state_at_failed(needle, loop_bytes)),
    back: near_branch_target(eof_rip(state_at_jmp(needle, loop_bytes)), 5, jumps.bd) = eof_rip(state_at_read(needle, loop_bytes)),
    retry: near_branch_target(eof_rip(ft_at_jz(state_at_failed(needle, loop_bytes))), 6, jumps.rd) = eof_rip(state_at_read(needle, loop_bytes)),
}

// The fold's invariant at the read: the state folded over what has been read
// sits in its registers.
fn state_inv<C>(shape: StateShape<C>, init: C) → List<BitVec(8)> → Gprs → Type {
    λ seen gprs => shape.rep(gprs, step_fold(shape.region, shape.needle, seen, init))
}

// What has been read with the chunk is shorter than 2^64, since the whole
// input is shorter still.
theorem state_room_arith(s, b, r, n: Nat, whole: n = s + (b + r), room: n + 4096 < Nat::pow(2, 64)): s + b < Nat::pow(2, 64) { omega }
theorem state_room_here(seen, bytes, rest, input: List<BitVec(8)>, prefix: seen ++ (bytes ++ rest) = input,
    room: input.len() + 4096 < Nat::pow(2, 64)): seen.len() + bytes.len() < Nat::pow(2, 64) {
    let whole: (input.len() = seen.len() + (bytes.len() + rest.len())) =
        trans(cong_fn<List<BitVec(8)>, Nat>(λ xs => xs.len(), sym(prefix)),
            trans(List::len_append(seen, bytes ++ rest), cong_fn<Nat, Nat>(λ n => seen.len() + n, List::len_append(bytes, rest))));
    state_room_arith(seen.len(), bytes.len(), rest.len(), input.len(), whole, room)
}

// One chunk, from past the head: set up, fold the chunk into the state,
// jump back to the read, and go on from there.
theorem state_body<C>(file: List<BitVec(8)>, shape: StateShape<C>, l: StateLoop<C>(shape), init: C,
    room_for: StateRoom(shape.fits, shape.region, shape.needle, init), jumps: EofJumps,
    back_target: near_branch_target(eof_rip(state_at_jmp(shape.needle, shape.bytes)), 5, jumps.bd) = eof_rip(state_at_read(shape.needle, shape.bytes)),
    tail_code: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → StatePieces(IoMemory(file, page), shape.needle, shape.bytes, jumps, tail_code),
    input: List<BitVec(8)>, room: input.len() + 4096 < Nat::pow(2, 64)):
    EofBody<True>(file, state_at_read(shape.needle, shape.bytes), state_inv(shape, init), input, λ _ _ => True, λ _ _ after => after) {
    λ page seen bytes rest x some fits _ prefix going at_setup memory_is length_word held after next => {
        let stored = io_store_offset(IoMemory(file, page), 0, bytes);
        let there = pieces(stored.page);
        let carry = step_fold(shape.region, shape.needle, seen, init);
        let room_here = state_room_here(seen, bytes, rest, input, prefix, room);
        have folded = state_folds(file, page, shape, l, bytes, fits, carry, room_for(seen, bytes.len(), room_here), going, state_at_setup(shape.needle, shape.bytes),
            memory_is, at_setup, length_word, held, there.setup_at, there.loop_at);
        have back = state_chunk_close(shape.rep, l.framed, going, going, stored, step_fold(shape.region, shape.needle, bytes, carry), jumps.bd,
            state_at_jmp(shape.needle, shape.bytes), state_at_read(shape.needle, shape.bytes), back_target,
            fetched_steps_refl(io_fetch_access(), io_data_access(), going), folded, there.jmp_at);
        let moved: shape.rep(back.witness.gprs, step_fold(shape.region, shape.needle, seen ++ bytes, init)) =
            j(sym(step_fold_append(shape.region, shape.needle, seen, bytes, init)), λ c _ => shape.rep(back.witness.gprs, c),
                back.proof.right.right.right);
        linux_runs_after_steps(io_linux(), after, going, back.witness, back.proof.left,
            next(stored.page, back.witness, back.proof.right.right.left, back.proof.right.left, moved))
    }
}

// The process for the driver: the fold's invariant, the chunk as above, no
// chunk ending the run, and the tail at `state_at_done`.
theorem state_process<C>(file: List<BitVec(8)>, shape: StateShape<C>, l: StateLoop<C>(shape), init: C,
    room_for: StateRoom(shape.fits, shape.region, shape.needle, init), jumps: EofJumps, targets: StateTargets(shape.needle, shape.bytes, jumps),
    tail_code: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → StatePieces(IoMemory(file, page), shape.needle, shape.bytes, jumps, tail_code),
    input: List<BitVec(8)>, room: input.len() + 4096 < Nat::pow(2, 64), tail_events: List<LinuxEvent>,
    tail: EofTail(file, state_at_done(shape.needle, shape.bytes), shape.rep, step_fold(shape.region, shape.needle, input, init), tail_events)):
    EofProcess<True, False>(file, state_at_read(shape.needle, shape.bytes), state_at_done(shape.needle, shape.bytes), state_inv(shape, init), input,
        λ _ _ => True, λ _ _ after => after, λ _ _ => True, λ _ _ => Nil, tail_events) {
    EofProcess(
        framed := λ seen before after kept held => l.framed(before, after, step_fold(shape.region, shape.needle, seen, init),
            ⟨kept.right.right.right.right.right.right.left, ⟨kept.right.right.right.right.right.right.right.left,
                ⟨kept.right.right.right.right.right.right.right.right, kept.right.right.left⟩⟩⟩, held),
        chunk := state_body(file, shape, l, init, room_for, jumps, targets.back, tail_code, pieces, input, room),
        ends := λ page seen bytes y => false_elim(y),
        at_end := tail)
}

// ---------------------------------------------------------------------------
// The four jumps' targets, from a closed fact about each displacement that the
// producer proves at the written bytes.

record StateJumpFacts(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps) {
    exit: JumpsForward(rh_at_jz(state_at_read(needle, loop_bytes)), 6, jumps.ed, state_at_done(needle, loop_bytes)),
    fail: JumpsForward(rh_at_js(state_at_read(needle, loop_bytes)), 6, jumps.sd, state_at_failed(needle, loop_bytes)),
    back: JumpsBack(state_at_jmp(needle, loop_bytes), 5, jumps.bd, state_at_read(needle, loop_bytes)),
    retry: JumpsBack(ft_at_jz(state_at_failed(needle, loop_bytes)), 6, jumps.rd, state_at_read(needle, loop_bytes)),
}
theorem state_targets(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, facts: StateJumpFacts(needle, loop_bytes, jumps)):
    StateTargets(needle, loop_bytes, jumps) {
    let at_read = state_at_read(needle, loop_bytes);
    StateTargets(jumps_forward(io_entry(), rh_at_jz(at_read), 6, jumps.ed, state_at_done(needle, loop_bytes), facts.exit),
        jumps_forward(io_entry(), rh_at_js(at_read), 6, jumps.sd, state_at_failed(needle, loop_bytes), facts.fail),
        jumps_back(io_entry(), state_at_jmp(needle, loop_bytes), 5, jumps.bd, at_read, facts.back),
        jumps_back(io_entry(), ft_at_jz(state_at_failed(needle, loop_bytes)), 6, jumps.rd, at_read, facts.retry))
}

// ---------------------------------------------------------------------------
// The exit profile.

// From the tail at `at`, a status the first state register holds: exit(status).
theorem state_exit_tail<C>(file: List<BitVec(8)>, at: Nat, rep: Gprs → C → Type,
    status: C → Nat, status_word: (gprs: Gprs) → (carry: C) → rep(gprs, carry) → read_gpr(R13, gprs) = bitvec_nat::word_of_nat(64, status(carry)),
    total: C,
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), eof_exit_code(), eof_rip(at))):
    EofTail(file, at, rep, total, [ExitEvent(bitvec_nat::word_of_nat(64, status(total)))]) {
    λ page state at_done memory_is placed => {
        let fetch = io_fetch_access();
        let x = canonical_block_bytes(eof_exit_block());
        let parts = resident_split_at(fetch, IoMemory(file, page), x, syscall_bytes(), io_entry(), at, resident(page));
        have exited = block_ran(eof_exit_block(), IoMemory(file, page), at, parts.left, state, memory_is, at_done);
        let last = execute_block_normal(eof_exit_block(), state);
        let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, syscall_bytes(), last.rip,
            resident_state(fetch, syscall_bytes(), IoMemory(file, page), eof_rip(at + eof_exit_len()),
                last, exited.memory_is, exited.rip_is, parts.right)));
        linux_runs_exit(io_linux(), state, last, bitvec_nat::word_of_nat(64, status(total)), exited.steps, call, refl,
            status_word(state.gprs, total, placed))
    }
}

// Init, then the loop from the initial state with nothing read.
theorem state_start<C>(file: List<BitVec(8)>, shape: StateShape<C>, l: StateLoop<C>(shape), init: C, start: StateStart<C>(shape, init),
    jumps: EofJumps, targets: StateTargets(shape.needle, shape.bytes, jumps),
    tail_code: List<BitVec(8)>, pieces: (page: Nat → BitVec(8)) → StatePieces(IoMemory(file, page), shape.needle, shape.bytes, jumps, tail_code),
    chunks: List<EofStep<True>>, ok: EofChunks(chunks), ending: EofEnd<False>, ending_ok: EofEnding(ending),
    room: eof_input(chunks).len() + 4096 < Nat::pow(2, 64),
    tail_events: List<LinuxEvent>,
    tail: EofTail(file, state_at_done(shape.needle, shape.bytes), shape.rep, step_fold(shape.region, shape.needle, eof_input(chunks), init), tail_events),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending, tail_events), io_initial(file, page, gprs, flags)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let begin = io_initial(file, page, gprs, flags);
    let started = block_fetched(fetch, data, state_init_block(), begin, trivial, pieces(page).init_at);
    let ready = execute_block_normal(state_init_block(), begin);
    let input = eof_input(chunks);
    let layout: EofLayout(file, state_at_read(shape.needle, shape.bytes), state_at_failed(shape.needle, shape.bytes), state_at_done(shape.needle, shape.bytes),
        jumps.ed, jumps.sd, jumps.rd) = EofLayout(λ p => pieces(p).head, λ p => pieces(p).fail, targets.exit, targets.fail, targets.retry);
    linux_runs_after_steps(io_linux(), eof_events(chunks, ending, tail_events), begin, ready, started.left,
        eof_from(file, state_at_read(shape.needle, shape.bytes), state_at_failed(shape.needle, shape.bytes), state_at_done(shape.needle, shape.bytes),
            jumps.ed, jumps.sd, jumps.rd, layout, state_inv(shape, init), input, λ _ _ => True, λ _ _ after => after,
            λ _ _ => True, λ _ _ => Nil, tail_events,
            state_process(file, shape, l, init, start.room, jumps, targets, tail_code, pieces, input, room, tail_events, tail),
            ending, ending_ok, chunks)(ok, page, Nil, refl, ready, started.right, refl, start.initialised(begin)))
}

// The process claim: for every way the reads may split the input into
// non-empty chunks, with EINTRs anywhere between them, ending at the empty
// read or at a failed read, the file has a run that reads them all, retries
// every EINTR, and then exits with the status of the state folded over the
// chunks' concatenation or, after the failure, with 1.
theorem read_state_runs<C>(file: List<BitVec(8)>, shape: StateShape<C>, l: StateLoop<C>(shape), init: C, start: StateStart<C>(shape, init),
    status: C → Nat, status_word: (gprs: Gprs) → (carry: C) → shape.rep(gprs, carry) → read_gpr(R13, gprs) = bitvec_nat::word_of_nat(64, status(carry)),
    jumps: EofJumps, facts: StateJumpFacts(shape.needle, shape.bytes, jumps),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), read_state_code(shape.needle, shape.bytes, jumps),
        io_entry()),
    chunks: List<EofStep<True>>, ok: EofChunks(chunks), ending: EofEnd<False>, ending_ok: EofEnding(ending),
    room: eof_input(chunks).len() + 4096 < Nat::pow(2, 64),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending,
        [ExitEvent(bitvec_nat::word_of_nat(64, status(step_fold(shape.region, shape.needle, eof_input(chunks), init))))]),
        io_initial(file, page, gprs, flags)) {
    let pieces = λ (page: Nat → BitVec(8)) => state_pieces(IoMemory(file, page), shape.needle, shape.bytes, jumps, eof_exit_code(), resident(page));
    let total = step_fold(shape.region, shape.needle, eof_input(chunks), init);
    state_start(file, shape, l, init, start, jumps, state_targets(shape.needle, shape.bytes, jumps, facts),
        eof_exit_code(), pieces, chunks, ok, ending, ending_ok, room, [ExitEvent(bitvec_nat::word_of_nat(64, status(total)))],
        state_exit_tail(file, state_at_done(shape.needle, shape.bytes), shape.rep, status, status_word, total, λ page => pieces(page).tail_at),
        page, gprs, flags)
}

// ---------------------------------------------------------------------------
// A Nat state (`wc -l`'s shape): a count, read in R13 as its word. How the
// count is placed is the loop generator's, a parameter
// (docs/native-loop-generator-fold-design.md §3.2).

fn CountWord(rep: Gprs → Nat → Type) → Type {
    (gprs: Gprs) → (carry: Nat) → rep(gprs, carry) → read_gpr(R13, gprs) = bitvec_nat::word_of_nat(64, carry)
}

// The exit claim: for every history of reads, a run that exits with the
// program's specification of the input (ReadEofComputes: the step folded
// from zero), or with 1 at a failed read.
theorem read_count_runs(file: List<BitVec(8)>, shape: StateShape<Nat>, l: StateLoop<Nat>(shape), spec: List<BitVec(8)> → Nat,
    computes: ReadEofComputes(shape.region, shape.needle, spec), start: StateStart<Nat>(shape, 0), word: CountWord(shape.rep),
    jumps: EofJumps, facts: StateJumpFacts(shape.needle, shape.bytes, jumps),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), read_state_code(shape.needle, shape.bytes, jumps),
        io_entry()),
    chunks: List<EofStep<True>>, ok: EofChunks(chunks), ending: EofEnd<False>, ending_ok: EofEnding(ending),
    room: eof_input(chunks).len() + 4096 < Nat::pow(2, 64),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending, [ExitEvent(bitvec_nat::word_of_nat(64, spec(eof_input(chunks))))]),
        io_initial(file, page, gprs, flags)) {
    j(sym(computes(eof_input(chunks))), λ n _ => LinuxRuns(io_linux(), eof_events(chunks, ending, [ExitEvent(bitvec_nat::word_of_nat(64, n))]),
            io_initial(file, page, gprs, flags)),
        read_state_runs(file, shape, l, 0, start, λ (c: Nat) => c, word, jumps, facts, resident, chunks, ok, ending, ending_ok, room, page, gprs, flags))
}

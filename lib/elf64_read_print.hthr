// The read-print process shape (docs/native-first-program-design.md §10,
// docs/native-read-until-eof-design.md): elf64_read_loop's loop reads and
// counts stdin to its end, then this tail writes the count as a decimal line
// to stdout and exits 0. As in elf64_read_loop, nothing here is about one
// program: the loop, its source and specification are parameters, and so are
// the formatter's three certificates, which the producer generates from
// decimal_line's source functions. The profile fixes their registers: the
// count in R11 (copied from the loop's R13), the page's base in R8, the
// line's word in RAX, its start in R9 and its length in R10.
import elf64_read_loop;
import decimal_line;
import elf64_io;
import linux_x86_64_entry;
import linux_x86_64_io;
import function_ir_loop;
import function_ir_loop_trace;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_access_code;
import x86_64_access_memory;
import x86_64_fetched_code;
import x86_64_structured_block;
import x86_64_store;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// The count where the formatter reads it, and where the line's word is
// stored: the page's base.
fn print_base_block() → List<Instruction> { [MovRR(R11, R13), MovRI(R8, BitVec::ofNat(0x401000))] }
fn print_store() → WordStore { WordStore(R8, Rax) }
// write(1, start, length).
fn print_write_block() → List<Instruction> {
    [MovRR(Rsi, R9), MovRR(Rdx, R10), MovRI(Rdi, BitVec::ofNat(1)), MovRI(Rax, BitVec::ofNat(1))]
}
// exit(0).
fn print_exit_block() → List<Instruction> { [MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))] }
// After a write returned a count: the buffer advances past what was sent, and
// what remains is counted down, setting ZF when nothing does.
fn print_advance_block() → List<Instruction> { [AddRR(R9, Rax), SubRR(R10, Rax)] }

// The write loop's jumps: JS to its failure path, JZ to exit(0) when all is
// sent, JMP back after a short write, JZ back after EINTR.
record PrintJumps { sd: BitVec(32), zd: BitVec(32), bd: BitVec(32), rd: BitVec(32) }

// The tail after the loop: base, formatter, store, then the write loop (write,
// test, JS, advance, JZ, JMP; the failure path's retry test, JZ back and
// exit(1)), then exit(0).
fn print_tail(word, start, length: StructuredCode, pj: PrintJumps) → List<BitVec(8)> {
    canonical_block_bytes(print_base_block()) ++ (structured_bytes(word) ++ (structured_bytes(start) ++
    (structured_bytes(length) ++ (word_store_bytes(print_store()) ++ (canonical_block_bytes(print_write_block()) ++
    (linux_syscall_bytes() ++ (canonical_block_bytes(eof_test_block()) ++ (near_control_bytes(JumpSignNear(pj.sd)) ++
    (canonical_block_bytes(print_advance_block()) ++ (near_control_bytes(JumpZeroNear(pj.zd)) ++ (near_control_bytes(JumpNear(pj.bd)) ++
    (canonical_block_bytes(eof_retry_block()) ++ (near_control_bytes(JumpZeroNear(pj.rd)) ++
    (canonical_block_bytes(eof_fail_block()) ++ (linux_syscall_bytes() ++
    (canonical_block_bytes(print_exit_block()) ++ linux_syscall_bytes()))))))))))))))))
}
fn read_print_code(needle: BitVec(8), loop_bytes: List<BitVec(8)>, jumps: EofJumps, word, start, length: StructuredCode,
    pj: PrintJumps) → List<BitVec(8)> {
    eof_code(needle, loop_bytes, jumps, print_tail(word, start, length, pj))
}

fn print_base_len() → Nat { canonical_block_bytes(print_base_block()).len() }
fn print_write_len() → Nat { canonical_block_bytes(print_write_block()).len() }
fn print_advance_len() → Nat { canonical_block_bytes(print_advance_block()).len() }
fn print_exit_len() → Nat { canonical_block_bytes(print_exit_block()).len() }

// Offsets from the entry, piece by piece: the tail starts where the loop's
// code ends.
fn print_at_base(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { eof_at_done(needle, loop_bytes) }
fn print_at_word(needle: BitVec(8), loop_bytes: List<BitVec(8)>) → Nat { print_at_base(needle, loop_bytes) + print_base_len() }
fn print_at_start(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word: StructuredCode) → Nat {
    print_at_word(needle, loop_bytes) + structured_bytes(word).len()
}
fn print_at_length(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start: StructuredCode) → Nat {
    print_at_start(needle, loop_bytes, word) + structured_bytes(start).len()
}
fn print_at_store(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_length(needle, loop_bytes, word, start) + structured_bytes(length).len()
}
fn print_at_write(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_store(needle, loop_bytes, word, start, length) + word_store_bytes(print_store()).len()
}
fn print_at_write_call(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_write(needle, loop_bytes, word, start, length) + print_write_len()
}
fn print_at_wtest(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_write_call(needle, loop_bytes, word, start, length) + 2
}
fn print_at_wjs(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wtest(needle, loop_bytes, word, start, length) + eof_test_len()
}
fn print_at_advance(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wjs(needle, loop_bytes, word, start, length) + 6
}
fn print_at_wjz(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_advance(needle, loop_bytes, word, start, length) + print_advance_len()
}
fn print_at_wjmp(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wjz(needle, loop_bytes, word, start, length) + 6
}
fn print_at_wfail(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wjmp(needle, loop_bytes, word, start, length) + 5
}
fn print_at_wretry(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wfail(needle, loop_bytes, word, start, length) + eof_retry_len()
}
fn print_at_wfail_block(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wretry(needle, loop_bytes, word, start, length) + 6
}
fn print_at_wfail_call(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wfail_block(needle, loop_bytes, word, start, length) + eof_fail_len()
}
fn print_at_exit(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_wfail_call(needle, loop_bytes, word, start, length) + 2
}
fn print_at_exit_call(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode) → Nat {
    print_at_exit(needle, loop_bytes, word, start, length) + print_exit_len()
}

fn print_rip(at: Nat) → BitVec(64) { next_rip(BitVec::ofNat(0x4000e8), at) }

// The tail's pieces, resident at their offsets from the entry.
record ReadPrintResident(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode,
    pj: PrintJumps) {
    base_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_base_block()), print_rip(print_at_base(needle, loop_bytes))),
    word_at: CodeResident(io_fetch_access(), memory, structured_bytes(word), print_rip(print_at_word(needle, loop_bytes))),
    start_at: CodeResident(io_fetch_access(), memory, structured_bytes(start), print_rip(print_at_start(needle, loop_bytes, word))),
    length_at: CodeResident(io_fetch_access(), memory, structured_bytes(length), print_rip(print_at_length(needle, loop_bytes, word, start))),
    store_at: CodeResident(io_fetch_access(), memory, word_store_bytes(print_store()),
        print_rip(print_at_store(needle, loop_bytes, word, start, length))),
    write_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_write_block()),
        print_rip(print_at_write(needle, loop_bytes, word, start, length))),
    write_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(),
        print_rip(print_at_write_call(needle, loop_bytes, word, start, length))),
    wtest_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_test_block()),
        print_rip(print_at_wtest(needle, loop_bytes, word, start, length))),
    wjs_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpSignNear(pj.sd)),
        print_rip(print_at_wjs(needle, loop_bytes, word, start, length))),
    advance_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_advance_block()),
        print_rip(print_at_advance(needle, loop_bytes, word, start, length))),
    wjz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(pj.zd)),
        print_rip(print_at_wjz(needle, loop_bytes, word, start, length))),
    wjmp_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpNear(pj.bd)),
        print_rip(print_at_wjmp(needle, loop_bytes, word, start, length))),
    wretry_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_retry_block()),
        print_rip(print_at_wfail(needle, loop_bytes, word, start, length))),
    wretry_jz_at: CodeResident(io_fetch_access(), memory, near_control_bytes(JumpZeroNear(pj.rd)),
        print_rip(print_at_wretry(needle, loop_bytes, word, start, length))),
    wfail_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(eof_fail_block()),
        print_rip(print_at_wfail_block(needle, loop_bytes, word, start, length))),
    wfail_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(),
        print_rip(print_at_wfail_call(needle, loop_bytes, word, start, length))),
    exit_at: CodeResident(io_fetch_access(), memory, canonical_block_bytes(print_exit_block()),
        print_rip(print_at_exit(needle, loop_bytes, word, start, length))),
    exit_call_at: CodeResident(io_fetch_access(), memory, linux_syscall_bytes(),
        print_rip(print_at_exit_call(needle, loop_bytes, word, start, length))),
}

theorem read_print_resident(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode,
    pj: PrintJumps,
    resident: CodeResident(io_fetch_access(), memory, print_tail(word, start, length, pj), print_rip(print_at_base(needle, loop_bytes)))):
    ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj) {
    let fetch = io_fetch_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let call = linux_syscall_bytes();
    let b = canonical_block_bytes(print_base_block());
    let w = structured_bytes(word);
    let st = structured_bytes(start);
    let ln = structured_bytes(length);
    let sb = word_store_bytes(print_store());
    let wb = canonical_block_bytes(print_write_block());
    let t = canonical_block_bytes(eof_test_block());
    let js = near_control_bytes(JumpSignNear(pj.sd));
    let adv = canonical_block_bytes(print_advance_block());
    let jz = near_control_bytes(JumpZeroNear(pj.zd));
    let jb = near_control_bytes(JumpNear(pj.bd));
    let rt = canonical_block_bytes(eof_retry_block());
    let rz = near_control_bytes(JumpZeroNear(pj.rd));
    let f = canonical_block_bytes(eof_fail_block());
    let x = canonical_block_bytes(print_exit_block());
    let t8 = rt ++ (rz ++ (f ++ (call ++ (x ++ call))));
    let t7 = t ++ (js ++ (adv ++ (jz ++ (jb ++ t8))));
    let r4 = resident_split_at(fetch, memory, b, w ++ (st ++ (ln ++ (sb ++ (wb ++ (call ++ t7))))), entry, print_at_base(needle, loop_bytes), resident);
    let r5 = resident_split_at(fetch, memory, w, st ++ (ln ++ (sb ++ (wb ++ (call ++ t7)))), entry, print_at_word(needle, loop_bytes), r4.right);
    let r6 = resident_split_at(fetch, memory, st, ln ++ (sb ++ (wb ++ (call ++ t7))), entry, print_at_start(needle, loop_bytes, word), r5.right);
    let r7 = resident_split_at(fetch, memory, ln, sb ++ (wb ++ (call ++ t7)), entry, print_at_length(needle, loop_bytes, word, start), r6.right);
    let r8 = resident_split_at(fetch, memory, sb, wb ++ (call ++ t7), entry, print_at_store(needle, loop_bytes, word, start, length), r7.right);
    let r9 = resident_split_at(fetch, memory, wb, call ++ t7, entry, print_at_write(needle, loop_bytes, word, start, length), r8.right);
    let r10 = resident_split_at(fetch, memory, call, t7, entry, print_at_write_call(needle, loop_bytes, word, start, length), r9.right);
    let r11 = resident_split_at(fetch, memory, t, js ++ (adv ++ (jz ++ (jb ++ t8))), entry, print_at_wtest(needle, loop_bytes, word, start, length), r10.right);
    let r12 = resident_split_at(fetch, memory, js, adv ++ (jz ++ (jb ++ t8)), entry, print_at_wjs(needle, loop_bytes, word, start, length), r11.right);
    let r13 = resident_split_at(fetch, memory, adv, jz ++ (jb ++ t8), entry, print_at_advance(needle, loop_bytes, word, start, length), r12.right);
    let r14 = resident_split_at(fetch, memory, jz, jb ++ t8, entry, print_at_wjz(needle, loop_bytes, word, start, length), r13.right);
    let r15 = resident_split_at(fetch, memory, jb, t8, entry, print_at_wjmp(needle, loop_bytes, word, start, length), r14.right);
    let r16 = resident_split_at(fetch, memory, rt, rz ++ (f ++ (call ++ (x ++ call))), entry, print_at_wfail(needle, loop_bytes, word, start, length), r15.right);
    let r17 = resident_split_at(fetch, memory, rz, f ++ (call ++ (x ++ call)), entry, print_at_wretry(needle, loop_bytes, word, start, length), r16.right);
    let r18 = resident_split_at(fetch, memory, f, call ++ (x ++ call), entry, print_at_wfail_block(needle, loop_bytes, word, start, length), r17.right);
    let r19 = resident_split_at(fetch, memory, call, x ++ call, entry, print_at_wfail_call(needle, loop_bytes, word, start, length), r18.right);
    let r20 = resident_split_at(fetch, memory, x, call, entry, print_at_exit(needle, loop_bytes, word, start, length), r19.right);
    ReadPrintResident(r4.left, r5.left, r6.left, r7.left, r8.left, r9.left, r10.left, r11.left, r12.left, r13.left, r14.left,
        r15.left, r16.left, r17.left, r18.left, r19.left, r20.left, r20.right)
}

// The formatter's certificates, as the producer generates them from
// decimal_line's source functions at the profile's registers, and the
// registers each keeps for what runs after it.
fn PrintWord(word: StructuredCode, keeps: Gpr → Type) → Type {
    (before: MachineState<IoMemory>) → (n: BitVec(64)) → n = read_gpr(R11, before.gprs) →
        StructuredArtifact<IoMemory>(word, before, Rax, line_word(n), keeps)
}
fn PrintStart(start: StructuredCode, keeps: Gpr → Type) → Type {
    (before: MachineState<IoMemory>) → (base, n: BitVec(64)) → base = read_gpr(R8, before.gprs) → n = read_gpr(R11, before.gprs) →
        StructuredArtifact<IoMemory>(start, before, R9, line_start(base, n), keeps)
}
fn PrintLength(length: StructuredCode, keeps: Gpr → Type) → Type {
    (before: MachineState<IoMemory>) → (n: BitVec(64)) → n = read_gpr(R11, before.gprs) →
        StructuredArtifact<IoMemory>(length, before, R10, line_length(n), keeps)
}
record ReadPrintFormat(word, start, length: StructuredCode, word_keeps, start_keeps, length_keeps: Gpr → Type) {
    word_cert: PrintWord(word, word_keeps),
    start_cert: PrintStart(start, start_keeps),
    length_cert: PrintLength(length, length_keeps),
    word_r8: word_keeps(R8), word_r11: word_keeps(R11),
    start_rax: start_keeps(Rax), start_r8: start_keeps(R8), start_r11: start_keeps(R11),
    length_rax: length_keeps(Rax), length_r8: length_keeps(R8), length_r9: length_keeps(R9),
}

// One artifact, fetched where its bytes are resident: the run, its end, and
// that memory is untouched.
theorem artifact_fetched(code: StructuredCode, before: MachineState<IoMemory>, result_register: Gpr, result: BitVec(64),
    keeps: Gpr → Type, artifact: StructuredArtifact<IoMemory>(code, before, result_register, result, keeps),
    resident: CodeResident(io_fetch_access(), before.memory, structured_bytes(code), before.rip)):
    FetchedSteps(io_fetch_access(), io_data_access(), before, artifact.after) {
    j(sym(artifact.execution), λ after _ => FetchedSteps(io_fetch_access(), io_data_access(), before, after),
        structured_fetched(io_fetch_access(), io_data_access(), code, before, artifact.layout, resident).left)
}

theorem page_write_reads(i, skip: Nat):
    bitvec_nat::word_of_nat(64, (0x401000 + skip) + i) = bitvec_nat::word_of_nat(64, io_page_base() + (i + skip)) {
    let base: (io_page_base() = 0x401000) = refl;
    let same: ((0x401000 + skip) + i = io_page_base() + (i + skip)) = omega;
    cong_fn<Nat, BitVec(64)>(λ at => bitvec_nat::word_of_nat(64, at), same)
}

// A byte of the line is within the stored word.
theorem write_room(i, skip, len: Nat, short: i < len, total: len + skip = 5):
    (i + skip < 8) ∧ (i + skip < 4096) { ⟨omega, omega⟩ }

// The formatter has run: the line's word, start and length are in their
// registers, the base still in R8, memory as the read left it.
record PrintFormatted(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode,
    count: Nat, state: MachineState<IoMemory>) {
    memory: state.memory = stored,
    rip: state.rip = print_rip(print_at_store(needle, loop_bytes, word, start, length)),
    base: read_gpr(R8, state.gprs) = BitVec::ofNat(0x401000),
    word_value: read_gpr(Rax, state.gprs) = line_word(bitvec_nat::word_of_nat(64, count)),
    start_value: read_gpr(R9, state.gprs) = line_start(BitVec::ofNat(0x401000), bitvec_nat::word_of_nat(64, count)),
    length_value: read_gpr(R10, state.gprs) = line_length(bitvec_nat::word_of_nat(64, count)),
}

// From the tail, with the count in R13: the base block copies it to R11,
// then the formatter.
theorem print_formats(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    word_keeps, start_keeps, length_keeps: Gpr → Type, format: ReadPrintFormat(word, start, length, word_keeps, start_keeps, length_keeps),
    pieces: ReadPrintResident(stored, needle, loop_bytes, word, start, length, pj), count: Nat, done: MachineState<IoMemory>,
    done_memory: done.memory = stored, done_rip: done.rip = print_rip(print_at_base(needle, loop_bytes)),
    done_count: read_gpr(R13, done.gprs) = bitvec_nat::word_of_nat(64, count)):
    Exists<MachineState<IoMemory>>(λ last => FetchedSteps(io_fetch_access(), io_data_access(), done, last) ∧
        PrintFormatted(stored, needle, loop_bytes, word, start, length, count, last)) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let n = bitvec_nat::word_of_nat(64, count);
    let based = block_fetched(fetch, data, print_base_block(), done, trivial,
        resident_state(fetch, canonical_block_bytes(print_base_block()), stored, print_rip(print_at_base(needle, loop_bytes)), done,
            done_memory, done_rip, pieces.base_at));
    let s0 = execute_block_normal(print_base_block(), done);
    let s0_memory: (s0.memory = stored) = trans(pure_block_memory(print_base_block(), done), done_memory);
    let s0_rip: (s0.rip = print_rip(print_at_word(needle, loop_bytes))) =
        trans(based.right, rip_advance(entry, done.rip, print_at_base(needle, loop_bytes), print_base_len(), done_rip));
    let s0_r11: (read_gpr(R11, s0.gprs) = n) = done_count;
    // The line's word.
    have w = format.word_cert(s0, read_gpr(R11, s0.gprs), refl);
    let w_run = artifact_fetched(word, s0, Rax, line_word(read_gpr(R11, s0.gprs)), word_keeps, w,
        resident_state(fetch, structured_bytes(word), stored, print_rip(print_at_word(needle, loop_bytes)), s0, s0_memory, s0_rip, pieces.word_at));
    let s1 = w.after;
    let s1_memory: (s1.memory = stored) = trans(w.memory_preserved, s0_memory);
    let s1_rip: (s1.rip = print_rip(print_at_start(needle, loop_bytes, word))) =
        trans(w.rip_correct, rip_advance(entry, s0.rip, print_at_word(needle, loop_bytes), structured_bytes(word).len(), s0_rip));
    let s1_r8: (read_gpr(R8, s1.gprs) = BitVec::ofNat(0x401000)) = w.registers_preserved(R8, format.word_r8);
    let s1_r11: (read_gpr(R11, s1.gprs) = n) = trans(w.registers_preserved(R11, format.word_r11), s0_r11);
    let s1_rax: (read_gpr(Rax, s1.gprs) = line_word(n)) =
        trans(w.result_correct, cong_fn<BitVec(64), BitVec(64)>(λ v => line_word(v), s0_r11));
    // Where the line starts.
    have st = format.start_cert(s1, read_gpr(R8, s1.gprs), read_gpr(R11, s1.gprs), refl, refl);
    let st_run = artifact_fetched(start, s1, R9, line_start(read_gpr(R8, s1.gprs), read_gpr(R11, s1.gprs)), start_keeps, st,
        resident_state(fetch, structured_bytes(start), stored, print_rip(print_at_start(needle, loop_bytes, word)), s1, s1_memory, s1_rip, pieces.start_at));
    let s2 = st.after;
    let s2_memory: (s2.memory = stored) = trans(st.memory_preserved, s1_memory);
    let s2_rip: (s2.rip = print_rip(print_at_length(needle, loop_bytes, word, start))) =
        trans(st.rip_correct, rip_advance(entry, s1.rip, print_at_start(needle, loop_bytes, word), structured_bytes(start).len(), s1_rip));
    let s2_r8: (read_gpr(R8, s2.gprs) = BitVec::ofNat(0x401000)) = trans(st.registers_preserved(R8, format.start_r8), s1_r8);
    let s2_r11: (read_gpr(R11, s2.gprs) = n) = trans(st.registers_preserved(R11, format.start_r11), s1_r11);
    let s2_rax: (read_gpr(Rax, s2.gprs) = line_word(n)) = trans(st.registers_preserved(Rax, format.start_rax), s1_rax);
    let s2_r9: (read_gpr(R9, s2.gprs) = line_start(BitVec::ofNat(0x401000), n)) =
        trans(st.result_correct, trans(cong_fn<BitVec(64), BitVec(64)>(λ b => line_start(b, read_gpr(R11, s1.gprs)), s1_r8),
            cong_fn<BitVec(64), BitVec(64)>(λ v => line_start(BitVec::ofNat(0x401000), v), s1_r11)));
    // How long it is.
    have ln = format.length_cert(s2, read_gpr(R11, s2.gprs), refl);
    let ln_run = artifact_fetched(length, s2, R10, line_length(read_gpr(R11, s2.gprs)), length_keeps, ln,
        resident_state(fetch, structured_bytes(length), stored, print_rip(print_at_length(needle, loop_bytes, word, start)), s2, s2_memory, s2_rip, pieces.length_at));
    let s3 = ln.after;
    Exists(s3, ⟨fetched_steps_trans(fetch, data, done, s0, s3, based.left,
            fetched_steps_trans(fetch, data, s0, s1, s3, w_run, fetched_steps_trans(fetch, data, s1, s2, s3, st_run, ln_run))),
        PrintFormatted(
            memory := trans(ln.memory_preserved, s2_memory),
            rip := trans(ln.rip_correct, rip_advance(entry, s2.rip, print_at_length(needle, loop_bytes, word, start), structured_bytes(length).len(), s2_rip)),
            base := trans(ln.registers_preserved(R8, format.length_r8), s2_r8),
            word_value := trans(ln.registers_preserved(Rax, format.length_rax), s2_rax),
            start_value := trans(ln.registers_preserved(R9, format.length_r9), s2_r9),
            length_value := trans(ln.result_correct, cong_fn<BitVec(64), BitVec(64)>(λ v => line_length(v), s2_r11)))⟩)
}

// The write's bytes: the line, read back from the stored word past its
// leading zeros.
theorem print_sends(stored: IoMemory, count: Nat, small: count < 10000, memory: IoMemory,
    memory_is: memory = io_store_offset(stored, 0, word_bytes(line_word(bitvec_nat::word_of_nat(64, count)))),
    buffer: BitVec(64), buffer_is: buffer.toNat() = 0x401000 + line_skip(count)):
    LinuxWritesFrom(io_linux(), memory, buffer, decimal_line(count)) {
    λ i b present => {
        let line = decimal_line(count);
        let skip = line_skip(count);
        let wb = word_bytes(line_word(bitvec_nat::word_of_nat(64, count)));
        let within = line_in_word(count, small);
        let total: (line.len() + skip = 5) = trans(cong_fn<Nat, Nat>(λ l => l + skip, within.right),
            Nat::sub_add_cancel(skip, 5, Nat::le_trans(skip, 3, 5, line_skip_le(count), trivial)));
        let room = write_room(i, skip, line.len(), nth_some_below(line, i, b, present), total);
        let in_word: (wb.nth(i + skip) = Some(b)) =
            j(sym(line_word_bytes(count, small)), λ list _ => list.nth(i + skip) = Some(b), within.left(i, b, present));
        let read: (io_read(io_store_offset(stored, 0, wb), bitvec_nat::word_of_nat(64, io_page_base() + (i + skip))) = Some(b)) =
            io_read_stored(stored, wb, i + skip, b, room.right, in_word);
        j(sym(memory_is), λ current _ => io_read(current, bitvec_nat::word_of_nat(64, buffer.toNat() + i)) = Some(b),
            trans(cong_fn<Nat, Option<BitVec(8)>>(λ at => io_read(io_store_offset(stored, 0, wb), bitvec_nat::word_of_nat(64, at + i)), buffer_is),
                trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ address => io_read(io_store_offset(stored, 0, wb), address), page_write_reads(i, skip)), read)))
    }
}

// ---------------------------------------------------------------------------
// The write loop (docs/native-syscall-failures-design.md §4): write what is
// left, advance past what was sent, and stop when nothing is left; EINTR
// retries, and any other failure exits 1.

// The write loop's arithmetic, kept to Nat.
theorem nothing_below_zero(k: Nat, within: k <= 0): 0 + k = 0 { omega }
theorem count_below_word(n: Nat, fits: n <= 4096): n < Nat::pow(2, 64) { omega }
theorem short_le(a, b: Nat, h: a < b): a <= b { omega }
theorem short_fits(c, n: Nat, short: c < n, fits: n <= 4096): c <= 4096 { omega }
theorem le_by_values(a, b, x, y: Nat, ha: a = x, hb: b = y, h: x <= y): a <= b { omega }
theorem all_sent(r, a, b, n: Nat, hr: r = a -b, ha: a = n, hb: b = n): r = 0 {
    let back: ((a -b) + b = a) = Nat::sub_add_cancel(b, a, { omega });
    omega
}
theorem some_left(r, a, b, x, y: Nat, hr: r = a -b, ha: a = x, hb: b = y, h: y < x): 0 < r {
    let back: ((a -b) + b = a) = Nat::sub_add_cancel(b, a, { omega });
    omega
}
theorem sent_room(a, s, x, n, top: Nat, hs: s = x, h: x <= n, room: a + n < top): a + s < top { omega }
theorem left_after(r, a, b, n, c, d: Nat, hr: r = a -b, ha: a = n, hb: b = c, hd: d + c = n): r = d {
    let back: ((a -b) + b = a) = Nat::sub_add_cancel(b, a, { omega });
    omega
}
theorem moved_place(a, i, c, m: Nat, hm: m = a + c): a + (i + c) = m + i { omega }
theorem rest_some(d, c, n: Nat, h: d + c = n, short: c < n): 0 < d { omega }
theorem rest_fits(d, c, n: Nat, h: d + c = n, fits: n <= 4096): d <= 4096 { omega }
theorem rest_room(m, a, c, d, n, top: Nat, hm: m = a + c, h: d + c = n, room: a + n < top): m + d < top { omega }
theorem line_some(n, skip: Nat, total: n + skip = 5, small: skip <= 3): 0 < n { omega }
theorem line_fits(n, skip: Nat, total: n + skip = 5): n <= 4096 { omega }
theorem line_room(a, n, skip: Nat, at: a = 0x401000 + skip, total: n + skip = 5): a + n < Nat::pow(2, 64) { omega }

theorem drop_nth<A>(xs: List<A>): (k, i: Nat) → xs.drop(k).nth(i) = xs.nth(i + k) {
    match xs as λ ys => (k, i: Nat) → ys.drop(k).nth(i) = ys.nth(i + k) {
        Nil => λ k i => refl,
        Cons(h, t) => λ k i => match k as λ m => Cons(h, t).drop(m).nth(i) = Cons(h, t).nth(i + m) {
            Zero => refl,
            Succ(j) => drop_nth(t, j, i),
        },
    }
}
theorem drop_len<A>(xs: List<A>): (k: Nat) → k <= xs.len() → xs.drop(k).len() + k = xs.len() {
    match xs as λ ys => (k: Nat) → k <= ys.len() → ys.drop(k).len() + k = ys.len() {
        Nil => λ k within => nothing_below_zero(k, within),
        Cons(h, t) => λ k => match k as λ m => m <= Cons(h, t).len() → Cons(h, t).drop(m).len() + m = Cons(h, t).len() {
            Zero => λ _ => refl,
            Succ(j) => λ within => cong_fn<Nat, Nat>(λ n => Succ(n), drop_len(t, j, { let w: (Succ(j) <= Succ(t.len())) = within; omega })),
        },
    }
}

// What the writes return, in order: short counts, and EINTRs that are
// retried; then how the writing ended, with the rest sent whole or at a
// failure other than EINTR.
inductive WriteStep {
    Partial(count: Nat),
    WriteInterrupted,
}
inductive WriteEnding {
    Finished,
    WriteFailedWith(errno: Nat),
}

// The trace of writing `bytes` to stdout: exit 0 once all is sent, exit 1 at
// a failure.
fn write_events(bytes: List<BitVec(8)>, steps: List<WriteStep>, ending: WriteEnding) → List<LinuxEvent> {
    match steps {
        Nil => match ending {
            Finished => [WriteEvent(BitVec::ofNat(1), bytes, Wrote(bytes.len())), ExitEvent(BitVec::ofNat(0))],
            WriteFailedWith(errno) => [WriteEvent(BitVec::ofNat(1), bytes, WriteFailed(errno)), ExitEvent(BitVec::ofNat(1))],
        },
        Cons(step, rest) => match step {
            Partial(count) => Cons(WriteEvent(BitVec::ofNat(1), bytes, Wrote(count)), write_events(bytes.drop(count), rest, ending)),
            WriteInterrupted => Cons(WriteEvent(BitVec::ofNat(1), bytes, WriteFailed(eintr())), write_events(bytes, rest, ending)),
        },
    }
}
// A short write sends less than what is left.
fn WriteSteps(steps: List<WriteStep>) → List<BitVec(8)> → Type {
    match steps {
        Nil => λ _ => True,
        Cons(step, rest) => match step {
            Partial(count) => λ bytes => (count < bytes.len()) ∧ WriteSteps(rest)(bytes.drop(count)),
            WriteInterrupted => λ bytes => WriteSteps(rest)(bytes),
        },
    }
}
fn WriteEndingOk(ending: WriteEnding) → Type {
    match ending { Finished => True, WriteFailedWith(errno) => Errno(errno) ∧ Not(errno = eintr()) }
}

// The loop's head: `bytes` is what is left, readable at R9 and counted in R10.
fn WriteFrom(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode,
    ending: WriteEnding, steps: List<WriteStep>) → Type {
    (bytes: List<BitVec(8)>) → WriteSteps(steps)(bytes) → (state: MachineState<IoMemory>) →
    0 < bytes.len() → bytes.len() <= 4096 →
    state.rip = print_rip(print_at_write(needle, loop_bytes, word, start, length)) → state.memory = memory →
    LinuxWritesFrom(io_linux(), memory, read_gpr(R9, state.gprs), bytes) →
    read_gpr(R10, state.gprs).toNat() = bytes.len() → read_gpr(R9, state.gprs).toNat() + bytes.len() < Nat::pow(2, 64) →
    LinuxRuns(io_linux(), write_events(bytes, steps, ending), state)
}

// Where the write loop's four jumps land.
record PrintTargets(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps) {
    to_fail: near_branch_target(print_rip(print_at_wjs(needle, loop_bytes, word, start, length)), 6, pj.sd) =
        print_rip(print_at_wfail(needle, loop_bytes, word, start, length)),
    to_exit: near_branch_target(print_rip(print_at_wjz(needle, loop_bytes, word, start, length)), 6, pj.zd) =
        print_rip(print_at_exit(needle, loop_bytes, word, start, length)),
    back: near_branch_target(print_rip(print_at_wjmp(needle, loop_bytes, word, start, length)), 5, pj.bd) =
        print_rip(print_at_write(needle, loop_bytes, word, start, length)),
    retry: near_branch_target(print_rip(print_at_wretry(needle, loop_bytes, word, start, length)), 6, pj.rd) =
        print_rip(print_at_write(needle, loop_bytes, word, start, length)),
}

// write(1, R9, R10), asked: the block, then the SYSCALL.
fn WriteAsked(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode,
    state: MachineState<IoMemory>) → Type {
    FetchedSteps(io_fetch_access(), io_data_access(), state, execute_block_normal(print_write_block(), state)) ∧
    ((execute_block_normal(print_write_block(), state).memory = memory) ∧
    ((execute_block_normal(print_write_block(), state).rip = print_rip(print_at_write_call(needle, loop_bytes, word, start, length))) ∧
    LinuxSyscallAt(io_linux(), execute_block_normal(print_write_block(), state))))
}
theorem write_ask(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), state: MachineState<IoMemory>,
    at_write: state.rip = print_rip(print_at_write(needle, loop_bytes, word, start, length)), memory_is: state.memory = memory):
    WriteAsked(memory, needle, loop_bytes, word, start, length, state) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let wrote = block_fetched(fetch, data, print_write_block(), state, trivial,
        resident_state(fetch, canonical_block_bytes(print_write_block()), memory,
            print_rip(print_at_write(needle, loop_bytes, word, start, length)), state, memory_is, at_write, pieces.write_at));
    let asked = execute_block_normal(print_write_block(), state);
    let asked_memory: (asked.memory = memory) = trans(pure_block_memory(print_write_block(), state), memory_is);
    let asked_rip: (asked.rip = print_rip(print_at_write_call(needle, loop_bytes, word, start, length))) =
        trans(wrote.right, rip_advance(entry, state.rip, print_at_write(needle, loop_bytes, word, start, length), print_write_len(), at_write));
    ⟨wrote.left, ⟨asked_memory, ⟨asked_rip, FetchedFrom(resident_readable(fetch, asked.memory, linux_syscall_bytes(), asked.rip,
        resident_state(fetch, linux_syscall_bytes(), memory, print_rip(print_at_write_call(needle, loop_bytes, word, start, length)), asked,
            asked_memory, asked_rip, pieces.write_call_at)))⟩⟩⟩
}

// After a write returned `count`: TEST, JS not taken, the advance. R9 has
// moved past what was sent, R10 counts what is left, and ZF says whether
// anything is.
fn WriteAdvanced(returned: MachineState<IoMemory>, memory: IoMemory, count: Nat, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ moved => FetchedSteps(io_fetch_access(), io_data_access(), returned, moved) ∧
        ((moved.memory = memory) ∧ ((moved.rip = at) ∧
        ((read_gpr(R9, moved.gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count))) ∧
        ((read_gpr(R10, moved.gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count))) ∧
        (moved.flags.zf = is_zero_bits(64, read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)))))))))
}
theorem write_advance(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), count: Nat, fits: count <= 4096,
    returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length)),
    rax: read_gpr(Rax, returned.gprs) = bitvec_nat::word_of_nat(64, count)):
    WriteAdvanced(returned, memory, count, print_rip(print_at_wjz(needle, loop_bytes, word, start, length))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), memory, print_rip(print_at_wtest(needle, loop_bytes, word, start, length)),
            returned, memory_is, rip_is, pieces.wtest_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = memory) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = print_rip(print_at_wjs(needle, loop_bytes, word, start, length))) =
        trans(test.right, rip_advance(entry, returned.rip, print_at_wtest(needle, loop_bytes, word, start, length), eof_test_len(), rip_is));
    let positive = eof_test_count(returned, count, fits, rax);
    let js = near_fetched_step(fetch, data, JumpSignNear(pj.sd), tested,
        resident_state(fetch, near_control_bytes(JumpSignNear(pj.sd)), memory, print_rip(print_at_wjs(needle, loop_bytes, word, start, length)),
            tested, tested_memory, tested_rip, pieces.wjs_at));
    let passed = execute_near_control(JumpSignNear(pj.sd), tested);
    let passed_rip: (passed.rip = print_rip(print_at_advance(needle, loop_bytes, word, start, length))) =
        trans(near_sign_not_taken_rip(pj.sd, tested, positive), rip_advance(entry, tested.rip, print_at_wjs(needle, loop_bytes, word, start, length), 6, tested_rip));
    let advance = block_fetched(fetch, data, print_advance_block(), passed, trivial,
        resident_state(fetch, canonical_block_bytes(print_advance_block()), memory,
            print_rip(print_at_advance(needle, loop_bytes, word, start, length)), passed, tested_memory, passed_rip, pieces.advance_at));
    let moved = execute_block_normal(print_advance_block(), passed);
    let moved_memory: (moved.memory = memory) = trans(pure_block_memory(print_advance_block(), passed), tested_memory);
    let moved_rip: (moved.rip = print_rip(print_at_wjz(needle, loop_bytes, word, start, length))) =
        trans(advance.right, rip_advance(entry, passed.rip, print_at_advance(needle, loop_bytes, word, start, length), print_advance_len(), passed_rip));
    let r9: (read_gpr(R9, moved.gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count))) =
        cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R9, returned.gprs).add(v), rax);
    let r10: (read_gpr(R10, moved.gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count))) =
        cong_fn<BitVec(64), BitVec(64)>(λ v => read_gpr(R10, returned.gprs).sub(v), rax);
    let flag: (moved.flags.zf = is_zero_bits(64, read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)))) =
        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, read_gpr(R10, returned.gprs).sub(v)), rax);
    Exists(moved, ⟨fetched_steps_trans(fetch, data, returned, tested, moved, test.left,
            fetched_steps_trans(fetch, data, tested, passed, moved, fetched_steps_one(fetch, data, tested, passed, js), advance.left)),
        ⟨moved_memory, ⟨moved_rip, ⟨r9, ⟨r10, flag⟩⟩⟩⟩⟩)
}

// All was sent: JZ to exit(0).
theorem write_done(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WriteAdvanced(returned, memory, count, print_rip(print_at_wjz(needle, loop_bytes, word, start, length))),
    none_left: advanced.witness.flags.zf = True):
    LinuxRuns(io_linux(), [ExitEvent(BitVec::ofNat(0))], returned) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let moved = advanced.witness;
    let moved_memory: (moved.memory = memory) = advanced.proof.right.left;
    let moved_rip: (moved.rip = print_rip(print_at_wjz(needle, loop_bytes, word, start, length))) = advanced.proof.right.right.left;
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, print_rip(print_at_wjz(needle, loop_bytes, word, start, length)),
            moved, moved_memory, moved_rip, pieces.wjz_at));
    let going = execute_near_control(JumpZeroNear(pj.zd), moved);
    let going_rip: (going.rip = print_rip(print_at_exit(needle, loop_bytes, word, start, length))) =
        trans(near_taken_rip(pj.zd, moved, none_left),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.zd), moved_rip), targets.to_exit));
    let exited = block_fetched(fetch, data, print_exit_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(print_exit_block()), memory, print_rip(print_at_exit(needle, loop_bytes, word, start, length)),
            going, moved_memory, going_rip, pieces.exit_at));
    let last = execute_block_normal(print_exit_block(), going);
    let last_memory: (last.memory = memory) = trans(pure_block_memory(print_exit_block(), going), moved_memory);
    let last_rip: (last.rip = print_rip(print_at_exit_call(needle, loop_bytes, word, start, length))) =
        trans(exited.right, rip_advance(entry, going.rip, print_at_exit(needle, loop_bytes, word, start, length), print_exit_len(), going_rip));
    let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
        resident_state(fetch, linux_syscall_bytes(), memory, print_rip(print_at_exit_call(needle, loop_bytes, word, start, length)), last,
            last_memory, last_rip, pieces.exit_call_at)));
    linux_runs_exit(io_linux(), returned, last, BitVec::ofNat(0),
        fetched_steps_trans(fetch, data, returned, moved, last, advanced.proof.left,
            fetched_steps_trans(fetch, data, moved, going, last, fetched_steps_one(fetch, data, moved, going, jz), exited.left)),
        call, refl, refl)
}

// Something is left: JZ not taken, JMP back to the write.
fn WriteBack(returned: MachineState<IoMemory>, memory: IoMemory, count: Nat, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ back => FetchedSteps(io_fetch_access(), io_data_access(), returned, back) ∧
        ((back.memory = memory) ∧ ((back.rip = at) ∧
        ((read_gpr(R9, back.gprs) = read_gpr(R9, returned.gprs).add(bitvec_nat::word_of_nat(64, count))) ∧
        (read_gpr(R10, back.gprs) = read_gpr(R10, returned.gprs).sub(bitvec_nat::word_of_nat(64, count)))))))
}
theorem write_more(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    returned: MachineState<IoMemory>, count: Nat,
    advanced: WriteAdvanced(returned, memory, count, print_rip(print_at_wjz(needle, loop_bytes, word, start, length))),
    some_left: advanced.witness.flags.zf = False):
    WriteBack(returned, memory, count, print_rip(print_at_write(needle, loop_bytes, word, start, length))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let moved = advanced.witness;
    let moved_memory: (moved.memory = memory) = advanced.proof.right.left;
    let moved_rip: (moved.rip = print_rip(print_at_wjz(needle, loop_bytes, word, start, length))) = advanced.proof.right.right.left;
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.zd), moved,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.zd)), memory, print_rip(print_at_wjz(needle, loop_bytes, word, start, length)),
            moved, moved_memory, moved_rip, pieces.wjz_at));
    let going = execute_near_control(JumpZeroNear(pj.zd), moved);
    let going_rip: (going.rip = print_rip(print_at_wjmp(needle, loop_bytes, word, start, length))) =
        trans(near_not_taken_rip(pj.zd, moved, some_left), rip_advance(entry, moved.rip, print_at_wjz(needle, loop_bytes, word, start, length), 6, moved_rip));
    let jmp = near_fetched_step(fetch, data, JumpNear(pj.bd), going,
        resident_state(fetch, near_control_bytes(JumpNear(pj.bd)), memory, print_rip(print_at_wjmp(needle, loop_bytes, word, start, length)),
            going, moved_memory, going_rip, pieces.wjmp_at));
    let back = execute_near_control(JumpNear(pj.bd), going);
    let back_rip: (back.rip = print_rip(print_at_write(needle, loop_bytes, word, start, length))) =
        trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, pj.bd), going_rip), targets.back);
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, moved, back, advanced.proof.left,
            fetched_steps_trans(fetch, data, moved, going, back, fetched_steps_one(fetch, data, moved, going, jz),
                fetched_steps_one(fetch, data, going, back, jmp))),
        ⟨moved_memory, ⟨back_rip, ⟨advanced.proof.right.right.right.left, advanced.proof.right.right.right.right.left⟩⟩⟩⟩)
}

// A failed write: TEST, JS taken, the retry test; R9 and R10 untouched.
fn WriteFailedAt(returned: MachineState<IoMemory>, memory: IoMemory, errno: Nat, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ fixed => FetchedSteps(io_fetch_access(), io_data_access(), returned, fixed) ∧
        ((fixed.memory = memory) ∧ ((fixed.rip = at) ∧
        ((fixed.flags.zf = is_zero_bits(64, errno_word(errno).add(BitVec::ofNat(4)))) ∧
        ((read_gpr(R9, fixed.gprs) = read_gpr(R9, returned.gprs)) ∧ (read_gpr(R10, fixed.gprs) = read_gpr(R10, returned.gprs)))))))
}
theorem write_failed(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    errno: Nat, error: Errno(errno), returned: MachineState<IoMemory>, memory_is: returned.memory = memory,
    rip_is: returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length)),
    rax: read_gpr(Rax, returned.gprs) = errno_word(errno)):
    WriteFailedAt(returned, memory, errno, print_rip(print_at_wretry(needle, loop_bytes, word, start, length))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let w = errno_word(errno);
    let test = block_fetched(fetch, data, eof_test_block(), returned, trivial,
        resident_state(fetch, canonical_block_bytes(eof_test_block()), memory, print_rip(print_at_wtest(needle, loop_bytes, word, start, length)),
            returned, memory_is, rip_is, pieces.wtest_at));
    let tested = execute_block_normal(eof_test_block(), returned);
    let tested_memory: (tested.memory = memory) = trans(pure_block_memory(eof_test_block(), returned), memory_is);
    let tested_rip: (tested.rip = print_rip(print_at_wjs(needle, loop_bytes, word, start, length))) =
        trans(test.right, rip_advance(entry, returned.rip, print_at_wtest(needle, loop_bytes, word, start, length), eof_test_len(), rip_is));
    let negative: (tested.flags.sf = True) =
        j(sym(rax), λ v _ => v.band(v).sign_bit() = True, test_self_negative(w, errno_negative(errno, error)));
    let js = near_fetched_step(fetch, data, JumpSignNear(pj.sd), tested,
        resident_state(fetch, near_control_bytes(JumpSignNear(pj.sd)), memory, print_rip(print_at_wjs(needle, loop_bytes, word, start, length)),
            tested, tested_memory, tested_rip, pieces.wjs_at));
    let failing = execute_near_control(JumpSignNear(pj.sd), tested);
    let failing_rip: (failing.rip = print_rip(print_at_wfail(needle, loop_bytes, word, start, length))) =
        trans(near_sign_taken_rip(pj.sd, tested, negative),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.sd), tested_rip), targets.to_fail));
    let retry = block_fetched(fetch, data, eof_retry_block(), failing, trivial,
        resident_state(fetch, canonical_block_bytes(eof_retry_block()), memory, print_rip(print_at_wfail(needle, loop_bytes, word, start, length)),
            failing, tested_memory, failing_rip, pieces.wretry_at));
    let fixed = execute_block_normal(eof_retry_block(), failing);
    let fixed_memory: (fixed.memory = memory) = trans(pure_block_memory(eof_retry_block(), failing), tested_memory);
    let fixed_rip: (fixed.rip = print_rip(print_at_wretry(needle, loop_bytes, word, start, length))) =
        trans(retry.right, rip_advance(entry, failing.rip, print_at_wfail(needle, loop_bytes, word, start, length), eof_retry_len(), failing_rip));
    let flag: (fixed.flags.zf = is_zero_bits(64, w.add(BitVec::ofNat(4)))) =
        cong_fn<BitVec(64), Bool>(λ v => is_zero_bits(64, v.add(BitVec::ofNat(4))), rax);
    Exists(fixed, ⟨fetched_steps_trans(fetch, data, returned, tested, fixed, test.left,
            fetched_steps_trans(fetch, data, tested, failing, fixed, fetched_steps_one(fetch, data, tested, failing, js), retry.left)),
        ⟨fixed_memory, ⟨fixed_rip, ⟨flag, ⟨refl, refl⟩⟩⟩⟩⟩)
}

// Back at the write with R9 and R10 kept: what EINTR's retry reaches.
fn WriteKept(returned: MachineState<IoMemory>, memory: IoMemory, at: BitVec(64)) → Type {
    Exists<MachineState<IoMemory>>(λ back => FetchedSteps(io_fetch_access(), io_data_access(), returned, back) ∧
        ((back.memory = memory) ∧ ((back.rip = at) ∧
        ((read_gpr(R9, back.gprs) = read_gpr(R9, returned.gprs)) ∧ (read_gpr(R10, back.gprs) = read_gpr(R10, returned.gprs))))))
}
theorem write_retry(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    returned: MachineState<IoMemory>,
    failed: WriteFailedAt(returned, memory, eintr(), print_rip(print_at_wretry(needle, loop_bytes, word, start, length)))):
    WriteKept(returned, memory, print_rip(print_at_write(needle, loop_bytes, word, start, length))) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let fixed = failed.witness;
    let set: (fixed.flags.zf = True) = trans(failed.proof.right.right.right.left, eintr_plus_four());
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.rd)), memory, print_rip(print_at_wretry(needle, loop_bytes, word, start, length)),
            fixed, failed.proof.right.left, failed.proof.right.right.left, pieces.wretry_jz_at));
    let back = execute_near_control(JumpZeroNear(pj.rd), fixed);
    let back_rip: (back.rip = print_rip(print_at_write(needle, loop_bytes, word, start, length))) =
        trans(near_taken_rip(pj.rd, fixed, set),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.rd), failed.proof.right.right.left), targets.retry));
    Exists(back, ⟨fetched_steps_trans(fetch, data, returned, fixed, back, failed.proof.left, fetched_steps_one(fetch, data, fixed, back, jz)),
        ⟨failed.proof.right.left, ⟨back_rip, failed.proof.right.right.right.right⟩⟩⟩)
}

theorem write_fail_exit(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj),
    errno: Nat, error: Errno(errno), other: Not(errno = eintr()), returned: MachineState<IoMemory>,
    failed: WriteFailedAt(returned, memory, errno, print_rip(print_at_wretry(needle, loop_bytes, word, start, length)))):
    LinuxRuns(io_linux(), [ExitEvent(BitVec::ofNat(1))], returned) {
    let fetch = io_fetch_access();
    let data = io_data_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let fixed = failed.witness;
    let fixed_memory: (fixed.memory = memory) = failed.proof.right.left;
    let fixed_rip: (fixed.rip = print_rip(print_at_wretry(needle, loop_bytes, word, start, length))) = failed.proof.right.right.left;
    let clear: (fixed.flags.zf = False) = trans(failed.proof.right.right.right.left, other_errno_plus_four(errno, error, other));
    let jz = near_fetched_step(fetch, data, JumpZeroNear(pj.rd), fixed,
        resident_state(fetch, near_control_bytes(JumpZeroNear(pj.rd)), memory, print_rip(print_at_wretry(needle, loop_bytes, word, start, length)),
            fixed, fixed_memory, fixed_rip, pieces.wretry_jz_at));
    let going = execute_near_control(JumpZeroNear(pj.rd), fixed);
    let going_rip: (going.rip = print_rip(print_at_wfail_block(needle, loop_bytes, word, start, length))) =
        trans(near_not_taken_rip(pj.rd, fixed, clear), rip_advance(entry, fixed.rip, print_at_wretry(needle, loop_bytes, word, start, length), 6, fixed_rip));
    let exiting = block_fetched(fetch, data, eof_fail_block(), going, trivial,
        resident_state(fetch, canonical_block_bytes(eof_fail_block()), memory, print_rip(print_at_wfail_block(needle, loop_bytes, word, start, length)),
            going, fixed_memory, going_rip, pieces.wfail_at));
    let last = execute_block_normal(eof_fail_block(), going);
    let last_memory: (last.memory = memory) = trans(pure_block_memory(eof_fail_block(), going), fixed_memory);
    let last_rip: (last.rip = print_rip(print_at_wfail_call(needle, loop_bytes, word, start, length))) =
        trans(exiting.right, rip_advance(entry, going.rip, print_at_wfail_block(needle, loop_bytes, word, start, length), eof_fail_len(), going_rip));
    let call: LinuxSyscallAt(io_linux(), last) = FetchedFrom(resident_readable(fetch, last.memory, linux_syscall_bytes(), last.rip,
        resident_state(fetch, linux_syscall_bytes(), memory, print_rip(print_at_wfail_call(needle, loop_bytes, word, start, length)), last,
            last_memory, last_rip, pieces.wfail_call_at)));
    linux_runs_exit(io_linux(), returned, last, BitVec::ofNat(1),
        fetched_steps_trans(fetch, data, returned, fixed, last, failed.proof.left,
            fetched_steps_trans(fetch, data, fixed, going, last, fetched_steps_one(fetch, data, fixed, going, jz), exiting.left)),
        call, refl, refl)
}

// A word read back as the Nat it counts.
theorem word_is_count(word: BitVec(64), n: Nat, value: word.toNat() = n): word = bitvec_nat::word_of_nat(64, n) {
    trans(sym(bitvec_nat::word_of_nat_toNat(64, word)), cong_fn<Nat, BitVec(64)>(λ m => bitvec_nat::word_of_nat(64, m), value))
}

// The loop, by recursion on the writes: every short write advances, every
// EINTR retries, and the last write sends the rest (exit 0) or fails (exit 1).
theorem write_from(memory: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    pieces: ReadPrintResident(memory, needle, loop_bytes, word, start, length, pj), targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>):
    WriteFrom(memory, needle, loop_bytes, word, start, length, ending, steps) {
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    match steps as λ ss => WriteFrom(memory, needle, loop_bytes, word, start, length, ending, ss) {
        Nil => λ bytes ok state some fits at_write memory_is sends counted room =>
            (match ending as λ en => WriteEndingOk(en) → LinuxRuns(io_linux(), write_events(bytes, Nil, en), state) {
                Finished => λ _ => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = write_ask(memory, needle, loop_bytes, word, start, length, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, [ExitEvent(BitVec::ofNat(0))],
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        bytes.len(), Nat::le_refl(bytes.len()),
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, bytes.len()), rcx, r11);
                            let returned_rip: (returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length))) =
                                rip_advance(entry, asked.rip, print_at_write_call(needle, loop_bytes, word, start, length), 2, w.right.right.left);
                            let advanced = write_advance(memory, needle, loop_bytes, word, start, length, pj, pieces, bytes.len(), fits,
                                returned, w.right.left, returned_rip, refl);
                            let sent = bitvec_nat::word_of_nat(64, bytes.len());
                            let sent_value: (sent.toNat() = bytes.len()) =
                                bitvec_nat::toNat_word_of_nat(64, bytes.len(), count_below_word(bytes.len(), fits));
                            let left: BitVec(64) = read_gpr(R10, state.gprs);
                            let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                                bitvec_nat::toNat_sub(64, left, sent,
                                    le_by_values(sent.toNat(), left.toNat(), bytes.len(), bytes.len(), sent_value, counted, Nat::le_refl(bytes.len())));
                            let nothing: (left.sub(sent).toNat() = 0) =
                                all_sent(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), remaining, counted, sent_value);
                            write_done(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, returned, bytes.len(), advanced,
                                trans(advanced.proof.right.right.right.right.right, zero_bits_of_zero(64, left.sub(sent), nothing)))
                        })
                },
                WriteFailedWith(errno) => λ bad => {
                    let asked = execute_block_normal(print_write_block(), state);
                    let w = write_ask(memory, needle, loop_bytes, word, start, length, pj, pieces, state, at_write, memory_is);
                    let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                        j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                    linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, [ExitEvent(BitVec::ofNat(1))],
                        linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                        errno, bad.left,
                        λ rcx r11 => {
                            let returned = linux_write_return(asked, errno_word(errno), rcx, r11);
                            let returned_rip: (returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length))) =
                                rip_advance(entry, asked.rip, print_at_write_call(needle, loop_bytes, word, start, length), 2, w.right.right.left);
                            write_fail_exit(memory, needle, loop_bytes, word, start, length, pj, pieces, errno, bad.left, bad.right, returned,
                                write_failed(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, errno, bad.left, returned,
                                    w.right.left, returned_rip, refl))
                        })
                },
            })(ending_ok),
        Cons(step, rest) => (match step as λ st => WriteFrom(memory, needle, loop_bytes, word, start, length, ending, Cons(st, rest)) {
            Partial(count) => λ bytes ok state some fits at_write memory_is sends counted room => {
                let short: (count < bytes.len()) = ok.left;
                let asked = execute_block_normal(print_write_block(), state);
                let w = write_ask(memory, needle, loop_bytes, word, start, length, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                linux_runs_write(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events(bytes.drop(count), rest, ending),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    count, short_le(count, bytes.len(), short),
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, bitvec_nat::word_of_nat(64, count), rcx, r11);
                        let returned_rip: (returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length))) =
                            rip_advance(entry, asked.rip, print_at_write_call(needle, loop_bytes, word, start, length), 2, w.right.right.left);
                        let fits_count: (count <= 4096) = short_fits(count, bytes.len(), short, fits);
                        let advanced = write_advance(memory, needle, loop_bytes, word, start, length, pj, pieces, count, fits_count,
                            returned, w.right.left, returned_rip, refl);
                        let sent = bitvec_nat::word_of_nat(64, count);
                        let sent_value: (sent.toNat() = count) = bitvec_nat::toNat_word_of_nat(64, count, count_below_word(count, fits_count));
                        let at: BitVec(64) = read_gpr(R9, state.gprs);
                        let left: BitVec(64) = read_gpr(R10, state.gprs);
                        let remaining: (left.sub(sent).toNat() = left.toNat() -sent.toNat()) =
                            bitvec_nat::toNat_sub(64, left, sent,
                                le_by_values(sent.toNat(), left.toNat(), count, bytes.len(), sent_value, counted, short_le(count, bytes.len(), short)));
                        let back = write_more(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, returned, count, advanced,
                            trans(advanced.proof.right.right.right.right.right, zero_bits_of_pos(64, left.sub(sent),
                                some_left(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, remaining, counted, sent_value, short))));
                        let moved = back.witness;
                        let rest_len: (bytes.drop(count).len() + count = bytes.len()) = drop_len(bytes, count, short_le(count, bytes.len(), short));
                        let moved_at: (read_gpr(R9, moved.gprs).toNat() = at.toNat() + sent.toNat()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.proof.right.right.right.left),
                                bitvec_nat::toNat_add(64, at, sent,
                                    sent_room(at.toNat(), sent.toNat(), count, bytes.len(), Nat::pow(2, 64), sent_value,
                                        short_le(count, bytes.len(), short), room)));
                        let moved_by: (read_gpr(R9, moved.gprs).toNat() = at.toNat() + count) =
                            trans(moved_at, cong_fn<Nat, Nat>(λ c => at.toNat() + c, sent_value));
                        let moved_left: (read_gpr(R10, moved.gprs).toNat() = bytes.drop(count).len()) =
                            trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), back.proof.right.right.right.right),
                                left_after(left.sub(sent).toNat(), left.toNat(), sent.toNat(), bytes.len(), count, bytes.drop(count).len(),
                                    remaining, counted, sent_value, rest_len));
                        let sends_rest: LinuxWritesFrom(io_linux(), memory, read_gpr(R9, moved.gprs), bytes.drop(count)) =
                            λ i b present => {
                                let whole: (bytes.nth(i + count) = Some(b)) = trans(sym(drop_nth(bytes, count, i)), present);
                                let place: (at.toNat() + (i + count) = read_gpr(R9, moved.gprs).toNat() + i) =
                                    moved_place(at.toNat(), i, count, read_gpr(R9, moved.gprs).toNat(), moved_by);
                                j(place, λ n _ => io_linux().data.read(memory, bitvec_nat::word_of_nat(64, n)) = Some(b),
                                    sends(i + count, b, whole))
                            };
                        linux_runs_after_steps(io_linux(), write_events(bytes.drop(count), rest, ending), returned, moved, back.proof.left,
                            write_from(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, ending, ending_ok, rest)(
                                bytes.drop(count), ok.right, moved, rest_some(bytes.drop(count).len(), count, bytes.len(), rest_len, short),
                                rest_fits(bytes.drop(count).len(), count, bytes.len(), rest_len, fits),
                                back.proof.right.right.left, back.proof.right.left, sends_rest, moved_left,
                                rest_room(read_gpr(R9, moved.gprs).toNat(), at.toNat(), count, bytes.drop(count).len(), bytes.len(), Nat::pow(2, 64),
                                    moved_by, rest_len, room)))
                    })
            },
            WriteInterrupted => λ bytes ok state some fits at_write memory_is sends counted room => {
                let asked = execute_block_normal(print_write_block(), state);
                let w = write_ask(memory, needle, loop_bytes, word, start, length, pj, pieces, state, at_write, memory_is);
                let sends_there: LinuxWritesFrom(io_linux(), asked.memory, read_gpr(Rsi, asked.gprs), bytes) =
                    j(sym(w.right.left), λ m _ => LinuxWritesFrom(io_linux(), m, read_gpr(R9, state.gprs), bytes), sends);
                let eintr_errno: Errno(eintr()) = ⟨trivial, trivial⟩;
                linux_runs_write_failed(io_linux(), state, asked, BitVec::ofNat(1), bytes, write_events(bytes, rest, ending),
                    linux_steps_of_fetched(io_linux(), state, asked, w.left), w.right.right.right, refl, refl, counted, sends_there,
                    eintr(), eintr_errno,
                    λ rcx r11 => {
                        let returned = linux_write_return(asked, errno_word(eintr()), rcx, r11);
                        let returned_rip: (returned.rip = print_rip(print_at_wtest(needle, loop_bytes, word, start, length))) =
                            rip_advance(entry, asked.rip, print_at_write_call(needle, loop_bytes, word, start, length), 2, w.right.right.left);
                        let back = write_retry(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, returned,
                            write_failed(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, eintr(), eintr_errno, returned,
                                w.right.left, returned_rip, refl));
                        let kept = back.witness;
                        let same_at: (read_gpr(R9, kept.gprs) = read_gpr(R9, state.gprs)) = back.proof.right.right.right.left;
                        let same_left: (read_gpr(R10, kept.gprs) = read_gpr(R10, state.gprs)) = back.proof.right.right.right.right;
                        linux_runs_after_steps(io_linux(), write_events(bytes, rest, ending), returned, kept, back.proof.left,
                            write_from(memory, needle, loop_bytes, word, start, length, pj, pieces, targets, ending, ending_ok, rest)(
                                bytes, ok, kept, some, fits, back.proof.right.right.left, back.proof.right.left,
                                j(sym(same_at), λ v _ => LinuxWritesFrom(io_linux(), memory, v, bytes), sends),
                                trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), same_left), counted),
                                j(sym(same_at), λ v _ => v.toNat() + bytes.len() < Nat::pow(2, 64), room)))
                    })
            },
        }),
    }
}

// From the formatted state: store the word, then the write loop over the line.
theorem print_writes(stored: IoMemory, needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    count: Nat, small: count < 10000, s3: MachineState<IoMemory>,
    formatted: PrintFormatted(stored, needle, loop_bytes, word, start, length, count, s3),
    pieces: ReadPrintResident(stored, needle, loop_bytes, word, start, length, pj),
    later: ReadPrintResident(io_store_offset(stored, 0, word_bytes(line_word(bitvec_nat::word_of_nat(64, count)))),
        needle, loop_bytes, word, start, length, pj),
    targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>, steps_ok: WriteSteps(steps)(decimal_line(count))):
    LinuxRuns(io_linux(), write_events(decimal_line(count), steps, ending), s3) {
    let fetch = io_fetch_access();
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let n = bitvec_nat::word_of_nat(64, count);
    let line = decimal_line(count);
    let wb = word_bytes(line_word(n));
    let after_store = io_store_offset(stored, 0, wb);
    let writes = linux_writes(io_linux());
    let store_at: CodeResident(fetch, s3.memory, word_store_bytes(print_store()), s3.rip) =
        resident_state(fetch, word_store_bytes(print_store()), stored, print_rip(print_at_store(needle, loop_bytes, word, start, length)),
            s3, formatted.memory, formatted.rip, pieces.store_at);
    let writable: IoWritable(s3.memory, read_gpr(R8, s3.gprs), 8) =
        j(sym(formatted.base), λ address _ => IoWritable(s3.memory, address, 8),
            ⟨Nat::le_refl(io_page_base()), Nat::leb_sound(io_page_base() + 8, io_page_base() + 4096, trivial)⟩);
    let stored_step = store_step(fetch, writes, print_store(), s3, refl,
        FetchedFrom(resident_readable(fetch, s3.memory, word_store_bytes(print_store()), s3.rip, store_at)), writable);
    let s4 = word_store_after(writes, print_store(), s3);
    let s4_memory: (s4.memory = after_store) =
        trans(cong_fn<BitVec(64), IoMemory>(λ address => io_store(s3.memory, address, word_bytes(read_gpr(Rax, s3.gprs))), formatted.base),
            trans(cong_fn<BitVec(64), IoMemory>(λ value => io_store(s3.memory, BitVec::ofNat(0x401000), word_bytes(value)), formatted.word_value),
                cong_fn<IoMemory, IoMemory>(λ memory => io_store(memory, BitVec::ofNat(0x401000), wb), formatted.memory)));
    let s4_rip: (s4.rip = print_rip(print_at_write(needle, loop_bytes, word, start, length))) =
        rip_advance(entry, s3.rip, print_at_store(needle, loop_bytes, word, start, length), 3, formatted.rip);
    let within = line_in_word(count, small);
    let skip = line_skip(count);
    let total: (line.len() + skip = 5) = trans(cong_fn<Nat, Nat>(λ l => l + skip, within.right),
        Nat::sub_add_cancel(skip, 5, Nat::le_trans(skip, 3, 5, line_skip_le(count), trivial)));
    let skip_small: (skip <= 3) = line_skip_le(count);
    let length_value: (read_gpr(R10, s4.gprs).toNat() = line.len()) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), formatted.length_value),
            trans(line_length_value(count, small), sym(within.right)));
    let start_value: (read_gpr(R9, s4.gprs).toNat() = 0x401000 + skip) =
        trans(cong_fn<BitVec(64), Nat>(λ v => v.toNat(), formatted.start_value), line_start_value(count, small));
    linux_runs_after_linux_steps(io_linux(), write_events(line, steps, ending), s3, s4, linux_steps_store(io_linux(), s3, s4, stored_step),
        write_from(after_store, needle, loop_bytes, word, start, length, pj, later, targets, ending, ending_ok, steps)(
            line, steps_ok, s4, line_some(line.len(), skip, total, skip_small), line_fits(line.len(), skip, total), s4_rip, s4_memory,
            print_sends(stored, count, small, after_store, refl, read_gpr(R9, s4.gprs), start_value), length_value,
            line_room(read_gpr(R9, s4.gprs).toNat(), line.len(), skip, start_value, total)))
}

// The tail, from the loop's end with the total in R13: format, store, write
// the line, exit 0 (or exit 1 at a failed write).
theorem eof_print_tail(file: List<BitVec(8)>, needle: BitVec(8), loop_bytes: List<BitVec(8)>,
    word, start, length: StructuredCode, word_keeps, start_keeps, length_keeps: Gpr → Type,
    format: ReadPrintFormat(word, start, length, word_keeps, start_keeps, length_keeps), pj: PrintJumps,
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page), print_tail(word, start, length, pj),
        print_rip(print_at_base(needle, loop_bytes))),
    targets: PrintTargets(needle, loop_bytes, word, start, length, pj),
    total: Nat, small: total < 10000,
    ending: WriteEnding, ending_ok: WriteEndingOk(ending), steps: List<WriteStep>, steps_ok: WriteSteps(steps)(decimal_line(total))):
    EofTail(file, needle, loop_bytes, total, write_events(decimal_line(total), steps, ending)) {
    λ page state at_done memory_is total_word => {
        let stored = IoMemory(file, page);
        let pieces = read_print_resident(stored, needle, loop_bytes, word, start, length, pj, resident(page));
        let formatted = print_formats(stored, needle, loop_bytes, word, start, length, pj, word_keeps, start_keeps, length_keeps, format,
            pieces, total, state, memory_is, at_done, total_word);
        let after_store = io_store_offset(stored, 0, word_bytes(line_word(bitvec_nat::word_of_nat(64, total))));
        linux_runs_after_steps(io_linux(), write_events(decimal_line(total), steps, ending),
            state, formatted.witness, formatted.proof.left,
            print_writes(stored, needle, loop_bytes, word, start, length, pj, total, small, formatted.witness, formatted.proof.right, pieces,
                read_print_resident(after_store, needle, loop_bytes, word, start, length, pj, resident(after_store.page)),
                targets, ending, ending_ok, steps, steps_ok))
    }
}

// ---------------------------------------------------------------------------
// The write loop's targets, from a closed fact about each displacement.

theorem print_fail_sum(g, a: Nat): g + (6 + ((a + 6) + 5)) = (((g + 6) + a) + 6) + 5 { omega }
theorem print_exit_sum(z, r, f: Nat): z + (6 + ((((5 + r) + 6) + f) + 2)) = (((((z + 6) + 5) + r) + 6) + f) + 2 { omega }
theorem print_back_sum(w, l, t, a: Nat): w + (((((l + 2) + t) + 6) + a) + 6) = (((((w + l) + 2) + t) + 6) + a) + 6 { omega }
theorem print_retry_sum(w, l, t, a, r: Nat):
    w + (((((((l + 2) + t) + 6) + a) + 6) + 5) + r) = (((((((w + l) + 2) + t) + 6) + a) + 6) + 5) + r { omega }

// JS skips the advance, JZ and JMP; JZ skips the failure path.
fn print_fail_skip() → Nat { (print_advance_len() + 6) + 5 }
fn print_exit_skip() → Nat { (((5 + eof_retry_len()) + 6) + eof_fail_len()) + 2 }
// From the write to the end of the JMP back, and to the retry's JZ.
fn print_loop_span() → Nat { ((((print_write_len() + 2) + eof_test_len()) + 6) + print_advance_len()) + 6 }
fn print_retry_span() → Nat { (print_loop_span() + 5) + eof_retry_len() }

theorem print_targets(needle: BitVec(8), loop_bytes: List<BitVec(8)>, word, start, length: StructuredCode, pj: PrintJumps,
    fail_reads: pj.sd.sign_extend(32).toNat() = print_fail_skip(),
    exit_reads: pj.zd.sign_extend(32).toNat() = print_exit_skip(),
    back_closes: print_loop_span() + 5 + pj.bd.sign_extend(32).toNat() = Nat::pow(2, 64),
    retry_closes: print_retry_span() + 6 + pj.rd.sign_extend(32).toNat() = Nat::pow(2, 64)):
    PrintTargets(needle, loop_bytes, word, start, length, pj) {
    let entry: BitVec(64) = BitVec::ofNat(0x4000e8);
    let at_w = print_at_write(needle, loop_bytes, word, start, length);
    let at_js = print_at_wjs(needle, loop_bytes, word, start, length);
    let at_jz = print_at_wjz(needle, loop_bytes, word, start, length);
    let fail_lands: (at_js + (6 + print_fail_skip()) = print_at_wfail(needle, loop_bytes, word, start, length)) =
        print_fail_sum(at_js, print_advance_len());
    let exit_lands: (at_jz + (6 + print_exit_skip()) = print_at_exit(needle, loop_bytes, word, start, length)) =
        print_exit_sum(at_jz, eof_retry_len(), eof_fail_len());
    let at_jmp: (print_rip(print_at_wjmp(needle, loop_bytes, word, start, length)) = next_rip(print_rip(at_w), print_loop_span())) =
        trans(rip_count(entry, sym(print_back_sum(at_w, print_write_len(), eof_test_len(), print_advance_len()))),
            sym(rip_compose(entry, at_w, print_loop_span())));
    let at_retry: (print_rip(print_at_wretry(needle, loop_bytes, word, start, length)) = next_rip(print_rip(at_w), print_retry_span())) =
        trans(rip_count(entry, sym(print_retry_sum(at_w, print_write_len(), eof_test_len(), print_advance_len(), eof_retry_len()))),
            sym(rip_compose(entry, at_w, print_retry_span())));
    PrintTargets(
        to_fail := trans(near_branch_forward(print_rip(at_js), 6, print_fail_skip(), pj.sd, fail_reads),
            trans(rip_compose(entry, at_js, 6 + print_fail_skip()), rip_count(entry, fail_lands))),
        to_exit := trans(near_branch_forward(print_rip(at_jz), 6, print_exit_skip(), pj.zd, exit_reads),
            trans(rip_compose(entry, at_jz, 6 + print_exit_skip()), rip_count(entry, exit_lands))),
        back := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 5, pj.bd), at_jmp),
            near_branch_returns(print_rip(at_w), print_loop_span(), 5, pj.bd, back_closes)),
        retry := trans(cong_fn<BitVec(64), BitVec(64)>(λ address => near_branch_target(address, 6, pj.rd), at_retry),
            near_branch_returns(print_rip(at_w), print_retry_span(), 6, pj.rd, retry_closes)))
}

// The process claim: for every way the reads may split the input into
// non-empty chunks, with EINTRs between them, ending at the empty read or at
// a failed read, and every way the writes may return (short counts and
// EINTRs, then the rest or a failure), the file has a run that reads and
// counts the chunks and then either writes the specification's count of their
// concatenation to stdout as a decimal line and exits 0, or exits 1 at the
// failure. The formatter covers counts below 10000, and the input is
// shorter than 2^64 - 4096 bytes, so no count wraps.
theorem read_print_runs(file: List<BitVec(8)>, p: LoopPlacement, at: ReadLoopPlacement(p),
    region: ReadonlyLoop<Nat>, loop_code: AccessCode, loop_bytes: List<BitVec(8)>,
    source: ReadonlyBytes → BitVec(8) → Nat → Nat → Nat → LoopOutcome<Nat>, needle: BitVec(8), spec: List<BitVec(8)> → Nat,
    agreement: (buffer: ReadonlyBytes) → (needle: BitVec(8)) → (budget, cursor, carry: Nat) →
        loop_run(budget, region, buffer, needle, cursor, carry) = source(buffer, needle, budget, cursor, carry),
    native: ReadLoopCertificate(p, region, loop_code, loop_bytes, source),
    computes: ReadEofComputes(region, needle, spec), folds: LoopFolds(region), advance: LoopAdvancesByAtMostOne(region),
    word, start, length: StructuredCode, word_keeps, start_keeps, length_keeps: Gpr → Type,
    format: ReadPrintFormat(word, start, length, word_keeps, start_keeps, length_keeps),
    jumps: EofJumps,
    exit_reads: jumps.ed.sign_extend(32).toNat() = eof_exit_skip(needle, loop_bytes),
    fail_reads: jumps.sd.sign_extend(32).toNat() = eof_fail_skip(needle, loop_bytes),
    back_closes: eof_loop_span(needle, loop_bytes) + 5 + jumps.bd.sign_extend(32).toNat() = Nat::pow(2, 64),
    retry_closes: eof_retry_span(needle, loop_bytes) + 6 + jumps.rd.sign_extend(32).toNat() = Nat::pow(2, 64),
    pj: PrintJumps,
    write_fail_reads: pj.sd.sign_extend(32).toNat() = print_fail_skip(),
    write_exit_reads: pj.zd.sign_extend(32).toNat() = print_exit_skip(),
    write_back_closes: print_loop_span() + 5 + pj.bd.sign_extend(32).toNat() = Nat::pow(2, 64),
    write_retry_closes: print_retry_span() + 6 + pj.rd.sign_extend(32).toNat() = Nat::pow(2, 64),
    resident: (page: Nat → BitVec(8)) → CodeResident(io_fetch_access(), IoMemory(file, page),
        read_print_code(needle, loop_bytes, jumps, word, start, length, pj), BitVec::ofNat(0x4000e8)),
    chunks: List<ReadStep>, ok: EofChunks(chunks), ending: ReadEnding, ending_ok: EofEnding(ending),
    room: eof_input(chunks).len() + 4096 < Nat::pow(2, 64), small: spec(eof_input(chunks)) < 10000,
    writes: List<WriteStep>, writes_ok: WriteSteps(writes)(decimal_line(spec(eof_input(chunks)))),
    written: WriteEnding, written_ok: WriteEndingOk(written),
    page: Nat → BitVec(8), gprs: Gprs, flags: Flags):
    LinuxRuns(io_linux(), eof_events(chunks, ending, write_events(decimal_line(spec(eof_input(chunks))), writes, written)),
        io_initial(file, page, gprs, flags)) {
    let total = spec(eof_input(chunks));
    let tail = print_tail(word, start, length, pj);
    let pieces = λ (page: Nat → BitVec(8)) => eof_pieces(IoMemory(file, page), needle, loop_bytes, jumps, tail, resident(page));
    eof_start(file, p, at, region, loop_code, loop_bytes, source, needle, spec, agreement, native, computes, folds, advance, jumps,
        eof_exit_target(needle, loop_bytes, jumps.ed, exit_reads), eof_js_target(needle, loop_bytes, jumps.sd, fail_reads),
        eof_back_target(needle, loop_bytes, jumps.bd, back_closes), eof_retry_target(needle, loop_bytes, jumps.rd, retry_closes),
        tail, pieces, chunks, ok, ending, ending_ok, room,
        write_events(decimal_line(total), writes, written),
        eof_print_tail(file, needle, loop_bytes, word, start, length, word_keeps, start_keeps, length_keeps, format, pj,
            λ page => pieces(page).tail_at,
            print_targets(needle, loop_bytes, word, start, length, pj, write_fail_reads, write_exit_reads, write_back_closes, write_retry_closes),
            total, small, written, written_ok, writes, writes_ok),
        page, gprs, flags)
}

// ---------------------------------------------------------------------------
// What the trace says was printed.

theorem take_whole<A>(xs: List<A>): xs.take(xs.len()) = xs {
    match xs as λ ys => ys.take(ys.len()) = ys {
        Nil => refl,
        Cons(h, t) => List::cong_cons(h, take_whole(t)),
    }
}

// On a finished write loop, stdout received exactly the bytes.
theorem stdout_is_bytes(steps: List<WriteStep>): (bytes: List<BitVec(8)>) → WriteSteps(steps)(bytes) →
    sent_to(BitVec::ofNat(1), write_events(bytes, steps, Finished)) = bytes {
    match steps as λ ss => (bytes: List<BitVec(8)>) → WriteSteps(ss)(bytes) → sent_to(BitVec::ofNat(1), write_events(bytes, ss, Finished)) = bytes {
        Nil => λ bytes _ => trans(List::append_nil(bytes.take(bytes.len())), take_whole(bytes)),
        Cons(step, rest) => match step as λ st => (bytes: List<BitVec(8)>) → WriteSteps(Cons(st, rest))(bytes) →
                sent_to(BitVec::ofNat(1), write_events(bytes, Cons(st, rest), Finished)) = bytes {
            Partial(count) => λ bytes ok => trans(
                cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => bytes.take(count) ++ tail, stdout_is_bytes(rest, bytes.drop(count), ok.right)),
                bytes.take_append_drop(count)),
            WriteInterrupted => λ bytes ok => stdout_is_bytes(rest, bytes, ok),
        },
    }
}

// Reads send nothing.
theorem reads_send_nothing(steps: List<ReadStep>, tail: List<LinuxEvent>):
    sent_to(BitVec::ofNat(1), eof_events(steps, AtEnd, tail)) = sent_to(BitVec::ofNat(1), tail) {
    match steps as λ ss => sent_to(BitVec::ofNat(1), eof_events(ss, AtEnd, tail)) = sent_to(BitVec::ofNat(1), tail) {
        Nil => refl,
        Cons(step, rest) => match step as λ st => sent_to(BitVec::ofNat(1), eof_events(Cons(st, rest), AtEnd, tail)) = sent_to(BitVec::ofNat(1), tail) {
            Chunk(_) => reads_send_nothing(rest, tail),
            Interrupted => reads_send_nothing(rest, tail),
        },
    }
}

// What stdout receives on a run that ends at the empty read and a finished
// write: exactly the count's line, whatever the reads and writes returned.
theorem prints_the_line(steps: List<ReadStep>, writes: List<WriteStep>, total: Nat, ok: WriteSteps(writes)(decimal_line(total))):
    sent_to(BitVec::ofNat(1), eof_events(steps, AtEnd, write_events(decimal_line(total), writes, Finished))) = decimal_line(total) {
    trans(reads_send_nothing(steps, write_events(decimal_line(total), writes, Finished)), stdout_is_bytes(writes, decimal_line(total), ok))
}

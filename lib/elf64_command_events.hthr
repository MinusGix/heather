// What a command does, as events (docs/native-wc-command-design.md §5): the
// history Linux answers with, and the trace the command makes over it. A
// command is a filter (elf64_read_filter's `FilterShape`) run over each of its
// operands in turn, with a row of counts after each, a total row after two or
// more, and the exit status of what failed. Total functions over plain lists,
// as `command_program`'s are; the process (elf64_command) is proved against
// `command_events`.
import command_program;
import elf64_print_pieces;
import elf64_read_filter;
import elf64_read_pieces;
import elf64_stat_width;
import elf64_write_loop;
import linux_x86_64_io;
import stream_filter;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// The history.

// One write of a row's part: how its write went, step by step.
record RowWrite { steps: List<WriteStep>, ending: WriteEnding }

// One operand: its open (none for `-`), its reads, the three writes of its
// row (the counts and a space, the name, the newline) and its close (none for
// `-`). With no operand, stdin's row is one write, the counts and the
// newline, made with `counts`.
record OperandRun {
    opened: OpenResult,
    steps: List<EofStep<List<WriteStep>>>,
    ending: EofEnd<WriteFailure>,
    counts: RowWrite,
    name: RowWrite,
    newline: RowWrite,
    closed: CloseResult,
}

// The whole run's: the stat pass's answers (none when no stat is made), one
// run per operand (one for stdin when there is none), and the total row's
// write.
record CommandHistory { stats: List<StatResult>, runs: List<OperandRun>, total: RowWrite }

// ---------------------------------------------------------------------------
// The pieces of a row.

fn newline() → BitVec(8) { BitVec::ofNat(10) }
// " total\n", after the totals' counts.
fn total_name() → List<BitVec(8)> {
    [field_gap(), BitVec::ofNat(116), BitVec::ofNat(111), BitVec::ofNat(116), BitVec::ofNat(97), BitVec::ofNat(108), newline()]
}
// The exit status: 1 once anything failed.
fn status_word(failed: Bool) → BitVec(64) { match failed { True => BitVec::ofNat(1), False => BitVec::ofNat(0) } }

// An operand that names stdin: `-` alone (as `stat_target` reads it).
fn names_stdin(operand: List<BitVec(8)>) → Bool {
    match operand {
        Nil => False,
        Cons(first, rest) => match rest { Nil => first.eq_bit(dash()), Cons(_, _) => False },
    }
}

// The counts an input leaves, by column slot: `column(i)` reads slot `i`'s
// count from the state, as the program's columns are laid out.
fn input_counts<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), input: List<BitVec(8)>) → Nat → BitVec(64) {
    λ i => column(i)(filter_state(shape.step, input, shape.init))
}
// The totals: each slot's sum, as GNU's `uintmax_t` sums wrap.
fn add_counts(totals, counts: Nat → BitVec(64)) → Nat → BitVec(64) { λ i => totals(i).add(counts(i)) }
fn no_counts() → Nat → BitVec(64) { λ _ => BitVec::zero() }

fn close_failed(result: CloseResult) → Bool { match result { Closed => False, CloseFailed(_) => True } }

// ---------------------------------------------------------------------------
// The width (coreutils' `get_input_fstatus`): no stat at all for one input
// and one count, so a lone count is not padded. The selection has one count
// when clearing its lowest bit clears it.

fn single_count(mask: BitVec(64)) → Bool { mask.sub(BitVec::ofNat(1)).band(mask).eq_bit(BitVec::zero()) }
fn stats_made(mask: BitVec(64), n: Nat) → Bool { !(Nat::leb(n, 1) && single_count(mask)) }
fn command_width(mask: BitVec(64), n: Nat, stats: List<StatResult>) → Nat {
    match stats_made(mask, n) { True => stat_width(stats.map(stat_seen)), False => 1 }
}

// ---------------------------------------------------------------------------
// The trace.

// A file's row (`rest` is what the operands after it make, from whether
// anything failed and the totals so far): its counts and a space, its name, then the newline, each its
// own write; a failed write exits 1 (`write_events_then`). Then the close,
// when there was an open, and the operands after it, with the counts added
// to the totals.
fn closing(fd: BitVec(64), closes: Bool, closed: CloseResult, failed: Bool, totals: Nat → BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → List<LinuxEvent> {
    match closes {
        False => rest(failed, totals),
        True => Cons(CloseEvent(fd, closed), rest(failed || close_failed(closed), totals)),
    }
}
fn named_row<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun, fd: BitVec(64), closes: Bool, input: List<BitVec(8)>, failed: Bool, totals: Nat → BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → List<LinuxEvent> {
    write_events_then(row_counts(width, mask, input_counts(shape, column, input)) ++ [field_gap()], run.counts.steps, run.counts.ending,
        write_events_then(name, run.name.steps, run.name.ending,
            write_events_then([newline()], run.newline.steps, run.newline.ending,
                closing(fd, closes, run.closed, failed, add_counts(totals, input_counts(shape, column, input)), rest))))
}
// A file's reads, from `fd`: each chunk's output written as the filter
// writes it; at end of file the row, and after a failed read the row of what
// was read before it, with the failure noted.
fn file_reads<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun, fd: BitVec(64), closes: Bool, failed: Bool, totals: Nat → BitVec(64),
    rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → List<LinuxEvent> {
    eof_run(fd, filter_body(shape), filter_failed(shape),
        λ seen _ => named_row(shape, column, mask, width, name, run, fd, closes, seen, True, totals, rest),
        run.steps, run.ending, named_row(shape, column, mask, width, name, run, fd, closes, eof_input(run.steps), failed, totals, rest), Nil)
}
// One operand: `-` reads stdin, with no open and no close; any other is
// opened, and one whose open fails makes no row.
fn file_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>,
    run: OperandRun, failed: Bool, totals: Nat → BitVec(64), rest: Bool → (Nat → BitVec(64)) → List<LinuxEvent>) → List<LinuxEvent> {
    match names_stdin(name) {
        True => file_reads(shape, column, mask, width, name, run, BitVec::zero(), False, failed, totals, rest),
        False => Cons(OpenEvent(name, run.opened), match run.opened {
            Opened(fd) => file_reads(shape, column, mask, width, name, run, word_of_nat(64, fd), True, failed, totals, rest),
            OpenFailed(_) => rest(True, totals),
        }),
    }
}
// After the last operand: with two or more, the totals' row and " total",
// one write; then the exit.
fn total_events(mask: BitVec(64), width, n: Nat, total: RowWrite, failed: Bool, totals: Nat → BitVec(64)) → List<LinuxEvent> {
    match Nat::leb(2, n) {
        True => write_events_then(row_counts(width, mask, totals) ++ total_name(), total.steps, total.ending, [ExitEvent(status_word(failed))]),
        False => [ExitEvent(status_word(failed))],
    }
}
// The operands in order, each with its run.
fn files_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, total: RowWrite,
    operands: List<List<BitVec(8)>>, runs: List<OperandRun>, failed: Bool, totals: Nat → BitVec(64)) → List<LinuxEvent> {
    match operands {
        Nil => total_events(mask, width, n, total, failed, totals),
        Cons(name, more) => match runs {
            Nil => Nil,
            Cons(run, later) => file_events(shape, column, mask, width, name, run, failed, totals,
                λ failed2 totals2 => files_events(shape, column, mask, width, n, total, more, later, failed2, totals2)),
        },
    }
}
// No operand: stdin once, its row unnamed, the counts and the newline in one
// write, then the exit.
fn stdin_row<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, run: OperandRun,
    input: List<BitVec(8)>, failed: Bool) → List<LinuxEvent> {
    write_events_then(row_counts(width, mask, input_counts(shape, column, input)) ++ [newline()], run.counts.steps, run.counts.ending,
        [ExitEvent(status_word(failed))])
}
fn stdin_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, run: OperandRun) → List<LinuxEvent> {
    eof_run(BitVec::zero(), filter_body(shape), filter_failed(shape), λ seen _ => stdin_row(shape, column, mask, width, run, seen, True),
        run.steps, run.ending, stdin_row(shape, column, mask, width, run, eof_input(run.steps), False), Nil)
}
fn inputs_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat,
    operands: List<List<BitVec(8)>>, history: CommandHistory) → List<LinuxEvent> {
    match operands {
        Nil => match history.runs { Nil => Nil, Cons(run, _) => stdin_events(shape, column, mask, width, run) },
        Cons(_, _) => files_events(shape, column, mask, width, operands.len(), history.total, operands, history.runs, False, no_counts()),
    }
}

// The command's trace over `argv`: a refused command line exits 1; otherwise
// the stat pass when one is made, then the inputs.
fn command_events<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), letters: List<BitVec(8)>, default: BitVec(64),
    argv: List<List<BitVec(8)>>, history: CommandHistory) → List<LinuxEvent> {
    match parse_args(letters, default, argv) {
        Refused => [ExitEvent(BitVec::ofNat(1))],
        Scanned(mask, operands) => match stats_made(mask, operands.len()) {
            True => stat_events(stat_targets(operands), history.stats) ++
                inputs_events(shape, column, mask, stat_width(history.stats.map(stat_seen)), operands, history),
            False => inputs_events(shape, column, mask, 1, operands, history),
        },
    }
}

// ---------------------------------------------------------------------------
// The histories Linux can give. Per step, as the filter's: chunks of 1 to
// 4096 bytes, partial writes below what is left, errnos that are errnos. An
// opened name is 1 to 4095 bytes (Linux's PATH_MAX counts the NUL; an empty
// path is ENOENT), and the inputs leave room for their counts.

fn RowWriteOk(bytes: List<BitVec(8)>, write: RowWrite) → Type { WriteSteps(write.steps, bytes) ∧ WriteEndingOk(write.ending) }

fn OpenOk(name: List<BitVec(8)>, opened: OpenResult) → Type {
    OpenReturns(opened) ∧ match opened as λ _ => Type { Opened(_) => (0 < name.len()) ∧ (name.len() < 4096), OpenFailed(_) => True }
}
// A file's reads and row, whatever the totals.
record ReadsOk<C>(shape: FilterShape<C>, run: OperandRun) {
    steps: FilterSteps(shape, run.steps),
    ending: FilterEndingOk(shape, run.steps, run.ending),
    room: FilterRoom(shape.counts, eof_input(run.steps)),
}
record NamedOk<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>, run: OperandRun) {
    reads: ReadsOk<C>(shape, run),
    counts: RowWriteOk(row_counts(width, mask, input_counts(shape, column, eof_input(run.steps))) ++ [field_gap()], run.counts),
    named: RowWriteOk(name, run.name),
    newline: RowWriteOk([newline()], run.newline),
    closed: CloseReturns(run.closed),
}
fn FileOk<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat, name: List<BitVec(8)>, run: OperandRun) → Type {
    match names_stdin(name) {
        True => NamedOk<C>(shape, column, mask, width, name, run),
        False => OpenOk(name, run.opened) ∧ match run.opened as λ _ => Type {
            Opened(_) => NamedOk<C>(shape, column, mask, width, name, run),
            OpenFailed(_) => True,
        },
    }
}
// The totals after an operand: its counts added when it was read.
fn totals_after<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), name: List<BitVec(8)>, run: OperandRun,
    totals: Nat → BitVec(64)) → Nat → BitVec(64) {
    match names_stdin(name) {
        True => add_counts(totals, input_counts(shape, column, eof_input(run.steps))),
        False => match run.opened {
            Opened(_) => add_counts(totals, input_counts(shape, column, eof_input(run.steps))),
            OpenFailed(_) => totals,
        },
    }
}
fn FilesOk<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width, n: Nat, total: RowWrite,
    operands: List<List<BitVec(8)>>) → List<OperandRun> → (Nat → BitVec(64)) → Type {
    match operands {
        Nil => λ runs totals => match runs as λ _ => Type {
            Nil => match Nat::leb(2, n) as λ _ => Type { True => RowWriteOk(row_counts(width, mask, totals) ++ total_name(), total), False => True },
            Cons(_, _) => False,
        },
        Cons(name, more) => λ runs totals => match runs as λ _ => Type {
            Nil => False,
            Cons(run, later) => FileOk(shape, column, mask, width, name, run) ∧
                FilesOk(shape, column, mask, width, n, total, more, later, totals_after(shape, column, name, run, totals)),
        },
    }
}
fn InputsOk<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), mask: BitVec(64), width: Nat,
    operands: List<List<BitVec(8)>>, history: CommandHistory) → Type {
    match operands {
        Nil => match history.runs {
            Nil => False,
            Cons(run, later) => ReadsOk<C>(shape, run) ∧
                (RowWriteOk(row_counts(width, mask, input_counts(shape, column, eof_input(run.steps))) ++ [newline()], run.counts) ∧ (later = Nil)),
        },
        Cons(_, _) => FilesOk(shape, column, mask, width, operands.len(), history.total, operands, history.runs, no_counts()),
    }
}
fn CommandHistoryOk<C>(shape: FilterShape<C>, column: Nat → C → BitVec(64), letters: List<BitVec(8)>, default: BitVec(64),
    argv: List<List<BitVec(8)>>, history: CommandHistory) → Type {
    match parse_args(letters, default, argv) {
        Refused => True,
        Scanned(mask, operands) => match stats_made(mask, operands.len()) {
            True => StatsFit(stat_targets(operands), history.stats) ∧
                InputsOk(shape, column, mask, stat_width(history.stats.map(stat_seen)), operands, history),
            False => InputsOk(shape, column, mask, 1, operands, history),
        },
    }
}

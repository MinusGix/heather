// The read profile's view of its image (docs/native-first-program-design.md
// §5): the RX file at 0x400000, which may fill its 64-KiB window, and the RW
// page just past the window at 0x410000, which holds what stdin supplies
// (docs/native-wc-design.md §8.4). The header is the call profile's with the
// RW page moved (elf64_calls' `io_elf_header`); only the logical view is
// new. It classifies an address by its value rather than its bits, so a fact
// about the page at an open offset is arithmetic, not bit slicing.
import linux_x86_64_io;
import function_ir_loop;
import x86_64;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// What no read and no store to the page changes
// (docs/native-wc-command-design.md §4.2): the file as loaded, the frame page
// at 0x411000 that a command keeps its variables in between operands, and the
// rest of the address space, which the process only reads: the initial stack,
// where argv is (`None` wherever Linux mapped nothing). A read loop's proofs
// fix the image and quantify over the page, so a loop leaves the frame as it
// found it without saying so.
record IoImage { bytes: List<BitVec(8)>, frame: Nat → BitVec(8), rest: BitVec(64) → Option<BitVec(8)> }
record IoMemory { file: IoImage, page: Nat → BitVec(8) }

fn io_page_base() → Nat { 0x410000 }
fn io_frame_base() → Nat { 0x411000 }
// Where the program starts: its first byte, past the 232-byte header.
fn io_entry() → BitVec(64) { BitVec::ofNat(0x4000e8) }

// A page offset, for an address inside the page.
fn io_offset_of(address: Nat) → Option<Nat> {
    match io_page_base().leb(address) {
        False => None,
        True => match Succ(address).leb(io_page_base() + 4096) {
            False => None,
            True => Some(address -io_page_base()),
        },
    }
}
// A frame offset, for an address inside the frame.
fn io_frame_offset(address: Nat) → Option<Nat> {
    match io_frame_base().leb(address) {
        False => None,
        True => match Succ(address).leb(io_frame_base() + 4096) {
            False => None,
            True => Some(address -io_frame_base()),
        },
    }
}
// The file, mapped at 0x400000 in the static profile's 64-KiB window
// (elf64_load's static_elf64_read, by value rather than by bit slices).
fn io_file_offset(address: Nat) → Option<Nat> {
    match 0x400000.leb(address) {
        False => None,
        True => match Succ(address).leb(0x400000 + 65536) { False => None, True => Some(address -0x400000) },
    }
}
fn io_file_read(file: List<BitVec(8)>, address: BitVec(64)) → Option<BitVec(8)> {
    match io_file_offset(address.toNat()) { None => None, Some(offset) => file.nth(offset) }
}
// Outside the page: the file's window, then the frame, then the rest.
fn io_image_read(image: IoImage, address: BitVec(64)) → Option<BitVec(8)> {
    match io_file_offset(address.toNat()) {
        None => match io_frame_offset(address.toNat()) { Some(offset) => Some(image.frame(offset)), None => image.rest(address) },
        Some(offset) => image.bytes.nth(offset),
    }
}
fn io_read(memory: IoMemory, address: BitVec(64)) → Option<BitVec(8)> {
    match io_offset_of(address.toNat()) {
        Some(offset) => Some(memory.page(offset)),
        None => io_image_read(memory.file, address),
    }
}
fn io_store_offset(memory: IoMemory, start: Nat, bytes: List<BitVec(8)>) → IoMemory {
    IoMemory(memory.file, λ offset => match start.leb(offset) {
        False => memory.page(offset),
        True => match bytes.nth(offset -start) { None => memory.page(offset), Some(byte) => byte },
    })
}
fn io_frame_store_offset(image: IoImage, start: Nat, bytes: List<BitVec(8)>) → IoImage {
    IoImage(image.bytes, λ offset => match start.leb(offset) {
        False => image.frame(offset),
        True => match bytes.nth(offset -start) { None => image.frame(offset), Some(byte) => byte },
    }, image.rest)
}
// A store lands in the frame when it starts there, else in the page; a
// writable span (`IoWritable`) never crosses from one into the other.
fn io_store(memory: IoMemory, address: BitVec(64), bytes: List<BitVec(8)>) → IoMemory {
    match io_frame_offset(address.toNat()) {
        Some(start) => IoMemory(io_frame_store_offset(memory.file, start, bytes), memory.page),
        None => io_store_offset(memory, address.toNat() -io_page_base(), bytes),
    }
}
fn IoPageWritable(address: BitVec(64), length: Nat) → Type {
    (io_page_base() <= address.toNat()) ∧ (address.toNat() + length <= io_page_base() + 4096)
}
fn IoFrameWritable(address: BitVec(64), length: Nat) → Type {
    (io_frame_base() <= address.toNat()) ∧ (address.toNat() + length <= io_frame_base() + 4096)
}
fn IoWritable(memory: IoMemory, address: BitVec(64), length: Nat) → Type {
    IoPageWritable(address, length) ∨ IoFrameWritable(address, length)
}

// Code comes only from the file: the page, the frame and the rest are not
// executable.
fn io_fetch_access() → FetchAccess<IoMemory> {
    FetchAccess(io_read, λ memory address => match io_file_read(memory.file.bytes, address) { None => False, Some(_) => True })
}
fn io_data_access() → ByteReadAccess<IoMemory> { ByteReadAccess(io_read) }
fn io_linux() → LinuxIo<IoMemory> {
    LinuxIo(io_fetch_access(), io_data_access(), IoWritable, io_store)
}

// The process at its entry: the file as loaded, anything at all in the page,
// registers and flags arbitrary.
fn io_initial(file: IoImage, page: Nat → BitVec(8), gprs: Gprs, flags: Flags) → MachineState<IoMemory> {
    MachineState(gprs, flags, io_entry(), IoMemory(file, page))
}

theorem io_offset_in_page(i: Nat, inside: i < 4096): io_offset_of(io_page_base() + i) = Some(i) {
    let low = eq_true_of_is_true(io_page_base().leb(io_page_base() + i),
        Nat::leb_complete(io_page_base(), io_page_base() + i, Nat::le_add_l(io_page_base(), i)));
    let fits: (Succ(io_page_base() + i) <= io_page_base() + 4096) = omega;
    let high = eq_true_of_is_true(Succ(io_page_base() + i).leb(io_page_base() + 4096),
        Nat::leb_complete(Succ(io_page_base() + i), io_page_base() + 4096, fits));
    let offset: ((io_page_base() + i) -io_page_base() = i) =
        trans(cong_fn<Nat, Nat>(λ a => a -io_page_base(), Nat::add_comm(io_page_base(), i)), Nat::add_sub_cancel(i, io_page_base()));
    j(sym(low), λ below _ => (match below {
            False => None,
            True => match Succ(io_page_base() + i).leb(io_page_base() + 4096) {
                False => None,
                True => Some((io_page_base() + i) -io_page_base()),
            },
        }) = Some(i),
        j(sym(high), λ above _ => (match above { False => None, True => Some((io_page_base() + i) -io_page_base()) }) = Some(i),
            cong_fn<Nat, Option<Nat>>(λ k => Some(k), offset)))
}

// What a read stored at the page's start reads back at an open offset.
theorem io_read_stored(memory: IoMemory, bytes: List<BitVec(8)>, i: Nat, byte: BitVec(8),
    inside: i < 4096, present: bytes.nth(i) = Some(byte)):
    io_read(io_store_offset(memory, 0, bytes), bitvec_nat::word_of_nat(64, io_page_base() + i)) = Some(byte) {
    let below: (Succ(io_page_base() + i) <= io_page_base() + 4096) = omega;
    let closed: (io_page_base() + 4096 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 64), trivial);
    let bound: (io_page_base() + i < Nat::pow(2, 64)) =
        Succ(io_page_base() + i).le_trans(io_page_base() + 4096, Nat::pow(2, 64), below, closed);
    let value = bitvec_nat::toNat_word_of_nat(64, io_page_base() + i, bound);
    let offset = trans(cong_fn<Nat, Option<Nat>>(λ a => io_offset_of(a), value), io_offset_in_page(i, inside));
    let stored = io_store_offset(memory, 0, bytes);
    j(sym(offset), λ found _ => (match found {
            Some(k) => Some(stored.page(k)),
            None => io_image_read(stored.file, bitvec_nat::word_of_nat(64, io_page_base() + i)),
        }) = Some(byte),
        cong_fn<BitVec(8), Option<BitVec(8)>>(λ b => Some(b),
            j(sym(trans(cong_fn<Nat, Option<BitVec(8)>>(λ k => bytes.nth(k), Nat::sub_zero(i)), present)),
                λ found _ => (match found { None => memory.page(i), Some(b) => b }) = byte, refl)))
}

// The loop's buffer is the memory's own read view (LoopHead.memory_agrees
// holds at every address), with the page's first `length` bytes as its region.
fn io_buffer(memory: IoMemory, length: Nat) → ReadonlyBytes {
    ReadonlyBytes(source := 0, base := io_page_base(), length := length,
        read := λ address => io_read(memory, bitvec_nat::word_of_nat(64, address)))
}
theorem io_buffer_agrees(memory: IoMemory, length: Nat, word: BitVec(64)):
    io_data_access().read(memory, word) = io_buffer(memory, length).read(word.toNat()) {
    cong_fn<BitVec(64), Option<BitVec(8)>>(λ address => io_read(memory, address), sym(bitvec_nat::word_of_nat_toNat(64, word)))
}
theorem io_buffer_reads(memory: IoMemory, bytes: List<BitVec(8)>, length, i: Nat, byte: BitVec(8),
    inside: i < 4096, present: bytes.nth(i) = Some(byte)):
    io_buffer(io_store_offset(memory, 0, bytes), length).read(io_page_base() + i) = Some(byte) {
    io_read_stored(memory, bytes, i, byte, inside, present)
}

theorem io_leb_false(a, b: Nat, below: b < a): a.leb(b) = False {
    (match a.leb(b) as λ found => (a.leb(b) = found) → found = False {
        False => λ _ => refl,
        True => λ found => false_elim(Nat::lt_irrefl(b, Nat::le_trans(Succ(b), a, b, below,
            Nat::leb_sound(a, b, j(sym(found), λ decided _ => decided.IsTrue(), trivial))))),
    })(refl)
}

// ---------------------------------------------------------------------------
// What the page holds (docs/native-architecture-review.md R7): the one kit
// for a program that stores bytes and writes them. A store holds what it
// stored and leaves the rest of the page; runs held side by side are one
// run; part of a run is a run; and a run the page holds is what a write from
// it sends.

theorem nth_some_below<A>(xs: List<A>, i: Nat, x: A, present: xs.nth(i) = Some(x)): i < xs.len() {
    Nat::lt_of_not_le(i, xs.len(), λ past => absurd(trans(sym(present), xs.nth_past_end(i, past))))
}
theorem nth_append_below<A>(xs, ys: List<A>): (i: Nat) → i < xs.len() → (xs ++ ys).nth(i) = xs.nth(i) {
    match xs as λ zs => (i: Nat) → i < zs.len() → (zs ++ ys).nth(i) = zs.nth(i) {
        Nil => λ i short => false_elim(short),
        Cons(h, t) => λ i => match i as λ k => k < Succ(t.len()) → (Cons(h, t) ++ ys).nth(k) = Cons(h, t).nth(k) {
            Zero => λ _ => refl,
            Succ(k) => λ short => nth_append_below(t, ys, k, short),
        },
    }
}

// The page holds `bytes` from `offset`. (Indexed `i + offset`, so a run
// from the page's start is `page(i)` itself.)
fn Stored(page: Nat → BitVec(8), offset: Nat, bytes: List<BitVec(8)>) → Type {
    (i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → page(i + offset) = byte
}

// The page read at an address in it.
theorem io_read_page(file: IoImage, page: Nat → BitVec(8), address: BitVec(64), i: Nat, inside: i < 4096,
    at: address.toNat() = io_page_base() + i): io_read(IoMemory(file, page), address) = Some(page(i)) {
    j(sym(trans(cong_fn<Nat, Option<Nat>>(λ a => io_offset_of(a), at), io_offset_in_page(i, inside))),
        λ found _ => (match found {
            Some(k) => Some(page(k)),
            None => io_image_read(file, address),
        }) = Some(page(i)), refl)
}

// A store at the page's `i`-th byte is a store at offset `i`.
// An address below the frame is not in it.
theorem io_frame_offset_below(a: Nat, below: a < io_frame_base()): io_frame_offset(a) = None {
    j(sym(io_leb_false(io_frame_base(), a, below)), λ b _ => (match b as λ _ => Option<Nat> {
            False => None,
            True => match Succ(a).leb(io_frame_base() + 4096) { False => None, True => Some(a -io_frame_base()) },
        }) = None, refl)
}
theorem store_at_offset(memory: IoMemory, address: BitVec(64), i: Nat, bytes: List<BitVec(8)>, inside: i < 4096,
    at: address.toNat() = io_page_base() + i): io_store(memory, address, bytes) = io_store_offset(memory, i, bytes) {
    let none: (io_frame_offset(address.toNat()) = None) =
        trans(cong_fn<Nat, Option<Nat>>(λ a => io_frame_offset(a), at), io_frame_offset_below(io_page_base() + i, { omega }));
    trans(j(none, λ found _ => io_store(memory, address, bytes) = (match found {
                Some(start) => IoMemory(io_frame_store_offset(memory.file, start, bytes), memory.page),
                None => io_store_offset(memory, address.toNat() -io_page_base(), bytes),
            }), refl),
        cong_fn<Nat, IoMemory>(λ offset => io_store_offset(memory, offset, bytes),
            trans(cong_fn<Nat, Nat>(λ a => a -io_page_base(), at),
                trans(cong_fn<Nat, Nat>(λ a => a -io_page_base(), Nat::add_comm(io_page_base(), i)), Nat::add_sub_cancel(i, io_page_base())))))
}
theorem page_address(offset: Nat, room: offset + 8 <= 4096): BitVec::ofNat(0x410000 + offset, n := 64).toNat() = 0x410000 + offset {
    BitVec::toNat_ofNat(64, 0x410000 + offset, { omega })
}
theorem page_writable(memory: IoMemory, offset: Nat, room: offset + 8 <= 4096): IoWritable(memory, BitVec::ofNat(0x410000 + offset), 8) {
    let value = page_address(offset, room);
    Inl(⟨j(sym(value), λ a _ => io_page_base() <= a, { omega }), j(sym(value), λ a _ => a + 8 <= io_page_base() + 4096, { omega })⟩)
}

// A store holds what it stored ...
theorem store_reads(memory: IoMemory, offset, j: Nat, bytes: List<BitVec(8)>, byte: BitVec(8), present: bytes.nth(j) = Some(byte)):
    io_store_offset(memory, offset, bytes).page(offset + j) = byte {
    let reached = eq_true_of_is_true(offset.leb(offset + j), Nat::leb_complete(offset, offset + j, Nat::le_add_l(offset, j)));
    let back: ((offset + j) -offset = j) = trans(cong_fn<Nat, Nat>(λ a => a -offset, Nat::add_comm(offset, j)), Nat::add_sub_cancel(j, offset));
    let found: (bytes.nth((offset + j) -offset) = Some(byte)) = trans(cong_fn<Nat, Option<BitVec(8)>>(λ k => bytes.nth(k), back), present);
    j(sym(reached), λ b _ => (match b {
            False => memory.page(offset + j),
            True => match bytes.nth((offset + j) -offset) { None => memory.page(offset + j), Some(byte) => byte },
        }) = byte,
        j(sym(found), λ o _ => (match o { None => memory.page(offset + j), Some(byte) => byte }) = byte, refl))
}
theorem stored_store(memory: IoMemory, offset: Nat, bytes: List<BitVec(8)>): Stored(io_store_offset(memory, offset, bytes).page, offset, bytes) {
    λ i byte present => j(Nat::add_comm(offset, i), λ at _ => io_store_offset(memory, offset, bytes).page(at) = byte,
        store_reads(memory, offset, i, bytes, byte, present))
}
theorem store_byte_here(memory: IoMemory, i: Nat, x: BitVec(8)): io_store_offset(memory, i, [x]).page(i) = x {
    let reached = eq_true_of_is_true(i.leb(i), Nat::leb_complete(i, i, i.le_refl()));
    j(sym(reached), λ c _ => (match c {
            False => memory.page(i),
            True => match List::nth<BitVec(8)>([x], i -i) { None => memory.page(i), Some(byte) => byte },
        }) = x,
        j(sym(Nat::sub_self(i)), λ d _ => (match List::nth<BitVec(8)>([x], d) { None => memory.page(i), Some(byte) => byte }) = x, refl))
}

// ... and leaves the rest of the page.
theorem store_below(memory: IoMemory, start: Nat, bytes: List<BitVec(8)>, k: Nat, below: k < start):
    io_store_offset(memory, start, bytes).page(k) = memory.page(k) {
    j(sym(io_leb_false(start, k, below)), λ b _ => (match b {
            False => memory.page(k),
            True => match bytes.nth(k -start) { None => memory.page(k), Some(x) => x },
        }) = memory.page(k), refl)
}
theorem store_byte_other(memory: IoMemory, i: Nat, x: BitVec(8), k: Nat, other: Not(k = i)):
    io_store_offset(memory, i, [x]).page(k) = memory.page(k) {
    (match i.leb(k) as λ c => (i.leb(k) = c) → (match c {
            False => memory.page(k),
            True => match List::nth<BitVec(8)>([x], k -i) { None => memory.page(k), Some(byte) => byte },
        }) = memory.page(k) {
        False => λ _ => refl,
        True => λ below => {
            let le: (i <= k) = Nat::leb_sound(i, k, j(sym(below), λ c _ => c.IsTrue(), trivial));
            (match k -i as λ d => (k -i = d) → (match List::nth<BitVec(8)>([x], d) { None => memory.page(k), Some(byte) => byte }) = memory.page(k) {
                Zero => λ none => {
                    let back: ((k -i) + i = k) = Nat::sub_add_cancel(i, k, le);
                    false_elim(other({ omega }))
                },
                Succ(_) => λ _ => refl,
            })(refl)
        },
    })(refl)
}
theorem stored_kept(memory: IoMemory, start: Nat, stores, bytes: List<BitVec(8)>, offset: Nat, below: offset + bytes.len() <= start,
    held: Stored(memory.page, offset, bytes)): Stored(io_store_offset(memory, start, stores).page, offset, bytes) {
    λ i byte present => {
        let inside: (i < bytes.len()) = nth_some_below(bytes, i, byte, present);
        let under: (i + offset < start) = omega;
        trans(store_below(memory, start, stores, i + offset, under), held(i, byte, present))
    }
}

// Two runs, one after the other, are one.
theorem stored_join(page: Nat → BitVec(8), offset: Nat, front, back: List<BitVec(8)>, first: Stored(page, offset, front),
    second: Stored(page, offset + front.len(), back)): Stored(page, offset, front ++ back) {
    λ i byte present => match Nat::le_dec(front.len(), i) {
        Inl(past) => {
            let back_at: ((i -front.len()) + front.len() = i) = Nat::sub_add_cancel(front.len(), i, past);
            let found: (back.nth(i -front.len()) = Some(byte)) =
                trans(sym(front.nth_append_r(back, i -front.len())), j(sym(back_at), λ k _ => (front ++ back).nth(k) = Some(byte), present));
            let place: ((i -front.len()) + (offset + front.len()) = i + offset) = omega;
            j(place, λ at _ => page(at) = byte, second(i -front.len(), byte, found))
        },
        Inr(short) => first(i, byte, trans(sym(nth_append_below(front, back, i, { omega })), present)),
    }
}

// Part of a run is a run: `part` is `whole` from `skip`, so it is held from
// `to`, `skip` past the run's start.
theorem stored_part(page: Nat → BitVec(8), offset: Nat, whole, part: List<BitVec(8)>, skip, to: Nat, at: offset + skip = to,
    agree: (i: Nat) → (byte: BitVec(8)) → part.nth(i) = Some(byte) → whole.nth(i + skip) = Some(byte),
    held: Stored(page, offset, whole)): Stored(page, to, part) {
    λ i byte present => {
        let place: ((i + skip) + offset = i + to) = omega;
        j(place, λ k _ => page(k) = byte, held(i + skip, byte, agree(i, byte, present)))
    }
}

// A run the page holds is what a write from its first byte sends.
theorem stored_sends(memory: IoMemory, offset: Nat, bytes: List<BitVec(8)>, held: Stored(memory.page, offset, bytes),
    buffer: BitVec(64), at: buffer.toNat() = io_page_base() + offset, fits: offset + bytes.len() <= 4096):
    LinuxWritesFrom(io_linux(), memory, buffer, bytes) {
    λ i byte present => {
        let below = nth_some_below(bytes, i, byte, present);
        let inside: (i + offset < 4096) = omega;
        let place: (buffer.toNat() + i = io_page_base() + (i + offset)) = omega;
        let page: (io_page_base() + 4096 <= Nat::pow(2, 64)) = Nat::leb_sound(io_page_base() + 4096, Nat::pow(2, 64), trivial);
        let bound: (io_page_base() + (i + offset) < Nat::pow(2, 64)) = omega;
        let value: (bitvec_nat::word_of_nat(64, buffer.toNat() + i).toNat() = io_page_base() + (i + offset)) =
            j(sym(place), λ a _ => bitvec_nat::word_of_nat(64, a).toNat() = io_page_base() + (i + offset),
                bitvec_nat::toNat_word_of_nat(64, io_page_base() + (i + offset), bound));
        let found = trans(cong_fn<Nat, Option<Nat>>(λ a => io_offset_of(a), value), io_offset_in_page(i + offset, inside));
        let read: (io_read(memory, bitvec_nat::word_of_nat(64, buffer.toNat() + i)) = Some(memory.page(i + offset))) =
            j(sym(found), λ o _ => (match o {
                    Some(k) => Some(memory.page(k)),
                    None => io_image_read(memory.file, bitvec_nat::word_of_nat(64, buffer.toNat() + i)),
                }) = Some(memory.page(i + offset)), refl);
        trans(read, cong_fn<BitVec(8), Option<BitVec(8)>>(λ b => Some(b), held(i, byte, present)))
    }
}

theorem io_file_offset_at(k: Nat, inside: k < 65536): io_file_offset(0x400000 + k) = Some(k) {
    let low = eq_true_of_is_true(Nat::leb(0x400000, 0x400000 + k), Nat::leb_complete(0x400000, 0x400000 + k, Nat::le_add_l(0x400000, k)));
    let fits: (Succ(0x400000 + k) <= 0x400000 + 65536) = omega;
    let high = eq_true_of_is_true(Succ(0x400000 + k).leb(0x400000 + 65536), Nat::leb_complete(Succ(0x400000 + k), 0x400000 + 65536, fits));
    let offset: ((0x400000 + k) -0x400000 = k) =
        trans(cong_fn<Nat, Nat>(λ a => a -0x400000, Nat::add_comm(0x400000, k)), Nat::add_sub_cancel(k, 0x400000));
    j(sym(low), λ below _ => (match below {
            False => None,
            True => match Succ(0x400000 + k).leb(0x400000 + 65536) { False => None, True => Some((0x400000 + k) -0x400000) },
        }) = Some(k),
        j(sym(high), λ above _ => (match above { False => None, True => Some((0x400000 + k) -0x400000) }) = Some(k),
            cong_fn<Nat, Option<Nat>>(λ n => Some(n), offset)))
}

theorem io_code_bound(k: Nat, inside: k < 65536): 0x400000 + k < Nat::pow(2, 64) {
    let below: (Succ(0x400000 + k) <= 0x400000 + 65536) = omega;
    Succ(0x400000 + k).le_trans(0x400000 + 65536, Nat::pow(2, 64), below, Nat::leb_sound(0x400000 + 65536, Nat::pow(2, 64), trivial))
}

theorem io_file_read_at(file: List<BitVec(8)>, k: Nat, byte: BitVec(8), inside: k < 65536, present: file.nth(k) = Some(byte)):
    io_file_read(file, bitvec_nat::word_of_nat(64, 0x400000 + k)) = Some(byte) {
    let value = bitvec_nat::toNat_word_of_nat(64, 0x400000 + k, io_code_bound(k, inside));
    let file_offset = trans(cong_fn<Nat, Option<Nat>>(λ a => io_file_offset(a), value), io_file_offset_at(k, inside));
    j(sym(file_offset), λ found _ => (match found as λ _ => Option<BitVec(8)> { None => None, Some(offset) => file.nth(offset) }) = Some(byte), present)
}

// The image's file bytes, read through the image at their address.
theorem io_image_read_at(file: IoImage, k: Nat, byte: BitVec(8), inside: k < 65536, present: file.bytes.nth(k) = Some(byte)):
    io_image_read(file, bitvec_nat::word_of_nat(64, 0x400000 + k)) = Some(byte) {
    let w = bitvec_nat::word_of_nat(64, 0x400000 + k);
    let value = bitvec_nat::toNat_word_of_nat(64, 0x400000 + k, io_code_bound(k, inside));
    let file_offset = trans(cong_fn<Nat, Option<Nat>>(λ a => io_file_offset(a), value), io_file_offset_at(k, inside));
    j(sym(file_offset), λ found _ => (match found {
            None => match io_frame_offset(w.toNat()) { Some(offset) => Some(file.frame(offset)), None => file.rest(w) },
            Some(offset) => file.bytes.nth(offset),
        }) = Some(byte), present)
}

// A byte of the file reads back, whatever the page holds.
theorem io_read_file(file: IoImage, page: Nat → BitVec(8), k: Nat, byte: BitVec(8), inside: k < 65536,
    present: file.bytes.nth(k) = Some(byte)):
    io_read(IoMemory(file, page), bitvec_nat::word_of_nat(64, 0x400000 + k)) = Some(byte) {
    let below: (Succ(0x400000 + k) <= 0x400000 + 65536) = omega;
    let value = bitvec_nat::toNat_word_of_nat(64, 0x400000 + k, io_code_bound(k, inside));
    let outside = io_leb_false(io_page_base(), 0x400000 + k, below);
    let page_offset: (io_offset_of(bitvec_nat::word_of_nat(64, 0x400000 + k).toNat()) = None) =
        trans(cong_fn<Nat, Option<Nat>>(λ a => io_offset_of(a), value),
            j(sym(outside), λ decided _ => (match decided as λ _ => Option<Nat> {
                False => None,
                True => match Succ(0x400000 + k).leb(io_page_base() + 4096) { False => None, True => Some((0x400000 + k) -io_page_base()) },
            }) = None, refl));
    j(sym(page_offset), λ found _ => (match found {
            Some(offset) => Some(page(offset)),
            None => io_image_read(file, bitvec_nat::word_of_nat(64, 0x400000 + k)),
        }) = Some(byte),
        io_image_read_at(file, k, byte, inside, present))
}

theorem io_no_carry(k: Nat, inside: k < 65536):
    bitvec_nat::word_of_nat(64, 0x400000 + k).carry_add_bit(BitVec::ofNat(1)) = False {
    let word = bitvec_nat::word_of_nat(64, 0x400000 + k);
    let below: (Succ(0x400000 + k) <= 0x400000 + 65536) = omega;
    let bound: (0x400000 + k < Nat::pow(2, 64)) =
        Succ(0x400000 + k).le_trans(0x400000 + 65536, Nat::pow(2, 64), below, Nat::leb_sound(0x400000 + 65536, Nat::pow(2, 64), trivial));
    let value = bitvec_nat::toNat_word_of_nat(64, 0x400000 + k, bound);
    let room: (Succ(0x400000 + k) + 1 <= 0x400000 + 65537) = omega;
    (match word.carry_add_bit(BitVec::ofNat(1)) as λ found => (word.carry_add_bit(BitVec::ofNat(1)) = found) → found = False {
        False => λ _ => refl,
        True => λ carried => {
            let over = BitVec::carry_add_of_bit_true(64, word, BitVec::ofNat(1), carried);
            let spelled = j(value, λ a _ => Nat::pow(2, 64) <= a + 1, over);
            false_elim(Nat::lt_irrefl(Nat::pow(2, 64), Nat::le_trans(Succ(Nat::pow(2, 64)), 0x400000 + 65537, Nat::pow(2, 64),
                Nat::le_trans(Succ(Nat::pow(2, 64)), Succ(0x400000 + k) + 1, 0x400000 + 65537, Nat::le_succ_succ(Nat::pow(2, 64), (0x400000 + k) + 1, spelled), room),
                Nat::leb_sound(0x400000 + 65537, Nat::pow(2, 64), trivial))))
        },
    })(refl)
}

// Code placed at file offset `k` onward is resident at `0x400000 + k`, whatever
// the page holds: one induction over the code, with no byte evaluated.
theorem io_suffix_resident(file: IoImage, page: Nat → BitVec(8), code: List<BitVec(8)>): (k: Nat) →
    k + code.len() <= 65536 →
    ((i: Nat) → (byte: BitVec(8)) → code.nth(i) = Some(byte) → file.bytes.nth(k + i) = Some(byte)) →
    CodeResident(io_fetch_access(), IoMemory(file, page), code, bitvec_nat::word_of_nat(64, 0x400000 + k)) {
    match code {
        Nil => λ k fits placed => trivial,
        Cons(byte, rest) => λ k fits placed => {
            let inside: (k < 65536) = Nat::le_trans(Succ(k), k + Succ(rest.len()), 65536, Nat::le_succ_succ(k, k + rest.len(), Nat::le_add_l(k, rest.len())), fits);
            let read = io_read_file(file, page, k, byte, inside, placed(0, byte, refl));
            let fetched = io_file_read_at(file.bytes, k, byte, inside, placed(0, byte, refl));
            let later = io_suffix_resident(file, page, rest, Succ(k), j(sym(Nat::add_succ_left(k, rest.len())), λ n _ => n <= 65536, fits),
                λ i found present => j(sym(Nat::add_succ_left(k, i)), λ at _ => file.bytes.nth(at) = Some(found), placed(Succ(i), found, present)));
            ⟨j(sym(fetched), λ found _ => (match found as λ _ => bool::Bool { None => False, Some(_) => True }) = True, refl),
             ⟨read, ⟨io_no_carry(k, inside), later⟩⟩⟩
        },
    }
}

// Whatever the frame, the rest and the page hold.
theorem io_code_resident(header, code: List<BitVec(8)>, frame: Nat → BitVec(8), rest: BitVec(64) → Option<BitVec(8)>,
    page: Nat → BitVec(8), fits: header.len() + code.len() <= 65536):
    CodeResident(io_fetch_access(), IoMemory(IoImage(header ++ code, frame, rest), page), code, bitvec_nat::word_of_nat(64, 0x400000 + header.len())) {
    io_suffix_resident(IoImage(header ++ code, frame, rest), page, code, header.len(), fits, λ i byte present =>
        trans(cong_fn<Nat, Option<BitVec(8)>>(λ at => (header ++ code).nth(at), Nat::add_comm(header.len(), i)),
            trans(header.nth_append_r(code, i), present)))
}

// The stat pass and the width (docs/native-wc-command-design.md §2, §6.1
// `width`): before counting, stat every operand in order (`-` as fstat(0),
// and stdin once when there is no operand), add up the regular files' sizes,
// note any file of another kind, and leave the width every count is padded
// to. The code is library code with no program-specific bytes; it walks argv
// with the operand cursor (elf64_operand_cursor) and counts digits with the
// formatter's count blocks (elf64_format_width). The claim is `stat_runs`,
// against `command_program`'s `stat_width`.
import command_program;
import decimal_line;
import elf64_arg_scan;
import elf64_format_width;
import elf64_runs;
import elf64_stretch;
import elf64_io;
import elf64_operand_cursor;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// What a stat says, as C reads x86-64's `struct stat`: `st_mode` is the u32
// at 24 and `st_size` the i64 at 48, both little-endian. A file is regular
// (S_ISREG) when its type bits (0o170000) are 0o100000; the mask lies in the
// low 32 bits, `st_mode`'s own, so the word at 24 tests the same bits.

fn st_byte(st: List<BitVec(8)>, i: Nat) → BitVec(8) { match st.nth(i) { None => nul(), Some(byte) => byte } }
fn st_word(st: List<BitVec(8)>, i: Nat) → BitVec(64) {
    immediate_from_bytes(st_byte(st, i), st_byte(st, i + 1), st_byte(st, i + 2), st_byte(st, i + 3),
        st_byte(st, i + 4), st_byte(st, i + 5), st_byte(st, i + 6), st_byte(st, i + 7))
}
fn type_bits() → BitVec(64) { BitVec::ofNat(0xf000) }
fn regular_bits() → BitVec(64) { BitVec::ofNat(0x8000) }
fn stat_regular(st: List<BitVec(8)>) → Bool { st_word(st, 24).band(type_bits()).eq_bit(regular_bits()) }
fn stat_size(st: List<BitVec(8)>) → BitVec(64) { st_word(st, 48) }
fn stat_seen(result: StatResult) → StatSeen {
    match result {
        Stated(st) => match stat_regular(st) { True => Regular(stat_size(st)), False => Other },
        StatFailed(_) => Unstated,
    }
}

// What each operand is stat'ed as: `-` is stdin, by fstat(0); anything else
// is a path, by newfstatat. With no operand at all, stdin once.
fn stat_target(operand: List<BitVec(8)>) → StatTarget {
    match operand {
        Nil => StatPath(operand),
        Cons(first, rest) => match rest {
            Nil => match first.eq_bit(dash()) { True => StatFd(word_zero()), False => StatPath(operand) },
            Cons(_, _) => StatPath(operand),
        },
    }
}
fn targets_from(made: Bool, operands: List<List<BitVec(8)>>) → List<StatTarget> {
    match operands {
        Nil => match made { False => [StatFd(word_zero())], True => Nil },
        Cons(operand, rest) => Cons(stat_target(operand), targets_from(True, rest)),
    }
}
fn stat_targets(operands: List<List<BitVec(8)>>) → List<StatTarget> { targets_from(False, operands) }

// The pass's events: one stat per target, with Linux's answer to each.
fn stat_events(targets: List<StatTarget>) → List<StatResult> → List<LinuxEvent> {
    match targets {
        Nil => λ _ => Nil,
        Cons(target, rest) => λ results => match results {
            Nil => Nil,
            Cons(result, more) => Cons(StatEvent(target, result), stat_events(rest, more)),
        },
    }
}
// Linux's answers, one per target, each as the event rule allows: a whole
// `struct stat`, or an errno.
fn StatAnswer(result: StatResult) → Type {
    match result { Stated(st) => st.len() = stat_length(), StatFailed(errno) => Errno(errno) }
}
fn StatsFit(targets: List<StatTarget>) → List<StatResult> → Type {
    match targets {
        Nil => λ results => match results { Nil => True, Cons(_, _) => False },
        Cons(_, rest) => λ results => match results { Nil => False, Cons(result, more) => StatAnswer(result) ∧ StatsFit(rest, more) },
    }
}

// One stat added in.
fn total_after(total: BitVec(64), one: StatSeen) → BitVec(64) {
    match one { Unstated => total, Regular(size) => total.add(size), Other => total }
}
fn other_after(other: Bool, one: StatSeen) → Bool { match one { Unstated => other, Regular(_) => other, Other => True } }

// ---------------------------------------------------------------------------
// The code. The stat buffer is the page's first 144 bytes: nothing has been
// read yet, so the page is free.
//
//   start:   the cursor's start (RBX past argv[0], R12 := 0)
//            R13 := 0 (the total), R14 := 0 (another kind seen), R15 := 0 (a stat made)
//   next:    the cursor; an operand: each
//            a stat made: done.  Otherwise (no operand at all):
//   fd:      fstat(0, page); acct
//   each:    `-`: fd.  Otherwise newfstatat(AT_FDCWD, RSI, page, 0)
//   acct:    R15 := 1; failed: next
//            RAX := the word at page+24; type bits regular: R13 += the word
//            at page+48, next.  Otherwise R14 := 1, next
//   done:    RSI := the digits of R13 (the formatter's count blocks)
//            R14 set and RSI below 7: RSI := 7
//
// RSI ends as the width. RSP, RBP, R8 and R9 are kept; the page's first 144
// bytes are whatever the last stat left there.

fn page_word() → BitVec(64) { BitVec::ofNat(0x410000) }
fn mode_word() → BitVec(64) { BitVec::ofNat(0x410018) }
fn size_word() → BitVec(64) { BitVec::ofNat(0x410030) }

fn stat_init_block() → List<Instruction> { [MovRI(R13, word_zero()), MovRI(R14, word_zero()), MovRI(R15, word_zero())] }
fn stat_made_block() → List<Instruction> { [MovRI(R11, word_zero()), CmpRR(R15, R11)] }
fn stat_fd_block() → List<Instruction> { [MovRI(Rax, BitVec::ofNat(5)), MovRI(Rdi, word_zero()), MovRI(Rsi, page_word())] }
fn stat_path_block() → List<Instruction> {
    [MovRI(Rax, BitVec::ofNat(262)), MovRI(Rdi, at_fdcwd()), MovRI(Rdx, page_word()), MovRI(R10, word_zero())]
}
fn stat_acct_block() → List<Instruction> { [MovRI(R15, BitVec::ofNat(1)), MovRI(R11, word_zero()), CmpRR(Rax, R11)] }
fn stat_mode_block() → List<Instruction> { [MovRI(Rdi, mode_word())] }
fn stat_word_load() → WordLoad { WordLoad(destination := Rax, base := Rdi) }
fn stat_kind_block() → List<Instruction> { [MovRI(R11, type_bits()), AndRR(Rax, R11), MovRI(R11, regular_bits()), CmpRR(Rax, R11)] }
fn stat_size_block() → List<Instruction> { [MovRI(Rdi, size_word())] }
fn stat_add_block() → List<Instruction> { [AddRR(R13, Rax)] }
fn stat_other_block() → List<Instruction> { [MovRI(R14, BitVec::ofNat(1))] }
fn stat_done_block() → List<Instruction> { [MovRR(Rax, R13), MovRR(Rbx, R13), MovRI(Rsi, BitVec::ofNat(1)), MovRI(Rdi, page_word())] }
fn stat_any_block() → List<Instruction> { [MovRI(R11, word_zero()), CmpRR(R14, R11)] }
fn stat_seven_block() → List<Instruction> { [MovRI(R11, BitVec::ofNat(7)), CmpRR(Rsi, R11)] }
fn stat_widen_block() → List<Instruction> { [MovRI(Rsi, BitVec::ofNat(7))] }

// The stat pass as a program (x86_64_asm). The jumps' targets, named.
fn tw_next() → Nat { 1 }
fn tw_fd() → Nat { 2 }
fn tw_each() → Nat { 3 }
fn tw_path() → Nat { 4 }
fn tw_acct() → Nat { 5 }
fn tw_other() → Nat { 6 }
fn tw_done() → Nat { 7 }
fn tw_end() → Nat { 8 }
fn stat_load() → Asm { Load(stat_word_load()) }
// start: the cursor's start, and the sums cleared
fn lw_start() → Prog { then(Start, Piece(start_code(), start_len(), start_code_len())) }
fn lw_init() → Prog { then(lw_start(), Block(stat_init_block())) }
// next: the cursor; an operand: each.  A stat made: done
fn lw_next() → Prog { At(lw_init(), tw_next(), Piece(cursor_code(), cursor_len(), cursor_code_len())) }
fn lw_operand() → Prog { then(lw_next(), Block(scan_null_block())) }
fn lw_each_jne() → Prog { then(lw_operand(), Jcc(NE, tw_each())) }
fn lw_made() → Prog { then(lw_each_jne(), Block(stat_made_block())) }
fn lw_made_jne() → Prog { then(lw_made(), Jcc(NE, tw_done())) }
// fd: fstat(0)
fn lw_fd() → Prog { At(lw_made_jne(), tw_fd(), Block(stat_fd_block())) }
fn lw_fd_call() → Prog { then(lw_fd(), Code(syscall_bytes())) }
fn lw_fd_jmp() → Prog { then(lw_fd_call(), Jmp(tw_acct())) }
// each: `-` alone is fd, anything else a path
fn lw_each() → Prog { At(lw_fd_jmp(), tw_each(), LoadByte(scan_byte_load())) }
fn lw_dash() → Prog { then(lw_each(), Block(scan_is_block(dash()))) }
fn lw_dash_jne() → Prog { then(lw_dash(), Jcc(NE, tw_path())) }
fn lw_ahead() → Prog { then(lw_dash_jne(), Block(scan_ahead_block())) }
fn lw_ahead_load() → Prog { then(lw_ahead(), LoadByte(scan_ahead_load())) }
fn lw_ahead_nul() → Prog { then(lw_ahead_load(), Block(scan_is_block(nul()))) }
fn lw_lone_je() → Prog { then(lw_ahead_nul(), Jcc(E, tw_fd())) }
// path: newfstatat(AT_FDCWD, RSI)
fn lw_path() → Prog { At(lw_lone_je(), tw_path(), Block(stat_path_block())) }
fn lw_path_call() → Prog { then(lw_path(), Code(syscall_bytes())) }
// acct: a failed stat, a regular file's size, or another kind noted
fn lw_acct() → Prog { At(lw_path_call(), tw_acct(), Block(stat_acct_block())) }
fn lw_failed_jne() → Prog { then(lw_acct(), Jcc(NE, tw_next())) }
fn lw_mode() → Prog { then(lw_failed_jne(), Block(stat_mode_block())) }
fn lw_mode_load() → Prog { then(lw_mode(), stat_load()) }
fn lw_kind() → Prog { then(lw_mode_load(), Block(stat_kind_block())) }
fn lw_kind_jne() → Prog { then(lw_kind(), Jcc(NE, tw_other())) }
fn lw_size() → Prog { then(lw_kind_jne(), Block(stat_size_block())) }
fn lw_size_load() → Prog { then(lw_size(), stat_load()) }
fn lw_add() → Prog { then(lw_size_load(), Block(stat_add_block())) }
fn lw_added_jmp() → Prog { then(lw_add(), Jmp(tw_next())) }
fn lw_other() → Prog { At(lw_added_jmp(), tw_other(), Block(stat_other_block())) }
fn lw_marked_jmp() → Prog { then(lw_other(), Jmp(tw_next())) }
// done: the total's digits, and seven if another kind was seen
fn lw_done() → Prog { At(lw_marked_jmp(), tw_done(), Block(stat_done_block())) }
fn lw_count() → Prog { then(lw_done(), Piece(count_blocks(19), count_len() * 19, count_blocks_len(19))) }
fn lw_any() → Prog { then(lw_count(), Block(stat_any_block())) }
fn lw_narrow_je() → Prog { then(lw_any(), Jcc(E, tw_end())) }
fn lw_seven() → Prog { then(lw_narrow_je(), Block(stat_seven_block())) }
fn lw_wide_jae() → Prog { then(lw_seven(), Jcc(AE, tw_end())) }
fn lw_widen() → Prog { then(lw_wide_jae(), Block(stat_widen_block())) }
fn lw_end() → Prog { At(lw_widen(), tw_end(), Block(Nil)) }
fn stat_prog() → Prog { lw_end() }
fn stat_labels() → Nat → Nat { asm_labels(stat_prog()) }
fn stat_code() → List<BitVec(8)> { assemble(no_fills(), stat_prog(), Nil) }
// The program's size, closed: a client's offsets add it without evaluating
// the program.
fn stat_len() → Nat { 1023 }
theorem stat_len_closed(): prog_len(stat_prog()) = stat_len() { refl }
// Label `l`'s offset in the stat pass, and the displacement of the jump there.
fn wa(l: Prog) → Nat { asm_at(l) }
fn wd(l: Prog) → BitVec(32) { asm_jump(stat_labels(), l) }
theorem stat_code_len(): stat_code().len() = stat_len() { trans(asm_len_is(no_fills(), stat_labels(), stat_prog(), trivial, Nil, 0, refl), stat_len_closed()) }

theorem wj_each_jne(): JumpsForward(wa(lw_each_jne()), 6, wd(lw_each_jne()), wa(lw_each())) { asm_jump_lands(stat_labels(), lw_each_jne(), 6, wa(lw_each()), refl) }
theorem wj_made_jne(): JumpsForward(wa(lw_made_jne()), 6, wd(lw_made_jne()), wa(lw_done())) { asm_jump_lands(stat_labels(), lw_made_jne(), 6, wa(lw_done()), refl) }
theorem wj_fd_jmp(): JumpsForward(wa(lw_fd_jmp()), 5, wd(lw_fd_jmp()), wa(lw_acct())) { asm_jump_lands(stat_labels(), lw_fd_jmp(), 5, wa(lw_acct()), refl) }
theorem wj_dash_jne(): JumpsForward(wa(lw_dash_jne()), 6, wd(lw_dash_jne()), wa(lw_path())) { asm_jump_lands(stat_labels(), lw_dash_jne(), 6, wa(lw_path()), refl) }
theorem wj_lone_je(): JumpsBack(wa(lw_lone_je()), 6, wd(lw_lone_je()), wa(lw_fd())) { asm_jump_lands_back(stat_labels(), lw_lone_je(), 6, wa(lw_fd()), refl) }
theorem wj_failed_jne(): JumpsBack(wa(lw_failed_jne()), 6, wd(lw_failed_jne()), wa(lw_next())) { asm_jump_lands_back(stat_labels(), lw_failed_jne(), 6, wa(lw_next()), refl) }
theorem wj_kind_jne(): JumpsForward(wa(lw_kind_jne()), 6, wd(lw_kind_jne()), wa(lw_other())) { asm_jump_lands(stat_labels(), lw_kind_jne(), 6, wa(lw_other()), refl) }
theorem wj_added_jmp(): JumpsBack(wa(lw_added_jmp()), 5, wd(lw_added_jmp()), wa(lw_next())) { asm_jump_lands_back(stat_labels(), lw_added_jmp(), 5, wa(lw_next()), refl) }
theorem wj_marked_jmp(): JumpsBack(wa(lw_marked_jmp()), 5, wd(lw_marked_jmp()), wa(lw_next())) { asm_jump_lands_back(stat_labels(), lw_marked_jmp(), 5, wa(lw_next()), refl) }
theorem wj_narrow_je(): JumpsForward(wa(lw_narrow_je()), 6, wd(lw_narrow_je()), wa(lw_end())) { asm_jump_lands(stat_labels(), lw_narrow_je(), 6, wa(lw_end()), refl) }
theorem wj_wide_jae(): JumpsForward(wa(lw_wide_jae()), 6, wd(lw_wide_jae()), wa(lw_end())) { asm_jump_lands(stat_labels(), lw_wide_jae(), 6, wa(lw_end()), refl) }

fn StatPieces(file: IoImage, at: BitVec(64)) → Type { AsmPlaced(file, no_fills(), stat_prog(), at) }
theorem stat_pieces(file: IoImage, at: BitVec(64), placed: Placed(file, stat_code(), at)): StatPieces(file, at) {
    asm_placed(file, no_fills(), stat_prog(), trivial, at, placed)
}
// The pass's stretches (elf64_stretch): the `n` items ending at label `l`.
theorem stat_straight(file: IoImage, at: BitVec(64), placed: Placed(file, stat_code(), at), page: Nat → BitVec(8),
    goal: MachineState<IoMemory> → Type, back: StepsBack(goal), l: Prog, found: asm_find(stat_prog(), l) = l, n: Nat,
    state: MachineState<IoMemory>, rip: state.rip = next_rip(at, straight_from(l, n)), memory_is: state.memory = IoMemory(file, page),
    held: Stretch(file, at, goal, stat_labels(), l, n)(page, state)): goal(state) {
    let k = prog_depth(stat_prog()) -prog_depth(l);
    let fills = no_fills();
    let front = asm_code(fills, stat_labels(), asm_back(stat_prog(), k));
    let after = asm_code_after(fills, stat_labels(), stat_prog(), k);
    stretch_runs(file, page, at, goal, back, fills, stat_labels(), l, n,
        j(found, λ x _ => FillsFit(x, fills), fills_fit_back(fills, k, stat_prog(), trivial)), after ++ Nil,
        j(found, λ x _ => Placed(file, asm_code(fills, stat_labels(), x) ++ (after ++ Nil), at),
            j(trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ c => c ++ Nil, asm_code_back(fills, stat_labels(), k, stat_prog())),
                List::append_assoc(front, after, Nil)), λ c _ => Placed(file, c, at), placed)),
        state, rip, memory_is, held)
}
// A jump's landing as a stretch spells its leaf, by its target's name; the
// landing facts (`wj_*`) spell it by the jump's own label.
theorem stat_lands(at: BitVec(64), before: Prog, size, target, to: Nat,
    lands: JumpsForward(prog_len(before), size, near_rel(prog_len(before) + size, stat_labels()(target)), to)):
    near_branch_target(next_rip(at, prog_len(before)), size, near_rel(prog_len(before) + size, stat_labels()(target))) = next_rip(at, to) {
    jumps_forward(at, prog_len(before), size, near_rel(prog_len(before) + size, stat_labels()(target)), to, lands)
}
theorem stat_lands_back(at: BitVec(64), before: Prog, size, target, to: Nat,
    lands: JumpsBack(prog_len(before), size, near_rel(prog_len(before) + size, stat_labels()(target)), to)):
    near_branch_target(next_rip(at, prog_len(before)), size, near_rel(prog_len(before) + size, stat_labels()(target))) = next_rip(at, to) {
    jumps_back(at, prog_len(before), size, near_rel(prog_len(before) + size, stat_labels()(target)), to, lands)
}

// ---------------------------------------------------------------------------
// The buffer, and reading a stat back from it.

theorem page_word_value(): page_word().toNat() = io_page_base() + 0 { BitVec::toNat_ofNat(64, 0x410000, { omega }) }
theorem stat_writable(memory: IoMemory): IoWritable(memory, page_word(), stat_length()) {
    let value = page_word_value();
    Inl(⟨j(sym(value), λ a _ => io_page_base() <= a, { omega }), j(sym(value), λ a _ => a + stat_length() <= io_page_base() + 4096, { omega })⟩)
}
theorem stat_stored(file: IoImage, page: Nat → BitVec(8), bytes: List<BitVec(8)>):
    io_store(IoMemory(file, page), page_word(), bytes) = io_store_offset(IoMemory(file, page), 0, bytes) {
    store_at_offset(IoMemory(file, page), page_word(), 0, bytes, { omega }, page_word_value())
}

theorem nth_present(st: List<BitVec(8)>): (i: Nat) → i < st.len() → st.nth(i) = Some(st_byte(st, i)) {
    match st as λ s => (i: Nat) → i < s.len() → s.nth(i) = Some(st_byte(s, i)) {
        Nil => λ i never => false_elim(Nat::not_succ_le_zero(i, never)),
        Cons(_, rest) => λ i => match i as λ m => m < Succ(rest.len()) → Cons(_, rest).nth(m) = Some(st_byte(Cons(_, rest), m)) {
            Zero => λ _ => refl,
            Succ(m) => λ below => nth_present(rest, m, below),
        },
    }
}

// The eight reads of a word, each present, are the word.
theorem word_of_eight(o0, o1, o2, o3, o4, o5, o6, o7: Option<BitVec(8)>, b0, b1, b2, b3, b4, b5, b6, b7: BitVec(8),
    e0: o0 = Some(b0), e1: o1 = Some(b1), e2: o2 = Some(b2), e3: o3 = Some(b3), e4: o4 = Some(b4), e5: o5 = Some(b5),
    e6: o6 = Some(b6), e7: o7 = Some(b7)):
    word_of_reads(o0, o1, o2, o3, o4, o5, o6, o7) = Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7)) {
    let goal = Some(immediate_from_bytes(b0, b1, b2, b3, b4, b5, b6, b7));
    j(sym(e0), λ x _ => word_of_reads(x, o1, o2, o3, o4, o5, o6, o7) = goal,
    j(sym(e1), λ x _ => word_of_reads(Some(b0), x, o2, o3, o4, o5, o6, o7) = goal,
    j(sym(e2), λ x _ => word_of_reads(Some(b0), Some(b1), x, o3, o4, o5, o6, o7) = goal,
    j(sym(e3), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), x, o4, o5, o6, o7) = goal,
    j(sym(e4), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), x, o5, o6, o7) = goal,
    j(sym(e5), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), x, o6, o7) = goal,
    j(sym(e6), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), Some(b5), x, o7) = goal,
    j(sym(e7), λ x _ => word_of_reads(Some(b0), Some(b1), Some(b2), Some(b3), Some(b4), Some(b5), Some(b6), x) = goal, refl))))))))
}

// The byte `j` past offset `o` of a stat stored at the page's start.
theorem stat_read(file: IoImage, page: Nat → BitVec(8), st: List<BitVec(8)>, o, i: Nat, len: st.len() = stat_length(),
    room: o + i < stat_length()):
    io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), i)) = Some(st_byte(st, o + i)) {
    let address: (next_rip(word_of_nat(64, io_page_base() + o), i) = word_of_nat(64, io_page_base() + (o + i))) =
        trans(BitVec::iterate_increment_compose(64, BitVec::zero(), io_page_base() + o, i),
            cong_fn<Nat, BitVec(64)>(λ v => word_of_nat(64, v), Nat::add_assoc(io_page_base(), o, i)));
    let below: (o + i < st.len()) = j(sym(len), λ l _ => o + i < l, room);
    trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ a => io_read(io_store_offset(IoMemory(file, page), 0, st), a), address),
        io_read_stored(IoMemory(file, page), st, o + i, st_byte(st, o + i), { omega }, nth_present(st, o + i, below)))
}

// The word at offset `o` of a stat stored at the page's start.
theorem stat_word_at(file: IoImage, page: Nat → BitVec(8), st: List<BitVec(8)>, o: Nat, len: st.len() = stat_length(),
    room: o + 8 <= stat_length()):
    WordAt(io_data_access(), io_store_offset(IoMemory(file, page), 0, st), word_of_nat(64, io_page_base() + o), st_word(st, o)) {
    let value: (word_of_nat(64, io_page_base() + o).toNat() = io_page_base() + o) = toNat_word_of_nat(64, io_page_base() + o, { omega });
    ⟨j(sym(value), λ a _ => a + 8 <= Nat::pow(2, 47), { omega }),
     word_of_eight(io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 0)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 1)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 2)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 3)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 4)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 5)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 6)), io_read(io_store_offset(IoMemory(file, page), 0, st), next_rip(word_of_nat(64, io_page_base() + o), 7)),
        st_byte(st, o + 0), st_byte(st, o + 1), st_byte(st, o + 2), st_byte(st, o + 3), st_byte(st, o + 4), st_byte(st, o + 5), st_byte(st, o + 6), st_byte(st, o + 7),
        stat_read(file, page, st, o, 0, len, { omega }), stat_read(file, page, st, o, 1, len, { omega }),
        stat_read(file, page, st, o, 2, len, { omega }), stat_read(file, page, st, o, 3, len, { omega }),
        stat_read(file, page, st, o, 4, len, { omega }), stat_read(file, page, st, o, 5, len, { omega }),
        stat_read(file, page, st, o, 6, len, { omega }), stat_read(file, page, st, o, 7, len, { omega }))⟩
}
theorem mode_address(): mode_word() = word_of_nat(64, io_page_base() + 24) {
    trans(sym(word_of_nat_toNat(64, mode_word())),
        cong_fn<Nat, BitVec(64)>(λ v => word_of_nat(64, v), BitVec::toNat_ofNat(64, 0x410018, { omega })))
}
theorem size_address(): size_word() = word_of_nat(64, io_page_base() + 48) {
    trans(sym(word_of_nat_toNat(64, size_word())),
        cong_fn<Nat, BitVec(64)>(λ v => word_of_nat(64, v), BitVec::toNat_ofNat(64, 0x410030, { omega })))
}

// ---------------------------------------------------------------------------
// What the pass carries.

fn StatKept(after, before: Gprs) → Type {
    (read_gpr(Rsp, after) = read_gpr(Rsp, before)) ∧ ((read_gpr(Rbp, after) = read_gpr(Rbp, before)) ∧
    ((read_gpr(R8, after) = read_gpr(R8, before)) ∧ (read_gpr(R9, after) = read_gpr(R9, before))))
}
// The total so far, whether another kind has been seen, and the kept
// registers.
fn StatCarried(total: BitVec(64), other: Bool, origin, gprs: Gprs) → Type {
    (read_gpr(R13, gprs) = total) ∧ ((read_gpr(R14, gprs) = ended_word(other)) ∧ StatKept(gprs, origin))
}
theorem carried_cursor(total: BitVec(64), other: Bool, origin, after, before: Gprs, kept: CursorKept(after, before),
    carried: StatCarried(total, other, origin, before)): StatCarried(total, other, origin, after) {
    ⟨trans(kept.right.right.right.right.right.right.right.left, carried.left),
     ⟨trans(kept.right.right.right.right.right.right.right.right.left, carried.right.left),
      ⟨trans(kept.left, carried.right.right.left), ⟨trans(kept.right.left, carried.right.right.right.left),
       ⟨trans(kept.right.right.right.right.left, carried.right.right.right.right.left),
        trans(kept.right.right.right.right.right.left, carried.right.right.right.right.right)⟩⟩⟩⟩⟩
}

// At `next`: the cursor's registers at argv slot `k`, and the pass's.
record StatAt(file: IoImage, page: Nat → BitVec(8), at, rsp: BitVec(64), origin: Gprs, k: Nat, ended: Bool,
    args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other, made: Bool, state: MachineState<IoMemory>) {
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, wa(lw_next())),
    rbx: read_gpr(Rbx, state.gprs) = argv_slot(rsp, k),
    r12: read_gpr(R12, state.gprs) = ended_word(ended),
    r15: read_gpr(R15, state.gprs) = ended_word(made),
    carried: StatCarried(total, other, origin, state.gprs),
    argv: ArgvStays(file, rsp, args, pointers, k),
}

// Past the code: RSI the width, and the kept registers.
record StatOut(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), origin: Gprs, width: Nat, state: MachineState<IoMemory>) {
    memory_is: state.memory = IoMemory(file, page),
    rip_is: state.rip = next_rip(at, stat_len()),
    rsi: read_gpr(Rsi, state.gprs).toNat() = width,
    kept: StatKept(state.gprs, origin),
}
// What the program does once the width is known.
fn StatThen(file: IoImage, at: BitVec(64), origin: Gprs, width: Nat, after: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → StatOut(file, page, at, origin, width, state) →
        LinuxRuns(io_linux(), after, state)
}

// ---------------------------------------------------------------------------
// The width.

theorem ended_cmp(other: Bool, gprs: Gprs, r14: read_gpr(R14, gprs) = ended_word(other)):
    is_zero_bits(64, read_gpr(R14, gprs).sub(word_zero())) = ended_zf(other) {
    trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), r14), ended_flag(other))
}

// From `done`: the total's digits (`count_run`, over a piece a stretch does
// not read), then one stretch of five items to the widen; the narrow JE and
// the wide JAE end at `end`.
theorem stat_done(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), origin: Gprs, total: BitVec(64),
    other: Bool, after: List<LinuxEvent>, then: StatThen(file, at, origin, widened(other, decimal(total.toNat()).len()), after),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_done())),
    carried: StatCarried(total, other, origin, state.gprs)): LinuxRuns(io_linux(), after, state) {
    let piece = stat_pieces(file, at, placed);
    let fetch = io_fetch_access();
    let data = io_data_access();
    let set = run_block(file, page, stat_done_block(), at, wa(lw_done()), piece(lw_done()), state, memory_is, rip_is);
    let s1 = execute_block_normal(stat_done_block(), state);
    let n = total.toNat();
    let r13: (read_gpr(R13, state.gprs).toNat() = n) = cong_fn<BitVec(64), Nat>(λ w => w.toNat(), carried.left);
    let head: CountAt(file, page, next_rip(at, wa(lw_count())), n, read_gpr(Rdx, s1.gprs).toNat(), 0, 1, s1.gprs, s1) =
        CountAt(memory_is := set.memory_is, rip_is := set.rip_is, rax := r13, rbx := r13, rdx := refl, rdi := page_word_value(), rsi := refl,
            kept := fmt_kept_refl(s1.gprs));
    have counted = count_run(file, page, n, read_gpr(Rdx, s1.gprs).toNat(), 0, s1.gprs, 19, next_rip(at, wa(lw_count())), 1, s1, trivial, trivial,
        piece(lw_count()), head);
    let s2 = counted.witness;
    let c = counted.proof.right;
    let s2_rip: (s2.rip = next_rip(at, wa(lw_any()))) = trans(c.rip_is, trans(rip_compose(at, wa(lw_count()), count_blocks(19).len()), rip_count(at, cong_fn<Nat, Nat>(λ l => wa(lw_count()) + l, count_blocks_len(19)))));
    let digits: (read_gpr(Rsi, s2.gprs).toNat() = decimal(n).len()) =
        trans(c.rsi, trans(sym(succ_one_add(places_reached(19, n))), sym(decimal_len(n, BitVec::toNat_lt_pow(64, total)))));
    let fk = c.kept;
    let kept = carried.right.right;
    let kept2: StatKept(s2.gprs, origin) = ⟨trans(fk.left, kept.left), ⟨trans(fk.right.left, kept.right.left),
        ⟨trans(fk.right.right.left, kept.right.right.left), trans(fk.right.right.right.left, kept.right.right.right)⟩⟩⟩;
    let r14: (read_gpr(R14, s2.gprs) = ended_word(other)) = trans(fk.right.right.right.right.right.right.right.left, carried.right.left);
    let d = decimal(n).len();
    let rsi = read_gpr(Rsi, s2.gprs);
    let seven = BitVec::ofNat(7, n := 64);
    linux_runs_after_steps(io_linux(), after, state, s2, fetched_steps_trans(fetch, data, state, s1, s2, set.steps, counted.proof.left),
        (match other as λ o => (read_gpr(R14, s2.gprs) = ended_word(o)) → StatThen(file, at, origin, widened(o, d), after) →
                LinuxRuns(io_linux(), after, s2) {
            False => λ none then => stat_straight(file, at, placed, page, λ s => LinuxRuns(io_linux(), after, s), runs_back(after), lw_widen(), refl, 5,
                s2, s2_rip, c.memory_is,
                ⟨λ _ e rip m same => then(page, e, StatOut(memory_is := m,
                        rip_is := trans(rip, stat_lands(at, lw_any(), 6, tw_end(), wa(lw_end()), wj_narrow_je())),
                        rsi := j(sym(same), λ s _ => read_gpr(Rsi, s.gprs).toNat() = d, digits),
                        kept := j(sym(same), λ s _ => StatKept(s.gprs, origin), kept2))),
                 λ passed => absurd(trans(sym(passed), ended_cmp(False, s2.gprs, none)))⟩),
            True => λ some then => stat_straight(file, at, placed, page, λ s => LinuxRuns(io_linux(), after, s), runs_back(after), lw_widen(), refl, 5,
                s2, s2_rip, c.memory_is,
                ⟨λ taken => absurd(trans(sym(taken), ended_cmp(True, s2.gprs, some))),
                 λ _ => ⟨λ taken e rip m same => {
                        let wide = not_true_is(rsi.borrow_sub_bit(seven), taken);
                        let at_least: (7 <= d) = j(digits, λ v _ => 7 <= v, cmp_not_below(rsi, seven, wide));
                        let leb: (Nat::leb(7, d) = True) = eq_true_of_is_true(Nat::leb(7, d), Nat::leb_complete(7, d, at_least));
                        then(page, e, j(sym(leb), λ b _ => StatOut(file, page, at, origin, match b { True => d, False => 7 }, e),
                            StatOut(memory_is := m, rip_is := trans(rip, stat_lands(at, lw_seven(), 6, tw_end(), wa(lw_end()), wj_wide_jae())),
                                rsi := j(sym(same), λ s _ => read_gpr(Rsi, s.gprs).toNat() = d, digits),
                                kept := j(sym(same), λ s _ => StatKept(s.gprs, origin), kept2))))
                     },
                     λ passed e rip m same => {
                        let narrow = not_false_is(rsi.borrow_sub_bit(seven), passed);
                        let below: (d < 7) = j(digits, λ v _ => v < 7, cmp_below(rsi, seven, narrow));
                        let leb: (Nat::leb(7, d) = False) = io_leb_false(7, d, below);
                        then(page, e, j(sym(leb), λ b _ => StatOut(file, page, at, origin, match b { True => d, False => 7 }, e),
                            StatOut(memory_is := m, rip_is := rip, rsi := j(sym(same), λ s _ => read_gpr(Rsi, s.gprs).toNat() = 7, refl),
                                kept := j(sym(same), λ s _ => StatKept(s.gprs, origin), kept2))))
                     }⟩⟩),
        })(r14, then))
}

// No operand left, and a stat made: the cursor (a piece), then one stretch
// of four items to the JNE to `done`.
theorem stat_end_runs(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    after: List<LinuxEvent>, k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    then: StatThen(file, at, origin, width_from(total, other, Nil), after), state: MachineState<IoMemory>, left: operands_from(ended, args) = Nil,
    head: StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, True, state)): LinuxRuns(io_linux(), after, state) {
    let piece = stat_pieces(file, at, placed);
    let reach = j(left, λ o _ => CursorReach(file, page, next_rip(at, wa(lw_next())), rsp, state.gprs, o, state),
        cursor_runs(file, next_rip(at, wa(lw_next())), piece(lw_next()), page, rsp, k, ended, args, pointers, state.gprs, state, head.argv,
            CursorAt(memory_is := head.memory_is, rip_is := head.rip_is, regs := ⟨head.rbx, ⟨head.r12, cursor_kept_refl(state.gprs)⟩⟩)));
    let s1 = reach.witness;
    let out = reach.proof.right;
    let rest = out.right;
    let s1_rip: (s1.rip = next_rip(at, wa(lw_operand()))) = trans(rest.rip_is, rip_compose(at, wa(lw_next()), cursor_len()));
    let carried = carried_cursor(total, other, origin, s1.gprs, state.gprs, rest.regs.right.right, head.carried);
    let r15: (read_gpr(R15, s1.gprs) = ended_word(True)) = trans(rest.regs.right.right.right.right.right.right.right.right.right.right.right, head.r15);
    let none: (is_zero_bits(64, read_gpr(Rsi, s1.gprs).sub(word_zero())) = True) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), out.left), zero_bits_sub_self(64, word_zero()));
    let some: (is_zero_bits(64, read_gpr(R15, s1.gprs).sub(word_zero())) = False) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), r15), ended_flag(True));
    linux_runs_after_linux_steps(io_linux(), after, state, s1, reach.proof.left,
        stat_straight(file, at, placed, page, λ s => LinuxRuns(io_linux(), after, s), runs_back(after), lw_made_jne(), refl, 4, s1, s1_rip, rest.memory_is,
            ⟨λ taken => absurd(trans(sym(taken), cong_fn<Bool, Bool>(λ x => !x, none))),
             λ _ => ⟨λ _ e rip m same => stat_done(file, page, at, placed, origin, total, other, after, then, e, m,
                    trans(rip, stat_lands(at, lw_made(), 6, tw_done(), wa(lw_done()), wj_made_jne())),
                    j(sym(same), λ s _ => StatCarried(total, other, origin, s.gprs), carried)),
                 λ passed => absurd(trans(sym(passed), cong_fn<Bool, Bool>(λ x => !x, some)))⟩⟩))
}

// ---------------------------------------------------------------------------
// One stat's answer, from `acct`: the total and the kind added in, and
// back to `next`.

// What a stat leaves in the registers the pass keeps; RAX its answer.
fn AcctRegs(rsp: BitVec(64), k: Nat, ended: Bool, total: BitVec(64), other: Bool, origin: Gprs, rax: BitVec(64), gprs: Gprs) → Type {
    (read_gpr(Rax, gprs) = rax) ∧ ((read_gpr(Rbx, gprs) = argv_slot(rsp, k)) ∧ ((read_gpr(R12, gprs) = ended_word(ended)) ∧
    StatCarried(total, other, origin, gprs)))
}
// The stat's own continuation: `next` with the answer added in.
fn StatNext(file: IoImage, at, rsp: BitVec(64), origin: Gprs, k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    total: BitVec(64), other: Bool, events: List<LinuxEvent>) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) →
        StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, True, state) → LinuxRuns(io_linux(), events, state)
}

theorem acct_failed(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool, errno: Nat,
    error: Errno(errno), state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_acct())),
    regs: AcctRegs(rsp, k, ended, total, other, origin, errno_word(errno), state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    Exists<MachineState<IoMemory>>(λ after => FetchedSteps(io_fetch_access(), io_data_access(), state, after) ∧
        StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, True, after)) {
    let piece = stat_pieces(file, at, placed);
    let tested = run_block(file, page, stat_acct_block(), at, wa(lw_acct()), piece(lw_acct()), state, memory_is, rip_is);
    let s1 = execute_block_normal(stat_acct_block(), state);
    let jumped = run_near(file, page, JumpIfNear(NE, wd(lw_failed_jne())), at, wa(lw_failed_jne()), piece(lw_failed_jne()), s1, tested.memory_is, tested.rip_is);
    let s2 = execute_near_control(JumpIfNear(NE, wd(lw_failed_jne())), s1);
    let differ: (s1.flags.zf = False) = trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), regs.left),
        trans(zero_bits_sub(64, errno_word(errno), word_zero()), nonzero_word(errno_word(errno), errno_nonzero(errno, error))));
    let s2_rip = jcc_taken_back(NE, wd(lw_failed_jne()), s1, at, wa(lw_failed_jne()), wa(lw_next()), tested.rip_is, ne_holds(s1.flags, differ), wj_failed_jne());
    Exists(s2, ⟨fetched_steps_trans(io_fetch_access(), io_data_access(), state, s1, s2, tested.steps, jumped),
        StatAt(memory_is := tested.memory_is, rip_is := s2_rip, rbx := regs.right.left, r12 := regs.right.right.left, r15 := refl,
            carried := regs.right.right.right, argv := argv)⟩)
}

// A stat that answered: its type bits decide whether its size is added
// (`acct` to the JMP, ten items; another kind, `acct_other`).
fn OtherRegs(rsp: BitVec(64), k: Nat, ended: Bool, total: BitVec(64), other: Bool, origin: Gprs, gprs: Gprs) → Type {
    (read_gpr(Rbx, gprs) = argv_slot(rsp, k)) ∧ ((read_gpr(R12, gprs) = ended_word(ended)) ∧ ((read_gpr(R15, gprs) = ended_word(True)) ∧
    StatCarried(total, other, origin, gprs)))
}
theorem acct_other(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool, events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total, True, events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_other())),
    regs: OtherRegs(rsp, k, ended, total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), events, state) {
    stat_straight(file, at, placed, page, λ s => LinuxRuns(io_linux(), events, s), runs_back(events), lw_marked_jmp(), refl, 2, state, rip_is, memory_is,
        λ after rip m same => then(page, after, j(sym(same), λ s _ => StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, True, True, s),
            StatAt(memory_is := trans(cong_fn<MachineState<IoMemory>, IoMemory>(λ y => y.memory, sym(same)), m),
                rip_is := trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ y => y.rip, sym(same)),
                    trans(rip, stat_lands_back(at, lw_other(), 5, tw_next(), wa(lw_next()), wj_marked_jmp()))),
                rbx := regs.left, r12 := regs.right.left, r15 := regs.right.right.left,
                carried := ⟨regs.right.right.right.left, ⟨refl, regs.right.right.right.right.right⟩⟩, argv := argv))))
}
// The answer's kind, decided: what `then` is owed.
theorem stated_regular(file: IoImage, at, rsp: BitVec(64), origin: Gprs, k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    total: BitVec(64), other: Bool, st: List<BitVec(8)>, events: List<LinuxEvent>, regular: stat_regular(st) = True,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(Stated(st))), other_after(other, stat_seen(Stated(st))), events)):
    StatNext(file, at, rsp, origin, k, ended, args, pointers, total.add(stat_size(st)), other, events) {
    j(regular, λ c _ => StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, match c { True => Regular(stat_size(st)), False => Other }),
        other_after(other, match c { True => Regular(stat_size(st)), False => Other }), events), then)
}
theorem stated_other(file: IoImage, at, rsp: BitVec(64), origin: Gprs, k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>,
    total: BitVec(64), other: Bool, st: List<BitVec(8)>, events: List<LinuxEvent>, irregular: stat_regular(st) = False,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(Stated(st))), other_after(other, stat_seen(Stated(st))), events)):
    StatNext(file, at, rsp, origin, k, ended, args, pointers, total, True, events) {
    j(irregular, λ c _ => StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, match c { True => Regular(stat_size(st)), False => Other }),
        other_after(other, match c { True => Regular(stat_size(st)), False => Other }), events), then)
}
theorem acct_stated(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool, st: List<BitVec(8)>,
    len: st.len() = stat_length(), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(Stated(st))), other_after(other, stat_seen(Stated(st))), events),
    state: MachineState<IoMemory>, memory_is: state.memory = io_store_offset(IoMemory(file, page), 0, st), rip_is: state.rip = next_rip(at, wa(lw_acct())),
    regs: AcctRegs(rsp, k, ended, total, other, origin, BitVec::ofNat(0), state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), events, state) {
    let io = io_linux();
    let data = io_data_access();
    let page2 = io_store_offset(IoMemory(file, page), 0, st).page;
    let mode = st_word(st, 24);
    let size = st_word(st, 48);
    let carried = regs.right.right.right;
    let zero: (execute_block_normal(stat_acct_block(), state).flags.zf = True) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), regs.left), zero_bits_sub_self(64, word_zero()));
    let kind: (is_zero_bits(64, mode.band(type_bits()).sub(regular_bits())) = stat_regular(st)) = zero_bits_sub(64, mode.band(type_bits()), regular_bits());
    let mode_at: WordAt(data, IoMemory(file, page2), mode_word(), mode) =
        j(sym(mode_address()), λ a _ => WordAt(data, IoMemory(file, page2), a, mode), stat_word_at(file, page, st, 24, len, trivial));
    let size_at: WordAt(data, IoMemory(file, page2), size_word(), size) =
        j(sym(size_address()), λ a _ => WordAt(data, IoMemory(file, page2), a, size), stat_word_at(file, page, st, 48, len, trivial));
    stat_straight(file, at, placed, page2, λ s => LinuxRuns(io, events, s), runs_back(events), lw_added_jmp(), refl, 10, state, rip_is, memory_is,
        ⟨λ failed after rip m same => absurd(trans(cong_fn<Bool, Bool>(λ x => !x, sym(zero)), failed)),
         λ answered => Exists(mode, Exists(mode_word(), ⟨refl, ⟨mode_at,
            ⟨λ differ after rip m same => {
                let irregular = not_true_is(stat_regular(st), trans(cong_fn<Bool, Bool>(λ x => !x, sym(kind)), differ));
                acct_other(file, page2, at, placed, rsp, origin, k, ended, args, pointers, total, other, events,
                    stated_other(file, at, rsp, origin, k, ended, args, pointers, total, other, st, events, irregular, then), after, m,
                    trans(rip, stat_lands(at, lw_kind(), 6, tw_other(), wa(lw_other()), wj_kind_jne())),
                    j(sym(same), λ s _ => OtherRegs(rsp, k, ended, total, other, origin, s.gprs),
                        ⟨regs.right.left, ⟨regs.right.right.left, ⟨refl, carried⟩⟩⟩), argv)
            },
             λ regular => Exists(size, Exists(size_word(), ⟨refl, ⟨size_at, λ after rip m same => {
                let sized = not_false_is(stat_regular(st), trans(cong_fn<Bool, Bool>(λ x => !x, sym(kind)), regular));
                stated_regular(file, at, rsp, origin, k, ended, args, pointers, total, other, st, events, sized, then)(page2, after,
                    j(sym(same), λ s _ => StatAt(file, page2, at, rsp, origin, k, ended, args, pointers, total.add(size), other, True, s),
                        StatAt(memory_is := trans(cong_fn<MachineState<IoMemory>, IoMemory>(λ y => y.memory, sym(same)), m),
                            rip_is := trans(cong_fn<MachineState<IoMemory>, BitVec(64)>(λ y => y.rip, sym(same)),
                                trans(rip, stat_lands_back(at, lw_add(), 5, tw_next(), wa(lw_next()), wj_added_jmp()))),
                            rbx := regs.right.left, r12 := regs.right.right.left, r15 := refl,
                            carried := ⟨cong_fn<BitVec(64), BitVec(64)>(λ t => t.add(size), carried.left), carried.right⟩, argv := argv)))
            }⟩⟩))⟩⟩⟩))⟩)
}

// ---------------------------------------------------------------------------
// A stat, from its SYSCALL to `next`.

// From the SYSCALL's return to `acct`: nothing for the path stat, whose
// SYSCALL is just before it, and a JMP for fstat.
fn AcctFrom(file: IoImage, at: BitVec(64), returned: Nat) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.memory = IoMemory(file, page) → state.rip = next_rip(at, returned) →
        Exists<MachineState<IoMemory>>(λ after => FetchedSteps(io_fetch_access(), io_data_access(), state, after) ∧
            ((after.rip = next_rip(at, wa(lw_acct()))) ∧ ((after.memory = state.memory) ∧ (after.gprs = state.gprs))))
}
theorem acct_from_path(file: IoImage, at: BitVec(64)): AcctFrom(file, at, wa(lw_acct())) {
    λ page state _ rip_is => Exists(state, ⟨fetched_steps_refl(io_fetch_access(), io_data_access(), state), ⟨rip_is, ⟨refl, refl⟩⟩⟩)
}
theorem acct_from_fd(file: IoImage, at: BitVec(64), placed: Placed(file, stat_code(), at)): AcctFrom(file, at, wa(lw_fd_jmp())) {
    let piece = stat_pieces(file, at, placed);
    λ page state memory_is rip_is => Exists(execute_near_control(JumpNear(wd(lw_fd_jmp())), state),
        ⟨run_near(file, page, JumpNear(wd(lw_fd_jmp())), at, wa(lw_fd_jmp()), piece(lw_fd_jmp()), state, memory_is, rip_is),
         ⟨trans(cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 5, wd(lw_fd_jmp())), rip_is), jumps_forward(at, wa(lw_fd_jmp()), 5, wd(lw_fd_jmp()), wa(lw_acct()), wj_fd_jmp())),
          ⟨refl, refl⟩⟩⟩)
}

theorem stat_call(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    target: StatTarget, result: StatResult, answer: StatAnswer(result), call: Nat, to_acct: AcctFrom(file, at, call + 2),
    events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, call),
    syscall: LinuxSyscallAt(io_linux(), state), request: StatRequest(io_linux(), state, target), buffer: stat_buffer(target, state.gprs) = page_word(),
    regs: AcctRegs(rsp, k, ended, total, other, origin, read_gpr(Rax, state.gprs), state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(target, result), events), state) {
    let io = io_linux();
    let none: LinuxSteps(io, state, state) = Exists(0, refl);
    let stored_at = λ (bytes: List<BitVec(8)>) => {
        let stored: (io_store(state.memory, stat_buffer(target, state.gprs), bytes) = io_store_offset(IoMemory(file, page), 0, bytes)) =
            trans(cong_fn<IoMemory, IoMemory>(λ m => io_store(m, stat_buffer(target, state.gprs), bytes), memory_is),
                trans(cong_fn<BitVec(64), IoMemory>(λ b => io_store(IoMemory(file, page), b, bytes), buffer), stat_stored(file, page, bytes)));
        stored
    };
    let returned = λ (_: Nat) => rip_advance(at, state.rip, call, 2, rip_is);
    match result as λ r => StatAnswer(r) →
            StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(r)), other_after(other, stat_seen(r)), events) →
            LinuxRuns(io, Cons(StatEvent(target, r), events), state) {
        Stated(st) => λ len next => linux_runs_stat(io, state, state, target, st, events, none, syscall, request, len, λ rcx r11 => {
            let back = linux_stat_return(io, state, target, st, BitVec::ofNat(0), rcx, r11);
            let page2 = io_store_offset(IoMemory(file, page), 0, st).page;
            have went = to_acct(page2, back, stored_at(st), returned(0));
            let s1 = went.witness;
            let facts: AcctRegs(rsp, k, ended, total, other, origin, BitVec::ofNat(0), s1.gprs) =
                j(sym(went.proof.right.right.right), λ g _ => AcctRegs(rsp, k, ended, total, other, origin, BitVec::ofNat(0), g),
                    ⟨refl, regs.right⟩);
            linux_runs_after_steps(io, events, back, s1, went.proof.left,
                acct_stated(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, st, len, events, next, s1,
                    trans(went.proof.right.right.left, stored_at(st)), went.proof.right.left, facts, argv))
        }),
        StatFailed(errno) => λ error next => linux_runs_stat_failed(io, state, state, target, errno, events, none, syscall, request, error,
            λ junk _ rcx r11 => {
                let back = linux_stat_return(io, state, target, junk, errno_word(errno), rcx, r11);
                let page2 = io_store_offset(IoMemory(file, page), 0, junk).page;
                have went = to_acct(page2, back, stored_at(junk), returned(0));
                let s1 = went.witness;
                let facts: AcctRegs(rsp, k, ended, total, other, origin, errno_word(errno), s1.gprs) =
                    j(sym(went.proof.right.right.right), λ g _ => AcctRegs(rsp, k, ended, total, other, origin, errno_word(errno), g),
                        ⟨refl, regs.right⟩);
                have counted = acct_failed(file, page2, at, placed, rsp, origin, k, ended, args, pointers, total, other, errno, error, s1,
                    trans(went.proof.right.right.left, stored_at(junk)), went.proof.right.left, facts, argv);
                linux_runs_after_steps(io, events, back, counted.witness,
                    fetched_steps_trans(io_fetch_access(), io_data_access(), back, s1, counted.witness, went.proof.left, counted.proof.left),
                    next(page2, counted.witness, counted.proof.right))
            }),
    }(answer, then)
}

// fstat(0) from `fd`.
theorem stat_fd(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_fd())),
    rbx: read_gpr(Rbx, state.gprs) = argv_slot(rsp, k), r12: read_gpr(R12, state.gprs) = ended_word(ended),
    carried: StatCarried(total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(StatFd(word_zero()), result), events), state) {
    let piece = stat_pieces(file, at, placed);
    let set = run_block(file, page, stat_fd_block(), at, wa(lw_fd()), piece(lw_fd()), state, memory_is, rip_is);
    let s1 = execute_block_normal(stat_fd_block(), state);
    linux_runs_after_steps(io_linux(), Cons(StatEvent(StatFd(word_zero()), result), events), state, s1, set.steps,
        stat_call(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, StatFd(word_zero()), result, answer, 300,
            acct_from_fd(file, at, placed), events, then, s1, set.memory_is, set.rip_is,
            syscall_placed(file, page, at, wa(lw_fd_call()), piece(lw_fd_call()), s1, set.memory_is, set.rip_is),
            ⟨⟨refl, refl⟩, stat_writable(s1.memory)⟩, refl, ⟨refl, ⟨rbx, ⟨r12, carried⟩⟩⟩, argv))
}

// newfstatat(AT_FDCWD, RSI, page, 0) from `path`.
theorem stat_path(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    operand: List<BitVec(8)>, result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_path())),
    string: CStringAt(io_data_access(), IoMemory(file, page), read_gpr(Rsi, state.gprs), operand),
    rbx: read_gpr(Rbx, state.gprs) = argv_slot(rsp, k), r12: read_gpr(R12, state.gprs) = ended_word(ended),
    carried: StatCarried(total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(StatPath(operand), result), events), state) {
    let piece = stat_pieces(file, at, placed);
    let set = run_block(file, page, stat_path_block(), at, wa(lw_path()), piece(lw_path()), state, memory_is, rip_is);
    let s1 = execute_block_normal(stat_path_block(), state);
    let here: CStringAt(io_data_access(), s1.memory, read_gpr(Rsi, s1.gprs), operand) =
        j(sym(set.memory_is), λ m _ => CStringAt(io_data_access(), m, read_gpr(Rsi, state.gprs), operand), string);
    linux_runs_after_steps(io_linux(), Cons(StatEvent(StatPath(operand), result), events), state, s1, set.steps,
        stat_call(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, StatPath(operand), result, answer, 400,
            acct_from_path(file, at), events, then, s1, set.memory_is, set.rip_is,
            syscall_placed(file, page, at, wa(lw_path_call()), piece(lw_path_call()), s1, set.memory_is, set.rip_is),
            ⟨⟨refl, ⟨refl, ⟨refl, here⟩⟩⟩, stat_writable(s1.memory)⟩, refl, ⟨refl, ⟨rbx, ⟨r12, carried⟩⟩⟩, argv))
}

// ---------------------------------------------------------------------------
// After the cursor (`lw_operand`).

theorem target_not_dash(first: BitVec(8), tail: List<BitVec(8)>, no: first.eq_bit(dash()) = False):
    stat_target(Cons(first, tail)) = StatPath(Cons(first, tail)) {
    match tail as λ t => stat_target(Cons(first, t)) = StatPath(Cons(first, t)) {
        Nil => j(sym(no), λ c _ => (match c as λ _ => StatTarget { True => StatFd(word_zero()), False => StatPath([first]) }) = StatPath([first]), refl),
        Cons(_, _) => refl,
    }
}
theorem target_lone_dash(first: BitVec(8), yes: first.eq_bit(dash()) = True): stat_target([first]) = StatFd(word_zero()) {
    j(sym(yes), λ c _ => (match c as λ _ => StatTarget { True => StatFd(word_zero()), False => StatPath([first]) }) = StatFd(word_zero()), refl)
}

// The registers an operand's stretches keep: its pointer in RSI, the
// cursor's, and the sums.
fn EachRegs(pointer, rsp: BitVec(64), k: Nat, ended: Bool, total: BitVec(64), other: Bool, origin: Gprs, gprs: Gprs) → Type {
    (read_gpr(Rsi, gprs) = pointer) ∧ ((read_gpr(Rbx, gprs) = argv_slot(rsp, k)) ∧ ((read_gpr(R12, gprs) = ended_word(ended)) ∧
    StatCarried(total, other, origin, gprs)))
}
// A stretch that reached `path`: stat the operand by name.
theorem each_path(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    operand: List<BitVec(8)>, pointer: BitVec(64), result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    string: ArgStays(file, pointer, operand), argv: ArgvStays(file, rsp, args, pointers, k),
    after: MachineState<IoMemory>, rip: after.rip = next_rip(at, wa(lw_path())), m: after.memory = IoMemory(file, page),
    regs: EachRegs(pointer, rsp, k, ended, total, other, origin, after.gprs)):
    LinuxRuns(io_linux(), Cons(StatEvent(StatPath(operand), result), events), after) {
    stat_path(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, operand, result, answer, events, then, after, m, rip,
        j(sym(regs.left), λ w _ => CStringAt(io_data_access(), IoMemory(file, page), w, operand), string(file.frame, page)),
        regs.right.left, regs.right.right.left, regs.right.right.right, argv)
}
// From `each`, one stretch of seven items to the lone dash's JE: the first
// byte against `-`, then the next against NUL. Its leaves are `path` (not a
// dash, or a dash and more) and `fd` (a lone dash); split by the operand's
// shape, so each byte the stretch reads is named.
theorem stat_each(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    operand: List<BitVec(8)>, pointer: BitVec(64), result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_each())),
    bound: pointer.toNat() + operand.len() + 1 <= Nat::pow(2, 47), string: ArgStays(file, pointer, operand),
    regs: EachRegs(pointer, rsp, k, ended, total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(stat_target(operand), result), events), state) {
    let io = io_linux();
    let data = io_data_access();
    let memory = IoMemory(file, page);
    let v = pointer.toNat();
    let source0 = λ (i: Nat) => data.read(memory, word_of_nat(64, v + i));
    let here0: (data.read(memory, pointer) = source0(0)) = read_here(file, page, source0, pointer, refl);
    match operand as λ o => ArgStays(file, pointer, o) → (v + o.len() + 1 <= Nat::pow(2, 47)) →
            LinuxRuns(io, Cons(StatEvent(stat_target(o), result), events), state) {
        Nil => λ whole low => stat_straight(file, at, placed, page, λ s => LinuxRuns(io, Cons(StatEvent(stat_target(Nil), result), events), s),
            runs_back(Cons(StatEvent(stat_target(Nil), result), events)), lw_lone_je(), refl, 7, state, rip_is, memory_is,
            Exists(nul(), Exists(pointer, ⟨regs.left, ⟨trans(here0, whole(file.frame, page)), ⟨bound_low(v, 0, low),
                ⟨λ _ after rip m same => each_path(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, Nil, pointer, result, answer,
                    events, then, whole, argv, after, trans(rip, stat_lands(at, lw_dash(), 6, tw_path(), wa(lw_path()), wj_dash_jne())), m,
                    j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), regs)),
                 λ passed => absurd(trans(cong_fn<Bool, Bool>(λ x => !x, sym(cmp_bytes(nul(), dash()))), passed))⟩⟩⟩⟩))),
        Cons(b0, tail) => λ whole bound0 => {
            let string0 = whole(file.frame, page);
            let cmp0 = cmp_bytes(b0, dash());
            let lows = bound_first(v, tail.len(), bound0);
            let a1 = pointer.add(one_byte().sign_extend(56));
            let rdi1: (a1.toNat() = Succ(v)) = pointer_next(pointer, v, refl, lows.right);
            let source1 = λ (i: Nat) => source0(Succ(i));
            let reads1: ReadsFrom(file, page, source1, a1.toNat()) =
                j(sym(rdi1), λ w _ => ReadsFrom(file, page, source1, w), reads_next(file, page, source0, v, λ i => refl));
            let here1: (data.read(memory, a1) = source1(0)) = read_here(file, page, source1, a1, reads1(0));
            let low1 = low_of(a1, Succ(v), rdi1, lows.right);
            let base1: (read_gpr(Rsi, state.gprs).add(one_byte().sign_extend(56)) = a1) =
                cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(one_byte().sign_extend(56)), regs.left);
            (match tail as λ t => ArgStays(file, pointer, Cons(b0, t)) → CStringFrom(t, source1) →
                    LinuxRuns(io, Cons(StatEvent(stat_target(Cons(b0, t)), result), events), state) {
                Nil => λ stays end => stat_straight(file, at, placed, page, λ s => LinuxRuns(io, Cons(StatEvent(stat_target([b0]), result), events), s),
                    runs_back(Cons(StatEvent(stat_target([b0]), result), events)), lw_lone_je(), refl, 7, state, rip_is, memory_is,
                    Exists(b0, Exists(pointer, ⟨regs.left, ⟨trans(here0, string0.left), ⟨lows.left,
                        ⟨λ taken after rip m same => {
                            let no = not_true_is(b0.eq_bit(dash()), trans(cong_fn<Bool, Bool>(λ x => !x, sym(cmp0)), taken));
                            j(sym(target_not_dash(b0, Nil, no)), λ t _ => LinuxRuns(io, Cons(StatEvent(t, result), events), after),
                                each_path(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, [b0], pointer, result, answer,
                                    events, then, stays, argv, after, trans(rip, stat_lands(at, lw_dash(), 6, tw_path(), wa(lw_path()), wj_dash_jne())), m,
                                    j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), regs)))
                        },
                         λ passed => Exists(nul(), Exists(a1, ⟨base1, ⟨trans(here1, end), ⟨low1,
                            ⟨λ _ after rip m same => {
                                let yes = not_false_is(b0.eq_bit(dash()), trans(cong_fn<Bool, Bool>(λ x => !x, sym(cmp0)), passed));
                                let r = j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), regs);
                                j(sym(target_lone_dash(b0, yes)), λ t _ => LinuxRuns(io, Cons(StatEvent(t, result), events), after),
                                    stat_fd(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, result, answer, events, then,
                                        after, m, trans(rip, stat_lands_back(at, lw_ahead_nul(), 6, tw_fd(), wa(lw_fd()), wj_lone_je())),
                                        r.right.left, r.right.right.left, r.right.right.right, argv))
                            },
                             λ passed2 => absurd(trans(sym(passed2), cmp_bytes(nul(), nul())))⟩⟩⟩⟩))⟩⟩⟩⟩))),
                Cons(b1, rest) => λ stays more => stat_straight(file, at, placed, page,
                    λ s => LinuxRuns(io, Cons(StatEvent(stat_target(Cons(b0, Cons(b1, rest))), result), events), s),
                    runs_back(Cons(StatEvent(stat_target(Cons(b0, Cons(b1, rest))), result), events)), lw_lone_je(), refl, 7, state, rip_is, memory_is,
                    Exists(b0, Exists(pointer, ⟨regs.left, ⟨trans(here0, string0.left), ⟨lows.left,
                        ⟨λ _ after rip m same => each_path(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, Cons(b0, Cons(b1, rest)),
                            pointer, result, answer, events, then, stays, argv, after,
                            trans(rip, stat_lands(at, lw_dash(), 6, tw_path(), wa(lw_path()), wj_dash_jne())), m,
                            j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), regs)),
                         λ _ => Exists(b1, Exists(a1, ⟨base1, ⟨trans(here1, more.left), ⟨low1,
                            ⟨λ taken2 => absurd(trans(sym(taken2), trans(cmp_bytes(b1, nul()), not_nul(b1, more.right.left)))),
                             λ _ after rip m same => each_path(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other,
                                Cons(b0, Cons(b1, rest)), pointer, result, answer, events, then, stays, argv, after, rip, m,
                                j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), regs))⟩⟩⟩⟩))⟩⟩⟩⟩))),
            })(whole, string0.right.right)
        },
    }(string, bound)
}
// An operand: classify it, and stat it. The operand test to its JNE (two
// items; `each` is ahead), then `stat_each`.
theorem stat_operand(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    operand: List<BitVec(8)>, pointer: BitVec(64), result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_operand())),
    rsi: read_gpr(Rsi, state.gprs) = pointer, positive: 0 < pointer.toNat(), bound: pointer.toNat() + operand.len() + 1 <= Nat::pow(2, 47),
    string: ArgStays(file, pointer, operand),
    rbx: read_gpr(Rbx, state.gprs) = argv_slot(rsp, k), r12: read_gpr(R12, state.gprs) = ended_word(ended),
    carried: StatCarried(total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(stat_target(operand), result), events), state) {
    let found: (execute_block_normal(scan_null_block(), state).flags.zf = False) =
        trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), rsi),
            trans(zero_bits_sub(64, pointer, word_zero()), nonzero_word(pointer, positive)));
    stat_straight(file, at, placed, page, λ s => LinuxRuns(io_linux(), Cons(StatEvent(stat_target(operand), result), events), s),
        runs_back(Cons(StatEvent(stat_target(operand), result), events)), lw_each_jne(), refl, 2, state, rip_is, memory_is,
        ⟨λ _ after rip m same => stat_each(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, operand, pointer, result, answer,
            events, then, after, m, trans(rip, stat_lands(at, lw_operand(), 6, tw_each(), wa(lw_each()), wj_each_jne())), bound, string,
            j(sym(same), λ s _ => EachRegs(pointer, rsp, k, ended, total, other, origin, s.gprs), ⟨rsi, ⟨rbx, ⟨r12, carried⟩⟩⟩), argv),
         λ passed after rip m same => absurd(trans(cong_fn<Bool, Bool>(λ x => !x, sym(found)), passed))⟩)
}

// No operand at all: stdin once, then the width.
theorem stat_stdin(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool,
    result: StatResult, answer: StatAnswer(result), events: List<LinuxEvent>,
    then: StatNext(file, at, rsp, origin, k, ended, args, pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), events),
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = next_rip(at, wa(lw_operand())),
    rsi: read_gpr(Rsi, state.gprs) = word_zero(), r15: read_gpr(R15, state.gprs) = ended_word(False),
    rbx: read_gpr(Rbx, state.gprs) = argv_slot(rsp, k), r12: read_gpr(R12, state.gprs) = ended_word(ended),
    carried: StatCarried(total, other, origin, state.gprs), argv: ArgvStays(file, rsp, args, pointers, k)):
    LinuxRuns(io_linux(), Cons(StatEvent(StatFd(word_zero()), result), events), state) {
    let piece = stat_pieces(file, at, placed);
    let fetch = io_fetch_access();
    let data = io_data_access();
    let tested = run_block(file, page, scan_null_block(), at, wa(lw_operand()), piece(lw_operand()), state, memory_is, rip_is);
    let s1 = execute_block_normal(scan_null_block(), state);
    let passed = run_near(file, page, JumpIfNear(NE, wd(lw_each_jne())), at, wa(lw_each_jne()), piece(lw_each_jne()), s1, tested.memory_is, tested.rip_is);
    let s2 = execute_near_control(JumpIfNear(NE, wd(lw_each_jne())), s1);
    let none: (s1.flags.zf = True) = trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), rsi),
        zero_bits_sub_self(64, word_zero()));
    let s2_rip = jcc_passed(NE, wd(lw_each_jne()), s1, at, wa(lw_each_jne()), tested.rip_is, ne_fails(s1.flags, none));
    let made = run_block(file, page, stat_made_block(), at, wa(lw_made()), piece(lw_made()), s2, tested.memory_is, s2_rip);
    let s3 = execute_block_normal(stat_made_block(), s2);
    let passed2 = run_near(file, page, JumpIfNear(NE, wd(lw_made_jne())), at, wa(lw_made_jne()), piece(lw_made_jne()), s3, made.memory_is, made.rip_is);
    let s4 = execute_near_control(JumpIfNear(NE, wd(lw_made_jne())), s3);
    let first: (s3.flags.zf = True) = trans(cong_fn<BitVec(64), Bool>(λ a => is_zero_bits(64, a.sub(word_zero())), r15), ended_flag(False));
    let s4_rip = jcc_passed(NE, wd(lw_made_jne()), s3, at, wa(lw_made_jne()), made.rip_is, ne_fails(s3.flags, first));
    linux_runs_after_steps(io_linux(), Cons(StatEvent(StatFd(word_zero()), result), events), state, s4,
        fetched_steps_trans(fetch, data, state, s1, s4, tested.steps, fetched_steps_trans(fetch, data, s1, s2, s4, passed,
            fetched_steps_trans(fetch, data, s2, s3, s4, made.steps, passed2))),
        stat_fd(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, result, answer, events, then, s4, made.memory_is,
            s4_rip, rbx, r12, carried, argv))
}

// ---------------------------------------------------------------------------
// The pass, operand by operand.

fn StatGoes(file: IoImage, at, rsp: BitVec(64), origin: Gprs, after: List<LinuxEvent>, ops: List<List<BitVec(8)>>) → Type {
    (made: Bool) → (total: BitVec(64)) → (other: Bool) → (results: List<StatResult>) → StatsFit(targets_from(made, ops), results) →
    StatThen(file, at, origin, width_from(total, other, results.map(stat_seen)), after) →
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
    (pointers: List<BitVec(64)>) → operands_from(ended, args) = ops →
    StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, made, state) →
    LinuxRuns(io_linux(), stat_events(targets_from(made, ops), results) ++ after, state)
}

// The cursor from `next`, its operands those still to stat.
theorem stat_cursor(file: IoImage, page: Nat → BitVec(8), at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs,
    k: Nat, ended: Bool, args: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, total: BitVec(64), other: Bool, made: Bool,
    ops: List<List<BitVec(8)>>, left: operands_from(ended, args) = ops, state: MachineState<IoMemory>,
    head: StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, made, state)):
    CursorReach(file, page, next_rip(at, wa(lw_next())), rsp, state.gprs, ops, state) {
    let piece = stat_pieces(file, at, placed);
    j(left, λ o _ => CursorReach(file, page, next_rip(at, wa(lw_next())), rsp, state.gprs, o, state),
        cursor_runs(file, next_rip(at, wa(lw_next())), piece(lw_next()), page, rsp, k, ended, args, pointers, state.gprs, state, head.argv,
            CursorAt(memory_is := head.memory_is, rip_is := head.rip_is, regs := ⟨head.rbx, ⟨head.r12, cursor_kept_refl(state.gprs)⟩⟩)))
}

theorem stat_loop(file: IoImage, at: BitVec(64), placed: Placed(file, stat_code(), at), rsp: BitVec(64), origin: Gprs, after: List<LinuxEvent>,
    ops: List<List<BitVec(8)>>): StatGoes(file, at, rsp, origin, after, ops) {
    let io = io_linux();
    match ops as λ o => StatGoes(file, at, rsp, origin, after, o) {
        Nil => λ made => match made as λ m => (total: BitVec(64)) → (other: Bool) → (results: List<StatResult>) →
                StatsFit(targets_from(m, Nil), results) → StatThen(file, at, origin, width_from(total, other, results.map(stat_seen)), after) →
                (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
                (pointers: List<BitVec(64)>) → operands_from(ended, args) = Nil →
                StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, m, state) →
                LinuxRuns(io, stat_events(targets_from(m, Nil), results) ++ after, state) {
            True => λ total other results => match results as λ rs => StatsFit(Nil, rs) →
                    StatThen(file, at, origin, width_from(total, other, rs.map(stat_seen)), after) →
                    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
                    (pointers: List<BitVec(64)>) → operands_from(ended, args) = Nil →
                    StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, True, state) →
                    LinuxRuns(io, stat_events(Nil, rs) ++ after, state) {
                Nil => λ _ then page state k ended args pointers left head =>
                    stat_end_runs(file, page, at, placed, rsp, origin, after, k, ended, args, pointers, total, other, then, state, left, head),
                Cons(_, _) => λ never => false_elim(never),
            },
            False => λ total other results => match results as λ rs => StatsFit([StatFd(word_zero())], rs) →
                    StatThen(file, at, origin, width_from(total, other, rs.map(stat_seen)), after) →
                    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
                    (pointers: List<BitVec(64)>) → operands_from(ended, args) = Nil →
                    StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, False, state) →
                    LinuxRuns(io, stat_events([StatFd(word_zero())], rs) ++ after, state) {
                Nil => λ never => false_elim(never),
                Cons(result, more) => match more as λ m => StatsFit([StatFd(word_zero())], Cons(result, m)) →
                        StatThen(file, at, origin, width_from(total, other, Cons(result, m).map(stat_seen)), after) →
                        (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
                        (pointers: List<BitVec(64)>) → operands_from(ended, args) = Nil →
                        StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, False, state) →
                        LinuxRuns(io, stat_events([StatFd(word_zero())], Cons(result, m)) ++ after, state) {
                    Cons(_, _) => λ fit => false_elim(fit.right),
                    Nil => λ fit then page state k ended args pointers left head => {
                        have reach = stat_cursor(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, False, Nil, left, state, head);
                        let s1 = reach.witness;
                        let out = reach.proof.right;
                        let rest = out.right;
                        let s1_rip: (s1.rip = next_rip(at, wa(lw_operand()))) = trans(rest.rip_is, rip_compose(at, wa(lw_next()), cursor_len()));
                        let carried = carried_cursor(total, other, origin, s1.gprs, state.gprs, rest.regs.right.right, head.carried);
                        let r15: (read_gpr(R15, s1.gprs) = ended_word(False)) =
                            trans(rest.regs.right.right.right.right.right.right.right.right.right.right.right, head.r15);
                        linux_runs_after_linux_steps(io, Cons(StatEvent(StatFd(word_zero()), result), after), state, s1, reach.proof.left,
                            stat_stdin(file, page, at, placed, rsp, origin, rest.k, rest.ended, rest.args, rest.pointers, total, other, result, fit.left,
                                after,
                                λ page2 state2 head2 => stat_end_runs(file, page2, at, placed, rsp, origin, after, rest.k, rest.ended, rest.args,
                                    rest.pointers, total_after(total, stat_seen(result)), other_after(other, stat_seen(result)), then, state2, rest.left,
                                    head2),
                                s1, rest.memory_is, s1_rip, out.left, r15, rest.regs.left, rest.regs.right.left, carried, rest.argv))
                    },
                },
            },
        },
        Cons(operand, more) => λ made total other results => match results as λ rs => StatsFit(targets_from(made, Cons(operand, more)), rs) →
                StatThen(file, at, origin, width_from(total, other, rs.map(stat_seen)), after) →
                (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → (k: Nat) → (ended: Bool) → (args: List<List<BitVec(8)>>) →
                (pointers: List<BitVec(64)>) → operands_from(ended, args) = Cons(operand, more) →
                StatAt(file, page, at, rsp, origin, k, ended, args, pointers, total, other, made, state) →
                LinuxRuns(io, stat_events(targets_from(made, Cons(operand, more)), rs) ++ after, state) {
            Nil => λ never => false_elim(never),
            Cons(result, rs) => λ fit then page state k ended args pointers left head => {
                have reach = stat_cursor(file, page, at, placed, rsp, origin, k, ended, args, pointers, total, other, made, Cons(operand, more),
                    left, state, head);
                let s1 = reach.witness;
                let found = reach.proof.right;
                let facts = found.proof;
                let rest = facts.right.right.right.right;
                let s1_rip: (s1.rip = next_rip(at, wa(lw_operand()))) = trans(rest.rip_is, rip_compose(at, wa(lw_next()), cursor_len()));
                let carried = carried_cursor(total, other, origin, s1.gprs, state.gprs, rest.regs.right.right, head.carried);
                linux_runs_after_linux_steps(io, Cons(StatEvent(stat_target(operand), result), stat_events(targets_from(True, more), rs) ++ after), state, s1,
                    reach.proof.left,
                    stat_operand(file, page, at, placed, rsp, origin, rest.k, rest.ended, rest.args, rest.pointers, total, other, operand,
                        found.witness, result, fit.left, stat_events(targets_from(True, more), rs) ++ after,
                        λ page2 state2 head2 => stat_loop(file, at, placed, rsp, origin, after, more, True, total_after(total, stat_seen(result)),
                            other_after(other, stat_seen(result)), rs, fit.right, then, page2, state2, rest.k, rest.ended, rest.args, rest.pointers,
                            rest.left, head2),
                        s1, rest.memory_is, s1_rip, facts.left, facts.right.left, facts.right.right.left, facts.right.right.right.left,
                        rest.regs.left, rest.regs.right.left, carried, rest.argv))
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The claim.

// Placed anywhere in the file and entered with RSP at a command line whose
// pointers stay put, the pass stats each operand `parse_args` would give (or
// stdin once), in order, whatever Linux answers, and goes on with RSI the
// width `stat_width` gives of the answers, RSP, RBP, R8 and R9 kept.
theorem stat_runs(file: IoImage, at: BitVec(64), placed: Placed(file, stat_code(), at), page: Nat → BitVec(8),
    argv: List<List<BitVec(8)>>, pointers: List<BitVec(64)>, results: List<StatResult>,
    fit: StatsFit(stat_targets(operands_from(False, command_args(argv))), results), after: List<LinuxEvent>,
    state: MachineState<IoMemory>, memory_is: state.memory = IoMemory(file, page), rip_is: state.rip = at,
    stays: ArgvStaysAt(file, read_gpr(Rsp, state.gprs), argv, pointers),
    then: StatThen(file, at, state.gprs, stat_width(results.map(stat_seen)), after)):
    LinuxRuns(io_linux(), stat_events(stat_targets(operands_from(False, command_args(argv))), results) ++ after, state) {
    let piece = stat_pieces(file, at, placed);
    let rsp = read_gpr(Rsp, state.gprs);
    let origin = state.gprs;
    have started = cursor_start(file, at, piece(lw_start()), page, argv, pointers, state, memory_is, rip_is, stays);
    let s1 = started.witness;
    let so = started.proof.right;
    let set = run_block(file, page, stat_init_block(), at, wa(lw_init()), piece(lw_init()), s1, so.memory_is, so.rip_is);
    let s2 = execute_block_normal(stat_init_block(), s1);
    let kept = so.regs.right.right;
    let head: StatAt(file, page, at, rsp, origin, so.k, False, command_args(argv), so.pointers, BitVec::zero(), False, False, s2) =
        StatAt(memory_is := set.memory_is, rip_is := set.rip_is, rbx := so.regs.left, r12 := so.regs.right.left, r15 := refl,
            carried := ⟨refl, ⟨refl, ⟨kept.left, ⟨kept.right.left, ⟨kept.right.right.right.right.left, kept.right.right.right.right.right.left⟩⟩⟩⟩⟩,
            argv := so.argv);
    linux_runs_after_linux_steps(io_linux(), stat_events(stat_targets(operands_from(False, command_args(argv))), results) ++ after, state, s2,
        linux_steps_trans(io_linux(), state, s1, s2, started.proof.left, linux_steps_of_fetched(io_linux(), s1, s2, set.steps)),
        stat_loop(file, at, placed, rsp, origin, after, operands_from(False, command_args(argv)), False, BitVec::zero(), False, results, fit, then,
            page, s2, so.k, False, command_args(argv), so.pointers, refl, head))
}

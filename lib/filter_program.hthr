// A program as the read profile takes it (docs/native-stream-filter-design.md
// §2): a stream filter. A step folds a state over stdin and emits at most one
// byte per byte; at end of file the finish prints from the final state; and
// `spec` is the whole of stdout. It is checked when its module is, so a
// program that is wrong is refused at its own source. The data are the
// record's parameters, so the CLI reads them off its type. A module of its
// own because a bundle's defaults run tactics, whose certificates name
// `omega`, and because the finishes' meanings are the formatters'.
import stream_filter;
import function_ir_loop;
import decimal_line;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// What a program prints after end of file: nothing, or its first count as a
// decimal line. Each is one of the
// library's proved tails, which read the counts from the state's first
// registers. The counts are the program's own (`Filter`'s `counts`), named
// once there.
inductive Finish { Quiet, Line }
fn finish_bytes<C>(finish: Finish, counts: List<C → Nat>, state: C) → List<BitVec(8)> {
    match finish {
        Quiet => Nil,
        Line => match counts { Nil => Nil, Cons(count, _) => decimal_line(count(state)) },
    }
}
// What the tails print correctly: counts below their columns.
fn FinishFits<C>(finish: Finish, counts: List<C → Nat>, state: C) → Type {
    match finish {
        Quiet => True,
        Line => match counts { Nil => True, Cons(count, _) => count(state) < 10000 },
    }
}

// All of stdout: what the bytes emit from `init`, then the finish.
fn filter_output<C>(step: C → BitVec(8) → Filtered<C>, init: C, counts: List<C → Nat>, finish: Finish, bytes: List<BitVec(8)>) → List<BitVec(8)> {
    filter_emitted(step, bytes, init) ++ finish_bytes(finish, counts, filter_state(step, bytes, init))
}

// A program: the step from `init`, whose Nat fields are `counts` in order, and
// its finish; `spec` says what stdout is. Each count grows by at most one per
// byte, so it fits a word for any input a process can read: case analysis
// and `omega` show it for the usual step, and a program that needs more gives
// `advances := …` itself. A counting program proves `computes` from one fact
// per printed count (`line_computes` below).
record Filter<C>(step: C → BitVec(8) → Filtered<C>, init: C, counts: List<C → Nat>, finish: Finish,
    spec: List<BitVec(8)> → List<BitVec(8)>) {
    advances: (state: C) → (byte: BitVec(8)) → counts_advance(counts, step(state, byte).next, state) := { split_all; all_goals { omega } },
    computes: (bytes: List<BitVec(8)>) → spec(bytes) = filter_output(step, init, counts, finish, bytes),
}

// ---------------------------------------------------------------------------
// A command (docs/native-wc-command-design.md §3.2): the step folded over each
// operand in turn, printing a row of the columns the command line selects.
// A column is the option letter that selects it, the state's count it
// prints, and what that count means over an input; `default` says which
// columns print when no option selects one. The command's process
// (elf64_command) prints at most eight columns, from the state's first four
// fields.
record Column<C> { letter: BitVec(8), count: C → Nat, means: List<BitVec(8)> → Nat }

// Each column's count of the state an input folds to is what it means.
fn ColumnsMean<C>(columns: List<Column<C>>, input: List<BitVec(8)>, state: C) → Type {
    match columns { Nil => True, Cons(column, rest) => (column.means(input) = column.count(state)) ∧ ColumnsMean(rest, input, state) }
}
// What column `i` means; nothing past the columns.
fn column_means<C>(columns: List<Column<C>>, i: Nat) → List<BitVec(8)> → Nat {
    match columns { Nil => λ _ => 0, Cons(column, rest) => match i { Zero => column.means, Succ(k) => column_means(rest, k) } }
}

// A command: the step from `init`, whose Nat fields are `counts` in order, and
// the columns it prints. Each count grows by at most one per byte, as a
// filter's; `computes` is the program's own proof that its columns count
// what they mean.
record Command<C>(step: C → BitVec(8) → Filtered<C>, init: C, counts: List<C → Nat>, columns: List<Column<C>>, default: List<Bool>) {
    advances: (state: C) → (byte: BitVec(8)) → counts_advance(counts, step(state, byte).next, state) := { split_all; all_goals { omega } },
    computes: (input: List<BitVec(8)>) → ColumnsMean(columns, input, filter_state(step, input, init)),
}

// A counting step's columns, from what they mean of its fold.
theorem counting_columns<C>(g: C → BitVec(8) → C, init: C, columns: List<Column<C>>,
    folded: (input: List<BitVec(8)>) → ColumnsMean(columns, input, fold_bytes(g, input, init))):
    (input: List<BitVec(8)>) → ColumnsMean(columns, input, filter_state(counting(g), input, init)) {
    λ input => j(sym(counting_state(g, input, init)), λ s _ => ColumnsMean(columns, input, s), folded(input))
}

// A step that only counts prints the finish of its fold and nothing else.
theorem counting_output<C>(g: C → BitVec(8) → C, init: C, counts: List<C → Nat>, finish: Finish, bytes: List<BitVec(8)>):
    filter_output(counting(g), init, counts, finish, bytes) = finish_bytes(finish, counts, fold_bytes(g, bytes, init)) {
    trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ e => e ++ finish_bytes(finish, counts, filter_state(counting(g), bytes, init)),
            counting_emitted(g, bytes, init)),
        cong_fn<C, List<BitVec(8)>>(λ s => finish_bytes(finish, counts, s), counting_state(g, bytes, init)))
}
// A byte map prints the input's image.
theorem mapping_output(f: BitVec(8) → BitVec(8), bytes: List<BitVec(8)>):
    filter_output(mapping(f), Stateless(), Nil, Quiet, bytes) = bytes.map(f) {
    trans(List::append_nil(filter_emitted(mapping(f), bytes, Stateless())), mapping_emitted(f, bytes, Stateless()))
}

// A step that emits, one byte at a time, what `out` says from its state emits
// all of `out` (`tr -d`, `tr -s`): the program proves the one-byte equation,
// usually by `split_all`.
theorem emits_from<C>(step: C → BitVec(8) → Filtered<C>, out: C → List<BitVec(8)> → List<BitVec(8)>,
    nil: (s: C) → out(s, Nil) = Nil,
    cons: (s: C) → (b: BitVec(8)) → (rest: List<BitVec(8)>) → out(s, Cons(b, rest)) = emitted_byte(step(s, b).emit) ++ out(step(s, b).next, rest),
    bytes: List<BitVec(8)>): (s: C) → out(s, bytes) = filter_emitted(step, bytes, s) {
    match bytes {
        Nil => λ s => nil(s),
        Cons(b, rest) => λ s => trans(cons(s, b, rest), cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ tail => emitted_byte(step(s, b).emit) ++ tail,
            emits_from(step, out, nil, cons, rest, step(s, b).next))),
    }
}

// A program that prints nothing after end of file prints what `out` says
// from `init`.
theorem quiet_computes<C>(step: C → BitVec(8) → Filtered<C>, init: C, counts: List<C → Nat>, out: C → List<BitVec(8)> → List<BitVec(8)>,
    nil: (s: C) → out(s, Nil) = Nil,
    cons: (s: C) → (b: BitVec(8)) → (rest: List<BitVec(8)>) → out(s, Cons(b, rest)) = emitted_byte(step(s, b).emit) ++ out(step(s, b).next, rest)):
    (bytes: List<BitVec(8)>) → out(init, bytes) = filter_output(step, init, counts, Quiet, bytes) {
    λ bytes => trans(emits_from(step, out, nil, cons, bytes, init), sym(List::append_nil(filter_emitted(step, bytes, init))))
}

// ---------------------------------------------------------------------------
// What a counting step's fold computes, from what one byte does to a count
// (docs/native-programs-read-like-programs-design.md §3, S1). A program proves
// the per-byte fact, usually by `split_all`; these carry it over the input.

// A count field the step raises by one at each byte `p` holds of counts those
// bytes.
theorem counts_filtered<C>(g: C → BitVec(8) → C, field: C → Nat, p: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → field(g(s, b)) = field(s) + Nat::of_bit(p(b)), bytes: List<BitVec(8)>):
    (s: C) → field(fold_bytes(g, bytes, s)) = field(s) + bytes.count(p) {
    match bytes {
        Nil => λ s => refl,
        Cons(b, rest) => λ s => {
            let ih = counts_filtered(g, field, p, grows, rest, g(s, b));
            let grew = grows(s, b);
            let kept = List::count_cons(b, rest, p);
            let sum: (field(fold_bytes(g, rest, g(s, b))) = field(s) + Cons(b, rest).count(p)) = omega;
            sum
        },
    }
}

// A count the step raises by one at every byte counts the bytes.
theorem counts_len<C>(g: C → BitVec(8) → C, count: C → Nat,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = Succ(count(s)), bytes: List<BitVec(8)>):
    (s: C) → count(fold_bytes(g, bytes, s)) = count(s) + bytes.len() {
    match bytes {
        Nil => λ s => refl,
        Cons(b, rest) => λ s => {
            let ih = counts_len(g, count, grows, rest, g(s, b));
            let grew = grows(s, b);
            let sum: (count(fold_bytes(g, rest, g(s, b))) = count(s) + Succ(rest.len())) = omega;
            sum
        },
    }
}

// Runs: the non-empty pieces between separators, such as `wc`'s words.

// What a byte adds to a run count: one when it is not a separator and the
// state was not already in a run.
fn starts_run(cut, inside: Bool) → Nat { match cut { True => 0, False => match inside { True => 0, False => 1 } } }

fn runs_of<A>(pieces: List<List<A>>) → Nat { pieces.count(List::non_empty) }

// Whether the first piece is a run: the one a state already inside a run is
// in, and counted when it began.
fn first_run<A>(pieces: List<List<A>>) → Nat { match pieces { Nil => 0, Cons(piece, _) => Nat::of_bit(piece.non_empty()) } }
fn inside_runs<A>(inside: Bool, pieces: List<List<A>>) → Nat { match inside { True => first_run(pieces), False => 0 } }

theorem onto_first_runs<A>(x: A, pieces: List<List<A>>): runs_of(List::onto_first(x, pieces)) + first_run(pieces) = Succ(runs_of(pieces)) {
    match pieces as λ ps => runs_of(List::onto_first(x, ps)) + first_run(ps) = Succ(runs_of(ps)) {
        Nil => refl,
        Cons(piece, rest) => match piece as λ p => Succ(runs_of(rest)) + first_run(Cons(p, rest)) = Succ(runs_of(Cons(p, rest))) {
            Nil => refl, Cons(_, _) => refl,
        },
    }
}
theorem onto_first_starts<A>(x: A, pieces: List<List<A>>): first_run(List::onto_first(x, pieces)) = 1 {
    match pieces as λ ps => first_run(List::onto_first(x, ps)) = 1 { Nil => refl, Cons(_, _) => refl }
}

// One byte: what the count and the flag do, against what the pieces count and
// start with.
theorem runs_one<A>(x: A, pieces: List<List<A>>, total, before: Nat): (cut, inside: Bool) →
    (total + inside_runs(!cut, pieces) = (before + starts_run(cut, inside)) + runs_of(pieces)) →
    total + inside_runs(inside, List::split_onto(cut, x, pieces)) = before + runs_of(List::split_onto(cut, x, pieces)) {
    split_all;
    all_goals {
        let joined = onto_first_runs(x, pieces);
        let starts = onto_first_starts(x, pieces);
        let empty: (runs_of(Cons(Nil, pieces)) = runs_of(pieces)) = refl;
        omega
    }
}

// A count the step raises at each run's first byte, beside a flag saying
// whether the state is in a run, counts the runs, less the first when the
// state starts inside it.
theorem counts_runs<C>(g: C → BitVec(8) → C, count: C → Nat, inside: C → Bool, sep: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = count(s) + starts_run(sep(b), inside(s)),
    flag: (s: C) → (b: BitVec(8)) → inside(g(s, b)) = !sep(b), bytes: List<BitVec(8)>):
    (s: C) → count(fold_bytes(g, bytes, s)) + inside_runs(inside(s), bytes.split_by(sep)) = count(s) + runs_of(bytes.split_by(sep)) {
    match bytes {
        Nil => λ s => match inside(s) as λ i => count(s) + inside_runs(i, Cons(Nil<BitVec(8)>, Nil)) = count(s) + 0 { True => refl, False => refl },
        Cons(b, rest) => λ s => {
            let ih = counts_runs(g, count, inside, sep, grows, flag, rest, g(s, b));
            let flagged = j(flag(s, b), λ i _ => count(fold_bytes(g, rest, g(s, b))) + inside_runs(i, rest.split_by(sep)) =
                count(g(s, b)) + runs_of(rest.split_by(sep)), ih);
            let grown = j(grows(s, b), λ n _ => count(fold_bytes(g, rest, g(s, b))) + inside_runs(!sep(b), rest.split_by(sep)) =
                n + runs_of(rest.split_by(sep)), flagged);
            runs_one(b, rest.split_by(sep), count(fold_bytes(g, rest, g(s, b))), count(s), sep(b), inside(s), grown)
        },
    }
}

// What an author calls: from a state whose count is zero (and, for runs,
// outside a run), the fold's count is what the count means, in the shape
// `line_computes` and a command's columns take.
theorem fold_counts_filtered<C>(g: C → BitVec(8) → C, field: C → Nat, p: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → field(g(s, b)) = field(s) + Nat::of_bit(p(b)), init: C, zero: field(init) = 0):
    (bytes: List<BitVec(8)>) → bytes.count(p) = field(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let counted = counts_filtered(g, field, p, grows, bytes, init);
        omega
    }
}

theorem fold_counts_len<C>(g: C → BitVec(8) → C, count: C → Nat,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = Succ(count(s)), init: C, zero: count(init) = 0):
    (bytes: List<BitVec(8)>) → bytes.len() = count(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let counted = counts_len(g, count, grows, bytes, init);
        omega
    }
}

theorem fold_counts_runs<C>(g: C → BitVec(8) → C, count: C → Nat, inside: C → Bool, sep: BitVec(8) → Bool,
    grows: (s: C) → (b: BitVec(8)) → count(g(s, b)) = count(s) + starts_run(sep(b), inside(s)),
    flag: (s: C) → (b: BitVec(8)) → inside(g(s, b)) = !sep(b), init: C, zero: count(init) = 0, outside: inside(init) = False):
    (bytes: List<BitVec(8)>) → runs_of(bytes.split_by(sep)) = count(fold_bytes(g, bytes, init)) {
    λ bytes => {
        let all = counts_runs(g, count, inside, sep, grows, flag, bytes, init);
        let none: (inside_runs(inside(init), bytes.split_by(sep)) = 0) = j(sym(outside), λ i _ => inside_runs(i, bytes.split_by(sep)) = 0, refl);
        omega
    }
}

// ---------------------------------------------------------------------------
// What a counting program prints, from one fact per printed count.

// A program that prints its first count as a line prints the line of what that
// count means.
theorem line_computes<C>(g: C → BitVec(8) → C, init: C, count: C → Nat, rest: List<C → Nat>, means: List<BitVec(8)> → Nat,
    counted: (bytes: List<BitVec(8)>) → means(bytes) = count(fold_bytes(g, bytes, init))):
    (bytes: List<BitVec(8)>) → decimal_line(means(bytes)) = filter_output(counting(g), init, Cons(count, rest), Line, bytes) {
    λ bytes => trans(cong_fn<Nat, List<BitVec(8)>>(λ n => decimal_line(n), counted(bytes)),
        sym(counting_output(g, init, Cons(count, rest), Line, bytes)))
}

// Straight label code over a program's own memory, computed: the frame-free
// counterpart of `Straight` (elf64_straight), for the process libraries,
// which run wherever a program places them and keep no frame
// (docs/native-straight-runs-design.md).
//
// `Stretch(…, goal, labels, l, n)(page, state)` reads the `n` items ending at
// label `l` off the program and states, in their order, what running them
// from `state` comes to, the memory `IoMemory(file, page)` throughout: each
// block's, load's and byte store's state is the item's own result over the
// one before it, a JCC is two obligations, one per value of its condition,
// and a taken JCC or a JMP ends the stretch at its target, where the leaf
// asks for `goal` (`StretchLeaf`). A word or byte load names its value and
// address (`WordThen`, `ByteAt`), a byte store its offset in the page
// (`PageThen`). `stretch_runs` proves `goal` of the start from that type.
// What the elaborator computes and what it leaves to `refl` is as for
// `Straight`; an item a stretch cannot run (a syscall, a piece, a word
// store, a hole) leaves `False`.
import elf64_arg_scan;
import elf64_format_width;
import elf64_runs;
import elf64_io;
import linux_x86_64_io;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_access_memory;
import x86_64_layout;
import x86_64_asm;
import x86_64_store;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// What a stretch proves: `goal` of its start, from `goal` of where it ends,
// given that steps lead there (`back`). The process's `LinuxRuns` is one
// (`runs_back`); a record of where a phase ends is another.
fn StepsBack(goal: MachineState<IoMemory> → Type) → Type {
    (before, after: MachineState<IoMemory>) → LinuxSteps(io_linux(), before, after) → goal(after) → goal(before)
}
theorem runs_back(events: List<LinuxEvent>): StepsBack(λ s => LinuxRuns(io_linux(), events, s)) {
    λ before after steps runs => linux_runs_after_linux_steps(io_linux(), events, before, after, steps, runs)
}
theorem back_fetched(goal: MachineState<IoMemory> → Type, back: StepsBack(goal), before, after: MachineState<IoMemory>,
    steps: FetchedSteps(io_fetch_access(), io_data_access(), before, after), reached: goal(after)): goal(before) {
    back(before, after, linux_steps_of_fetched(io_linux(), before, after, steps), reached)
}

// A byte store's place in the page: the caller names its offset `c`, the
// base register's value is the page's address there.
fn PageThen(base: BitVec(64), then: Nat → Type) → Type {
    Exists<Nat>(λ c => (c < 4096) ∧ ((base.toNat() = io_page_base() + c) ∧ then(c)))
}
// The page with byte `x` stored at offset `c`: `io_store_offset`'s, which
// reads no image.
fn page_stored(file: IoImage, page: Nat → BitVec(8), c: Nat, x: BitVec(8)) → Nat → BitVec(8) {
    io_store_offset(IoMemory(file, page), c, [x]).page
}
// Where the `n` items ending at `l` start.
fn straight_from(l: Prog, n: Nat) → Nat {
    match n { Zero => prog_len(l), Succ(m) => match l { Start => 0, At(before, _, _) => straight_from(before, m) } }
}

// ---------------------------------------------------------------------------
// The computation.

// Where a stretch ends, at `at`: the rest of the process, the end state
// handed over bound (`after`), `same` saying which it is.
fn StretchLeaf(file: IoImage, goal: MachineState<IoMemory> → Type, at: BitVec(64)) → (Nat → BitVec(8)) → MachineState<IoMemory> → Type {
    λ page state => (after: MachineState<IoMemory>) → after.rip = at → after.memory = IoMemory(file, page) → after = state → goal(after)
}
// A word load's word: the caller names it and its address `a` (the base
// register's value, `refl` where a block before set it).
fn WordThen(file: IoImage, page: Nat → BitVec(8), base: BitVec(64), then: BitVec(64) → Type) → Type {
    Exists<BitVec(64)>(λ word => Exists<BitVec(64)>(λ a => (base = a) ∧ (WordAt(io_data_access(), IoMemory(file, page), a, word) ∧ then(word))))
}
// A byte load's byte, the same way, below the canonical boundary.
fn ByteAt(file: IoImage, page: Nat → BitVec(8), base: BitVec(64), then: BitVec(8) → Type) → Type {
    Exists<BitVec(8)>(λ byte => Exists<BitVec(64)>(λ a => (base = a) ∧
        ((io_data_access().read(IoMemory(file, page), a) = Some(byte)) ∧ ((a.toNat() < Nat::pow(2, 47)) ∧ then(byte)))))
}
// The item at `here`, then what follows it (`then`).
fn stretch_item(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, labels: Nat → Nat, here: Nat, item: Asm,
    then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type) → (Nat → BitVec(8)) → MachineState<IoMemory> → Type {
    match item {
        Block(instructions) => λ page state => then(page, execute_block_normal(instructions, state)),
        Jcc(cc, target) => λ page state =>
            ((condition_holds(cc, state.flags) = True) → StretchLeaf(file, goal, near_branch_target(next_rip(origin, here), 6,
                near_rel(here + 6, labels(target))))(page, execute_near_control(JumpIfNear(cc, near_rel(here + 6, labels(target))), state))) ∧
            ((condition_holds(cc, state.flags) = False) → then(page, execute_near_control(JumpIfNear(cc, near_rel(here + 6, labels(target))), state))),
        Jmp(target) => λ page state => StretchLeaf(file, goal, near_branch_target(next_rip(origin, here), 5, near_rel(here + 5, labels(target))))(page,
            execute_near_control(JumpNear(near_rel(here + 5, labels(target))), state)),
        Load(load) => λ page state => WordThen(file, page, read_gpr(load.base, state.gprs), λ word => then(page, word_load_after(load, word, state))),
        LoadByte(load) => λ page state => ByteAt(file, page, read_gpr(load.base, state.gprs), λ byte => then(page, byte_load_after(load, byte, state))),
        StoreByte(store) => λ page state => match store_base_plain(store.base) {
            True => PageThen(read_gpr(store.base, state.gprs), λ c =>
                then(page_stored(file, page, c, imm_byte0(read_gpr(store.source, state.gprs))), byte_store_after(linux_writes(io_linux()), store, state))),
            False => False,
        },
        _ => λ _ _ => False,
    }
}
// The `n` items ending at label `l`, then `then`.
fn stretch_run(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, labels: Nat → Nat, l: Prog, n: Nat,
    then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type) → (Nat → BitVec(8)) → MachineState<IoMemory> → Type {
    match n {
        Zero => then,
        Succ(m) => match l {
            Start => then,
            At(before, _, item) => stretch_run(file, origin, goal, labels, before, m, stretch_item(file, origin, goal, labels, prog_len(before), item, then)),
        },
    }
}
// What the stretch needs: its items, each leaf the rest of the process.
fn Stretch(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, labels: Nat → Nat, l: Prog, n: Nat)
    → (Nat → BitVec(8)) → MachineState<IoMemory> → Type {
    stretch_run(file, origin, goal, labels, l, n, StretchLeaf(file, goal, next_rip(origin, prog_len(l))))
}

// ---------------------------------------------------------------------------
// The proof.

// From a state at `at` over the page that meets `then`, the process runs.
fn StretchGoes(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, at: Nat,
    then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type) → Type {
    (page: Nat → BitVec(8)) → (state: MachineState<IoMemory>) → state.rip = next_rip(origin, at) → state.memory = IoMemory(file, page) →
        then(page, state) → goal(state)
}
// One item, resident at `here`, then what follows.
theorem stretch_item_goes(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, back: StepsBack(goal), fills: Nat → List<BitVec(8)>,
    labels: Nat → Nat, here: Nat, item: Asm, then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type):
    Placed(file, asm_bytes(fills, labels, here, item), next_rip(origin, here)) →
    StretchGoes(file, origin, goal, here + asm_len(item), then) →
    StretchGoes(file, origin, goal, here, stretch_item(file, origin, goal, labels, here, item, then)) {
    let io = io_linux();
    let fetch = io_fetch_access();
    let data = io_data_access();
    match item as λ it => Placed(file, asm_bytes(fills, labels, here, it), next_rip(origin, here)) →
            StretchGoes(file, origin, goal, here + asm_len(it), then) →
            StretchGoes(file, origin, goal, here, stretch_item(file, origin, goal, labels, here, it, then)) {
        Block(instructions) => λ code goes page state rip memory_is held => {
            let ran = run_block(file, page, instructions, origin, here, code, state, memory_is, rip);
            let after = execute_block_normal(instructions, state);
            let after_rip: (after.rip = next_rip(origin, here + block_length(instructions))) =
                trans(ran.rip_is, rip_count(origin, cong_fn<Nat, Nat>(λ k => here + k, block_length_is(instructions))));
            back_fetched(goal, back, state, after, ran.steps, goes(page, after, after_rip, ran.memory_is, held))
        },
        Code(_) => λ _ _ page state rip memory_is never => false_elim(never),
        Load(load) => λ code goes page state rip memory_is held => {
            let word = held.witness;
            let named = held.proof.proof;
            let loaded = run_word_load(file, page, load, origin, here, code, state, memory_is, rip, word,
                j(sym(named.left), λ a _ => WordAt(data, IoMemory(file, page), a, word), named.right.left));
            let after = word_load_after(load, word, state);
            back_fetched(goal, back, state, after, loaded.steps, goes(page, after, loaded.rip_is, loaded.memory_is, named.right.right))
        },
        LoadByte(load) => λ code goes page state rip memory_is held => {
            let byte = held.witness;
            let named = held.proof.proof;
            let base = read_gpr(load.base, state.gprs);
            let present: (data.read(IoMemory(file, page), base) = Some(byte)) =
                j(sym(named.left), λ a _ => data.read(IoMemory(file, page), a) = Some(byte), named.right.left);
            let low: (base.toNat() < Nat::pow(2, 47)) = j(sym(named.left), λ a _ => a.toNat() < Nat::pow(2, 47), named.right.right.left);
            let loaded = run_byte_load(file, page, load, origin, here, code, state, memory_is, rip, byte, present, low);
            let after = byte_load_after(load, byte, state);
            back_fetched(goal, back, state, after, loaded.steps, goes(page, after, loaded.rip_is, loaded.memory_is, named.right.right.right))
        },
        Store(_) => λ _ _ page state rip memory_is never => false_elim(never),
        StoreByte(store) => λ code goes page state rip memory_is => (match store_base_plain(store.base) as λ b => store_base_plain(store.base) = b →
                (match b as λ _ => Type {
                    True => PageThen(read_gpr(store.base, state.gprs), λ c =>
                        then(page_stored(file, page, c, imm_byte0(read_gpr(store.source, state.gprs))), byte_store_after(linux_writes(io), store, state))),
                    False => False,
                }) → goal(state) {
            True => λ plain at => {
                let c = at.witness;
                let x = imm_byte0(read_gpr(store.source, state.gprs));
                let stored = run_store(file, page, store, plain, origin, here, code, c, at.proof.left, x, state, memory_is, rip,
                    at.proof.right.left, refl);
                let after = byte_store_after(linux_writes(io), store, state);
                back(state, after, stored.step, goes(page_stored(file, page, c, x), after, stored.rip_is, stored.memory_is, at.proof.right.right))
            },
            False => λ _ never => false_elim(never),
        })(refl),
        Jcc(cc, target) => λ code goes page state rip memory_is held => {
            let d = near_rel(here + 6, labels(target));
            let jcc = JumpIfNear(cc, d);
            let after = execute_near_control(jcc, state);
            let resident = j(sym(memory_is), λ m _ => CodeResident(fetch, m, near_control_bytes(jcc), next_rip(origin, here)), code(page));
            let step = fetched_steps_one(fetch, data, state, after, near_fetched_step(fetch, data, jcc, state,
                j(sym(rip), λ a _ => CodeResident(fetch, state.memory, near_control_bytes(jcc), a), resident)));
            back_fetched(goal, back, state, after, step,
                (match condition_holds(cc, state.flags) as λ c => condition_holds(cc, state.flags) = c → goal(after) {
                    True => λ yes => held.left(yes)(after, trans(near_if_taken_rip(cc, d, state, yes),
                        cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 6, d), rip)), memory_is, refl),
                    False => λ no => goes(page, after, trans(near_if_not_taken_rip(cc, d, state, no), rip_advance(origin, state.rip, here, 6, rip)),
                        memory_is, held.right(no)),
                })(refl))
        },
        Jmp(target) => λ code goes page state rip memory_is held => {
            let d = near_rel(here + 5, labels(target));
            let jmp = JumpNear(d);
            let after = execute_near_control(jmp, state);
            let resident = j(sym(memory_is), λ m _ => CodeResident(fetch, m, near_control_bytes(jmp), next_rip(origin, here)), code(page));
            let step = fetched_steps_one(fetch, data, state, after, near_fetched_step(fetch, data, jmp, state,
                j(sym(rip), λ a _ => CodeResident(fetch, state.memory, near_control_bytes(jmp), a), resident)));
            back_fetched(goal, back, state, after, step,
                held(after, cong_fn<BitVec(64), BitVec(64)>(λ a => near_branch_target(a, 5, d), rip), memory_is, refl))
        },
        Piece(_, _, _) => λ _ _ page state rip memory_is never => false_elim(never),
        Refer(_, _, _) => λ _ _ page state rip memory_is never => false_elim(never),
        Hole(_, _) => λ _ _ page state rip memory_is never => false_elim(never),
    }
}
// The chain's items, each resident where the chain's code is.
theorem stretch_run_goes(file: IoImage, origin: BitVec(64), goal: MachineState<IoMemory> → Type, back: StepsBack(goal), fills: Nat → List<BitVec(8)>,
    labels: Nat → Nat, n: Nat): (l: Prog) → FillsFit(l, fills) → (rest: List<BitVec(8)>) → Placed(file, asm_code(fills, labels, l) ++ rest, origin) →
    (then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type) → StretchGoes(file, origin, goal, prog_len(l), then) →
    StretchGoes(file, origin, goal, straight_from(l, n), stretch_run(file, origin, goal, labels, l, n, then)) {
    match n {
        Zero => λ l fits rest code then goes => goes,
        Succ(m) => λ l => match l as λ x => FillsFit(x, fills) → (rest: List<BitVec(8)>) → Placed(file, asm_code(fills, labels, x) ++ rest, origin) →
                (then: (Nat → BitVec(8)) → MachineState<IoMemory> → Type) → StretchGoes(file, origin, goal, prog_len(x), then) →
                StretchGoes(file, origin, goal, straight_from(x, Succ(m)), stretch_run(file, origin, goal, labels, x, Succ(m), then)) {
            Start => λ fits rest code then goes => goes,
            At(before, name, item) => λ fits rest code then goes => {
                let fetch = io_fetch_access();
                let fits_before = fills_fit_before(fills, before, name, item, fits);
                let front = asm_code(fills, labels, before);
                let bytes = asm_bytes(fills, labels, prog_len(before), item);
                let moved: Placed(file, front ++ (bytes ++ rest), origin) = j(List::append_assoc(front, bytes, rest), λ c _ => Placed(file, c, origin), code);
                let item_code: Placed(file, bytes, next_rip(origin, prog_len(before))) = λ page => {
                    let memory = IoMemory(file, page);
                    let tail = resident_split(fetch, memory, front, bytes ++ rest, origin, moved(page)).right;
                    resident_split(fetch, memory, bytes, rest, next_rip(origin, prog_len(before)),
                        j(asm_code_len(fills, labels, before, fits_before), λ k _ => CodeResident(fetch, memory, bytes ++ rest, next_rip(origin, k)), tail)).left
                };
                stretch_run_goes(file, origin, goal, back, fills, labels, m, before, fits_before, bytes ++ rest, moved,
                    stretch_item(file, origin, goal, labels, prog_len(before), item, then),
                    stretch_item_goes(file, origin, goal, back, fills, labels, prog_len(before), item, then, item_code, goes))
            },
        },
    }
}
theorem stretch_runs(file: IoImage, page: Nat → BitVec(8), origin: BitVec(64), goal: MachineState<IoMemory> → Type, back: StepsBack(goal),
    fills: Nat → List<BitVec(8)>, labels: Nat → Nat, l: Prog, n: Nat, fits: FillsFit(l, fills), rest: List<BitVec(8)>,
    code: Placed(file, asm_code(fills, labels, l) ++ rest, origin), state: MachineState<IoMemory>, rip: state.rip = next_rip(origin, straight_from(l, n)),
    memory_is: state.memory = IoMemory(file, page), held: Stretch(file, origin, goal, labels, l, n)(page, state)): goal(state) {
    stretch_run_goes(file, origin, goal, back, fills, labels, n, l, fits, rest, code, StretchLeaf(file, goal, next_rip(origin, prog_len(l))),
        λ pg s at m leaf => leaf(s, at, m, refl), page, state, rip, memory_is, held)
}

// A JCC's side on a negated flag (`NE`, `AE`) is `!b = True` or `!b =
// False`; these give `b`, so one stretch states both sides.
theorem not_true_is(b: Bool, h: !b = True): b = False {
    (match b as λ c => !c = True → c = False { True => λ no => absurd(no), False => λ _ => refl })(h)
}
theorem not_false_is(b: Bool, h: !b = False): b = True {
    (match b as λ c => !c = False → c = True { True => λ _ => refl, False => λ no => absurd(no) })(h)
}

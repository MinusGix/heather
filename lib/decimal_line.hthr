// A step's split and remainder come from division's own laws; only the
// bounds and the sums need `omega`.
theorem step_parts(r, c: Nat): r = c * r.div(c) + r.mod(c) {
    sym(trans(@cong(λ (x: Nat) => x + r.mod(c), c * r.div(c), r.div(c) * c, Nat::mul_comm(c, r.div(c))), Nat::div_mul_add_mod(r, c)))
}
theorem step_rem(r, c: Nat, positive: 0 < c): r.mod(c) < c { Nat::mod_lt(r, c, positive) }

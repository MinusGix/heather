// Printing a count: its decimal digits and a newline, formatted by code the
// native compiler emits (docs/native-first-program-design.md §10). The model
// has no multiply, divide or shift, so the digits come from a restoring chain
// over one word: the value left to print sits above bit 40, the line's bytes
// below it, and each step subtracts a threshold when it fits and adds the
// digit's weight to its byte.
import bitvec;
import bool;
import logic;
import nat;
import list;
import omega;
import bitvec_nat;
import bitvec_omega;
import x86_64;
import x86_64_store;

fn double(x: BitVec(64)) → BitVec(64) { x.add(x) }

// Times 256, by doubling. Each doubling is a call: a `let` would be copied
// into every use, and the term would double with each one.
fn times256(x: BitVec(64)) → BitVec(64) { double(double(double(double(double(double(double(double(x)))))))) }

// The count moved above the line's five bytes: `n * 2^40`.
fn raise(n: BitVec(64)) → BitVec(64) { times256(times256(times256(times256(times256(n))))) }

// One restoring step: when at least `threshold` is left, take it away and
// add `weight` to the digit it counts.
fn place(state, threshold, weight: BitVec(64)) → BitVec(64) {
    match state.unsigned_lt_bit(threshold) {
        True => state,
        False => state.sub(threshold).add(weight),
    }
}

// For `n < 10000`: the bytes of "dddd\n", low first, with nothing left above.
fn line_word(n: BitVec(64)) → BitVec(64) {
    place(place(place(place(place(place(place(place(place(place(place(place(place(place(place(place(raise(n).add(BitVec::ofNat(0x0a30303030)), BitVec::ofNat(8796093022208000), BitVec::ofNat(8)), BitVec::ofNat(4398046511104000), BitVec::ofNat(4)), BitVec::ofNat(2199023255552000), BitVec::ofNat(2)), BitVec::ofNat(1099511627776000), BitVec::ofNat(1)), BitVec::ofNat(879609302220800), BitVec::ofNat(2048)), BitVec::ofNat(439804651110400), BitVec::ofNat(1024)), BitVec::ofNat(219902325555200), BitVec::ofNat(512)), BitVec::ofNat(109951162777600), BitVec::ofNat(256)), BitVec::ofNat(87960930222080), BitVec::ofNat(524288)), BitVec::ofNat(43980465111040), BitVec::ofNat(262144)), BitVec::ofNat(21990232555520), BitVec::ofNat(131072)), BitVec::ofNat(10995116277760), BitVec::ofNat(65536)), BitVec::ofNat(8796093022208), BitVec::ofNat(134217728)), BitVec::ofNat(4398046511104), BitVec::ofNat(67108864)), BitVec::ofNat(2199023255552), BitVec::ofNat(33554432)), BitVec::ofNat(1099511627776), BitVec::ofNat(16777216))
}

// One when `n` is below `limit`.
fn below(n, limit: BitVec(64)) → BitVec(64) {
    match n.unsigned_lt_bit(limit) {
        True => BitVec::ofNat(1),
        False => BitVec::ofNat(0),
    }
}

// The line's leading zeros in the stored word: none from 1000 up.
fn leading_zeros(n: BitVec(64)) → BitVec(64) {
    below(n, BitVec::ofNat(10)).add(below(n, BitVec::ofNat(100))).add(below(n, BitVec::ofNat(1000)))
}

// Where the line starts in a word stored at `base`, past its leading zeros.
fn line_start(base, n: BitVec(64)) → BitVec(64) { base.add(leading_zeros(n)) }

// How many bytes the line has: its digits and the newline.
fn line_length(n: BitVec(64)) → BitVec(64) { BitVec::ofNat(5).sub(leading_zeros(n)) }

// ---------------------------------------------------------------------------
// What the line means. A certificate states what is written as
// `decimal_line(count)`, an ordinary function; the lemmas below are why the
// word the formatter stores holds it, past `line_skip` leading zeros.

fn digit(d: Nat) → BitVec(8) { BitVec::ofNat(48 + d) }

// The decimal digits of `n`, most significant first: the digits of `n / 10`,
// then `n % 10`. `fuel` counts the divisions left; `decimal` gives it `n`,
// always enough, since every division at least halves what is left.
fn decimal_digits(fuel, n: Nat) → List<BitVec(8)> {
    match fuel {
        Zero => [digit(n)],
        Succ(rest) => match n.leb(9) {
            True => [digit(n)],
            False => decimal_digits(rest, n.div(10)) ++ [digit(n.mod(10))],
        },
    }
}
fn decimal(n: Nat) → List<BitVec(8)> { decimal_digits(n, n) }

// One line of `wc -l`'s output: the count and a newline.
fn decimal_line(n: Nat) → List<BitVec(8)> { decimal(n) ++ [BitVec::ofNat(10)] }

// The formatter's word, byte by byte, for a count below 10000: four digits,
// the newline, nothing above.
fn line_bytes(n: Nat) → List<BitVec(8)> {
    [digit(n.div(10).div(10).div(10)), digit(n.div(10).div(10).mod(10)), digit(n.div(10).mod(10)), digit(n.mod(10)),
     BitVec::ofNat(10), BitVec::ofNat(0), BitVec::ofNat(0), BitVec::ofNat(0)]
}
fn below_nat(n, limit: Nat) → Nat { match Succ(n).leb(limit) { True => 1, False => 0 } }
fn line_skip(n: Nat) → Nat { below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) }

theorem leb_yes(a, b: Nat, h: a <= b): a.leb(b) = True { bool::eq_true_of_is_true(a.leb(b), a.leb_complete(b, h)) }
theorem leb_no(a, b: Nat, h: b < a): a.leb(b) = False {
    (match a.leb(b) as λ found => (a.leb(b) = found) → found = False {
        True => λ yes => {
            let wrong: (a <= b) = a.leb_sound(b, j(sym(yes), λ f _ => f.IsTrue(), trivial));
            let never: False = omega;
            false_elim(never)
        },
        False => λ _ => refl,
    })(refl)
}

// ---------------------------------------------------------------------------
// The spec at up to four digits.

theorem decimal_one(fuel, m: Nat, small: m <= 9): decimal_digits(fuel, m) = [digit(m)] {
    match fuel {
        Zero => refl,
        Succ(rest) => j(sym(leb_yes(m, 9, small)), λ b _ =>
            (match b { True => [digit(m)], False => decimal_digits(rest, m.div(10)) ++ [digit(m.mod(10))] }) = [digit(m)], refl),
    }
}

theorem decimal_more(fuel, m: Nat, big: 10 <= m):
    decimal_digits(Succ(fuel), m) = decimal_digits(fuel, m.div(10)) ++ [digit(m.mod(10))] {
    j(sym(leb_no(m, 9, big)), λ b _ =>
        (match b { True => [digit(m)], False => decimal_digits(fuel, m.div(10)) ++ [digit(m.mod(10))] }) =
            decimal_digits(fuel, m.div(10)) ++ [digit(m.mod(10))], refl)
}

theorem decimal_two(fuel, m: Nat, lo: 10 <= m, hi: m <= 99, room: 1 <= fuel):
    decimal_digits(fuel, m) = [digit(m.div(10)), digit(m.mod(10))] {
    (match fuel as λ f => (1 <= f) → decimal_digits(f, m) = [digit(m.div(10)), digit(m.mod(10))] {
        Zero => λ room => false_elim(room),
        Succ(rest) => λ _ => {
            let top: (m.div(10) <= 9) = m.div_lt_of_lt_mul(10, 10, hi);
            trans(decimal_more(rest, m, lo), @cong(λ (xs: List<BitVec(8)>) => xs ++ [digit(m.mod(10))],
                decimal_digits(rest, m.div(10)), [digit(m.div(10))], decimal_one(rest, m.div(10), top)))
        },
    })(room)
}

theorem decimal_three(fuel, m: Nat, lo: 100 <= m, hi: m <= 999, room: 2 <= fuel):
    decimal_digits(fuel, m) = [digit(m.div(10).div(10)), digit(m.div(10).mod(10)), digit(m.mod(10))] {
    (match fuel as λ f => (2 <= f) → decimal_digits(f, m) = [digit(m.div(10).div(10)), digit(m.div(10).mod(10)), digit(m.mod(10))] {
        Zero => λ room => false_elim(room),
        Succ(rest) => λ room => {
            let lo2: (10 <= m.div(10)) = m.le_div_of_mul_le(10, 10, trivial, lo);
            let hi2: (m.div(10) <= 99) = m.div_lt_of_lt_mul(10, 100, hi);
            let room2: (1 <= rest) = omega;
            trans(decimal_more(rest, m, omega), @cong(λ (xs: List<BitVec(8)>) => xs ++ [digit(m.mod(10))],
                decimal_digits(rest, m.div(10)), [digit(m.div(10).div(10)), digit(m.div(10).mod(10))], decimal_two(rest, m.div(10), lo2, hi2, room2)))
        },
    })(room)
}

theorem decimal_four(fuel, m: Nat, lo: 1000 <= m, hi: m <= 9999, room: 3 <= fuel):
    decimal_digits(fuel, m) = [digit(m.div(10).div(10).div(10)), digit(m.div(10).div(10).mod(10)), digit(m.div(10).mod(10)), digit(m.mod(10))] {
    (match fuel as λ f => (3 <= f) → decimal_digits(f, m) = [digit(m.div(10).div(10).div(10)), digit(m.div(10).div(10).mod(10)), digit(m.div(10).mod(10)), digit(m.mod(10))] {
        Zero => λ room => false_elim(room),
        Succ(rest) => λ room => {
            let lo2: (100 <= m.div(10)) = m.le_div_of_mul_le(10, 100, trivial, lo);
            let hi2: (m.div(10) <= 999) = m.div_lt_of_lt_mul(10, 1000, hi);
            let room2: (2 <= rest) = omega;
            trans(decimal_more(rest, m, omega), @cong(λ (xs: List<BitVec(8)>) => xs ++ [digit(m.mod(10))],
                decimal_digits(rest, m.div(10)),
                [digit(m.div(10).div(10).div(10)), digit(m.div(10).div(10).mod(10)), digit(m.div(10).mod(10))],
                decimal_three(rest, m.div(10), lo2, hi2, room2)))
        },
    })(room)
}

// ---------------------------------------------------------------------------
// The formatter's word, as a number.

// Every value here stays below 2^60, well inside the word.
theorem below_word(x: Nat, h: x < 1152921504606846976): x < Nat::pow(2, 64) { omega }

theorem times256_value(y: BitVec(64), v: Nat, value: y.toNat() = v * 1, bound: v * 256 < 1152921504606846976):
    times256(y).toNat() = v * 256 { bv_omega }

theorem raise_value(n: Nat, small: n < 16384): raise(bitvec_nat::word_of_nat(64, n)).toNat() = n * 1099511627776 { bv_omega }

theorem low_part(h, w: Nat, low: h + w < 1099511627776): h < 1099511627776 {
    Succ(h).le_trans(Succ(h + w), 1099511627776, h.le_add_l(w), low)
}

// One restoring step, with its outcome named: `q` is whether `c` fitted
// into what is left, `rest` what is left after.
theorem place_step(s: BitVec(64), r, h, c, w, q, rest: Nat,
    value: s.toNat() = 1099511627776 * r + h, low: h + w < 1099511627776,
    parts: r = c * q + rest, remainder: rest < c, one: q <= 1,
    fits: 1099511627776 * r + h < 1152921504606846976, c_fits: 1099511627776 * c < 1152921504606846976):
    place(s, BitVec::ofNat(1099511627776 * c), BitVec::ofNat(w)).toNat() = 1099511627776 * rest + (h + w * q) {
    let big = BitVec::ofNat(1099511627776 * c, n := 64);
    let weight = BitVec::ofNat(w, n := 64);
    (match q as λ k => (r = c * k + rest) → (k <= 1) →
        place(s, big, weight).toNat() = 1099511627776 * rest + (h + w * k) {
        Zero => λ parts one => {
            let kept: (s.unsigned_lt_bit(big) = True) = bv_omega;
            let same: (place(s, big, weight) = s) =
                j(sym(kept), λ b _ => (match b { True => s, False => s.sub(big).add(weight) }) = s, refl);
            let moved: (place(s, big, weight).toNat() = s.toNat()) = @cong(λ (v: BitVec(64)) => v.toNat(), place(s, big, weight), s, same);
            bv_omega
        },
        Succ(k) => (match k as λ k2 => (r = c * Succ(k2) + rest) → (Succ(k2) <= 1) →
            place(s, big, weight).toNat() = 1099511627776 * rest + (h + w * Succ(k2)) {
            Zero => λ parts one => {
                let taken: (s.unsigned_lt_bit(big) = False) = bv_omega;
                let stepped: (place(s, big, weight) = s.sub(big).add(weight)) =
                    j(sym(taken), λ b _ => (match b { True => s, False => s.sub(big).add(weight) }) = s.sub(big).add(weight), refl);
                let moved: (place(s, big, weight).toNat() = s.sub(big).add(weight).toNat()) =
                    @cong(λ (v: BitVec(64)) => v.toNat(), place(s, big, weight), s.sub(big).add(weight), stepped);
                let sum: (s.sub(big).add(weight).toNat() = 1099511627776 * rest + (h + w * 1)) = bv_omega;
                trans(moved, sum)
            },
            Succ(_) => λ parts one => false_elim(one),
        }),
    })(parts, one)
}

// A value's two parts, restated: `omega` proves it once, over variables.
theorem restate(t, a, b, c, d: Nat, value: t = 1099511627776 * a + b, ea: a = c, eb: b = d): t = 1099511627776 * c + d { omega }

// A digit group's arithmetic: each step's outcome and bounds, and what the
// four add up to. A record, so a step reads its facts by name.
record GroupFacts(r, h, c1, w1, c2, w2, c3, w3, c4, w4: Nat) {
    low1: h + w1 < 1099511627776,
    parts1: r = c1 * r.div(c1) + r.mod(c1),
    rem1: r.mod(c1) < c1,
    one1: r.div(c1) <= 1,
    fits1: 1099511627776 * r + h < 1152921504606846976,
    big1: 1099511627776 * c1 < 1152921504606846976,
    low2: (h + w1 * r.div(c1)) + w2 < 1099511627776,
    parts2: r.mod(c1) = c2 * r.mod(c1).div(c2) + r.mod(c1).mod(c2),
    rem2: r.mod(c1).mod(c2) < c2,
    one2: r.mod(c1).div(c2) <= 1,
    fits2: 1099511627776 * r.mod(c1) + (h + w1 * r.div(c1)) < 1152921504606846976,
    big2: 1099511627776 * c2 < 1152921504606846976,
    low3: ((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 < 1099511627776,
    parts3: r.mod(c1).mod(c2) = c3 * r.mod(c1).mod(c2).div(c3) + r.mod(c1).mod(c2).mod(c3),
    rem3: r.mod(c1).mod(c2).mod(c3) < c3,
    one3: r.mod(c1).mod(c2).div(c3) <= 1,
    fits3: 1099511627776 * r.mod(c1).mod(c2) + ((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) < 1152921504606846976,
    big3: 1099511627776 * c3 < 1152921504606846976,
    low4: (((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)) + w4 < 1099511627776,
    parts4: r.mod(c1).mod(c2).mod(c3) = c4 * r.mod(c1).mod(c2).mod(c3).div(c4) + r.mod(c1).mod(c2).mod(c3).mod(c4),
    rem4: r.mod(c1).mod(c2).mod(c3).mod(c4) < c4,
    one4: r.mod(c1).mod(c2).mod(c3).div(c4) <= 1,
    fits4: 1099511627776 * r.mod(c1).mod(c2).mod(c3) + (((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)) < 1152921504606846976,
    big4: 1099511627776 * c4 < 1152921504606846976,
    rest: r.mod(c1).mod(c2).mod(c3).mod(c4) = r.mod(c4),
    sum: ((((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)) + w4 * r.mod(c1).mod(c2).mod(c3).div(c4)) = h + w4 * r.div(c4),
}

// Four restoring steps: one digit, weighed 8, 4, 2, 1.
theorem four_steps(s: BitVec(64), r, h, c1, w1, c2, w2, c3, w3, c4, w4: Nat, value: s.toNat() = 1099511627776 * r + h,
    facts: GroupFacts(r, h, c1, w1, c2, w2, c3, w3, c4, w4)):
    place(place(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), BitVec::ofNat(1099511627776 * c3), BitVec::ofNat(w3)), BitVec::ofNat(1099511627776 * c4), BitVec::ofNat(w4)).toNat() = 1099511627776 * r.mod(c4) + (h + w4 * r.div(c4)) {
    let v1: (place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)).toNat() = 1099511627776 * r.mod(c1) + (h + w1 * r.div(c1))) =
        place_step(s, r, h, c1, w1, r.div(c1), r.mod(c1), value, facts.low1, facts.parts1, facts.rem1, facts.one1, facts.fits1, facts.big1);
    let v2: (place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)).toNat() = 1099511627776 * r.mod(c1).mod(c2) + ((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2))) =
        place_step(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), r.mod(c1), (h + w1 * r.div(c1)), c2, w2, r.mod(c1).div(c2), r.mod(c1).mod(c2), v1, facts.low2, facts.parts2, facts.rem2, facts.one2, facts.fits2, facts.big2);
    let v3: (place(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), BitVec::ofNat(1099511627776 * c3), BitVec::ofNat(w3)).toNat() = 1099511627776 * r.mod(c1).mod(c2).mod(c3) + (((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3))) =
        place_step(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), r.mod(c1).mod(c2), ((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)), c3, w3, r.mod(c1).mod(c2).div(c3), r.mod(c1).mod(c2).mod(c3), v2, facts.low3, facts.parts3, facts.rem3, facts.one3, facts.fits3, facts.big3);
    let v4: (place(place(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), BitVec::ofNat(1099511627776 * c3), BitVec::ofNat(w3)), BitVec::ofNat(1099511627776 * c4), BitVec::ofNat(w4)).toNat() = 1099511627776 * r.mod(c1).mod(c2).mod(c3).mod(c4) + ((((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)) + w4 * r.mod(c1).mod(c2).mod(c3).div(c4))) =
        place_step(place(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), BitVec::ofNat(1099511627776 * c3), BitVec::ofNat(w3)), r.mod(c1).mod(c2).mod(c3), (((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)), c4, w4, r.mod(c1).mod(c2).mod(c3).div(c4), r.mod(c1).mod(c2).mod(c3).mod(c4), v3, facts.low4, facts.parts4, facts.rem4, facts.one4, facts.fits4, facts.big4);
    restate(place(place(place(place(s, BitVec::ofNat(1099511627776 * c1), BitVec::ofNat(w1)), BitVec::ofNat(1099511627776 * c2), BitVec::ofNat(w2)), BitVec::ofNat(1099511627776 * c3), BitVec::ofNat(w3)), BitVec::ofNat(1099511627776 * c4), BitVec::ofNat(w4)).toNat(), r.mod(c1).mod(c2).mod(c3).mod(c4), ((((h + w1 * r.div(c1)) + w2 * r.mod(c1).div(c2)) + w3 * r.mod(c1).mod(c2).div(c3)) + w4 * r.mod(c1).mod(c2).mod(c3).div(c4)), r.mod(c4), h + w4 * r.div(c4), v4, facts.rest, facts.sum)
}

// A step's split and remainder come from division's own laws.
theorem step_parts(r, c: Nat): r = c * r.div(c) + r.mod(c) {
    sym(trans(@cong(λ (x: Nat) => x + r.mod(c), c * r.div(c), r.div(c) * c, Nat::mul_comm(c, r.div(c))), Nat::div_mul_add_mod(r, c)))
}
theorem step_big(c: Nat, h: Succ(1099511627776 * c).leb(1152921504606846976).IsTrue()): 1099511627776 * c < 1152921504606846976 { Nat::leb_sound(Succ(1099511627776 * c), 1152921504606846976, h) }

// The bounds a group's steps need, by the order's kit: the digit so far plus
// what the steps still to come may add stays below the line's bytes.
theorem low_here(s, u, t: Nat, room: s + (u + t) < 1099511627776): s + u < 1099511627776 {
    Succ(s + u).le_trans(Succ(s + (u + t)), 1099511627776, s.add_le_mono_l(u, u + t, u.le_add_l(t)), room)
}
theorem low_next(s, u, q, t: Nat, room: s + (u + t) < 1099511627776, one: q <= 1): (s + u * q) + t < 1099511627776 {
    let less: (u * q <= u) = j(u.add_left_zero(), λ y _ => u * q <= y, u.mul_le_mono_l(q, 1, one));
    Succ((s + u * q) + t).le_trans(Succ(s + (u + t)), 1099511627776,
        j(sym(s.add_assoc(u * q, t)), λ y _ => y <= s + (u + t), s.add_le_mono_l(u * q + t, u + t, t.add_le_mono_r(u * q, u, less))),
        room)
}
theorem step_fits(rest, s, c: Nat, remainder: rest < c, low: s < 1099511627776, big: 1099511627776 * c < 1152921504606846976):
    1099511627776 * rest + s < 1152921504606846976 {
    // Scaled with the literal on the left throughout: `mul` recurses on its
    // second argument, and `rest * 2^40` unfolds once per unit of it.
    Succ(1099511627776 * rest + s).le_trans(1099511627776 * Succ(rest), 1152921504606846976,
        (1099511627776 * rest).add_le_mono_l(Succ(s), 1099511627776, low),
        (1099511627776 * Succ(rest)).le_trans(1099511627776 * c, 1152921504606846976, Nat::mul_le_mono_l(1099511627776, Succ(rest), c, remainder),
            (1099511627776 * c).le_of_lt(1152921504606846976, big)))
}

// A digit's byte weight moved onto the digit: `(w * k) * a = w * (a * k)`.
theorem scale(w, k, a: Nat): (w * k) * a = w * (a * k) {
    trans(w.mul_assoc(k, a), Nat::cong(λ (z: Nat) => w * z, k.mul_comm(a)))
}

// A group's digits, weighed and added up, are its place value weighed.
theorem weigh(h, w, a, b, x, d: Nat):
    (((h + (w * 8) * a) + (w * 4) * b) + (w * 2) * x) + w * d = h + w * (a * 8 + (b * 4 + (x * 2 + d))) {
    calc {
        (((h + (w * 8) * a) + (w * 4) * b) + (w * 2) * x) + w * d
            = ((h + (w * 8) * a) + (w * 4) * b) + ((w * 2) * x + w * d) := ((h + (w * 8) * a) + (w * 4) * b).add_assoc((w * 2) * x, w * d),
            = (h + (w * 8) * a) + ((w * 4) * b + ((w * 2) * x + w * d)) := (h + (w * 8) * a).add_assoc((w * 4) * b, (w * 2) * x + w * d),
            = h + ((w * 8) * a + ((w * 4) * b + ((w * 2) * x + w * d))) := h.add_assoc((w * 8) * a, (w * 4) * b + ((w * 2) * x + w * d)),
            = h + (w * (a * 8) + ((w * 4) * b + ((w * 2) * x + w * d))) :=
                Nat::cong(λ (z: Nat) => h + (z + ((w * 4) * b + ((w * 2) * x + w * d))), scale(w, 8, a)),
            = h + (w * (a * 8) + (w * (b * 4) + ((w * 2) * x + w * d))) :=
                Nat::cong(λ (z: Nat) => h + (w * (a * 8) + (z + ((w * 2) * x + w * d))), scale(w, 4, b)),
            = h + (w * (a * 8) + (w * (b * 4) + (w * (x * 2) + w * d))) :=
                Nat::cong(λ (z: Nat) => h + (w * (a * 8) + (w * (b * 4) + (z + w * d))), scale(w, 2, x)),
            = h + (w * (a * 8) + (w * (b * 4) + w * (x * 2 + d))) :=
                Nat::cong(λ (z: Nat) => h + (w * (a * 8) + (w * (b * 4) + z)), sym(w.mul_add_distr(x * 2, d))),
            = h + (w * (a * 8) + w * (b * 4 + (x * 2 + d))) :=
                Nat::cong(λ (z: Nat) => h + (w * (a * 8) + z), sym(w.mul_add_distr(b * 4, x * 2 + d))),
            = h + w * (a * 8 + (b * 4 + (x * 2 + d))) :=
                Nat::cong(λ (z: Nat) => h + z, sym(w.mul_add_distr(a * 8, b * 4 + (x * 2 + d)))),
    }
}

// A digit group's arithmetic at any place value `c` and byte weight `w`:
// four restoring steps take `c * 8`, `c * 4`, `c * 2` and `c`, and their
// outcomes are the bits of `r / c`. Every fact is a kit lemma; the group
// lemmas below only supply the bounds, at literals.
theorem group_facts(r, h, c, w: Nat, positive: 0 < c, small: r < (c * 8) * 2, room: h + w * 15 < 1099511627776,
    fits: 1099511627776 * r + h < 1152921504606846976, big1: 1099511627776 * (c * 8) < 1152921504606846976, big2: 1099511627776 * (c * 4) < 1152921504606846976,
    big3: 1099511627776 * (c * 2) < 1152921504606846976, big4: 1099511627776 * c < 1152921504606846976):
    GroupFacts(r, h, c * 8, w * 8, c * 4, w * 4, c * 2, w * 2, c, w) {
    let p2: (0 < c * 2) = (1).le_trans(c, c * 2, positive, (c * 1).le_add_r(c));
    let p4: (0 < c * 4) = (1).le_trans(c, c * 4, positive, (c * 3).le_add_r(c));
    let p8: (0 < c * 8) = (1).le_trans(c, c * 8, positive, (c * 7).le_add_r(c));
    let rem1: (r.mod(c * 8) < c * 8) = r.mod_lt(c * 8, p8);
    let rem2: (r.mod(c * 8).mod(c * 4) < c * 4) = r.mod(c * 8).mod_lt(c * 4, p4);
    let rem3: (r.mod(c * 8).mod(c * 4).mod(c * 2) < c * 2) = r.mod(c * 8).mod(c * 4).mod_lt(c * 2, p2);
    let rem4: (r.mod(c * 8).mod(c * 4).mod(c * 2).mod(c) < c) = r.mod(c * 8).mod(c * 4).mod(c * 2).mod_lt(c, positive);
    let one1: (r.div(c * 8) <= 1) = r.div_lt_of_lt_mul(c * 8, 2, small);
    let one2: (r.mod(c * 8).div(c * 4) <= 1) = r.mod(c * 8).div_lt_of_lt_mul(c * 4, 2,
        j(sym(c.mul_assoc(4, 2)), λ y _ => r.mod(c * 8) < y, rem1));
    let one3: (r.mod(c * 8).mod(c * 4).div(c * 2) <= 1) = r.mod(c * 8).mod(c * 4).div_lt_of_lt_mul(c * 2, 2,
        j(sym(c.mul_assoc(2, 2)), λ y _ => r.mod(c * 8).mod(c * 4) < y, rem2));
    let one4: (r.mod(c * 8).mod(c * 4).mod(c * 2).div(c) <= 1) = r.mod(c * 8).mod(c * 4).mod(c * 2).div_lt_of_lt_mul(c, 2, rem3);
    let inv0: (h + (w * 8 + w * 7) < 1099511627776) = j(w.mul_add_distr(8, 7), λ y _ => h + y < 1099511627776, room);
    let inv1: ((h + (w * 8) * r.div(c * 8)) + (w * 4 + w * 3) < 1099511627776) =
        j(w.mul_add_distr(4, 3), λ y _ => (h + (w * 8) * r.div(c * 8)) + y < 1099511627776,
            low_next(h, w * 8, r.div(c * 8), w * 7, inv0, one1));
    let inv2: (((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + (w * 2 + w * 1) < 1099511627776) =
        j(w.mul_add_distr(2, 1), λ y _ => ((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + y < 1099511627776,
            low_next(h + (w * 8) * r.div(c * 8), w * 4, r.mod(c * 8).div(c * 4), w * 3, inv1, one2));
    let low2 = low_here(h + (w * 8) * r.div(c * 8), w * 4, w * 3, inv1);
    let low3 = low_here((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4), w * 2, w * 1, inv2);
    let low4: ((((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + (w * 2) * r.mod(c * 8).mod(c * 4).div(c * 2)) + w < 1099511627776) =
        j(w.add_left_zero(), λ y _ => (((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + (w * 2) * r.mod(c * 8).mod(c * 4).div(c * 2)) + y < 1099511627776,
            low_next((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4), w * 2, r.mod(c * 8).mod(c * 4).div(c * 2), w * 1, inv2, one3));
    let rest1: (r.mod(c * 8).mod(c * 4) = r.mod(c * 4)) =
        j(c.mul_assoc(4, 2), λ y _ => r.mod(y).mod(c * 4) = r.mod(c * 4), r.mod_mul_mod(c * 4, 2, p4, trivial));
    let rest2: (r.mod(c * 4).mod(c * 2) = r.mod(c * 2)) =
        j(c.mul_assoc(2, 2), λ y _ => r.mod(y).mod(c * 2) = r.mod(c * 2), r.mod_mul_mod(c * 2, 2, p2, trivial));
    let rest: (r.mod(c * 8).mod(c * 4).mod(c * 2).mod(c) = r.mod(c)) =
        trans(Nat::cong(λ (x: Nat) => x.mod(c * 2).mod(c), rest1), trans(Nat::cong(λ (x: Nat) => x.mod(c), rest2), r.mod_mul_mod(c, 2, positive, trivial)));
    let bits: (r.div(c) = r.div(c * 8) * 8 + (r.mod(c * 8).div(c * 4) * 4 + (r.mod(c * 8).mod(c * 4).div(c * 2) * 2 + r.mod(c * 8).mod(c * 4).mod(c * 2).div(c)))) =
        trans(r.div_split(c, 8, positive, trivial), Nat::cong(λ (y: Nat) => r.div(c * 8) * 8 + y,
            trans(r.mod(c * 8).div_split(c, 4, positive, trivial), Nat::cong(λ (y: Nat) => r.mod(c * 8).div(c * 4) * 4 + y,
                r.mod(c * 8).mod(c * 4).div_split(c, 2, positive, trivial)))));
    let sum = trans(weigh(h, w, r.div(c * 8), r.mod(c * 8).div(c * 4), r.mod(c * 8).mod(c * 4).div(c * 2), r.mod(c * 8).mod(c * 4).mod(c * 2).div(c)),
        Nat::cong(λ (y: Nat) => h + w * y, sym(bits)));
    GroupFacts(low_here(h, w * 8, w * 7, inv0), step_parts(r, c * 8), rem1, one1, fits, big1,
        low2, step_parts(r.mod(c * 8), c * 4), rem2, one2,
        step_fits(r.mod(c * 8), h + (w * 8) * r.div(c * 8), c * 8, rem1, low_part(h + (w * 8) * r.div(c * 8), w * 4, low2), big1), big2,
        low3, step_parts(r.mod(c * 8).mod(c * 4), c * 2), rem3, one3,
        step_fits(r.mod(c * 8).mod(c * 4), (h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4), c * 4, rem2,
            low_part((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4), w * 2, low3), big2), big3,
        low4, step_parts(r.mod(c * 8).mod(c * 4).mod(c * 2), c), rem4, one4,
        step_fits(r.mod(c * 8).mod(c * 4).mod(c * 2), ((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + (w * 2) * r.mod(c * 8).mod(c * 4).div(c * 2), c * 2, rem3,
            low_part(((h + (w * 8) * r.div(c * 8)) + (w * 4) * r.mod(c * 8).div(c * 4)) + (w * 2) * r.mod(c * 8).mod(c * 4).div(c * 2), w, low4), big3), big4,
        rest, sum)
}

// A value below `a` is below any literal `b` at least `a`.
theorem below_wider(r, a, b: Nat, small: r < a, wider: a.leb(b).IsTrue()): r < b {
    Succ(r).le_trans(a, b, small, Nat::leb_sound(a, b, wider))
}

// Each group at its place value, from the value's bound and the room left
// in its byte.
theorem thousands_arith(r, h: Nat, small: r < 10000, room: h + 15 < 1099511627776): GroupFacts(r, h, 8000, 8, 4000, 4, 2000, 2, 1000, 1) {
    group_facts(r, h, 1000, 1, trivial, below_wider(r, 10000, 16000, small, trivial), room,
        step_fits(r, h, 10000, small, low_part(h, 15, room), step_big(10000, trivial)),
        step_big(8000, trivial), step_big(4000, trivial), step_big(2000, trivial), step_big(1000, trivial))
}

theorem hundreds_arith(r, h: Nat, small: r < 1000, room: h + 3840 < 1099511627776): GroupFacts(r, h, 800, 2048, 400, 1024, 200, 512, 100, 256) {
    group_facts(r, h, 100, 256, trivial, below_wider(r, 1000, 1600, small, trivial), room,
        step_fits(r, h, 1000, small, low_part(h, 3840, room), step_big(1000, trivial)),
        step_big(800, trivial), step_big(400, trivial), step_big(200, trivial), step_big(100, trivial))
}

theorem tens_arith(r, h: Nat, small: r < 100, room: h + 983040 < 1099511627776): GroupFacts(r, h, 80, 524288, 40, 262144, 20, 131072, 10, 65536) {
    group_facts(r, h, 10, 65536, trivial, below_wider(r, 100, 160, small, trivial), room,
        step_fits(r, h, 100, small, low_part(h, 983040, room), step_big(100, trivial)),
        step_big(80, trivial), step_big(40, trivial), step_big(20, trivial), step_big(10, trivial))
}

theorem units_arith(r, h: Nat, small: r < 10, room: h + 251658240 < 1099511627776): GroupFacts(r, h, 8, 134217728, 4, 67108864, 2, 33554432, 1, 16777216) {
    group_facts(r, h, 1, 16777216, trivial, below_wider(r, 10, 16, small, trivial), room,
        step_fits(r, h, 10, small, low_part(h, 251658240, room), step_big(10, trivial)),
        step_big(8, trivial), step_big(4, trivial), step_big(2, trivial), step_big(1, trivial))
}

// A literal comparison, decided by `leb`.
theorem lit_lt(a, b: Nat, h: Succ(a).leb(b).IsTrue()): a < b { Nat::leb_sound(Succ(a), b, h) }

// A digit weighed into a sum, bounded by its largest value.
theorem weighted_le(s, s2, w, q, k: Nat, h: s <= s2, one: q <= k): s + w * q <= s2 + w * k {
    s.add_le_mono(s2, w * q, w * k, h, w.mul_le_mono_l(q, k, one))
}

// Room below the line's bytes, from a bound on what is there.
theorem room_of(x, y, t: Nat, le: x <= y, lit: Succ(y + t).leb(1099511627776).IsTrue()): x + t < 1099511627776 {
    Succ(x + t).le_trans(Succ(y + t), 1099511627776, t.add_le_mono_r(x, y, le), Nat::leb_sound(Succ(y + t), 1099511627776, lit))
}

// The spec's leading digit of a four-digit count, bounded one division at a time.
theorem top_digit_small(n: Nat, small: n < 10000): n.div(10).div(10).div(10) < 10 {
    n.div(10).div(10).div_lt_of_lt_mul(10, 10, n.div(10).div_lt_of_lt_mul(10, 100, n.div_lt_of_lt_mul(10, 1000, small)))
}

theorem line_prereqs(n: Nat, small: n < 10000):
    (43758137392 + 15 < 1099511627776) ∧ ((1099511627776 * n + 43758137392 < 1152921504606846976) ∧ ((n < 10000) ∧ ((43758137392 + 15 < 1099511627776) ∧ ((n.mod(1000) < 1000) ∧ (((43758137392 + 1 * n.div(1000)) + 3840 < 1099511627776) ∧ ((n.mod(1000).mod(100) < 100) ∧ ((((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 983040 < 1099511627776) ∧ ((n.mod(1000).mod(100).mod(10) < 10) ∧ (((((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10)) + 251658240 < 1099511627776) ∧ ((n.mod(1000).mod(100).mod(10).mod(1) = 0) ∧ (((n.div(10).div(10).div(10) < 208) ∧ ((n.div(10).div(10).mod(10) < 208) ∧ ((n.div(10).mod(10) < 208) ∧ (n.mod(10) < 208))))))))))))))) {
    let q1: (n.div(1000) < 10) = n.div_lt_of_lt_mul(1000, 10, small);
    let q2: (n.mod(1000).div(100) < 10) = n.mod(1000).div_lt_of_lt_mul(100, 10, n.mod_lt(1000, trivial));
    let q3: (n.mod(1000).mod(100).div(10) < 10) = n.mod(1000).mod(100).div_lt_of_lt_mul(10, 10, n.mod(1000).mod_lt(100, trivial));
    let s1 = weighted_le(43758137392, 43758137392, 1, n.div(1000), 9, (43758137392).le_refl(), q1);
    let s2 = weighted_le(43758137392 + 1 * n.div(1000), 43758137392 + 1 * 9, 256, n.mod(1000).div(100), 9, s1, q2);
    let s3 = weighted_le((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100), (43758137392 + 1 * 9) + 256 * 9,
        65536, n.mod(1000).mod(100).div(10), 9, s2, q3);
    let base: (43758137392 + 15 < 1099511627776) = lit_lt(43758137392 + 15, 1099511627776, trivial);
    ⟨base, ⟨step_fits(n, 43758137392, 10000, small, lit_lt(43758137392, 1099511627776, trivial), step_big(10000, trivial)), ⟨small, ⟨base,
        ⟨n.mod_lt(1000, trivial), ⟨room_of(43758137392 + 1 * n.div(1000), 43758137392 + 1 * 9, 3840, s1, trivial),
        ⟨n.mod(1000).mod_lt(100, trivial), ⟨room_of((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100), (43758137392 + 1 * 9) + 256 * 9, 983040, s2, trivial),
        ⟨n.mod(1000).mod(100).mod_lt(10, trivial),
        ⟨room_of(((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10),
            ((43758137392 + 1 * 9) + 256 * 9) + 65536 * 9, 251658240, s3, trivial),
        ⟨n.mod(1000).mod(100).mod(10).mod_one(),
        ⟨below_wider(n.div(10).div(10).div(10), 10, 208, top_digit_small(n, small), trivial),
        ⟨below_wider(n.div(10).div(10).mod(10), 10, 208, n.div(10).div(10).mod_lt(10, trivial), trivial),
        ⟨below_wider(n.div(10).mod(10), 10, 208, n.div(10).mod_lt(10, trivial), trivial),
        below_wider(n.mod(10), 10, 208, n.mod_lt(10, trivial), trivial)⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩⟩
}

// The formatter's digits are the spec's. The formatter divides once by each
// place value and keeps the remainder; the spec divides by ten again and
// again. The kit's nesting laws say those agree.
theorem thousands_digit(n: Nat): n.div(1000) = n.div(10).div(10).div(10) {
    sym(trans(Nat::cong(λ (x: Nat) => x.div(10), n.div_div(10, 10, trivial, trivial)), n.div_div(100, 10, trivial, trivial)))
}
theorem hundreds_digit(n: Nat): n.mod(1000).div(100) = n.div(10).div(10).mod(10) {
    sym(trans(Nat::cong(λ (x: Nat) => x.mod(10), n.div_div(10, 10, trivial, trivial)), n.div_mod_eq_mod_div(100, 10, trivial, trivial)))
}
theorem tens_digit(n: Nat): n.mod(1000).mod(100).div(10) = n.div(10).mod(10) {
    trans(Nat::cong(λ (x: Nat) => x.div(10), n.mod_mul_mod(100, 10, trivial, trivial)), sym(n.div_mod_eq_mod_div(10, 10, trivial, trivial)))
}
theorem units_digit(n: Nat): n.mod(1000).mod(100).mod(10).div(1) = n.mod(10) {
    trans(n.mod(1000).mod(100).mod(10).div_one(),
        trans(Nat::cong(λ (x: Nat) => x.mod(10), n.mod_mul_mod(100, 10, trivial, trivial)), n.mod_mul_mod(10, 10, trivial, trivial)))
}

theorem digits_agree(n: Nat):
    (n.div(1000) = n.div(10).div(10).div(10)) ∧ ((n.mod(1000).div(100) = n.div(10).div(10).mod(10)) ∧
    ((n.mod(1000).mod(100).div(10) = n.div(10).mod(10)) ∧ (n.mod(1000).mod(100).mod(10).div(1) = n.mod(10)))) {
    ⟨thousands_digit(n), ⟨hundreds_digit(n), ⟨tens_digit(n), units_digit(n)⟩⟩⟩
}

// The four digits placed in their bytes, over variables.
theorem line_combine(a, b, c, d, a2, b2, c2, d2: Nat, ea: a = a2, eb: b = b2, ec: c = c2, ed: d = d2):
    ((((43758137392 + 1 * a) + 256 * b) + 65536 * c) + 16777216 * d) =
    (48 + a2) + 256 * ((48 + b2) + 256 * ((48 + c2) + 256 * ((48 + d2) + 256 * (10 + 256 * (0 + 256 * (0 + 256 * 0)))))) { omega }

// The word after each digit group, named so that proofs about the chain
// mention one state, not the sixteen steps under it.
fn line_state_start(n: Nat) → BitVec(64) { raise(bitvec_nat::word_of_nat(64, n)).add(BitVec::ofNat(43758137392)) }

fn line_state_thousands(n: Nat) → BitVec(64) { place(place(place(place(line_state_start(n), BitVec::ofNat(1099511627776 * 8000), BitVec::ofNat(8)), BitVec::ofNat(1099511627776 * 4000), BitVec::ofNat(4)), BitVec::ofNat(1099511627776 * 2000), BitVec::ofNat(2)), BitVec::ofNat(1099511627776 * 1000), BitVec::ofNat(1)) }

fn line_state_hundreds(n: Nat) → BitVec(64) { place(place(place(place(line_state_thousands(n), BitVec::ofNat(1099511627776 * 800), BitVec::ofNat(2048)), BitVec::ofNat(1099511627776 * 400), BitVec::ofNat(1024)), BitVec::ofNat(1099511627776 * 200), BitVec::ofNat(512)), BitVec::ofNat(1099511627776 * 100), BitVec::ofNat(256)) }

fn line_state_tens(n: Nat) → BitVec(64) { place(place(place(place(line_state_hundreds(n), BitVec::ofNat(1099511627776 * 80), BitVec::ofNat(524288)), BitVec::ofNat(1099511627776 * 40), BitVec::ofNat(262144)), BitVec::ofNat(1099511627776 * 20), BitVec::ofNat(131072)), BitVec::ofNat(1099511627776 * 10), BitVec::ofNat(65536)) }

fn line_state_units(n: Nat) → BitVec(64) { place(place(place(place(line_state_tens(n), BitVec::ofNat(1099511627776 * 8), BitVec::ofNat(134217728)), BitVec::ofNat(1099511627776 * 4), BitVec::ofNat(67108864)), BitVec::ofNat(1099511627776 * 2), BitVec::ofNat(33554432)), BitVec::ofNat(1099511627776 * 1), BitVec::ofNat(16777216)) }

// `raise`'s value in scope makes it a leaf: `bv_omega` would otherwise take
// its forty doublings apart again.
theorem line_state_start_value(n: Nat, small: n < 10000): line_state_start(n).toNat() = 1099511627776 * n + 43758137392 {
    let raised = raise_value(n, omega);
    bv_omega
}

theorem line_word_value(n: Nat, small: n < 10000):
    line_word(bitvec_nat::word_of_nat(64, n)).toNat() = (48 + n.div(10).div(10).div(10)) + 256 * ((48 + n.div(10).div(10).mod(10)) + 256 * ((48 + n.div(10).mod(10)) + 256 * ((48 + n.mod(10)) + 256 * (10 + 256 * (0 + 256 * (0 + 256 * 0)))))) {
    let pre = line_prereqs(n, small);
    let agree = digits_agree(n);
    let s0: (line_state_start(n).toNat() = 1099511627776 * n + 43758137392) = line_state_start_value(n, small);
    let v0: (line_state_thousands(n).toNat() = 1099511627776 * n.mod(1000) + (43758137392 + 1 * n.div(1000))) =
        four_steps(line_state_start(n), n, 43758137392, 8000, 8, 4000, 4, 2000, 2, 1000, 1, s0, thousands_arith(n, 43758137392, pre.right.right.left, pre.right.right.right.left));
    let v1: (line_state_hundreds(n).toNat() = 1099511627776 * n.mod(1000).mod(100) + ((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100))) =
        four_steps(line_state_thousands(n), n.mod(1000), (43758137392 + 1 * n.div(1000)), 800, 2048, 400, 1024, 200, 512, 100, 256, v0, hundreds_arith(n.mod(1000), (43758137392 + 1 * n.div(1000)), pre.right.right.right.right.left, pre.right.right.right.right.right.left));
    let v2: (line_state_tens(n).toNat() = 1099511627776 * n.mod(1000).mod(100).mod(10) + (((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10))) =
        four_steps(line_state_hundreds(n), n.mod(1000).mod(100), ((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)), 80, 524288, 40, 262144, 20, 131072, 10, 65536, v1, tens_arith(n.mod(1000).mod(100), ((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)), pre.right.right.right.right.right.right.left, pre.right.right.right.right.right.right.right.left));
    let v3: (line_state_units(n).toNat() = 1099511627776 * n.mod(1000).mod(100).mod(10).mod(1) + ((((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10)) + 16777216 * n.mod(1000).mod(100).mod(10).div(1))) =
        four_steps(line_state_tens(n), n.mod(1000).mod(100).mod(10), (((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10)), 8, 134217728, 4, 67108864, 2, 33554432, 1, 16777216, v2, units_arith(n.mod(1000).mod(100).mod(10), (((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10)), pre.right.right.right.right.right.right.right.right.left, pre.right.right.right.right.right.right.right.right.right.left));
    trans(restate(line_state_units(n).toNat(), n.mod(1000).mod(100).mod(10).mod(1), ((((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100)) + 65536 * n.mod(1000).mod(100).div(10)) + 16777216 * n.mod(1000).mod(100).mod(10).div(1)), 0, (48 + n.div(10).div(10).div(10)) + 256 * ((48 + n.div(10).div(10).mod(10)) + 256 * ((48 + n.div(10).mod(10)) + 256 * ((48 + n.mod(10)) + 256 * (10 + 256 * (0 + 256 * (0 + 256 * 0)))))), v3, pre.right.right.right.right.right.right.right.right.right.right.left,
            line_combine(n.div(1000), n.mod(1000).div(100), n.mod(1000).mod(100).div(10), n.mod(1000).mod(100).mod(10).div(1), n.div(10).div(10).div(10), n.div(10).div(10).mod(10), n.div(10).mod(10), n.mod(10), agree.left, agree.right.left, agree.right.right.left, agree.right.right.right)),
        Nat::add_left_zero((48 + n.div(10).div(10).div(10)) + 256 * ((48 + n.div(10).div(10).mod(10)) + 256 * ((48 + n.div(10).mod(10)) + 256 * ((48 + n.mod(10)) + 256 * (10 + 256 * (0 + 256 * (0 + 256 * 0))))))))
}

// ---------------------------------------------------------------------------
// The word's bytes.

// Split one byte, with its remaining value stated for the next step.
theorem byte_parts(m: Nat, x: BitVec(m + 8), b, rest: Nat,
    value: x.toNat() = b + 256 * rest, small: b < 256):
    (x.take_low(8, m) = BitVec::ofNat(b)) ∧ (x.drop_low(8, m).toNat() = rest) {
    ⟨bv_omega, bv_omega⟩
}

theorem eight_cong<A>(a0, a1, a2, a3, a4, a5, a6, a7, c0, c1, c2, c3, c4, c5, c6, c7: A,
    e0: a0 = c0, e1: a1 = c1, e2: a2 = c2, e3: a3 = c3, e4: a4 = c4, e5: a5 = c5, e6: a6 = c6, e7: a7 = c7):
    Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(c3, Cons(c4, Cons(c5, Cons(c6, Cons(c7, Nil)))))))) {
    let r0 = j(e0, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(y, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))), refl);
    let r1 = j(e1, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(y, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))), r0);
    let r2 = j(e2, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(y, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))), r1);
    let r3 = j(e3, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(y, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))), r2);
    let r4 = j(e4, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(c3, Cons(y, Cons(a5, Cons(a6, Cons(a7, Nil)))))))), r3);
    let r5 = j(e5, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(c3, Cons(c4, Cons(y, Cons(a6, Cons(a7, Nil)))))))), r4);
    let r6 = j(e6, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(c3, Cons(c4, Cons(c5, Cons(y, Cons(a7, Nil)))))))), r5);
    j(e7, λ y _ => Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7, Nil)))))))) = Cons(c0, Cons(c1, Cons(c2, Cons(c3, Cons(c4, Cons(c5, Cons(c6, Cons(y, Nil)))))))), r6)
}

theorem byte_of_value(x: BitVec(8), b: Nat, value: x.toNat() = b): x = BitVec::ofNat(b) { bv_omega }

// A word's bytes are its base-256 digits, low first.
theorem word_bytes_of(v: BitVec(64), b0, b1, b2, b3, b4, b5, b6, b7: Nat,
    value: v.toNat() = b0 + 256 * (b1 + 256 * (b2 + 256 * (b3 + 256 * (b4 + 256 * (b5 + 256 * (b6 + 256 * b7)))))),
    s0: b0 < 256, s1: b1 < 256, s2: b2 < 256, s3: b3 < 256, s4: b4 < 256, s5: b5 < 256, s6: b6 < 256, s7: b7 < 256):
    word_bytes(v) = [BitVec::ofNat(b0), BitVec::ofNat(b1), BitVec::ofNat(b2), BitVec::ofNat(b3), BitVec::ofNat(b4), BitVec::ofNat(b5), BitVec::ofNat(b6), BitVec::ofNat(b7)] {
    let e0 = byte_parts(56, v, b0, b1 + 256 * (b2 + 256 * (b3 + 256 * (b4 + 256 * (b5 + 256 * (b6 + 256 * b7))))), value, s0);
    let e1 = byte_parts(48, imm_rest0(v), b1, b2 + 256 * (b3 + 256 * (b4 + 256 * (b5 + 256 * (b6 + 256 * b7)))), e0.right, s1);
    let e2 = byte_parts(40, imm_rest1(v), b2, b3 + 256 * (b4 + 256 * (b5 + 256 * (b6 + 256 * b7))), e1.right, s2);
    let e3 = byte_parts(32, imm_rest2(v), b3, b4 + 256 * (b5 + 256 * (b6 + 256 * b7)), e2.right, s3);
    let e4 = byte_parts(24, imm_rest3(v), b4, b5 + 256 * (b6 + 256 * b7), e3.right, s4);
    let e5 = byte_parts(16, imm_rest4(v), b5, b6 + 256 * b7, e4.right, s5);
    let e6 = byte_parts(8, imm_rest5(v), b6, b7, e5.right, s6);
    eight_cong<BitVec(8)>(imm_byte0(v), imm_byte1(v), imm_byte2(v), imm_byte3(v), imm_byte4(v), imm_byte5(v), imm_byte6(v), imm_byte7(v), BitVec::ofNat(b0, n := 8), BitVec::ofNat(b1, n := 8), BitVec::ofNat(b2, n := 8), BitVec::ofNat(b3, n := 8), BitVec::ofNat(b4, n := 8), BitVec::ofNat(b5, n := 8), BitVec::ofNat(b6, n := 8), BitVec::ofNat(b7, n := 8),
        e0.left, e1.left, e2.left, e3.left, e4.left, e5.left, e6.left, byte_of_value(imm_byte7(v), b7, e6.right))
}

// A digit's character code fits its byte.
theorem byte_of_digit(d: Nat, h: d < 10): 48 + d < 256 {
    Succ(48 + d).le_trans(48 + 10, 256, (48).add_le_mono_l(Succ(d), 10, h), Nat::leb_sound(48 + 10, 256, trivial))
}

theorem digit_bounds(n: Nat, small: n < 10000):
    (48 + n.div(10).div(10).div(10) < 256) ∧ ((48 + n.div(10).div(10).mod(10) < 256) ∧ ((48 + n.div(10).mod(10) < 256) ∧ (48 + n.mod(10) < 256))) {
    ⟨byte_of_digit(n.div(10).div(10).div(10), top_digit_small(n, small)), ⟨byte_of_digit(n.div(10).div(10).mod(10), n.div(10).div(10).mod_lt(10, trivial)),
        ⟨byte_of_digit(n.div(10).mod(10), n.div(10).mod_lt(10, trivial)), byte_of_digit(n.mod(10), n.mod_lt(10, trivial))⟩⟩⟩
}

// What the formatter stores, byte by byte.
theorem line_word_bytes(n: Nat, small: n < 10000): word_bytes(line_word(bitvec_nat::word_of_nat(64, n))) = line_bytes(n) {
    let bounds = digit_bounds(n, small);
    word_bytes_of(line_word(bitvec_nat::word_of_nat(64, n)), 48 + n.div(10).div(10).div(10), 48 + n.div(10).div(10).mod(10), 48 + n.div(10).mod(10), 48 + n.mod(10), 10, 0, 0, 0,
        line_word_value(n, small), bounds.left, bounds.right.left, bounds.right.right.left, bounds.right.right.right,
        trivial, trivial, trivial, trivial)
}

// ---------------------------------------------------------------------------
// Where the line starts, and how long it is.

theorem below_value(n, c: Nat, small: n < 1152921504606846976, c_small: c < 1152921504606846976):
    below(bitvec_nat::word_of_nat(64, n), BitVec::ofNat(c)).toNat() = below_nat(n, c) {
    let x = bitvec_nat::word_of_nat(64, n);
    let limit = BitVec::ofNat(c, n := 64);
    let xv: (x.toNat() = n) = bitvec_nat::toNat_word_of_nat(64, n, below_word(n, small));
    let lv: (limit.toNat() = c) = BitVec::toNat_ofNat(64, c, below_word(c, c_small));
    let test: (x.unsigned_lt_bit(limit) = Succ(n).leb(c)) = trans(bitvec_nat::unsigned_lt_nat(64, x, limit),
        trans(@cong(λ (a: Nat) => Succ(a).leb(limit.toNat()), x.toNat(), n, xv), @cong(λ (b: Nat) => Succ(n).leb(b), limit.toNat(), c, lv)));
    let cases: ((match Succ(n).leb(c) { True => BitVec::ofNat(1, n := 64), False => BitVec::ofNat(0, n := 64) }).toNat() = below_nat(n, c)) =
        match Succ(n).leb(c) as λ b => (match b { True => BitVec::ofNat(1, n := 64), False => BitVec::ofNat(0, n := 64) }).toNat() =
            (match b { True => 1, False => 0 }) { True => refl, False => refl };
    j(sym(test), λ b _ => (match b { True => BitVec::ofNat(1, n := 64), False => BitVec::ofNat(0, n := 64) }).toNat() = below_nat(n, c), cases)
}

theorem below_nat_le(n, c: Nat): below_nat(n, c) <= 1 {
    match Succ(n).leb(c) as λ b => (match b { True => 1, False => 0 }) <= 1 { True => trivial, False => trivial }
}

theorem leading_zeros_value(n: Nat, small: n < 10000): leading_zeros(bitvec_nat::word_of_nat(64, n)).toNat() = line_skip(n) {
    let x = bitvec_nat::word_of_nat(64, n);
    let n_small: (n < 1152921504606846976) = omega;
    let b10 = below_value(n, 10, n_small, omega);
    let b100 = below_value(n, 100, n_small, omega);
    let b1000 = below_value(n, 1000, n_small, omega);
    let l10 = below_nat_le(n, 10);
    let l100 = below_nat_le(n, 100);
    let l1000 = below_nat_le(n, 1000);
    let two: (below(x, BitVec::ofNat(10)).add(below(x, BitVec::ofNat(100))).toNat() = below_nat(n, 10) + below_nat(n, 100)) =
        bitvec_nat::add_words(64, below(x, BitVec::ofNat(10)), below(x, BitVec::ofNat(100)), below_nat(n, 10), below_nat(n, 100), b10, b100,
            below_word(below_nat(n, 10) + below_nat(n, 100), omega));
    bitvec_nat::add_words(64, below(x, BitVec::ofNat(10)).add(below(x, BitVec::ofNat(100))), below(x, BitVec::ofNat(1000)),
        below_nat(n, 10) + below_nat(n, 100), below_nat(n, 1000), two, b1000,
        below_word(below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000), omega))
}

theorem line_skip_le(n: Nat): line_skip(n) <= 3 {
    let a = below_nat_le(n, 10);
    let b = below_nat_le(n, 100);
    let c = below_nat_le(n, 1000);
    let r: (below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) <= 3) = omega;
    r
}

theorem line_start_value(n: Nat, small: n < 10000):
    line_start(BitVec::ofNat(0x401000), bitvec_nat::word_of_nat(64, n)).toNat() = 0x401000 + line_skip(n) {
    let zeros = leading_zeros_value(n, small);
    let skip = line_skip_le(n);
    bv_omega
}

theorem line_length_value(n: Nat, small: n < 10000):
    line_length(bitvec_nat::word_of_nat(64, n)).toNat() = 5 -line_skip(n) {
    let zeros = leading_zeros_value(n, small);
    let skip = line_skip_le(n);
    bv_omega
}

// ---------------------------------------------------------------------------
// The line inside the stored word.

theorem below_yes(n, c: Nat, h: n < c): below_nat(n, c) = 1 {
    j(sym(leb_yes(Succ(n), c, h)), λ b _ => (match b { True => 1, False => 0 }) = 1, refl)
}
theorem below_no(n, c: Nat, h: c <= n): below_nat(n, c) = 0 {
    j(sym(leb_no(Succ(n), c, h)), λ b _ => (match b { True => 1, False => 0 }) = 0, refl)
}

// What a write of the line reads: its bytes from `line_skip(n)` in the
// stored word, and its length.
fn LineInWord(n: Nat) → Type {
    ((i: Nat) → (b: BitVec(8)) → decimal_line(n).nth(i) = Some(b) → line_bytes(n).nth(i + line_skip(n)) = Some(b)) ∧
    (decimal_line(n).len() = 5 -line_skip(n))
}

theorem line_thousands(n: Nat, lo: 1000 <= n, hi: n < 10000): LineInWord(n) {
    let skip: (line_skip(n) = 0) = {
        let a = below_no(n, 10, omega);
        let b = below_no(n, 100, omega);
        let c = below_no(n, 1000, lo);
        let r: (below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) = 0) = omega;
        r
    };
    let digits: (decimal(n) = Cons(digit(n.div(10).div(10).div(10)), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil))))) = decimal_four(n, n, lo, omega, omega);
    let line: (decimal_line(n) = Cons(digit(n.div(10).div(10).div(10)), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)))))) =
        @cong(λ (xs: List<BitVec(8)>) => xs ++ Cons(BitVec::ofNat(10, n := 8), Nil), decimal(n), Cons(digit(n.div(10).div(10).div(10)), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil)))), digits);
    let reads = λ (i: Nat) (b: BitVec(8)) (at: decimal_line(n).nth(i) = Some(b)) =>
        j(sym(skip), λ k _ => line_bytes(n).nth(i + k) = Some(b),
            list::List::nth_append_l(Cons(digit(n.div(10).div(10).div(10)), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))))), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Nil))), i, b,
                j(line, λ xs _ => xs.nth(i) = Some(b), at)));
    ⟨reads, trans(@cong(λ (xs: List<BitVec(8)>) => xs.len(), decimal_line(n), Cons(digit(n.div(10).div(10).div(10)), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))))), line),
        @cong(λ (k: Nat) => 5 -k, 0, line_skip(n), sym(skip)))⟩
}

theorem line_hundreds(n: Nat, lo: 100 <= n, hi: n < 1000): LineInWord(n) {
    let skip: (line_skip(n) = 1) = {
        let a = below_no(n, 10, omega);
        let b = below_no(n, 100, lo);
        let c = below_yes(n, 1000, hi);
        let r: (below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) = 1) = omega;
        r
    };
    let top: (n.div(10).div(10) = n.div(10).div(10).mod(10)) =
        sym(n.div(10).div(10).mod_of_lt(10, n.div(10).div_lt_of_lt_mul(10, 10, n.div_lt_of_lt_mul(10, 100, hi))));
    let digits: (decimal(n) = Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil)))) =
        trans(decimal_three(n, n, lo, omega, omega),
            @cong(λ (d: Nat) => Cons(digit(d), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil))), n.div(10).div(10), n.div(10).div(10).mod(10), top));
    let line: (decimal_line(n) = Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))))) =
        @cong(λ (xs: List<BitVec(8)>) => xs ++ Cons(BitVec::ofNat(10, n := 8), Nil), decimal(n), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil))), digits);
    let reads = λ (i: Nat) (b: BitVec(8)) (at: decimal_line(n).nth(i) = Some(b)) =>
        j(sym(skip), λ k _ => line_bytes(n).nth(i + k) = Some(b),
            list::List::nth_append_l(Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)))), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Nil))), i, b,
                j(line, λ xs _ => xs.nth(i) = Some(b), at)));
    ⟨reads, trans(@cong(λ (xs: List<BitVec(8)>) => xs.len(), decimal_line(n), Cons(digit(n.div(10).div(10).mod(10)), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)))), line),
        @cong(λ (k: Nat) => 5 -k, 1, line_skip(n), sym(skip)))⟩
}

theorem line_tens(n: Nat, lo: 10 <= n, hi: n < 100): LineInWord(n) {
    let skip: (line_skip(n) = 2) = {
        let a = below_no(n, 10, lo);
        let b = below_yes(n, 100, hi);
        let c = below_yes(n, 1000, omega);
        let r: (below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) = 2) = omega;
        r
    };
    let top: (n.div(10) = n.div(10).mod(10)) = sym(n.div(10).mod_of_lt(10, n.div_lt_of_lt_mul(10, 10, hi)));
    let digits: (decimal(n) = Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil))) =
        trans(decimal_two(n, n, lo, omega, omega),
            @cong(λ (d: Nat) => Cons(digit(d), Cons(digit(n.mod(10)), Nil)), n.div(10), n.div(10).mod(10), top));
    let line: (decimal_line(n) = Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)))) =
        @cong(λ (xs: List<BitVec(8)>) => xs ++ Cons(BitVec::ofNat(10, n := 8), Nil), decimal(n), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Nil)), digits);
    let reads = λ (i: Nat) (b: BitVec(8)) (at: decimal_line(n).nth(i) = Some(b)) =>
        j(sym(skip), λ k _ => line_bytes(n).nth(i + k) = Some(b),
            list::List::nth_append_l(Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Nil))), i, b,
                j(line, λ xs _ => xs.nth(i) = Some(b), at)));
    ⟨reads, trans(@cong(λ (xs: List<BitVec(8)>) => xs.len(), decimal_line(n), Cons(digit(n.div(10).mod(10)), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))), line),
        @cong(λ (k: Nat) => 5 -k, 2, line_skip(n), sym(skip)))⟩
}

theorem line_units(n: Nat, hi: n < 10): LineInWord(n) {
    let skip: (line_skip(n) = 3) = {
        let a = below_yes(n, 10, hi);
        let b = below_yes(n, 100, omega);
        let c = below_yes(n, 1000, omega);
        let r: (below_nat(n, 10) + below_nat(n, 100) + below_nat(n, 1000) = 3) = omega;
        r
    };
    let same: (n = n.mod(10)) = sym(n.mod_of_lt(10, hi));
    let digits: (decimal(n) = Cons(digit(n.mod(10)), Nil)) =
        trans(decimal_one(n, n, omega), @cong(λ (d: Nat) => Cons(digit(d), Nil), n, n.mod(10), same));
    let line: (decimal_line(n) = Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil))) =
        @cong(λ (xs: List<BitVec(8)>) => xs ++ Cons(BitVec::ofNat(10, n := 8), Nil), decimal(n), Cons(digit(n.mod(10)), Nil), digits);
    let reads = λ (i: Nat) (b: BitVec(8)) (at: decimal_line(n).nth(i) = Some(b)) =>
        j(sym(skip), λ k _ => line_bytes(n).nth(i + k) = Some(b),
            list::List::nth_append_l(Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Cons(BitVec::ofNat(0, n := 8), Nil))), i, b,
                j(line, λ xs _ => xs.nth(i) = Some(b), at)));
    ⟨reads, trans(@cong(λ (xs: List<BitVec(8)>) => xs.len(), decimal_line(n), Cons(digit(n.mod(10)), Cons(BitVec::ofNat(10, n := 8), Nil)), line),
        @cong(λ (k: Nat) => 5 -k, 3, line_skip(n), sym(skip)))⟩
}

theorem line_in_word(n: Nat, small: n < 10000): LineInWord(n) {
    match Nat::le_dec(1000, n) {
        Inl(lo) => line_thousands(n, lo, small),
        Inr(under) => match Nat::le_dec(100, n) {
            Inl(lo) => line_hundreds(n, lo, omega),
            Inr(under2) => match Nat::le_dec(10, n) {
                Inl(lo) => line_tens(n, lo, omega),
                Inr(under3) => line_units(n, omega),
            },
        },
    }
}

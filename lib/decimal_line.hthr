fn line_state_start(n: Nat) → BitVec(64) { raise(bitvec_nat::word_of_nat(64, n)).add(BitVec::ofNat(43758137392)) }

fn line_state_thousands(n: Nat) → BitVec(64) { place(place(place(place(line_state_start(n), BitVec::ofNat(1099511627776 * 8000), BitVec::ofNat(8)), BitVec::ofNat(1099511627776 * 4000), BitVec::ofNat(4)), BitVec::ofNat(1099511627776 * 2000), BitVec::ofNat(2)), BitVec::ofNat(1099511627776 * 1000), BitVec::ofNat(1)) }


        below_word(n * 1099511627776 + 43758137392, j(sym(Nat::mul_comm(n, 1099511627776)), λ t _ => t + 43758137392 < 1152921504606846976, pre.right.left)));
    let s0: (line_state_start(n).toNat() = 1099511627776 * n + 43758137392) = trans(sum, @cong(λ (t: Nat) => t + 43758137392, n * 1099511627776, 1099511627776 * n, Nat::mul_comm(n, 1099511627776)));
    let v0: (line_state_thousands(n).toNat() = 1099511627776 * n.mod(1000) + (43758137392 + 1 * n.div(1000))) =
        four_steps(line_state_start(n), n, 43758137392, 8000, 8, 4000, 4, 2000, 2, 1000, 1, s0, thousands_arith(n, 43758137392, pre.right.right.left, pre.right.right.right.left));
    let v1: (line_state_hundreds(n).toNat() = 1099511627776 * n.mod(1000).mod(100) + ((43758137392 + 1 * n.div(1000)) + 256 * n.mod(1000).div(100))) =

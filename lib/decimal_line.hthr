// The formatter's digits are the spec's: over variables for `n / 10` and
// `n / 100`, since `omega`'s certificate for a division of a division is
// refused by the kernel. One lemma per digit, each with only the facts it
// uses: `omega`'s certificate grows with every atom in scope.
theorem thousands_digit(n, a, b: Nat, ha: n = a * 10 + n.mod(10), hb: a = b * 10 + a.mod(10)): n.div(1000) = b.div(10) { omega }
theorem hundreds_digit(n, a, b: Nat, ha: n = a * 10 + n.mod(10), hb: a = b * 10 + a.mod(10)): n.mod(1000).div(100) = b.mod(10) { omega }
theorem tens_digit(n, a: Nat, ha: n = a * 10 + n.mod(10)): n.mod(1000).mod(100).div(10) = a.mod(10) { omega }
theorem units_digit(n: Nat): n.mod(1000).mod(100).mod(10).div(1) = n.mod(10) { omega }

theorem digits_agree(n, a, b: Nat, ha: n = a * 10 + n.mod(10), hb: a = b * 10 + a.mod(10), small: n < 10000):
    (n.div(1000) = b.div(10)) ∧ ((n.mod(1000).div(100) = b.mod(10)) ∧ ((n.mod(1000).mod(100).div(10) = a.mod(10)) ∧
    (n.mod(1000).mod(100).mod(10).div(1) = n.mod(10)))) {
    ⟨thousands_digit(n, a, b, ha, hb), ⟨hundreds_digit(n, a, b, ha, hb), ⟨tens_digit(n, a, ha), units_digit(n)⟩⟩⟩
}


// Logical loaded-memory interpretation of the restricted static ELF profile.
// This specifies the mapping supplied by the OS; it does not verify Linux.
// The whole file is RX at 0x400000, with p_memsz = p_filesz (no zero-fill).
// The unused process stack and all other mappings lie outside this view.
import elf64;
import x86_64;
import x86_64_fetch;
import bitvec;
import bool;
import nat;
import list;
import option;
import logic;

// The profile fits inside a single 64-KiB address window. Splitting the
// address avoids unary subtraction of the 0x400000 mapping base.
fn static_elf64_address(offset: BitVec(16)) → BitVec(64) {
    offset.concat(@BitVec::ofNat(48, 64))
}

fn static_elf64_entry() → BitVec(64) {
    static_elf64_address(BitVec::ofNat(176))
}

fn static_elf64_read(file: List<BitVec(8)>, address: BitVec(64)) → Option<BitVec(8)> {
    match is_zero_bits(48,
        address.drop_low(16, 48).bxor(BitVec::ofNat(64))) {
        True => file.nth(address.take_low(16, 48).toNat()),
        False => None,
    }
}

// In this RX-only image view exactly the file-backed bytes are executable.
// A missing byte denies fetch; there is no implicit executable padding.
fn static_elf64_executable(file: List<BitVec(8)>, address: BitVec(64)) → Bool {
    match static_elf64_read(file, address) { None => False, Some(_) => True }
}

// Skip a checked file prefix when reading code: a certificate that has named
// its header once reads a code byte at an offset into the code list instead
// of traversing the header again for every fetched byte.
theorem static_elf64_read_split(header, code: List<BitVec(8)>, count, index: Nat,
    address: BitVec(64), byte: BitVec(8), length: header.len() = count,
    page: is_zero_bits(48, address.drop_low(16, 48).bxor(BitVec::ofNat(64))) = True,
    offset: address.take_low(16, 48).toNat() = index + count,
    found: code.nth(index) = Some(byte)):
    static_elf64_read(header ++ code, address) = Some(byte) {
    let indexed = j(length, λ size _ => (header ++ code).nth(index + size) = code.nth(index), header.nth_append_r(code, index));
    let read = trans(cong_fn<Nat, Option<BitVec(8)>>(λ position => (header ++ code).nth(position), offset), trans(indexed, found));
    j(sym(page), λ decision _ =>
        (match decision as λ _ => Option<BitVec(8)> {
            True => (header ++ code).nth(address.take_low(16, 48).toNat()),
            False => None,
        }) = Some(byte), read)
}

fn static_elf64_access() → FetchAccess<List<BitVec(8)>> {
    FetchAccess(static_elf64_read, static_elf64_executable)
}

// A file-backed byte establishes both RX permission and the observable byte,
// stated in the access's own spelling so a fetch lemma's premises match it
// without unfolding the file read.
theorem static_elf64_observation(file: List<BitVec(8)>, address: BitVec(64), byte: BitVec(8),
    present: static_elf64_read(file, address) = Some(byte)):
    static_elf64_access().executable(file, address) = True ∧
    static_elf64_access().read_byte(file, address) = Some(byte) {
    j(sym(present), λ value _ =>
        (match value as λ _ => Bool { None => False, Some(_) => True }) = True ∧
        value = Some(byte), ⟨refl, refl⟩)
}
theorem static_elf64_fetch_one(file: List<BitVec(8)>, address: BitVec(64), byte: BitVec(8),
    present: static_elf64_read(file, address) = Some(byte)):
    FetchedFrom(static_elf64_access(), file, InstructionBytes(address, [byte])) {
    let observed = static_elf64_observation(file, address, byte, present);
    fetch_span_one(static_elf64_access(), file, address, byte, observed.left, observed.right)
}
theorem static_elf64_fetch_more(file: List<BitVec(8)>, address, next: BitVec(64), byte, next_byte: BitVec(8), rest: List<BitVec(8)>,
    present: static_elf64_read(file, address) = Some(byte),
    no_wrap: address.carry_add_bit(BitVec::ofNat(1)) = False,
    next_correct: next_rip(address, 1) = next,
    tail: FetchedFrom(static_elf64_access(), file, InstructionBytes(next, Cons(next_byte, rest)))):
    FetchedFrom(static_elf64_access(), file, InstructionBytes(address, Cons(byte, Cons(next_byte, rest)))) {
    let observed = static_elf64_observation(file, address, byte, present);
    fetch_span_more(static_elf64_access(), file, address, next, byte, next_byte, rest,
        observed.left, observed.right, no_wrap, next_correct, tail)
}

fn static_elf64_initial(file: List<BitVec(8)>, gprs: Gprs, flags: Flags) →
    MachineState<List<BitVec(8)>>
{
    MachineState(gprs, flags, static_elf64_entry(), file)
}

// This is a per-image certificate: the supplied file must be the bytes of a
// valid restricted ELF, not merely an arbitrary list used as memory.
record StaticElf64Loaded(code: List<BitVec(8)>, file: List<BitVec(8)>) {
    image: StaticElf64Image(code),
    file_correct: file = static_elf64_bytes(image),
}

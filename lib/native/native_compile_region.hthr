// Where a compiled program keeps the environment (issues/native-effect-source-compiler.md,
// round S3.2; docs/native/native-procedures-are-functions-design.md, step 5b): the
// buffers in one data region of the byte model, each at its capacity, then
// the scratch range a read lands in, then the slot RSP is saved to; and the
// words in the running activation's frame on the stack, slot `i` the word
// at RSP + 8i (`Target::slot`).
//
// `Placed(env, m)` is the memory's half of the invariant between
// statements (`Target::Held`, native_compile_homes, adds the registers
// words live in): the region holds cells `v`, `v` keeps the environment
// (`Layout::Keeps`), and the command line is at the saved RSP above the
// region (`Target::Stacked`).
//
// The cells are one function for both halves. Below the region's size they
// are the region's bytes (`DataRegion::Holds`); from `Layout::frame_cell`
// up, past where any region reaches, they are the frame's words, which the
// stack holds (`Target::Slots`). So a claim that carries the cells through
// the region's stores, as every loop that copies bytes does, carries the
// frame's words with them and says nothing more: the stores do not reach
// those cells, nor the stack.
//
// Every store the code makes lands in the region or the frame, which
// nothing executes, so the program stays resident; and each moves `Keeps`
// one way: a word stored to its slot keeps the environment with that word
// set (`keeps_word`), anything written to the scratch range keeps it as it
// was (`keeps_agree`), and a read's bytes copied to their buffer keep it
// with that buffer filled (`keeps_fill`). No store of the region's reaches
// above it, so the command line and the stack stay as they were
// (`Target::kept_store`, `stack_read_store`), and none reaches the RSP slot.
import native_source;
import span_set;
import native_compile;
import native_alloc;
import native_compile_facts;
import function_ir;
import function_ir_eval;
import linux_calls;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_sim;
import x86_64;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_store;
import x86_64_byte_memory;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack;
import x86_64_stack_runs;
import native_compile_steps;
import itree;
import linux_trees;
import memory;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Where a program runs: its code, its region, and the buffers' capacities

record Target {
    r: DataRegion,
    // The words' room the region keeps before its buffers: the program's,
    // whichever activation runs.
    reserved: Nat,
    words: Nat,
    caps: List<Nat>,
    // Each word's home (native_alloc), every register in the pool.
    homes: Homes,
    homed: homes.fits().IsTrue(),
    fits: Layout::placed(r.low, reserved, words, caps, homes).size() <= r.size,
    program: Prog,
    origin: BitVec(64),
    laid: program.laid_out().IsTrue(),
    // The command line the process was started with.
    args: List<List<BitVec(8)>>,
    // The procedures a call may name (docs/native/native-procedures-design.md).
    procedures: List<Procedure>,
    // The functions a region may call (docs/native/native-one-compiler-design.md
    // §2.2), compiled after the program's own code.
    functions: List<Function>,
    // The process's stack (§5): above the region and below the canonical
    // boundary, its stores Linux's.
    stack: Stack<X86Memory(r.profile)>(r.profile.linux().fetch, r.profile.linux().data),
    stack_writes: stack.writes = linux_writes(r.profile.linux()),
    stack_above: r.low.toNat() + r.size <= stack.low.toNat(),
    stack_canonical: stack.low.toNat() + stack.size <= Nat::pow(2, 47),
    // The running activation: its frame at offset `index` of the stack, a
    // word a word of the file; the words above the frame (the registers
    // it saved, its return address, then its caller's frame and so on up);
    // and how many calls deeper it may go. Below the frame is what the
    // deepest of its calls takes with that room (`List::reach`: each level
    // a return address, the registers the callee saves and the callee's
    // own frame), or the room of a function the body calls
    // (`List::functions_room`: its room under the homes' table and the
    // CALL's word), whichever is more (`List::below`); then one return
    // address more: a call with no room left is refused in the callee's
    // entry, after its CALL.
    // `main`'s frame is the stack's top, with nothing above it.
    // The procedures' placements (`Layout::body`): a callee's activation is
    // this target with the callee's frame and homes.
    bodies: List<Frame>,
    // The procedures the running body may call (`Layout.callees`).
    callees: List<Nat>,
    // The functions the running body may call (`Layout.called`).
    called: List<Nat>,
    index: Nat,
    frames: List<BitVec(64)>,
    // What the registers the homes pin held when the activation was entered,
    // by their places in the home pool: it never writes them, so they hold
    // it still, unsaved.
    pinned: List<BitVec(64)>,
    room: Nat,
    framed: index + 8 * (words + frames.len()) <= stack.size,
    roomy: callees.below(called, procedures, bodies, homes.places, homes.room_table(functions), room) + 8 <= index,
}

fn Target::layout(self t: Target) → Layout {
    Layout::tabled(t.r.low, t.reserved, t.words, t.caps, t.homes, t.procedures, t.functions, t.bodies, t.callees, t.called)
}
fn Target::io(self t: Target) → LinuxIo<X86Memory(t.r.profile)> { t.r.profile.linux() }
fn Target::site(self t: Target) → Site<X86Memory(t.r.profile)> { t.io().site(t.program, t.origin) }
fn Target::writes(self t: Target) → ByteWrites<X86Memory(t.r.profile)> { linux_writes(t.io()) }

theorem Target::code_fits(self t: Target): FillsFit(t.program, no_fills()) { t.program.laid_out_fits(t.laid) }

// An address the code spells (`Layout::word_at`, `buffer_at`, `scratch_at`)
// is the region's `next_rip` to it.
theorem Target::at_rip(self t: Target, q: Nat): t.r.low.add_nat(q) = next_rip(t.r.low, q) { BitVec::add_nat_iterate(64, t.r.low, q) }

// What a statement's code claims, over the region's profile.
fn Target::Goes(self t: Target, at: Nat, tree: ITree<BitVec(64)>(Events::linux()), pre: MachineState<X86Memory(t.r.profile)> → Type) → Type {
    t.site().Goes(t.io(), at, tree, pre)
}

// ---------------------------------------------------------------------------
// The environment in the region's cells

// The eight cells from `q`, low first, as the machine reads a word.
fn word_in(v: Nat → BitVec(8), q: Nat) → BitVec(64) {
    immediate_from_bytes(v(q), v(q + 1), v(q + 2), v(q + 3), v(q + 4), v(q + 5), v(q + 6), v(q + 7))
}

theorem word_in_agree(v, w: Nat → BitVec(8), q: Nat, same: (t: Nat) → t < 8 → v(q + t) = w(q + t)): word_in(v, q) = word_in(w, q) {
    j(same(0, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(x, w(q + 1), w(q + 2), w(q + 3), w(q + 4), w(q + 5), w(q + 6), w(q + 7)),
    j(same(1, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), x, w(q + 2), w(q + 3), w(q + 4), w(q + 5), w(q + 6), w(q + 7)),
    j(same(2, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), x, w(q + 3), w(q + 4), w(q + 5), w(q + 6), w(q + 7)),
    j(same(3, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), v(q + 2), x, w(q + 4), w(q + 5), w(q + 6), w(q + 7)),
    j(same(4, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), v(q + 2), v(q + 3), x, w(q + 5), w(q + 6), w(q + 7)),
    j(same(5, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), v(q + 2), v(q + 3), v(q + 4), x, w(q + 6), w(q + 7)),
    j(same(6, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), v(q + 2), v(q + 3), v(q + 4), v(q + 5), x, w(q + 7)),
    j(same(7, trivial), λ x _ => word_in(v, q) = immediate_from_bytes(v(q), v(q + 1), v(q + 2), v(q + 3), v(q + 4), v(q + 5), v(q + 6), x),
        refl))))))))
}

// Where the cells keep the frame's word `i`: past every region (a region
// lies below 2^47, `DataRegion.canonical`), so `DataRegion::Holds` says
// nothing of these cells, and past the layout, so no store of the region's
// moves them.
fn Layout::frame_cell(self layout: Layout, i: Nat) → Nat { Nat::pow(2, 47) + (layout.size() + 8 * i) }

theorem Layout::frame_cell_at(self layout: Layout, i: Nat): layout.frame_cell(i) = Nat::pow(2, 47) + (layout.size() + 8 * i) { refl }

// Each word in its cells, read as its number; each buffer its cells.
fn Layout::Keeps(self layout: Layout, env: Env, v: Nat → BitVec(8)) → Type {
    ((i: Nat) → i < layout.words → word_in(v, layout.frame_cell(i)).toNat() = env.number(i)) ∧
    ((b, cap: Nat) → layout.capacities.nth(b) = Some(cap) → env.buffer(b) = cells_at(v, layout.buffer_offset(b), cap))
}

// The command line read only above the stack, which nothing the program
// does writes.
fn Target::argv(self t: Target) → ByteReadAccess<X86Memory(t.r.profile)> { t.r.profile.data().above(t.stack.low.toNat() + t.stack.size) }

// The running frame's address.
fn Target::frame(self t: Target) → BitVec(64) { t.stack.at(t.index) }

// Where an offset of the stack is.
theorem Target::stack_toNat(self t: Target, i: Nat, inside: i <= t.stack.size): t.stack.at(i).toNat() = t.stack.low.toNat() + i {
    let top = canonical_below_top();
    let fits: (t.stack.low.toNat() + i < Nat::pow(2, 64)) = omega(t.stack_canonical, inside, top);
    BitVec::offset_toNat(64, t.stack.low, i, fits)
}

theorem Target::frame_toNat(self t: Target): t.frame().toNat() = t.stack.low.toNat() + t.index {
    let inside: (t.index <= t.stack.size) = omega(t.framed);
    t.stack_toNat(t.index, inside)
}

// Words of the stack in order from offset `i` up.
fn Target::FramesAt(self t: Target, m: X86Memory(t.r.profile), words: List<BitVec(64)>) → Nat → Type {
    match words {
        Nil => λ _ => True,
        Cons(word, rest) => λ i => (i + 8 <= t.stack.size) ∧
            ((read_word(t.io().data, m, t.stack.at(i)) = Some(word)) ∧ t.FramesAt(m, rest, i + 8)),
    }
}

// Words read alike at every offset from `i` up keep them.
theorem Target::frames_kept(self t: Target, m, later: X86Memory(t.r.profile), i: Nat,
    kept: (k: Nat) → i <= k → k + 8 <= t.stack.size → read_word(t.io().data, later, t.stack.at(k)) = read_word(t.io().data, m, t.stack.at(k)),
    words: List<BitVec(64)>): (k: Nat) → i <= k → t.FramesAt(m, words, k) → t.FramesAt(later, words, k) {
    match words {
        Nil => λ k _ _ => trivial,
        Cons(word, rest) => λ k above at => ⟨at.left, ⟨trans(kept(k, above, at.left), at.right.left),
            t.frames_kept(m, later, i, kept, rest, k + 8, omega(above), at.right.right)⟩⟩,
    }
}

// Slot `i` of the running frame.
fn Target::slot(self t: Target, i: Nat) → BitVec(64) { t.stack.at(t.index + 8 * i) }

// The frame's slots hold the words the cells keep.
fn Target::Slots(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile)) → Type {
    (i: Nat) → i < t.words → read_word(t.io().data, m, t.slot(i)) = Some(word_in(v, t.layout().frame_cell(i)))
}

// The activation: its room in the region's slot, its frame's words, and
// its frames from the frame's end up. Where the frame is has no slot: it is
// RSP between statements (`Target::Held`).
fn Target::Framing(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile)) → Type {
    (word_in(v, t.layout().room_offset()).toNat() = t.room) ∧ (t.Slots(v, m) ∧ t.FramesAt(m, t.frames, t.index + 8 * t.words))
}

// The command line at the RSP its slot holds, and the activation…
fn Target::Stacking(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile)) → Type {
    ArgvAt(t.argv(), m, word_in(v, t.layout().stack_offset()), t.args) ∧ t.Framing(v, m)
}

// …and it is the environment's.
fn Target::Stacked(self t: Target, env: Env, v: Nat → BitVec(8), m: X86Memory(t.r.profile)) → Type {
    (env.args = t.args) ∧ t.Stacking(v, m)
}

fn Target::Placed(self t: Target, env: Env, m: X86Memory(t.r.profile)) → Type {
    Exists<Nat → BitVec(8)>(λ v => t.r.Holds(v, m) ∧ (t.layout().Keeps(env, v) ∧ t.Stacked(env, v, m)))
}

// The word in slot `i`, as the environment reads it.
theorem Layout::keeps_word_at(self layout: Layout, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v), i: Nat, inside: i < layout.words):
    word_in(v, layout.frame_cell(i)) = env.word(i) {
    trans(sym(BitVec::ofNat_toNat(64, word_in(v, layout.frame_cell(i)))), cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), keeps.left(i, inside)))
}

// A word's number fits it.
theorem Layout::keeps_number_fits(self layout: Layout, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v), i: Nat, inside: i < layout.words):
    env.number(i) < Nat::pow(2, 64) {
    j(keeps.left(i, inside), λ n _ => n < Nat::pow(2, 64), BitVec::toNat_lt_pow(64, word_in(v, layout.frame_cell(i))))
}

// A buffer is its capacity long.
theorem Layout::keeps_buffer_len(self layout: Layout, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v), b, cap: Nat,
    found: layout.capacities.nth(b) = Some(cap)): env.buffer(b).len() = cap {
    trans(cong_fn<List<BitVec(8)>, Nat>(λ bytes => bytes.len(), keeps.right(b, cap, found)), cells_len(v, cap, layout.buffer_offset(b)))
}

// ---------------------------------------------------------------------------
// The layout's ranges

theorem Layout::word_below_buffers(self layout: Layout, i, t: Nat, inside: i < layout.words, short: t < 8): 8 * i + t < 8 * layout.words {
    omega(inside, short)
}

theorem Layout::buffers_after_words(self layout: Layout, b: Nat): 8 * layout.reserved <= layout.buffer_offset(b) {
    let after: (8 * layout.reserved <= 8 * layout.reserved + layout.capacities.take(b).total()) = omega();
    after
}

theorem Layout::scratch_after_words(self layout: Layout): 8 * layout.reserved <= layout.scratch_offset() {
    let after: (8 * layout.reserved <= 8 * layout.reserved + layout.capacities.total()) = omega();
    after
}

theorem Layout::buffer_end(self layout: Layout, b, cap: Nat, found: layout.capacities.nth(b) = Some(cap)):
    layout.buffer_offset(b) + cap <= layout.scratch_offset() {
    let ends: ((8 * layout.reserved + layout.capacities.take(b).total()) + cap <= 8 * layout.reserved + layout.capacities.total()) =
        omega(layout.capacities.total_take_nth(b, cap, found));
    ends
}

// A buffer's range is the `b`th piece of the capacities packed after the
// words, so the packing lemma places it.
fn Layout::buffer_span(self layout: Layout, b, cap: Nat) → Span { Span::packed(8 * layout.reserved, layout.capacities, b, cap) }

theorem Layout::buffer_apart(self layout: Layout, b, cap, other: Nat, found: layout.capacities.nth(b) = Some(cap), below: b < other):
    layout.buffer_offset(b) + cap <= layout.buffer_offset(other) {
    Span::packed_before(8 * layout.reserved, layout.capacities, b, cap, other, found, below)
}

// Two different buffers share no byte.
theorem Layout::buffers_disjoint(self layout: Layout, b, cap, c, cap2: Nat, found: layout.capacities.nth(b) = Some(cap),
    found2: layout.capacities.nth(c) = Some(cap2), differ: b ≠ c): layout.buffer_span(b, cap).Disjoint(layout.buffer_span(c, cap2)) {
    Span::packed_disjoint(8 * layout.reserved, layout.capacities, b, cap, c, cap2, found, found2, differ)
}

// The scratch range is one byte longer than the largest buffer, so a path
// and its NUL fit: the RSP slot starts past it.
theorem Layout::scratch_below_stack(self layout: Layout): layout.scratch_offset() + layout.capacities.largest() <= layout.stack_offset() {
    layout.scratch_offset().add_le_mono_l(layout.capacities.largest(), layout.capacities.largest() + 1, layout.capacities.largest().le_add_l(1))
}

theorem Layout::scratch_holds(self layout: Layout, b, cap: Nat, found: layout.capacities.nth(b) = Some(cap)):
    layout.scratch_offset() + cap <= layout.stack_offset() {
    let holds: (layout.scratch_offset() + cap <= layout.scratch_offset() + layout.capacities.largest()) =
        omega(layout.capacities.largest_nth(b, cap, found));
    Nat::le_trans(layout.scratch_offset() + cap, layout.scratch_offset() + layout.capacities.largest(), layout.stack_offset(), holds,
        layout.scratch_below_stack())
}

// The scratch range, and so every buffer, lies below the layout's size, and
// the frame's cells from it up.
theorem Layout::scratch_below_size(self layout: Layout): layout.scratch_offset() + 16 <= layout.size() {
    let below: (layout.scratch_offset() + 16 <= (layout.scratch_offset() + (layout.capacities.largest() + 1)) + 16) = omega();
    below
}

theorem Layout::stack_below_size(self layout: Layout): layout.stack_offset() + 16 = layout.size() { refl }

// ---------------------------------------------------------------------------
// Cells after a store

theorem DataRegion::cells_outside(self r: DataRegion, v: Nat → BitVec(8), q: Nat, bytes: List<BitVec(8)>, p: Nat,
    away: (p < q) ∨ (q + bytes.len() <= p)): r.buffer(v).set_span(q, bytes.to_vector()).cells(p) = v(p) {
    r.buffer(v).get_set_span_outside(q, bytes.to_vector(), p, λ t below =>
        Nat::space_laws().same_false(Nat::space(), q + t, p, λ same => match away {
            Inl(under) => false_elim(omega(same, under)),
            Inr(over) => false_elim(omega(same, below, over)),
        }))
}

theorem DataRegion::cells_inside(self r: DataRegion, v: Nat → BitVec(8), q: Nat, bytes: List<BitVec(8)>, t: Nat, c: BitVec(8),
    found: bytes.nth(t) = Some(c)): r.buffer(v).set_span(q, bytes.to_vector()).cells(q + t) = c {
    r.buffer(v).get_set_span_list(Nat::space_laws(), q, bytes, t, c, found, Nat::space_distinct(q, bytes.len()))
}

// ---------------------------------------------------------------------------
// The environment kept across a store

// Cells that agree below the scratch range, and past the layout, keep what
// they kept.
theorem Layout::keeps_agree(self layout: Layout, env: Env, v, w: Nat → BitVec(8), keeps: layout.Keeps(env, v),
    same: (p: Nat) → (p < layout.scratch_offset()) ∨ (layout.size() <= p) → w(p) = v(p)): layout.Keeps(env, w) {
    ⟨λ i inside => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), word_in_agree(w, v, layout.frame_cell(i), λ t short =>
            same(layout.frame_cell(i) + t, Inr(omega(layout.frame_cell_at(i)))))), keeps.left(i, inside)),
     λ b cap found => {
        let ends = layout.buffer_end(b, cap, found);
        trans(keeps.right(b, cap, found), cells_agree(v, w, cap, layout.buffer_offset(b), λ i below => sym(same(layout.buffer_offset(b) + i, Inl(omega(ends, below))))))
     }⟩
}

// A word's cells are apart from another word's.
theorem Layout::frame_cells_apart(self layout: Layout, i, k, t: Nat, other: k ≠ i, short: t < 8):
    (layout.frame_cell(k) + t < layout.frame_cell(i)) ∨ (layout.frame_cell(i) + 8 <= layout.frame_cell(k) + t) {
    match k.lt_or_ge(i) {
        Inl(under) => Inl(omega(under, short, layout.frame_cell_at(i), layout.frame_cell_at(k))),
        Inr(over) => Inr(omega(over, other, layout.frame_cell_at(i), layout.frame_cell_at(k))),
    }
}

// A word set in its cells keeps the environment with the word set.
theorem Layout::keeps_word(self layout: Layout, r: DataRegion, env: Env, v: Nat → BitVec(8), keeps: layout.Keeps(env, v), i: Nat,
    word: BitVec(64)):
    layout.Keeps(env.set_word(i, word), r.buffer(v).set_span(layout.frame_cell(i), word_bytes(word).to_vector()).cells) {
    let fc = layout.frame_cell(i);
    let w = r.buffer(v).set_span(fc, word_bytes(word).to_vector()).cells;
    let stored: (word_in(w, fc) = word) = r.x86_word_stored(v, fc, word);
    ⟨λ k below => match k.eq_dec(i) {
        Inl(here) => j(sym(here), λ n _ => word_in(w, layout.frame_cell(n)).toNat() = env.set_word(i, word).number(n),
            trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), stored), sym(env.number_set_here(i, word)))),
        Inr(other) => {
            let kept: (word_in(w, layout.frame_cell(k)) = word_in(v, layout.frame_cell(k))) = word_in_agree(w, v, layout.frame_cell(k), λ t short =>
                r.cells_outside(v, fc, word_bytes(word), layout.frame_cell(k) + t, layout.frame_cells_apart(i, k, t, other, short)));
            trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), kept), trans(keeps.left(k, below), sym(env.number_set_other(i, word, k, other))))
        },
     },
     λ b cap found => trans(keeps.right(b, cap, found), cells_agree(v, w, cap, layout.buffer_offset(b), λ p below =>
        sym(r.cells_outside(v, fc, word_bytes(word), layout.buffer_offset(b) + p,
            Inl(omega(below, layout.buffer_end(b, cap, found), layout.scratch_below_size(), layout.frame_cell_at(i)))))))⟩
}

// A read's bytes copied to the start of their buffer, the other cells as
// they were: the environment with that buffer filled.
theorem Layout::keeps_fill(self layout: Layout, env: Env, v, w: Nat → BitVec(8), keeps: layout.Keeps(env, v), buf, cap: Nat,
    found: layout.capacities.nth(buf) = Some(cap), bytes: List<BitVec(8)>, short: bytes.len() <= cap,
    same: (p: Nat) → ((p < layout.buffer_offset(buf)) ∨ (layout.buffer_offset(buf) + bytes.len() <= p)) → w(p) = v(p),
    copied: (i: Nat) → (c: BitVec(8)) → bytes.nth(i) = Some(c) → w(layout.buffer_offset(buf) + i) = c):
    layout.Keeps(env.set_buffer(buf, fill(env.buffer(buf), bytes)), w) {
    let o = layout.buffer_offset(buf);
    let n = bytes.len();
    let ends = layout.buffer_end(buf, cap, found);
    let words = λ (i: Nat) (inside: i < layout.words) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), word_in_agree(w, v, layout.frame_cell(i), λ t below =>
        same(layout.frame_cell(i) + t, Inr(omega(short, ends, layout.scratch_below_size(), layout.frame_cell_at(i)))))), keeps.left(i, inside));
    let old: (env.buffer(buf) = cells_at(v, o, cap)) = keeps.right(buf, cap, found);
    let old_len: (env.buffer(buf).len() = cap) = layout.keeps_buffer_len(env, v, keeps, buf, cap, found);
    let rest: (env.buffer(buf).drop(n) = cells_at(w, o + n, cap - n)) = trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ x => x.drop(n), old),
        trans(cells_drop(v, cap, o, n), sym(cells_agree(w, v, cap - n, o + n, λ i below => same(o + n + i, Inr(omega()))))));
    let filled: (fill(env.buffer(buf), bytes) = cells_at(w, o, cap)) = trans(fill_short(env.buffer(buf), bytes, omega(short, old_len)),
        trans(eq2(λ (x: List<BitVec(8)>) (y: List<BitVec(8)>) => x ++ y, sym(cells_of(w, bytes, o, copied)), rest),
            sym(cells_split(w, n, o, cap, short))));
    ⟨words, λ b c found_b => match b.eq_dec(buf) {
        Inl(here) => {
            let cap_same: (c = cap) = Option::some_inj(c, cap, trans(sym(found_b), j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cap), found)));
            j(sym(here), λ x _ => env.set_buffer(buf, fill(env.buffer(buf), bytes)).buffer(x) = cells_at(w, layout.buffer_offset(x), c),
                trans(env.buffer_set_here(buf, fill(env.buffer(buf), bytes)), j(sym(cap_same), λ k _ => fill(env.buffer(buf), bytes) = cells_at(w, o, k), filled)))
        },
        Inr(other) => {
            let o_b = layout.buffer_offset(b);
            let away: ((i: Nat) → i < c → (o_b + i < o) ∨ (o + n <= o_b + i)) = λ i below => match b.lt_or_ge(buf) {
                Inl(under) => Inl(omega(layout.buffer_apart(b, c, buf, found_b, under), below)),
                Inr(over) => Inr(omega(layout.buffer_apart(buf, cap, b, found, omega(over, other)), short)),
            };
            trans(env.buffer_set_other(buf, fill(env.buffer(buf), bytes), b, other),
                trans(keeps.right(b, c, found_b), cells_agree(v, w, c, layout.buffer_offset(b), λ i below =>
                    sym(same(layout.buffer_offset(b) + i, away(i, below))))))
        },
    }⟩
}

// A read's bytes copied into their buffer from offset `a`, the other cells
// as they were: the environment with that buffer filled there.
theorem Layout::keeps_fill_at(self layout: Layout, env: Env, v, w: Nat → BitVec(8), keeps: layout.Keeps(env, v), buf, cap: Nat,
    found: layout.capacities.nth(buf) = Some(cap), a: Nat, bytes: List<BitVec(8)>, short: a + bytes.len() <= cap,
    same: (p: Nat) → ((p < layout.buffer_offset(buf) + a) ∨ ((layout.buffer_offset(buf) + a) + bytes.len() <= p)) → w(p) = v(p),
    copied: (i: Nat) → (c: BitVec(8)) → bytes.nth(i) = Some(c) → w((layout.buffer_offset(buf) + a) + i) = c):
    layout.Keeps(env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)), w) {
    let o = layout.buffer_offset(buf);
    let n = bytes.len();
    let ends = layout.buffer_end(buf, cap, found);
    let a_le: (a <= cap) = omega(short);
    let n_le: (n <= cap - a) = omega(short);
    let words = λ (i: Nat) (inside: i < layout.words) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), word_in_agree(w, v, layout.frame_cell(i), λ t below =>
        same(layout.frame_cell(i) + t, Inr(omega(short, ends, layout.scratch_below_size(), layout.frame_cell_at(i)))))), keeps.left(i, inside));
    let old: (env.buffer(buf) = cells_at(v, o, cap)) = keeps.right(buf, cap, found);
    // Before the offset, the cells as they were.
    let head: (env.buffer(buf).take(a) = cells_at(w, o, a)) = trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ x => x.take(a), old),
        trans(cells_take(v, cap, o, a), trans(cong_fn<Nat, List<BitVec(8)>>(λ k => cells_at(v, o, k), Nat::min_eq_l(a, cap, a_le)),
            cells_agree(v, w, a, o, λ i below => sym(same(o + i, Inl(omega(below))))))));
    // Past it, the bytes, then the cells as they were.
    let tail: (env.buffer(buf).drop(a) = cells_at(v, o + a, cap - a)) = trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ x => x.drop(a), old),
        cells_drop(v, cap, o, a));
    let tail_len: (cells_at(v, o + a, cap - a).len() = cap - a) = cells_len(v, cap - a, o + a);
    let rest: (cells_at(v, o + a, cap - a).drop(n) = cells_at(w, (o + a) + n, (cap - a) - n)) = trans(cells_drop(v, cap - a, o + a, n),
        sym(cells_agree(w, v, (cap - a) - n, (o + a) + n, λ i below => same(((o + a) + n) + i, Inr(omega())))));
    let filled_tail: (fill(env.buffer(buf).drop(a), bytes) = cells_at(w, o + a, cap - a)) =
        trans(cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ x => fill(x, bytes), tail),
            trans(fill_short(cells_at(v, o + a, cap - a), bytes, omega(n_le, tail_len)),
                trans(eq2(λ (x: List<BitVec(8)>) (y: List<BitVec(8)>) => x ++ y, sym(cells_of(w, bytes, o + a, copied)), rest),
                    sym(cells_split(w, n, o + a, cap - a, n_le)))));
    let filled: (fill_at(env.buffer(buf), a, bytes) = cells_at(w, o, cap)) =
        trans(eq2(λ (x: List<BitVec(8)>) (y: List<BitVec(8)>) => x ++ y, head, filled_tail), sym(cells_split(w, a, o, cap, a_le)));
    ⟨words, λ b c found_b => match b.eq_dec(buf) {
        Inl(here) => {
            let cap_same: (c = cap) = Option::some_inj(c, cap, trans(sym(found_b), j(sym(here), λ x _ => layout.capacities.nth(x) = Some(cap), found)));
            j(sym(here), λ x _ => env.set_buffer(buf, fill_at(env.buffer(buf), a, bytes)).buffer(x) = cells_at(w, layout.buffer_offset(x), c),
                trans(env.buffer_set_here(buf, fill_at(env.buffer(buf), a, bytes)), j(sym(cap_same), λ k _ => fill_at(env.buffer(buf), a, bytes) = cells_at(w, o, k), filled)))
        },
        Inr(other) => {
            let o_b = layout.buffer_offset(b);
            let away: ((i: Nat) → i < c → (o_b + i < o + a) ∨ ((o + a) + n <= o_b + i)) = λ i below => match b.lt_or_ge(buf) {
                Inl(under) => Inl(omega(layout.buffer_apart(b, c, buf, found_b, under), below)),
                Inr(over) => Inr(omega(layout.buffer_apart(buf, cap, b, found, omega(over, other)), short)),
            };
            trans(env.buffer_set_other(buf, fill_at(env.buffer(buf), a, bytes), b, other),
                trans(keeps.right(b, c, found_b), cells_agree(v, w, c, layout.buffer_offset(b), λ i below =>
                    sym(same(layout.buffer_offset(b) + i, away(i, below))))))
        },
    }⟩
}

// ---------------------------------------------------------------------------
// The region in memory: reads, stores, and the code kept resident

// The slot RSP is saved to ends inside the region…
theorem Target::stack_fits(self t: Target): t.layout().stack_offset() + 8 <= t.r.size {
    let slots: (t.layout().stack_offset() + 16 <= t.r.size) = t.fits;
    omega(slots)
}

// …and the scratch range ends at it.
theorem Target::scratch_room(self t: Target): t.layout().scratch_offset() + t.caps.largest() <= t.r.size {
    Nat::le_trans(t.layout().scratch_offset() + t.caps.largest(), t.layout().stack_offset(), t.r.size, t.layout().scratch_below_stack(),
        t.layout().stack_offset().le_of_add_le(8, t.r.size, t.stack_fits()))
}

theorem Target::scratch_fits(self t: Target): t.layout().scratch_offset() <= t.r.size {
    t.layout().scratch_offset().le_of_add_le(t.caps.largest(), t.r.size, t.scratch_room())
}

// The region lies below the frame's cells.
theorem Target::size_canonical(self t: Target): t.r.size <= Nat::pow(2, 47) { omega(t.r.canonical) }

// A slot of the frame is inside the stack.
theorem Target::slot_inside(self t: Target, i: Nat, inside: i < t.words): (t.index + 8 * i) + 8 <= t.stack.size {
    omega(inside, t.framed)
}

theorem Target::buffer_rip(self t: Target, b: Nat): t.layout().buffer_at(b) = next_rip(t.r.low, t.layout().buffer_offset(b)) {
    t.at_rip(t.layout().buffer_offset(b))
}

theorem Target::scratch_rip(self t: Target): t.layout().scratch_at() = next_rip(t.r.low, t.layout().scratch_offset()) {
    t.at_rip(t.layout().scratch_offset())
}

// The word in slot `i`, read at its address.
theorem Target::read_slot(self t: Target, env: Env, v: Nat → BitVec(8), m: X86Memory(t.r.profile), slots: t.Slots(v, m),
    keeps: t.layout().Keeps(env, v), i: Nat, inside: i < t.words):
    (t.slot(i).toNat() + 8 <= Nat::pow(2, 47)) ∧
    (read_word(t.r.profile.data(), m, t.slot(i)) = Some(env.word(i))) {
    let fits = t.slot_inside(i, inside);
    let value: (t.slot(i).toNat() = t.stack.low.toNat() + (t.index + 8 * i)) = t.stack_toNat(t.index + 8 * i, omega(fits));
    ⟨omega(value, fits, t.stack_canonical),
     trans(slots(i, inside), cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), t.layout().keeps_word_at(env, v, keeps, i, inside)))⟩
}

// The cell at offset `q`, read at its address.
theorem Target::read_cell(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), holds: t.r.Holds(v, m), q: Nat,
    inside: q < t.r.size): (next_rip(t.r.low, q).toNat() < Nat::pow(2, 47)) ∧ (t.r.profile.read(m, next_rip(t.r.low, q)) = Some(v(q))) {
    let low = t.r.low.toNat();
    let below: (low + q < Nat::pow(2, 47)) = Nat::le_trans(Succ(low + q), low + t.r.size, Nat::pow(2, 47),
        low.add_le_mono_l(Succ(q), t.r.size, inside), t.r.canonical);
    ⟨j(sym(t.r.toNat_at(q, Nat::le_of_lt(q, t.r.size, inside))), λ x _ => x < Nat::pow(2, 47), below), t.r.buffer_read(v, m, holds, q, 0, inside)⟩
}

// A store in the region keeps the code resident…
theorem Target::store_resident(self t: Target, m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>,
    fits: q + bytes.len() <= t.r.size, resident: t.site().Resident(m)):
    t.site().Resident(t.r.profile.store(m, next_rip(t.r.low, q), bytes)) {
    t.r.profile.store_keeps_code(m, next_rip(t.r.low, q), bytes, t.r.not_executed(m, q, bytes.len(), fits),
        assemble(no_fills(), t.program, Nil), next_rip(t.origin, 0), resident)
}

// …and the region is writable.
theorem Target::writable(self t: Target, m: X86Memory(t.r.profile), q, k: Nat, fits: q + k <= t.r.size):
    t.io().writable(m, next_rip(t.r.low, q), k) {
    t.r.allows(Perm::writes, refl, m, q, k, fits)
}

// ---------------------------------------------------------------------------
// The command line kept

// A store inside the region reads alike above any floor past the region…
theorem Target::kept_above(self t: Target, m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>, fits: q + bytes.len() <= t.r.size,
    floor: Nat, high: t.r.low.toNat() + t.r.size <= floor):
    ReadsKept(t.r.profile.data().above(floor), m, t.r.profile.data().above(floor), t.r.profile.store(m, next_rip(t.r.low, q), bytes)) {
    let after = t.r.profile.store(m, next_rip(t.r.low, q), bytes);
    λ a byte got => {
        let found = t.r.profile.data().above_read(floor, m, a, byte, got);
        let outside: ((p: Nat) → p < bytes.len() → BitVec::space(64).same(next_rip(next_rip(t.r.low, q), p), a) = False) = λ p below =>
            BitVec::space_laws(64).same_false(BitVec::space(64), next_rip(next_rip(t.r.low, q), p), a, λ same => {
                let value: (next_rip(next_rip(t.r.low, q), p).toNat() = t.r.low.toNat() + (q + p)) =
                    trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), rip_compose(t.r.low, q, p)), t.r.toNat_at(q + p, omega(below, fits)));
                let at: (a.toNat() = t.r.low.toNat() + (q + p)) = trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), sym(same)), value);
                false_elim(omega(at, found.left, below, fits, high))
            });
        let read: (t.r.profile.read(after, a) = Some(byte)) =
            trans(t.r.profile.read_agree(m, after.cells, a, t.r.profile.store_outside(m, next_rip(t.r.low, q), bytes, a, outside)), found.right);
        let up: (floor.leb(a.toNat()) = True) = Nat::leb_true(floor, a.toNat(), found.left);
        j(sym(up), λ b _ => (match b { True => t.r.profile.read(after, a), False => None<BitVec(8)> }) = Some(byte), read)
    }
}

// …so the command line, above the stack…
theorem Target::kept_store(self t: Target, m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>, fits: q + bytes.len() <= t.r.size):
    ReadsKept(t.argv(), m, t.argv(), t.r.profile.store(m, next_rip(t.r.low, q), bytes)) {
    let high: (t.r.low.toNat() + t.r.size <= t.stack.low.toNat() + t.stack.size) = omega(t.stack_above);
    t.kept_above(m, q, bytes, fits, t.stack.low.toNat() + t.stack.size, high)
}

// …and the stack's words, above the region.
theorem Target::stack_read_store(self t: Target, m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>, fits: q + bytes.len() <= t.r.size,
    k: Nat, inside: k + 8 <= t.stack.size):
    read_word(t.io().data, t.r.profile.store(m, next_rip(t.r.low, q), bytes), t.stack.at(k)) = read_word(t.io().data, m, t.stack.at(k)) {
    let after = t.r.profile.store(m, next_rip(t.r.low, q), bytes);
    read_word_agree(t.io().data, after, m, t.stack.at(k), λ b short => {
        let a = next_rip(t.stack.at(k), b);
        let value: (a.toNat() = t.stack.low.toNat() + (k + b)) =
            trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), rip_compose(t.stack.low, k, b)), t.stack_toNat(k + b, omega(inside, short)));
        let outside: ((p: Nat) → p < bytes.len() → BitVec::space(64).same(next_rip(next_rip(t.r.low, q), p), a) = False) = λ p below =>
            BitVec::space_laws(64).same_false(BitVec::space(64), next_rip(next_rip(t.r.low, q), p), a, λ same => {
                let region: (next_rip(next_rip(t.r.low, q), p).toNat() = t.r.low.toNat() + (q + p)) =
                    trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), rip_compose(t.r.low, q, p)), t.r.toNat_at(q + p, omega(below, fits)));
                let here: (a.toNat() = t.r.low.toNat() + (q + p)) = trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), sym(same)), region);
                false_elim(omega(here, value, below, fits, t.stack_above))
            });
        t.r.profile.read_agree(m, after.cells, a, t.r.profile.store_outside(m, next_rip(t.r.low, q), bytes, a, outside))
    })
}

theorem Target::frames_store(self t: Target, m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>, fits: q + bytes.len() <= t.r.size,
    words: List<BitVec(64)>, i: Nat, at: t.FramesAt(m, words, i)): t.FramesAt(t.r.profile.store(m, next_rip(t.r.low, q), bytes), words, i) {
    t.frames_kept(m, t.r.profile.store(m, next_rip(t.r.low, q), bytes), i, λ k _ inside => t.stack_read_store(m, q, bytes, fits, k, inside),
        words, i, i.le_refl(), at)
}

// A store below the RSP slot keeps the slot, the command line above, and
// the frame.
theorem Target::stacking_store(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>,
    fits: q + bytes.len() <= t.layout().stack_offset(), stacking: t.Stacking(v, m)):
    t.Stacking(t.r.buffer(v).set_span(q, bytes.to_vector()).cells, t.r.profile.store(m, next_rip(t.r.low, q), bytes)) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let w = t.r.buffer(v).set_span(q, bytes.to_vector()).cells;
    let size: (q + bytes.len() <= t.r.size) = omega(fits, t.stack_fits());
    let after = t.r.profile.store(m, next_rip(t.r.low, q), bytes);
    let kept = t.kept_store(m, q, bytes, size);
    let slot: (word_in(w, so) = word_in(v, so)) = word_in_agree(w, v, so, λ k _ => t.r.cells_outside(v, q, bytes, so + k, Inr(omega(fits))));
    let room: (word_in(w, so + 8) = word_in(v, so + 8)) = word_in_agree(w, v, so + 8, λ k _ => t.r.cells_outside(v, q, bytes, so + 8 + k, Inr(omega(fits))));
    let slots: t.Slots(w, after) = λ i inside => trans(t.stack_read_store(m, q, bytes, size, t.index + 8 * i, t.slot_inside(i, inside)),
        trans(stacking.right.right.left(i, inside), cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x),
            sym(word_in_agree(w, v, layout.frame_cell(i), λ k _ => t.r.cells_outside(v, q, bytes, layout.frame_cell(i) + k,
                Inr(omega(fits, layout.stack_below_size(), layout.frame_cell_at(i)))))))));
    ⟨j(sym(slot), λ rsp _ => ArgvAt(t.argv(), after, rsp, t.args),
        argv_at_kept(t.argv(), m, t.argv(), after, kept, word_in(v, so), t.args, stacking.left)),
     ⟨trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), room), stacking.right.left),
      ⟨slots, t.frames_store(m, q, bytes, size, t.frames, t.index + 8 * t.words, stacking.right.right.right)⟩⟩⟩
}

theorem Target::stacked_store(self t: Target, env: Env, v: Nat → BitVec(8), m: X86Memory(t.r.profile), q: Nat, bytes: List<BitVec(8)>,
    fits: q + bytes.len() <= t.layout().stack_offset(), stacked: t.Stacked(env, v, m)):
    t.Stacked(env, t.r.buffer(v).set_span(q, bytes.to_vector()).cells, t.r.profile.store(m, next_rip(t.r.low, q), bytes)) {
    ⟨stacked.left, t.stacking_store(v, m, q, bytes, fits, stacked.right)⟩
}

// ---------------------------------------------------------------------------
// The stack's words

// A word stored to the stack at offset `i`: nothing of the region moves…
theorem Target::stack_store_cells(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64), y: BitVec(64),
    low: y.toNat() < t.stack.low.toNat()): t.r.profile.store(m, t.stack.at(i), word_bytes(word)).cells(y) = m.cells(y) {
    t.r.profile.store_outside(m, t.stack.at(i), word_bytes(word), y, λ p below =>
        BitVec::space_laws(64).same_false(BitVec::space(64), next_rip(t.stack.at(i), p), y, λ same => {
            let value: (next_rip(t.stack.at(i), p).toNat() = t.stack.low.toNat() + (i + p)) =
                trans(cong_fn<BitVec(64), Nat>(λ a => a.toNat(), rip_compose(t.stack.low, i, p)), t.stack_toNat(i + p, omega(fits, below)));
            let here: (y.toNat() = t.stack.low.toNat() + (i + p)) = trans(cong_fn<BitVec(64), Nat>(λ a => a.toNat(), sym(same)), value);
            false_elim(omega(here, low))
        }))
}

theorem Target::stack_store_holds(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), holds: t.r.Holds(v, m), i: Nat,
    fits: i + 8 <= t.stack.size, word: BitVec(64)): t.r.Holds(v, t.r.profile.store(m, t.stack.at(i), word_bytes(word))) {
    λ p inside => {
        let value: (next_rip(t.r.low, p).toNat() = t.r.low.toNat() + p) = t.r.toNat_at(p, Nat::le_of_lt(p, t.r.size, inside));
        trans(t.stack_store_cells(m, i, fits, word, next_rip(t.r.low, p), omega(value, inside, t.stack_above)), holds(p, inside))
    }
}

// …nor anything read above a floor past it…
theorem Target::stack_store_above(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64),
    floor: Nat, high: t.stack.low.toNat() + (i + 8) <= floor):
    ReadsKept(t.r.profile.data().above(floor), m, t.r.profile.data().above(floor), t.r.profile.store(m, t.stack.at(i), word_bytes(word))) {
    let after = t.r.profile.store(m, t.stack.at(i), word_bytes(word));
    λ a byte got => {
        let found = t.r.profile.data().above_read(floor, m, a, byte, got);
        let outside: ((p: Nat) → p < 8 → BitVec::space(64).same(next_rip(t.stack.at(i), p), a) = False) = λ p below =>
            BitVec::space_laws(64).same_false(BitVec::space(64), next_rip(t.stack.at(i), p), a, λ same => {
                let value: (next_rip(t.stack.at(i), p).toNat() = t.stack.low.toNat() + (i + p)) =
                    trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), rip_compose(t.stack.low, i, p)), t.stack_toNat(i + p, omega(fits, below)));
                let here: (a.toNat() = t.stack.low.toNat() + (i + p)) = trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), sym(same)), value);
                false_elim(omega(here, found.left, below, high))
            });
        let read: (t.r.profile.read(after, a) = Some(byte)) =
            trans(t.r.profile.read_agree(m, after.cells, a, t.r.profile.store_outside(m, t.stack.at(i), word_bytes(word), a, outside)), found.right);
        let up: (floor.leb(a.toNat()) = True) = Nat::leb_true(floor, a.toNat(), found.left);
        j(sym(up), λ b _ => (match b { True => t.r.profile.read(after, a), False => None<BitVec(8)> }) = Some(byte), read)
    }
}

// …nor the stack's words apart from it, and it reads back.
theorem Target::stack_store_apart(self t: Target, m: X86Memory(t.r.profile), i, k: Nat, fits: i + 8 <= t.stack.size, k_fits: k + 8 <= t.stack.size,
    apart: WordsApart(i, k), word: BitVec(64)):
    read_word(t.io().data, t.r.profile.store(m, t.stack.at(i), word_bytes(word)), t.stack.at(k)) = read_word(t.io().data, m, t.stack.at(k)) {
    j(t.stack_writes, λ ws _ => read_word(t.io().data, ws.store(m, t.stack.at(i), word_bytes(word)), t.stack.at(k)) = read_word(t.io().data, m, t.stack.at(k)),
        t.stack.apart(m, i, k, fits, k_fits, apart, word))
}

theorem Target::stack_store_read(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64)):
    read_word(t.io().data, t.r.profile.store(m, t.stack.at(i), word_bytes(word)), t.stack.at(i)) = Some(word) {
    j(t.stack_writes, λ ws _ => read_word(t.io().data, ws.store(m, t.stack.at(i), word_bytes(word)), t.stack.at(i)) = Some(word),
        t.stack.stored(m, i, fits, word))
}

theorem Target::frames_stack_store(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64),
    words: List<BitVec(64)>, k: Nat, above: i + 8 <= k, at: t.FramesAt(m, words, k)):
    t.FramesAt(t.r.profile.store(m, t.stack.at(i), word_bytes(word)), words, k) {
    t.frames_kept(m, t.r.profile.store(m, t.stack.at(i), word_bytes(word)), k,
        λ l from inside => t.stack_store_apart(m, i, l, fits, inside, Inl(omega(above, from)), word), words, k, k.le_refl(), at)
}

// The stack is writable, and a store to it keeps the code resident.
theorem Target::stack_writable(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size): t.io().writable(m, t.stack.at(i), 8) {
    j(t.stack_writes, λ ws _ => ws.writable(m, t.stack.at(i), 8), t.stack.writable(m, i, fits))
}

theorem Target::stack_store_resident(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64),
    resident: t.site().Resident(m)): t.site().Resident(t.r.profile.store(m, t.stack.at(i), word_bytes(word))) {
    j(t.stack_writes, λ ws _ => CodeResident(t.io().fetch, ws.store(m, t.stack.at(i), word_bytes(word)), assemble(no_fills(), t.program, Nil), next_rip(t.origin, 0)),
        t.stack.keeps_code(m, i, fits, word, assemble(no_fills(), t.program, Nil), next_rip(t.origin, 0), resident))
}

// A slot's address, as the code adds it up from RSP.
theorem Target::slot_address(self t: Target, id: Nat): BitVec::ofNat(8 * id).add(t.frame()) = t.slot(id) {
    trans(BitVec::add_comm(64, BitVec::ofNat(8 * id), t.frame()),
        trans(BitVec::add_nat_iterate(64, t.frame(), 8 * id), rip_compose(t.stack.low, t.index, 8 * id)))
}

// A store to the stack keeps the command line above it.
theorem Target::argv_stack_store(self t: Target, m: X86Memory(t.r.profile), i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64), rsp: BitVec(64),
    argv: ArgvAt(t.argv(), m, rsp, t.args)): ArgvAt(t.argv(), t.r.profile.store(m, t.stack.at(i), word_bytes(word)), rsp, t.args) {
    argv_at_kept(t.argv(), m, t.argv(), t.r.profile.store(m, t.stack.at(i), word_bytes(word)),
        t.stack_store_above(m, i, fits, word, t.stack.low.toNat() + t.stack.size, omega(fits)), rsp, t.args, argv)
}

// ---------------------------------------------------------------------------
// A word stored to its slot

// The cells with the word set, the stack with it stored.
theorem Target::stacking_slot(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), i: Nat, inside: i < t.words, word: BitVec(64),
    stacking: t.Stacking(v, m)):
    t.Stacking(t.r.buffer(v).set_span(t.layout().frame_cell(i), word_bytes(word).to_vector()).cells, t.r.profile.store(m, t.slot(i), word_bytes(word))) {
    let layout = t.layout();
    let fc = layout.frame_cell(i);
    let bytes = word_bytes(word);
    let w = t.r.buffer(v).set_span(fc, bytes.to_vector()).cells;
    let k = t.index + 8 * i;
    let fits: (k + 8 <= t.stack.size) = t.slot_inside(i, inside);
    let m2 = t.r.profile.store(m, t.stack.at(k), bytes);
    let so = layout.stack_offset();
    let low: ((p: Nat) → p < layout.size() → w(p) = v(p)) = λ p under => t.r.cells_outside(v, fc, bytes, p, Inl(omega(under, layout.frame_cell_at(i))));
    let slot: (word_in(w, so) = word_in(v, so)) = word_in_agree(w, v, so, λ n short => low(so + n, omega(short, layout.stack_below_size())));
    let room: (word_in(w, so + 8) = word_in(v, so + 8)) = word_in_agree(w, v, so + 8, λ n short => low(so + 8 + n, omega(short, layout.stack_below_size())));
    let argv = j(sym(slot), λ rsp _ => ArgvAt(t.argv(), m2, rsp, t.args), t.argv_stack_store(m, k, fits, word, word_in(v, so), stacking.left));
    let slots: t.Slots(w, m2) = λ n below => match n.eq_dec(i) {
        Inl(here) => j(sym(here), λ x _ => read_word(t.io().data, m2, t.slot(x)) = Some(word_in(w, layout.frame_cell(x))),
            trans(t.stack_store_read(m, k, fits, word), cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x), sym(t.r.x86_word_stored(v, fc, word))))),
        Inr(other) => trans(t.stack_store_apart(m, k, t.index + 8 * n, fits, t.slot_inside(n, below), match n.lt_or_ge(i) {
                Inl(under) => Inr(omega(under)),
                Inr(over) => Inl(omega(over, other)),
            }, word),
            trans(stacking.right.right.left(n, below), cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x),
                sym(word_in_agree(w, v, layout.frame_cell(n), λ b short => t.r.cells_outside(v, fc, bytes, layout.frame_cell(n) + b,
                    layout.frame_cells_apart(i, n, b, other, short))))))),
    };
    ⟨argv, ⟨trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), room), stacking.right.left),
        ⟨slots, t.frames_stack_store(m, k, fits, word, t.frames, t.index + 8 * t.words, omega(inside), stacking.right.right.right)⟩⟩⟩
}

// A word stored to its slot: the environment with it set.
theorem Target::placed_word(self t: Target, env: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), i: Nat,
    inside: i < t.words, word: BitVec(64)):
    t.Placed(env.set_word(i, word), t.r.profile.store(m, t.slot(i), word_bytes(word))) {
    let v = placed.witness;
    let layout = t.layout();
    let fc = layout.frame_cell(i);
    let w = t.r.buffer(v).set_span(fc, word_bytes(word).to_vector()).cells;
    let fits = t.slot_inside(i, inside);
    let held = t.stack_store_holds(v, m, placed.proof.left, t.index + 8 * i, fits, word);
    let holds: t.r.Holds(w, t.r.profile.store(m, t.slot(i), word_bytes(word))) = λ p under => trans(held(p, under),
        sym(t.r.cells_outside(v, fc, word_bytes(word), p, Inl(omega(under, t.size_canonical(), layout.frame_cell_at(i))))));
    Exists(w, ⟨holds, ⟨layout.keeps_word(t.r, env, v, placed.proof.right.left, i, word),
        ⟨placed.proof.right.right.left, t.stacking_slot(v, m, i, inside, word, placed.proof.right.right.right)⟩⟩⟩)
}

// The environment is the same, so is where it is placed.
theorem Target::placed_same(self t: Target, env, other: Env, m: X86Memory(t.r.profile), placed: t.Placed(env, m), same: env = other):
    t.Placed(other, m) {
    j(same, λ e _ => t.Placed(e, m), placed)
}

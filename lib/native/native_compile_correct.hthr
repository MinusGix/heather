// The effectful source's compiler proved once (issues/native-effect-source-compiler.md,
// round S3.2): every statement `Stmt::emit` compiles runs as its tree
// (`Stmt::emit_runs`, by induction on the statement), and so every program
// `Source::compile` builds simulates the source's denotation from a region
// holding its start (`native_compile_correct`).
//
// A statement's claim (`Target::Runs`) is over a continuation: from every
// environment placed at the statement's start, the code runs as the
// statement's tree bound to `k`, wherever `k` goes on from the statement's
// end with each environment it may finish in, and meets every exit with
// its status. `Then` is `bind_assoc`; `Branch` is the test's two ways and a
// JMP over the second arm; `Repeat` is an induction on the loop's fuel, the
// body run each round with the test and a JMP back as its continuation. A
// structured region's code runs as the region's meaning
// (native_compile_structured's `StructuredRegion::code_runs`), which is its
// run settled where it is scoped from every word (`compute_same`).
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_steps;
import native_compile_segments;
import native_compile_calls;
import native_compile_leaf;
import native_compile_bytes;
import native_compile_nodes;
import native_compile_args;
import native_compile_opens;
import native_compile_homes;
import native_compile_structured;
import native_compile_pass;
import native_compile_perform;
import native_compile_function;
import native_compile_frames;
import function_ir_pass;
import native_structured;
import native_structured_meaning;
import native_alloc;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_placeless;
import function_ir_lower;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_sim;
import linux_x86_64_sim_paid;
import itree;
import x86_64;
import x86_64_stack;
import x86_64_store;
import x86_64_stack_runs;
import linux_calls;
import x86_64_block;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_byte_memory;
import linux_x86_64_byte_memory;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Where each piece starts, inside what it builds

theorem Prog::within_exits(self p: Prog, layout: Layout, known: List<Fact>, status: Nat): p.Within(p.exits(layout, known, status)) {
    p.within_trans(p.known_to(layout, known, status, Rdi), p.exits(layout, known, status), p.within_known_to(layout, known, status, Rdi), Exists(2, refl))
}

// The calls' code from its start: fixed runs of items between the words'
// loads and stores, whose length is each word's home.
theorem Prog::within_reads(self p: Prog, layout: Layout, known: List<Fact>, out: List<Nat>, fd, buf, len, result, capacity, names: Nat):
    p.Within(p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog) {
    let r0 = p.known_to(layout, known, len, Rdx);
    let clamped = then(r0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(Rdx, R9, Succ(names));
    let r1 = then(clamped, Block([MovRI(Rsi, layout.scratch_at()), MovRI(Rax, BitVec::ofNat(0))]));
    let r2 = r1.known_to(layout, known, fd, Rdi);
    let asked = then(r2, Syscall);
    let copied = then(then(asked, Block([TestRR(Rax, Rax)])), Jcc(S, Succ(Succ(Succ(names))))).copy_in(layout, buf, Succ(Succ(names)), Succ(Succ(Succ(names)))).label(Succ(Succ(Succ(names))));
    p.within_trans(r0, p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog, p.within_known_to(layout, known, len, Rdx),
        r0.within_trans(clamped, p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog, Exists(5, refl),
            clamped.within_trans(r1, p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog, clamped.within_then(0, Block([MovRI(Rsi, layout.scratch_at()), MovRI(Rax, BitVec::ofNat(0))])),
                r1.within_trans(r2, p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog, r1.within_known_to(layout, known, fd, Rdi),
                    r2.within_trans(copied, p.reads(layout, known, out, fd, buf, len, result, capacity, names).prog, Exists(12, refl),
                        copied.within_word_from(layout, out, result, Rax))))))
}

theorem Prog::within_writes(self p: Prog, layout: Layout, known: List<Fact>, out: List<Nat>, fd, buf, from, len, result, capacity, names: Nat):
    p.Within(p.writes(layout, known, out, fd, buf, from, len, result, capacity, names).prog) {
    let whole = p.writes(layout, known, out, fd, buf, from, len, result, capacity, names).prog;
    let w0 = p.known_to(layout, known, from, R8);
    let start = then(w0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(R8, R9, Succ(names));
    let w1 = then(start, Block([SubRR(R9, R8)]));
    let w2 = w1.known_to(layout, known, len, Rdx);
    let room = w2.clamp(Rdx, R9, Succ(Succ(names)));
    let w3 = then(room, Block([MovRI(Rsi, layout.buffer_at(buf)), AddRR(Rsi, R8), MovRI(Rax, BitVec::ofNat(1))]));
    let w4 = w3.known_to(layout, known, fd, Rdi);
    let asked = then(w4, Syscall);
    p.within_trans(w0, whole, p.within_known_to(layout, known, from, R8),
        w0.within_trans(w1, whole, Exists(6, refl),
            w1.within_trans(w2, whole, w1.within_known_to(layout, known, len, Rdx),
                w2.within_trans(w3, whole, Exists(5, refl),
                    w3.within_trans(w4, whole, w3.within_known_to(layout, known, fd, Rdi),
                        w4.within_trans(asked, whole, w4.within_then(0, Syscall), asked.within_word_from(layout, out, result, Rax)))))))
}

theorem Prog::within_args(self p: Prog, layout: Layout, out: List<Nat>, index, buf, len, capacity, names: Nat):
    p.Within(p.args(layout, out, index, buf, len, capacity, names).prog) {
    let whole = p.args(layout, out, index, buf, len, capacity, names).prog;
    let loaded = then(then(then(p, Block([MovRI(Rbx, layout.stack_at())])), Load(WordLoad(Rdx, Rbx))), Load(WordLoad(R9, Rdx)));
    let counted = loaded.word_to(layout, index, Rcx);
    let head = Succ(names);
    let past = Succ(Succ(Succ(head)));
    let after = Succ(past);
    let copied = then(then(counted, Block([CmpRR(Rcx, R9)])), Jcc(AE, past)).arg_pointer(layout, buf, capacity, head).arg_copy(head, Succ(Succ(head)), Succ(head));
    let found = then(then(copied.label(Succ(Succ(head))), Block([MovRR(Rax, R8)])), Jmp(after));
    let missing = then(found.label(past), Block([MovRI(Rax, missing_word())])).label(after);
    p.within_trans(loaded, whole, Exists(3, refl),
        loaded.within_trans(counted, whole, loaded.within_word_to(layout, index, Rcx),
            counted.within_trans(missing, whole, Exists(21, refl), missing.within_word_from(layout, out, len, Rax))))
}

theorem Prog::within_opens(self p: Prog, layout: Layout, known: List<Fact>, out: List<Nat>, path, len, result, capacity, names: Nat):
    p.Within(p.opens(layout, known, out, path, len, result, capacity, names).prog) {
    let whole = p.opens(layout, known, out, path, len, result, capacity, names).prog;
    let r0 = p.known_to(layout, known, len, Rcx);
    let clamped = then(r0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(Rcx, R9, Succ(names));
    let copied = clamped.path_copy(layout, path, Succ(Succ(names)), Succ(Succ(Succ(names)))).label(Succ(Succ(Succ(names))));
    let ended = then(then(copied, Block([MovRI(Rdx, BitVec::ofNat(0))])), StoreByte(ByteStore(Rdi, Rdx)));
    let asking: List<Instruction> = [MovRI(Rax, BitVec::ofNat(257)), MovRI(Rdi, fdcwd_word()), MovRI(Rsi, layout.scratch_at()), MovRI(Rdx, BitVec::ofNat(0))];
    let asked = then(then(ended, Block(asking)), Syscall);
    p.within_trans(r0, whole, p.within_known_to(layout, known, len, Rcx),
        r0.within_trans(asked, whole, Exists(20, refl), asked.within_word_from(layout, out, result, Rax)))
}

theorem Prog::within_closes(self p: Prog, layout: Layout, known: List<Fact>, out: List<Nat>, fd, result: Nat): p.Within(p.closes(layout, known, out, fd, result)) {
    let whole = p.closes(layout, known, out, fd, result);
    let c0 = then(p, Block([MovRI(Rax, BitVec::ofNat(3))]));
    let c1 = c0.known_to(layout, known, fd, Rdi);
    let asked = then(c1, Syscall);
    p.within_trans(c0, whole, p.within_then(0, Block([MovRI(Rax, BitVec::ofNat(3))])),
        c0.within_trans(c1, whole, c0.within_known_to(layout, known, fd, Rdi),
            c1.within_trans(asked, whole, c1.within_then(0, Syscall), asked.within_word_from(layout, out, result, Rax))))
}

// What a statement compiles to starts where it was given its start.
// A structured region is emitted only where it is scoped from every word.
theorem StructuredRegion::region_extends(self region: StructuredRegion, layout: Layout, p: Prog, out: List<Nat>, names: Nat, c: Compiled,
    emitted: (match region.scopes() { False => None, True => region.code(p, layout, out, names) }) = Some(c)): p.Within(c.prog) {
    (match region.scopes() as λ b => (match b as λ _ => Option<Compiled> { False => None, True => region.code(p, layout, out, names) }) = Some(c) → p.Within(c.prog) {
        False => λ none => absurd(none),
        True => λ code => region.within_code(layout, p, out, names, c, code),
    })(emitted)
}

theorem Stmt::emits_extends(self s: Stmt, layout: Layout): (p: Prog) → (out: List<Nat>) → (known: List<Fact>) → (names: Nat) → (c: Compiled) →
    s.emits(p, layout, out, known, names) = Some(c) → p.Within(c.prog) {
    match s {
        Compute(region) => match region {
            Dataflow(body) => λ p out known names c emitted => p.within_computes_best(layout, out, body.nodes, names, c, emitted),
            Sequence(prefix, continuation) => λ p out known names c emitted => Sequence(prefix, continuation).region_extends(layout, p, out, names, c, emitted),
            Compose(prefix, continuation) => λ p out known names c emitted => Compose(prefix, continuation).region_extends(layout, p, out, names, c, emitted),
            Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ p out known names c emitted => Conditional(inputs, condition, arguments, outputs, when_true, when_false).region_extends(layout, p, out, names, c, emitted),
            Call(callee, arguments, result) => λ p out known names c emitted => Call(callee, arguments, result).region_extends(layout, p, out, names, c, emitted),
            Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ p out known names c emitted => Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted).region_extends(layout, p, out, names, c, emitted),
        },
        Invoke(shape) => λ p out known names c => match shape {
            Reads(fd, buf, len, result) => match layout.words_fit([fd, len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(buf) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.reads(layout, known, out, fd, buf, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_reads(layout, known, out, fd, buf, len, result, capacity, names)),
                },
            },
            Writes(fd, buf, from, len, result) => match layout.words_fit([fd, from, len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(buf) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.writes(layout, known, out, fd, buf, from, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_writes(layout, known, out, fd, buf, from, len, result, capacity, names)),
                },
            },
            Opens(path, len, result) => match layout.words_fit([len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(path) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.opens(layout, known, out, path, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_opens(layout, known, out, path, len, result, capacity, names)),
                },
            },
            Closes(fd, result) => match layout.words_fit([fd, result]) {
                False => λ none => absurd(none),
                True => λ same => j(Option::some_inj(Compiled(p.closes(layout, known, out, fd, result), names), c, same),
                    λ x _ => p.Within(x.prog), p.within_closes(layout, known, out, fd, result)),
            },
            StatsPath(_, _, _, _) => λ none => absurd(none),
            StatsFd(_, _, _) => λ none => absurd(none),
        },
        Then(first, rest) => λ p out known names c => {
            let carried = first.carried(rest, layout.homes, out);
            let before = rest.live_with(layout.homes, carried, out);
            (match one: first.emits(p, layout, before, first.first_known(known), names) {
                None => λ none => absurd(none),
                Some(c1) => λ two => p.within_trans(c1.prog, c.prog, first.emits_extends(layout, p, before, first.first_known(known), names, c1, one),
                    rest.emits_extends(layout, c1.prog, out, carried, c1.names, c, two)),
            })
        },
        Branch(condition, yes, no) => λ p out known names c => {
            let tested = p.tests(layout, condition, Succ(names));
            match layout.word_fits(condition) {
                False => λ none => absurd(none),
                True => (match y_is: yes.emits(tested, layout, out, Nil, Succ(Succ(names))) {
                    None => λ none => absurd(none),
                    Some(y) => {
                        let other = y.prog.else_label(Succ(names), Succ(Succ(names)));
                        (match n_is: no.emits(other, layout, out, Nil, y.names) {
                            None => λ none => absurd(none),
                            Some(n) => λ same => j(Option::some_inj(Compiled(n.prog.join_label(Succ(Succ(names))), n.names), c, same),
                                λ x _ => p.Within(x.prog),
                                p.within_trans(tested, n.prog.join_label(Succ(Succ(names))), p.within_tests(layout, condition, Succ(names)),
                                    tested.within_trans(y.prog, n.prog.join_label(Succ(Succ(names))), yes.emits_extends(layout, tested, out, Nil, Succ(Succ(names)), y, y_is),
                                        y.prog.within_trans(other, n.prog.join_label(Succ(Succ(names))), Exists(2, refl),
                                            other.within_trans(n.prog, n.prog.join_label(Succ(Succ(names))), no.emits_extends(layout, other, out, Nil, y.names, n, n_is),
                                                n.prog.within_label(Succ(Succ(names)))))))),
                        })
                    },
                }),
            }
        },
        Repeat(body, again) => λ p out known names c => {
            let head = p.label(Succ(names));
            let inner = Repeat(body, again).loop_out(layout.homes, out);
            match layout.word_fits(again) {
                False => λ none => absurd(none),
                True => (match b_is: body.emits(head, layout, inner, Nil, Succ(Succ(names))) {
                    None => λ none => absurd(none),
                    Some(b) => λ same => {
                        let closed = then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names)));
                        j(Option::some_inj(Compiled(closed, b.names), c, same), λ x _ => p.Within(x.prog),
                            p.within_trans(head, closed, p.within_label(Succ(names)),
                                head.within_trans(b.prog, closed, body.emits_extends(layout, head, inner, Nil, Succ(Succ(names)), b, b_is),
                                    b.prog.within_trans(b.prog.tests(layout, again, Succ(Succ(names))), closed, b.prog.within_tests(layout, again, Succ(Succ(names))),
                                        Exists(2, refl)))))
                    },
                }),
            }
        },
        Exit(status) => λ p out known names c => match layout.word_fits(status) {
            False => λ none => absurd(none),
            True => λ same => j(Option::some_inj(Compiled(p.exits(layout, known, status), names), c, same), λ x _ => p.Within(x.prog),
                p.within_exits(layout, known, status)),
        },
        Arg(index, buf, len) => λ p out known names c => match layout.words_fit([index, len]) {
            False => λ none => absurd(none),
            True => match layout.capacities.nth(buf) {
                None => λ none => absurd(none),
                Some(capacity) => λ same => j(Option::some_inj(p.args(layout, out, index, buf, len, capacity, names), c, same),
                    λ x _ => p.Within(x.prog), p.within_args(layout, out, index, buf, len, capacity, names)),
            },
        },
        Perform(index, args, results) => λ p out known names c => match layout.call_fits(out, index, args, results) {
            False => λ none => absurd(none),
            True => λ same => j(Option::some_inj(Compiled(p.performs(layout, out, index, args, results), names), c, same), λ x _ => p.Within(x.prog),
                p.within_performs(layout, out, index, args, results)),
        },
    }
}

// Nothing known as the statement starts.
theorem Stmt::emit_extends(self s: Stmt, layout: Layout): (p: Prog) → (out: List<Nat>) → (names: Nat) → (c: Compiled) →
    s.emit(p, layout, out, names) = Some(c) → p.Within(c.prog) {
    λ p out names c emitted => s.emits_extends(layout)(p, out, Nil, names, c, emitted)
}

// ---------------------------------------------------------------------------
// A statement's claim

// Every exit, with its status, meets the continuation's tree there.
fn Target::Exiting(self t: Target, k: Flow → ITree<BitVec(64)>(Events::linux())) → Type {
    (status: BitVec(64)) → (u: MachineState<X86Memory(t.r.profile)>) → LinuxSyscallAt(t.io(), u) → LinuxExits(u, status) →
        SimPaid(t.io(), k(Exited(status)), u)
}

// The code from `p` to `q` runs as the statement, then `k`: wherever `k`
// goes on from `q`, `out` live, with every environment the statement may
// finish in. The statement starts with what it needs live (`live_in`).
fn Target::Runs(self t: Target, s: Stmt, call: Writers(), perform: Performs(), out: List<Nat>, p, q: Prog) → Type {
    (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → t.Exiting(k) →
        ((after: Env) → t.At(prog_len(q), out, k(Onward(after)), after)) →
        t.At(prog_len(p), s.live_in(t.homes, out), ITree::bind(Events::linux(), s.denote(call, perform, n, env), k), env)
}

// Every call the compile emits runs as the call: the hypothesis a
// statement's claim takes for its `Perform`s, proved for a source's own
// procedures by induction on the depth (`Target::calls`).
fn Target::Calls(self t: Target, call: Writers(), perform: Performs()) → Type {
    (p: Prog) → (out: List<Nat>) → (index: Nat) → (args, results: List<Nat>) → t.layout().call_fits(out, index, args, results).IsTrue() →
        p.performs(t.layout(), out, index, args, results).Within(t.program) → t.homes.all_apart(results, out).IsTrue() →
        t.Runs(Perform(index, args, results), call, perform, out, p, p.performs(t.layout(), out, index, args, results))
}

// With no procedures no call fits.
theorem Target::calls_bare(self t: Target, bare: t.procedures = Nil, call: Writers(), perform: Performs()): t.Calls(call, perform) {
    λ p out index args results fit => false_elim(j(bare, λ ps _ => Bool::IsTrue(match ps.nth(index) {
        None => False,
        Some(proc) => args.len().same_as(proc.params.len()) && (results.len().same_as(proc.results.len()) &&
            (args.len().leb(6) && (results.len().leb(6) && (t.layout().words_fit(args ++ (results ++ out.minus(results))) &&
            (out.minus(results).len().leb(t.layout().words) && t.layout().homes.moves_apart(out, results)))))),
    }), fit))
}

// The same where the words `known` holds are known as the statement starts:
// from every environment that has them, needing only `live_head` live.
fn Target::RunsK(self t: Target, s: Stmt, known: List<Fact>, call: Writers(), perform: Performs(), out: List<Nat>, p, q: Prog) → Type {
    (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → env.Knows(known) → t.Exiting(k) →
        ((after: Env) → t.At(prog_len(q), out, k(Onward(after)), after)) →
        t.At(prog_len(p), s.live_head(t.homes, known, out), ITree::bind(Events::linux(), s.denote(call, perform, n, env), k), env)
}

// Nothing known: what is live before a statement is what `live_in` says.
theorem CallShape::live_head_nil(self shape: CallShape, homes: Homes, out: List<Nat>): Invoke(shape).live_head(homes, Nil, out) = Invoke(shape).live_in(homes, out) {
    match shape {
        Reads(_, _, _, _) => refl,
        Writes(_, _, _, _, _) => refl,
        Opens(_, _, _) => refl,
        Closes(_, _) => refl,
        StatsPath(_, _, _, _) => refl,
        StatsFd(_, _, _) => refl,
    }
}

theorem Stmt::live_head_nil(self s: Stmt, homes: Homes, out: List<Nat>): s.live_head(homes, Nil, out) = s.live_in(homes, out) {
    match s {
        Invoke(shape) => shape.live_head_nil(homes, out),
        Exit(_) => refl,
        Then(first, rest) => (match first {
            Invoke(shape) => shape.live_head_nil(homes, rest.live_in(homes, out)),
            Exit(_) => refl,
            Compute(_) => refl,
            Then(_, _) => refl,
            Branch(_, _, _) => refl,
            Repeat(_, _) => refl,
            Arg(_, _, _) => refl,
            Perform(_, _, _) => refl,
        }),
        Compute(_) => refl,
        Branch(_, _, _) => refl,
        Repeat(_, _) => refl,
        Arg(_, _, _) => refl,
        Perform(_, _, _) => refl,
    }
}

theorem Target::runs_of(self t: Target, s: Stmt, call: Writers(), perform: Performs(), out: List<Nat>, p, q: Prog,
    runs: t.RunsK(s, Nil, call, perform, out, p, q)): t.Runs(s, call, perform, out, p, q) {
    λ n env k exits next => j(s.live_head_nil(t.homes, out), λ l _ => t.At(prog_len(p), l, ITree::bind(Events::linux(), s.denote(call, perform, n, env), k), env),
        runs(n, env, k, trivial, exits, next))
}

// A leaf that leaves known words to the statement after it: the facts are
// what its run leaves, and it passes the checks with what that statement
// then needs live after it, needing no word it needed before.
theorem Region::paired(self body: Region, rest: Stmt, homes: Homes, out: List<Nat>, f: Fact, fs: List<Fact>,
    carried: Compute(Dataflow(body)).pair_known(rest, homes, out) = Cons(f, fs)):
    (body.nodes.leaves_known() = Cons(f, fs)) ∧ (((homes.nodes_apart(body.nodes, rest.live_head(homes, Cons(f, fs), out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_head(homes, Cons(f, fs), out)))
        && nodes_live_in(body.nodes, rest.live_head(homes, Cons(f, fs), out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))).IsTrue()) {
    (match rest.reads_known() as λ b => rest.reads_known() = b →
            (match b as λ _ => List<Fact> {
                False => Nil,
                True => {
                    let known = body.nodes.leaves_known();
                    let before = rest.live_with(homes, known, out);
                    match (homes.nodes_apart(body.nodes, before) && homes.all_apart(nodes_writes(body.nodes), before))
                        && nodes_live_in(body.nodes, before).within(nodes_live_in(body.nodes, rest.live_in(homes, out))) {
                        False => Nil,
                        True => known,
                    }
                },
            }) = Cons(f, fs) → (body.nodes.leaves_known() = Cons(f, fs)) ∧ (((homes.nodes_apart(body.nodes, rest.live_head(homes, Cons(f, fs), out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_head(homes, Cons(f, fs), out)))
        && nodes_live_in(body.nodes, rest.live_head(homes, Cons(f, fs), out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))).IsTrue()) {
        False => λ _ none => absurd(none),
        True => λ _ => (match body.nodes.leaves_known() as λ l => body.nodes.leaves_known() = l →
                (match (homes.nodes_apart(body.nodes, rest.live_with(homes, l, out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_with(homes, l, out)))
                    && nodes_live_in(body.nodes, rest.live_with(homes, l, out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out))) as λ _ => List<Fact> {
                    False => Nil,
                    True => l,
                }) = Cons(f, fs) → (body.nodes.leaves_known() = Cons(f, fs)) ∧ (((homes.nodes_apart(body.nodes, rest.live_head(homes, Cons(f, fs), out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_head(homes, Cons(f, fs), out)))
        && nodes_live_in(body.nodes, rest.live_head(homes, Cons(f, fs), out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))).IsTrue()) {
            Nil => λ _ none => {
                let g = (homes.nodes_apart(body.nodes, rest.live_in(homes, out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_in(homes, out)))
                    && nodes_live_in(body.nodes, rest.live_in(homes, out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)));
                false_elim((match g as λ b => (match b as λ _ => List<Fact> { False => Nil, True => Nil }) = Cons(f, fs) → False {
                    False => λ e => absurd(e),
                    True => λ e => absurd(e),
                })(none))
            },
            Cons(g1, gs) => λ at same => {
                let before = rest.live_head(homes, Cons(g1, gs), out);
                (match (homes.nodes_apart(body.nodes, before) && homes.all_apart(nodes_writes(body.nodes), before))
                        && nodes_live_in(body.nodes, before).within(nodes_live_in(body.nodes, rest.live_in(homes, out))) as λ b =>
                        ((homes.nodes_apart(body.nodes, before) && homes.all_apart(nodes_writes(body.nodes), before))
                        && nodes_live_in(body.nodes, before).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))) = b →
                        (match b as λ _ => List<Fact> { False => Nil, True => Cons(g1, gs) }) = Cons(f, fs) →
                        (body.nodes.leaves_known() = Cons(f, fs)) ∧ (((homes.nodes_apart(body.nodes, rest.live_head(homes, Cons(f, fs), out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_head(homes, Cons(f, fs), out)))
        && nodes_live_in(body.nodes, rest.live_head(homes, Cons(f, fs), out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))).IsTrue()) {
                    False => λ _ none => absurd(none),
                    True => λ passed e => j(e, λ l _ => (body.nodes.leaves_known() = l) ∧ (((homes.nodes_apart(body.nodes, rest.live_head(homes, l, out)) && homes.all_apart(nodes_writes(body.nodes), rest.live_head(homes, l, out)))
        && nodes_live_in(body.nodes, rest.live_head(homes, l, out)).within(nodes_live_in(body.nodes, rest.live_in(homes, out)))).IsTrue()),
                        ⟨at, j(sym(passed), λ b _ => b.IsTrue(), trivial)⟩),
                })(refl, same)
            },
        })(refl),
    })(refl, carried)
}

// A tree the same as one the code runs as.
theorem Target::at_similar(self t: Target, at: Nat, live: List<Nat>, tree, other: ITree<BitVec(64)>(Events::linux()), env: Env,
    same: ITree::Same(Events::linux(), tree, other), goes: t.At(at, live, other, env)): t.At(at, live, tree, env) {
    t.site().goes_same(t.io(), at, tree, other, λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(live, env, s.gprs, s.memory), same, goes)
}

// A loop of `m` more rounds over its set `set` (what is live at its head):
// the body from its head label, the test after it, a JMP back while the
// bit is set, and out past the loop's label when it is clear. The body
// runs with the bit, the set and what is live after the loop live after
// it (`loop_after`), and needs no more than the set before it (`closed`).
theorem Target::goes_repeat(self t: Target, body: Stmt, again: Nat, call: Writers(), perform: Performs(), n: Nat, p: Prog, names: Nat, b: Prog, out, set: List<Nat>,
    inside: again < t.words,
    within: then(b.tests(t.layout(), again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))).Within(t.program),
    head_within: p.label(Succ(names)).Within(t.program),
    closed: (i: Nat) → Mem(i, body.live_in(t.homes, loop_after(again, set, out))) → Mem(i, set),
    runs: t.Runs(body, call, perform, loop_after(again, set, out), p.label(Succ(names)), b),
    k: Flow → ITree<BitVec(64)>(Events::linux()), exits: t.Exiting(k),
    next: (after: Env) → t.At(prog_len(then(b.tests(t.layout(), again, Succ(Succ(names))), Jmp(Succ(names)))), out, k(Onward(after)), after),
    m: Nat): (env: Env) → t.At(prog_len(p), set, ITree::bind(Events::linux(),
        ITree::iter(Events::linux(), m, λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)), env), k), env) {
    let f = λ (e: Env) => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ (flow: Flow) => flow.pass(again));
    let tested = b.tests(t.layout(), again, Succ(Succ(names)));
    let jumped = then(tested, Jmp(Succ(names)));
    let w_jumped = jumped.within_before(Succ(Succ(names)), Block([]), t.program, within);
    let w_tested = tested.within_before(0, Jmp(Succ(names)), t.program, w_jumped);
    let after_set = loop_after(again, set, out);
    let widen = λ (i: Nat) (m2: Mem(i, set)) => { let w: Mem(i, after_set) = Inr(set.union_left(out, i, m2)); w };
    let outer = λ (i: Nat) (m2: Mem(i, out)) => { let w: Mem(i, after_set) = Inr(set.union_right(out, i, m2)); w };
    match m {
        Zero => λ env => λ s here resident held => paid_cut(t.io(), s),
        Succ(m2) => λ env => {
            let rest = λ (x: Step<Env, Flow>) => match x as λ _ => ITree<Flow>(Events::linux()) {
                Continue(a2) => Tau(ITree::iter(Events::linux(), m2, f, a2)),
                Break(done) => Ret(done),
            };
            let after_pass = λ (x: Step<Env, Flow>) => ITree::bind(Events::linux(), rest(x), k);
            let k2 = λ (flow: Flow) => after_pass(flow.pass(again));
            let d = body.denote(call, perform, n, env);
            let same = ITree::same_trans(Events::linux(),
                ITree::bind(Events::linux(), ITree::bind(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), rest), k),
                ITree::bind(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), after_pass),
                ITree::bind(Events::linux(), d, k2),
                ITree::bind_assoc(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), rest, k),
                ITree::bind_assoc(Events::linux(), d, λ (flow: Flow) => Ret(flow.pass(again)), after_pass));
            let looped = λ (after: Env) => t.goes_tests(after_set, after, b, again, Succ(names), inside, Inl(refl), w_tested, within.witness, jumped, Block([]), within.proof,
                k2(Onward(after)),
                λ (bit_set: after.bit(again) = True) => j(sym(bit_set), λ bit _ => t.At(prog_len(tested), after_set,
                        after_pass(match bit { True => Continue(after), False => Break(Onward(after)) }), after),
                    t.at_jmp_tau(tested, names, w_jumped, p, Block([]), head_within, ITree::bind(Events::linux(), ITree::iter(Events::linux(), m2, f, after), k),
                        after_set, after,
                        λ s here resident held =>
                            t.goes_repeat(body, again, call, perform, n, p, names, b, out, set, inside, within, head_within, closed, runs, k, exits, next, m2, after,
                                s, here, resident, t.held_sub(set, after_set, after, s.gprs, s.memory, held, widen)))),
                λ (clear: after.bit(again) = False) => j(sym(clear), λ bit _ => t.At(prog_len(jumped), after_set,
                        after_pass(match bit { True => Continue(after), False => Break(Onward(after)) }), after),
                    t.at_sub(prog_len(jumped), out, after_set, k(Onward(after)), after, outer, next(after))));
            t.at_similar(prog_len(p), set, ITree::bind(Events::linux(), ITree::iter(Events::linux(), Succ(m2), f, env), k), ITree::bind(Events::linux(), d, k2), env,
                same, t.at_sub(prog_len(p), body.live_in(t.homes, after_set), set, ITree::bind(Events::linux(), d, k2), env, closed, runs(n, env, k2, exits, looped)))
        },
    }
}

// A structured region compiled runs as its run settled: its code runs as
// its meaning (`StructuredRegion::code_runs`), which is the run settled
// where the region is scoped from every word (`compute_same`).
theorem StructuredRegion::region_runs(self region: StructuredRegion, t: Target, call: Writers(), fns: t.Functions(call), p: Prog, out: List<Nat>, names: Nat, c: Compiled,
    emitted: (match region.scopes() { False => None, True => region.code(p, t.layout(), out, names) }) = Some(c), within: c.prog.Within(t.program),
    checked: Bool::IsTrue(match t.homes.region_checked(region, out) { None => False, Some(_) => True })):
    (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → t.Exiting(k) →
        ((after: Env) → t.At(prog_len(c.prog), out, k(Onward(after)), after)) →
        t.At(prog_len(p), t.homes.region_live(region, out), k(Onward(env.compute(call, region))), env) {
    λ n env k exits next => {
        let tree = k(Onward(env.compute(call, region)));
        (match region.scoped(Scope::all()) as λ o => region.scoped(Scope::all()) = o →
                (match (match o as λ _ => Bool { None => False, Some(_) => True }) as λ _ => Option<Compiled> {
                    False => None,
                    True => region.code(p, t.layout(), out, names),
                }) = Some(c) →
                t.At(prog_len(p), t.homes.region_live(region, out), tree, env) {
            None => λ _ none => absurd(none),
            Some(st) => λ scoped code => {
                let same = region.compute_same(call, st, scoped, env);
                let goes = t.at_like(prog_len(c.prog), out, tree, env.compute(call, region), region.meaning(call, env),
                    env.compute(call, region).like_sym(region.meaning(call, env), out, env.compute(call, region).like_of_same(region.meaning(call, env), out, same)),
                    next(env.compute(call, region)));
                (match t.homes.region_checked(region, out) as λ o => t.homes.region_checked(region, out) = o →
                        Bool::IsTrue(match o { None => False, Some(_) => True }) →
                        t.At(prog_len(p), match o { None => out, Some(l) => l }, tree, env) {
                    None => λ _ never => false_elim(never),
                    Some(l) => λ got _ => region.code_runs(t, call, fns, region.ok_of_scoped(Scope::all(), st, scoped), p, out, names, c, code, within, l, got,
                        env, tree, goes),
                })(refl, checked)
            },
        })(refl, emitted)
    }
}

// ---------------------------------------------------------------------------
// Every statement compiled runs as its tree

// What `emits_runs` proves of a statement: every emission of it, whatever
// is known as it starts, runs as it.
fn Target::EmitsRun(self t: Target, s: Stmt, call: Writers(), perform: Performs()) → Type {
    (p: Prog) → (out: List<Nat>) → (known: List<Fact>) → (names: Nat) → (c: Compiled) →
        s.emits(p, t.layout(), out, known, names) = Some(c) → c.prog.Within(t.program) → s.checks(t.homes, out).IsTrue() → t.RunsK(s, known, call, perform, out, p, c.prog)
}

// A `Then` whose parts run with nothing known: the first part, then the
// rest.
theorem Target::then_nil(self t: Target, first, rest: Stmt, call: Writers(), perform: Performs(),
    ih_first: t.EmitsRun(first, call, perform), ih_rest: t.EmitsRun(rest, call, perform), p: Prog, out: List<Nat>, names: Nat, c: Compiled,
    emitted: (match first.emits(p, t.layout(), rest.live_in(t.homes, out), Nil, names) as λ _ => Option<Compiled> {
        None => None,
        Some(c1) => rest.emits(c1.prog, t.layout(), out, Nil, c1.names),
    }) = Some(c),
    within: c.prog.Within(t.program), checked: (first.checks(t.homes, rest.live_in(t.homes, out)) && rest.checks(t.homes, out)).IsTrue()):
    t.Runs(Then(first, rest), call, perform, out, p, c.prog) {
    let layout = t.layout();
    let ok = Bool::is_true_and(first.checks(t.homes, rest.live_in(t.homes, out)), rest.checks(t.homes, out), checked);
    (match first.emits(p, layout, rest.live_in(t.homes, out), Nil, names) as λ o => first.emits(p, layout, rest.live_in(t.homes, out), Nil, names) = o →
            (match o as λ _ => Option<Compiled> { None => None, Some(c1) => rest.emits(c1.prog, layout, out, Nil, c1.names) }) = Some(c) →
            t.Runs(Then(first, rest), call, perform, out, p, c.prog) {
        None => λ _ none => absurd(none),
        Some(c1) => λ one two => {
            let w_first = c1.prog.within_trans(c.prog, t.program, rest.emits_extends(layout, c1.prog, out, Nil, c1.names, c, two), within);
            let run_first = t.runs_of(first, call, perform, rest.live_in(t.homes, out), p, c1.prog,
                ih_first(p, rest.live_in(t.homes, out), Nil, names, c1, one, w_first, ok.left));
            let run_rest = t.runs_of(rest, call, perform, out, c1.prog, c.prog, ih_rest(c1.prog, out, Nil, c1.names, c, two, within, ok.right));
            λ n env k exits next => {
                let h = λ (flow: Flow) => match flow as λ _ => ITree<Flow>(Events::linux()) {
                    Onward(after) => rest.denote(call, perform, n, after),
                    Exited(status) => Ret(Exited(status)),
                };
                let k2 = λ (flow: Flow) => ITree::bind(Events::linux(), h(flow), k);
                t.at_similar(prog_len(p), first.live_in(t.homes, rest.live_in(t.homes, out)), ITree::bind(Events::linux(), ITree::bind(Events::linux(), first.denote(call, perform, n, env), h), k),
                    ITree::bind(Events::linux(), first.denote(call, perform, n, env), k2), env,
                    ITree::bind_assoc(Events::linux(), first.denote(call, perform, n, env), h, k),
                    run_first(n, env, k2, exits, λ after => run_rest(n, after, k, exits, next)))
            }
        },
    })(refl, emitted)
}

// A `Then` whose first part is a call or an exit: that part starts with
// what the sequence knows, the rest with nothing.
theorem Target::then_known(self t: Target, first, rest: Stmt, call: Writers(), perform: Performs(),
    ih_first: t.EmitsRun(first, call, perform), ih_rest: t.EmitsRun(rest, call, perform), p: Prog, out: List<Nat>, known: List<Fact>, names: Nat, c: Compiled,
    emitted: (match first.emits(p, t.layout(), rest.live_in(t.homes, out), known, names) as λ _ => Option<Compiled> {
        None => None,
        Some(c1) => rest.emits(c1.prog, t.layout(), out, Nil, c1.names),
    }) = Some(c),
    within: c.prog.Within(t.program), checked: (first.checks(t.homes, rest.live_in(t.homes, out)) && rest.checks(t.homes, out)).IsTrue()):
    (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → env.Knows(known) → t.Exiting(k) →
        ((after: Env) → t.At(prog_len(c.prog), out, k(Onward(after)), after)) →
        t.At(prog_len(p), first.live_head(t.homes, known, rest.live_in(t.homes, out)), ITree::bind(Events::linux(), Then(first, rest).denote(call, perform, n, env), k), env) {
    let layout = t.layout();
    let ok = Bool::is_true_and(first.checks(t.homes, rest.live_in(t.homes, out)), rest.checks(t.homes, out), checked);
    (match first.emits(p, layout, rest.live_in(t.homes, out), known, names) as λ o => first.emits(p, layout, rest.live_in(t.homes, out), known, names) = o →
            (match o as λ _ => Option<Compiled> { None => None, Some(c1) => rest.emits(c1.prog, layout, out, Nil, c1.names) }) = Some(c) →
            (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → env.Knows(known) → t.Exiting(k) →
            ((after: Env) → t.At(prog_len(c.prog), out, k(Onward(after)), after)) →
            t.At(prog_len(p), first.live_head(t.homes, known, rest.live_in(t.homes, out)), ITree::bind(Events::linux(), Then(first, rest).denote(call, perform, n, env), k), env) {
        None => λ _ none => absurd(none),
        Some(c1) => λ one two => {
            let w_first = c1.prog.within_trans(c.prog, t.program, rest.emits_extends(layout, c1.prog, out, Nil, c1.names, c, two), within);
            let run_first = ih_first(p, rest.live_in(t.homes, out), known, names, c1, one, w_first, ok.left);
            let run_rest = t.runs_of(rest, call, perform, out, c1.prog, c.prog, ih_rest(c1.prog, out, Nil, c1.names, c, two, within, ok.right));
            λ n env k knows exits next => {
                let h = λ (flow: Flow) => match flow as λ _ => ITree<Flow>(Events::linux()) {
                    Onward(after) => rest.denote(call, perform, n, after),
                    Exited(status) => Ret(Exited(status)),
                };
                let k2 = λ (flow: Flow) => ITree::bind(Events::linux(), h(flow), k);
                t.at_similar(prog_len(p), first.live_head(t.homes, known, rest.live_in(t.homes, out)),
                    ITree::bind(Events::linux(), ITree::bind(Events::linux(), first.denote(call, perform, n, env), h), k),
                    ITree::bind(Events::linux(), first.denote(call, perform, n, env), k2), env,
                    ITree::bind_assoc(Events::linux(), first.denote(call, perform, n, env), h, k),
                    run_first(n, env, k2, knows, exits, λ after => run_rest(n, after, k, exits, next)))
            }
        },
    })(refl, emitted)
}

// A leaf leaving known words to the call or exit after it: the leaf
// compiled with only what that then needs live, the rest with the words
// known. The leaf's run leaves the facts (`Env::computes_knows`), and the
// check `pair_known` made puts what the leaf needs within what it needed.
theorem Target::then_pair(self t: Target, body: Region, rest: Stmt, call: Writers(), perform: Performs(),
    ih_rest: t.EmitsRun(rest, call, perform), p: Prog, out: List<Nat>, names: Nat, c: Compiled, f: Fact, fs: List<Fact>,
    carried: Compute(Dataflow(body)).pair_known(rest, t.homes, out) = Cons(f, fs),
    emitted: (match p.computes_best(t.layout(), rest.live_head(t.homes, Cons(f, fs), out), body.nodes, names) as λ _ => Option<Compiled> {
        None => None,
        Some(c1) => rest.emits(c1.prog, t.layout(), out, Cons(f, fs), c1.names),
    }) = Some(c),
    within: c.prog.Within(t.program), checked: Then(Compute(Dataflow(body)), rest).checks(t.homes, out).IsTrue()):
    t.Runs(Then(Compute(Dataflow(body)), rest), call, perform, out, p, c.prog) {
    let layout = t.layout();
    let nodes = body.nodes;
    let before = rest.live_head(t.homes, Cons(f, fs), out);
    let leaf = Compute(Dataflow(body));
    let pair = body.paired(rest, t.homes, out, f, fs, carried);
    let guard = Bool::is_true_and(t.homes.nodes_apart(nodes, before) && t.homes.all_apart(nodes_writes(nodes), before),
        nodes_live_in(nodes, before).within(nodes_live_in(nodes, rest.live_in(t.homes, out))), pair.right);
    let ok = Bool::is_true_and(leaf.checks(t.homes, rest.live_in(t.homes, out)), rest.checks(t.homes, out), checked);
    (match p.computes_best(layout, before, nodes, names) as λ o => p.computes_best(layout, before, nodes, names) = o →
            (match o as λ _ => Option<Compiled> { None => None, Some(c1) => rest.emits(c1.prog, layout, out, Cons(f, fs), c1.names) }) = Some(c) →
            t.Runs(Then(Compute(Dataflow(body)), rest), call, perform, out, p, c.prog) {
        None => λ _ none => absurd(none),
        Some(c1) => λ one two => {
            let w_first = c1.prog.within_trans(c.prog, t.program, rest.emits_extends(layout, c1.prog, out, Cons(f, fs), c1.names, c, two), within);
            let run_rest = ih_rest(c1.prog, out, Cons(f, fs), c1.names, c, two, within, ok.right);
            λ n env k exits next => {
                let h = λ (flow: Flow) => match flow as λ _ => ITree<Flow>(Events::linux()) {
                    Onward(after) => rest.denote(call, perform, n, after),
                    Exited(status) => Ret(Exited(status)),
                };
                let k2 = λ (flow: Flow) => ITree::bind(Events::linux(), h(flow), k);
                let after = env.computes(nodes);
                let knows = j(pair.left, λ l _ => after.Knows(l), env.computes_knows(nodes));
                t.at_similar(prog_len(p), nodes_live_in(nodes, rest.live_in(t.homes, out)),
                    ITree::bind(Events::linux(), ITree::bind(Events::linux(), leaf.denote(call, perform, n, env), h), k),
                    ITree::bind(Events::linux(), leaf.denote(call, perform, n, env), k2), env,
                    ITree::bind_assoc(Events::linux(), leaf.denote(call, perform, n, env), h, k),
                    t.at_sub(prog_len(p), nodes_live_in(nodes, before), nodes_live_in(nodes, rest.live_in(t.homes, out)),
                        ITree::bind(Events::linux(), leaf.denote(call, perform, n, env), k2), env,
                        nodes_live_in(nodes, before).within_mem(nodes_live_in(nodes, rest.live_in(t.homes, out)), guard.right),
                        t.goes_computes_best(before, env, p, nodes, names, c1, one, w_first, k2(Onward(after)), guard.left,
                            run_rest(n, after, k, knows, exits, next))))
            }
        },
    })(refl, emitted)
}

theorem Stmt::emits_runs(self s: Stmt, t: Target, call: Writers(), perform: Performs(), calls: t.Calls(call, perform), fns: t.Functions(call)):
    t.EmitsRun(s, call, perform) {
    let layout = t.layout();
    match s {
        Compute(region) => match region {
            Dataflow(body) => λ p out known names c emitted within checked n env k _ exits next => t.goes_computes_best(out, env, p, body.nodes, names, c, emitted, within,
                k(Onward(env.compute(call, Dataflow(body)))), checked, next(env.compute(call, Dataflow(body)))),
            Sequence(prefix, continuation) => λ p out known names c emitted within checked n env k _ => Sequence(prefix, continuation).region_runs(t, call, fns, p, out, names, c, emitted, within, checked)(n, env, k),
            Compose(prefix, continuation) => λ p out known names c emitted within checked n env k _ => Compose(prefix, continuation).region_runs(t, call, fns, p, out, names, c, emitted, within, checked)(n, env, k),
            Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ p out known names c emitted within checked n env k _ => Conditional(inputs, condition, arguments, outputs, when_true, when_false).region_runs(t, call, fns, p, out, names, c, emitted, within, checked)(n, env, k),
            Call(callee, arguments, result) => λ p out known names c emitted within checked n env k _ => Call(callee, arguments, result).region_runs(t, call, fns, p, out, names, c, emitted, within, checked)(n, env, k),
            Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ p out known names c emitted within checked n env k _ => Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted).region_runs(t, call, fns, p, out, names, c, emitted, within, checked)(n, env, k),
        },
        Invoke(shape) => λ p out known names c => match shape {
            Reads(fd, buf, len, result) => (match layout.words_fit([fd, len, result]) as λ b => layout.words_fit([fd, len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.reads(layout, known, out, fd, buf, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Reads(fd, buf, len, result)), known, call, perform, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(len) && (layout.word_fits(result) && True), j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, ok.right);
                    let ok3 = Bool::is_true_and(layout.word_fits(result), True, ok2.right);
                    (match found: t.caps.nth(buf) {
                        None => λ none => absurd(none),
                        Some(capacity) => λ same => j(Option::some_inj(p.reads(layout, known, out, fd, buf, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Reads(fd, buf, len, result)), known, call, perform, out, p, x.prog),
                            λ within apart n env k knows exits next => t.goes_reads(out, env, p, known, knows, fd, buf, len, result, capacity, names,
                                layout.word_inside(fd, ok.left), layout.word_inside(len, ok2.left), layout.word_inside(result, ok3.left), found, apart, within,
                                λ a => k(Onward(Reads(fd, buf, len, result).answer(env, a))),
                                λ a answers => next(Reads(fd, buf, len, result).answer(env, a)))),
                    })
                },
            })(refl),
            Writes(fd, buf, from, len, result) => (match layout.words_fit([fd, from, len, result]) as λ b => layout.words_fit([fd, from, len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.writes(layout, known, out, fd, buf, from, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Writes(fd, buf, from, len, result)), known, call, perform, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(from) && (layout.word_fits(len) && (layout.word_fits(result) && True)),
                        j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(from), layout.word_fits(len) && (layout.word_fits(result) && True), ok.right);
                    let ok3 = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, ok2.right);
                    let ok4 = Bool::is_true_and(layout.word_fits(result), True, ok3.right);
                    (match found: t.caps.nth(buf) {
                        None => λ none => absurd(none),
                        Some(capacity) => λ same => j(Option::some_inj(p.writes(layout, known, out, fd, buf, from, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Writes(fd, buf, from, len, result)), known, call, perform, out, p, x.prog),
                            λ within apart n env k knows exits next => t.goes_writes(out, env, p, known, knows, fd, buf, from, len, result, capacity, names,
                                layout.word_inside(fd, ok.left), layout.word_inside(from, ok2.left), layout.word_inside(len, ok3.left),
                                layout.word_inside(result, ok4.left), found, apart, within,
                                λ a => k(Onward(Writes(fd, buf, from, len, result).answer(env, a))),
                                λ a answers => next(Writes(fd, buf, from, len, result).answer(env, a)))),
                    })
                },
            })(refl),
            Opens(path, len, result) => (match layout.words_fit([len, result]) as λ b => layout.words_fit([len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(path) { None => None, Some(capacity) => Some(p.opens(layout, known, out, path, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Opens(path, len, result)), known, call, perform, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(result), True, ok.right);
                    (match found: t.caps.nth(path) {
                        None => λ none => absurd(none),
                        Some(capacity) => λ same => j(Option::some_inj(p.opens(layout, known, out, path, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Opens(path, len, result)), known, call, perform, out, p, x.prog),
                            λ within apart n env k knows exits next => t.goes_opens(out, env, p, known, knows, path, len, result, capacity, names,
                                layout.word_inside(len, ok.left), layout.word_inside(result, ok2.left), found, apart, within,
                                λ a => k(Onward(Opens(path, len, result).answer(env, a))),
                                λ a answers => next(Opens(path, len, result).answer(env, a)))),
                    })
                },
            })(refl),
            Closes(fd, result) => (match layout.words_fit([fd, result]) as λ b => layout.words_fit([fd, result]) = b → (match b {
                    False => None,
                    True => Some(Compiled(p.closes(layout, known, out, fd, result), names)),
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Closes(fd, result)), known, call, perform, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit same => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(result) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(result), True, ok.right);
                    j(Option::some_inj(Compiled(p.closes(layout, known, out, fd, result), names), c, same),
                        λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.RunsK(Invoke(Closes(fd, result)), known, call, perform, out, p, x.prog),
                        λ within apart n env k knows exits next => t.goes_closes(out, env, p, known, knows, fd, result, layout.word_inside(fd, ok.left), layout.word_inside(result, ok2.left),
                            apart, within,
                            λ a => k(Onward(Closes(fd, result).answer(env, a))),
                            λ a answers => next(Closes(fd, result).answer(env, a))))
                },
            })(refl),
            StatsPath(_, _, _, _) => λ none => absurd(none),
            StatsFd(_, _, _) => λ none => absurd(none),
        },
        Then(first, rest) => {
            let ih_first = first.emits_runs(t, call, perform, calls, fns);
            let ih_rest = rest.emits_runs(t, call, perform, calls, fns);
            (match first as λ x => t.EmitsRun(x, call, perform) → t.EmitsRun(Then(x, rest), call, perform) {
                Invoke(shape) => λ ih p out known names c emitted within checked =>
                    t.then_known(Invoke(shape), rest, call, perform, ih, ih_rest, p, out, known, names, c, emitted, within, checked),
                Exit(status) => λ ih p out known names c emitted within checked =>
                    t.then_known(Exit(status), rest, call, perform, ih, ih_rest, p, out, known, names, c, emitted, within, checked),
                Compute(region) => match region {
                    Dataflow(body) => λ ih p out known names c => {
                        let leaf = Compute(Dataflow(body));
                        (match leaf.pair_known(rest, t.homes, out) as λ l => leaf.pair_known(rest, t.homes, out) = l →
                                (match leaf.emits(p, layout, rest.live_with(t.homes, l, out), Nil, names) as λ _ => Option<Compiled> {
                                    None => None,
                                    Some(c1) => rest.emits(c1.prog, layout, out, l, c1.names),
                                }) = Some(c) → c.prog.Within(t.program) → Then(leaf, rest).checks(t.homes, out).IsTrue() →
                                t.RunsK(Then(leaf, rest), known, call, perform, out, p, c.prog) {
                            Nil => λ _ emitted within checked n env k _ =>
                                t.then_nil(leaf, rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                            Cons(f, fs) => λ carried emitted within checked n env k _ =>
                                t.then_pair(body, rest, call, perform, ih_rest, p, out, names, c, f, fs, carried, emitted, within, checked)(n, env, k),
                        })(refl)
                    },
                    Sequence(a, b) => λ ih p out known names c emitted within checked n env k _ =>
                        t.then_nil(Compute(Sequence(a, b)), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                    Compose(a, b) => λ ih p out known names c emitted within checked n env k _ =>
                        t.then_nil(Compute(Compose(a, b)), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                    Conditional(i, d, a, o, y, w) => λ ih p out known names c emitted within checked n env k _ =>
                        t.then_nil(Compute(Conditional(i, d, a, o, y, w)), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                    Call(e, a, o) => λ ih p out known names c emitted within checked n env k _ =>
                        t.then_nil(Compute(Call(e, a, o)), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                    Loop(i, b, a, d, y, x, e, o, h) => λ ih p out known names c emitted within checked n env k _ =>
                        t.then_nil(Compute(Loop(i, b, a, d, y, x, e, o, h)), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                },
                Then(a, b) => λ ih p out known names c emitted within checked n env k _ =>
                    t.then_nil(Then(a, b), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                Branch(d, y, w) => λ ih p out known names c emitted within checked n env k _ =>
                    t.then_nil(Branch(d, y, w), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                Repeat(b, a) => λ ih p out known names c emitted within checked n env k _ =>
                    t.then_nil(Repeat(b, a), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                Arg(i, b, l) => λ ih p out known names c emitted within checked n env k _ =>
                    t.then_nil(Arg(i, b, l), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
                Perform(g, a, r) => λ ih p out known names c emitted within checked n env k _ =>
                    t.then_nil(Perform(g, a, r), rest, call, perform, ih, ih_rest, p, out, names, c, emitted, within, checked)(n, env, k),
            })(ih_first)
        },
        Branch(condition, yes, no) => λ p out known names c => {
            let tested = p.tests(layout, condition, Succ(names));
            (match fit: layout.word_fits(condition) {
                False => λ none => absurd(none),
                True => (match y_is: yes.emits(tested, layout, out, Nil, Succ(Succ(names))) {
                    None => λ none => absurd(none),
                    Some(y) => {
                        let other = y.prog.else_label(Succ(names), Succ(Succ(names)));
                        (match n_is: no.emits(other, layout, out, Nil, y.names) {
                            None => λ none => absurd(none),
                            Some(nc) => λ same => j(Option::some_inj(Compiled(nc.prog.join_label(Succ(Succ(names))), nc.names), c, same),
                                λ x _ => x.prog.Within(t.program) → Branch(condition, yes, no).checks(t.homes, out).IsTrue() →
                                    t.RunsK(Branch(condition, yes, no), known, call, perform, out, p, x.prog),
                                λ within checked => {
                                    let ok = Bool::is_true_and(yes.checks(t.homes, out), no.checks(t.homes, out), checked);
                                    let jumped = then(y.prog, Jmp(Succ(Succ(names))));
                                    let w_no = nc.prog.within_before(Succ(Succ(names)), Block([]), t.program, within);
                                    let w_other = other.within_trans(nc.prog, t.program, no.emits_extends(layout, other, out, Nil, y.names, nc, n_is), w_no);
                                    let w_jumped = jumped.within_before(Succ(names), Block([]), t.program, w_other);
                                    let w_yes = y.prog.within_before(0, Jmp(Succ(Succ(names))), t.program, w_jumped);
                                    let w_tested = tested.within_trans(y.prog, t.program, yes.emits_extends(layout, tested, out, Nil, Succ(Succ(names)), y, y_is), w_yes);
                                    let run_yes = t.runs_of(yes, call, perform, out, tested, y.prog, yes.emits_runs(t, call, perform, calls, fns, tested, out, Nil, Succ(Succ(names)), y, y_is, w_yes, ok.left));
                                    let run_no = t.runs_of(no, call, perform, out, other, nc.prog, no.emits_runs(t, call, perform, calls, fns, other, out, Nil, y.names, nc, n_is, w_no, ok.right));
                                    let inside = layout.word_inside(condition, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                                    let arms = yes.live_in(t.homes, out).union(no.live_in(t.homes, out));
                                    let live = Cons(condition, arms);
                                    λ n env k _ exits next => t.goes_tests(live, env, p, condition, names, inside, Inl(refl), w_tested, w_other.witness, jumped, Block([]), w_other.proof,
                                        ITree::bind(Events::linux(), match env.bit(condition) as λ _ => ITree<Flow>(Events::linux()) {
                                            True => yes.denote(call, perform, n, env),
                                            False => no.denote(call, perform, n, env),
                                        }, k),
                                        λ (set: env.bit(condition) = True) => j(sym(set), λ bit _ => t.At(prog_len(tested), live,
                                                ITree::bind(Events::linux(), match bit as λ _ => ITree<Flow>(Events::linux()) {
                                                    True => yes.denote(call, perform, n, env),
                                                    False => no.denote(call, perform, n, env),
                                                }, k), env),
                                            t.at_sub(prog_len(tested), yes.live_in(t.homes, out), live, ITree::bind(Events::linux(), yes.denote(call, perform, n, env), k), env,
                                                λ i m => Inr(yes.live_in(t.homes, out).union_left(no.live_in(t.homes, out), i, m)),
                                                run_yes(n, env, k, exits, λ after => t.at_jmp(y.prog, Succ(names), w_jumped, nc.prog, Block([]), within,
                                                    k(Onward(after)), out, after, next(after))))),
                                        λ (clear: env.bit(condition) = False) => j(sym(clear), λ bit _ => t.At(prog_len(jumped), live,
                                                ITree::bind(Events::linux(), match bit as λ _ => ITree<Flow>(Events::linux()) {
                                                    True => yes.denote(call, perform, n, env),
                                                    False => no.denote(call, perform, n, env),
                                                }, k), env),
                                            t.at_sub(prog_len(jumped), no.live_in(t.homes, out), live, ITree::bind(Events::linux(), no.denote(call, perform, n, env), k), env,
                                                λ i m => Inr(yes.live_in(t.homes, out).union_right(no.live_in(t.homes, out), i, m)),
                                                run_no(n, env, k, exits, next))))
                                }),
                        })
                    },
                }),
            })
        },
        Repeat(body, again) => λ p out known names c => {
            let head = p.label(Succ(names));
            let inner = Repeat(body, again).loop_out(t.homes, out);
            (match fit: layout.word_fits(again) {
                False => λ none => absurd(none),
                True => (match b_is: body.emits(head, layout, inner, Nil, Succ(Succ(names))) {
                    None => λ none => absurd(none),
                    Some(cb) => λ same => {
                        let tested = cb.prog.tests(layout, again, Succ(Succ(names)));
                        let closed = then(tested, Jmp(Succ(names))).label(Succ(Succ(names)));
                        j(Option::some_inj(Compiled(closed, cb.names), c, same),
                            λ x _ => x.prog.Within(t.program) → Repeat(body, again).checks(t.homes, out).IsTrue() → t.RunsK(Repeat(body, again), known, call, perform, out, p, x.prog),
                            λ within checked => {
                                let set = Repeat(body, again).live_in(t.homes, out);
                                let ok = Bool::is_true_and(body.live_in(t.homes, loop_after(again, set, out)).within(set), body.checks(t.homes, loop_after(again, set, out)), checked);
                                let w_jumped = then(tested, Jmp(Succ(names))).within_before(Succ(Succ(names)), Block([]), t.program, within);
                                let w_tested = tested.within_before(0, Jmp(Succ(names)), t.program, w_jumped);
                                let w_body = cb.prog.within_trans(tested, t.program, cb.prog.within_tests(layout, again, Succ(Succ(names))), w_tested);
                                let w_head = head.within_trans(cb.prog, t.program, body.emits_extends(layout, head, inner, Nil, Succ(Succ(names)), cb, b_is), w_body);
                                let runs = t.runs_of(body, call, perform, inner, head, cb.prog, body.emits_runs(t, call, perform, calls, fns, head, inner, Nil, Succ(Succ(names)), cb, b_is, w_body, ok.right));
                                let inside = layout.word_inside(again, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                                λ n env k _ exits next => t.goes_repeat(body, again, call, perform, n, p, names, cb.prog, out, set, inside, within, w_head,
                                    body.live_in(t.homes, loop_after(again, set, out)).within_mem(set, ok.left), runs, k, exits, next, n, env)
                            })
                    },
                }),
            })
        },
        Exit(status) => λ p out known names c => (match fit: layout.word_fits(status) {
            False => λ none => absurd(none),
            True => λ same => j(Option::some_inj(Compiled(p.exits(layout, known, status), names), c, same),
                λ x _ => x.prog.Within(t.program) → Exit(status).checks(t.homes, out).IsTrue() → t.RunsK(Exit(status), known, call, perform, out, p, x.prog),
                λ within _ n env k knows exits next => t.goes_exits(known.unknown([status]), env, p, known, status,
                    layout.word_inside(status, j(sym(fit), λ v _ => v.IsTrue(), trivial)),
                    env.reads_of(known, knows, [status], known.unknown([status]), status, Inl(refl), λ i m => m),
                    within, k(Exited(env.word(status))), λ u at exited => exits(env.word(status), u, at, exited))),
        }),
        Arg(index, buf, len) => λ p out known names c => (match layout.words_fit([index, len]) as λ b => layout.words_fit([index, len]) = b → (match b {
                False => None,
                True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.args(layout, out, index, buf, len, capacity, names)) },
            }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(len, out).IsTrue() → t.RunsK(Arg(index, buf, len), known, call, perform, out, p, c.prog) {
            False => λ _ none => absurd(none),
            True => λ fit => {
                let ok = Bool::is_true_and(layout.word_fits(index), layout.word_fits(len) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                let ok2 = Bool::is_true_and(layout.word_fits(len), True, ok.right);
                (match found: t.caps.nth(buf) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.args(layout, out, index, buf, len, capacity, names), c, same),
                        λ x _ => x.prog.Within(t.program) → t.homes.apart(len, out).IsTrue() → t.RunsK(Arg(index, buf, len), known, call, perform, out, p, x.prog),
                        λ within apart n env k _ exits next => t.goes_args(live_before([index], len, out), out, env, p, index, buf, len, capacity, names,
                            layout.word_inside(index, ok.left), layout.word_inside(len, ok2.left), live_before_reads([index], len, out, index, Inl(refl)),
                            λ i m ne => live_before_keeps([index], len, out, i, m, ne), apart, found, within,
                            k(Onward(env.arg(env.number(index), buf, len))), next(env.arg(env.number(index), buf, len)))),
                })
            },
        })(refl),
        Perform(index, args, results) => λ p out known names c => (match layout.call_fits(out, index, args, results) as λ b => layout.call_fits(out, index, args, results) = b →
                b.guard(Some(Compiled(p.performs(layout, out, index, args, results), names))) = Some(c) → c.prog.Within(t.program) →
                t.homes.all_apart(results, out).IsTrue() → t.RunsK(Perform(index, args, results), known, call, perform, out, p, c.prog) {
            False => λ _ none => absurd(none),
            True => λ fit same => j(Option::some_inj(Compiled(p.performs(layout, out, index, args, results), names), c, same),
                λ x _ => x.prog.Within(t.program) → t.homes.all_apart(results, out).IsTrue() → t.RunsK(Perform(index, args, results), known, call, perform, out, p, x.prog),
                λ within apart n env k _ => calls(p, out, index, args, results, j(sym(fit), λ v _ => v.IsTrue(), trivial), within, apart)(n, env, k)),
        })(refl),
    }
}

// Nothing known as the statement starts.
theorem Stmt::emit_runs(self s: Stmt, t: Target, call: Writers(), perform: Performs(), calls: t.Calls(call, perform), fns: t.Functions(call)): (p: Prog) → (out: List<Nat>) → (names: Nat) → (c: Compiled) →
    s.emit(p, t.layout(), out, names) = Some(c) → c.prog.Within(t.program) → s.checks(t.homes, out).IsTrue() → t.Runs(s, call, perform, out, p, c.prog) {
    λ p out names c emitted within checked => t.runs_of(s, call, perform, out, p, c.prog, s.emits_runs(t, call, perform, calls, fns, p, out, Nil, names, c, emitted, within, checked))
}

// ---------------------------------------------------------------------------
// The program

// A program is laid out where the check that gave it said so.
theorem Prog::laid_of(self whole: Prog, program: Prog, same: (match whole.laid_out() { False => None, True => Some(whole) }) = Some(program)):
    program.laid_out().IsTrue() {
    (match whole.laid_out() as λ b => whole.laid_out() = b →
            (match b { False => None, True => Some(whole) }) = Some(program) → program.laid_out().IsTrue() {
        False => λ _ none => absurd(none),
        True => λ laid same => j(Option::some_inj(whole, program, same), λ x _ => x.laid_out().IsTrue(), j(sym(laid), λ b _ => b.IsTrue(), trivial)),
    })(refl, same)
}

theorem Source::calls_laid(self src: Source, low: BitVec(64), homes: Homes, program: Prog, compiled: src.compile_calls(low, homes) = Some(program)):
    program.laid_out().IsTrue() {
    let layout = src.layout(low, homes);
    let exit0 = λ (q: Prog) => then(then(q, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
    (match src.main.emit(src.entry(low, homes), layout, [], layout.deep_label()) as λ o => (match o {
            None => None,
            Some(c) => match src.procedures.procedures_code(exit0(c.prog), layout, 0, c.names) {
                None => None,
                Some(d) => match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                    None => None,
                    Some(whole) => match whole.laid_out() { False => None, True => Some(whole) },
                },
            },
        }) = Some(program) → program.laid_out().IsTrue() {
        None => λ none => absurd(none),
        Some(c) => (match src.procedures.procedures_code(exit0(c.prog), layout, 0, c.names) {
            None => λ none => absurd(none),
            Some(d) => (match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                None => λ none => absurd(none),
                Some(whole) => λ same => whole.laid_of(program, same),
            }),
        }),
    })(compiled)
}

// What `compile` builds is laid out: read off the check it made, so a
// client need not evaluate it again.
theorem Source::compile_laid(self src: Source, low: BitVec(64), homes: Homes, program: Prog, compiled: src.compile(low, homes) = Some(program)):
    program.laid_out().IsTrue() {
    let emitted = src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0);
    let bare: Option<Prog> = match emitted { None => None, Some(c) => c.prog.finish() };
    (match src.allocation_ok(homes) as λ a => (match a {
            False => None,
            True => match src.procedures {
                Nil => match src.functions { Nil => bare, Cons(_, _) => src.compile_calls(low, homes) },
                Cons(_, _) => src.compile_calls(low, homes),
            },
        }) = Some(program) → program.laid_out().IsTrue() {
        False => λ none => absurd(none),
        True => (match src.procedures {
            Nil => (match src.functions {
                Nil => (match emitted {
                    None => λ none => absurd(none),
                    Some(c) => λ same => then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall).laid_of(program, same),
                }),
                Cons(_, _) => λ calls => src.calls_laid(low, homes, program, calls),
            }),
            Cons(_, _) => λ calls => src.calls_laid(low, homes, program, calls),
        }),
    })(compiled)
}

// A source without procedures or functions compiles as before them: `main`
// from label 0, then exit 0.
theorem Source::compile_bare(self src: Source, low: BitVec(64), homes: Homes, bare: src.procedures = Nil, none: src.functions = Nil):
    src.compile(low, homes) = (match src.allocation_ok(homes) {
        False => None,
        True => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
    }) {
    let plain: Option<Prog> = match src.allocation_ok(homes) {
        False => None,
        True => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
    };
    j(sym(bare), λ ps _ => (match src.allocation_ok(homes) as λ _ => Option<Prog> {
        False => None,
        True => match ps {
            Nil => match src.functions {
                Nil => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
                Cons(_, _) => src.compile_calls(low, homes),
            },
            Cons(_, _) => src.compile_calls(low, homes),
        },
    }) = plain, j(sym(none), λ fs _ => (match src.allocation_ok(homes) as λ _ => Option<Prog> {
        False => None,
        True => match fs {
            Nil => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
            Cons(_, _) => src.compile_calls(low, homes),
        },
    }) = plain, refl))
}

// The converse, for a reader that has the program: homes that pass the
// check, and an emission that finishes as `program`, laid out, are the
// compile. `heather write-elf` proves the compile this way, the check and
// the emission by evaluation and the layout a stretch at a time, since all
// at once overrun one declaration's fuel.
theorem Source::compile_of(self src: Source, low: BitVec(64), homes: Homes, program: Prog, allocated: src.allocation_ok(homes).IsTrue(), bare: src.procedures = Nil,
    none: src.functions = Nil,
    emitted: src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0).map(λ (c: Compiled) => then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall)) = Some(program),
    laid: program.laid_out().IsTrue()):
    src.compile(low, homes) = Some(program) {
    let finished = j(sym(eq_true_of_is_true(program.laid_out(), laid)),
        λ b _ => (match b as λ _ => Option<Prog> { False => None, True => Some(program) }) = Some(program), refl);
    let ran = (match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) as λ o =>
            o.map(λ (c: Compiled) => then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall)) = Some(program) →
            (match o { None => None, Some(c) => c.prog.finish() }) = Some(program) {
        None => λ none => absurd(none),
        Some(c) => λ same => {
            let whole = then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
            j(sym(Option::some_inj(whole, program, same)),
                λ x _ => (match x.laid_out() as λ _ => Option<Prog> { False => None, True => Some(x) }) = Some(program), finished)
        },
    })(emitted);
    trans(src.compile_bare(low, homes, bare, none), j(sym(eq_true_of_is_true(src.allocation_ok(homes), allocated)), λ a _ => (match a as λ _ => Option<Prog> {
            False => None,
            True => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
        }) = Some(program), ran))
}

// What `compile_calls` runs: `main` emitted from past the procedures', the
// functions' and the shared exit's labels, the procedures after its exit
// 0, the shared exit, and the functions linked after it, laid out.
theorem Source::compile_calls_ran(self src: Source, low: BitVec(64), homes: Homes, program, main, procs: Prog, names, after: Nat,
    emitted: src.main.emit(src.entry(low, homes), src.layout(low, homes), [], src.layout(low, homes).deep_label()) = Some(Compiled(main, names)),
    code: src.procedures.procedures_code(then(then(main, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall), src.layout(low, homes), 0, names) = Some(Compiled(procs, after)),
    whole: procs.deep_exit(src.layout(low, homes)).links(src.functions, homes.places, after) = Some(program), laid: program.laid_out().IsTrue()):
    src.compile_calls(low, homes) = Some(program) {
    let layout = src.layout(low, homes);
    let laid_here = j(sym(eq_true_of_is_true(program.laid_out(), laid)),
        λ b _ => (match b as λ _ => Option<Prog> { False => None, True => Some(program) }) = Some(program), refl);
    let finished = j(sym(whole), λ o _ => (match o as λ _ => Option<Prog> {
            None => None,
            Some(x) => match x.laid_out() { False => None, True => Some(x) },
        }) = Some(program), laid_here);
    let after_main = j(sym(code), λ o _ => (match o {
            None => None,
            Some(d) => match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                None => None,
                Some(x) => match x.laid_out() { False => None, True => Some(x) },
            },
        }) = Some(program), finished);
    j(sym(emitted), λ o _ => (match o {
            None => None,
            Some(c) => match src.procedures.procedures_code(then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall), layout, 0, c.names) {
                None => None,
                Some(d) => match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                    None => None,
                    Some(x) => match x.laid_out() { False => None, True => Some(x) },
                },
            },
        }) = Some(program), after_main)
}

// The same with procedures (`Source::compile_calls`): the converse
// `write-elf` cites for a source that has them.
theorem Source::compile_calls_of(self src: Source, low: BitVec(64), homes: Homes, first: Procedure, rest: List<Procedure>, program, main, procs: Prog, names, after: Nat,
    allocated: src.allocation_ok(homes).IsTrue(), calls: src.procedures = Cons(first, rest),
    emitted: src.main.emit(src.entry(low, homes), src.layout(low, homes), [], src.layout(low, homes).deep_label()) = Some(Compiled(main, names)),
    code: src.procedures.procedures_code(then(then(main, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall), src.layout(low, homes), 0, names) = Some(Compiled(procs, after)),
    whole: procs.deep_exit(src.layout(low, homes)).links(src.functions, homes.places, after) = Some(program), laid: program.laid_out().IsTrue()):
    src.compile(low, homes) = Some(program) {
    let layout = src.layout(low, homes);
    let ran = src.compile_calls_ran(low, homes, program, main, procs, names, after, emitted, code, whole, laid);
    let plain: Option<Prog> = match src.functions {
        Nil => match src.main.emit(src.entry(low, homes), layout, [], 0) { None => None, Some(c) => c.prog.finish() },
        Cons(_, _) => src.compile_calls(low, homes),
    };
    j(sym(eq_true_of_is_true(src.allocation_ok(homes), allocated)), λ a _ => (match a as λ _ => Option<Prog> {
            False => None,
            True => match src.procedures { Nil => plain, Cons(_, _) => src.compile_calls(low, homes) },
        }) = Some(program),
        j(sym(calls), λ ps _ => (match ps as λ _ => Option<Prog> {
            Nil => plain,
            Cons(_, _) => src.compile_calls(low, homes),
        }) = Some(program), ran))
}

// And with functions and no procedure: the same code, the procedures none.
theorem Source::compile_functions_of(self src: Source, low: BitVec(64), homes: Homes, first: Function, rest: List<Function>, program, main, procs: Prog, names, after: Nat,
    allocated: src.allocation_ok(homes).IsTrue(), bare: src.procedures = Nil, calls: src.functions = Cons(first, rest),
    emitted: src.main.emit(src.entry(low, homes), src.layout(low, homes), [], src.layout(low, homes).deep_label()) = Some(Compiled(main, names)),
    code: src.procedures.procedures_code(then(then(main, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall), src.layout(low, homes), 0, names) = Some(Compiled(procs, after)),
    whole: procs.deep_exit(src.layout(low, homes)).links(src.functions, homes.places, after) = Some(program), laid: program.laid_out().IsTrue()):
    src.compile(low, homes) = Some(program) {
    let layout = src.layout(low, homes);
    let ran = src.compile_calls_ran(low, homes, program, main, procs, names, after, emitted, code, whole, laid);
    let plain: Option<Prog> = match src.main.emit(src.entry(low, homes), layout, [], 0) { None => None, Some(c) => c.prog.finish() };
    j(sym(eq_true_of_is_true(src.allocation_ok(homes), allocated)), λ a _ => (match a as λ _ => Option<Prog> {
            False => None,
            True => match src.procedures {
                Nil => match src.functions { Nil => plain, Cons(_, _) => src.compile_calls(low, homes) },
                Cons(_, _) => src.compile_calls(low, homes),
            },
        }) = Some(program),
        j(sym(bare), λ ps _ => (match ps as λ _ => Option<Prog> {
            Nil => match src.functions { Nil => plain, Cons(_, _) => src.compile_calls(low, homes) },
            Cons(_, _) => src.compile_calls(low, homes),
        }) = Some(program),
            j(sym(calls), λ fs _ => (match fs as λ _ => Option<Prog> {
                Nil => plain,
                Cons(_, _) => src.compile_calls(low, homes),
            }) = Some(program), ran)))
}

// A procedure's code from its parts', so `heather write-elf` states a long
// body a part at a time: it fits, its way in, its body's emission, and its
// way out.
theorem Procedure::code_of(self proc: Procedure, p, entry, body, out: Prog, layout: Layout, index, names, after: Nat,
    fits: proc.fits(layout) = True, entered: proc.entry_code(p, layout, index) = entry,
    emitted: proc.body.emit(entry, layout, proc.results, names) = Some(Compiled(body, after)), left: proc.exit_code(body, layout) = out):
    proc.code(p, layout, index, names) = Some(Compiled(out, after)) {
    j(sym(fits), λ f _ => (match f as λ _ => Option<Compiled> {
            False => None,
            True => match proc.body.emit(proc.entry_code(p, layout, index), layout, proc.results, names) { None => None, Some(b) => Some(Compiled(proc.exit_code(b.prog, layout), b.names)) },
        }) = Some(Compiled(out, after)),
        j(sym(entered), λ e _ => (match proc.body.emit(e, layout, proc.results, names) { None => None, Some(b) => Some(Compiled(proc.exit_code(b.prog, layout), b.names)) }) = Some(Compiled(out, after)),
            j(sym(emitted), λ o _ => (match o { None => None, Some(b) => Some(Compiled(proc.exit_code(b.prog, layout), b.names)) }) = Some(Compiled(out, after)),
                j(left, λ x _ => Some(Compiled(proc.exit_code(body, layout), after)) = Some(Compiled(x, after)), refl))))
}

// The procedures' code from the first's and the rest's.
theorem List::procedures_code_of(self procs: List<Procedure>, first: Procedure, rest: List<Procedure>, is: procs = Cons(first, rest), p: Prog, layout: Layout, index, names: Nat,
    c, d: Compiled, here: first.code(p, layout, index, names) = Some(c), later: rest.procedures_code(c.prog, layout, Succ(index), c.names) = Some(d)):
    procs.procedures_code(p, layout, index, names) = Some(d) {
    j(sym(is), λ ps _ => ps.procedures_code(p, layout, index, names) = Some(d),
        j(sym(here), λ o _ => (match o { None => None, Some(x) => rest.procedures_code(x.prog, layout, Succ(index), x.names) }) = Some(d), later))
}

// A statement's emission from its parts', so a reader can state a long
// program's a piece at a time (`heather write-elf`): one declaration per
// leaf, or per part small enough to evaluate whole, and these to join them.
// Each names its parts by position (`Stmt::left`, `right`, `word`), so no
// statement spells a part of the tree it does not evaluate; what is live
// after a part is the parent's `out` but for a `Then`'s first part
// (`right().live_with(homes, carried, out)`) and a loop's body
// (`loop_out(homes, out)`), and what is known as a part starts is nothing
// but for a `Then`'s parts (`left().first_known(known)`, and the facts
// `left().carried(…)` the first leaves the rest).
theorem Stmt::emits_then_of(self s: Stmt, is: s.is_then().IsTrue(), p: Prog, layout: Layout, out: List<Nat>, known: List<Fact>, names: Nat, c: Compiled,
    left: s.left().emits(p, layout, s.right().live_with(layout.homes, s.left().carried(s.right(), layout.homes, out), out), s.left().first_known(known), names) = Some(c)):
    s.emits(p, layout, out, known, names) = s.right().emits(c.prog, layout, out, s.left().carried(s.right(), layout.homes, out), c.names) {
    match s {
        Then(first, rest) => j(sym(left), λ o _ => (match o as λ _ => Option<Compiled> {
                None => None,
                Some(d) => rest.emits(d.prog, layout, out, first.carried(rest, layout.homes, out), d.names),
            }) = rest.emits(c.prog, layout, out, first.carried(rest, layout.homes, out), c.names), refl),
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Branch(_, _, _) => false_elim(is),
        Repeat(_, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

theorem Stmt::emits_repeat_of(self s: Stmt, is: s.is_repeat().IsTrue(), p: Prog, layout: Layout, fits: layout.word_fits(s.word()).IsTrue(), out: List<Nat>, known: List<Fact>, names: Nat,
    b: Compiled, body: s.left().emits(p.label(Succ(names)), layout, s.loop_out(layout.homes, out), Nil, Succ(Succ(names))) = Some(b)):
    s.emits(p, layout, out, known, names) = Some(Compiled(then(b.prog.tests(layout, s.word(), Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)) {
    match s {
        Repeat(inner, again) => {
            let closed = Some(Compiled(then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names));
            let ran = j(sym(body), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(d) => Some(Compiled(then(d.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), d.names)),
                }) = closed, refl);
            j(sym(eq_true_of_is_true(layout.word_fits(again), fits)), λ w _ => (match w as λ _ => Option<Compiled> {
                    False => None,
                    True => match inner.emits(p.label(Succ(names)), layout, Repeat(inner, again).loop_out(layout.homes, out), Nil, Succ(Succ(names))) {
                        None => None,
                        Some(d) => Some(Compiled(then(d.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), d.names)),
                    },
                }) = closed, ran)
        },
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Then(_, _) => false_elim(is),
        Branch(_, _, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

theorem Stmt::emits_branch_of(self s: Stmt, is: s.is_branch().IsTrue(), p: Prog, layout: Layout, fits: layout.word_fits(s.word()).IsTrue(), out: List<Nat>, known: List<Fact>, names: Nat,
    y, n: Compiled, yes: s.left().emits(p.tests(layout, s.word(), Succ(names)), layout, out, Nil, Succ(Succ(names))) = Some(y),
    no: s.right().emits(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, Nil, y.names) = Some(n)):
    s.emits(p, layout, out, known, names) = Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)) {
    match s {
        Branch(condition, first, second) => {
            let joined = Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names));
            let second_ran = j(sym(no), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                }) = joined, refl);
            let first_ran = j(sym(yes), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(d) => match second.emits(d.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, Nil, d.names) {
                        None => None,
                        Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                    },
                }) = joined, second_ran);
            j(sym(eq_true_of_is_true(layout.word_fits(condition), fits)), λ w _ => (match w as λ _ => Option<Compiled> {
                    False => None,
                    True => match first.emits(p.tests(layout, condition, Succ(names)), layout, out, Nil, Succ(Succ(names))) {
                        None => None,
                        Some(d) => match second.emits(d.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, Nil, d.names) {
                            None => None,
                            Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                        },
                    },
                }) = joined, first_ran)
        },
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Then(_, _) => false_elim(is),
        Repeat(_, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

// The allocation's check from its parts', for the same reader: what
// `Stmt::checked` finds of a statement from what it finds of its parts, so
// the check a compile makes (`Source::allocation_ok`) is stated a part at
// a time too.
theorem Stmt::checked_then_of(self s: Stmt, is: s.is_then().IsTrue(), homes: Homes, out, mid, l: List<Nat>,
    rest: s.right().checked(homes, out) = Some(mid), first: s.left().checked(homes, mid) = Some(l)): s.checked(homes, out) = Some(l) {
    match s {
        Then(f, r) => j(sym(rest), λ o _ => (match o as λ _ => Option<List<Nat>> { None => None, Some(m) => f.checked(homes, m) }) = Some(l), first),
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Branch(_, _, _) => false_elim(is),
        Repeat(_, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

theorem Stmt::checked_branch_of(self s: Stmt, is: s.is_branch().IsTrue(), homes: Homes, out, y, n: List<Nat>,
    yes: s.left().checked(homes, out) = Some(y), no: s.right().checked(homes, out) = Some(n)): s.checked(homes, out) = Some(Cons(s.word(), y.union(n))) {
    match s {
        Branch(c, ys, ns) => j(sym(yes), λ o _ => (match o as λ _ => Option<List<Nat>> {
                None => None,
                Some(a) => match ns.checked(homes, out) { None => None, Some(b) => Some(Cons(c, a.union(b))) },
            }) = Some(Cons(c, y.union(n))),
            j(sym(no), λ o _ => (match o as λ _ => Option<List<Nat>> { None => None, Some(b) => Some(Cons(c, y.union(b))) }) = Some(Cons(c, y.union(n))), refl)),
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Then(_, _) => false_elim(is),
        Repeat(_, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

theorem Stmt::checked_repeat_of(self s: Stmt, is: s.is_repeat().IsTrue(), homes: Homes, out, b: List<Nat>,
    body: s.left().checked(homes, loop_after(s.word(), homes.loop_set(s.word()), out)) = Some(b), within: b.within(homes.loop_set(s.word())) = True):
    s.checked(homes, out) = Some(homes.loop_set(s.word())) {
    match s {
        Repeat(bd, again) => j(sym(body), λ o _ => (match o as λ _ => Option<List<Nat>> {
                None => None,
                Some(x) => match x.within(homes.loop_set(again)) { False => None, True => Some(homes.loop_set(again)) },
            }) = Some(homes.loop_set(again)),
            j(sym(within), λ w _ => (match w as λ _ => Option<List<Nat>> { False => None, True => Some(homes.loop_set(again)) }) = Some(homes.loop_set(again)), refl)),
        Compute(_) => false_elim(is),
        Invoke(_) => false_elim(is),
        Then(_, _) => false_elim(is),
        Branch(_, _, _) => false_elim(is),
        Exit(_) => false_elim(is),
        Arg(_, _, _) => false_elim(is),
        Perform(_, _, _) => false_elim(is),
    }
}

theorem Source::allocation_of(self src: Source, homes: Homes, l: List<Nat>, fits: homes.fits() = True, checked: src.main.checked(homes, []) = Some(l),
    slotted: homes.slotted(l) = True): src.allocation_ok(homes) = True {
    j(sym(fits), λ f _ => Bool::and(f, match src.main.checked(homes, []) { None => False, Some(live) => homes.slotted(live) }) = True,
        j(sym(checked), λ o _ => Bool::and(True, match o { None => False, Some(live) => homes.slotted(live) }) = True, slotted))
}

// The sets `Stmt::checked` finds, read for `write-elf` (untrusted): in
// preorder, each statement's `out` and the set before it, each after its
// length. `None` where the check fails.
record LiveTrace { live: List<Nat>, reads: List<Nat> }

fn List::spelled_set(self set: List<Nat>) → List<Nat> { Cons(set.len(), set) }

fn Stmt::checked_leaf(self s: Stmt, homes: Homes, out: List<Nat>) → Option<LiveTrace> {
    match s.checked(homes, out) { None => None, Some(l) => Some(LiveTrace(l, List::append(out.spelled_set(), l.spelled_set()))) }
}

fn Stmt::checked_trace(self s: Stmt, homes: Homes, out: List<Nat>) → Option<LiveTrace> {
    match s {
        Then(first, rest) => match rest.checked_trace(homes, out) {
            None => None,
            Some(r) => match first.checked_trace(homes, r.live) {
                None => None,
                Some(f) => Some(LiveTrace(f.live, List::append(out.spelled_set(), List::append(f.live.spelled_set(), List::append(f.reads, r.reads))))),
            },
        },
        Branch(condition, yes, no) => match yes.checked_trace(homes, out) {
            None => None,
            Some(y) => match no.checked_trace(homes, out) {
                None => None,
                Some(n) => {
                    let live = Cons(condition, y.live.union(n.live));
                    Some(LiveTrace(live, List::append(out.spelled_set(), List::append(live.spelled_set(), List::append(y.reads, n.reads)))))
                },
            },
        },
        Repeat(body, again) => match body.checked_trace(homes, loop_after(again, homes.loop_set(again), out)) {
            None => None,
            Some(b) => match b.live.within(homes.loop_set(again)) {
                False => None,
                True => Some(LiveTrace(homes.loop_set(again), List::append(out.spelled_set(), List::append(homes.loop_set(again).spelled_set(), b.reads)))),
            },
        },
        Compute(region) => Stmt::checked_leaf(Compute(region), homes, out),
        Invoke(shape) => Stmt::checked_leaf(Invoke(shape), homes, out),
        Exit(status) => Stmt::checked_leaf(Exit(status), homes, out),
        Arg(index, buf, len) => Stmt::checked_leaf(Arg(index, buf, len), homes, out),
        Perform(procedure, args, results) => Stmt::checked_leaf(Perform(procedure, args, results), homes, out),
    }
}

fn Source::checked_spelled(self src: Source, homes: Homes) → List<Nat> {
    match src.main.checked_trace(homes, []) { None => [], Some(t) => t.reads }
}

// The entry's initial bytes a stretch at a time, for the same reader: a
// buffer's bytes stored as two lists one after the other, and the buffers
// one after another (`Source::entry`, `Prog::inits`).
theorem Prog::bytes_init_room_zero(self p: Prog, layout: Layout, bytes: List<BitVec(8)>, buf, i: Nat): p.bytes_init(layout, bytes, 0, buf, i) = p {
    match bytes { Nil => refl, Cons(_, _) => refl }
}

theorem Prog::bytes_init_append(layout: Layout, buf: Nat, xs, ys: List<BitVec(8)>): (room, i: Nat) → (p: Prog) →
    p.bytes_init(layout, List::append(xs, ys), room, buf, i) = p.bytes_init(layout, xs, room, buf, i).bytes_init(layout, ys, room - xs.len(), buf, i + xs.len()) {
    match xs {
        Nil => λ room i p => j(sym(Nat::sub_zero(room)), λ r _ => p.bytes_init(layout, ys, room, buf, i) = p.bytes_init(layout, ys, r, buf, i), refl),
        Cons(c, rest) => λ room => match room {
            Zero => λ i p => sym(p.bytes_init_room_zero(layout, ys, buf, i + Succ(rest.len()))),
            Succ(r) => λ i p => {
                let q = p.byte_init(layout, buf, i, c);
                j(i.add_succ_left(rest.len()),
                    λ n _ => q.bytes_init(layout, List::append(rest, ys), r, buf, Succ(i)) = q.bytes_init(layout, rest, r, buf, Succ(i)).bytes_init(layout, ys, r - rest.len(), buf, n),
                    Prog::bytes_init_append(layout, buf, rest, ys, r, Succ(i), q))
            },
        },
    }
}

theorem Prog::bytes_init_append_of(layout: Layout, buf: Nat, xs, ys: List<BitVec(8)>, room, i: Nat, p, q, r: Prog,
    first: p.bytes_init(layout, xs, room, buf, i) = q, rest: q.bytes_init(layout, ys, room - xs.len(), buf, i + xs.len()) = r):
    p.bytes_init(layout, List::append(xs, ys), room, buf, i) = r {
    trans(Prog::bytes_init_append(layout, buf, xs, ys, room, i, p), j(sym(first), λ x _ => x.bytes_init(layout, ys, room - xs.len(), buf, i + xs.len()) = r, rest))
}

theorem Prog::inits_of(layout: Layout, b: Buffer, rest: List<Buffer>, buf: Nat, p, q, r: Prog,
    first: p.bytes_init(layout, b.initial, b.capacity, buf, 0) = q, others: q.inits(layout, rest, Succ(buf)) = r): p.inits(layout, Cons(b, rest), buf) = r {
    j(sym(first), λ x _ => x.inits(layout, rest, Succ(buf)) = r, others)
}

theorem Source::entry_of(self src: Source, low: BitVec(64), homes: Homes, p, q: Prog, saved: Start.saves_rsp(src.layout(low, homes), src.depth) = p,
    filled: p.inits(src.layout(low, homes), src.buffers, 0) = q): src.entry(low, homes) = q {
    j(sym(saved), λ x _ => x.inits(src.layout(low, homes), src.buffers, 0) = q, filled)
}

// A source without procedures: `main` from label 0, no call fitting.
theorem native_compile_correct_bare(src: Source, r: DataRegion, homes: Homes, fits: Layout::of(r.low, src.words, src.capacities(), homes).size() <= r.size, program: Prog,
    compiled: src.compile(r.low, homes) = Some(program), bare: src.procedures = Nil, none: src.functions = Nil, origin: BitVec(64),
    s: MachineState<X86Memory(r.profile)>,
    here: s.rip = next_rip(origin, 0), resident: r.profile.linux().site(program, origin).Resident(s.memory),
    zero: r.Holds(λ _ => zero_byte(), s.memory),
    stack: Stack<X86Memory(r.profile)>(r.profile.linux().fetch, r.profile.linux().data), stack_writes: stack.writes = linux_writes(r.profile.linux()),
    stack_above: r.low.toNat() + r.size <= stack.low.toNat(), stack_canonical: stack.low.toNat() + stack.size <= Nat::pow(2, 47),
    top: stack.at(stack.size) = read_gpr(Rsp, s.gprs), deep: src.depth * (8 * (src.words + 1)) + 80 * src.functions.len() <= stack.size,
    args: List<List<BitVec(8)>>, argv: ArgvAt(r.profile.data().above(stack.low.toNat() + stack.size), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimPaidProgram(r.profile.linux(), src.denote(args), s) {
    let call = program_writers(src.functions);
    let layout = src.layout(r.low, homes);
    let entry = src.entry(r.low, homes);
    (match src.allocation_ok(homes) as λ a => src.allocation_ok(homes) = a → (match a {
            False => None,
            True => match src.main.emit(entry, layout, [], 0) { None => None, Some(c) => c.prog.finish() },
        }) = Some(program) → SimPaidProgram(r.profile.linux(), src.denote(args), s) {
        False => λ _ none => absurd(none),
        True => λ allocated => {
            let ok = src.allocation_sound(homes, j(sym(allocated), λ v _ => v.IsTrue(), trivial));
            let ok2 = ok.right;
            (match emitted: src.main.emit(entry, layout, [], 0) {
                None => λ none => absurd(none),
                Some(c) => {
                    let whole = then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
                    (match laid: whole.laid_out() {
                        False => λ none => absurd(none),
                        True => λ same => (j(Option::some_inj(whole, program, same),
                            λ x _ => r.profile.linux().site(x, origin).Resident(s.memory) → SimPaidProgram(r.profile.linux(), src.denote(args), s),
                            λ at_whole => {
                                let framed: (stack.size + 8 * 0 <= stack.size) = omega();
                                let t = Target(r, src.words, src.capacities(), homes, ok.left, fits, whole, origin, j(sym(laid), λ b _ => b.IsTrue(), trivial), args,
                                    src.procedures, src.functions, stack, stack_writes, stack_above, stack_canonical, stack.size, [], src.depth, framed, deep);
                                let once: (src.depth * 1 <= src.depth * (8 * (src.words + 1))) = Nat::mul_le_mono_l(src.depth, 1, 8 * (src.words + 1), omega());
                                let small: (src.depth < Nat::pow(2, 64)) = omega(once, deep, stack_canonical, canonical_below_top());
                                let live = src.main.live_in(homes, []);
                                let saved = Start.saves_rsp(layout, src.depth);
                                let runs = λ (n: Nat) => src.main.emit_runs(t, call, src.performs(call, n, src.depth), t.calls_bare(bare, call, src.performs(call, n, src.depth)),
                                    t.functions_run(call, t.answers_none(none, call)), entry, [], 0, c, emitted, Exists(2, refl), ok2.right);
                                let w_entry = entry.within_trans(c.prog, whole, src.main.emits_extends(layout, entry, [], Nil, 0, c, emitted), Exists(2, refl));
                                let w_saved = saved.within_trans(entry, whole, Prog::within_inits(layout, src.buffers, 0, saved), w_entry);
                                let caps = λ (k: Nat) => {
                                    let shifted: (0 + k = k) = omega();
                                    cong_fn<Nat, Option<Nat>>(λ x => t.caps.nth(x), shifted)
                                };
                                let exits: t.Exiting(λ (flow: Flow) => Ret(flow.status())) = λ status u at exited =>
                                    paid_ret(t.io(), status, u, u, Exists(Zero, refl), at, exited);
                                let after = λ (end: Env) => t.goes_finish(c.prog, whole.within_self(), Ret(BitVec::zero()),
                                    λ (u: MachineState<X86Memory(t.r.profile)>) => t.Held([], end, u.gprs, u.memory),
                                    λ u at exited => paid_ret(t.io(), BitVec::zero(), u, u, Exists(Zero, refl), at, exited));
                                let tree = λ (n: Nat) => { let d: ITree<BitVec(64)>(Events::linux()) = ITree::bind(Events::linux(), src.main.denote(call, src.performs(call, n, src.depth), n, src.start(args)), λ (flow: Flow) => Ret(flow.status())); d };
                                λ n => t.goes_start(live, ok2.left, refl, src.depth, refl, small, Start, w_saved, tree(n),
                                    t.goes_inits(live, tree(n), src.buffers, 0, saved, t.start_env(), caps, w_entry,
                                        runs(n)(n, src.start(args), λ (flow: Flow) => Ret(flow.status()), exits, after)),
                                    s, here, at_whole, ⟨zero, ⟨argv, sym(top)⟩⟩)
                            }))(resident),
                    })
                },
            })
        },
    })(refl, trans(sym(src.compile_bare(r.low, homes, bare, none)), compiled))
}

// ---------------------------------------------------------------------------
// The procedures in the program

// Procedure `index` is in `whole` as its compile put it: it fits, its body
// emits after its way in from some prefix, and its way out is in `whole`.
fn Procedure::Hosted(self proc: Procedure, layout: Layout, index: Nat, whole: Prog) → Type {
    Exists<Prog>(λ pre => Exists<Nat>(λ names => Exists<Compiled>(λ b =>
        (proc.fits(layout) = True) ∧ ((proc.body.emit(proc.entry_code(pre, layout, index), layout, proc.results, names) = Some(b)) ∧
        proc.exit_code(b.prog, layout).Within(whole)))))
}

// The program holds every procedure of the target, and the shared exit of
// a call too deep.
fn Target::Hosts(self t: Target) → Type {
    ((i: Nat) → (proc: Procedure) → t.procedures.nth(i) = Some(proc) → proc.Hosted(t.layout(), i, t.program)) ∧
        Exists<Prog>(λ dp => dp.deep_exit(t.layout()).Within(t.program))
}

theorem Procedure::code_hosted(self proc: Procedure, p: Prog, layout: Layout, index, names: Nat, c: Compiled, code: proc.code(p, layout, index, names) = Some(c)):
    (whole: Prog) → c.prog.Within(whole) → proc.Hosted(layout, index, whole) ∧ p.Within(c.prog) {
    (match proc.fits(layout) as λ f => proc.fits(layout) = f → (match f {
            False => None,
            True => match proc.body.emit(proc.entry_code(p, layout, index), layout, proc.results, names) {
                None => None,
                Some(b) => Some(Compiled(proc.exit_code(b.prog, layout), b.names)),
            },
        }) = Some(c) → (whole: Prog) → c.prog.Within(whole) → proc.Hosted(layout, index, whole) ∧ p.Within(c.prog) {
        False => λ _ none => absurd(none),
        True => λ fits same0 => (match proc.body.emit(proc.entry_code(p, layout, index), layout, proc.results, names) as λ o =>
                proc.body.emit(proc.entry_code(p, layout, index), layout, proc.results, names) = o →
                (match o { None => None, Some(b) => Some(Compiled(proc.exit_code(b.prog, layout), b.names)) }) = Some(c) →
                (whole: Prog) → c.prog.Within(whole) → proc.Hosted(layout, index, whole) ∧ p.Within(c.prog) {
            None => λ _ none => absurd(none),
            Some(b) => λ emitted same => j(Option::some_inj(Compiled(proc.exit_code(b.prog, layout), b.names), c, same),
                λ x _ => (whole: Prog) → x.prog.Within(whole) → proc.Hosted(layout, index, whole) ∧ p.Within(x.prog),
                λ whole w => {
                    let labelled = p.label(layout.procedure_label(index));
                    let entry = proc.entry_code(p, layout, index);
                    let w_labelled: p.Within(labelled) = Exists(1, refl);
                    let w_entry: p.Within(entry) = p.within_trans(labelled, entry, w_labelled,
                        Prog::within_words_from(layout, proc.body.live_in(layout.homes, proc.results), proc.params, call_registers(), labelled));
                    let w_body: p.Within(b.prog) = p.within_trans(entry, b.prog, w_entry, proc.body.emit_extends(layout, entry, proc.results, names, b, emitted));
                    let moved = b.prog.words_to(layout, proc.results, call_registers());
                    let w_moved: b.prog.Within(moved) = Prog::within_words_to(layout, proc.results, call_registers(), b.prog);
                    let w_exit: moved.Within(proc.exit_code(b.prog, layout)) = Exists(1, refl);
                    ⟨Exists(p, Exists(names, Exists(b, ⟨fits, ⟨emitted, w⟩⟩))),
                        p.within_trans(b.prog, proc.exit_code(b.prog, layout), w_body, b.prog.within_trans(moved, proc.exit_code(b.prog, layout), w_moved, w_exit))⟩
                }),
        })(refl, same0),
    })(refl, code)
}

// Each procedure from `index` on is in a program its code is in, procedure
// `i` of them at label `index + i`.
theorem List::procedures_hosted(self procs: List<Procedure>, layout: Layout): (p: Prog) → (index, names: Nat) → (d: Compiled) →
    procs.procedures_code(p, layout, index, names) = Some(d) → (whole: Prog) → d.prog.Within(whole) →
    p.Within(d.prog) ∧ ((i: Nat) → (proc: Procedure) → procs.nth(i) = Some(proc) → proc.Hosted(layout, index + i, whole)) {
    match procs {
        Nil => λ p index names d code whole w => j(Option::some_inj(Compiled(p, names), d, code), λ x _ => p.Within(x.prog) ∧
                ((i: Nat) → (proc: Procedure) → List::nth<Procedure>(Nil, i) = Some(proc) → proc.Hosted(layout, index + i, whole)),
            ⟨p.within_self(), λ i proc none => absurd(none)⟩),
        Cons(first, rest) => λ p index names d => (match first.code(p, layout, index, names) as λ o => first.code(p, layout, index, names) = o →
                (match o { None => None, Some(c) => rest.procedures_code(c.prog, layout, Succ(index), c.names) }) = Some(d) →
                (whole: Prog) → d.prog.Within(whole) →
                p.Within(d.prog) ∧ ((i: Nat) → (proc: Procedure) → Cons(first, rest).nth(i) = Some(proc) → proc.Hosted(layout, index + i, whole)) {
            None => λ _ none => absurd(none),
            Some(c) => λ code others whole w => {
                let later = rest.procedures_hosted(layout)(c.prog, Succ(index), c.names, d, others, whole, w);
                let here = first.code_hosted(p, layout, index, names, c, code, whole, c.prog.within_trans(d.prog, whole, later.left, w));
                ⟨p.within_trans(c.prog, d.prog, here.right, later.left), λ i => match i {
                    Zero => λ proc same => j(Option::some_inj(first, proc, same), λ x _ => x.Hosted(layout, index, whole), here.left),
                    Succ(k) => λ proc found => j(Nat::add_succ_left(index, k), λ x _ => proc.Hosted(layout, x, whole), later.right(k, proc, found)),
                }⟩
            },
        })(refl),
    }
}

// What `compile_calls` built: `main` emitted, exit 0 after it in the
// program, the program hosting every procedure and the shared exit, laid
// out, and the functions linked after some code of its own.
fn Source::CallsBuilt(self src: Source, low: BitVec(64), homes: Homes, program: Prog) → Type {
    let layout = src.layout(low, homes);
    Exists<Compiled>(λ c => (src.main.emit(src.entry(low, homes), layout, [], layout.deep_label()) = Some(c)) ∧
        (then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall).Within(program) ∧
        (((i: Nat) → (proc: Procedure) → src.procedures.nth(i) = Some(proc) → proc.Hosted(layout, i, program)) ∧
        (Exists<Prog>(λ dp => dp.deep_exit(layout).Within(program)) ∧ (program.laid_out().IsTrue() ∧
        Exists<Prog>(λ base => Exists<Nat>(λ names => base.links(src.functions, homes.places, names) = Some(program))))))))
}

theorem Source::calls_built(self src: Source, low: BitVec(64), homes: Homes, program: Prog, compiled: src.compile_calls(low, homes) = Some(program)):
    src.CallsBuilt(low, homes, program) {
    let layout = src.layout(low, homes);
    let exit0 = λ (q: Prog) => then(then(q, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
    let laid = src.calls_laid(low, homes, program, compiled);
    (match src.main.emit(src.entry(low, homes), layout, [], layout.deep_label()) as λ o => src.main.emit(src.entry(low, homes), layout, [], layout.deep_label()) = o →
            (match o {
                None => None,
                Some(c) => match src.procedures.procedures_code(exit0(c.prog), layout, 0, c.names) {
                    None => None,
                    Some(d) => match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                        None => None,
                        Some(whole) => match whole.laid_out() { False => None, True => Some(whole) },
                    },
                },
            }) = Some(program) → src.CallsBuilt(low, homes, program) {
        None => λ _ none => absurd(none),
        Some(c) => λ emitted => (match src.procedures.procedures_code(exit0(c.prog), layout, 0, c.names) as λ o =>
                src.procedures.procedures_code(exit0(c.prog), layout, 0, c.names) = o → (match o {
                    None => None,
                    Some(d) => match d.prog.deep_exit(layout).links(src.functions, homes.places, d.names) {
                        None => None,
                        Some(whole) => match whole.laid_out() { False => None, True => Some(whole) },
                    },
                }) = Some(program) → src.CallsBuilt(low, homes, program) {
            None => λ _ none => absurd(none),
            Some(d) => λ code => {
                let base = d.prog.deep_exit(layout);
                (match base.links(src.functions, homes.places, d.names) as λ o => base.links(src.functions, homes.places, d.names) = o →
                        (match o as λ _ => Option<Prog> { None => None, Some(whole) => match whole.laid_out() { False => None, True => Some(whole) } }) = Some(program) →
                        src.CallsBuilt(low, homes, program) {
                    None => λ _ none => absurd(none),
                    Some(whole) => λ linked => (match whole.laid_out() as λ b => (match b as λ _ => Option<Prog> { False => None, True => Some(whole) }) = Some(program) →
                            src.CallsBuilt(low, homes, program) {
                        False => λ none => absurd(none),
                        True => λ same => {
                            let linked_p: (base.links(src.functions, homes.places, d.names) = Some(program)) =
                                j(Option::some_inj(whole, program, same), λ x _ => base.links(src.functions, homes.places, d.names) = Some(x), linked);
                            let w_base: base.Within(program) = base.links_grows(homes.places, d.names, program, src.functions, linked_p);
                            let w_d: d.prog.Within(program) = d.prog.within_trans(base, program, Exists(3, refl), w_base);
                            let hosted = src.procedures.procedures_hosted(layout)(exit0(c.prog), 0, c.names, d, code, program, w_d);
                            let r: src.CallsBuilt(low, homes, program) = Exists(c, ⟨emitted, ⟨exit0(c.prog).within_trans(d.prog, program, hosted.left, w_d),
                                ⟨λ i proc found => j(Nat::add_left_zero(i), λ x _ => proc.Hosted(layout, x, program), hosted.right(i, proc, found)),
                                ⟨Exists(d.prog, w_base), ⟨laid, Exists(base, Exists(d.names, linked_p))⟩⟩⟩⟩⟩);
                            r
                        },
                    }),
                })(refl)
            },
        })(refl),
    })(refl, compiled)
}

// ---------------------------------------------------------------------------
// The call's checks, read off

theorem Nat::same_as_eq(self n: Nat, m: Nat, same: n.same_as(m).IsTrue()): n = m {
    let both = Bool::is_true_and(n.leb(m), m.leb(n), same);
    let a: (n <= m) = Nat::leb_sound(n, m, both.left);
    let b: (m <= n) = Nat::leb_sound(m, n, both.right);
    let e: (n = m) = omega(a, b);
    e
}

// What a fitting call gives the proof: its procedure, and each check.
fn Layout::CallFits(self layout: Layout, out: List<Nat>, args, results: List<Nat>, proc: Procedure) → Type {
    (args.len() = proc.params.len()) ∧ ((results.len() = proc.results.len()) ∧ ((args.len() <= 6) ∧ ((results.len() <= 6) ∧
        (layout.words_fit(args ++ (results ++ out.minus(results))).IsTrue() ∧ ((out.minus(results).len() <= layout.words) ∧
        layout.homes.moves_apart(out, results).IsTrue())))))
}

theorem Layout::call_fits_parts(self layout: Layout, out: List<Nat>, index: Nat, args, results: List<Nat>, fit: layout.call_fits(out, index, args, results).IsTrue()):
    Exists<Procedure>(λ proc => (layout.procedures.nth(index) = Some(proc)) ∧ layout.CallFits(out, args, results, proc)) {
    (match layout.procedures.nth(index) as λ o => layout.procedures.nth(index) = o → Bool::IsTrue(match o {
            None => False,
            Some(proc) => args.len().same_as(proc.params.len()) && (results.len().same_as(proc.results.len()) &&
                (args.len().leb(6) && (results.len().leb(6) && (layout.words_fit(args ++ (results ++ out.minus(results))) &&
                (out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results)))))),
        }) → Exists<Procedure>(λ proc => (layout.procedures.nth(index) = Some(proc)) ∧ layout.CallFits(out, args, results, proc)) {
        None => λ _ no => false_elim(no),
        Some(proc) => λ found f => {
            let b1 = Bool::is_true_and(args.len().same_as(proc.params.len()), results.len().same_as(proc.results.len()) &&
                (args.len().leb(6) && (results.len().leb(6) && (layout.words_fit(args ++ (results ++ out.minus(results))) &&
                (out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results))))), f);
            let b2 = Bool::is_true_and(results.len().same_as(proc.results.len()), args.len().leb(6) && (results.len().leb(6) &&
                (layout.words_fit(args ++ (results ++ out.minus(results))) &&
                (out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results)))), b1.right);
            let b3 = Bool::is_true_and(args.len().leb(6), results.len().leb(6) && (layout.words_fit(args ++ (results ++ out.minus(results))) &&
                (out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results))), b2.right);
            let b4 = Bool::is_true_and(results.len().leb(6), layout.words_fit(args ++ (results ++ out.minus(results))) &&
                (out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results)), b3.right);
            let b5 = Bool::is_true_and(layout.words_fit(args ++ (results ++ out.minus(results))),
                out.minus(results).len().leb(layout.words) && layout.homes.moves_apart(out, results), b4.right);
            let b6 = Bool::is_true_and(out.minus(results).len().leb(layout.words), layout.homes.moves_apart(out, results), b5.right);
            Exists(proc, ⟨found, ⟨args.len().same_as_eq(proc.params.len(), b1.left), ⟨results.len().same_as_eq(proc.results.len(), b2.left),
                ⟨Nat::leb_sound(args.len(), 6, b3.left), ⟨Nat::leb_sound(results.len(), 6, b4.left), ⟨b5.left,
                ⟨Nat::leb_sound(out.minus(results).len(), layout.words, b6.left), b6.right⟩⟩⟩⟩⟩⟩⟩)
        },
    })(refl, fit)
}

// What a procedure that fits gives the proof.
fn Procedure::FitsParts(self proc: Procedure, layout: Layout) → Type {
    proc.body.checks(layout.homes, proc.results).IsTrue() ∧ (proc.body.live_in(layout.homes, proc.results).within(proc.params).IsTrue() ∧
        (layout.homes.moves_apart(proc.body.live_in(layout.homes, proc.results), proc.params).IsTrue() ∧
        (layout.words_fit(proc.params ++ proc.results).IsTrue() ∧ ((proc.params.len() <= 6) ∧ (proc.results.len() <= 6)))))
}

theorem Procedure::fits_parts(self proc: Procedure, layout: Layout, fits: proc.fits(layout) = True): proc.FitsParts(layout) {
    let entry = proc.body.live_in(layout.homes, proc.results);
    (match proc.body.checked(layout.homes, proc.results) as λ o => proc.body.checked(layout.homes, proc.results) = o → (match o as λ _ => Bool {
            None => False,
            Some(_) => entry.within(proc.params) && (layout.homes.moves_apart(entry, proc.params) &&
                (layout.words_fit(proc.params ++ proc.results) && (proc.params.len().leb(6) && proc.results.len().leb(6)))),
        }) = True → proc.FitsParts(layout) {
        None => λ _ none => absurd(none),
        Some(l) => λ got same => {
            let sound = proc.body.checked_sound(layout.homes, proc.results, l, got);
            let f: Bool::IsTrue(entry.within(proc.params) && (layout.homes.moves_apart(entry, proc.params) &&
                (layout.words_fit(proc.params ++ proc.results) && (proc.params.len().leb(6) && proc.results.len().leb(6))))) =
                j(sym(same), λ v _ => v.IsTrue(), trivial);
            let b1 = Bool::is_true_and(entry.within(proc.params), layout.homes.moves_apart(entry, proc.params) &&
                (layout.words_fit(proc.params ++ proc.results) && (proc.params.len().leb(6) && proc.results.len().leb(6))), f);
            let b2 = Bool::is_true_and(layout.homes.moves_apart(entry, proc.params),
                layout.words_fit(proc.params ++ proc.results) && (proc.params.len().leb(6) && proc.results.len().leb(6)), b1.right);
            let b3 = Bool::is_true_and(layout.words_fit(proc.params ++ proc.results), proc.params.len().leb(6) && proc.results.len().leb(6), b2.right);
            let b4 = Bool::is_true_and(proc.params.len().leb(6), proc.results.len().leb(6), b3.right);
            ⟨sound.right, ⟨b1.left, ⟨b2.left, ⟨b3.left, ⟨Nat::leb_sound(proc.params.len(), 6, b4.left), Nat::leb_sound(proc.results.len(), 6, b4.right)⟩⟩⟩⟩⟩
        },
    })(refl, fits)
}

// A call's tree, its procedure found.
theorem Source::performs_found(self src: Source, call: Writers(), n, d, index: Nat, proc: Procedure, found: src.procedures.nth(index) = Some(proc),
    args, results: List<Nat>, env: Env):
    src.performs(call, n, Succ(d))(index, args, results, env) =
        ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)), λ flow => proc.leave(env, results, flow)) {
    j(sym(found), λ o _ => (match o as λ _ => ITree<Flow>(Events::linux()) {
            None => Ret(Onward(env)),
            Some(p) => ITree::map(Events::linux(), p.body.denote(call, src.performs(call, n, d), n, p.enter(env, args)), λ flow => p.leave(env, results, flow)),
        }) = ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)), λ flow => proc.leave(env, results, flow)),
        refl)
}

// ---------------------------------------------------------------------------
// Small facts the call reads

// Words read only the file.
theorem Env::words_at_words(self env: Env, ids: List<Nat>, buffers: Buffers(), args: List<List<BitVec(8)>>):
    Env(env.words, buffers, args).words_at(ids) = env.words_at(ids) {
    match ids {
        Nil => refl,
        Cons(id, rest) => cong_fn<List<BitVec(64)>, List<BitVec(64)>>(λ ws => Cons(env.word(id), ws), env.words_at_words(rest, buffers, args)),
    }
}

theorem List::onto_mem<A>(self xs: List<A>, a: A): (acc: List<A>) → Mem(a, xs.onto(acc)) → Mem(a, xs) ∨ Mem(a, acc) {
    match xs {
        Nil => λ acc m => Inr(m),
        Cons(h, rest) => λ acc m => match rest.onto_mem(a, Cons(h, acc), m) {
            Inl(r) => Inl(Inr(r)),
            Inr(c) => match c { Inl(e) => Inl(Inl(e)), Inr(r) => Inr(r) },
        },
    }
}

// What registers no word lives in hold, but RAX, RBX and RSP, kept.
theorem Gprs::holding_scratch(self g: Gprs, g2: Gprs, keeps: g2.KeepsScratch(g), values: List<BitVec(64)>):
    (registers: List<Gpr>) → gprs_outside(registers, home_pool()).IsTrue() → gprs_outside(registers, [Rax, Rbx, Rsp]).IsTrue() →
    g.Holding(registers, values) → g2.Holding(registers, values) {
    match values {
        Nil => λ _ _ _ _ => trivial,
        Cons(_, rest) => λ registers => match registers {
            Nil => λ _ _ _ => trivial,
            Cons(register, more) => λ outside clear holding => {
                let out = Bool::is_true_and(register.absent_from(home_pool()), gprs_outside(more, home_pool()), outside);
                let cl = Bool::is_true_and(register.absent_from([Rax, Rbx, Rsp]), gprs_outside(more, [Rax, Rbx, Rsp]), clear);
                ⟨trans(keeps(register, out.left, cl.left), holding.left), g.holding_scratch(g2, keeps, rest, more, out.right, cl.right, holding.right)⟩
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Every call runs as the call

// No room: the shared exit, as the source's call past the depth.
theorem Target::perform_deep(self t: Target, src: Source, call: Writers(), n: Nat, room: t.room = 0, hosts: t.Hosts()):
    t.Calls(call, src.performs(call, n, 0)) {
    let layout = t.layout();
    λ p out index args results fit within apart n2 env k exits next => {
        let dp = hosts.right.witness;
        let w_deep = hosts.right.proof;
        let w_dl: Prog::At(dp, layout.deep_label(), Block([])).Within(t.program) =
            Prog::At(dp, layout.deep_label(), Block([])).within_trans(dp.deep_exit(layout), t.program, Exists(2, refl), w_deep);
        let e = p.call_enters(layout);
        let saved = out.minus(results);
        let pu = e.pushes(layout, saved);
        let pa = pu.words_to(layout, args, call_registers());
        let w_pa = pa.within_before(0, CallTo(layout.procedure_label(index)), t.program, then(pa, CallTo(layout.procedure_label(index))).within_trans(
            then(pa, CallTo(layout.procedure_label(index))).pops(layout, saved.rev()), t.program,
            Prog::within_pops(layout, saved.rev(), then(pa, CallTo(layout.procedure_label(index)))),
            then(pa, CallTo(layout.procedure_label(index))).pops(layout, saved.rev()).within_trans(
                then(pa, CallTo(layout.procedure_label(index))).pops(layout, saved.rev()).call_leaves(layout), t.program, Exists(4, refl),
                then(pa, CallTo(layout.procedure_label(index))).pops(layout, saved.rev()).call_leaves(layout).within_trans(
                    p.performs(layout, out, index, args, results), t.program,
                    Prog::within_words_from(layout, out, results, call_registers(), then(pa, CallTo(layout.procedure_label(index))).pops(layout, saved.rev()).call_leaves(layout)),
                    within))));
        let w_e = e.within_trans(pu, t.program, Prog::within_pushes(layout, saved, e),
            pu.within_trans(pa, t.program, Prog::within_words_to(layout, args, call_registers(), pu), w_pa));
        let tree: ITree<BitVec(64)>(Events::linux()) = k(Exited(call_depth_status()));
        t.goes_call_enter(args.union(saved), env, p, w_e, w_dl.witness, dp, Block([]), w_dl.proof, tree,
            λ _ => t.goes_deep(dp, w_deep, tree, λ _ => True, λ s at exited => exits(call_depth_status(), s, at, exited)),
            λ d2 roomy more => absurd(trans(sym(room), more)))
    }
}

// Room for one more: the room taken, the words saved, the arguments
// passed, the call, the callee's body by the depth below, the return, the
// words restored, the room given back, and the results taken. RSP is the
// frame throughout, so each push, pop, CALL and RET moves the claim to
// another activation (`Target::held_moved`).
theorem Target::perform_call(self t: Target, src: Source, call: Writers(), n, d: Nat, room: t.room = Succ(d),
    tp: t.procedures = src.procedures,
    hosts: t.Hosts(), answers: t.Answered(call),
    ih: (c: Target) → c.procedures = src.procedures → c.Hosts() → c.Answered(call) → c.room = d → c.Calls(call, src.performs(call, n, d))):
    t.Calls(call, src.performs(call, n, Succ(d))) {
    let layout = t.layout();
    let regs = call_registers();
    λ p out index args results fit within apart n2 env k exits next => {
        let parts = layout.call_fits_parts(out, index, args, results, fit);
        let proc = parts.witness;
        let found = parts.proof.left;
        let fp = parts.proof.right;
        let found_src: (src.procedures.nth(index) = Some(proc)) = trans(cong_fn<List<Procedure>, Option<Procedure>>(λ ps => ps.nth(index), sym(tp)), found);
        let saved = out.minus(results);
        let live = args.union(saved);
        let names_fit = fp.right.right.right.right.left;
        let inside_args = λ (i: Nat) (m: Mem(i, args)) => layout.words_fit_mem(args ++ (results ++ saved), i, names_fit, args.mem_append_l(results ++ saved, i, m));
        let inside_results = λ (i: Nat) (m: Mem(i, results)) => layout.words_fit_mem(args ++ (results ++ saved), i, names_fit,
            args.mem_append_r(results ++ saved, i, results.mem_append_l(saved, i, m)));
        let inside_saved = λ (i: Nat) (m: Mem(i, saved)) => layout.words_fit_mem(args ++ (results ++ saved), i, names_fit,
            args.mem_append_r(results ++ saved, i, results.mem_append_r(saved, i, m)));
        // The procedure in the program.
        let hosted = hosts.left(index, proc, found);
        let pre_i = hosted.witness;
        let names_i = hosted.proof.witness;
        let b_i = hosted.proof.proof.witness;
        let fits_eq = hosted.proof.proof.proof.left;
        let emitted_i = hosted.proof.proof.proof.right.left;
        let w_exit = hosted.proof.proof.proof.right.right;
        let pf = proc.fits_parts(layout, fits_eq);
        let entry_live = proc.body.live_in(t.homes, proc.results);
        let lbl = Prog::At(pre_i, layout.procedure_label(index), Block([]));
        let entry = proc.entry_code(pre_i, layout, index);
        let moved = b_i.prog.words_to(layout, proc.results, regs);
        let w_b: b_i.prog.Within(t.program) = b_i.prog.within_trans(moved, t.program, Prog::within_words_to(layout, proc.results, regs, b_i.prog),
            moved.within_trans(proc.exit_code(b_i.prog, layout), t.program, Exists(1, refl), w_exit));
        let w_entry: entry.Within(t.program) = entry.within_trans(b_i.prog, t.program, proc.body.emit_extends(layout, entry, proc.results, names_i, b_i, emitted_i), w_b);
        let w_lbl: lbl.Within(t.program) = lbl.within_trans(entry, t.program, Prog::within_words_from(layout, entry_live, proc.params, regs, lbl), w_entry);
        let inside_params = λ (i: Nat) (m: Mem(i, proc.params)) => layout.words_fit_mem(proc.params ++ proc.results, i, pf.right.right.right.left,
            proc.params.mem_append_l(proc.results, i, m));
        let inside_proc_results = λ (i: Nat) (m: Mem(i, proc.results)) => layout.words_fit_mem(proc.params ++ proc.results, i, pf.right.right.right.left,
            proc.params.mem_append_r(proc.results, i, m));
        // The call's code in the program.
        let e = p.call_enters(layout);
        let pu = e.pushes(layout, saved);
        let pa = pu.words_to(layout, args, regs);
        let ca = then(pa, CallTo(layout.procedure_label(index)));
        let po = ca.pops(layout, saved.rev());
        let le = po.call_leaves(layout);
        let w_le: le.Within(t.program) = le.within_trans(p.performs(layout, out, index, args, results), t.program,
            Prog::within_words_from(layout, out, results, regs, le), within);
        let w_po: po.Within(t.program) = po.within_trans(le, t.program, Exists(4, refl), w_le);
        let w_ca: ca.Within(t.program) = ca.within_trans(po, t.program, Prog::within_pops(layout, saved.rev(), ca), w_po);
        let w_pa: pa.Within(t.program) = pa.within_before(0, CallTo(layout.procedure_label(index)), t.program, w_ca);
        let w_pu: pu.Within(t.program) = pu.within_trans(pa, t.program, Prog::within_words_to(layout, args, regs, pu), w_pa);
        let w_e: e.Within(t.program) = e.within_trans(pu, t.program, Prog::within_pushes(layout, saved, e), w_pu);
        let dp = hosts.right.witness;
        let w_dl: Prog::At(dp, layout.deep_label(), Block([])).Within(t.program) =
            Prog::At(dp, layout.deep_label(), Block([])).within_trans(dp.deep_exit(layout), t.program, Exists(2, refl), hosts.right.proof);
        // The trees: the callee's body, then the continuation through the leave.
        let callee_tree = proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args));
        let k2 = λ (flow: Flow) => k(proc.leave(env, results, flow));
        let tree: ITree<BitVec(64)>(Events::linux()) =
            ITree::bind(Events::linux(), ITree::map(Events::linux(), callee_tree, λ flow => proc.leave(env, results, flow)), k);
        let tree2: ITree<BitVec(64)>(Events::linux()) = ITree::bind(Events::linux(), callee_tree, k2);
        let same: ITree::Same(Events::linux(), tree, tree2) =
            ITree::bind_assoc(Events::linux(), callee_tree, λ (flow: Flow) => Ret(proc.leave(env, results, flow)), k);
        let main: t.At(prog_len(p), live, tree2, env) = λ s0 here0 resident0 held0 => {
            let env_args: (env.args = t.args) = t.held_args(live, env, s0.gprs, s0.memory, held0);
            let back_mem = λ (x: Nat) (m: Mem(x, saved.rev().onto(Nil))) => match saved.rev().onto_mem(x, Nil, m) as λ _ => Mem(x, saved) {
                Inl(r) => saved.mem_rev(x, r),
                Inr(never) => false_elim(never),
            };
            let enter = λ (d2: Nat) (roomy: d2 * (8 * (t.words + 1)) + 80 * t.functions.len() <= t.index) (eq: t.room = Succ(d2)) => {
                let u = t.activation(t.index, t.frames, d2, t.framed, roomy);
                let d_eq: (d2 = d) = omega(eq, room);
                let s_le: (saved.len() <= t.words) = fp.right.right.right.right.right.left;
                let was0: (Succ(d2) * (8 * (t.words + 1)) + 80 * t.functions.len() <= t.index) = j(eq, λ r _ => r * (8 * (t.words + 1)) + 80 * t.functions.len() <= t.index, t.roomy);
                let was1: ((8 * (t.words + 1)) * Succ(d2) + 80 * t.functions.len() <= t.index) =
                    j(Nat::mul_comm(Succ(d2), 8 * (t.words + 1)), λ v _ => v + 80 * t.functions.len() <= t.index, was0);
                let was: (((8 * (t.words + 1)) * d2 + 8 * (t.words + 1)) + 80 * t.functions.len() <= t.index) = was1;
                let comm: (d2 * (8 * (t.words + 1)) = (8 * (t.words + 1)) * d2) = Nat::mul_comm(d2, 8 * (t.words + 1));
                let room8: (8 * saved.len() + 8 <= t.index) = omega(was, s_le);
                // The activations a call passes through: the caller's with
                // one less room (`u`), the one below its saved words (`i1`,
                // made where the pushes end), the callee's below the return
                // address (`c`, at `i2`), and the one the RET leaves (`w1`).
                let i1 = t.index - 8 * saved.len();
                let i2 = t.index - 8 * saved.len() - 8;
                let room_p: (d2 * (8 * (t.words + 1)) + 80 * t.functions.len() + 8 * saved.len() <= t.index) = omega(was, s_le, comm);
                let roomy2: (d2 * (8 * (t.words + 1)) + 80 * t.functions.len() <= i2) = omega(was, s_le, comm);
                let roomy0: (d2 * (8 * (t.words + 1)) + 80 * t.functions.len() <= i2 + 8) = omega(was, s_le, comm);
                let j_eq: (i2 + 8 = i1) = omega(room8);
                let below_i2: (i2 + 8 <= i1) = omega(room8);
                let fits_i2: (i2 + 8 <= t.stack.size) = omega(room8, t.framed);
                let sv = env.words_at(saved.onto(Nil));
                let va = env.words_at(args);
                let ret = next_rip(t.origin, prog_len(pa) + 5);
                let svlen: (sv.len() = saved.len()) = trans(env.words_at_len(saved.onto(Nil)), saved.onto_len(Nil));
                let lens: ((sv ++ t.frames).len() = sv.len() + t.frames.len()) = sv.len_append(t.frames);
                let framed2: (i2 + 8 * Succ((sv ++ t.frames).len()) <= t.stack.size) = omega(lens, svlen, room8, t.framed);
                let framed0: (i2 + 8 + 8 * (sv ++ t.frames).len() <= t.stack.size) = omega(lens, svlen, room8, t.framed);
                let long_params: (proc.params.len() <= va.len()) = omega(env.words_at_len(args), fp.left);
                let c = u.activation(i2, Cons(ret, sv ++ t.frames), d2, framed2, roomy2);
                let w1 = u.activation(i2 + 8, sv ++ t.frames, d2, framed0, roomy0);
                // After the return.
                let mixed = λ (after: Env) => Env(env.words, after.buffers, env.args);
                let lp = saved.rev().onto(Nil);
                let popped_eq: (i2 + 8 + 8 * saved.rev().len() = t.index) = omega(saved.rev_len(), room8);
                let onto_eq: (saved.onto(Nil) = saved.rev()) = trans(saved.onto_rev(Nil), saved.rev().append_nil());
                let returned = λ (after: Env) => {
                    let aw = after.words_at(proc.results);
                    let tk = k2(Onward(after));
                    let keep = λ (g: Gprs) (g2: Gprs) (h: g.Holding(regs, aw)) (ks: g2.KeepsScratch(g)) => g.holding_scratch(g2, ks, aw, regs, trivial, trivial, h);
                    let res_le6: (results.len() <= regs.len()) = fp.right.right.right.left;
                    let res_le_aw: (results.len() <= aw.len()) = omega(after.words_at_len(proc.results), fp.right.left);
                    let gf = t.goes_words_from(out, tk, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(out, mixed(after).set_words(results, aw), g, m), results)(
                        regs, aw, le, lp, mixed(after),
                        λ i m => saved.rev().mem_onto(i, Nil, saved.rev().mem_rev(i, j(sym(saved.rev_involutive()), λ x _ => Mem(i, x), m))),
                        inside_results, fp.right.right.right.right.right.right, trivial, trivial, res_le6, res_le_aw, within,
                        next(mixed(after).set_words(results, aw)));
                    let wf = t.goes_weaken(prog_len(le), tk,
                        λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(lp, mixed(after), s.gprs, s.memory) ∧ (s.gprs.Holding(regs, aw) ∧
                            ((g2: Gprs) → (m2: X86Memory(t.r.profile)) → t.Held(out, mixed(after).set_words(results, aw), g2, m2) → t.Spares(s.gprs, g2) →
                                t.Held(out, mixed(after).set_words(results, aw), g2, m2))),
                        λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(lp, mixed(after), s.gprs, s.memory) ∧ s.gprs.Holding(regs, aw),
                        gf, λ s pre => ⟨pre.left, ⟨pre.right, λ g2 m2 h2 _ => h2⟩⟩);
                    // The room back, from the caller's activation the pops end in.
                    let cl = t.goes_call_leave(lp, mixed(after), po, d2, eq, roomy, λ (g: Gprs) => g.Holding(regs, aw), keep, w_le, tk, wf);
                    // The saved words popped, from the activation the RET
                    // leaves: its frames are the words the pushes left.
                    let ws_eq: (sv = mixed(after).words_at(saved.rev())) = sym(trans(env.words_at_words(saved.rev(), after.buffers, env.args),
                        cong_fn<List<Nat>, List<BitVec(64)>>(λ ids => env.words_at(ids), sym(onto_eq))));
                    let framed_p: (i2 + 8 + 8 * (mixed(after).words_at(saved.rev()) ++ t.frames).len() <= t.stack.size) =
                        j(ws_eq, λ ws _ => i2 + 8 + 8 * (ws ++ t.frames).len() <= t.stack.size, framed0);
                    let pops = u.goes_pops(mixed(after), tk, λ (g: Gprs) => g.Holding(regs, aw), keep, saved.rev())(ca, Nil, i2 + 8, t.frames,
                        λ i m => {
                            let ms = saved.mem_rev(i, m);
                            ⟨inside_saved(i, ms), t.held_number(live, env, s0.gprs, s0.memory, held0, i, args.union_right(saved, i, ms), inside_saved(i, ms))⟩
                        },
                        λ x mx y my kk ax ay => t.held_shared(live, env, s0.gprs, s0.memory, held0, x, y,
                            args.union_right(saved, x, back_mem(x, mx)), args.union_right(saved, y, back_mem(y, my)), kk, ax, ay),
                        w_po, framed_p, roomy0,
                        j(sym(popped_eq), λ x _ => (fr: x + 8 * t.frames.len() <= t.stack.size) → (ro: d2 * (8 * (t.words + 1)) + 80 * t.functions.len() <= x) →
                            t.GoesR(prog_len(po), tk, λ (g: Gprs) (m: X86Memory(t.r.profile)) =>
                                t.activation(x, t.frames, d2, fr, ro).Held(lp, mixed(after), g, m) ∧ g.Holding(regs, aw)), λ fr ro => cl));
                    c.goes_callee_return(after, b_i.prog, proc.results, tk, w_exit, inside_proc_results, ret, sv ++ t.frames, refl, framed0, roomy0,
                        λ s rip_s resident_s held_w holding_w => {
                            let held_m = w1.held_like(Nil, after, mixed(after), s.gprs, s.memory, held_w,
                                ⟨λ i never => false_elim(never), ⟨refl, trans(w1.held_args(Nil, after, s.gprs, s.memory, held_w), sym(env_args))⟩⟩);
                            let held_p = j(ws_eq, λ ws _ => (fr: i2 + 8 + 8 * (ws ++ t.frames).len() <= t.stack.size) →
                                    t.activation(i2 + 8, ws ++ t.frames, d2, fr, roomy0).Held(Nil, mixed(after), s.gprs, s.memory),
                                λ fr => w1.held_proofs(Nil, mixed(after), s.gprs, s.memory, held_m, fr, roomy0))(framed_p);
                            pops(s, rip_s, resident_s, ⟨held_p, holding_w⟩)
                        })
                };
                let body = proc.body.emit_runs(c, call, src.performs(call, n, d), ih(c, tp, hosts, answers, d_eq), c.functions_run(call, answers))(entry, proc.results, names_i, b_i, emitted_i, w_b, pf.left)(
                    n, proc.enter(env, args), k2, exits, returned);
                let next_c = c.at_like(prog_len(entry), entry_live, tree2, proc.enter(env, args), env.set_words(proc.params, va),
                    env.entered_like(proc.params, entry_live, va, long_params, entry_live.within_mem(proc.params, pf.right.left)), body);
                // The saved words pushed; then, in the activation below
                // them, the arguments into their registers and the CALL, a
                // move to the callee's activation.
                u.goes_pushes(live, env, tree2, saved)(e, t.index, Nil, λ i m => ⟨inside_saved(i, m), args.union_right(saved, i, m)⟩,
                    room_p, w_pu, t.framed, roomy, λ fr1 ro1 => {
                    let u1 = u.activation(i1, sv ++ t.frames, d2, fr1, ro1);
                    let q2 = λ (g: Gprs) (m: X86Memory(t.r.profile)) => u1.Held(live, env, g, m) ∧ g.Holding(regs, va);
                    let displacement = asm_jump_of(asm_labels(t.program), prog_len(pa), CallTo(layout.procedure_label(index)));
                    let called = t.io().goes_callto(t.program, t.origin, t.stack, t.stack_writes, t.code_fits(), w_ca.witness, pa, 0, layout.procedure_label(index), w_ca.proof,
                        prog_len(pre_i), t.program.lands_call(t.laid, w_ca.witness, pa, 0, index + t.functions.len(), w_ca.proof, w_lbl.witness, pre_i, Block([]), w_lbl.proof),
                        tree2, λ (s: MachineState<X86Memory(t.r.profile)>) => q2(s.gprs, s.memory), λ _ => i2,
                        λ s pre => ⟨trans(u1.held_rsp(live, env, s.gprs, s.memory, pre.left), cong_fn<Nat, BitVec(64)>(λ x => t.stack.at(x), sym(j_eq))), fits_i2⟩,
                        λ s pre => {
                            let rsp8: (read_gpr(Rsp, s.gprs) = t.stack.at(i2 + 8)) =
                                trans(u1.held_rsp(live, env, s.gprs, s.memory, pre.left), cong_fn<Nat, BitVec(64)>(λ x => t.stack.at(x), sym(j_eq)));
                            let entered = c.goes_callee_entry(live, env, pre_i, proc, index, va,
                                tree2, w_entry, inside_params, pf.right.right.left, pf.right.left, pf.right.right.right.right.left, long_params, next_c);
                            λ v here resident post => {
                                let mem_eq: (v.memory = t.r.profile.store(s.memory, t.stack.at(i2), word_bytes(next_rip(s.rip, 5)))) =
                                    trans(cong_fn<MachineState<X86Memory(t.r.profile)>, X86Memory(t.r.profile)>(λ x => x.memory, post.left),
                                        t.call_pushed(s, displacement, i2, rsp8));
                                let gprs_eq: (v.gprs = write_gpr(Rsp, push_address(s.gprs), s.gprs)) =
                                    cong_fn<MachineState<X86Memory(t.r.profile)>, Gprs>(λ x => x.gprs, post.left);
                                let stored_m = t.r.profile.store(s.memory, t.stack.at(i2), word_bytes(next_rip(s.rip, 5)));
                                let held_st: u1.Held(live, env, s.gprs, stored_m) = u1.held_stack_store(live, env, s.gprs, s.memory, pre.left, i2, below_i2, next_rip(s.rip, 5));
                                let frames_up = j(sym(j_eq), λ x _ => t.FramesAt(stored_m, sv ++ t.frames, x), u1.held_frames(live, env, s.gprs, stored_m, held_st));
                                let frames_v: t.FramesAt(v.memory, Cons(ret, sv ++ t.frames), i2) =
                                    ⟨fits_i2, ⟨post.right.right, j(sym(mem_eq), λ mm _ => t.FramesAt(mm, sv ++ t.frames, i2 + 8), frames_up)⟩⟩;
                                let frames_c: t.FramesAt(stored_m, Cons(ret, sv ++ t.frames), i2) =
                                    j(mem_eq, λ mm _ => t.FramesAt(mm, Cons(ret, sv ++ t.frames), i2), frames_v);
                                let rsp_c: (push_address(s.gprs) = t.stack.at(i2)) = trans(sym(read_gpr_after_write(Rsp, push_address(s.gprs), s.gprs)),
                                    trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsp, g), sym(gprs_eq)), post.right.left));
                                let held_c: c.Held(live, env, write_gpr(Rsp, push_address(s.gprs), s.gprs), stored_m) =
                                    u1.held_moved(live, env, s.gprs, stored_m, held_st, i2, Cons(ret, sv ++ t.frames), framed2, roomy2, push_address(s.gprs), rsp_c, frames_c);
                                let held_v = j(sym(gprs_eq), λ g _ => c.Held(live, env, g, v.memory),
                                    j(sym(mem_eq), λ mm _ => c.Held(live, env, write_gpr(Rsp, push_address(s.gprs), s.gprs), mm), held_c));
                                let holding_v = j(sym(gprs_eq), λ g _ => g.Holding(regs, va), s.gprs.holding_write(Rsp, push_address(s.gprs), va, regs, trivial, pre.right));
                                entered(v, here, resident, ⟨held_v, holding_v⟩)
                            }
                        });
                    let wt = u1.goes_words_to(live, env, tree2, q2, args)(regs, pu, λ i m => ⟨inside_args(i, m), args.union_left(saved, i, m)⟩, trivial, trivial, w_pa, called);
                    t.goes_weaken(prog_len(pu), tree2,
                        λ (s: MachineState<X86Memory(t.r.profile)>) => u1.Held(live, env, s.gprs, s.memory) ∧
                            ((g2: Gprs) → u1.Held(live, env, g2, s.memory) → env.InRegisters(g2, args, regs) → g2.KeepsOutside(s.gprs, regs) → q2(g2, s.memory)),
                        λ (s: MachineState<X86Memory(t.r.profile)>) => u1.Held(live, env, s.gprs, s.memory),
                        wt, λ s pre => ⟨pre, λ g2 h2 inreg ko => ⟨h2, inreg⟩⟩)
                })
            };
            t.goes_call_enter(live, env, p, w_e, w_dl.witness, dp, Block([]), w_dl.proof, tree2,
                λ zero => absurd(trans(sym(room), zero)), enter)(s0, here0, resident0, held0)
        };
        j(sym(src.performs_found(call, n, d, index, proc, found_src, args, results, env)),
            λ tr _ => t.At(prog_len(p), live, ITree::bind(Events::linux(), tr, k), env),
            t.site().goes_same(t.io(), prog_len(p), tree, tree2, λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(live, env, s.gprs, s.memory), same, main))
    }
}

// Every call at depth `d` runs as the call, by induction on the depth.
theorem Source::calls_at(self src: Source, call: Writers(), n: Nat, d: Nat):
    (t: Target) → t.procedures = src.procedures → t.Hosts() → t.Answered(call) → t.room = d → t.Calls(call, src.performs(call, n, d)) {
    match d {
        Zero => λ t tp hosts _ room => t.perform_deep(src, call, n, room, hosts),
        Succ(d1) => λ t tp hosts answers room => t.perform_call(src, call, n, d1, room, tp, hosts, answers, src.calls_at(call, n, d1)),
    }
}

// A source with procedures or functions: `main` from past their labels,
// every call of a procedure by the depth (`Source::calls_at`), every call
// of a function by its contract (`Target::functions_run`).
theorem native_compile_correct_calls(src: Source, r: DataRegion, homes: Homes, fits: Layout::of(r.low, src.words, src.capacities(), homes).size() <= r.size, program: Prog,
    allocated: src.allocation_ok(homes).IsTrue(), compiled: src.compile_calls(r.low, homes) = Some(program), origin: BitVec(64), s: MachineState<X86Memory(r.profile)>,
    here: s.rip = next_rip(origin, 0), resident: r.profile.linux().site(program, origin).Resident(s.memory),
    zero: r.Holds(λ _ => zero_byte(), s.memory),
    stack: Stack<X86Memory(r.profile)>(r.profile.linux().fetch, r.profile.linux().data), stack_writes: stack.writes = linux_writes(r.profile.linux()),
    stack_above: r.low.toNat() + r.size <= stack.low.toNat(), stack_canonical: stack.low.toNat() + stack.size <= Nat::pow(2, 47),
    top: stack.at(stack.size) = read_gpr(Rsp, s.gprs), deep: src.depth * (8 * (src.words + 1)) + 80 * src.functions.len() <= stack.size,
    args: List<List<BitVec(8)>>, argv: ArgvAt(r.profile.data().above(stack.low.toNat() + stack.size), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimPaidProgram(r.profile.linux(), src.denote(args), s) {
    let call = program_writers(src.functions);
    let layout = src.layout(r.low, homes);
    let entry = src.entry(r.low, homes);
    let ok = src.allocation_sound(homes, allocated);
    let ok2 = ok.right;
    let built = src.calls_built(r.low, homes, program, compiled);
    let c = built.witness;
    let emitted = built.proof.left;
    let w_whole = built.proof.right.left;
    let framed: (stack.size + 8 * 0 <= stack.size) = omega();
    let t = Target(r, src.words, src.capacities(), homes, ok.left, fits, program, origin, built.proof.right.right.right.right.left, args,
        src.procedures, src.functions, stack, stack_writes, stack_above, stack_canonical, stack.size, [], src.depth, framed, deep);
    let hosts: t.Hosts() = ⟨built.proof.right.right.left, built.proof.right.right.right.left⟩;
    let linked = built.proof.right.right.right.right.right;
    let meets = linked.witness.links_calls<X86Memory(r.profile)>(homes.places, linked.proof.witness, program, t.site(), t.laid, stack, program.within_self(),
        src.functions, linked.proof.proof);
    let linking = Bool::is_true_and(program_evaluable(src.functions), program_placeless(src.functions), meets.left);
    let answers: t.Answered(call) = t.answers_of(linking.left, linking.right, meets.right);
    let fns = t.functions_run(call, answers);
    let once: (src.depth * 1 <= src.depth * (8 * (src.words + 1))) = Nat::mul_le_mono_l(src.depth, 1, 8 * (src.words + 1), omega());
    let small: (src.depth < Nat::pow(2, 64)) = omega(once, deep, stack_canonical, canonical_below_top());
    let live = src.main.live_in(homes, []);
    let saved = Start.saves_rsp(layout, src.depth);
    let w_c: c.prog.Within(program) = c.prog.within_trans(then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall),
        program, Exists(2, refl), w_whole);
    let runs = λ (n: Nat) => src.main.emit_runs(t, call, src.performs(call, n, src.depth), src.calls_at(call, n, src.depth, t, refl, hosts, answers, refl), fns,
        entry, [], layout.deep_label(), c, emitted, w_c, ok2.right);
    let w_entry = entry.within_trans(c.prog, program, src.main.emit_extends(layout, entry, [], layout.deep_label(), c, emitted), w_c);
    let w_saved = saved.within_trans(entry, program, Prog::within_inits(layout, src.buffers, 0, saved), w_entry);
    let caps = λ (k: Nat) => {
        let shifted: (0 + k = k) = omega();
        cong_fn<Nat, Option<Nat>>(λ x => t.caps.nth(x), shifted)
    };
    let exits: t.Exiting(λ (flow: Flow) => Ret(flow.status())) = λ status u at exited =>
        paid_ret(t.io(), status, u, u, Exists(Zero, refl), at, exited);
    let after = λ (end: Env) => t.goes_finish(c.prog, w_whole, Ret(BitVec::zero()),
        λ (u: MachineState<X86Memory(t.r.profile)>) => t.Held([], end, u.gprs, u.memory),
        λ u at exited => paid_ret(t.io(), BitVec::zero(), u, u, Exists(Zero, refl), at, exited));
    let tree = λ (n: Nat) => { let d: ITree<BitVec(64)>(Events::linux()) = ITree::bind(Events::linux(), src.main.denote(call, src.performs(call, n, src.depth), n, src.start(args)), λ (flow: Flow) => Ret(flow.status())); d };
    λ n => t.goes_start(live, ok2.left, refl, src.depth, refl, small, Start, w_saved, tree(n),
        t.goes_inits(live, tree(n), src.buffers, 0, saved, t.start_env(), caps, w_entry,
            runs(n, n, src.start(args), λ (flow: Flow) => Ret(flow.status()), exits, after)),
        s, here, resident, ⟨zero, ⟨argv, sym(top)⟩⟩)
}

// The compiled program, from its first byte with its code resident, its
// region zero, a stack above the region whose top is RSP and deep enough
// for the source's calls, and the command line `args` at RSP above the
// stack, simulates the source run with `args` at every fuel, whatever homes
// the compile was given: it checked them (`Source::allocation_ok`).
theorem native_compile_correct(src: Source, r: DataRegion, homes: Homes, fits: Layout::of(r.low, src.words, src.capacities(), homes).size() <= r.size, program: Prog,
    compiled: src.compile(r.low, homes) = Some(program), origin: BitVec(64), s: MachineState<X86Memory(r.profile)>,
    here: s.rip = next_rip(origin, 0), resident: r.profile.linux().site(program, origin).Resident(s.memory),
    zero: r.Holds(λ _ => zero_byte(), s.memory),
    stack: Stack<X86Memory(r.profile)>(r.profile.linux().fetch, r.profile.linux().data), stack_writes: stack.writes = linux_writes(r.profile.linux()),
    stack_above: r.low.toNat() + r.size <= stack.low.toNat(), stack_canonical: stack.low.toNat() + stack.size <= Nat::pow(2, 47),
    top: stack.at(stack.size) = read_gpr(Rsp, s.gprs), deep: src.depth * (8 * (src.words + 1)) + 80 * src.functions.len() <= stack.size,
    args: List<List<BitVec(8)>>, argv: ArgvAt(r.profile.data().above(stack.low.toNat() + stack.size), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimPaidProgram(r.profile.linux(), src.denote(args), s) {
    let bare: Option<Prog> = match src.main.emit(src.entry(r.low, homes), src.layout(r.low, homes), [], 0) { None => None, Some(c) => c.prog.finish() };
    (match src.allocation_ok(homes) as λ a => src.allocation_ok(homes) = a → (match a {
            False => None,
            True => match src.procedures {
                Nil => match src.functions { Nil => bare, Cons(_, _) => src.compile_calls(r.low, homes) },
                Cons(_, _) => src.compile_calls(r.low, homes),
            },
        }) = Some(program) → SimPaidProgram(r.profile.linux(), src.denote(args), s) {
        False => λ _ none => absurd(none),
        True => λ allocated => (match no_procedures: src.procedures {
            Nil => (match no_functions: src.functions {
                Nil => λ _ => native_compile_correct_bare(src, r, homes, fits, program, compiled, no_procedures, no_functions, origin, s, here, resident, zero,
                    stack, stack_writes, stack_above, stack_canonical, top, deep, args, argv),
                Cons(_, _) => λ calls => native_compile_correct_calls(src, r, homes, fits, program, j(sym(allocated), λ v _ => v.IsTrue(), trivial), calls,
                    origin, s, here, resident, zero, stack, stack_writes, stack_above, stack_canonical, top, deep, args, argv),
            }),
            Cons(_, _) => λ calls => native_compile_correct_calls(src, r, homes, fits, program, j(sym(allocated), λ v _ => v.IsTrue(), trivial), calls,
                origin, s, here, resident, zero, stack, stack_writes, stack_above, stack_canonical, top, deep, args, argv),
        }),
    })(refl, compiled)
}

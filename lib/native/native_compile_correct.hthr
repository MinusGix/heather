// The effectful source's compiler proved once (issues/native-effect-source-compiler.md,
// round S3.2): every statement `Stmt::emit` compiles runs as its tree
// (`Stmt::emit_runs`, by induction on the statement), and so every program
// `Source::compile` builds simulates the source's denotation from a region
// holding its start (`native_compile_correct`).
//
// A statement's claim (`Target::Runs`) is over a continuation: from every
// environment placed at the statement's start, the code runs as the
// statement's tree bound to `k`, wherever `k` goes on from the statement's
// end with each environment it may finish in, and meets every exit with
// its status. `Then` is `bind_assoc`; `Branch` is the test's two ways and a
// JMP over the second arm; `Repeat` is an induction on the loop's fuel, the
// body run each round with the test and a JMP back as its continuation.
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_steps;
import native_compile_segments;
import native_compile_calls;
import native_compile_leaf;
import native_compile_bytes;
import native_compile_nodes;
import native_compile_args;
import native_compile_opens;
import native_compile_homes;
import native_alloc;
import function_ir;
import function_ir_eval;
import function_ir_lower;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_sim;
import itree;
import x86_64;
import x86_64_block;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_byte_memory;
import linux_x86_64_byte_memory;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Where each piece starts, inside what it builds

theorem Prog::within_label(self p: Prog, name: Nat): p.Within(p.label(name)) { Exists(1, refl) }

theorem Prog::within_tests(self p: Prog, layout: Layout, condition, else_name: Nat): p.Within(p.tests(layout, condition, else_name)) {
    p.within_trans(p.bit_to(layout, condition, Rax), p.tests(layout, condition, else_name), p.within_bit_to(layout, condition, Rax), Exists(2, refl))
}

theorem Prog::within_exits(self p: Prog, layout: Layout, status: Nat): p.Within(p.exits(layout, status)) {
    p.within_trans(p.word_to(layout, status, Rdi), p.exits(layout, status), p.within_word_to(layout, status, Rdi), Exists(2, refl))
}

// The calls' code from its start: fixed runs of items between the words'
// loads and stores, whose length is each word's home.
theorem Prog::within_reads(self p: Prog, layout: Layout, out: List<Nat>, fd, buf, len, result, capacity, names: Nat):
    p.Within(p.reads(layout, out, fd, buf, len, result, capacity, names).prog) {
    let r0 = p.word_to(layout, len, Rdx);
    let clamped = then(r0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(Rdx, R9, Succ(names));
    let r1 = then(clamped, Block([MovRI(Rsi, layout.scratch_at()), MovRI(Rax, BitVec::ofNat(0))]));
    let r2 = r1.word_to(layout, fd, Rdi);
    let asked = then(r2, Syscall);
    let copied = then(then(asked, Block([TestRR(Rax, Rax)])), Jcc(S, Succ(Succ(Succ(names))))).copy_in(layout, buf, Succ(Succ(names)), Succ(Succ(Succ(names)))).label(Succ(Succ(Succ(names))));
    p.within_trans(r0, p.reads(layout, out, fd, buf, len, result, capacity, names).prog, p.within_word_to(layout, len, Rdx),
        r0.within_trans(clamped, p.reads(layout, out, fd, buf, len, result, capacity, names).prog, Exists(5, refl),
            clamped.within_trans(r1, p.reads(layout, out, fd, buf, len, result, capacity, names).prog, clamped.within_then(0, Block([MovRI(Rsi, layout.scratch_at()), MovRI(Rax, BitVec::ofNat(0))])),
                r1.within_trans(r2, p.reads(layout, out, fd, buf, len, result, capacity, names).prog, r1.within_word_to(layout, fd, Rdi),
                    r2.within_trans(copied, p.reads(layout, out, fd, buf, len, result, capacity, names).prog, Exists(12, refl),
                        copied.within_word_from(layout, out, result, Rax))))))
}

theorem Prog::within_writes(self p: Prog, layout: Layout, out: List<Nat>, fd, buf, from, len, result, capacity, names: Nat):
    p.Within(p.writes(layout, out, fd, buf, from, len, result, capacity, names).prog) {
    let whole = p.writes(layout, out, fd, buf, from, len, result, capacity, names).prog;
    let w0 = p.word_to(layout, from, R8);
    let start = then(w0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(R8, R9, Succ(names));
    let w1 = then(start, Block([SubRR(R9, R8)]));
    let w2 = w1.word_to(layout, len, Rdx);
    let room = w2.clamp(Rdx, R9, Succ(Succ(names)));
    let w3 = then(room, Block([MovRI(Rsi, layout.buffer_at(buf)), AddRR(Rsi, R8), MovRI(Rax, BitVec::ofNat(1))]));
    let w4 = w3.word_to(layout, fd, Rdi);
    let asked = then(w4, Syscall);
    p.within_trans(w0, whole, p.within_word_to(layout, from, R8),
        w0.within_trans(w1, whole, Exists(6, refl),
            w1.within_trans(w2, whole, w1.within_word_to(layout, len, Rdx),
                w2.within_trans(w3, whole, Exists(5, refl),
                    w3.within_trans(w4, whole, w3.within_word_to(layout, fd, Rdi),
                        w4.within_trans(asked, whole, w4.within_then(0, Syscall), asked.within_word_from(layout, out, result, Rax)))))))
}

theorem Prog::within_args(self p: Prog, layout: Layout, out: List<Nat>, index, buf, len, capacity, names: Nat):
    p.Within(p.args(layout, out, index, buf, len, capacity, names).prog) {
    let whole = p.args(layout, out, index, buf, len, capacity, names).prog;
    let loaded = then(then(then(p, Block([MovRI(Rbx, layout.stack_at())])), Load(WordLoad(Rdx, Rbx))), Load(WordLoad(R9, Rdx)));
    let counted = loaded.word_to(layout, index, Rcx);
    let head = Succ(names);
    let past = Succ(Succ(Succ(head)));
    let after = Succ(past);
    let copied = then(then(counted, Block([CmpRR(Rcx, R9)])), Jcc(AE, past)).arg_pointer(layout, buf, capacity, head).arg_copy(head, Succ(Succ(head)), Succ(head));
    let found = then(then(copied.label(Succ(Succ(head))), Block([MovRR(Rax, R8)])), Jmp(after));
    let missing = then(found.label(past), Block([MovRI(Rax, missing_word())])).label(after);
    p.within_trans(loaded, whole, Exists(3, refl),
        loaded.within_trans(counted, whole, loaded.within_word_to(layout, index, Rcx),
            counted.within_trans(missing, whole, Exists(21, refl), missing.within_word_from(layout, out, len, Rax))))
}

theorem Prog::within_opens(self p: Prog, layout: Layout, out: List<Nat>, path, len, result, capacity, names: Nat):
    p.Within(p.opens(layout, out, path, len, result, capacity, names).prog) {
    let whole = p.opens(layout, out, path, len, result, capacity, names).prog;
    let r0 = p.word_to(layout, len, Rcx);
    let clamped = then(r0, Block([MovRI(R9, BitVec::ofNat(capacity))])).clamp(Rcx, R9, Succ(names));
    let copied = clamped.path_copy(layout, path, Succ(Succ(names)), Succ(Succ(Succ(names)))).label(Succ(Succ(Succ(names))));
    let ended = then(then(copied, Block([MovRI(Rdx, BitVec::ofNat(0))])), StoreByte(ByteStore(Rdi, Rdx)));
    let asking: List<Instruction> = [MovRI(Rax, BitVec::ofNat(257)), MovRI(Rdi, fdcwd_word()), MovRI(Rsi, layout.scratch_at()), MovRI(Rdx, BitVec::ofNat(0))];
    let asked = then(then(ended, Block(asking)), Syscall);
    p.within_trans(r0, whole, p.within_word_to(layout, len, Rcx),
        r0.within_trans(asked, whole, Exists(20, refl), asked.within_word_from(layout, out, result, Rax)))
}

theorem Prog::within_closes(self p: Prog, layout: Layout, out: List<Nat>, fd, result: Nat): p.Within(p.closes(layout, out, fd, result)) {
    let whole = p.closes(layout, out, fd, result);
    let c0 = then(p, Block([MovRI(Rax, BitVec::ofNat(3))]));
    let c1 = c0.word_to(layout, fd, Rdi);
    let asked = then(c1, Syscall);
    p.within_trans(c0, whole, p.within_then(0, Block([MovRI(Rax, BitVec::ofNat(3))])),
        c0.within_trans(c1, whole, c0.within_word_to(layout, fd, Rdi),
            c1.within_trans(asked, whole, c1.within_then(0, Syscall), asked.within_word_from(layout, out, result, Rax))))
}

// What a statement compiles to starts where it was given its start.
theorem Stmt::emit_extends(self s: Stmt, layout: Layout): (p: Prog) → (out: List<Nat>) → (names: Nat) → (c: Compiled) →
    s.emit(p, layout, out, names) = Some(c) → p.Within(c.prog) {
    match s {
        Compute(region) => match region {
            Dataflow(body) => λ p out names c emitted => p.within_computes(layout, out, body.nodes, names, c, emitted),
            Sequence(_, _) => λ p out names c none => absurd(none),
            Compose(_, _) => λ p out names c none => absurd(none),
            Conditional(_, _, _, _, _, _) => λ p out names c none => absurd(none),
            Call(_, _, _) => λ p out names c none => absurd(none),
            Loop(_, _, _, _, _, _, _, _, _) => λ p out names c none => absurd(none),
        },
        Invoke(shape) => λ p out names c => match shape {
            Reads(fd, buf, len, result) => match layout.words_fit([fd, len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(buf) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.reads(layout, out, fd, buf, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_reads(layout, out, fd, buf, len, result, capacity, names)),
                },
            },
            Writes(fd, buf, from, len, result) => match layout.words_fit([fd, from, len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(buf) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.writes(layout, out, fd, buf, from, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_writes(layout, out, fd, buf, from, len, result, capacity, names)),
                },
            },
            Opens(path, len, result) => match layout.words_fit([len, result]) {
                False => λ none => absurd(none),
                True => match layout.capacities.nth(path) {
                    None => λ none => absurd(none),
                    Some(capacity) => λ same => j(Option::some_inj(p.opens(layout, out, path, len, result, capacity, names), c, same),
                        λ x _ => p.Within(x.prog), p.within_opens(layout, out, path, len, result, capacity, names)),
                },
            },
            Closes(fd, result) => match layout.words_fit([fd, result]) {
                False => λ none => absurd(none),
                True => λ same => j(Option::some_inj(Compiled(p.closes(layout, out, fd, result), names), c, same),
                    λ x _ => p.Within(x.prog), p.within_closes(layout, out, fd, result)),
            },
            StatsPath(_, _, _, _) => λ none => absurd(none),
            StatsFd(_, _, _) => λ none => absurd(none),
        },
        Then(first, rest) => λ p out names c => (match first.emit(p, layout, rest.live_in(layout.homes, out), names) as λ o => first.emit(p, layout, rest.live_in(layout.homes, out), names) = o →
                (match o { None => None, Some(c1) => rest.emit(c1.prog, layout, out, c1.names) }) = Some(c) → p.Within(c.prog) {
            None => λ _ none => absurd(none),
            Some(c1) => λ one two => p.within_trans(c1.prog, c.prog, first.emit_extends(layout, p, rest.live_in(layout.homes, out), names, c1, one),
                rest.emit_extends(layout, c1.prog, out, c1.names, c, two)),
        })(refl),
        Branch(condition, yes, no) => λ p out names c => {
            let tested = p.tests(layout, condition, Succ(names));
            match layout.word_fits(condition) {
                False => λ none => absurd(none),
                True => (match yes.emit(tested, layout, out, Succ(Succ(names))) as λ o => yes.emit(tested, layout, out, Succ(Succ(names))) = o →
                        (match o {
                            None => None,
                            Some(y) => match no.emit(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, y.names) {
                                None => None,
                                Some(n) => Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)),
                            },
                        }) = Some(c) → p.Within(c.prog) {
                    None => λ _ none => absurd(none),
                    Some(y) => λ y_is => {
                        let other = y.prog.else_label(Succ(names), Succ(Succ(names)));
                        (match no.emit(other, layout, out, y.names) as λ o => no.emit(other, layout, out, y.names) = o →
                                (match o { None => None, Some(n) => Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)) }) = Some(c) →
                                p.Within(c.prog) {
                            None => λ _ none => absurd(none),
                            Some(n) => λ n_is same => j(Option::some_inj(Compiled(n.prog.join_label(Succ(Succ(names))), n.names), c, same),
                                λ x _ => p.Within(x.prog),
                                p.within_trans(tested, n.prog.join_label(Succ(Succ(names))), p.within_tests(layout, condition, Succ(names)),
                                    tested.within_trans(y.prog, n.prog.join_label(Succ(Succ(names))), yes.emit_extends(layout, tested, out, Succ(Succ(names)), y, y_is),
                                        y.prog.within_trans(other, n.prog.join_label(Succ(Succ(names))), Exists(2, refl),
                                            other.within_trans(n.prog, n.prog.join_label(Succ(Succ(names))), no.emit_extends(layout, other, out, y.names, n, n_is),
                                                n.prog.within_label(Succ(Succ(names)))))))),
                        })(refl)
                    },
                })(refl),
            }
        },
        Repeat(body, again) => λ p out names c => {
            let head = p.label(Succ(names));
            let inner = Repeat(body, again).loop_out(layout.homes, out);
            match layout.word_fits(again) {
                False => λ none => absurd(none),
                True => (match body.emit(head, layout, inner, Succ(Succ(names))) as λ o => body.emit(head, layout, inner, Succ(Succ(names))) = o →
                        (match o {
                            None => None,
                            Some(b) => Some(Compiled(then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)),
                        }) = Some(c) → p.Within(c.prog) {
                    None => λ _ none => absurd(none),
                    Some(b) => λ b_is same => {
                        let closed = then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names)));
                        j(Option::some_inj(Compiled(closed, b.names), c, same), λ x _ => p.Within(x.prog),
                            p.within_trans(head, closed, p.within_label(Succ(names)),
                                head.within_trans(b.prog, closed, body.emit_extends(layout, head, inner, Succ(Succ(names)), b, b_is),
                                    b.prog.within_trans(b.prog.tests(layout, again, Succ(Succ(names))), closed, b.prog.within_tests(layout, again, Succ(Succ(names))),
                                        Exists(2, refl)))))
                    },
                })(refl),
            }
        },
        Exit(status) => λ p out names c => match layout.word_fits(status) {
            False => λ none => absurd(none),
            True => λ same => j(Option::some_inj(Compiled(p.exits(layout, status), names), c, same), λ x _ => p.Within(x.prog),
                p.within_exits(layout, status)),
        },
        Arg(index, buf, len) => λ p out names c => match layout.words_fit([index, len]) {
            False => λ none => absurd(none),
            True => match layout.capacities.nth(buf) {
                None => λ none => absurd(none),
                Some(capacity) => λ same => j(Option::some_inj(p.args(layout, out, index, buf, len, capacity, names), c, same),
                    λ x _ => p.Within(x.prog), p.within_args(layout, out, index, buf, len, capacity, names)),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A statement's claim

// Every exit, with its status, meets the continuation's tree there.
fn Target::Exiting(self t: Target, k: Flow → ITree<BitVec(64)>(Events::linux())) → Type {
    (status: BitVec(64)) → (u: MachineState<X86Memory(t.r.profile)>) → LinuxSyscallAt(t.io(), u) → LinuxExits(u, status) →
        Sim(t.io(), k(Exited(status)), u)
}

// The code from `p` to `q` runs as the statement, then `k`: wherever `k`
// goes on from `q`, `out` live, with every environment the statement may
// finish in. The statement starts with what it needs live (`live_in`).
fn Target::Runs(self t: Target, s: Stmt, call: Answers(), out: List<Nat>, p, q: Prog) → Type {
    (n: Nat) → (env: Env) → (k: Flow → ITree<BitVec(64)>(Events::linux())) → t.Exiting(k) →
        ((after: Env) → t.At(prog_len(q), out, k(Onward(after)), after)) →
        t.At(prog_len(p), s.live_in(t.homes, out), ITree::bind(Events::linux(), s.denote(call, n, env), k), env)
}

// A tree the same as one the code runs as.
theorem Target::at_similar(self t: Target, at: Nat, live: List<Nat>, tree, other: ITree<BitVec(64)>(Events::linux()), env: Env,
    same: ITree::Same(Events::linux(), tree, other), goes: t.At(at, live, other, env)): t.At(at, live, tree, env) {
    t.site().goes_same(t.io(), at, tree, other, λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(live, env, s.gprs, s.memory), same, goes)
}

// Code that needs fewer words live runs where more are.
theorem Target::at_sub(self t: Target, at: Nat, live, wider: List<Nat>, tree: ITree<BitVec(64)>(Events::linux()), env: Env,
    sub: (i: Nat) → Mem(i, live) → Mem(i, wider), goes: t.At(at, live, tree, env)): t.At(at, wider, tree, env) {
    t.goes_weaken(at, tree, λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(live, env, s.gprs, s.memory),
        λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(wider, env, s.gprs, s.memory), goes,
        λ s held => t.held_sub(live, wider, env, s.gprs, s.memory, held, sub))
}

// A JMP to a label ahead or behind, the live words held.
theorem Target::at_jmp(self t: Target, before: Prog, n: Nat, within: then(before, Jmp(Succ(n))).Within(t.program),
    label: Prog, item: Asm, label_within: Prog::At(label, Succ(n), item).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    live: List<Nat>, env: Env, goes: t.At(prog_len(label), live, tree, env)): t.At(prog_len(before), live, tree, env) {
    t.io().goes_jmp(t.program, t.origin, t.code_fits(), within.witness, before, 0, Succ(n), within.proof, prog_len(label),
        t.program.lands_jmp(t.laid, within.witness, before, 0, n, within.proof, label_within.witness, label, item, label_within.proof),
        tree, λ (g: Gprs) (f: Flags) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m), goes)
}

// A loop of `m` more rounds over its set `set` (what is live at its head):
// the body from its head label, the test after it, a JMP back while the
// bit is set, and out past the loop's label when it is clear. The body
// runs with the bit, the set and what is live after the loop live after
// it (`loop_after`), and needs no more than the set before it (`closed`).
theorem Target::goes_repeat(self t: Target, body: Stmt, again: Nat, call: Answers(), n: Nat, p: Prog, names: Nat, b: Prog, out, set: List<Nat>,
    inside: again < t.words,
    within: then(b.tests(t.layout(), again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))).Within(t.program),
    head_within: p.label(Succ(names)).Within(t.program),
    closed: (i: Nat) → Mem(i, body.live_in(t.homes, loop_after(again, set, out))) → Mem(i, set),
    runs: t.Runs(body, call, loop_after(again, set, out), p.label(Succ(names)), b),
    k: Flow → ITree<BitVec(64)>(Events::linux()), exits: t.Exiting(k),
    next: (after: Env) → t.At(prog_len(then(b.tests(t.layout(), again, Succ(Succ(names))), Jmp(Succ(names)))), out, k(Onward(after)), after),
    m: Nat): (env: Env) → t.At(prog_len(p), set, ITree::bind(Events::linux(),
        ITree::iter(Events::linux(), m, λ e => ITree::map(Events::linux(), body.denote(call, n, e), λ flow => flow.pass(again)), env), k), env) {
    let f = λ (e: Env) => ITree::map(Events::linux(), body.denote(call, n, e), λ (flow: Flow) => flow.pass(again));
    let tested = b.tests(t.layout(), again, Succ(Succ(names)));
    let jumped = then(tested, Jmp(Succ(names)));
    let w_jumped = jumped.within_before(Succ(Succ(names)), Block([]), t.program, within);
    let w_tested = tested.within_before(0, Jmp(Succ(names)), t.program, w_jumped);
    let after_set = loop_after(again, set, out);
    let widen = λ (i: Nat) (m2: Mem(i, set)) => { let w: Mem(i, after_set) = Inr(set.union_left(out, i, m2)); w };
    let outer = λ (i: Nat) (m2: Mem(i, out)) => { let w: Mem(i, after_set) = Inr(set.union_right(out, i, m2)); w };
    match m {
        Zero => λ env => λ s here resident held => sim_cut(t.io(), s),
        Succ(m2) => λ env => {
            let rest = λ (x: Step<Env, Flow>) => match x as λ _ => ITree<Flow>(Events::linux()) {
                Continue(a2) => Tau(ITree::iter(Events::linux(), m2, f, a2)),
                Break(done) => Ret(done),
            };
            let after_pass = λ (x: Step<Env, Flow>) => ITree::bind(Events::linux(), rest(x), k);
            let k2 = λ (flow: Flow) => after_pass(flow.pass(again));
            let d = body.denote(call, n, env);
            let same = ITree::same_trans(Events::linux(),
                ITree::bind(Events::linux(), ITree::bind(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), rest), k),
                ITree::bind(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), after_pass),
                ITree::bind(Events::linux(), d, k2),
                ITree::bind_assoc(Events::linux(), ITree::map(Events::linux(), d, λ (flow: Flow) => flow.pass(again)), rest, k),
                ITree::bind_assoc(Events::linux(), d, λ (flow: Flow) => Ret(flow.pass(again)), after_pass));
            let looped = λ (after: Env) => t.goes_tests(after_set, after, b, again, Succ(names), inside, Inl(refl), w_tested, within.witness, jumped, Block([]), within.proof,
                k2(Onward(after)),
                λ (bit_set: after.bit(again) = True) => j(sym(bit_set), λ bit _ => t.At(prog_len(tested), after_set,
                        after_pass(match bit { True => Continue(after), False => Break(Onward(after)) }), after),
                    t.at_jmp(tested, names, w_jumped, p, Block([]), head_within, Tau(ITree::bind(Events::linux(), ITree::iter(Events::linux(), m2, f, after), k)),
                        after_set, after,
                        λ s here resident held => sim_tau(t.io(), ITree::bind(Events::linux(), ITree::iter(Events::linux(), m2, f, after), k), s,
                            t.goes_repeat(body, again, call, n, p, names, b, out, set, inside, within, head_within, closed, runs, k, exits, next, m2, after,
                                s, here, resident, t.held_sub(set, after_set, after, s.gprs, s.memory, held, widen))))),
                λ (clear: after.bit(again) = False) => j(sym(clear), λ bit _ => t.At(prog_len(jumped), after_set,
                        after_pass(match bit { True => Continue(after), False => Break(Onward(after)) }), after),
                    t.at_sub(prog_len(jumped), out, after_set, k(Onward(after)), after, outer, next(after))));
            t.at_similar(prog_len(p), set, ITree::bind(Events::linux(), ITree::iter(Events::linux(), Succ(m2), f, env), k), ITree::bind(Events::linux(), d, k2), env,
                same, t.at_sub(prog_len(p), body.live_in(t.homes, after_set), set, ITree::bind(Events::linux(), d, k2), env, closed, runs(n, env, k2, exits, looped)))
        },
    }
}

// ---------------------------------------------------------------------------
// Every statement compiled runs as its tree

theorem Stmt::emit_runs(self s: Stmt, t: Target, call: Answers()): (p: Prog) → (out: List<Nat>) → (names: Nat) → (c: Compiled) →
    s.emit(p, t.layout(), out, names) = Some(c) → c.prog.Within(t.program) → s.checks(t.homes, out).IsTrue() → t.Runs(s, call, out, p, c.prog) {
    let layout = t.layout();
    match s {
        Compute(region) => match region {
            Dataflow(body) => λ p out names c emitted within checked n env k exits next => t.goes_computes(out, env, p, body.nodes, names, c, emitted, within,
                k(Onward(env.compute(call, Dataflow(body)))), checked, next(env.compute(call, Dataflow(body)))),
            Sequence(_, _) => λ p out names c none => absurd(none),
            Compose(_, _) => λ p out names c none => absurd(none),
            Conditional(_, _, _, _, _, _) => λ p out names c none => absurd(none),
            Call(_, _, _) => λ p out names c none => absurd(none),
            Loop(_, _, _, _, _, _, _, _, _) => λ p out names c none => absurd(none),
        },
        Invoke(shape) => λ p out names c => match shape {
            Reads(fd, buf, len, result) => (match layout.words_fit([fd, len, result]) as λ b => layout.words_fit([fd, len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.reads(layout, out, fd, buf, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Reads(fd, buf, len, result)), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(len) && (layout.word_fits(result) && True), j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, ok.right);
                    let ok3 = Bool::is_true_and(layout.word_fits(result), True, ok2.right);
                    (match t.caps.nth(buf) as λ o => t.caps.nth(buf) = o →
                            (match o { None => None, Some(capacity) => Some(p.reads(layout, out, fd, buf, len, result, capacity, names)) }) = Some(c) →
                            c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Reads(fd, buf, len, result)), call, out, p, c.prog) {
                        None => λ _ none => absurd(none),
                        Some(capacity) => λ found same => j(Option::some_inj(p.reads(layout, out, fd, buf, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Reads(fd, buf, len, result)), call, out, p, x.prog),
                            λ within apart n env k exits next => t.goes_reads(out, env, p, fd, buf, len, result, capacity, names,
                                layout.word_inside(fd, ok.left), layout.word_inside(len, ok2.left), layout.word_inside(result, ok3.left), found, apart, within,
                                λ a => k(Onward(Reads(fd, buf, len, result).answer(env, a))),
                                λ a answers => next(Reads(fd, buf, len, result).answer(env, a)))),
                    })(refl)
                },
            })(refl),
            Writes(fd, buf, from, len, result) => (match layout.words_fit([fd, from, len, result]) as λ b => layout.words_fit([fd, from, len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.writes(layout, out, fd, buf, from, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Writes(fd, buf, from, len, result)), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(from) && (layout.word_fits(len) && (layout.word_fits(result) && True)),
                        j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(from), layout.word_fits(len) && (layout.word_fits(result) && True), ok.right);
                    let ok3 = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, ok2.right);
                    let ok4 = Bool::is_true_and(layout.word_fits(result), True, ok3.right);
                    (match t.caps.nth(buf) as λ o => t.caps.nth(buf) = o →
                            (match o { None => None, Some(capacity) => Some(p.writes(layout, out, fd, buf, from, len, result, capacity, names)) }) = Some(c) →
                            c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Writes(fd, buf, from, len, result)), call, out, p, c.prog) {
                        None => λ _ none => absurd(none),
                        Some(capacity) => λ found same => j(Option::some_inj(p.writes(layout, out, fd, buf, from, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Writes(fd, buf, from, len, result)), call, out, p, x.prog),
                            λ within apart n env k exits next => t.goes_writes(out, env, p, fd, buf, from, len, result, capacity, names,
                                layout.word_inside(fd, ok.left), layout.word_inside(from, ok2.left), layout.word_inside(len, ok3.left),
                                layout.word_inside(result, ok4.left), found, apart, within,
                                λ a => k(Onward(Writes(fd, buf, from, len, result).answer(env, a))),
                                λ a answers => next(Writes(fd, buf, from, len, result).answer(env, a)))),
                    })(refl)
                },
            })(refl),
            Opens(path, len, result) => (match layout.words_fit([len, result]) as λ b => layout.words_fit([len, result]) = b → (match b {
                    False => None,
                    True => match layout.capacities.nth(path) { None => None, Some(capacity) => Some(p.opens(layout, out, path, len, result, capacity, names)) },
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Opens(path, len, result)), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => {
                    let ok = Bool::is_true_and(layout.word_fits(len), layout.word_fits(result) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(result), True, ok.right);
                    (match t.caps.nth(path) as λ o => t.caps.nth(path) = o →
                            (match o { None => None, Some(capacity) => Some(p.opens(layout, out, path, len, result, capacity, names)) }) = Some(c) →
                            c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Opens(path, len, result)), call, out, p, c.prog) {
                        None => λ _ none => absurd(none),
                        Some(capacity) => λ found same => j(Option::some_inj(p.opens(layout, out, path, len, result, capacity, names), c, same),
                            λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Opens(path, len, result)), call, out, p, x.prog),
                            λ within apart n env k exits next => t.goes_opens(out, env, p, path, len, result, capacity, names,
                                layout.word_inside(len, ok.left), layout.word_inside(result, ok2.left), found, apart, within,
                                λ a => k(Onward(Opens(path, len, result).answer(env, a))),
                                λ a answers => next(Opens(path, len, result).answer(env, a)))),
                    })(refl)
                },
            })(refl),
            Closes(fd, result) => (match layout.words_fit([fd, result]) as λ b => layout.words_fit([fd, result]) = b → (match b {
                    False => None,
                    True => Some(Compiled(p.closes(layout, out, fd, result), names)),
                }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Closes(fd, result)), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit same => {
                    let ok = Bool::is_true_and(layout.word_fits(fd), layout.word_fits(result) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                    let ok2 = Bool::is_true_and(layout.word_fits(result), True, ok.right);
                    j(Option::some_inj(Compiled(p.closes(layout, out, fd, result), names), c, same),
                        λ x _ => x.prog.Within(t.program) → t.homes.apart(result, out).IsTrue() → t.Runs(Invoke(Closes(fd, result)), call, out, p, x.prog),
                        λ within apart n env k exits next => t.goes_closes(out, env, p, fd, result, layout.word_inside(fd, ok.left), layout.word_inside(result, ok2.left),
                            apart, within,
                            λ a => k(Onward(Closes(fd, result).answer(env, a))),
                            λ a answers => next(Closes(fd, result).answer(env, a))))
                },
            })(refl),
            StatsPath(_, _, _, _) => λ none => absurd(none),
            StatsFd(_, _, _) => λ none => absurd(none),
        },
        Then(first, rest) => λ p out names c => (match first.emit(p, layout, rest.live_in(t.homes, out), names) as λ o => first.emit(p, layout, rest.live_in(t.homes, out), names) = o →
                (match o { None => None, Some(c1) => rest.emit(c1.prog, layout, out, c1.names) }) = Some(c) → c.prog.Within(t.program) →
                Then(first, rest).checks(t.homes, out).IsTrue() → t.Runs(Then(first, rest), call, out, p, c.prog) {
            None => λ _ none => absurd(none),
            Some(c1) => λ one two within checked => {
                let ok = Bool::is_true_and(first.checks(t.homes, rest.live_in(t.homes, out)), rest.checks(t.homes, out), checked);
                let w_first = c1.prog.within_trans(c.prog, t.program, rest.emit_extends(layout, c1.prog, out, c1.names, c, two), within);
                let run_first = first.emit_runs(t, call, p, rest.live_in(t.homes, out), names, c1, one, w_first, ok.left);
                let run_rest = rest.emit_runs(t, call, c1.prog, out, c1.names, c, two, within, ok.right);
                λ n env k exits next => {
                    let h = λ (flow: Flow) => match flow as λ _ => ITree<Flow>(Events::linux()) {
                        Onward(after) => rest.denote(call, n, after),
                        Exited(status) => Ret(Exited(status)),
                    };
                    let k2 = λ (flow: Flow) => ITree::bind(Events::linux(), h(flow), k);
                    t.at_similar(prog_len(p), first.live_in(t.homes, rest.live_in(t.homes, out)), ITree::bind(Events::linux(), ITree::bind(Events::linux(), first.denote(call, n, env), h), k),
                        ITree::bind(Events::linux(), first.denote(call, n, env), k2), env,
                        ITree::bind_assoc(Events::linux(), first.denote(call, n, env), h, k),
                        run_first(n, env, k2, exits, λ after => run_rest(n, after, k, exits, next)))
                }
            },
        })(refl),
        Branch(condition, yes, no) => λ p out names c => {
            let tested = p.tests(layout, condition, Succ(names));
            (match layout.word_fits(condition) as λ b => layout.word_fits(condition) = b → (match b {
                    False => None,
                    True => match yes.emit(tested, layout, out, Succ(Succ(names))) {
                        None => None,
                        Some(y) => match no.emit(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, y.names) {
                            None => None,
                            Some(n) => Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)),
                        },
                    },
                }) = Some(c) → c.prog.Within(t.program) → Branch(condition, yes, no).checks(t.homes, out).IsTrue() →
                t.Runs(Branch(condition, yes, no), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => (match yes.emit(tested, layout, out, Succ(Succ(names))) as λ o => yes.emit(tested, layout, out, Succ(Succ(names))) = o →
                        (match o {
                            None => None,
                            Some(y) => match no.emit(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, y.names) {
                                None => None,
                                Some(n) => Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)),
                            },
                        }) = Some(c) → c.prog.Within(t.program) → Branch(condition, yes, no).checks(t.homes, out).IsTrue() →
                        t.Runs(Branch(condition, yes, no), call, out, p, c.prog) {
                    None => λ _ none => absurd(none),
                    Some(y) => λ y_is => {
                        let other = y.prog.else_label(Succ(names), Succ(Succ(names)));
                        (match no.emit(other, layout, out, y.names) as λ o => no.emit(other, layout, out, y.names) = o →
                                (match o { None => None, Some(n) => Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)) }) = Some(c) →
                                c.prog.Within(t.program) → Branch(condition, yes, no).checks(t.homes, out).IsTrue() →
                                t.Runs(Branch(condition, yes, no), call, out, p, c.prog) {
                            None => λ _ none => absurd(none),
                            Some(nc) => λ n_is same => j(Option::some_inj(Compiled(nc.prog.join_label(Succ(Succ(names))), nc.names), c, same),
                                λ x _ => x.prog.Within(t.program) → Branch(condition, yes, no).checks(t.homes, out).IsTrue() →
                                    t.Runs(Branch(condition, yes, no), call, out, p, x.prog),
                                λ within checked => {
                                    let ok = Bool::is_true_and(yes.checks(t.homes, out), no.checks(t.homes, out), checked);
                                    let jumped = then(y.prog, Jmp(Succ(Succ(names))));
                                    let w_no = nc.prog.within_before(Succ(Succ(names)), Block([]), t.program, within);
                                    let w_other = other.within_trans(nc.prog, t.program, no.emit_extends(layout, other, out, y.names, nc, n_is), w_no);
                                    let w_jumped = jumped.within_before(Succ(names), Block([]), t.program, w_other);
                                    let w_yes = y.prog.within_before(0, Jmp(Succ(Succ(names))), t.program, w_jumped);
                                    let w_tested = tested.within_trans(y.prog, t.program, yes.emit_extends(layout, tested, out, Succ(Succ(names)), y, y_is), w_yes);
                                    let run_yes = yes.emit_runs(t, call, tested, out, Succ(Succ(names)), y, y_is, w_yes, ok.left);
                                    let run_no = no.emit_runs(t, call, other, out, y.names, nc, n_is, w_no, ok.right);
                                    let inside = layout.word_inside(condition, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                                    let arms = yes.live_in(t.homes, out).union(no.live_in(t.homes, out));
                                    let live = Cons(condition, arms);
                                    λ n env k exits next => t.goes_tests(live, env, p, condition, names, inside, Inl(refl), w_tested, w_other.witness, jumped, Block([]), w_other.proof,
                                        ITree::bind(Events::linux(), match env.bit(condition) as λ _ => ITree<Flow>(Events::linux()) {
                                            True => yes.denote(call, n, env),
                                            False => no.denote(call, n, env),
                                        }, k),
                                        λ (set: env.bit(condition) = True) => j(sym(set), λ bit _ => t.At(prog_len(tested), live,
                                                ITree::bind(Events::linux(), match bit as λ _ => ITree<Flow>(Events::linux()) {
                                                    True => yes.denote(call, n, env),
                                                    False => no.denote(call, n, env),
                                                }, k), env),
                                            t.at_sub(prog_len(tested), yes.live_in(t.homes, out), live, ITree::bind(Events::linux(), yes.denote(call, n, env), k), env,
                                                λ i m => Inr(yes.live_in(t.homes, out).union_left(no.live_in(t.homes, out), i, m)),
                                                run_yes(n, env, k, exits, λ after => t.at_jmp(y.prog, Succ(names), w_jumped, nc.prog, Block([]), within,
                                                    k(Onward(after)), out, after, next(after))))),
                                        λ (clear: env.bit(condition) = False) => j(sym(clear), λ bit _ => t.At(prog_len(jumped), live,
                                                ITree::bind(Events::linux(), match bit as λ _ => ITree<Flow>(Events::linux()) {
                                                    True => yes.denote(call, n, env),
                                                    False => no.denote(call, n, env),
                                                }, k), env),
                                            t.at_sub(prog_len(jumped), no.live_in(t.homes, out), live, ITree::bind(Events::linux(), no.denote(call, n, env), k), env,
                                                λ i m => Inr(yes.live_in(t.homes, out).union_right(no.live_in(t.homes, out), i, m)),
                                                run_no(n, env, k, exits, next))))
                                }),
                        })(refl)
                    },
                })(refl),
            })(refl)
        },
        Repeat(body, again) => λ p out names c => {
            let head = p.label(Succ(names));
            let inner = Repeat(body, again).loop_out(t.homes, out);
            (match layout.word_fits(again) as λ b => layout.word_fits(again) = b → (match b {
                    False => None,
                    True => match body.emit(head, layout, inner, Succ(Succ(names))) {
                        None => None,
                        Some(b) => Some(Compiled(then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)),
                    },
                }) = Some(c) → c.prog.Within(t.program) → Repeat(body, again).checks(t.homes, out).IsTrue() →
                t.Runs(Repeat(body, again), call, out, p, c.prog) {
                False => λ _ none => absurd(none),
                True => λ fit => (match body.emit(head, layout, inner, Succ(Succ(names))) as λ o => body.emit(head, layout, inner, Succ(Succ(names))) = o →
                        (match o {
                            None => None,
                            Some(b) => Some(Compiled(then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)),
                        }) = Some(c) → c.prog.Within(t.program) → Repeat(body, again).checks(t.homes, out).IsTrue() →
                        t.Runs(Repeat(body, again), call, out, p, c.prog) {
                    None => λ _ none => absurd(none),
                    Some(cb) => λ b_is same => {
                        let tested = cb.prog.tests(layout, again, Succ(Succ(names)));
                        let closed = then(tested, Jmp(Succ(names))).label(Succ(Succ(names)));
                        j(Option::some_inj(Compiled(closed, cb.names), c, same),
                            λ x _ => x.prog.Within(t.program) → Repeat(body, again).checks(t.homes, out).IsTrue() → t.Runs(Repeat(body, again), call, out, p, x.prog),
                            λ within checked => {
                                let set = Repeat(body, again).live_in(t.homes, out);
                                let ok = Bool::is_true_and(body.live_in(t.homes, loop_after(again, set, out)).within(set), body.checks(t.homes, loop_after(again, set, out)), checked);
                                let w_jumped = then(tested, Jmp(Succ(names))).within_before(Succ(Succ(names)), Block([]), t.program, within);
                                let w_tested = tested.within_before(0, Jmp(Succ(names)), t.program, w_jumped);
                                let w_body = cb.prog.within_trans(tested, t.program, cb.prog.within_tests(layout, again, Succ(Succ(names))), w_tested);
                                let w_head = head.within_trans(cb.prog, t.program, body.emit_extends(layout, head, inner, Succ(Succ(names)), cb, b_is), w_body);
                                let runs = body.emit_runs(t, call, head, inner, Succ(Succ(names)), cb, b_is, w_body, ok.right);
                                let inside = layout.word_inside(again, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                                λ n env k exits next => t.goes_repeat(body, again, call, n, p, names, cb.prog, out, set, inside, within, w_head,
                                    body.live_in(t.homes, loop_after(again, set, out)).within_mem(set, ok.left), runs, k, exits, next, n, env)
                            })
                    },
                })(refl),
            })(refl)
        },
        Exit(status) => λ p out names c => (match layout.word_fits(status) as λ b => layout.word_fits(status) = b →
                (match b { False => None, True => Some(Compiled(p.exits(layout, status), names)) }) = Some(c) → c.prog.Within(t.program) →
                Exit(status).checks(t.homes, out).IsTrue() → t.Runs(Exit(status), call, out, p, c.prog) {
            False => λ _ none => absurd(none),
            True => λ fit same => j(Option::some_inj(Compiled(p.exits(layout, status), names), c, same),
                λ x _ => x.prog.Within(t.program) → Exit(status).checks(t.homes, out).IsTrue() → t.Runs(Exit(status), call, out, p, x.prog),
                λ within _ n env k exits next => t.goes_exits([status], env, p, status, layout.word_inside(status, j(sym(fit), λ v _ => v.IsTrue(), trivial)), Inl(refl),
                    within, k(Exited(env.word(status))), λ u at exited => exits(env.word(status), u, at, exited))),
        })(refl),
        Arg(index, buf, len) => λ p out names c => (match layout.words_fit([index, len]) as λ b => layout.words_fit([index, len]) = b → (match b {
                False => None,
                True => match layout.capacities.nth(buf) { None => None, Some(capacity) => Some(p.args(layout, out, index, buf, len, capacity, names)) },
            }) = Some(c) → c.prog.Within(t.program) → t.homes.apart(len, out).IsTrue() → t.Runs(Arg(index, buf, len), call, out, p, c.prog) {
            False => λ _ none => absurd(none),
            True => λ fit => {
                let ok = Bool::is_true_and(layout.word_fits(index), layout.word_fits(len) && True, j(sym(fit), λ v _ => v.IsTrue(), trivial));
                let ok2 = Bool::is_true_and(layout.word_fits(len), True, ok.right);
                (match t.caps.nth(buf) as λ o => t.caps.nth(buf) = o →
                        (match o { None => None, Some(capacity) => Some(p.args(layout, out, index, buf, len, capacity, names)) }) = Some(c) →
                        c.prog.Within(t.program) → t.homes.apart(len, out).IsTrue() → t.Runs(Arg(index, buf, len), call, out, p, c.prog) {
                    None => λ _ none => absurd(none),
                    Some(capacity) => λ found same => j(Option::some_inj(p.args(layout, out, index, buf, len, capacity, names), c, same),
                        λ x _ => x.prog.Within(t.program) → t.homes.apart(len, out).IsTrue() → t.Runs(Arg(index, buf, len), call, out, p, x.prog),
                        λ within apart n env k exits next => t.goes_args(live_before([index], len, out), out, env, p, index, buf, len, capacity, names,
                            layout.word_inside(index, ok.left), layout.word_inside(len, ok2.left), live_before_reads([index], len, out, index, Inl(refl)),
                            λ i m ne => live_before_keeps([index], len, out, i, m, ne), apart, found, within,
                            k(Onward(env.arg(env.number(index), buf, len))), next(env.arg(env.number(index), buf, len)))),
                })(refl)
            },
        })(refl),
    }
}

// ---------------------------------------------------------------------------
// The program

// What `compile` builds is laid out: read off the check it made, so a
// client need not evaluate it again.
theorem Source::compile_laid(self src: Source, low: BitVec(64), homes: Homes, program: Prog, compiled: src.compile(low, homes) = Some(program)):
    program.laid_out().IsTrue() {
    let emitted = src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0);
    (match src.allocation_ok(homes) as λ a => (match a {
            False => None,
            True => match emitted { None => None, Some(c) => c.prog.finish() },
        }) = Some(program) → program.laid_out().IsTrue() {
        False => λ none => absurd(none),
        True => (match emitted as λ o => (match o { None => None, Some(c) => c.prog.finish() }) = Some(program) → program.laid_out().IsTrue() {
            None => λ none => absurd(none),
            Some(c) => {
                let whole = then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
                (match whole.laid_out() as λ b => whole.laid_out() = b →
                        (match b { False => None, True => Some(whole) }) = Some(program) → program.laid_out().IsTrue() {
                    False => λ _ none => absurd(none),
                    True => λ laid same => j(Option::some_inj(whole, program, same), λ x _ => x.laid_out().IsTrue(), j(sym(laid), λ b _ => b.IsTrue(), trivial)),
                })(refl)
            },
        }),
    })(compiled)
}

// The converse, for a reader that has the program: homes that pass the
// check, and an emission that finishes as `program`, laid out, are the
// compile. `heather write-elf` proves the compile this way, the check and
// the emission by evaluation and the layout a stretch at a time, since all
// at once overrun one declaration's fuel.
theorem Source::compile_of(self src: Source, low: BitVec(64), homes: Homes, program: Prog, allocated: src.allocation_ok(homes).IsTrue(),
    emitted: src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0).map(λ (c: Compiled) => then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall)) = Some(program),
    laid: program.laid_out().IsTrue()):
    src.compile(low, homes) = Some(program) {
    let finished = j(sym(eq_true_of_is_true(program.laid_out(), laid)),
        λ b _ => (match b as λ _ => Option<Prog> { False => None, True => Some(program) }) = Some(program), refl);
    let ran = (match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) as λ o =>
            o.map(λ (c: Compiled) => then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall)) = Some(program) →
            (match o { None => None, Some(c) => c.prog.finish() }) = Some(program) {
        None => λ none => absurd(none),
        Some(c) => λ same => {
            let whole = then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
            j(sym(Option::some_inj(whole, program, same)),
                λ x _ => (match x.laid_out() as λ _ => Option<Prog> { False => None, True => Some(x) }) = Some(program), finished)
        },
    })(emitted);
    j(sym(eq_true_of_is_true(src.allocation_ok(homes), allocated)), λ a _ => (match a as λ _ => Option<Prog> {
            False => None,
            True => match src.main.emit(src.entry(low, homes), src.layout(low, homes), [], 0) { None => None, Some(c) => c.prog.finish() },
        }) = Some(program), ran)
}

// A statement's emission from its parts', so a reader can state a long
// program's a piece at a time (`heather write-elf`): one declaration per
// leaf, or per part small enough to evaluate whole, and these to join them.
// Each names its parts by position (`Stmt::left`, `right`, `word`), so no
// statement spells a part of the tree it does not evaluate; what is live
// after a part is the parent's `out` but for a `Then`'s first part
// (`right().live_in(homes, out)`) and a loop's body (`loop_out(homes, out)`).
theorem Stmt::emit_then_of(self s: Stmt, is: s.is_then().IsTrue(), p: Prog, layout: Layout, out: List<Nat>, names: Nat, c: Compiled,
    left: s.left().emit(p, layout, s.right().live_in(layout.homes, out), names) = Some(c)): s.emit(p, layout, out, names) = s.right().emit(c.prog, layout, out, c.names) {
    (match s as λ t => t.is_then().IsTrue() → t.left().emit(p, layout, t.right().live_in(layout.homes, out), names) = Some(c) →
            t.emit(p, layout, out, names) = t.right().emit(c.prog, layout, out, c.names) {
        Then(_, rest) => λ _ h => j(sym(h), λ o _ => (match o as λ _ => Option<Compiled> { None => None, Some(d) => rest.emit(d.prog, layout, out, d.names) })
            = rest.emit(c.prog, layout, out, c.names), refl),
        Compute(_) => λ no _ => false_elim(no),
        Invoke(_) => λ no _ => false_elim(no),
        Branch(_, _, _) => λ no _ => false_elim(no),
        Repeat(_, _) => λ no _ => false_elim(no),
        Exit(_) => λ no _ => false_elim(no),
        Arg(_, _, _) => λ no _ => false_elim(no),
    })(is, left)
}

theorem Stmt::emit_repeat_of(self s: Stmt, is: s.is_repeat().IsTrue(), p: Prog, layout: Layout, fits: layout.word_fits(s.word()).IsTrue(), out: List<Nat>, names: Nat,
    b: Compiled, body: s.left().emit(p.label(Succ(names)), layout, s.loop_out(layout.homes, out), Succ(Succ(names))) = Some(b)):
    s.emit(p, layout, out, names) = Some(Compiled(then(b.prog.tests(layout, s.word(), Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)) {
    (match s as λ t => t.is_repeat().IsTrue() → layout.word_fits(t.word()).IsTrue() → t.left().emit(p.label(Succ(names)), layout, t.loop_out(layout.homes, out), Succ(Succ(names))) = Some(b) →
            t.emit(p, layout, out, names) = Some(Compiled(then(b.prog.tests(layout, t.word(), Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names)) {
        Repeat(inner, again) => λ _ f h => {
            let closed = Some(Compiled(then(b.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), b.names));
            let ran = j(sym(h), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(d) => Some(Compiled(then(d.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), d.names)),
                }) = closed, refl);
            j(sym(eq_true_of_is_true(layout.word_fits(again), f)), λ w _ => (match w as λ _ => Option<Compiled> {
                    False => None,
                    True => match inner.emit(p.label(Succ(names)), layout, Repeat(inner, again).loop_out(layout.homes, out), Succ(Succ(names))) {
                        None => None,
                        Some(d) => Some(Compiled(then(d.prog.tests(layout, again, Succ(Succ(names))), Jmp(Succ(names))).label(Succ(Succ(names))), d.names)),
                    },
                }) = closed, ran)
        },
        Compute(_) => λ no _ _ => false_elim(no),
        Invoke(_) => λ no _ _ => false_elim(no),
        Then(_, _) => λ no _ _ => false_elim(no),
        Branch(_, _, _) => λ no _ _ => false_elim(no),
        Exit(_) => λ no _ _ => false_elim(no),
        Arg(_, _, _) => λ no _ _ => false_elim(no),
    })(is, fits, body)
}

theorem Stmt::emit_branch_of(self s: Stmt, is: s.is_branch().IsTrue(), p: Prog, layout: Layout, fits: layout.word_fits(s.word()).IsTrue(), out: List<Nat>, names: Nat,
    y, n: Compiled, yes: s.left().emit(p.tests(layout, s.word(), Succ(names)), layout, out, Succ(Succ(names))) = Some(y),
    no: s.right().emit(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, y.names) = Some(n)):
    s.emit(p, layout, out, names) = Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)) {
    (match s as λ t => t.is_branch().IsTrue() → layout.word_fits(t.word()).IsTrue() →
            t.left().emit(p.tests(layout, t.word(), Succ(names)), layout, out, Succ(Succ(names))) = Some(y) →
            t.right().emit(y.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, y.names) = Some(n) →
            t.emit(p, layout, out, names) = Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names)) {
        Branch(condition, first, second) => λ _ f hy hn => {
            let joined = Some(Compiled(n.prog.join_label(Succ(Succ(names))), n.names));
            let second_ran = j(sym(hn), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                }) = joined, refl);
            let first_ran = j(sym(hy), λ o _ => (match o as λ _ => Option<Compiled> {
                    None => None,
                    Some(d) => match second.emit(d.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, d.names) {
                        None => None,
                        Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                    },
                }) = joined, second_ran);
            j(sym(eq_true_of_is_true(layout.word_fits(condition), f)), λ w _ => (match w as λ _ => Option<Compiled> {
                    False => None,
                    True => match first.emit(p.tests(layout, condition, Succ(names)), layout, out, Succ(Succ(names))) {
                        None => None,
                        Some(d) => match second.emit(d.prog.else_label(Succ(names), Succ(Succ(names))), layout, out, d.names) {
                            None => None,
                            Some(e) => Some(Compiled(e.prog.join_label(Succ(Succ(names))), e.names)),
                        },
                    },
                }) = joined, first_ran)
        },
        Compute(_) => λ no _ _ _ => false_elim(no),
        Invoke(_) => λ no _ _ _ => false_elim(no),
        Then(_, _) => λ no _ _ _ => false_elim(no),
        Repeat(_, _) => λ no _ _ _ => false_elim(no),
        Exit(_) => λ no _ _ _ => false_elim(no),
        Arg(_, _, _) => λ no _ _ _ => false_elim(no),
    })(is, fits, yes, no)
}

// The compiled program, from its first byte with its code resident, its
// region zero and the command line `args` at RSP above the region,
// simulates the source run with `args` at every fuel, whatever homes the
// compile was given: it checked them (`Source::allocation_ok`).
theorem native_compile_correct(src: Source, r: DataRegion, homes: Homes, fits: Layout::of(r.low, src.words, src.capacities(), homes).size() <= r.size, program: Prog,
    compiled: src.compile(r.low, homes) = Some(program), origin: BitVec(64), s: MachineState<X86Memory(r.profile)>,
    here: s.rip = next_rip(origin, 0), resident: r.profile.linux().site(program, origin).Resident(s.memory),
    zero: r.Holds(λ _ => zero_byte(), s.memory), args: List<List<BitVec(8)>>,
    argv: ArgvAt(r.profile.data().above(r.low.toNat() + r.size), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimProgram(r.profile.linux(), src.denote(args), s) {
    let call = program_eval(src.functions);
    let layout = src.layout(r.low, homes);
    let entry = src.entry(r.low, homes);
    (match src.allocation_ok(homes) as λ a => src.allocation_ok(homes) = a → (match a {
            False => None,
            True => match src.main.emit(entry, layout, [], 0) { None => None, Some(c) => c.prog.finish() },
        }) = Some(program) → SimProgram(r.profile.linux(), src.denote(args), s) {
        False => λ _ none => absurd(none),
        True => λ allocated => {
            let ok = src.allocation_sound(homes, j(sym(allocated), λ v _ => v.IsTrue(), trivial));
            let ok2 = ok.right;
            (match src.main.emit(entry, layout, [], 0) as λ o => src.main.emit(entry, layout, [], 0) = o →
                    (match o { None => None, Some(c) => c.prog.finish() }) = Some(program) → SimProgram(r.profile.linux(), src.denote(args), s) {
                None => λ _ none => absurd(none),
                Some(c) => λ emitted => {
                    let whole = then(then(c.prog, Block([MovRI(Rdi, BitVec::ofNat(0)), MovRI(Rax, BitVec::ofNat(60))])), Syscall);
                    (match whole.laid_out() as λ b => whole.laid_out() = b →
                            (match b { False => None, True => Some(whole) }) = Some(program) → SimProgram(r.profile.linux(), src.denote(args), s) {
                        False => λ _ none => absurd(none),
                        True => λ laid same => (j(Option::some_inj(whole, program, same),
                            λ x _ => r.profile.linux().site(x, origin).Resident(s.memory) → SimProgram(r.profile.linux(), src.denote(args), s),
                            λ at_whole => {
                                let t = Target(r, src.words, src.capacities(), homes, ok.left, fits, whole, origin, j(sym(laid), λ b _ => b.IsTrue(), trivial), args);
                                let live = src.main.live_in(homes, []);
                                let saved = Start.saves_rsp(layout);
                                let runs = src.main.emit_runs(t, call, entry, [], 0, c, emitted, Exists(2, refl), ok2.right);
                                let w_entry = entry.within_trans(c.prog, whole, src.main.emit_extends(layout, entry, [], 0, c, emitted), Exists(2, refl));
                                let w_saved = saved.within_trans(entry, whole, Prog::within_inits(layout, src.buffers, 0, saved), w_entry);
                                let caps = λ (k: Nat) => {
                                    let shifted: (0 + k = k) = omega();
                                    cong_fn<Nat, Option<Nat>>(λ x => t.caps.nth(x), shifted)
                                };
                                let exits: t.Exiting(λ (flow: Flow) => Ret(flow.status())) = λ status u at exited =>
                                    sim_ret(t.io(), status, u, u, Exists(Zero, refl), at, exited);
                                let after = λ (end: Env) => t.goes_finish(c.prog, whole.within_self(), Ret(BitVec::zero()),
                                    λ (u: MachineState<X86Memory(t.r.profile)>) => t.Held([], end, u.gprs, u.memory),
                                    λ u at exited => sim_ret(t.io(), BitVec::zero(), u, u, Exists(Zero, refl), at, exited));
                                let tree = λ (n: Nat) => { let d: ITree<BitVec(64)>(Events::linux()) = ITree::bind(Events::linux(), src.main.denote(call, n, src.start(args)), λ (flow: Flow) => Ret(flow.status())); d };
                                λ n => t.goes_start(live, ok2.left, Start, w_saved, tree(n),
                                    t.goes_inits(live, tree(n), src.buffers, 0, saved, t.start_env(), caps, w_entry,
                                        runs(n, src.start(args), λ (flow: Flow) => Ret(flow.status()), exits, after)),
                                    s, here, at_whole, ⟨zero, argv⟩)
                            }))(resident),
                    })(refl)
                },
            })(refl)
        },
    })(refl, compiled)
}

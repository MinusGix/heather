// The reference-cells toy (reference_cells) lowered to x86 and proved by an
// injection of blocks (issues/ownership-reference-cells-spike.md;
// docs/language/ownership-design.md §15.7).
//
// Block `b` lies at span `b` of a lending, every span written, and the heap
// is injected into memory: the x86 memory contract's `Injected`
// (x86_64_memory_contract), whose lemmas this lowering cites, one per
// operation. Two blocks placed overlapping cannot both be injected
// (`overlap_not_injected`).
//
// A value is lowered to a word (`Value::lower`): a word to itself, a
// reference to its target's address. The registers hold the lowered values
// (`RegistersHold`), so the invariant has one statement for both kinds and
// the kind lives in `Value::lower`, not in what a register holds
// (reference_cells_bridges: it is FunctionIR's `Held::Rep` at kind `Word`
// over the lowered valuation).
//
// The lowering emits one instruction per operation, and it is the same
// instruction for a word and a reference: `MOV [base], source` for both
// stores, `MOV r64, [base]` for both loads, `MOVZX` for the byte load. Each
// operation's theorem is over the instruction's normal step as x86_64 states
// it (`WordLoadStep`, `ByteLoadStep`, `word_store_after` with the store's
// writable span), and says the step exists and keeps the invariant
// (`store_word_runs` and the four beside it); `lowered_runs` chains them
// over a program. Fetching the instructions, labels and the frame are left
// out: they are the same for these instructions as for FunctionIR's own
// loads and stores, which the real lowering already proves through
// (`load_emits`, function_ir_lower_calls).
//
// The program (`program`): a reference stored into eight bytes, loaded
// back, and a byte read through it. `program_lowers` is its lowering, by
// evaluation; `program_runs` its theorem.
import reference_cells;
import function_ir;
import x86_64;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_stack;
import x86_64_memory_contract;
import x86_64_byte_memory;
import bitvec;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Values as words

fn Value::lower(self value: Value, spans: Spans) → BitVec(64) {
    match value { Word(word) => word, Ref(loc) => loc.address(spans) }
}

// ---------------------------------------------------------------------------
// The injection is the contract's (x86_64_memory_contract: `Injected`, and
// one lemma per operation: `Loan::store_word_injected`,
// `Loan::store_ref_injected`, `Injected::word_read`, `ref_read`,
// `byte_read`).

// ---------------------------------------------------------------------------
// Registers

// Value `x` below `count` is in register `reg(x)`, as a word.
fn RegistersHold(spans: Spans, reg: Nat → Gpr, count: Nat, values: Nat → Value, gprs: Gprs) → Type {
    (x: Nat) → x < count → read_gpr(reg(x), gprs) = values(x).lower(spans)
}

// The registers of values below `count` other than `x` are not `reg(x)`.
fn apart_from(reg: Nat → Gpr, x, count: Nat) → Bool {
    match count { Zero => True, Succ(n) => (n.same(x) || !reg(x).same(reg(n))) && apart_from(reg, x, n) }
}

fn placed_below(reg: Nat → Gpr, upto, count: Nat) → Bool {
    match upto { Zero => True, Succ(n) => apart_from(reg, n, count) && placed_below(reg, n, count) }
}

// Values below `count` are in distinct registers.
fn placed(reg: Nat → Gpr, count: Nat) → Bool { placed_below(reg, count, count) }

theorem apart_from_sound(reg: Nat → Gpr, x, count: Nat): apart_from(reg, x, count) = True → (y: Nat) → y < count → y ≠ x →
    reg(x).same(reg(y)) = False {
    match count {
        Zero => λ _ y never => false_elim(never),
        Succ(n) => λ all y below differs => {
            let parts = Bool::and_true_parts(n.same(x) || !reg(x).same(reg(n)), apart_from(reg, x, n), all);
            match y.eq_dec(n) {
                Inl(here) => j(sym(here), λ z _ => reg(x).same(reg(z)) = False,
                    match Bool::or_true_parts(n.same(x), !reg(x).same(reg(n)), parts.left) {
                        Inl(same) => false_elim(differs(trans(here, n.same_sound(x, same)))),
                        Inr(apart) => Bool::false_of_not_true(apart),
                    }),
                Inr(other) => apart_from_sound(reg, x, n, parts.right, y, omega(below, other), differs),
            }
        },
    }
}

theorem placed_below_sound(reg: Nat → Gpr, count, upto: Nat): placed_below(reg, upto, count) = True → (x: Nat) → x < upto →
    apart_from(reg, x, count) = True {
    match upto {
        Zero => λ _ x never => false_elim(never),
        Succ(n) => λ all x below => {
            let parts = Bool::and_true_parts(apart_from(reg, n, count), placed_below(reg, n, count), all);
            match x.eq_dec(n) {
                Inl(here) => j(sym(here), λ z _ => apart_from(reg, z, count) = True, parts.left),
                Inr(other) => placed_below_sound(reg, count, n, parts.right, x, omega(below, other)),
            }
        },
    }
}

// A value set and its register written: the registers hold the values.
theorem registers_set(spans: Spans, reg: Nat → Gpr, count: Nat, s: State, gprs: Gprs, held: RegistersHold(spans, reg, count, s.values, gprs),
    ok: placed(reg, count) = True, x: Nat, below: x < count, value: Value):
    RegistersHold(spans, reg, count, s.set(x, value).values, write_gpr(reg(x), value.lower(spans), gprs)) {
    λ y short => match y.eq_dec(x) {
        Inl(here) => j(sym(here), λ z _ => read_gpr(reg(z), write_gpr(reg(x), value.lower(spans), gprs)) = s.set(x, value).values(z).lower(spans),
            trans(read_gpr_after_write(reg(x), value.lower(spans), gprs), cong_fn<Value, BitVec(64)>(λ v => v.lower(spans), sym(s.set_here(x, value))))),
        Inr(differs) => {
            let distinct: (reg(x).same(reg(y)) = False) = apart_from_sound(reg, x, count, placed_below_sound(reg, count, count, ok, x, below), y, short, differs);
            trans(trans(read_gpr_write(reg(x), reg(y), value.lower(spans), gprs),
                    cong_fn<Bool, BitVec(64)>(λ v => match v { False => read_gpr(reg(y), gprs), True => value.lower(spans) }, distinct)),
                trans(held(y, short), cong_fn<Value, BitVec(64)>(λ v => v.lower(spans), sym(s.set_other(x, value, y, differs)))))
        },
    }
}

// ---------------------------------------------------------------------------
// The lowering

inductive MachineOp { Load(load: WordLoad), LoadB(load: ByteLoad), Store(store: WordStore) }

// The instruction's normal step, as x86_64 states it.
fn MachineOp::Steps<M>(self op: MachineOp, data: ByteReadAccess<M>, writes: ByteWrites<M>, before, after: MachineState<M>) → Type {
    match op {
        Load(load) => Exists<BitVec(64)>(λ word => WordLoadStep<M>(data, load, word, before, after)),
        LoadB(load) => Exists<BitVec(8)>(λ byte => ByteLoadStep<M>(data, load, byte, before, after)),
        Store(store) => ((store_base_plain(store.base) = True) ∧ writes.writable(before.memory, read_gpr(store.base, before.gprs), 8)) ∧
            (after = word_store_after(writes, store, before)),
    }
}

fn Runs<M>(code: List<MachineOp>, data: ByteReadAccess<M>, writes: ByteWrites<M>, before, after: MachineState<M>) → Type {
    match code {
        Nil => after = before,
        Cons(op, rest) => Exists<MachineState<M>>(λ mid => op.Steps(data, writes, before, mid) ∧ Runs(rest, data, writes, mid, after)),
    }
}

// A word and a reference are stored by the same instruction, and loaded by
// the same one.
fn Op::lower(self op: Op, reg: Nat → Gpr) → MachineOp {
    match op {
        StoreWord(place, value) => Store(WordStore(reg(place), reg(value))),
        StoreRef(place, value) => Store(WordStore(reg(place), reg(value))),
        LoadWord(output, place) => Load(WordLoad(reg(output), reg(place))),
        LoadRef(output, place) => Load(WordLoad(reg(output), reg(place))),
        LoadByte(output, place) => LoadB(ByteLoad(reg(output), reg(place))),
    }
}

// What the lowering checks of an operation: its values below `count`, and
// a store's base a register the plain encoding takes.
fn Op::lowers(self op: Op, reg: Nat → Gpr, count: Nat) → Bool {
    match op {
        StoreWord(place, value) => ((place + 1).leb(count) && (value + 1).leb(count)) && store_base_plain(reg(place)),
        StoreRef(place, value) => ((place + 1).leb(count) && (value + 1).leb(count)) && store_base_plain(reg(place)),
        LoadWord(output, place) => (output + 1).leb(count) && (place + 1).leb(count),
        LoadRef(output, place) => (output + 1).leb(count) && (place + 1).leb(count),
        LoadByte(output, place) => (output + 1).leb(count) && (place + 1).leb(count),
    }
}

fn lower(ops: List<Op>, reg: Nat → Gpr) → List<MachineOp> {
    match ops { Nil => Nil, Cons(op, rest) => Cons(op.lower(reg), lower(rest, reg)) }
}

fn lowers_all(ops: List<Op>, reg: Nat → Gpr, count: Nat) → Bool {
    match ops { Nil => True, Cons(op, rest) => op.lowers(reg, count) && lowers_all(rest, reg, count) }
}

// The lowering's check: values in distinct registers, every operation
// lowered.
fn lowers(ops: List<Op>, reg: Nat → Gpr, count: Nat) → Bool { placed(reg, count) && lowers_all(ops, reg, count) }

// ---------------------------------------------------------------------------
// Each operation's instruction keeps the invariant

// The state's values are in their registers and its heap is injected.
fn Holds<M>(data: ByteReadAccess<M>, spans: Spans, reg: Nat → Gpr, count: Nat, s: State, m: MachineState<M>) → Type {
    RegistersHold(spans, reg, count, s.values, m.gprs) ∧ Injected<M>(data, spans, s.heap, m.memory)
}

fn Answers(after: Option<State>, P: State → Type) → Type { match after { None => True, Some(s) => P(s) } }

// From a state the invariant describes, if the operation steps, the
// instruction steps to a state the invariant describes of the result.
fn Steps<M>(data: ByteReadAccess<M>, writes: ByteWrites<M>, spans: Spans, reg: Nat → Gpr, count: Nat, op: MachineOp, m: MachineState<M>,
    after: Option<State>) → Type {
    Answers(after, λ (s: State) => Exists<MachineState<M>>(λ t => op.Steps(data, writes, m, t) ∧ Holds(data, spans, reg, count, s, t)))
}

theorem Loan::store_word_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, reg: Nat → Gpr, count: Nat,
    s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m), base, source: Gpr, plain: store_base_plain(base) = True):
    (place, value: Value) → read_gpr(base, m.gprs) = place.lower(spans) → read_gpr(source, m.gprs) = value.lower(spans) →
    Steps(data, stack.writes, spans, reg, count, Store(WordStore(base, source)), m, store_word_at(s, place, value)) {
    λ place value => match place {
        Word(_) => λ _ _ => trivial,
        Ref(loc) => match value {
            Ref(_) => λ _ _ => trivial,
            Word(word) => λ at stored => (match s.heap.fits(loc, 8) as λ v => s.heap.fits(loc, 8) = v →
                    Answers(match v { False => None, True => Some(State(s.values, s.heap.store_word(loc, word))) },
                        λ (after: State) => Exists<MachineState<M>>(λ t => Store(WordStore(base, source)).Steps(data, stack.writes, m, t) ∧
                            Holds(data, spans, reg, count, after, t))) {
                False => λ _ => trivial,
                True => λ ok => {
                    let parts = Bool::and_true_parts((loc.offset + 8).leb(s.heap.bytes(loc.block).len()), !cut(s.heap.shadow, loc.block, loc.offset, 8), ok);
                    let fits: (loc.offset + 8 <= spans.size(loc.block)) =
                        omega(Nat::le_of_leb_eq(loc.offset + 8, s.heap.bytes(loc.block).len(), parts.left), held.right.sizes(loc.block));
                    let writable = j(sym(at), λ a _ => stack.writes.writable(m.memory, a, 8),
                        loan.writable(m.memory, loc.block, loc.offset, written(loc.block), omega(fits), word_bytes(word), fits));
                    let t = word_store_after(stack.writes, WordStore(base, source), m);
                    let memory: (t.memory = stack.writes.store(m.memory, loc.address(spans), word_bytes(word))) =
                        j(at, λ a _ => stack.writes.store(m.memory, read_gpr(base, m.gprs), word_bytes(read_gpr(source, m.gprs))) =
                                stack.writes.store(m.memory, a, word_bytes(word)),
                            cong_fn<BitVec(64), M>(λ w => stack.writes.store(m.memory, read_gpr(base, m.gprs), word_bytes(w)), stored));
                    Exists(t, ⟨⟨⟨plain, writable⟩, refl⟩, ⟨held.left,
                        j(sym(memory), λ n _ => Injected<M>(data, spans, s.heap.store_word(loc, word), n),
                            loan.store_word_injected(s.heap, m.memory, held.right, loc, written(loc.block), ok, word))⟩⟩)
                },
            })(refl),
        },
    }
}

theorem Loan::store_ref_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, reg: Nat → Gpr, count: Nat,
    s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m), base, source: Gpr, plain: store_base_plain(base) = True):
    (place, value: Value) → read_gpr(base, m.gprs) = place.lower(spans) → read_gpr(source, m.gprs) = value.lower(spans) →
    Steps(data, stack.writes, spans, reg, count, Store(WordStore(base, source)), m, store_ref_at(s, place, value)) {
    λ place value => match place {
        Word(_) => λ _ _ => trivial,
        Ref(loc) => match value {
            Word(_) => λ _ _ => trivial,
            Ref(target) => λ at stored => (match s.heap.fits(loc, 8) as λ v => s.heap.fits(loc, 8) = v →
                    Answers(match v { False => None, True => Some(State(s.values, s.heap.store_ref(loc, target))) },
                        λ (after: State) => Exists<MachineState<M>>(λ t => Store(WordStore(base, source)).Steps(data, stack.writes, m, t) ∧
                            Holds(data, spans, reg, count, after, t))) {
                False => λ _ => trivial,
                True => λ ok => {
                    let word = target.address(spans);
                    let parts = Bool::and_true_parts((loc.offset + 8).leb(s.heap.bytes(loc.block).len()), !cut(s.heap.shadow, loc.block, loc.offset, 8), ok);
                    let fits: (loc.offset + 8 <= spans.size(loc.block)) =
                        omega(Nat::le_of_leb_eq(loc.offset + 8, s.heap.bytes(loc.block).len(), parts.left), held.right.sizes(loc.block));
                    let writable = j(sym(at), λ a _ => stack.writes.writable(m.memory, a, 8),
                        loan.writable(m.memory, loc.block, loc.offset, written(loc.block), omega(fits), word_bytes(word), fits));
                    let t = word_store_after(stack.writes, WordStore(base, source), m);
                    let memory: (t.memory = stack.writes.store(m.memory, loc.address(spans), word_bytes(word))) =
                        j(at, λ a _ => stack.writes.store(m.memory, read_gpr(base, m.gprs), word_bytes(read_gpr(source, m.gprs))) =
                                stack.writes.store(m.memory, a, word_bytes(word)),
                            cong_fn<BitVec(64), M>(λ w => stack.writes.store(m.memory, read_gpr(base, m.gprs), word_bytes(w)), stored));
                    Exists(t, ⟨⟨⟨plain, writable⟩, refl⟩, ⟨held.left,
                        j(sym(memory), λ n _ => Injected<M>(data, spans, s.heap.store_ref(loc, target), n),
                            loan.store_ref_injected(s.heap, m.memory, held.right, loc, written(loc.block), ok, target))⟩⟩)
                },
            })(refl),
        },
    }
}

theorem Loan::load_word_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), reg: Nat → Gpr, count: Nat, ok_regs: placed(reg, count) = True,
    s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m), output: Nat, below: output < count, base: Gpr):
    (place: Value) → read_gpr(base, m.gprs) = place.lower(spans) →
    Steps(data, stack.writes, spans, reg, count, Load(WordLoad(reg(output), base)), m, load_word_at(s, output, place)) {
    λ place => match place {
        Word(_) => λ _ => trivial,
        Ref(loc) => λ at => (match s.heap.plain(loc, 8) as λ v => s.heap.plain(loc, 8) = v →
                Answers(match v { False => None, True => Some(s.set(output, Word(s.heap.word(loc)))) },
                    λ (after: State) => Exists<MachineState<M>>(λ t => Load(WordLoad(reg(output), base)).Steps(data, stack.writes, m, t) ∧
                        Holds(data, spans, reg, count, after, t))) {
            False => λ _ => trivial,
            True => λ ok => {
                let word = s.heap.word(loc);
                let load = WordLoad(reg(output), base);
                let read = held.right.word_read(loc, ok);
                let t = word_load_after(load, word, m);
                Exists(t, ⟨Exists(word, WordLoadStep(
                        canonical := j(sym(at), λ a _ => a.toNat() + 8 <= Nat::pow(2, 47),
                            loan.canonical_at(loc.block, loc.offset, 8, read.left)),
                        present := j(sym(at), λ a _ => read_word(data, m.memory, a) = Some(word), read.right),
                        execution := refl)),
                    ⟨registers_set(spans, reg, count, s, m.gprs, held.left, ok_regs, output, below, Word(word)), held.right⟩⟩)
            },
        })(refl),
    }
}

theorem Loan::load_ref_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), reg: Nat → Gpr, count: Nat, ok_regs: placed(reg, count) = True,
    s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m), output: Nat, below: output < count, base: Gpr):
    (place: Value) → read_gpr(base, m.gprs) = place.lower(spans) →
    Steps(data, stack.writes, spans, reg, count, Load(WordLoad(reg(output), base)), m, load_ref_at(s, output, place)) {
    λ place => match place {
        Word(_) => λ _ => trivial,
        Ref(loc) => λ at => (match found(s.heap.shadow, loc.block, loc.offset) as λ o => found(s.heap.shadow, loc.block, loc.offset) = o →
                Answers(match o { None => None, Some(target) => Some(s.set(output, Ref(target))) },
                    λ (after: State) => Exists<MachineState<M>>(λ t => Load(WordLoad(reg(output), base)).Steps(data, stack.writes, m, t) ∧
                        Holds(data, spans, reg, count, after, t))) {
            None => λ _ => trivial,
            Some(target) => λ here => {
                let word = target.address(spans);
                let load = WordLoad(reg(output), base);
                let read = held.right.ref_read(loc, target, here);
                let t = word_load_after(load, word, m);
                Exists(t, ⟨Exists(word, WordLoadStep(
                        canonical := j(sym(at), λ a _ => a.toNat() + 8 <= Nat::pow(2, 47),
                            loan.canonical_at(loc.block, loc.offset, 8, read.left)),
                        present := j(sym(at), λ a _ => read_word(data, m.memory, a) = Some(word), read.right),
                        execution := refl)),
                    ⟨registers_set(spans, reg, count, s, m.gprs, held.left, ok_regs, output, below, Ref(target)), held.right⟩⟩)
            },
        })(refl),
    }
}

theorem Loan::load_byte_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), reg: Nat → Gpr, count: Nat, ok_regs: placed(reg, count) = True,
    s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m), output: Nat, below: output < count, base: Gpr):
    (place: Value) → read_gpr(base, m.gprs) = place.lower(spans) →
    Steps(data, stack.writes, spans, reg, count, LoadB(ByteLoad(reg(output), base)), m, load_byte_at(s, output, place)) {
    λ place => match place {
        Word(_) => λ _ => trivial,
        Ref(loc) => λ at => (match s.heap.plain(loc, 1) as λ v => s.heap.plain(loc, 1) = v →
                Answers(match v { False => None, True => Some(s.set(output, Word(s.heap.byte(loc).zero_extend(56)))) },
                    λ (after: State) => Exists<MachineState<M>>(λ t => LoadB(ByteLoad(reg(output), base)).Steps(data, stack.writes, m, t) ∧
                        Holds(data, spans, reg, count, after, t))) {
            False => λ _ => trivial,
            True => λ ok => {
                let byte = s.heap.byte(loc);
                let load = ByteLoad(reg(output), base);
                let read = held.right.byte_read(loc, ok);
                let low: (read_gpr(base, m.gprs).toNat() < Nat::pow(2, 47)) =
                    j(sym(at), λ a _ => a.toNat() < Nat::pow(2, 47), omega(loan.canonical_at(loc.block, loc.offset, 1, read.left)));
                let t = byte_load_after(load, byte, m);
                Exists(t, ⟨Exists(byte, ByteLoadStep(
                        canonical := BitVec::drop_low_zero_of_lt(47, 17, read_gpr(base, m.gprs), low),
                        present := j(sym(at), λ a _ => data.read(m.memory, a) = Some(byte), read.right),
                        execution := refl)),
                    ⟨registers_set(spans, reg, count, s, m.gprs, held.left, ok_regs, output, below, Word(byte.zero_extend(56))), held.right⟩⟩)
            },
        })(refl),
    }
}

// Each operation the lowering accepts.
theorem Loan::op_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, reg: Nat → Gpr, count: Nat,
    ok_regs: placed(reg, count) = True, op: Op, ok: op.lowers(reg, count) = True, s: State, m: MachineState<M>,
    held: Holds(data, spans, reg, count, s, m)): Steps(data, stack.writes, spans, reg, count, op.lower(reg), m, op.step(s)) {
    match op {
        StoreWord(place, value) => {
            let parts = Bool::and_true_parts((place + 1).leb(count) && (value + 1).leb(count), store_base_plain(reg(place)), ok);
            let both = Bool::and_true_parts((place + 1).leb(count), (value + 1).leb(count), parts.left);
            loan.store_word_runs(written, reg, count, s, m, held, reg(place), reg(value), parts.right, s.values(place), s.values(value),
                held.left(place, Nat::le_of_leb_eq(place + 1, count, both.left)), held.left(value, Nat::le_of_leb_eq(value + 1, count, both.right)))
        },
        StoreRef(place, value) => {
            let parts = Bool::and_true_parts((place + 1).leb(count) && (value + 1).leb(count), store_base_plain(reg(place)), ok);
            let both = Bool::and_true_parts((place + 1).leb(count), (value + 1).leb(count), parts.left);
            loan.store_ref_runs(written, reg, count, s, m, held, reg(place), reg(value), parts.right, s.values(place), s.values(value),
                held.left(place, Nat::le_of_leb_eq(place + 1, count, both.left)), held.left(value, Nat::le_of_leb_eq(value + 1, count, both.right)))
        },
        LoadWord(output, place) => {
            let both = Bool::and_true_parts((output + 1).leb(count), (place + 1).leb(count), ok);
            loan.load_word_runs(reg, count, ok_regs, s, m, held, output, Nat::le_of_leb_eq(output + 1, count, both.left), reg(place), s.values(place),
                held.left(place, Nat::le_of_leb_eq(place + 1, count, both.right)))
        },
        LoadRef(output, place) => {
            let both = Bool::and_true_parts((output + 1).leb(count), (place + 1).leb(count), ok);
            loan.load_ref_runs(reg, count, ok_regs, s, m, held, output, Nat::le_of_leb_eq(output + 1, count, both.left), reg(place), s.values(place),
                held.left(place, Nat::le_of_leb_eq(place + 1, count, both.right)))
        },
        LoadByte(output, place) => {
            let both = Bool::and_true_parts((output + 1).leb(count), (place + 1).leb(count), ok);
            loan.load_byte_runs(reg, count, ok_regs, s, m, held, output, Nat::le_of_leb_eq(output + 1, count, both.left), reg(place), s.values(place),
                held.left(place, Nat::le_of_leb_eq(place + 1, count, both.right)))
        },
    }
}

// ---------------------------------------------------------------------------
// Programs

fn Ran<M>(data: ByteReadAccess<M>, writes: ByteWrites<M>, spans: Spans, reg: Nat → Gpr, count: Nat, code: List<MachineOp>, m: MachineState<M>,
    after: Option<State>) → Type {
    Answers(after, λ (s: State) => Exists<MachineState<M>>(λ t => Runs(code, data, writes, m, t) ∧ Holds(data, spans, reg, count, s, t)))
}

theorem then_ran<M>(data: ByteReadAccess<M>, writes: ByteWrites<M>, spans: Spans, reg: Nat → Gpr, count: Nat, op: MachineOp, rest: List<Op>,
    code: List<MachineOp>, m: MachineState<M>,
    later: (s: State) → (t: MachineState<M>) → Holds(data, spans, reg, count, s, t) → Ran(data, writes, spans, reg, count, code, t, run(rest, s))):
    (after: Option<State>) → Steps(data, writes, spans, reg, count, op, m, after) →
    Ran(data, writes, spans, reg, count, Cons(op, code), m, match after { None => None, Some(s) => run(rest, s) }) {
    λ after => match after {
        None => λ _ => trivial,
        Some(s) => λ stepped => {
            let mid = stepped.witness;
            (match run(rest, s) as λ o => Ran(data, writes, spans, reg, count, code, mid, o) → Ran(data, writes, spans, reg, count, Cons(op, code), m, o) {
                None => λ _ => trivial,
                Some(_) => λ ran => Exists(ran.witness, ⟨Exists(mid, ⟨stepped.proof.left, ran.proof.left⟩), ran.proof.right⟩),
            })(later(s, mid, stepped.proof.right))
        },
    }
}

// The lowering's theorem: from a state the invariant describes, if the
// program runs, its code runs to a state the invariant describes of the
// result.
theorem Loan::lowered_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, reg: Nat → Gpr, count: Nat,
    ok_regs: placed(reg, count) = True, ops: List<Op>): lowers_all(ops, reg, count) = True → (s: State) → (m: MachineState<M>) →
    Holds(data, spans, reg, count, s, m) → Ran(data, stack.writes, spans, reg, count, lower(ops, reg), m, run(ops, s)) {
    match ops {
        Nil => λ _ s m held => Exists(m, ⟨refl, held⟩),
        Cons(op, rest) => λ ok s m held => {
            let parts = Bool::and_true_parts(op.lowers(reg, count), lowers_all(rest, reg, count), ok);
            then_ran(data, stack.writes, spans, reg, count, op.lower(reg), rest, lower(rest, reg), m,
                λ after t held_after => loan.lowered_runs(written, reg, count, ok_regs, rest, parts.right, after, t, held_after),
                op.step(s), loan.op_runs(written, reg, count, ok_regs, op, parts.left, s, m, held))
        },
    }
}

theorem Loan::program_lowered<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, reg: Nat → Gpr, count: Nat,
    ops: List<Op>, ok: lowers(ops, reg, count) = True, s: State, m: MachineState<M>, held: Holds(data, spans, reg, count, s, m)):
    Ran(data, stack.writes, spans, reg, count, lower(ops, reg), m, run(ops, s)) {
    let parts = Bool::and_true_parts(placed(reg, count), lowers_all(ops, reg, count), ok);
    loan.lowered_runs(written, reg, count, parts.left, ops, parts.right, s, m, held)
}

// ---------------------------------------------------------------------------
// The program: a reference stored, loaded back, and read through

// Value 0 is where the reference is stored, value 1 the reference; value 2
// is it loaded back, and value 3 the byte it reaches.
fn program() → List<Op> { [StoreRef(0, 1), LoadRef(2, 0), LoadByte(3, 2)] }

fn program_reg(x: Nat) → Gpr {
    match x { Zero => Rdi, Succ(a) => match a { Zero => Rsi, Succ(b) => match b { Zero => Rax, Succ(_) => Rcx } } }
}

theorem program_lowers(): lowers(program(), program_reg, 4) = True { refl }

// Its code: `MOV [RDI], RSI`, `MOV RAX, [RDI]`, `MOVZX RCX, byte [RAX]`.
theorem program_code(): lower(program(), program_reg) =
    [Store(WordStore(Rdi, Rsi)), Load(WordLoad(Rax, Rdi)), LoadB(ByteLoad(Rcx, Rax))] { refl }

// Its theorem: under a loan of its blocks, from a machine state holding its
// values with the heap injected, if the program runs, its code runs to a
// state holding the run's values (the byte in RCX) and its heap injected.
theorem Loan::program_runs<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, {stack: Stack<M>(fetch, data)}, {top: Nat}, {spans: Spans},
    self loan: Loan<M>(fetch, data, stack, top, spans), written: (b: Nat) → spans.written(b) = True, s: State, m: MachineState<M>,
    held: Holds(data, spans, program_reg, 4, s, m)):
    Ran(data, stack.writes, spans, program_reg, 4, [Store(WordStore(Rdi, Rsi)), Load(WordLoad(Rax, Rdi)), LoadB(ByteLoad(Rcx, Rax))], m, run(program(), s)) {
    loan.program_lowered(written, program_reg, 4, program(), program_lowers(), s, m, held)
}

// ---------------------------------------------------------------------------
// Controls

// A byte load of a byte a reference occupies has no step: the meaning
// refuses it, so the `MOVZX` the lowering emits for it is owed nothing.
theorem load_byte_refused(s: State, output: Nat, loc: Loc, inside: touched(s.heap.shadow, loc.block, loc.offset, 1) = True):
    load_byte_at(s, output, Ref(loc)) = None {
    let unreadable: (s.heap.plain(loc, 1) = False) =
        trans(cong_fn<Bool, Bool>(λ v => (loc.offset + 1).leb(s.heap.bytes(loc.block).len()) && !v, inside),
            Bool::and_false_r((loc.offset + 1).leb(s.heap.bytes(loc.block).len())));
    j(sym(unreadable), λ v _ => (match v { False => None, True => Some(s.set(output, Word(s.heap.byte(loc).zero_extend(56)))) }) =
        None<State>, refl)
}

// Two blocks placed overlapping are not injected: where their spans share
// a byte that neither's shadow covers and their bytes there differ, no
// memory reads both.
theorem overlap_not_injected<M>(data: ByteReadAccess<M>, spans: Spans, heap: Heap, memory: M, b, i, c, k: Nat,
    in_b: i < spans.size(b), in_c: k < spans.size(c), shared: spans.byte(b, i) = spans.byte(c, k),
    plain_b: covered(heap.shadow, b, i) = False, plain_c: covered(heap.shadow, c, k) = False,
    differ: heap.bytes(b).nth(i) ≠ heap.bytes(c).nth(k)): ¬Injected<M>(data, spans, heap, memory) {
    λ inj => differ(trans(sym(inj.bytes(b, i, in_b, plain_b)),
        trans(cong_fn<BitVec(64), Option<BitVec(8)>>(λ a => data.read(memory, a), shared), inj.bytes(c, k, in_c, plain_c))))
}

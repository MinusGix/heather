// Functions over a buffer they are lent, which the builder's tools call
// (docs/native-one-compiler-design.md §2.3): FunctionIR functions reading
// a buffer through its home, compiled into the tool's file by the function
// compiler and passed the buffer by the call (`Prog::function_call`).
//
// Written as FunctionIR until `rt` lowers a read of a lent span (round
// U3c); what each computes is stated by evaluation in the probes
// (lib/_tests/native/native_tool_spans_tests.hthr).
import function_ir;
import list;
import nat;

fn span_word(id: Nat) → Port { Port(id := id, width := 64) }
fn span_bit(id: Nat) → Port { Port(id := id, width := 1) }

// count_newlines(buffer, count): how many of the buffer's first `count`
// bytes are newlines, a byte past the buffer's end counting as none.
//
// Parameters 0 and 1 are the buffer's home (its address and its length),
// parameter 2 the count. The loop makes `count` passes over the home, the
// index and the tally; a pass reads the byte only under the test of the
// index against the length, which is what bounds the load.
fn count_newlines() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([span_word(0), span_word(1), span_word(2)]),
                nodes := [Const(width := 64, output := 3, value := 0), Const(width := 64, output := 4, value := 0)],
                outputs := Ports([span_word(0), span_word(1), span_word(2), span_word(3), span_word(4)])),
            Loop(inputs := [0, 1, 3, 4], bound := 2, parameters := [10, 11, 12, 13], count := 14,
                body := Sequence(
                    Region(inputs := Ports([span_word(10), span_word(11), span_word(12), span_word(13), span_word(14)]),
                        nodes := [UnsignedLessThan(width := 64, output := 20, left := 14, right := 14),
                            UnsignedLessThan(width := 64, output := 15, left := 12, right := 11)],
                        outputs := Ports([span_word(10), span_word(11), span_word(12), span_word(13), span_bit(20), span_bit(15)])),
                    Conditional(Ports([span_word(10), span_word(11), span_word(12), span_word(13), span_bit(20), span_bit(15)]), 15,
                        Ports([span_word(12), span_word(13)]), Ports([span_word(16), span_word(17)]),
                        Sequence(
                            Region(inputs := Ports([span_word(12), span_word(13)]),
                                nodes := [BufferLoad(output := 18, buffer := 0, index := 12)],
                                outputs := Ports([span_word(12), span_word(13), span_word(18)])),
                            Sequence(
                                Region(inputs := Ports([span_word(12), span_word(13), span_word(18)]),
                                    nodes := [Const(width := 64, output := 21, value := 10),
                                        Equal(width := 64, output := 22, left := 18, right := 21)],
                                    outputs := Ports([span_word(12), span_word(13), span_bit(22)])),
                                Conditional(Ports([span_word(12), span_word(13), span_bit(22)]), 22,
                                    Ports([span_word(12), span_word(13)]), Ports([span_word(16), span_word(17)]),
                                    Dataflow(Region(inputs := Ports([span_word(12), span_word(13)]),
                                        nodes := [Const(width := 64, output := 19, value := 1),
                                            Add(width := 64, output := 16, left := 13, right := 19),
                                            Add(width := 64, output := 17, left := 12, right := 19)],
                                        outputs := Ports([span_word(16), span_word(17)]))),
                                    Dataflow(Region(inputs := Ports([span_word(12), span_word(13)]),
                                        nodes := [Const(width := 64, output := 19, value := 1),
                                            Move(width := 64, output := 16, source := 13),
                                            Add(width := 64, output := 17, left := 12, right := 19)],
                                        outputs := Ports([span_word(16), span_word(17)])))))),
                        Dataflow(Region(inputs := Ports([span_word(12), span_word(13)]),
                            nodes := [Move(width := 64, output := 16, source := 13), Move(width := 64, output := 17, source := 12)],
                            outputs := Ports([span_word(16), span_word(17)]))))),
                exit := 20, next := [10, 11, 17, 16], outputs := [5, 6, 7, 8], exhausted := 9)),
        result := 8)
}

// The program a tool calls it in.
fn count_newlines_program() → List<Function> { [count_newlines()] }

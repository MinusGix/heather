// Functions over a buffer they are lent, which the builder's tools call
// (docs/native-one-compiler-design.md §2.3): `runtime fn`s whose first
// parameter is a span of bytes, compiled into the tool's file by the
// function compiler and passed the buffer by the call
// (`Prog::function_call`). Each is a Heather function, and its program is
// proved to compute it at every file (`f::agrees_over`,
// lib/native/runtime/runtime.hthr); what a tool's call of it answers is
// stated below from that. `raise_span`, which stores into the buffer, is
// written as FunctionIR until the runtime language writes a span
// (docs/native-one-compiler-design.md §3, U4 step 4c): what it does is
// stated by evaluation, as any FunctionIR program's is (`program_run`).
// The probes are lib/_tests/native/native_tool_spans_tests.hthr.
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import omega;
import rt;
import rt_lower;
import rt_loop;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_placeless;
import runtime;
import native_tool_words;
import native_tool_words_program;

// The newlines among the span's bytes from `i` to below `count`, added to
// `acc`. A byte is read under the span's own length word, so one past the
// span's end counts as none.
runtime fn newlines_from(span: List<BitVec(8)>, length, count, i, acc: BitVec(64)) → BitVec(64) decreases count.sub(i).toNat() {
    match h: i.unsigned_lt_bit(count) {
        False => acc,
        True => newlines_from(span, length, count, i.add(BitVec::ofNat(1)), match span.byte_within(length, i).eq_bit(BitVec::ofNat(10)) {
            False => acc,
            True => acc.add(BitVec::ofNat(1)),
        }),
    }
    on ?dec1 := {
        let below = bitvec_omega::unsigned_true(64, i, count, h);
        bv_omega
    };
}

// count_newlines(span, length, count): how many of the span's first
// `count` bytes are newlines.
runtime fn count_newlines(span: List<BitVec(8)>, length, count: BitVec(64)) → BitVec(64) {
    newlines_from(span, length, count, BitVec::ofNat(0), BitVec::ofNat(0))
}

// The program a tool calls it in, and its place there: the loop first, as
// the function compiler asks of a callee.
fn count_newlines_program() → List<Function> { count_newlines::program }
fn count_newlines_entry() → Nat { 1 }

// The word a tool's call answers: the function, at the first buffer the
// tool holds and that buffer's size, whatever the buffer's address. `held`
// is the tool's buffers as they are at the call.
theorem count_newlines_answers(held: Buffers(), count: BitVec(64)):
    program_readers(count_newlines_program())(held, count_newlines_entry(), [count])
        = count_newlines(buffer_bytes(held, 0), BitVec::ofNat(buffer_bytes(held, 0).len()), count) {
    match held {
        Nil => count_newlines::agrees_over(Nil, BitVec::zero(), BitVec::ofNat(0), count),
        Cons(bytes, rest) => count_newlines::agrees_over([bytes], BitVec::zero(), BitVec::ofNat(bytes.len()), count),
    }
}

// What the call is in a tool's meaning (`program_writers`): that word, and
// the tool's buffers as they were, since the program stores nothing.
theorem count_newlines_called(held: Buffers(), count: BitVec(64)):
    program_writers(count_newlines_program())(held, count_newlines_entry(), [count])
        = Ending(count_newlines(buffer_bytes(held, 0), BitVec::ofNat(buffer_bytes(held, 0).len()), count), held) {
    trans(program_writers_quiet(count_newlines_program(), trivial, held, count_newlines_entry(), [count]),
        cong_fn<BitVec(64), Ending>(λ word => Ending(word, held), count_newlines_answers(held, count)))
}

// ---------------------------------------------------------------------------
// A function that writes the buffer it is lent

fn span_word(id: Nat) → Port { Port(id := id, width := 64) }
fn span_bit(id: Nat) → Port { Port(id := id, width := 1) }

// raise_span(buffer, count): each of the buffer's first `count` bytes put
// through `raise_letter` (native_tool_words) and stored back, answering
// how many it stored.
//
// Parameters 0 and 1 are the buffer's home (its address and its length),
// parameter 2 the count. The loop makes `count` passes over the home and
// the index. A pass tests the index against the length, which is what
// bounds its load and its store, and between the two calls function 0 on
// the byte. A count past the length stores nothing past it.
fn raise_span() → Function {
    Function(parameters := [0, 1, 2], lent := 1,
        body := Sequence(
            Region(inputs := Ports([span_word(0), span_word(1), span_word(2)]), nodes := [Const(width := 64, output := 3, value := 0)],
                outputs := Ports([span_word(0), span_word(1), span_word(2), span_word(3)])),
            Loop(inputs := [0, 1, 3], bound := 2, parameters := [10, 11, 12], count := 14,
                body := Sequence(
                    Region(inputs := Ports([span_word(10), span_word(11), span_word(12), span_word(14)]),
                        nodes := [UnsignedLessThan(width := 64, output := 20, left := 14, right := 14),
                            UnsignedLessThan(width := 64, output := 15, left := 12, right := 11)],
                        outputs := Ports([span_word(10), span_word(11), span_word(12), span_bit(20), span_bit(15)])),
                    Conditional(Ports([span_word(10), span_word(11), span_word(12), span_bit(20), span_bit(15)]), 15,
                        Ports([span_word(12)]), Ports([span_word(17)]),
                        Sequence(
                            Region(inputs := Ports([span_word(12)]), nodes := [BufferLoad(output := 18, buffer := 0, index := 12)],
                                outputs := Ports([span_word(12), span_word(18)])),
                            Compose(Call(0, [18], 21),
                                Sequence(
                                    Region(inputs := Ports([span_word(12), span_word(21)]),
                                        nodes := [BufferStore(output := 22, buffer := 0, index := 12, value := 21)],
                                        outputs := Ports([span_word(12)])),
                                    Dataflow(Region(inputs := Ports([span_word(12)]),
                                        nodes := [Const(width := 64, output := 19, value := 1),
                                            Add(width := 64, output := 17, left := 12, right := 19)],
                                        outputs := Ports([span_word(17)])))))),
                        Dataflow(Region(inputs := Ports([span_word(12)]), nodes := [Move(width := 64, output := 17, source := 12)],
                            outputs := Ports([span_word(17)]))))),
                exit := 20, next := [10, 11, 17], outputs := [4, 5, 6], exhausted := 8)),
        result := 6)
}

// The program a tool calls it in: `raise_letter`'s reflected program, the
// byte map, and this after it.
fn raise_span_program() → List<Function> { Cons(raise_span(), raise_letter_native_program()) }
fn raise_span_entry() → Nat { 1 }

// The replayer over a list of nodes (docs/optimizer-design.md §3.1, §3.2):
// the one function of the optimizer at this level that is proved, and what
// it takes from an untrusted searcher.
//
// - A fact is something known of the activation's valuation (`Fact`): a
//   node's equation, or that a word lies between two numbers. Every node
//   of the old body that touches no buffer is one once the sweep has passed
//   it, kept or dropped (`Facts::learn`), and an arm starts with its
//   conditional's bit as a constant. The facts are keyed by the id they
//   are about, so asking for one is a lookup, and a range is known where a
//   range inside it is.
// - A rule is a clause over facts with its proof (`Clause`, `Rule`): made
//   from an instance's ids and literals, premises and a conclusion, and a
//   theorem that a valuation satisfying the premises satisfies the
//   conclusion. Applying one is finding its premises among the facts.
// - A plan is a list of steps (`Step`): keep the next node, drop it (never
//   a store), derive a rule's conclusion into the facts, emit a node that
//   is among the facts, or have the next node read other ids, which the
//   facts say are copies of the ones it read (`Node::reading`). A call's
//   arguments and a loop's inputs are read through copies the same way
//   (`Plan::Args`, `Plan::Inputs`). A conditional whose bit the facts say
//   is a constant is the arm that constant takes (`Plan::Arm`).
// - A loop's body is replayed from what the loop does not change: a
//   parameter that is its own next has in every pass the range of the
//   input it started from (`Facts::carry`, `loop_kept`).
// - `replay_sound`: whatever the plan, the nodes returned run wherever the
//   old ones ran, over the same valuation and files, and the facts returned
//   hold there. A function's meaning is taken by its code's contract as a
//   premise (`Stack::CalledOver`), so this direction is the one a compiled
//   program needs: what the old body admits, the new one does.
//
// Nothing here says a dropped node was dead. A body that reads an id no
// node writes is refused by the lowering, as a wrong placement is.
//
// A node among the facts may be emitted beside the node that already
// writes its id: a function's meaning is the valuations that satisfy its
// equations, and one the others imply changes none of them. That is how a
// fact a plan proved reaches the lowering (docs/optimizer-design.md §5.1).
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_stage;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import nat_map;
import option;

// ---------------------------------------------------------------------------
// Node equality

fn same2(a, b, c, d: Nat) → Bool { a.same(c) && b.same(d) }
fn same3(a, b, c, x, y, z: Nat) → Bool { a.same(x) && (b.same(y) && c.same(z)) }
fn same4(a, b, c, d, w, x, y, z: Nat) → Bool { a.same(w) && (b.same(x) && (c.same(y) && d.same(z))) }

fn Node::same(self a: Node, b: Node) → Bool {
    match a {
        Const(w, o, v) => match b { Const(w2, o2, v2) => same3(w, o, v, w2, o2, v2), _ => False },
        Move(w, o, s) => match b { Move(w2, o2, s2) => same3(w, o, s, w2, o2, s2), _ => False },
        Add(w, o, l, r) => match b { Add(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        Sub(w, o, l, r) => match b { Sub(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        BitAnd(w, o, l, r) => match b { BitAnd(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        BitOr(w, o, l, r) => match b { BitOr(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        BitXor(w, o, l, r) => match b { BitXor(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        ShiftLeft(w, o, l, r) => match b { ShiftLeft(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        LogicalShiftRight(w, o, l, r) => match b { LogicalShiftRight(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        ArithmeticShiftRight(w, o, l, r) => match b { ArithmeticShiftRight(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        UnsignedLessThan(w, o, l, r) => match b { UnsignedLessThan(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        SignedLessThan(w, o, l, r) => match b { SignedLessThan(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        Equal(w, o, l, r) => match b { Equal(w2, o2, l2, r2) => same4(w, o, l, r, w2, o2, l2, r2), _ => False },
        BufferLoad(o, f, i) => match b { BufferLoad(o2, f2, i2) => same3(o, f, i, o2, f2, i2), _ => False },
        BufferStore(o, f, i, v) => match b { BufferStore(o2, f2, i2, v2) => same4(o, f, i, v, o2, f2, i2, v2), _ => False },
        Resize(f, t, o, s) => match b { Resize(f2, t2, o2, s2) => same4(f, t, o, s, f2, t2, o2, s2), _ => False },
        SignResize(f, t, o, s) => match b { SignResize(f2, t2, o2, s2) => same4(f, t, o, s, f2, t2, o2, s2), _ => False },
    }
}

theorem same3_sound(a, b, c, x, y, z: Nat, h: same3(a, b, c, x, y, z) = True): (a = x) ∧ ((b = y) ∧ (c = z)) {
    let p = Bool::and_true_parts(a.same(x), b.same(y) && c.same(z), h);
    let q = Bool::and_true_parts(b.same(y), c.same(z), p.right);
    ⟨a.same_sound(x, p.left), ⟨b.same_sound(y, q.left), c.same_sound(z, q.right)⟩⟩
}
theorem same4_sound(a, b, c, d, w, x, y, z: Nat, h: same4(a, b, c, d, w, x, y, z) = True): (a = w) ∧ ((b = x) ∧ ((c = y) ∧ (d = z))) {
    let p = Bool::and_true_parts(a.same(w), b.same(x) && (c.same(y) && d.same(z)), h);
    ⟨a.same_sound(w, p.left), same3_sound(b, c, d, x, y, z, p.right)⟩
}

theorem con3(f: Nat → Nat → Nat → Node, a, b, c, x, y, z: Nat, e: (a = x) ∧ ((b = y) ∧ (c = z))): f(a, b, c) = f(x, y, z) {
    trans(cong_fn<Nat, Node>(λ n => f(n, b, c), e.left), trans(cong_fn<Nat, Node>(λ n => f(x, n, c), e.right.left), cong_fn<Nat, Node>(λ n => f(x, y, n), e.right.right)))
}
theorem con4(f: Nat → Nat → Nat → Nat → Node, a, b, c, d, w, x, y, z: Nat, e: (a = w) ∧ ((b = x) ∧ ((c = y) ∧ (d = z)))): f(a, b, c, d) = f(w, x, y, z) {
    trans(cong_fn<Nat, Node>(λ n => f(n, b, c, d), e.left), con3(λ p q r => f(w, p, q, r), b, c, d, x, y, z, e.right))
}

theorem Node::same_sound(self a: Node): (b: Node) → a.same(b) = True → a = b {
    match a {
        Const(w, o, v) => λ b => match b { Const(w2, o2, v2) => λ h => con3(λ p q r => Const(p, q, r), w, o, v, w2, o2, v2, same3_sound(w, o, v, w2, o2, v2, h)), _ => λ h => absurd(h) },
        Move(w, o, v) => λ b => match b { Move(w2, o2, v2) => λ h => con3(λ p q r => Move(p, q, r), w, o, v, w2, o2, v2, same3_sound(w, o, v, w2, o2, v2, h)), _ => λ h => absurd(h) },
        Add(w, o, l, r) => λ b => match b { Add(w2, o2, l2, r2) => λ h => con4(λ p q s t => Add(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        Sub(w, o, l, r) => λ b => match b { Sub(w2, o2, l2, r2) => λ h => con4(λ p q s t => Sub(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        BitAnd(w, o, l, r) => λ b => match b { BitAnd(w2, o2, l2, r2) => λ h => con4(λ p q s t => BitAnd(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        BitOr(w, o, l, r) => λ b => match b { BitOr(w2, o2, l2, r2) => λ h => con4(λ p q s t => BitOr(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        BitXor(w, o, l, r) => λ b => match b { BitXor(w2, o2, l2, r2) => λ h => con4(λ p q s t => BitXor(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        ShiftLeft(w, o, l, r) => λ b => match b { ShiftLeft(w2, o2, l2, r2) => λ h => con4(λ p q s t => ShiftLeft(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        LogicalShiftRight(w, o, l, r) => λ b => match b { LogicalShiftRight(w2, o2, l2, r2) => λ h => con4(λ p q s t => LogicalShiftRight(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        ArithmeticShiftRight(w, o, l, r) => λ b => match b { ArithmeticShiftRight(w2, o2, l2, r2) => λ h => con4(λ p q s t => ArithmeticShiftRight(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        UnsignedLessThan(w, o, l, r) => λ b => match b { UnsignedLessThan(w2, o2, l2, r2) => λ h => con4(λ p q s t => UnsignedLessThan(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        SignedLessThan(w, o, l, r) => λ b => match b { SignedLessThan(w2, o2, l2, r2) => λ h => con4(λ p q s t => SignedLessThan(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        Equal(w, o, l, r) => λ b => match b { Equal(w2, o2, l2, r2) => λ h => con4(λ p q s t => Equal(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        BufferLoad(w, o, v) => λ b => match b { BufferLoad(w2, o2, v2) => λ h => con3(λ p q r => BufferLoad(p, q, r), w, o, v, w2, o2, v2, same3_sound(w, o, v, w2, o2, v2, h)), _ => λ h => absurd(h) },
        BufferStore(w, o, l, r) => λ b => match b { BufferStore(w2, o2, l2, r2) => λ h => con4(λ p q s t => BufferStore(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        Resize(w, o, l, r) => λ b => match b { Resize(w2, o2, l2, r2) => λ h => con4(λ p q s t => Resize(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
        SignResize(w, o, l, r) => λ b => match b { SignResize(w2, o2, l2, r2) => λ h => con4(λ p q s t => SignResize(p, q, s, t), w, o, l, r, w2, o2, l2, r2, same4_sound(w, o, l, r, w2, o2, l2, r2, h)), _ => λ h => absurd(h) },
    }
}

// ---------------------------------------------------------------------------
// Facts: nodes that hold of the activation's valuation, by the id written

fn nodes_have(nodes: List<Node>, node: Node) → Bool {
    match nodes { Nil => False, Cons(fact, rest) => fact.same(node) || nodes_have(rest, node) }
}

theorem nodes_have_holds(values: Valuation(), node: Node, nodes: List<Node>): NodesHold(values, nodes) → nodes_have(nodes, node) = True →
    NodeHolds(values, node) {
    match nodes {
        Nil => λ _ h => absurd(h),
        Cons(fact, rest) => λ held h => match Bool::or_true_parts(fact.same(node), nodes_have(rest, node), h) {
            Inl(here) => j(fact.same_sound(node, here), λ n _ => NodeHolds(values, n), held.left),
            Inr(there) => nodes_have_holds(values, node, rest, held.right, there),
        },
    }
}

// A word, as a number, lies between two numbers.
record Range { low: Nat, high: Nat }

fn Range::Holds(self range: Range, word: BitVec(64)) → Type { (range.low <= word.toNat()) ∧ (word.toNat() <= range.high) }

// The greatest word, and the range every word is in.
fn word_top() → Nat { 18446744073709551615 }
fn Range::any() → Range { Range(0, word_top()) }

theorem Range::any_holds(word: BitVec(64)): Range::any().Holds(word) {
    ⟨trivial, word.toNat().lt_succ_iff_le(word_top()).mp(BitVec::toNat_lt_pow(64, word))⟩
}

// Both of two ranges.
fn Range::meet(self a: Range, b: Range) → Range {
    Range(match a.low.leb(b.low) { True => b.low, False => a.low }, match a.high.leb(b.high) { True => a.high, False => b.high })
}

theorem Range::meet_holds(self a: Range, b: Range, word: BitVec(64), first: a.Holds(word), second: b.Holds(word)): a.meet(b).Holds(word) {
    ⟨(match a.low.leb(b.low) as λ c => (match c { True => b.low, False => a.low }) <= word.toNat() { True => second.left, False => first.left }),
        (match a.high.leb(b.high) as λ c => word.toNat() <= (match c { True => a.high, False => b.high }) { True => first.right, False => second.right })⟩
}

// `a` says at least what `b` does.
fn Range::inside(self a: Range, b: Range) → Bool { b.low.leb(a.low) && a.high.leb(b.high) }

theorem Range::inside_holds(self a: Range, b: Range, word: BitVec(64), inside: a.inside(b) = True, held: a.Holds(word)): b.Holds(word) {
    let both = Bool::and_true_parts(b.low.leb(a.low), a.high.leb(b.high), inside);
    ⟨Nat::le_trans(b.low, a.low, word.toNat(), b.low.leb_sound(a.low, Bool::is_true_of_eq(both.left)), held.left),
        Nat::le_trans(word.toNat(), a.high, b.high, held.right, a.high.leb_sound(b.high, Bool::is_true_of_eq(both.right)))⟩
}

// What a replay knows of the valuation: a node's equation, or a word's
// range.
inductive Fact { Is(node: Node), Within(id: Nat, low: Nat, high: Nat) }

fn Fact::Holds(self fact: Fact, values: Valuation()) → Type {
    match fact { Is(node) => NodeHolds(values, node), Within(id, low, high) => Range(low, high).Holds(values(64, id)) }
}

fn FactsHold(values: Valuation(), facts: List<Fact>) → Type {
    match facts { Nil => True, Cons(fact, rest) => fact.Holds(values) ∧ FactsHold(values, rest) }
}

record Facts { by: NatMap<List<Node>>, within: NatMap<Range> }

fn Facts::none() → Facts { Facts(NatMap::empty(), NatMap::empty()) }

// The facts about the word `id`.
fn Facts::about(self facts: Facts, id: Nat) → List<Node> { match nat_map_get(facts.by, id) { None => [], Some(nodes) => nodes } }

fn Facts::has(self facts: Facts, node: Node) → Bool { nodes_have(facts.about(node_output(node).id), node) }

fn Facts::has_all(self facts: Facts, nodes: List<Node>) → Bool {
    match nodes { Nil => True, Cons(node, rest) => facts.has(node) && facts.has_all(rest) }
}

fn Facts::add(self facts: Facts, node: Node) → Facts {
    Facts(nat_map_set(facts.by, node_output(node).id, Cons(node, facts.about(node_output(node).id))), facts.within)
}

// The range known of the word `id`.
fn Facts::range(self facts: Facts, id: Nat) → Range { match nat_map_get(facts.within, id) { None => Range::any(), Some(range) => range } }

// The word `id` is in `range` too.
fn Facts::bound(self facts: Facts, id: Nat, range: Range) → Facts {
    Facts(facts.by, nat_map_set(facts.within, id, facts.range(id).meet(range)))
}

// Every fact holds of `values`.
fn Facts::Hold(self facts: Facts, values: Valuation()) → Type {
    ((id: Nat) → (nodes: List<Node>) → nat_map_get(facts.by, id) = Some(nodes) → NodesHold(values, nodes)) ∧
        ((id: Nat) → (range: Range) → nat_map_get(facts.within, id) = Some(range) → range.Holds(values(64, id)))
}

theorem Facts::none_hold(values: Valuation()): Facts::none().Hold(values) {
    ⟨λ id nodes got => absurd(got), λ id range got => absurd(got)⟩
}

theorem Facts::range_holds(self facts: Facts, values: Valuation(), held: facts.Hold(values), id: Nat): facts.range(id).Holds(values(64, id)) {
    (match nat_map_get(facts.within, id) as λ o => nat_map_get(facts.within, id) = o →
        (match o { None => Range::any(), Some(range) => range }).Holds(values(64, id)) {
        None => λ _ => Range::any_holds(values(64, id)),
        Some(range) => λ got => held.right(id, range, got),
    })(refl)
}

theorem Facts::bound_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), id: Nat, range: Range,
    holds: range.Holds(values(64, id))): facts.bound(id, range).Hold(values) {
    let met = facts.range(id).meet(range);
    ⟨held.left, λ other found got => match id.eq_dec(other) {
        Inl(same) => {
            let here: (nat_map_get(nat_map_set(facts.within, id, met), other) = Some(met)) =
                j(same, λ i _ => nat_map_get(nat_map_set(facts.within, id, met), i) = Some(met), nat_map_get_set_same(facts.within, id, met));
            j(same, λ i _ => found.Holds(values(64, i)),
                j(Option::some_inj(met, found, trans(sym(here), got)), λ r _ => r.Holds(values(64, id)),
                    facts.range(id).meet_holds(range, values(64, id), facts.range_holds(values, held, id), holds)))
        },
        Inr(differs) => held.right(other, found, trans(sym(nat_map_get_set_other(facts.within, id, met, other, differs)), got)),
    }⟩
}

theorem Facts::about_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), id: Nat): NodesHold(values, facts.about(id)) {
    (match nat_map_get(facts.by, id) as λ o => nat_map_get(facts.by, id) = o →
        NodesHold(values, match o { None => [], Some(nodes) => nodes }) {
        None => λ _ => trivial,
        Some(nodes) => λ got => held.left(id, nodes, got),
    })(refl)
}

theorem Facts::has_holds(self facts: Facts, values: Valuation(), held: facts.Hold(values), node: Node, h: facts.has(node) = True):
    NodeHolds(values, node) {
    nodes_have_holds(values, node, facts.about(node_output(node).id), facts.about_hold(values, held, node_output(node).id), h)
}

theorem Facts::has_all_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), nodes: List<Node>):
    facts.has_all(nodes) = True → NodesHold(values, nodes) {
    match nodes {
        Nil => λ _ => trivial,
        Cons(node, rest) => λ h => {
            let both = Bool::and_true_parts(facts.has(node), facts.has_all(rest), h);
            ⟨facts.has_holds(values, held, node, both.left), facts.has_all_hold(values, held, rest, both.right)⟩
        },
    }
}

theorem Facts::add_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), node: Node, holds: NodeHolds(values, node)):
    facts.add(node).Hold(values) {
    let k = node_output(node).id;
    let bucket = Cons(node, facts.about(k));
    ⟨λ id nodes got => match k.eq_dec(id) {
        Inl(same) => {
            let here: (nat_map_get(nat_map_set(facts.by, k, bucket), id) = Some(bucket)) =
                j(same, λ i _ => nat_map_get(nat_map_set(facts.by, k, bucket), i) = Some(bucket), nat_map_get_set_same(facts.by, k, bucket));
            j(Option::some_inj(bucket, nodes, trans(sym(here), got)), λ ns _ => NodesHold(values, ns),
                ⟨holds, facts.about_hold(values, held, k)⟩)
        },
        Inr(other) => held.left(id, nodes, trans(sym(nat_map_get_set_other(facts.by, k, bucket, id, other)), got)),
    }, held.right⟩
}

// A fact is known: a node among the facts, or a range a known one is inside.
fn Facts::knows(self facts: Facts, fact: Fact) → Bool {
    match fact { Is(node) => facts.has(node), Within(id, low, high) => facts.range(id).inside(Range(low, high)) }
}

theorem Facts::knows_holds(self facts: Facts, values: Valuation(), held: facts.Hold(values), fact: Fact): facts.knows(fact) = True → fact.Holds(values) {
    match fact {
        Is(node) => λ h => facts.has_holds(values, held, node, h),
        Within(id, low, high) => λ h => facts.range(id).inside_holds(Range(low, high), values(64, id), h, facts.range_holds(values, held, id)),
    }
}

fn Facts::knows_all(self facts: Facts, wanted: List<Fact>) → Bool {
    match wanted { Nil => True, Cons(fact, rest) => facts.knows(fact) && facts.knows_all(rest) }
}

theorem Facts::knows_all_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), wanted: List<Fact>):
    facts.knows_all(wanted) = True → FactsHold(values, wanted) {
    match wanted {
        Nil => λ _ => trivial,
        Cons(fact, rest) => λ h => {
            let both = Bool::and_true_parts(facts.knows(fact), facts.knows_all(rest), h);
            ⟨facts.knows_holds(values, held, fact, both.left), facts.knows_all_hold(values, held, rest, both.right)⟩
        },
    }
}

fn Facts::with(self facts: Facts, fact: Fact) → Facts {
    match fact { Is(node) => facts.add(node), Within(id, low, high) => facts.bound(id, Range(low, high)) }
}

theorem Facts::with_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), fact: Fact): fact.Holds(values) → facts.with(fact).Hold(values) {
    match fact {
        Is(node) => λ holds => facts.add_hold(values, held, node, holds),
        Within(id, low, high) => λ holds => facts.bound_hold(values, held, id, Range(low, high), holds),
    }
}

// A node that touches no buffer holds where it ran, and runs where it holds.
theorem Node::pure_holds(self node: Node, values: Valuation(), before, after: Buffers()): node.pure() = True →
    node.Runs(values, before, after) → NodeHolds(values, node) {
    match node {
        Const(_, _, _) => λ _ ran => ran.left,
        Move(_, _, _) => λ _ ran => ran.left,
        Add(_, _, _, _) => λ _ ran => ran.left,
        Sub(_, _, _, _) => λ _ ran => ran.left,
        BitAnd(_, _, _, _) => λ _ ran => ran.left,
        BitOr(_, _, _, _) => λ _ ran => ran.left,
        BitXor(_, _, _, _) => λ _ ran => ran.left,
        ShiftLeft(_, _, _, _) => λ _ ran => ran.left,
        LogicalShiftRight(_, _, _, _) => λ _ ran => ran.left,
        ArithmeticShiftRight(_, _, _, _) => λ _ ran => ran.left,
        UnsignedLessThan(_, _, _, _) => λ _ ran => ran.left,
        SignedLessThan(_, _, _, _) => λ _ ran => ran.left,
        Equal(_, _, _, _) => λ _ ran => ran.left,
        BufferLoad(_, _, _) => λ p _ => absurd(p),
        BufferStore(_, _, _, _) => λ p _ => absurd(p),
        Resize(_, _, _, _) => λ _ ran => ran.left,
        SignResize(_, _, _, _) => λ _ ran => ran.left,
    }
}
theorem Node::pure_runs(self node: Node, values: Valuation(), file: Buffers()): node.pure() = True →
    NodeHolds(values, node) → node.Runs(values, file, file) {
    match node {
        Const(_, _, _) => λ _ holds => ⟨holds, refl⟩,
        Move(_, _, _) => λ _ holds => ⟨holds, refl⟩,
        Add(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        Sub(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        BitAnd(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        BitOr(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        BitXor(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        ShiftLeft(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        LogicalShiftRight(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        ArithmeticShiftRight(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        UnsignedLessThan(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        SignedLessThan(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        Equal(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        BufferLoad(_, _, _) => λ p _ => absurd(p),
        BufferStore(_, _, _, _) => λ p _ => absurd(p),
        Resize(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
        SignResize(_, _, _, _) => λ _ holds => ⟨holds, refl⟩,
    }
}

// The facts after a node of the old body: its equation, where it touches
// no buffer.
fn Facts::learn(self facts: Facts, node: Node) → Facts { match node.pure() { True => facts.add(node), False => facts } }

theorem Facts::learn_hold(self facts: Facts, values: Valuation(), node: Node, before, after: Buffers(), held: facts.Hold(values),
    ran: node.Runs(values, before, after)): facts.learn(node).Hold(values) {
    (match node.pure() as λ b => node.pure() = b → (match b { True => facts.add(node), False => facts }).Hold(values) {
        True => λ p => facts.add_hold(values, held, node, node.pure_holds(values, before, after, p, ran)),
        False => λ _ => held,
    })(refl)
}

fn Facts::learn_all(self facts: Facts, nodes: List<Node>) → Facts {
    match nodes { Nil => facts, Cons(node, rest) => facts.learn(node).learn_all(rest) }
}

theorem Facts::learn_all_hold(values: Valuation(), nodes: List<Node>): (facts: Facts) → (before, after: Buffers()) →
    facts.Hold(values) → NodesRun(nodes, values, before, after) → facts.learn_all(nodes).Hold(values) {
    match nodes {
        Nil => λ facts before after held _ => held,
        Cons(node, rest) => λ facts before after held ran =>
            Facts::learn_all_hold(values, rest, facts.learn(node), ran.witness, after,
                facts.learn_hold(values, node, before, ran.witness, held, ran.proof.left), ran.proof.right),
    }
}

// ---------------------------------------------------------------------------
// A node reading other ids

// Whether `new` may be read where `old` is, at `width`: it is the same id,
// or the facts say `old` is a move of it.
fn Facts::reads(self facts: Facts, width, old, new: Nat) → Bool { old.same(new) || facts.has(Move(width, old, new)) }

theorem Facts::reads_same(self facts: Facts, values: Valuation(), held: facts.Hold(values), width, old, new: Nat,
    h: facts.reads(width, old, new) = True): values(width, old) = values(width, new) {
    match Bool::or_true_parts(old.same(new), facts.has(Move(width, old, new)), h) {
        Inl(same) => cong_fn<Nat, BitVec(width)>(λ id => values(width, id), old.same_sound(new, same)),
        Inr(moved) => facts.has_holds(values, held, Move(width, old, new), moved),
    }
}

// The same of a list of words.
fn Facts::reads_all(self facts: Facts, old, new: List<Nat>) → Bool {
    match old {
        Nil => match new { Nil => True, Cons(_, _) => False },
        Cons(id, rest) => match new { Nil => False, Cons(other, more) => facts.reads(64, id, other) && facts.reads_all(rest, more) },
    }
}

theorem Facts::reads_all_same(self facts: Facts, values: Valuation(), held: facts.Hold(values), old: List<Nat>): (new: List<Nat>) →
    facts.reads_all(old, new) = True → words_of(values, old) = words_of(values, new) {
    match old {
        Nil => λ new => match new { Nil => λ _ => refl, Cons(_, _) => λ h => absurd(h) },
        Cons(id, rest) => λ new => match new {
            Nil => λ h => absurd(h),
            Cons(other, more) => λ h => {
                let both = Bool::and_true_parts(facts.reads(64, id, other), facts.reads_all(rest, more), h);
                eq2(λ (word: BitVec(64)) (words: List<BitVec(64)>) => Cons(word, words), facts.reads_same(values, held, 64, id, other, both.left),
                    facts.reads_all_same(values, held, rest, more, both.right))
            },
        },
    }
}

// The node reading `a`, and `b` if it reads two ids, where it read its
// own: made only where the facts say each is what the node read, at the
// width the node reads it.
fn Node::reading(self node: Node, facts: Facts, a, b: Nat) → Option<Node> {
    match node {
        Const(_, _, _) => None,
        Move(w, o, s) => facts.reads(w, s, a).then(Some(Move(w, o, a))),
        Add(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(Add(w, o, a, b))),
        Sub(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(Sub(w, o, a, b))),
        BitAnd(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(BitAnd(w, o, a, b))),
        BitOr(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(BitOr(w, o, a, b))),
        BitXor(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(BitXor(w, o, a, b))),
        ShiftLeft(w, o, v, n) => facts.reads(w, v, a).then(Some(ShiftLeft(w, o, a, n))),
        LogicalShiftRight(w, o, v, n) => facts.reads(w, v, a).then(Some(LogicalShiftRight(w, o, a, n))),
        ArithmeticShiftRight(w, o, v, n) => facts.reads(w, v, a).then(Some(ArithmeticShiftRight(w, o, a, n))),
        UnsignedLessThan(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(UnsignedLessThan(w, o, a, b))),
        SignedLessThan(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(SignedLessThan(w, o, a, b))),
        Equal(w, o, l, r) => (facts.reads(w, l, a) && facts.reads(w, r, b)).then(Some(Equal(w, o, a, b))),
        BufferLoad(o, f, i) => facts.reads(64, i, a).then(Some(BufferLoad(o, f, a))),
        BufferStore(o, f, i, v) => (facts.reads(64, i, a) && facts.reads(64, v, b)).then(Some(BufferStore(o, f, a, b))),
        Resize(from, to, o, s) => facts.reads(from, s, a).then(Some(Resize(from, to, o, a))),
        SignResize(from, to, o, s) => facts.reads(from, s, a).then(Some(SignResize(from, to, o, a))),
    }
}

theorem Facts::reads_one(self facts: Facts, values: Valuation(), held: facts.Hold(values), width, old, a: Nat, made, new: Node,
    h: facts.reads(width, old, a).then(Some(made)) = Some(new)): (values(width, old) = values(width, a)) ∧ (made = new) {
    let got = Bool::then_some(facts.reads(width, old, a), Some(made), new, h);
    ⟨facts.reads_same(values, held, width, old, a, got.left), Option::some_inj(made, new, got.right)⟩
}

theorem Facts::reads_two(self facts: Facts, values: Valuation(), held: facts.Hold(values), width, left, right, a, b: Nat, made, new: Node,
    h: (facts.reads(width, left, a) && facts.reads(width, right, b)).then(Some(made)) = Some(new)):
    ((values(width, left) = values(width, a)) ∧ (values(width, right) = values(width, b))) ∧ (made = new) {
    let got = Bool::then_some(facts.reads(width, left, a) && facts.reads(width, right, b), Some(made), new, h);
    let both = Bool::and_true_parts(facts.reads(width, left, a), facts.reads(width, right, b), got.left);
    ⟨⟨facts.reads_same(values, held, width, left, a, both.left), facts.reads_same(values, held, width, right, b, both.right)⟩,
        Option::some_inj(made, new, got.right)⟩
}

// It runs wherever the node ran: what it reads is what the node read.
theorem Node::reading_runs(self node: Node, facts: Facts, values: Valuation(), held: facts.Hold(values), a, b: Nat, before, after: Buffers()):
    (new: Node) → node.reading(facts, a, b) = Some(new) → node.Runs(values, before, after) → new.Runs(values, before, after) {
    match node {
        Const(_, _, _) => λ new made ran => absurd(made),
        Move(w, o, s) => λ new made ran => {
            let got = facts.reads_one(values, held, w, s, a, Move(w, o, a), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after), ⟨trans(ran.left, got.left), ran.right⟩)
        },
        Add(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, Add(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y), got.left.left, got.left.right)), ran.right⟩)
        },
        Sub(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, Sub(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y), got.left.left, got.left.right)), ran.right⟩)
        },
        BitAnd(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, BitAnd(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y), got.left.left, got.left.right)), ran.right⟩)
        },
        BitOr(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, BitOr(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y), got.left.left, got.left.right)), ran.right⟩)
        },
        BitXor(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, BitXor(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y), got.left.left, got.left.right)), ran.right⟩)
        },
        ShiftLeft(w, o, v, n) => λ new made ran => {
            let got = facts.reads_one(values, held, w, v, a, ShiftLeft(w, o, a, n), new, made);
            j(got.right, λ m _ => m.Runs(values, before, after), ⟨trans(ran.left, cong_fn(λ (x: BitVec(w)) => x.shift_left(n), got.left)), ran.right⟩)
        },
        LogicalShiftRight(w, o, v, n) => λ new made ran => {
            let got = facts.reads_one(values, held, w, v, a, LogicalShiftRight(w, o, a, n), new, made);
            j(got.right, λ m _ => m.Runs(values, before, after), ⟨trans(ran.left, cong_fn(λ (x: BitVec(w)) => x.shift_right(n), got.left)), ran.right⟩)
        },
        ArithmeticShiftRight(w, o, v, n) => λ new made ran => {
            let got = facts.reads_one(values, held, w, v, a, ArithmeticShiftRight(w, o, a, n), new, made);
            j(got.right, λ m _ => m.Runs(values, before, after), ⟨trans(ran.left, cong_fn(λ (x: BitVec(w)) => x.arithmetic_shift_right(n), got.left)), ran.right⟩)
        },
        UnsignedLessThan(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, UnsignedLessThan(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => BitVec::ofBool(x.unsigned_lt_bit(y)), got.left.left, got.left.right)), ran.right⟩)
        },
        SignedLessThan(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, SignedLessThan(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => BitVec::ofBool(x.signed_lt_bit(y)), got.left.left, got.left.right)), ran.right⟩)
        },
        Equal(w, o, l, r) => λ new made ran => {
            let got = facts.reads_two(values, held, w, l, r, a, b, Equal(w, o, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, eq2(λ (x: BitVec(w)) (y: BitVec(w)) => BitVec::ofBool(x.eq_bit(y)), got.left.left, got.left.right)), ran.right⟩)
        },
        BufferLoad(o, f, i) => λ new made ran => {
            let got = facts.reads_one(values, held, 64, i, a, BufferLoad(o, f, a), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, cong_fn(λ (x: BitVec(64)) => byte_word(buffer_byte(before, f, x.toNat())), got.left)), ran.right⟩)
        },
        BufferStore(o, f, i, v) => λ new made ran => {
            let got = facts.reads_two(values, held, 64, i, v, a, b, BufferStore(o, f, a, b), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                j(got.left.left, λ x _ => (after = store_byte(before, f, x.toNat(), low_byte(values(64, b)))) ∧
                        (values(64, o) = byte_word(buffer_byte(after, f, x.toNat()))),
                    j(got.left.right, λ y _ => (after = store_byte(before, f, values(64, i).toNat(), low_byte(y))) ∧
                        (values(64, o) = byte_word(buffer_byte(after, f, values(64, i).toNat()))), ran)))
        },
        Resize(from, to, o, s) => λ new made ran => {
            let got = facts.reads_one(values, held, from, s, a, Resize(from, to, o, a), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after),
                ⟨trans(ran.left, cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := to), got.left)), ran.right⟩)
        },
        SignResize(from, to, o, s) => λ new made ran => {
            let got = facts.reads_one(values, held, from, s, a, SignResize(from, to, o, a), new, made);
            j(got.right, λ n _ => n.Runs(values, before, after), ⟨trans(ran.left, cong_fn(λ (x: BitVec(from)) => x.sresize(to), got.left)), ran.right⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// Rules: a clause over nodes, made from an instance's ids and literals,
// with its proof at every instance

record Clause { premises: List<Fact>, conclusion: Fact }

fn Clause::Sound(self clause: Clause) → Type {
    (values: Valuation()) → FactsHold(values, clause.premises) → clause.conclusion.Holds(values)
}

record Rule {
    make: List<Nat> → Option<Clause>,
    sound: (args: List<Nat>) → (clause: Clause) → make(args) = Some(clause) → clause.Sound(),
}

// ---------------------------------------------------------------------------
// The replayer

inductive Step {
    // The next node of the old body, as it is.
    Keep,
    // The next node of the old body, left out (never a store).
    Drop,
    // A node that is among the facts, written here.
    Emit(node: Node),
    // A rule's conclusion at an instance whose premises are among the facts.
    Derive(rule: Nat, args: List<Nat>),
    // The next node of the old body reading `a`, and `b` if it reads two
    // ids, where the facts say they are what it read.
    Swap(a: Nat, b: Nat),
}

record Replayed { nodes: List<Node>, facts: Facts }

fn Facts::derive(self facts: Facts, table: List<Rule>, rule: Nat, args: List<Nat>) → Option<Facts> {
    table.nth(rule).and_then(λ found => found.make(args).and_then(λ clause =>
        facts.knows_all(clause.premises).then(Some(facts.with(clause.conclusion)))))
}

fn Replayed::after(node: Node, rest: Option<Replayed>) → Option<Replayed> {
    rest.and_then(λ r => Some(Replayed(Cons(node, r.nodes), r.facts)))
}

fn replay(table: List<Rule>, facts: Facts, nodes: List<Node>, steps: List<Step>) → Option<Replayed> {
    match steps {
        Nil => Some(Replayed(nodes, facts.learn_all(nodes))),
        Cons(step, later) => match step {
            Keep => match nodes {
                Nil => None,
                Cons(node, rest) => Replayed::after(node, replay(table, facts.learn(node), rest, later)),
            },
            Drop => match nodes {
                Nil => None,
                Cons(node, rest) => (!node.stores()).then(replay(table, facts.learn(node), rest, later)),
            },
            Emit(node) => (node.pure() && facts.has(node)).then(Replayed::after(node, replay(table, facts, nodes, later))),
            Derive(rule, args) => match facts.derive(table, rule, args) {
                None => None,
                Some(more) => replay(table, more, nodes, later),
            },
            Swap(a, b) => match nodes {
                Nil => None,
                Cons(node, rest) => node.reading(facts, a, b).and_then(λ new =>
                    Replayed::after(new, replay(table, facts.learn(node).learn(new), rest, later))),
            },
        },
    }
}

theorem Replayed::after_some(node: Node, rest: Option<Replayed>, r: Replayed, h: Replayed::after(node, rest) = Some(r)):
    Exists<Replayed>(λ r0 => (rest = Some(r0)) ∧ (Replayed(Cons(node, r0.nodes), r0.facts) = r)) {
    let got = Option::and_then_some(rest, λ (r0: Replayed) => Some(Replayed(Cons(node, r0.nodes), r0.facts)), r, h);
    Exists(got.witness, ⟨got.proof.left, Option::some_inj(Replayed(Cons(node, got.witness.nodes), got.witness.facts), r, got.proof.right)⟩)
}

theorem Facts::derive_hold(self facts: Facts, table: List<Rule>, values: Valuation(), rule: Nat, args: List<Nat>, more: Facts,
    held: facts.Hold(values), h: facts.derive(table, rule, args) = Some(more)): more.Hold(values) {
    let a = Option::and_then_some(table.nth(rule), λ (found: Rule) => found.make(args).and_then(λ clause =>
        facts.knows_all(clause.premises).then(Some(facts.with(clause.conclusion)))), more, h);
    let found = a.witness;
    let b = Option::and_then_some(found.make(args), λ (clause: Clause) => facts.knows_all(clause.premises).then(Some(facts.with(clause.conclusion))), more, a.proof.right);
    let clause = b.witness;
    let c = Bool::then_some(facts.knows_all(clause.premises), Some(facts.with(clause.conclusion)), more, b.proof.right);
    let sound = found.sound(args, clause, b.proof.left);
    let concluded = sound(values, facts.knows_all_hold(values, held, clause.premises, c.left));
    j(Option::some_inj(facts.with(clause.conclusion), more, c.right), λ m _ => m.Hold(values),
        facts.with_hold(values, held, clause.conclusion, concluded))
}

// Whatever the plan, what the replayer returns runs wherever the old nodes
// ran, over the same valuation and files, and its facts hold there.
theorem replay_sound(table: List<Rule>, values: Valuation(), steps: List<Step>): (facts: Facts) → (nodes: List<Node>) → (r: Replayed) →
    replay(table, facts, nodes, steps) = Some(r) → (before, after: Buffers()) → facts.Hold(values) →
    NodesRun(nodes, values, before, after) → NodesRun(r.nodes, values, before, after) ∧ r.facts.Hold(values) {
    match steps {
        Nil => λ facts nodes r made before after held ran =>
            j(Option::some_inj(Replayed(nodes, facts.learn_all(nodes)), r, made),
                λ x _ => NodesRun(x.nodes, values, before, after) ∧ x.facts.Hold(values),
                ⟨ran, Facts::learn_all_hold(values, nodes, facts, before, after, held, ran)⟩),
        Cons(step, later) => match step {
            Keep => λ facts nodes => match nodes {
                Nil => λ r made before after held ran => absurd(made),
                Cons(node, rest) => λ r made before after held ran => {
                    let got = Replayed::after_some(node, replay(table, facts.learn(node), rest, later), r, made);
                    let ih = replay_sound(table, values, later, facts.learn(node), rest, got.witness, got.proof.left, ran.witness, after,
                        facts.learn_hold(values, node, before, ran.witness, held, ran.proof.left), ran.proof.right);
                    j(got.proof.right, λ x _ => NodesRun(x.nodes, values, before, after) ∧ x.facts.Hold(values),
                        ⟨Exists(ran.witness, ⟨ran.proof.left, ih.left⟩), ih.right⟩)
                },
            },
            Drop => λ facts nodes => match nodes {
                Nil => λ r made before after held ran => absurd(made),
                Cons(node, rest) => λ r made before after held ran => {
                    let got = Bool::then_some(!node.stores(), replay(table, facts.learn(node), rest, later), r, made);
                    let here = node.runs_still(values, before, ran.witness, Bool::is_true_of_eq(got.left), ran.proof.left);
                    let ih = replay_sound(table, values, later, facts.learn(node), rest, r, got.right, ran.witness, after,
                        facts.learn_hold(values, node, before, ran.witness, held, ran.proof.left), ran.proof.right);
                    ⟨j(here.left, λ m _ => NodesRun(r.nodes, values, m, after), ih.left), ih.right⟩
                },
            },
            Emit(node) => λ facts nodes r made before after held ran => {
                let ok = Bool::then_some(node.pure() && facts.has(node), Replayed::after(node, replay(table, facts, nodes, later)), r, made);
                let both = Bool::and_true_parts(node.pure(), facts.has(node), ok.left);
                let got = Replayed::after_some(node, replay(table, facts, nodes, later), r, ok.right);
                let ih = replay_sound(table, values, later, facts, nodes, got.witness, got.proof.left, before, after, held, ran);
                j(got.proof.right, λ x _ => NodesRun(x.nodes, values, before, after) ∧ x.facts.Hold(values),
                    ⟨Exists(before, ⟨node.pure_runs(values, before, both.left, facts.has_holds(values, held, node, both.right)), ih.left⟩),
                        ih.right⟩)
            },
            Derive(rule, args) => λ facts nodes r => (match facts.derive(table, rule, args) as λ o =>
                facts.derive(table, rule, args) = o → (match o { Some(more) => replay(table, more, nodes, later), None => None }) = Some(r) →
                (before, after: Buffers()) → facts.Hold(values) → NodesRun(nodes, values, before, after) →
                NodesRun(r.nodes, values, before, after) ∧ r.facts.Hold(values) {
                None => λ _ made before after held ran => absurd(made),
                Some(more) => λ derived made before after held ran =>
                    replay_sound(table, values, later, more, nodes, r, made, before, after,
                        facts.derive_hold(table, values, rule, args, more, held, derived), ran),
            })(refl),
            Swap(a, b) => λ facts nodes => match nodes {
                Nil => λ r made before after held ran => absurd(made),
                Cons(node, rest) => λ r made before after held ran => {
                    let read = Option::and_then_some(node.reading(facts, a, b), λ (new: Node) =>
                        Replayed::after(new, replay(table, facts.learn(node).learn(new), rest, later)), r, made);
                    let new = read.witness;
                    let runs = node.reading_runs(facts, values, held, a, b, before, ran.witness, new, read.proof.left, ran.proof.left);
                    let got = Replayed::after_some(new, replay(table, facts.learn(node).learn(new), rest, later), r, read.proof.right);
                    let ih = replay_sound(table, values, later, facts.learn(node).learn(new), rest, got.witness, got.proof.left, ran.witness, after,
                        facts.learn(node).learn_hold(values, new, before, ran.witness,
                            facts.learn_hold(values, node, before, ran.witness, held, ran.proof.left), runs), ran.proof.right);
                    j(got.proof.right, λ x _ => NodesRun(x.nodes, values, before, after) ∧ x.facts.Hold(values),
                        ⟨Exists(ran.witness, ⟨runs, ih.left⟩), ih.right⟩)
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Structured regions

// A plan for a region, in the region's shape. `Same` leaves a region as it
// is and learns nothing from it; a list of no steps keeps every node and
// learns each.
inductive Plan {
    Same,
    // A dataflow region's nodes.
    Nodes(steps: List<Step>),
    // A sequence: its prefix's nodes, then its continuation.
    Then(steps: List<Step>, rest: Plan),
    // A composition's two parts, the second with the facts the first left.
    Both(first: Plan, second: Plan),
    // A conditional's arms, each from the facts before it and its bit: one
    // where it is taken set, zero where clear.
    Arms(when_true: Plan, when_false: Plan),
    // A conditional whose bit the facts say is one (`taken`) or zero, as
    // the arm that takes.
    Arm(taken: Bool, arm: Plan),
    // A loop's body, from the ranges of the inputs its passes do not
    // change: a pass has a valuation of its own.
    Body(body: Plan),
    // The same after derivations, which those ranges may be from (what a
    // step emits here has no place and is dropped).
    Derived(steps: List<Step>, body: Plan),
    // A call on other arguments, which the facts say are the words it took.
    Args(arguments: List<Nat>),
    // A loop from other inputs, which the facts say are the words it
    // started from, and its body.
    Inputs(inputs: List<Nat>, body: Plan),
}

record Regioned { region: StructuredRegion, facts: Facts }

// ---------------------------------------------------------------------------
// What a loop does not change

// Runs whose passes satisfy a weaker condition, where each pass from a
// state `kept` holds of satisfies it and leaves such a state; and the
// loop ends in one.
theorem loop_runs_over_kept(pass, weaker: Valuation() → Buffers() → Buffers() → Type, parameters, next: List<Nat>, kept: List<BitVec(64)> → Type,
    step: (values: Valuation()) → (before, after: Buffers()) → kept(words_of(values, parameters)) → pass(values, before, after) →
        weaker(values, before, after) ∧ kept(words_of(values, next)),
    count, exit: Nat, remaining: Nat):
    (state, final: List<BitVec(64)>) → (exhausted: Bool) → (before, after: Buffers()) → kept(state) →
    LoopRunsOver(pass, parameters, count, exit, next, remaining, state, final, exhausted, before, after) →
    LoopRunsOver(weaker, parameters, count, exit, next, remaining, state, final, exhausted, before, after) ∧ kept(final) {
    match remaining {
        Zero => λ state final exhausted before after holds ran => ⟨ran, j(sym(ran.left), λ s _ => kept(s), holds)⟩,
        Succ(rest) => λ state final exhausted before after holds ran => {
            let values = ran.witness;
            let mid = ran.proof.witness;
            let held = ran.proof.proof;
            let here = step(values, before, mid, j(sym(held.left), λ s _ => kept(s), holds), held.right.right.left);
            let tail = (match values(1, exit).head_bit() as λ b =>
                (match b {
                    False => LoopRunsOver(pass, parameters, count, exit, next, rest, words_of(values, next), final, exhausted, mid, after),
                    True => (final = words_of(values, next)) ∧ ((exhausted = False) ∧ (after = mid)),
                }) →
                (match b {
                    False => LoopRunsOver(weaker, parameters, count, exit, next, rest, words_of(values, next), final, exhausted, mid, after),
                    True => (final = words_of(values, next)) ∧ ((exhausted = False) ∧ (after = mid)),
                }) ∧ kept(final) {
                False => λ later => loop_runs_over_kept(pass, weaker, parameters, next, kept, step, count, exit, rest,
                    words_of(values, next), final, exhausted, mid, after, here.right, later),
                True => λ done => ⟨done, j(sym(done.left), λ s _ => kept(s), here.right)⟩,
            })(held.right.right.right);
            ⟨Exists(values, Exists(mid, ⟨held.left, ⟨held.right.left, ⟨here.left, tail.left⟩⟩⟩)), tail.right⟩
        },
    }
}

fn carried(same: Bool, range: Range) → Option<Range> { match same { True => Some(range), False => None } }

fn Marked(mark: Option<Range>, word: BitVec(64)) → Type { match mark { None => True, Some(range) => range.Holds(word) } }

// A parameter that is its own next has, in every pass, the value its input
// had: the ranges known of such inputs, by place.
fn Facts::carry(self facts: Facts, inputs, parameters, next: List<Nat>) → List<Option<Range>> {
    match inputs {
        Nil => [],
        Cons(input, more) => match parameters {
            Nil => [],
            Cons(parameter, others) => match next {
                Nil => [],
                Cons(after, later) => Cons(carried(parameter.same(after), facts.range(input)), facts.carry(more, others, later)),
            },
        },
    }
}

fn Kept(marks: List<Option<Range>>, state: List<BitVec(64)>) → Type {
    match marks {
        Nil => True,
        Cons(mark, rest) => match state {
            Nil => True,
            Cons(word, words) => Marked(mark, word) ∧ Kept(rest, words),
        },
    }
}

// The loop starts from such a state.
theorem Facts::carry_start(self facts: Facts, values: Valuation(), held: facts.Hold(values), inputs: List<Nat>): (parameters, next: List<Nat>) →
    Kept(facts.carry(inputs, parameters, next), words_of(values, inputs)) {
    match inputs {
        Nil => λ parameters next => trivial,
        Cons(input, more) => λ parameters => match parameters {
            Nil => λ next => trivial,
            Cons(parameter, others) => λ next => match next {
                Nil => trivial,
                Cons(after, later) => ⟨(match parameter.same(after) as λ b => Marked(carried(b, facts.range(input)), values(64, input)) {
                    True => facts.range_holds(values, held, input),
                    False => trivial,
                }), facts.carry_start(values, held, more, others, later)⟩,
            },
        },
    }
}

// And a pass leaves one.
theorem Facts::carry_next(self facts: Facts, pass: Valuation(), inputs: List<Nat>): (parameters, next: List<Nat>) →
    Kept(facts.carry(inputs, parameters, next), words_of(pass, parameters)) → Kept(facts.carry(inputs, parameters, next), words_of(pass, next)) {
    match inputs {
        Nil => λ parameters next kept => trivial,
        Cons(input, more) => λ parameters => match parameters {
            Nil => λ next kept => trivial,
            Cons(parameter, others) => λ next => match next {
                Nil => λ kept => trivial,
                Cons(after, later) => λ kept => ⟨(match parameter.same(after) as λ b => parameter.same(after) = b →
                    Marked(carried(b, facts.range(input)), pass(64, parameter)) → Marked(carried(b, facts.range(input)), pass(64, after)) {
                    True => λ same holds => j(parameter.same_sound(after, same), λ id _ => facts.range(input).Holds(pass(64, id)), holds),
                    False => λ _ _ => trivial,
                })(refl, kept.left), facts.carry_next(pass, more, others, later, kept.right)⟩,
            },
        },
    }
}

// Facts with those ranges of `ids`: of a loop's parameters, what a pass's
// valuation is known to satisfy; of its outputs, what the loop leaves.
fn Facts::kept(self facts: Facts, marks: List<Option<Range>>, ids: List<Nat>) → Facts {
    match marks {
        Nil => facts,
        Cons(mark, rest) => match ids {
            Nil => facts,
            Cons(id, others) => match mark { None => facts.kept(rest, others), Some(range) => facts.kept(rest, others).bound(id, range) },
        },
    }
}

theorem Facts::kept_hold(self facts: Facts, values: Valuation(), held: facts.Hold(values), marks: List<Option<Range>>): (ids: List<Nat>) →
    Kept(marks, words_of(values, ids)) → facts.kept(marks, ids).Hold(values) {
    match marks {
        Nil => λ ids kept => held,
        Cons(mark, rest) => λ ids => match ids {
            Nil => λ kept => held,
            Cons(id, others) => match mark {
                None => λ kept => facts.kept_hold(values, held, rest, others, kept.right),
                Some(range) => λ kept => facts.kept(rest, others).bound_hold(values, facts.kept_hold(values, held, rest, others, kept.right), id, range, kept.left),
            },
        },
    }
}

// A loop whose body is rewritten under those facts runs where it ran, and
// leaves its outputs in those ranges.
theorem loop_kept(effects: Effects(), facts: Facts, values: Valuation(), held: facts.Hold(values), inputs, parameters, next: List<Nat>,
    body, new: StructuredRegion,
    sound: (pass: Valuation()) → (from, to: Buffers()) → Facts::none().kept(facts.carry(inputs, parameters, next), parameters).Hold(pass) →
        StructuredRegionRunsOver(effects, pass, body, from, to) → StructuredRegionRunsOver(effects, pass, new, from, to),
    count, exit: Nat, remaining: Nat, final: List<BitVec(64)>, exhausted: Bool, before, after: Buffers(),
    ran: LoopRunsOver(λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, body, from, to),
        parameters, count, exit, next, remaining, words_of(values, inputs), final, exhausted, before, after)):
    LoopRunsOver(λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, new, from, to),
        parameters, count, exit, next, remaining, words_of(values, inputs), final, exhausted, before, after) ∧
    Kept(facts.carry(inputs, parameters, next), final) {
    loop_runs_over_kept(λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, body, from, to),
        λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, new, from, to),
        parameters, next, λ (state: List<BitVec(64)>) => Kept(facts.carry(inputs, parameters, next), state),
        λ pass from to kept old => ⟨sound(pass, from, to,
                Facts::none().kept_hold(pass, Facts::none_hold(pass), facts.carry(inputs, parameters, next), parameters, kept), old),
            facts.carry_next(pass, inputs, parameters, next, kept)⟩,
        count, exit, remaining, words_of(values, inputs), final, exhausted, before, after, facts.carry_start(values, held, inputs, parameters, next), ran)
}

// A conditional's bit in the arm taken where it is `taken`.
fn bit_fact(condition: Nat, taken: Bool) → Node { Const(1, condition, match taken { True => 1, False => 0 }) }

theorem bit_set(): BitVec::ofBool(True) = BitVec::ofNat(1, n := 1) { refl }
theorem bit_clear(): BitVec::ofBool(False) = BitVec::ofNat(0, n := 1) { refl }

theorem bit_fact_holds(values: Valuation(), condition: Nat, taken: Bool, bit: values(1, condition).head_bit() = taken):
    NodeHolds(values, bit_fact(condition, taken)) {
    (match taken as λ t => values(1, condition).head_bit() = t → values(1, condition) = BitVec::ofNat(match t { True => 1, False => 0 }) {
        True => λ set => trans(trans(BitVec::one_bit_eq_ofBool(values(1, condition)), cong_fn(λ (h: Bool) => BitVec::ofBool(h), set)), bit_set()),
        False => λ clear => trans(trans(BitVec::one_bit_eq_ofBool(values(1, condition)), cong_fn(λ (h: Bool) => BitVec::ofBool(h), clear)), bit_clear()),
    })(bit)
}

theorem bit_fact_head(values: Valuation(), condition: Nat, taken: Bool, holds: NodeHolds(values, bit_fact(condition, taken))):
    values(1, condition).head_bit() = taken {
    (match taken as λ t => values(1, condition) = BitVec::ofNat(match t { True => 1, False => 0 }) → values(1, condition).head_bit() = t {
        True => λ one => cong_fn(λ (b: BitVec(1)) => b.head_bit(), one),
        False => λ zero => cong_fn(λ (b: BitVec(1)) => b.head_bit(), zero),
    })(holds)
}

fn replay_region(table: List<Rule>, region: StructuredRegion) → Facts → Plan → Option<Regioned> {
    match region {
        Dataflow(body) => λ facts plan => match plan {
            Same => Some(Regioned(Dataflow(body), facts)),
            Nodes(steps) => replay(table, facts, body.nodes, steps).and_then(λ r =>
                Some(Regioned(Dataflow(Region(body.inputs, r.nodes, body.outputs)), r.facts))),
            _ => None,
        },
        Sequence(prefix, continuation) => λ facts plan => match plan {
            Same => Some(Regioned(Sequence(prefix, continuation), facts)),
            Then(steps, rest) => replay(table, facts, prefix.nodes, steps).and_then(λ r =>
                replay_region(table, continuation, r.facts, rest).and_then(λ c =>
                    Some(Regioned(Sequence(Region(prefix.inputs, r.nodes, prefix.outputs), c.region), c.facts)))),
            _ => None,
        },
        Compose(prefix, continuation) => λ facts plan => match plan {
            Same => Some(Regioned(Compose(prefix, continuation), facts)),
            Both(first, second) => replay_region(table, prefix, facts, first).and_then(λ a =>
                replay_region(table, continuation, a.facts, second).and_then(λ b =>
                    Some(Regioned(Compose(a.region, b.region), b.facts)))),
            _ => None,
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ facts plan => match plan {
            Same => Some(Regioned(Conditional(inputs, condition, arguments, outputs, when_true, when_false), facts)),
            Arms(yes, no) => replay_region(table, when_true, facts.add(bit_fact(condition, True)), yes).and_then(λ a =>
                replay_region(table, when_false, facts.add(bit_fact(condition, False)), no).and_then(λ b =>
                    Some(Regioned(Conditional(inputs, condition, arguments, outputs, a.region, b.region), facts)))),
            Arm(taken, inner) => facts.has(bit_fact(condition, taken)).then(match taken {
                True => replay_region(table, when_true, facts, inner),
                False => replay_region(table, when_false, facts, inner),
            }),
            _ => None,
        },
        Call(callee, arguments, result) => λ facts plan => match plan {
            Same => Some(Regioned(Call(callee, arguments, result), facts)),
            Args(others) => facts.reads_all(arguments, others).then(Some(Regioned(Call(callee, others, result), facts))),
            _ => None,
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ facts plan => match plan {
            Same => Some(Regioned(Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted), facts)),
            Body(inner) => replay_region(table, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters), inner).and_then(λ b =>
                Some(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs)))),
            Derived(steps, inner) => replay(table, facts, [], steps).and_then(λ d =>
                replay_region(table, body, Facts::none().kept(d.facts.carry(inputs, parameters, next), parameters), inner).and_then(λ b =>
                    Some(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), d.facts.kept(d.facts.carry(inputs, parameters, next), outputs))))),
            Inputs(others, inner) => facts.reads_all(inputs, others).then(
                replay_region(table, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters), inner).and_then(λ b =>
                    Some(Regioned(Loop(others, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs))))),
            _ => None,
        },
        Lend(views, callee, arguments, result) => λ facts plan => match plan {
            Same => Some(Regioned(Lend(views, callee, arguments, result), facts)),
            _ => None,
        },
    }
}

// What a replayed region owes: it runs where the old one ran, and its
// facts hold.
fn Regioned::Sound(self r: Regioned, effects: Effects(), values: Valuation(), before, after: Buffers()) → Type {
    StructuredRegionRunsOver(effects, values, r.region, before, after) ∧ r.facts.Hold(values)
}

theorem replay_region_sound(table: List<Rule>, effects: Effects(), region: StructuredRegion): (facts: Facts) → (plan: Plan) → (r: Regioned) →
    replay_region(table, region, facts, plan) = Some(r) → (values: Valuation()) → (before, after: Buffers()) → facts.Hold(values) →
    StructuredRegionRunsOver(effects, values, region, before, after) → r.Sound(effects, values, before, after) {
    match region {
        Dataflow(body) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Dataflow(body), facts), r, made), λ x _ => x.Sound(effects, values, before, after), ⟨ran, held⟩),
            Nodes(steps) => λ r made values before after held ran => {
                let got = Option::and_then_some(replay(table, facts, body.nodes, steps), λ (n: Replayed) => Some(Regioned(Dataflow(Region(body.inputs, n.nodes, body.outputs)), n.facts)), r, made);
                let n = got.witness;
                let ok = replay_sound(table, values, steps, facts, body.nodes, n, got.proof.left, before, after, held, ran);
                j(Option::some_inj(Regioned(Dataflow(Region(body.inputs, n.nodes, body.outputs)), n.facts), r, got.proof.right),
                    λ x _ => x.Sound(effects, values, before, after), ok)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Sequence(prefix, continuation) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Sequence(prefix, continuation), facts), r, made), λ x _ => x.Sound(effects, values, before, after),
                    ⟨ran, held⟩),
            Then(steps, rest) => λ r made values before after held ran => {
                let got = Option::and_then_some(replay(table, facts, prefix.nodes, steps), λ (n: Replayed) => replay_region(table, continuation, n.facts, rest).and_then(λ c =>
                    Some(Regioned(Sequence(Region(prefix.inputs, n.nodes, prefix.outputs), c.region), c.facts))), r, made);
                let n = got.witness;
                let more = Option::and_then_some(replay_region(table, continuation, n.facts, rest), λ (c: Regioned) =>
                    Some(Regioned(Sequence(Region(prefix.inputs, n.nodes, prefix.outputs), c.region), c.facts)), r, got.proof.right);
                let c = more.witness;
                let first = replay_sound(table, values, steps, facts, prefix.nodes, n, got.proof.left, before, ran.witness, held, ran.proof.left);
                let second = replay_region_sound(table, effects, continuation, n.facts, rest, c, more.proof.left, values, ran.witness, after,
                    first.right, ran.proof.right);
                j(Option::some_inj(Regioned(Sequence(Region(prefix.inputs, n.nodes, prefix.outputs), c.region), c.facts), r, more.proof.right),
                    λ x _ => x.Sound(effects, values, before, after), ⟨Exists(ran.witness, ⟨first.left, second.left⟩), second.right⟩)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Compose(prefix, continuation) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Compose(prefix, continuation), facts), r, made), λ x _ => x.Sound(effects, values, before, after),
                    ⟨ran, held⟩),
            Both(first, second) => λ r made values before after held ran => {
                let got = Option::and_then_some(replay_region(table, prefix, facts, first), λ (a: Regioned) => replay_region(table, continuation, a.facts, second).and_then(λ b =>
                    Some(Regioned(Compose(a.region, b.region), b.facts))), r, made);
                let a = got.witness;
                let more = Option::and_then_some(replay_region(table, continuation, a.facts, second), λ (b: Regioned) => Some(Regioned(Compose(a.region, b.region), b.facts)), r, got.proof.right);
                let b = more.witness;
                let one = replay_region_sound(table, effects, prefix, facts, first, a, got.proof.left, values, before, ran.witness, held,
                    ran.proof.left);
                let two = replay_region_sound(table, effects, continuation, a.facts, second, b, more.proof.left, values, ran.witness, after,
                    one.right, ran.proof.right);
                j(Option::some_inj(Regioned(Compose(a.region, b.region), b.facts), r, more.proof.right),
                    λ x _ => x.Sound(effects, values, before, after), ⟨Exists(ran.witness, ⟨one.left, two.left⟩), two.right⟩)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Conditional(inputs, condition, arguments, outputs, when_true, when_false), facts), r, made),
                    λ x _ => x.Sound(effects, values, before, after), ⟨ran, held⟩),
            Arms(yes, no) => λ r made values before after held ran => {
                let got = Option::and_then_some(replay_region(table, when_true, facts.add(bit_fact(condition, True)), yes), λ (a: Regioned) =>
                    replay_region(table, when_false, facts.add(bit_fact(condition, False)), no).and_then(λ b =>
                        Some(Regioned(Conditional(inputs, condition, arguments, outputs, a.region, b.region), facts))), r, made);
                let a = got.witness;
                let more = Option::and_then_some(replay_region(table, when_false, facts.add(bit_fact(condition, False)), no), λ (b: Regioned) =>
                    Some(Regioned(Conditional(inputs, condition, arguments, outputs, a.region, b.region), facts)), r, got.proof.right);
                let b = more.witness;
                let taken = (match values(1, condition).head_bit() as λ h => values(1, condition).head_bit() = h →
                    (match h {
                        False => StructuredRegionRunsOver(effects, values, when_false, before, after),
                        True => StructuredRegionRunsOver(effects, values, when_true, before, after),
                    }) →
                    (match h {
                        False => StructuredRegionRunsOver(effects, values, b.region, before, after),
                        True => StructuredRegionRunsOver(effects, values, a.region, before, after),
                    }) {
                    False => λ bit arm => replay_region_sound(table, effects, when_false, facts.add(bit_fact(condition, False)), no, b, more.proof.left,
                        values, before, after, facts.add_hold(values, held, bit_fact(condition, False), bit_fact_holds(values, condition, False, bit)), arm).left,
                    True => λ bit arm => replay_region_sound(table, effects, when_true, facts.add(bit_fact(condition, True)), yes, a, got.proof.left,
                        values, before, after, facts.add_hold(values, held, bit_fact(condition, True), bit_fact_holds(values, condition, True, bit)), arm).left,
                })(refl, ran);
                j(Option::some_inj(Regioned(Conditional(inputs, condition, arguments, outputs, a.region, b.region), facts), r, more.proof.right),
                    λ x _ => x.Sound(effects, values, before, after), ⟨taken, held⟩)
            },
            Arm(taken, inner) => λ r made values before after held ran => {
                let ok = Bool::then_some(facts.has(bit_fact(condition, taken)), match taken {
                    True => replay_region(table, when_true, facts, inner),
                    False => replay_region(table, when_false, facts, inner),
                }, r, made);
                let bit = bit_fact_head(values, condition, taken, facts.has_holds(values, held, bit_fact(condition, taken), ok.left));
                (match taken as λ t => values(1, condition).head_bit() = t →
                    (match t { True => replay_region(table, when_true, facts, inner), False => replay_region(table, when_false, facts, inner) }) = Some(r) →
                    r.Sound(effects, values, before, after) {
                    True => λ set arm => replay_region_sound(table, effects, when_true, facts, inner, r, arm, values, before, after, held,
                        j(set, λ h _ => match h {
                            False => StructuredRegionRunsOver(effects, values, when_false, before, after),
                            True => StructuredRegionRunsOver(effects, values, when_true, before, after),
                        }, ran)),
                    False => λ clear arm => replay_region_sound(table, effects, when_false, facts, inner, r, arm, values, before, after, held,
                        j(clear, λ h _ => match h {
                            False => StructuredRegionRunsOver(effects, values, when_false, before, after),
                            True => StructuredRegionRunsOver(effects, values, when_true, before, after),
                        }, ran)),
                })(bit, ok.right)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Call(callee, arguments, result) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Call(callee, arguments, result), facts), r, made), λ x _ => x.Sound(effects, values, before, after),
                    ⟨ran, held⟩),
            Args(others) => λ r made values before after held ran => {
                let got = Bool::then_some(facts.reads_all(arguments, others), Some(Regioned(Call(callee, others, result), facts)), r, made);
                let called: effects(before, callee, words_of(values, others), values(64, result), after) =
                    j(facts.reads_all_same(values, held, arguments, others, got.left),
                        λ words _ => effects(before, callee, words, values(64, result), after), ran);
                j(Option::some_inj(Regioned(Call(callee, others, result), facts), r, got.right), λ x _ => x.Sound(effects, values, before, after),
                    ⟨called, held⟩)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted), facts), r, made),
                    λ x _ => x.Sound(effects, values, before, after), ⟨ran, held⟩),
            Body(inner) => λ r made values before after held ran => {
                let got = Option::and_then_some(replay_region(table, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters), inner), λ (b: Regioned) =>
                    Some(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs))), r, made);
                let b = got.witness;
                let passes = loop_kept(effects, facts, values, held, inputs, parameters, next, body, b.region,
                    λ pass from to known old => replay_region_sound(table, effects, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters),
                        inner, b, got.proof.left, pass, from, to, known, old).left,
                    count, exit, values(64, bound).toNat(), words_of(values, outputs), values(1, exhausted).head_bit(), before, after, ran);
                j(Option::some_inj(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs)), r,
                    got.proof.right), λ x _ => x.Sound(effects, values, before, after), ⟨passes.left, facts.kept_hold(values, held, facts.carry(inputs, parameters, next), outputs, passes.right)⟩)
            },
            Derived(steps, inner) => λ r made values before after held ran => {
                let first = Option::and_then_some(replay(table, facts, [], steps), λ (d: Replayed) =>
                    replay_region(table, body, Facts::none().kept(d.facts.carry(inputs, parameters, next), parameters), inner).and_then(λ b =>
                        Some(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), d.facts.kept(d.facts.carry(inputs, parameters, next), outputs)))), r, made);
                let d = first.witness;
                let more = replay_sound(table, values, steps, facts, [], d, first.proof.left, before, before, held, refl).right;
                let got = Option::and_then_some(replay_region(table, body, Facts::none().kept(d.facts.carry(inputs, parameters, next), parameters), inner), λ (b: Regioned) =>
                    Some(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), d.facts.kept(d.facts.carry(inputs, parameters, next), outputs))), r, first.proof.right);
                let b = got.witness;
                let passes = loop_kept(effects, d.facts, values, more, inputs, parameters, next, body, b.region,
                    λ pass from to known old => replay_region_sound(table, effects, body, Facts::none().kept(d.facts.carry(inputs, parameters, next), parameters),
                        inner, b, got.proof.left, pass, from, to, known, old).left,
                    count, exit, values(64, bound).toNat(), words_of(values, outputs), values(1, exhausted).head_bit(), before, after, ran);
                j(Option::some_inj(Regioned(Loop(inputs, bound, parameters, count, b.region, exit, next, outputs, exhausted), d.facts.kept(d.facts.carry(inputs, parameters, next), outputs)), r,
                    got.proof.right), λ x _ => x.Sound(effects, values, before, after), ⟨passes.left, d.facts.kept_hold(values, more, d.facts.carry(inputs, parameters, next), outputs, passes.right)⟩)
            },
            Inputs(others, inner) => λ r made values before after held ran => {
                let ok = Bool::then_some(facts.reads_all(inputs, others),
                    replay_region(table, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters), inner).and_then(λ b =>
                        Some(Regioned(Loop(others, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs)))), r, made);
                let got = Option::and_then_some(replay_region(table, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters), inner), λ (b: Regioned) =>
                    Some(Regioned(Loop(others, bound, parameters, count, b.region, exit, next, outputs, exhausted), facts.kept(facts.carry(inputs, parameters, next), outputs))), r, ok.right);
                let b = got.witness;
                let passes = loop_kept(effects, facts, values, held, inputs, parameters, next, body, b.region,
                    λ pass from to known old => replay_region_sound(table, effects, body, Facts::none().kept(facts.carry(inputs, parameters, next), parameters),
                        inner, b, got.proof.left, pass, from, to, known, old).left,
                    count, exit, values(64, bound).toNat(), words_of(values, outputs), values(1, exhausted).head_bit(), before, after, ran);
                let fed = j(facts.reads_all_same(values, held, inputs, others, ok.left), λ words _ =>
                    LoopRunsOver(λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, b.region, from, to),
                        parameters, count, exit, next, values(64, bound).toNat(), words, words_of(values, outputs), values(1, exhausted).head_bit(),
                        before, after), passes.left);
                j(Option::some_inj(Regioned(Loop(others, bound, parameters, count, b.region, exit, next, outputs, exhausted),
                    facts.kept(facts.carry(inputs, parameters, next), outputs)), r, got.proof.right), λ x _ => x.Sound(effects, values, before, after),
                    ⟨fed, facts.kept_hold(values, held, facts.carry(inputs, parameters, next), outputs, passes.right)⟩)
            },
            _ => λ r made values before after held ran => absurd(made),
        },
        Lend(views, callee, arguments, result) => λ facts plan => match plan {
            Same => λ r made values before after held ran =>
                j(Option::some_inj(Regioned(Lend(views, callee, arguments, result), facts), r, made),
                    λ x _ => x.Sound(effects, values, before, after), ⟨ran, held⟩),
            _ => λ r made values before after held ran => absurd(made),
        },
    }
}

// ---------------------------------------------------------------------------
// Functions and programs

fn replay_function(table: List<Rule>, function: Function, plan: Plan) → Option<Function> {
    replay_region(table, function.body, Facts::none(), plan).and_then(λ r =>
        Some(Function(function.parameters, r.region, function.result, function.lent)))
}

theorem replay_function_sound(table: List<Rule>, function: Function, plan: Plan, replayed: Function,
    made: replay_function(table, function, plan) = Some(replayed), effects: Effects(), arguments: List<BitVec(64)>, result: BitVec(64),
    before, after: Buffers(), ran: function.Runs(effects, arguments, result, before, after)):
    replayed.Runs(effects, arguments, result, before, after) {
    let got = Option::and_then_some(replay_region(table, function.body, Facts::none(), plan), λ (r: Regioned) => Some(Function(function.parameters, r.region, function.result, function.lent)), replayed, made);
    let r = got.witness;
    let values = ran.witness;
    let ok = replay_region_sound(table, effects, function.body, Facts::none(), plan, r, got.proof.left, values, before, after,
        Facts::none_hold(values), ran.proof.right.left);
    j(Option::some_inj(Function(function.parameters, r.region, function.result, function.lent), replayed, got.proof.right),
        λ g _ => g.Runs(effects, arguments, result, before, after), Exists(values, ⟨ran.proof.left, ⟨ok.left, ran.proof.right.right⟩⟩))
}

// The replayer as a stage: no function's rewriting reads its callees.
fn replay_stage(table: List<Rule>) → Stage<Plan> {
    Stage(λ callees function plan => replay_function(table, function, plan),
        λ callees old plan new made arguments result before after ran =>
            replay_function_sound(table, old, plan, new, made, program_effects(callees), arguments, result, before, after, ran))
}

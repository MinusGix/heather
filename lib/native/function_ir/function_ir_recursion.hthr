// A function that calls itself (docs/native/runtime-fn-recursion-design.md):
// spike of recursion at the value level. A function's own index is a callee
// like the ones below it, answered by the function one level down, and its
// row of the room table is a number per level.
//
// The one-function theorem (`Function::emit_body_returns`,
// function_ir_lower_calls) is stated with the callee bound and the
// function's own room apart from its index. Here: the level tables, each
// level's room check from one check, and the induction on the level.

import function_ir;
import function_ir_state;
import function_ir_writes;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_views;
import function_ir_lower_calls;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_lending;
import x86_64_frame;
import x86_64_views;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Room per level

// Function `k`'s room `j` levels deep: `base` where it calls itself no
// more, and `step` more for each level.
fn level_room(base, step, j: Nat) → Nat { match j { Zero => base, Succ(i) => level_room(base, step, i) + step } }

theorem level_room_ge(base, step, j: Nat): base <= level_room(base, step, j) {
    match j {
        Zero => base.le_refl(),
        Succ(i) => { let below = level_room_ge(base, step, i); omega },
    }
}

// The table with function `k`'s row `own`, the others' rows theirs.
fn self_rooms(rooms: Nat → Nat, k, own: Nat) → Nat → Nat { λ (f: Nat) => match f.eq_dec(k) { Inl(_) => own, Inr(_) => rooms(f) } }

theorem self_rooms_same(rooms: Nat → Nat, k, own, f: Nat, same: f = k): self_rooms(rooms, k, own)(f) = own {
    match f.eq_dec(k) { Inl(_) => refl, Inr(differs) => false_elim(differs(same)) }
}

theorem self_rooms_other(rooms: Nat → Nat, k, own, f: Nat, differs: f ≠ k): self_rooms(rooms, k, own)(f) = rooms(f) {
    match f.eq_dec(k) { Inl(same) => false_elim(differs(same)), Inr(_) => refl }
}

// A region that fits a table fits one whose rows grew by no more than the
// room it is given did.
theorem StructuredRegion::fits_shift(self region: StructuredRegion, rooms, other: Nat → Nat, bound, avail, wider: Nat,
    grown: (f: Nat) → f + 1 <= bound → other(f) + avail <= rooms(f) + wider):
    region.Fits(rooms, bound, avail) → region.Fits(other, bound, wider) {
    match region {
        Dataflow(_) => λ _ => trivial,
        Sequence(_, continuation) => λ ok => continuation.fits_shift(rooms, other, bound, avail, wider, grown, ok),
        Compose(prefix, continuation) => λ ok => ⟨prefix.fits_shift(rooms, other, bound, avail, wider, grown, ok.left),
            continuation.fits_shift(rooms, other, bound, avail, wider, grown, ok.right)⟩,
        Conditional(_, _, _, _, when_true, when_false) => λ ok => ⟨when_true.fits_shift(rooms, other, bound, avail, wider, grown, ok.left),
            when_false.fits_shift(rooms, other, bound, avail, wider, grown, ok.right)⟩,
        Call(callee, _, _, _) => λ ok below => { let fit = ok(below); let more = grown(callee, below); omega },
        Loop(_, _, _, _, body, _, _, _, _) => λ ok => body.fits_shift(rooms, other, bound, avail, wider, grown, ok),
        Lend(_, callee, _, _) => λ ok below => { let fit = ok(below); let more = grown(callee, below); omega },
    }
}

// One check is every level's: a function whose frame and calls fit with
// its own row at `base` and its room `base + step` fits at each level, its
// own row that level's room and its room the next's.
theorem Function::roomy_level(self function: Function, rooms: Nat → Nat, k, base, step, asked, saves: Nat,
    roomy: function.RoomyAt(self_rooms(rooms, k, base), k + 1, base + step, asked, saves), j: Nat):
    function.RoomyAt(self_rooms(rooms, k, level_room(base, step, j)), k + 1, level_room(base, step, j) + step, asked, saves) {
    let frame = function.frame(asked, saves);
    let here = level_room(base, step, j);
    let up: (base <= here) = level_room_ge(base, step, j);
    let framed: (frame <= base + step) = roomy.left;
    ⟨{ omega }, ⟨λ c => { let enough = roomy.right.left(c); omega },
        function.body.fits_shift(self_rooms(rooms, k, base), self_rooms(rooms, k, here), k + 1, (base + step) - frame, (here + step) - frame,
            λ f below => match f.eq_dec(k) {
                Inl(same) => { let a = self_rooms_same(rooms, k, base, f, same); let b = self_rooms_same(rooms, k, here, f, same); omega },
                Inr(differs) => { let a = self_rooms_other(rooms, k, base, f, differs); let b = self_rooms_other(rooms, k, here, f, differs); omega },
            },
            roomy.right.right)⟩⟩
}

// ---------------------------------------------------------------------------
// What the function does within a number of levels

// The program's effects with function `k` calling itself at most `j`
// levels deep: the functions below it do what `below` says, and it what
// its body does with its own calls answered one level down. At no level it
// answers nothing.
fn Function::effects_within(self function: Function, below: Effects(), k, j: Nat) → Effects() {
    match j {
        Zero => λ before f arguments result rest after => match f.eq_dec(k) {
            Inl(_) => False,
            Inr(_) => below(before, f, arguments, result, rest, after),
        },
        Succ(i) => λ before f arguments result rest after => match f.eq_dec(k) {
            Inl(_) => function.RunsBoth(function.effects_within(below, k, i), arguments, result, rest, before, after),
            Inr(_) => below(before, f, arguments, result, rest, after),
        },
    }
}

theorem Function::effects_within_other(self function: Function, below: Effects(), k, j, f: Nat, differs: f ≠ k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    function.effects_within(below, k, j)(before, f, arguments, result, rest, after) → below(before, f, arguments, result, rest, after) {
    match j {
        Zero => match f.eq_dec(k) { Inl(same) => λ _ => false_elim(differs(same)), Inr(_) => λ held => held },
        Succ(_) => match f.eq_dec(k) { Inl(same) => λ _ => false_elim(differs(same)), Inr(_) => λ held => held },
    }
}

theorem Function::effects_within_none(self function: Function, below: Effects(), k, f: Nat, same: f = k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    function.effects_within(below, k, 0)(before, f, arguments, result, rest, after) → False {
    match f.eq_dec(k) { Inl(_) => λ held => held, Inr(differs) => λ _ => differs(same) }
}

theorem Function::effects_within_self(self function: Function, below: Effects(), k, j, f: Nat, same: f = k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    function.effects_within(below, k, j + 1)(before, f, arguments, result, rest, after) →
    function.RunsBoth(function.effects_within(below, k, j), arguments, result, rest, before, after) {
    match f.eq_dec(k) { Inl(_) => λ held => held, Inr(differs) => λ _ => false_elim(differs(same)) }
}

// ---------------------------------------------------------------------------
// The induction on the level

// A function below `k` meets its contract at every level as it did.
theorem Site::level_other<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, below: Effects(), rooms: Nat → Nat, k, own, j: Nat,
    function: Function, lending: Lending, f: Nat, differs: f ≠ k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers(),
    returns: site.Returns(stack, asm_labels(site.program)(f + 1), stack.CalledOver(below, rooms, lending, top, f, arguments, result, rest, before, after),
        stack.AnsweredBoth(lending, result, rest, after))):
    site.Returns(stack, asm_labels(site.program)(f + 1),
        stack.CalledOver(function.effects_within(below, k, j), self_rooms(rooms, k, own), lending, top, f, arguments, result, rest, before, after),
        stack.AnsweredBoth(lending, result, rest, after)) {
    site.returns_weaken(stack, asm_labels(site.program)(f + 1),
        stack.CalledOver(below, rooms, lending, top, f, arguments, result, rest, before, after),
        stack.CalledOver(function.effects_within(below, k, j), self_rooms(rooms, k, own), lending, top, f, arguments, result, rest, before, after),
        stack.AnsweredBoth(lending, result, rest, after), returns,
        λ i s held => ⟨⟨held.left.left, ⟨function.effects_within_other(below, k, j, f, differs, arguments, result, rest, before, after, held.left.right.left),
            { let row = self_rooms_other(rooms, k, own, f, differs); let room = held.left.right.right; omega }⟩⟩, held.right⟩)
}

// The theorem: where function `k`'s code, resident with the functions up
// to itself meeting their contracts at a level, meets its own with one
// step more room (`returns`, what `Function::emit_body_returns` proves of
// code emitted with the bound `k + 1`), every function up to `k` meets its
// contract at every level. The code is the same at each: only the room
// asked of the caller grows.
theorem Site::calls_level<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, below: Effects(), rooms: Nat → Nat, k, base, step: Nat,
    counts: List<Nat>, needs: Nat → Nat → Bool, function: Function, entry: Nat, label: asm_labels(site.program)(k + 1) = entry,
    earlier: site.CallsLent(stack, below, rooms, k, counts, needs, top),
    returns: (j: Nat) → (lending: Lending) → lending.counts = counts → Loan<M>(site.fetch, site.data, stack, top, lending.spans()) →
        ((b: Nat) → needs(k, b).IsTrue() → lending.written(b) = True) →
        site.CallsLent(stack, function.effects_within(below, k, j), self_rooms(rooms, k, level_room(base, step, j)), k + 1, counts, needs, top) →
        (words: List<BitVec(64)>) → (result: BitVec(64)) → (rest: List<BitVec(64)>) → (before, after: Buffers()) →
        site.Returns(stack, entry,
            stack.EnteredAt(function.effects_within(below, k, j), level_room(base, step, j) + step, lending, top, k, function, words, result, rest, before, after),
            stack.AnsweredBoth(lending, result, rest, after)),
    j: Nat):
    site.CallsLent(stack, function.effects_within(below, k, j), self_rooms(rooms, k, level_room(base, step, j)), k + 1, counts, needs, top) {
    match j {
        Zero => λ lending same loan f under covers arguments result rest before after => match f.eq_dec(k) {
            Inl(at) => λ s here resident i rsp room held ret saved =>
                false_elim(function.effects_within_none(below, k, f, at, arguments, result, rest, before, after, held.left.right.left)),
            Inr(differs) => site.level_other(stack, top, below, rooms, k, level_room(base, step, 0), 0, function, lending, f, differs, arguments, result, rest,
                before, after, earlier(lending, same, loan, f, below_other(f, k, under, differs), covers, arguments, result, rest, before, after)),
        },
        Succ(n) => λ lending same loan f under covers arguments result rest before after => match f.eq_dec(k) {
            Inl(at) => {
                let level = site.calls_level(stack, top, below, rooms, k, base, step, counts, needs, function, entry, label, earlier, returns, n);
                let own = level_room(base, step, n) + step;
                let entered = returns(n, lending, same, loan, j(at, λ m _ => (b: Nat) → needs(m, b).IsTrue() → lending.written(b) = True, covers), level,
                    arguments, result, rest, before, after);
                let called: site.Returns(stack, entry,
                    stack.CalledOver(function.effects_within(below, k, n + 1), self_rooms(rooms, k, own), lending, top, k, arguments, result, rest, before, after),
                    stack.AnsweredBoth(lending, result, rest, after)) =
                    site.returns_weaken(stack, entry,
                        stack.EnteredAt(function.effects_within(below, k, n), own, lending, top, k, function, arguments, result, rest, before, after),
                        stack.CalledOver(function.effects_within(below, k, n + 1), self_rooms(rooms, k, own), lending, top, k, arguments, result, rest, before, after),
                        stack.AnsweredBoth(lending, result, rest, after), entered,
                        λ i s held => ⟨⟨held.left.left, ⟨function.effects_within_self(below, k, n, k, refl, arguments, result, rest, before, after, held.left.right.left),
                            { let row = self_rooms_same(rooms, k, own, k, refl); let room = held.left.right.right; omega }⟩⟩, held.right⟩);
                j(sym(at), λ m _ => site.Returns(stack, asm_labels(site.program)(m + 1),
                        stack.CalledOver(function.effects_within(below, k, n + 1), self_rooms(rooms, k, own), lending, top, m, arguments, result, rest, before, after),
                        stack.AnsweredBoth(lending, result, rest, after)),
                    j(sym(label), λ e _ => site.Returns(stack, e,
                            stack.CalledOver(function.effects_within(below, k, n + 1), self_rooms(rooms, k, own), lending, top, k, arguments, result, rest, before, after),
                            stack.AnsweredBoth(lending, result, rest, after)), called))
            },
            Inr(differs) => site.level_other(stack, top, below, rooms, k, level_room(base, step, n + 1), n + 1, function, lending, f, differs, arguments, result, rest,
                before, after, earlier(lending, same, loan, f, below_other(f, k, under, differs), covers, arguments, result, rest, before, after)),
        },
    }
}

// ---------------------------------------------------------------------------
// The emitted function

// A function's code holds its label, whatever bound its calls are under.
theorem Function::emit_body_labels(self function: Function, asked, saves: Nat, short: List<Nat>, prog: Prog, k, bound: Nat, file: File,
    placement: List<Place>, names: Nat, counts: List<Nat>):
    Grows(At(prog, k + 1, Block([])), function.emit_body(asked, saves, short, prog, k, bound, file, placement, names, counts)) {
    let opened = function_opened(prog, k, function.loads(), function.slots(asked), saves);
    let label = At(prog, k + 1, Block([]));
    (match function.body.emit_calls(saves, function.slots(asked), short, opened, file, placement, names, bound, counts, function.homes()) as λ e => Grows(opened, e) →
        Grows(label, match e { None => None, Some(body) => function.closing(asked, saves, body) }) {
        None => λ _ => trivial,
        Some(body) => λ grown => function.closing_grows(asked, saves, label, body,
            Prog::within_trans(label_opened(prog, k, function.loads(), function.slots(asked), saves), grown)),
    })(function.body.emit_calls_grows(saves, function.slots(asked), short, bound, counts, function.homes(), opened, file, placement, names))
}

// The theorem for a function that calls itself, proved once: code emitted
// for function `k` with its own index among its callees (the bound
// `k + 1`), resident with the functions below it meeting their contracts,
// meets its own at every level `j`, where a call of it is answered within
// `j` levels (`Function::effects_within`) and asks for that level's room
// (`level_room`). One room check is asked, of the first level (`roomy`).
theorem Function::self_calls<M>(self function: Function, asked, saves: Nat, short: List<Nat>, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, below: Effects(), rooms: Nat → Nat, k, base, step: Nat, counts: List<Nat>,
    needs: Nat → Nat → Bool, prog: Prog, file: File, placement: List<Place>, names: Nat, emitted: Emitted,
    emits: function.emit_body(asked, saves, short, prog, k, k + 1, file, placement, names, counts) = Some(emitted),
    within: emitted.prog.Within(site.program),
    stores: (b: Nat) → function.body.stores(b).IsTrue() → needs(k, b) = True,
    asks: function.body.Asks(needs, λ (b: Nat) => needs(k, b)),
    roomy: function.RoomyAt(self_rooms(rooms, k, base), k + 1, base + step, asked, saves),
    count: function.lent = lent_count(counts, k),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g),
    few: function.loads() <= 2,
    earlier: site.CallsLent(stack, below, rooms, k, counts, needs, top), j: Nat):
    site.CallsLent(stack, function.effects_within(below, k, j), self_rooms(rooms, k, level_room(base, step, j)), k + 1, counts, needs, top) {
    let label = At(prog, k + 1, Block([]));
    let labelled: label.Within(emitted.prog) = j(emits, λ o _ => Grows(label, o),
        function.emit_body_labels(asked, saves, short, prog, k, k + 1, file, placement, names, counts));
    let label_in = Prog::within_trans(labelled, within);
    site.calls_level(stack, top, below, rooms, k, base, step, counts, needs, function, prog_len(prog),
        label_target(label_in.witness, site.program, prog, k, Block([]), site.program.laid_out_unique(laid), label_in.proof),
        earlier,
        λ n lending same loan covers level words result rest before after => {
            let effects = function.effects_within(below, k, n);
            let table = self_rooms(rooms, k, level_room(base, step, n));
            let own = level_room(base, step, n) + step;
            let may = function.emit_body_returns(asked, saves, short, site, laid, stack, top, effects, table, k, k + 1, own, lending, loan, needs, prog, file,
                placement, names,
                λ b stored => covers(b, is_true_of_eq(needs(k, b), stores(b, stored))),
                function.body.asks_within(needs, λ (b: Nat) => needs(k, b), lending.written, covers, asks),
                function.roomy_level(rooms, k, base, step, asked, saves, roomy, n),
                j(sym(same), λ c _ => function.lent = lent_count(c, k), count), entered, few);
            let at_counts = j(same, λ c _ => MayReturnAt<M>(site, stack, top, effects, table, k, k + 1, own, lending, needs, function, prog,
                    function.emit_body(asked, saves, short, prog, k, k + 1, file, placement, names, c)), may);
            let here = j(emits, λ o _ => MayReturnAt<M>(site, stack, top, effects, table, k, k + 1, own, lending, needs, function, prog, o), at_counts);
            here.right(within, j(sym(same), λ c _ => site.CallsLent(stack, effects, table, k + 1, c, needs, top), level), words, result, rest, before, after)
        }, j)
}

// ---------------------------------------------------------------------------
// Levels from a rank

theorem Function::effects_within_enter(self function: Function, below: Effects(), k, j, f: Nat, same: f = k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    function.RunsBoth(function.effects_within(below, k, j), arguments, result, rest, before, after) →
    function.effects_within(below, k, j + 1)(before, f, arguments, result, rest, after) {
    match f.eq_dec(k) { Inl(_) => λ held => held, Inr(differs) => λ _ => false_elim(differs(same)) }
}

theorem Function::effects_within_lift(self function: Function, below: Effects(), k, j, f: Nat, differs: f ≠ k,
    arguments: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers()):
    below(before, f, arguments, result, rest, after) → function.effects_within(below, k, j)(before, f, arguments, result, rest, after) {
    match j {
        Zero => match f.eq_dec(k) { Inl(same) => λ _ => false_elim(differs(same)), Inr(_) => λ held => held },
        Succ(_) => match f.eq_dec(k) { Inl(same) => λ _ => false_elim(differs(same)), Inr(_) => λ held => held },
    }
}

theorem none_lower(a, b: Nat, lower: a + 1 <= b, low: b <= 0): False { omega }
theorem one_lower(a, b, i: Nat, lower: a + 1 <= b, low: b <= i + 1): a <= i { omega }

// What the source of a function that calls itself owes (`unfold`): what it
// answers (`graph`) is what its body does where its own calls, at
// arguments of lower `rank`, are answered by `graph` and the others' by
// `below`. Then at arguments of rank at most `j` it answers within `j + 1`
// levels: the rank is the level a caller reserves room for.
theorem Function::within_rank(self function: Function, below: Effects(), k: Nat, rank: List<BitVec(64)> → Nat, graph: Effects(),
    unfold: (callees: Effects()) → (words: List<BitVec(64)>) → (result: BitVec(64)) → (rest: List<BitVec(64)>) → (before, after: Buffers()) →
        graph(before, k, words, result, rest, after) →
        ((f: Nat) → f ≠ k → (a: List<BitVec(64)>) → (r: BitVec(64)) → (e: List<BitVec(64)>) → (b, c: Buffers()) →
            below(b, f, a, r, e, c) → callees(b, f, a, r, e, c)) →
        ((a: List<BitVec(64)>) → (r: BitVec(64)) → (e: List<BitVec(64)>) → (b, c: Buffers()) →
            graph(b, k, a, r, e, c) → rank(a) + 1 <= rank(words) → callees(b, k, a, r, e, c)) →
        function.RunsBoth(callees, words, result, rest, before, after),
    j: Nat, words: List<BitVec(64)>, result: BitVec(64), rest: List<BitVec(64)>, before, after: Buffers(),
    holds: graph(before, k, words, result, rest, after), low: rank(words) <= j):
    function.effects_within(below, k, j + 1)(before, k, words, result, rest, after) {
    match j {
        Zero => function.effects_within_enter(below, k, 0, k, refl, words, result, rest, before, after,
            unfold(function.effects_within(below, k, 0), words, result, rest, before, after, holds,
                λ f differs a r e b c held => function.effects_within_lift(below, k, 0, f, differs, a, r, e, b, c, held),
                λ a r e b c answered lower => false_elim(none_lower(rank(a), rank(words), lower, low)))),
        Succ(i) => function.effects_within_enter(below, k, i + 1, k, refl, words, result, rest, before, after,
            unfold(function.effects_within(below, k, i + 1), words, result, rest, before, after, holds,
                λ f differs a r e b c held => function.effects_within_lift(below, k, i + 1, f, differs, a, r, e, b, c, held),
                λ a r e b c answered lower => function.within_rank(below, k, rank, graph, unfold, i, a, r, e, b, c, answered,
                    one_lower(rank(a), rank(words), i, lower, low)))),
    }
}

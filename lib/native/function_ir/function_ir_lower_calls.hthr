// FunctionIR with calls lowered to x86 by a Heather function proved correct
// once (issues/function-ir-verified-lowering.md, round 3: calls and the
// stack).
//
// A program is a list of functions, last first, each calling only the ones
// after it (function_ir: `program_callees`). Each function is emitted at the
// label `Succ(f)`: it allocates a frame of eight slots below its return
// address, runs its body, moves its result into RAX, frees the frame, and
// returns. A call inside a body spills the eight caller-saved registers
// other than RAX into the frame, moves its arguments into the SysV argument
// registers, CALLs, and reloads them, so the file after it is the file
// before it with the result in RAX. Body code keeps the callee-saved
// registers (checked by evaluation, `leaves_all`), and every callee keeps
// them by its contract, so values in them would survive a call too.
//
// The theorem is round 2's over machine runs (x86_64_stack_runs): whatever
// the placement, if `lower` returns a program then, resident anywhere and
// with any stack meeting the stack laws, each function's code meets its
// contract: entered with its arguments in their registers and the return
// address on the stack, it returns there with its result in RAX, the
// callee-saved registers kept, and memory as it was but for stores into its
// own room below that address (`Stack::Wrote`,
// docs/native-one-compiler-design.md §2.1). That clause is what a caller
// keeps: its stack words, and for a program its data.

import function_ir;
import function_ir_lower;
import function_ir_lower_structured;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The calling convention

// SysV's: arguments in RDI, RSI, RDX, RCX, R8, R9, the result in RAX.
fn argument_registers() → List<Gpr> { [Rdi, Rsi, Rdx, Rcx, R8, R9] }

// What a caller saves around a call: the caller-saved registers but RAX,
// slot `k` holding the `k`th.
fn saved_registers() → List<Gpr> { [Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11] }

// What a callee keeps besides the stack pointer.
fn callee_kept() → List<Gpr> { [Rbx, Rbp, R12, R13, R14, R15] }

// The words in the registers, one each.
fn ArgsIn(words: List<BitVec(64)>) → List<Gpr> → Gprs → Type {
    match words {
        Nil => λ _ _ => True,
        Cons(word, rest) => λ registers gprs => match registers {
            Nil => False,
            Cons(register, later) => (read_gpr(register, gprs) = word) ∧ ArgsIn(rest, later, gprs),
        },
    }
}

theorem ports_args(values: Valuation(), ids: List<Nat>): (registers: List<Gpr>) → (gprs: Gprs) →
    PortsAt(values, word_ports(ids), registers, gprs) → ArgsIn(words_of(values, ids), registers, gprs) {
    match ids {
        Nil => λ registers gprs _ => trivial,
        Cons(id, rest) => λ registers gprs => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ placed => ⟨sym(placed.left), ports_args(values, rest, later, gprs, placed.right)⟩,
        },
    }
}

theorem args_ports(values: Valuation(), ids: List<Nat>): (registers: List<Gpr>) → (gprs: Gprs) →
    ArgsIn(words_of(values, ids), registers, gprs) → PortsAt(values, word_ports(ids), registers, gprs) {
    match ids {
        Nil => λ registers gprs _ => trivial,
        Cons(id, rest) => λ registers gprs => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ placed => ⟨sym(placed.left), args_ports(values, rest, later, gprs, placed.right)⟩,
        },
    }
}

// `writer` is none of the registers.
fn Gpr::misses(self writer: Gpr, registers: List<Gpr>) → Bool {
    match registers { Nil => True, Cons(register, rest) => !writer.same(register) && writer.misses(rest) }
}

theorem args_after_write(words: List<BitVec(64)>): (registers: List<Gpr>) → (gprs: Gprs) → (writer: Gpr) → (value: BitVec(64)) →
    writer.misses(registers).IsTrue() → ArgsIn(words, registers, gprs) → ArgsIn(words, registers, write_gpr(writer, value, gprs)) {
    match words {
        Nil => λ registers gprs writer value _ _ => trivial,
        Cons(word, rest) => λ registers gprs writer value => match registers {
            Nil => λ _ no => false_elim(no),
            Cons(register, later) => λ misses held => {
                let both = Bool::is_true_and(!writer.same(register), writer.misses(later), misses);
                ⟨trans(write_spares(writer, register, value, gprs, both.left), held.left),
                 args_after_write(rest, later, gprs, writer, value, both.right, held.right)⟩
            },
        },
    }
}

theorem kept_trans(registers: List<Gpr>, a, b, c: Gprs): Kept(registers, a, b) → Kept(registers, b, c) → Kept(registers, a, c) {
    match registers {
        Nil => λ _ _ => trivial,
        Cons(register, rest) => λ first second => ⟨trans(second.left, first.left), kept_trans(rest, a, b, c, first.right, second.right)⟩,
    }
}

// The callee-saved registers are the stack pointer and the ones a callee
// keeps besides.
theorem kept_saved(before, after: Gprs, rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before), kept: Kept(callee_kept(), before, after)):
    Kept(callee_saved(), before, after) {
    ⟨kept.left, ⟨kept.right.left, ⟨rsp, kept.right.right⟩⟩⟩
}
theorem saved_kept(before, after: Gprs, kept: Kept(callee_saved(), before, after)): Kept(callee_kept(), before, after) {
    ⟨kept.left, ⟨kept.right.left, kept.right.right.right⟩⟩
}

// What function `f` promises, called on `arguments` where the program's
// functions say it may return `result`: entered at stack offset `i` with
// room below for itself and its callees (`72` bytes a level: its frame,
// and the return address of a call it makes), it returns with `result` in
// RAX, the callee-saved registers kept, and memory as it was but for
// stores of its own below `i` (`Stack::Wrote`): its caller's words, the
// return address among them, and whatever else such stores leave.
fn CalleePre<M>(callees: Callees(), f: Nat, arguments: List<BitVec(64)>, result: BitVec(64)) → Nat → MachineState<M> → Type {
    λ i s => ArgsIn(arguments, argument_registers(), s.gprs) ∧ (callees(f, arguments, result) ∧ 72 * Succ(f) <= i)
}
fn Stack::CalleePost<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64)) →
    Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => (read_gpr(Rax, t.gprs) = result) ∧ (Kept(callee_kept(), s.gprs, t.gprs) ∧ stack.Wrote(i, s.memory, t.memory))
}

// The contract as it read before it stated the stores: the caller's stack
// words unchanged, here from the return address up.
fn Stack::CalleeKeeps<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64)) →
    Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => (read_gpr(Rax, t.gprs) = result) ∧ (Kept(callee_kept(), s.gprs, t.gprs) ∧ stack.Unchanged(i, s.memory, t.memory))
}
theorem Stack::callee_keeps<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64),
    i: Nat, s, t: MachineState<M>, room: i + 8 <= stack.size, post: stack.CalleePost(result)(i, s, t)): stack.CalleeKeeps(result)(i, s, t) {
    ⟨post.left, ⟨post.right.left, stack.wrote_unchanged(i, { omega }, s.memory, t.memory, post.right.right)⟩⟩
}

// Every function below `bound` meets its contract at its label.
fn Site::Calls<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), callees: Callees(), bound: Nat) → Type {
    (f: Nat) → Succ(f) <= bound → (arguments: List<BitVec(64)>) → (result: BitVec(64)) →
        site.Returns(stack, asm_labels(site.program)(Succ(f)), CalleePre<M>(callees, f, arguments, result), stack.CalleePost(result))
}

// What a body keeps of where it started (`s0`, its frame at offset `d`):
// the callee-saved registers, and memory but for stores into its own frame
// and below.
fn Stack::Framed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0, s: MachineState<M>) → Type {
    Kept(callee_saved(), s0.gprs, s.gprs) ∧ stack.Wrote(d + 64, s0.memory, s.memory)
}

// Words a callee leaves at and above `d` keep the slots there.
theorem Stack::saved_unchanged<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    gprs: Gprs, before, after: M, unchanged: stack.Unchanged(d, before, after), registers: List<Gpr>):
    (k: Nat) → d + 8 * (k + registers.len()) <= stack.size → stack.Saved(d, registers, k, gprs, before) → stack.Saved(d, registers, k, gprs, after) {
    match registers {
        Nil => λ k _ _ => trivial,
        Cons(register, rest) => λ k room saved =>
            ⟨trans(unchanged(d + 8 * k, { omega }, { omega }), saved.left),
             stack.saved_unchanged(d, gprs, before, after, unchanged, rest, Succ(k), { omega }, saved.right)⟩,
    }
}

// ---------------------------------------------------------------------------
// Emitting with calls

// What emitting proves now: round 2's `Emits` over machine runs, the frame
// kept. `s0` is where the body started, its frame at stack offset `d`.
fn EmitsIn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, out: Emitted) → Type {
    prog.Within(out.prog) ∧ (out.prog.Within(site.program) →
        site.Moves(stack.writes, prog_len(prog), prog_len(out.prog),
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.Framed(d, s0, s),
            λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t)))
}

fn MayEmitIn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => EmitsIn<M>(site, stack, values, d, s0, prog, file, facts, emitted))
}

// A call's code after `prog`: the spills, the argument moves, the CALL,
// the reloads.
fn call_prog(prog: Prog, moves: List<Instruction>, callee: Nat) → Prog {
    saved_registers().reloads(At(At(saved_registers().spills(prog, 0), 0, Block(moves)), 0, CallTo(Succ(callee))), 0)
}

// What a call's code has done by its CALL: the arguments in their
// registers, the callee-saved registers as at the call's start (`g0`), and
// the saved registers' words in their slots.
fn Stack::ArgsReady<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>, g0: Gprs, words: List<BitVec(64)>, x: MachineState<M>) → Type {
    ArgsIn(words, argument_registers(), x.gprs) ∧ (Kept(callee_saved(), g0, x.gprs) ∧
        (stack.Wrote(d + 64, s0.memory, x.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, x.memory)))
}

// And after it: the stack pointer back, the answer in RAX, the rest kept.
fn Stack::Returned<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>, g0: Gprs, answer: BitVec(64), t: MachineState<M>) → Type {
    (read_gpr(Rsp, t.gprs) = stack.at(d)) ∧ ((read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), g0, t.gprs) ∧
        (stack.Wrote(d + 64, s0.memory, t.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, t.memory))))
}

// The CALL, against the callee's contract.
theorem call_step<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), bound: Nat, calls: site.Calls(stack, callees, bound), d: Nat, s0: MachineState<M>,
    room: 72 * bound + 8 <= d, fits: d + 64 <= stack.size, prog: Prog, callee: Nat, below: Succ(callee) <= bound,
    words: List<BitVec(64)>, answer: BitVec(64), answered: callees(callee, words, answer),
    g0: Gprs, rsp_g0: read_gpr(Rsp, g0) = stack.at(d), k: Nat, at: asm_back(site.program, k) = At(prog, 0, CallTo(Succ(callee)))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + 5,
        λ (x: MachineState<M>) => stack.ArgsReady(d, s0, g0, words, x), λ (t: MachineState<M>) => stack.Returned(d, s0, g0, answer, t)) {
    let back: ((d - 8) + 8 = d) = Nat::sub_add_cancel(8, d, { omega });
    let entered: ((d - 8) + 8 <= stack.size) = { omega };
    let deep: (72 * Succ(callee) <= d - 8) = { omega };
    let slots: (d + 8 * (0 + saved_registers().len()) <= stack.size) = { omega };
    let at_d: (stack.at((d - 8) + 8) = stack.at(d)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
    let displacement = asm_jump_of(asm_labels(site.program), prog_len(prog), CallTo(Succ(callee)));
    site.moves_call(stack, site.program.laid_out_fits(laid), k, prog, 0, Succ(callee), at,
        asm_labels(site.program)(Succ(callee)),
        call_lands(asm_labels(site.program), k, site.program, prog, 0, Succ(callee), site.program.laid_out_lands(laid), at),
        CalleePre<M>(callees, callee, words, answer), stack.CalleePost(answer), calls(callee, below, words, answer),
        λ (x: MachineState<M>) => stack.ArgsReady(d, s0, g0, words, x), λ (t: MachineState<M>) => stack.Returned(d, s0, g0, answer, t),
        λ _ => d - 8,
        λ x held => ⟨trans(held.right.left.right.right.left, trans(rsp_g0, sym(at_d))),
            ⟨entered, ⟨args_after_write(words, argument_registers(), x.gprs, Rsp, push_address(x.gprs), trivial, held.left),
                ⟨answered, deep⟩⟩⟩⟩,
        λ x t held rsp_t returned => {
            let rsp_x: (read_gpr(Rsp, x.gprs) = stack.at((d - 8) + 8)) = trans(held.right.left.right.right.left, trans(rsp_g0, sym(at_d)));
            let pushed: (push_address(x.gprs) = stack.at(d - 8)) =
                trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.sub(BitVec::ofNat(8)), rsp_x), push_at(stack.low, d - 8));
            let u = call_near_after(stack.writes, displacement, x);
            let push_wrote: stack.Wrote(d, x.memory, u.memory) =
                j(sym(pushed), λ a _ => stack.Wrote(d, x.memory, stack.writes.store(x.memory, a, word_bytes(next_rip(x.rip, 5)))),
                    stack.wrote_store(d, x.memory, d - 8, { omega }, next_rip(x.rip, 5)));
            let callee_wrote: stack.Wrote(d, u.memory, t.memory) =
                stack.wrote_deeper(d - 8, d, { omega }, u.memory, t.memory, returned.right.right);
            let wrote = stack.wrote_trans(d, x.memory, u.memory, t.memory, push_wrote, callee_wrote);
            let unchanged = stack.wrote_unchanged(d, { omega }, x.memory, t.memory, wrote);
            let kept_u: Kept(callee_kept(), x.gprs, t.gprs) = returned.right.left;
            ⟨trans(rsp_t, at_d), ⟨returned.left, ⟨kept_trans(callee_kept(), g0, x.gprs, t.gprs, saved_kept(g0, x.gprs, held.right.left), kept_u),
              ⟨stack.wrote_trans(d + 64, s0.memory, x.memory, t.memory, held.right.right.left,
                  stack.wrote_deeper(d, d + 64, { omega }, x.memory, t.memory, wrote)),
               stack.saved_unchanged(d, g0, x.memory, t.memory, unchanged, saved_registers(), 0, slots, held.right.right.right)⟩⟩⟩⟩
        })
}

// After the reloads: the file before the call, with the answer in RAX.
theorem call_restores(values: Valuation(), file: File, result: Nat, before, after: Gprs,
    represents: file.Represents(values, before), rax: read_gpr(Rax, after) = values(64, result),
    kept: Kept(callee_kept(), before, after), rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before)):
    file.write(Rax, Some(Held(result, Word))).Represents(values, restore(saved_registers(), before, after)) {
    ⟨λ query => match query {
        Rax => sym(rax),
        Rcx => represents.left(Rcx), Rdx => represents.left(Rdx),
        Rbx => j(sym(kept.left), λ w _ => SlotRep(values, file.at(Rbx), w), represents.left(Rbx)),
        Rsp => j(sym(rsp), λ w _ => SlotRep(values, file.at(Rsp), w), represents.left(Rsp)),
        Rbp => j(sym(kept.right.left), λ w _ => SlotRep(values, file.at(Rbp), w), represents.left(Rbp)),
        Rsi => represents.left(Rsi), Rdi => represents.left(Rdi), R8 => represents.left(R8), R9 => represents.left(R9),
        R10 => represents.left(R10), R11 => represents.left(R11),
        R12 => j(sym(kept.right.right.left), λ w _ => SlotRep(values, file.at(R12), w), represents.left(R12)),
        R13 => j(sym(kept.right.right.right.left), λ w _ => SlotRep(values, file.at(R13), w), represents.left(R13)),
        R14 => j(sym(kept.right.right.right.right.left), λ w _ => SlotRep(values, file.at(R14), w), represents.left(R14)),
        R15 => j(sym(kept.right.right.right.right.right.left), λ w _ => SlotRep(values, file.at(R15), w), represents.left(R15)),
    }, represents.right⟩
}

// A word in the slots lies below the frame's top.
theorem slot_inside(d, i, size: Nat, high: i + 8 <= d + 8 * (0 + saved_registers().len()), fits: d + 64 <= size):
    (i + 8 <= size) ∧ (i + 8 <= d + 64) {
    let eight: (saved_registers().len() = 8) = refl;
    ⟨{ omega }, { omega }⟩
}

// The spills.
theorem call_spills<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    d: Nat, s0: MachineState<M>, fits: d + 64 <= stack.size, prog: Prog,
    g0: Gprs, rsp_g0: read_gpr(Rsp, g0) = stack.at(d), within: saved_registers().spills(prog, 0).Within(site.program)):
    site.Moves(stack.writes, prog_len(prog), prog_len(saved_registers().spills(prog, 0)),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Wrote(d + 64, s0.memory, x.memory),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Wrote(d + 64, s0.memory, x.memory) ∧
            stack.Saved(d, saved_registers(), 0, g0, x.memory))) {
    let small: (0 + saved_registers().len() <= 16) = { omega };
    let slots: (d + 8 * (0 + saved_registers().len()) <= stack.size) = { omega };
    site.moves_spills(stack, site.program.laid_out_fits(laid), d, g0, rsp_g0, saved_registers(), prog, 0, small, slots,
        λ (m: M) => stack.Wrote(d + 64, s0.memory, m),
        λ memory i low high word kept => {
            let inside = slot_inside(d, i, stack.size, high, fits);
            stack.wrote_then(d + 64, s0.memory, memory, kept, i, inside.right, word)
        },
        within)
}

// The argument moves.
theorem call_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, arguments: List<Nat>,
    moves: Lowered, moves_keeps: Keeps<M>(values, file, True, moves),
    placed: moves.file.outputs_check(word_ports(arguments), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    g0: Gprs, represents: file.Represents(values, g0), k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block(moves.code))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Wrote(d + 64, s0.memory, x.memory) ∧
            stack.Saved(d, saved_registers(), 0, g0, x.memory)),
        λ (x: MachineState<M>) => stack.ArgsReady(d, s0, g0, words_of(values, arguments), x)) {
    let rest = λ (m: M) => stack.Wrote(d + 64, s0.memory, m) ∧ stack.Saved(d, saved_registers(), 0, g0, m);
    let pre = λ (g: Gprs) (m: M) => (g = g0) ∧ rest(m);
    let post = λ (g: Gprs) (m: M) => ArgsIn(words_of(values, arguments), argument_registers(), g) ∧ (Kept(callee_saved(), g0, g) ∧ rest(m));
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, moves.code, at,
            site.program.block_reads_at(laid, k, prog, 0, moves.code, at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let y = execute_block_normal(moves.code, x);
                let kept_moves = moves_keeps(x, j(sym(held.left), λ g _ => file.Represents(values, g), represents), trivial);
                ⟨ports_args(values, arguments, argument_registers(), y.gprs,
                    outputs_check_sound(values, moves.file, y.gprs, kept_moves, word_ports(arguments), argument_registers(), placed)),
                 ⟨j(held.left, λ g _ => Kept(callee_saved(), g, y.gprs), execute_block_kept<M>(moves.code, x, callee_saved(), leaves)),
                  held.right⟩⟩
            }))
}

theorem saved_fit(d, size: Nat, fits: d + 64 <= size):
    (0 + saved_registers().len() <= 16) ∧ (d + 8 * (0 + saved_registers().len()) <= size) {
    let eight: (saved_registers().len() = 8) = refl;
    ⟨{ omega }, { omega }⟩
}

// From the call's start to its return: spills, argument moves, CALL.
theorem call_returns<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), bound: Nat, calls: site.Calls(stack, callees, bound), values: Valuation(), d: Nat, s0: MachineState<M>,
    room: 72 * bound + 8 <= d, fits: d + 64 <= stack.size,
    prog: Prog, file: File, callee: Nat, arguments: List<Nat>, result: Nat,
    below: Succ(callee) <= bound, moves: Lowered, moves_keeps: Keeps<M>(values, file, True, moves),
    placed: moves.file.outputs_check(word_ports(arguments), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    g0: Gprs, represents: file.Represents(values, g0), rsp_g0: read_gpr(Rsp, g0) = stack.at(d),
    answered: callees(callee, words_of(values, arguments), values(64, result)),
    within: At(At(saved_registers().spills(prog, 0), 0, Block(moves.code)), 0, CallTo(Succ(callee))).Within(site.program)):
    site.Moves(stack.writes, prog_len(prog), prog_len(At(At(saved_registers().spills(prog, 0), 0, Block(moves.code)), 0, CallTo(Succ(callee)))),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Wrote(d + 64, s0.memory, x.memory),
        λ (t: MachineState<M>) => stack.Returned(d, s0, g0, values(64, result), t)) {
    let saved = saved_registers();
    let spilled = saved.spills(prog, 0);
    let moved = At(spilled, 0, Block(moves.code));
    let words = words_of(values, arguments);
    let answer = values(64, result);
    let moved_in = moved.within_before(0, CallTo(Succ(callee)), site.program, within);
    let spilled_in = spilled.within_before(0, Block(moves.code), site.program, moved_in);
    site.moves_trans(stack.writes, prog_len(prog), prog_len(spilled), prog_len(moved) + 5,
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Wrote(d + 64, s0.memory, x.memory),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Wrote(d + 64, s0.memory, x.memory) ∧ stack.Saved(d, saved, 0, g0, x.memory)),
        λ (t: MachineState<M>) => stack.Returned(d, s0, g0, answer, t),
        call_spills<M>(site, laid, stack, d, s0, fits, prog, g0, rsp_g0, spilled_in),
        site.moves_trans(stack.writes, prog_len(spilled), prog_len(moved), prog_len(moved) + 5,
            λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Wrote(d + 64, s0.memory, x.memory) ∧ stack.Saved(d, saved, 0, g0, x.memory)),
            λ (x: MachineState<M>) => stack.ArgsReady(d, s0, g0, words, x),
            λ (t: MachineState<M>) => stack.Returned(d, s0, g0, answer, t),
            call_moves<M>(site, laid, stack, values, d, s0, spilled, file, arguments, moves, moves_keeps, placed, leaves, g0, represents,
                moved_in.witness, moved_in.proof),
            call_step<M>(site, laid, stack, callees, bound, calls, d, s0, room, fits, moved, callee, below, words, answer,
                answered, g0, rsp_g0, within.witness, within.proof)))
}

// The reloads keep what the callee kept.
theorem kept_restored(before, saved, after: Gprs, kept: Kept(callee_saved(), before, after)):
    Kept(callee_saved(), before, restore(saved_registers(), saved, after)) { kept }

theorem call_within(prog: Prog, code: List<Instruction>, callee: Nat): prog.Within(call_prog(prog, code, callee)) {
    let saved = saved_registers();
    let spilled = saved.spills(prog, 0);
    let moved = At(spilled, 0, Block(code));
    let called = At(moved, 0, CallTo(Succ(callee)));
    let out_prog = saved.reloads(called, 0);
    prog.within_trans(spilled, out_prog, Prog::within_spills(saved, prog, 0),
        spilled.within_trans(moved, out_prog, spilled.within_then(0, Block(code)),
            moved.within_trans(called, out_prog, moved.within_then(0, CallTo(Succ(callee))), Prog::within_reloads(saved, called, 0))))
}

// From the return through the reloads.
theorem call_finishes<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), fits: d + 64 <= stack.size,
    file: File, result: Nat, called: Prog, g0: Gprs, represents: file.Represents(values, g0),
    rsp_g0: read_gpr(Rsp, g0) = stack.at(d), kept_g0: Kept(callee_saved(), s0.gprs, g0),
    within: saved_registers().reloads(called, 0).Within(site.program)):
    site.Moves(stack.writes, prog_len(called), prog_len(saved_registers().reloads(called, 0)),
        λ (t: MachineState<M>) => stack.Returned(d, s0, g0, values(64, result), t),
        λ (t: MachineState<M>) => file.write(Rax, Some(Held(result, Word))).Represents(values, t.gprs) ∧ stack.Framed(d, s0, t)) {
    let saved = saved_registers();
    let sizes = saved_fit(d, stack.size, fits);
    let out_file = file.write(Rax, Some(Held(result, Word)));
    λ s3 here resident after_call => {
        let reloading = site.moves_reloads(stack, site.program.laid_out_fits(laid), d, g0, saved, called, 0, s3.gprs, sizes.left,
            sizes.right, trivial, after_call.left, λ (m: M) => stack.Wrote(d + 64, s0.memory, m), within);
        let e = reloading(s3, here, resident, ⟨refl, after_call.right.right.right⟩);
        let kept_s3: Kept(callee_saved(), s0.gprs, s3.gprs) =
            kept_saved(s0.gprs, s3.gprs, trans(after_call.left, sym(rsp0)),
                kept_trans(callee_kept(), s0.gprs, g0, s3.gprs, saved_kept(s0.gprs, g0, kept_g0), after_call.right.right.left));
        let finished = j(sym(e.proof.right.right.right.left), λ g _ => out_file.Represents(values, g) ∧ Kept(callee_saved(), s0.gprs, g),
            ⟨call_restores(values, file, result, g0, s3.gprs, represents, after_call.right.left, after_call.right.right.left,
                trans(after_call.left, sym(rsp_g0))), kept_restored(s0.gprs, g0, s3.gprs, kept_s3)⟩);
        Exists(e.witness, ⟨e.proof.left, ⟨e.proof.right.left, ⟨e.proof.right.right.left,
            ⟨finished.left, ⟨finished.right, e.proof.right.right.right.right⟩⟩⟩⟩⟩)
    }
}

// The call, its argument moves found.
theorem call_emits<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), bound: Nat, calls: site.Calls(stack, callees, bound), values: Valuation(), d: Nat, s0: MachineState<M>,
    rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 72 * bound + 8 <= d, fits: d + 64 <= stack.size,
    prog: Prog, file: File, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>, names: Nat,
    below: Succ(callee) <= bound, moves: Lowered, moves_keeps: Keeps<M>(values, file, True, moves),
    placed: moves.file.outputs_check(word_ports(arguments), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue()):
    EmitsIn<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, Call(callee, arguments, result)),
        Emitted(call_prog(prog, moves.code, callee), file.write(Rax, Some(Held(result, Word))), placement, names)) {
    let called = At(At(saved_registers().spills(prog, 0), 0, Block(moves.code)), 0, CallTo(Succ(callee)));
    let out_prog = saved_registers().reloads(called, 0);
    ⟨call_within(prog, moves.code, callee),
     λ within s here resident holds => {
        let framed: stack.Framed(d, s0, s) = holds.right;
        let rsp_s: (read_gpr(Rsp, s.gprs) = stack.at(d)) = trans(framed.left.right.right.left, rsp0);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(called), prog_len(out_prog),
            λ (x: MachineState<M>) => (x.gprs = s.gprs) ∧ stack.Wrote(d + 64, s0.memory, x.memory),
            λ (t: MachineState<M>) => stack.Returned(d, s0, s.gprs, values(64, result), t),
            λ (t: MachineState<M>) => file.write(Rax, Some(Held(result, Word))).Represents(values, t.gprs) ∧ stack.Framed(d, s0, t),
            call_returns<M>(site, laid, stack, callees, bound, calls, values, d, s0, room, fits, prog, file, callee, arguments,
                result, below, moves, moves_keeps, placed, leaves, s.gprs, holds.left.left, rsp_s, holds.left.right,
                called.within_trans(out_prog, site.program, Prog::within_reloads(saved_registers(), called, 0), within)),
            call_finishes<M>(site, laid, stack, values, d, s0, rsp0, fits, file, result, called, s.gprs, holds.left.left, rsp_s,
                framed.left, within),
            s, here, resident, ⟨refl, framed.right⟩)
     }⟩
}

// A call's argument moves, ordered (round 4). A move goes once its target
// holds nothing another pending move reads, or holds it in some other
// register too. When every pending move waits on another (a cycle, as
// `f(b, a)` with `a` in RDI and `b` in RSI), the first one's blocker is
// copied into a register no argument goes to and nothing pending needs:
// RAX, which the call clobbers anyway, else R10 or R11, both saved around
// the call. Untrusted: `outputs_check` judges where the moves end.
record ArgumentMove { port: Port, register: Gpr }

fn argument_moves(ports: List<Port>, registers: List<Gpr>) → List<ArgumentMove> {
    match ports {
        Nil => [],
        Cons(port, rest) => match registers {
            Nil => [],
            Cons(register, later) => Cons(ArgumentMove(port, register), argument_moves(rest, later)),
        },
    }
}

fn ArgumentMove::ports(self moves: List<ArgumentMove>) → List<Port> {
    match moves { Nil => [], Cons(m, rest) => Cons(m.port, ArgumentMove::ports(rest)) }
}

fn ArgumentMove::registers(self moves: List<ArgumentMove>) → List<Gpr> {
    match moves { Nil => [], Cons(m, rest) => Cons(m.register, ArgumentMove::registers(rest)) }
}

// Some pending move reads `id` into a register other than `register`.
fn ArgumentMove::reads(self pending: List<ArgumentMove>, id: Nat, register: Gpr) → Bool {
    match pending {
        Nil => False,
        Cons(m, rest) => (m.port.id.same(id) && !m.register.same(register)) || ArgumentMove::reads(rest, id, register),
    }
}

// Some register of `pool` other than `register` holds `id`.
fn File::holds_elsewhere(self file: File, id: Nat, register: Gpr, pool: List<Gpr>) → Bool {
    match pool {
        Nil => False,
        Cons(other, rest) => (!other.same(register) && match file.at(other) { None => False, Some(held) => held.id.same(id) })
            || file.holds_elsewhere(id, register, rest),
    }
}

// Writing `register` would lose a value a pending move still reads.
fn File::blocked(self file: File, register: Gpr, pending: List<ArgumentMove>) → Bool {
    match file.at(register) {
        None => False,
        Some(held) => ArgumentMove::reads(pending, held.id, register) && !file.holds_elsewhere(held.id, register, scratch_pool()),
    }
}

fn File::first_ready(self file: File, candidates, pending: List<ArgumentMove>) → Option<ArgumentMove> {
    match candidates {
        Nil => None,
        Cons(m, rest) => match file.blocked(m.register, pending) { False => Some(m), True => file.first_ready(rest, pending) },
    }
}

fn ArgumentMove::without(self pending: List<ArgumentMove>, register: Gpr) → List<ArgumentMove> {
    match pending {
        Nil => [],
        Cons(m, rest) => match m.register.same(register) { True => rest, False => Cons(m, ArgumentMove::without(rest, register)) },
    }
}

fn File::staging(self file: File, pending: List<ArgumentMove>, pool: List<Gpr>) → Option<Gpr> {
    match pool {
        Nil => None,
        Cons(register, rest) => match file.blocked(register, pending) { False => Some(register), True => file.staging(pending, rest) },
    }
}

fn schedule_moves(fuel: Nat) → File → List<ArgumentMove> → List<ArgumentMove> {
    match fuel {
        Zero => λ file pending => pending,
        Succ(more) => λ file pending => match pending {
            Nil => [],
            Cons(first, others) => match file.first_ready(Cons(first, others), Cons(first, others)) {
                Some(m) => Cons(m, schedule_moves(more, file.write(m.register, Some(Held(m.port.id, Word))),
                    ArgumentMove::without(Cons(first, others), m.register))),
                None => match file.at(first.register) {
                    None => Cons(first, others),
                    Some(held) => match file.staging(Cons(first, others), [Rax, R10, R11]) {
                        None => Cons(first, others),
                        Some(stage) => Cons(ArgumentMove(Port(id := held.id, width := 64), stage),
                            schedule_moves(more, file.write(stage, Some(held)), Cons(first, others))),
                    },
                },
            },
        },
    }
}

// The moves a call makes, in order.
fn File::call_moves(self file: File, arguments: List<Nat>) → List<ArgumentMove> {
    schedule_moves(3 * arguments.len() + 3, file, argument_moves(word_ports(arguments), argument_registers()))
}

// The call, refused where the callee is not below `bound` or the
// arguments do not all reach their registers.
fn File::emit_call(self file: File, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>,
    names, bound: Nat) → Option<Emitted> {
    match Succ(callee).leb(bound) {
        False => None,
        True => match file.move_outputs(ArgumentMove::ports(file.call_moves(arguments)), ArgumentMove::registers(file.call_moves(arguments))) {
            None => None,
            Some(moves) => match moves.file.outputs_check(word_ports(arguments), argument_registers()) &&
                leaves_all(moves.code, callee_saved()) {
                False => None,
                True => Some(Emitted(call_prog(prog, moves.code, callee), file.write(Rax, Some(Held(result, Word))), placement, names)),
            },
        },
    }
}

// A dataflow leaf, its code keeping the callee-saved registers.
fn emit_kept_nodes(prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match lower_nodes(nodes, placement, file) {
        None => None,
        Some(lowered) => match leaves_all(lowered.code, callee_saved()) {
            False => None,
            True => Some(Emitted(At(prog, 0, Block(lowered.code)), lowered.file, skip_nodes(nodes, placement), names)),
        },
    }
}

// ---------------------------------------------------------------------------
// Loops (round 5)
//
// A loop's code, its four labels the names after `names` (H, C, X, J):
//
//       moves: bound, inputs → counter, state registers
//   H:  TEST counter; JE X
//       body, its file the counter's and the state's
//       TEST exit bit; JE C
//       moves: next → state registers
//       MOV flag, 0
//       JMP J
//   C:  moves: count, next → counter, state registers
//       ADD counter, -1
//       JMP H
//   X:  MOV flag, 1
//   J:
//
// The counter holds the passes left, so the head's test is the bound's. A
// pass's body sees only its own valuation: the head's file holds the state
// and the counter under the parameters' and `count`'s names, and what the
// body leaves (any registers, its calls answered) is read back through its
// file at the exit test and the moves. After the loop the file is the
// outputs' and the exhausted bit's, nothing else: the loop is a barrier.

// One register per parameter, then the counter and the flag; the rest
// place the body.
record LoopRegisters { state: List<Gpr>, counter: Gpr, flag: Gpr, rest: List<Place> }

fn loop_registers(n: Nat, placement: List<Place>) → Option<LoopRegisters> {
    match n {
        Zero => match placement {
            Nil => None,
            Cons(counter, after) => match after {
                Nil => None,
                Cons(flag, rest) => match counter {
                    Folded => None,
                    Into(c) => match flag { Folded => None, Into(f) => Some(LoopRegisters([], c, f, rest)) },
                },
            },
        },
        Succ(m) => match placement {
            Nil => None,
            Cons(place, after) => match place {
                Folded => None,
                Into(register) => match loop_registers(m, after) {
                    None => None,
                    Some(registers) => Some(LoopRegisters(Cons(register, registers.state), registers.counter, registers.flag, registers.rest)),
                },
            },
        },
    }
}

// The flag cleared and set, and the counter stepped down.
fn LoopRegisters::clear(self registers: LoopRegisters) → Instruction { MovRI(registers.flag, BitVec::ofNat(0)) }
fn LoopRegisters::mark(self registers: LoopRegisters) → Instruction { MovRI(registers.flag, BitVec::ofNat(1)) }
fn LoopRegisters::step(self registers: LoopRegisters) → Instruction { AddRI8(registers.counter, BitVec::ofNat(255)) }

// The counter and the flag are none of the state's registers nor each
// other, and their instructions keep the callee-saved registers.
fn LoopRegisters::apart(self registers: LoopRegisters) → Bool {
    registers.counter.misses(registers.state) && (registers.flag.misses(Cons(registers.counter, registers.state)) &&
        (leaves_all([registers.clear()], callee_saved()) && (leaves_all([registers.mark()], callee_saved()) &&
            leaves_all([registers.step()], callee_saved()))))
}

// The code into the loop and the head's file.
record LoopEntry { registers: LoopRegisters, code: List<Instruction>, head: File }

fn loop_entry_with(registers: LoopRegisters, moves: Lowered, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat) →
    Option<LoopEntry> {
    match input_file(word_ports(Cons(count, parameters)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(head) => match moves.file.outputs_check(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) &&
            (leaves_all(moves.code, callee_saved()) && registers.apart()) {
            False => None,
            True => Some(LoopEntry(registers, moves.code, head)),
        },
    }
}

fn File::loop_entry_at(self file: File, registers: LoopRegisters, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat) →
    Option<LoopEntry> {
    match file.move_outputs(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(moves) => loop_entry_with(registers, moves, inputs, limit, parameters, count),
    }
}

fn File::loop_entry(self file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, placement: List<Place>) →
    Option<LoopEntry> {
    match loop_registers(parameters.len(), placement) {
        None => None,
        Some(registers) => file.loop_entry_at(registers, inputs, limit, parameters, count),
    }
}

// The code out of a pass: the exit bit's register, the moves to leave and
// to go round, and the file after the loop.
record LoopExit { register: Gpr, leave: List<Instruction>, back: List<Instruction>, out: File }

fn File::loop_exit_out(self file: File, register: Gpr, leave, back: Lowered, registers: LoopRegisters, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat) → Option<LoopExit> {
    match input_file(Cons(Port(id := exhausted, width := 1), word_ports(outputs)), Cons(registers.flag, registers.state)) {
        None => None,
        Some(out) => match file.check_one(exit, Some(Bit), register) &&
            (leave.file.outputs_check(word_ports(next), registers.state) && (leaves_all(leave.code, callee_saved()) &&
                (back.file.outputs_check(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) &&
                    leaves_all(back.code, callee_saved())))) {
            False => None,
            True => Some(LoopExit(register, leave.code, back.code, out)),
        },
    }
}

fn File::loop_exit_back(self file: File, register: Gpr, leave: Lowered, registers: LoopRegisters, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat) → Option<LoopExit> {
    match file.move_outputs(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(back) => file.loop_exit_out(register, leave, back, registers, count, exit, next, outputs, exhausted),
    }
}

fn File::loop_exit(self file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat) →
    Option<LoopExit> {
    match file.find(Held(exit, Bit)) {
        None => None,
        Some(found) => match file.move_outputs(word_ports(next), registers.state) {
            None => None,
            Some(leave) => file.loop_exit_back(found.register, leave, registers, count, exit, next, outputs, exhausted),
        },
    }
}

// The loop's code from the head (the four labels after `names`).
fn loop_head(prog: Prog, entry: LoopEntry, names: Nat) → Prog { At(At(prog, 0, Block(entry.code)), Succ(names), Block([])) }
fn loop_tested(prog: Prog, entry: LoopEntry, names: Nat) → Prog {
    loop_head(prog, entry, names).branch_label(entry.registers.counter, Succ(Succ(Succ(names))))
}
fn loop_jumped(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(At(pass.branch_label(exit.register, Succ(Succ(names))), 0, Block(exit.leave)), 0, Block([registers.clear()])), 0,
        Jmp(Succ(Succ(Succ(Succ(names))))))
}
fn loop_again(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(At(At(loop_jumped(pass, registers, exit, names), Succ(Succ(names)), Block([])), 0, Block(exit.back)), 0,
        Block([registers.step()])), 0, Jmp(Succ(names)))
}
fn loop_set(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(loop_again(pass, registers, exit, names), Succ(Succ(Succ(names))), Block([])), 0, Block([registers.mark()]))
}
fn loop_done(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(loop_set(pass, registers, exit, names), Succ(Succ(Succ(Succ(names)))), Block([]))
}

fn Emitted::loop_close(self pass: Emitted, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    names: Nat) → Option<Emitted> {
    match pass.file.loop_exit(registers, count, exit, next, outputs, exhausted) {
        None => None,
        Some(out) => Some(Emitted(loop_done(pass.prog, registers, out, names), out.out, pass.placement, pass.names)),
    }
}

// What a conditional tests: its bit where a register holds it (TEST, the
// second arm where it is zero), else the comparison the file knows it to be
// from a folded node (CMP of its operands' registers, the second arm where
// the comparison fails), the bit never materialised.
record Tested(file: File, condition: Nat) {
    test: Test,
    selects: (values: Valuation()) → (g: Gprs) → file.Represents(values, g) → test.taken(g) = !values(1, condition).head_bit(),
}

fn CompareOp::fails(self op: CompareOp) → ConditionCode { match op { Below => AE, Less => GE, Same => NE } }

theorem CompareOp::fails_holds(self op: CompareOp, flags: Flags): condition_holds(op.fails(), flags) = !op.flag(flags) {
    match op { Below => refl, Less => refl, Same => refl }
}

theorem compare_selects(values: Valuation(), g: Gprs, op: CompareOp, condition, left, right: Nat, a, b: Gpr,
    left_rep: values(64, left) = read_gpr(a, g), right_rep: values(64, right) = read_gpr(b, g),
    holds: op.Holds(values, condition, left, right)):
    Compare(op.fails(), a, b).taken(g) = !values(1, condition).head_bit()
{
    let x = read_gpr(a, g);
    let y = read_gpr(b, g);
    trans(op.fails_holds(sub_flags(x, y)),
        trans(cong_fn<Bool, Bool>(λ c => !c, op.flag_sub(x, y)),
            trans(j(left_rep, λ v _ => !op.apply(v, y) = !op.apply(values(64, left), y), refl),
                trans(j(right_rep, λ v _ => !op.apply(values(64, left), v) = !op.apply(values(64, left), values(64, right)), refl),
                    j(sym(holds), λ w _ => !op.apply(values(64, left), values(64, right)) = !w.head_bit(), refl)))))
}

fn File::compare_test(self file: File, condition: Nat, compared: Comparison,
    known: known_comparison(file.known, condition) = Some(compared)) → Option<Tested(file, condition)> {
    match file.find(Held(compared.left, Word)) {
        None => None,
        Some(a) => match file.find(Held(compared.right, Word)) {
            None => None,
            Some(b) => Some(Tested(Compare(compared.op.fails(), a.register, b.register),
                λ values g represents => compare_selects(values, g, compared.op, condition, compared.left, compared.right,
                    a.register, b.register, a.at.rep(values, g, represents), b.at.rep(values, g, represents),
                    known_comparison_holds(values, condition, compared, file.known, known, represents.right)))),
        },
    }
}

fn File::branch_test(self file: File, condition: Nat) → Option<Tested(file, condition)> {
    match file.find(Held(condition, Bit)) {
        Some(found) => Some(Tested(Nonzero(found.register),
            λ values g represents => found.register.tests_zero_bit(g, values(1, condition), found.at.rep(values, g, represents)))),
        None => match known: known_comparison(file.known, condition) {
            None => None,
            Some(compared) => file.compare_test(condition, compared, known),
        },
    }
}

// Round 2's `emit` with calls of the functions below `bound`.
fn StructuredRegion::emit_calls(self region: StructuredRegion, prog: Prog, file: File, placement: List<Place>, names, bound: Nat) →
    Option<Emitted> {
    match region {
        Dataflow(body) => emit_kept_nodes(prog, file, body.nodes, placement, names),
        Sequence(prefix, continuation) => match emit_kept_nodes(prog, file, prefix.nodes, placement, names) {
            None => None,
            Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
        },
        Compose(prefix, continuation) => match prefix.emit_calls(prog, file, placement, names, bound) {
            None => None,
            Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
        },
        Conditional(_, condition, _, _, when_true, when_false) => match file.branch_test(condition) {
            None => None,
            Some(tested) => match when_true.emit_calls(prog.branched(tested.test, Succ(names)), file, placement, Succ(Succ(names)), bound) {
                None => None,
                Some(yes) => match when_false.emit_calls(yes.prog.else_label(Succ(names), Succ(Succ(names))), file, yes.placement, yes.names, bound) {
                    None => None,
                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                },
            },
        },
        Call(callee, arguments, result) => file.emit_call(prog, callee, arguments, result, placement, names, bound),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) =>
            match file.loop_entry(inputs, limit, parameters, count, placement) {
                None => None,
                Some(entry) => match body.emit_calls(loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                    Succ(Succ(Succ(Succ(names)))), bound) {
                    None => None,
                    Some(pass) => pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names),
                },
            },
    }
}

theorem emits_in_seq<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, first_facts, second_facts: Type, first, out: Emitted,
    first_emits: EmitsIn<M>(site, stack, values, d, s0, prog, file, first_facts, first),
    second_emits: EmitsIn<M>(site, stack, values, d, s0, first.prog, first.file, second_facts, out)):
    EmitsIn<M>(site, stack, values, d, s0, prog, file, first_facts ∧ second_facts, out) {
    ⟨prog.within_trans(first.prog, out.prog, first_emits.left, second_emits.left),
     λ within => site.moves_trans(stack.writes, prog_len(prog), prog_len(first.prog), prog_len(out.prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (first_facts ∧ second_facts)) ∧ stack.Framed(d, s0, s),
        λ (s: MachineState<M>) => (first.file.Represents(values, s.gprs) ∧ second_facts) ∧ stack.Framed(d, s0, s),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t),
        site.moves_weaken(stack.writes, prog_len(prog), prog_len(first.prog),
            λ (s: MachineState<M>) => ((file.Represents(values, s.gprs) ∧ first_facts) ∧ stack.Framed(d, s0, s)) ∧ second_facts,
            λ (t: MachineState<M>) => (first.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t)) ∧ second_facts,
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (first_facts ∧ second_facts)) ∧ stack.Framed(d, s0, s),
            λ (s: MachineState<M>) => (first.file.Represents(values, s.gprs) ∧ second_facts) ∧ stack.Framed(d, s0, s),
            site.moves_carry(stack.writes, prog_len(prog), prog_len(first.prog),
                λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ first_facts) ∧ stack.Framed(d, s0, s),
                λ (t: MachineState<M>) => first.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t), second_facts,
                first_emits.right(first.prog.within_trans(out.prog, site.program, second_emits.left, within))),
            λ s held => ⟨⟨⟨held.left.left, held.left.right.left⟩, held.right⟩, held.left.right.right⟩,
            λ t held => ⟨⟨held.left.left, held.right⟩, held.left.right⟩),
        second_emits.right(within))⟩
}

theorem may_emit_in_seq<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, first_facts, second_facts: Type, first: Emitted,
    first_emits: EmitsIn<M>(site, stack, values, d, s0, prog, file, first_facts, first), second: Option<Emitted>):
    MayEmitIn<M>(site, stack, values, d, s0, first.prog, first.file, second_facts, second) →
    MayEmitIn<M>(site, stack, values, d, s0, prog, file, first_facts ∧ second_facts, second) {
    match second {
        None => λ _ => trivial,
        Some(out) => λ second_emits => emits_in_seq<M>(site, stack, values, d, s0, prog, file, first_facts, second_facts, first, out,
            first_emits, second_emits),
    }
}

// A block that keeps the file's description and the callee-saved registers.
theorem kept_block_emits<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, lowered: Lowered,
    keeps: Keeps<M>(values, file, facts, lowered), leaves: leaves_all(lowered.code, callee_saved()).IsTrue(),
    placement: List<Place>, names: Nat):
    EmitsIn<M>(site, stack, values, d, s0, prog, file, facts, Emitted(At(prog, 0, Block(lowered.code)), lowered.file, placement, names)) {
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
    let post = λ (g: Gprs) (m: M) => lowered.file.Represents(values, g) ∧
        (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
    ⟨prog.within_then(0, Block(lowered.code)),
     λ within => site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(lowered.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), within.witness, prog, 0, lowered.code, within.proof,
            site.program.block_reads_at(laid, within.witness, prog, 0, lowered.code, within.proof),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => ⟨keeps(x, held.left.left, held.left.right),
                ⟨kept_trans(callee_saved(), s0.gprs, x.gprs, execute_block_normal(lowered.code, x).gprs, held.right.left,
                    execute_block_kept<M>(lowered.code, x, callee_saved(), leaves)), held.right.right⟩⟩))⟩
}

theorem is_true_of_eq(b: Bool, same: b = True): b.IsTrue() { j(sym(same), λ c _ => c.IsTrue(), trivial) }

theorem emit_kept_nodes_emits<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    MayEmitIn<M>(site, stack, values, d, s0, prog, file, NodesHold(values, nodes), emit_kept_nodes(prog, file, nodes, placement, names)) {
    (match lower_nodes(nodes, placement, file) as λ lowered =>
        MayKeep<M>(values, file, NodesHold(values, nodes), lowered) →
        MayEmitIn<M>(site, stack, values, d, s0, prog, file, NodesHold(values, nodes), match lowered {
            None => None,
            Some(l) => match leaves_all(l.code, callee_saved()) {
                False => None,
                True => Some(Emitted(At(prog, 0, Block(l.code)), l.file, skip_nodes(nodes, placement), names)),
            },
        }) {
        None => λ _ => trivial,
        Some(lowered) => λ keeps =>
            match left: leaves_all(lowered.code, callee_saved()) {
                False => trivial,
                True => kept_block_emits<M>(site, laid, stack, values, d, s0, prog, file, NodesHold(values, nodes), lowered,
                    keeps, is_true_of_eq(leaves_all(lowered.code, callee_saved()), left), skip_nodes(nodes, placement), names),
            },
    })(lower_nodes_keeps<M>(values, nodes, placement, file))
}

theorem when_nonzero_in(callees: Callees(), values: Valuation(), inputs: Ports, condition: Nat, arguments, outputs: Ports,
    when_true, when_false: StructuredRegion, clear: !values(1, condition).head_bit() = False,
    holds: StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false))):
    StructuredRegionHoldsIn(callees, values, when_true) {
    (match values(1, condition).head_bit() as λ h => !h = False →
        (match h { False => StructuredRegionHoldsIn(callees, values, when_false), True => StructuredRegionHoldsIn(callees, values, when_true) }) →
        StructuredRegionHoldsIn(callees, values, when_true) {
        False => λ no _ => absurd(no),
        True => λ _ held => held,
    })(clear, holds)
}

theorem when_zero_in(callees: Callees(), values: Valuation(), inputs: Ports, condition: Nat, arguments, outputs: Ports,
    when_true, when_false: StructuredRegion, set: !values(1, condition).head_bit() = True,
    holds: StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false))):
    StructuredRegionHoldsIn(callees, values, when_false) {
    (match values(1, condition).head_bit() as λ h => !h = True →
        (match h { False => StructuredRegionHoldsIn(callees, values, when_false), True => StructuredRegionHoldsIn(callees, values, when_true) }) →
        StructuredRegionHoldsIn(callees, values, when_false) {
        False => λ _ held => held,
        True => λ no _ => absurd(no),
    })(set, holds)
}

theorem branch_emits_in<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    inputs: Ports, condition: Nat, arguments, outputs: Ports, when_true, when_false: StructuredRegion,
    tested: Tested(file, condition), names: Nat, yes, no: Emitted,
    yes_emits: EmitsIn<M>(site, stack, values, d, s0, prog.branched(tested.test, Succ(names)), file, StructuredRegionHoldsIn(callees, values, when_true), yes),
    no_emits: EmitsIn<M>(site, stack, values, d, s0, yes.prog.else_label(Succ(names), Succ(Succ(names))), file, StructuredRegionHoldsIn(callees, values, when_false), no)):
    EmitsIn<M>(site, stack, values, d, s0, prog, file,
        StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false)),
        Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)) {
    let test = tested.test;
    let else_name = Succ(names);
    let join_name = Succ(Succ(names));
    let branched = prog.branched(test, else_name);
    let jumped = At(yes.prog, 0, Jmp(join_name));
    let second = yes.prog.else_label(else_name, join_name);
    let to_branch = prog.within_step(prog.tested(test), 0, Jcc(test.cc(), else_name),
        prog.within_then(0, Block([test.instruction()])));
    let to_second = prog.within_step(jumped, else_name, Block([]),
        prog.within_step(yes.prog, 0, Jmp(join_name), prog.within_trans(branched, yes.prog, to_branch, yes_emits.left)));
    let holds = StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false));
    let framed = λ (g: Gprs) (m: M) => Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ holds) ∧ framed(g, m);
    let post = λ (g: Gprs) (m: M) => yes.file.meet(no.file, file.known).Represents(values, g) ∧ framed(g, m);
    let known = KnownHold(values, file.known);
    ⟨prog.within_step(no.prog, join_name, Block([]), prog.within_trans(second, no.prog, to_second, no_emits.left)),
     λ within => {
        let program = site.program;
        let labels = asm_labels(program);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let no_in = no.prog.within_before(join_name, Block([]), program, within);
        let second_in = second.within_trans(no.prog, program, no_emits.left, no_in);
        let jumped_in = jumped.within_before(else_name, Block([]), program, second_in);
        let yes_in = yes.prog.within_before(0, Jmp(join_name), program, jumped_in);
        let branched_in = branched.within_trans(yes.prog, program, yes_emits.left, yes_in);
        let tested_in = prog.tested(test).within_before(0, Jcc(test.cc(), else_name), program, branched_in);
        let else_lands = j(label_target(second_in.witness, program, jumped, names, Block([]), unique, second_in.proof),
            λ to _ => JumpsForward(prog_len(prog.tested(test)), 6,
                asm_jump_of(labels, prog_len(prog.tested(test)), Jcc(test.cc(), else_name)), to),
            jcc_lands(labels, branched_in.witness, program, prog.tested(test), 0, test.cc(), else_name, lands, branched_in.proof));
        let join_lands = j(label_target(within.witness, program, no.prog, Succ(names), Block([]), unique, within.proof),
            λ to _ => NearLands(prog_len(yes.prog), asm_jump_of(labels, prog_len(yes.prog), Jmp(join_name)), to),
            jmp_lands(labels, jumped_in.witness, program, yes.prog, 0, join_name, lands, jumped_in.proof));
        let selects = tested.selects(values);
        site.moves_branch_on(stack.writes, program.laid_out_fits(laid), prog, test, else_name, join_name, yes.prog, no.prog,
            tested_in.witness, tested_in.proof, branched_in.witness, branched_in.proof, jumped_in.witness, jumped_in.proof,
            else_lands, join_lands, pre, post,
            site.moves_weaken(stack.writes, prog_len(branched), prog_len(yes.prog),
                λ (s: MachineState<M>) => ((file.Represents(values, s.gprs) ∧ StructuredRegionHoldsIn(callees, values, when_true)) ∧ stack.Framed(d, s0, s)) ∧ known,
                λ (t: MachineState<M>) => (yes.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t)) ∧ known,
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_carry(stack.writes, prog_len(branched), prog_len(yes.prog),
                    λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ StructuredRegionHoldsIn(callees, values, when_true)) ∧ stack.Framed(d, s0, s),
                    λ (t: MachineState<M>) => yes.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t), known, yes_emits.right(yes_in)),
                λ s held => ⟨⟨⟨held.left.left.left, when_nonzero_in(callees, values, inputs, condition, arguments, outputs, when_true, when_false,
                    trans(sym(selects(s.gprs, held.left.left.left)), held.right), held.left.left.right)⟩, held.left.right⟩,
                    held.left.left.left.right⟩,
                λ t held => ⟨yes.file.meet_left(values, t.gprs, no.file, file.known, held.left.left, held.right), held.left.right⟩),
            site.moves_weaken(stack.writes, prog_len(second), prog_len(no.prog),
                λ (s: MachineState<M>) => ((file.Represents(values, s.gprs) ∧ StructuredRegionHoldsIn(callees, values, when_false)) ∧ stack.Framed(d, s0, s)) ∧ known,
                λ (t: MachineState<M>) => (no.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t)) ∧ known,
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_carry(stack.writes, prog_len(second), prog_len(no.prog),
                    λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ StructuredRegionHoldsIn(callees, values, when_false)) ∧ stack.Framed(d, s0, s),
                    λ (t: MachineState<M>) => no.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t), known, no_emits.right(no_in)),
                λ s held => ⟨⟨⟨held.left.left.left, when_zero_in(callees, values, inputs, condition, arguments, outputs, when_true, when_false,
                    trans(sym(selects(s.gprs, held.left.left.left)), held.right), held.left.left.right)⟩, held.left.right⟩,
                    held.left.left.left.right⟩,
                λ t held => ⟨yes.file.meet_right(values, t.gprs, no.file, file.known, held.left.left, held.right), held.left.right⟩))
     }⟩
}

theorem File::emit_call_emits<M>(self file: File, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), callees: Callees(), bound: Nat, calls: site.Calls(stack, callees, bound),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 72 * bound + 8 <= d,
    fits: d + 64 <= stack.size, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>, names: Nat):
    MayEmitIn<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, Call(callee, arguments, result)),
        file.emit_call(prog, callee, arguments, result, placement, names, bound)) {
    let facts = StructuredRegionHoldsIn(callees, values, Call(callee, arguments, result));
    let ports = word_ports(arguments);
    let order = file.call_moves(arguments);
    let out_file = file.write(Rax, Some(Held(result, Word)));
    match under: Succ(callee).leb(bound) {
        False => trivial,
        True => (match file.move_outputs(ArgumentMove::ports(order), ArgumentMove::registers(order)) as λ moved =>
                MayKeep<M>(values, file, True, moved) →
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, facts, match moved {
                    None => None,
                    Some(moves) => match moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                        False => None,
                        True => Some(Emitted(call_prog(prog, moves.code, callee), out_file, placement, names)),
                    },
                }) {
                None => λ _ => trivial,
                Some(moves) => λ keeps =>
                    match checked: moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                        False => trivial,
                        True => {
                            let both = Bool::is_true_and(moves.file.outputs_check(ports, argument_registers()),
                                leaves_all(moves.code, callee_saved()),
                                is_true_of_eq(moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()),
                                    checked));
                            call_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, prog, file, callee,
                                arguments, result, placement, names,
                                Succ(callee).leb_sound(bound, is_true_of_eq(Succ(callee).leb(bound), under)),
                                moves, keeps, both.left, both.right)
                        },
                    },
            })(move_outputs_keeps<M>(values, ArgumentMove::ports(order), file, ArgumentMove::registers(order))),
    }
}

// ---------------------------------------------------------------------------
// Loops: what the checks give

fn LoopRegisters::Apart(self registers: LoopRegisters) → Type {
    registers.counter.misses(registers.state).IsTrue() ∧ (registers.flag.misses(registers.state).IsTrue() ∧
        (leaves_all([registers.clear()], callee_saved()).IsTrue() ∧ (leaves_all([registers.mark()], callee_saved()).IsTrue() ∧
            leaves_all([registers.step()], callee_saved()).IsTrue())))
}

theorem LoopRegisters::apart_sound(self registers: LoopRegisters, apart: registers.apart().IsTrue()): registers.Apart() {
    let clear = leaves_all([registers.clear()], callee_saved());
    let mark = leaves_all([registers.mark()], callee_saved());
    let step = leaves_all([registers.step()], callee_saved());
    let flag = registers.flag.misses(Cons(registers.counter, registers.state));
    let first = Bool::is_true_and(registers.counter.misses(registers.state), flag && (clear && (mark && step)), apart);
    let second = Bool::is_true_and(flag, clear && (mark && step), first.right);
    let flagged = Bool::is_true_and(!registers.flag.same(registers.counter), registers.flag.misses(registers.state), second.left);
    let third = Bool::is_true_and(clear, mark && step, second.right);
    let fourth = Bool::is_true_and(mark, step, third.right);
    ⟨first.left, ⟨flagged.right, ⟨third.left, ⟨fourth.left, fourth.right⟩⟩⟩⟩
}

// Moving `ids` into `registers`: their words land there, the callee-saved
// registers kept.
fn MovesInto<M>(values: Valuation(), file: File, ids: List<Nat>, registers: List<Gpr>, code: List<Instruction>) → Type {
    (s: MachineState<M>) → file.Represents(values, s.gprs) →
        ArgsIn(words_of(values, ids), registers, execute_block_normal(code, s).gprs) ∧
        Kept(callee_saved(), s.gprs, execute_block_normal(code, s).gprs)
}

theorem moves_into<M>(values: Valuation(), file: File, ids: List<Nat>, registers: List<Gpr>, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), placed: moves.file.outputs_check(word_ports(ids), registers).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue()): MovesInto<M>(values, file, ids, registers, moves.code) {
    λ s represents => ⟨ports_args(values, ids, registers, execute_block_normal(moves.code, s).gprs,
            outputs_check_sound(values, moves.file, execute_block_normal(moves.code, s).gprs, keeps(s, represents, trivial),
                word_ports(ids), registers, placed)),
        execute_block_kept<M>(moves.code, s, callee_saved(), leaves)⟩
}

// The entry's code moves the bound and the inputs into the counter and the
// state's registers, and the head's file describes every pass whose
// parameters and count are there.
fn LoopEntryOk<M>(values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    entry: LoopEntry) → Type {
    MovesInto<M>(values, file, Cons(limit, inputs), Cons(entry.registers.counter, entry.registers.state), entry.code) ∧
    (((pass: Valuation()) → (g: Gprs) →
        ArgsIn(words_of(pass, Cons(count, parameters)), Cons(entry.registers.counter, entry.registers.state), g) →
        entry.head.Represents(pass, g)) ∧ entry.registers.Apart())
}

fn MayLoopEntry<M>(values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    out: Option<LoopEntry>) → Type {
    out.All(λ (entry: LoopEntry) => LoopEntryOk<M>(values, file, inputs, limit, parameters, count, entry))
}

theorem loop_entry_with_sound<M>(values: Valuation(), file: File, registers: LoopRegisters, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat):
    MayLoopEntry<M>(values, file, inputs, limit, parameters, count, loop_entry_with(registers, moves, inputs, limit, parameters, count)) {
    let into = Cons(registers.counter, registers.state);
    let placed = moves.file.outputs_check(word_ports(Cons(limit, inputs)), into);
    let kept = leaves_all(moves.code, callee_saved());
    (match input_file(word_ports(Cons(count, parameters)), into) as λ o =>
        ((pass: Valuation()) → (g: Gprs) → PortsAt(pass, word_ports(Cons(count, parameters)), into, g) →
            o.All(λ (f: File) => f.Represents(pass, g))) →
        MayLoopEntry<M>(values, file, inputs, limit, parameters, count, match o {
            None => None,
            Some(head) => match placed && (kept && registers.apart()) {
                False => None,
                True => Some(LoopEntry(registers, moves.code, head)),
            },
        }) {
        None => λ _ => trivial,
        Some(head) => λ head_ok =>
            match checked: placed && (kept && registers.apart()) {
                False => trivial,
                True => {
                    let all = Bool::is_true_and(placed, kept && registers.apart(), is_true_of_eq(placed && (kept && registers.apart()), checked));
                    let rest = Bool::is_true_and(kept, registers.apart(), all.right);
                    ⟨moves_into<M>(values, file, Cons(limit, inputs), into, moves, keeps, all.left, rest.left),
                     ⟨λ pass g args => head_ok(pass, g, args_ports(pass, Cons(count, parameters), into, g, args)),
                      registers.apart_sound(rest.right)⟩⟩
                },
            },
    })(λ pass g placed_at => input_file_represents(pass, g, word_ports(Cons(count, parameters)), into, placed_at))
}

theorem loop_entry_at_sound<M>(values: Valuation(), file: File, registers: LoopRegisters, inputs: List<Nat>, limit: Nat,
    parameters: List<Nat>, count: Nat):
    MayLoopEntry<M>(values, file, inputs, limit, parameters, count, file.loop_entry_at(registers, inputs, limit, parameters, count)) {
    (match file.move_outputs(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) as λ o =>
        MayKeep<M>(values, file, True, o) →
        MayLoopEntry<M>(values, file, inputs, limit, parameters, count, match o {
            None => None,
            Some(moves) => loop_entry_with(registers, moves, inputs, limit, parameters, count),
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => loop_entry_with_sound<M>(values, file, registers, moves, keeps, inputs, limit, parameters, count),
    })(move_outputs_keeps<M>(values, word_ports(Cons(limit, inputs)), file, Cons(registers.counter, registers.state)))
}

theorem loop_entry_sound<M>(values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    placement: List<Place>):
    MayLoopEntry<M>(values, file, inputs, limit, parameters, count, file.loop_entry(inputs, limit, parameters, count, placement)) {
    match loop_registers(parameters.len(), placement) {
        None => trivial,
        Some(registers) => loop_entry_at_sound<M>(values, file, registers, inputs, limit, parameters, count),
    }
}

// At the exit test the exit bit's register tests zero exactly when the bit
// is clear; the moves leave or go round; and the file after the loop
// describes the outputs in the state's registers and the exhausted bit in
// the flag.
fn LoopExitOk<M>(file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    out: LoopExit) → Type {
    ((pass: Valuation()) → (g: Gprs) → file.Represents(pass, g) → out.register.tests_zero(g) = !pass(1, exit).head_bit()) ∧
    (((pass: Valuation()) → MovesInto<M>(pass, file, next, registers.state, out.leave)) ∧
     (((pass: Valuation()) → MovesInto<M>(pass, file, Cons(count, next), Cons(registers.counter, registers.state), out.back)) ∧
      ((values: Valuation()) → (g: Gprs) → ArgsIn(words_of(values, outputs), registers.state, g) →
        values(1, exhausted).zero_extend(63) = read_gpr(registers.flag, g) → out.out.Represents(values, g))))
}

fn MayLoopExit<M>(file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    out: Option<LoopExit>) → Type {
    out.All(λ (x: LoopExit) => LoopExitOk<M>(file, registers, count, exit, next, outputs, exhausted, x))
}

theorem loop_exit_out_sound<M>(file: File, register: Gpr, leave, back: Lowered,
    leave_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, leave), back_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, back),
    registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted,
        file.loop_exit_out(register, leave, back, registers, count, exit, next, outputs, exhausted)) {
    let ports = Cons(Port(id := exhausted, width := 1), word_ports(outputs));
    let into = Cons(registers.flag, registers.state);
    let found = file.check_one(exit, Some(Bit), register);
    let leave_placed = leave.file.outputs_check(word_ports(next), registers.state);
    let leave_kept = leaves_all(leave.code, callee_saved());
    let back_placed = back.file.outputs_check(word_ports(Cons(count, next)), Cons(registers.counter, registers.state));
    let back_kept = leaves_all(back.code, callee_saved());
    (match input_file(ports, into) as λ o =>
        ((values: Valuation()) → (g: Gprs) → PortsAt(values, ports, into, g) → o.All(λ (f: File) => f.Represents(values, g))) →
        MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted, match o {
            None => None,
            Some(after) => match found && (leave_placed && (leave_kept && (back_placed && back_kept))) {
                False => None,
                True => Some(LoopExit(register, leave.code, back.code, after)),
            },
        }) {
        None => λ _ => trivial,
        Some(after) => λ after_ok =>
            match checked: found && (leave_placed && (leave_kept && (back_placed && back_kept))) {
                False => trivial,
                True => {
                    let first = Bool::is_true_and(found, leave_placed && (leave_kept && (back_placed && back_kept)),
                        is_true_of_eq(found && (leave_placed && (leave_kept && (back_placed && back_kept))), checked));
                    let second = Bool::is_true_and(leave_placed, leave_kept && (back_placed && back_kept), first.right);
                    let third = Bool::is_true_and(leave_kept, back_placed && back_kept, second.right);
                    let fourth = Bool::is_true_and(back_placed, back_kept, third.right);
                    ⟨λ pass g represents => register.tests_zero_bit(g, pass(1, exit),
                        check_one_sound(pass, file, g, represents, exit, Some(Bit), register, first.left)),
                     ⟨λ pass => moves_into<M>(pass, file, next, registers.state, leave, leave_keeps(pass), second.left, third.left),
                      ⟨λ pass => moves_into<M>(pass, file, Cons(count, next), Cons(registers.counter, registers.state), back, back_keeps(pass),
                            fourth.left, fourth.right),
                       λ values g args flag => after_ok(values, g, ⟨flag, args_ports(values, outputs, registers.state, g, args)⟩)⟩⟩⟩
                },
            },
    })(λ values g placed => input_file_represents(values, g, ports, into, placed))
}

theorem loop_exit_back_sound<M>(file: File, register: Gpr, leave: Lowered, leave_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, leave),
    registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted,
        file.loop_exit_back(register, leave, registers, count, exit, next, outputs, exhausted)) {
    (match file.move_outputs(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) as λ o =>
        ((pass: Valuation()) → MayKeep<M>(pass, file, True, o)) →
        MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted, match o {
            None => None,
            Some(back) => file.loop_exit_out(register, leave, back, registers, count, exit, next, outputs, exhausted),
        }) {
        None => λ _ => trivial,
        Some(back) => λ back_keeps => loop_exit_out_sound<M>(file, register, leave, back, leave_keeps, back_keeps, registers, count, exit,
            next, outputs, exhausted),
    })(λ pass => move_outputs_keeps<M>(pass, word_ports(Cons(count, next)), file, Cons(registers.counter, registers.state)))
}

theorem loop_exit_sound<M>(file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted, file.loop_exit(registers, count, exit, next, outputs, exhausted)) {
    match file.find(Held(exit, Bit)) {
        None => trivial,
        Some(found) =>
            (match file.move_outputs(word_ports(next), registers.state) as λ o =>
                ((pass: Valuation()) → MayKeep<M>(pass, file, True, o)) →
                MayLoopExit<M>(file, registers, count, exit, next, outputs, exhausted, match o {
                    None => None,
                    Some(leave) => file.loop_exit_back(found.register, leave, registers, count, exit, next, outputs, exhausted),
                }) {
                None => λ _ => trivial,
                Some(leave) => λ leave_keeps => loop_exit_back_sound<M>(file, found.register, leave, leave_keeps, registers, count, exit,
                    next, outputs, exhausted),
            })(λ pass => move_outputs_keeps<M>(pass, word_ports(next), file, registers.state)),
    }
}

// ---------------------------------------------------------------------------
// Loops: the counter

theorem Gpr::tests_zero_at(self register: Gpr, gprs: Gprs, word: BitVec(64), held: read_gpr(register, gprs) = word):
    register.tests_zero(gprs) = is_zero_bits(64, word.band(word)) {
    j(held, λ w _ => register.tests_zero(gprs) = is_zero_bits(64, w.band(w)), refl)
}

theorem loop_counter_zero(): is_zero_bits(64, BitVec::ofNat(0, n := 64).band(BitVec::ofNat(0, n := 64))) = True { refl }

theorem loop_counter_nonzero(rest: Nat, lt: Succ(rest) < Nat::pow(2, 64)):
    is_zero_bits(64, BitVec::ofNat(Succ(rest), n := 64).band(BitVec::ofNat(Succ(rest), n := 64))) = False {
    let positive: (0 < Succ(rest)) = { omega };
    test_self_nonzero(64, BitVec::ofNat(Succ(rest), n := 64),
        j(sym(BitVec::toNat_ofNat(64, Succ(rest), lt)), λ x _ => 0 < x, positive))
}

// ADD counter, -1 counts a pass off.
theorem loop_counter_step(rest: Nat):
    BitVec::ofNat(Succ(rest), n := 64).add(BitVec::ofNat(255, n := 8).sign_extend(56)) = BitVec::ofNat(rest, n := 64) {
    let c = BitVec::ofNat(255, n := 8).sign_extend(56);
    let zero = BitVec::zero(n := 64);
    let reading: (c.toNat() = Nat::pow(2, 64) - 1) = refl;
    let count: (Succ(rest) + (Nat::pow(2, 64) - 1) = rest + Nat::pow(2, 64)) = { omega };
    trans(sym(BitVec::iter_add_eq_add(64, BitVec::ofNat(Succ(rest), n := 64), c)),
    trans(BitVec::cong_iterate_increment_count(64, BitVec::ofNat(Succ(rest), n := 64), reading),
    trans(BitVec::cong_iterate_increment(64, Nat::pow(2, 64) - 1, sym(BitVec::zero_iterate_increment(64, Succ(rest)))),
    trans(BitVec::iterate_increment_compose(64, zero, Succ(rest), Nat::pow(2, 64) - 1),
    trans(BitVec::cong_iterate_increment_count(64, zero, count),
    trans(sym(BitVec::iterate_increment_compose(64, zero, rest, Nat::pow(2, 64))),
    trans(BitVec::iterate_increment_period(64, zero.iterate_increment(rest)), BitVec::zero_iterate_increment(64, rest))))))))
}

// ---------------------------------------------------------------------------
// Loops: the passes

// The loop's passes over its code from the head, by induction on the passes
// left: with none the loop stops exhausted; otherwise a pass runs and leaves,
// or goes round to the head with one fewer.
theorem Site::loop_passes<M>(self site: Site<M>, writes: ByteWrites<M>, head_at, done_at: Nat,
    Head: Nat → List<BitVec(64)> → MachineState<M> → Type, Done: List<BitVec(64)> → Bool → MachineState<M> → Type,
    pass: Valuation() → Type, parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    stop: (state: List<BitVec(64)>) → site.Moves(writes, head_at, done_at, Head(0, state), Done(state, True)),
    leave: (rest: Nat) → Succ(rest) < Nat::pow(2, 64) → (values: Valuation()) → values(64, count) = BitVec::ofNat(Succ(rest)) →
        pass(values) → values(1, exit).head_bit() = True →
        site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters)), Done(words_of(values, next), False)),
    again: (rest: Nat) → Succ(rest) < Nat::pow(2, 64) → (values: Valuation()) → values(64, count) = BitVec::ofNat(Succ(rest)) →
        pass(values) → values(1, exit).head_bit() = False →
        site.Moves(writes, head_at, head_at, Head(Succ(rest), words_of(values, parameters)), Head(rest, words_of(values, next))),
    remaining: Nat): remaining < Nat::pow(2, 64) → (state, final: List<BitVec(64)>) → (exhausted: Bool) →
    LoopRuns(pass, parameters, count, exit, next, remaining, state, final, exhausted) →
    site.Moves(writes, head_at, done_at, Head(remaining, state), Done(final, exhausted)) {
    match remaining {
        Zero => λ _ state final exhausted ran =>
            j(sym(ran.right), λ e _ => site.Moves(writes, head_at, done_at, Head(0, state), Done(final, e)),
                j(sym(ran.left), λ f _ => site.Moves(writes, head_at, done_at, Head(0, state), Done(f, True)), stop(state))),
        Succ(rest) => λ lt state final exhausted ran => {
            let values = ran.witness;
            let under: (rest < Nat::pow(2, 64)) = { omega };
            j(ran.proof.left, λ st _ => site.Moves(writes, head_at, done_at, Head(Succ(rest), st), Done(final, exhausted)),
                (match values(1, exit).head_bit() as λ b => values(1, exit).head_bit() = b →
                    (match b {
                        False => LoopRuns(pass, parameters, count, exit, next, rest, words_of(values, next), final, exhausted),
                        True => (final = words_of(values, next)) ∧ (exhausted = False),
                    }) →
                    site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters)), Done(final, exhausted)) {
                    False => λ clear later => site.moves_trans(writes, head_at, head_at, done_at,
                        Head(Succ(rest), words_of(values, parameters)), Head(rest, words_of(values, next)), Done(final, exhausted),
                        again(rest, lt, values, ran.proof.right.left, ran.proof.right.right.left, clear),
                        site.loop_passes(writes, head_at, done_at, Head, Done, pass, parameters, count, exit, next, stop, leave, again,
                            rest, under, words_of(values, next), final, exhausted, later)),
                    True => λ set ended =>
                        j(sym(ended.right), λ e _ =>
                                site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters)), Done(final, e)),
                            j(sym(ended.left), λ f _ =>
                                    site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters)), Done(f, False)),
                                leave(rest, lt, values, ran.proof.right.left, ran.proof.right.right.left, set))),
                })(refl, ran.proof.right.right.right))
        },
    }
}

// The state at the head with `remaining` passes left: the state's words in
// their registers, the counter, and the frame.
fn Stack::LoopHead<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>, registers: LoopRegisters, remaining: Nat, state: List<BitVec(64)>) → Gprs → M → Type {
    λ g m => (ArgsIn(state, registers.state, g) ∧ read_gpr(registers.counter, g) = BitVec::ofNat(remaining)) ∧
        (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m))
}

// After a pass's body: its file describes the pass's valuation.
fn Stack::LoopPassed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>, file: File, values: Valuation()) → Gprs → M → Type {
    λ g m => file.Represents(values, g) ∧ (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m))
}

// At the loop's end: the final state in the state's registers, the
// exhausted bit in the flag.
fn Stack::LoopDone<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>, registers: LoopRegisters, final: List<BitVec(64)>, exhausted: Bool) → Gprs → M → Type {
    λ g m => (ArgsIn(final, registers.state, g) ∧ BitVec::ofBool(exhausted).zero_extend(63) = read_gpr(registers.flag, g)) ∧
        (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m))
}

// With no passes left the head's test jumps to X.
theorem loop_stops<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), d: Nat,
    s0: MachineState<M>, head: Prog, registers: LoopRegisters, x_name, x_at: Nat, x_lands: asm_target(site.program, x_name) = x_at,
    tested_in: head.branch_label(registers.counter, x_name).Within(site.program), state: List<BitVec(64)>, to: Nat,
    post: MachineState<M> → Type,
    exhausted: site.Moves(stack.writes, x_at, to,
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, registers, 0, state)(s.gprs, s.memory), post)):
    site.Moves(stack.writes, prog_len(head), to, λ (s: MachineState<M>) => stack.LoopHead(d, s0, registers, 0, state)(s.gprs, s.memory),
        post) {
    let program = site.program;
    let counter = registers.counter;
    let tested = head.test_label(counter);
    let test_in = tested.within_before(0, Jcc(E, x_name), program, tested_in);
    let else_lands = j(x_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, x_name)), target),
        jcc_lands(asm_labels(program), tested_in.witness, program, tested, 0, E, x_name, program.laid_out_lands(laid), tested_in.proof));
    let pre = stack.LoopHead(d, s0, registers, 0, state);
    site.moves_test(stack.writes, program.laid_out_fits(laid), head, counter, x_name, test_in.witness, test_in.proof,
        tested_in.witness, tested_in.proof, x_at, else_lands, to, pre, post,
        site.moves_absurd(stack.writes, prog_len(head.branch_label(counter, x_name)), to,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = False, post,
            λ s held => {
                let bad: (True = False) = trans(sym(loop_counter_zero()),
                    trans(sym(counter.tests_zero_at(s.gprs, BitVec::ofNat(0), held.left.left.right)), held.right));
                absurd(bad)
            }),
        site.moves_weaken(stack.writes, x_at, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), post,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = True, post,
            exhausted, λ s held => held.left, λ t held => held))
}

// With passes left the head's test falls through to the body.
theorem loop_enters<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), d: Nat,
    s0: MachineState<M>, head: Prog, registers: LoopRegisters, x_name, x_at: Nat, x_lands: asm_target(site.program, x_name) = x_at,
    tested_in: head.branch_label(registers.counter, x_name).Within(site.program), rest: Nat, lt: Succ(rest) < Nat::pow(2, 64),
    state: List<BitVec(64)>, to: Nat, post: MachineState<M> → Type,
    body: site.Moves(stack.writes, prog_len(head.branch_label(registers.counter, x_name)), to,
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, registers, Succ(rest), state)(s.gprs, s.memory), post)):
    site.Moves(stack.writes, prog_len(head), to,
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, registers, Succ(rest), state)(s.gprs, s.memory), post) {
    let program = site.program;
    let counter = registers.counter;
    let tested = head.test_label(counter);
    let test_in = tested.within_before(0, Jcc(E, x_name), program, tested_in);
    let else_lands = j(x_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, x_name)), target),
        jcc_lands(asm_labels(program), tested_in.witness, program, tested, 0, E, x_name, program.laid_out_lands(laid), tested_in.proof));
    let pre = stack.LoopHead(d, s0, registers, Succ(rest), state);
    site.moves_test(stack.writes, program.laid_out_fits(laid), head, counter, x_name, test_in.witness, test_in.proof,
        tested_in.witness, tested_in.proof, x_at, else_lands, to, pre, post,
        site.moves_weaken(stack.writes, prog_len(head.branch_label(counter, x_name)), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory),
            post, λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = False, post,
            body, λ s held => held.left, λ t held => held),
        site.moves_absurd(stack.writes, x_at, to,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = True, post,
            λ s held => {
                let bad: (True = False) = trans(sym(held.right),
                    trans(counter.tests_zero_at(s.gprs, BitVec::ofNat(Succ(rest)), held.left.left.right), loop_counter_nonzero(rest, lt)));
                absurd(bad)
            }))
}

// X: the flag set, the state as it was.
theorem loop_marks<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), d: Nat,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(), before: Prog, x_name, k: Nat,
    at: asm_back(site.program, k) = At(At(before, x_name, Block([])), 0, Block([registers.mark()])), state: List<BitVec(64)>):
    site.Moves(stack.writes, prog_len(before), prog_len(before) + block_length([registers.mark()]),
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, registers, 0, state)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopDone(d, s0, registers, state, True)(t.gprs, t.memory)) {
    site.moves_block(stack.writes, site.program.laid_out_fits(laid), k, At(before, x_name, Block([])), 0, [registers.mark()], at,
        site.program.block_reads_at(laid, k, At(before, x_name, Block([])), 0, [registers.mark()], at),
        stack.LoopHead(d, s0, registers, 0, state), stack.LoopDone(d, s0, registers, state, True),
        λ s memory held => ⟨⟨args_after_write(state, registers.state, s.gprs, registers.flag, BitVec::ofNat(1), apart.right.left, held.left.left),
                sym(read_gpr_after_write(registers.flag, BitVec::ofNat(1), s.gprs))⟩,
            ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal([registers.mark()], s).gprs, held.right.left,
                execute_block_kept<M>([registers.mark()], s, callee_saved(), apart.right.right.right.left)), held.right.right⟩⟩)
}

// A pass's body, from the head's file at the pass's valuation.
theorem loop_body_runs<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), callees: Callees(), d: Nat, s0: MachineState<M>,
    start: Prog, entry: LoopEntry, count: Nat, parameters: List<Nat>,
    head_ok: (pass: Valuation()) → (g: Gprs) →
        ArgsIn(words_of(pass, Cons(count, parameters)), Cons(entry.registers.counter, entry.registers.state), g) →
        entry.head.Represents(pass, g),
    body: StructuredRegion, values: Valuation(), pass: Emitted,
    emits: EmitsIn<M>(site, stack, values, d, s0, start, entry.head, StructuredRegionHoldsIn(callees, values, body), pass),
    pass_in: pass.prog.Within(site.program), rest: Nat, counted: values(64, count) = BitVec::ofNat(Succ(rest)),
    passed: StructuredRegionHoldsIn(callees, values, body)):
    site.Moves(stack.writes, prog_len(start), prog_len(pass.prog),
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, entry.registers, Succ(rest), words_of(values, parameters))(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopPassed(d, s0, pass.file, values)(t.gprs, t.memory)) {
    site.moves_weaken(stack.writes, prog_len(start), prog_len(pass.prog),
        λ (s: MachineState<M>) => (entry.head.Represents(values, s.gprs) ∧ StructuredRegionHoldsIn(callees, values, body)) ∧
            stack.Framed(d, s0, s),
        λ (t: MachineState<M>) => pass.file.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t),
        λ (s: MachineState<M>) => stack.LoopHead(d, s0, entry.registers, Succ(rest), words_of(values, parameters))(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopPassed(d, s0, pass.file, values)(t.gprs, t.memory),
        emits.right(pass_in),
        λ s held => ⟨⟨head_ok(values, s.gprs, ⟨trans(held.left.right, sym(counted)), held.left.left⟩), passed⟩, held.right⟩,
        λ t held => held)
}

// The exit bit set: the state moved out, the flag cleared, JMP J.
theorem loop_leaves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), d: Nat,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(), pass: Prog, file: File, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat, out: LoopExit, out_ok: LoopExitOk<M>(file, registers, count, exit, next, outputs, exhausted, out),
    names: Nat, jumped_in: loop_jumped(pass, registers, out, names).Within(site.program),
    c_lands: asm_target(site.program, Succ(Succ(names))) = prog_len(loop_jumped(pass, registers, out, names)),
    j_at: Nat, j_lands: asm_target(site.program, Succ(Succ(Succ(Succ(names))))) = j_at,
    values: Valuation(), set: values(1, exit).head_bit() = True):
    site.Moves(stack.writes, prog_len(pass), j_at,
        λ (s: MachineState<M>) => stack.LoopPassed(d, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopDone(d, s0, registers, words_of(values, next), False)(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let lands = program.laid_out_lands(laid);
    let c_name = Succ(Succ(names));
    let j_name = Succ(Succ(Succ(Succ(names))));
    let left = pass.branch_label(out.register, c_name);
    let leave = At(left, 0, Block(out.leave));
    let cleared = At(leave, 0, Block([registers.clear()]));
    let jumped = loop_jumped(pass, registers, out, names);
    let cleared_in = cleared.within_before(0, Jmp(j_name), program, jumped_in);
    let leave_in = leave.within_before(0, Block([registers.clear()]), program, cleared_in);
    let left_in = left.within_before(0, Block(out.leave), program, leave_in);
    let tested = pass.test_label(out.register);
    let test_in = tested.within_before(0, Jcc(E, c_name), program, left_in);
    let else_lands = j(c_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, c_name)), target),
        jcc_lands(asm_labels(program), left_in.witness, program, tested, 0, E, c_name, lands, left_in.proof));
    let jump_lands = j(j_lands, λ target _ => NearLands(prog_len(cleared), asm_jump_of(asm_labels(program), prog_len(cleared), Jmp(j_name)),
            target),
        jmp_lands(asm_labels(program), jumped_in.witness, program, cleared, 0, j_name, lands, jumped_in.proof));
    let pre = stack.LoopPassed(d, s0, file, values);
    let moved = λ (g: Gprs) (m: M) => ArgsIn(words_of(values, next), registers.state, g) ∧
        (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
    let post = stack.LoopDone(d, s0, registers, words_of(values, next), False);
    site.moves_test(stack.writes, fits, pass, out.register, c_name, test_in.witness, test_in.proof, left_in.witness, left_in.proof,
        prog_len(jumped), else_lands, j_at, pre, λ (t: MachineState<M>) => post(t.gprs, t.memory),
        site.moves_trans(stack.writes, prog_len(left), prog_len(cleared), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
            λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_trans(stack.writes, prog_len(left), prog_len(leave), prog_len(cleared),
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
                λ (s: MachineState<M>) => moved(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_weaken(stack.writes, prog_len(left), prog_len(leave), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
                    λ (t: MachineState<M>) => moved(t.gprs, t.memory),
                    λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
                    λ (t: MachineState<M>) => moved(t.gprs, t.memory),
                    site.moves_block(stack.writes, fits, leave_in.witness, left, 0, out.leave, leave_in.proof,
                        program.block_reads_at(laid, leave_in.witness, left, 0, out.leave, leave_in.proof), pre, moved,
                        λ s memory held => {
                            let ran = out_ok.right.left(values, s, held.left);
                            ⟨ran.left, ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal(out.leave, s).gprs, held.right.left,
                                ran.right), held.right.right⟩⟩
                        }),
                    λ s held => held.left, λ t held => held),
                site.moves_block(stack.writes, fits, cleared_in.witness, leave, 0, [registers.clear()], cleared_in.proof,
                    program.block_reads_at(laid, cleared_in.witness, leave, 0, [registers.clear()], cleared_in.proof), moved, post,
                    λ s memory held => ⟨⟨args_after_write(words_of(values, next), registers.state, s.gprs, registers.flag, BitVec::ofNat(0),
                            apart.right.left, held.left),
                        sym(read_gpr_after_write(registers.flag, BitVec::ofNat(0), s.gprs))⟩,
                        ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal([registers.clear()], s).gprs, held.right.left,
                            execute_block_kept<M>([registers.clear()], s, callee_saved(), apart.right.right.left)), held.right.right⟩⟩)),
            site.moves_jump(stack.writes, fits, jumped_in.witness, cleared, 0, j_name, jumped_in.proof, j_at, jump_lands, post)),
        site.moves_absurd(stack.writes, prog_len(jumped), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            λ s held => {
                let bad: (True = False) = trans(sym(held.right), trans(out_ok.left(values, s.gprs, held.left.left),
                    cong_fn<Bool, Bool>(λ b => !b, set)));
                absurd(bad)
            }))
}

// The exit bit clear: the state and the count moved round, a pass counted
// off, JMP H.
theorem loop_rounds<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), d: Nat,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(), pass: Prog, file: File, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat, out: LoopExit, out_ok: LoopExitOk<M>(file, registers, count, exit, next, outputs, exhausted, out),
    names: Nat, again_in: loop_again(pass, registers, out, names).Within(site.program),
    c_lands: asm_target(site.program, Succ(Succ(names))) = prog_len(loop_jumped(pass, registers, out, names)),
    h_at: Nat, h_lands: asm_target(site.program, Succ(names)) = h_at,
    values: Valuation(), clear: values(1, exit).head_bit() = False, rest: Nat, lt: Succ(rest) < Nat::pow(2, 64),
    counted: values(64, count) = BitVec::ofNat(Succ(rest))):
    site.Moves(stack.writes, prog_len(pass), h_at,
        λ (s: MachineState<M>) => stack.LoopPassed(d, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopHead(d, s0, registers, rest, words_of(values, next))(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let lands = program.laid_out_lands(laid);
    let c_name = Succ(Succ(names));
    let h_name = Succ(names);
    let jumped = loop_jumped(pass, registers, out, names);
    let cont = At(jumped, c_name, Block([]));
    let back = At(cont, 0, Block(out.back));
    let stepped = At(back, 0, Block([registers.step()]));
    let stepped_in = stepped.within_before(0, Jmp(h_name), program, again_in);
    let back_in = back.within_before(0, Block([registers.step()]), program, stepped_in);
    let cont_in = cont.within_before(0, Block(out.back), program, back_in);
    let jumped_in = jumped.within_before(c_name, Block([]), program, cont_in);
    let left = pass.branch_label(out.register, c_name);
    let into_jumped: left.Within(jumped) = Exists(3, refl);
    let left_in = left.within_trans(jumped, program, into_jumped, jumped_in);
    let tested = pass.test_label(out.register);
    let test_in = tested.within_before(0, Jcc(E, c_name), program, left_in);
    let else_lands = j(c_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, c_name)), target),
        jcc_lands(asm_labels(program), left_in.witness, program, tested, 0, E, c_name, lands, left_in.proof));
    let jump_lands = j(h_lands, λ target _ => NearLands(prog_len(stepped), asm_jump_of(asm_labels(program), prog_len(stepped), Jmp(h_name)),
            target),
        jmp_lands(asm_labels(program), again_in.witness, program, stepped, 0, h_name, lands, again_in.proof));
    let pre = stack.LoopPassed(d, s0, file, values);
    let turned = stack.LoopHead(d, s0, registers, Succ(rest), words_of(values, next));
    let post = stack.LoopHead(d, s0, registers, rest, words_of(values, next));
    let c = BitVec::ofNat(255, n := 8).sign_extend(56);
    site.moves_test(stack.writes, fits, pass, out.register, c_name, test_in.witness, test_in.proof, left_in.witness, left_in.proof,
        prog_len(jumped), else_lands, h_at, pre, λ (t: MachineState<M>) => post(t.gprs, t.memory),
        site.moves_absurd(stack.writes, prog_len(left), h_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            λ s held => {
                let bad: (True = False) = trans(sym(cong_fn<Bool, Bool>(λ b => !b, clear)),
                    trans(sym(out_ok.left(values, s.gprs, held.left.left)), held.right));
                absurd(bad)
            }),
        site.moves_trans(stack.writes, prog_len(jumped), prog_len(stepped), h_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
            λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_trans(stack.writes, prog_len(jumped), prog_len(back), prog_len(stepped),
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
                λ (s: MachineState<M>) => turned(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_weaken(stack.writes, prog_len(cont), prog_len(back), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
                    λ (t: MachineState<M>) => turned(t.gprs, t.memory),
                    λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
                    λ (t: MachineState<M>) => turned(t.gprs, t.memory),
                    site.moves_block(stack.writes, fits, back_in.witness, cont, 0, out.back, back_in.proof,
                        program.block_reads_at(laid, back_in.witness, cont, 0, out.back, back_in.proof), pre, turned,
                        λ s memory held => {
                            let ran = out_ok.right.right.left(values, s, held.left);
                            ⟨⟨ran.left.right, trans(ran.left.left, counted)⟩,
                             ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal(out.back, s).gprs, held.right.left, ran.right),
                              held.right.right⟩⟩
                        }),
                    λ s held => held.left, λ t held => held),
                site.moves_block(stack.writes, fits, stepped_in.witness, back, 0, [registers.step()], stepped_in.proof,
                    program.block_reads_at(laid, stepped_in.witness, back, 0, [registers.step()], stepped_in.proof), turned, post,
                    λ s memory held => ⟨⟨args_after_write(words_of(values, next), registers.state, s.gprs, registers.counter,
                            read_gpr(registers.counter, s.gprs).add(c), apart.left, held.left.left),
                        trans(read_gpr_after_write(registers.counter, read_gpr(registers.counter, s.gprs).add(c), s.gprs),
                            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), held.left.right), loop_counter_step(rest)))⟩,
                        ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal([registers.step()], s).gprs, held.right.left,
                            execute_block_kept<M>([registers.step()], s, callee_saved(), apart.right.right.right.right)), held.right.right⟩⟩)),
            site.moves_jump(stack.writes, fits, again_in.witness, stepped, 0, h_name, again_in.proof, h_at, jump_lands, post)))
}

// The loop: the entry's moves, the passes by induction, and the file after.
theorem loop_emits<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, body: StructuredRegion, exit: Nat, next, outputs: List<Nat>,
    exhausted: Nat, names: Nat, entry: LoopEntry, entry_ok: LoopEntryOk<M>(values, file, inputs, limit, parameters, count, entry),
    pass: Emitted,
    pass_emits: (v: Valuation()) →
        EmitsIn<M>(site, stack, v, d, s0, loop_tested(prog, entry, names), entry.head, StructuredRegionHoldsIn(callees, v, body), pass),
    out: LoopExit, out_ok: LoopExitOk<M>(pass.file, entry.registers, count, exit, next, outputs, exhausted, out)):
    EmitsIn<M>(site, stack, values, d, s0, prog, file,
        StructuredRegionHoldsIn(callees, values, Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted)),
        Emitted(loop_done(pass.prog, entry.registers, out, names), out.out, pass.placement, pass.names)) {
    let registers = entry.registers;
    let apart = entry_ok.right.right;
    let entered = At(prog, 0, Block(entry.code));
    let head = loop_head(prog, entry, names);
    let tested = loop_tested(prog, entry, names);
    let jumped = loop_jumped(pass.prog, registers, out, names);
    let again = loop_again(pass.prog, registers, out, names);
    let set = loop_set(pass.prog, registers, out, names);
    let done = loop_done(pass.prog, registers, out, names);
    let x_name = Succ(Succ(Succ(names)));
    let grown: tested.Within(pass.prog) = pass_emits(values).left;
    let opened: prog.Within(tested) = Exists(4, refl);
    let closed: pass.prog.Within(done) = Exists(12, refl);
    let holds = StructuredRegionHoldsIn(callees, values, Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted));
    ⟨prog.within_trans(tested, done, opened, tested.within_trans(pass.prog, done, grown, closed)),
     λ within => {
        let program = site.program;
        let unique = program.laid_out_unique(laid);
        let pass_in = pass.prog.within_trans(done, program, closed, within);
        let tested_in = tested.within_trans(pass.prog, program, grown, pass_in);
        let head_back: head.Within(tested) = Exists(2, refl);
        let head_in = head.within_trans(tested, program, head_back, tested_in);
        let entered_back: entered.Within(tested) = Exists(3, refl);
        let entered_in = entered.within_trans(tested, program, entered_back, tested_in);
        let jumped_back: jumped.Within(done) = Exists(7, refl);
        let jumped_in = jumped.within_trans(done, program, jumped_back, within);
        let cont_back: At(jumped, Succ(Succ(names)), Block([])).Within(done) = Exists(6, refl);
        let cont_in = At(jumped, Succ(Succ(names)), Block([])).within_trans(done, program, cont_back, within);
        let again_back: again.Within(done) = Exists(3, refl);
        let again_in = again.within_trans(done, program, again_back, within);
        let x_back: At(again, x_name, Block([])).Within(done) = Exists(2, refl);
        let x_in = At(again, x_name, Block([])).within_trans(done, program, x_back, within);
        let set_in = set.within_before(Succ(x_name), Block([]), program, within);
        let h_lands = label_target(head_in.witness, program, entered, names, Block([]), unique, head_in.proof);
        let c_lands = label_target(cont_in.witness, program, jumped, Succ(names), Block([]), unique, cont_in.proof);
        let x_lands = label_target(x_in.witness, program, again, Succ(Succ(names)), Block([]), unique, x_in.proof);
        let j_lands = label_target(within.witness, program, set, x_name, Block([]), unique, within.proof);
        let Head = λ (r: Nat) (state: List<BitVec(64)>) (s: MachineState<M>) =>
            stack.LoopHead(d, s0, registers, r, state)(s.gprs, s.memory);
        let Done = λ (final: List<BitVec(64)>) (e: Bool) (s: MachineState<M>) =>
            stack.LoopDone(d, s0, registers, final, e)(s.gprs, s.memory);
        let Passed = λ (v: Valuation()) (s: MachineState<M>) => stack.LoopPassed(d, s0, pass.file, v)(s.gprs, s.memory);
        let stop = λ (state: List<BitVec(64)>) => loop_stops<M>(site, laid, stack, d, s0, head, registers, x_name, prog_len(again),
            x_lands, tested_in, state, prog_len(done), Done(state, True),
            loop_marks<M>(site, laid, stack, d, s0, registers, apart, again, x_name, set_in.witness, set_in.proof, state));
        let enters = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (passed: StructuredRegionHoldsIn(callees, v, body)) =>
            loop_enters<M>(site, laid, stack, d, s0, head, registers, x_name, prog_len(again), x_lands, tested_in, rest, lt,
                words_of(v, parameters), prog_len(pass.prog), Passed(v),
                loop_body_runs<M>(site, stack, callees, d, s0, tested, entry, count, parameters, entry_ok.right.left, body, v, pass,
                    pass_emits(v), pass_in, rest, counted, passed));
        let leave = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (passed: StructuredRegionHoldsIn(callees, v, body)) (set_bit: v(1, exit).head_bit() = True) =>
            site.moves_trans(stack.writes, prog_len(head), prog_len(pass.prog), prog_len(done), Head(Succ(rest), words_of(v, parameters)),
                Passed(v), Done(words_of(v, next), False),
                enters(rest, lt, v, counted, passed),
                loop_leaves<M>(site, laid, stack, d, s0, registers, apart, pass.prog, pass.file, count, exit, next, outputs, exhausted, out,
                    out_ok, names, jumped_in, c_lands, prog_len(done), j_lands, v, set_bit));
        let rounds = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (passed: StructuredRegionHoldsIn(callees, v, body)) (clear: v(1, exit).head_bit() = False) =>
            site.moves_trans(stack.writes, prog_len(head), prog_len(pass.prog), prog_len(head), Head(Succ(rest), words_of(v, parameters)),
                Passed(v), Head(rest, words_of(v, next)),
                enters(rest, lt, v, counted, passed),
                loop_rounds<M>(site, laid, stack, d, s0, registers, apart, pass.prog, pass.file, count, exit, next, outputs, exhausted, out,
                    out_ok, names, again_in, c_lands, prog_len(head), h_lands, v, clear, rest, lt, counted));
        let n = values(64, limit).toNat();
        let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ holds) ∧
            (Kept(callee_saved(), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
        let entering = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, entry.code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, entry.code, entered_in.proof),
            pre, stack.LoopHead(d, s0, registers, n, words_of(values, inputs)),
            λ s memory held => {
                let ran = entry_ok.left(s, held.left.left);
                ⟨⟨ran.left.right, trans(ran.left.left, sym(BitVec::ofNat_toNat(64, values(64, limit))))⟩,
                 ⟨kept_trans(callee_saved(), s0.gprs, s.gprs, execute_block_normal(entry.code, s).gprs, held.right.left, ran.right),
                  held.right.right⟩⟩
            });
        let after = λ (t: MachineState<M>) => out.out.Represents(values, t.gprs) ∧ stack.Framed(d, s0, t);
        λ s here resident held => site.moves_trans(stack.writes, prog_len(prog), prog_len(head), prog_len(done),
            λ (x: MachineState<M>) => pre(x.gprs, x.memory), Head(n, words_of(values, inputs)), after,
            entering,
            site.moves_weaken(stack.writes, prog_len(head), prog_len(done), Head(n, words_of(values, inputs)),
                Done(words_of(values, outputs), values(1, exhausted).head_bit()), Head(n, words_of(values, inputs)), after,
                site.loop_passes(stack.writes, prog_len(head), prog_len(done), Head, Done,
                    λ (v: Valuation()) => StructuredRegionHoldsIn(callees, v, body), parameters, count, exit, next, stop, leave, rounds,
                    n, BitVec::toNat_lt_pow(64, values(64, limit)), words_of(values, inputs), words_of(values, outputs),
                    values(1, exhausted).head_bit(), held.left.right),
                λ x h => h,
                λ t ended => ⟨out_ok.right.right.right(values, t.gprs, ended.left.left,
                    j(sym(BitVec::one_bit_eq_ofBool(values(1, exhausted))), λ x _ => x.zero_extend(63) = read_gpr(registers.flag, t.gprs),
                        ended.left.right)), ended.right⟩))(s, here, resident, held)
     }⟩
}

theorem loop_close_emits<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, body: StructuredRegion, exit: Nat, next, outputs: List<Nat>,
    exhausted: Nat, names: Nat, entry: LoopEntry, entry_ok: LoopEntryOk<M>(values, file, inputs, limit, parameters, count, entry),
    pass: Emitted,
    pass_emits: (v: Valuation()) →
        EmitsIn<M>(site, stack, v, d, s0, loop_tested(prog, entry, names), entry.head, StructuredRegionHoldsIn(callees, v, body), pass)):
    MayEmitIn<M>(site, stack, values, d, s0, prog, file,
        StructuredRegionHoldsIn(callees, values, Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted)),
        pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names)) {
    (match pass.file.loop_exit(entry.registers, count, exit, next, outputs, exhausted) as λ e =>
        MayLoopExit<M>(pass.file, entry.registers, count, exit, next, outputs, exhausted, e) →
        MayEmitIn<M>(site, stack, values, d, s0, prog, file,
            StructuredRegionHoldsIn(callees, values, Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted)),
            match e {
                None => None,
                Some(out) => Some(Emitted(loop_done(pass.prog, entry.registers, out, names), out.out, pass.placement, pass.names)),
            }) {
        None => λ _ => trivial,
        Some(out) => λ out_ok => loop_emits<M>(site, laid, stack, callees, values, d, s0, prog, file, inputs, limit, parameters, count,
            body, exit, next, outputs, exhausted, names, entry, entry_ok, pass, pass_emits, out, out_ok),
    })(loop_exit_sound<M>(pass.file, entry.registers, count, exit, next, outputs, exhausted))
}

// Round 2's theorem over machine runs: whatever `emit_calls` emits keeps
// the frame and computes the region, its calls answered by the functions
// below `bound`.
theorem StructuredRegion::emit_calls_emits<M>(self region: StructuredRegion, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), callees: Callees(), bound: Nat, calls: site.Calls(stack, callees, bound),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 72 * bound + 8 <= d,
    fits: d + 64 <= stack.size): (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    MayEmitIn<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, region),
        region.emit_calls(prog, file, placement, names, bound)) {
    match region {
        Dataflow(body) => λ prog file placement names => emit_kept_nodes_emits<M>(site, laid, stack, values, d, s0, prog, file, body.nodes, placement, names),
        Sequence(prefix, continuation) => λ prog file placement names =>
            (match emit_kept_nodes(prog, file, prefix.nodes, placement, names) as λ e =>
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, NodesHold(values, prefix.nodes), e) →
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, RegionHolds(prefix, values) ∧ StructuredRegionHoldsIn(callees, values, continuation), match e {
                    None => None,
                    Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_in_seq<M>(site, stack, values, d, s0, prog, file, NodesHold(values, prefix.nodes),
                    StructuredRegionHoldsIn(callees, values, continuation), first, first_emits,
                    continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                    continuation.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, first.prog, first.file, first.placement, first.names)),
            })(emit_kept_nodes_emits<M>(site, laid, stack, values, d, s0, prog, file, prefix.nodes, placement, names)),
        Compose(prefix, continuation) => λ prog file placement names =>
            (match prefix.emit_calls(prog, file, placement, names, bound) as λ e =>
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, prefix), e) →
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, prefix) ∧ StructuredRegionHoldsIn(callees, values, continuation), match e {
                    None => None,
                    Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_in_seq<M>(site, stack, values, d, s0, prog, file, StructuredRegionHoldsIn(callees, values, prefix),
                    StructuredRegionHoldsIn(callees, values, continuation), first, first_emits,
                    continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                    continuation.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, first.prog, first.file, first.placement, first.names)),
            })(prefix.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, prog, file, placement, names)),
        // The motive is written out: read off the goal it is past the
        // budget a stuck head is spelled within, the file's slots being a
        // reduction further down than a function's application was.
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ prog file placement names =>
            match file.branch_test(condition) as λ t =>
                MayEmitIn<M>(site, stack, values, d, s0, prog, file,
                    StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false)),
                    match t {
                        None => None,
                        Some(tested) => match when_true.emit_calls(prog.branched(tested.test, Succ(names)), file, placement, Succ(Succ(names)), bound) {
                            None => None,
                            Some(yes) => match when_false.emit_calls(yes.prog.else_label(Succ(names), Succ(Succ(names))), file, yes.placement, yes.names, bound) {
                                None => None,
                                Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) =>
                    (match when_true.emit_calls(prog.branched(tested.test, Succ(names)), file, placement, Succ(Succ(names)), bound) as λ y =>
                        MayEmitIn<M>(site, stack, values, d, s0, prog.branched(tested.test, Succ(names)), file, StructuredRegionHoldsIn(callees, values, when_true), y) →
                        MayEmitIn<M>(site, stack, values, d, s0, prog, file,
                            StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false)),
                            match y {
                                None => None,
                                Some(yes) => match when_false.emit_calls(yes.prog.else_label(Succ(names), Succ(Succ(names))), file, yes.placement, yes.names, bound) {
                                    None => None,
                                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(yes) => λ yes_emits =>
                            (match when_false.emit_calls(yes.prog.else_label(Succ(names), Succ(Succ(names))), file, yes.placement, yes.names, bound) as λ n =>
                                MayEmitIn<M>(site, stack, values, d, s0, yes.prog.else_label(Succ(names), Succ(Succ(names))), file,
                                    StructuredRegionHoldsIn(callees, values, when_false), n) →
                                MayEmitIn<M>(site, stack, values, d, s0, prog, file,
                                    StructuredRegionHoldsIn(callees, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false)),
                                    match n {
                                        None => None,
                                        Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(no) => λ no_emits => branch_emits_in<M>(site, laid, stack, callees, values, d, s0, prog, file, inputs, condition, arguments, outputs,
                                    when_true, when_false, tested, names, yes, no, yes_emits, no_emits),
                            })(when_false.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, yes.prog.else_label(Succ(names), Succ(Succ(names))), file,
                                yes.placement, yes.names)),
                    })(when_true.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, prog.branched(tested.test, Succ(names)), file, placement,
                        Succ(Succ(names)))),
            },
        Call(callee, arguments, result) => λ prog file placement names =>
            file.emit_call_emits<M>(site, laid, stack, callees, bound, calls, values, d, s0, rsp0, room, fits, prog, callee, arguments,
                result, placement, names),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) => λ prog file placement names => {
            let holds = StructuredRegionHoldsIn(callees, values, Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted));
            (match file.loop_entry(inputs, limit, parameters, count, placement) as λ e =>
                MayLoopEntry<M>(values, file, inputs, limit, parameters, count, e) →
                MayEmitIn<M>(site, stack, values, d, s0, prog, file, holds, match e {
                    None => None,
                    Some(entry) => match body.emit_calls(loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                        Succ(Succ(Succ(Succ(names)))), bound) {
                        None => None,
                        Some(pass) => pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names),
                    },
                }) {
                None => λ _ => trivial,
                Some(entry) => λ entry_ok =>
                    (match body.emit_calls(loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))),
                        bound) as λ b =>
                        ((v: Valuation()) → MayEmitIn<M>(site, stack, v, d, s0, loop_tested(prog, entry, names), entry.head,
                            StructuredRegionHoldsIn(callees, v, body), b)) →
                        MayEmitIn<M>(site, stack, values, d, s0, prog, file, holds, match b {
                            None => None,
                            Some(pass) => pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names),
                        }) {
                        None => λ _ => trivial,
                        Some(pass) => λ pass_emits => loop_close_emits<M>(site, laid, stack, callees, values, d, s0, prog, file, inputs, limit,
                            parameters, count, body, exit, next, outputs, exhausted, names, entry, entry_ok, pass, pass_emits),
                    })(λ v => body.emit_calls_emits<M>(site, laid, stack, callees, bound, calls, v, d, s0, rsp0, room, fits,
                        loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))))),
            })(loop_entry_sound<M>(values, file, inputs, limit, parameters, count, placement))
        },
    }
}

// ---------------------------------------------------------------------------
// Functions

// A frame of eight slots, allocated and freed by ADD RSP, imm8.
fn frame_allocate() → Instruction { AddRI8(Rsp, BitVec::ofNat(256 - 64)) }
fn frame_free() → Instruction { AddRI8(Rsp, BitVec::ofNat(64)) }

theorem frame_allocated(low: BitVec(64), i: Nat):
    next_rip(low, i + 64).add(BitVec::ofNat(256 - 64, n := 8).sign_extend(56)) = next_rip(low, i) {
    let reading: (BitVec::ofNat(256 - 64, n := 8).sign_extend(56).toNat() = Nat::pow(2, 64) - 64) = refl;
    let count: ((i + 64) + (Nat::pow(2, 64) - 64) = i + Nat::pow(2, 64)) = { omega };
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(low, i + 64), BitVec::ofNat(256 - 64, n := 8).sign_extend(56))),
    trans(rip_count(next_rip(low, i + 64), reading),
    trans(rip_compose(low, i + 64, Nat::pow(2, 64) - 64),
    trans(rip_count(low, count),
    trans(sym(rip_compose(low, i, Nat::pow(2, 64))), BitVec::iterate_increment_period(64, next_rip(low, i)))))))
}

theorem frame_freed(low: BitVec(64), i: Nat):
    next_rip(low, i).add(BitVec::ofNat(64, n := 8).sign_extend(56)) = next_rip(low, i + 64) {
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(low, i), BitVec::ofNat(64, n := 8).sign_extend(56))), rip_compose(low, i, 64))
}

theorem kept_refl(registers: List<Gpr>, gprs: Gprs): Kept(registers, gprs, gprs) {
    match registers { Nil => trivial, Cons(_, rest) => ⟨refl, kept_refl(rest, gprs)⟩ }
}

// Where a function's body starts: the frame allocated below the return
// address at `d + 64`, everything else as it was entered.
fn Stack::opened<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>) → MachineState<M> {
    MachineState(write_gpr(Rsp, stack.at(d), s0.gprs), s0.flags, s0.rip, s0.memory)
}

// The prologue.
theorem prologue_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    prog: Prog, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block([frame_allocate()])),
    s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 64)):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = stack.opened(d, s0).gprs) ∧ (x.memory = s0.memory)) {
    let c = BitVec::ofNat(256 - 64, n := 8).sign_extend(56);
    let opened: (write_gpr(Rsp, read_gpr(Rsp, s0.gprs).add(c), s0.gprs) = write_gpr(Rsp, stack.at(d), s0.gprs)) =
        cong_fn<BitVec(64), Gprs>(λ a => write_gpr(Rsp, a, s0.gprs),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), rsp), frame_allocated(stack.low, d)));
    let pre = λ (g: Gprs) (m: M) => (g = s0.gprs) ∧ (m = s0.memory);
    let post = λ (g: Gprs) (m: M) => (g = write_gpr(Rsp, stack.at(d), s0.gprs)) ∧ (m = s0.memory);
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, [frame_allocate()], at,
            site.program.block_reads_at(laid, k, prog, 0, [frame_allocate()], at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let ran: (execute_block_normal([frame_allocate()], x).gprs = write_gpr(Rsp, stack.at(d), s0.gprs)) =
                    j(sym(held.left), λ g _ => write_gpr(Rsp, read_gpr(Rsp, g).add(c), g) = write_gpr(Rsp, stack.at(d), s0.gprs), opened);
                ⟨ran, held.right⟩
            }))
}

// The result moved into RAX.
theorem result_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s1: MachineState<M>, prog: Prog, file: File, result: Nat, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), placed: moves.file.outputs_check([Port(id := result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(), k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block(moves.code))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code),
        λ (s: MachineState<M>) => file.Represents(values, s.gprs) ∧ stack.Framed(d, s1, s),
        λ (t: MachineState<M>) => (read_gpr(Rax, t.gprs) = values(64, result)) ∧ stack.Framed(d, s1, t)) {
    let pre = λ (g: Gprs) (m: M) => file.Represents(values, g) ∧
        (Kept(callee_saved(), s1.gprs, g) ∧ stack.Wrote(d + 64, s1.memory, m));
    let post = λ (g: Gprs) (m: M) => (read_gpr(Rax, g) = values(64, result)) ∧
        (Kept(callee_saved(), s1.gprs, g) ∧ stack.Wrote(d + 64, s1.memory, m));
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, moves.code, at,
            site.program.block_reads_at(laid, k, prog, 0, moves.code, at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let y = execute_block_normal(moves.code, x);
                ⟨sym(outputs_check_sound(values, moves.file, y.gprs, keeps(x, held.left, trivial),
                    [Port(id := result, width := 64)], [Rax], placed).left),
                 ⟨kept_trans(callee_saved(), s1.gprs, x.gprs, y.gprs, held.right.left,
                    execute_block_kept<M>(moves.code, x, callee_saved(), leaves)), held.right.right⟩⟩
            }))
}

// The epilogue: the frame freed, the stack pointer back at the return
// address.
theorem epilogue_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    d: Nat, s1: MachineState<M>, rsp1: read_gpr(Rsp, s1.gprs) = stack.at(d), answer: BitVec(64),
    prog: Prog, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block([frame_free()]))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_free()]),
        λ (s: MachineState<M>) => (read_gpr(Rax, s.gprs) = answer) ∧ stack.Framed(d, s1, s),
        λ (t: MachineState<M>) => (read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), s1.gprs, t.gprs) ∧
            ((read_gpr(Rsp, t.gprs) = stack.at(d + 64)) ∧ stack.Wrote(d + 64, s1.memory, t.memory)))) {
    let c = BitVec::ofNat(64, n := 8).sign_extend(56);
    let pre = λ (g: Gprs) (m: M) => (read_gpr(Rax, g) = answer) ∧
        (Kept(callee_saved(), s1.gprs, g) ∧ stack.Wrote(d + 64, s1.memory, m));
    let post = λ (g: Gprs) (m: M) => (read_gpr(Rax, g) = answer) ∧ (Kept(callee_kept(), s1.gprs, g) ∧
        ((read_gpr(Rsp, g) = stack.at(d + 64)) ∧ stack.Wrote(d + 64, s1.memory, m)));
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_free()]), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, [frame_free()], at,
            site.program.block_reads_at(laid, k, prog, 0, [frame_free()], at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let rsp_x: (read_gpr(Rsp, x.gprs) = stack.at(d)) = trans(held.right.left.right.right.left, rsp1);
                let freed: (read_gpr(Rsp, x.gprs).add(c) = stack.at(d + 64)) =
                    trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), rsp_x), frame_freed(stack.low, d));
                ⟨held.left, ⟨kept_trans(callee_kept(), s1.gprs, x.gprs, execute_block_normal([frame_free()], x).gprs,
                    saved_kept(s1.gprs, x.gprs, held.right.left), execute_block_kept<M>([frame_free()], x, callee_kept(), trivial)),
                  ⟨freed, held.right.right⟩⟩⟩
            }))
}

// The prologue, the body from where it starts.
theorem function_enters<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), values: Valuation(), function: Function, prog: Prog, k: Nat,
    at: asm_back(site.program, k) = At(prog, 0, Block([frame_allocate()])), file: File,
    entered: (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) → file.Represents(values, g),
    s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 64),
    args: ArgsIn(words_of(values, function.parameters), argument_registers(), s0.gprs),
    holds: StructuredRegionHoldsIn(callees, values, function.body)):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ StructuredRegionHoldsIn(callees, values, function.body)) ∧
            stack.Framed(d, stack.opened(d, s0), x)) {
    let s1 = stack.opened(d, s0);
    let ready: file.Represents(values, s1.gprs) = entered(s1.gprs, args_ports(values, function.parameters, argument_registers(), s1.gprs,
        args_after_write(words_of(values, function.parameters), argument_registers(), s0.gprs, Rsp, stack.at(d), trivial, args)));
    site.moves_weaken(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = s1.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ StructuredRegionHoldsIn(callees, values, function.body)) ∧
            stack.Framed(d, s1, x),
        prologue_moves<M>(site, laid, stack, prog, k, at, s0, d, rsp),
        λ x held => held,
        λ x held => ⟨⟨j(sym(held.left), λ g _ => file.Represents(values, g), ready), holds⟩,
            ⟨j(sym(held.left), λ g _ => Kept(callee_saved(), s1.gprs, g), kept_refl(callee_saved(), s1.gprs)),
             j(sym(held.right), λ m _ => stack.Wrote(d + 64, s1.memory, m), stack.wrote_refl(d + 64, s1.memory))⟩⟩)
}

// A function's code after the label at `prog`: the frame, the body, the
// result into RAX, the frame freed, RET.
fn function_opened(prog: Prog, k: Nat) → Prog { At(At(prog, Succ(k), Block([])), 0, Block([frame_allocate()])) }
fn function_closed(body: Prog, moves: List<Instruction>) → Prog {
    At(At(body, 0, Block(moves)), 0, Block([frame_free()]))
}

// What the function's code does up to its RET, its parameters bound by
// `values`.
fn Stack::Closed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s1: MachineState<M>, answer: BitVec(64), t: MachineState<M>) → Type {
    (read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), s1.gprs, t.gprs) ∧
        ((read_gpr(Rsp, t.gprs) = stack.at(d + 64)) ∧ stack.Wrote(d + 64, s1.memory, t.memory)))
}

theorem function_runs<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), k: Nat, calls: site.Calls(stack, callees, k), function: Function, prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    emitted: function.body.emit_calls(function_opened(prog, k), file, placement, names, k) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) →
        file.Represents(values, g),
    within: function_closed(body.prog, moves.code).Within(site.program),
    values: Valuation(), s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 64),
    room: 72 * k + 8 <= d, fits: d + 64 <= stack.size,
    args: ArgsIn(words_of(values, function.parameters), argument_registers(), s0.gprs),
    holds: StructuredRegionHoldsIn(callees, values, function.body)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code)),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (t: MachineState<M>) => stack.Closed(d, stack.opened(d, s0), values(64, function.result), t)) {
    let s1 = stack.opened(d, s0);
    let opened = function_opened(prog, k);
    let returned = At(body.prog, 0, Block(moves.code));
    let closed = function_closed(body.prog, moves.code);
    let answer = values(64, function.result);
    let returned_in = returned.within_before(0, Block([frame_free()]), site.program, within);
    let body_in = body.prog.within_before(0, Block(moves.code), site.program, returned_in);
    let rsp1: (read_gpr(Rsp, s1.gprs) = stack.at(d)) = read_gpr_after_write(Rsp, stack.at(d), s0.gprs);
    let body_emits = function.body.emit_calls(opened, file, placement, names, k).all_some(
        λ (e: Emitted) => EmitsIn<M>(site, stack, values, d, s1, opened, file, StructuredRegionHoldsIn(callees, values, function.body), e),
        body, emitted,
        function.body.emit_calls_emits<M>(site, laid, stack, callees, k, calls, values, d, s1, rsp1, room, fits, opened, file,
            placement, names));
    let opened_in = opened.within_trans(body.prog, site.program, body_emits.left, body_in);
    let entry_in = At(prog, Succ(k), Block([])).within_before(0, Block([frame_allocate()]), site.program, opened_in);
    site.moves_trans(stack.writes, prog_len(prog), prog_len(opened), prog_len(closed),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ StructuredRegionHoldsIn(callees, values, function.body)) ∧
            stack.Framed(d, s1, x),
        λ (t: MachineState<M>) => stack.Closed(d, s1, answer, t),
        function_enters<M>(site, laid, stack, callees, values, function, At(prog, Succ(k), Block([])), opened_in.witness,
            opened_in.proof, file, entered(values), s0, d, rsp, args, holds),
        site.moves_trans(stack.writes, prog_len(opened), prog_len(body.prog), prog_len(closed),
            λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ StructuredRegionHoldsIn(callees, values, function.body)) ∧
                stack.Framed(d, s1, x),
            λ (t: MachineState<M>) => body.file.Represents(values, t.gprs) ∧ stack.Framed(d, s1, t),
            λ (t: MachineState<M>) => stack.Closed(d, s1, answer, t),
            body_emits.right(body_in),
            site.moves_trans(stack.writes, prog_len(body.prog), prog_len(returned), prog_len(closed),
                λ (s: MachineState<M>) => body.file.Represents(values, s.gprs) ∧ stack.Framed(d, s1, s),
                λ (t: MachineState<M>) => (read_gpr(Rax, t.gprs) = answer) ∧ stack.Framed(d, s1, t),
                λ (t: MachineState<M>) => stack.Closed(d, s1, answer, t),
                result_moves<M>(site, laid, stack, values, d, s1, body.prog, body.file, function.result, moves, keeps(values), placed,
                    leaves, returned_in.witness, returned_in.proof),
                epilogue_moves<M>(site, laid, stack, d, s1, rsp1, answer, returned, within.witness, within.proof))))
}

// Writing the stack pointer keeps the rest.
theorem kept_past_rsp(gprs: Gprs, word: BitVec(64)): Kept(callee_kept(), gprs, write_gpr(Rsp, word, gprs)) {
    ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩
}

// The arithmetic of a frame below the return address at offset `i`.
theorem frame_room(k, i, size: Nat, deep: 72 * Succ(k) <= i, room: i + 8 <= size):
    ((i - 64) + 64 = i) ∧ ((72 * k + 8 <= i - 64) ∧ (((i - 64) + 64 <= size) ∧ ((((i - 64) + 64) + 8 <= size) ∧ ((i - 64) + 64 <= i + 8)))) {
    let back: ((i - 64) + 64 = i) = Nat::sub_add_cancel(64, i, { omega });
    ⟨back, ⟨{ omega }, ⟨{ omega }, ⟨{ omega }, { omega }⟩⟩⟩⟩
}

// The function's code from its label to its RET, entered as its contract
// says.
theorem function_body<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), k: Nat, calls: site.Calls(stack, callees, k), function: Function, prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    emitted: function.body.emit_calls(function_opened(prog, k), file, placement, names, k) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) →
        file.Represents(values, g),
    within: function_closed(body.prog, moves.code).Within(site.program),
    words: List<BitVec(64)>, result: BitVec(64), s0: MachineState<M>, i: Nat, ret: BitVec(64)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code)),
        λ (s: MachineState<M>) => (s = s0) ∧ ((read_gpr(Rsp, s0.gprs) = stack.at(i)) ∧ ((i + 8 <= stack.size) ∧
            ((ArgsIn(words, argument_registers(), s0.gprs) ∧ (function.Computes(callees, words, result) ∧ 72 * Succ(k) <= i)) ∧
             read_word(site.data, s0.memory, stack.at(i)) = Some(ret)))),
        λ (t: MachineState<M>) => (read_gpr(Rsp, t.gprs) = stack.at(i)) ∧ ((read_word(site.data, t.memory, stack.at(i)) = Some(ret)) ∧
            stack.CalleePost(result)(i, s0, return_near_after(ret, t)))) {
    λ s here resident held => {
        let computes = held.right.right.right.left.right.left;
        let values = computes.witness;
        let d = i - 64;
        let sizes = frame_room(k, i, stack.size, held.right.right.right.left.right.right, held.right.right.left);
        let back: (d + 64 = i) = sizes.left;
        let s1 = stack.opened(d, s0);
        let at_back: (stack.at(d + 64) = stack.at(i)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
        let ran = function_runs<M>(site, laid, stack, callees, k, calls, function, prog, file, placement, names, body, emitted,
            moves, keeps, placed, leaves, entered, within, values, s0, d,
            trans(held.right.left, sym(at_back)), sizes.right.left, sizes.right.right.left,
            j(sym(computes.proof.left), λ w _ => ArgsIn(w, argument_registers(), s0.gprs), held.right.right.right.left.left),
            computes.proof.right.left);
        let a = ran(s, here, resident, ⟨cong_fn<MachineState<M>, Gprs>(λ x => x.gprs, held.left),
            cong_fn<MachineState<M>, M>(λ x => x.memory, held.left)⟩);
        let t = a.witness;
        let done: stack.Closed(d, s1, values(64, function.result), t) = a.proof.right.right.right;
        let kept: Kept(callee_kept(), s0.gprs, t.gprs) =
            kept_trans(callee_kept(), s0.gprs, s1.gprs, t.gprs, kept_past_rsp(s0.gprs, stack.at(d)), done.right.left);
        let popped = read_gpr(Rsp, t.gprs).add(BitVec::ofNat(8));
        let unchanged_top: (read_word(site.data, t.memory, stack.at(d + 64)) = read_word(site.data, s0.memory, stack.at(d + 64))) =
            stack.wrote_unchanged(d + 64, sizes.right.right.left, s0.memory, t.memory, done.right.right.right)(
                d + 64, (d + 64).le_refl(), sizes.right.right.right.left);
        Exists(t, ⟨a.proof.left, ⟨a.proof.right.left, ⟨a.proof.right.right.left,
            ⟨trans(done.right.right.left, at_back),
             ⟨trans(j(back, λ n _ => read_word(site.data, t.memory, stack.at(n)) = read_word(site.data, s0.memory, stack.at(n)),
                    unchanged_top), held.right.right.right.right),
              ⟨trans(done.left, computes.proof.right.right),
               ⟨kept_trans(callee_kept(), s0.gprs, t.gprs, write_gpr(Rsp, popped, t.gprs), kept, kept_past_rsp(t.gprs, popped)),
                j(back, λ n _ => stack.Wrote(n, s0.memory, t.memory), done.right.right.right)⟩⟩⟩⟩⟩⟩⟩)
    }
}

// The function at the label at `prog` meets its contract: its parameters
// bound to the arguments, its body holding, it returns its result.
theorem function_returns<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    callees: Callees(), k: Nat, calls: site.Calls(stack, callees, k), function: Function, prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    emitted: function.body.emit_calls(function_opened(prog, k), file, placement, names, k) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) →
        file.Represents(values, g),
    within: At(function_closed(body.prog, moves.code), 0, Ret).Within(site.program),
    words: List<BitVec(64)>, result: BitVec(64)):
    site.Returns(stack, prog_len(prog),
        λ (i: Nat) (s: MachineState<M>) => ArgsIn(words, argument_registers(), s.gprs) ∧
            (function.Computes(callees, words, result) ∧ 72 * Succ(k) <= i),
        stack.CalleePost(result)) {
    let closed = function_closed(body.prog, moves.code);
    site.returns_by(stack, site.program.laid_out_fits(laid), prog_len(prog), within.witness, closed, 0, within.proof,
        λ (i: Nat) (s: MachineState<M>) => ArgsIn(words, argument_registers(), s.gprs) ∧
            (function.Computes(callees, words, result) ∧ 72 * Succ(k) <= i),
        stack.CalleePost(result),
        λ s0 i ret => function_body<M>(site, laid, stack, callees, k, calls, function, prog, file, placement, names, body, emitted,
            moves, keeps, placed, leaves, entered, closed.within_before(0, Ret, site.program, within), words, result, s0, i, ret))
}

// ---------------------------------------------------------------------------
// What emitting grows

fn Grows(prog: Prog, out: Option<Emitted>) → Type { out.All(λ (emitted: Emitted) => prog.Within(emitted.prog)) }

theorem grows_trans(prog: Prog, first: Emitted, within: prog.Within(first.prog), second: Option<Emitted>):
    Grows(first.prog, second) → Grows(prog, second) {
    match second {
        None => λ _ => trivial,
        Some(out) => λ grown => prog.within_trans(first.prog, out.prog, within, grown),
    }
}

theorem emit_kept_nodes_grows(prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    Grows(prog, emit_kept_nodes(prog, file, nodes, placement, names)) {
    match lower_nodes(nodes, placement, file) {
        None => trivial,
        Some(lowered) => match leaves_all(lowered.code, callee_saved()) {
            False => trivial,
            True => prog.within_then(0, Block(lowered.code)),
        },
    }
}

theorem File::emit_call_grows(self file: File, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>,
    names, bound: Nat): Grows(prog, file.emit_call(prog, callee, arguments, result, placement, names, bound)) {
    let ports = word_ports(arguments);
    let order = file.call_moves(arguments);
    let out_file = file.write(Rax, Some(Held(result, Word)));
    match Succ(callee).leb(bound) {
        False => trivial,
        True => match file.move_outputs(ArgumentMove::ports(order), ArgumentMove::registers(order)) {
            None => trivial,
            Some(moves) => match moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                False => trivial,
                True => call_within(prog, moves.code, callee),
            },
        },
    }
}

theorem loop_close_grows(prog: Prog, entry: LoopEntry, names: Nat, pass: Emitted, grown: loop_tested(prog, entry, names).Within(pass.prog),
    count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    Grows(prog, pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names)) {
    let tested = loop_tested(prog, entry, names);
    let opened: prog.Within(tested) = Exists(4, refl);
    match pass.file.loop_exit(entry.registers, count, exit, next, outputs, exhausted) {
        None => trivial,
        Some(out) => {
            let closed: pass.prog.Within(loop_done(pass.prog, entry.registers, out, names)) = Exists(12, refl);
            prog.within_trans(tested, loop_done(pass.prog, entry.registers, out, names), opened,
                tested.within_trans(pass.prog, loop_done(pass.prog, entry.registers, out, names), grown, closed))
        },
    }
}

theorem StructuredRegion::emit_calls_grows(self region: StructuredRegion, bound: Nat):
    (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) → Grows(prog, region.emit_calls(prog, file, placement, names, bound)) {
    match region {
        Dataflow(body) => λ prog file placement names => emit_kept_nodes_grows(prog, file, body.nodes, placement, names),
        Sequence(prefix, continuation) => λ prog file placement names =>
            (match emit_kept_nodes(prog, file, prefix.nodes, placement, names) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
            }) {
                None => λ _ => trivial,
                Some(first) => λ grown => grows_trans(prog, first, grown,
                    continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                    continuation.emit_calls_grows(bound, first.prog, first.file, first.placement, first.names)),
            })(emit_kept_nodes_grows(prog, file, prefix.nodes, placement, names)),
        Compose(prefix, continuation) => λ prog file placement names =>
            (match prefix.emit_calls(prog, file, placement, names, bound) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(first) => continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
            }) {
                None => λ _ => trivial,
                Some(first) => λ grown => grows_trans(prog, first, grown,
                    continuation.emit_calls(first.prog, first.file, first.placement, first.names, bound),
                    continuation.emit_calls_grows(bound, first.prog, first.file, first.placement, first.names)),
            })(prefix.emit_calls_grows(bound, prog, file, placement, names)),
        Conditional(_, condition, _, _, when_true, when_false) => λ prog file placement names =>
            match file.branch_test(condition) {
                None => trivial,
                Some(tested) => {
                    let test = tested.test;
                    let branched = prog.branched(test, Succ(names));
                    (match when_true.emit_calls(branched, file, placement, Succ(Succ(names)), bound) as λ y =>
                        Grows(branched, y) → Grows(prog, match y {
                            None => None,
                            Some(yes) => match when_false.emit_calls(yes.prog.else_label(Succ(names), Succ(Succ(names))), file, yes.placement, yes.names, bound) {
                                None => None,
                                Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                            },
                        }) {
                        None => λ _ => trivial,
                        Some(yes) => λ yes_grown => {
                            let second = yes.prog.else_label(Succ(names), Succ(Succ(names)));
                            (match when_false.emit_calls(second, file, yes.placement, yes.names, bound) as λ n =>
                                Grows(second, n) → Grows(prog, match n {
                                    None => None,
                                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                }) {
                                None => λ _ => trivial,
                                Some(no) => λ no_grown => {
                                    let to_branch = prog.within_step(prog.tested(test), 0, Jcc(test.cc(), Succ(names)),
                                        prog.within_then(0, Block([test.instruction()])));
                                    let to_second = prog.within_step(At(yes.prog, 0, Jmp(Succ(Succ(names)))), Succ(names), Block([]),
                                        prog.within_step(yes.prog, 0, Jmp(Succ(Succ(names))), prog.within_trans(branched, yes.prog, to_branch, yes_grown)));
                                    prog.within_step(no.prog, Succ(Succ(names)), Block([]), prog.within_trans(second, no.prog, to_second, no_grown))
                                },
                            })(when_false.emit_calls_grows(bound, second, file, yes.placement, yes.names))
                        },
                    })(when_true.emit_calls_grows(bound, branched, file, placement, Succ(Succ(names))))
                },
            },
        Call(callee, arguments, result) => λ prog file placement names =>
            file.emit_call_grows(prog, callee, arguments, result, placement, names, bound),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) => λ prog file placement names =>
            match file.loop_entry(inputs, limit, parameters, count, placement) {
                None => trivial,
                Some(entry) =>
                    (match body.emit_calls(loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))),
                        bound) as λ b => Grows(loop_tested(prog, entry, names), b) → Grows(prog, match b {
                        None => None,
                        Some(pass) => pass.loop_close(entry.registers, count, exit, next, outputs, exhausted, names),
                    }) {
                        None => λ _ => trivial,
                        Some(pass) => λ grown => loop_close_grows(prog, entry, names, pass, grown, count, exit, next, outputs, exhausted),
                    })(body.emit_calls_grows(bound, loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                        Succ(Succ(Succ(Succ(names)))))),
            },
    }
}

// ---------------------------------------------------------------------------
// Functions

// The function's code once its body is emitted: the result into RAX,
// refused where the moves lose it or touch a callee-saved register.
fn Function::closing(self function: Function, body: Emitted) → Option<Emitted> {
    match body.file.move_outputs([Port(id := function.result, width := 64)], [Rax]) {
        None => None,
        Some(moves) => match moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]) &&
            leaves_all(moves.code, callee_saved()) {
            False => None,
            True => Some(Emitted(At(function_closed(body.prog, moves.code), 0, Ret), File::empty(), body.placement, body.names)),
        },
    }
}

fn Function::emit_body(self function: Function, prog: Prog, k: Nat, file: File, placement: List<Place>, names: Nat) → Option<Emitted> {
    match function.body.emit_calls(function_opened(prog, k), file, placement, names, k) {
        None => None,
        Some(body) => function.closing(body),
    }
}

// Function `k`'s code after `prog`: its label, its frame, its body calling
// the functions below `k`, its result into RAX, RET.
fn Function::emit(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    match input_file(word_ports(function.parameters), argument_registers()) {
        None => None,
        Some(file) => function.emit_body(prog, k, file, placement, names),
    }
}

// What emitting a function proves: the code holds its label, and resident
// with the functions below `k` meeting their contracts, it meets its own.
fn MayReturn<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), callees: Callees(), k: Nat, function: Function, prog: Prog,
    out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => At(prog, Succ(k), Block([])).Within(emitted.prog) ∧
        (emitted.prog.Within(site.program) → site.Calls(stack, callees, k) →
            (words: List<BitVec(64)>) → (result: BitVec(64)) → site.Returns(stack, prog_len(prog),
                λ (i: Nat) (s: MachineState<M>) => ArgsIn(words, argument_registers(), s.gprs) ∧
                    (function.Computes(callees, words, result) ∧ 72 * Succ(k) <= i),
                stack.CalleePost(result))))
}

theorem closed_within(body: Prog, moves: List<Instruction>): body.Within(At(function_closed(body, moves), 0, Ret)) {
    body.within_step(function_closed(body, moves), 0, Ret,
        body.within_step(At(body, 0, Block(moves)), 0, Block([frame_free()]), body.within_then(0, Block(moves))))
}

theorem Function::closing_returns<M>(self function: Function, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), callees: Callees(), k: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat,
    body: Emitted, emitted: function.body.emit_calls(function_opened(prog, k), file, placement, names, k) = Some(body),
    grown: At(prog, Succ(k), Block([])).Within(body.prog),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) →
        file.Represents(values, g)):
    MayReturn<M>(site, stack, callees, k, function, prog, function.closing(body)) {
    let outs: List<Port> = [Port(id := function.result, width := 64)];
    (match body.file.move_outputs(outs, [Rax]) as λ moved => ((values: Valuation()) → MayKeep<M>(values, body.file, True, moved)) →
        MayReturn<M>(site, stack, callees, k, function, prog, match moved {
            None => None,
            Some(moves) => match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, callee_saved()) {
                False => None,
                True => Some(Emitted(At(function_closed(body.prog, moves.code), 0, Ret), File::empty(), body.placement, body.names)),
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps =>
            (match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, callee_saved()) as λ c =>
                (c.IsTrue() → moves.file.outputs_check(outs, [Rax]).IsTrue() ∧ leaves_all(moves.code, callee_saved()).IsTrue()) →
                MayReturn<M>(site, stack, callees, k, function, prog, match c {
                    False => None,
                    True => Some(Emitted(At(function_closed(body.prog, moves.code), 0, Ret), File::empty(), body.placement, body.names)),
                }) {
                False => λ _ => trivial,
                True => λ parts => {
                    let checked = parts(trivial);
                    ⟨At(prog, Succ(k), Block([])).within_trans(body.prog, At(function_closed(body.prog, moves.code), 0, Ret), grown,
                        closed_within(body.prog, moves.code)),
                     λ within calls words result => function_returns<M>(site, laid, stack, callees, k, calls, function, prog, file,
                        placement, names, body, emitted, moves, keeps, checked.left, checked.right, entered, within, words, result)⟩
                },
            })(λ ok => Bool::is_true_and(moves.file.outputs_check(outs, [Rax]), leaves_all(moves.code, callee_saved()), ok)),
    })(λ values => move_outputs_keeps<M>(values, outs, body.file, [Rax]))
}

theorem label_opened(prog: Prog, k: Nat): At(prog, Succ(k), Block([])).Within(function_opened(prog, k)) {
    At(prog, Succ(k), Block([])).within_then(0, Block([frame_allocate()]))
}

theorem Function::emit_body_returns<M>(self function: Function, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), callees: Callees(), k: Nat, prog: Prog, file: File, placement: List<Place>, names: Nat,
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), argument_registers(), g) →
        file.Represents(values, g)):
    MayReturn<M>(site, stack, callees, k, function, prog, function.emit_body(prog, k, file, placement, names)) {
    let opened = function_opened(prog, k);
    let label = At(prog, Succ(k), Block([]));
    (match function.body.emit_calls(opened, file, placement, names, k) as λ e =>
        (function.body.emit_calls(opened, file, placement, names, k) = e) → Grows(opened, e) →
        MayReturn<M>(site, stack, callees, k, function, prog, match e { None => None, Some(body) => function.closing(body) }) {
        None => λ _ _ => trivial,
        Some(body) => λ emitted grown => function.closing_returns(site, laid, stack, callees, k, prog, file, placement, names,
            body, emitted, label.within_trans(opened, body.prog, label_opened(prog, k), grown), entered),
    })(refl, function.body.emit_calls_grows(k, opened, file, placement, names))
}

// The theorem for one function, proved once: whatever the placement, code
// `emit` returns meets the function's contract wherever it is resident,
// given its callees meet theirs.
theorem Function::emit_returns<M>(self function: Function, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), callees: Callees(), k: Nat, prog: Prog, placement: List<Place>, names: Nat):
    MayReturn<M>(site, stack, callees, k, function, prog, function.emit(prog, k, placement, names)) {
    let ins = word_ports(function.parameters);
    (match input_file(ins, argument_registers()) as λ entry =>
        ((values: Valuation()) → (g: Gprs) → PortsAt(values, ins, argument_registers(), g) →
            entry.All(λ (file: File) => file.Represents(values, g))) →
        MayReturn<M>(site, stack, callees, k, function, prog, match entry {
            None => None,
            Some(file) => function.emit_body(prog, k, file, placement, names),
        }) {
        None => λ _ => trivial,
        Some(file) => λ entered => function.emit_body_returns(site, laid, stack, callees, k, prog, file, placement, names, entered),
    })(λ values g placed => input_file_represents(values, g, ins, argument_registers(), placed))
}

// ---------------------------------------------------------------------------
// Programs

// The program's functions, first to last, after `Start`: each `emit` of
// function `k` calls only the ones before it in the code.
fn emit_functions(functions: List<Function>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match functions {
        Nil => Some(Emitted(Start, File::empty(), placement, names)),
        Cons(last, earlier) => match emit_functions(earlier, placement, names) {
            None => None,
            Some(before) => last.emit(before.prog, earlier.len(), before.placement, before.names),
        },
    }
}

// The program's code: function `f` at the label `Succ(f)`, the
// conditionals' labels after every function's. `None` is a refusal, as
// round 2's `lower`.
fn lower_program(functions: List<Function>, placement: List<Place>) → Option<Prog> {
    match emit_functions(functions, placement, functions.len()) {
        None => None,
        Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
    }
}

// ---------------------------------------------------------------------------
// The placement heuristic over programs (round 4). Untrusted like any
// placement: `lower_program_correct` holds whatever it returns.

// The registers a value may take: not RAX in a body that calls, where each
// call's result lands there.
fn call_pool() → List<Gpr> { [Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11] }

// A function's placement: its arguments where they arrive, its result
// wanted in RAX when no call follows that could take it, and what its whole
// body lets fold.
fn Function::plan(self function: Function) → List<Place> {
    let folds = function.body.folds([function.result]);
    match input_file(word_ports(function.parameters), argument_registers()) {
        None => [],
        Some(file) => match function.body.calls() {
            False => function.body.plan_from(file, [function.result], [Port(id := function.result, width := 64)], [Rax],
                scratch_pool(), folds, []).placement,
            True => function.body.plan_from(file, [function.result], [], [], call_pool(), folds, []).placement,
        },
    }
}

// A program's placement, in the order `emit_functions` takes it: the first
// function's first.
fn plan_program(functions: List<Function>) → List<Place> {
    match functions { Nil => [], Cons(last, earlier) => plan_program(earlier) ++ last.plan() }
}

// The program lowered with the heuristic's placement.
fn lower_program_planned(functions: List<Function>) → Option<Prog> { lower_program(functions, plan_program(functions)) }

// The last function answers the calls of it.
theorem program_callees_last(last: Function, earlier: List<Function>, arguments: List<BitVec(64)>, result: BitVec(64)):
    program_callees(Cons(last, earlier))(earlier.len(), arguments, result) → last.Computes(program_callees(earlier), arguments, result) {
    match earlier.len().eq_dec(earlier.len()) {
        Inl(_) => λ held => held,
        Inr(differs) => λ _ => false_elim(differs(refl)),
    }
}

// The earlier ones answer the rest.
theorem program_callees_earlier(last: Function, earlier: List<Function>, f: Nat, differs: f ≠ earlier.len(),
    arguments: List<BitVec(64)>, result: BitVec(64)):
    program_callees(Cons(last, earlier))(f, arguments, result) → program_callees(earlier)(f, arguments, result) {
    match f.eq_dec(earlier.len()) {
        Inl(same) => λ _ => false_elim(differs(same)),
        Inr(_) => λ held => held,
    }
}

theorem below_other(f, n: Nat, below: Succ(f) <= Succ(n), differs: f ≠ n): Succ(f) <= n { omega }

theorem nothing_below_zero(f: Nat, below: Succ(f) <= 0): False { omega }

// One more function meeting its contract at its label.
theorem Site::calls_extend<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), last: Function, earlier: List<Function>,
    entry: Nat, label: asm_labels(site.program)(Succ(earlier.len())) = entry,
    calls: site.Calls(stack, program_callees(earlier), earlier.len()),
    returns: (words: List<BitVec(64)>) → (result: BitVec(64)) → site.Returns(stack, entry,
        λ (i: Nat) (s: MachineState<M>) => ArgsIn(words, argument_registers(), s.gprs) ∧
            (last.Computes(program_callees(earlier), words, result) ∧ 72 * Succ(earlier.len()) <= i),
        stack.CalleePost(result))):
    site.Calls(stack, program_callees(Cons(last, earlier)), Succ(earlier.len())) {
    let callees = program_callees(Cons(last, earlier));
    let n = earlier.len();
    λ f below words result => match f.eq_dec(n) {
        Inl(same) => j(sym(same), λ m _ => site.Returns(stack, asm_labels(site.program)(Succ(m)), CalleePre<M>(callees, m, words, result),
                stack.CalleePost(result)),
            j(sym(label), λ e _ => site.Returns(stack, e, CalleePre<M>(callees, n, words, result), stack.CalleePost(result)),
                site.returns_weaken(stack, entry,
                    λ (i: Nat) (s: MachineState<M>) => ArgsIn(words, argument_registers(), s.gprs) ∧
                        (last.Computes(program_callees(earlier), words, result) ∧ 72 * Succ(n) <= i),
                    CalleePre<M>(callees, n, words, result), stack.CalleePost(result), returns(words, result),
                    λ i s held => ⟨held.left, ⟨program_callees_last(last, earlier, words, result, held.right.left), held.right.right⟩⟩))),
        Inr(differs) => site.returns_weaken(stack, asm_labels(site.program)(Succ(f)),
            CalleePre<M>(program_callees(earlier), f, words, result), CalleePre<M>(callees, f, words, result), stack.CalleePost(result),
            calls(f, below_other(f, n, below, differs), words, result),
            λ i s held => ⟨held.left, ⟨program_callees_earlier(last, earlier, f, differs, words, result, held.right.left), held.right.right⟩⟩),
    }
}

// What emitting functions proves: resident, they meet their contracts.
fn MayCall<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), functions: List<Function>, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => emitted.prog.Within(site.program) → site.Calls(stack, program_callees(functions), functions.len()))
}

theorem program_step<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    last: Function, earlier: List<Function>, before: Emitted,
    earlier_calls: before.prog.Within(site.program) → site.Calls(stack, program_callees(earlier), earlier.len())):
    (out: Option<Emitted>) → MayReturn<M>(site, stack, program_callees(earlier), earlier.len(), last, before.prog, out) →
    MayCall<M>(site, stack, Cons(last, earlier), out) {
    λ out => match out {
        None => λ _ => trivial,
        Some(emitted) => λ returns within => {
            let label_in = At(before.prog, Succ(earlier.len()), Block([])).within_trans(emitted.prog, site.program, returns.left, within);
            let calls = earlier_calls(before.prog.within_before(Succ(earlier.len()), Block([]), site.program, label_in));
            site.calls_extend(stack, last, earlier, prog_len(before.prog),
                label_target(label_in.witness, site.program, before.prog, earlier.len(), Block([]),
                    site.program.laid_out_unique(laid), label_in.proof),
                calls, returns.right(within, calls))
        },
    }
}

theorem emit_functions_calls<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    placement: List<Place>, names: Nat, functions: List<Function>):
    MayCall<M>(site, stack, functions, emit_functions(functions, placement, names)) {
    match functions {
        Nil => λ _ f below words result => false_elim(nothing_below_zero(f, below)),
        Cons(last, earlier) =>
            (match emit_functions(earlier, placement, names) as λ e => MayCall<M>(site, stack, earlier, e) →
                MayCall<M>(site, stack, Cons(last, earlier), match e {
                    None => None,
                    Some(before) => last.emit(before.prog, earlier.len(), before.placement, before.names),
                }) {
                None => λ _ => trivial,
                Some(before) => λ earlier_calls => program_step<M>(site, laid, stack, last, earlier, before, earlier_calls,
                    last.emit(before.prog, earlier.len(), before.placement, before.names),
                    last.emit_returns(site, laid, stack, program_callees(earlier), earlier.len(), before.prog, before.placement, before.names)),
            })(emit_functions_calls<M>(site, laid, stack, placement, names, earlier)),
    }
}

// What a program does, resident at `origin` with `stack`: every function
// meets its contract at its label.
fn ProgramCalls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    functions: List<Function>, program: Prog) → Type {
    Site<M>(fetch, data, program, last, origin).Calls(stack, program_callees(functions), functions.len())
}

theorem lower_program_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), functions: List<Function>, placement: List<Place>):
    lower_program(functions, placement).All(λ (p: Prog) => ProgramCalls<M>(fetch, data, last, origin, stack, functions, p)) {
    (match emit_functions(functions, placement, functions.len()) as λ e =>
        ((site: Site<M>) → site.program.laid_out().IsTrue() → (stack: Stack<M>(site.fetch, site.data)) → MayCall<M>(site, stack, functions, e)) →
        (match e as λ _ => Option<Prog> {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        }).All(λ (p: Prog) => ProgramCalls<M>(fetch, data, last, origin, stack, functions, p)) {
        None => λ _ => trivial,
        Some(out) => λ calls =>
            (match out.prog.laid_out() as λ b => (b.IsTrue() → out.prog.laid_out().IsTrue()) →
                (match b as λ _ => Option<Prog> { False => None, True => Some(out.prog) }).All(λ (p: Prog) =>
                    ProgramCalls<M>(fetch, data, last, origin, stack, functions, p)) {
                False => λ _ => trivial,
                True => λ laid => calls(Site<M>(fetch, data, out.prog, last, origin), laid(trivial), stack, out.prog.within_self()),
            })(λ ok => ok),
    })(λ site laid stack => emit_functions_calls<M>(site, laid, stack, placement, functions.len(), functions))
}

// The theorem, proved once: whatever the placement, a program
// `lower_program` returns, resident at any origin and with any stack
// meeting the stack laws, has each function meet its contract: called on
// arguments its functions say may give `result`, with room on the stack,
// it returns `result` in RAX, the callee-saved registers and its caller's
// stack as they were.
theorem lower_program_correct<M>(functions: List<Function>, placement: List<Place>, program: Prog,
    lowered: lower_program(functions, placement) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data)):
    Site<M>(fetch, data, program, last, origin).Calls(stack, program_callees(functions), functions.len()) {
    lower_program(functions, placement).all_some(λ (p: Prog) => ProgramCalls<M>(fetch, data, last, origin, stack, functions, p),
        program, lowered, lower_program_calls<M>(fetch, data, last, origin, stack, functions, placement))
}

// FunctionIR with calls lowered to x86 by a Heather function proved correct
// once (issues/function-ir-verified-lowering.md, round 3: calls and the
// stack).
//
// A program is a list of functions, last first, each calling only the ones
// after it (function_ir: `program_callees`). Each function is emitted at the
// label `Succ(f)`: it allocates a frame of eight slots below its return
// address, runs its body, moves its result into RAX, frees the frame, and
// returns. A call inside a body spills the eight caller-saved registers
// other than RAX into the frame, moves its arguments into the SysV argument
// registers, CALLs, and reloads them, so the file after it is the file
// before it with the result in RAX. Body code keeps the callee-saved
// registers (checked by evaluation, `leaves_all`), and every callee keeps
// them by its contract, so values in them would survive a call too.
//
// The theorem is round 2's over machine runs (x86_64_stack_runs): whatever
// the placement, if `lower` returns a program then, resident anywhere and
// with any stack meeting the stack laws, each function's code meets its
// contract: entered with its arguments in their registers and the return
// address on the stack, it returns there with its result in RAX, the
// callee-saved registers kept, and memory as it was but for stores into its
// own room below that address (`Stack::Wrote`,
// docs/native-one-compiler-design.md §2.1). That clause is what a caller
// keeps: its stack words, and for a program its data.
//
// The file a program's functions read and write is threaded
// (docs/native-one-compiler-design.md §2.6): the meaning is
// `function_ir_writes`' relation from the file before to the file after,
// the buffers are spans under the laws of a lending (`Loan`,
// x86_64_lending), and the contract (`Site::CallsOver`) says the file the
// meaning leaves is the one in memory on return, the stores besides the
// function's own being bytes of the spans the program may write
// (`Stack::WroteIn`). A leaf that stores nothing is proved over the file as
// it is when the leaf starts, and lifted (`may_emit_over_of_in`). A leaf
// that is one store is a byte `MOV` through the buffer's home, under the
// comparison that bounds its index as a load is, and the byte then there
// loaded back as the store's output names it (`store_emits`); the theorems
// ask that every buffer the program stores into (`program_stores`) is one
// the lending lets be written (`allowed`). A store lowers only into a home,
// so a program lowered with no buffers stores into none
// (`lower_program_quiet`): the contract without buffers
// (`lower_program_correct`, `Site::Calls`) is the one over the file at no
// spans, which every stack lends (`Stack::loan_nothing`).
//
// A call over views (`Lend`, docs/native-library-exports-design.md §3.1)
// is its views' nodes and then the call on the views' homes
// (`File::emit_lend`). Its callee runs under the views' lending
// (`Lending::lend`), which the contract at every lending supplies
// (`Site::CallsLent`), and the call's proof is shared: only the CALL
// speaks of the callee's contract, so `call_step` is stated for a callee
// entered under any lending, and a call and a call over views are its two
// instances (`File::emit_call_runs`, `lend_step`). What the lowering checks
// of the views, and what follows from the checks, is
// `function_ir_lower_views`.

import function_ir;
import function_ir_state;
import function_ir_writes;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_views;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_layout;
import x86_64_store;
import x86_64_stack;
import x86_64_lending;
import x86_64_kept;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bitvec_nat;
import bitvec_resize;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The calling convention

// SysV's: arguments in RDI, RSI, RDX, RCX, R8, R9, the result in RAX.
fn argument_registers() → List<Gpr> { [Rdi, Rsi, Rdx, Rcx, R8, R9] }

// What a caller saves around a call: the caller-saved registers but RAX,
// slot `k` holding the `k`th.
fn saved_registers() → List<Gpr> { [Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11] }

// What a callee keeps besides the stack pointer.
fn callee_kept() → List<Gpr> { [Rbx, Rbp, R12, R13, R14, R15] }

// The words in the registers, one each.
fn ArgsIn(words: List<BitVec(64)>) → List<Gpr> → Gprs → Type {
    match words {
        Nil => λ _ _ => True,
        Cons(word, rest) => λ registers gprs => match registers {
            Nil => False,
            Cons(register, later) => (read_gpr(register, gprs) = word) ∧ ArgsIn(rest, later, gprs),
        },
    }
}

theorem ports_args(values: Valuation(), ids: List<Nat>): (registers: List<Gpr>) → (gprs: Gprs) →
    PortsAt(values, word_ports(ids), registers, gprs) → ArgsIn(words_of(values, ids), registers, gprs) {
    match ids {
        Nil => λ registers gprs _ => trivial,
        Cons(id, rest) => λ registers gprs => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ placed => ⟨sym(placed.left), ports_args(values, rest, later, gprs, placed.right)⟩,
        },
    }
}

theorem args_ports(values: Valuation(), ids: List<Nat>): (registers: List<Gpr>) → (gprs: Gprs) →
    ArgsIn(words_of(values, ids), registers, gprs) → PortsAt(values, word_ports(ids), registers, gprs) {
    match ids {
        Nil => λ registers gprs _ => trivial,
        Cons(id, rest) => λ registers gprs => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ placed => ⟨sym(placed.left), args_ports(values, rest, later, gprs, placed.right)⟩,
        },
    }
}

// `writer` is none of the registers.
fn Gpr::misses(self writer: Gpr, registers: List<Gpr>) → Bool {
    match registers { Nil => True, Cons(register, rest) => !writer.same(register) && writer.misses(rest) }
}

theorem args_after_write(words: List<BitVec(64)>): (registers: List<Gpr>) → (gprs: Gprs) → (writer: Gpr) → (value: BitVec(64)) →
    writer.misses(registers).IsTrue() → ArgsIn(words, registers, gprs) → ArgsIn(words, registers, write_gpr(writer, value, gprs)) {
    match words {
        Nil => λ registers gprs writer value _ _ => trivial,
        Cons(word, rest) => λ registers gprs writer value => match registers {
            Nil => λ _ no => false_elim(no),
            Cons(register, later) => λ misses held => {
                let both = Bool::is_true_and(!writer.same(register), writer.misses(later), misses);
                ⟨trans(write_spares(writer, register, value, gprs, both.left), held.left),
                 args_after_write(rest, later, gprs, writer, value, both.right, held.right)⟩
            },
        },
    }
}

theorem kept_trans(registers: List<Gpr>, a, b, c: Gprs): Kept(registers, a, b) → Kept(registers, b, c) → Kept(registers, a, c) {
    match registers {
        Nil => λ _ _ => trivial,
        Cons(register, rest) => λ first second => ⟨trans(second.left, first.left), kept_trans(rest, a, b, c, first.right, second.right)⟩,
    }
}

theorem kept_refl(registers: List<Gpr>, gprs: Gprs): Kept(registers, gprs, gprs) {
    match registers { Nil => trivial, Cons(_, rest) => ⟨refl, kept_refl(rest, gprs)⟩ }
}

// ---------------------------------------------------------------------------
// Words past the sixth (issues/function-call-past-six-words.md)

// A call passes its first six words in the argument registers and the
// rest on the stack, as the System V convention has them: the seventh just
// above the return address, each later one a word above the one before. A
// function takes at most eight; its entry loads the two past the registers
// into R10 and R11 (`stack_registers`), none of which holds an argument or
// is kept for the caller, and its body starts with its parameters in
// `parameter_registers()`. Not RAX: a call's result lands there, so a
// parameter in RAX would be lost at the first call of a body that still
// reads it, and the caller-saved registers a call keeps are the other
// eight.
fn stack_registers() → List<Gpr> { [R10, R11] }
fn parameter_registers() → List<Gpr> { argument_registers() ++ stack_registers() }

// The words, the first ones in `registers` and the rest one a word from
// stack offset `at` up.
fn Stack::Passes<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>) → List<Gpr> → Nat → Gprs → M → Type {
    match words {
        Nil => λ _ _ _ _ => True,
        Cons(word, rest) => λ registers at gprs memory => match registers {
            Nil => ((at + 8 <= stack.size) ∧ (read_word(data, memory, stack.at(at)) = Some(word))) ∧
                stack.Passes(rest, Nil, at + 8, gprs, memory),
            Cons(register, later) => (read_gpr(register, gprs) = word) ∧ stack.Passes(rest, later, at, gprs, memory),
        },
    }
}

// The words a function entered at stack offset `i` is passed: in the
// argument registers, then from just above its return address. Six words
// or fewer read as `ArgsIn` does.
fn Stack::Passed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), words: List<BitVec(64)>,
    i: Nat, s: MachineState<M>) → Type {
    stack.Passes(words, argument_registers(), i + 8, s.gprs, s.memory)
}

// How many words a call of `count` passes on the stack.
fn stack_count(count: Nat) → Nat { count - 6 }

theorem Stack::passes_of_args<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>): (registers: List<Gpr>) → (at: Nat) → (gprs: Gprs) → (memory: M) →
    ArgsIn(words, registers, gprs) → stack.Passes(words, registers, at, gprs, memory) {
    match words {
        Nil => λ registers at gprs memory _ => trivial,
        Cons(_, rest) => λ registers at gprs memory => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ held => ⟨held.left, stack.passes_of_args(rest, later, at, gprs, memory, held.right)⟩,
        },
    }
}

theorem Stack::passes_after_write<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>): (registers: List<Gpr>) → (at: Nat) → (gprs: Gprs) → (memory: M) → (writer: Gpr) → (value: BitVec(64)) →
    writer.misses(registers).IsTrue() → stack.Passes(words, registers, at, gprs, memory) →
    stack.Passes(words, registers, at, write_gpr(writer, value, gprs), memory) {
    match words {
        Nil => λ registers at gprs memory writer value _ _ => trivial,
        Cons(word, rest) => λ registers at gprs memory writer value => match registers {
            Nil => λ misses held => ⟨held.left, stack.passes_after_write(rest, Nil, at + 8, gprs, memory, writer, value, misses, held.right)⟩,
            Cons(register, later) => λ misses held => {
                let both = Bool::is_true_and(!writer.same(register), writer.misses(later), misses);
                ⟨trans(write_spares(writer, register, value, gprs, both.left), held.left),
                 stack.passes_after_write(rest, later, at, gprs, memory, writer, value, both.right, held.right)⟩
            },
        },
    }
}

// The words on the stack are where memory from `from` up is unchanged.
theorem Stack::passes_unchanged<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    from: Nat, before, after: M, unchanged: stack.Unchanged(from, before, after), words: List<BitVec(64)>):
    (registers: List<Gpr>) → (at: Nat) → (gprs: Gprs) → from <= at → stack.Passes(words, registers, at, gprs, before) →
    stack.Passes(words, registers, at, gprs, after) {
    match words {
        Nil => λ registers at gprs _ _ => trivial,
        Cons(word, rest) => λ registers at gprs above => match registers {
            Nil => λ held => ⟨⟨held.left.left, trans(unchanged(at, above, held.left.left), held.left.right)⟩,
                stack.passes_unchanged(from, before, after, unchanged, rest, Nil, at + 8, gprs, { omega }, held.right)⟩,
            Cons(register, later) => λ held => ⟨held.left,
                stack.passes_unchanged(from, before, after, unchanged, rest, later, at, gprs, above, held.right)⟩,
        },
    }
}

// The registers' words and the rest on the stack are the words passed.
theorem Stack::passes_join<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>): (registers: List<Gpr>) → (at: Nat) → (gprs: Gprs) → (memory: M) →
    ArgsIn(words.take(registers.len()), registers, gprs) → stack.Passes(words.drop(registers.len()), Nil, at, gprs, memory) →
    stack.Passes(words, registers, at, gprs, memory) {
    match words {
        Nil => λ registers at gprs memory _ _ => trivial,
        Cons(word, rest) => λ registers at gprs memory => match registers {
            Nil => λ _ stacked => stacked,
            Cons(register, later) => λ held stacked => ⟨held.left, stack.passes_join(rest, later, at, gprs, memory, held.right, stacked)⟩,
        },
    }
}

// Words on the stack alone do not read the registers.
theorem Stack::passes_nil_other<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>): (at: Nat) → (gprs, other: Gprs) → (memory: M) →
    stack.Passes(words, Nil, at, gprs, memory) → stack.Passes(words, Nil, at, other, memory) {
    match words {
        Nil => λ at gprs other memory _ => trivial,
        Cons(word, rest) => λ at gprs other memory held => ⟨held.left, stack.passes_nil_other(rest, at + 8, gprs, other, memory, held.right)⟩,
    }
}

// The words passed on the stack, apart from the registers'.
theorem Stack::passes_stacked<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    words: List<BitVec(64)>): (registers: List<Gpr>) → (at: Nat) → (gprs, other: Gprs) → (memory: M) →
    stack.Passes(words, registers, at, gprs, memory) → stack.Passes(words.drop(registers.len()), Nil, at, other, memory) {
    match words {
        Nil => λ registers at gprs other memory _ => trivial,
        Cons(word, rest) => λ registers at gprs other memory => match registers {
            Nil => λ held => stack.passes_nil_other(Cons(word, rest), at, gprs, other, memory, held),
            Cons(register, later) => λ held => stack.passes_stacked(rest, later, at, gprs, other, memory, held.right),
        },
    }
}

// Registers saved one a slot from slot `k` hold the words stored there.
theorem Stack::saved_passes<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    gprs, other: Gprs, memory: M, words: List<BitVec(64)>): (registers: List<Gpr>) → (k: Nat) →
    d + 8 * (k + words.len()) <= stack.size → stack.Saved(d, registers, k, gprs, memory) → ArgsIn(words, registers, gprs) →
    stack.Passes(words, Nil, d + 8 * k, other, memory) {
    match words {
        Nil => λ registers k _ _ _ => trivial,
        Cons(word, rest) => λ registers k room => match registers {
            Nil => λ _ no => false_elim(no),
            Cons(register, later) => λ saved held => {
                let next: (d + 8 * Succ(k) = (d + 8 * k) + 8) = { omega };
                ⟨⟨{ omega }, trans(saved.left, cong_fn<BitVec(64), Option<BitVec(64)>>(λ w => Some(w), held.left))⟩,
                 j(next, λ a _ => stack.Passes(rest, Nil, a, other, memory),
                    stack.saved_passes(d, gprs, other, memory, rest, later, Succ(k), { omega }, saved.right, held.right))⟩
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The entry's loads

// The words loaded into the registers, one each, while both last.
fn load_words(registers: List<Gpr>, words: List<BitVec(64)>, gprs: Gprs) → Gprs {
    match registers {
        Nil => gprs,
        Cons(register, rest) => match words { Nil => gprs, Cons(word, more) => load_words(rest, more, write_gpr(register, word, gprs)) },
    }
}

// Loads of `count` words from slot `k` up into the registers, in order.
fn List::loads(self registers: List<Gpr>, count: Nat, prog: Prog, k: Nat) → Prog {
    match count {
        Zero => prog,
        Succ(c) => match registers {
            Nil => prog,
            Cons(register, rest) => rest.loads(c, At(prog, 0, Reload(StackLoad(register, slot_offset(k)))), Succ(k)),
        },
    }
}

theorem Prog::within_loads(registers: List<Gpr>): (count: Nat) → (prog: Prog) → (k: Nat) → prog.Within(registers.loads(count, prog, k)) {
    match registers {
        Nil => λ count prog k => match count { Zero => prog.within_self(), Succ(_) => prog.within_self() },
        Cons(register, rest) => λ count prog k => match count {
            Zero => prog.within_self(),
            Succ(c) => {
                let item = At(prog, 0, Reload(StackLoad(register, slot_offset(k))));
                prog.within_trans(item, rest.loads(c, item, Succ(k)), prog.within_then(0, Reload(StackLoad(register, slot_offset(k)))),
                    Prog::within_loads(rest, c, item, Succ(k)))
            },
        },
    }
}

// No register of `registers` is one of `others`.
fn List::clear_of(self registers: List<Gpr>, others: List<Gpr>) → Bool {
    match registers { Nil => True, Cons(register, rest) => others.spare(register) && rest.clear_of(others) }
}

// No register comes twice.
fn List::distinct(self registers: List<Gpr>) → Bool {
    match registers { Nil => True, Cons(register, rest) => rest.spare(register) && rest.distinct() }
}

theorem load_words_misses(query: Gpr, registers: List<Gpr>): (words: List<BitVec(64)>) → (gprs: Gprs) →
    registers.spare(query).IsTrue() → read_gpr(query, load_words(registers, words, gprs)) = read_gpr(query, gprs) {
    match registers {
        Nil => λ words gprs _ => refl,
        Cons(register, rest) => λ words gprs spare => match words {
            Nil => refl,
            Cons(word, more) => {
                let both = Bool::is_true_and(!register.same(query), rest.spare(query), spare);
                trans(load_words_misses(query, rest, more, write_gpr(register, word, gprs), both.right),
                    write_spares(register, query, word, gprs, both.left))
            },
        },
    }
}

// Distinct registers hold the words loaded into them.
theorem loaded_args(registers: List<Gpr>): (words: List<BitVec(64)>) → (gprs: Gprs) → registers.distinct().IsTrue() →
    words.len() <= registers.len() → ArgsIn(words, registers, load_words(registers, words, gprs)) {
    match registers {
        Nil => λ words gprs _ => match words {
            Nil => λ _ => trivial,
            Cons(_, more) => λ long => { let no: False = { omega }; match no {} },
        },
        Cons(register, rest) => λ words gprs distinct => match words {
            Nil => λ _ => trivial,
            Cons(word, more) => λ room => {
                let both = Bool::is_true_and(rest.spare(register), rest.distinct(), distinct);
                ⟨trans(load_words_misses(register, rest, more, write_gpr(register, word, gprs), both.left),
                    read_gpr_after_write(register, word, gprs)),
                 loaded_args(rest, more, write_gpr(register, word, gprs), both.right, { omega })⟩
            },
        },
    }
}

// A function's parameters once its entry has loaded the stack's: the
// registers' words as they were, the stack's in `loaded`.
theorem Stack::passes_loaded<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data),
    loaded: List<Gpr>, distinct: loaded.distinct().IsTrue(), words: List<BitVec(64)>): (registers: List<Gpr>) → (at: Nat) →
    (gprs: Gprs) → (memory: M) → registers.clear_of(loaded).IsTrue() → words.drop(registers.len()).len() <= loaded.len() →
    stack.Passes(words, registers, at, gprs, memory) →
    ArgsIn(words, registers ++ loaded, load_words(loaded, words.drop(registers.len()), gprs)) {
    match words {
        Nil => λ registers at gprs memory _ _ _ => trivial,
        Cons(word, rest) => λ registers at gprs memory => match registers {
            Nil => λ _ room _ => loaded_args(loaded, Cons(word, rest), gprs, distinct, room),
            Cons(register, later) => λ clear room held => {
                let both = Bool::is_true_and(loaded.spare(register), later.clear_of(loaded), clear);
                ⟨trans(load_words_misses(register, loaded, rest.drop(later.len()), gprs, both.left), held.left),
                 stack.passes_loaded(loaded, distinct, rest, later, at, gprs, memory, both.right, room, held.right)⟩
            },
        },
    }
}

// The loads run: each word on the stack from slot `k` of the frame at
// `d` lands in its register, memory as it was.
theorem Site::moves_loads<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), fits: FillsFit(site.program, no_fills()),
    d: Nat, other: Gprs, memory: M, registers: List<Gpr>): (words: List<BitVec(64)>) → (prog: Prog) → (k: Nat) → (gprs: Gprs) →
    k + words.len() <= 16 → registers.spare(Rsp).IsTrue() → read_gpr(Rsp, gprs) = stack.at(d) →
    stack.Passes(words, Nil, d + 8 * k, other, memory) → registers.loads(words.len(), prog, k).Within(site.program) →
    site.Moves(stack.writes, prog_len(prog), prog_len(registers.loads(words.len(), prog, k)),
        λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
        λ (t: MachineState<M>) => (t.gprs = load_words(registers, words, gprs)) ∧ (t.memory = memory)) {
    match registers {
        Nil => λ words prog k gprs _ _ _ _ _ => match words {
            Nil => site.moves_refl(stack.writes, prog_len(prog),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
                λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (t.memory = memory), λ s held => held),
            Cons(_, _) => site.moves_refl(stack.writes, prog_len(prog),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
                λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (t.memory = memory), λ s held => held),
        },
        Cons(register, rest) => λ words prog k gprs => match words {
            Nil => λ _ _ _ _ _ => site.moves_refl(stack.writes, prog_len(prog),
                λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
                λ (t: MachineState<M>) => (t.gprs = gprs) ∧ (t.memory = memory), λ s held => held),
            Cons(word, more) => λ small spare rsp passed within => {
                let load = StackLoad(register, slot_offset(k));
                let item = At(prog, 0, Reload(load));
                let i = d + 8 * k;
                let slot_small: (k < 16) = { omega };
                let next = write_gpr(register, word, gprs);
                let spares = Bool::is_true_and(!register.same(Rsp), rest.spare(Rsp), spare);
                let item_in = item.within_trans(rest.loads(more.len(), item, Succ(k)), site.program,
                    Prog::within_loads(rest, more.len(), item, Succ(k)), within);
                let first = site.moves_reload(stack, fits, item_in.witness, prog, 0, load, item_in.proof,
                    λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
                    λ (s: MachineState<M>) => (s.gprs = next) ∧ (s.memory = memory),
                    λ s held => Exists(i, ⟨j(sym(held.left), λ g _ => stack_address(g, slot_offset(k)) = stack.at(i),
                            stack.slot_address(d, k, gprs, rsp, slot_small)),
                        ⟨passed.left.left, Exists(word, ⟨j(sym(held.right), λ m _ => read_word(site.data, m, stack.at(i)) = Some(word),
                                passed.left.right),
                            ⟨cong_fn<Gprs, Gprs>(λ g => write_gpr(register, word, g), held.left), held.right⟩⟩)⟩⟩));
                let step: ((d + 8 * k) + 8 = d + 8 * Succ(k)) = { omega };
                let later = Site::moves_loads(site, stack, fits, d, other, memory, rest, more, item, Succ(k), next, { omega }, spares.right,
                    trans(write_spares(register, Rsp, word, gprs, spares.left), rsp),
                    j(step, λ a _ => stack.Passes(more, Nil, a, other, memory), passed.right), within);
                site.moves_trans(stack.writes, prog_len(prog), prog_len(item), prog_len(rest.loads(more.len(), item, Succ(k))),
                    λ (s: MachineState<M>) => (s.gprs = gprs) ∧ (s.memory = memory),
                    λ (s: MachineState<M>) => (s.gprs = next) ∧ (s.memory = memory),
                    λ (t: MachineState<M>) => (t.gprs = load_words(rest, more, next)) ∧ (t.memory = memory),
                    first, later)
            },
        },
    }
}

// The callee-saved registers are the stack pointer and the ones a callee
// keeps besides.
theorem kept_saved(before, after: Gprs, rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before), kept: Kept(callee_kept(), before, after)):
    Kept(callee_saved(), before, after) {
    ⟨kept.left, ⟨kept.right.left, ⟨rsp, kept.right.right⟩⟩⟩
}
theorem saved_kept(before, after: Gprs, kept: Kept(callee_saved(), before, after)): Kept(callee_kept(), before, after) {
    ⟨kept.left, ⟨kept.right.left, kept.right.right.right⟩⟩
}

// The callee-saved registers in the order a function takes them
// (`kept_order`, function_ir_lower_reads).
theorem kept_ordered(before, after: Gprs, kept: Kept(callee_kept(), before, after)): Kept(kept_order(), before, after) {
    ⟨kept.right.right.left, ⟨kept.right.right.right.left, ⟨kept.right.right.right.right.left, ⟨kept.right.right.right.right.right.left,
        ⟨kept.left, ⟨kept.right.left, trivial⟩⟩⟩⟩⟩⟩
}

theorem kept_drop(registers: List<Gpr>, before, after: Gprs): (n: Nat) → Kept(registers, before, after) → Kept(registers.drop(n), before, after) {
    match registers {
        Nil => λ n _ => trivial,
        Cons(register, rest) => λ n => match n {
            Zero => λ kept => kept,
            Succ(k) => λ kept => kept_drop(rest, before, after, k, kept.right),
        },
    }
}

// What a body keeps (`body_kept`), whatever it saved, is kept by whatever
// keeps the stack pointer and the callee-saved registers: a callee, by its
// contract.
theorem body_kept_of(saves: Nat, before, after: Gprs, rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before),
    kept: Kept(callee_kept(), before, after)): Kept(body_kept(saves), before, after) {
    ⟨rsp, kept_drop(kept_order(), before, after, saves, kept_ordered(before, after, kept))⟩
}

// What function `f` promises, called on `arguments` where the program's
// functions say it may return `result`: entered at stack offset `i` with
// the arguments passed (`Stack::Passed`) and room below for itself and its
// callees (`136` bytes a level: its frame, the two words past the sixth
// of a call it makes, and that call's return address), it returns with `result` in
// RAX, the callee-saved registers kept, and memory as it was but for
// stores of its own below `i` (`Stack::Wrote`): its caller's words, the
// return address among them, and whatever else such stores leave.
fn Stack::CalleePre<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), callees: Callees(), f: Nat,
    arguments: List<BitVec(64)>, result: BitVec(64)) → Nat → MachineState<M> → Type {
    λ i s => stack.Passed(arguments, i, s) ∧ (callees(f, arguments, result) ∧ 136 * Succ(f) <= i)
}
fn Stack::CalleePost<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64)) →
    Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => (read_gpr(Rax, t.gprs) = result) ∧ (Kept(callee_kept(), s.gprs, t.gprs) ∧ stack.Wrote(i, s.memory, t.memory))
}

// The contract as it read before it stated the stores: the caller's stack
// words unchanged, here from the return address up.
fn Stack::CalleeKeeps<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64)) →
    Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => (read_gpr(Rax, t.gprs) = result) ∧ (Kept(callee_kept(), s.gprs, t.gprs) ∧ stack.Unchanged(i, s.memory, t.memory))
}
theorem Stack::callee_keeps<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), result: BitVec(64),
    i: Nat, s, t: MachineState<M>, room: i + 8 <= stack.size, post: stack.CalleePost(result)(i, s, t)): stack.CalleeKeeps(result)(i, s, t) {
    ⟨post.left, ⟨post.right.left, stack.wrote_unchanged(i, { omega }, s.memory, t.memory, post.right.right)⟩⟩
}

// Every function below `bound` meets its contract at its label.
fn Site::Calls<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), callees: Callees(), bound: Nat) → Type {
    (f: Nat) → Succ(f) <= bound → (arguments: List<BitVec(64)>) → (result: BitVec(64)) →
        site.Returns(stack, asm_labels(site.program)(Succ(f)), stack.CalleePre(callees, f, arguments, result), stack.CalleePost(result))
}

// What a program's functions are lent (docs/native-one-compiler-design.md
// §2.3, §2.6): how many buffers each function takes, by function, where
// each buffer lies, the file as it was when the program was called, and
// which buffers the program may write. The buffers are the program's, by
// number: a call hands on buffers `0` to its callee's count under the same
// numbers. A store changes a byte and never a length, so `buffers` says how
// long each buffer is for as long as the program runs.
record Lending { counts: List<Nat>, addresses: List<BitVec(64)>, buffers: Buffers(), written: Nat → Bool }

fn Lending::none() → Lending { Lending([], [], [], λ (_: Nat) => False) }

// A lending to read: no buffer may be written.
fn Lending::reading(counts: List<Nat>, addresses: List<BitVec(64)>, buffers: Buffers()) → Lending {
    Lending(counts, addresses, buffers, λ (_: Nat) => False)
}

// A lending to write: the buffers `marks` marks may be written
// (`marked`, function_ir_writes), the others only read.
fn Lending::writing(counts: List<Nat>, addresses: List<BitVec(64)>, buffers: Buffers(), marks: List<Bool>) → Lending {
    Lending(counts, addresses, buffers, λ (b: Nat) => marked(marks, b))
}

fn lent_count(counts: List<Nat>, f: Nat) → Nat { match counts.nth(f) { None => 0, Some(count) => count } }

// The lending with the file as it is `now`.
fn Lending::over(self lending: Lending, now: Buffers()) → Lending {
    Lending(lending.counts, lending.addresses, now, lending.written)
}

// What a call over `views` lends its callee
// (docs/native-library-exports-design.md §3.1): the views as its buffers,
// each at its base and as long as its window of the scope's buffer, to be
// written where the view is. The lengths are the windows' of the lending's
// own buffers, which no store changes, so this lending is known before the
// call's code runs; the file at the call enters as the callee's file.
fn Lending::lend(self lending: Lending, views: List<View>, values: Valuation()) → Lending {
    Lending(lending.counts, views_addresses(views, values), viewed(views, values, lending.buffers),
        λ (v: Nat) => marked(views_marks(views), v))
}

// The buffers as spans of memory (x86_64_lending).
fn Lending::spans(self lending: Lending) → Spans {
    Spans(λ (b: Nat) => address_of(lending.addresses, b), λ (b: Nat) => buffer_bytes(lending.buffers, b).len(), lending.written)
}

// Every buffer is lent to a call entered at `i`: its bytes read at its
// address, whatever the call stores below `i` (`Stack::Lends`).
fn Stack::LentAll<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), i: Nat, lending: Lending,
    memory: M) → Type {
    (buffer: Nat) → stack.Lends(i, address_of(lending.addresses, buffer), buffer_bytes(lending.buffers, buffer), memory)
}

// The file `now` is the one in memory: buffer for buffer as long as the
// lending's, its bytes read where the buffer lies.
fn Stack::InMemory<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending,
    now: Buffers(), memory: M) → Type {
    (b: Nat) → (buffer_bytes(now, b).len() = buffer_bytes(lending.buffers, b).len()) ∧
        Readable(data, memory, address_of(lending.addresses, b), buffer_bytes(now, b))
}

// Under the laws, the file in memory is lent to a call entered below
// `top`: its own stores leave every buffer.
theorem Stack::in_memory_lent<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), i: Nat, low: i <= top, now: Buffers(), memory: M,
    held: stack.InMemory(lending, now, memory)): stack.LentAll(i, lending.over(now), memory) {
    λ buffer => {
        let same = held(buffer).left;
        let fits: (buffer_bytes(now, buffer).len() <= buffer_bytes(lending.buffers, buffer).len()) = omega(same);
        loan.lends(i, low, buffer, buffer_bytes(now, buffer), fits, memory, held(buffer).right)
    }
}

// And the file is still the one in memory after them.
theorem Stack::in_memory_wrote<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), i: Nat, low: i <= top, now: Buffers(), before, after: M,
    wrote: stack.Wrote(i, before, after), held: stack.InMemory(lending, now, before)): stack.InMemory(lending, now, after) {
    λ b => {
        let same = held(b).left;
        let fits: (buffer_bytes(now, b).len() <= buffer_bytes(lending.buffers, b).len()) = omega(same);
        ⟨same, loan.wrote_reads(i, low, b, buffer_bytes(now, b), fits, before, after, wrote, held(b).right)⟩
    }
}

// What a body has done to memory since it started at `entry`, its frame at
// offset `d`: stores into its frame and below, and of bytes into the
// buffers the program may write (`Stack::WroteIn`); and the file `now` is
// the one in memory.
fn Stack::Trail<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    entry: M, now: Buffers(), memory: M) → Type {
    stack.WroteIn(d + 64, lending.spans(), entry, memory) ∧ stack.InMemory(lending, now, memory)
}

// A word stored in the frame or below keeps the trail.
theorem Stack::trail_store<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), d: Nat, under: d + 64 <= top, entry: M, now: Buffers(),
    memory: M, trail: stack.Trail(lending, d, entry, now, memory), k: Nat, inside: k + 8 <= d + 64, word: BitVec(64)):
    stack.Trail(lending, d, entry, now, stack.writes.store(memory, stack.at(k), word_bytes(word))) {
    let stored = stack.writes.store(memory, stack.at(k), word_bytes(word));
    let own = stack.wrote_store(d + 64, memory, k, inside, word);
    ⟨stack.wrote_in_trans(d + 64, lending.spans(), entry, memory, stored, trail.left,
        stack.wrote_in_own(d + 64, lending.spans(), memory, stored, own)),
     stack.in_memory_wrote(top, lending, loan, d + 64, under, now, memory, stored, own, trail.right)⟩
}

// A byte stored into a buffer the lending lets a call write: the file with
// that byte set is the one in memory.
theorem Stack::in_memory_put<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), now: Buffers(), memory: M,
    held: stack.InMemory(lending, now, memory), b, k: Nat, written: lending.written(b) = True,
    inside: k < buffer_bytes(lending.buffers, b).len(), byte: BitVec(8)):
    stack.InMemory(lending, store_byte(now, b, k, byte), stack.writes.store(memory, lending.spans().byte(b, k), [byte])) {
    let set = λ (_: BitVec(8)) => byte;
    let stored = stack.writes.store(memory, lending.spans().byte(b, k), [byte]);
    λ c => match b.eq_dec(c) {
        Inl(same) => j(same, λ x _ => (buffer_bytes(store_byte(now, b, k, byte), x).len() = buffer_bytes(lending.buffers, x).len()) ∧
                Readable(data, stored, address_of(lending.addresses, x), buffer_bytes(store_byte(now, b, k, byte), x)),
            j(sym(buffer_bytes_stored(now, b, k, byte)), λ ys _ => (ys.len() = buffer_bytes(lending.buffers, b).len()) ∧
                    Readable(data, stored, address_of(lending.addresses, b), ys),
                ⟨trans(buffer_bytes(now, b).len_update(k, set), held(b).left),
                 loan.put_reads(memory, b, k, written, inside, byte, buffer_bytes(now, b), held(b).left, held(b).right)⟩)),
        Inr(differs) => {
            let fits: (buffer_bytes(now, c).len() <= buffer_bytes(lending.buffers, c).len()) = omega(held(c).left);
            j(sym(buffer_bytes_store_other(now, b, k, byte, c, differs)), λ ys _ =>
                    (ys.len() = buffer_bytes(lending.buffers, c).len()) ∧ Readable(data, stored, address_of(lending.addresses, c), ys),
                ⟨held(c).left, loan.put_keeps(memory, b, k, written, inside, byte, c, differs, buffer_bytes(now, c), fits, held(c).right)⟩)
        },
    }
}

// And the trail is kept, the file now the one with the byte set.
theorem Stack::trail_put<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), d: Nat, entry: M, now: Buffers(), memory: M,
    trail: stack.Trail(lending, d, entry, now, memory), b, k: Nat, written: lending.written(b) = True,
    inside: k < buffer_bytes(lending.buffers, b).len(), byte: BitVec(8)):
    stack.Trail(lending, d, entry, store_byte(now, b, k, byte), stack.writes.store(memory, lending.spans().byte(b, k), [byte])) {
    ⟨stack.wrote_in_trans(d + 64, lending.spans(), entry, memory, stack.writes.store(memory, lending.spans().byte(b, k), [byte]), trail.left,
        stack.wrote_in_put(d + 64, lending.spans(), memory, b, k, written, inside, byte)),
     stack.in_memory_put(top, lending, loan, now, memory, trail.right, b, k, written, inside, byte)⟩
}

// What a call gives function `f` of the file `now`: the homes of the
// buffers it takes as its first arguments, room on the stack below `top`,
// under which the buffers are lent, and the file in memory.
fn Stack::LentOver<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, top: Nat,
    f: Nat, arguments: List<BitVec(64)>, now: Buffers()) → Nat → MachineState<M> → Type {
    λ i s => ArgsLent(lent_count(lending.counts, f), 0, arguments, lending.addresses, lending.buffers) ∧
        ((i + 8 <= top) ∧ stack.InMemory(lending, now, s.memory))
}

// What function `f` is called under, over the file `before`
// (docs/native-one-compiler-design.md §2.6): its arguments in their
// registers, what the program's functions say it may return and leave
// (`effects`), room for its frames, and the file lent.
fn Stack::CalledOver<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), effects: Effects(),
    lending: Lending, top: Nat, f: Nat, arguments: List<BitVec(64)>, result: BitVec(64), before, after: Buffers()) →
    Nat → MachineState<M> → Type {
    λ i s => (stack.Passed(arguments, i, s) ∧ (effects(before, f, arguments, result, after) ∧ 136 * Succ(f) <= i)) ∧
        stack.LentOver(lending, top, f, arguments, before)(i, s)
}

// And what it promises: `result` in RAX, the callee-saved registers kept,
// memory as it was but for stores of its own below `i` and of bytes into
// the buffers the program may write, and the file `after` the one in
// memory.
fn Stack::AnsweredOver<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending,
    result: BitVec(64), after: Buffers()) → Nat → MachineState<M> → MachineState<M> → Type {
    λ i s t => (read_gpr(Rax, t.gprs) = result) ∧ (Kept(callee_kept(), s.gprs, t.gprs) ∧
        (stack.WroteIn(i, lending.spans(), s.memory, t.memory) ∧ stack.InMemory(lending, after, t.memory)))
}

// Every function below `bound` meets that contract at its label, over
// every file.
fn Site::CallsOver<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), effects: Effects(), bound: Nat, lending: Lending,
    top: Nat) → Type {
    (f: Nat) → Succ(f) <= bound → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) →
        site.Returns(stack, asm_labels(site.program)(Succ(f)), stack.CalledOver(effects, lending, top, f, arguments, result, before, after),
            stack.AnsweredOver(lending, result, after))
}

// And at every lending of the program's `counts`, a function at a time:
// function `f` meets its contract under any lending that lets it write
// what `needs` says it needs (`ProgramNeeds`, function_ir_writes). This is
// what a call over views asks of its callee, whose lending is the views'
// and not its caller's (docs/native-library-exports-design.md §3.1). The
// code does not depend on the lending but for its counts, so the program's
// induction gives this as it gave the contract at one.
fn Site::CallsLent<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), effects: Effects(), bound: Nat, counts: List<Nat>,
    needs: Nat → Nat → Bool, top: Nat) → Type {
    (lending: Lending) → lending.counts = counts → Loan<M>(site.fetch, site.data, stack, top, lending.spans()) →
        (f: Nat) → Succ(f) <= bound → ((b: Nat) → needs(f, b).IsTrue() → lending.written(b) = True) →
        (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) →
        site.Returns(stack, asm_labels(site.program)(Succ(f)), stack.CalledOver(effects, lending, top, f, arguments, result, before, after),
            stack.AnsweredOver(lending, result, after))
}

// What a leaf that stores nothing keeps of where it started (`s0`, its
// frame at offset `d`): the callee-saved registers, and memory but for
// stores into its own frame and below.
fn Stack::Framed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), saves: Nat, d: Nat,
    s0, s: MachineState<M>) → Type {
    Kept(body_kept(saves), s0.gprs, s.gprs) ∧ stack.Wrote(d + 64, s0.memory, s.memory)
}

// What a body keeps of where it started, over the file `now`: the
// callee-saved registers, and the trail.
fn Stack::Trailed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), saves: Nat, lending: Lending, d: Nat,
    s0: MachineState<M>, now: Buffers(), s: MachineState<M>) → Type {
    Kept(body_kept(saves), s0.gprs, s.gprs) ∧ stack.Trail(lending, d, s0.memory, now, s.memory)
}

// Words a callee leaves from `d` up to `top` keep the slots there.
theorem Stack::saved_unchanged<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, top: Nat,
    gprs: Gprs, before, after: M, unchanged: stack.UnchangedTo(d, top, before, after), registers: List<Gpr>):
    (k: Nat) → d + 8 * (k + registers.len()) <= top → stack.Saved(d, registers, k, gprs, before) → stack.Saved(d, registers, k, gprs, after) {
    match registers {
        Nil => λ k _ _ => trivial,
        Cons(register, rest) => λ k room saved =>
            ⟨trans(unchanged(d + 8 * k, { omega }, { omega }), saved.left),
             stack.saved_unchanged(d, top, gprs, before, after, unchanged, rest, Succ(k), { omega }, saved.right)⟩,
    }
}

// ---------------------------------------------------------------------------
// Emitting with calls

// What emitting proves now: round 2's `Emits` over machine runs, the frame
// kept. `s0` is where the body started, its frame at stack offset `d`.
fn EmitsIn<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, out: Emitted) → Type {
    prog.Within(out.prog) ∧ (out.prog.Within(site.program) →
        site.Moves(stack.writes, prog_len(prog), prog_len(out.prog),
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.Framed(saves, d, s0, s),
            λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t)))
}

fn MayEmitIn<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts: Type, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, facts, emitted))
}

// The stack pointer moved down past the words a call passes on the stack
// (at most two), and back up after the call: no instruction for a call
// that passes six words or fewer.
fn stack_lower(count: Nat) → List<Instruction> {
    match count { Zero => [], Succ(_) => [AddRI8(Rsp, BitVec::ofNat(256 - 8 * count))] }
}
fn stack_raise(count: Nat) → List<Instruction> {
    match count { Zero => [], Succ(_) => [AddRI8(Rsp, BitVec::ofNat(8 * count))] }
}

// A call's code after `prog`: the spills, the stack pointer lowered and
// the words it passes on the stack stored from `sources`, the argument
// moves, the CALL, the stack pointer back, the reloads.
fn call_staged(prog: Prog, sources: List<Gpr>) → Prog {
    sources.spills(At(saved_registers().spills(prog, 0), 0, Block(stack_lower(sources.len()))), 0)
}
fn call_prog(prog: Prog, sources: List<Gpr>, moves: List<Instruction>, callee: Nat) → Prog {
    saved_registers().reloads(At(At(At(call_staged(prog, sources), 0, Block(moves)), 0, CallTo(Succ(callee))), 0,
        Block(stack_raise(sources.len()))), 0)
}

theorem staged_within(prog: Prog, sources: List<Gpr>): prog.Within(call_staged(prog, sources)) {
    let spilled = saved_registers().spills(prog, 0);
    let lowered = At(spilled, 0, Block(stack_lower(sources.len())));
    prog.within_trans(spilled, call_staged(prog, sources), Prog::within_spills(saved_registers(), prog, 0),
        spilled.within_trans(lowered, call_staged(prog, sources), spilled.within_then(0, Block(stack_lower(sources.len()))),
            Prog::within_spills(sources, lowered, 0)))
}

theorem call_within(prog: Prog, sources: List<Gpr>, code: List<Instruction>, callee: Nat): prog.Within(call_prog(prog, sources, code, callee)) {
    let staged = call_staged(prog, sources);
    let moved = At(staged, 0, Block(code));
    let called = At(moved, 0, CallTo(Succ(callee)));
    let raised = At(called, 0, Block(stack_raise(sources.len())));
    let out_prog = saved_registers().reloads(raised, 0);
    prog.within_trans(staged, out_prog, staged_within(prog, sources),
        staged.within_trans(moved, out_prog, staged.within_then(0, Block(code)),
            moved.within_trans(called, out_prog, moved.within_then(0, CallTo(Succ(callee))),
                called.within_trans(raised, out_prog, called.within_then(0, Block(stack_raise(sources.len()))),
                    Prog::within_reloads(saved_registers(), raised, 0)))))
}

// A call's argument moves, ordered (round 4). A move goes once its target
// holds nothing another pending move reads, or holds it in some other
// register too. When every pending move waits on another (a cycle, as
// `f(b, a)` with `a` in RDI and `b` in RSI), the first one's blocker is
// copied into a register no argument goes to and nothing pending needs:
// RAX, which the call clobbers anyway, else R10 or R11, both saved around
// the call. Untrusted: `outputs_check` judges where the moves end.
record ArgumentMove { port: Port, register: Gpr }

fn argument_moves(ports: List<Port>, registers: List<Gpr>) → List<ArgumentMove> {
    match ports {
        Nil => [],
        Cons(port, rest) => match registers {
            Nil => [],
            Cons(register, later) => Cons(ArgumentMove(port, register), argument_moves(rest, later)),
        },
    }
}

fn ArgumentMove::ports(self moves: List<ArgumentMove>) → List<Port> {
    match moves { Nil => [], Cons(m, rest) => Cons(m.port, ArgumentMove::ports(rest)) }
}

fn ArgumentMove::registers(self moves: List<ArgumentMove>) → List<Gpr> {
    match moves { Nil => [], Cons(m, rest) => Cons(m.register, ArgumentMove::registers(rest)) }
}

// Some pending move reads `id` into a register other than `register`.
fn ArgumentMove::reads(self pending: List<ArgumentMove>, id: Nat, register: Gpr) → Bool {
    match pending {
        Nil => False,
        Cons(m, rest) => (m.port.id.same(id) && !m.register.same(register)) || ArgumentMove::reads(rest, id, register),
    }
}

// Some register of `pool` other than `register` holds `id`.
fn File::holds_elsewhere(self file: File, id: Nat, register: Gpr, pool: List<Gpr>) → Bool {
    match pool {
        Nil => False,
        Cons(other, rest) => (!other.same(register) && match file.at(other) { None => False, Some(held) => held.id.same(id) })
            || file.holds_elsewhere(id, register, rest),
    }
}

// Writing `register` would lose a value a pending move still reads.
fn File::blocked(self file: File, register: Gpr, pending: List<ArgumentMove>) → Bool {
    match file.at(register) {
        None => False,
        Some(held) => ArgumentMove::reads(pending, held.id, register) && !file.holds_elsewhere(held.id, register, scratch_pool()),
    }
}

fn File::first_ready(self file: File, candidates, pending: List<ArgumentMove>) → Option<ArgumentMove> {
    match candidates {
        Nil => None,
        Cons(m, rest) => match file.blocked(m.register, pending) { False => Some(m), True => file.first_ready(rest, pending) },
    }
}

fn ArgumentMove::without(self pending: List<ArgumentMove>, register: Gpr) → List<ArgumentMove> {
    match pending {
        Nil => [],
        Cons(m, rest) => match m.register.same(register) { True => rest, False => Cons(m, ArgumentMove::without(rest, register)) },
    }
}

fn File::staging(self file: File, pending: List<ArgumentMove>, pool: List<Gpr>) → Option<Gpr> {
    match pool {
        Nil => None,
        Cons(register, rest) => match file.blocked(register, pending) { False => Some(register), True => file.staging(pending, rest) },
    }
}

fn schedule_moves(fuel: Nat) → File → List<ArgumentMove> → List<ArgumentMove> {
    match fuel {
        Zero => λ file pending => pending,
        Succ(more) => λ file pending => match pending {
            Nil => [],
            Cons(first, others) => match file.first_ready(Cons(first, others), Cons(first, others)) {
                Some(m) => Cons(m, schedule_moves(more, file.write(m.register, Some(Held(m.port.id, Word))),
                    ArgumentMove::without(Cons(first, others), m.register))),
                None => match file.at(first.register) {
                    None => Cons(first, others),
                    Some(held) => match file.staging(Cons(first, others), [Rax, R10, R11]) {
                        None => Cons(first, others),
                        Some(stage) => Cons(ArgumentMove(Port(id := held.id, width := 64), stage),
                            schedule_moves(more, file.write(stage, Some(held)), Cons(first, others))),
                    },
                },
            },
        },
    }
}

// The moves a call makes, in order.
fn File::call_moves(self file: File, arguments: List<Nat>) → List<ArgumentMove> {
    schedule_moves(3 * arguments.len() + 3, file, argument_moves(word_ports(arguments), argument_registers()))
}

// Registers that hold the words at `ids`, one each: where `find` finds
// them. Untrusted: `outputs_check` judges them.
fn File::sources(self file: File, ids: List<Nat>) → Option<List<Gpr>> {
    match ids {
        Nil => Some([]),
        Cons(id, rest) => match file.find(Held(id, Word)) {
            None => None,
            Some(found) => match file.sources(rest) { None => None, Some(later) => Some(Cons(found.register, later)) },
        },
    }
}

// The call once the stack pointer is no longer a word of the file
// (`staged`): the words past the sixth stored from the registers that
// hold them, the first six moved into theirs.
fn File::emit_call_staged(self file: File, staged: File, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names: Nat) → Option<Emitted> {
    match staged.sources(arguments.drop(6)) {
        None => None,
        Some(sources) => match sources.len().same(arguments.drop(6).len()) && staged.outputs_check(word_ports(arguments.drop(6)), sources) {
            False => None,
            True => match staged.move_outputs(ArgumentMove::ports(staged.call_moves(arguments.take(6))),
                ArgumentMove::registers(staged.call_moves(arguments.take(6)))) {
                None => None,
                Some(moves) => match moves.file.outputs_check(word_ports(arguments.take(6)), argument_registers()) &&
                    leaves_all(moves.code, callee_saved()) {
                    False => None,
                    True => Some(Emitted(call_prog(prog, sources, moves.code, callee), file.write(Rax, Some(Held(result, Word))), placement, names)),
                },
            },
        },
    }
}

// The call, refused where the callee is not below `bound`, the callee's
// buffers are not its leading arguments, it passes more than eight words,
// or the arguments do not all reach their registers and slots.
fn File::emit_call(self file: File, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>,
    names, bound: Nat, counts: List<Nat>, homes: List<Lent>) → Option<Emitted> {
    match Succ(callee).leb(bound) && (args_lend(homes, lent_count(counts, callee), 0, arguments) && arguments.drop(6).len().leb(2)) {
        False => None,
        True => file.emit_call_staged(file.write(Rsp, None), prog, callee, arguments, result, placement, names),
    }
}

// A dataflow leaf, its code keeping the callee-saved registers.
fn emit_kept_nodes(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match lower_nodes(nodes, placement, file) {
        None => None,
        Some(lowered) => match leaves_all(lowered.code, body_kept(saves)) {
            False => None,
            True => Some(Emitted(At(prog, 0, Block(lowered.code)), lowered.file, skip_nodes(nodes, placement), names)),
        },
    }
}

// A constant table read (`TableRead`, the last node of its leaf):
// `function_ir_lower_reads` finds it, and the nodes before it are
// lowered as a block.

// The table's own checks: the read is a word's, the index's `bits` reach
// no further than the entries (`2^bits` of them or more, so every value
// of the index names one), and the jump over the table, a 32-bit
// displacement, reads back as the table's length.
fn TableLeaf::fits(self table: TableLeaf) → Bool {
    table.width.same(64) && (Nat::pow(2, table.bits).leb(table.entries.len()) && (table.bits.leb(64) &&
        BitVec::ofNat(8 * table.entries.len(), n := 32).sign_extend(32).toNat().same(8 * table.entries.len())))
}

// The read, refused where the index's register is not the one found, the
// table does not fit (`fits`), the base register is the index's, or the
// code would write a register the body keeps.
fn Lowered::table_with(self lowered: Lowered, saves: Nat, prog: Prog, table: TableLeaf, base: SibBase, index: SibIndex,
    placement: List<Place>, names: Nat) → Option<Emitted> {
    match lowered.file.found_at(Held(table.index, Narrow(table.bits)), index.gpr()) {
        None => None,
        Some(_) => match table.fits() && (!base.gpr().same(index.gpr()) &&
            (leaves_all(lowered.code, body_kept(saves)) && base.gpr().apart(body_kept(saves)))) {
            False => None,
            True => Some(Emitted(table_read_prog(At(prog, 0, Block(lowered.code)), base, index, table.entries),
                lowered.file.write(base.gpr(), Some(Held(table.output, Word))), placement, names)),
        },
    }
}

// The read into `destination`, which the load can address from (not RBP
// or R13), from the register that holds the index at its narrow width
// (not RSP).
fn Lowered::table_into(self lowered: Lowered, saves: Nat, prog: Prog, table: TableLeaf, destination: Gpr,
    placement: List<Place>, names: Nat) → Option<Emitted> {
    match destination.sib_base() {
        None => None,
        Some(base) => match lowered.file.find(Held(table.index, Narrow(table.bits))) {
            None => None,
            Some(found) => match found.register.sib_index() {
                None => None,
                Some(index) => lowered.table_with(saves, prog, table, base, index, placement, names),
            },
        },
    }
}

// A leaf whose last node reads a table: the nodes before it, then the read
// into the register its place names.
fn File::emit_table(self file: File, saves: Nat, prog: Prog, nodes: List<Node>, table: TableLeaf, placement: List<Place>,
    names: Nat) → Option<Emitted> {
    match lower_nodes(nodes_front(nodes), placement, file) {
        None => None,
        Some(lowered) => match skip_nodes(nodes_front(nodes), placement) {
            Nil => None,
            Cons(place, rest) => match place {
                Into(destination) => lowered.table_into(saves, prog, table, destination, rest, names),
                Folded => None,
                Saving(_) => None,
            },
        },
    }
}

// A word of four bytes from a lent buffer (`WideLoad(4, …)`, the first
// node of its leaf, `function_ir_lower_reads`): refused unless the path
// knows the index below the home's length and some `index + 3` below it
// too (`File::span_bounded`), so all four bytes are inside; then as a byte
// load, the address formed and `MOV r32, [base]`, the word held at width 32.
fn File::wide_at(self file: File, saves: Nat, prog: Prog, home: Lent, wide: WideLeaf, destination: Gpr, placement: List<Place>, names: Nat) →
    Option<Emitted> {
    match file.bounded(wide.index, home.length) && file.span_bounded(wide.index, home.length, 3) {
        False => None,
        True => match file.address(destination, home.base, wide.index) {
            None => None,
            Some(address) => match leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                False => None,
                True => Some(Emitted(At(At(prog, 0, Block(address.code)), 0, asm_dword_load(DwordLoad(destination, destination))),
                    address.file.write(destination, Some(Held(wide.output, Narrow(32)))), placement, names)),
            },
        },
    }
}

// From the first of the buffer's homes that serves, as a byte load does.
fn File::wide_from(self file: File, saves: Nat, prog: Prog, homes: List<Lent>, wide: WideLeaf, destination: Gpr, placement: List<Place>,
    names: Nat) → Option<Emitted> {
    match homes {
        Nil => None,
        Cons(home, rest) => match home.buffer.same(wide.buffer) {
            False => file.wide_from(saves, prog, rest, wide, destination, placement, names),
            True => match file.wide_at(saves, prog, home, wide, destination, placement, names) {
                None => file.wide_from(saves, prog, rest, wide, destination, placement, names),
                Some(emitted) => Some(emitted),
            },
        },
    }
}

// The load into the register its place names, then the nodes after it as
// a block, from the file the load leaves.
fn File::emit_wide(self file: File, saves: Nat, prog: Prog, homes: List<Lent>, nodes: List<Node>, wide: WideLeaf, placement: List<Place>,
    names: Nat) → Option<Emitted> {
    match placement {
        Nil => None,
        Cons(place, rest) => match place {
            Folded => None,
            Saving(_) => None,
            Into(destination) => match file.wide_from(saves, prog, homes, wide, destination, rest, names) {
                None => None,
                Some(loaded) => emit_kept_nodes(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names),
            },
        },
    }
}

// A leaf that reads no buffer: its nodes as a block, or, when the last
// reads a constant table, the nodes before it then the read.
fn emit_blind_leaf(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat) → Option<Emitted> {
    match leaf_table(nodes) {
        None => emit_kept_nodes(saves, prog, file, nodes, placement, names),
        Some(table) => file.emit_table(saves, prog, nodes, table, placement, names),
    }
}

// A leaf that stores nothing: one load of a buffer the scope has a home
// for (`function_ir_lower_reads`), a word of four bytes from one and the
// nodes after it, or nodes that read none.
fn emit_quiet_leaf(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>) → Option<Emitted> {
    match leaf_load(nodes) {
        None => match leaf_wide(nodes) {
            None => match nodes_blind(nodes) { False => None, True => emit_blind_leaf(saves, prog, file, nodes, placement, names) },
            Some(wide) => file.emit_wide(saves, prog, homes, nodes, wide, placement, names),
        },
        Some(load) => file.emit_load(saves, prog, homes, load, placement, names),
    }
}

// A leaf: one store into a buffer the scope has a home for, or nodes that
// store nothing.
fn emit_leaf(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>) → Option<Emitted> {
    match leaf_store(nodes) {
        None => match nodes_quiet(nodes) { False => None, True => emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes) },
        Some(store) => file.emit_store(saves, prog, homes, store, placement, names),
    }
}

// A call over views (docs/native-library-exports-design.md §3.1): the
// nodes that bind each view's base and length, then the call with those
// homes before its arguments. The homes the callee's buffers are checked
// against are the views' (`views_lents`), and the views are checked to lie
// in buffers the scope has homes for (`views_lent`,
// function_ir_lower_views).
fn File::emit_lend(self file: File, saves: Nat, prog: Prog, views: List<View>, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>,
    names, bound: Nat, counts: List<Nat>, homes: List<Lent>) → Option<Emitted> {
    match emit_leaf(saves, prog, file, views_nodes(views), placement, names, homes) {
        None => None,
        Some(first) => match views_lent(views, first.file, homes) {
            False => None,
            True => first.file.emit_call(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound,
                counts, views_lents(views)),
        },
    }
}

// ---------------------------------------------------------------------------
// Loops (round 5)
//
// A loop's code, its four labels the names after `names` (H, C, X, J):
//
//       moves: bound, inputs → counter, state registers
//   H:  TEST counter; JE X
//       body, its file the counter's and the state's
//       TEST exit bit; JE C
//       moves: next → state registers
//       MOV flag, 0
//       JMP J
//   C:  moves: count, next → counter, state registers
//       ADD counter, -1
//       JMP H
//   X:  MOV flag, 1
//   J:
//
// The counter holds the passes left, so the head's test is the bound's. A
// pass's body sees only its own valuation: the head's file holds the state
// and the counter under the parameters' and `count`'s names, and what the
// body leaves (any registers, its calls answered) is read back through its
// file at the exit test and the moves. After the loop the file is the
// outputs' and the exhausted bit's, nothing else: the loop is a barrier.

// One register per parameter, then the counter and the flag; the rest
// place the body.
record LoopRegisters { state: List<Gpr>, counter: Gpr, flag: Gpr, rest: List<Place> }

fn loop_registers(n: Nat, placement: List<Place>) → Option<LoopRegisters> {
    match n {
        Zero => match placement {
            Nil => None,
            Cons(counter, after) => match after {
                Nil => None,
                Cons(flag, rest) => match counter {
                    Folded => None,
                    Saving(_) => None,
                    Into(c) => match flag { Folded => None, Saving(_) => None, Into(f) => Some(LoopRegisters([], c, f, rest)) },
                },
            },
        },
        Succ(m) => match placement {
            Nil => None,
            Cons(place, after) => match place {
                Folded => None,
                Saving(_) => None,
                Into(register) => match loop_registers(m, after) {
                    None => None,
                    Some(registers) => Some(LoopRegisters(Cons(register, registers.state), registers.counter, registers.flag, registers.rest)),
                },
            },
        },
    }
}

// The flag cleared and set, and the counter stepped down.
fn LoopRegisters::clear(self registers: LoopRegisters) → Instruction { MovRI(registers.flag, BitVec::ofNat(0)) }
fn LoopRegisters::mark(self registers: LoopRegisters) → Instruction { MovRI(registers.flag, BitVec::ofNat(1)) }
fn LoopRegisters::step(self registers: LoopRegisters) → Instruction { AddRI8(registers.counter, BitVec::ofNat(255)) }

// The counter and the flag are none of the state's registers nor each
// other, and their instructions keep the callee-saved registers.
fn LoopRegisters::apart(self registers: LoopRegisters, saves: Nat) → Bool {
    registers.counter.misses(registers.state) && (registers.flag.misses(Cons(registers.counter, registers.state)) &&
        (leaves_all([registers.clear()], body_kept(saves)) && (leaves_all([registers.mark()], body_kept(saves)) &&
            leaves_all([registers.step()], body_kept(saves)))))
}

// The code into the loop and the head's file.
record LoopEntry { registers: LoopRegisters, code: List<Instruction>, head: File }

fn loop_entry_with(saves: Nat, registers: LoopRegisters, moves: Lowered, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat) →
    Option<LoopEntry> {
    match input_file(word_ports(Cons(count, parameters)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(head) => match moves.file.outputs_check(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) &&
            (leaves_all(moves.code, body_kept(saves)) && registers.apart(saves)) {
            False => None,
            True => Some(LoopEntry(registers, moves.code, head)),
        },
    }
}

fn File::loop_entry_at(self file: File, saves: Nat, registers: LoopRegisters, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat) →
    Option<LoopEntry> {
    match file.move_outputs(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(moves) => loop_entry_with(saves, registers, moves, inputs, limit, parameters, count),
    }
}

fn File::loop_entry(self file: File, saves: Nat, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, placement: List<Place>) →
    Option<LoopEntry> {
    match loop_registers(parameters.len(), placement) {
        None => None,
        Some(registers) => file.loop_entry_at(saves, registers, inputs, limit, parameters, count),
    }
}

// The code out of a pass: the exit bit's register, the moves to leave and
// to go round, and the file after the loop.
record LoopExit { register: Gpr, leave: List<Instruction>, back: List<Instruction>, out: File }

fn File::loop_exit_out(self file: File, saves: Nat, register: Gpr, leave, back: Lowered, registers: LoopRegisters, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat) → Option<LoopExit> {
    match input_file(Cons(Port(id := exhausted, width := 1), word_ports(outputs)), Cons(registers.flag, registers.state)) {
        None => None,
        Some(out) => match file.check_one(exit, Some(Bit), register) &&
            (leave.file.outputs_check(word_ports(next), registers.state) && (leaves_all(leave.code, body_kept(saves)) &&
                (back.file.outputs_check(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) &&
                    leaves_all(back.code, body_kept(saves))))) {
            False => None,
            True => Some(LoopExit(register, leave.code, back.code, out)),
        },
    }
}

fn File::loop_exit_back(self file: File, saves: Nat, register: Gpr, leave: Lowered, registers: LoopRegisters, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat) → Option<LoopExit> {
    match file.move_outputs(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) {
        None => None,
        Some(back) => file.loop_exit_out(saves, register, leave, back, registers, count, exit, next, outputs, exhausted),
    }
}

fn File::loop_exit(self file: File, saves: Nat, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat) →
    Option<LoopExit> {
    match file.find(Held(exit, Bit)) {
        None => None,
        Some(found) => match file.move_outputs(word_ports(next), registers.state) {
            None => None,
            Some(leave) => file.loop_exit_back(saves, found.register, leave, registers, count, exit, next, outputs, exhausted),
        },
    }
}

// The loop's code from the head (the four labels after `names`).
fn loop_head(prog: Prog, entry: LoopEntry, names: Nat) → Prog { At(At(prog, 0, Block(entry.code)), Succ(names), Block([])) }
fn loop_tested(prog: Prog, entry: LoopEntry, names: Nat) → Prog {
    loop_head(prog, entry, names).branch_label(entry.registers.counter, Succ(Succ(Succ(names))))
}
fn loop_jumped(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(At(pass.branch_label(exit.register, Succ(Succ(names))), 0, Block(exit.leave)), 0, Block([registers.clear()])), 0,
        Jmp(Succ(Succ(Succ(Succ(names))))))
}
fn loop_again(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(At(At(loop_jumped(pass, registers, exit, names), Succ(Succ(names)), Block([])), 0, Block(exit.back)), 0,
        Block([registers.step()])), 0, Jmp(Succ(names)))
}
fn loop_set(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(At(loop_again(pass, registers, exit, names), Succ(Succ(Succ(names))), Block([])), 0, Block([registers.mark()]))
}
fn loop_done(pass: Prog, registers: LoopRegisters, exit: LoopExit, names: Nat) → Prog {
    At(loop_set(pass, registers, exit, names), Succ(Succ(Succ(Succ(names)))), Block([]))
}

fn Emitted::loop_close(self pass: Emitted, saves: Nat, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    names: Nat) → Option<Emitted> {
    match pass.file.loop_exit(saves, registers, count, exit, next, outputs, exhausted) {
        None => None,
        Some(out) => Some(Emitted(loop_done(pass.prog, registers, out, names), out.out, pass.placement, pass.names)),
    }
}

// What a conditional tests: its bit where a register holds it (TEST, the
// second arm where it is zero), else the comparison the file knows it to be
// from a folded node (CMP of its operands' registers, the second arm where
// the comparison fails), the bit never materialised.
record Tested(file: File, condition: Nat) {
    test: Test,
    selects: (values: Valuation()) → (g: Gprs) → file.Represents(values, g) → test.taken(g) = !values(1, condition).head_bit(),
}

fn CompareOp::fails(self op: CompareOp) → ConditionCode { match op { Below => AE, Less => GE, Same => NE } }

theorem CompareOp::fails_holds(self op: CompareOp, flags: Flags): condition_holds(op.fails(), flags) = !op.flag(flags) {
    match op { Below => refl, Less => refl, Same => refl }
}

theorem compare_selects(values: Valuation(), g: Gprs, op: CompareOp, condition, left, right: Nat, a, b: Gpr,
    left_rep: values(64, left) = read_gpr(a, g), right_rep: values(64, right) = read_gpr(b, g),
    holds: op.Holds(values, condition, left, right)):
    Compare(op.fails(), a, b).taken(g) = !values(1, condition).head_bit()
{
    let x = read_gpr(a, g);
    let y = read_gpr(b, g);
    trans(op.fails_holds(sub_flags(x, y)),
        trans(cong_fn<Bool, Bool>(λ c => !c, op.flag_sub(x, y)),
            trans(j(left_rep, λ v _ => !op.apply(v, y) = !op.apply(values(64, left), y), refl),
                trans(j(right_rep, λ v _ => !op.apply(values(64, left), v) = !op.apply(values(64, left), values(64, right)), refl),
                    j(sym(holds), λ w _ => !op.apply(values(64, left), values(64, right)) = !w.head_bit(), refl)))))
}

fn File::compare_test(self file: File, condition: Nat, compared: Comparison,
    known: known_comparison(file.known, condition) = Some(compared)) → Option<Tested(file, condition)> {
    match file.find(Held(compared.left, Word)) {
        None => None,
        Some(a) => match file.find(Held(compared.right, Word)) {
            None => None,
            Some(b) => Some(Tested(Compare(compared.op.fails(), a.register, b.register),
                λ values g represents => compare_selects(values, g, compared.op, condition, compared.left, compared.right,
                    a.register, b.register, a.at.rep(values, g, represents), b.at.rep(values, g, represents),
                    known_comparison_holds(values, condition, compared, file.known, known, represents.right)))),
        },
    }
}

fn File::branch_test(self file: File, condition: Nat) → Option<Tested(file, condition)> {
    match file.find(Held(condition, Bit)) {
        Some(found) => Some(Tested(Nonzero(found.register),
            λ values g represents => found.register.tests_zero_bit(g, values(1, condition), found.at.rep(values, g, represents)))),
        None => match known: known_comparison(file.known, condition) {
            None => None,
            Some(compared) => file.compare_test(condition, compared, known),
        },
    }
}

// Round 2's `emit` with calls of the functions below `bound`, and loads of
// the buffers the scope has homes for: `homes` here, the ones a loop
// carries inside it (`loop_carried`), and what a region leaves after it
// (`StructuredRegion::lends`). The arm of a conditional taken where its bit
// is set knows that (`Truth`), which is what admits a load there.
fn StructuredRegion::emit_calls(self region: StructuredRegion, saves: Nat, prog: Prog, file: File, placement: List<Place>, names, bound: Nat,
    counts: List<Nat>, homes: List<Lent>) → Option<Emitted> {
    match region {
        Dataflow(body) => emit_leaf(saves, prog, file, body.nodes, placement, names, homes),
        Sequence(prefix, continuation) => match emit_leaf(saves, prog, file, prefix.nodes, placement, names, homes) {
            None => None,
            Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, homes),
        },
        Compose(prefix, continuation) => match prefix.emit_calls(saves, prog, file, placement, names, bound, counts, homes) {
            None => None,
            Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends(homes)),
        },
        Conditional(_, condition, _, _, when_true, when_false) => match file.branch_test(condition) {
            None => None,
            Some(tested) => match when_true.emit_calls(saves, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)), placement,
                Succ(Succ(names)), bound, counts, homes) {
                None => None,
                Some(yes) => match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound,
                    counts, homes) {
                    None => None,
                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                },
            },
        },
        Lend(views, callee, arguments, result) =>
            file.emit_lend(saves, prog, views, callee, arguments, result, placement, names, bound, counts, homes),
        Call(callee, arguments, result) => file.emit_call(prog, callee, arguments, result, placement, names, bound, counts, homes),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) =>
            match file.loop_entry(saves, inputs, limit, parameters, count, placement) {
                None => None,
                Some(entry) => match body.emit_calls(saves, loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                    Succ(Succ(Succ(Succ(names)))), bound, counts, carried_homes(loop_carried(homes, inputs, parameters, next))) {
                    None => None,
                    Some(pass) => pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                },
            },
    }
}

// ---------------------------------------------------------------------------
// What emitting grows

fn Grows(prog: Prog, out: Option<Emitted>) → Type { out.All(λ (emitted: Emitted) => prog.Within(emitted.prog)) }

theorem grows_trans(prog: Prog, first: Emitted, within: prog.Within(first.prog), second: Option<Emitted>):
    Grows(first.prog, second) → Grows(prog, second) {
    match second {
        None => λ _ => trivial,
        Some(out) => λ grown => prog.within_trans(first.prog, out.prog, within, grown),
    }
}

theorem emit_kept_nodes_grows(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    Grows(prog, emit_kept_nodes(saves, prog, file, nodes, placement, names)) {
    match lower_nodes(nodes, placement, file) {
        None => trivial,
        Some(lowered) => match leaves_all(lowered.code, body_kept(saves)) {
            False => trivial,
            True => prog.within_then(0, Block(lowered.code)),
        },
    }
}

theorem File::load_at_grows(self file: File, saves: Nat, prog: Prog, home: Lent, load: Load, destination: Gpr, placement: List<Place>, names: Nat):
    Grows(prog, file.load_at(saves, prog, home, load, destination, placement, names)) {
    match file.bounded(load.index, home.length) {
        False => trivial,
        True => match file.address(destination, home.base, load.index) {
            None => trivial,
            Some(address) => match leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                False => trivial,
                True => prog.within_step(At(prog, 0, Block(address.code)), 0, LoadByte(ByteLoad(destination, destination)),
                    prog.within_then(0, Block(address.code))),
            },
        },
    }
}

theorem File::load_from_grows(self file: File, saves: Nat, prog: Prog, load: Load, destination: Gpr, placement: List<Place>, names: Nat,
    homes: List<Lent>): Grows(prog, file.load_from(saves, prog, homes, load, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => match home.buffer.same(load.buffer) {
            False => file.load_from_grows(saves, prog, load, destination, placement, names, rest),
            True => (match file.load_at(saves, prog, home, load, destination, placement, names) as λ e => Grows(prog, e) →
                Grows(prog, match e {
                    None => file.load_from(saves, prog, rest, load, destination, placement, names),
                    Some(emitted) => Some(emitted),
                }) {
                None => λ _ => file.load_from_grows(saves, prog, load, destination, placement, names, rest),
                Some(emitted) => λ grown => grown,
            })(file.load_at_grows(saves, prog, home, load, destination, placement, names)),
        },
    }
}

// The code of a table read grows the program it follows.
theorem table_within(prog: Prog, code: List<Instruction>, base: SibBase, index: SibIndex, entries: List<Nat>):
    prog.Within(table_read_prog(At(prog, 0, Block(code)), base, index, entries)) {
    let formed = At(prog, 0, Block(code));
    let p1 = At(formed, 0, table_lea(base.gpr()));
    let p2 = At(p1, 0, table_jump(8 * entries.len()));
    let p3 = At(p2, 0, table_piece(entries));
    prog.within_step(p3, 0, asm_indexed_load(table_read_load(base, index)),
        prog.within_step(p2, 0, table_piece(entries),
            prog.within_step(p1, 0, table_jump(8 * entries.len()),
                prog.within_step(formed, 0, table_lea(base.gpr()), prog.within_then(0, Block(code))))))
}

theorem Lowered::table_with_grows(self lowered: Lowered, saves: Nat, prog: Prog, table: TableLeaf, base: SibBase, index: SibIndex,
    placement: List<Place>, names: Nat): Grows(prog, lowered.table_with(saves, prog, table, base, index, placement, names)) {
    match lowered.file.found_at(Held(table.index, Narrow(table.bits)), index.gpr()) {
        None => trivial,
        Some(_) => match table.fits() && (!base.gpr().same(index.gpr()) &&
            (leaves_all(lowered.code, body_kept(saves)) && base.gpr().apart(body_kept(saves)))) {
            False => trivial,
            True => table_within(prog, lowered.code, base, index, table.entries),
        },
    }
}

theorem Lowered::table_into_grows(self lowered: Lowered, saves: Nat, prog: Prog, table: TableLeaf, destination: Gpr,
    placement: List<Place>, names: Nat): Grows(prog, lowered.table_into(saves, prog, table, destination, placement, names)) {
    match destination.sib_base() {
        None => trivial,
        Some(base) => match lowered.file.find(Held(table.index, Narrow(table.bits))) {
            None => trivial,
            Some(found) => match found.register.sib_index() {
                None => trivial,
                Some(index) => lowered.table_with_grows(saves, prog, table, base, index, placement, names),
            },
        },
    }
}

theorem File::emit_table_grows(self file: File, saves: Nat, prog: Prog, nodes: List<Node>, table: TableLeaf, placement: List<Place>,
    names: Nat): Grows(prog, file.emit_table(saves, prog, nodes, table, placement, names)) {
    match lower_nodes(nodes_front(nodes), placement, file) {
        None => trivial,
        Some(lowered) => match skip_nodes(nodes_front(nodes), placement) {
            Nil => trivial,
            Cons(place, rest) => match place {
                Into(destination) => lowered.table_into_grows(saves, prog, table, destination, rest, names),
                Folded => trivial,
                Saving(_) => trivial,
            },
        },
    }
}

theorem emit_blind_leaf_grows(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    Grows(prog, emit_blind_leaf(saves, prog, file, nodes, placement, names)) {
    match leaf_table(nodes) {
        None => emit_kept_nodes_grows(saves, prog, file, nodes, placement, names),
        Some(table) => file.emit_table_grows(saves, prog, nodes, table, placement, names),
    }
}

theorem File::wide_at_grows(self file: File, saves: Nat, prog: Prog, home: Lent, wide: WideLeaf, destination: Gpr, placement: List<Place>,
    names: Nat): Grows(prog, file.wide_at(saves, prog, home, wide, destination, placement, names)) {
    match file.bounded(wide.index, home.length) && file.span_bounded(wide.index, home.length, 3) {
        False => trivial,
        True => match file.address(destination, home.base, wide.index) {
            None => trivial,
            Some(address) => match leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                False => trivial,
                True => prog.within_step(At(prog, 0, Block(address.code)), 0, asm_dword_load(DwordLoad(destination, destination)),
                    prog.within_then(0, Block(address.code))),
            },
        },
    }
}

theorem File::wide_from_grows(self file: File, saves: Nat, prog: Prog, wide: WideLeaf, destination: Gpr, placement: List<Place>, names: Nat,
    homes: List<Lent>): Grows(prog, file.wide_from(saves, prog, homes, wide, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => match home.buffer.same(wide.buffer) {
            False => file.wide_from_grows(saves, prog, wide, destination, placement, names, rest),
            True => (match file.wide_at(saves, prog, home, wide, destination, placement, names) as λ e => Grows(prog, e) →
                Grows(prog, match e {
                    None => file.wide_from(saves, prog, rest, wide, destination, placement, names),
                    Some(emitted) => Some(emitted),
                }) {
                None => λ _ => file.wide_from_grows(saves, prog, wide, destination, placement, names, rest),
                Some(emitted) => λ grown => grown,
            })(file.wide_at_grows(saves, prog, home, wide, destination, placement, names)),
        },
    }
}

theorem File::emit_wide_grows(self file: File, saves: Nat, prog: Prog, homes: List<Lent>, nodes: List<Node>, wide: WideLeaf,
    placement: List<Place>, names: Nat): Grows(prog, file.emit_wide(saves, prog, homes, nodes, wide, placement, names)) {
    match placement {
        Nil => trivial,
        Cons(place, rest) => match place {
            Folded => trivial,
            Saving(_) => trivial,
            Into(destination) => (match file.wide_from(saves, prog, homes, wide, destination, rest, names) as λ e => Grows(prog, e) →
                Grows(prog, match e {
                    None => None,
                    Some(loaded) => emit_kept_nodes(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names),
                }) {
                None => λ _ => trivial,
                Some(loaded) => λ grown => grows_trans(prog, loaded, grown,
                    emit_kept_nodes(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names),
                    emit_kept_nodes_grows(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names)),
            })(file.wide_from_grows(saves, prog, wide, destination, rest, names, homes)),
        },
    }
}

theorem emit_quiet_leaf_grows(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>):
    Grows(prog, emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes)) {
    match leaf_load(nodes) {
        None => match leaf_wide(nodes) {
            None => match nodes_blind(nodes) { False => trivial, True => emit_blind_leaf_grows(saves, prog, file, nodes, placement, names) },
            Some(wide) => file.emit_wide_grows(saves, prog, homes, nodes, wide, placement, names),
        },
        Some(load) => match placement as λ p => Grows(prog, file.emit_load(saves, prog, homes, load, p, names)) {
            Nil => trivial,
            Cons(place, rest) => match place as λ q => Grows(prog, file.emit_load(saves, prog, homes, load, Cons(q, rest), names)) {
                Folded => trivial,
                Saving(_) => trivial,
                Into(destination) => file.load_from_grows(saves, prog, load, destination, rest, names, homes),
            },
        },
    }
}

theorem File::store_at_grows(self file: File, saves: Nat, prog: Prog, home: Lent, store: Store, destination: Gpr, placement: List<Place>, names: Nat):
    Grows(prog, file.store_at(saves, prog, home, store, destination, placement, names)) {
    match file.bounded(store.index, home.length) {
        False => trivial,
        True => match file.address(destination, home.base, store.index) {
            None => trivial,
            Some(address) => match address.file.find(Held(store.value, Word)) {
                None => trivial,
                Some(source) => match (leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves))) &&
                    store_base_plain(destination) {
                    False => trivial,
                    True => prog.within_step(At(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register))), 0,
                        LoadByte(ByteLoad(destination, destination)),
                        prog.within_step(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register)),
                            prog.within_then(0, Block(address.code)))),
                },
            },
        },
    }
}

theorem File::store_from_grows(self file: File, saves: Nat, prog: Prog, store: Store, destination: Gpr, placement: List<Place>, names: Nat,
    homes: List<Lent>): Grows(prog, file.store_from(saves, prog, homes, store, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => match home.buffer.same(store.buffer) {
            False => file.store_from_grows(saves, prog, store, destination, placement, names, rest),
            True => (match file.store_at(saves, prog, home, store, destination, placement, names) as λ e => Grows(prog, e) →
                Grows(prog, match e {
                    None => file.store_from(saves, prog, rest, store, destination, placement, names),
                    Some(emitted) => Some(emitted),
                }) {
                None => λ _ => file.store_from_grows(saves, prog, store, destination, placement, names, rest),
                Some(emitted) => λ grown => grown,
            })(file.store_at_grows(saves, prog, home, store, destination, placement, names)),
        },
    }
}

theorem emit_leaf_grows(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>):
    Grows(prog, emit_leaf(saves, prog, file, nodes, placement, names, homes)) {
    match leaf_store(nodes) {
        None => match nodes_quiet(nodes) { False => trivial, True => emit_quiet_leaf_grows(saves, prog, file, nodes, placement, names, homes) },
        Some(store) => match placement as λ p => Grows(prog, file.emit_store(saves, prog, homes, store, p, names)) {
            Nil => trivial,
            Cons(place, rest) => match place as λ q => Grows(prog, file.emit_store(saves, prog, homes, store, Cons(q, rest), names)) {
                Folded => trivial,
                Saving(_) => trivial,
                Into(destination) => file.store_from_grows(saves, prog, store, destination, rest, names, homes),
            },
        },
    }
}

theorem File::emit_call_grows(self file: File, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>,
    names, bound: Nat, counts: List<Nat>, homes: List<Lent>):
    Grows(prog, file.emit_call(prog, callee, arguments, result, placement, names, bound, counts, homes)) {
    let staged = file.write(Rsp, None);
    let ports = word_ports(arguments.take(6));
    let order = staged.call_moves(arguments.take(6));
    match Succ(callee).leb(bound) && (args_lend(homes, lent_count(counts, callee), 0, arguments) && arguments.drop(6).len().leb(2)) {
        False => trivial,
        True => match staged.sources(arguments.drop(6)) {
            None => trivial,
            Some(sources) => match sources.len().same(arguments.drop(6).len()) && staged.outputs_check(word_ports(arguments.drop(6)), sources) {
                False => trivial,
                True => match staged.move_outputs(ArgumentMove::ports(order), ArgumentMove::registers(order)) {
                    None => trivial,
                    Some(moves) => match moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                        False => trivial,
                        True => call_within(prog, sources, moves.code, callee),
                    },
                },
            },
        },
    }
}

theorem loop_close_grows(saves: Nat, prog: Prog, entry: LoopEntry, names: Nat, pass: Emitted, grown: loop_tested(prog, entry, names).Within(pass.prog),
    count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    Grows(prog, pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names)) {
    let tested = loop_tested(prog, entry, names);
    let opened: prog.Within(tested) = Exists(4, refl);
    match pass.file.loop_exit(saves, entry.registers, count, exit, next, outputs, exhausted) {
        None => trivial,
        Some(out) => {
            let closed: pass.prog.Within(loop_done(pass.prog, entry.registers, out, names)) = Exists(12, refl);
            prog.within_trans(tested, loop_done(pass.prog, entry.registers, out, names), opened,
                tested.within_trans(pass.prog, loop_done(pass.prog, entry.registers, out, names), grown, closed))
        },
    }
}

theorem File::emit_lend_grows(self file: File, saves: Nat, prog: Prog, views: List<View>, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names, bound: Nat, counts: List<Nat>, homes: List<Lent>):
    Grows(prog, file.emit_lend(saves, prog, views, callee, arguments, result, placement, names, bound, counts, homes)) {
    (match emit_leaf(saves, prog, file, views_nodes(views), placement, names, homes) as λ e => Grows(prog, e) → Grows(prog, match e {
        None => None,
        Some(first) => match views_lent(views, first.file, homes) {
            False => None,
            True => first.file.emit_call(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound,
                counts, views_lents(views)),
        },
    }) {
        None => λ _ => trivial,
        Some(first) => λ grown => match views_lent(views, first.file, homes) {
            False => trivial,
            True => grows_trans(prog, first, grown,
                first.file.emit_call(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound, counts,
                    views_lents(views)),
                first.file.emit_call_grows(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound,
                    counts, views_lents(views))),
        },
    })(emit_leaf_grows(saves, prog, file, views_nodes(views), placement, names, homes))
}

theorem StructuredRegion::emit_calls_grows(self region: StructuredRegion, saves: Nat, bound: Nat, counts: List<Nat>):
    (homes: List<Lent>) → (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    Grows(prog, region.emit_calls(saves, prog, file, placement, names, bound, counts, homes)) {
    match region {
        Dataflow(body) => λ homes prog file placement names => emit_leaf_grows(saves, prog, file, body.nodes, placement, names, homes),
        Sequence(prefix, continuation) => λ homes prog file placement names =>
            (match emit_leaf(saves, prog, file, prefix.nodes, placement, names, homes) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, homes),
            }) {
                None => λ _ => trivial,
                Some(first) => λ grown => grows_trans(prog, first, grown,
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, homes),
                    continuation.emit_calls_grows(saves, bound, counts, homes, first.prog, first.file, first.placement, first.names)),
            })(emit_leaf_grows(saves, prog, file, prefix.nodes, placement, names, homes)),
        Compose(prefix, continuation) => λ homes prog file placement names =>
            (match prefix.emit_calls(saves, prog, file, placement, names, bound, counts, homes) as λ e => Grows(prog, e) → Grows(prog, match e {
                None => None,
                Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends(homes)),
            }) {
                None => λ _ => trivial,
                Some(first) => λ grown => grows_trans(prog, first, grown,
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends(homes)),
                    continuation.emit_calls_grows(saves, bound, counts, prefix.lends(homes), first.prog, first.file, first.placement, first.names)),
            })(prefix.emit_calls_grows(saves, bound, counts, homes, prog, file, placement, names)),
        Conditional(_, condition, _, _, when_true, when_false) => λ homes prog file placement names =>
            match file.branch_test(condition) {
                None => trivial,
                Some(tested) => {
                    let test = tested.test;
                    let branched = prog.branched(test, Succ(names));
                    (match when_true.emit_calls(saves, branched, file.know(Truth(condition)), placement, Succ(Succ(names)), bound, counts, homes) as λ y =>
                        Grows(branched, y) → Grows(prog, match y {
                            None => None,
                            Some(yes) => match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound, counts, homes) {
                                None => None,
                                Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                            },
                        }) {
                        None => λ _ => trivial,
                        Some(yes) => λ yes_grown => {
                            let second = yes.prog.else_label(Succ(names), Succ(Succ(names)));
                            (match when_false.emit_calls(saves, second, file.know(Falsity(condition)), yes.placement, yes.names, bound, counts, homes) as λ n =>
                                Grows(second, n) → Grows(prog, match n {
                                    None => None,
                                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                }) {
                                None => λ _ => trivial,
                                Some(no) => λ no_grown => {
                                    let to_branch = prog.within_step(prog.tested(test), 0, Jcc(test.cc(), Succ(names)),
                                        prog.within_then(0, Block([test.instruction()])));
                                    let to_second = prog.within_step(At(yes.prog, 0, Jmp(Succ(Succ(names)))), Succ(names), Block([]),
                                        prog.within_step(yes.prog, 0, Jmp(Succ(Succ(names))), prog.within_trans(branched, yes.prog, to_branch, yes_grown)));
                                    prog.within_step(no.prog, Succ(Succ(names)), Block([]), prog.within_trans(second, no.prog, to_second, no_grown))
                                },
                            })(when_false.emit_calls_grows(saves, bound, counts, homes, second, file.know(Falsity(condition)), yes.placement, yes.names))
                        },
                    })(when_true.emit_calls_grows(saves, bound, counts, homes, branched, file.know(Truth(condition)), placement, Succ(Succ(names))))
                },
            },
        Lend(views, callee, arguments, result) => λ homes prog file placement names =>
            file.emit_lend_grows(saves, prog, views, callee, arguments, result, placement, names, bound, counts, homes),
        Call(callee, arguments, result) => λ homes prog file placement names =>
            file.emit_call_grows(prog, callee, arguments, result, placement, names, bound, counts, homes),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) => λ homes prog file placement names =>
            match file.loop_entry(saves, inputs, limit, parameters, count, placement) {
                None => trivial,
                Some(entry) =>
                    (match body.emit_calls(saves, loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))),
                        bound, counts, carried_homes(loop_carried(homes, inputs, parameters, next))) as λ b => Grows(loop_tested(prog, entry, names), b) → Grows(prog, match b {
                        None => None,
                        Some(pass) => pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                    }) {
                        None => λ _ => trivial,
                        Some(pass) => λ grown => loop_close_grows(saves, prog, entry, names, pass, grown, count, exit, next, outputs, exhausted),
                    })(body.emit_calls_grows(saves, bound, counts, carried_homes(loop_carried(homes, inputs, parameters, next)), loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                        Succ(Succ(Succ(Succ(names)))))),
            },
    }
}

// A block that keeps the file's description and the callee-saved registers.
theorem kept_block_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts: Type, lowered: Lowered,
    keeps: Keeps<M>(values, file, facts, lowered), leaves: leaves_all(lowered.code, body_kept(saves)).IsTrue(),
    placement: List<Place>, names: Nat):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, facts, Emitted(At(prog, 0, Block(lowered.code)), lowered.file, placement, names)) {
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
    let post = λ (g: Gprs) (m: M) => lowered.file.Represents(values, g) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m));
    ⟨prog.within_then(0, Block(lowered.code)),
     λ within => site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(lowered.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), within.witness, prog, 0, lowered.code, within.proof,
            site.program.block_reads_at(laid, within.witness, prog, 0, lowered.code, within.proof),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => ⟨keeps(x, held.left.left, held.left.right),
                ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(lowered.code, x).gprs, held.right.left,
                    execute_block_kept<M>(lowered.code, x, body_kept(saves), leaves)), held.right.right⟩⟩))⟩
}

theorem is_true_of_eq(b: Bool, same: b = True): b.IsTrue() { j(sym(same), λ c _ => c.IsTrue(), trivial) }

theorem emit_kept_nodes_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), emit_kept_nodes(saves, prog, file, nodes, placement, names)) {
    (match lower_nodes(nodes, placement, file) as λ lowered =>
        MayKeep<M>(values, file, NodesHold(values, nodes), lowered) →
        MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), match lowered {
            None => None,
            Some(l) => match leaves_all(l.code, body_kept(saves)) {
                False => None,
                True => Some(Emitted(At(prog, 0, Block(l.code)), l.file, skip_nodes(nodes, placement), names)),
            },
        }) {
        None => λ _ => trivial,
        Some(lowered) => λ keeps =>
            match left: leaves_all(lowered.code, body_kept(saves)) {
                False => trivial,
                True => kept_block_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, NodesHold(values, nodes), lowered,
                    keeps, is_true_of_eq(leaves_all(lowered.code, body_kept(saves)), left), skip_nodes(nodes, placement), names),
            },
    })(lower_nodes_keeps<M>(values, nodes, placement, file))
}

// Facts that follow from the ones a body starts with.
theorem emits_in_weaken<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts, stronger: Type, implies: stronger → facts, out: Emitted,
    emits: EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, facts, out)):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, stronger, out) {
    ⟨emits.left, λ within => site.moves_weaken(stack.writes, prog_len(prog), prog_len(out.prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.Framed(saves, d, s0, s),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ stronger) ∧ stack.Framed(saves, d, s0, s),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
        emits.right(within), λ s held => ⟨⟨held.left.left, implies(held.left.right)⟩, held.right⟩, λ t held => held)⟩
}

theorem may_emit_in_weaken<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, facts, stronger: Type, implies: stronger → facts, out: Option<Emitted>):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, out) → MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, stronger, out) {
    match out {
        None => λ _ => trivial,
        Some(emitted) => λ emits => emits_in_weaken<M>(saves, site, stack, values, d, s0, prog, file, facts, stronger, implies, emitted, emits),
    }
}

// ---------------------------------------------------------------------------
// A load of a lent buffer (docs/native-one-compiler-design.md §2.3)

// The address formed, then the byte loaded over it: the home says where the
// buffer lies and how long it is, the path that the index is inside, and
// the buffer is lent to this body, so the byte read is the buffer's
// whatever the body has stored in its own frame.
theorem load_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    values: Valuation(), d: Nat, s0: MachineState<M>, lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, file: File,
    home: Lent, load: Load, destination: Gpr, placement: List<Place>, names: Nat, same: home.buffer = load.buffer,
    bounded: file.bounded(load.index, home.length).IsTrue(), address: Lowered,
    addressed: Addressed<M>(values, file, destination, home.base, load.index, address),
    kept: leaves_all(address.code, body_kept(saves)).IsTrue() ∧ destination.apart(body_kept(saves)).IsTrue()):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file,
        load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers),
        Emitted(At(At(prog, 0, Block(address.code)), 0, LoadByte(ByteLoad(destination, destination))),
            address.file.write(destination, Some(Held(load.output, Word))), placement, names)) {
    let facts = load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers);
    let formed = At(prog, 0, Block(address.code));
    let the_load = ByteLoad(destination, destination);
    let loaded = At(formed, 0, LoadByte(the_load));
    let out_file = address.file.write(destination, Some(Held(load.output, Word)));
    let index = values(64, load.index);
    let sum = values(64, home.base).add(index);
    let a = address_of(lending.addresses, home.buffer);
    let xs = buffer_bytes(lending.buffers, home.buffer);
    let framed = λ (g: Gprs) (m: M) => Kept(body_kept(saves), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧ framed(g, m);
    let mid = λ (g: Gprs) (m: M) => ((address.file.Represents(values, g) ∧ (read_gpr(destination, g) = sum)) ∧
        (facts ∧ (index.toNat() < values(64, home.length).toNat()))) ∧ framed(g, m);
    ⟨prog.within_step(formed, 0, LoadByte(the_load), prog.within_then(0, Block(address.code))),
     λ within => {
        let formed_in = formed.within_before(0, LoadByte(the_load), site.program, within);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(formed), prog_len(loaded),
            λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (s: MachineState<M>) => mid(s.gprs, s.memory),
            λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
            site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(address.code), pre, mid,
                λ memory => site.runs_block(site.program.laid_out_fits(laid), formed_in.witness, prog, 0, address.code, formed_in.proof,
                    site.program.block_reads_at(laid, formed_in.witness, prog, 0, address.code, formed_in.proof),
                    λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => mid(g, memory),
                    λ x held => ⟨⟨addressed(x, held.left.left),
                            ⟨held.left.right, file.bounded_sound(values, x.gprs, load.index, home.length, held.left.left, bounded)⟩⟩,
                        ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(address.code, x).gprs, held.right.left,
                            execute_block_kept<M>(address.code, x, body_kept(saves), kept.left)), held.right.right⟩⟩)),
            site.moves_load_byte(stack.writes, site.program.laid_out_fits(laid), within.witness, formed, 0, the_load, within.proof,
                λ (s: MachineState<M>) => mid(s.gprs, s.memory),
                λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
                λ s held => {
                    let home_holds = held.left.right.left.right;
                    let short: (values(64, home.length).toNat() <= xs.len()) =
                        j(sym(home_holds.right), λ w _ => w.toNat() <= xs.len(), BitVec::toNat_ofNat_le(64, xs.len()));
                    let inside: (index.toNat() < xs.len()) =
                        Nat::le_trans(Succ(index.toNat()), values(64, home.length).toNat(), xs.len(), held.left.right.right, short);
                    let reads = stack.lent_address(d + 64, a, xs, s0.memory, lent(home.buffer), index, s.memory, held.right.right, inside);
                    let at: (read_gpr(destination, s.gprs) = a.add(index)) =
                        trans(held.left.left.right, cong_fn(λ (b: BitVec(64)) => b.add(index), home_holds.left));
                    let byte = buffer_byte(lending.buffers, home.buffer, index.toNat());
                    let written: (values(64, load.output) = byte.zero_extend(56)) =
                        j(sym(same), λ b _ => values(64, load.output) = byte_word(buffer_byte(lending.buffers, b, index.toNat())),
                            held.left.right.left.left);
                    Exists(byte, ⟨j(sym(at), λ x _ => x.toNat() < Nat::pow(2, 47), reads.left),
                        ⟨j(sym(at), λ x _ => site.data.read(s.memory, x) = Some(byte),
                            trans(reads.right, buffer_byte_at(lending.buffers, home.buffer, index.toNat(), inside))),
                         ⟨address.file.represents_write(values, s.gprs, destination, Some(Held(load.output, Word)), byte.zero_extend(56),
                            held.left.left.left, written),
                          ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(destination, byte.zero_extend(56), s.gprs), held.right.left,
                            kept_write(body_kept(saves), destination, byte.zero_extend(56), s.gprs, kept.right)), held.right.right⟩⟩⟩⟩)
                }))
     }⟩
}

theorem File::load_at_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>,
    lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, home: Lent, load: Load, destination: Gpr, placement: List<Place>,
    names: Nat, same: home.buffer = load.buffer):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers),
        file.load_at(saves, prog, home, load, destination, placement, names)) {
    let facts = load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers);
    match bounded: file.bounded(load.index, home.length) {
        False => trivial,
        True => (match file.address(destination, home.base, load.index) as λ a =>
            a.All(λ (out: Lowered) => Addressed<M>(values, file, destination, home.base, load.index, out)) →
            MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, match a {
                None => None,
                Some(address) => match leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                    False => None,
                    True => Some(Emitted(At(At(prog, 0, Block(address.code)), 0, LoadByte(ByteLoad(destination, destination))),
                        address.file.write(destination, Some(Held(load.output, Word))), placement, names)),
                },
            }) {
            None => λ _ => trivial,
            Some(address) => λ addressed =>
                match kept: leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                    False => trivial,
                    True => load_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, file, home, load, destination, placement,
                        names, same, is_true_of_eq(file.bounded(load.index, home.length), bounded), address, addressed,
                        Bool::is_true_and(leaves_all(address.code, body_kept(saves)), destination.apart(body_kept(saves)),
                            is_true_of_eq(leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)), kept))),
                },
        })(file.address_addressed<M>(values, destination, home.base, load.index)),
    }
}

theorem File::load_from_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>,
    lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, load: Load, destination: Gpr, placement: List<Place>, names: Nat,
    homes: List<Lent>):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        load.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
        file.load_from(saves, prog, homes, load, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => {
            let all = load.Holds(values, lending.buffers) ∧ HomesHold(Cons(home, rest), values, lending.addresses, lending.buffers);
            let later = may_emit_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
                load.Holds(values, lending.buffers) ∧ HomesHold(rest, values, lending.addresses, lending.buffers), all,
                λ held => ⟨held.left, held.right.right⟩, file.load_from(saves, prog, rest, load, destination, placement, names),
                file.load_from_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, load, destination, placement, names, rest));
            match same: home.buffer.same(load.buffer) {
                False => later,
                True => (match file.load_at(saves, prog, home, load, destination, placement, names) as λ e =>
                    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
                        load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers), e) →
                    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, all, match e {
                        None => file.load_from(saves, prog, rest, load, destination, placement, names),
                        Some(emitted) => Some(emitted),
                    }) {
                    None => λ _ => later,
                    Some(emitted) => λ emits => emits_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
                        load.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers), all,
                        λ held => ⟨held.left, held.right.left⟩, emitted, emits),
                })(file.load_at_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, home, load, destination, placement, names,
                    home.buffer.same_sound(load.buffer, same))),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A word of four bytes from a lent buffer

// One piece of code after another, the second from the file the first
// leaves; the second's facts are carried through the first.
theorem emits_in_seq<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>,
    prog: Prog, file: File, First, Second: Type, first, out: Emitted,
    first_emits: EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, First, first),
    second_emits: EmitsIn<M>(saves, site, stack, values, d, s0, first.prog, first.file, Second, out)):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, First ∧ Second, out) {
    ⟨prog.within_trans(first.prog, out.prog, first_emits.left, second_emits.left),
     λ within => site.moves_trans(stack.writes, prog_len(prog), prog_len(first.prog), prog_len(out.prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (First ∧ Second)) ∧ stack.Framed(saves, d, s0, s),
        λ (x: MachineState<M>) => (first.file.Represents(values, x.gprs) ∧ Second) ∧ stack.Framed(saves, d, s0, x),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
        site.moves_weaken(stack.writes, prog_len(prog), prog_len(first.prog),
            λ (x: MachineState<M>) => ((file.Represents(values, x.gprs) ∧ First) ∧ stack.Framed(saves, d, s0, x)) ∧ Second,
            λ (t: MachineState<M>) => (first.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t)) ∧ Second,
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ (First ∧ Second)) ∧ stack.Framed(saves, d, s0, s),
            λ (x: MachineState<M>) => (first.file.Represents(values, x.gprs) ∧ Second) ∧ stack.Framed(saves, d, s0, x),
            site.moves_carry(stack.writes, prog_len(prog), prog_len(first.prog),
                λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ First) ∧ stack.Framed(saves, d, s0, x),
                λ (t: MachineState<M>) => first.file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t), Second,
                first_emits.right(first.prog.within_trans(out.prog, site.program, second_emits.left, within))),
            λ s h => ⟨⟨⟨h.left.left, h.left.right.left⟩, h.right⟩, h.left.right.right⟩,
            λ t h => ⟨⟨h.left.left, h.right⟩, h.left.right⟩),
        second_emits.right(within))⟩
}

// The address formed, then the doubleword loaded over it. The path knows
// the index below the length and `index + 3` below it too; the span lent
// lies below the canonical boundary, so the length is far below `2^64` and
// the sum did not wrap: all four bytes are the buffer's.
theorem wide_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    values: Valuation(), d: Nat, s0: MachineState<M>, lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, file: File,
    home: Lent, wide: WideLeaf, destination: Gpr, placement: List<Place>, names: Nat, same: home.buffer = wide.buffer,
    bounded: file.bounded(wide.index, home.length).IsTrue(), spanned: file.span_bounded(wide.index, home.length, 3).IsTrue(),
    address: Lowered, addressed: Addressed<M>(values, file, destination, home.base, wide.index, address),
    kept: leaves_all(address.code, body_kept(saves)).IsTrue() ∧ destination.apart(body_kept(saves)).IsTrue()):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file,
        wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers),
        Emitted(At(At(prog, 0, Block(address.code)), 0, asm_dword_load(DwordLoad(destination, destination))),
            address.file.write(destination, Some(Held(wide.output, Narrow(32)))), placement, names)) {
    let facts = wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers);
    let formed = At(prog, 0, Block(address.code));
    let the_load = DwordLoad(destination, destination);
    let loaded = At(formed, 0, asm_dword_load(the_load));
    let out_file = address.file.write(destination, Some(Held(wide.output, Narrow(32))));
    let index = values(64, wide.index);
    let sum = values(64, home.base).add(index);
    let a = address_of(lending.addresses, home.buffer);
    let xs = buffer_bytes(lending.buffers, home.buffer);
    let framed = λ (g: Gprs) (m: M) => Kept(body_kept(saves), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧ framed(g, m);
    let mid = λ (g: Gprs) (m: M) => ((address.file.Represents(values, g) ∧ (read_gpr(destination, g) = sum)) ∧
        (facts ∧ (index.toNat() + 3 < values(64, home.length).toNat()))) ∧ framed(g, m);
    let top: (Nat::pow(2, 47) < Nat::pow(2, 64)) = Nat::leb_sound(Succ(Nat::pow(2, 47)), Nat::pow(2, 64), trivial);
    ⟨prog.within_step(formed, 0, asm_dword_load(the_load), prog.within_then(0, Block(address.code))),
     λ within => {
        let formed_in = formed.within_before(0, asm_dword_load(the_load), site.program, within);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(formed), prog_len(loaded),
            λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (s: MachineState<M>) => mid(s.gprs, s.memory),
            λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
            site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(address.code), pre, mid,
                λ memory => site.runs_block(site.program.laid_out_fits(laid), formed_in.witness, prog, 0, address.code, formed_in.proof,
                    site.program.block_reads_at(laid, formed_in.witness, prog, 0, address.code, formed_in.proof),
                    λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => mid(g, memory),
                    λ x held => {
                        let home_holds = held.left.right.right;
                        let short: (values(64, home.length).toNat() <= xs.len()) =
                            j(sym(home_holds.right), λ w _ => w.toNat() <= xs.len(), BitVec::toNat_ofNat_le(64, xs.len()));
                        let readable = lent(home.buffer)(memory, held.right.right);
                        let below: (index.toNat() < values(64, home.length).toNat()) =
                            file.bounded_sound(values, x.gprs, wide.index, home.length, held.left.left, bounded);
                        let no_wrap: (index.toNat() + 3 < Nat::pow(2, 64)) = omega(below, short, readable.left, top);
                        ⟨⟨addressed(x, held.left.left),
                            ⟨held.left.right,
                             file.span_bounded_sound(values, x.gprs, wide.index, home.length, 3, held.left.left, no_wrap, spanned)⟩⟩,
                         ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(address.code, x).gprs, held.right.left,
                            execute_block_kept<M>(address.code, x, body_kept(saves), kept.left)), held.right.right⟩⟩
                    })),
            site.moves_dword_load(stack.writes, site.program.laid_out_fits(laid), within.witness, formed, 0, the_load, within.proof,
                λ (s: MachineState<M>) => mid(s.gprs, s.memory),
                λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.Framed(saves, d, s0, t),
                λ s held => {
                    let home_holds = held.left.right.left.right;
                    let short: (values(64, home.length).toNat() <= xs.len()) =
                        j(sym(home_holds.right), λ w _ => w.toNat() <= xs.len(), BitVec::toNat_ofNat_le(64, xs.len()));
                    let span: (index.toNat() + 3 < xs.len()) = omega(held.left.right.right, short);
                    let readable = lent(home.buffer)(s.memory, held.right.right);
                    let base = next_rip(a, index.toNat());
                    let start: (a.add(index) = base) = sym(BitVec::iter_add_eq_add(64, a, index));
                    let at_sum: (read_gpr(destination, s.gprs) = a.add(index)) =
                        trans(held.left.left.right, cong_fn(λ (b: BitVec(64)) => b.add(index), home_holds.left));
                    let at: (read_gpr(destination, s.gprs) = base) = trans(at_sum, start);
                    let in0: (index.toNat() < xs.len()) = omega(span);
                    let in1: (index.toNat() + 1 < xs.len()) = omega(span);
                    let in2: (index.toNat() + 2 < xs.len()) = omega(span);
                    let b0 = buffer_byte(lending.buffers, home.buffer, index.toNat());
                    let b1 = buffer_byte(lending.buffers, home.buffer, index.toNat() + 1);
                    let b2 = buffer_byte(lending.buffers, home.buffer, index.toNat() + 2);
                    let b3 = buffer_byte(lending.buffers, home.buffer, index.toNat() + 3);
                    let r0: (site.data.read(s.memory, base) = Some(b0)) =
                        trans(readable.right(index.toNat(), in0), buffer_byte_at(lending.buffers, home.buffer, index.toNat(), in0));
                    let r1: (site.data.read(s.memory, next_rip(base, 1)) = Some(b1)) =
                        trans(readable.right(index.toNat() + 1, in1), buffer_byte_at(lending.buffers, home.buffer, index.toNat() + 1, in1));
                    let r2: (site.data.read(s.memory, next_rip(base, 2)) = Some(b2)) =
                        trans(readable.right(index.toNat() + 2, in2), buffer_byte_at(lending.buffers, home.buffer, index.toNat() + 2, in2));
                    let r3: (site.data.read(s.memory, next_rip(base, 3)) = Some(b3)) =
                        trans(readable.right(index.toNat() + 3, span), buffer_byte_at(lending.buffers, home.buffer, index.toNat() + 3, span));
                    let dword = imm32_from_bytes(b0, b1, b2, b3);
                    let read: (read_dword(site.data, s.memory, base) = Some(dword)) =
                        dword_of_four(site.data.read(s.memory, base), site.data.read(s.memory, next_rip(base, 1)),
                            site.data.read(s.memory, next_rip(base, 2)), site.data.read(s.memory, next_rip(base, 3)), b0, b1, b2, b3, r0, r1, r2, r3);
                    let word: (values(32, wide.output) = dword) =
                        trans(j(sym(same), λ b _ => values(32, wide.output) = buffer_word(lending.buffers, b, index.toNat(), 4),
                                held.left.right.left.left),
                            buffer_word_four(lending.buffers, home.buffer, index.toNat()));
                    let written: (values(32, wide.output).resize(64) = dword.zero_extend(32)) =
                        trans(cong_fn(λ (w: BitVec(32)) => w.resize(64), word), BitVec::resize_zero_extend(32, 32, dword));
                    Exists(dword, ⟨j(sym(at_sum), λ x _ => x.toNat() + 4 <= Nat::pow(2, 47),
                            stack.lent_four(d + 64, a, xs, s0.memory, lent(home.buffer), index, s.memory, held.right.right, span)),
                        ⟨j(sym(at), λ x _ => read_dword(site.data, s.memory, x) = Some(dword), read),
                         ⟨address.file.represents_write(values, s.gprs, destination, Some(Held(wide.output, Narrow(32))), dword.zero_extend(32),
                            held.left.left.left, written),
                          ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(destination, dword.zero_extend(32), s.gprs), held.right.left,
                            kept_write(body_kept(saves), destination, dword.zero_extend(32), s.gprs, kept.right)), held.right.right⟩⟩⟩⟩)
                }))
     }⟩
}

theorem File::wide_at_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>,
    lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, home: Lent, wide: WideLeaf, destination: Gpr, placement: List<Place>,
    names: Nat, same: home.buffer = wide.buffer):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers),
        file.wide_at(saves, prog, home, wide, destination, placement, names)) {
    let facts = wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers);
    match inside: file.bounded(wide.index, home.length) && file.span_bounded(wide.index, home.length, 3) {
        False => trivial,
        True => {
            let both = Bool::is_true_and(file.bounded(wide.index, home.length), file.span_bounded(wide.index, home.length, 3),
                is_true_of_eq(file.bounded(wide.index, home.length) && file.span_bounded(wide.index, home.length, 3), inside));
            (match file.address(destination, home.base, wide.index) as λ a =>
                a.All(λ (out: Lowered) => Addressed<M>(values, file, destination, home.base, wide.index, out)) →
                MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, match a {
                    None => None,
                    Some(address) => match leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                        False => None,
                        True => Some(Emitted(At(At(prog, 0, Block(address.code)), 0, asm_dword_load(DwordLoad(destination, destination))),
                            address.file.write(destination, Some(Held(wide.output, Narrow(32)))), placement, names)),
                    },
                }) {
                None => λ _ => trivial,
                Some(address) => λ addressed =>
                    match kept: leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)) {
                        False => trivial,
                        True => wide_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, file, home, wide, destination, placement,
                            names, same, both.left, both.right, address, addressed,
                            Bool::is_true_and(leaves_all(address.code, body_kept(saves)), destination.apart(body_kept(saves)),
                                is_true_of_eq(leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)), kept))),
                    },
            })(file.address_addressed<M>(values, destination, home.base, wide.index))
        },
    }
}

theorem File::wide_from_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>,
    lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, wide: WideLeaf, destination: Gpr, placement: List<Place>, names: Nat,
    homes: List<Lent>):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        wide.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
        file.wide_from(saves, prog, homes, wide, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => {
            let all = wide.Holds(values, lending.buffers) ∧ HomesHold(Cons(home, rest), values, lending.addresses, lending.buffers);
            let later = may_emit_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
                wide.Holds(values, lending.buffers) ∧ HomesHold(rest, values, lending.addresses, lending.buffers), all,
                λ held => ⟨held.left, held.right.right⟩, file.wide_from(saves, prog, rest, wide, destination, placement, names),
                file.wide_from_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, wide, destination, placement, names, rest));
            match same: home.buffer.same(wide.buffer) {
                False => later,
                True => (match file.wide_at(saves, prog, home, wide, destination, placement, names) as λ e =>
                    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
                        wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers), e) →
                    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, all, match e {
                        None => file.wide_from(saves, prog, rest, wide, destination, placement, names),
                        Some(emitted) => Some(emitted),
                    }) {
                    None => λ _ => later,
                    Some(emitted) => λ emits => emits_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
                        wide.Holds(values, lending.buffers) ∧ home.Holds(values, lending.addresses, lending.buffers), all,
                        λ held => ⟨held.left, held.right.left⟩, emitted, emits),
                })(file.wide_at_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, home, wide, destination, placement, names,
                    home.buffer.same_sound(wide.buffer, same))),
            }
        },
    }
}

theorem File::emit_wide_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>,
    lent: stack.LentAll(d + 64, lending, s0.memory), prog: Prog, homes: List<Lent>, nodes: List<Node>, wide: WideLeaf,
    placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        (wide.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers)) ∧ NodesHold(values, nodes_rest(nodes)),
        file.emit_wide(saves, prog, homes, nodes, wide, placement, names)) {
    let loads = wide.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers);
    let facts = loads ∧ NodesHold(values, nodes_rest(nodes));
    match placement as λ p => MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, file.emit_wide(saves, prog, homes, nodes, wide, p, names)) {
        Nil => trivial,
        Cons(place, rest) => match place as λ q =>
            MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, file.emit_wide(saves, prog, homes, nodes, wide, Cons(q, rest), names)) {
            Folded => trivial,
            Saving(_) => trivial,
            Into(destination) => (match file.wide_from(saves, prog, homes, wide, destination, rest, names) as λ e =>
                MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, loads, e) →
                MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, match e {
                    None => None,
                    Some(loaded) => emit_kept_nodes(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names),
                }) {
                None => λ _ => trivial,
                Some(loaded) => λ first =>
                    (match emit_kept_nodes(saves, loaded.prog, loaded.file, nodes_rest(nodes), loaded.placement, loaded.names) as λ e =>
                        MayEmitIn<M>(saves, site, stack, values, d, s0, loaded.prog, loaded.file, NodesHold(values, nodes_rest(nodes)), e) →
                        MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, e) {
                        None => λ _ => trivial,
                        Some(out) => λ second => emits_in_seq<M>(saves, site, stack, values, d, s0, prog, file, loads,
                            NodesHold(values, nodes_rest(nodes)), loaded, out, first, second),
                    })(emit_kept_nodes_emits<M>(saves, site, laid, stack, values, d, s0, loaded.prog, loaded.file, nodes_rest(nodes),
                        loaded.placement, loaded.names)),
            })(file.wide_from_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, wide, destination, rest, names, homes)),
        },
    }
}

theorem TableLeaf::fits_sound(self table: TableLeaf, ok: table.fits().IsTrue()):
    (table.width = 64) ∧ ((Nat::pow(2, table.bits) <= table.entries.len()) ∧ ((table.bits <= 64) ∧
        (BitVec::ofNat(8 * table.entries.len(), n := 32).sign_extend(32).toNat() = 8 * table.entries.len()))) {
    let jump = BitVec::ofNat(8 * table.entries.len(), n := 32).sign_extend(32).toNat();
    let all = Bool::is_true_and(table.width.same(64), Nat::pow(2, table.bits).leb(table.entries.len()) && (table.bits.leb(64) &&
        jump.same(8 * table.entries.len())), ok);
    let more = Bool::is_true_and(Nat::pow(2, table.bits).leb(table.entries.len()), table.bits.leb(64) && jump.same(8 * table.entries.len()),
        all.right);
    let last = Bool::is_true_and(table.bits.leb(64), jump.same(8 * table.entries.len()), more.right);
    ⟨table.width.same_sound(64, eq_true_of_is_true(table.width.same(64), all.left)),
     ⟨Nat::pow(2, table.bits).leb_sound(table.entries.len(), more.left),
      ⟨table.bits.leb_sound(64, last.left),
       jump.same_sound(8 * table.entries.len(), eq_true_of_is_true(jump.same(8 * table.entries.len()), last.right))⟩⟩⟩
}

// The word a table read writes over the one its LEA wrote first.
theorem File::represents_overwrite(self file: File, values: Valuation(), gprs: Gprs, register: Gpr, slot: Option<Held>,
    first, word: BitVec(64), before: file.Represents(values, gprs), written: SlotRep(values, slot, word)):
    file.write(register, slot).Represents(values, write_gpr(register, word, write_gpr(register, first, gprs))) {
    ⟨λ query => j(sym(file.write_at(register, slot, query)),
        λ now _ => SlotRep(values, now, read_gpr(query, write_gpr(register, word, write_gpr(register, first, gprs)))),
        match register.same(query) as λ b =>
            SlotRep(values, match b { False => file.at(query), True => slot },
                match b { False => match b { False => gprs.at(query), True => first }, True => word }) {
            False => before.left(query),
            True => written,
        }), before.right⟩
}

// The nodes before the read as a block, then the read in place: from a
// state the file describes, where the nodes before hold and so does the
// read, the base register ends holding the table's word at the index, the
// callee-saved registers and memory as they were.
theorem table_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts, front: Type, lowered: Lowered,
    keeps: Keeps<M>(values, file, front, lowered), table: TableLeaf, parts: facts → front ∧ table.Holds(values),
    base: SibBase, index: SibIndex, at: FoundAt(lowered.file, Held(table.index, Narrow(table.bits)), index.gpr()),
    fits: (table.width = 64) ∧ ((Nat::pow(2, table.bits) <= table.entries.len()) ∧ ((table.bits <= 64) ∧
        (BitVec::ofNat(8 * table.entries.len(), n := 32).sign_extend(32).toNat() = 8 * table.entries.len()))),
    apart: (!base.gpr().same(index.gpr())).IsTrue(), leaves: leaves_all(lowered.code, body_kept(saves)).IsTrue(),
    kept: base.gpr().apart(body_kept(saves)).IsTrue(), placement: List<Place>, names: Nat):
    EmitsIn<M>(saves, site, stack, values, d, s0, prog, file, facts,
        Emitted(table_read_prog(At(prog, 0, Block(lowered.code)), base, index, table.entries),
            lowered.file.write(base.gpr(), Some(Held(table.output, Word))), placement, names)) {
    let entries = table.entries;
    let formed = At(prog, 0, Block(lowered.code));
    let p1 = At(formed, 0, table_lea(base.gpr()));
    let p2 = At(p1, 0, table_jump(8 * entries.len()));
    let p3 = At(p2, 0, table_piece(entries));
    let out_file = lowered.file.write(base.gpr(), Some(Held(table.output, Word)));
    let framed = λ (g: Gprs) (m: M) => Kept(body_kept(saves), s0.gprs, g) ∧ stack.Wrote(d + 64, s0.memory, m);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧ framed(g, m);
    let mid = λ (g: Gprs) (m: M) => (lowered.file.Represents(values, g) ∧ table.Holds(values)) ∧ framed(g, m);
    let post = λ (g: Gprs) (m: M) => out_file.Represents(values, g) ∧ framed(g, m);
    ⟨table_within(prog, lowered.code, base, index, entries),
     λ within => {
        let in3 = p3.within_before(0, asm_indexed_load(table_read_load(base, index)), site.program, within);
        let in2 = p2.within_before(0, table_piece(entries), site.program, in3);
        let in1 = p1.within_before(0, table_jump(8 * entries.len()), site.program, in2);
        let formed_in = formed.within_before(0, table_lea(base.gpr()), site.program, in1);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(formed), prog_len(table_read_prog(formed, base, index, entries)),
            λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (s: MachineState<M>) => mid(s.gprs, s.memory),
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(lowered.code), pre, mid,
                λ memory => site.runs_block(site.program.laid_out_fits(laid), formed_in.witness, prog, 0, lowered.code, formed_in.proof,
                    site.program.block_reads_at(laid, formed_in.witness, prog, 0, lowered.code, formed_in.proof),
                    λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => mid(g, memory),
                    λ x held => {
                        let both = parts(held.left.right);
                        ⟨⟨keeps(x, held.left.left, both.left), both.right⟩,
                         ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(lowered.code, x).gprs, held.right.left,
                            execute_block_kept<M>(lowered.code, x, body_kept(saves), leaves)), held.right.right⟩⟩
                    })),
            site.moves_table_read(stack.writes, stack, site.program.laid_out_fits(laid), within.witness, formed, base, index, entries,
                within.proof, fits.right.right.right, apart, mid, post,
                λ g m held => {
                    let v = values(table.bits, table.index);
                    let w = read_gpr(index.gpr(), g);
                    let slot: (v.resize(64) = w) =
                        j(at.holds, λ s _ => SlotRep(values, s, w), held.left.left.left(index.gpr()));
                    let same_nat: (w.toNat() = v.toNat()) =
                        trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), sym(slot)), BitVec::resize_toNat(table.bits, 64, fits.right.right.left, v));
                    let below: (w.toNat() < entries.len()) = j(sym(same_nat), λ i _ => i < entries.len(),
                        Nat::le_trans(Succ(v.toNat()), Nat::pow(2, table.bits), entries.len(), BitVec::toNat_lt_pow(table.bits, v),
                            fits.right.left));
                    let wide: (values(64, table.output) = BitVec::ofNat(table_entry(entries, v.toNat()), n := 64)) =
                        j(fits.left, λ k _ => values(k, table.output) = BitVec::ofNat(table_entry(entries, v.toNat()), n := k), held.left.right);
                    let word = table_word(entries, w.toNat());
                    let written: (values(64, table.output) = word) =
                        j(sym(same_nat), λ i _ => values(64, table.output) = BitVec::ofNat(table_entry(entries, i), n := 64), wide);
                    let lea = next_rip(site.origin, prog_len(formed) + 12);
                    let once = write_gpr(base.gpr(), lea, g);
                    let first: Kept(body_kept(saves), s0.gprs, once) =
                        kept_trans(body_kept(saves), s0.gprs, g, once, held.right.left, kept_write(body_kept(saves), base.gpr(), lea, g, kept));
                    ⟨below,
                     ⟨lowered.file.represents_overwrite(values, g, base.gpr(), Some(Held(table.output, Word)), lea, word, held.left.left, written),
                      ⟨kept_trans(body_kept(saves), s0.gprs, once, write_gpr(base.gpr(), word, once), first,
                          kept_write(body_kept(saves), base.gpr(), word, once, kept)), held.right.right⟩⟩⟩
                }))
     }⟩
}

theorem Lowered::table_with_emits<M>(self lowered: Lowered, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts, front: Type,
    keeps: Keeps<M>(values, file, front, lowered), table: TableLeaf, parts: facts → front ∧ table.Holds(values), base: SibBase,
    index: SibIndex, placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, lowered.table_with(saves, prog, table, base, index, placement, names)) {
    match found: lowered.file.found_at(Held(table.index, Narrow(table.bits)), index.gpr()) {
        None => trivial,
        Some(at) => {
            let rest = !base.gpr().same(index.gpr()) && (leaves_all(lowered.code, body_kept(saves)) && base.gpr().apart(body_kept(saves)));
            match ok: table.fits() && rest {
                False => trivial,
                True => {
                    let all = Bool::is_true_and(table.fits(), rest, is_true_of_eq(table.fits() && rest, ok));
                    let more = Bool::is_true_and(!base.gpr().same(index.gpr()),
                        leaves_all(lowered.code, body_kept(saves)) && base.gpr().apart(body_kept(saves)), all.right);
                    let last = Bool::is_true_and(leaves_all(lowered.code, body_kept(saves)), base.gpr().apart(body_kept(saves)), more.right);
                    table_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, facts, front, lowered, keeps, table, parts, base, index,
                        at, table.fits_sound(all.left), more.left, last.left, last.right, placement, names)
                },
            }
        },
    }
}

theorem Lowered::table_into_emits<M>(self lowered: Lowered, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, facts, front: Type,
    keeps: Keeps<M>(values, file, front, lowered), table: TableLeaf, parts: facts → front ∧ table.Holds(values), destination: Gpr,
    placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, lowered.table_into(saves, prog, table, destination, placement, names)) {
    match destination.sib_base() {
        None => trivial,
        Some(base) => match lowered.file.find(Held(table.index, Narrow(table.bits))) {
            None => trivial,
            Some(found) => match found.register.sib_index() {
                None => trivial,
                Some(index) => lowered.table_with_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, facts, front, keeps, table,
                    parts, base, index, placement, names),
            },
        },
    }
}

theorem File::emit_table_emits<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, nodes: List<Node>,
    table: TableLeaf, found: leaf_table(nodes) = Some(table), placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes),
        file.emit_table(saves, prog, nodes, table, placement, names)) {
    let front = NodesHold(values, nodes_front(nodes));
    let parts = λ (held: NodesHold(values, nodes)) => leaf_table_holds(values, table, nodes, found, held);
    (match lower_nodes(nodes_front(nodes), placement, file) as λ l => MayKeep<M>(values, file, front, l) →
        MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), match l {
            None => None,
            Some(lowered) => match skip_nodes(nodes_front(nodes), placement) {
                Nil => None,
                Cons(place, rest) => match place {
                    Into(destination) => lowered.table_into(saves, prog, table, destination, rest, names),
                    Folded => None,
                    Saving(_) => None,
                },
            },
        }) {
        None => λ _ => trivial,
        Some(lowered) => λ keeps => match skip_nodes(nodes_front(nodes), placement) {
            Nil => trivial,
            Cons(place, rest) => match place {
                Into(destination) => lowered.table_into_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, NodesHold(values, nodes),
                    front, keeps, table, parts, destination, rest, names),
                Folded => trivial,
                Saving(_) => trivial,
            },
        },
    })(lower_nodes_keeps<M>(values, nodes_front(nodes), placement, file))
}

theorem emit_blind_leaf_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), emit_blind_leaf(saves, prog, file, nodes, placement, names)) {
    (match leaf_table(nodes) as λ t => leaf_table(nodes) = t →
        MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), match t {
            None => emit_kept_nodes(saves, prog, file, nodes, placement, names),
            Some(table) => file.emit_table(saves, prog, nodes, table, placement, names),
        }) {
        None => λ _ => emit_kept_nodes_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, nodes, placement, names),
        Some(table) => λ found => file.emit_table_emits<M>(saves, site, laid, stack, values, d, s0, prog, nodes, table, found, placement, names),
    })(refl)
}

theorem emit_quiet_leaf_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    lending: Lending, values: Valuation(), d: Nat, s0: MachineState<M>, lent: stack.LentAll(d + 64, lending, s0.memory),
    prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>):
    MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
        NodesHoldOver(lending.buffers, values, nodes) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
        emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes)) {
    let facts = NodesHoldOver(lending.buffers, values, nodes) ∧ HomesHold(homes, values, lending.addresses, lending.buffers);
    (match leaf_load(nodes) as λ found => leaf_load(nodes) = found →
        MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, match found {
            None => match leaf_wide(nodes) {
                None => match nodes_blind(nodes) { False => None, True => emit_blind_leaf(saves, prog, file, nodes, placement, names) },
                Some(wide) => file.emit_wide(saves, prog, homes, nodes, wide, placement, names),
            },
            Some(load) => file.emit_load(saves, prog, homes, load, placement, names),
        }) {
        None => λ _ => (match leaf_wide(nodes) as λ w => leaf_wide(nodes) = w →
            MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file, facts, match w {
                None => match nodes_blind(nodes) { False => None, True => emit_blind_leaf(saves, prog, file, nodes, placement, names) },
                Some(wide) => file.emit_wide(saves, prog, homes, nodes, wide, placement, names),
            }) {
            None => λ _ => match pure: nodes_blind(nodes) {
                False => trivial,
                True => may_emit_in_weaken<M>(saves, site, stack, values, d, s0, prog, file, NodesHold(values, nodes), facts,
                    λ held => nodes_hold_blind(values, lending.buffers, nodes, is_true_of_eq(nodes_blind(nodes), pure), held.left),
                    emit_blind_leaf(saves, prog, file, nodes, placement, names),
                    emit_blind_leaf_emits<M>(saves, site, laid, stack, values, d, s0, prog, file, nodes, placement, names)),
            },
            Some(wide) => λ found => may_emit_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
                (wide.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers)) ∧
                    NodesHold(values, nodes_rest(nodes)), facts,
                λ held => {
                    let parts = leaf_wide_holds(values, lending.buffers, nodes, wide, found, held.left);
                    ⟨⟨parts.left, held.right⟩, parts.right⟩
                },
                file.emit_wide(saves, prog, homes, nodes, wide, placement, names),
                file.emit_wide_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, homes, nodes, wide, placement, names)),
        })(refl),
        Some(load) => λ found => may_emit_in_weaken<M>(saves, site, stack, values, d, s0, prog, file,
            load.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers), facts,
            λ held => ⟨leaf_load_holds(values, lending.buffers, nodes, load, found, held.left), held.right⟩,
            file.emit_load(saves, prog, homes, load, placement, names),
            match placement as λ p => MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
                load.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
                file.emit_load(saves, prog, homes, load, p, names)) {
                Nil => trivial,
                Cons(place, rest) => match place as λ q => MayEmitIn<M>(saves, site, stack, values, d, s0, prog, file,
                    load.Holds(values, lending.buffers) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
                    file.emit_load(saves, prog, homes, load, Cons(q, rest), names)) {
                    Folded => trivial,
                    Saving(_) => trivial,
                    Into(destination) => file.load_from_emits<M>(saves, site, laid, stack, lending, values, d, s0, lent, prog, load, destination, rest,
                        names, homes),
                },
            }),
    })(refl)
}

// ---------------------------------------------------------------------------
// The file threaded (docs/native-one-compiler-design.md §2.6)

// What emitting proves of code that may change the file: from the file
// `before` in memory to the file `after` in memory, the trail kept.
fn EmitsOver<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Buffers(), out: Emitted) → Type {
    prog.Within(out.prog) ∧ (out.prog.Within(site.program) →
        site.Moves(stack.writes, prog_len(prog), prog_len(out.prog),
            λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.Trailed(saves, lending, d, s0, before, s),
            λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t)))
}

fn MayEmitOver<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Buffers(), out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, emitted))
}

// Facts that follow from the ones a body starts with.
theorem emits_over_weaken<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts, stronger: Type, implies: stronger → facts, before, after: Buffers(), out: Emitted,
    emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, stronger, before, after, out) {
    ⟨emits.left, λ within => site.moves_weaken(stack.writes, prog_len(prog), prog_len(out.prog),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ facts) ∧ stack.Trailed(saves, lending, d, s0, before, s),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t),
        λ (s: MachineState<M>) => (file.Represents(values, s.gprs) ∧ stronger) ∧ stack.Trailed(saves, lending, d, s0, before, s),
        λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t),
        emits.right(within), λ s held => ⟨⟨held.left.left, implies(held.left.right)⟩, held.right⟩, λ t held => held)⟩
}

theorem may_emit_over_weaken<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts, stronger: Type, implies: stronger → facts, before, after: Buffers(),
    out: Option<Emitted>):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, out) →
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, stronger, before, after, out) {
    match out {
        None => λ _ => trivial,
        Some(emitted) => λ emits => emits_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, stronger, implies, before,
            after, emitted, emits),
    }
}

// One piece of code after another, the second from the file the first
// leaves: which file that is, the facts say.
theorem emits_over_seq<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, First, Second: Buffers() → Type, before, after: Buffers(), first, out: Emitted,
    first_emits: (mid: Buffers()) → EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, First(mid), before, mid, first),
    second_emits: (mid: Buffers()) → EmitsOver<M>(saves, site, stack, lending, values, d, s0, first.prog, first.file, Second(mid), mid, after, out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Exists<Buffers()>(λ mid => First(mid) ∧ Second(mid)), before, after, out) {
    ⟨prog.within_trans(first.prog, out.prog, first_emits(before).left, second_emits(before).left),
     λ within s here resident held => {
        let mid = held.left.right.witness;
        let both = held.left.right.proof;
        site.moves_trans(stack.writes, prog_len(prog), prog_len(first.prog), prog_len(out.prog),
            λ (x: MachineState<M>) => ((file.Represents(values, x.gprs) ∧ First(mid)) ∧ stack.Trailed(saves, lending, d, s0, before, x)) ∧ Second(mid),
            λ (x: MachineState<M>) => (first.file.Represents(values, x.gprs) ∧ Second(mid)) ∧ stack.Trailed(saves, lending, d, s0, mid, x),
            λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t),
            site.moves_weaken(stack.writes, prog_len(prog), prog_len(first.prog),
                λ (x: MachineState<M>) => ((file.Represents(values, x.gprs) ∧ First(mid)) ∧ stack.Trailed(saves, lending, d, s0, before, x)) ∧ Second(mid),
                λ (t: MachineState<M>) => (first.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, mid, t)) ∧ Second(mid),
                λ (x: MachineState<M>) => ((file.Represents(values, x.gprs) ∧ First(mid)) ∧ stack.Trailed(saves, lending, d, s0, before, x)) ∧ Second(mid),
                λ (x: MachineState<M>) => (first.file.Represents(values, x.gprs) ∧ Second(mid)) ∧ stack.Trailed(saves, lending, d, s0, mid, x),
                site.moves_carry(stack.writes, prog_len(prog), prog_len(first.prog),
                    λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ First(mid)) ∧ stack.Trailed(saves, lending, d, s0, before, x),
                    λ (t: MachineState<M>) => first.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, mid, t), Second(mid),
                    first_emits(mid).right(first.prog.within_trans(out.prog, site.program, second_emits(mid).left, within))),
                λ x h => h,
                λ t h => ⟨⟨h.left.left, h.right⟩, h.left.right⟩),
            second_emits(mid).right(within),
            s, here, resident, ⟨⟨⟨held.left.left, both.left⟩, held.right⟩, both.right⟩)
     }⟩
}

theorem may_emit_over_seq<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, First, Second: Buffers() → Type, before, after: Buffers(), first: Emitted,
    first_emits: (mid: Buffers()) → EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, First(mid), before, mid, first),
    second: Option<Emitted>):
    ((mid: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, values, d, s0, first.prog, first.file, Second(mid), mid, after, second)) →
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Exists<Buffers()>(λ mid => First(mid) ∧ Second(mid)), before, after,
        second) {
    match second {
        None => λ _ => trivial,
        Some(out) => λ second_emits => emits_over_seq<M>(saves, site, stack, lending, values, d, s0, prog, file, First, Second, before, after,
            first, out, first_emits, second_emits),
    }
}

// Code whose facts say it leaves the file, proved to.
theorem emits_over_still<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Buffers(), still: facts → after = before, out: Emitted,
    emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, before, out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, out) {
    ⟨emits.left, λ within s here resident held =>
        j(sym(still(held.left.right)), λ a _ => site.Arrives(stack.writes, s, prog_len(out.prog),
                λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, a, t)),
            emits.right(within)(s, here, resident, held))⟩
}

theorem may_emit_over_still<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, after: Buffers(), still: facts → after = before,
    out: Option<Emitted>):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, before, out) →
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, out) {
    match out {
        None => λ _ => trivial,
        Some(emitted) => λ emits => emits_over_still<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, still,
            emitted, emits),
    }
}

// A leaf that stores nothing is proved over the file as it is when the
// leaf starts, from the state it starts in (`EmitsIn`). Under the laws that
// is enough: the file in memory is lent to it, and its stores are its own,
// which leave every buffer.
theorem may_emit_over_of_in<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), values: Valuation(), d: Nat, s0: MachineState<M>,
    under: d + 64 <= top, prog: Prog, file: File, facts: Type, now: Buffers(), out: Option<Emitted>, grows: Grows(prog, out),
    emits: (s: MachineState<M>) → stack.LentAll(d + 64, lending.over(now), s.memory) →
        ((b: Nat) → buffer_bytes(now, b).len() = buffer_bytes(lending.buffers, b).len()) →
        MayEmitIn<M>(saves, site, stack, values, d, s, prog, file, facts, out)):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, now, now, out) {
    (match out as λ o => Grows(prog, o) →
        ((s: MachineState<M>) → stack.LentAll(d + 64, lending.over(now), s.memory) →
            ((b: Nat) → buffer_bytes(now, b).len() = buffer_bytes(lending.buffers, b).len()) →
            MayEmitIn<M>(saves, site, stack, values, d, s, prog, file, facts, o)) →
        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, now, now, o) {
        None => λ _ _ => trivial,
        Some(emitted) => λ grown proved => ⟨grown, λ within s here resident held => {
            let trail = held.right;
            let lent = stack.in_memory_lent(top, lending, loan, d + 64, under, now, s.memory, trail.right.right);
            let ran = proved(s, lent, λ b => trail.right.right(b).left).right(within)(s, here, resident,
                ⟨held.left, ⟨kept_refl(body_kept(saves), s.gprs), stack.wrote_refl(d + 64, s.memory)⟩⟩);
            let t = ran.witness;
            let framed = ran.proof.right.right.right.right;
            Exists(t, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨ran.proof.right.right.left, ⟨ran.proof.right.right.right.left,
                ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, t.gprs, trail.left, framed.left),
                 ⟨stack.wrote_in_trans(d + 64, lending.spans(), s0.memory, s.memory, t.memory, trail.right.left,
                    stack.wrote_in_own(d + 64, lending.spans(), s.memory, t.memory, framed.right)),
                  stack.in_memory_wrote(top, lending, loan, d + 64, under, now, s.memory, t.memory, framed.right,
                    trail.right.right)⟩⟩⟩⟩⟩⟩)
        }⟩,
    })(grows, emits)
}

// Code proved to leave the file its facts say it leaves.
theorem emits_over_at<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, facts: Type, before, target, after: Buffers(), there: facts → after = target, out: Emitted,
    emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, target, out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, out) {
    ⟨emits.left, λ within s here resident held =>
        j(sym(there(held.left.right)), λ a _ => site.Arrives(stack.writes, s, prog_len(out.prog),
                λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, a, t)),
            emits.right(within)(s, here, resident, held))⟩
}

// Code proved for each file its facts may name: the facts say which.
theorem emits_over_some<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Buffers() → Type, After: Buffers() → Buffers(), before, after: Buffers(),
    out: Emitted,
    emits: (left: Buffers()) → EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts(left), before, After(left), out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Exists<Buffers()>(λ left => Facts(left) ∧ (after = After(left))),
        before, after, out) {
    ⟨emits(before).left, λ within s here resident held => {
        let found = held.left.right;
        j(sym(found.proof.right), λ a _ => site.Arrives(stack.writes, s, prog_len(out.prog),
                λ (t: MachineState<M>) => out.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, a, t)),
            emits(found.witness).right(within)(s, here, resident, ⟨⟨held.left.left, found.proof.left⟩, held.right⟩))
    }⟩
}

theorem may_emit_over_some<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending, values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, Facts: Buffers() → Type, After: Buffers() → Buffers(), before, after: Buffers(),
    out: Option<Emitted>):
    ((left: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts(left), before, After(left), out)) →
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Exists<Buffers()>(λ left => Facts(left) ∧ (after = After(left))),
        before, after, out) {
    match out {
        None => λ _ => trivial,
        Some(emitted) => λ emits => emits_over_some<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts, After, before, after,
            emitted, emits),
    }
}

// ---------------------------------------------------------------------------
// A store into a lent buffer (docs/native-one-compiler-design.md §2.6)

// The address formed, the value's low byte stored over it, and the byte
// loaded back: the home says where the buffer lies and how long it is, the
// path that the index is inside, and the lending that the buffer may be
// written, so under the laws the byte is writable, the code and the frame
// are kept, and the file with that byte set is the one in memory. The load
// then reads the byte there, which is what the store's output names.
theorem store_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), values: Valuation(), d: Nat,
    s0: MachineState<M>, prog: Prog, file: File, home: Lent, store: Store, destination: Gpr, placement: List<Place>, names: Nat,
    same: home.buffer = store.buffer, written: lending.written(store.buffer) = True,
    bounded: file.bounded(store.index, home.length).IsTrue(), address: Lowered,
    addressed: Addressed<M>(values, file, destination, home.base, store.index, address),
    source: Found(address.file, Held(store.value, Word)),
    kept: leaves_all(address.code, body_kept(saves)).IsTrue() ∧ destination.apart(body_kept(saves)).IsTrue(),
    plain: store_base_plain(destination) = True, before: Buffers()):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        (values(64, store.output) = byte_word(buffer_byte(store.after(values, before), store.buffer, values(64, store.index).toNat()))) ∧
            home.Holds(values, lending.addresses, lending.buffers),
        before, store.after(values, before),
        Emitted(At(At(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register))), 0,
                LoadByte(ByteLoad(destination, destination))),
            address.file.write(destination, Some(Held(store.output, Word))), placement, names)) {
    let after = store.after(values, before);
    let index = values(64, store.index);
    let byte = low_byte(values(64, store.value));
    let named = values(64, store.output) = byte_word(buffer_byte(after, store.buffer, index.toNat()));
    let facts = named ∧ home.Holds(values, lending.addresses, lending.buffers);
    let formed = At(prog, 0, Block(address.code));
    let the_store = ByteStore(destination, source.register);
    let put = At(formed, 0, StoreByte(the_store));
    let the_load = ByteLoad(destination, destination);
    let loaded = At(put, 0, LoadByte(the_load));
    let out_file = address.file.write(destination, Some(Held(store.output, Word)));
    let a = address_of(lending.addresses, store.buffer);
    let xs = buffer_bytes(lending.buffers, store.buffer);
    let spans = lending.spans();
    let trailed = λ (now: Buffers()) (g: Gprs) (m: M) => Kept(body_kept(saves), s0.gprs, g) ∧ stack.Trail(lending, d, s0.memory, now, m);
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ facts) ∧ trailed(before, g, m);
    let ready = λ (now: Buffers()) (g: Gprs) (m: M) =>
        ((address.file.Represents(values, g) ∧ (read_gpr(destination, g) = a.add(index))) ∧ (named ∧ (index.toNat() < xs.len()))) ∧
            trailed(now, g, m);
    let post = λ (t: MachineState<M>) => out_file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t);
    ⟨prog.within_step(put, 0, LoadByte(the_load), prog.within_step(formed, 0, StoreByte(the_store), prog.within_then(0, Block(address.code)))),
     λ within => {
        let put_in = put.within_before(0, LoadByte(the_load), site.program, within);
        let formed_in = formed.within_before(0, StoreByte(the_store), site.program, put_in);
        let fits = site.program.laid_out_fits(laid);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(formed), prog_len(loaded),
            λ (s: MachineState<M>) => pre(s.gprs, s.memory), λ (s: MachineState<M>) => ready(before, s.gprs, s.memory), post,
            site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(address.code), pre,
                λ (g: Gprs) (m: M) => ready(before, g, m),
                λ memory => site.runs_block(fits, formed_in.witness, prog, 0, address.code, formed_in.proof,
                    site.program.block_reads_at(laid, formed_in.witness, prog, 0, address.code, formed_in.proof),
                    λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => ready(before, g, memory),
                    λ x held => {
                        let home_holds = held.left.right.right;
                        let at_base: (values(64, home.base) = a) =
                            j(same, λ b _ => values(64, home.base) = address_of(lending.addresses, b), home_holds.left);
                        let length: (values(64, home.length) = BitVec::ofNat(xs.len())) =
                            j(same, λ b _ => values(64, home.length) = BitVec::ofNat(buffer_bytes(lending.buffers, b).len()), home_holds.right);
                        let short: (values(64, home.length).toNat() <= xs.len()) =
                            j(sym(length), λ w _ => w.toNat() <= xs.len(), BitVec::toNat_ofNat_le(64, xs.len()));
                        let below = file.bounded_sound(values, x.gprs, store.index, home.length, held.left.left, bounded);
                        let got = addressed(x, held.left.left);
                        ⟨⟨⟨got.left, trans(got.right, cong_fn(λ (b: BitVec(64)) => b.add(index), at_base))⟩,
                          ⟨held.left.right.left,
                           Nat::le_trans(Succ(index.toNat()), values(64, home.length).toNat(), xs.len(), below, short)⟩⟩,
                         ⟨kept_trans(body_kept(saves), s0.gprs, x.gprs, execute_block_normal(address.code, x).gprs, held.right.left,
                            execute_block_kept<M>(address.code, x, body_kept(saves), kept.left)), held.right.right⟩⟩
                    })),
            site.moves_trans(stack.writes, prog_len(formed), prog_len(put), prog_len(loaded),
                λ (s: MachineState<M>) => ready(before, s.gprs, s.memory), λ (s: MachineState<M>) => ready(after, s.gprs, s.memory), post,
                site.moves_store_byte(stack.writes, fits, put_in.witness, formed, 0, the_store, put_in.proof,
                    λ (s: MachineState<M>) => ready(before, s.gprs, s.memory), λ (s: MachineState<M>) => ready(after, s.gprs, s.memory),
                    λ s held resident => {
                        let k = index.toNat();
                        let inside = held.left.right.right;
                        let cell = spans.byte(store.buffer, k);
                        let at: (read_gpr(destination, s.gprs) = cell) =
                            trans(held.left.left.right, sym(BitVec::iter_add_eq_add(64, a, index)));
                        let value: (values(64, store.value) = read_gpr(source.register, s.gprs)) =
                            source.at.rep(values, s.gprs, held.left.left.left);
                        let goal = λ (x: BitVec(64)) (w: BitVec(64)) =>
                            site.Resident(stack.writes.store(s.memory, x, [low_byte(w)])) ∧
                                ready(after, s.gprs, stack.writes.store(s.memory, x, [low_byte(w)]));
                        let done: goal(cell, values(64, store.value)) =
                            ⟨loan.keeps_code(s.memory, store.buffer, k, written, inside, byte,
                                assemble(no_fills(), site.program, site.last), next_rip(site.origin, 0), resident),
                             ⟨held.left, ⟨held.right.left, stack.trail_put(top, lending, loan, d, s0.memory, before, s.memory,
                                held.right.right, store.buffer, k, written, inside, byte)⟩⟩⟩;
                        ⟨plain, ⟨j(sym(at), λ x _ => stack.writes.writable(s.memory, x, 1),
                                loan.writable(s.memory, store.buffer, k, written, inside)),
                            j(sym(at), λ x _ => goal(x, read_gpr(source.register, s.gprs)), j(value, λ w _ => goal(cell, w), done))⟩⟩
                    }),
                site.moves_load_byte(stack.writes, fits, within.witness, put, 0, the_load, within.proof,
                    λ (s: MachineState<M>) => ready(after, s.gprs, s.memory), post,
                    λ s held => {
                        let in_memory = held.right.right.right(store.buffer);
                        let ys = buffer_bytes(after, store.buffer);
                        let inside: (index.toNat() < ys.len()) = j(sym(in_memory.left), λ n _ => index.toNat() < n, held.left.right.right);
                        let reads = readable_at(site.data, s.memory, a, ys, in_memory.right, index, inside);
                        let read = buffer_byte(after, store.buffer, index.toNat());
                        let at = held.left.left.right;
                        Exists(read, ⟨j(sym(at), λ x _ => x.toNat() < Nat::pow(2, 47), reads.right.left),
                            ⟨j(sym(at), λ x _ => site.data.read(s.memory, x) = Some(read),
                                trans(reads.right.right, buffer_byte_at(after, store.buffer, index.toNat(), inside))),
                             ⟨address.file.represents_write(values, s.gprs, destination, Some(Held(store.output, Word)), read.zero_extend(56),
                                held.left.left.left, held.left.right.left),
                              ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, write_gpr(destination, read.zero_extend(56), s.gprs),
                                held.right.left, kept_write(body_kept(saves), destination, read.zero_extend(56), s.gprs, kept.right)),
                               held.right.right⟩⟩⟩⟩)
                    })))
     }⟩
}

theorem File::store_at_runs<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, home: Lent, store: Store, destination: Gpr, placement: List<Place>,
    names: Nat, same: home.buffer = store.buffer, written: lending.written(store.buffer) = True, before, after: Buffers()):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        store.Runs(values, before, after) ∧ home.Holds(values, lending.addresses, lending.buffers), before, after,
        file.store_at(saves, prog, home, store, destination, placement, names)) {
    let facts = store.Runs(values, before, after) ∧ home.Holds(values, lending.addresses, lending.buffers);
    let stored = store.after(values, before);
    let core = (values(64, store.output) = byte_word(buffer_byte(stored, store.buffer, values(64, store.index).toNat()))) ∧
        home.Holds(values, lending.addresses, lending.buffers);
    match bounded: file.bounded(store.index, home.length) {
        False => trivial,
        True => (match file.address(destination, home.base, store.index) as λ a =>
            a.All(λ (out: Lowered) => Addressed<M>(values, file, destination, home.base, store.index, out)) →
            MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match a {
                None => None,
                Some(address) => match address.file.find(Held(store.value, Word)) {
                    None => None,
                    Some(source) => match (leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves))) &&
                        store_base_plain(destination) {
                        False => None,
                        True => Some(Emitted(At(At(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register))), 0,
                                LoadByte(ByteLoad(destination, destination))),
                            address.file.write(destination, Some(Held(store.output, Word))), placement, names)),
                    },
                },
            }) {
            None => λ _ => trivial,
            Some(address) => λ addressed => match address.file.find(Held(store.value, Word)) as λ f =>
                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match f {
                    None => None,
                    Some(source) => match (leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves))) &&
                        store_base_plain(destination) {
                        False => None,
                        True => Some(Emitted(At(At(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register))), 0,
                                LoadByte(ByteLoad(destination, destination))),
                            address.file.write(destination, Some(Held(store.output, Word))), placement, names)),
                    },
                }) {
                None => trivial,
                Some(source) => match kept: (leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves))) &&
                    store_base_plain(destination) {
                    False => trivial,
                    True => {
                        let emitted = Emitted(At(At(At(prog, 0, Block(address.code)), 0, StoreByte(ByteStore(destination, source.register))), 0,
                                LoadByte(ByteLoad(destination, destination))),
                            address.file.write(destination, Some(Held(store.output, Word))), placement, names);
                        let all = Bool::is_true_and(leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves)),
                            store_base_plain(destination),
                            is_true_of_eq((leaves_all(address.code, body_kept(saves)) && destination.apart(body_kept(saves))) &&
                                store_base_plain(destination), kept));
                        emits_over_at<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, stored, after,
                            λ held => held.left.left, emitted,
                            emits_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file, core, facts,
                                λ held => ⟨j(held.left.left, λ f _ =>
                                        values(64, store.output) = byte_word(buffer_byte(f, store.buffer, values(64, store.index).toNat())),
                                    held.left.right), held.right⟩,
                                before, stored, emitted,
                                store_emits<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, prog, file, home, store, destination,
                                    placement, names, same, written, is_true_of_eq(file.bounded(store.index, home.length), bounded), address,
                                    addressed, source,
                                    Bool::is_true_and(leaves_all(address.code, body_kept(saves)), destination.apart(body_kept(saves)), all.left),
                                    eq_true_of_is_true(store_base_plain(destination), all.right), before)))
                    },
                },
            },
        })(file.address_addressed<M>(values, destination, home.base, store.index)),
    }
}

theorem File::store_from_runs<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, store: Store, destination: Gpr, placement: List<Place>, names: Nat,
    written: lending.written(store.buffer) = True, before, after: Buffers(), homes: List<Lent>):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        store.Runs(values, before, after) ∧ HomesHold(homes, values, lending.addresses, lending.buffers), before, after,
        file.store_from(saves, prog, homes, store, destination, placement, names)) {
    match homes {
        Nil => trivial,
        Cons(home, rest) => {
            let all = store.Runs(values, before, after) ∧ HomesHold(Cons(home, rest), values, lending.addresses, lending.buffers);
            let one = store.Runs(values, before, after) ∧ home.Holds(values, lending.addresses, lending.buffers);
            let later = may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file,
                store.Runs(values, before, after) ∧ HomesHold(rest, values, lending.addresses, lending.buffers), all,
                λ held => ⟨held.left, held.right.right⟩, before, after, file.store_from(saves, prog, rest, store, destination, placement, names),
                file.store_from_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, prog, store, destination, placement, names,
                    written, before, after, rest));
            match same: home.buffer.same(store.buffer) {
                False => later,
                True => (match file.store_at(saves, prog, home, store, destination, placement, names) as λ e =>
                    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, one, before, after, e) →
                    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, all, before, after, match e {
                        None => file.store_from(saves, prog, rest, store, destination, placement, names),
                        Some(emitted) => Some(emitted),
                    }) {
                    None => λ _ => later,
                    Some(emitted) => λ emits => emits_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file, one, all,
                        λ held => ⟨held.left, held.right.left⟩, before, after, emitted, emits),
                })(file.store_at_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, prog, home, store, destination, placement,
                    names, home.buffer.same_sound(store.buffer, same), written, before, after)),
            }
        },
    }
}

// A leaf. One that stores nothing leaves the file, and its nodes hold over
// the file it starts from; one store sets its byte, into a buffer the
// lending lets the program write.
theorem emit_leaf_runs<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), values: Valuation(), d: Nat,
    s0: MachineState<M>, under: d + 64 <= top, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat,
    homes: List<Lent>, allowed: (b: Nat) → nodes_store(nodes, b).IsTrue() → lending.written(b) = True, before, after: Buffers()):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        NodesRun(nodes, values, before, after) ∧ HomesHold(homes, values, lending.addresses, lending.buffers), before, after,
        emit_leaf(saves, prog, file, nodes, placement, names, homes)) {
    let facts = NodesRun(nodes, values, before, after) ∧ HomesHold(homes, values, lending.addresses, lending.buffers);
    (match leaf_store(nodes) as λ found => leaf_store(nodes) = found →
        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match found {
            None => match nodes_quiet(nodes) { False => None, True => emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes) },
            Some(store) => file.emit_store(saves, prog, homes, store, placement, names),
        }) {
        None => λ _ => match quiet: nodes_quiet(nodes) {
            False => trivial,
            True => {
                let still = λ (held: facts) => nodes_run_still(values, nodes, before, after, is_true_of_eq(nodes_quiet(nodes), quiet), held.left);
                may_emit_over_still<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, λ held => still(held).left,
                    emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes),
                    may_emit_over_of_in<M>(saves, site, stack, top, lending, loan, values, d, s0, under, prog, file, facts, before,
                        emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes),
                        emit_quiet_leaf_grows(saves, prog, file, nodes, placement, names, homes),
                        λ s lent shaped => may_emit_in_weaken<M>(saves, site, stack, values, d, s, prog, file,
                            NodesHoldOver(before, values, nodes) ∧ HomesHold(homes, values, lending.addresses, before), facts,
                            λ held => ⟨still(held).right,
                                homes_hold_shaped(values, lending.addresses, lending.buffers, before, λ b => sym(shaped(b)), homes, held.right)⟩,
                            emit_quiet_leaf(saves, prog, file, nodes, placement, names, homes),
                            emit_quiet_leaf_emits<M>(saves, site, laid, stack, lending.over(before), values, d, s, lent, prog, file, nodes, placement,
                                names, homes))))
            },
        },
        Some(store) => λ found => {
            let one = store.Runs(values, before, after) ∧ HomesHold(homes, values, lending.addresses, lending.buffers);
            may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file, one, facts,
                λ held => ⟨leaf_store_runs(values, before, after, nodes, store, found, held.left), held.right⟩, before, after,
                file.emit_store(saves, prog, homes, store, placement, names),
                match placement as λ p => MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, one, before, after,
                    file.emit_store(saves, prog, homes, store, p, names)) {
                    Nil => trivial,
                    Cons(place, rest) => match place as λ q => MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, one, before,
                        after, file.emit_store(saves, prog, homes, store, Cons(q, rest), names)) {
                        Folded => trivial,
                        Saving(_) => trivial,
                        Into(destination) => file.store_from_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, prog, store,
                            destination, rest, names, allowed(store.buffer, leaf_store_stores(nodes, store, found)), before, after, homes),
                    },
                })
        },
    })(refl)
}

// ---------------------------------------------------------------------------
// Conditionals

theorem when_nonzero_over(effects: Effects(), values: Valuation(), inputs: Ports, condition: Nat, arguments, outputs: Ports,
    when_true, when_false: StructuredRegion, before, after: Buffers(), clear: !values(1, condition).head_bit() = False,
    ran: StructuredRegionRunsOver(effects, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false), before, after)):
    StructuredRegionRunsOver(effects, values, when_true, before, after) {
    (match values(1, condition).head_bit() as λ h => !h = False →
        (match h {
            False => StructuredRegionRunsOver(effects, values, when_false, before, after),
            True => StructuredRegionRunsOver(effects, values, when_true, before, after),
        }) →
        StructuredRegionRunsOver(effects, values, when_true, before, after) {
        False => λ no _ => absurd(no),
        True => λ _ held => held,
    })(clear, ran)
}

theorem when_zero_over(effects: Effects(), values: Valuation(), inputs: Ports, condition: Nat, arguments, outputs: Ports,
    when_true, when_false: StructuredRegion, before, after: Buffers(), set: !values(1, condition).head_bit() = True,
    ran: StructuredRegionRunsOver(effects, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false), before, after)):
    StructuredRegionRunsOver(effects, values, when_false, before, after) {
    (match values(1, condition).head_bit() as λ h => !h = True →
        (match h {
            False => StructuredRegionRunsOver(effects, values, when_false, before, after),
            True => StructuredRegionRunsOver(effects, values, when_true, before, after),
        }) →
        StructuredRegionRunsOver(effects, values, when_false, before, after) {
        False => λ _ held => held,
        True => λ no _ => absurd(no),
    })(set, ran)
}

// A bit whose negation is clear is set.
theorem not_false(b: Bool, clear: !b = False): b = True {
    (match b as λ c => !c = False → c = True { False => λ no => absurd(no), True => λ _ => refl })(clear)
}

// And one whose negation is set is clear.
theorem not_true(b: Bool, set: !b = True): b = False {
    (match b as λ c => !c = True → c = False { False => λ _ => refl, True => λ no => absurd(no) })(set)
}

theorem branch_emits_over<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    lending: Lending, effects: Effects(), values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    inputs: Ports, condition: Nat, arguments, outputs: Ports, when_true, when_false: StructuredRegion, scope: Type, before, after: Buffers(),
    tested: Tested(file, condition), names: Nat, yes, no: Emitted,
    yes_emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)),
        StructuredRegionRunsOver(effects, values, when_true, before, after) ∧ scope, before, after, yes),
    no_emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)),
        StructuredRegionRunsOver(effects, values, when_false, before, after) ∧ scope, before, after, no)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        StructuredRegionRunsOver(effects, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false), before, after) ∧ scope,
        before, after, Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)) {
    let test = tested.test;
    let else_name = Succ(names);
    let join_name = Succ(Succ(names));
    let branched = prog.branched(test, else_name);
    let jumped = At(yes.prog, 0, Jmp(join_name));
    let second = yes.prog.else_label(else_name, join_name);
    let to_branch = prog.within_step(prog.tested(test), 0, Jcc(test.cc(), else_name),
        prog.within_then(0, Block([test.instruction()])));
    let to_second = prog.within_step(jumped, else_name, Block([]),
        prog.within_step(yes.prog, 0, Jmp(join_name), prog.within_trans(branched, yes.prog, to_branch, yes_emits.left)));
    let holds = StructuredRegionRunsOver(effects, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false), before, after) ∧
        scope;
    let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ holds) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.Trail(lending, d, s0.memory, before, m));
    let post = λ (g: Gprs) (m: M) => yes.file.meet(no.file, file.known).Represents(values, g) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ stack.Trail(lending, d, s0.memory, after, m));
    let known = KnownHold(values, file.known);
    ⟨prog.within_step(no.prog, join_name, Block([]), prog.within_trans(second, no.prog, to_second, no_emits.left)),
     λ within => {
        let program = site.program;
        let labels = asm_labels(program);
        let unique = program.laid_out_unique(laid);
        let lands = program.laid_out_lands(laid);
        let no_in = no.prog.within_before(join_name, Block([]), program, within);
        let second_in = second.within_trans(no.prog, program, no_emits.left, no_in);
        let jumped_in = jumped.within_before(else_name, Block([]), program, second_in);
        let yes_in = yes.prog.within_before(0, Jmp(join_name), program, jumped_in);
        let branched_in = branched.within_trans(yes.prog, program, yes_emits.left, yes_in);
        let tested_in = prog.tested(test).within_before(0, Jcc(test.cc(), else_name), program, branched_in);
        let else_lands = j(label_target(second_in.witness, program, jumped, names, Block([]), unique, second_in.proof),
            λ to _ => JumpsForward(prog_len(prog.tested(test)), 6,
                asm_jump_of(labels, prog_len(prog.tested(test)), Jcc(test.cc(), else_name)), to),
            jcc_lands(labels, branched_in.witness, program, prog.tested(test), 0, test.cc(), else_name, lands, branched_in.proof));
        let join_lands = j(label_target(within.witness, program, no.prog, Succ(names), Block([]), unique, within.proof),
            λ to _ => NearLands(prog_len(yes.prog), asm_jump_of(labels, prog_len(yes.prog), Jmp(join_name)), to),
            jmp_lands(labels, jumped_in.witness, program, yes.prog, 0, join_name, lands, jumped_in.proof));
        let selects = tested.selects(values);
        site.moves_branch_on(stack.writes, program.laid_out_fits(laid), prog, test, else_name, join_name, yes.prog, no.prog,
            tested_in.witness, tested_in.proof, branched_in.witness, branched_in.proof, jumped_in.witness, jumped_in.proof,
            else_lands, join_lands, pre, post,
            site.moves_weaken(stack.writes, prog_len(branched), prog_len(yes.prog),
                λ (s: MachineState<M>) => ((file.know(Truth(condition)).Represents(values, s.gprs) ∧
                    (StructuredRegionRunsOver(effects, values, when_true, before, after) ∧ scope)) ∧ stack.Trailed(saves, lending, d, s0, before, s)) ∧ known,
                λ (t: MachineState<M>) => (yes.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t)) ∧ known,
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = False,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_carry(stack.writes, prog_len(branched), prog_len(yes.prog),
                    λ (s: MachineState<M>) => (file.know(Truth(condition)).Represents(values, s.gprs) ∧
                        (StructuredRegionRunsOver(effects, values, when_true, before, after) ∧ scope)) ∧ stack.Trailed(saves, lending, d, s0, before, s),
                    λ (t: MachineState<M>) => yes.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t), known, yes_emits.right(yes_in)),
                λ s held => {
                    let clear: (!values(1, condition).head_bit() = False) = trans(sym(selects(s.gprs, held.left.left.left)), held.right);
                    ⟨⟨⟨file.represents_know(values, s.gprs, Truth(condition), held.left.left.left, not_false(values(1, condition).head_bit(), clear)),
                        ⟨when_nonzero_over(effects, values, inputs, condition, arguments, outputs, when_true, when_false, before, after, clear,
                            held.left.left.right.left), held.left.left.right.right⟩⟩, held.left.right⟩,
                     held.left.left.left.right⟩
                },
                λ t held => ⟨yes.file.meet_left(values, t.gprs, no.file, file.known, held.left.left, held.right), held.left.right⟩),
            site.moves_weaken(stack.writes, prog_len(second), prog_len(no.prog),
                λ (s: MachineState<M>) => ((file.know(Falsity(condition)).Represents(values, s.gprs) ∧
                    (StructuredRegionRunsOver(effects, values, when_false, before, after) ∧ scope)) ∧ stack.Trailed(saves, lending, d, s0, before, s)) ∧ known,
                λ (t: MachineState<M>) => (no.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t)) ∧ known,
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ test.taken(s.gprs) = True,
                λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_carry(stack.writes, prog_len(second), prog_len(no.prog),
                    λ (s: MachineState<M>) => (file.know(Falsity(condition)).Represents(values, s.gprs) ∧
                        (StructuredRegionRunsOver(effects, values, when_false, before, after) ∧ scope)) ∧ stack.Trailed(saves, lending, d, s0, before, s),
                    λ (t: MachineState<M>) => no.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t), known, no_emits.right(no_in)),
                λ s held => {
                    let set: (!values(1, condition).head_bit() = True) = trans(sym(selects(s.gprs, held.left.left.left)), held.right);
                    ⟨⟨⟨file.represents_know(values, s.gprs, Falsity(condition), held.left.left.left, not_true(values(1, condition).head_bit(), set)),
                        ⟨when_zero_over(effects, values, inputs, condition, arguments, outputs, when_true, when_false, before, after, set,
                            held.left.left.right.left), held.left.left.right.right⟩⟩, held.left.right⟩,
                     held.left.left.left.right⟩
                },
                λ t held => ⟨yes.file.meet_right(values, t.gprs, no.file, file.known, held.left.left, held.right), held.left.right⟩))
     }⟩
}

// ---------------------------------------------------------------------------
// Calls

// The stack pointer as the lowering and the raising leave it.
fn stack_lowered(count: Nat, gprs: Gprs) → Gprs {
    match count {
        Zero => gprs,
        Succ(_) => write_gpr(Rsp, read_gpr(Rsp, gprs).add(BitVec::ofNat(256 - 8 * count, n := 8).sign_extend(56)), gprs),
    }
}
fn stack_raised(count: Nat, gprs: Gprs) → Gprs {
    match count {
        Zero => gprs,
        Succ(_) => write_gpr(Rsp, read_gpr(Rsp, gprs).add(BitVec::ofNat(8 * count, n := 8).sign_extend(56)), gprs),
    }
}

theorem lowered_runs<M>(count: Nat, x: MachineState<M>): execute_block_normal(stack_lower(count), x).gprs = stack_lowered(count, x.gprs) {
    match count { Zero => refl, Succ(_) => refl }
}
theorem raised_runs<M>(count: Nat, x: MachineState<M>): execute_block_normal(stack_raise(count), x).gprs = stack_raised(count, x.gprs) {
    match count { Zero => refl, Succ(_) => refl }
}

// The immediates read as the distances they move the stack pointer.
theorem lower_reading(a: Nat, few: Succ(a) <= 2):
    BitVec::ofNat(256 - 8 * Succ(a), n := 8).sign_extend(56).toNat() = Nat::pow(2, 64) - 8 * Succ(a) {
    match a {
        Zero => refl,
        Succ(b) => match b {
            Zero => refl,
            Succ(c) => match c { Zero => refl, Succ(_) => { let no: False = { omega }; match no {} } },
        },
    }
}
theorem raise_reading(a: Nat, few: Succ(a) <= 2): BitVec::ofNat(8 * Succ(a), n := 8).sign_extend(56).toNat() = 8 * Succ(a) {
    match a {
        Zero => refl,
        Succ(b) => match b {
            Zero => refl,
            Succ(c) => match c { Zero => refl, Succ(_) => { let no: False = { omega }; match no {} } },
        },
    }
}

// Adding an immediate that reads as `2^64 - n` moves an offset `n` down,
// and one that reads as `n` moves it up.
theorem Stack::down_by<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, n: Nat, c: BitVec(8),
    reading: c.sign_extend(56).toNat() = Nat::pow(2, 64) - n, small: n <= 128, deep: n <= d):
    stack.at(d).add(c.sign_extend(56)) = stack.at(d - n) {
    let back: ((d - n) + n = d) = Nat::sub_add_cancel(n, d, deep);
    let count: (((d - n) + n) + (Nat::pow(2, 64) - n) = (d - n) + Nat::pow(2, 64)) = { omega };
    trans(cong_fn<Nat, BitVec(64)>(λ m => next_rip(stack.low, m).add(c.sign_extend(56)), sym(back)),
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(stack.low, (d - n) + n), c.sign_extend(56))),
    trans(rip_count(next_rip(stack.low, (d - n) + n), reading),
    trans(rip_compose(stack.low, (d - n) + n, Nat::pow(2, 64) - n),
    trans(rip_count(stack.low, count),
    trans(sym(rip_compose(stack.low, d - n, Nat::pow(2, 64))), BitVec::iterate_increment_period(64, next_rip(stack.low, d - n))))))))
}
theorem Stack::up_by<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, n: Nat, c: BitVec(8),
    reading: c.sign_extend(56).toNat() = n, deep: n <= d):
    stack.at(d - n).add(c.sign_extend(56)) = stack.at(d) {
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(stack.low, d - n), c.sign_extend(56))),
    trans(rip_count(next_rip(stack.low, d - n), reading),
    trans(rip_compose(stack.low, d - n, n), cong_fn<Nat, BitVec(64)>(λ m => next_rip(stack.low, m), Nat::sub_add_cancel(n, d, deep)))))
}

// Lowered from the frame at `d`: the stack pointer `count` words below
// it, every other register as it was.
theorem Stack::lowered_at<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, count: Nat,
    few: count <= 2, deep: 24 <= d, gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d)):
    read_gpr(Rsp, stack_lowered(count, gprs)) = stack.at(d - 8 * count) {
    match count {
        Zero => {
            let zero: (d = d - 8 * 0) = { omega };
            trans(rsp, cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), zero))
        },
        Succ(a) => {
            let c = BitVec::ofNat(256 - 8 * Succ(a), n := 8);
            trans(read_gpr_after_write(Rsp, read_gpr(Rsp, gprs).add(c.sign_extend(56)), gprs),
                trans(cong_fn<BitVec(64), BitVec(64)>(λ w => w.add(c.sign_extend(56)), rsp),
                    stack.down_by(d, 8 * Succ(a), c, lower_reading(a, few), { omega }, { omega })))
        },
    }
}

theorem Stack::lowered_agree<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, count: Nat,
    few: count <= 2, deep: 24 <= d, gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d)):
    GprsAgree(stack_lowered(count, gprs), write_gpr(Rsp, stack.at(d - 8 * count), gprs)) {
    let moved = stack.lowered_at(d, count, few, deep, gprs, rsp);
    match count {
        Zero => j(moved, λ w _ => GprsAgree(gprs, write_gpr(Rsp, w, gprs)), gprs_agree_write_read(Rsp, gprs)),
        Succ(a) => {
            let word = read_gpr(Rsp, gprs).add(BitVec::ofNat(256 - 8 * Succ(a), n := 8).sign_extend(56));
            j(moved, λ w _ => GprsAgree(write_gpr(Rsp, word, gprs), write_gpr(Rsp, w, gprs)), λ q => refl)
        },
    }
}

// Writing the stack pointer keeps the rest.
theorem kept_past_rsp(gprs: Gprs, word: BitVec(64)): Kept(callee_kept(), gprs, write_gpr(Rsp, word, gprs)) {
    ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩
}

// Raised from `count` words below the frame: the stack pointer back at
// it, RAX and the kept registers as they were.
theorem Stack::raised_at<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, count: Nat,
    few: count <= 2, deep: 24 <= d, gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d - 8 * count)):
    (read_gpr(Rsp, stack_raised(count, gprs)) = stack.at(d)) ∧
        ((read_gpr(Rax, stack_raised(count, gprs)) = read_gpr(Rax, gprs)) ∧ Kept(callee_kept(), gprs, stack_raised(count, gprs))) {
    match count {
        Zero => {
            let zero: (d - 8 * 0 = d) = { omega };
            ⟨trans(rsp, cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), zero)), ⟨refl, kept_refl(callee_kept(), gprs)⟩⟩
        },
        Succ(a) => {
            let c = BitVec::ofNat(8 * Succ(a), n := 8);
            let word = read_gpr(Rsp, gprs).add(c.sign_extend(56));
            ⟨trans(read_gpr_after_write(Rsp, word, gprs),
                trans(cong_fn<BitVec(64), BitVec(64)>(λ w => w.add(c.sign_extend(56)), rsp),
                    stack.up_by(d, 8 * Succ(a), c, raise_reading(a, few), { omega }))),
             ⟨refl, kept_past_rsp(gprs, word)⟩⟩
        },
    }
}

theorem kept_agree(registers: List<Gpr>, before, left, right: Gprs, agree: GprsAgree(left, right)):
    Kept(registers, before, right) → Kept(registers, before, left) {
    match registers {
        Nil => λ _ => trivial,
        Cons(register, rest) => λ kept => ⟨trans(agree(register), kept.left), kept_agree(rest, before, left, right, agree, kept.right)⟩,
    }
}

// What a call's code has done once the words it passes on the stack are
// there (`count` of them): the file `file` (the caller's, the stack
// pointer no word of it) in the registers, the callee-saved registers as at
// the call's start (`g0`) and the stack pointer below the words, the trail
// over the file `now`, the saved registers' words in their slots, and the
// arguments past the sixth from the stack pointer up.
fn Stack::Staged<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending,
    values: Valuation(), d: Nat, s0: MachineState<M>, now: Buffers(), g0: Gprs, file: File, count: Nat, arguments: List<Nat>,
    x: MachineState<M>) → Type {
    (file.Represents(values, x.gprs) ∧ (Kept(callee_kept(), g0, x.gprs) ∧ (read_gpr(Rsp, x.gprs) = stack.at(d - 8 * count)))) ∧
        ((stack.Trail(lending, d, s0.memory, now, x.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, x.memory)) ∧
            stack.Passes(words_of(values, arguments.drop(6)), Nil, d - 8 * count, g0, x.memory))
}

// What a call's code has done by its CALL: the stack pointer `count`
// words below the frame, the words passed (`Passes`, from it up), the
// callee-saved registers as at the call's start (`g0`), the trail over the
// file `now`, and the saved registers' words in their slots.
fn Stack::ArgsReady<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    s0: MachineState<M>, now: Buffers(), g0: Gprs, count: Nat, words: List<BitVec(64)>, x: MachineState<M>) → Type {
    (read_gpr(Rsp, x.gprs) = stack.at(d - 8 * count)) ∧ (stack.Passes(words, argument_registers(), d - 8 * count, x.gprs, x.memory) ∧
        (Kept(callee_kept(), g0, x.gprs) ∧
            (stack.Trail(lending, d, s0.memory, now, x.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, x.memory))))
}

// And after it: the stack pointer where the CALL left from, the answer in
// RAX, the rest kept, over the file the callee left.
fn Stack::Called<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    s0: MachineState<M>, now: Buffers(), g0: Gprs, count: Nat, answer: BitVec(64), t: MachineState<M>) → Type {
    (read_gpr(Rsp, t.gprs) = stack.at(d - 8 * count)) ∧ ((read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), g0, t.gprs) ∧
        (stack.Trail(lending, d, s0.memory, now, t.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, t.memory))))
}

// And with the stack pointer back at the frame.
fn Stack::Returned<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    s0: MachineState<M>, now: Buffers(), g0: Gprs, answer: BitVec(64), t: MachineState<M>) → Type {
    (read_gpr(Rsp, t.gprs) = stack.at(d)) ∧ ((read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), g0, t.gprs) ∧
        (stack.Trail(lending, d, s0.memory, now, t.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, t.memory))))
}

// The CALL, against the callee's contract: the return address is a word
// below the words passed on the stack, the callee is entered under the
// lending `inner` over the file `inner_before`, and what it stores are
// words below that and bytes of the buffers, which leave the slots the
// caller saved its registers in and the words it passed. A call's callee is
// entered under the caller's lending over the caller's file; a call over
// views, under the views' (`Lending::lend`) over the windows. `enters` and
// `leaves` are what relates the two: the caller's file in memory is the
// callee's, and what the callee stored and left is stored under the
// caller's spans and leaves the caller's file.
theorem call_step<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), bound: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    inner: Lending, d: Nat, s0: MachineState<M>,
    room: 136 * bound + 24 <= d, fits: d + 64 <= stack.size, under: d + 72 <= top, prog: Prog, callee: Nat, below: Succ(callee) <= bound,
    count: Nat, few: count <= 2,
    words: List<BitVec(64)>, answer: BitVec(64), before, after, inner_before, inner_after: Buffers(),
    answered: effects(inner_before, callee, words, answer, inner_after),
    returns: site.Returns(stack, asm_labels(site.program)(Succ(callee)),
        stack.CalledOver(effects, inner, top, callee, words, answer, inner_before, inner_after),
        stack.AnsweredOver(inner, answer, inner_after)),
    args_lent: ArgsLent(lent_count(inner.counts, callee), 0, words, inner.addresses, inner.buffers),
    enters: (memory: M) → stack.InMemory(lending, before, memory) → stack.InMemory(inner, inner_before, memory),
    leaves: (u, t: M) → stack.InMemory(lending, before, u) → stack.WroteIn((d - 8 * count) - 8, inner.spans(), u, t) →
        stack.InMemory(inner, inner_after, t) →
        stack.WroteIn((d - 8 * count) - 8, lending.spans(), u, t) ∧ stack.InMemory(lending, after, t),
    g0: Gprs, k: Nat, at: asm_back(site.program, k) = At(prog, 0, CallTo(Succ(callee)))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + 5,
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words, x),
        λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, count, answer, t)) {
    let spans = lending.spans();
    let c = d - 8 * count;
    let back: ((c - 8) + 8 = c) = Nat::sub_add_cancel(8, c, { omega });
    let entered: ((c - 8) + 8 <= stack.size) = { omega };
    let deep: (136 * Succ(callee) <= c - 8) = { omega };
    let below_top: ((c - 8) + 8 <= top) = { omega };
    let eight: (saved_registers().len() = 8) = refl;
    let slots: (d + 8 * (0 + saved_registers().len()) <= top) = { omega };
    let at_c: (stack.at((c - 8) + 8) = stack.at(c)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
    let displacement = asm_jump_of(asm_labels(site.program), prog_len(prog), CallTo(Succ(callee)));
    let pushes: (x: MachineState<M>) → stack.ArgsReady(lending, d, s0, before, g0, count, words, x) →
        (read_gpr(Rsp, x.gprs) = stack.at((c - 8) + 8)) ∧ (stack.Wrote(d, x.memory, call_near_after(stack.writes, displacement, x).memory) ∧
            (stack.Trail(lending, d, s0.memory, before, call_near_after(stack.writes, displacement, x).memory) ∧
             stack.Passed(words, c - 8, call_near_after(stack.writes, displacement, x)))) = λ x held => {
        let rsp_x: (read_gpr(Rsp, x.gprs) = stack.at((c - 8) + 8)) = trans(held.left, sym(at_c));
        let pushed: (push_address(x.gprs) = stack.at(c - 8)) =
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.sub(BitVec::ofNat(8)), rsp_x), push_at(stack.low, c - 8));
        let ret = word_bytes(next_rip(x.rip, 5));
        let own: stack.Wrote(d, x.memory, call_near_after(stack.writes, displacement, x).memory) =
            j(sym(pushed), λ a _ => stack.Wrote(d, x.memory, stack.writes.store(x.memory, a, ret)),
                stack.wrote_store(d, x.memory, c - 8, { omega }, next_rip(x.rip, 5)));
        let trail: stack.Trail(lending, d, s0.memory, before, call_near_after(stack.writes, displacement, x).memory) =
            j(sym(pushed), λ a _ => stack.Trail(lending, d, s0.memory, before, stack.writes.store(x.memory, a, ret)),
                stack.trail_store(top, lending, loan, d, { omega }, s0.memory, before, x.memory, held.right.right.right.left, c - 8, { omega },
                    next_rip(x.rip, 5)));
        let above: stack.Unchanged(c, x.memory, call_near_after(stack.writes, displacement, x).memory) =
            j(sym(pushed), λ a _ => stack.Unchanged(c, x.memory, stack.writes.store(x.memory, a, ret)),
                stack.store_below(x.memory, c - 8, c, { omega }, { omega }, next_rip(x.rip, 5)));
        let passed_x: stack.Passes(words, argument_registers(), (c - 8) + 8, x.gprs, x.memory) =
            j(sym(back), λ n _ => stack.Passes(words, argument_registers(), n, x.gprs, x.memory), held.right.left);
        let passed: stack.Passed(words, c - 8, call_near_after(stack.writes, displacement, x)) =
            stack.passes_after_write(words, argument_registers(), (c - 8) + 8, x.gprs, call_near_after(stack.writes, displacement, x).memory,
                Rsp, push_address(x.gprs), trivial,
                stack.passes_unchanged(c, x.memory, call_near_after(stack.writes, displacement, x).memory, above, words, argument_registers(),
                    (c - 8) + 8, x.gprs, { omega }, passed_x));
        ⟨rsp_x, ⟨own, ⟨trail, passed⟩⟩⟩
    };
    site.moves_call(stack, site.program.laid_out_fits(laid), k, prog, 0, Succ(callee), at,
        asm_labels(site.program)(Succ(callee)),
        call_lands(asm_labels(site.program), k, site.program, prog, 0, Succ(callee), site.program.laid_out_lands(laid), at),
        stack.CalledOver(effects, inner, top, callee, words, answer, inner_before, inner_after),
        stack.AnsweredOver(inner, answer, inner_after), returns,
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words, x),
        λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, count, answer, t),
        λ _ => c - 8,
        λ x held => {
            let pushed = pushes(x, held);
            ⟨pushed.left, ⟨entered, ⟨⟨pushed.right.right.right, ⟨answered, deep⟩⟩, ⟨args_lent, ⟨below_top,
                enters(call_near_after(stack.writes, displacement, x).memory, pushed.right.right.left.right)⟩⟩⟩⟩⟩
        },
        λ x t held rsp_t returned => {
            let pushed = pushes(x, held);
            let u = call_near_after(stack.writes, displacement, x);
            let handed = leaves(u.memory, t.memory, pushed.right.right.left.right, returned.right.right.left, returned.right.right.right);
            let callee_wrote: stack.WroteIn(d, spans, u.memory, t.memory) =
                stack.wrote_in_deeper(c - 8, d, { omega }, spans, u.memory, t.memory, handed.left);
            let wrote: stack.WroteIn(d, spans, x.memory, t.memory) = stack.wrote_in_trans(d, spans, x.memory, u.memory, t.memory,
                stack.wrote_in_own(d, spans, x.memory, u.memory, pushed.right.left), callee_wrote);
            let unchanged = loan.unchanged(d, x.memory, t.memory, wrote);
            let kept_u: Kept(callee_kept(), x.gprs, t.gprs) = returned.right.left;
            ⟨trans(rsp_t, at_c), ⟨returned.left, ⟨kept_trans(callee_kept(), g0, x.gprs, t.gprs, held.right.right.left, kept_u),
              ⟨⟨stack.wrote_in_trans(d + 64, spans, s0.memory, u.memory, t.memory, pushed.right.right.left.left,
                    stack.wrote_in_deeper(d, d + 64, { omega }, spans, u.memory, t.memory, callee_wrote)), handed.right⟩,
               stack.saved_unchanged(d, top, g0, x.memory, t.memory, unchanged, saved_registers(), 0, slots,
                    held.right.right.right.right)⟩⟩⟩⟩
        })
}

// After the reloads: the file before the call, with the answer in RAX.
theorem call_restores(values: Valuation(), file: File, result: Nat, before, after: Gprs,
    represents: file.Represents(values, before), rax: read_gpr(Rax, after) = values(64, result),
    kept: Kept(callee_kept(), before, after), rsp: read_gpr(Rsp, after) = read_gpr(Rsp, before)):
    file.write(Rax, Some(Held(result, Word))).Represents(values, restore(saved_registers(), before, after)) {
    ⟨λ query => match query {
        Rax => sym(rax),
        Rcx => represents.left(Rcx), Rdx => represents.left(Rdx),
        Rbx => j(sym(kept.left), λ w _ => SlotRep(values, file.at(Rbx), w), represents.left(Rbx)),
        Rsp => j(sym(rsp), λ w _ => SlotRep(values, file.at(Rsp), w), represents.left(Rsp)),
        Rbp => j(sym(kept.right.left), λ w _ => SlotRep(values, file.at(Rbp), w), represents.left(Rbp)),
        Rsi => represents.left(Rsi), Rdi => represents.left(Rdi), R8 => represents.left(R8), R9 => represents.left(R9),
        R10 => represents.left(R10), R11 => represents.left(R11),
        R12 => j(sym(kept.right.right.left), λ w _ => SlotRep(values, file.at(R12), w), represents.left(R12)),
        R13 => j(sym(kept.right.right.right.left), λ w _ => SlotRep(values, file.at(R13), w), represents.left(R13)),
        R14 => j(sym(kept.right.right.right.right.left), λ w _ => SlotRep(values, file.at(R14), w), represents.left(R14)),
        R15 => j(sym(kept.right.right.right.right.right.left), λ w _ => SlotRep(values, file.at(R15), w), represents.left(R15)),
    }, represents.right⟩
}

// A word in the slots lies below the frame's top.
theorem slot_inside(d, i, size: Nat, high: i + 8 <= d + 8 * (0 + saved_registers().len()), fits: d + 64 <= size):
    (i + 8 <= size) ∧ (i + 8 <= d + 64) {
    let eight: (saved_registers().len() = 8) = refl;
    ⟨{ omega }, { omega }⟩
}

// The spills: words of the frame, which keep the trail.
theorem call_spills<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), d: Nat, s0: MachineState<M>,
    fits: d + 64 <= stack.size, under: d + 64 <= top, now: Buffers(), prog: Prog,
    g0: Gprs, rsp_g0: read_gpr(Rsp, g0) = stack.at(d), within: saved_registers().spills(prog, 0).Within(site.program)):
    site.Moves(stack.writes, prog_len(prog), prog_len(saved_registers().spills(prog, 0)),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Trail(lending, d, s0.memory, now, x.memory),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Trail(lending, d, s0.memory, now, x.memory) ∧
            stack.Saved(d, saved_registers(), 0, g0, x.memory))) {
    let small: (0 + saved_registers().len() <= 16) = { omega };
    let slots: (d + 8 * (0 + saved_registers().len()) <= stack.size) = { omega };
    site.moves_spills(stack, site.program.laid_out_fits(laid), d, g0, rsp_g0, saved_registers(), prog, 0, small, slots,
        λ (m: M) => stack.Trail(lending, d, s0.memory, now, m),
        λ memory i low high word kept => {
            let inside = slot_inside(d, i, stack.size, high, fits);
            stack.trail_store(top, lending, loan, d, under, s0.memory, now, memory, kept, i, inside.right, word)
        },
        within)
}

// The stack pointer lowered past the `count` words a call passes on the
// stack, at most two, and each stored from the register that holds it
// (`sources`), below the frame: the trail and the saved registers' slots
// are kept. The stack pointer is no word of the file from here on
// (`staged`).
theorem call_stages<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), values: Valuation(), d: Nat, s0: MachineState<M>,
    fits: d + 64 <= stack.size, under: d + 64 <= top, deep: 24 <= d, now: Buffers(), prog: Prog, file: File, arguments: List<Nat>,
    sources: List<Gpr>, few: sources.len() <= 2, same: sources.len() = arguments.drop(6).len(),
    sourced: file.write(Rsp, None).outputs_check(word_ports(arguments.drop(6)), sources).IsTrue(),
    g0: Gprs, represents: file.Represents(values, g0), rsp_g0: read_gpr(Rsp, g0) = stack.at(d),
    within: call_staged(prog, sources).Within(site.program)):
    site.Moves(stack.writes, prog_len(saved_registers().spills(prog, 0)), prog_len(call_staged(prog, sources)),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧
            (stack.Trail(lending, d, s0.memory, now, x.memory) ∧ stack.Saved(d, saved_registers(), 0, g0, x.memory)),
        λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, now, g0, file.write(Rsp, None), sources.len(), arguments, x)) {
    let count = sources.len();
    let staged = file.write(Rsp, None);
    let spilled = saved_registers().spills(prog, 0);
    let lowered = At(spilled, 0, Block(stack_lower(count)));
    let g1 = stack_lowered(count, g0);
    let low = d - 8 * count;
    let frame = λ (m: M) => stack.Trail(lending, d, s0.memory, now, m) ∧ stack.Saved(d, saved_registers(), 0, g0, m);
    let lowered_in = lowered.within_trans(call_staged(prog, sources), site.program, Prog::within_spills(sources, lowered, 0), within);
    let first = site.moves_of_pure(stack.writes, prog_len(spilled), prog_len(spilled) + block_length(stack_lower(count)),
        λ (g: Gprs) (m: M) => (g = g0) ∧ frame(m), λ (g: Gprs) (m: M) => (g = g1) ∧ frame(m),
        λ memory => site.runs_block(site.program.laid_out_fits(laid), lowered_in.witness, spilled, 0, stack_lower(count), lowered_in.proof,
            site.program.block_reads_at(laid, lowered_in.witness, spilled, 0, stack_lower(count), lowered_in.proof),
            λ (g: Gprs) => (g = g0) ∧ frame(memory), λ (g: Gprs) => (g = g1) ∧ frame(memory),
            λ x held => ⟨trans(lowered_runs<M>(count, x), cong_fn<Gprs, Gprs>(λ g => stack_lowered(count, g), held.left)), held.right⟩));
    let moved: (read_gpr(Rsp, g1) = stack.at(low)) = stack.lowered_at(d, count, few, deep, g0, rsp_g0);
    let small: (0 + count <= 16) = { omega };
    let room: (low + 8 * (0 + count) <= stack.size) = { omega };
    let second = site.moves_spills(stack, site.program.laid_out_fits(laid), low, g1, moved, sources, lowered, 0, small, room, frame,
        λ memory i above high word held => {
            let inside: (i + 8 <= d) = { omega };
            ⟨stack.trail_store(top, lending, loan, d, under, s0.memory, now, memory, held.left, i, { omega }, word),
             stack.saved_unchanged(d, stack.size, g0, memory, stack.writes.store(memory, stack.at(i), word_bytes(word)),
                stack.store_below(memory, i, d, { omega }, inside, word), saved_registers(), 0, { omega }, held.right)⟩
        }, within);
    let agree = stack.lowered_agree(d, count, few, deep, g0, rsp_g0);
    let lowered_file: staged.Represents(values, g1) = staged.represents_agree(values, g1, write_gpr(Rsp, stack.at(low), g0), agree,
        file.represents_write(values, g0, Rsp, None, stack.at(low), represents, trivial));
    let words = words_of(values, arguments.drop(6));
    let args: ArgsIn(words, sources, g1) = ports_args(values, arguments.drop(6), sources, g1,
        outputs_check_sound(values, staged, g1, lowered_file, word_ports(arguments.drop(6)), sources, sourced));
    let length: (words.len() = count) = trans(words_of_len(values, arguments.drop(6)), sym(same));
    let kept1: Kept(callee_kept(), g0, g1) = kept_agree(callee_kept(), g0, g1, write_gpr(Rsp, stack.at(low), g0), agree,
        kept_past_rsp(g0, stack.at(low)));
    site.moves_trans(stack.writes, prog_len(spilled), prog_len(lowered), prog_len(call_staged(prog, sources)),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ frame(x.memory),
        λ (x: MachineState<M>) => (x.gprs = g1) ∧ frame(x.memory),
        λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, now, g0, staged, count, arguments, x),
        first,
        site.moves_weaken(stack.writes, prog_len(lowered), prog_len(call_staged(prog, sources)),
            λ (x: MachineState<M>) => (x.gprs = g1) ∧ frame(x.memory),
            λ (x: MachineState<M>) => (x.gprs = g1) ∧ (frame(x.memory) ∧ stack.Saved(low, sources, 0, g1, x.memory)),
            λ (x: MachineState<M>) => (x.gprs = g1) ∧ frame(x.memory),
            λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, now, g0, staged, count, arguments, x),
            second, λ x held => held,
            λ x held => {
                let stacked = stack.saved_passes(low, g1, g0, x.memory, words, sources, 0, { omega }, held.right.right, args);
                let zero: (low + 8 * 0 = low) = { omega };
                ⟨⟨j(sym(held.left), λ g _ => staged.Represents(values, g), lowered_file),
                  ⟨j(sym(held.left), λ g _ => Kept(callee_kept(), g0, g), kept1),
                   trans(cong_fn<Gprs, BitVec(64)>(λ g => read_gpr(Rsp, g), held.left), moved)⟩⟩,
                 ⟨held.right.left, j(zero, λ a _ => stack.Passes(words, Nil, a, g0, x.memory), stacked)⟩⟩
            }))
}

// The argument moves: the first six words into their registers, the rest
// on the stack as the stores before them left them.
theorem call_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    values: Valuation(), d: Nat, s0: MachineState<M>, now: Buffers(), prog: Prog, staged: File, arguments: List<Nat>, count: Nat,
    moves: Lowered, moves_keeps: Keeps<M>(values, staged, True, moves),
    placed: moves.file.outputs_check(word_ports(arguments.take(6)), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    g0: Gprs, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block(moves.code))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code),
        λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, now, g0, staged, count, arguments, x),
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, now, g0, count, words_of(values, arguments), x)) {
    let low = d - 8 * count;
    let rest = λ (m: M) => (stack.Trail(lending, d, s0.memory, now, m) ∧ stack.Saved(d, saved_registers(), 0, g0, m)) ∧
        stack.Passes(words_of(values, arguments.drop(6)), Nil, low, g0, m);
    let pre = λ (g: Gprs) (m: M) => (staged.Represents(values, g) ∧ (Kept(callee_kept(), g0, g) ∧ (read_gpr(Rsp, g) = stack.at(low)))) ∧ rest(m);
    let post = λ (g: Gprs) (m: M) => (read_gpr(Rsp, g) = stack.at(low)) ∧
        (stack.Passes(words_of(values, arguments), argument_registers(), low, g, m) ∧ (Kept(callee_kept(), g0, g) ∧
            (stack.Trail(lending, d, s0.memory, now, m) ∧ stack.Saved(d, saved_registers(), 0, g0, m))));
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, moves.code, at,
            site.program.block_reads_at(laid, k, prog, 0, moves.code, at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let y = execute_block_normal(moves.code, x);
                let kept_moves = moves_keeps(x, held.left.left, trivial);
                let args: ArgsIn(words_of(values, arguments.take(6)), argument_registers(), y.gprs) =
                    ports_args(values, arguments.take(6), argument_registers(), y.gprs,
                        outputs_check_sound(values, moves.file, y.gprs, kept_moves, word_ports(arguments.take(6)), argument_registers(), placed));
                let saved_y: Kept(callee_saved(), x.gprs, y.gprs) = execute_block_kept<M>(moves.code, x, callee_saved(), leaves);
                let firsts: ArgsIn(words_of(values, arguments).take(6), argument_registers(), y.gprs) =
                    j(sym(words_of_take(values, arguments, 6)), λ ws _ => ArgsIn(ws, argument_registers(), y.gprs), args);
                let stacked: stack.Passes(words_of(values, arguments).drop(6), Nil, low, y.gprs, memory) =
                    j(sym(words_of_drop(values, arguments, 6)), λ ws _ => stack.Passes(ws, Nil, low, y.gprs, memory),
                        stack.passes_nil_other(words_of(values, arguments.drop(6)), low, g0, y.gprs, memory, held.right.right));
                ⟨trans(saved_y.right.right.left, held.left.right.right),
                 ⟨stack.passes_join(words_of(values, arguments), argument_registers(), low, y.gprs, memory, firsts, stacked),
                  ⟨kept_trans(callee_kept(), g0, x.gprs, y.gprs, held.left.right.left, saved_kept(x.gprs, y.gprs, saved_y)),
                   held.right.left⟩⟩⟩
            }))
}

theorem saved_fit(d, size: Nat, fits: d + 64 <= size):
    (0 + saved_registers().len() <= 16) ∧ (d + 8 * (0 + saved_registers().len()) <= size) {
    let eight: (saved_registers().len() = 8) = refl;
    ⟨{ omega }, { omega }⟩
}

// The stack pointer back at the frame after the CALL.
theorem call_raises<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    d: Nat, s0: MachineState<M>, now: Buffers(), g0: Gprs, count: Nat, few: count <= 2, deep: 24 <= d, answer: BitVec(64),
    prog: Prog, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block(stack_raise(count)))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length(stack_raise(count)),
        λ (t: MachineState<M>) => stack.Called(lending, d, s0, now, g0, count, answer, t),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, now, g0, answer, t)) {
    let rest = λ (g: Gprs) (m: M) => (read_gpr(Rax, g) = answer) ∧ (Kept(callee_kept(), g0, g) ∧
        (stack.Trail(lending, d, s0.memory, now, m) ∧ stack.Saved(d, saved_registers(), 0, g0, m)));
    let pre = λ (g: Gprs) (m: M) => (read_gpr(Rsp, g) = stack.at(d - 8 * count)) ∧ rest(g, m);
    let post = λ (g: Gprs) (m: M) => (read_gpr(Rsp, g) = stack.at(d)) ∧ rest(g, m);
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(stack_raise(count)), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, stack_raise(count), at,
            site.program.block_reads_at(laid, k, prog, 0, stack_raise(count), at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let raised = stack.raised_at(d, count, few, deep, x.gprs, held.left);
                j(sym(raised_runs<M>(count, x)), λ g _ => post(g, memory),
                    ⟨raised.left, ⟨trans(raised.right.left, held.right.left),
                        ⟨kept_trans(callee_kept(), g0, x.gprs, stack_raised(count, x.gprs), held.right.right.left, raised.right.right),
                         held.right.right.right⟩⟩⟩)
            }))
}

// From the call's start to the stack pointer back after its return: the
// spills, the words passed on the stack, the argument moves, the CALL, the
// stack pointer raised. The CALL is `step`, whatever it is proved against
// (`call_step`, `lend_step`).
theorem call_returns<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, fits: d + 64 <= stack.size, under: d + 72 <= top, deep: 24 <= d,
    prog: Prog, file: File, callee: Nat, arguments: List<Nat>, result: Nat,
    sources: List<Gpr>, few: sources.len() <= 2, same: sources.len() = arguments.drop(6).len(),
    sourced: file.write(Rsp, None).outputs_check(word_ports(arguments.drop(6)), sources).IsTrue(),
    moves: Lowered, moves_keeps: Keeps<M>(values, file.write(Rsp, None), True, moves),
    placed: moves.file.outputs_check(word_ports(arguments.take(6)), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(),
    g0: Gprs, represents: file.Represents(values, g0), rsp_g0: read_gpr(Rsp, g0) = stack.at(d), before, after: Buffers(),
    step: (k: Nat) → asm_back(site.program, k) = At(At(call_staged(prog, sources), 0, Block(moves.code)), 0, CallTo(Succ(callee))) →
        site.Moves(stack.writes, prog_len(At(call_staged(prog, sources), 0, Block(moves.code))),
            prog_len(At(call_staged(prog, sources), 0, Block(moves.code))) + 5,
            λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, sources.len(), words_of(values, arguments), x),
            λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, sources.len(), values(64, result), t)),
    within: At(At(At(call_staged(prog, sources), 0, Block(moves.code)), 0, CallTo(Succ(callee))), 0,
        Block(stack_raise(sources.len()))).Within(site.program)):
    site.Moves(stack.writes, prog_len(prog),
        prog_len(At(At(At(call_staged(prog, sources), 0, Block(moves.code)), 0, CallTo(Succ(callee))), 0, Block(stack_raise(sources.len())))),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Trail(lending, d, s0.memory, before, x.memory),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, g0, values(64, result), t)) {
    let saved = saved_registers();
    let count = sources.len();
    let staged_file = file.write(Rsp, None);
    let spilled = saved.spills(prog, 0);
    let staged = call_staged(prog, sources);
    let moved = At(staged, 0, Block(moves.code));
    let called = At(moved, 0, CallTo(Succ(callee)));
    let raised = At(called, 0, Block(stack_raise(count)));
    let words = words_of(values, arguments);
    let answer = values(64, result);
    let called_in = called.within_before(0, Block(stack_raise(count)), site.program, within);
    let moved_in = moved.within_before(0, CallTo(Succ(callee)), site.program, called_in);
    let staged_in = staged.within_before(0, Block(moves.code), site.program, moved_in);
    let lowered = At(spilled, 0, Block(stack_lower(count)));
    let spilled_in = spilled.within_trans(staged, site.program,
        spilled.within_trans(lowered, staged, spilled.within_then(0, Block(stack_lower(count))), Prog::within_spills(sources, lowered, 0)),
        staged_in);
    site.moves_trans(stack.writes, prog_len(prog), prog_len(spilled), prog_len(raised),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ stack.Trail(lending, d, s0.memory, before, x.memory),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Trail(lending, d, s0.memory, before, x.memory) ∧ stack.Saved(d, saved, 0, g0, x.memory)),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, g0, answer, t),
        call_spills<M>(site, laid, stack, top, lending, loan, d, s0, fits, { omega }, before, prog, g0, rsp_g0, spilled_in),
    site.moves_trans(stack.writes, prog_len(spilled), prog_len(staged), prog_len(raised),
        λ (x: MachineState<M>) => (x.gprs = g0) ∧ (stack.Trail(lending, d, s0.memory, before, x.memory) ∧ stack.Saved(d, saved, 0, g0, x.memory)),
        λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, before, g0, staged_file, count, arguments, x),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, g0, answer, t),
        call_stages<M>(site, laid, stack, top, lending, loan, values, d, s0, fits, { omega }, deep, before, prog, file, arguments, sources, few,
            same, sourced, g0, represents, rsp_g0, staged_in),
    site.moves_trans(stack.writes, prog_len(staged), prog_len(moved), prog_len(raised),
        λ (x: MachineState<M>) => stack.Staged(lending, values, d, s0, before, g0, staged_file, count, arguments, x),
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words, x),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, g0, answer, t),
        call_moves<M>(site, laid, stack, lending, values, d, s0, before, staged, staged_file, arguments, count, moves, moves_keeps, placed,
            leaves, g0, moved_in.witness, moved_in.proof),
    site.moves_trans(stack.writes, prog_len(moved), prog_len(called), prog_len(raised),
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words, x),
        λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, count, answer, t),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, g0, answer, t),
        step(called_in.witness, called_in.proof),
        call_raises<M>(site, laid, stack, lending, d, s0, after, g0, count, few, deep, answer, called, within.witness, within.proof)))))
}

// The reloads write no callee-saved register, so they keep what the body
// keeps.
theorem reloads_keep(saved, after: Gprs): Kept(callee_saved(), after, restore(saved_registers(), saved, after)) {
    ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩
}

theorem kept_restored(saves: Nat, before, saved, after: Gprs, kept: Kept(body_kept(saves), before, after)):
    Kept(body_kept(saves), before, restore(saved_registers(), saved, after)) {
    let reloaded = restore(saved_registers(), saved, after);
    let all = reloads_keep(saved, after);
    kept_trans(body_kept(saves), before, after, reloaded, kept,
        body_kept_of(saves, after, reloaded, all.right.right.left, saved_kept(after, reloaded, all)))
}

// From the return through the reloads.
theorem call_finishes<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    values: Valuation(), d: Nat, s0: MachineState<M>, now: Buffers(), rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), fits: d + 64 <= stack.size,
    file: File, result: Nat, called: Prog, g0: Gprs, represents: file.Represents(values, g0),
    rsp_g0: read_gpr(Rsp, g0) = stack.at(d), kept_g0: Kept(body_kept(saves), s0.gprs, g0),
    within: saved_registers().reloads(called, 0).Within(site.program)):
    site.Moves(stack.writes, prog_len(called), prog_len(saved_registers().reloads(called, 0)),
        λ (t: MachineState<M>) => stack.Returned(lending, d, s0, now, g0, values(64, result), t),
        λ (t: MachineState<M>) => file.write(Rax, Some(Held(result, Word))).Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, now, t)) {
    let saved = saved_registers();
    let sizes = saved_fit(d, stack.size, fits);
    let out_file = file.write(Rax, Some(Held(result, Word)));
    λ s3 here resident after_call => {
        let reloading = site.moves_reloads(stack, site.program.laid_out_fits(laid), d, g0, saved, called, 0, s3.gprs, sizes.left,
            sizes.right, trivial, after_call.left, λ (m: M) => stack.Trail(lending, d, s0.memory, now, m), within);
        let e = reloading(s3, here, resident, ⟨refl, after_call.right.right.right⟩);
        let kept_s3: Kept(body_kept(saves), s0.gprs, s3.gprs) =
            kept_trans(body_kept(saves), s0.gprs, g0, s3.gprs, kept_g0,
                body_kept_of(saves, g0, s3.gprs, trans(after_call.left, sym(rsp_g0)), after_call.right.right.left));
        let finished = j(sym(e.proof.right.right.right.left), λ g _ => out_file.Represents(values, g) ∧ Kept(body_kept(saves), s0.gprs, g),
            ⟨call_restores(values, file, result, g0, s3.gprs, represents, after_call.right.left, after_call.right.right.left,
                trans(after_call.left, sym(rsp_g0))), kept_restored(saves, s0.gprs, g0, s3.gprs, kept_s3)⟩);
        Exists(e.witness, ⟨e.proof.left, ⟨e.proof.right.left, ⟨e.proof.right.right.left,
            ⟨finished.left, ⟨finished.right, e.proof.right.right.right.right⟩⟩⟩⟩⟩)
    }
}

// The call, its argument moves found: under `Facts`, from which the CALL
// The call, its sources and argument moves found: under `Facts`, from
// which the CALL is proved for the registers the call starts with.
theorem call_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>,
    rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), fits: d + 64 <= stack.size, under: d + 72 <= top, deep: 24 <= d,
    prog: Prog, file: File, callee: Nat, arguments: List<Nat>, result: Nat, placement: List<Place>, names: Nat,
    sources: List<Gpr>, few: sources.len() <= 2, same: sources.len() = arguments.drop(6).len(),
    sourced: file.write(Rsp, None).outputs_check(word_ports(arguments.drop(6)), sources).IsTrue(),
    moves: Lowered, moves_keeps: Keeps<M>(values, file.write(Rsp, None), True, moves),
    placed: moves.file.outputs_check(word_ports(arguments.take(6)), argument_registers()).IsTrue(),
    leaves: leaves_all(moves.code, callee_saved()).IsTrue(), Facts: Type, before, after: Buffers(),
    step: Facts → (g0: Gprs) → file.Represents(values, g0) → read_gpr(Rsp, g0) = stack.at(d) → (k: Nat) →
        asm_back(site.program, k) = At(At(call_staged(prog, sources), 0, Block(moves.code)), 0, CallTo(Succ(callee))) →
        site.Moves(stack.writes, prog_len(At(call_staged(prog, sources), 0, Block(moves.code))),
            prog_len(At(call_staged(prog, sources), 0, Block(moves.code))) + 5,
            λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, sources.len(), words_of(values, arguments), x),
            λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, sources.len(), values(64, result), t))):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts,
        before, after, Emitted(call_prog(prog, sources, moves.code, callee), file.write(Rax, Some(Held(result, Word))), placement, names)) {
    let called = At(At(call_staged(prog, sources), 0, Block(moves.code)), 0, CallTo(Succ(callee)));
    let raised = At(called, 0, Block(stack_raise(sources.len())));
    let out_prog = saved_registers().reloads(raised, 0);
    ⟨call_within(prog, sources, moves.code, callee),
     λ within s here resident holds => {
        let trailed: stack.Trailed(saves, lending, d, s0, before, s) = holds.right;
        let rsp_s: (read_gpr(Rsp, s.gprs) = stack.at(d)) = trans(trailed.left.left, rsp0);
        site.moves_trans(stack.writes, prog_len(prog), prog_len(raised), prog_len(out_prog),
            λ (x: MachineState<M>) => (x.gprs = s.gprs) ∧ stack.Trail(lending, d, s0.memory, before, x.memory),
            λ (t: MachineState<M>) => stack.Returned(lending, d, s0, after, s.gprs, values(64, result), t),
            λ (t: MachineState<M>) => file.write(Rax, Some(Held(result, Word))).Represents(values, t.gprs) ∧
                stack.Trailed(saves, lending, d, s0, after, t),
            call_returns<M>(site, laid, stack, top, lending, loan, values, d, s0, fits, under, deep, prog, file, callee,
                arguments, result, sources, few, same, sourced, moves, moves_keeps, placed, leaves, s.gprs, holds.left.left, rsp_s, before, after,
                step(holds.left.right, s.gprs, holds.left.left, rsp_s),
                raised.within_trans(out_prog, site.program, Prog::within_reloads(saved_registers(), raised, 0), within)),
            call_finishes<M>(saves, site, laid, stack, lending, values, d, s0, after, rsp0, fits, file, result, raised, s.gprs, holds.left.left, rsp_s,
                trailed.left, within),
            s, here, resident, ⟨refl, trailed.right⟩)
     }⟩
}

// The call once the stack pointer is no word of the file: its sources
// found and checked, then its argument moves.
theorem File::emit_call_staged_steps<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d),
    fits: d + 64 <= stack.size, under: d + 72 <= top, deep: 24 <= d, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names: Nat, Facts: Type, before, after: Buffers(), few: arguments.drop(6).len() <= 2,
    step: (count: Nat) → count <= 2 → (moved: Prog) → Facts →
        (g0: Gprs) → file.Represents(values, g0) → read_gpr(Rsp, g0) = stack.at(d) → (k: Nat) →
        asm_back(site.program, k) = At(moved, 0, CallTo(Succ(callee))) →
        site.Moves(stack.writes, prog_len(moved), prog_len(moved) + 5,
            λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words_of(values, arguments), x),
            λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, count, values(64, result), t))):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts,
        before, after, file.emit_call_staged(file.write(Rsp, None), prog, callee, arguments, result, placement, names)) {
    let staged = file.write(Rsp, None);
    let ports = word_ports(arguments.take(6));
    let order = staged.call_moves(arguments.take(6));
    let out_file = file.write(Rax, Some(Held(result, Word)));
    match found: staged.sources(arguments.drop(6)) {
        None => trivial,
        Some(sources) => match sourcing: sources.len().same(arguments.drop(6).len()) &&
            staged.outputs_check(word_ports(arguments.drop(6)), sources) {
            False => trivial,
            True => {
                let sourced = Bool::is_true_and(sources.len().same(arguments.drop(6).len()),
                    staged.outputs_check(word_ports(arguments.drop(6)), sources),
                    is_true_of_eq(sources.len().same(arguments.drop(6).len()) && staged.outputs_check(word_ports(arguments.drop(6)), sources),
                        sourcing));
                let same: (sources.len() = arguments.drop(6).len()) = sources.len().same_sound(arguments.drop(6).len(),
                    eq_true_of_is_true(sources.len().same(arguments.drop(6).len()), sourced.left));
                let few_sources: (sources.len() <= 2) = { omega };
                (match staged.move_outputs(ArgumentMove::ports(order), ArgumentMove::registers(order)) as λ moved =>
                    MayKeep<M>(values, staged, True, moved) →
                    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts, before, after, match moved {
                        None => None,
                        Some(moves) => match moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                            False => None,
                            True => Some(Emitted(call_prog(prog, sources, moves.code, callee), out_file, placement, names)),
                        },
                    }) {
                    None => λ _ => trivial,
                    Some(moves) => λ keeps =>
                        match checked: moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()) {
                            False => trivial,
                            True => {
                                let both = Bool::is_true_and(moves.file.outputs_check(ports, argument_registers()),
                                    leaves_all(moves.code, callee_saved()),
                                    is_true_of_eq(moves.file.outputs_check(ports, argument_registers()) && leaves_all(moves.code, callee_saved()),
                                        checked));
                                call_emits<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, rsp0, fits, under, deep,
                                    prog, file, callee, arguments, result, placement, names, sources, few_sources, same, sourced.right,
                                    moves, keeps, both.left, both.right, Facts, before, after,
                                    step(sources.len(), few_sources, At(call_staged(prog, sources), 0, Block(moves.code))))
                            },
                        },
                })(move_outputs_keeps<M>(values, ArgumentMove::ports(order), staged, ArgumentMove::registers(order)))
            },
        },
    }
}

// The call, whatever its CALL is proved against: a callee entered over the
// caller's file (`File::emit_call_runs`) or over views of it
// (`File::emit_lend_runs`).
theorem File::emit_call_steps<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, bound: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d),
    fits: d + 64 <= stack.size, under: d + 72 <= top, deep: 24 <= d, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names: Nat, counts: List<Nat>, homes: List<Lent>, Facts: Type, before, after: Buffers(),
    step: Succ(callee) <= bound → args_lend(homes, lent_count(counts, callee), 0, arguments).IsTrue() → (count: Nat) → count <= 2 →
        (moved: Prog) → Facts → (g0: Gprs) → file.Represents(values, g0) → read_gpr(Rsp, g0) = stack.at(d) → (k: Nat) →
        asm_back(site.program, k) = At(moved, 0, CallTo(Succ(callee))) →
        site.Moves(stack.writes, prog_len(moved), prog_len(moved) + 5,
            λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, before, g0, count, words_of(values, arguments), x),
            λ (t: MachineState<M>) => stack.Called(lending, d, s0, after, g0, count, values(64, result), t))):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, Facts,
        before, after, file.emit_call(prog, callee, arguments, result, placement, names, bound, counts, homes)) {
    let lends = args_lend(homes, lent_count(counts, callee), 0, arguments);
    let short = arguments.drop(6).len().leb(2);
    match under_bound: Succ(callee).leb(bound) && (lends && short) {
        False => trivial,
        True => {
            let allowed = Bool::is_true_and(Succ(callee).leb(bound), lends && short,
                is_true_of_eq(Succ(callee).leb(bound) && (lends && short), under_bound));
            let rest = Bool::is_true_and(lends, short, allowed.right);
            file.emit_call_staged_steps<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, rsp0, fits, under, deep, prog, callee,
                arguments, result, placement, names, Facts, before, after, arguments.drop(6).len().leb_sound(2, rest.right),
                step(Succ(callee).leb_sound(bound, allowed.left), rest.left))
        },
    }
}

// A call: the callee is entered under the caller's lending, over the
// caller's file.
theorem File::emit_call_runs<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), bound: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 136 * bound + 24 <= d,
    fits: d + 64 <= stack.size, under: d + 72 <= top, prog: Prog, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names: Nat, homes: List<Lent>, before, after: Buffers(),
    returns: Succ(callee) <= bound → site.Returns(stack, asm_labels(site.program)(Succ(callee)),
        stack.CalledOver(effects, lending, top, callee, words_of(values, arguments), values(64, result), before, after),
        stack.AnsweredOver(lending, values(64, result), after))):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        StructuredRegionRunsOver(effects, values, Call(callee, arguments, result), before, after) ∧
            HomesHold(homes, values, lending.addresses, lending.buffers),
        before, after, file.emit_call(prog, callee, arguments, result, placement, names, bound, lending.counts, homes)) {
    file.emit_call_steps<M>(saves, site, laid, stack, top, bound, lending, loan, values, d, s0, rsp0, fits, under, { omega }, prog, callee,
        arguments, result, placement, names, lending.counts, homes,
        StructuredRegionRunsOver(effects, values, Call(callee, arguments, result), before, after) ∧
            HomesHold(homes, values, lending.addresses, lending.buffers),
        before, after,
        λ below lend count few moved facts g0 represents rsp_g0 k at =>
            call_step<M>(site, laid, stack, top, effects, bound, lending, loan, lending, d, s0, room, fits, under, moved, callee, below,
                count, few, words_of(values, arguments), values(64, result), before, after, before, after, facts.left, returns(below),
                args_lend_lent(values, lending.addresses, lending.buffers, homes, facts.right, lent_count(lending.counts, callee), 0,
                    arguments, lend),
                λ memory held => held, λ u t held wrote now => ⟨wrote, now⟩, g0, k, at))
}

// ---------------------------------------------------------------------------
// Calls over views (docs/native-library-exports-design.md §3.1)

// The CALL of a call over views. The callee is entered under the views'
// lending over the windows of the file as it is, which the scope's loan
// lends (`Lendable::loan`) and the file in memory reads
// (`Lendable::reads`); what it stored under the views it stored under the
// scope's spans (`Lendable::wrote`), and what it left of the written
// windows is the scope's file with them put back (`Lendable::put_reads`).
theorem lend_step<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), bound: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    needs: Nat → Nat → Bool, calls: site.CallsLent(stack, effects, bound, lending.counts, needs, top),
    values: Valuation(), d: Nat, s0: MachineState<M>,
    room: 136 * bound + 24 <= d, fits: d + 64 <= stack.size, under: d + 72 <= top, prog: Prog, views: List<View>, callee: Nat,
    below: Succ(callee) <= bound, count: Nat, few: count <= 2, arguments: List<Nat>, result: Nat,
    asks: (v: Nat) → needs(callee, v).IsTrue() → marked(views_marks(views), v) = True,
    lendable: Lendable(views, values, lending.addresses, lending.buffers, lending.written),
    lend: args_lend(views_lents(views), lent_count(lending.counts, callee), 0, arguments).IsTrue(), mid, left: Buffers(),
    answered: effects(viewed(views, values, mid), callee, words_of(values, arguments), values(64, result), left),
    g0: Gprs, k: Nat, at: asm_back(site.program, k) = At(prog, 0, CallTo(Succ(callee)))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + 5,
        λ (x: MachineState<M>) => stack.ArgsReady(lending, d, s0, mid, g0, count, words_of(values, arguments), x),
        λ (t: MachineState<M>) => stack.Called(lending, d, s0, put_views(views, values, left, mid), g0, count, values(64, result), t)) {
    let inner = lending.lend(views, values);
    let level = (d - 8 * count) - 8;
    let low: (level <= top) = { omega };
    call_step<M>(site, laid, stack, top, effects, bound, lending, loan, inner, d, s0, room, fits, under, prog, callee, below, count, few,
        words_of(values, arguments), values(64, result), mid, put_views(views, values, left, mid), viewed(views, values, mid), left,
        answered,
        calls(inner, refl, lendable.loan(loan), callee, below, asks, words_of(values, arguments), values(64, result),
            viewed(views, values, mid), left),
        args_lend_lent(values, inner.addresses, inner.buffers, views_lents(views), lendable.homes(), lent_count(lending.counts, callee), 0,
            arguments, lend),
        λ memory held => λ v => lendable.reads(site.data, memory, mid, λ b => held(b).left, λ b => held(b).right, v),
        λ u t held wrote now => ⟨lendable.wrote(stack, level, u, t, wrote),
            λ c => lendable.put_reads(loan, level, low, mid, left, λ b => held(b).left, λ v => now(v).left, u, t, wrote,
                λ b => held(b).right, λ v => now(v).right, c)⟩,
        g0, k, at)
}

// A call over views runs its meaning: the views' nodes leave the file,
// the callee answers over the windows, and the file after is the file with
// the written windows put back.
theorem File::emit_lend_runs<M>(self file: File, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), bound: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), needs: Nat → Nat → Bool,
    calls: site.CallsLent(stack, effects, bound, lending.counts, needs, top),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 136 * bound + 24 <= d,
    fits: d + 64 <= stack.size, under: d + 72 <= top, prog: Prog, views: List<View>, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names: Nat, homes: List<Lent>,
    allowed: (b: Nat) → views_store(views, b).IsTrue() → lending.written(b) = True,
    asks: (v: Nat) → needs(callee, v).IsTrue() → marked(views_marks(views), v) = True, before, after: Buffers()):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        StructuredRegionRunsOver(effects, values, Lend(views, callee, arguments, result), before, after) ∧
            HomesHold(homes, values, lending.addresses, lending.buffers),
        before, after, file.emit_lend(saves, prog, views, callee, arguments, result, placement, names, bound, lending.counts, homes)) {
    let nodes = views_nodes(views);
    let args = views_homes(views) ++ arguments;
    let held_homes = HomesHold(homes, values, lending.addresses, lending.buffers);
    let Answered = λ (mid: Buffers()) (left: Buffers()) =>
        effects(viewed(views, values, mid), callee, words_of(values, args), values(64, result), left);
    let First = λ (mid: Buffers()) => NodesRun(nodes, values, before, mid) ∧ held_homes;
    let Second: (Buffers() → Type) = λ mid => Exists<Buffers()>(λ (left: Buffers()) =>
        (First(mid) ∧ Answered(mid, left)) ∧ (after = put_views(views, values, left, mid)));
    let facts = StructuredRegionRunsOver(effects, values, Lend(views, callee, arguments, result), before, after) ∧ held_homes;
    let leaf_under: (d + 64 <= top) = { omega };
    (match emit_leaf(saves, prog, file, nodes, placement, names, homes) as λ e =>
        ((mid: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, First(mid), before, mid, e)) →
        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match e {
            None => None,
            Some(first) => match views_lent(views, first.file, homes) {
                False => None,
                True => first.file.emit_call(first.prog, callee, args, result, first.placement, first.names, bound, lending.counts,
                    views_lents(views)),
            },
        }) {
        None => λ _ => trivial,
        Some(first) => λ first_emits => match checked: views_lent(views, first.file, homes) {
            False => trivial,
            True => {
                let checks = views_lent_parts(views, first.file, homes, is_true_of_eq(views_lent(views, first.file, homes), checked));
                let out = first.file.emit_call(first.prog, callee, args, result, first.placement, first.names, bound, lending.counts,
                    views_lents(views));
                may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file,
                    Exists<Buffers()>(λ mid => First(mid) ∧ Second(mid)), facts,
                    λ held => {
                        let ran = held.left.proof;
                        let first_holds: First(held.left.witness) = ⟨ran.left, held.right⟩;
                        Exists(held.left.witness, ⟨first_holds,
                            Exists(ran.right.witness, ⟨⟨first_holds, ran.right.proof.left⟩, ran.right.proof.right⟩)⟩)
                    },
                    before, after, out,
                    may_emit_over_seq<M>(saves, site, stack, lending, values, d, s0, prog, file, First, Second, before, after, first, first_emits,
                        out,
                        λ mid => may_emit_over_some<M>(saves, site, stack, lending, values, d, s0, first.prog, first.file,
                            λ (left: Buffers()) => First(mid) ∧ Answered(mid, left),
                            λ (left: Buffers()) => put_views(views, values, left, mid), mid, after, out,
                            λ left => first.file.emit_call_steps<M>(saves, site, laid, stack, top, bound, lending, loan, values, d, s0, rsp0, fits,
                                under, { omega }, first.prog, callee, args, result, first.placement, first.names, lending.counts, views_lents(views),
                                First(mid) ∧ Answered(mid, left), mid, put_views(views, values, left, mid),
                                λ below lend count few moved holds g0 represents rsp_g0 k at => {
                                    let still = nodes_run_still(values, nodes, before, mid, views_nodes_quiet(views), holds.left.left);
                                    let lendable = views_lendable_sound(views, first.file, homes, values, g0, lending.addresses,
                                        lending.buffers, before, lending.written, represents, holds.left.right, checks.left, checks.right,
                                        still.right, allowed);
                                    lend_step<M>(site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0, room,
                                        fits, under, moved, views, callee, below, count, few, args, result, asks, lendable, lend, mid, left,
                                        holds.right, g0, k, at)
                                }))))
            },
        },
    })(λ mid => emit_leaf_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, leaf_under, prog, file, nodes, placement, names,
        homes, λ b stores => false_elim(views_nodes_store(views, b, stores)), before, mid))
}

// ---------------------------------------------------------------------------
// Loops: what the checks give

fn LoopRegisters::Apart(self registers: LoopRegisters, saves: Nat) → Type {
    registers.counter.misses(registers.state).IsTrue() ∧ (registers.flag.misses(registers.state).IsTrue() ∧
        (leaves_all([registers.clear()], body_kept(saves)).IsTrue() ∧ (leaves_all([registers.mark()], body_kept(saves)).IsTrue() ∧
            leaves_all([registers.step()], body_kept(saves)).IsTrue())))
}

theorem LoopRegisters::apart_sound(self registers: LoopRegisters, saves: Nat, apart: registers.apart(saves).IsTrue()): registers.Apart(saves) {
    let clear = leaves_all([registers.clear()], body_kept(saves));
    let mark = leaves_all([registers.mark()], body_kept(saves));
    let step = leaves_all([registers.step()], body_kept(saves));
    let flag = registers.flag.misses(Cons(registers.counter, registers.state));
    let first = Bool::is_true_and(registers.counter.misses(registers.state), flag && (clear && (mark && step)), apart);
    let second = Bool::is_true_and(flag, clear && (mark && step), first.right);
    let flagged = Bool::is_true_and(!registers.flag.same(registers.counter), registers.flag.misses(registers.state), second.left);
    let third = Bool::is_true_and(clear, mark && step, second.right);
    let fourth = Bool::is_true_and(mark, step, third.right);
    ⟨first.left, ⟨flagged.right, ⟨third.left, ⟨fourth.left, fourth.right⟩⟩⟩⟩
}

// Moving `ids` into `registers`: their words land there, the callee-saved
// registers kept.
fn MovesInto<M>(saves: Nat, values: Valuation(), file: File, ids: List<Nat>, registers: List<Gpr>, code: List<Instruction>) → Type {
    (s: MachineState<M>) → file.Represents(values, s.gprs) →
        ArgsIn(words_of(values, ids), registers, execute_block_normal(code, s).gprs) ∧
        Kept(body_kept(saves), s.gprs, execute_block_normal(code, s).gprs)
}

theorem moves_into<M>(saves: Nat, values: Valuation(), file: File, ids: List<Nat>, registers: List<Gpr>, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), placed: moves.file.outputs_check(word_ports(ids), registers).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue()): MovesInto<M>(saves, values, file, ids, registers, moves.code) {
    λ s represents => ⟨ports_args(values, ids, registers, execute_block_normal(moves.code, s).gprs,
            outputs_check_sound(values, moves.file, execute_block_normal(moves.code, s).gprs, keeps(s, represents, trivial),
                word_ports(ids), registers, placed)),
        execute_block_kept<M>(moves.code, s, body_kept(saves), leaves)⟩
}

// The entry's code moves the bound and the inputs into the counter and the
// state's registers, and the head's file describes every pass whose
// parameters and count are there.
fn LoopEntryOk<M>(saves: Nat, values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    entry: LoopEntry) → Type {
    MovesInto<M>(saves, values, file, Cons(limit, inputs), Cons(entry.registers.counter, entry.registers.state), entry.code) ∧
    (((pass: Valuation()) → (g: Gprs) →
        ArgsIn(words_of(pass, Cons(count, parameters)), Cons(entry.registers.counter, entry.registers.state), g) →
        entry.head.Represents(pass, g)) ∧ entry.registers.Apart(saves))
}

fn MayLoopEntry<M>(saves: Nat, values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    out: Option<LoopEntry>) → Type {
    out.All(λ (entry: LoopEntry) => LoopEntryOk<M>(saves, values, file, inputs, limit, parameters, count, entry))
}

theorem loop_entry_with_sound<M>(saves: Nat, values: Valuation(), file: File, registers: LoopRegisters, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat):
    MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, loop_entry_with(saves, registers, moves, inputs, limit, parameters, count)) {
    let into = Cons(registers.counter, registers.state);
    let placed = moves.file.outputs_check(word_ports(Cons(limit, inputs)), into);
    let kept = leaves_all(moves.code, body_kept(saves));
    (match input_file(word_ports(Cons(count, parameters)), into) as λ o =>
        ((pass: Valuation()) → (g: Gprs) → PortsAt(pass, word_ports(Cons(count, parameters)), into, g) →
            o.All(λ (f: File) => f.Represents(pass, g))) →
        MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, match o {
            None => None,
            Some(head) => match placed && (kept && registers.apart(saves)) {
                False => None,
                True => Some(LoopEntry(registers, moves.code, head)),
            },
        }) {
        None => λ _ => trivial,
        Some(head) => λ head_ok =>
            match checked: placed && (kept && registers.apart(saves)) {
                False => trivial,
                True => {
                    let all = Bool::is_true_and(placed, kept && registers.apart(saves), is_true_of_eq(placed && (kept && registers.apart(saves)), checked));
                    let rest = Bool::is_true_and(kept, registers.apart(saves), all.right);
                    ⟨moves_into<M>(saves, values, file, Cons(limit, inputs), into, moves, keeps, all.left, rest.left),
                     ⟨λ pass g args => head_ok(pass, g, args_ports(pass, Cons(count, parameters), into, g, args)),
                      registers.apart_sound(saves, rest.right)⟩⟩
                },
            },
    })(λ pass g placed_at => input_file_represents(pass, g, word_ports(Cons(count, parameters)), into, placed_at))
}

theorem loop_entry_at_sound<M>(saves: Nat, values: Valuation(), file: File, registers: LoopRegisters, inputs: List<Nat>, limit: Nat,
    parameters: List<Nat>, count: Nat):
    MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, file.loop_entry_at(saves, registers, inputs, limit, parameters, count)) {
    (match file.move_outputs(word_ports(Cons(limit, inputs)), Cons(registers.counter, registers.state)) as λ o =>
        MayKeep<M>(values, file, True, o) →
        MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, match o {
            None => None,
            Some(moves) => loop_entry_with(saves, registers, moves, inputs, limit, parameters, count),
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps => loop_entry_with_sound<M>(saves, values, file, registers, moves, keeps, inputs, limit, parameters, count),
    })(move_outputs_keeps<M>(values, word_ports(Cons(limit, inputs)), file, Cons(registers.counter, registers.state)))
}

theorem loop_entry_sound<M>(saves: Nat, values: Valuation(), file: File, inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat,
    placement: List<Place>):
    MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, file.loop_entry(saves, inputs, limit, parameters, count, placement)) {
    match loop_registers(parameters.len(), placement) {
        None => trivial,
        Some(registers) => loop_entry_at_sound<M>(saves, values, file, registers, inputs, limit, parameters, count),
    }
}

// At the exit test the exit bit's register tests zero exactly when the bit
// is clear; the moves leave or go round; and the file after the loop
// describes the outputs in the state's registers and the exhausted bit in
// the flag.
fn LoopExitOk<M>(saves: Nat, file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    out: LoopExit) → Type {
    ((pass: Valuation()) → (g: Gprs) → file.Represents(pass, g) → out.register.tests_zero(g) = !pass(1, exit).head_bit()) ∧
    (((pass: Valuation()) → MovesInto<M>(saves, pass, file, next, registers.state, out.leave)) ∧
     (((pass: Valuation()) → MovesInto<M>(saves, pass, file, Cons(count, next), Cons(registers.counter, registers.state), out.back)) ∧
      ((values: Valuation()) → (g: Gprs) → ArgsIn(words_of(values, outputs), registers.state, g) →
        values(1, exhausted).zero_extend(63) = read_gpr(registers.flag, g) → out.out.Represents(values, g))))
}

fn MayLoopExit<M>(saves: Nat, file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat,
    out: Option<LoopExit>) → Type {
    out.All(λ (x: LoopExit) => LoopExitOk<M>(saves, file, registers, count, exit, next, outputs, exhausted, x))
}

theorem loop_exit_out_sound<M>(saves: Nat, file: File, register: Gpr, leave, back: Lowered,
    leave_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, leave), back_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, back),
    registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted,
        file.loop_exit_out(saves, register, leave, back, registers, count, exit, next, outputs, exhausted)) {
    let ports = Cons(Port(id := exhausted, width := 1), word_ports(outputs));
    let into = Cons(registers.flag, registers.state);
    let found = file.check_one(exit, Some(Bit), register);
    let leave_placed = leave.file.outputs_check(word_ports(next), registers.state);
    let leave_kept = leaves_all(leave.code, body_kept(saves));
    let back_placed = back.file.outputs_check(word_ports(Cons(count, next)), Cons(registers.counter, registers.state));
    let back_kept = leaves_all(back.code, body_kept(saves));
    (match input_file(ports, into) as λ o =>
        ((values: Valuation()) → (g: Gprs) → PortsAt(values, ports, into, g) → o.All(λ (f: File) => f.Represents(values, g))) →
        MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted, match o {
            None => None,
            Some(after) => match found && (leave_placed && (leave_kept && (back_placed && back_kept))) {
                False => None,
                True => Some(LoopExit(register, leave.code, back.code, after)),
            },
        }) {
        None => λ _ => trivial,
        Some(after) => λ after_ok =>
            match checked: found && (leave_placed && (leave_kept && (back_placed && back_kept))) {
                False => trivial,
                True => {
                    let first = Bool::is_true_and(found, leave_placed && (leave_kept && (back_placed && back_kept)),
                        is_true_of_eq(found && (leave_placed && (leave_kept && (back_placed && back_kept))), checked));
                    let second = Bool::is_true_and(leave_placed, leave_kept && (back_placed && back_kept), first.right);
                    let third = Bool::is_true_and(leave_kept, back_placed && back_kept, second.right);
                    let fourth = Bool::is_true_and(back_placed, back_kept, third.right);
                    ⟨λ pass g represents => register.tests_zero_bit(g, pass(1, exit),
                        check_one_sound(pass, file, g, represents, exit, Some(Bit), register, first.left)),
                     ⟨λ pass => moves_into<M>(saves, pass, file, next, registers.state, leave, leave_keeps(pass), second.left, third.left),
                      ⟨λ pass => moves_into<M>(saves, pass, file, Cons(count, next), Cons(registers.counter, registers.state), back, back_keeps(pass),
                            fourth.left, fourth.right),
                       λ values g args flag => after_ok(values, g, ⟨flag, args_ports(values, outputs, registers.state, g, args)⟩)⟩⟩⟩
                },
            },
    })(λ values g placed => input_file_represents(values, g, ports, into, placed))
}

theorem loop_exit_back_sound<M>(saves: Nat, file: File, register: Gpr, leave: Lowered, leave_keeps: (pass: Valuation()) → Keeps<M>(pass, file, True, leave),
    registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted,
        file.loop_exit_back(saves, register, leave, registers, count, exit, next, outputs, exhausted)) {
    (match file.move_outputs(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) as λ o =>
        ((pass: Valuation()) → MayKeep<M>(pass, file, True, o)) →
        MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted, match o {
            None => None,
            Some(back) => file.loop_exit_out(saves, register, leave, back, registers, count, exit, next, outputs, exhausted),
        }) {
        None => λ _ => trivial,
        Some(back) => λ back_keeps => loop_exit_out_sound<M>(saves, file, register, leave, back, leave_keeps, back_keeps, registers, count, exit,
            next, outputs, exhausted),
    })(λ pass => move_outputs_keeps<M>(pass, word_ports(Cons(count, next)), file, Cons(registers.counter, registers.state)))
}

theorem loop_exit_sound<M>(saves: Nat, file: File, registers: LoopRegisters, count, exit: Nat, next, outputs: List<Nat>, exhausted: Nat):
    MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted, file.loop_exit(saves, registers, count, exit, next, outputs, exhausted)) {
    match file.find(Held(exit, Bit)) {
        None => trivial,
        Some(found) =>
            (match file.move_outputs(word_ports(next), registers.state) as λ o =>
                ((pass: Valuation()) → MayKeep<M>(pass, file, True, o)) →
                MayLoopExit<M>(saves, file, registers, count, exit, next, outputs, exhausted, match o {
                    None => None,
                    Some(leave) => file.loop_exit_back(saves, found.register, leave, registers, count, exit, next, outputs, exhausted),
                }) {
                None => λ _ => trivial,
                Some(leave) => λ leave_keeps => loop_exit_back_sound<M>(saves, file, found.register, leave, leave_keeps, registers, count, exit,
                    next, outputs, exhausted),
            })(λ pass => move_outputs_keeps<M>(pass, word_ports(next), file, registers.state)),
    }
}

// ---------------------------------------------------------------------------
// Loops: the counter

theorem Gpr::tests_zero_at(self register: Gpr, gprs: Gprs, word: BitVec(64), held: read_gpr(register, gprs) = word):
    register.tests_zero(gprs) = is_zero_bits(64, word.band(word)) {
    j(held, λ w _ => register.tests_zero(gprs) = is_zero_bits(64, w.band(w)), refl)
}

theorem loop_counter_zero(): is_zero_bits(64, BitVec::ofNat(0, n := 64).band(BitVec::ofNat(0, n := 64))) = True { refl }

theorem loop_counter_nonzero(rest: Nat, lt: Succ(rest) < Nat::pow(2, 64)):
    is_zero_bits(64, BitVec::ofNat(Succ(rest), n := 64).band(BitVec::ofNat(Succ(rest), n := 64))) = False {
    let positive: (0 < Succ(rest)) = { omega };
    test_self_nonzero(64, BitVec::ofNat(Succ(rest), n := 64),
        j(sym(BitVec::toNat_ofNat(64, Succ(rest), lt)), λ x _ => 0 < x, positive))
}

// ADD counter, -1 counts a pass off.
theorem loop_counter_step(rest: Nat):
    BitVec::ofNat(Succ(rest), n := 64).add(BitVec::ofNat(255, n := 8).sign_extend(56)) = BitVec::ofNat(rest, n := 64) {
    let c = BitVec::ofNat(255, n := 8).sign_extend(56);
    let zero = BitVec::zero(n := 64);
    let reading: (c.toNat() = Nat::pow(2, 64) - 1) = refl;
    let count: (Succ(rest) + (Nat::pow(2, 64) - 1) = rest + Nat::pow(2, 64)) = { omega };
    trans(sym(BitVec::iter_add_eq_add(64, BitVec::ofNat(Succ(rest), n := 64), c)),
    trans(BitVec::cong_iterate_increment_count(64, BitVec::ofNat(Succ(rest), n := 64), reading),
    trans(BitVec::cong_iterate_increment(64, Nat::pow(2, 64) - 1, sym(BitVec::zero_iterate_increment(64, Succ(rest)))),
    trans(BitVec::iterate_increment_compose(64, zero, Succ(rest), Nat::pow(2, 64) - 1),
    trans(BitVec::cong_iterate_increment_count(64, zero, count),
    trans(sym(BitVec::iterate_increment_compose(64, zero, rest, Nat::pow(2, 64))),
    trans(BitVec::iterate_increment_period(64, zero.iterate_increment(rest)), BitVec::zero_iterate_increment(64, rest))))))))
}

// ---------------------------------------------------------------------------
// Loops: the passes

// The loop's passes over its code from the head, by induction on the passes
// left: with none the loop stops exhausted; otherwise a pass runs and leaves,
// or goes round to the head with one fewer. Each pass starts from the file
// the one before it left.
theorem Site::loop_passes<M>(self site: Site<M>, writes: ByteWrites<M>, head_at, done_at: Nat,
    Head: Nat → List<BitVec(64)> → Buffers() → MachineState<M> → Type, Done: List<BitVec(64)> → Bool → Buffers() → MachineState<M> → Type,
    pass: Valuation() → Buffers() → Buffers() → Type, parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    stop: (state: List<BitVec(64)>) → (now: Buffers()) → site.Moves(writes, head_at, done_at, Head(0, state, now), Done(state, True, now)),
    leave: (rest: Nat) → Succ(rest) < Nat::pow(2, 64) → (values: Valuation()) → values(64, count) = BitVec::ofNat(Succ(rest)) →
        (from, to: Buffers()) → pass(values, from, to) → values(1, exit).head_bit() = True →
        site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters), from), Done(words_of(values, next), False, to)),
    again: (rest: Nat) → Succ(rest) < Nat::pow(2, 64) → (values: Valuation()) → values(64, count) = BitVec::ofNat(Succ(rest)) →
        (from, to: Buffers()) → pass(values, from, to) → values(1, exit).head_bit() = False →
        site.Moves(writes, head_at, head_at, Head(Succ(rest), words_of(values, parameters), from), Head(rest, words_of(values, next), to)),
    remaining: Nat): remaining < Nat::pow(2, 64) → (state, final: List<BitVec(64)>) → (exhausted: Bool) → (before, after: Buffers()) →
    LoopRunsOver(pass, parameters, count, exit, next, remaining, state, final, exhausted, before, after) →
    site.Moves(writes, head_at, done_at, Head(remaining, state, before), Done(final, exhausted, after)) {
    match remaining {
        Zero => λ _ state final exhausted before after ran =>
            j(sym(ran.right.right), λ a _ => site.Moves(writes, head_at, done_at, Head(0, state, before), Done(final, exhausted, a)),
                j(sym(ran.right.left), λ e _ => site.Moves(writes, head_at, done_at, Head(0, state, before), Done(final, e, before)),
                    j(sym(ran.left), λ f _ => site.Moves(writes, head_at, done_at, Head(0, state, before), Done(f, True, before)),
                        stop(state, before)))),
        Succ(rest) => λ lt state final exhausted before after ran => {
            let values = ran.witness;
            let mid = ran.proof.witness;
            let held = ran.proof.proof;
            let under: (rest < Nat::pow(2, 64)) = { omega };
            j(held.left, λ st _ => site.Moves(writes, head_at, done_at, Head(Succ(rest), st, before), Done(final, exhausted, after)),
                (match values(1, exit).head_bit() as λ b => values(1, exit).head_bit() = b →
                    (match b {
                        False => LoopRunsOver(pass, parameters, count, exit, next, rest, words_of(values, next), final, exhausted, mid, after),
                        True => (final = words_of(values, next)) ∧ ((exhausted = False) ∧ (after = mid)),
                    }) →
                    site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters), before),
                        Done(final, exhausted, after)) {
                    False => λ clear later => site.moves_trans(writes, head_at, head_at, done_at,
                        Head(Succ(rest), words_of(values, parameters), before), Head(rest, words_of(values, next), mid),
                        Done(final, exhausted, after),
                        again(rest, lt, values, held.right.left, before, mid, held.right.right.left, clear),
                        site.loop_passes(writes, head_at, done_at, Head, Done, pass, parameters, count, exit, next, stop, leave, again,
                            rest, under, words_of(values, next), final, exhausted, mid, after, later)),
                    True => λ set ended =>
                        j(sym(ended.right.right), λ a _ =>
                                site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters), before),
                                    Done(final, exhausted, a)),
                            j(sym(ended.right.left), λ e _ =>
                                    site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters), before),
                                        Done(final, e, mid)),
                                j(sym(ended.left), λ f _ =>
                                        site.Moves(writes, head_at, done_at, Head(Succ(rest), words_of(values, parameters), before),
                                            Done(f, False, mid)),
                                    leave(rest, lt, values, held.right.left, before, mid, held.right.right.left, set)))),
                })(refl, held.right.right.right))
        },
    }
}

// The state at the head with `remaining` passes left: the state's words in
// their registers, the counter, and what the frame keeps of memory (`keep`:
// the trail over the file as the pass finds it).
fn Stack::LoopHead<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), saves: Nat, keep: M → Type,
    s0: MachineState<M>, registers: LoopRegisters, remaining: Nat, state: List<BitVec(64)>) → Gprs → M → Type {
    λ g m => (ArgsIn(state, registers.state, g) ∧ read_gpr(registers.counter, g) = BitVec::ofNat(remaining)) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ keep(m))
}

// After a pass's body: its file describes the pass's valuation.
fn Stack::LoopPassed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), saves: Nat, keep: M → Type,
    s0: MachineState<M>, file: File, values: Valuation()) → Gprs → M → Type {
    λ g m => file.Represents(values, g) ∧ (Kept(body_kept(saves), s0.gprs, g) ∧ keep(m))
}

// At the loop's end: the final state in the state's registers, the
// exhausted bit in the flag.
fn Stack::LoopDone<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), saves: Nat, keep: M → Type,
    s0: MachineState<M>, registers: LoopRegisters, final: List<BitVec(64)>, exhausted: Bool) → Gprs → M → Type {
    λ g m => (ArgsIn(final, registers.state, g) ∧ BitVec::ofBool(exhausted).zero_extend(63) = read_gpr(registers.flag, g)) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ keep(m))
}

// With no passes left the head's test jumps to X.
theorem loop_stops<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, head: Prog, registers: LoopRegisters, x_name, x_at: Nat, x_lands: asm_target(site.program, x_name) = x_at,
    tested_in: head.branch_label(registers.counter, x_name).Within(site.program), state: List<BitVec(64)>, to: Nat,
    post: MachineState<M> → Type,
    exhausted: site.Moves(stack.writes, x_at, to,
        λ (s: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, 0, state)(s.gprs, s.memory), post)):
    site.Moves(stack.writes, prog_len(head), to, λ (s: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, 0, state)(s.gprs, s.memory),
        post) {
    let program = site.program;
    let counter = registers.counter;
    let tested = head.test_label(counter);
    let test_in = tested.within_before(0, Jcc(E, x_name), program, tested_in);
    let else_lands = j(x_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, x_name)), target),
        jcc_lands(asm_labels(program), tested_in.witness, program, tested, 0, E, x_name, program.laid_out_lands(laid), tested_in.proof));
    let pre = stack.LoopHead(saves, keep, s0, registers, 0, state);
    site.moves_test(stack.writes, program.laid_out_fits(laid), head, counter, x_name, test_in.witness, test_in.proof,
        tested_in.witness, tested_in.proof, x_at, else_lands, to, pre, post,
        site.moves_absurd(stack.writes, prog_len(head.branch_label(counter, x_name)), to,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = False, post,
            λ s held => {
                let bad: (True = False) = trans(sym(loop_counter_zero()),
                    trans(sym(counter.tests_zero_at(s.gprs, BitVec::ofNat(0), held.left.left.right)), held.right));
                absurd(bad)
            }),
        site.moves_weaken(stack.writes, x_at, to, λ (s: MachineState<M>) => pre(s.gprs, s.memory), post,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = True, post,
            exhausted, λ s held => held.left, λ t held => held))
}

// With passes left the head's test falls through to the body.
theorem loop_enters<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, head: Prog, registers: LoopRegisters, x_name, x_at: Nat, x_lands: asm_target(site.program, x_name) = x_at,
    tested_in: head.branch_label(registers.counter, x_name).Within(site.program), rest: Nat, lt: Succ(rest) < Nat::pow(2, 64),
    state: List<BitVec(64)>, to: Nat, post: MachineState<M> → Type,
    body: site.Moves(stack.writes, prog_len(head.branch_label(registers.counter, x_name)), to,
        λ (s: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, Succ(rest), state)(s.gprs, s.memory), post)):
    site.Moves(stack.writes, prog_len(head), to,
        λ (s: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, Succ(rest), state)(s.gprs, s.memory), post) {
    let program = site.program;
    let counter = registers.counter;
    let tested = head.test_label(counter);
    let test_in = tested.within_before(0, Jcc(E, x_name), program, tested_in);
    let else_lands = j(x_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, x_name)), target),
        jcc_lands(asm_labels(program), tested_in.witness, program, tested, 0, E, x_name, program.laid_out_lands(laid), tested_in.proof));
    let pre = stack.LoopHead(saves, keep, s0, registers, Succ(rest), state);
    site.moves_test(stack.writes, program.laid_out_fits(laid), head, counter, x_name, test_in.witness, test_in.proof,
        tested_in.witness, tested_in.proof, x_at, else_lands, to, pre, post,
        site.moves_weaken(stack.writes, prog_len(head.branch_label(counter, x_name)), to, λ (s: MachineState<M>) => pre(s.gprs, s.memory),
            post, λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = False, post,
            body, λ s held => held.left, λ t held => held),
        site.moves_absurd(stack.writes, x_at, to,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ counter.tests_zero(s.gprs) = True, post,
            λ s held => {
                let bad: (True = False) = trans(sym(held.right),
                    trans(counter.tests_zero_at(s.gprs, BitVec::ofNat(Succ(rest)), held.left.left.right), loop_counter_nonzero(rest, lt)));
                absurd(bad)
            }))
}

// X: the flag set, the state as it was.
theorem loop_marks<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(saves), before: Prog, x_name, k: Nat,
    at: asm_back(site.program, k) = At(At(before, x_name, Block([])), 0, Block([registers.mark()])), state: List<BitVec(64)>):
    site.Moves(stack.writes, prog_len(before), prog_len(before) + block_length([registers.mark()]),
        λ (s: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, 0, state)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopDone(saves, keep, s0, registers, state, True)(t.gprs, t.memory)) {
    site.moves_block(stack.writes, site.program.laid_out_fits(laid), k, At(before, x_name, Block([])), 0, [registers.mark()], at,
        site.program.block_reads_at(laid, k, At(before, x_name, Block([])), 0, [registers.mark()], at),
        stack.LoopHead(saves, keep, s0, registers, 0, state), stack.LoopDone(saves, keep, s0, registers, state, True),
        λ s memory held => ⟨⟨args_after_write(state, registers.state, s.gprs, registers.flag, BitVec::ofNat(1), apart.right.left, held.left.left),
                sym(read_gpr_after_write(registers.flag, BitVec::ofNat(1), s.gprs))⟩,
            ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal([registers.mark()], s).gprs, held.right.left,
                execute_block_kept<M>([registers.mark()], s, body_kept(saves), apart.right.right.right.left)), held.right.right⟩⟩)
}

// A pass's body, from the head's file at the pass's valuation, over the
// file the pass starts from to the one it leaves.
theorem loop_body_runs<M>(saves: Nat, site: Site<M>, stack: Stack<M>(site.fetch, site.data), lending: Lending,
    Pass: Valuation() → Buffers() → Buffers() → Type, d: Nat, s0: MachineState<M>,
    start: Prog, entry: LoopEntry, count: Nat, parameters: List<Nat>,
    head_ok: (pass: Valuation()) → (g: Gprs) →
        ArgsIn(words_of(pass, Cons(count, parameters)), Cons(entry.registers.counter, entry.registers.state), g) →
        entry.head.Represents(pass, g),
    body: StructuredRegion, values: Valuation(), from, to: Buffers(), pass: Emitted,
    emits: EmitsOver<M>(saves, site, stack, lending, values, d, s0, start, entry.head, Pass(values, from, to), from, to, pass),
    pass_in: pass.prog.Within(site.program), rest: Nat, counted: values(64, count) = BitVec::ofNat(Succ(rest)),
    passed: Pass(values, from, to)):
    site.Moves(stack.writes, prog_len(start), prog_len(pass.prog),
        λ (s: MachineState<M>) => stack.LoopHead(saves, λ (m: M) => stack.Trail(lending, d, s0.memory, from, m), s0, entry.registers, Succ(rest),
            words_of(values, parameters))(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopPassed(saves, λ (m: M) => stack.Trail(lending, d, s0.memory, to, m), s0, pass.file, values)(t.gprs,
            t.memory)) {
    site.moves_weaken(stack.writes, prog_len(start), prog_len(pass.prog),
        λ (s: MachineState<M>) => (entry.head.Represents(values, s.gprs) ∧ Pass(values, from, to)) ∧
            stack.Trailed(saves, lending, d, s0, from, s),
        λ (t: MachineState<M>) => pass.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, to, t),
        λ (s: MachineState<M>) => stack.LoopHead(saves, λ (m: M) => stack.Trail(lending, d, s0.memory, from, m), s0, entry.registers, Succ(rest),
            words_of(values, parameters))(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopPassed(saves, λ (m: M) => stack.Trail(lending, d, s0.memory, to, m), s0, pass.file, values)(t.gprs,
            t.memory),
        emits.right(pass_in),
        λ s held => ⟨⟨head_ok(values, s.gprs, ⟨trans(held.left.right, sym(counted)), held.left.left⟩), passed⟩, held.right⟩,
        λ t held => held)
}

// The exit bit set: the state moved out, the flag cleared, JMP J.
theorem loop_leaves<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(saves), pass: Prog, file: File, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat, out: LoopExit, out_ok: LoopExitOk<M>(saves, file, registers, count, exit, next, outputs, exhausted, out),
    names: Nat, jumped_in: loop_jumped(pass, registers, out, names).Within(site.program),
    c_lands: asm_target(site.program, Succ(Succ(names))) = prog_len(loop_jumped(pass, registers, out, names)),
    j_at: Nat, j_lands: asm_target(site.program, Succ(Succ(Succ(Succ(names))))) = j_at,
    values: Valuation(), set: values(1, exit).head_bit() = True):
    site.Moves(stack.writes, prog_len(pass), j_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopDone(saves, keep, s0, registers, words_of(values, next), False)(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let lands = program.laid_out_lands(laid);
    let c_name = Succ(Succ(names));
    let j_name = Succ(Succ(Succ(Succ(names))));
    let left = pass.branch_label(out.register, c_name);
    let leave = At(left, 0, Block(out.leave));
    let cleared = At(leave, 0, Block([registers.clear()]));
    let jumped = loop_jumped(pass, registers, out, names);
    let cleared_in = cleared.within_before(0, Jmp(j_name), program, jumped_in);
    let leave_in = leave.within_before(0, Block([registers.clear()]), program, cleared_in);
    let left_in = left.within_before(0, Block(out.leave), program, leave_in);
    let tested = pass.test_label(out.register);
    let test_in = tested.within_before(0, Jcc(E, c_name), program, left_in);
    let else_lands = j(c_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, c_name)), target),
        jcc_lands(asm_labels(program), left_in.witness, program, tested, 0, E, c_name, lands, left_in.proof));
    let jump_lands = j(j_lands, λ target _ => NearLands(prog_len(cleared), asm_jump_of(asm_labels(program), prog_len(cleared), Jmp(j_name)),
            target),
        jmp_lands(asm_labels(program), jumped_in.witness, program, cleared, 0, j_name, lands, jumped_in.proof));
    let pre = stack.LoopPassed(saves, keep, s0, file, values);
    let moved = λ (g: Gprs) (m: M) => ArgsIn(words_of(values, next), registers.state, g) ∧
        (Kept(body_kept(saves), s0.gprs, g) ∧ keep(m));
    let post = stack.LoopDone(saves, keep, s0, registers, words_of(values, next), False);
    site.moves_test(stack.writes, fits, pass, out.register, c_name, test_in.witness, test_in.proof, left_in.witness, left_in.proof,
        prog_len(jumped), else_lands, j_at, pre, λ (t: MachineState<M>) => post(t.gprs, t.memory),
        site.moves_trans(stack.writes, prog_len(left), prog_len(cleared), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
            λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_trans(stack.writes, prog_len(left), prog_len(leave), prog_len(cleared),
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
                λ (s: MachineState<M>) => moved(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_weaken(stack.writes, prog_len(left), prog_len(leave), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
                    λ (t: MachineState<M>) => moved(t.gprs, t.memory),
                    λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
                    λ (t: MachineState<M>) => moved(t.gprs, t.memory),
                    site.moves_block(stack.writes, fits, leave_in.witness, left, 0, out.leave, leave_in.proof,
                        program.block_reads_at(laid, leave_in.witness, left, 0, out.leave, leave_in.proof), pre, moved,
                        λ s memory held => {
                            let ran = out_ok.right.left(values, s, held.left);
                            ⟨ran.left, ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(out.leave, s).gprs, held.right.left,
                                ran.right), held.right.right⟩⟩
                        }),
                    λ s held => held.left, λ t held => held),
                site.moves_block(stack.writes, fits, cleared_in.witness, leave, 0, [registers.clear()], cleared_in.proof,
                    program.block_reads_at(laid, cleared_in.witness, leave, 0, [registers.clear()], cleared_in.proof), moved, post,
                    λ s memory held => ⟨⟨args_after_write(words_of(values, next), registers.state, s.gprs, registers.flag, BitVec::ofNat(0),
                            apart.right.left, held.left),
                        sym(read_gpr_after_write(registers.flag, BitVec::ofNat(0), s.gprs))⟩,
                        ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal([registers.clear()], s).gprs, held.right.left,
                            execute_block_kept<M>([registers.clear()], s, body_kept(saves), apart.right.right.left)), held.right.right⟩⟩)),
            site.moves_jump(stack.writes, fits, jumped_in.witness, cleared, 0, j_name, jumped_in.proof, j_at, jump_lands, post)),
        site.moves_absurd(stack.writes, prog_len(jumped), j_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            λ s held => {
                let bad: (True = False) = trans(sym(held.right), trans(out_ok.left(values, s.gprs, held.left.left),
                    cong_fn<Bool, Bool>(λ b => !b, set)));
                absurd(bad)
            }))
}

// The exit bit clear: the state and the count moved round, a pass counted
// off, JMP H.
theorem loop_rounds<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), keep: M → Type,
    s0: MachineState<M>, registers: LoopRegisters, apart: registers.Apart(saves), pass: Prog, file: File, count, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat, out: LoopExit, out_ok: LoopExitOk<M>(saves, file, registers, count, exit, next, outputs, exhausted, out),
    names: Nat, again_in: loop_again(pass, registers, out, names).Within(site.program),
    c_lands: asm_target(site.program, Succ(Succ(names))) = prog_len(loop_jumped(pass, registers, out, names)),
    h_at: Nat, h_lands: asm_target(site.program, Succ(names)) = h_at,
    values: Valuation(), clear: values(1, exit).head_bit() = False, rest: Nat, lt: Succ(rest) < Nat::pow(2, 64),
    counted: values(64, count) = BitVec::ofNat(Succ(rest))):
    site.Moves(stack.writes, prog_len(pass), h_at,
        λ (s: MachineState<M>) => stack.LoopPassed(saves, keep, s0, file, values)(s.gprs, s.memory),
        λ (t: MachineState<M>) => stack.LoopHead(saves, keep, s0, registers, rest, words_of(values, next))(t.gprs, t.memory)) {
    let program = site.program;
    let fits = program.laid_out_fits(laid);
    let lands = program.laid_out_lands(laid);
    let c_name = Succ(Succ(names));
    let h_name = Succ(names);
    let jumped = loop_jumped(pass, registers, out, names);
    let cont = At(jumped, c_name, Block([]));
    let back = At(cont, 0, Block(out.back));
    let stepped = At(back, 0, Block([registers.step()]));
    let stepped_in = stepped.within_before(0, Jmp(h_name), program, again_in);
    let back_in = back.within_before(0, Block([registers.step()]), program, stepped_in);
    let cont_in = cont.within_before(0, Block(out.back), program, back_in);
    let jumped_in = jumped.within_before(c_name, Block([]), program, cont_in);
    let left = pass.branch_label(out.register, c_name);
    let into_jumped: left.Within(jumped) = Exists(3, refl);
    let left_in = left.within_trans(jumped, program, into_jumped, jumped_in);
    let tested = pass.test_label(out.register);
    let test_in = tested.within_before(0, Jcc(E, c_name), program, left_in);
    let else_lands = j(c_lands, λ target _ => JumpsForward(prog_len(tested), 6,
            asm_jump_of(asm_labels(program), prog_len(tested), Jcc(E, c_name)), target),
        jcc_lands(asm_labels(program), left_in.witness, program, tested, 0, E, c_name, lands, left_in.proof));
    let jump_lands = j(h_lands, λ target _ => NearLands(prog_len(stepped), asm_jump_of(asm_labels(program), prog_len(stepped), Jmp(h_name)),
            target),
        jmp_lands(asm_labels(program), again_in.witness, program, stepped, 0, h_name, lands, again_in.proof));
    let pre = stack.LoopPassed(saves, keep, s0, file, values);
    let turned = stack.LoopHead(saves, keep, s0, registers, Succ(rest), words_of(values, next));
    let post = stack.LoopHead(saves, keep, s0, registers, rest, words_of(values, next));
    let c = BitVec::ofNat(255, n := 8).sign_extend(56);
    site.moves_test(stack.writes, fits, pass, out.register, c_name, test_in.witness, test_in.proof, left_in.witness, left_in.proof,
        prog_len(jumped), else_lands, h_at, pre, λ (t: MachineState<M>) => post(t.gprs, t.memory),
        site.moves_absurd(stack.writes, prog_len(left), h_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = False,
            λ (t: MachineState<M>) => post(t.gprs, t.memory),
            λ s held => {
                let bad: (True = False) = trans(sym(cong_fn<Bool, Bool>(λ b => !b, clear)),
                    trans(sym(out_ok.left(values, s.gprs, held.left.left)), held.right));
                absurd(bad)
            }),
        site.moves_trans(stack.writes, prog_len(jumped), prog_len(stepped), h_at,
            λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
            λ (s: MachineState<M>) => post(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
            site.moves_trans(stack.writes, prog_len(jumped), prog_len(back), prog_len(stepped),
                λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
                λ (s: MachineState<M>) => turned(s.gprs, s.memory), λ (t: MachineState<M>) => post(t.gprs, t.memory),
                site.moves_weaken(stack.writes, prog_len(cont), prog_len(back), λ (s: MachineState<M>) => pre(s.gprs, s.memory),
                    λ (t: MachineState<M>) => turned(t.gprs, t.memory),
                    λ (s: MachineState<M>) => pre(s.gprs, s.memory) ∧ out.register.tests_zero(s.gprs) = True,
                    λ (t: MachineState<M>) => turned(t.gprs, t.memory),
                    site.moves_block(stack.writes, fits, back_in.witness, cont, 0, out.back, back_in.proof,
                        program.block_reads_at(laid, back_in.witness, cont, 0, out.back, back_in.proof), pre, turned,
                        λ s memory held => {
                            let ran = out_ok.right.right.left(values, s, held.left);
                            ⟨⟨ran.left.right, trans(ran.left.left, counted)⟩,
                             ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(out.back, s).gprs, held.right.left, ran.right),
                              held.right.right⟩⟩
                        }),
                    λ s held => held.left, λ t held => held),
                site.moves_block(stack.writes, fits, stepped_in.witness, back, 0, [registers.step()], stepped_in.proof,
                    program.block_reads_at(laid, stepped_in.witness, back, 0, [registers.step()], stepped_in.proof), turned, post,
                    λ s memory held => ⟨⟨args_after_write(words_of(values, next), registers.state, s.gprs, registers.counter,
                            read_gpr(registers.counter, s.gprs).add(c), apart.left, held.left.left),
                        trans(read_gpr_after_write(registers.counter, read_gpr(registers.counter, s.gprs).add(c), s.gprs),
                            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), held.left.right), loop_counter_step(rest)))⟩,
                        ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal([registers.step()], s).gprs, held.right.left,
                            execute_block_kept<M>([registers.step()], s, body_kept(saves), apart.right.right.right.right)), held.right.right⟩⟩)),
            site.moves_jump(stack.writes, fits, again_in.witness, stepped, 0, h_name, again_in.proof, h_at, jump_lands, post)))
}

// The loop: the entry's moves, the passes by induction, and the file after.
theorem loop_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), lending: Lending,
    Pass: Valuation() → Buffers() → Buffers() → Type, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog, file: File,
    inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, body: StructuredRegion, exit: Nat, next, outputs: List<Nat>,
    exhausted: Nat, names: Nat, entry: LoopEntry, entry_ok: LoopEntryOk<M>(saves, values, file, inputs, limit, parameters, count, entry),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Buffers()) →
        EmitsOver<M>(saves, site, stack, lending, v, d, s0, loop_tested(prog, entry, names), entry.head, Pass(v, from, to), from, to, pass),
    before, after: Buffers(),
    out: LoopExit, out_ok: LoopExitOk<M>(saves, pass.file, entry.registers, count, exit, next, outputs, exhausted, out)):
    EmitsOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        LoopRunsOver(Pass, parameters, count, exit, next, values(64, limit).toNat(), words_of(values, inputs), words_of(values, outputs),
            values(1, exhausted).head_bit(), before, after),
        before, after, Emitted(loop_done(pass.prog, entry.registers, out, names), out.out, pass.placement, pass.names)) {
    let registers = entry.registers;
    let apart = entry_ok.right.right;
    let entered = At(prog, 0, Block(entry.code));
    let head = loop_head(prog, entry, names);
    let tested = loop_tested(prog, entry, names);
    let jumped = loop_jumped(pass.prog, registers, out, names);
    let again = loop_again(pass.prog, registers, out, names);
    let set = loop_set(pass.prog, registers, out, names);
    let done = loop_done(pass.prog, registers, out, names);
    let x_name = Succ(Succ(Succ(names)));
    let grown: tested.Within(pass.prog) = pass_emits(values, before, before).left;
    let opened: prog.Within(tested) = Exists(4, refl);
    let closed: pass.prog.Within(done) = Exists(12, refl);
    let holds = LoopRunsOver(Pass, parameters, count, exit, next, values(64, limit).toNat(), words_of(values, inputs),
        words_of(values, outputs), values(1, exhausted).head_bit(), before, after);
    let keep = λ (now: Buffers()) => λ (m: M) => stack.Trail(lending, d, s0.memory, now, m);
    ⟨prog.within_trans(tested, done, opened, tested.within_trans(pass.prog, done, grown, closed)),
     λ within => {
        let program = site.program;
        let unique = program.laid_out_unique(laid);
        let pass_in = pass.prog.within_trans(done, program, closed, within);
        let tested_in = tested.within_trans(pass.prog, program, grown, pass_in);
        let head_back: head.Within(tested) = Exists(2, refl);
        let head_in = head.within_trans(tested, program, head_back, tested_in);
        let entered_back: entered.Within(tested) = Exists(3, refl);
        let entered_in = entered.within_trans(tested, program, entered_back, tested_in);
        let jumped_back: jumped.Within(done) = Exists(7, refl);
        let jumped_in = jumped.within_trans(done, program, jumped_back, within);
        let cont_back: At(jumped, Succ(Succ(names)), Block([])).Within(done) = Exists(6, refl);
        let cont_in = At(jumped, Succ(Succ(names)), Block([])).within_trans(done, program, cont_back, within);
        let again_back: again.Within(done) = Exists(3, refl);
        let again_in = again.within_trans(done, program, again_back, within);
        let x_back: At(again, x_name, Block([])).Within(done) = Exists(2, refl);
        let x_in = At(again, x_name, Block([])).within_trans(done, program, x_back, within);
        let set_in = set.within_before(Succ(x_name), Block([]), program, within);
        let h_lands = label_target(head_in.witness, program, entered, names, Block([]), unique, head_in.proof);
        let c_lands = label_target(cont_in.witness, program, jumped, Succ(names), Block([]), unique, cont_in.proof);
        let x_lands = label_target(x_in.witness, program, again, Succ(Succ(names)), Block([]), unique, x_in.proof);
        let j_lands = label_target(within.witness, program, set, x_name, Block([]), unique, within.proof);
        let Head = λ (r: Nat) (state: List<BitVec(64)>) (now: Buffers()) (s: MachineState<M>) =>
            stack.LoopHead(saves, keep(now), s0, registers, r, state)(s.gprs, s.memory);
        let Done = λ (final: List<BitVec(64)>) (e: Bool) (now: Buffers()) (s: MachineState<M>) =>
            stack.LoopDone(saves, keep(now), s0, registers, final, e)(s.gprs, s.memory);
        let Passed = λ (v: Valuation()) (now: Buffers()) (s: MachineState<M>) =>
            stack.LoopPassed(saves, keep(now), s0, pass.file, v)(s.gprs, s.memory);
        let stop = λ (state: List<BitVec(64)>) (now: Buffers()) => loop_stops<M>(saves, site, laid, stack, keep(now), s0, head, registers, x_name,
            prog_len(again), x_lands, tested_in, state, prog_len(done), Done(state, True, now),
            loop_marks<M>(saves, site, laid, stack, keep(now), s0, registers, apart, again, x_name, set_in.witness, set_in.proof, state));
        let enters = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (from: Buffers()) (to: Buffers()) (passed: Pass(v, from, to)) =>
            loop_enters<M>(saves, site, laid, stack, keep(from), s0, head, registers, x_name, prog_len(again), x_lands, tested_in, rest, lt,
                words_of(v, parameters), prog_len(pass.prog), Passed(v, to),
                loop_body_runs<M>(saves, site, stack, lending, Pass, d, s0, tested, entry, count, parameters, entry_ok.right.left, body, v, from, to,
                    pass, pass_emits(v, from, to), pass_in, rest, counted, passed));
        let leave = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (from: Buffers()) (to: Buffers()) (passed: Pass(v, from, to)) (set_bit: v(1, exit).head_bit() = True) =>
            site.moves_trans(stack.writes, prog_len(head), prog_len(pass.prog), prog_len(done),
                Head(Succ(rest), words_of(v, parameters), from), Passed(v, to), Done(words_of(v, next), False, to),
                enters(rest, lt, v, counted, from, to, passed),
                loop_leaves<M>(saves, site, laid, stack, keep(to), s0, registers, apart, pass.prog, pass.file, count, exit, next, outputs, exhausted,
                    out, out_ok, names, jumped_in, c_lands, prog_len(done), j_lands, v, set_bit));
        let rounds = λ (rest: Nat) (lt: Succ(rest) < Nat::pow(2, 64)) (v: Valuation()) (counted: v(64, count) = BitVec::ofNat(Succ(rest)))
            (from: Buffers()) (to: Buffers()) (passed: Pass(v, from, to)) (clear: v(1, exit).head_bit() = False) =>
            site.moves_trans(stack.writes, prog_len(head), prog_len(pass.prog), prog_len(head),
                Head(Succ(rest), words_of(v, parameters), from), Passed(v, to), Head(rest, words_of(v, next), to),
                enters(rest, lt, v, counted, from, to, passed),
                loop_rounds<M>(saves, site, laid, stack, keep(to), s0, registers, apart, pass.prog, pass.file, count, exit, next, outputs, exhausted,
                    out, out_ok, names, again_in, c_lands, prog_len(head), h_lands, v, clear, rest, lt, counted));
        let n = values(64, limit).toNat();
        let pre = λ (g: Gprs) (m: M) => (file.Represents(values, g) ∧ holds) ∧
            (Kept(body_kept(saves), s0.gprs, g) ∧ stack.Trail(lending, d, s0.memory, before, m));
        let entering = site.moves_block(stack.writes, program.laid_out_fits(laid), entered_in.witness, prog, 0, entry.code, entered_in.proof,
            program.block_reads_at(laid, entered_in.witness, prog, 0, entry.code, entered_in.proof),
            pre, stack.LoopHead(saves, keep(before), s0, registers, n, words_of(values, inputs)),
            λ s memory held => {
                let ran = entry_ok.left(s, held.left.left);
                ⟨⟨ran.left.right, trans(ran.left.left, sym(BitVec::ofNat_toNat(64, values(64, limit))))⟩,
                 ⟨kept_trans(body_kept(saves), s0.gprs, s.gprs, execute_block_normal(entry.code, s).gprs, held.right.left, ran.right),
                  held.right.right⟩⟩
            });
        let finished = λ (t: MachineState<M>) => out.out.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, s0, after, t);
        λ s here resident held => site.moves_trans(stack.writes, prog_len(prog), prog_len(head), prog_len(done),
            λ (x: MachineState<M>) => pre(x.gprs, x.memory), Head(n, words_of(values, inputs), before), finished,
            entering,
            site.moves_weaken(stack.writes, prog_len(head), prog_len(done), Head(n, words_of(values, inputs), before),
                Done(words_of(values, outputs), values(1, exhausted).head_bit(), after), Head(n, words_of(values, inputs), before), finished,
                site.loop_passes(stack.writes, prog_len(head), prog_len(done), Head, Done,
                    Pass, parameters, count, exit, next, stop, leave, rounds,
                    n, BitVec::toNat_lt_pow(64, values(64, limit)), words_of(values, inputs), words_of(values, outputs),
                    values(1, exhausted).head_bit(), before, after, held.left.right),
                λ x h => h,
                λ t ended => ⟨out_ok.right.right.right(values, t.gprs, ended.left.left,
                    j(sym(BitVec::one_bit_eq_ofBool(values(1, exhausted))), λ x _ => x.zero_extend(63) = read_gpr(registers.flag, t.gprs),
                        ended.left.right)), ended.right⟩))(s, here, resident, held)
     }⟩
}

theorem loop_close_emits<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    lending: Lending, Pass: Valuation() → Buffers() → Buffers() → Type, values: Valuation(), d: Nat, s0: MachineState<M>, prog: Prog,
    file: File,
    inputs: List<Nat>, limit: Nat, parameters: List<Nat>, count: Nat, body: StructuredRegion, exit: Nat, next, outputs: List<Nat>,
    exhausted: Nat, names: Nat, entry: LoopEntry, entry_ok: LoopEntryOk<M>(saves, values, file, inputs, limit, parameters, count, entry),
    pass: Emitted,
    pass_emits: (v: Valuation()) → (from, to: Buffers()) →
        EmitsOver<M>(saves, site, stack, lending, v, d, s0, loop_tested(prog, entry, names), entry.head, Pass(v, from, to), from, to, pass),
    before, after: Buffers()):
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        LoopRunsOver(Pass, parameters, count, exit, next, values(64, limit).toNat(), words_of(values, inputs), words_of(values, outputs),
            values(1, exhausted).head_bit(), before, after),
        before, after, pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names)) {
    (match pass.file.loop_exit(saves, entry.registers, count, exit, next, outputs, exhausted) as λ e =>
        MayLoopExit<M>(saves, pass.file, entry.registers, count, exit, next, outputs, exhausted, e) →
        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
            LoopRunsOver(Pass, parameters, count, exit, next, values(64, limit).toNat(), words_of(values, inputs),
                words_of(values, outputs), values(1, exhausted).head_bit(), before, after),
            before, after,
            match e {
                None => None,
                Some(out) => Some(Emitted(loop_done(pass.prog, entry.registers, out, names), out.out, pass.placement, pass.names)),
            }) {
        None => λ _ => trivial,
        Some(out) => λ out_ok => loop_emits<M>(saves, site, laid, stack, lending, Pass, values, d, s0, prog, file, inputs, limit, parameters,
            count, body, exit, next, outputs, exhausted, names, entry, entry_ok, pass, pass_emits, before, after, out, out_ok),
    })(loop_exit_sound<M>(saves, pass.file, entry.registers, count, exit, next, outputs, exhausted))
}

// The region theorem over machine runs: whatever `emit_calls` emits keeps
// the trail and runs the region from the file it starts over to the file
// its meaning says, its calls answered by the functions below `bound`, its
// loads by the buffers as the file then has them.
theorem StructuredRegion::emit_calls_runs<M>(self region: StructuredRegion, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), bound: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), needs: Nat → Nat → Bool,
    calls: site.CallsLent(stack, effects, bound, lending.counts, needs, top),
    values: Valuation(), d: Nat, s0: MachineState<M>, rsp0: read_gpr(Rsp, s0.gprs) = stack.at(d), room: 136 * bound + 24 <= d,
    fits: d + 64 <= stack.size, under: d + 72 <= top): ((b: Nat) → region.stores(b).IsTrue() → lending.written(b) = True) →
    region.Asks(needs, lending.written) → (homes: List<Lent>) → (prog: Prog) → (file: File) → (placement: List<Place>) →
    (names: Nat) → (before, after: Buffers()) →
    MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file,
        StructuredRegionRunsOver(effects, values, region, before, after) ∧ HomesHold(homes, values, lending.addresses, lending.buffers),
        before, after, region.emit_calls(saves, prog, file, placement, names, bound, lending.counts, homes)) {
    let leaf_under: (d + 64 <= top) = { omega };
    match region {
        Dataflow(body) => λ allowed asks homes prog file placement names before after =>
            emit_leaf_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, leaf_under, prog, file, body.nodes, placement, names,
                homes, allowed, before, after),
        Sequence(prefix, continuation) => λ allowed asks homes prog file placement names before after => {
            let held_homes = HomesHold(homes, values, lending.addresses, lending.buffers);
            let First = λ (mid: Buffers()) => NodesRun(prefix.nodes, values, before, mid) ∧ held_homes;
            let Second = λ (mid: Buffers()) => StructuredRegionRunsOver(effects, values, continuation, mid, after) ∧ held_homes;
            let facts = StructuredRegionRunsOver(effects, values, Sequence(prefix, continuation), before, after) ∧ held_homes;
            (match emit_leaf(saves, prog, file, prefix.nodes, placement, names, homes) as λ e =>
                ((mid: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, First(mid), before, mid, e)) →
                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match e {
                    None => None,
                    Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts, homes),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file,
                    Exists<Buffers()>(λ mid => First(mid) ∧ Second(mid)), facts,
                    λ held => Exists(held.left.witness, ⟨⟨held.left.proof.left, held.right⟩, ⟨held.left.proof.right, held.right⟩⟩),
                    before, after,
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts, homes),
                    may_emit_over_seq<M>(saves, site, stack, lending, values, d, s0, prog, file, First, Second, before, after, first, first_emits,
                        continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts, homes),
                        λ mid => continuation.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0,
                            rsp0, room, fits, under, λ b stores => allowed(b, Bool::is_true_or_r(nodes_store(prefix.nodes, b), continuation.stores(b), stores)), asks, homes, first.prog, first.file, first.placement, first.names, mid, after))),
            })(λ mid => emit_leaf_runs<M>(saves, site, laid, stack, top, lending, loan, values, d, s0, leaf_under, prog, file, prefix.nodes,
                placement, names, homes,
                λ b stores => allowed(b, Bool::is_true_or_l(nodes_store(prefix.nodes, b), continuation.stores(b), stores)), before, mid))
        },
        Compose(prefix, continuation) => λ allowed asks homes prog file placement names before after => {
            let held_homes = HomesHold(homes, values, lending.addresses, lending.buffers);
            let lent_homes = HomesHold(prefix.lends(homes), values, lending.addresses, lending.buffers);
            let First = λ (mid: Buffers()) => StructuredRegionRunsOver(effects, values, prefix, before, mid) ∧ held_homes;
            let Second = λ (mid: Buffers()) => StructuredRegionRunsOver(effects, values, continuation, mid, after) ∧ lent_homes;
            let facts = StructuredRegionRunsOver(effects, values, Compose(prefix, continuation), before, after) ∧ held_homes;
            (match prefix.emit_calls(saves, prog, file, placement, names, bound, lending.counts, homes) as λ e =>
                ((mid: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, First(mid), before, mid, e)) →
                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match e {
                    None => None,
                    Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts,
                        prefix.lends(homes)),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_emits => may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file,
                    Exists<Buffers()>(λ mid => First(mid) ∧ Second(mid)), facts,
                    λ held => Exists(held.left.witness, ⟨⟨held.left.proof.left, held.right⟩, ⟨held.left.proof.right,
                        prefix.lends_hold(values, lending.addresses, lending.buffers, effects, homes, before, held.left.witness, held.right,
                            held.left.proof.left)⟩⟩),
                    before, after,
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts, prefix.lends(homes)),
                    may_emit_over_seq<M>(saves, site, stack, lending, values, d, s0, prog, file, First, Second, before, after, first, first_emits,
                        continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, lending.counts,
                            prefix.lends(homes)),
                        λ mid => continuation.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0,
                            rsp0, room, fits, under, λ b stores => allowed(b, Bool::is_true_or_r(prefix.stores(b), continuation.stores(b), stores)), asks.right, prefix.lends(homes), first.prog, first.file, first.placement, first.names, mid, after))),
            })(λ mid => prefix.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0, rsp0, room,
                fits, under, λ b stores => allowed(b, Bool::is_true_or_l(prefix.stores(b), continuation.stores(b), stores)), asks.left, homes, prog, file, placement, names, before, mid))
        },
        // The motive is written out: read off the goal it is past the
        // budget a stuck head is spelled within, the file's slots being a
        // reduction further down than a function's application was.
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ allowed asks homes prog file placement names before after => {
            let held_homes = HomesHold(homes, values, lending.addresses, lending.buffers);
            let facts = StructuredRegionRunsOver(effects, values, Conditional(inputs, condition, arguments, outputs, when_true, when_false),
                before, after) ∧ held_homes;
            match file.branch_test(condition) as λ t =>
                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match t {
                        None => None,
                        Some(tested) => match when_true.emit_calls(saves, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)), placement, Succ(Succ(names)), bound, lending.counts, homes) {
                            None => None,
                            Some(yes) => match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound, lending.counts, homes) {
                                None => None,
                                Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                            },
                        },
                    }) {
                None => trivial,
                Some(tested) =>
                    (match when_true.emit_calls(saves, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)), placement, Succ(Succ(names)), bound, lending.counts, homes) as λ y =>
                        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)),
                            StructuredRegionRunsOver(effects, values, when_true, before, after) ∧ held_homes, before, after, y) →
                        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match y {
                                None => None,
                                Some(yes) => match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound, lending.counts, homes) {
                                    None => None,
                                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                },
                            }) {
                        None => λ _ => trivial,
                        Some(yes) => λ yes_emits =>
                            (match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound, lending.counts, homes) as λ n =>
                                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)),
                                    StructuredRegionRunsOver(effects, values, when_false, before, after) ∧ held_homes, before, after, n) →
                                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match n {
                                        None => None,
                                        Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                    }) {
                                None => λ _ => trivial,
                                Some(no) => λ no_emits => branch_emits_over<M>(saves, site, laid, stack, lending, effects, values, d, s0, prog, file,
                                    inputs, condition, arguments, outputs, when_true, when_false, held_homes, before, after, tested, names,
                                    yes, no, yes_emits, no_emits),
                            })(when_false.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0, rsp0,
                                room, fits, under, λ b stores => allowed(b, Bool::is_true_or_r(when_true.stores(b), when_false.stores(b), stores)), asks.right, homes, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names,
                                before, after)),
                    })(when_true.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0, rsp0, room,
                        fits, under, λ b stores => allowed(b, Bool::is_true_or_l(when_true.stores(b), when_false.stores(b), stores)), asks.left, homes, prog.branched(tested.test, Succ(names)), file.know(Truth(condition)), placement,
                        Succ(Succ(names)), before, after)),
            }
        },
        Lend(views, callee, arguments, result) => λ allowed asks homes prog file placement names before after =>
            file.emit_lend_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, values, d, s0, rsp0, room, fits,
                under, prog, views, callee, arguments, result, placement, names, homes, allowed, asks, before, after),
        Call(callee, arguments, result) => λ allowed asks homes prog file placement names before after =>
            file.emit_call_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, values, d, s0, rsp0, room, fits, under, prog,
                callee, arguments, result, placement, names, homes, before, after,
                λ below => calls(lending, refl, loan, callee, below, asks, words_of(values, arguments), values(64, result), before, after)),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) => λ allowed asks homes prog file placement names before after => {
            let held_homes = HomesHold(homes, values, lending.addresses, lending.buffers);
            let facts = StructuredRegionRunsOver(effects, values,
                Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted), before, after) ∧ held_homes;
            let carried = carried_homes(loop_carried(homes, inputs, parameters, next));
            let Ran = λ (v: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, v, body, from, to);
            let Pass = λ (v: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, v, body, from, to) ∧
                HomesHold(carried, v, lending.addresses, lending.buffers);
            let holds = LoopRunsOver(Pass, parameters, count, exit, next, values(64, limit).toNat(), words_of(values, inputs),
                words_of(values, outputs), values(1, exhausted).head_bit(), before, after);
            (match file.loop_entry(saves, inputs, limit, parameters, count, placement) as λ e =>
                MayLoopEntry<M>(saves, values, file, inputs, limit, parameters, count, e) →
                MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match e {
                    None => None,
                    Some(entry) => match body.emit_calls(saves, loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))), bound, lending.counts, carried_homes(loop_carried(homes, inputs, parameters, next))) {
                        None => None,
                        Some(pass) => pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                    },
                }) {
                None => λ _ => trivial,
                Some(entry) => λ entry_ok =>
                    (match body.emit_calls(saves, loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))), bound, lending.counts, carried_homes(loop_carried(homes, inputs, parameters, next))) as λ b =>
                        ((v: Valuation()) → (from, to: Buffers()) → MayEmitOver<M>(saves, site, stack, lending, v, d, s0,
                            loop_tested(prog, entry, names), entry.head, Pass(v, from, to), from, to, b)) →
                        MayEmitOver<M>(saves, site, stack, lending, values, d, s0, prog, file, facts, before, after, match b {
                            None => None,
                            Some(pass) => pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                        }) {
                        None => λ _ => trivial,
                        Some(pass) => λ pass_emits => may_emit_over_weaken<M>(saves, site, stack, lending, values, d, s0, prog, file, holds, facts,
                            λ held => loop_carries(Ran, values, lending.addresses, lending.buffers, homes, held.right, inputs, parameters, count,
                                exit, next, values(64, limit).toNat(), words_of(values, outputs), values(1, exhausted).head_bit(), before, after,
                                held.left).left,
                            before, after, pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                            loop_close_emits<M>(saves, site, laid, stack, lending, Pass, values, d, s0, prog, file, inputs, limit, parameters, count,
                                body, exit, next, outputs, exhausted, names, entry, entry_ok, pass, pass_emits, before, after)),
                    })(λ v from to => body.emit_calls_runs<M>(saves, site, laid, stack, top, effects, bound, lending, loan, needs, calls, v, d, s0, rsp0,
                        room, fits, under, allowed, asks, carried_homes(loop_carried(homes, inputs, parameters, next)), loop_tested(prog, entry, names),
                        entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))), from, to)),
            })(loop_entry_sound<M>(saves, values, file, inputs, limit, parameters, count, placement))
        },
    }
}

// ---------------------------------------------------------------------------
// Functions

// A frame of fourteen slots, allocated and freed by ADD RSP, imm8: eight a
// call spills the caller-saved registers into, and six above them for the
// callee-saved registers the function saves at its entry.
fn frame_allocate() → Instruction { AddRI8(Rsp, BitVec::ofNat(256 - 112)) }
fn frame_free() → Instruction { AddRI8(Rsp, BitVec::ofNat(112)) }

theorem frame_allocated(low: BitVec(64), i: Nat):
    next_rip(low, i + 112).add(BitVec::ofNat(256 - 112, n := 8).sign_extend(56)) = next_rip(low, i) {
    let reading: (BitVec::ofNat(256 - 112, n := 8).sign_extend(56).toNat() = Nat::pow(2, 64) - 112) = refl;
    let count: ((i + 112) + (Nat::pow(2, 64) - 112) = i + Nat::pow(2, 64)) = { omega };
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(low, i + 112), BitVec::ofNat(256 - 112, n := 8).sign_extend(56))),
    trans(rip_count(next_rip(low, i + 112), reading),
    trans(rip_compose(low, i + 112, Nat::pow(2, 64) - 112),
    trans(rip_count(low, count),
    trans(sym(rip_compose(low, i, Nat::pow(2, 64))), BitVec::iterate_increment_period(64, next_rip(low, i)))))))
}

theorem frame_freed(low: BitVec(64), i: Nat):
    next_rip(low, i).add(BitVec::ofNat(112, n := 8).sign_extend(56)) = next_rip(low, i + 112) {
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(low, i), BitVec::ofNat(112, n := 8).sign_extend(56))), rip_compose(low, i, 112))
}

// The callee-saved registers a function saves: the first `saves` it may
// hold values in (`kept_order`), stored in the slots from the eighth at its
// entry and loaded back at its exit.
fn function_saves(saves: Nat) → List<Gpr> { kept_order().take(saves) }

// The registers once the frame is allocated below the return address at
// `d + 112`, everything else as the function was entered.
fn Stack::opened<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d: Nat,
    s0: MachineState<M>) → MachineState<M> {
    MachineState(write_gpr(Rsp, stack.at(d), s0.gprs), s0.flags, s0.rip, s0.memory)
}

// The frame allocated.
theorem prologue_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    prog: Prog, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block([frame_allocate()])),
    s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 112)):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = stack.opened(d, s0).gprs) ∧ (x.memory = s0.memory)) {
    let c = BitVec::ofNat(256 - 112, n := 8).sign_extend(56);
    let opened: (write_gpr(Rsp, read_gpr(Rsp, s0.gprs).add(c), s0.gprs) = write_gpr(Rsp, stack.at(d), s0.gprs)) =
        cong_fn<BitVec(64), Gprs>(λ a => write_gpr(Rsp, a, s0.gprs),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), rsp), frame_allocated(stack.low, d)));
    let pre = λ (g: Gprs) (m: M) => (g = s0.gprs) ∧ (m = s0.memory);
    let post = λ (g: Gprs) (m: M) => (g = write_gpr(Rsp, stack.at(d), s0.gprs)) ∧ (m = s0.memory);
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_allocate()]), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, [frame_allocate()], at,
            site.program.block_reads_at(laid, k, prog, 0, [frame_allocate()], at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let ran: (execute_block_normal([frame_allocate()], x).gprs = write_gpr(Rsp, stack.at(d), s0.gprs)) =
                    j(sym(held.left), λ g _ => write_gpr(Rsp, read_gpr(Rsp, g).add(c), g) = write_gpr(Rsp, stack.at(d), s0.gprs), opened);
                ⟨ran, held.right⟩
            }))
}

// The result moved into RAX, memory as it was (`keep` is what the body
// says of it).
theorem result_moves<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    values: Valuation(), keep: M → Type, s1: MachineState<M>, prog: Prog, file: File, result: Nat, moves: Lowered,
    keeps: Keeps<M>(values, file, True, moves), placed: moves.file.outputs_check([Port(id := result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(), k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block(moves.code))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code),
        λ (s: MachineState<M>) => file.Represents(values, s.gprs) ∧ (Kept(body_kept(saves), s1.gprs, s.gprs) ∧ keep(s.memory)),
        λ (t: MachineState<M>) => (read_gpr(Rax, t.gprs) = values(64, result)) ∧ (Kept(body_kept(saves), s1.gprs, t.gprs) ∧ keep(t.memory))) {
    let pre = λ (g: Gprs) (m: M) => file.Represents(values, g) ∧ (Kept(body_kept(saves), s1.gprs, g) ∧ keep(m));
    let post = λ (g: Gprs) (m: M) => (read_gpr(Rax, g) = values(64, result)) ∧ (Kept(body_kept(saves), s1.gprs, g) ∧ keep(m));
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length(moves.code), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, moves.code, at,
            site.program.block_reads_at(laid, k, prog, 0, moves.code, at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let y = execute_block_normal(moves.code, x);
                ⟨sym(outputs_check_sound(values, moves.file, y.gprs, keeps(x, held.left, trivial),
                    [Port(id := result, width := 64)], [Rax], placed).left),
                 ⟨kept_trans(body_kept(saves), s1.gprs, x.gprs, y.gprs, held.right.left,
                    execute_block_kept<M>(moves.code, x, body_kept(saves), leaves)), held.right.right⟩⟩
            }))
}

// The frame freed: the stack pointer back at the return address.
theorem epilogue_moves<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    d: Nat, keep: M → Type, gprs: Gprs, rsp: read_gpr(Rsp, gprs) = stack.at(d),
    prog: Prog, k: Nat, at: asm_back(site.program, k) = At(prog, 0, Block([frame_free()]))):
    site.Moves(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_free()]),
        λ (s: MachineState<M>) => (s.gprs = gprs) ∧ keep(s.memory),
        λ (t: MachineState<M>) => (t.gprs = write_gpr(Rsp, stack.at(d + 112), gprs)) ∧ keep(t.memory)) {
    let c = BitVec::ofNat(112, n := 8).sign_extend(56);
    let freed: (write_gpr(Rsp, read_gpr(Rsp, gprs).add(c), gprs) = write_gpr(Rsp, stack.at(d + 112), gprs)) =
        cong_fn<BitVec(64), Gprs>(λ a => write_gpr(Rsp, a, gprs),
            trans(cong_fn<BitVec(64), BitVec(64)>(λ a => a.add(c), rsp), frame_freed(stack.low, d)));
    let pre = λ (g: Gprs) (m: M) => (g = gprs) ∧ keep(m);
    let post = λ (g: Gprs) (m: M) => (g = write_gpr(Rsp, stack.at(d + 112), gprs)) ∧ keep(m);
    site.moves_of_pure(stack.writes, prog_len(prog), prog_len(prog) + block_length([frame_free()]), pre, post,
        λ memory => site.runs_block(site.program.laid_out_fits(laid), k, prog, 0, [frame_free()], at,
            site.program.block_reads_at(laid, k, prog, 0, [frame_free()], at),
            λ (g: Gprs) => pre(g, memory), λ (g: Gprs) => post(g, memory),
            λ x held => {
                let ran: (execute_block_normal([frame_free()], x).gprs = write_gpr(Rsp, stack.at(d + 112), gprs)) =
                    j(sym(held.left), λ g _ => write_gpr(Rsp, read_gpr(Rsp, g).add(c), g) = write_gpr(Rsp, stack.at(d + 112), gprs), freed);
                ⟨ran, held.right⟩
            }))
}

// What the saves are, whatever their count: none is the stack pointer,
// they are six at most, and loaded back over registers that kept the rest
// (`body_kept`) they leave every callee-saved register as it was saved,
// and the stack pointer and RAX as they were.
theorem saves_spare(saves: Nat): function_saves(saves).spare(Rsp).IsTrue() {
    match saves { Zero => trivial, Succ(a) => match a { Zero => trivial, Succ(b) => match b { Zero => trivial, Succ(c) => match c {
        Zero => trivial, Succ(e) => match e { Zero => trivial, Succ(f) => match f { Zero => trivial, Succ(_) => trivial } } } } } }
}

theorem saves_len(saves: Nat): function_saves(saves).len() <= 6 {
    let zero: (0 <= 6) = { omega };
    let one: (1 <= 6) = { omega };
    let two: (2 <= 6) = { omega };
    let three: (3 <= 6) = { omega };
    let four: (4 <= 6) = { omega };
    let five: (5 <= 6) = { omega };
    let six: (6 <= 6) = { omega };
    match saves { Zero => zero, Succ(a) => match a { Zero => one, Succ(b) => match b { Zero => two, Succ(c) => match c {
        Zero => three, Succ(e) => match e { Zero => four, Succ(f) => match f { Zero => five, Succ(_) => six } } } } } }
}

theorem saves_fit(saves, d, size: Nat, fits: d + 112 <= size):
    (8 + function_saves(saves).len() <= 16) ∧ (d + 8 * (8 + function_saves(saves).len()) <= size) {
    let six = saves_len(saves);
    ⟨{ omega }, { omega }⟩
}

theorem save_slot_inside(saves, d, i: Nat, high: i + 8 <= d + 8 * (8 + function_saves(saves).len())): i + 8 <= d + 112 {
    let six = saves_len(saves);
    omega
}

theorem saves_restored(saves: Nat, saved, gprs: Gprs):
    (read_gpr(Rsp, restore(function_saves(saves), saved, gprs)) = read_gpr(Rsp, gprs)) ∧
    ((read_gpr(Rax, restore(function_saves(saves), saved, gprs)) = read_gpr(Rax, gprs)) ∧
     (Kept(kept_order().drop(saves), saved, gprs) → Kept(callee_kept(), saved, restore(function_saves(saves), saved, gprs)))) {
    match saves {
        Zero => ⟨refl, ⟨refl, λ kept => ⟨kept.right.right.right.right.left, ⟨kept.right.right.right.right.right.left,
            ⟨kept.left, ⟨kept.right.left, ⟨kept.right.right.left, ⟨kept.right.right.right.left, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
        Succ(a) => match a {
            Zero => ⟨refl, ⟨refl, λ kept => ⟨kept.right.right.right.left, ⟨kept.right.right.right.right.left,
                ⟨refl, ⟨kept.left, ⟨kept.right.left, ⟨kept.right.right.left, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
            Succ(b) => match b {
                Zero => ⟨refl, ⟨refl, λ kept => ⟨kept.right.right.left, ⟨kept.right.right.right.left,
                    ⟨refl, ⟨refl, ⟨kept.left, ⟨kept.right.left, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
                Succ(c) => match c {
                    Zero => ⟨refl, ⟨refl, λ kept => ⟨kept.right.left, ⟨kept.right.right.left, ⟨refl, ⟨refl, ⟨refl, ⟨kept.left, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
                    Succ(e) => match e {
                        Zero => ⟨refl, ⟨refl, λ kept => ⟨kept.left, ⟨kept.right.left, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
                        Succ(f) => match f {
                            Zero => ⟨refl, ⟨refl, λ kept => ⟨refl, ⟨kept.left, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
                            Succ(_) => ⟨refl, ⟨refl, λ _ => ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, ⟨refl, trivial⟩⟩⟩⟩⟩⟩⟩⟩,
                        },
                    },
                },
            },
        },
    }
}

// What a function has done to memory since it was entered at `entry`, its
// frame at offset `d` below its return address: stores into the frame and
// below, and of bytes into the buffers the program may write; and the file
// `now` is the one in memory.
fn Stack::Entered<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    entry: M, now: Buffers(), memory: M) → Type {
    stack.WroteIn(d + 112, lending.spans(), entry, memory) ∧ stack.InMemory(lending, now, memory)
}

// A word stored in the frame keeps it.
theorem Stack::entered_store<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), top: Nat,
    lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()), d: Nat, under: d + 112 <= top, entry: M, now: Buffers(),
    memory: M, entered: stack.Entered(lending, d, entry, now, memory), k: Nat, inside: k + 8 <= d + 112, word: BitVec(64)):
    stack.Entered(lending, d, entry, now, stack.writes.store(memory, stack.at(k), word_bytes(word))) {
    let stored = stack.writes.store(memory, stack.at(k), word_bytes(word));
    let own = stack.wrote_store(d + 112, memory, k, inside, word);
    ⟨stack.wrote_in_trans(d + 112, lending.spans(), entry, memory, stored, entered.left,
        stack.wrote_in_own(d + 112, lending.spans(), memory, stored, own)),
     stack.in_memory_wrote(top, lending, loan, d + 112, under, now, memory, stored, own, entered.right)⟩
}

// Words left from `from` up to `top` keep the slots there.
theorem Stack::saved_above<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), d, from, top: Nat,
    gprs: Gprs, before, after: M, unchanged: stack.UnchangedTo(from, top, before, after), registers: List<Gpr>):
    (k: Nat) → from <= d + 8 * k → d + 8 * (k + registers.len()) <= top → stack.Saved(d, registers, k, gprs, before) →
    stack.Saved(d, registers, k, gprs, after) {
    match registers {
        Nil => λ k _ _ _ => trivial,
        Cons(register, rest) => λ k above room saved =>
            ⟨trans(unchanged(d + 8 * k, above, { omega }), saved.left),
             stack.saved_above(d, from, top, gprs, before, after, unchanged, rest, Succ(k), { omega }, { omega }, saved.right)⟩,
    }
}

// How many of a function's parameters its entry loads from the stack.
fn Function::loads(self function: Function) → Nat { function.parameters.drop(6).len() }

// An entry file is made only of as many entries as registers, so a
// function given one takes eight words or fewer.
theorem input_with_all(register: Gpr, id: Nat, kind: Option<Kind>, rest: Option<File>, A, B: Type, f: A → B):
    rest.All(λ (_: File) => A) → input_with(register, id, kind, rest).All(λ (_: File) => B) {
    match kind {
        None => λ _ => trivial,
        Some(_) => match rest { None => λ _ => trivial, Some(_) => λ a => f(a) },
    }
}
theorem input_file_fits(entries: List<Port>): (registers: List<Gpr>) →
    input_file(entries, registers).All(λ (_: File) => entries.len() <= registers.len()) {
    match entries {
        Nil => λ registers => { omega },
        Cons(port, rest) => λ registers => match registers {
            Nil => trivial,
            Cons(register, later) => input_with_all(register, port.id, Kind::of_width(port.width), input_file(rest, later),
                rest.len() <= later.len(), Succ(rest.len()) <= Succ(later.len()), λ fit => { omega }, input_file_fits(rest, later)),
        },
    }
}
theorem word_ports_len(ids: List<Nat>): word_ports(ids).len() = ids.len() {
    match ids { Nil => refl, Cons(_, rest) => cong_fn<Nat, Nat>(λ n => Succ(n), word_ports_len(rest)) }
}
theorem Function::loads_few(self function: Function, fits: word_ports(function.parameters).len() <= parameter_registers().len()):
    function.loads() <= 2 {
    let ports = word_ports_len(function.parameters);
    let dropped: (function.parameters.drop(6).len() = function.parameters.len() - 6) = function.parameters.len_drop(6);
    let eight: (parameter_registers().len() = 8) = refl;
    let unfolded: (function.loads() = function.parameters.drop(6).len()) = refl;
    { omega }
}

// A function's code after the label at `prog`: the words past the sixth
// loaded from above the return address, the frame, the saves, the body,
// the result into RAX, the saves loaded back, the frame freed, RET.
fn function_loaded(prog: Prog, k, loads: Nat) → Prog { stack_registers().loads(loads, At(prog, Succ(k), Block([])), 1) }
fn function_opened(prog: Prog, k, loads, saves: Nat) → Prog {
    function_saves(saves).spills(At(function_loaded(prog, k, loads), 0, Block([frame_allocate()])), 8)
}
fn function_closed(body: Prog, moves: List<Instruction>, saves: Nat) → Prog {
    At(function_saves(saves).reloads(At(body, 0, Block(moves)), 8), 0, Block([frame_free()]))
}

theorem loaded_opened(prog: Prog, k, loads, saves: Nat): function_loaded(prog, k, loads).Within(function_opened(prog, k, loads, saves)) {
    let loaded = function_loaded(prog, k, loads);
    let framed = At(loaded, 0, Block([frame_allocate()]));
    loaded.within_trans(framed, function_saves(saves).spills(framed, 8), loaded.within_then(0, Block([frame_allocate()])),
        Prog::within_spills(function_saves(saves), framed, 8))
}
theorem label_opened(prog: Prog, k, loads, saves: Nat): At(prog, Succ(k), Block([])).Within(function_opened(prog, k, loads, saves)) {
    let label = At(prog, Succ(k), Block([]));
    label.within_trans(function_loaded(prog, k, loads), function_opened(prog, k, loads, saves),
        Prog::within_loads(stack_registers(), loads, label, 1), loaded_opened(prog, k, loads, saves))
}

// The entry's loads leave the registers a callee keeps.
theorem kept_loads(kept, registers: List<Gpr>, words: List<BitVec(64)>, gprs: Gprs): kept.clear_of(registers).IsTrue() →
    Kept(kept, gprs, load_words(registers, words, gprs)) {
    match kept {
        Nil => λ _ => trivial,
        Cons(register, rest) => λ clear => {
            let parts = Bool::is_true_and(registers.spare(register), rest.clear_of(registers), clear);
            ⟨load_words_misses(register, registers, words, gprs, parts.left), kept_loads(rest, registers, words, gprs, parts.right)⟩
        },
    }
}

// The frame and the saves: the body starts with the registers as the
// function was entered but for the stack pointer, and the words of the
// registers it saves in their slots.
theorem function_enters<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), label: Prog,
    s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 112), fits: d + 112 <= stack.size, under: d + 112 <= top,
    now: Buffers(), in_memory: stack.InMemory(lending, now, s0.memory),
    within: function_saves(saves).spills(At(label, 0, Block([frame_allocate()])), 8).Within(site.program)):
    site.Moves(stack.writes, prog_len(label), prog_len(function_saves(saves).spills(At(label, 0, Block([frame_allocate()])), 8)),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = stack.opened(d, s0).gprs) ∧ (stack.Entered(lending, d, s0.memory, now, x.memory) ∧
            stack.Saved(d, function_saves(saves), 8, stack.opened(d, s0).gprs, x.memory))) {
    let g1 = stack.opened(d, s0).gprs;
    let framed = At(label, 0, Block([frame_allocate()]));
    let sizes = saves_fit(saves, d, stack.size, fits);
    let framed_in = framed.within_trans(function_saves(saves).spills(framed, 8), site.program,
        Prog::within_spills(function_saves(saves), framed, 8), within);
    let frame = λ (m: M) => stack.Entered(lending, d, s0.memory, now, m);
    let start: stack.Entered(lending, d, s0.memory, now, s0.memory) = ⟨stack.wrote_in_refl(d + 112, lending.spans(), s0.memory), in_memory⟩;
    site.moves_trans(stack.writes, prog_len(label), prog_len(framed), prog_len(function_saves(saves).spills(framed, 8)),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = g1) ∧ frame(x.memory),
        λ (x: MachineState<M>) => (x.gprs = g1) ∧ (frame(x.memory) ∧ stack.Saved(d, function_saves(saves), 8, g1, x.memory)),
        site.moves_weaken(stack.writes, prog_len(label), prog_len(framed),
            λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
            λ (x: MachineState<M>) => (x.gprs = g1) ∧ (x.memory = s0.memory),
            λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
            λ (x: MachineState<M>) => (x.gprs = g1) ∧ frame(x.memory),
            prologue_moves<M>(site, laid, stack, label, framed_in.witness, framed_in.proof, s0, d, rsp),
            λ x held => held,
            λ x held => ⟨held.left, j(sym(held.right), λ m _ => stack.Entered(lending, d, s0.memory, now, m), start)⟩),
        site.moves_spills(stack, site.program.laid_out_fits(laid), d, g1, read_gpr_after_write(Rsp, stack.at(d), s0.gprs),
            function_saves(saves), framed, 8, sizes.left, sizes.right, frame,
            λ memory i low high word held => stack.entered_store(top, lending, loan, d, under, s0.memory, now, memory, held, i,
                save_slot_inside(saves, d, i, high), word),
            within))
}

// The homes a function's scope starts with: its first `lent` pairs of
// parameters, buffer `k`'s address and length the `k`th pair.
fn Function::homes(self function: Function) → List<Lent> { lent_homes(function.parameters, function.lent, 0) }

// What the function's code does up to its RET, entered at `s0` with its
// parameters bound by `values`: its answer in RAX, the callee-saved
// registers as it was entered, the stack pointer back at its return
// address, and what it did to memory over the file its body leaves.
fn Stack::Closed<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), lending: Lending, d: Nat,
    s0: MachineState<M>, after: Buffers(), answer: BitVec(64), t: MachineState<M>) → Type {
    (read_gpr(Rax, t.gprs) = answer) ∧ (Kept(callee_kept(), s0.gprs, t.gprs) ∧
        ((read_gpr(Rsp, t.gprs) = stack.at(d + 112)) ∧ stack.Entered(lending, d, s0.memory, after, t.memory)))
}

// A function's run is three stages, each a theorem at the state it starts
// from, so that no stage's statement holds the proof of the one before it
// (docs/proof-patterns.md §2: as one theorem this was most of what the
// bundled library costs to check, issues/bundled-library-cold-check-past-the-rail.md).
// `function_enters` runs the entry to the state the saves end in;
// `function_runs_saved` runs the body and the result's moves from there; and
// `function_closes` loads the saves back from the slots the body's own
// stores and its callees' left (`Loan::unchanged`: they lie above the eight
// a call spills into) and frees the frame.
theorem function_closes<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), inner: Prog, code: List<Instruction>,
    within: function_closed(inner, code, saves).Within(site.program), s0: MachineState<M>, d: Nat, fits: d + 112 <= stack.size,
    under: d + 120 <= top, before, after: Buffers(), answer: BitVec(64), x1, x2: MachineState<M>,
    at1: (x1.gprs = stack.opened(d, s0).gprs) ∧ (stack.Entered(lending, d, s0.memory, before, x1.memory) ∧
        stack.Saved(d, function_saves(saves), 8, stack.opened(d, s0).gprs, x1.memory)),
    here: x2.rip = next_rip(site.origin, prog_len(At(inner, 0, Block(code)))), resident: site.Resident(x2.memory),
    at2: (read_gpr(Rax, x2.gprs) = answer) ∧ stack.Trailed(saves, lending, d, x1, after, x2)):
    site.Arrives(stack.writes, x2, prog_len(function_closed(inner, code, saves)),
        λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, answer, t)) {
    let g1 = stack.opened(d, s0).gprs;
    let spans = lending.spans();
    let returned = At(inner, 0, Block(code));
    let restored = function_saves(saves).reloads(returned, 8);
    let closed = function_closed(inner, code, saves);
    let under_frame: (d + 112 <= top) = { omega };
    let sizes = saves_fit(saves, d, stack.size, fits);
    let sizes_top = saves_fit(saves, d, top, under_frame);
    let restored_in = restored.within_before(0, Block([frame_free()]), site.program, within);
    let done = λ (m: M) => stack.Entered(lending, d, s0.memory, after, m);
    let rsp_x1: (read_gpr(Rsp, x1.gprs) = stack.at(d)) =
        j(sym(at1.left), λ g _ => read_gpr(Rsp, g) = stack.at(d), read_gpr_after_write(Rsp, stack.at(d), s0.gprs));
    let rsp_x2: (read_gpr(Rsp, x2.gprs) = stack.at(d)) = trans(at2.right.left.left, rsp_x1);
    let saved2: stack.Saved(d, function_saves(saves), 8, g1, x2.memory) =
        stack.saved_above(d, d + 64, top, g1, x1.memory, x2.memory, loan.unchanged(d + 64, x1.memory, x2.memory, at2.right.right.left),
            function_saves(saves), 8, { omega }, sizes_top.right, at1.right.right);
    let memory2: stack.Entered(lending, d, s0.memory, after, x2.memory) =
        ⟨stack.wrote_in_trans(d + 112, spans, s0.memory, x1.memory, x2.memory, at1.right.left.left,
            stack.wrote_in_deeper(d + 64, d + 112, { omega }, spans, x1.memory, x2.memory, at2.right.right.left)), at2.right.right.right⟩;
    let back = restore(function_saves(saves), g1, x2.gprs);
    let loaded = saves_restored(saves, g1, x2.gprs);
    let third = site.moves_trans(stack.writes, prog_len(returned), prog_len(restored), prog_len(closed),
        λ (x: MachineState<M>) => (x.gprs = x2.gprs) ∧ (done(x.memory) ∧ stack.Saved(d, function_saves(saves), 8, g1, x.memory)),
        λ (x: MachineState<M>) => (x.gprs = back) ∧ done(x.memory),
        λ (t: MachineState<M>) => (t.gprs = write_gpr(Rsp, stack.at(d + 112), back)) ∧ done(t.memory),
        site.moves_reloads(stack, site.program.laid_out_fits(laid), d, g1, function_saves(saves), returned, 8, x2.gprs, sizes.left,
            sizes.right, saves_spare(saves), rsp_x2, done, restored_in),
        epilogue_moves<M>(site, laid, stack, d, done, back, trans(loaded.left, rsp_x2), restored, within.witness, within.proof))(
        x2, here, resident, ⟨refl, ⟨memory2, saved2⟩⟩);
    let t = third.witness;
    let at3 = third.proof.right.right.right;
    let last = write_gpr(Rsp, stack.at(d + 112), back);
    let kept_body: Kept(kept_order().drop(saves), g1, x2.gprs) =
        j(at1.left, λ g _ => Kept(kept_order().drop(saves), g, x2.gprs), at2.right.left.right);
    let kept: Kept(callee_kept(), s0.gprs, last) = kept_trans(callee_kept(), s0.gprs, g1, last, kept_past_rsp(s0.gprs, stack.at(d)),
        kept_trans(callee_kept(), g1, back, last, loaded.right.right(kept_body), kept_past_rsp(back, stack.at(d + 112))));
    let rax: (read_gpr(Rax, last) = answer) = trans(write_spares(Rsp, Rax, stack.at(d + 112), back, trivial), trans(loaded.right.left, at2.left));
    let closed_at: stack.Closed(lending, d, s0, after, answer, t) =
        ⟨j(sym(at3.left), λ g _ => read_gpr(Rax, g) = answer, rax),
         ⟨j(sym(at3.left), λ g _ => Kept(callee_kept(), s0.gprs, g), kept),
          ⟨j(sym(at3.left), λ g _ => read_gpr(Rsp, g) = stack.at(d + 112), read_gpr_after_write(Rsp, stack.at(d + 112), back)), at3.right⟩⟩⟩;
    Exists(t, ⟨third.proof.left, ⟨third.proof.right.left, ⟨third.proof.right.right.left, closed_at⟩⟩⟩)
}

theorem function_runs_saved<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), k: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    needs: Nat → Nat → Bool, calls: site.CallsLent(stack, effects, k, lending.counts, needs, top), function: Function, prog: Prog,
    file: File, placement: List<Place>, names: Nat, body: Emitted,
    allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True, asks: function.body.Asks(needs, lending.written),
    emitted: function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, lending.counts, function.homes()) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    within: function_closed(body.prog, moves.code, saves).Within(site.program),
    values: Valuation(), s0: MachineState<M>, d: Nat, room: 136 * k + 24 <= d, fits: d + 112 <= stack.size, under: d + 120 <= top,
    before, after: Buffers(), ready: file.Represents(values, stack.opened(d, s0).gprs),
    holds: StructuredRegionRunsOver(effects, values, function.body, before, after) ∧
        HomesHold(function.homes(), values, lending.addresses, lending.buffers),
    x1: MachineState<M>, here: x1.rip = next_rip(site.origin, prog_len(function_opened(prog, k, function.loads(), saves))), resident: site.Resident(x1.memory),
    at1: (x1.gprs = stack.opened(d, s0).gprs) ∧ (stack.Entered(lending, d, s0.memory, before, x1.memory) ∧
        stack.Saved(d, function_saves(saves), 8, stack.opened(d, s0).gprs, x1.memory))):
    site.Arrives(stack.writes, x1, prog_len(function_closed(body.prog, moves.code, saves)),
        λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, values(64, function.result), t)) {
    let spans = lending.spans();
    let opened = function_opened(prog, k, function.loads(), saves);
    let returned = At(body.prog, 0, Block(moves.code));
    let restored = function_saves(saves).reloads(returned, 8);
    let closed = function_closed(body.prog, moves.code, saves);
    let answer = values(64, function.result);
    let facts = StructuredRegionRunsOver(effects, values, function.body, before, after) ∧
        HomesHold(function.homes(), values, lending.addresses, lending.buffers);
    let fits_body: (d + 64 <= stack.size) = { omega };
    let under_body: (d + 72 <= top) = { omega };
    let restored_in = restored.within_before(0, Block([frame_free()]), site.program, within);
    let returned_in = returned.within_trans(restored, site.program, Prog::within_reloads(function_saves(saves), returned, 8), restored_in);
    let body_in = body.prog.within_before(0, Block(moves.code), site.program, returned_in);
    let rsp_x1: (read_gpr(Rsp, x1.gprs) = stack.at(d)) =
        j(sym(at1.left), λ g _ => read_gpr(Rsp, g) = stack.at(d), read_gpr_after_write(Rsp, stack.at(d), s0.gprs));
    let body_emits = function.body.emit_calls(saves, opened, file, placement, names, k, lending.counts, function.homes()).all_some(
        λ (e: Emitted) => EmitsOver<M>(saves, site, stack, lending, values, d, x1, opened, file, facts, before, after, e),
        body, emitted,
        function.body.emit_calls_runs<M>(saves, site, laid, stack, top, effects, k, lending, loan, needs, calls, values, d, x1, rsp_x1, room,
            fits_body, under_body, allowed, asks, function.homes(), opened, file, placement, names, before, after));
    let start: stack.Trailed(saves, lending, d, x1, before, x1) =
        ⟨kept_refl(body_kept(saves), x1.gprs), ⟨stack.wrote_in_refl(d + 64, spans, x1.memory), at1.right.left.right⟩⟩;
    let keep = λ (m: M) => stack.Trail(lending, d, x1.memory, after, m);
    let second = site.moves_trans(stack.writes, prog_len(opened), prog_len(body.prog), prog_len(returned),
        λ (x: MachineState<M>) => (file.Represents(values, x.gprs) ∧ facts) ∧ stack.Trailed(saves, lending, d, x1, before, x),
        λ (t: MachineState<M>) => body.file.Represents(values, t.gprs) ∧ stack.Trailed(saves, lending, d, x1, after, t),
        λ (t: MachineState<M>) => (read_gpr(Rax, t.gprs) = answer) ∧ stack.Trailed(saves, lending, d, x1, after, t),
        body_emits.right(body_in),
        result_moves<M>(saves, site, laid, stack, values, keep, x1, body.prog, body.file, function.result, moves, keeps(values), placed,
            leaves, returned_in.witness, returned_in.proof))(x1, here, resident,
        ⟨⟨j(sym(at1.left), λ g _ => file.Represents(values, g), ready), holds⟩, start⟩);
    site.arrives_after(stack.writes, x1, second.witness, prog_len(closed),
        λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, answer, t), second.proof.left,
        function_closes<M>(saves, site, laid, stack, top, lending, loan, body.prog, moves.code, within, s0, d, fits, under, before, after, answer,
            x1, second.witness, at1, second.proof.right.left, second.proof.right.right.left, second.proof.right.right.right))
}

// The entry's loads, then the frame and the body. The loads leave the
// registers a callee keeps and memory as they were, so what the function
// leaves is stated of the state it was entered at.
theorem function_runs<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), k: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    needs: Nat → Nat → Bool, calls: site.CallsLent(stack, effects, k, lending.counts, needs, top), function: Function, prog: Prog,
    file: File, placement: List<Place>, names: Nat, body: Emitted,
    allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True, asks: function.body.Asks(needs, lending.written),
    emitted: function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, lending.counts, function.homes()) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g),
    few: function.loads() <= 2,
    within: function_closed(body.prog, moves.code, saves).Within(site.program),
    values: Valuation(), s0: MachineState<M>, d: Nat, rsp: read_gpr(Rsp, s0.gprs) = stack.at(d + 112),
    room: 136 * k + 24 <= d, fits: d + 112 <= stack.size, under: d + 120 <= top, before, after: Buffers(),
    in_memory: stack.InMemory(lending, before, s0.memory),
    passed: stack.Passes(words_of(values, function.parameters), argument_registers(), d + 120, s0.gprs, s0.memory),
    holds: StructuredRegionRunsOver(effects, values, function.body, before, after) ∧
        HomesHold(function.homes(), values, lending.addresses, lending.buffers)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code, saves)),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, values(64, function.result), t)) {
    let ws = words_of(values, function.parameters);
    let label = At(prog, Succ(k), Block([]));
    let loaded = function_loaded(prog, k, function.loads());
    let g_loaded = load_words(stack_registers(), ws.drop(6), s0.gprs);
    let s1 = MachineState(gprs := g_loaded, flags := s0.flags, rip := s0.rip, memory := s0.memory);
    let g1 = stack.opened(d, s1).gprs;
    let opened = function_opened(prog, k, function.loads(), saves);
    let returned = At(body.prog, 0, Block(moves.code));
    let restored = function_saves(saves).reloads(returned, 8);
    let closed = function_closed(body.prog, moves.code, saves);
    let answer = values(64, function.result);
    let facts = StructuredRegionRunsOver(effects, values, function.body, before, after) ∧
        HomesHold(function.homes(), values, lending.addresses, lending.buffers);
    let fits_body: (d + 64 <= stack.size) = { omega };
    let under_body: (d + 72 <= top) = { omega };
    let under_frame: (d + 112 <= top) = { omega };
    let restored_in = restored.within_before(0, Block([frame_free()]), site.program, within);
    let returned_in = returned.within_trans(restored, site.program, Prog::within_reloads(function_saves(saves), returned, 8), restored_in);
    let body_in = body.prog.within_before(0, Block(moves.code), site.program, returned_in);
    let rsp_g1: (read_gpr(Rsp, g1) = stack.at(d)) = read_gpr_after_write(Rsp, stack.at(d), g_loaded);
    let rsp_s1: (read_gpr(Rsp, g_loaded) = stack.at(d + 112)) =
        trans(load_words_misses(Rsp, stack_registers(), ws.drop(6), s0.gprs, trivial), rsp);
    // The entry lies in the program because the body does, which the
    // body's emission says at any state: at the opened one here.
    let body_emits = function.body.emit_calls(saves, opened, file, placement, names, k, lending.counts, function.homes()).all_some(
        λ (e: Emitted) => EmitsOver<M>(saves, site, stack, lending, values, d, stack.opened(d, s1), opened, file, facts, before, after, e),
        body, emitted,
        function.body.emit_calls_runs<M>(saves, site, laid, stack, top, effects, k, lending, loan, needs, calls, values, d, stack.opened(d, s1),
            rsp_g1, room, fits_body, under_body, allowed, asks, function.homes(), opened, file, placement, names, before, after));
    let opened_in = opened.within_trans(body.prog, site.program, body_emits.left, body_in);
    let loaded_in = loaded.within_trans(opened, site.program, loaded_opened(prog, k, function.loads(), saves), opened_in);
    // The parameters: six in their registers, the rest loaded.
    let counted: (ws.drop(6).len() = function.loads()) =
        trans(cong_fn<List<BitVec(64)>, Nat>(λ w => w.len(), words_of_drop(values, function.parameters, 6)),
            words_of_len(values, function.parameters.drop(6)));
    let few_words: (ws.drop(6).len() <= 2) = { omega };
    let small: (1 + ws.drop(6).len() <= 16) = { omega };
    let inside: (d + 120 = (d + 112) + 8 * 1) = { omega };
    let in_regs: ArgsIn(ws, parameter_registers(), g_loaded) =
        stack.passes_loaded(stack_registers(), trivial, ws, argument_registers(), d + 120, s0.gprs, s0.memory, trivial, few_words, passed);
    let ready: file.Represents(values, g1) = entered(values, g1, args_ports(values, function.parameters, parameter_registers(), g1,
        args_after_write(ws, parameter_registers(), g_loaded, Rsp, stack.at(d), trivial, in_regs)));
    let stacked: stack.Passes(ws.drop(6), Nil, (d + 112) + 8 * 1, s0.gprs, s0.memory) =
        j(inside, λ n _ => stack.Passes(ws.drop(6), Nil, n, s0.gprs, s0.memory),
            stack.passes_stacked(ws, argument_registers(), d + 120, s0.gprs, s0.gprs, s0.memory, passed));
    let first = j(counted, λ n _ => stack_registers().loads(n, label, 1).Within(site.program) →
            site.Moves(stack.writes, prog_len(label), prog_len(stack_registers().loads(n, label, 1)),
                λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
                λ (t: MachineState<M>) => (t.gprs = g_loaded) ∧ (t.memory = s0.memory)),
        site.moves_loads(stack, site.program.laid_out_fits(laid), d + 112, s0.gprs, s0.memory, stack_registers(), ws.drop(6), label, 1,
            s0.gprs, small, trivial, rsp, stacked))(loaded_in);
    let kept01: Kept(callee_kept(), s0.gprs, g_loaded) = kept_loads(callee_kept(), stack_registers(), ws.drop(6), s0.gprs, trivial);
    site.moves_trans(stack.writes, prog_len(prog), prog_len(loaded), prog_len(closed),
        λ (x: MachineState<M>) => (x.gprs = s0.gprs) ∧ (x.memory = s0.memory),
        λ (x: MachineState<M>) => (x.gprs = g_loaded) ∧ (x.memory = s0.memory),
        λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, answer, t),
        first,
        λ s here resident held => {
            let entering = function_enters<M>(saves, site, laid, stack, top, lending, loan, loaded, s1, d, rsp_s1, fits, under_frame, before,
                in_memory, opened_in)(s, here, resident, held);
            let ran = function_runs_saved<M>(saves, site, laid, stack, top, effects, k, lending, loan, needs, calls, function, prog, file, placement,
                names, body, allowed, asks, emitted, moves, keeps, placed, leaves, within, values, s1, d, room, fits, under, before, after, ready,
                holds, entering.witness, entering.proof.right.left, entering.proof.right.right.left, entering.proof.right.right.right);
            let t = ran.witness;
            let done: stack.Closed(lending, d, s1, after, answer, t) = ran.proof.right.right.right;
            site.arrives_after(stack.writes, s, entering.witness, prog_len(closed),
                λ (t: MachineState<M>) => stack.Closed(lending, d, s0, after, answer, t), entering.proof.left,
                Exists(t, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨ran.proof.right.right.left,
                    ⟨done.left, ⟨kept_trans(callee_kept(), s0.gprs, g_loaded, t.gprs, kept01, done.right.left), done.right.right⟩⟩⟩⟩⟩))
        })
}

// The arithmetic of a frame below the return address at offset `i`.
theorem frame_room(k, i, size: Nat, deep: 136 * Succ(k) <= i, room: i + 8 <= size):
    ((i - 112) + 112 = i) ∧ ((136 * k + 24 <= i - 112) ∧ ((i - 112) + 112 <= size)) {
    let back: ((i - 112) + 112 = i) = Nat::sub_add_cancel(112, i, { omega });
    ⟨back, ⟨{ omega }, { omega }⟩⟩
}

// And below the top of what the callers lent room for.
theorem frame_under(i, top: Nat, back: (i - 112) + 112 = i, below: i + 8 <= top):
    ((i - 112) + 120 <= top) ∧ (((i - 112) + 112) + 8 <= top) {
    ⟨{ omega }, { omega }⟩
}

// What function `k` is entered under: its arguments passed, six in their
// registers and the rest above its return address, what it may do to the
// file and return, room for its frames, and the file lent.
fn Stack::EnteredOver<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), effects: Effects(),
    lending: Lending, top: Nat, k: Nat, function: Function, words: List<BitVec(64)>, result: BitVec(64), before, after: Buffers()) →
    Nat → MachineState<M> → Type {
    λ i s => (stack.Passed(words, i, s) ∧ (function.Runs(effects, words, result, before, after) ∧ 136 * Succ(k) <= i)) ∧
        stack.LentOver(lending, top, k, words, before)(i, s)
}

// The function's code from its label to its RET, entered as its contract
// says. The return address is a word at the top of its room, which its
// own stores and the buffers' bytes leave (`Loan::unchanged`).
theorem function_body<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), k: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    needs: Nat → Nat → Bool, calls: site.CallsLent(stack, effects, k, lending.counts, needs, top), function: Function, prog: Prog,
    file: File, placement: List<Place>, names: Nat, body: Emitted,
    allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True, asks: function.body.Asks(needs, lending.written),
    emitted: function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, lending.counts, function.homes()) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g),
    few: function.loads() <= 2, count: function.lent = lent_count(lending.counts, k),
    within: function_closed(body.prog, moves.code, saves).Within(site.program),
    words: List<BitVec(64)>, result: BitVec(64), before, after: Buffers(), s0: MachineState<M>, i: Nat, ret: BitVec(64)):
    site.Moves(stack.writes, prog_len(prog), prog_len(function_closed(body.prog, moves.code, saves)),
        λ (s: MachineState<M>) => (s = s0) ∧ ((read_gpr(Rsp, s0.gprs) = stack.at(i)) ∧ ((i + 8 <= stack.size) ∧
            (stack.EnteredOver(effects, lending, top, k, function, words, result, before, after)(i, s0) ∧
             read_word(site.data, s0.memory, stack.at(i)) = Some(ret)))),
        λ (t: MachineState<M>) => (read_gpr(Rsp, t.gprs) = stack.at(i)) ∧ ((read_word(site.data, t.memory, stack.at(i)) = Some(ret)) ∧
            stack.AnsweredOver(lending, result, after)(i, s0, return_near_after(ret, t)))) {
    λ s here resident held => {
        let pre = held.right.right.right.left;
        let runs = pre.left.right.left;
        let values = runs.witness;
        let d = i - 112;
        let sizes = frame_room(k, i, stack.size, pre.left.right.right, held.right.right.left);
        let back: (d + 112 = i) = sizes.left;
        let unders = frame_under(i, top, back, pre.right.right.left);
        let at_back: (stack.at(d + 112) = stack.at(i)) = cong_fn<Nat, BitVec(64)>(λ n => stack.at(n), back);
        let above: (i + 8 = d + 120) = { omega };
        let homes_held = lent_homes_hold(values, lending.addresses, lending.buffers, function.lent, function.parameters, 0,
            j(sym(count), λ c _ => ArgsLent(c, 0, words_of(values, function.parameters), lending.addresses, lending.buffers),
                j(sym(runs.proof.left), λ w _ => ArgsLent(lent_count(lending.counts, k), 0, w, lending.addresses, lending.buffers),
                    pre.right.left)));
        let ran = function_runs<M>(saves, site, laid, stack, top, effects, k, lending, loan, needs, calls, function, prog, file, placement, names, body, allowed,
            asks, emitted, moves, keeps, placed, leaves, entered, few, within, values, s0, d,
            trans(held.right.left, sym(at_back)), sizes.right.left, sizes.right.right, unders.left, before, after,
            pre.right.right.right,
            j(sym(runs.proof.left), λ w _ => stack.Passes(w, argument_registers(), d + 120, s0.gprs, s0.memory),
                j(above, λ n _ => stack.Passes(words, argument_registers(), n, s0.gprs, s0.memory), pre.left.left)),
            ⟨runs.proof.right.left, homes_held⟩);
        let a = ran(s, here, resident, ⟨cong_fn<MachineState<M>, Gprs>(λ x => x.gprs, held.left),
            cong_fn<MachineState<M>, M>(λ x => x.memory, held.left)⟩);
        let t = a.witness;
        let done: stack.Closed(lending, d, s0, after, values(64, function.result), t) = a.proof.right.right.right;
        let kept: Kept(callee_kept(), s0.gprs, t.gprs) = done.right.left;
        let popped = read_gpr(Rsp, t.gprs).add(BitVec::ofNat(8));
        let trail: stack.Entered(lending, d, s0.memory, after, t.memory) = done.right.right.right;
        let unchanged_top: (read_word(site.data, t.memory, stack.at(d + 112)) = read_word(site.data, s0.memory, stack.at(d + 112))) =
            loan.unchanged(d + 112, s0.memory, t.memory, trail.left)(d + 112, (d + 112).le_refl(), unders.right);
        Exists(t, ⟨a.proof.left, ⟨a.proof.right.left, ⟨a.proof.right.right.left,
            ⟨trans(done.right.right.left, at_back),
             ⟨trans(j(back, λ n _ => read_word(site.data, t.memory, stack.at(n)) = read_word(site.data, s0.memory, stack.at(n)),
                    unchanged_top), held.right.right.right.right),
              ⟨trans(done.left, runs.proof.right.right),
               ⟨kept_trans(callee_kept(), s0.gprs, t.gprs, write_gpr(Rsp, popped, t.gprs), kept, kept_past_rsp(t.gprs, popped)),
                ⟨j(back, λ n _ => stack.WroteIn(n, lending.spans(), s0.memory, t.memory), trail.left), trail.right⟩⟩⟩⟩⟩⟩⟩⟩)
    }
}

// The function at the label at `prog` meets its contract: its parameters
// bound to the arguments, its body running from the file to the file, it
// returns its result over the file it leaves.
theorem function_returns<M>(saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    effects: Effects(), k: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()),
    needs: Nat → Nat → Bool, calls: site.CallsLent(stack, effects, k, lending.counts, needs, top), function: Function, prog: Prog,
    file: File, placement: List<Place>, names: Nat, body: Emitted,
    allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True, asks: function.body.Asks(needs, lending.written),
    emitted: function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, lending.counts, function.homes()) = Some(body),
    moves: Lowered, keeps: (values: Valuation()) → Keeps<M>(values, body.file, True, moves),
    placed: moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]).IsTrue(),
    leaves: leaves_all(moves.code, body_kept(saves)).IsTrue(),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g),
    few: function.loads() <= 2, count: function.lent = lent_count(lending.counts, k),
    within: At(function_closed(body.prog, moves.code, saves), 0, Ret).Within(site.program),
    words: List<BitVec(64)>, result: BitVec(64), before, after: Buffers()):
    site.Returns(stack, prog_len(prog), stack.EnteredOver(effects, lending, top, k, function, words, result, before, after),
        stack.AnsweredOver(lending, result, after)) {
    let closed = function_closed(body.prog, moves.code, saves);
    site.returns_by(stack, site.program.laid_out_fits(laid), prog_len(prog), within.witness, closed, 0, within.proof,
        stack.EnteredOver(effects, lending, top, k, function, words, result, before, after), stack.AnsweredOver(lending, result, after),
        λ s0 i ret => function_body<M>(saves, site, laid, stack, top, effects, k, lending, loan, needs, calls, function, prog, file, placement, names,
            body, allowed, asks, emitted, moves, keeps, placed, leaves, entered, few, count, closed.within_before(0, Ret, site.program, within), words, result,
            before, after, s0, i, ret))
}

// The function's code once its body is emitted: the result into RAX,
// refused where the moves lose it or touch a callee-saved register.
fn Function::closing(self function: Function, saves: Nat, body: Emitted) → Option<Emitted> {
    match body.file.move_outputs([Port(id := function.result, width := 64)], [Rax]) {
        None => None,
        Some(moves) => match moves.file.outputs_check([Port(id := function.result, width := 64)], [Rax]) &&
            leaves_all(moves.code, body_kept(saves)) {
            False => None,
            True => Some(Emitted(At(function_closed(body.prog, moves.code, saves), 0, Ret), File::empty(), body.placement, body.names)),
        },
    }
}

fn Function::emit_body(self function: Function, saves: Nat, prog: Prog, k: Nat, file: File, placement: List<Place>, names: Nat,
    counts: List<Nat>) → Option<Emitted> {
    match function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, counts, function.homes()) {
        None => None,
        Some(body) => function.closing(saves, body),
    }
}

// How many callee-saved registers a function saves: what its placement
// begins by saying (`Saving`), and none where it says nothing; the places
// of its nodes come after. Untrusted like every place: the body's code is
// checked to leave the registers the count does not cover.
fn placement_saves(placement: List<Place>) → Nat {
    match placement { Nil => 0, Cons(place, _) => match place { Saving(count) => count, Into(_) => 0, Folded => 0 } }
}
fn placement_body(placement: List<Place>) → List<Place> {
    match placement { Nil => [], Cons(place, rest) => match place { Saving(_) => rest, Into(_) => placement, Folded => placement } }
}

// Function `k`'s code after `prog`: its label, its frame, the saves its
// placement asks for, its body calling the functions below `k`, its result
// into RAX, the saves loaded back, RET. `counts` says how many buffers each
// function of the program takes; the function is refused where the table
// says another count of it than it does itself.
fn Function::emit_lent(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat, counts: List<Nat>) →
    Option<Emitted> {
    match function.lent.same(lent_count(counts, k)) {
        False => None,
        True => match input_file(word_ports(function.parameters), parameter_registers()) {
            None => None,
            Some(file) => function.emit_body(placement_saves(placement), prog, k, file, placement_body(placement), names, counts),
        },
    }
}

// In a program that lends nothing.
fn Function::emit(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat) → Option<Emitted> {
    function.emit_lent(prog, k, placement, names, [])
}

// What emitting a function proves: the code holds its label, and resident
// with the functions below `k` meeting their contracts, it meets its own.
fn MayReturnOver<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), k: Nat, lending: Lending,
    needs: Nat → Nat → Bool, function: Function, prog: Prog, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => At(prog, Succ(k), Block([])).Within(emitted.prog) ∧
        (emitted.prog.Within(site.program) → site.CallsLent(stack, effects, k, lending.counts, needs, top) →
            (words: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) → site.Returns(stack, prog_len(prog),
                stack.EnteredOver(effects, lending, top, k, function, words, result, before, after),
                stack.AnsweredOver(lending, result, after))))
}

theorem closed_within(body: Prog, moves: List<Instruction>, saves: Nat): body.Within(At(function_closed(body, moves, saves), 0, Ret)) {
    let returned = At(body, 0, Block(moves));
    let restored = function_saves(saves).reloads(returned, 8);
    body.within_step(function_closed(body, moves, saves), 0, Ret,
        body.within_step(restored, 0, Block([frame_free()]),
            body.within_trans(returned, restored, body.within_then(0, Block(moves)), Prog::within_reloads(function_saves(saves), returned, 8))))
}

theorem Function::closing_returns<M>(self function: Function, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), k: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), needs: Nat → Nat → Bool, prog: Prog, file: File,
    placement: List<Place>, names: Nat, body: Emitted,
    allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True, asks: function.body.Asks(needs, lending.written),
    emitted: function.body.emit_calls(saves, function_opened(prog, k, function.loads(), saves), file, placement, names, k, lending.counts, function.homes()) = Some(body),
    count: function.lent = lent_count(lending.counts, k),
    grown: At(prog, Succ(k), Block([])).Within(body.prog),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g), few: function.loads() <= 2):
    MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, function.closing(saves, body)) {
    let outs: List<Port> = [Port(id := function.result, width := 64)];
    (match body.file.move_outputs(outs, [Rax]) as λ moved => ((values: Valuation()) → MayKeep<M>(values, body.file, True, moved)) →
        MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, match moved {
            None => None,
            Some(moves) => match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => Some(Emitted(At(function_closed(body.prog, moves.code, saves), 0, Ret), File::empty(), body.placement, body.names)),
            },
        }) {
        None => λ _ => trivial,
        Some(moves) => λ keeps =>
            (match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, body_kept(saves)) as λ c =>
                (c.IsTrue() → moves.file.outputs_check(outs, [Rax]).IsTrue() ∧ leaves_all(moves.code, body_kept(saves)).IsTrue()) →
                MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, match c {
                    False => None,
                    True => Some(Emitted(At(function_closed(body.prog, moves.code, saves), 0, Ret), File::empty(), body.placement, body.names)),
                }) {
                False => λ _ => trivial,
                True => λ parts => {
                    let checked = parts(trivial);
                    ⟨At(prog, Succ(k), Block([])).within_trans(body.prog, At(function_closed(body.prog, moves.code, saves), 0, Ret), grown,
                        closed_within(body.prog, moves.code, saves)),
                     λ within calls words result before after => function_returns<M>(saves, site, laid, stack, top, effects, k, lending, loan,
                        needs, calls, function, prog, file, placement, names, body, allowed, asks, emitted, moves, keeps, checked.left,
                        checked.right, entered, few,
                        count, within, words, result, before, after)⟩
                },
            })(λ ok => Bool::is_true_and(moves.file.outputs_check(outs, [Rax]), leaves_all(moves.code, body_kept(saves)), ok)),
    })(λ values => move_outputs_keeps<M>(values, outs, body.file, [Rax]))
}

theorem Function::emit_body_returns<M>(self function: Function, saves: Nat, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), k: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), needs: Nat → Nat → Bool, prog: Prog, file: File,
    placement: List<Place>, names: Nat, allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True,
    asks: function.body.Asks(needs, lending.written),
    count: function.lent = lent_count(lending.counts, k),
    entered: (values: Valuation()) → (g: Gprs) → PortsAt(values, word_ports(function.parameters), parameter_registers(), g) →
        file.Represents(values, g), few: function.loads() <= 2):
    MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, function.emit_body(saves, prog, k, file, placement, names, lending.counts)) {
    let opened = function_opened(prog, k, function.loads(), saves);
    let label = At(prog, Succ(k), Block([]));
    (match function.body.emit_calls(saves, opened, file, placement, names, k, lending.counts, function.homes()) as λ e =>
        (function.body.emit_calls(saves, opened, file, placement, names, k, lending.counts, function.homes()) = e) → Grows(opened, e) →
        MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, match e { None => None, Some(body) => function.closing(saves, body) }) {
        None => λ _ _ => trivial,
        Some(body) => λ emitted grown => function.closing_returns(saves, site, laid, stack, top, effects, k, lending, loan, needs, prog, file, placement,
            names, body, allowed, asks, emitted, count, label.within_trans(opened, body.prog, label_opened(prog, k, function.loads(), saves), grown), entered,
            few),
    })(refl, function.body.emit_calls_grows(saves, k, lending.counts, function.homes(), opened, file, placement, names))
}

// The theorem for one function, proved once: whatever the placement, code
// `emit_lent` returns meets the function's contract wherever it is
// resident, given its callees meet theirs.
theorem Function::emit_returns<M>(self function: Function, site: Site<M>, laid: site.program.laid_out().IsTrue(),
    stack: Stack<M>(site.fetch, site.data), top: Nat, effects: Effects(), k: Nat, lending: Lending,
    loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), needs: Nat → Nat → Bool, prog: Prog, placement: List<Place>,
    names: Nat, allowed: (b: Nat) → function.body.stores(b).IsTrue() → lending.written(b) = True,
    asks: function.body.Asks(needs, lending.written)):
    MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, function.emit_lent(prog, k, placement, names, lending.counts)) {
    let saves = placement_saves(placement);
    let ins = word_ports(function.parameters);
    match same: function.lent.same(lent_count(lending.counts, k)) {
        False => trivial,
        True => (match input_file(ins, parameter_registers()) as λ entry =>
            ((values: Valuation()) → (g: Gprs) → PortsAt(values, ins, parameter_registers(), g) →
                entry.All(λ (file: File) => file.Represents(values, g))) →
            entry.All(λ (_: File) => ins.len() <= parameter_registers().len()) →
            MayReturnOver<M>(site, stack, top, effects, k, lending, needs, function, prog, match entry {
                None => None,
                Some(file) => function.emit_body(saves, prog, k, file, placement_body(placement), names, lending.counts),
            }) {
            None => λ _ _ => trivial,
            Some(file) => λ entered fits => function.emit_body_returns(saves, site, laid, stack, top, effects, k, lending, loan, needs, prog, file,
                placement_body(placement), names, allowed, asks, function.lent.same_sound(lent_count(lending.counts, k), same), entered,
                function.loads_few(fits)),
        })(λ values g placed => input_file_represents(values, g, ins, parameter_registers(), placed), input_file_fits(ins, parameter_registers())),
    }
}

// ---------------------------------------------------------------------------
// Programs

// The program's functions, first to last, after `start`: each `emit` of
// function `k` calls only the ones before it in the code. `start` is
// `Start` for a program of functions alone, and the code of a program of
// statements that calls them, which keeps its own code first and its entry
// at offset zero (docs/native-one-compiler-design.md §2.2). Function `f` is
// at the label `Succ(f)` either way, so `start` names its own labels past
// the functions'.
fn emit_functions_after_lent(start: Prog, functions: List<Function>, placement: List<Place>, names: Nat, counts: List<Nat>) →
    Option<Emitted> {
    match functions {
        Nil => Some(Emitted(start, File::empty(), placement, names)),
        Cons(last, earlier) => match emit_functions_after_lent(start, earlier, placement, names, counts) {
            None => None,
            Some(before) => last.emit_lent(before.prog, earlier.len(), before.placement, before.names, counts),
        },
    }
}

// The count of buffers each function says it takes, by function: the
// table a program's functions are emitted and called under.
fn program_counts(functions: List<Function>) → List<Nat> {
    match functions { Nil => [], Cons(last, earlier) => program_counts(earlier) ++ [last.lent] }
}

// The functions of a program that lends nothing, after `Start`.
fn emit_functions(functions: List<Function>, placement: List<Place>, names: Nat) → Option<Emitted> {
    emit_functions_after_lent(Start, functions, placement, names, [])
}

// The program's code: function `f` at the label `Succ(f)`, the
// conditionals' labels after every function's. `None` is a refusal, as
// round 2's `lower`.
fn lower_program_lent(functions: List<Function>, placement: List<Place>, counts: List<Nat>) → Option<Prog> {
    match emit_functions_after_lent(Start, functions, placement, functions.len(), counts) {
        None => None,
        Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
    }
}

// The door without buffers: a program lent none.
fn lower_program(functions: List<Function>, placement: List<Place>) → Option<Prog> { lower_program_lent(functions, placement, []) }

// ---------------------------------------------------------------------------
// The placement heuristic over programs (round 4). Untrusted like any
// placement: `lower_program_correct` holds whatever it returns.

// The registers a value may take: not RAX in a body that calls, where each
// call's result lands there.
fn call_pool() → List<Gpr> { [Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11] }

// The values that are a buffer's home somewhere in `region`, entered with
// `homes`: a load or a store reads its home's base, which no node says, so
// the planner keeps the homes of the buffers a region loads from or stores
// into itself. A buffer the region only lends or hands on is read where
// the view or the call names its home, as any operand is, and its home is
// free after the last of them (issues/function-homes-live-to-function-end.md).
fn homes_ids(homes: List<Lent>) → List<Nat> {
    match homes { Nil => [], Cons(home, rest) => Cons(home.base, Cons(home.length, homes_ids(rest))) }
}

fn Node::uses_buffer(self node: Node, b: Nat) → Bool {
    match node {
        BufferLoad(_, buffer, _) => buffer.same(b), BufferStore(_, buffer, _, _) => buffer.same(b),
        WideLoad(_, _, buffer, _) => buffer.same(b), WideStore(_, _, buffer, _, _) => buffer.same(b),
        _ => False,
    }
}

fn nodes_use_buffer(nodes: List<Node>, b: Nat) → Bool {
    match nodes { Nil => False, Cons(node, rest) => node.uses_buffer(b) || nodes_use_buffer(rest, b) }
}

// Whether some leaf of the region loads from buffer `b` or stores into it.
fn StructuredRegion::uses_buffer(self region: StructuredRegion, b: Nat) → Bool {
    match region {
        Dataflow(body) => nodes_use_buffer(body.nodes, b),
        Sequence(prefix, continuation) => nodes_use_buffer(prefix.nodes, b) || continuation.uses_buffer(b),
        Compose(prefix, continuation) => prefix.uses_buffer(b) || continuation.uses_buffer(b),
        Conditional(_, _, _, _, when_true, when_false) => when_true.uses_buffer(b) || when_false.uses_buffer(b),
        Lend(_, _, _, _) => False,
        Call(_, _, _) => False,
        Loop(_, _, _, _, body, _, _, _, _) => body.uses_buffer(b),
    }
}

// The homes of the buffers `region` touches.
fn homes_touched(homes: List<Lent>, region: StructuredRegion) → List<Nat> {
    match homes {
        Nil => [],
        Cons(home, rest) => match region.uses_buffer(home.buffer) {
            False => homes_touched(rest, region),
            True => Cons(home.base, Cons(home.length, homes_touched(rest, region))),
        },
    }
}

fn StructuredRegion::home_reads(self region: StructuredRegion, homes: List<Lent>) → List<Nat> {
    match region {
        Dataflow(_) => [],
        Sequence(_, continuation) => continuation.home_reads(homes),
        Compose(prefix, continuation) => prefix.home_reads(homes) ++
            (homes_touched(prefix.lends(homes), continuation) ++ continuation.home_reads(prefix.lends(homes))),
        Conditional(_, _, _, _, when_true, when_false) => when_true.home_reads(homes) ++ when_false.home_reads(homes),
        Lend(_, _, _, _) => [],
        Call(_, _, _) => [],
        Loop(inputs, _, parameters, _, body, _, next, _, _) =>
            homes_touched(carried_homes(loop_carried(homes, inputs, parameters, next)), body) ++
                body.home_reads(carried_homes(loop_carried(homes, inputs, parameters, next))),
    }
}

// What a function's body is planned to keep to its end: its result, and
// the homes of the buffers it touches.
fn Function::kept(self function: Function) → List<Nat> {
    match function.lent {
        Zero => [function.result],
        Succ(_) => Cons(function.result, homes_touched(function.homes(), function.body) ++ function.body.home_reads(function.homes())),
    }
}

// How many callee-saved registers the places ask a function to save: up to
// the last one a place names.
fn places_saves(places: List<Place>) → Nat {
    match places {
        Nil => 0,
        Cons(place, rest) => match place {
            Into(register) => register.save_rank().max(places_saves(rest)),
            Folded => places_saves(rest),
            Saving(_) => places_saves(rest),
        },
    }
}

// The places with what they ask saved said first, where it is any.
fn places_saving(places: List<Place>) → List<Place> {
    match places_saves(places) { Zero => places, Succ(more) => Cons(Saving(Succ(more)), places) }
}

// A function's placement: its arguments where they arrive, its result
// wanted in RAX when no call follows that could take it, and what its whole
// body lets fold. The callee-saved registers come after the others in the
// pool, so a value goes to one only where every other register holds
// something still read, and the function then saves it
// (issues/function-ir-values-in-kept-registers.md).
fn Function::plan(self function: Function) → List<Place> {
    let folds = function.body.folds([function.result]);
    match input_file(word_ports(function.parameters), parameter_registers()) {
        None => [],
        Some(file) => places_saving(match function.body.calls() {
            False => function.body.plan_from(file, function.kept(), [Port(id := function.result, width := 64)], [Rax],
                scratch_pool() ++ kept_order(), folds, []).placement,
            True => function.body.plan_from(file, function.kept(), [], [], call_pool() ++ kept_order(), folds, []).placement,
        }),
    }
}

// A program's placement, in the order `emit_functions` takes it: the first
// function's first.
fn plan_program(functions: List<Function>) → List<Place> {
    match functions { Nil => [], Cons(last, earlier) => plan_program(earlier) ++ last.plan() }
}

// The program lowered with the heuristic's placement.
fn lower_program_planned(functions: List<Function>) → Option<Prog> { lower_program(functions, plan_program(functions)) }

// The last function answers the calls of it.
theorem program_effects_last(last: Function, earlier: List<Function>, arguments: List<BitVec(64)>, result: BitVec(64),
    before, after: Buffers()):
    program_effects(Cons(last, earlier))(before, earlier.len(), arguments, result, after) →
    last.Runs(program_effects(earlier), arguments, result, before, after) {
    match earlier.len().eq_dec(earlier.len()) {
        Inl(_) => λ held => held,
        Inr(differs) => λ _ => false_elim(differs(refl)),
    }
}

// The earlier ones answer the rest.
theorem program_effects_earlier(last: Function, earlier: List<Function>, f: Nat, differs: f ≠ earlier.len(),
    arguments: List<BitVec(64)>, result: BitVec(64), before, after: Buffers()):
    program_effects(Cons(last, earlier))(before, f, arguments, result, after) → program_effects(earlier)(before, f, arguments, result, after) {
    match f.eq_dec(earlier.len()) {
        Inl(same) => λ _ => false_elim(differs(same)),
        Inr(_) => λ held => held,
    }
}

theorem below_other(f, n: Nat, below: Succ(f) <= Succ(n), differs: f ≠ n): Succ(f) <= n { omega }

theorem nothing_below_zero(f: Nat, below: Succ(f) <= 0): False { omega }

// One more function in the program: function `f` meets its contract at its
// label, the last function by its entry and one below it as it did.
theorem Site::meets_extend<M>(self site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending, last: Function,
    earlier: List<Function>, entry: Nat, label: asm_labels(site.program)(Succ(earlier.len())) = entry, f: Nat,
    below: (f ≠ earlier.len()) → (words: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) →
        site.Returns(stack, asm_labels(site.program)(Succ(f)),
            stack.CalledOver(program_effects(earlier), lending, top, f, words, result, before, after),
            stack.AnsweredOver(lending, result, after)),
    returns: (f = earlier.len()) → (words: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) → site.Returns(stack, entry,
        stack.EnteredOver(program_effects(earlier), lending, top, earlier.len(), last, words, result, before, after),
        stack.AnsweredOver(lending, result, after))):
    (words: List<BitVec(64)>) → (result: BitVec(64)) → (before, after: Buffers()) →
    site.Returns(stack, asm_labels(site.program)(Succ(f)),
        stack.CalledOver(program_effects(Cons(last, earlier)), lending, top, f, words, result, before, after),
        stack.AnsweredOver(lending, result, after)) {
    let effects = program_effects(Cons(last, earlier));
    let below_effects = program_effects(earlier);
    let n = earlier.len();
    λ words result before after => match f.eq_dec(n) {
        Inl(same) => j(sym(same), λ m _ => site.Returns(stack, asm_labels(site.program)(Succ(m)),
                stack.CalledOver(effects, lending, top, m, words, result, before, after), stack.AnsweredOver(lending, result, after)),
            j(sym(label), λ e _ => site.Returns(stack, e, stack.CalledOver(effects, lending, top, n, words, result, before, after),
                    stack.AnsweredOver(lending, result, after)),
                site.returns_weaken(stack, entry,
                    stack.EnteredOver(below_effects, lending, top, n, last, words, result, before, after),
                    stack.CalledOver(effects, lending, top, n, words, result, before, after),
                    stack.AnsweredOver(lending, result, after), returns(same, words, result, before, after),
                    λ i s held => ⟨⟨held.left.left, ⟨program_effects_last(last, earlier, words, result, before, after, held.left.right.left),
                        held.left.right.right⟩⟩, held.right⟩))),
        Inr(differs) => site.returns_weaken(stack, asm_labels(site.program)(Succ(f)),
            stack.CalledOver(below_effects, lending, top, f, words, result, before, after),
            stack.CalledOver(effects, lending, top, f, words, result, before, after),
            stack.AnsweredOver(lending, result, after),
            below(differs, words, result, before, after),
            λ i s held => ⟨⟨held.left.left, ⟨program_effects_earlier(last, earlier, f, differs, words, result, before, after,
                held.left.right.left), held.left.right.right⟩⟩, held.right⟩),
    }
}

// A function's code comes after the code it was emitted after.
theorem Function::closing_grows(self function: Function, saves: Nat, prog: Prog, body: Emitted, grown: prog.Within(body.prog)):
    Grows(prog, function.closing(saves, body)) {
    let outs: List<Port> = [Port(id := function.result, width := 64)];
    match body.file.move_outputs(outs, [Rax]) as λ moved => Grows(prog, match moved {
            None => None,
            Some(moves) => match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, body_kept(saves)) {
                False => None,
                True => Some(Emitted(At(function_closed(body.prog, moves.code, saves), 0, Ret), File::empty(), body.placement, body.names)),
            },
        }) {
        None => trivial,
        Some(moves) => match moves.file.outputs_check(outs, [Rax]) && leaves_all(moves.code, body_kept(saves)) as λ c => Grows(prog, match c {
                False => None,
                True => Some(Emitted(At(function_closed(body.prog, moves.code, saves), 0, Ret), File::empty(), body.placement, body.names)),
            }) {
            False => trivial,
            True => prog.within_trans(body.prog, At(function_closed(body.prog, moves.code, saves), 0, Ret), grown, closed_within(body.prog, moves.code, saves)),
        },
    }
}

// And it holds its label, whatever its contract is stated under.
theorem Function::emit_lent_labels(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat, counts: List<Nat>):
    Grows(At(prog, Succ(k), Block([])), function.emit_lent(prog, k, placement, names, counts)) {
    let saves = placement_saves(placement);
    let opened = function_opened(prog, k, function.loads(), saves);
    let label = At(prog, Succ(k), Block([]));
    match function.lent.same(lent_count(counts, k)) {
        False => trivial,
        True => match input_file(word_ports(function.parameters), parameter_registers()) as λ entry => Grows(label, match entry {
                None => None,
                Some(file) => function.emit_body(saves, prog, k, file, placement_body(placement), names, counts),
            }) {
            None => trivial,
            Some(file) =>
                (match function.body.emit_calls(saves, opened, file, placement_body(placement), names, k, counts, function.homes()) as λ e => Grows(opened, e) →
                    Grows(label, match e { None => None, Some(body) => function.closing(saves, body) }) {
                    None => λ _ => trivial,
                    Some(body) => λ grown => function.closing_grows(saves, label, body,
                        label.within_trans(opened, body.prog, label_opened(prog, k, function.loads(), saves), grown)),
                })(function.body.emit_calls_grows(saves, k, counts, function.homes(), opened, file, placement_body(placement), names)),
        },
    }
}

// What emitting functions proves: resident, they meet their contracts
// over the file.
fn MayCallOver<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, lending: Lending, functions: List<Function>,
    out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => emitted.prog.Within(site.program) →
        site.CallsOver(stack, program_effects(functions), functions.len(), lending, top))
}

// And under every lending, a function at a time.
fn MayCallLent<M>(site: Site<M>, stack: Stack<M>(site.fetch, site.data), top: Nat, counts: List<Nat>, needs: Nat → Nat → Bool,
    functions: List<Function>, out: Option<Emitted>) → Type {
    out.All(λ (emitted: Emitted) => emitted.prog.Within(site.program) →
        site.CallsLent(stack, program_effects(functions), functions.len(), counts, needs, top))
}

// One more function: under each lending that lets it write what it needs
// it meets its contract, the earlier ones meeting theirs under every
// lending.
theorem program_step<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data), top: Nat,
    counts: List<Nat>, needs: Nat → Nat → Bool, last: Function, earlier: List<Function>, before: Emitted,
    earlier_calls: before.prog.Within(site.program) → site.CallsLent(stack, program_effects(earlier), earlier.len(), counts, needs, top)):
    (out: Option<Emitted>) → Grows(At(before.prog, Succ(earlier.len()), Block([])), out) →
    ((lending: Lending) → lending.counts = counts → Loan<M>(site.fetch, site.data, stack, top, lending.spans()) →
        ((b: Nat) → needs(earlier.len(), b).IsTrue() → lending.written(b) = True) →
        MayReturnOver<M>(site, stack, top, program_effects(earlier), earlier.len(), lending, needs, last, before.prog, out)) →
    MayCallLent<M>(site, stack, top, counts, needs, Cons(last, earlier), out) {
    λ out => match out {
        None => λ _ _ => trivial,
        Some(emitted) => λ labelled returns within lending same loan f below covers => {
            let n = earlier.len();
            let label_in = At(before.prog, Succ(n), Block([])).within_trans(emitted.prog, site.program, labelled, within);
            let lent = earlier_calls(before.prog.within_before(Succ(n), Block([]), site.program, label_in));
            site.meets_extend(stack, top, lending, last, earlier, prog_len(before.prog),
                label_target(label_in.witness, site.program, before.prog, n, Block([]),
                    site.program.laid_out_unique(laid), label_in.proof),
                f, λ differs => lent(lending, same, loan, f, below_other(f, n, below, differs), covers),
                λ at_last => {
                    let returned = returns(lending, same, loan,
                        j(at_last, λ m _ => (b: Nat) → needs(m, b).IsTrue() → lending.written(b) = True, covers));
                    let here: site.CallsLent(stack, program_effects(earlier), n, lending.counts, needs, top) =
                        j(sym(same), λ c _ => site.CallsLent(stack, program_effects(earlier), n, c, needs, top), lent);
                    returned.right(within, here)
                })
        },
    }
}

// The program's induction: emitted under `counts`, each function meets its
// contract under every lending of those counts that lets it write what it
// needs.
theorem emit_functions_calls_lent<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, counts: List<Nat>, needs: Nat → Nat → Bool, start: Prog, placement: List<Place>, names: Nat, functions: List<Function>):
    ProgramNeeds(functions, needs) →
    MayCallLent<M>(site, stack, top, counts, needs, functions, emit_functions_after_lent(start, functions, placement, names, counts)) {
    match functions {
        Nil => λ _ _ lending same loan f below covers words result before after => false_elim(nothing_below_zero(f, below)),
        Cons(last, earlier) => λ needed =>
            (match emit_functions_after_lent(start, earlier, placement, names, counts) as λ e =>
                MayCallLent<M>(site, stack, top, counts, needs, earlier, e) →
                MayCallLent<M>(site, stack, top, counts, needs, Cons(last, earlier), match e {
                    None => None,
                    Some(before) => last.emit_lent(before.prog, earlier.len(), before.placement, before.names, counts),
                }) {
                None => λ _ => trivial,
                Some(before) => λ earlier_calls => program_step<M>(site, laid, stack, top, counts, needs, last, earlier, before, earlier_calls,
                    last.emit_lent(before.prog, earlier.len(), before.placement, before.names, counts),
                    last.emit_lent_labels(before.prog, earlier.len(), before.placement, before.names, counts),
                    λ lending same loan covers => j(same, λ c _ => MayReturnOver<M>(site, stack, top, program_effects(earlier), earlier.len(),
                            lending, needs, last, before.prog, last.emit_lent(before.prog, earlier.len(), before.placement, before.names, c)),
                        last.emit_returns(site, laid, stack, top, program_effects(earlier), earlier.len(), lending, loan, needs, before.prog,
                            before.placement, before.names,
                            λ b stores => covers(b, is_true_of_eq(needs(earlier.len(), b), needed.left.left(b, stores))),
                            last.body.asks_within(needs, λ (b: Nat) => needs(earlier.len(), b), lending.written, covers, needed.left.right)))),
            })(emit_functions_calls_lent<M>(site, laid, stack, top, counts, needs, start, placement, names, earlier, needed.right)),
    }
}

// At one lending, of a program with no call over views: every function
// under the lending that lets the program's stores be written, a callee's
// buffers being its caller's. The contract a caller outside the program is
// given.
theorem emit_functions_after_lent_calls<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), start: Prog, placement: List<Place>,
    names: Nat, functions: List<Function>, lendless: program_lendless(functions).IsTrue()):
    ((b: Nat) → program_stores(functions, b).IsTrue() → lending.written(b) = True) →
    MayCallOver<M>(site, stack, top, lending, functions, emit_functions_after_lent(start, functions, placement, names, lending.counts)) {
    λ allowed => (match emit_functions_after_lent(start, functions, placement, names, lending.counts) as λ e =>
            MayCallLent<M>(site, stack, top, lending.counts, λ (_: Nat) (b: Nat) => lending.written(b), functions, e) →
            MayCallOver<M>(site, stack, top, lending, functions, e) {
        None => λ _ => trivial,
        Some(emitted) => λ lent within f below =>
            lent(within)(lending, refl, loan, f, below, λ b need => eq_true_of_is_true(lending.written(b), need)),
    })(emit_functions_calls_lent<M>(site, laid, stack, top, lending.counts, λ (_: Nat) (b: Nat) => lending.written(b), start, placement, names,
        functions, program_needs_all(functions, λ (b: Nat) => lending.written(b), lendless, allowed)))
}

// At one lending, of any program: every function under a lending that
// lets each write what it needs. A program that calls over views is given
// to a caller outside it so, with the rows of marks its functions need
// (`program_marked_needs`).
theorem emit_functions_after_lent_calls_needs<M>(site: Site<M>, laid: site.program.laid_out().IsTrue(), stack: Stack<M>(site.fetch, site.data),
    top: Nat, lending: Lending, loan: Loan<M>(site.fetch, site.data, stack, top, lending.spans()), start: Prog, placement: List<Place>,
    names: Nat, functions: List<Function>, needs: Nat → Nat → Bool, needed: ProgramNeeds(functions, needs)):
    ((f: Nat) → (b: Nat) → needs(f, b).IsTrue() → lending.written(b) = True) →
    MayCallOver<M>(site, stack, top, lending, functions, emit_functions_after_lent(start, functions, placement, names, lending.counts)) {
    λ allowed => (match emit_functions_after_lent(start, functions, placement, names, lending.counts) as λ e =>
            MayCallLent<M>(site, stack, top, lending.counts, needs, functions, e) → MayCallOver<M>(site, stack, top, lending, functions, e) {
        None => λ _ => trivial,
        Some(emitted) => λ lent within f below => lent(within)(lending, refl, loan, f, below, allowed(f)),
    })(emit_functions_calls_lent<M>(site, laid, stack, top, lending.counts, needs, start, placement, names, functions, needed))
}

theorem Function::emit_lent_grows(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat, counts: List<Nat>):
    Grows(prog, function.emit_lent(prog, k, placement, names, counts)) {
    let saves = placement_saves(placement);
    let opened = function_opened(prog, k, function.loads(), saves);
    let before: prog.Within(opened) = prog.within_trans(At(prog, Succ(k), Block([])), opened, prog.within_then(Succ(k), Block([])),
        label_opened(prog, k, function.loads(), saves));
    match function.lent.same(lent_count(counts, k)) {
        False => trivial,
        True => match input_file(word_ports(function.parameters), parameter_registers()) as λ entry => Grows(prog, match entry {
                None => None,
                Some(file) => function.emit_body(saves, prog, k, file, placement_body(placement), names, counts),
            }) {
            None => trivial,
            Some(file) =>
                (match function.body.emit_calls(saves, opened, file, placement_body(placement), names, k, counts, function.homes()) as λ e => Grows(opened, e) →
                    Grows(prog, match e { None => None, Some(body) => function.closing(saves, body) }) {
                    None => λ _ => trivial,
                    Some(body) => λ grown => function.closing_grows(saves, prog, body, prog.within_trans(opened, body.prog, before, grown)),
                })(function.body.emit_calls_grows(saves, k, counts, function.homes(), opened, file, placement_body(placement), names)),
        },
    }
}

theorem Function::emit_grows(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat):
    Grows(prog, function.emit(prog, k, placement, names)) {
    function.emit_lent_grows(prog, k, placement, names, [])
}

// The functions of a program that lends nothing, after code of someone
// else's.
fn emit_functions_after(start: Prog, functions: List<Function>, placement: List<Place>, names: Nat) → Option<Emitted> {
    emit_functions_after_lent(start, functions, placement, names, [])
}

// The code a program put first is still there.
theorem emit_functions_after_lent_grows(start: Prog, placement: List<Place>, names: Nat, counts: List<Nat>, functions: List<Function>):
    Grows(start, emit_functions_after_lent(start, functions, placement, names, counts)) {
    match functions {
        Nil => start.within_self(),
        Cons(last, earlier) =>
            (match emit_functions_after_lent(start, earlier, placement, names, counts) as λ e => Grows(start, e) →
                Grows(start, match e {
                    None => None,
                    Some(before) => last.emit_lent(before.prog, earlier.len(), before.placement, before.names, counts),
                }) {
                None => λ _ => trivial,
                Some(before) => λ grown => grows_trans(start, before, grown,
                    last.emit_lent(before.prog, earlier.len(), before.placement, before.names, counts),
                    last.emit_lent_grows(before.prog, earlier.len(), before.placement, before.names, counts)),
            })(emit_functions_after_lent_grows(start, placement, names, counts, earlier)),
    }
}

theorem emit_functions_after_grows(start: Prog, placement: List<Place>, names: Nat, functions: List<Function>):
    Grows(start, emit_functions_after(start, functions, placement, names)) {
    emit_functions_after_lent_grows(start, placement, names, [], functions)
}

// ---------------------------------------------------------------------------
// What is lowered with no buffers stores nothing

// A store is lowered into a home of its buffer, and a scope entered with no
// home has none: a program that lowers lent nothing stores into nothing,
// what it does to the file is to leave it (`program_effects_quiet`), and the
// contract without buffers follows from the one over the file.
fn Quiets(quiet: Bool, out: Option<Emitted>) → Type { out.All(λ (_: Emitted) => quiet.IsTrue()) }

theorem quiets_of(out: Option<Emitted>, quiet: Bool, holds: quiet.IsTrue()): Quiets(quiet, out) {
    match out { None => trivial, Some(_) => holds }
}

theorem quiets_and(out: Option<Emitted>, a, b: Bool, left: a.IsTrue()): Quiets(b, out) → Quiets(a && b, out) {
    match out { None => λ _ => trivial, Some(_) => λ right => Bool::is_true_and_intro(a, b, left, right) }
}

theorem quiets_and_left(out: Option<Emitted>, a, b: Bool, right: b.IsTrue()): Quiets(a, out) → Quiets(a && b, out) {
    match out { None => λ _ => trivial, Some(_) => λ left => Bool::is_true_and_intro(a, b, left, right) }
}

// A scope entered with no home leaves none: a loop carries only the homes
// it was entered with.
theorem StructuredRegion::lends_none(self region: StructuredRegion): region.lends([]) = [] {
    match region {
        Dataflow(_) => refl,
        Sequence(_, continuation) => continuation.lends_none(),
        Compose(prefix, continuation) =>
            trans(cong_fn(λ (homes: List<Lent>) => continuation.lends(homes), prefix.lends_none()), continuation.lends_none()),
        Conditional(_, _, _, _, _, _) => refl,
        Lend(_, _, _, _) => refl,
        Call(_, _, _) => refl,
        Loop(_, _, _, _, _, _, _, _, _) => refl,
    }
}

theorem emit_leaf_quiet(saves: Nat, prog: Prog, file: File, nodes: List<Node>, placement: List<Place>, names: Nat):
    Quiets(nodes_quiet(nodes), emit_leaf(saves, prog, file, nodes, placement, names, [])) {
    match leaf_store(nodes) as λ s => Quiets(nodes_quiet(nodes), match s {
        None => match nodes_quiet(nodes) { False => None, True => emit_quiet_leaf(saves, prog, file, nodes, placement, names, []) },
        Some(store) => file.emit_store(saves, prog, [], store, placement, names),
    }) {
        None => match nodes_quiet(nodes) as λ q => Quiets(q, match q {
            False => None,
            True => emit_quiet_leaf(saves, prog, file, nodes, placement, names, []),
        }) {
            False => trivial,
            True => quiets_of(emit_quiet_leaf(saves, prog, file, nodes, placement, names, []), True, trivial),
        },
        Some(store) => match placement as λ p => Quiets(nodes_quiet(nodes), file.emit_store(saves, prog, [], store, p, names)) {
            Nil => trivial,
            Cons(place, rest) => match place as λ p => Quiets(nodes_quiet(nodes), file.emit_store(saves, prog, [], store, Cons(p, rest), names)) {
                Folded => trivial,
                Saving(_) => trivial,
                Into(_) => trivial,
            },
        },
    }
}

// A call over views is not lowered where the scope has no home: a view is
// a part of a buffer the scope has a home for.
theorem File::emit_lend_quiet(self file: File, saves: Nat, prog: Prog, views: List<View>, callee: Nat, arguments: List<Nat>, result: Nat,
    placement: List<Place>, names, bound: Nat, counts: List<Nat>):
    Quiets(False, file.emit_lend(saves, prog, views, callee, arguments, result, placement, names, bound, counts, [])) {
    match emit_leaf(saves, prog, file, views_nodes(views), placement, names, []) as λ e => Quiets(False, match e {
        None => None,
        Some(first) => match views_lent(views, first.file, []) {
            False => None,
            True => first.file.emit_call(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound,
                counts, views_lents(views)),
        },
    }) {
        None => trivial,
        Some(first) => j(sym(views_lent_none(views, first.file)), λ b _ => Quiets(False, match b {
            False => None,
            True => first.file.emit_call(first.prog, callee, views_homes(views) ++ arguments, result, first.placement, first.names, bound,
                counts, views_lents(views)),
        }), trivial),
    }
}

theorem StructuredRegion::emit_calls_quiet(self region: StructuredRegion, saves: Nat, bound: Nat, counts: List<Nat>):
    (prog: Prog) → (file: File) → (placement: List<Place>) → (names: Nat) →
    Quiets(region.quiet(), region.emit_calls(saves, prog, file, placement, names, bound, counts, [])) {
    match region {
        Dataflow(body) => λ prog file placement names => emit_leaf_quiet(saves, prog, file, body.nodes, placement, names),
        Sequence(prefix, continuation) => λ prog file placement names =>
            (match emit_leaf(saves, prog, file, prefix.nodes, placement, names, []) as λ e => Quiets(nodes_quiet(prefix.nodes), e) →
                Quiets(nodes_quiet(prefix.nodes) && continuation.quiet(), match e {
                    None => None,
                    Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, []),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_quiet => quiets_and(
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, []),
                    nodes_quiet(prefix.nodes), continuation.quiet(), first_quiet,
                    continuation.emit_calls_quiet(saves, bound, counts, first.prog, first.file, first.placement, first.names)),
            })(emit_leaf_quiet(saves, prog, file, prefix.nodes, placement, names)),
        Compose(prefix, continuation) => λ prog file placement names =>
            (match prefix.emit_calls(saves, prog, file, placement, names, bound, counts, []) as λ e => Quiets(prefix.quiet(), e) →
                Quiets(prefix.quiet() && continuation.quiet(), match e {
                    None => None,
                    Some(first) => continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends([])),
                }) {
                None => λ _ => trivial,
                Some(first) => λ first_quiet => quiets_and(
                    continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends([])),
                    prefix.quiet(), continuation.quiet(), first_quiet,
                    j(sym(prefix.lends_none()), λ lent _ => Quiets(continuation.quiet(),
                        continuation.emit_calls(saves, first.prog, first.file, first.placement, first.names, bound, counts, lent)),
                        continuation.emit_calls_quiet(saves, bound, counts, first.prog, first.file, first.placement, first.names))),
            })(prefix.emit_calls_quiet(saves, bound, counts, prog, file, placement, names)),
        Conditional(_, condition, _, _, when_true, when_false) => λ prog file placement names =>
            match file.branch_test(condition) {
                None => trivial,
                Some(tested) => {
                    let branched = prog.branched(tested.test, Succ(names));
                    (match when_true.emit_calls(saves, branched, file.know(Truth(condition)), placement, Succ(Succ(names)), bound, counts, []) as λ y =>
                        Quiets(when_true.quiet(), y) → Quiets(when_true.quiet() && when_false.quiet(), match y {
                            None => None,
                            Some(yes) => match when_false.emit_calls(saves, yes.prog.else_label(Succ(names), Succ(Succ(names))), file.know(Falsity(condition)), yes.placement, yes.names, bound, counts, []) {
                                None => None,
                                Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                            },
                        }) {
                        None => λ _ => trivial,
                        Some(yes) => λ yes_quiet => {
                            let second = yes.prog.else_label(Succ(names), Succ(Succ(names)));
                            (match when_false.emit_calls(saves, second, file.know(Falsity(condition)), yes.placement, yes.names, bound, counts, []) as λ n =>
                                Quiets(when_false.quiet(), n) → Quiets(when_true.quiet() && when_false.quiet(), match n {
                                    None => None,
                                    Some(no) => Some(Emitted(no.prog.join_label(Succ(Succ(names))), yes.file.meet(no.file, file.known), no.placement, no.names)),
                                }) {
                                None => λ _ => trivial,
                                Some(no) => λ no_quiet => Bool::is_true_and_intro(when_true.quiet(), when_false.quiet(), yes_quiet, no_quiet),
                            })(when_false.emit_calls_quiet(saves, bound, counts, second, file.know(Falsity(condition)), yes.placement, yes.names))
                        },
                    })(when_true.emit_calls_quiet(saves, bound, counts, branched, file.know(Truth(condition)), placement, Succ(Succ(names))))
                },
            },
        Lend(views, callee, arguments, result) => λ prog file placement names =>
            file.emit_lend_quiet(saves, prog, views, callee, arguments, result, placement, names, bound, counts),
        Call(callee, arguments, result) => λ prog file placement names =>
            quiets_of(file.emit_call(prog, callee, arguments, result, placement, names, bound, counts, []), True, trivial),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) => λ prog file placement names =>
            match file.loop_entry(saves, inputs, limit, parameters, count, placement) {
                None => trivial,
                Some(entry) =>
                    (match body.emit_calls(saves, loop_tested(prog, entry, names), entry.head, entry.registers.rest, Succ(Succ(Succ(Succ(names)))),
                        bound, counts, []) as λ b => Quiets(body.quiet(), b) →
                        Quiets(body.quiet(), match b {
                            None => None,
                            Some(pass) => pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                        }) {
                        None => λ _ => trivial,
                        Some(pass) => λ pass_quiet => quiets_of(pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names),
                            body.quiet(), pass_quiet),
                    })(body.emit_calls_quiet(saves, bound, counts, loop_tested(prog, entry, names), entry.head, entry.registers.rest,
                        Succ(Succ(Succ(Succ(names)))))),
            },
    }
}

theorem Function::emit_lent_quiet(self function: Function, prog: Prog, k: Nat, placement: List<Place>, names: Nat):
    Quiets(function.body.quiet(), function.emit_lent(prog, k, placement, names, [])) {
    let saves = placement_saves(placement);
    let opened = function_opened(prog, k, function.loads(), saves);
    match same: function.lent.same(0) {
        False => trivial,
        True => match input_file(word_ports(function.parameters), parameter_registers()) as λ entry => Quiets(function.body.quiet(), match entry {
                None => None,
                Some(file) => function.emit_body(saves, prog, k, file, placement_body(placement), names, []),
            }) {
            None => trivial,
            Some(file) => j(sym(function.lent.same_sound(0, same)), λ count _ => Quiets(function.body.quiet(),
                match function.body.emit_calls(saves, opened, file, placement_body(placement), names, k, [], lent_homes(function.parameters, count, 0)) {
                    None => None,
                    Some(body) => function.closing(saves, body),
                }),
                (match function.body.emit_calls(saves, opened, file, placement_body(placement), names, k, [], []) as λ e =>
                    Quiets(function.body.quiet(), e) →
                    Quiets(function.body.quiet(), match e { None => None, Some(body) => function.closing(saves, body) }) {
                    None => λ _ => trivial,
                    Some(body) => λ quiet => quiets_of(function.closing(saves, body), function.body.quiet(), quiet),
                })(function.body.emit_calls_quiet(saves, k, [], opened, file, placement_body(placement), names))),
        },
    }
}

theorem emit_functions_after_lent_quiet(start: Prog, placement: List<Place>, names: Nat, functions: List<Function>):
    Quiets(program_quiet(functions), emit_functions_after_lent(start, functions, placement, names, [])) {
    match functions {
        Nil => trivial,
        Cons(last, earlier) =>
            (match emit_functions_after_lent(start, earlier, placement, names, []) as λ e => Quiets(program_quiet(earlier), e) →
                Quiets(last.body.quiet() && program_quiet(earlier), match e {
                    None => None,
                    Some(before) => last.emit_lent(before.prog, earlier.len(), before.placement, before.names, []),
                }) {
                None => λ _ => trivial,
                Some(before) => λ earlier_quiet => quiets_and_left(
                    last.emit_lent(before.prog, earlier.len(), before.placement, before.names, []),
                    last.body.quiet(), program_quiet(earlier), earlier_quiet,
                    last.emit_lent_quiet(before.prog, earlier.len(), before.placement, before.names)),
            })(emit_functions_after_lent_quiet(start, placement, names, earlier)),
    }
}

// A program that lowers lent nothing stores into no buffer.
theorem lower_program_quiet(functions: List<Function>, placement: List<Place>, program: Prog,
    lowered: lower_program(functions, placement) = Some(program)): program_quiet(functions).IsTrue() {
    let quiets = (match emit_functions_after_lent(Start, functions, placement, functions.len(), []) as λ e =>
        Quiets(program_quiet(functions), e) →
        (match e as λ _ => Option<Prog> {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        }).All(λ (_: Prog) => program_quiet(functions).IsTrue()) {
        None => λ _ => trivial,
        Some(out) => λ quiet =>
            match out.prog.laid_out() as λ b =>
                (match b as λ _ => Option<Prog> { False => None, True => Some(out.prog) }).All(λ (_: Prog) =>
                    program_quiet(functions).IsTrue()) {
                False => trivial,
                True => quiet,
            },
    })(emit_functions_after_lent_quiet(Start, placement, functions.len(), functions));
    lower_program(functions, placement).all_some(λ (_: Prog) => program_quiet(functions).IsTrue(), program, lowered, quiets)
}

// ---------------------------------------------------------------------------
// The theorems

// What a program does, resident at `origin` with `stack`: every function
// meets its contract at its label, over every file.
fn ProgramCalls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    top: Nat, lending: Lending, functions: List<Function>, program: Prog) → Type {
    Site<M>(fetch, data, program, last, origin).CallsOver(stack, program_effects(functions), functions.len(), lending, top)
}

theorem lower_program_calls<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), top: Nat, lending: Lending, loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    functions: List<Function>, placement: List<Place>, lendless: program_lendless(functions).IsTrue(),
    allowed: (b: Nat) → program_stores(functions, b).IsTrue() → lending.written(b) = True):
    lower_program_lent(functions, placement, lending.counts).All(λ (p: Prog) =>
        ProgramCalls<M>(fetch, data, last, origin, stack, top, lending, functions, p)) {
    (match emit_functions_after_lent(Start, functions, placement, functions.len(), lending.counts) as λ e =>
        ((site: Site<M>) → site.program.laid_out().IsTrue() → (stack: Stack<M>(site.fetch, site.data)) →
            Loan<M>(site.fetch, site.data, stack, top, lending.spans()) → MayCallOver<M>(site, stack, top, lending, functions, e)) →
        (match e as λ _ => Option<Prog> {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        }).All(λ (p: Prog) => ProgramCalls<M>(fetch, data, last, origin, stack, top, lending, functions, p)) {
        None => λ _ => trivial,
        Some(out) => λ calls =>
            (match out.prog.laid_out() as λ b => (b.IsTrue() → out.prog.laid_out().IsTrue()) →
                (match b as λ _ => Option<Prog> { False => None, True => Some(out.prog) }).All(λ (p: Prog) =>
                    ProgramCalls<M>(fetch, data, last, origin, stack, top, lending, functions, p)) {
                False => λ _ => trivial,
                True => λ laid => calls(Site<M>(fetch, data, out.prog, last, origin), laid(trivial), stack, loan, out.prog.within_self()),
            })(λ ok => ok),
    })(λ site laid stack loan => emit_functions_after_lent_calls<M>(site, laid, stack, top, lending, loan, Start, placement,
        functions.len(), functions, lendless, allowed))
}

// And at every lending, a function at a time: what a program that calls
// over views is stated with, and one whose functions need different
// buffers written.
fn ProgramCallsLent<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    top: Nat, counts: List<Nat>, needs: Nat → Nat → Bool, functions: List<Function>, program: Prog) → Type {
    Site<M>(fetch, data, program, last, origin).CallsLent(stack, program_effects(functions), functions.len(), counts, needs, top)
}

theorem lower_program_calls_lent<M>(fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64),
    stack: Stack<M>(fetch, data), top: Nat, counts: List<Nat>, needs: Nat → Nat → Bool, functions: List<Function>, placement: List<Place>,
    needed: ProgramNeeds(functions, needs)):
    lower_program_lent(functions, placement, counts).All(λ (p: Prog) =>
        ProgramCallsLent<M>(fetch, data, last, origin, stack, top, counts, needs, functions, p)) {
    (match emit_functions_after_lent(Start, functions, placement, functions.len(), counts) as λ e =>
        ((site: Site<M>) → site.program.laid_out().IsTrue() → (stack: Stack<M>(site.fetch, site.data)) →
            MayCallLent<M>(site, stack, top, counts, needs, functions, e)) →
        (match e as λ _ => Option<Prog> {
            None => None,
            Some(out) => match out.prog.laid_out() { False => None, True => Some(out.prog) },
        }).All(λ (p: Prog) => ProgramCallsLent<M>(fetch, data, last, origin, stack, top, counts, needs, functions, p)) {
        None => λ _ => trivial,
        Some(out) => λ calls =>
            (match out.prog.laid_out() as λ b => (b.IsTrue() → out.prog.laid_out().IsTrue()) →
                (match b as λ _ => Option<Prog> { False => None, True => Some(out.prog) }).All(λ (p: Prog) =>
                    ProgramCallsLent<M>(fetch, data, last, origin, stack, top, counts, needs, functions, p)) {
                False => λ _ => trivial,
                True => λ laid => calls(Site<M>(fetch, data, out.prog, last, origin), laid(trivial), stack, out.prog.within_self()),
            })(λ ok => ok),
    })(λ site laid stack => emit_functions_calls_lent<M>(site, laid, stack, top, counts, needs, Start, placement, functions.len(), functions,
        needed))
}

// A program `lower_program_lent` returns under `counts`, with `needs`
// right for it (`ProgramNeeds`; as data, `program_marked`): resident at
// any origin, each function meets its contract under every lending of
// those counts that lets it write what it needs.
theorem lower_program_lent_needs<M>(functions: List<Function>, placement: List<Place>, counts: List<Nat>, program: Prog,
    lowered: lower_program_lent(functions, placement, counts) = Some(program), needs: Nat → Nat → Bool,
    needed: ProgramNeeds(functions, needs),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat):
    Site<M>(fetch, data, program, last, origin).CallsLent(stack, program_effects(functions), functions.len(), counts, needs, top) {
    lower_program_lent(functions, placement, counts).all_some(
        λ (p: Prog) => ProgramCallsLent<M>(fetch, data, last, origin, stack, top, counts, needs, functions, p),
        program, lowered, lower_program_calls_lent<M>(fetch, data, last, origin, stack, top, counts, needs, functions, placement, needed))
}

// The theorem, proved once: whatever the placement, a program
// `lower_program_lent` returns, resident at any origin, with any stack
// meeting the stack laws and its buffers lent under the lending laws
// (`Loan`: where each lies, above `top`), has each function meet its
// contract over every file: called on arguments its functions say may
// give `result` and take the file `before` to `after`, with room on the
// stack below `top`, the homes of the buffers it takes its first
// arguments and `before` in memory, it returns `result` in RAX, the
// callee-saved registers kept, memory as it was but for stores of its own
// below where it was entered and of bytes into the buffers the program
// may write, and `after` in memory.
theorem lower_program_lent_correct<M>(functions: List<Function>, placement: List<Place>, lending: Lending, program: Prog,
    lowered: lower_program_lent(functions, placement, lending.counts) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()), lendless: program_lendless(functions).IsTrue(),
    allowed: (b: Nat) → program_stores(functions, b).IsTrue() → lending.written(b) = True):
    Site<M>(fetch, data, program, last, origin).CallsOver(stack, program_effects(functions), functions.len(), lending, top) {
    lower_program_lent(functions, placement, lending.counts).all_some(
        λ (p: Prog) => ProgramCalls<M>(fetch, data, last, origin, stack, top, lending, functions, p),
        program, lowered, lower_program_calls<M>(fetch, data, last, origin, stack, top, lending, loan, functions, placement, lendless, allowed))
}

// With no buffers nothing is lent: the laws hold of no spans under any
// stack, and the empty file is in every memory.
theorem Stack::loan_nothing<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data)):
    Loan<M>(fetch, data, stack, stack.size, Lending::none().spans()) {
    stack.loan_none(stack.size, stack.size.le_refl(), Lending::none().spans(), λ b => refl,
        λ b => j(sym(BitVec::zero_toNat(64)), λ z _ => z <= Nat::pow(2, 47), Nat::leb_sound(0, Nat::pow(2, 47), trivial)), λ b => refl)
}

theorem Stack::in_memory_none<M>({fetch: FetchAccess<M>}, {data: ByteReadAccess<M>}, self stack: Stack<M>(fetch, data), memory: M):
    stack.InMemory(Lending::none(), [], memory) {
    let low: (BitVec::zero(n := 64).toNat() + 0 <= Nat::pow(2, 47)) =
        j(sym(BitVec::zero_toNat(64)), λ z _ => z + 0 <= Nat::pow(2, 47), Nat::leb_sound(0, Nat::pow(2, 47), trivial));
    λ buffer => ⟨refl, ⟨low, λ k no => false_elim(no)⟩⟩
}

// And of a program that lends nothing, the contract without buffers: it
// stores into none, so its functions leave the empty file as they compute,
// and the stores they make are their own.
theorem lower_program_correct<M>(functions: List<Function>, placement: List<Place>, program: Prog,
    lowered: lower_program(functions, placement) = Some(program),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data)):
    Site<M>(fetch, data, program, last, origin).Calls(stack, program_callees(functions), functions.len()) {
    let none = Lending::none();
    let quiet = lower_program_quiet(functions, placement, program, lowered);
    let calls = lower_program_lent_correct<M>(functions, placement, none, program, lowered, fetch, data, last, origin, stack,
        stack.size, stack.loan_nothing(), program_quiet_lendless(functions, quiet),
        λ b stores => false_elim(program_quiet_stores(functions, b, quiet, stores)));
    λ f below arguments result s at resident i rsp room held ret saved => {
        let ran = calls(f, below, arguments, result, [], [], s, at, resident, i, rsp, room,
            ⟨⟨held.left, ⟨program_effects_quiet(functions, quiet, [], f, arguments, result, held.right.left), held.right.right⟩⟩,
             ⟨trivial, ⟨room, stack.in_memory_none(s.memory)⟩⟩⟩, ret, saved);
        let post = ran.proof.right.right.right.right;
        Exists(ran.witness, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨ran.proof.right.right.left, ⟨ran.proof.right.right.right.left,
            ⟨post.left, ⟨post.right.left,
                stack.wrote_in_none(i, none.spans(), λ b => refl, s.memory, ran.witness.memory, post.right.right.left)⟩⟩⟩⟩⟩⟩)
    }
}

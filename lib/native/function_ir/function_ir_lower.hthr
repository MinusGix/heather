// FunctionIR's pure regions lowered to x86 by a Heather function proved
// correct once (issues/function-ir-verified-lowering.md, round 1:
// straight-line dataflow regions).
//
// Register allocation is outside the proof. `Region::lower` takes a placement (a
// destination register per node) from anywhere, and tracks an abstract
// register file, which value each register holds, while it emits. An operand
// is read from a register the file says holds it, so a placement that
// overwrites a value still needed makes a later lookup fail and `lower`
// refuses. The theorem is over every placement: whenever `lower` returns
// code, the code computes the region.

import function_ir;
import x86_64;
import x86_64_block;
import bitvec;
import bitvec_rotate;
import bitvec_bytes;
import bitvec_resize;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Registers and what they hold

// A value a register holds: a 64-bit value as itself, a one-bit value
// zero-extended (as `BitValuePlaced` places it today), a value of another
// width zero-extended (`Narrow`), or one right in its low bits only (`Low`:
// what an ADD of two narrow values leaves until it is settled, "Narrow
// widths" below).
inductive Kind { Word, Bit, Narrow(width: Nat), Low(width: Nat) }

fn Kind::width(self kind: Kind) → Nat {
    match kind { Word => 64, Bit => 1, Narrow(width) => width, Low(width) => width }
}

record Held { id: Nat, kind: Kind }

// Comparisons, as the bit they produce and the flag a CMP of their operands
// sets.
inductive CompareOp { Below, Less, Same }

fn CompareOp::apply(self op: CompareOp, left, right: BitVec(64)) → Bool {
    match op {
        Below => left.unsigned_lt_bit(right),
        Less => left.signed_lt_bit(right),
        Same => left.eq_bit(right),
    }
}

fn CompareOp::Holds(self op: CompareOp, values: Valuation(), output, left, right: Nat) → Type {
    values(1, output) = BitVec::ofBool(op.apply(values(64, left), values(64, right)))
}

// What the file knows of a value no register need hold, from a node the
// placement folded: a constant's value, or a comparison's equation over its
// operands (a branch on it CMPs them and jumps on the flags). It is a fact
// about the valuation, so no register write disturbs it. `Truth` and
// `Falsity` are what a path knows and no node says: the bit a conditional
// tested, in the arm taken where it is set and in the arm taken where it is
// clear (`StructuredRegion::emit_calls`). A load of a lent buffer is
// accepted under the first, of a comparison below; the second, of the same
// comparison, is the other order (`File::at_most`,
// `function_ir_lower_reads`).
inductive Known {
    Constant(id: Nat, value: Nat),
    Compared(id: Nat, op: CompareOp, left: Nat, right: Nat),
    Truth(id: Nat),
    Falsity(id: Nat),
    // The word `id` is the word `base` plus the constant `value`, as a
    // 64-bit sum: what an immediate ADD leaves, so that a test of the sum
    // reads as a test of the base plus a constant (a wide access's last
    // byte, function_ir_lower_reads).
    Offset(id: Nat, base: Nat, value: Nat),
}

fn Known::Holds(self known: Known, values: Valuation()) → Type {
    match known {
        Constant(id, value) => values(64, id) = BitVec::ofNat(value),
        Compared(id, op, left, right) => op.Holds(values, id, left, right),
        Truth(id) => values(1, id).head_bit() = True,
        Falsity(id) => values(1, id).head_bit() = False,
        Offset(id, base, value) => values(64, id) = values(64, base).add(BitVec::ofNat(value)),
    }
}

fn KnownHold(values: Valuation(), known: List<Known>) → Type {
    match known { Nil => True, Cons(here, rest) => here.Holds(values) ∧ KnownHold(values, rest) }
}

// The abstract register file: what each register holds, and what is known.
//
// The slots are data, a register's four index bits deep, and not a function
// of the register: a lookup is four projections however many writes came
// before it, where a function built by `write` asked every earlier write
// whether it was the one, and a file where two arms meet evaluates a slot
// once, where a function of the two arms' files evaluated both at every
// lookup (issues/native-function-emission-one-statement.md). It also makes
// a file a value that can be written down.
record Two<A> { low: A, high: A }

fn Slots() → Type { Two<Two<Two<Two<Option<Held>>>>> }

fn slots_at(slots: Slots(), register: Gpr) → Option<Held> {
    match register {
        Rax => slots.low.low.low.low,
        Rcx => slots.low.low.low.high,
        Rdx => slots.low.low.high.low,
        Rbx => slots.low.low.high.high,
        Rsp => slots.low.high.low.low,
        Rbp => slots.low.high.low.high,
        Rsi => slots.low.high.high.low,
        Rdi => slots.low.high.high.high,
        R8 => slots.high.low.low.low,
        R9 => slots.high.low.low.high,
        R10 => slots.high.low.high.low,
        R11 => slots.high.low.high.high,
        R12 => slots.high.high.low.low,
        R13 => slots.high.high.low.high,
        R14 => slots.high.high.high.low,
        R15 => slots.high.high.high.high,
    }
}

fn slots_set(slots: Slots(), register: Gpr, held: Option<Held>) → Slots() {
    match register {
        Rax => Two(Two(Two(Two(held, slots.low.low.low.high), slots.low.low.high), slots.low.high), slots.high),
        Rcx => Two(Two(Two(Two(slots.low.low.low.low, held), slots.low.low.high), slots.low.high), slots.high),
        Rdx => Two(Two(Two(slots.low.low.low, Two(held, slots.low.low.high.high)), slots.low.high), slots.high),
        Rbx => Two(Two(Two(slots.low.low.low, Two(slots.low.low.high.low, held)), slots.low.high), slots.high),
        Rsp => Two(Two(slots.low.low, Two(Two(held, slots.low.high.low.high), slots.low.high.high)), slots.high),
        Rbp => Two(Two(slots.low.low, Two(Two(slots.low.high.low.low, held), slots.low.high.high)), slots.high),
        Rsi => Two(Two(slots.low.low, Two(slots.low.high.low, Two(held, slots.low.high.high.high))), slots.high),
        Rdi => Two(Two(slots.low.low, Two(slots.low.high.low, Two(slots.low.high.high.low, held))), slots.high),
        R8 => Two(slots.low, Two(Two(Two(held, slots.high.low.low.high), slots.high.low.high), slots.high.high)),
        R9 => Two(slots.low, Two(Two(Two(slots.high.low.low.low, held), slots.high.low.high), slots.high.high)),
        R10 => Two(slots.low, Two(Two(slots.high.low.low, Two(held, slots.high.low.high.high)), slots.high.high)),
        R11 => Two(slots.low, Two(Two(slots.high.low.low, Two(slots.high.low.high.low, held)), slots.high.high)),
        R12 => Two(slots.low, Two(slots.high.low, Two(Two(held, slots.high.high.low.high), slots.high.high.high))),
        R13 => Two(slots.low, Two(slots.high.low, Two(Two(slots.high.high.low.low, held), slots.high.high.high))),
        R14 => Two(slots.low, Two(slots.high.low, Two(slots.high.high.low, Two(held, slots.high.high.high.high)))),
        R15 => Two(slots.low, Two(slots.high.low, Two(slots.high.high.low, Two(slots.high.high.high.low, held)))),
    }
}

// The slots a function of the register describes.
fn slots_of(at: Gpr → Option<Held>) → Slots() {
    Two(Two(Two(Two(at(Rax), at(Rcx)), Two(at(Rdx), at(Rbx))), Two(Two(at(Rsp), at(Rbp)), Two(at(Rsi), at(Rdi)))), Two(Two(Two(at(R8), at(R9)), Two(at(R10), at(R11))), Two(Two(at(R12), at(R13)), Two(at(R14), at(R15)))))
}

theorem slots_at_of(at: Gpr → Option<Held>, register: Gpr): slots_at(slots_of(at), register) = at(register) {
    match register { _ => refl }
}

// A write is read back at its register and leaves every other as it was.
theorem slots_at_set(slots: Slots(), register: Gpr, held: Option<Held>, query: Gpr):
    slots_at(slots_set(slots, register, held), query) = match register.same(query) { False => slots_at(slots, query), True => held } {
    match register { _ => match query { _ => refl } }
}

record File { slots: Slots(), known: List<Known> }

fn File::at(self file: File, register: Gpr) → Option<Held> { slots_at(file.slots, register) }

fn File::empty() → File { File(slots_of(λ (register: Gpr) => None), []) }

fn File::write(self file: File, register: Gpr, held: Option<Held>) → File {
    File(slots_set(file.slots, register, held), file.known)
}

theorem File::empty_at(register: Gpr): File::empty().at(register) = None {
    slots_at_of(λ (register: Gpr) => None, register)
}

theorem File::write_at(self file: File, register: Gpr, held: Option<Held>, query: Gpr):
    file.write(register, held).at(query) = match register.same(query) { False => file.at(query), True => held } {
    slots_at_set(file.slots, register, held, query)
}

fn File::know(self file: File, known: Known) → File { File(file.slots, Cons(known, file.known)) }

fn Held::Rep(self held: Held, values: Valuation(), word: BitVec(64)) → Type {
    match held.kind {
        Word => values(64, held.id) = word,
        Bit => values(1, held.id).zero_extend(63) = word,
        Narrow(width) => values(width, held.id).resize(64) = word,
        Low(width) => word.resize(width) = values(width, held.id),
    }
}

fn SlotRep(values: Valuation(), slot: Option<Held>, word: BitVec(64)) → Type {
    match slot { None => True, Some(held) => held.Rep(values, word) }
}

// Every register the file names holds its value.
fn File::Registers(self file: File, values: Valuation(), gprs: Gprs) → Type {
    (register: Gpr) → SlotRep(values, file.at(register), read_gpr(register, gprs))
}

// The registers hold what the file says, and what it knows holds.
fn File::Represents(self file: File, values: Valuation(), gprs: Gprs) → Type {
    file.Registers(values, gprs) ∧ KnownHold(values, file.known)
}

theorem File::empty_represents(values: Valuation(), gprs: Gprs):
    File::empty().Represents(values, gprs)
{
    ⟨λ register => j(sym(File::empty_at(register)), λ slot _ => SlotRep(values, slot, read_gpr(register, gprs)), trivial), trivial⟩
}

// The one lemma every write goes through: the register written holds what
// the file now says, and every other register is as it was.
theorem File::represents_write(self file: File, values: Valuation(), gprs: Gprs,
    register: Gpr, slot: Option<Held>, word: BitVec(64),
    before: file.Represents(values, gprs),
    written: SlotRep(values, slot, word)):
    file.write(register, slot).Represents(values,
        write_gpr(register, word, gprs))
{
    ⟨λ query => j(sym(file.write_at(register, slot, query)),
        λ now _ => SlotRep(values, now, read_gpr(query, write_gpr(register, word, gprs))),
        j(sym(read_gpr_write(register, query, word, gprs)),
            λ now _ => SlotRep(values, match register.same(query) { False => file.at(query), True => slot }, now),
            match register.same(query) as λ b =>
                SlotRep(values, match b { False => file.at(query), True => slot },
                    match b { False => read_gpr(query, gprs), True => word }) {
                False => before.left(query),
                True => written,
            })), before.right⟩
}

theorem File::represents_know(self file: File, values: Valuation(), gprs: Gprs, known: Known,
    before: file.Represents(values, gprs), holds: known.Holds(values)):
    file.know(known).Represents(values, gprs)
{
    ⟨before.left, ⟨holds, before.right⟩⟩
}

// The register already holds the word the file now says it holds.
theorem File::represents_retag(self file: File, values: Valuation(), gprs: Gprs,
    register: Gpr, slot: Option<Held>,
    before: file.Represents(values, gprs),
    here: SlotRep(values, slot, read_gpr(register, gprs))):
    file.write(register, slot).Represents(values, gprs)
{
    ⟨λ query => j(sym(file.write_at(register, slot, query)),
        λ now _ => SlotRep(values, now, read_gpr(query, gprs)),
        (match register.same(query) as λ b => register.same(query) = b →
            SlotRep(values, match b { False => file.at(query), True => slot }, read_gpr(query, gprs)) {
            False => λ _ => before.left(query),
            True => λ same => j(register.same_sound(query, same),
                λ q _ => SlotRep(values, slot, read_gpr(q, gprs)), here),
        })(refl)), before.right⟩
}

// The file says `register` holds `held`.
record FoundAt(file: File, held: Held, register: Gpr) {
    holds: file.at(register) = Some(held),
}

// Some register the file says holds `held`.
record Found(file: File, held: Held) {
    register: Gpr,
    at: FoundAt(file, held, register),
}

theorem FoundAt::rep({file: File}, {held: Held}, {register: Gpr},
    self found: FoundAt(file, held, register), values: Valuation(), gprs: Gprs,
    represents: file.Represents(values, gprs)):
    held.Rep(values, read_gpr(register, gprs))
{
    j(found.holds, λ slot _ => SlotRep(values, slot, read_gpr(register, gprs)),
        represents.left(register))
}

fn Kind::eq_dec(self left, right: Kind) → left = right ∨ left ≠ right {
    match left {
        Word => match right {
            Word => Inl(refl), Bit => Inr(λ no => absurd(no)),
            Narrow(_) => Inr(λ no => absurd(no)), Low(_) => Inr(λ no => absurd(no)),
        },
        Bit => match right {
            Word => Inr(λ no => absurd(no)), Bit => Inl(refl),
            Narrow(_) => Inr(λ no => absurd(no)), Low(_) => Inr(λ no => absurd(no)),
        },
        Narrow(n) => match right {
            Word => Inr(λ no => absurd(no)), Bit => Inr(λ no => absurd(no)),
            Narrow(m) => match n.eq_dec(m) {
                Inl(same) => Inl(cong_fn(λ (w: Nat) => Narrow(w), same)),
                Inr(differ) => Inr(λ (no: Narrow(n) = Narrow(m)) => differ(cong_fn(λ (k: Kind) => k.width(), no))),
            },
            Low(_) => Inr(λ no => absurd(no)),
        },
        Low(n) => match right {
            Word => Inr(λ no => absurd(no)), Bit => Inr(λ no => absurd(no)),
            Narrow(_) => Inr(λ no => absurd(no)),
            Low(m) => match n.eq_dec(m) {
                Inl(same) => Inl(cong_fn(λ (w: Nat) => Low(w), same)),
                Inr(differ) => Inr(λ (no: Low(n) = Low(m)) => differ(cong_fn(λ (k: Kind) => k.width(), no))),
            },
        },
    }
}

fn Held::eq_dec(self left, right: Held) → left = right ∨ left ≠ right {
    match left.id.eq_dec(right.id) {
        Inr(differ) => Inr(λ (same: left = right) => differ(j(same, λ h _ => left.id = h.id, refl))),
        Inl(ids) => match left.kind.eq_dec(right.kind) {
            Inr(differ) => Inr(λ (same: left = right) => differ(j(same, λ h _ => left.kind = h.kind, refl))),
            Inl(kinds) => Inl(j(ids, λ i _ => Held(left.id, left.kind) = Held(i, right.kind),
                j(kinds, λ k _ => Held(left.id, left.kind) = Held(left.id, k), refl))),
        },
    }
}

fn File::found_at(self file: File, held: Held, register: Gpr) → Option<FoundAt(file, held, register)> {
    (match file.at(register) as λ slot =>
        file.at(register) = slot → Option<FoundAt(file, held, register)> {
        None => λ _ => None,
        Some(here) => λ at => match here.eq_dec(held) {
            Inl(same) => Some(FoundAt(j(same, λ h _ => file.at(register) = Some(h), at))),
            Inr(_) => None,
        },
    })(refl)
}

// The registers `find` searches, in the order it searches them.
fn search_order() → List<Gpr> {
    [Rax, Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11, Rbx, Rbp, R12, R13, R14, R15, Rsp]
}

fn File::find_in(self file: File, held: Held, registers: List<Gpr>) → Option<Found(file, held)> {
    match registers {
        Nil => None,
        Cons(register, rest) => match file.found_at(held, register) {
            None => file.find_in(held, rest),
            Some(at) => Some(Found(register, at)),
        },
    }
}

fn File::find(self file: File, held: Held) → Option<Found(file, held)> {
    file.find_in(held, search_order())
}

// ---------------------------------------------------------------------------
// Code that keeps the file's description

record Lowered { code: List<Instruction>, file: File }

fn Option::All<A>(self o: Option<A>, P: A → Type) → Type {
    match o { None => True, Some(a) => P(a) }
}

fn Option::is_some<A>(self o: Option<A>) → Bool {
    match o { None => False, Some(_) => True }
}

// The value an option known to be `Some` holds.
fn Option::get<A>(self o: Option<A>) → o.is_some().IsTrue() → A {
    match o { None => λ absent => false_elim(absent), Some(v) => λ _ => v }
}

// An option known to be `Some` is `Some` of what it holds: how a value is
// named once and its equation had without evaluating it twice.
theorem Option::some_get<A>(self o: Option<A>): (present: o.is_some().IsTrue()) → o = Some(o.get(present)) {
    match o { None => λ absent => false_elim(absent), Some(v) => λ _ => refl }
}

theorem Option::all_some<A>(self o: Option<A>, P: A → Type, a: A,
    some: o = Some(a), all: o.All(P)): P(a)
{
    j(some, λ x _ => x.All(P), all)
}

// Run from a state `file` describes, where `facts` hold, the code ends in a
// state its own file describes.
fn Keeps<M>(values: Valuation(), file: File, facts: Type, out: Lowered) → Type {
    (s: MachineState<M>) → file.Represents(values, s.gprs) → facts →
        out.file.Represents(values, execute_block_normal(out.code, s).gprs)
}

// What a lowering step proves: if it emitted code, the code keeps the file.
fn MayKeep<M>(values: Valuation(), file: File, facts: Type, out: Option<Lowered>) → Type {
    out.All(λ (lowered: Lowered) => Keeps<M>(values, file, facts, lowered))
}

theorem execute_block_append<M>(first: List<Instruction>):
    (second: List<Instruction>) → (s: MachineState<M>) →
        execute_block_normal(first ++ second, s) =
            execute_block_normal(second, execute_block_normal(first, s))
{
    match first {
        Nil => λ second s => refl,
        Cons(instruction, rest) => λ second s =>
            execute_block_append(rest, second,
                execute_normal(decoded_canonical(instruction), s)),
    }
}

fn Lowered::then(self first, second: Lowered) → Lowered {
    Lowered(first.code ++ second.code, second.file)
}

theorem keeps_seq<M>(values: Valuation(), file: File, first_facts, second_facts: Type,
    first, second: Lowered,
    first_keeps: Keeps<M>(values, file, first_facts, first),
    second_keeps: Keeps<M>(values, first.file, second_facts, second)):
    Keeps<M>(values, file, first_facts ∧ second_facts, first.then(second))
{
    λ s represents facts =>
        j(sym(execute_block_append<M>(first.code, second.code, s)),
            λ state _ => second.file.Represents(values, state.gprs),
            second_keeps(execute_block_normal(first.code, s),
                first_keeps(s, represents, facts.left), facts.right))
}

theorem keeps_then<M>(values: Valuation(), file: File, facts: Type,
    first, second: Lowered,
    first_keeps: Keeps<M>(values, file, True, first),
    second_keeps: Keeps<M>(values, first.file, facts, second)):
    Keeps<M>(values, file, facts, first.then(second))
{
    λ s represents fact =>
        keeps_seq<M>(values, file, True, facts, first, second,
            first_keeps, second_keeps, s, represents, ⟨trivial, fact⟩)
}

// ---------------------------------------------------------------------------
// What the file knows

// The constant the file knows `id` to be.
fn known_value(known: List<Known>, id: Nat) → Option<Nat> {
    match known {
        Nil => None,
        Cons(here, rest) => match here {
            Constant(other, value) => match other.same(id) { False => known_value(rest, id), True => Some(value) },
            Compared(_, _, _, _) => known_value(rest, id),
            Truth(_) => known_value(rest, id),
            Falsity(_) => known_value(rest, id),
            Offset(_, _, _) => known_value(rest, id),
        },
    }
}

theorem known_value_holds(values: Valuation(), id, value: Nat, known: List<Known>):
    known_value(known, id) = Some(value) → KnownHold(values, known) → values(64, id) = BitVec::ofNat(value)
{
    match known {
        Nil => λ absent _ => absurd(absent),
        Cons(here, rest) => match here {
            Constant(other, v) => (match same: other.same(id) {
                False => λ found holds => known_value_holds(values, id, value, rest, found, holds.right),
                True => λ found holds => j(found, λ o _ => o.All(λ (c: Nat) => values(64, id) = BitVec::ofNat(c)),
                    j(other.same_sound(id, same), λ i _ => values(64, i) = BitVec::ofNat(v), holds.left)),
            }),
            Compared(_, _, _, _) => λ found holds => known_value_holds(values, id, value, rest, found, holds.right),
            Truth(_) => λ found holds => known_value_holds(values, id, value, rest, found, holds.right),
            Falsity(_) => λ found holds => known_value_holds(values, id, value, rest, found, holds.right),
            Offset(_, _, _) => λ found holds => known_value_holds(values, id, value, rest, found, holds.right),
        },
    }
}

// The comparison the file knows the bit `id` to be.
record Comparison { op: CompareOp, left: Nat, right: Nat }

fn known_comparison(known: List<Known>, id: Nat) → Option<Comparison> {
    match known {
        Nil => None,
        Cons(here, rest) => match here {
            Constant(_, _) => known_comparison(rest, id),
            Compared(other, op, left, right) => match other.same(id) {
                False => known_comparison(rest, id),
                True => Some(Comparison(op, left, right)),
            },
            Truth(_) => known_comparison(rest, id),
            Falsity(_) => known_comparison(rest, id),
            Offset(_, _, _) => known_comparison(rest, id),
        },
    }
}

theorem known_comparison_holds(values: Valuation(), id: Nat, compared: Comparison, known: List<Known>):
    known_comparison(known, id) = Some(compared) → KnownHold(values, known) →
    compared.op.Holds(values, id, compared.left, compared.right)
{
    match known {
        Nil => λ absent _ => absurd(absent),
        Cons(here, rest) => match here {
            Constant(_, _) => λ found holds => known_comparison_holds(values, id, compared, rest, found, holds.right),
            Compared(other, op, left, right) => (match same: other.same(id) {
                False => λ found holds => known_comparison_holds(values, id, compared, rest, found, holds.right),
                True => λ found holds => j(found, λ o _ => o.All(λ (c: Comparison) => c.op.Holds(values, id, c.left, c.right)),
                    j(other.same_sound(id, same), λ i _ => op.Holds(values, i, left, right), holds.left)),
            }),
            Truth(_) => λ found holds => known_comparison_holds(values, id, compared, rest, found, holds.right),
            Falsity(_) => λ found holds => known_comparison_holds(values, id, compared, rest, found, holds.right),
            Offset(_, _, _) => λ found holds => known_comparison_holds(values, id, compared, rest, found, holds.right),
        },
    }
}

// ---------------------------------------------------------------------------
// Moving a value into a register

fn File::place_found(self file: File, held: Held, destination: Gpr, found: Found(file, held),
    same: Bool) → Lowered
{
    match same {
        True => Lowered([], file),
        False => Lowered([MovRR(destination, found.register)],
            file.write(destination, Some(held))),
    }
}

// A word loaded as an immediate: `MOV r32, imm32` (six bytes; writing the
// low half clears the high one) where its high half is zero, else the
// ten-byte `MOV r64, imm64`.
fn mov_constant(destination: Gpr, word: BitVec(64)) → Instruction {
    match word.resize(32).zero_extend(32).eq_bit(word) {
        True => MovRI32(destination, word.resize(32)),
        False => MovRI(destination, word),
    }
}

theorem mov_constant_gprs<M>(destination: Gpr, word: BitVec(64), s: MachineState<M>):
    execute_block_normal([mov_constant(destination, word)], s).gprs = write_gpr(destination, word, s.gprs)
{
    (match word.resize(32).zero_extend(32).eq_bit(word) as λ b => word.resize(32).zero_extend(32).eq_bit(word) = b →
        execute_block_normal([match b { True => MovRI32(destination, word.resize(32)), False => MovRI(destination, word) }], s).gprs =
            write_gpr(destination, word, s.gprs) {
        True => λ fits => cong_fn(λ (w: BitVec(64)) => write_gpr(destination, w, s.gprs),
            BitVec::eq_of_eq_bit(64, word.resize(32).zero_extend(32), word, fits)),
        False => λ _ => refl,
    })(refl)
}

// What a file says of the registers `mov_constant` leaves, it says of the
// registers with the word written.
theorem File::represents_mov_constant<M>(self file: File, values: Valuation(), s: MachineState<M>, destination: Gpr,
    word: BitVec(64), held: file.Represents(values, write_gpr(destination, word, s.gprs))):
    file.Represents(values, execute_block_normal([mov_constant(destination, word)], s).gprs)
{
    j(sym(mov_constant_gprs<M>(destination, word, s)), λ g _ => file.Represents(values, g), held)
}

// A word no register holds but the file knows, loaded: a folded constant
// that something reads from a register after all.
fn File::load_known(self file: File, id: Nat, destination: Gpr) → Option<Lowered> {
    match known_value(file.known, id) {
        None => None,
        Some(value) => Some(Lowered([mov_constant(destination, BitVec::ofNat(value))],
            file.write(destination, Some(Held(id, Word))))),
    }
}

theorem File::load_known_keeps<M>(self file: File, values: Valuation(), id: Nat, destination: Gpr):
    MayKeep<M>(values, file, True, file.load_known(id, destination))
{
    (match known: known_value(file.known, id) {
        None => trivial,
        Some(value) => λ s represents _ => file.write(destination, Some(Held(id, Word))).represents_mov_constant<M>(values, s,
            destination, BitVec::ofNat(value),
            file.represents_write(values, s.gprs, destination, Some(Held(id, Word)), BitVec::ofNat(value),
                represents, known_value_holds(values, id, value, file.known, known, represents.right))),
    })
}

fn File::place_from(self file: File, held: Held, destination: Gpr,
    found: Option<Found(file, held)>) → Option<Lowered>
{
    match found {
        None => match held.kind {
            Word => file.load_known(held.id, destination),
            Bit => None, Narrow(_) => None, Low(_) => None,
        },
        Some(here) => Some(file.place_found(held, destination, here,
            destination.same(here.register))),
    }
}

// `held` in `destination`, by a MOV unless it is there already (an
// immediate one for a word only the file knows).
fn File::place(self file: File, held: Held, destination: Gpr) → Option<Lowered> {
    file.place_from(held, destination, file.find(held))
}

theorem File::place_found_keeps<M>(self file: File, values: Valuation(), held: Held,
    destination: Gpr, found: Found(file, held), same: Bool):
    Keeps<M>(values, file, True, file.place_found(held, destination, found, same))
{
    match same {
        True => λ s represents _ => represents,
        False => λ s represents _ =>
            file.represents_write(values, s.gprs, destination, Some(held),
                read_gpr(found.register, s.gprs), represents,
                found.at.rep(values, s.gprs, represents)),
    }
}

theorem File::place_from_keeps<M>(self file: File, values: Valuation(), held: Held,
    destination: Gpr, found: Option<Found(file, held)>):
    MayKeep<M>(values, file, True, file.place_from(held, destination, found))
{
    match found {
        None => match held.kind {
            Word => file.load_known_keeps<M>(values, held.id, destination),
            Bit => trivial, Narrow(_) => trivial, Low(_) => trivial,
        },
        Some(here) => file.place_found_keeps<M>(values, held, destination, here,
            destination.same(here.register)),
    }
}

theorem File::place_keeps<M>(self file: File, values: Valuation(), held: Held,
    destination: Gpr):
    MayKeep<M>(values, file, True, file.place(held, destination))
{
    file.place_from_keeps<M>(values, held, destination, file.find(held))
}

fn Lowered::then_option(self first: Lowered, second: Option<Lowered>) → Option<Lowered> {
    match second { None => None, Some(step) => Some(first.then(step)) }
}

theorem then_option_seq<M>(values: Valuation(), file: File, first_facts, second_facts: Type,
    first: Lowered, first_keeps: Keeps<M>(values, file, first_facts, first),
    second: Option<Lowered>):
    MayKeep<M>(values, first.file, second_facts, second) →
    MayKeep<M>(values, file, first_facts ∧ second_facts, first.then_option(second))
{
    match second {
        None => λ _ => trivial,
        Some(step) => λ step_keeps => keeps_seq<M>(values, file, first_facts, second_facts,
            first, step, first_keeps, step_keeps),
    }
}

theorem then_option_keeps<M>(values: Valuation(), file: File, facts: Type,
    first: Lowered, first_keeps: Keeps<M>(values, file, True, first),
    second: Option<Lowered>):
    MayKeep<M>(values, first.file, facts, second) →
    MayKeep<M>(values, file, facts, first.then_option(second))
{
    match second {
        None => λ _ => trivial,
        Some(step) => λ step_keeps => keeps_then<M>(values, file, facts,
            first, step, first_keeps, step_keeps),
    }
}

// ---------------------------------------------------------------------------
// Two-operand arithmetic: the left operand placed in the destination, then
// `OP destination, right`.

inductive BinaryOp { OpAdd, OpSub, OpAnd, OpOr, OpXor }

fn BinaryOp::instruction(self op: BinaryOp, destination, source: Gpr) → Instruction {
    match op {
        OpAdd => AddRR(destination, source),
        OpSub => SubRR(destination, source),
        OpAnd => AndRR(destination, source),
        OpOr => OrRR(destination, source),
        OpXor => XorRR(destination, source),
    }
}

fn BinaryOp::apply(self op: BinaryOp, left, right: BitVec(64)) → BitVec(64) {
    match op {
        OpAdd => left.add(right),
        OpSub => left.sub(right),
        OpAnd => left.band(right),
        OpOr => left.bor(right),
        OpXor => left.bxor(right),
    }
}

theorem BinaryOp::executes<M>(self op: BinaryOp, destination, source: Gpr, s: MachineState<M>):
    execute_block_normal([op.instruction(destination, source)], s).gprs =
        write_gpr(destination, op.apply(read_gpr(destination, s.gprs),
            read_gpr(source, s.gprs)), s.gprs)
{
    match op { OpAdd => refl, OpSub => refl, OpAnd => refl, OpOr => refl, OpXor => refl }
}

fn BinaryOp::Holds(self op: BinaryOp, values: Valuation(), output, left, right: Nat) → Type {
    values(64, output) = op.apply(values(64, left), values(64, right))
}

theorem binary_written(values: Valuation(), op: BinaryOp, output, left, right: Nat,
    a, b: BitVec(64), holds: op.Holds(values, output, left, right),
    left_rep: values(64, left) = a, right_rep: values(64, right) = b):
    values(64, output) = op.apply(a, b)
{
    j(left_rep, λ x _ => values(64, output) = op.apply(x, b),
        j(right_rep, λ y _ => values(64, output) = op.apply(values(64, left), y),
            holds))
}

fn binary_after(op: BinaryOp, moved: Lowered, destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, Word), destination)>,
    other: Option<Found(moved.file, Held(right, Word))>) → Option<Lowered>
{
    match at {
        None => None,
        Some(_) => match other {
            None => None,
            Some(found) => Some(Lowered(
                [op.instruction(destination, found.register)],
                moved.file.write(destination, Some(Held(output, Word))))),
        },
    }
}

theorem binary_after_keeps<M>(values: Valuation(), op: BinaryOp, moved: Lowered,
    destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, Word), destination)>,
    other: Option<Found(moved.file, Held(right, Word))>):
    MayKeep<M>(values, moved.file, op.Holds(values, output, left, right),
        binary_after(op, moved, destination, output, left, right, at, other))
{
    match at {
        None => trivial,
        Some(here) => match other {
            None => trivial,
            Some(found) => λ s represents holds =>
                j(sym(op.executes<M>(destination, found.register, s)),
                    λ gprs _ => moved.file.write(destination, Some(Held(output, Word))).Represents(values, gprs),
                    moved.file.represents_write(values, s.gprs, destination,
                        Some(Held(output, Word)),
                        op.apply(read_gpr(destination, s.gprs),
                            read_gpr(found.register, s.gprs)),
                        represents,
                        binary_written(values, op, output, left, right,
                            read_gpr(destination, s.gprs), read_gpr(found.register, s.gprs),
                            holds,
                            here.rep(values, s.gprs, represents),
                            found.at.rep(values, s.gprs, represents)))),
        },
    }
}

fn binary_placed(op: BinaryOp, destination: Gpr, output, left, right: Nat,
    placed: Option<Lowered>) → Option<Lowered>
{
    match placed {
        None => None,
        Some(moved) => moved.then_option(binary_after(op, moved, destination, output, left, right,
                moved.file.found_at(Held(left, Word), destination),
                moved.file.find(Held(right, Word)))),
    }
}

fn File::binary_left(self file: File, op: BinaryOp, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    binary_placed(op, destination, output, left, right,
        file.place(Held(left, Word), destination))
}

fn BinaryOp::commutes(self op: BinaryOp) → Bool {
    match op { OpAdd => True, OpSub => False, OpAnd => True, OpOr => True, OpXor => True }
}

theorem BinaryOp::swap(self op: BinaryOp, values: Valuation(), output, left, right: Nat):
    op.commutes() = True → op.Holds(values, output, left, right) → op.Holds(values, output, right, left)
{
    match op {
        OpAdd => λ _ holds => trans(holds, BitVec::add_comm(64, values(64, left), values(64, right))),
        OpSub => λ no _ => absurd(no),
        OpAnd => λ _ holds => trans(holds, BitVec::band_comm(64, values(64, left), values(64, right))),
        OpOr => λ _ holds => trans(holds, BitVec::bor_comm(64, values(64, left), values(64, right))),
        OpXor => λ _ holds => trans(holds, BitVec::bxor_comm(64, values(64, left), values(64, right))),
    }
}

// `OP destination, left` where the right operand is already in the
// destination and the operation commutes, else the left operand moved
// there and `OP destination, right`.
fn File::binary(self file: File, op: BinaryOp, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    match op.commutes() {
        False => file.binary_left(op, destination, output, left, right),
        True => match file.found_at(Held(right, Word), destination) {
            None => file.binary_left(op, destination, output, left, right),
            Some(here) => match file.find(Held(left, Word)) {
                None => file.binary_left(op, destination, output, left, right),
                Some(found) => binary_after(op, Lowered([], file), destination, output, right, left, Some(here), Some(found)),
            },
        },
    }
}

// Facts the file's description gives, used.
theorem keeps_given<M>(values: Valuation(), file: File, facts, given: Type, out: Option<Lowered>,
    derive: (gprs: Gprs) → file.Represents(values, gprs) → given → facts, keeps: MayKeep<M>(values, file, facts, out)):
    MayKeep<M>(values, file, given, out)
{
    match out as λ o => MayKeep<M>(values, file, facts, o) → MayKeep<M>(values, file, given, o) {
        None => λ _ => trivial,
        Some(lowered) => λ kept s represents holds => kept(s, represents, derive(s.gprs, represents, holds)),
    }(keeps)
}

theorem keeps_weaken<M>(values: Valuation(), file: File, facts, stronger: Type, out: Option<Lowered>,
    weaker: stronger → facts, keeps: MayKeep<M>(values, file, facts, out)):
    MayKeep<M>(values, file, stronger, out)
{
    match out as λ o => MayKeep<M>(values, file, facts, o) → MayKeep<M>(values, file, stronger, o) {
        None => λ _ => trivial,
        Some(lowered) => λ kept s represents holds => kept(s, represents, weaker(holds)),
    }(keeps)
}

theorem binary_placed_keeps<M>(values: Valuation(), op: BinaryOp, file: File,
    destination: Gpr, output, left, right: Nat, placed: Option<Lowered>):
    MayKeep<M>(values, file, True, placed) →
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        binary_placed(op, destination, output, left, right, placed))
{
    match placed {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps =>
            then_option_keeps<M>(values, file, op.Holds(values, output, left, right),
                moved, moved_keeps,
                binary_after(op, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, Word), destination),
                    moved.file.find(Held(right, Word))),
                binary_after_keeps<M>(values, op, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, Word), destination),
                    moved.file.find(Held(right, Word)))),
    }
}

theorem File::binary_left_keeps<M>(self file: File, values: Valuation(), op: BinaryOp,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.binary_left(op, destination, output, left, right))
{
    binary_placed_keeps<M>(values, op, file, destination, output, left, right,
        file.place(Held(left, Word), destination),
        file.place_keeps<M>(values, Held(left, Word), destination))
}

theorem File::binary_keeps<M>(self file: File, values: Valuation(), op: BinaryOp,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.binary(op, destination, output, left, right))
{
    match commutes: op.commutes() {
        False => file.binary_left_keeps<M>(values, op, destination, output, left, right),
        True => match file.found_at(Held(right, Word), destination) {
            None => file.binary_left_keeps<M>(values, op, destination, output, left, right),
            Some(here) => match file.find(Held(left, Word)) {
                None => file.binary_left_keeps<M>(values, op, destination, output, left, right),
                Some(found) => keeps_weaken<M>(values, file, op.Holds(values, output, right, left),
                    op.Holds(values, output, left, right),
                    binary_after(op, Lowered([], file), destination, output, right, left, Some(here), Some(found)),
                    op.swap(values, output, left, right, commutes),
                    binary_after_keeps<M>(values, op, Lowered([], file), destination, output, right, left,
                        Some(here), Some(found))),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// One-bit AND, OR and XOR: the 64-bit instruction on two zero-extended bits
// leaves their result zero-extended (`BitVec::bor_zero_extend` and its
// siblings), so the operands and the result are held as bits.

fn BinaryOp::BitHolds(self op: BinaryOp, values: Valuation(), output, left, right: Nat) → Type {
    match op {
        OpAdd => False,
        OpSub => False,
        OpAnd => values(1, output) = values(1, left).band(values(1, right)),
        OpOr => values(1, output) = values(1, left).bor(values(1, right)),
        OpXor => values(1, output) = values(1, left).bxor(values(1, right)),
    }
}

theorem rewrite_both(g: BitVec(64) → BitVec(64) → BitVec(64), {x, y, a, b: BitVec(64)}, p: x = a, q: y = b): g(x, y) = g(a, b) {
    j(p, λ u _ => g(x, y) = g(u, b), j(q, λ v _ => g(x, y) = g(x, v), refl))
}

theorem BinaryOp::bit_written(self op: BinaryOp, values: Valuation(), output, left, right: Nat,
    a, b: BitVec(64), holds: op.BitHolds(values, output, left, right),
    left_rep: values(1, left).zero_extend(63) = a, right_rep: values(1, right).zero_extend(63) = b):
    values(1, output).zero_extend(63) = op.apply(a, b)
{
    let x = values(1, left);
    let y = values(1, right);
    let extended = λ (c: BitVec(1)) => c.zero_extend(63);
    match op {
        OpAdd => false_elim(holds),
        OpSub => false_elim(holds),
        OpAnd => trans(cong_fn(extended, holds), trans(sym(BitVec::band_zero_extend(1, 63, x, y)),
            rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.band(q), left_rep, right_rep))),
        OpOr => trans(cong_fn(extended, holds), trans(sym(BitVec::bor_zero_extend(1, 63, x, y)),
            rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.bor(q), left_rep, right_rep))),
        OpXor => trans(cong_fn(extended, holds), trans(sym(BitVec::bxor_zero_extend(1, 63, x, y)),
            rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.bxor(q), left_rep, right_rep))),
    }
}

fn bits_after(op: BinaryOp, moved: Lowered, destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, Bit), destination)>,
    other: Option<Found(moved.file, Held(right, Bit))>) → Option<Lowered>
{
    match at {
        None => None,
        Some(_) => match other {
            None => None,
            Some(found) => Some(Lowered(
                [op.instruction(destination, found.register)],
                moved.file.write(destination, Some(Held(output, Bit))))),
        },
    }
}

theorem bits_after_keeps<M>(values: Valuation(), op: BinaryOp, moved: Lowered,
    destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, Bit), destination)>,
    other: Option<Found(moved.file, Held(right, Bit))>):
    MayKeep<M>(values, moved.file, op.BitHolds(values, output, left, right),
        bits_after(op, moved, destination, output, left, right, at, other))
{
    match at {
        None => trivial,
        Some(here) => match other {
            None => trivial,
            Some(found) => λ s represents holds =>
                j(sym(op.executes<M>(destination, found.register, s)),
                    λ gprs _ => moved.file.write(destination, Some(Held(output, Bit))).Represents(values, gprs),
                    moved.file.represents_write(values, s.gprs, destination,
                        Some(Held(output, Bit)),
                        op.apply(read_gpr(destination, s.gprs),
                            read_gpr(found.register, s.gprs)),
                        represents,
                        op.bit_written(values, output, left, right,
                            read_gpr(destination, s.gprs), read_gpr(found.register, s.gprs),
                            holds,
                            here.rep(values, s.gprs, represents),
                            found.at.rep(values, s.gprs, represents)))),
        },
    }
}

// The left bit moved to the destination, then `OP destination, right`.
fn File::bits(self file: File, op: BinaryOp, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    match file.place(Held(left, Bit), destination) {
        None => None,
        Some(moved) => moved.then_option(bits_after(op, moved, destination, output, left, right,
                moved.file.found_at(Held(left, Bit), destination),
                moved.file.find(Held(right, Bit)))),
    }
}

theorem File::bits_keeps<M>(self file: File, values: Valuation(), op: BinaryOp,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, op.BitHolds(values, output, left, right),
        file.bits(op, destination, output, left, right))
{
    (match file.place(Held(left, Bit), destination) as λ placed =>
        MayKeep<M>(values, file, True, placed) →
        MayKeep<M>(values, file, op.BitHolds(values, output, left, right), match placed {
            None => None,
            Some(moved) => moved.then_option(bits_after(op, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, Bit), destination),
                    moved.file.find(Held(right, Bit)))),
        }) {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps =>
            then_option_keeps<M>(values, file, op.BitHolds(values, output, left, right),
                moved, moved_keeps,
                bits_after(op, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, Bit), destination),
                    moved.file.find(Held(right, Bit))),
                bits_after_keeps<M>(values, op, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, Bit), destination),
                    moved.file.find(Held(right, Bit)))),
    })(file.place_keeps<M>(values, Held(left, Bit), destination))
}

// A one-bit constant, zero-extended.
fn File::bit_constant(self file: File, destination: Gpr, output, value: Nat) → Option<Lowered> {
    Some(Lowered([mov_constant(destination, BitVec::ofNat(value, n := 1).zero_extend(63))],
        file.write(destination, Some(Held(output, Bit)))))
}

theorem File::bit_constant_keeps<M>(self file: File, values: Valuation(), destination: Gpr,
    output, value: Nat):
    MayKeep<M>(values, file, values(1, output) = BitVec::ofNat(value),
        file.bit_constant(destination, output, value))
{
    λ s represents holds => file.write(destination, Some(Held(output, Bit))).represents_mov_constant<M>(values, s, destination,
        BitVec::ofNat(value, n := 1).zero_extend(63),
        file.represents_write(values, s.gprs, destination, Some(Held(output, Bit)),
            BitVec::ofNat(value, n := 1).zero_extend(63), represents,
            cong_fn(λ (c: BitVec(1)) => c.zero_extend(63), holds)))
}

// ---------------------------------------------------------------------------
// Constants and copies

// A constant loaded: the register holds it, and the file knows its value as
// it knows a folded one's (`Node::fold`). So what asks for a constant
// (`known_value`: an ADD's immediate once the register is gone, a view from
// its buffer's start, `File::zero`) reads it wherever the placement put it.
fn File::constant(self file: File, destination: Gpr, output, value: Nat) → Option<Lowered> {
    Some(Lowered([mov_constant(destination, BitVec::ofNat(value))],
        file.write(destination, Some(Held(output, Word))).know(Constant(output, value))))
}

theorem File::constant_keeps<M>(self file: File, values: Valuation(), destination: Gpr,
    output, value: Nat):
    MayKeep<M>(values, file, values(64, output) = BitVec::ofNat(value),
        file.constant(destination, output, value))
{
    λ s represents holds => file.write(destination, Some(Held(output, Word))).know(Constant(output, value))
        .represents_mov_constant<M>(values, s, destination, BitVec::ofNat(value),
        file.write(destination, Some(Held(output, Word))).represents_know(values, write_gpr(destination, BitVec::ofNat(value), s.gprs),
            Constant(output, value),
            file.represents_write(values, s.gprs, destination, Some(Held(output, Word)),
                BitVec::ofNat(value), represents, holds), holds))
}

fn File::copy_found(self file: File, destination: Gpr, output, source: Nat, found: Found(file, Held(source, Word)),
    same: Bool) → Lowered
{
    match same {
        True => Lowered([], file.write(destination, Some(Held(output, Word)))),
        False => Lowered([MovRR(destination, found.register)], file.write(destination, Some(Held(output, Word)))),
    }
}

fn File::copy_from(self file: File, destination: Gpr, output, source: Nat,
    found: Option<Found(file, Held(source, Word))>) → Option<Lowered>
{
    match found {
        None => match known_value(file.known, source) {
            None => None,
            Some(value) => Some(Lowered([mov_constant(destination, BitVec::ofNat(value))],
                file.write(destination, Some(Held(output, Word))))),
        },
        Some(here) => Some(file.copy_found(destination, output, source, here, destination.same(here.register))),
    }
}

// The copy is the destination retagged where the source is there already
// (the placement let it die there), a MOV from its register else, and an
// immediate MOV where only the file knows it.
fn File::copy(self file: File, destination: Gpr, output, source: Nat) → Option<Lowered> {
    file.copy_from(destination, output, source, file.find(Held(source, Word)))
}

theorem File::copy_found_keeps<M>(self file: File, values: Valuation(), destination: Gpr,
    output, source: Nat, found: Found(file, Held(source, Word))):
    Keeps<M>(values, file, values(64, output) = values(64, source),
        file.copy_found(destination, output, source, found, destination.same(found.register)))
{
    (match same: destination.same(found.register) {
        True => λ s represents holds =>
            file.represents_retag(values, s.gprs, destination, Some(Held(output, Word)), represents,
                trans(holds, j(sym(destination.same_sound(found.register, same)),
                    λ r _ => values(64, source) = read_gpr(r, s.gprs), found.at.rep(values, s.gprs, represents)))),
        False => λ s represents holds =>
            file.represents_write(values, s.gprs, destination, Some(Held(output, Word)),
                read_gpr(found.register, s.gprs), represents,
                trans(holds, found.at.rep(values, s.gprs, represents))),
    })
}

theorem File::copy_from_keeps<M>(self file: File, values: Valuation(), destination: Gpr,
    output, source: Nat, found: Option<Found(file, Held(source, Word))>):
    MayKeep<M>(values, file, values(64, output) = values(64, source),
        file.copy_from(destination, output, source, found))
{
    match found {
        None => (match known: known_value(file.known, source) {
            None => trivial,
            Some(value) => λ s represents holds => file.write(destination, Some(Held(output, Word))).represents_mov_constant<M>(values,
                s, destination, BitVec::ofNat(value),
                file.represents_write(values, s.gprs, destination, Some(Held(output, Word)), BitVec::ofNat(value),
                    represents, trans(holds, known_value_holds(values, source, value, file.known, known, represents.right)))),
        }),
        Some(here) => file.copy_found_keeps<M>(values, destination, output, source, here),
    }
}

theorem File::copy_keeps<M>(self file: File, values: Valuation(), destination: Gpr,
    output, source: Nat):
    MayKeep<M>(values, file, values(64, output) = values(64, source),
        file.copy(destination, output, source))
{
    file.copy_from_keeps<M>(values, destination, output, source,
        file.find(Held(source, Word)))
}

// ---------------------------------------------------------------------------
// ADD of a constant the file knows: the processor sign-extends an 8- or
// 32-bit immediate, and the form is taken when the extension gives the
// constant back, which evaluation decides.

fn add_immediate(destination: Gpr, value: Nat) → Option<Instruction> {
    match BitVec::ofNat(value, n := 8).sign_extend(56).eq_bit(BitVec::ofNat(value, n := 64)) {
        True => Some(AddRI8(destination, BitVec::ofNat(value))),
        False => match BitVec::ofNat(value, n := 32).sign_extend(32).eq_bit(BitVec::ofNat(value, n := 64)) {
            True => Some(AddRI32(destination, BitVec::ofNat(value))),
            False => None,
        },
    }
}

fn AddsTo<M>(destination: Gpr, value: Nat, s: MachineState<M>, instruction: Instruction) → Type {
    execute_block_normal([instruction], s).gprs =
        write_gpr(destination, read_gpr(destination, s.gprs).add(BitVec::ofNat(value)), s.gprs)
}

theorem add_immediate_adds<M>(destination: Gpr, value: Nat, s: MachineState<M>, instruction: Instruction):
    add_immediate(destination, value) = Some(instruction) → AddsTo<M>(destination, value, s, instruction)
{
    let word = BitVec::ofNat(value, n := 64);
    let short = BitVec::ofNat(value, n := 8);
    let long = BitVec::ofNat(value, n := 32);
    (match short.sign_extend(56).eq_bit(word) as λ b => short.sign_extend(56).eq_bit(word) = b →
        (match b {
            True => Some(AddRI8(destination, short)),
            False => match long.sign_extend(32).eq_bit(word) { True => Some(AddRI32(destination, long)), False => None },
        }) = Some(instruction) → AddsTo<M>(destination, value, s, instruction) {
        True => λ fits chosen => j(chosen, λ o _ => o.All(λ (i: Instruction) => AddsTo<M>(destination, value, s, i)),
            j(BitVec::eq_of_eq_bit(64, short.sign_extend(56), word, fits),
                λ w _ => execute_block_normal([AddRI8(destination, short)], s).gprs =
                    write_gpr(destination, read_gpr(destination, s.gprs).add(w), s.gprs), refl)),
        False => λ _ => (match fits: long.sign_extend(32).eq_bit(word) {
            True => λ chosen => j(chosen, λ o _ => o.All(λ (i: Instruction) => AddsTo<M>(destination, value, s, i)),
                j(BitVec::eq_of_eq_bit(64, long.sign_extend(32), word, fits),
                    λ w _ => execute_block_normal([AddRI32(destination, long)], s).gprs =
                        write_gpr(destination, read_gpr(destination, s.gprs).add(w), s.gprs), refl)),
            False => λ absent => absurd(absent),
        }),
    })(refl)
}

// CMP of a register with a constant the file knows: the same sign
// extension decides the immediate, and the form is taken where it gives
// the constant back.
fn cmp_immediate(value: Nat) → Option<CmpRight> {
    match BitVec::ofNat(value, n := 8).sign_extend(56).eq_bit(BitVec::ofNat(value, n := 64)) {
        True => Some(RightImm8(BitVec::ofNat(value))),
        False => match BitVec::ofNat(value, n := 32).sign_extend(32).eq_bit(BitVec::ofNat(value, n := 64)) {
            True => Some(RightImm32(BitVec::ofNat(value))),
            False => None,
        },
    }
}

theorem cmp_immediate_reads(value: Nat, right: CmpRight, g: Gprs):
    cmp_immediate(value) = Some(right) → right.read(g) = BitVec::ofNat(value)
{
    let word = BitVec::ofNat(value, n := 64);
    let short = BitVec::ofNat(value, n := 8);
    let long = BitVec::ofNat(value, n := 32);
    (match short.sign_extend(56).eq_bit(word) as λ b => short.sign_extend(56).eq_bit(word) = b →
        (match b {
            True => Some(RightImm8(short)),
            False => match long.sign_extend(32).eq_bit(word) { True => Some(RightImm32(long)), False => None },
        }) = Some(right) → right.read(g) = word {
        True => λ fits chosen => j(chosen, λ o _ => o.All(λ (r: CmpRight) => r.read(g) = word),
            BitVec::eq_of_eq_bit(64, short.sign_extend(56), word, fits)),
        False => λ _ => (match fits: long.sign_extend(32).eq_bit(word) {
            True => λ chosen => j(chosen, λ o _ => o.All(λ (r: CmpRight) => r.read(g) = word),
                BitVec::eq_of_eq_bit(64, long.sign_extend(32), word, fits)),
            False => λ absent => absurd(absent),
        }),
    })(refl)
}

// A comparison's right operand: the register that holds it, else the
// immediate of the constant the file knows it to be.
record RightAt(file: File, id: Nat) {
    right: CmpRight,
    rep: (values: Valuation()) → (g: Gprs) → file.Represents(values, g) → values(64, id) = right.read(g),
}

fn File::cmp_right(self file: File, id: Nat) → Option<RightAt(file, id)> {
    match file.find(Held(id, Word)) {
        Some(b) => Some(RightAt(RightRegister(b.register), λ values g represents => b.at.rep(values, g, represents))),
        None => match known: known_value(file.known, id) {
            None => None,
            Some(value) => match chosen: cmp_immediate(value) {
                None => None,
                Some(right) => Some(RightAt(right, λ values g represents =>
                    trans(known_value_holds(values, id, value, file.known, known, represents.right),
                        sym(cmp_immediate_reads(value, right, g, chosen))))),
            },
        },
    }
}

// `operand` moved to the destination, then the immediate ADD.
fn File::add_known(self file: File, destination: Gpr, output, operand, value: Nat) → Option<Lowered> {
    match file.place(Held(operand, Word), destination) {
        None => None,
        Some(moved) => match moved.file.found_at(Held(operand, Word), destination) {
            None => None,
            Some(_) => match add_immediate(destination, value) {
                None => None,
                Some(instruction) => Some(moved.then(Lowered([instruction],
                    moved.file.write(destination, Some(Held(output, Word))).know(Offset(output, operand, value))))),
            },
        },
    }
}

fn AddsKnown(values: Valuation(), output, operand, value: Nat) → Type {
    values(64, output) = values(64, operand).add(BitVec::ofNat(value))
}

theorem add_known_after<M>(values: Valuation(), moved: Lowered, destination: Gpr, output, operand, value: Nat,
    here: FoundAt(moved.file, Held(operand, Word), destination), instruction: Instruction,
    chosen: add_immediate(destination, value) = Some(instruction)):
    Keeps<M>(values, moved.file, AddsKnown(values, output, operand, value),
        Lowered([instruction], moved.file.write(destination, Some(Held(output, Word))).know(Offset(output, operand, value))))
{
    λ s represents holds =>
        j(sym(add_immediate_adds<M>(destination, value, s, instruction, chosen)),
            λ gprs _ => moved.file.write(destination, Some(Held(output, Word))).know(Offset(output, operand, value)).Represents(values, gprs),
            moved.file.write(destination, Some(Held(output, Word))).represents_know(values,
                write_gpr(destination, read_gpr(destination, s.gprs).add(BitVec::ofNat(value)), s.gprs), Offset(output, operand, value),
                moved.file.represents_write(values, s.gprs, destination, Some(Held(output, Word)),
                    read_gpr(destination, s.gprs).add(BitVec::ofNat(value)), represents,
                    trans(holds, j(here.rep(values, s.gprs, represents),
                        λ x _ => values(64, operand).add(BitVec::ofNat(value)) = x.add(BitVec::ofNat(value)), refl))), holds))
}

theorem File::add_known_keeps<M>(self file: File, values: Valuation(), destination: Gpr, output, operand, value: Nat):
    MayKeep<M>(values, file, AddsKnown(values, output, operand, value), file.add_known(destination, output, operand, value))
{
    let facts = AddsKnown(values, output, operand, value);
    (match file.place(Held(operand, Word), destination) as λ placed => MayKeep<M>(values, file, True, placed) →
        MayKeep<M>(values, file, facts, match placed {
            None => None,
            Some(moved) => match moved.file.found_at(Held(operand, Word), destination) {
                None => None,
                Some(_) => match add_immediate(destination, value) {
                    None => None,
                    Some(instruction) => Some(moved.then(Lowered([instruction],
                        moved.file.write(destination, Some(Held(output, Word))).know(Offset(output, operand, value))))),
                },
            },
        }) {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps => match moved.file.found_at(Held(operand, Word), destination) {
            None => trivial,
            Some(here) => match chosen: add_immediate(destination, value) {
                None => trivial,
                Some(instruction) => keeps_then<M>(values, file, facts, moved,
                    Lowered([instruction], moved.file.write(destination, Some(Held(output, Word))).know(Offset(output, operand, value))), moved_keeps,
                    add_known_after<M>(values, moved, destination, output, operand, value, here, instruction, chosen)),
            },
        },
    })(file.place_keeps<M>(values, Held(operand, Word), destination))
}

// An ADD: a register operand to a known constant takes the immediate form
// (either side, as ADD commutes); otherwise both from registers.
fn File::add(self file: File, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    match file.find(Held(right, Word)) {
        Some(_) => file.binary(OpAdd, destination, output, left, right),
        None => match known_value(file.known, right) {
            Some(value) => file.add_known(destination, output, left, value),
            None => match known_value(file.known, left) {
                Some(value) => file.add_known(destination, output, right, value),
                None => None,
            },
        },
    }
}

theorem File::add_keeps<M>(self file: File, values: Valuation(), destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, OpAdd.Holds(values, output, left, right), file.add(destination, output, left, right))
{
    let holds = OpAdd.Holds(values, output, left, right);
    match file.find(Held(right, Word)) {
        Some(_) => file.binary_keeps<M>(values, OpAdd, destination, output, left, right),
        None => (match known_value(file.known, right) as λ o => known_value(file.known, right) = o →
            MayKeep<M>(values, file, holds, match o {
                Some(value) => file.add_known(destination, output, left, value),
                None => match known_value(file.known, left) {
                    Some(value) => file.add_known(destination, output, right, value),
                    None => None,
                },
            }) {
            Some(value) => λ known => keeps_given<M>(values, file, AddsKnown(values, output, left, value), holds,
                file.add_known(destination, output, left, value),
                λ gprs represents sum => trans(sum, j(known_value_holds(values, right, value, file.known, known, represents.right),
                    λ c _ => values(64, left).add(values(64, right)) = values(64, left).add(c), refl)),
                file.add_known_keeps<M>(values, destination, output, left, value)),
            None => λ _ => match known: known_value(file.known, left) {
                Some(value) => keeps_given<M>(values, file, AddsKnown(values, output, right, value), holds,
                    file.add_known(destination, output, right, value),
                    λ gprs represents sum => trans(sum, trans(BitVec::add_comm(64, values(64, left), values(64, right)),
                        j(known_value_holds(values, left, value, file.known, known, represents.right),
                            λ c _ => values(64, right).add(values(64, left)) = values(64, right).add(c), refl))),
                    file.add_known_keeps<M>(values, destination, output, right, value)),
                None => trivial,
            },
        })(refl),
    }
}

// ---------------------------------------------------------------------------
// Comparisons: `XOR d, d; CMP a, b; SETcc d`, the bit zero-extended in `d`.
// The XOR goes first because it writes the flags the SETcc reads, so `d`
// is neither operand's register there; where it is one, `compare_over`.

fn CompareOp::instruction(self op: CompareOp, low: LowByteGpr) → Instruction {
    match op { Below => SetBelow(low), Less => SetLess(low), Same => SetEqual(low) }
}

fn CompareOp::flag(self op: CompareOp, flags: Flags) → Bool {
    match op { Below => flags.cf, Less => flags.sf.xor(flags.of), Same => flags.zf }
}

theorem CompareOp::flag_sub(self op: CompareOp, left, right: BitVec(64)):
    op.flag(sub_flags(left, right)) = op.apply(left, right)
{
    match op { Below => refl, Less => refl, Same => zero_bits_sub(64, left, right) }
}

theorem CompareOp::executes<M>(self op: CompareOp, low: LowByteGpr, s: MachineState<M>):
    execute_normal(decoded_canonical(op.instruction(low)), s).gprs =
        write_low_byte(low, op.flag(s.flags), s.gprs)
{
    match op { Below => refl, Less => refl, Same => refl }
}

theorem condition_byte_extends(condition: Bool):
    condition_byte(condition).concat(BitVec::zero(n := 64).drop_low(8, 56)) =
        BitVec::ofBool(condition).zero_extend(63)
{
    match condition { False => refl, True => refl }
}

fn Gpr::low_byte(self register: Gpr) → Option<LowByteGpr> {
    match register {
        Rax => Some(Al), Rcx => Some(Cl), Rdx => Some(Dl), Rbx => Some(Bl),
        Rsp => None, Rbp => Some(Bpl), Rsi => Some(Sil), Rdi => Some(Dil),
        R8 => Some(R8b), R9 => Some(R9b), R10 => Some(R10b), R11 => Some(R11b),
        R12 => Some(R12b), R13 => Some(R13b), R14 => Some(R14b), R15 => Some(R15b),
    }
}

fn File::cleared(self file: File, low: LowByteGpr) → File {
    file.write(low_byte_gpr(low), None)
}

fn File::compare_found(self file: File, op: CompareOp, low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file.cleared(low), Held(left, Word))>,
    second: Option<Found(file.cleared(low), Held(right, Word))>) → Option<Lowered>
{
    match first {
        None => None,
        Some(a) => match second {
            None => None,
            Some(b) => Some(Lowered(
                [XorRR(low_byte_gpr(low), low_byte_gpr(low)),
                 CmpRR(a.register, b.register),
                 op.instruction(low)],
                file.cleared(low).write(low_byte_gpr(low), Some(Held(output, Bit))))),
        },
    }
}

// A comparison whose destination holds one of its operands: `CMP a, b;
// MOV d, 0; SETcc d`. A MOV writes no flag, so here the destination is
// cleared after the operands are read, and the bit may take the register
// of an operand that dies at the comparison. The immediate makes it the
// longer code, so `compare_with` takes it only where the XOR form has none.
fn File::compare_over(self file: File, op: CompareOp, low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file, Held(left, Word))>,
    second: Option<Found(file, Held(right, Word))>) → Option<Lowered>
{
    match first {
        None => None,
        Some(a) => match second {
            None => None,
            Some(b) => Some(Lowered(
                [CmpRR(a.register, b.register),
                 MovRI(low_byte_gpr(low), BitVec::zero()),
                 op.instruction(low)],
                file.cleared(low).write(low_byte_gpr(low), Some(Held(output, Bit))))),
        },
    }
}

fn File::compare_with(self file: File, op: CompareOp, output, left, right: Nat,
    low: Option<LowByteGpr>) → Option<Lowered>
{
    match low {
        None => None,
        Some(byte) => match file.compare_found(op, byte, output, left, right,
            file.cleared(byte).find(Held(left, Word)),
            file.cleared(byte).find(Held(right, Word))) {
            Some(lowered) => Some(lowered),
            None => file.compare_over(op, byte, output, left, right,
                file.find(Held(left, Word)), file.find(Held(right, Word))),
        },
    }
}

fn File::compare(self file: File, op: CompareOp, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    file.compare_with(op, output, left, right, destination.low_byte())
}

theorem compare_written(values: Valuation(), op: CompareOp, output, left, right: Nat,
    a, b, zeroed: BitVec(64), holds: op.Holds(values, output, left, right),
    left_rep: values(64, left) = a, right_rep: values(64, right) = b,
    zero: zeroed = BitVec::zero()):
    values(1, output).zero_extend(63) =
        condition_byte(op.flag(sub_flags(a, b))).concat(zeroed.drop_low(8, 56))
{
    let bit: (values(1, output) = BitVec::ofBool(op.flag(sub_flags(a, b)))) =
        trans(j(left_rep, λ x _ => values(1, output) = BitVec::ofBool(op.apply(x, b)),
                j(right_rep, λ y _ => values(1, output) = BitVec::ofBool(op.apply(values(64, left), y)),
                    holds)),
            j(sym(op.flag_sub(a, b)), λ c _ =>
                BitVec::ofBool(op.apply(a, b)) = BitVec::ofBool(c), refl));
    j(sym(zero), λ z _ => values(1, output).zero_extend(63) = condition_byte(op.flag(sub_flags(a, b))).concat(z.drop_low(8, 56)),
        trans(j(bit, λ v _ => values(1, output).zero_extend(63) = v.zero_extend(63), refl),
            sym(condition_byte_extends(op.flag(sub_flags(a, b))))))
}

theorem File::compare_found_keeps<M>(self file: File, values: Valuation(), op: CompareOp,
    low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file.cleared(low), Held(left, Word))>,
    second: Option<Found(file.cleared(low), Held(right, Word))>):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.compare_found(op, low, output, left, right, first, second))
{
    match first {
        None => trivial,
        Some(a) => match second {
            None => trivial,
            Some(b) => λ s represents holds => {
                let register = low_byte_gpr(low);
                let zeroing = execute_normal(decoded_canonical(XorRR(register, register)), s);
                let compared = execute_normal(decoded_canonical(CmpRR(a.register, b.register)), zeroing);
                let zeroed: file.cleared(low).Represents(values, zeroing.gprs) =
                    file.represents_write(values, s.gprs, register, None,
                        read_gpr(register, s.gprs).bxor(read_gpr(register, s.gprs)),
                        represents, trivial);
                j(sym(op.executes<M>(low, compared)),
                    λ gprs _ => file.cleared(low).write(register, Some(Held(output, Bit))).Represents(values, gprs),
                    file.cleared(low).represents_write(values, zeroing.gprs, register,
                        Some(Held(output, Bit)),
                        condition_byte(op.flag(compared.flags)).concat(
                            read_gpr(register, zeroing.gprs).drop_low(8, 56)),
                        zeroed,
                        compare_written(values, op, output, left, right,
                            read_gpr(a.register, zeroing.gprs),
                            read_gpr(b.register, zeroing.gprs),
                            read_gpr(register, zeroing.gprs), holds,
                            a.at.rep(values, zeroing.gprs, zeroed),
                            b.at.rep(values, zeroing.gprs, zeroed),
                            trans(read_gpr_after_write(register,
                                    read_gpr(register, s.gprs).bxor(read_gpr(register, s.gprs)),
                                    s.gprs),
                                BitVec::xor_self(64, read_gpr(register, s.gprs))))))
            },
        },
    }
}

theorem File::compare_over_keeps<M>(self file: File, values: Valuation(), op: CompareOp,
    low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file, Held(left, Word))>,
    second: Option<Found(file, Held(right, Word))>):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.compare_over(op, low, output, left, right, first, second))
{
    match first {
        None => trivial,
        Some(a) => match second {
            None => trivial,
            Some(b) => λ s represents holds => {
                let register = low_byte_gpr(low);
                let compared = execute_normal(decoded_canonical(CmpRR(a.register, b.register)), s);
                let zeroing = execute_normal(decoded_canonical(MovRI(register, BitVec::zero())), compared);
                let zeroed: file.cleared(low).Represents(values, zeroing.gprs) =
                    file.represents_write(values, s.gprs, register, None, BitVec::zero(), represents, trivial);
                j(sym(op.executes<M>(low, zeroing)),
                    λ gprs _ => file.cleared(low).write(register, Some(Held(output, Bit))).Represents(values, gprs),
                    file.cleared(low).represents_write(values, zeroing.gprs, register,
                        Some(Held(output, Bit)),
                        condition_byte(op.flag(zeroing.flags)).concat(
                            read_gpr(register, zeroing.gprs).drop_low(8, 56)),
                        zeroed,
                        compare_written(values, op, output, left, right,
                            read_gpr(a.register, s.gprs),
                            read_gpr(b.register, s.gprs),
                            read_gpr(register, zeroing.gprs), holds,
                            a.at.rep(values, s.gprs, represents),
                            b.at.rep(values, s.gprs, represents),
                            read_gpr_after_write(register, BitVec::zero(), s.gprs))))
            },
        },
    }
}

theorem File::compare_with_keeps<M>(self file: File, values: Valuation(), op: CompareOp,
    output, left, right: Nat, low: Option<LowByteGpr>):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.compare_with(op, output, left, right, low))
{
    let facts = op.Holds(values, output, left, right);
    match low {
        None => trivial,
        Some(byte) => (match file.compare_found(op, byte, output, left, right,
                file.cleared(byte).find(Held(left, Word)),
                file.cleared(byte).find(Held(right, Word))) as λ found => MayKeep<M>(values, file, facts, found) →
            MayKeep<M>(values, file, facts, match found {
                Some(lowered) => Some(lowered),
                None => file.compare_over(op, byte, output, left, right,
                    file.find(Held(left, Word)), file.find(Held(right, Word))),
            }) {
            Some(_) => λ keeps => keeps,
            None => λ _ => file.compare_over_keeps<M>(values, op, byte, output, left, right,
                file.find(Held(left, Word)), file.find(Held(right, Word))),
        })(file.compare_found_keeps<M>(values, op, byte, output, left, right,
            file.cleared(byte).find(Held(left, Word)),
            file.cleared(byte).find(Held(right, Word)))),
    }
}

theorem File::compare_keeps<M>(self file: File, values: Valuation(), op: CompareOp,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, op.Holds(values, output, left, right),
        file.compare(op, destination, output, left, right))
{
    file.compare_with_keeps<M>(values, op, output, left, right, destination.low_byte())
}

// ---------------------------------------------------------------------------
// Shifts by a constant: one SHL, SHR or SAR, by one (D1) or by an imm8
// (C1). The count reaches the instruction already legalized below 64
// (`ShiftOp::legalize`, below), so the hardware's six-bit mask is the
// identity on it (`shift_count_of`); a count of zero is no instruction.
fn ShiftOp::Holds(self op: ShiftOp, values: Valuation(), output, value, count: Nat) → Type {
    values(64, output) = op.by(values(64, value), count)
}

fn shift_code(op: ShiftOp, destination: Gpr, count: Nat) → List<Instruction> {
    match count {
        Zero => [],
        Succ(k) => match k {
            Zero => [ShiftOne(op, destination)],
            Succ(_) => [ShiftImm(op, destination, BitVec::ofNat(count))],
        },
    }
}

// The six-bit mask leaves a count below 64 alone.
theorem shift_count_of(count: Nat, fits: count <= 63): shift_count(BitVec::ofNat(count)) = count {
    let small: (count < Nat::pow(2, 8)) = Nat::le_trans(count, 63, 255, fits, trivial);
    trans(cong_fn(λ (n: Nat) => n.mod(64), BitVec::toNat_ofNat(8, count, small)),
        Nat::mod_of_lt(count, 64, fits))
}

// Two register files that read alike, register by register.
fn GprsAgree(left, right: Gprs) → Type {
    (query: Gpr) → read_gpr(query, left) = read_gpr(query, right)
}

theorem gprs_agree_write_read(register: Gpr, gprs: Gprs):
    GprsAgree(gprs, write_gpr(register, read_gpr(register, gprs), gprs))
{
    λ query => {
        let here: (read_gpr(query, gprs) = match register.same(query) { False => read_gpr(query, gprs), True => read_gpr(register, gprs) }) =
            match same: register.same(query) {
                False => refl,
                True => j(register.same_sound(query, same),
                    λ q _ => read_gpr(q, gprs) = read_gpr(register, gprs), refl),
            };
        trans(here, sym(read_gpr_write(register, query, read_gpr(register, gprs), gprs)))
    }
}

// Writing one register over files that agree once it is written.
theorem gprs_agree_write(register: Gpr, word, written: BitVec(64), left, right: Gprs,
    agree: GprsAgree(left, write_gpr(register, written, right))):
    GprsAgree(write_gpr(register, word, left), write_gpr(register, word, right))
{
    λ query => trans(read_gpr_write(register, query, word, left),
        trans((match register.same(query) as λ b =>
                (read_gpr(query, left) = match b { False => read_gpr(query, right), True => written }) →
                match b { False => read_gpr(query, left), True => word } = match b { False => read_gpr(query, right), True => word } {
            False => λ here => here,
            True => λ _ => refl,
        })(trans(agree(query), read_gpr_write(register, query, written, right))),
            sym(read_gpr_write(register, query, word, right))))
}

theorem File::represents_agree(self file: File, values: Valuation(), left, right: Gprs,
    agree: GprsAgree(left, right), represents: file.Represents(values, right)):
    file.Represents(values, left)
{
    ⟨λ query => j(sym(agree(query)), λ word _ => SlotRep(values, file.at(query), word),
        represents.left(query)), represents.right⟩
}

// The shift writes the destination, shifted, and nothing else.
theorem shift_code_executes<M>(op: ShiftOp, destination: Gpr, count: Nat, fits: count <= 63,
    s: MachineState<M>):
    GprsAgree(execute_block_normal(shift_code(op, destination, count), s).gprs,
        write_gpr(destination, op.by(read_gpr(destination, s.gprs), count), s.gprs))
{
    let x = read_gpr(destination, s.gprs);
    (match count as λ c => c <= 63 →
            GprsAgree(execute_block_normal(shift_code(op, destination, c), s).gprs,
                write_gpr(destination, op.by(x, c), s.gprs)) {
        Zero => λ _ => j(sym(op.by_zero(x)),
            λ y _ => GprsAgree(s.gprs, write_gpr(destination, y, s.gprs)),
            gprs_agree_write_read(destination, s.gprs)),
        Succ(k) => (match k as λ m => m + 1 <= 63 →
                GprsAgree(execute_block_normal(shift_code(op, destination, m + 1), s).gprs,
                    write_gpr(destination, op.by(x, m + 1), s.gprs)) {
            Zero => λ _ => j(op.by_succ(x, 0),
                λ y _ => GprsAgree(write_gpr(destination, op.apply(x), s.gprs),
                    write_gpr(destination, y, s.gprs)),
                j(sym(op.by_zero(x)),
                    λ y _ => GprsAgree(write_gpr(destination, op.apply(x), s.gprs),
                        write_gpr(destination, op.apply(y), s.gprs)),
                    λ _ => refl)),
            Succ(m) => λ fits => j(sym(shift_count_of(m + 2, fits)),
                λ c _ => GprsAgree(write_gpr(destination, op.by(x, c), s.gprs),
                    write_gpr(destination, op.by(x, m + 2), s.gprs)),
                λ _ => refl),
        }),
    })(fits)
}

// The value already in the destination, shifted by a count below 64 (one
// past it is refused, and legalization never asks for one).
fn shift_after(op: ShiftOp, moved: Lowered, destination: Gpr, output, value, count: Nat,
    at: Option<FoundAt(moved.file, Held(value, Word), destination)>) → Option<Lowered>
{
    match at {
        None => None,
        Some(_) => match count.le_dec(63) {
            Inr(_) => None,
            Inl(_) => Some(Lowered(shift_code(op, destination, count),
                moved.file.write(destination, Some(Held(output, Word))))),
        },
    }
}

theorem shift_after_keeps<M>(values: Valuation(), op: ShiftOp, moved: Lowered,
    destination: Gpr, output, value, count: Nat,
    at: Option<FoundAt(moved.file, Held(value, Word), destination)>):
    MayKeep<M>(values, moved.file, op.Holds(values, output, value, count),
        shift_after(op, moved, destination, output, value, count, at))
{
    match at {
        None => trivial,
        Some(here) => match count.le_dec(63) {
            Inr(_) => trivial,
            Inl(fits) => λ s represents holds => {
                let x = read_gpr(destination, s.gprs);
                let rep: (values(64, value) = x) = here.rep(values, s.gprs, represents);
                let written: (values(64, output) = op.by(x, count)) =
                    j(rep, λ y _ => values(64, output) = op.by(y, count), holds);
                moved.file.write(destination, Some(Held(output, Word))).represents_agree(values,
                    execute_block_normal(shift_code(op, destination, count), s).gprs,
                    write_gpr(destination, op.by(x, count), s.gprs),
                    shift_code_executes<M>(op, destination, count, fits, s),
                    moved.file.represents_write(values, s.gprs, destination, Some(Held(output, Word)),
                        op.by(x, count), represents, written))
            },
        },
    }
}

fn shift_placed(op: ShiftOp, destination: Gpr, output, value, count: Nat,
    placed: Option<Lowered>) → Option<Lowered>
{
    match placed {
        None => None,
        Some(moved) => moved.then_option(shift_after(op, moved, destination, output, value, count,
            moved.file.found_at(Held(value, Word), destination))),
    }
}

theorem shift_placed_keeps<M>(values: Valuation(), op: ShiftOp, file: File,
    destination: Gpr, output, value, count: Nat, placed: Option<Lowered>):
    MayKeep<M>(values, file, True, placed) →
    MayKeep<M>(values, file, op.Holds(values, output, value, count),
        shift_placed(op, destination, output, value, count, placed))
{
    match placed {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps =>
            then_option_keeps<M>(values, file, op.Holds(values, output, value, count),
                moved, moved_keeps,
                shift_after(op, moved, destination, output, value, count,
                    moved.file.found_at(Held(value, Word), destination)),
                shift_after_keeps<M>(values, op, moved, destination, output, value, count,
                    moved.file.found_at(Held(value, Word), destination))),
    }
}

fn File::shift_by(self file: File, op: ShiftOp, destination: Gpr, output, value, count: Nat) → Option<Lowered> {
    shift_placed(op, destination, output, value, count, file.place(Held(value, Word), destination))
}

theorem File::shift_by_keeps<M>(self file: File, values: Valuation(), op: ShiftOp,
    destination: Gpr, output, value, count: Nat):
    MayKeep<M>(values, file, op.Holds(values, output, value, count),
        file.shift_by(op, destination, output, value, count))
{
    shift_placed_keeps<M>(values, op, file, destination, output, value, count,
        file.place(Held(value, Word), destination),
        file.place_keeps<M>(values, Held(value, Word), destination))
}

// Legalization, apart from instruction selection: what a shift by `count`
// is in terms another target could select from. By 63 or less it is that
// shift; past the width SHL and SHR are zero and SAR is SAR by 63
// (`ShiftOp::legalize_sound`). x86 masks counts to six bits, so a count of
// 64 or more never reaches an instruction.
inductive ShiftLegal { ShiftsBy(count: Nat), ShiftsToZero }

fn ShiftOp::legalize(self op: ShiftOp, count: Nat) → ShiftLegal {
    match count.le_dec(63) {
        Inl(_) => ShiftsBy(count),
        Inr(_) => match op { OpSar => ShiftsBy(63), _ => ShiftsToZero },
    }
}

fn ShiftLegal::Means(self legal: ShiftLegal, op: ShiftOp, x: BitVec(64), count: Nat) → Type {
    match legal {
        ShiftsBy(by) => op.by(x, count) = op.by(x, by),
        ShiftsToZero => op.by(x, count) = BitVec::zero(),
    }
}

theorem ShiftOp::legalize_sound(self op: ShiftOp, x: BitVec(64), count: Nat):
    op.legalize(count).Means(op, x, count)
{
    match count.le_dec(63) {
        Inl(_) => refl,
        Inr(past) => {
            let above: (63 < count) = Nat::lt_of_not_le(63, count, past);
            let back: ((count - 64) + 64 = count) = Nat::sub_add_cancel(64, count, above);
            let back_sar: ((count - 63) + 63 = count) = Nat::sub_add_cancel(63, count, Nat::le_of_lt(63, count, above));
            match op {
                OpShl => j(back, λ c _ => x.shift_left(c) = BitVec::zero(), BitVec::shift_left_past(x, count - 64)),
                OpShr => j(back, λ c _ => x.shift_right(c) = BitVec::zero(), BitVec::shift_right_past(x, count - 64)),
                OpSar => j(back_sar, λ c _ => x.arithmetic_shift_right(c) = x.arithmetic_shift_right(63),
                    BitVec::arithmetic_shift_right_past(x, count - 63)),
            }
        },
    }
}

// Selection: a legal shift by `k` is one shift instruction (none for zero),
// and zero is an immediate MOV.
fn File::select_shift(self file: File, op: ShiftOp, destination: Gpr, output, value: Nat, legal: ShiftLegal) → Option<Lowered> {
    match legal {
        ShiftsBy(by) => file.shift_by(op, destination, output, value, by),
        ShiftsToZero => Some(Lowered([mov_constant(destination, BitVec::zero())],
            file.write(destination, Some(Held(output, Word))))),
    }
}

theorem File::select_shift_keeps<M>(self file: File, values: Valuation(), op: ShiftOp,
    destination: Gpr, output, value, count: Nat, legal: ShiftLegal,
    means: legal.Means(op, values(64, value), count)):
    MayKeep<M>(values, file, op.Holds(values, output, value, count),
        file.select_shift(op, destination, output, value, legal))
{
    (match legal as λ l => l.Means(op, values(64, value), count) →
            MayKeep<M>(values, file, op.Holds(values, output, value, count),
                file.select_shift(op, destination, output, value, l)) {
        ShiftsBy(by) => λ same => keeps_weaken<M>(values, file, op.Holds(values, output, value, by),
            op.Holds(values, output, value, count),
            file.shift_by(op, destination, output, value, by),
            λ holds => trans(holds, same),
            file.shift_by_keeps<M>(values, op, destination, output, value, by)),
        ShiftsToZero => λ zero s represents holds => file.write(destination, Some(Held(output, Word))).represents_mov_constant<M>(
            values, s, destination, BitVec::zero(), file.represents_write(values, s.gprs, destination,
            Some(Held(output, Word)), BitVec::zero(), represents, trans(holds, zero))),
    })(means)
}

fn File::shift(self file: File, op: ShiftOp, destination: Gpr, output, value, count: Nat) → Option<Lowered> {
    file.select_shift(op, destination, output, value, op.legalize(count))
}

theorem File::shift_keeps<M>(self file: File, values: Valuation(), op: ShiftOp,
    destination: Gpr, output, value, count: Nat):
    MayKeep<M>(values, file, op.Holds(values, output, value, count),
        file.shift(op, destination, output, value, count))
{
    file.select_shift_keeps<M>(values, op, destination, output, value, count, op.legalize(count),
        op.legalize_sound(values(64, value), count))
}

// ---------------------------------------------------------------------------
// Narrow widths (issues/function-ir-narrow-arithmetic.md)
//
// A value of a width between the bit and the word sits in its register
// zero-extended (`Narrow`), which is `Resize`'s own meaning, so widening it
// is a retag. The 64-bit instruction is the narrow operation on two such
// registers wherever the bits above cannot reach down or are zero already:
// AND, OR, XOR, SHR, an unsigned comparison and an equality. ADD, SUB and
// SHL are right in their low bits only (`Low`), and the bits above are
// cleared by SHL and SHR by what is left of the register (`settle_code`,
// `BitVec::shift_pair_resize`): in place, with no second register and no
// mask. A truncation is the same settling of a value that was right in its
// low bits all along.
//
// The steps are stated once over the kinds they read and write
// (`Transfers`, `Reshapes`, `Compares`), and the laws are
// `lib/std/bitvec/bitvec_resize.hthr`'s at any two widths, so nothing here
// names 8, 16 or 32.

// What an instruction on two registers leaves, at the kinds the file holds
// its operands and its result: whatever words stand for the operands, `g`
// of them stands for the result.
fn Transfers(values: Valuation(), from, to: Kind, output, left, right: Nat,
    g: BitVec(64) → BitVec(64) → BitVec(64)) → Type {
    (a, b: BitVec(64)) → Held(left, from).Rep(values, a) → Held(right, from).Rep(values, b) →
        Held(output, to).Rep(values, g(a, b))
}

fn kinded_after(op: BinaryOp, from, to: Kind, moved: Lowered, destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, from), destination)>,
    other: Option<Found(moved.file, Held(right, from))>) → Option<Lowered>
{
    match at {
        None => None,
        Some(_) => match other {
            None => None,
            Some(found) => Some(Lowered(
                [op.instruction(destination, found.register)],
                moved.file.write(destination, Some(Held(output, to))))),
        },
    }
}

theorem kinded_after_keeps<M>(values: Valuation(), op: BinaryOp, from, to: Kind, moved: Lowered,
    destination: Gpr, output, left, right: Nat,
    at: Option<FoundAt(moved.file, Held(left, from), destination)>,
    other: Option<Found(moved.file, Held(right, from))>):
    MayKeep<M>(values, moved.file,
        Transfers(values, from, to, output, left, right, λ a b => op.apply(a, b)),
        kinded_after(op, from, to, moved, destination, output, left, right, at, other))
{
    match at {
        None => trivial,
        Some(here) => match other {
            None => trivial,
            Some(found) => λ s represents transfers =>
                j(sym(op.executes<M>(destination, found.register, s)),
                    λ gprs _ => moved.file.write(destination, Some(Held(output, to))).Represents(values, gprs),
                    moved.file.represents_write(values, s.gprs, destination,
                        Some(Held(output, to)),
                        op.apply(read_gpr(destination, s.gprs),
                            read_gpr(found.register, s.gprs)),
                        represents,
                        transfers(read_gpr(destination, s.gprs), read_gpr(found.register, s.gprs),
                            here.rep(values, s.gprs, represents),
                            found.at.rep(values, s.gprs, represents)))),
        },
    }
}

// The left operand moved to the destination, then `OP destination, right`.
fn File::kinded(self file: File, op: BinaryOp, from, to: Kind, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    match file.place(Held(left, from), destination) {
        None => None,
        Some(moved) => moved.then_option(kinded_after(op, from, to, moved, destination, output, left, right,
                moved.file.found_at(Held(left, from), destination),
                moved.file.find(Held(right, from)))),
    }
}

theorem File::kinded_keeps<M>(self file: File, values: Valuation(), op: BinaryOp, from, to: Kind,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file,
        Transfers(values, from, to, output, left, right, λ a b => op.apply(a, b)),
        file.kinded(op, from, to, destination, output, left, right))
{
    (match file.place(Held(left, from), destination) as λ placed =>
        MayKeep<M>(values, file, True, placed) →
        MayKeep<M>(values, file, Transfers(values, from, to, output, left, right, λ a b => op.apply(a, b)), match placed {
            None => None,
            Some(moved) => moved.then_option(kinded_after(op, from, to, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, from), destination),
                    moved.file.find(Held(right, from)))),
        }) {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps =>
            then_option_keeps<M>(values, file, Transfers(values, from, to, output, left, right, λ a b => op.apply(a, b)),
                moved, moved_keeps,
                kinded_after(op, from, to, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, from), destination),
                    moved.file.find(Held(right, from))),
                kinded_after_keeps<M>(values, op, from, to, moved, destination, output, left, right,
                    moved.file.found_at(Held(left, from), destination),
                    moved.file.find(Held(right, from)))),
    })(file.place_keeps<M>(values, Held(left, from), destination))
}

// Code that rewrites the destination in place, by `g`, and writes no other
// register.
fn InPlace<M>(code: List<Instruction>, destination: Gpr, g: BitVec(64) → BitVec(64)) → Type {
    (s: MachineState<M>) → GprsAgree(execute_block_normal(code, s).gprs,
        write_gpr(destination, g(read_gpr(destination, s.gprs)), s.gprs))
}

theorem in_place_none<M>(destination: Gpr): InPlace<M>([], destination, λ x => x) {
    λ s => gprs_agree_write_read(destination, s.gprs)
}

theorem in_place_shift<M>(op: ShiftOp, destination: Gpr, count: Nat, fits: count <= 63):
    InPlace<M>(shift_code(op, destination, count), destination, λ x => op.by(x, count))
{
    λ s => shift_code_executes<M>(op, destination, count, fits, s)
}

theorem gprs_agree_trans(a, b, c: Gprs, first: GprsAgree(a, b), second: GprsAgree(b, c)): GprsAgree(a, c) {
    λ query => trans(first(query), second(query))
}

theorem in_place_then<M>(first, second: List<Instruction>, destination: Gpr, f, g: BitVec(64) → BitVec(64),
    runs_first: InPlace<M>(first, destination, f), runs_second: InPlace<M>(second, destination, g)):
    InPlace<M>(first ++ second, destination, λ x => g(f(x)))
{
    λ s => {
        let x = read_gpr(destination, s.gprs);
        let middle = execute_block_normal(first, s);
        let there: (read_gpr(destination, middle.gprs) = f(x)) =
            trans(runs_first(s, destination), read_gpr_after_write(destination, f(x), s.gprs));
        let over: GprsAgree(write_gpr(destination, g(read_gpr(destination, middle.gprs)), middle.gprs),
                write_gpr(destination, g(f(x)), s.gprs)) =
            j(sym(there),
                λ y _ => GprsAgree(write_gpr(destination, g(y), middle.gprs), write_gpr(destination, g(f(x)), s.gprs)),
                gprs_agree_write(destination, g(f(x)), f(x), middle.gprs, s.gprs, runs_first(s)));
        j(sym(execute_block_append<M>(first, second, s)),
            λ state _ => GprsAgree(state.gprs, write_gpr(destination, g(f(x)), s.gprs)),
            gprs_agree_trans(execute_block_normal(second, middle).gprs,
                write_gpr(destination, g(read_gpr(destination, middle.gprs)), middle.gprs),
                write_gpr(destination, g(f(x)), s.gprs), runs_second(middle), over))
    }
}

theorem in_place_same<M>(code: List<Instruction>, destination: Gpr, f, g: BitVec(64) → BitVec(64),
    same: (x: BitVec(64)) → f(x) = g(x), runs: InPlace<M>(code, destination, f)):
    InPlace<M>(code, destination, g)
{
    λ s => j(same(read_gpr(destination, s.gprs)),
        λ y _ => GprsAgree(execute_block_normal(code, s).gprs, write_gpr(destination, y, s.gprs)), runs(s))
}

fn settle_shifts(destination: Gpr, width: Nat) → List<Instruction> {
    shift_code(OpShl, destination, 64 - width) ++ shift_code(OpShr, destination, 64 - width)
}

// The destination cleared above its low `width` bits: at 32 a 32-bit move
// of the register onto itself, which clears the upper half as every 32-bit
// destination's is; at another width SHL then SHR by what is left of the
// register.
fn settle_code(destination: Gpr, width: Nat) → List<Instruction> {
    match width.eq_dec(32) {
        Inl(_) => [MovSelf32(destination)],
        Inr(_) => settle_shifts(destination, width),
    }
}

// What the 32-bit move leaves is the low half widened again.
theorem mov_self32_resize(x: BitVec(64)): mov_self32_value(x) = x.resize(32).resize(64) {
    trans(cong_fn(λ (y: BitVec(32)) => y.zero_extend(32), sym(BitVec::ofNat_toNat_truncate(32, 32, x))),
        sym(BitVec::resize_zero_extend(32, 32, x.resize(32))))
}

theorem in_place_mov_self32<M>(destination: Gpr): InPlace<M>([MovSelf32(destination)], destination, mov_self32_value) {
    λ s query => refl
}

theorem in_place_settle_shifts<M>(destination: Gpr, width: Nat, high: width <= 64, fits: 64 - width <= 63):
    InPlace<M>(settle_shifts(destination, width), destination, λ x => x.resize(width).resize(64))
{
    in_place_same<M>(settle_shifts(destination, width), destination,
        λ x => x.shift_left(64 - width).shift_right(64 - width), λ x => x.resize(width).resize(64),
        λ x => BitVec::shift_pair_resize(width, 64, high, x),
        in_place_then<M>(shift_code(OpShl, destination, 64 - width), shift_code(OpShr, destination, 64 - width),
            destination, λ x => x.shift_left(64 - width), λ x => x.shift_right(64 - width),
            in_place_shift<M>(OpShl, destination, 64 - width, fits),
            in_place_shift<M>(OpShr, destination, 64 - width, fits)))
}

theorem in_place_settle<M>(destination: Gpr, width: Nat, high: width <= 64, fits: 64 - width <= 63):
    InPlace<M>(settle_code(destination, width), destination, λ x => x.resize(width).resize(64))
{
    (match width.eq_dec(32) as λ d => InPlace<M>(match d { Inl(_) => [MovSelf32(destination)], Inr(_) => settle_shifts(destination, width) },
            destination, λ x => x.resize(width).resize(64)) {
        Inl(at) => j(sym(at), λ v _ => InPlace<M>([MovSelf32(destination)], destination, λ x => x.resize(v).resize(64)),
            in_place_same<M>([MovSelf32(destination)], destination, mov_self32_value, λ x => x.resize(32).resize(64),
                mov_self32_resize, in_place_mov_self32<M>(destination))),
        Inr(_) => in_place_settle_shifts<M>(destination, width, high, fits),
    })
}

// What in-place code leaves, at the kinds the file holds its operand and
// its result.
fn Reshapes(values: Valuation(), from, to: Kind, output, value: Nat, g: BitVec(64) → BitVec(64)) → Type {
    (a: BitVec(64)) → Held(value, from).Rep(values, a) → Held(output, to).Rep(values, g(a))
}

fn reshaped_after(code: List<Instruction>, from, to: Kind, moved: Lowered, destination: Gpr, output, value: Nat,
    at: Option<FoundAt(moved.file, Held(value, from), destination)>) → Option<Lowered>
{
    match at {
        None => None,
        Some(_) => Some(Lowered(code, moved.file.write(destination, Some(Held(output, to))))),
    }
}

theorem reshaped_after_keeps<M>(values: Valuation(), code: List<Instruction>, g: BitVec(64) → BitVec(64),
    from, to: Kind, moved: Lowered, destination: Gpr, output, value: Nat,
    runs: InPlace<M>(code, destination, g),
    at: Option<FoundAt(moved.file, Held(value, from), destination)>):
    MayKeep<M>(values, moved.file, Reshapes(values, from, to, output, value, g),
        reshaped_after(code, from, to, moved, destination, output, value, at))
{
    match at {
        None => trivial,
        Some(here) => λ s represents reshapes =>
            moved.file.write(destination, Some(Held(output, to))).represents_agree(values,
                execute_block_normal(code, s).gprs,
                write_gpr(destination, g(read_gpr(destination, s.gprs)), s.gprs),
                runs(s),
                moved.file.represents_write(values, s.gprs, destination, Some(Held(output, to)),
                    g(read_gpr(destination, s.gprs)), represents,
                    reshapes(read_gpr(destination, s.gprs), here.rep(values, s.gprs, represents)))),
    }
}

// The operand moved to the destination, then the code. With no code it is
// a copy under another name or another kind.
fn File::reshaped(self file: File, code: List<Instruction>, from, to: Kind, destination: Gpr, output, value: Nat) → Option<Lowered> {
    match file.place(Held(value, from), destination) {
        None => None,
        Some(moved) => moved.then_option(reshaped_after(code, from, to, moved, destination, output, value,
            moved.file.found_at(Held(value, from), destination))),
    }
}

theorem File::reshaped_keeps<M>(self file: File, values: Valuation(), code: List<Instruction>,
    g: BitVec(64) → BitVec(64), from, to: Kind, destination: Gpr, output, value: Nat,
    runs: InPlace<M>(code, destination, g)):
    MayKeep<M>(values, file, Reshapes(values, from, to, output, value, g),
        file.reshaped(code, from, to, destination, output, value))
{
    (match file.place(Held(value, from), destination) as λ placed =>
        MayKeep<M>(values, file, True, placed) →
        MayKeep<M>(values, file, Reshapes(values, from, to, output, value, g), match placed {
            None => None,
            Some(moved) => moved.then_option(reshaped_after(code, from, to, moved, destination, output, value,
                moved.file.found_at(Held(value, from), destination))),
        }) {
        None => λ _ => trivial,
        Some(moved) => λ moved_keeps =>
            then_option_keeps<M>(values, file, Reshapes(values, from, to, output, value, g),
                moved, moved_keeps,
                reshaped_after(code, from, to, moved, destination, output, value,
                    moved.file.found_at(Held(value, from), destination)),
                reshaped_after_keeps<M>(values, code, g, from, to, moved, destination, output, value, runs,
                    moved.file.found_at(Held(value, from), destination))),
    })(file.place_keeps<M>(values, Held(value, from), destination))
}

// One step, then another from the file the first leaves.
fn then_step(first: Option<Lowered>, next: File → Option<Lowered>) → Option<Lowered> {
    match first { None => None, Some(step) => step.then_option(next(step.file)) }
}

theorem then_step_keeps<M>(values: Valuation(), file: File, first_facts, second_facts: Type,
    first: Option<Lowered>, next: File → Option<Lowered>,
    next_keeps: (middle: File) → MayKeep<M>(values, middle, second_facts, next(middle))):
    MayKeep<M>(values, file, first_facts, first) →
    MayKeep<M>(values, file, first_facts ∧ second_facts, then_step(first, next))
{
    match first {
        None => λ _ => trivial,
        Some(step) => λ first_keeps => then_option_seq<M>(values, file, first_facts, second_facts,
            step, first_keeps, next(step.file), next_keeps(step.file)),
    }
}

// A step whose facts follow from a node's.
theorem keeps_from<M>(values: Valuation(), file: File, facts, holds: Type, out: Option<Lowered>,
    derive: holds → facts, keeps: MayKeep<M>(values, file, facts, out)):
    MayKeep<M>(values, file, holds, out)
{
    keeps_weaken<M>(values, file, facts, holds, out, derive, keeps)
}

// `id`, right in its low `width` bits in the destination, cleared above
// them. A width of zero would shift by the whole register, which no
// instruction does, and is refused.
fn File::settle(self file: File, destination: Gpr, width, id: Nat) → Option<Lowered> {
    match (64 - width).le_dec(63) {
        Inr(_) => None,
        Inl(_) => file.reshaped(settle_code(destination, width), Low(width), Narrow(width), destination, id, id),
    }
}

theorem File::settle_keeps<M>(self file: File, values: Valuation(), destination: Gpr, width, id: Nat,
    high: width <= 64):
    MayKeep<M>(values, file, True, file.settle(destination, width, id))
{
    match (64 - width).le_dec(63) {
        Inr(_) => trivial,
        Inl(fits) => keeps_from<M>(values, file,
            Reshapes(values, Low(width), Narrow(width), id, id, λ x => x.resize(width).resize(64)), True,
            file.reshaped(settle_code(destination, width), Low(width), Narrow(width), destination, id, id),
            λ _ => λ a (low: a.resize(width) = values(width, id)) =>
                cong_fn(λ (c: BitVec(width)) => c.resize(64), sym(low)),
            file.reshaped_keeps<M>(values, settle_code(destination, width), λ x => x.resize(width).resize(64),
                Low(width), Narrow(width), destination, id, id,
                in_place_settle<M>(destination, width, high, fits))),
    }
}

// A step that leaves its result right in the low bits, then the settling.
fn File::settled(self file: File, step: Option<Lowered>, destination: Gpr, width, output: Nat) → Option<Lowered> {
    then_step(step, λ (middle: File) => middle.settle(destination, width, output))
}

theorem File::settled_keeps<M>(self file: File, values: Valuation(), facts: Type, step: Option<Lowered>,
    destination: Gpr, width, output: Nat, high: width <= 64,
    keeps: MayKeep<M>(values, file, facts, step)):
    MayKeep<M>(values, file, facts, file.settled(step, destination, width, output))
{
    keeps_from<M>(values, file, facts ∧ True, facts, file.settled(step, destination, width, output),
        λ holds => ⟨holds, trivial⟩,
        then_step_keeps<M>(values, file, facts, True, step,
            λ (middle: File) => middle.settle(destination, width, output),
            λ middle => middle.settle_keeps<M>(values, destination, width, output, high),
            keeps))
}

// Two-operand arithmetic at a narrow width.
fn BinaryOp::at(self op: BinaryOp, width: Nat, left, right: BitVec(width)) → BitVec(width) {
    match op {
        OpAdd => left.add(right),
        OpSub => left.sub(right),
        OpAnd => left.band(right),
        OpOr => left.bor(right),
        OpXor => left.bxor(right),
    }
}

fn BinaryOp::HoldsAt(self op: BinaryOp, values: Valuation(), width, output, left, right: Nat) → Type {
    values(width, output) = op.at(width, values(width, left), values(width, right))
}

// A carry or a borrow runs up into the bits above; a bitwise operation
// leaves the zeros there.
fn BinaryOp::carries(self op: BinaryOp) → Bool {
    match op { OpAdd => True, OpSub => True, OpAnd => False, OpOr => False, OpXor => False }
}

fn BinaryOp::leaves(self op: BinaryOp, width: Nat) → Kind {
    match op.carries() { True => Low(width), False => Narrow(width) }
}

theorem BinaryOp::narrow_transfers(self op: BinaryOp, values: Valuation(), width, output, left, right: Nat,
    high: width <= 64, holds: op.HoldsAt(values, width, output, left, right)):
    Transfers(values, Narrow(width), op.leaves(width), output, left, right, λ a b => op.apply(a, b))
{
    let x = values(width, left);
    let y = values(width, right);
    let widened = λ (c: BitVec(width)) => c.resize(64);
    match op {
        OpAdd => λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
            j(left_rep, λ u _ => u.add(b).resize(width) = values(width, output),
                j(right_rep, λ v _ => x.resize(64).add(v).resize(width) = values(width, output),
                    trans(BitVec::resize_add(width, 64, high, x, y), sym(holds)))),
        OpSub => λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
            j(left_rep, λ u _ => u.sub(b).resize(width) = values(width, output),
                j(right_rep, λ v _ => x.resize(64).sub(v).resize(width) = values(width, output),
                    trans(BitVec::resize_sub(width, 64, high, x, y), sym(holds)))),
        OpAnd => λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
            trans(cong_fn(widened, holds), trans(sym(BitVec::resize_band(width, 64, high, x, y)),
                rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.band(q), left_rep, right_rep))),
        OpOr => λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
            trans(cong_fn(widened, holds), trans(sym(BitVec::resize_bor(width, 64, high, x, y)),
                rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.bor(q), left_rep, right_rep))),
        OpXor => λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
            trans(cong_fn(widened, holds), trans(sym(BitVec::resize_bxor(width, 64, high, x, y)),
                rewrite_both(λ (p: BitVec(64)) (q: BitVec(64)) => p.bxor(q), left_rep, right_rep))),
    }
}

// The instruction, and the settling where a carry may have gone up.
fn File::narrow_binary(self file: File, op: BinaryOp, width: Nat, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    let step = file.kinded(op, Narrow(width), op.leaves(width), destination, output, left, right);
    match op.carries() { True => file.settled(step, destination, width, output), False => step }
}

theorem File::narrow_binary_keeps<M>(self file: File, values: Valuation(), op: BinaryOp, width: Nat,
    destination: Gpr, output, left, right: Nat, high: width <= 64):
    MayKeep<M>(values, file, op.HoldsAt(values, width, output, left, right),
        file.narrow_binary(op, width, destination, output, left, right))
{
    let step = file.kinded(op, Narrow(width), op.leaves(width), destination, output, left, right);
    let kept: MayKeep<M>(values, file, op.HoldsAt(values, width, output, left, right), step) =
        keeps_from<M>(values, file,
            Transfers(values, Narrow(width), op.leaves(width), output, left, right, λ a b => op.apply(a, b)),
            op.HoldsAt(values, width, output, left, right), step,
            λ holds => op.narrow_transfers(values, width, output, left, right, high, holds),
            file.kinded_keeps<M>(values, op, Narrow(width), op.leaves(width), destination, output, left, right));
    match op.carries() {
        True => file.settled_keeps<M>(values, op.HoldsAt(values, width, output, left, right), step,
            destination, width, output, high, kept),
        False => kept,
    }
}

// Shifts by a constant below 64. A left shift moves bits up out of the
// value, so it is settled; a logical right shift brings in the zeros that
// are above it already.
fn File::narrow_shift_left(self file: File, width: Nat, destination: Gpr, output, value, count: Nat) → Option<Lowered> {
    match count.le_dec(63) {
        Inr(_) => None,
        Inl(_) => file.settled(
            file.reshaped(shift_code(OpShl, destination, count), Narrow(width), Low(width), destination, output, value),
            destination, width, output),
    }
}

theorem File::narrow_shift_left_keeps<M>(self file: File, values: Valuation(), width: Nat,
    destination: Gpr, output, value, count: Nat, high: width <= 64):
    MayKeep<M>(values, file, values(width, output) = values(width, value).shift_left(count),
        file.narrow_shift_left(width, destination, output, value, count))
{
    match count.le_dec(63) {
        Inr(_) => trivial,
        Inl(fits) => file.settled_keeps<M>(values, values(width, output) = values(width, value).shift_left(count),
            file.reshaped(shift_code(OpShl, destination, count), Narrow(width), Low(width), destination, output, value),
            destination, width, output, high,
            keeps_from<M>(values, file,
                Reshapes(values, Narrow(width), Low(width), output, value, λ x => x.shift_left(count)),
                values(width, output) = values(width, value).shift_left(count),
                file.reshaped(shift_code(OpShl, destination, count), Narrow(width), Low(width), destination, output, value),
                λ holds => λ a (rep: values(width, value).resize(64) = a) =>
                    j(rep, λ u _ => u.shift_left(count).resize(width) = values(width, output),
                        trans(BitVec::resize_shift_left(width, 64, high, values(width, value), count), sym(holds))),
                file.reshaped_keeps<M>(values, shift_code(OpShl, destination, count), λ x => x.shift_left(count),
                    Narrow(width), Low(width), destination, output, value,
                    in_place_shift<M>(OpShl, destination, count, fits)))),
    }
}

fn File::narrow_shift_right(self file: File, width: Nat, destination: Gpr, output, value, count: Nat) → Option<Lowered> {
    match count.le_dec(63) {
        Inr(_) => None,
        Inl(_) => file.reshaped(shift_code(OpShr, destination, count), Narrow(width), Narrow(width), destination, output, value),
    }
}

theorem File::narrow_shift_right_keeps<M>(self file: File, values: Valuation(), width: Nat,
    destination: Gpr, output, value, count: Nat, high: width <= 64):
    MayKeep<M>(values, file, values(width, output) = values(width, value).shift_right(count),
        file.narrow_shift_right(width, destination, output, value, count))
{
    match count.le_dec(63) {
        Inr(_) => trivial,
        Inl(fits) => keeps_from<M>(values, file,
            Reshapes(values, Narrow(width), Narrow(width), output, value, λ x => x.shift_right(count)),
            values(width, output) = values(width, value).shift_right(count),
            file.reshaped(shift_code(OpShr, destination, count), Narrow(width), Narrow(width), destination, output, value),
            λ holds => λ a (rep: values(width, value).resize(64) = a) =>
                trans(cong_fn(λ (c: BitVec(width)) => c.resize(64), holds),
                    trans(sym(BitVec::resize_shift_right(width, 64, high, values(width, value), count)),
                        cong_fn(λ (u: BitVec(64)) => u.shift_right(count), rep))),
            file.reshaped_keeps<M>(values, shift_code(OpShr, destination, count), λ x => x.shift_right(count),
                Narrow(width), Narrow(width), destination, output, value,
                in_place_shift<M>(OpShr, destination, count, fits))),
    }
}

// A copy, and a constant loaded zero-extended.
fn File::narrow_copy(self file: File, width: Nat, destination: Gpr, output, source: Nat) → Option<Lowered> {
    file.reshaped([], Narrow(width), Narrow(width), destination, output, source)
}

theorem File::narrow_copy_keeps<M>(self file: File, values: Valuation(), width: Nat,
    destination: Gpr, output, source: Nat):
    MayKeep<M>(values, file, values(width, output) = values(width, source),
        file.narrow_copy(width, destination, output, source))
{
    keeps_from<M>(values, file,
        Reshapes(values, Narrow(width), Narrow(width), output, source, λ x => x),
        values(width, output) = values(width, source),
        file.narrow_copy(width, destination, output, source),
        λ holds => λ a (rep: values(width, source).resize(64) = a) =>
            trans(cong_fn(λ (c: BitVec(width)) => c.resize(64), holds), rep),
        file.reshaped_keeps<M>(values, [], λ x => x, Narrow(width), Narrow(width), destination, output, source,
            in_place_none<M>(destination)))
}

fn File::narrow_constant(self file: File, width: Nat, destination: Gpr, output, value: Nat) → Option<Lowered> {
    Some(Lowered([mov_constant(destination, BitVec::ofNat(value, n := width).resize(64))],
        file.write(destination, Some(Held(output, Narrow(width))))))
}

theorem File::narrow_constant_keeps<M>(self file: File, values: Valuation(), width: Nat, destination: Gpr,
    output, value: Nat):
    MayKeep<M>(values, file, values(width, output) = BitVec::ofNat(value),
        file.narrow_constant(width, destination, output, value))
{
    λ s represents holds => file.write(destination, Some(Held(output, Narrow(width)))).represents_mov_constant<M>(values, s,
        destination, BitVec::ofNat(value, n := width).resize(64),
        file.represents_write(values, s.gprs, destination, Some(Held(output, Narrow(width))),
            BitVec::ofNat(value, n := width).resize(64), represents,
            cong_fn(λ (c: BitVec(width)) => c.resize(64), holds)))
}

// A comparison of two registers at the kind the file holds them: the bit
// is the comparison of whatever words stand for the operands.
fn Compares(values: Valuation(), from: Kind, op: CompareOp, output, left, right: Nat) → Type {
    (a, b: BitVec(64)) → Held(left, from).Rep(values, a) → Held(right, from).Rep(values, b) →
        values(1, output) = BitVec::ofBool(op.apply(a, b))
}

fn File::compared_found(self file: File, op: CompareOp, from: Kind, low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file.cleared(low), Held(left, from))>,
    second: Option<Found(file.cleared(low), Held(right, from))>) → Option<Lowered>
{
    match first {
        None => None,
        Some(a) => match second {
            None => None,
            Some(b) => Some(Lowered(
                [XorRR(low_byte_gpr(low), low_byte_gpr(low)),
                 CmpRR(a.register, b.register),
                 op.instruction(low)],
                file.cleared(low).write(low_byte_gpr(low), Some(Held(output, Bit))))),
        },
    }
}

fn File::compared_with(self file: File, op: CompareOp, from: Kind, output, left, right: Nat,
    low: Option<LowByteGpr>) → Option<Lowered>
{
    match low {
        None => None,
        Some(byte) => file.compared_found(op, from, byte, output, left, right,
            file.cleared(byte).find(Held(left, from)),
            file.cleared(byte).find(Held(right, from))),
    }
}

fn File::compared(self file: File, op: CompareOp, from: Kind, destination: Gpr, output, left, right: Nat) → Option<Lowered> {
    file.compared_with(op, from, output, left, right, destination.low_byte())
}

theorem compared_written(values: Valuation(), op: CompareOp, output: Nat,
    a, b, zeroed: BitVec(64), holds: values(1, output) = BitVec::ofBool(op.apply(a, b)),
    zero: zeroed = BitVec::zero()):
    values(1, output).zero_extend(63) =
        condition_byte(op.flag(sub_flags(a, b))).concat(zeroed.drop_low(8, 56))
{
    let bit: (values(1, output) = BitVec::ofBool(op.flag(sub_flags(a, b)))) =
        trans(holds, j(sym(op.flag_sub(a, b)), λ c _ =>
            BitVec::ofBool(op.apply(a, b)) = BitVec::ofBool(c), refl));
    j(sym(zero), λ z _ => values(1, output).zero_extend(63) = condition_byte(op.flag(sub_flags(a, b))).concat(z.drop_low(8, 56)),
        trans(j(bit, λ v _ => values(1, output).zero_extend(63) = v.zero_extend(63), refl),
            sym(condition_byte_extends(op.flag(sub_flags(a, b))))))
}

theorem File::compared_found_keeps<M>(self file: File, values: Valuation(), op: CompareOp, from: Kind,
    low: LowByteGpr, output, left, right: Nat,
    first: Option<Found(file.cleared(low), Held(left, from))>,
    second: Option<Found(file.cleared(low), Held(right, from))>):
    MayKeep<M>(values, file, Compares(values, from, op, output, left, right),
        file.compared_found(op, from, low, output, left, right, first, second))
{
    match first {
        None => trivial,
        Some(a) => match second {
            None => trivial,
            Some(b) => λ s represents compares => {
                let register = low_byte_gpr(low);
                let zeroing = execute_normal(decoded_canonical(XorRR(register, register)), s);
                let compared = execute_normal(decoded_canonical(CmpRR(a.register, b.register)), zeroing);
                let zeroed: file.cleared(low).Represents(values, zeroing.gprs) =
                    file.represents_write(values, s.gprs, register, None,
                        read_gpr(register, s.gprs).bxor(read_gpr(register, s.gprs)),
                        represents, trivial);
                j(sym(op.executes<M>(low, compared)),
                    λ gprs _ => file.cleared(low).write(register, Some(Held(output, Bit))).Represents(values, gprs),
                    file.cleared(low).represents_write(values, zeroing.gprs, register,
                        Some(Held(output, Bit)),
                        condition_byte(op.flag(compared.flags)).concat(
                            read_gpr(register, zeroing.gprs).drop_low(8, 56)),
                        zeroed,
                        compared_written(values, op, output,
                            read_gpr(a.register, zeroing.gprs),
                            read_gpr(b.register, zeroing.gprs),
                            read_gpr(register, zeroing.gprs),
                            compares(read_gpr(a.register, zeroing.gprs), read_gpr(b.register, zeroing.gprs),
                                a.at.rep(values, zeroing.gprs, zeroed),
                                b.at.rep(values, zeroing.gprs, zeroed)),
                            trans(read_gpr_after_write(register,
                                    read_gpr(register, s.gprs).bxor(read_gpr(register, s.gprs)),
                                    s.gprs),
                                BitVec::xor_self(64, read_gpr(register, s.gprs))))))
            },
        },
    }
}

theorem File::compared_keeps<M>(self file: File, values: Valuation(), op: CompareOp, from: Kind,
    destination: Gpr, output, left, right: Nat):
    MayKeep<M>(values, file, Compares(values, from, op, output, left, right),
        file.compared(op, from, destination, output, left, right))
{
    match destination.low_byte() {
        None => trivial,
        Some(byte) => file.compared_found_keeps<M>(values, op, from, byte, output, left, right,
            file.cleared(byte).find(Held(left, from)),
            file.cleared(byte).find(Held(right, from))),
    }
}

// An unsigned comparison and an equality of two zero-extended values are
// the narrow ones. A signed comparison would read the register's sign, not
// the value's, and has no narrow form yet.
theorem narrow_compares_below(values: Valuation(), width, output, left, right: Nat, high: width <= 64,
    holds: values(1, output) = BitVec::ofBool(values(width, left).unsigned_lt_bit(values(width, right)))):
    Compares(values, Narrow(width), Below, output, left, right)
{
    let x = values(width, left);
    let y = values(width, right);
    λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
        trans(holds, cong_fn(λ (c: Bool) => BitVec::ofBool(c),
            j(left_rep, λ u _ => x.unsigned_lt_bit(y) = u.unsigned_lt_bit(b),
                j(right_rep, λ v _ => x.unsigned_lt_bit(y) = x.resize(64).unsigned_lt_bit(v),
                    sym(BitVec::resize_unsigned_lt_bit(width, 64, high, x, y))))))
}

theorem narrow_compares_same(values: Valuation(), width, output, left, right: Nat, high: width <= 64,
    holds: values(1, output) = BitVec::ofBool(values(width, left).eq_bit(values(width, right)))):
    Compares(values, Narrow(width), Same, output, left, right)
{
    let x = values(width, left);
    let y = values(width, right);
    λ a b (left_rep: x.resize(64) = a) (right_rep: y.resize(64) = b) =>
        trans(holds, cong_fn(λ (c: Bool) => BitVec::ofBool(c),
            j(left_rep, λ u _ => x.eq_bit(y) = u.eq_bit(b),
                j(right_rep, λ v _ => x.eq_bit(y) = x.resize(64).eq_bit(v),
                    sym(BitVec::resize_eq_bit(width, 64, high, x, y))))))
}

// ---------------------------------------------------------------------------
// Resizing
//
// `Resize(from, to)` is `ofNat(x.toNat())`. To a word it is what the
// register of a bit or a narrow value holds already; to a wider narrow
// width likewise; to a narrower one the value is right in its low bits and
// is settled.

// A decision that picks between two steps, each kept on its side.
fn at_width(target, width: Nat, decided: width = target ∨ width ≠ target, here, other: Option<Lowered>) → Option<Lowered> {
    match decided { Inl(_) => here, Inr(_) => other }
}

theorem at_width_keeps<M>(values: Valuation(), file: File, target, width: Nat, facts: Nat → Type,
    decided: width = target ∨ width ≠ target, here, other: Option<Lowered>,
    here_keeps: MayKeep<M>(values, file, facts(target), here),
    other_keeps: MayKeep<M>(values, file, facts(width), other)):
    MayKeep<M>(values, file, facts(width), at_width(target, width, decided, here, other))
{
    match decided {
        Inl(same) => j(sym(same), λ w _ => MayKeep<M>(values, file, facts(w), here), here_keeps),
        Inr(_) => other_keeps,
    }
}

fn when_fits(n, m: Nat, decided: n <= m ∨ ¬(n <= m), yes, no: Option<Lowered>) → Option<Lowered> {
    match decided { Inl(_) => yes, Inr(_) => no }
}

theorem when_fits_keeps<M>(values: Valuation(), file: File, facts: Type, n, m: Nat,
    decided: n <= m ∨ ¬(n <= m), yes, no: Option<Lowered>,
    yes_keeps: n <= m → MayKeep<M>(values, file, facts, yes),
    no_keeps: MayKeep<M>(values, file, facts, no)):
    MayKeep<M>(values, file, facts, when_fits(n, m, decided, yes, no))
{
    match decided { Inl(fits) => yes_keeps(fits), Inr(_) => no_keeps }
}

fn Resized(values: Valuation(), from, to, output, source: Nat) → Type {
    values(to, output) = values(from, source).resize(to)
}

// A value held at `kind`, read at `to` bits: right in its low bits, then
// settled.
fn File::narrowed(self file: File, kind: Kind, to: Nat, destination: Gpr, output, source: Nat) → Option<Lowered> {
    file.settled(file.reshaped([], kind, Low(to), destination, output, source), destination, to, output)
}

theorem File::narrowed_keeps<M>(self file: File, values: Valuation(), kind: Kind, from, to: Nat,
    destination: Gpr, output, source: Nat, high: to <= 64,
    low: Resized(values, from, to, output, source) → Reshapes(values, kind, Low(to), output, source, λ x => x)):
    MayKeep<M>(values, file, Resized(values, from, to, output, source),
        file.narrowed(kind, to, destination, output, source))
{
    file.settled_keeps<M>(values, Resized(values, from, to, output, source),
        file.reshaped([], kind, Low(to), destination, output, source), destination, to, output, high,
        keeps_from<M>(values, file, Reshapes(values, kind, Low(to), output, source, λ x => x),
            Resized(values, from, to, output, source),
            file.reshaped([], kind, Low(to), destination, output, source), low,
            file.reshaped_keeps<M>(values, [], λ x => x, kind, Low(to), destination, output, source,
                in_place_none<M>(destination))))
}

// A value held at `kind`, read at the kind `to`: the register as it is.
fn File::retagged(self file: File, from, to: Kind, destination: Gpr, output, source: Nat) → Option<Lowered> {
    file.reshaped([], from, to, destination, output, source)
}

theorem File::retagged_keeps<M>(self file: File, values: Valuation(), holds: Type, from, to: Kind,
    destination: Gpr, output, source: Nat,
    same: holds → Reshapes(values, from, to, output, source, λ x => x)):
    MayKeep<M>(values, file, holds, file.retagged(from, to, destination, output, source))
{
    keeps_from<M>(values, file, Reshapes(values, from, to, output, source, λ x => x), holds,
        file.retagged(from, to, destination, output, source), same,
        file.reshaped_keeps<M>(values, [], λ x => x, from, to, destination, output, source,
            in_place_none<M>(destination)))
}

// To a word, from a bit or from a narrow width.
fn File::resize_to_word(self file: File, from: Nat, destination: Gpr, output, source: Nat) → Option<Lowered> {
    at_width(1, from, from.eq_dec(1),
        file.retagged(Bit, Word, destination, output, source),
        file.retagged(Narrow(from), Word, destination, output, source))
}

theorem File::resize_to_word_keeps<M>(self file: File, values: Valuation(), from: Nat,
    destination: Gpr, output, source: Nat):
    MayKeep<M>(values, file, Resized(values, from, 64, output, source),
        file.resize_to_word(from, destination, output, source))
{
    at_width_keeps<M>(values, file, 1, from, λ w => Resized(values, w, 64, output, source), from.eq_dec(1),
        file.retagged(Bit, Word, destination, output, source),
        file.retagged(Narrow(from), Word, destination, output, source),
        file.retagged_keeps<M>(values, Resized(values, 1, 64, output, source), Bit, Word, destination, output, source,
            λ holds => λ a (rep: values(1, source).zero_extend(63) = a) =>
                trans(holds, trans(BitVec::resize_zero_extend(1, 63, values(1, source)), rep))),
        file.retagged_keeps<M>(values, Resized(values, from, 64, output, source), Narrow(from), Word, destination, output, source,
            λ holds => λ a (rep: values(from, source).resize(64) = a) => trans(holds, rep)))
}

// To a narrow width `to`, at most 64: from a word, from a bit, from a
// narrower width and from a wider one.
fn File::resize_to_narrow(self file: File, from, to: Nat, destination: Gpr, output, source: Nat) → Option<Lowered> {
    at_width(64, from, from.eq_dec(64),
        file.narrowed(Word, to, destination, output, source),
        at_width(1, from, from.eq_dec(1),
            when_fits(1, to, Nat::le_dec(1, to),
                file.retagged(Bit, Narrow(to), destination, output, source), None),
            when_fits(from, to, from.le_dec(to),
                file.retagged(Narrow(from), Narrow(to), destination, output, source),
                file.narrowed(Narrow(from), to, destination, output, source))))
}

theorem File::resize_to_narrow_keeps<M>(self file: File, values: Valuation(), from, to: Nat,
    destination: Gpr, output, source: Nat, high: to <= 64):
    MayKeep<M>(values, file, Resized(values, from, to, output, source),
        file.resize_to_narrow(from, to, destination, output, source))
{
    let widened = λ (c: BitVec(to)) => c.resize(64);
    at_width_keeps<M>(values, file, 64, from, λ w => Resized(values, w, to, output, source), from.eq_dec(64),
        file.narrowed(Word, to, destination, output, source),
        at_width(1, from, from.eq_dec(1),
            when_fits(1, to, Nat::le_dec(1, to),
                file.retagged(Bit, Narrow(to), destination, output, source), None),
            when_fits(from, to, from.le_dec(to),
                file.retagged(Narrow(from), Narrow(to), destination, output, source),
                file.narrowed(Narrow(from), to, destination, output, source))),
        file.narrowed_keeps<M>(values, Word, 64, to, destination, output, source, high,
            λ holds => λ a (rep: values(64, source) = a) =>
                j(rep, λ u _ => u.resize(to) = values(to, output), sym(holds))),
        at_width_keeps<M>(values, file, 1, from, λ w => Resized(values, w, to, output, source), from.eq_dec(1),
            when_fits(1, to, Nat::le_dec(1, to),
                file.retagged(Bit, Narrow(to), destination, output, source), None),
            when_fits(from, to, from.le_dec(to),
                file.retagged(Narrow(from), Narrow(to), destination, output, source),
                file.narrowed(Narrow(from), to, destination, output, source)),
            when_fits_keeps<M>(values, file, Resized(values, 1, to, output, source), 1, to, Nat::le_dec(1, to),
                file.retagged(Bit, Narrow(to), destination, output, source), None,
                λ fits => file.retagged_keeps<M>(values, Resized(values, 1, to, output, source), Bit, Narrow(to),
                    destination, output, source,
                    λ holds => λ a (rep: values(1, source).zero_extend(63) = a) =>
                        trans(cong_fn(widened, holds),
                            trans(BitVec::resize_widened(1, to, fits, values(1, source), 64),
                                trans(BitVec::resize_zero_extend(1, 63, values(1, source)), rep)))),
                trivial),
            when_fits_keeps<M>(values, file, Resized(values, from, to, output, source), from, to, from.le_dec(to),
                file.retagged(Narrow(from), Narrow(to), destination, output, source),
                file.narrowed(Narrow(from), to, destination, output, source),
                λ fits => file.retagged_keeps<M>(values, Resized(values, from, to, output, source), Narrow(from), Narrow(to),
                    destination, output, source,
                    λ holds => λ a (rep: values(from, source).resize(64) = a) =>
                        trans(cong_fn(widened, holds),
                            trans(BitVec::resize_widened(from, to, fits, values(from, source), 64), rep))),
                file.narrowed_keeps<M>(values, Narrow(from), from, to, destination, output, source, high,
                    λ holds => λ a (rep: values(from, source).resize(64) = a) =>
                        j(rep, λ u _ => u.resize(to) = values(to, output),
                            trans(BitVec::resize_narrowed(to, 64, high, values(from, source)), sym(holds)))))))
}

// A resize to one bit would have to leave a `Bit`, which no settling does
// yet, and is refused.
fn File::resize(self file: File, from, to: Nat, destination: Gpr, output, source: Nat) → Option<Lowered> {
    at_width(64, to, to.eq_dec(64),
        file.resize_to_word(from, destination, output, source),
        at_width(1, to, to.eq_dec(1), None,
            when_fits(to, 64, to.le_dec(64),
                file.resize_to_narrow(from, to, destination, output, source), None)))
}

theorem File::resize_keeps<M>(self file: File, values: Valuation(), from, to: Nat,
    destination: Gpr, output, source: Nat):
    MayKeep<M>(values, file, Resized(values, from, to, output, source),
        file.resize(from, to, destination, output, source))
{
    at_width_keeps<M>(values, file, 64, to, λ w => Resized(values, from, w, output, source), to.eq_dec(64),
        file.resize_to_word(from, destination, output, source),
        at_width(1, to, to.eq_dec(1), None,
            when_fits(to, 64, to.le_dec(64),
                file.resize_to_narrow(from, to, destination, output, source), None)),
        file.resize_to_word_keeps<M>(values, from, destination, output, source),
        at_width_keeps<M>(values, file, 1, to, λ w => Resized(values, from, w, output, source), to.eq_dec(1),
            None,
            when_fits(to, 64, to.le_dec(64),
                file.resize_to_narrow(from, to, destination, output, source), None),
            trivial,
            when_fits_keeps<M>(values, file, Resized(values, from, to, output, source), to, 64, to.le_dec(64),
                file.resize_to_narrow(from, to, destination, output, source), None,
                λ high => file.resize_to_narrow_keeps<M>(values, from, to, destination, output, source, high),
                trivial)))
}

// ---------------------------------------------------------------------------
// A byte swap: `BSWAP r32` on a 32-bit value held narrow, its four bytes
// reversed and the upper half left zero.

// A narrow word's swap, zero-extended, is what `BSWAP r32` leaves of the
// word that holds it.
theorem bswap_narrow(x: BitVec(32)): bswap32_value(x.zero_extend(32)) = x.byte_swap(4).zero_extend(32) { refl }

theorem in_place_bswap<M>(destination: Gpr): InPlace<M>([Bswap32(destination)], destination, bswap32_value) {
    λ s query => refl
}

fn File::byte_swap(self file: File, destination: Gpr, output, source: Nat) → Option<Lowered> {
    file.reshaped([Bswap32(destination)], Narrow(32), Narrow(32), destination, output, source)
}

theorem File::byte_swap_keeps<M>(self file: File, values: Valuation(), destination: Gpr, output, source: Nat):
    MayKeep<M>(values, file, NodeHolds(values, ByteSwap(32, output, source)), file.byte_swap(destination, output, source))
{
    keeps_given<M>(values, file, Reshapes(values, Narrow(32), Narrow(32), output, source, bswap32_value),
        NodeHolds(values, ByteSwap(32, output, source)), file.byte_swap(destination, output, source),
        λ gprs represents holds => λ a (rep: values(32, source).resize(64) = a) => {
            let x = values(32, source);
            let swapped: (values(32, output).resize(64) = x.byte_swap(4).zero_extend(32)) =
                trans(cong_fn(λ (y: BitVec(32)) => y.resize(64), trans(holds, BitVec::swap_bytes_32(x))),
                    BitVec::resize_zero_extend(32, 32, x.byte_swap(4)));
            trans(swapped, trans(sym(bswap_narrow(x)),
                cong_fn(bswap32_value, trans(sym(BitVec::resize_zero_extend(32, 32, x)), rep))))
        },
        file.reshaped_keeps<M>(values, [Bswap32(destination)], bswap32_value, Narrow(32), Narrow(32), destination, output, source,
            in_place_bswap<M>(destination)))
}

// ---------------------------------------------------------------------------
// A rotate: `ROR r32, imm8` on a 32-bit value held narrow, by a count below
// 32, which the five-bit mask leaves alone. The low half is rotated and the
// upper half left zero, so the result is held narrow again.

theorem ror32_count_of(count: Nat, fits: count <= 31): ror32_count(BitVec::ofNat(count)) = count {
    let small: (count < Nat::pow(2, 8)) = Nat::le_trans(count, 31, 255, fits, trivial);
    trans(cong_fn(λ (n: Nat) => n.mod(32), BitVec::toNat_ofNat(8, count, small)),
        Nat::mod_of_lt(count, 32, fits))
}

// A narrow word's rotation, zero-extended, is what `ROR r32` leaves of the
// word that holds it.
theorem ror_narrow(x: BitVec(32), count: Nat): ror32_value(x.zero_extend(32), count) = x.rotr(count).zero_extend(32) {
    cong_fn(λ (y: BitVec(32)) => y.rotr(count).zero_extend(32), BitVec::truncate_zero_extend(32, 32, x))
}

theorem in_place_ror32<M>(destination: Gpr, immediate: BitVec(8)):
    InPlace<M>([RorRI32(destination, immediate)], destination, λ x => ror32_value(x, ror32_count(immediate)))
{
    λ s query => refl
}

fn File::rotate_right(self file: File, destination: Gpr, output, value, amount: Nat) → Option<Lowered> {
    match amount.le_dec(31) {
        Inr(_) => None,
        Inl(_) => file.reshaped([RorRI32(destination, BitVec::ofNat(amount))], Narrow(32), Narrow(32), destination, output, value),
    }
}

theorem File::rotate_right_keeps<M>(self file: File, values: Valuation(), destination: Gpr, output, value, amount: Nat):
    MayKeep<M>(values, file, NodeHolds(values, RotateRight(32, output, value, amount)),
        file.rotate_right(destination, output, value, amount))
{
    match amount.le_dec(31) {
        Inr(_) => trivial,
        Inl(fits) => {
            let g = λ (x: BitVec(64)) => ror32_value(x, ror32_count(BitVec::ofNat(amount, n := 8)));
            let code: List<Instruction> = [RorRI32(destination, BitVec::ofNat(amount))];
            keeps_given<M>(values, file, Reshapes(values, Narrow(32), Narrow(32), output, value, g),
                NodeHolds(values, RotateRight(32, output, value, amount)),
                file.reshaped(code, Narrow(32), Narrow(32), destination, output, value),
                λ gprs represents holds => λ a (rep: values(32, value).resize(64) = a) => {
                    let x = values(32, value);
                    let rotated: (values(32, output).resize(64) = x.rotr(amount).zero_extend(32)) =
                        trans(cong_fn(λ (y: BitVec(32)) => y.resize(64), holds),
                            BitVec::resize_zero_extend(32, 32, x.rotr(amount)));
                    let counted: (g(x.zero_extend(32)) = x.rotr(amount).zero_extend(32)) =
                        trans(cong_fn(λ (c: Nat) => ror32_value(x.zero_extend(32), c), ror32_count_of(amount, fits)),
                            ror_narrow(x, amount));
                    trans(rotated, trans(sym(counted),
                        cong_fn(g, trans(sym(BitVec::resize_zero_extend(32, 32, x)), rep))))
                },
                file.reshaped_keeps<M>(values, code, g, Narrow(32), Narrow(32), destination, output, value,
                    in_place_ror32<M>(destination, BitVec::ofNat(amount))))
        },
    }
}

// ---------------------------------------------------------------------------
// Nodes

// What only the word has yet (a signed comparison, an arithmetic right
// shift): a node at another width is refused.
fn word_only(width: Nat, decided: width = 64 ∨ width ≠ 64, step: Option<Lowered>) → Option<Lowered> {
    match decided { Inl(_) => step, Inr(_) => None }
}

theorem word_only_keeps<M>(values: Valuation(), file: File, width: Nat,
    facts: Nat → Type, decided: width = 64 ∨ width ≠ 64, step: Option<Lowered>,
    keeps: MayKeep<M>(values, file, facts(64), step)):
    MayKeep<M>(values, file, facts(width), word_only(width, decided, step))
{
    match decided {
        Inl(word) => j(sym(word), λ w _ => MayKeep<M>(values, file, facts(w), step), keeps),
        Inr(_) => trivial,
    }
}

// A node by its width: the word's step, the bit's where there is one, and
// the narrow step for any other width a register holds.
fn by_width(width: Nat, word: width = 64 ∨ width ≠ 64, bit: width = 1 ∨ width ≠ 1,
    word_step, bit_step, narrow_step: Option<Lowered>) → Option<Lowered> {
    match word {
        Inl(_) => word_step,
        Inr(_) => match bit {
            Inl(_) => bit_step,
            Inr(_) => match width.le_dec(64) { Inl(_) => narrow_step, Inr(_) => None },
        },
    }
}

theorem by_width_keeps<M>(values: Valuation(), file: File, width: Nat,
    facts: Nat → Type, word: width = 64 ∨ width ≠ 64, bit: width = 1 ∨ width ≠ 1,
    word_step, bit_step, narrow_step: Option<Lowered>,
    word_keeps: MayKeep<M>(values, file, facts(64), word_step),
    bit_keeps: MayKeep<M>(values, file, facts(1), bit_step),
    narrow_keeps: width <= 64 → MayKeep<M>(values, file, facts(width), narrow_step)):
    MayKeep<M>(values, file, facts(width), by_width(width, word, bit, word_step, bit_step, narrow_step))
{
    match word {
        Inl(wide) => j(sym(wide), λ w _ => MayKeep<M>(values, file, facts(w), word_step), word_keeps),
        Inr(_) => match bit {
            Inl(one) => j(sym(one), λ w _ => MayKeep<M>(values, file, facts(w), bit_step), bit_keeps),
            Inr(_) => match width.le_dec(64) { Inl(high) => narrow_keeps(high), Inr(_) => trivial },
        },
    }
}

// One node, its result in `destination` (the placement's choice).
fn Node::lower(self node: Node, destination: Gpr, file: File) → Option<Lowered> {
    match node {
        Const(width, output, value) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.constant(destination, output, value), file.bit_constant(destination, output, value),
            file.narrow_constant(width, destination, output, value)),
        Move(width, output, source) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.copy(destination, output, source), None,
            file.narrow_copy(width, destination, output, source)),
        Add(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.add(destination, output, left, right), None,
            file.narrow_binary(OpAdd, width, destination, output, left, right)),
        Sub(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.binary(OpSub, destination, output, left, right), None,
            file.narrow_binary(OpSub, width, destination, output, left, right)),
        BitAnd(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.binary(OpAnd, destination, output, left, right), file.bits(OpAnd, destination, output, left, right),
            file.narrow_binary(OpAnd, width, destination, output, left, right)),
        BitOr(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.binary(OpOr, destination, output, left, right), file.bits(OpOr, destination, output, left, right),
            file.narrow_binary(OpOr, width, destination, output, left, right)),
        BitXor(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.binary(OpXor, destination, output, left, right), file.bits(OpXor, destination, output, left, right),
            file.narrow_binary(OpXor, width, destination, output, left, right)),
        ShiftLeft(width, output, value, amount) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.shift(OpShl, destination, output, value, amount), None,
            file.narrow_shift_left(width, destination, output, value, amount)),
        LogicalShiftRight(width, output, value, amount) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.shift(OpShr, destination, output, value, amount), None,
            file.narrow_shift_right(width, destination, output, value, amount)),
        ArithmeticShiftRight(width, output, value, amount) => word_only(width, width.eq_dec(64),
            file.shift(OpSar, destination, output, value, amount)),
        UnsignedLessThan(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.compare(Below, destination, output, left, right), None,
            file.compared(Below, Narrow(width), destination, output, left, right)),
        SignedLessThan(width, output, left, right) => word_only(width, width.eq_dec(64),
            file.compare(Less, destination, output, left, right)),
        Equal(width, output, left, right) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            file.compare(Same, destination, output, left, right), None,
            file.compared(Same, Narrow(width), destination, output, left, right)),
        // Registers only: a buffer is memory.
        BufferLoad(_, _, _) => None,
        BufferStore(_, _, _, _) => None,
        Resize(from, to, output, source) => file.resize(from, to, destination, output, source),
        // A sign extension has no narrow form yet.
        SignResize(_, _, _, _) => None,
        // A table read is memory too: its lowering is the next step.
        TableRead(_, _, _, _, _) => None,
        // Wide accesses and the byte swap lower in their own leaves
        // (`function_ir_lower_reads`); this file lowers neither.
        WideLoad(_, _, _, _) => None,
        WideStore(_, _, _, _, _) => None,
        // A swap of 32 bits held narrow; the 64-bit swap is not lowered yet.
        ByteSwap(width, output, source) => at_width(32, width, width.eq_dec(32), file.byte_swap(destination, output, source), None),
        RotateRight(width, output, value, amount) => at_width(32, width, width.eq_dec(32),
            file.rotate_right(destination, output, value, amount), None),
    }
}

theorem Node::lower_keeps<M>(self node: Node, values: Valuation(), destination: Gpr, file: File):
    MayKeep<M>(values, file, NodeHolds(values, node), node.lower(destination, file))
{
    match node {
        Const(width, output, value) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Const(w, output, value)), width.eq_dec(64), width.eq_dec(1),
            file.constant(destination, output, value), file.bit_constant(destination, output, value),
            file.narrow_constant(width, destination, output, value),
            file.constant_keeps<M>(values, destination, output, value),
            file.bit_constant_keeps<M>(values, destination, output, value),
            λ _ => file.narrow_constant_keeps<M>(values, width, destination, output, value)),
        Move(width, output, source) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Move(w, output, source)), width.eq_dec(64), width.eq_dec(1),
            file.copy(destination, output, source), None,
            file.narrow_copy(width, destination, output, source),
            file.copy_keeps<M>(values, destination, output, source), trivial,
            λ _ => file.narrow_copy_keeps<M>(values, width, destination, output, source)),
        Add(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Add(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.add(destination, output, left, right), None,
            file.narrow_binary(OpAdd, width, destination, output, left, right),
            file.add_keeps<M>(values, destination, output, left, right), trivial,
            λ high => file.narrow_binary_keeps<M>(values, OpAdd, width, destination, output, left, right, high)),
        Sub(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Sub(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.binary(OpSub, destination, output, left, right), None,
            file.narrow_binary(OpSub, width, destination, output, left, right),
            file.binary_keeps<M>(values, OpSub, destination, output, left, right), trivial,
            λ high => file.narrow_binary_keeps<M>(values, OpSub, width, destination, output, left, right, high)),
        BitAnd(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, BitAnd(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.binary(OpAnd, destination, output, left, right), file.bits(OpAnd, destination, output, left, right),
            file.narrow_binary(OpAnd, width, destination, output, left, right),
            file.binary_keeps<M>(values, OpAnd, destination, output, left, right),
            file.bits_keeps<M>(values, OpAnd, destination, output, left, right),
            λ high => file.narrow_binary_keeps<M>(values, OpAnd, width, destination, output, left, right, high)),
        BitOr(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, BitOr(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.binary(OpOr, destination, output, left, right), file.bits(OpOr, destination, output, left, right),
            file.narrow_binary(OpOr, width, destination, output, left, right),
            file.binary_keeps<M>(values, OpOr, destination, output, left, right),
            file.bits_keeps<M>(values, OpOr, destination, output, left, right),
            λ high => file.narrow_binary_keeps<M>(values, OpOr, width, destination, output, left, right, high)),
        BitXor(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, BitXor(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.binary(OpXor, destination, output, left, right), file.bits(OpXor, destination, output, left, right),
            file.narrow_binary(OpXor, width, destination, output, left, right),
            file.binary_keeps<M>(values, OpXor, destination, output, left, right),
            file.bits_keeps<M>(values, OpXor, destination, output, left, right),
            λ high => file.narrow_binary_keeps<M>(values, OpXor, width, destination, output, left, right, high)),
        ShiftLeft(width, output, value, amount) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, ShiftLeft(w, output, value, amount)), width.eq_dec(64), width.eq_dec(1),
            file.shift(OpShl, destination, output, value, amount), None,
            file.narrow_shift_left(width, destination, output, value, amount),
            file.shift_keeps<M>(values, OpShl, destination, output, value, amount), trivial,
            λ high => file.narrow_shift_left_keeps<M>(values, width, destination, output, value, amount, high)),
        LogicalShiftRight(width, output, value, amount) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, LogicalShiftRight(w, output, value, amount)), width.eq_dec(64), width.eq_dec(1),
            file.shift(OpShr, destination, output, value, amount), None,
            file.narrow_shift_right(width, destination, output, value, amount),
            file.shift_keeps<M>(values, OpShr, destination, output, value, amount), trivial,
            λ high => file.narrow_shift_right_keeps<M>(values, width, destination, output, value, amount, high)),
        ArithmeticShiftRight(width, output, value, amount) => word_only_keeps<M>(values, file, width,
            λ w => NodeHolds(values, ArithmeticShiftRight(w, output, value, amount)), width.eq_dec(64),
            file.shift(OpSar, destination, output, value, amount),
            file.shift_keeps<M>(values, OpSar, destination, output, value, amount)),
        UnsignedLessThan(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, UnsignedLessThan(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.compare(Below, destination, output, left, right), None,
            file.compared(Below, Narrow(width), destination, output, left, right),
            file.compare_keeps<M>(values, Below, destination, output, left, right), trivial,
            λ high => keeps_from<M>(values, file, Compares(values, Narrow(width), Below, output, left, right),
                NodeHolds(values, UnsignedLessThan(width, output, left, right)),
                file.compared(Below, Narrow(width), destination, output, left, right),
                λ holds => narrow_compares_below(values, width, output, left, right, high, holds),
                file.compared_keeps<M>(values, Below, Narrow(width), destination, output, left, right))),
        SignedLessThan(width, output, left, right) => word_only_keeps<M>(values, file, width,
            λ w => NodeHolds(values, SignedLessThan(w, output, left, right)), width.eq_dec(64),
            file.compare(Less, destination, output, left, right),
            file.compare_keeps<M>(values, Less, destination, output, left, right)),
        Equal(width, output, left, right) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Equal(w, output, left, right)), width.eq_dec(64), width.eq_dec(1),
            file.compare(Same, destination, output, left, right), None,
            file.compared(Same, Narrow(width), destination, output, left, right),
            file.compare_keeps<M>(values, Same, destination, output, left, right), trivial,
            λ high => keeps_from<M>(values, file, Compares(values, Narrow(width), Same, output, left, right),
                NodeHolds(values, Equal(width, output, left, right)),
                file.compared(Same, Narrow(width), destination, output, left, right),
                λ holds => narrow_compares_same(values, width, output, left, right, high, holds),
                file.compared_keeps<M>(values, Same, Narrow(width), destination, output, left, right))),
        BufferLoad(_, _, _) => trivial,
        BufferStore(_, _, _, _) => trivial,
        Resize(from, to, output, source) => file.resize_keeps<M>(values, from, to, destination, output, source),
        SignResize(_, _, _, _) => trivial,
        TableRead(_, _, _, _, _) => trivial,
        WideLoad(_, _, _, _) => trivial,
        WideStore(_, _, _, _, _) => trivial,
        ByteSwap(width, output, source) => at_width_keeps<M>(values, file, 32, width, λ w => NodeHolds(values, ByteSwap(w, output, source)),
            width.eq_dec(32), file.byte_swap(destination, output, source), None, file.byte_swap_keeps<M>(values, destination, output, source), trivial),
        RotateRight(width, output, value, amount) => at_width_keeps<M>(values, file, 32, width,
            λ w => NodeHolds(values, RotateRight(w, output, value, amount)), width.eq_dec(32),
            file.rotate_right(destination, output, value, amount), None,
            file.rotate_right_keeps<M>(values, destination, output, value, amount), trivial),
    }
}

// Where the placement puts a node's value: in a register, or nowhere, the
// node folded into what reads it. A folded constant is an ADD's immediate
// (or loaded where something reads it from a register after all); a folded
// comparison is the flags its branch jumps on. The file knows either.
//
// `Saving` is no node's place. It is what a function's placement begins
// with where the function saves callee-saved registers to hold values in:
// how many of them, in `kept_order` (function_ir_lower_reads,
// `placement_saves` in function_ir_lower_calls). Where a node's place is
// wanted it is a refusal.
// `Spilling(mask)` is a call's: which of the eight registers a caller saves
// the call saves round itself, bit `k` the `k`th (function_ir_lower_calls,
// `call_saves`).
inductive Place { Into(register: Gpr), Folded, Saving(count: Nat), CallSlots(count: Nat), Spilling(mask: Nat), Short(name: Nat) }

// A bit that is a constant is known true or false, which is what an arm
// taken on it knows: a decided comparison's bit written after it
// (docs/native/optimizer-design.md §5.1) is read here.
fn File::know_bit(self file: File, output, value: Nat) → Option<Lowered> {
    match value {
        Zero => Some(Lowered([], file.know(Falsity(output)))),
        Succ(more) => match more { Zero => Some(Lowered([], file.know(Truth(output)))), Succ(_) => None },
    }
}

fn Node::fold(self node: Node, file: File) → Option<Lowered> {
    match node {
        Const(width, output, value) => by_width(width, width.eq_dec(64), width.eq_dec(1),
            Some(Lowered([], file.know(Constant(output, value)))), file.know_bit(output, value), None),
        UnsignedLessThan(width, output, left, right) => word_only(width, width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Below, left, right))))),
        SignedLessThan(width, output, left, right) => word_only(width, width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Less, left, right))))),
        Equal(width, output, left, right) => word_only(width, width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Same, left, right))))),
        _ => None,
    }
}

theorem File::know_keeps<M>(self file: File, values: Valuation(), known: Known):
    MayKeep<M>(values, file, known.Holds(values), Some(Lowered([], file.know(known))))
{
    λ s represents holds => file.represents_know(values, s.gprs, known, represents, holds)
}

theorem File::know_bit_keeps<M>(self file: File, values: Valuation(), output, value: Nat):
    MayKeep<M>(values, file, NodeHolds(values, Const(1, output, value)), file.know_bit(output, value))
{
    match value {
        Zero => λ s represents holds => file.represents_know(values, s.gprs, Falsity(output), represents,
            cong_fn(λ (b: BitVec(1)) => b.head_bit(), holds)),
        Succ(more) => match more {
            Zero => λ s represents holds => file.represents_know(values, s.gprs, Truth(output), represents,
                cong_fn(λ (b: BitVec(1)) => b.head_bit(), holds)),
            Succ(_) => trivial,
        },
    }
}

theorem Node::fold_keeps<M>(self node: Node, values: Valuation(), file: File):
    MayKeep<M>(values, file, NodeHolds(values, node), node.fold(file))
{
    match node {
        Const(width, output, value) => by_width_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Const(w, output, value)), width.eq_dec(64), width.eq_dec(1),
            Some(Lowered([], file.know(Constant(output, value)))), file.know_bit(output, value), None,
            file.know_keeps<M>(values, Constant(output, value)), file.know_bit_keeps<M>(values, output, value), λ _ => trivial),
        Move(_, _, _) => trivial,
        Add(_, _, _, _) => trivial,
        Sub(_, _, _, _) => trivial,
        BitAnd(_, _, _, _) => trivial,
        BitOr(_, _, _, _) => trivial,
        BitXor(_, _, _, _) => trivial,
        ShiftLeft(_, _, _, _) => trivial,
        LogicalShiftRight(_, _, _, _) => trivial,
        ArithmeticShiftRight(_, _, _, _) => trivial,
        UnsignedLessThan(width, output, left, right) => word_only_keeps<M>(values, file, width,
            λ w => NodeHolds(values, UnsignedLessThan(w, output, left, right)), width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Below, left, right)))),
            file.know_keeps<M>(values, Compared(output, Below, left, right))),
        SignedLessThan(width, output, left, right) => word_only_keeps<M>(values, file, width,
            λ w => NodeHolds(values, SignedLessThan(w, output, left, right)), width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Less, left, right)))),
            file.know_keeps<M>(values, Compared(output, Less, left, right))),
        Equal(width, output, left, right) => word_only_keeps<M>(values, file, width,
            λ w => NodeHolds(values, Equal(w, output, left, right)), width.eq_dec(64),
            Some(Lowered([], file.know(Compared(output, Same, left, right)))),
            file.know_keeps<M>(values, Compared(output, Same, left, right))),
        BufferLoad(_, _, _) => trivial,
        BufferStore(_, _, _, _) => trivial,
        Resize(_, _, _, _) => trivial,
        SignResize(_, _, _, _) => trivial,
        TableRead(_, _, _, _, _) => trivial,
        WideLoad(_, _, _, _) => trivial,
        WideStore(_, _, _, _, _) => trivial,
        ByteSwap(_, _, _) => trivial,
        RotateRight(_, _, _, _) => trivial,
    }
}

fn Node::lower_at(self node: Node, place: Place, file: File) → Option<Lowered> {
    match place { Into(destination) => node.lower(destination, file), Folded => node.fold(file), Saving(_) => None, CallSlots(_) => None, Short(_) => None, Spilling(_) => None }
}

theorem Node::lower_at_keeps<M>(self node: Node, values: Valuation(), place: Place, file: File):
    MayKeep<M>(values, file, NodeHolds(values, node), node.lower_at(place, file))
{
    match place {
        Into(destination) => node.lower_keeps<M>(values, destination, file),
        Folded => node.fold_keeps<M>(values, file),
        Saving(_) => trivial,
        CallSlots(_) => trivial, Short(_) => trivial,
        Spilling(_) => trivial,
    }
}

// The nodes in their stored schedule, one placement entry each.
fn lower_nodes(nodes: List<Node>, placement: List<Place>, file: File) → Option<Lowered> {
    match nodes {
        Nil => Some(Lowered([], file)),
        Cons(node, rest) => match placement {
            Nil => None,
            Cons(place, later) => match node.lower_at(place, file) {
                None => None,
                Some(first) => first.then_option(lower_nodes(rest, later, first.file)),
            },
        },
    }
}

theorem lower_nodes_keeps<M>(values: Valuation(), nodes: List<Node>):
    (placement: List<Place>) → (file: File) →
    MayKeep<M>(values, file, NodesHold(values, nodes), lower_nodes(nodes, placement, file))
{
    match nodes {
        Nil => λ placement file s represents _ => represents,
        Cons(node, rest) => λ placement => match placement {
            Nil => λ file => trivial,
            Cons(place, later) => λ file =>
                (match node.lower_at(place, file) as λ step =>
                    MayKeep<M>(values, file, NodeHolds(values, node), step) →
                    MayKeep<M>(values, file, NodeHolds(values, node) ∧ NodesHold(values, rest),
                        match step {
                            None => None,
                            Some(first) => first.then_option(lower_nodes(rest, later, first.file)),
                        }) {
                    None => λ _ => trivial,
                    Some(first) => λ first_keeps =>
                        then_option_seq<M>(values, file, NodeHolds(values, node),
                            NodesHold(values, rest), first, first_keeps,
                            lower_nodes(rest, later, first.file),
                            lower_nodes_keeps<M>(values, rest, later, first.file)),
                })(node.lower_at_keeps<M>(values, place, file)),
        },
    }
}

// ---------------------------------------------------------------------------
// A region: inputs in registers, outputs moved to theirs

// How a port's width sits in a register: 64 bits as a word, one bit
// zero-extended, and nothing else yet. A narrow value (`Narrow`, `Low`)
// lives inside a region and does not cross its boundary
// (issues/runtime-repr-narrow-words.md).
fn Kind::of_width(width: Nat) → Option<Kind> {
    match width.eq_dec(64) {
        Inl(_) => Some(Word),
        Inr(_) => match width.eq_dec(1) { Inl(_) => Some(Bit), Inr(_) => None },
    }
}

// A port is a word or a bit: no value crosses a region's boundary at a
// narrow kind.
fn Kind::plain(self kind: Kind) → Bool {
    match kind { Word => True, Bit => True, Narrow(_) => False, Low(_) => False }
}

theorem Kind::of_width_plain(width: Nat, kind: Kind, at: Kind::of_width(width) = Some(kind)): kind.plain() = True {
    (match width.eq_dec(64) as λ d =>
            (match d { Inl(_) => Some(Word), Inr(_) => match width.eq_dec(1) { Inl(_) => Some(Bit), Inr(_) => None } }) = Some(kind) →
            kind.plain() = True {
        Inl(_) => λ some => j(Option::some_inj(Word, kind, some), λ k _ => k.plain() = True, refl),
        Inr(_) => match width.eq_dec(1) as λ e =>
                (match e { Inl(_) => Some(Bit), Inr(_) => None }) = Some(kind) → kind.plain() = True {
            Inl(_) => λ some => j(Option::some_inj(Bit, kind, some), λ k _ => k.plain() = True, refl),
            Inr(_) => λ none => absurd(none),
        },
    })(at)
}

fn KindRep(values: Valuation(), id: Nat, kind: Option<Kind>, word: BitVec(64)) → Type {
    match kind { None => False, Some(k) => Held(id, k).Rep(values, word) }
}

fn Port::Rep(self port: Port, values: Valuation(), word: BitVec(64)) → Type {
    KindRep(values, port.id, Kind::of_width(port.width), word)
}

// Each port's value in its register: a region's inputs before its code,
// its outputs after.
fn PortsAt(values: Valuation(), entries: List<Port>) → List<Gpr> → Gprs → Type {
    match entries {
        Nil => λ _ _ => True,
        Cons(port, rest) => λ registers gprs => match registers {
            Nil => False,
            Cons(register, later) =>
                port.Rep(values, read_gpr(register, gprs)) ∧
                PortsAt(values, rest, later, gprs),
        },
    }
}

fn input_with(register: Gpr, id: Nat, kind: Option<Kind>, rest: Option<File>) → Option<File> {
    match kind {
        None => None,
        Some(k) => match rest {
            None => None,
            Some(file) => Some(file.write(register, Some(Held(id, k)))),
        },
    }
}

fn input_file(entries: List<Port>, registers: List<Gpr>) → Option<File> {
    match entries {
        Nil => Some(File::empty()),
        Cons(port, rest) => match registers {
            Nil => None,
            Cons(register, later) => input_with(register, port.id,
                Kind::of_width(port.width), input_file(rest, later)),
        },
    }
}

theorem input_with_represents(values: Valuation(), gprs: Gprs, register: Gpr,
    id: Nat, kind: Option<Kind>):
    KindRep(values, id, kind, read_gpr(register, gprs)) →
    (rest: Option<File>) →
    rest.All(λ (file: File) => file.Represents(values, gprs)) →
    input_with(register, id, kind, rest).All(λ (file: File) => file.Represents(values, gprs))
{
    match kind {
        None => λ no rest _ => trivial,
        Some(k) => λ here rest => match rest {
            None => λ _ => trivial,
            Some(file) => λ represents =>
                file.represents_retag(values, gprs, register, Some(Held(id, k)),
                    represents, here),
        },
    }
}

theorem input_file_represents(values: Valuation(), gprs: Gprs, entries: List<Port>):
    (registers: List<Gpr>) → PortsAt(values, entries, registers, gprs) →
    input_file(entries, registers).All(λ (file: File) => file.Represents(values, gprs))
{
    match entries {
        Nil => λ registers _ => File::empty_represents(values, gprs),
        Cons(port, rest) => λ registers => match registers {
            Nil => λ _ => trivial,
            Cons(register, later) => λ placed =>
                input_with_represents(values, gprs, register, port.id,
                    Kind::of_width(port.width), placed.left, input_file(rest, later),
                    input_file_represents(values, gprs, rest, later, placed.right)),
        },
    }
}

fn File::move_outputs(self file: File, entries: List<Port>, registers: List<Gpr>) → Option<Lowered> {
    match entries {
        Nil => Some(Lowered([], file)),
        Cons(port, rest) => match registers {
            Nil => None,
            Cons(register, later) => match Kind::of_width(port.width) {
                None => None,
                Some(kind) => match file.place(Held(port.id, kind), register) {
                    None => None,
                    Some(moved) => moved.then_option(moved.file.move_outputs(rest, later)),
                },
            },
        },
    }
}

theorem move_outputs_keeps<M>(values: Valuation(), entries: List<Port>):
    (file: File) → (registers: List<Gpr>) →
    MayKeep<M>(values, file, True, file.move_outputs(entries, registers))
{
    match entries {
        Nil => λ file registers s represents _ => represents,
        Cons(port, rest) => λ file registers => match registers {
            Nil => trivial,
            Cons(register, later) =>
                match Kind::of_width(port.width) {
                    None => trivial,
                    Some(k) =>
                        (match file.place(Held(port.id, k), register) as λ placed =>
                            MayKeep<M>(values, file, True, placed) →
                            MayKeep<M>(values, file, True, match placed {
                                None => None,
                                Some(moved) => moved.then_option(moved.file.move_outputs(rest, later)),
                            }) {
                            None => λ _ => trivial,
                            Some(moved) => λ moved_keeps =>
                                then_option_keeps<M>(values, file, True, moved, moved_keeps,
                                    moved.file.move_outputs(rest, later),
                                    move_outputs_keeps<M>(values, rest, moved.file, later)),
                        })(file.place_keeps<M>(values, Held(port.id, k), register)),
                },
        },
    }
}

fn File::check_one(self file: File, id: Nat, kind: Option<Kind>, register: Gpr) → Bool {
    match kind { None => False, Some(k) => file.found_at(Held(id, k), register).is_some() }
}

// The file, after the moves, says every output is in its register: a later
// move did not overwrite an earlier one.
fn File::outputs_check(self file: File, entries: List<Port>, registers: List<Gpr>) → Bool {
    match entries {
        Nil => True,
        Cons(port, rest) => match registers {
            Nil => False,
            Cons(register, later) =>
                file.check_one(port.id, Kind::of_width(port.width), register) &&
                file.outputs_check(rest, later),
        },
    }
}

theorem check_one_sound(values: Valuation(), file: File, gprs: Gprs,
    represents: file.Represents(values, gprs), id: Nat, kind: Option<Kind>,
    register: Gpr):
    file.check_one(id, kind, register).IsTrue() →
    KindRep(values, id, kind, read_gpr(register, gprs))
{
    match kind {
        None => λ no => false_elim(no),
        Some(k) => λ checked => file.found_at(Held(id, k), register).get(checked).rep(values, gprs, represents),
    }
}

theorem outputs_check_sound(values: Valuation(), file: File, gprs: Gprs,
    represents: file.Represents(values, gprs), entries: List<Port>):
    (registers: List<Gpr>) → file.outputs_check(entries, registers).IsTrue() →
    PortsAt(values, entries, registers, gprs)
{
    match entries {
        Nil => λ registers _ => trivial,
        Cons(port, rest) => λ registers => match registers {
            Nil => λ no => false_elim(no),
            Cons(register, later) => λ checked => {
                let both = Bool::is_true_and(
                    file.check_one(port.id, Kind::of_width(port.width), register),
                    file.outputs_check(rest, later), checked);
                ⟨check_one_sound(values, file, gprs, represents, port.id,
                        Kind::of_width(port.width), register, both.left),
                 outputs_check_sound(values, file, gprs, represents, rest, later, both.right)⟩
            },
        },
    }
}

fn finish(body, moves: Lowered, checked: Bool) → Option<List<Instruction>> {
    match checked { False => None, True => Some(body.code ++ moves.code) }
}

// The region's code: its inputs in `inputs`, one placement register per
// node, its outputs left in `outputs`. `None` is a refusal: an unsupported
// node, or a placement that overwrote a value still needed.
fn Region::lower(self region: Region, inputs, outputs: List<Gpr>, placement: List<Place>) → Option<List<Instruction>> {
    match input_file(region.inputs.entries, inputs) {
        None => None,
        Some(file) => match lower_nodes(region.nodes, placement, file) {
            None => None,
            Some(body) => match body.file.move_outputs(region.outputs.entries, outputs) {
                None => None,
                Some(moves) => finish(body, moves,
                    moves.file.outputs_check(region.outputs.entries, outputs)),
            },
        },
    }
}

// What the code does: from inputs in their registers and the region's
// equations, its outputs in theirs.
fn Computes<M>(region: Region, inputs, outputs: List<Gpr>, values: Valuation(),
    code: List<Instruction>) → Type
{
    (s: MachineState<M>) → PortsAt(values, region.inputs.entries, inputs, s.gprs) →
        RegionHolds(region, values) →
        PortsAt(values, region.outputs.entries, outputs, execute_block_normal(code, s).gprs)
}

fn MayCompute<M>(region: Region, inputs, outputs: List<Gpr>, values: Valuation(),
    code: Option<List<Instruction>>) → Type
{
    code.All(λ (c: List<Instruction>) => Computes<M>(region, inputs, outputs, values, c))
}

theorem finish_computes<M>(region: Region, inputs, outputs: List<Gpr>, values: Valuation(),
    file: File, body, moves: Lowered,
    entered: (s: MachineState<M>) → PortsAt(values, region.inputs.entries, inputs, s.gprs) →
        file.Represents(values, s.gprs),
    body_keeps: Keeps<M>(values, file, RegionHolds(region, values), body),
    moves_keeps: Keeps<M>(values, body.file, True, moves), checked: Bool):
    (checked.IsTrue() → (gprs: Gprs) → moves.file.Represents(values, gprs) →
        PortsAt(values, region.outputs.entries, outputs, gprs)) →
    MayCompute<M>(region, inputs, outputs, values,
        finish(body, moves, checked))
{
    match checked {
        False => λ _ => trivial,
        True => λ sound s placed holds =>
            sound(trivial, execute_block_normal(body.code ++ moves.code, s).gprs,
                keeps_then<M>(values, file, True, body, moves,
                    λ s0 r0 _ => body_keeps(s0, r0, holds), moves_keeps,
                    s, entered(s, placed), trivial)),
    }
}

theorem Region::lower_computes<M>(self region: Region, values: Valuation(),
    inputs, outputs: List<Gpr>, placement: List<Place>):
    MayCompute<M>(region, inputs, outputs, values,
        region.lower(inputs, outputs, placement))
{
    (match input_file(region.inputs.entries, inputs) as λ entry =>
        ((s: MachineState<M>) → PortsAt(values, region.inputs.entries, inputs, s.gprs) →
            entry.All(λ (file: File) => file.Represents(values, s.gprs))) →
        MayCompute<M>(region, inputs, outputs, values,
            match entry {
                None => None,
                Some(file) => match lower_nodes(region.nodes, placement, file) {
                    None => None,
                    Some(body) => match body.file.move_outputs(region.outputs.entries, outputs) {
                        None => None,
                        Some(moves) => finish(body, moves,
                            moves.file.outputs_check(region.outputs.entries, outputs)),
                    },
                },
            }) {
        None => λ _ => trivial,
        Some(file) => λ entered =>
            (match lower_nodes(region.nodes, placement, file) as λ lowered =>
                MayKeep<M>(values, file, RegionHolds(region, values), lowered) →
                MayCompute<M>(region, inputs, outputs, values,
                    match lowered {
                        None => None,
                        Some(body) => match body.file.move_outputs(region.outputs.entries, outputs) {
                            None => None,
                            Some(moves) => finish(body, moves,
                                moves.file.outputs_check(region.outputs.entries, outputs)),
                        },
                    }) {
                None => λ _ => trivial,
                Some(body) => λ body_keeps =>
                    (match body.file.move_outputs(region.outputs.entries, outputs) as λ moved =>
                        MayKeep<M>(values, body.file, True, moved) →
                        MayCompute<M>(region, inputs, outputs, values,
                            match moved {
                                None => None,
                                Some(moves) => finish(body, moves,
                                    moves.file.outputs_check(region.outputs.entries, outputs)),
                            }) {
                        None => λ _ => trivial,
                        Some(moves) => λ moves_keeps =>
                            finish_computes<M>(region, inputs, outputs, values, file, body, moves,
                                entered, body_keeps, moves_keeps,
                                moves.file.outputs_check(region.outputs.entries, outputs),
                                λ checked gprs represents =>
                                    outputs_check_sound(values, moves.file, gprs, represents,
                                        region.outputs.entries, outputs, checked)),
                    })(move_outputs_keeps<M>(values, region.outputs.entries, body.file, outputs)),
            })(lower_nodes_keeps<M>(values, region.nodes, placement, file)),
    })(λ s placed => input_file_represents(values, s.gprs, region.inputs.entries, inputs, placed))
}

// The theorem, proved once: whatever the placement, code `lower_region`
// returns computes the region.
theorem Region::lower_correct<M>(self region: Region, inputs, outputs: List<Gpr>, placement: List<Place>,
    code: List<Instruction>, values: Valuation(), s: MachineState<M>,
    lowered: region.lower(inputs, outputs, placement) = Some(code),
    placed: PortsAt(values, region.inputs.entries, inputs, s.gprs),
    holds: RegionHolds(region, values)):
    PortsAt(values, region.outputs.entries, outputs, execute_block_normal(code, s).gprs)
{
    region.lower(inputs, outputs, placement).all_some(λ (c: List<Instruction>) => Computes<M>(region, inputs, outputs, values, c), code, lowered,
        region.lower_computes<M>(values, inputs, outputs, placement), s, placed, holds)
}

// ---------------------------------------------------------------------------
// A placement heuristic. Nothing above depends on it: a poor choice costs a
// MOV or a refusal, never a wrong program.

fn Node::reads(self node: Node) → List<Nat> {
    match node {
        Const(_, _, _) => [],
        Move(_, _, source) => [source],
        Add(_, _, left, right) => [left, right],
        Sub(_, _, left, right) => [left, right],
        BitAnd(_, _, left, right) => [left, right],
        BitOr(_, _, left, right) => [left, right],
        BitXor(_, _, left, right) => [left, right],
        ShiftLeft(_, _, value, _) => [value],
        LogicalShiftRight(_, _, value, _) => [value],
        ArithmeticShiftRight(_, _, value, _) => [value],
        UnsignedLessThan(_, _, left, right) => [left, right],
        SignedLessThan(_, _, left, right) => [left, right],
        Equal(_, _, left, right) => [left, right],
        BufferLoad(_, _, index) => [index],
        BufferStore(_, _, index, value) => [index, value],
        Resize(_, _, _, source) => [source],
        SignResize(_, _, _, source) => [source],
        TableRead(_, _, _, index, _) => [index],
        WideLoad(_, _, _, index) => [index],
        WideStore(_, _, _, index, value) => [index, value],
        ByteSwap(_, _, source) => [source],
        RotateRight(_, _, value, _) => [value],
    }
}

fn mentions(ids: List<Nat>, id: Nat) → Bool {
    match ids { Nil => False, Cons(here, rest) => here.same(id) || mentions(rest, id) }
}

fn port_ids(entries: List<Port>) → List<Nat> {
    match entries { Nil => [], Cons(port, rest) => Cons(port.id, port_ids(rest)) }
}

// Every id the nodes read, then the outputs: what is live before them.
fn reads_of(nodes: List<Node>, outputs: List<Nat>) → List<Nat> {
    match nodes { Nil => outputs, Cons(node, rest) => node.reads() ++ reads_of(rest, outputs) }
}

// Liveness is asked as a predicate on ids, so a caller answers it from
// whatever it keeps: a list scanned (`mentions`), or a set
// (`function_ir_lower_structured`'s counted reads).
fn slot_free(slot: Option<Held>, live: Nat → Bool) → Bool {
    match slot { None => True, Some(held) => !live(held.id) }
}

// The SysV caller-saved registers, the only ones the heuristic writes.
fn scratch_pool() → List<Gpr> { [Rax, Rcx, Rdx, Rsi, Rdi, R8, R9, R10, R11] }

fn Gpr::listed(self register: Gpr, pool: List<Gpr>) → Bool {
    match pool { Nil => False, Cons(other, rest) => register.same(other) || register.listed(rest) }
}

fn File::first_free(self file: File, live: Nat → Bool, pool: List<Gpr>) → Option<Gpr> {
    match pool {
        Nil => None,
        Cons(register, rest) => match slot_free(file.at(register), live) {
            True => Some(register),
            False => file.first_free(live, rest),
        },
    }
}

// A free register of `pool` that is none of `kept`, else the first free
// one. The planner keeps clear the registers something is wanted in where
// a first plan of a branch lost a value (`StructuredRegion::plan_in`).
fn File::first_unkept(self file: File, live: Nat → Bool, pool, kept: List<Gpr>) → Option<Gpr> {
    match pool {
        Nil => None,
        Cons(register, rest) => match !register.listed(kept) && slot_free(file.at(register), live) {
            True => Some(register),
            False => file.first_unkept(live, rest, kept),
        },
    }
}

fn File::first_spare(self file: File, live: Nat → Bool, pool, kept: List<Gpr>) → Option<Gpr> {
    match kept {
        Nil => file.first_free(live, pool),
        Cons(_, _) => match file.first_unkept(live, pool, kept) { None => file.first_free(live, pool), Some(register) => Some(register) },
    }
}

fn target_of(id: Nat, entries: List<Port>, registers: List<Gpr>) → Option<Gpr> {
    match entries {
        Nil => None,
        Cons(port, rest) => match registers {
            Nil => None,
            Cons(register, later) => match port.id.same(id) {
                True => Some(register),
                False => target_of(id, rest, later),
            },
        },
    }
}

fn Node::output_id(self node: Node) → Nat { node_output(node).id }

// The register that holds `id` zero-extended at a narrow width, if one does.
fn File::narrow_at(self file: File, id: Nat, registers: List<Gpr>) → Option<Gpr> {
    match registers {
        Nil => None,
        Cons(register, rest) => match file.at(register) {
            None => file.narrow_at(id, rest),
            Some(held) => match held.kind {
                Narrow(_) => match held.id.same(id) { True => Some(register), False => file.narrow_at(id, rest) },
                _ => file.narrow_at(id, rest),
            },
        },
    }
}

fn Node::in_place(self node: Node, file: File, later: Nat → Bool) → Option<Gpr> {
    match node.reads() {
        Nil => None,
        Cons(left, _) => match later(left) {
            True => None,
            False => match file.find(Held(left, Word)) {
                None => file.narrow_at(left, search_order()),
                Some(found) => Some(found.register),
            },
        },
    }
}

// Nodes cheapest in their first operand's register: arithmetic writes it
// in place, and a `Move` or a `Resize` there is only a retag or a settling
// (a call's result taken where the call left it).
fn prefers_operand(node: Node) → Bool {
    match node {
        Add(_, _, _, _) => True, Sub(_, _, _, _) => True, BitAnd(_, _, _, _) => True,
        BitOr(_, _, _, _) => True, BitXor(_, _, _, _) => True, Move(_, _, _) => True,
        Resize(_, _, _, _) => True, ByteSwap(_, _, _) => True, RotateRight(_, _, _, _) => True, _ => False,
    }
}

// The first of `registers` that holds `id`, at any kind.
fn File::holder(self file: File, id: Nat, registers: List<Gpr>) → Option<Gpr> {
    match registers {
        Nil => None,
        Cons(register, rest) => match file.at(register) {
            None => file.holder(id, rest),
            Some(held) => match held.id.same(id) { True => Some(register), False => file.holder(id, rest) },
        },
    }
}

// The operands in whose register the node's code can leave its result:
// the first of arithmetic and of a move (written in place), and either of
// a comparison of words, which reads both before it clears the bit's
// register (`File::compare_over`).
fn Node::overwritable(self node: Node) → List<Nat> {
    match node {
        UnsignedLessThan(width, _, left, right) => match width.same(64) { True => [left, right], False => [] },
        SignedLessThan(width, _, left, right) => match width.same(64) { True => [left, right], False => [] },
        Equal(width, _, left, right) => match width.same(64) { True => [left, right], False => [] },
        _ => match prefers_operand(node) { False => [], True => node.reads().take(1) },
    }
}

// The register of the first of `operands` that is not read `later`: one
// of `pool`, or RAX where the output may be there (`rax`).
fn File::dying_of(self file: File, operands: List<Nat>, later: Nat → Bool, pool: List<Gpr>, rax: Bool) → Option<Gpr> {
    match operands {
        Nil => None,
        Cons(operand, rest) => match later(operand) {
            True => file.dying_of(rest, later, pool, rax),
            False => match file.holder(operand, search_order()) {
                None => file.dying_of(rest, later, pool, rax),
                Some(register) => match register.listed(pool) || (register.same(Rax) && rax) {
                    True => Some(register),
                    False => file.dying_of(rest, later, pool, rax),
                },
            },
        },
    }
}

// Where a callee-saved register comes in the order a function saves them
// (`kept_order`, function_ir_lower_reads), from one; none for a register a
// function does not save.
fn Gpr::save_rank(self register: Gpr) → Nat {
    match register { R12 => 1, R13 => 2, R14 => 3, R15 => 4, Rbx => 5, Rbp => 6, _ => 0 }
}

// A pool's registers a function need not save, and the ones it must.
fn pool_unsaved(pool: List<Gpr>) → List<Gpr> {
    match pool {
        Nil => [],
        Cons(register, rest) => match register.save_rank() { Zero => Cons(register, pool_unsaved(rest)), Succ(_) => pool_unsaved(rest) },
    }
}
fn pool_saved(pool: List<Gpr>) → List<Gpr> {
    match pool {
        Nil => [],
        Cons(register, rest) => match register.save_rank() { Zero => pool_saved(rest), Succ(_) => Cons(register, pool_saved(rest)) },
    }
}

// Where a node goes at no cost when no register of the pool that needs no
// save is free: RAX if nothing live is there and the output is not read
// after a later call, else the register of an operand that dies at the
// node and that its code can write over.
fn Node::crowded_in(self node: Node, file: File, live, later, crossed: Nat → Bool, pool: List<Gpr>) → Option<Gpr> {
    match slot_free(file.at(Rax), live) && !crossed(node.output_id()) {
        True => Some(Rax),
        False => file.dying_of(node.overwritable(), later, pool, !crossed(node.output_id())),
    }
}

// The same as a register: RAX where there is none, and the lowering will
// refuse what is lost.
fn Node::crowded(self node: Node, file: File, live, later, crossed: Nat → Bool, pool: List<Gpr>) → Gpr {
    match node.crowded_in(file, live, later, crossed, pool) { None => Rax, Some(register) => register }
}

// A register for a new value: the first free one of `pool` that a function
// need not save, none of `kept` when one is free apart from them; else
// what `crowded_in` finds; else the first free callee-saved register of
// `pool`, which costs its function a save (`Saving`,
// function_ir_lower_calls); else RAX.
//
// A value `keeps` names (read after a later call, on a path every run of
// the function takes) tries the callee-saved ones first: in a caller-saved register it costs a store and a load at every
// call it lives across, in a saved one a store and a load for the whole
// function, which its frame already has room for
// (issues/function-ir-values-in-kept-registers.md).
fn Node::fresh(self node: Node, file: File, live, later, crossed, keeps: Nat → Bool, pool, kept: List<Gpr>) → Gpr {
    let unsaved_first = match file.first_spare(live, pool_unsaved(pool), kept) {
        Some(register) => register,
        None => match node.crowded_in(file, live, later, crossed, pool) {
            Some(register) => register,
            None => match file.first_spare(live, pool_saved(pool), kept) { None => Rax, Some(register) => register },
        },
    };
    match keeps(node.output_id()) {
        False => unsaved_first,
        True => match file.first_spare(live, pool_saved(pool), kept) { None => unsaved_first, Some(register) => register },
    }
}

// The output's own register if it is free; else, for arithmetic and moves,
// the first operand's register when the operand dies here and it is in
// `pool`, or is RAX and the output is not read after a later call
// (`crossed`; a call's result lands in RAX); else what `fresh` finds.
//
// `live` is what is read by the node or after it, `later` what is read
// after it, and `crossed` what is read after a later call.
// The values that prefer a callee-saved register are `keeps` (`Node::fresh`).
fn Node::choose_keeping(self node: Node, file: File, live, later: Nat → Bool, entries: List<Port>,
    registers, pool: List<Gpr>, crossed, keeps: Nat → Bool, kept: List<Gpr>) → Gpr
{
    let fresh = node.fresh(file, live, later, crossed, keeps, pool, kept);
    // A value that prefers a saved register keeps the one `fresh` found
    // rather than its operand's, which a call would store round.
    let reuse = match prefers_operand(node) && !(keeps(node.output_id()) && !fresh.save_rank().same(0)) {
        False => fresh,
        True => match node.in_place(file, later) {
            None => fresh,
            Some(r) => match r.listed(pool) || (r.same(Rax) && !crossed(node.output_id())) {
                True => r,
                False => fresh,
            },
        },
    };
    match target_of(node.output_id(), entries, registers) {
        None => reuse,
        Some(target) => match slot_free(file.at(target), live) { True => target, False => reuse },
    }
}

// `choose_keeping` where every value read after a later call prefers a
// callee-saved register.
fn Node::choose_by(self node: Node, file: File, live, later: Nat → Bool, entries: List<Port>,
    registers, pool: List<Gpr>, crossed: Nat → Bool, kept: List<Gpr>) → Gpr
{
    node.choose_keeping(file, live, later, entries, registers, pool, crossed, crossed, kept)
}

// `choose_by` with what is read later, and after a later call, as lists.
fn Node::choose_from(self node: Node, file: File, later: List<Nat>, entries: List<Port>,
    registers, pool: List<Gpr>, crossed: List<Nat>) → Gpr
{
    node.choose_by(file, λ (id: Nat) => function_ir_lower::mentions(node.reads() ++ later, id),
        λ (id: Nat) => function_ir_lower::mentions(later, id), entries, registers, pool,
        λ (id: Nat) => function_ir_lower::mentions(crossed, id), [])
}

fn Node::choose(self node: Node, file: File, later: List<Nat>, entries: List<Port>,
    registers: List<Gpr>) → Gpr
{
    node.choose_from(file, later, entries, registers, scratch_pool(), [])
}

fn plan_nodes(nodes: List<Node>, file: File, entries: List<Port>, registers: List<Gpr>) → List<Place> {
    match nodes {
        Nil => [],
        Cons(node, rest) => {
            let later = reads_of(rest, port_ids(entries));
            let destination = node.choose(file, later, entries, registers);
            match node.lower(destination, file) {
                None => [Into(destination)],
                Some(step) => Cons(Into(destination), plan_nodes(rest, step.file, entries, registers)),
            }
        },
    }
}

fn Region::plan(self region: Region, inputs, outputs: List<Gpr>) → List<Place> {
    match input_file(region.inputs.entries, inputs) {
        None => [],
        Some(file) => plan_nodes(region.nodes, file, region.outputs.entries, outputs),
    }
}

// The region lowered with the heuristic's placement.
fn Region::lower_planned(self region: Region, inputs, outputs: List<Gpr>) → Option<List<Instruction>> {
    region.lower(inputs, outputs, region.plan(inputs, outputs))
}

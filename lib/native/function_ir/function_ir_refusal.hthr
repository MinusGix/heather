// Where the verified lowering refuses a function with a placement: the
// way to the node, call or loop edge `Function::emit_lent` has no code
// for, the place the node was given, and what each register held there.
//
// `heather compile-x86` evaluates `Function::refused` when its emission of
// a function is `None`, so that its refusal says where. Nothing here is
// part of a theorem: these functions mirror the emitter's tests
// (`StructuredRegion::emit_calls`, `File::emit_call`, `File::emit_lend`, `Emitted::loop_close`)
// and answer text. The lowering is right to refuse a placement it cannot
// check, and the placement is untrusted search (`Node::choose_by`,
// `StructuredRegion::plan_in`), so what is found is usually the planner's
// and not the function's (issues/function-ir-planner-register-pressure.md).
// `StructuredRegion::shown` writes a region's nodes and calls in the order
// they are emitted, to read a report against.
import function_ir;
import function_ir_operation;
import function_ir_eval;
import function_ir_state;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_views;
import function_ir_lower_calls;
import function_ir_compile;
import function_ir_writes;
import function_ir_spelled;
import x86_64;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_kept;
import x86_64_block;
import x86_64_stack;
import x86_64_lending;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import string;
import utf8;

// By long division (`decimal`): a loop's bound is a number of sixty-four
// bits, and `decimal_name` divides by counting up to it.
fn refusal_number(n: Nat) → String { decimal(n) }

fn refusal_numbers(ns: List<Nat>) → String {
    match ns {
        Nil => "",
        Cons(n, rest) => match rest { Nil => refusal_number(n), Cons(_, _) => refusal_number(n) ++ ", " ++ refusal_numbers(rest) },
    }
}

fn Gpr::shown(self register: Gpr) → String {
    match register {
        Rax => "rax", Rcx => "rcx", Rdx => "rdx", Rbx => "rbx", Rsp => "rsp", Rbp => "rbp", Rsi => "rsi", Rdi => "rdi",
        R8 => "r8", R9 => "r9", R10 => "r10", R11 => "r11", R12 => "r12", R13 => "r13", R14 => "r14", R15 => "r15",
    }
}

fn Place::shown(self place: Place) → String {
    match place { Into(register) => register.shown(), Folded => "folded", Saving(count) => "saving " ++ refusal_number(count), CallSlots(count) => refusal_number(count) ++ " call slots", Spilling(mask) => "spilling " ++ refusal_number(mask), Short(name) => "short jumps to " ++ refusal_number(name) }
}

// What is wrong with a place whatever the node: a callee-saved register
// the function's count of saves does not cover (`body_kept`), or the count
// itself, which is read at a function's head only.
fn Place::unsaved(self place: Place, saves: Nat) → String {
    match place {
        Into(register) => match register.save_rank() {
            Zero => "",
            Succ(below) => match (below + 1).leb(saves) {
                True => "",
                False => " (callee-saved, and the function saves " ++ refusal_number(saves) ++ ")",
            },
        },
        Folded => "",
        Saving(_) => " (a count of saves, which is no node's place)",
        CallSlots(_) => " (a count of call slots, which is no node's place)", Short(_) => " (a label whose jumps are short, which is no node's place)",
        Spilling(_) => " (what a call saves, which is no node's place)",
    }
}

fn binary_shown(name: String, w, o, a, b: Nat) → String {
    refusal_number(o) ++ " = " ++ name ++ refusal_number(w) ++ " " ++ refusal_number(a) ++ ", " ++ refusal_number(b)
}

// A node as `output = operation width operands`, values by their ids.
fn Node::shown(self node: Node) → String {
    match node {
        Const(w, o, v) => refusal_number(o) ++ " = const" ++ refusal_number(w) ++ " " ++ refusal_number(v),
        Move(w, o, a) => refusal_number(o) ++ " = move" ++ refusal_number(w) ++ " " ++ refusal_number(a),
        Add(w, o, a, b) => binary_shown("add", w, o, a, b),
        Sub(w, o, a, b) => binary_shown("sub", w, o, a, b),
        BitAnd(w, o, a, b) => binary_shown("and", w, o, a, b),
        BitOr(w, o, a, b) => binary_shown("or", w, o, a, b),
        BitXor(w, o, a, b) => binary_shown("xor", w, o, a, b),
        ShiftLeft(w, o, a, b) => binary_shown("shl", w, o, a, b),
        LogicalShiftRight(w, o, a, b) => binary_shown("shr", w, o, a, b),
        RotateRight(w, o, a, b) => binary_shown("ror", w, o, a, b),
        Apply(op, w, o, a, b) => binary_shown(op.name(), w, o, a, b),
        ArithmeticShiftRight(w, o, a, b) => binary_shown("sar", w, o, a, b),
        UnsignedLessThan(w, o, a, b) => binary_shown("below", w, o, a, b),
        SignedLessThan(w, o, a, b) => binary_shown("less", w, o, a, b),
        Equal(w, o, a, b) => binary_shown("equal", w, o, a, b),
        BufferLoad(o, b, i) => refusal_number(o) ++ " = load buffer " ++ refusal_number(b) ++ " at " ++ refusal_number(i),
        BufferStore(o, b, i, v) =>
            refusal_number(o) ++ " = store buffer " ++ refusal_number(b) ++ " at " ++ refusal_number(i) ++ " of " ++ refusal_number(v),
        Resize(f, t, o, a) => refusal_number(o) ++ " = resize" ++ refusal_number(f) ++ "to" ++ refusal_number(t) ++ " " ++ refusal_number(a),
        SignResize(f, t, o, a) =>
            refusal_number(o) ++ " = sign_resize" ++ refusal_number(f) ++ "to" ++ refusal_number(t) ++ " " ++ refusal_number(a),
        TableRead(w, o, k, i, entries) => refusal_number(o) ++ " = table" ++ refusal_number(w) ++ " of " ++ refusal_number(entries.len())
            ++ " at " ++ refusal_number(i) ++ " (" ++ refusal_number(k) ++ " bits)",
        WideLoad(n, o, b, i) => refusal_number(o) ++ " = load" ++ refusal_number(n) ++ "bytes of buffer " ++ refusal_number(b) ++ " at " ++ refusal_number(i),
        WideStore(n, o, b, i, v) => refusal_number(o) ++ " = store" ++ refusal_number(n) ++ "bytes to buffer " ++ refusal_number(b) ++ " at "
            ++ refusal_number(i) ++ " of " ++ refusal_number(v),
        ByteSwap(w, o, a) => refusal_number(o) ++ " = byte_swap" ++ refusal_number(w) ++ " " ++ refusal_number(a),
    }
}

fn nodes_shown(nodes: List<Node>) → String {
    match nodes { Nil => "", Cons(node, rest) => node.shown() ++ "; " ++ nodes_shown(rest) }
}

fn Kind::shown(self kind: Kind) → String {
    match kind { Word => "", Bit => " (a bit)", Narrow(w) => " (" ++ refusal_number(w) ++ " bits)", Low(w) => " (low " ++ refusal_number(w) ++ " bits)" }
}

// The registers of `registers` that hold a value, each with its value.
fn File::shown_in(self file: File, registers: List<Gpr>) → String {
    match registers {
        Nil => "",
        Cons(register, rest) => match file.at(register) {
            None => file.shown_in(rest),
            Some(held) => register.shown() ++ " holds " ++ refusal_number(held.id) ++ held.kind.shown() ++ "; " ++ file.shown_in(rest),
        },
    }
}

fn File::shown(self file: File) → String { file.shown_in(scratch_pool() ++ kept_order()) }

// A call's views: each a window of a buffer, marked where the callee may
// store into it.
fn View::shown(self view: View) → String {
    "buffer " ++ refusal_number(view.buffer) ++ " from " ++ refusal_number(view.start) ++ " to " ++ refusal_number(view.end)
        ++ (match view.written { False => "", True => " written" })
}

fn views_shown(views: List<View>) → String {
    match views {
        Nil => "",
        Cons(view, rest) => view.shown() ++ (match rest { Nil => "", Cons(_, _) => ", " }) ++ views_shown(rest),
    }
}

// A region's nodes and calls in the order they are emitted.
fn StructuredRegion::shown(self region: StructuredRegion) → String {
    match region {
        Dataflow(body) => nodes_shown(body.nodes),
        Sequence(prefix, continuation) => nodes_shown(prefix.nodes) ++ continuation.shown(),
        Compose(prefix, continuation) => prefix.shown() ++ continuation.shown(),
        Conditional(_, condition, _, _, when_true, when_false) =>
            "if " ++ refusal_number(condition) ++ " { " ++ when_true.shown() ++ "} else { " ++ when_false.shown() ++ "} ",
        Lend(views, callee, arguments, result) =>
            refusal_number(result) ++ " = call function " ++ refusal_number(callee) ++ " over views (" ++ views_shown(views) ++ ") ("
                ++ refusal_numbers(arguments) ++ "); ",
        Call(callee, arguments, result, also) =>
            refusal_numbers(Cons(result, also)) ++ " = call function " ++ refusal_number(callee) ++ " (" ++ refusal_numbers(arguments) ++ "); ",
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) =>
            "loop (state " ++ refusal_numbers(parameters) ++ " from " ++ refusal_numbers(inputs) ++ "; next " ++ refusal_numbers(next)
                ++ "; count " ++ refusal_number(count) ++ "; exit " ++ refusal_number(exit) ++ ") { " ++ body.shown() ++ "} ",
    }
}

// The first node of a block that `emit_leaf` has no code for after the
// ones `before` it, with its place and the file the ones before it leave.
fn leaf_refusal(saves: Nat, prog: Prog, file: File, before, rest: List<Node>, placement: List<Place>, names: Nat, homes: List<Lent>) → String {
    match rest {
        Nil => "a block of nodes, registers: " ++ file.shown(),
        Cons(node, later) => match emit_leaf(saves, prog, file, before ++ [node], placement, names, homes) {
            Some(_) => leaf_refusal(saves, prog, file, before ++ [node], later, placement, names, homes),
            None => "the node `" ++ node.shown() ++ "`, placed "
                ++ (match placement.nth(before.len()) {
                    None => "nowhere (the placement ran out)",
                    Some(place) => "in " ++ place.shown() ++ place.unsaved(saves),
                })
                ++ ", where " ++ (match emit_leaf(saves, prog, file, before, placement, names, homes) { None => file.shown(), Some(left) => left.file.shown() }),
        },
    }
}

// `File::emit_call`, saying which of its tests refuses.
fn File::call_refusal(self file: File, slots: Nat, placement: List<Place>, callee: Nat, arguments: List<Nat>, bound: Nat, counts: List<Nat>,
    homes: List<Lent>) → String {
    let call = "the call of function " ++ refusal_number(callee) ++ " (" ++ refusal_numbers(arguments) ++ "): ";
    let staged = file.write(Rsp, None);
    let order = staged.call_moves(arguments.take(6));
    match saves_ok(slots, call_saves(placement)) {
        False => call ++ "it saves " ++ refusal_number(call_saves(placement).len()) ++ " registers around it, and the frame has "
            ++ refusal_number(slots) ++ " slots for them",
        True => match (callee + 1).leb(bound) {
            False => call ++ "the callee is not below this function",
            True => match args_lend(homes, lent_count(counts, callee), 0, arguments) {
                False => call ++ "its leading arguments are not the homes of the buffers the callee is lent",
                True => match arguments.drop(6).len().leb(2) {
                    False => call ++ "it passes " ++ refusal_number(arguments.len()) ++ " words, and a call passes at most eight: six in registers and two on the stack",
                    True => match staged.sources(arguments.drop(6)) {
                        None => call ++ "a word past the sixth is in no register, where " ++ staged.shown(),
                        Some(sources) => match sources.len().same(arguments.drop(6).len()) && staged.outputs_check(word_ports(arguments.drop(6)), sources) {
                            False => call ++ "the words past the sixth are not in the registers found for them, where " ++ staged.shown(),
                            True => match staged.move_outputs(ArgumentMove::ports(order), ArgumentMove::registers(order)) {
                                None => call ++ "an argument is in no register, where " ++ staged.shown(),
                                Some(moves) => match moves.file.outputs_check(word_ports(arguments.take(6)), argument_registers()) {
                                    False => call ++ "the moves do not leave the arguments in their registers, where " ++ staged.shown(),
                                    True => match leaves_all(moves.code, callee_saved()) {
                                        False => call ++ "a move writes a callee-saved register",
                                        True => call ++ "no test of the call refuses",
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    }
}

// The first view of a call over views the scope cannot lend
// (`View::lendable`), and which of its tests says so.
fn views_refusal(views: List<View>, file: File, homes: List<Lent>) → String {
    match views {
        Nil => "no view is refused",
        Cons(view, rest) => match view.lendable(file, homes) {
            True => views_refusal(rest, file, homes),
            False => {
                let named = "its view of buffer " ++ refusal_number(view.buffer) ++ " from " ++ refusal_number(view.start) ++ " to "
                    ++ refusal_number(view.end);
                match homes_length(homes, view.buffer, view.home) {
                    None => named ++ ": the scope has no home of that buffer at " ++ refusal_number(view.home),
                    Some(length) => match file.zero(view.start) || file.at_most(view.start, view.end) {
                        False => named ++ ": no arm taken on the way here says that its start is at most its end, and its start is not the constant 0",
                        True => named ++ ": no arm taken on the way here says that its end is at most the buffer's length "
                            ++ refusal_number(length) ++ ", and its end is not that length",
                    },
                }
            },
        },
    }
}

// The first two views of a call over views that share a buffer, one of
// them to write, and that the path does not know apart (`View::apart`).
fn View::apart_refusal(self view: View, rest: List<View>, file: File) → String {
    match rest {
        Nil => "no two views are refused",
        Cons(other, later) => match view.apart(other, file) {
            True => view.apart_refusal(later, file),
            False => "its views " ++ view.shown() ++ " and " ++ other.shown() ++ " share a buffer, and nothing says that one ends at most where the "
                ++ "other starts: neither's end is the other's start, no arm taken on the way here compares them, and they are not two constants in order",
        },
    }
}

fn views_apart_refusal(views: List<View>, file: File) → String {
    match views {
        Nil => "no two views are refused",
        Cons(view, rest) => match view.apart_from(rest, file) {
            True => views_apart_refusal(rest, file),
            False => view.apart_refusal(rest, file),
        },
    }
}

// `File::emit_lend`, saying which of its tests refuses.
fn File::lend_refusal(self file: File, saves: Nat, slots: Nat, prog: Prog, views: List<View>, callee: Nat, arguments: List<Nat>, placement: List<Place>,
    names, bound: Nat, counts: List<Nat>, homes: List<Lent>) → String {
    let call = "the call of function " ++ refusal_number(callee) ++ " over views (" ++ views_shown(views) ++ "): ";
    match emit_leaf(saves, prog, file, views_nodes(views), placement, names, homes) {
        None => call ++ "where its views' bases and lengths are bound, " ++ leaf_refusal(saves, prog, file, [], views_nodes(views), placement, names, homes),
        Some(first) => match views {
            Nil => call ++ "it has no view, and a call over none is written as a call",
            Cons(_, _) => match views_lendable(views, first.file, homes) {
                False => call ++ views_refusal(views, first.file, homes),
                True => match views_written_alone(views) {
                    False => call ++ "two views to write are of one buffer",
                    True => match views_apart(views, first.file) {
                        False => call ++ views_apart_refusal(views, first.file),
                        True => match (callee + 1).leb(bound) && !args_lend(views_lents(views), lent_count(counts, callee), 0, views_homes(views) ++ arguments) {
                            True => call ++ "the callee is lent more buffers than the call has views",
                            False => call ++ first.file.call_refusal(slots, first.placement, callee, views_homes(views) ++ arguments, bound, counts, views_lents(views)),
                        },
                    },
                },
            },
        },
    }
}

// `Emitted::loop_close`, saying which of its tests refuses.
fn Emitted::close_refusal(self pass: Emitted, registers: LoopRegisters, count, exit: Nat, next: List<Nat>) → String {
    let held = ", where " ++ pass.file.shown();
    match pass.file.find(Held(exit, Bit)) {
        None => "the end of a loop's pass: its exit bit " ++ refusal_number(exit) ++ " is in no register" ++ held,
        Some(_) => match pass.file.move_outputs(word_ports(next), registers.state) {
            None => "the end of a loop's pass: a next state word (" ++ refusal_numbers(next) ++ ") is in no register" ++ held,
            Some(_) => match pass.file.move_outputs(word_ports(Cons(count, next)), Cons(registers.counter, registers.state)) {
                None => "the end of a loop's pass: the count " ++ refusal_number(count) ++ " is in no register" ++ held,
                Some(_) => "the end of a loop's pass: the moves into the state's registers" ++ held,
            },
        },
    }
}

// `StructuredRegion::emit_calls`, answering the way to what it refuses.
fn StructuredRegion::refusal(self region: StructuredRegion, saves: Nat, slots: Nat, short: List<Nat>, prog: Prog, file: File, placement: List<Place>, names, bound: Nat,
    counts: List<Nat>, homes: List<Lent>) → String {
    match region {
        Dataflow(body) => leaf_refusal(saves, prog, file, [], body.nodes, placement, names, homes),
        Sequence(prefix, continuation) => match emit_leaf(saves, prog, file, prefix.nodes, placement, names, homes) {
            None => leaf_refusal(saves, prog, file, [], prefix.nodes, placement, names, homes),
            Some(first) => continuation.refusal(saves, slots, short, first.prog, first.file, first.placement, first.names, bound, counts, homes),
        },
        Compose(prefix, continuation) => match prefix.emit_calls(saves, slots, short, prog, file, placement, names, bound, counts, homes) {
            None => prefix.refusal(saves, slots, short, prog, file, placement, names, bound, counts, homes),
            Some(first) => continuation.refusal(saves, slots, short, first.prog, first.file, first.placement, first.names, bound, counts, prefix.lends(homes)),
        },
        Conditional(_, condition, _, _, when_true, when_false) => match file.branch_test(condition) {
            None => "the branch on " ++ refusal_number(condition) ++ ": its bit is in no register, where " ++ file.shown(),
            Some(tested) => match when_true.emit_calls(saves, slots, short, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)), file.know(Truth(condition)), placement,
                names + 2, bound, counts, homes) {
                None => "where " ++ refusal_number(condition) ++ " is true, " ++ when_true.refusal(saves, slots, short, prog.branched_by(tested.test, names + 1, shorts(short, names + 1)),
                    file.know(Truth(condition)), placement, names + 2, bound, counts, homes),
                Some(yes) => match when_false.emit_calls(saves, slots, short, yes.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), yes.placement, yes.names,
                    bound, counts, homes) {
                    None => "where " ++ refusal_number(condition) ++ " is false, " ++ when_false.refusal(saves, slots, short,
                        yes.prog.else_label_by(names + 1, names + 2, shorts(short, names + 2)), file.know(Falsity(condition)), yes.placement, yes.names, bound, counts, homes),
                    Some(no) => "where the arms of the branch on " ++ refusal_number(condition) ++ " meet: after the true arm "
                        ++ yes.file.shown() ++ "and after the false arm " ++ no.file.shown(),
                },
            },
        },
        Lend(views, callee, arguments, _) => file.lend_refusal(saves, slots, prog, views, callee, arguments, placement, names, bound, counts, homes),
        Call(callee, arguments, _, _) => file.call_refusal(slots, placement, callee, arguments, bound, counts, homes),
        Loop(inputs, limit, parameters, count, body, exit, next, outputs, exhausted) =>
            match file.loop_entry(saves, inputs, limit, parameters, count, placement) {
                None => "the entry of a loop: its bound " ++ refusal_number(limit) ++ " or an input (" ++ refusal_numbers(inputs)
                    ++ ") is in no register, or its registers are not apart, where " ++ file.shown(),
                Some(entry) => match body.emit_calls(saves, slots, short, loop_tested(prog, entry, names, short), entry.head, entry.registers.rest,
                    names + 4, bound, counts, carried_homes(loop_carried(homes, inputs, parameters, next))) {
                    None => "in a loop's pass, " ++ body.refusal(saves, slots, short, loop_tested(prog, entry, names, short), entry.head, entry.registers.rest,
                        names + 4, bound, counts, carried_homes(loop_carried(homes, inputs, parameters, next))),
                    Some(pass) => match pass.loop_close(saves, entry.registers, count, exit, next, outputs, exhausted, names, short) {
                        None => pass.close_refusal(entry.registers, count, exit, next),
                        Some(_) => "nothing in the loop",
                    },
                },
            },
    }
}

// `Function::emit_lent` of function `k` after no code: what it refuses.
// The answer does not depend on the code before a function.
fn Function::refused(self function: Function, k: Nat, placement: List<Place>, names: Nat, counts: List<Nat>, rooms: Nat → Nat) → String {
    let saves = placement_saves(placement);
    let asked = placement_slots(placement);
    let short = placement_short(placement);
    let opened = function_opened(Start, k, function.loads(), function.slots(asked), saves);
    match function.lent.same(lent_count(counts, k)) {
        False => "the function is lent " ++ refusal_number(function.lent) ++ " buffers and the program's counts say "
            ++ refusal_number(lent_count(counts, k)),
        True => match function.roomy(rooms, k, asked, saves) {
            False => "the function's frame of " ++ refusal_number(function.frame(asked, saves)) ++ " bytes and its calls do not fit the room of "
                ++ refusal_number(rooms(k)) ++ " bytes its row of the room table gives it",
            True => match input_file(word_ports(function.parameters), parameter_registers()) {
                None => "the function has " ++ refusal_number(function.parameters.len())
                    ++ " parameters, and a function takes at most eight: six in registers and two on the stack",
                Some(file) => match function.body.emit_calls(saves, function.slots(asked), short, opened, file, placement_body(placement), names, k, counts, function.homes()) {
                    None => function.body.refusal(saves, function.slots(asked), short, opened, file, placement_body(placement), names, k, counts, function.homes()),
                    Some(body) => match function.closing(asked, saves, body) {
                        None => "the function's end: its result " ++ refusal_numbers(Cons(function.result, function.also))
                            ++ " cannot be moved into rax, rdx, rcx, … in order (a word lost, or a callee-saved register touched), where " ++ body.file.shown(),
                        Some(_) => "nothing: the function has code after no other",
                    },
                },
            },
        },
    }
}

fn bytes_numbers(bytes: List<BitVec(8)>) → List<Nat> {
    match bytes { Nil => [], Cons(byte, rest) => Cons(byte.toNat(), bytes_numbers(rest)) }
}

// The report as bytes, which is what the compiler's evaluator reads.
fn Function::refusal_bytes(self function: Function, k: Nat, names: Nat, counts: List<Nat>, rooms: Nat → Nat) → List<Nat> {
    bytes_numbers(utf8::encode(function.refused(k, function.plan(), names, counts, rooms)))
}

// The function's nodes and calls, as bytes.
fn Function::shown_bytes(self function: Function) → List<Nat> { bytes_numbers(utf8::encode(function.body.shown())) }

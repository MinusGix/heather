// A function of the IR spelled as the source that states it: what the
// compiler reads back when a search has made a function, to state it in a
// certificate as a literal. Nothing here is part of a theorem. A wrong
// spelling is a literal the certificate's own statements do not hold of.
//
// A spelling is numbers written in front of what follows them
// (`List<Nat> → List<Nat>`), so it costs its length. A number is a
// character's code, or `spell_mark()` and after it a number whose digits
// the reader writes: a digit made here is a long division, a step for each
// bit of the number it is of, and a function's spelling is mostly numbers.
// `spelled_text` is what the reader makes of one.
import function_ir;
import function_ir_operation;
import bool;
import char;
import list;
import nat;
import nat_map;
import option;
import string;

// The name a refusal or an explanation shows (here, beside the other
// spellings: `function_ir_operation` is read where text is not).
fn Operation::name(self op: Operation) → String {
    match op { Mul => "mul", ShlBy => "shl", ShrBy => "shr", UDiv => "udiv", URem => "urem" }
}

// The constructor's name, as a certificate spells the operation back.
fn Operation::constructor(self op: Operation) → String {
    match op { Mul => "Mul", ShlBy => "ShlBy", ShrBy => "ShrBy", UDiv => "UDiv", URem => "URem" }
}

fn spell_codes(chars: List<Char>, after: List<Nat>) → List<Nat> {
    match chars { Nil => after, Cons(c, rest) => Cons(c.code, spell_codes(rest, after)) }
}

fn spell_text(text: String) → List<Nat> → List<Nat> { λ after => spell_codes(text.chars, after) }

// No character's code in what is spelled here, which is ASCII.
fn spell_mark() → Nat { 256 }

fn spell_number(n: Nat) → List<Nat> → List<Nat> { λ after => Cons(spell_mark(), Cons(n, after)) }

fn spell_items(items: List<List<Nat> → List<Nat>>, after: List<Nat>) → List<Nat> {
    match items {
        Nil => after,
        Cons(item, rest) => match rest { Nil => item(after), Cons(_, _) => item(spell_text(", ", spell_items(rest, after))) },
    }
}

// `name(a, b)`, and a constructor of no fields as its name.
fn spell_call(name: String, fields: List<List<Nat> → List<Nat>>) → List<Nat> → List<Nat> {
    match fields { Nil => spell_text(name), Cons(_, _) => λ after => spell_text(name, spell_text("(", spell_items(fields, spell_text(")", after)))) }
}

fn spell_list(items: List<List<Nat> → List<Nat>>) → List<Nat> → List<Nat> {
    λ after => spell_text("[", spell_items(items, spell_text("]", after)))
}

fn spell_numbers(ns: List<Nat>) → List<Nat> → List<Nat> { spell_list(ns.map(spell_number)) }

// A constructor whose fields are numbers.
fn spell_of(name: String, ns: List<Nat>) → List<Nat> → List<Nat> { spell_call(name, ns.map(spell_number)) }

fn Bool::spelled(self b: Bool) → List<Nat> → List<Nat> { spell_text(match b { True => "True", False => "False" }) }

fn Node::spelled(self node: Node) → List<Nat> → List<Nat> {
    match node {
        Const(w, o, v) => spell_of("Const", [w, o, v]),
        Move(w, o, a) => spell_of("Move", [w, o, a]),
        Add(w, o, a, b) => spell_of("Add", [w, o, a, b]),
        Sub(w, o, a, b) => spell_of("Sub", [w, o, a, b]),
        BitAnd(w, o, a, b) => spell_of("BitAnd", [w, o, a, b]),
        BitOr(w, o, a, b) => spell_of("BitOr", [w, o, a, b]),
        BitXor(w, o, a, b) => spell_of("BitXor", [w, o, a, b]),
        ShiftLeft(w, o, a, b) => spell_of("ShiftLeft", [w, o, a, b]),
        LogicalShiftRight(w, o, a, b) => spell_of("LogicalShiftRight", [w, o, a, b]),
        RotateRight(w, o, a, b) => spell_of("RotateRight", [w, o, a, b]),
        Apply(op, w, o, a, b) => spell_call("Apply", Cons(spell_text(op.constructor()), [w, o, a, b].map(spell_number))),
        ArithmeticShiftRight(w, o, a, b) => spell_of("ArithmeticShiftRight", [w, o, a, b]),
        UnsignedLessThan(w, o, a, b) => spell_of("UnsignedLessThan", [w, o, a, b]),
        SignedLessThan(w, o, a, b) => spell_of("SignedLessThan", [w, o, a, b]),
        Equal(w, o, a, b) => spell_of("Equal", [w, o, a, b]),
        BufferLoad(o, b, i) => spell_of("BufferLoad", [o, b, i]),
        BufferStore(o, b, i, v) => spell_of("BufferStore", [o, b, i, v]),
        Resize(f, t, o, a) => spell_of("Resize", [f, t, o, a]),
        SignResize(f, t, o, a) => spell_of("SignResize", [f, t, o, a]),
        TableRead(w, o, n, i, es) => spell_call("TableRead", [spell_number(w), spell_number(o), spell_number(n), spell_number(i), spell_numbers(es)]),
        WideLoad(n, o, b, i) => spell_of("WideLoad", [n, o, b, i]),
        WideStore(n, o, b, i, v) => spell_of("WideStore", [n, o, b, i, v]),
        ByteSwap(w, o, a) => spell_of("ByteSwap", [w, o, a]),
    }
}

fn Ports::spelled(self ports: Ports) → List<Nat> → List<Nat> {
    spell_call("Ports", [spell_list(ports.entries.map(λ (port: Port) => spell_of("Port", [port.id, port.width])))])
}

fn Region::spelled(self region: Region) → List<Nat> → List<Nat> {
    spell_call("Region", [region.inputs.spelled(), spell_list(region.nodes.map(λ (node: Node) => node.spelled())), region.outputs.spelled()])
}

fn View::spelled(self view: View) → List<Nat> → List<Nat> {
    spell_call("View", [spell_number(view.buffer), spell_number(view.home), spell_number(view.start), spell_number(view.end),
        view.written.spelled(), spell_number(view.base), spell_number(view.length)])
}

fn StructuredRegion::spelled(self region: StructuredRegion) → List<Nat> → List<Nat> {
    match region {
        Dataflow(body) => spell_call("Dataflow", [body.spelled()]),
        Sequence(prefix, continuation) => spell_call("Sequence", [prefix.spelled(), continuation.spelled()]),
        Compose(prefix, continuation) => spell_call("Compose", [prefix.spelled(), continuation.spelled()]),
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => spell_call("Conditional",
            [inputs.spelled(), spell_number(condition), arguments.spelled(), outputs.spelled(), when_true.spelled(), when_false.spelled()]),
        Call(callee, arguments, result, also) => spell_call("Call", [spell_number(callee), spell_numbers(arguments), spell_number(result), spell_numbers(also)]),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => spell_call("Loop",
            [spell_numbers(inputs), spell_number(bound), spell_numbers(parameters), spell_number(count), body.spelled(), spell_number(exit),
                spell_numbers(next), spell_numbers(outputs), spell_number(exhausted)]),
        Lend(views, callee, arguments, result) => spell_call("Lend",
            [spell_list(views.map(λ (view: View) => view.spelled())), spell_number(callee), spell_numbers(arguments), spell_number(result)]),
        Until(inputs, parameters, body, exit, next, outputs, measure_at) => spell_call("Until",
            [spell_numbers(inputs), spell_numbers(parameters), body.spelled(), spell_number(exit), spell_numbers(next), spell_numbers(outputs), spell_number(measure_at)]),
    }
}

fn Function::spelled(self function: Function) → List<Nat> → List<Nat> {
    spell_call("Function", [spell_numbers(function.parameters), function.body.spelled(), spell_number(function.result),
        λ after => spell_text("lent := ")(spell_number(function.lent)(after)), λ after => spell_text("also := ")(spell_numbers(function.also)(after))])
}

// ---------------------------------------------------------------------------
// What the reader makes of a spelling

fn decimal_digit(d: Nat) → String { "0123456789".drop(d).take(1) }

// A number's decimal digits, by long division: a loop's bound is a number of
// sixty-four bits, and `Nat::div` counts up to its numerator.
fn decimal_digits(fuel, n: Nat, after: String) → String {
    match fuel {
        Zero => after,
        Succ(f) => shared(n.ldiv(10), λ parts => match parts.quot() {
            Zero => decimal_digit(parts.rem()) ++ after,
            Succ(_) => decimal_digits(f, parts.quot(), decimal_digit(parts.rem()) ++ after),
        }),
    }
}

// Forty digits: more than a word of any width the IR has.
fn decimal(n: Nat) → String { decimal_digits(40, n, "") }

// The character of a code: a line's end, or one of the ninety-five from a
// space on.
fn spelled_char(of: Nat) → String {
    match of.same(10) {
        True => "\n",
        False => " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~".drop(of - 32).take(1),
    }
}

fn spelled_from(marked: Bool, spelling: List<Nat>) → String {
    match spelling {
        Nil => "",
        Cons(n, rest) => match marked {
            True => decimal(n) ++ spelled_from(False, rest),
            False => match n.same(spell_mark()) { True => spelled_from(True, rest), False => spelled_char(n) ++ spelled_from(False, rest) },
        },
    }
}

// A spelling as the text the compiler states: each marked number in
// decimal, each code its character.
fn spelled_text(spelling: List<Nat>) → String { spelled_from(False, spelling) }

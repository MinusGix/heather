// Placeless functions: what a function returns does not depend on where
// the buffers lent to it lie.
//
// A function that reads a lent span takes the span's address as a word:
// buffer k's home is parameters 2k (address) and 2k+1 (length)
// (`function_ir_lower_reads`). Its meaning reads the buffer as a value
// (`program_eval_over`), so the address word is the lowering's alone. A
// caller that states the function with no address in hand (a program's
// tree, which has none) needs more than that the meaning *should* not read
// it: it needs evaluation to give the same answer at every address word.
//
// That is a fact about the function's text, checked here once: an address
// id reaches a call's address place or a loop's carried place and nothing
// else, so no node reads it, no branch tests it, no loop counts by it, and
// the result is not it. `placeless` is the check, linear in the region but
// for a loop nested in loops, whose taints its enclosing loops recompute;
// `program_eval_placeless` is the theorem
// (docs/native-one-compiler-design.md §2.3).
//
// A call over views computes addresses of its own: a view's base is its
// buffer's address plus its start. The base is hidden from there on as the
// address it is made from is, and reaches the callee at an address place;
// the view's bounds are read, so they are no address
// (docs/native-library-exports-design.md §3.1, V4d).
//
// A function that writes its buffer is placeless by the same check: a
// store reads its index and its value, neither of them an address id, and
// the file it leaves is a function of those. `program_run_placeless` is
// the theorem with the file threaded (`function_ir_run`): the word
// answered and the file left are the same at every address word (§2.6,
// U4 step 4b).

import bitvec_bytes;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import nat_map;
import bitvec;
import bool;
import list;
import list_window;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Valuations agreeing off a set of ids

// `other` agrees with `values` at every width, at every id not `hidden`.
fn Valuation::Apart(hidden: List<Nat>, values, other: Valuation()) → Type {
    (w: Nat) → (id: Nat) → absent(id, hidden).IsTrue() → other(w, id) = values(w, id)
}

theorem Valuation::apart_refl(hidden: List<Nat>, values: Valuation()): Valuation::Apart(hidden, values, values) {
    λ w id _ => refl
}

// Setting an id to values that agree keeps the agreement.
theorem Valuation::set_apart(hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other), id: Nat,
    value, value2: (w: Nat) → BitVec(w), at: (w: Nat) → value2(w) = value(w)):
    Valuation::Apart(hidden, Valuation::set(values, id, value), Valuation::set(other, id, value2)) {
    λ w query clear => match query.eq_dec(id) {
        Inl(_) => at(w),
        Inr(_) => apart(w, query, clear),
    }
}

// Setting an id to anything at all hides it.
theorem Valuation::set_hidden(hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other), id: Nat,
    value, value2: (w: Nat) → BitVec(w)):
    Valuation::Apart(Cons(id, hidden), Valuation::set(values, id, value), Valuation::set(other, id, value2)) {
    λ w query clear => {
        let parts = Bool::is_true_and(query.differs(id), absent(query, hidden), clear);
        let ne = query.differs_ne(id, parts.left);
        trans(Valuation::set_other(other, id, value2, w, query, ne),
            trans(apart(w, query, parts.right), sym(Valuation::set_other(values, id, value, w, query, ne))))
    }
}

theorem Valuation::bind_apart_same(ids: List<Nat>, hidden: List<Nat>, values, other: Valuation(),
    apart: Valuation::Apart(hidden, values, other)):
    (words: List<BitVec(64)>) → Valuation::Apart(hidden, Valuation::bind(values, ids, words), Valuation::bind(other, ids, words)) {
    match ids {
        Nil => λ words => apart,
        Cons(id, rest) => λ words => match words {
            Nil => apart,
            Cons(word, more) => Valuation::set_apart(hidden, Valuation::bind(values, rest, more), Valuation::bind(other, rest, more),
                Valuation::bind_apart_same(rest, hidden, values, other, apart, more), id, word_value(word), word_value(word), λ w => refl),
        },
    }
}

// ---------------------------------------------------------------------------
// Lists of words agreeing where a mask says so

// Which of `ids` are not hidden: the places whose words must agree.
fn mask_of(ids: List<Nat>, hidden: List<Nat>) → List<Bool> {
    match ids { Nil => [], Cons(id, rest) => Cons(absent(id, hidden), mask_of(rest, hidden)) }
}

// `ys` is `xs` at every place the mask marks, and past the mask's end;
// they are as long as each other.
fn ListsApart(mask: List<Bool>, xs, ys: List<BitVec(64)>) → Type {
    match mask {
        Nil => ys = xs,
        Cons(clear, rest) => match xs {
            Nil => ys = xs,
            Cons(x, more) => match ys {
                Nil => False,
                Cons(y, others) => (clear.IsTrue() → y = x) ∧ ListsApart(rest, more, others),
            },
        },
    }
}

theorem lists_apart_refl(mask: List<Bool>): (xs: List<BitVec(64)>) → ListsApart(mask, xs, xs) {
    match mask {
        Nil => λ xs => refl,
        Cons(clear, rest) => λ xs => match xs {
            Nil => refl,
            Cons(x, more) => ⟨λ _ => refl, lists_apart_refl(rest, more)⟩,
        },
    }
}

fn all_clear(mask: List<Bool>) → Bool { match mask { Nil => True, Cons(clear, rest) => clear && all_clear(rest) } }

theorem lists_apart_all(mask: List<Bool>): all_clear(mask).IsTrue() → (xs, ys: List<BitVec(64)>) → ListsApart(mask, xs, ys) → ys = xs {
    match mask {
        Nil => λ _ xs ys h => h,
        Cons(clear, rest) => λ ok xs => match xs {
            Nil => λ ys h => h,
            Cons(x, more) => λ ys => match ys {
                Nil => λ never => false_elim(never),
                Cons(y, others) => λ h => {
                    let parts = Bool::is_true_and(clear, all_clear(rest), ok);
                    eq2(λ (w: BitVec(64)) (ws: List<BitVec(64)>) => Cons(w, ws), h.left(parts.left),
                        lists_apart_all(rest, parts.right, more, others, h.right))
                },
            },
        },
    }
}

fn covers_bit(strong, weak: Bool) → Bool { match weak { False => True, True => strong } }

theorem covers_bit_clear(strong, weak: Bool): covers_bit(strong, weak).IsTrue() → weak.IsTrue() → strong.IsTrue() {
    match weak { False => λ _ never => false_elim(never), True => λ h _ => h }
}

// `strong` marks every place `weak` marks; where `weak` ends, everything
// past must agree, so `strong` marks all it has left.
fn mask_covers(strong, weak: List<Bool>) → Bool {
    match weak {
        Nil => all_clear(strong),
        Cons(w, rest) => match strong {
            Nil => True,
            Cons(s, more) => covers_bit(s, w) && mask_covers(more, rest),
        },
    }
}

theorem lists_apart_weaken(weak: List<Bool>): (strong: List<Bool>) → mask_covers(strong, weak).IsTrue() →
    (xs, ys: List<BitVec(64)>) → ListsApart(strong, xs, ys) → ListsApart(weak, xs, ys) {
    match weak {
        Nil => λ strong ok xs ys h => lists_apart_all(strong, ok, xs, ys, h),
        Cons(w, rest) => λ strong => match strong {
            Nil => λ _ xs ys h => j(sym(h), λ v _ => ListsApart(Cons(w, rest), xs, v), lists_apart_refl(Cons(w, rest), xs)),
            Cons(s, more) => λ ok xs => match xs {
                Nil => λ ys h => h,
                Cons(x, tail) => λ ys => match ys {
                    Nil => λ never => false_elim(never),
                    Cons(y, others) => λ h => {
                        let parts = Bool::is_true_and(covers_bit(s, w), mask_covers(more, rest), ok);
                        ⟨λ clear => h.left(covers_bit_clear(s, w, parts.left, clear)),
                            lists_apart_weaken(rest, more, parts.right, tail, others, h.right)⟩
                    },
                },
            },
        },
    }
}

// Words read off valuations that agree off `hidden` agree where the ids
// read are not hidden.
theorem words_of_apart(ids: List<Nat>, hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other)):
    ListsApart(mask_of(ids, hidden), words_of(values, ids), words_of(other, ids)) {
    match ids {
        Nil => refl,
        Cons(id, rest) => ⟨λ clear => apart(64, id, clear), words_of_apart(rest, hidden, values, other, apart)⟩,
    }
}

// `hidden`, and every id of `ids` at a place the mask does not mark: what
// is hidden once words agreeing only at the mask are bound at `ids`.
fn taint_onto(ids: List<Nat>, mask: List<Bool>, hidden: List<Nat>) → List<Nat> {
    match ids {
        Nil => hidden,
        Cons(id, rest) => match mask {
            Nil => hidden,
            Cons(clear, more) => match clear {
                False => Cons(id, taint_onto(rest, more, hidden)),
                True => taint_onto(rest, more, hidden),
            },
        },
    }
}

theorem taint_onto_keeps(ids: List<Nat>, hidden: List<Nat>, id: Nat): (mask: List<Bool>) →
    absent(id, taint_onto(ids, mask, hidden)).IsTrue() → absent(id, hidden).IsTrue() {
    match ids {
        Nil => λ mask h => h,
        Cons(x, rest) => λ mask => match mask {
            Nil => λ h => h,
            Cons(clear, more) => match clear {
                False => λ h => taint_onto_keeps(rest, hidden, id, more,
                    Bool::is_true_and(id.differs(x), absent(id, taint_onto(rest, more, hidden)), h).right),
                True => λ h => taint_onto_keeps(rest, hidden, id, more, h),
            },
        },
    }
}

// Binding words that agree at a mask, over valuations that agree off
// `hidden`: the valuations agree off what the binding hides.
theorem Valuation::bind_apart(ids: List<Nat>, hidden: List<Nat>, values, other: Valuation(),
    apart: Valuation::Apart(hidden, values, other)):
    (mask: List<Bool>) → (xs, ys: List<BitVec(64)>) → ListsApart(mask, xs, ys) →
    Valuation::Apart(taint_onto(ids, mask, hidden), Valuation::bind(values, ids, xs), Valuation::bind(other, ids, ys)) {
    match ids {
        Nil => λ mask xs ys _ => apart,
        Cons(id, rest) => λ mask => match mask {
            Nil => λ xs ys h => j(sym(h),
                λ v _ => Valuation::Apart(hidden, Valuation::bind(values, Cons(id, rest), xs), Valuation::bind(other, Cons(id, rest), v)),
                Valuation::bind_apart_same(Cons(id, rest), hidden, values, other, apart, xs)),
            Cons(clear, more) => λ xs => match xs {
                Nil => λ ys h => j(sym(h),
                    λ v _ => Valuation::Apart(taint_onto(Cons(id, rest), Cons(clear, more), hidden), values,
                        Valuation::bind(other, Cons(id, rest), v)),
                    λ w query c => apart(w, query, taint_onto_keeps(Cons(id, rest), hidden, query, Cons(clear, more), c))),
                Cons(x, tail) => λ ys => match ys {
                    Nil => λ never => false_elim(never),
                    Cons(y, others) => match clear {
                        False => λ h => Valuation::set_hidden(taint_onto(rest, more, hidden), Valuation::bind(values, rest, tail),
                            Valuation::bind(other, rest, others),
                            Valuation::bind_apart(rest, hidden, values, other, apart, more, tail, others, h.right), id, word_value(x),
                            word_value(y)),
                        True => λ h => Valuation::set_apart(taint_onto(rest, more, hidden), Valuation::bind(values, rest, tail),
                            Valuation::bind(other, rest, others),
                            Valuation::bind_apart(rest, hidden, values, other, apart, more, tail, others, h.right), id, word_value(x),
                            word_value(y), λ w => cong_fn(λ (v: BitVec(64)) => word_value(v, w), h.left(trivial))),
                    },
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// Nodes

// A node's value is a function of what it reads.
theorem Node::value_reads(self node: Node, buffers: Buffers(), values, other: Valuation()):
    ((w: Nat) → (id: Nat) → Mem(id, node.reads()) → other(w, id) = values(w, id)) →
    (w: Nat) → node.value(other, buffers := buffers)(w) = node.value(values, buffers := buffers)(w) {
    match node {
        Const(_, _, _) => λ agree w => refl,
        Move(_, _, source) => λ agree w => agree(w, source, Inl(refl)),
        Add(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y), agree(w, left, Inl(refl)),
            agree(w, right, Inr(Inl(refl)))),
        Sub(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y), agree(w, left, Inl(refl)),
            agree(w, right, Inr(Inl(refl)))),
        BitAnd(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y), agree(w, left, Inl(refl)),
            agree(w, right, Inr(Inl(refl)))),
        BitOr(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y), agree(w, left, Inl(refl)),
            agree(w, right, Inr(Inl(refl)))),
        BitXor(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y), agree(w, left, Inl(refl)),
            agree(w, right, Inr(Inl(refl)))),
        ShiftLeft(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.shift_left(amount), agree(w, value, Inl(refl))),
        LogicalShiftRight(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.shift_right(amount),
            agree(w, value, Inl(refl))),
        ArithmeticShiftRight(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.arithmetic_shift_right(amount),
            agree(w, value, Inl(refl))),
        UnsignedLessThan(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y), agree(width, left, Inl(refl)),
                agree(width, right, Inr(Inl(refl))))),
        SignedLessThan(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y), agree(width, left, Inl(refl)),
                agree(width, right, Inr(Inl(refl))))),
        Equal(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y), agree(width, left, Inl(refl)),
                agree(width, right, Inr(Inl(refl))))),
        BufferLoad(_, buffer, index) => λ agree w => cong_fn(
            λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(buffers, buffer, x.toNat())), w), agree(64, index, Inl(refl))),
        BufferStore(_, buffer, index, _) => λ agree w => cong_fn(
            λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(buffers, buffer, x.toNat())), w), agree(64, index, Inl(refl))),
        Resize(from, _, _, source) => λ agree w => cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := w),
            agree(from, source, Inl(refl))),
        SignResize(from, _, _, source) => λ agree w => cong_fn(λ (x: BitVec(from)) => x.sresize(w), agree(from, source, Inl(refl))),
        TableRead(_, _, bits, index, entries) => λ agree w => cong_fn(λ (x: BitVec(bits)) => BitVec::ofNat(table_entry(entries, x.toNat()), n := w),
            agree(bits, index, Inl(refl))),
        WideLoad(bytes, _, buffer, index) => λ agree w => cong_fn(
            λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(buffers, buffer, x.toNat(), bytes).toNat(), n := w), agree(64, index, Inl(refl))),
        WideStore(bytes, _, buffer, index, _) => λ agree w => cong_fn(
            λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(buffers, buffer, x.toNat(), bytes).toNat(), n := w), agree(64, index, Inl(refl))),
        ByteSwap(_, _, source) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.swap_bytes(), agree(w, source, Inl(refl))),
    }
}

// No node reads a hidden id.
fn nodes_clear(nodes: List<Node>, hidden: List<Nat>) → Bool {
    match nodes { Nil => True, Cons(node, rest) => disjoint(hidden, node.reads()) && nodes_clear(rest, hidden) }
}

theorem eval_nodes_apart(nodes: List<Node>, buffers: Buffers(), hidden: List<Nat>): nodes_clear(nodes, hidden).IsTrue() →
    (values, other: Valuation()) → Valuation::Apart(hidden, values, other) →
    Valuation::Apart(hidden, eval_nodes_over(buffers, nodes, values), eval_nodes_over(buffers, nodes, other)) {
    match nodes {
        Nil => λ _ values other apart => apart,
        Cons(node, rest) => λ ok values other apart => {
            let parts = Bool::is_true_and(disjoint(hidden, node.reads()), nodes_clear(rest, hidden), ok);
            eval_nodes_apart(rest, buffers, hidden, parts.right, node.step(values, buffers := buffers), node.step(other, buffers := buffers),
                Valuation::set_apart(hidden, values, other, apart, node_output(node).id, node.value(values, buffers := buffers),
                    node.value(other, buffers := buffers), node.value_reads(buffers, values, other,
                        λ w id m => apart(w, id, disjoint_mem(hidden, node.reads(), parts.left, id, m)))))
        },
    }
}

// ---------------------------------------------------------------------------
// Loops

// Passes that keep agreement off `ended`, from states agreeing at `mask`:
// the loops end alike, their states agreeing at `mask`, when the exit bit
// is not hidden and each marked place's next word is not either.
theorem loop_eval_apart(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>, mask: List<Bool>,
    ended: List<Nat>,
    passes: (v, o: Valuation()) → Valuation::Apart(taint_onto(parameters, mask, []), v, o) → Valuation::Apart(ended, step(v), step(o)),
    exit_clear: absent(exit, ended).IsTrue(), next_clear: mask_covers(mask_of(next, ended), mask).IsTrue(), remaining: Nat):
    (state, other: List<BitVec(64)>) → ListsApart(mask, state, other) →
    (loop_eval(step, parameters, count, exit, next, remaining, other).exhausted =
        loop_eval(step, parameters, count, exit, next, remaining, state).exhausted) ∧
    ListsApart(mask, loop_eval(step, parameters, count, exit, next, remaining, state).state,
        loop_eval(step, parameters, count, exit, next, remaining, other).state) {
    match remaining {
        Zero => λ state other h => ⟨refl, h⟩,
        Succ(rest) => λ state other h => {
            let base = Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(Succ(rest))));
            let entry = pass_valuation(parameters, count, Succ(rest), state);
            let entry2 = pass_valuation(parameters, count, Succ(rest), other);
            let entered: Valuation::Apart(taint_onto(parameters, mask, []), entry, entry2) =
                Valuation::bind_apart(parameters, [], base, base, Valuation::apart_refl([], base), mask, state, other, h);
            let after = step(entry);
            let after2 = step(entry2);
            let ran = passes(entry, entry2, entered);
            let bit: (after2(1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), ran(1, exit, exit_clear));
            let words: ListsApart(mask, words_of(after, next), words_of(after2, next)) =
                lists_apart_weaken(mask, mask_of(next, ended), next_clear, words_of(after, next), words_of(after2, next),
                    words_of_apart(next, ended, after, after2, ran));
            let aligned = match after(1, exit).head_bit() as λ b =>
                ((match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after2, next)),
                    True => LoopEnd(words_of(after2, next), False),
                }).exhausted = (match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }).exhausted) ∧ ListsApart(mask, (match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }).state, (match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after2, next)),
                    True => LoopEnd(words_of(after2, next), False),
                }).state) {
                False => loop_eval_apart(step, parameters, count, exit, next, mask, ended, passes, exit_clear, next_clear, rest,
                    words_of(after, next), words_of(after2, next), words),
                True => ⟨refl, words⟩,
            };
            j(sym(bit), λ b _ => ((match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after2, next)),
                    True => LoopEnd(words_of(after2, next), False),
                }).exhausted = (match after(1, exit).head_bit() {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }).exhausted) ∧ ListsApart(mask, (match after(1, exit).head_bit() {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }).state, (match b {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after2, next)),
                    True => LoopEnd(words_of(after2, next), False),
                }).state), aligned)
        },
    }
}

// ---------------------------------------------------------------------------
// Views

// What a lend hides beside what was hidden: each view's base.
fn views_taints(views: List<View>, hidden: List<Nat>) → List<Nat> {
    match views { Nil => hidden, Cons(view, rest) => views_taints(rest, Cons(view.base, hidden)) }
}

// No view starts or ends at a hidden id.
fn views_clear(views: List<View>, hidden: List<Nat>) → Bool {
    match views {
        Nil => True,
        Cons(view, rest) => (absent(view.start, hidden) && absent(view.end, hidden)) && views_clear(rest, hidden),
    }
}

theorem views_taints_keeps(views: List<View>, id: Nat): (hidden: List<Nat>) → absent(id, views_taints(views, hidden)).IsTrue() →
    absent(id, hidden).IsTrue() {
    match views {
        Nil => λ hidden h => h,
        Cons(view, rest) => λ hidden h =>
            Bool::is_true_and(id.differs(view.base), absent(id, hidden), views_taints_keeps(rest, id, Cons(view.base, hidden), h)).right,
    }
}

// A view's two nodes: its base is hidden, whatever it is, and its length
// is the same where its bounds are.
theorem View::bound_apart(self view: View, hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other),
    from: absent(view.start, Cons(view.base, hidden)).IsTrue(), upto: absent(view.end, Cons(view.base, hidden)).IsTrue()):
    Valuation::Apart(Cons(view.base, hidden), Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(values)),
        Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(other))) {
    let based = Add(64, view.base, view.home, view.start).step(values);
    let based2 = Add(64, view.base, view.home, view.start).step(other);
    let first: Valuation::Apart(Cons(view.base, hidden), based, based2) = Valuation::set_hidden(hidden, values, other, apart, view.base,
        Add(64, view.base, view.home, view.start).value(values), Add(64, view.base, view.home, view.start).value(other));
    let length = Sub(64, view.length, view.end, view.start);
    Valuation::set_apart(Cons(view.base, hidden), based, based2, first, view.length, length.value(based), length.value(based2),
        length.value_reads(Nil, based, based2, λ w id m => match m {
            Inl(is_end) => j(sym(is_end), λ x _ => based2(w, x) = based(w, x), first(w, view.end, upto)),
            Inr(more) => match more {
                Inl(is_start) => j(sym(is_start), λ x _ => based2(w, x) = based(w, x), first(w, view.start, from)),
                Inr(never) => false_elim(never),
            },
        }))
}

// The views' nodes evaluate alike off the bases, where the bounds are clear.
theorem views_eval_apart(views: List<View>, buffers: Buffers()): (hidden: List<Nat>) →
    views_clear(views, views_taints(views, hidden)).IsTrue() → (values, other: Valuation()) → Valuation::Apart(hidden, values, other) →
    Valuation::Apart(views_taints(views, hidden), eval_nodes_over(buffers, views_nodes(views), values),
        eval_nodes_over(buffers, views_nodes(views), other)) {
    match views {
        Nil => λ hidden _ values other apart => apart,
        Cons(view, rest) => λ hidden clear values other apart => {
            let later = views_taints(rest, Cons(view.base, hidden));
            let parts = Bool::is_true_and(absent(view.start, later) && absent(view.end, later), views_clear(rest, later), clear);
            let bounds = Bool::is_true_and(absent(view.start, later), absent(view.end, later), parts.left);
            views_eval_apart(rest, buffers, Cons(view.base, hidden), parts.right,
                Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(values)),
                Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(other)),
                view.bound_apart(hidden, values, other, apart, views_taints_keeps(rest, view.start, Cons(view.base, hidden), bounds.left),
                    views_taints_keeps(rest, view.end, Cons(view.base, hidden), bounds.right)))
        },
    }
}

// The windows are the same windows where the bounds are the same words.
theorem viewed_apart(views: List<View>, hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other),
    held: Buffers()): views_clear(views, hidden).IsTrue() → viewed(views, other, held) = viewed(views, values, held) {
    match views {
        Nil => λ _ => refl,
        Cons(view, rest) => λ clear => {
            let parts = Bool::is_true_and(absent(view.start, hidden) && absent(view.end, hidden), views_clear(rest, hidden), clear);
            let bounds = Bool::is_true_and(absent(view.start, hidden), absent(view.end, hidden), parts.left);
            let bytes = buffer_bytes(held, view.buffer);
            eq2(λ (window: List<BitVec(8)>) (tail: Buffers()) => Cons(window, tail),
                eq2<BitVec(64), BitVec(64), List<BitVec(8)>>(λ s e => bytes.window(s.toNat(), e.toNat()), apart(64, view.start, bounds.left),
                    apart(64, view.end, bounds.right)),
                viewed_apart(rest, hidden, values, other, apart, held, parts.right))
        },
    }
}

// And what is put back is put back at the same places.
theorem put_views_apart(views: List<View>, hidden: List<Nat>, values, other: Valuation(), apart: Valuation::Apart(hidden, values, other)):
    views_clear(views, hidden).IsTrue() → (after, held: Buffers()) → put_views(views, other, after, held) = put_views(views, values, after, held) {
    match views {
        Nil => λ _ after held => refl,
        Cons(view, rest) => λ clear after held => {
            let parts = Bool::is_true_and(absent(view.start, hidden) && absent(view.end, hidden), views_clear(rest, hidden), clear);
            let bounds = Bool::is_true_and(absent(view.start, hidden), absent(view.end, hidden), parts.left);
            let later: Buffers() = match after { Nil => Nil, Cons(_, tail) => tail };
            let put: (BitVec(64) → Buffers()) = λ s => match view.written {
                False => held,
                True => held.update(view.buffer, λ (was: List<BitVec(8)>) => was.put_window(s.toNat(), buffer_bytes(after, 0))),
            };
            trans(cong_fn<BitVec(64), Buffers()>(λ s => put_views(rest, other, later, put(s)), apart(64, view.start, bounds.left)),
                put_views_apart(rest, hidden, values, other, apart, parts.right, later, view.put(values, buffer_bytes(after, 0), held)))
        },
    }
}

// ---------------------------------------------------------------------------
// Regions

// A lent buffer's address place is free; every other word of a call must
// agree: `count` buffers' homes, then the rest.
fn base_mask(count: Nat) → List<Bool> {
    match count { Zero => [], Succ(k) => Cons(False, Cons(True, base_mask(k))) }
}

// What is hidden after the region, from what was before it. A node's
// output is never hidden (`placeless` lets no node read a hidden id); a
// loop's output is, where its input was.
fn StructuredRegion::taints(self region: StructuredRegion, hidden: List<Nat>) → List<Nat> {
    match region {
        Dataflow(_) => hidden,
        Sequence(_, continuation) => continuation.taints(hidden),
        Compose(prefix, continuation) => continuation.taints(prefix.taints(hidden)),
        Conditional(_, _, _, _, when_true, when_false) => when_true.taints(hidden) ++ when_false.taints(hidden),
        Lend(views, _, _, _) => views_taints(views, hidden),
        Call(_, _, _) => hidden,
        Loop(inputs, _, _, _, _, _, _, outputs, _) => taint_onto(outputs, mask_of(inputs, hidden), hidden),
    }
}

// The check. A hidden id is read by no node and tested by no branch; a
// call passes one only at a lent buffer's address place (`lent` says how
// many buffers each callee is lent); a call over views starts and ends no
// view at one, and passes its views' bases as a call passes any hidden id;
// a loop does not count by one, carries one only where it came in hidden,
// and does not leave by one.
fn StructuredRegion::placeless(self region: StructuredRegion, lent: Nat → Nat, hidden: List<Nat>) → Bool {
    match region {
        Dataflow(body) => nodes_clear(body.nodes, hidden),
        Sequence(prefix, continuation) => nodes_clear(prefix.nodes, hidden) && continuation.placeless(lent, hidden),
        Compose(prefix, continuation) => prefix.placeless(lent, hidden) && continuation.placeless(lent, prefix.taints(hidden)),
        Conditional(_, condition, _, _, when_true, when_false) => absent(condition, hidden)
            && (when_true.placeless(lent, hidden) && when_false.placeless(lent, hidden)),
        Lend(views, callee, arguments, _) => views_clear(views, views_taints(views, hidden))
            && mask_covers(mask_of(views_homes(views) ++ arguments, views_taints(views, hidden)), base_mask(lent(callee))),
        Call(callee, arguments, _) => mask_covers(mask_of(arguments, hidden), base_mask(lent(callee))),
        Loop(inputs, bound, parameters, _, body, exit, next, _, _) => absent(bound, hidden)
            && (body.placeless(lent, taint_onto(parameters, mask_of(inputs, hidden), []))
            && (absent(exit, body.taints(taint_onto(parameters, mask_of(inputs, hidden), [])))
            && mask_covers(mask_of(next, body.taints(taint_onto(parameters, mask_of(inputs, hidden), []))), mask_of(inputs, hidden)))),
    }
}

// The theorem for regions: a placeless region, its calls answered alike at
// every address word, evaluates alike off what it hides, from valuations
// alike off what was hidden.
theorem StructuredRegion::eval_apart(self region: StructuredRegion, buffers: Buffers(), call: Answers(), lent: Nat → Nat,
    answers: (f: Nat) → (words, others: List<BitVec(64)>) → ListsApart(base_mask(lent(f)), words, others) → call(f, others) = call(f, words)):
    (hidden: List<Nat>) → region.placeless(lent, hidden).IsTrue() → (values, other: Valuation()) →
    Valuation::Apart(hidden, values, other) →
    Valuation::Apart(region.taints(hidden), region.eval_over(buffers, call, values), region.eval_over(buffers, call, other)) {
    match region {
        Dataflow(body) => λ hidden ok values other apart => eval_nodes_apart(body.nodes, buffers, hidden, ok, values, other, apart),
        Sequence(prefix, continuation) => λ hidden ok values other apart => {
            let parts = Bool::is_true_and(nodes_clear(prefix.nodes, hidden), continuation.placeless(lent, hidden), ok);
            continuation.eval_apart(buffers, call, lent, answers, hidden, parts.right, prefix.eval(values, buffers := buffers),
                prefix.eval(other, buffers := buffers), eval_nodes_apart(prefix.nodes, buffers, hidden, parts.left, values, other, apart))
        },
        Compose(prefix, continuation) => λ hidden ok values other apart => {
            let parts = Bool::is_true_and(prefix.placeless(lent, hidden), continuation.placeless(lent, prefix.taints(hidden)), ok);
            continuation.eval_apart(buffers, call, lent, answers, prefix.taints(hidden), parts.right,
                prefix.eval_over(buffers, call, values), prefix.eval_over(buffers, call, other),
                prefix.eval_apart(buffers, call, lent, answers, hidden, parts.left, values, other, apart))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ hidden ok values other apart => λ w id clear => {
            let parts = Bool::is_true_and(absent(condition, hidden),
                when_true.placeless(lent, hidden) && when_false.placeless(lent, hidden), ok);
            let arms = Bool::is_true_and(when_true.placeless(lent, hidden), when_false.placeless(lent, hidden), parts.right);
            let both = absent_append(id, when_true.taints(hidden), when_false.taints(hidden), clear);
            let bit: (values(1, condition).head_bit() = other(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), apart(1, condition, parts.left)));
            let aligned = match values(1, condition).head_bit() as λ b =>
                (match b {
                    False => when_false.eval_over(buffers, call, other)(w, id),
                    True => when_true.eval_over(buffers, call, other)(w, id),
                }) = (match b {
                    False => when_false.eval_over(buffers, call, values)(w, id),
                    True => when_true.eval_over(buffers, call, values)(w, id),
                }) {
                False => when_false.eval_apart(buffers, call, lent, answers, hidden, arms.right, values, other, apart, w, id, both.right),
                True => when_true.eval_apart(buffers, call, lent, answers, hidden, arms.left, values, other, apart, w, id, both.left),
            };
            j(bit, λ b _ => (match b {
                    False => when_false.eval_over(buffers, call, other)(w, id),
                    True => when_true.eval_over(buffers, call, other)(w, id),
                }) = (match values(1, condition).head_bit() {
                    False => when_false.eval_over(buffers, call, values)(w, id),
                    True => when_true.eval_over(buffers, call, values)(w, id),
                }), aligned)
        },
        Lend(views, callee, arguments, result) => λ hidden ok values other apart => {
            let hid = views_taints(views, hidden);
            let passed = views_homes(views) ++ arguments;
            let parts = Bool::is_true_and(views_clear(views, hid), mask_covers(mask_of(passed, hid), base_mask(lent(callee))), ok);
            let bound = eval_nodes_over(buffers, views_nodes(views), values);
            let bound2 = eval_nodes_over(buffers, views_nodes(views), other);
            let alike: Valuation::Apart(hid, bound, bound2) = views_eval_apart(views, buffers, hidden, parts.left, values, other, apart);
            let words = words_of(bound, passed);
            let others = words_of(bound2, passed);
            let read: ListsApart(base_mask(lent(callee)), words, others) = lists_apart_weaken(base_mask(lent(callee)),
                mask_of(passed, hid), parts.right, words, others, words_of_apart(passed, hid, bound, bound2, alike));
            Valuation::set_apart(hid, bound, bound2, alike, result, word_value(call(callee, words)), word_value(call(callee, others)),
                λ w => cong_fn(λ (x: BitVec(64)) => word_value(x, w), answers(callee, words, others, read)))
        },
        Call(callee, arguments, result) => λ hidden ok values other apart => {
            let words = words_of(values, arguments);
            let others = words_of(other, arguments);
            let read: ListsApart(base_mask(lent(callee)), words, others) = lists_apart_weaken(base_mask(lent(callee)),
                mask_of(arguments, hidden), ok, words, others, words_of_apart(arguments, hidden, values, other, apart));
            Valuation::set_apart(hidden, values, other, apart, result, word_value(call(callee, words)), word_value(call(callee, others)),
                λ w => cong_fn(λ (x: BitVec(64)) => word_value(x, w), answers(callee, words, others, read)))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ hidden ok values other apart => {
            let mask = mask_of(inputs, hidden);
            let entered = taint_onto(parameters, mask, []);
            let ended = body.taints(entered);
            let first = Bool::is_true_and(absent(bound, hidden),
                body.placeless(lent, entered) && (absent(exit, ended) && mask_covers(mask_of(next, ended), mask)), ok);
            let second = Bool::is_true_and(body.placeless(lent, entered), absent(exit, ended) && mask_covers(mask_of(next, ended), mask),
                first.right);
            let third = Bool::is_true_and(absent(exit, ended), mask_covers(mask_of(next, ended), mask), second.right);
            let step = λ (pass: Valuation()) => body.eval_over(buffers, call, pass);
            let n = values(64, bound).toNat();
            let passes: (other(64, bound).toNat() = n) = cong_fn(λ (x: BitVec(64)) => x.toNat(), apart(64, bound, first.left));
            let end = loop_eval(step, parameters, count, exit, next, n, words_of(values, inputs));
            let end2 = loop_eval(step, parameters, count, exit, next, n, words_of(other, inputs));
            let ran = loop_eval_apart(step, parameters, count, exit, next, mask, ended,
                λ v o a => body.eval_apart(buffers, call, lent, answers, entered, second.left, v, o, a), third.left, third.right, n,
                words_of(values, inputs), words_of(other, inputs), words_of_apart(inputs, hidden, values, other, apart));
            let core: Valuation::Apart(taint_onto(outputs, mask, hidden),
                Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                Valuation::set(Valuation::bind(other, outputs, end2.state), exhausted, bit_value(end2.exhausted))) =
                Valuation::set_apart(taint_onto(outputs, mask, hidden), Valuation::bind(values, outputs, end.state),
                    Valuation::bind(other, outputs, end2.state),
                    Valuation::bind_apart(outputs, hidden, values, other, apart, mask, end.state, end2.state, ran.right), exhausted,
                    bit_value(end.exhausted), bit_value(end2.exhausted), λ w => cong_fn(λ (b: Bool) => bit_value(b, w), ran.left));
            j(sym(passes), λ m _ => Valuation::Apart(taint_onto(outputs, mask, hidden),
                    Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(other, outputs,
                            loop_eval(step, parameters, count, exit, next, m, words_of(other, inputs)).state), exhausted,
                        bit_value(loop_eval(step, parameters, count, exit, next, m, words_of(other, inputs)).exhausted))), core)
        },
    }
}

// ---------------------------------------------------------------------------
// Functions and programs

// The ids a function holds its lent buffers' addresses at.
fn Function::addresses(self function: Function) → List<Nat> { taint_onto(function.parameters, base_mask(function.lent), []) }

// The body is placeless from the address parameters, and the result is
// not one of them or of what a loop carried one into.
fn Function::placeless(self function: Function, lent: Nat → Nat) → Bool {
    function.body.placeless(lent, function.addresses()) && absent(function.result, function.body.taints(function.addresses()))
}

theorem Function::eval_apart(self function: Function, buffers: Buffers(), call: Answers(), lent: Nat → Nat,
    answers: (f: Nat) → (words, others: List<BitVec(64)>) → ListsApart(base_mask(lent(f)), words, others) → call(f, others) = call(f, words),
    ok: function.placeless(lent).IsTrue(), words, others: List<BitVec(64)>, apart: ListsApart(base_mask(function.lent), words, others)):
    function.eval(call, others, buffers := buffers) = function.eval(call, words, buffers := buffers) {
    let parts = Bool::is_true_and(function.body.placeless(lent, function.addresses()),
        absent(function.result, function.body.taints(function.addresses())), ok);
    let bound = Valuation::bind_apart(function.parameters, [], Valuation::zero(), Valuation::zero(),
        Valuation::apart_refl([], Valuation::zero()), base_mask(function.lent), words, others, apart);
    StructuredRegion::eval_apart(function.body, buffers, call, lent, answers, function.addresses(), parts.left,
        Valuation::bind(Valuation::zero(), function.parameters, words), Valuation::bind(Valuation::zero(), function.parameters, others),
        bound, 64, function.result, parts.right)
}

// How many buffers each function of a program is lent, by the number
// `program_eval_over` answers it at.
fn program_lent(functions: List<Function>) → Nat → Nat {
    match functions {
        Nil => λ _ => 0,
        Cons(last, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => last.lent,
            Inr(_) => program_lent(earlier, f),
        },
    }
}

fn program_placeless(functions: List<Function>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.placeless(program_lent(earlier)) && program_placeless(earlier) }
}

// The theorem for programs: a placeless program's functions answer alike
// at every address word, over any buffers.
theorem program_eval_placeless(buffers: Buffers(), functions: List<Function>): program_placeless(functions).IsTrue() → (f: Nat) →
    (words, others: List<BitVec(64)>) → ListsApart(base_mask(program_lent(functions, f)), words, others) →
    program_eval_over(buffers, functions)(f, others) = program_eval_over(buffers, functions)(f, words) {
    match functions {
        Nil => λ _ f words others _ => refl,
        Cons(last, earlier) => λ ok f words others => {
            let parts = Bool::is_true_and(last.placeless(program_lent(earlier)), program_placeless(earlier), ok);
            let ih = program_eval_placeless(buffers, earlier, parts.right);
            let below = program_eval_over(buffers, earlier);
            match f.eq_dec(earlier.len()) as λ d =>
                ListsApart(base_mask(match d { Inl(_) => last.lent, Inr(_) => program_lent(earlier, f) }), words, others) →
                (match d { Inl(_) => last.eval(below, others, buffers := buffers), Inr(_) => below(f, others) }) =
                (match d { Inl(_) => last.eval(below, words, buffers := buffers), Inr(_) => below(f, words) }) {
                Inl(_) => λ h => last.eval_apart(buffers, below, program_lent(earlier), ih, parts.left, words, others, h),
                Inr(_) => λ h => ih(f, words, others, h),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// The same, with the file threaded

// Two states alike off `hidden`: the valuations agree there, and the files
// are one file.
fn State::Apart(hidden: List<Nat>, one, two: State) → Type {
    Valuation::Apart(hidden, one.values, two.values) ∧ two.buffers = one.buffers
}

// What runs alike from valuations alike over one file runs alike from
// states alike.
theorem State::then_apart(first, later: List<Nat>, k: Valuation() → Buffers() → State,
    runs: (v, o: Valuation()) → (file: Buffers()) → Valuation::Apart(first, v, o) → State::Apart(later, k(v, file), k(o, file)),
    one, two: State, alike: State::Apart(first, one, two)):
    State::Apart(later, k(one.values, one.buffers), k(two.values, two.buffers)) {
    j(sym(alike.right), λ file _ => State::Apart(later, k(one.values, one.buffers), k(two.values, file)),
        runs(one.values, two.values, one.buffers, alike.left))
}

// A node's run is a function of what it reads: the value it names its
// output, and for a store the file it leaves.
theorem Node::run_apart(self node: Node, buffers: Buffers(), hidden: List<Nat>, values, other: Valuation(),
    apart: Valuation::Apart(hidden, values, other)):
    disjoint(hidden, node.reads()).IsTrue() → State::Apart(hidden, node.run(values, buffers), node.run(other, buffers)) {
    match stores: node.stores() {
        False => λ clear => {
            let quiet: (!node.stores()).IsTrue() = j(sym(stores), λ b _ => (!b).IsTrue(), trivial);
            let stepped: State::Apart(hidden, State(node.step(values, buffers := buffers), buffers),
                State(node.step(other, buffers := buffers), buffers)) =
                ⟨Valuation::set_apart(hidden, values, other, apart, node_output(node).id, node.value(values, buffers := buffers),
                    node.value(other, buffers := buffers), node.value_reads(buffers, values, other,
                        λ w id m => apart(w, id, disjoint_mem(hidden, node.reads(), clear, id, m)))), refl⟩;
            j(sym(node.run_step(other, buffers, quiet)), λ t _ => State::Apart(hidden, node.run(values, buffers), t),
                j(sym(node.run_step(values, buffers, quiet)),
                    λ s _ => State::Apart(hidden, s, State(node.step(other, buffers := buffers), buffers)), stepped))
        },
        True => (match node as λ n => n.stores() = True → disjoint(hidden, n.reads()).IsTrue() →
                State::Apart(hidden, n.run(values, buffers), n.run(other, buffers)) {
            BufferStore(output, buffer, index, value) => λ _ clear => {
                let at_index: (other(64, index) = values(64, index)) =
                    apart(64, index, disjoint_mem(hidden, [index, value], clear, index, Inl(refl)));
                let at_value: (other(64, value) = values(64, value)) =
                    apart(64, value, disjoint_mem(hidden, [index, value], clear, value, Inr(Inl(refl))));
                let file = λ (x: BitVec(64)) (y: BitVec(64)) => store_byte(buffers, buffer, x.toNat(), low_byte(y));
                ⟨Valuation::set_apart(hidden, values, other, apart, output,
                    load_value(file(values(64, index), values(64, value)), buffer, index, values),
                    load_value(file(other(64, index), other(64, value)), buffer, index, other),
                    λ w => eq2(λ (x: BitVec(64)) (y: BitVec(64)) => word_value(byte_word(buffer_byte(file(x, y), buffer, x.toNat())), w),
                        at_index, at_value)), eq2(file, at_index, at_value)⟩
            },
            WideStore(bytes, output, buffer, index, value) => λ _ clear => {
                let at_index: (other(64, index) = values(64, index)) =
                    apart(64, index, disjoint_mem(hidden, [index, value], clear, index, Inl(refl)));
                let at_value: (other(8 * bytes, value) = values(8 * bytes, value)) =
                    apart(8 * bytes, value, disjoint_mem(hidden, [index, value], clear, value, Inr(Inl(refl))));
                let file = λ (x: BitVec(64)) (y: BitVec(8 * bytes)) => store_word(buffers, buffer, x.toNat(), bytes, y);
                ⟨Valuation::set_apart(hidden, values, other, apart, output,
                    wide_value(file(values(64, index), values(8 * bytes, value)), buffer, index, bytes, values),
                    wide_value(file(other(64, index), other(8 * bytes, value)), buffer, index, bytes, other),
                    λ w => eq2(λ (x: BitVec(64)) (y: BitVec(8 * bytes)) => BitVec::ofNat(buffer_word(file(x, y), buffer, x.toNat(), bytes).toNat(), n := w),
                        at_index, at_value)), eq2(file, at_index, at_value)⟩
            },
            _ => λ no _ => absurd(no),
        })(stores),
    }
}

theorem run_nodes_apart(nodes: List<Node>, hidden: List<Nat>): nodes_clear(nodes, hidden).IsTrue() →
    (values, other: Valuation()) → (buffers: Buffers()) → Valuation::Apart(hidden, values, other) →
    State::Apart(hidden, run_nodes(nodes, values, buffers), run_nodes(nodes, other, buffers)) {
    match nodes {
        Nil => λ _ values other buffers apart => ⟨apart, refl⟩,
        Cons(node, rest) => λ ok values other buffers apart => {
            let parts = Bool::is_true_and(disjoint(hidden, node.reads()), nodes_clear(rest, hidden), ok);
            State::then_apart(hidden, hidden, λ (v: Valuation()) (file: Buffers()) => run_nodes(rest, v, file),
                λ v o file a => run_nodes_apart(rest, hidden, parts.right, v, o, file, a), node.run(values, buffers),
                node.run(other, buffers), node.run_apart(buffers, hidden, values, other, apart, parts.left))
        },
    }
}

// The views' nodes run alike off the bases, over one file that they leave
// as it was.
theorem views_run_apart(views: List<View>, buffers: Buffers()): (hidden: List<Nat>) →
    views_clear(views, views_taints(views, hidden)).IsTrue() → (values, other: Valuation()) → Valuation::Apart(hidden, values, other) →
    State::Apart(views_taints(views, hidden), run_nodes(views_nodes(views), values, buffers), run_nodes(views_nodes(views), other, buffers)) {
    match views {
        Nil => λ hidden _ values other apart => ⟨apart, refl⟩,
        Cons(view, rest) => λ hidden clear values other apart => {
            let later = views_taints(rest, Cons(view.base, hidden));
            let parts = Bool::is_true_and(absent(view.start, later) && absent(view.end, later), views_clear(rest, later), clear);
            let bounds = Bool::is_true_and(absent(view.start, later), absent(view.end, later), parts.left);
            views_run_apart(rest, buffers, Cons(view.base, hidden), parts.right,
                Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(values)),
                Sub(64, view.length, view.end, view.start).step(Add(64, view.base, view.home, view.start).step(other)),
                view.bound_apart(hidden, values, other, apart, views_taints_keeps(rest, view.start, Cons(view.base, hidden), bounds.left),
                    views_taints_keeps(rest, view.end, Cons(view.base, hidden), bounds.right)))
        },
    }
}

// Two loops ended alike: as one ran out or neither did, their states
// agreeing at `mask`, over one file.
fn LoopState::Apart(mask: List<Bool>, one, two: LoopState) → Type {
    (two.end.exhausted = one.end.exhausted) ∧ (ListsApart(mask, one.end.state, two.end.state) ∧ two.buffers = one.buffers)
}

// A loop after a pass that left `words` and `buffers`: ended if the pass
// left, and the passes that remain if not.
fn loop_run_after(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>, rest: Nat, left: Bool,
    words: List<BitVec(64)>, buffers: Buffers()) → LoopState {
    match left {
        False => loop_run(step, parameters, count, exit, next, rest, words, buffers),
        True => LoopState(LoopEnd(words, False), buffers),
    }
}

// `loop_eval_apart` with the file carried: the passes leave one file.
theorem loop_run_apart(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>, mask: List<Bool>,
    ended: List<Nat>,
    passes: (v, o: Valuation()) → (file: Buffers()) → Valuation::Apart(taint_onto(parameters, mask, []), v, o) →
        State::Apart(ended, step(v, file), step(o, file)),
    exit_clear: absent(exit, ended).IsTrue(), next_clear: mask_covers(mask_of(next, ended), mask).IsTrue(), remaining: Nat):
    (state, other: List<BitVec(64)>) → (buffers: Buffers()) → ListsApart(mask, state, other) →
    LoopState::Apart(mask, loop_run(step, parameters, count, exit, next, remaining, state, buffers),
        loop_run(step, parameters, count, exit, next, remaining, other, buffers)) {
    match remaining {
        Zero => λ state other buffers h => ⟨refl, ⟨h, refl⟩⟩,
        Succ(rest) => λ state other buffers h => {
            let base = Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(Succ(rest))));
            let entry = pass_valuation(parameters, count, Succ(rest), state);
            let entry2 = pass_valuation(parameters, count, Succ(rest), other);
            let entered: Valuation::Apart(taint_onto(parameters, mask, []), entry, entry2) =
                Valuation::bind_apart(parameters, [], base, base, Valuation::apart_refl([], base), mask, state, other, h);
            let after = step(entry, buffers);
            let after2 = step(entry2, buffers);
            let ran = passes(entry, entry2, buffers, entered);
            let bit: (after2.values(1, exit).head_bit() = after.values(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), ran.left(1, exit, exit_clear));
            let words: ListsApart(mask, words_of(after.values, next), words_of(after2.values, next)) =
                lists_apart_weaken(mask, mask_of(next, ended), next_clear, words_of(after.values, next), words_of(after2.values, next),
                    words_of_apart(next, ended, after.values, after2.values, ran.left));
            let one = loop_run_after(step, parameters, count, exit, next, rest, after.values(1, exit).head_bit(), words_of(after.values, next),
                after.buffers);
            let aligned = match after.values(1, exit).head_bit() as λ b => LoopState::Apart(mask,
                    loop_run_after(step, parameters, count, exit, next, rest, b, words_of(after.values, next), after.buffers),
                    loop_run_after(step, parameters, count, exit, next, rest, b, words_of(after2.values, next), after.buffers)) {
                False => loop_run_apart(step, parameters, count, exit, next, mask, ended, passes, exit_clear, next_clear, rest,
                    words_of(after.values, next), words_of(after2.values, next), after.buffers, words),
                True => ⟨refl, ⟨words, refl⟩⟩,
            };
            let turned = j(sym(bit), λ b _ => LoopState::Apart(mask, one,
                loop_run_after(step, parameters, count, exit, next, rest, b, words_of(after2.values, next), after.buffers)), aligned);
            j(sym(ran.right), λ file _ => LoopState::Apart(mask, one,
                loop_run_after(step, parameters, count, exit, next, rest, after2.values(1, exit).head_bit(), words_of(after2.values, next), file)),
                turned)
        },
    }
}

// The theorem for regions: a placeless region, its calls answered alike at
// every address word over every file, runs alike off what it hides and to
// one file, from valuations alike off what was hidden.
theorem StructuredRegion::run_apart(self region: StructuredRegion, call: Writers(), lent: Nat → Nat,
    answers: (file: Buffers()) → (f: Nat) → (words, others: List<BitVec(64)>) → ListsApart(base_mask(lent(f)), words, others) →
        call(file, f, others) = call(file, f, words)):
    (hidden: List<Nat>) → region.placeless(lent, hidden).IsTrue() → (values, other: Valuation()) → (buffers: Buffers()) →
    Valuation::Apart(hidden, values, other) →
    State::Apart(region.taints(hidden), region.run(call, values, buffers), region.run(call, other, buffers)) {
    match region {
        Dataflow(body) => λ hidden ok values other buffers apart => run_nodes_apart(body.nodes, hidden, ok, values, other, buffers, apart),
        Sequence(prefix, continuation) => λ hidden ok values other buffers apart => {
            let parts = Bool::is_true_and(nodes_clear(prefix.nodes, hidden), continuation.placeless(lent, hidden), ok);
            State::then_apart(hidden, continuation.taints(hidden),
                λ (v: Valuation()) (file: Buffers()) => continuation.run(call, v, file),
                λ v o file a => continuation.run_apart(call, lent, answers, hidden, parts.right, v, o, file, a),
                run_nodes(prefix.nodes, values, buffers), run_nodes(prefix.nodes, other, buffers),
                run_nodes_apart(prefix.nodes, hidden, parts.left, values, other, buffers, apart))
        },
        Compose(prefix, continuation) => λ hidden ok values other buffers apart => {
            let parts = Bool::is_true_and(prefix.placeless(lent, hidden), continuation.placeless(lent, prefix.taints(hidden)), ok);
            State::then_apart(prefix.taints(hidden), continuation.taints(prefix.taints(hidden)),
                λ (v: Valuation()) (file: Buffers()) => continuation.run(call, v, file),
                λ v o file a => continuation.run_apart(call, lent, answers, prefix.taints(hidden), parts.right, v, o, file, a),
                prefix.run(call, values, buffers), prefix.run(call, other, buffers),
                prefix.run_apart(call, lent, answers, hidden, parts.left, values, other, buffers, apart))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ hidden ok values other buffers apart => {
            let parts = Bool::is_true_and(absent(condition, hidden),
                when_true.placeless(lent, hidden) && when_false.placeless(lent, hidden), ok);
            let arms = Bool::is_true_and(when_true.placeless(lent, hidden), when_false.placeless(lent, hidden), parts.right);
            let bit: (values(1, condition).head_bit() = other(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), apart(1, condition, parts.left)));
            let yes = when_true.run_apart(call, lent, answers, hidden, arms.left, values, other, buffers, apart);
            let no = when_false.run_apart(call, lent, answers, hidden, arms.right, values, other, buffers, apart);
            let aligned = match values(1, condition).head_bit() as λ b =>
                ((w: Nat) → (id: Nat) → absent(id, when_true.taints(hidden) ++ when_false.taints(hidden)).IsTrue() →
                    (match b {
                        False => when_false.run(call, other, buffers).values(w, id),
                        True => when_true.run(call, other, buffers).values(w, id),
                    }) = (match b {
                        False => when_false.run(call, values, buffers).values(w, id),
                        True => when_true.run(call, values, buffers).values(w, id),
                    })) ∧ ((match b {
                        False => when_false.run(call, other, buffers).buffers,
                        True => when_true.run(call, other, buffers).buffers,
                    }) = (match b {
                        False => when_false.run(call, values, buffers).buffers,
                        True => when_true.run(call, values, buffers).buffers,
                    })) {
                False => ⟨λ w id clear => no.left(w, id,
                    absent_append(id, when_true.taints(hidden), when_false.taints(hidden), clear).right), no.right⟩,
                True => ⟨λ w id clear => yes.left(w, id,
                    absent_append(id, when_true.taints(hidden), when_false.taints(hidden), clear).left), yes.right⟩,
            };
            j(bit, λ b _ => ((w: Nat) → (id: Nat) → absent(id, when_true.taints(hidden) ++ when_false.taints(hidden)).IsTrue() →
                    (match b {
                        False => when_false.run(call, other, buffers).values(w, id),
                        True => when_true.run(call, other, buffers).values(w, id),
                    }) = (match values(1, condition).head_bit() {
                        False => when_false.run(call, values, buffers).values(w, id),
                        True => when_true.run(call, values, buffers).values(w, id),
                    })) ∧ ((match b {
                        False => when_false.run(call, other, buffers).buffers,
                        True => when_true.run(call, other, buffers).buffers,
                    }) = (match values(1, condition).head_bit() {
                        False => when_false.run(call, values, buffers).buffers,
                        True => when_true.run(call, values, buffers).buffers,
                    })), aligned)
        },
        Lend(views, callee, arguments, result) => λ hidden ok values other buffers apart => {
            let hid = views_taints(views, hidden);
            let passed = views_homes(views) ++ arguments;
            let parts = Bool::is_true_and(views_clear(views, hid), mask_covers(mask_of(passed, hid), base_mask(lent(callee))), ok);
            let bound = run_nodes(views_nodes(views), values, buffers);
            let bound2 = run_nodes(views_nodes(views), other, buffers);
            let alike: State::Apart(hid, bound, bound2) = views_run_apart(views, buffers, hidden, parts.left, values, other, apart);
            let words = words_of(bound.values, passed);
            let others = words_of(bound2.values, passed);
            let read: ListsApart(base_mask(lent(callee)), words, others) = lists_apart_weaken(base_mask(lent(callee)),
                mask_of(passed, hid), parts.right, words, others, words_of_apart(passed, hid, bound.values, bound2.values, alike.left));
            let file = viewed(views, bound.values, bound.buffers);
            let file2 = viewed(views, bound2.values, bound2.buffers);
            let one_file: (file2 = file) = trans(cong_fn<Buffers(), Buffers()>(λ held => viewed(views, bound2.values, held), alike.right),
                viewed_apart(views, hid, bound.values, bound2.values, alike.left, bound.buffers, parts.left));
            let answer = call(file, callee, words);
            let answer2 = call(file2, callee, others);
            let same: (answer2 = answer) = trans(cong_fn<Buffers(), Ending>(λ held => call(held, callee, others), one_file),
                answers(file, callee, words, others, read));
            let put: (put_views(views, bound2.values, answer2.buffers, bound2.buffers) =
                put_views(views, bound.values, answer.buffers, bound.buffers)) =
                trans(eq2(λ (a: Ending) (held: Buffers()) => put_views(views, bound2.values, a.buffers, held), same, alike.right),
                    put_views_apart(views, hid, bound.values, bound2.values, alike.left, parts.left, answer.buffers, bound.buffers));
            ⟨Valuation::set_apart(hid, bound.values, bound2.values, alike.left, result, word_value(answer.word), word_value(answer2.word),
                λ w => cong_fn(λ (a: Ending) => word_value(a.word, w), same)), put⟩
        },
        Call(callee, arguments, result) => λ hidden ok values other buffers apart => {
            let words = words_of(values, arguments);
            let others = words_of(other, arguments);
            let read: ListsApart(base_mask(lent(callee)), words, others) = lists_apart_weaken(base_mask(lent(callee)),
                mask_of(arguments, hidden), ok, words, others, words_of_apart(arguments, hidden, values, other, apart));
            let same: (call(buffers, callee, others) = call(buffers, callee, words)) = answers(buffers, callee, words, others, read);
            ⟨Valuation::set_apart(hidden, values, other, apart, result, word_value(call(buffers, callee, words).word),
                word_value(call(buffers, callee, others).word), λ w => cong_fn(λ (answer: Ending) => word_value(answer.word, w), same)),
                cong_fn(λ (answer: Ending) => answer.buffers, same)⟩
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ hidden ok values other buffers apart => {
            let mask = mask_of(inputs, hidden);
            let entered = taint_onto(parameters, mask, []);
            let ended = body.taints(entered);
            let first = Bool::is_true_and(absent(bound, hidden),
                body.placeless(lent, entered) && (absent(exit, ended) && mask_covers(mask_of(next, ended), mask)), ok);
            let second = Bool::is_true_and(body.placeless(lent, entered), absent(exit, ended) && mask_covers(mask_of(next, ended), mask),
                first.right);
            let third = Bool::is_true_and(absent(exit, ended), mask_covers(mask_of(next, ended), mask), second.right);
            let step = λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held);
            let n = values(64, bound).toNat();
            let passes: (other(64, bound).toNat() = n) = cong_fn(λ (x: BitVec(64)) => x.toNat(), apart(64, bound, first.left));
            let end = loop_run(step, parameters, count, exit, next, n, words_of(values, inputs), buffers);
            let end2 = loop_run(step, parameters, count, exit, next, n, words_of(other, inputs), buffers);
            let ran = loop_run_apart(step, parameters, count, exit, next, mask, ended,
                λ v o file a => body.run_apart(call, lent, answers, entered, second.left, v, o, file, a), third.left, third.right, n,
                words_of(values, inputs), words_of(other, inputs), buffers, words_of_apart(inputs, hidden, values, other, apart));
            let out = λ (v: Valuation()) (l: LoopState) =>
                State(Valuation::set(Valuation::bind(v, outputs, l.end.state), exhausted, bit_value(l.end.exhausted)), l.buffers);
            let core: State::Apart(taint_onto(outputs, mask, hidden), out(values, end), out(other, end2)) =
                ⟨Valuation::set_apart(taint_onto(outputs, mask, hidden), Valuation::bind(values, outputs, end.end.state),
                    Valuation::bind(other, outputs, end2.end.state),
                    Valuation::bind_apart(outputs, hidden, values, other, apart, mask, end.end.state, end2.end.state, ran.right.left),
                    exhausted, bit_value(end.end.exhausted), bit_value(end2.end.exhausted),
                    λ w => cong_fn(λ (b: Bool) => bit_value(b, w), ran.left)), ran.right.right⟩;
            j(sym(passes), λ m _ => State::Apart(taint_onto(outputs, mask, hidden), out(values, end),
                out(other, loop_run(step, parameters, count, exit, next, m, words_of(other, inputs), buffers))), core)
        },
    }
}

// A placeless function answers alike, word and file, at word lists that
// agree off its address places.
theorem Function::run_apart(self function: Function, call: Writers(), lent: Nat → Nat,
    answers: (file: Buffers()) → (f: Nat) → (words, others: List<BitVec(64)>) → ListsApart(base_mask(lent(f)), words, others) →
        call(file, f, others) = call(file, f, words),
    ok: function.placeless(lent).IsTrue(), words, others: List<BitVec(64)>, buffers: Buffers(),
    apart: ListsApart(base_mask(function.lent), words, others)): function.run(call, others, buffers) = function.run(call, words, buffers) {
    let parts = Bool::is_true_and(function.body.placeless(lent, function.addresses()),
        absent(function.result, function.body.taints(function.addresses())), ok);
    let bound = Valuation::bind_apart(function.parameters, [], Valuation::zero(), Valuation::zero(),
        Valuation::apart_refl([], Valuation::zero()), base_mask(function.lent), words, others, apart);
    let ran = StructuredRegion::run_apart(function.body, call, lent, answers, function.addresses(), parts.left,
        Valuation::bind(Valuation::zero(), function.parameters, words), Valuation::bind(Valuation::zero(), function.parameters, others),
        buffers, bound);
    eq2(λ (word: BitVec(64)) (file: Buffers()) => Ending(word, file), ran.left(64, function.result, parts.right), ran.right)
}

// The theorem for programs, the file threaded: a placeless program's
// functions return one word and leave one file at every address word.
theorem program_run_placeless(functions: List<Function>): program_placeless(functions).IsTrue() → (buffers: Buffers()) → (f: Nat) →
    (words, others: List<BitVec(64)>) → ListsApart(base_mask(program_lent(functions, f)), words, others) →
    program_run(functions, buffers, f, others) = program_run(functions, buffers, f, words) {
    match functions {
        Nil => λ _ buffers f words others _ => refl,
        Cons(last, earlier) => λ ok buffers f words others => {
            let parts = Bool::is_true_and(last.placeless(program_lent(earlier)), program_placeless(earlier), ok);
            let ih = program_run_placeless(earlier, parts.right);
            let below = program_run(earlier);
            match f.eq_dec(earlier.len()) as λ d =>
                ListsApart(base_mask(match d { Inl(_) => last.lent, Inr(_) => program_lent(earlier, f) }), words, others) →
                (match d as λ _ => Ending { Inl(_) => last.run(below, others, buffers), Inr(_) => below(buffers, f, others) }) =
                (match d as λ _ => Ending { Inl(_) => last.run(below, words, buffers), Inr(_) => below(buffers, f, words) }) {
                Inl(_) => λ h => last.run_apart(below, program_lent(earlier), ih, parts.left, words, others, buffers, h),
                Inr(_) => λ h => ih(buffers, f, words, others, h),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A caller that has no addresses

// The buffers a function lent `count` of them sees: the caller's first
// `count`, by number, and no others.
fn lent_buffers(count: Nat, held: Buffers()) → Buffers() {
    match count {
        Zero => Nil,
        Succ(k) => match held { Nil => Nil, Cons(bytes, rest) => Cons(bytes, lent_buffers(k, rest)) },
    }
}

// The words a caller with no addresses states for the buffers it lends,
// buffer `from` first: each home's address stated as zero, which no
// placeless function's answer reads (`program_eval_placeless`), and its
// length the buffer's.
fn stated_homes(from, count: Nat, held: Buffers()) → List<BitVec(64)> {
    match count {
        Zero => [],
        Succ(k) => Cons(BitVec::zero(), Cons(BitVec::ofNat(buffer_bytes(held, from).len()), stated_homes(Succ(from), k, held))),
    }
}

// The word a program answers a call with, from a caller that has buffers
// and no addresses: the function evaluated over the buffers it is lent, as
// they are at the call, on their homes and then the call's words. A
// function lent nothing is `program_eval`'s on the words, by evaluation.
// It is what `program_writers` answers when the program stores nothing
// (`program_writers_quiet`).
fn program_readers(functions: List<Function>) → Readers() {
    λ held f words => program_eval_over(lent_buffers(program_lent(functions, f), held), functions)(f,
        stated_homes(0, program_lent(functions, f), held) ++ words)
}

// The buffers after the first.
fn buffers_rest(buffers: Buffers()) → Buffers() {
    match buffers { Nil => Nil, Cons(_, rest) => rest }
}

// The file a caller holds after a call lent its first `count` buffers,
// which the callee left as `after`: those, buffer by buffer, then the rest
// as they were. The caller's file keeps its count of buffers.
fn relent(count: Nat, after, held: Buffers()) → Buffers() {
    match count {
        Zero => held,
        Succ(k) => match held {
            Nil => Nil,
            Cons(_, rest) => Cons(buffer_bytes(after, 0), relent(k, buffers_rest(after), rest)),
        },
    }
}

// Lent and left as they were, the file is as it was.
theorem relent_same(count: Nat): (held: Buffers()) → relent(count, lent_buffers(count, held), held) = held {
    match count {
        Zero => λ held => refl,
        Succ(k) => λ held => match held {
            Nil => refl,
            Cons(bytes, rest) => cong_fn(λ (tail: Buffers()) => Cons(bytes, tail), relent_same(k, rest)),
        },
    }
}

// How a program answers a call from a region that has buffers and no
// addresses, the file threaded (`function_ir_state`'s `run`, a
// `Source`'s): the function run over the buffers it is lent, as they are
// at the call, on their homes and then the call's words, and the caller's
// file with those buffers as the function left them. The function is run
// once.
fn program_writers(functions: List<Function>) → Writers() {
    λ held f words => shared(program_run(functions, lent_buffers(program_lent(functions, f), held), f,
            stated_homes(0, program_lent(functions, f), held) ++ words),
        λ (answer: Ending) => Ending(answer.word, relent(program_lent(functions, f), answer.buffers, held)))
}

// A program whose functions store nothing answers a call with the word its
// readers do, and the file as it was.
theorem program_writers_quiet(functions: List<Function>, quiet: program_quiet(functions).IsTrue(), held: Buffers(), f: Nat,
    words: List<BitVec(64)>): program_writers(functions)(held, f, words) = Ending(program_readers(functions)(held, f, words), held) {
    let k = program_lent(functions, f);
    let lent = lent_buffers(k, held);
    let stated = stated_homes(0, k, held) ++ words;
    trans(cong_fn<Ending, Ending>(λ answer => Ending(answer.word, relent(k, answer.buffers, held)),
            program_run_quiet(functions, quiet, lent, f, stated)),
        cong_fn<Buffers(), Ending>(λ file => Ending(program_eval_over(lent, functions)(f, stated), file), relent_same(k, held)))
}

theorem program_writers_still(functions: List<Function>, quiet: program_quiet(functions).IsTrue()): Writers::Quiet(program_writers(functions)) {
    λ held f words => cong_fn<Ending, Buffers()>(λ answer => answer.buffers, program_writers_quiet(functions, quiet, held, f, words))
}

// No function of the program is lent a buffer.
fn program_unlent(functions: List<Function>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.lent.matches(0) && program_unlent(earlier) }
}

theorem program_unlent_lent(functions: List<Function>): program_unlent(functions).IsTrue() → (f: Nat) → program_lent(functions, f) = 0 {
    match functions {
        Nil => λ _ f => refl,
        Cons(last, earlier) => λ ok f => {
            let parts = Bool::is_true_and(last.lent.matches(0), program_unlent(earlier), ok);
            match f.eq_dec(earlier.len()) as λ d => (match d { Inl(_) => last.lent, Inr(_) => program_lent(earlier, f) }) = 0 {
                Inl(_) => last.lent.matches_eq(0, parts.left),
                Inr(_) => program_unlent_lent(earlier, parts.right, f),
            }
        },
    }
}

// Such a program answers every call as `program_eval` does, whatever the
// buffers.
theorem program_readers_unlent(functions: List<Function>, ok: program_unlent(functions).IsTrue(), held: Buffers(), f: Nat,
    words: List<BitVec(64)>): program_readers(functions)(held, f, words) = program_eval(functions)(f, words) {
    j(sym(program_unlent_lent(functions, ok, f)),
        λ k _ => program_eval_over(lent_buffers(k, held), functions)(f, stated_homes(0, k, held) ++ words) = program_eval(functions)(f, words),
        refl)
}

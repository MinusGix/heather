// A function's body under a test of values it did not have: nodes of
// fresh outputs, then a conditional on one of them whose arms are both the
// body (docs/native/optimizer-design.md §5.1). The stage learns nothing: the arm
// the test's bit takes starts with that bit as a fact, which is where the
// replayer has a rule derive what the body's own tests ask
// (`function_ir_replay.hthr`), and the other arm is the function as it was.
// The optimizer runs this stage first, so that arm is the function as
// written, its calls still calls, and inlining and the rest work past the
// test (`function_ir_optimize.hthr`).
//
// Sound because nodes that only compute can always be satisfied: the
// function's valuation evaluated through them (`eval_nodes_over`) agrees
// with it below the bound, where everything the body mentions is.
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_views;
import function_ir_stage;
import function_ir_fresh;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// A bound the function's ids are below, the nodes of the test, and the bit
// tested.
record Guard { bound: Nat, nodes: List<Node>, condition: Nat }

fn Function::guarded(self function: Function, plan: Guard) → Function {
    Function(function.parameters, Compose(Dataflow(Region(Ports([]), plan.nodes, Ports([]))),
        Conditional(Ports([]), plan.condition, Ports([]), Ports([Port(function.result, 64)]), function.body, function.body)),
        function.result, function.lent)
}

// The nodes require nothing and store nothing, each can be evaluated after
// the ones before it, and none writes an id of the function's.
fn guard_function(function: Function, plan: Guard) → Option<Function> {
    (nodes_total(plan.nodes) && (ids_under(Cons(function.result, function.parameters), plan.bound) && (function.body.under(plan.bound) && (nodes_quiet(plan.nodes) &&
        (nodes_evaluable(plan.nodes) && ids_over(nodes_writes(plan.nodes), plan.bound)))))).then(Some(function.guarded(plan)))
}

theorem guard_function_sound(callees: List<Function>, function: Function, plan: Guard, new: Function,
    made: guard_function(function, plan) = Some(new)): Rewrites(callees, function, new) {
    λ arguments result before after ran => {
        let rest = ids_under(Cons(function.result, function.parameters), plan.bound) && (function.body.under(plan.bound) &&
            (nodes_quiet(plan.nodes) && (nodes_evaluable(plan.nodes) && ids_over(nodes_writes(plan.nodes), plan.bound))));
        let checked = Bool::then_some(nodes_total(plan.nodes) && rest, Some(function.guarded(plan)), new, made);
        let c0 = Bool::and_true_parts(nodes_total(plan.nodes), rest, checked.left);
        let c1 = Bool::and_true_parts(ids_under(Cons(function.result, function.parameters), plan.bound), function.body.under(plan.bound) &&
            (nodes_quiet(plan.nodes) && (nodes_evaluable(plan.nodes) && ids_over(nodes_writes(plan.nodes), plan.bound))), c0.right);
        let c2 = Bool::and_true_parts(function.body.under(plan.bound),
            nodes_quiet(plan.nodes) && (nodes_evaluable(plan.nodes) && ids_over(nodes_writes(plan.nodes), plan.bound)), c1.right);
        let c3 = Bool::and_true_parts(nodes_quiet(plan.nodes), nodes_evaluable(plan.nodes) && ids_over(nodes_writes(plan.nodes), plan.bound), c2.right);
        let c4 = Bool::and_true_parts(nodes_evaluable(plan.nodes), ids_over(nodes_writes(plan.nodes), plan.bound), c3.right);
        let values = ran.witness;
        let other = eval_nodes_over(before, plan.nodes, values);
        let agree: Valuation::AgreeBelow(values, other, plan.bound) = λ id under w =>
            eval_nodes_frame(plan.nodes, before, values, w, id, ids_over_absent(plan.bound, nodes_writes(plan.nodes), c4.right, id, under));
        let ids = ids_under_mem(plan.bound, Cons(function.result, function.parameters), c1.left);
        let tests = nodes_run_quiet(other, before, plan.nodes, Bool::is_true_of_eq(c3.left),
            eval_nodes_holds(plan.nodes, before, Bool::is_true_of_eq(c4.left), values, other, λ w id m => refl,
                nodes_total_defined(plan.nodes, before, Bool::is_true_of_eq(c0.left), values)));
        let body = function.body.runs_agree(program_effects(callees), plan.bound, c2.left, values, other, agree, before, after, ran.proof.right.left);
        j(Option::some_inj(function.guarded(plan), new, checked.right), λ g _ => g.Runs(program_effects(callees), arguments, result, before, after),
            Exists(other, ⟨trans(words_agree(function.parameters, values, other, λ id m => agree(id, ids(id, Inr(m)), 64)), ran.proof.left),
                ⟨Exists(before, ⟨tests, (match other(1, plan.condition).head_bit() as λ b =>
                    (match b {
                        False => StructuredRegionRunsOver(program_effects(callees), other, function.body, before, after),
                        True => StructuredRegionRunsOver(program_effects(callees), other, function.body, before, after),
                    }) {
                    False => body,
                    True => body,
                })⟩), trans(agree(function.result, ids(function.result, Inl(refl)), 64), ran.proof.right.right)⟩⟩))
    }
}

fn guard_stage() → Stage<Guard> {
    Stage(λ callees function plan => guard_function(function, plan), λ callees old plan new made => guard_function_sound(callees, old, plan, new, made))
}

// FunctionIR evaluated: a total function computing a region's values, and
// the theorem that what it computes satisfies the region's equations
// (issues/function-ir-total-evaluator.md; docs/native-effect-source-design.md
// §2.1, round S3.0).
//
// FunctionIR's meaning is relational: a valuation satisfies a region's
// equations. A tree has to compute its next command from values in hand, so
// the effectful source needs a function. `eval` runs a region's schedule over
// a valuation, setting each node's output; `Function::eval` binds a
// function's parameters and evaluates its body; `program_eval` evaluates a
// program's functions last first, as `program_callees` orders them.
//
// A value is set at every width at once (`Valuation::set` takes a value per
// width), and each node's value is its equation's right side read at the
// width asked for. At the node's own width that is the equation; no width is
// ever compared, so nothing is transported along a width equation.
//
// The theorem asks a schedule to be evaluable, a Bool computed by
// evaluation: no node reads its own output, nothing later writes an id
// anything earlier mentions, an arm writes no condition, a call names a
// function of the right arity, and a function's parameters are distinct and
// unwritten. Under that, the evaluated valuation satisfies the equations
// (`StructuredRegion::eval_holds_in`), and a program's evaluated results are
// results its functions compute (`program_eval_computes`), which is what
// every lowering theorem is stated over.

import function_ir;
import bitvec;
import bool;
import list;
import set_solve;
import set_ops;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Ids and lists of them, decided by evaluation

fn Nat::differs(self a, b: Nat) → Bool { match a.eq_dec(b) { Inl(_) => False, Inr(_) => True } }

fn Nat::matches(self a, b: Nat) → Bool { match a.eq_dec(b) { Inl(_) => True, Inr(_) => False } }

theorem Nat::differs_ne(self a, b: Nat, h: a.differs(b).IsTrue()): a ≠ b {
    (match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) → a ≠ b {
        Inl(_) => λ never => false_elim(never),
        Inr(ne) => λ _ => ne,
    })(h)
}

theorem Nat::matches_eq(self a, b: Nat, h: a.matches(b).IsTrue()): a = b {
    (match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => True, Inr(_) => False }) → a = b {
        Inl(e) => λ _ => e,
        Inr(_) => λ never => false_elim(never),
    })(h)
}

// `id` is none of `ids`.
fn absent(id: Nat, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(x, rest) => id.differs(x) && absent(id, rest) }
}

// No id of `ys` is one of `xs`.
fn disjoint(xs, ys: List<Nat>) → Bool {
    match ys { Nil => True, Cons(y, rest) => absent(y, xs) && disjoint(xs, rest) }
}

// No id appears twice.
fn distinct(ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(x, rest) => absent(x, rest) && distinct(rest) }
}

theorem absent_mem(id: Nat, ids: List<Nat>): absent(id, ids).IsTrue() → (y: Nat) → Mem(y, ids) → id ≠ y {
    match ids {
        Nil => λ _ y never => false_elim(never),
        Cons(x, rest) => λ h y m => {
            let parts = Bool::is_true_and(id.differs(x), absent(id, rest), h);
            match m {
                Inl(e) => λ same => id.differs_ne(x, parts.left, trans(same, e)),
                Inr(later) => absent_mem(id, rest, parts.right, y, later),
            }
        },
    }
}

theorem disjoint_mem(xs, ys: List<Nat>): disjoint(xs, ys).IsTrue() → (y: Nat) → Mem(y, ys) → absent(y, xs).IsTrue() {
    match ys {
        Nil => λ _ y never => false_elim(never),
        Cons(z, rest) => λ h y m => {
            let parts = Bool::is_true_and(absent(z, xs), disjoint(xs, rest), h);
            match m {
                Inl(e) => j(sym(e), λ x _ => absent(x, xs).IsTrue(), parts.left),
                Inr(later) => disjoint_mem(xs, rest, parts.right, y, later),
            }
        },
    }
}

theorem absent_append(id: Nat, xs, ys: List<Nat>): absent(id, xs ++ ys).IsTrue() →
    absent(id, xs).IsTrue() ∧ absent(id, ys).IsTrue() {
    match xs {
        Nil => λ h => ⟨trivial, h⟩,
        Cons(x, rest) => λ h => {
            let parts = Bool::is_true_and(id.differs(x), absent(id, rest ++ ys), h);
            let later = absent_append(id, rest, ys, parts.right);
            ⟨Bool::is_true_and_intro(id.differs(x), absent(id, rest), parts.left, later.left), later.right⟩
        },
    }
}

theorem eq2<A, B, C>(g: A → B → C, {a, a2: A}, {b, b2: B}, p: a = a2, q: b = b2): g(a, b) = g(a2, b2) {
    trans(cong_fn(λ (x: A) => g(x, b), p), cong_fn(λ (y: B) => g(a2, y), q))
}

// ---------------------------------------------------------------------------
// Valuations, set at every width

// `id` holds `value` (at each width, the value at that width); every other
// id keeps its value.
fn Valuation::set(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w)) → Valuation() {
    λ w query => match query.eq_dec(id) { Inl(_) => value(w), Inr(_) => values(w, query) }
}

theorem Valuation::set_here(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w), w: Nat):
    Valuation::set(values, id, value, w, id) = value(w) {
    match id.eq_dec(id) {
        Inl(_) => refl,
        Inr(ne) => false_elim(ne(refl)),
    }
}

theorem Valuation::set_other(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w), w, query: Nat,
    ne: query ≠ id): Valuation::set(values, id, value, w, query) = values(w, query) {
    match query.eq_dec(id) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => refl,
    }
}

fn Valuation::zero() → Valuation() { λ w id => BitVec::zero() }

// A word at every width: itself at 64, by evaluation, so that a function
// evaluated over open words is its source by conversion; its low bits at
// any other width.
fn word_value(word: BitVec(64)) → (w: Nat) → BitVec(w) {
    λ w => match Nat::equation(64, w) {
        Inl(e) => j(e, λ v _ => BitVec(v), word),
        Inr(_) => BitVec::ofNat(word.toNat()),
    }
}

theorem word_value_word(word: BitVec(64)): word_value(word, 64) = word { refl }

// A one-bit result at every width: the bit, then zeroes.
fn bit_value(b: Bool) → (w: Nat) → BitVec(w) {
    λ w => match w { Zero => BitVec::nil(), Succ(_) => BitVec::zero().cons_bit(b) }
}

theorem bit_value_bit(b: Bool): bit_value(b, 1) = BitVec::ofBool(b) {
    match b { False => refl, True => refl }
}

// Words at `ids`, each set to the word at its place.
fn Valuation::bind(values: Valuation(), ids: List<Nat>) → List<BitVec(64)> → Valuation() {
    match ids {
        Nil => λ words => values,
        Cons(id, rest) => λ words => match words {
            Nil => values,
            Cons(word, more) => Valuation::set(Valuation::bind(values, rest, more), id, word_value(word)),
        },
    }
}

theorem words_of_len(values: Valuation(), ids: List<Nat>): words_of(values, ids).len() = ids.len() {
    match ids { Nil => refl, Cons(_, rest) => cong_fn(λ (n: Nat) => Succ(n), words_of_len(values, rest)) }
}

// Valuations agreeing at 64 on `ids` read the same words there.
theorem words_agree(ids: List<Nat>, values, other: Valuation(), h: (id: Nat) → Mem(id, ids) → other(64, id) = values(64, id)):
    words_of(other, ids) = words_of(values, ids) {
    match ids {
        Nil => refl,
        Cons(id, rest) => eq2(λ (w: BitVec(64)) (ws: List<BitVec(64)>) => Cons(w, ws), h(id, Inl(refl)),
            words_agree(rest, values, other, λ x m => h(x, Inr(m)))),
    }
}

// Binding distinct ids to as many words reads the words back.
theorem words_of_bind(values: Valuation(), ids: List<Nat>): distinct(ids).IsTrue() →
    (words: List<BitVec(64)>) → ids.len() = words.len() → words_of(Valuation::bind(values, ids, words), ids) = words {
    match ids {
        Nil => λ _ words => match words {
            Nil => λ _ => refl,
            Cons(_, more) => λ (bad: 0 = Succ(more.len())) => false_elim(more.len().zero_ne_succ(bad)),
        },
        Cons(id, rest) => λ apart words => match words {
            Nil => λ (bad: Succ(rest.len()) = 0) => false_elim(rest.len().succ_ne_zero(bad)),
            Cons(word, more) => λ (same: Succ(rest.len()) = Succ(more.len())) => {
                let parts = Bool::is_true_and(absent(id, rest), distinct(rest), apart);
                let inner = Valuation::bind(values, rest, more);
                let head = trans(Valuation::set_here(inner, id, word_value(word), 64), word_value_word(word));
                let kept = words_agree(rest, inner, Valuation::set(inner, id, word_value(word)), λ x m =>
                    Valuation::set_other(inner, id, word_value(word), 64, x, λ e => absent_mem(id, rest, parts.left, x, m, sym(e))));
                let tail = trans(kept, words_of_bind(values, rest, parts.right, more, Nat::succ_inj(rest.len(), more.len(), same)));
                eq2(λ (w: BitVec(64)) (ws: List<BitVec(64)>) => Cons(w, ws), head, tail)
            },
        },
    }
}

// Binding ids leaves every other id as it was.
theorem Valuation::bind_frame(values: Valuation(), ids: List<Nat>): (words: List<BitVec(64)>) → (w, id: Nat) →
    absent(id, ids).IsTrue() → Valuation::bind(values, ids, words)(w, id) = values(w, id) {
    match ids {
        Nil => λ words w id _ => refl,
        Cons(x, rest) => λ words => match words {
            Nil => λ w id _ => refl,
            Cons(word, more) => λ w id h => {
                let parts = Bool::is_true_and(id.differs(x), absent(id, rest), h);
                trans(Valuation::set_other(Valuation::bind(values, rest, more), x, word_value(word), w, id, id.differs_ne(x, parts.left)),
                    Valuation::bind_frame(values, rest, more, w, id, parts.right))
            },
        },
    }
}

theorem BitVec::head_bit_ofBool(b: Bool): BitVec::ofBool(b).head_bit() = b { match b { False => refl, True => refl } }

// ---------------------------------------------------------------------------
// Buffers, as a byte node reads them

// A file of buffers by id, each a list of bytes.
fn Buffers() → Type { List<List<BitVec(8)>> }

// Byte `index` of buffer `buffer`: zero past the end of either.
fn buffer_byte(buffers: Buffers(), buffer, index: Nat) → BitVec(8) {
    match buffers.nth(buffer) {
        None => BitVec::zero(),
        Some(bytes) => match bytes.nth(index) { None => BitVec::zero(), Some(byte) => byte },
    }
}

// A byte as a word, zero-extended, as a load leaves it in a register.
fn byte_word(byte: BitVec(8)) → BitVec(64) { byte.zero_extend(56) }

// What a byte node's output holds over `buffers`, the index read off
// `values`.
fn load_value(buffers: Buffers(), buffer, index: Nat, values: Valuation()) → (w: Nat) → BitVec(w) {
    word_value(byte_word(buffer_byte(buffers, buffer, values(64, index).toNat())))
}

// ---------------------------------------------------------------------------
// Nodes

fn Node::reads(self node: Node) → List<Nat> {
    match node {
        Const(_, _, _) => [],
        Move(_, _, source) => [source],
        Add(_, _, left, right) => [left, right],
        Sub(_, _, left, right) => [left, right],
        BitAnd(_, _, left, right) => [left, right],
        BitOr(_, _, left, right) => [left, right],
        BitXor(_, _, left, right) => [left, right],
        ShiftLeft(_, _, value, _) => [value],
        LogicalShiftRight(_, _, value, _) => [value],
        ArithmeticShiftRight(_, _, value, _) => [value],
        UnsignedLessThan(_, _, left, right) => [left, right],
        SignedLessThan(_, _, left, right) => [left, right],
        Equal(_, _, left, right) => [left, right],
        BufferLoad(_, _, index) => [index],
        BufferStore(_, _, index, value) => [index, value],
        Resize(_, _, _, source) => [source],
        SignResize(_, _, _, source) => [source],
    }
}

fn Node::mentions(self node: Node) → List<Nat> { Cons(node_output(node).id, node.reads()) }

// The node's equation's right side, at each width. A byte node's value is
// the one it takes over no buffers, every byte zero: what
// `function_ir_state`'s `run` gives it from an empty file.
fn Node::value(self node: Node, values: Valuation()) → (w: Nat) → BitVec(w) {
    match node {
        Const(_, _, value) => λ w => BitVec::ofNat(value),
        Move(_, _, source) => λ w => values(w, source),
        Add(_, _, left, right) => λ w => values(w, left).add(values(w, right)),
        Sub(_, _, left, right) => λ w => values(w, left).sub(values(w, right)),
        BitAnd(_, _, left, right) => λ w => values(w, left).band(values(w, right)),
        BitOr(_, _, left, right) => λ w => values(w, left).bor(values(w, right)),
        BitXor(_, _, left, right) => λ w => values(w, left).bxor(values(w, right)),
        ShiftLeft(_, _, value, amount) => λ w => values(w, value).shift_left(amount),
        LogicalShiftRight(_, _, value, amount) => λ w => values(w, value).shift_right(amount),
        ArithmeticShiftRight(_, _, value, amount) => λ w => values(w, value).arithmetic_shift_right(amount),
        UnsignedLessThan(width, _, left, right) => bit_value(values(width, left).unsigned_lt_bit(values(width, right))),
        SignedLessThan(width, _, left, right) => bit_value(values(width, left).signed_lt_bit(values(width, right))),
        Equal(width, _, left, right) => bit_value(values(width, left).eq_bit(values(width, right))),
        BufferLoad(_, buffer, index) => load_value(Nil, buffer, index, values),
        BufferStore(_, buffer, index, _) => load_value(Nil, buffer, index, values),
        Resize(from, _, _, source) => λ w => BitVec::ofNat(values(from, source).toNat()),
        SignResize(from, _, _, source) => λ w => values(from, source).sresize(w),
    }
}

fn Node::step(self node: Node, values: Valuation()) → Valuation() { Valuation::set(values, node_output(node).id, node.value(values)) }

// A valuation whose output is the node's value and whose operands are as
// they were satisfies the node.
theorem Node::holds_of(self node: Node, values, after: Valuation()):
    ((w: Nat) → after(w, node_output(node).id) = node.value(values)(w)) →
    ((w: Nat) → (id: Nat) → Mem(id, node.reads()) → after(w, id) = values(w, id)) → NodeHolds(after, node) {
    match node {
        Const(width, _, _) => λ at_output kept => at_output(width),
        Move(width, _, source) => λ at_output kept => trans(at_output(width), sym(kept(width, source, Inl(refl)))),
        Add(width, _, left, right) => λ at_output kept => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.add(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        Sub(width, _, left, right) => λ at_output kept => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.sub(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitAnd(width, _, left, right) => λ at_output kept => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.band(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitOr(width, _, left, right) => λ at_output kept => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.bor(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitXor(width, _, left, right) => λ at_output kept => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.bxor(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        ShiftLeft(width, _, value, amount) => λ at_output kept => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.shift_left(amount), kept(width, value, Inl(refl))))),
        LogicalShiftRight(width, _, value, amount) => λ at_output kept => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.shift_right(amount), kept(width, value, Inl(refl))))),
        ArithmeticShiftRight(width, _, value, amount) => λ at_output kept => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.arithmetic_shift_right(amount), kept(width, value, Inl(refl))))),
        UnsignedLessThan(width, _, left, right) => λ at_output kept => trans(at_output(1), trans(
            bit_value_bit(values(width, left).unsigned_lt_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        SignedLessThan(width, _, left, right) => λ at_output kept => trans(at_output(1), trans(
            bit_value_bit(values(width, left).signed_lt_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        Equal(width, _, left, right) => λ at_output kept => trans(at_output(1), trans(
            bit_value_bit(values(width, left).eq_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        BufferLoad(_, _, _) => λ at_output kept => trivial,
        BufferStore(_, _, _, _) => λ at_output kept => trivial,
        Resize(from, to, _, source) => λ at_output kept => trans(at_output(to),
            sym(cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := to), kept(from, source, Inl(refl))))),
        SignResize(from, to, _, source) => λ at_output kept => trans(at_output(to),
            sym(cong_fn(λ (x: BitVec(from)) => x.sresize(to), kept(from, source, Inl(refl))))),
    }
}

// ---------------------------------------------------------------------------
// Schedules of nodes

fn eval_nodes(nodes: List<Node>, values: Valuation()) → Valuation() {
    match nodes { Nil => values, Cons(node, rest) => eval_nodes(rest, node.step(values)) }
}

fn Region::eval(self region: Region, values: Valuation()) → Valuation() { eval_nodes(region.nodes, values) }

fn nodes_writes(nodes: List<Node>) → List<Nat> {
    match nodes { Nil => [], Cons(node, rest) => Cons(node_output(node).id, nodes_writes(rest)) }
}

fn nodes_mentions(nodes: List<Node>) → List<Nat> {
    match nodes { Nil => [], Cons(node, rest) => node.mentions() ++ nodes_mentions(rest) }
}

// No node reads its own output, and nothing later writes an id a node
// mentions.
fn nodes_evaluable(nodes: List<Node>) → Bool {
    match nodes {
        Nil => True,
        Cons(node, rest) => absent(node_output(node).id, node.reads())
            && (disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest)),
    }
}

theorem eval_nodes_frame(nodes: List<Node>): (values: Valuation()) → (w, id: Nat) → absent(id, nodes_writes(nodes)).IsTrue() →
    eval_nodes(nodes, values, w, id) = values(w, id) {
    match nodes {
        Nil => λ values w id _ => refl,
        Cons(node, rest) => λ values w id h => {
            let parts = Bool::is_true_and(id.differs(node_output(node).id), absent(id, nodes_writes(rest)), h);
            trans(eval_nodes_frame(rest, node.step(values), w, id, parts.right),
                Valuation::set_other(values, node_output(node).id, node.value(values), w, id, id.differs_ne(node_output(node).id, parts.left)))
        },
    }
}

// Any valuation agreeing with the evaluated one on what the nodes mention
// satisfies them.
theorem eval_nodes_holds(nodes: List<Node>): nodes_evaluable(nodes).IsTrue() → (values, after: Valuation()) →
    ((w: Nat) → (id: Nat) → Mem(id, nodes_mentions(nodes)) → after(w, id) = eval_nodes(nodes, values, w, id)) →
    NodesHold(after, nodes) {
    match nodes {
        Nil => λ _ values after _ => trivial,
        Cons(node, rest) => λ ok values after agree => {
            let output = node_output(node).id;
            let parts = Bool::is_true_and(absent(output, node.reads()),
                disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest), ok);
            let later = Bool::is_true_and(disjoint(nodes_writes(rest), node.mentions()), nodes_evaluable(rest), parts.right);
            let stepped = node.step(values);
            let at_output = λ (w: Nat) => trans(agree(w, output, List::mem_append_l(node.mentions(), nodes_mentions(rest), output, Inl(refl))),
                trans(eval_nodes_frame(rest, stepped, w, output, disjoint_mem(nodes_writes(rest), node.mentions(), later.left, output, Inl(refl))),
                    Valuation::set_here(values, output, node.value(values), w)));
            let kept = λ (w: Nat) (id: Nat) (m: Mem(id, node.reads())) =>
                trans(agree(w, id, List::mem_append_l(node.mentions(), nodes_mentions(rest), id, Inr(m))),
                    trans(eval_nodes_frame(rest, stepped, w, id, disjoint_mem(nodes_writes(rest), node.mentions(), later.left, id, Inr(m))),
                        Valuation::set_other(values, output, node.value(values), w, id,
                            λ e => absent_mem(output, node.reads(), parts.left, id, m, sym(e)))));
            ⟨node.holds_of(values, after, at_output, kept),
                eval_nodes_holds(rest, later.right, stepped, after,
                    λ w id m => agree(w, id, List::mem_append_r(node.mentions(), nodes_mentions(rest), id, m)))⟩
        },
    }
}

// ---------------------------------------------------------------------------
// Structured regions

// What a call is answered with: function `f` on words.
fn Answers() → Type { Nat → List<BitVec(64)> → BitVec(64) }

// How a loop ends: its state, and whether its passes ran out.
record LoopEnd { state: List<BitVec(64)>, exhausted: Bool }

// A pass's own valuation: the state at the parameters, the passes left at
// `count`.
fn pass_valuation(parameters: List<Nat>, count, remaining: Nat, state: List<BitVec(64)>) → Valuation() {
    Valuation::bind(Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(remaining))), parameters, state)
}

// The loop's passes, each run by `step`, from `state` with `remaining`
// passes left.
fn loop_eval(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat) →
    List<BitVec(64)> → LoopEnd {
    match remaining {
        Zero => λ state => LoopEnd(state, True),
        Succ(rest) => λ state => {
            let after = step(pass_valuation(parameters, count, Succ(rest), state));
            match after(1, exit).head_bit() {
                False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                True => LoopEnd(words_of(after, next), False),
            }
        },
    }
}

// The loop's final state is a state: as many words as parameters.
theorem loop_eval_len(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() →
    loop_eval(step, parameters, count, exit, next, remaining, state).state.len() = parameters.len() {
    match remaining {
        Zero => λ state same => same,
        Succ(rest) => λ state same => {
            let after = step(pass_valuation(parameters, count, Succ(rest), state));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            match after(1, exit).head_bit() {
                False => loop_eval_len(step, parameters, count, exit, next, lengths, rest, words_of(after, next), next_len),
                True => next_len,
            }
        },
    }
}

// What the loop evaluates to is a run of it, when each pass's step
// satisfies `pass` and keeps the parameters and the count.
theorem loop_eval_runs(pass: Valuation() → Type, step: Valuation() → Valuation(), holds: (v: Valuation()) → pass(step(v)),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, apart: distinct(Cons(count, parameters)).IsTrue(),
    kept: (v: Valuation()) → (w, id: Nat) → Mem(id, Cons(count, parameters)) → step(v)(w, id) = v(w, id),
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() →
    LoopRuns(pass, parameters, count, exit, next, remaining, state, loop_eval(step, parameters, count, exit, next, remaining, state).state,
        loop_eval(step, parameters, count, exit, next, remaining, state).exhausted) {
    match remaining {
        Zero => λ state _ => ⟨refl, refl⟩,
        Succ(rest) => λ state same => {
            let parts = Bool::is_true_and(absent(count, parameters), distinct(parameters), apart);
            let counted = Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(Succ(rest))));
            let before = pass_valuation(parameters, count, Succ(rest), state);
            let after = step(before);
            let bound: (words_of(after, parameters) = state) = trans(
                words_agree(parameters, before, after, λ id m => kept(before, 64, id, Inr(m))),
                words_of_bind(counted, parameters, parts.right, state, sym(same)));
            let at_count: (after(64, count) = BitVec::ofNat(Succ(rest))) = trans(kept(before, 64, count, Inl(refl)),
                trans(Valuation::bind_frame(counted, parameters, state, 64, count, parts.left),
                    trans(Valuation::set_here(Valuation::zero(), count, word_value(BitVec::ofNat(Succ(rest))), 64),
                        word_value_word(BitVec::ofNat(Succ(rest))))));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            Exists(after, ⟨bound, ⟨at_count, ⟨holds(before),
                match after(1, exit).head_bit() as λ b => match b as λ _ => Type {
                    False => LoopRuns(pass, parameters, count, exit, next, rest, words_of(after, next),
                        (match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state,
                        (match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).exhausted),
                    True => ((match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state = words_of(after, next)) ∧
                        ((match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).exhausted = False),
                } {
                    False => loop_eval_runs(pass, step, holds, parameters, count, exit, next, apart, kept, lengths, rest,
                        words_of(after, next), next_len),
                    True => ⟨refl, refl⟩,
                }⟩⟩⟩)
        },
    }
}

fn StructuredRegion::eval(self region: StructuredRegion, call: Answers(), values: Valuation()) → Valuation() {
    match region {
        Dataflow(body) => body.eval(values),
        Sequence(prefix, continuation) => continuation.eval(call, prefix.eval(values)),
        Compose(prefix, continuation) => continuation.eval(call, prefix.eval(call, values)),
        // Branched at each value read, so a value read from a conditional is
        // a match on the condition with each arm's value, as a source `match`
        // spells it.
        Conditional(_, condition, _, _, when_true, when_false) => λ w id => match values(1, condition).head_bit() {
            False => when_false.eval(call, values)(w, id),
            True => when_true.eval(call, values)(w, id),
        },
        Call(callee, arguments, result) => Valuation::set(values, result, word_value(call(callee, words_of(values, arguments)))),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => {
            let end = loop_eval(λ (pass: Valuation()) => body.eval(call, pass), parameters, count, exit, next, values(64, bound).toNat(),
                words_of(values, inputs));
            Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted))
        },
    }
}

fn StructuredRegion::writes(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => nodes_writes(body.nodes),
        Sequence(prefix, continuation) => nodes_writes(prefix.nodes) ++ continuation.writes(),
        Compose(prefix, continuation) => prefix.writes() ++ continuation.writes(),
        Conditional(_, _, _, _, when_true, when_false) => when_true.writes() ++ when_false.writes(),
        Call(_, _, result) => [result],
        Loop(_, _, _, _, _, _, _, outputs, exhausted) => Cons(exhausted, outputs),
    }
}

fn StructuredRegion::mentions(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => nodes_mentions(body.nodes),
        Sequence(prefix, continuation) => nodes_mentions(prefix.nodes) ++ continuation.mentions(),
        Compose(prefix, continuation) => prefix.mentions() ++ continuation.mentions(),
        Conditional(_, condition, _, _, when_true, when_false) => Cons(condition, when_true.mentions() ++ when_false.mentions()),
        Call(_, arguments, result) => Cons(result, arguments),
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => Cons(bound, inputs) ++ Cons(exhausted, outputs),
    }
}

// The function a call names takes as many words as it is given.
fn arity_fits(arity: Option<Nat>, count: Nat) → Bool {
    match arity { None => False, Some(k) => k.matches(count) }
}

fn StructuredRegion::evaluable(self region: StructuredRegion, arity: Nat → Option<Nat>) → Bool {
    match region {
        Dataflow(body) => nodes_evaluable(body.nodes),
        Sequence(prefix, continuation) => nodes_evaluable(prefix.nodes)
            && (disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity)),
        Compose(prefix, continuation) => prefix.evaluable(arity)
            && (disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity)),
        Conditional(_, condition, _, _, when_true, when_false) => absent(condition, when_true.writes() ++ when_false.writes())
            && (when_true.evaluable(arity) && when_false.evaluable(arity)),
        Call(callee, arguments, result) => absent(result, arguments) && arity_fits(arity(callee), arguments.len()),
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => body.evaluable(arity)
            && (distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
            && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
            && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
            && outputs.len().matches(parameters.len()))))))),
    }
}

// Evaluating keeps every id the region does not write.
theorem StructuredRegion::eval_frame(self region: StructuredRegion, call: Answers()): (values: Valuation()) → (w, id: Nat) →
    absent(id, region.writes()).IsTrue() → region.eval(call, values)(w, id) = values(w, id) {
    match region {
        Dataflow(body) => λ values w id h => eval_nodes_frame(body.nodes, values, w, id, h),
        Sequence(prefix, continuation) => λ values w id h => {
            let parts = absent_append(id, nodes_writes(prefix.nodes), continuation.writes(), h);
            trans(continuation.eval_frame(call, prefix.eval(values), w, id, parts.right),
                eval_nodes_frame(prefix.nodes, values, w, id, parts.left))
        },
        Compose(prefix, continuation) => λ values w id h => {
            let parts = absent_append(id, prefix.writes(), continuation.writes(), h);
            trans(continuation.eval_frame(call, prefix.eval(call, values), w, id, parts.right),
                prefix.eval_frame(call, values, w, id, parts.left))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values w id h => {
            let parts = absent_append(id, when_true.writes(), when_false.writes(), h);
            match values(1, condition).head_bit() {
                False => when_false.eval_frame(call, values, w, id, parts.right),
                True => when_true.eval_frame(call, values, w, id, parts.left),
            }
        },
        Call(callee, arguments, result) => λ values w id h =>
            Valuation::set_other(values, result, word_value(call(callee, words_of(values, arguments))), w, id,
                id.differs_ne(result, Bool::is_true_and(id.differs(result), True, h).left)),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values w id h => {
            let end = loop_eval(λ (pass: Valuation()) => body.eval(call, pass), parameters, count, exit, next, values(64, bound).toNat(),
                words_of(values, inputs));
            let parts = Bool::is_true_and(id.differs(exhausted), absent(id, outputs), h);
            trans(Valuation::set_other(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted), w, id,
                    id.differs_ne(exhausted, parts.left)),
                Valuation::bind_frame(values, outputs, end.state, w, id, parts.right))
        },
    }
}

// The theorem: when every call a region makes is answered by a result its
// callee may return, any valuation agreeing with the evaluated one on what
// the region mentions satisfies the region.
theorem StructuredRegion::eval_holds_in(self region: StructuredRegion, callees: Callees(), call: Answers(),
    arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → callees(f, words, call(f, words))):
    region.evaluable(arity).IsTrue() → (values, after: Valuation()) →
    ((w: Nat) → (id: Nat) → Mem(id, region.mentions()) → after(w, id) = region.eval(call, values)(w, id)) →
    StructuredRegionHoldsIn(callees, after, region) {
    match region {
        Dataflow(body) => λ ok values after agree => eval_nodes_holds(body.nodes, ok, values, after, agree),
        Sequence(prefix, continuation) => λ ok values after agree => {
            let parts = Bool::is_true_and(nodes_evaluable(prefix.nodes),
                disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity), parts.right);
            let first = prefix.eval(values);
            ⟨eval_nodes_holds(prefix.nodes, parts.left, values, after, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)),
                        continuation.eval_frame(call, first, w, id,
                            disjoint_mem(continuation.writes(), nodes_mentions(prefix.nodes), later.left, id, m)))),
                continuation.eval_holds_in(callees, call, arity, answers, later.right, first, after, λ w id m =>
                    agree(w, id, List::mem_append_r(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)))⟩
        },
        Compose(prefix, continuation) => λ ok values after agree => {
            let parts = Bool::is_true_and(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity), parts.right);
            let first = prefix.eval(call, values);
            ⟨prefix.eval_holds_in(callees, call, arity, answers, parts.left, values, after, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(prefix.mentions(), continuation.mentions(), id, m)),
                        continuation.eval_frame(call, first, w, id,
                            disjoint_mem(continuation.writes(), prefix.mentions(), later.left, id, m)))),
                continuation.eval_holds_in(callees, call, arity, answers, later.right, first, after, λ w id m =>
                    agree(w, id, List::mem_append_r(prefix.mentions(), continuation.mentions(), id, m)))⟩
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ ok values after agree => {
            let parts = Bool::is_true_and(absent(condition, when_true.writes() ++ when_false.writes()),
                when_true.evaluable(arity) && when_false.evaluable(arity), ok);
            let arms = Bool::is_true_and(when_true.evaluable(arity), when_false.evaluable(arity), parts.right);
            let kept: (after(1, condition) = values(1, condition)) = trans(agree(1, condition, Inl(refl)),
                Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval_frame(call, values, 1, condition, parts.left));
            let chosen = (match values(1, condition).head_bit() as λ b =>
                    ((w: Nat) → (id: Nat) → Mem(id, Cons(condition, when_true.mentions() ++ when_false.mentions())) →
                        after(w, id) = (match b { False => when_false.eval(call, values)(w, id), True => when_true.eval(call, values)(w, id) })) →
                    (match b {
                        False => StructuredRegionHoldsIn(callees, after, when_false),
                        True => StructuredRegionHoldsIn(callees, after, when_true),
                    }) {
                False => λ chose => when_false.eval_holds_in(callees, call, arity, answers, arms.right, values, after, λ w id m =>
                    chose(w, id, Inr(List::mem_append_r(when_true.mentions(), when_false.mentions(), id, m)))),
                True => λ chose => when_true.eval_holds_in(callees, call, arity, answers, arms.left, values, after, λ w id m =>
                    chose(w, id, Inr(List::mem_append_l(when_true.mentions(), when_false.mentions(), id, m)))),
            })(agree);
            j(sym(kept), λ x _ => match x.head_bit() {
                False => StructuredRegionHoldsIn(callees, after, when_false),
                True => StructuredRegionHoldsIn(callees, after, when_true),
            }, chosen)
        },
        Call(callee, arguments, result) => λ ok values after agree => {
            let parts = Bool::is_true_and(absent(result, arguments), arity_fits(arity(callee), arguments.len()), ok);
            let words = words_of(values, arguments);
            let answer = call(callee, words);
            let at_result: (after(64, result) = answer) = trans(agree(64, result, Inl(refl)),
                trans(Valuation::set_here(values, result, word_value(answer), 64), word_value_word(answer)));
            let read: (words_of(after, arguments) = words) = words_agree(arguments, values, after, λ id m =>
                trans(agree(64, id, Inr(m)), Valuation::set_other(values, result, word_value(answer), 64, id,
                    λ e => absent_mem(result, arguments, parts.left, id, m, sym(e)))));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(values, arguments)), λ n _ => arity_fits(arity(callee), n).IsTrue(), parts.right);
            j(sym(read), λ ws _ => callees(callee, ws, after(64, result)),
                j(sym(at_result), λ r _ => callees(callee, words, r), answers(callee, words, fits)))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok values after agree => {
            let pass = λ (v: Valuation()) => StructuredRegionHoldsIn(callees, v, body);
            let step = λ (v: Valuation()) => body.eval(call, v);
            let p1 = Bool::is_true_and(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            let p2 = Bool::is_true_and(distinct(Cons(count, parameters)), disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))))), p1.right);
            let p3 = Bool::is_true_and(disjoint(body.writes(), Cons(count, parameters)), distinct(Cons(exhausted, outputs))
                && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))), p2.right);
            let p4 = Bool::is_true_and(distinct(Cons(exhausted, outputs)), disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))), p3.right);
            let p5 = Bool::is_true_and(disjoint(Cons(exhausted, outputs), Cons(bound, inputs)), inputs.len().matches(parameters.len())
                && (next.len().matches(parameters.len()) && outputs.len().matches(parameters.len())), p4.right);
            let p6 = Bool::is_true_and(inputs.len().matches(parameters.len()),
                next.len().matches(parameters.len()) && outputs.len().matches(parameters.len()), p5.right);
            let p7 = Bool::is_true_and(next.len().matches(parameters.len()), outputs.len().matches(parameters.len()), p6.right);
            let outs = Bool::is_true_and(absent(exhausted, outputs), distinct(outputs), p4.left);
            let in_len: (words_of(values, inputs).len() = parameters.len()) =
                trans(words_of_len(values, inputs), inputs.len().matches_eq(parameters.len(), p6.left));
            let next_len: (next.len() = parameters.len()) = next.len().matches_eq(parameters.len(), p7.left);
            let n = values(64, bound).toNat();
            let start = words_of(values, inputs);
            let end = loop_eval(step, parameters, count, exit, next, n, start);
            let region = Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted);
            let bound_after: (after(64, bound) = values(64, bound)) = trans(agree(64, bound, Inl(refl)),
                region.eval_frame(call, values, 64, bound, disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, bound, Inl(refl))));
            let inputs_after: (words_of(after, inputs) = start) = words_agree(inputs, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_l(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                    region.eval_frame(call, values, 64, id, disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, id, Inr(m)))));
            let bound_values = Valuation::bind(values, outputs, end.state);
            let outputs_after: (words_of(after, outputs) = end.state) = trans(
                words_agree(outputs, bound_values, after, λ id m =>
                    trans(agree(64, id, List::mem_append_r(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                        Valuation::set_other(bound_values, exhausted, bit_value(end.exhausted), 64, id,
                            λ e => absent_mem(exhausted, outputs, outs.left, id, m, sym(e))))),
                words_of_bind(values, outputs, outs.right, end.state,
                    trans(outputs.len().matches_eq(parameters.len(), p7.right),
                        sym(loop_eval_len(step, parameters, count, exit, next, next_len, n, start, in_len)))));
            let exhausted_after: (after(1, exhausted).head_bit() = end.exhausted) = trans(
                cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), trans(agree(1, exhausted, List::mem_append_r(Cons(bound, inputs),
                    Cons(exhausted, outputs), exhausted, Inl(refl))),
                    trans(Valuation::set_here(bound_values, exhausted, bit_value(end.exhausted), 1), bit_value_bit(end.exhausted)))),
                BitVec::head_bit_ofBool(end.exhausted));
            let runs = loop_eval_runs(pass, step,
                λ v => body.eval_holds_in(callees, call, arity, answers, p1.left, v, body.eval(call, v), λ w id m => refl),
                parameters, count, exit, next, p2.left,
                λ v w id m => body.eval_frame(call, v, w, id, disjoint_mem(body.writes(), Cons(count, parameters), p3.left, id, m)),
                next_len, n, start, in_len);
            j(sym(exhausted_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), words_of(after, inputs),
                    words_of(after, outputs), x),
                j(sym(outputs_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), words_of(after, inputs),
                        x, end.exhausted),
                    j(sym(inputs_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), x, end.state,
                            end.exhausted),
                        j(sym(bound_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, x.toNat(), start, end.state, end.exhausted),
                            runs))))
        },
    }
}

// ---------------------------------------------------------------------------
// Evaluation reads its valuation only pointwise, and its calls only at the
// calls it makes: from valuations that agree, with calls answered alike, a
// region evaluates alike. This is what lets a program's functions be proved
// one at a time, each call answered by its callee's meaning rather than its
// evaluation (`program_eval_sources`, below).

// `other` agrees with `values` at every width and id.
fn Valuation::Same(values, other: Valuation()) → Type { (w: Nat) → (id: Nat) → other(w, id) = values(w, id) }

theorem Valuation::set_same(values, other: Valuation(), same: Valuation::Same(values, other), id: Nat,
    value, value2: (w: Nat) → BitVec(w), at: (w: Nat) → value2(w) = value(w)):
    Valuation::Same(Valuation::set(values, id, value), Valuation::set(other, id, value2)) {
    λ w query => match query.eq_dec(id) {
        Inl(_) => at(w),
        Inr(_) => same(w, query),
    }
}

theorem Valuation::bind_same(values, other: Valuation(), same: Valuation::Same(values, other), ids: List<Nat>):
    (words: List<BitVec(64)>) → Valuation::Same(Valuation::bind(values, ids, words), Valuation::bind(other, ids, words)) {
    match ids {
        Nil => λ words => same,
        Cons(id, rest) => λ words => match words {
            Nil => same,
            Cons(word, more) => Valuation::set_same(Valuation::bind(values, rest, more), Valuation::bind(other, rest, more),
                Valuation::bind_same(values, other, same, rest, more), id, word_value(word), word_value(word), λ w => refl),
        },
    }
}

theorem Node::value_same(self node: Node, values, other: Valuation(), same: Valuation::Same(values, other)):
    (w: Nat) → node.value(other)(w) = node.value(values)(w) {
    match node {
        Const(_, _, _) => λ w => refl,
        Move(_, _, source) => λ w => same(w, source),
        Add(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y), same(w, left), same(w, right)),
        Sub(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y), same(w, left), same(w, right)),
        BitAnd(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y), same(w, left), same(w, right)),
        BitOr(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y), same(w, left), same(w, right)),
        BitXor(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y), same(w, left), same(w, right)),
        ShiftLeft(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.shift_left(amount), same(w, value)),
        LogicalShiftRight(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.shift_right(amount), same(w, value)),
        ArithmeticShiftRight(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.arithmetic_shift_right(amount), same(w, value)),
        UnsignedLessThan(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y), same(width, left), same(width, right))),
        SignedLessThan(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y), same(width, left), same(width, right))),
        Equal(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y), same(width, left), same(width, right))),
        BufferLoad(_, buffer, index) => λ w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(Nil, buffer, x.toNat())), w),
            same(64, index)),
        BufferStore(_, buffer, index, _) => λ w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(Nil, buffer, x.toNat())), w),
            same(64, index)),
        Resize(from, _, _, source) => λ w => cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := w), same(from, source)),
        SignResize(from, _, _, source) => λ w => cong_fn(λ (x: BitVec(from)) => x.sresize(w), same(from, source)),
    }
}

theorem eval_nodes_same(nodes: List<Node>): (values, other: Valuation()) → Valuation::Same(values, other) →
    Valuation::Same(eval_nodes(nodes, values), eval_nodes(nodes, other)) {
    match nodes {
        Nil => λ values other same => same,
        Cons(node, rest) => λ values other same => eval_nodes_same(rest, node.step(values), node.step(other),
            Valuation::set_same(values, other, same, node_output(node).id, node.value(values), node.value(other), node.value_same(values, other, same))),
    }
}

// Loops whose passes agree run alike.
theorem loop_eval_same(step, other_step: Valuation() → Valuation(), same: (v: Valuation()) → Valuation::Same(step(v), other_step(v)),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → loop_eval(other_step, parameters, count, exit, next, remaining, state) =
        loop_eval(step, parameters, count, exit, next, remaining, state) {
    match remaining {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let entry = pass_valuation(parameters, count, Succ(rest), state);
            let after = step(entry);
            let bit: (other_step(entry, 1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(entry, 1, exit));
            let words: (words_of(other_step(entry), next) = words_of(after, next)) =
                words_agree(next, after, other_step(entry), λ id _ => same(entry, 64, id));
            let moved = eq2(λ (b: Bool) (ws: List<BitVec(64)>) => match b {
                    False => loop_eval(other_step, parameters, count, exit, next, rest, ws),
                    True => LoopEnd(ws, False),
                }, bit, words);
            trans(moved, match after(1, exit).head_bit() as λ b =>
                (match b { False => loop_eval(other_step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) =
                (match b { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) {
                False => loop_eval_same(step, other_step, same, parameters, count, exit, next, rest, words_of(after, next)),
                True => refl,
            })
        },
    }
}

// Every call names a function of the arity it is given: all that answering
// a region's calls alike needs of it (`eval_answers`). Linear in the
// region, where `evaluable`'s disjointness checks are quadratic, so a
// program built from functions already checked (a runtime fn's callees,
// issues/runtime-fn-caller-agreement-fuel.md) is linked by this alone.
fn StructuredRegion::calls_fit(self region: StructuredRegion, arity: Nat → Option<Nat>) → Bool {
    match region {
        Dataflow(_) => True,
        Sequence(_, continuation) => continuation.calls_fit(arity),
        Compose(prefix, continuation) => prefix.calls_fit(arity) && continuation.calls_fit(arity),
        Conditional(_, _, _, _, when_true, when_false) => when_true.calls_fit(arity) && when_false.calls_fit(arity),
        Call(callee, arguments, _) => arity_fits(arity(callee), arguments.len()),
        Loop(_, _, _, _, body, _, _, _, _) => body.calls_fit(arity),
    }
}

theorem StructuredRegion::evaluable_calls_fit(self region: StructuredRegion, arity: Nat → Option<Nat>):
    region.evaluable(arity).IsTrue() → region.calls_fit(arity).IsTrue() {
    match region {
        Dataflow(_) => λ _ => trivial,
        Sequence(prefix, continuation) => λ ok => {
            let parts = Bool::is_true_and(nodes_evaluable(prefix.nodes),
                disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity), parts.right);
            continuation.evaluable_calls_fit(arity, later.right)
        },
        Compose(prefix, continuation) => λ ok => {
            let parts = Bool::is_true_and(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity), parts.right);
            Bool::is_true_and_intro(prefix.calls_fit(arity), continuation.calls_fit(arity),
                prefix.evaluable_calls_fit(arity, parts.left), continuation.evaluable_calls_fit(arity, later.right))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ ok => {
            let parts = Bool::is_true_and(absent(condition, when_true.writes() ++ when_false.writes()),
                when_true.evaluable(arity) && when_false.evaluable(arity), ok);
            let arms = Bool::is_true_and(when_true.evaluable(arity), when_false.evaluable(arity), parts.right);
            Bool::is_true_and_intro(when_true.calls_fit(arity), when_false.calls_fit(arity),
                when_true.evaluable_calls_fit(arity, arms.left), when_false.evaluable_calls_fit(arity, arms.right))
        },
        Call(callee, arguments, result) => λ ok => Bool::is_true_and(absent(result, arguments), arity_fits(arity(callee), arguments.len()), ok).right,
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok => {
            let passes = Bool::is_true_and(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            body.evaluable_calls_fit(arity, passes.left)
        },
    }
}

// The theorem: a region whose calls fit, its calls answered alike wherever
// the arities fit, evaluates alike from agreeing valuations.
theorem StructuredRegion::eval_answers(self region: StructuredRegion, call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words)):
    region.calls_fit(arity).IsTrue() → (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval(call, values), region.eval(other, others)) {
    match region {
        Dataflow(body) => λ ok values others same => eval_nodes_same(body.nodes, values, others, same),
        Sequence(prefix, continuation) => λ ok values others same =>
            continuation.eval_answers(call, other, arity, answers, ok, prefix.eval(values), prefix.eval(others),
                eval_nodes_same(prefix.nodes, values, others, same)),
        Compose(prefix, continuation) => λ ok values others same => {
            let parts = Bool::is_true_and(prefix.calls_fit(arity), continuation.calls_fit(arity), ok);
            continuation.eval_answers(call, other, arity, answers, parts.right, prefix.eval(call, values), prefix.eval(other, others),
                prefix.eval_answers(call, other, arity, answers, parts.left, values, others, same))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ ok values others same => λ w id => {
            let arms = Bool::is_true_and(when_true.calls_fit(arity), when_false.calls_fit(arity), ok);
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = match values(1, condition).head_bit() as λ b =>
                (match b { False => when_false.eval(other, others)(w, id), True => when_true.eval(other, others)(w, id) }) =
                (match b { False => when_false.eval(call, values)(w, id), True => when_true.eval(call, values)(w, id) }) {
                False => when_false.eval_answers(call, other, arity, answers, arms.right, values, others, same, w, id),
                True => when_true.eval_answers(call, other, arity, answers, arms.left, values, others, same, w, id),
            };
            j(bit, λ b _ => (match b { False => when_false.eval(other, others)(w, id), True => when_true.eval(other, others)(w, id) }) =
                (match values(1, condition).head_bit() {
                    False => when_false.eval(call, values)(w, id),
                    True => when_true.eval(call, values)(w, id),
                }), aligned)
        },
        Call(callee, arguments, result) => λ ok values others same => {
            let words = words_of(values, arguments);
            let read: (words_of(others, arguments) = words) = words_agree(arguments, values, others, λ id _ => same(64, id));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(values, arguments)), λ n _ => arity_fits(arity(callee), n).IsTrue(), ok);
            let answered: (other(callee, words_of(others, arguments)) = call(callee, words)) =
                trans(cong_fn(λ (ws: List<BitVec(64)>) => other(callee, ws), read), answers(callee, words, fits));
            Valuation::set_same(values, others, same, result, word_value(call(callee, words)), word_value(other(callee, words_of(others, arguments))),
                λ w => cong_fn(λ (x: BitVec(64)) => word_value(x, w), answered))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok values others same => {
            let step = λ (pass: Valuation()) => body.eval(call, pass);
            let other_step = λ (pass: Valuation()) => body.eval(other, pass);
            let end = loop_eval(step, parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs));
            let ran: (loop_eval(other_step, parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)) = end) =
                trans(loop_eval_same(step, other_step, λ v => body.eval_answers(call, other, arity, answers, ok, v, v, λ w id => refl),
                        parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)),
                    eq2(λ (n: Nat) (s: List<BitVec(64)>) => loop_eval(step, parameters, count, exit, next, n, s),
                        cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound)), words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(others, outputs, e.state), exhausted, bit_value(e.exhausted))),
                Valuation::set_same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, end.state),
                    Valuation::bind_same(values, others, same, outputs, end.state), exhausted, bit_value(end.exhausted), bit_value(end.exhausted),
                    λ w => refl))
        },
    }
}

// ---------------------------------------------------------------------------
// Functions and programs

// Called on `arguments`: the parameters bound, the body evaluated, the
// result read.
fn Function::eval(self function: Function, call: Answers(), arguments: List<BitVec(64)>) → BitVec(64) {
    function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments))(64, function.result)
}

fn Function::evaluable(self function: Function, arity: Nat → Option<Nat>) → Bool {
    function.body.evaluable(arity) && (distinct(function.parameters) && disjoint(function.body.writes(), function.parameters))
}

fn Function::calls_fit(self function: Function, arity: Nat → Option<Nat>) → Bool { function.body.calls_fit(arity) }

theorem Function::evaluable_calls_fit(self function: Function, arity: Nat → Option<Nat>, ok: function.evaluable(arity).IsTrue()):
    function.calls_fit(arity).IsTrue() {
    function.body.evaluable_calls_fit(arity, Bool::is_true_and(function.body.evaluable(arity),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok).left)
}

// A function whose calls fit, its calls answered alike wherever the
// arities fit, returns alike.
theorem Function::eval_answers(self function: Function, call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>): function.eval(other, arguments) = function.eval(call, arguments) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    StructuredRegion::eval_answers(function.body, call, other, arity, answers, ok, bound, bound, λ w id => refl, 64, function.result)
}

// A program's functions, each answering its calls by the functions after
// it, as `program_callees` orders them.
fn program_eval(functions: List<Function>) → Answers() {
    match functions {
        Nil => λ _ _ => BitVec::zero(),
        Cons(last, earlier) => λ f arguments => match f.eq_dec(earlier.len()) {
            Inl(_) => last.eval(program_eval(earlier), arguments),
            Inr(_) => program_eval(earlier, f, arguments),
        },
    }
}

fn program_arity(functions: List<Function>) → Nat → Option<Nat> {
    match functions {
        Nil => λ _ => None,
        Cons(last, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => Some(last.parameters.len()),
            Inr(_) => program_arity(earlier, f),
        },
    }
}

fn program_evaluable(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.evaluable(program_arity(earlier)) && program_evaluable(earlier),
    }
}

// ---------------------------------------------------------------------------
// Linking: a function written against a numbering of its own callees, put
// into a program that numbers them differently, has its calls renamed. It
// evaluates as before, each call answered at its new name
// (docs/runtime-fn-setups-design.md §16.9).

fn StructuredRegion::relabel(self region: StructuredRegion, links: Nat → Nat) → StructuredRegion {
    match region {
        Dataflow(body) => Dataflow(body),
        Sequence(prefix, continuation) => Sequence(prefix, continuation.relabel(links)),
        Compose(prefix, continuation) => Compose(prefix.relabel(links), continuation.relabel(links)),
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) =>
            Conditional(inputs, condition, arguments, outputs, when_true.relabel(links), when_false.relabel(links)),
        Call(callee, arguments, result) => Call(links(callee), arguments, result),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) =>
            Loop(inputs, bound, parameters, count, body.relabel(links), exit, next, outputs, exhausted),
    }
}

fn Function::relabel(self function: Function, links: Nat → Nat) → Function {
    Function(function.parameters, function.body.relabel(links), function.result)
}

// Calls answered at their renamed functions.
fn Answers::relabel(call: Answers(), links: Nat → Nat) → Answers() { λ f words => call(links(f), words) }

theorem StructuredRegion::relabel_eval(self region: StructuredRegion, call: Answers(), links: Nat → Nat):
    (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval(Answers::relabel(call, links), values), region.relabel(links).eval(call, others)) {
    match region {
        Dataflow(body) => λ values others same => eval_nodes_same(body.nodes, values, others, same),
        Sequence(prefix, continuation) => λ values others same =>
            continuation.relabel_eval(call, links, prefix.eval(values), prefix.eval(others), eval_nodes_same(prefix.nodes, values, others, same)),
        Compose(prefix, continuation) => λ values others same =>
            continuation.relabel_eval(call, links, prefix.eval(Answers::relabel(call, links), values), prefix.relabel(links).eval(call, others),
                prefix.relabel_eval(call, links, values, others, same)),
        Conditional(_, condition, _, _, when_true, when_false) => λ values others same => λ w id => {
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = match values(1, condition).head_bit() as λ b =>
                (match b { False => when_false.relabel(links).eval(call, others)(w, id), True => when_true.relabel(links).eval(call, others)(w, id) }) =
                (match b {
                    False => when_false.eval(Answers::relabel(call, links), values)(w, id),
                    True => when_true.eval(Answers::relabel(call, links), values)(w, id),
                }) {
                False => when_false.relabel_eval(call, links, values, others, same, w, id),
                True => when_true.relabel_eval(call, links, values, others, same, w, id),
            };
            j(bit, λ b _ => (match b { False => when_false.relabel(links).eval(call, others)(w, id), True => when_true.relabel(links).eval(call, others)(w, id) }) =
                (match values(1, condition).head_bit() {
                    False => when_false.eval(Answers::relabel(call, links), values)(w, id),
                    True => when_true.eval(Answers::relabel(call, links), values)(w, id),
                }), aligned)
        },
        Call(callee, arguments, result) => λ values others same => {
            let read: (words_of(others, arguments) = words_of(values, arguments)) = words_agree(arguments, values, others, λ id _ => same(64, id));
            Valuation::set_same(values, others, same, result, word_value(call(links(callee), words_of(values, arguments))),
                word_value(call(links(callee), words_of(others, arguments))),
                λ w => cong_fn(λ (ws: List<BitVec(64)>) => word_value(call(links(callee), ws), w), read))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values others same => {
            let step = λ (pass: Valuation()) => body.eval(Answers::relabel(call, links), pass);
            let other_step = λ (pass: Valuation()) => body.relabel(links).eval(call, pass);
            let end = loop_eval(step, parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs));
            let ran: (loop_eval(other_step, parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)) = end) =
                trans(loop_eval_same(step, other_step, λ v => body.relabel_eval(call, links, v, v, λ w id => refl),
                        parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)),
                    eq2(λ (n: Nat) (s: List<BitVec(64)>) => loop_eval(step, parameters, count, exit, next, n, s),
                        cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound)), words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(others, outputs, e.state), exhausted, bit_value(e.exhausted))),
                Valuation::set_same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, end.state),
                    Valuation::bind_same(values, others, same, outputs, end.state), exhausted, bit_value(end.exhausted), bit_value(end.exhausted),
                    λ w => refl))
        },
    }
}

theorem Function::relabel_eval(self function: Function, call: Answers(), links: Nat → Nat, arguments: List<BitVec(64)>):
    function.relabel(links).eval(call, arguments) = function.eval(Answers::relabel(call, links), arguments) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    function.body.relabel_eval(call, links, bound, bound, λ w id => refl, 64, function.result)
}

// ---------------------------------------------------------------------------
// A function at a time. The compiler proves each function of a program
// against a `sources` that answers every call with the callee's source
// function, so no function's proof unfolds another's: a callee that decides
// a connective, or runs a loop, is one call in its caller's conversion. The
// program's own answers, each function's evaluation, are then those sources
// by induction along the program (`program_eval_sources`).

// Every function of the program, its calls answered by `sources`, returns
// `sources` at its own index.
fn program_sourced(functions: List<Function>, sources: Answers()) → Type {
    match functions {
        Nil => True,
        Cons(last, earlier) =>
            ((words: List<BitVec(64)>) → words.len() = last.parameters.len() → last.eval(sources, words) = sources(earlier.len(), words))
            ∧ program_sourced(earlier, sources),
    }
}

// Every function's calls name earlier functions at their arity: what
// `program_eval_sources` needs, linear in the program (`calls_fit`).
fn program_calls_fit(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.calls_fit(program_arity(earlier)) && program_calls_fit(earlier),
    }
}

theorem program_evaluable_calls_fit(functions: List<Function>): program_evaluable(functions).IsTrue() → program_calls_fit(functions).IsTrue() {
    match functions {
        Nil => λ _ => trivial,
        Cons(last, earlier) => λ ok => {
            let parts = Bool::is_true_and(last.evaluable(program_arity(earlier)), program_evaluable(earlier), ok);
            Bool::is_true_and_intro(last.calls_fit(program_arity(earlier)), program_calls_fit(earlier),
                last.evaluable_calls_fit(program_arity(earlier), parts.left), program_evaluable_calls_fit(earlier, parts.right))
        },
    }
}

// `program_eval_sources` from `program_calls_fit` alone: what a runtime fn's
// `f::agrees` links its program with (issues/runtime-fn-caller-agreement-fuel.md).
theorem program_fit_sources(functions: List<Function>, ok: program_calls_fit(functions).IsTrue(), sources: Answers(),
    sourced: program_sourced(functions, sources)):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
        program_eval(functions, f, words) = sources(f, words) {
    match functions {
        Nil => λ f words never => false_elim(never),
        Cons(last, earlier) => λ f words => {
            let parts = Bool::is_true_and(last.calls_fit(program_arity(earlier)), program_calls_fit(earlier), ok);
            let ih = program_fit_sources(earlier, parts.right, sources, sourced.right);
            (match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, f) },
                    words.len()).IsTrue() →
                (match d as λ _ => BitVec(64) { Inl(_) => last.eval(program_eval(earlier), words), Inr(_) => program_eval(earlier, f, words) }) =
                    sources(f, words) {
                Inl(e) => λ fits => trans(last.eval_answers(sources, program_eval(earlier), program_arity(earlier), ih, parts.left, words),
                    j(sym(e), λ g _ => last.eval(sources, words) = sources(g, words),
                        sourced.left(words, sym(last.parameters.len().matches_eq(words.len(), fits))))),
                Inr(_) => λ fits => ih(f, words, fits),
            })
        },
    }
}

// For a program checked whole (`program_evaluable`).
theorem program_eval_sources(functions: List<Function>, ok: program_evaluable(functions).IsTrue(), sources: Answers(),
    sourced: program_sourced(functions, sources)):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
        program_eval(functions, f, words) = sources(f, words) {
    program_fit_sources(functions, program_evaluable_calls_fit(functions, ok), sources, sourced)
}

// An evaluable function, its calls answered by results its callees may
// return, may return what it evaluates to.
theorem Function::eval_computes(self function: Function, callees: Callees(), call: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → callees(f, words, call(f, words)),
    ok: function.evaluable(arity).IsTrue(), arguments: List<BitVec(64)>, count: function.parameters.len() = arguments.len()):
    function.Computes(callees, arguments, function.eval(call, arguments)) {
    let parts = Bool::is_true_and(function.body.evaluable(arity),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok);
    let params = Bool::is_true_and(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), parts.right);
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    let after = function.body.eval(call, bound);
    let read: (words_of(after, function.parameters) = arguments) = trans(
        words_agree(function.parameters, bound, after, λ id m =>
            function.body.eval_frame(call, bound, 64, id, disjoint_mem(function.body.writes(), function.parameters, params.right, id, m))),
        words_of_bind(Valuation::zero(), function.parameters, params.left, arguments, count));
    ⟨after, ⟨read, ⟨function.body.eval_holds_in(callees, call, arity, answers, parts.left, bound, after,
        λ w id _ => refl), refl⟩⟩⟩
}

// The theorem for programs: what `program_eval` returns for a call of the
// right arity is a result the function may return.
theorem program_eval_computes(functions: List<Function>, ok: program_evaluable(functions).IsTrue()):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
    program_callees(functions, f, words, program_eval(functions, f, words)) {
    match functions {
        Nil => λ f words never => false_elim(never),
        Cons(last, earlier) => λ f words => {
            let parts = Bool::is_true_and(last.evaluable(program_arity(earlier)), program_evaluable(earlier), ok);
            let ih = program_eval_computes(earlier, parts.right);
            match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, f) },
                    words.len()).IsTrue() →
                (match d as λ _ => Type {
                    Inl(_) => last.Computes(program_callees(earlier), words,
                        match d { Inl(_) => last.eval(program_eval(earlier), words), Inr(_) => program_eval(earlier, f, words) }),
                    Inr(_) => program_callees(earlier, f, words,
                        match d { Inl(_) => last.eval(program_eval(earlier), words), Inr(_) => program_eval(earlier, f, words) }),
                }) {
                Inl(_) => λ fits => last.eval_computes(program_callees(earlier), program_eval(earlier), program_arity(earlier), ih,
                    parts.left, words, last.parameters.len().matches_eq(words.len(), fits)),
                Inr(_) => λ fits => ih(f, words, fits),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// Evaluability in one pass (issues/function-ir-evaluable-quadratic.md)
//
// `evaluable` compares each continuation's writes with its prefix's
// mentions, rebuilding both lists at every level: quadratic in the depth of
// a nest of `match`es. `scan` walks a region once, in evaluation order,
// carrying the ids mentioned so far as marks: a write must find its id
// unmarked, and every mention marks its id. A conditional's arms start from
// the same marks, its condition marked (an arm reads it, so may not write
// it), and their marks are joined after; a loop's body and a function's body start from their parameters alone. That
// is `evaluable`'s condition read the other way round (nothing earlier
// mentions an id written later), so `scan` accepts what `evaluable` does,
// in one pass, each mark set or tested in time linear in its id;
// `program_scan_evaluable` proves it implies `evaluable`, and the x86
// certificate checks `program_scan` by evaluation and cites that theorem.

// Ids as a bitmap: entry `k` says whether id `k` is marked.
fn marks_has(marks: List<Bool>, id: Nat) → Bool {
    match marks { Nil => False, Cons(here, rest) => match id { Zero => here, Succ(k) => marks_has(rest, k) } }
}

fn marks_add(marks: List<Bool>, id: Nat) → List<Bool> {
    match id {
        Zero => match marks { Nil => [True], Cons(_, rest) => Cons(True, rest) },
        Succ(k) => match marks { Nil => Cons(False, marks_add([], k)), Cons(here, rest) => Cons(here, marks_add(rest, k)) },
    }
}

fn marks_add_all(marks: List<Bool>, ids: List<Nat>) → List<Bool> {
    match ids { Nil => marks, Cons(id, rest) => marks_add_all(marks_add(marks, id), rest) }
}

fn marks_union(a, b: List<Bool>) → List<Bool> {
    match a {
        Nil => b,
        Cons(x, ra) => match b { Nil => Cons(x, ra), Cons(y, rb) => Cons(x || y, marks_union(ra, rb)) },
    }
}

// None of `ids` is marked.
fn marks_lack_all(marks: List<Bool>, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(id, rest) => marks_has(marks, id).not() && marks_lack_all(marks, rest) }
}

theorem marks_add_has(id: Nat): (marks: List<Bool>) → marks_has(marks_add(marks, id), id).IsTrue() {
    match id {
        Zero => λ marks => match marks { Nil => trivial, Cons(_, _) => trivial },
        Succ(k) => λ marks => match marks { Nil => marks_add_has(k, []), Cons(_, rest) => marks_add_has(k, rest) },
    }
}

theorem marks_add_keeps(id: Nat): (marks: List<Bool>) → (other: Nat) → marks_has(marks, other).IsTrue() →
    marks_has(marks_add(marks, id), other).IsTrue() {
    match id {
        Zero => λ marks other => match marks {
            Nil => λ never => false_elim(never),
            Cons(_, _) => match other { Zero => λ _ => trivial, Succ(_) => λ h => h },
        },
        Succ(k) => λ marks other => match marks {
            Nil => λ never => false_elim(never),
            Cons(_, rest) => match other { Zero => λ h => h, Succ(o) => λ h => marks_add_keeps(k, rest, o, h) },
        },
    }
}

theorem marks_add_all_keeps(ids: List<Nat>): (marks: List<Bool>) → (other: Nat) → marks_has(marks, other).IsTrue() →
    marks_has(marks_add_all(marks, ids), other).IsTrue() {
    match ids {
        Nil => λ marks other h => h,
        Cons(id, rest) => λ marks other h => marks_add_all_keeps(rest, marks_add(marks, id), other, marks_add_keeps(id, marks, other, h)),
    }
}

theorem marks_add_all_has(ids: List<Nat>): (marks: List<Bool>) → (other: Nat) → Mem(other, ids) →
    marks_has(marks_add_all(marks, ids), other).IsTrue() {
    match ids {
        Nil => λ marks other never => false_elim(never),
        Cons(id, rest) => λ marks other m => match m {
            Inl(e) => marks_add_all_keeps(rest, marks_add(marks, id), other,
                j(sym(e), λ x _ => marks_has(marks_add(marks, id), x).IsTrue(), marks_add_has(id, marks))),
            Inr(later) => marks_add_all_has(rest, marks_add(marks, id), other, later),
        },
    }
}

theorem marks_union_l(a: List<Bool>): (b: List<Bool>) → (id: Nat) → marks_has(a, id).IsTrue() →
    marks_has(marks_union(a, b), id).IsTrue() {
    match a {
        Nil => λ b id never => false_elim(never),
        Cons(x, ra) => λ b id => match b {
            Nil => λ h => h,
            Cons(y, rb) => match id { Zero => λ h => Bool::is_true_or_l(x, y, h), Succ(k) => λ h => marks_union_l(ra, rb, k, h) },
        },
    }
}

theorem marks_union_r(a: List<Bool>): (b: List<Bool>) → (id: Nat) → marks_has(b, id).IsTrue() →
    marks_has(marks_union(a, b), id).IsTrue() {
    match a {
        Nil => λ b id h => h,
        Cons(x, ra) => λ b id => match b {
            Nil => λ never => false_elim(never),
            Cons(y, rb) => match id { Zero => λ h => Bool::is_true_or_r(x, y, h), Succ(k) => λ h => marks_union_r(ra, rb, k, h) },
        },
    }
}

theorem marks_lack_all_mem(marks: List<Bool>, ids: List<Nat>): marks_lack_all(marks, ids).IsTrue() → (id: Nat) → Mem(id, ids) →
    ¬marks_has(marks, id).IsTrue() {
    match ids {
        Nil => λ _ id never => false_elim(never),
        Cons(x, rest) => λ h id m => {
            let parts = Bool::is_true_and(marks_has(marks, x).not(), marks_lack_all(marks, rest), h);
            match m {
                Inl(e) => λ has => Bool::is_true_not(marks_has(marks, x), parts.left, j(e, λ y _ => marks_has(marks, y).IsTrue(), has)),
                Inr(later) => marks_lack_all_mem(marks, rest, parts.right, id, later),
            }
        },
    }
}

// A marked id is not one the marks lack.
theorem marks_apart(marks: List<Bool>, marked, unmarked: Nat, has: marks_has(marks, marked).IsTrue(),
    lacks: ¬marks_has(marks, unmarked).IsTrue()): marked ≠ unmarked {
    λ e => lacks(j(e, λ x _ => marks_has(marks, x).IsTrue(), has))
}

theorem Nat::differs_of_ne(self a, b: Nat, ne: a ≠ b): a.differs(b).IsTrue() {
    match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => trivial,
    }
}

theorem absent_of(id: Nat, ids: List<Nat>): ((x: Nat) → Mem(x, ids) → id ≠ x) → absent(id, ids).IsTrue() {
    match ids {
        Nil => λ _ => trivial,
        Cons(x, rest) => λ h => Bool::is_true_and_intro(id.differs(x), absent(id, rest),
            id.differs_of_ne(x, h(x, Inl(refl))), absent_of(id, rest, λ y m => h(y, Inr(m)))),
    }
}

theorem disjoint_of(xs, ys: List<Nat>): ((y: Nat) → Mem(y, ys) → absent(y, xs).IsTrue()) → disjoint(xs, ys).IsTrue() {
    match ys {
        Nil => λ _ => trivial,
        Cons(y, rest) => λ h => Bool::is_true_and_intro(absent(y, xs), disjoint(xs, rest),
            h(y, Inl(refl)), disjoint_of(xs, rest, λ z m => h(z, Inr(m)))),
    }
}

// Sets of ids as lists.
theorem absent_false_mem(id: Nat, ids: List<Nat>): absent(id, ids) = False → Mem(id, ids) {
    match ids {
        Nil => λ no => absurd(no),
        Cons(x, rest) => (match id.eq_dec(x) {
            Inl(e) => λ _ => Inl(e),
            Inr(_) => λ no => Inr(absent_false_mem(id, rest, no)),
        }),
    }
}

// `absent(x, s)` is `x ∉ s`, so `sets` reads it (and `holds`, which is
// `!absent`) as membership.
theorem absent_set_law(): SetBitLaw<Nat>(absent, True) {
    λ x s => match none: absent(x, s) {
        True => And(λ (no: False = True) => absurd(no),
            λ _ (m: Mem(x, s)) => absent_mem(x, s, j(sym(none), λ c _ => c.IsTrue(), trivial), x, m, refl)),
        False => And(λ _ => absent_false_mem(x, s, none), λ (no: True = False) => absurd(no)),
    }
}

register def absent_set_entry: SetBitEntry = SetBitEntry(name_of(absent), name_of(absent_set_law), True, 0);

// `a.matches(b)` is `a = b` and `a.differs(b)` its negation, so `sets`
// reads both as equations.
theorem Nat::matches_reflects(self a, b: Nat): Reflects(a = b, a.matches(b)) {
    match a.eq_dec(b) as λ d => Reflects(a = b, match d { Inl(_) => True, Inr(_) => False }) {
        Inl(e) => And(λ _ => e, λ (no: True = False) => absurd(no)),
        Inr(ne) => And(λ (no: False = True) => absurd(no), λ _ => ne),
    }
}

theorem Nat::differs_reflects(self a, b: Nat): Reflects(a = b, !a.differs(b)) {
    match a.eq_dec(b) as λ d => Reflects(a = b, Bool::not(match d { Inl(_) => False, Inr(_) => True })) {
        Inl(e) => And(λ _ => e, λ (no: True = False) => absurd(no)),
        Inr(ne) => And(λ (no: False = True) => absurd(no), λ _ => ne),
    }
}

register def matches_set_entry: SetEqEntry = SetEqEntry(name_of(Nat::matches), name_of(Nat::matches_reflects), False, 0);
register def differs_set_entry: SetEqEntry = SetEqEntry(name_of(Nat::differs), name_of(Nat::differs_reflects), True, 0);

// `disjoint(xs, ys)`: every element of `ys` is absent from `xs`.
register def disjoint_set_entry: SetRelEntry = SetRelEntry(name_of(disjoint), name_of(disjoint_mem), name_of(disjoint_of), 0);

// Nothing `ys` mentions is written in `xs`: each of `ys` is marked and each
// of `xs` is not.
theorem disjoint_of_marks(marks: List<Bool>, xs, ys: List<Nat>,
    unmarked: (x: Nat) → Mem(x, xs) → ¬marks_has(marks, x).IsTrue(),
    marked: (y: Nat) → Mem(y, ys) → marks_has(marks, y).IsTrue()): disjoint(xs, ys).IsTrue() {
    disjoint_of(xs, ys, λ y m => absent_of(y, xs, λ x w => marks_apart(marks, y, x, marked(y, m), unmarked(x, w))))
}

// A scan's verdict and the marks it ends with. The verdict is read only
// through `ok`, the marks only through `marks`, each once, so a scan is
// evaluated once however it is read.
record Scan { ok: Bool, marks: List<Bool> }

fn Scan::guard(self scan: Scan, ok: Bool) → Scan { Scan(ok := ok && scan.ok, marks := scan.marks) }

fn Scan::then(self scan: Scan, next: List<Bool> → Scan) → Scan { next(scan.marks).guard(scan.ok) }

fn Scan::join(yes, no: Scan) → Scan { Scan(ok := yes.ok && no.ok, marks := marks_union(yes.marks, no.marks)) }

fn nodes_scan(nodes: List<Node>, marks: List<Bool>) → Scan {
    match nodes {
        Nil => Scan(ok := True, marks := marks),
        Cons(node, rest) => nodes_scan(rest, marks_add_all(marks, node.mentions()))
            .guard(absent(node_output(node).id, node.reads()) && marks_has(marks, node_output(node).id).not()),
    }
}

theorem nodes_scan_keeps(nodes: List<Node>): (marks: List<Bool>) → (id: Nat) → marks_has(marks, id).IsTrue() →
    marks_has(nodes_scan(nodes, marks).marks, id).IsTrue() {
    match nodes {
        Nil => λ marks id h => h,
        Cons(node, rest) => λ marks id h =>
            nodes_scan_keeps(rest, marks_add_all(marks, node.mentions()), id, marks_add_all_keeps(node.mentions(), marks, id, h)),
    }
}

theorem nodes_scan_marks(nodes: List<Node>): (marks: List<Bool>) → (id: Nat) → Mem(id, nodes_mentions(nodes)) →
    marks_has(nodes_scan(nodes, marks).marks, id).IsTrue() {
    match nodes {
        Nil => λ marks id never => false_elim(never),
        Cons(node, rest) => λ marks id m => match List::mem_append(node.mentions(), nodes_mentions(rest), id, m) {
            Inl(here) => nodes_scan_keeps(rest, marks_add_all(marks, node.mentions()), id,
                marks_add_all_has(node.mentions(), marks, id, here)),
            Inr(later) => nodes_scan_marks(rest, marks_add_all(marks, node.mentions()), id, later),
        },
    }
}

// A scan that passes: the nodes are evaluable, and none writes an id
// marked before.
theorem nodes_scan_sound(nodes: List<Node>): (marks: List<Bool>) → nodes_scan(nodes, marks).ok.IsTrue() →
    nodes_evaluable(nodes).IsTrue() ∧ ((id: Nat) → Mem(id, nodes_writes(nodes)) → ¬marks_has(marks, id).IsTrue()) {
    match nodes {
        Nil => λ marks _ => ⟨trivial, λ id never => false_elim(never)⟩,
        Cons(node, rest) => λ marks ok => {
            let output = node_output(node).id;
            let after = marks_add_all(marks, node.mentions());
            let parts = Bool::is_true_and(absent(output, node.reads()) && marks_has(marks, output).not(), nodes_scan(rest, after).ok, ok);
            let here = Bool::is_true_and(absent(output, node.reads()), marks_has(marks, output).not(), parts.left);
            let later = nodes_scan_sound(rest, after, parts.right);
            let apart = disjoint_of_marks(after, nodes_writes(rest), node.mentions(), later.right,
                λ y m => marks_add_all_has(node.mentions(), marks, y, m));
            ⟨Bool::is_true_and_intro(absent(output, node.reads()), disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest),
                    here.left, Bool::is_true_and_intro(disjoint(nodes_writes(rest), node.mentions()), nodes_evaluable(rest), apart, later.left)),
                λ id w has => match w {
                    Inl(e) => Bool::is_true_not(marks_has(marks, output), here.right, j(e, λ x _ => marks_has(marks, x).IsTrue(), has)),
                    Inr(written) => later.right(id, written, marks_add_all_keeps(node.mentions(), marks, id, has)),
                }⟩
        },
    }
}

// What a loop checks of its own ports: `evaluable`'s conjuncts after the
// body's.
fn loop_ports_fit(inputs: List<Nat>, bound: Nat, parameters, next, outputs: List<Nat>, exhausted: Nat) → Bool {
    distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
        && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
        && outputs.len().matches(parameters.len()))))
}

fn StructuredRegion::scan(self region: StructuredRegion, arity: Nat → Option<Nat>, marks: List<Bool>) → Scan {
    match region {
        Dataflow(body) => nodes_scan(body.nodes, marks),
        Sequence(prefix, continuation) => nodes_scan(prefix.nodes, marks).then(λ after => continuation.scan(arity, after)),
        Compose(prefix, continuation) => prefix.scan(arity, marks).then(λ after => continuation.scan(arity, after)),
        Conditional(_, condition, _, _, when_true, when_false) =>
            Scan::join(when_true.scan(arity, marks_add(marks, condition)), when_false.scan(arity, marks_add(marks, condition))),
        Call(callee, arguments, result) => Scan(
            ok := absent(result, arguments) && (arity_fits(arity(callee), arguments.len()) && marks_has(marks, result).not()),
            marks := marks_add_all(marks, Cons(result, arguments))),
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => Scan(
            ok := body.scan(arity, marks_add_all([], Cons(count, parameters))).ok && (distinct(Cons(count, parameters))
                && (loop_ports_fit(inputs, bound, parameters, next, outputs, exhausted) && marks_lack_all(marks, Cons(exhausted, outputs)))),
            marks := marks_add_all(marks, Cons(bound, inputs) ++ Cons(exhausted, outputs))),
    }
}

theorem StructuredRegion::scan_keeps(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: List<Bool>) → (id: Nat) →
    marks_has(marks, id).IsTrue() → marks_has(region.scan(arity, marks).marks, id).IsTrue() {
    match region {
        Dataflow(body) => λ marks id h => nodes_scan_keeps(body.nodes, marks, id, h),
        Sequence(prefix, continuation) => λ marks id h =>
            continuation.scan_keeps(arity, nodes_scan(prefix.nodes, marks).marks, id, nodes_scan_keeps(prefix.nodes, marks, id, h)),
        Compose(prefix, continuation) => λ marks id h =>
            continuation.scan_keeps(arity, prefix.scan(arity, marks).marks, id, prefix.scan_keeps(arity, marks, id, h)),
        Conditional(_, condition, _, _, when_true, when_false) => λ marks id h =>
            marks_union_l(when_true.scan(arity, marks_add(marks, condition)).marks, when_false.scan(arity, marks_add(marks, condition)).marks, id,
                when_true.scan_keeps(arity, marks_add(marks, condition), id, marks_add_keeps(condition, marks, id, h))),
        Call(_, arguments, result) => λ marks id h => marks_add_all_keeps(Cons(result, arguments), marks, id, h),
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => λ marks id h =>
            marks_add_all_keeps(Cons(bound, inputs) ++ Cons(exhausted, outputs), marks, id, h),
    }
}

theorem StructuredRegion::scan_marks(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: List<Bool>) → (id: Nat) →
    Mem(id, region.mentions()) → marks_has(region.scan(arity, marks).marks, id).IsTrue() {
    match region {
        Dataflow(body) => λ marks id m => nodes_scan_marks(body.nodes, marks, id, m),
        Sequence(prefix, continuation) => λ marks id m => match List::mem_append(nodes_mentions(prefix.nodes), continuation.mentions(), id, m) {
            Inl(here) => continuation.scan_keeps(arity, nodes_scan(prefix.nodes, marks).marks, id, nodes_scan_marks(prefix.nodes, marks, id, here)),
            Inr(later) => continuation.scan_marks(arity, nodes_scan(prefix.nodes, marks).marks, id, later),
        },
        Compose(prefix, continuation) => λ marks id m => match List::mem_append(prefix.mentions(), continuation.mentions(), id, m) {
            Inl(here) => continuation.scan_keeps(arity, prefix.scan(arity, marks).marks, id, prefix.scan_marks(arity, marks, id, here)),
            Inr(later) => continuation.scan_marks(arity, prefix.scan(arity, marks).marks, id, later),
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ marks id m => {
            let inner = marks_add(marks, condition);
            match m {
                Inl(e) => marks_union_l(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id,
                    when_true.scan_keeps(arity, inner, id, j(sym(e), λ x _ => marks_has(inner, x).IsTrue(), marks_add_has(condition, marks)))),
                Inr(arms) => match List::mem_append(when_true.mentions(), when_false.mentions(), id, arms) {
                    Inl(here) => marks_union_l(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id,
                        when_true.scan_marks(arity, inner, id, here)),
                    Inr(there) => marks_union_r(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id,
                        when_false.scan_marks(arity, inner, id, there)),
                },
            }
        },
        Call(_, arguments, result) => λ marks id m => marks_add_all_has(Cons(result, arguments), marks, id, m),
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => λ marks id m =>
            marks_add_all_has(Cons(bound, inputs) ++ Cons(exhausted, outputs), marks, id, m),
    }
}

// A region whose scan passes is evaluable, and writes no id marked before.
theorem StructuredRegion::scan_sound(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: List<Bool>) →
    region.scan(arity, marks).ok.IsTrue() →
    region.evaluable(arity).IsTrue() ∧ ((id: Nat) → Mem(id, region.writes()) → ¬marks_has(marks, id).IsTrue()) {
    match region {
        Dataflow(body) => λ marks ok => nodes_scan_sound(body.nodes, marks, ok),
        Sequence(prefix, continuation) => λ marks ok => {
            let after = nodes_scan(prefix.nodes, marks).marks;
            let parts = Bool::is_true_and(nodes_scan(prefix.nodes, marks).ok, continuation.scan(arity, after).ok, ok);
            let first = nodes_scan_sound(prefix.nodes, marks, parts.left);
            let rest = continuation.scan_sound(arity, after, parts.right);
            let apart = disjoint_of_marks(after, continuation.writes(), nodes_mentions(prefix.nodes), rest.right,
                λ y m => nodes_scan_marks(prefix.nodes, marks, y, m));
            ⟨Bool::is_true_and_intro(nodes_evaluable(prefix.nodes),
                    disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), first.left,
                    Bool::is_true_and_intro(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity),
                        apart, rest.left)),
                λ id w has => match List::mem_append(nodes_writes(prefix.nodes), continuation.writes(), id, w) {
                    Inl(here) => first.right(id, here, has),
                    Inr(later) => rest.right(id, later, nodes_scan_keeps(prefix.nodes, marks, id, has)),
                }⟩
        },
        Compose(prefix, continuation) => λ marks ok => {
            let after = prefix.scan(arity, marks).marks;
            let parts = Bool::is_true_and(prefix.scan(arity, marks).ok, continuation.scan(arity, after).ok, ok);
            let first = prefix.scan_sound(arity, marks, parts.left);
            let rest = continuation.scan_sound(arity, after, parts.right);
            let apart = disjoint_of_marks(after, continuation.writes(), prefix.mentions(), rest.right,
                λ y m => prefix.scan_marks(arity, marks, y, m));
            ⟨Bool::is_true_and_intro(prefix.evaluable(arity), disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity),
                    first.left, Bool::is_true_and_intro(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity),
                        apart, rest.left)),
                λ id w has => match List::mem_append(prefix.writes(), continuation.writes(), id, w) {
                    Inl(here) => first.right(id, here, has),
                    Inr(later) => rest.right(id, later, prefix.scan_keeps(arity, marks, id, has)),
                }⟩
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ marks ok => {
            let inner = marks_add(marks, condition);
            let arms = Bool::is_true_and(when_true.scan(arity, inner).ok, when_false.scan(arity, inner).ok, ok);
            let yes = when_true.scan_sound(arity, inner, arms.left);
            let no = when_false.scan_sound(arity, inner, arms.right);
            let fresh: (x: Nat) → Mem(x, when_true.writes() ++ when_false.writes()) → ¬marks_has(inner, x).IsTrue() = λ x w =>
                match List::mem_append(when_true.writes(), when_false.writes(), x, w) {
                    Inl(here) => yes.right(x, here),
                    Inr(there) => no.right(x, there),
                };
            let unwritten = absent_of(condition, when_true.writes() ++ when_false.writes(),
                λ x w => marks_apart(inner, condition, x, marks_add_has(condition, marks), fresh(x, w)));
            ⟨Bool::is_true_and_intro(absent(condition, when_true.writes() ++ when_false.writes()),
                    when_true.evaluable(arity) && when_false.evaluable(arity), unwritten,
                    Bool::is_true_and_intro(when_true.evaluable(arity), when_false.evaluable(arity), yes.left, no.left)),
                λ id w has => fresh(id, w, marks_add_keeps(condition, marks, id, has))⟩
        },
        Call(callee, arguments, result) => λ marks ok => {
            let parts = Bool::is_true_and(absent(result, arguments), arity_fits(arity(callee), arguments.len()) && marks_has(marks, result).not(), ok);
            let rest = Bool::is_true_and(arity_fits(arity(callee), arguments.len()), marks_has(marks, result).not(), parts.right);
            ⟨Bool::is_true_and_intro(absent(result, arguments), arity_fits(arity(callee), arguments.len()), parts.left, rest.left),
                λ id w has => match w {
                    Inl(e) => Bool::is_true_not(marks_has(marks, result), rest.right, j(e, λ x _ => marks_has(marks, x).IsTrue(), has)),
                    Inr(never) => false_elim(never),
                }⟩
        },
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => λ marks ok => {
            let start = marks_add_all([], Cons(count, parameters));
            let ports = loop_ports_fit(inputs, bound, parameters, next, outputs, exhausted);
            let lacks = marks_lack_all(marks, Cons(exhausted, outputs));
            let p0 = Bool::is_true_and(body.scan(arity, start).ok, distinct(Cons(count, parameters)) && (ports && lacks), ok);
            let p1 = Bool::is_true_and(distinct(Cons(count, parameters)), ports && lacks, p0.right);
            let p2 = Bool::is_true_and(ports, lacks, p1.right);
            let inner = body.scan_sound(arity, start, p0.left);
            let apart = disjoint_of_marks(start, body.writes(), Cons(count, parameters), inner.right,
                λ y m => marks_add_all_has(Cons(count, parameters), [], y, m));
            ⟨Bool::is_true_and_intro(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters)) && ports),
                    inner.left, Bool::is_true_and_intro(distinct(Cons(count, parameters)), disjoint(body.writes(), Cons(count, parameters)) && ports,
                        p1.left, Bool::is_true_and_intro(disjoint(body.writes(), Cons(count, parameters)), ports, apart, p2.left))),
                marks_lack_all_mem(marks, Cons(exhausted, outputs), p2.right)⟩
        },
    }
}

// A function scans from its parameters, marked.
fn Function::scan(self function: Function, arity: Nat → Option<Nat>) → Bool {
    distinct(function.parameters) && function.body.scan(arity, marks_add_all([], function.parameters)).ok
}

theorem Function::scan_evaluable(self function: Function, arity: Nat → Option<Nat>, ok: function.scan(arity).IsTrue()):
    function.evaluable(arity).IsTrue() {
    let start = marks_add_all([], function.parameters);
    let parts = Bool::is_true_and(distinct(function.parameters), function.body.scan(arity, start).ok, ok);
    let body = function.body.scan_sound(arity, start, parts.right);
    let apart = disjoint_of_marks(start, function.body.writes(), function.parameters, body.right,
        λ y m => marks_add_all_has(function.parameters, [], y, m));
    Bool::is_true_and_intro(function.body.evaluable(arity), distinct(function.parameters) && disjoint(function.body.writes(), function.parameters),
        body.left, Bool::is_true_and_intro(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), parts.left, apart))
}

// `program_evaluable` in one pass per function.
fn program_scan(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.scan(program_arity(earlier)) && program_scan(earlier),
    }
}

theorem program_scan_evaluable(functions: List<Function>): program_scan(functions).IsTrue() → program_evaluable(functions).IsTrue() {
    match functions {
        Nil => λ _ => trivial,
        Cons(last, earlier) => λ ok => {
            let parts = Bool::is_true_and(last.scan(program_arity(earlier)), program_scan(earlier), ok);
            Bool::is_true_and_intro(last.evaluable(program_arity(earlier)), program_evaluable(earlier),
                last.scan_evaluable(program_arity(earlier), parts.left), program_scan_evaluable(earlier, parts.right))
        },
    }
}

// The scan of a program's last function alone (the first in the list).
fn program_scan_head(functions: List<Function>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.scan(program_arity(earlier)) }
}

theorem program_scan_drop_zero(functions: List<Function>): program_scan(functions.drop(0)).IsTrue() → program_scan(functions).IsTrue() {
    match functions { Nil => λ h => h, Cons(_, _) => λ h => h }
}

// `program_scan` a function at a time, each its own declaration: the
// kernel's fuel is per declaration, so a certificate built this way pays
// for its largest function, not for the sum of them.
theorem program_scan_drop(functions: List<Function>, n: Nat): program_scan_head(functions.drop(n)).IsTrue() →
    program_scan(functions.drop(Succ(n))).IsTrue() → program_scan(functions.drop(n)).IsTrue() {
    match functions {
        Nil => λ _ _ => trivial,
        Cons(last, earlier) => match n {
            Zero => λ head rest => Bool::is_true_and_intro(last.scan(program_arity(earlier)), program_scan(earlier), head,
                program_scan_drop_zero(earlier, rest)),
            Succ(k) => λ head rest => program_scan_drop(earlier, k, head, rest),
        },
    }
}

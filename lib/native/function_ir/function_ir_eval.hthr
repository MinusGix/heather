// FunctionIR evaluated: a total function computing a region's values, and
// the theorem that what it computes satisfies the region's equations
// (issues/function-ir-total-evaluator.md; docs/native/native-effect-source-design.md
// §2.1, round S3.0).
//
// FunctionIR's meaning is relational: a valuation satisfies a region's
// equations. A tree has to compute its next command from values in hand, so
// the effectful source needs a function. `eval` runs a region's schedule over
// a valuation, setting each node's output; `Function::eval` binds a
// function's parameters and evaluates its body; `program_eval` evaluates a
// program's functions last first, as `program_callees` orders them.
//
// A value is set at every width at once (`Valuation::set` takes a value per
// width), and each node's value is its equation's right side read at the
// width asked for. At the node's own width that is the equation; no width is
// ever compared, so nothing is transported along a width equation.
//
// The theorem asks a schedule to be evaluable, a Bool computed by
// evaluation: no node reads its own output, nothing later writes an id
// anything earlier mentions, an arm writes no condition, a call names a
// function of the right arity, and a function's parameters are distinct and
// unwritten. Under that, the evaluated valuation satisfies the equations
// (`StructuredRegion::eval_holds_in`), and a program's evaluated results are
// results its functions compute (`program_eval_computes`), which is what
// every lowering theorem is stated over.

import function_ir;
import function_ir_operation;
import bitvec;
import bitvec_rotate;
import bitvec_bytes;
import bool;
import list;
import set_solve;
import set_ops;
import logic;
import nat;
import option;
import string;
import simp_laws;

// ---------------------------------------------------------------------------
// Ids and lists of them, decided by evaluation

fn Nat::differs(self a, b: Nat) → Bool { match a.eq_dec(b) { Inl(_) => False, Inr(_) => True } }

fn Nat::matches(self a, b: Nat) → Bool { match a.eq_dec(b) { Inl(_) => True, Inr(_) => False } }

theorem Nat::differs_ne(self a, b: Nat, h: a.differs(b).IsTrue()): a ≠ b {
    (match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) → a ≠ b {
        Inl(_) => λ never => false_elim(never),
        Inr(ne) => λ _ => ne,
    })(h)
}

theorem Nat::matches_eq(self a, b: Nat, h: a.matches(b).IsTrue()): a = b {
    (match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => True, Inr(_) => False }) → a = b {
        Inl(e) => λ _ => e,
        Inr(_) => λ never => false_elim(never),
    })(h)
}

theorem Nat::matches_of_eq(self a, b: Nat, e: a = b): a.matches(b).IsTrue() {
    j(e, λ y _ => a.matches(y).IsTrue(), (match a.eq_dec(a) as λ d => Bool::IsTrue(match d { Inl(_) => True, Inr(_) => False }) {
        Inl(_) => trivial,
        Inr(ne) => false_elim(ne(refl)),
    }))
}

// `id` is none of `ids`.
fn absent(id: Nat, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(x, rest) => id.differs(x) && absent(id, rest) }
}

// No id of `ys` is one of `xs`.
fn disjoint(xs, ys: List<Nat>) → Bool {
    match ys { Nil => True, Cons(y, rest) => absent(y, xs) && disjoint(xs, rest) }
}

// No id appears twice.
fn distinct(ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(x, rest) => absent(x, rest) && distinct(rest) }
}

theorem absent_mem(id: Nat, ids: List<Nat>): absent(id, ids).IsTrue() → (y: Nat) → Mem(y, ids) → id ≠ y {
    match ids {
        Nil => λ _ y never => false_elim(never),
        Cons(x, rest) => λ h y m => {
            let parts = Bool::is_true_and(id.differs(x), absent(id, rest), h);
            match m {
                Inl(e) => λ same => id.differs_ne(x, parts.left, trans(same, e)),
                Inr(later) => absent_mem(id, rest, parts.right, y, later),
            }
        },
    }
}

theorem disjoint_mem(xs, ys: List<Nat>): disjoint(xs, ys).IsTrue() → (y: Nat) → Mem(y, ys) → absent(y, xs).IsTrue() {
    match ys {
        Nil => λ _ y never => false_elim(never),
        Cons(z, rest) => λ h y m => {
            let parts = Bool::is_true_and(absent(z, xs), disjoint(xs, rest), h);
            match m {
                Inl(e) => j(sym(e), λ x _ => absent(x, xs).IsTrue(), parts.left),
                Inr(later) => disjoint_mem(xs, rest, parts.right, y, later),
            }
        },
    }
}

theorem absent_append(id: Nat, xs, ys: List<Nat>): absent(id, xs ++ ys).IsTrue() →
    absent(id, xs).IsTrue() ∧ absent(id, ys).IsTrue() {
    match xs {
        Nil => λ h => ⟨trivial, h⟩,
        Cons(x, rest) => λ h => {
            let parts = Bool::is_true_and(id.differs(x), absent(id, rest ++ ys), h);
            let later = absent_append(id, rest, ys, parts.right);
            ⟨Bool::is_true_and_intro(id.differs(x), absent(id, rest), parts.left, later.left), later.right⟩
        },
    }
}

theorem eq2<A, B, C>(g: A → B → C, {a, a2: A}, {b, b2: B}, p: a = a2, q: b = b2): g(a, b) = g(a2, b2) {
    trans(cong_fn(λ (x: A) => g(x, b), p), cong_fn(λ (y: B) => g(a2, y), q))
}

// ---------------------------------------------------------------------------
// Valuations, set at every width

// `id` holds `value` (at each width, the value at that width); every other
// id keeps its value.
fn Valuation::set(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w)) → Valuation() {
    λ w query => match query.eq_dec(id) { Inl(_) => value(w), Inr(_) => values(w, query) }
}

theorem Valuation::set_here(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w), w: Nat):
    Valuation::set(values, id, value, w, id) = value(w) {
    match id.eq_dec(id) {
        Inl(_) => refl,
        Inr(ne) => false_elim(ne(refl)),
    }
}

theorem Valuation::set_other(values: Valuation(), id: Nat, value: (w: Nat) → BitVec(w), w, query: Nat,
    ne: query ≠ id): Valuation::set(values, id, value, w, query) = values(w, query) {
    match query.eq_dec(id) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => refl,
    }
}

// `simp`'s default for a goal with a valuation in it: a read of what was
// set, at its id or at another (the ids apart is the hypothesis).
register def simp_valuation_reads: SimpSet = simp_default("Valuation::reads", name_of(Valuation), [
    name_of(Valuation::set_here),
    name_of(Valuation::set_other),
]);

fn Valuation::zero() → Valuation() { λ w id => BitVec::zero() }

// A word at every width: itself at 64, by evaluation, so that a function
// evaluated over open words is its source by conversion; its low bits at
// any other width.
fn word_value(word: BitVec(64)) → (w: Nat) → BitVec(w) {
    λ w => match Nat::equation(64, w) {
        Inl(e) => j(e, λ v _ => BitVec(v), word),
        Inr(_) => BitVec::ofNat(word.toNat()),
    }
}

theorem word_value_word(word: BitVec(64)): word_value(word, 64) = word { refl }

// A one-bit result at every width: the bit, then zeroes.
fn bit_value(b: Bool) → (w: Nat) → BitVec(w) {
    λ w => match w { Zero => BitVec::nil(), Succ(_) => BitVec::zero().cons_bit(b) }
}

theorem bit_value_bit(b: Bool): bit_value(b, 1) = BitVec::ofBool(b) {
    match b { False => refl, True => refl }
}

// Words at `ids`, each set to the word at its place.
fn Valuation::bind(values: Valuation(), ids: List<Nat>) → List<BitVec(64)> → Valuation() {
    match ids {
        Nil => λ words => values,
        Cons(id, rest) => λ words => match words {
            Nil => values,
            Cons(word, more) => Valuation::set(Valuation::bind(values, rest, more), id, word_value(word)),
        },
    }
}

// Valuations agreeing at 64 on `ids` read the same words there.
theorem words_agree(ids: List<Nat>, values, other: Valuation(), h: (id: Nat) → Mem(id, ids) → other(64, id) = values(64, id)):
    words_of(other, ids) = words_of(values, ids) {
    match ids {
        Nil => refl,
        Cons(id, rest) => eq2(λ (w: BitVec(64)) (ws: List<BitVec(64)>) => Cons(w, ws), h(id, Inl(refl)),
            words_agree(rest, values, other, λ x m => h(x, Inr(m)))),
    }
}

// Binding distinct ids to as many words reads the words back.
theorem words_of_bind(values: Valuation(), ids: List<Nat>): distinct(ids).IsTrue() →
    (words: List<BitVec(64)>) → ids.len() = words.len() → words_of(Valuation::bind(values, ids, words), ids) = words {
    match ids {
        Nil => λ _ words => match words {
            Nil => λ _ => refl,
            Cons(_, more) => λ (bad: 0 = more.len() + 1) => false_elim(more.len().zero_ne_succ(bad)),
        },
        Cons(id, rest) => λ apart words => match words {
            Nil => λ (bad: rest.len() + 1 = 0) => false_elim(rest.len().succ_ne_zero(bad)),
            Cons(word, more) => λ (same: rest.len() + 1 = more.len() + 1) => {
                let parts = Bool::is_true_and(absent(id, rest), distinct(rest), apart);
                let inner = Valuation::bind(values, rest, more);
                let head = trans(Valuation::set_here(inner, id, word_value(word), 64), word_value_word(word));
                let kept = words_agree(rest, inner, Valuation::set(inner, id, word_value(word)), λ x m =>
                    Valuation::set_other(inner, id, word_value(word), 64, x, λ e => absent_mem(id, rest, parts.left, x, m, sym(e))));
                let tail = trans(kept, words_of_bind(values, rest, parts.right, more, Nat::succ_inj(rest.len(), more.len(), same)));
                eq2(λ (w: BitVec(64)) (ws: List<BitVec(64)>) => Cons(w, ws), head, tail)
            },
        },
    }
}

// Binding ids leaves every other id as it was.
theorem Valuation::bind_frame(values: Valuation(), ids: List<Nat>): (words: List<BitVec(64)>) → (w, id: Nat) →
    absent(id, ids).IsTrue() → Valuation::bind(values, ids, words)(w, id) = values(w, id) {
    match ids {
        Nil => λ words w id _ => refl,
        Cons(x, rest) => λ words => match words {
            Nil => λ w id _ => refl,
            Cons(word, more) => λ w id h => {
                let parts = Bool::is_true_and(id.differs(x), absent(id, rest), h);
                trans(Valuation::set_other(Valuation::bind(values, rest, more), x, word_value(word), w, id, id.differs_ne(x, parts.left)),
                    Valuation::bind_frame(values, rest, more, w, id, parts.right))
            },
        },
    }
}

theorem BitVec::head_bit_ofBool(b: Bool): BitVec::ofBool(b).head_bit() = b { match b { False => refl, True => refl } }

// ---------------------------------------------------------------------------
// Buffers, as a byte node reads them

// `Buffers`, a file of buffers by id, each a list of bytes, is
// `function_ir.hthr`'s, beside the equations that read it.

// What a byte node's output holds over `buffers`, the index read off
// `values`.
fn load_value(buffers: Buffers(), buffer, index: Nat, values: Valuation()) → (w: Nat) → BitVec(w) {
    word_value(byte_word(buffer_byte(buffers, buffer, values(64, index).toNat())))
}

// What a wide load's output holds over `buffers`: the word of its bytes,
// the index read off `values`.
fn wide_value(buffers: Buffers(), buffer, index, bytes: Nat, values: Valuation()) → (w: Nat) → BitVec(w) {
    λ w => BitVec::ofNat(buffer_word(buffers, buffer, values(64, index).toNat(), bytes).toNat())
}

// ---------------------------------------------------------------------------
// Nodes

fn Node::reads(self node: Node) → List<Nat> {
    match node {
        Const(_, _, _) => [],
        Move(_, _, source) => [source],
        Add(_, _, left, right) => [left, right],
        Sub(_, _, left, right) => [left, right],
        BitAnd(_, _, left, right) => [left, right],
        BitOr(_, _, left, right) => [left, right],
        BitXor(_, _, left, right) => [left, right],
        ShiftLeft(_, _, value, _) => [value],
        LogicalShiftRight(_, _, value, _) => [value],
        RotateRight(_, _, value, _) => [value],
        Apply(_, _, _, left, right) => [left, right],
        ArithmeticShiftRight(_, _, value, _) => [value],
        UnsignedLessThan(_, _, left, right) => [left, right],
        SignedLessThan(_, _, left, right) => [left, right],
        Equal(_, _, left, right) => [left, right],
        BufferLoad(_, _, index) => [index],
        BufferStore(_, _, index, value) => [index, value],
        Resize(_, _, _, source) => [source],
        SignResize(_, _, _, source) => [source],
        TableRead(_, _, _, index, _) => [index],
        WideLoad(_, _, _, index) => [index],
        WideStore(_, _, _, index, value) => [index, value],
        ByteSwap(_, _, source) => [source],
    }
}

fn Node::mentions(self node: Node) → List<Nat> { Cons(node_output(node).id, node.reads()) }

// The node's equation's right side, at each width. A byte node reads
// `buffers`, which evaluation never changes: over none, every byte zero,
// its value is what `function_ir_state`'s `run` gives it from an empty
// file, and a store's is the load's (`run` is where a store lands).
fn Node::value(self node: Node, values: Valuation(), buffers: Buffers() := Nil) → (w: Nat) → BitVec(w) {
    match node {
        Const(_, _, value) => λ w => BitVec::ofNat(value),
        Move(_, _, source) => λ w => values(w, source),
        Add(_, _, left, right) => λ w => values(w, left).add(values(w, right)),
        Sub(_, _, left, right) => λ w => values(w, left).sub(values(w, right)),
        BitAnd(_, _, left, right) => λ w => values(w, left).band(values(w, right)),
        BitOr(_, _, left, right) => λ w => values(w, left).bor(values(w, right)),
        BitXor(_, _, left, right) => λ w => values(w, left).bxor(values(w, right)),
        ShiftLeft(_, _, value, amount) => λ w => values(w, value).shift_left(amount),
        LogicalShiftRight(_, _, value, amount) => λ w => values(w, value).shift_right(amount),
        RotateRight(_, _, value, amount) => λ w => values(w, value).rotr(amount),
        Apply(op, _, _, left, right) => λ w => op.run(values(w, left), values(w, right)),
        ArithmeticShiftRight(_, _, value, amount) => λ w => values(w, value).arithmetic_shift_right(amount),
        UnsignedLessThan(width, _, left, right) => bit_value(values(width, left).unsigned_lt_bit(values(width, right))),
        SignedLessThan(width, _, left, right) => bit_value(values(width, left).signed_lt_bit(values(width, right))),
        Equal(width, _, left, right) => bit_value(values(width, left).eq_bit(values(width, right))),
        BufferLoad(_, buffer, index) => load_value(buffers, buffer, index, values),
        BufferStore(_, buffer, index, _) => load_value(buffers, buffer, index, values),
        Resize(from, _, _, source) => λ w => BitVec::ofNat(values(from, source).toNat()),
        SignResize(from, _, _, source) => λ w => values(from, source).sresize(w),
        TableRead(_, _, bits, index, entries) => λ w => BitVec::ofNat(table_entry(entries, values(bits, index).toNat())),
        WideLoad(bytes, _, buffer, index) => wide_value(buffers, buffer, index, bytes, values),
        WideStore(bytes, _, buffer, index, _) => wide_value(buffers, buffer, index, bytes, values),
        ByteSwap(_, _, source) => λ w => values(w, source).swap_bytes(),
    }
}

fn Node::step(self node: Node, values: Valuation(), buffers: Buffers() := Nil) → Valuation() {
    Valuation::set(values, node_output(node).id, node.value(values, buffers := buffers))
}

// Whether the node's requirement holds at its operands
// (docs/native/partial-operations-design.md §6.1): a divide's divisor is
// not zero. Every other node requires nothing.
fn Node::defined(self node: Node, values: Valuation()) → Bool {
    match node {
        Apply(op, width, _, left, right) => op.requires_bit(values(width, left), values(width, right)),
        _ => True,
    }
}

// A node that requires nothing of its operands: anything but a divide. A
// stage that adds nodes evaluated at whatever valuation it meets (a guard's
// test, an inlined leaf) adds only these.
fn Node::total(self node: Node) → Bool {
    match node {
        Apply(op, _, _, _, _) => match op { UDiv => False, URem => False, _ => True },
        _ => True,
    }
}

theorem Node::total_defined(self node: Node, values: Valuation()): node.total().IsTrue() → node.defined(values).IsTrue() {
    match node {
        Apply(op, _, _, _, _) => match op { UDiv => λ no => false_elim(no), URem => λ no => false_elim(no), _ => λ _ => trivial },
        _ => λ _ => trivial,
    }
}

fn nodes_total(nodes: List<Node>) → Bool {
    match nodes { Nil => True, Cons(node, rest) => node.total() && nodes_total(rest) }
}

// A valuation whose output is the node's value and whose operands are as
// they were satisfies the node.
theorem Node::holds_of(self node: Node, values, after: Valuation(), buffers: Buffers()):
    ((w: Nat) → after(w, node_output(node).id) = node.value(values, buffers := buffers)(w)) →
    ((w: Nat) → (id: Nat) → Mem(id, node.reads()) → after(w, id) = values(w, id)) → node.defined(values).IsTrue() →
    NodeHolds(after, node, buffers := buffers) {
    match node {
        Const(width, _, _) => λ at_output kept _ => at_output(width),
        Move(width, _, source) => λ at_output kept _ => trans(at_output(width), sym(kept(width, source, Inl(refl)))),
        Add(width, _, left, right) => λ at_output kept _ => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.add(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        Sub(width, _, left, right) => λ at_output kept _ => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.sub(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitAnd(width, _, left, right) => λ at_output kept _ => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.band(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitOr(width, _, left, right) => λ at_output kept _ => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.bor(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        BitXor(width, _, left, right) => λ at_output kept _ => trans(at_output(width), sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.bxor(y),
            kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))),
        ShiftLeft(width, _, value, amount) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.shift_left(amount), kept(width, value, Inl(refl))))),
        LogicalShiftRight(width, _, value, amount) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.shift_right(amount), kept(width, value, Inl(refl))))),
        RotateRight(width, _, value, amount) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.rotr(amount), kept(width, value, Inl(refl))))),
        Apply(op, width, _, left, right) => λ at_output kept defined => {
            let at_left: (after(width, left) = values(width, left)) = kept(width, left, Inl(refl));
            let at_right: (after(width, right) = values(width, right)) = kept(width, right, Inr(Inl(refl)));
            let needs: op.Requires(after(width, left), after(width, right)) =
                j(sym(at_left), λ x _ => op.Requires(x, after(width, right)),
                    j(sym(at_right), λ y _ => op.Requires(values(width, left), y),
                        op.requires_of_bit(values(width, left), values(width, right),
                            eq_true_of_is_true(op.requires_bit(values(width, left), values(width, right)), defined))));
            Operation::Gives(needs := needs, equation := trans(at_output(width),
                sym(eq2(λ (x: BitVec(width)) (y: BitVec(width)) => op.run(x, y), at_left, at_right))))
        },
        ArithmeticShiftRight(width, _, value, amount) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.arithmetic_shift_right(amount), kept(width, value, Inl(refl))))),
        UnsignedLessThan(width, _, left, right) => λ at_output kept _ => trans(at_output(1), trans(
            bit_value_bit(values(width, left).unsigned_lt_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        SignedLessThan(width, _, left, right) => λ at_output kept _ => trans(at_output(1), trans(
            bit_value_bit(values(width, left).signed_lt_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        Equal(width, _, left, right) => λ at_output kept _ => trans(at_output(1), trans(
            bit_value_bit(values(width, left).eq_bit(values(width, right))),
            sym(cong_fn(BitVec::ofBool, eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y),
                kept(width, left, Inl(refl)), kept(width, right, Inr(Inl(refl)))))))),
        BufferLoad(_, buffer, index) => λ at_output kept _ => trans(at_output(64),
            trans(word_value_word(byte_word(buffer_byte(buffers, buffer, values(64, index).toNat()))),
                sym(cong_fn(λ (x: BitVec(64)) => byte_word(buffer_byte(buffers, buffer, x.toNat())), kept(64, index, Inl(refl)))))),
        BufferStore(_, _, _, _) => λ at_output kept _ => trivial,
        Resize(from, to, _, source) => λ at_output kept _ => trans(at_output(to),
            sym(cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := to), kept(from, source, Inl(refl))))),
        SignResize(from, to, _, source) => λ at_output kept _ => trans(at_output(to),
            sym(cong_fn(λ (x: BitVec(from)) => x.sresize(to), kept(from, source, Inl(refl))))),
        TableRead(width, _, bits, index, entries) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(bits)) => BitVec::ofNat(table_entry(entries, x.toNat()), n := width), kept(bits, index, Inl(refl))))),
        WideLoad(bytes, _, buffer, index) => λ at_output kept _ => trans(at_output(8 * bytes),
            trans(BitVec::ofNat_toNat(8 * bytes, buffer_word(buffers, buffer, values(64, index).toNat(), bytes)),
                sym(cong_fn(λ (x: BitVec(64)) => buffer_word(buffers, buffer, x.toNat(), bytes), kept(64, index, Inl(refl)))))),
        WideStore(_, _, _, _, _) => λ at_output kept _ => trivial,
        ByteSwap(width, _, source) => λ at_output kept _ => trans(at_output(width),
            sym(cong_fn(λ (x: BitVec(width)) => x.swap_bytes(), kept(width, source, Inl(refl))))),
    }
}

// ---------------------------------------------------------------------------
// Schedules of nodes

fn eval_nodes_over(buffers: Buffers(), nodes: List<Node>, values: Valuation()) → Valuation() {
    match nodes { Nil => values, Cons(node, rest) => eval_nodes_over(buffers, rest, node.step(values, buffers := buffers)) }
}

fn eval_nodes(nodes: List<Node>, values: Valuation()) → Valuation() { eval_nodes_over(Nil, nodes, values) }

fn Region::eval(self region: Region, values: Valuation(), buffers: Buffers() := Nil) → Valuation() {
    eval_nodes_over(buffers, region.nodes, values)
}

// Whether every node's requirement holds where evaluation meets it.
fn nodes_defined_over(buffers: Buffers(), nodes: List<Node>, values: Valuation()) → Bool {
    match nodes {
        Nil => True,
        Cons(node, rest) => node.defined(values) && nodes_defined_over(buffers, rest, node.step(values, buffers := buffers)),
    }
}

theorem nodes_total_defined(nodes: List<Node>, buffers: Buffers()): nodes_total(nodes).IsTrue() → (values: Valuation()) →
    nodes_defined_over(buffers, nodes, values).IsTrue() {
    match nodes {
        Nil => λ _ _ => trivial,
        Cons(node, rest) => λ total values => {
            let parts = Bool::is_true_and(node.total(), nodes_total(rest), total);
            Bool::is_true_and_intro(node.defined(values), nodes_defined_over(buffers, rest, node.step(values, buffers := buffers)),
                node.total_defined(values, parts.left), nodes_total_defined(rest, buffers, parts.right, node.step(values, buffers := buffers)))
        },
    }
}

fn Region::defined(self region: Region, values: Valuation(), buffers: Buffers() := Nil) → Bool {
    nodes_defined_over(buffers, region.nodes, values)
}

fn nodes_writes(nodes: List<Node>) → List<Nat> {
    match nodes { Nil => [], Cons(node, rest) => Cons(node_output(node).id, nodes_writes(rest)) }
}

fn nodes_mentions(nodes: List<Node>) → List<Nat> {
    match nodes { Nil => [], Cons(node, rest) => node.mentions() ++ nodes_mentions(rest) }
}

// No node reads its own output, and nothing later writes an id a node
// mentions.
fn nodes_evaluable(nodes: List<Node>) → Bool {
    match nodes {
        Nil => True,
        Cons(node, rest) => absent(node_output(node).id, node.reads())
            && (disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest)),
    }
}

theorem eval_nodes_frame(nodes: List<Node>, buffers: Buffers()): (values: Valuation()) → (w, id: Nat) →
    absent(id, nodes_writes(nodes)).IsTrue() → eval_nodes_over(buffers, nodes, values)(w, id) = values(w, id) {
    match nodes {
        Nil => λ values w id _ => refl,
        Cons(node, rest) => λ values w id h => {
            let parts = Bool::is_true_and(id.differs(node_output(node).id), absent(id, nodes_writes(rest)), h);
            trans(eval_nodes_frame(rest, buffers, node.step(values, buffers := buffers), w, id, parts.right),
                Valuation::set_other(values, node_output(node).id, node.value(values, buffers := buffers), w, id,
                    id.differs_ne(node_output(node).id, parts.left)))
        },
    }
}

// Any valuation agreeing with the evaluated one on what the nodes mention
// satisfies them.
theorem eval_nodes_holds(nodes: List<Node>, buffers: Buffers()): nodes_evaluable(nodes).IsTrue() → (values, after: Valuation()) →
    ((w: Nat) → (id: Nat) → Mem(id, nodes_mentions(nodes)) → after(w, id) = eval_nodes_over(buffers, nodes, values)(w, id)) →
    nodes_defined_over(buffers, nodes, values).IsTrue() → NodesHold(after, nodes, buffers := buffers) {
    match nodes {
        Nil => λ _ values after _ _ => trivial,
        Cons(node, rest) => λ ok values after agree defined => {
            let output = node_output(node).id;
            let parts = Bool::is_true_and(absent(output, node.reads()),
                disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest), ok);
            let later = Bool::is_true_and(disjoint(nodes_writes(rest), node.mentions()), nodes_evaluable(rest), parts.right);
            let stepped = node.step(values, buffers := buffers);
            let at_output = λ (w: Nat) => trans(agree(w, output, List::mem_append_l(node.mentions(), nodes_mentions(rest), output, Inl(refl))),
                trans(eval_nodes_frame(rest, buffers, stepped, w, output, disjoint_mem(nodes_writes(rest), node.mentions(), later.left, output, Inl(refl))),
                    Valuation::set_here(values, output, node.value(values, buffers := buffers), w)));
            let kept = λ (w: Nat) (id: Nat) (m: Mem(id, node.reads())) =>
                trans(agree(w, id, List::mem_append_l(node.mentions(), nodes_mentions(rest), id, Inr(m))),
                    trans(eval_nodes_frame(rest, buffers, stepped, w, id, disjoint_mem(nodes_writes(rest), node.mentions(), later.left, id, Inr(m))),
                        Valuation::set_other(values, output, node.value(values, buffers := buffers), w, id,
                            λ e => absent_mem(output, node.reads(), parts.left, id, m, sym(e)))));
            let both = Bool::is_true_and(node.defined(values), nodes_defined_over(buffers, rest, stepped), defined);
            ⟨node.holds_of(values, after, buffers, at_output, kept, both.left),
                eval_nodes_holds(rest, buffers, later.right, stepped, after,
                    λ w id m => agree(w, id, List::mem_append_r(node.mentions(), nodes_mentions(rest), id, m)), both.right)⟩
        },
    }
}

// ---------------------------------------------------------------------------
// Structured regions

// What a call is answered with: function `f` on words, the words it
// returns (its result, then its `also`; docs/native/runtime-fn-setups-design.md
// §16.17). A call reads them all: its result the first, its `also` the rest.
fn Answers() → Type { Nat → List<BitVec(64)> → List<BitVec(64)> }

// The first of a function's words, the one in RAX (zero for none).
fn first_word(words: List<BitVec(64)>) → BitVec(64) { words.head_or(BitVec::zero()) }

// A function's words as a call reads them: the first (zero for none), then
// the rest.
fn Answers::split(words: List<BitVec(64)>) → List<BitVec(64)> { Cons(first_word(words), words.tail()) }

// A word list that is a word then more is read back as the two.
theorem words_cons_parts(x: BitVec(64), xs, words: List<BitVec(64)>, e: Cons(x, xs) = words): (x = first_word(words)) ∧ (xs = words.tail()) {
    ⟨cong_fn(λ (l: List<BitVec(64)>) => first_word(l), e), cong_fn(λ (l: List<BitVec(64)>) => l.tail(), e)⟩
}

// How a loop ends: its state, and whether its passes ran out.
record LoopEnd { state: List<BitVec(64)>, exhausted: Bool }

// A pass's own valuation: the state at the parameters, the passes left at
// `count`.
fn pass_valuation(parameters: List<Nat>, count, remaining: Nat, state: List<BitVec(64)>) → Valuation() {
    Valuation::bind(Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(remaining))), parameters, state)
}

// The loop's passes, each run by `step`, from `state` with `remaining`
// passes left.
fn loop_eval(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat) →
    List<BitVec(64)> → LoopEnd {
    match remaining {
        Zero => λ state => LoopEnd(state, True),
        Succ(rest) => λ state => {
            let after = step(pass_valuation(parameters, count, rest + 1, state));
            match after(1, exit).head_bit() {
                False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                True => LoopEnd(words_of(after, next), False),
            }
        },
    }
}

// The loop's final state is a state: as many words as parameters.
theorem loop_eval_len(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() →
    loop_eval(step, parameters, count, exit, next, remaining, state).state.len() = parameters.len() {
    match remaining {
        Zero => λ state same => same,
        Succ(rest) => λ state same => {
            let after = step(pass_valuation(parameters, count, rest + 1, state));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            match after(1, exit).head_bit() {
                False => loop_eval_len(step, parameters, count, exit, next, lengths, rest, words_of(after, next), next_len),
                True => next_len,
            }
        },
    }
}

// What the loop evaluates to is a run of it, when each pass's step
// satisfies `pass` and keeps the parameters and the count.
// Whether every pass meets its body's requirements, as `loop_eval` runs
// them: `defined` asked of each pass's valuation.
fn loop_defined(step: Valuation() → Valuation(), defined: Valuation() → Bool, parameters: List<Nat>, count, exit: Nat,
    next: List<Nat>, remaining: Nat) → List<BitVec(64)> → Bool {
    match remaining {
        Zero => λ state => True,
        Succ(rest) => λ state => {
            let before = pass_valuation(parameters, count, rest + 1, state);
            let after = step(before);
            defined(before) && match after(1, exit).head_bit() {
                False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                True => True,
            }
        },
    }
}

theorem loop_eval_runs(pass: Valuation() → Type, step: Valuation() → Valuation(), defined: Valuation() → Bool,
    holds: (v: Valuation()) → defined(v).IsTrue() → pass(step(v)),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, apart: distinct(Cons(count, parameters)).IsTrue(),
    kept: (v: Valuation()) → (w, id: Nat) → Mem(id, Cons(count, parameters)) → step(v)(w, id) = v(w, id),
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() →
    loop_defined(step, defined, parameters, count, exit, next, remaining, state).IsTrue() →
    LoopRuns(pass, parameters, count, exit, next, remaining, state, loop_eval(step, parameters, count, exit, next, remaining, state).state,
        loop_eval(step, parameters, count, exit, next, remaining, state).exhausted) {
    match remaining {
        Zero => λ state _ _ => ⟨refl, refl⟩,
        Succ(rest) => λ state same all => {
            let parts = Bool::is_true_and(absent(count, parameters), distinct(parameters), apart);
            let counted = Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(rest + 1)));
            let before = pass_valuation(parameters, count, rest + 1, state);
            let after = step(before);
            let bound: (words_of(after, parameters) = state) = trans(
                words_agree(parameters, before, after, λ id m => kept(before, 64, id, Inr(m))),
                words_of_bind(counted, parameters, parts.right, state, sym(same)));
            let at_count: (after(64, count) = BitVec::ofNat(rest + 1)) = trans(kept(before, 64, count, Inl(refl)),
                trans(Valuation::bind_frame(counted, parameters, state, 64, count, parts.left),
                    trans(Valuation::set_here(Valuation::zero(), count, word_value(BitVec::ofNat(rest + 1)), 64),
                        word_value_word(BitVec::ofNat(rest + 1)))));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            let halves = Bool::is_true_and(defined(before), match after(1, exit).head_bit() {
                False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                True => True,
            }, all);
            Exists(after, ⟨bound, ⟨at_count, ⟨holds(before, halves.left),
                (match after(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                        False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                        True => True,
                    }).IsTrue() → match b as λ _ => Type {
                    False => LoopRuns(pass, parameters, count, exit, next, rest, words_of(after, next),
                        (match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state,
                        (match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).exhausted),
                    True => ((match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state = words_of(after, next)) ∧
                        ((match b as λ _ => LoopEnd { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).exhausted = False),
                } {
                    False => λ later => loop_eval_runs(pass, step, defined, holds, parameters, count, exit, next, apart, kept, lengths, rest,
                        words_of(after, next), next_len, later),
                    True => λ _ => ⟨refl, refl⟩,
                })(halves.right)⟩⟩⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// An unbounded loop (`Until`, docs/language/loop-combinator-design.md §6.9).

// A pass's own valuation: the state at the parameters.
fn until_valuation(parameters: List<Nat>, state: List<BitVec(64)>) → Valuation() {
    Valuation::bind(Valuation::zero(), parameters, state)
}

// How many passes the evaluator gives an unbounded loop: `2^64`, so that a
// loop whose measure is a 64-bit word's `toNat` ends within them, its pass
// that leaves among them. A meaning's fuel, not a count in any code: a run
// out of it is one where the region is not defined (`until_defined`), so
// no theorem reads what it evaluates to there.
fn until_passes() → Nat { 18446744073709551616 }

// The loop's passes, each run by `step`, from `state`, `fuel` of them at
// most; past them the state it got to, which nothing defined reads.
fn until_eval(step: Valuation() → Valuation(), parameters: List<Nat>, exit: Nat, next: List<Nat>, fuel: Nat) →
    List<BitVec(64)> → LoopEnd {
    match fuel {
        Zero => λ state => LoopEnd(state, True),
        Succ(rest) => λ state => {
            let after = step(until_valuation(parameters, state));
            match after(1, exit).head_bit() {
                False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                True => LoopEnd(words_of(after, next), False),
            }
        },
    }
}

theorem until_eval_len(step: Valuation() → Valuation(), parameters: List<Nat>, exit: Nat, next: List<Nat>,
    lengths: next.len() = parameters.len(), fuel: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() → until_eval(step, parameters, exit, next, fuel, state).state.len() = parameters.len() {
    match fuel {
        Zero => λ state same => same,
        Succ(rest) => λ state same => {
            let after = step(until_valuation(parameters, state));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            match after(1, exit).head_bit() {
                False => until_eval_len(step, parameters, exit, next, lengths, rest, words_of(after, next), next_len),
                True => next_len,
            }
        },
    }
}

// Whether the loop leaves within its fuel, every pass meeting its body's
// requirements: running out is not defined. This is the loop's termination
// as the region's evaluation is held to it, a proof its producer owes.
fn until_defined(step: Valuation() → Valuation(), defined: Valuation() → Bool, parameters: List<Nat>, exit: Nat, next: List<Nat>,
    fuel: Nat) → List<BitVec(64)> → Bool {
    match fuel {
        Zero => λ state => False,
        Succ(rest) => λ state => {
            let before = until_valuation(parameters, state);
            let after = step(before);
            defined(before) && match after(1, exit).head_bit() {
                False => until_defined(step, defined, parameters, exit, next, rest, words_of(after, next)),
                True => True,
            }
        },
    }
}

theorem until_eval_runs(pass: Valuation() → Type, step: Valuation() → Valuation(), defined: Valuation() → Bool,
    holds: (v: Valuation()) → defined(v).IsTrue() → pass(step(v)),
    parameters: List<Nat>, exit: Nat, next: List<Nat>, apart: distinct(parameters).IsTrue(),
    kept: (v: Valuation()) → (w, id: Nat) → Mem(id, parameters) → step(v)(w, id) = v(w, id),
    lengths: next.len() = parameters.len(), fuel: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() →
    until_defined(step, defined, parameters, exit, next, fuel, state).IsTrue() →
    UntilRuns(pass, parameters, exit, next, fuel, state, until_eval(step, parameters, exit, next, fuel, state).state) {
    match fuel {
        Zero => λ state _ never => false_elim(never),
        Succ(rest) => λ state same all => {
            let before = until_valuation(parameters, state);
            let after = step(before);
            let bound: (words_of(after, parameters) = state) = trans(
                words_agree(parameters, before, after, λ id m => kept(before, 64, id, m)),
                words_of_bind(Valuation::zero(), parameters, apart, state, sym(same)));
            let next_len: (words_of(after, next).len() = parameters.len()) = trans(words_of_len(after, next), lengths);
            let halves = Bool::is_true_and(defined(before), match after(1, exit).head_bit() {
                False => until_defined(step, defined, parameters, exit, next, rest, words_of(after, next)),
                True => True,
            }, all);
            Exists(after, ⟨bound, ⟨holds(before, halves.left),
                (match after(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                        False => until_defined(step, defined, parameters, exit, next, rest, words_of(after, next)),
                        True => True,
                    }).IsTrue() → match b as λ _ => Type {
                    False => UntilRuns(pass, parameters, exit, next, rest, words_of(after, next),
                        (match b as λ _ => LoopEnd { False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state),
                    True => (match b as λ _ => LoopEnd { False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                            True => LoopEnd(words_of(after, next), False) }).state = words_of(after, next),
                } {
                    False => λ later => until_eval_runs(pass, step, defined, holds, parameters, exit, next, apart, kept, lengths, rest,
                        words_of(after, next), next_len, later),
                    True => λ _ => refl,
                })(halves.right)⟩⟩)
        },
    }
}

// An unbounded loop whose state keeps `invariant`, each of whose passes is
// defined there, and whose passes that go round lower `measure`, leaves
// within any fuel above the measure: its termination, proved once
// (docs/language/loop-combinator-design.md §6.9). A measure that is a
// 64-bit word's `toNat` is below `until_passes()`, so the evaluator's fuel
// never runs out for it; a loop counted to a literal bound is the measure
// that counter.
theorem until_defined_of_measure(step: Valuation() → Valuation(), defined: Valuation() → Bool, parameters: List<Nat>, exit: Nat,
    next: List<Nat>, invariant: List<BitVec(64)> → Type, measure: List<BitVec(64)> → Nat,
    pass_defined: (state: List<BitVec(64)>) → invariant(state) → defined(until_valuation(parameters, state)).IsTrue(),
    decreases: (state: List<BitVec(64)>) → invariant(state) → step(until_valuation(parameters, state))(1, exit).head_bit() = False →
        invariant(words_of(step(until_valuation(parameters, state)), next)) ∧
        measure(words_of(step(until_valuation(parameters, state)), next)) < measure(state),
    fuel: Nat): (state: List<BitVec(64)>) → invariant(state) → measure(state) < fuel →
    until_defined(step, defined, parameters, exit, next, fuel, state).IsTrue() {
    match fuel {
        Zero => λ state _ below => false_elim(Nat::not_succ_le_zero(measure(state), below)),
        Succ(rest) => λ state held below => {
            let before = until_valuation(parameters, state);
            let after = step(before);
            Bool::is_true_and_intro(defined(before), match after(1, exit).head_bit() {
                    False => until_defined(step, defined, parameters, exit, next, rest, words_of(after, next)),
                    True => True,
                }, pass_defined(state, held),
                (match after(1, exit).head_bit() as λ b => after(1, exit).head_bit() = b → (match b as λ _ => Bool {
                    False => until_defined(step, defined, parameters, exit, next, rest, words_of(after, next)),
                    True => True,
                }).IsTrue() {
                    False => λ clear => {
                        let stepped = decreases(state, held, clear);
                        let fits: (measure(words_of(after, next)) < rest) =
                            Nat::le_trans(measure(words_of(after, next)) + 1, measure(state), rest, stepped.right, below);
                        until_defined_of_measure(step, defined, parameters, exit, next, invariant, measure, pass_defined, decreases, rest,
                            words_of(after, next), stepped.left, fits)
                    },
                    True => λ _ => trivial,
                })(refl))
        },
    }
}

// A word's `toNat` is below the evaluator's fuel.
theorem until_word_within(x: BitVec(64)): x.toNat() < until_passes() { BitVec::toNat_lt_pow(64, x) }

fn StructuredRegion::eval_over(self region: StructuredRegion, buffers: Buffers(), call: Answers(), values: Valuation()) → Valuation() {
    match region {
        Dataflow(body) => body.eval(values, buffers := buffers),
        Sequence(prefix, continuation) => continuation.eval_over(buffers, call, prefix.eval(values, buffers := buffers)),
        Compose(prefix, continuation) => continuation.eval_over(buffers, call, prefix.eval_over(buffers, call, values)),
        // Branched at each value read, so a value read from a conditional is
        // a match on the condition with each arm's value, as a source `match`
        // spells it.
        Conditional(_, condition, _, _, when_true, when_false) => λ w id => match values(1, condition).head_bit() {
            False => when_false.eval_over(buffers, call, values)(w, id),
            True => when_true.eval_over(buffers, call, values)(w, id),
        },
        // Over one file a callee has none of its own: this is the call on the
        // homes and the arguments (see `StructuredRegionHoldsOver`).
        Lend(views, callee, arguments, result) => {
            let bound = eval_nodes_over(buffers, views_nodes(views), values);
            Valuation::set(bound, result, word_value(first_word(call(callee, words_of(bound, views_homes(views) ++ arguments)))))
        },
        // The result and the words past it, each at its id.
        Call(callee, arguments, result, also) => Valuation::bind(values, Cons(result, also), Answers::split(call(callee, words_of(values, arguments)))),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => {
            let end = loop_eval(λ (pass: Valuation()) => body.eval_over(buffers, call, pass), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs));
            Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted))
        },
        Until(inputs, parameters, body, exit, next, outputs) => Valuation::bind(values, outputs,
            until_eval(λ (pass: Valuation()) => body.eval_over(buffers, call, pass), parameters, exit, next, until_passes(),
                words_of(values, inputs)).state),
    }
}

fn StructuredRegion::eval(self region: StructuredRegion, call: Answers(), values: Valuation(), buffers: Buffers() := Nil) → Valuation() {
    region.eval_over(buffers, call, values)
}

// What a call's requirement is answered by: whether callee `f` is defined
// at the words (`program_defined_over`).
fn Defines() → Type { Nat → List<BitVec(64)> → Bool }

// Whether every requirement the region's evaluation meets holds: each
// node's at the valuation it is evaluated in, each pass's, and each
// callee's at the words it is called with.
fn StructuredRegion::defined_over(self region: StructuredRegion, buffers: Buffers(), call: Answers(), defines: Defines(),
    values: Valuation()) → Bool {
    match region {
        Dataflow(body) => body.defined(values, buffers := buffers),
        Sequence(prefix, continuation) => prefix.defined(values, buffers := buffers)
            && continuation.defined_over(buffers, call, defines, prefix.eval(values, buffers := buffers)),
        Compose(prefix, continuation) => prefix.defined_over(buffers, call, defines, values)
            && continuation.defined_over(buffers, call, defines, prefix.eval_over(buffers, call, values)),
        Conditional(_, condition, _, _, when_true, when_false) => match values(1, condition).head_bit() {
            False => when_false.defined_over(buffers, call, defines, values),
            True => when_true.defined_over(buffers, call, defines, values),
        },
        Lend(views, callee, arguments, _) => {
            let bound = eval_nodes_over(buffers, views_nodes(views), values);
            nodes_defined_over(buffers, views_nodes(views), values) && defines(callee, words_of(bound, views_homes(views) ++ arguments))
        },
        // And the callee answers with as many words as the call names.
        Call(callee, arguments, _, also) => defines(callee, words_of(values, arguments))
            && call(callee, words_of(values, arguments)).tail().len().matches(also.len()),
        Loop(inputs, bound, parameters, count, body, exit, next, _, _) =>
            loop_defined(λ (pass: Valuation()) => body.eval_over(buffers, call, pass),
                λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs)),
        Until(inputs, parameters, body, exit, next, _) =>
            until_defined(λ (pass: Valuation()) => body.eval_over(buffers, call, pass),
                λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass), parameters, exit, next,
                until_passes(), words_of(values, inputs)),
    }
}

fn StructuredRegion::writes(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => nodes_writes(body.nodes),
        Sequence(prefix, continuation) => nodes_writes(prefix.nodes) ++ continuation.writes(),
        Compose(prefix, continuation) => prefix.writes() ++ continuation.writes(),
        Conditional(_, _, _, _, when_true, when_false) => when_true.writes() ++ when_false.writes(),
        Lend(views, _, _, result) => nodes_writes(views_nodes(views)) ++ [result],
        Call(_, _, result, also) => Cons(result, also),
        Loop(_, _, _, _, _, _, _, outputs, exhausted) => Cons(exhausted, outputs),
        Until(_, _, _, _, _, outputs) => outputs,
    }
}

fn StructuredRegion::mentions(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => nodes_mentions(body.nodes),
        Sequence(prefix, continuation) => nodes_mentions(prefix.nodes) ++ continuation.mentions(),
        Compose(prefix, continuation) => prefix.mentions() ++ continuation.mentions(),
        Conditional(_, condition, _, _, when_true, when_false) => Cons(condition, when_true.mentions() ++ when_false.mentions()),
        Lend(views, _, arguments, result) => nodes_mentions(views_nodes(views)) ++ Cons(result, views_homes(views) ++ arguments),
        Call(_, arguments, result, also) => Cons(result, also) ++ arguments,
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => Cons(bound, inputs) ++ Cons(exhausted, outputs),
        Until(inputs, _, _, _, _, outputs) => inputs ++ outputs,
    }
}

// The function a call names takes as many words as it is given.
fn arity_fits(arity: Option<Nat>, count: Nat) → Bool {
    match arity { None => False, Some(k) => k.matches(count) }
}

fn StructuredRegion::evaluable(self region: StructuredRegion, arity: Nat → Option<Nat>) → Bool {
    match region {
        Dataflow(body) => nodes_evaluable(body.nodes),
        Sequence(prefix, continuation) => nodes_evaluable(prefix.nodes)
            && (disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity)),
        Compose(prefix, continuation) => prefix.evaluable(arity)
            && (disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity)),
        Conditional(_, condition, _, _, when_true, when_false) => absent(condition, when_true.writes() ++ when_false.writes())
            && (when_true.evaluable(arity) && when_false.evaluable(arity)),
        // The nodes that bind the homes, then the call on them.
        Lend(views, callee, arguments, result) => nodes_evaluable(views_nodes(views))
            && (disjoint([result], nodes_mentions(views_nodes(views)))
            && (absent(result, views_homes(views) ++ arguments) && arity_fits(arity(callee), (views_homes(views) ++ arguments).len()))),
        Call(callee, arguments, result, also) => distinct(Cons(result, also))
            && (disjoint(Cons(result, also), arguments) && arity_fits(arity(callee), arguments.len())),
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => body.evaluable(arity)
            && (distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
            && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
            && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
            && outputs.len().matches(parameters.len()))))))),
        Until(inputs, parameters, body, _, next, outputs) => body.evaluable(arity)
            && (distinct(parameters) && (disjoint(body.writes(), parameters)
            && (distinct(outputs) && (disjoint(outputs, inputs)
            && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
            && outputs.len().matches(parameters.len()))))))),
    }
}

// Evaluating keeps every id the region does not write.
theorem StructuredRegion::eval_frame(self region: StructuredRegion, call: Answers(), buffers: Buffers()): (values: Valuation()) →
    (w, id: Nat) → absent(id, region.writes()).IsTrue() → region.eval(call, values, buffers := buffers)(w, id) = values(w, id) {
    match region {
        Dataflow(body) => λ values w id h => eval_nodes_frame(body.nodes, buffers, values, w, id, h),
        Sequence(prefix, continuation) => λ values w id h => {
            let parts = absent_append(id, nodes_writes(prefix.nodes), continuation.writes(), h);
            trans(continuation.eval_frame(call, buffers, prefix.eval(values, buffers := buffers), w, id, parts.right),
                eval_nodes_frame(prefix.nodes, buffers, values, w, id, parts.left))
        },
        Compose(prefix, continuation) => λ values w id h => {
            let parts = absent_append(id, prefix.writes(), continuation.writes(), h);
            trans(continuation.eval_frame(call, buffers, prefix.eval(call, values, buffers := buffers), w, id, parts.right),
                prefix.eval_frame(call, buffers, values, w, id, parts.left))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values w id h => {
            let parts = absent_append(id, when_true.writes(), when_false.writes(), h);
            match values(1, condition).head_bit() {
                False => when_false.eval_frame(call, buffers, values, w, id, parts.right),
                True => when_true.eval_frame(call, buffers, values, w, id, parts.left),
            }
        },
        Lend(views, callee, arguments, result) => λ values w id h => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let parts = absent_append(id, nodes_writes(nodes), [result], h);
            trans(Valuation::set_other(first, result, word_value(first_word(call(callee, words_of(first, args)))), w, id,
                    id.differs_ne(result, Bool::is_true_and(id.differs(result), True, parts.right).left)),
                eval_nodes_frame(nodes, buffers, values, w, id, parts.left))
        },
        Call(callee, arguments, result, also) => λ values w id h =>
            Valuation::bind_frame(values, Cons(result, also), Answers::split(call(callee, words_of(values, arguments))), w, id, h),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values w id h => {
            let end = loop_eval(λ (pass: Valuation()) => body.eval(call, pass, buffers := buffers), parameters, count, exit, next, values(64, bound).toNat(),
                words_of(values, inputs));
            let parts = Bool::is_true_and(id.differs(exhausted), absent(id, outputs), h);
            trans(Valuation::set_other(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted), w, id,
                    id.differs_ne(exhausted, parts.left)),
                Valuation::bind_frame(values, outputs, end.state, w, id, parts.right))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ values w id h =>
            Valuation::bind_frame(values, outputs, until_eval(λ (pass: Valuation()) => body.eval(call, pass, buffers := buffers), parameters, exit, next,
                until_passes(), words_of(values, inputs)).state, w, id, h),
    }
}

// The theorem: when every call a region makes is answered by a result its
// callee may return, any valuation agreeing with the evaluated one on what
// the region mentions satisfies the region.
theorem StructuredRegion::eval_holds_in(self region: StructuredRegion, callees: Callees(), call: Answers(),
    defines: Defines(), arity: Nat → Option<Nat>, buffers: Buffers(),
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → defines(f, words).IsTrue() →
        callees(f, words, first_word(call(f, words)), call(f, words).tail())):
    region.evaluable(arity).IsTrue() → (values, after: Valuation()) →
    ((w: Nat) → (id: Nat) → Mem(id, region.mentions()) → after(w, id) = region.eval(call, values, buffers := buffers)(w, id)) →
    region.defined_over(buffers, call, defines, values).IsTrue() → StructuredRegionHoldsIn(callees, after, region, buffers := buffers) {
    match region {
        Dataflow(body) => λ ok values after agree defined => eval_nodes_holds(body.nodes, buffers, ok, values, after, agree, defined),
        Sequence(prefix, continuation) => λ ok values after agree defined => {
            let parts = Bool::is_true_and(nodes_evaluable(prefix.nodes),
                disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity), parts.right);
            let first = prefix.eval(values, buffers := buffers);
            let both = Bool::is_true_and(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, call, defines, first), defined);
            ⟨eval_nodes_holds(prefix.nodes, buffers, parts.left, values, after, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)),
                        continuation.eval_frame(call, buffers, first, w, id,
                            disjoint_mem(continuation.writes(), nodes_mentions(prefix.nodes), later.left, id, m))), both.left),
                continuation.eval_holds_in(callees, call, defines, arity, buffers, answers, later.right, first, after, λ w id m =>
                    agree(w, id, List::mem_append_r(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)), both.right)⟩
        },
        Compose(prefix, continuation) => λ ok values after agree defined => {
            let parts = Bool::is_true_and(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity), parts.right);
            let first = prefix.eval(call, values, buffers := buffers);
            let both = Bool::is_true_and(prefix.defined_over(buffers, call, defines, values),
                continuation.defined_over(buffers, call, defines, first), defined);
            ⟨prefix.eval_holds_in(callees, call, defines, arity, buffers, answers, parts.left, values, after, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(prefix.mentions(), continuation.mentions(), id, m)),
                        continuation.eval_frame(call, buffers, first, w, id,
                            disjoint_mem(continuation.writes(), prefix.mentions(), later.left, id, m))), both.left),
                continuation.eval_holds_in(callees, call, defines, arity, buffers, answers, later.right, first, after, λ w id m =>
                    agree(w, id, List::mem_append_r(prefix.mentions(), continuation.mentions(), id, m)), both.right)⟩
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ ok values after agree defined => {
            let parts = Bool::is_true_and(absent(condition, when_true.writes() ++ when_false.writes()),
                when_true.evaluable(arity) && when_false.evaluable(arity), ok);
            let arms = Bool::is_true_and(when_true.evaluable(arity), when_false.evaluable(arity), parts.right);
            let kept: (after(1, condition) = values(1, condition)) = trans(agree(1, condition, Inl(refl)),
                Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval_frame(call, buffers, values, 1, condition, parts.left));
            let chosen = (match values(1, condition).head_bit() as λ b =>
                    ((w: Nat) → (id: Nat) → Mem(id, Cons(condition, when_true.mentions() ++ when_false.mentions())) →
                        after(w, id) = (match b { False => when_false.eval(call, values, buffers := buffers)(w, id), True => when_true.eval(call, values, buffers := buffers)(w, id) })) →
                    (match b {
                        False => when_false.defined_over(buffers, call, defines, values),
                        True => when_true.defined_over(buffers, call, defines, values),
                    }).IsTrue() →
                    (match b {
                        False => StructuredRegionHoldsIn(callees, after, when_false, buffers := buffers),
                        True => StructuredRegionHoldsIn(callees, after, when_true, buffers := buffers),
                    }) {
                False => λ chose here => when_false.eval_holds_in(callees, call, defines, arity, buffers, answers, arms.right, values, after, λ w id m =>
                    chose(w, id, Inr(List::mem_append_r(when_true.mentions(), when_false.mentions(), id, m))), here),
                True => λ chose here => when_true.eval_holds_in(callees, call, defines, arity, buffers, answers, arms.left, values, after, λ w id m =>
                    chose(w, id, Inr(List::mem_append_l(when_true.mentions(), when_false.mentions(), id, m))), here),
            })(agree, defined);
            j(sym(kept), λ x _ => match x.head_bit() {
                False => StructuredRegionHoldsIn(callees, after, when_false, buffers := buffers),
                True => StructuredRegionHoldsIn(callees, after, when_true, buffers := buffers),
            }, chosen)
        },
        Lend(views, callee, arguments, result) => λ ok values after agree defined => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let parts = Bool::is_true_and(nodes_evaluable(nodes),
                disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(arity(callee), args.len())), ok);
            let later = Bool::is_true_and(disjoint([result], nodes_mentions(nodes)), absent(result, args) && arity_fits(arity(callee), args.len()),
                parts.right);
            let last = Bool::is_true_and(absent(result, args), arity_fits(arity(callee), args.len()), later.right);
            let first = eval_nodes_over(buffers, nodes, values);
            let words = words_of(first, args);
            let answer = first_word(call(callee, words));
            let at_result: (after(64, result) = answer) = trans(agree(64, result, List::mem_append_r(nodes_mentions(nodes), Cons(result, args), result, Inl(refl))),
                trans(Valuation::set_here(first, result, word_value(answer), 64), word_value_word(answer)));
            let read: (words_of(after, args) = words) = words_agree(args, first, after, λ id m =>
                trans(agree(64, id, List::mem_append_r(nodes_mentions(nodes), Cons(result, args), id, Inr(m))),
                    Valuation::set_other(first, result, word_value(answer), 64, id, λ e => absent_mem(result, args, last.left, id, m, sym(e)))));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(first, args)), λ n _ => arity_fits(arity(callee), n).IsTrue(), last.right);
            let both = Bool::is_true_and(nodes_defined_over(buffers, nodes, values), defines(callee, words), defined);
            ⟨eval_nodes_holds(nodes, buffers, parts.left, values, after, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(nodes_mentions(nodes), Cons(result, args), id, m)),
                        Valuation::set_other(first, result, word_value(answer), w, id, id.differs_ne(result,
                            Bool::is_true_and(id.differs(result), True, disjoint_mem([result], nodes_mentions(nodes), later.left, id, m)).left))),
                    both.left),
                Exists(call(callee, words).tail(), j(sym(read), λ ws _ => callees(callee, ws, after(64, result), call(callee, words).tail()),
                    j(sym(at_result), λ r _ => callees(callee, words, r, call(callee, words).tail()), answers(callee, words, fits, both.right))))⟩
        },
        Call(callee, arguments, result, also) => λ ok values after agree defined => {
            let outs = Cons(result, also);
            let parts = Bool::is_true_and(distinct(outs), disjoint(outs, arguments) && arity_fits(arity(callee), arguments.len()), ok);
            let later = Bool::is_true_and(disjoint(outs, arguments), arity_fits(arity(callee), arguments.len()), parts.right);
            let words = words_of(values, arguments);
            let answer = call(callee, words);
            let asked = Bool::is_true_and(defines(callee, words), answer.tail().len().matches(also.len()), defined);
            let bound = Valuation::bind(values, outs, Answers::split(answer));
            let written: (words_of(after, outs) = Answers::split(answer)) = trans(
                words_agree(outs, bound, after, λ id m => agree(64, id, List::mem_append_l(outs, arguments, id, m))),
                words_of_bind(values, outs, parts.left, Answers::split(answer),
                    cong_fn(λ (n: Nat) => n + 1, sym(answer.tail().len().matches_eq(also.len(), asked.right)))));
            let parted = words_cons_parts(after(64, result), words_of(after, also), Answers::split(answer), written);
            let read: (words_of(after, arguments) = words) = words_agree(arguments, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_r(outs, arguments, id, m)),
                    Valuation::bind_frame(values, outs, Answers::split(answer), 64, id, disjoint_mem(outs, arguments, later.left, id, m))));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(values, arguments)), λ n _ => arity_fits(arity(callee), n).IsTrue(), later.right);
            j(sym(read), λ ws _ => callees(callee, ws, after(64, result), words_of(after, also)),
                j(sym(parted.right), λ t _ => callees(callee, words, after(64, result), t),
                    j(sym(parted.left), λ r _ => callees(callee, words, r, answer.tail()), answers(callee, words, fits, asked.left))))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok values after agree defined => {
            let pass = λ (v: Valuation()) => StructuredRegionHoldsIn(callees, v, body, buffers := buffers);
            let step = λ (v: Valuation()) => body.eval(call, v, buffers := buffers);
            let p1 = Bool::is_true_and(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            let p2 = Bool::is_true_and(distinct(Cons(count, parameters)), disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))))), p1.right);
            let p3 = Bool::is_true_and(disjoint(body.writes(), Cons(count, parameters)), distinct(Cons(exhausted, outputs))
                && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))), p2.right);
            let p4 = Bool::is_true_and(distinct(Cons(exhausted, outputs)), disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))), p3.right);
            let p5 = Bool::is_true_and(disjoint(Cons(exhausted, outputs), Cons(bound, inputs)), inputs.len().matches(parameters.len())
                && (next.len().matches(parameters.len()) && outputs.len().matches(parameters.len())), p4.right);
            let p6 = Bool::is_true_and(inputs.len().matches(parameters.len()),
                next.len().matches(parameters.len()) && outputs.len().matches(parameters.len()), p5.right);
            let p7 = Bool::is_true_and(next.len().matches(parameters.len()), outputs.len().matches(parameters.len()), p6.right);
            let outs = Bool::is_true_and(absent(exhausted, outputs), distinct(outputs), p4.left);
            let in_len: (words_of(values, inputs).len() = parameters.len()) =
                trans(words_of_len(values, inputs), inputs.len().matches_eq(parameters.len(), p6.left));
            let next_len: (next.len() = parameters.len()) = next.len().matches_eq(parameters.len(), p7.left);
            let n = values(64, bound).toNat();
            let start = words_of(values, inputs);
            let end = loop_eval(step, parameters, count, exit, next, n, start);
            let region = Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted);
            let bound_after: (after(64, bound) = values(64, bound)) = trans(agree(64, bound, Inl(refl)),
                region.eval_frame(call, buffers, values, 64, bound, disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, bound, Inl(refl))));
            let inputs_after: (words_of(after, inputs) = start) = words_agree(inputs, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_l(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                    region.eval_frame(call, buffers, values, 64, id, disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, id, Inr(m)))));
            let bound_values = Valuation::bind(values, outputs, end.state);
            let outputs_after: (words_of(after, outputs) = end.state) = trans(
                words_agree(outputs, bound_values, after, λ id m =>
                    trans(agree(64, id, List::mem_append_r(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                        Valuation::set_other(bound_values, exhausted, bit_value(end.exhausted), 64, id,
                            λ e => absent_mem(exhausted, outputs, outs.left, id, m, sym(e))))),
                words_of_bind(values, outputs, outs.right, end.state,
                    trans(outputs.len().matches_eq(parameters.len(), p7.right),
                        sym(loop_eval_len(step, parameters, count, exit, next, next_len, n, start, in_len)))));
            let exhausted_after: (after(1, exhausted).head_bit() = end.exhausted) = trans(
                cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), trans(agree(1, exhausted, List::mem_append_r(Cons(bound, inputs),
                    Cons(exhausted, outputs), exhausted, Inl(refl))),
                    trans(Valuation::set_here(bound_values, exhausted, bit_value(end.exhausted), 1), bit_value_bit(end.exhausted)))),
                BitVec::head_bit_ofBool(end.exhausted));
            let runs = loop_eval_runs(pass, step, λ (v: Valuation()) => body.defined_over(buffers, call, defines, v),
                λ v here => body.eval_holds_in(callees, call, defines, arity, buffers, answers, p1.left, v, body.eval(call, v, buffers := buffers),
                    λ w id m => refl, here),
                parameters, count, exit, next, p2.left,
                λ v w id m => body.eval_frame(call, buffers, v, w, id, disjoint_mem(body.writes(), Cons(count, parameters), p3.left, id, m)),
                next_len, n, start, in_len, defined);
            j(sym(exhausted_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), words_of(after, inputs),
                    words_of(after, outputs), x),
                j(sym(outputs_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), words_of(after, inputs),
                        x, end.exhausted),
                    j(sym(inputs_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, after(64, bound).toNat(), x, end.state,
                            end.exhausted),
                        j(sym(bound_after), λ x _ => LoopRuns(pass, parameters, count, exit, next, x.toNat(), start, end.state, end.exhausted),
                            runs))))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ ok values after agree defined => {
            let pass = λ (v: Valuation()) => StructuredRegionHoldsIn(callees, v, body, buffers := buffers);
            let step = λ (v: Valuation()) => body.eval(call, v, buffers := buffers);
            let p1 = Bool::is_true_and(body.evaluable(arity), distinct(parameters) && (disjoint(body.writes(), parameters)
                && (distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            let p2 = Bool::is_true_and(distinct(parameters), disjoint(body.writes(), parameters)
                && (distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))))), p1.right);
            let p3 = Bool::is_true_and(disjoint(body.writes(), parameters), distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))), p2.right);
            let p4 = Bool::is_true_and(distinct(outputs), disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))), p3.right);
            let p5 = Bool::is_true_and(disjoint(outputs, inputs), inputs.len().matches(parameters.len())
                && (next.len().matches(parameters.len()) && outputs.len().matches(parameters.len())), p4.right);
            let p6 = Bool::is_true_and(inputs.len().matches(parameters.len()),
                next.len().matches(parameters.len()) && outputs.len().matches(parameters.len()), p5.right);
            let p7 = Bool::is_true_and(next.len().matches(parameters.len()), outputs.len().matches(parameters.len()), p6.right);
            let in_len: (words_of(values, inputs).len() = parameters.len()) =
                trans(words_of_len(values, inputs), inputs.len().matches_eq(parameters.len(), p6.left));
            let next_len: (next.len() = parameters.len()) = next.len().matches_eq(parameters.len(), p7.left);
            let start = words_of(values, inputs);
            let end = until_eval(step, parameters, exit, next, until_passes(), start);
            let region = Until(inputs, parameters, body, exit, next, outputs);
            let inputs_after: (words_of(after, inputs) = start) = words_agree(inputs, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_l(inputs, outputs, id, m)),
                    region.eval_frame(call, buffers, values, 64, id, disjoint_mem(outputs, inputs, p5.left, id, m))));
            let outputs_after: (words_of(after, outputs) = end.state) = trans(
                words_agree(outputs, Valuation::bind(values, outputs, end.state), after, λ id m =>
                    agree(64, id, List::mem_append_r(inputs, outputs, id, m))),
                words_of_bind(values, outputs, p4.left, end.state,
                    trans(outputs.len().matches_eq(parameters.len(), p7.right),
                        sym(until_eval_len(step, parameters, exit, next, next_len, until_passes(), start, in_len)))));
            let runs = until_eval_runs(pass, step, λ (v: Valuation()) => body.defined_over(buffers, call, defines, v),
                λ v here => body.eval_holds_in(callees, call, defines, arity, buffers, answers, p1.left, v, body.eval(call, v, buffers := buffers),
                    λ w id m => refl, here),
                parameters, exit, next, p2.left,
                λ v w id m => body.eval_frame(call, buffers, v, w, id, disjoint_mem(body.writes(), parameters, p3.left, id, m)),
                next_len, until_passes(), start, in_len, defined);
            Exists(until_passes(), j(sym(outputs_after), λ x _ => UntilRuns(pass, parameters, exit, next, until_passes(), words_of(after, inputs), x),
                j(sym(inputs_after), λ x _ => UntilRuns(pass, parameters, exit, next, until_passes(), x, end.state), runs)))
        },
    }
}

// ---------------------------------------------------------------------------
// Evaluation reads its valuation only pointwise, and its calls only at the
// calls it makes: from valuations that agree, with calls answered alike, a
// region evaluates alike. This is what lets a program's functions be proved
// one at a time, each call answered by its callee's meaning rather than its
// evaluation (`program_eval_sources`, below).

// `other` agrees with `values` at every width and id.
fn Valuation::Same(values, other: Valuation()) → Type { (w: Nat) → (id: Nat) → other(w, id) = values(w, id) }

theorem Valuation::set_same(values, other: Valuation(), same: Valuation::Same(values, other), id: Nat,
    value, value2: (w: Nat) → BitVec(w), at: (w: Nat) → value2(w) = value(w)):
    Valuation::Same(Valuation::set(values, id, value), Valuation::set(other, id, value2)) {
    λ w query => match query.eq_dec(id) {
        Inl(_) => at(w),
        Inr(_) => same(w, query),
    }
}

theorem Valuation::bind_same(values, other: Valuation(), same: Valuation::Same(values, other), ids: List<Nat>):
    (words: List<BitVec(64)>) → Valuation::Same(Valuation::bind(values, ids, words), Valuation::bind(other, ids, words)) {
    match ids {
        Nil => λ words => same,
        Cons(id, rest) => λ words => match words {
            Nil => same,
            Cons(word, more) => Valuation::set_same(Valuation::bind(values, rest, more), Valuation::bind(other, rest, more),
                Valuation::bind_same(values, other, same, rest, more), id, word_value(word), word_value(word), λ w => refl),
        },
    }
}

theorem Node::value_same_over(self node: Node, buffers: Buffers(), values, other: Valuation(), same: Valuation::Same(values, other)):
    (w: Nat) → node.value(other, buffers := buffers)(w) = node.value(values, buffers := buffers)(w) {
    match node {
        Const(_, _, _) => λ w => refl,
        Move(_, _, source) => λ w => same(w, source),
        Add(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y), same(w, left), same(w, right)),
        Sub(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y), same(w, left), same(w, right)),
        BitAnd(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y), same(w, left), same(w, right)),
        BitOr(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y), same(w, left), same(w, right)),
        BitXor(_, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y), same(w, left), same(w, right)),
        ShiftLeft(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.shift_left(amount), same(w, value)),
        LogicalShiftRight(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.shift_right(amount), same(w, value)),
        RotateRight(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.rotr(amount), same(w, value)),
        Apply(op, _, _, left, right) => λ w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => op.run(x, y), same(w, left), same(w, right)),
        ArithmeticShiftRight(_, _, value, amount) => λ w => cong_fn(λ (x: BitVec(w)) => x.arithmetic_shift_right(amount), same(w, value)),
        UnsignedLessThan(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y), same(width, left), same(width, right))),
        SignedLessThan(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y), same(width, left), same(width, right))),
        Equal(width, _, left, right) => λ w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y), same(width, left), same(width, right))),
        BufferLoad(_, buffer, index) => λ w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(buffers, buffer, x.toNat())), w),
            same(64, index)),
        BufferStore(_, buffer, index, _) => λ w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(buffers, buffer, x.toNat())), w),
            same(64, index)),
        Resize(from, _, _, source) => λ w => cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := w), same(from, source)),
        SignResize(from, _, _, source) => λ w => cong_fn(λ (x: BitVec(from)) => x.sresize(w), same(from, source)),
        TableRead(_, _, bits, index, entries) => λ w => cong_fn(λ (x: BitVec(bits)) => BitVec::ofNat(table_entry(entries, x.toNat()), n := w),
            same(bits, index)),
        WideLoad(bytes, _, buffer, index) => λ w => cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(buffers, buffer, x.toNat(), bytes).toNat(), n := w),
            same(64, index)),
        WideStore(bytes, _, buffer, index, _) => λ w => cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(buffers, buffer, x.toNat(), bytes).toNat(), n := w),
            same(64, index)),
        ByteSwap(_, _, source) => λ w => cong_fn(λ (x: BitVec(w)) => x.swap_bytes(), same(w, source)),
    }
}

theorem Node::value_same(self node: Node, values, other: Valuation(), same: Valuation::Same(values, other)):
    (w: Nat) → node.value(other)(w) = node.value(values)(w) {
    node.value_same_over(Nil, values, other, same)
}

theorem eval_nodes_same_over(buffers: Buffers(), nodes: List<Node>): (values, other: Valuation()) → Valuation::Same(values, other) →
    Valuation::Same(eval_nodes_over(buffers, nodes, values), eval_nodes_over(buffers, nodes, other)) {
    match nodes {
        Nil => λ values other same => same,
        Cons(node, rest) => λ values other same => eval_nodes_same_over(buffers, rest, node.step(values, buffers := buffers), node.step(other, buffers := buffers),
            Valuation::set_same(values, other, same, node_output(node).id, node.value(values, buffers := buffers), node.value(other, buffers := buffers),
                node.value_same_over(buffers, values, other, same))),
    }
}

theorem eval_nodes_same(nodes: List<Node>): (values, other: Valuation()) → Valuation::Same(values, other) →
    Valuation::Same(eval_nodes(nodes, values), eval_nodes(nodes, other)) {
    eval_nodes_same_over(Nil, nodes)
}

// Loops whose passes agree run alike.
theorem loop_eval_same(step, other_step: Valuation() → Valuation(), same: (v: Valuation()) → Valuation::Same(step(v), other_step(v)),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → loop_eval(other_step, parameters, count, exit, next, remaining, state) =
        loop_eval(step, parameters, count, exit, next, remaining, state) {
    match remaining {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let entry = pass_valuation(parameters, count, rest + 1, state);
            let after = step(entry);
            let bit: (other_step(entry, 1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(entry, 1, exit));
            let words: (words_of(other_step(entry), next) = words_of(after, next)) =
                words_agree(next, after, other_step(entry), λ id _ => same(entry, 64, id));
            let moved = eq2(λ (b: Bool) (ws: List<BitVec(64)>) => match b {
                    False => loop_eval(other_step, parameters, count, exit, next, rest, ws),
                    True => LoopEnd(ws, False),
                }, bit, words);
            trans(moved, match after(1, exit).head_bit() as λ b =>
                (match b { False => loop_eval(other_step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) =
                (match b { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) {
                False => loop_eval_same(step, other_step, same, parameters, count, exit, next, rest, words_of(after, next)),
                True => refl,
            })
        },
    }
}

theorem until_eval_same(step, other_step: Valuation() → Valuation(), same: (v: Valuation()) → Valuation::Same(step(v), other_step(v)),
    parameters: List<Nat>, exit: Nat, next: List<Nat>, fuel: Nat):
    (state: List<BitVec(64)>) → until_eval(other_step, parameters, exit, next, fuel, state) = until_eval(step, parameters, exit, next, fuel, state) {
    match fuel {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let entry = until_valuation(parameters, state);
            let after = step(entry);
            let bit: (other_step(entry, 1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(entry, 1, exit));
            let words: (words_of(other_step(entry), next) = words_of(after, next)) =
                words_agree(next, after, other_step(entry), λ id _ => same(entry, 64, id));
            let moved = eq2(λ (b: Bool) (ws: List<BitVec(64)>) => match b {
                    False => until_eval(other_step, parameters, exit, next, rest, ws),
                    True => LoopEnd(ws, False),
                }, bit, words);
            trans(moved, match after(1, exit).head_bit() as λ b =>
                (match b { False => until_eval(other_step, parameters, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) =
                (match b { False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) {
                False => until_eval_same(step, other_step, same, parameters, exit, next, rest, words_of(after, next)),
                True => refl,
            })
        },
    }
}

// Every call names a function of the arity it is given: all that answering
// a region's calls alike needs of it (`eval_answers`). Linear in the
// region, where `evaluable`'s disjointness checks are quadratic, so a
// program built from functions already checked (a runtime fn's callees,
// issues/runtime-fn-caller-agreement-fuel.md) is linked by this alone.
fn StructuredRegion::calls_fit(self region: StructuredRegion, arity: Nat → Option<Nat>) → Bool {
    match region {
        Dataflow(_) => True,
        Sequence(_, continuation) => continuation.calls_fit(arity),
        Compose(prefix, continuation) => prefix.calls_fit(arity) && continuation.calls_fit(arity),
        Conditional(_, _, _, _, when_true, when_false) => when_true.calls_fit(arity) && when_false.calls_fit(arity),
        Lend(views, callee, arguments, _) => arity_fits(arity(callee), (views_homes(views) ++ arguments).len()),
        Call(callee, arguments, _, _) => arity_fits(arity(callee), arguments.len()),
        Loop(_, _, _, _, body, _, _, _, _) => body.calls_fit(arity),
        Until(_, _, body, _, _, _) => body.calls_fit(arity),
    }
}

theorem StructuredRegion::evaluable_calls_fit(self region: StructuredRegion, arity: Nat → Option<Nat>):
    region.evaluable(arity).IsTrue() → region.calls_fit(arity).IsTrue() {
    match region {
        Dataflow(_) => λ _ => trivial,
        Sequence(prefix, continuation) => λ ok => {
            let parts = Bool::is_true_and(nodes_evaluable(prefix.nodes),
                disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity), parts.right);
            continuation.evaluable_calls_fit(arity, later.right)
        },
        Compose(prefix, continuation) => λ ok => {
            let parts = Bool::is_true_and(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity), parts.right);
            Bool::is_true_and_intro(prefix.calls_fit(arity), continuation.calls_fit(arity),
                prefix.evaluable_calls_fit(arity, parts.left), continuation.evaluable_calls_fit(arity, later.right))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ ok => {
            let parts = Bool::is_true_and(absent(condition, when_true.writes() ++ when_false.writes()),
                when_true.evaluable(arity) && when_false.evaluable(arity), ok);
            let arms = Bool::is_true_and(when_true.evaluable(arity), when_false.evaluable(arity), parts.right);
            Bool::is_true_and_intro(when_true.calls_fit(arity), when_false.calls_fit(arity),
                when_true.evaluable_calls_fit(arity, arms.left), when_false.evaluable_calls_fit(arity, arms.right))
        },
        Lend(views, callee, arguments, result) => λ ok => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let parts = Bool::is_true_and(nodes_evaluable(nodes),
                disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(arity(callee), args.len())), ok);
            let later = Bool::is_true_and(disjoint([result], nodes_mentions(nodes)), absent(result, args) && arity_fits(arity(callee), args.len()),
                parts.right);
            Bool::is_true_and(absent(result, args), arity_fits(arity(callee), args.len()), later.right).right
        },
        Call(callee, arguments, result, also) => λ ok => Bool::is_true_and(disjoint(Cons(result, also), arguments), arity_fits(arity(callee), arguments.len()),
            Bool::is_true_and(distinct(Cons(result, also)), disjoint(Cons(result, also), arguments) && arity_fits(arity(callee), arguments.len()), ok).right).right,
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok => {
            let passes = Bool::is_true_and(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            body.evaluable_calls_fit(arity, passes.left)
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ ok => {
            let passes = Bool::is_true_and(body.evaluable(arity), distinct(parameters) && (disjoint(body.writes(), parameters)
                && (distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            body.evaluable_calls_fit(arity, passes.left)
        },
    }
}

// The theorem: a region whose calls fit, its calls answered alike wherever
// the arities fit, evaluates alike from agreeing valuations.
theorem StructuredRegion::eval_answers_over(self region: StructuredRegion, buffers: Buffers(), call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words)):
    region.calls_fit(arity).IsTrue() → (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval_over(buffers, call, values), region.eval_over(buffers, other, others)) {
    match region {
        Dataflow(body) => λ ok values others same => eval_nodes_same_over(buffers, body.nodes, values, others, same),
        Sequence(prefix, continuation) => λ ok values others same =>
            continuation.eval_answers_over(buffers, call, other, arity, answers, ok, prefix.eval(values, buffers := buffers), prefix.eval(others, buffers := buffers),
                eval_nodes_same_over(buffers, prefix.nodes, values, others, same)),
        Compose(prefix, continuation) => λ ok values others same => {
            let parts = Bool::is_true_and(prefix.calls_fit(arity), continuation.calls_fit(arity), ok);
            continuation.eval_answers_over(buffers, call, other, arity, answers, parts.right, prefix.eval_over(buffers, call, values), prefix.eval_over(buffers, other, others),
                prefix.eval_answers_over(buffers, call, other, arity, answers, parts.left, values, others, same))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ ok values others same => λ w id => {
            let arms = Bool::is_true_and(when_true.calls_fit(arity), when_false.calls_fit(arity), ok);
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = match values(1, condition).head_bit() as λ b =>
                (match b { False => when_false.eval_over(buffers, other, others)(w, id), True => when_true.eval_over(buffers, other, others)(w, id) }) =
                (match b { False => when_false.eval_over(buffers, call, values)(w, id), True => when_true.eval_over(buffers, call, values)(w, id) }) {
                False => when_false.eval_answers_over(buffers, call, other, arity, answers, arms.right, values, others, same, w, id),
                True => when_true.eval_answers_over(buffers, call, other, arity, answers, arms.left, values, others, same, w, id),
            };
            j(bit, λ b _ => (match b { False => when_false.eval_over(buffers, other, others)(w, id), True => when_true.eval_over(buffers, other, others)(w, id) }) =
                (match values(1, condition).head_bit() {
                    False => when_false.eval_over(buffers, call, values)(w, id),
                    True => when_true.eval_over(buffers, call, values)(w, id),
                }), aligned)
        },
        Lend(views, callee, arguments, result) => λ ok values others same => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let second = eval_nodes_over(buffers, nodes, others);
            let alike = eval_nodes_same_over(buffers, nodes, values, others, same);
            let words = words_of(first, args);
            let read: (words_of(second, args) = words) = words_agree(args, first, second, λ id _ => alike(64, id));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(first, args)), λ n _ => arity_fits(arity(callee), n).IsTrue(), ok);
            let answered: (other(callee, words_of(second, args)) = call(callee, words)) =
                trans(cong_fn(λ (ws: List<BitVec(64)>) => other(callee, ws), read), answers(callee, words, fits));
            Valuation::set_same(first, second, alike, result, word_value(first_word(call(callee, words))), word_value(first_word(other(callee, words_of(second, args)))),
                λ w => cong_fn(λ (x: List<BitVec(64)>) => word_value(first_word(x), w), answered))
        },
        Call(callee, arguments, result, also) => λ ok values others same => {
            let words = words_of(values, arguments);
            let read: (words_of(others, arguments) = words) = words_agree(arguments, values, others, λ id _ => same(64, id));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(values, arguments)), λ n _ => arity_fits(arity(callee), n).IsTrue(), ok);
            let answered: (other(callee, words_of(others, arguments)) = call(callee, words)) =
                trans(cong_fn(λ (ws: List<BitVec(64)>) => other(callee, ws), read), answers(callee, words, fits));
            j(sym(answered), λ a _ => Valuation::Same(Valuation::bind(values, Cons(result, also), Answers::split(call(callee, words))),
                    Valuation::bind(others, Cons(result, also), Answers::split(a))),
                Valuation::bind_same(values, others, same, Cons(result, also), Answers::split(call(callee, words))))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok values others same => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, call, pass);
            let other_step = λ (pass: Valuation()) => body.eval_over(buffers, other, pass);
            let end = loop_eval(step, parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs));
            let ran: (loop_eval(other_step, parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)) = end) =
                trans(loop_eval_same(step, other_step, λ v => body.eval_answers_over(buffers, call, other, arity, answers, ok, v, v, λ w id => refl),
                        parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)),
                    eq2(λ (n: Nat) (s: List<BitVec(64)>) => loop_eval(step, parameters, count, exit, next, n, s),
                        cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound)), words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(others, outputs, e.state), exhausted, bit_value(e.exhausted))),
                Valuation::set_same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, end.state),
                    Valuation::bind_same(values, others, same, outputs, end.state), exhausted, bit_value(end.exhausted), bit_value(end.exhausted),
                    λ w => refl))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ ok values others same => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, call, pass);
            let other_step = λ (pass: Valuation()) => body.eval_over(buffers, other, pass);
            let end = until_eval(step, parameters, exit, next, until_passes(), words_of(values, inputs));
            let ran: (until_eval(other_step, parameters, exit, next, until_passes(), words_of(others, inputs)) = end) =
                trans(until_eval_same(step, other_step, λ v => body.eval_answers_over(buffers, call, other, arity, answers, ok, v, v, λ w id => refl),
                        parameters, exit, next, until_passes(), words_of(others, inputs)),
                    cong_fn(λ (st: List<BitVec(64)>) => until_eval(step, parameters, exit, next, until_passes(), st),
                        words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, e.state)),
                Valuation::bind_same(values, others, same, outputs, end.state))
        },
    }
}

theorem StructuredRegion::eval_answers(self region: StructuredRegion, call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words)):
    region.calls_fit(arity).IsTrue() → (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval(call, values), region.eval(other, others)) {
    region.eval_answers_over(Nil, call, other, arity, answers)
}

// A region whose nodes all require nothing (`Node::total`), and whose
// calls each name as many words as the callee returns past its first
// (`outs`, a program's `program_outs`; none where it says nothing): it is
// defined wherever its callees are, which is how a program without a
// divide meets its certificates' `defined` premise by evaluation.
fn StructuredRegion::total_at(self region: StructuredRegion, outs: Nat → Nat) → Bool {
    match region {
        Dataflow(body) => nodes_total(body.nodes),
        Sequence(prefix, continuation) => nodes_total(prefix.nodes) && continuation.total_at(outs),
        Compose(prefix, continuation) => prefix.total_at(outs) && continuation.total_at(outs),
        Conditional(_, _, _, _, when_true, when_false) => when_true.total_at(outs) && when_false.total_at(outs),
        Lend(views, _, _, _) => nodes_total(views_nodes(views)),
        Call(callee, _, _, also) => outs(callee).matches(also.len()),
        Loop(_, _, _, _, body, _, _, _, _) => body.total_at(outs),
        // Defined only where it ends, which no node's totality says: a
        // proof its producer owes (`until_defined`).
        Until(_, _, _, _, _, _) => False,
    }
}

// Where the program says nothing of its callees' words: every call names
// its result alone.
fn StructuredRegion::total(self region: StructuredRegion) → Bool { region.total_at(λ _ => 0) }

theorem loop_defined_all(step: Valuation() → Valuation(), defined: Valuation() → Bool, all: (v: Valuation()) → defined(v).IsTrue(),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → loop_defined(step, defined, parameters, count, exit, next, remaining, state).IsTrue() {
    match remaining {
        Zero => λ _ => trivial,
        Succ(rest) => λ state => {
            let before = pass_valuation(parameters, count, rest + 1, state);
            let after = step(before);
            Bool::is_true_and_intro(defined(before), match after(1, exit).head_bit() {
                    False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                    True => True,
                }, all(before),
                match after(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                    False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                    True => True,
                }).IsTrue() {
                    False => loop_defined_all(step, defined, all, parameters, count, exit, next, rest, words_of(after, next)),
                    True => trivial,
                })
        },
    }
}

theorem StructuredRegion::total_defined(self region: StructuredRegion, buffers: Buffers(), call: Answers(), defines: Defines(),
    all: (f: Nat) → (words: List<BitVec(64)>) → defines(f, words).IsTrue(), outs: Nat → Nat,
    lens: (f: Nat) → (words: List<BitVec(64)>) → call(f, words).tail().len() = outs(f)):
    region.total_at(outs).IsTrue() → (values: Valuation()) → region.defined_over(buffers, call, defines, values).IsTrue() {
    match region {
        Dataflow(body) => λ total values => nodes_total_defined(body.nodes, buffers, total, values),
        Sequence(prefix, continuation) => λ total values => {
            let parts = Bool::is_true_and(nodes_total(prefix.nodes), continuation.total_at(outs), total);
            Bool::is_true_and_intro(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, call, defines, prefix.eval(values, buffers := buffers)),
                nodes_total_defined(prefix.nodes, buffers, parts.left, values),
                continuation.total_defined(buffers, call, defines, all, outs, lens, parts.right, prefix.eval(values, buffers := buffers)))
        },
        Compose(prefix, continuation) => λ total values => {
            let parts = Bool::is_true_and(prefix.total_at(outs), continuation.total_at(outs), total);
            Bool::is_true_and_intro(prefix.defined_over(buffers, call, defines, values),
                continuation.defined_over(buffers, call, defines, prefix.eval_over(buffers, call, values)),
                prefix.total_defined(buffers, call, defines, all, outs, lens, parts.left, values),
                continuation.total_defined(buffers, call, defines, all, outs, lens, parts.right, prefix.eval_over(buffers, call, values)))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ total values => {
            let parts = Bool::is_true_and(when_true.total_at(outs), when_false.total_at(outs), total);
            match values(1, condition).head_bit() as λ b => (match b as λ _ => Bool {
                False => when_false.defined_over(buffers, call, defines, values),
                True => when_true.defined_over(buffers, call, defines, values),
            }).IsTrue() {
                False => when_false.total_defined(buffers, call, defines, all, outs, lens, parts.right, values),
                True => when_true.total_defined(buffers, call, defines, all, outs, lens, parts.left, values),
            }
        },
        Lend(views, callee, arguments, _) => λ total values => {
            let bound = eval_nodes_over(buffers, views_nodes(views), values);
            Bool::is_true_and_intro(nodes_defined_over(buffers, views_nodes(views), values),
                defines(callee, words_of(bound, views_homes(views) ++ arguments)),
                nodes_total_defined(views_nodes(views), buffers, total, values), all(callee, words_of(bound, views_homes(views) ++ arguments)))
        },
        Call(callee, arguments, _, also) => λ total values => Bool::is_true_and_intro(defines(callee, words_of(values, arguments)),
            call(callee, words_of(values, arguments)).tail().len().matches(also.len()), all(callee, words_of(values, arguments)),
            Nat::matches_of_eq(call(callee, words_of(values, arguments)).tail().len(), also.len(),
                trans(lens(callee, words_of(values, arguments)), outs(callee).matches_eq(also.len(), total)))),
        Loop(inputs, bound, parameters, count, body, exit, next, _, _) => λ total values =>
            loop_defined_all(λ (pass: Valuation()) => body.eval_over(buffers, call, pass),
                λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass),
                λ pass => body.total_defined(buffers, call, defines, all, outs, lens, total, pass), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs)),
        Until(_, _, _, _, _, _) => λ never values => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// Functions and programs

// Called on `arguments`: the parameters bound, the body evaluated, the
// result read.
fn Function::eval(self function: Function, call: Answers(), arguments: List<BitVec(64)>, buffers: Buffers() := Nil) → BitVec(64) {
    function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers := buffers)(64, function.result)
}

// Whether the function is defined at the arguments: every requirement its
// evaluation meets holds, its callees' by `defines`.
fn Function::defined(self function: Function, call: Answers(), defines: Defines(), arguments: List<BitVec(64)>,
    buffers: Buffers() := Nil) → Bool {
    function.body.defined_over(buffers, call, defines, Valuation::bind(Valuation::zero(), function.parameters, arguments))
}

// Its words past the first, from the same evaluation.
fn Function::eval_also(self function: Function, call: Answers(), arguments: List<BitVec(64)>, buffers: Buffers() := Nil) → List<BitVec(64)> {
    words_of(function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers := buffers), function.also)
}

// All its words: the result, then its `also`. What a call of it is
// answered with; its first is `eval` and the rest `eval_also`, both by
// evaluation.
fn Function::eval_words(self function: Function, call: Answers(), arguments: List<BitVec(64)>, buffers: Buffers() := Nil) → List<BitVec(64)> {
    words_of(function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers := buffers),
        Cons(function.result, function.also))
}

theorem Function::eval_words_len(self function: Function, call: Answers(), arguments: List<BitVec(64)>, buffers: Buffers()):
    function.eval_words(call, arguments, buffers := buffers).tail().len() = function.also.len() {
    words_of_len(function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers := buffers), function.also)
}

// A function with no words past its first returns that one alone.
theorem Function::eval_words_single(self function: Function, none: function.also = Nil, call: Answers(), arguments: List<BitVec(64)>,
    buffers: Buffers()): function.eval_words(call, arguments, buffers := buffers) = [function.eval(call, arguments, buffers := buffers)] {
    let after = function.body.eval(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers := buffers);
    j(sym(none), λ a _ => words_of(after, Cons(function.result, a)) = [after(64, function.result)], refl)
}

fn Function::evaluable(self function: Function, arity: Nat → Option<Nat>) → Bool {
    function.body.evaluable(arity) && (distinct(function.parameters) && disjoint(function.body.writes(), function.parameters))
}

fn Function::calls_fit(self function: Function, arity: Nat → Option<Nat>) → Bool { function.body.calls_fit(arity) }

theorem Function::evaluable_calls_fit(self function: Function, arity: Nat → Option<Nat>, ok: function.evaluable(arity).IsTrue()):
    function.calls_fit(arity).IsTrue() {
    function.body.evaluable_calls_fit(arity, Bool::is_true_and(function.body.evaluable(arity),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok).left)
}

// A function whose calls fit, its calls answered alike wherever the
// arities fit, returns alike.
theorem Function::eval_answers_over(self function: Function, buffers: Buffers(), call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>):
    function.eval(other, arguments, buffers := buffers) = function.eval(call, arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    StructuredRegion::eval_answers_over(function.body, buffers, call, other, arity, answers, ok, bound, bound, λ w id => refl, 64, function.result)
}

theorem Function::eval_answers(self function: Function, call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>): function.eval(other, arguments) = function.eval(call, arguments) {
    function.eval_answers_over(Nil, call, other, arity, answers, ok, arguments)
}

// A table with function `k`'s row `own`, the others' rows `below`'s.
fn tie<A>(below: Nat → A, k: Nat, own: A) → Nat → A { λ (f: Nat) => match f.eq_dec(k) { Inl(_) => own, Inr(_) => below(f) } }

fn tie_answers(below: Answers(), k: Nat, own: List<BitVec(64)> → List<BitVec(64)>) → Answers() {
    λ f arguments => match f.eq_dec(k) { Inl(_) => own(arguments), Inr(_) => below(f, arguments) }
}

// The words a function that calls itself (function `k`, over `below`)
// returns `depth` levels deep: its body's with its own calls answered one
// level down, and at no level one zero word (`Function::level_computes`).
fn Function::level_words(self function: Function, below: Answers(), k, depth: Nat, buffers: Buffers()) → List<BitVec(64)> → List<BitVec(64)> {
    match depth {
        Zero => λ _ => [BitVec::zero()],
        Succ(i) => λ arguments => function.eval_words(tie_answers(below, k, function.level_words(below, k, i, buffers)), arguments, buffers := buffers),
    }
}

// The answers `below` with function `k` answering its own number `depth`
// levels deep (`Function::tied_callees`).
fn Function::tied_answers(self function: Function, below: Answers(), k, depth: Nat, buffers: Buffers()) → Answers() {
    tie_answers(below, k, function.level_words(below, k, depth, buffers))
}

// What answers the function's calls where it is function `k` over `below`,
// at `levels` levels (`Function::callees_at`).
fn Function::answers_at(self function: Function, below: Answers(), k, levels: Nat, buffers: Buffers()) → Answers() {
    match levels { Zero => below, Succ(depth) => function.tied_answers(below, k, depth, buffers) }
}

fn tie_defines(below: Defines(), k: Nat, own: List<BitVec(64)> → Bool) → Defines() {
    λ f arguments => match f.eq_dec(k) { Inl(_) => own(arguments), Inr(_) => below(f, arguments) }
}

// Whether the function is defined `depth` levels deep: where its body is
// with its own calls asked one level down, and at no level nowhere.
fn Function::level_defined(self function: Function, call: Answers(), below: Defines(), k, depth: Nat, buffers: Buffers()) → List<BitVec(64)> → Bool {
    match depth {
        Zero => λ _ => False,
        Succ(i) => λ arguments => function.defined(function.tied_answers(call, k, i, buffers),
            tie_defines(below, k, function.level_defined(call, below, k, i, buffers)), arguments, buffers := buffers),
    }
}

fn Function::tied_defines(self function: Function, call: Answers(), below: Defines(), k, depth: Nat, buffers: Buffers()) → Defines() {
    tie_defines(below, k, function.level_defined(call, below, k, depth, buffers))
}

fn Function::defines_at(self function: Function, call: Answers(), below: Defines(), k, levels: Nat, buffers: Buffers()) → Defines() {
    match levels { Zero => below, Succ(depth) => function.tied_defines(call, below, k, depth, buffers) }
}

// A table of the functions below a function, with the function's own entry
// at `k` where it has levels: what its body's calls are checked against.
fn self_table<A>(below: Nat → A, k, levels: Nat, own: A) → Nat → A {
    match levels { Zero => below, Succ(_) => tie(below, k, own) }
}

// A program's functions, each answering its calls by the functions after
// it, as `program_callees` orders them, all over the same buffers: the
// words each returns (`Function::eval_words`; one zero word at a number no
// function has).
fn program_answers_over(buffers: Buffers(), functions: List<Function>) → Answers() {
    match functions {
        Nil => λ _ _ => [BitVec::zero()],
        Cons(last, earlier) => λ f arguments => match f.eq_dec(earlier.len()) {
            Inl(_) => last.eval_words(last.answers_at(program_answers_over(buffers, earlier), earlier.len(), last.levels, buffers), arguments, buffers := buffers),
            Inr(_) => program_answers_over(buffers, earlier)(f, arguments),
        },
    }
}

fn program_answers(functions: List<Function>) → Answers() { program_answers_over(Nil, functions) }

// The first word each returns, in RAX: what a function returning one word
// is stated by.
fn program_eval_over(buffers: Buffers(), functions: List<Function>) → Nat → List<BitVec(64)> → BitVec(64) {
    λ f arguments => first_word(program_answers_over(buffers, functions)(f, arguments))
}

// Over no buffers, as a program that reads none is stated.
fn program_eval(functions: List<Function>) → Nat → List<BitVec(64)> → BitVec(64) { program_eval_over(Nil, functions) }

// How many words each function returns past its first (none at a number
// no function has): what a call of it names (`Call`'s `also`).
fn program_outs(functions: List<Function>) → Nat → Nat {
    match functions {
        Nil => λ _ => 0,
        Cons(last, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => last.also.len(),
            Inr(_) => program_outs(earlier, f),
        },
    }
}

theorem program_answers_len(buffers: Buffers(), functions: List<Function>): (f: Nat) → (words: List<BitVec(64)>) →
    program_answers_over(buffers, functions)(f, words).tail().len() = program_outs(functions)(f) {
    match functions {
        Nil => λ f words => refl,
        Cons(last, earlier) => λ f words => match f.eq_dec(earlier.len()) as λ d =>
            (match d as λ _ => List<BitVec(64)> {
                Inl(_) => last.eval_words(last.answers_at(program_answers_over(buffers, earlier), earlier.len(), last.levels, buffers), words, buffers := buffers),
                Inr(_) => program_answers_over(buffers, earlier)(f, words),
            }).tail().len() = (match d as λ _ => Nat { Inl(_) => last.also.len(), Inr(_) => program_outs(earlier, f) }) {
            Inl(_) => last.eval_words_len(last.answers_at(program_answers_over(buffers, earlier), earlier.len(), last.levels, buffers), words, buffers),
            Inr(_) => program_answers_len(buffers, earlier, f, words),
        },
    }
}

// Whether each function of the program is defined at the words, its calls
// asking the functions after it (as `program_eval_over` answers them).
fn program_defined_over(buffers: Buffers(), functions: List<Function>) → Defines() {
    match functions {
        Nil => λ _ _ => True,
        Cons(last, earlier) => λ f arguments => match f.eq_dec(earlier.len()) {
            Inl(_) => last.defined(last.answers_at(program_answers_over(buffers, earlier), earlier.len(), last.levels, buffers),
                last.defines_at(program_answers_over(buffers, earlier), program_defined_over(buffers, earlier), earlier.len(), last.levels, buffers),
                arguments, buffers := buffers),
            Inr(_) => program_defined_over(buffers, earlier)(f, arguments),
        },
    }
}

fn program_defined(functions: List<Function>) → Defines() { program_defined_over(Nil, functions) }

// What answers the last function's calls in a program, and whether each is
// defined: the functions before it, and itself as deep as it has levels.
fn program_last_answers(buffers: Buffers(), last: Function, earlier: List<Function>) → Answers() {
    last.answers_at(program_answers_over(buffers, earlier), earlier.len(), last.levels, buffers)
}

fn program_last_defines(buffers: Buffers(), last: Function, earlier: List<Function>) → Defines() {
    last.defines_at(program_answers_over(buffers, earlier), program_defined_over(buffers, earlier), earlier.len(), last.levels, buffers)
}

// At the last function's own number, the program is defined where that
// function is.
theorem program_defined_last(buffers: Buffers(), last: Function, earlier: List<Function>, words: List<BitVec(64)>):
    program_defined_over(buffers, Cons(last, earlier))(earlier.len(), words).IsTrue() →
    last.defined(program_last_answers(buffers, last, earlier), program_last_defines(buffers, last, earlier), words, buffers := buffers).IsTrue() {
    match earlier.len().eq_dec(earlier.len()) as λ d => (match d as λ _ => Bool {
            Inl(_) => last.defined(program_last_answers(buffers, last, earlier), program_last_defines(buffers, last, earlier), words, buffers := buffers),
            Inr(_) => program_defined_over(buffers, earlier)(earlier.len(), words),
        }).IsTrue() → last.defined(program_last_answers(buffers, last, earlier), program_last_defines(buffers, last, earlier), words, buffers := buffers).IsTrue() {
        Inl(_) => λ h => h,
        Inr(ne) => λ _ => false_elim(ne(refl)),
    }
}

// Whether no function has levels: no function calls itself.
fn program_flat(functions: List<Function>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.levels.matches(0) && program_flat(earlier) }
}

// A function with no levels is answered by the functions below it alone.
theorem Function::flat_answers(self function: Function, flat: function.levels = 0, P: Answers() → Type, below: Answers(), k: Nat, buffers: Buffers(),
    holds: P(below)): P(function.answers_at(below, k, function.levels, buffers)) {
    j(sym(flat), λ l _ => P(function.answers_at(below, k, l, buffers)), holds)
}

// No node of the program requires anything, and no function has levels (a
// function that calls itself is defined only as deep as it has them).
fn program_total(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => (last.levels.matches(0) && last.body.total_at(program_outs(earlier))) && program_total(earlier),
    }
}

// A program none of whose nodes requires anything is defined everywhere.
theorem program_total_defined(functions: List<Function>, buffers: Buffers()): program_total(functions).IsTrue() →
    (f: Nat) → (words: List<BitVec(64)>) → program_defined_over(buffers, functions, f, words).IsTrue() {
    match functions {
        Nil => λ _ _ _ => trivial,
        Cons(last, earlier) => λ total f words => {
            let parts = Bool::is_true_and(last.levels.matches(0) && last.body.total_at(program_outs(earlier)), program_total(earlier), total);
            let own = Bool::is_true_and(last.levels.matches(0), last.body.total_at(program_outs(earlier)), parts.left);
            let flat: (0 = last.levels) = sym(last.levels.matches_eq(0, own.left));
            let ih = program_total_defined(earlier, buffers, parts.right);
            let below = program_answers_over(buffers, earlier);
            let defines = program_defined_over(buffers, earlier);
            match f.eq_dec(earlier.len()) as λ d => (match d as λ _ => Bool {
                Inl(_) => last.defined(program_last_answers(buffers, last, earlier), program_last_defines(buffers, last, earlier), words, buffers := buffers),
                Inr(_) => program_defined_over(buffers, earlier)(f, words),
            }).IsTrue() {
                Inl(_) => j(flat, λ l _ => last.defined(last.answers_at(below, earlier.len(), l, buffers),
                        last.defines_at(below, defines, earlier.len(), l, buffers), words, buffers := buffers).IsTrue(),
                    last.body.total_defined(buffers, below, defines, ih,
                        program_outs(earlier), program_answers_len(buffers, earlier), own.right, Valuation::bind(Valuation::zero(), last.parameters, words))),
                Inr(_) => ih(f, words),
            }
        },
    }
}

// How many words each function returns past its first, read off a table
// `outs` (the last function's first) as `linked_arity` reads arities. A
// call's count is then the table's, not its callee's: a function that
// calls every other one (the lexer's dispatch) evaluates none of them to
// be checked, the table's entry for each function checked once, at that
// function (`Function::total_with`).
fn linked_outs(functions: List<Function>, outs: List<Nat>) → Nat → Nat {
    match functions {
        Nil => λ _ => 0,
        Cons(_, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => outs.head_or(0),
            Inr(_) => linked_outs(earlier, outs.tail(), f),
        },
    }
}

// The function's entry of the table is its own count, and its body is
// total with its callees' counts read off the rest of the table.
fn Function::total_with(self last: Function, earlier: List<Function>, outs: List<Nat>) → Bool {
    outs.head_or(0).matches(last.also.len()) && (last.levels.matches(0) && last.body.total_at(linked_outs(earlier, outs.tail())))
}

fn program_total_at(functions: List<Function>, outs: List<Nat>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.total_with(earlier, outs) && program_total_at(earlier, outs.tail()) }
}

fn program_total_at_head(functions: List<Function>, outs: List<Nat>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.total_with(earlier, outs) }
}

// A region's totality reads its callees' counts only at the numbers it
// calls.
theorem StructuredRegion::total_at_same(self region: StructuredRegion, outs, others: Nat → Nat, same: (f: Nat) → outs(f) = others(f)):
    region.total_at(outs) = region.total_at(others) {
    match region {
        Dataflow(_) => refl,
        Sequence(prefix, continuation) => cong_fn(λ (b: Bool) => nodes_total(prefix.nodes) && b, continuation.total_at_same(outs, others, same)),
        Compose(prefix, continuation) => trans(cong_fn(λ (b: Bool) => b && continuation.total_at(outs), prefix.total_at_same(outs, others, same)),
            cong_fn(λ (b: Bool) => prefix.total_at(others) && b, continuation.total_at_same(outs, others, same))),
        Conditional(_, _, _, _, when_true, when_false) => trans(cong_fn(λ (b: Bool) => b && when_false.total_at(outs), when_true.total_at_same(outs, others, same)),
            cong_fn(λ (b: Bool) => when_true.total_at(others) && b, when_false.total_at_same(outs, others, same))),
        Lend(_, _, _, _) => refl,
        Call(callee, _, _, also) => cong_fn(λ (n: Nat) => n.matches(also.len()), same(callee)),
        Loop(_, _, _, _, body, _, _, _, _) => body.total_at_same(outs, others, same),
        Until(_, _, _, _, _, _) => refl,
    }
}

// Where the table checks, it is the program's counts.
theorem program_total_at_outs(functions: List<Function>): (outs: List<Nat>) → program_total_at(functions, outs).IsTrue() →
    (f: Nat) → linked_outs(functions, outs, f) = program_outs(functions)(f) {
    match functions {
        Nil => λ outs ok f => refl,
        Cons(last, earlier) => λ outs ok f => {
            let parts = Bool::is_true_and(last.total_with(earlier, outs), program_total_at(earlier, outs.tail()), ok);
            let own = Bool::is_true_and(outs.head_or(0).matches(last.also.len()),
                last.levels.matches(0) && last.body.total_at(linked_outs(earlier, outs.tail())), parts.left).left;
            match f.eq_dec(earlier.len()) as λ d =>
                (match d as λ _ => Nat { Inl(_) => outs.head_or(0), Inr(_) => linked_outs(earlier, outs.tail(), f) })
                = (match d as λ _ => Nat { Inl(_) => last.also.len(), Inr(_) => program_outs(earlier, f) }) {
                Inl(_) => outs.head_or(0).matches_eq(last.also.len(), own),
                Inr(_) => program_total_at_outs(earlier, outs.tail(), parts.right, f),
            }
        },
    }
}

theorem program_total_at_total(functions: List<Function>): (outs: List<Nat>) → program_total_at(functions, outs).IsTrue() →
    program_total(functions).IsTrue() {
    match functions {
        Nil => λ _ _ => trivial,
        Cons(last, earlier) => λ outs ok => {
            let parts = Bool::is_true_and(last.total_with(earlier, outs), program_total_at(earlier, outs.tail()), ok);
            let own = Bool::is_true_and(last.levels.matches(0), last.body.total_at(linked_outs(earlier, outs.tail())),
                Bool::is_true_and(outs.head_or(0).matches(last.also.len()),
                    last.levels.matches(0) && last.body.total_at(linked_outs(earlier, outs.tail())), parts.left).right);
            Bool::is_true_and_intro(last.levels.matches(0) && last.body.total_at(program_outs(earlier)), program_total(earlier),
                Bool::is_true_and_intro(last.levels.matches(0), last.body.total_at(program_outs(earlier)), own.left,
                    j(last.body.total_at_same(linked_outs(earlier, outs.tail()), program_outs(earlier), program_total_at_outs(earlier, outs.tail(), parts.right)),
                        λ b _ => Bool::IsTrue(b), own.right)),
                program_total_at_total(earlier, outs.tail(), parts.right))
        },
    }
}

theorem program_total_at_drop_zero(functions: List<Function>, outs: List<Nat>):
    program_total_at(functions.drop(0), outs.drop(0)).IsTrue() → program_total_at(functions, outs).IsTrue() {
    match functions {
        Nil => λ h => trivial,
        Cons(_, _) => match outs { Nil => λ h => h, Cons(_, _) => λ h => h },
    }
}

// `program_total_at` a function at a time, as `program_scan_at_drop`.
theorem program_total_at_drop(functions: List<Function>): (outs: List<Nat>) → (n: Nat) →
    program_total_at_head(functions.drop(n), outs.drop(n)).IsTrue() →
    program_total_at(functions.drop(n + 1), outs.drop(n + 1)).IsTrue() → program_total_at(functions.drop(n), outs.drop(n)).IsTrue() {
    match functions {
        Nil => λ _ _ _ _ => trivial,
        Cons(last, earlier) => λ outs n => match n as λ i =>
            program_total_at_head(Cons(last, earlier).drop(i), outs.drop(i)).IsTrue() →
            program_total_at(Cons(last, earlier).drop(i + 1), outs.drop(i + 1)).IsTrue() →
            program_total_at(Cons(last, earlier).drop(i), outs.drop(i)).IsTrue() {
            Zero => match outs as λ ns => program_total_at_head(Cons(last, earlier), ns.drop(0)).IsTrue() →
                program_total_at(earlier.drop(0), ns.drop(1)).IsTrue() → program_total_at(Cons(last, earlier), ns.drop(0)).IsTrue() {
                Nil => λ head rest => Bool::is_true_and_intro(last.total_with(earlier, Nil), program_total_at(earlier, Nil), head,
                    program_total_at_drop_zero(earlier, Nil, rest)),
                Cons(o, more) => λ head rest => Bool::is_true_and_intro(last.total_with(earlier, Cons(o, more)), program_total_at(earlier, more), head,
                    program_total_at_drop_zero(earlier, more, rest)),
            },
            Succ(k) => match outs as λ ns => program_total_at_head(earlier.drop(k), ns.drop(k + 1)).IsTrue() →
                program_total_at(earlier.drop(k + 1), ns.drop(k + 2)).IsTrue() → program_total_at(earlier.drop(k), ns.drop(k + 1)).IsTrue() {
                Nil => λ head rest => program_total_at_drop(earlier, Nil, k, head, rest),
                Cons(_, more) => λ head rest => program_total_at_drop(earlier, more, k, head, rest),
            },
        },
    }
}

fn program_arity(functions: List<Function>) → Nat → Option<Nat> {
    match functions {
        Nil => λ _ => None,
        Cons(last, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => Some(last.parameters.len()),
            Inr(_) => program_arity(earlier, f),
        },
    }
}

// How many words each function the last function may call takes: the
// functions before it, and itself where it has levels.
fn program_last_arity(last: Function, earlier: List<Function>) → Nat → Option<Nat> {
    self_table(program_arity(earlier), earlier.len(), last.levels, Some(last.parameters.len()))
}

fn program_evaluable(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.evaluable(program_last_arity(last, earlier)) && program_evaluable(earlier),
    }
}

// ---------------------------------------------------------------------------
// Linking: a function written against a numbering of its own callees, put
// into a program that numbers them differently, has its calls renamed. It
// evaluates as before, each call answered at its new name
// (docs/native/runtime-fn-setups-design.md §16.9).

fn StructuredRegion::relabel(self region: StructuredRegion, links: Nat → Nat) → StructuredRegion {
    match region {
        Dataflow(body) => Dataflow(body),
        Sequence(prefix, continuation) => Sequence(prefix, continuation.relabel(links)),
        Compose(prefix, continuation) => Compose(prefix.relabel(links), continuation.relabel(links)),
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) =>
            Conditional(inputs, condition, arguments, outputs, when_true.relabel(links), when_false.relabel(links)),
        Lend(views, callee, arguments, result) => Lend(views, links(callee), arguments, result),
        Call(callee, arguments, result, also) => Call(links(callee), arguments, result, also),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) =>
            Loop(inputs, bound, parameters, count, body.relabel(links), exit, next, outputs, exhausted),
        Until(inputs, parameters, body, exit, next, outputs) => Until(inputs, parameters, body.relabel(links), exit, next, outputs),
    }
}

fn Function::relabel(self function: Function, links: Nat → Nat) → Function {
    Function(function.parameters, function.body.relabel(links), function.result, lent := function.lent, also := function.also)
}

// Calls answered at their renamed functions.
fn Answers::relabel(call: Answers(), links: Nat → Nat) → Answers() { λ f words => call(links(f), words) }

theorem StructuredRegion::relabel_eval_over(self region: StructuredRegion, buffers: Buffers(), call: Answers(), links: Nat → Nat):
    (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval_over(buffers, Answers::relabel(call, links), values), region.relabel(links).eval_over(buffers, call, others)) {
    match region {
        Dataflow(body) => λ values others same => eval_nodes_same_over(buffers, body.nodes, values, others, same),
        Sequence(prefix, continuation) => λ values others same =>
            continuation.relabel_eval_over(buffers, call, links, prefix.eval(values, buffers := buffers), prefix.eval(others, buffers := buffers), eval_nodes_same_over(buffers, prefix.nodes, values, others, same)),
        Compose(prefix, continuation) => λ values others same =>
            continuation.relabel_eval_over(buffers, call, links, prefix.eval_over(buffers, Answers::relabel(call, links), values), prefix.relabel(links).eval_over(buffers, call, others),
                prefix.relabel_eval_over(buffers, call, links, values, others, same)),
        Conditional(_, condition, _, _, when_true, when_false) => λ values others same => λ w id => {
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = match values(1, condition).head_bit() as λ b =>
                (match b { False => when_false.relabel(links).eval_over(buffers, call, others)(w, id), True => when_true.relabel(links).eval_over(buffers, call, others)(w, id) }) =
                (match b {
                    False => when_false.eval_over(buffers, Answers::relabel(call, links), values)(w, id),
                    True => when_true.eval_over(buffers, Answers::relabel(call, links), values)(w, id),
                }) {
                False => when_false.relabel_eval_over(buffers, call, links, values, others, same, w, id),
                True => when_true.relabel_eval_over(buffers, call, links, values, others, same, w, id),
            };
            j(bit, λ b _ => (match b { False => when_false.relabel(links).eval_over(buffers, call, others)(w, id), True => when_true.relabel(links).eval_over(buffers, call, others)(w, id) }) =
                (match values(1, condition).head_bit() {
                    False => when_false.eval_over(buffers, Answers::relabel(call, links), values)(w, id),
                    True => when_true.eval_over(buffers, Answers::relabel(call, links), values)(w, id),
                }), aligned)
        },
        Lend(views, callee, arguments, result) => λ values others same => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let second = eval_nodes_over(buffers, nodes, others);
            let alike = eval_nodes_same_over(buffers, nodes, values, others, same);
            let read: (words_of(second, args) = words_of(first, args)) = words_agree(args, first, second, λ id _ => alike(64, id));
            Valuation::set_same(first, second, alike, result, word_value(first_word(call(links(callee), words_of(first, args)))),
                word_value(first_word(call(links(callee), words_of(second, args)))),
                λ w => cong_fn(λ (ws: List<BitVec(64)>) => word_value(first_word(call(links(callee), ws)), w), read))
        },
        Call(callee, arguments, result, also) => λ values others same => {
            let read: (words_of(others, arguments) = words_of(values, arguments)) = words_agree(arguments, values, others, λ id _ => same(64, id));
            j(sym(read), λ ws _ => Valuation::Same(Valuation::bind(values, Cons(result, also), Answers::split(call(links(callee), words_of(values, arguments)))),
                    Valuation::bind(others, Cons(result, also), Answers::split(call(links(callee), ws)))),
                Valuation::bind_same(values, others, same, Cons(result, also), Answers::split(call(links(callee), words_of(values, arguments)))))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values others same => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, Answers::relabel(call, links), pass);
            let other_step = λ (pass: Valuation()) => body.relabel(links).eval_over(buffers, call, pass);
            let end = loop_eval(step, parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs));
            let ran: (loop_eval(other_step, parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)) = end) =
                trans(loop_eval_same(step, other_step, λ v => body.relabel_eval_over(buffers, call, links, v, v, λ w id => refl),
                        parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)),
                    eq2(λ (n: Nat) (s: List<BitVec(64)>) => loop_eval(step, parameters, count, exit, next, n, s),
                        cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound)), words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(others, outputs, e.state), exhausted, bit_value(e.exhausted))),
                Valuation::set_same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, end.state),
                    Valuation::bind_same(values, others, same, outputs, end.state), exhausted, bit_value(end.exhausted), bit_value(end.exhausted),
                    λ w => refl))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ values others same => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, Answers::relabel(call, links), pass);
            let other_step = λ (pass: Valuation()) => body.relabel(links).eval_over(buffers, call, pass);
            let end = until_eval(step, parameters, exit, next, until_passes(), words_of(values, inputs));
            let ran: (until_eval(other_step, parameters, exit, next, until_passes(), words_of(others, inputs)) = end) =
                trans(until_eval_same(step, other_step, λ v => body.relabel_eval_over(buffers, call, links, v, v, λ w id => refl),
                        parameters, exit, next, until_passes(), words_of(others, inputs)),
                    cong_fn(λ (st: List<BitVec(64)>) => until_eval(step, parameters, exit, next, until_passes(), st),
                        words_agree(inputs, values, others, λ id _ => same(64, id))));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, e.state)),
                Valuation::bind_same(values, others, same, outputs, end.state))
        },
    }
}

theorem StructuredRegion::relabel_eval(self region: StructuredRegion, call: Answers(), links: Nat → Nat):
    (values, others: Valuation()) → Valuation::Same(values, others) →
    Valuation::Same(region.eval(Answers::relabel(call, links), values), region.relabel(links).eval(call, others)) {
    region.relabel_eval_over(Nil, call, links)
}

theorem Function::relabel_eval_over(self function: Function, buffers: Buffers(), call: Answers(), links: Nat → Nat, arguments: List<BitVec(64)>):
    function.relabel(links).eval(call, arguments, buffers := buffers) = function.eval(Answers::relabel(call, links), arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    function.body.relabel_eval_over(buffers, call, links, bound, bound, λ w id => refl, 64, function.result)
}

theorem Function::relabel_eval(self function: Function, call: Answers(), links: Nat → Nat, arguments: List<BitVec(64)>):
    function.relabel(links).eval(call, arguments) = function.eval(Answers::relabel(call, links), arguments) {
    function.relabel_eval_over(Nil, call, links, arguments)
}

// The same of the words a function returns past its first
// (`Function::eval_also`): they are read off the same valuation.
theorem words_of_same(values, other: Valuation(), same: Valuation::Same(values, other), ids: List<Nat>): words_of(other, ids) = words_of(values, ids) {
    match ids {
        Nil => refl,
        Cons(id, rest) => {
            let tail: (words_of(other, rest) = words_of(values, rest)) = words_of_same(values, other, same, rest);
            trans(cong_fn(λ (x: BitVec(64)) => Cons(x, words_of(other, rest)), same(64, id)),
                cong_fn(λ (r: List<BitVec(64)>) => Cons(values(64, id), r), tail))
        },
    }
}

theorem Function::relabel_eval_also_over(self function: Function, buffers: Buffers(), call: Answers(), links: Nat → Nat, arguments: List<BitVec(64)>):
    function.relabel(links).eval_also(call, arguments, buffers := buffers) = function.eval_also(Answers::relabel(call, links), arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    words_of_same(function.body.eval(Answers::relabel(call, links), bound, buffers := buffers), function.relabel(links).body.eval(call, bound, buffers := buffers),
        function.body.relabel_eval_over(buffers, call, links, bound, bound, λ w id => refl), function.also)
}

theorem Function::eval_also_answers_over(self function: Function, buffers: Buffers(), call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>):
    function.eval_also(other, arguments, buffers := buffers) = function.eval_also(call, arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    words_of_same(function.body.eval(call, bound, buffers := buffers), function.body.eval(other, bound, buffers := buffers),
        StructuredRegion::eval_answers_over(function.body, buffers, call, other, arity, answers, ok, bound, bound, λ w id => refl), function.also)
}

theorem Function::eval_words_answers_over(self function: Function, buffers: Buffers(), call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>):
    function.eval_words(other, arguments, buffers := buffers) = function.eval_words(call, arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    words_of_same(function.body.eval(call, bound, buffers := buffers), function.body.eval(other, bound, buffers := buffers),
        StructuredRegion::eval_answers_over(function.body, buffers, call, other, arity, answers, ok, bound, bound, λ w id => refl),
        Cons(function.result, function.also))
}

theorem Function::eval_words_answers(self function: Function, call, other: Answers(), arity: Nat → Option<Nat>,
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → other(f, words) = call(f, words),
    ok: function.calls_fit(arity).IsTrue(), arguments: List<BitVec(64)>): function.eval_words(other, arguments) = function.eval_words(call, arguments) {
    function.eval_words_answers_over(Nil, call, other, arity, answers, ok, arguments)
}

theorem Function::relabel_eval_words_over(self function: Function, buffers: Buffers(), call: Answers(), links: Nat → Nat, arguments: List<BitVec(64)>):
    function.relabel(links).eval_words(call, arguments, buffers := buffers) = function.eval_words(Answers::relabel(call, links), arguments, buffers := buffers) {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    words_of_same(function.body.eval(Answers::relabel(call, links), bound, buffers := buffers), function.relabel(links).body.eval(call, bound, buffers := buffers),
        function.body.relabel_eval_over(buffers, call, links, bound, bound, λ w id => refl), Cons(function.result, function.also))
}

// A program's last function's words past its first, its calls answered by
// the functions before it (over no buffers): what a program whose last
// function returns two words returns in RDX (`compiled_returns_both`,
// function_ir_compile).
fn program_eval_also(functions: List<Function>, arguments: List<BitVec(64)>) → List<BitVec(64)> {
    match functions { Nil => Nil, Cons(last, earlier) => last.eval_also(program_last_answers(Nil, last, earlier), arguments) }
}

// The same over a file: what the export of a structure of several words
// calls its function over (docs/native/runtime-fn-setups-design.md §16.20).
fn program_eval_also_over(buffers: Buffers(), functions: List<Function>, arguments: List<BitVec(64)>) → List<BitVec(64)> {
    match functions { Nil => Nil, Cons(last, earlier) => last.eval_also(program_last_answers(buffers, last, earlier), arguments, buffers := buffers) }
}

// Renamed calls fit wherever the renaming carries every arity over: what a
// linked function's calls are checked by, from the check its own code had
// against its own table, with nothing read off the code again
// (issues/runtime-generator-program-size.md).
theorem StructuredRegion::relabel_calls_fit(self region: StructuredRegion, links: Nat → Nat, arity, other: Nat → Option<Nat>,
    carried: (k: Nat) → (n: Nat) → arity_fits(arity(k), n).IsTrue() → arity_fits(other(links(k)), n).IsTrue()):
    region.calls_fit(arity).IsTrue() → region.relabel(links).calls_fit(other).IsTrue() {
    match region {
        Dataflow(_) => λ _ => trivial,
        Sequence(_, continuation) => λ ok => continuation.relabel_calls_fit(links, arity, other, carried, ok),
        Compose(prefix, continuation) => λ ok => {
            let parts = Bool::is_true_and(prefix.calls_fit(arity), continuation.calls_fit(arity), ok);
            Bool::is_true_and_intro(prefix.relabel(links).calls_fit(other), continuation.relabel(links).calls_fit(other),
                prefix.relabel_calls_fit(links, arity, other, carried, parts.left),
                continuation.relabel_calls_fit(links, arity, other, carried, parts.right))
        },
        Conditional(_, _, _, _, when_true, when_false) => λ ok => {
            let arms = Bool::is_true_and(when_true.calls_fit(arity), when_false.calls_fit(arity), ok);
            Bool::is_true_and_intro(when_true.relabel(links).calls_fit(other), when_false.relabel(links).calls_fit(other),
                when_true.relabel_calls_fit(links, arity, other, carried, arms.left),
                when_false.relabel_calls_fit(links, arity, other, carried, arms.right))
        },
        Lend(views, callee, arguments, _) => λ ok => carried(callee, (views_homes(views) ++ arguments).len(), ok),
        Call(callee, arguments, _, _) => λ ok => carried(callee, arguments.len(), ok),
        Loop(_, _, _, _, body, _, _, _, _) => λ ok => body.relabel_calls_fit(links, arity, other, carried, ok),
        Until(_, _, body, _, _, _) => λ ok => body.relabel_calls_fit(links, arity, other, carried, ok),
    }
}

theorem Function::relabel_calls_fit(self function: Function, links: Nat → Nat, arity, other: Nat → Option<Nat>,
    carried: (k: Nat) → (n: Nat) → arity_fits(arity(k), n).IsTrue() → arity_fits(other(links(k)), n).IsTrue(),
    ok: function.calls_fit(arity).IsTrue()): function.relabel(links).calls_fit(other).IsTrue() {
    function.body.relabel_calls_fit(links, arity, other, carried, ok)
}

// ---------------------------------------------------------------------------
// A function at a time. The compiler proves each function of a program
// against a `sources` that answers every call with the callee's source
// function, so no function's proof unfolds another's: a callee that decides
// a connective, or runs a loop, is one call in its caller's conversion. The
// program's own answers, each function's evaluation, are then those sources
// by induction along the program (`program_eval_sources`).

// Every function of the program, its calls answered by `sources`, returns
// `sources` at its own index.
fn program_sourced(functions: List<Function>, sources: Answers()) → Type {
    match functions {
        Nil => True,
        Cons(last, earlier) =>
            ((words: List<BitVec(64)>) → words.len() = last.parameters.len() → last.eval_words(sources, words) = sources(earlier.len(), words))
            ∧ program_sourced(earlier, sources),
    }
}

// Every function's calls name earlier functions at their arity: what
// `program_eval_sources` needs, linear in the program (`calls_fit`).
fn program_calls_fit(functions: List<Function>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.calls_fit(program_last_arity(last, earlier)) && program_calls_fit(earlier),
    }
}

theorem program_evaluable_calls_fit(functions: List<Function>): program_evaluable(functions).IsTrue() → program_calls_fit(functions).IsTrue() {
    match functions {
        Nil => λ _ => trivial,
        Cons(last, earlier) => λ ok => {
            let parts = Bool::is_true_and(last.evaluable(program_last_arity(last, earlier)), program_evaluable(earlier), ok);
            Bool::is_true_and_intro(last.calls_fit(program_last_arity(last, earlier)), program_calls_fit(earlier),
                last.evaluable_calls_fit(program_last_arity(last, earlier), parts.left), program_evaluable_calls_fit(earlier, parts.right))
        },
    }
}

// `program_eval_sources` from `program_calls_fit` alone, for a program no
// function of which has levels (`program_flat`): one that calls itself
// answers with its source only as deep as its levels reach
// (`program_ranked_sources`).
theorem program_fit_sources(functions: List<Function>, ok: program_calls_fit(functions).IsTrue(), flat: program_flat(functions).IsTrue(), sources: Answers(),
    sourced: program_sourced(functions, sources)):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
        program_answers(functions, f, words) = sources(f, words) {
    match functions {
        Nil => λ f words never => false_elim(never),
        Cons(last, earlier) => λ f words => {
            let parts = Bool::is_true_and(last.calls_fit(program_last_arity(last, earlier)), program_calls_fit(earlier), ok);
            let flats = Bool::is_true_and(last.levels.matches(0), program_flat(earlier), flat);
            let none: (last.levels = 0) = last.levels.matches_eq(0, flats.left);
            let fit: last.calls_fit(program_arity(earlier)).IsTrue() =
                j(none, λ l _ => last.calls_fit(self_table(program_arity(earlier), earlier.len(), l, Some(last.parameters.len()))).IsTrue(), parts.left);
            let ih = program_fit_sources(earlier, parts.right, flats.right, sources, sourced.right);
            (match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, f) },
                    words.len()).IsTrue() →
                (match d as λ _ => List<BitVec(64)> {
                    Inl(_) => last.eval_words(program_last_answers(Nil, last, earlier), words),
                    Inr(_) => program_answers(earlier, f, words),
                }) = sources(f, words) {
                Inl(e) => λ fits => j(sym(none), λ l _ => last.eval_words(last.answers_at(program_answers(earlier), earlier.len(), l, Nil), words) = sources(f, words),
                    trans(last.eval_words_answers(sources, program_answers(earlier), program_arity(earlier), ih, fit, words),
                        j(sym(e), λ g _ => last.eval_words(sources, words) = sources(g, words),
                            sourced.left(words, sym(last.parameters.len().matches_eq(words.len(), fits)))))),
                Inr(_) => λ fits => ih(f, words, fits),
            })
        },
    }
}

// The same for a program put together from functions checked one by one:
// `arities` says how many words each function takes (the last function's
// first, as `functions`), and each function's calls fit *that* table and
// its agreement is at *that* count. Nothing here reads a parameter list, so
// checking a link never forces a function's code: `program_arity` would,
// at every callee (issues/runtime-generator-program-size.md).
fn linked_arity(functions: List<Function>, arities: List<Nat>) → Nat → Option<Nat> {
    match functions {
        Nil => λ _ => None,
        Cons(_, earlier) => λ f => match f.eq_dec(earlier.len()) {
            Inl(_) => arities.nth(0),
            Inr(_) => linked_arity(earlier, arities.tail(), f),
        },
    }
}

// Calls `call` answers with `sources`' answers on every word list of a fitting
// arity that `admits` admits: a function's contract, which passes only the
// words its parameters admit (an enum's tags, every word of a word).
fn Answers::Agree(call, sources: Answers(), arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type) → Type {
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → admits(f, words) → call(f, words) = sources(f, words)
}

// The same over a file, at every file at once: the functions' sources are
// what they compute at each file (a function lent spans reads the file's),
// and the program, evaluated over a file, is its sources there
// (docs/native/native-one-compiler-design.md §2.3). Each function is stated
// on the words it admits, its calls answered by any calls that answer its
// callees' sources on the words they admit: so a function is never asked
// what it does with a word no caller passes. That a function's calls fit
// is no file's matter and is stated once.
// The table a linked program's last function's calls fit: the functions
// before it, and itself where it has levels (`program_last_arity`).
fn linked_last_arity(last: Function, earlier: List<Function>, arities: List<Nat>) → Nat → Option<Nat> {
    self_table(linked_arity(earlier, arities.tail()), earlier.len(), last.levels, arities.nth(0))
}

fn program_linked_files(functions: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type, sources: Buffers() → Answers()) → Type {
    match functions {
        Nil => True,
        Cons(last, earlier) =>
            (last.calls_fit(linked_last_arity(last, earlier, arities)).IsTrue()
                ∧ ((buffers: Buffers()) → (call: Answers()) → Answers::Agree(call, sources(buffers), linked_last_arity(last, earlier, arities), admits) →
                    (words: List<BitVec(64)>) → arity_fits(arities.nth(0), words.len()).IsTrue() → admits(earlier.len(), words) →
                    last.eval_words(call, words, buffers := buffers) = sources(buffers)(earlier.len(), words)))
            ∧ program_linked_files(earlier, arities.tail(), admits, sources),
    }
}

// A linked program no function of which has levels answers with its
// sources on the words they admit.
theorem program_linked_files_sources(functions: List<Function>): (arities: List<Nat>) → (admits: Nat → List<BitVec(64)> → Type) →
    (sources: Buffers() → Answers()) → program_linked_files(functions, arities, admits, sources) → program_flat(functions).IsTrue() → (buffers: Buffers()) →
    Answers::Agree(program_answers_over(buffers, functions), sources(buffers), linked_arity(functions, arities), admits) {
    match functions {
        Nil => λ arities admits sources linked flat buffers f words never => false_elim(never),
        Cons(last, earlier) => λ arities admits sources linked flat buffers f words => {
            let flats = Bool::is_true_and(last.levels.matches(0), program_flat(earlier), flat);
            let none: (last.levels = 0) = last.levels.matches_eq(0, flats.left);
            let ih = program_linked_files_sources(earlier, arities.tail(), admits, sources, linked.right, flats.right, buffers);
            let below = program_answers_over(buffers, earlier);
            let own = j(none, λ l _ => (call: Answers()) →
                    Answers::Agree(call, sources(buffers), self_table(linked_arity(earlier, arities.tail()), earlier.len(), l, arities.nth(0)), admits) →
                    (ws: List<BitVec(64)>) → arity_fits(arities.nth(0), ws.len()).IsTrue() → admits(earlier.len(), ws) →
                    last.eval_words(call, ws, buffers := buffers) = sources(buffers)(earlier.len(), ws),
                linked.left.right(buffers));
            (match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => arities.nth(0), Inr(_) => linked_arity(earlier, arities.tail(), f) },
                    words.len()).IsTrue() → admits(f, words) →
                (match d as λ _ => List<BitVec(64)> {
                    Inl(_) => last.eval_words(program_last_answers(buffers, last, earlier), words, buffers := buffers),
                    Inr(_) => program_answers_over(buffers, earlier, f, words),
                }) = sources(buffers)(f, words) {
                Inl(e) => λ fits => j(sym(e), λ g _ => admits(g, words) →
                        last.eval_words(program_last_answers(buffers, last, earlier), words, buffers := buffers) = sources(buffers)(g, words),
                    λ admitted => j(sym(none), λ l _ => last.eval_words(last.answers_at(below, earlier.len(), l, buffers), words, buffers := buffers)
                            = sources(buffers)(earlier.len(), words),
                        own(below, ih, words, fits, admitted))),
                Inr(_) => λ fits => ih(f, words, fits),
            })
        },
    }
}

// Its first word, the one a caller of one word reads: what a `runtime fn`'s
// `f::agrees` cites.
theorem program_eval_linked_sources(functions: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers(), linked: program_linked_files(functions, arities, admits, sources), flat: program_flat(functions).IsTrue(),
    buffers: Buffers(), f: Nat,
    words: List<BitVec(64)>, fits: arity_fits(linked_arity(functions, arities, f), words.len()).IsTrue(), admitted: admits(f, words)):
    program_eval_over(buffers, functions)(f, words) = first_word(sources(buffers)(f, words)) {
    cong_fn(λ (ws: List<BitVec(64)>) => first_word(ws),
        program_linked_files_sources(functions, arities, admits, sources, linked, flat, buffers, f, words, fits, admitted))
}

// For a program checked whole (`program_evaluable`).
theorem program_eval_sources(functions: List<Function>, ok: program_evaluable(functions).IsTrue(), flat: program_flat(functions).IsTrue(),
    sources: Answers(), sourced: program_sourced(functions, sources)):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
        program_answers(functions, f, words) = sources(f, words) {
    program_fit_sources(functions, program_evaluable_calls_fit(functions, ok), flat, sources, sourced)
}

// An evaluable function, its calls answered by results its callees may
// return, may return what it evaluates to.
theorem Function::eval_computes(self function: Function, callees: Callees(), call: Answers(), arity: Nat → Option<Nat>,
    buffers: Buffers(),
    defines: Defines(),
    answers: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → defines(f, words).IsTrue() →
        callees(f, words, first_word(call(f, words)), call(f, words).tail()),
    ok: function.evaluable(arity).IsTrue(), arguments: List<BitVec(64)>, count: function.parameters.len() = arguments.len(),
    defined: function.defined(call, defines, arguments, buffers := buffers).IsTrue()):
    function.ComputesBoth(callees, arguments, function.eval(call, arguments, buffers := buffers), function.eval_also(call, arguments, buffers := buffers),
        buffers := buffers) {
    let parts = Bool::is_true_and(function.body.evaluable(arity),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok);
    let params = Bool::is_true_and(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), parts.right);
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    let after = function.body.eval(call, bound, buffers := buffers);
    let read: (words_of(after, function.parameters) = arguments) = trans(
        words_agree(function.parameters, bound, after, λ id m =>
            function.body.eval_frame(call, buffers, bound, 64, id, disjoint_mem(function.body.writes(), function.parameters, params.right, id, m))),
        words_of_bind(Valuation::zero(), function.parameters, params.left, arguments, count));
    ⟨after, ⟨read, ⟨function.body.eval_holds_in(callees, call, defines, arity, buffers, answers, parts.left, bound, after,
        λ w id _ => refl, defined), ⟨refl, refl⟩⟩⟩⟩
}

// A function's levels read as its callees: where the tables below answer
// each defined call with a result its callee may return, and the function
// at a depth answers so, so do the tables with the function's own number.
theorem Function::tied_reads_at(self last: Function, may: Callees(), below: Answers(), defines: Defines(), arity: Nat → Option<Nat>, k: Nat,
    buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → defines(f, words).IsTrue() →
        may(f, words, first_word(below(f, words)), below(f, words).tail()),
    depth: Nat,
    own: (words: List<BitVec(64)>) → arity_fits(Some(last.parameters.len()), words.len()).IsTrue() →
        last.level_defined(below, defines, k, depth, buffers)(words).IsTrue() →
        last.level_computes(may, k, depth, buffers)(words, first_word(last.level_words(below, k, depth, buffers)(words)),
            last.level_words(below, k, depth, buffers)(words).tail())):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(tie(arity, k, Some(last.parameters.len()))(f), words.len()).IsTrue() →
    last.tied_defines(below, defines, k, depth, buffers)(f, words).IsTrue() →
    last.tied_callees(may, k, depth, buffers)(f, words, first_word(last.tied_answers(below, k, depth, buffers)(f, words)),
        last.tied_answers(below, k, depth, buffers)(f, words).tail()) {
    λ f words => match f.eq_dec(k) as λ d =>
        arity_fits((match d as λ _ => Option<Nat> { Inl(_) => Some(last.parameters.len()), Inr(_) => arity(f) }), words.len()).IsTrue() →
        (match d as λ _ => Bool { Inl(_) => last.level_defined(below, defines, k, depth, buffers)(words), Inr(_) => defines(f, words) }).IsTrue() →
        (match d as λ _ => Type {
            Inl(_) => last.level_computes(may, k, depth, buffers)(words,
                first_word(match d as λ _ => List<BitVec(64)> { Inl(_) => last.level_words(below, k, depth, buffers)(words), Inr(_) => below(f, words) }),
                (match d as λ _ => List<BitVec(64)> { Inl(_) => last.level_words(below, k, depth, buffers)(words), Inr(_) => below(f, words) }).tail()),
            Inr(_) => may(f, words,
                first_word(match d as λ _ => List<BitVec(64)> { Inl(_) => last.level_words(below, k, depth, buffers)(words), Inr(_) => below(f, words) }),
                (match d as λ _ => List<BitVec(64)> { Inl(_) => last.level_words(below, k, depth, buffers)(words), Inr(_) => below(f, words) }).tail()),
        }) {
        Inl(_) => own(words),
        Inr(_) => ih(f, words),
    }
}

// The function at each depth answers a defined call with a result it may
// return there.
theorem Function::level_reads(self last: Function, may: Callees(), below: Answers(), defines: Defines(), arity: Nat → Option<Nat>, k: Nat,
    buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → defines(f, words).IsTrue() →
        may(f, words, first_word(below(f, words)), below(f, words).tail()),
    ok: last.evaluable(tie(arity, k, Some(last.parameters.len()))).IsTrue(), depth: Nat):
    (words: List<BitVec(64)>) → arity_fits(Some(last.parameters.len()), words.len()).IsTrue() →
    last.level_defined(below, defines, k, depth, buffers)(words).IsTrue() →
    last.level_computes(may, k, depth, buffers)(words, first_word(last.level_words(below, k, depth, buffers)(words)),
        last.level_words(below, k, depth, buffers)(words).tail()) {
    match depth {
        Zero => λ words fits never => false_elim(never),
        Succ(i) => λ words fits defined => last.eval_computes(last.tied_callees(may, k, i, buffers), last.tied_answers(below, k, i, buffers),
            tie(arity, k, Some(last.parameters.len())), buffers, last.tied_defines(below, defines, k, i, buffers),
            last.tied_reads_at(may, below, defines, arity, k, buffers, ih, i, last.level_reads(may, below, defines, arity, k, buffers, ih, ok, i)),
            ok, words, last.parameters.len().matches_eq(words.len(), fits), defined),
    }
}

// The same at its levels, none or some.
theorem Function::levels_reads(self last: Function, may: Callees(), below: Answers(), defines: Defines(), arity: Nat → Option<Nat>, k: Nat,
    buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → defines(f, words).IsTrue() →
        may(f, words, first_word(below(f, words)), below(f, words).tail())):
    (levels: Nat) → last.evaluable(self_table(arity, k, levels, Some(last.parameters.len()))).IsTrue() →
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(self_table(arity, k, levels, Some(last.parameters.len()))(f), words.len()).IsTrue() →
    last.defines_at(below, defines, k, levels, buffers)(f, words).IsTrue() →
    last.callees_at(may, k, levels, buffers)(f, words, first_word(last.answers_at(below, k, levels, buffers)(f, words)),
        last.answers_at(below, k, levels, buffers)(f, words).tail()) {
    λ levels => match levels {
        Zero => λ _ => ih,
        Succ(depth) => λ ok => last.tied_reads_at(may, below, defines, arity, k, buffers, ih, depth,
            last.level_reads(may, below, defines, arity, k, buffers, ih, ok, depth)),
    }
}

// The theorem for programs: what `program_eval_over` returns over `buffers`
// for a call of the right arity is a result the function may return over
// them.
theorem program_eval_reads(functions: List<Function>, buffers: Buffers(), ok: program_evaluable(functions).IsTrue()):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
    program_defined_over(buffers, functions)(f, words).IsTrue() →
    program_callees_over(buffers, functions)(f, words, first_word(program_answers_over(buffers, functions)(f, words)),
        program_answers_over(buffers, functions)(f, words).tail()) {
    match functions {
        Nil => λ f words never _ => false_elim(never),
        Cons(last, earlier) => λ f words => {
            let parts = Bool::is_true_and(last.evaluable(program_last_arity(last, earlier)), program_evaluable(earlier), ok);
            let ih = program_eval_reads(earlier, buffers, parts.right);
            let below = program_answers_over(buffers, earlier);
            let may = program_callees_over(buffers, earlier);
            let defines = program_defined_over(buffers, earlier);
            let tops = program_last_answers(buffers, last, earlier);
            let mays = last.callees_at(may, earlier.len(), last.levels, buffers);
            match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, f) },
                    words.len()).IsTrue() →
                (match d as λ _ => Bool {
                    Inl(_) => last.defined(tops, program_last_defines(buffers, last, earlier), words, buffers := buffers),
                    Inr(_) => defines(f, words),
                }).IsTrue() →
                (match d as λ _ => Type {
                    Inl(_) => last.ComputesBoth(mays, words,
                        first_word(match d { Inl(_) => last.eval_words(tops, words, buffers := buffers), Inr(_) => below(f, words) }),
                        (match d { Inl(_) => last.eval_words(tops, words, buffers := buffers), Inr(_) => below(f, words) }).tail(), buffers := buffers),
                    Inr(_) => may(f, words,
                        first_word(match d { Inl(_) => last.eval_words(tops, words, buffers := buffers), Inr(_) => below(f, words) }),
                        (match d { Inl(_) => last.eval_words(tops, words, buffers := buffers), Inr(_) => below(f, words) }).tail()),
                }) {
                Inl(_) => λ fits defined => last.eval_computes(mays, tops, program_last_arity(last, earlier), buffers,
                    program_last_defines(buffers, last, earlier),
                    last.levels_reads(may, below, defines, program_arity(earlier), earlier.len(), buffers, ih, last.levels, parts.left),
                    parts.left, words, last.parameters.len().matches_eq(words.len(), fits), defined),
                Inr(_) => λ fits defined => ih(f, words, fits, defined),
            }
        },
    }
}

// Over no buffers.
theorem program_eval_computes(functions: List<Function>, ok: program_evaluable(functions).IsTrue()):
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
    program_defined(functions, f, words).IsTrue() →
    program_callees(functions, f, words, program_eval(functions, f, words), program_answers(functions, f, words).tail()) {
    program_eval_reads(functions, Nil, ok)
}

// ---------------------------------------------------------------------------
// Evaluability in one pass (issues/function-ir-evaluable-quadratic.md)
//
// `evaluable` compares each continuation's writes with its prefix's
// mentions, rebuilding both lists at every level: quadratic in the depth of
// a nest of `match`es. `scan` walks a region once, in evaluation order,
// carrying the ids mentioned so far as marks: a write must find its id
// unmarked, and every mention marks its id. A conditional's arms start from
// the same marks, its condition marked (an arm reads it, so may not write
// it), and their marks are joined after; a loop's body and a function's body start from their parameters alone. That
// is `evaluable`'s condition read the other way round (nothing earlier
// mentions an id written later), so `scan` accepts what `evaluable` does,
// in one pass; `program_scan_at_evaluable` proves it implies `evaluable`, and
// the x86 certificate checks `program_scan_at` by evaluation and cites that
// theorem. What a mark costs is the marks' (`Marks`): one comparison under
// a bound, or time linear in the id over the bitmap.

// A set of ids as a bitmap: entry `k` says whether id `k` is in it.
fn bits_has(marks: List<Bool>, id: Nat) → Bool {
    match marks { Nil => False, Cons(here, rest) => match id { Zero => here, Succ(k) => bits_has(rest, k) } }
}

fn bits_add(marks: List<Bool>, id: Nat) → List<Bool> {
    match id {
        Zero => match marks { Nil => [True], Cons(_, rest) => Cons(True, rest) },
        Succ(k) => match marks { Nil => Cons(False, bits_add([], k)), Cons(here, rest) => Cons(here, bits_add(rest, k)) },
    }
}

fn bits_union(a, b: List<Bool>) → List<Bool> {
    match a {
        Nil => b,
        Cons(x, ra) => match b { Nil => Cons(x, ra), Cons(y, rb) => Cons(x || y, bits_union(ra, rb)) },
    }
}

theorem bits_add_has(id: Nat): (marks: List<Bool>) → bits_has(bits_add(marks, id), id).IsTrue() {
    match id {
        Zero => λ marks => match marks { Nil => trivial, Cons(_, _) => trivial },
        Succ(k) => λ marks => match marks { Nil => bits_add_has(k, []), Cons(_, rest) => bits_add_has(k, rest) },
    }
}

theorem bits_add_keeps(id: Nat): (marks: List<Bool>) → (other: Nat) → bits_has(marks, other).IsTrue() →
    bits_has(bits_add(marks, id), other).IsTrue() {
    match id {
        Zero => λ marks other => match marks {
            Nil => λ never => false_elim(never),
            Cons(_, _) => match other { Zero => λ _ => trivial, Succ(_) => λ h => h },
        },
        Succ(k) => λ marks other => match marks {
            Nil => λ never => false_elim(never),
            Cons(_, rest) => match other { Zero => λ h => h, Succ(o) => λ h => bits_add_keeps(k, rest, o, h) },
        },
    }
}

theorem bits_union_l(a: List<Bool>): (b: List<Bool>) → (id: Nat) → bits_has(a, id).IsTrue() →
    bits_has(bits_union(a, b), id).IsTrue() {
    match a {
        Nil => λ b id never => false_elim(never),
        Cons(x, ra) => λ b id => match b {
            Nil => λ h => h,
            Cons(y, rb) => match id { Zero => λ h => Bool::is_true_or_l(x, y, h), Succ(k) => λ h => bits_union_l(ra, rb, k, h) },
        },
    }
}

theorem bits_union_r(a: List<Bool>): (b: List<Bool>) → (id: Nat) → bits_has(b, id).IsTrue() →
    bits_has(bits_union(a, b), id).IsTrue() {
    match a {
        Nil => λ b id h => h,
        Cons(x, ra) => λ b id => match b {
            Nil => λ never => false_elim(never),
            Cons(y, rb) => match id { Zero => λ h => Bool::is_true_or_r(x, y, h), Succ(k) => λ h => bits_union_r(ra, rb, k, h) },
        },
    }
}

// A marked entry of a bitmap is inside it.
theorem bits_has_below(bits: List<Bool>): (id: Nat) → bits_has(bits, id).IsTrue() → id + 1 <= bits.len() {
    match bits {
        Nil => λ id never => false_elim(never),
        Cons(_, rest) => λ id => match id { Zero => λ _ => trivial, Succ(k) => λ h => bits_has_below(rest, k, h) },
    }
}

// A scan's marks: the ids mentioned so far, kept one of two ways. `Bitmap`
// is the set itself. `Under(top)` is every id under `top`: marking an id
// marks all below it, so it holds more than was mentioned and a scan over
// it refuses more; but an id costs it one comparison, where the bitmap
// walks the id in unary (issues/function-ir-scan-id-cost.md). A function
// whose ids rise, each write above everything mentioned before it, passes
// under `Under`, and that is how the verified lowering names its values;
// `Function::scan` tries it first.
inductive Marks { Bitmap(bits: List<Bool>), Under(top: Nat) }

fn Marks::has(self marks: Marks, id: Nat) → Bool {
    match marks { Bitmap(bits) => bits_has(bits, id), Under(top) => (id + 1).leb(top) }
}

fn Marks::add(self marks: Marks, id: Nat) → Marks {
    match marks { Bitmap(bits) => Bitmap(bits_add(bits, id)), Under(top) => Under(top.max(id + 1)) }
}

// The same kind of marks with nothing marked.
fn Marks::fresh(self marks: Marks) → Marks { match marks { Bitmap(_) => Bitmap([]), Under(_) => Under(0) } }

// Both. A bitmap with a bound is the bound raised over the bitmap's length;
// no scan meets it, since a conditional's arms start from the same marks.
fn Marks::union(a, b: Marks) → Marks {
    match a {
        Bitmap(x) => match b { Bitmap(y) => Bitmap(bits_union(x, y)), Under(top) => Under(top.max(x.len())) },
        Under(top) => match b { Bitmap(y) => Under(top.max(y.len())), Under(other) => Under(top.max(other)) },
    }
}

theorem Marks::add_has(id: Nat, marks: Marks): marks.add(id).has(id).IsTrue() {
    match marks {
        Bitmap(bits) => bits_add_has(id, bits),
        Under(top) => (id + 1).leb_complete(top.max(id + 1), top.le_max_r(id + 1)),
    }
}

theorem Marks::add_keeps(id: Nat, marks: Marks, other: Nat): marks.has(other).IsTrue() → marks.add(id).has(other).IsTrue() {
    match marks {
        Bitmap(bits) => λ h => bits_add_keeps(id, bits, other, h),
        Under(top) => λ h => (other + 1).leb_complete(top.max(id + 1),
            (other + 1).le_trans(top, top.max(id + 1), (other + 1).leb_sound(top, h), top.le_max_l(id + 1))),
    }
}

theorem Marks::union_l(a, b: Marks, id: Nat): a.has(id).IsTrue() → Marks::union(a, b).has(id).IsTrue() {
    match a {
        Bitmap(x) => match b {
            Bitmap(y) => λ h => bits_union_l(x, y, id, h),
            Under(top) => λ h => (id + 1).leb_complete(top.max(x.len()),
                (id + 1).le_trans(x.len(), top.max(x.len()), bits_has_below(x, id, h), top.le_max_r(x.len()))),
        },
        Under(top) => match b {
            Bitmap(y) => λ h => (id + 1).leb_complete(top.max(y.len()),
                (id + 1).le_trans(top, top.max(y.len()), (id + 1).leb_sound(top, h), top.le_max_l(y.len()))),
            Under(other) => λ h => (id + 1).leb_complete(top.max(other),
                (id + 1).le_trans(top, top.max(other), (id + 1).leb_sound(top, h), top.le_max_l(other))),
        },
    }
}

theorem Marks::union_r(a, b: Marks, id: Nat): b.has(id).IsTrue() → Marks::union(a, b).has(id).IsTrue() {
    match a {
        Bitmap(x) => match b {
            Bitmap(y) => λ h => bits_union_r(x, y, id, h),
            Under(top) => λ h => (id + 1).leb_complete(top.max(x.len()),
                (id + 1).le_trans(top, top.max(x.len()), (id + 1).leb_sound(top, h), top.le_max_l(x.len()))),
        },
        Under(top) => match b {
            Bitmap(y) => λ h => (id + 1).leb_complete(top.max(y.len()),
                (id + 1).le_trans(y.len(), top.max(y.len()), bits_has_below(y, id, h), top.le_max_r(y.len()))),
            Under(other) => λ h => (id + 1).leb_complete(top.max(other),
                (id + 1).le_trans(other, top.max(other), (id + 1).leb_sound(other, h), top.le_max_r(other))),
        },
    }
}

fn Marks::add_all(self marks: Marks, ids: List<Nat>) → Marks {
    match ids { Nil => marks, Cons(id, rest) => marks.add(id).add_all(rest) }
}

// None of `ids` is marked.
fn Marks::lack_all(self marks: Marks, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(id, rest) => marks.has(id).not() && marks.lack_all(rest) }
}

theorem Marks::add_all_keeps(ids: List<Nat>): (marks: Marks) → (other: Nat) → marks.has(other).IsTrue() →
    marks.add_all(ids).has(other).IsTrue() {
    match ids {
        Nil => λ marks other h => h,
        Cons(id, rest) => λ marks other h => Marks::add_all_keeps(rest, marks.add(id), other, Marks::add_keeps(id, marks, other, h)),
    }
}

theorem Marks::add_all_has(ids: List<Nat>): (marks: Marks) → (other: Nat) → Mem(other, ids) →
    marks.add_all(ids).has(other).IsTrue() {
    match ids {
        Nil => λ marks other never => false_elim(never),
        Cons(id, rest) => λ marks other m => match m {
            Inl(e) => Marks::add_all_keeps(rest, marks.add(id), other, j(sym(e), λ x _ => marks.add(id).has(x).IsTrue(), Marks::add_has(id, marks))),
            Inr(later) => Marks::add_all_has(rest, marks.add(id), other, later),
        },
    }
}

theorem Marks::lack_all_mem(marks: Marks, ids: List<Nat>): marks.lack_all(ids).IsTrue() → (id: Nat) → Mem(id, ids) →
    ¬marks.has(id).IsTrue() {
    match ids {
        Nil => λ _ id never => false_elim(never),
        Cons(x, rest) => λ h id m => {
            let parts = Bool::is_true_and(marks.has(x).not(), marks.lack_all(rest), h);
            match m {
                Inl(e) => λ has => Bool::is_true_not(marks.has(x), parts.left, j(e, λ y _ => marks.has(y).IsTrue(), has)),
                Inr(later) => Marks::lack_all_mem(marks, rest, parts.right, id, later),
            }
        },
    }
}

// A marked id is not one the marks lack.
theorem Marks::apart(marks: Marks, marked, unmarked: Nat, has: marks.has(marked).IsTrue(),
    lacks: ¬marks.has(unmarked).IsTrue()): marked ≠ unmarked {
    λ e => lacks(j(e, λ x _ => marks.has(x).IsTrue(), has))
}

theorem Nat::differs_of_ne(self a, b: Nat, ne: a ≠ b): a.differs(b).IsTrue() {
    match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => trivial,
    }
}

theorem absent_of(id: Nat, ids: List<Nat>): ((x: Nat) → Mem(x, ids) → id ≠ x) → absent(id, ids).IsTrue() {
    match ids {
        Nil => λ _ => trivial,
        Cons(x, rest) => λ h => Bool::is_true_and_intro(id.differs(x), absent(id, rest),
            id.differs_of_ne(x, h(x, Inl(refl))), absent_of(id, rest, λ y m => h(y, Inr(m)))),
    }
}

theorem disjoint_of(xs, ys: List<Nat>): ((y: Nat) → Mem(y, ys) → absent(y, xs).IsTrue()) → disjoint(xs, ys).IsTrue() {
    match ys {
        Nil => λ _ => trivial,
        Cons(y, rest) => λ h => Bool::is_true_and_intro(absent(y, xs), disjoint(xs, rest),
            h(y, Inl(refl)), disjoint_of(xs, rest, λ z m => h(z, Inr(m)))),
    }
}

// Sets of ids as lists.
theorem absent_false_mem(id: Nat, ids: List<Nat>): absent(id, ids) = False → Mem(id, ids) {
    match ids {
        Nil => λ no => absurd(no),
        Cons(x, rest) => (match id.eq_dec(x) {
            Inl(e) => λ _ => Inl(e),
            Inr(_) => λ no => Inr(absent_false_mem(id, rest, no)),
        }),
    }
}

// `absent(x, s)` is `x ∉ s`, so `sets` reads it (and `holds`, which is
// `!absent`) as membership.
theorem absent_set_law(): SetBitLaw<Nat>(absent, True) {
    λ x s => match none: absent(x, s) {
        True => And(λ (no: False = True) => absurd(no),
            λ _ (m: Mem(x, s)) => absent_mem(x, s, j(sym(none), λ c _ => c.IsTrue(), trivial), x, m, refl)),
        False => And(λ _ => absent_false_mem(x, s, none), λ (no: True = False) => absurd(no)),
    }
}

register def absent_set_entry: SetBitEntry = SetBitEntry(name_of(absent), name_of(absent_set_law), True, 0);

// `a.matches(b)` is `a = b` and `a.differs(b)` its negation, so `sets`
// reads both as equations.
theorem Nat::matches_reflects(self a, b: Nat): Reflects(a = b, a.matches(b)) {
    match a.eq_dec(b) as λ d => Reflects(a = b, match d { Inl(_) => True, Inr(_) => False }) {
        Inl(e) => And(λ _ => e, λ (no: True = False) => absurd(no)),
        Inr(ne) => And(λ (no: False = True) => absurd(no), λ _ => ne),
    }
}

theorem Nat::differs_reflects(self a, b: Nat): Reflects(a = b, !a.differs(b)) {
    match a.eq_dec(b) as λ d => Reflects(a = b, Bool::not(match d { Inl(_) => False, Inr(_) => True })) {
        Inl(e) => And(λ _ => e, λ (no: True = False) => absurd(no)),
        Inr(ne) => And(λ (no: False = True) => absurd(no), λ _ => ne),
    }
}

register def matches_set_entry: SetEqEntry = SetEqEntry(name_of(Nat::matches), name_of(Nat::matches_reflects), False, 0);
register def differs_set_entry: SetEqEntry = SetEqEntry(name_of(Nat::differs), name_of(Nat::differs_reflects), True, 0);

// `disjoint(xs, ys)`: every element of `ys` is absent from `xs`.
register def disjoint_set_entry: SetRelEntry = SetRelEntry(name_of(disjoint), name_of(disjoint_mem), name_of(disjoint_of), 0);

// Nothing `ys` mentions is written in `xs`: each of `ys` is marked and each
// of `xs` is not.
theorem disjoint_of_marks(marks: Marks, xs, ys: List<Nat>,
    unmarked: (x: Nat) → Mem(x, xs) → ¬marks.has(x).IsTrue(),
    marked: (y: Nat) → Mem(y, ys) → marks.has(y).IsTrue()): disjoint(xs, ys).IsTrue() {
    disjoint_of(xs, ys, λ y m => absent_of(y, xs, λ x w => Marks::apart(marks, y, x, marked(y, m), unmarked(x, w))))
}

// `absent` as a scan evaluates it: `same` compares two numbers in one step
// of the kernel's, where `differs` walks both, and a node's ids are as
// large as the function (issues/function-ir-scan-id-cost.md).
fn missing(id: Nat, ids: List<Nat>) → Bool {
    match ids { Nil => True, Cons(x, rest) => id.same(x).not() && missing(id, rest) }
}

theorem missing_absent(id: Nat, ids: List<Nat>): missing(id, ids).IsTrue() → absent(id, ids).IsTrue() {
    match ids {
        Nil => λ _ => trivial,
        Cons(x, rest) => λ h => {
            let parts = Bool::is_true_and(id.same(x).not(), missing(id, rest), h);
            Bool::is_true_and_intro(id.differs(x), absent(id, rest),
                id.differs_of_ne(x, λ e => Bool::is_true_not(id.same(x), parts.left,
                    j(e, λ k _ => id.same(k).IsTrue(), j(sym(id.same_self()), λ d _ => d.IsTrue(), trivial)))),
                missing_absent(id, rest, parts.right))
        },
    }
}

// A scan's verdict and the marks it ends with. The verdict is read only
// through `ok`, the marks only through `marks`, each once, so a scan is
// evaluated once however it is read.
record Scan { ok: Bool, marks: Marks }

fn Scan::guard(self scan: Scan, ok: Bool) → Scan { Scan(ok := ok && scan.ok, marks := scan.marks) }

fn Scan::then(self scan: Scan, next: Marks → Scan) → Scan { next(scan.marks).guard(scan.ok) }

fn Scan::join(yes, no: Scan) → Scan { Scan(ok := yes.ok && no.ok, marks := Marks::union(yes.marks, no.marks)) }

fn nodes_scan(nodes: List<Node>, marks: Marks) → Scan {
    match nodes {
        Nil => Scan(ok := True, marks := marks),
        Cons(node, rest) => nodes_scan(rest, marks.add_all(node.mentions()))
            .guard(missing(node_output(node).id, node.reads()) && marks.has(node_output(node).id).not()),
    }
}

theorem nodes_scan_keeps(nodes: List<Node>): (marks: Marks) → (id: Nat) → marks.has(id).IsTrue() →
    nodes_scan(nodes, marks).marks.has(id).IsTrue() {
    match nodes {
        Nil => λ marks id h => h,
        Cons(node, rest) => λ marks id h =>
            nodes_scan_keeps(rest, marks.add_all(node.mentions()), id, Marks::add_all_keeps(node.mentions(), marks, id, h)),
    }
}

theorem nodes_scan_marks(nodes: List<Node>): (marks: Marks) → (id: Nat) → Mem(id, nodes_mentions(nodes)) →
    nodes_scan(nodes, marks).marks.has(id).IsTrue() {
    match nodes {
        Nil => λ marks id never => false_elim(never),
        Cons(node, rest) => λ marks id m => match List::mem_append(node.mentions(), nodes_mentions(rest), id, m) {
            Inl(here) => nodes_scan_keeps(rest, marks.add_all(node.mentions()), id,
                Marks::add_all_has(node.mentions(), marks, id, here)),
            Inr(later) => nodes_scan_marks(rest, marks.add_all(node.mentions()), id, later),
        },
    }
}

// A scan that passes: the nodes are evaluable, and none writes an id
// marked before.
theorem nodes_scan_sound(nodes: List<Node>): (marks: Marks) → nodes_scan(nodes, marks).ok.IsTrue() →
    nodes_evaluable(nodes).IsTrue() ∧ ((id: Nat) → Mem(id, nodes_writes(nodes)) → ¬marks.has(id).IsTrue()) {
    match nodes {
        Nil => λ marks _ => ⟨trivial, λ id never => false_elim(never)⟩,
        Cons(node, rest) => λ marks ok => {
            let output = node_output(node).id;
            let after = marks.add_all(node.mentions());
            let parts = Bool::is_true_and(missing(output, node.reads()) && marks.has(output).not(), nodes_scan(rest, after).ok, ok);
            let here = Bool::is_true_and(missing(output, node.reads()), marks.has(output).not(), parts.left);
            let later = nodes_scan_sound(rest, after, parts.right);
            let apart = disjoint_of_marks(after, nodes_writes(rest), node.mentions(), later.right,
                λ y m => Marks::add_all_has(node.mentions(), marks, y, m));
            ⟨Bool::is_true_and_intro(absent(output, node.reads()), disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest),
                    missing_absent(output, node.reads(), here.left),
                    Bool::is_true_and_intro(disjoint(nodes_writes(rest), node.mentions()), nodes_evaluable(rest), apart, later.left)),
                λ id w has => match w {
                    Inl(e) => Bool::is_true_not(marks.has(output), here.right, j(e, λ x _ => marks.has(x).IsTrue(), has)),
                    Inr(written) => later.right(id, written, Marks::add_all_keeps(node.mentions(), marks, id, has)),
                }⟩
        },
    }
}

// What a loop checks of its own ports: `evaluable`'s conjuncts after the
// body's.
fn loop_ports_fit(inputs: List<Nat>, bound: Nat, parameters, next, outputs: List<Nat>, exhausted: Nat) → Bool {
    distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
        && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
        && outputs.len().matches(parameters.len()))))
}

fn until_ports_fit(inputs, parameters, next, outputs: List<Nat>) → Bool {
    distinct(outputs) && (disjoint(outputs, inputs)
        && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
        && outputs.len().matches(parameters.len()))))
}

fn StructuredRegion::scan(self region: StructuredRegion, arity: Nat → Option<Nat>, marks: Marks) → Scan {
    match region {
        Dataflow(body) => nodes_scan(body.nodes, marks),
        Sequence(prefix, continuation) => nodes_scan(prefix.nodes, marks).then(λ after => continuation.scan(arity, after)),
        Compose(prefix, continuation) => prefix.scan(arity, marks).then(λ after => continuation.scan(arity, after)),
        Conditional(_, condition, _, _, when_true, when_false) =>
            Scan::join(when_true.scan(arity, marks.add(condition)), when_false.scan(arity, marks.add(condition))),
        Lend(views, callee, arguments, result) => nodes_scan(views_nodes(views), marks).then(λ after => Scan(
            ok := missing(result, views_homes(views) ++ arguments) && (arity_fits(arity(callee), (views_homes(views) ++ arguments).len()) && after.has(result).not()),
            marks := after.add_all(Cons(result, views_homes(views) ++ arguments)))),
        Call(callee, arguments, result, also) => Scan(
            ok := distinct(Cons(result, also)) && (disjoint(Cons(result, also), arguments)
                && (arity_fits(arity(callee), arguments.len()) && marks.lack_all(Cons(result, also)))),
            marks := marks.add_all(Cons(result, also) ++ arguments)),
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => Scan(
            ok := body.scan(arity, marks.fresh().add_all(Cons(count, parameters))).ok && (distinct(Cons(count, parameters))
                && (loop_ports_fit(inputs, bound, parameters, next, outputs, exhausted) && marks.lack_all(Cons(exhausted, outputs)))),
            marks := marks.add_all(Cons(bound, inputs) ++ Cons(exhausted, outputs))),
        Until(inputs, parameters, body, _, next, outputs) => Scan(
            ok := body.scan(arity, marks.fresh().add_all(parameters)).ok && (distinct(parameters)
                && (until_ports_fit(inputs, parameters, next, outputs) && marks.lack_all(outputs))),
            marks := marks.add_all(inputs ++ outputs)),
    }
}

theorem StructuredRegion::scan_keeps(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: Marks) → (id: Nat) →
    marks.has(id).IsTrue() → region.scan(arity, marks).marks.has(id).IsTrue() {
    match region {
        Dataflow(body) => λ marks id h => nodes_scan_keeps(body.nodes, marks, id, h),
        Sequence(prefix, continuation) => λ marks id h =>
            continuation.scan_keeps(arity, nodes_scan(prefix.nodes, marks).marks, id, nodes_scan_keeps(prefix.nodes, marks, id, h)),
        Compose(prefix, continuation) => λ marks id h =>
            continuation.scan_keeps(arity, prefix.scan(arity, marks).marks, id, prefix.scan_keeps(arity, marks, id, h)),
        Conditional(_, condition, _, _, when_true, when_false) => λ marks id h =>
            Marks::union_l(when_true.scan(arity, marks.add(condition)).marks, when_false.scan(arity, marks.add(condition)).marks, id, when_true.scan_keeps(arity, marks.add(condition), id, Marks::add_keeps(condition, marks, id, h))),
        Lend(views, _, arguments, result) => λ marks id h => Marks::add_all_keeps(Cons(result, views_homes(views) ++ arguments), nodes_scan(views_nodes(views), marks).marks, id,
            nodes_scan_keeps(views_nodes(views), marks, id, h)),
        Call(_, arguments, result, also) => λ marks id h => Marks::add_all_keeps(Cons(result, also) ++ arguments, marks, id, h),
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => λ marks id h =>
            Marks::add_all_keeps(Cons(bound, inputs) ++ Cons(exhausted, outputs), marks, id, h),
        Until(inputs, _, _, _, _, outputs) => λ marks id h => Marks::add_all_keeps(inputs ++ outputs, marks, id, h),
    }
}

theorem StructuredRegion::scan_marks(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: Marks) → (id: Nat) →
    Mem(id, region.mentions()) → region.scan(arity, marks).marks.has(id).IsTrue() {
    match region {
        Dataflow(body) => λ marks id m => nodes_scan_marks(body.nodes, marks, id, m),
        Sequence(prefix, continuation) => λ marks id m => match List::mem_append(nodes_mentions(prefix.nodes), continuation.mentions(), id, m) {
            Inl(here) => continuation.scan_keeps(arity, nodes_scan(prefix.nodes, marks).marks, id, nodes_scan_marks(prefix.nodes, marks, id, here)),
            Inr(later) => continuation.scan_marks(arity, nodes_scan(prefix.nodes, marks).marks, id, later),
        },
        Compose(prefix, continuation) => λ marks id m => match List::mem_append(prefix.mentions(), continuation.mentions(), id, m) {
            Inl(here) => continuation.scan_keeps(arity, prefix.scan(arity, marks).marks, id, prefix.scan_marks(arity, marks, id, here)),
            Inr(later) => continuation.scan_marks(arity, prefix.scan(arity, marks).marks, id, later),
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ marks id m => {
            let inner = marks.add(condition);
            match m {
                Inl(e) => Marks::union_l(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id, when_true.scan_keeps(arity, inner, id, j(sym(e), λ x _ => inner.has(x).IsTrue(), Marks::add_has(condition, marks)))),
                Inr(arms) => match List::mem_append(when_true.mentions(), when_false.mentions(), id, arms) {
                    Inl(here) => Marks::union_l(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id, when_true.scan_marks(arity, inner, id, here)),
                    Inr(there) => Marks::union_r(when_true.scan(arity, inner).marks, when_false.scan(arity, inner).marks, id, when_false.scan_marks(arity, inner, id, there)),
                },
            }
        },
        Lend(views, _, arguments, result) => λ marks id m => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let after = nodes_scan(nodes, marks).marks;
            match List::mem_append(nodes_mentions(nodes), Cons(result, args), id, m) {
                Inl(here) => Marks::add_all_keeps(Cons(result, args), after, id, nodes_scan_marks(nodes, marks, id, here)),
                Inr(later) => Marks::add_all_has(Cons(result, args), after, id, later),
            }
        },
        Call(_, arguments, result, also) => λ marks id m => Marks::add_all_has(Cons(result, also) ++ arguments, marks, id, m),
        Loop(inputs, bound, _, _, _, _, _, outputs, exhausted) => λ marks id m =>
            Marks::add_all_has(Cons(bound, inputs) ++ Cons(exhausted, outputs), marks, id, m),
        Until(inputs, _, _, _, _, outputs) => λ marks id m => Marks::add_all_has(inputs ++ outputs, marks, id, m),
    }
}

// A region whose scan passes is evaluable, and writes no id marked before.
theorem StructuredRegion::scan_sound(self region: StructuredRegion, arity: Nat → Option<Nat>): (marks: Marks) →
    region.scan(arity, marks).ok.IsTrue() →
    region.evaluable(arity).IsTrue() ∧ ((id: Nat) → Mem(id, region.writes()) → ¬marks.has(id).IsTrue()) {
    match region {
        Dataflow(body) => λ marks ok => nodes_scan_sound(body.nodes, marks, ok),
        Sequence(prefix, continuation) => λ marks ok => {
            let after = nodes_scan(prefix.nodes, marks).marks;
            let parts = Bool::is_true_and(nodes_scan(prefix.nodes, marks).ok, continuation.scan(arity, after).ok, ok);
            let first = nodes_scan_sound(prefix.nodes, marks, parts.left);
            let rest = continuation.scan_sound(arity, after, parts.right);
            let apart = disjoint_of_marks(after, continuation.writes(), nodes_mentions(prefix.nodes), rest.right,
                λ y m => nodes_scan_marks(prefix.nodes, marks, y, m));
            ⟨Bool::is_true_and_intro(nodes_evaluable(prefix.nodes),
                    disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), first.left,
                    Bool::is_true_and_intro(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity),
                        apart, rest.left)),
                λ id w has => match List::mem_append(nodes_writes(prefix.nodes), continuation.writes(), id, w) {
                    Inl(here) => first.right(id, here, has),
                    Inr(later) => rest.right(id, later, nodes_scan_keeps(prefix.nodes, marks, id, has)),
                }⟩
        },
        Compose(prefix, continuation) => λ marks ok => {
            let after = prefix.scan(arity, marks).marks;
            let parts = Bool::is_true_and(prefix.scan(arity, marks).ok, continuation.scan(arity, after).ok, ok);
            let first = prefix.scan_sound(arity, marks, parts.left);
            let rest = continuation.scan_sound(arity, after, parts.right);
            let apart = disjoint_of_marks(after, continuation.writes(), prefix.mentions(), rest.right,
                λ y m => prefix.scan_marks(arity, marks, y, m));
            ⟨Bool::is_true_and_intro(prefix.evaluable(arity), disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity),
                    first.left, Bool::is_true_and_intro(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity),
                        apart, rest.left)),
                λ id w has => match List::mem_append(prefix.writes(), continuation.writes(), id, w) {
                    Inl(here) => first.right(id, here, has),
                    Inr(later) => rest.right(id, later, prefix.scan_keeps(arity, marks, id, has)),
                }⟩
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ marks ok => {
            let inner = marks.add(condition);
            let arms = Bool::is_true_and(when_true.scan(arity, inner).ok, when_false.scan(arity, inner).ok, ok);
            let yes = when_true.scan_sound(arity, inner, arms.left);
            let no = when_false.scan_sound(arity, inner, arms.right);
            let fresh: (x: Nat) → Mem(x, when_true.writes() ++ when_false.writes()) → ¬inner.has(x).IsTrue() = λ x w =>
                match List::mem_append(when_true.writes(), when_false.writes(), x, w) {
                    Inl(here) => yes.right(x, here),
                    Inr(there) => no.right(x, there),
                };
            let unwritten = absent_of(condition, when_true.writes() ++ when_false.writes(),
                λ x w => Marks::apart(inner, condition, x, Marks::add_has(condition, marks), fresh(x, w)));
            ⟨Bool::is_true_and_intro(absent(condition, when_true.writes() ++ when_false.writes()),
                    when_true.evaluable(arity) && when_false.evaluable(arity), unwritten,
                    Bool::is_true_and_intro(when_true.evaluable(arity), when_false.evaluable(arity), yes.left, no.left)),
                λ id w has => fresh(id, w, Marks::add_keeps(condition, marks, id, has))⟩
        },
        Lend(views, callee, arguments, result) => λ marks ok => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let after = nodes_scan(nodes, marks).marks;
            let parts = Bool::is_true_and(nodes_scan(nodes, marks).ok,
                missing(result, args) && (arity_fits(arity(callee), args.len()) && after.has(result).not()), ok);
            let called = Bool::is_true_and(missing(result, args), arity_fits(arity(callee), args.len()) && after.has(result).not(), parts.right);
            let rest = Bool::is_true_and(arity_fits(arity(callee), args.len()), after.has(result).not(), called.right);
            let first = nodes_scan_sound(nodes, marks, parts.left);
            let fresh: ((id: Nat) → Mem(id, [result]) → ¬after.has(id).IsTrue()) = λ id w has => match w {
                Inl(e) => Bool::is_true_not(after.has(result), rest.right, j(e, λ x _ => after.has(x).IsTrue(), has)),
                Inr(never) => false_elim(never),
            };
            let apart = disjoint_of_marks(after, [result], nodes_mentions(nodes), fresh, λ y m => nodes_scan_marks(nodes, marks, y, m));
            ⟨Bool::is_true_and_intro(nodes_evaluable(nodes),
                    disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(arity(callee), args.len())), first.left,
                    Bool::is_true_and_intro(disjoint([result], nodes_mentions(nodes)), absent(result, args) && arity_fits(arity(callee), args.len()),
                        apart, Bool::is_true_and_intro(absent(result, args), arity_fits(arity(callee), args.len()),
                            missing_absent(result, args, called.left), rest.left))),
                λ id w has => match List::mem_append(nodes_writes(nodes), [result], id, w) {
                    Inl(here) => first.right(id, here, has),
                    Inr(later) => fresh(id, later, nodes_scan_keeps(nodes, marks, id, has)),
                }⟩
        },
        Call(callee, arguments, result, also) => λ marks ok => {
            let outs = Cons(result, also);
            let p0 = Bool::is_true_and(distinct(outs), disjoint(outs, arguments)
                && (arity_fits(arity(callee), arguments.len()) && marks.lack_all(outs)), ok);
            let p1 = Bool::is_true_and(disjoint(outs, arguments), arity_fits(arity(callee), arguments.len()) && marks.lack_all(outs), p0.right);
            let p2 = Bool::is_true_and(arity_fits(arity(callee), arguments.len()), marks.lack_all(outs), p1.right);
            ⟨Bool::is_true_and_intro(distinct(outs), disjoint(outs, arguments) && arity_fits(arity(callee), arguments.len()), p0.left,
                    Bool::is_true_and_intro(disjoint(outs, arguments), arity_fits(arity(callee), arguments.len()), p1.left, p2.left)),
                Marks::lack_all_mem(marks, outs, p2.right)⟩
        },
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => λ marks ok => {
            let start = marks.fresh().add_all(Cons(count, parameters));
            let ports = loop_ports_fit(inputs, bound, parameters, next, outputs, exhausted);
            let lacks = marks.lack_all(Cons(exhausted, outputs));
            let p0 = Bool::is_true_and(body.scan(arity, start).ok, distinct(Cons(count, parameters)) && (ports && lacks), ok);
            let p1 = Bool::is_true_and(distinct(Cons(count, parameters)), ports && lacks, p0.right);
            let p2 = Bool::is_true_and(ports, lacks, p1.right);
            let inner = body.scan_sound(arity, start, p0.left);
            let apart = disjoint_of_marks(start, body.writes(), Cons(count, parameters), inner.right,
                λ y m => Marks::add_all_has(Cons(count, parameters), marks.fresh(), y, m));
            ⟨Bool::is_true_and_intro(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters)) && ports),
                    inner.left, Bool::is_true_and_intro(distinct(Cons(count, parameters)), disjoint(body.writes(), Cons(count, parameters)) && ports,
                        p1.left, Bool::is_true_and_intro(disjoint(body.writes(), Cons(count, parameters)), ports, apart, p2.left))),
                Marks::lack_all_mem(marks, Cons(exhausted, outputs), p2.right)⟩
        },
        Until(inputs, parameters, body, _, next, outputs) => λ marks ok => {
            let start = marks.fresh().add_all(parameters);
            let ports = until_ports_fit(inputs, parameters, next, outputs);
            let lacks = marks.lack_all(outputs);
            let p0 = Bool::is_true_and(body.scan(arity, start).ok, distinct(parameters) && (ports && lacks), ok);
            let p1 = Bool::is_true_and(distinct(parameters), ports && lacks, p0.right);
            let p2 = Bool::is_true_and(ports, lacks, p1.right);
            let inner = body.scan_sound(arity, start, p0.left);
            let apart = disjoint_of_marks(start, body.writes(), parameters, inner.right,
                λ y m => Marks::add_all_has(parameters, marks.fresh(), y, m));
            ⟨Bool::is_true_and_intro(body.evaluable(arity), distinct(parameters) && (disjoint(body.writes(), parameters) && ports),
                    inner.left, Bool::is_true_and_intro(distinct(parameters), disjoint(body.writes(), parameters) && ports,
                        p1.left, Bool::is_true_and_intro(disjoint(body.writes(), parameters), ports, apart, p2.left))),
                Marks::lack_all_mem(marks, outputs, p2.right)⟩
        },
    }
}

// A function's body scanned from its parameters, marked, over marks that
// start as `none`.
fn Function::scan_from(self function: Function, arity: Nat → Option<Nat>, none: Marks) → Bool {
    function.body.scan(arity, none.add_all(function.parameters)).ok
}

// A function scans under a bound first, the scan that costs an id one
// comparison and passes when the ids rise, and over the bitmap when that
// refuses: either is enough.
fn Function::scan(self function: Function, arity: Nat → Option<Nat>) → Bool {
    distinct(function.parameters) && (function.scan_from(arity, Under(0)) || function.scan_from(arity, Bitmap([])))
}

theorem Function::scan_from_evaluable(self function: Function, arity: Nat → Option<Nat>, none: Marks,
    apart: distinct(function.parameters).IsTrue(), ok: function.scan_from(arity, none).IsTrue()): function.evaluable(arity).IsTrue() {
    let start = none.add_all(function.parameters);
    let body = function.body.scan_sound(arity, start, ok);
    let unwritten = disjoint_of_marks(start, function.body.writes(), function.parameters, body.right,
        λ y m => Marks::add_all_has(function.parameters, none, y, m));
    Bool::is_true_and_intro(function.body.evaluable(arity), distinct(function.parameters) && disjoint(function.body.writes(), function.parameters),
        body.left, Bool::is_true_and_intro(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), apart, unwritten))
}

theorem Function::scan_evaluable(self function: Function, arity: Nat → Option<Nat>, ok: function.scan(arity).IsTrue()):
    function.evaluable(arity).IsTrue() {
    let parts = Bool::is_true_and(distinct(function.parameters),
        function.scan_from(arity, Under(0)) || function.scan_from(arity, Bitmap([])), ok);
    match Bool::is_true_or(function.scan_from(arity, Under(0)), function.scan_from(arity, Bitmap([])), parts.right) {
        Inl(rising) => function.scan_from_evaluable(arity, Under(0), parts.left, rising),
        Inr(exact) => function.scan_from_evaluable(arity, Bitmap([]), parts.left, exact),
    }
}

// ---------------------------------------------------------------------------
// `program_evaluable` in one pass per function, against a table of
// arities. `program_evaluable` reads a callee's arity off its parameter
// list (`program_arity`), so a scan that did the same would force the code
// of every function a function calls: for one that calls many (a
// dispatcher), all of them in its one declaration
// (issues/compile-x86-certificate-memory.md). Here the arities are a list
// of numbers beside the program (`linked_arity`), and each function's scan
// also checks its own entry, so a function's statement forces its own code
// alone and the table is the program's arities by the entries together
// (`program_scan_at_arity`).

// `evaluable` reads the arities only at the calls: tables that agree
// everywhere give the same verdict.
theorem StructuredRegion::evaluable_arity(self region: StructuredRegion, arity, other: Nat → Option<Nat>,
    same: (k: Nat) → arity(k) = other(k)): region.evaluable(arity).IsTrue() → region.evaluable(other).IsTrue() {
    match region {
        Dataflow(_) => λ ok => ok,
        Sequence(prefix, continuation) => Bool::and_right_map(nodes_evaluable(prefix.nodes),
            disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity),
            disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(other),
            Bool::and_right_map(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity),
                continuation.evaluable(other), continuation.evaluable_arity(arity, other, same))),
        Compose(prefix, continuation) => λ ok => Bool::and_left_map(prefix.evaluable(arity),
            disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(other), prefix.evaluable(other),
            prefix.evaluable_arity(arity, other, same),
            Bool::and_right_map(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(other),
                Bool::and_right_map(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity),
                    continuation.evaluable(other), continuation.evaluable_arity(arity, other, same)), ok)),
        Conditional(_, condition, _, _, when_true, when_false) => Bool::and_right_map(absent(condition, when_true.writes() ++ when_false.writes()),
            when_true.evaluable(arity) && when_false.evaluable(arity), when_true.evaluable(other) && when_false.evaluable(other),
            λ arms => Bool::and_left_map(when_true.evaluable(arity), when_false.evaluable(other), when_true.evaluable(other),
                when_true.evaluable_arity(arity, other, same),
                Bool::and_right_map(when_true.evaluable(arity), when_false.evaluable(arity), when_false.evaluable(other),
                    when_false.evaluable_arity(arity, other, same), arms))),
        Lend(views, callee, arguments, result) => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            Bool::and_right_map(nodes_evaluable(nodes),
                disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(arity(callee), args.len())),
                disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(other(callee), args.len())),
                Bool::and_right_map(disjoint([result], nodes_mentions(nodes)), absent(result, args) && arity_fits(arity(callee), args.len()),
                    absent(result, args) && arity_fits(other(callee), args.len()),
                    Bool::and_right_map(absent(result, args), arity_fits(arity(callee), args.len()), arity_fits(other(callee), args.len()),
                        λ fits => j(same(callee), λ a _ => arity_fits(a, args.len()).IsTrue(), fits))))
        },
        Call(callee, arguments, result, also) => Bool::and_right_map(distinct(Cons(result, also)),
            disjoint(Cons(result, also), arguments) && arity_fits(arity(callee), arguments.len()),
            disjoint(Cons(result, also), arguments) && arity_fits(other(callee), arguments.len()),
            Bool::and_right_map(disjoint(Cons(result, also), arguments), arity_fits(arity(callee), arguments.len()),
                arity_fits(other(callee), arguments.len()),
                λ fits => j(same(callee), λ a _ => arity_fits(a, arguments.len()).IsTrue(), fits))),
        Loop(inputs, bound, parameters, count, body, _, next, outputs, exhausted) => Bool::and_left_map(body.evaluable(arity),
            distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
            && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
            && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
            && outputs.len().matches(parameters.len())))))),
            body.evaluable(other), body.evaluable_arity(arity, other, same)),
        Until(inputs, parameters, body, _, next, outputs) => Bool::and_left_map(body.evaluable(arity),
            distinct(parameters) && (disjoint(body.writes(), parameters)
            && (distinct(outputs) && (disjoint(outputs, inputs)
            && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
            && outputs.len().matches(parameters.len())))))),
            body.evaluable(other), body.evaluable_arity(arity, other, same)),
    }
}

theorem Function::evaluable_arity(self function: Function, arity, other: Nat → Option<Nat>, same: (k: Nat) → arity(k) = other(k)):
    function.evaluable(arity).IsTrue() → function.evaluable(other).IsTrue() {
    Bool::and_left_map(function.body.evaluable(arity), distinct(function.parameters) && disjoint(function.body.writes(), function.parameters),
        function.body.evaluable(other), function.body.evaluable_arity(arity, other, same))
}

// A function's scan at the table, and its own entry of it.
fn Function::scan_at(self last: Function, earlier: List<Function>, arities: List<Nat>) → Bool {
    last.scan(linked_last_arity(last, earlier, arities)) && arity_fits(arities.nth(0), last.parameters.len())
}

fn program_scan_at(functions: List<Function>, arities: List<Nat>) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => last.scan_at(earlier, arities) && program_scan_at(earlier, arities.tail()),
    }
}

// Where every function has its entry, the table is the program's arities.
theorem program_scan_at_arity(functions: List<Function>): (arities: List<Nat>) → program_scan_at(functions, arities).IsTrue() →
    (k: Nat) → linked_arity(functions, arities, k) = program_arity(functions, k) {
    match functions {
        Nil => λ arities ok k => refl,
        Cons(last, earlier) => λ arities ok k => {
            let parts = Bool::is_true_and(last.scan_at(earlier, arities), program_scan_at(earlier, arities.tail()), ok);
            let own = Bool::is_true_and(last.scan(linked_last_arity(last, earlier, arities)), arity_fits(arities.nth(0), last.parameters.len()),
                parts.left).right;
            let entry: (arities.nth(0) = Some(last.parameters.len())) =
                (match arities.nth(0) as λ a => arity_fits(a, last.parameters.len()).IsTrue() → a = Some(last.parameters.len()) {
                    None => λ never => false_elim(never),
                    Some(n) => λ fits => cong_fn(λ (x: Nat) => Some(x), n.matches_eq(last.parameters.len(), fits)),
                })(own);
            match k.eq_dec(earlier.len()) as λ d =>
                (match d { Inl(_) => arities.nth(0), Inr(_) => linked_arity(earlier, arities.tail(), k) }) =
                (match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, k) }) {
                Inl(_) => entry,
                Inr(_) => program_scan_at_arity(earlier, arities.tail(), parts.right, k),
            }
        },
    }
}

// The table the last function was scanned at is the program's, with the
// function's own entry or without.
theorem scan_last_arity(last: Function, earlier: List<Function>, arities: List<Nat>, ok: program_scan_at(Cons(last, earlier), arities).IsTrue()):
    (levels: Nat) → (g: Nat) → self_table(linked_arity(earlier, arities.tail()), earlier.len(), levels, arities.nth(0))(g) =
        self_table(program_arity(earlier), earlier.len(), levels, Some(last.parameters.len()))(g) {
    λ levels => match levels {
        Zero => program_scan_at_arity(earlier, arities.tail(),
            Bool::is_true_and(last.scan_at(earlier, arities), program_scan_at(earlier, arities.tail()), ok).right),
        Succ(_) => program_scan_at_arity(Cons(last, earlier), arities, ok),
    }
}

theorem program_scan_at_evaluable(functions: List<Function>): (arities: List<Nat>) → program_scan_at(functions, arities).IsTrue() →
    program_evaluable(functions).IsTrue() {
    match functions {
        Nil => λ _ _ => trivial,
        Cons(last, earlier) => λ arities ok => {
            let parts = Bool::is_true_and(last.scan_at(earlier, arities), program_scan_at(earlier, arities.tail()), ok);
            let scanned = Bool::is_true_and(last.scan(linked_last_arity(last, earlier, arities)), arity_fits(arities.nth(0), last.parameters.len()),
                parts.left).left;
            Bool::is_true_and_intro(last.evaluable(program_last_arity(last, earlier)), program_evaluable(earlier),
                last.evaluable_arity(linked_last_arity(last, earlier, arities), program_last_arity(last, earlier),
                    scan_last_arity(last, earlier, arities, ok, last.levels),
                    last.scan_evaluable(linked_last_arity(last, earlier, arities), scanned)),
                program_scan_at_evaluable(earlier, arities.tail(), parts.right))
        },
    }
}

// The scan of a program's last function alone (the first in the list).
fn program_scan_at_head(functions: List<Function>, arities: List<Nat>) → Bool {
    match functions { Nil => True, Cons(last, earlier) => last.scan_at(earlier, arities) }
}

theorem program_scan_at_drop_zero(functions: List<Function>, arities: List<Nat>):
    program_scan_at(functions.drop(0), arities.drop(0)).IsTrue() → program_scan_at(functions, arities).IsTrue() {
    match functions {
        Nil => λ h => trivial,
        Cons(_, _) => match arities { Nil => λ h => h, Cons(_, _) => λ h => h },
    }
}

// `program_scan_at` a function at a time, each its own declaration: the
// kernel's fuel is per declaration, so a certificate built this way pays
// for its largest function, not for the sum of them.
theorem program_scan_at_drop(functions: List<Function>): (arities: List<Nat>) → (n: Nat) →
    program_scan_at_head(functions.drop(n), arities.drop(n)).IsTrue() →
    program_scan_at(functions.drop(n + 1), arities.drop(n + 1)).IsTrue() → program_scan_at(functions.drop(n), arities.drop(n)).IsTrue() {
    match functions {
        Nil => λ _ _ _ _ => trivial,
        Cons(last, earlier) => λ arities n => match n as λ i =>
            program_scan_at_head(Cons(last, earlier).drop(i), arities.drop(i)).IsTrue() →
            program_scan_at(Cons(last, earlier).drop(i + 1), arities.drop(i + 1)).IsTrue() →
            program_scan_at(Cons(last, earlier).drop(i), arities.drop(i)).IsTrue() {
            Zero => match arities as λ ns => program_scan_at_head(Cons(last, earlier), ns.drop(0)).IsTrue() →
                program_scan_at(earlier.drop(0), ns.drop(1)).IsTrue() → program_scan_at(Cons(last, earlier), ns.drop(0)).IsTrue() {
                Nil => λ head rest => Bool::is_true_and_intro(last.scan_at(earlier, Nil), program_scan_at(earlier, Nil), head,
                    program_scan_at_drop_zero(earlier, Nil, rest)),
                Cons(a, more) => λ head rest => Bool::is_true_and_intro(last.scan_at(earlier, Cons(a, more)), program_scan_at(earlier, more), head,
                    program_scan_at_drop_zero(earlier, more, rest)),
            },
            Succ(k) => match arities as λ ns => program_scan_at_head(earlier.drop(k), ns.drop(k + 1)).IsTrue() →
                program_scan_at(earlier.drop(k + 1), ns.drop(k + 2)).IsTrue() → program_scan_at(earlier.drop(k), ns.drop(k + 1)).IsTrue() {
                Nil => λ head rest => program_scan_at_drop(earlier, Nil, k, head, rest),
                Cons(_, more) => λ head rest => program_scan_at_drop(earlier, more, k, head, rest),
            },
        },
    }
}

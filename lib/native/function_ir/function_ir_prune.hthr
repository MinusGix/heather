// Functions nothing calls any more, emptied (docs/native/optimizer-design.md
// §3.1): after inlining, a function whose every call was replaced is code
// the program never reaches, and the lowering would still compile it.
//
// `live` names the functions kept: the ones a caller outside the program
// may call, and every function a kept one calls (`program_closed`, a
// check). Every other function becomes one constant (`Function::emptied`),
// with its parameters and its count of lent buffers as they were, so the
// functions keep their numbers and the program its shape. `prune_sound`:
// a live function of the pruned program may do whatever it did.
//
// This is not a `Stage`: a stage's law is every function's, and an emptied
// function does not do what it did.
import function_ir;
import function_ir_eval;
import function_ir_writes;
import function_ir_fresh;
import function_ir_stage;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

fn Nat::among(self n: Nat, ns: List<Nat>) → Bool { match ns { Nil => False, Cons(m, rest) => n.same(m) || n.among(rest) } }

// Whether every call of the region is of a function `live` names.
fn StructuredRegion::calls_only(self region: StructuredRegion, live: Nat → Bool) → Bool {
    match region {
        Dataflow(_) => True,
        Sequence(_, continuation) => continuation.calls_only(live),
        Compose(prefix, continuation) => prefix.calls_only(live) && continuation.calls_only(live),
        Conditional(_, _, _, _, when_true, when_false) => when_true.calls_only(live) && when_false.calls_only(live),
        Call(callee, _, _, _) => live(callee),
        Loop(_, _, _, _, body, _, _, _, _) => body.calls_only(live),
        Lend(_, callee, _, _) => live(callee),
        Until(_, _, body, _, _, _, measure_at) => body.calls_only(live),
    }
}

// A region runs under any effects its own imply at the functions it calls.
theorem StructuredRegion::runs_weaken_within(self region: StructuredRegion, live: Nat → Bool, effects, weaker: Effects(),
    implies: (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
        (after: Buffers()) → effects(before, f, arguments, result, extra, after) → weaker(before, f, arguments, result, extra, after)):
    region.calls_only(live) = True → (values: Valuation()) → (before, after: Buffers()) →
    StructuredRegionRunsOver(effects, values, region, before, after) → StructuredRegionRunsOver(weaker, values, region, before, after) {
    match region {
        Dataflow(_) => λ only values before after ran => ran,
        Sequence(_, continuation) => λ only values before after ran => Exists(ran.witness, ⟨ran.proof.left,
            continuation.runs_weaken_within(live, effects, weaker, implies, only, values, ran.witness, after, ran.proof.right)⟩),
        Compose(prefix, continuation) => λ only values before after ran => {
            let parts = Bool::and_true_parts(prefix.calls_only(live), continuation.calls_only(live), only);
            Exists(ran.witness, ⟨prefix.runs_weaken_within(live, effects, weaker, implies, parts.left, values, before, ran.witness, ran.proof.left),
                continuation.runs_weaken_within(live, effects, weaker, implies, parts.right, values, ran.witness, after, ran.proof.right)⟩)
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ only values before after => {
            let parts = Bool::and_true_parts(when_true.calls_only(live), when_false.calls_only(live), only);
            (match values(1, condition).head_bit() as λ h =>
                (match h {
                    False => StructuredRegionRunsOver(effects, values, when_false, before, after),
                    True => StructuredRegionRunsOver(effects, values, when_true, before, after),
                }) →
                (match h {
                    False => StructuredRegionRunsOver(weaker, values, when_false, before, after),
                    True => StructuredRegionRunsOver(weaker, values, when_true, before, after),
                }) {
                False => λ arm => when_false.runs_weaken_within(live, effects, weaker, implies, parts.right, values, before, after, arm),
                True => λ arm => when_true.runs_weaken_within(live, effects, weaker, implies, parts.left, values, before, after, arm),
            })
        },
        Call(callee, arguments, result, also) => λ only values before after ran =>
            implies(before, callee, only, words_of(values, arguments), values(64, result), words_of(values, also), after, ran),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ only values before after ran =>
            loop_runs_over_weaken(
                λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, body, from, to),
                λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(weaker, pass, body, from, to),
                λ pass from to old => body.runs_weaken_within(live, effects, weaker, implies, only, pass, from, to, old),
                parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs), words_of(values, outputs),
                values(1, exhausted).head_bit(), before, after, ran),
        Lend(views, callee, arguments, result) => λ only values before after ran =>
            Exists(ran.witness, ⟨ran.proof.left, Exists(ran.proof.right.witness,
                ⟨Exists(ran.proof.right.proof.left.witness, implies(viewed(views, values, ran.witness), callee, only,
                    words_of(values, views_homes(views) ++ arguments), values(64, result), ran.proof.right.proof.left.witness,
                    ran.proof.right.witness, ran.proof.right.proof.left.proof)), ran.proof.right.proof.right⟩)⟩),
        Until(inputs, parameters, body, exit, next, outputs, measure_at) => λ only values before after ran => Exists(ran.witness,
            until_runs_over_weaken(
                λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, pass, body, from, to),
                λ (pass: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(weaker, pass, body, from, to),
                λ pass from to old => body.runs_weaken_within(live, effects, weaker, implies, only, pass, from, to, old),
                parameters, exit, next, ran.witness, words_of(values, inputs), words_of(values, outputs), before, after, ran.proof)),
    }
}

// The function with one constant for a body: its parameters and its count
// of lent buffers are as they were, so a program lists and lowers it as
// before.
fn Function::emptied(self function: Function) → Function {
    Function(function.parameters, Dataflow(Region(Ports(Nil), [Const(64, ids_top(function.parameters, 0), 0)], Ports(Nil))),
        ids_top(function.parameters, 0), lent := function.lent, also := function.also)
}

// The program with every function `live` does not name emptied.
fn prune(functions: List<Function>, live: Nat → Bool) → List<Function> {
    match functions {
        Nil => Nil,
        Cons(last, earlier) => Cons(match live(earlier.len()) { True => last, False => last.emptied() }, prune(earlier, live)),
    }
}

// Whether every function `live` names calls only functions it names.
fn program_closed(functions: List<Function>, live: Nat → Bool) → Bool {
    match functions {
        Nil => True,
        Cons(last, earlier) => (!live(earlier.len()) || last.body.calls_only(live)) && program_closed(earlier, live),
    }
}

theorem prune_len(live: Nat → Bool, functions: List<Function>): prune(functions, live).len() = functions.len() {
    match functions { Nil => refl, Cons(_, earlier) => cong_fn<Nat, Nat>(λ n => n + 1, prune_len(live, earlier)) }
}

// A function that calls only live functions, among effects that are
// weaker at the live ones: with its own number too, at each depth.
theorem Function::tied_prunes_at(self last: Function, live: Nat → Bool, below, others: Effects(), k: Nat,
    weaker: (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
        (after: Buffers()) → below(before, f, arguments, result, extra, after) → others(before, f, arguments, result, extra, after),
    depth: Nat,
    own: (before: Buffers()) → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) → (after: Buffers()) →
        last.level_runs(below, k, depth)(before, arguments, result, extra, after) → last.level_runs(others, k, depth)(before, arguments, result, extra, after)):
    (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
    (after: Buffers()) → last.tied_effects(below, k, depth)(before, f, arguments, result, extra, after) →
    last.tied_effects(others, k, depth)(before, f, arguments, result, extra, after) {
    λ before f alive arguments result extra after => match f.eq_dec(k) as λ d =>
        (match d as λ _ => Type {
            Inl(_) => last.level_runs(below, k, depth)(before, arguments, result, extra, after),
            Inr(_) => below(before, f, arguments, result, extra, after),
        }) →
        (match d as λ _ => Type {
            Inl(_) => last.level_runs(others, k, depth)(before, arguments, result, extra, after),
            Inr(_) => others(before, f, arguments, result, extra, after),
        }) {
        Inl(_) => own(before, arguments, result, extra, after),
        Inr(_) => weaker(before, f, alive, arguments, result, extra, after),
    }
}

theorem Function::level_prunes(self last: Function, live: Nat → Bool, below, others: Effects(), k: Nat,
    weaker: (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
        (after: Buffers()) → below(before, f, arguments, result, extra, after) → others(before, f, arguments, result, extra, after),
    only: last.body.calls_only(live) = True, depth: Nat):
    (before: Buffers()) → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) → (after: Buffers()) →
    last.level_runs(below, k, depth)(before, arguments, result, extra, after) → last.level_runs(others, k, depth)(before, arguments, result, extra, after) {
    match depth {
        Zero => λ before arguments result extra after never => never,
        Succ(i) => λ before arguments result extra after ran => Exists(ran.witness, ⟨ran.proof.left, ⟨last.body.runs_weaken_within(live,
            last.tied_effects(below, k, i), last.tied_effects(others, k, i),
            last.tied_prunes_at(live, below, others, k, weaker, i, last.level_prunes(live, below, others, k, weaker, only, i)),
            only, ran.witness, before, after, ran.proof.right.left), ran.proof.right.right⟩⟩),
    }
}

theorem Function::levels_prunes(self last: Function, live: Nat → Bool, below, others: Effects(), k: Nat,
    weaker: (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
        (after: Buffers()) → below(before, f, arguments, result, extra, after) → others(before, f, arguments, result, extra, after),
    only: last.body.calls_only(live) = True, levels: Nat):
    (before: Buffers()) → (f: Nat) → live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) →
    (after: Buffers()) → last.effects_at(below, k, levels)(before, f, arguments, result, extra, after) →
    last.effects_at(others, k, levels)(before, f, arguments, result, extra, after) {
    match levels {
        Zero => weaker,
        Succ(depth) => last.tied_prunes_at(live, below, others, k, weaker, depth, last.level_prunes(live, below, others, k, weaker, only, depth)),
    }
}

// A live function of the pruned program may do whatever it did.
theorem prune_sound(live: Nat → Bool, functions: List<Function>): program_closed(functions, live) = True → (before: Buffers()) → (f: Nat) →
    live(f) = True → (arguments: List<BitVec(64)>) → (result: BitVec(64)) → (extra: List<BitVec(64)>) → (after: Buffers()) →
    program_effects(functions, before, f, arguments, result, extra, after) → program_effects(prune(functions, live), before, f, arguments, result, extra, after) {
    match functions {
        Nil => λ _ before f _ arguments result extra after ran => false_elim(ran),
        Cons(last, earlier) => λ closed before f alive arguments result extra after => {
            let parts = Bool::and_true_parts(!live(earlier.len()) || last.body.calls_only(live), program_closed(earlier, live), closed);
            let below = prune_sound(live, earlier, parts.right);
            let n = earlier.len();
            let pruned = program_effects(prune(earlier, live));
            let pick = λ (t: Bool) => match t { True => last, False => last.emptied() };
            let at = (match f.eq_dec(earlier.len()) as λ d =>
                (match d {
                    Inl(_) => last.RunsBoth(last.effects_at(program_effects(earlier), n, last.levels), arguments, result, extra, before, after),
                    Inr(_) => program_effects(earlier, before, f, arguments, result, extra, after),
                }) →
                (match d {
                    Inl(_) => pick(live(n)).RunsBoth(pick(live(n)).effects_at(pruned, n, pick(live(n)).levels), arguments, result, extra, before, after),
                    Inr(_) => program_effects(prune(earlier, live), before, f, arguments, result, extra, after),
                }) {
                Inl(same) => λ ran => {
                    let here: (live(earlier.len()) = True) = j(same, λ m _ => live(m) = True, alive);
                    let only: (last.body.calls_only(live) = True) = j(here, λ t _ => (!t || last.body.calls_only(live)) = True, parts.left);
                    let moved: last.RunsBoth(last.effects_at(pruned, n, last.levels), arguments, result, extra, before, after) =
                        Exists(ran.witness, ⟨ran.proof.left, ⟨last.body.runs_weaken_within(live, last.effects_at(program_effects(earlier), n, last.levels),
                            last.effects_at(pruned, n, last.levels),
                            last.levels_prunes(live, program_effects(earlier), pruned, n, below, only, last.levels),
                            only, ran.witness, before, after, ran.proof.right.left), ran.proof.right.right⟩⟩);
                    j(sym(here), λ t _ => pick(t).RunsBoth(pick(t).effects_at(pruned, n, pick(t).levels), arguments, result, extra, before, after), moved)
                },
                Inr(_) => λ ran => below(before, f, alive, arguments, result, extra, after, ran),
            });
            j(sym(prune_len(live, earlier)), λ m _ =>
                (match f.eq_dec(earlier.len()) {
                    Inl(_) => last.RunsBoth(last.effects_at(program_effects(earlier), n, last.levels), arguments, result, extra, before, after),
                    Inr(_) => program_effects(earlier, before, f, arguments, result, extra, after),
                }) →
                (match f.eq_dec(m) {
                    Inl(_) => pick(live(n)).RunsBoth(pick(live(n)).effects_at(pruned, m, pick(live(n)).levels), arguments, result, extra, before, after),
                    Inr(_) => program_effects(prune(earlier, live), before, f, arguments, result, extra, after),
                }), at)
        },
    }
}

// The same as a compiler cites it, at a function that is reached.
theorem prune_rewrites(live: Nat → Bool, functions: List<Function>, closed: program_closed(functions, live) = True, f: Nat, alive: live(f) = True):
    ProgramRewrites(functions, prune(functions, live), f) {
    λ before arguments result extra after ran => prune_sound(live, functions, closed, before, f, alive, arguments, result, extra, after, ran)
}

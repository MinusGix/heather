// What a region's run with the file threaded is, proved
// (docs/native/native-one-compiler-design.md §2.6, U4 steps 4a-5 and 4b).
//
// `function_ir_writes` says what a program may do to the file as a
// relation (`program_effects`), which is what the function compiler is
// proved against. `function_ir_state`'s `run` computes it for a region,
// and here for a program: `program_run` answers a call with the word it
// returns and the file it leaves, a store setting its byte and a call
// handing on the file its callee left. `program_run_effects` proves that
// answer one the relation allows, for an evaluable program, so what a
// function that writes returns and leaves is stated by evaluation, as a
// function that only reads is (`program_eval_reads`).
//
// A program that stores nothing runs as it evaluates and leaves the file
// (`program_run_quiet`): everything stated of a reading function by
// `program_eval_over` is stated of its run.

import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_views;
import function_ir_writes;
import nat_map;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Nodes

// What a node's run names its output: its value over the file, and for a
// store the byte in the file the store left.
fn Node::run_value(self node: Node, values: Valuation(), buffers: Buffers()) → (w: Nat) → BitVec(w) {
    match node {
        BufferStore(_, buffer, index, value) =>
            load_value(store_byte(buffers, buffer, values(64, index).toNat(), low_byte(values(64, value))), buffer, index, values),
        WideStore(bytes, _, buffer, index, value) =>
            wide_value(store_word(buffers, buffer, values(64, index).toNat(), bytes, values(8 * bytes, value)), buffer, index, bytes, values),
        _ => node.value(values, buffers := buffers),
    }
}

theorem Node::run_values(self node: Node, values: Valuation(), buffers: Buffers()):
    node.run(values, buffers).values = Valuation::set(values, node_output(node).id, node.run_value(values, buffers)) {
    match node { _ => refl }
}

// A node's run keeps every id but its output.
theorem Node::run_frame(self node: Node, values: Valuation(), buffers: Buffers(), w, id: Nat, differs: id ≠ node_output(node).id):
    node.run(values, buffers).values(w, id) = values(w, id) {
    j(sym(node.run_values(values, buffers)), λ vs _ => vs(w, id) = values(w, id),
        Valuation::set_other(values, node_output(node).id, node.run_value(values, buffers), w, id, differs))
}

// A node that is no store runs as it steps over the file, and leaves it.
theorem Node::run_step(self node: Node, values: Valuation(), buffers: Buffers()):
    (!node.stores()).IsTrue() → node.run(values, buffers) = State(node.step(values, buffers := buffers), buffers) {
    match node {
        BufferStore(_, _, _, _) => λ no => false_elim(no),
        WideStore(_, _, _, _, _) => λ no => false_elim(no),
        _ => λ _ => refl,
    }
}

theorem Node::run_holds_quiet(self node: Node, values, after: Valuation(), before: Buffers(), quiet: (!node.stores()).IsTrue(),
    at_output: (w: Nat) → after(w, node_output(node).id) = node.run(values, before).values(w, node_output(node).id),
    kept: (w: Nat) → (id: Nat) → Mem(id, node.reads()) → after(w, id) = values(w, id), defined: node.defined(values).IsTrue()):
    node.Runs(after, before, node.run(values, before).buffers) {
    (j(sym(node.run_step(values, before, quiet)),
        λ s _ => ((w: Nat) → after(w, node_output(node).id) = s.values(w, node_output(node).id)) → node.Runs(after, before, s.buffers),
        λ at => node.runs_quiet(after, before, quiet, node.holds_of(values, after, before,
            λ w => trans(at(w), Valuation::set_here(values, node_output(node).id, node.value(values, buffers := before), w)), kept,
            defined))))(at_output)
}

// A valuation whose output is what the node's run names it and whose
// operands are as they were runs the node, to the file its run leaves.
theorem Node::run_holds(self node: Node, values, after: Valuation(), before: Buffers()):
    ((w: Nat) → after(w, node_output(node).id) = node.run(values, before).values(w, node_output(node).id)) →
    ((w: Nat) → (id: Nat) → Mem(id, node.reads()) → after(w, id) = values(w, id)) → node.defined(values).IsTrue() →
    node.Runs(after, before, node.run(values, before).buffers) {
    match stores: node.stores() {
        False => λ at_output kept defined =>
            node.run_holds_quiet(values, after, before, j(sym(stores), λ b _ => (!b).IsTrue(), trivial), at_output, kept, defined),
        True => (match node as λ n => n.stores() = True →
                ((w: Nat) → after(w, node_output(n).id) = n.run(values, before).values(w, node_output(n).id)) →
                ((w: Nat) → (id: Nat) → Mem(id, n.reads()) → after(w, id) = values(w, id)) → n.defined(values).IsTrue() →
                n.Runs(after, before, n.run(values, before).buffers) {
            BufferStore(output, buffer, index, value) => λ _ at_output kept _ => {
                let mid = store_byte(before, buffer, values(64, index).toNat(), low_byte(values(64, value)));
                let at_index: (after(64, index) = values(64, index)) = kept(64, index, Inl(refl));
                let at_value: (after(64, value) = values(64, value)) = kept(64, value, Inr(Inl(refl)));
                let stored: (mid = store_byte(before, buffer, after(64, index).toNat(), low_byte(after(64, value)))) =
                    sym(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => store_byte(before, buffer, x.toNat(), low_byte(y)), at_index, at_value));
                let named: (after(64, output) = byte_word(buffer_byte(mid, buffer, after(64, index).toNat()))) = trans(at_output(64),
                    trans(Valuation::set_here(values, output, load_value(mid, buffer, index, values), 64),
                        trans(word_value_word(byte_word(buffer_byte(mid, buffer, values(64, index).toNat()))),
                            sym(cong_fn(λ (x: BitVec(64)) => byte_word(buffer_byte(mid, buffer, x.toNat())), at_index)))));
                ⟨stored, named⟩
            },
            WideStore(bytes, output, buffer, index, value) => λ _ at_output kept _ => {
                let mid = store_word(before, buffer, values(64, index).toNat(), bytes, values(8 * bytes, value));
                let at_index: (after(64, index) = values(64, index)) = kept(64, index, Inl(refl));
                let at_value: (after(8 * bytes, value) = values(8 * bytes, value)) = kept(8 * bytes, value, Inr(Inl(refl)));
                let stored: (mid = store_word(before, buffer, after(64, index).toNat(), bytes, after(8 * bytes, value))) =
                    sym(eq2(λ (x: BitVec(64)) (y: BitVec(8 * bytes)) => store_word(before, buffer, x.toNat(), bytes, y), at_index, at_value));
                let named: (after(8 * bytes, output) = buffer_word(mid, buffer, after(64, index).toNat(), bytes)) = trans(at_output(8 * bytes),
                    trans(Valuation::set_here(values, output, wide_value(mid, buffer, index, bytes, values), 8 * bytes),
                        trans(BitVec::ofNat_toNat(8 * bytes, buffer_word(mid, buffer, values(64, index).toNat(), bytes)),
                            sym(cong_fn(λ (x: BitVec(64)) => buffer_word(mid, buffer, x.toNat(), bytes), at_index)))));
                ⟨stored, named⟩
            },
            _ => λ no _ _ _ => absurd(no),
        })(stores),
    }
}

// ---------------------------------------------------------------------------
// Schedules of nodes

theorem run_nodes_frame(nodes: List<Node>): (values: Valuation()) → (buffers: Buffers()) → (w, id: Nat) →
    absent(id, nodes_writes(nodes)).IsTrue() → run_nodes(nodes, values, buffers).values(w, id) = values(w, id) {
    match nodes {
        Nil => λ values buffers w id _ => refl,
        Cons(node, rest) => λ values buffers w id h => {
            let parts = Bool::is_true_and(id.differs(node_output(node).id), absent(id, nodes_writes(rest)), h);
            let stepped = node.run(values, buffers);
            trans(run_nodes_frame(rest, stepped.values, stepped.buffers, w, id, parts.right),
                node.run_frame(values, buffers, w, id, id.differs_ne(node_output(node).id, parts.left)))
        },
    }
}

// Any valuation agreeing with the run's on what the nodes mention runs
// them, from the file to the one the run leaves.
theorem run_nodes_holds(nodes: List<Node>): nodes_evaluable(nodes).IsTrue() → (values, after: Valuation()) → (before: Buffers()) →
    ((w: Nat) → (id: Nat) → Mem(id, nodes_mentions(nodes)) → after(w, id) = run_nodes(nodes, values, before).values(w, id)) →
    run_nodes_defined(nodes, values, before).IsTrue() → NodesRun(nodes, after, before, run_nodes(nodes, values, before).buffers) {
    match nodes {
        Nil => λ _ values after before _ _ => refl,
        Cons(node, rest) => λ ok values after before agree defined => {
            let output = node_output(node).id;
            let parts = Bool::is_true_and(absent(output, node.reads()),
                disjoint(nodes_writes(rest), node.mentions()) && nodes_evaluable(rest), ok);
            let later = Bool::is_true_and(disjoint(nodes_writes(rest), node.mentions()), nodes_evaluable(rest), parts.right);
            let stepped = node.run(values, before);
            let at_output = λ (w: Nat) => trans(agree(w, output, List::mem_append_l(node.mentions(), nodes_mentions(rest), output, Inl(refl))),
                run_nodes_frame(rest, stepped.values, stepped.buffers, w, output,
                    disjoint_mem(nodes_writes(rest), node.mentions(), later.left, output, Inl(refl))));
            let kept = λ (w: Nat) (id: Nat) (m: Mem(id, node.reads())) =>
                trans(agree(w, id, List::mem_append_l(node.mentions(), nodes_mentions(rest), id, Inr(m))),
                    trans(run_nodes_frame(rest, stepped.values, stepped.buffers, w, id,
                            disjoint_mem(nodes_writes(rest), node.mentions(), later.left, id, Inr(m))),
                        node.run_frame(values, before, w, id, λ e => absent_mem(output, node.reads(), parts.left, id, m, sym(e)))));
            let both = Bool::is_true_and(node.defined(values), run_nodes_defined(rest, stepped.values, stepped.buffers), defined);
            Exists(stepped.buffers, ⟨node.run_holds(values, after, before, at_output, kept, both.left),
                run_nodes_holds(rest, later.right, stepped.values, after, stepped.buffers,
                    λ w id m => agree(w, id, List::mem_append_r(node.mentions(), nodes_mentions(rest), id, m)), both.right)⟩)
        },
    }
}

// ---------------------------------------------------------------------------
// Loops

// The loop's final state is a state: as many words as parameters.
theorem loop_run_len(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → (buffers: Buffers()) → state.len() = parameters.len() →
    loop_run(step, parameters, count, exit, next, remaining, state, buffers).end.state.len() = parameters.len() {
    match remaining {
        Zero => λ state buffers same => same,
        Succ(rest) => λ state buffers same => {
            let after = step(pass_valuation(parameters, count, rest + 1, state), buffers);
            let next_len: (words_of(after.values, next).len() = parameters.len()) = trans(words_of_len(after.values, next), lengths);
            match after.values(1, exit).head_bit() {
                False => loop_run_len(step, parameters, count, exit, next, lengths, rest, words_of(after.values, next), after.buffers, next_len),
                True => next_len,
            }
        },
    }
}

// What the loop runs to is a run of it over the file, when each pass's
// step runs the pass and keeps the parameters and the count.
theorem loop_run_runs(pass: Valuation() → Buffers() → Buffers() → Type, step: Valuation() → Buffers() → State,
    defined: Valuation() → Buffers() → Bool,
    holds: (v: Valuation()) → (file: Buffers()) → defined(v, file).IsTrue() → pass(step(v, file).values, file, step(v, file).buffers),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, apart: distinct(Cons(count, parameters)).IsTrue(),
    kept: (v: Valuation()) → (file: Buffers()) → (w, id: Nat) → Mem(id, Cons(count, parameters)) → step(v, file).values(w, id) = v(w, id),
    lengths: next.len() = parameters.len(), remaining: Nat):
    (state: List<BitVec(64)>) → (before: Buffers()) → state.len() = parameters.len() →
    loop_run_defined(step, defined, parameters, count, exit, next, remaining, state, before).IsTrue() →
    LoopRunsOver(pass, parameters, count, exit, next, remaining, state,
        loop_run(step, parameters, count, exit, next, remaining, state, before).end.state,
        loop_run(step, parameters, count, exit, next, remaining, state, before).end.exhausted, before,
        loop_run(step, parameters, count, exit, next, remaining, state, before).buffers) {
    match remaining {
        Zero => λ state before _ _ => ⟨refl, ⟨refl, refl⟩⟩,
        Succ(rest) => λ state before same all => {
            let parts = Bool::is_true_and(absent(count, parameters), distinct(parameters), apart);
            let counted = Valuation::set(Valuation::zero(), count, word_value(BitVec::ofNat(rest + 1)));
            let entered = pass_valuation(parameters, count, rest + 1, state);
            let after = step(entered, before);
            let bound: (words_of(after.values, parameters) = state) = trans(
                words_agree(parameters, entered, after.values, λ id m => kept(entered, before, 64, id, Inr(m))),
                words_of_bind(counted, parameters, parts.right, state, sym(same)));
            let at_count: (after.values(64, count) = BitVec::ofNat(rest + 1)) = trans(kept(entered, before, 64, count, Inl(refl)),
                trans(Valuation::bind_frame(counted, parameters, state, 64, count, parts.left),
                    trans(Valuation::set_here(Valuation::zero(), count, word_value(BitVec::ofNat(rest + 1)), 64),
                        word_value_word(BitVec::ofNat(rest + 1)))));
            let next_len: (words_of(after.values, next).len() = parameters.len()) = trans(words_of_len(after.values, next), lengths);
            let halves = Bool::is_true_and(defined(entered, before), match after.values(1, exit).head_bit() {
                False => loop_run_defined(step, defined, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                True => True,
            }, all);
            Exists(after.values, Exists(after.buffers, ⟨bound, ⟨at_count, ⟨holds(entered, before, halves.left),
                (match after.values(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                        False => loop_run_defined(step, defined, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                        True => True,
                    }).IsTrue() → match b as λ _ => Type {
                    False => LoopRunsOver(pass, parameters, count, exit, next, rest, words_of(after.values, next),
                        (match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.state,
                        (match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.exhausted, after.buffers,
                        (match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).buffers),
                    True => ((match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.state =
                            words_of(after.values, next)) ∧
                        (((match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.exhausted = False) ∧
                        ((match b as λ _ => LoopState {
                            False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).buffers = after.buffers)),
                } {
                    False => λ later => loop_run_runs(pass, step, defined, holds, parameters, count, exit, next, apart, kept, lengths, rest,
                        words_of(after.values, next), after.buffers, next_len, later),
                    True => λ _ => ⟨refl, ⟨refl, refl⟩⟩,
                })(halves.right)⟩⟩⟩))
        },
    }
}

theorem until_run_len(step: Valuation() → Buffers() → State, parameters: List<Nat>, exit: Nat, next: List<Nat>,
    lengths: next.len() = parameters.len(), fuel: Nat):
    (state: List<BitVec(64)>) → (buffers: Buffers()) → state.len() = parameters.len() →
    until_run(step, parameters, exit, next, fuel, state, buffers).end.state.len() = parameters.len() {
    match fuel {
        Zero => λ state buffers same => same,
        Succ(rest) => λ state buffers same => {
            let after = step(until_valuation(parameters, state), buffers);
            let next_len: (words_of(after.values, next).len() = parameters.len()) = trans(words_of_len(after.values, next), lengths);
            match after.values(1, exit).head_bit() {
                False => until_run_len(step, parameters, exit, next, lengths, rest, words_of(after.values, next), after.buffers, next_len),
                True => next_len,
            }
        },
    }
}

// What an unbounded loop runs to, where it leaves within its fuel, is a run
// of it over the file.
theorem until_run_runs(pass: Valuation() → Buffers() → Buffers() → Type, step: Valuation() → Buffers() → State,
    defined: Valuation() → Buffers() → Bool,
    holds: (v: Valuation()) → (file: Buffers()) → defined(v, file).IsTrue() → pass(step(v, file).values, file, step(v, file).buffers),
    parameters: List<Nat>, exit: Nat, next: List<Nat>, apart: distinct(parameters).IsTrue(),
    kept: (v: Valuation()) → (file: Buffers()) → (w, id: Nat) → Mem(id, parameters) → step(v, file).values(w, id) = v(w, id),
    lengths: next.len() = parameters.len(), fuel: Nat):
    (state: List<BitVec(64)>) → (before: Buffers()) → state.len() = parameters.len() →
    until_run_defined(step, defined, parameters, exit, next, fuel, state, before).IsTrue() →
    UntilRunsOver(pass, parameters, exit, next, fuel, state, until_run(step, parameters, exit, next, fuel, state, before).end.state, before,
        until_run(step, parameters, exit, next, fuel, state, before).buffers) {
    match fuel {
        Zero => λ state before _ never => false_elim(never),
        Succ(rest) => λ state before same all => {
            let entered = until_valuation(parameters, state);
            let after = step(entered, before);
            let bound: (words_of(after.values, parameters) = state) = trans(
                words_agree(parameters, entered, after.values, λ id m => kept(entered, before, 64, id, m)),
                words_of_bind(Valuation::zero(), parameters, apart, state, sym(same)));
            let next_len: (words_of(after.values, next).len() = parameters.len()) = trans(words_of_len(after.values, next), lengths);
            let halves = Bool::is_true_and(defined(entered, before), match after.values(1, exit).head_bit() {
                False => until_run_defined(step, defined, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                True => True,
            }, all);
            Exists(after.values, Exists(after.buffers, ⟨bound, ⟨holds(entered, before, halves.left),
                (match after.values(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                        False => until_run_defined(step, defined, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                        True => True,
                    }).IsTrue() → match b as λ _ => Type {
                    False => UntilRunsOver(pass, parameters, exit, next, rest, words_of(after.values, next),
                        (match b as λ _ => LoopState {
                            False => until_run(step, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.state, after.buffers,
                        (match b as λ _ => LoopState {
                            False => until_run(step, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).buffers),
                    True => ((match b as λ _ => LoopState {
                            False => until_run(step, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).end.state =
                            words_of(after.values, next)) ∧
                        ((match b as λ _ => LoopState {
                            False => until_run(step, parameters, exit, next, rest, words_of(after.values, next), after.buffers),
                            True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers) }).buffers = after.buffers),
                } {
                    False => λ later => until_run_runs(pass, step, defined, holds, parameters, exit, next, apart, kept, lengths, rest,
                        words_of(after.values, next), after.buffers, next_len, later),
                    True => λ _ => ⟨refl, refl⟩,
                })(halves.right)⟩⟩))
        },
    }
}

// ---------------------------------------------------------------------------
// Structured regions

// Running keeps every id the region does not write.
theorem StructuredRegion::run_keeps(self region: StructuredRegion, call: Writers()): (values: Valuation()) →
    (buffers: Buffers()) → (w, id: Nat) → absent(id, region.writes()).IsTrue() →
    region.run(call, values, buffers).values(w, id) = values(w, id) {
    match region {
        Dataflow(body) => λ values buffers w id h => run_nodes_frame(body.nodes, values, buffers, w, id, h),
        Sequence(prefix, continuation) => λ values buffers w id h => {
            let parts = absent_append(id, nodes_writes(prefix.nodes), continuation.writes(), h);
            let first = run_nodes(prefix.nodes, values, buffers);
            trans(continuation.run_keeps(call, first.values, first.buffers, w, id, parts.right),
                run_nodes_frame(prefix.nodes, values, buffers, w, id, parts.left))
        },
        Compose(prefix, continuation) => λ values buffers w id h => {
            let parts = absent_append(id, prefix.writes(), continuation.writes(), h);
            let first = prefix.run(call, values, buffers);
            trans(continuation.run_keeps(call, first.values, first.buffers, w, id, parts.right),
                prefix.run_keeps(call, values, buffers, w, id, parts.left))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values buffers w id h => {
            let parts = absent_append(id, when_true.writes(), when_false.writes(), h);
            match values(1, condition).head_bit() {
                False => when_false.run_keeps(call, values, buffers, w, id, parts.right),
                True => when_true.run_keeps(call, values, buffers, w, id, parts.left),
            }
        },
        Lend(views, callee, arguments, result) => λ values buffers w id h => {
            let nodes = views_nodes(views);
            let first = run_nodes(nodes, values, buffers);
            let parts = absent_append(id, nodes_writes(nodes), [result], h);
            trans(Valuation::set_other(first.values, result,
                    word_value(call(viewed(views, first.values, first.buffers), callee, words_of(first.values, views_homes(views) ++ arguments)).word), w, id,
                    id.differs_ne(result, Bool::is_true_and(id.differs(result), True, parts.right).left)),
                run_nodes_frame(nodes, values, buffers, w, id, parts.left))
        },
        Call(callee, arguments, result, also) => λ values buffers w id h =>
            Valuation::bind_frame(values, Cons(result, also), Cons(call(buffers, callee, words_of(values, arguments)).word,
                call(buffers, callee, words_of(values, arguments)).rest), w, id, h),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values buffers w id h => {
            let end = loop_run(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs), buffers);
            let parts = Bool::is_true_and(id.differs(exhausted), absent(id, outputs), h);
            trans(Valuation::set_other(Valuation::bind(values, outputs, end.end.state), exhausted, bit_value(end.end.exhausted), w, id,
                    id.differs_ne(exhausted, parts.left)),
                Valuation::bind_frame(values, outputs, end.end.state, w, id, parts.right))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ values buffers w id h =>
            Valuation::bind_frame(values, outputs, until_run(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held), parameters, exit,
                next, until_passes(), words_of(values, inputs), buffers).end.state, w, id, h),
    }
}

// The theorem: when every call a region makes is answered by a word and a
// file its callee may return and leave, any valuation agreeing with the
// run's on what the region mentions runs the region, from the file to the
// one the run leaves.
theorem StructuredRegion::run_holds(self region: StructuredRegion, effects: Effects(), call: Writers(),
    defines: RunDefines(), arity: Nat → Option<Nat>,
    answers: (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() →
        defines(file, f, words).IsTrue() → effects(file, f, words, call(file, f, words).word, call(file, f, words).rest, call(file, f, words).buffers)):
    region.evaluable(arity).IsTrue() → (values, after: Valuation()) → (before: Buffers()) →
    ((w: Nat) → (id: Nat) → Mem(id, region.mentions()) → after(w, id) = region.run(call, values, before).values(w, id)) →
    region.run_defined(call, defines, values, before).IsTrue() → StructuredRegionRunsOver(effects, after, region, before, region.run(call, values, before).buffers) {
    match region {
        Dataflow(body) => λ ok values after before agree defined => run_nodes_holds(body.nodes, ok, values, after, before, agree, defined),
        Sequence(prefix, continuation) => λ ok values after before agree defined => {
            let parts = Bool::is_true_and(nodes_evaluable(prefix.nodes),
                disjoint(continuation.writes(), nodes_mentions(prefix.nodes)) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), nodes_mentions(prefix.nodes)), continuation.evaluable(arity), parts.right);
            let first = run_nodes(prefix.nodes, values, before);
            let both = Bool::is_true_and(run_nodes_defined(prefix.nodes, values, before),
                continuation.run_defined(call, defines, first.values, first.buffers), defined);
            Exists(first.buffers, ⟨run_nodes_holds(prefix.nodes, parts.left, values, after, before, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)),
                        continuation.run_keeps(call, first.values, first.buffers, w, id,
                            disjoint_mem(continuation.writes(), nodes_mentions(prefix.nodes), later.left, id, m))), both.left),
                continuation.run_holds(effects, call, defines, arity, answers, later.right, first.values, after, first.buffers, λ w id m =>
                    agree(w, id, List::mem_append_r(nodes_mentions(prefix.nodes), continuation.mentions(), id, m)), both.right)⟩)
        },
        Compose(prefix, continuation) => λ ok values after before agree defined => {
            let parts = Bool::is_true_and(prefix.evaluable(arity),
                disjoint(continuation.writes(), prefix.mentions()) && continuation.evaluable(arity), ok);
            let later = Bool::is_true_and(disjoint(continuation.writes(), prefix.mentions()), continuation.evaluable(arity), parts.right);
            let first = prefix.run(call, values, before);
            let both = Bool::is_true_and(prefix.run_defined(call, defines, values, before),
                continuation.run_defined(call, defines, first.values, first.buffers), defined);
            Exists(first.buffers, ⟨prefix.run_holds(effects, call, defines, arity, answers, parts.left, values, after, before, λ w id m =>
                    trans(agree(w, id, List::mem_append_l(prefix.mentions(), continuation.mentions(), id, m)),
                        continuation.run_keeps(call, first.values, first.buffers, w, id,
                            disjoint_mem(continuation.writes(), prefix.mentions(), later.left, id, m))), both.left),
                continuation.run_holds(effects, call, defines, arity, answers, later.right, first.values, after, first.buffers, λ w id m =>
                    agree(w, id, List::mem_append_r(prefix.mentions(), continuation.mentions(), id, m)), both.right)⟩)
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ ok values after before agree defined => {
            let parts = Bool::is_true_and(absent(condition, when_true.writes() ++ when_false.writes()),
                when_true.evaluable(arity) && when_false.evaluable(arity), ok);
            let arms = Bool::is_true_and(when_true.evaluable(arity), when_false.evaluable(arity), parts.right);
            let kept: (after(1, condition) = values(1, condition)) = trans(agree(1, condition, Inl(refl)),
                Conditional(inputs, condition, arguments, outputs, when_true, when_false).run_keeps(call, values, before, 1, condition,
                    parts.left));
            let chosen = (match values(1, condition).head_bit() as λ b =>
                    ((w: Nat) → (id: Nat) → Mem(id, Cons(condition, when_true.mentions() ++ when_false.mentions())) →
                        after(w, id) = (match b {
                            False => when_false.run(call, values, before).values(w, id),
                            True => when_true.run(call, values, before).values(w, id),
                        })) →
                    (match b {
                        False => when_false.run_defined(call, defines, values, before),
                        True => when_true.run_defined(call, defines, values, before),
                    }).IsTrue() →
                    (match b {
                        False => StructuredRegionRunsOver(effects, after, when_false, before, match b {
                            False => when_false.run(call, values, before).buffers,
                            True => when_true.run(call, values, before).buffers,
                        }),
                        True => StructuredRegionRunsOver(effects, after, when_true, before, match b {
                            False => when_false.run(call, values, before).buffers,
                            True => when_true.run(call, values, before).buffers,
                        }),
                    }) {
                False => λ chose here => when_false.run_holds(effects, call, defines, arity, answers, arms.right, values, after, before, λ w id m =>
                    chose(w, id, Inr(List::mem_append_r(when_true.mentions(), when_false.mentions(), id, m))), here),
                True => λ chose here => when_true.run_holds(effects, call, defines, arity, answers, arms.left, values, after, before, λ w id m =>
                    chose(w, id, Inr(List::mem_append_l(when_true.mentions(), when_false.mentions(), id, m))), here),
            })(agree, defined);
            j(sym(kept), λ x _ => match x.head_bit() {
                False => StructuredRegionRunsOver(effects, after, when_false, before, match values(1, condition).head_bit() {
                    False => when_false.run(call, values, before).buffers,
                    True => when_true.run(call, values, before).buffers,
                }),
                True => StructuredRegionRunsOver(effects, after, when_true, before, match values(1, condition).head_bit() {
                    False => when_false.run(call, values, before).buffers,
                    True => when_true.run(call, values, before).buffers,
                }),
            }, chosen)
        },
        // The windows and what is put back are read at the lend's own nodes'
        // values, where the two valuations agree.
        Lend(views, callee, arguments, result) => λ ok values after before agree defined => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let parts = Bool::is_true_and(nodes_evaluable(nodes),
                disjoint([result], nodes_mentions(nodes)) && (absent(result, args) && arity_fits(arity(callee), args.len())), ok);
            let later = Bool::is_true_and(disjoint([result], nodes_mentions(nodes)), absent(result, args) && arity_fits(arity(callee), args.len()),
                parts.right);
            let last = Bool::is_true_and(absent(result, args), arity_fits(arity(callee), args.len()), later.right);
            let first = run_nodes(nodes, values, before);
            let file = viewed(views, first.values, first.buffers);
            let words = words_of(first.values, args);
            let answer = call(file, callee, words);
            let at_nodes = λ (w: Nat) (id: Nat) (m: Mem(id, nodes_mentions(nodes))) =>
                trans(agree(w, id, List::mem_append_l(nodes_mentions(nodes), Cons(result, args), id, m)),
                    Valuation::set_other(first.values, result, word_value(answer.word), w, id, id.differs_ne(result,
                        Bool::is_true_and(id.differs(result), True, disjoint_mem([result], nodes_mentions(nodes), later.left, id, m)).left)));
            let at_result: (after(64, result) = answer.word) = trans(agree(64, result, List::mem_append_r(nodes_mentions(nodes), Cons(result, args), result, Inl(refl))),
                trans(Valuation::set_here(first.values, result, word_value(answer.word), 64), word_value_word(answer.word)));
            let read: (words_of(after, args) = words) = words_agree(args, first.values, after, λ id m =>
                trans(agree(64, id, List::mem_append_r(nodes_mentions(nodes), Cons(result, args), id, Inr(m))),
                    Valuation::set_other(first.values, result, word_value(answer.word), 64, id, λ e => absent_mem(result, args, last.left, id, m, sym(e)))));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(first.values, args)), λ n _ => arity_fits(arity(callee), n).IsTrue(), last.right);
            let lent: (viewed(views, after, first.buffers) = file) = viewed_agree(views, first.values, after, first.buffers, λ id m => at_nodes(64, id, m));
            let put: (put_views(views, after, answer.buffers, first.buffers) = put_views(views, first.values, answer.buffers, first.buffers)) =
                put_views_agree(views, first.values, after, λ id m => at_nodes(64, id, m), answer.buffers, first.buffers);
            let both = Bool::is_true_and(run_nodes_defined(nodes, values, before), defines(file, callee, words), defined);
            Exists(first.buffers, ⟨run_nodes_holds(nodes, parts.left, values, after, before, at_nodes, both.left),
                Exists(answer.buffers, ⟨Exists(answer.rest, j(sym(lent), λ held _ => effects(held, callee, words_of(after, args), after(64, result), answer.rest, answer.buffers),
                    j(sym(read), λ ws _ => effects(file, callee, ws, after(64, result), answer.rest, answer.buffers),
                        j(sym(at_result), λ r _ => effects(file, callee, words, r, answer.rest, answer.buffers), answers(file, callee, words, fits, both.right))))), sym(put)⟩)⟩)
        },
        Call(callee, arguments, result, also) => λ ok values after before agree defined => {
            let outs = Cons(result, also);
            let parts = Bool::is_true_and(distinct(outs), disjoint(outs, arguments) && arity_fits(arity(callee), arguments.len()), ok);
            let later = Bool::is_true_and(disjoint(outs, arguments), arity_fits(arity(callee), arguments.len()), parts.right);
            let words = words_of(values, arguments);
            let answer = call(before, callee, words);
            let given = Cons(answer.word, answer.rest);
            let asked = Bool::is_true_and(defines(before, callee, words), answer.rest.len().matches(also.len()), defined);
            let bound = Valuation::bind(values, outs, given);
            let written: (words_of(after, outs) = given) = trans(
                words_agree(outs, bound, after, λ id m => agree(64, id, List::mem_append_l(outs, arguments, id, m))),
                words_of_bind(values, outs, parts.left, given,
                    cong_fn(λ (n: Nat) => n + 1, sym(answer.rest.len().matches_eq(also.len(), asked.right)))));
            let parted = words_cons_parts(after(64, result), words_of(after, also), given, written);
            let read: (words_of(after, arguments) = words) = words_agree(arguments, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_r(outs, arguments, id, m)),
                    Valuation::bind_frame(values, outs, given, 64, id, disjoint_mem(outs, arguments, later.left, id, m))));
            let fits: arity_fits(arity(callee), words.len()).IsTrue() =
                j(sym(words_of_len(values, arguments)), λ n _ => arity_fits(arity(callee), n).IsTrue(), later.right);
            j(sym(read), λ ws _ => effects(before, callee, ws, after(64, result), words_of(after, also), answer.buffers),
                j(sym(parted.right), λ t _ => effects(before, callee, words, after(64, result), t, answer.buffers),
                    j(sym(parted.left), λ r _ => effects(before, callee, words, r, answer.rest, answer.buffers),
                        answers(before, callee, words, fits, asked.left))))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ ok values after before agree defined => {
            let pass = λ (v: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, v, body, from, to);
            let step = λ (v: Valuation()) (held: Buffers()) => body.run(call, v, held);
            let p1 = Bool::is_true_and(body.evaluable(arity), distinct(Cons(count, parameters)) && (disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            let p2 = Bool::is_true_and(distinct(Cons(count, parameters)), disjoint(body.writes(), Cons(count, parameters))
                && (distinct(Cons(exhausted, outputs)) && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))))), p1.right);
            let p3 = Bool::is_true_and(disjoint(body.writes(), Cons(count, parameters)), distinct(Cons(exhausted, outputs))
                && (disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))), p2.right);
            let p4 = Bool::is_true_and(distinct(Cons(exhausted, outputs)), disjoint(Cons(exhausted, outputs), Cons(bound, inputs))
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))), p3.right);
            let p5 = Bool::is_true_and(disjoint(Cons(exhausted, outputs), Cons(bound, inputs)), inputs.len().matches(parameters.len())
                && (next.len().matches(parameters.len()) && outputs.len().matches(parameters.len())), p4.right);
            let p6 = Bool::is_true_and(inputs.len().matches(parameters.len()),
                next.len().matches(parameters.len()) && outputs.len().matches(parameters.len()), p5.right);
            let p7 = Bool::is_true_and(next.len().matches(parameters.len()), outputs.len().matches(parameters.len()), p6.right);
            let outs = Bool::is_true_and(absent(exhausted, outputs), distinct(outputs), p4.left);
            let in_len: (words_of(values, inputs).len() = parameters.len()) =
                trans(words_of_len(values, inputs), inputs.len().matches_eq(parameters.len(), p6.left));
            let next_len: (next.len() = parameters.len()) = next.len().matches_eq(parameters.len(), p7.left);
            let n = values(64, bound).toNat();
            let start = words_of(values, inputs);
            let end = loop_run(step, parameters, count, exit, next, n, start, before);
            let region = Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted);
            let bound_after: (after(64, bound) = values(64, bound)) = trans(agree(64, bound, Inl(refl)),
                region.run_keeps(call, values, before, 64, bound,
                    disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, bound, Inl(refl))));
            let inputs_after: (words_of(after, inputs) = start) = words_agree(inputs, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_l(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                    region.run_keeps(call, values, before, 64, id,
                        disjoint_mem(Cons(exhausted, outputs), Cons(bound, inputs), p5.left, id, Inr(m)))));
            let bound_values = Valuation::bind(values, outputs, end.end.state);
            let outputs_after: (words_of(after, outputs) = end.end.state) = trans(
                words_agree(outputs, bound_values, after, λ id m =>
                    trans(agree(64, id, List::mem_append_r(Cons(bound, inputs), Cons(exhausted, outputs), id, Inr(m))),
                        Valuation::set_other(bound_values, exhausted, bit_value(end.end.exhausted), 64, id,
                            λ e => absent_mem(exhausted, outputs, outs.left, id, m, sym(e))))),
                words_of_bind(values, outputs, outs.right, end.end.state,
                    trans(outputs.len().matches_eq(parameters.len(), p7.right),
                        sym(loop_run_len(step, parameters, count, exit, next, next_len, n, start, before, in_len)))));
            let exhausted_after: (after(1, exhausted).head_bit() = end.end.exhausted) = trans(
                cong_fn<BitVec(1), Bool>(λ x => x.head_bit(), trans(agree(1, exhausted, List::mem_append_r(Cons(bound, inputs),
                    Cons(exhausted, outputs), exhausted, Inl(refl))),
                    trans(Valuation::set_here(bound_values, exhausted, bit_value(end.end.exhausted), 1), bit_value_bit(end.end.exhausted)))),
                BitVec::head_bit_ofBool(end.end.exhausted));
            let runs = loop_run_runs(pass, step, λ (v: Valuation()) (file: Buffers()) => body.run_defined(call, defines, v, file),
                λ v file here => body.run_holds(effects, call, defines, arity, answers, p1.left, v, body.run(call, v, file).values, file,
                    λ w id m => refl, here),
                parameters, count, exit, next, p2.left,
                λ v file w id m => body.run_keeps(call, v, file, w, id,
                    disjoint_mem(body.writes(), Cons(count, parameters), p3.left, id, m)),
                next_len, n, start, before, in_len, defined);
            j(sym(exhausted_after), λ x _ => LoopRunsOver(pass, parameters, count, exit, next, after(64, bound).toNat(), words_of(after, inputs),
                    words_of(after, outputs), x, before, end.buffers),
                j(sym(outputs_after), λ x _ => LoopRunsOver(pass, parameters, count, exit, next, after(64, bound).toNat(),
                        words_of(after, inputs), x, end.end.exhausted, before, end.buffers),
                    j(sym(inputs_after), λ x _ => LoopRunsOver(pass, parameters, count, exit, next, after(64, bound).toNat(), x,
                            end.end.state, end.end.exhausted, before, end.buffers),
                        j(sym(bound_after), λ x _ => LoopRunsOver(pass, parameters, count, exit, next, x.toNat(), start, end.end.state,
                                end.end.exhausted, before, end.buffers),
                            runs))))
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ ok values after before agree defined => {
            let pass = λ (v: Valuation()) (from: Buffers()) (to: Buffers()) => StructuredRegionRunsOver(effects, v, body, from, to);
            let step = λ (v: Valuation()) (held: Buffers()) => body.run(call, v, held);
            let p1 = Bool::is_true_and(body.evaluable(arity), distinct(parameters) && (disjoint(body.writes(), parameters)
                && (distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))))), ok);
            let p2 = Bool::is_true_and(distinct(parameters), disjoint(body.writes(), parameters)
                && (distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))))), p1.right);
            let p3 = Bool::is_true_and(disjoint(body.writes(), parameters), distinct(outputs) && (disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len())))), p2.right);
            let p4 = Bool::is_true_and(distinct(outputs), disjoint(outputs, inputs)
                && (inputs.len().matches(parameters.len()) && (next.len().matches(parameters.len())
                && outputs.len().matches(parameters.len()))), p3.right);
            let p5 = Bool::is_true_and(disjoint(outputs, inputs), inputs.len().matches(parameters.len())
                && (next.len().matches(parameters.len()) && outputs.len().matches(parameters.len())), p4.right);
            let p6 = Bool::is_true_and(inputs.len().matches(parameters.len()),
                next.len().matches(parameters.len()) && outputs.len().matches(parameters.len()), p5.right);
            let p7 = Bool::is_true_and(next.len().matches(parameters.len()), outputs.len().matches(parameters.len()), p6.right);
            let in_len: (words_of(values, inputs).len() = parameters.len()) =
                trans(words_of_len(values, inputs), inputs.len().matches_eq(parameters.len(), p6.left));
            let next_len: (next.len() = parameters.len()) = next.len().matches_eq(parameters.len(), p7.left);
            let start = words_of(values, inputs);
            let end = until_run(step, parameters, exit, next, until_passes(), start, before);
            let region = Until(inputs, parameters, body, exit, next, outputs);
            let inputs_after: (words_of(after, inputs) = start) = words_agree(inputs, values, after, λ id m =>
                trans(agree(64, id, List::mem_append_l(inputs, outputs, id, m)),
                    region.run_keeps(call, values, before, 64, id, disjoint_mem(outputs, inputs, p5.left, id, m))));
            let outputs_after: (words_of(after, outputs) = end.end.state) = trans(
                words_agree(outputs, Valuation::bind(values, outputs, end.end.state), after, λ id m =>
                    agree(64, id, List::mem_append_r(inputs, outputs, id, m))),
                words_of_bind(values, outputs, p4.left, end.end.state,
                    trans(outputs.len().matches_eq(parameters.len(), p7.right),
                        sym(until_run_len(step, parameters, exit, next, next_len, until_passes(), start, before, in_len)))));
            let runs = until_run_runs(pass, step, λ (v: Valuation()) (file: Buffers()) => body.run_defined(call, defines, v, file),
                λ v file here => body.run_holds(effects, call, defines, arity, answers, p1.left, v, body.run(call, v, file).values, file,
                    λ w id m => refl, here),
                parameters, exit, next, p2.left,
                λ v file w id m => body.run_keeps(call, v, file, w, id, disjoint_mem(body.writes(), parameters, p3.left, id, m)),
                next_len, until_passes(), start, before, in_len, defined);
            Exists(until_passes(), j(sym(outputs_after), λ x _ => UntilRunsOver(pass, parameters, exit, next, until_passes(),
                    words_of(after, inputs), x, before, end.buffers),
                j(sym(inputs_after), λ x _ => UntilRunsOver(pass, parameters, exit, next, until_passes(), x, end.end.state, before, end.buffers),
                    runs)))
        },
    }
}

// ---------------------------------------------------------------------------
// Functions and programs

// A function called on `arguments` over `buffers`: its result and the file
// its body leaves. The body is run once.
fn Function::run(self function: Function, call: Writers(), arguments: List<BitVec(64)>, buffers: Buffers()) → Ending {
    shared(function.body.run(call, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers),
        λ (end: State) => Ending(end.values(64, function.result), end.buffers, rest := words_of(end.values, function.also)))
}

// Whether the function's run at the arguments meets every requirement.
fn Function::run_defined(self function: Function, call: Writers(), defines: RunDefines(), arguments: List<BitVec(64)>,
    buffers: Buffers()) → Bool {
    function.body.run_defined(call, defines, Valuation::bind(Valuation::zero(), function.parameters, arguments), buffers)
}

// An evaluable function, its calls answered by what its callees may return
// and leave, may return and leave what it runs to.
theorem Function::run_runs(self function: Function, effects: Effects(), call: Writers(), defines: RunDefines(),
    arity: Nat → Option<Nat>,
    answers: (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() →
        defines(file, f, words).IsTrue() → effects(file, f, words, call(file, f, words).word, call(file, f, words).rest, call(file, f, words).buffers),
    ok: function.evaluable(arity).IsTrue(), arguments: List<BitVec(64)>, before: Buffers(),
    count: function.parameters.len() = arguments.len(), defined: function.run_defined(call, defines, arguments, before).IsTrue()):
    function.RunsBoth(effects, arguments, function.run(call, arguments, before).word, function.run(call, arguments, before).rest, before,
        function.run(call, arguments, before).buffers) {
    let parts = Bool::is_true_and(function.body.evaluable(arity),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok);
    let params = Bool::is_true_and(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), parts.right);
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    let end = function.body.run(call, bound, before);
    let read: (words_of(end.values, function.parameters) = arguments) = trans(
        words_agree(function.parameters, bound, end.values, λ id m =>
            function.body.run_keeps(call, bound, before, 64, id,
                disjoint_mem(function.body.writes(), function.parameters, params.right, id, m))),
        words_of_bind(Valuation::zero(), function.parameters, params.left, arguments, count));
    Exists(end.values, ⟨read, ⟨function.body.run_holds(effects, call, defines, arity, answers, parts.left, bound, end.values, before,
        λ w id _ => refl, defined), ⟨refl, refl⟩⟩⟩)
}

// Writers with function `k`'s row `own`, the others' rows `below`'s.
fn tie_writers(below: Writers(), k: Nat, own: Buffers() → List<BitVec(64)> → Ending) → Writers() {
    λ buffers f arguments => match f.eq_dec(k) { Inl(_) => own(buffers, arguments), Inr(_) => below(buffers, f, arguments) }
}

// What a function that calls itself (function `k`, over `below`) runs to
// `depth` levels deep: its body's run with its own calls answered one
// level down, and at no level a zero word and the file as it was
// (`Function::level_words`).
fn Function::level_run(self function: Function, below: Writers(), k, depth: Nat) → Buffers() → List<BitVec(64)> → Ending {
    match depth {
        Zero => λ buffers _ => Ending(BitVec::zero(), buffers),
        Succ(i) => λ buffers arguments => function.run(tie_writers(below, k, function.level_run(below, k, i)), arguments, buffers),
    }
}

fn Function::tied_writers(self function: Function, below: Writers(), k, depth: Nat) → Writers() {
    tie_writers(below, k, function.level_run(below, k, depth))
}

// What answers the function's calls where it is function `k` over `below`,
// at `levels` levels (`Function::answers_at`).
fn Function::writers_at(self function: Function, below: Writers(), k, levels: Nat) → Writers() {
    match levels { Zero => below, Succ(depth) => function.tied_writers(below, k, depth) }
}

fn tie_run_defines(below: RunDefines(), k: Nat, own: Buffers() → List<BitVec(64)> → Bool) → RunDefines() {
    λ buffers f arguments => match f.eq_dec(k) { Inl(_) => own(buffers, arguments), Inr(_) => below(buffers, f, arguments) }
}

// Whether the function's run is defined `depth` levels deep
// (`Function::level_defined`).
fn Function::level_run_defined(self function: Function, call: Writers(), below: RunDefines(), k, depth: Nat) → Buffers() → List<BitVec(64)> → Bool {
    match depth {
        Zero => λ _ _ => False,
        Succ(i) => λ buffers arguments => function.run_defined(function.tied_writers(call, k, i),
            tie_run_defines(below, k, function.level_run_defined(call, below, k, i)), arguments, buffers),
    }
}

fn Function::tied_run_defines(self function: Function, call: Writers(), below: RunDefines(), k, depth: Nat) → RunDefines() {
    tie_run_defines(below, k, function.level_run_defined(call, below, k, depth))
}

fn Function::run_defines_at(self function: Function, call: Writers(), below: RunDefines(), k, levels: Nat) → RunDefines() {
    match levels { Zero => below, Succ(depth) => function.tied_run_defines(call, below, k, depth) }
}

// The functions of a program, each answering its calls by the ones after
// it and, as deep as it has levels, by itself, over the one file:
// `program_eval_over` with the file threaded.
fn program_run(functions: List<Function>) → Writers() {
    match functions {
        Nil => λ buffers _ _ => Ending(BitVec::zero(), buffers),
        Cons(last, earlier) => λ buffers f arguments => match f.eq_dec(earlier.len()) {
            Inl(_) => last.run(last.writers_at(program_run(earlier), earlier.len(), last.levels), arguments, buffers),
            Inr(_) => program_run(earlier, buffers, f, arguments),
        },
    }
}

// The words a program's function returns past the first number its `also`.
theorem program_run_rest_len(functions: List<Function>): (buffers: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) →
    program_run(functions, buffers, f, words).rest.len() = program_outs(functions)(f) {
    match functions {
        Nil => λ _ _ _ => refl,
        Cons(last, earlier) => λ buffers f words => match f.eq_dec(earlier.len()) as λ d =>
            (match d as λ _ => Ending {
                Inl(_) => last.run(last.writers_at(program_run(earlier), earlier.len(), last.levels), words, buffers),
                Inr(_) => program_run(earlier, buffers, f, words),
            }).rest.len() = (match d as λ _ => Nat { Inl(_) => last.also.len(), Inr(_) => program_outs(earlier, f) }) {
            Inl(_) => words_of_len(last.body.run(last.writers_at(program_run(earlier), earlier.len(), last.levels),
                    Valuation::bind(Valuation::zero(), last.parameters, words), buffers).values,
                last.also),
            Inr(_) => program_run_rest_len(earlier, buffers, f, words),
        },
    }
}

// Whether each function of a program is defined at the words over the file,
// its calls asking the ones after it.
fn program_run_defined(functions: List<Function>) → RunDefines() {
    match functions {
        Nil => λ _ _ _ => True,
        Cons(last, earlier) => λ buffers f arguments => match f.eq_dec(earlier.len()) {
            Inl(_) => last.run_defined(last.writers_at(program_run(earlier), earlier.len(), last.levels),
                last.run_defines_at(program_run(earlier), program_run_defined(earlier), earlier.len(), last.levels), arguments, buffers),
            Inr(_) => program_run_defined(earlier, buffers, f, arguments),
        },
    }
}

// What answers the last function's calls in a program's run, and whether
// each is defined (`program_last_answers`).
fn program_last_writers(last: Function, earlier: List<Function>) → Writers() { last.writers_at(program_run(earlier), earlier.len(), last.levels) }

fn program_last_run_defines(last: Function, earlier: List<Function>) → RunDefines() {
    last.run_defines_at(program_run(earlier), program_run_defined(earlier), earlier.len(), last.levels)
}

theorem loop_run_defined_all(step: Valuation() → Buffers() → State, defined: Valuation() → Buffers() → Bool,
    all: (v: Valuation()) → (held: Buffers()) → defined(v, held).IsTrue(),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → (buffers: Buffers()) →
        loop_run_defined(step, defined, parameters, count, exit, next, remaining, state, buffers).IsTrue() {
    match remaining {
        Zero => λ _ _ => trivial,
        Succ(rest) => λ state buffers => {
            let before = pass_valuation(parameters, count, rest + 1, state);
            let after = step(before, buffers);
            Bool::is_true_and_intro(defined(before, buffers), match after.values(1, exit).head_bit() {
                    False => loop_run_defined(step, defined, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                    True => True,
                }, all(before, buffers),
                match after.values(1, exit).head_bit() as λ b => (match b as λ _ => Bool {
                    False => loop_run_defined(step, defined, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                    True => True,
                }).IsTrue() {
                    False => loop_run_defined_all(step, defined, all, parameters, count, exit, next, rest, words_of(after.values, next),
                        after.buffers),
                    True => trivial,
                })
        },
    }
}

theorem run_nodes_total_defined(nodes: List<Node>): nodes_total(nodes).IsTrue() → (values: Valuation()) → (buffers: Buffers()) →
    run_nodes_defined(nodes, values, buffers).IsTrue() {
    match nodes {
        Nil => λ _ _ _ => trivial,
        Cons(node, rest) => λ total values buffers => {
            let parts = Bool::is_true_and(node.total(), nodes_total(rest), total);
            let after = node.run(values, buffers);
            Bool::is_true_and_intro(node.defined(values), run_nodes_defined(rest, after.values, after.buffers),
                node.total_defined(values, parts.left), run_nodes_total_defined(rest, parts.right, after.values, after.buffers))
        },
    }
}

// A region whose nodes require nothing is defined in every run its
// callees are.
theorem StructuredRegion::total_run_defined(self region: StructuredRegion, call: Writers(), defines: RunDefines(),
    all: (held: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → defines(held, f, words).IsTrue(), outs: Nat → Nat,
    lens: (held: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → call(held, f, words).rest.len() = outs(f)):
    region.total_at(outs).IsTrue() → (values: Valuation()) → (buffers: Buffers()) → region.run_defined(call, defines, values, buffers).IsTrue() {
    match region {
        Dataflow(body) => λ total values buffers => run_nodes_total_defined(body.nodes, total, values, buffers),
        Sequence(prefix, continuation) => λ total values buffers => {
            let parts = Bool::is_true_and(nodes_total(prefix.nodes), continuation.total_at(outs), total);
            let after = run_nodes(prefix.nodes, values, buffers);
            Bool::is_true_and_intro(run_nodes_defined(prefix.nodes, values, buffers),
                continuation.run_defined(call, defines, after.values, after.buffers),
                run_nodes_total_defined(prefix.nodes, parts.left, values, buffers),
                continuation.total_run_defined(call, defines, all, outs, lens, parts.right, after.values, after.buffers))
        },
        Compose(prefix, continuation) => λ total values buffers => {
            let parts = Bool::is_true_and(prefix.total_at(outs), continuation.total_at(outs), total);
            let after = prefix.run(call, values, buffers);
            Bool::is_true_and_intro(prefix.run_defined(call, defines, values, buffers),
                continuation.run_defined(call, defines, after.values, after.buffers),
                prefix.total_run_defined(call, defines, all, outs, lens, parts.left, values, buffers),
                continuation.total_run_defined(call, defines, all, outs, lens, parts.right, after.values, after.buffers))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ total values buffers => {
            let parts = Bool::is_true_and(when_true.total_at(outs), when_false.total_at(outs), total);
            match values(1, condition).head_bit() as λ b => (match b as λ _ => Bool {
                False => when_false.run_defined(call, defines, values, buffers),
                True => when_true.run_defined(call, defines, values, buffers),
            }).IsTrue() {
                False => when_false.total_run_defined(call, defines, all, outs, lens, parts.right, values, buffers),
                True => when_true.total_run_defined(call, defines, all, outs, lens, parts.left, values, buffers),
            }
        },
        Lend(views, callee, arguments, _) => λ total values buffers => {
            let bound = run_nodes(views_nodes(views), values, buffers);
            Bool::is_true_and_intro(run_nodes_defined(views_nodes(views), values, buffers),
                defines(viewed(views, bound.values, bound.buffers), callee, words_of(bound.values, views_homes(views) ++ arguments)),
                run_nodes_total_defined(views_nodes(views), total, values, buffers),
                all(viewed(views, bound.values, bound.buffers), callee, words_of(bound.values, views_homes(views) ++ arguments)))
        },
        Call(callee, arguments, _, also) => λ total values buffers => Bool::is_true_and_intro(defines(buffers, callee, words_of(values, arguments)),
            call(buffers, callee, words_of(values, arguments)).rest.len().matches(also.len()), all(buffers, callee, words_of(values, arguments)),
            Nat::matches_of_eq(call(buffers, callee, words_of(values, arguments)).rest.len(), also.len(),
                trans(lens(buffers, callee, words_of(values, arguments)), outs(callee).matches_eq(also.len(), total)))),
        Loop(inputs, bound, parameters, count, body, exit, next, _, _) => λ total values buffers =>
            loop_run_defined_all(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held),
                λ (pass: Valuation()) (held: Buffers()) => body.run_defined(call, defines, pass, held),
                λ pass held => body.total_run_defined(call, defines, all, outs, lens, total, pass, held), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs), buffers),
        Until(_, _, _, _, _, _) => λ never values buffers => false_elim(never),
    }
}

theorem program_total_run_defined(functions: List<Function>): program_total(functions).IsTrue() →
    (buffers: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → program_run_defined(functions, buffers, f, words).IsTrue() {
    match functions {
        Nil => λ _ _ _ _ => trivial,
        Cons(last, earlier) => λ total buffers f words => {
            let parts = Bool::is_true_and(last.levels.matches(0) && last.body.total_at(program_outs(earlier)), program_total(earlier), total);
            let own = Bool::is_true_and(last.levels.matches(0), last.body.total_at(program_outs(earlier)), parts.left);
            let none: (0 = last.levels) = sym(last.levels.matches_eq(0, own.left));
            let ih = program_total_run_defined(earlier, parts.right);
            match f.eq_dec(earlier.len()) as λ d => (match d as λ _ => Bool {
                Inl(_) => last.run_defined(program_last_writers(last, earlier), program_last_run_defines(last, earlier), words, buffers),
                Inr(_) => program_run_defined(earlier, buffers, f, words),
            }).IsTrue() {
                Inl(_) => j(none, λ l _ => last.run_defined(last.writers_at(program_run(earlier), earlier.len(), l),
                        last.run_defines_at(program_run(earlier), program_run_defined(earlier), earlier.len(), l), words, buffers).IsTrue(),
                    last.body.total_run_defined(program_run(earlier), program_run_defined(earlier), ih, program_outs(earlier),
                        program_run_rest_len(earlier), own.right,
                        Valuation::bind(Valuation::zero(), last.parameters, words), buffers)),
                Inr(_) => ih(buffers, f, words),
            }
        },
    }
}

// A function's levels run as its effects: where the tables below answer
// each defined call with what its callee may return and leave, and the
// function at a depth does, so do the tables with the function's own
// number (`Function::tied_reads_at`).
theorem Function::tied_runs_at(self last: Function, may: Effects(), below: Writers(), defines: RunDefines(), arity: Nat → Option<Nat>, k: Nat,
    ih: (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() →
        defines(file, f, words).IsTrue() → may(file, f, words, below(file, f, words).word, below(file, f, words).rest, below(file, f, words).buffers),
    depth: Nat,
    own: (file: Buffers()) → (words: List<BitVec(64)>) → arity_fits(Some(last.parameters.len()), words.len()).IsTrue() →
        last.level_run_defined(below, defines, k, depth)(file, words).IsTrue() →
        last.level_runs(may, k, depth)(file, words, last.level_run(below, k, depth)(file, words).word, last.level_run(below, k, depth)(file, words).rest,
            last.level_run(below, k, depth)(file, words).buffers)):
    (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(tie(arity, k, Some(last.parameters.len()))(f), words.len()).IsTrue() →
    last.tied_run_defines(below, defines, k, depth)(file, f, words).IsTrue() →
    last.tied_effects(may, k, depth)(file, f, words, last.tied_writers(below, k, depth)(file, f, words).word,
        last.tied_writers(below, k, depth)(file, f, words).rest, last.tied_writers(below, k, depth)(file, f, words).buffers) {
    λ file f words => match f.eq_dec(k) as λ d =>
        arity_fits((match d as λ _ => Option<Nat> { Inl(_) => Some(last.parameters.len()), Inr(_) => arity(f) }), words.len()).IsTrue() →
        (match d as λ _ => Bool { Inl(_) => last.level_run_defined(below, defines, k, depth)(file, words), Inr(_) => defines(file, f, words) }).IsTrue() →
        (match d as λ _ => Type {
            Inl(_) => last.level_runs(may, k, depth)(file, words, (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).word,
                (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).rest,
                (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).buffers),
            Inr(_) => may(file, f, words, (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).word,
                (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).rest,
                (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(file, words), Inr(_) => below(file, f, words) }).buffers),
        }) {
        Inl(_) => own(file, words),
        Inr(_) => ih(file, f, words),
    }
}

// The function at each depth runs to what it may return and leave there.
theorem Function::level_runs_sound(self last: Function, may: Effects(), below: Writers(), defines: RunDefines(), arity: Nat → Option<Nat>, k: Nat,
    ih: (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() →
        defines(file, f, words).IsTrue() → may(file, f, words, below(file, f, words).word, below(file, f, words).rest, below(file, f, words).buffers),
    ok: last.evaluable(tie(arity, k, Some(last.parameters.len()))).IsTrue(), depth: Nat):
    (file: Buffers()) → (words: List<BitVec(64)>) → arity_fits(Some(last.parameters.len()), words.len()).IsTrue() →
    last.level_run_defined(below, defines, k, depth)(file, words).IsTrue() →
    last.level_runs(may, k, depth)(file, words, last.level_run(below, k, depth)(file, words).word, last.level_run(below, k, depth)(file, words).rest,
        last.level_run(below, k, depth)(file, words).buffers) {
    match depth {
        Zero => λ file words fits never => false_elim(never),
        Succ(i) => λ file words fits defined => last.run_runs(last.tied_effects(may, k, i), last.tied_writers(below, k, i),
            last.tied_run_defines(below, defines, k, i), tie(arity, k, Some(last.parameters.len())),
            last.tied_runs_at(may, below, defines, arity, k, ih, i, last.level_runs_sound(may, below, defines, arity, k, ih, ok, i)),
            ok, words, file, last.parameters.len().matches_eq(words.len(), fits), defined),
    }
}

// The same at its levels, none or some.
theorem Function::levels_runs(self last: Function, may: Effects(), below: Writers(), defines: RunDefines(), arity: Nat → Option<Nat>, k: Nat,
    ih: (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() →
        defines(file, f, words).IsTrue() → may(file, f, words, below(file, f, words).word, below(file, f, words).rest, below(file, f, words).buffers)):
    (levels: Nat) → last.evaluable(self_table(arity, k, levels, Some(last.parameters.len()))).IsTrue() →
    (file: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) →
    arity_fits(self_table(arity, k, levels, Some(last.parameters.len()))(f), words.len()).IsTrue() →
    last.run_defines_at(below, defines, k, levels)(file, f, words).IsTrue() →
    last.effects_at(may, k, levels)(file, f, words, last.writers_at(below, k, levels)(file, f, words).word,
        last.writers_at(below, k, levels)(file, f, words).rest, last.writers_at(below, k, levels)(file, f, words).buffers) {
    λ levels => match levels {
        Zero => λ _ => ih,
        Succ(depth) => λ ok => last.tied_runs_at(may, below, defines, arity, k, ih, depth,
            last.level_runs_sound(may, below, defines, arity, k, ih, ok, depth)),
    }
}

// The theorem for programs: what `program_run` answers a call of the right
// arity with, over a file, is a word the function may return and a file it
// may leave.
theorem program_run_effects(functions: List<Function>, ok: program_evaluable(functions).IsTrue()):
    (before: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → arity_fits(program_arity(functions, f), words.len()).IsTrue() →
    program_run_defined(functions, before, f, words).IsTrue() →
    program_effects(functions)(before, f, words, program_run(functions, before, f, words).word,
        program_run(functions, before, f, words).rest, program_run(functions, before, f, words).buffers) {
    match functions {
        Nil => λ before f words never _ => false_elim(never),
        Cons(last, earlier) => λ before f words => {
            let parts = Bool::is_true_and(last.evaluable(program_last_arity(last, earlier)), program_evaluable(earlier), ok);
            let ih = program_run_effects(earlier, parts.right);
            let below = program_run(earlier);
            let may = program_effects(earlier);
            let defines = program_run_defined(earlier);
            let tops = program_last_writers(last, earlier);
            let mays = last.effects_at(may, earlier.len(), last.levels);
            match f.eq_dec(earlier.len()) as λ d =>
                arity_fits(match d { Inl(_) => Some(last.parameters.len()), Inr(_) => program_arity(earlier, f) },
                    words.len()).IsTrue() →
                (match d as λ _ => Bool {
                    Inl(_) => last.run_defined(tops, program_last_run_defines(last, earlier), words, before),
                    Inr(_) => defines(before, f, words),
                }).IsTrue() →
                (match d as λ _ => Type {
                    Inl(_) => last.RunsBoth(mays, words,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).word,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).rest, before,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).buffers),
                    Inr(_) => may(before, f, words,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).word,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).rest,
                        (match d as λ _ => Ending { Inl(_) => last.run(tops, words, before), Inr(_) => below(before, f, words) }).buffers),
                }) {
                Inl(_) => λ fits defined => last.run_runs(mays, tops, program_last_run_defines(last, earlier), program_last_arity(last, earlier),
                    last.levels_runs(may, below, defines, program_arity(earlier), earlier.len(), ih, last.levels, parts.left),
                    parts.left, words, before, last.parameters.len().matches_eq(words.len(), fits), defined),
                Inr(_) => λ fits defined => ih(before, f, words, fits, defined),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A program that stores nothing

// Nodes that store nothing run as they evaluate over the file, and leave
// it.
theorem run_nodes_quiet(nodes: List<Node>): nodes_quiet(nodes).IsTrue() → (values: Valuation()) → (buffers: Buffers()) →
    run_nodes(nodes, values, buffers) = State(eval_nodes_over(buffers, nodes, values), buffers) {
    match nodes {
        Nil => λ _ values buffers => refl,
        Cons(node, rest) => λ quiet values buffers => {
            let parts = Bool::is_true_and(!node.stores(), nodes_quiet(rest), quiet);
            j(sym(node.run_step(values, buffers, parts.left)),
                λ s _ => run_nodes(rest, s.values, s.buffers) =
                    State(eval_nodes_over(buffers, rest, node.step(values, buffers := buffers)), buffers),
                run_nodes_quiet(rest, parts.right, node.step(values, buffers := buffers), buffers))
        },
    }
}

// Passes that run as they evaluate over a file, leaving it, make a loop
// that does.
theorem loop_run_quiet(run_step: Valuation() → Buffers() → State, step: Valuation() → Valuation(), buffers: Buffers(),
    same: (v: Valuation()) → run_step(v, buffers) = State(step(v), buffers), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    remaining: Nat): (state: List<BitVec(64)>) →
    loop_run(run_step, parameters, count, exit, next, remaining, state, buffers) =
        LoopState(loop_eval(step, parameters, count, exit, next, remaining, state), buffers) {
    match remaining {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let before = pass_valuation(parameters, count, rest + 1, state);
            let after = step(before);
            let ends = match after(1, exit).head_bit() as λ b =>
                    (match b as λ _ => LoopState {
                        False => loop_run(run_step, parameters, count, exit, next, rest, words_of(after, next), buffers),
                        True => LoopState(LoopEnd(words_of(after, next), False), buffers),
                    }) = LoopState(match b {
                        False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                        True => LoopEnd(words_of(after, next), False),
                    }, buffers) {
                False => loop_run_quiet(run_step, step, buffers, same, parameters, count, exit, next, rest, words_of(after, next)),
                True => refl,
            };
            j(sym(same(before)), λ s _ => (match s.values(1, exit).head_bit() as λ _ => LoopState {
                    False => loop_run(run_step, parameters, count, exit, next, rest, words_of(s.values, next), s.buffers),
                    True => LoopState(LoopEnd(words_of(s.values, next), False), s.buffers),
                }) = LoopState(match after(1, exit).head_bit() {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }, buffers), ends)
        },
    }
}

theorem until_run_quiet(run_step: Valuation() → Buffers() → State, step: Valuation() → Valuation(), buffers: Buffers(),
    same: (v: Valuation()) → run_step(v, buffers) = State(step(v), buffers), parameters: List<Nat>, exit: Nat, next: List<Nat>,
    fuel: Nat): (state: List<BitVec(64)>) →
    until_run(run_step, parameters, exit, next, fuel, state, buffers) =
        LoopState(until_eval(step, parameters, exit, next, fuel, state), buffers) {
    match fuel {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let before = until_valuation(parameters, state);
            let after = step(before);
            let ends = match after(1, exit).head_bit() as λ b =>
                    (match b as λ _ => LoopState {
                        False => until_run(run_step, parameters, exit, next, rest, words_of(after, next), buffers),
                        True => LoopState(LoopEnd(words_of(after, next), False), buffers),
                    }) = LoopState(match b {
                        False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                        True => LoopEnd(words_of(after, next), False),
                    }, buffers) {
                False => until_run_quiet(run_step, step, buffers, same, parameters, exit, next, rest, words_of(after, next)),
                True => refl,
            };
            j(sym(same(before)), λ s _ => (match s.values(1, exit).head_bit() as λ _ => LoopState {
                    False => until_run(run_step, parameters, exit, next, rest, words_of(s.values, next), s.buffers),
                    True => LoopState(LoopEnd(words_of(s.values, next), False), s.buffers),
                }) = LoopState(match after(1, exit).head_bit() {
                    False => until_eval(step, parameters, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }, buffers), ends)
        },
    }
}

// Whether every call a region makes is of a function `among` accepts.
fn StructuredRegion::calls_among(self region: StructuredRegion, among: Nat → Bool) → Bool {
    match region {
        Dataflow(_) => True,
        Sequence(_, continuation) => continuation.calls_among(among),
        Compose(prefix, continuation) => prefix.calls_among(among) && continuation.calls_among(among),
        Conditional(_, _, _, _, when_true, when_false) => when_true.calls_among(among) && when_false.calls_among(among),
        Lend(_, callee, _, _) => among(callee),
        Call(callee, _, _, _) => among(callee),
        Loop(_, _, _, _, body, _, _, _, _) => body.calls_among(among),
        Until(_, _, body, _, _, _) => body.calls_among(among),
    }
}

fn every_function(f: Nat) → Bool { True }
fn no_function(f: Nat) → Bool { False }

// The functions numbered below `base`: a program's functions that only
// read, where the ones that write are numbered after them.
fn functions_below(base: Nat) → Nat → Bool { λ f => (f + 1).leb(base) }

// Callees that leave every file as it was, asked only of the functions
// `among` accepts: what a region that stores nothing needs of the functions
// it calls, in a program where others write.
fn Writers::Still(call: Writers(), among: Nat → Bool) → Type {
    (held: Buffers()) → (f: Nat) → among(f).IsTrue() → (words: List<BitVec(64)>) → call(held, f, words).buffers = held
}

theorem Writers::still_none(call: Writers()): Writers::Still(call, no_function) { λ held f never words => false_elim(never) }

theorem Writers::quiet_still(call: Writers(), quiet: Writers::Quiet(call), among: Nat → Bool): Writers::Still(call, among) {
    λ held f _ words => quiet(held, f, words)
}

// Stillness among more functions is stillness among fewer.
theorem Writers::still_within(call: Writers(), among, wider: Nat → Bool, still: Writers::Still(call, wider),
    within: (f: Nat) → among(f).IsTrue() → wider(f).IsTrue()): Writers::Still(call, among) {
    λ held f ok words => still(held, f, within(f, ok), words)
}

theorem StructuredRegion::calls_among_every(self region: StructuredRegion): region.calls_among(every_function).IsTrue() {
    match region {
        Dataflow(_) => trivial,
        Sequence(_, continuation) => continuation.calls_among_every(),
        Compose(prefix, continuation) =>
            Bool::is_true_and_intro(prefix.calls_among(every_function), continuation.calls_among(every_function), prefix.calls_among_every(),
                continuation.calls_among_every()),
        Conditional(_, _, _, _, when_true, when_false) =>
            Bool::is_true_and_intro(when_true.calls_among(every_function), when_false.calls_among(every_function),
                when_true.calls_among_every(), when_false.calls_among_every()),
        Lend(_, _, _, _) => trivial,
        Call(_, _, _, _) => trivial,
        Loop(_, _, _, _, body, _, _, _, _) => body.calls_among_every(),
        Until(_, _, body, _, _, _) => body.calls_among_every(),
    }
}

// The theorem: a region that stores nothing, each call it makes over the
// file answered with `answers`' word and the file as it was, runs as it
// evaluates over the file, and leaves it. Stillness is asked only of the
// functions the region calls (`among`): the region of a pure term run
// beside functions that write (`rt_file_lower`).
theorem StructuredRegion::run_quiet_among(self region: StructuredRegion, call: Writers(), answers: Answers(), buffers: Buffers(),
    among: Nat → Bool,
    still: (f: Nat) → among(f).IsTrue() → (words: List<BitVec(64)>) → call(buffers, f, words) = Ending::of(answers(f, words), buffers)):
    region.quiet().IsTrue() → region.calls_among(among).IsTrue() → (values: Valuation()) →
    region.run(call, values, buffers) = State(region.eval_over(buffers, answers, values), buffers) {
    match region {
        Dataflow(body) => λ quiet _ values => run_nodes_quiet(body.nodes, quiet, values, buffers),
        Sequence(prefix, continuation) => λ quiet fits values => {
            let parts = Bool::is_true_and(nodes_quiet(prefix.nodes), continuation.quiet(), quiet);
            j(sym(run_nodes_quiet(prefix.nodes, parts.left, values, buffers)),
                λ s _ => continuation.run(call, s.values, s.buffers) =
                    State(continuation.eval_over(buffers, answers, eval_nodes_over(buffers, prefix.nodes, values)), buffers),
                continuation.run_quiet_among(call, answers, buffers, among, still, parts.right, fits, eval_nodes_over(buffers, prefix.nodes, values)))
        },
        Compose(prefix, continuation) => λ quiet fits values => {
            let parts = Bool::is_true_and(prefix.quiet(), continuation.quiet(), quiet);
            let fit = Bool::is_true_and(prefix.calls_among(among), continuation.calls_among(among), fits);
            j(sym(prefix.run_quiet_among(call, answers, buffers, among, still, parts.left, fit.left, values)),
                λ s _ => continuation.run(call, s.values, s.buffers) =
                    State(continuation.eval_over(buffers, answers, prefix.eval_over(buffers, answers, values)), buffers),
                continuation.run_quiet_among(call, answers, buffers, among, still, parts.right, fit.right, prefix.eval_over(buffers, answers, values)))
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ quiet fits values => {
            let parts = Bool::is_true_and(when_true.quiet(), when_false.quiet(), quiet);
            let fit = Bool::is_true_and(when_true.calls_among(among), when_false.calls_among(among), fits);
            let b = values(1, condition).head_bit();
            let whole = Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval_over(buffers, answers, values);
            let same_either: ((match b as λ _ => Buffers() { False => buffers, True => buffers }) = buffers) =
                match b { False => refl, True => refl };
            j(sym(when_false.run_quiet_among(call, answers, buffers, among, still, parts.right, fit.right, values)), λ f _ => State(λ w id => match b {
                        False => f.values(w, id),
                        True => when_true.run(call, values, buffers).values(w, id),
                    }, match b { False => f.buffers, True => when_true.run(call, values, buffers).buffers }) = State(whole, buffers),
                j(sym(when_true.run_quiet_among(call, answers, buffers, among, still, parts.left, fit.left, values)), λ t _ => State(λ w id => match b {
                            False => when_false.eval_over(buffers, answers, values)(w, id),
                            True => t.values(w, id),
                        }, match b { False => buffers, True => t.buffers }) = State(whole, buffers),
                    cong_fn<Buffers(), State>(λ held => State(whole, held), same_either)))
        },
        Lend(_, _, _, _) => λ never _ _ => false_elim(never),
        Call(callee, arguments, result, also) => λ _ fits values =>
            cong_fn<Ending, State>(λ answer => State(Valuation::bind(values, Cons(result, also), Cons(answer.word, answer.rest)), answer.buffers),
                still(callee, fits, words_of(values, arguments))),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ quiet fits values => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, answers, pass);
            let ended = loop_run_quiet(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held), step, buffers,
                λ v => body.run_quiet_among(call, answers, buffers, among, still, quiet, fits, v), parameters, count, exit, next, values(64, bound).toNat(),
                words_of(values, inputs));
            cong_fn<LoopState, State>(λ end => State(Valuation::set(Valuation::bind(values, outputs, end.end.state), exhausted,
                bit_value(end.end.exhausted)), end.buffers), ended)
        },
        Until(inputs, parameters, body, exit, next, outputs) => λ quiet fits values => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, answers, pass);
            let ended = until_run_quiet(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held), step, buffers,
                λ v => body.run_quiet_among(call, answers, buffers, among, still, quiet, fits, v), parameters, exit, next, until_passes(),
                words_of(values, inputs));
            cong_fn<LoopState, State>(λ end => State(Valuation::bind(values, outputs, end.end.state), end.buffers), ended)
        },
    }
}

// With every function still, whatever the region calls.
theorem StructuredRegion::run_quiet(self region: StructuredRegion, call: Writers(), answers: Answers(), buffers: Buffers(),
    still: (f: Nat) → (words: List<BitVec(64)>) → call(buffers, f, words) = Ending::of(answers(f, words), buffers)):
    region.quiet().IsTrue() → (values: Valuation()) →
    region.run(call, values, buffers) = State(region.eval_over(buffers, answers, values), buffers) {
    λ quiet values => region.run_quiet_among(call, answers, buffers, every_function, λ f _ words => still(f, words), quiet,
        region.calls_among_every(), values)
}

theorem Function::run_quiet(self function: Function, call: Writers(), answers: Answers(), buffers: Buffers(),
    still: (f: Nat) → (words: List<BitVec(64)>) → call(buffers, f, words) = Ending::of(answers(f, words), buffers),
    quiet: function.body.quiet().IsTrue(), arguments: List<BitVec(64)>):
    function.run(call, arguments, buffers) = Ending::of(function.eval_words(answers, arguments, buffers := buffers), buffers) {
    cong_fn<State, Ending>(λ end => Ending(end.values(64, function.result), end.buffers, rest := words_of(end.values, function.also)),
        function.body.run_quiet(call, answers, buffers, still, quiet, Valuation::bind(Valuation::zero(), function.parameters, arguments)))
}

// A function that stores nothing, at each depth: with its own number its
// tables run as they evaluate over the file, where the function at the
// depth does.
theorem Function::tied_still_at(self last: Function, below: Writers(), answers: Answers(), k: Nat, buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → below(buffers, f, words) = Ending::of(answers(f, words), buffers),
    depth: Nat,
    own: (words: List<BitVec(64)>) → last.level_run(below, k, depth)(buffers, words) = Ending::of(last.level_words(answers, k, depth, buffers)(words), buffers)):
    (f: Nat) → (words: List<BitVec(64)>) →
    last.tied_writers(below, k, depth)(buffers, f, words) = Ending::of(last.tied_answers(answers, k, depth, buffers)(f, words), buffers) {
    λ f words => match f.eq_dec(k) as λ d =>
        (match d as λ _ => Ending { Inl(_) => last.level_run(below, k, depth)(buffers, words), Inr(_) => below(buffers, f, words) }) =
        Ending::of((match d as λ _ => List<BitVec(64)> { Inl(_) => last.level_words(answers, k, depth, buffers)(words), Inr(_) => answers(f, words) }), buffers) {
        Inl(_) => own(words),
        Inr(_) => ih(f, words),
    }
}

theorem Function::level_still(self last: Function, below: Writers(), answers: Answers(), k: Nat, buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → below(buffers, f, words) = Ending::of(answers(f, words), buffers),
    quiet: last.body.quiet().IsTrue(), depth: Nat):
    (words: List<BitVec(64)>) → last.level_run(below, k, depth)(buffers, words) = Ending::of(last.level_words(answers, k, depth, buffers)(words), buffers) {
    match depth {
        Zero => λ words => refl,
        Succ(i) => λ words => last.run_quiet(last.tied_writers(below, k, i), last.tied_answers(answers, k, i, buffers), buffers,
            last.tied_still_at(below, answers, k, buffers, ih, i, last.level_still(below, answers, k, buffers, ih, quiet, i)), quiet, words),
    }
}

theorem Function::levels_still(self last: Function, below: Writers(), answers: Answers(), k: Nat, buffers: Buffers(),
    ih: (f: Nat) → (words: List<BitVec(64)>) → below(buffers, f, words) = Ending::of(answers(f, words), buffers),
    quiet: last.body.quiet().IsTrue(), levels: Nat):
    (f: Nat) → (words: List<BitVec(64)>) →
    last.writers_at(below, k, levels)(buffers, f, words) = Ending::of(last.answers_at(answers, k, levels, buffers)(f, words), buffers) {
    match levels {
        Zero => ih,
        Succ(depth) => last.tied_still_at(below, answers, k, buffers, ih, depth, last.level_still(below, answers, k, buffers, ih, quiet, depth)),
    }
}

// The theorem for programs: one whose functions store nothing runs as it
// evaluates over the file, and leaves it.
theorem program_run_quiet(functions: List<Function>): program_quiet(functions).IsTrue() → (buffers: Buffers()) → (f: Nat) →
    (words: List<BitVec(64)>) → program_run(functions, buffers, f, words) = Ending::of(program_answers_over(buffers, functions)(f, words), buffers) {
    match functions {
        Nil => λ _ buffers f words => refl,
        Cons(last, earlier) => λ quiet buffers f words => {
            let parts = Bool::is_true_and(last.body.quiet(), program_quiet(earlier), quiet);
            let ih = program_run_quiet(earlier, parts.right, buffers);
            let below = program_run(earlier);
            let words_below = program_answers_over(buffers, earlier);
            let tops = program_last_writers(last, earlier);
            let words_tops = program_last_answers(buffers, last, earlier);
            match f.eq_dec(earlier.len()) as λ d =>
                (match d as λ _ => Ending { Inl(_) => last.run(tops, words, buffers), Inr(_) => below(buffers, f, words) }) =
                Ending::of(match d { Inl(_) => last.eval_words(words_tops, words, buffers := buffers), Inr(_) => words_below(f, words) }, buffers) {
                Inl(_) => last.run_quiet(tops, words_tops, buffers,
                    last.levels_still(below, words_below, earlier.len(), buffers, ih, parts.left, last.levels), parts.left, words),
                Inr(_) => ih(f, words),
            }
        },
    }
}

// ---------------------------------------------------------------------------
// A loop that writes, against a recursion bounded by a measure

// One pass over `file` from the state `words_of(v, parameters)` with
// `Succ(r)` passes left: leaving, what `finish` makes of the next state and
// the file the pass left; going round, `later` of them (`loop_pass` with
// the file carried).
fn loop_pass_run(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>, finish: LoopState → Ending,
    later: List<BitVec(64)> → Buffers() → Ending, r: Nat, v: Valuation(), file: Buffers()) → Ending {
    let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)), file);
    match after.values(1, exit).head_bit() {
        False => later(words_of(after.values, next), after.buffers),
        True => finish(LoopState(LoopEnd(words_of(after.values, next), False), after.buffers)),
    }
}

// What a loop's end is held to: `Good` of it, whatever the passes left,
// and the recursion `run` where the measure is below them.
fn LoopAgrees<S>(Good: Ending → Type, measure: List<BitVec(64)> → S → Nat,
    run: (r: Nat) → (state: List<BitVec(64)>) → (s: S) → Nat::Lt(measure(state, s), r + 1) → Ending, r: Nat, state: List<BitVec(64)>, s: S,
    end: Ending) → Type {
    Good(end) ∧ ((h: Nat::Lt(measure(state, s), r + 1)) → end = run(r, state, s, h))
}

// A loop whose passes write agrees with `run`, a recursion bounded by a
// measure of its state and of what the file holds (`loop_eval_agrees_measured`
// with the file carried). The files are a family `emb(s)`: the passes are
// known only over those, and `Good` is what every end satisfies without the
// measure, which is how a pass that goes round learns that the file the
// later passes leave is of the family before it knows the measure fell.
theorem loop_run_agrees_measured<S>(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    apart: distinct(parameters).IsTrue(), finish: LoopState → Ending, emb: S → Buffers(), Good: Ending → Type,
    measure: List<BitVec(64)> → S → Nat,
    run: (r: Nat) → (state: List<BitVec(64)>) → (s: S) → Nat::Lt(measure(state, s), r + 1) → Ending,
    at_zero: (v: Valuation()) → (s: S) →
        LoopAgrees<S>(Good, measure, run, 0, words_of(v, parameters), s, finish(LoopState(LoopEnd(words_of(v, parameters), True), emb(s)))),
    at_pass: (r: Nat) → (v: Valuation()) → (s: S) →
        ((state: List<BitVec(64)>) → (s2: S) → state.len() = parameters.len() →
            LoopAgrees<S>(Good, measure, run, r, state, s2, finish(loop_run(step, parameters, count, exit, next, r, state, emb(s2))))) →
        LoopAgrees<S>(Good, measure, run, r + 1, words_of(v, parameters), s,
            loop_pass_run(step, parameters, count, exit, next, finish,
                λ (state: List<BitVec(64)>) (file: Buffers()) => finish(loop_run(step, parameters, count, exit, next, r, state, file)), r, v, emb(s))),
    remaining: Nat):
    (state: List<BitVec(64)>) → (s: S) → state.len() = parameters.len() →
        LoopAgrees<S>(Good, measure, run, remaining, state, s, finish(loop_run(step, parameters, count, exit, next, remaining, state, emb(s)))) {
    match remaining {
        Zero => λ state s fits => {
            let v = Valuation::bind(Valuation::zero(), parameters, state);
            let rebound: (words_of(v, parameters) = state) = words_of_bind(Valuation::zero(), parameters, apart, state, sym(fits));
            j(rebound, λ st _ => LoopAgrees<S>(Good, measure, run, 0, st, s, finish(LoopState(LoopEnd(st, True), emb(s)))), at_zero(v, s))
        },
        Succ(r) => λ state s fits => {
            let v = Valuation::bind(Valuation::zero(), parameters, state);
            let rebound: (words_of(v, parameters) = state) = words_of_bind(Valuation::zero(), parameters, apart, state, sym(fits));
            let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)), emb(s));
            let following = words_of(after.values, next);
            let Held = λ (end: Ending) => LoopAgrees<S>(Good, measure, run, r + 1, words_of(v, parameters), s, end);
            let earlier = λ (st: List<BitVec(64)>) (s2: S) (st_fits: st.len() = parameters.len()) =>
                loop_run_agrees_measured<S>(step, parameters, count, exit, next, apart, finish, emb, Good, measure, run, at_zero, at_pass, r, st, s2, st_fits);
            let at_v = (match after.values(1, exit).head_bit() as λ b =>
                Held(match b { False => finish(loop_run(step, parameters, count, exit, next, r, following, after.buffers)),
                    True => finish(LoopState(LoopEnd(following, False), after.buffers)) }) →
                Held(finish(match b as λ _ => LoopState { False => loop_run(step, parameters, count, exit, next, r, following, after.buffers),
                    True => LoopState(LoopEnd(following, False), after.buffers) })) {
                False => λ passed => passed,
                True => λ passed => passed,
            })(at_pass(r, v, s, earlier));
            j(rebound, λ st _ => LoopAgrees<S>(Good, measure, run, r + 1, st, s, finish(loop_run(step, parameters, count, exit, next, r + 1, st, emb(s)))),
                at_v)
        },
    }
}

// What a function answers when `post` follows the loop: `post` run on the
// loop's end over the file the loop left, read at `result`
// (`loop_finish_over` with the file carried). `post` is run once.
fn loop_finish_run(post: StructuredRegion, call: Writers(), values: Valuation(), outputs: List<Nat>, exhausted, result: Nat) → LoopState → Ending {
    λ ls => shared(post.run(call, Valuation::set(Valuation::bind(values, outputs, ls.end.state), exhausted, bit_value(ls.end.exhausted)), ls.buffers),
        λ (end: State) => Ending(end.values(64, result), end.buffers))
}

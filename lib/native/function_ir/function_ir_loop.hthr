// Semantic interface for bounded read-only FunctionIR loops. The byte source
// belongs to the caller; Some is an explicit grant of a read, not a total-load
// assumption. Addresses and control counters are mathematical Nats here.
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

record ReadonlyBytes {
    source: Nat,
    base: Nat,
    length: Nat,
    read: Nat → Option<BitVec(8)>,
}

inductive LoopStep<C> { Continue(next: C), Break(result: C) }

// At a successful read, cursor advances and budget decreases even if the
// callback exits. Thus Early's cursor is the next unread position.
inductive LoopOutcome<C> {
    End(cursor: Nat, remaining: Nat, carry: C),
    Exhausted(cursor: Nat, carry: C),
    Denied(cursor: Nat, remaining: Nat, carry: C),
    Early(cursor: Nat, remaining: Nat, result: C),
}

// The body has no memory argument. Its interface exposes precisely the byte
// selected by the guard, plus immutable needle/index and the typed carry.
// This semantic interface does not certify a native implementation of body.
record ReadonlyLoop<C> {
    body: BitVec(8) → Nat → BitVec(8) → C → LoopStep<C>,
}

fn loop_run<C>(budget: Nat) → ReadonlyLoop<C> → ReadonlyBytes → BitVec(8) → Nat → C → LoopOutcome<C> {
    match budget {
        Zero => λ region buffer needle cursor carry =>
            match buffer.length.leb(cursor) {
                True => End(cursor, 0, carry),
                False => Exhausted(cursor, carry),
            },
        Succ(rest) => λ region buffer needle cursor carry =>
            match buffer.length.leb(cursor) {
                True => End(cursor, Succ(rest), carry),
                False => match buffer.read(buffer.base + cursor) {
                    None => Denied(cursor, Succ(rest), carry),
                    Some(byte) => match region.body(needle, cursor, byte, carry) {
                        Continue(next) => loop_run(rest, region, buffer, needle, Succ(cursor), next),
                        Break(result) => Early(Succ(cursor), rest, result),
                    },
                },
            },
    }
}

// A step's two observations, payload then discriminator (Continue is False),
// in the order typed machine certificates publish them.
fn loop_step_payload<C>(step: LoopStep<C>) → C {
    match step { Continue(next) => next, Break(result) => result }
}
fn loop_step_breaks<C>(step: LoopStep<C>) → Bool {
    match step { Continue(_) => False, Break(_) => True }
}

// A counting step's representability obligation: the count grows by at most
// one per byte, so count + budget bounds every count the loop reaches. A
// client proves it about its own step; native lowering relies on it.
fn LoopAdvancesByAtMostOne(region: ReadonlyLoop<Nat>) → Type {
    (needle: BitVec(8)) → (cursor: Nat) → (byte: BitVec(8)) → (count: Nat) →
        loop_step_payload(region.body(needle, cursor, byte, count)) <= Succ(count)
}

// Source entry point: one resolved combinator, with an ordinary checked pure
// step definition. Reflection recovers this interface, not recursion encodings.
fn bounded_readonly<C>(buffer: ReadonlyBytes, needle: BitVec(8), budget: Nat,
    cursor: Nat, carry: C, body: BitVec(8) → Nat → BitVec(8) → C → LoopStep<C>) → LoopOutcome<C> {
    loop_run(budget, ReadonlyLoop<C>(body), buffer, needle, cursor, carry)
}

fn LoopFinishedNormally<C>(outcome: LoopOutcome<C>) → Type {
    match outcome {
        End(_, _, _) => True,
        Exhausted(_, _) => True,
        Denied(_, _, _) => False,
        Early(_, _, _) => True,
    }
}

// Define access validity from the evaluator itself, so there is no second
// recursive account of the chosen path that could drift from execution.
// End/exhaustion need no access; denied reads make this proposition False.
fn LoopReadable<C>(budget: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes,
    needle: BitVec(8), cursor: Nat, carry: C) → Type {
    LoopFinishedNormally(loop_run(budget, region, buffer, needle, cursor, carry))
}

fn ReadsByte(buffer: ReadonlyBytes, cursor: Nat, byte: BitVec(8)) → Type {
    buffer.read(buffer.base + cursor) = Some(byte)
}

// Native lowering must discharge these premises at its chosen address width.
// One-past-end must itself be representable; no modular wrap is hidden here.
fn LoopBounds(buffer: ReadonlyBytes, cursor: Nat) → Type { cursor <= buffer.length }
fn LoopWord(width: Nat, word: BitVec(width), counter: Nat) → Type { word.toNat() = counter }
fn LoopAddressBound(width: Nat, buffer: ReadonlyBytes) → Type {
    buffer.base + buffer.length < Nat::pow(2, width)
}

theorem loop_advance_bound(cursor, length: Nat, guarded: (cursor + 1).leb(length).IsTrue()):
    cursor + 1 <= length { (cursor + 1).leb_sound(length, guarded) }

theorem loop_budget_predecessor(rest: Nat): (rest + 1).sub(1) = rest {
    Nat::sub_zero(rest)
}

// This is the source/IR contract. Native code must separately establish an
// implementation of region.body, the physical read relation, and counters.
record ReadonlyLoopArtifact<C>(region: ReadonlyLoop<C>, buffer: ReadonlyBytes,
    needle: BitVec(8), budget: Nat, cursor: Nat, carry: C, result: LoopOutcome<C>) {
    source_agreement: loop_run(budget, region, buffer, needle, cursor, carry) = result,
    cursor_bound: LoopBounds(buffer, cursor),
    selected_reads: LoopReadable(budget, region, buffer, needle, cursor, carry),
}

theorem loop_artifact_normal<C>(region: ReadonlyLoop<C>, buffer: ReadonlyBytes,
    needle: BitVec(8), budget: Nat, cursor: Nat, carry: C, result: LoopOutcome<C>,
    artifact: ReadonlyLoopArtifact<C>(region, buffer, needle, budget, cursor, carry, result)):
    LoopFinishedNormally(result) {
    j(artifact.source_agreement, λ outcome _ => LoopFinishedNormally(outcome), artifact.selected_reads)
}

// Local transition equation over open values. It is the interface a later
// loop-invariant proof can fold without unrolling an arbitrary budget.
theorem loop_successor<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes,
    needle: BitVec(8), cursor: Nat, carry: C):
    loop_run(rest + 1, region, buffer, needle, cursor, carry) =
        match buffer.length.leb(cursor) {
            True => End(cursor, rest + 1, carry),
            False => match buffer.read(buffer.base + cursor) {
                None => Denied(cursor, rest + 1, carry),
                Some(byte) => match region.body(needle, cursor, byte, carry) {
                    Continue(next) => loop_run(rest, region, buffer, needle, cursor + 1, next),
                    Break(result) => Early(cursor + 1, rest, result),
                },
            },
        } { refl }

// loop_run one decision at a time, so each outcome equation below rewrites
// a single scrutinee.
fn loop_after_step<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, step: LoopStep<C>) → LoopOutcome<C> {
    match step {
        Continue(next) => loop_run(rest, region, buffer, needle, Succ(cursor), next),
        Break(result) => Early(Succ(cursor), rest, result),
    }
}
fn loop_after_read<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, read: Option<BitVec(8)>) → LoopOutcome<C> {
    match read {
        None => Denied(cursor, Succ(rest), carry),
        Some(byte) => loop_after_step(rest, region, buffer, needle, cursor, region.body(needle, cursor, byte, carry)),
    }
}
fn loop_after_guard<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, ended: Bool) → LoopOutcome<C> {
    match ended {
        True => End(cursor, Succ(rest), carry),
        False => loop_after_read(rest, region, buffer, needle, cursor, carry, buffer.read(buffer.base + cursor)),
    }
}
fn loop_after_last<C>(cursor: Nat, carry: C, ended: Bool) → LoopOutcome<C> {
    match ended { True => End(cursor, 0, carry), False => Exhausted(cursor, carry) }
}

theorem loop_run_last<C>(region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8), cursor: Nat, carry: C):
    loop_run(0, region, buffer, needle, cursor, carry) = loop_after_last(cursor, carry, buffer.length.leb(cursor)) {
    refl
}
theorem loop_run_next<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C):
    loop_run(rest + 1, region, buffer, needle, cursor, carry) =
        loop_after_guard(rest, region, buffer, needle, cursor, carry, buffer.length.leb(cursor)) {
    refl
}

theorem loop_run_end<C>(region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8), cursor: Nat, carry: C,
    ended: buffer.length.leb(cursor) = True):
    (budget: Nat) → loop_run(budget, region, buffer, needle, cursor, carry) = End(cursor, budget, carry) {
    λ budget => match budget {
        Zero => trans(loop_run_last(region, buffer, needle, cursor, carry),
            j(sym(ended), λ e _ => loop_after_last(cursor, carry, e) = End(cursor, 0, carry), refl)),
        Succ(rest) => trans(loop_run_next(rest, region, buffer, needle, cursor, carry),
            j(sym(ended), λ e _ => loop_after_guard(rest, region, buffer, needle, cursor, carry, e) =
                End(cursor, rest + 1, carry), refl)),
    }
}

theorem loop_run_exhausted<C>(region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8), cursor: Nat, carry: C,
    open: buffer.length.leb(cursor) = False):
    loop_run(0, region, buffer, needle, cursor, carry) = Exhausted(cursor, carry) {
    trans(loop_run_last(region, buffer, needle, cursor, carry),
        j(sym(open), λ e _ => loop_after_last(cursor, carry, e) = Exhausted(cursor, carry), refl))
}

theorem loop_run_read<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, open: buffer.length.leb(cursor) = False):
    loop_run(rest + 1, region, buffer, needle, cursor, carry) =
        loop_after_read(rest, region, buffer, needle, cursor, carry, buffer.read(buffer.base + cursor)) {
    trans(loop_run_next(rest, region, buffer, needle, cursor, carry),
        j(sym(open), λ e _ => loop_after_guard(rest, region, buffer, needle, cursor, carry, e) =
            loop_after_read(rest, region, buffer, needle, cursor, carry, buffer.read(buffer.base + cursor)), refl))
}

theorem loop_run_denied<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, open: buffer.length.leb(cursor) = False,
    denied: buffer.read(buffer.base + cursor) = None):
    loop_run(rest + 1, region, buffer, needle, cursor, carry) = Denied(cursor, rest + 1, carry) {
    trans(loop_run_read(rest, region, buffer, needle, cursor, carry, open),
        j(sym(denied), λ found _ => loop_after_read(rest, region, buffer, needle, cursor, carry, found) =
            Denied(cursor, rest + 1, carry), refl))
}

theorem loop_run_step<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, byte: BitVec(8), step: LoopStep<C>, open: buffer.length.leb(cursor) = False,
    present: ReadsByte(buffer, cursor, byte), stepped: region.body(needle, cursor, byte, carry) = step):
    loop_run(rest + 1, region, buffer, needle, cursor, carry) =
        loop_after_step(rest, region, buffer, needle, cursor, step) {
    trans(loop_run_read(rest, region, buffer, needle, cursor, carry, open),
        j(sym(present), λ found _ => loop_after_read(rest, region, buffer, needle, cursor, carry, found) =
            loop_after_step(rest, region, buffer, needle, cursor, step),
            j(sym(stepped), λ chosen _ => loop_after_step(rest, region, buffer, needle, cursor, chosen) =
                loop_after_step(rest, region, buffer, needle, cursor, step), refl)))
}

// An open, readable iteration has its byte: denial would make the outcome
// Denied, which LoopReadable refutes.
theorem loop_readable_byte<C>(rest: Nat, region: ReadonlyLoop<C>, buffer: ReadonlyBytes, needle: BitVec(8),
    cursor: Nat, carry: C, open: buffer.length.leb(cursor) = False,
    readable: LoopReadable(rest + 1, region, buffer, needle, cursor, carry)):
    Exists<BitVec(8)>(λ byte => ReadsByte(buffer, cursor, byte)) {
    match denied: buffer.read(buffer.base + cursor) {
        None => false_elim(j(loop_run_denied(rest, region, buffer, needle, cursor, carry, open, denied),
            λ outcome _ => LoopFinishedNormally(outcome), readable)),
        Some(byte) => Exists(byte, denied),
    }
}

// ---------------------------------------------------------------------------
// Folding loops (docs/archive/native-wc-design.md §3). A step that always continues,
// and the same way at every cursor, makes the loop a left fold of the step
// over the bytes it reads. Chunks then compose by list reasoning alone,
// whatever reads split the input into: a program states its specification
// against `step_fold` and never argues about buffers.

fn loop_fold_step<C>(region: ReadonlyLoop<C>, needle: BitVec(8), byte: BitVec(8), carry: C) → C {
    loop_step_payload(region.body(needle, 0, byte, carry))
}
fn LoopFolds<C>(region: ReadonlyLoop<C>) → Type {
    (needle: BitVec(8)) → (cursor: Nat) → (byte: BitVec(8)) → (carry: C) →
        region.body(needle, cursor, byte, carry) = Continue(loop_fold_step(region, needle, byte, carry))
}

fn step_fold<C>(region: ReadonlyLoop<C>, needle: BitVec(8), bytes: List<BitVec(8)>) → C → C {
    match bytes {
        Nil => λ carry => carry,
        Cons(byte, rest) => λ carry => step_fold(region, needle, rest, loop_fold_step(region, needle, byte, carry)),
    }
}

theorem step_fold_append<C>(region: ReadonlyLoop<C>, needle: BitVec(8), front: List<BitVec(8)>):
    (back: List<BitVec(8)>) → (carry: C) →
    step_fold(region, needle, front ++ back, carry) = step_fold(region, needle, back, step_fold(region, needle, front, carry)) {
    match front {
        Nil => λ back carry => refl,
        Cons(byte, rest) => λ back carry => step_fold_append(region, needle, rest, back, loop_fold_step(region, needle, byte, carry)),
    }
}

// A counting fold stays within one per byte of where it started.
theorem step_fold_advances(region: ReadonlyLoop<Nat>, advance: LoopAdvancesByAtMostOne(region), needle: BitVec(8),
    bytes: List<BitVec(8)>): (carry: Nat) → step_fold(region, needle, bytes, carry) <= carry + bytes.len() {
    match bytes {
        Nil => λ carry => carry.le_refl(),
        Cons(byte, rest) => λ carry => {
            let next = loop_fold_step(region, needle, byte, carry);
            let later = step_fold_advances(region, advance, needle, rest, next);
            let grew: (next <= carry + 1) = advance(needle, 0, byte, carry);
            let moved: (next + rest.len() <= carry + 1 + rest.len()) = Nat::add_le_mono_r(rest.len(), next, carry + 1, grew);
            let shifted: (carry + 1 + rest.len() = carry + (rest.len() + 1)) = Nat::add_succ_left(carry, rest.len());
            step_fold(region, needle, rest, next).le_trans(next + rest.len(), carry + (rest.len() + 1), later,
                j(shifted, λ total _ => next + rest.len() <= total, moved))
        },
    }
}

// The same bound for one measure of a state that is not a Nat, such as one
// field of a record (docs/archive/native-wc-design.md §4.8).
theorem step_fold_measure<C>(region: ReadonlyLoop<C>, measure: C → Nat,
    grows: (needle: BitVec(8)) → (cursor: Nat) → (byte: BitVec(8)) → (carry: C) →
        measure(loop_step_payload(region.body(needle, cursor, byte, carry))) <= measure(carry) + 1,
    needle: BitVec(8), bytes: List<BitVec(8)>): (carry: C) → measure(step_fold(region, needle, bytes, carry)) <= measure(carry) + bytes.len() {
    match bytes {
        Nil => λ carry => measure(carry).le_refl(),
        Cons(byte, rest) => λ carry => {
            let next = loop_fold_step(region, needle, byte, carry);
            let later = step_fold_measure(region, measure, grows, needle, rest, next);
            let grew: (measure(next) <= measure(carry) + 1) = grows(needle, 0, byte, carry);
            let moved: (measure(next) + rest.len() <= measure(carry) + 1 + rest.len()) =
                Nat::add_le_mono_r(rest.len(), measure(next), measure(carry) + 1, grew);
            let shifted: (measure(carry) + 1 + rest.len() = measure(carry) + (rest.len() + 1)) = Nat::add_succ_left(measure(carry), rest.len());
            measure(step_fold(region, needle, rest, next)).le_trans(measure(next) + rest.len(), measure(carry) + (rest.len() + 1), later,
                j(shifted, λ total _ => measure(next) + rest.len() <= total, moved))
        },
    }
}

theorem loop_past_cursor(cursor: Nat): (k: Nat) → (cursor + k + 1).leb(cursor) = False {
    match cursor {
        Zero => λ k => refl,
        Succ(c) => λ k => trans(cong_fn<Nat, Bool>(λ n => (n + 1).leb(c + 1), Nat::add_succ_left(c, k)), loop_past_cursor(c, k)),
    }
}

// Over a buffer holding `bytes` from `cursor` to its end, a folding loop ends
// there with the fold of its step over the bytes.
theorem loop_run_folds<C>(region: ReadonlyLoop<C>, folds: LoopFolds(region), needle: BitVec(8), bytes: List<BitVec(8)>):
    (buffer: ReadonlyBytes) → (cursor: Nat) → (carry: C) → buffer.length = cursor + bytes.len() →
    ((i: Nat) → (byte: BitVec(8)) → bytes.nth(i) = Some(byte) → buffer.read(buffer.base + (cursor + i)) = Some(byte)) →
    loop_run(bytes.len(), region, buffer, needle, cursor, carry) =
        End(cursor + bytes.len(), 0, step_fold(region, needle, bytes, carry)) {
    match bytes {
        Nil => λ buffer cursor carry length reads =>
            loop_run_end(region, buffer, needle, cursor, carry,
                trans(cong_fn<Nat, Bool>(λ n => n.leb(cursor), length),
                    eq_true_of_is_true(cursor.leb(cursor), Nat::leb_complete(cursor, cursor, cursor.le_refl()))), 0),
        Cons(byte, rest) => λ buffer cursor carry length reads => {
            let next = loop_fold_step(region, needle, byte, carry);
            let open: (buffer.length.leb(cursor) = False) =
                trans(cong_fn<Nat, Bool>(λ n => n.leb(cursor), length), loop_past_cursor(cursor, rest.len()));
            let moved: (cursor + 1 + rest.len() = cursor + (rest.len() + 1)) = Nat::add_succ_left(cursor, rest.len());
            let later = loop_run_folds(region, folds, needle, rest, buffer, cursor + 1, next, trans(length, sym(moved)),
                λ i found present => j(sym(Nat::add_succ_left(cursor, i)), λ at _ => buffer.read(buffer.base + at) = Some(found),
                    reads(i + 1, found, present)));
            trans(loop_run_step(rest.len(), region, buffer, needle, cursor, carry, byte, Continue(next),
                    open, reads(0, byte, refl), folds(needle, cursor, byte, carry)),
                trans(later, cong_fn<Nat, LoopOutcome<C>>(λ at => End(at, 0, step_fold(region, needle, rest, next)), moved)))
        },
    }
}

// ---------------------------------------------------------------------------
// A program: a step folded over its input (docs/archive/native-architecture-review.md
// R6).

// Each of `counts` grows by at most one from `carry` to `next`, one conjunct
// per count, right-nested.
fn counts_advance<C>(counts: List<C → Nat>) → C → C → Type {
    match counts {
        Nil => λ next carry => True,
        Cons(count, rest) => match rest {
            Nil => λ next carry => count(next) <= Succ(count(carry)),
            Cons(_, _) => λ next carry => (count(next) <= Succ(count(carry))) ∧ counts_advance(rest)(next, carry),
        },
    }
}
// A counting step's representability obligation for a state of several
// counts, such as a record's Nat fields: each grows by at most one per byte.
// For one count that is the state, `[λ count => count]`, it is
// `LoopAdvancesByAtMostOne`.

// A step at its own type: the next state from the state and a byte. The
// loop body it makes ignores the needle and the cursor and always continues,
// so the loop is a left fold of the step (`fold_body_folds`), and what the
// fold computes is the plain fold over the bytes (`fold_body_fold`).
fn fold_body<C>(step: C → BitVec(8) → C) → BitVec(8) → Nat → BitVec(8) → C → LoopStep<C> {
    λ needle cursor byte carry => Continue(step(carry, byte))
}

fn fold_bytes<C>(step: C → BitVec(8) → C, bytes: List<BitVec(8)>) → C → C {
    match bytes {
        Nil => λ carry => carry,
        Cons(byte, rest) => λ carry => fold_bytes(step, rest, step(carry, byte)),
    }
}

theorem fold_body_folds<C>(step: C → BitVec(8) → C): LoopFolds(ReadonlyLoop<C>(fold_body<C>(step))) {
    λ needle cursor byte carry => refl
}

theorem fold_body_fold<C>(step: C → BitVec(8) → C, needle: BitVec(8), bytes: List<BitVec(8)>):
    (carry: C) → step_fold(ReadonlyLoop<C>(fold_body<C>(step)), needle, bytes, carry) = fold_bytes(step, bytes, carry) {
    match bytes {
        Nil => λ carry => refl,
        Cons(byte, rest) => λ carry => fold_body_fold(step, needle, rest, step(carry, byte)),
    }
}

// A FunctionIR pass written in Heather and proved once
// (issues/function-ir-pass-in-heather.md, milestone hih-passes;
// docs/native/compiler-milestones-proposal.md §5): constant folding, then
// dead-node removal, over a leaf's schedule of nodes, given the words live
// after it.
//
// Folding runs forward with what the nodes so far are known to leave in
// each word at every width (`Fact`): a `Const`'s value, a `Move` of a known
// word, a comparison of two known words (its bit), and `BitAnd`, `BitOr` or
// `BitXor` of two known bits. Such a node becomes a `Const` of that value
// at its own port. Removal runs backward: a node that touches no buffer,
// whose output nothing after it reads before writing it again and that the
// leaf does not leave live, is dropped.
//
// What the pass keeps (`List::optimised_runs`, proved in
// function_ir_pass_diagrams by composing the two passes as simulation
// diagrams): from any valuation and buffers, the optimised nodes run to the
// same buffers and to the same value, at every width, in every word live
// after them; and the last node writing each live word writes it at the same
// width
// (`List::optimised_last`), so the words a leaf settles into the
// environment are the same where they are live (native_compile_pass). Byte
// nodes are never folded or dropped, so a leaf keeps the label names it
// takes.
//
// A value is read at every width (`Valuation`), so a fold rule is one whose
// result is a number's bits at every width, not only at the node's: a
// comparison's bit is (`bit_value_ofNat`), and so is a bitwise operation of
// two bits (`BitVec::band_bits` and its siblings). Sums, differences and
// shifts of known numbers need `ofNat`'s arithmetic at every width
// (issues/function-ir-pass-arithmetic-folds.md).

import bitvec_bytes;
import function_ir;
import function_ir_eval;
import function_ir_state;
import bitvec;
import bitvec_rotate;
import bool;
import list;
import logic;
import nat;
import option;
import dec_set;
import set_tactic;

// ---------------------------------------------------------------------------
// Bits as numbers

fn Bool::bit(self b: Bool) → Nat { match b { False => 0, True => 1 } }

// A number that is a bit, as one.
fn Nat::as_bit(self n: Nat) → Option<Bool> {
    match n { Zero => Some(False), Succ(k) => match k { Zero => Some(True), Succ(_) => None } }
}

theorem Nat::as_bit_some(self n: Nat, b: Bool, found: n.as_bit() = Some(b)): n = b.bit() {
    (match n as λ m => m.as_bit() = Some(b) → m = b.bit() {
        Zero => λ same => j(Option::some_inj(False, b, same), λ x _ => 0 = x.bit(), refl),
        Succ(k) => (match k {
            Zero => λ same => j(Option::some_inj(True, b, same), λ x _ => 1 = x.bit(), refl),
            Succ(_) => λ none => absurd(none),
        }),
    })(found)
}

// A comparison's result, a bit at every width, is its number's bits.
theorem bit_value_ofNat(b: Bool): (w: Nat) → bit_value(b, w) = BitVec::ofNat(b.bit()) {
    λ w => match w {
        Zero => refl,
        Succ(k) => match b {
            False => BitVec::cons_bit_cong(k, refl, sym(BitVec::ofNat_zero(k)), a := False, b := False),
            True => BitVec::cons_bit_cong(k, refl, sym(BitVec::ofNat_zero(k)), a := True, b := True),
        },
    }
}

// Zero's bits with themselves, at any width.
theorem BitVec::band_ofNat_zero(k: Nat): BitVec::ofNat(0, n := k).band(BitVec::ofNat(0)) = BitVec::ofNat(0) {
    j(sym(BitVec::ofNat_zero(k)), λ z _ => z.band(z) = z, BitVec::band_zero_columns(k))
}

theorem BitVec::bor_ofNat_zero(k: Nat): BitVec::ofNat(0, n := k).bor(BitVec::ofNat(0)) = BitVec::ofNat(0) {
    j(sym(BitVec::ofNat_zero(k)), λ z _ => z.bor(z) = z, BitVec::bor_zero_columns(k))
}

theorem BitVec::bxor_ofNat_zero(k: Nat): BitVec::ofNat(0, n := k).bxor(BitVec::ofNat(0)) = BitVec::ofNat(0) {
    trans(BitVec::xor_self(k, BitVec::ofNat(0)), sym(BitVec::ofNat_zero(k)))
}

// Two bits combined, at every width, are their combination's bits.
theorem BitVec::band_bits(x, y: Bool): (w: Nat) → BitVec::ofNat(x.bit(), n := w).band(BitVec::ofNat(y.bit())) = BitVec::ofNat((x && y).bit()) {
    λ w => match w {
        Zero => refl,
        Succ(k) => match x {
            False => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::band_ofNat_zero(k), a := False, b := False),
                True => BitVec::cons_bit_cong(k, refl, BitVec::band_ofNat_zero(k), a := False, b := False),
            },
            True => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::band_ofNat_zero(k), a := False, b := False),
                True => BitVec::cons_bit_cong(k, refl, BitVec::band_ofNat_zero(k), a := True, b := True),
            },
        },
    }
}

theorem BitVec::bor_bits(x, y: Bool): (w: Nat) → BitVec::ofNat(x.bit(), n := w).bor(BitVec::ofNat(y.bit())) = BitVec::ofNat((x || y).bit()) {
    λ w => match w {
        Zero => refl,
        Succ(k) => match x {
            False => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::bor_ofNat_zero(k), a := False, b := False),
                True => BitVec::cons_bit_cong(k, refl, BitVec::bor_ofNat_zero(k), a := True, b := True),
            },
            True => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::bor_ofNat_zero(k), a := True, b := True),
                True => BitVec::cons_bit_cong(k, refl, BitVec::bor_ofNat_zero(k), a := True, b := True),
            },
        },
    }
}

theorem BitVec::bxor_bits(x, y: Bool): (w: Nat) → BitVec::ofNat(x.bit(), n := w).bxor(BitVec::ofNat(y.bit())) = BitVec::ofNat((x.xor(y)).bit()) {
    λ w => match w {
        Zero => refl,
        Succ(k) => match x {
            False => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::bxor_ofNat_zero(k), a := False, b := False),
                True => BitVec::cons_bit_cong(k, refl, BitVec::bxor_ofNat_zero(k), a := True, b := True),
            },
            True => match y {
                False => BitVec::cons_bit_cong(k, refl, BitVec::bxor_ofNat_zero(k), a := True, b := True),
                True => BitVec::cons_bit_cong(k, refl, BitVec::bxor_ofNat_zero(k), a := False, b := False),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// What the nodes so far are known to leave

// Word `id` holds `value`'s bits at every width.
record Fact { id: Nat, value: Nat }

fn List::known(self facts: List<Fact>, id: Nat) → Option<Nat> {
    match facts { Nil => None, Cons(f, rest) => match id.matches(f.id) { True => Some(f.value), False => rest.known(id) } }
}

// A known bit.
fn List::known_bit(self facts: List<Fact>, id: Nat) → Option<Bool> {
    match facts.known(id) { None => None, Some(n) => n.as_bit() }
}

// The facts but those about `id`, which a node has just written.
fn List::forget(self facts: List<Fact>, id: Nat) → List<Fact> {
    match facts { Nil => Nil, Cons(f, rest) => match id.matches(f.id) { True => rest.forget(id), False => Cons(f, rest.forget(id)) } }
}

fn List::Hold(self facts: List<Fact>, values: Valuation()) → Type {
    match facts { Nil => True, Cons(f, rest) => ((w: Nat) → values(w, f.id) = BitVec::ofNat(f.value)) ∧ rest.Hold(values) }
}

theorem List::known_holds(self facts: List<Fact>, values: Valuation()): facts.Hold(values) → (id, k: Nat) → facts.known(id) = Some(k) →
    (w: Nat) → values(w, id) = BitVec::ofNat(k) {
    match facts {
        Nil => λ _ id k none => absurd(none),
        Cons(f, rest) => λ held id k found => (match id.eq_dec(f.id) as λ d =>
                (match (match d as λ _ => Bool { Inl(_) => True, Inr(_) => False }) as λ _ => Option<Nat> { True => Some(f.value), False => rest.known(id) }) = Some(k) →
                (w: Nat) → values(w, id) = BitVec::ofNat(k) {
            Inl(e) => λ same w => j(sym(e), λ x _ => values(w, x) = BitVec::ofNat(k),
                trans(held.left(w), cong_fn<Nat, BitVec(w)>(λ v => BitVec::ofNat(v), Option::some_inj(f.value, k, same)))),
            Inr(_) => λ later => rest.known_holds(values, held.right, id, k, later),
        })(found),
    }
}

theorem List::known_bit_holds(self facts: List<Fact>, values: Valuation(), held: facts.Hold(values), id: Nat, b: Bool,
    found: facts.known_bit(id) = Some(b)): (w: Nat) → values(w, id) = BitVec::ofNat(b.bit()) {
    (match facts.known(id) as λ o => facts.known(id) = o → (match o { None => None, Some(n) => n.as_bit() }) = Some(b) →
            (w: Nat) → values(w, id) = BitVec::ofNat(b.bit()) {
        None => λ _ none => absurd(none),
        Some(n) => λ at bit w => j(n.as_bit_some(b, bit), λ x _ => values(w, id) = BitVec::ofNat(x), facts.known_holds(values, held, id, n, at, w)),
    })(refl, found)
}

// Facts about words a step leaves alone still hold after it.
theorem List::forget_holds(self facts: List<Fact>, values, after: Valuation(), o: Nat,
    kept: (w, id: Nat) → id ≠ o → after(w, id) = values(w, id)): facts.Hold(values) → facts.forget(o).Hold(after) {
    match facts {
        Nil => λ _ => trivial,
        Cons(f, rest) => λ held => (match o.eq_dec(f.id) {
            Inl(_) => rest.forget_holds(values, after, o, kept, held.right),
            Inr(ne) => ⟨λ w => trans(kept(w, f.id, λ e => ne(sym(e))), held.left(w)), rest.forget_holds(values, after, o, kept, held.right)⟩,
        }),
    }
}

// ---------------------------------------------------------------------------
// Folding

// Both found, combined.
fn Option::both<A, B>(x, y: Option<A>, f: A → A → Option<B>) → Option<B> {
    match x { None => None, Some(a) => match y { None => None, Some(c) => f(a, c) } }
}

theorem Option::both_elim<A, B>(x, y: Option<A>, f: A → A → Option<B>, v: B, M: B → Type,
    step: (a, c: A) → x = Some(a) → y = Some(c) → f(a, c) = Some(v) → M(v)): Option::both(x, y, f) = Some(v) → M(v) {
    (match x as λ o => x = o → (match o { None => None, Some(a) => match y { None => None, Some(c) => f(a, c) } }) = Some(v) → M(v) {
        None => λ _ none => absurd(none),
        Some(a) => λ xa => (match y as λ o => y = o → (match o { None => None, Some(c) => f(a, c) }) = Some(v) → M(v) {
            None => λ _ none => absurd(none),
            Some(c) => λ yc => step(a, c, xa, yc),
        })(refl),
    })(refl)
}

// A comparison of two known words, at the node's width.
fn List::compared(self facts: List<Fact>, left, right: Nat, decide: Nat → Nat → Bool) → Option<Nat> {
    Option::both(facts.known(left), facts.known(right), λ a c => Some(decide(a, c).bit()))
}

// A table's entry at a known index, the index read at its width.
fn List::read_table(self facts: List<Fact>, bits, index: Nat, entries: List<Nat>) → Option<Nat> {
    match facts.known(index) { None => None, Some(a) => Some(table_entry(entries, BitVec::ofNat(a, n := bits).toNat())) }
}

// A bitwise operation of two known bits.
fn List::combined(self facts: List<Fact>, left, right: Nat, op: Bool → Bool → Bool) → Option<Nat> {
    Option::both(facts.known_bit(left), facts.known_bit(right), λ x y => Some(op(x, y).bit()))
}

// The number whose bits the node leaves in its output at every width, where
// the facts say.
fn Node::folded(self node: Node, facts: List<Fact>) → Option<Nat> {
    match node {
        Const(_, _, value) => Some(value),
        Move(_, _, source) => facts.known(source),
        Add(_, _, _, _) => None,
        Sub(_, _, _, _) => None,
        BitAnd(_, _, left, right) => facts.combined(left, right, λ x y => x && y),
        BitOr(_, _, left, right) => facts.combined(left, right, λ x y => x || y),
        BitXor(_, _, left, right) => facts.combined(left, right, λ x y => x.xor(y)),
        ShiftLeft(_, _, _, _) => None,
        LogicalShiftRight(_, _, _, _) => None,
        RotateRight(_, _, _, _) => None,
        ArithmeticShiftRight(_, _, _, _) => None,
        UnsignedLessThan(width, _, left, right) => facts.compared(left, right, λ a c => BitVec::ofNat(a, n := width).unsigned_lt_bit(BitVec::ofNat(c))),
        SignedLessThan(width, _, left, right) => facts.compared(left, right, λ a c => BitVec::ofNat(a, n := width).signed_lt_bit(BitVec::ofNat(c))),
        Equal(width, _, left, right) => facts.compared(left, right, λ a c => BitVec::ofNat(a, n := width).eq_bit(BitVec::ofNat(c))),
        BufferLoad(_, _, _) => None,
        BufferStore(_, _, _, _) => None,
        Resize(_, _, _, _) => None,
        SignResize(_, _, _, _) => None,
        TableRead(_, _, bits, index, entries) => facts.read_table(bits, index, entries),
        WideLoad(_, _, _, _) => None,
        WideStore(_, _, _, _, _) => None,
        ByteSwap(_, _, _) => None,
    }
}

// A comparison folds to its bit.
theorem List::compared_value(self facts: List<Fact>, values: Valuation(), held: facts.Hold(values), width, left, right, v: Nat,
    decide: BitVec(width) → BitVec(width) → Bool, folded: facts.compared(left, right, λ a c => decide(BitVec::ofNat(a), BitVec::ofNat(c))) = Some(v)):
    (w: Nat) → bit_value(decide(values(width, left), values(width, right)), w) = BitVec::ofNat(v) {
    Option::both_elim(facts.known(left), facts.known(right), λ a c => Some(decide(BitVec::ofNat(a), BitVec::ofNat(c)).bit()), v,
        λ x => (w: Nat) → bit_value(decide(values(width, left), values(width, right)), w) = BitVec::ofNat(x),
        λ a c at_left at_right same w => {
            let l = facts.known_holds(values, held, left, a, at_left, width);
            let r = facts.known_holds(values, held, right, c, at_right, width);
            let read = eq2(λ (x: BitVec(width)) (y: BitVec(width)) => bit_value(decide(x, y), w), l, r);
            trans(read, trans(bit_value_ofNat(decide(BitVec::ofNat(a), BitVec::ofNat(c)), w),
                cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), Option::some_inj(decide(BitVec::ofNat(a), BitVec::ofNat(c)).bit(), v, same))))
        }, folded)
}

// A bitwise operation of two bits folds to its bit.
theorem List::combined_value(self facts: List<Fact>, values: Valuation(), held: facts.Hold(values), left, right, v: Nat,
    op: Bool → Bool → Bool, apply: (w: Nat) → BitVec(w) → BitVec(w) → BitVec(w),
    bits: (x, y: Bool) → (w: Nat) → apply(w, BitVec::ofNat(x.bit()), BitVec::ofNat(y.bit())) = BitVec::ofNat(op(x, y).bit()),
    folded: facts.combined(left, right, op) = Some(v)):
    (w: Nat) → apply(w, values(w, left), values(w, right)) = BitVec::ofNat(v) {
    Option::both_elim(facts.known_bit(left), facts.known_bit(right), λ x y => Some(op(x, y).bit()), v,
        λ n => (w: Nat) → apply(w, values(w, left), values(w, right)) = BitVec::ofNat(n),
        λ x y at_left at_right same w => {
            let l = facts.known_bit_holds(values, held, left, x, at_left, w);
            let r = facts.known_bit_holds(values, held, right, y, at_right, w);
            trans(eq2(λ (a: BitVec(w)) (c: BitVec(w)) => apply(w, a, c), l, r),
                trans(bits(x, y, w), cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), Option::some_inj(op(x, y).bit(), v, same))))
        }, folded)
}

theorem List::read_table_value(self facts: List<Fact>, values: Valuation(), held: facts.Hold(values), bits, index: Nat, entries: List<Nat>, v: Nat,
    found: facts.read_table(bits, index, entries) = Some(v)):
    (w: Nat) → BitVec::ofNat(table_entry(entries, values(bits, index).toNat()), n := w) = BitVec::ofNat(v) {
    (match facts.known(index) as λ k => facts.known(index) = k →
            (match k as λ _ => Option<Nat> { None => None, Some(a) => Some(table_entry(entries, BitVec::ofNat(a, n := bits).toNat())) }) = Some(v) →
            (w: Nat) → BitVec::ofNat(table_entry(entries, values(bits, index).toNat()), n := w) = BitVec::ofNat(v) {
        None => λ _ none => absurd(none),
        Some(a) => λ at same w => trans(
            cong_fn(λ (x: BitVec(bits)) => BitVec::ofNat(table_entry(entries, x.toNat()), n := w), facts.known_holds(values, held, index, a, at, bits)),
            cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), Option::some_inj(table_entry(entries, BitVec::ofNat(a, n := bits).toNat()), v, same))),
    })(refl, found)
}

// What a node folds to is its value, at every width.
theorem Node::folded_value(self node: Node, facts: List<Fact>, values: Valuation(), held: facts.Hold(values), v: Nat, folded: node.folded(facts) = Some(v)):
    (w: Nat) → node.value(values)(w) = BitVec::ofNat(v) {
    (match node as λ n => n.folded(facts) = Some(v) → (w: Nat) → n.value(values)(w) = BitVec::ofNat(v) {
        Const(_, _, value) => λ same w => cong_fn<Nat, BitVec(w)>(λ n => BitVec::ofNat(n), Option::some_inj(value, v, same)),
        Move(_, _, source) => λ found w => facts.known_holds(values, held, source, v, found, w),
        Add(_, _, _, _) => λ none => absurd(none),
        Sub(_, _, _, _) => λ none => absurd(none),
        BitAnd(_, _, left, right) => λ found => facts.combined_value(values, held, left, right, v, λ x y => x && y,
            λ w a c => a.band(c), BitVec::band_bits, found),
        BitOr(_, _, left, right) => λ found => facts.combined_value(values, held, left, right, v, λ x y => x || y,
            λ w a c => a.bor(c), BitVec::bor_bits, found),
        BitXor(_, _, left, right) => λ found => facts.combined_value(values, held, left, right, v, λ x y => x.xor(y),
            λ w a c => a.bxor(c), BitVec::bxor_bits, found),
        ShiftLeft(_, _, _, _) => λ none => absurd(none),
        LogicalShiftRight(_, _, _, _) => λ none => absurd(none),
        RotateRight(_, _, _, _) => λ none => absurd(none),
        ArithmeticShiftRight(_, _, _, _) => λ none => absurd(none),
        UnsignedLessThan(width, _, left, right) => λ found => facts.compared_value(values, held, width, left, right, v,
            λ (a: BitVec(width)) (c: BitVec(width)) => a.unsigned_lt_bit(c), found),
        SignedLessThan(width, _, left, right) => λ found => facts.compared_value(values, held, width, left, right, v,
            λ (a: BitVec(width)) (c: BitVec(width)) => a.signed_lt_bit(c), found),
        Equal(width, _, left, right) => λ found => facts.compared_value(values, held, width, left, right, v,
            λ (a: BitVec(width)) (c: BitVec(width)) => a.eq_bit(c), found),
        BufferLoad(_, _, _) => λ none => absurd(none),
        BufferStore(_, _, _, _) => λ none => absurd(none),
        Resize(_, _, _, _) => λ none => absurd(none),
        SignResize(_, _, _, _) => λ none => absurd(none),
        TableRead(_, _, bits, index, entries) => λ found => facts.read_table_value(values, held, bits, index, entries, v, found),
        WideLoad(_, _, _, _) => λ none => absurd(none),
        WideStore(_, _, _, _, _) => λ none => absurd(none),
        ByteSwap(_, _, _) => λ none => absurd(none),
    })(folded)
}

// Only a node that touches no buffer folds.
theorem Node::folded_pure(self node: Node, facts: List<Fact>, v: Nat, folded: node.folded(facts) = Some(v)): node.pure().IsTrue() {
    match node {
        Const(_, _, _) => trivial,
        Move(_, _, _) => trivial,
        Add(_, _, _, _) => trivial,
        Sub(_, _, _, _) => trivial,
        BitAnd(_, _, _, _) => trivial,
        BitOr(_, _, _, _) => trivial,
        BitXor(_, _, _, _) => trivial,
        ShiftLeft(_, _, _, _) => trivial,
        LogicalShiftRight(_, _, _, _) => trivial,
        RotateRight(_, _, _, _) => trivial,
        ArithmeticShiftRight(_, _, _, _) => trivial,
        UnsignedLessThan(_, _, _, _) => trivial,
        SignedLessThan(_, _, _, _) => trivial,
        Equal(_, _, _, _) => trivial,
        BufferLoad(_, _, _) => absurd(folded),
        BufferStore(_, _, _, _) => absurd(folded),
        Resize(_, _, _, _) => trivial,
        SignResize(_, _, _, _) => trivial,
        TableRead(_, _, _, _, _) => trivial,
        WideLoad(_, _, _, _) => absurd(folded),
        WideStore(_, _, _, _, _) => absurd(folded),
        ByteSwap(_, _, _) => trivial,
    }
}

// ---------------------------------------------------------------------------
// A node run from valuations that agree on what it reads

fn Node::ReadsAgree(self node: Node, values, other: Valuation()) → Type {
    (id: Nat) → Mem(id, node.reads()) → (w: Nat) → other(w, id) = values(w, id)
}

// The same buffers after, and the same output at every width.
fn Node::RunsAlike(self node: Node, values, other: Valuation(), buffers: Buffers()) → Type {
    (node.run(other, buffers).buffers = node.run(values, buffers).buffers)
        ∧ ((w: Nat) → node.run(other, buffers).values(w, node_output(node).id) = node.run(values, buffers).values(w, node_output(node).id))
}

theorem Node::value_agree(self node: Node, values, other: Valuation(), agree: node.ReadsAgree(values, other)):
    (w: Nat) → node.value(other)(w) = node.value(values)(w) {
    (match node as λ n => n.ReadsAgree(values, other) → (w: Nat) → n.value(other)(w) = n.value(values)(w) {
        Const(_, _, _) => λ agree w => refl,
        Move(_, _, source) => λ agree w => agree(source, Inl(refl), w),
        Add(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y), agree(left, Inl(refl), w), agree(right, Inr(Inl(refl)), w)),
        Sub(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y), agree(left, Inl(refl), w), agree(right, Inr(Inl(refl)), w)),
        BitAnd(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y), agree(left, Inl(refl), w), agree(right, Inr(Inl(refl)), w)),
        BitOr(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y), agree(left, Inl(refl), w), agree(right, Inr(Inl(refl)), w)),
        BitXor(_, _, left, right) => λ agree w => eq2(λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y), agree(left, Inl(refl), w), agree(right, Inr(Inl(refl)), w)),
        ShiftLeft(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.shift_left(amount), agree(value, Inl(refl), w)),
        LogicalShiftRight(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.shift_right(amount), agree(value, Inl(refl), w)),
        RotateRight(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.rotr(amount), agree(value, Inl(refl), w)),
        ArithmeticShiftRight(_, _, value, amount) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.arithmetic_shift_right(amount), agree(value, Inl(refl), w)),
        UnsignedLessThan(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.unsigned_lt_bit(y), agree(left, Inl(refl), width), agree(right, Inr(Inl(refl)), width))),
        SignedLessThan(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.signed_lt_bit(y), agree(left, Inl(refl), width), agree(right, Inr(Inl(refl)), width))),
        Equal(width, _, left, right) => λ agree w => cong_fn(λ (b: Bool) => bit_value(b, w),
            eq2(λ (x: BitVec(width)) (y: BitVec(width)) => x.eq_bit(y), agree(left, Inl(refl), width), agree(right, Inr(Inl(refl)), width))),
        BufferLoad(_, buffer, index) => λ agree w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(Nil, buffer, x.toNat())), w),
            agree(index, Inl(refl), 64)),
        BufferStore(_, buffer, index, _) => λ agree w => cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(Nil, buffer, x.toNat())), w),
            agree(index, Inl(refl), 64)),
        Resize(from, _, _, source) => λ agree w => cong_fn(λ (x: BitVec(from)) => BitVec::ofNat(x.toNat(), n := w), agree(source, Inl(refl), from)),
        SignResize(from, _, _, source) => λ agree w => cong_fn(λ (x: BitVec(from)) => x.sresize(w), agree(source, Inl(refl), from)),
        TableRead(_, _, bits, index, entries) => λ agree w => cong_fn(λ (x: BitVec(bits)) => BitVec::ofNat(table_entry(entries, x.toNat()), n := w),
            agree(index, Inl(refl), bits)),
        WideLoad(bytes, _, buffer, index) => λ agree w => cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(Nil, buffer, x.toNat(), bytes).toNat(), n := w),
            agree(index, Inl(refl), 64)),
        WideStore(bytes, _, buffer, index, _) => λ agree w => cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(Nil, buffer, x.toNat(), bytes).toNat(), n := w),
            agree(index, Inl(refl), 64)),
        ByteSwap(_, _, source) => λ agree w => cong_fn(λ (x: BitVec(w)) => x.swap_bytes(), agree(source, Inl(refl), w)),
    })(agree)
}

theorem Node::step_agree(self node: Node, values, other: Valuation(), agree: node.ReadsAgree(values, other)):
    (w: Nat) → node.step(other)(w, node_output(node).id) = node.step(values)(w, node_output(node).id) {
    λ w => trans(Valuation::set_here(other, node_output(node).id, node.value(other), w),
        trans(node.value_agree(values, other, agree, w), sym(Valuation::set_here(values, node_output(node).id, node.value(values), w))))
}

theorem Node::runs_alike_pure(self node: Node, values, other: Valuation(), buffers: Buffers(), agree: node.ReadsAgree(values, other),
    pure: node.pure().IsTrue()): node.RunsAlike(values, other, buffers) {
    let o = node_output(node).id;
    j(sym(node.run_pure(other, buffers, pure)), λ s _ =>
            (s.buffers = node.run(values, buffers).buffers) ∧ ((w: Nat) → s.values(w, o) = node.run(values, buffers).values(w, o)),
        j(sym(node.run_pure(values, buffers, pure)), λ t _ =>
                (buffers = t.buffers) ∧ ((w: Nat) → node.step(other)(w, o) = t.values(w, o)),
            ⟨refl, node.step_agree(values, other, agree)⟩))
}

theorem Node::runs_alike(self node: Node, values, other: Valuation(), buffers: Buffers(), agree: node.ReadsAgree(values, other)):
    node.RunsAlike(values, other, buffers) {
    (match node as λ n => n.ReadsAgree(values, other) → n.RunsAlike(values, other, buffers) {
        Const(width, output, value) => λ agree => Const(width, output, value).runs_alike_pure(values, other, buffers, agree, trivial),
        Move(width, output, source) => λ agree => Move(width, output, source).runs_alike_pure(values, other, buffers, agree, trivial),
        Add(width, output, left, right) => λ agree => Add(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        Sub(width, output, left, right) => λ agree => Sub(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        BitAnd(width, output, left, right) => λ agree => BitAnd(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        BitOr(width, output, left, right) => λ agree => BitOr(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        BitXor(width, output, left, right) => λ agree => BitXor(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        ShiftLeft(width, output, value, amount) => λ agree => ShiftLeft(width, output, value, amount).runs_alike_pure(values, other, buffers, agree, trivial),
        LogicalShiftRight(width, output, value, amount) => λ agree => LogicalShiftRight(width, output, value, amount).runs_alike_pure(values, other, buffers, agree, trivial),
        RotateRight(width, output, value, amount) => λ agree => RotateRight(width, output, value, amount).runs_alike_pure(values, other, buffers, agree, trivial),
        ArithmeticShiftRight(width, output, value, amount) => λ agree => ArithmeticShiftRight(width, output, value, amount).runs_alike_pure(values, other, buffers, agree, trivial),
        UnsignedLessThan(width, output, left, right) => λ agree => UnsignedLessThan(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        SignedLessThan(width, output, left, right) => λ agree => SignedLessThan(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        Equal(width, output, left, right) => λ agree => Equal(width, output, left, right).runs_alike_pure(values, other, buffers, agree, trivial),
        BufferLoad(output, buffer, index) => λ agree => ⟨refl, λ w =>
            trans(Valuation::set_here(other, output, load_value(buffers, buffer, index, other), w),
                trans(cong_fn(λ (x: BitVec(64)) => word_value(byte_word(buffer_byte(buffers, buffer, x.toNat())), w), agree(index, Inl(refl), 64)),
                    sym(Valuation::set_here(values, output, load_value(buffers, buffer, index, values), w))))⟩,
        BufferStore(output, buffer, index, value) => λ agree => {
            let i = agree(index, Inl(refl), 64);
            let v = agree(value, Inr(Inl(refl)), 64);
            ⟨eq2(λ (x: BitVec(64)) (y: BitVec(64)) => store_byte(buffers, buffer, x.toNat(), low_byte(y)), i, v), λ w =>
                trans(Valuation::set_here(other, output, load_value(store_byte(buffers, buffer, other(64, index).toNat(), low_byte(other(64, value))), buffer, index, other), w),
                    trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => word_value(byte_word(buffer_byte(store_byte(buffers, buffer, x.toNat(), low_byte(y)), buffer, x.toNat())), w), i, v),
                        sym(Valuation::set_here(values, output, load_value(store_byte(buffers, buffer, values(64, index).toNat(), low_byte(values(64, value))), buffer, index, values), w))))⟩
        },
        Resize(from, to, output, source) => λ agree => Resize(from, to, output, source).runs_alike_pure(values, other, buffers, agree, trivial),
        SignResize(from, to, output, source) => λ agree => SignResize(from, to, output, source).runs_alike_pure(values, other, buffers, agree, trivial),
        TableRead(width, output, bits, index, entries) => λ agree => TableRead(width, output, bits, index, entries).runs_alike_pure(values, other, buffers, agree, trivial),
        WideLoad(bytes, output, buffer, index) => λ agree => ⟨refl, λ w =>
            trans(Valuation::set_here(other, output, wide_value(buffers, buffer, index, bytes, other), w),
                trans(cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(buffer_word(buffers, buffer, x.toNat(), bytes).toNat(), n := w), agree(index, Inl(refl), 64)),
                    sym(Valuation::set_here(values, output, wide_value(buffers, buffer, index, bytes, values), w))))⟩,
        WideStore(bytes, output, buffer, index, value) => λ agree => {
            let i = agree(index, Inl(refl), 64);
            let v = agree(value, Inr(Inl(refl)), 8 * bytes);
            ⟨eq2(λ (x: BitVec(64)) (y: BitVec(8 * bytes)) => store_word(buffers, buffer, x.toNat(), bytes, y), i, v), λ w =>
                trans(Valuation::set_here(other, output, wide_value(store_word(buffers, buffer, other(64, index).toNat(), bytes, other(8 * bytes, value)), buffer, index, bytes, other), w),
                    trans(eq2(λ (x: BitVec(64)) (y: BitVec(8 * bytes)) => BitVec::ofNat(buffer_word(store_word(buffers, buffer, x.toNat(), bytes, y), buffer, x.toNat(), bytes).toNat(), n := w), i, v),
                        sym(Valuation::set_here(values, output, wide_value(store_word(buffers, buffer, values(64, index).toNat(), bytes, values(8 * bytes, value)), buffer, index, bytes, values), w))))⟩
        },
        ByteSwap(width, output, source) => λ agree => ByteSwap(width, output, source).runs_alike_pure(values, other, buffers, agree, trivial),
    })(agree)
}

// A node writes only its output.
theorem Node::run_keeps(self node: Node, values: Valuation(), buffers: Buffers(), w, id: Nat, ne: id ≠ node_output(node).id):
    node.run(values, buffers).values(w, id) = values(w, id) {
    match node {
        Const(width, output, value) => Valuation::set_other(values, output, Const(width, output, value).value(values), w, id, ne),
        Move(width, output, source) => Valuation::set_other(values, output, Move(width, output, source).value(values), w, id, ne),
        Add(width, output, left, right) => Valuation::set_other(values, output, Add(width, output, left, right).value(values), w, id, ne),
        Sub(width, output, left, right) => Valuation::set_other(values, output, Sub(width, output, left, right).value(values), w, id, ne),
        BitAnd(width, output, left, right) => Valuation::set_other(values, output, BitAnd(width, output, left, right).value(values), w, id, ne),
        BitOr(width, output, left, right) => Valuation::set_other(values, output, BitOr(width, output, left, right).value(values), w, id, ne),
        BitXor(width, output, left, right) => Valuation::set_other(values, output, BitXor(width, output, left, right).value(values), w, id, ne),
        ShiftLeft(width, output, value, amount) => Valuation::set_other(values, output, ShiftLeft(width, output, value, amount).value(values), w, id, ne),
        LogicalShiftRight(width, output, value, amount) => Valuation::set_other(values, output, LogicalShiftRight(width, output, value, amount).value(values), w, id, ne),
        RotateRight(width, output, value, amount) => Valuation::set_other(values, output, RotateRight(width, output, value, amount).value(values), w, id, ne),
        ArithmeticShiftRight(width, output, value, amount) => Valuation::set_other(values, output, ArithmeticShiftRight(width, output, value, amount).value(values), w, id, ne),
        UnsignedLessThan(width, output, left, right) => Valuation::set_other(values, output, UnsignedLessThan(width, output, left, right).value(values), w, id, ne),
        SignedLessThan(width, output, left, right) => Valuation::set_other(values, output, SignedLessThan(width, output, left, right).value(values), w, id, ne),
        Equal(width, output, left, right) => Valuation::set_other(values, output, Equal(width, output, left, right).value(values), w, id, ne),
        BufferLoad(output, buffer, index) => Valuation::set_other(values, output, load_value(buffers, buffer, index, values), w, id, ne),
        BufferStore(output, buffer, index, value) => Valuation::set_other(values, output,
            load_value(store_byte(buffers, buffer, values(64, index).toNat(), low_byte(values(64, value))), buffer, index, values), w, id, ne),
        Resize(from, to, output, source) => Valuation::set_other(values, output, Resize(from, to, output, source).value(values), w, id, ne),
        SignResize(from, to, output, source) => Valuation::set_other(values, output, SignResize(from, to, output, source).value(values), w, id, ne),
        TableRead(width, output, bits, index, entries) => Valuation::set_other(values, output, TableRead(width, output, bits, index, entries).value(values), w, id, ne),
        WideLoad(bytes, output, buffer, index) => Valuation::set_other(values, output, wide_value(buffers, buffer, index, bytes, values), w, id, ne),
        WideStore(bytes, output, buffer, index, value) => Valuation::set_other(values, output,
            wide_value(store_word(buffers, buffer, values(64, index).toNat(), bytes, values(8 * bytes, value)), buffer, index, bytes, values), w, id, ne),
        ByteSwap(width, output, source) => Valuation::set_other(values, output, ByteSwap(width, output, source).value(values), w, id, ne),
    }
}

// ---------------------------------------------------------------------------
// Folding a schedule

// A node folded where the facts say what it leaves: a `Const` of that, at
// its port.
fn Node::fold(self node: Node, facts: List<Fact>) → Node {
    match node.folded(facts) { None => node, Some(v) => Const(node_output(node).width, node_output(node).id, v) }
}

// The facts after the node.
fn Node::learn(self node: Node, facts: List<Fact>) → List<Fact> {
    match node.folded(facts) {
        None => facts.forget(node_output(node).id),
        Some(v) => Cons(Fact(node_output(node).id, v), facts.forget(node_output(node).id)),
    }
}

fn List::folded(self nodes: List<Node>, facts: List<Fact>) → List<Node> {
    match nodes { Nil => Nil, Cons(node, rest) => Cons(node.fold(facts), rest.folded(node.learn(facts))) }
}

// A folded node writes the port it did.
theorem Node::fold_output(self node: Node, facts: List<Fact>): node_output(node.fold(facts)) = node_output(node) {
    match node.folded(facts) {
        None => refl,
        Some(_) => refl,
    }
}

// One node: folded, from a valuation the same as the one the facts hold
// of, it runs to the same buffers and the same valuation, and its facts
// hold after it.
theorem Node::fold_runs(self node: Node, facts: List<Fact>, values, other: Valuation(), buffers: Buffers(), held: facts.Hold(values),
    same: Valuation::Same(values, other)):
    (node.fold(facts).run(other, buffers).buffers = node.run(values, buffers).buffers)
        ∧ (Valuation::Same(node.run(values, buffers).values, node.fold(facts).run(other, buffers).values)
        ∧ node.learn(facts).Hold(node.run(values, buffers).values)) {
    let o = node_output(node).id;
    let after = node.run(values, buffers);
    let kept = λ (w: Nat) (id: Nat) (ne: id ≠ o) => node.run_keeps(values, buffers, w, id, ne);
    (match node.folded(facts) as λ f => node.folded(facts) = f →
            (match f { None => node, Some(v) => Const(node_output(node).width, o, v) }.run(other, buffers).buffers = after.buffers)
            ∧ (Valuation::Same(after.values, match f { None => node, Some(v) => Const(node_output(node).width, o, v) }.run(other, buffers).values)
            ∧ List::Hold(match f { None => facts.forget(o), Some(v) => Cons(Fact(o, v), facts.forget(o)) }, after.values)) {
        None => λ _ => {
            let alike = node.runs_alike(values, other, buffers, λ id _ w => same(w, id));
            ⟨alike.left, ⟨λ w id => match id.eq_dec(o) {
                    Inl(e) => j(sym(e), λ x _ => node.run(other, buffers).values(w, x) = after.values(w, x), alike.right(w)),
                    Inr(ne) => trans(node.run_keeps(other, buffers, w, id, ne), trans(same(w, id), sym(kept(w, id, ne)))),
                }, facts.forget_holds(values, after.values, o, kept, held)⟩⟩
        },
        Some(v) => λ found => {
            let value = node.folded_value(facts, values, held, v, found);
            j(sym(node.run_pure(values, buffers, node.folded_pure(facts, v, found))), λ s _ =>
                    (buffers = s.buffers) ∧ (Valuation::Same(s.values, Valuation::set(other, o, λ w => BitVec::ofNat(v)))
                    ∧ List::Hold(Cons(Fact(o, v), facts.forget(o)), s.values)),
                ⟨refl, ⟨Valuation::set_same(values, other, same, o, node.value(values), λ w => BitVec::ofNat(v), λ w => sym(value(w))),
                    ⟨λ w => trans(Valuation::set_here(values, o, node.value(values), w), value(w)),
                        facts.forget_holds(values, node.step(values), o, λ w id ne => Valuation::set_other(values, o, node.value(values), w, id, ne), held)⟩⟩⟩)
        },
    })(refl)
}

// ---------------------------------------------------------------------------
// The last write of a word

// The width the last node writing `i` writes it at.
fn List::last_width(self nodes: List<Node>, i: Nat) → Option<Nat> {
    match nodes {
        Nil => None,
        Cons(node, rest) => match rest.last_width(i) {
            Some(w) => Some(w),
            None => match i.matches(node_output(node).id) { True => Some(node_output(node).width), False => None },
        },
    }
}

theorem List::folded_last(self nodes: List<Node>): (facts: List<Fact>) → (i: Nat) → nodes.folded(facts).last_width(i) = nodes.last_width(i) {
    match nodes {
        Nil => λ facts i => refl,
        Cons(node, rest) => λ facts i => eq2(λ (l: Option<Nat>) (p: Port) => match l {
                Some(w) => Some(w),
                None => match i.matches(p.id) { True => Some(p.width), False => None },
            }, rest.folded_last(node.learn(facts), i), node.fold_output(facts)),
    }
}

// ---------------------------------------------------------------------------
// Removing dead nodes

// An id of a list is not absent from it.
theorem present_of_mem(id: Nat, ids: List<Nat>, m: Mem(id, ids)): (!absent(id, ids)).IsTrue() { by sets() }

theorem Nat::differs_true(self a: Nat, b: Nat, ne: a ≠ b): a.differs(b) = True {
    match a.eq_dec(b) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => refl,
    }
}

theorem Nat::matches_false(self a: Nat, b: Nat, ne: a ≠ b): a.matches(b) = False {
    match a.eq_dec(b) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => refl,
    }
}

// Whether word `i` is live before the nodes: read by one before any writes
// it, or written by none and live after them.
fn List::needs(self nodes: List<Node>, out: List<Nat>, i: Nat) → Bool {
    match nodes {
        Nil => !absent(i, out),
        Cons(node, rest) => !absent(i, node.reads()) || (i.differs(node_output(node).id) && rest.needs(out, i)),
    }
}

// A node before the ones kept: dropped if it touches no buffer and they
// do not need its output.
fn Node::keep(self node: Node, kept: List<Node>, out: List<Nat>) → List<Node> {
    match node.pure() && !kept.needs(out, node_output(node).id) { True => kept, False => Cons(node, kept) }
}

fn List::pruned(self nodes: List<Node>, out: List<Nat>) → List<Node> {
    match nodes { Nil => Nil, Cons(node, rest) => node.keep(rest.pruned(out), out) }
}

// What a kept node reads is needed before it, and so is what the rest
// needs but it does not write.
theorem Node::needs_read(self node: Node, rest: List<Node>, out: List<Nat>, i: Nat, m: Mem(i, node.reads())): Cons(node, rest).needs(out, i).IsTrue() {
    Bool::is_true_or_l(!absent(i, node.reads()), i.differs(node_output(node).id) && rest.needs(out, i), present_of_mem(i, node.reads(), m))
}

theorem Node::needs_later(self node: Node, rest: List<Node>, out: List<Nat>, i: Nat, ne: i ≠ node_output(node).id, later: rest.needs(out, i).IsTrue()):
    Cons(node, rest).needs(out, i).IsTrue() {
    Bool::is_true_or_r(!absent(i, node.reads()), i.differs(node_output(node).id) && rest.needs(out, i),
        Bool::is_true_and_intro(i.differs(node_output(node).id), rest.needs(out, i),
            j(sym(i.differs_true(node_output(node).id, ne)), λ b _ => b.IsTrue(), trivial), later))
}

// A dropped node's output: not needed after it, and it touches no buffer.
theorem Node::dropped(self node: Node, kept: List<Node>, out: List<Nat>, drop: (node.pure() && !kept.needs(out, node_output(node).id)) = True):
    node.pure().IsTrue() ∧ ¬kept.needs(out, node_output(node).id).IsTrue() {
    let parts = Bool::is_true_and(node.pure(), !kept.needs(out, node_output(node).id), j(sym(drop), λ b _ => b.IsTrue(), trivial));
    ⟨parts.left, Bool::is_true_not(kept.needs(out, node_output(node).id), parts.right)⟩
}

// A word live after the nodes that none writes is needed before them.
theorem List::needs_unwritten(self nodes: List<Node>, out: List<Nat>, i: Nat, m: Mem(i, out)): nodes.last_width(i) = None → nodes.needs(out, i).IsTrue() {
    match nodes {
        Nil => λ _ => present_of_mem(i, out, m),
        Cons(node, rest) => (match unwritten: rest.last_width(i) {
            Some(_) => λ some => absurd(some),
            None => match i.eq_dec(node_output(node).id) {
                Inl(_) => λ some => absurd(some),
                Inr(ne) => λ _ => node.needs_later(rest, out, i, ne, rest.needs_unwritten(out, i, m, unwritten)),
            },
        }),
    }
}

// Each word live after the nodes is last written at the width it was.
theorem List::pruned_last(self nodes: List<Node>, out: List<Nat>, i: Nat, m: Mem(i, out)): nodes.pruned(out).last_width(i) = nodes.last_width(i) {
    match nodes {
        Nil => refl,
        Cons(node, rest) => {
            let o = node_output(node).id;
            let kept = rest.pruned(out);
            let same: (kept.last_width(i) = rest.last_width(i)) = rest.pruned_last(out, i, m);
            let step = λ (l: Option<Nat>) => match l as λ _ => Option<Nat> {
                Some(w) => Some(w),
                None => match i.matches(o) { True => Some(node_output(node).width), False => None },
            };
            (match node.pure() && !kept.needs(out, o) as λ d => (node.pure() && !kept.needs(out, o)) = d →
                    List::last_width(match d { True => kept, False => Cons(node, kept) }, i) = step(rest.last_width(i)) {
                True => λ drop => {
                    let gone = node.dropped(kept, out, drop);
                    match at: rest.last_width(i) {
                        Some(w) => trans(same, at),
                        None => match i.eq_dec(o) as λ _ => kept.last_width(i) = step(None) {
                            Inl(e) => false_elim(gone.right(j(e, λ x _ => kept.needs(out, x).IsTrue(), kept.needs_unwritten(out, i, m, trans(same, at))))),
                            Inr(ne) => trans(trans(same, at), sym(cong_fn<Bool, Option<Nat>>(λ b => match b { True => Some(node_output(node).width), False => None },
                                i.matches_false(o, ne)))),
                        },
                    }
                },
                False => λ _ => cong_fn<Option<Nat>, Option<Nat>>(step, same),
            })(refl)
        },
    }
}

// ---------------------------------------------------------------------------
// The pass

// A leaf's nodes, folded and pruned, given the words live after it.
fn List::optimised(self nodes: List<Node>, out: List<Nat>) → List<Node> { nodes.folded([]).pruned(out) }

// Each word live after the leaf is last written at the width it was. What
// the optimised nodes run to is `List::optimised_runs`, the composite of
// the two passes' simulation diagrams (function_ir_pass_diagrams).
theorem List::optimised_last(self nodes: List<Node>, out: List<Nat>, i: Nat, m: Mem(i, out)): nodes.optimised(out).last_width(i) = nodes.last_width(i) {
    trans(nodes.folded([]).pruned_last(out, i, m), nodes.folded_last([], i))
}

// ---------------------------------------------------------------------------
// What a leaf leaves known

// The facts after the nodes, as folding them learns them.
fn List::learned(self nodes: List<Node>, facts: List<Fact>) → List<Fact> {
    match nodes { Nil => facts, Cons(node, rest) => rest.learned(node.learn(facts)) }
}

// They hold of the valuation the nodes run to.
theorem List::learned_holds(self nodes: List<Node>): (facts: List<Fact>) → (values: Valuation()) → (buffers: Buffers()) →
    facts.Hold(values) → nodes.learned(facts).Hold(run_nodes(nodes, values, buffers).values) {
    match nodes {
        Nil => λ facts values buffers held => held,
        Cons(node, rest) => λ facts values buffers held => {
            let step = node.fold_runs(facts, values, values, buffers, held, λ w id => refl);
            let after = node.run(values, buffers);
            rest.learned_holds(node.learn(facts), after.values, after.buffers, step.right.right)
        },
    }
}

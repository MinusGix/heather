// The optimizer's rules over facts (docs/native/optimizer-design.md §4,
// docs/native/optimizer-rules-design.md): each a theorem about words under
// the `rule` prefix (function_ir_rule), which publishes beside it
// `name_rule`, the clause over nodes its statement stands for with the
// proof that a valuation and buffers satisfying its premises satisfy its
// conclusion. A fact is a node's equation, a word's range, an order
// between two words (`low + add ≤ high + more`, read as naturals), a load
// made since the last store, that a word is bytes of a buffer joined, or
// that a word's bytes are other words' low bytes. The replayer
// (function_ir_replay) applies a rule by its place in `library()` where its
// premises are among the facts, so adding one is a theorem and a line of
// the table, and no change to anything proved about the replayer.
//
// A rule's numbers are its statement's binders in the order written
// (literals, words by id, buffers by number), then the word each operator
// of the statement writes, outermost first. A hypothesis over literals
// alone is a guard: the rule answers `None` where it fails.
import function_ir;
import function_ir_eval;
import function_ir_match;
import function_ir_replay;
import function_ir_rule;
import function_ir_state;
import nat_map;
import bitvec;
import bitvec_bytes;
import bitvec_nat;
import bitvec_resize;
import bitvec_ring;
import bitvec_shift_nat;
import bool;
import list;
import logic;
import nat;
import omega;
import option;
import vector;

// ---------------------------------------------------------------------------
// The rules

// x + 0 is x. Its numbers: the width, `x`, the sum, the literal 0.
rule theorem add_zero({w: Nat}, x: BitVec(w)): x + 0 = x { BitVec::add_zero(w, x) }

// A move of a move: `o` moved from `s`, `s` from `t`, at width `w`.
rule theorem move_move({w: Nat}, t, s, o: BitVec(w), first: s = t, second: o = s): o = t { trans(second, first) }

// ---------------------------------------------------------------------------
// Ranges (docs/native/optimizer-design.md §5.1): what a word's value lies between,
// from the node that makes it and the ranges of what it reads, and what a
// comparison's bit says of its operands. A rule is made where its literals
// allow it (a sum that cannot wrap), so none has a condition left to prove.

theorem leb_below(n, m: Nat, h: n.leb(m) = True): n <= m { n.leb_sound(m, Bool::is_true_of_eq(h)) }

// A constant is within itself.
rule theorem within_const(v: Nat, fits: v <= word_top()): BitVec::ofNat(v, n := 64).within(v, v) {
    j(sym(BitVec::toNat_ofNat(64, v, fits)), λ n _ => (v <= n) ∧ (n <= v), ⟨v.le_refl(), v.le_refl()⟩)
}

// A copy is within what it copies.
rule theorem within_move(s, o: u64, a, b: Nat, copy: o = s, in: s.within(a, b)): o.within(a, b) {
    j(sym(copy), λ w _ => Range(a, b).Holds(w), in)
}

// A sum that cannot wrap is within the sums of its parts' bounds.
rule theorem within_add(l, r: u64, a, b, c, d: Nat, left: l.within(a, b), right: r.within(c, d), fits: b + d <= word_top()): (l + r).within(a + c, b + d) {
    let high: (l.toNat() + r.toNat() <= b + d) = Nat::add_le_mono(l.toNat(), b, r.toNat(), d, left.right, right.right);
    let sum: (l.add(r).toNat() = l.toNat() + r.toNat()) = trans(BitVec::toNat_add_mod(64, l, r),
        (l.toNat() + r.toNat()).mod_of_lt(Nat::pow(2, 64), Nat::le_trans(l.toNat() + r.toNat(), b + d, word_top(), high, fits)));
    j(sym(sum), λ n _ => (a + c <= n) ∧ (n <= b + d), ⟨Nat::add_le_mono(a, l.toNat(), c, r.toNat(), left.left, right.left), high⟩)
}

// A difference that cannot borrow is within its parts' bounds, crossed.
rule theorem within_sub(l, r: u64, a, b, c, d: Nat, left: l.within(a, b), right: r.within(c, d), fits: d <= a): (l - r).within(a - d, b - c) {
    let under: (r.toNat() <= l.toNat()) = omega(left.left, right.right, fits);
    j(sym(toNat_sub(64, l, r, under)), λ n _ => (a - d <= n) ∧ (n <= b - c),
        ⟨omega(left.left, right.right, fits), omega(left.right, right.left, under)⟩)
}

// A left shift that loses no bit is within its operand's bounds, shifted.
rule theorem within_shift(x: u64, n, a, b: Nat, in: x.within(a, b), fits: b * Nat::pow(2, n) <= word_top()):
    (x << n).within(a * Nat::pow(2, n), b * Nat::pow(2, n)) {
    let high: (x.toNat() * Nat::pow(2, n) <= b * Nat::pow(2, n)) = Nat::mul_le_mono_r(Nat::pow(2, n), x.toNat(), b, in.right);
    j(sym(BitVec::toNat_shift_left(64, x, n, Nat::le_trans(x.toNat() * Nat::pow(2, n), b * Nat::pow(2, n), word_top(), high, fits))),
        λ m _ => (a * Nat::pow(2, n) <= m) ∧ (m <= b * Nat::pow(2, n)), ⟨Nat::mul_le_mono_r(Nat::pow(2, n), a, x.toNat(), in.left), high⟩)
}

// A word made from a narrower value is below that width's power.
rule theorem within_narrow(from: Nat, s: BitVec(from)): s.resize(64).within(0, Nat::pow(2, from) - 1) {
    let below: (Succ(s.toNat()) <= Nat::pow(2, from)) = BitVec::toNat_lt_pow(from, s);
    let under: (s.toNat() <= Nat::pow(2, from) - 1) = omega(below);
    ⟨trivial, Nat::le_trans(s.resize(64).toNat(), s.toNat(), Nat::pow(2, from) - 1, BitVec::toNat_ofNat_le(64, s.toNat()), under)⟩
}

// A word narrowed and widened again is itself where it was within the
// narrow width: the two resizes are a move.
rule theorem narrow_back(s: u64, from, high: Nat, small: s.within(0, high), fits: Succ(high) <= Nat::pow(2, from)): s.resize(from).resize(64) = s {
    let below: (s.toNat() < Nat::pow(2, from)) = Nat::le_trans(Succ(s.toNat()), Succ(high), Nat::pow(2, from), small.right, fits);
    trans(cong_fn(λ (n: Nat) => BitVec::ofNat(n, n := 64), BitVec::toNat_ofNat(from, s.toNat(), below)), BitVec::ofNat_toNat(64, s))
}

// An or is at most its operands added, which is exact where they share no
// bit: bytes joined by shifts stay within the word they make.
rule theorem within_or(l, r: u64, a, b: Nat, left: l.within(0, a), right: r.within(0, b)): (l | r).within(0, a + b) {
    ⟨trivial, Nat::le_trans(l.bor(r).toNat(), l.toNat() + r.toNat(), a + b, BitVec::toNat_bor_le_add(64, l, r),
        Nat::add_le_mono(l.toNat(), a, r.toNat(), b, left.right, right.right))⟩
}

// An and is at most either operand.
rule theorem within_and(l, r: u64, a: Nat, left: l.within(0, a)): (l & r).within(0, a) {
    ⟨trivial, Nat::le_trans(l.band(r).toNat(), l.toNat(), a, BitVec::toNat_band_le_left(64, l, r), left.right)⟩
}

rule theorem within_and_right(l, r: u64, b: Nat, right: r.within(0, b)): (l & r).within(0, b) {
    ⟨trivial, Nat::le_trans(l.band(r).toNat(), r.toNat(), b, BitVec::toNat_band_le_right(64, l, r), right.right)⟩
}

// What an unsigned comparison's bit says of its operands, and what they say
// of it.
theorem below_of_bit(l, r: u64, set: BitVec::ofBool(l.unsigned_lt_bit(r)) = BitVec::ofNat(1)): l.toNat() < r.toNat() {
    BitVec::borrow_sub_bit_true_iff(64, l, r).mp(trans(sym(BitVec::head_bit_ofBool(l.unsigned_lt_bit(r))),
        trans(cong_fn(λ (w: BitVec(1)) => w.head_bit(), set), BitVec::head_bit_ofBool(True))))
}

theorem bit_of_below(l, r: u64, lt: l.toNat() < r.toNat()): BitVec::ofBool(l.unsigned_lt_bit(r)) = BitVec::ofNat(1) {
    cong_fn(λ (bit: Bool) => BitVec::ofBool(bit), BitVec::borrow_sub_bit_true_iff(64, l, r).mpr(lt))
}

theorem above_of_bit(l, r: u64, clear: BitVec::ofBool(l.unsigned_lt_bit(r)) = BitVec::ofNat(0)): r.toNat() <= l.toNat() {
    l.toNat().le_of_not_lt(r.toNat(), λ lt => absurd(trans(sym(BitVec::borrow_sub_bit_true_iff(64, l, r).mpr(lt)),
        trans(sym(BitVec::head_bit_ofBool(l.unsigned_lt_bit(r))), trans(cong_fn(λ (w: BitVec(1)) => w.head_bit(), clear), BitVec::head_bit_ofBool(False))))))
}

theorem bit_of_above(l, r: u64, ge: r.toNat() <= l.toNat()): BitVec::ofBool(l.unsigned_lt_bit(r)) = BitVec::ofNat(0) {
    let clear: (l.unsigned_lt_bit(r) = False) = (match l.unsigned_lt_bit(r) as λ bit => l.unsigned_lt_bit(r) = bit → bit = False {
        False => λ _ => refl,
        True => λ set => false_elim(l.toNat().lt_irrefl(Nat::lt_of_lt_of_le(l.toNat(), r.toNat(), l.toNat(),
            BitVec::borrow_sub_bit_true_iff(64, l, r).mp(set), ge))),
    })(refl);
    cong_fn(λ (bit: Bool) => BitVec::ofBool(bit), clear)
}

// A comparison of a word below another's least value is one.
rule theorem below_yes(l, r: u64, a, b: Nat, left: l.within(0, a), right: r.within(b, word_top()), apart: a < b): l.below(r) = 1 {
    bit_of_below(l, r, Nat::le_trans(Succ(l.toNat()), b, r.toNat(), Nat::le_trans(Succ(l.toNat()), Succ(a), b, left.right, apart), right.left))
}

// A comparison of a word at least another's greatest value is zero.
rule theorem below_no(l, r: u64, a, b: Nat, left: l.within(a, word_top()), right: r.within(0, b), apart: b <= a): l.below(r) = 0 {
    bit_of_above(l, r, Nat::le_trans(r.toNat(), b, l.toNat(), right.right, Nat::le_trans(b, a, l.toNat(), apart, left.left)))
}

// Where a comparison's bit is one, its left is below its right's bound,
// and its right above its left's.
rule theorem below_left(l, r: u64, b: Nat, below: l.below(r) = 1, right: r.within(0, Succ(b))): l.within(0, b) {
    let bit: (l.unsigned_lt_bit(r) = True) = trans(sym(BitVec::head_bit_ofBool(l.unsigned_lt_bit(r))),
        trans(cong_fn(λ (w: BitVec(1)) => w.head_bit(), below), BitVec::head_bit_ofBool(True)));
    let lt: (l.toNat() < r.toNat()) = BitVec::borrow_sub_bit_true_iff(64, l, r).mp(bit);
    ⟨trivial, Nat::le_trans(Succ(l.toNat()), r.toNat(), Succ(b), lt, right.right)⟩
}

rule theorem below_right(l, r: u64, a: Nat, below: l.below(r) = 1, left: l.within(a, word_top())): r.within(Succ(a), word_top()) {
    ⟨Nat::le_trans(Succ(a), Succ(l.toNat()), r.toNat(), left.left, below_of_bit(l, r, below)), Range::any_holds(r).right⟩
}

// Where it is zero, its left is at least its right's least value, and
// its right at most its left's greatest.
rule theorem above_left(l, r: u64, a: Nat, clear: l.below(r) = 0, right: r.within(a, word_top())): l.within(a, word_top()) {
    ⟨Nat::le_trans(a, r.toNat(), l.toNat(), right.left, above_of_bit(l, r, clear)), Range::any_holds(l).right⟩
}

rule theorem above_right(l, r: u64, b: Nat, clear: l.below(r) = 0, left: l.within(0, b)): r.within(0, b) {
    ⟨trivial, Nat::le_trans(r.toNat(), l.toNat(), b, above_of_bit(l, r, clear), left.right)⟩
}

// A one-bit or that is clear has both its bits clear: what the arm of a
// test of several bounds starts from.
theorem or_clear_bools(p, q: Bool): BitVec::ofBool(p).bor(BitVec::ofBool(q)) = BitVec::ofNat(0, n := 1) → (p = False) ∧ (q = False) {
    match p {
        True => λ h => absurd(cong_fn(λ (b: BitVec(1)) => b.head_bit(), h)),
        False => match q {
            True => λ h => absurd(cong_fn(λ (b: BitVec(1)) => b.head_bit(), h)),
            False => λ _ => ⟨refl, refl⟩,
        },
    }
}

theorem or_clear(x, y: BitVec(1), clear: x.bor(y) = BitVec::ofNat(0)): (x = BitVec::ofNat(0)) ∧ (y = BitVec::ofNat(0)) {
    let as_bools: (BitVec::ofBool(x.head_bit()).bor(BitVec::ofBool(y.head_bit())) = BitVec::ofNat(0, n := 1)) =
        j(BitVec::one_bit_eq_ofBool(y), λ w _ => BitVec::ofBool(x.head_bit()).bor(w) = BitVec::ofNat(0, n := 1),
            j(BitVec::one_bit_eq_ofBool(x), λ w _ => w.bor(y) = BitVec::ofNat(0, n := 1), clear));
    let bits = or_clear_bools(x.head_bit(), y.head_bit(), as_bools);
    ⟨trans(trans(BitVec::one_bit_eq_ofBool(x), cong_fn(λ (h: Bool) => BitVec::ofBool(h), bits.left)), bit_clear()),
        trans(trans(BitVec::one_bit_eq_ofBool(y), cong_fn(λ (h: Bool) => BitVec::ofBool(h), bits.right)), bit_clear())⟩
}

rule theorem or_clear_left(a, b: BitVec(1), clear: a | b = 0): a = 0 { or_clear(a, b, clear).left }

rule theorem or_clear_right(a, b: BitVec(1), clear: a | b = 0): b = 0 { or_clear(a, b, clear).right }

// The other way: an or of two clear bits is clear, and an or with a set
// bit is set. A test of several bounds is decided where each of them is.
theorem or_of_clear_bits(x, y: BitVec(1), left: x = BitVec::ofNat(0), right: y = BitVec::ofNat(0)): x.bor(y) = BitVec::ofNat(0) {
    j(sym(left), λ w _ => w.bor(y) = BitVec::ofNat(0, n := 1), j(sym(right), λ w _ => BitVec::ofNat(0, n := 1).bor(w) = BitVec::ofNat(0, n := 1), refl))
}

theorem set_or_bool(q: Bool): BitVec::ofNat(1, n := 1).bor(BitVec::ofBool(q)) = BitVec::ofNat(1, n := 1) { match q { True => refl, False => refl } }
theorem bool_or_set(p: Bool): BitVec::ofBool(p).bor(BitVec::ofNat(1, n := 1)) = BitVec::ofNat(1, n := 1) { match p { True => refl, False => refl } }

theorem or_of_set_bit(x, y: BitVec(1), set: x = BitVec::ofNat(1)): x.bor(y) = BitVec::ofNat(1) {
    j(sym(set), λ w _ => w.bor(y) = BitVec::ofNat(1, n := 1),
        j(sym(BitVec::one_bit_eq_ofBool(y)), λ w _ => BitVec::ofNat(1, n := 1).bor(w) = BitVec::ofNat(1, n := 1), set_or_bool(y.head_bit())))
}

theorem or_of_set_bit_right(x, y: BitVec(1), set: y = BitVec::ofNat(1)): x.bor(y) = BitVec::ofNat(1) {
    j(sym(set), λ w _ => x.bor(w) = BitVec::ofNat(1, n := 1),
        j(sym(BitVec::one_bit_eq_ofBool(x)), λ w _ => w.bor(BitVec::ofNat(1, n := 1)) = BitVec::ofNat(1, n := 1), bool_or_set(x.head_bit())))
}

rule theorem or_of_clear(a, b: BitVec(1), left: a = 0, right: b = 0): a | b = 0 {
    or_of_clear_bits(a, b, left, right)
}

rule theorem or_of_set(a, b: BitVec(1), set: a = 1): a | b = 1 { or_of_set_bit(a, b, set) }

rule theorem or_of_set_right(a, b: BitVec(1), set: b = 1): a | b = 1 { or_of_set_bit_right(a, b, set) }

// ---------------------------------------------------------------------------
// Orders: a word and a number at most another word and a number, where no
// range of either is known (`Fact::AtMost`). A comparison's bit gives one
// and one decides a comparison; a sum with a constant that did not wrap is
// its operand and the constant, both ways; two that meet at a word join.
// What a path of them from an index to a length says is that the index is
// below the length, with no range of either (the inequality graph of
// Bodik, Gupta and Sarkar's ABCD, here with the path as the proof).

theorem order_joined(x, y, z, m, n, p, q, u, v: Nat, first: x + m <= y + n, second: y + p <= z + q, slack: u + (n + q) <= v + (m + p)):
    x + u <= z + v {
    omega(first, second, slack)
}

rule theorem order_set(l, r: u64, below: l.below(r) = 1): l.toNat() + 1 <= r.toNat() + 0 {
    let lt = below_of_bit(l, r, below);
    omega(lt)
}

rule theorem order_clear(l, r: u64, clear: l.below(r) = 0): r.toNat() + 0 <= l.toNat() + 0 {
    let ge = above_of_bit(l, r, clear);
    omega(ge)
}

// A comparison of two words in order is decided.
rule theorem ordered_below(l, r: u64, order: l.toNat() + 1 <= r.toNat() + 0): l.below(r) = 1 {
    bit_of_below(l, r, omega(order))
}

rule theorem ordered_not_below(l, r: u64, order: r.toNat() + 0 <= l.toNat() + 0): l.below(r) = 0 {
    bit_of_above(l, r, omega(order))
}

// Two orders that meet at a word, and any order their sum gives.
rule theorem order_join(x, y, z: u64, m, n, p, q, u, v: Nat, first: x.toNat() + m <= y.toNat() + n, second: y.toNat() + p <= z.toNat() + q,
    slack: u + (n + q) <= v + (m + p)): x.toNat() + u <= z.toNat() + v {
    omega(first, second, slack)
}

// A sum with a constant, as a number: the operand and the constant, to
// the word's modulus.
theorem sum_number(i: u64, v: Nat, fits: v < Nat::pow(2, 64)): i.add(BitVec::ofNat(v)).toNat() = (i.toNat() + v).mod(Nat::pow(2, 64)) {
    trans(BitVec::toNat_add_mod(64, i, BitVec::ofNat(v)), cong_fn(λ (n: Nat) => (i.toNat() + n).mod(Nat::pow(2, 64)), BitVec::toNat_ofNat(64, v, fits)))
}

// A sum to a modulus that is at least its left operand did not wrap.
theorem sum_kept(x, k, n: Nat, low: x < n, small: k < n, kept: x <= (x + k).mod(n)): (x + k).mod(n) = x + k {
    match (x + k).lt_or_ge(n) {
        Inl(under) => (x + k).mod_of_lt(n, under),
        Inr(over) => {
            let parts: (1 * n + (x + k - n) = x + k) = omega(over);
            let bound: (x + k - n < n) = omega(low, small);
            let wrapped: ((x + k).mod(n) = x + k - n) = (x + k).div_mod_unique(n, 1, x + k - n, parts, bound).right;
            false_elim(omega(wrapped, kept, small, over))
        },
    }
}

// Where the sum is at least its operand, which a test may say: the sum is
// the operand and the constant.
theorem sum_is_tested(i: u64, v: Nat, fits: v <= word_top(), kept: i.toNat() + 0 <= i.add(BitVec::ofNat(v)).toNat() + 0):
    i.add(BitVec::ofNat(v)).toNat() = i.toNat() + v {
    let is = sum_number(i, v, fits);
    let above: (i.toNat() <= (i.toNat() + v).mod(Nat::pow(2, 64))) = j(is, λ n _ => i.toNat() <= n, omega(kept));
    trans(is, sum_kept(i.toNat(), v, Nat::pow(2, 64), BitVec::toNat_lt_pow(64, i), fits, above))
}

rule theorem sum_tested_low(i: u64, v: Nat, kept: i.toNat() + 0 <= (i + BitVec::ofNat(v)).toNat() + 0, fits: v <= word_top()):
    i.toNat() + v <= (i + BitVec::ofNat(v)).toNat() + 0 {
    let is = sum_is_tested(i, v, fits, kept);
    omega(is)
}

rule theorem sum_tested_high(i: u64, v: Nat, kept: i.toNat() + 0 <= (i + BitVec::ofNat(v)).toNat() + 0, fits: v <= word_top()):
    (i + BitVec::ofNat(v)).toNat() + 0 <= i.toNat() + v {
    let is = sum_is_tested(i, v, fits, kept);
    omega(is)
}

// Where the operand and at least the constant are at most a word, which
// is below the modulus: the same.
theorem sum_under(x, v, m, y, n, top: Nat, room: x + m <= y + n, word: y < top, least: v + n <= m): x + v < top { omega(room, word, least) }
theorem sum_part(x, v, top: Nat, under: x + v < top): v < top { omega(under) }

theorem sum_is_roomed(i, x: u64, v, m, n: Nat, room: i.toNat() + m <= x.toNat() + n, least: v + n <= m): i.add(BitVec::ofNat(v)).toNat() = i.toNat() + v {
    let under: (i.toNat() + v < Nat::pow(2, 64)) = sum_under(i.toNat(), v, m, x.toNat(), n, Nat::pow(2, 64), room, BitVec::toNat_lt_pow(64, x), least);
    trans(sum_number(i, v, sum_part(i.toNat(), v, Nat::pow(2, 64), under)), (i.toNat() + v).mod_of_lt(Nat::pow(2, 64), under))
}

rule theorem sum_roomed_low(i, x: u64, v, m, n: Nat, room: i.toNat() + m <= x.toNat() + n, least: v + n <= m):
    i.toNat() + v <= (i + BitVec::ofNat(v)).toNat() + 0 {
    let is = sum_is_roomed(i, x, v, m, n, room, least);
    omega(is)
}

rule theorem sum_roomed_high(i, x: u64, v, m, n: Nat, room: i.toNat() + m <= x.toNat() + n, least: v + n <= m):
    (i + BitVec::ofNat(v)).toNat() + 0 <= i.toNat() + v {
    let is = sum_is_roomed(i, x, v, m, n, room, least);
    omega(is)
}

// Where the operand's range has room for the constant below the word's
// top: the same. So a sum is known not to wrap by a test of it, by an
// order with room, or by a range with room.
theorem sum_is_within(i: u64, v, a, b: Nat, range: Range(a, b).Holds(i), fits: b + v <= word_top()): i.add(BitVec::ofNat(v)).toNat() = i.toNat() + v {
    let under: (i.toNat() + v <= word_top()) = omega(range.right, fits);
    trans(sum_number(i, v, sum_part(i.toNat(), v, Nat::pow(2, 64), under)), (i.toNat() + v).mod_of_lt(Nat::pow(2, 64), under))
}

rule theorem sum_within_low(i: u64, v, a, b: Nat, range: i.within(a, b), fits: b + v <= word_top()): i.toNat() + v <= (i + BitVec::ofNat(v)).toNat() + 0 {
    let is = sum_is_within(i, v, a, b, range, fits);
    omega(is)
}

rule theorem sum_within_high(i: u64, v, a, b: Nat, range: i.within(a, b), fits: b + v <= word_top()): (i + BitVec::ofNat(v)).toNat() + 0 <= i.toNat() + v {
    let is = sum_is_within(i, v, a, b, range, fits);
    omega(is)
}

// ---------------------------------------------------------------------------
// Memory. A premise `Loaded` is a node that read the buffers as they are
// where the rule is used: nothing stored between it and there.

// The byte a load read is the byte an earlier one read at the same index
// of the same buffer. The earlier one may be what a store read back.
rule theorem load_again(f: BufferNow, i, a, b: u64, first: a = f.byte(i), second: b = f.byte(i)): b = a { trans(second, sym(first)) }

// ---------------------------------------------------------------------------
// Bytes joined. `Joined(o, f, i, n, sh)` says the word `o` is the `n`
// bytes of buffer `f` from the index `i`, the first the most significant,
// shifted left by `sh` (`buffer_join`). A byte load starts one, a shift
// moves it, an or of two that are side by side in the buffer and in the
// word is the longer one, and four bytes unshifted are the word one load
// reads, swapped. However the bytes were joined, the rules meet at the
// same fact.

rule theorem join_byte(f: BufferNow, i, b: u64, loaded: b = f.byte(i)): b = f.join(i, 1) << 0 {
    trans(loaded, sym(buffer_join_one(f.all, f.number, i.toNat())))
}

rule theorem join_shift(f: BufferNow, i, a: u64, n, sh, c: Nat, joined: a = f.join(i, n) << sh): a << c = f.join(i, n) << (sh + c) {
    trans(cong_fn(λ (z: u64) => z.shift_left(c), joined), sym(f.join(i, n).shift_left_add(sh, c)))
}

// Two joins side by side: the second starts where the first ends, which
// the two orders say of the indexes as numbers, and the first is shifted
// past the second's bytes.
theorem joins_meet(buffers: Buffers(), f, x, y, n, m, sh: Nat, after: x + n <= y + 0, before: y + 0 <= x + n):
    buffer_join(buffers, f, x, n).shift_left(8 * m + sh).bor(buffer_join(buffers, f, y, m).shift_left(sh)) =
        buffer_join(buffers, f, x, n + m).shift_left(sh) {
    let a = buffer_join(buffers, f, x, n);
    let at: (y = x + n) = omega(after, before);
    trans(cong_fn(λ (k: Nat) => a.shift_left(8 * m + sh).bor(buffer_join(buffers, f, k, m).shift_left(sh)), at),
        trans(cong_fn(λ (z: BitVec(64)) => z.bor(buffer_join(buffers, f, x + n, m).shift_left(sh)), a.shift_left_add(8 * m, sh)),
            trans(sym(a.shift_left(8 * m).shift_left_bor(buffer_join(buffers, f, x + n, m), sh)),
                cong_fn(λ (z: BitVec(64)) => z.shift_left(sh), sym(buffer_join_split(buffers, f, x, n, m))))))
}

rule theorem join_or(f: BufferNow, i, j, a, b: u64, n, m, sh: Nat, first: a = f.join(i, n) << (8 * m + sh), second: b = f.join(j, m) << sh,
    after: i.toNat() + n <= j.toNat() + 0, before: j.toNat() + 0 <= i.toNat() + n): a | b = f.join(i, n + m) << sh {
    trans(cong_fn(λ (z: u64) => z.bor(b), first), trans(cong_fn(λ (z: u64) => f.join(i, n).shift_left(8 * m + sh).bor(z), second),
        joins_meet(f.all, f.number, i.toNat(), j.toNat(), n, m, sh, after, before)))
}

// The same with the or's operands the other way round.
rule theorem join_or_right(f: BufferNow, i, j, a, b: u64, n, m, sh: Nat, first: a = f.join(i, n) << (8 * m + sh), second: b = f.join(j, m) << sh,
    after: i.toNat() + n <= j.toNat() + 0, before: j.toNat() + 0 <= i.toNat() + n): b | a = f.join(i, n + m) << sh {
    trans(BitVec::bor_comm(64, b, a), trans(cong_fn(λ (z: u64) => z.bor(b), first), trans(cong_fn(λ (z: u64) => f.join(i, n).shift_left(8 * m + sh).bor(z), second),
        joins_meet(f.all, f.number, i.toNat(), j.toNat(), n, m, sh, after, before))))
}

// Four bytes joined and unshifted are what one four-byte load reads at
// the same index, swapped and widened: the word is that one's.
rule theorem join_word(f: BufferNow, i, o: u64, w: u32, r: u64, joined: o = f.join(i, 4) << 0, loaded: w = f.word(i),
    widened: r = w.swap_bytes().resize(64)): o = r {
    trans(joined, trans(buffer_join_four(f.all, f.number, i.toNat()),
        sym(trans(widened, cong_fn(λ (z: u32) => BitVec::ofNat(z.swap_bytes().toNat(), n := 64), loaded)))))
}

// ---------------------------------------------------------------------------
// A word's bytes in other words. `Low(x, w, sh)` says the low byte of `x`
// is the low byte of `w` shifted right by `sh`: a byte store of `x` writes
// that byte of `w`. A word narrowed to a byte and widened keeps its low
// byte, and a shift under it adds to the shift. `Split(v, a, b, c, d)` says
// the four bytes of the 32-bit word `v`, low first, are the low bytes of
// `a` to `d`: four byte stores of those, at four indexes in a row, are one
// store of `v` (`Paid::Together`). However the bytes were taken, the rules
// meet at that fact: the low half's bytes from the highest are the half
// swapped, and from the lowest the half itself.

rule theorem low_narrowed(a: u64): a.resize(8).resize(64).low_of(a, 0) {
    let back: (a.resize(8).resize(64).resize(8) = a.resize(8)) = BitVec::resize_round_trip(8, 64, Nat::leb_sound(8, 64, trivial), a.resize(8));
    trans(sym(BitVec::resize_truncate(8, 56, a.resize(8).resize(64))), trans(back, BitVec::resize_truncate(8, 56, a)))
}

rule theorem low_shifted(x, w: u64, c, sh: Nat, low: x.low_of(w >> c, sh)): x.low_of(w, c + sh) {
    trans(low, cong_fn(λ (z: u64) => low_byte(z), sym(w.shift_right_add(c, sh))))
}

// The bytes of a word's low half swapped, low first, are the word's low
// bytes from the highest of the half.
theorem swapped_bytes(word: BitVec(64), v: BitVec(32), swapped: v = word.truncate(32, 32).byte_swap(4)):
    (word_byte(v, 0) = low_byte(word.shift_right(24))) ∧ ((word_byte(v, 1) = low_byte(word.shift_right(16))) ∧
        ((word_byte(v, 2) = low_byte(word.shift_right(8))) ∧ (word_byte(v, 3) = low_byte(word.shift_right(0))))) {
    let at = λ (k: Nat) => cong_fn(λ (bytes: [BitVec(8); 4]) => vector_get(bytes, k, BitVec::zero()), BitVec::be_bytes_32(word));
    j(sym(swapped), λ z _ => (word_byte(z, 0) = low_byte(word.shift_right(24))) ∧ ((word_byte(z, 1) = low_byte(word.shift_right(16))) ∧
        ((word_byte(z, 2) = low_byte(word.shift_right(8))) ∧ (word_byte(z, 3) = low_byte(word.shift_right(0))))),
        ⟨at(0), ⟨at(1), ⟨at(2), at(3)⟩⟩⟩)
}

// And of the half itself, from the lowest.
theorem plain_bytes(word: BitVec(64), v: BitVec(32), narrowed: v = word.truncate(32, 32)):
    (word_byte(v, 0) = low_byte(word.shift_right(0))) ∧ ((word_byte(v, 1) = low_byte(word.shift_right(8))) ∧
        ((word_byte(v, 2) = low_byte(word.shift_right(16))) ∧ (word_byte(v, 3) = low_byte(word.shift_right(24))))) {
    j(sym(narrowed), λ z _ => (word_byte(z, 0) = low_byte(word.shift_right(0))) ∧ ((word_byte(z, 1) = low_byte(word.shift_right(8))) ∧
        ((word_byte(z, 2) = low_byte(word.shift_right(16))) ∧ (word_byte(z, 3) = low_byte(word.shift_right(24))))),
        ⟨refl, ⟨refl, ⟨refl, refl⟩⟩⟩)
}

rule theorem split_swapped(w, x0, x1, x2, x3: u64, l0: x0.low_of(w, 24), l1: x1.low_of(w, 16), l2: x2.low_of(w, 8), l3: x3.low_of(w, 0)):
    w.resize(32).swap_bytes().quarters(x0, x1, x2, x3) {
    let swapped: (w.resize(32).swap_bytes() = w.truncate(32, 32).byte_swap(4)) =
        trans(cong_fn(λ (z: u32) => z.swap_bytes(), BitVec::resize_truncate(32, 32, w)), BitVec::swap_bytes_32(w.truncate(32, 32)));
    let bytes = swapped_bytes(w, w.resize(32).swap_bytes(), swapped);
    ⟨trans(bytes.left, sym(l0)), ⟨trans(bytes.right.left, sym(l1)), ⟨trans(bytes.right.right.left, sym(l2)), trans(bytes.right.right.right, sym(l3))⟩⟩⟩
}

rule theorem split_plain(w, x0, x1, x2, x3: u64, l0: x0.low_of(w, 0), l1: x1.low_of(w, 8), l2: x2.low_of(w, 16), l3: x3.low_of(w, 24)):
    w.resize(32).quarters(x0, x1, x2, x3) {
    let bytes = plain_bytes(w, w.resize(32), BitVec::resize_truncate(32, 32, w));
    ⟨trans(bytes.left, sym(l0)), ⟨trans(bytes.right.left, sym(l1)), ⟨trans(bytes.right.right.left, sym(l2)), trans(bytes.right.right.right, sym(l3))⟩⟩⟩
}

// ---------------------------------------------------------------------------
// A word swapped twice. The half of a 32-bit word widened is the word, and
// a swap of a swap is the word: a word loaded big-endian and stored
// big-endian is the word loaded, and the store needs neither swap.

// Its numbers: the word, then the last swap, the narrowing, the widening
// and the first swap.
rule theorem swap_twice(w: u32): w.swap_bytes().resize(64).resize(32).swap_bytes() = w {
    let back: (w.swap_bytes().resize(64).resize(32) = w.swap_bytes()) = BitVec::resize_round_trip(32, 64, Nat::leb_sound(32, 64, trivial), w.swap_bytes());
    trans(cong_fn(λ (z: u32) => z.swap_bytes(), trans(back, BitVec::swap_bytes_32(w))),
        trans(BitVec::swap_bytes_32(w.byte_swap(4)), BitVec::byte_swap_byte_swap(4, w)))
}

// The library's rules, each in its place: a plan's `Derive` steps index
// the table by place, so a rule keeps its own and new ones are added at
// the end.
fn library() → List<RuleEntry> {
    [
        add_zero_entry,
        move_move_entry,
        // 2
        within_const_entry,
        within_move_entry,
        within_add_entry,
        within_shift_entry,
        within_narrow_entry,
        // 7
        below_yes_entry,
        below_no_entry,
        // 9
        below_left_entry,
        below_right_entry,
        above_left_entry,
        above_right_entry,
        // 13
        or_clear_left_entry,
        or_clear_right_entry,
        // 15
        narrow_back_entry,
        within_or_entry,
        within_and_entry,
        within_and_right_entry,
        // 19
        load_again_entry,
        // 20
        order_set_entry,
        order_clear_entry,
        ordered_below_entry,
        ordered_not_below_entry,
        // 24
        order_join_entry,
        // 25
        sum_tested_low_entry,
        sum_tested_high_entry,
        sum_roomed_low_entry,
        sum_roomed_high_entry,
        // 29
        join_byte_entry,
        join_shift_entry,
        join_or_entry,
        join_or_right_entry,
        // 33
        join_word_entry,
        // 34
        sum_within_low_entry,
        sum_within_high_entry,
        // 36
        or_of_clear_entry,
        or_of_set_entry,
        or_of_set_right_entry,
        // 39
        within_sub_entry,
        // 40
        low_narrowed_entry,
        low_shifted_entry,
        // 42
        split_swapped_entry,
        split_plain_entry,
        // 44
        swap_twice_entry,
    ]
}

fn entries_rules(entries: List<RuleEntry>) → List<Rule> { match entries { Nil => [], Cons(entry, rest) => Cons(entry.rule, entries_rules(rest)) } }

// The table a plan's `Derive` steps index.
fn rules() → List<Rule> { entries_rules(library()) }

// The rules the search applies wherever their statement fits
// (function_ir_match): each rewrites a node as the one its conclusion
// gives, or, where its conclusion is that a bit is a constant, decides
// the bit (a comparison whose operands' ranges lie apart, an or of bits
// decided). One is added here and nothing else is written for it.
fn matchable() → List<Matchable> {
    [add_zero_entry.at(0), below_yes_entry.at(7), below_no_entry.at(8), narrow_back_entry.at(15), or_of_clear_entry.at(36), or_of_set_entry.at(37),
        or_of_set_right_entry.at(38), swap_twice_entry.at(44)]
}

// The rules that give the range of the word a node writes, read the same
// way: each is tried where a node is passed, and the narrowest range found
// is the word's.
fn ranging() → List<Matchable> {
    [
        within_const_entry.at(2),
        within_move_entry.at(3),
        within_add_entry.at(4),
        within_shift_entry.at(5),
        within_narrow_entry.at(6),
        within_or_entry.at(16),
        within_and_entry.at(17),
        within_and_right_entry.at(18),
        within_sub_entry.at(39),
    ]
}

// The rules a branch's test gives in the arm taken: each is read at the
// node whose bit its premises test, where the walk knows the bit, and
// narrows the range of the word its conclusion is about.
fn testing() → List<Matchable> {
    [below_left_entry.at_test(9), below_right_entry.at_test(10), above_left_entry.at_test(11), above_right_entry.at_test(12)]
}

// ---------------------------------------------------------------------------
// The tables of one compilation

// The library's rules in their places, then the rules registered from
// anywhere else (`RuleEntry`, function_ir_rule), in the order they are
// listed; and of those, the ones the search applies by matching: a rule
// that concludes a node rewrites, one that concludes a range gives ranges
// or says what a test gives.
record Tables { rules: List<Rule>, rewriting: List<Matchable>, ranging: List<Matchable>, testing: List<Matchable>, placed: List<RuleEntry>, learners: List<Learner> }

fn entries_added(entries: List<RuleEntry>) → List<RuleEntry> {
    match entries {
        Nil => [],
        Cons(entry, rest) => match entry.library { True => entries_added(rest), False => Cons(entry, entries_added(rest)) },
    }
}

fn entries_rewriting(entries: List<RuleEntry>, place: Nat) → List<Matchable> {
    match entries {
        Nil => [],
        Cons(entry, rest) => match entry.pattern.conclusion {
            Makes(_, _, _) => Cons(entry.at(place), entries_rewriting(rest, Succ(place))),
            _ => entries_rewriting(rest, Succ(place)),
        },
    }
}

// A rule that concludes a range gives the range of the word a node
// writes where a premise is that node, and otherwise says what a test
// gives, where its premises test a bit.
fn entries_ranging(entries: List<RuleEntry>, place: Nat) → List<Matchable> {
    match entries {
        Nil => [],
        Cons(entry, rest) => match entry.pattern.conclusion {
            Ranges(_, _, _) => match entry.pattern.head() {
                Some(_) => Cons(entry.at(place), entries_ranging(rest, Succ(place))),
                None => entries_ranging(rest, Succ(place)),
            },
            _ => entries_ranging(rest, Succ(place)),
        },
    }
}

fn entries_testing(entries: List<RuleEntry>, place: Nat) → List<Matchable> {
    match entries {
        Nil => [],
        Cons(entry, rest) => match entry.pattern.conclusion {
            Ranges(_, _, _) => match entry.pattern.head() {
                Some(_) => entries_testing(rest, Succ(place)),
                None => match entry.pattern.tested() {
                    Some(_) => Cons(entry.at_test(place), entries_testing(rest, Succ(place))),
                    None => entries_testing(rest, Succ(place)),
                },
            },
            _ => entries_testing(rest, Succ(place)),
        },
    }
}

// Every rule of a compilation in its place, for what is said of a plan.
fn entries_placed(entries: List<RuleEntry>) → List<RuleEntry> { library() ++ entries_added(entries) }

// The rules a plan's steps index where `entries` are registered.
fn rules_with(entries: List<RuleEntry>) → List<Rule> { rules() ++ entries_rules(entries_added(entries)) }

fn Tables::of(entries: List<RuleEntry>, learners: List<Learner>) → Tables {
    shared(entries_added(entries), λ added => shared(rules(), λ library => shared(library.len(), λ first =>
        Tables(library ++ entries_rules(added), matchable() ++ entries_rewriting(added, first), ranging() ++ entries_ranging(added, first),
            testing() ++ entries_testing(added, first), entries_placed(entries), learners))))
}

// FunctionIR's state edges evaluated (issues/native-source-bytes.md;
// docs/native/native-effect-source-design.md §6): `run` is `eval` with a file of
// buffers threaded through the schedule, the one state a region's byte nodes
// act on.
//
// A `BufferLoad` reads a byte of the file and a `BufferStore` writes one, in
// schedule order: for byte nodes on one buffer the schedule is an order,
// not only a validation aid. Every other node leaves the file as it was; a
// conditional runs the arm its bit picks, and a loop carries the file from
// pass to pass. A call is answered over the file as it is when the call is
// made, with a word and the file its callee leaves (`Writers`), and the
// statement after it starts from that file
// (docs/native/native-one-compiler-design.md §2.6): which of its buffers a callee
// sees, and what it gives back, is the caller's to say
// (`program_writers`, function_ir_placeless).
//
// `eval` stays the word evaluator S4's lowering and compile-x86's
// certificates are stated over: a region that stores nothing, its callees
// leaving the file, runs as it evaluates over the file
// (`StructuredRegion::run_quiet`, function_ir_run). S4 lowers to registers
// only and refuses the byte nodes; the native compiler, which keeps every
// buffer in memory, compiles them (`native_compile`).
import function_ir;
import function_ir_eval;
import nat_map;
import bitvec;
import bitvec_bytes;
import bool;
import list;
import list_window;
import omega;
import logic;
import nat;
import option;
import vector;

// A region's words and the buffers beside them.
record State { values: Valuation(), buffers: Buffers() }

// A word's low byte, as a byte store sends it.
fn low_byte(word: BitVec(64)) → BitVec(8) { word.take_low(8, 56) }

// Byte `index` of buffer `buffer` set to `byte`, where the buffer has one.
fn store_byte(buffers: Buffers(), buffer, index: Nat, byte: BitVec(8)) → Buffers() {
    buffers.update(buffer, λ bytes => bytes.update(index, λ _ => byte))
}

// A store sets its byte of its buffer, where the buffer has one, and
// leaves every other buffer.
theorem buffer_bytes_stored(buffers: Buffers(), buffer, index: Nat, byte: BitVec(8)):
    buffer_bytes(store_byte(buffers, buffer, index, byte), buffer) =
        buffer_bytes(buffers, buffer).update(index, λ (_: BitVec(8)) => byte) {
    let set = λ (bytes: List<BitVec(8)>) => bytes.update(index, λ (_: BitVec(8)) => byte);
    let read = λ (found: Option<List<BitVec(8)>>) => match found { None => [], Some(bytes) => bytes };
    (match buffers.nth(buffer) as λ found => buffers.nth(buffer) = found →
        read(buffers.update(buffer, set).nth(buffer)) = set(read(found)) {
        None => λ none => cong_fn(read, buffers.nth_update_none(buffer, set, none)),
        Some(bytes) => λ some => cong_fn(read, buffers.nth_update_here(buffer, set, bytes, some)),
    })(refl)
}

theorem buffer_bytes_store_other(buffers: Buffers(), buffer, index: Nat, byte: BitVec(8), other: Nat, differs: buffer ≠ other):
    buffer_bytes(store_byte(buffers, buffer, index, byte), other) = buffer_bytes(buffers, other) {
    let set = λ (bytes: List<BitVec(8)>) => bytes.update(index, λ (_: BitVec(8)) => byte);
    let read = λ (found: Option<List<BitVec(8)>>) => match found { None => [], Some(bytes) => bytes };
    cong_fn(read, buffers.nth_update_other(buffer, set, other, λ same => differs(sym(same))))
}

// Bytes written over buffer `buffer` from `index`: what a store of them
// into a span leaves, where the buffer has room for them.
fn store_span(buffers: Buffers(), buffer, index: Nat, bytes: List<BitVec(8)>) → Buffers() {
    buffers.update(buffer, λ xs => xs.put_window(index, bytes))
}

theorem buffer_bytes_spanned(buffers: Buffers(), buffer, index: Nat, bytes: List<BitVec(8)>, inside: index < buffer_bytes(buffers, buffer).len()):
    buffer_bytes(store_span(buffers, buffer, index, bytes), buffer) = buffer_bytes(buffers, buffer).put_window(index, bytes) {
    let set = λ (xs: List<BitVec(8)>) => xs.put_window(index, bytes);
    let read = λ (found: Option<List<BitVec(8)>>) => match found { None => [], Some(xs) => xs };
    (match buffers.nth(buffer) as λ found => buffers.nth(buffer) = found → index < read(found).len() →
        read(buffers.update(buffer, set).nth(buffer)) = set(read(found)) {
        None => λ none below => false_elim(below),
        Some(xs) => λ some below => cong_fn(read, buffers.nth_update_here(buffer, set, xs, some)),
    })(refl, inside)
}

theorem buffer_bytes_span_other(buffers: Buffers(), buffer, index: Nat, bytes: List<BitVec(8)>, other: Nat, differs: buffer ≠ other):
    buffer_bytes(store_span(buffers, buffer, index, bytes), other) = buffer_bytes(buffers, other) {
    let set = λ (xs: List<BitVec(8)>) => xs.put_window(index, bytes);
    let read = λ (found: Option<List<BitVec(8)>>) => match found { None => [], Some(xs) => xs };
    cong_fn(read, buffers.nth_update_other(buffer, set, other, λ same => differs(sym(same))))
}

// Bytes stored from `index` of buffer `buffer`, the first at `index` and
// each where the buffer has one: one `store_byte` after another.
fn store_bytes(k: Nat, buffers: Buffers(), buffer, index: Nat, bytes: [BitVec(8); k]) → Buffers() {
    (match k as λ m => Buffers() → Nat → [BitVec(8); m] → Buffers() {
        Zero => λ file at bytes => file,
        Succ(_, ih) => λ file at bytes => ih(store_byte(file, buffer, at, head(bytes)), Succ(at), tail(bytes)),
    })(buffers, index, bytes)
}

// A word of `bytes` bytes stored from `index`, the least significant
// first: what `WideStore` does to the file.
fn store_word(buffers: Buffers(), buffer, index, bytes: Nat, word: BitVec(8 * bytes)) → Buffers() {
    store_bytes(bytes, buffers, buffer, index, word.bytes_le(bytes))
}

// The first byte is stored at `index`, then the rest from the next.
theorem store_bytes_succ(k: Nat, buffers: Buffers(), buffer, index: Nat, bytes: [BitVec(8); Succ(k)]):
    store_bytes(Succ(k), buffers, buffer, index, bytes) = store_bytes(k, store_byte(buffers, buffer, index, head(bytes)), buffer, Succ(index), tail(bytes)) {
    refl
}

// From no buffers there is nothing to store into.
theorem store_bytes_nil(k: Nat): (buffer, index: Nat) → (bytes: [BitVec(8); k]) → store_bytes(k, Nil, buffer, index, bytes) = Nil {
    match k as λ m => (buffer, index: Nat) → (bytes: [BitVec(8); m]) → store_bytes(m, Nil, buffer, index, bytes) = Nil {
        Zero => λ buffer index bytes => refl,
        Succ(j, ih) => λ buffer index bytes => ih(buffer, Succ(index), tail(bytes)),
    }
}

// A four-byte word is four byte stores, at `index + 0` to `index + 3`, its
// bytes low first.
theorem store_word_four(buffers: Buffers(), buffer, index: Nat, word: BitVec(32)):
    store_word(buffers, buffer, index, 4, word) =
        store_byte(store_byte(store_byte(store_byte(buffers, buffer, index, vector_get(word.bytes_le(4), 0, BitVec::zero())),
            buffer, index + 1, vector_get(word.bytes_le(4), 1, BitVec::zero())),
            buffer, index + 2, vector_get(word.bytes_le(4), 2, BitVec::zero())),
            buffer, index + 3, vector_get(word.bytes_le(4), 3, BitVec::zero())) {
    refl
}

// A word's four bytes, low first: what `store_word` stores of it.
fn four_bytes(word: BitVec(32)) → List<BitVec(8)> {
    [vector_get(word.bytes_le(4), 0, BitVec::zero()), vector_get(word.bytes_le(4), 1, BitVec::zero()),
     vector_get(word.bytes_le(4), 2, BitVec::zero()), vector_get(word.bytes_le(4), 3, BitVec::zero())]
}

// Inside its buffer, a four-byte word stored one byte at a time is its four
// bytes written over the buffer at once (`store_span`), what the machine's
// one store leaves; every other buffer is as it was either way.
theorem buffer_bytes_store_word_four(buffers: Buffers(), buffer, index: Nat, word: BitVec(32),
    fits: 4 + index <= buffer_bytes(buffers, buffer).len()):
    (other: Nat) → buffer_bytes(store_word(buffers, buffer, index, 4, word), other) =
        buffer_bytes(store_span(buffers, buffer, index, four_bytes(word)), other) {
    let c = λ (i: Nat) => vector_get(word.bytes_le(4), i, BitVec::zero());
    let s1 = store_byte(buffers, buffer, index, c(0));
    let s2 = store_byte(s1, buffer, index + 1, c(1));
    let s3 = store_byte(s2, buffer, index + 2, c(2));
    let xs = buffer_bytes(buffers, buffer);
    let written: (buffer_bytes(store_word(buffers, buffer, index, 4, word), buffer) =
            xs.update(index, λ (_: BitVec(8)) => c(0)).update(index + 1, λ (_: BitVec(8)) => c(1))
                .update(index + 2, λ (_: BitVec(8)) => c(2)).update(index + 3, λ (_: BitVec(8)) => c(3))) =
        trans(buffer_bytes_stored(s3, buffer, index + 3, c(3)),
            cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ ys => ys.update(index + 3, λ (_: BitVec(8)) => c(3)),
                trans(buffer_bytes_stored(s2, buffer, index + 2, c(2)),
                    cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ ys => ys.update(index + 2, λ (_: BitVec(8)) => c(2)),
                        trans(buffer_bytes_stored(s1, buffer, index + 1, c(1)),
                            cong_fn<List<BitVec(8)>, List<BitVec(8)>>(λ ys => ys.update(index + 1, λ (_: BitVec(8)) => c(1)),
                                buffer_bytes_stored(buffers, buffer, index, c(0))))))));
    let here: (buffer_bytes(store_word(buffers, buffer, index, 4, word), buffer) =
            buffer_bytes(store_span(buffers, buffer, index, four_bytes(word)), buffer)) =
        trans(written, trans(sym(List::put_window_update_from(four_bytes(word), xs, index, fits)),
            sym(buffer_bytes_spanned(buffers, buffer, index, four_bytes(word), omega(fits)))));
    λ other => match buffer.eq_dec(other) {
        Inl(same) => j(same, λ o _ => buffer_bytes(store_word(buffers, buffer, index, 4, word), o) =
            buffer_bytes(store_span(buffers, buffer, index, four_bytes(word)), o), here),
        Inr(differs) => trans(buffer_bytes_store_other(s3, buffer, index + 3, c(3), other, differs),
            trans(buffer_bytes_store_other(s2, buffer, index + 2, c(2), other, differs),
                trans(buffer_bytes_store_other(s1, buffer, index + 1, c(1), other, differs),
                    trans(buffer_bytes_store_other(buffers, buffer, index, c(0), other, differs),
                        sym(buffer_bytes_span_other(buffers, buffer, index, four_bytes(word), other, differs)))))),
    }
}

// ---------------------------------------------------------------------------
// Nodes

fn Node::run(self node: Node, values: Valuation(), buffers: Buffers()) → State {
    match node {
        BufferLoad(output, buffer, index) => State(Valuation::set(values, output, load_value(buffers, buffer, index, values)), buffers),
        BufferStore(output, buffer, index, value) => {
            let after = store_byte(buffers, buffer, values(64, index).toNat(), low_byte(values(64, value)));
            State(Valuation::set(values, output, load_value(after, buffer, index, values)), after)
        },
        WideLoad(bytes, output, buffer, index) => State(Valuation::set(values, output, wide_value(buffers, buffer, index, bytes, values)), buffers),
        WideStore(bytes, output, buffer, index, value) => {
            let after = store_word(buffers, buffer, values(64, index).toNat(), bytes, values(8 * bytes, value));
            State(Valuation::set(values, output, wide_value(after, buffer, index, bytes, values)), after)
        },
        _ => State(node.step(values), buffers),
    }
}

fn run_nodes(nodes: List<Node>, values: Valuation(), buffers: Buffers()) → State {
    match nodes {
        Nil => State(values, buffers),
        Cons(node, rest) => {
            let after = node.run(values, buffers);
            run_nodes(rest, after.values, after.buffers)
        },
    }
}

// Whether a node touches no buffer.
fn Node::pure(self node: Node) → Bool {
    match node { BufferLoad(_, _, _) => False, BufferStore(_, _, _, _) => False, WideLoad(_, _, _, _) => False, WideStore(_, _, _, _, _) => False, _ => True }
}

fn nodes_pure(nodes: List<Node>) → Bool {
    match nodes { Nil => True, Cons(node, rest) => node.pure() && nodes_pure(rest) }
}

// A node that touches no buffer runs as it evaluates.
theorem Node::run_pure(self node: Node, values: Valuation(), buffers: Buffers(), pure: node.pure().IsTrue()):
    node.run(values, buffers) = State(node.step(values), buffers) {
    match node as λ n => n.pure().IsTrue() → n.run(values, buffers) = State(n.step(values), buffers) {
        Const(_, _, _) => λ _ => refl,
        Move(_, _, _) => λ _ => refl,
        Add(_, _, _, _) => λ _ => refl,
        Sub(_, _, _, _) => λ _ => refl,
        BitAnd(_, _, _, _) => λ _ => refl,
        BitOr(_, _, _, _) => λ _ => refl,
        BitXor(_, _, _, _) => λ _ => refl,
        ShiftLeft(_, _, _, _) => λ _ => refl,
        LogicalShiftRight(_, _, _, _) => λ _ => refl,
        RotateRight(_, _, _, _) => λ _ => refl,
        ArithmeticShiftRight(_, _, _, _) => λ _ => refl,
        UnsignedLessThan(_, _, _, _) => λ _ => refl,
        SignedLessThan(_, _, _, _) => λ _ => refl,
        Equal(_, _, _, _) => λ _ => refl,
        BufferLoad(_, _, _) => λ no => false_elim(no),
        BufferStore(_, _, _, _) => λ no => false_elim(no),
        Resize(_, _, _, _) => λ _ => refl,
        SignResize(_, _, _, _) => λ _ => refl,
        TableRead(_, _, _, _, _) => λ _ => refl,
        WideLoad(_, _, _, _) => λ no => false_elim(no),
        WideStore(_, _, _, _, _) => λ no => false_elim(no),
        ByteSwap(_, _, _) => λ _ => refl,
    }(pure)
}

// From no buffers every node runs as it evaluates, a byte node included.
theorem Node::run_empty(self node: Node, values: Valuation()): node.run(values, Nil) = State(node.step(values), Nil) {
    match node {
        Const(_, _, _) => refl,
        Move(_, _, _) => refl,
        Add(_, _, _, _) => refl,
        Sub(_, _, _, _) => refl,
        BitAnd(_, _, _, _) => refl,
        BitOr(_, _, _, _) => refl,
        BitXor(_, _, _, _) => refl,
        ShiftLeft(_, _, _, _) => refl,
        LogicalShiftRight(_, _, _, _) => refl,
        RotateRight(_, _, _, _) => refl,
        ArithmeticShiftRight(_, _, _, _) => refl,
        UnsignedLessThan(_, _, _, _) => refl,
        SignedLessThan(_, _, _, _) => refl,
        Equal(_, _, _, _) => refl,
        BufferLoad(_, _, _) => refl,
        BufferStore(_, _, _, _) => refl,
        Resize(_, _, _, _) => refl,
        SignResize(_, _, _, _) => refl,
        TableRead(_, _, _, _, _) => refl,
        WideLoad(_, _, _, _) => refl,
        WideStore(bytes, output, buffer, index, value) => {
            let empty = store_bytes_nil(bytes, buffer, values(64, index).toNat(), values(8 * bytes, value).bytes_le(bytes));
            j(sym(empty), λ file _ => State(Valuation::set(values, output, wide_value(file, buffer, index, bytes, values)), file) =
                State(Valuation::set(values, output, wide_value(Nil, buffer, index, bytes, values)), Nil), refl)
        },
        ByteSwap(_, _, _) => refl,
    }
}

theorem run_nodes_pure(nodes: List<Node>): nodes_pure(nodes).IsTrue() → (values: Valuation()) → (buffers: Buffers()) →
    run_nodes(nodes, values, buffers) = State(eval_nodes(nodes, values), buffers) {
    match nodes {
        Nil => λ _ values buffers => refl,
        Cons(node, rest) => λ pure values buffers => {
            let parts = Bool::is_true_and(node.pure(), nodes_pure(rest), pure);
            j(sym(node.run_pure(values, buffers, parts.left)),
                λ s _ => run_nodes(rest, s.values, s.buffers) = State(eval_nodes(rest, node.step(values)), buffers),
                run_nodes_pure(rest, parts.right, node.step(values), buffers))
        },
    }
}

theorem run_nodes_empty(nodes: List<Node>): (values: Valuation()) → run_nodes(nodes, values, Nil) = State(eval_nodes(nodes, values), Nil) {
    match nodes {
        Nil => λ values => refl,
        Cons(node, rest) => λ values => j(sym(node.run_empty(values)),
            λ s _ => run_nodes(rest, s.values, s.buffers) = State(eval_nodes(rest, node.step(values)), Nil),
            run_nodes_empty(rest, node.step(values))),
    }
}

// ---------------------------------------------------------------------------
// Loops

// How a loop ends, and the buffers it leaves.
record LoopState { end: LoopEnd, buffers: Buffers() }

// `loop_eval` with the buffers carried from pass to pass.
fn loop_run(step: Valuation() → Buffers() → State, parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat) →
    List<BitVec(64)> → Buffers() → LoopState {
    match remaining {
        Zero => λ state buffers => LoopState(LoopEnd(state, True), buffers),
        Succ(rest) => λ state buffers => {
            let after = step(pass_valuation(parameters, count, Succ(rest), state), buffers);
            match after.values(1, exit).head_bit() {
                False => loop_run(step, parameters, count, exit, next, rest, words_of(after.values, next), after.buffers),
                True => LoopState(LoopEnd(words_of(after.values, next), False), after.buffers),
            }
        },
    }
}

// Passes that run from no buffers as they evaluate make a loop that does.
theorem loop_run_empty(run_step: Valuation() → Buffers() → State, step: Valuation() → Valuation(),
    same: (v: Valuation()) → run_step(v, Nil) = State(step(v), Nil), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    remaining: Nat): (state: List<BitVec(64)>) →
    loop_run(run_step, parameters, count, exit, next, remaining, state, Nil) =
        LoopState(loop_eval(step, parameters, count, exit, next, remaining, state), Nil) {
    match remaining {
        Zero => λ state => refl,
        Succ(rest) => λ state => {
            let before = pass_valuation(parameters, count, Succ(rest), state);
            let after = step(before);
            let ends = match after(1, exit).head_bit() as λ b =>
                    (match b as λ _ => LoopState {
                        False => loop_run(run_step, parameters, count, exit, next, rest, words_of(after, next), Nil),
                        True => LoopState(LoopEnd(words_of(after, next), False), Nil),
                    }) = LoopState(match b {
                        False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                        True => LoopEnd(words_of(after, next), False),
                    }, Nil) {
                False => loop_run_empty(run_step, step, same, parameters, count, exit, next, rest, words_of(after, next)),
                True => refl,
            };
            j(sym(same(before)), λ s _ => (match s.values(1, exit).head_bit() as λ _ => LoopState {
                    False => loop_run(run_step, parameters, count, exit, next, rest, words_of(s.values, next), s.buffers),
                    True => LoopState(LoopEnd(words_of(s.values, next), False), s.buffers),
                }) = LoopState(match after(1, exit).head_bit() {
                    False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False),
                }, Nil), ends)
        },
    }
}

// ---------------------------------------------------------------------------
// Structured regions

// What a call is answered with: the word returned and the file left.
record Ending { word: BitVec(64), buffers: Buffers() }

// Callees that may write: each answers a call made over a file.
fn Writers() → Type { Buffers() → Nat → List<BitVec(64)> → Ending }

// The words such callees return over one file, as an evaluation is
// answered (`Answers`).
fn Writers::words(call: Writers(), held: Buffers()) → Answers() { λ f words => call(held, f, words).word }

// Callees that leave every file as it was.
fn Writers::Quiet(call: Writers()) → Type { (held: Buffers()) → (f: Nat) → (words: List<BitVec(64)>) → call(held, f, words).buffers = held }

// Callees that read: each answers a call over a file with a word.
fn Readers() → Type { Buffers() → Answers() }

// Callees that read, as callees that may write and do not.
fn Readers::quiet(call: Readers()) → Writers() { λ held f words => Ending(call(held, f, words), held) }

theorem Readers::quiet_quiet(call: Readers()): Writers::Quiet(Readers::quiet(call)) { λ held f words => refl }

fn StructuredRegion::run(self region: StructuredRegion, call: Writers(), values: Valuation(), buffers: Buffers()) → State {
    match region {
        Dataflow(body) => run_nodes(body.nodes, values, buffers),
        Sequence(prefix, continuation) => {
            let after = run_nodes(prefix.nodes, values, buffers);
            continuation.run(call, after.values, after.buffers)
        },
        Compose(prefix, continuation) => {
            let after = prefix.run(call, values, buffers);
            continuation.run(call, after.values, after.buffers)
        },
        // Branched at each value read, as `eval` is.
        Conditional(_, condition, _, _, when_true, when_false) => State(λ w id => match values(1, condition).head_bit() {
                False => when_false.run(call, values, buffers).values(w, id),
                True => when_true.run(call, values, buffers).values(w, id),
            }, match values(1, condition).head_bit() {
                False => when_false.run(call, values, buffers).buffers,
                True => when_true.run(call, values, buffers).buffers,
            }),
        // A call over views: the callee runs on the windows, and what it leaves in
        // a written one is put back.
        Lend(views, callee, arguments, result) => {
            let bound = run_nodes(views_nodes(views), values, buffers);
            shared(call(viewed(views, bound.values, bound.buffers), callee, words_of(bound.values, views_homes(views) ++ arguments)), λ (answer: Ending) =>
                State(Valuation::set(bound.values, result, word_value(answer.word)), put_views(views, bound.values, answer.buffers, bound.buffers)))
        },
        // The callee is run once, whoever reads its word or its file.
        Call(callee, arguments, result) => shared(call(buffers, callee, words_of(values, arguments)), λ (answer: Ending) =>
            State(Valuation::set(values, result, word_value(answer.word)), answer.buffers)),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => {
            let end = loop_run(λ (pass: Valuation()) (held: Buffers()) => body.run(call, pass, held), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs), buffers);
            State(Valuation::set(Valuation::bind(values, outputs, end.end.state), exhausted, bit_value(end.end.exhausted)), end.buffers)
        },
    }
}

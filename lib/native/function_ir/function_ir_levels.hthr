// A program that has a function calling itself, linked to its sources
// (docs/native/runtime-fn-recursion-design.md): each function answers as
// its source wherever the program is defined.
//
// A function with levels answers its own calls only as deep as its levels
// reach (`Function.levels`), so a program with one does not answer as its
// sources at every word, as a flat one does (`program_linked_files_sources`):
// below the last level a call of it is answered by nothing. Where the
// program is defined (`program_defined_over`) no evaluation reaches there,
// and that is where it agrees.
//
// Each function is checked as in a flat program, once and against any
// table that answers as the sources: its own entry among them where it
// calls itself (`linked_last_arity`). That check asks the table to be
// right at every word, and the program's own answers are right only where
// defined. So the check is applied to the answers patched with the sources
// where they are not defined (`Answers::patched`), which is right
// everywhere, and a defined evaluation does not tell the two apart
// (`Function::eval_words_where`): it asks its callees only where they are
// defined.

import function_ir;
import function_ir_eval;
import function_ir_operation;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// A defined evaluation reads its callees only where they are defined

// Loops whose passes agree wherever a pass is defined run alike where the
// loop is.
theorem loop_eval_same_where(step, other_step: Valuation() → Valuation(), defined: Valuation() → Bool,
    same: (v: Valuation()) → defined(v).IsTrue() → Valuation::Same(step(v), other_step(v)),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → loop_defined(step, defined, parameters, count, exit, next, remaining, state).IsTrue() →
    loop_eval(other_step, parameters, count, exit, next, remaining, state) = loop_eval(step, parameters, count, exit, next, remaining, state) {
    match remaining {
        Zero => λ state _ => refl,
        Succ(rest) => λ state all => {
            let entry = pass_valuation(parameters, count, rest + 1, state);
            let after = step(entry);
            let halves = Bool::is_true_and(defined(entry), match after(1, exit).head_bit() {
                False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                True => True,
            }, all);
            let alike = same(entry, halves.left);
            let bit: (other_step(entry, 1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), alike(1, exit));
            let words: (words_of(other_step(entry), next) = words_of(after, next)) =
                words_agree(next, after, other_step(entry), λ id _ => alike(64, id));
            let moved = eq2(λ (b: Bool) (ws: List<BitVec(64)>) => match b {
                    False => loop_eval(other_step, parameters, count, exit, next, rest, ws),
                    True => LoopEnd(ws, False),
                }, bit, words);
            trans(moved, (match after(1, exit).head_bit() as λ b =>
                (match b as λ _ => Bool {
                    False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                    True => True,
                }).IsTrue() →
                (match b { False => loop_eval(other_step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) =
                (match b { False => loop_eval(step, parameters, count, exit, next, rest, words_of(after, next)),
                    True => LoopEnd(words_of(after, next), False) }) {
                False => λ later => loop_eval_same_where(step, other_step, defined, same, parameters, count, exit, next, rest, words_of(after, next), later),
                True => λ _ => refl,
            })(halves.right))
        },
    }
}

// The theorem: a region defined at a valuation, its calls answered alike
// wherever `defines` says a callee is defined, evaluates alike from
// agreeing valuations. `StructuredRegion::eval_answers_over` with the
// agreement asked only where the evaluation looks.
theorem StructuredRegion::eval_where_over(self region: StructuredRegion, buffers: Buffers(), call, other: Answers(), defines: Defines(),
    answers: (f: Nat) → (words: List<BitVec(64)>) → defines(f, words).IsTrue() → other(f, words) = call(f, words)):
    (values, others: Valuation()) → Valuation::Same(values, others) → region.defined_over(buffers, call, defines, values).IsTrue() →
    Valuation::Same(region.eval_over(buffers, call, values), region.eval_over(buffers, other, others)) {
    match region {
        Dataflow(body) => λ values others same _ => eval_nodes_same_over(buffers, body.nodes, values, others, same),
        Sequence(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, call, defines, prefix.eval(values, buffers := buffers)), ok);
            continuation.eval_where_over(buffers, call, other, defines, answers, prefix.eval(values, buffers := buffers), prefix.eval(others, buffers := buffers),
                eval_nodes_same_over(buffers, prefix.nodes, values, others, same), parts.right)
        },
        Compose(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined_over(buffers, call, defines, values),
                continuation.defined_over(buffers, call, defines, prefix.eval_over(buffers, call, values)), ok);
            continuation.eval_where_over(buffers, call, other, defines, answers, prefix.eval_over(buffers, call, values), prefix.eval_over(buffers, other, others),
                prefix.eval_where_over(buffers, call, other, defines, answers, values, others, same, parts.left), parts.right)
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values others same ok => λ w id => {
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = (match values(1, condition).head_bit() as λ b =>
                (match b as λ _ => Bool {
                    False => when_false.defined_over(buffers, call, defines, values),
                    True => when_true.defined_over(buffers, call, defines, values),
                }).IsTrue() →
                (match b { False => when_false.eval_over(buffers, other, others)(w, id), True => when_true.eval_over(buffers, other, others)(w, id) }) =
                (match b { False => when_false.eval_over(buffers, call, values)(w, id), True => when_true.eval_over(buffers, call, values)(w, id) }) {
                False => λ d => when_false.eval_where_over(buffers, call, other, defines, answers, values, others, same, d, w, id),
                True => λ d => when_true.eval_where_over(buffers, call, other, defines, answers, values, others, same, d, w, id),
            })(ok);
            j(bit, λ b _ => (match b { False => when_false.eval_over(buffers, other, others)(w, id), True => when_true.eval_over(buffers, other, others)(w, id) }) =
                (match values(1, condition).head_bit() {
                    False => when_false.eval_over(buffers, call, values)(w, id),
                    True => when_true.eval_over(buffers, call, values)(w, id),
                }), aligned)
        },
        Lend(views, callee, arguments, result) => λ values others same ok => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let second = eval_nodes_over(buffers, nodes, others);
            let alike = eval_nodes_same_over(buffers, nodes, values, others, same);
            let words = words_of(first, args);
            let read: (words_of(second, args) = words) = words_agree(args, first, second, λ id _ => alike(64, id));
            let parts = Bool::is_true_and(nodes_defined_over(buffers, nodes, values), defines(callee, words), ok);
            let answered: (other(callee, words_of(second, args)) = call(callee, words)) =
                trans(cong_fn(λ (ws: List<BitVec(64)>) => other(callee, ws), read), answers(callee, words, parts.right));
            Valuation::set_same(first, second, alike, result, word_value(first_word(call(callee, words))), word_value(first_word(other(callee, words_of(second, args)))),
                λ w => cong_fn(λ (x: List<BitVec(64)>) => word_value(first_word(x), w), answered))
        },
        Call(callee, arguments, result, also) => λ values others same ok => {
            let words = words_of(values, arguments);
            let read: (words_of(others, arguments) = words) = words_agree(arguments, values, others, λ id _ => same(64, id));
            let parts = Bool::is_true_and(defines(callee, words), call(callee, words).tail().len().matches(also.len()), ok);
            let answered: (other(callee, words_of(others, arguments)) = call(callee, words)) =
                trans(cong_fn(λ (ws: List<BitVec(64)>) => other(callee, ws), read), answers(callee, words, parts.left));
            j(sym(answered), λ a _ => Valuation::Same(Valuation::bind(values, Cons(result, also), Answers::split(call(callee, words))),
                    Valuation::bind(others, Cons(result, also), Answers::split(a))),
                Valuation::bind_same(values, others, same, Cons(result, also), Answers::split(call(callee, words))))
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values others same ok => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, call, pass);
            let other_step = λ (pass: Valuation()) => body.eval_over(buffers, other, pass);
            let defined = λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass);
            let end = loop_eval(step, parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs));
            let ran: (loop_eval(other_step, parameters, count, exit, next, others(64, bound).toNat(), words_of(others, inputs)) = end) =
                trans(eq2(λ (n: Nat) (s: List<BitVec(64)>) => loop_eval(other_step, parameters, count, exit, next, n, s),
                        cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound)), words_agree(inputs, values, others, λ id _ => same(64, id))),
                    loop_eval_same_where(step, other_step, defined,
                        λ v d => body.eval_where_over(buffers, call, other, defines, answers, v, v, λ w id => refl, d),
                        parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs), ok));
            j(sym(ran), λ e _ => Valuation::Same(Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)),
                    Valuation::set(Valuation::bind(others, outputs, e.state), exhausted, bit_value(e.exhausted))),
                Valuation::set_same(Valuation::bind(values, outputs, end.state), Valuation::bind(others, outputs, end.state),
                    Valuation::bind_same(values, others, same, outputs, end.state), exhausted, bit_value(end.exhausted), bit_value(end.exhausted),
                    λ w => refl))
        },
    }
}

// So a function defined at its words returns the same words from either
// table.
theorem Function::eval_words_where(self function: Function, call, other: Answers(), defines: Defines(), buffers: Buffers(),
    answers: (f: Nat) → (words: List<BitVec(64)>) → defines(f, words).IsTrue() → other(f, words) = call(f, words),
    words: List<BitVec(64)>, defined: function.defined(call, defines, words, buffers := buffers).IsTrue()):
    function.eval_words(other, words, buffers := buffers) = function.eval_words(call, words, buffers := buffers) {
    let start = Valuation::bind(Valuation::zero(), function.parameters, words);
    let alike = function.body.eval_where_over(buffers, call, other, defines, answers, start, start, λ w id => refl, defined);
    words_agree(Cons(function.result, function.also), function.body.eval_over(buffers, call, start), function.body.eval_over(buffers, other, start),
        λ id _ => alike(64, id))
}

// ---------------------------------------------------------------------------
// Answers right where defined, and patched to be right everywhere

// `call` answers with `sources`' answers on every word list of a fitting
// arity that `admits` admits and `defines` says is defined
// (`Answers::Agree`, where defined).
fn Answers::AgreeWhere(call, sources: Answers(), arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, defines: Defines()) → Type {
    (f: Nat) → (words: List<BitVec(64)>) → arity_fits(arity(f), words.len()).IsTrue() → admits(f, words) → defines(f, words).IsTrue() →
        call(f, words) = sources(f, words)
}

// `call` where defined and `sources` elsewhere.
fn Answers::patched(call, sources: Answers(), defines: Defines()) → Answers() {
    λ f words => match defines(f, words) { True => call(f, words), False => sources(f, words) }
}

theorem Answers::patched_where(call, sources: Answers(), defines: Defines(), f: Nat, words: List<BitVec(64)>, defined: defines(f, words).IsTrue()):
    Answers::patched(call, sources, defines)(f, words) = call(f, words) {
    (match defines(f, words) as λ b => b.IsTrue() → (match b { True => call(f, words), False => sources(f, words) }) = call(f, words) {
        True => λ _ => refl,
        False => λ never => false_elim(never),
    })(defined)
}

theorem Answers::patched_agree(call, sources: Answers(), arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, defines: Defines(),
    agree: Answers::AgreeWhere(call, sources, arity, admits, defines)):
    Answers::Agree(Answers::patched(call, sources, defines), sources, arity, admits) {
    λ f words fits admitted => (match defines(f, words) as λ b => (b.IsTrue() → call(f, words) = sources(f, words)) →
            (match b { True => call(f, words), False => sources(f, words) }) = sources(f, words) {
        True => λ held => held(trivial),
        False => λ _ => refl,
    })(agree(f, words, fits, admitted))
}

// One function: checked against every table that answers as the sources
// (`clause`, what `program_linked_files` holds of it), it answers as its
// source where it is defined, over callees that answer as theirs where
// they are.
theorem Function::linked_where(self function: Function, buffers: Buffers(), call: Answers(), defines: Defines(), sources: Answers(),
    arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>,
    clause: (c: Answers()) → Answers::Agree(c, sources, arity, admits) → (words: List<BitVec(64)>) → arity_fits(own, words.len()).IsTrue() →
        admits(k, words) → function.eval_words(c, words, buffers := buffers) = sources(k, words),
    agree: Answers::AgreeWhere(call, sources, arity, admits, defines),
    words: List<BitVec(64)>, fits: arity_fits(own, words.len()).IsTrue(), admitted: admits(k, words),
    defined: function.defined(call, defines, words, buffers := buffers).IsTrue()):
    function.eval_words(call, words, buffers := buffers) = sources(k, words) {
    let patched = Answers::patched(call, sources, defines);
    trans(sym(function.eval_words_where(call, patched, defines, buffers,
            λ f ws d => Answers::patched_where(call, sources, defines, f, ws, d), words, defined)),
        clause(patched, Answers::patched_agree(call, sources, arity, admits, defines, agree), words, fits, admitted))
}

// ---------------------------------------------------------------------------
// A function that calls itself, level by level

// What a level of function `k` answers: its source, where the level is
// defined.
fn Function::LevelLinked(self function: Function, buffers: Buffers(), below: Answers(), below_defines: Defines(), sources: Answers(),
    admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>, depth: Nat) → Type {
    (words: List<BitVec(64)>) → arity_fits(own, words.len()).IsTrue() → admits(k, words) →
        function.level_defined(below, below_defines, k, depth, buffers)(words).IsTrue() →
        function.level_words(below, k, depth, buffers)(words) = sources(k, words)
}

// The functions below it and the function at a level answer as their
// sources where defined, given that the level does.
theorem Function::tied_where_at(self function: Function, buffers: Buffers(), below: Answers(), below_defines: Defines(), sources: Answers(),
    arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>,
    under: Answers::AgreeWhere(below, sources, arity, admits, below_defines), depth: Nat,
    level: function.LevelLinked(buffers, below, below_defines, sources, admits, k, own, depth)):
    Answers::AgreeWhere(function.tied_answers(below, k, depth, buffers), sources, tie(arity, k, own), admits,
        function.tied_defines(below, below_defines, k, depth, buffers)) {
    λ f words => match f.eq_dec(k) as λ d =>
        arity_fits(match d { Inl(_) => own, Inr(_) => arity(f) }, words.len()).IsTrue() → admits(f, words) →
        (match d as λ _ => Bool {
            Inl(_) => function.level_defined(below, below_defines, k, depth, buffers)(words),
            Inr(_) => below_defines(f, words),
        }).IsTrue() →
        (match d as λ _ => List<BitVec(64)> {
            Inl(_) => function.level_words(below, k, depth, buffers)(words),
            Inr(_) => below(f, words),
        }) = sources(f, words) {
        Inl(e) => λ fits => j(sym(e), λ g _ => admits(g, words) → function.level_defined(below, below_defines, k, depth, buffers)(words).IsTrue() →
                function.level_words(below, k, depth, buffers)(words) = sources(g, words),
            level(words, fits)),
        Inr(_) => λ fits admitted defined => under(f, words, fits, admitted, defined),
    }
}

// Every level does: none is defined nowhere, and one more is the function
// over the level under it.
theorem Function::level_where(self function: Function, buffers: Buffers(), below: Answers(), below_defines: Defines(), sources: Answers(),
    arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>,
    clause: (c: Answers()) → Answers::Agree(c, sources, tie(arity, k, own), admits) → (words: List<BitVec(64)>) → arity_fits(own, words.len()).IsTrue() →
        admits(k, words) → function.eval_words(c, words, buffers := buffers) = sources(k, words),
    under: Answers::AgreeWhere(below, sources, arity, admits, below_defines), depth: Nat):
    function.LevelLinked(buffers, below, below_defines, sources, admits, k, own, depth) {
    match depth {
        Zero => λ words fits admitted never => false_elim(never),
        Succ(i) => λ words fits admitted defined => function.linked_where(buffers, function.tied_answers(below, k, i, buffers),
            function.tied_defines(below, below_defines, k, i, buffers), sources, tie(arity, k, own), admits, k, own, clause,
            function.tied_where_at(buffers, below, below_defines, sources, arity, admits, k, own, under, i,
                function.level_where(buffers, below, below_defines, sources, arity, admits, k, own, clause, under, i)),
            words, fits, admitted, defined),
    }
}

// The function as a program has it, at its levels: it answers as its
// source where it is defined, over functions below it that do.
theorem Function::levels_where(self function: Function, buffers: Buffers(), below: Answers(), below_defines: Defines(), sources: Answers(),
    arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>,
    under: Answers::AgreeWhere(below, sources, arity, admits, below_defines)):
    (levels: Nat) →
    ((c: Answers()) → Answers::Agree(c, sources, self_table(arity, k, levels, own), admits) → (words: List<BitVec(64)>) →
        arity_fits(own, words.len()).IsTrue() → admits(k, words) → function.eval_words(c, words, buffers := buffers) = sources(k, words)) →
    (words: List<BitVec(64)>) → arity_fits(own, words.len()).IsTrue() → admits(k, words) →
    function.defined(function.answers_at(below, k, levels, buffers), function.defines_at(below, below_defines, k, levels, buffers), words,
        buffers := buffers).IsTrue() →
    function.eval_words(function.answers_at(below, k, levels, buffers), words, buffers := buffers) = sources(k, words) {
    λ levels => match levels {
        Zero => λ clause words fits admitted defined =>
            function.linked_where(buffers, below, below_defines, sources, arity, admits, k, own, clause, under, words, fits, admitted, defined),
        Succ(depth) => λ clause words fits admitted defined => function.linked_where(buffers, function.tied_answers(below, k, depth, buffers),
            function.tied_defines(below, below_defines, k, depth, buffers), sources, tie(arity, k, own), admits, k, own, clause,
            function.tied_where_at(buffers, below, below_defines, sources, arity, admits, k, own, under, depth,
                function.level_where(buffers, below, below_defines, sources, arity, admits, k, own, clause, under, depth)),
            words, fits, admitted, defined),
    }
}

// ---------------------------------------------------------------------------
// The program

// The theorem: a linked program answers with its sources wherever it is
// defined, on the words they admit, whatever levels its functions have.
// At a program no function of which has levels, defined everywhere its
// nodes are, this is `program_linked_files_sources`.
theorem program_linked_where(functions: List<Function>): (arities: List<Nat>) → (admits: Nat → List<BitVec(64)> → Type) →
    (sources: Buffers() → Answers()) → program_linked_files(functions, arities, admits, sources) → (buffers: Buffers()) →
    Answers::AgreeWhere(program_answers_over(buffers, functions), sources(buffers), linked_arity(functions, arities), admits,
        program_defined_over(buffers, functions)) {
    match functions {
        Nil => λ arities admits sources linked buffers f words never => false_elim(never),
        Cons(last, earlier) => λ arities admits sources linked buffers f words => {
            let below = program_answers_over(buffers, earlier);
            let below_defines = program_defined_over(buffers, earlier);
            let arity = linked_arity(earlier, arities.tail());
            let n = earlier.len();
            let ih = program_linked_where(earlier, arities.tail(), admits, sources, linked.right, buffers);
            let own = last.levels_where(buffers, below, below_defines, sources(buffers), arity, admits, n, arities.nth(0), ih, last.levels,
                linked.left.right(buffers));
            (match f.eq_dec(n) as λ d =>
                arity_fits(match d { Inl(_) => arities.nth(0), Inr(_) => arity(f) }, words.len()).IsTrue() → admits(f, words) →
                (match d as λ _ => Bool {
                    Inl(_) => last.defined(last.answers_at(below, n, last.levels, buffers), last.defines_at(below, below_defines, n, last.levels, buffers),
                        words, buffers := buffers),
                    Inr(_) => below_defines(f, words),
                }).IsTrue() →
                (match d as λ _ => List<BitVec(64)> {
                    Inl(_) => last.eval_words(last.answers_at(below, n, last.levels, buffers), words, buffers := buffers),
                    Inr(_) => below(f, words),
                }) = sources(buffers)(f, words) {
                Inl(e) => λ fits => j(sym(e), λ g _ => admits(g, words) →
                        last.defined(last.answers_at(below, n, last.levels, buffers), last.defines_at(below, below_defines, n, last.levels, buffers),
                            words, buffers := buffers).IsTrue() →
                        last.eval_words(last.answers_at(below, n, last.levels, buffers), words, buffers := buffers) = sources(buffers)(g, words),
                    own(words, fits)),
                Inr(_) => λ fits admitted defined => ih(f, words, fits, admitted, defined),
            })
        },
    }
}

// Its first word, the one a caller of one word reads: what a `runtime fn`
// that calls itself cites for `f::agrees`, its definedness a premise.
theorem program_eval_linked_where(functions: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers(), linked: program_linked_files(functions, arities, admits, sources), buffers: Buffers(), f: Nat,
    words: List<BitVec(64)>, fits: arity_fits(linked_arity(functions, arities, f), words.len()).IsTrue(), admitted: admits(f, words),
    defined: program_defined_over(buffers, functions)(f, words).IsTrue()):
    program_eval_over(buffers, functions)(f, words) = first_word(sources(buffers)(f, words)) {
    cong_fn<List<BitVec(64)>, BitVec(64)>(λ l => first_word(l),
        program_linked_where(functions, arities, admits, sources, linked, buffers, f, words, fits, admitted, defined))
}

// ---------------------------------------------------------------------------
// More levels
//
// A function is checked against its sources once, whatever levels it has:
// the check reads its levels only to say whether its own entry is among
// its callees (`linked_last_arity`). So a linked program stays linked with
// each function that has levels given more of them: what a `runtime fn`
// that calls itself publishes at one level, a compile gives as many as its
// stack budget holds.

// The function at `levels` levels.
fn Function::leveled(self function: Function, levels: Nat) → Function {
    Function(function.parameters, function.body, function.result, lent := function.lent, also := function.also, levels := levels,
        fixed := function.fixed)
}

// A function with `levels` levels at `more + 1` of them, one with none as
// it is.
fn Function::deepened_at(self function: Function, levels, more: Nat) → Function {
    match levels { Zero => function, Succ(_) => function.leveled(more + 1) }
}

fn Function::deepened(self function: Function, more: Nat) → Function { function.deepened_at(function.levels, more) }

// A program, each function that has levels at `more + 1` of them.
fn program_deepened(functions: List<Function>, more: Nat) → List<Function> {
    match functions { Nil => Nil, Cons(last, earlier) => Cons(last.deepened(more), program_deepened(earlier, more)) }
}

theorem program_deepened_len(functions: List<Function>, more: Nat): program_deepened(functions, more).len() = functions.len() {
    match functions { Nil => refl, Cons(_, earlier) => cong_fn(λ (n: Nat) => n + 1, program_deepened_len(earlier, more)) }
}

// A program proved defined at every word has no levels, and is itself at
// any number more.
theorem program_deepened_total(functions: List<Function>, more: Nat): program_total(functions).IsTrue() → program_deepened(functions, more) = functions {
    match functions {
        Nil => λ _ => refl,
        Cons(last, earlier) => λ total => {
            let parts = Bool::is_true_and(last.levels.matches(0) && last.body.total_at(program_outs(earlier)), program_total(earlier), total);
            let own = Bool::is_true_and(last.levels.matches(0), last.body.total_at(program_outs(earlier)), parts.left);
            let flat: (last.levels = 0) = last.levels.matches_eq(0, own.left);
            let same: (last.deepened(more) = last) = j(sym(flat), λ n _ => last.deepened_at(n, more) = last, refl);
            eq2(λ (f: Function) (rest: List<Function>) => Cons(f, rest), same, program_deepened_total(earlier, more, parts.right))
        },
    }
}

theorem linked_arity_deepened(functions: List<Function>, more: Nat): (arities: List<Nat>) →
    linked_arity(program_deepened(functions, more), arities) = linked_arity(functions, arities) {
    match functions {
        Nil => λ arities => refl,
        Cons(last, earlier) => λ arities =>
            j(sym(program_deepened_len(earlier, more)), λ n _ =>
                    (λ (f: Nat) => match f.eq_dec(n) { Inl(_) => arities.nth(0), Inr(_) => linked_arity(program_deepened(earlier, more), arities.tail(), f) })
                        = linked_arity(Cons(last, earlier), arities),
                j(sym(linked_arity_deepened(earlier, more, arities.tail())), λ t _ =>
                        (λ (f: Nat) => match f.eq_dec(earlier.len()) { Inl(_) => arities.nth(0), Inr(_) => t(f) }) = linked_arity(Cons(last, earlier), arities),
                    refl)),
    }
}

// What a linked program says of one function: its calls fit the functions
// before it (`below`, `n` of them) and itself where it has levels, and it
// answers as its source over any calls that answer as theirs.
fn Function::LinkedAt(self last: Function, below: Nat → Option<Nat>, n, levels: Nat, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers()) → Type {
    last.calls_fit(self_table(below, n, levels, arities.nth(0))).IsTrue()
        ∧ ((buffers: Buffers()) → (call: Answers()) → Answers::Agree(call, sources(buffers), self_table(below, n, levels, arities.nth(0)), admits) →
            (words: List<BitVec(64)>) → arity_fits(arities.nth(0), words.len()).IsTrue() → admits(n, words) →
            last.eval_words(call, words, buffers := buffers) = sources(buffers)(n, words))
}

theorem Function::deepened_linked_at(self last: Function, more: Nat, below: Nat → Option<Nat>, n: Nat, arities: List<Nat>,
    admits: Nat → List<BitVec(64)> → Type, sources: Buffers() → Answers()): (levels: Nat) → (last.levels = levels) →
    last.LinkedAt(below, n, levels, arities, admits, sources) →
    last.deepened_at(levels, more).LinkedAt(below, n, last.deepened_at(levels, more).levels, arities, admits, sources) {
    λ levels => match levels as λ l => (last.levels = l) → last.LinkedAt(below, n, l, arities, admits, sources) →
        last.deepened_at(l, more).LinkedAt(below, n, last.deepened_at(l, more).levels, arities, admits, sources) {
        Zero => λ e linked => j(sym(e), λ l _ => last.LinkedAt(below, n, l, arities, admits, sources), linked),
        Succ(_) => λ _ linked => ⟨linked.left, λ buffers call agree words fits admitted => linked.right(buffers, call, agree, words, fits, admitted)⟩,
    }
}

theorem program_linked_files_deepened(functions: List<Function>, more: Nat): (arities: List<Nat>) → (admits: Nat → List<BitVec(64)> → Type) →
    (sources: Buffers() → Answers()) → program_linked_files(functions, arities, admits, sources) →
    program_linked_files(program_deepened(functions, more), arities, admits, sources) {
    match functions {
        Nil => λ arities admits sources _ => trivial,
        Cons(last, earlier) => λ arities admits sources linked => {
            let deep = last.deepened(more);
            let own: deep.LinkedAt(linked_arity(earlier, arities.tail()), earlier.len(), deep.levels, arities, admits, sources) =
                last.deepened_linked_at(more, linked_arity(earlier, arities.tail()), earlier.len(), arities, admits, sources, last.levels, refl, linked.left);
            let named = j(sym(linked_arity_deepened(earlier, more, arities.tail())), λ t _ =>
                deep.LinkedAt(t, earlier.len(), deep.levels, arities, admits, sources), own);
            ⟨j(sym(program_deepened_len(earlier, more)), λ n _ =>
                    deep.LinkedAt(linked_arity(program_deepened(earlier, more), arities.tail()), n, deep.levels, arities, admits, sources), named),
                program_linked_files_deepened(earlier, more, arities.tail(), admits, sources, linked.right)⟩
        },
    }
}

// So the program at more levels answers as its sources wherever it is
// defined: what a certificate of a compiled recursion cites, its levels
// the compile's.
theorem program_eval_deepened_where(functions: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers(), linked: program_linked_files(functions, arities, admits, sources), more: Nat, buffers: Buffers(), f: Nat,
    words: List<BitVec(64)>, fits: arity_fits(linked_arity(functions, arities, f), words.len()).IsTrue(), admitted: admits(f, words),
    defined: program_defined_over(buffers, program_deepened(functions, more))(f, words).IsTrue()):
    program_eval_over(buffers, program_deepened(functions, more))(f, words) = first_word(sources(buffers)(f, words)) {
    program_eval_linked_where(program_deepened(functions, more), arities, admits, sources,
        program_linked_files_deepened(functions, more, arities, admits, sources, linked), buffers, f, words,
        j(sym(linked_arity_deepened(functions, more, arities)), λ t _ => arity_fits(t(f), words.len()).IsTrue(), fits), admitted, defined)
}

// ---------------------------------------------------------------------------
// Defined wherever a rank is below the levels
//
// Where a program with a recursion is defined is a fact about its code
// (`program_defined_over`), which a certificate cannot ask its reader to
// check. A rank says it instead: a function whose calls of itself are each
// at a lower rank than the words it was called with is defined at every
// word list whose rank is below its levels (`Function::level_defined_by_rank`),
// by induction on the levels. The descent is asked over a table that
// answers as the sources, since a rank is a fact about the source, and a
// level's own answers are right only where the level under it is defined.
// So the descent is applied to the answers patched with the sources, as
// the linking is, and what is defined over one table is defined over any
// that answers alike where defined (`StructuredRegion::defined_where_over`).

theorem Node::defined_same(self node: Node, values, other: Valuation(), same: Valuation::Same(values, other)):
    node.defined(other) = node.defined(values) {
    match node {
        Apply(op, width, _, left, right) => eq2(λ (x: BitVec(width)) (y: BitVec(width)) => op.requires_bit(x, y), same(width, left), same(width, right)),
        _ => refl,
    }
}

theorem nodes_defined_same_over(buffers: Buffers(), nodes: List<Node>): (values, other: Valuation()) → Valuation::Same(values, other) →
    nodes_defined_over(buffers, nodes, other) = nodes_defined_over(buffers, nodes, values) {
    match nodes {
        Nil => λ values other same => refl,
        Cons(node, rest) => λ values other same => eq2(λ (a: Bool) (b: Bool) => a && b, node.defined_same(values, other, same),
            nodes_defined_same_over(buffers, rest, node.step(values, buffers := buffers), node.step(other, buffers := buffers),
                Valuation::set_same(values, other, same, node_output(node).id, node.value(values, buffers := buffers), node.value(other, buffers := buffers),
                    node.value_same_over(buffers, values, other, same)))),
    }
}

// Loops whose passes agree and stay defined wherever a pass is defined are
// defined alike.
theorem loop_defined_same_where(step, other_step: Valuation() → Valuation(), defined, other_defined: Valuation() → Bool,
    same: (v: Valuation()) → defined(v).IsTrue() → Valuation::Same(step(v), other_step(v)),
    also: (v: Valuation()) → defined(v).IsTrue() → other_defined(v).IsTrue(),
    parameters: List<Nat>, count, exit: Nat, next: List<Nat>, remaining: Nat):
    (state: List<BitVec(64)>) → loop_defined(step, defined, parameters, count, exit, next, remaining, state).IsTrue() →
    loop_defined(other_step, other_defined, parameters, count, exit, next, remaining, state).IsTrue() {
    match remaining {
        Zero => λ state all => trivial,
        Succ(rest) => λ state all => {
            let entry = pass_valuation(parameters, count, rest + 1, state);
            let after = step(entry);
            let halves = Bool::is_true_and(defined(entry), match after(1, exit).head_bit() {
                False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                True => True,
            }, all);
            let alike = same(entry, halves.left);
            let bit: (other_step(entry, 1, exit).head_bit() = after(1, exit).head_bit()) =
                cong_fn(λ (x: BitVec(1)) => x.head_bit(), alike(1, exit));
            let words: (words_of(other_step(entry), next) = words_of(after, next)) =
                words_agree(next, after, other_step(entry), λ id _ => alike(64, id));
            let later = (match after(1, exit).head_bit() as λ b =>
                (match b as λ _ => Bool {
                    False => loop_defined(step, defined, parameters, count, exit, next, rest, words_of(after, next)),
                    True => True,
                }).IsTrue() →
                (match b as λ _ => Bool {
                    False => loop_defined(other_step, other_defined, parameters, count, exit, next, rest, words_of(after, next)),
                    True => True,
                }).IsTrue() {
                False => λ l => loop_defined_same_where(step, other_step, defined, other_defined, same, also, parameters, count, exit, next, rest,
                    words_of(after, next), l),
                True => λ _ => trivial,
            })(halves.right);
            let read = j(sym(words), λ ws _ => (match after(1, exit).head_bit() as λ _ => Bool {
                    False => loop_defined(other_step, other_defined, parameters, count, exit, next, rest, ws),
                    True => True,
                }).IsTrue(), later);
            let moved = j(sym(bit), λ b _ => (match b as λ _ => Bool {
                    False => loop_defined(other_step, other_defined, parameters, count, exit, next, rest, words_of(other_step(entry), next)),
                    True => True,
                }).IsTrue(), read);
            Bool::is_true_and_intro(other_defined(entry), match other_step(entry, 1, exit).head_bit() {
                    False => loop_defined(other_step, other_defined, parameters, count, exit, next, rest, words_of(other_step(entry), next)),
                    True => True,
                }, also(entry, halves.left), moved)
        },
    }
}

// The theorem: a region defined at a valuation is defined from any
// agreeing valuation, over calls answered alike wherever `defines` says a
// callee is defined, and by any `wider` that says so wherever `defines`
// does. `StructuredRegion::eval_where_over` for whether the evaluation is
// defined.
theorem StructuredRegion::defined_where_over(self region: StructuredRegion, buffers: Buffers(), call, other: Answers(), defines, wider: Defines(),
    answers: (f: Nat) → (words: List<BitVec(64)>) → defines(f, words).IsTrue() → other(f, words) = call(f, words),
    widens: (f: Nat) → (words: List<BitVec(64)>) → defines(f, words).IsTrue() → wider(f, words).IsTrue()):
    (values, others: Valuation()) → Valuation::Same(values, others) → region.defined_over(buffers, call, defines, values).IsTrue() →
    region.defined_over(buffers, other, wider, others).IsTrue() {
    match region {
        Dataflow(body) => λ values others same ok =>
            j(sym(nodes_defined_same_over(buffers, body.nodes, values, others, same)), λ b _ => b.IsTrue(), ok),
        Sequence(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, call, defines, prefix.eval(values, buffers := buffers)), ok);
            Bool::is_true_and_intro(prefix.defined(others, buffers := buffers),
                continuation.defined_over(buffers, other, wider, prefix.eval(others, buffers := buffers)),
                j(sym(nodes_defined_same_over(buffers, prefix.nodes, values, others, same)), λ b _ => b.IsTrue(), parts.left),
                continuation.defined_where_over(buffers, call, other, defines, wider, answers, widens, prefix.eval(values, buffers := buffers),
                    prefix.eval(others, buffers := buffers), eval_nodes_same_over(buffers, prefix.nodes, values, others, same), parts.right))
        },
        Compose(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined_over(buffers, call, defines, values),
                continuation.defined_over(buffers, call, defines, prefix.eval_over(buffers, call, values)), ok);
            Bool::is_true_and_intro(prefix.defined_over(buffers, other, wider, others),
                continuation.defined_over(buffers, other, wider, prefix.eval_over(buffers, other, others)),
                prefix.defined_where_over(buffers, call, other, defines, wider, answers, widens, values, others, same, parts.left),
                continuation.defined_where_over(buffers, call, other, defines, wider, answers, widens, prefix.eval_over(buffers, call, values),
                    prefix.eval_over(buffers, other, others),
                    prefix.eval_where_over(buffers, call, other, defines, answers, values, others, same, parts.left), parts.right))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values others same ok => {
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = (match values(1, condition).head_bit() as λ b =>
                (match b as λ _ => Bool {
                    False => when_false.defined_over(buffers, call, defines, values),
                    True => when_true.defined_over(buffers, call, defines, values),
                }).IsTrue() →
                (match b as λ _ => Bool {
                    False => when_false.defined_over(buffers, other, wider, others),
                    True => when_true.defined_over(buffers, other, wider, others),
                }).IsTrue() {
                False => λ d => when_false.defined_where_over(buffers, call, other, defines, wider, answers, widens, values, others, same, d),
                True => λ d => when_true.defined_where_over(buffers, call, other, defines, wider, answers, widens, values, others, same, d),
            })(ok);
            j(bit, λ b _ => (match b as λ _ => Bool {
                    False => when_false.defined_over(buffers, other, wider, others),
                    True => when_true.defined_over(buffers, other, wider, others),
                }).IsTrue(), aligned)
        },
        Lend(views, callee, arguments, result) => λ values others same ok => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let second = eval_nodes_over(buffers, nodes, others);
            let alike = eval_nodes_same_over(buffers, nodes, values, others, same);
            let words = words_of(first, args);
            let read: (words_of(second, args) = words) = words_agree(args, first, second, λ id _ => alike(64, id));
            let parts = Bool::is_true_and(nodes_defined_over(buffers, nodes, values), defines(callee, words), ok);
            Bool::is_true_and_intro(nodes_defined_over(buffers, nodes, others), wider(callee, words_of(second, args)),
                j(sym(nodes_defined_same_over(buffers, nodes, values, others, same)), λ b _ => b.IsTrue(), parts.left),
                j(sym(read), λ ws _ => wider(callee, ws).IsTrue(), widens(callee, words, parts.right)))
        },
        Call(callee, arguments, result, also) => λ values others same ok => {
            let words = words_of(values, arguments);
            let read: (words_of(others, arguments) = words) = words_agree(arguments, values, others, λ id _ => same(64, id));
            let parts = Bool::is_true_and(defines(callee, words), call(callee, words).tail().len().matches(also.len()), ok);
            let answered: (other(callee, words) = call(callee, words)) = answers(callee, words, parts.left);
            let here: (wider(callee, words) && other(callee, words).tail().len().matches(also.len())).IsTrue() =
                Bool::is_true_and_intro(wider(callee, words), other(callee, words).tail().len().matches(also.len()), widens(callee, words, parts.left),
                    j(sym(answered), λ a _ => a.tail().len().matches(also.len()).IsTrue(), parts.right));
            j(sym(read), λ ws _ => (wider(callee, ws) && other(callee, ws).tail().len().matches(also.len())).IsTrue(), here)
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values others same ok => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, call, pass);
            let other_step = λ (pass: Valuation()) => body.eval_over(buffers, other, pass);
            let defined = λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass);
            let other_defined = λ (pass: Valuation()) => body.defined_over(buffers, other, wider, pass);
            let ran = loop_defined_same_where(step, other_step, defined, other_defined,
                λ v d => body.eval_where_over(buffers, call, other, defines, answers, v, v, λ w id => refl, d),
                λ v d => body.defined_where_over(buffers, call, other, defines, wider, answers, widens, v, v, λ w id => refl, d),
                parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs), ok);
            let counted = j(sym(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound))), λ n _ =>
                loop_defined(other_step, other_defined, parameters, count, exit, next, n, words_of(values, inputs)).IsTrue(), ran);
            j(sym(words_agree(inputs, values, others, λ id _ => same(64, id))), λ ws _ =>
                loop_defined(other_step, other_defined, parameters, count, exit, next, others(64, bound).toNat(), ws).IsTrue(), counted)
        },
    }
}

// A region with no call and no node that requires anything: defined at
// every valuation, whatever answers its callers' calls.
fn StructuredRegion::quiet(self region: StructuredRegion) → Bool {
    match region {
        Dataflow(body) => nodes_total(body.nodes),
        Sequence(prefix, continuation) => nodes_total(prefix.nodes) && continuation.quiet(),
        Compose(prefix, continuation) => prefix.quiet() && continuation.quiet(),
        Conditional(_, _, _, _, when_true, when_false) => when_true.quiet() && when_false.quiet(),
        Lend(_, _, _, _) => False,
        Call(_, _, _, _) => False,
        Loop(_, _, _, _, body, _, _, _, _) => body.quiet(),
    }
}

theorem StructuredRegion::quiet_defined(self region: StructuredRegion, buffers: Buffers(), call: Answers(), defines: Defines()):
    region.quiet().IsTrue() → (values: Valuation()) → region.defined_over(buffers, call, defines, values).IsTrue() {
    match region {
        Dataflow(body) => λ quiet values => nodes_total_defined(body.nodes, buffers, quiet, values),
        Sequence(prefix, continuation) => λ quiet values => {
            let parts = Bool::is_true_and(nodes_total(prefix.nodes), continuation.quiet(), quiet);
            Bool::is_true_and_intro(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, call, defines, prefix.eval(values, buffers := buffers)),
                nodes_total_defined(prefix.nodes, buffers, parts.left, values),
                continuation.quiet_defined(buffers, call, defines, parts.right, prefix.eval(values, buffers := buffers)))
        },
        Compose(prefix, continuation) => λ quiet values => {
            let parts = Bool::is_true_and(prefix.quiet(), continuation.quiet(), quiet);
            Bool::is_true_and_intro(prefix.defined_over(buffers, call, defines, values),
                continuation.defined_over(buffers, call, defines, prefix.eval_over(buffers, call, values)),
                prefix.quiet_defined(buffers, call, defines, parts.left, values),
                continuation.quiet_defined(buffers, call, defines, parts.right, prefix.eval_over(buffers, call, values)))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ quiet values => {
            let parts = Bool::is_true_and(when_true.quiet(), when_false.quiet(), quiet);
            match values(1, condition).head_bit() as λ b => (match b as λ _ => Bool {
                False => when_false.defined_over(buffers, call, defines, values),
                True => when_true.defined_over(buffers, call, defines, values),
            }).IsTrue() {
                False => when_false.quiet_defined(buffers, call, defines, parts.right, values),
                True => when_true.quiet_defined(buffers, call, defines, parts.left, values),
            }
        },
        Lend(_, _, _, _) => λ never _ => false_elim(never),
        Call(_, _, _, _) => λ never _ => false_elim(never),
        Loop(inputs, bound, parameters, count, body, exit, next, _, _) => λ quiet values =>
            loop_defined_all(λ (pass: Valuation()) => body.eval_over(buffers, call, pass),
                λ (pass: Valuation()) => body.defined_over(buffers, call, defines, pass),
                λ pass => body.quiet_defined(buffers, call, defines, quiet, pass), parameters, count, exit, next,
                values(64, bound).toNat(), words_of(values, inputs)),
    }
}

// Whether a callee is defined, asked at its renamed function
// (`Answers::relabel`).
fn Defines::relabel(defines: Defines(), links: Nat → Nat) → Defines() { λ f words => defines(links(f), words) }

// A region defined with its calls answered and asked at their renamed
// functions is defined, renamed, over the calls themselves
// (`StructuredRegion::relabel_eval_over`).
theorem StructuredRegion::relabel_defined_over(self region: StructuredRegion, buffers: Buffers(), call: Answers(), defines: Defines(), links: Nat → Nat):
    (values, others: Valuation()) → Valuation::Same(values, others) →
    region.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), values).IsTrue() →
    region.relabel(links).defined_over(buffers, call, defines, others).IsTrue() {
    match region {
        Dataflow(body) => λ values others same ok =>
            j(sym(nodes_defined_same_over(buffers, body.nodes, values, others, same)), λ b _ => b.IsTrue(), ok),
        Sequence(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined(values, buffers := buffers),
                continuation.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), prefix.eval(values, buffers := buffers)), ok);
            Bool::is_true_and_intro(prefix.defined(others, buffers := buffers),
                continuation.relabel(links).defined_over(buffers, call, defines, prefix.eval(others, buffers := buffers)),
                j(sym(nodes_defined_same_over(buffers, prefix.nodes, values, others, same)), λ b _ => b.IsTrue(), parts.left),
                continuation.relabel_defined_over(buffers, call, defines, links, prefix.eval(values, buffers := buffers),
                    prefix.eval(others, buffers := buffers), eval_nodes_same_over(buffers, prefix.nodes, values, others, same), parts.right))
        },
        Compose(prefix, continuation) => λ values others same ok => {
            let parts = Bool::is_true_and(prefix.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), values),
                continuation.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links),
                    prefix.eval_over(buffers, Answers::relabel(call, links), values)), ok);
            Bool::is_true_and_intro(prefix.relabel(links).defined_over(buffers, call, defines, others),
                continuation.relabel(links).defined_over(buffers, call, defines, prefix.relabel(links).eval_over(buffers, call, others)),
                prefix.relabel_defined_over(buffers, call, defines, links, values, others, same, parts.left),
                continuation.relabel_defined_over(buffers, call, defines, links, prefix.eval_over(buffers, Answers::relabel(call, links), values),
                    prefix.relabel(links).eval_over(buffers, call, others), prefix.relabel_eval_over(buffers, call, links, values, others, same), parts.right))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values others same ok => {
            let bit: (values(1, condition).head_bit() = others(1, condition).head_bit()) =
                sym(cong_fn(λ (x: BitVec(1)) => x.head_bit(), same(1, condition)));
            let aligned = (match values(1, condition).head_bit() as λ b =>
                (match b as λ _ => Bool {
                    False => when_false.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), values),
                    True => when_true.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), values),
                }).IsTrue() →
                (match b as λ _ => Bool {
                    False => when_false.relabel(links).defined_over(buffers, call, defines, others),
                    True => when_true.relabel(links).defined_over(buffers, call, defines, others),
                }).IsTrue() {
                False => λ d => when_false.relabel_defined_over(buffers, call, defines, links, values, others, same, d),
                True => λ d => when_true.relabel_defined_over(buffers, call, defines, links, values, others, same, d),
            })(ok);
            j(bit, λ b _ => (match b as λ _ => Bool {
                    False => when_false.relabel(links).defined_over(buffers, call, defines, others),
                    True => when_true.relabel(links).defined_over(buffers, call, defines, others),
                }).IsTrue(), aligned)
        },
        Lend(views, callee, arguments, result) => λ values others same ok => {
            let nodes = views_nodes(views);
            let args = views_homes(views) ++ arguments;
            let first = eval_nodes_over(buffers, nodes, values);
            let second = eval_nodes_over(buffers, nodes, others);
            let alike = eval_nodes_same_over(buffers, nodes, values, others, same);
            let words = words_of(first, args);
            let read: (words_of(second, args) = words) = words_agree(args, first, second, λ id _ => alike(64, id));
            let parts = Bool::is_true_and(nodes_defined_over(buffers, nodes, values), defines(links(callee), words), ok);
            Bool::is_true_and_intro(nodes_defined_over(buffers, nodes, others), defines(links(callee), words_of(second, args)),
                j(sym(nodes_defined_same_over(buffers, nodes, values, others, same)), λ b _ => b.IsTrue(), parts.left),
                j(sym(read), λ ws _ => defines(links(callee), ws).IsTrue(), parts.right))
        },
        Call(callee, arguments, result, also) => λ values others same ok => {
            let words = words_of(values, arguments);
            let read: (words_of(others, arguments) = words) = words_agree(arguments, values, others, λ id _ => same(64, id));
            let here: (defines(links(callee), words) && call(links(callee), words).tail().len().matches(also.len())).IsTrue() = ok;
            j(sym(read), λ ws _ => (defines(links(callee), ws) && call(links(callee), ws).tail().len().matches(also.len())).IsTrue(), here)
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => λ values others same ok => {
            let step = λ (pass: Valuation()) => body.eval_over(buffers, Answers::relabel(call, links), pass);
            let other_step = λ (pass: Valuation()) => body.relabel(links).eval_over(buffers, call, pass);
            let defined = λ (pass: Valuation()) => body.defined_over(buffers, Answers::relabel(call, links), Defines::relabel(defines, links), pass);
            let other_defined = λ (pass: Valuation()) => body.relabel(links).defined_over(buffers, call, defines, pass);
            let ran = loop_defined_same_where(step, other_step, defined, other_defined,
                λ v d => body.relabel_eval_over(buffers, call, links, v, v, λ w id => refl),
                λ v d => body.relabel_defined_over(buffers, call, defines, links, v, v, λ w id => refl, d),
                parameters, count, exit, next, values(64, bound).toNat(), words_of(values, inputs), ok);
            let counted = j(sym(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64, bound))), λ n _ =>
                loop_defined(other_step, other_defined, parameters, count, exit, next, n, words_of(values, inputs)).IsTrue(), ran);
            j(sym(words_agree(inputs, values, others, λ id _ => same(64, id))), λ ws _ =>
                loop_defined(other_step, other_defined, parameters, count, exit, next, others(64, bound).toNat(), ws).IsTrue(), counted)
        },
    }
}

// A function's, renamed.
theorem Function::relabel_defined(self function: Function, buffers: Buffers(), call: Answers(), defines: Defines(), links: Nat → Nat,
    words: List<BitVec(64)>, ok: function.defined(Answers::relabel(call, links), Defines::relabel(defines, links), words, buffers := buffers).IsTrue()):
    function.relabel(links).defined(call, defines, words, buffers := buffers).IsTrue() {
    let bound = Valuation::bind(Valuation::zero(), function.parameters, words);
    function.body.relabel_defined_over(buffers, call, defines, links, bound, bound, λ w id => refl, ok)
}

// What a rank promises of function `k`'s code: over any table `Good`
// accepts, the function is defined at the words `Admits` admits, given
// that it is defined itself (`own`) at every such word list of lower rank.
// Its callees below are asked through `below_defines`.
fn Function::Descends(self function: Function, buffers: Buffers(), below_defines: Defines(), k: Nat, rank: List<BitVec(64)> → Nat,
    Good: Answers() → Type, Admits: List<BitVec(64)> → Type) → Type {
    (call: Answers()) → Good(call) → (own: List<BitVec(64)> → Bool) → (words: List<BitVec(64)>) → Admits(words) →
        ((lower: List<BitVec(64)>) → Admits(lower) → (rank(lower) < rank(words)) → own(lower).IsTrue()) →
        function.defined(call, tie_defines(below_defines, k, own), words, buffers := buffers).IsTrue()
}

// A function whose code descends by a rank is defined, `depth` levels
// deep, at every word list of rank below `depth`.
theorem Function::level_defined_by_rank(self function: Function, buffers: Buffers(), below: Answers(), below_defines: Defines(), sources: Answers(),
    arity: Nat → Option<Nat>, admits: Nat → List<BitVec(64)> → Type, k: Nat, own: Option<Nat>, rank: List<BitVec(64)> → Nat,
    clause: (c: Answers()) → Answers::Agree(c, sources, tie(arity, k, own), admits) → (words: List<BitVec(64)>) → arity_fits(own, words.len()).IsTrue() →
        admits(k, words) → function.eval_words(c, words, buffers := buffers) = sources(k, words),
    under: Answers::AgreeWhere(below, sources, arity, admits, below_defines), Admits: List<BitVec(64)> → Type,
    descends: function.Descends(buffers, below_defines, k, rank, λ (c: Answers()) => Answers::Agree(c, sources, tie(arity, k, own), admits), Admits),
    depth: Nat): (words: List<BitVec(64)>) → Admits(words) → (rank(words) < depth) →
    function.level_defined(below, below_defines, k, depth, buffers)(words).IsTrue() {
    match depth {
        Zero => λ words _ never => false_elim(never),
        Succ(i) => λ words admitted within => {
            let call = function.tied_answers(below, k, i, buffers);
            let defines = function.tied_defines(below, below_defines, k, i, buffers);
            let agree = function.tied_where_at(buffers, below, below_defines, sources, arity, admits, k, own, under, i,
                function.level_where(buffers, below, below_defines, sources, arity, admits, k, own, clause, under, i));
            let patched = Answers::patched(call, sources, defines);
            let le: (rank(words) <= i) = within;
            let over = descends(patched, Answers::patched_agree(call, sources, tie(arity, k, own), admits, defines, agree),
                function.level_defined(below, below_defines, k, i, buffers), words, admitted,
                λ lower ok below_rank => function.level_defined_by_rank(buffers, below, below_defines, sources, arity, admits, k, own, rank, clause, under,
                    Admits, descends, i, lower, ok, Nat::lt_of_lt_of_le(rank(lower), rank(words), i, below_rank, le)));
            let start = Valuation::bind(Valuation::zero(), function.parameters, words);
            function.body.defined_where_over(buffers, patched, call, defines, defines,
                λ f ws d => sym(Answers::patched_where(call, sources, defines, f, ws, d)), λ f ws d => d, start, start, λ w id => refl, over)
        },
    }
}

// The program: its last function, one whose code descends by a rank, is
// defined at every word list whose rank is below its levels.
theorem program_defined_by_rank(last: Function, earlier: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers(), linked: program_linked_files(Cons(last, earlier), arities, admits, sources), buffers: Buffers(),
    rank: List<BitVec(64)> → Nat, Admits: List<BitVec(64)> → Type,
    descends: last.Descends(buffers, program_defined_over(buffers, earlier), earlier.len(), rank,
        λ (c: Answers()) => Answers::Agree(c, sources(buffers), tie(linked_arity(earlier, arities.tail()), earlier.len(), arities.nth(0)), admits), Admits),
    words: List<BitVec(64)>, admitted: Admits(words), within: rank(words) < last.levels):
    program_defined_over(buffers, Cons(last, earlier))(earlier.len(), words).IsTrue() {
    let below = program_answers_over(buffers, earlier);
    let below_defines = program_defined_over(buffers, earlier);
    let arity = linked_arity(earlier, arities.tail());
    let n = earlier.len();
    let under = program_linked_where(earlier, arities.tail(), admits, sources, linked.right, buffers);
    let own = (match last.levels as λ l =>
        ((c: Answers()) → Answers::Agree(c, sources(buffers), self_table(arity, n, l, arities.nth(0)), admits) → (ws: List<BitVec(64)>) →
            arity_fits(arities.nth(0), ws.len()).IsTrue() → admits(n, ws) → last.eval_words(c, ws, buffers := buffers) = sources(buffers)(n, ws)) →
        (rank(words) < l) →
        last.defined(last.answers_at(below, n, l, buffers), last.defines_at(below, below_defines, n, l, buffers), words, buffers := buffers).IsTrue() {
        Zero => λ _ never => false_elim(never),
        Succ(depth) => λ clause lt => last.level_defined_by_rank(buffers, below, below_defines, sources(buffers), arity, admits, n, arities.nth(0), rank,
            clause, under, Admits, descends, depth + 1, words, admitted, lt),
    })(linked.left.right(buffers), within);
    (match n.eq_dec(n) as λ d => (match d as λ _ => Bool {
            Inl(_) => last.defined(last.answers_at(below, n, last.levels, buffers), last.defines_at(below, below_defines, n, last.levels, buffers),
                words, buffers := buffers),
            Inr(_) => below_defines(n, words),
        }).IsTrue() {
        Inl(_) => own,
        Inr(differ) => false_elim(differ(refl)),
    })
}

// At more levels: a recursion published at one level, its program given
// `more + 1`, is defined at every word list of rank at most `more`. The
// descent is asked of the function as published, over the functions below
// it at their levels.
theorem program_defined_deepened_by_rank(last: Function, earlier: List<Function>, arities: List<Nat>, admits: Nat → List<BitVec(64)> → Type,
    sources: Buffers() → Answers(), linked: program_linked_files(Cons(last, earlier), arities, admits, sources), more: Nat, buffers: Buffers(),
    rank: List<BitVec(64)> → Nat, Admits: List<BitVec(64)> → Type, level: Nat, leveled: last.levels = level + 1,
    descends: last.Descends(buffers, program_defined_over(buffers, program_deepened(earlier, more)), earlier.len(), rank,
        λ (c: Answers()) => Answers::Agree(c, sources(buffers), tie(linked_arity(earlier, arities.tail()), earlier.len(), arities.nth(0)), admits), Admits),
    words: List<BitVec(64)>, admitted: Admits(words), within: rank(words) <= more):
    program_defined_over(buffers, program_deepened(Cons(last, earlier), more))(earlier.len(), words).IsTrue() {
    let deep = last.leveled(more + 1);
    let under = program_deepened(earlier, more);
    let relinked: program_linked_files(Cons(deep, under), arities, admits, sources) =
        j(leveled, λ l _ => program_linked_files(Cons(last.deepened_at(l, more), under), arities, admits, sources),
            program_linked_files_deepened(Cons(last, earlier), more, arities, admits, sources, linked));
    let named = j(sym(linked_arity_deepened(earlier, more, arities.tail())), λ t _ =>
        deep.Descends(buffers, program_defined_over(buffers, under), earlier.len(), rank,
            λ (c: Answers()) => Answers::Agree(c, sources(buffers), tie(t, earlier.len(), arities.nth(0)), admits), Admits), descends);
    let counted = j(sym(program_deepened_len(earlier, more)), λ n _ =>
        deep.Descends(buffers, program_defined_over(buffers, under), n, rank,
            λ (c: Answers()) => Answers::Agree(c, sources(buffers), tie(linked_arity(under, arities.tail()), n, arities.nth(0)), admits), Admits), named);
    let there = program_defined_by_rank(deep, under, arities, admits, sources, relinked, buffers, rank, Admits, counted, words, admitted, within);
    let here = j(program_deepened_len(earlier, more), λ n _ => program_defined_over(buffers, Cons(deep, under))(n, words).IsTrue(), there);
    j(sym(leveled), λ l _ => program_defined_over(buffers, Cons(last.deepened_at(l, more), under))(earlier.len(), words).IsTrue(), here)
}

// What `compile-x86` instantiates (issues/function-ir-verified-lowering.md,
// round 4): a program lowered by `lower_program`, its functions evaluable,
// returns at each function's label what the evaluator says that function
// computes. The compiler adds one equation, that the evaluation is the
// source function, which it proves by `refl`: the evaluator keeps words
// exact at width 64 and branches at each value it reads, so a reflected
// function evaluated over open words is its source by conversion.

import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_lower;
import function_ir_lower_structured;
import function_ir_lower_reads;
import function_ir_lower_calls;
import function_ir_stage;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_stack;
import x86_64_lending;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_stack_runs;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// Called at function `f`'s label with its arguments in their registers and
// its frame's room on the stack, the code returns `answer` in RAX, keeps
// the callee-saved registers, and leaves memory as it was but for stores
// into its own room below its return address (`Stack::Wrote`), whenever
// the program evaluates `f` at those arguments to `answer`.
theorem compiled_returns<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, program: Prog,
    lowered: lower_program_roomed(functions, placement, [], rooms) = Some(program), evaluable: program_evaluable(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(), defined: program_defined(functions, f, arguments).IsTrue(),
    answer: BitVec(64), evaluates: program_eval(functions, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(answer)) {
    let site = Site<M>(fetch, data, program, last, origin);
    let calls = lower_program_roomed_quiet_correct<M>(functions, placement, rooms, program, lowered, fetch, data, last, origin, stack);
    let computed = program_eval_computes(functions, evaluable, f, arguments, fits, defined);
    let returns = site.returns_weaken(stack, asm_labels(program, f + 1),
        stack.CalleePre(program_callees(functions), rooms, f, arguments, program_eval(functions, f, arguments)),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(program_eval(functions, f, arguments)),
        calls(f, below, arguments, program_eval(functions, f, arguments)),
        λ i s held => ⟨held.left, ⟨computed, held.right⟩⟩);
    j(evaluates, λ x _ => site.Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(x)), returns)
}

// The same of a program whose functions take buffers
// (docs/native/native-one-compiler-design.md §2.3, §2.6): called over a file
// `before` of the lending's lengths (`Stack::LentOver`: the homes of the
// buffers `f` takes are its first arguments, and the file is in memory,
// each buffer at its address), under the lending laws (`loan`) with every
// buffer the program stores into lent to be written (`allowed`), the code
// returns a result and leaves a file the program's meaning says it may
// (`ran`). Whoever lends discharges the premises: a program from its data
// region, Rust from a slice.
theorem compiled_returns_over<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, lending: Lending, program: Prog,
    lowered: lower_program_roomed(functions, placement, lending.counts, rooms) = Some(program), lendless: program_lendless(functions).IsTrue(),
    allowed: (b: Nat) → program_stores(functions, b).IsTrue() → lending.written(b) = True,
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>, result: BitVec(64), before, after: Buffers(),
    ran: program_effects(functions, before, f, arguments, result, after)):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, before)(i, s),
        stack.AnsweredOver(lending, result, after)) {
    let site = Site<M>(fetch, data, program, last, origin);
    let calls = lower_program_roomed_correct<M>(functions, placement, rooms, lending, program, lowered, fetch, data, last, origin, stack, top, loan,
        lendless, allowed);
    site.returns_weaken(stack, asm_labels(program, f + 1),
        stack.CalledOver(program_effects(functions), rooms, lending, top, f, arguments, result, before, after),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, before)(i, s),
        stack.AnsweredOver(lending, result, after), calls(f, below, arguments, result, before, after),
        λ i s held => ⟨⟨held.left.left, ⟨ran, held.left.right⟩⟩, held.right⟩)
}

// What it returns and leaves, by evaluation: an evaluable program's run
// over the file (`program_run`, function_ir_run) is a word and a file its
// meaning allows, so the code returns the one and leaves the other.
theorem compiled_returns_run<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, lending: Lending, program: Prog,
    lowered: lower_program_roomed(functions, placement, lending.counts, rooms) = Some(program), evaluable: program_evaluable(functions).IsTrue(),
    lendless: program_lendless(functions).IsTrue(),
    allowed: (b: Nat) → program_stores(functions, b).IsTrue() → lending.written(b) = True,
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(), before: Buffers(),
    defined: program_run_defined(functions, before, f, arguments).IsTrue(), answer: Ending,
    runs: program_run(functions, before, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, before)(i, s),
        stack.AnsweredOver(lending, answer.word, answer.buffers)) {
    compiled_returns_over<M>(functions, placement, rooms, lending, program, lowered, lendless, allowed, fetch, data, last, origin, stack, top, loan, f, below,
        arguments, answer.word, before, answer.buffers,
        j(runs, λ x _ => program_effects(functions, before, f, arguments, x.word, x.buffers),
            program_run_effects(functions, evaluable, before, f, arguments, fits, defined)))
}

// Through an optimizer: the code is lowered from `functions`, and the run
// is the `source`'s, where `functions` may do at `f` whatever `source` may
// (`keeps`, from `Stage::run_rewrites` and `prune_sound`). What the
// lowering checks (`lowered`, `within`) is of the functions it lowers; what
// says the run is a meaning (`evaluable`, `fits`) is of the source.
theorem compiled_returns_written_through<M>(source, functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>,
    addresses: List<BitVec(64)>, marks: List<Bool>, program: Prog, lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program),
    evaluable: program_evaluable(source).IsTrue(), within: program_stores_within(functions, marks).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    before: Buffers(), loan: Loan<M>(fetch, data, stack, top, Lending::writing(counts, addresses, before, marks).spans()),
    f: Nat, below: f + 1 <= functions.len(), keeps: ProgramRewrites(source, functions, f), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(source, f), arguments.len()).IsTrue(),
    defined: program_run_defined(source, before, f, arguments).IsTrue(), answer: Ending,
    runs: program_run(source, before, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(Lending::writing(counts, addresses, before, marks), top, f, arguments, before)(i, s),
        stack.AnsweredOver(Lending::writing(counts, addresses, before, marks), answer.word, answer.buffers)) {
    compiled_returns_over<M>(functions, placement, rooms, Lending::writing(counts, addresses, before, marks), program, lowered,
        program_stores_within_lendless(functions, marks, within), λ b stores => program_stores_marked(functions, marks, b, within, stores),
        fetch, data, last, origin, stack, top, loan, f, below, arguments, answer.word, before, answer.buffers,
        keeps(before, arguments, answer.word, answer.buffers,
            j(runs, λ x _ => program_effects(source, before, f, arguments, x.word, x.buffers),
                program_run_effects(source, evaluable, before, f, arguments, fits, defined))))
}

// A program whose every store is into a buffer `marks` marks
// (`program_stores_within`, by evaluation): lent its buffers with those to
// write, the code returns the word its run over the file ends in and
// leaves the file the run leaves. This is what an export that writes into
// a span its caller lends is stated with
// (docs/native/native-library-exports-design.md §7).
theorem compiled_returns_written<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>, addresses: List<BitVec(64)>,
    marks: List<Bool>, program: Prog, lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program),
    evaluable: program_evaluable(functions).IsTrue(), within: program_stores_within(functions, marks).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    before: Buffers(), loan: Loan<M>(fetch, data, stack, top, Lending::writing(counts, addresses, before, marks).spans()),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(),
    defined: program_run_defined(functions, before, f, arguments).IsTrue(), answer: Ending,
    runs: program_run(functions, before, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(Lending::writing(counts, addresses, before, marks), top, f, arguments, before)(i, s),
        stack.AnsweredOver(Lending::writing(counts, addresses, before, marks), answer.word, answer.buffers)) {
    compiled_returns_written_through<M>(functions, functions, placement, rooms, counts, addresses, marks, program, lowered, evaluable, within, fetch, data,
        last, origin, stack, top, before, loan, f, below, λ _ _ _ _ ran => ran, arguments, fits, defined, answer, runs)
}

// A program some of whose calls are over views
// (docs/native/native-library-exports-design.md §3.1): what each function needs
// to write is said a function at a time (`needs`, right for the program
// by `ProgramNeeds`), since a callee over views writes the views and not
// its caller's buffers. Function `f`, lent its buffers with the ones it
// needs to be written, returns a result and leaves a file the program's
// meaning says it may.
theorem compiled_returns_needs<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, lending: Lending, program: Prog,
    lowered: lower_program_roomed(functions, placement, lending.counts, rooms) = Some(program), needs: Nat → Nat → Bool,
    needed: ProgramNeeds(functions, needs),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    f: Nat, below: f + 1 <= functions.len(), allowed: (b: Nat) → needs(f, b).IsTrue() → lending.written(b) = True,
    arguments: List<BitVec(64)>, result: BitVec(64), before, after: Buffers(),
    ran: program_effects(functions, before, f, arguments, result, after)):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, before)(i, s),
        stack.AnsweredOver(lending, result, after)) {
    let site = Site<M>(fetch, data, program, last, origin);
    let calls = lower_program_roomed_needs<M>(functions, placement, lending.counts, rooms, program, lowered, needs, needed, fetch, data, last, origin,
        stack, top);
    site.returns_weaken(stack, asm_labels(program, f + 1),
        stack.CalledOver(program_effects(functions), rooms, lending, top, f, arguments, result, before, after),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, before)(i, s),
        stack.AnsweredOver(lending, result, after), calls(lending, refl, loan, f, below, allowed, arguments, result, before, after),
        λ i s held => ⟨⟨held.left.left, ⟨ran, held.left.right⟩⟩, held.right⟩)
}

// The same through an optimizer (`compiled_returns_written_through`).
theorem compiled_returns_marked_through<M>(source, functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>,
    addresses: List<BitVec(64)>, tables: List<List<Bool>>, program: Prog, lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program),
    evaluable: program_evaluable(source).IsTrue(), marks: program_marked(functions, tables).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    before: Buffers(), f: Nat, below: f + 1 <= functions.len(), keeps: ProgramRewrites(source, functions, f),
    loan: Loan<M>(fetch, data, stack, top, Lending::writing(counts, addresses, before, marks_row(tables, f)).spans()),
    arguments: List<BitVec(64)>, fits: arity_fits(program_arity(source, f), arguments.len()).IsTrue(),
    defined: program_run_defined(source, before, f, arguments).IsTrue(), answer: Ending,
    runs: program_run(source, before, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(Lending::writing(counts, addresses, before, marks_row(tables, f)), top, f, arguments, before)(i, s),
        stack.AnsweredOver(Lending::writing(counts, addresses, before, marks_row(tables, f)), answer.word, answer.buffers)) {
    compiled_returns_needs<M>(functions, placement, rooms, Lending::writing(counts, addresses, before, marks_row(tables, f)), program, lowered,
        λ (g: Nat) (b: Nat) => marked(marks_row(tables, g), b), program_marked_needs(functions, tables, marks), fetch, data, last, origin,
        stack, top, loan, f, below, λ b need => eq_true_of_is_true(marked(marks_row(tables, f), b), need), arguments, answer.word, before,
        answer.buffers,
        keeps(before, arguments, answer.word, answer.buffers,
            j(runs, λ x _ => program_effects(source, before, f, arguments, x.word, x.buffers),
                program_run_effects(source, evaluable, before, f, arguments, fits, defined))))
}

// The same by evaluation, the needs as rows of marks (`program_marked`):
// function `f`, lent its buffers with those its row marks to write,
// returns the word its run over the file ends in and leaves the file the
// run leaves. This is what an export that lends views of a span is stated
// with.
theorem compiled_returns_marked<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>, addresses: List<BitVec(64)>,
    tables: List<List<Bool>>, program: Prog, lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program),
    evaluable: program_evaluable(functions).IsTrue(), marks: program_marked(functions, tables).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    before: Buffers(), f: Nat, below: f + 1 <= functions.len(),
    loan: Loan<M>(fetch, data, stack, top, Lending::writing(counts, addresses, before, marks_row(tables, f)).spans()),
    arguments: List<BitVec(64)>, fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(),
    defined: program_run_defined(functions, before, f, arguments).IsTrue(), answer: Ending,
    runs: program_run(functions, before, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(Lending::writing(counts, addresses, before, marks_row(tables, f)), top, f, arguments, before)(i, s),
        stack.AnsweredOver(Lending::writing(counts, addresses, before, marks_row(tables, f)), answer.word, answer.buffers)) {
    compiled_returns_marked_through<M>(functions, functions, placement, rooms, counts, addresses, tables, program, lowered, evaluable, marks, fetch, data,
        last, origin, stack, top, before, f, below, λ _ _ _ _ ran => ran, loan, arguments, fits, defined, answer, runs)
}

// The same through an optimizer: both programs store into no buffer, the
// source's so that its evaluation is what it does over the file (`reads`),
// the lowered one's so that nothing need be lent to write (`quiet`).
theorem compiled_returns_lent_through<M>(source, functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, lending: Lending, program: Prog,
    lowered: lower_program_roomed(functions, placement, lending.counts, rooms) = Some(program), evaluable: program_evaluable(source).IsTrue(),
    reads: program_quiet(source).IsTrue(), quiet: program_quiet(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    f: Nat, below: f + 1 <= functions.len(), keeps: ProgramRewrites(source, functions, f), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(source, f), arguments.len()).IsTrue(), now: Buffers(),
    defined: program_defined_over(now, source, f, arguments).IsTrue(), answer: BitVec(64),
    evaluates: program_eval_over(now, source, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, now)(i, s),
        stack.AnsweredOver(lending, answer, now)) {
    let value = program_eval_over(now, source, f, arguments);
    let computed = program_effects_quiet(source, reads, now, f, arguments, value,
        program_eval_reads(source, now, evaluable, f, arguments, fits, defined));
    compiled_returns_over<M>(functions, placement, rooms, lending, program, lowered, program_quiet_lendless(functions, quiet),
        λ b stores => false_elim(program_quiet_stores(functions, b, quiet, stores)), fetch, data, last, origin, stack, top, loan, f, below,
        arguments, answer, now, now,
        keeps(now, arguments, answer, now, j(evaluates, λ x _ => program_effects(source, now, f, arguments, x, now), computed)))
}

// A program that stores into no buffer (`quiet`) does what it evaluates to
// over the file: the code returns what the program evaluates `f` to over
// `now` and leaves `now` in memory, lent to read or to write.
theorem compiled_returns_lent<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, lending: Lending, program: Prog,
    lowered: lower_program_roomed(functions, placement, lending.counts, rooms) = Some(program), evaluable: program_evaluable(functions).IsTrue(),
    quiet: program_quiet(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data), top: Nat,
    loan: Loan<M>(fetch, data, stack, top, lending.spans()),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(), now: Buffers(),
    defined: program_defined_over(now, functions, f, arguments).IsTrue(), answer: BitVec(64),
    evaluates: program_eval_over(now, functions, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => (stack.Passed(arguments, i, s) ∧ rooms(f) <= i) ∧
            stack.LentOver(lending, top, f, arguments, now)(i, s),
        stack.AnsweredOver(lending, answer, now)) {
    compiled_returns_lent_through<M>(functions, functions, placement, rooms, lending, program, lowered, evaluable, quiet, quiet, fetch, data, last, origin,
        stack, top, loan, f, below, λ _ _ _ _ ran => ran, arguments, fits, now, defined, answer, evaluates)
}

// The same through an optimizer (`compiled_returns_lent_through`).
theorem compiled_returns_unlent_through<M>(source, functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>, program: Prog,
    lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program), evaluable: program_evaluable(source).IsTrue(),
    reads: program_quiet(source).IsTrue(), quiet: program_quiet(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    f: Nat, below: f + 1 <= functions.len(), keeps: ProgramRewrites(source, functions, f), unlent: lent_count(counts, f) = 0,
    arguments: List<BitVec(64)>, fits: arity_fits(program_arity(source, f), arguments.len()).IsTrue(),
    defined: program_defined_over([], source, f, arguments).IsTrue(), answer: BitVec(64),
    evaluates: program_eval_over([], source, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(answer)) {
    let lending = Lending::reading(counts, [], []);
    let returns = compiled_returns_lent_through<M>(source, functions, placement, rooms, lending, program, lowered, evaluable, reads, quiet, fetch, data,
        last, origin, stack, stack.size, stack.loan_nothing(), f, below, keeps, arguments, fits, [], defined, answer, evaluates);
    let lent: ArgsLent(lent_count(counts, f), 0, arguments, [], []) = j(sym(unlent), λ n _ => ArgsLent(n, 0, arguments, [], []), trivial);
    λ s at resident i rsp room held ret saved => {
        let ran = returns(s, at, resident, i, rsp, room, ⟨held, ⟨lent, ⟨room, stack.in_memory_none(s.memory)⟩⟩⟩, ret, saved);
        let post = ran.proof.right.right.right.right;
        Exists(ran.witness, ⟨ran.proof.left, ⟨ran.proof.right.left, ⟨ran.proof.right.right.left, ⟨ran.proof.right.right.right.left,
            ⟨post.left, ⟨post.right.left,
                stack.wrote_in_none(i, lending.spans(), λ b => refl, s.memory, ran.witness.memory, post.right.right.left)⟩⟩⟩⟩⟩⟩)
    }
}

// A function lent nothing, in a program that reads the buffers its other
// functions are lent: it takes no buffer, so it asks for no file, and its
// contract is the one a program without buffers has (`compiled_returns`):
// its arguments, its room, and stores of its own only. An export that is
// one function of a larger program, beside functions over spans, is stated
// with this (docs/native/native-library-exports-design.md §8.1).
theorem compiled_returns_unlent<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, counts: List<Nat>, program: Prog,
    lowered: lower_program_roomed(functions, placement, counts, rooms) = Some(program), evaluable: program_evaluable(functions).IsTrue(),
    quiet: program_quiet(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    f: Nat, below: f + 1 <= functions.len(), unlent: lent_count(counts, f) = 0, arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(),
    defined: program_defined_over([], functions, f, arguments).IsTrue(), answer: BitVec(64),
    evaluates: program_eval_over([], functions, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(answer)) {
    compiled_returns_unlent_through<M>(functions, functions, placement, rooms, counts, program, lowered, evaluable, quiet, quiet, fetch, data, last, origin,
        stack, f, below, λ _ _ _ _ ran => ran, unlent, arguments, fits, defined, answer, evaluates)
}

// What the stores leave of the stack: the words from the return address
// up are as they were. A caller with nothing but stack words to keep cites
// this; one with data of its own cites `compiled_returns` and what its
// data is under such stores.
theorem compiled_returns_keeps<M>(functions: List<Function>, placement: List<Place>, rooms: Nat → Nat, program: Prog,
    lowered: lower_program_roomed(functions, placement, [], rooms) = Some(program), evaluable: program_evaluable(functions).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, last: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    f: Nat, below: f + 1 <= functions.len(), arguments: List<BitVec(64)>,
    fits: arity_fits(program_arity(functions, f), arguments.len()).IsTrue(), defined: program_defined(functions, f, arguments).IsTrue(),
    answer: BitVec(64), evaluates: program_eval(functions, f, arguments) = answer):
    Site<M>(fetch, data, program, last, origin).Returns(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleeKeeps(answer)) {
    Site<M>(fetch, data, program, last, origin).returns_implies(stack, asm_labels(program, f + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(f) <= i,
        stack.CalleePost(answer), stack.CalleeKeeps(answer),
        compiled_returns<M>(functions, placement, rooms, program, lowered, evaluable, fetch, data, last, origin, stack, f, below, arguments, fits,
            defined, answer, evaluates),
        λ i s t room post => stack.callee_keeps(answer, i, s, t, room, post))
}

// ---------------------------------------------------------------------------
// A function at a time: `program_sourced` and `program_eval_sources` live in
// `function_ir_eval.hthr`, beside the evaluator they are about.

// What holds of every list of `n` words, stated at `n` open words.
fn Spread(n: Nat) → (List<BitVec(64)> → Type) → Type {
    match n {
        Zero => λ P => P([]),
        Succ(m) => λ P => (a: BitVec(64)) → Spread(m, λ (ws: List<BitVec(64)>) => P(Cons(a, ws))),
    }
}

theorem spread(n: Nat): (P: List<BitVec(64)> → Type) → Spread(n, P) → (words: List<BitVec(64)>) → words.len() = n → P(words) {
    match n {
        Zero => λ P at words => match words {
            Nil => λ _ => at,
            Cons(_, more) => λ (bad: more.len() + 1 = 0) => false_elim(more.len().succ_ne_zero(bad)),
        },
        Succ(m) => λ P at words => match words {
            Nil => λ (bad: 0 = m + 1) => false_elim(m.zero_ne_succ(bad)),
            Cons(a, more) => λ (same: more.len() + 1 = m + 1) =>
                spread(m, λ (ws: List<BitVec(64)>) => P(Cons(a, ws)), at(a), more, Nat::succ_inj(more.len(), m, same)),
        },
    }
}

// ---------------------------------------------------------------------------
// Loops (issues/function-ir-verified-loop-planning.md). A source function
// that recurses on its fuel, `h(fuel, x…)` matching `Zero` and `Succ(k)`
// and calling `h(k, …)` only in tail position, compiles to a loop of as
// many passes as the fuel, called as `h(w.toNat(), …)`. The loop's
// evaluation is not the source's recursion by conversion: the two are
// stuck on the same open fuel with different steps. They agree by
// induction on the fuel, each pass by case analysis on its comparisons,
// which the compiler proves once per loop with the source's recursion
// abstracted (`later`).

// What a function computes when `post` follows the loop: run on the loop's
// end, read at `result`.
fn loop_finish(post: StructuredRegion, call: Answers(), values: Valuation(), outputs: List<Nat>, exhausted, result: Nat) →
    LoopEnd → BitVec(64) {
    λ end => post.eval(call, Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)))(64, result)
}

// The same over a file of buffers, for a function that reads one.
fn loop_finish_over(buffers: Buffers(), post: StructuredRegion, call: Answers(), values: Valuation(), outputs: List<Nat>, exhausted, result: Nat) →
    LoopEnd → BitVec(64) {
    λ end => post.eval(call, Valuation::set(Valuation::bind(values, outputs, end.state), exhausted, bit_value(end.exhausted)), buffers := buffers)(64, result)
}

theorem function_eval_body(parameters: List<Nat>, body: StructuredRegion, result: Nat, call: Answers(), arguments: List<BitVec(64)>):
    Function(parameters := parameters, body := body, result := result).eval(call, arguments) =
        body.eval(call, Valuation::bind(Valuation::zero(), parameters, arguments))(64, result) { refl }

// A loop and what follows it, evaluated: stated over any regions, so that
// a program's instance is this statement and no conversion runs its loop
// (a constant fuel would unfold it pass by pass).
theorem loop_then_eval(inputs: List<Nat>, bound: Nat, parameters: List<Nat>, count: Nat, body: StructuredRegion, exit: Nat,
    next, outputs: List<Nat>, exhausted: Nat, post: StructuredRegion, call: Answers(), values: Valuation(), result: Nat):
    Compose(Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted), post).eval(call, values)(64, result) =
        loop_finish(post, call, values, outputs, exhausted, result, loop_eval(λ (pass: Valuation()) => body.eval(call, pass), parameters,
            count, exit, next, values(64, bound).toNat(), words_of(values, inputs))) { refl }

// One pass from the state `words_of(v, parameters)` with `Succ(r)` passes
// left: leaving, what `finish` makes of the next state; going round,
// `later` of it.
fn loop_pass(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>, finish: LoopEnd → BitVec(64),
    later: List<BitVec(64)> → BitVec(64), r: Nat, v: Valuation()) → BitVec(64) {
    let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)));
    match after(1, exit).head_bit() {
        False => later(words_of(after, next)),
        True => finish(LoopEnd(words_of(after, next), False)),
    }
}

// A loop agrees with `run`, a recursion on its fuel, when it does with no
// passes left, and each pass does with the recursion on the passes after
// it.
theorem loop_eval_agrees(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    apart: distinct(parameters).IsTrue(), lengths: next.len() = parameters.len(), finish: LoopEnd → BitVec(64),
    run: Nat → List<BitVec(64)> → BitVec(64),
    at_zero: (v: Valuation()) → finish(LoopEnd(words_of(v, parameters), True)) = run(0, words_of(v, parameters)),
    at_pass: (r: Nat) → (v: Valuation()) →
        loop_pass(step, parameters, count, exit, next, finish, λ (state: List<BitVec(64)>) => run(r, state), r, v) =
            run(r + 1, words_of(v, parameters)),
    remaining: Nat):
    (v: Valuation()) → finish(loop_eval(step, parameters, count, exit, next, remaining, words_of(v, parameters))) =
        run(remaining, words_of(v, parameters)) {
    match remaining {
        Zero => λ v => at_zero(v),
        Succ(r) => λ v => {
            let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)));
            let state = words_of(after, next);
            let rebound: (words_of(Valuation::bind(Valuation::zero(), parameters, state), parameters) = state) =
                words_of_bind(Valuation::zero(), parameters, apart, state, sym(trans(words_of_len(after, next), lengths)));
            let earlier = loop_eval_agrees(step, parameters, count, exit, next, apart, lengths, finish, run, at_zero, at_pass, r,
                Valuation::bind(Valuation::zero(), parameters, state));
            let later: (finish(loop_eval(step, parameters, count, exit, next, r, state)) = run(r, state)) =
                j(rebound, λ st _ => finish(loop_eval(step, parameters, count, exit, next, r, st)) = run(r, st), earlier);
            (match after(1, exit).head_bit() as λ b =>
                (match b { False => run(r, state), True => finish(LoopEnd(state, False)) }) = run(r + 1, words_of(v, parameters)) →
                finish(match b { False => loop_eval(step, parameters, count, exit, next, r, state),
                    True => LoopEnd(state, False) }) = run(r + 1, words_of(v, parameters)) {
                False => λ passed => trans(later, passed),
                True => λ passed => passed,
            })(at_pass(r, v))
        },
    }
}

// The same from the loop's inputs, read at the valuation before it.
theorem loop_eval_agrees_from(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    apart: distinct(parameters).IsTrue(), lengths: next.len() = parameters.len(), finish: LoopEnd → BitVec(64),
    run: Nat → List<BitVec(64)> → BitVec(64),
    at_zero: (v: Valuation()) → finish(LoopEnd(words_of(v, parameters), True)) = run(0, words_of(v, parameters)),
    at_pass: (r: Nat) → (v: Valuation()) →
        loop_pass(step, parameters, count, exit, next, finish, λ (state: List<BitVec(64)>) => run(r, state), r, v) =
            run(r + 1, words_of(v, parameters)),
    remaining: Nat, values: Valuation(), inputs: List<Nat>, fits: inputs.len() = parameters.len()):
    finish(loop_eval(step, parameters, count, exit, next, remaining, words_of(values, inputs))) = run(remaining, words_of(values, inputs)) {
    let v = Valuation::bind(Valuation::zero(), parameters, words_of(values, inputs));
    let rebound: (words_of(v, parameters) = words_of(values, inputs)) =
        words_of_bind(Valuation::zero(), parameters, apart, words_of(values, inputs), sym(trans(words_of_len(values, inputs), fits)));
    j(rebound, λ st _ => finish(loop_eval(step, parameters, count, exit, next, remaining, st)) = run(remaining, st),
        loop_eval_agrees(step, parameters, count, exit, next, apart, lengths, finish, run, at_zero, at_pass, remaining, v))
}

// A loop agrees with `run`, a recursion bounded by a measure of its state
// (a function that `decreases`, at a bound on its measure), when it does
// with no passes left and each pass does with the recursion on the passes
// after it, wherever the measure is below the passes left. Proofs of the
// bound are not compared: each side is stated at the one it is handed.
theorem loop_eval_agrees_measured(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    apart: distinct(parameters).IsTrue(), finish: LoopEnd → BitVec(64), measure: List<BitVec(64)> → Nat,
    run: (r: Nat) → (state: List<BitVec(64)>) → Nat::Lt(measure(state), r + 1) → BitVec(64),
    at_zero: (v: Valuation()) → (h: Nat::Lt(measure(words_of(v, parameters)), 1)) →
        finish(LoopEnd(words_of(v, parameters), True)) = run(0, words_of(v, parameters), h),
    at_pass: (r: Nat) → (v: Valuation()) → (h: Nat::Lt(measure(words_of(v, parameters)), r + 2)) →
        ((state: List<BitVec(64)>) → state.len() = parameters.len() → (p: Nat::Lt(measure(state), r + 1)) →
            finish(loop_eval(step, parameters, count, exit, next, r, state)) = run(r, state, p)) →
        loop_pass(step, parameters, count, exit, next, finish,
            λ (state: List<BitVec(64)>) => finish(loop_eval(step, parameters, count, exit, next, r, state)), r, v) =
                run(r + 1, words_of(v, parameters), h),
    remaining: Nat):
    (state: List<BitVec(64)>) → state.len() = parameters.len() → (h: Nat::Lt(measure(state), remaining + 1)) →
        finish(loop_eval(step, parameters, count, exit, next, remaining, state)) = run(remaining, state, h) {
    match remaining {
        Zero => λ state fits => {
            let v = Valuation::bind(Valuation::zero(), parameters, state);
            let rebound: (words_of(v, parameters) = state) = words_of_bind(Valuation::zero(), parameters, apart, state, sym(fits));
            j(rebound, λ st _ => (h: Nat::Lt(measure(st), 1)) → finish(LoopEnd(st, True)) = run(0, st, h), λ h => at_zero(v, h))
        },
        Succ(r) => λ state fits => {
            let v = Valuation::bind(Valuation::zero(), parameters, state);
            let rebound: (words_of(v, parameters) = state) = words_of_bind(Valuation::zero(), parameters, apart, state, sym(fits));
            let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)));
            let following = words_of(after, next);
            let earlier = λ (st: List<BitVec(64)>) (st_fits: st.len() = parameters.len()) (p: Nat::Lt(measure(st), r + 1)) =>
                loop_eval_agrees_measured(step, parameters, count, exit, next, apart, finish, measure, run, at_zero, at_pass, r, st, st_fits, p);
            let at_v = λ (h: Nat::Lt(measure(words_of(v, parameters)), r + 2)) =>
                (match after(1, exit).head_bit() as λ b =>
                    (match b { False => finish(loop_eval(step, parameters, count, exit, next, r, following)),
                        True => finish(LoopEnd(following, False)) }) = run(r + 1, words_of(v, parameters), h) →
                    finish(match b { False => loop_eval(step, parameters, count, exit, next, r, following),
                        True => LoopEnd(following, False) }) = run(r + 1, words_of(v, parameters), h) {
                    False => λ passed => passed,
                    True => λ passed => passed,
                })(at_pass(r, v, h, earlier));
            j(rebound, λ st _ => (h: Nat::Lt(measure(st), r + 2)) →
                finish(loop_eval(step, parameters, count, exit, next, r + 1, st)) = run(r + 1, st, h), at_v)
        },
    }
}

// A state's word `i`, zero past its end: how the compiler reads a source
// recursion's arguments out of a loop's state.
fn List::word(self state: List<BitVec(64)>, i: Nat) → BitVec(64) {
    match state {
        Nil => BitVec::zero(),
        Cons(first, rest) => match i { Zero => first, Succ(k) => rest.word(k) },
    }
}

// ---------------------------------------------------------------------------
// The lowering a function at a time (issues/function-ir-verified-compile-cost.md).
// Every declaration has the same fuel, so `lower_program` evaluated in one
// would bound the program's size. The compiler instead states what emitting
// each function leaves, the code so far, the placement not yet taken and the
// next label, as literals, each from the last's, and glues the steps.

// What an emission left: its code, its placement not taken, its next label.
record Emission { prog: Prog, placement: List<Place>, names: Nat }

fn Emitted::emission(self e: Emitted) → Emission { Emission(prog := e.prog, placement := e.placement, names := e.names) }

// One equation, read through `map`: stating it evaluates the emission once
// and reads back only what it compares. (An equation for each of the three
// evaluated the emission three times: each `refl` is a conversion of its
// own, and nothing one computes is kept for the next.)
fn EmitsAs(out: Option<Emitted>, prog: Prog, rest: List<Place>, names: Nat) → Type {
    out.map(λ (e: Emitted) => e.emission()) = Some(Emission(prog := prog, placement := rest, names := names))
}

theorem Emitted::emits_as(self e: Emitted, prog: Prog, rest: List<Place>, names: Nat, held: EmitsAs(Some(e), prog, rest, names)):
    (e.prog = prog) ∧ ((e.placement = rest) ∧ (e.names = names)) {
    let same = Option::some_inj(e.emission(), Emission(prog := prog, placement := rest, names := names), held);
    ⟨cong_fn(λ (x: Emission) => x.prog, same), ⟨cong_fn(λ (x: Emission) => x.placement, same), cong_fn(λ (x: Emission) => x.names, same)⟩⟩
}

// A program that lends buffers is emitted under the count each function
// takes (`counts`, docs/native/native-one-compiler-design.md §2.3); one that lends
// none is the same statements at no counts.
theorem emit_functions_lent_start(placement: List<Place>, names: Nat, counts: List<Nat>, rooms: Nat → Nat):
    EmitsAs(emit_functions_after_lent(Start, [], placement, names, counts, rooms), Start, placement, names) {
    refl
}

theorem emit_functions_lent_next(last: Function, earlier: List<Function>, placement: List<Place>, names: Nat, counts: List<Nat>,
    rooms: Nat → Nat, prog: Prog, rest: List<Place>, labels: Nat,
    before: EmitsAs(emit_functions_after_lent(Start, earlier, placement, names, counts, rooms), prog, rest, labels),
    next_prog: Prog, next_rest: List<Place>, next_labels: Nat,
    emitted: EmitsAs(last.emit_lent(prog, earlier.len(), rest, labels, counts, rooms), next_prog, next_rest, next_labels)):
    EmitsAs(emit_functions_after_lent(Start, Cons(last, earlier), placement, names, counts, rooms), next_prog, next_rest, next_labels) {
    (match emit_functions_after_lent(Start, earlier, placement, names, counts, rooms) as λ out =>
        EmitsAs(out, prog, rest, labels) →
        EmitsAs(match out { None => None, Some(b) => last.emit_lent(b.prog, earlier.len(), b.placement, b.names, counts, rooms) },
            next_prog, next_rest, next_labels) {
        None => λ held => Option::none_ne_some(Emission(prog := prog, placement := rest, names := labels), held,
            EmitsAs(None, next_prog, next_rest, next_labels)),
        Some(b) => λ held => j(sym(b.emits_as(prog, rest, labels, held).left),
            λ x _ => EmitsAs(last.emit_lent(x, earlier.len(), b.placement, b.names, counts, rooms), next_prog, next_rest, next_labels),
            j(sym(b.emits_as(prog, rest, labels, held).right.left),
                λ y _ => EmitsAs(last.emit_lent(prog, earlier.len(), y, b.names, counts, rooms), next_prog, next_rest, next_labels),
                j(sym(b.emits_as(prog, rest, labels, held).right.right),
                    λ z _ => EmitsAs(last.emit_lent(prog, earlier.len(), rest, z, counts, rooms), next_prog, next_rest, next_labels),
                    emitted))),
    })(before)
}

// The program under the room table `rooms`: every function's frame and
// calls fit their rows, which each emission checked
// (`Function::roomy`), and the code is laid out.
theorem lower_program_roomed_emitted(functions: List<Function>, placement: List<Place>, counts: List<Nat>, rooms: Nat → Nat, prog: Prog,
    rest: List<Place>, labels: Nat,
    emitted: EmitsAs(emit_functions_after_lent(Start, functions, placement, functions.len(), counts, rooms), prog, rest, labels),
    laid: prog.laid_out().IsTrue()): lower_program_roomed(functions, placement, counts, rooms) = Some(prog) {
    let decided: ((match prog.laid_out() as λ _ => Option<Prog> { False => None, True => Some(prog) }) = Some(prog)) =
        j(sym(eq_true_of_is_true(prog.laid_out(), laid)), λ b _ => (match b as λ _ => Option<Prog> { False => None, True => Some(prog) }) = Some(prog),
            refl);
    (match emit_functions_after_lent(Start, functions, placement, functions.len(), counts, rooms) as λ out =>
        EmitsAs(out, prog, rest, labels) →
        (match out as λ _ => Option<Prog> {
            None => None,
            Some(o) => match o.prog.laid_out() { False => None, True => Some(o.prog) },
        }) = Some(prog) {
        None => λ held => Option::none_ne_some(Emission(prog := prog, placement := rest, names := labels), held, None<Prog>() = Some(prog)),
        Some(o) => λ held => j(sym(o.emits_as(prog, rest, labels, held).left),
            λ x _ => (match x.laid_out() as λ _ => Option<Prog> { False => None, True => Some(x) }) = Some(prog), decided),
    })(emitted)
}

theorem emit_functions_start(placement: List<Place>, names: Nat, rooms: Nat → Nat):
    EmitsAs(emit_functions([], placement, names, rooms), Start, placement, names) {
    emit_functions_lent_start(placement, names, [], rooms)
}

theorem emit_functions_next(last: Function, earlier: List<Function>, placement: List<Place>, names: Nat, rooms: Nat → Nat, prog: Prog,
    rest: List<Place>, labels: Nat, before: EmitsAs(emit_functions(earlier, placement, names, rooms), prog, rest, labels), next_prog: Prog,
    next_rest: List<Place>, next_labels: Nat, emitted: EmitsAs(last.emit(prog, earlier.len(), rest, labels, rooms), next_prog, next_rest, next_labels)):
    EmitsAs(emit_functions(Cons(last, earlier), placement, names, rooms), next_prog, next_rest, next_labels) {
    emit_functions_lent_next(last, earlier, placement, names, [], rooms, prog, rest, labels, before, next_prog, next_rest, next_labels, emitted)
}

// ---------------------------------------------------------------------------
// The lowered code as numbers (`Prog::numbers`, x86_64_asm), for the
// compiler to read back and state as a literal; the placement's here.

// A place: its register's index, or 16 folded; a function's count of saves,
// 17 and the count (at most six); its count of call slots, 24 and the count
// (at most eight); what a call saves, 33 and the mask (at most 255); a label
// whose jumps are short, 289 and its name.
fn Place::number(self place: Place) → Nat {
    match place { Into(register) => register.index(), Folded => 16, Saving(count) => 17 + count, CallSlots(count) => 24 + count, Spilling(mask) => 33 + mask, Short(name) => 289 + name }
}

// ---------------------------------------------------------------------------
// Two words back (docs/native/runtime-fn-setups-design.md §16.16)

// The evaluator's run of a function that stores nothing, over no buffers,
// with its words past the first from the same run.
theorem Function::eval_runs_both(self function: Function, earlier: List<Function>, ok: function.evaluable(program_arity(earlier)).IsTrue(),
    below: program_evaluable(earlier).IsTrue(), quiet: function.body.quiet().IsTrue(), reads: program_quiet(earlier).IsTrue(),
    arguments: List<BitVec(64)>, count: function.parameters.len() = arguments.len()):
    function.RunsBoth(program_effects(earlier), arguments, function.eval(program_eval_over(Nil, earlier), arguments),
        function.eval_also(program_eval_over(Nil, earlier), arguments), Nil, Nil) {
    let call = program_eval_over(Nil, earlier);
    let parts = Bool::is_true_and(function.body.evaluable(program_arity(earlier)),
        distinct(function.parameters) && disjoint(function.body.writes(), function.parameters), ok);
    let params = Bool::is_true_and(distinct(function.parameters), disjoint(function.body.writes(), function.parameters), parts.right);
    let bound = Valuation::bind(Valuation::zero(), function.parameters, arguments);
    let after = function.body.eval(call, bound, buffers := Nil);
    let read: (words_of(after, function.parameters) = arguments) = trans(
        words_agree(function.parameters, bound, after, λ id m =>
            function.body.eval_frame(call, Nil, bound, 64, id, disjoint_mem(function.body.writes(), function.parameters, params.right, id, m))),
        words_of_bind(Valuation::zero(), function.parameters, params.left, arguments, count));
    let holds = function.body.eval_holds_in(program_callees_over(Nil, earlier), call, program_arity(earlier), Nil,
        program_eval_reads(earlier, Nil, below), parts.left, bound, after, λ w id _ => refl);
    let keeping = function.body.runs_quiet(λ (held: Buffers()) => program_callees_over(held, earlier), Nil, quiet, after, holds);
    Exists(after, ⟨read, ⟨function.body.runs_weaken(Effects::keeping(λ (held: Buffers()) => program_callees_over(held, earlier)), program_effects(earlier),
        λ before g words word a kept => j(sym(kept.right), λ x _ => program_effects(earlier)(before, g, words, word, x),
            program_effects_quiet(earlier, reads, before, g, words, word, kept.left)),
        after, Nil, Nil, keeping), ⟨refl, refl⟩⟩⟩)
}

// A program that stores nothing, its last function returning two words:
// the code returns the first in RAX and the rest in RDX, at its arguments,
// with the stack its row of `rooms` says. What a caller outside the
// program reads of a function that returns a record of two words.
theorem compiled_returns_both<M>(last: Function, earlier: List<Function>, placement: List<Place>, rooms: Nat → Nat, program: Prog,
    lowered: lower_program_roomed(Cons(last, earlier), placement, [], rooms) = Some(program),
    evaluable: program_evaluable(Cons(last, earlier)).IsTrue(), quiet: program_quiet(Cons(last, earlier)).IsTrue(),
    fetch: FetchAccess<M>, data: ByteReadAccess<M>, bytes: List<BitVec(8)>, origin: BitVec(64), stack: Stack<M>(fetch, data),
    arguments: List<BitVec(64)>, count: last.parameters.len() = arguments.len(), answer: BitVec(64), rest: List<BitVec(64)>,
    evaluates: last.eval(program_eval(earlier), arguments) = answer, evaluates_rest: last.eval_also(program_eval(earlier), arguments) = rest):
    Site<M>(fetch, data, program, bytes, origin).Returns(stack, asm_labels(program, earlier.len() + 1),
        λ (i: Nat) (s: MachineState<M>) => stack.Passed(arguments, i, s) ∧ rooms(earlier.len()) <= i,
        λ (i: Nat) (s: MachineState<M>) (t: MachineState<M>) => stack.CalleePost(answer)(i, s, t) ∧ ArgsIn(rest, [Rdx], t.gprs)) {
    let functions = Cons(last, earlier);
    let lending = Lending::none();
    let parts = Bool::is_true_and(last.evaluable(program_arity(earlier)), program_evaluable(earlier), evaluable);
    let quiets = Bool::is_true_and(last.body.quiet(), program_quiet(earlier), quiet);
    let both = lower_program_roomed(functions, placement, lending.counts, rooms).all_some(
        λ (p: Prog) => ProgramLastBoth<M>(fetch, data, bytes, origin, stack, stack.size, rooms, lending, last, earlier, p), program, lowered,
        lower_program_last_both<M>(fetch, data, bytes, origin, stack, stack.size, rooms, lending, last, earlier, placement,
            program_quiet_lendless(functions, quiet), λ b stores => false_elim(program_quiet_stores(functions, b, quiet, stores))));
    let ran = j(evaluates_rest, λ r _ => last.RunsBoth(program_effects(earlier), arguments, answer, r, Nil, Nil),
        j(evaluates, λ x _ => last.RunsBoth(program_effects(earlier), arguments, x, last.eval_also(program_eval(earlier), arguments), Nil, Nil),
            last.eval_runs_both(earlier, parts.left, parts.right, quiets.left, quiets.right, arguments, count)));
    let returns = both(lending, refl, stack.loan_nothing(), λ b no => false_elim(no), arguments, answer, rest, Nil, Nil);
    λ s at resident i rsp room held ret saved => {
        let r = returns(s, at, resident, i, rsp, room, ⟨⟨held.left, ⟨ran, held.right⟩⟩, ⟨trivial, ⟨room, stack.in_memory_none(s.memory)⟩⟩⟩, ret, saved);
        let post = r.proof.right.right.right.right;
        Exists(r.witness, ⟨r.proof.left, ⟨r.proof.right.left, ⟨r.proof.right.right.left, ⟨r.proof.right.right.right.left,
            ⟨⟨post.left.left, ⟨post.left.right.left,
                stack.wrote_in_none(i, lending.spans(), λ b => refl, s.memory, r.witness.memory, post.left.right.right.left)⟩⟩, post.right⟩⟩⟩⟩⟩)
    }
}

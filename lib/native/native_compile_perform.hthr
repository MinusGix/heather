// A call's code, as claims of trees (docs/native/native-procedures-design.md §4–§5;
// docs/native/native-procedures-are-functions-design.md, steps 5a to 5c): the
// pieces `native_compile_correct` chains into a call's claim and a
// procedure's.
//
// RSP is the frame and the frame holds the words (`Target::held_rsp`,
// `Target::Slots`), so the claim between statements (`Target::Held`) is an
// activation's, and a call leaves it for another (`Target::activation`:
// the same target, its frame, frames and room replaced). Between the two
// RSP is at neither frame, and the claim there is `Target::Bare`: the
// region, and the stack's words from RSP up. A CALL pushes the return
// address below the caller's frame (`Target::held_bare`,
// `Target::bare_pushed`); the callee counts the depth
// (`Target::goes_count_down`), pushes RBX and the registers words live in
// that a function would keep (`Target::goes_saves`), opens its frame, whose
// slots hold what the stack held (`Target::held_fresh`), and runs; on its
// way out it counts the depth back (`Target::goes_count_up`), closes the
// frame, pops the registers (`Target::goes_restores`) and returns to the
// caller's frame, whose words nothing wrote (`Target::bare_caller`).
//
// A callee is stated once (`Target::Callable`): entered as the one call
// sequence enters it, it runs as a tree of its own answers, each read as
// where it leaves the machine (`Answer`, `Target::Ends`). A function meets
// the contract by its proved return (native_compile_function) and a
// procedure by its body (native_compile_correct), and one call site calls
// either (`Target::goes_calls`, native_compile_function).
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_homes;
import native_compile_segments;
import native_compile_steps;
import native_compile_frames;
import native_compile_structured;
import function_ir_eval;
import function_ir;
import function_ir_lend;
import native_alloc;
import linux_calls;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_sim;
import linux_x86_64_sim_paid;
import itree;
import x86_64;
import x86_64_block;
import x86_64_fetch;
import x86_64_fetched_code;
import x86_64_data_read;
import x86_64_store;
import x86_64_byte_memory;
import x86_64_asm;

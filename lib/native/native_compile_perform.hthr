// ---------------------------------------------------------------------------
// The activation

// The same target running another activation.
fn Target::activation(self t: Target, index: Nat, frames: List<BitVec(64)>, room: Nat, framed: index + 8 * (t.words + frames.len()) <= t.stack.size,
    roomy: (room * (8 * (t.words + 7)) + program_calls_room(t.functions)) + 8 <= index) → Target {
    Target(t.r, t.words, t.caps, t.homes, t.homed, t.fits, t.program, t.origin, t.laid, t.args, t.procedures, t.functions, t.stack, t.stack_writes,
        t.stack_above, t.stack_canonical, index, frames, room, framed, roomy)
}

// The frames and the slots, read off the claim.
theorem Target::held_frames(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)):
    t.FramesAt(m, t.frames, t.index + 8 * t.words) {
    held.proof.left.proof.right.right.right.right.right.right
}

theorem Target::held_slots(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)):
    t.Slots(held.proof.left.witness, m) {
    held.proof.left.proof.right.right.right.right.right.left
}

// The claim reads no proof of the activation's.
theorem Target::held_proofs(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    framed: t.index + 8 * (t.words + t.frames.len()) <= t.stack.size, roomy: (t.room * (8 * (t.words + 7)) + program_calls_room(t.functions)) + 8 <= t.index):
    t.activation(t.index, t.frames, t.room, framed, roomy).Held(live, env, g, m) {
    held
}

// ---------------------------------------------------------------------------
// The region's slots

// A word of the region, read at its address.
theorem Target::read_at(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), holds: t.r.Holds(v, m), q: Nat, fits: q + 8 <= t.r.size):
    (next_rip(t.r.low, q).toNat() + 8 <= Nat::pow(2, 47)) ∧ (read_word(t.r.profile.data(), m, next_rip(t.r.low, q)) = Some(word_in(v, q))) {
    let base = next_rip(t.r.low, q);
    let o = λ (k: Nat) => t.r.profile.read(m, next_rip(base, k));
    let g = λ (k: Nat) => t.r.buffer(v).get(q + k);
    let b = λ (k: Nat) (short: k < 8) => t.r.buffer_read(v, m, holds, q, k, Nat::le_trans(Succ(q + k), q + 8, t.r.size, q.add_le_mono_l(Succ(k), 8, short), fits));
    let read: (read_word(t.r.profile.data(), m, base) = Some(word_in(v, q))) =
        word_of_eight(o(0), o(1), o(2), o(3), o(4), o(5), o(6), o(7), g(0), g(1), g(2), g(3), g(4), g(5), g(6), g(7),
            b(0, trivial), b(1, trivial), b(2, trivial), b(3, trivial), b(4, trivial), b(5, trivial), b(6, trivial), b(7, trivial));
    let value = t.r.toNat_at(q, q.le_of_add_le(8, t.r.size, fits));
    let low = t.r.low.toNat();
    let ends: (low + (q + 8) <= Nat::pow(2, 47)) = Nat::le_trans(low + (q + 8), low + t.r.size, Nat::pow(2, 47),
        low.add_le_mono_l(q + 8, t.r.size, fits), t.r.canonical);
    ⟨j(sym(value), λ x _ => x + 8 <= Nat::pow(2, 47), j(sym(low.add_assoc(q, 8)), λ x _ => x <= Nat::pow(2, 47), ends)), read⟩
}

// ---------------------------------------------------------------------------
// Counts

// One down…
theorem word_down(y: BitVec(64)): next_rip(y, 1).sub(BitVec::ofNat(1)) = y {
    trans(sym(BitVec::iter_sub_eq_sub(64, next_rip(y, 1), BitVec::ofNat(1))), BitVec::iterate_add_sub_cancel(64, 1, y))
}

theorem count_down(x: BitVec(64), d: Nat, value: x.toNat() = Succ(d)): x.sub(BitVec::ofNat(1)).toNat() = d {
    let bound: (x.toNat() < Nat::pow(2, 64)) = BitVec::toNat_lt_pow(64, x);
    let y: BitVec(64) = BitVec::ofNat(d);
    let y_value: (y.toNat() = d) = BitVec::toNat_ofNat(64, d, omega(bound, value));
    let up: (next_rip(y, 1).toNat() = y.toNat() + 1) = BitVec::offset_toNat(64, y, 1, omega(bound, value, y_value));
    let same: (next_rip(y, 1) = x) = trans(sym(BitVec::ofNat_toNat(64, next_rip(y, 1))),
        trans(cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), omega(up, y_value, value)), BitVec::ofNat_toNat(64, x)));
    j(same, λ z _ => z.sub(BitVec::ofNat(1)).toNat() = d, trans(cong_fn<BitVec(64), Nat>(λ z => z.toNat(), word_down(y)), y_value))
}

// …and one up.
theorem count_up(x: BitVec(64), d: Nat, value: x.toNat() = d, small: Succ(d) < Nat::pow(2, 64)):
    x.add(BitVec::ofNat(1, n := 8).sign_extend(56)).toNat() = Succ(d) {
    let added: (x.add(BitVec::ofNat(1, n := 8).sign_extend(56)) = next_rip(x, 0 + 1)) = displaced_at(x, 0, BitVec::ofNat(1), refl);
    trans(cong_fn<BitVec(64), Nat>(λ z => z.toNat(), added), trans(BitVec::offset_toNat(64, x, 1, omega(value, small)), omega(value)))
}

// ---------------------------------------------------------------------------
// Scratch registers

// A register no word lives in, and not RSP, written.
theorem Target::held_scratch(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    register: Gpr, value: BitVec(64), outside: register.absent_from(Cons(Rsp, home_pool())).IsTrue()): t.Held(live, env, write_gpr(register, value, g), m) {
    t.held_unused(live, env, g, m, held, register, value, t.homes.unused(register, known), Bool::false_of_not(register.same(Rsp), known))
}

// ---------------------------------------------------------------------------
// Where a call's pieces start, inside what they build

// A call's code from its start (`Prog::performs`).
theorem Prog::within_words_from(layout: Layout, out: List<Nat>, ids: List<Nat>): (registers: List<Gpr>) → (p: Prog) → p.Within(p.words_from(layout, out, ids, registers)) {
    match ids {
        Nil => λ registers p => p.within_self(),
        Cons(id, rest) => λ registers => match registers {
            Nil => λ p => p.within_self(),
            Cons(register, more) => λ p => {
                let one = p.word_from(layout, out.minus(rest), id, register);
                Prog::within_trans(p.within_word_from(layout, out.minus(rest), id, register),
                    Prog::within_words_from(layout, out, rest, more, one))
            },
        },
    }
}

theorem Prog::within_calls(self p: Prog, layout: Layout, label, lent: Nat, arguments: List<Nat>): p.Within(p.calls(layout, label, lent, arguments)) {
    let passed = p.words_to(layout, arguments, call_registers().drop(2 * lent));
    calc { p <= passed := Prog::within_words_to(layout, arguments, call_registers().drop(2 * lent), p), <= p.calls(layout, label, lent, arguments) := Exists(3, refl), }
}

theorem Prog::within_performs(self p: Prog, layout: Layout, out: List<Nat>, index: Nat, args, results: List<Nat>):
    p.Within(p.performs(layout, out, index, args, results)) {
    let called = p.calls(layout, layout.procedure_label(index), 0, args);
    Prog::within_trans(p.within_calls(layout, layout.procedure_label(index), 0, args),
        Prog::within_words_from(layout, out, results, result_registers(), called))
}

// ---------------------------------------------------------------------------
// The stack forms, as `Target::goes_store` has the region's

// A word spilled where the stack has room.
theorem Target::goes_spill(self t: Target, before: Prog, name: Nat, store: StackStore, within: Prog::At(before, name, Spill(store)).Within(t.program),
    tree: ITree<BitVec(64)>(Events::linux()), post: MachineState<X86Memory(t.r.profile)> → Type, next: t.Goes(prog_len(before) + 5, tree, post)):
    t.Goes(prog_len(before), tree, λ s => Exists<Nat>(λ i => (stack_address(s.gprs, store.offset) = t.stack.at(i)) ∧
        ((i + 8 <= t.stack.size) ∧ post(store.after(t.writes(), s))))) {
    let moves = t.site().moves_spill(t.stack, t.code_fits(), within.witness, before, name, store, within.proof,
        λ s => Exists<Nat>(λ i => (stack_address(s.gprs, store.offset) = t.stack.at(i)) ∧
            ((i + 8 <= t.stack.size) ∧ post(store.after(t.stack.writes, s)))), post, λ s held => held);
    let linux = j(t.stack_writes, λ ws _ => t.site().Moves(ws, prog_len(before), prog_len(before) + 5,
        λ s => Exists<Nat>(λ i => (stack_address(s.gprs, store.offset) = t.stack.at(i)) ∧
            ((i + 8 <= t.stack.size) ∧ post(store.after(ws, s)))), post), moves);
    t.io().goes_after(t.program, t.origin, prog_len(before), prog_len(before) + 5, tree,
        λ s => Exists<Nat>(λ i => (stack_address(s.gprs, store.offset) = t.stack.at(i)) ∧
            ((i + 8 <= t.stack.size) ∧ post(store.after(t.writes(), s)))), post, linux, next)
}

// A word reloaded from where the stack holds it.
theorem Target::goes_reload(self t: Target, before: Prog, name: Nat, load: StackLoad, within: Prog::At(before, name, Reload(load)).Within(t.program),
    tree: ITree<BitVec(64)>(Events::linux()), post: MachineState<X86Memory(t.r.profile)> → Type, next: t.Goes(prog_len(before) + 5, tree, post)):
    t.Goes(prog_len(before), tree, λ s => Exists<Nat>(λ i => (stack_address(s.gprs, load.offset) = t.stack.at(i)) ∧
        ((i + 8 <= t.stack.size) ∧ Exists<BitVec(64)>(λ word => (read_word(t.site().data, s.memory, t.stack.at(i)) = Some(word)) ∧
            post(load.after(word, s)))))) {
    let pre: MachineState<X86Memory(t.r.profile)> → Type = λ s => Exists<Nat>(λ i => (stack_address(s.gprs, load.offset) = t.stack.at(i)) ∧
        ((i + 8 <= t.stack.size) ∧ Exists<BitVec(64)>(λ word => (read_word(t.site().data, s.memory, t.stack.at(i)) = Some(word)) ∧
            post(load.after(word, s)))));
    let moves = t.site().moves_reload(t.stack, t.code_fits(), within.witness, before, name, load, within.proof, pre, post, λ s held => held);
    t.io().goes_after(t.program, t.origin, prog_len(before), prog_len(before) + 5, tree, pre, post,
        j(t.stack_writes, λ ws _ => t.site().Moves(ws, prog_len(before), prog_len(before) + 5, pre, post), moves), next)
}

// ---------------------------------------------------------------------------
// Frames

theorem Env::words_at_len(self env: Env, ids: List<Nat>): env.words_at(ids).len() = ids.len() {
    match ids { Nil => refl, Cons(_, rest) => cong_fn<Nat, Nat>(λ n => Succ(n), env.words_at_len(rest)) }
}

// Frames one after another.
theorem Target::frames_append(self t: Target, m: X86Memory(t.r.profile), xs: List<BitVec(64)>): (ys: List<BitVec(64)>) → (i: Nat) →
    t.FramesAt(m, xs, i) → t.FramesAt(m, ys, i + 8 * xs.len()) → t.FramesAt(m, xs ++ ys, i) {
    match xs {
        Nil => λ ys i _ at => { let same: (i + 8 * 0 = i) = omega(); j(same, λ k _ => t.FramesAt(m, ys, k), at) },
        Cons(x, rest) => λ ys i first second => ⟨first.left, ⟨first.right.left,
            t.frames_append(m, rest, ys, i + 8, first.right.right, {
                let same: (i + 8 * Succ(rest.len()) = (i + 8) + 8 * rest.len()) = omega();
                j(same, λ k _ => t.FramesAt(m, ys, k), second)
            })⟩⟩,
    }
}

// ---------------------------------------------------------------------------
// A call's arguments, into the call registers

// The registers hold the values, pairwise (as many as both lists have)…
fn Gprs::holding_from(self g: Gprs, values: List<BitVec(64)>) → List<Gpr> → Type {
    match values {
        Nil => λ _ => True,
        Cons(value, rest) => λ registers => match registers { Nil => True, Cons(register, more) => (read_gpr(register, g) = value) ∧ g.holding_from(rest)(more) },
    }
}
fn Gprs::Holding(self g: Gprs, registers: List<Gpr>, values: List<BitVec(64)>) → Type { g.holding_from(values)(registers) }

// …and the words.
fn Env::InRegisters(self env: Env, g: Gprs, ids: List<Nat>, registers: List<Gpr>) → Type { g.Holding(registers, env.words_at(ids)) }

// Every register but RBX and `registers` reads in `g2` as in `g`.
fn Gprs::KeepsOutside(self g2: Gprs, g: Gprs, registers: List<Gpr>) → Type {
    (x: Gpr) → x.absent_from(Cons(Rbx, registers)).IsTrue() → read_gpr(x, g2) = read_gpr(x, g)
}

// No register of the list is in the pool.
fn gprs_outside(registers: List<Gpr>, pool: List<Gpr>) → Bool {
    match registers { Nil => True, Cons(register, rest) => register.absent_from(pool) && gprs_outside(rest, pool) }
}

theorem gprs_outside_mem(registers, pool: List<Gpr>): gprs_outside(registers, pool).IsTrue() → (r: Gpr) → Mem(r, registers) → r.absent_from(pool).IsTrue() {
    match registers {
        Nil => λ _ r never => false_elim(never),
        Cons(x, rest) => λ h r m => {
            match m {
                Inl(e) => j(sym(e), λ y _ => y.absent_from(pool).IsTrue(), known),
                Inr(later) => gprs_outside_mem(rest, pool, known, r, later),
            }
        },
    }
}

theorem gprs_outside_of(registers, pool: List<Gpr>): ((r: Gpr) → Mem(r, registers) → r.absent_from(pool).IsTrue()) → gprs_outside(registers, pool).IsTrue() {
    match registers {
        Nil => λ _ => trivial,
        Cons(x, rest) => λ h => Bool::is_true_and_intro(x.absent_from(pool), gprs_outside(rest, pool),
            h(x, Inl(refl)), gprs_outside_of(rest, pool, λ y m => h(y, Inr(m)))),
    }
}

// `gprs_outside(registers, pool)`: no register of the list is in the pool.
register def gprs_outside_set_entry: SetRelEntry = SetRelEntry(name_of(gprs_outside), name_of(gprs_outside_mem), name_of(gprs_outside_of), 0);

// `Prog::words_to` into registers no word lives in and not RSP, distinct and apart from
// RBX: the words held, the registers hold them, and nothing else but RBX moves.
theorem Target::goes_words_to(self t: Target, live: List<Nat>, env: Env, tree: ITree<BitVec(64)>(Events::linux()), q: Gprs → X86Memory(t.r.profile) → Type,
    ids: List<Nat>): (registers: List<Gpr>) → (p: Prog) → ((i: Nat) → Mem(i, ids) → (i < t.words) ∧ Mem(i, live)) →
    gprs_outside(registers, Cons(Rsp, home_pool())).IsTrue() → gprs_distinct(Cons(Rbx, registers)).IsTrue() →
    p.words_to(t.layout(), ids, registers).Within(t.program) → t.GoesR(prog_len(p.words_to(t.layout(), ids, registers)), tree, q) →
    t.GoesR(prog_len(p), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m) ∧
        ((g2: Gprs) → t.Held(live, env, g2, m) → env.InRegisters(g2, ids, registers) → g2.KeepsOutside(g, registers) → q(g2, m))) {
    let layout = t.layout();
    match ids {
        Nil => λ registers p _ _ _ _ next => t.goes_weaken(next, λ u h => h.right(u.gprs, h.left, trivial, λ x _ => refl)),
        Cons(id, rest) => λ registers => match registers {
            Nil => λ p _ _ _ _ next => t.goes_weaken(next, λ u h => h.right(u.gprs, h.left, trivial, λ x _ => refl)),
            Cons(register, more) => λ p ok scratch distinct within next => {
                let loaded = p.word_to(layout, id, register);
                let w_loaded = Prog::within_trans(Prog::within_words_to(layout, rest, more, loaded), within);
                let rbx_rest: Rbx.absent_from(more).IsTrue() = Rbx.absent_rest(register, more, known);
                let distinct2: gprs_distinct(Cons(Rbx, more)).IsTrue() = Bool::is_true_and_intro(Rbx.absent_from(more), gprs_distinct(more), rbx_rest, known);
                let later = t.goes_words_to(live, env, tree, q, rest, more, loaded, λ i m => ok(i, Inr(m)), known, distinct2, within, next);
                let w = env.word(id);
                let inside = ok(id, Inl(refl));
                let q1 = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m) ∧
                    ((g2: Gprs) → t.Held(live, env, g2, m) → env.InRegisters(g2, rest, more) → g2.KeepsOutside(g, more) → q(g2, m));
                let word = t.goes_word_to(live, env, p, id, register, inside.left, inside.right, w_loaded, tree, q1, later);
                t.goes_weaken(word, λ u held => {
                    let g = u.gprs;
                    let m = u.memory;
                    let g0 = t.rbx_gprs(env, id, g);
                    let g1 = write_gpr(register, w, g0);
                    let held1: t.Held(live, env, g1, m) = t.held_scratch(live, env, g0, m, t.held_rbx(live, env, g, m, held.left, env, id), register, w, known);
                    ⟨held.left, ⟨held1, λ g2 held2 passed keeps => {
                        let not_rbx: (register.same(Rbx) = False) = Rbx.absent_head(register, more, known);
                        let away: register.absent_from(Cons(Rbx, more)).IsTrue() = Bool::is_true_and_intro(!register.same(Rbx), register.absent_from(more),
                            j(sym(not_rbx), λ b _ => (!b).IsTrue(), trivial), known);
                        let mine: (read_gpr(register, g2) = w) = trans(keeps(register, away), read_gpr_after_write(register, w, g0));
                        held.right(g2, held2, ⟨mine, passed⟩, λ x absent => {
                            let x_rest: x.absent_from(more).IsTrue() = x.absent_rest(register, more, known);
                            trans(keeps(x, Bool::is_true_and_intro(!x.same(Rbx), x.absent_from(more), known, x_rest)),
                                trans(read_gpr_other(register, x, w, g0, x.absent_head(register, more, known)),
                                    t.rbx_gprs_other(env, id, g, x, x.absent_head(Rbx, Cons(register, more), absent))))
                        })
                    }⟩⟩
                })
            },
        },
    }
}

// A CALL to label `Succ(n)` lands where that label's item starts.
theorem Prog::lands_call(self p: Prog, laid: p.laid_out().IsTrue(), k: Nat, before: Prog, name: Nat, n: Nat,
    at: asm_back(p, k) = At(before, name, CallTo(Succ(n))), label_k: Nat, label: Prog, item: Asm,
    label_at: asm_back(p, label_k) = At(label, Succ(n), item)):
    NearLands(prog_len(before), asm_jump_of(asm_labels(p), prog_len(before), CallTo(Succ(n))), prog_len(label)) {
    let lands = call_lands(asm_labels(p), k, p, before, name, Succ(n), p.laid_out_lands(laid), at);
    j(label_target(label_k, p, label, n, item, p.laid_out_unique(laid), label_at),
        λ to _ => NearLands(prog_len(before), asm_jump_of(asm_labels(p), prog_len(before), CallTo(Succ(n))), to), lands)
}

// ---------------------------------------------------------------------------
// Words sharing a home

// Two live words in one register hold one number.
theorem Target::held_shared(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    x, y: Nat, mx: Mem(x, live), my: Mem(y, live), k: Nat, at_x: t.homes.home(x) = InReg(k), at_y: t.homes.home(y) = InReg(k)): env.number(x) = env.number(y) {
    let words = held.witness;
    let values = home_values(g);
    let read: ((i: Nat) → Mem(i, live) → t.homes.home(i) = InReg(k) → (values.get_or(k, BitVec::zero()).toNat() = env.number(i))) = λ i mi at =>
        j(at, λ h _ => (match h { InSlot => words.get_or(i, 0), InReg(r) => values.get_or(r, BitVec::zero()).toNat() }) = env.number(i), held.proof.right.left(i, mi));
    trans(sym(read(x, mx, at_x)), read(y, my, at_y))
}

// Into its register, where every other word of `out` in that register holds
// the same number.
theorem Target::held_reg_shared(self t: Target, live, out: List<Nat>, env: Env, id: Nat, w: BitVec(64), g: Gprs, m: X86Memory(t.r.profile),
    held: t.Held(live, env, g, m), sub: (i: Nat) → Mem(i, out) → i ≠ id → Mem(i, live), k: Nat, at: t.homes.home(id) = InReg(k),
    shared: (i: Nat) → Mem(i, out) → i ≠ id → t.homes.home(i) = InReg(k) → env.number(i) = w.toNat()):
    t.Held(out, env.set_word(id, w), write_gpr(home_register(k), w, g), m) {
    let words = held.witness;
    let inside = t.homes.in_pool(t.homed, id, k, at);
    let values = home_values(g).put(k, w, BitVec::zero());
    let written: (home_values(write_gpr(home_register(k), w, g)) = values) = home_values_write(w, g, k, inside);
    let before: ((i: Nat) → Mem(i, out) → i ≠ id → (h: Home) → t.homes.home(i) = h →
        ((match h { InSlot => words.get_or(i, 0), InReg(r) => home_values(g).get_or(r, BitVec::zero()).toNat() }) = env.number(i))) =
        λ i m2 ne h at_i => j(at_i, λ x _ => (match x { InSlot => words.get_or(i, 0), InReg(r) => home_values(g).get_or(r, BitVec::zero()).toNat() }) = env.number(i),
            held.proof.right.left(i, sub(i, m2, ne)));
    let agrees: t.homes.Agrees(out, env.set_word(id, w), words, values) = λ i m2 => match i.eq_dec(id) {
        Inl(e) => j(sym(e), λ x _ => t.homes.number(x, words, values) = env.set_word(id, w).number(x),
            j(sym(at), λ h _ => (match h { InSlot => words.get_or(id, 0), InReg(r) => values.get_or(r, BitVec::zero()).toNat() }) =
                env.set_word(id, w).number(id),
                trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), values.get_or_some(k, BitVec::zero(), w,
                    List::put_here(k, home_values(g), w, BitVec::zero()))), sym(env.number_set_here(id, w))))),
        Inr(ne) => match at_i: t.homes.home(i) {
            InSlot => trans(before(i, m2, ne, InSlot, at_i), sym(env.number_set_other(id, w, i, ne))),
            InReg(r) => match r.eq_dec(k) {
                Inl(e) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), values.get_or_some(r, BitVec::zero(), w,
                        j(sym(e), λ x _ => values.nth(x) = Some(w), List::put_here(k, home_values(g), w, BitVec::zero())))),
                    trans(sym(shared(i, m2, ne, j(e, λ x _ => t.homes.home(i) = InReg(x), at_i))), sym(env.number_set_other(id, w, i, ne)))),
                Inr(apart) => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), List::put_other(k, home_values(g), w, BitVec::zero(), r, apart)),
                    trans(before(i, m2, ne, InReg(r), at_i), sym(env.number_set_other(id, w, i, ne)))),
            },
        },
    };
    let rsp: (values.get_or(6, BitVec::zero()) = t.frame()) =
        trans(List::put_other(k, home_values(g), w, BitVec::zero(), 6, λ e => false_elim(omega(e, inside))), held.proof.right.right);
    j(sym(written), λ vs _ => Exists<List<Nat>>(λ ws => t.Placed(env.set_word(id, w).with_words(ws), m) ∧ t.Agreeing(out, env.set_word(id, w), ws, vs)),
        Exists(words, ⟨held.proof.left, ⟨agrees, rsp⟩⟩))
}

// A word set to the number it had: alike everywhere.
theorem Env::like_set_same(self env: Env, id: Nat, w: BitVec(64), value: w.toNat() = env.number(id), live: List<Nat>): env.set_word(id, w).Like(env, live) {
    ⟨λ i _ => match i.eq_dec(id) {
        Inl(e) => j(sym(e), λ x _ => env.set_word(id, w).number(x) = env.number(x), trans(env.number_set_here(id, w), value)),
        Inr(ne) => env.number_set_other(id, w, i, ne),
    }, ⟨refl, refl⟩⟩
}

// ---------------------------------------------------------------------------
// The shared exit of a call too deep

theorem Target::goes_deep(self t: Target, dp: Prog, within: dp.deep_exit(t.layout()).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    pre: MachineState<X86Memory(t.r.profile)> → Type,
    exits: (s: MachineState<X86Memory(t.r.profile)>) → LinuxSyscallAt(t.io(), s) → LinuxExits(s, call_depth_status()) → SimPaid(t.io(), tree, s)):
    t.Goes(prog_len(dp), tree, pre) {
    let set_list: List<Instruction> = [MovRI(Rdi, call_depth_status()), MovRI(Rax, BitVec::ofNat(60))];
    let lab = dp.label(t.layout().deep_label());
    let set = then(lab, Block(set_list));
    let w_set = set.within_before(0, Syscall, t.program, within);
    let w_lab = lab.within_before(0, Block(set_list), t.program, w_set);
    let called = t.io().goes_exit(t.program, t.origin, t.code_fits(), within.witness, set, 0, within.proof, tree, call_depth_status(), exits);
    let moved = t.goes_block(lab, 0, set_list, w_set, tree, λ u => LinuxExits(u, call_depth_status()), called);
    let into: t.Goes(prog_len(lab), tree, λ u => True) = t.goes_weaken(moved, λ s _ => ⟨refl, refl⟩);
    let labelled = t.goes_block(dp, t.layout().deep_label(), [], w_lab, tree, λ u => True, into);
    t.goes_weaken(labelled, λ s _ => trivial)
}

// ---------------------------------------------------------------------------
// Registers into homes

theorem Target::spares_trans(self t: Target, g, g2, g3: Gprs, a: t.Spares(g, g2), b: t.Spares(g2, g3)): t.Spares(g, g3) {
    λ x unused rbx => trans(b(x, unused, rbx), a(x, unused, rbx))
}

// What registers no word lives in hold, kept.
theorem Target::holding_spares(self t: Target, g, g2: Gprs, spares: t.Spares(g, g2), values: List<BitVec(64)>):
    (registers: List<Gpr>) → gprs_outside(registers, home_pool()).IsTrue() → Rbx.absent_from(registers).IsTrue() → g.Holding(registers, values) → g2.Holding(registers, values) {
    match values {
        Nil => λ _ _ _ _ => trivial,
        Cons(value, rest) => λ registers => match registers {
            Nil => λ _ _ _ => trivial,
            Cons(register, more) => λ outside rbx holding => {
                ⟨trans(spares(register, t.homes.unused(register, known), trans(Rbx.same_comm(register), Rbx.absent_head(register, more, rbx))), holding.left),
                    t.holding_spares(g, g2, spares, rest, more, known, Rbx.absent_rest(register, more, rbx), holding.right)⟩
            },
        },
    }
}

theorem List::mem_minus_nil(self out: List<Nat>, i: Nat, m: Mem(i, out)): Mem(i, out.minus(Nil)) { by sets() }

theorem List::mem_minus_cons(self out: List<Nat>, rest: List<Nat>, i, id: Nat, m: Mem(i, out.minus(rest)), ne: i ≠ id): Mem(i, out.minus(Cons(id, rest))) { by sets() }

// `Prog::words_from` from registers holding `values`, as many as the words:
// the words set to them where `out` is live.
theorem Target::goes_words_from(self t: Target, out: List<Nat>, tree: ITree<BitVec(64)>(Events::linux()), q: Gprs → X86Memory(t.r.profile) → Type,
    ids: List<Nat>): (registers: List<Gpr>) → (values: List<BitVec(64)>) → (p: Prog) → (live: List<Nat>) → (env: Env) →
    ((i: Nat) → Mem(i, out.minus(ids)) → Mem(i, live)) → ((i: Nat) → Mem(i, ids) → i < t.words) → t.homes.moves_apart(out, ids).IsTrue() →
    gprs_outside(registers, home_pool()).IsTrue() → Rbx.absent_from(registers).IsTrue() → ids.len() <= registers.len() → ids.len() <= values.len() →
    p.words_from(t.layout(), out, ids, registers).Within(t.program) → t.GoesR(prog_len(p.words_from(t.layout(), out, ids, registers)), tree, q) →
    t.GoesR(prog_len(p), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m) ∧ (g.Holding(registers, values) ∧
        ((g2: Gprs) → (m2: X86Memory(t.r.profile)) → t.Held(out, env.set_words(ids, values), g2, m2) → t.Spares(g, g2) → q(g2, m2)))) {
    let layout = t.layout();
    match ids {
        Nil => λ registers values p live env sub _ _ _ _ _ _ _ next => t.goes_weaken(next, λ s held => held.right.right(s.gprs, s.memory, t.held_sub(held.left, λ i m => sub(i, out.mem_minus_nil(i, m))),
                λ x _ _ => refl)),
        Cons(id, rest) => λ registers => match registers {
            Nil => λ _ _ _ _ _ _ _ _ _ short => false_elim(Nat::not_succ_le_zero(rest.len(), short)),
            Cons(register, more) => λ values => match values {
                Nil => λ _ _ _ _ _ _ _ _ _ none => false_elim(Nat::not_succ_le_zero(rest.len(), none)),
                Cons(value, vs) => λ p live env sub inside apart outside rbx short long within next => {
                    let out1 = out.minus(rest);
                    let stepped = p.word_from(layout, out1, id, register);
                    let w_step = Prog::within_trans(Prog::within_words_from(layout, out, rest, more, stepped), within);
                    let env1 = env.set_word(id, value);
                    let later = t.goes_words_from(out, tree, q, rest, more, vs, stepped, out1, env1, λ i m => m, λ i m => inside(i, Inr(m)), known,
                        known, Rbx.absent_rest(register, more, rbx), omega(short), omega(long), within, next);
                    let q1 = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(out1, env1, g, m) ∧ (g.Holding(more, vs) ∧
                        ((g2: Gprs) → (m2: X86Memory(t.r.profile)) → t.Held(out, env1.set_words(rest, vs), g2, m2) → t.Spares(g, g2) → q(g2, m2)));
                    let moved = t.goes_word_from(live, out1, env, p, id, register, inside(id, Inl(refl)), trans(Rbx.same_comm(register), Rbx.absent_head(register, more, rbx)),
                        λ i m ne => sub(i, out.mem_minus_cons(rest, i, id, m, ne)), known, w_step, tree, q1, later);
                    t.goes_weaken(moved, λ s held => ⟨held.left, λ g2 m2 held2 spares => ⟨j(held.right.left.left, λ v _ => t.Held(out1, env.set_word(id, v), g2, m2), held2),
                            ⟨t.holding_spares(s.gprs, g2, spares, vs, more, known, Rbx.absent_rest(register, more, rbx), held.right.left.right),
                            λ g3 m3 held3 spares3 => held.right.right(g3, m3, held3, t.spares_trans(s.gprs, g2, g3, spares, spares3))⟩⟩⟩)
                },
            },
        },
    }
}

// ---------------------------------------------------------------------------
// A call's way out

// A room one past `d` still counts in a word.
theorem Target::room_small(self t: Target, d: Nat, succ: t.room = Succ(d)): Succ(d) < Nat::pow(2, 64) {
    let was: ((Succ(d) * (8 * (t.words + 7)) + program_calls_room(t.functions)) + 8 <= t.index) =
        j(succ, λ r _ => (r * (8 * (t.words + 7)) + program_calls_room(t.functions)) + 8 <= t.index, t.roomy);
    let one_le: (1 * Succ(d) <= (8 * (t.words + 7)) * Succ(d)) = Nat::mul_le_mono_r(Succ(d), 1, 8 * (t.words + 7), omega());
    let one: (Succ(d) <= Succ(d) * (8 * (t.words + 7))) = j(Nat::mul_comm(8 * (t.words + 7), Succ(d)), λ x _ => Succ(d) <= x,
        j(Nat::mul_left_one(Succ(d)), λ x _ => x <= (8 * (t.words + 7)) * Succ(d), one_le));
    let below: (Succ(d) <= t.index) = omega(one, was);
    omega(below, t.framed, t.stack_canonical, canonical_below_top())
}

// ---------------------------------------------------------------------------
// Words set in order

theorem Env::set_words_outside(self env: Env, ids: List<Nat>): (words: List<BitVec(64)>) → (i: Nat) → absent(i, ids).IsTrue() →
    env.set_words(ids, words).number(i) = env.number(i) {
    match ids {
        Nil => λ words i _ => refl,
        Cons(id, rest) => λ words => match words {
            Nil => λ i _ => refl,
            Cons(w, ws) => λ i none => {
                trans(env.set_word(id, w).set_words_outside(rest, ws, i, known), env.number_set_other(id, w, i, i.differs_ne(id, known)))
            },
        },
    }
}

theorem Env::set_words_buffers(self env: Env, ids: List<Nat>): (words: List<BitVec(64)>) → (env.set_words(ids, words).buffers = env.buffers) ∧ (env.set_words(ids, words).args = env.args) {
    match ids {
        Nil => λ words => ⟨refl, refl⟩,
        Cons(id, rest) => λ words => match words { Nil => ⟨refl, refl⟩, Cons(w, ws) => env.set_word(id, w).set_words_buffers(rest, ws) },
    }
}

// Two environments with the same words set read alike on them.
theorem Env::set_words_agree(ids: List<Nat>): (a, b: Env) → (words: List<BitVec(64)>) → ids.len() <= words.len() → (i: Nat) → Mem(i, ids) →
    a.set_words(ids, words).number(i) = b.set_words(ids, words).number(i) {
    match ids {
        Nil => λ a b words _ i never => false_elim(never),
        Cons(id, rest) => λ a b words => match words {
            Nil => λ long => false_elim(Nat::not_succ_le_zero(rest.len(), long)),
            Cons(w, ws) => λ long i m => match f: absent(i, rest) {
                False => Env::set_words_agree(rest, a.set_word(id, w), b.set_word(id, w), ws, omega(long), i, absent_false_mem(i, rest, f)),
                True => {
                    let none: absent(i, rest).IsTrue() = Bool::is_true_of_eq(f);
                    let same: (i = id) = match m { Inl(e) => e, Inr(later) => false_elim(absent_mem(i, rest, none, i, later)(refl)) };
                    let here = λ (e: Env) => trans(e.set_word(id, w).set_words_outside(rest, ws, i, none),
                        j(sym(same), λ x _ => e.set_word(id, w).number(x) = w.toNat(), e.number_set_here(id, w)));
                    trans(here(a), sym(here(b)))
                },
            },
        },
    }
}

// The callee's environment, on the words its body needs: what the caller's
// words set to the arguments read there.
theorem Env::entered_like(self env: Env, params, entry: List<Nat>, values: List<BitVec(64)>, long: params.len() <= values.len(),
    within: (i: Nat) → Mem(i, entry) → Mem(i, params)): env.set_words(params, values).Like(Env(Nil, env.buffers, env.args).set_words(params, values), entry) {
    let mine = env.set_words_buffers(params, values);
    let theirs = Env(Nil, env.buffers, env.args).set_words_buffers(params, values);
    ⟨λ i m => Env::set_words_agree(params, env, Env(Nil, env.buffers, env.args), values, long, i, within(i, m)),
        ⟨trans(mine.left, sym(theirs.left)), trans(mine.right, sym(theirs.right))⟩⟩
}

// A register outside the list, written: the list holds what it held.
theorem Gprs::holding_write(self g: Gprs, register: Gpr, value: BitVec(64), values: List<BitVec(64)>):
    (registers: List<Gpr>) → register.absent_from(registers).IsTrue() → g.Holding(registers, values) → write_gpr(register, value, g).Holding(registers, values) {
    match values {
        Nil => λ _ _ _ => trivial,
        Cons(v, vs) => λ registers => match registers {
            Nil => λ _ _ => trivial,
            Cons(r, more) => λ absent holding => ⟨trans(read_gpr_other(register, r, value, g, trans(register.same_comm(r), register.absent_head(r, more, absent))), holding.left),
                g.holding_write(register, value, vs, more, register.absent_rest(r, more, absent), holding.right)⟩,
        },
    }
}

// The command line, read off the claim.
theorem Target::held_args(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)): env.args = t.args {
    held.proof.left.proof.right.right.left
}

// ---------------------------------------------------------------------------
// The claim between two frames

// What the claim says of the region, whatever activation is running: the
// cells, the buffers, the command line and the room, `room` calls of it.
// It reads the cells below the canonical boundary only
// (`Target::based_agree`), where no frame's word is kept
// (`Layout::frame_cell`). The room is stated beside the target's: between
// a callee's label and its frame the count is not yet the callee's.
fn Target::Based(self t: Target, env: Env, room: Nat, v: Nat → BitVec(8), m: X86Memory(t.r.profile)) → Type {
    t.r.Holds(v, m) ∧ (((b, cap: Nat) → t.layout().capacities.nth(b) = Some(cap) → env.buffer(b) = cells_at(v, t.layout().buffer_offset(b), cap)) ∧
    ((env.args = t.args) ∧ (ArgvAt(t.argv(), m, word_in(v, t.layout().stack_offset()), t.args) ∧
    (word_in(v, t.layout().room_offset()).toNat() = room))))
}

theorem Target::held_based(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)):
    t.Based(env, t.room, held.proof.left.witness, m) {
    let pp = held.proof.left.proof;
    ⟨pp.left, ⟨pp.right.left.right, ⟨pp.right.right.left, ⟨pp.right.right.right.left, pp.right.right.right.right.left⟩⟩⟩⟩
}

theorem Target::based_agree(self t: Target, env: Env, room: Nat, v, w: Nat → BitVec(8), m: X86Memory(t.r.profile), based: t.Based(env, room, v, m),
    same: (p: Nat) → p < Nat::pow(2, 47) → w(p) = v(p)): t.Based(env, room, w, m) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let slots: (so + 16 <= t.r.size) = t.fits;
    let canon = t.size_canonical();
    let slot: (word_in(w, so) = word_in(v, so)) = word_in_agree(w, v, so, λ k short => same(so + k, omega(short, slots, canon)));
    let counted: (word_in(w, so + 8) = word_in(v, so + 8)) = word_in_agree(w, v, so + 8, λ k short => same(so + 8 + k, omega(short, slots, canon)));
    ⟨λ p inside => trans(based.left(p, inside), sym(same(p, omega(inside, canon)))),
     ⟨λ b cap found => trans(based.right.left(b, cap, found), cells_agree(v, w, cap, layout.buffer_offset(b), λ i below =>
            sym(same(layout.buffer_offset(b) + i, omega(below, layout.buffer_end(b, cap, found), t.scratch_fits(), canon))))),
      ⟨based.right.right.left, ⟨j(sym(slot), λ y _ => ArgvAt(t.argv(), m, y, t.args), based.right.right.right.left),
        trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), counted), based.right.right.right.right)⟩⟩⟩⟩
}

theorem Target::based_stack_store(self t: Target, env: Env, room: Nat, v: Nat → BitVec(8), m: X86Memory(t.r.profile), based: t.Based(env, room, v, m),
    i: Nat, fits: i + 8 <= t.stack.size, word: BitVec(64)): t.Based(env, room, v, t.r.profile.store(m, t.stack.at(i), word_bytes(word))) {
    ⟨t.stack_store_holds(v, m, based.left, i, fits, word), ⟨based.right.left, ⟨based.right.right.left,
        ⟨t.argv_stack_store(m, i, fits, word, word_in(v, t.layout().stack_offset()), based.right.right.right.left), based.right.right.right.right⟩⟩⟩⟩
}

// The room slot stored: the region with the count the word is. The slot
// is past the buffers and the saved RSP.
theorem Target::based_room_store(self t: Target, env: Env, room: Nat, v: Nat → BitVec(8), m: X86Memory(t.r.profile), based: t.Based(env, room, v, m),
    counted: Nat, word: BitVec(64), value: word.toNat() = counted):
    t.Based(env, counted, t.r.buffer(v).set_span(t.layout().stack_offset() + 8, word_bytes(word).to_vector()).cells,
        t.r.profile.store(m, t.layout().room_at(), word_bytes(word))) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let ro = so + 8;
    let bytes = word_bytes(word);
    let eight: (bytes.len() = 8) = refl;
    let slots: (so + 16 <= t.r.size) = t.fits;
    let fits: (ro + bytes.len() <= t.r.size) = omega(slots, eight);
    let w = t.r.buffer(v).set_span(ro, bytes.to_vector()).cells;
    let m2 = t.r.profile.store(m, next_rip(t.r.low, ro), bytes);
    let stack: (so = layout.scratch_offset() + (t.caps.largest() + 1)) = refl;
    let slot: (word_in(w, so) = word_in(v, so)) = word_in_agree(w, v, so, λ k short => t.r.cells_outside(v, ro, bytes, so + k, Inl(omega(short))));
    let stored: (word_in(w, ro) = word) = t.r.x86_word_stored(v, ro, word);
    let holds = t.r.store_holds(v, m, based.left, ro, bytes, fits);
    let argv = j(sym(slot), λ y _ => ArgvAt(t.argv(), m2, y, t.args),
        argv_at_kept(t.argv(), m, t.argv(), m2, t.kept_store(m, ro, bytes, fits), word_in(v, so), t.args, based.right.right.right.left));
    let at_low: t.Based(env, counted, w, m2) = ⟨holds,
        ⟨λ b cap found => trans(based.right.left(b, cap, found), cells_agree(v, w, cap, layout.buffer_offset(b), λ i below =>
            sym(t.r.cells_outside(v, ro, bytes, layout.buffer_offset(b) + i, Inl(omega(below, layout.buffer_end(b, cap, found), stack)))))),
         ⟨based.right.right.left, ⟨argv, trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), stored), value)⟩⟩⟩⟩;
    j(sym(t.at_rip(ro)), λ a _ => t.Based(env, counted, w, t.r.profile.store(m, a, bytes)), at_low)
}

// The region, the stack's words from offset `i` up, and RSP there.
fn Target::Bare(self t: Target, env: Env, room: Nat, i: Nat, above: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile)) → Type {
    Exists<Nat → BitVec(8)>(λ v => t.Based(env, room, v, m)) ∧ (t.FramesAt(m, above, i) ∧ (read_gpr(Rsp, g) = t.stack.at(i)))
}

// The frame's words from word `from` on, `count` of them, as the cells
// keep them.
fn Layout::cells_from(self layout: Layout, v: Nat → BitVec(8), from, count: Nat) → List<BitVec(64)> {
    match count { Zero => Nil, Succ(k) => Cons(word_in(v, layout.frame_cell(from)), layout.cells_from(v, Succ(from), k)) }
}

theorem Layout::cells_from_len(self layout: Layout, v: Nat → BitVec(8), count: Nat): (from: Nat) → layout.cells_from(v, from, count).len() = count {
    match count { Zero => λ _ => refl, Succ(k) => λ from => cong_fn<Nat, Nat>(λ n => Succ(n), layout.cells_from_len(v, k, Succ(from))) }
}

// A frame's slots are words of the stack in order…
theorem Target::frames_of_slots(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), slots: t.Slots(v, m), count: Nat):
    (from: Nat) → from + count <= t.words → t.FramesAt(m, t.layout().cells_from(v, from, count), t.index + 8 * from) {
    match count {
        Zero => λ _ _ => trivial,
        Succ(k) => λ from fits => {
            let inside: (from < t.words) = omega(fits);
            let next: (t.index + 8 * Succ(from) = (t.index + 8 * from) + 8) = omega();
            ⟨t.slot_inside(from, inside), ⟨slots(from, inside),
                j(next, λ n _ => t.FramesAt(m, t.layout().cells_from(v, Succ(from), k), n), t.frames_of_slots(v, m, slots, k, Succ(from), omega(fits)))⟩⟩
        },
    }
}

// …and such words are its slots.
theorem Target::slots_of_frames(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), count: Nat):
    (from: Nat) → t.FramesAt(m, t.layout().cells_from(v, from, count), t.index + 8 * from) →
    (i: Nat) → from <= i → i < from + count → read_word(t.io().data, m, t.slot(i)) = Some(word_in(v, t.layout().frame_cell(i))) {
    match count {
        Zero => λ from _ i low high => false_elim(omega(low, high)),
        Succ(k) => λ from at i low high => match i.eq_dec(from) {
            Inl(e) => j(sym(e), λ n _ => read_word(t.io().data, m, t.slot(n)) = Some(word_in(v, t.layout().frame_cell(n))), at.right.left),
            Inr(ne) => {
                let next: ((t.index + 8 * from) + 8 = t.index + 8 * Succ(from)) = omega();
                t.slots_of_frames(v, m, k, Succ(from), j(next, λ n _ => t.FramesAt(m, t.layout().cells_from(v, Succ(from), k), n), at.right.right),
                    i, omega(low, ne), omega(high))
            },
        },
    }
}

// Frames one after another, taken apart.
theorem Target::frames_take(self t: Target, m: X86Memory(t.r.profile), xs: List<BitVec(64)>): (ys: List<BitVec(64)>) → (i: Nat) →
    t.FramesAt(m, xs ++ ys, i) → t.FramesAt(m, xs, i) {
    match xs {
        Nil => λ _ _ _ => trivial,
        Cons(x, rest) => λ ys i at => ⟨at.left, ⟨at.right.left, t.frames_take(m, rest, ys, i + 8, at.right.right)⟩⟩,
    }
}

theorem Target::frames_drop(self t: Target, m: X86Memory(t.r.profile), xs: List<BitVec(64)>): (ys: List<BitVec(64)>) → (i: Nat) →
    t.FramesAt(m, xs ++ ys, i) → t.FramesAt(m, ys, i + 8 * xs.len()) {
    match xs {
        Nil => λ ys i at => { let same: (i = i + 8 * 0) = omega(); j(same, λ k _ => t.FramesAt(m, ys, k), at) },
        Cons(x, rest) => λ ys i at => {
            let same: ((i + 8) + 8 * rest.len() = i + 8 * Succ(rest.len())) = omega();
            j(same, λ k _ => t.FramesAt(m, ys, k), t.frames_drop(m, rest, ys, i + 8, at.right.right))
        },
    }
}

// The claim between statements, as the stack's words from the frame up:
// the frame's own, then its frames.
theorem Target::held_bare(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)):
    t.Bare(env, t.room, t.index, t.layout().cells_from(held.proof.left.witness, 0, t.words) ++ t.frames, g, m) {
    let v = held.proof.left.witness;
    let cells = t.layout().cells_from(v, 0, t.words);
    let zero: (t.index + 8 * 0 = t.index) = omega();
    let fits: (0 + t.words <= t.words) = omega();
    let first: t.FramesAt(m, cells, t.index) = j(zero, λ k _ => t.FramesAt(m, cells, k),
        t.frames_of_slots(v, m, t.held_slots(live, env, g, m, held), t.words, 0, fits));
    let len: (cells.len() = t.words) = t.layout().cells_from_len(v, t.words, 0);
    let rest: t.FramesAt(m, t.frames, t.index + 8 * cells.len()) = j(sym(len), λ n _ => t.FramesAt(m, t.frames, t.index + 8 * n),
        t.held_frames(live, env, g, m, held));
    ⟨Exists(v, t.held_based(live, env, g, m, held)), ⟨t.frames_append(m, cells, t.frames, t.index, first, rest), t.held_rsp(live, env, g, m, held)⟩⟩
}

// A word pushed.
theorem Target::bare_pushed(self t: Target, env: Env, room: Nat, i: Nat, above: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile),
    bare: t.Bare(env, room, i + 8, above, g, m), fits: i + 8 <= t.stack.size, word: BitVec(64), g2: Gprs, rsp: read_gpr(Rsp, g2) = t.stack.at(i)):
    t.Bare(env, room, i, Cons(word, above), g2, t.r.profile.store(m, t.stack.at(i), word_bytes(word))) {
    ⟨Exists(bare.left.witness, t.based_stack_store(env, room, bare.left.witness, m, bare.left.proof, i, fits, word)),
     ⟨⟨fits, ⟨t.stack_store_read(m, i, fits, word), t.frames_stack_store(m, i, fits, word, above, i + 8, (i + 8).le_refl(), bare.right.left)⟩⟩, rsp⟩⟩
}

// ---------------------------------------------------------------------------
// The depth, counted in the callee

// `Prog::count_down`, from the region with `room` calls of room and
// whatever else `r` says of the registers and memory: none left, to the
// shared exit; otherwise one less. `r` is kept by writes of RAX and R11 and
// by a store to the room slot.
theorem Target::goes_count_down(self t: Target, env: Env, room: Nat, p: Prog, within: p.count_down(t.layout()).Within(t.program),
    deep_k: Nat, deep_before: Prog, deep_item: Asm, deep_at: asm_back(t.program, deep_k) = Prog::At(deep_before, t.layout().deep_label(), deep_item),
    tree: ITree<BitVec(64)>(Events::linux()), r: Gprs → X86Memory(t.r.profile) → Type,
    keep_g: (g, g2: Gprs) → (m: X86Memory(t.r.profile)) → r(g, m) →
        ((x: Gpr) → Rax.same(x) = False → R11.same(x) = False → read_gpr(x, g2) = read_gpr(x, g)) → r(g2, m),
    keep_m: (g: Gprs) → (m: X86Memory(t.r.profile)) → (word: BitVec(64)) → r(g, m) → r(g, t.r.profile.store(m, t.layout().room_at(), word_bytes(word))),
    zero: room = 0 → t.Goes(prog_len(deep_before), tree, λ _ => True),
    more: (d: Nat) → room = Succ(d) → t.Goes(prog_len(p.count_down(t.layout())), tree, λ s =>
        Exists<Nat → BitVec(8)>(λ v => t.Based(env, d, v, s.memory)) ∧ r(s.gprs, s.memory))):
    t.Goes(prog_len(p), tree, λ s =>
        Exists<Nat → BitVec(8)>(λ v => t.Based(env, room, v, s.memory)) ∧ r(s.gprs, s.memory)) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let ro = so + 8;
    let slots: (so + 16 <= t.r.size) = t.fits;
    let p1 = then(p, Block([MovRI(R11, layout.room_at())]));
    let p2 = then(p1, Load(WordLoad(Rax, R11)));
    let p3 = p2.test_label(Rax);
    let tested = p2.branch_label(Rax, layout.deep_label());
    let down: List<Instruction> = [MovRI(R11, BitVec::ofNat(1)), SubRR(Rax, R11), MovRI(R11, layout.room_at())];
    let l1 = then(tested, Block(down));
    let w_l1 = l1.within_before(0, Store(WordStore(R11, Rax)), t.program, within);
    let w_tested = tested.within_before(0, Block(down), t.program, w_l1);
    let w_p3 = p3.within_before(0, Jcc(E, layout.deep_label()), t.program, w_tested);
    let w_p2 = p2.within_before(0, Block([TestRR(Rax, Rax)]), t.program, w_p3);
    let w_p1 = p1.within_before(0, Load(WordLoad(Rax, R11)), t.program, w_p2);
    let based: Nat → X86Memory(t.r.profile) → Type = λ n m => Exists<Nat → BitVec(8)>(λ v => t.Based(env, n, v, m));
    let pre = λ (g: Gprs) (f: Flags) (m: X86Memory(t.r.profile)) => (based(room, m) ∧ r(g, m)) ∧
        ((read_gpr(Rax, g).toNat() = room) ∧ (f.zf = is_zero_bits(64, read_gpr(Rax, g).band(read_gpr(Rax, g)))));
    // One less, past the JE.
    let fall = λ (d: Nat) (same: room = Succ(d)) => {
        let post = λ (s: MachineState<X86Memory(t.r.profile)>) => based(d, s.memory) ∧ r(s.gprs, s.memory);
        let stored = t.goes_store(l1, 0, WordStore(R11, Rax), within, tree, post, more(d, same));
        let at_store = λ (s: MachineState<X86Memory(t.r.profile)>) => (store_base_plain(R11) = True) ∧
            (t.writes().writable(s.memory, read_gpr(R11, s.gprs), 8) ∧
            (t.site().Resident(word_store_after(t.writes(), WordStore(R11, Rax), s).memory) ∧ post(word_store_after(t.writes(), WordStore(R11, Rax), s))));
        let lessened = t.goes_block(tested, 0, down, w_l1, tree, at_store, stored);
        let entered: t.Goes(prog_len(tested), tree, λ s => pre(s.gprs, s.flags, s.memory) ∧
                (condition_holds(E, s.flags) = False)) = λ s here resident held => lessened(s, here, resident, {
                let g = s.gprs;
                let m = s.memory;
                let rax = read_gpr(Rax, g).sub(BitVec::ofNat(1));
                let value: (rax.toNat() = d) = count_down(read_gpr(Rax, g), d, trans(held.left.right.left, same));
                let bytes = word_bytes(rax);
                let m2 = t.r.profile.store(m, layout.room_at(), bytes);
                let ga = write_gpr(R11, BitVec::ofNat(1), g);
                let gb = write_gpr(Rax, rax, ga);
                let g1 = write_gpr(R11, layout.room_at(), gb);
                let was = held.left.left.left;
                let less: based(d, m2) = Exists(t.r.buffer(was.witness).set_span(ro, bytes.to_vector()).cells,
                    t.based_room_store(env, room, was.witness, m, was.proof, d, rax, value));
                let r1: r(g1, m) = keep_g(g, g1, m, held.left.left.right, λ x not_rax not_r11 =>
                    trans(read_gpr_other(R11, x, layout.room_at(), gb, not_r11), trans(read_gpr_other(Rax, x, rax, ga, not_rax),
                        read_gpr_other(R11, x, BitVec::ofNat(1), g, not_r11))));
                let r2: r(g1, m2) = keep_m(g1, m, rax, r1);
                let rip_r = sym(t.at_rip(ro));
                ⟨refl, ⟨j(rip_r, λ a _ => t.writes().writable(m, a, 8), t.writable(m, ro, 8, omega(slots))),
                    ⟨j(rip_r, λ a _ => t.site().Resident(t.r.profile.store(m, a, bytes)), t.store_resident(m, ro, bytes, omega(slots), resident)),
                     ⟨less, r2⟩⟩⟩⟩
            });
        entered
    };
    let lands = t.program.lands_jcc(t.laid, w_tested.witness, p3, 0, E, t.procedures.len() + t.functions.len(), w_tested.proof, deep_k, deep_before, deep_item, deep_at);
    let jumped = t.io().goes_jcc(t.program, t.origin, t.code_fits(), w_tested.witness, p3, 0, E, layout.deep_label(), w_tested.proof,
        prog_len(deep_before), lands, tree, pre,
        λ u here resident held => match room.lt_or_ge(1) {
            Inl(none) => {
                let z: (room = 0) = omega(none);
                zero(z)(u, here, resident, trivial)
            },
            Inr(some) => {
                let read: (read_gpr(Rax, u.gprs).toNat() = room) = held.left.right.left;
                let positive: (0 < read_gpr(Rax, u.gprs).toNat()) = omega(read, some);
                absurd(trans(sym(held.right), trans(held.left.right.right, test_self_nonzero(64, read_gpr(Rax, u.gprs), positive))))
            },
        },
        λ u here resident held => match room.lt_or_ge(1) {
            Inl(none) => {
                let read: (read_gpr(Rax, u.gprs).toNat() = room) = held.left.right.left;
                let z: (read_gpr(Rax, u.gprs).toNat() = 0) = omega(read, none);
                absurd(trans(sym(test_self_zero(64, read_gpr(Rax, u.gprs), z)), trans(sym(held.left.right.right), held.right)))
            },
            Inr(some) => {
                let same: (room = Succ(room - 1)) = omega(some);
                fall(room - 1, same)(u, here, resident, held)
            },
        });
    let at_jcc = λ (u: MachineState<X86Memory(t.r.profile)>) => pre(u.gprs, u.flags, u.memory);
    let flagged = t.goes_block_jcc(p2, 0, [TestRR(Rax, Rax)], w_p3, tree, E, pre, jumped, λ _ => refl);
    let at_test = λ (u: MachineState<X86Memory(t.r.profile)>) => at_jcc(execute_block_normal([TestRR(Rax, Rax)], u));
    let loaded = t.goes_load(p1, 0, WordLoad(Rax, R11), w_p2, tree, at_test, flagged);
    let at_load: MachineState<X86Memory(t.r.profile)> → Type = λ u => Exists<BitVec(64)>(λ word =>
        (read_gpr(R11, u.gprs).toNat() + 8 <= Nat::pow(2, 47)) ∧
        ((read_word(t.site().data, u.memory, read_gpr(R11, u.gprs)) = Some(word)) ∧ at_test(word_load_after(WordLoad(Rax, R11), word, u))));
    let moved = t.goes_block(p, 0, [MovRI(R11, layout.room_at())], w_p1, tree, at_load, loaded);
    λ s here resident held => {
        let g = s.gprs;
        let m = s.memory;
        let v = held.left.witness;
        let word = word_in(v, ro);
        let read = t.read_at(v, m, held.left.proof.left, ro, omega(slots));
        let rip_r = sym(t.at_rip(ro));
        let ga = write_gpr(R11, layout.room_at(), g);
        let g1 = write_gpr(Rax, word, ga);
        let r1: r(g1, m) = keep_g(g, g1, m, held.right, λ x not_rax not_r11 =>
            trans(read_gpr_other(Rax, x, word, ga, not_rax), read_gpr_other(R11, x, layout.room_at(), g, not_r11)));
        moved(s, here, resident, Exists(word, ⟨j(rip_r, λ a _ => a.toNat() + 8 <= Nat::pow(2, 47), read.left),
            ⟨j(rip_r, λ a _ => read_word(t.site().data, m, a) = Some(word), read.right),
             ⟨⟨held.left, r1⟩, ⟨held.left.proof.right.right.right.right, refl⟩⟩⟩⟩))
    }
}

// `Prog::count_up`, with `d` calls of room: one more. `r` is kept by
// writes of RBX and R11 and by a store to the room slot.
theorem Target::goes_count_up(self t: Target, env: Env, d: Nat, small: Succ(d) < Nat::pow(2, 64), p: Prog,
    r: Gprs → X86Memory(t.r.profile) → Type,
    keep_g: (g, g2: Gprs) → (m: X86Memory(t.r.profile)) → r(g, m) →
        ((x: Gpr) → Rbx.same(x) = False → R11.same(x) = False → read_gpr(x, g2) = read_gpr(x, g)) → r(g2, m),
    keep_m: (g: Gprs) → (m: X86Memory(t.r.profile)) → (word: BitVec(64)) → r(g, m) → r(g, t.r.profile.store(m, t.layout().room_at(), word_bytes(word))),
    within: p.count_up(t.layout()).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.Goes(prog_len(p.count_up(t.layout())), tree, λ s =>
        Exists<Nat → BitVec(8)>(λ v => t.Based(env, Succ(d), v, s.memory)) ∧ r(s.gprs, s.memory))):
    t.Goes(prog_len(p), tree, λ s =>
        Exists<Nat → BitVec(8)>(λ v => t.Based(env, d, v, s.memory)) ∧ r(s.gprs, s.memory)) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let ro = so + 8;
    let slots: (so + 16 <= t.r.size) = t.fits;
    let r1 = then(p, Block([MovRI(Rbx, layout.room_at())]));
    let r2 = then(r1, Load(WordLoad(R11, Rbx)));
    let r3 = then(r2, Block([AddRI8(R11, BitVec::ofNat(1))]));
    let w_r3 = r3.within_before(0, Store(WordStore(Rbx, R11)), t.program, within);
    let w_r2 = r2.within_before(0, Block([AddRI8(R11, BitVec::ofNat(1))]), t.program, w_r3);
    let w_r1 = r1.within_before(0, Load(WordLoad(R11, Rbx)), t.program, w_r2);
    let final_post = λ (s: MachineState<X86Memory(t.r.profile)>) => Exists<Nat → BitVec(8)>(λ v => t.Based(env, Succ(d), v, s.memory)) ∧ r(s.gprs, s.memory);
    let st2 = t.goes_store(r3, 0, WordStore(Rbx, R11), within, tree, final_post, next);
    let a3 = λ (s: MachineState<X86Memory(t.r.profile)>) => (store_base_plain(Rbx) = True) ∧ (t.writes().writable(s.memory, read_gpr(Rbx, s.gprs), 8) ∧
        (t.site().Resident(word_store_after(t.writes(), WordStore(Rbx, R11), s).memory) ∧ final_post(word_store_after(t.writes(), WordStore(Rbx, R11), s))));
    let add = t.goes_block(r2, 0, [AddRI8(R11, BitVec::ofNat(1))], w_r3, tree, a3, st2);
    let a2 = λ (s: MachineState<X86Memory(t.r.profile)>) => a3(execute_block_normal([AddRI8(R11, BitVec::ofNat(1))], s));
    let ld = t.goes_load(r1, 0, WordLoad(R11, Rbx), w_r2, tree, a2, add);
    let a1: MachineState<X86Memory(t.r.profile)> → Type = λ s => Exists<BitVec(64)>(λ word => (read_gpr(Rbx, s.gprs).toNat() + 8 <= Nat::pow(2, 47)) ∧
        ((read_word(t.site().data, s.memory, read_gpr(Rbx, s.gprs)) = Some(word)) ∧ a2(word_load_after(WordLoad(R11, Rbx), word, s))));
    let mv2 = t.goes_block(p, 0, [MovRI(Rbx, layout.room_at())], w_r1, tree, a1, ld);
    λ s here resident held => {
        let g = s.gprs;
        let m = s.memory;
        let rip_r = sym(t.at_rip(ro));
        let v = held.left.witness;
        let read = t.read_at(v, m, held.left.proof.left, ro, omega(slots));
        let word = word_in(v, ro);
        let counted: (word.toNat() = d) = held.left.proof.right.right.right.right;
        let word2 = word.add(BitVec::ofNat(1, n := 8).sign_extend(56));
        let up: (word2.toNat() = Succ(d)) = count_up(word, d, counted, small);
        let g3 = write_gpr(Rbx, layout.room_at(), g);
        let g4 = write_gpr(R11, word, g3);
        let g5 = write_gpr(R11, word2, g4);
        let bytes = word_bytes(word2);
        let m3 = t.r.profile.store(m, layout.room_at(), bytes);
        let more: Exists<Nat → BitVec(8)>(λ w => t.Based(env, Succ(d), w, m3)) = Exists(t.r.buffer(v).set_span(ro, bytes.to_vector()).cells,
            t.based_room_store(env, d, v, m, held.left.proof, Succ(d), word2, up));
        let r5: r(g5, m) = keep_g(g, g5, m, held.right, λ x not_rbx not_r11 =>
            trans(read_gpr_other(R11, x, word2, g4, not_r11), trans(read_gpr_other(R11, x, word, g3, not_r11), read_gpr_other(Rbx, x, layout.room_at(), g, not_rbx))));
        let resident3 = j(rip_r, λ a _ => t.site().Resident(t.r.profile.store(m, a, bytes)), t.store_resident(m, ro, bytes, omega(slots), resident));
        mv2(s, here, resident, Exists(word, ⟨j(rip_r, λ a _ => a.toNat() + 8 <= Nat::pow(2, 47), read.left),
            ⟨j(rip_r, λ a _ => read_word(t.site().data, m, a) = Some(word), read.right),
                ⟨refl, ⟨j(rip_r, λ a _ => t.writes().writable(m, a, 8), t.writable(m, ro, 8, omega(slots))),
                    ⟨resident3, ⟨more, keep_m(g5, m, word2, r5)⟩⟩⟩⟩⟩⟩))
    }
}

// RSP a frame down, and up.
theorem frame_above(low: BitVec(64), i, k: Nat): next_rip(low, i).add(BitVec::ofNat(k)) = next_rip(low, i + k) {
    trans(BitVec::add_nat_iterate(64, next_rip(low, i), k), rip_compose(low, i, k))
}

theorem frame_below(low: BitVec(64), i, k: Nat): next_rip(low, i + k).sub(BitVec::ofNat(k)) = next_rip(low, i) {
    trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(BitVec::ofNat(k)), sym(frame_above(low, i, k))),
        BitVec::add_sub_cancel(64, next_rip(low, i), BitVec::ofNat(k)))
}

// ---------------------------------------------------------------------------
// A frame opened

// Cells for a frame whose first `n` slots hold what the stack held: `v`'s
// below the frame's cells, the slots' words in theirs, numbered in a file
// that reads zero past them.
fn Target::Fresh(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), n: Nat) → Type {
    Exists<Nat → BitVec(8)>(λ w => Exists<List<Nat>>(λ ws =>
        ((p: Nat) → p < t.layout().frame_cell(0) → w(p) = v(p)) ∧
        (((i: Nat) → i < n → (read_word(t.io().data, m, t.slot(i)) = Some(word_in(w, t.layout().frame_cell(i)))) ∧
            (word_in(w, t.layout().frame_cell(i)).toNat() = ws.get_or(i, 0))) ∧
         ((i: Nat) → n <= i → ws.get_or(i, 0) = 0))))
}

// The stack reads a word at every offset (`Stack.readable`), so there are
// such cells, a slot at a time.
theorem Target::fresh(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), n: Nat): n <= t.words → t.Fresh(v, m, n) {
    match n {
        Zero => λ _ => Exists(v, Exists(Nil, ⟨λ p _ => refl, ⟨λ i never => false_elim(omega(never)), λ i _ => refl⟩⟩)),
        Succ(k) => λ fits => {
            let layout = t.layout();
            let before = t.fresh(v, m, k, omega(fits));
            let w0 = before.witness;
            let ws0 = before.proof.witness;
            let facts = before.proof.proof;
            let inside: (k < t.words) = omega(fits);
            let found = t.stack.readable(m, t.index + 8 * k, t.slot_inside(k, inside));
            let word = found.witness;
            let fc = layout.frame_cell(k);
            let w = t.r.buffer(w0).set_span(fc, word_bytes(word).to_vector()).cells;
            let ws = ws0.put(k, word.toNat(), 0);
            let stored: (word_in(w, fc) = word) = t.r.x86_word_stored(w0, fc, word);
            Exists(w, Exists(ws, ⟨
                λ p below => trans(t.r.cells_outside(w0, fc, word_bytes(word), p, Inl(omega(below, layout.frame_cell_at(0), layout.frame_cell_at(k)))),
                    facts.left(p, below)),
                ⟨λ i under => match i.eq_dec(k) {
                    Inl(here) => j(sym(here), λ x _ => (read_word(t.io().data, m, t.slot(x)) = Some(word_in(w, layout.frame_cell(x)))) ∧
                            (word_in(w, layout.frame_cell(x)).toNat() = ws.get_or(x, 0)),
                        ⟨trans(found.proof, cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x), sym(stored))),
                         trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), stored),
                            sym(ws.get_or_some(k, 0, word.toNat(), List::put_here(k, ws0, word.toNat(), 0))))⟩),
                    Inr(other) => {
                        let kept: (word_in(w, layout.frame_cell(i)) = word_in(w0, layout.frame_cell(i))) = word_in_agree(w, w0, layout.frame_cell(i), λ s short =>
                            t.r.cells_outside(w0, fc, word_bytes(word), layout.frame_cell(i) + s, layout.frame_cells_apart(k, i, s, other, short)));
                        let old = facts.right.left(i, omega(under, other));
                        ⟨trans(old.left, cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x), sym(kept))),
                         trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), kept), trans(old.right, sym(List::put_other(k, ws0, word.toNat(), 0, i, other))))⟩
                    },
                 },
                 λ i over => trans(List::put_other(k, ws0, word.toNat(), 0, i, λ e => false_elim(omega(e, over))), facts.right.right(i, omega(over)))⟩⟩))
        },
    }
}

// A frame opened: RSP the frame and its frames from its end up, whatever
// its slots hold. No word is live but ones past the slots, which have none
// and read zero.
theorem Target::held_fresh(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile),
    based: Exists<Nat → BitVec(8)>(λ v => t.Based(env, t.room, v, m)), frames: t.FramesAt(m, t.frames, t.index + 8 * t.words),
    rsp: read_gpr(Rsp, g) = t.frame(),
    beyond: (i: Nat) → Mem(i, live) → (t.words <= i) ∧ ((t.homes.home(i) = InSlot) ∧ (env.number(i) = 0))): t.Held(live, env, g, m) {
    let layout = t.layout();
    let v = based.witness;
    let fresh = t.fresh(v, m, t.words, t.words.le_refl());
    let w = fresh.witness;
    let ws = fresh.proof.witness;
    let facts = fresh.proof.proof;
    let based_w = t.based_agree(env, t.room, v, w, m, based.proof, λ p low => facts.left(p, omega(low, layout.frame_cell_at(0))));
    let placed: t.Placed(env.with_words(ws), m) = Exists(w, ⟨based_w.left, ⟨⟨λ i inside => facts.right.left(i, inside).right, based_w.right.left⟩,
        ⟨based_w.right.right.left, ⟨based_w.right.right.right.left, ⟨based_w.right.right.right.right,
        ⟨λ i inside => facts.right.left(i, inside).left, frames⟩⟩⟩⟩⟩⟩);
    Exists(ws, ⟨placed, ⟨λ i mem => {
        let b = beyond(i, mem);
        j(sym(b.right.left), λ h _ => (match h { InSlot => ws.get_or(i, 0), InReg(k) => home_values(g).get_or(k, BitVec::zero()).toNat() }) = env.number(i),
            trans(facts.right.right(i, b.left), sym(b.right.right)))
    }, rsp⟩⟩)
}

// ---------------------------------------------------------------------------
// Back in the caller's frame

// One file of cells below the canonical boundary and another from it up.
fn splice(low, high: Nat → BitVec(8)) → Nat → BitVec(8) { λ p => match Nat::pow(2, 47).leb(p) { True => high(p), False => low(p) } }

theorem splice_low(low, high: Nat → BitVec(8), p: Nat, below: p < Nat::pow(2, 47)): splice(low, high)(p) = low(p) {
    j(sym(Nat::pow(2, 47).leb_false(p, below)), λ b _ => (match b as λ _ => BitVec(8) { True => high(p), False => low(p) }) = low(p), refl)
}

theorem splice_high(low, high: Nat → BitVec(8), p: Nat, above: Nat::pow(2, 47) <= p): splice(low, high)(p) = high(p) {
    j(sym(Nat::pow(2, 47).leb_true(p, above)), λ b _ => (match b as λ _ => BitVec(8) { True => high(p), False => low(p) }) = high(p), refl)
}

// A claim the caller held, and after the call the region with the stack's
// words from its frame up as they were then: its frame's words are its
// own still, nothing below a frame's end reaching them. With the registers
// words live in as they were, it holds its words, over whatever buffers
// the region holds now.
theorem Target::bare_caller(self t: Target, live: List<Nat>, env: Env, g0: Gprs, m0: X86Memory(t.r.profile), held: t.Held(live, env, g0, m0),
    other: Env, g: Gprs, m: X86Memory(t.r.profile),
    bare: t.Bare(other, t.room, t.index, t.layout().cells_from(held.proof.left.witness, 0, t.words) ++ t.frames, g, m),
    kept: (k: Nat) → k < 6 → t.homes.uses(home_register(k)) = True → read_gpr(home_register(k), g) = read_gpr(home_register(k), g0)):
    t.Held(live, Env(env.words, other.buffers, env.args), g, m) {
    let layout = t.layout();
    let v0 = held.proof.left.witness;
    let ws = held.witness;
    let pp = held.proof.left.proof;
    let v1 = bare.left.witness;
    let w = splice(v1, v0);
    let cells = layout.cells_from(v0, 0, t.words);
    let zero: (t.index = t.index + 8 * 0) = omega();
    let fits: (0 + t.words = t.words) = omega();
    let own: t.FramesAt(m, cells, t.index + 8 * 0) = j(zero, λ k _ => t.FramesAt(m, cells, k), t.frames_take(m, cells, t.frames, t.index, bare.right.left));
    let len: (cells.len() = t.words) = layout.cells_from_len(v0, t.words, 0);
    let frames: t.FramesAt(m, t.frames, t.index + 8 * t.words) = j(len, λ n _ => t.FramesAt(m, t.frames, t.index + 8 * n),
        t.frames_drop(m, cells, t.frames, t.index, bare.right.left));
    let high = λ (i: Nat) => {
        let same: (word_in(w, layout.frame_cell(i)) = word_in(v0, layout.frame_cell(i))) = word_in_agree(w, v0, layout.frame_cell(i), λ k _ =>
            splice_high(v1, v0, layout.frame_cell(i) + k, omega(layout.frame_cell_at(i))));
        same
    };
    let based = t.based_agree(other, t.room, v1, w, m, bare.left.proof, λ p low => splice_low(v1, v0, p, low));
    let slots: t.Slots(w, m) = λ i inside => trans(t.slots_of_frames(v0, m, t.words, 0, own, i, omega(), omega(inside, fits)),
        cong_fn<BitVec(64), Option<BitVec(64)>>(λ x => Some(x), sym(high(i))));
    let placed: t.Placed(Env(env.words, other.buffers, env.args).with_words(ws), m) = Exists(w, ⟨based.left,
        ⟨⟨λ i inside => trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), high(i)), pp.right.left.left(i, inside)), based.right.left⟩,
        ⟨pp.right.right.left, ⟨based.right.right.right.left, ⟨based.right.right.right.right, ⟨slots, frames⟩⟩⟩⟩⟩⟩);
    Exists(ws, ⟨placed, ⟨t.agrees_regs(live, env, ws, g0, g, held.proof.right.left, kept), bare.right.right⟩⟩)
}

// ---------------------------------------------------------------------------
// The registers words live in, saved and put back

// What pushes of `registers` leave on the stack above `above`, the last
// pushed first.
fn Gprs::saved(self g: Gprs, registers: List<Gpr>, above: List<BitVec(64)>) → List<BitVec(64)> {
    match registers { Nil => above, Cons(register, rest) => g.saved(rest, Cons(read_gpr(register, g), above)) }
}

theorem Gprs::saved_len(self g: Gprs, registers: List<Gpr>): (above: List<BitVec(64)>) → g.saved(registers, above).len() = registers.len() + above.len() {
    match registers {
        Nil => λ above => { let same: (above.len() = 0 + above.len()) = omega(); same },
        Cons(register, rest) => λ above => {
            let ih: (g.saved(rest, Cons(read_gpr(register, g), above)).len() = rest.len() + Succ(above.len())) = g.saved_len(rest, Cons(read_gpr(register, g), above));
            let out: (g.saved(rest, Cons(read_gpr(register, g), above)).len() = Succ(rest.len()) + above.len()) = omega(ih);
            out
        },
    }
}

// Every register outside `registers` reads in `g2` as in `g`.
fn Gprs::Outside(self g2: Gprs, g: Gprs, registers: List<Gpr>) → Type {
    (x: Gpr) → x.absent_from(registers).IsTrue() → read_gpr(x, g2) = read_gpr(x, g)
}

theorem Gprs::holding_outside(self g: Gprs, g2: Gprs, others: List<Gpr>, same: g2.Outside(g, others), values: List<BitVec(64)>):
    (registers: List<Gpr>) → gprs_outside(registers, others).IsTrue() → g.Holding(registers, values) → g2.Holding(registers, values) {
    match values {
        Nil => λ _ _ _ => trivial,
        Cons(v, vs) => λ registers => match registers {
            Nil => λ _ _ => trivial,
            Cons(r, more) => λ outside holding => {
                ⟨trans(same(r, known), holding.left), g.holding_outside(g2, others, same, vs, more, known, holding.right)⟩
            },
        },
    }
}

// What a procedure keeps (`Homes::kept`): at most six registers, none of a
// list RBX and the kept pool are clear of.
theorem Homes::kept_few(self homes: Homes): homes.kept().len() <= 6 {
    let kept = kept_pool().filter(λ (register: Gpr) => homes.uses(register));
    let few: (kept.len() <= 5) = kept_pool().len_filter(λ (register: Gpr) => homes.uses(register));
    let all: (Succ(kept.len()) <= 6) = omega(few);
    all
}

theorem Homes::kept_outside(self homes: Homes, others: List<Gpr>, clear: gprs_outside(Cons(Rbx, kept_pool()), others).IsTrue()):
    gprs_outside(homes.kept(), others).IsTrue() {
    gprs_outside_of(homes.kept(), others, λ r mem => match mem {
        Inl(e) => j(sym(e), λ y _ => y.absent_from(others).IsTrue(), known),
        Inr(later) => gprs_outside_mem(kept_pool(), others, known, r,
            kept_pool().mem_filter(r, λ (register: Gpr) => homes.uses(register), later)),
    })
}

// Every register a word lives in reads after a call as before it: the
// callee kept RBX, and RBP and R12 to R15 where a word lives in them, and
// R10 was carried in RBX. `g` is the registers before the CALL, which
// moved RSP only, and `u` the registers the callee returned with.
theorem Homes::returned(self homes: Homes, g, u: Gprs, pushed: BitVec(64),
    kept: (x: Gpr) → Mem(x, homes.kept()) → read_gpr(x, u) = read_gpr(x, write_gpr(Rsp, pushed, g)),
    carried: read_gpr(Rbx, g) = read_gpr(R10, g)):
    (k: Nat) → k < 6 → homes.uses(home_register(k)) = True →
    read_gpr(home_register(k), write_gpr(R10, read_gpr(Rbx, u), u)) = read_gpr(home_register(k), g) {
    let v = read_gpr(Rbx, u);
    let f = λ (register: Gpr) => homes.uses(register);
    λ k => match k {
        Zero => λ _ used => trans(read_gpr_other(R10, R12, v, u, refl),
            trans(kept(R12, Inr(kept_pool().mem_filter_of(f, R12, used, Inl(refl)))), read_gpr_other(Rsp, R12, pushed, g, refl))),
        Succ(k1) => match k1 {
            Zero => λ _ used => trans(read_gpr_other(R10, R13, v, u, refl),
                trans(kept(R13, Inr(kept_pool().mem_filter_of(f, R13, used, Inr(Inl(refl))))), read_gpr_other(Rsp, R13, pushed, g, refl))),
            Succ(k2) => match k2 {
                Zero => λ _ used => trans(read_gpr_other(R10, R14, v, u, refl),
                    trans(kept(R14, Inr(kept_pool().mem_filter_of(f, R14, used, Inr(Inr(Inl(refl)))))), read_gpr_other(Rsp, R14, pushed, g, refl))),
                Succ(k3) => match k3 {
                    Zero => λ _ used => trans(read_gpr_other(R10, R15, v, u, refl),
                        trans(kept(R15, Inr(kept_pool().mem_filter_of(f, R15, used, Inr(Inr(Inr(Inl(refl))))))), read_gpr_other(Rsp, R15, pushed, g, refl))),
                    Succ(k4) => match k4 {
                        Zero => λ _ used => trans(read_gpr_other(R10, Rbp, v, u, refl),
                            trans(kept(Rbp, Inr(kept_pool().mem_filter_of(f, Rbp, used, Inr(Inr(Inr(Inr(Inl(refl)))))))), read_gpr_other(Rsp, Rbp, pushed, g, refl))),
                        Succ(k5) => match k5 {
                            Zero => λ _ _ => trans(read_gpr_after_write(R10, v, u), trans(kept(Rbx, Inl(refl)), trans(read_gpr_other(Rsp, Rbx, pushed, g, refl), carried))),
                            Succ(_) => λ no _ => false_elim(no),
                        },
                    },
                },
            },
        },
    }
}

theorem Prog::within_saves(registers: List<Gpr>): (p: Prog) → p.Within(p.saves(registers)) {
    match registers {
        Nil => λ p => p.within_self(),
        Cons(register, rest) => λ p => {
            let pushed = then(then(p, Block(rsp_down())), Spill(StackStore(register, BitVec::ofNat(0))));
            calc { p <= pushed := Exists(2, refl), <= pushed.saves(rest) := Prog::within_saves(rest, pushed), }
        },
    }
}

theorem Prog::within_restores(registers: List<Gpr>): (p: Prog) → p.Within(p.restores(registers)) {
    match registers {
        Nil => λ p => p.within_self(),
        Cons(register, rest) => λ p => calc { p <= p.restores(rest) := Prog::within_restores(rest, p), <= p.restores(Cons(register, rest)) := Exists(2, refl), },
    }
}

// RSP a word down by ADD of minus eight.
theorem rsp_lowered(low: BitVec(64), i: Nat): next_rip(low, i + 8).add(BitVec::ofNat(256 - 8, n := 8).sign_extend(56)) = next_rip(low, i) {
    let reading: (BitVec::ofNat(256 - 8, n := 8).sign_extend(56).toNat() = Nat::pow(2, 64) - 8) = refl;
    let count: ((i + 8) + (Nat::pow(2, 64) - 8) = i + Nat::pow(2, 64)) = { omega };
    trans(sym(BitVec::iter_add_eq_add(64, next_rip(low, i + 8), BitVec::ofNat(256 - 8, n := 8).sign_extend(56))),
    trans(rip_count(next_rip(low, i + 8), reading),
    trans(rip_compose(low, i + 8, Nat::pow(2, 64) - 8),
    trans(rip_count(low, count),
    trans(sym(rip_compose(low, i, Nat::pow(2, 64))), BitVec::iterate_increment_period(64, next_rip(low, i)))))))
}

// The registers pushed, from RSP at offset `i + 8 * registers.len()` of the
// stack with `above` from there up. Only RSP moves, so each is pushed as
// it was in `g0`, which the registers are but for RAX, R11 and RSP (the
// depth's count wrote the first two).
theorem Target::goes_saves(self t: Target, env: Env, room: Nat, tree: ITree<BitVec(64)>(Events::linux()), g0: Gprs, registers: List<Gpr>):
    (p: Prog) → (i: Nat) → (above: List<BitVec(64)>) → gprs_outside(registers, [Rax, R11, Rsp]).IsTrue() → i + 8 * registers.len() <= t.stack.size →
    p.saves(registers).Within(t.program) →
    t.Goes(prog_len(p.saves(registers)), tree, λ s =>
        t.Bare(env, room, i, g0.saved(registers, above), s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp])) →
    t.Goes(prog_len(p), tree, λ s =>
        t.Bare(env, room, i + 8 * registers.len(), above, s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp])) {
    match registers {
        Nil => λ p i above _ _ _ next => {
            let same: (i + 8 * 0 = i) = omega();
            j(sym(same), λ k _ => t.Goes(prog_len(p), tree, λ s =>
                t.Bare(env, room, k, above, s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp])), next)
        },
        Cons(r, rest) => λ p i above outside top within next => {
            let spill = StackStore(r, BitVec::ofNat(0));
            let down = then(p, Block(rsp_down()));
            let pushed = then(down, Spill(spill));
            let w_pushed = Prog::within_trans(Prog::within_saves(rest, pushed), within);
            let w_down = down.within_before(0, Spill(spill), t.program, w_pushed);
            let j2 = i + 8 * rest.len();
            let back: (i + 8 * Succ(rest.len()) = j2 + 8) = omega();
            let fits: (j2 + 8 <= t.stack.size) = omega(top);
            let top2: (i + 8 * rest.len() <= t.stack.size) = omega(top);
            let word = read_gpr(r, g0);
            let post = λ (s: MachineState<X86Memory(t.r.profile)>) => t.Bare(env, room, j2, Cons(word, above), s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp]);
            let later = t.goes_saves(env, room, tree, g0, rest, pushed, i, Cons(word, above), known, top2, within, next);
            let spilled = t.goes_spill(down, 0, spill, w_pushed, tree, post, later);
            let at_spill: MachineState<X86Memory(t.r.profile)> → Type = λ u => Exists<Nat>(λ k => (stack_address(u.gprs, spill.offset) = t.stack.at(k)) ∧
                ((k + 8 <= t.stack.size) ∧ post(spill.after(t.writes(), u))));
            let moved = t.goes_block(p, 0, rsp_down(), w_down, tree, at_spill, spilled);
            t.goes_weaken(moved, λ s pre => {
                    let g = s.gprs;
                    let m = s.memory;
                    let low = read_gpr(Rsp, g).add(BitVec::ofNat(256 - 8, n := 8).sign_extend(56));
                    let g2 = write_gpr(Rsp, low, g);
                    let bare: t.Bare(env, room, j2 + 8, above, g, m) = j(back, λ k _ => t.Bare(env, room, k, above, g, m), pre.left);
                    let rsp: (read_gpr(Rsp, g2) = t.stack.at(j2)) =
                        trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(256 - 8, n := 8).sign_extend(56)), bare.right.right),
                            rsp_lowered(t.stack.low, j2));
                    let zero: (j2 + 0 = j2) = omega();
                    let address: (stack_address(g2, BitVec::ofNat(0)) = t.stack.at(j2)) =
                        trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(0, n := 8).sign_extend(56)), rsp),
                            trans(displaced_at(t.stack.low, j2, BitVec::ofNat(0), refl), rip_count(t.stack.low, zero)));
                    let not_rsp = λ (x: Gpr) (absent: x.absent_from([Rax, R11, Rsp]).IsTrue()) =>
                        x.absent_head(Rsp, Nil, x.absent_rest(R11, [Rsp], x.absent_rest(Rax, [R11, Rsp], absent)));
                    let value: (read_gpr(r, g2) = word) = trans(read_gpr_other(Rsp, r, low, g, not_rsp(r, known)), pre.right(r, known));
                    let outside2: g2.Outside(g0, [Rax, R11, Rsp]) = λ x absent => trans(read_gpr_other(Rsp, x, low, g, not_rsp(x, absent)), pre.right(x, absent));
                    let done = λ (a: BitVec(64)) (x: BitVec(64)) => t.Bare(env, room, j2, Cons(word, above), g2, t.r.profile.store(m, a, word_bytes(x))) ∧
                        g2.Outside(g0, [Rax, R11, Rsp]);
                    let at_done: done(t.stack.at(j2), word) = ⟨t.bare_pushed(env, room, j2, above, g, m, bare, fits, word, g2, rsp), outside2⟩;
                    Exists(j2, ⟨address, ⟨fits, j(sym(value), λ x _ => done(stack_address(g2, BitVec::ofNat(0)), x),
                        j(sym(address), λ a _ => done(a, word), at_done))⟩⟩)
                })
        },
    }
}

// The registers popped, the last pushed first, from RSP at offset `i` with
// them on the stack: each reads as it did in `g0`. `q` is what holds of the
// registers through the pops.
theorem Target::goes_restores(self t: Target, env: Env, room: Nat, tree: ITree<BitVec(64)>(Events::linux()), g0: Gprs, q: Gprs → Type, registers: List<Gpr>):
    (p: Prog) → (i: Nat) → (above: List<BitVec(64)>) → gprs_outside(registers, [Rsp]).IsTrue() →
    ((g: Gprs) → (x: Gpr) → Mem(x, registers) → (w, v: BitVec(64)) → q(g) → q(write_gpr(Rsp, v, write_gpr(x, w, g)))) →
    p.restores(registers).Within(t.program) →
    t.Goes(prog_len(p.restores(registers)), tree, λ s =>
        t.Bare(env, room, i + 8 * registers.len(), above, s.gprs, s.memory) ∧
        (((x: Gpr) → Mem(x, registers) → read_gpr(x, s.gprs) = read_gpr(x, g0)) ∧ q(s.gprs))) →
    t.Goes(prog_len(p), tree, λ s =>
        t.Bare(env, room, i, g0.saved(registers, above), s.gprs, s.memory) ∧ q(s.gprs)) {
    match registers {
        Nil => λ p i above _ _ _ next => {
            let same: (i + 8 * 0 = i) = omega();
            t.goes_weaken(next,
                λ s pre => ⟨j(sym(same), λ k _ => t.Bare(env, room, k, above, s.gprs, s.memory), pre.left), ⟨λ x never => false_elim(never), pre.right⟩⟩)
        },
        Cons(r, rest) => λ p i above outside keep within next => {
            let load = StackLoad(r, BitVec::ofNat(0));
            let before = p.restores(rest);
            let loaded = then(before, Reload(load));
            let w_loaded = loaded.within_before(0, Block([rsp_up()]), t.program, within);
            let w_before = before.within_before(0, Reload(load), t.program, w_loaded);
            let not_rsp: (Rsp.same(r) = False) = r.absent_head(Rsp, Nil, known);
            let word = read_gpr(r, g0);
            let j1 = i + 8 * rest.len();
            let shift: (j1 + 8 = i + 8 * Succ(rest.len())) = omega();
            let final = λ (s: MachineState<X86Memory(t.r.profile)>) => t.Bare(env, room, i + 8 * Succ(rest.len()), above, s.gprs, s.memory) ∧
                (((x: Gpr) → Mem(x, Cons(r, rest)) → read_gpr(x, s.gprs) = read_gpr(x, g0)) ∧ q(s.gprs));
            let up = t.goes_block(loaded, 0, [rsp_up()], within, tree, final, next);
            let post = λ (u: MachineState<X86Memory(t.r.profile)>) => final(execute_block_normal([rsp_up()], u));
            let reloaded = t.goes_reload(before, 0, load, w_loaded, tree, post, up);
            let popped: t.Goes(prog_len(before), tree, λ s => t.Bare(env, room, j1, Cons(word, above), s.gprs, s.memory) ∧
                    (((x: Gpr) → Mem(x, rest) → read_gpr(x, s.gprs) = read_gpr(x, g0)) ∧ q(s.gprs))) = t.goes_weaken(reloaded, λ s pre => {
                    let g = s.gprs;
                    let m = s.memory;
                    let bare = pre.left;
                    let frames = bare.right.left;
                    let at_j: (read_gpr(Rsp, g) = t.stack.at(j1)) = bare.right.right;
                    let zero: (j1 + 0 = j1) = omega();
                    let address: (stack_address(g, BitVec::ofNat(0)) = t.stack.at(j1)) =
                        trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(0, n := 8).sign_extend(56)), at_j),
                            trans(displaced_at(t.stack.low, j1, BitVec::ofNat(0), refl), rip_count(t.stack.low, zero)));
                    let g1 = write_gpr(r, word, g);
                    let value = read_gpr(Rsp, g1).add(BitVec::ofNat(8, n := 8).sign_extend(56));
                    let g2 = write_gpr(Rsp, value, g1);
                    let eight: (j1 + BitVec::ofNat(8, n := 8).toNat() = j1 + 8) = refl;
                    let rsp1: (read_gpr(Rsp, g1) = t.stack.at(j1)) = trans(read_gpr_other(r, Rsp, word, g, trans(r.same_comm(Rsp), not_rsp)), at_j);
                    let rsp2: (value = t.stack.at(i + 8 * Succ(rest.len()))) =
                        trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(8, n := 8).sign_extend(56)), rsp1),
                            trans(displaced_at(t.stack.low, j1, BitVec::ofNat(8), refl), trans(rip_count(t.stack.low, eight), rip_count(t.stack.low, shift))));
                    let bare2: t.Bare(env, room, i + 8 * Succ(rest.len()), above, g2, m) = ⟨bare.left,
                        ⟨j(shift, λ k _ => t.FramesAt(m, above, k), frames.right.right), trans(read_gpr_after_write(Rsp, value, g1), rsp2)⟩⟩;
                    let mine: (read_gpr(r, g2) = word) = trans(read_gpr_other(Rsp, r, value, g1, not_rsp), read_gpr_after_write(r, word, g));
                    let reads: ((x: Gpr) → Mem(x, Cons(r, rest)) → read_gpr(x, g2) = read_gpr(x, g0)) = λ x mem => match mem {
                        Inl(e) => j(sym(e), λ y _ => read_gpr(y, g2) = read_gpr(y, g0), mine),
                        Inr(later) => match same: r.same(x) {
                            True => j(r.same_sound(x, same), λ y _ => read_gpr(y, g2) = read_gpr(y, g0), mine),
                            False => trans(read_gpr_other(Rsp, x, value, g1, x.absent_head(Rsp, Nil, gprs_outside_mem(rest, [Rsp], known, x, later))),
                                trans(read_gpr_other(r, x, word, g, same), pre.right.left(x, later))),
                        },
                    };
                    Exists(j1, ⟨address, ⟨frames.left, Exists(word, ⟨frames.right.left,
                        ⟨bare2, ⟨reads, keep(g, r, Inl(refl), word, value, pre.right.right)⟩⟩⟩)⟩⟩)
                });
            t.goes_restores(env, room, tree, g0, q, rest, p, i, Cons(word, above), known, λ g x mem w v h => keep(g, x, Inr(mem), w, v, h), w_before, popped)
        },
    }
}

// ---------------------------------------------------------------------------
// The callee's way in and out

// Past the count in procedure `index`'s entry, in the callee's activation:
// RSP is past its frame and the registers it is to save, at the return
// address on top of `above`, and but for RAX, R11 and RSP the registers
// are `g0`'s, the call registers holding `values`. The registers it keeps
// pushed and the frame opened, its parameters are set to the values where
// its body needs them.
theorem Target::goes_callee_entry(self t: Target, env: Env, pre: Prog, proc: Procedure, index: Nat, values: List<BitVec(64)>,
    g0: Gprs, above: List<BitVec(64)>, top: t.frames = g0.saved(t.homes.kept(), above), passed: g0.Holding(call_registers(), values),
    tree: ITree<BitVec(64)>(Events::linux()), within: proc.entry_code(pre, t.layout(), index).Within(t.program),
    inside: (i: Nat) → Mem(i, proc.params) → i < t.words, apart: t.homes.moves_apart(proc.body.live_in(t.homes, proc.results), proc.params).IsTrue(),
    covered: proc.body.live_in(t.homes, proc.results).within(proc.params).IsTrue(),
    short: proc.params.len() <= 6, long: proc.params.len() <= values.len(),
    next: t.At(prog_len(proc.entry_code(pre, t.layout(), index)), proc.body.live_in(t.homes, proc.results), tree, env.set_words(proc.params, values))):
    t.Goes(prog_len(pre.label(t.layout().procedure_label(index)).count_down(t.layout())), tree, λ s =>
        t.Bare(env, t.room, (t.index + 8 * t.words) + 8 * t.homes.kept().len(), above, s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp])) {
    let layout = t.layout();
    let regs = call_registers();
    let kept = t.homes.kept();
    let entry = proc.body.live_in(t.homes, proc.results);
    let lab = pre.label(layout.procedure_label(index)).count_down(layout);
    let sv = lab.saves(kept);
    let fd = then(sv, Block(frame_down(t.words)));
    let w_fd = Prog::within_trans(Prog::within_words_from(layout, entry, proc.params, regs, fd), within);
    let w_sv = sv.within_before(0, Block(frame_down(t.words)), t.program, w_fd);
    let q = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(entry, env.set_words(proc.params, values), g, m);
    let six: (regs.len() = 6) = refl;
    let none: ((i: Nat) → Mem(i, entry.minus(proc.params)) → Mem(i, Nil<Nat>)) = λ i m => {
        let kept_i: (absent(i, proc.params) = True) = entry.mem_filter_holds(i, λ (x: Nat) => absent(x, proc.params), m);
        let wider = entry.within_mem(proc.params, covered, i, entry.mem_filter(i, λ (x: Nat) => absent(x, proc.params), m));
        false_elim(absent_mem(i, proc.params, Bool::is_true_of_eq(kept_i), i, wider)(refl))
    };
    let wf = t.goes_words_from(entry, tree, q, proc.params, regs, values, fd, Nil, env, none, inside, apart, trivial, trivial,
        omega(short, six), long, within, next);
    let p_wf = λ (s: MachineState<X86Memory(t.r.profile)>) => t.Held(Nil, env, s.gprs, s.memory) ∧ (s.gprs.Holding(regs, values) ∧
        ((g2: Gprs) → (m2: X86Memory(t.r.profile)) → t.Held(entry, env.set_words(proc.params, values), g2, m2) → t.Spares(s.gprs, g2) → q(g2, m2)));
    let opened = t.goes_block(sv, 0, frame_down(t.words), w_fd, tree, p_wf, wf);
    let lens: (t.frames.len() = kept.len() + above.len()) = trans(cong_fn<List<BitVec(64)>, Nat>(λ fs => fs.len(), top), g0.saved_len(kept, above));
    let fits: ((t.index + 8 * t.words) + 8 * kept.len() <= t.stack.size) = omega(lens, t.framed);
    let at_frame = λ (fs: List<BitVec(64)>) => t.Goes(prog_len(sv), tree, λ s =>
        t.Bare(env, t.room, t.index + 8 * t.words, fs, s.gprs, s.memory) ∧ s.gprs.Outside(g0, [Rax, R11, Rsp]));
    let framed: at_frame(t.frames) = t.goes_weaken(opened, λ s held => {
            let g = s.gprs;
            let size: BitVec(64) = BitVec::ofNat(8 * t.words);
            let low = read_gpr(Rsp, g).sub(size);
            let g1 = write_gpr(Rbx, size, g);
            let g2 = write_gpr(Rsp, low, g1);
            let rsp: (read_gpr(Rsp, g2) = t.frame()) = trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(size), held.left.right.right),
                frame_below(t.stack.low, t.index, 8 * t.words));
            ⟨t.held_fresh(Nil, env, g2, s.memory, held.left.left, held.left.right.left, rsp, λ i never => false_elim(never)),
                ⟨g1.holding_write(Rsp, low, values, regs, trivial, g.holding_write(Rbx, size, values, regs, trivial,
                    g0.holding_outside(g, [Rax, R11, Rsp], held.right, values, regs, trivial, passed))), λ g3 m3 h _ => h⟩⟩
        });
    t.goes_saves(env, t.room, tree, g0, kept, lab, t.index + 8 * t.words, above, t.homes.kept_outside([Rax, R11, Rsp], trivial), fits, w_sv,
        j(top, λ fs _ => at_frame(fs), framed))
}

// Past the body, its results live: into the result registers, the depth
// counted back, the frame closed, the registers popped, and RET to the
// address on top of what was above them: the region with the caller's
// room, the stack's words from past the return address up, every register
// the procedure keeps as it was in `g0`, and the results in the result
// registers.
theorem Target::goes_callee_return(self t: Target, after: Env, b: Prog, results: List<Nat>, tree: ITree<BitVec(64)>(Events::linux()),
    within: then(then(b.words_to(t.layout(), results, result_registers()).count_up(t.layout()), Block(frame_up(t.words))).restores(t.homes.kept()), Ret).Within(t.program),
    inside: (i: Nat) → Mem(i, results) → i < t.words, g0: Gprs, ret: BitVec(64), rest: List<BitVec(64)>,
    top: t.frames = g0.saved(t.homes.kept(), Cons(ret, rest)), small: Succ(t.room) < Nat::pow(2, 64),
    back: (s: MachineState<X86Memory(t.r.profile)>) → s.rip = ret → t.site().Resident(s.memory) →
        t.Bare(after, Succ(t.room), ((t.index + 8 * t.words) + 8 * t.homes.kept().len()) + 8, rest, s.gprs, s.memory) →
        ((x: Gpr) → Mem(x, t.homes.kept()) → read_gpr(x, s.gprs) = read_gpr(x, g0)) →
        s.gprs.Holding(result_registers(), after.words_at(results)) → SimPaid(t.io(), tree, s)):
    t.At(prog_len(b), results, tree, after) {
    let layout = t.layout();
    let regs = result_registers();
    let kept = t.homes.kept();
    let aw = after.words_at(results);
    let so = layout.stack_offset();
    let slots: (so + 16 <= t.r.size) = t.fits;
    let p1 = b.words_to(layout, results, regs);
    let cu = p1.count_up(layout);
    let fu = then(cu, Block(frame_up(t.words)));
    let rs = fu.restores(kept);
    let w_rs = rs.within_before(0, Ret, t.program, within);
    let w_fu = Prog::within_trans(Prog::within_restores(kept, fu), w_rs);
    let w_cu = cu.within_before(0, Block(frame_up(t.words)), t.program, w_fu);
    let w_p1 = calc { p1 <= cu := Exists(4, refl), <= t.program := w_cu, };
    let i0 = t.index + 8 * t.words;
    let i1 = i0 + 8 * kept.len();
    let clear = t.homes.kept_outside([Rsp], trivial);
    let p_ret = λ (s: MachineState<X86Memory(t.r.profile)>) => t.Bare(after, Succ(t.room), i1, Cons(ret, rest), s.gprs, s.memory) ∧
        (((x: Gpr) → Mem(x, kept) → read_gpr(x, s.gprs) = read_gpr(x, g0)) ∧ s.gprs.Holding(regs, aw));
    let returned = t.io().goes_ret(t.program, t.origin, t.stack, t.stack_writes, t.code_fits(), within.witness, rs, 0, within.proof, tree, p_ret,
        λ _ => i1, λ _ => ret,
        λ s held => ⟨held.left.right.right, ⟨held.left.right.left.left, held.left.right.left.right.left⟩⟩,
        λ s held resident => {
            let g = s.gprs;
            let value = read_gpr(Rsp, g).add(BitVec::ofNat(8));
            let rsp: (value = t.stack.at(i1 + 8)) = trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(BitVec::ofNat(8)), held.left.right.right),
                pop_at(t.stack.low, i1));
            let bare: t.Bare(after, Succ(t.room), i1 + 8, rest, write_gpr(Rsp, value, g), s.memory) = ⟨held.left.left,
                ⟨held.left.right.left.right.right, trans(read_gpr_after_write(Rsp, value, g), rsp)⟩⟩;
            back(return_near_after(ret, s), refl, resident, bare,
                λ x mem => trans(read_gpr_other(Rsp, x, value, g, x.absent_head(Rsp, Nil, gprs_outside_mem(kept, [Rsp], clear, x, mem))), held.right.left(x, mem)),
                g.holding_write(Rsp, value, aw, regs, trivial, held.right.right))
        });
    let apart = t.homes.kept_outside(regs, trivial);
    let restored = t.goes_restores(after, Succ(t.room), tree, g0, λ (g: Gprs) => g.Holding(regs, aw), kept, fu, i0, Cons(ret, rest), clear,
        λ g x mem w v h => write_gpr(x, w, g).holding_write(Rsp, v, aw, regs, trivial,
            g.holding_write(x, w, aw, regs, gprs_outside_mem(kept, regs, apart, x, mem), h)),
        w_rs, returned);
    let closing = λ (fs: List<BitVec(64)>) (s: MachineState<X86Memory(t.r.profile)>) => t.Bare(after, Succ(t.room), i0, fs, s.gprs, s.memory) ∧ s.gprs.Holding(regs, aw);
    let closed = t.goes_block(cu, 0, frame_up(t.words), w_fu, tree, λ s => closing(t.frames, s),
        j(sym(top), λ fs _ => t.Goes(prog_len(fu), tree, λ s => closing(fs, s)), restored));
    // The count: the frames and RSP stay, and the results in their
    // registers.
    let r = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.FramesAt(m, t.frames, i0) ∧ ((read_gpr(Rsp, g) = t.frame()) ∧ g.Holding(regs, aw));
    let based: Nat → X86Memory(t.r.profile) → Type = λ n m => Exists<Nat → BitVec(8)>(λ v => t.Based(after, n, v, m));
    let closing_from: t.Goes(prog_len(cu), tree, λ s => based(Succ(t.room), s.memory) ∧ r(s.gprs, s.memory)) = t.goes_weaken(closed, λ s held => {
            let g = s.gprs;
            let size: BitVec(64) = BitVec::ofNat(8 * t.words);
            let high = read_gpr(Rsp, g).add(size);
            let g1 = write_gpr(Rbx, size, g);
            let g2 = write_gpr(Rsp, high, g1);
            let rsp: (read_gpr(Rsp, g2) = t.stack.at(i0)) = trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.add(size), held.right.right.left),
                frame_above(t.stack.low, t.index, 8 * t.words));
            ⟨⟨held.left, ⟨held.right.left, rsp⟩⟩,
                g1.holding_write(Rsp, high, aw, regs, trivial, g.holding_write(Rbx, size, aw, regs, trivial, held.right.right.right))⟩
        });
    let counted = t.goes_count_up(after, t.room, small, p1, r,
        λ g g2 m h same => ⟨h.left, ⟨trans(same(Rsp, refl, refl), h.right.left),
            g.holding_outside(g2, [Rbx, R11], λ x absent => same(x, x.absent_head(Rbx, [R11], absent), x.absent_head(R11, Nil, x.absent_rest(Rbx, [R11], absent))),
                aw, regs, trivial, h.right.right)⟩⟩,
        λ g m word h => {
            let eight: (word_bytes(word).len() = 8) = refl;
            let fits: ((so + 8) + word_bytes(word).len() <= t.r.size) = omega(slots, eight);
            ⟨j(sym(t.at_rip(so + 8)), λ a _ => t.FramesAt(t.r.profile.store(m, a, word_bytes(word)), t.frames, i0),
                t.frames_store(m, so + 8, word_bytes(word), fits, t.frames, i0, h.left)), h.right⟩
        },
        w_cu, tree, closing_from);
    let q: Gprs → X86Memory(t.r.profile) → Type = λ g m => t.Held(results, after, g, m) ∧ g.Holding(regs, aw);
    let leaving: t.Goes(prog_len(p1), tree, λ s => q(s.gprs, s.memory)) = t.goes_weaken(counted, λ s held =>
            ⟨Exists(held.left.proof.left.witness, t.held_based(results, after, s.gprs, s.memory, held.left)),
                ⟨t.held_frames(results, after, s.gprs, s.memory, held.left), ⟨t.held_rsp(results, after, s.gprs, s.memory, held.left), held.right⟩⟩⟩);
    let words = t.goes_words_to(results, after, tree, q, results, regs, b, λ i m => ⟨inside(i, m), m⟩, trivial, trivial, w_p1, leaving);
    t.goes_weaken(words,
        λ s held => ⟨held, λ g2 held2 passed _ => ⟨held2, passed⟩⟩)
}

// ---------------------------------------------------------------------------
// The contract of a callee

// The homes a call passes a callee lent `count` buffers: each where the
// layout puts it, as long as its capacity.
fn Target::passed_homes(self t: Target, count: Nat) → List<BitVec(64)> {
    placed_homes(λ (b: Nat) => t.layout().buffer_at(b), λ (b: Nat) => t.layout().capacity(b), 0, count)
}

// What a callee's answer is to the machine: it returned, `results` in the
// result registers and the file's buffers `buffers`, or the process exited
// with `status`.
inductive Answer { Returned(results: List<BitVec(64)>, buffers: Buffers()), Gone(status: BitVec(64)) }

// Where an answer leaves the machine, as what the caller's tree from there
// needs. Returned: at the return address with the code resident, the region
// holding the buffers under the caller's room, the stack's words from the
// caller's frame up (`above`), every register a callee keeps as it was in
// `g0`, and the results in their registers. Gone: at the exit.
fn Target::Ends(self t: Target, answer: Answer, env: Env, g0: Gprs, ret: BitVec(64), above: List<BitVec(64)>,
    tree: ITree<BitVec(64)>(Events::linux())) → Type {
    match answer {
        Returned(results, buffers) => (u: MachineState<X86Memory(t.r.profile)>) → u.rip = ret → t.site().Resident(u.memory) →
            t.Bare(Env(env.words, buffers, env.args), t.room, t.index, above, u.gprs, u.memory) →
            ((x: Gpr) → Mem(x, t.homes.kept()) → read_gpr(x, u.gprs) = read_gpr(x, g0)) →
            u.gprs.Holding(result_registers(), results) → SimPaid(t.io(), tree, u),
        Gone(status) => (u: MachineState<X86Memory(t.r.profile)>) → LinuxSyscallAt(t.io(), u) → LinuxExits(u, status) → SimPaid(t.io(), tree, u),
    }
}

// The one contract of a callee (docs/native/native-procedures-are-functions-design.md
// §2.4). Label `label` is a callee's: entered as the one call sequence
// enters it (`Prog::calls`), the homes of the `lent` buffers it is lent and
// then words it accepts in the call registers, the return address on the
// stack below the caller's frame, it runs as its tree. The tree's answers
// are the callee's own (`A`), each read as what the machine holds at its end
// (`answer`): whatever tree the caller goes on with from an answer, the
// code runs as the callee's tree and then that one, given only that each
// end leaves the machine where its tree needs it (`Target::Ends`).
//
// `t` is the caller's activation: the region's count is its room when the
// callee is entered and when it returns, and nothing at or above its frame
// is stored to.
fn Target::Callable<A>(self t: Target, label, lent: Nat, accepts: List<BitVec(64)> → Env → Type,
    tree: List<BitVec(64)> → Env → ITree<A>(Events::linux()), answer: List<BitVec(64)> → Env → A → Answer) → Type {
    (env: Env) → (words: List<BitVec(64)>) → accepts(words, env) → (g0: Gprs) → g0.Holding(call_registers(), t.passed_homes(lent) ++ words) →
    (ret: BitVec(64)) → (above: List<BitVec(64)>) → t.index + 8 * above.len() <= t.stack.size →
    (k: A → ITree<BitVec(64)>(Events::linux())) → ((x: A) → t.Ends(answer(words, env, x), env, g0, ret, above, k(x))) →
    t.Goes(asm_labels(t.program, label), ITree::bind(Events::linux(), tree(words, env), k), λ s =>
        t.Bare(env, t.room, t.index - 8, Cons(ret, above), s.gprs, s.memory) ∧ (s.gprs = g0))
}

// What a call site needs past its call for an answer: returned, the code
// after the call from the claim between statements over the buffers the
// callee left, the results in their registers; gone, the exit.
fn Target::Taken(self t: Target, live: List<Nat>, env: Env, at: Nat, answer: Answer, tree: ITree<BitVec(64)>(Events::linux())) → Type {
    match answer {
        Returned(results, buffers) => t.GoesR(at, tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) =>
            t.Held(live, Env(env.words, buffers, env.args), g, m) ∧ g.Holding(result_registers(), results)),
        Gone(status) => (u: MachineState<X86Memory(t.r.profile)>) → LinuxSyscallAt(t.io(), u) → LinuxExits(u, status) → SimPaid(t.io(), tree, u),
    }
}

// An answer taken up at its call site: what the callee's end gives is what
// the code after the CALL needs. Returned, the caller's frame is above the
// callee's and nothing stored there, so its words are what they were
// (`Target::bare_caller`), and so are the registers they live in: the
// callee kept those it keeps, and R10 comes back from RBX
// (`Homes::returned`). `s` is the machine as the CALL found it.
theorem Target::ends_taken(self t: Target, live: List<Nat>, env: Env, called: Prog, s: MachineState<X86Memory(t.r.profile)>,
    held: t.Held(live, env, s.gprs, s.memory), carried: read_gpr(Rbx, s.gprs) = read_gpr(R10, s.gprs),
    within: then(called, Block([MovRR(R10, Rbx)])).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()), answer: Answer):
    t.Taken(live, env, prog_len(then(called, Block([MovRR(R10, Rbx)]))), answer, tree) →
    t.Ends(answer, env, write_gpr(Rsp, push_address(s.gprs), s.gprs), next_rip(t.origin, prog_len(called)),
        t.layout().cells_from(held.proof.left.witness, 0, t.words) ++ t.frames, tree) {
    let rets = result_registers();
    let rest = t.layout().cells_from(held.proof.left.witness, 0, t.words) ++ t.frames;
    match answer {
        Returned(results, buffers) => λ taken u rip resident bare kept holding => {
            let other = Env(env.words, buffers, env.args);
            let back = read_gpr(Rbx, u.gprs);
            let g2 = write_gpr(R10, back, u.gprs);
            let bare_g: t.Bare(other, t.room, t.index, rest, g2, u.memory) = ⟨bare.left, ⟨bare.right.left,
                trans(read_gpr_other(R10, Rsp, back, u.gprs, refl), bare.right.right)⟩⟩;
            let held_t = t.bare_caller(live, env, s.gprs, s.memory, held, other, g2, u.memory, bare_g,
                t.homes.returned(s.gprs, u.gprs, push_address(s.gprs), kept, carried));
            let restored = t.goes_block(called, 0, [MovRR(R10, Rbx)], within, tree,
                λ v => t.Held(live, other, v.gprs, v.memory) ∧ v.gprs.Holding(rets, results), taken);
            restored(u, rip, resident, ⟨held_t, u.gprs.holding_write(R10, back, results, rets, trivial, holding)⟩)
        },
        Gone(status) => λ taken => taken,
    }
}

// The region's claim under another environment's words: it reads the
// buffers and the command line only.
theorem Target::bare_file(self t: Target, env, other: Env, room, i: Nat, above: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile),
    bare: t.Bare(other, room, i, above, g, m), args: env.args = t.args): t.Bare(Env(env.words, other.buffers, env.args), room, i, above, g, m) {
    let based = bare.left.proof;
    ⟨Exists(bare.left.witness, ⟨based.left, ⟨based.right.left, ⟨args, based.right.right.right⟩⟩⟩), bare.right⟩
}

// ---------------------------------------------------------------------------
// The start

// `xs` onto `acc`, the last first.
fn List::onto<A>(self xs: List<A>, acc: List<A>) → List<A> { match xs { Nil => acc, Cons(h, rest) => rest.onto(Cons(h, acc)) } }

theorem List::mem_onto_acc<A>(self xs: List<A>, a: A): (acc: List<A>) → Mem(a, acc) → Mem(a, xs.onto(acc)) {
    match xs { Nil => λ acc m => m, Cons(h, rest) => λ acc m => rest.mem_onto_acc(a, Cons(h, acc), Inr(m)) }
}

theorem List::mem_onto<A>(self xs: List<A>, a: A): (acc: List<A>) → Mem(a, xs) → Mem(a, xs.onto(acc)) {
    match xs {
        Nil => λ acc never => false_elim(never),
        Cons(h, rest) => λ acc m => match m { Inl(e) => rest.mem_onto_acc(a, Cons(h, acc), Inl(e)), Inr(later) => rest.mem_onto(a, Cons(h, acc), later) },
    }
}

theorem Prog::within_zeroes(layout: Layout, ids: List<Nat>): (p: Prog) → p.Within(p.zeroes(layout, ids)) {
    match ids {
        Nil => λ p => p.within_self(),
        Cons(id, rest) => λ p => (match layout.word_fits(id) as λ b => p.Within((match b { False => p, True => p.word_store(layout, id, Rax) }).zeroes(layout, rest)) {
            False => Prog::within_zeroes(layout, rest, p),
            True => calc { p <= p.word_store(layout, id, Rax) := Exists(2, refl), <= p.word_store(layout, id, Rax).zeroes(layout, rest) := Prog::within_zeroes(layout, rest, p.word_store(layout, id, Rax)), },
        }),
    }
}

// Words that read zero, each in a slot, stored zero from RAX
// (`Prog::zeroes`): each joins the live words. One past the slots has no
// slot, nothing is stored, and it is live already (`Target::held_fresh`).
theorem Target::goes_zeroes(self t: Target, env: Env, tree: ITree<BitVec(64)>(Events::linux()), ids: List<Nat>):
    (p: Prog) → (live: List<Nat>) → ((i: Nat) → Mem(i, ids) → (t.homes.home(i) = InSlot) ∧ (env.number(i) = 0)) →
    ((i: Nat) → Mem(i, ids) → t.layout().word_fits(i) = False → Mem(i, live)) →
    p.zeroes(t.layout(), ids).Within(t.program) →
    t.GoesR(prog_len(p.zeroes(t.layout(), ids)), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(ids.onto(live), env, g, m)) →
    t.GoesR(prog_len(p), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m) ∧ (read_gpr(Rax, g) = BitVec::ofNat(0))) {
    let layout = t.layout();
    match ids {
        Nil => λ p live _ _ _ next => t.goes_weaken(next, λ s h => h.left),
        Cons(id, rest) => λ p live ok beyond => (match fit: layout.word_fits(id) as λ b =>
                (match b { False => p, True => p.word_store(layout, id, Rax) }).zeroes(layout, rest).Within(t.program) →
                t.GoesR(prog_len((match b { False => p, True => p.word_store(layout, id, Rax) }).zeroes(layout, rest)), tree,
                    λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(rest.onto(Cons(id, live)), env, g, m)) →
                t.GoesR(prog_len(p), tree, λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(live, env, g, m) ∧ (read_gpr(Rax, g) = BitVec::ofNat(0))) {
            False => λ within next => {
                let later = t.goes_zeroes(env, tree, rest, p, Cons(id, live), λ i m => ok(i, Inr(m)), λ i m unfit => Inr(beyond(i, Inr(m), unfit)), within, next);
                t.goes_weaken(later, λ s h => ⟨t.held_sub(h.left, λ i m => match m {
                        Inl(e) => j(sym(e), λ x _ => Mem(x, live), beyond(id, Inl(refl), fit)),
                        Inr(m2) => m2,
                    }), h.right⟩)
            },
            True => λ within next => {
                let inside: (id < t.words) = Nat::leb_sound(Succ(id), layout.words, j(sym(fit), λ b _ => b.IsTrue(), trivial));
                let stored = p.word_store(layout, id, Rax);
                let later = t.goes_zeroes(env, tree, rest, stored, Cons(id, live), λ i m => ok(i, Inr(m)), λ i m unfit => Inr(beyond(i, Inr(m), unfit)), within, next);
                let w_stored = Prog::within_trans(Prog::within_zeroes(layout, rest, stored), within);
                let q = λ (g: Gprs) (m: X86Memory(t.r.profile)) => t.Held(Cons(id, live), env, g, m) ∧ (read_gpr(Rax, g) = BitVec::ofNat(0));
                let store = t.goes_word_store(p, id, Rax, inside, w_stored, tree, q, later);
                t.goes_weaken(store, λ s h => {
                        let g = s.gprs;
                        let m = s.memory;
                        let g2 = t.slot_gprs(id, g);
                        let zero: BitVec(64) = BitVec::ofNat(0);
                        let rax2: (read_gpr(Rax, g2) = zero) = trans(t.slot_gprs_other(id, g, Rax, refl), h.right);
                        let facts = ok(id, Inl(refl));
                        let value: (zero.toNat() = env.number(id)) = sym(facts.right);
                        let set: t.Held(Cons(id, live), env, g, t.r.profile.store(m, t.slot(id), word_bytes(zero))) =
                            t.held_slot_same(live, env, id, zero, g, m, h.left, facts.left, inside, value);
                        let moved = t.held_regs(Cons(id, live), env, g, g2, t.r.profile.store(m, t.slot(id), word_bytes(zero)), set,
                            λ k _ _ => t.slot_gprs_other(id, g, home_register(k), trans(Rbx.same_comm(home_register(k)), home_register_apart(Rbx, trivial, k))),
                            t.slot_gprs_other(id, g, Rsp, refl));
                        let done: q(g2, t.r.profile.store(m, t.slot(id), word_bytes(zero))) = ⟨moved, rax2⟩;
                        ⟨t.held_rsp(live, env, g, m, h.left), j(sym(rax2), λ x _ => q(g2, t.r.profile.store(m, t.slot(id), word_bytes(x))), done)⟩
                    })
            },
        }),
    }
}

// The start: every word zero, every buffer its capacity of zero bytes, and
// the command line the process was given.
fn Target::start_env(self t: Target) → Env { Env(Nil, t.caps.map(λ size => List::replicate(zero_byte(), size)), t.args) }

theorem Target::keeps_zero(self t: Target): t.layout().Keeps(t.start_env(), λ _ => zero_byte()) {
    let v = λ (_: Nat) => zero_byte();
    ⟨λ i _ => refl,
     λ b cap found => trans(cong_fn<Option<List<BitVec(8)>>, List<BitVec(8)>>(λ o => match o { None => Nil, Some(bytes) => bytes },
            t.caps.nth_map_some<Nat, List<BitVec(8)>>(λ size => List::replicate(zero_byte(), size), b, cap, found)),
        sym(cells_replicate(v, zero_byte(), cap, t.layout().buffer_offset(b), λ i _ => refl)))⟩
}

// RSP saved to its slot and the depth to the room slot, RSP moved to the
// top of the program's own stack, `main`'s frame opened below it, and zero stored in each word live at the start: a
// region of zeros, with the command line above the stack, holds the start,
// and `main` is the activation running, its frame at the stack's top with
// no frames above it and `depth` calls of room
// (docs/native/native-procedures-design.md §5). Nothing is asked of what the
// stack held.
theorem Target::goes_start(self t: Target, live: List<Nat>, slotted: t.homes.slotted(live).IsTrue(), bare: t.frames = Nil,
    depth: Nat, deep: t.room = depth, small: depth < Nat::pow(2, 64),
    room: Nat, at_top: t.layout().stack_top(room) = t.stack.at(t.index + 8 * t.words),
    p: Prog, within: p.saves_rsp(t.layout(), depth, room).frames_main(t.layout(), live).Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(p.saves_rsp(t.layout(), depth, room).frames_main(t.layout(), live)), live, tree, t.start_env())):
    t.Goes(prog_len(p), tree, λ s => t.r.Holds(λ _ => zero_byte(), s.memory) ∧
        ArgvAt(t.argv(), s.memory, read_gpr(Rsp, s.gprs), t.args)) {
    let layout = t.layout();
    let so = layout.stack_offset();
    let env = t.start_env();
    let top = t.index + 8 * t.words;
    let store = WordStore(Rbx, Rsp);
    let store3 = WordStore(Rbx, Rax);
    let d: BitVec(64) = BitVec::ofNat(depth);
    let set3: List<Instruction> = [MovRI(Rbx, layout.room_at()), MovRI(Rax, d), MovRI(Rsp, layout.stack_top(room))];
    let size: BitVec(64) = BitVec::ofNat(8 * t.words);
    let open: List<Instruction> = [MovRI(Rbx, size), SubRR(Rsp, Rbx), MovRI(Rax, BitVec::ofNat(0))];
    let mov = then(p, Block([MovRI(Rbx, layout.stack_at())]));
    let saved = then(mov, Store(store));
    let mov3 = then(saved, Block(set3));
    let sv = then(mov3, Store(store3));
    let fm = then(sv, Block(open));
    let fits_not = λ (i: Nat) => !layout.word_fits(i);
    let unfit = live.filter(fits_not);
    let w_fm = Prog::within_trans(Prog::within_zeroes(layout, live, fm), within);
    let w_sv = sv.within_before(0, Block(open), t.program, w_fm);
    let w_mov3 = mov3.within_before(0, Store(store3), t.program, w_sv);
    let w_saved = saved.within_before(0, Block(set3), t.program, w_mov3);
    let w_mov = mov.within_before(0, Store(store), t.program, w_saved);
    // The words zeroed, from the frame opened.
    let final: t.Goes(prog_len(fm.zeroes(layout, live)), tree, λ s => t.Held(live.onto(unfit), env, s.gprs, s.memory)) = t.goes_weaken(next,
        λ s h => t.held_sub(h, λ i m => live.mem_onto(i, unfit, m)));
    let zeroed = t.goes_zeroes(env, tree, live, fm, unfit, λ i m => ⟨t.homes.slotted_home(live, slotted, i, m), refl⟩,
        λ i m no => live.mem_filter_of(fits_not, i, cong_fn<Bool, Bool>(λ b => !b, no), m), within, final);
    let at_frame = λ (u: MachineState<X86Memory(t.r.profile)>) => t.Held(unfit, env, u.gprs, u.memory) ∧ (read_gpr(Rax, u.gprs) = BitVec::ofNat(0));
    let opened = t.goes_block(sv, 0, open, w_fm, tree, at_frame, zeroed);
    let post = λ (u: MachineState<X86Memory(t.r.profile)>) => t.Bare(env, t.room, top, t.frames, u.gprs, u.memory);
    let framed: t.Goes(prog_len(sv), tree, post) = t.goes_weaken(opened,
        λ u held => {
            let g = u.gprs;
            let low = read_gpr(Rsp, g).sub(size);
            let g2 = write_gpr(Rax, BitVec::ofNat(0), write_gpr(Rsp, low, write_gpr(Rbx, size, g)));
            let rsp: (read_gpr(Rsp, g2) = t.frame()) = trans(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(size), held.right.right),
                frame_below(t.stack.low, t.index, 8 * t.words));
            ⟨t.held_fresh(unfit, env, g2, u.memory, held.left, held.right.left, rsp, λ i m => {
                let kept: (fits_not(i) = True) = live.mem_filter_holds(i, fits_not, m);
                let past: (t.words <= i) = match i.lt_or_ge(t.words) {
                    Inl(lt) => absurd(trans(sym(cong_fn<Bool, Bool>(λ b => !b, Nat::leb_true(Succ(i), t.words, omega(lt)))), kept)),
                    Inr(ge) => ge,
                };
                ⟨past, ⟨t.homes.slotted_home(live, slotted, i, live.mem_filter(i, fits_not, m)), refl⟩⟩
            }), refl⟩
        });
    let pre_store = λ (st: WordStore) (q: MachineState<X86Memory(t.r.profile)> → Type) (u: MachineState<X86Memory(t.r.profile)>) =>
        (store_base_plain(Rbx) = True) ∧ (t.writes().writable(u.memory, read_gpr(Rbx, u.gprs), 8) ∧
        (t.site().Resident(word_store_after(t.writes(), st, u).memory) ∧ q(word_store_after(t.writes(), st, u))));
    let stored3 = t.goes_store(mov3, 0, store3, w_sv, tree, post, framed);
    let moved3 = t.goes_block(saved, 0, set3, w_mov3, tree, λ u => pre_store(store3, post, u), stored3);
    let mid = λ (u: MachineState<X86Memory(t.r.profile)>) => pre_store(store3, post, execute_block_normal(set3, u));
    let stored1 = t.goes_store(mov, 0, store, w_saved, tree, mid, moved3);
    let moved1 = t.goes_block(p, 0, [MovRI(Rbx, layout.stack_at())], w_mov, tree, λ u => pre_store(store, mid, u), stored1);
    λ s here resident held => {
        let m = s.memory;
        let rsp = read_gpr(Rsp, s.gprs);
        let bytes = word_bytes(rsp);
        let bytes3 = word_bytes(d);
        let eight: (bytes.len() = 8) = refl;
        let eight3: (bytes3.len() = 8) = refl;
        let zero = λ (_: Nat) => zero_byte();
        let slots: (so + 16 <= t.r.size) = t.fits;
        let fits: (so + 8 <= t.r.size) = omega(slots);
        let fits3: ((so + 8) + 8 <= t.r.size) = omega(slots);
        let stack: (so = layout.scratch_offset() + (t.caps.largest() + 1)) = refl;
        let w1 = t.r.buffer(zero).set_span(so, bytes.to_vector()).cells;
        let w3 = t.r.buffer(w1).set_span(so + 8, bytes3.to_vector()).cells;
        let m1 = t.r.profile.store(m, next_rip(t.r.low, so), bytes);
        let m3 = t.r.profile.store(m1, next_rip(t.r.low, so + 8), bytes3);
        let below3 = λ (q: Nat) (below: q < so + 8) => t.r.cells_outside(w1, so + 8, bytes3, q, Inl(below));
        let slot: (word_in(w3, so) = rsp) = trans(word_in_agree(w3, w1, so, λ k short => below3(so + k, omega(short))), t.r.x86_word_stored(zero, so, rsp));
        let room_word: (word_in(w3, so + 8) = d) = t.r.x86_word_stored(w1, so + 8, d);
        let room_is: (word_in(w3, so + 8).toNat() = t.room) =
            trans(trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), room_word), BitVec::toNat_ofNat(64, depth, small)), sym(deep));
        let argv1 = argv_at_kept(t.argv(), m, t.argv(), m1, t.kept_store(m, so, bytes, fits), rsp, t.args, held.right);
        let argv3 = argv_at_kept(t.argv(), m1, t.argv(), m3, t.kept_store(m1, so + 8, bytes3, fits3), rsp, t.args, argv1);
        let argv = j(sym(slot), λ y _ => ArgvAt(t.argv(), m3, y, t.args), argv3);
        let frames: t.FramesAt(m3, t.frames, top) = j(sym(bare), λ fs _ => t.FramesAt(m3, fs, top), trivial);
        let keeps = layout.keeps_agree(env, zero, w3, t.keeps_zero(), λ q away => match away {
            Inl(under) => {
                let low: (q < so) = omega(under, stack);
                trans(below3(q, omega(low)), t.r.cells_outside(zero, so, bytes, q, Inl(low)))
            },
            Inr(over) => trans(t.r.cells_outside(w1, so + 8, bytes3, q, Inr(omega(over, eight3, layout.stack_below_size()))),
                t.r.cells_outside(zero, so, bytes, q, Inr(omega(over, eight, layout.stack_below_size())))),
        });
        let holds3 = t.r.store_holds(w1, m1, t.r.store_holds(zero, m, held.left, so, bytes, fits), so + 8, bytes3, fits3);
        let based: t.Based(env, t.room, w3, m3) = ⟨holds3, ⟨keeps.right, ⟨refl, ⟨argv, room_is⟩⟩⟩⟩;
        let g3 = write_gpr(Rsp, layout.stack_top(room), write_gpr(Rax, d, write_gpr(Rbx, layout.room_at(), write_gpr(Rbx, layout.stack_at(), s.gprs))));
        // RSP is the program's own stack's top from here.
        let rsp3: (read_gpr(Rsp, g3) = t.stack.at(top)) = at_top;
        let third = λ (c: BitVec(64)) => t.writes().writable(m1, c, 8) ∧
            (t.site().Resident(t.r.profile.store(m1, c, bytes3)) ∧ t.Bare(env, t.room, top, t.frames, g3, t.r.profile.store(m1, c, bytes3)));
        let r1 = t.store_resident(m, so, bytes, fits, resident);
        let at_third: third(next_rip(t.r.low, so + 8)) = ⟨t.writable(m1, so + 8, 8, fits3),
            ⟨t.store_resident(m1, so + 8, bytes3, fits3, r1), ⟨Exists(w3, based), ⟨frames, rsp3⟩⟩⟩⟩;
        let c3: third(layout.room_at()) = j(sym(t.at_rip(so + 8)), λ c _ => third(c), at_third);
        let goal = λ (a: BitVec(64)) => t.writes().writable(m, a, 8) ∧ (t.site().Resident(t.r.profile.store(m, a, bytes)) ∧
            ((store_base_plain(Rbx) = True) ∧ (t.writes().writable(t.r.profile.store(m, a, bytes), layout.room_at(), 8) ∧
            (t.site().Resident(t.r.profile.store(t.r.profile.store(m, a, bytes), layout.room_at(), bytes3)) ∧
             t.Bare(env, t.room, top, t.frames, g3, t.r.profile.store(t.r.profile.store(m, a, bytes), layout.room_at(), bytes3))))));
        let at_goal: goal(next_rip(t.r.low, so)) = ⟨t.writable(m, so, 8, fits), ⟨r1, ⟨refl, c3⟩⟩⟩;
        moved1(s, here, resident, ⟨refl, j(sym(t.at_rip(so)), λ a _ => goal(a), at_goal)⟩)
    }
}

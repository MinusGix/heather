// Where the environment's words are between statements, once each word has
// a home (native_alloc; docs/native/native-register-allocation-design.md).
//
// The region still holds a file of words (`Target::Placed`), but only the
// words in their slots are read from it; a word homed in a register is read
// from that register, and its slot may hold anything. So the invariant
// between statements (`Target::Held`) is over a set of live words: some file
// of words is placed in the region with the environment's buffers and
// command line, and every live word reads as the environment's from its
// home (`Homes::Agrees`). A dead word is anywhere. And RSP is the running
// activation's frame (`Target::Agreeing`): no statement moves it, so a
// CALL pushes below the frame and a callee finds its own frame in RSP
// (docs/native/native-procedures-are-functions-design.md §3, step 5a).
//
// The registers enter only through `home_values`, the home pool's six read
// in order and RSP after them. A write to a register outside the pool
// other than RSP leaves it as it was by evaluation, so the scratch a
// statement uses (RAX, RBX, RCX, RDX, RSI, RDI, R8, R9, R11, everything
// Linux's SYSCALL writes) passes `Held` along unchanged, and only a write
// to a pool register needs a lemma: a home's own write (`held_reg_set`), a
// register no word lives in (`held_unused`), or code that keeps RSP and
// every register a word lives in (`held_kept`). What moves RSP (a push, a
// pop, a CALL, a RET) moves the claim to another activation
// (`Target::held_moved`, native_compile_perform).
import native_source;
import native_alloc;
import native_compile;
import native_compile_facts;
import native_compile_region;
import function_ir;
import function_ir_eval;
import linux_x86_64_byte_memory;
import x86_64;
import x86_64_kept;
import x86_64_byte_memory;
import x86_64_asm_runs;
import x86_64_store;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;
import dec_set;
import set_tactic;

// ---------------------------------------------------------------------------
// Registers apart

theorem Nat::same_comm(self n: Nat): (m: Nat) → n.same(m) = m.same(n) {
    match n {
        Zero => λ m => match m { Zero => refl, Succ(_) => refl },
        Succ(_, ih) => λ m => match m { Zero => refl, Succ(l) => ih(l) },
    }
}

theorem Nat::same_false(self n: Nat, m: Nat, ne: n ≠ m): n.same(m) = False {
    match e: n.same(m) {
        True => false_elim(ne(n.same_sound(m, e))),
        False => refl,
    }
}

theorem Nat::differs_eq_of_ne(self a: Nat, b: Nat, ne: a ≠ b): a.differs(b) = True {
    (match a.eq_dec(b) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => refl,
    })
}

theorem Gpr::same_comm(self a: Gpr, b: Gpr): a.same(b) = b.same(a) { a.index().same_comm(b.index()) }

theorem Bool::false_of_not(b: Bool, no: (!b).IsTrue()): b = False { not_true_false(b, no) }

// A register other than the one written reads as it did.
theorem read_gpr_other(register, query: Gpr, value: BitVec(64), g: Gprs, differ: register.same(query) = False):
    read_gpr(query, write_gpr(register, value, g)) = read_gpr(query, g) {
    trans(read_gpr_write(register, query, value, g),
        j(sym(differ), λ b _ => (match b { False => read_gpr(query, g), True => value }) = read_gpr(query, g), refl))
}

// A register absent from a list is apart from its head, and from the rest.
theorem Gpr::absent_head(self register: Gpr, other: Gpr, rest: List<Gpr>, absent: register.absent_from(Cons(other, rest)).IsTrue()):
    other.same(register) = False { by sets() }

theorem Gpr::absent_rest(self register: Gpr, other: Gpr, rest: List<Gpr>, absent: register.absent_from(Cons(other, rest)).IsTrue()):
    register.absent_from(rest).IsTrue() { by sets() }

// ---------------------------------------------------------------------------
// Sets of words as lists

theorem List::mem_filter_of<A>(self xs: List<A>, p: A → Bool, a: A, keep: p(a) = True): Mem(a, xs) → Mem(a, xs.filter(p)) {
    match xs {
        Nil => λ never => never,
        Cons(h, rest) => λ m => match dropped: p(h) {
            True => match m { Inl(e) => Inl(e), Inr(later) => Inr(rest.mem_filter_of(p, a, keep, later)) },
            False => match m {
                Inl(e) => absurd(trans(sym(dropped), j(e, λ x _ => p(x) = True, keep))),
                Inr(later) => rest.mem_filter_of(p, a, keep, later),
            },
        },
    }
}

theorem List::union_left(self a: List<Nat>, b: List<Nat>, i: Nat, m: Mem(i, a)): Mem(i, a.union(b)) { by sets() }

theorem List::union_right(self a: List<Nat>, b: List<Nat>, i: Nat, m: Mem(i, b)): Mem(i, a.union(b)) { by sets() }

// A word of `out` other than the one written is live before the write.
theorem live_before_keeps(reads: List<Nat>, written: Nat, out: List<Nat>, i: Nat, m: Mem(i, out), ne: i ≠ written):
    Mem(i, live_before(reads, written, out)) { by sets() }

// What a step reads is live before it.
theorem live_before_reads(reads: List<Nat>, written: Nat, out: List<Nat>, i: Nat, m: Mem(i, reads)): Mem(i, live_before(reads, written, out)) { by sets() }

// ---------------------------------------------------------------------------
// The one-pass check is the checks

theorem Homes::nodes_checked_sound(self homes: Homes, out: List<Nat>, nodes: List<Node>): (l: List<Nat>) →
    homes.nodes_checked(nodes, out) = Some(l) → (l = nodes_live_in(nodes, out)) ∧ homes.nodes_apart(nodes, out).IsTrue() {
    match nodes {
        Nil => λ l found => {
            cases found;
            ⟨refl, trivial⟩
        },
        Cons(node, rest) => λ l found => {
            let id = node_output(node).id;
            let reads = function_ir_eval::Node::reads(node);
            cases found as got(after), ok;
            let inner = homes.nodes_checked_sound(out, rest, after, got);
            j(inner.left, λ a _ => (live_before(reads, id, after) = live_before(reads, id, a)) ∧ (homes.apart(id, a) && homes.nodes_apart(rest, out)).IsTrue(),
                ⟨refl, Bool::is_true_and_intro(homes.apart(id, after), homes.nodes_apart(rest, out), Bool::is_true_of_eq(ok), inner.right)⟩)
        },
    }
}

// What `Stmt::checked` finds is the set live before the statement, and the
// checks hold.
// A region's check finds what is live before it.
theorem Homes::region_checked_sound(self homes: Homes, region: StructuredRegion, out, l: List<Nat>, got: homes.region_checked(region, out) = Some(l)):
    (l = homes.region_live(region, out)) ∧ Bool::IsTrue(match homes.region_checked(region, out) { None => False, Some(_) => True }) {
    ⟨j(sym(got), λ o _ => l = (match o { None => out, Some(live) => live }), refl),
        j(sym(got), λ o _ => Bool::IsTrue(match o { None => False, Some(_) => True }), trivial)⟩
}

theorem Stmt::checked_sound(self s: Stmt, homes: Homes): (out: List<Nat>) → (l: List<Nat>) →
    s.checked(homes, out) = Some(l) → (l = s.live_in(homes, out)) ∧ s.checks(homes, out).IsTrue() {
    match s {
        Compute(region) => match region {
            Dataflow(body) => λ out l found => {
                cases found as got(live), apart;
                let inner = homes.nodes_checked_sound(out, body.nodes, live, got);
                ⟨inner.left, Bool::is_true_and_intro(homes.nodes_apart(body.nodes, out), homes.all_apart(nodes_writes(body.nodes), out), inner.right,
                    Bool::is_true_of_eq(apart))⟩
            },
            Sequence(a, b) => λ out l same => homes.region_checked_sound(Sequence(a, b), out, l, same),
            Compose(a, b) => λ out l same => homes.region_checked_sound(Compose(a, b), out, l, same),
            Conditional(a, b, c, d, e, f) => λ out l same => homes.region_checked_sound(Conditional(a, b, c, d, e, f), out, l, same),
            Lend(a, b, c, d) => λ out l same => homes.region_checked_sound(Lend(a, b, c, d), out, l, same),
            Call(a, b, c) => λ out l same => homes.region_checked_sound(Call(a, b, c), out, l, same),
            Loop(a, b, c, d, e, f, g, h, i) => λ out l same => homes.region_checked_sound(Loop(a, b, c, d, e, f, g, h, i), out, l, same),
        },
        Invoke(shape) => λ out l found => {
            cases found as apart;
            ⟨refl, Bool::is_true_of_eq(apart)⟩
        },
        Then(first, rest) => λ out l found => {
            cases found as got_rest(mid);
            let r = rest.checked_sound(homes, out, mid, got_rest);
            let f = j(r.left, λ a _ => (l = first.live_in(homes, a)) ∧ first.checks(homes, a).IsTrue(), first.checked_sound(homes, mid, l, found));
            ⟨f.left, Bool::is_true_and_intro(first.checks(homes, rest.live_in(homes, out)), rest.checks(homes, out), f.right, r.right)⟩
        },
        Branch(condition, yes, no) => λ out l found => {
            cases found as got_yes(y), got_no(n);
            let ys = yes.checked_sound(homes, out, y, got_yes);
            let ns = no.checked_sound(homes, out, n, got_no);
            let e1 = j(ys.left, λ a _ => Cons(condition, y.union(n)) = Cons(condition, a.union(n)), refl);
            ⟨j(ns.left, λ a _ => Cons(condition, y.union(n)) = Cons(condition, yes.live_in(homes, out).union(a)), e1),
             Bool::is_true_and_intro(yes.checks(homes, out), no.checks(homes, out), ys.right, ns.right)⟩
        },
        Repeat(body, again) => λ out l found => {
            let set = homes.loop_set(again);
            let after = loop_after(again, set, out);
            cases found as got(b), inside;
            let bs = body.checked_sound(homes, after, b, got);
            ⟨refl, Bool::is_true_and_intro(body.live_in(homes, after).within(set), body.checks(homes, after),
                j(bs.left, λ a _ => a.within(set).IsTrue(), Bool::is_true_of_eq(inside)), bs.right)⟩
        },
        Exit(status) => λ out l found => {
            cases found;
            ⟨refl, trivial⟩
        },
        Arg(index, _, len) => λ out l found => {
            cases found as apart;
            ⟨refl, Bool::is_true_of_eq(apart)⟩
        },
        Perform(_, args, results) => λ out l found => {
            cases found as apart;
            ⟨refl, Bool::is_true_of_eq(apart)⟩
        },
    }
}

// What a compile's check of its homes gives the proof.
theorem Source::allocation_sound(self src: Source, homes: Homes, ok: src.allocation_ok(homes).IsTrue()):
    homes.fits().IsTrue() ∧ (homes.slotted(src.main.live_in(homes, [])).IsTrue() ∧ src.main.checks(homes, []).IsTrue()) {
    ⟨known, (match src.main.checked(homes, []) as λ o => src.main.checked(homes, []) = o →
            Bool::IsTrue(match o { None => False, Some(live) => homes.slotted(live) }) →
            homes.slotted(src.main.live_in(homes, [])).IsTrue() ∧ src.main.checks(homes, []).IsTrue() {
        None => λ _ no => false_elim(no),
        Some(live) => λ got slotted => {
            let sound = src.main.checked_sound(homes, [], live, got);
            ⟨j(sound.left, λ a _ => homes.slotted(a).IsTrue(), slotted), sound.right⟩
        },
    })(refl, known)⟩
}

// ---------------------------------------------------------------------------
// The homes, read off their list

// A word whose home is a register is one the list places.
theorem Homes::listed(self homes: Homes, id, k: Nat, at: homes.home(id) = InReg(k)): homes.of.nth(id) = Some(InReg(k)) {
    (match homes.of.nth(id) as λ o => (match o { None => InSlot(id), Some(home) => home }) = InReg(k) → o = Some(InReg(k)) {
        None => λ no => absurd(no),
        Some(home) => λ same => cong_fn<Home, Option<Home>>(λ h => Some(h), same),
    })(at)
}

// A register home is in the pool.
theorem List::home_in_pool(self of: List<Home>): of.homes_fit().IsTrue() → (id, k: Nat) → of.nth(id) = Some(InReg(k)) → k < 6 {
    match of {
        Nil => λ _ id k at => absurd(at),
        Cons(home, rest) => λ fit id => {
            match id {
                Zero => λ k at => Nat::leb_sound(Succ(k), 6, j(Option::some_inj(home, InReg(k), at), λ h _ => h.in_pool().IsTrue(), Bool::both(fit).left)),
                Succ(i) => λ k at => rest.home_in_pool(Bool::both(fit).right, i, k, at),
            }
        },
    }
}

theorem Homes::in_pool(self homes: Homes, fits: homes.fits().IsTrue(), id, k: Nat, at: homes.home(id) = InReg(k)): k < 6 {
    homes.of.home_in_pool(Bool::both(fits).left, id, k, homes.listed(id, k, at))
}

// ---------------------------------------------------------------------------
// Slots apart: no two words share one

theorem List::nth_none_past<A>(self xs: List<A>): (i: Nat) → xs.nth(i) = None → xs.len() <= i {
    match xs {
        Nil => λ i _ => omega(),
        Cons(x, rest) => λ i => match i {
            Zero => λ at => absurd(at),
            Succ(n) => λ at => { let r = rest.nth_none_past(n, at); omega(r) },
        },
    }
}

// A slot free in a list is no listed word's.
theorem List::slot_free_nth(self of: List<Home>, k: Nat): of.slot_free(k).IsTrue() → (i, s: Nat) → of.nth(i) = Some(InSlot(s)) → s ≠ k {
    match of {
        Nil => λ _ i s at => absurd(at),
        Cons(home, rest) => λ free i => match i {
            Zero => λ s at e => {
                let head: (!InSlot(s).is_slot(k)).IsTrue() = j(Option::some_inj(home, InSlot(s), at), λ h _ => (!h.is_slot(k)).IsTrue(), Bool::both(free).left);
                let same: (s.same(k) = True) = j(e, λ x _ => s.same(x) = True, s.same_self());
                j(sym(same), λ b _ => (!b).IsTrue() → False, λ no => no)(head)
            },
            Succ(n) => λ s at => rest.slot_free_nth(k, Bool::both(free).right, n, s, at),
        },
    }
}

// What the check says of a list's first home, a slot.
theorem List::slots_head(home: Home, rest: List<Home>, len, k: Nat, apart: Cons(home, rest).slots_apart(len).IsTrue(), at: home = InSlot(k)):
    Succ(k).leb(len).IsTrue() ∧ rest.slot_free(k).IsTrue() {
    Bool::both(j(at, λ h _ => Bool::IsTrue(match h { InSlot(s) => Succ(s).leb(len) && rest.slot_free(s), InReg(_) => True }), Bool::both(apart).left))
}

// A listed slot is under the bound…
theorem List::slots_below(self of: List<Home>, len: Nat): of.slots_apart(len).IsTrue() → (i, k: Nat) → of.nth(i) = Some(InSlot(k)) → k < len {
    match of {
        Nil => λ _ i k at => absurd(at),
        Cons(home, rest) => λ apart i => match i {
            Zero => λ k at => Nat::leb_sound(Succ(k), len, List::slots_head(home, rest, len, k, apart, Option::some_inj(home, InSlot(k), at)).left),
            Succ(n) => λ k at => rest.slots_below(len, Bool::both(apart).right, n, k, at),
        },
    }
}

// …and one word's only.
theorem List::slots_distinct(self of: List<Home>, len: Nat): of.slots_apart(len).IsTrue() → (i, n, k: Nat) →
    of.nth(i) = Some(InSlot(k)) → of.nth(n) = Some(InSlot(k)) → i = n {
    match of {
        Nil => λ _ i n k at => absurd(at),
        Cons(home, rest) => λ apart i n => match i {
            Zero => match n {
                Zero => λ k _ _ => refl,
                Succ(b) => λ k at other => false_elim(rest.slot_free_nth(k,
                    List::slots_head(home, rest, len, k, apart, Option::some_inj(home, InSlot(k), at)).right, b, k, other)(refl)),
            },
            Succ(a) => match n {
                Zero => λ k at other => false_elim(rest.slot_free_nth(k,
                    List::slots_head(home, rest, len, k, apart, Option::some_inj(home, InSlot(k), other)).right, a, k, at)(refl)),
                Succ(b) => λ k at other => cong_fn<Nat, Nat>(λ x => Succ(x), rest.slots_distinct(len, Bool::both(apart).right, a, b, k, at, other)),
            },
        },
    }
}

// A word's slot is the list's, or its own number past the list.
theorem Homes::slot_how(self homes: Homes, id, k: Nat, at: homes.home(id) = InSlot(k)):
    (homes.of.nth(id) = Some(InSlot(k))) ∨ ((homes.of.nth(id) = None) ∧ (k = id)) {
    (match homes.of.nth(id) as λ o => (match o { None => InSlot(id), Some(home) => home }) = InSlot(k) → (o = Some(InSlot(k))) ∨ ((o = None) ∧ (k = id)) {
        None => λ same => Inr(⟨refl, sym(cong_fn<Home, Nat>(λ h => match h { InSlot(s) => s, InReg(_) => 0 }, same))⟩),
        Some(home) => λ same => Inl(cong_fn<Home, Option<Home>>(λ h => Some(h), same)),
    })(at)
}

// Two words have two slots.
theorem Homes::slots_differ(self homes: Homes, fits: homes.fits().IsTrue(), i, id, ki, kid: Nat, at_i: homes.home(i) = InSlot(ki),
    at_id: homes.home(id) = InSlot(kid), ne: i ≠ id): ki ≠ kid {
    let len = homes.of.len();
    let apart: homes.of.slots_apart(len).IsTrue() = Bool::both(fits).right;
    λ e => match homes.slot_how(i, ki, at_i) {
        Inl(li) => match homes.slot_how(id, kid, at_id) {
            Inl(lid) => ne(homes.of.slots_distinct(len, apart, i, id, ki, li, j(sym(e), λ x _ => homes.of.nth(id) = Some(InSlot(x)), lid))),
            Inr(d) => {
                let below = homes.of.slots_below(len, apart, i, ki, li);
                let past = homes.of.nth_none_past(id, d.left);
                omega(below, past, e, d.right)
            },
        },
        Inr(c) => match homes.slot_how(id, kid, at_id) {
            Inl(lid) => {
                let below = homes.of.slots_below(len, apart, id, kid, lid);
                let past = homes.of.nth_none_past(i, c.left);
                omega(below, past, e, c.right)
            },
            Inr(d) => ne(trans(sym(c.right), trans(e, d.right))),
        },
    }
}

theorem Bool::or_true_l(self a: Bool, b: Bool, set: a = True): a || b = True { j(sym(set), λ x _ => (x || b) = True, refl) }

theorem Bool::or_true_r(self a: Bool, b: Bool, set: b = True): a || b = True {
    match a { False => set, True => refl }
}

// A register a word lives in is one the homes use.
theorem List::home_used(self of: List<Home>): (id, k: Nat) → of.nth(id) = Some(InReg(k)) → of.homes_use(home_register(k)) = True {
    match of {
        Nil => λ id k at => absurd(at),
        Cons(home, rest) => λ id => match id {
            Zero => λ k at => j(sym(Option::some_inj(home, InReg(k), at)), λ h _ => (match h { InSlot(_) => rest.homes_use(home_register(k)),
                    InReg(r) => home_register(r).same(home_register(k)) || rest.homes_use(home_register(k)) }) = True,
                home_register(k).same(home_register(k)).or_true_l(rest.homes_use(home_register(k)), home_register(k).index().same_self())),
            Succ(i) => λ k at => {
                let later = rest.home_used(i, k, at);
                match home {
                    InSlot(_) => later,
                    InReg(r) => home_register(r).same(home_register(k)).or_true_r(rest.homes_use(home_register(k)), later),
                }
            },
        },
    }
}

theorem Homes::lived(self homes: Homes, id, k: Nat, at: homes.home(id) = InReg(k)): homes.lives(home_register(k)) = True {
    homes.of.home_used(id, k, homes.listed(id, k, at))
}

theorem Homes::used(self homes: Homes, id, k: Nat, at: homes.home(id) = InReg(k)): homes.uses(home_register(k)) = True {
    homes.lives(home_register(k)).or_true_l(homes.pinned(home_register(k)), homes.lived(id, k, at))
}

// A pinned register is one the homes use, and no word lives in it.
theorem Homes::pinned_used(self homes: Homes, x: Gpr, pinned: homes.pinned(x) = True): homes.uses(x) = True {
    homes.lives(x).or_true_r(homes.pinned(x), pinned)
}

theorem Homes::pinned_unlived(self homes: Homes, x: Gpr, pinned: homes.pinned(x) = True): homes.lives(x) = False {
    match e: homes.lives(x) {
        True => absurd(pinned),
        False => refl,
    }
}

// A register the homes do not use is not pinned, and a register that is not
// pinned is apart from every pinned one.
theorem Homes::unused_unpinned(self homes: Homes, x: Gpr, unused: homes.uses(x) = False): homes.pinned(x) = False {
    match e: homes.pinned(x) { True => absurd(trans(sym(unused), homes.pinned_used(x, e))), False => refl }
}

theorem Homes::unpinned_apart(self homes: Homes, x, y: Gpr, pinned: homes.pinned(y) = True, free: homes.pinned(x) = False): x.same(y) = False {
    match e: x.same(y) {
        True => absurd(trans(sym(free), trans(cong_fn<Gpr, Bool>(λ r => homes.pinned(r), x.same_sound(y, e)), pinned))),
        False => refl,
    }
}

// Every home register is one of the pool (past the pool, `R12`).
theorem home_register_pooled(k: Nat): Mem(home_register(k), home_pool()) {
    match k {
        Zero => Inl(refl),
        Succ(k1) => match k1 {
            Zero => Inr(Inl(refl)),
            Succ(k2) => match k2 {
                Zero => Inr(Inr(Inl(refl))),
                Succ(k3) => match k3 {
                    Zero => Inr(Inr(Inr(Inl(refl)))),
                    Succ(k4) => match k4 {
                        Zero => Inr(Inr(Inr(Inr(Inl(refl))))),
                        Succ(k5) => match k5 {
                            Zero => Inr(Inr(Inr(Inr(Inr(Inl(refl)))))),
                            Succ(_) => Inl(refl),
                        },
                    },
                },
            },
        },
    }
}

// A register outside the pool is no home's.
theorem home_register_apart(x: Gpr, outside: x.absent_from(home_pool()).IsTrue(), k: Nat): home_register(k).same(x) = False {
    let m = home_register_pooled(k);
    by sets()
}

theorem List::uses_outside(self of: List<Home>, x: Gpr, outside: x.absent_from(home_pool()).IsTrue()): of.homes_use(x) = False {
    match of {
        Nil => refl,
        Cons(home, rest) => match home {
            InSlot(_) => rest.uses_outside(x, outside),
            InReg(k) => j(sym(home_register_apart(x, outside, k)), λ b _ => (b || rest.homes_use(x)) = False, rest.uses_outside(x, outside)),
        },
    }
}

// So no word lives in a statement's scratch.
theorem Homes::unused(self homes: Homes, x: Gpr, outside: x.absent_from(home_pool()).IsTrue()): homes.uses(x) = False {
    j(sym(homes.of.uses_outside(x, outside)), λ b _ => (b || (!b && (homes.pins.homes_use(x) && !x.same(R10)))) = False,
        j(sym(homes.pins.uses_outside(x, outside)), λ b _ => (b && !x.same(R10)) = False, refl))
}

theorem home_register_mem(k: Nat): k < 6 → Mem(home_register(k), home_pool()) { λ _ => home_register_pooled(k) }

// ---------------------------------------------------------------------------
// The pool's registers, read

// What code between two statements keeps: the pool's registers, and after
// them the stack pointer, which is the running frame
// (docs/native/native-procedures-are-functions-design.md §3, step 5a).
fn home_values(g: Gprs) → List<BitVec(64)> { home_pool().map(λ (register: Gpr) => read_gpr(register, g)) ++ [read_gpr(Rsp, g)] }

theorem home_value(g: Gprs): (k: Nat) → k < 6 → home_values(g).get_or(k, BitVec::zero()) = read_gpr(home_register(k), g) {
    λ k => match k {
        Zero => λ _ => refl,
        Succ(k1) => match k1 {
            Zero => λ _ => refl,
            Succ(k2) => match k2 {
                Zero => λ _ => refl,
                Succ(k3) => match k3 {
                    Zero => λ _ => refl,
                    Succ(k4) => match k4 {
                        Zero => λ _ => refl,
                        Succ(k5) => match k5 {
                            Zero => λ _ => refl,
                            Succ(_) => λ no => false_elim(no),
                        },
                    },
                },
            },
        },
    }
}

// A home register written: the pool's values with that one put.
theorem home_values_write(w: BitVec(64), g: Gprs): (k: Nat) → k < 6 →
    home_values(write_gpr(home_register(k), w, g)) = home_values(g).put(k, w, BitVec::zero()) {
    λ k => match k {
        Zero => λ _ => refl,
        Succ(k1) => match k1 {
            Zero => λ _ => refl,
            Succ(k2) => match k2 {
                Zero => λ _ => refl,
                Succ(k3) => match k3 {
                    Zero => λ _ => refl,
                    Succ(k4) => match k4 {
                        Zero => λ _ => refl,
                        Succ(k5) => match k5 {
                            Zero => λ _ => refl,
                            Succ(_) => λ no => false_elim(no),
                        },
                    },
                },
            },
        },
    }
}

// A register kept by code that leaves every register of a filtered list.
theorem kept_filter(pool: List<Gpr>, p: Gpr → Bool, before, after: Gprs, register: Gpr, chosen: p(register) = True):
    Kept(pool.filter(p), before, after) → Mem(register, pool) → read_gpr(register, after) = read_gpr(register, before) {
    match pool {
        Nil => λ _ never => false_elim(never),
        Cons(h, rest) => (match dropped: p(h) {
            True => λ kept m => match m {
                Inl(e) => j(sym(e), λ x _ => read_gpr(x, after) = read_gpr(x, before), kept.left),
                Inr(later) => kept_filter(rest, p, before, after, register, chosen, kept.right, later),
            },
            False => λ kept m => match m {
                Inl(e) => absurd(trans(sym(dropped), j(e, λ x _ => p(x) = True, chosen))),
                Inr(later) => kept_filter(rest, p, before, after, register, chosen, kept, later),
            },
        }),
    }
}

// ---------------------------------------------------------------------------
// The invariant between statements

// A word's number where its home holds it: its slot's entry in `words`, or
// its register's among `values`.
fn Homes::number(self homes: Homes, id: Nat, words: List<Nat>, values: List<BitVec(64)>) → Nat {
    match homes.home(id) { InSlot(slot) => words.get_or(slot, 0), InReg(k) => values.get_or(k, BitVec::zero()).toNat() }
}

// Every live word reads as the environment's from its home.
fn Homes::Agrees(self homes: Homes, live: List<Nat>, env: Env, words: List<Nat>, values: List<BitVec(64)>) → Type {
    (i: Nat) → Mem(i, live) → homes.number(i, words, values) = env.number(i)
}

fn Env::with_words(self env: Env, words: List<Nat>) → Env { Env(words, env.buffers, env.args) }

// What the kept values say: every live word reads as the environment's
// from its home, and the stack pointer, after the pool's registers among
// `values`, is the running frame; and every register the homes pin holds
// what it did when the activation was entered.
fn Target::Pins(self t: Target, values: List<BitVec(64)>) → Type {
    (k: Nat) → k < 6 → t.homes.pinned(home_register(k)) = True → values.get_or(k, BitVec::zero()) = t.pinned.get_or(k, BitVec::zero())
}
fn Target::Agreeing(self t: Target, live: List<Nat>, env: Env, words: List<Nat>, values: List<BitVec(64)>) → Type {
    t.homes.Agrees(live, env, words, values) ∧ ((values.get_or(6, BitVec::zero()) = t.frame()) ∧ t.Pins(values))
}

// The region placed with the environment's buffers and command line and some
// file of words, every live word as the environment's in its home, and RSP
// the running frame.
fn Target::Held(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile)) → Type {
    Exists<List<Nat>>(λ words => t.Placed(env.with_words(words), m) ∧ t.Agreeing(live, env, words, home_values(g)))
}

// RSP, read off the claim.
theorem Target::held_rsp(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m)):
    read_gpr(Rsp, g) = t.frame() {
    held.proof.right.right.left
}

// A pinned register, read off the claim: what it held at the entry.
theorem Target::held_pin(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    k: Nat, inside: k < 6, pinned: t.homes.pinned(home_register(k)) = True):
    read_gpr(home_register(k), g) = t.pinned.get_or(k, BitVec::zero()) {
    trans(sym(home_value(g, k, inside)), held.proof.right.right.right(k, inside, pinned))
}

// Fewer words live.
theorem Target::held_sub(self t: Target, {live, wider: List<Nat>}, {env: Env}, {g: Gprs}, {m: X86Memory(t.r.profile)}, held: t.Held(wider, env, g, m),
    sub: (i: Nat) → Mem(i, live) → Mem(i, wider)): t.Held(live, env, g, m) {
    Exists(held.witness, ⟨held.proof.left, ⟨λ i m2 => held.proof.right.left(i, sub(i, m2)), held.proof.right.right⟩⟩)
}

// The environment is the same.
theorem Target::held_same(self t: Target, {live: List<Nat>}, {env, other: Env}, {g: Gprs}, {m: X86Memory(t.r.profile)}, held: t.Held(live, env, g, m),
    same: env = other): t.Held(live, other, g, m) {
    j(same, λ e _ => t.Held(live, e, g, m), held)
}

// The registers a word lives in read as they did: every live word agrees
// still.
theorem Target::agrees_regs(self t: Target, live: List<Nat>, env: Env, words: List<Nat>, g, g2: Gprs,
    agrees: t.homes.Agrees(live, env, words, home_values(g)),
    same: (k: Nat) → k < 6 → t.homes.uses(home_register(k)) = True → read_gpr(home_register(k), g2) = read_gpr(home_register(k), g)):
    t.homes.Agrees(live, env, words, home_values(g2)) {
    λ i m2 => (match t.homes.home(i) as λ h => t.homes.home(i) = h →
            (match h { InSlot(slot) => words.get_or(slot, 0), InReg(k) => home_values(g).get_or(k, BitVec::zero()).toNat() }) = env.number(i) →
            (match h { InSlot(slot) => words.get_or(slot, 0), InReg(k) => home_values(g2).get_or(k, BitVec::zero()).toNat() }) = env.number(i) {
        InSlot(_) => λ _ agreed => agreed,
        InReg(k) => λ at agreed => {
            let inside = t.homes.in_pool(t.homed, i, k, at);
            trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), trans(home_value(g2, k, inside),
                trans(same(k, inside, t.homes.used(i, k, at)), sym(home_value(g, k, inside))))), agreed)
        },
    })(refl, agrees(i, m2))
}

// The registers a word lives in, and RSP, read as they did.
theorem Target::held_regs(self t: Target, live: List<Nat>, env: Env, g, g2: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    same: (k: Nat) → k < 6 → t.homes.uses(home_register(k)) = True → read_gpr(home_register(k), g2) = read_gpr(home_register(k), g),
    rsp: read_gpr(Rsp, g2) = read_gpr(Rsp, g)):
    t.Held(live, env, g2, m) {
    Exists(held.witness, ⟨held.proof.left, ⟨t.agrees_regs(live, env, held.witness, g, g2, held.proof.right.left, same),
        ⟨trans(rsp, held.proof.right.right.left), λ k inside pinned => trans(home_value(g2, k, inside),
            trans(same(k, inside, t.homes.pinned_used(home_register(k), pinned)),
                trans(sym(home_value(g, k, inside)), held.proof.right.right.right(k, inside, pinned))))⟩⟩⟩)
}

// The pinned registers read as they did: they hold the entry's values still.
theorem Target::pins_regs(self t: Target, g, g2: Gprs, pins: t.Pins(home_values(g)),
    same: (k: Nat) → k < 6 → t.homes.pinned(home_register(k)) = True → read_gpr(home_register(k), g2) = read_gpr(home_register(k), g)):
    t.Pins(home_values(g2)) {
    λ k inside pinned => trans(home_value(g2, k, inside), trans(same(k, inside, pinned), trans(sym(home_value(g, k, inside)), pins(k, inside, pinned))))
}

// A register that is not pinned, written.
theorem Target::pins_write(self t: Target, g: Gprs, x: Gpr, v: BitVec(64), free: t.homes.pinned(x) = False, pins: t.Pins(home_values(g))):
    t.Pins(home_values(write_gpr(x, v, g))) {
    t.pins_regs(g, write_gpr(x, v, g), pins, λ k inside pinned =>
        read_gpr_other(x, home_register(k), v, g, t.homes.unpinned_apart(x, home_register(k), pinned, free)))
}

// A register no word lives in, and not RSP, written.
theorem Target::held_unused(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    register: Gpr, value: BitVec(64), unused: t.homes.uses(register) = False, apart: register.same(Rsp) = False):
    t.Held(live, env, write_gpr(register, value, g), m) {
    t.held_regs(live, env, g, write_gpr(register, value, g), m, held, λ k inside used =>
        read_gpr_other(register, home_register(k), value, g, match e: register.same(home_register(k)) {
            True => absurd(trans(sym(unused), trans(cong_fn<Gpr, Bool>(λ r => t.homes.uses(r), register.same_sound(home_register(k), e)), used))),
            False => refl,
        }), read_gpr_other(register, Rsp, value, g, apart))
}

// Code that keeps RSP and every register a word lives in.
theorem Target::held_kept(self t: Target, live: List<Nat>, env: Env, g, g2: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    kept: Kept(Cons(Rsp, t.homes.registers()), g, g2)): t.Held(live, env, g2, m) {
    t.held_regs(live, env, g, g2, m, held, λ k inside used =>
        kept_filter(home_pool(), λ (register: Gpr) => t.homes.uses(register), g, g2, home_register(k), used, kept.right, home_register_mem(k, inside)),
        kept.left)
}

// Every live word has a slot.
theorem Homes::slotted_home(self homes: Homes, ids: List<Nat>): homes.slotted(ids).IsTrue() → (i: Nat) → Mem(i, ids) →
    Exists<Nat>(λ k => homes.home(i) = InSlot(k)) {
    match ids {
        Nil => λ _ i never => false_elim(never),
        Cons(id, rest) => (match at: homes.home(id) {
            InSlot(k) => λ slotted i m => match m {
                Inl(e) => j(sym(e), λ x _ => Exists<Nat>(λ s => homes.home(x) = InSlot(s)), Exists(k, at)),
                Inr(later) => homes.slotted_home(rest, slotted, i, later),
            },
            InReg(_) => λ never => false_elim(never),
        }),
    }
}

// ---------------------------------------------------------------------------
// A live word, read from its home

// Its slot's word…
theorem Target::held_slot_word(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    id: Nat, holds: Mem(id, live), k: Nat, slot: t.homes.home(id) = InSlot(k)): env.with_words(held.witness).word(k) = env.word(id) {
    let words = held.witness;
    cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), j(slot, λ h _ => (match h {
        InSlot(slot) => words.get_or(slot, 0),
        InReg(k) => home_values(g).get_or(k, BitVec::zero()).toNat(),
    }) = env.number(id), held.proof.right.left(id, holds)))
}

// …or its register's.
theorem Target::held_reg_word(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    id: Nat, holds: Mem(id, live), k: Nat, at: t.homes.home(id) = InReg(k)): read_gpr(home_register(k), g) = env.word(id) {
    let words = held.witness;
    let read = read_gpr(home_register(k), g);
    let number: (read.toNat() = env.number(id)) = trans(sym(cong_fn<BitVec(64), Nat>(λ x => x.toNat(),
        home_value(g, k, t.homes.in_pool(t.homed, id, k, at)))), j(at, λ h _ => (match h {
            InSlot(slot) => words.get_or(slot, 0),
            InReg(r) => home_values(g).get_or(r, BitVec::zero()).toNat(),
        }) = env.number(id), held.proof.right.left(id, holds)));
    trans(sym(BitVec::ofNat_toNat(64, read)), cong_fn<Nat, BitVec(64)>(λ n => BitVec::ofNat(n), number))
}

// A word that fits the frame has its slot inside it.
theorem Layout::home_inside(self layout: Layout, id, k: Nat, fits: layout.word_fits(id).IsTrue(), at: layout.homes.home(id) = InSlot(k)): k < layout.words {
    Nat::leb_sound(Succ(k), layout.words, j(at, λ h _ => Bool::IsTrue(match h { InSlot(s) => Succ(s).leb(layout.words), InReg(_) => True }), fits))
}

// A live word's number fits it.
theorem Target::held_number(self t: Target, live: List<Nat>, env: Env, g: Gprs, m: X86Memory(t.r.profile), held: t.Held(live, env, g, m),
    id: Nat, holds: Mem(id, live), inside: t.layout().word_fits(id).IsTrue()): env.word(id).toNat() = env.number(id) {
    let words = held.witness;
    let agrees = held.proof.right.left(id, holds);
    let fits: (env.number(id) < Nat::pow(2, 64)) = (match t.homes.home(id) as λ h => t.homes.home(id) = h →
            (match h { InSlot(slot) => words.get_or(slot, 0), InReg(k) => home_values(g).get_or(k, BitVec::zero()).toNat() }) = env.number(id) →
            env.number(id) < Nat::pow(2, 64) {
        InSlot(k) => λ at number => j(number, λ n _ => n < Nat::pow(2, 64),
            t.layout().keeps_number_fits(env.with_words(words), held.proof.left.witness, held.proof.left.proof.right.left, k, t.layout().home_inside(id, k, inside, at))),
        InReg(k) => λ _ number => j(number, λ n _ => n < Nat::pow(2, 64), BitVec::toNat_lt_pow(64, home_values(g).get_or(k, BitVec::zero()))),
    })(refl, agrees);
    BitVec::toNat_ofNat(64, env.number(id), fits)
}

// ---------------------------------------------------------------------------
// A word written

// Where it is dead after: nothing changes.
theorem Target::held_dead(self t: Target, live, out: List<Nat>, env: Env, id: Nat, w: BitVec(64), g: Gprs, m: X86Memory(t.r.profile),
    held: t.Held(live, env, g, m), sub: (i: Nat) → Mem(i, out) → i ≠ id → Mem(i, live), dead: out.holds(id) = False):
    t.Held(out, env.set_word(id, w), g, m) {
    Exists(held.witness, ⟨held.proof.left, ⟨λ i m2 => {
        let ne: (i ≠ id) = λ e => absurd(trans(sym(dead), out.mem_holds(id, j(e, λ x _ => Mem(x, out), m2))));
        trans(held.proof.right.left(i, sub(i, m2, ne)), sym(env.number_set_other(id, w, i, ne)))
    }, held.proof.right.right⟩⟩)
}

// Another word's number where the written slot is put: the two have two
// slots.
theorem Homes::number_put_other(self homes: Homes, fits: homes.fits().IsTrue(), i, id, slot: Nat, words: List<Nat>, k: Nat,
    values: List<BitVec(64)>, at: homes.home(id) = InSlot(slot), ne: i ≠ id):
    homes.number(i, words.put(slot, k, 0), values) = homes.number(i, words, values) {
    (match at_i: homes.home(i) {
        InSlot(s) => List::put_other(slot, words, k, 0, s, homes.slots_differ(fits, i, id, s, slot, at_i, at, ne)),
        InReg(_) => refl,
    })
}

// Into its slot: the slot's file entry set.
theorem Target::held_slot_set(self t: Target, live, out: List<Nat>, env: Env, id: Nat, w: BitVec(64), g: Gprs, m: X86Memory(t.r.profile),
    held: t.Held(live, env, g, m), sub: (i: Nat) → Mem(i, out) → i ≠ id → Mem(i, live), k: Nat, slot: t.homes.home(id) = InSlot(k), inside: k < t.words):
    t.Held(out, env.set_word(id, w), g, t.r.profile.store(m, t.slot(k), word_bytes(w))) {
    let words = held.witness;
    let words2 = words.put(k, w.toNat(), 0);
    let values = home_values(g);
    Exists(words2, ⟨t.placed_word(env.with_words(words), m, held.proof.left, k, inside, w), ⟨λ i m2 => match i.eq_dec(id) {
        Inl(e) => j(sym(e), λ x _ => t.homes.number(x, words2, values) = env.set_word(id, w).number(x),
            j(sym(slot), λ h _ => (match h { InSlot(slot) => words2.get_or(slot, 0), InReg(k) => values.get_or(k, BitVec::zero()).toNat() }) =
                env.set_word(id, w).number(id),
                trans(words2.get_or_some(k, 0, w.toNat(), List::put_here(k, words, w.toNat(), 0)), sym(env.number_set_here(id, w))))),
        Inr(ne) => trans(t.homes.number_put_other(t.homed, i, id, k, words, w.toNat(), values, slot, ne),
            trans(held.proof.right.left(i, sub(i, m2, ne)), sym(env.number_set_other(id, w, i, ne)))),
    }, held.proof.right.right⟩⟩)
}

// Its slot stored with the number the environment has for it already: the
// word is live there too. A frame's slots start so, one at a time.
theorem Target::held_slot_same(self t: Target, live: List<Nat>, env: Env, id: Nat, w: BitVec(64), g: Gprs, m: X86Memory(t.r.profile),
    held: t.Held(live, env, g, m), k: Nat, slot: t.homes.home(id) = InSlot(k), inside: k < t.words, same: w.toNat() = env.number(id)):
    t.Held(Cons(id, live), env, g, t.r.profile.store(m, t.slot(k), word_bytes(w))) {
    let words = held.witness;
    let words2 = words.put(k, w.toNat(), 0);
    let values = home_values(g);
    Exists(words2, ⟨t.placed_word(env.with_words(words), m, held.proof.left, k, inside, w), ⟨λ i m2 => match i.eq_dec(id) {
        Inl(e) => j(sym(e), λ x _ => t.homes.number(x, words2, values) = env.number(x),
            j(sym(slot), λ h _ => (match h { InSlot(slot) => words2.get_or(slot, 0), InReg(k) => values.get_or(k, BitVec::zero()).toNat() }) = env.number(id),
                trans(words2.get_or_some(k, 0, w.toNat(), List::put_here(k, words, w.toNat(), 0)), same))),
        Inr(ne) => trans(t.homes.number_put_other(t.homed, i, id, k, words, w.toNat(), values, slot, ne),
            held.proof.right.left(i, match m2 { Inl(e) => false_elim(ne(e)), Inr(later) => later })),
    }, held.proof.right.right⟩⟩)
}

// A word written into register `k` misses every other live word's.
theorem Homes::misses_apart(self homes: Homes, id, k: Nat, out: List<Nat>): homes.misses(id, k, out).IsTrue() →
    (i: Nat) → Mem(i, out) → i ≠ id → (r: Nat) → homes.home(i) = InReg(r) → r ≠ k {
    match out {
        Nil => λ _ i never => false_elim(never),
        Cons(other, rest) => λ miss i m ne r at => {
            match m {
                Inl(e) => λ same => {
                    let at_other: (homes.home(other) = InReg(r)) = j(e, λ x _ => homes.home(x) = InReg(r), at);
                    let first: (other.same(id) || !homes.home(other).is_register(k)).IsTrue() = known;
                    let other_ne: (other.same(id) = False) = Nat::same_false(other, id, λ o => ne(trans(e, o)));
                    let not_reg: (!homes.home(other).is_register(k)).IsTrue() = j(other_ne, λ b _ => (b || !homes.home(other).is_register(k)).IsTrue(), first);
                    let reg_false: (homes.home(other).is_register(k) = False) = Bool::false_of_not(homes.home(other).is_register(k), not_reg);
                    let at_k: (InReg(r).is_register(k) = False) = j(at_other, λ h _ => h.is_register(k) = False, reg_false);
                    absurd(trans(sym(at_k), j(same, λ x _ => r.same(x) = True, r.same_self())))
                },
                Inr(later) => homes.misses_apart(id, k, rest, known, i, later, ne, r, at),
            }
        },
    }
}

theorem Homes::apart_misses(self homes: Homes, id, k: Nat, out: List<Nat>, apart: homes.apart(id, out).IsTrue(), at: homes.home(id) = InReg(k)):
    homes.misses(id, k, out).IsTrue() {
    j(at, λ h _ => (match h { InSlot(_) => True, InReg(r) => homes.misses(id, r, out) }).IsTrue(), apart)
}

// What `apart` asks, as a proposition: where the word lives in a register,
// no other word of `set` does.
fn Homes::Apart(self homes: Homes, id: Nat, set: List<Nat>) → Type {
    (k: Nat) → homes.home(id) = InReg(k) → (i: Nat) → Mem(i, set) → i ≠ id → (r: Nat) → homes.home(i) = InReg(r) → r ≠ k
}

theorem Homes::apart_sound(self homes: Homes, id: Nat, set: List<Nat>, apart: homes.apart(id, set).IsTrue()): homes.Apart(id, set) {
    λ k at => homes.misses_apart(id, k, set, homes.apart_misses(id, k, set, apart, at))
}

// …and of any smaller set.
theorem Homes::apart_within(self homes: Homes, id: Nat, set, smaller: List<Nat>, apart: homes.Apart(id, set),
    within: (i: Nat) → Mem(i, smaller) → Mem(i, set)): homes.Apart(id, smaller) {
    λ k at i m => apart(k, at, i, within(i, m))
}

// Into its register: the register set, and every other live word's register
// apart from it.
theorem Target::held_reg_set(self t: Target, live, out: List<Nat>, env: Env, id: Nat, w: BitVec(64), g: Gprs, m: X86Memory(t.r.profile),
    held: t.Held(live, env, g, m), sub: (i: Nat) → Mem(i, out) → i ≠ id → Mem(i, live), k: Nat, at: t.homes.home(id) = InReg(k),
    apart: t.homes.Apart(id, out)): t.Held(out, env.set_word(id, w), write_gpr(home_register(k), w, g), m) {
    let words = held.witness;
    let inside = t.homes.in_pool(t.homed, id, k, at);
    let values = home_values(g).put(k, w, BitVec::zero());
    let written: (home_values(write_gpr(home_register(k), w, g)) = values) = home_values_write(w, g, k, inside);
    let miss = apart(k, at);
    let agrees: t.homes.Agrees(out, env.set_word(id, w), words, values) = λ i m2 => match i.eq_dec(id) {
        Inl(e) => j(sym(e), λ x _ => t.homes.number(x, words, values) = env.set_word(id, w).number(x),
            j(sym(at), λ h _ => (match h { InSlot(slot) => words.get_or(slot, 0), InReg(r) => values.get_or(r, BitVec::zero()).toNat() }) =
                env.set_word(id, w).number(id),
                trans(cong_fn<BitVec(64), Nat>(λ x => x.toNat(), values.get_or_some(k, BitVec::zero(), w,
                    List::put_here(k, home_values(g), w, BitVec::zero()))), sym(env.number_set_here(id, w))))),
        Inr(ne) => trans((match t.homes.home(i) as λ h => t.homes.home(i) = h →
                (match h { InSlot(slot) => words.get_or(slot, 0), InReg(r) => values.get_or(r, BitVec::zero()).toNat() }) =
                (match h { InSlot(slot) => words.get_or(slot, 0), InReg(r) => home_values(g).get_or(r, BitVec::zero()).toNat() }) {
            InSlot(_) => λ _ => refl,
            InReg(r) => λ at_i => cong_fn<BitVec(64), Nat>(λ x => x.toNat(),
                List::put_other(k, home_values(g), w, BitVec::zero(), r, miss(i, m2, ne, r, at_i))),
        })(refl), trans(held.proof.right.left(i, sub(i, m2, ne)), sym(env.number_set_other(id, w, i, ne)))),
    };
    let rsp: (values.get_or(6, BitVec::zero()) = t.frame()) =
        trans(List::put_other(k, home_values(g), w, BitVec::zero(), 6, λ e => false_elim(omega(e, inside))), held.proof.right.right.left);
    let pins: t.Pins(values) = λ r within pinned => trans(List::put_other(k, home_values(g), w, BitVec::zero(), r,
        λ e => absurd(trans(sym(t.homes.pinned_unlived(home_register(k), j(e, λ x _ => t.homes.pinned(home_register(x)) = True, pinned))),
            t.homes.lived(id, k, at)))), held.proof.right.right.right(r, within, pinned));
    j(sym(written), λ vs _ => Exists<List<Nat>>(λ ws => t.Placed(env.set_word(id, w).with_words(ws), m) ∧ t.Agreeing(out, env.set_word(id, w), ws, vs)),
        Exists(words, ⟨held.proof.left, ⟨agrees, ⟨rsp, pins⟩⟩⟩))
}

// What a write to a word's home leaves the rest of the registers: every one
// no word lives in but RBX as it was.
fn Target::Spares(self t: Target, g, g2: Gprs) → Type {
    (x: Gpr) → t.homes.uses(x) = False → Rbx.same(x) = False → read_gpr(x, g2) = read_gpr(x, g)
}

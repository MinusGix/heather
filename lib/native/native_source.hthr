// The effectful source: a control layer over total FunctionIR, whose
// programs denote trees over Linux's calls
// (docs/native/native-effect-source-design.md §7; issues/native-effect-source-compiler.md,
// round S3.1).
//
// A statement computes a FunctionIR region over the environment's words,
// asks Linux a call, runs two statements in sequence, branches on a bit,
// repeats a body while a bit is set, copies a command-line argument into a
// buffer, or exits. `denote` maps each to the tree construct of the same
// shape: a region is `Ret` of its evaluation (`function_ir_eval`), a call is
// `Vis` with the answer decoded into the environment, sequencing is `bind`,
// a loop is `iter`, and an argument and exit are leaves.
// Nothing about the machine is here: the compiler and its theorem (S3.2)
// relate this meaning to code.
//
// The environment is a file of 64-bit words and a file of buffers, each a
// list of bytes: what a uniqueness-threaded buffer denotes. A region sees
// each word at every width as its low bits, and what it writes goes back
// into the file zero-extended from the width it was written at; its byte
// nodes read and write the buffers in place (`function_ir_state`'s `run`).
// A buffer starts as its initial bytes, then zeroes. A call reads
// and writes buffers whole and never faults: a read asks for at most what
// its buffer holds past its offset and lands there, a write sends the span
// its buffer holds, and an open or a stat names the path its buffer holds,
// up to its length or its first NUL. A failed call leaves its errno
// negated in its result word, as Linux leaves it in RAX. The command line is
// part of the environment, read and never written: a program's meaning is a
// family over its arguments (`Source::denote(args)`).
//
// Every loop goes round at most the fuel's number of times, so a program is
// the family of its trees over fuel (`Source::denote`, a `Program`), and
// that family grows (`Stmt::grows`).
//
// A statement may also call one of the source's procedures (`Perform`,
// docs/native/native-procedures-design.md §2). `denote` takes what a call does as
// a parameter (`Performs()`), and the source gives it (`Source::calls`):
// the arguments' numbers copied into the parameters, the body run one call
// deeper, then the procedure's locals given back as the caller had them and
// the results copied out. Words are the callee's own and buffers are
// shared. Calls nest as deep as the fuel, as loops go round as often: the
// source has no depth.
//
// A machine's stack is finite, so the compiled program refuses a call the
// stack has no room for, exiting with `call_depth_status`
// (`Source::performs`, `Source::bounded`). That is the compiled program's meaning, not the
// source's: its theorems are stated over `bounded`, which is the source's
// with the refused runs ended at the refusal (`Source::bounded_traces`,
// docs/native/native-procedure-frames-design.md §7).

import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_placeless;
import linux_calls;
import linux_trees;
import itree;
import itree_trace;
import itree_deep;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// The environment

// A list with its `i`-th entry replaced, `pad` filling it out to `i`.
fn List::put<A>(self xs: List<A>, i: Nat, x: A, pad: A) → List<A> {
    match i {
        Zero => match xs { Nil => [x], Cons(_, rest) => Cons(x, rest) },
        Succ(k) => match xs { Nil => Cons(pad, List::put(Nil, k, x, pad)), Cons(h, rest) => Cons(h, rest.put(k, x, pad)) },
    }
}

// A file of words, by id, each kept as the number it reads as unsigned, and
// of buffers, by id; past its end a file reads zero, or an empty buffer.
// Both are data, not functions, so a word or a buffer is computed once
// however often it is read. The command line, `argv` with argv[0] first,
// is read and never written.
record Env { words: List<Nat>, buffers: List<List<BitVec(8)>>, args: List<List<BitVec(8)>> }

fn Env::number(self env: Env, id: Nat) → Nat {
    match env.words.nth(id) { None => 0, Some(n) => n }
}

fn Env::word(self env: Env, id: Nat) → BitVec(64) { BitVec::ofNat(env.number(id)) }

fn Env::bit(self env: Env, id: Nat) → Bool { env.word(id).head_bit() }

fn Env::buffer(self env: Env, id: Nat) → List<BitVec(8)> {
    match env.buffers.nth(id) { None => Nil, Some(bytes) => bytes }
}

// What a region sees: each word, at every width its low bits.
fn Env::valuation(self env: Env) → Valuation() { λ w id => BitVec::ofNat(env.number(id)) }

fn Env::set_word(self env: Env, id: Nat, word: BitVec(64)) → Env {
    Env(env.words.put(id, word.toNat(), 0), env.buffers, env.args)
}

fn Env::set_buffer(self env: Env, id: Nat, bytes: List<BitVec(8)>) → Env {
    Env(env.words, env.buffers.put(id, bytes, Nil), env.args)
}

// The ports a region writes, each at its width; a call's result is a word.
fn nodes_write_ports(nodes: List<Node>) → List<Port> {
    match nodes { Nil => [], Cons(node, rest) => Cons(node_output(node), nodes_write_ports(rest)) }
}

// The ports a region's run writes, in the order it writes them: a
// conditional's are its taken arm's, read as `run` branches, at the value
// it reads its bit at; a loop's are its outputs and the bit it ends with.
fn StructuredRegion::written(self region: StructuredRegion, call: Writers(), values: Valuation(), buffers: Buffers()) → List<Port> {
    match region {
        Dataflow(body) => nodes_write_ports(body.nodes),
        Sequence(prefix, continuation) => {
            let after = run_nodes(prefix.nodes, values, buffers);
            nodes_write_ports(prefix.nodes) ++ continuation.written(call, after.values, after.buffers)
        },
        Compose(prefix, continuation) => {
            let after = prefix.run(call, values, buffers);
            prefix.written(call, values, buffers) ++ continuation.written(call, after.values, after.buffers)
        },
        Conditional(_, condition, _, _, when_true, when_false) => match values(1, condition).head_bit() {
            False => when_false.written(call, values, buffers),
            True => when_true.written(call, values, buffers),
        },
        Lend(views, _, _, result) => nodes_write_ports(views_nodes(views)) ++ [Port(result, 64)],
        Call(_, _, result, also) => word_ports(Cons(result, also)),
        Loop(_, _, _, _, _, _, _, outputs, exhausted) => word_ports(outputs) ++ [Port(exhausted, 1)],
        Until(_, _, _, _, _, outputs) => word_ports(outputs),
    }
}

// The words a region wrote, read off its valuation at their widths and
// zero-extended into the file.
fn Env::settle(self env: Env, after: Valuation(), ports: List<Port>) → Env {
    match ports {
        Nil => env,
        Cons(port, rest) => Env(env.words.put(port.id, after(port.width, port.id).toNat(), 0), env.buffers, env.args).settle(after, rest),
    }
}

fn Env::compute(self env: Env, call: Writers(), region: StructuredRegion) → Env {
    let after = region.run(call, env.valuation(), env.buffers);
    Env(env.words, after.buffers, env.args).settle(after.values, region.written(call, env.valuation(), env.buffers))
}

// ---------------------------------------------------------------------------
// Calls

// A call to Linux, its operands named by ids in the environment: words, and
// the buffers it reads from or lands in.
inductive CallShape {
    Reads(fd: Nat, buf: Nat, at: Nat, len: Nat, result: Nat),
    Writes(fd: Nat, buf: Nat, from: Nat, len: Nat, result: Nat),
    Opens(path: Nat, len: Nat, result: Nat),
    Closes(fd: Nat, result: Nat),
    StatsPath(path: Nat, len: Nat, out: Nat, result: Nat),
    StatsFd(fd: Nat, out: Nat, result: Nat),
}

fn count_word(n: Nat) → BitVec(64) { BitVec::ofNat(n) }
fn errno_word(errno: Nat) → BitVec(64) { BitVec::ofNat(errno).neg() }

// The `len` bytes of a buffer from `from`, as many as it holds.
fn span(buffer: List<BitVec(8)>, from, len: Nat) → List<BitVec(8)> { buffer.drop(from).take(len) }

// Bytes landed at a buffer's start; the buffer keeps its length.
fn fill(buffer, bytes: List<BitVec(8)>) → List<BitVec(8)> { (bytes ++ buffer.drop(bytes.len())).take(buffer.len()) }

// Bytes landed in a buffer from index `at`, as many as fit past it; the
// buffer keeps its length, and an offset past its end lands nothing.
fn fill_at(buffer: List<BitVec(8)>, at: Nat, bytes: List<BitVec(8)>) → List<BitVec(8)> { buffer.take(at) ++ fill(buffer.drop(at), bytes) }

// At offset 0 it is `fill`.
theorem fill_at_zero(buffer, bytes: List<BitVec(8)>): fill_at(buffer, 0, bytes) = fill(buffer, bytes) {
    match buffer { Nil => refl, Cons(_, _) => refl }
}

// An offset past the end lands as the end does.
theorem fill_at_within(buffer, bytes: List<BitVec(8)>): (at: Nat) → fill_at(buffer, at, bytes) = fill_at(buffer, at.min(buffer.len()), bytes) {
    match buffer {
        Nil => λ at => refl,
        Cons(h, rest) => λ at => match at {
            Zero => refl,
            Succ(k) => List::cong_cons(h, fill_at_within(rest, bytes, k)),
        },
    }
}

// A path's bytes up to its first NUL: what Linux reads of it, a C string
// ending at the NUL (`CStringAt`), so a path the source names past a NUL
// is the part before it.
fn List::before_nul(self bytes: List<BitVec(8)>) → List<BitVec(8)> {
    match bytes {
        Nil => Nil,
        Cons(c, rest) => match c.toNat() { Zero => Nil, Succ(_) => Cons(c, rest.before_nul()) },
    }
}

// What the call asks Linux, read off the environment.
fn CallShape::cmd(self shape: CallShape, env: Env) → LinuxCmd<Nat> {
    match shape {
        Reads(fd, buf, at, len, _) => ReadCmd(env.word(fd), env.number(len).min(env.buffer(buf).len() - env.number(at))),
        Writes(fd, buf, from, len, _) => WriteCmd(env.word(fd), span(env.buffer(buf), env.number(from), env.number(len))),
        Opens(path, len, _) => OpenCmd(env.buffer(path).take(env.number(len)).before_nul()),
        Closes(fd, _) => CloseCmd(env.word(fd)),
        StatsPath(path, len, _, _) => StatCmd(StatPath(env.buffer(path).take(env.number(len)).before_nul())),
        StatsFd(fd, _, _) => StatCmd(StatFd(env.word(fd))),
    }
}

// Linux's answer decoded into the environment, as the machine sees it: a
// count or a descriptor in the result word, or the errno negated; a read's
// or a stat's bytes landed in its buffer.
fn CallShape::answer(self shape: CallShape, env: Env) → shape.cmd(env).Resp() → Env {
    match shape {
        Reads(_, buf, at, _, result) => λ (r: ReadResult) => match r {
            ReadBytes(bytes) => env.set_buffer(buf, fill_at(env.buffer(buf), env.number(at), bytes)).set_word(result, count_word(bytes.len())),
            ReadFailed(errno) => env.set_word(result, errno_word(errno)),
        },
        Writes(_, _, _, _, result) => λ (r: WriteResult) => match r {
            Wrote(count) => env.set_word(result, count_word(count)),
            WriteFailed(errno) => env.set_word(result, errno_word(errno)),
        },
        Opens(_, _, result) => λ (r: OpenResult) => match r {
            Opened(fd) => env.set_word(result, count_word(fd)),
            OpenFailed(errno) => env.set_word(result, errno_word(errno)),
        },
        Closes(_, result) => λ (r: CloseResult) => match r {
            Closed => env.set_word(result, count_word(0)),
            CloseFailed(errno) => env.set_word(result, errno_word(errno)),
        },
        StatsPath(_, _, out, result) => λ (r: StatResult) => match r {
            Stated(st) => env.set_buffer(out, fill(env.buffer(out), st)).set_word(result, count_word(0)),
            StatFailed(errno) => env.set_word(result, errno_word(errno)),
        },
        StatsFd(_, out, result) => λ (r: StatResult) => match r {
            Stated(st) => env.set_buffer(out, fill(env.buffer(out), st)).set_word(result, count_word(0)),
            StatFailed(errno) => env.set_word(result, errno_word(errno)),
        },
    }
}

// ---------------------------------------------------------------------------
// The command line

// The minus one a word holds for an argument past the last.
fn missing_word() → BitVec(64) { BitVec::ofNat(1).neg() }

// Argument `k` (argv[k], argv[0] the program's name) copied to the start of
// buffer `buf`, as much of it as the buffer holds, and its whole length
// into word `len`; past the last argument, `len` minus one and the buffer
// as it was. So a program learns how many arguments it has by asking past
// them, and that an argument was cut by its length.
fn Env::arg(self env: Env, k, buf, len: Nat) → Env {
    match env.args.nth(k) {
        None => env.set_word(len, missing_word()),
        Some(arg) => env.set_buffer(buf, fill(env.buffer(buf), arg)).set_word(len, count_word(arg.len())),
    }
}

// ---------------------------------------------------------------------------
// Statements

inductive Stmt {
    // A total FunctionIR region over the words.
    Compute(region: StructuredRegion),
    // A call to Linux: `Vis`.
    Invoke(call: CallShape),
    // One statement, then the next: `bind`.
    Then(first: Stmt, rest: Stmt),
    // On a one-bit word.
    Branch(condition: Nat, yes: Stmt, no: Stmt),
    // The body, again while the one-bit word `again` is set after it: `iter`.
    Repeat(body: Stmt, again: Nat),
    // Exit with a word's status: a leaf.
    Exit(status: Nat),
    // The argument the word `index` names into buffer `buf`, its length
    // into word `len` (`Env::arg`).
    Arg(index: Nat, buf: Nat, len: Nat),
    // Procedure `procedure` of the source (`Source::procedures`), its
    // parameters given the words `args`, its results put in `results`
    // (`Procedure::enter`, `Procedure::leave`;
    // docs/native/native-procedures-design.md §2).
    Perform(procedure: Nat, args: List<Nat>, results: List<Nat>),
}

// Where a statement leaves the program: on to the next statement, or out.
inductive Flow { Onward(env: Env), Exited(status: BitVec(64)) }

// What a loop does after one pass: round again, out of the loop, or out of
// the program.
fn Flow::pass(self flow: Flow, again: Nat) → Step<Env, Flow> {
    match flow {
        Onward(env) => match env.bit(again) { True => Continue(env), False => Break(Onward(env)) },
        Exited(status) => Break(Exited(status)),
    }
}

// What a call does, given the procedure, its arguments, where its results
// go, and the caller's environment: `Source::performs` at a depth.
fn Performs() → Type { Nat → List<Nat> → List<Nat> → Env → ITree<Flow>(Events::linux()) }

fn Stmt::denote(self s: Stmt, call: Writers(), perform: Performs(), n: Nat, env: Env) → ITree<Flow>(Events::linux()) {
    match s {
        Compute(region) => Ret(Onward(env.compute(call, region))),
        Invoke(shape) => Vis(shape.cmd(env), λ a => Ret(Onward(shape.answer(env, a)))),
        Then(first, rest) => ITree::bind(Events::linux(), first.denote(call, perform, n, env), λ flow => match flow {
            Onward(next) => rest.denote(call, perform, n, next),
            Exited(status) => Ret(Exited(status)),
        }),
        Branch(condition, yes, no) => match env.bit(condition) {
            True => yes.denote(call, perform, n, env),
            False => no.denote(call, perform, n, env),
        },
        Repeat(body, again) => ITree::iter(Events::linux(), n,
            λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)), env),
        Exit(status) => Ret(Exited(env.word(status))),
        Arg(index, buf, len) => Ret(Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => perform(procedure, args, results, env),
    }
}

// One handler below another at every call: more fuel, or the same.
fn performs_below(perform, perform2: Performs()) → Type {
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
        ITree::Below(Events::linux(), perform(procedure, args, results, env), perform2(procedure, args, results, env))
}

// More fuel grows a statement's tree, where a call's tree grows.
theorem Stmt::grows(self s: Stmt, call: Writers(), perform, perform2: Performs(), below: performs_below(perform, perform2), n: Nat): (env: Env) →
    ITree::Below(Events::linux(), s.denote(call, perform, n, env), s.denote(call, perform2, n + 1, env)) {
    match s {
        Compute(_) => λ env => refl,
        Invoke(shape) => λ env => ITree::below_refl(Events::linux(), Vis(shape.cmd(env), λ a => Ret(Onward(shape.answer(env, a))))),
        Then(first, rest) => λ env => ITree::below_bind(Events::linux(), first.denote(call, perform, n, env), first.denote(call, perform2, n + 1, env),
            λ flow => match flow { Onward(next) => rest.denote(call, perform, n, next), Exited(status) => Ret(Exited(status)) },
            λ flow => match flow { Onward(next) => rest.denote(call, perform2, n + 1, next), Exited(status) => Ret(Exited(status)) },
            first.grows(call, perform, perform2, below, n, env),
            λ flow => match flow {
                Onward(e) => rest.grows(call, perform, perform2, below, n, e),
                Exited(_) => refl,
            }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b =>
                ITree::Below(Events::linux(), match b as λ _ => ITree<Flow>(Events::linux()) { True => yes.denote(call, perform, n, env), False => no.denote(call, perform, n, env) },
                    match b { True => yes.denote(call, perform2, n + 1, env), False => no.denote(call, perform2, n + 1, env) }) {
            True => yes.grows(call, perform, perform2, below, n, env),
            False => no.grows(call, perform, perform2, below, n, env),
        },
        Repeat(body, again) => λ env => ITree::iter_below(Events::linux(), n,
            λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)),
            λ e => ITree::map(Events::linux(), body.denote(call, perform2, n + 1, e), λ flow => flow.pass(again)),
            λ e => ITree::below_bind(Events::linux(), body.denote(call, perform, n, e), body.denote(call, perform2, n + 1, e),
                λ flow => Ret(flow.pass(again)), λ flow => Ret(flow.pass(again)), body.grows(call, perform, perform2, below, n, e), λ flow => refl),
            env),
        Exit(_) => λ env => refl,
        Arg(_, _, _) => λ env => refl,
        Perform(procedure, args, results) => λ env => below(procedure, args, results, env),
    }
}

// ---------------------------------------------------------------------------
// Procedures (docs/native/native-procedures-design.md)

// Its parameters and results, words of its own, and its body.
record Procedure { params: List<Nat>, results: List<Nat>, body: Stmt }

// The words `ids` set to `words` in order, as far as both go.
fn Env::set_words(self env: Env, ids: List<Nat>, words: List<BitVec(64)>) → Env {
    match ids {
        Nil => env,
        Cons(id, rest) => match words {
            Nil => env,
            Cons(word, more) => env.set_word(id, word).set_words(rest, more),
        },
    }
}

// The words, in order.
fn Env::words_at(self env: Env, ids: List<Nat>) → List<BitVec(64)> {
    match ids { Nil => [], Cons(id, rest) => Cons(env.word(id), env.words_at(rest)) }
}

// The callee starts with every word zero but its parameters, each given its
// argument's word, all read before any is set; the buffers and the command
// line are the caller's.
fn Procedure::enter(self proc: Procedure, caller: Env, args: List<Nat>) → Env {
    Env(Nil, caller.buffers, caller.args).set_words(proc.params, caller.words_at(args))
}

// It returns to the caller's words with its own buffers, each result
// copied out to its word; an exit goes on out.
fn Procedure::leave(self proc: Procedure, caller: Env, results: List<Nat>, flow: Flow) → Flow {
    match flow {
        Onward(after) => Onward(Env(caller.words, after.buffers, caller.args).set_words(results, after.words_at(proc.results))),
        Exited(status) => Exited(status),
    }
}

// The status a refused call exits with: what a
// shell reports for a process killed by SIGSEGV, the usual end of a stack
// overflow.
fn call_depth_status() → BitVec(64) { BitVec::ofNat(139) }

// ---------------------------------------------------------------------------
// Programs

// A buffer: how many bytes it holds, and the bytes it starts with from
// index 0; those past its capacity are dropped (`Source::start`).
record Buffer { capacity: Nat, initial: List<BitVec(8)> := [] }

// Total functions its regions call, its buffers (buffer `b` is the `b`-th),
// how many words it names (word ids below `words`; the compiler gives each
// a slot and refuses any other), and the statement it runs.
// Its procedures (procedure `p` is the `p`-th), and how many levels of
// calls that can nest without bound (those the compiler checks) the
// compiled program has room for below `main`'s frame, past what `main`'s
// own calls take (`Source::left`, §7.4; the source's own meaning has no
// stack).
record Source { functions: List<Function>, buffers: List<Buffer>, words: Nat, main: Stmt,
    procedures: List<Procedure> := [], levels: Nat := 0 }

// The words a call names: every operand but its buffers.
fn CallShape::words(self shape: CallShape) → List<Nat> {
    match shape {
        Reads(fd, _, at, len, result) => [fd, at, len, result],
        Writes(fd, _, from, len, result) => [fd, from, len, result],
        Opens(_, len, result) => [len, result],
        Closes(fd, result) => [fd, result],
        StatsPath(_, len, _, result) => [len, result],
        StatsFd(fd, _, result) => [fd, result],
    }
}

// One past the largest id: the words a statement naming `ids` needs.
fn List::word_bound(self ids: List<Nat>) → Nat { match ids { Nil => 0, Cons(id, rest) => (id + 1).max(rest.word_bound()) } }

// Every id a region names, a loop's own words and its body's with them.
fn StructuredRegion::ids(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => nodes_mentions(body.nodes),
        Sequence(prefix, continuation) => nodes_mentions(prefix.nodes) ++ continuation.ids(),
        Compose(prefix, continuation) => prefix.ids() ++ continuation.ids(),
        Conditional(_, condition, _, _, when_true, when_false) => Cons(condition, when_true.ids() ++ when_false.ids()),
        Lend(views, _, arguments, result) => nodes_mentions(views_nodes(views)) ++ Cons(result, views_homes(views) ++ arguments),
        Call(_, arguments, result, also) => Cons(result, also ++ arguments),
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) =>
            Cons(bound, Cons(count, Cons(exit, Cons(exhausted, inputs ++ (parameters ++ (next ++ (outputs ++ body.ids()))))))),
        Until(inputs, parameters, body, exit, next, outputs) => Cons(exit, inputs ++ (parameters ++ (next ++ (outputs ++ body.ids())))),
    }
}

// One past the largest word a statement names: what a source of it
// declares (`Source::words`, `Source::of`) when every word it names gets a
// slot.
fn Stmt::word_bound(self s: Stmt) → Nat {
    match s {
        Compute(region) => region.ids().word_bound(),
        Invoke(shape) => shape.words().word_bound(),
        Then(first, rest) => first.word_bound().max(rest.word_bound()),
        Branch(condition, yes, no) => (condition + 1).max(yes.word_bound().max(no.word_bound())),
        Repeat(body, again) => (again + 1).max(body.word_bound()),
        Exit(status) => status + 1,
        Arg(index, _, len) => (index + 1).max(len + 1),
        Perform(_, args, results) => (args ++ results).word_bound(),
    }
}

// A source with no functions whose words are the ones `main` names.
fn Source::of(buffers: List<Buffer>, main: Stmt) → Source { Source(functions := [], buffers := buffers, words := main.word_bound(), main := main) }

fn zero_byte() → BitVec(8) { BitVec::zero() }

fn Source::capacities(self src: Source) → List<Nat> { src.buffers.map(λ (b: Buffer) => b.capacity) }

// Bytes stored into buffer `buf` of a file one at a time, from index `i`.
fn List::stored(self bytes: List<BitVec(8)>, buf, i: Nat, file: Buffers()) → Buffers() {
    match bytes { Nil => file, Cons(c, rest) => rest.stored(buf, i + 1, store_byte(file, buf, i, c)) }
}

// Each buffer's initial bytes stored, buffer `buf` first.
fn initial_stores(buffers: List<Buffer>, buf: Nat, file: Buffers()) → Buffers() {
    match buffers { Nil => file, Cons(b, rest) => initial_stores(rest, buf + 1, b.initial.stored(buf, 0, file)) }
}

// Words all zero; each buffer its capacity of zero bytes, then its initial
// bytes stored; the command line `args`.
fn Source::start(self src: Source, args: List<List<BitVec(8)>>) → Env {
    Env(Nil, initial_stores(src.buffers, 0, src.capacities().map(λ size => List::replicate(zero_byte(), size))), args)
}

// Running off the end exits 0.
fn Flow::status(self flow: Flow) → BitVec(64) {
    match flow { Onward(_) => BitVec::zero(), Exited(status) => status }
}

// What the compiled program charges a call of each procedure (§7.2 of
// docs/native/native-procedure-frames-design.md): the bytes the call takes
// of the stack (`cost`: the return address, the registers the callee saves
// and its frame), and for a procedure entered with a check the bytes the
// check asks to be left (`check`: what the callee takes before another
// check can refuse). The compiler works both out from its placement.
record Charges { cost: Nat → Nat, check: Nat → Option<Nat> }

// Charges that take nothing and check nothing: what reading a source that
// performs nothing asks.
fn Charges::free() → Charges { Charges(λ _ => 0, λ _ => None) }

// Whether a call of `procedure` with `left` bytes left is refused.
fn Charges::refuses(self ch: Charges, procedure: Nat, left: Nat) → Bool {
    match ch.check(procedure) { None => False, Some(need) => Succ(left).leb(need) }
}

// What a call does in the compiled program, at fuel `n` with `d` levels of
// calls left and `left` bytes of stack: a silent step (the CALL), then the
// procedure's body with the call's cost taken, entered and left as the
// procedure says; or, where its check finds too few bytes, a refusal, an
// exit with `call_depth_status` before the body does anything. Past `d`
// levels nothing is claimed (a `Cut`, the fuel). A call to no procedure
// does nothing (the compile refuses it).
fn Source::performs(self src: Source, call: Writers(), n, d: Nat, ch: Charges, left: Nat) → Performs() {
    match d {
        Zero => λ procedure args results env => Cut,
        Succ(k) => λ procedure args results env => Tau(match src.procedures.nth(procedure) {
            None => Ret(Onward(env)),
            Some(proc) => match ch.refuses(procedure, left) {
                True => Ret(Exited(call_depth_status())),
                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                    λ flow => proc.leave(env, results, flow)),
            },
        }),
    }
}

// More fuel and one more level grow every call's tree.
theorem Source::performs_grows(self src: Source, call: Writers(), n, d: Nat, ch: Charges, left: Nat):
    performs_below(src.performs(call, n, d, ch, left), src.performs(call, n + 1, Succ(d), ch, left)) {
    match d {
        Zero => λ procedure args results env => trivial,
        Succ(k) => λ procedure args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => match ch.refuses(procedure, left) {
                    True => Ret(Exited(call_depth_status())),
                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n + 1, Succ(k), ch, left - ch.cost(procedure)), n + 1, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
            }, refl,
            match src.procedures.nth(procedure) as λ o =>
                ITree::Below(Events::linux(),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => match ch.refuses(procedure, left) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => match ch.refuses(procedure, left) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n + 1, Succ(k), ch, left - ch.cost(procedure)), n + 1, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    }) {
                None => refl,
                Some(proc) => match ch.refuses(procedure, left) as λ b =>
                        ITree::Below(Events::linux(),
                            match b as λ _ => ITree<Flow>(Events::linux()) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                            match b {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n + 1, Succ(k), ch, left - ch.cost(procedure)), n + 1, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            }) {
                    True => refl,
                    False => ITree::below_bind(Events::linux(),
                        proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        proc.body.denote(call, src.performs(call, n + 1, Succ(k), ch, left - ch.cost(procedure)), n + 1, proc.enter(env, args)),
                        λ flow => Ret(proc.leave(env, results, flow)), λ flow => Ret(proc.leave(env, results, flow)),
                        proc.body.grows(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), src.performs(call, n + 1, Succ(k), ch, left - ch.cost(procedure)),
                            src.performs_grows(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        λ flow => refl),
                },
            }),
    }
}

// What a call does in the source, at fuel `n` with `depth` levels of calls
// left: a silent step, then the procedure's body, its own calls one level
// less, as `Source::performs` but never refused; past the depth nothing is
// claimed, a `Cut`, as a loop past its fuel. The source's meaning lets
// calls nest as deep as its fuel (`Source::main_tree`), so it has no depth
// of its own.
fn Source::calls(self src: Source, call: Writers(), n: Nat, depth: Nat) → Performs() {
    match depth {
        Zero => λ procedure args results env => Cut,
        Succ(d) => λ procedure args results env => Tau(match src.procedures.nth(procedure) {
            None => Ret(Onward(env)),
            Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, d), n, proc.enter(env, args)),
                λ flow => proc.leave(env, results, flow)),
        }),
    }
}

// More fuel and one more level grow every call's tree.
theorem Source::calls_grows(self src: Source, call: Writers(), n: Nat, depth: Nat):
    performs_below(src.calls(call, n, depth), src.calls(call, n + 1, Succ(depth))) {
    match depth {
        Zero => λ procedure args results env => trivial,
        Succ(d) => λ procedure args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n + 1, Succ(d)), n + 1, proc.enter(env, args)),
                    λ flow => proc.leave(env, results, flow)),
            }, refl,
            match src.procedures.nth(procedure) as λ o =>
                ITree::Below(Events::linux(),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, d), n, proc.enter(env, args)),
                            λ flow => proc.leave(env, results, flow)),
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n + 1, Succ(d)), n + 1, proc.enter(env, args)),
                            λ flow => proc.leave(env, results, flow)),
                    }) {
                None => refl,
                Some(proc) => ITree::below_bind(Events::linux(),
                    proc.body.denote(call, src.calls(call, n, d), n, proc.enter(env, args)),
                    proc.body.denote(call, src.calls(call, n + 1, Succ(d)), n + 1, proc.enter(env, args)),
                    λ flow => Ret(proc.leave(env, results, flow)), λ flow => Ret(proc.leave(env, results, flow)),
                    proc.body.grows(call, src.calls(call, n, d), src.calls(call, n + 1, Succ(d)), src.calls_grows(call, n, d), n, proc.enter(env, args)),
                    λ flow => refl),
            }),
    }
}

// `main` at fuel `n`, its calls nesting as deep as the fuel.
fn Source::main_tree(self src: Source, args: List<List<BitVec(8)>>, n: Nat) → ITree<Flow>(Events::linux()) {
    src.main.denote(program_writers(src.functions), src.calls(program_writers(src.functions), n, n), n, src.start(args))
}

fn Source::tree(self src: Source, args: List<List<BitVec(8)>>, n: Nat) → ITree<BitVec(64)>(Events::linux()) {
    ITree::map(Events::linux(), src.main_tree(args, n), λ flow => flow.status())
}

// The program run with the command line `args`.
fn Source::denote(self src: Source, args: List<List<BitVec(8)>>) → Program<BitVec(64)>(Events::linux()) {
    Program(λ n => src.tree(args, n), λ n => ITree::below_bind(Events::linux(),
        src.main_tree(args, n), src.main_tree(args, n + 1),
        λ flow => Ret(flow.status()), λ flow => Ret(flow.status()),
        src.main.grows(program_writers(src.functions), src.calls(program_writers(src.functions), n, n),
            src.calls(program_writers(src.functions), Succ(n), Succ(n)), src.calls_grows(program_writers(src.functions), n, n),
            n, src.start(args)), λ flow => refl))
}

// The compiled program's meaning: `main` at fuel `n`, its calls nesting as
// deep as the fuel and charged as `ch` says, `left` bytes of stack below
// `main`'s frame (`Source::performs`). The compiled program's theorems are
// stated over it; `Source::bounded_refuses` and `Source::bounded_exact` say
// how it stands to the source's own.
fn Source::bounded_main(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n: Nat) → ITree<Flow>(Events::linux()) {
    src.main.denote(program_writers(src.functions), src.performs(program_writers(src.functions), n, n, ch, left), n, src.start(args))
}

fn Source::bounded_tree(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n: Nat) → ITree<BitVec(64)>(Events::linux()) {
    ITree::map(Events::linux(), src.bounded_main(args, ch, left, n), λ flow => flow.status())
}

fn Source::bounded(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left: Nat) → Program<BitVec(64)>(Events::linux()) {
    Program(λ n => src.bounded_tree(args, ch, left, n), λ n => ITree::below_bind(Events::linux(),
        src.bounded_main(args, ch, left, n), src.bounded_main(args, ch, left, Succ(n)),
        λ flow => Ret(flow.status()), λ flow => Ret(flow.status()),
        src.main.grows(program_writers(src.functions), src.performs(program_writers(src.functions), n, n, ch, left),
            src.performs(program_writers(src.functions), Succ(n), Succ(n), ch, left), src.performs_grows(program_writers(src.functions), n, n, ch, left),
            n, src.start(args)), λ flow => refl))
}

// ---------------------------------------------------------------------------
// Deep cuts (issues/native-compile-co-sim.md): the only cuts are loops' at
// fuel `n`, each round behind a silent step, so at fuel `n` every cut lies
// `n` silent steps deep. A run that pays for silent steps
// (`linux_x86_64_sim_paid`) and takes fewer steps than the fuel never meets
// one.

// A statement at fuel `n` whose calls' cuts lie `d` deep, `d` at most `n`:
// its own cuts lie `d` deep.
theorem Stmt::deep(self s: Stmt, call: Writers(), perform: Performs(), n, d: Nat, le: d <= n,
    calls: (procedure: Nat) → (args, results: List<Nat>) → (env: Env) → ITree::Deep(Events::linux(), perform(procedure, args, results, env), d)):
    (env: Env) → ITree::Deep(Events::linux(), s.denote(call, perform, n, env), d) {
    match s {
        Compute(_) => λ env => trivial,
        Invoke(_) => λ env => λ a => trivial,
        Then(first, rest) => λ env => ITree::deep_bind<Flow, Flow>(Events::linux(), first.denote(call, perform, n, env),
            λ flow => match flow { Onward(next) => rest.denote(call, perform, n, next), Exited(status) => Ret(Exited(status)) },
            d, first.deep(call, perform, n, d, le, calls, env),
            λ flow => match flow as λ f => ITree::Deep(Events::linux(), match f as λ _ => ITree<Flow>(Events::linux()) {
                    Onward(next) => rest.denote(call, perform, n, next),
                    Exited(status) => Ret(Exited(status)),
                }, d) {
                Onward(next) => rest.deep(call, perform, n, d, le, calls, next),
                Exited(_) => trivial,
            }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b =>
                ITree::Deep(Events::linux(), match b as λ _ => ITree<Flow>(Events::linux()) {
                    True => yes.denote(call, perform, n, env),
                    False => no.denote(call, perform, n, env),
                }, d) {
            True => yes.deep(call, perform, n, d, le, calls, env),
            False => no.deep(call, perform, n, d, le, calls, env),
        },
        Repeat(body, again) => λ env => ITree::deep_iter_le<Env, Flow>(Events::linux(), n,
            λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)), d, le,
            λ e => ITree::deep_map<Flow, Step<Env, Flow>>(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again), d,
                body.deep(call, perform, n, d, le, calls, e)), env),
        Exit(_) => λ env => trivial,
        Arg(_, _, _) => λ env => trivial,
        Perform(procedure, args, results) => λ env => calls(procedure, args, results, env),
    }
}

// A call `d` levels from the fuel's end: each level behind its silent step,
// so its cuts lie `d` deep.
theorem Source::performs_deep(self src: Source, call: Writers(), n, d: Nat, le: d <= n, ch: Charges, left: Nat):
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
    ITree::Deep(Events::linux(), src.performs(call, n, d, ch, left)(procedure, args, results, env), d) {
    match d {
        Zero => λ procedure args results env => refl,
        Succ(k) => λ procedure args results env => {
            let le_k: (k <= n) = Nat::le_trans(k, Succ(k), n, Succ(k).pred_le(), le);
            match src.procedures.nth(procedure) as λ o =>
                    ITree::Deep(Events::linux(), match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => match ch.refuses(procedure, left) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    }, k) {
                None => trivial,
                Some(proc) => match ch.refuses(procedure, left) as λ b =>
                        ITree::Deep(Events::linux(), match b as λ _ => ITree<Flow>(Events::linux()) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        }, k) {
                    True => trivial,
                    False => ITree::deep_map<Flow, Flow>(Events::linux(),
                        proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow), k,
                        proc.body.deep(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, k, le_k,
                            src.performs_deep(call, n, k, le_k, ch, left - ch.cost(procedure)), proc.enter(env, args))),
                },
            }
        },
    }
}

// The compiled program's meaning deepens: at fuel `d` its cuts lie `d` deep.
theorem Source::bounded_deepens(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left: Nat):
    Program::Deepens(Events::linux(), src.bounded(args, ch, left)) {
    λ d => Exists(d, ITree::deep_map<Flow, BitVec(64)>(Events::linux(), src.bounded_main(args, ch, left, d), λ flow => flow.status(), d,
        src.main.deep(program_writers(src.functions), src.performs(program_writers(src.functions), d, d, ch, left), d, d, d.le_refl(),
            src.performs_deep(program_writers(src.functions), d, d, d.le_refl(), ch, left), src.start(args))))
}

// ---------------------------------------------------------------------------
// The compiled meaning against the source's
// (docs/native/native-procedure-frames-design.md §7)
//
// The compiled program refuses a call past the source's `depth`
// (`Source::bounded`); the source has no depth (`Source::denote`). A
// compiled tree is the source's at as much fuel, with the runs it refuses
// ended at the refusal (`Source::bounded_refuses`, `ITree::Refuses`): a
// refusal is at a call, before the callee does anything, and what came
// before it is the source's (`Source::bounded_traces`). With a depth at
// least the fuel nothing is refused (`Source::bounded_exact`), and a source
// that performs nothing is never refused (`Source::bounded_of_none`).

// The procedures a statement performs, one entry a call.
fn Stmt::performed(self s: Stmt) → List<Nat> {
    match s {
        Then(first, rest) => first.performed() ++ rest.performed(),
        Branch(_, yes, no) => yes.performed() ++ no.performed(),
        Repeat(body, _) => body.performed(),
        Perform(index, _, _) => [index],
        Compute(_) => [],
        Invoke(_) => [],
        Exit(_) => [],
        Arg(_, _, _) => [],
    }
}

// A flow that ends a run at a stop: an exit with a status `stop` holds of.
fn Flow::stops(stop: BitVec(64) → Type) → Flow → Type {
    λ flow => match flow { Onward(_) => False, Exited(status) => stop(status) }
}

// What a refusal exits with.
fn refused_status() → BitVec(64) → Type { λ status => status = call_depth_status() }

// A statement refuses where its calls do, with as much fuel or more.
theorem Stmt::refuses(self s: Stmt, call: Writers(), perform, perform2: Performs(), stop: BitVec(64) → Type, n, m: Nat, le: n <= m,
    hp: (procedure: Nat) → Mem(procedure, s.performed()) → (args, results: List<Nat>) → (env: Env) →
        ITree::Refuses(Events::linux(), Flow::stops(stop), perform(procedure, args, results, env), perform2(procedure, args, results, env))): (env: Env) →
    ITree::Refuses(Events::linux(), Flow::stops(stop), s.denote(call, perform, n, env), s.denote(call, perform2, m, env)) {
    match s {
        Compute(_) => λ env => Inr(refl),
        Invoke(shape) => λ env => SameVis(λ a => Ret(Onward(shape.answer(env, a))), refl, λ a => Inr(refl)),
        Then(first, rest) => λ env => ITree::refuses_bind(Events::linux(), Flow::stops(stop), Flow::stops(stop),
            first.denote(call, perform, n, env), first.denote(call, perform2, m, env),
            λ flow => match flow { Onward(next) => rest.denote(call, perform, n, next), Exited(status) => Ret(Exited(status)) },
            λ flow => match flow { Onward(next) => rest.denote(call, perform2, m, next), Exited(status) => Ret(Exited(status)) },
            first.refuses(call, perform, perform2, stop, n, m, le, λ procedure mem => hp(procedure, first.performed().mem_append_l(rest.performed(), procedure, mem)), env),
            λ flow => match flow {
                Onward(next) => rest.refuses(call, perform, perform2, stop, n, m, le,
                    λ procedure mem => hp(procedure, first.performed().mem_append_r(rest.performed(), procedure, mem)), next),
                Exited(_) => Inr(refl),
            },
            λ flow => match flow {
                Onward(_) => λ never v => false_elim(never),
                Exited(_) => λ stops v => Inl(stops),
            }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b =>
                ITree::Refuses(Events::linux(), Flow::stops(stop),
                    match b as λ _ => ITree<Flow>(Events::linux()) { True => yes.denote(call, perform, n, env), False => no.denote(call, perform, n, env) },
                    match b { True => yes.denote(call, perform2, m, env), False => no.denote(call, perform2, m, env) }) {
            True => yes.refuses(call, perform, perform2, stop, n, m, le,
                λ procedure mem => hp(procedure, yes.performed().mem_append_l(no.performed(), procedure, mem)), env),
            False => no.refuses(call, perform, perform2, stop, n, m, le,
                λ procedure mem => hp(procedure, yes.performed().mem_append_r(no.performed(), procedure, mem)), env),
        },
        Repeat(body, again) => λ env => ITree::iter_refuses(Events::linux(), Flow::stops(stop),
            λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)),
            λ e => ITree::map(Events::linux(), body.denote(call, perform2, m, e), λ flow => flow.pass(again)),
            λ e => ITree::refuses_map(Events::linux(), Flow::stops(stop), Step::stops<Env, Flow>(Flow::stops(stop)),
                body.denote(call, perform, n, e), body.denote(call, perform2, m, e), λ flow => flow.pass(again),
                body.refuses(call, perform, perform2, stop, n, m, le, hp, e),
                λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops }),
            n, m, le, env),
        Exit(_) => λ env => Inr(refl),
        Arg(_, _, _) => λ env => Inr(refl),
        Perform(procedure, args, results) => λ env => hp(procedure, Inl(refl), args, results, env),
    }
}

// A statement grows with its fuel where its calls grow: a refusal at stops
// that never hold.
theorem Stmt::below_le(self s: Stmt, call: Writers(), perform, perform2: Performs(), below: performs_below(perform, perform2), n, m: Nat, le: n <= m,
    env: Env): ITree::Below(Events::linux(), s.denote(call, perform, n, env), s.denote(call, perform2, m, env)) {
    ITree::below_of_refuses_never<Flow>(Events::linux(), Flow::stops(λ _ => False),
        λ flow => match flow as λ f => Flow::stops(λ _ => False, f) → False { Onward(_) => λ never => never, Exited(_) => λ never => never },
        s.denote(call, perform, n, env), s.denote(call, perform2, m, env),
        s.refuses(call, perform, perform2, λ _ => False, n, m, le,
            λ procedure _ args results env2 => ITree::refuses_of_below(Events::linux(), Flow::stops(λ _ => False),
                perform(procedure, args, results, env2), perform2(procedure, args, results, env2), below(procedure, args, results, env2)), env))
}

// A compiled call grows with its fuel and its levels.
theorem Source::performs_below_le(self src: Source, call: Writers(), n, m: Nat, le: n <= m, d, e: Nat, deeper: d <= e, ch: Charges, left: Nat):
    performs_below(src.performs(call, n, d, ch, left), src.performs(call, m, e, ch, left)) {
    match d {
        Zero => λ procedure args results env => trivial,
        Succ(k) => match e {
            Zero => false_elim(deeper),
            Succ(k2) => λ procedure args results env => SameTau(
                match src.procedures.nth(procedure) {
                    None => Ret(Onward(env)),
                    Some(proc) => match ch.refuses(procedure, left) {
                        True => Ret(Exited(call_depth_status())),
                        False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, m, k2, ch, left - ch.cost(procedure)), m, proc.enter(env, args)),
                            λ flow => proc.leave(env, results, flow)),
                    },
                }, refl,
                match src.procedures.nth(procedure) as λ o =>
                    ITree::Below(Events::linux(),
                        match o as λ _ => ITree<Flow>(Events::linux()) {
                            None => Ret(Onward(env)),
                            Some(proc) => match ch.refuses(procedure, left) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                        },
                        match o {
                            None => Ret(Onward(env)),
                            Some(proc) => match ch.refuses(procedure, left) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, m, k2, ch, left - ch.cost(procedure)), m, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                        }) {
                    None => refl,
                    Some(proc) => match ch.refuses(procedure, left) as λ b =>
                            ITree::Below(Events::linux(),
                                match b as λ _ => ITree<Flow>(Events::linux()) {
                                    True => Ret(Exited(call_depth_status())),
                                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                        λ flow => proc.leave(env, results, flow)),
                                },
                                match b as λ _ => ITree<Flow>(Events::linux()) {
                                    True => Ret(Exited(call_depth_status())),
                                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, m, k2, ch, left - ch.cost(procedure)), m, proc.enter(env, args)),
                                        λ flow => proc.leave(env, results, flow)),
                                }) {
                        True => refl,
                        False => ITree::below_bind(Events::linux(),
                            proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                            proc.body.denote(call, src.performs(call, m, k2, ch, left - ch.cost(procedure)), m, proc.enter(env, args)),
                            λ flow => Ret(proc.leave(env, results, flow)), λ flow => Ret(proc.leave(env, results, flow)),
                            proc.body.below_le(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), src.performs(call, m, k2, ch, left - ch.cost(procedure)),
                                src.performs_below_le(call, n, m, le, k, k2, deeper, ch, left - ch.cost(procedure)), n, m, le, proc.enter(env, args)),
                            λ flow => refl),
                    },
                }),
        },
    }
}

// A compiled call refuses where the source's goes on: where its check
// finds too few bytes, or below a call that does.
theorem Source::performs_refuses(self src: Source, call: Writers(), n, m: Nat, le: n <= m, d, e: Nat, deeper: d <= e, ch: Charges, left: Nat):
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
    ITree::Refuses(Events::linux(), Flow::stops(refused_status()), src.performs(call, n, d, ch, left)(procedure, args, results, env),
        src.calls(call, m, e)(procedure, args, results, env)) {
    match d {
        Zero => λ procedure args results env => trivial,
        Succ(k) => match e {
            Zero => false_elim(deeper),
            Succ(k2) => λ procedure args results env => SameTau(
                match src.procedures.nth(procedure) {
                    None => Ret(Onward(env)),
                    Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, m, k2), m, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                }, refl,
                match src.procedures.nth(procedure) as λ o =>
                    ITree::Refuses(Events::linux(), Flow::stops(refused_status()),
                        match o as λ _ => ITree<Flow>(Events::linux()) {
                            None => Ret(Onward(env)),
                            Some(proc) => match ch.refuses(procedure, left) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                        },
                        match o {
                            None => Ret(Onward(env)),
                            Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, m, k2), m, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        }) {
                    None => Inr(refl),
                    Some(proc) => match ch.refuses(procedure, left) as λ b =>
                            ITree::Refuses(Events::linux(), Flow::stops(refused_status()),
                                match b as λ _ => ITree<Flow>(Events::linux()) {
                                    True => Ret(Exited(call_depth_status())),
                                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                        λ flow => proc.leave(env, results, flow)),
                                },
                                ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, m, k2), m, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow))) {
                        True => Inl(refl),
                        False => ITree::refuses_map(Events::linux(), Flow::stops(refused_status()), Flow::stops(refused_status()),
                            proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                            proc.body.denote(call, src.calls(call, m, k2), m, proc.enter(env, args)), λ flow => proc.leave(env, results, flow),
                            proc.body.refuses(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), src.calls(call, m, k2), refused_status(), n, m, le,
                                λ p _ => src.performs_refuses(call, n, m, le, k, k2, deeper, ch, left - ch.cost(procedure), p), proc.enter(env, args)),
                            λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops }),
                    },
                }),
        },
    }
}

// Every call within `d` levels finds the bytes its check asks for: the
// chains of calls a run can make in `d` levels fit in `left`.
fn Source::Roomy(self src: Source, ch: Charges, d: Nat, left: Nat) → Type {
    match d {
        Zero => True,
        Succ(k) => (procedure: Nat) → (ch.refuses(procedure, left) = False) ∧ src.Roomy(ch, k, left - ch.cost(procedure)),
    }
}

// Where every call fits, a source call is below the compiled one: nothing
// refused.
theorem Source::calls_refuses(self src: Source, call: Writers(), n, d: Nat, ch: Charges, left: Nat): src.Roomy(ch, d, left) →
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
    ITree::Refuses(Events::linux(), Flow::stops(λ _ => False), src.calls(call, n, d)(procedure, args, results, env),
        src.performs(call, n, d, ch, left)(procedure, args, results, env)) {
    match d {
        Zero => λ roomy procedure args results env => trivial,
        Succ(k) => λ roomy procedure args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => match ch.refuses(procedure, left) {
                    True => Ret(Exited(call_depth_status())),
                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
            }, refl,
            match src.procedures.nth(procedure) as λ o =>
                ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, k), n, proc.enter(env, args)),
                            λ flow => proc.leave(env, results, flow)),
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => match ch.refuses(procedure, left) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    }) {
                None => Inr(refl),
                Some(proc) => (match ch.refuses(procedure, left) as λ b => (b = False) →
                        ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                            ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, k), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                            match b as λ _ => ITree<Flow>(Events::linux()) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            }) {
                    True => λ never => absurd(never),
                    False => λ _ => ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), Flow::stops(λ _ => False),
                        proc.body.denote(call, src.calls(call, n, k), n, proc.enter(env, args)),
                        proc.body.denote(call, src.performs(call, n, k, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow),
                        proc.body.refuses(call, src.calls(call, n, k), src.performs(call, n, k, ch, left - ch.cost(procedure)), λ _ => False, n, n, n.le_refl(),
                            λ p _ => src.calls_refuses(call, n, k, ch, left - ch.cost(procedure), roomy(procedure).right, p), proc.enter(env, args)),
                        λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops }),
                })(roomy(procedure).left),
            }),
    }
}

// The compiled tree is the source's at fuel `m`, at least its own, with the
// runs it refuses ended at the refusal.
theorem Source::bounded_refuses(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n, m: Nat, le: n <= m):
    ITree::Refuses(Events::linux(), refused_status(), src.bounded_tree(args, ch, left, n), src.tree(args, m)) {
    let call = program_writers(src.functions);
    ITree::refuses_map(Events::linux(), Flow::stops(refused_status()), refused_status(), src.bounded_main(args, ch, left, n), src.main_tree(args, m),
        λ flow => flow.status(),
        src.main.refuses(call, src.performs(call, n, n, ch, left), src.calls(call, m, m), refused_status(), n, m, le,
            λ p _ => src.performs_refuses(call, n, m, le, n, m, le, ch, left, p), src.start(args)),
        λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops })
}

// Every trace the compiled program's meaning produces is the source's, or
// is refused: it exits with `call_depth_status` at a call, after a prefix
// the source produces.
theorem Source::bounded_traces(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left: Nat, tr: Trace<BitVec(64)>(Events::linux()),
    produces: Program::Produces(Events::linux(), src.bounded(args, ch, left), tr)):
    Or<Program::Produces(Events::linux(), src.denote(args), tr),
        Trace::Stops(Events::linux(), tr, refused_status()) ∧ Program::Produces(Events::linux(), src.denote(args), Trace::opened(Events::linux(), tr))> {
    match IsTrace::of_refuses(Events::linux(), refused_status(), src.bounded_tree(args, ch, left, produces.n), src.tree(args, produces.n), tr,
        src.bounded_refuses(args, ch, left, produces.n, produces.n, produces.n.le_refl()), produces.h) {
        Inl(it) => Inl(Converges(produces.n, it)),
        Inr(both) => Inr(⟨both.left, Converges(produces.n, both.right)⟩),
    }
}

// Where every chain of calls the fuel allows fits, the compiled tree grows
// the source's: every run the source makes with that fuel, the compiled
// program makes.
theorem Source::bounded_exact(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n: Nat, roomy: src.Roomy(ch, n, left)):
    ITree::Below(Events::linux(), src.tree(args, n), src.bounded_tree(args, ch, left, n)) {
    let call = program_writers(src.functions);
    ITree::below_of_refuses(Events::linux(), src.tree(args, n), src.bounded_tree(args, ch, left, n),
        ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), λ (_: BitVec(64)) => False, src.main_tree(args, n), src.bounded_main(args, ch, left, n),
            λ flow => flow.status(),
            src.main.refuses(call, src.calls(call, n, n), src.performs(call, n, n, ch, left), λ _ => False, n, n, n.le_refl(),
                λ p _ => src.calls_refuses(call, n, n, ch, left, roomy, p), src.start(args)),
            λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ never => never }))
}

// A source whose `main` performs nothing is never refused: the compiled
// tree grows into the source's at the same fuel…
theorem Source::bounded_never_refuses(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n: Nat, none: src.main.performed() = []):
    ITree::Below(Events::linux(), src.bounded_tree(args, ch, left, n), src.tree(args, n)) {
    let call = program_writers(src.functions);
    ITree::below_of_refuses(Events::linux(), src.bounded_tree(args, ch, left, n), src.tree(args, n),
        ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), λ (_: BitVec(64)) => False, src.bounded_main(args, ch, left, n), src.main_tree(args, n),
            λ flow => flow.status(),
            src.main.refuses(call, src.performs(call, n, n, ch, left), src.calls(call, n, n), λ _ => False, n, n, n.le_refl(),
                λ p mem => false_elim(j(none, λ l _ => Mem(p, l), mem)), src.start(args)),
            λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ never => never }))
}

// …and the other way.
theorem Source::never_refused_back(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left, n: Nat, none: src.main.performed() = []):
    ITree::Below(Events::linux(), src.tree(args, n), src.bounded_tree(args, ch, left, n)) {
    let call = program_writers(src.functions);
    ITree::below_of_refuses(Events::linux(), src.tree(args, n), src.bounded_tree(args, ch, left, n),
        ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), λ (_: BitVec(64)) => False, src.main_tree(args, n), src.bounded_main(args, ch, left, n),
            λ flow => flow.status(),
            src.main.refuses(call, src.calls(call, n, n), src.performs(call, n, n, ch, left), λ _ => False, n, n, n.le_refl(),
                λ p mem => false_elim(j(none, λ l _ => Mem(p, l), mem)), src.start(args)),
            λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ never => never }))
}

// So the two produce the same traces.
theorem Source::bounded_of_none(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left: Nat, none: src.main.performed() = []):
    Program::Refines(Events::linux(), src.bounded(args, ch, left), src.denote(args)) {
    λ tr c => Converges(c.n, IsTrace::of_below(Events::linux(), src.bounded_tree(args, ch, left, c.n), src.tree(args, c.n), tr,
        src.bounded_never_refuses(args, ch, left, c.n, none), c.h))
}

theorem Source::of_none_bounded(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, left: Nat, none: src.main.performed() = []):
    Program::Refines(Events::linux(), src.denote(args), src.bounded(args, ch, left)) {
    λ tr c => Converges(c.n, IsTrace::of_below(Events::linux(), src.tree(args, c.n), src.bounded_tree(args, ch, left, c.n), tr,
        src.never_refused_back(args, ch, left, c.n, none), c.h))
}

// ---------------------------------------------------------------------------
// Room in levels of calls (docs/native/native-procedure-frames-design.md §7.4)
//
// A program asks for its stack in levels of the calls that can nest without
// bound (the compiler's checked calls), not in bytes: the bytes a call takes
// depend on the frames the compiler picks. Below, the source's runs that
// keep within `k` such levels (`Source::within`) and the theorem that the
// compiled program makes every one of them unrefused, wherever the charges
// fit the levels (`Charges::Levels`, `Source::levels_refines`).

// The levels left past a call: as many where it is not counted, one fewer
// where it is, and none to make it with where none are left.
fn Nat::spend(self k: Nat, counted: Bool) → Option<Nat> {
    match counted { False => Some(k), True => match k { Zero => None, Succ(j) => Some(j) } }
}

// What a call does in the source, at fuel `n` with `d` levels of calls
// left (`Source::calls`) and at most `k` more of the calls `counted` names:
// a counted call past them claims nothing, a `Cut`, as one past `d` does.
fn Source::calls_within(self src: Source, call: Writers(), n, d: Nat, counted: Nat → Bool, k: Nat) → Performs() {
    match d {
        Zero => λ procedure args results env => Cut,
        Succ(e) => λ procedure args results env => Tau(match src.procedures.nth(procedure) {
            None => Ret(Onward(env)),
            Some(proc) => match k.spend(counted(procedure)) {
                None => Cut,
                Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                    λ flow => proc.leave(env, results, flow)),
            },
        }),
    }
}

// More fuel and one more level grow every call's tree.
theorem Source::calls_within_grows(self src: Source, call: Writers(), n, d: Nat, counted: Nat → Bool, k: Nat):
    performs_below(src.calls_within(call, n, d, counted, k), src.calls_within(call, n + 1, Succ(d), counted, k)) {
    match d {
        Zero => λ procedure args results env => trivial,
        Succ(e) => λ procedure args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => match k.spend(counted(procedure)) {
                    None => Cut,
                    Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n + 1, Succ(e), counted, j), n + 1, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
            }, refl,
            match src.procedures.nth(procedure) as λ o =>
                ITree::Below(Events::linux(),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => match k.spend(counted(procedure)) {
                            None => Cut,
                            Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => match k.spend(counted(procedure)) {
                            None => Cut,
                            Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n + 1, Succ(e), counted, j), n + 1, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    }) {
                None => refl,
                Some(proc) => match k.spend(counted(procedure)) as λ s =>
                        ITree::Below(Events::linux(),
                            match s as λ _ => ITree<Flow>(Events::linux()) {
                                None => Cut,
                                Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                            match s {
                                None => Cut,
                                Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n + 1, Succ(e), counted, j), n + 1, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            }) {
                    None => trivial,
                    Some(j) => ITree::below_bind(Events::linux(),
                        proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                        proc.body.denote(call, src.calls_within(call, n + 1, Succ(e), counted, j), n + 1, proc.enter(env, args)),
                        λ flow => Ret(proc.leave(env, results, flow)), λ flow => Ret(proc.leave(env, results, flow)),
                        proc.body.grows(call, src.calls_within(call, n, e, counted, j), src.calls_within(call, n + 1, Succ(e), counted, j),
                            src.calls_within_grows(call, n, e, counted, j), n, proc.enter(env, args)),
                        λ flow => refl),
                },
            }),
    }
}

// `main` at fuel `n`, its calls nesting as deep as the fuel and at most
// `k` levels of the calls `counted` names.
fn Source::within_main(self src: Source, args: List<List<BitVec(8)>>, counted: Nat → Bool, k, n: Nat) → ITree<Flow>(Events::linux()) {
    src.main.denote(program_writers(src.functions), src.calls_within(program_writers(src.functions), n, n, counted, k), n, src.start(args))
}

fn Source::within_tree(self src: Source, args: List<List<BitVec(8)>>, counted: Nat → Bool, k, n: Nat) → ITree<BitVec(64)>(Events::linux()) {
    ITree::map(Events::linux(), src.within_main(args, counted, k, n), λ flow => flow.status())
}

// The source's runs with the command line `args` that nest at most `k`
// of the calls `counted` names.
fn Source::within(self src: Source, args: List<List<BitVec(8)>>, counted: Nat → Bool, k: Nat) → Program<BitVec(64)>(Events::linux()) {
    Program(λ n => src.within_tree(args, counted, k, n), λ n => ITree::below_bind(Events::linux(),
        src.within_main(args, counted, k, n), src.within_main(args, counted, k, Succ(n)),
        λ flow => Ret(flow.status()), λ flow => Ret(flow.status()),
        src.main.grows(program_writers(src.functions), src.calls_within(program_writers(src.functions), n, n, counted, k),
            src.calls_within(program_writers(src.functions), Succ(n), Succ(n), counted, k), src.calls_within_grows(program_writers(src.functions), n, n, counted, k),
            n, src.start(args)), λ flow => refl))
}

// A call kept within the levels is the source's call, with less grown.
theorem Source::within_calls(self src: Source, call: Writers(), n, d: Nat, counted: Nat → Bool, k: Nat):
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
    ITree::Refuses(Events::linux(), Flow::stops(λ _ => False), src.calls_within(call, n, d, counted, k)(procedure, args, results, env),
        src.calls(call, n, d)(procedure, args, results, env)) {
    match d {
        Zero => λ procedure args results env => trivial,
        Succ(e) => λ procedure args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, e), n, proc.enter(env, args)),
                    λ flow => proc.leave(env, results, flow)),
            }, refl,
            match src.procedures.nth(procedure) as λ o =>
                ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => match k.spend(counted(procedure)) {
                            None => Cut,
                            Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, e), n, proc.enter(env, args)),
                            λ flow => proc.leave(env, results, flow)),
                    }) {
                None => Inr(refl),
                Some(proc) => match k.spend(counted(procedure)) as λ s =>
                        ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                            match s as λ _ => ITree<Flow>(Events::linux()) {
                                None => Cut,
                                Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                            ITree::map(Events::linux(), proc.body.denote(call, src.calls(call, n, e), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow))) {
                    None => trivial,
                    Some(j) => ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), Flow::stops(λ _ => False),
                        proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                        proc.body.denote(call, src.calls(call, n, e), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow),
                        proc.body.refuses(call, src.calls_within(call, n, e, counted, j), src.calls(call, n, e), λ _ => False, n, n, n.le_refl(),
                            λ p _ => src.within_calls(call, n, e, counted, j, p), proc.enter(env, args)),
                        λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops }),
                },
            }),
    }
}

// So every run within the levels is the source's.
theorem Source::within_refines(self src: Source, args: List<List<BitVec(8)>>, counted: Nat → Bool, k: Nat):
    Program::Refines(Events::linux(), src.within(args, counted, k), src.denote(args)) {
    let call = program_writers(src.functions);
    λ tr c => Converges(c.n, IsTrace::of_below(Events::linux(), src.within_tree(args, counted, k, c.n), src.tree(args, c.n), tr,
        ITree::below_of_refuses(Events::linux(), src.within_tree(args, counted, k, c.n), src.tree(args, c.n),
            ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), λ (_: BitVec(64)) => False, src.within_main(args, counted, k, c.n), src.main_tree(args, c.n),
                λ flow => flow.status(),
                src.main.refuses(call, src.calls_within(call, c.n, c.n, counted, k), src.calls(call, c.n, c.n), λ _ => False, c.n, c.n, c.n.le_refl(),
                    λ p _ => src.within_calls(call, c.n, c.n, counted, k, p), src.start(args)),
                λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ never => never })), c.h))
}

// What makes the charges `ch` fit levels of the calls `counted` names:
// `total(k, p)` is the most procedure `p`'s body takes below its frame
// with `k` levels left, `top(k)` `main`'s. A counted procedure's check asks
// for no more than its cost, what its body takes with any levels left and a
// return address; any other is entered with no check; and a call within the
// levels, with the levels it leaves, takes no more than the caller's body
// may with the levels it has.
record Charges::Levels(self ch: Charges, src: Source, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat) {
    checked: (p: Nat) → counted(p) = True → (need: Nat) → ch.check(p) = Some(need) → (j: Nat) → need <= (ch.cost(p) + total(j, p)) + 8,
    unchecked: (p: Nat) → counted(p) = False → ch.check(p) = None,
    step: (q: Nat) → (proc: Procedure) → src.procedures.nth(q) = Some(proc) → (p: Nat) → (callee: Procedure) → src.procedures.nth(p) = Some(callee) →
        Mem(p, proc.body.performed()) → (k, j: Nat) → k.spend(counted(p)) = Some(j) → ch.cost(p) + total(j, p) <= total(k, q),
    main_step: (p: Nat) → (callee: Procedure) → src.procedures.nth(p) = Some(callee) → Mem(p, src.main.performed()) → (k, j: Nat) → k.spend(counted(p)) = Some(j) →
        ch.cost(p) + total(j, p) <= top(k),
}

// A call with its cost, its body's room and a return address left is not
// refused.
theorem Charges::levels_admit(self ch: Charges, src: Source, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat, lv: ch.Levels(src, counted, total, top),
    procedure, j, left: Nat, fits: (ch.cost(procedure) + total(j, procedure)) + 8 <= left): ch.refuses(procedure, left) = False {
    (match counted(procedure) as λ b => counted(procedure) = b → ch.refuses(procedure, left) = False {
        False => λ unc => j(sym(lv.unchecked(procedure, unc)), λ o _ => (match o { None => False, Some(need) => Succ(left).leb(need) }) = False, refl),
        True => λ cnt => (match ch.check(procedure) as λ o => ch.check(procedure) = o → (match o { None => False, Some(need) => Succ(left).leb(need) }) = False {
            None => λ _ => refl,
            Some(need) => λ asked => {
                let most = lv.checked(procedure, cnt, need, asked, j);
                Nat::leb_false(Succ(left), need, omega(most, fits))
            },
        })(refl),
    })(refl)
}

// A call kept within `k` levels, made with its cost, its body's room with
// the levels it leaves and a return address left, is never refused, nor
// any call it makes within them.
theorem Source::levels_refuses(self src: Source, call: Writers(), n, d: Nat, ch: Charges, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat,
    lv: ch.Levels(src, counted, total, top)):
    (k, left, procedure: Nat) →
    ((callee: Procedure) → src.procedures.nth(procedure) = Some(callee) → (j: Nat) → k.spend(counted(procedure)) = Some(j) →
        (ch.cost(procedure) + total(j, procedure)) + 8 <= left) →
    (args, results: List<Nat>) → (env: Env) →
    ITree::Refuses(Events::linux(), Flow::stops(λ _ => False), src.calls_within(call, n, d, counted, k)(procedure, args, results, env),
        src.performs(call, n, d, ch, left)(procedure, args, results, env)) {
    match d {
        Zero => λ k left procedure fits args results env => trivial,
        Succ(e) => λ k left procedure fits args results env => SameTau(
            match src.procedures.nth(procedure) {
                None => Ret(Onward(env)),
                Some(proc) => match ch.refuses(procedure, left) {
                    True => Ret(Exited(call_depth_status())),
                    False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, e, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
            }, refl,
            (match src.procedures.nth(procedure) as λ o => src.procedures.nth(procedure) = o →
                ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                    match o as λ _ => ITree<Flow>(Events::linux()) {
                        None => Ret(Onward(env)),
                        Some(proc) => match k.spend(counted(procedure)) {
                            None => Cut,
                            Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    },
                    match o {
                        None => Ret(Onward(env)),
                        Some(proc) => match ch.refuses(procedure, left) {
                            True => Ret(Exited(call_depth_status())),
                            False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, e, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow)),
                        },
                    }) {
                None => λ _ => Inr(refl),
                Some(proc) => λ found => (match k.spend(counted(procedure)) as λ s => k.spend(counted(procedure)) = s →
                        ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                            match s as λ _ => ITree<Flow>(Events::linux()) {
                                None => Cut,
                                Some(j) => ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            },
                            match ch.refuses(procedure, left) as λ _ => ITree<Flow>(Events::linux()) {
                                True => Ret(Exited(call_depth_status())),
                                False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, e, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                    λ flow => proc.leave(env, results, flow)),
                            }) {
                    None => λ _ => trivial,
                    Some(j) => λ spent => {
                        let inside = fits(proc, found, j, spent);
                        (match ch.refuses(procedure, left) as λ r => (r = False) →
                                ITree::Refuses(Events::linux(), Flow::stops(λ _ => False),
                                    ITree::map(Events::linux(), proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                        λ flow => proc.leave(env, results, flow)),
                                    match r as λ _ => ITree<Flow>(Events::linux()) {
                                        True => Ret(Exited(call_depth_status())),
                                        False => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, e, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                            λ flow => proc.leave(env, results, flow)),
                                    }) {
                            True => λ never => absurd(never),
                            False => λ _ => ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), Flow::stops(λ _ => False),
                                proc.body.denote(call, src.calls_within(call, n, e, counted, j), n, proc.enter(env, args)),
                                proc.body.denote(call, src.performs(call, n, e, ch, left - ch.cost(procedure)), n, proc.enter(env, args)),
                                λ flow => proc.leave(env, results, flow),
                                proc.body.refuses(call, src.calls_within(call, n, e, counted, j), src.performs(call, n, e, ch, left - ch.cost(procedure)),
                                    λ _ => False, n, n, n.le_refl(),
                                    λ p mem => src.levels_refuses(call, n, e, ch, counted, total, top, lv, j, left - ch.cost(procedure), p,
                                        λ callee found_p j2 spent2 => {
                                            let step = lv.step(procedure, proc, found, p, callee, found_p, mem, j, j2, spent2);
                                            omega(step, inside)
                                        }),
                                    proc.enter(env, args)),
                                λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ stops => stops }),
                        })(ch.levels_admit(src, counted, total, top, lv, procedure, j, left, inside))
                    },
                })(refl),
            })(refl)),
    }
}

// Where `left` holds what `main`'s body takes with `k` levels and a
// return address, the compiled tree grows the source's within the levels:
// every run of the source that nests at most `k` counted calls, the
// compiled program makes, never refused.
theorem Source::levels_exact(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat,
    lv: ch.Levels(src, counted, total, top), k, left, n: Nat, fits: top(k) + 8 <= left):
    ITree::Below(Events::linux(), src.within_tree(args, counted, k, n), src.bounded_tree(args, ch, left, n)) {
    let call = program_writers(src.functions);
    ITree::below_of_refuses(Events::linux(), src.within_tree(args, counted, k, n), src.bounded_tree(args, ch, left, n),
        ITree::refuses_map(Events::linux(), Flow::stops(λ _ => False), λ (_: BitVec(64)) => False, src.within_main(args, counted, k, n), src.bounded_main(args, ch, left, n),
            λ flow => flow.status(),
            src.main.refuses(call, src.calls_within(call, n, n, counted, k), src.performs(call, n, n, ch, left), λ _ => False, n, n, n.le_refl(),
                λ p mem => src.levels_refuses(call, n, n, ch, counted, total, top, lv, k, left, p,
                    λ callee found j spent => { let step = lv.main_step(p, callee, found, mem, k, j, spent); omega(step, fits) }), src.start(args)),
            λ flow => match flow { Onward(_) => λ never => false_elim(never), Exited(_) => λ never => never }))
}

// So with the fuel gone: every trace the source makes within `k` levels,
// the compiled program makes.
theorem Source::levels_refines(self src: Source, args: List<List<BitVec(8)>>, ch: Charges, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat,
    lv: ch.Levels(src, counted, total, top), k, left: Nat, fits: top(k) + 8 <= left):
    Program::Refines(Events::linux(), src.within(args, counted, k), src.bounded(args, ch, left)) {
    λ tr c => Converges(c.n, IsTrace::of_below(Events::linux(), src.within_tree(args, counted, k, c.n), src.bounded_tree(args, ch, left, c.n), tr,
        src.levels_exact(args, ch, counted, total, top, lv, k, left, c.n, fits), c.h))
}

// ---------------------------------------------------------------------------
// Levels in periods (§7.4). What a body takes with `k` levels left grows,
// past a point, by the same amount every so many levels: the heaviest
// chain of calls settles into going round its heaviest cycle. So the most
// a body takes may be read past `from` from one period of values, `gain`
// more for each period. Checking that takes two periods' values, however
// many levels the source asks for.

// `f` past `from` in periods of `period`: the value at `from + r` again,
// `gain` more each period. The quotient and remainder are by long division
// (`Nat::ldiv`), so a large `k` costs its bits.
fn Nat::periodic(self k: Nat, from, period, gain: Nat, f: Nat → Nat) → Nat {
    match Succ(k).leb(from) {
        True => f(k),
        False => f(from + (k - from).ldiv(period).rem()) + gain * (k - from).ldiv(period).quot(),
    }
}

// Before `from`, the values themselves.
theorem Nat::periodic_before(self k: Nat, from, period, gain: Nat, f: Nat → Nat, before: k < from): k.periodic(from, period, gain, f) = f(k) {
    let is: (Succ(k).leb(from) = True) = Succ(k).leb_true(from, before);
    j(sym(is), λ b _ => (match b { True => f(k), False => f(from + (k - from).ldiv(period).rem()) + gain * (k - from).ldiv(period).quot() }) = f(k), refl)
}

// From `from` on, at `from + q * period + r`: the value at `from + r` and
// `q` gains.
theorem Nat::periodic_past(self k: Nat, from, period, gain: Nat, f: Nat → Nat, q, r: Nat, parts: from + (q * period + r) = k, below: r < period):
    k.periodic(from, period, gain, f) = f(from + r) + gain * q {
    let pos: (0 < period) = omega(below);
    let x = k - from;
    let x_is: (q * period + r = x) = omega(parts);
    let found = x.div_mod_unique(period, q, r, x_is, below);
    let quot_is: (x.ldiv(period).quot() = q) = trans(x.ldiv_div(period, d_pos := pos), found.left);
    let rem_is: (x.ldiv(period).rem() = r) = trans(x.ldiv_mod(period, d_pos := pos), found.right);
    let not_before: (Succ(k).leb(from) = False) = Succ(k).leb_false(from, omega(parts));
    j(sym(not_before), λ b _ => (match b { True => f(k), False => f(from + x.ldiv(period).rem()) + gain * x.ldiv(period).quot() }) = f(from + r) + gain * q,
        j(sym(quot_is), λ y _ => f(from + x.ldiv(period).rem()) + gain * y = f(from + r) + gain * q,
            j(sym(rem_is), λ y _ => f(from + y) + gain * q = f(from + r) + gain * q, refl)))
}

// Where `f` is never below `c`, nor is it read in periods.
theorem Nat::periodic_above(self k: Nat, from, period, gain, c: Nat, f: Nat → Nat, above: (i: Nat) → c <= f(i)): c <= k.periodic(from, period, gain, f) {
    match Succ(k).leb(from) as λ b => c <= match b { True => f(k), False => f(from + (k - from).ldiv(period).rem()) + gain * (k - from).ldiv(period).quot() } {
        True => above(k),
        False => {
            let x = from + (k - from).ldiv(period).rem();
            let y = gain * (k - from).ldiv(period).quot();
            let at: (c <= f(x)) = above(x);
            let fits: (c <= f(x) + y) = omega(at);
            fits
        },
    }
}

// What holds of `f` and `g` level by level holds of them read in periods.
theorem Nat::periodic_same(self k: Nat, from, period, gain, a: Nat, f, g: Nat → Nat, each: (i: Nat) → a + f(i) <= g(i)):
    a + k.periodic(from, period, gain, f) <= k.periodic(from, period, gain, g) {
    match Succ(k).leb(from) as λ b => a + (match b { True => f(k), False => f(from + (k - from).ldiv(period).rem()) + gain * (k - from).ldiv(period).quot() }) <=
        match b { True => g(k), False => g(from + (k - from).ldiv(period).rem()) + gain * (k - from).ldiv(period).quot() } {
        True => each(k),
        False => {
            let x = from + (k - from).ldiv(period).rem();
            let y = gain * (k - from).ldiv(period).quot();
            let at: (a + f(x) <= g(x)) = each(x);
            let fits: (a + (f(x) + y) <= g(x) + y) = omega(at);
            fits
        },
    }
}

// What holds from one level to the next holds of them read in periods,
// where `g` gains no more than `gain` over a period from `from`: within a
// period the step is the levels' own, and across the end of one it is the
// step into `from + period`, which is within `gain` of `from`.
theorem Nat::periodic_step(self j: Nat, from, period, gain, a: Nat, f, g: Nat → Nat, pos: 0 < period, each: (i: Nat) → a + f(i) <= g(Succ(i)),
    bound: g(from + period) <= g(from) + gain):
    a + j.periodic(from, period, gain, f) <= Succ(j).periodic(from, period, gain, g) {
    match Succ(Succ(j)).leb(from) as λ b => Succ(Succ(j)).leb(from) = b → a + j.periodic(from, period, gain, f) <= Succ(j).periodic(from, period, gain, g) {
        True => λ early => {
            let lt: (Succ(j) < from) = Succ(Succ(j)).le_of_leb(from, early);
            let lhs = j.periodic_before(from, period, gain, f, omega(lt));
            let rhs = Succ(j).periodic_before(from, period, gain, g, lt);
            let step = each(j);
            omega(lhs, rhs, step)
        },
        False => λ late => {
            let ge: (from <= Succ(j)) = omega(Succ(Succ(j)).not_le_of_leb(from, late));
            match Succ(j).leb(from) as λ c => Succ(j).leb(from) = c → a + j.periodic(from, period, gain, f) <= Succ(j).periodic(from, period, gain, g) {
                True => λ at_from => {
                    // `j + 1 = from`: the first period starts at the call.
                    let lt: (j < from) = Succ(j).le_of_leb(from, at_from);
                    let lhs = j.periodic_before(from, period, gain, f, lt);
                    let rhs = Succ(j).periodic_past(from, period, gain, g, 0, 0, omega(ge, lt), pos);
                    let same: (from + 0 = Succ(j)) = omega(ge, lt);
                    let g_is = cong_fn<Nat, Nat>(g, same);
                    let step = each(j);
                    omega(lhs, rhs, g_is, step)
                },
                False => λ past => {
                    let ge_j: (from <= j) = omega(Succ(j).not_le_of_leb(from, past));
                    let x = j - from;
                    let q = x.ldiv(period).quot();
                    let r = x.ldiv(period).rem();
                    let parts: (q * period + r = x) = x.ldiv_parts(period);
                    let below: (r < period) = x.ldiv_rem_lt(period, d_pos := pos);
                    let lhs = j.periodic_past(from, period, gain, f, q, r, omega(parts, ge_j), below);
                    let step = each(from + r);
                    match (Succ(r)).leb(period - 1) as λ c => (Succ(r)).leb(period - 1) = c → a + j.periodic(from, period, gain, f) <= Succ(j).periodic(from, period, gain, g) {
                        True => λ inside => {
                            // Within the period: the next remainder.
                            let le_last: (Succ(r) <= period - 1) = Succ(r).le_of_leb(period - 1, inside);
                            let lt: (Succ(r) < period) = omega(le_last, below);
                            let rhs = Succ(j).periodic_past(from, period, gain, g, q, Succ(r), omega(parts, ge_j), lt);
                            let next: (from + Succ(r) = Succ(from + r)) = omega();
                            let g_is = cong_fn<Nat, Nat>(g, next);
                            omega(lhs, rhs, g_is, step)
                        },
                        False => λ last => {
                            // The period's last level: the next is the
                            // next period's first.
                            let le: (period - 1 <= r) = omega(Succ(r).not_le_of_leb(period - 1, last));
                            let more: ((q + 1) * period = period + q * period) = q.mul_succ_left(period);
                            let rhs = Succ(j).periodic_past(from, period, gain, g, q + 1, 0, omega(parts, ge_j, le, below, more), pos);
                            let gains: (gain * (q + 1) = gain + gain * q) = trans(gain.mul_comm(q + 1), trans(q.mul_succ_left(gain), cong_fn<Nat, Nat>(λ y => gain + y, q.mul_comm(gain))));
                            let end_is: (Succ(from + r) = from + period) = omega(le, below);
                            let start_is: (from + 0 = from) = omega();
                            let g_end = cong_fn<Nat, Nat>(g, end_is);
                            let g_start = cong_fn<Nat, Nat>(g, start_is);
                            omega(lhs, rhs, gains, g_end, g_start, step, bound)
                        },
                    }(refl)
                },
            }(refl)
        },
    }(refl)
}

// A call's step from `k` levels to `j`, read in periods: the levels' own
// at each level carries over (`periodic_same` where the call is not
// counted, `periodic_step` where it is).
theorem Nat::periodic_spend(from, period, gain, a: Nat, f, g: Nat → Nat, pos: 0 < period, counted: Bool,
    each: (k, j: Nat) → k.spend(counted) = Some(j) → a + f(j) <= g(k), bound: g(from + period) <= g(from) + gain):
    (k, j: Nat) → k.spend(counted) = Some(j) → a + j.periodic(from, period, gain, f) <= k.periodic(from, period, gain, g) {
    match counted as λ b => ((k, j: Nat) → k.spend(b) = Some(j) → a + f(j) <= g(k)) →
        (k, j: Nat) → k.spend(b) = Some(j) → a + j.periodic(from, period, gain, f) <= k.periodic(from, period, gain, g) {
        False => λ each_f k j spent => {
            let same: (k = j) = cong_fn<Option<Nat>, Nat>(λ o => match o { None => k, Some(x) => x }, spent);
            j(same, λ x _ => a + x.periodic(from, period, gain, f) <= k.periodic(from, period, gain, g),
                k.periodic_same(from, period, gain, a, f, g, λ i => each_f(i, i, refl)))
        },
        True => λ each_t k j => match k as λ k2 => (match k2 { Zero => None, Succ(i) => Some(i) }) = Some(j) → a + j.periodic(from, period, gain, f) <= k2.periodic(from, period, gain, g) {
            Zero => λ no => false_elim(j(no, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
            Succ(i) => λ spent => {
                let same: (i = j) = cong_fn<Option<Nat>, Nat>(λ o => match o { None => i, Some(x) => x }, spent);
                j(same, λ x _ => a + x.periodic(from, period, gain, f) <= Succ(i).periodic(from, period, gain, g),
                    i.periodic_step(from, period, gain, a, f, g, pos, λ l => each_t(Succ(l), l, refl), bound))
            },
        },
    }(each)
}

// Levels read in periods fit where the levels do, given that no body
// gains more than `gain` over the period from `from`: the charges then fit
// any number of levels with what two periods' values say.
theorem Charges::levels_periodic(self ch: Charges, src: Source, counted: Nat → Bool, total: Nat → Nat → Nat, top: Nat → Nat, lv: ch.Levels(src, counted, total, top),
    from, period, gain: Nat, pos: 0 < period,
    bound: (q: Nat) → (proc: Procedure) → src.procedures.nth(q) = Some(proc) → total(from + period, q) <= total(from, q) + gain,
    top_bound: top(from + period) <= top(from) + gain):
    ch.Levels(src, counted, λ k p => k.periodic(from, period, gain, λ i => total(i, p)), λ k => k.periodic(from, period, gain, top)) {
    Charges::Levels(
        checked := λ p cnt need asked j2 => {
            let above = j2.periodic_above(from, period, gain, need - (ch.cost(p) + 8), λ i => total(i, p),
                λ i => { let fits = lv.checked(p, cnt, need, asked, i); let below: (need - (ch.cost(p) + 8) <= total(i, p)) = omega(fits); below });
            let v = j2.periodic(from, period, gain, λ i => total(i, p));
            let at: (need - (ch.cost(p) + 8) <= v) = above;
            let fits: (need <= (ch.cost(p) + v) + 8) = omega(at);
            fits
        },
        unchecked := lv.unchecked,
        step := λ q proc found p callee found_p mem =>
            Nat::periodic_spend(from, period, gain, ch.cost(p), λ i => total(i, p), λ i => total(i, q), pos, counted(p),
                λ k j2 spent => lv.step(q, proc, found, p, callee, found_p, mem, k, j2, spent), bound(q, proc, found)),
        main_step := λ p callee found_p mem =>
            Nat::periodic_spend(from, period, gain, ch.cost(p), λ i => total(i, p), top, pos, counted(p),
                λ k j2 spent => lv.main_step(p, callee, found_p, mem, k, j2, spent), top_bound))
}

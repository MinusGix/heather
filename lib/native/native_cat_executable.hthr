// cat as a Linux executable (issues/native-cat-executable.md): the I/O
// profile's ELF of cat's compiled bytes (`io_elf_file`), which `heather
// write-elf lib/native/native_cat_executable.hthr cat_source -o cat` writes
// once the kernel checks the file equal to it (`cat_source_elf_written`,
// applied to `cat_compiles`). The
// process Linux makes of that file sends to stdout what it read from stdin
// along every run that exits 0 (`cat_file_sends`, from `cat_native_sends`):
// the file's header is 288 bytes, whatever the code's length, and its
// contract's note follows the code (`cat_note`).
//
// Outside the proof: that Linux maps the file as `X86Memory::io_load` says
// (the RX file at 0x400000, the zero segment at 0x410000) below the
// segment's end (`X86Memory::LoadedFrom`), starts it at `io_entry()` with
// RSP a page and cat's room above the segment (`StackPlaced`) and the
// command line there (`ArgvAt`; cat reads none of it), extends the stack
// at each touch or ends the process (`StackTouch`), and that its system
// calls answer as `LinuxRun` allows.
import native_cat;
import native_cat_spec;
import native_cat_compiled;
import native_source;
import stream_filter_spec;
import linux_calls;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_determinism;
import linux_x86_64_image;
import linux_x86_64_stack_growth;
import native_compile_elf;
import linux_x86_64_sim;
import itree;
import itree_trace;
import x86_64;
import x86_64_asm;
import x86_64_byte_memory;
import x86_64_store;
import bitvec;
import list;
import nat;

// The source `write-elf` compiles, and the file: the header, cat's bytes,
// then its note.
fn cat_source() → Source { cat(cat_capacity()) }
fn cat_file() → List<BitVec(8)> { io_elf_file(cat_bytes(), cat_note(), cat_size()) }

// A process Linux started from the file as its contract says
// (`SystemStart`: loaded, at its entry, the command line at RSP, and nothing
// asked of the stack below) touches the stack room cat needs, and is then
// one whose every run that exits 0 sent to stdout what it read from stdin.
theorem cat_file_sends(top: Nat, args: List<List<BitVec(8)>>, s: MachineState<X86Memory(X86Profile::io(cat_size()))>,
    start: SystemStart(cat_size(), cat_file(), top, cat_room(), args, s)):
    StackTouched(X86Profile::io(cat_size()), top, StoreByte(stack_touch_store()),
        λ (at: MachineState<X86Memory(X86Profile::io(cat_size()))>) => Exists<MachineState<X86Memory(X86Profile::process(cat_size(), top, cat_room()))>>(λ u =>
            Alike(X86Profile::io(cat_size()), X86Profile::process(cat_size(), top, cat_room()), at, u) ∧ CatSends(top, args)(u)),
        stack_strides(cat_room(), cat_room()), 0, s) {
    cat_native_sends(top, args, s, start)
}

// The arithmetic and list facts `native_compile_correct` reads the compiler
// with (issues/native-effect-source-compiler.md, round S3.2): an
// environment's words and buffers after a write, a region's bytes as a list,
// where the layout puts each buffer, and the bit and errno words the machine
// and the source each spell their own way.
import native_source;
import native_compile;
import native_alloc;
import function_ir_lower;
import function_ir_lower_calls;
import function_ir;
import function_ir_eval;
import linux_calls;
import linux_x86_64_io;
import x86_64;
import bitvec;
import bitvec_nat;
import bitvec_signed;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// A list entry, or a default past the end

fn List::get_or<A>(self xs: List<A>, j: Nat, d: A) → A { match xs.nth(j) { None => d, Some(x) => x } }

theorem List::get_or_some<A>(self xs: List<A>, i: Nat, d, x: A, found: xs.nth(i) = Some(x)): xs.get_or(i, d) = x {
    j(sym(found), λ o _ => (match o as λ _ => A { None => d, Some(y) => y }) = x, refl)
}

theorem List::get_or_none<A>(self xs: List<A>, i: Nat, d: A, none: xs.nth(i) = None): xs.get_or(i, d) = d {
    j(sym(none), λ o _ => (match o as λ _ => A { None => d, Some(y) => y }) = d, refl)
}

theorem List::put_here<A>(i: Nat): (xs: List<A>) → (x, pad: A) → xs.put(i, x, pad).nth(i) = Some(x) {
    match i {
        Zero => λ xs x pad => match xs { Nil => refl, Cons(_, _) => refl },
        Succ(_, ih) => λ xs x pad => match xs { Nil => ih(Nil, x, pad), Cons(_, rest) => ih(rest, x, pad) },
    }
}

// Every other entry reads as it did, the pad standing in for one past the
// end.
theorem List::put_other<A>(i: Nat): (xs: List<A>) → (x, pad: A) → (j: Nat) → j ≠ i →
    xs.put(i, x, pad).get_or(j, pad) = xs.get_or(j, pad) {
    match i {
        Zero => λ xs x pad j => match j {
            Zero => λ ne => false_elim(ne(refl)),
            Succ(_) => λ _ => match xs {
                Nil => refl,
                Cons(_, _) => refl,
            },
        },
        Succ(_, ih) => λ xs x pad j => match j {
            Zero => λ _ => match xs { Nil => refl, Cons(_, _) => refl },
            Succ(l) => λ ne => match xs {
                Nil => ih(Nil, x, pad, l, λ e => ne(Nat::cong_succ(e))),
                Cons(_, rest) => ih(rest, x, pad, l, λ e => ne(Nat::cong_succ(e))),
            },
        },
    }
}

// ---------------------------------------------------------------------------
// The environment after a write

theorem Env::number_set_here(self env: Env, id: Nat, word: BitVec(64)): env.set_word(id, word).number(id) = word.toNat() {
    j(sym(List::put_here(id, env.words, word.toNat(), 0)), λ o _ => (match o { None => 0, Some(n) => n }) = word.toNat(), refl)
}

theorem Env::number_set_other(self env: Env, id: Nat, word: BitVec(64), query: Nat, ne: query ≠ id):
    env.set_word(id, word).number(query) = env.number(query) {
    List::put_other(id, env.words, word.toNat(), 0, query, ne)
}

theorem Env::buffer_set_here(self env: Env, id: Nat, bytes: List<BitVec(8)>): env.set_buffer(id, bytes).buffer(id) = bytes {
    j(sym(List::put_here(id, env.buffers, bytes, Nil)), λ o _ => (match o { None => Nil, Some(b) => b }) = bytes, refl)
}

theorem Env::buffer_set_other(self env: Env, id: Nat, bytes: List<BitVec(8)>, query: Nat, ne: query ≠ id):
    env.set_buffer(id, bytes).buffer(query) = env.buffer(query) {
    List::put_other(id, env.buffers, bytes, Nil, query, ne)
}

// ---------------------------------------------------------------------------
// A region's bytes as a list

// The `n` cells of `v` from `o`.
fn cells_at(v: Nat → BitVec(8), o, n: Nat) → List<BitVec(8)> {
    match n { Zero => Nil, Succ(k) => Cons(v(o), cells_at(v, Succ(o), k)) }
}

theorem cells_len(v: Nat → BitVec(8), n: Nat): (o: Nat) → cells_at(v, o, n).len() = n {
    match n { Zero => λ o => refl, Succ(_, ih) => λ o => Nat::cong_succ(ih(Succ(o))) }
}

theorem cells_nth(v: Nat → BitVec(8), n: Nat): (o, i: Nat) → i < n → cells_at(v, o, n).nth(i) = Some(v(o + i)) {
    match n {
        Zero => λ o i below => false_elim(omega(below)),
        Succ(_, ih) => λ o i => match i {
            Zero => λ _ => refl,
            Succ(l) => λ below => trans(ih(Succ(o), l, below), cong_fn<Nat, Option<BitVec(8)>>(λ p => Some(v(p)), Nat::add_succ_left(o, l))),
        },
    }
}

// Cells that agree make the same list.
theorem cells_agree(v, w: Nat → BitVec(8), n: Nat): (o: Nat) → ((i: Nat) → i < n → v(o + i) = w(o + i)) →
    cells_at(v, o, n) = cells_at(w, o, n) {
    match n {
        Zero => λ o _ => refl,
        Succ(_, ih) => λ o same => eq2(λ (x: BitVec(8)) (t: List<BitVec(8)>) => Cons(x, t), same(0, trivial),
            ih(Succ(o), λ i below => j(sym(Nat::add_succ_left(o, i)), λ p _ => v(p) = w(p), same(Succ(i), below)))),
    }
}

theorem cells_split(v: Nat → BitVec(8), c: Nat): (o, n: Nat) → c <= n →
    cells_at(v, o, n) = cells_at(v, o, c) ++ cells_at(v, o + c, n - c) {
    match c {
        Zero => λ o n _ => cong_fn<Nat, List<BitVec(8)>>(λ k => cells_at(v, o, k), sym(Nat::sub_add_cancel(0, n, trivial))),
        Succ(d, ih) => λ o n => match n {
            Zero => λ bad => false_elim(bad),
            Succ(m) => λ le => List::cong_cons(v(o), trans(ih(Succ(o), m, le),
                cong_fn<Nat, List<BitVec(8)>>(λ p => cells_at(v, Succ(o), d) ++ cells_at(v, p, m - d), Nat::add_succ_left(o, d)))),
        },
    }
}

theorem cells_drop(v: Nat → BitVec(8), n: Nat): (o, d: Nat) → cells_at(v, o, n).drop(d) = cells_at(v, o + d, n - d) {
    match n {
        Zero => λ o d => refl,
        Succ(k, ih) => λ o d => match d {
            Zero => refl,
            Succ(e) => trans(ih(Succ(o), e), cong_fn<Nat, List<BitVec(8)>>(λ p => cells_at(v, p, k - e), Nat::add_succ_left(o, e))),
        },
    }
}

theorem cells_take(v: Nat → BitVec(8), n: Nat): (o, t: Nat) → cells_at(v, o, n).take(t) = cells_at(v, o, t.min(n)) {
    match n {
        Zero => λ o t => match t { Zero => refl, Succ(_) => refl },
        Succ(_, ih) => λ o t => match t { Zero => refl, Succ(s) => List::cong_cons(v(o), ih(Succ(o), s)) },
    }
}

// Cells that read as a list are that list.
theorem cells_of(v: Nat → BitVec(8), bytes: List<BitVec(8)>): (o: Nat) →
    ((i: Nat) → (b: BitVec(8)) → bytes.nth(i) = Some(b) → v(o + i) = b) → cells_at(v, o, bytes.len()) = bytes {
    match bytes {
        Nil => λ o _ => refl,
        Cons(b, rest) => λ o at => eq2(λ (x: BitVec(8)) (t: List<BitVec(8)>) => Cons(x, t), at(0, b, refl),
            cells_of(v, rest, Succ(o), λ i c found => trans(cong_fn<Nat, BitVec(8)>(v, Nat::add_succ_left(o, i)), at(Succ(i), c, found)))),
    }
}

theorem cells_replicate(v: Nat → BitVec(8), z: BitVec(8), n: Nat): (o: Nat) → ((i: Nat) → i < n → v(o + i) = z) →
    cells_at(v, o, n) = List::replicate(z, n) {
    match n {
        Zero => λ o _ => refl,
        Succ(_, ih) => λ o same => eq2(λ (x: BitVec(8)) (t: List<BitVec(8)>) => Cons(x, t), same(0, trivial),
            ih(Succ(o), λ i below => trans(cong_fn<Nat, BitVec(8)>(v, Nat::add_succ_left(o, i)), same(Succ(i), below)))),
    }
}

// A list no longer than the count is its own prefix.
theorem List::take_long<A>(self xs: List<A>): (k: Nat) → xs.len() <= k → xs.take(k) = xs {
    match xs {
        Nil => λ k _ => refl,
        Cons(h, t) => λ k => match k {
            Zero => λ bad => false_elim(bad),
            Succ(l) => λ le => List::cong_cons(h, t.take_long(l, le)),
        },
    }
}

// Bytes landed at a buffer's start no longer than it: the bytes, then the
// rest of the buffer.
theorem fill_short(buffer, bytes: List<BitVec(8)>, short: bytes.len() <= buffer.len()):
    fill(buffer, bytes) = bytes ++ buffer.drop(bytes.len()) {
    let whole: ((bytes ++ buffer.drop(bytes.len())).len() <= buffer.len()) =
        j(sym(bytes.len_append(buffer.drop(bytes.len()))), λ n _ => n <= buffer.len(),
            j(sym(buffer.len_drop(bytes.len())), λ d _ => bytes.len() + d <= buffer.len(), omega(short)));
    (bytes ++ buffer.drop(bytes.len())).take_long(buffer.len(), whole)
}

// ---------------------------------------------------------------------------
// Where the layout puts each buffer

// A buffer's range is a piece of the capacities packed after the words
// (`Span::packed`, lib/std/data/set/span_set.hthr, which proves that each
// ends before the scratch range and before any later one starts)…

// …and the scratch range holds any of them.
theorem List::largest_nth(self caps: List<Nat>): (b, cap: Nat) → caps.nth(b) = Some(cap) → cap <= caps.largest() {
    match caps {
        Nil => λ b cap found => absurd(found),
        Cons(size, rest) => λ b cap => match b {
            Zero => λ found => j(Option::some_inj(size, cap, found), λ c _ => c <= size.max(rest.largest()), size.le_max_l(rest.largest())),
            Succ(k) => λ found => Nat::le_trans(cap, rest.largest(), size.max(rest.largest()), rest.largest_nth(k, cap, found),
                size.le_max_r(rest.largest())),
        },
    }
}

// ---------------------------------------------------------------------------
// Words the machine and the source spell differently

theorem Bool::and_true(self b: Bool): (b && True) = b { match b { False => refl, True => refl } }

// The low bit of a word, masked, is the bit zero-extended: how a one-bit
// port is loaded (`Prog::bit_to`).
theorem mask_low_bit(n: Nat): BitVec::ofNat(n, n := 64).band(BitVec::ofNat(1)) = BitVec::ofNat(n, n := 1).zero_extend(63) {
    eq2(λ (rest: BitVec(63)) (b: Bool) => rest.cons_bit(b), BitVec::band_zero_r(63, BitVec::ofNat(n.half(), n := 63)), BitVec::odd_bit(n).and_true())
}

// The negated errno: the source negates it, Linux counts down from the top.
theorem source_errno_word(e: Nat, error: Errno(e)): native_source::errno_word(e) = linux_x86_64_io::errno_word(e) {
    let b = BitVec::ofNat(e, n := 64);
    let y = linux_x86_64_io::errno_word(e);
    let top = Nat::pow(2, 64);
    let fits: (e < top) = omega(error.right);
    let y_is: (BitVec::zero(n := 64).iterate_increment(top - e) = y) =
        trans(BitVec::cong_iterate_increment_count(64, BitVec::zero(), sym(errno_value(e, error))), BitVec::iterate_increment_toNat(64, y));
    let below: (e <= top) = omega(fits);
    let sum: (y.add(b) = BitVec::zero()) = trans(sym(BitVec::iter_add_eq_add(64, y, b)),
        trans(BitVec::cong_iterate_increment_count(64, y, BitVec::toNat_ofNat(64, e, fits)),
        trans(BitVec::cong_iterate_increment(64, e, sym(y_is)),
        trans(BitVec::iterate_increment_compose(64, BitVec::zero(), top - e, e),
        trans(BitVec::cong_iterate_increment_count(64, BitVec::zero(), Nat::sub_add_cancel(e, top, below)), BitVec::zero_iterate_period(64))))));
    trans(sym(cong_fn<BitVec(64), BitVec(64)>(λ x => x.sub(b), sum)), BitVec::add_sub_cancel(64, y, b))
}

// ---------------------------------------------------------------------------
// The stack a call takes (`List::reach`)

// An unchecked callee's level and its row's entry are within the deepest.
fn Nat::step_of(self callee: Nat, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, row: List<Nat>) → Nat {
    match checks.checked(callee) { True => 0, False => bodies.frame(callee).level(places) + row.deep_at(callee) }
}

theorem List::deepest_mem(self callees: List<Nat>, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, row: List<Nat>): (index: Nat) → Mem(index, callees) →
    index.step_of(bodies, places, checks, row) <= callees.deepest(bodies, places, checks, row) {
    match callees {
        Nil => λ index never => false_elim(never),
        Cons(callee, rest) => λ index m => {
            let here = callee.step_of(bodies, places, checks, row);
            match m {
                Inl(e) => j(sym(e), λ x _ => x.step_of(bodies, places, checks, row) <= Nat::max(here, rest.deepest(bodies, places, checks, row)),
                    Nat::le_max_l(here, rest.deepest(bodies, places, checks, row))),
                Inr(later) => Nat::le_trans(index.step_of(bodies, places, checks, row), rest.deepest(bodies, places, checks, row),
                    Nat::max(here, rest.deepest(bodies, places, checks, row)), rest.deepest_mem(bodies, places, checks, row, index, later),
                    Nat::le_max_r(here, rest.deepest(bodies, places, checks, row))),
            }
        },
    }
}

// A row has no entry where the procedures have none.
theorem List::deep_map_none(self procedures: List<Procedure>, f: Procedure → Nat): (index: Nat) → procedures.nth(index) = None →
    procedures.map(f).deep_at(index) = 0 {
    match procedures {
        Nil => λ index _ => refl,
        Cons(_, rest) => λ index => match index {
            Zero => λ none => absurd(none),
            Succ(k) => λ none => rest.deep_map_none(f, k, none),
        },
    }
}

// A function `called` holds takes its room and return address within what
// the calls of `called` take.
theorem List::functions_room_mem(self called: List<Nat>, table: List<Nat>): (f: Nat) → Mem(f, called) →
    rooms_at(table, f) + 8 <= called.functions_room(table) {
    match called {
        Nil => λ f never => false_elim(never),
        Cons(g, rest) => λ f m => match m {
            Inl(e) => j(sym(e), λ x _ => rooms_at(table, x) + 8 <= Nat::max(rooms_at(table, g) + 8, rest.functions_room(table)),
                Nat::le_max_l(rooms_at(table, g) + 8, rest.functions_room(table))),
            Inr(later) => Nat::le_trans(rooms_at(table, f) + 8, rest.functions_room(table), Nat::max(rooms_at(table, g) + 8, rest.functions_room(table)),
                rest.functions_room_mem(table, f, later), Nat::le_max_r(rooms_at(table, g) + 8, rest.functions_room(table))),
        },
    }
}

// A row's entry for a procedure is what its body takes below its frame.
theorem List::deep_row_at(self procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>, d, index: Nat):
    procedures.deep_row(bodies, places, table, checks, d).deep_at(index) =
        procedures.performed_by(index).below(procedures.called_by(index), procedures, bodies, places, table, checks, d) {
    let f = λ (proc: Procedure) => proc.body.performed().below(proc.body.called(), procedures, bodies, places, table, checks, d);
    let row_is: (procedures.deep_row(bodies, places, table, checks, d) = procedures.map(f)) = match d { Zero => refl, Succ(_) => refl };
    let nil_is: (0 = Nat::max([].reach(procedures, bodies, places, table, checks, d), 0)) = match d { Zero => refl, Succ(_) => refl };
    let by = λ (o: Option<Procedure>) => (match o { None => [], Some(proc) => proc.body.performed() })
        .below(match o { None => [], Some(proc) => proc.body.called() }, procedures, bodies, places, table, checks, d);
    let at = cong_fn<List<Nat>, Nat>(λ row => row.deep_at(index), row_is);
    match found: procedures.nth(index) {
        None => trans(at, trans(procedures.deep_map_none(f, index, found), trans(nil_is, sym(cong_fn<Option<Procedure>, Nat>(by, found))))),
        Some(proc) => trans(at, trans(j(sym(procedures.nth_map_some(f, index, proc, found)), λ o _ => (match o { None => 0, Some(deep) => deep }) = f(proc), refl),
            sym(cong_fn<Option<Procedure>, Nat>(by, found)))),
    }
}

// A call without a check of a procedure the body may call, with room: the
// callee's level and what the callee's body takes below its frame, within
// what the body's calls take.
theorem List::reach_call(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    d, index: Nat, held: callees.holds(index) = True, unchecked: checks.checked(index) = False):
    bodies.frame(index).level(places) + procedures.performed_by(index).below(procedures.called_by(index), procedures, bodies, places, table, checks, d) <=
        callees.reach(procedures, bodies, places, table, checks, Succ(d)) {
    let row = procedures.deep_row(bodies, places, table, checks, d);
    let step: (index.step_of(bodies, places, checks, row) = bodies.frame(index).level(places) + row.deep_at(index)) =
        j(sym(unchecked), λ b _ => (match b { True => 0, False => bodies.frame(index).level(places) + row.deep_at(index) }) =
            bodies.frame(index).level(places) + row.deep_at(index), refl);
    j(procedures.deep_row_at(bodies, places, table, checks, d, index),
        λ deep _ => bodies.frame(index).level(places) + deep <= callees.reach(procedures, bodies, places, table, checks, Succ(d)),
        j(step, λ x _ => x <= callees.reach(procedures, bodies, places, table, checks, Succ(d)),
            callees.deepest_mem(bodies, places, checks, row, index, callees.holds_mem(index, held))))
}

// ---------------------------------------------------------------------------
// Room in levels (docs/native/native-procedure-frames-design.md §7.4): the
// charges a compile picks fit levels of checked calls, wherever the ranks
// hold of the source (`Source::charges_levels`).

// Larger on both sides, larger maximum.
theorem Nat::max_mono(self a: Nat, b, c, d: Nat, ac: a <= c, bd: b <= d): a.max(b) <= c.max(d) {
    Nat::max_le(a, b, c.max(d), Nat::le_trans(a, c, c.max(d), ac, Nat::le_max_l(c, d)), Nat::le_trans(b, d, c.max(d), bd, Nat::le_max_r(c, d)))
}

// One row within another, entry by entry; no row within any.
fn List::RowWithin(self row: List<Nat>, row2: List<Nat>) → Type { (i: Nat) → row.deep_at(i) <= row2.deep_at(i) }
fn Option::RowWithin(self row: Option<List<Nat>>, row2: Option<List<Nat>>) → Type {
    match row { None => True, Some(r) => match row2 as λ _ => Type { None => False, Some(r2) => r.RowWithin(r2) } }
}

// Larger levels and a larger row, a larger step.
theorem Nat::step_by_le(self callee: Nat, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, levels, levels2: List<Nat>, row, row2: Option<List<Nat>>,
    hl: levels.RowWithin(levels2), hr: row.RowWithin(row2)):
    callee.step_by(bodies, places, checks, levels, row) <= callee.step_by(bodies, places, checks, levels2, row2) {
    match checks.checked(callee) as λ b =>
        (match b { True => levels.deep_at(callee), False => match row { None => 0, Some(r) => bodies.frame(callee).level(places) + r.deep_at(callee) } }) <=
            (match b { True => levels2.deep_at(callee), False => match row2 { None => 0, Some(r) => bodies.frame(callee).level(places) + r.deep_at(callee) } }) {
        True => hl(callee),
        False => (match row as λ o => o.RowWithin(row2) →
                (match o { None => 0, Some(r) => bodies.frame(callee).level(places) + r.deep_at(callee) }) <=
                    (match row2 { None => 0, Some(r) => bodies.frame(callee).level(places) + r.deep_at(callee) }) {
            None => λ _ => trivial,
            Some(r) => (match row2 as λ o2 => Option::RowWithin(Some(r), o2) →
                    bodies.frame(callee).level(places) + r.deep_at(callee) <= (match o2 { None => 0, Some(r2) => bodies.frame(callee).level(places) + r2.deep_at(callee) }) {
                None => λ never => false_elim(never),
                Some(r2) => λ within => {
                    let more: (bodies.frame(callee).level(places) + r.deep_at(callee) <= bodies.frame(callee).level(places) + r2.deep_at(callee)) = omega(within(callee));
                    more
                },
            }),
        })(hr),
    }
}

theorem List::deepest_by_le(self callees: List<Nat>, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, levels, levels2: List<Nat>, row, row2: Option<List<Nat>>,
    hl: levels.RowWithin(levels2), hr: row.RowWithin(row2)):
    callees.deepest_by(bodies, places, checks, levels, row) <= callees.deepest_by(bodies, places, checks, levels2, row2) {
    match callees {
        Nil => Nat::le_refl(0),
        Cons(callee, rest) => Nat::max_mono(callee.step_by(bodies, places, checks, levels, row), rest.deepest_by(bodies, places, checks, levels, row),
            callee.step_by(bodies, places, checks, levels2, row2), rest.deepest_by(bodies, places, checks, levels2, row2),
            callee.step_by_le(bodies, places, checks, levels, levels2, row, row2, hl, hr), rest.deepest_by_le(bodies, places, checks, levels, levels2, row, row2, hl, hr)),
    }
}

// A callee's step is within the deepest.
theorem List::deepest_by_mem(self callees: List<Nat>, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, levels: List<Nat>, row: Option<List<Nat>>):
    (index: Nat) → Mem(index, callees) → index.step_by(bodies, places, checks, levels, row) <= callees.deepest_by(bodies, places, checks, levels, row) {
    match callees {
        Nil => λ index never => false_elim(never),
        Cons(callee, rest) => λ index m => {
            let here = callee.step_by(bodies, places, checks, levels, row);
            match m {
                Inl(e) => j(sym(e), λ x _ => x.step_by(bodies, places, checks, levels, row) <= Nat::max(here, rest.deepest_by(bodies, places, checks, levels, row)),
                    Nat::le_max_l(here, rest.deepest_by(bodies, places, checks, levels, row))),
                Inr(later) => Nat::le_trans(index.step_by(bodies, places, checks, levels, row), rest.deepest_by(bodies, places, checks, levels, row),
                    Nat::max(here, rest.deepest_by(bodies, places, checks, levels, row)), rest.deepest_by_mem(bodies, places, checks, levels, row, index, later),
                    Nat::le_max_r(here, rest.deepest_by(bodies, places, checks, levels, row))),
            }
        },
    }
}

// A row's entry for a procedure is what its body takes below its frame.
theorem List::deep_row_by_at(self procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>, levels: List<Nat>, d, index: Nat):
    procedures.deep_row_by(bodies, places, table, checks, levels, d).deep_at(index) =
        procedures.performed_by(index).below_by(procedures.called_by(index), procedures, bodies, places, table, checks, levels, d) {
    let f = λ (proc: Procedure) => proc.body.performed().below_by(proc.body.called(), procedures, bodies, places, table, checks, levels, d);
    let row_is: (procedures.deep_row_by(bodies, places, table, checks, levels, d) = procedures.map(f)) = match d { Zero => refl, Succ(_) => refl };
    let nil_is: (0 = Nat::max([].reach_by(procedures, bodies, places, table, checks, levels, d), 0)) = match d { Zero => refl, Succ(_) => refl };
    let by = λ (o: Option<Procedure>) => (match o { None => [], Some(proc) => proc.body.performed() })
        .below_by(match o { None => [], Some(proc) => proc.body.called() }, procedures, bodies, places, table, checks, levels, d);
    let at = cong_fn<List<Nat>, Nat>(λ row => row.deep_at(index), row_is);
    match found: procedures.nth(index) {
        None => trans(at, trans(procedures.deep_map_none(f, index, found), trans(nil_is, sym(cong_fn<Option<Procedure>, Nat>(by, found))))),
        Some(proc) => trans(at, trans(j(sym(procedures.nth_map_some(f, index, proc, found)), λ o _ => (match o { None => 0, Some(deep) => deep }) = f(proc), refl),
            sym(cong_fn<Option<Procedure>, Nat>(by, found)))),
    }
}

// Larger levels, at least as much reach.
theorem List::reach_by_levels(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels, levels2: List<Nat>, hl: levels.RowWithin(levels2), d: Nat):
    callees.reach_by(procedures, bodies, places, table, checks, levels, d) <= callees.reach_by(procedures, bodies, places, table, checks, levels2, d) {
    match d {
        Zero => callees.deepest_by_le(bodies, places, checks, levels, levels2, None, None, hl, trivial),
        Succ(k) => callees.deepest_by_le(bodies, places, checks, levels, levels2,
            Some(procedures.deep_row_by(bodies, places, table, checks, levels, k)), Some(procedures.deep_row_by(bodies, places, table, checks, levels2, k)), hl, λ i => {
                let callees_i = procedures.performed_by(i);
                let called_i = procedures.called_by(i);
                let grows: (callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels, k) <=
                        callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels2, k)) =
                    Nat::max_mono(callees_i.reach_by(procedures, bodies, places, table, checks, levels, k), called_i.functions_room(table),
                        callees_i.reach_by(procedures, bodies, places, table, checks, levels2, k), called_i.functions_room(table),
                        callees_i.reach_by_levels(procedures, bodies, places, table, checks, levels, levels2, hl, k), Nat::le_refl(called_i.functions_room(table)));
                j(sym(procedures.deep_row_by_at(bodies, places, table, checks, levels2, k, i)),
                    λ x _ => procedures.deep_row_by(bodies, places, table, checks, levels, k).deep_at(i) <= x,
                    j(sym(procedures.deep_row_by_at(bodies, places, table, checks, levels, k, i)),
                        λ x _ => x <= callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels2, k), grows))
            }),
    }
}

// One more level of room, at least as much reach.
theorem List::reach_by_step(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels: List<Nat>, d: Nat):
    callees.reach_by(procedures, bodies, places, table, checks, levels, d) <= callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(d)) {
    match d {
        Zero => callees.deepest_by_le(bodies, places, checks, levels, levels, None, Some(procedures.deep_row_by(bodies, places, table, checks, levels, 0)),
            λ i => Nat::le_refl(levels.deep_at(i)), trivial),
        Succ(k) => callees.deepest_by_le(bodies, places, checks, levels, levels,
            Some(procedures.deep_row_by(bodies, places, table, checks, levels, k)), Some(procedures.deep_row_by(bodies, places, table, checks, levels, Succ(k))),
            λ i => Nat::le_refl(levels.deep_at(i)), λ i => {
                let callees_i = procedures.performed_by(i);
                let called_i = procedures.called_by(i);
                let grows: (callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels, k) <=
                        callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels, Succ(k))) =
                    Nat::max_mono(callees_i.reach_by(procedures, bodies, places, table, checks, levels, k), called_i.functions_room(table),
                        callees_i.reach_by(procedures, bodies, places, table, checks, levels, Succ(k)), called_i.functions_room(table),
                        callees_i.reach_by_step(procedures, bodies, places, table, checks, levels, k), Nat::le_refl(called_i.functions_room(table)));
                j(sym(procedures.deep_row_by_at(bodies, places, table, checks, levels, Succ(k), i)),
                    λ x _ => procedures.deep_row_by(bodies, places, table, checks, levels, k).deep_at(i) <= x,
                    j(sym(procedures.deep_row_by_at(bodies, places, table, checks, levels, k, i)),
                        λ x _ => x <= callees_i.below_by(called_i, procedures, bodies, places, table, checks, levels, Succ(k)), grows))
            }),
    }
}

theorem List::reach_by_up(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels: List<Nat>, d, m: Nat):
    callees.reach_by(procedures, bodies, places, table, checks, levels, d) <= callees.reach_by(procedures, bodies, places, table, checks, levels, d + m) {
    match m {
        Zero => Nat::le_refl(callees.reach_by(procedures, bodies, places, table, checks, levels, d)),
        Succ(k) => Nat::le_trans(callees.reach_by(procedures, bodies, places, table, checks, levels, d),
            callees.reach_by(procedures, bodies, places, table, checks, levels, d + k),
            callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(d + k)), callees.reach_by_up(procedures, bodies, places, table, checks, levels, d, k),
            callees.reach_by_step(procedures, bodies, places, table, checks, levels, d + k)),
    }
}

// More levels of rank, at least as much reach.
theorem List::reach_by_le(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels: List<Nat>, d, e: Nat, le: d <= e):
    callees.reach_by(procedures, bodies, places, table, checks, levels, d) <= callees.reach_by(procedures, bodies, places, table, checks, levels, e) {
    let is: (d + (e - d) = e) = omega(le);
    j(is, λ x _ => callees.reach_by(procedures, bodies, places, table, checks, levels, d) <= callees.reach_by(procedures, bodies, places, table, checks, levels, x),
        callees.reach_by_up(procedures, bodies, places, table, checks, levels, d, e - d))
}

// With no levels a checked callee takes nothing, and nothing with no row.
theorem List::deepest_by_none(self callees: List<Nat>, bodies: List<Frame>, places: List<Place>, checks: List<Bool>):
    callees.deepest_by(bodies, places, checks, [], None) = 0 {
    match callees {
        Nil => refl,
        Cons(callee, rest) => {
            let step: (callee.step_by(bodies, places, checks, [], None) = 0) =
                match checks.checked(callee) as λ b => (match b { True => [].deep_at(callee), False => 0 }) = 0 {
                    True => refl,
                    False => refl,
                };
            let rest_is = rest.deepest_by_none(bodies, places, checks);
            j(sym(step), λ x _ => Nat::max(x, rest.deepest_by(bodies, places, checks, [], None)) = 0, rest_is)
        },
    }
}

// With no levels and a row equal to `below`'s, the deepest is `below`'s.
theorem List::deepest_by_same(self callees: List<Nat>, bodies: List<Frame>, places: List<Place>, checks: List<Bool>, row_by, row: List<Nat>,
    same: (i: Nat) → row_by.deep_at(i) = row.deep_at(i)):
    callees.deepest_by(bodies, places, checks, [], Some(row_by)) = callees.deepest(bodies, places, checks, row) {
    match callees {
        Nil => refl,
        Cons(callee, rest) => {
            let step: (callee.step_by(bodies, places, checks, [], Some(row_by)) = callee.step_of(bodies, places, checks, row)) =
                match checks.checked(callee) as λ b =>
                    (match b { True => [].deep_at(callee), False => bodies.frame(callee).level(places) + row_by.deep_at(callee) }) =
                        (match b { True => 0, False => bodies.frame(callee).level(places) + row.deep_at(callee) }) {
                    True => refl,
                    False => cong_fn<Nat, Nat>(λ x => bodies.frame(callee).level(places) + x, same(callee)),
                };
            let rest_is = rest.deepest_by_same(bodies, places, checks, row_by, row, same);
            j(rest_is, λ x _ => Nat::max(callee.step_by(bodies, places, checks, [], Some(row_by)), rest.deepest_by(bodies, places, checks, [], Some(row_by))) =
                    Nat::max(callee.step_of(bodies, places, checks, row), x),
                j(step, λ x _ => Nat::max(callee.step_by(bodies, places, checks, [], Some(row_by)), rest.deepest_by(bodies, places, checks, [], Some(row_by))) =
                    Nat::max(x, rest.deepest_by(bodies, places, checks, [], Some(row_by))), refl))
        },
    }
}

// With no levels the stack below a frame is `below`'s.
theorem List::reach_by_none(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>, d: Nat):
    callees.reach_by(procedures, bodies, places, table, checks, [], d) = callees.reach(procedures, bodies, places, table, checks, d) {
    match d {
        Zero => callees.deepest_by_none(bodies, places, checks),
        Succ(k) => callees.deepest_by_same(bodies, places, checks, procedures.deep_row_by(bodies, places, table, checks, [], k),
            procedures.deep_row(bodies, places, table, checks, k), λ i => {
                let callees_i = procedures.performed_by(i);
                let called_i = procedures.called_by(i);
                let inner = callees_i.reach_by_none(procedures, bodies, places, table, checks, k);
                trans(procedures.deep_row_by_at(bodies, places, table, checks, [], k, i),
                    trans(cong_fn<Nat, Nat>(λ x => Nat::max(x, called_i.functions_room(table)), inner),
                        sym(procedures.deep_row_at(bodies, places, table, checks, k, i))))
            }),
    }
}

theorem List::below_by_none(self callees: List<Nat>, called: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>,
    checks: List<Bool>, d: Nat):
    callees.below_by(called, procedures, bodies, places, table, checks, [], d) = callees.below(called, procedures, bodies, places, table, checks, d) {
    cong_fn<Nat, Nat>(λ x => Nat::max(x, called.functions_room(table)), callees.reach_by_none(procedures, bodies, places, table, checks, d))
}

// Any levels, at least `below`.
theorem List::below_le_by(self callees: List<Nat>, called: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>,
    checks: List<Bool>, levels: List<Nat>, d: Nat):
    callees.below(called, procedures, bodies, places, table, checks, d) <= callees.below_by(called, procedures, bodies, places, table, checks, levels, d) {
    j(callees.below_by_none(called, procedures, bodies, places, table, checks, d),
        λ x _ => x <= callees.below_by(called, procedures, bodies, places, table, checks, levels, d),
        Nat::max_mono(callees.reach_by(procedures, bodies, places, table, checks, [], d), called.functions_room(table),
            callees.reach_by(procedures, bodies, places, table, checks, levels, d), called.functions_room(table),
            callees.reach_by_levels(procedures, bodies, places, table, checks, [], levels, λ i => omega(), d), Nat::le_refl(called.functions_room(table))))
}

// A call without a check of a procedure the body may call, with room: the
// callee's level and what its body takes below its frame, within the
// body's reach one level of room deeper.
theorem List::reach_by_call(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels: List<Nat>, d, index: Nat, m: Mem(index, callees), unchecked: checks.checked(index) = False):
    bodies.frame(index).level(places) + procedures.performed_by(index).below_by(procedures.called_by(index), procedures, bodies, places, table, checks, levels, d) <=
        callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(d)) {
    let row = procedures.deep_row_by(bodies, places, table, checks, levels, d);
    let step: (index.step_by(bodies, places, checks, levels, Some(row)) = bodies.frame(index).level(places) + row.deep_at(index)) =
        j(sym(unchecked), λ b _ => (match b { True => levels.deep_at(index), False => bodies.frame(index).level(places) + row.deep_at(index) }) =
            bodies.frame(index).level(places) + row.deep_at(index), refl);
    j(procedures.deep_row_by_at(bodies, places, table, checks, levels, d, index),
        λ deep _ => bodies.frame(index).level(places) + deep <= callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(d)),
        j(step, λ x _ => x <= callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(d)),
            callees.deepest_by_mem(bodies, places, checks, levels, Some(row), index, m)))
}

// A checked callee's entry in the levels is within the body's reach.
theorem List::reach_by_checked(self callees: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    levels: List<Nat>, d, index: Nat, m: Mem(index, callees), checked: checks.checked(index) = True):
    levels.deep_at(index) <= callees.reach_by(procedures, bodies, places, table, checks, levels, d) {
    let at = λ (row: Option<List<Nat>>) => {
        let step: (index.step_by(bodies, places, checks, levels, row) = levels.deep_at(index)) =
            j(sym(checked), λ b _ => (match b {
                True => levels.deep_at(index),
                False => match row { None => 0, Some(r) => bodies.frame(index).level(places) + r.deep_at(index) },
            }) = levels.deep_at(index), refl);
        j(step, λ x _ => x <= callees.deepest_by(bodies, places, checks, levels, row), callees.deepest_by_mem(bodies, places, checks, levels, row, index, m))
    };
    match d { Zero => at(None), Succ(k) => at(Some(procedures.deep_row_by(bodies, places, table, checks, levels, k))) }
}

// The entry of a procedure the levels row has.
theorem List::calls_from_at(self rest: List<Procedure>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>, checks: List<Bool>,
    ranks: List<Nat>, levels: List<Nat>, index: Nat): (i: Nat) → (proc: Procedure) → rest.nth(i) = Some(proc) →
    rest.calls_from(procedures, bodies, places, table, checks, ranks, levels, index).deep_at(i) =
        bodies.frame(index + i).level(places) + proc.body.performed().below_by(proc.body.called(), procedures, bodies, places, table, checks, levels, ranks.deep_at(index + i)) {
    match rest {
        Nil => λ i proc no => false_elim(j(no, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
        Cons(first, more) => λ i => match i {
            Zero => λ proc found => {
                let same: (first = proc) = cong_fn<Option<Procedure>, Procedure>(λ o => match o { None => first, Some(x) => x }, found);
                j(same, λ x _ => bodies.frame(index).level(places) + first.body.performed().below_by(first.body.called(), procedures, bodies, places, table, checks, levels,
                        ranks.deep_at(index)) =
                    bodies.frame(index).level(places) + x.body.performed().below_by(x.body.called(), procedures, bodies, places, table, checks, levels, ranks.deep_at(index)), refl)
            },
            Succ(k) => λ proc found => {
                let is: (Succ(index) + k = index + Succ(k)) = omega();
                j(is, λ x _ => more.calls_from(procedures, bodies, places, table, checks, ranks, levels, Succ(index)).deep_at(k) =
                        bodies.frame(x).level(places) + proc.body.performed().below_by(proc.body.called(), procedures, bodies, places, table, checks, levels, ranks.deep_at(x)),
                    more.calls_from_at(procedures, bodies, places, table, checks, ranks, levels, Succ(index), k, proc, found))
            },
        },
    }
}

// What a call of procedure `p` takes with `j + 1` levels: its level and
// what its body takes with `j`.
theorem Source::level_row_at(self src: Source, homes: Homes, bodies: List<Frame>, j, p: Nat, proc: Procedure, found: src.procedures.nth(p) = Some(proc)):
    src.procedures.level_row(bodies, homes.places, homes.room_table(src.functions), src.procedures.checks(), src.procedures.ranks(src.procedures.checks()), Succ(j)).deep_at(p) =
        bodies.frame(p).level(homes.places) + src.total(homes, bodies, j, p) {
    let checks = src.procedures.checks();
    let ranks = src.procedures.ranks(checks);
    let table = homes.room_table(src.functions);
    let levels = src.procedures.level_row(bodies, homes.places, table, checks, ranks, j);
    let is: (0 + p = p) = omega();
    let at = j(is, λ x _ => src.procedures.calls_from(src.procedures, bodies, homes.places, table, checks, ranks, levels, 0).deep_at(p) =
            bodies.frame(x).level(homes.places) + proc.body.performed().below_by(proc.body.called(), src.procedures, bodies, homes.places, table, checks, levels, ranks.deep_at(x)),
        src.procedures.calls_from_at(src.procedures, bodies, homes.places, table, checks, ranks, levels, 0, p, proc, found));
    j(sym(found), λ o _ => src.procedures.calls_from(src.procedures, bodies, homes.places, table, checks, ranks, levels, 0).deep_at(p) =
            bodies.frame(p).level(homes.places) + (match o { None => [], Some(pr) => pr.body.performed() }).below_by(match o { None => [], Some(pr) => pr.body.called() },
                src.procedures, bodies, homes.places, table, checks, levels, ranks.deep_at(p)), at)
}

// A call without a check among callees under a rank goes below it.
theorem List::under_rank_mem(self callees: List<Nat>, checks: List<Bool>, ranks: List<Nat>, rank: Nat, under: callees.under_rank(checks, ranks, rank).IsTrue()):
    (p: Nat) → Mem(p, callees) → checks.checked(p) = False → Succ(ranks.deep_at(p)) <= rank {
    match callees {
        Nil => λ p never => false_elim(never),
        Cons(c, rest) => λ p m unchecked => {
            let parts = Bool::both(under);
            match m {
                Inl(e) => {
                    let unc: (checks.checked(c) = False) = j(e, λ x _ => checks.checked(x) = False, unchecked);
                    let below_c = (match checks.checked(c) as λ b => (b || Succ(ranks.deep_at(c)).leb(rank)).IsTrue() → b = False → Succ(ranks.deep_at(c)) <= rank {
                        True => λ _ no => absurd(no),
                        False => λ fits _ => Nat::leb_sound(Succ(ranks.deep_at(c)), rank, fits),
                    })(parts.left, unc);
                    j(sym(e), λ x _ => Succ(ranks.deep_at(x)) <= rank, below_c)
                },
                Inr(later) => rest.under_rank_mem(checks, ranks, rank, parts.right, p, later, unchecked),
            }
        },
    }
}

// The procedure at an index of ranked procedures calls under its rank.
theorem List::ranked_from_at(self rest: List<Procedure>, checks: List<Bool>, ranks: List<Nat>, index: Nat, ranked: rest.ranked_from(checks, ranks, index).IsTrue()):
    (i: Nat) → (proc: Procedure) → rest.nth(i) = Some(proc) → proc.body.performed().under_rank(checks, ranks, ranks.deep_at(index + i)).IsTrue() {
    match rest {
        Nil => λ i proc no => false_elim(j(no, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
        Cons(first, more) => λ i => {
            let parts = Bool::both(ranked);
            match i {
                Zero => λ proc found => {
                    let same: (first = proc) = cong_fn<Option<Procedure>, Procedure>(λ o => match o { None => first, Some(x) => x }, found);
                    j(same, λ x _ => x.body.performed().under_rank(checks, ranks, ranks.deep_at(index)).IsTrue(), parts.left)
                },
                Succ(k) => λ proc found => {
                    let is: (Succ(index) + k = index + Succ(k)) = omega();
                    j(is, λ x _ => proc.body.performed().under_rank(checks, ranks, ranks.deep_at(x)).IsTrue(),
                        more.ranked_from_at(checks, ranks, Succ(index), parts.right, k, proc, found))
                },
            }
        },
    }
}

// Procedures that have one at an index and hold their ranks: each
// procedure's and `main`'s calls.
theorem List::ranked_parts(self procedures: List<Procedure>, main: Stmt, i: Nat, proc: Procedure, found: procedures.nth(i) = Some(proc), ranked: procedures.ranked_with(main) = True):
    (procedures.ranked_from(procedures.checks(), procedures.ranks(procedures.checks()), 0) &&
        main.performed().under_rank(procedures.checks(), procedures.ranks(procedures.checks()), procedures.len())).IsTrue() {
    (match procedures as λ ps => ps.nth(i) = Some(proc) → ps.ranked_with(main) = True →
            (ps.ranked_from(ps.checks(), ps.ranks(ps.checks()), 0) && main.performed().under_rank(ps.checks(), ps.ranks(ps.checks()), ps.len())).IsTrue() {
        Nil => λ no _ => false_elim(j(no, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
        Cons(_, _) => λ _ r => Bool::is_true_of_eq(r),
    })(found, ranked)
}

// A call without a check from a body ranked above it, with any levels:
// the callee's level and what its body takes at its rank, within what the
// caller's body takes at its own.
theorem List::below_by_call(self callees: List<Nat>, called: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>,
    checks: List<Bool>, ranks: List<Nat>, levels: List<Nat>, rank, p: Nat, m: Mem(p, callees), unchecked: checks.checked(p) = False,
    ranked: Succ(ranks.deep_at(p)) <= rank):
    bodies.frame(p).level(places) + procedures.performed_by(p).below_by(procedures.called_by(p), procedures, bodies, places, table, checks, levels, ranks.deep_at(p)) <=
        callees.below_by(called, procedures, bodies, places, table, checks, levels, rank) {
    Nat::le_trans(
        bodies.frame(p).level(places) + procedures.performed_by(p).below_by(procedures.called_by(p), procedures, bodies, places, table, checks, levels, ranks.deep_at(p)),
        callees.reach_by(procedures, bodies, places, table, checks, levels, rank),
        callees.below_by(called, procedures, bodies, places, table, checks, levels, rank),
        Nat::le_trans(
            bodies.frame(p).level(places) + procedures.performed_by(p).below_by(procedures.called_by(p), procedures, bodies, places, table, checks, levels, ranks.deep_at(p)),
            callees.reach_by(procedures, bodies, places, table, checks, levels, Succ(ranks.deep_at(p))),
            callees.reach_by(procedures, bodies, places, table, checks, levels, rank),
            callees.reach_by_call(procedures, bodies, places, table, checks, levels, ranks.deep_at(p), p, m, unchecked),
            callees.reach_by_le(procedures, bodies, places, table, checks, levels, Succ(ranks.deep_at(p)), rank, ranked)),
        Nat::le_max_l(callees.reach_by(procedures, bodies, places, table, checks, levels, rank), called.functions_room(table)))
}

// A checked call with a level left: what it takes, its level and its body
// with one level fewer, is within what the caller's body takes.
theorem List::below_by_checked(self callees: List<Nat>, called: List<Nat>, procedures: List<Procedure>, bodies: List<Frame>, places: List<Place>, table: List<Nat>,
    checks: List<Bool>, levels: List<Nat>, rank, p: Nat, m: Mem(p, callees), checked: checks.checked(p) = True):
    levels.deep_at(p) <= callees.below_by(called, procedures, bodies, places, table, checks, levels, rank) {
    Nat::le_trans(levels.deep_at(p), callees.reach_by(procedures, bodies, places, table, checks, levels, rank),
        callees.below_by(called, procedures, bodies, places, table, checks, levels, rank),
        callees.reach_by_checked(procedures, bodies, places, table, checks, levels, rank, p, m, checked),
        Nat::le_max_l(callees.reach_by(procedures, bodies, places, table, checks, levels, rank), called.functions_room(table)))
}

// A call's step within the levels, from a body ranked as the source's
// ranks say (`rank`, its calls under it): the callee's cost and what its
// body takes with the levels the call leaves, within what the caller's body
// takes with the levels it has.
theorem Source::step_within(self src: Source, homes: Homes, bodies: List<Frame>, callees, called: List<Nat>, rank: Nat,
    under: callees.under_rank(src.procedures.checks(), src.procedures.ranks(src.procedures.checks()), rank).IsTrue(),
    p: Nat, callee: Procedure, found: src.procedures.nth(p) = Some(callee), m: Mem(p, callees), k, j: Nat, spent: k.spend(src.checked(p)) = Some(j)):
    bodies.frame(p).level(homes.places) + src.total(homes, bodies, j, p) <=
        callees.below_by(called, src.procedures, bodies, homes.places, homes.room_table(src.functions), src.procedures.checks(),
            src.procedures.level_row(bodies, homes.places, homes.room_table(src.functions), src.procedures.checks(), src.procedures.ranks(src.procedures.checks()), k), rank) {
    let checks = src.procedures.checks();
    let ranks = src.procedures.ranks(checks);
    let table = homes.room_table(src.functions);
    let goal = λ (j2: Nat) => bodies.frame(p).level(homes.places) + src.total(homes, bodies, j2, p) <=
        callees.below_by(called, src.procedures, bodies, homes.places, table, checks, src.procedures.level_row(bodies, homes.places, table, checks, ranks, k), rank);
    (match checks.checked(p) as λ b => checks.checked(p) = b → k.spend(b) = Some(j) → goal(j) {
        False => λ unc sp => {
            let same: (k = j) = cong_fn<Option<Nat>, Nat>(λ o => match o { None => k, Some(x) => x }, sp);
            j(same, λ x _ => goal(x),
                callees.below_by_call(called, src.procedures, bodies, homes.places, table, checks, ranks, src.procedures.level_row(bodies, homes.places, table, checks, ranks, k),
                    rank, p, m, unc, callees.under_rank_mem(checks, ranks, rank, under, p, m, unc)))
        },
        True => λ cnt => (match k as λ k2 => (match k2 { Zero => None, Succ(i) => Some(i) }) = Some(j) →
                bodies.frame(p).level(homes.places) + src.total(homes, bodies, j, p) <=
                    callees.below_by(called, src.procedures, bodies, homes.places, table, checks, src.procedures.level_row(bodies, homes.places, table, checks, ranks, k2), rank) {
            Zero => λ no => false_elim(j(no, λ o _ => match o as λ _ => Type { None => True, Some(_) => False }, trivial)),
            Succ(i) => λ sp => {
                let same: (i = j) = cong_fn<Option<Nat>, Nat>(λ o => match o { None => i, Some(x) => x }, sp);
                let row = src.procedures.level_row(bodies, homes.places, table, checks, ranks, Succ(i));
                j(same, λ x _ => bodies.frame(p).level(homes.places) + src.total(homes, bodies, x, p) <=
                        callees.below_by(called, src.procedures, bodies, homes.places, table, checks, row, rank),
                    j(src.level_row_at(homes, bodies, i, p, callee, found), λ x _ => x <= callees.below_by(called, src.procedures, bodies, homes.places, table, checks, row, rank),
                        callees.below_by_checked(called, src.procedures, bodies, homes.places, table, checks, row, rank, p, m, cnt)))
            },
        }),
    })(refl, spent)
}

// Where the ranks hold of the source, the charges any compile picks fit
// levels of checked calls: a checked procedure's check asks for its level,
// its body's room with no levels and a return address, no more than with
// any; and a call within the levels takes no more than its caller's body
// may (`Source::total`, `Source::top`).
theorem Source::charges_levels(self src: Source, homes: Homes, bodies: List<Frame>, ranked: src.ranked() = True):
    src.charges(homes, bodies).Levels(src, λ p => src.checked(p), λ k p => src.total(homes, bodies, k, p), λ k => src.top(homes, bodies, k)) {
    let checks = src.procedures.checks();
    let ranks = src.procedures.ranks(checks);
    let table = homes.room_table(src.functions);
    let places = homes.places;
    let need = λ (p: Nat) => src.procedures.need(p, bodies, places, table, checks, ranks);
    Charges::Levels(
        checked := λ p cnt asked asked_is j2 => {
            let is: (Some(need(p)) = Some(asked)) = trans(sym(j(sym(cnt), λ b _ => (match b { False => None, True => Some(need(p)) }) = Some(need(p)), refl)), asked_is);
            let same: (need(p) = asked) = cong_fn<Option<Nat>, Nat>(λ o => match o { None => need(p), Some(x) => x }, is);
            let more = src.procedures.performed_by(p).below_le_by(src.procedures.called_by(p), src.procedures, bodies, places, table, checks,
                src.procedures.level_row(bodies, places, table, checks, ranks, j2), ranks.deep_at(p));
            let need_is: (src.procedures.need(p, bodies, places, table, checks, ranks) = (bodies.frame(p).level(places) + src.procedures.performed_by(p).below(src.procedures.called_by(p), src.procedures, bodies, places, table,
                checks, ranks.deep_at(p))) + 8) = refl;
            let total_is: (src.total(homes, bodies, j2, p) = src.procedures.performed_by(p).below_by(src.procedures.called_by(p), src.procedures, bodies, places, table, checks,
                src.procedures.level_row(bodies, places, table, checks, ranks, j2), ranks.deep_at(p))) = refl;
            let cost_is: (src.charges(homes, bodies).cost(p) = bodies.frame(p).level(places)) = refl;
            let fits: (src.procedures.need(p, bodies, places, table, checks, ranks) <= (src.charges(homes, bodies).cost(p) + src.total(homes, bodies, j2, p)) + 8) =
                omega(more, need_is, total_is, cost_is);
            j(same, λ x _ => x <= (src.charges(homes, bodies).cost(p) + src.total(homes, bodies, j2, p)) + 8, fits)
        },
        unchecked := λ p unc => j(sym(unc), λ b _ => (match b { False => None, True => Some(need(p)) }) = None, refl),
        step := λ q proc found p callee found_p mem k j2 spent => {
            let parts = Bool::both(src.procedures.ranked_parts(src.main, q, proc, found, ranked));
            let is: (0 + q = q) = omega();
            let under_q = j(is, λ x _ => proc.body.performed().under_rank(checks, ranks, ranks.deep_at(x)).IsTrue(),
                src.procedures.ranked_from_at(checks, ranks, 0, parts.left, q, proc, found));
            let step = src.step_within(homes, bodies, proc.body.performed(), proc.body.called(), ranks.deep_at(q), under_q, p, callee, found_p, mem, k, j2, spent);
            j(sym(found), λ o _ => bodies.frame(p).level(places) + src.total(homes, bodies, j2, p) <=
                    (match o { None => [], Some(pr) => pr.body.performed() }).below_by(match o { None => [], Some(pr) => pr.body.called() }, src.procedures, bodies, places, table,
                        checks, src.procedures.level_row(bodies, places, table, checks, ranks, k), ranks.deep_at(q)), step)
        },
        main_step := λ p callee found_p mem k j2 spent => {
            let parts = Bool::both(src.procedures.ranked_parts(src.main, p, callee, found_p, ranked));
            src.step_within(homes, bodies, src.main.performed(), src.main.called(), src.procedures.len(), parts.right, p, callee, found_p, mem, k, j2, spent)
        })
}

// No entry of `a` passes the entry of `b` beside it by more than the gap.
theorem List::gap_at(self a: List<Nat>, b: List<Nat>): (p: Nat) → a.deep_at(p) - b.deep_at(p) <= a.gap(b) {
    match a {
        Nil => λ p => trivial,
        Cons(x, rest) => λ p => match p {
            Zero => {
                let head_is: (b.deep_at(0) = b.head_or(0)) = match b { Nil => refl, Cons(_, _) => refl };
                let at: (x - b.head_or(0) <= Nat::max(x - b.head_or(0), rest.gap(b.tail()))) = Nat::le_max_l(x - b.head_or(0), rest.gap(b.tail()));
                let a_is: (Cons(x, rest).deep_at(0) = x) = refl;
                let gap_is: (Cons(x, rest).gap(b) = Nat::max(x - b.head_or(0), rest.gap(b.tail()))) = refl;
                omega(head_is, at, a_is, gap_is)
            },
            Succ(i) => {
                let tail_is: (b.deep_at(Succ(i)) = b.tail().deep_at(i)) = match b { Nil => refl, Cons(_, _) => refl };
                let a_is: (Cons(x, rest).deep_at(Succ(i)) = rest.deep_at(i)) = refl;
                let later = rest.gap_at(b.tail(), i);
                let more: (rest.gap(b.tail()) <= Nat::max(x - b.head_or(0), rest.gap(b.tail()))) = Nat::le_max_r(x - b.head_or(0), rest.gap(b.tail()));
                let gap_is: (Cons(x, rest).gap(b) = Nat::max(x - b.head_or(0), rest.gap(b.tail()))) = refl;
                omega(tail_is, a_is, later, more, gap_is)
            },
        },
    }
}

// No procedure's body gains more than `Source::gain` over its period from
// as many levels as there are procedures.
theorem Source::gain_bound(self src: Source, homes: Homes, bodies: List<Frame>, period, q: Nat, proc: Procedure, found: src.procedures.nth(q) = Some(proc)):
    src.total(homes, bodies, src.procedures.len() + period, q) <= src.total(homes, bodies, src.procedures.len(), q) + src.gain(homes, bodies, period) {
    let checks = src.procedures.checks();
    let ranks = src.procedures.ranks(checks);
    let table = homes.room_table(src.functions);
    let from = src.procedures.len();
    let late = src.procedures.level_row(bodies, homes.places, table, checks, ranks, Succ(from + period));
    let early = src.procedures.level_row(bodies, homes.places, table, checks, ranks, Succ(from));
    let late_is = src.level_row_at(homes, bodies, from + period, q, proc, found);
    let early_is = src.level_row_at(homes, bodies, from, q, proc, found);
    let gap = late.gap_at(early, q);
    let most: (late.gap(early) <= src.gain(homes, bodies, period)) =
        Nat::le_max_l(late.gap(early), src.top(homes, bodies, from + period) - src.top(homes, bodies, from));
    omega(late_is, early_is, gap, most)
}

// Nor does `main`'s.
theorem Source::gain_top_bound(self src: Source, homes: Homes, bodies: List<Frame>, period: Nat):
    src.top(homes, bodies, src.procedures.len() + period) <= src.top(homes, bodies, src.procedures.len()) + src.gain(homes, bodies, period) {
    let checks = src.procedures.checks();
    let ranks = src.procedures.ranks(checks);
    let table = homes.room_table(src.functions);
    let from = src.procedures.len();
    let most: (src.top(homes, bodies, from + period) - src.top(homes, bodies, from) <= src.gain(homes, bodies, period)) =
        Nat::le_max_r(src.procedures.level_row(bodies, homes.places, table, checks, ranks, Succ(from + period))
                .gap(src.procedures.level_row(bodies, homes.places, table, checks, ranks, Succ(from))),
            src.top(homes, bodies, from + period) - src.top(homes, bodies, from));
    omega(most)
}

// The charges any compile picks fit the levels read in periods
// (`Source::room_total`, `Source::room_top`): what `Source::left` asks for
// with any number of levels.
theorem Source::charges_room(self src: Source, homes: Homes, bodies: List<Frame>, ranked: src.ranked() = True):
    src.charges(homes, bodies).Levels(src, λ p => src.checked(p), λ k p => src.room_total(homes, bodies, k, p), λ k => src.room_top(homes, bodies, k)) {
    let period = src.period(homes, bodies);
    src.charges(homes, bodies).levels_periodic(src, λ p => src.checked(p), λ k p => src.total(homes, bodies, k, p), λ k => src.top(homes, bodies, k),
        src.charges_levels(homes, bodies, ranked), src.procedures.len(), period, src.gain(homes, bodies, period), trivial,
        λ q proc found => src.gain_bound(homes, bodies, period, q, proc, found), src.gain_top_bound(homes, bodies, period))
}

// What `main`'s body takes with no levels is within the bytes it leaves.
theorem Source::main_below_left(self src: Source, homes: Homes, bodies: List<Frame>):
    src.main.performed().below(src.main.called(), src.procedures, bodies, homes.places, homes.room_table(src.functions), src.procedures.checks(), src.procedures.len()) + 8 <=
        src.left(homes, bodies) {
    let checks = src.procedures.checks();
    let table = homes.room_table(src.functions);
    let base = src.main.performed().below(src.main.called(), src.procedures, bodies, homes.places, table, checks, src.procedures.len());
    let period = src.period(homes, bodies);
    let room = src.levels.periodic_above(src.procedures.len(), period, src.gain(homes, bodies, period), base, λ i => src.top(homes, bodies, i),
        λ i => src.main.performed().below_le_by(src.main.called(), src.procedures, bodies, homes.places, table, checks,
            src.procedures.level_row(bodies, homes.places, table, checks, src.procedures.ranks(checks), i), src.procedures.len()));
    let left_is: (src.left(homes, bodies) = src.room_top(homes, bodies, src.levels) + 8) = refl;
    let room_is: (src.room_top(homes, bodies, src.levels) =
        src.levels.periodic(src.procedures.len(), period, src.gain(homes, bodies, period), λ i => src.top(homes, bodies, i))) = refl;
    omega(room, left_is, room_is)
}

// Every word a fitting list names is in the file.
theorem Layout::words_fit_mem(self layout: Layout, ids: List<Nat>): (i: Nat) → layout.words_fit(ids).IsTrue() → Mem(i, ids) → layout.word_fits(i).IsTrue() {
    match ids {
        Nil => λ i _ never => false_elim(never),
        Cons(id, rest) => λ i fit m => {
            match m {
                Inl(e) => j(sym(e), λ x _ => layout.word_fits(x).IsTrue(), Bool::both(fit).left),
                Inr(later) => layout.words_fit_mem(rest, i, known, later),
            }
        },
    }
}

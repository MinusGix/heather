// A `Source` with no fuel: its statements as a coinductive tree over
// Linux's calls (issues/effectful-loops-without-passes.md;
// docs/language/effects-capabilities-design.md §4).
//
// `Stmt::denote` reads a `Repeat` as `ITree::iter` at a fuel, cut past it,
// and the fuel is shared by every loop and every call. Here a `Repeat` is
// `CoTree::iter`: it goes round for as long as its again-bit says, so a
// loop that never ends is a tree that never returns, not one that is cut.
// Procedures nest to the source's depth as before (a call past it exits
// 139), so depth is still counted, but no fuel is.
//
// The two meanings are the same program (`Program::Refines` both ways):
// every trace the fuelled tree produces at some fuel, the fuel-free one
// produces at some depth (`Source::tree_co_refines`), and the converse
// (`Source::tree_co_refined`). The first is the direction a compiled
// program's theorem travels in: its ELF refines the fuelled program
// (`native_source_sim`), so it refines the fuel-free one, whose reading at
// a world is a computation in `Partial` (`Io::against_co`). Both are proved
// construct by construct (`ITree::Into`, `CoTree::Onto` in
// `coitree_bridge`); a `Repeat` is `CoTree::iter_refined`/`iter_refines`
// for a body that is itself a denotation, a family in the fuel.
import logic;
import nat;
import list;
import option;
import bitvec;
import itree;
import itree_trace;
import coitree;
import coitree_eutt;
import coitree_bridge;
import linux_calls;
import linux_trees;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_placeless;
import bool;
import native_source;

// ---------------------------------------------------------------------------
// The fuel-free denotation

// What a call does, with no fuel.
fn PerformsCo() → Type { Nat → List<Nat> → List<Nat> → Env → CoTree<Flow>(Events::linux()) }

// A function of the environment, so that the recursion is on the statement:
// a function whose result is codata would be read as corecursive.
fn Stmt::denote_co(self s: Stmt, call: Writers(), perform: PerformsCo()) → Env → CoTree<Flow>(Events::linux()) {
    match s {
        Compute(region) => λ env => CRet(Onward(env.compute(call, region))),
        Invoke(shape) => λ env => CVis(shape.cmd(env), λ a => CRet(Onward(shape.answer(env, a)))),
        Then(first, rest) => λ env => CoTree::bind(Events::linux(), first.denote_co(call, perform)(env), λ flow => match flow {
            Onward(next) => rest.denote_co(call, perform)(next),
            Exited(status) => CRet(Exited(status)),
        }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) {
            True => yes.denote_co(call, perform)(env),
            False => no.denote_co(call, perform)(env),
        },
        Repeat(body, again) => λ env => CoTree::iter(Events::linux(),
            λ e => CoTree::map(Events::linux(), body.denote_co(call, perform)(e), λ flow => flow.pass(again)), env),
        Exit(status) => λ env => CRet(Exited(env.word(status))),
        Arg(index, buf, len) => λ env => CRet(Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => λ env => perform(procedure, args, results, env),
    }
}

// What a call does at depth `depth`, as `Source::performs` with no fuel.
fn Source::performs_co(self src: Source, call: Writers(), depth: Nat) → PerformsCo() {
    match depth {
        Zero => λ procedure args results env => CRet(Exited(call_depth_status())),
        Succ(d) => λ procedure args results env => match src.procedures.nth(procedure) {
            None => CRet(Onward(env)),
            Some(proc) => CoTree::map(Events::linux(), proc.body.denote_co(call, src.performs_co(call, d))(proc.enter(env, args)),
                λ flow => proc.leave(env, results, flow)),
        },
    }
}

fn Source::main_tree_co(self src: Source, args: List<List<BitVec(8)>>) → CoTree<Flow>(Events::linux()) {
    src.main.denote_co(program_writers(src.functions), src.performs_co(program_writers(src.functions), src.depth))(src.start(args))
}

// The program run with the command line `args`, with no fuel.
fn Source::tree_co(self src: Source, args: List<List<BitVec(8)>>) → CoTree<BitVec(64)>(Events::linux()) {
    CoTree::map(Events::linux(), src.main_tree_co(args), λ flow => flow.status())
}

// ---------------------------------------------------------------------------
// The fuelled tree is inside the fuel-free one

// Each call's fuelled tree inside its fuel-free one.
fn performs_into(perform: Performs(), perform_co: PerformsCo()) → Type {
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
        ITree::Into(Events::linux(), perform(procedure, args, results, env), perform_co(procedure, args, results, env))
}

// At every fuel, construct by construct (`ITree::into_bind`,
// `ITree::into_iter`).
theorem Stmt::into_co(self s: Stmt, call: Writers(), perform: Performs(), perform_co: PerformsCo(),
    hp: performs_into(perform, perform_co), n: Nat): (env: Env) →
    ITree::Into(Events::linux(), s.denote(call, perform, n, env), s.denote_co(call, perform_co)(env))
{
    match s {
        Compute(region) => λ env => ITree::into_ret(Events::linux(), Onward(env.compute(call, region))),
        Invoke(shape) => λ env => ITree::into_vis(Events::linux(), shape.cmd(env), λ a => Ret(Onward(shape.answer(env, a))),
            λ a => CRet(Onward(shape.answer(env, a))), λ a => ITree::into_ret(Events::linux(), Onward(shape.answer(env, a)))),
        Then(first, rest) => λ env => ITree::into_bind(Events::linux(), first.denote(call, perform, n, env), first.denote_co(call, perform_co)(env),
            λ flow => match flow { Onward(next) => rest.denote(call, perform, n, next), Exited(status) => Ret(Exited(status)) },
            λ flow => match flow { Onward(next) => rest.denote_co(call, perform_co)(next), Exited(status) => CRet(Exited(status)) },
            first.into_co(call, perform, perform_co, hp, n, env),
            λ flow => match flow as λ f => ITree::Into(Events::linux(),
                    match f as λ _ => ITree<Flow>(Events::linux()) { Onward(next) => rest.denote(call, perform, n, next), Exited(status) => Ret(Exited(status)) },
                    match f as λ _ => CoTree<Flow>(Events::linux()) { Onward(next) => rest.denote_co(call, perform_co)(next), Exited(status) => CRet(Exited(status)) }) {
                Onward(next) => rest.into_co(call, perform, perform_co, hp, n, next),
                Exited(status) => ITree::into_ret(Events::linux(), Exited(status)),
            }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b => ITree::Into(Events::linux(),
                match b as λ _ => ITree<Flow>(Events::linux()) { True => yes.denote(call, perform, n, env), False => no.denote(call, perform, n, env) },
                match b as λ _ => CoTree<Flow>(Events::linux()) { True => yes.denote_co(call, perform_co)(env), False => no.denote_co(call, perform_co)(env) }) {
            True => yes.into_co(call, perform, perform_co, hp, n, env),
            False => no.into_co(call, perform, perform_co, hp, n, env),
        },
        Repeat(body, again) => λ env => ITree::into_iter(Events::linux(),
            λ e => ITree::map(Events::linux(), body.denote(call, perform, n, e), λ flow => flow.pass(again)),
            λ e => CoTree::map(Events::linux(), body.denote_co(call, perform_co)(e), λ flow => flow.pass(again)),
            λ e => ITree::into_map(Events::linux(), body.denote(call, perform, n, e), body.denote_co(call, perform_co)(e),
                λ flow => flow.pass(again), body.into_co(call, perform, perform_co, hp, n, e)),
            n, env),
        Exit(status) => λ env => ITree::into_ret(Events::linux(), Exited(env.word(status))),
        Arg(index, buf, len) => λ env => ITree::into_ret(Events::linux(), Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => λ env => hp(procedure, args, results, env),
    }
}

// Every call at every depth, by induction on the depth.
theorem Source::performs_into_co(self src: Source, call: Writers(), n: Nat, depth: Nat):
    performs_into(src.performs(call, n, depth), src.performs_co(call, depth))
{
    match depth {
        Zero => λ procedure args results env => ITree::into_ret(Events::linux(), Exited(call_depth_status())),
        Succ(d) => λ procedure args results env => match src.procedures.nth(procedure) as λ o => ITree::Into(Events::linux(),
                match o as λ _ => ITree<Flow>(Events::linux()) {
                    None => Ret(Onward(env)),
                    Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
                match o as λ _ => CoTree<Flow>(Events::linux()) {
                    None => CRet(Onward(env)),
                    Some(proc) => CoTree::map(Events::linux(), proc.body.denote_co(call, src.performs_co(call, d))(proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                }) {
            None => ITree::into_ret(Events::linux(), Onward(env)),
            Some(proc) => ITree::into_map(Events::linux(),
                proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)),
                proc.body.denote_co(call, src.performs_co(call, d))(proc.enter(env, args)),
                λ flow => proc.leave(env, results, flow),
                proc.body.into_co(call, src.performs(call, n, d), src.performs_co(call, d), src.performs_into_co(call, n, d), n, proc.enter(env, args))),
        },
    }
}

// The bridge: every trace the program produces at some fuel, its fuel-free
// tree produces at some depth. A compiled program refines `src.denote`
// (`native_source_sim`), so through this it refines `src.tree_co`.
theorem Source::tree_co_refines(self src: Source, args: List<List<BitVec(8)>>):
    Program::Refines(Events::linux(), src.denote(args), CoTree::program(Events::linux(), src.tree_co(args)))
{
    λ tr (c: Converges<BitVec(64)>(Events::linux(), λ n => src.tree(args, n), tr)) =>
        ITree::into_map(Events::linux(), src.main_tree(args, c.n), src.main_tree_co(args), λ flow => flow.status(),
            src.main.into_co(program_writers(src.functions), src.performs(program_writers(src.functions), c.n, src.depth),
                src.performs_co(program_writers(src.functions), src.depth),
                src.performs_into_co(program_writers(src.functions), c.n, src.depth), c.n, src.start(args)),
            tr, c.h)
}

// ---------------------------------------------------------------------------
// The fuel-free tree is inside the fuelled program

// Each call's fuel-free tree inside its fuelled family.
fn performs_onto(perform_co: PerformsCo(), perform: Nat → Performs()) → Type {
    (procedure: Nat) → (args, results: List<Nat>) → (env: Env) →
        CoTree::Onto(Events::linux(), perform_co(procedure, args, results, env), λ n => perform(n, procedure, args, results, env))
}

// The fuelled denotation is a family that grows (`Stmt::grows`), so each
// construct's parts are found at fuels raised to their sum
// (`CoTree::onto_bind`, `CoTree::onto_iter`).
theorem Stmt::onto_co(self s: Stmt, call: Writers(), perform: Nat → Performs(),
    grows: (n: Nat) → performs_below(perform(n), perform(Succ(n))), perform_co: PerformsCo(),
    hp: performs_onto(perform_co, perform)): (env: Env) →
    CoTree::Onto(Events::linux(), s.denote_co(call, perform_co)(env), λ n => s.denote(call, perform(n), n, env))
{
    match s {
        Compute(region) => λ env => CoTree::onto_ret(Events::linux(), Onward(env.compute(call, region))),
        Invoke(shape) => λ env => CoTree::onto_vis(Events::linux(), shape.cmd(env), λ a => CRet(Onward(shape.answer(env, a))),
            λ a n => Ret(Onward(shape.answer(env, a))), λ a => CoTree::onto_ret(Events::linux(), Onward(shape.answer(env, a)))),
        Then(first, rest) => λ env => CoTree::onto_bind(Events::linux(), first.denote_co(call, perform_co)(env),
            λ n => first.denote(call, perform(n), n, env),
            λ n => first.grows(call, perform(n), perform(Succ(n)), grows(n), n, env),
            λ flow => match flow { Onward(next) => rest.denote_co(call, perform_co)(next), Exited(status) => CRet(Exited(status)) },
            λ flow n => match flow { Onward(next) => rest.denote(call, perform(n), n, next), Exited(status) => Ret(Exited(status)) },
            λ flow => match flow as λ f => ITree::Grows(Events::linux(),
                    λ n => match f as λ _ => ITree<Flow>(Events::linux()) { Onward(next) => rest.denote(call, perform(n), n, next), Exited(status) => Ret(Exited(status)) }) {
                Onward(next) => λ n => rest.grows(call, perform(n), perform(Succ(n)), grows(n), n, next),
                Exited(status) => λ n => refl,
            },
            first.onto_co(call, perform, grows, perform_co, hp, env),
            λ flow => match flow as λ f => CoTree::Onto(Events::linux(),
                    match f as λ _ => CoTree<Flow>(Events::linux()) { Onward(next) => rest.denote_co(call, perform_co)(next), Exited(status) => CRet(Exited(status)) },
                    λ n => match f as λ _ => ITree<Flow>(Events::linux()) { Onward(next) => rest.denote(call, perform(n), n, next), Exited(status) => Ret(Exited(status)) }) {
                Onward(next) => rest.onto_co(call, perform, grows, perform_co, hp, next),
                Exited(status) => CoTree::onto_ret(Events::linux(), Exited(status)),
            }),
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b => CoTree::Onto(Events::linux(),
                match b as λ _ => CoTree<Flow>(Events::linux()) { True => yes.denote_co(call, perform_co)(env), False => no.denote_co(call, perform_co)(env) },
                λ n => match b as λ _ => ITree<Flow>(Events::linux()) { True => yes.denote(call, perform(n), n, env), False => no.denote(call, perform(n), n, env) }) {
            True => yes.onto_co(call, perform, grows, perform_co, hp, env),
            False => no.onto_co(call, perform, grows, perform_co, hp, env),
        },
        Repeat(body, again) => λ env => λ k tr it => CoTree::onto_iter(Events::linux(),
            λ n e => ITree::map(Events::linux(), body.denote(call, perform(n), n, e), λ flow => flow.pass(again)),
            λ n e => ITree::below_bind(Events::linux(), body.denote(call, perform(n), n, e), body.denote(call, perform(Succ(n)), Succ(n), e),
                λ flow => Ret(flow.pass(again)), λ flow => Ret(flow.pass(again)), body.grows(call, perform(n), perform(Succ(n)), grows(n), n, e),
                λ flow => refl),
            λ e => CoTree::map(Events::linux(), body.denote_co(call, perform_co)(e), λ flow => flow.pass(again)),
            λ e => CoTree::onto_map(Events::linux(), body.denote_co(call, perform_co)(e), λ n => body.denote(call, perform(n), n, e),
                λ n => body.grows(call, perform(n), perform(Succ(n)), grows(n), n, e), λ flow => flow.pass(again),
                body.onto_co(call, perform, grows, perform_co, hp, e)),
            k, env, tr, it),
        Exit(status) => λ env => CoTree::onto_ret(Events::linux(), Exited(env.word(status))),
        Arg(index, buf, len) => λ env => CoTree::onto_ret(Events::linux(), Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => λ env => hp(procedure, args, results, env),
    }
}

// Every call at every depth, by induction on the depth.
theorem Source::performs_onto_co(self src: Source, call: Writers(), depth: Nat):
    performs_onto(src.performs_co(call, depth), λ n => src.performs(call, n, depth))
{
    match depth {
        Zero => λ procedure args results env => CoTree::onto_ret(Events::linux(), Exited(call_depth_status())),
        Succ(d) => λ procedure args results env => match src.procedures.nth(procedure) as λ o => CoTree::Onto(Events::linux(),
                match o as λ _ => CoTree<Flow>(Events::linux()) {
                    None => CRet(Onward(env)),
                    Some(proc) => CoTree::map(Events::linux(), proc.body.denote_co(call, src.performs_co(call, d))(proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                },
                λ n => match o as λ _ => ITree<Flow>(Events::linux()) {
                    None => Ret(Onward(env)),
                    Some(proc) => ITree::map(Events::linux(), proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)),
                        λ flow => proc.leave(env, results, flow)),
                }) {
            None => CoTree::onto_ret(Events::linux(), Onward(env)),
            Some(proc) => CoTree::onto_map(Events::linux(),
                proc.body.denote_co(call, src.performs_co(call, d))(proc.enter(env, args)),
                λ n => proc.body.denote(call, src.performs(call, n, d), n, proc.enter(env, args)),
                λ n => proc.body.grows(call, src.performs(call, n, d), src.performs(call, Succ(n), d), src.performs_grows(call, n, d), n,
                    proc.enter(env, args)),
                λ flow => proc.leave(env, results, flow),
                proc.body.onto_co(call, λ n => src.performs(call, n, d), λ n => src.performs_grows(call, n, d), src.performs_co(call, d),
                    src.performs_onto_co(call, d), proc.enter(env, args))),
        },
    }
}

// The bridge the other way: every trace the fuel-free tree produces at
// some depth, the program produces at some fuel. With
// `Source::tree_co_refines`, the two are the same program.
theorem Source::tree_co_refined(self src: Source, args: List<List<BitVec(8)>>):
    Program::Refines(Events::linux(), CoTree::program(Events::linux(), src.tree_co(args)), src.denote(args))
{
    λ tr (c: Converges<BitVec(64)>(Events::linux(), λ n => CoTree::approx(Events::linux(), n, src.tree_co(args)), tr)) =>
        CoTree::onto_map(Events::linux(), src.main_tree_co(args), λ n => src.main_tree(args, n),
            λ n => src.main.grows(program_writers(src.functions), src.performs(program_writers(src.functions), n, src.depth),
                src.performs(program_writers(src.functions), Succ(n), src.depth), src.performs_grows(program_writers(src.functions), n, src.depth),
                n, src.start(args)),
            λ flow => flow.status(),
            src.main.onto_co(program_writers(src.functions), λ n => src.performs(program_writers(src.functions), n, src.depth),
                λ n => src.performs_grows(program_writers(src.functions), n, src.depth),
                src.performs_co(program_writers(src.functions), src.depth), src.performs_onto_co(program_writers(src.functions), src.depth),
                src.start(args)),
            c.n, tr, c.h)
}

// A tool's lowering a statement at a time, for `heather write-elf`
// (issues/native-tool-certificate-budget.md).
//
// `write-elf` states that a tool lowers to a literal source. One `refl` of
// the whole lowering costs as much as the tool has nodes, and a declaration
// has a fixed fuel, so the certificate states it a part of the tool at a
// time instead: each part of the statement tree small enough is packed by
// one `refl`, and every larger one is joined from its parts by the lemmas
// here.
//
// The lowering is a packing (`List::pack`, native_build) folded over the
// tool's items, and the items of a statement are its parts' items in order
// with a few of its own around them (`Act::items`). So a part's packing is
// stated from the leaf it meets (`group`) and with what was done before it
// a variable: nothing looks into the statements done until the packing is
// over (`Packing::stmt`), and `(d: List<Stmt>) → a.packs(next,
// Packing(d, g)) = Packing(f(d), g')` holds for a part whatever came before
// it. A branch's arms and a loop's body are packed from the start, and
// their statements are named where the branch or loop is.
//
// The parts are named by navigation from the tool's statement (`Act::part`),
// and the reads that print the literals (`Act::shape`, `Packing::spelled`)
// are untrusted: a misreading is a statement the kernel refuses.

import native_build;
import native_source_spelled;
import native_source;
import native_compile;
import function_ir;
import bitvec;
import bool;
import list;
import logic;
import nat;
import option;

// ---------------------------------------------------------------------------
// Statements' parts

// 0 Skip, 1 Seq, 2 Let, 3 Set, 4 Poke, 5 When, 6 While, 7 DoWhile, 8 ReadTo,
// 9 WriteFrom, 10 OpenOf, 11 CloseOf, 12 ArgTo, 13 Quit, 14 Calculate.
fn Act::kind(self a: Act) → Nat {
    match a {
        Skip => 0, Seq(_) => 1, Let(_, _) => 2, Set(_, _) => 3, Poke(_, _, _) => 4, When(_, _) => 5, While(_, _) => 6,
        DoWhile(_, _) => 7, ReadTo(_, _, _, _) => 8, WriteFrom(_, _, _, _, _) => 9, OpenOf(_, _, _) => 10, CloseOf(_, _) => 11,
        ArgTo(_, _, _) => 12, Quit(_) => 13, Calculate(_) => 14,
    }
}

fn Act::is_seq(self a: Act) → Bool {
    match a {
        Seq(_) => True, Skip => False, Let(_, _) => False, Set(_, _) => False, Poke(_, _, _) => False, When(_, _) => False,
        While(_, _) => False, DoWhile(_, _) => False, ReadTo(_, _, _, _) => False, WriteFrom(_, _, _, _, _) => False,
        OpenOf(_, _, _) => False, CloseOf(_, _) => False, ArgTo(_, _, _) => False, Quit(_) => False, Calculate(_) => False,
    }
}

fn Act::is_let(self a: Act) → Bool {
    match a {
        Let(_, _) => True, Skip => False, Seq(_) => False, Set(_, _) => False, Poke(_, _, _) => False, When(_, _) => False,
        While(_, _) => False, DoWhile(_, _) => False, ReadTo(_, _, _, _) => False, WriteFrom(_, _, _, _, _) => False,
        OpenOf(_, _, _) => False, CloseOf(_, _) => False, ArgTo(_, _, _) => False, Quit(_) => False, Calculate(_) => False,
    }
}

fn Act::is_when(self a: Act) → Bool {
    match a {
        When(_, _) => True, Skip => False, Seq(_) => False, Let(_, _) => False, Set(_, _) => False, Poke(_, _, _) => False,
        While(_, _) => False, DoWhile(_, _) => False, ReadTo(_, _, _, _) => False, WriteFrom(_, _, _, _, _) => False,
        OpenOf(_, _, _) => False, CloseOf(_, _) => False, ArgTo(_, _, _) => False, Quit(_) => False, Calculate(_) => False,
    }
}

fn Act::is_while(self a: Act) → Bool {
    match a {
        While(_, _) => True, Skip => False, Seq(_) => False, Let(_, _) => False, Set(_, _) => False, Poke(_, _, _) => False,
        When(_, _) => False, DoWhile(_, _) => False, ReadTo(_, _, _, _) => False, WriteFrom(_, _, _, _, _) => False,
        OpenOf(_, _, _) => False, CloseOf(_, _) => False, ArgTo(_, _, _) => False, Quit(_) => False, Calculate(_) => False,
    }
}

fn Act::is_do_while(self a: Act) → Bool {
    match a {
        DoWhile(_, _) => True, Skip => False, Seq(_) => False, Let(_, _) => False, Set(_, _) => False, Poke(_, _, _) => False,
        When(_, _) => False, While(_, _) => False, ReadTo(_, _, _, _) => False, WriteFrom(_, _, _, _, _) => False,
        OpenOf(_, _, _) => False, CloseOf(_, _) => False, ArgTo(_, _, _) => False, Quit(_) => False, Calculate(_) => False,
    }
}

// A part, as `Act::items` meets it with its first word free `next`: a
// sequence's and a branch's two (`True` the first), a `Let`'s body with its
// word bound to `next`, a loop's body. Itself when it has none.
fn Act::part(self a: Act, next: Nat, side: Bool) → Act {
    match a {
        Seq(parts) => parts(side),
        Let(_, body) => body(Var(next)),
        When(_, arms) => arms(side),
        While(_, body) => body,
        DoWhile(body, _) => body,
        Skip => a, Set(_, _) => a, Poke(_, _, _) => a, ReadTo(_, _, _, _) => a, WriteFrom(_, _, _, _, _) => a,
        OpenOf(_, _, _) => a, CloseOf(_, _) => a, ArgTo(_, _, _) => a, Quit(_) => a, Calculate(_) => a,
    }
}

// The value a branch or loop tests, placed from `next`.
fn Act::tested(self a: Act, next: Nat) → Placed {
    match a {
        When(condition, _) => condition.truth().place(next),
        While(condition, _) => condition.truth().place(next),
        DoWhile(_, condition) => condition.truth().place(next),
        Skip => Placed([], 0, next), Seq(_) => Placed([], 0, next), Let(_, _) => Placed([], 0, next), Set(_, _) => Placed([], 0, next),
        Poke(_, _, _) => Placed([], 0, next), ReadTo(_, _, _, _) => Placed([], 0, next), WriteFrom(_, _, _, _, _) => Placed([], 0, next),
        OpenOf(_, _, _) => Placed([], 0, next), CloseOf(_, _) => Placed([], 0, next), ArgTo(_, _, _) => Placed([], 0, next),
        Quit(_) => Placed([], 0, next), Calculate(_) => Placed([], 0, next),
    }
}

// The items before a `Let`'s body: its word set.
fn Act::init_items(self a: Act, next: Nat) → List<Item> {
    match a {
        Let(init, _) => init.assigned(next, Succ(next)).ops(),
        Skip => [], Seq(_) => [], Set(_, _) => [], Poke(_, _, _) => [], When(_, _) => [], While(_, _) => [], DoWhile(_, _) => [],
        ReadTo(_, _, _, _) => [], WriteFrom(_, _, _, _, _) => [], OpenOf(_, _, _) => [], CloseOf(_, _) => [], ArgTo(_, _, _) => [],
        Quit(_) => [], Calculate(_) => [],
    }
}

// The statement's items packed onto `k`.
fn Act::packs(self a: Act, next: Nat, k: Packing) → Packing { a.items(next).pack(k) }

// The statement lowered alone, as a branch's arm or a loop's body is.
fn Act::lowered_at(self a: Act, next: Nat) → Stmt { a.packs(next, Packing::start()).stmt() }

// ---------------------------------------------------------------------------
// Joining parts

// Packing is a fold: the items after others are packed onto theirs.
theorem List::pack_append(self xs: List<Item>, ys: List<Item>): (k: Packing) → (xs ++ ys).pack(k) = ys.pack(xs.pack(k)) {
    match xs {
        Nil => λ k => refl,
        Cons(item, rest) => λ k => rest.pack_append(ys, k.step(item)),
    }
}

// A sequence: its first part packed, then its second onto that.
theorem Act::packs_seq_of(self a: Act, is: a.is_seq().IsTrue(), next: Nat, g0, g1, g2: List<Node>, f1, f2: List<Stmt> → List<Stmt>,
    first: (d: List<Stmt>) → a.part(next, True).packs(next, Packing(d, g0)) = Packing(f1(d), g1),
    second: (d: List<Stmt>) → a.part(next, False).packs(next, Packing(d, g1)) = Packing(f2(d), g2)):
    (d: List<Stmt>) → a.packs(next, Packing(d, g0)) = Packing(f2(f1(d)), g2) {
    (match a as λ b => b.is_seq().IsTrue() → ((d: List<Stmt>) → b.part(next, True).packs(next, Packing(d, g0)) = Packing(f1(d), g1)) →
            ((d: List<Stmt>) → b.part(next, False).packs(next, Packing(d, g1)) = Packing(f2(d), g2)) →
            (d: List<Stmt>) → b.packs(next, Packing(d, g0)) = Packing(f2(f1(d)), g2) {
        Seq(parts) => λ _ h1 h2 d => trans(List::pack_append(parts(True).items(next), parts(False).items(next), Packing(d, g0)),
            trans(cong_fn<Packing, Packing>(λ k => parts(False).items(next).pack(k), h1(d)), h2(f1(d)))),
        Skip => λ no _ _ => false_elim(no),
        Let(_, _) => λ no _ _ => false_elim(no),
        Set(_, _) => λ no _ _ => false_elim(no),
        Poke(_, _, _) => λ no _ _ => false_elim(no),
        When(_, _) => λ no _ _ => false_elim(no),
        While(_, _) => λ no _ _ => false_elim(no),
        DoWhile(_, _) => λ no _ _ => false_elim(no),
        ReadTo(_, _, _, _) => λ no _ _ => false_elim(no),
        WriteFrom(_, _, _, _, _) => λ no _ _ => false_elim(no),
        OpenOf(_, _, _) => λ no _ _ => false_elim(no),
        CloseOf(_, _) => λ no _ _ => false_elim(no),
        ArgTo(_, _, _) => λ no _ _ => false_elim(no),
        Quit(_) => λ no _ _ => false_elim(no),
        Calculate(_) => λ no _ _ => false_elim(no),
    })(is, first, second)
}

// A `Let`: its word set (`init`, packed by `refl` where it is used), then
// its body.
theorem Act::packs_let_of(self a: Act, is: a.is_let().IsTrue(), next: Nat, g0, g1, g2: List<Node>, f1, f2: List<Stmt> → List<Stmt>,
    init: (d: List<Stmt>) → a.init_items(next).pack(Packing(d, g0)) = Packing(f1(d), g1),
    body: (d: List<Stmt>) → a.part(next, True).packs(Succ(next), Packing(d, g1)) = Packing(f2(d), g2)):
    (d: List<Stmt>) → a.packs(next, Packing(d, g0)) = Packing(f2(f1(d)), g2) {
    (match a as λ b => b.is_let().IsTrue() → ((d: List<Stmt>) → b.init_items(next).pack(Packing(d, g0)) = Packing(f1(d), g1)) →
            ((d: List<Stmt>) → b.part(next, True).packs(Succ(next), Packing(d, g1)) = Packing(f2(d), g2)) →
            (d: List<Stmt>) → b.packs(next, Packing(d, g0)) = Packing(f2(f1(d)), g2) {
        Let(v, rest) => λ _ h1 h2 d => trans(List::pack_append(v.assigned(next, Succ(next)).ops(), rest(Var(next)).items(Succ(next)), Packing(d, g0)),
            trans(cong_fn<Packing, Packing>(λ k => rest(Var(next)).items(Succ(next)).pack(k), h1(d)), h2(f1(d)))),
        Skip => λ no _ _ => false_elim(no),
        Seq(_) => λ no _ _ => false_elim(no),
        Set(_, _) => λ no _ _ => false_elim(no),
        Poke(_, _, _) => λ no _ _ => false_elim(no),
        When(_, _) => λ no _ _ => false_elim(no),
        While(_, _) => λ no _ _ => false_elim(no),
        DoWhile(_, _) => λ no _ _ => false_elim(no),
        ReadTo(_, _, _, _) => λ no _ _ => false_elim(no),
        WriteFrom(_, _, _, _, _) => λ no _ _ => false_elim(no),
        OpenOf(_, _, _) => λ no _ _ => false_elim(no),
        CloseOf(_, _) => λ no _ _ => false_elim(no),
        ArgTo(_, _, _) => λ no _ _ => false_elim(no),
        Quit(_) => λ no _ _ => false_elim(no),
        Calculate(_) => λ no _ _ => false_elim(no),
    })(is, init, body)
}

// A branch: its test's nodes, then the branch over its arms' statements,
// each lowered alone.
theorem Act::packs_when_of(self a: Act, is: a.is_when().IsTrue(), next: Nat, yes, no: Stmt,
    lowered_yes: a.part(next, True).lowered_at(next) = yes, lowered_no: a.part(next, False).lowered_at(next) = no):
    (k: Packing) → a.packs(next, k) = a.tested(next).nodes.ops().pack(k).step(Do(Branch(a.tested(next).id, yes, no))) {
    (match a as λ b => b.is_when().IsTrue() → b.part(next, True).lowered_at(next) = yes → b.part(next, False).lowered_at(next) = no →
            (k: Packing) → b.packs(next, k) = b.tested(next).nodes.ops().pack(k).step(Do(Branch(b.tested(next).id, yes, no))) {
        When(condition, arms) => λ _ hy hn k => {
            let t = condition.truth().place(next);
            trans(List::pack_append(t.nodes.ops(), [Do(Branch(t.id, arms(True).items(next).lowered(), arms(False).items(next).lowered()))], k),
                j(hy, λ y _ => List::pack([Do(Branch(t.id, arms(True).items(next).lowered(), arms(False).items(next).lowered()))], t.nodes.ops().pack(k))
                        = t.nodes.ops().pack(k).step(Do(Branch(t.id, y, no))),
                    j(hn, λ n _ => List::pack([Do(Branch(t.id, arms(True).items(next).lowered(), arms(False).items(next).lowered()))], t.nodes.ops().pack(k))
                            = t.nodes.ops().pack(k).step(Do(Branch(t.id, arms(True).items(next).lowered(), n))),
                        refl)))
        },
        Skip => λ no _ _ => false_elim(no),
        Seq(_) => λ no _ _ => false_elim(no),
        Let(_, _) => λ no _ _ => false_elim(no),
        Set(_, _) => λ no _ _ => false_elim(no),
        Poke(_, _, _) => λ no _ _ => false_elim(no),
        While(_, _) => λ no _ _ => false_elim(no),
        DoWhile(_, _) => λ no _ _ => false_elim(no),
        ReadTo(_, _, _, _) => λ no _ _ => false_elim(no),
        WriteFrom(_, _, _, _, _) => λ no _ _ => false_elim(no),
        OpenOf(_, _, _) => λ no _ _ => false_elim(no),
        CloseOf(_, _) => λ no _ _ => false_elim(no),
        ArgTo(_, _, _) => λ no _ _ => false_elim(no),
        Quit(_) => λ no _ _ => false_elim(no),
        Calculate(_) => λ no _ _ => false_elim(no),
    })(is, lowered_yes, lowered_no)
}

// A loop's pass: its body packed alone, then its test's nodes, the whole
// one statement.
theorem Act::pass_of(self a: Act, next: Nat, body: Packing, pass: Stmt,
    packed: a.part(next, True).packs(Succ(next), Packing::start()) = body, closed: a.tested(next).nodes.ops().pack(body).stmt() = pass):
    List::append(a.part(next, True).items(Succ(next)), a.tested(next).nodes.ops()).lowered() = pass {
    trans(cong_fn<Packing, Stmt>(λ k => k.stmt(), List::pack_append(a.part(next, True).items(Succ(next)), a.tested(next).nodes.ops(), Packing::start())),
        j(sym(packed), λ k _ => a.tested(next).nodes.ops().pack(k).stmt() = pass, closed))
}

// A `while`: its test's nodes, then the branch into the loop.
theorem Act::packs_while_of(self a: Act, is: a.is_while().IsTrue(), next: Nat, pass: Stmt,
    passes: List::append(a.part(next, True).items(Succ(next)), a.tested(next).nodes.ops()).lowered() = pass):
    (k: Packing) → a.packs(next, k)
        = a.tested(next).nodes.ops().pack(k).step(Do(Branch(a.tested(next).id, Repeat(pass, a.tested(next).id), Stmt::leaf([])))) {
    (match a as λ b => b.is_while().IsTrue() → List::append(b.part(next, True).items(Succ(next)), b.tested(next).nodes.ops()).lowered() = pass →
            (k: Packing) → b.packs(next, k)
                = b.tested(next).nodes.ops().pack(k).step(Do(Branch(b.tested(next).id, Repeat(pass, b.tested(next).id), Stmt::leaf([])))) {
        While(condition, body) => λ _ h k => {
            let t = condition.truth().place(next);
            trans(List::pack_append(t.nodes.ops(), [Do(Branch(t.id, Repeat((body.items(Succ(next)) ++ t.nodes.ops()).lowered(), t.id), Stmt::leaf([])))], k),
                j(h, λ r _ => List::pack([Do(Branch(t.id, Repeat((body.items(Succ(next)) ++ t.nodes.ops()).lowered(), t.id), Stmt::leaf([])))], t.nodes.ops().pack(k))
                        = t.nodes.ops().pack(k).step(Do(Branch(t.id, Repeat(r, t.id), Stmt::leaf([])))),
                    refl))
        },
        Skip => λ no _ => false_elim(no),
        Seq(_) => λ no _ => false_elim(no),
        Let(_, _) => λ no _ => false_elim(no),
        Set(_, _) => λ no _ => false_elim(no),
        Poke(_, _, _) => λ no _ => false_elim(no),
        When(_, _) => λ no _ => false_elim(no),
        DoWhile(_, _) => λ no _ => false_elim(no),
        ReadTo(_, _, _, _) => λ no _ => false_elim(no),
        WriteFrom(_, _, _, _, _) => λ no _ => false_elim(no),
        OpenOf(_, _, _) => λ no _ => false_elim(no),
        CloseOf(_, _) => λ no _ => false_elim(no),
        ArgTo(_, _, _) => λ no _ => false_elim(no),
        Quit(_) => λ no _ => false_elim(no),
        Calculate(_) => λ no _ => false_elim(no),
    })(is, passes)
}

// A `do … while`: the loop, its test inside it.
theorem Act::packs_do_while_of(self a: Act, is: a.is_do_while().IsTrue(), next: Nat, pass: Stmt,
    passes: List::append(a.part(next, True).items(Succ(next)), a.tested(next).nodes.ops()).lowered() = pass):
    (k: Packing) → a.packs(next, k) = k.step(Do(Repeat(pass, a.tested(next).id))) {
    (match a as λ b => b.is_do_while().IsTrue() → List::append(b.part(next, True).items(Succ(next)), b.tested(next).nodes.ops()).lowered() = pass →
            (k: Packing) → b.packs(next, k) = k.step(Do(Repeat(pass, b.tested(next).id))) {
        DoWhile(body, condition) => λ _ h k => {
            let t = condition.truth().place(next);
            j(h, λ r _ => List::pack([Do(Repeat((body.items(Succ(next)) ++ t.nodes.ops()).lowered(), t.id))], k) = k.step(Do(Repeat(r, t.id))), refl)
        },
        Skip => λ no _ => false_elim(no),
        Seq(_) => λ no _ => false_elim(no),
        Let(_, _) => λ no _ => false_elim(no),
        Set(_, _) => λ no _ => false_elim(no),
        Poke(_, _, _) => λ no _ => false_elim(no),
        When(_, _) => λ no _ => false_elim(no),
        While(_, _) => λ no _ => false_elim(no),
        ReadTo(_, _, _, _) => λ no _ => false_elim(no),
        WriteFrom(_, _, _, _, _) => λ no _ => false_elim(no),
        OpenOf(_, _, _) => λ no _ => false_elim(no),
        CloseOf(_, _) => λ no _ => false_elim(no),
        ArgTo(_, _, _) => λ no _ => false_elim(no),
        Quit(_) => λ no _ => false_elim(no),
        Calculate(_) => λ no _ => false_elim(no),
    })(is, passes)
}

// A part packed from the start with nothing done before it, lowered alone.
theorem Act::lowered_of(self a: Act, next: Nat, g: List<Node>, f: List<Stmt> → List<Stmt>, s: Stmt,
    packs: (d: List<Stmt>) → a.packs(next, Packing(d, [])) = Packing(f(d), g), closed: Packing(f([]), g).stmt() = s): a.lowered_at(next) = s {
    trans(cong_fn<Packing, Stmt>(λ k => k.stmt(), packs([])), closed)
}

// The tool's source, from its statement's lowering.
theorem Tool::source_of(self t: Tool, buffers: List<Buffer>, main: Stmt, opened: t.opened(0).buffers = buffers, lowered: t.opened(0).main.lowered_at(0) = main):
    t.source() = Source::of(buffers, main) {
    j(opened, λ b _ => t.source() = Source::of(b, main),
        j(lowered, λ m _ => t.source() = Source::of(t.opened(0).buffers, m), refl))
}

// ---------------------------------------------------------------------------
// Reads, for `write-elf`

fn Val::size(self v: Val) → Nat {
    match v {
        Number(_) => 1,
        Held(_) => 1,
        Sum(left, right) => Succ(left.size() + right.size()),
        Difference(left, right) => Succ(left.size() + right.size()),
        BitsAnd(left, right) => Succ(left.size() + right.size()),
        BitsOr(left, right) => Succ(left.size() + right.size()),
        BitsXor(left, right) => Succ(left.size() + right.size()),
        ShiftedLeft(value, _) => Succ(value.size()),
        ShiftedRight(value, _) => Succ(value.size()),
        Lower(left, right) => Succ(left.size() + right.size()),
        LowerSigned(left, right) => Succ(left.size() + right.size()),
        Equals(left, right) => Succ(left.size() + right.size()),
        Not(value) => Succ(Succ(value.size())),
        ByteAt(_, index) => Succ(index.size()),
    }
}

// A pure statement's values and statements, its binders met from `next`
// as `Calc::pieces` meets them.
fn Calc::size(self c: Calc, next: Nat) → Nat {
    match c {
        Nothing => 1,
        Both(parts) => Succ(parts(True).size(next) + parts(False).size(next)),
        Fresh(init, body) => Succ(init.size() + body(Var(next)).size(Succ(next))),
        Assign(_, value) => Succ(value.size()),
        Store(_, index, value) => Succ(index.size() + value.size()),
        Choose(condition, arms) => Succ(condition.size() + (arms(True).size(next) + arms(False).size(next))),
        Passes(bound, state, body, stop, _) => Succ(bound.size() + (state.len() + (body(Var(next)).size(next) + stop.size()))),
    }
}

// The statement tree in preorder, three numbers a statement: its kind, the
// first word free where it is met, and the size of its own values; then its
// parts (`Act::part`), `True`'s first. Nothing is lowered.
fn Act::shape(self a: Act, next: Nat) → List<Nat> {
    match a {
        Skip => [0, next, 0],
        Seq(parts) => List::append([1, next, 0], List::append(parts(True).shape(next), parts(False).shape(next))),
        Let(init, body) => List::append([2, next, init.size()], body(Var(next)).shape(Succ(next))),
        Set(_, value) => [3, next, value.size()],
        Poke(_, index, value) => [4, next, index.size() + value.size()],
        When(condition, arms) => List::append([5, next, condition.size()], List::append(arms(True).shape(next), arms(False).shape(next))),
        While(condition, body) => List::append([6, next, condition.size()], body.shape(Succ(next))),
        DoWhile(body, condition) => List::append([7, next, condition.size()], body.shape(Succ(next))),
        ReadTo(fd, _, len, _) => [8, next, fd.size() + len.size()],
        WriteFrom(fd, _, from, len, _) => [9, next, fd.size() + from.size() + len.size()],
        OpenOf(_, len, _) => [10, next, len.size()],
        CloseOf(fd, _) => [11, next, fd.size()],
        ArgTo(index, _, _) => [12, next, index.size()],
        Quit(status) => [13, next, status.size()],
        Calculate(calc) => [14, next, calc.size(next)],
    }
}

fn List::spell_done(self done: List<Stmt>) → Option<List<Nat>> {
    match done { Nil => Some([]), Cons(s, rest) => s.spelled_stmt().spell_then(rest.spell_done()) }
}

// The statements done (the last first), each spelled as
// `Stmt::spelled_stmt`, after their count; then the leaf's nodes, after
// theirs. `[]` if a statement does not spell.
fn Packing::spelled(self k: Packing) → List<Nat> {
    match k.done.spell_done() {
        None => [],
        Some(done) => Cons(k.done.len(), done ++ Cons(k.group.len(), k.group.spell_nodes())),
    }
}

// What a planned packing read: the packing after the part, the plan left,
// and the numbers read.
record Traced { k: Packing, plan: List<Nat>, out: List<Nat> }

// `fresh`, packed from nothing done, after `k`: its statements done on
// `k`'s. A packing's steps do not look into what is done, so this is
// packing onto `k` from `k`'s leaf.
fn Packing::after(self fresh: Packing, k: Packing) → Packing { Packing(fresh.done ++ k.done, fresh.group) }

// The statement packed onto `k`, read as `write-elf` states it (`plan`
// says, a statement at a time in preorder, `1` that it is packed whole and
// `0` that it is joined from its parts): a whole statement's packing from
// `k`'s leaf (`Packing::spelled`); a `Let`'s word set, then its body's; a
// branch's arms', then its test and its test's nodes packed from `k`'s
// leaf; a `while`'s body, then its test, its test's nodes packed after the
// body, and from `k`'s leaf; a `do … while`'s body, its test, its test's
// nodes packed after the body; a sequence's parts'. Each value forced is
// bound by a `match`, so nothing is packed twice.
// The statement packed whole onto `k`, read from `k`'s leaf.
fn Act::traced_whole(self a: Act, next: Nat, k: Packing, plan: List<Nat>) → Traced {
    match a.packs(next, Packing([], k.group)) { Packing(done, group) => Traced(Packing(done, group).after(k), plan, Packing(done, group).spelled()) }
}

// Whether the plan joins the next statement from its parts, and the plan
// after its flag.
fn List::joins(self plan: List<Nat>) → Bool { match plan { Nil => False, Cons(flag, _) => match flag { Zero => True, Succ(_) => False } } }
fn List::after_flag(self plan: List<Nat>) → List<Nat> { match plan { Nil => [], Cons(_, rest) => rest } }

fn Act::traced(self a: Act, next: Nat, k: Packing, plan: List<Nat>) → Traced {
    match a {
        Seq(parts) => match plan.joins() {
            False => Seq(parts).traced_whole(next, k, plan.after_flag()),
            True => match parts(True).traced(next, k, plan.after_flag()) {
                Traced(k1, plan1, out1) => match parts(False).traced(next, k1, plan1) { Traced(k2, plan2, out2) => Traced(k2, plan2, out1 ++ out2) },
            },
        },
        Let(init, body) => match plan.joins() {
            False => Let(init, body).traced_whole(next, k, plan.after_flag()),
            True => match init.assigned(next, Succ(next)).ops().pack(Packing([], k.group)) {
                Packing(done, group) => match body(Var(next)).traced(Succ(next), Packing(done, group).after(k), plan.after_flag()) {
                    Traced(k1, plan1, out1) => Traced(k1, plan1, Packing(done, group).spelled() ++ out1),
                },
            },
        },
        When(condition, arms) => match plan.joins() {
            False => When(condition, arms).traced_whole(next, k, plan.after_flag()),
            True => match condition.truth().place(next) {
                Placed(nodes, id, _) => match arms(True).traced(next, Packing::start(), plan.after_flag()) {
                    Traced(ky, plan1, out1) => match arms(False).traced(next, Packing::start(), plan1) {
                        Traced(kn, plan2, out2) => match nodes.ops().pack(Packing([], k.group)) {
                            Packing(done, group) => Traced(Packing(done, group).after(k).step(Do(Branch(id, ky.stmt(), kn.stmt()))), plan2,
                                out1 ++ out2 ++ Cons(id, Packing(done, group).spelled())),
                        },
                    },
                },
            },
        },
        While(condition, body) => match plan.joins() {
            False => While(condition, body).traced_whole(next, k, plan.after_flag()),
            True => match condition.truth().place(next) {
                Placed(nodes, id, _) => match body.traced(Succ(next), Packing::start(), plan.after_flag()) {
                    Traced(kb, plan1, out1) => match nodes.ops().pack(Packing([], kb.group)) {
                        Packing(closing, last) => match nodes.ops().pack(Packing([], k.group)) {
                            Packing(done, group) => Traced(
                                Packing(done, group).after(k).step(Do(Branch(id, Repeat(Packing(closing, last).after(kb).stmt(), id), Stmt::leaf([])))), plan1,
                                out1 ++ Cons(id, Packing(closing, last).spelled() ++ Packing(done, group).spelled())),
                        },
                    },
                },
            },
        },
        DoWhile(body, condition) => match plan.joins() {
            False => DoWhile(body, condition).traced_whole(next, k, plan.after_flag()),
            True => match condition.truth().place(next) {
                Placed(nodes, id, _) => match body.traced(Succ(next), Packing::start(), plan.after_flag()) {
                    Traced(kb, plan1, out1) => match nodes.ops().pack(Packing([], kb.group)) {
                        Packing(closing, last) => Traced(k.step(Do(Repeat(Packing(closing, last).after(kb).stmt(), id))), plan1,
                            out1 ++ Cons(id, Packing(closing, last).spelled())),
                    },
                },
            },
        },
        Skip => Act::traced_whole(Skip, next, k, plan.after_flag()),
        Set(var, value) => Set(var, value).traced_whole(next, k, plan.after_flag()),
        Poke(buf, index, value) => Poke(buf, index, value).traced_whole(next, k, plan.after_flag()),
        ReadTo(fd, buf, len, result) => ReadTo(fd, buf, len, result).traced_whole(next, k, plan.after_flag()),
        WriteFrom(fd, buf, from, len, result) => WriteFrom(fd, buf, from, len, result).traced_whole(next, k, plan.after_flag()),
        OpenOf(path, len, result) => OpenOf(path, len, result).traced_whole(next, k, plan.after_flag()),
        CloseOf(fd, result) => CloseOf(fd, result).traced_whole(next, k, plan.after_flag()),
        ArgTo(index, buf, len) => ArgTo(index, buf, len).traced_whole(next, k, plan.after_flag()),
        Quit(status) => Quit(status).traced_whole(next, k, plan.after_flag()),
        Calculate(calc) => Calculate(calc).traced_whole(next, k, plan.after_flag()),
    }
}

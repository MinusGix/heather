// A source spelled as numbers, for `heather write-elf`
// (issues/native-source-builder.md).
//
// `write-elf` reads a source this way on its fork and states it as a
// literal the kernel checks equal to the source by `refl`, then compiles
// the literal, so a tool's lowering is evaluated once and not again in
// every statement of the certificate (crates/cli/src/native/elf.rs). A
// source this cannot spell is `[0]`, and `write-elf` then compiles the
// source as it is. Untrusted: a misspelling is a literal the kernel refuses.
import native_source;
import function_ir;
import function_ir_operation;
import bitvec;
import list;
import option;

fn List::spell_ports(self ports: List<Port>) → List<Nat> {
    match ports { Nil => [], Cons(port, rest) => Cons(port.id, Cons(port.width, rest.spell_ports())) }
}

fn Ports::spelled_ports(self ports: Ports) → List<Nat> { Cons(ports.entries.len(), ports.entries.spell_ports()) }

// A node's tag, then its fields in order.
fn Node::spelled_node(self node: Node) → List<Nat> {
    match node {
        Const(width, output, value) => [0, width, output, value],
        Move(width, output, source) => [1, width, output, source],
        Add(width, output, left, right) => [2, width, output, left, right],
        Sub(width, output, left, right) => [3, width, output, left, right],
        BitAnd(width, output, left, right) => [4, width, output, left, right],
        BitOr(width, output, left, right) => [5, width, output, left, right],
        BitXor(width, output, left, right) => [6, width, output, left, right],
        ShiftLeft(width, output, value, amount) => [7, width, output, value, amount],
        LogicalShiftRight(width, output, value, amount) => [8, width, output, value, amount],
        ArithmeticShiftRight(width, output, value, amount) => [9, width, output, value, amount],
        UnsignedLessThan(width, output, left, right) => [10, width, output, left, right],
        SignedLessThan(width, output, left, right) => [11, width, output, left, right],
        Equal(width, output, left, right) => [12, width, output, left, right],
        BufferLoad(output, buffer, index) => [13, output, buffer, index],
        BufferStore(output, buffer, index, value) => [14, output, buffer, index, value],
        Resize(from, to, output, source) => [15, from, to, output, source],
        SignResize(from, to, output, source) => [16, from, to, output, source],
        TableRead(width, output, bits, index, entries) => Cons(17, Cons(width, Cons(output, Cons(bits, Cons(index, Cons(entries.len(), entries)))))),
        WideLoad(bytes, output, buffer, index) => [18, bytes, output, buffer, index],
        WideStore(bytes, output, buffer, index, value) => [19, bytes, output, buffer, index, value],
        ByteSwap(width, output, source) => [20, width, output, source],
        RotateRight(width, output, value, amount) => [21, width, output, value, amount],
        Apply(op, width, output, left, right) => [22, op.code(), width, output, left, right],
    }
}

fn List::spell_nodes(self nodes: List<Node>) → List<Nat> {
    match nodes { Nil => [], Cons(node, rest) => node.spelled_node() ++ rest.spell_nodes() }
}

fn CallShape::spelled_call(self shape: CallShape) → List<Nat> {
    match shape {
        Reads(fd, buf, at, len, result) => [0, fd, buf, at, len, result],
        Writes(fd, buf, from, len, result) => [1, fd, buf, from, len, result],
        Opens(path, len, result) => [2, path, len, result],
        Closes(fd, result) => [3, fd, result],
        StatsPath(path, len, out, result) => [4, path, len, out, result],
        StatsFd(fd, out, result) => [5, fd, out, result],
    }
}

// A dataflow leaf's ports and nodes.
fn Region::spelled_body(self body: Region) → List<Nat> {
    List::append(body.inputs.spelled_ports(), Cons(body.nodes.len(), List::append(body.nodes.spell_nodes(), body.outputs.spelled_ports())))
}

fn List::spell_ids(self ids: List<Nat>) → List<Nat> { Cons(ids.len(), ids) }

// A call's views, after their count: each its seven fields, `written` as a
// bit.
fn spell_views(views: List<View>) → List<Nat> {
    match views {
        Nil => [],
        Cons(view, rest) => Cons(view.buffer, Cons(view.home, Cons(view.start, Cons(view.end,
            Cons(match view.written { False => 0, True => 1 }, Cons(view.base, Cons(view.length, spell_views(rest)))))))),
    }
}

// A region's tag, then its fields in order, its parts' in prefix order:
// 0 a leaf, 1 a sequence, 2 a composition, 3 a conditional, 4 a call, 5 a
// loop, 6 a call over views (issues/native-region-spelling.md), 9 a loop
// with no bound (docs/language/loop-combinator-design.md §6.9).
fn StructuredRegion::spelled_tagged(self region: StructuredRegion) → List<Nat> {
    match region {
        Dataflow(body) => Cons(0, body.spelled_body()),
        Sequence(prefix, continuation) => Cons(1, List::append(prefix.spelled_body(), continuation.spelled_tagged())),
        Compose(prefix, continuation) => Cons(2, List::append(prefix.spelled_tagged(), continuation.spelled_tagged())),
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => Cons(3, List::append(inputs.spelled_ports(),
            Cons(condition, List::append(arguments.spelled_ports(), List::append(outputs.spelled_ports(),
                List::append(when_true.spelled_tagged(), when_false.spelled_tagged())))))),
        Lend(views, callee, arguments, result) => Cons(6, Cons(views.len(), List::append(spell_views(views),
            Cons(callee, List::append(arguments.spell_ids(), [result]))))),
        // A call of one word as it always was; one of more words tagged 8,
        // its words past the first after the result.
        Call(callee, arguments, result, also) => match also {
            Nil => Cons(4, Cons(callee, List::append(arguments.spell_ids(), [result]))),
            Cons(_, _) => Cons(8, Cons(callee, List::append(arguments.spell_ids(), Cons(result, also.spell_ids())))),
        },
        Loop(inputs, bound, parameters, count, body, exit, next, outputs, exhausted) => Cons(5, List::append(inputs.spell_ids(),
            Cons(bound, List::append(parameters.spell_ids(), Cons(count, List::append(body.spelled_tagged(),
                Cons(exit, List::append(next.spell_ids(), List::append(outputs.spell_ids(), [exhausted]))))))))),
        Until(inputs, parameters, body, exit, next, outputs) => Cons(9, List::append(inputs.spell_ids(),
            List::append(parameters.spell_ids(), List::append(body.spelled_tagged(),
                Cons(exit, List::append(next.spell_ids(), outputs.spell_ids())))))),
    }
}

fn Option::spell_then(self first: Option<List<Nat>>, rest: Option<List<Nat>>) → Option<List<Nat>> {
    match first { None => None, Some(a) => match rest { None => None, Some(b) => Some(a ++ b) } }
}

// A statement's tag, then its fields, a statement's in prefix order.
fn Stmt::spelled_stmt(self s: Stmt) → Option<List<Nat>> {
    match s {
        // A leaf as it always was; any other region tagged.
        Compute(region) => match region {
            Dataflow(body) => Some(Cons(0, body.spelled_body())),
            Sequence(_, _) => Some(Cons(7, region.spelled_tagged())),
            Compose(_, _) => Some(Cons(7, region.spelled_tagged())),
            Conditional(_, _, _, _, _, _) => Some(Cons(7, region.spelled_tagged())),
            Lend(_, _, _, _) => Some(Cons(7, region.spelled_tagged())),
            Call(_, _, _, _) => Some(Cons(7, region.spelled_tagged())),
            Loop(_, _, _, _, _, _, _, _, _) => Some(Cons(7, region.spelled_tagged())),
            Until(_, _, _, _, _, _) => Some(Cons(7, region.spelled_tagged())),
        },
        Invoke(shape) => Some(Cons(1, shape.spelled_call())),
        Then(first, rest) => Some([2]).spell_then(first.spelled_stmt()).spell_then(rest.spelled_stmt()),
        Branch(condition, yes, no) => Some([3, condition]).spell_then(yes.spelled_stmt()).spell_then(no.spelled_stmt()),
        Repeat(body, again) => Some([4, again]).spell_then(body.spelled_stmt()),
        Exit(status) => Some([5, status]),
        Arg(index, buf, len) => Some([6, index, buf, len]),
        Perform(procedure, args, results) => Some(Cons(8, Cons(procedure, Cons(args.len(), List::append(args, Cons(results.len(), results)))))),
    }
}

fn List::spell_buffers(self buffers: List<Buffer>) → List<Nat> {
    match buffers {
        Nil => [],
        Cons(b, rest) => Cons(b.capacity, Cons(b.initial.len(), List::append(b.initial.map(λ (c: BitVec(8)) => c.toNat()), rest.spell_buffers()))),
    }
}

// Each procedure: its parameters' count and ids, its results' count and
// ids, then its body.
fn List::spell_procedures(self procs: List<Procedure>) → Option<List<Nat>> {
    match procs {
        Nil => Some([]),
        Cons(proc, rest) => Some(Cons(proc.params.len(), List::append(proc.params, Cons(proc.results.len(), proc.results))))
            .spell_then(proc.body.spelled_stmt()).spell_then(rest.spell_procedures()),
    }
}

// Each function: its parameters' count and ids, its body, its result, then
// how many buffers it is lent.
fn List::spell_functions(self functions: List<Function>) → List<Nat> {
    match functions {
        Nil => [],
        Cons(f, rest) => List::append(f.parameters.spell_ids(),
            List::append(f.body.spelled_tagged(), Cons(f.result, Cons(f.lent, rest.spell_functions())))),
    }
}

// `[1]`, its words, its buffers' count and each buffer, then `main`; with
// procedures `[2]`, its words, its levels, its buffers, the procedures'
// count and each procedure, then `main`; with functions `[3]`, as `[2]`
// with the functions' count and each function before the procedures'; or
// `[0]`.
fn Source::spelled(self src: Source) → List<Nat> {
    match src.functions {
        Cons(_, _) => match Some(Cons(3, Cons(src.words, Cons(src.levels, Cons(src.buffers.len(), List::append(src.buffers.spell_buffers(),
                    Cons(src.functions.len(), List::append(src.functions.spell_functions(), [src.procedures.len()]))))))))
                .spell_then(src.procedures.spell_procedures()).spell_then(src.main.spelled_stmt()) {
            None => [0],
            Some(spelled) => spelled,
        },
        Nil => match src.procedures {
            Cons(_, _) => match Some(Cons(2, Cons(src.words, Cons(src.levels, Cons(src.buffers.len(), List::append(src.buffers.spell_buffers(), [src.procedures.len()]))))))
                    .spell_then(src.procedures.spell_procedures()).spell_then(src.main.spelled_stmt()) {
                None => [0],
                Some(spelled) => spelled,
            },
            Nil => match src.main.spelled_stmt() {
                None => [0],
                Some(main) => Cons(1, Cons(src.words, Cons(src.buffers.len(), List::append(src.buffers.spell_buffers(), main)))),
            },
        },
    }
}

// A source's statements read against a world, threaded: what a loop-free
// statement does to the capability `Io` and to the environment, as a plain
// function, and that its tree reads as that function at every world
// (docs/language/effects-capabilities-design.md §8.5; issues/effects-uniqueness-surface.md,
// slice 4).
//
// `Stmt::denote_co` is a tree over Linux's calls. A lowering from effectful
// `rt` (`rt_io_lower`) proves its statements agree with a computation's
// meaning, which is world threading (`ETm::sem`, `Io → Mutated<Io, R>`).
// The two meet here, once and for every source: `Stmt::thread` is the
// world-threading meaning of a loop-free statement (`Stmt::straight`), and
// `Stmt::reads_thread` is `Io::Reads` of its tree against it. So a
// lowering's `sound` is a statement about `thread`, an ordinary function of
// the environment and the world, with no tree and no coinduction in it.
//
// The cases are the reading's construct by construct: a region and an
// argument are `Io::reads_ret`, a call is the world answering it one silent
// step away (as `Io::reads_trigger`), `Then` is `Io::reads_bind`, a branch
// is the arm the bit picks. A loop needs `Io::reads_iter` and a `Partial`
// meaning, so `thread` is the loop-free fragment, which is what the
// lowering emits until computations have loops.
import logic;
import nat;
import list;
import option;
import bool;
import bitvec;
import itree;
import coitree;
import coitree_eutt;
import linux_calls;
import linux_trees;
import linux_world;
import linux_world_co;
import function_ir;
import function_ir_operation;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import native_source;
import native_source_co;
import dec_set;
import set_tactic;

// A statement with no loop and no procedure call.
fn Stmt::straight(self s: Stmt) → Bool {
    match s {
        Compute(_) => True,
        Invoke(_) => True,
        Then(first, rest) => first.straight() && rest.straight(),
        Branch(_, yes, no) => yes.straight() && no.straight(),
        Repeat(_, _) => False,
        Exit(_) => True,
        Arg(_, _, _) => True,
        Perform(_, _, _) => False,
    }
}

// A loop-free statement as world threading: each call put to the world, its
// answer decoded into the environment. A loop or a procedure call (which
// `straight` refuses) does nothing.
fn Stmt::thread(self s: Stmt, call: Writers(), env: Env, io: Io) → Mutated<Io, Flow> {
    match s {
        Compute(region) => Mutated(io, Onward(env.compute(call, region))),
        Invoke(shape) => Mutated(Io::call(io, shape.cmd(env)).after, Onward(shape.answer(env, Io::call(io, shape.cmd(env)).value))),
        Then(first, rest) => {
            let m = Stmt::thread(first, call, env, io);
            match m.value {
                Onward(next) => Stmt::thread(rest, call, next, m.after),
                Exited(status) => Mutated(m.after, Exited(status)),
            }
        },
        Branch(condition, yes, no) => match env.bit(condition) {
            True => Stmt::thread(yes, call, env, io),
            False => Stmt::thread(no, call, env, io),
        },
        Repeat(_, _) => Mutated(io, Onward(env)),
        Exit(status) => Mutated(io, Exited(env.word(status))),
        Arg(index, buf, len) => Mutated(io, Onward(env.arg(env.number(index), buf, len))),
        Perform(_, _, _) => Mutated(io, Onward(env)),
    }
}

// The rest of a `Then`, from where the first statement left the world.
fn Stmt::then_thread(rest: Stmt, call: Writers(), m: Mutated<Io, Flow>) → Mutated<Io, Flow> {
    match m.value {
        Onward(next) => Stmt::thread(rest, call, next, m.after),
        Exited(status) => Mutated(m.after, Exited(status)),
    }
}

// The continuation `Then` binds, read as world threading in `Partial`.
fn Stmt::then_co(rest: Stmt, call: Writers(), flow: Flow, io: Io) → Partial(Mutated<Io, Flow>) {
    match flow {
        Onward(next) => CRet(Stmt::thread(rest, call, next, io)),
        Exited(status) => CRet(Mutated(io, Exited(status))),
    }
}

theorem Stmt::then_co_ret(rest: Stmt, call: Writers(), m: Mutated<Io, Flow>):
    Stmt::then_co(rest, call, m.value, m.after) = CRet(Stmt::then_thread(rest, call, m)) {
    match m.value as λ f => (match f as λ _ => Partial(Mutated<Io, Flow>) {
            Onward(next) => CRet(Stmt::thread(rest, call, next, m.after)),
            Exited(status) => CRet(Mutated(m.after, Exited(status))),
        }) = CRet(match f as λ _ => Mutated<Io, Flow> { Onward(next) => Stmt::thread(rest, call, next, m.after), Exited(status) => Mutated(m.after, Exited(status)) }) {
        Onward(_) => refl,
        Exited(_) => refl,
    }
}

// The theorem: a loop-free statement's tree, read against any world, is its
// threading, up to the silent steps the reading takes for calls.
fn Stmt::reads_thread(self s: Stmt, call: Writers(), perform: PerformsCo()) →
    s.straight().IsTrue() → (env: Env) → Io::Reads(s.denote_co(call, perform)(env), λ io => CRet(Stmt::thread(s, call, env, io)))
{
    match s {
        Compute(region) => λ _ env => Io::reads_ret(Onward(env.compute(call, region))),
        Invoke(shape) => λ _ env io => ERet(1, 0, Stmt::thread(Invoke(shape), call, env, io), refl, refl),
        Then(first, rest) => λ ok env => {
            let parts = Bool::is_true_and(first.straight(), rest.straight(), ok);
            let h = λ (flow: Flow) => match flow as λ _ => CoTree<Flow>(Events::linux()) {
                Onward(next) => rest.denote_co(call, perform)(next),
                Exited(status) => CRet(Exited(status)),
            };
            let rh: (flow: Flow) → Io::Reads(h(flow), λ io => Stmt::then_co(rest, call, flow, io)) = λ flow => match flow as λ f =>
                    Io::Reads(match f as λ _ => CoTree<Flow>(Events::linux()) {
                        Onward(next) => rest.denote_co(call, perform)(next),
                        Exited(status) => CRet(Exited(status)),
                    }, λ io => Stmt::then_co(rest, call, f, io)) {
                Onward(next) => rest.reads_thread(call, perform, parts.right, next),
                Exited(status) => Io::reads_ret(Exited(status)),
            };
            let bound = Io::reads_bind(first.denote_co(call, perform)(env), λ io => CRet(Stmt::thread(first, call, env, io)), h,
                λ flow io => Stmt::then_co(rest, call, flow, io), first.reads_thread(call, perform, parts.left, env), rh);
            λ io => Eutt::trans(Events::none(), Io::against_co(Stmt::denote_co(Then(first, rest), call, perform)(env), io),
                CoTree::bind<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), CRet(Stmt::thread(first, call, env, io)), λ m => Stmt::then_co(rest, call, m.value, m.after)),
                CRet(Stmt::thread(Then(first, rest), call, env, io)),
                bound(io),
                j(Stmt::then_co_ret(rest, call, Stmt::thread(first, call, env, io)),
                    λ y _ => Eutt<Mutated<Io, Flow>>(Events::none(),
                        CoTree::bind<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), CRet(Stmt::thread(first, call, env, io)), λ m => Stmt::then_co(rest, call, m.value, m.after)), y),
                    Eutt::bind_ret_l<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), Stmt::thread(first, call, env, io), λ m => Stmt::then_co(rest, call, m.value, m.after))))
        },
        Branch(condition, yes, no) => λ ok env => {
            let parts = Bool::is_true_and(yes.straight(), no.straight(), ok);
            match env.bit(condition) as λ b => Io::Reads(
                    match b as λ _ => CoTree<Flow>(Events::linux()) {
                        True => yes.denote_co(call, perform)(env),
                        False => no.denote_co(call, perform)(env),
                    },
                    λ io => CRet(match b as λ _ => Mutated<Io, Flow> { True => Stmt::thread(yes, call, env, io), False => Stmt::thread(no, call, env, io) })) {
                True => yes.reads_thread(call, perform, parts.left, env),
                False => no.reads_thread(call, perform, parts.right, env),
            }
        },
        Repeat(_, _) => λ never => false_elim(never),
        Exit(status) => λ _ env => Io::reads_ret(Exited(env.word(status))),
        Arg(index, buf, len) => λ _ env => Io::reads_ret(Onward(env.arg(env.number(index), buf, len))),
        Perform(_, _, _) => λ never => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// Calls answered (docs/native/runtime-fn-recursion-design.md §6 step 1)
//
// A procedure call is a tree of its own, so `thread` leaves it out. Where
// each call's tree is known to read as a function of the caller's
// environment and the world, its answer, a statement with calls and no loop
// threads the same way: `thread_by` puts each call to its answer, and
// `reads_thread_by` is `reads_thread` with a call's case read off the
// premise that it reads as its answer. A pure callee's answer is its value
// moved into the caller's word, or the stop where it ran out of levels,
// with the world unchanged.

// What each call leaves: its flow back in the caller, and the world.
fn CallAnswers() → Type { Nat → List<Nat> → List<Nat> → Env → Io → Mutated<Io, Flow> }

// A statement with no loop; it may call procedures.
fn Stmt::loop_free(self s: Stmt) → Bool {
    match s {
        Compute(_) => True,
        Invoke(_) => True,
        Then(first, rest) => first.loop_free() && rest.loop_free(),
        Branch(_, yes, no) => yes.loop_free() && no.loop_free(),
        Repeat(_, _) => False,
        Exit(_) => True,
        Arg(_, _, _) => True,
        Perform(_, _, _) => True,
    }
}

// A loop-free statement as world threading, each call put to its answer.
fn Stmt::thread_by(self s: Stmt, call: Writers(), answer: CallAnswers(), env: Env, io: Io) → Mutated<Io, Flow> {
    match s {
        Compute(region) => Mutated(io, Onward(env.compute(call, region))),
        Invoke(shape) => Mutated(Io::call(io, shape.cmd(env)).after, Onward(shape.answer(env, Io::call(io, shape.cmd(env)).value))),
        Then(first, rest) => {
            let m = Stmt::thread_by(first, call, answer, env, io);
            match m.value {
                Onward(next) => Stmt::thread_by(rest, call, answer, next, m.after),
                Exited(status) => Mutated(m.after, Exited(status)),
            }
        },
        Branch(condition, yes, no) => match env.bit(condition) {
            True => Stmt::thread_by(yes, call, answer, env, io),
            False => Stmt::thread_by(no, call, answer, env, io),
        },
        Repeat(_, _) => Mutated(io, Onward(env)),
        Exit(status) => Mutated(io, Exited(env.word(status))),
        Arg(index, buf, len) => Mutated(io, Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => answer(procedure, args, results, env, io),
    }
}

// The continuation `Then` binds, threaded with calls answered, in `Partial`.
fn Stmt::then_co_by(rest: Stmt, call: Writers(), answer: CallAnswers(), flow: Flow, io: Io) → Partial(Mutated<Io, Flow>) {
    match flow {
        Onward(next) => CRet(Stmt::thread_by(rest, call, answer, next, io)),
        Exited(status) => CRet(Mutated(io, Exited(status))),
    }
}

theorem Stmt::then_co_by_ret(rest: Stmt, call: Writers(), answer: CallAnswers(), m: Mutated<Io, Flow>):
    Stmt::then_co_by(rest, call, answer, m.value, m.after) = CRet(match m.value as λ _ => Mutated<Io, Flow> {
        Onward(next) => Stmt::thread_by(rest, call, answer, next, m.after),
        Exited(status) => Mutated(m.after, Exited(status)),
    }) {
    match m.value as λ f => (match f as λ _ => Partial(Mutated<Io, Flow>) {
            Onward(next) => CRet(Stmt::thread_by(rest, call, answer, next, m.after)),
            Exited(status) => CRet(Mutated(m.after, Exited(status))),
        }) = CRet(match f as λ _ => Mutated<Io, Flow> { Onward(next) => Stmt::thread_by(rest, call, answer, next, m.after), Exited(status) => Mutated(m.after, Exited(status)) }) {
        Onward(_) => refl,
        Exited(_) => refl,
    }
}

// Every call's tree reads as its answer.
fn Stmt::Answered(perform: PerformsCo(), answer: CallAnswers()) → Type {
    (procedure: Nat) → (args: List<Nat>) → (results: List<Nat>) → (env: Env) →
        Io::Reads(perform(procedure, args, results, env), λ io => CRet(answer(procedure, args, results, env, io)))
}

// The theorem: a loop-free statement's tree, read against any world, is its
// threading with each call put to its answer, where every call's tree reads
// as its answer.
fn Stmt::reads_thread_by(self s: Stmt, call: Writers(), perform: PerformsCo(), answer: CallAnswers(), answered: Stmt::Answered(perform, answer)) →
    s.loop_free().IsTrue() → (env: Env) → Io::Reads(s.denote_co(call, perform)(env), λ io => CRet(Stmt::thread_by(s, call, answer, env, io)))
{
    match s {
        Compute(region) => λ _ env => Io::reads_ret(Onward(env.compute(call, region))),
        Invoke(shape) => λ _ env io => ERet(1, 0, Stmt::thread_by(Invoke(shape), call, answer, env, io), refl, refl),
        Then(first, rest) => λ ok env => {
            let parts = Bool::is_true_and(first.loop_free(), rest.loop_free(), ok);
            let h = λ (flow: Flow) => match flow as λ _ => CoTree<Flow>(Events::linux()) {
                Onward(next) => rest.denote_co(call, perform)(next),
                Exited(status) => CRet(Exited(status)),
            };
            let rh: (flow: Flow) → Io::Reads(h(flow), λ io => Stmt::then_co_by(rest, call, answer, flow, io)) = λ flow => match flow as λ f =>
                    Io::Reads(match f as λ _ => CoTree<Flow>(Events::linux()) {
                        Onward(next) => rest.denote_co(call, perform)(next),
                        Exited(status) => CRet(Exited(status)),
                    }, λ io => Stmt::then_co_by(rest, call, answer, f, io)) {
                Onward(next) => rest.reads_thread_by(call, perform, answer, answered, parts.right, next),
                Exited(status) => Io::reads_ret(Exited(status)),
            };
            let bound = Io::reads_bind(first.denote_co(call, perform)(env), λ io => CRet(Stmt::thread_by(first, call, answer, env, io)), h,
                λ flow io => Stmt::then_co_by(rest, call, answer, flow, io), first.reads_thread_by(call, perform, answer, answered, parts.left, env), rh);
            λ io => Eutt::trans(Events::none(), Io::against_co(Stmt::denote_co(Then(first, rest), call, perform)(env), io),
                CoTree::bind<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), CRet(Stmt::thread_by(first, call, answer, env, io)),
                    λ m => Stmt::then_co_by(rest, call, answer, m.value, m.after)),
                CRet(Stmt::thread_by(Then(first, rest), call, answer, env, io)),
                bound(io),
                j(Stmt::then_co_by_ret(rest, call, answer, Stmt::thread_by(first, call, answer, env, io)),
                    λ y _ => Eutt<Mutated<Io, Flow>>(Events::none(),
                        CoTree::bind<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), CRet(Stmt::thread_by(first, call, answer, env, io)),
                            λ m => Stmt::then_co_by(rest, call, answer, m.value, m.after)), y),
                    Eutt::bind_ret_l<Mutated<Io, Flow>, Mutated<Io, Flow>>(Events::none(), Stmt::thread_by(first, call, answer, env, io),
                        λ m => Stmt::then_co_by(rest, call, answer, m.value, m.after))))
        },
        Branch(condition, yes, no) => λ ok env => {
            let parts = Bool::is_true_and(yes.loop_free(), no.loop_free(), ok);
            match env.bit(condition) as λ b => Io::Reads(
                    match b as λ _ => CoTree<Flow>(Events::linux()) {
                        True => yes.denote_co(call, perform)(env),
                        False => no.denote_co(call, perform)(env),
                    },
                    λ io => CRet(match b as λ _ => Mutated<Io, Flow> {
                        True => Stmt::thread_by(yes, call, answer, env, io),
                        False => Stmt::thread_by(no, call, answer, env, io),
                    })) {
                True => yes.reads_thread_by(call, perform, answer, answered, parts.left, env),
                False => no.reads_thread_by(call, perform, answer, answered, parts.right, env),
            }
        },
        Repeat(_, _) => λ never => false_elim(never),
        Exit(status) => λ _ env => Io::reads_ret(Exited(env.word(status))),
        Arg(index, buf, len) => λ _ env => Io::reads_ret(Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => λ _ env => answered(procedure, args, results, env),
    }
}

// Only the calls a run makes need answering. `calls_ok` threads as
// `thread_by` does and asks `ok` of each call it reaches, so a premise on a
// call's arguments (a recursion within its levels) is asked only where the
// call is made. One world at a time: which calls are reached depends on the
// answers before them.

// Whether each call a loop-free statement makes, threaded with its calls
// answered, is `ok`.
fn Stmt::calls_ok(self s: Stmt, call: Writers(), answer: CallAnswers(), ok: Nat → List<Nat> → List<Nat> → Env → Bool, env: Env, io: Io) → Bool {
    match s {
        Compute(_) => True,
        Invoke(_) => True,
        Then(first, rest) => {
            let m = Stmt::thread_by(first, call, answer, env, io);
            first.calls_ok(call, answer, ok, env, io) && (match m.value {
                Onward(next) => rest.calls_ok(call, answer, ok, next, m.after),
                Exited(_) => True,
            })
        },
        Branch(condition, yes, no) => match env.bit(condition) {
            True => yes.calls_ok(call, answer, ok, env, io),
            False => no.calls_ok(call, answer, ok, env, io),
        },
        Repeat(_, _) => True,
        Exit(_) => True,
        Arg(_, _, _) => True,
        Perform(procedure, args, results) => ok(procedure, args, results, env),
    }
}

// Each call of a procedure `s` performs, where `ok`, reads as its answer.
fn Stmt::AnsweredWhere(s: Stmt, perform: PerformsCo(), answer: CallAnswers(), ok: Nat → List<Nat> → List<Nat> → Env → Bool) → Type {
    (procedure: Nat) → (args: List<Nat>) → (results: List<Nat>) → (env: Env) → Mem(procedure, s.performed()) → ok(procedure, args, results, env).IsTrue() →
        Io::Reads(perform(procedure, args, results, env), λ io => CRet(answer(procedure, args, results, env, io)))
}

// The theorem, at one world: where every call the run makes is `ok` and
// each such call reads as its answer, the statement's tree reads as its
// threading with calls answered.
fn Stmt::reads_where(self s: Stmt, call: Writers(), perform: PerformsCo(), answer: CallAnswers(), ok: Nat → List<Nat> → List<Nat> → Env → Bool,
    answered: Stmt::AnsweredWhere(s, perform, answer, ok)) →
    s.loop_free().IsTrue() → (env: Env) → (io: Io) → s.calls_ok(call, answer, ok, env, io).IsTrue() →
    Eutt<Mutated<Io, Flow>>(Events::none(), Io::against_co(s.denote_co(call, perform)(env), io), CRet(Stmt::thread_by(s, call, answer, env, io)))
{
    match s {
        Compute(region) => λ _ env io _ => ERet(0, 0, Mutated(io, Onward(env.compute(call, region))), refl, refl),
        Invoke(shape) => λ _ env io _ => ERet(1, 0, Stmt::thread_by(Invoke(shape), call, answer, env, io), refl, refl),
        Then(first, rest) => λ lf env io oks => {
            let parts = Bool::is_true_and(first.loop_free(), rest.loop_free(), lf);
            let m0 = Stmt::thread_by(first, call, answer, env, io);
            let okp = Bool::is_true_and(first.calls_ok(call, answer, ok, env, io), match m0.value as λ _ => Bool {
                Onward(next) => rest.calls_ok(call, answer, ok, next, m0.after),
                Exited(_) => True,
            }, oks);
            let answered_first: Stmt::AnsweredWhere(first, perform, answer, ok) =
                λ q a r e m okq => answered(q, a, r, e, first.performed().mem_append_l(rest.performed(), q, m), okq);
            let answered_rest: Stmt::AnsweredWhere(rest, perform, answer, ok) =
                λ q a r e m okq => answered(q, a, r, e, first.performed().mem_append_r(rest.performed(), q, m), okq);
            let h = λ (flow: Flow) => match flow as λ _ => CoTree<Flow>(Events::linux()) {
                Onward(next) => rest.denote_co(call, perform)(next),
                Exited(status) => CRet(Exited(status)),
            };
            let k = λ (m: Mutated<Io, Flow>) => Io::against_co(h(m.value), m.after);
            let first_tree = first.denote_co(call, perform)(env);
            let rh: (flow: Flow) → (io2: Io) → (match flow as λ _ => Bool { Onward(next) => rest.calls_ok(call, answer, ok, next, io2), Exited(_) => True }).IsTrue() →
                    Eutt<Mutated<Io, Flow>>(Events::none(), Io::against_co(h(flow), io2), Stmt::then_co_by(rest, call, answer, flow, io2)) =
                λ flow => match flow as λ f => (io2: Io) → (match f as λ _ => Bool { Onward(next) => rest.calls_ok(call, answer, ok, next, io2), Exited(_) => True }).IsTrue() →
                        Eutt<Mutated<Io, Flow>>(Events::none(), Io::against_co(match f as λ _ => CoTree<Flow>(Events::linux()) {
                            Onward(next) => rest.denote_co(call, perform)(next),
                            Exited(status) => CRet(Exited(status)),
                        }, io2), Stmt::then_co_by(rest, call, answer, f, io2)) {
                    Onward(next) => λ io2 okr => rest.reads_where(call, perform, answer, ok, answered_rest, parts.right, next, io2, okr),
                    Exited(status) => λ io2 _ => ERet(0, 0, Mutated(io2, Exited(status)), refl, refl),
                };
            let t3: Partial(Mutated<Io, Flow>) = Io::against_co(h(m0.value), m0.after);
            let t4: Partial(Mutated<Io, Flow>) = Stmt::then_co_by(rest, call, answer, m0.value, m0.after);
            let t5: Partial(Mutated<Io, Flow>) = CRet(Stmt::thread_by(Then(first, rest), call, answer, env, io));
            Eutt::trans(Events::none(), Io::against_co(CoTree::bind(Events::linux(), first_tree, h), io),
                CoTree::bind(Events::none(), Io::against_co(first_tree, io), k), t5,
                Eutt::of_bisim(Events::none(), Io::against_co(CoTree::bind(Events::linux(), first_tree, h), io),
                    CoTree::bind(Events::none(), Io::against_co(first_tree, io), k), Io::against_co_bind(h, first_tree, io)),
                Eutt::trans(Events::none(), CoTree::bind(Events::none(), Io::against_co(first_tree, io), k), CoTree::bind(Events::none(), CRet(m0), k), t5,
                    Eutt::bind_cong_l(Events::none(), Io::against_co(first_tree, io), CRet(m0), k,
                        first.reads_where(call, perform, answer, ok, answered_first, parts.left, env, io, okp.left)),
                    Eutt::trans(Events::none(), CoTree::bind(Events::none(), CRet(m0), k), t3, t5, Eutt::bind_ret_l(Events::none(), m0, k),
                        Eutt::trans(Events::none(), t3, t4, t5, rh(m0.value, m0.after, okp.right),
                            j(Stmt::then_co_by_ret(rest, call, answer, m0), λ y _ => Eutt<Mutated<Io, Flow>>(Events::none(), t4, y),
                                Eutt::refl(Events::none(), t4))))))
        },
        Branch(condition, yes, no) => λ lf env io oks => {
            let parts = Bool::is_true_and(yes.loop_free(), no.loop_free(), lf);
            let ay: Stmt::AnsweredWhere(yes, perform, answer, ok) =
                λ q a r e m okq => answered(q, a, r, e, yes.performed().mem_append_l(no.performed(), q, m), okq);
            let an: Stmt::AnsweredWhere(no, perform, answer, ok) =
                λ q a r e m okq => answered(q, a, r, e, yes.performed().mem_append_r(no.performed(), q, m), okq);
            (match env.bit(condition) as λ b => (match b as λ _ => Bool {
                    True => yes.calls_ok(call, answer, ok, env, io),
                    False => no.calls_ok(call, answer, ok, env, io),
                }).IsTrue() →
                Eutt<Mutated<Io, Flow>>(Events::none(), Io::against_co(match b as λ _ => CoTree<Flow>(Events::linux()) {
                        True => yes.denote_co(call, perform)(env),
                        False => no.denote_co(call, perform)(env),
                    }, io),
                    CRet(match b as λ _ => Mutated<Io, Flow> {
                        True => Stmt::thread_by(yes, call, answer, env, io),
                        False => Stmt::thread_by(no, call, answer, env, io),
                    })) {
                True => λ okb => yes.reads_where(call, perform, answer, ok, ay, parts.left, env, io, okb),
                False => λ okb => no.reads_where(call, perform, answer, ok, an, parts.right, env, io, okb),
            })(oks)
        },
        Repeat(_, _) => λ never => false_elim(never),
        Exit(status) => λ _ env io _ => ERet(0, 0, Mutated(io, Exited(env.word(status))), refl, refl),
        Arg(index, buf, len) => λ _ env io _ => ERet(0, 0, Mutated(io, Onward(env.arg(env.number(index), buf, len))), refl, refl),
        Perform(procedure, args, results) => λ _ env io okp => answered(procedure, args, results, env, Inl(refl), okp)(io),
    }
}

// ---------------------------------------------------------------------------
// The environment's files, read after a write

// A file's entry `k`, or `d` past its end: `Env::number` with `d` zero,
// `Env::buffer` with `d` empty.
fn List::read_or<A>(self xs: List<A>, k: Nat, d: A) → A {
    match xs.nth(k) { None => d, Some(y) => y }
}

theorem List::put_here<A>(i: Nat): (xs: List<A>) → (x: A) → (d: A) → xs.put(i, x, d).read_or(i, d) = x {
    match i {
        Zero => λ xs x d => match xs as λ ys => ys.put(Zero, x, d).read_or(Zero, d) = x { Nil => refl, Cons(_, _) => refl },
        Succ(k) => λ xs x d => match xs as λ ys => ys.put(k + 1, x, d).read_or(k + 1, d) = x {
            Nil => List::put_here(k, Nil, x, d),
            Cons(_, rest) => List::put_here(k, rest, x, d),
        },
    }
}

theorem List::put_other<A>(i: Nat): (xs: List<A>) → (x: A) → (d: A) → (k: Nat) → k ≠ i → xs.put(i, x, d).read_or(k, d) = xs.read_or(k, d) {
    match i {
        Zero => λ xs x d k => match k as λ k2 => k2 ≠ Zero → xs.put(Zero, x, d).read_or(k2, d) = xs.read_or(k2, d) {
            Zero => λ ne => false_elim(ne(refl)),
            Succ(k2) => λ _ => match xs as λ ys => ys.put(Zero, x, d).read_or(k2 + 1, d) = ys.read_or(k2 + 1, d) {
                Nil => refl,
                Cons(_, _) => refl,
            },
        },
        Succ(i2) => λ xs x d k => match k as λ k2 => k2 ≠ i2 + 1 → xs.put(i2 + 1, x, d).read_or(k2, d) = xs.read_or(k2, d) {
            Zero => λ _ => match xs as λ ys => ys.put(i2 + 1, x, d).read_or(Zero, d) = ys.read_or(Zero, d) { Nil => refl, Cons(_, _) => refl },
            Succ(k2) => λ ne => match xs as λ ys => ys.put(i2 + 1, x, d).read_or(k2 + 1, d) = ys.read_or(k2 + 1, d) {
                Nil => List::put_other(i2, Nil, x, d, k2, λ e => ne(cong_fn(λ (n: Nat) => n + 1, e))),
                Cons(_, rest) => List::put_other(i2, rest, x, d, k2, λ e => ne(cong_fn(λ (n: Nat) => n + 1, e))),
            },
        },
    }
}

theorem Env::number_set_here(self env: Env, id: Nat, word: BitVec(64)): env.set_word(id, word).number(id) = word.toNat() {
    List::put_here(id, env.words, word.toNat(), 0)
}

theorem Env::number_set_other(self env: Env, id: Nat, word: BitVec(64), k: Nat, ne: k ≠ id): env.set_word(id, word).number(k) = env.number(k) {
    List::put_other(id, env.words, word.toNat(), 0, k, ne)
}

theorem Env::buffer_set_here(self env: Env, b: Nat, bytes: List<BitVec(8)>): env.set_buffer(b, bytes).buffer(b) = bytes {
    List::put_here(b, env.buffers, bytes, Nil)
}

theorem Env::buffer_set_other(self env: Env, b: Nat, bytes: List<BitVec(8)>, k: Nat, ne: k ≠ b): env.set_buffer(b, bytes).buffer(k) = env.buffer(k) {
    List::put_other(b, env.buffers, bytes, Nil, k, ne)
}

// ---------------------------------------------------------------------------
// What a region leaves in the environment (`Env::compute`)

fn Port::ids(ports: List<Port>) → List<Nat> {
    match ports { Nil => Nil, Cons(p, rest) => Cons(p.id, Port::ids(rest)) }
}

theorem Port::ids_append(xs: List<Port>, ys: List<Port>): Port::ids(xs ++ ys) = Port::ids(xs) ++ Port::ids(ys) {
    match xs {
        Nil => refl,
        Cons(p, rest) => cong_fn(λ (l: List<Nat>) => Cons(p.id, l), Port::ids_append(rest, ys)),
    }
}

theorem absent_join(id: Nat, xs, ys: List<Nat>): absent(id, xs).IsTrue() → absent(id, ys).IsTrue() → absent(id, xs ++ ys).IsTrue() { by sets() }

// Settling keeps the buffers and the command line.
theorem Env::settle_buffers(after: Valuation(), ports: List<Port>): (env: Env) → env.settle(after, ports).buffers = env.buffers {
    match ports {
        Nil => λ env => refl,
        Cons(port, rest) => λ env => Env::settle_buffers(after, rest, Env(env.words.put(port.id, after(port.width, port.id).toNat(), 0), env.buffers, env.args)),
    }
}

// A word no port names keeps its number.
theorem Env::settle_other(after: Valuation(), id: Nat, ports: List<Port>): (env: Env) → absent(id, Port::ids(ports)).IsTrue() →
    env.settle(after, ports).number(id) = env.number(id) {
    match ports {
        Nil => λ env _ => refl,
        Cons(port, rest) => λ env h => {
            let parts = Bool::is_true_and(id.differs(port.id), absent(id, Port::ids(rest)), h);
            let first = Env(env.words.put(port.id, after(port.width, port.id).toNat(), 0), env.buffers, env.args);
            trans(Env::settle_other(after, id, rest, first, parts.right),
                List::put_other(port.id, env.words, after(port.width, port.id).toNat(), 0, id, id.differs_ne(port.id, parts.left)))
        },
    }
}

// The last port settled is the word it was written at.
theorem Env::settle_last(after: Valuation(), p: Port, ports: List<Port>): (env: Env) →
    env.settle(after, ports ++ [p]).number(p.id) = after(p.width, p.id).toNat() {
    match ports {
        Nil => λ env => List::put_here(p.id, env.words, after(p.width, p.id).toNat(), 0),
        Cons(port, rest) => λ env => Env::settle_last(after, p, rest, Env(env.words.put(port.id, after(port.width, port.id).toNat(), 0), env.buffers, env.args)),
    }
}

// A region with no byte node and no loop: it runs as it evaluates, and
// leaves the buffers as they were.
fn StructuredRegion::byte_free(self region: StructuredRegion) → Bool {
    match region {
        Dataflow(body) => nodes_pure(body.nodes),
        Sequence(prefix, continuation) => nodes_pure(prefix.nodes) && continuation.byte_free(),
        Compose(prefix, continuation) => prefix.byte_free() && continuation.byte_free(),
        Conditional(_, _, _, _, when_true, when_false) => when_true.byte_free() && when_false.byte_free(),
        Lend(_, _, _, _) => False,
        Call(_, _, _, _) => True,
        Loop(_, _, _, _, _, _, _, _, _) => False,
        Until(_, _, _, _, _, _) => False,
    }
}

// A node that touches no buffer steps alike over any file of buffers.
theorem Node::step_pure(self node: Node, values: Valuation(), buffers: Buffers(), pure: node.pure().IsTrue()):
    node.step(values, buffers := buffers) = node.step(values) {
    match node as λ n => n.pure().IsTrue() → n.step(values, buffers := buffers) = n.step(values) {
        Const(_, _, _) => λ _ => refl,
        Move(_, _, _) => λ _ => refl,
        Add(_, _, _, _) => λ _ => refl,
        Sub(_, _, _, _) => λ _ => refl,
        BitAnd(_, _, _, _) => λ _ => refl,
        BitOr(_, _, _, _) => λ _ => refl,
        BitXor(_, _, _, _) => λ _ => refl,
        ShiftLeft(_, _, _, _) => λ _ => refl,
        LogicalShiftRight(_, _, _, _) => λ _ => refl,
        RotateRight(_, _, _, _) => λ _ => refl,
        Apply(_, _, _, _, _) => λ _ => refl,
        ArithmeticShiftRight(_, _, _, _) => λ _ => refl,
        UnsignedLessThan(_, _, _, _) => λ _ => refl,
        SignedLessThan(_, _, _, _) => λ _ => refl,
        Equal(_, _, _, _) => λ _ => refl,
        BufferLoad(_, _, _) => λ no => false_elim(no),
        BufferStore(_, _, _, _) => λ no => false_elim(no),
        Resize(_, _, _, _) => λ _ => refl,
        SignResize(_, _, _, _) => λ _ => refl,
        TableRead(_, _, _, _, _) => λ _ => refl,
        WideLoad(_, _, _, _) => λ no => false_elim(no),
        WideStore(_, _, _, _, _) => λ no => false_elim(no),
        ByteSwap(_, _, _) => λ _ => refl,
    }(pure)
}

theorem eval_nodes_pure(nodes: List<Node>, buffers: Buffers()): nodes_pure(nodes).IsTrue() → (values: Valuation()) →
    eval_nodes_over(buffers, nodes, values) = eval_nodes(nodes, values) {
    match nodes {
        Nil => λ _ values => refl,
        Cons(node, rest) => λ pure values => {
            let parts = Bool::is_true_and(node.pure(), nodes_pure(rest), pure);
            j(sym(node.step_pure(values, buffers, parts.left)), λ v _ => eval_nodes_over(buffers, rest, v) = eval_nodes(rest, node.step(values)),
                eval_nodes_pure(rest, buffers, parts.right, node.step(values)))
        },
    }
}

// A byte-free region evaluates alike over any file of buffers: what lets
// a lowering proved over a file (`rt_lower`, whose terms may read a lent
// span) be used where the buffers are state.
theorem StructuredRegion::eval_byte_free(self region: StructuredRegion, call: Answers(), buffers: Buffers()): region.byte_free().IsTrue() →
    (values: Valuation()) → region.eval(call, values, buffers := buffers) = region.eval(call, values) {
    match region {
        Dataflow(body) => λ free values => eval_nodes_pure(body.nodes, buffers, free, values),
        Sequence(prefix, continuation) => λ free values => {
            let parts = Bool::is_true_and(nodes_pure(prefix.nodes), continuation.byte_free(), free);
            j(sym(eval_nodes_pure(prefix.nodes, buffers, parts.left, values)),
                λ v _ => continuation.eval(call, v, buffers := buffers) = continuation.eval(call, eval_nodes(prefix.nodes, values)),
                continuation.eval_byte_free(call, buffers, parts.right, eval_nodes(prefix.nodes, values)))
        },
        Compose(prefix, continuation) => λ free values => {
            let parts = Bool::is_true_and(prefix.byte_free(), continuation.byte_free(), free);
            j(sym(prefix.eval_byte_free(call, buffers, parts.left, values)),
                λ v _ => continuation.eval(call, v, buffers := buffers) = continuation.eval(call, prefix.eval(call, values)),
                continuation.eval_byte_free(call, buffers, parts.right, prefix.eval(call, values)))
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ free values => {
            let parts = Bool::is_true_and(when_true.byte_free(), when_false.byte_free(), free);
            let b = values(1, condition).head_bit();
            j(sym(when_false.eval_byte_free(call, buffers, parts.right, values)), λ f _ =>
                    (λ (w: Nat) (id: Nat) => match b { False => f(w, id), True => when_true.eval(call, values, buffers := buffers)(w, id) }) =
                    Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval(call, values),
                j(sym(when_true.eval_byte_free(call, buffers, parts.left, values)), λ t _ =>
                        (λ (w: Nat) (id: Nat) => match b { False => when_false.eval(call, values)(w, id), True => t(w, id) }) =
                        Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval(call, values),
                    refl))
        },
        Lend(_, _, _, _) => λ never => false_elim(never),
        Call(_, _, _, _) => λ _ values => refl,
        Loop(_, _, _, _, _, _, _, _, _) => λ never => false_elim(never),
        Until(_, _, _, _, _, _) => λ never => false_elim(never),
    }
}

// A byte-free region runs as it evaluates and keeps the buffers, where the
// functions it calls leave the file. Nothing is asked of a function it does
// not call, so the program may have functions that write.
theorem StructuredRegion::run_byte_free(self region: StructuredRegion, call: Writers(), among: Nat → Bool, still: Writers::Still(call, among)):
    region.byte_free().IsTrue() → region.calls_among(among).IsTrue() → (values: Valuation()) → (buffers: Buffers()) →
    region.run(call, values, buffers) = State(region.eval(Writers::words(call, buffers), values), buffers) {
    match region {
        Dataflow(body) => λ free _ values buffers => run_nodes_pure(body.nodes, free, values, buffers),
        Sequence(prefix, continuation) => λ free fits values buffers => {
            let parts = Bool::is_true_and(nodes_pure(prefix.nodes), continuation.byte_free(), free);
            j(sym(run_nodes_pure(prefix.nodes, parts.left, values, buffers)),
                λ s _ => continuation.run(call, s.values, s.buffers) = State(continuation.eval(Writers::words(call, buffers), eval_nodes(prefix.nodes, values)), buffers),
                continuation.run_byte_free(call, among, still, parts.right, fits, eval_nodes(prefix.nodes, values), buffers))
        },
        Compose(prefix, continuation) => λ free fits values buffers => {
            let parts = Bool::is_true_and(prefix.byte_free(), continuation.byte_free(), free);
            let fit = Bool::is_true_and(prefix.calls_among(among), continuation.calls_among(among), fits);
            j(sym(prefix.run_byte_free(call, among, still, parts.left, fit.left, values, buffers)),
                λ s _ => continuation.run(call, s.values, s.buffers) = State(continuation.eval(Writers::words(call, buffers), prefix.eval(Writers::words(call, buffers), values)), buffers),
                continuation.run_byte_free(call, among, still, parts.right, fit.right, prefix.eval(Writers::words(call, buffers), values), buffers))
        },
        Conditional(inputs, condition, arguments, outputs, when_true, when_false) => λ free fits values buffers => {
            let parts = Bool::is_true_and(when_true.byte_free(), when_false.byte_free(), free);
            let fit = Bool::is_true_and(when_true.calls_among(among), when_false.calls_among(among), fits);
            let b = values(1, condition).head_bit();
            let same_either: ((match b as λ _ => Buffers() { False => buffers, True => buffers }) = buffers) =
                match b { False => refl, True => refl };
            j(sym(when_false.run_byte_free(call, among, still, parts.right, fit.right, values, buffers)), λ f _ => State(λ w id => match b {
                        False => f.values(w, id),
                        True => when_true.run(call, values, buffers).values(w, id),
                    }, match b { False => f.buffers, True => when_true.run(call, values, buffers).buffers }) =
                    State(Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval(Writers::words(call, buffers), values), buffers),
                j(sym(when_true.run_byte_free(call, among, still, parts.left, fit.left, values, buffers)), λ t _ => State(λ w id => match b {
                            False => when_false.eval(Writers::words(call, buffers), values)(w, id),
                            True => t.values(w, id),
                        }, match b { False => buffers, True => t.buffers }) =
                        State(Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval(Writers::words(call, buffers), values), buffers),
                    cong_fn<Buffers(), State>(λ held => State(Conditional(inputs, condition, arguments, outputs, when_true, when_false).eval(Writers::words(call, buffers), values), held),
                        same_either)))
        },
        Lend(_, _, _, _) => λ never => false_elim(never),
        Call(callee, arguments, result, also) => λ _ fits values buffers => cong_fn<Buffers(), State>(
            λ held => State(Valuation::bind(values, Cons(result, also), Cons(call(buffers, callee, words_of(values, arguments)).word,
                call(buffers, callee, words_of(values, arguments)).rest)), held),
            still(buffers, callee, fits, words_of(values, arguments))),
        Loop(_, _, _, _, _, _, _, _, _) => λ never => false_elim(never),
        Until(_, _, _, _, _, _) => λ never => false_elim(never),
    }
}

theorem nodes_write_ids(nodes: List<Node>): Port::ids(nodes_write_ports(nodes)) = nodes_writes(nodes) {
    match nodes {
        Nil => refl,
        Cons(node, rest) => cong_fn(λ (l: List<Nat>) => Cons(node_output(node).id, l), nodes_write_ids(rest)),
    }
}

theorem word_port_ids(ids: List<Nat>): Port::ids(word_ports(ids)) = ids {
    match ids {
        Nil => refl,
        Cons(id, rest) => cong_fn(λ (l: List<Nat>) => Cons(id, l), word_port_ids(rest)),
    }
}

// What a run writes is among what the region names as written.
theorem StructuredRegion::written_within(self region: StructuredRegion, call: Writers()): (values: Valuation()) → (buffers: Buffers()) →
    (id: Nat) → absent(id, region.writes()).IsTrue() → absent(id, Port::ids(region.written(call, values, buffers))).IsTrue() {
    match region {
        Dataflow(body) => λ values buffers id h => j(sym(nodes_write_ids(body.nodes)), λ l _ => absent(id, l).IsTrue(), h),
        Sequence(prefix, continuation) => λ values buffers id h => {
            let parts = absent_append(id, nodes_writes(prefix.nodes), continuation.writes(), h);
            let after = run_nodes(prefix.nodes, values, buffers);
            j(sym(Port::ids_append(nodes_write_ports(prefix.nodes), continuation.written(call, after.values, after.buffers))),
                λ l _ => absent(id, l).IsTrue(),
                absent_join(id, Port::ids(nodes_write_ports(prefix.nodes)), Port::ids(continuation.written(call, after.values, after.buffers)),
                    j(sym(nodes_write_ids(prefix.nodes)), λ l _ => absent(id, l).IsTrue(), parts.left),
                    continuation.written_within(call, after.values, after.buffers, id, parts.right)))
        },
        Compose(prefix, continuation) => λ values buffers id h => {
            let parts = absent_append(id, prefix.writes(), continuation.writes(), h);
            let after = prefix.run(call, values, buffers);
            j(sym(Port::ids_append(prefix.written(call, values, buffers), continuation.written(call, after.values, after.buffers))),
                λ l _ => absent(id, l).IsTrue(),
                absent_join(id, Port::ids(prefix.written(call, values, buffers)), Port::ids(continuation.written(call, after.values, after.buffers)),
                    prefix.written_within(call, values, buffers, id, parts.left),
                    continuation.written_within(call, after.values, after.buffers, id, parts.right)))
        },
        Conditional(_, condition, _, _, when_true, when_false) => λ values buffers id h => {
            let parts = absent_append(id, when_true.writes(), when_false.writes(), h);
            match values(1, condition).head_bit() as λ b => absent(id, Port::ids(match b as λ _ => List<Port> {
                    False => when_false.written(call, values, buffers),
                    True => when_true.written(call, values, buffers),
                })).IsTrue() {
                False => when_false.written_within(call, values, buffers, id, parts.right),
                True => when_true.written_within(call, values, buffers, id, parts.left),
            }
        },
        Lend(views, _, _, result) => λ values buffers id h => {
            let nodes = views_nodes(views);
            let parts = absent_append(id, nodes_writes(nodes), [result], h);
            j(sym(Port::ids_append(nodes_write_ports(nodes), [Port(result, 64)])), λ l _ => absent(id, l).IsTrue(),
                absent_join(id, Port::ids(nodes_write_ports(nodes)), [result],
                    j(sym(nodes_write_ids(nodes)), λ l _ => absent(id, l).IsTrue(), parts.left), parts.right))
        },
        Call(_, _, result, also) => λ values buffers id h => j(sym(word_port_ids(Cons(result, also))), λ l _ => absent(id, l).IsTrue(), h),
        Loop(_, _, _, _, _, _, _, outputs, exhausted) => λ values buffers id h => {
            let parts = Bool::is_true_and(id.differs(exhausted), absent(id, outputs), h);
            j(sym(Port::ids_append(word_ports(outputs), [Port(exhausted, 1)])), λ l _ => absent(id, l).IsTrue(),
                absent_join(id, Port::ids(word_ports(outputs)), [exhausted],
                    j(sym(word_port_ids(outputs)), λ l _ => absent(id, l).IsTrue(), parts.right),
                    Bool::is_true_and_intro(id.differs(exhausted), True, parts.left, trivial)))
        },
        Until(_, _, _, _, _, outputs) => λ values buffers id h => j(sym(word_port_ids(outputs)), λ l _ => absent(id, l).IsTrue(), h),
    }
}

// A byte-free region keeps the buffers, the functions it calls leaving the
// file.
theorem Env::compute_buffers(self env: Env, call: Writers(), among: Nat → Bool, still: Writers::Still(call, among), region: StructuredRegion,
    free: region.byte_free().IsTrue(), fits: region.calls_among(among).IsTrue()):
    env.compute(call, region).buffers = env.buffers {
    let after = region.run(call, env.valuation(), env.buffers);
    trans(Env::settle_buffers(after.values, region.written(call, env.valuation(), env.buffers), Env(env.words, after.buffers, env.args)),
        cong_fn(λ (s: State) => s.buffers, region.run_byte_free(call, among, still, free, fits, env.valuation(), env.buffers)))
}

// A word the region does not name as written keeps its number.
theorem Env::compute_other(self env: Env, call: Writers(), region: StructuredRegion, id: Nat, h: absent(id, region.writes()).IsTrue()):
    env.compute(call, region).number(id) = env.number(id) {
    let after = region.run(call, env.valuation(), env.buffers);
    Env::settle_other(after.values, id, region.written(call, env.valuation(), env.buffers), Env(env.words, after.buffers, env.args),
        region.written_within(call, env.valuation(), env.buffers, id, h))
}

// A byte-free region followed by a move to `out`: `out` holds the moved
// port's value, at the move's width.
theorem Env::compute_moved(self env: Env, call: Writers(), among: Nat → Bool, still: Writers::Still(call, among), region: StructuredRegion,
    free: region.byte_free().IsTrue(), fits: region.calls_among(among).IsTrue(), width, out, src: Nat):
    env.compute(call, Compose(region, Dataflow(Region(Ports(Nil), [Move(width, out, src)], Ports(Nil))))).number(out) =
        region.eval(Writers::words(call, env.buffers), env.valuation())(width, src).toNat() {
    let after = region.run(call, env.valuation(), env.buffers);
    let moved = Valuation::set(after.values, out, λ wd => after.values(wd, src));
    trans(Env::settle_last(moved, Port(out, width), region.written(call, env.valuation(), env.buffers), Env(env.words, after.buffers, env.args)),
        trans(cong_fn(λ (x: BitVec(width)) => x.toNat(), Valuation::set_here(after.values, out, λ wd => after.values(wd, src), width)),
            cong_fn(λ (s: State) => s.values(width, src).toNat(), region.run_byte_free(call, among, still, free, fits, env.valuation(), env.buffers))))
}

// ---------------------------------------------------------------------------
// Statements with loops: world threading in `Partial`

// A pass's flow as a step of the loop's iteration, the world threaded.
fn Stmt::pass_step(again: Nat, m: Mutated<Io, Flow>) → Partial(Mutated<Io, Step<Env, Flow>>) {
    CRet(Mutated(m.after, m.value.pass(again)))
}

// The rest of a `Then`, from where the first statement left the world, as
// world threading in `Partial`.
fn Stmt::then_run(rest: Io → Env → Partial(Mutated<Io, Flow>), m: Mutated<Io, Flow>) → Partial(Mutated<Io, Flow>) {
    match m.value {
        Onward(next) => rest(m.after, next),
        Exited(status) => CRet(Mutated(m.after, Exited(status))),
    }
}

// Every statement as world threading: a loop is `Io::iterate` of its
// pass, which may go round forever, so the meaning is in `Partial`
// (docs/language/effects-capabilities-design.md §4); a procedure call is its tree
// read against the world. A function of the environment and the world, so
// that the recursion is on the statement.
fn Stmt::run(self s: Stmt, call: Writers(), perform: PerformsCo()) → Env → Io → Partial(Mutated<Io, Flow>) {
    match s {
        Compute(region) => λ env io => CRet(Mutated(io, Onward(env.compute(call, region)))),
        Invoke(shape) => λ env io => CRet(Stmt::thread(Invoke(shape), call, env, io)),
        Then(first, rest) => λ env io => CoTree::bind(Events::none(), first.run(call, perform)(env, io),
            λ m => Stmt::then_run(λ io2 env2 => rest.run(call, perform)(env2, io2), m)),
        Branch(condition, yes, no) => λ env io => match env.bit(condition) {
            True => yes.run(call, perform)(env, io),
            False => no.run(call, perform)(env, io),
        },
        Repeat(body, again) => λ env io => Io::iterate<Env, Flow>(λ e io2 =>
            CoTree::bind(Events::none(), body.run(call, perform)(e, io2), λ m => Stmt::pass_step(again, m)), env, io),
        Exit(status) => λ env io => CRet(Mutated(io, Exited(env.word(status)))),
        Arg(index, buf, len) => λ env io => CRet(Mutated(io, Onward(env.arg(env.number(index), buf, len)))),
        Perform(procedure, args, results) => λ env io => Io::against_co(perform(procedure, args, results, env), io),
    }
}

// The theorem: every statement's tree, read against any world, is its
// threading, up to silent steps. A loop is the loop lemma (`Io::reads_iter`)
// at the pass's reading.
fn Stmt::reads_run(self s: Stmt, call: Writers(), perform: PerformsCo()) →
    (env: Env) → Io::Reads(s.denote_co(call, perform)(env), λ io => s.run(call, perform)(env, io))
{
    match s {
        Compute(region) => λ env => Io::reads_ret(Onward(env.compute(call, region))),
        Invoke(shape) => λ env io => ERet(1, 0, Stmt::thread(Invoke(shape), call, env, io), refl, refl),
        Then(first, rest) => λ env => {
            let h = λ (flow: Flow) => match flow as λ _ => CoTree<Flow>(Events::linux()) {
                Onward(next) => rest.denote_co(call, perform)(next),
                Exited(status) => CRet(Exited(status)),
            };
            let g = λ (flow: Flow) (io: Io) => Stmt::then_run(λ io2 env2 => rest.run(call, perform)(env2, io2), Mutated(io, flow));
            let rh: (flow: Flow) → Io::Reads(h(flow), g(flow)) = λ flow => match flow as λ f =>
                    Io::Reads(match f as λ _ => CoTree<Flow>(Events::linux()) {
                        Onward(next) => rest.denote_co(call, perform)(next),
                        Exited(status) => CRet(Exited(status)),
                    }, λ io => Stmt::then_run(λ io2 env2 => rest.run(call, perform)(env2, io2), Mutated(io, f))) {
                Onward(next) => rest.reads_run(call, perform, next),
                Exited(status) => Io::reads_ret(Exited(status)),
            };
            Io::reads_bind(first.denote_co(call, perform)(env), λ io => first.run(call, perform)(env, io), h, g,
                first.reads_run(call, perform, env), rh)
        },
        Branch(condition, yes, no) => λ env => match env.bit(condition) as λ b => Io::Reads(
                match b as λ _ => CoTree<Flow>(Events::linux()) {
                    True => yes.denote_co(call, perform)(env),
                    False => no.denote_co(call, perform)(env),
                },
                λ io => match b as λ _ => Partial(Mutated<Io, Flow>) { True => yes.run(call, perform)(env, io), False => no.run(call, perform)(env, io) }) {
            True => yes.reads_run(call, perform, env),
            False => no.reads_run(call, perform, env),
        },
        Repeat(body, again) => λ env => Io::reads_iter<Env, Flow>(
            λ e => CoTree::map(Events::linux(), body.denote_co(call, perform)(e), λ flow => flow.pass(again)),
            λ e io2 => CoTree::bind(Events::none(), body.run(call, perform)(e, io2), λ m => Stmt::pass_step(again, m)),
            λ e => Io::reads_bind<Flow, Step<Env, Flow>>(body.denote_co(call, perform)(e), λ io => body.run(call, perform)(e, io),
                λ flow => CRet(flow.pass(again)), λ flow io => CRet(Mutated(io, flow.pass(again))),
                body.reads_run(call, perform, e), λ flow => Io::reads_ret(flow.pass(again))),
            env),
        Exit(status) => λ env => Io::reads_ret(Exited(env.word(status))),
        Arg(index, buf, len) => λ env => Io::reads_ret(Onward(env.arg(env.number(index), buf, len))),
        Perform(procedure, args, results) => λ env io => Eutt::refl(Events::none(), Io::against_co(perform(procedure, args, results, env), io)),
    }
}

// A loop-free statement's threading in `Partial` is its plain threading,
// returned.
fn Stmt::run_straight(self s: Stmt, call: Writers(), perform: PerformsCo()) → s.straight().IsTrue() → (env: Env) → (io: Io) →
    Eutt<Mutated<Io, Flow>>(Events::none(), s.run(call, perform)(env, io), CRet(Stmt::thread(s, call, env, io)))
{
    match s {
        Compute(region) => λ _ env io => Eutt::refl(Events::none(), CRet(Mutated(io, Onward(env.compute(call, region))))),
        Invoke(shape) => λ _ env io => Eutt::refl(Events::none(), CRet(Stmt::thread(Invoke(shape), call, env, io))),
        Then(first, rest) => λ ok env io => {
            let parts = Bool::is_true_and(first.straight(), rest.straight(), ok);
            let k = λ (m: Mutated<Io, Flow>) => Stmt::then_run(λ io2 env2 => rest.run(call, perform)(env2, io2), m);
            let m1 = Stmt::thread(first, call, env, io);
            let hk: (m: Mutated<Io, Flow>) → Eutt<Mutated<Io, Flow>>(Events::none(), k(m), CRet(Stmt::then_thread(rest, call, m))) =
                λ m => match m.value as λ f => Eutt<Mutated<Io, Flow>>(Events::none(),
                        Stmt::then_run(λ io2 env2 => rest.run(call, perform)(env2, io2), Mutated(m.after, f)),
                        CRet(Stmt::then_thread(rest, call, Mutated(m.after, f)))) {
                    Onward(next) => rest.run_straight(call, perform, parts.right, next, m.after),
                    Exited(status) => Eutt::refl(Events::none(), CRet(Mutated(m.after, Exited(status)))),
                };
            Eutt::trans(Events::none(), CoTree::bind(Events::none(), first.run(call, perform)(env, io), k),
                CoTree::bind(Events::none(), CRet(m1), k), CRet(Stmt::thread(Then(first, rest), call, env, io)),
                Eutt::bind_cong_l(Events::none(), first.run(call, perform)(env, io), CRet(m1), k,
                    first.run_straight(call, perform, parts.left, env, io)),
                Eutt::trans(Events::none(), CoTree::bind(Events::none(), CRet(m1), k), k(m1), CRet(Stmt::thread(Then(first, rest), call, env, io)),
                    Eutt::bind_ret_l(Events::none(), m1, k), hk(m1)))
        },
        Branch(condition, yes, no) => λ ok env io => {
            let parts = Bool::is_true_and(yes.straight(), no.straight(), ok);
            match env.bit(condition) as λ b => Eutt<Mutated<Io, Flow>>(Events::none(),
                    match b as λ _ => Partial(Mutated<Io, Flow>) { True => yes.run(call, perform)(env, io), False => no.run(call, perform)(env, io) },
                    CRet(match b as λ _ => Mutated<Io, Flow> { True => Stmt::thread(yes, call, env, io), False => Stmt::thread(no, call, env, io) })) {
                True => yes.run_straight(call, perform, parts.left, env, io),
                False => no.run_straight(call, perform, parts.right, env, io),
            }
        },
        Repeat(_, _) => λ never => false_elim(never),
        Exit(status) => λ _ env io => Eutt::refl(Events::none(), CRet(Mutated(io, Exited(env.word(status))))),
        Arg(index, buf, len) => λ _ env io => Eutt::refl(Events::none(), CRet(Mutated(io, Onward(env.arg(env.number(index), buf, len))))),
        Perform(_, _, _) => λ never => false_elim(never),
    }
}

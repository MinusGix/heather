// cat and the tools past it (docs/native-real-programs-plan.md, rounds 1,
// 5 and 6): `tr a-z A-Z`, `yes`, `head -c N`, `wc -l`, and `echo` and
// `yes STR` over the command line, written with the builder
// (`native_build`) and lowered to sources `heather write-elf` compiles.
// `native_compile_correct` is the proof of every one, so none has a theorem
// of its own (`write-elf`'s certificate states `<s>_elf_simulates` of the
// source the tool lowers to).
import native_build;
import native_source;
import list;
import bitvec;

// ---------------------------------------------------------------------------
// cat

// `native_cat`'s cat, written with the builder. That one stays the cat the
// spec proofs speak of (`native_cat_spec`), whose tree they read.
fn cat_tool(capacity: Nat) → Tool {
    buffer(capacity, λ buf => run(each_read(stdin(), buf, λ n => write_all(stdout(), buf, n.get()))))
}

fn cat_tool_source() → Source { cat_tool(256).source() }

// ---------------------------------------------------------------------------
// tr a-z A-Z

// Each byte read raised where it is a lower-case letter, then written.
fn tr_upper(capacity: Nat) → Tool {
    buffer(capacity, λ buf => run(each_read(stdin(), buf, λ n =>
        for_count(n.get(), λ i => local(buf.at(i.get()), λ c =>
            when((c.get() - num(97)).below(num(26)), buf.put(i.get(), c.get() - num(32)))))
        ++ write_all(stdout(), buf, n.get()))))
}

fn tr_upper_source() → Source { tr_upper(256).source() }

// ---------------------------------------------------------------------------
// yes

// The line, written again and again; a failed write exits 1.
fn yes(line: List<BitVec(8)>) → Tool {
    buffer_of(line, λ buf => run(do_while(write_all(stdout(), buf, buf.size()), num(1))))
}

// Bytes by their codes.
fn ascii(codes: List<Nat>) → List<BitVec(8)> { codes.map(λ (code: Nat) => BitVec::ofNat(code)) }

// "yes, heather\n".
fn yes_line() → List<BitVec(8)> { ascii([121, 101, 115, 44, 32, 104, 101, 97, 116, 104, 101, 114, 10]) }

fn yes_source() → Source { yes(yes_line()).source() }

// ---------------------------------------------------------------------------
// head -c N

// The first `count` bytes of the input, or all of it if it is shorter.
fn head_c(count, capacity: Nat) → Tool {
    buffer(capacity, λ buf => run(local(num(count), λ left => local(num(0), λ n => do_while(
        read(stdin(), buf, left.get(), n) ++ when(n.get().negative(), exit(num(1)))
            ++ write_all(stdout(), buf, n.get()) ++ left.set(left.get() - n.get()),
        n.get().and_also(left.get()))))))
}

fn head_c10_source() → Source { head_c(10, 256).source() }

// ---------------------------------------------------------------------------
// wc -l

// The input's newlines counted, the count the exit status (Linux keeps its
// low byte).
fn wc_l(capacity: Nat) → Tool {
    buffer(capacity, λ buf => run(local(num(0), λ lines =>
        each_read(stdin(), buf, λ n => for_count(n.get(), λ i =>
            when(buf.at(i.get()).equals(num(10)), lines.set(lines.get() + num(1)))))
        ++ exit(lines.get()))))
}

fn wc_l_source() → Source { wc_l(256).source() }

// ---------------------------------------------------------------------------
// echo

// The arguments past the program's name, a space between each, then a
// newline: GNU's `echo` given no flags. An argument longer than the buffer
// exits 1 where it would be written (the copy keeps only the buffer's
// worth; issues/native-source-argv.md).
fn echo(capacity: Nat) → Tool {
    buffer(capacity, λ text => buffer_of([BitVec::ofNat(32)], λ space => buffer_of([BitVec::ofNat(10)], λ newline =>
        run(local(num(1), λ k => local(num(0), λ len =>
            arg(k.get(), text, len)
            ++ loop_while(len.get().negative().not(),
                when(num(capacity).below(len.get()), exit(num(1)))
                ++ write_all(stdout(), text, len.get())
                ++ k.set(k.get() + num(1))
                ++ arg(k.get(), text, len)
                ++ when(len.get().negative().not(), write_all(stdout(), space, num(1))))
            ++ write_all(stdout(), newline, num(1))))))))
}

fn echo_source() → Source { echo(1024).source() }

// ---------------------------------------------------------------------------
// yes STR

// The line of the arguments past the program's name, a space between each,
// or `y` if there are none, written again and again: GNU's `yes`. A line
// longer than the buffer exits 1 before anything is written; a failed write
// exits 1.
fn yes_args(capacity: Nat) → Tool {
    buffer(capacity, λ text => buffer(capacity, λ line => run(
        local(num(1), λ k => local(num(0), λ len => local(num(0), λ at =>
            arg(k.get(), text, len)
            ++ branch(len.get().negative(),
                line.put(num(0), num(121)) ++ at.set(num(1)),
                loop_while(len.get().negative().not(),
                    when(num(capacity).below(at.get() + len.get() + num(1)), exit(num(1)))
                    ++ for_count(len.get(), λ i => line.put(at.get() + i.get(), text.at(i.get())))
                    ++ at.set(at.get() + len.get())
                    ++ k.set(k.get() + num(1))
                    ++ arg(k.get(), text, len)
                    ++ when(len.get().negative().not(), line.put(at.get(), num(32)) ++ at.set(at.get() + num(1)))))
            ++ line.put(at.get(), num(10)) ++ at.set(at.get() + num(1))
            ++ do_while(write_all(stdout(), line, at.get()), num(1))))))))
}

fn yes_args_source() → Source { yes_args(1024).source() }

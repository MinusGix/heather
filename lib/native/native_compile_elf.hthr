// What `heather write-elf` states of every program it writes
// (issues/native-elf-every-program.md): a source whose compile at the I/O
// profile's data segment, with the homes it was given, is `program`, and
// whose layout fits a segment of `size` bytes, simulates its tree once
// Linux has loaded the program's bytes past a 232-byte header and started it
// at the entry with its command line on the stack (`native_compile_correct`).
// The segment's size is the program's to choose, up to `io_data_limit()`
// (issues/native-data-capacity.md): `write-elf` gives it the layout's size
// rounded up to a page. Nothing here is about one program: the certificate
// `write-elf` checks supplies the compile, the fit and the bytes' length,
// each evaluated once, and `Source::elf_file_simulates` then reads its
// theorem off the file it wrote.
//
// The process is one of `X86Profile::io(size)`: it relies on the segment
// alone. The program's stack is the segment's bytes past its layout
// (`DataRegion::own_stack`, `Source::stack_room` of them), and its entry
// code points RSP there (`Prog::saves_rsp`), so `fits` asks the segment to
// hold both. Compiled calls push their return addresses and their callers'
// saved words into it (docs/native/native-procedures-design.md §5): `main`'s
// frame; per call of `src.depth` a frame, a return address and the registers
// a callee keeps (seven words more); the room the functions' table asks; and
// a word for the return address of a call past the depth, which its callee
// refuses.
//
// Outside the proof is the system the file runs on. Everything asked of it
// is a premise, and `LinuxStart` (below) is those premises under one name:
// that Linux maps the file as `X86Memory::io_load` says below the segment's
// end, starts the process at `io_entry()`, and puts the command line at and
// above RSP as the psABI lays it out. Nothing is asked of the stack the
// system made beyond that (issues/native-target-minimal-system-assumptions.md).
// `Source::elf_file_runs` is the theorem from them.
import native_source;
import native_compile;
import native_compile_region;
import native_compile_steps;
import native_compile_correct;
import native_alloc;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_image;
import linux_x86_64_sim;
import linux_x86_64_sim_paid;
import linux_x86_64_determinism;
import linux_calls;
import linux_trees;
import itree;
import itree_trace;
import itree_deep;
import x86_64;
import x86_64_asm;
import x86_64_asm_runs;
import x86_64_byte_memory;
import x86_64_fetch;
import x86_64_fetched_code;
import bitvec;
import list;
import logic;
import nat;
import option;
import omega;

// The process Linux makes of a 232-byte header and the program's bytes,
// with a data segment of `size`, at its entry with the command line `args`
// on its stack, simulates the source run with `args`, paying for its
// silent steps (`SimPaid`).
theorem Source::elf_simulates_paid(self src: Source, size: Nat, within: size <= io_data_limit(), program: Prog, homes: Homes,
    compiled: src.compile(io_data_low(), homes) = Some(program), fits: Layout::of(io_data_low(), src.words, src.capacities(), homes).size() + src.stack_room() <= size,
    short: 232 + assemble(no_fills(), program, Nil).len() <= 65536,
    header: List<BitVec(8)>, long: header.len() = 232,
    s: MachineState<X86Memory(X86Profile::io(size))>, entry: s.rip = io_entry(),
    loaded: s.memory.LoadedFrom(size, header ++ assemble(no_fills(), program, Nil)),
    args: List<List<BitVec(8)>>, argv: ArgvAt(X86Profile::io(size).data().above(io_data_end(size)), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimPaidProgram(X86Profile::io(size).linux(), src.denote(args), s) {
    let x = X86Profile::io(size);
    let used = Layout::of(io_data_low(), src.words, src.capacities(), homes).size();
    let room = src.stack_room();
    let r = DataRegion::own_data(size, within, used, omega(fits));
    let region = DataRegion::own_stack(size, within, used, room, fits);
    let stack = region.stack();
    let data = x.data();
    let bytes = assemble(no_fills(), program, Nil);
    let start: (io_entry() = next_rip(io_entry(), 0)) = BitVec::eq_of_eq_bit(64, io_entry(), next_rip(io_entry(), 0), refl);
    let resident = j(start, λ y _ => CodeResident(x.fetch(), s.memory, bytes, y),
        s.memory.loaded_entry(size, within, header, bytes, long, short, loaded));
    let zero = s.memory.loaded_own_data(size, within, used, omega(fits), header ++ bytes, loaded);
    let ends = DataRegion::own_stack_end(size, within, used, room, fits);
    let above: ReadsKept(data.above(io_data_end(size)), s.memory, data.above(stack.low.toNat() + stack.size), s.memory) = λ a byte got => {
        let found = data.above_read(io_data_end(size), s.memory, a, byte, got);
        let high: ((stack.low.toNat() + stack.size).leb(a.toNat()) = True) = Nat::leb_true(stack.low.toNat() + stack.size, a.toNat(), Nat::le_trans(stack.low.toNat() + stack.size, io_data_end(size), a.toNat(), ends, found.left));
        j(sym(high), λ b _ => (match b { True => data.read(s.memory, a), False => None<BitVec(8)> }) = Some(byte), found.right)
    };
    native_compile_correct(src, r, homes, Nat::le_refl(used), program, compiled, io_entry(), s, trans(entry, start), resident, zero,
        stack, refl, DataRegion::own_stack_above(size, within, used, room, fits), region.canonical,
        DataRegion::own_stack_top(size, within, used, room, fits), Nat::le_refl(room), args,
        argv_at_kept(data.above(io_data_end(size)), s.memory, data.above(stack.low.toNat() + stack.size), s.memory, above, read_gpr(Rsp, s.gprs), args, argv))
}

// …so it simulates it.
theorem Source::elf_simulates(self src: Source, size: Nat, within: size <= io_data_limit(), program: Prog, homes: Homes,
    compiled: src.compile(io_data_low(), homes) = Some(program), fits: Layout::of(io_data_low(), src.words, src.capacities(), homes).size() + src.stack_room() <= size,
    short: 232 + assemble(no_fills(), program, Nil).len() <= 65536,
    header: List<BitVec(8)>, long: header.len() = 232,
    s: MachineState<X86Memory(X86Profile::io(size))>, entry: s.rip = io_entry(),
    loaded: s.memory.LoadedFrom(size, header ++ assemble(no_fills(), program, Nil)),
    args: List<List<BitVec(8)>>, argv: ArgvAt(X86Profile::io(size).data().above(io_data_end(size)), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimProgram(X86Profile::io(size).linux(), src.denote(args), s) {
    Program::sim_of_paid(X86Profile::io(size).linux(), src.denote(args), s, src.elf_simulates_paid(size, within, program, homes, compiled, fits, short, header, long, s, entry, loaded, args, argv))
}

// …and every run of it, with answers Linux may give, is exactly a run of
// the source: the events of a whole trace the source produces with `args`.
// Its loops' silent steps are paid for, and at fuel `n` its cuts lie `n`
// deep (`Source::deepens`), so no run reaches one
// (`Program::paid_run_produces`).
theorem Source::elf_runs_exact(self src: Source, size: Nat, within: size <= io_data_limit(), program: Prog, homes: Homes,
    compiled: src.compile(io_data_low(), homes) = Some(program), fits: Layout::of(io_data_low(), src.words, src.capacities(), homes).size() + src.stack_room() <= size,
    short: 232 + assemble(no_fills(), program, Nil).len() <= 65536,
    header: List<BitVec(8)>, long: header.len() = 232,
    s: MachineState<X86Memory(X86Profile::io(size))>, entry: s.rip = io_entry(),
    loaded: s.memory.LoadedFrom(size, header ++ assemble(no_fills(), program, Nil)),
    args: List<List<BitVec(8)>>, argv: ArgvAt(X86Profile::io(size).data().above(io_data_end(size)), s.memory, read_gpr(Rsp, s.gprs), args),
    run: List<LinuxEvent>, ran: LinuxRun(X86Profile::io(size).linux(), run, s),
    valid: LinuxEventsValid(run)):
    Exists<Trace<BitVec(64)>(Events::linux())>(λ tr => Program::Produces(Events::linux(), src.denote(args), tr) ∧
        (Trace::Returns(Events::linux(), tr) ∧ (Trace::linux_events(tr) = run))) {
    Program::paid_run_produces(X86Profile::io(size).linux(), src.denote(args), s,
        src.elf_simulates_paid(size, within, program, homes, compiled, fits, short, header, long, s, entry, loaded, args, argv), src.deepens(args), run, ran, valid)
}

// The same, of the file `write-elf` writes: the I/O profile's ELF of the
// program's bytes with a segment of `size`, whose header is 232 bytes
// whatever their length. The header holds the file's length in sixteen bits
// (`io_elf_file`), so the file is at most 65535 bytes: at 65536 the header
// would say an empty segment, and Linux would map none of the code the
// `loaded` premise speaks of (issues/io-elf-file-length-sixteen-bits.md).
theorem Source::elf_file_simulates(self src: Source, size: Nat, within: size <= io_data_limit(), program: Prog, homes: Homes,
    compiled: src.compile(io_data_low(), homes) = Some(program), fits: Layout::of(io_data_low(), src.words, src.capacities(), homes).size() + src.stack_room() <= size,
    short: 232 + assemble(no_fills(), program, Nil).len() <= 65535,
    s: MachineState<X86Memory(X86Profile::io(size))>, entry: s.rip = io_entry(),
    loaded: s.memory.LoadedFrom(size, io_elf_file(assemble(no_fills(), program, Nil), size)),
    args: List<List<BitVec(8)>>, argv: ArgvAt(X86Profile::io(size).data().above(io_data_end(size)), s.memory, read_gpr(Rsp, s.gprs), args)):
    SimProgram(X86Profile::io(size).linux(), src.denote(args), s) {
    let length = 232 + assemble(no_fills(), program, Nil).len();
    src.elf_simulates(size, within, program, homes, compiled, fits, omega(short), io_elf_header(BitVec::ofNat(length), BitVec::ofNat(length.shr(8)), size),
        io_elf_header_length(BitVec::ofNat(length), BitVec::ofNat(length.shr(8)), size), s, entry, loaded, args, argv)
}

// ---------------------------------------------------------------------------
// What the theorem asks of the system (issues/elf-theorem-runtime-premises.md)

// A process of `file` at its first instruction, as the system must have made
// it for a theorem about the file to be about the run. Each field is an
// assumption about that system, none is proved, and together they are all
// that is assumed of it at the start; what it does afterwards is the
// simulation's own (`LinuxAnswered`, linux_x86_64_io: each call answered as
// `LinuxCmd::Answers` allows, RCX, R11 and the flags not kept).
//
// - `loaded`: the file's two PT_LOAD headers were honoured: its bytes at
//   0x400000, readable and executable, and `size` zero bytes at 0x410000,
//   readable and writable (the ELF gABI's loading rule; a fixed-address
//   executable, so nothing else may hold those addresses). The program's
//   stack is part of those `size` bytes (`Source::stack_room` of them,
//   `DataRegion::own_stack`), so this is also all that is asked for the stack.
// - `entry`: RIP is the header's `e_entry`.
// - `argv`: argc, the argument pointers, a null word and the strings are at
//   and above RSP, past the segment, as the x86-64 psABI's process start
//   lays them out. This is the one use of the stack the system made.
//
// Not asked: that the system's stack has any room below RSP, is mapped any
// deeper, grows, or has any limit (RLIMIT_STACK may be anything); any
// register but RIP and RSP; any flag; envp and auxv. Not modelled: a signal
// (a process killed by SIGPIPE ends its run without an exit).
record LinuxStart(size: Nat, file: List<BitVec(8)>, args: List<List<BitVec(8)>>, s: MachineState<X86Memory(X86Profile::io(size))>) {
    loaded: s.memory.LoadedFrom(size, file),
    entry: s.rip = io_entry(),
    argv: ArgvAt(X86Profile::io(size).data().above(io_data_end(size)), s.memory, read_gpr(Rsp, s.gprs), args),
}

// The theorem of the file `write-elf` writes, from what it asks of the
// system: a process the system started as `LinuxStart` says simulates the
// source run with its command line.
theorem Source::elf_file_runs(self src: Source, size: Nat, within: size <= io_data_limit(), program: Prog, homes: Homes,
    compiled: src.compile(io_data_low(), homes) = Some(program),
    fits: Layout::of(io_data_low(), src.words, src.capacities(), homes).size() + src.stack_room() <= size,
    short: 232 + assemble(no_fills(), program, Nil).len() <= 65535,
    args: List<List<BitVec(8)>>, s: MachineState<X86Memory(X86Profile::io(size))>,
    start: LinuxStart(size, io_elf_file(assemble(no_fills(), program, Nil), size), args, s)):
    SimProgram(X86Profile::io(size).linux(), src.denote(args), s) {
    src.elf_file_simulates(size, within, program, homes, compiled, fits, short, s, start.entry, start.loaded, args, start.argv)
}

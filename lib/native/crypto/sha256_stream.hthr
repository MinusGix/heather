// SHA-256 over a message that arrives in parts, as compiled code
// (issues/sha2-compress-native.md, stage C2 of
// docs/native-lexer-crypto-roadmap.md): `Sha256::init`, `sha256_update` and
// `sha256_finish` over a context their caller lends, with the padding of
// FIPS 180-4 §5.1.1 done here and not by the caller.
//
// The context is a `Sha256` (`sha256_context.hthr`): what `sha256_block`
// works in, and the count of bytes taken so far, most significant first.
// A block is assembled where the compression function wants it, in the
// schedule's first sixteen words, so a part that ends inside a block
// leaves its bytes there for the next, and how many is the count's low six
// bits. After `sha256_finish` the hash value's thirty-two bytes are the
// digest. Each field is reached by the offset its declaration publishes.
//
// A byte at a time: each is stored under the context's length and the
// block is run when the sixty-fourth lands. That is the simplest loop that
// is right at every split of a message, and a copy of whole blocks is an
// optimization for a compiler that has one.
//
// Not proved here, as in `sha256_block`: that what these compute is
// `Sha2::digest`. The tests are where they are linked
// (crates/linked/tests/sha256.rs).
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;
import runtime;
import runtime_file;
import sha2;
import sha256_round;
import sha256_block;
import sha256_schedule;
import sha256_working;
import sha256_compression;
import sha256_filling;
import sha256_padding;
import stored_words;
import vector;
import bitvec_bytes;
import list_window;
import layout;
import stored;
import part;
import laid;
import sha256_context;
import rt_file_reflect;
import stored_accessor;
import rt_held;
import rt_held_fields;
import rt_held_reflect;

// The count of bytes taken, from its eight bytes.
runtime fn sha256_count(ctx: List<u8>, cn: u64) → u64 { ctx.u64_be_within(cn, Sha256::count_at) }

runtime fn List::sha256_put_count(mut self ctx: List<u8>, cn, count: u64) → u64 { ctx.put_u64_be_within(cn, Sha256::count_at, count) }

// The initial hash value (§5.3.3) and a count of zero: a function of the
// context, compiled over the span that holds it. Its code is eight stores
// of a word and one of the count, each where the declaration lays the
// field, and it is exported as `sha256_init`.
runtime fn Sha256::init(mut self s: Sha256) → u64 {
    s.hash := [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    s.count := 0;
    0
}

// What the compiled code leaves: where the span held a context, it holds
// that context with the initial hash value and no bytes taken. The
// generator's theorem, nothing here by hand.
theorem Sha256::init_holds(span: List<u8>, s: Sha256, length: u64, holds: Sha256::stored().Holds(span, length, s)):
    Sha256::stored().Holds(Sha256::init::bytes(span, length).after, length,
        s with { hash = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19], count = 0 }) {
    Sha256::init::runs_held(span, s, length, holds).holds
}

// The message's bytes from `j`, each pushed into the context's block
// (`Sha256::push`, run on the span).
runtime fn List::sha256_absorb(mut self ctx: List<u8>, cn: u64, message: List<u8>, mn, j, fill: u64) → u64
    decreases (mn - j).toNat() {
    if h: j < mn {
        let pushed = Sha256::push::bytes(ctx, cn, fill, message.byte_within(mn, j).zero_extend(56));
        ctx := pushed.after;
        ctx.sha256_absorb(cn, message, mn, j + 1, pushed.value)
    } else {
        fill
    }
}

// A part of the message taken into a context that has `count` bytes
// already. The count is a parameter because it is read before the stores
// and used after them, and a span that is written is read as it is where
// the read is used (issues/rt-file-read-before-store.md).
runtime fn List::sha256_take(mut self ctx: List<u8>, cn: u64, message: List<u8>, mn, count: u64) → u64 {
    ctx.sha256_absorb(cn, message, mn, 0, count & 63);
    ctx.sha256_put_count(cn, count + mn)
}

// One more part of the message.
runtime fn sha256_update(ctx: List<u8>, cn: u64, message: List<u8>, mn: u64) → Mutated<List<u8>, u64> {
    let mut ctx = ctx;
    let count = ctx.sha256_take(cn, message, mn, sha256_count(ctx, cn));
    Mutated(ctx, count)
}

// The message has ended (`Sha256::close`, run on the span). The digest is
// then the hash value's thirty-two bytes. The count is read here, before
// any store.
runtime fn sha256_finish(ctx: List<u8>, cn: u64) → Mutated<List<u8>, u64> {
    let closed = Sha256::close::bytes(ctx, cn, sha256_count(ctx, cn));
    Mutated(closed.after, closed.value)
}

// The block's sixty-four bytes into the context's block.
runtime fn List::sha256_take_block(mut self ctx: List<u8>, cn: u64, block: List<u8>, bn, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        let put = Sha256::put::bytes(ctx, cn, i, block.byte_within(bn, i).zero_extend(56));
        ctx := put.after;
        ctx.sha256_take_block(cn, block, bn, i + 1)
    } else {
        i
    }
}

// §6.2.2: H(i) from H(i−1) and a block. Of the context the hash value is
// read, and it, the working variables and the schedule are written. What
// the hash value's thirty-two bytes spell after the last block is the
// digest.
runtime fn sha256_compress(ctx: List<u8>, cn: u64, block: List<u8>, bn: u64) → Mutated<List<u8>, u64> {
    let mut ctx = ctx;
    ctx.sha256_take_block(cn, block, bn, 0);
    let ran = Sha256::run::bytes(ctx, cn);
    Mutated(ran.after, ran.value)
}

// The stream's own accessors are the record's: the count `sha256_update`
// and `sha256_finish` read is the context's, and the one they store is
// the context with its count replaced.
theorem Sha256::count_is(ctx: List<u8>, cn: u64, inside: SHA256_CONTEXT_BYTES <= cn.toNat()): sha256_count(ctx, cn) = Sha256::of(ctx).count {
    Sha256::count_read(ctx, cn, inside)
}

theorem Sha256::put_count_is(ctx: List<u8>, cn, count: u64, inside: SHA256_CONTEXT_BYTES <= cn.toNat(), own: cn.toNat() <= ctx.len()):
    Sha256::of(List::sha256_put_count(ctx, cn, count).after) = (Sha256::of(ctx) with { count = count }) {
    Sha256::count_put(ctx, cn, count, inside, own)
}

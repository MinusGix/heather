// The block's sixty-four bytes into the context's block.
runtime fn Sha256::take_block(mut self s: Sha256, block: List<u8>, bn, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        s.put(i, block.byte_within(bn, i).zero_extend(56));
        s.take_block(block, bn, i + 1)
    } else {
        i
    }
}

// §6.2.2: H(i) from H(i−1) and a block. Of the context the hash value is
// read, and it, the working variables and the schedule are written. What
// the hash value's thirty-two bytes spell after the last block is the
// digest.
runtime fn Sha256::compress(mut self s: Sha256, block: List<u8>, bn: u64) → u64 {
    s.take_block(block, bn, 0);
    s.run()
}

theorem Sha256::compress_holds(span: List<u8>, s: Sha256, length: u64, block: List<u8>, bn: u64, holds: Sha256::stored().Holds(span, length, s)):
    Sha256::stored().Holds(Sha256::compress::bytes(span, length, block, bn).after, length, Sha256::compress(s, block, bn).after) {
    Sha256::compress::runs_held(span, s, length, block, bn, holds).holds
}

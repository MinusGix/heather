// The linked SHA-256 compression is the specification's (FIPS 180-4 §6.2.2):
// `Sha256::run_spec`, that the hash value `Sha256::run`
// (`sha256_compression.hthr`) leaves is `Sha2::compress` (`sha2.hthr`) of
// the hash value it found and the block the schedule's first sixteen words
// are. With `Sha256::run::runs_held`, the generator's, the code the linker
// places computes the specification's compression where its span holds a
// context.
//
// Each loop of the methods is a function by `decreases` on a word counter.
// Its two unfoldings (`*_step`, `*_done`) and `BitVec::counts_up`
// (`bitvec_loop.hthr`) give it in closed form (`*_all`): the short loops
// as the vector they leave, the rounds as `Sha2::run` over the schedule's
// words, the schedule's loop as `Sha2::schedule` of its first sixteen.
// The word functions' agreement is `sha256_round.hthr`'s.
//
// The stream (`sha256_stream.hthr`) against `Sha2::digest` is not here yet.
import logic;
import bool;
import nat;
import list;
import list_window;
import option;
import bitvec;
import bitvec_nat;
import bitvec_loop;
import bitvec_omega;
import omega;
import vector;
import sha2;
import stored_words;
import layout;
import stored;
import part;
import laid;
import rt_held;
import sha256_context;
import sha256_round;
import sha256_block;
import sha256_schedule;
import sha256_working;
import sha256_compression;

// ---------------------------------------------------------------------------
// Each loop's two unfoldings, and the short loops in closed form

theorem Sha256::begin_done(s: Sha256, i: u64, past: 8 <= i.toNat()): Sha256::begin(s, i) = Mutated(s, i) {
    let e: (i.unsigned_lt_bit(8) = False) = bv_omega;
    let next = Sha256::begin((s with { working = vector_update(s.working, i.toNat(), vector_get(s.hash, i.toNat(), 0)) }), i + 1);
    trans(Sha256::begin_unfold(s, i), Bool::convoy_false(i.unsigned_lt_bit(8), next, Mutated(s, i), e))
}

theorem Sha256::begin_step(s: Sha256, i: u64, below: i.toNat() < 8):
    Sha256::begin(s, i) = Sha256::begin((s with { working = vector_update(s.working, i.toNat(), vector_get(s.hash, i.toNat(), 0)) }), i + 1) {
    let e: (i.unsigned_lt_bit(8) = True) = bv_omega;
    let next = Sha256::begin((s with { working = vector_update(s.working, i.toNat(), vector_get(s.hash, i.toNat(), 0)) }), i + 1);
    trans(Sha256::begin_unfold(s, i), Bool::convoy_true(i.unsigned_lt_bit(8), next, Mutated(s, i), e))
}

fn Sha256::began(s: Sha256, i: u64) → Sha256 { (s with { working = vector_update(s.working, i.toNat(), vector_get(s.hash, i.toNat(), 0)) }) }

theorem Sha256::begin_all(s: Sha256): Sha256::begin(s, 0) = Mutated((s with { working = s.hash }), 8) {
    BitVec::counts_up(λ (s: Sha256) (i: u64) => Sha256::begin(s, i), λ (s: Sha256) (i: u64) => Sha256::began(s, i), 8,
        λ s i below => Sha256::begin_step(s, i, below), λ s i past => Sha256::begin_done(s, i, past), 8, s, 0, refl)
}

theorem Sha256::shift_done(s: Sha256, i: u64, past: 7 <= i.toNat()): Sha256::shift(s, i) = Mutated(s, i) {
    let e: (i.unsigned_lt_bit(7) = False) = bv_omega;
    trans(Sha256::shift_unfold(s, i), Bool::convoy_false(i.unsigned_lt_bit(7),
        Sha256::shift((s with { working = vector_update(s.working, (7 - i).toNat(), vector_get(s.working, (6 - i).toNat(), 0)) }), i + 1), Mutated(s, i), e))
}

theorem Sha256::shift_step(s: Sha256, i: u64, below: i.toNat() < 7):
    Sha256::shift(s, i) = Sha256::shift((s with { working = vector_update(s.working, (7 - i).toNat(), vector_get(s.working, (6 - i).toNat(), 0)) }), i + 1) {
    let e: (i.unsigned_lt_bit(7) = True) = bv_omega;
    trans(Sha256::shift_unfold(s, i), Bool::convoy_true(i.unsigned_lt_bit(7),
        Sha256::shift((s with { working = vector_update(s.working, (7 - i).toNat(), vector_get(s.working, (6 - i).toNat(), 0)) }), i + 1), Mutated(s, i), e))
}

fn Sha256::ended(s: Sha256, i: u64) → Sha256 { (s with { hash = vector_update(s.hash, i.toNat(), vector_get(s.hash, i.toNat(), 0) + vector_get(s.working, i.toNat(), 0)) }) }

theorem Sha256::end_done(s: Sha256, i: u64, past: 8 <= i.toNat()): Sha256::end(s, i) = Mutated(s, i) {
    let e: (i.unsigned_lt_bit(8) = False) = bv_omega;
    trans(Sha256::end_unfold(s, i), Bool::convoy_false(i.unsigned_lt_bit(8), Sha256::end(Sha256::ended(s, i), i + 1), Mutated(s, i), e))
}

theorem Sha256::end_step(s: Sha256, i: u64, below: i.toNat() < 8): Sha256::end(s, i) = Sha256::end(Sha256::ended(s, i), i + 1) {
    let e: (i.unsigned_lt_bit(8) = True) = bv_omega;
    trans(Sha256::end_unfold(s, i), Bool::convoy_true(i.unsigned_lt_bit(8), Sha256::end(Sha256::ended(s, i), i + 1), Mutated(s, i), e))
}

fn Sha256::word(s: Sha256, j: u64) → u64 { vector_get(s.schedule, j.toNat(), 0).zero_extend(32) }

fn Sha256::expanded(s: Sha256, j: u64) → Sha256 {
    (s with { schedule = vector_update(s.schedule, (j + 16).toNat(),
        sha256_next(Sha256::word(s, j + 14), Sha256::word(s, j + 9), Sha256::word(s, j + 1), Sha256::word(s, j)).truncate(32, 32)) })
}

theorem Sha256::expand_done(s: Sha256, j: u64, past: 48 <= j.toNat()): Sha256::expand(s, j) = Mutated(s, j) {
    let e: (j.unsigned_lt_bit(48) = False) = bv_omega;
    trans(Sha256::expand_unfold(s, j), Bool::convoy_false(j.unsigned_lt_bit(48), Sha256::expand(Sha256::expanded(s, j), j + 1), Mutated(s, j), e))
}

theorem Sha256::expand_step(s: Sha256, j: u64, below: j.toNat() < 48): Sha256::expand(s, j) = Sha256::expand(Sha256::expanded(s, j), j + 1) {
    let e: (j.unsigned_lt_bit(48) = True) = bv_omega;
    trans(Sha256::expand_unfold(s, j), Bool::convoy_true(j.unsigned_lt_bit(48), Sha256::expand(Sha256::expanded(s, j), j + 1), Mutated(s, j), e))
}

fn Sha256::rounded(s: Sha256, i: u64) → Sha256 {
    let first = Sha256::t1(s, i, Sha256::word(s, i));
    Sha256::turn(first.after, first.value).after
}

theorem Sha256::rounds_done(s: Sha256, i: u64, past: 64 <= i.toNat()): Sha256::rounds(s, i) = Mutated(s, i) {
    let e: (i.unsigned_lt_bit(64) = False) = bv_omega;
    trans(Sha256::rounds_unfold(s, i), Bool::convoy_false(i.unsigned_lt_bit(64), Sha256::rounds(Sha256::rounded(s, i), i + 1), Mutated(s, i), e))
}

theorem Sha256::rounds_step(s: Sha256, i: u64, below: i.toNat() < 64): Sha256::rounds(s, i) = Sha256::rounds(Sha256::rounded(s, i), i + 1) {
    let e: (i.unsigned_lt_bit(64) = True) = bv_omega;
    trans(Sha256::rounds_unfold(s, i), Bool::convoy_true(i.unsigned_lt_bit(64), Sha256::rounds(Sha256::rounded(s, i), i + 1), Mutated(s, i), e))
}

fn Sha256::shifted(s: Sha256, i: u64) → Sha256 { (s with { working = vector_update(s.working, (7 - i).toNat(), vector_get(s.working, (6 - i).toNat(), 0)) }) }

theorem Sha256::shift_all(s: Sha256): Sha256::shift(s, 0) = Mutated((s with { working = [vector_index(s.working, 0, trivial), vector_index(s.working, 0, trivial), vector_index(s.working, 1, trivial),
        vector_index(s.working, 2, trivial), vector_index(s.working, 3, trivial), vector_index(s.working, 4, trivial), vector_index(s.working, 5, trivial), vector_index(s.working, 6, trivial)] }), 7) {
    BitVec::counts_up(λ (s: Sha256) (i: u64) => Sha256::shift(s, i), λ (s: Sha256) (i: u64) => Sha256::shifted(s, i), 7,
        λ s i below => Sha256::shift_step(s, i, below), λ s i past => Sha256::shift_done(s, i, past), 7, s, 0, refl)
}

theorem Sha256::end_all(s: Sha256): Sha256::end(s, 0) = Mutated((s with { hash = [
        vector_index(s.hash, 0, trivial) + vector_index(s.working, 0, trivial), vector_index(s.hash, 1, trivial) + vector_index(s.working, 1, trivial),
        vector_index(s.hash, 2, trivial) + vector_index(s.working, 2, trivial), vector_index(s.hash, 3, trivial) + vector_index(s.working, 3, trivial),
        vector_index(s.hash, 4, trivial) + vector_index(s.working, 4, trivial), vector_index(s.hash, 5, trivial) + vector_index(s.working, 5, trivial),
        vector_index(s.hash, 6, trivial) + vector_index(s.working, 6, trivial), vector_index(s.hash, 7, trivial) + vector_index(s.working, 7, trivial)] }), 8) {
    BitVec::counts_up(λ (s: Sha256) (i: u64) => Sha256::end(s, i), λ (s: Sha256) (i: u64) => Sha256::ended(s, i), 8,
        λ s i below => Sha256::end_step(s, i, below), λ s i past => Sha256::end_done(s, i, past), 8, s, 0, refl)
}

fn Sha256::state(v: [u32; 8]) → Sha2State(32) {
    Sha2State(vector_index(v, 0, trivial), vector_index(v, 1, trivial), vector_index(v, 2, trivial), vector_index(v, 3, trivial),
        vector_index(v, 4, trivial), vector_index(v, 5, trivial), vector_index(v, 6, trivial), vector_index(v, 7, trivial))
}

fn Sha256::eight(a, b, c, d, e, f, g, h: u32) → [u32; 8] { [a, b, c, d, e, f, g, h] }

fn Sha256::vector(st: Sha2State(32)) → [u32; 8] { [st.a, st.b, st.c, st.d, st.e, st.f, st.g, st.h] }

theorem Sha256::vector_state(v: [u32; 8]): Sha256::vector(Sha256::state(v)) = v { refl }
theorem Sha256::state_vector(st: Sha2State(32)): Sha256::state(Sha256::vector(st)) = st { refl }

theorem Sha256::set_is(s: Sha256, first, fifth: u64):
    Sha256::set(s, first, fifth) = Mutated((s with { working = [first.truncate(32, 32), vector_index(s.working, 0, trivial), vector_index(s.working, 1, trivial), vector_index(s.working, 2, trivial),
        fifth.truncate(32, 32), vector_index(s.working, 4, trivial), vector_index(s.working, 5, trivial), vector_index(s.working, 6, trivial)] }), fifth) {
    cong_fn(λ (m: Mutated<Sha256, u64>) => Mutated((m.after with { working = vector_update(vector_update(m.after.working, 0, first.truncate(32, 32)), 4, fifth.truncate(32, 32)) }), fifth), Sha256::shift_all(s))
}

theorem Sha256::rounded_is(s: Sha256, i: u64, k: u32, constant: sha256_k(i) = sha256_wide(k)):
    Sha256::rounded(s, i) = (s with { working = Sha256::vector(Sha2::sha256().round(Sha256::state(s.working), k, vector_get(s.schedule, i.toNat(), 0))) }) {
    let st = Sha256::state(s.working);
    let w = vector_get(s.schedule, i.toNat(), 0);
    let t1 = sha256_t1(sha256_wide(st.h), sha256_wide(st.e), sha256_wide(st.f), sha256_wide(st.g), sha256_k(i), sha256_wide(w));
    let t2 = sha256_t2(sha256_wide(st.a), sha256_wide(st.b), sha256_wide(st.c));
    let ran: (Sha256::rounded(s, i) = (s with { working = [(t1 + t2).truncate(32, 32), st.a, st.b, st.c, (sha256_wide(st.d) + t1).truncate(32, 32), st.e, st.f, st.g] })) =
        cong_fn(λ (m: Mutated<Sha256, u64>) => m.after, Sha256::set_is(s, t1 + t2, sha256_wide(st.d) + t1));
    let x = t1.truncate(32, 32);
    let y = t2.truncate(32, 32);
    let first: ((t1 + t2).truncate(32, 32) = x + y) = BitVec::truncate_add(32, 32, t1, t2);
    let fifth: ((sha256_wide(st.d) + t1).truncate(32, 32) = st.d + x) =
        trans(BitVec::truncate_add(32, 32, sha256_wide(st.d), t1), cong_fn(λ (v: u32) => v + x, sha256_wide_low(st.d)));
    let turned: ([(t1 + t2).truncate(32, 32), st.a, st.b, st.c, (sha256_wide(st.d) + t1).truncate(32, 32), st.e, st.f, st.g] = Sha256::vector(st.turn(x, y))) =
        trans(cong_fn(λ (p: u32) => Sha256::eight(p, st.a, st.b, st.c, (sha256_wide(st.d) + t1).truncate(32, 32), st.e, st.f, st.g), first),
            cong_fn(λ (q: u32) => Sha256::eight(x + y, st.a, st.b, st.c, q, st.e, st.f, st.g), fifth));
    let at_k: (st.turn(x, y) = Sha2::sha256().round(st, k, w)) =
        trans(cong_fn(λ (kk: u64) => st.turn(sha256_t1(sha256_wide(st.h), sha256_wide(st.e), sha256_wide(st.f), sha256_wide(st.g), kk, sha256_wide(w)).truncate(32, 32), y), constant),
            sym(sha256_round_spec(st, k, w)));
    trans(ran, cong_fn(λ (v: [u32; 8]) => (s with { working = v }), trans(turned, cong_fn(λ (r: Sha2State(32)) => Sha256::vector(r), at_k))))
}

// The round constants: the halving agrees with the specification's table.
fn Sha256::constants_from(ks: List<Nat>, t: Nat) → Bool {
    match ks {
        Nil => True,
        Cons(k, rest) => sha256_k(BitVec::ofNat(t)).eq_bit(sha256_wide(BitVec::ofNat(k))) && Sha256::constants_from(rest, t + 1),
    }
}

theorem Sha256::constants_checked(): Sha256::constants_from(Sha2::k256(), 0) = True { refl }

theorem Sha256::constants_at(ks: List<Nat>): (t: Nat) → Sha256::constants_from(ks, t) = True → (j, at: Nat) → j < ks.len() → at = t + j →
    sha256_k(BitVec::ofNat(at)) = sha256_wide(BitVec::ofNat(ks.nth(j).unwrap_or(0))) {
    match ks {
        Nil => λ t ok j at inside place => { let no: False = omega; match no {} },
        Cons(k, rest) => λ t ok j at inside place => {
            let parts = Bool::and_true_parts(sha256_k(BitVec::ofNat(t)).eq_bit(sha256_wide(BitVec::ofNat(k))), Sha256::constants_from(rest, t + 1), ok);
            match j {
                Zero => {
                    let here: (at = t) = omega;
                    rewrite(here, BitVec::eq_of_eq_bit(64, sha256_k(BitVec::ofNat(t)), sha256_wide(BitVec::ofNat(k)), parts.left))
                },
                Succ(i) => Sha256::constants_at(rest, t + 1, parts.right, i, at, omega, omega),
            }
        },
    }
}

theorem Sha256::constant(i: u64, below: i.toNat() < 64): sha256_k(i) = sha256_wide(Sha2::sha256().word(Sha2::sha256().k, i.toNat())) {
    let at = Sha256::constants_at(Sha2::k256(), 0, Sha256::constants_checked(), i.toNat(), i.toNat(), below, omega);
    j(BitVec::ofNat_toNat(64, i), λ x _ => sha256_k(x) = sha256_wide(Sha2::sha256().word(Sha2::sha256().k, i.toNat())), at)
}

theorem Sha256::schedule_word(v: [u32; 64], i: Nat, below: i < 64): Sha2::sha256().window_word(vector_entries(v), i) = vector_get(v, i, 0) {
    trans(cong_fn(λ (o: Option<u32>) => o.unwrap_or(BitVec::zero()), vector_entries_nth(64, v, i, below)), sym(vector_get_inside(64, v, i, 0, below)))
}

// The rounds from `i` on are the specification's, over the schedule's words.
theorem Sha256::rounds_from(n: Nat): (s: Sha256) → (i: u64) → i.toNat() + n = 64 →
    BitVec::iterate_up(λ (s: Sha256) (i: u64) => Sha256::rounded(s, i), s, i, n) =
        (s with { working = Sha256::vector(Sha2::sha256().run(vector_entries(s.schedule), i.toNat(), n, Sha256::state(s.working))) }) {
    match n {
        Zero => λ s i e => refl,
        Succ(m, ih) => λ s i e => {
            let E = vector_entries(s.schedule);
            let st = Sha256::state(s.working);
            let k: u32 = Sha2::sha256().word(Sha2::sha256().k, i.toNat());
            let w = vector_get(s.schedule, i.toNat(), 0);
            let next: ((i + 1).toNat() = i.toNat() + 1) = bv_omega;
            let one = Sha256::rounded_is(s, i, k, Sha256::constant(i, omega));
            let after = (s with { working = Sha256::vector(Sha2::sha256().round(st, k, w)) });
            let moved = cong_fn(λ (x: Sha256) => BitVec::iterate_up(λ (s: Sha256) (i: u64) => Sha256::rounded(s, i), x, i + 1, m), one);
            let rest = ih(after, i + 1, omega);
            let place = cong_fn(λ (a: Nat) => (s with { working = Sha256::vector(Sha2::sha256().run(E, a, m, Sha2::sha256().round(st, k, w))) }), next);
            let word = cong_fn(λ (b: u32) => (s with { working = Sha256::vector(Sha2::sha256().run(E, i.toNat() + 1, m, Sha2::sha256().round(st, k, b))) }),
                sym(Sha256::schedule_word(s.schedule, i.toNat(), omega)));
            let back = cong_fn(λ (r: Sha2State(32)) => (s with { working = Sha256::vector(r) }), sym(Sha2::sha256().run_shift(E, m, st, i.toNat())));
            trans(moved, trans(rest, trans(place, trans(word, back))))
        },
    }
}

// The window `W` (newest first) is the schedule's first `16 + j` words.
record Sha256Window(v: [u32; 64], W: List<u32>, j: Nat) {
    length: W.len() = 16 + j,
    at: (b, t: Nat) → b + t = 15 + j → W.nth(b) = Some(vector_get(v, t, 0)),
}

theorem Sha256Window::word(v: [u32; 64], W: List<u32>, j: Nat, held: Sha256Window(v, W, j), b, t: Nat, e: b + t = 15 + j):
    Sha2::sha256().window_word(W, b) = vector_get(v, t, 0) {
    cong_fn(λ (o: Option<u32>) => o.unwrap_or(BitVec::zero()), held.at(b, t, e))
}

theorem Sha256Window::push(v: [u32; 64], W: List<u32>, j: Nat, held: Sha256Window(v, W, j), below: j < 48, new: u32):
    Sha256Window(vector_update(v, 16 + j, new), Cons(new, W), j + 1) {
    Sha256Window(
        { let l = held.length; omega },
        λ b => match b {
            Zero => λ t e => {
                let here: (16 + j = t) = omega;
                j(here, λ x _ => Some(new) = Some(vector_get(vector_update(v, 16 + j, new), x, 0)),
                    cong_fn(λ (y: u32) => Some(y), sym(vector_get_update_same(64, v, 16 + j, new, 0, omega))))
            },
            Succ(c) => λ t e => trans(held.at(c, t, omega),
                cong_fn(λ (y: u32) => Some(y), sym(vector_get_update_other(64, v, 16 + j, t, new, 0, omega, λ same => false_elim(omega))))),
        })
}

fn Sha256::grown(v: [u32; 64], j: u64) → [u32; 64] {
    vector_update(v, (j + 16).toNat(),
        sha256_next(sha256_wide(vector_get(v, (j + 14).toNat(), 0)), sha256_wide(vector_get(v, (j + 9).toNat(), 0)),
            sha256_wide(vector_get(v, (j + 1).toNat(), 0)), sha256_wide(vector_get(v, j.toNat(), 0))).truncate(32, 32))
}

theorem Sha256::expanded_from(n: Nat): (s: Sha256) → (j: u64) →
    BitVec::iterate_up(λ (s: Sha256) (j: u64) => Sha256::expanded(s, j), s, j, n) =
        (s with { schedule = BitVec::iterate_up(λ (v: [u32; 64]) (j: u64) => Sha256::grown(v, j), s.schedule, j, n) }) {
    match n { Zero => λ s j => refl, Succ(m, ih) => λ s j => ih(Sha256::expanded(s, j), j + 1) }
}

theorem Sha256::grown_window(v: [u32; 64], W: List<u32>, j: u64, below: j.toNat() < 48, held: Sha256Window(v, W, j.toNat())):
    Sha256Window(Sha256::grown(v, j), Sha2::sha256().push(W), (j + 1).toNat()) {
    let p16: ((j + 16).toNat() = 16 + j.toNat()) = bv_omega;
    let p14: ((j + 14).toNat() = 14 + j.toNat()) = bv_omega;
    let p9: ((j + 9).toNat() = 9 + j.toNat()) = bv_omega;
    let p1: ((j + 1).toNat() = j.toNat() + 1) = bv_omega;
    let a1 = vector_get(v, (j + 14).toNat(), 0);
    let a6 = vector_get(v, (j + 9).toNat(), 0);
    let a14 = vector_get(v, (j + 1).toNat(), 0);
    let a15 = vector_get(v, j.toNat(), 0);
    let new = sha256_next(sha256_wide(a1), sha256_wide(a6), sha256_wide(a14), sha256_wide(a15)).truncate(32, 32);
    let e1: (Sha2::sha256().window_word(W, 1) = a1) = Sha256Window::word(v, W, j.toNat(), held, 1, (j + 14).toNat(), omega);
    let e6: (Sha2::sha256().window_word(W, 6) = a6) = Sha256Window::word(v, W, j.toNat(), held, 6, (j + 9).toNat(), omega);
    let e14: (Sha2::sha256().window_word(W, 14) = a14) = Sha256Window::word(v, W, j.toNat(), held, 14, (j + 1).toNat(), omega);
    let e15: (Sha2::sha256().window_word(W, 15) = a15) = Sha256Window::word(v, W, j.toNat(), held, 15, j.toNat(), omega);
    let word: (Sha2::sha256().next_word(W) = new) =
        trans(sha256_next_at(W),
            trans(cong_fn(λ (x: u32) => sha256_next(sha256_wide(x), sha256_wide(Sha2::sha256().window_word(W, 6)), sha256_wide(Sha2::sha256().window_word(W, 14)), sha256_wide(Sha2::sha256().window_word(W, 15))).truncate(32, 32), e1),
            trans(cong_fn(λ (x: u32) => sha256_next(sha256_wide(a1), sha256_wide(x), sha256_wide(Sha2::sha256().window_word(W, 14)), sha256_wide(Sha2::sha256().window_word(W, 15))).truncate(32, 32), e6),
            trans(cong_fn(λ (x: u32) => sha256_next(sha256_wide(a1), sha256_wide(a6), sha256_wide(x), sha256_wide(Sha2::sha256().window_word(W, 15))).truncate(32, 32), e14),
                cong_fn(λ (x: u32) => sha256_next(sha256_wide(a1), sha256_wide(a6), sha256_wide(a14), sha256_wide(x)).truncate(32, 32), e15)))));
    let pushed = Sha256Window::push(v, W, j.toNat(), held, below, new);
    j(sym(p16), λ x _ => Sha256Window(vector_update(v, x, new), Sha2::sha256().push(W), (j + 1).toNat()),
        j(sym(p1), λ y _ => Sha256Window(vector_update(v, 16 + j.toNat(), new), Sha2::sha256().push(W), y),
            j(sym(word), λ z _ => Sha256Window(vector_update(v, 16 + j.toNat(), new), Cons(z, W), j.toNat() + 1), pushed)))
}

theorem Sha256::grown_from(n: Nat): (v: [u32; 64]) → (j: u64) → (W: List<u32>) → j.toNat() + n = 48 → Sha256Window(v, W, j.toNat()) →
    Sha256Window(BitVec::iterate_up(λ (v: [u32; 64]) (j: u64) => Sha256::grown(v, j), v, j, n), Sha2::sha256().extend(n, W), 48) {
    match n {
        Zero => λ v j W e held => { let at: (j.toNat() = 48) = omega; j(at, λ x _ => Sha256Window(v, W, x), held) },
        Succ(m, ih) => λ v j W e held => {
            let next: ((j + 1).toNat() = j.toNat() + 1) = bv_omega;
            let rest = ih(Sha256::grown(v, j), j + 1, Sha2::sha256().push(W), omega, Sha256::grown_window(v, W, j, omega, held));
            j(sym(Sha2::sha256().extend_shift(m, W)), λ x _ => Sha256Window(BitVec::iterate_up(λ (v: [u32; 64]) (j: u64) => Sha256::grown(v, j), Sha256::grown(v, j), j + 1, m), x, 48), rest)
        },
    }
}

theorem Sha256Window::whole(v: [u32; 64], W: List<u32>, held: Sha256Window(v, W, 48)): vector_entries(v) = W.rev() {
    sym(W.rev().ext_nth(vector_entries(v), trans(W.rev_len(), trans(held.length, sym(vector_entries_len(64, v)))), λ k below => {
        let l = held.length;
        let r = W.rev_len();
        let inside: (k < 64) = omega;
        trans(W.nth_rev(k, 63 - k, omega), trans(held.at(63 - k, k, omega),
            sym(trans(vector_entries_nth(64, v, k, inside), cong_fn(λ (y: u32) => Some(y), sym(vector_get_inside(64, v, k, 0, inside)))))))
    }))
}

theorem Sha256Window::start(v: [u32; 64]): Sha256Window(v, vector_entries(v).take(16).rev(), 0) {
    let B = vector_entries(v).take(16);
    let len: (B.len() = 16) = vector_entries(v).len_take(16, j(sym(vector_entries_len(64, v)), λ x _ => 16 <= x, trivial));
    Sha256Window(trans(B.rev_len(), len), λ b t e => {
        let inside: (t < 64) = omega;
        trans(B.nth_rev(b, t, omega), trans(vector_entries(v).nth_take(16, t, omega),
            trans(vector_entries_nth(64, v, t, inside), cong_fn(λ (y: u32) => Some(y), sym(vector_get_inside(64, v, t, 0, inside))))))
    })
}

fn Sha256::scheduled(v: [u32; 64]) → [u32; 64] { BitVec::iterate_up(λ (v: [u32; 64]) (j: u64) => Sha256::grown(v, j), v, 0, 48) }

// The schedule the loop leaves is the specification's, of the block the first sixteen words are.
theorem Sha256::scheduled_is(v: [u32; 64]): vector_entries(Sha256::scheduled(v)) = Sha2::sha256().schedule(vector_entries(v).take(16)) {
    Sha256Window::whole(Sha256::scheduled(v), Sha2::sha256().extend(48, vector_entries(v).take(16).rev()),
        Sha256::grown_from(48, v, 0, vector_entries(v).take(16).rev(), refl, Sha256Window::start(v)))
}

theorem Sha256::expand_all(s: Sha256): Sha256::expand(s, 0) = Mutated((s with { schedule = Sha256::scheduled(s.schedule) }), 48) {
    trans(BitVec::counts_up(λ (s: Sha256) (j: u64) => Sha256::expand(s, j), λ (s: Sha256) (j: u64) => Sha256::expanded(s, j), 48,
            λ s j below => Sha256::expand_step(s, j, below), λ s j past => Sha256::expand_done(s, j, past), 48, s, 0, refl),
        cong_fn(λ (t: Sha256) => { let at: u64 = 48; Mutated(t, at) }, Sha256::expanded_from(48, s, 0)))
}

theorem Sha256::rounds_all(s: Sha256): Sha256::rounds(s, 0) =
    Mutated((s with { working = Sha256::vector(Sha2::sha256().run(vector_entries(s.schedule), 0, 64, Sha256::state(s.working))) }), 64) {
    trans(BitVec::counts_up(λ (s: Sha256) (i: u64) => Sha256::rounds(s, i), λ (s: Sha256) (i: u64) => Sha256::rounded(s, i), 64,
            λ s i below => Sha256::rounds_step(s, i, below), λ s i past => Sha256::rounds_done(s, i, past), 64, s, 0, refl),
        cong_fn(λ (t: Sha256) => { let at: u64 = 64; Mutated(t, at) }, Sha256::rounds_from(64, s, 0, refl)))
}

theorem Sha256::run_is(s: Sha256): Sha256::run(s) = Sha256::end(Sha256::rounds(Sha256::begin(Sha256::expand(s, 0).after, 0).after, 0).after, 0) { refl }

// The linked compression is the specification's: the hash value `Sha256::run`
// leaves is `Sha2::compress` of the hash value it found and the block the
// schedule's first sixteen words are.
theorem Sha256::run_spec(s: Sha256):
    Sha256::state(Sha256::run(s).after.hash) = Sha2::sha256().compress(Sha256::state(s.hash), vector_entries(s.schedule).take(16)) {
    let V = Sha256::scheduled(s.schedule);
    let H = Sha256::state(s.hash);
    let s1 = (s with { schedule = V });
    let s2 = (s1 with { working = s.hash });
    let R = Sha2::sha256().run(vector_entries(V), 0, 64, H);
    let s3 = (s2 with { working = Sha256::vector(R) });
    let one: (Sha256::run(s) = Sha256::end(Sha256::rounds(Sha256::begin(s1, 0).after, 0).after, 0)) =
        trans(Sha256::run_is(s), cong_fn(λ (m: Mutated<Sha256, u64>) => Sha256::end(Sha256::rounds(Sha256::begin(m.after, 0).after, 0).after, 0), Sha256::expand_all(s)));
    let two: (Sha256::end(Sha256::rounds(Sha256::begin(s1, 0).after, 0).after, 0) = Sha256::end(Sha256::rounds(s2, 0).after, 0)) =
        cong_fn(λ (m: Mutated<Sha256, u64>) => Sha256::end(Sha256::rounds(m.after, 0).after, 0), Sha256::begin_all(s1));
    let three: (Sha256::end(Sha256::rounds(s2, 0).after, 0) = Sha256::end(s3, 0)) =
        cong_fn(λ (m: Mutated<Sha256, u64>) => Sha256::end(m.after, 0), Sha256::rounds_all(s2));
    let ran: (Sha256::state(Sha256::run(s).after.hash) = H.plus(R)) =
        cong_fn(λ (m: Mutated<Sha256, u64>) => Sha256::state(m.after.hash), trans(one, trans(two, trans(three, Sha256::end_all(s3)))));
    trans(ran, cong_fn(λ (E: List<u32>) => H.plus(Sha2::sha256().run(E, 0, 64, H)), Sha256::scheduled_is(s.schedule)))
}

// What the linked code does, in the specification's words: where the span
// holds a context, it is left holding one whose hash value is the
// specification's compression of the one it held.
theorem Sha256::run_compresses(own: List<u8>, s: Sha256, length: u64, holds: Sha256::stored().Holds(own, length, s)):
    And<Sha256::stored().Holds(Sha256::run::bytes(own, length).after, length, Sha256::run(s).after),
        Sha256::state(Sha256::run(s).after.hash) = Sha2::sha256().compress(Sha256::state(s.hash), vector_entries(s.schedule).take(16))> {
    And(Sha256::run_holds(own, s, length, holds), Sha256::run_spec(s))
}

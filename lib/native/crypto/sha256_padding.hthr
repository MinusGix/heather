// §5.1.1's one bit and its zeros after a block filled to `fill`: the byte
// 0x80, zeros to the block's end, and, where that leaves no room for the
// eight bytes of the length, the block run and a block of zeros begun.
runtime fn Sha256::pad(mut self s: Sha256, fill: u64) → u64 {
    s.put(fill, 0x80);
    s.zero(fill + 1);
    if fill < 56 {
        fill
    } else {
        s.run();
        s.zero(0);
        fill
    }
}

// The end of a message of `count` bytes: the padding, the length in bits
// as the block's last two words, and the last block run. The count is a
// parameter: read from the context here it would be read after the
// padding's stores, and the pin does not see that those leave it
// (issues/runtime-record-function-limits.md).
runtime fn Sha256::close(mut self s: Sha256, count: u64) → u64 {
    s.pad(count & 63);
    s.schedule := vector_update(vector_update(s.schedule, 14, (count >> 29).truncate(32, 32)), 15, (count << 3).truncate(32, 32));
    s.run()
}

// The linked SHA-256 is the specification's (FIPS 180-4 §6.2):
// `Sha256::digest_spec`, that the digest a context holds after
// `Sha256::init`, `Sha256::update` and `Sha256::finish`
// (`sha256_stream.hthr`) is `Sha2::digest` (`sha2.hthr`) of the message
// taken, and `Sha256::update_took` and `Sha256::finish_digest` for a
// message that arrives in any number of parts.
//
// The invariant is `Sha256Took(s, message)`: the hash value has absorbed
// the message's whole blocks, the context's block (its schedule's first
// sixteen words as bytes, `Sha256::block`) begins with the bytes after
// them, and the count is the message's length (`Sha256Tracks` is the part
// of it the byte loop keeps). A byte pushed keeps it (`Sha256::push_fed`),
// so the loop over a part does (`Sha256::absorb_from`); the end is
// `Sha256::close_hash`, the padding and the length's words against
// `Sha2::hash_short` and `Sha2::hash_long` (`sha2_stream.hthr`). A block
// run is the specification's compression by `Sha256::run_spec`
// (`sha256_agreement.hthr`).
//
// On the bytes: `Sha256::linked_digest`. A span that holds any context
// has, after the three functions' code, the specification's digest in the
// thirty-two bytes where the context lays its hash value
// (`Sha256::digest_bytes`, by `Part::window_of`: the hash value's codec
// loses nothing).
//
// The chains are `simp_only` calls: a function that tests is taken at a
// branch by its generated equations (`Sha256::push::True`,
// `Sha256::pad::False`), and a loop is stepped by its own
// (`Sha256::zero::step`, `Sha256::zero::done`).

import logic;
import bool;
import nat;
import list;
import list_window;
import option;
import bitvec;
import bitvec_bytes;
import bitvec_concat;
import vector;
import omega;
import sha2;
import sha2_stream;
import bitvec_nat;
import bitvec_shift_nat;
import bitvec_omega;
import bitvec_loop;
import stored_words;
import sha256_context;
import sha256_round;
import sha256_block;
import sha256_schedule;
import sha256_working;
import sha256_compression;
import sha256_agreement;
import sha256_filling;
import sha256_padding;
import sha256_stream;
import rt;
import pair;
import layout;
import stored;
import part;
import laid;
import rt_held;

fn Sha256::block(s: Sha256) → List<u8> { Sha2::spelled(vector_entries(s.schedule).take(16)) }

theorem Sha256::len_block(s: Sha256): Sha256::block(s).len() = 64 {
    simp_only(Sha256::block, Sha2::len_spelled, List::len_take, discharge := omega(vector_entries_len(64, s.schedule)))
}

// The compression, of the block's bytes.
theorem Sha256::run_block(s: Sha256):
    Sha256::state(Sha256::run(s).after.hash) = Sha2::sha256().compress(Sha256::state(s.hash), Sha2::sha256().words(Sha256::block(s))) {
    simp_only(Sha256::run_spec, Sha256::block, Sha2::words_spelled)
}

// A byte stored in the schedule's first sixteen words is that byte of the block replaced.
theorem Sha256::block_with_byte(s: Sha256, i: Nat, b: u8, below: i < 64):
    Sha256::block((s with { schedule = vector_with_byte_be(s.schedule, i, b) })) = Sha256::block(s).update(i, λ _ => b) {
    let v = s.schedule;
    let q = i.div(4);
    let r = i.mod(4);
    let w0 = vector_get(v, q, 0);
    let X = w0.with_byte_be(4, r, b);
    let parts = i.div_mul_add_mod(4);
    let small: (r < 4) = i.mod_lt(4);
    let word: (q < 16) = i.div_lt_of_lt_mul(4, 16, below);
    let inside: (q < 64) = omega;
    let at: (vector_entries(v).take(16).nth(q) = Some(w0)) =
        trans(vector_entries(v).nth_take(16, q, word), trans(vector_entries_nth(64, v, q, inside), cong_fn(λ (y: u32) => Some(y), sym(vector_get_inside(64, v, q, 0, inside)))));
    let listed: (vector_entries(vector_update(v, q, X)).take(16) = vector_entries(v).take(16).update(q, λ _ => X)) =
        simp_only(vector_entries_update, List::take_update);
    let place: (4 * q + r = i) = omega;
    trans(cong_fn(λ (e: List<u32>) => Sha2::spelled(e), listed),
        trans(Sha2::spelled_update(vector_entries(v).take(16), q, r, w0, b, small, at),
            cong_fn(λ (k: Nat) => Sha256::block(s).update(k, λ _ => b), place)))
}

// A byte stored inside the block is that byte of the schedule's word replaced.
theorem Sha256::put_inside(s: Sha256, at, byte: u64, below: at.toNat() < 64):
    Sha256::put(s, at, byte) = Mutated((s with { schedule = vector_with_byte_be(s.schedule, at.toNat(), byte.truncate(8, 56)) }), at) {
    Sha256::put::True(s, at, byte, below)
}

// The context after whole blocks `full` of a message and `T` more bytes,
// with room for `room` more before the block is run.
record Sha256Tracks(s: Sha256, full: List<List<u8>>, T: List<u8>, room: Nat) {
    hashed: Sha256::state(s.hash) = Sha2::absorbed(Sha2::sha256().start(), full),
    held: Sha256::block(s).take(T.len()) = T,
    space: T.len() + room = 63,
    whole: Sha2::Blocks(full),
}

// The block after one more byte.
theorem Sha256::block_put(s: Sha256, T: List<u8>, fill, byte: u64, held: Sha256::block(s).take(T.len()) = T, at: fill.toNat() = T.len(), below: T.len() < 64):
    Sha256::block(Sha256::put(s, fill, byte).after).take(Succ(T.len())) = T ++ [byte.truncate(8, 56)] {
    simp_only(Sha256::put_inside, Sha256::block_with_byte, at, List::take_update_snoc, held, discharge := omega(at, below, Sha256::len_block(s)))
}

// A byte stored leaves the hash value.
theorem Sha256::put_hash(s: Sha256, fill, byte: u64, below: fill.toNat() < 64): Sha256::put(s, fill, byte).after.hash = s.hash {
    simp_only(Sha256::put_inside)
}

// A byte pushed where the block has room after it.
theorem Sha256::push_room(s: Sha256, full: List<List<u8>>, T: List<u8>, k: Nat, fill, byte: u64, t: Sha256Tracks(s, full, T, Succ(k)), at: fill.toNat() = T.len()):
    And<Sha256Tracks(Sha256::push(s, fill, byte).after, full, T ++ [byte.truncate(8, 56)], k), Sha256::push(s, fill, byte).value.toNat() = Succ(T.len())> {
    let space = t.space;
    let pushed: (Sha256::push(s, fill, byte) = Mutated(Sha256::put(s, fill, byte).after, fill + 1)) =
        Sha256::push::False(s, fill, byte, λ same => {
            let n: (fill.toNat() = 63) = cong_fn(λ (x: u64) => x.toNat(), same);
            omega
        });
    let inside: (fill.toNat() < 64) = omega;
    let longer = T.len_append([byte.truncate(8, 56)]);
    let next: ((fill + 1).toNat() = Succ(T.len())) = bv_omega;
    let held: (Sha256::block(Sha256::put(s, fill, byte).after).take((T ++ [byte.truncate(8, 56)]).len()) = T ++ [byte.truncate(8, 56)]) =
        simp_only(List::len_append, then := Sha256::block_put(s, T, fill, byte, t.held, at, omega));
    let hashed: (Sha256::state(Sha256::put(s, fill, byte).after.hash) = Sha2::absorbed(Sha2::sha256().start(), full)) = simp_only(Sha256::put_hash, t.hashed);
    simp_only(pushed, then := And(Sha256Tracks(hashed, held, omega, t.whole), next))
}

// The byte that fills the block: the block is run and a new one begun.
theorem Sha256::push_full(s: Sha256, full: List<List<u8>>, T: List<u8>, fill, byte: u64, t: Sha256Tracks(s, full, T, 0), at: fill.toNat() = T.len()):
    And<Sha256Tracks(Sha256::push(s, fill, byte).after, full ++ [T ++ [byte.truncate(8, 56)]], Nil, 63), Sha256::push(s, fill, byte).value.toNat() = 0> {
    let last = T ++ [byte.truncate(8, 56)];
    let P = Sha256::put(s, fill, byte).after;
    let space: (T.len() = 63) = t.space;
    let inside: (fill.toNat() < 64) = omega;
    let pushed: (Sha256::push(s, fill, byte) = Mutated(Sha256::run(P).after, 0)) = Sha256::push::True(s, fill, byte, bv_omega);
    let block: (Sha256::block(P) = last) =
        trans(sym(Sha256::block(P).take_len()), simp_only(Sha256::len_block, space, using := Sha256::block_put(s, T, fill, byte, t.held, at, omega)));
    let hashed: (Sha256::state(Sha256::run(P).after.hash) = Sha2::absorbed(Sha2::sha256().start(), full ++ [last])) =
        simp_only(Sha256::run_block, Sha256::put_hash, t.hashed, block, Sha2::absorbed_snoc);
    let sized: (last.len() = 64) = simp_only(List::len_append, space);
    simp_only(pushed, then := And(Sha256Tracks(hashed, Sha256::block(Sha256::run(P).after).take_zero(), refl, Sha2::blocks_snoc(full, last, sized, t.whole)), refl))
}

// The context the zeroing loop leaves, from its generated step equations.

fn Sha256::zeroed(s: Sha256, i: u64, n: Nat) → Sha256 { BitVec::run_up(λ (s: Sha256) (i: u64) => Sha256::put(s, i, 0).after, s, i, n) }

theorem Sha256::zero_from(s: Sha256, i: u64, n: Nat, left: i.toNat() + n = 64): Sha256::zero(s, i) = Mutated(Sha256::zeroed(s, i, n), 64) {
    BitVec::counts_up(λ (s: Sha256) (i: u64) => Sha256::zero(s, i), λ (s: Sha256) (i: u64) => Sha256::put(s, i, 0).after, 64,
        λ s i below => Sha256::zero::step(s, i, below), λ s i past => Sha256::zero::done(s, i, past), n, s, i, left)
}

// The block's first bytes kept, zeros after them, and the hash value left.
theorem Sha256::zeroed_block(n: Nat): (s: Sha256) → (i: u64) → (T: List<u8>) → i.toNat() + n = 64 → i.toNat() = T.len() → Sha256::block(s).take(T.len()) = T →
    And<Sha256::block(Sha256::zeroed(s, i, n)) = T ++ Sha2::zero_bytes(n), Sha256::zeroed(s, i, n).hash = s.hash> {
    match n {
        Zero => λ s i T left at held => {
            let count: (T.len() = Sha256::block(s).len()) = trans(sym(at), trans(left, sym(Sha256::len_block(s))));
            let whole: (Sha256::block(s) = T) = trans(sym(Sha256::block(s).take_len()), j(count, λ k _ => Sha256::block(s).take(k) = T, held));
            And(trans(whole, sym(T.append_nil())), refl)
        },
        Succ(m, ih) => λ s i T left at held => {
            let next: ((i + 1).toNat() = i.toNat() + 1) = bv_omega;
            let P = Sha256::put(s, i, 0).after;
            let put: (Sha256::block(P).take((T ++ [0]).len()) = T ++ [0]) = simp_only(List::len_append, then := Sha256::block_put(s, T, i, 0, held, at, omega));
            let sized: ((T ++ [0]).len() = T.len() + 1) = simp_only(List::len_append);
            let rest = ih(P, i + 1, T ++ [0], omega, omega, put);
            let step: (Sha256::zeroed(s, i, Succ(m)) = Sha256::zeroed(P, i + 1, m)) = refl;
            let inside: (i.toNat() < 64) = omega;
            simp_only(step, rest.left, rest.right, List::append_assoc, Sha256::put_hash(s, i, 0, inside))
        },
    }
}

// The block with the one bit and its zeros.
fn Sha256::filled(s: Sha256, fill: u64) → Sha256 { Sha256::zero(Sha256::put(s, fill, 0x80).after, fill + 1).after }

// The one bit and zeros to the block's end, after the bytes it held.
theorem Sha256::filled_block(s: Sha256, T: List<u8>, fill: u64, at: fill.toNat() = T.len(), below: T.len() < 64, held: Sha256::block(s).take(T.len()) = T):
    And<Sha256::block(Sha256::filled(s, fill)) = T ++ Sha2::one_bit(63 - T.len()), Sha256::filled(s, fill).hash = s.hash> {
    let P = Sha256::put(s, fill, 0x80).after;
    let next: ((fill + 1).toNat() = fill.toNat() + 1) = bv_omega;
    let put: (Sha256::block(P).take((T ++ [0x80]).len()) = T ++ [0x80]) = simp_only(List::len_append, then := Sha256::block_put(s, T, fill, 0x80, held, at, below));
    let left: ((fill + 1).toNat() + (63 - T.len()) = 64) = omega;
    let sized: ((T ++ [0x80]).len() = T.len() + 1) = simp_only(List::len_append);
    let zeros = Sha256::zeroed_block(63 - T.len(), P, fill + 1, T ++ [0x80], left, omega, put);
    let ran: (Sha256::filled(s, fill) = Sha256::zeroed(P, fill + 1, 63 - T.len())) = simp_only(Sha256::filled, Sha256::zero_from(P, fill + 1, 63 - T.len(), left));
    simp_only(ran, zeros.left, zeros.right, List::append_assoc, Sha256::put_hash, discharge := omega(at, below))
}

// The padding where the length still fits the block: the block is the bytes held, the one bit, and zeros.
theorem Sha256::pad_short(s: Sha256, T: List<u8>, fill: u64, at: fill.toNat() = T.len(), short: T.len() < 56, held: Sha256::block(s).take(T.len()) = T):
    And<Sha256::block(Sha256::pad(s, fill).after) = T ++ Sha2::one_bit(63 - T.len()), Sha256::pad(s, fill).after.hash = s.hash> {
    let is: (Sha256::pad(s, fill).after = Sha256::filled(s, fill)) = simp_only(Sha256::pad::True(s, fill, omega));
    simp_only(is, then := Sha256::filled_block(s, T, fill, at, omega, held))
}

// The padding where it does not: the block is run, and a block of zeros begun.
theorem Sha256::pad_long(s: Sha256, T: List<u8>, fill: u64, at: fill.toNat() = T.len(), long: 56 <= T.len(), below: T.len() < 64, held: Sha256::block(s).take(T.len()) = T):
    And<Sha256::block(Sha256::pad(s, fill).after) = Sha2::zero_bytes(64),
        Sha256::state(Sha256::pad(s, fill).after.hash) = Sha2::sha256().compress(Sha256::state(s.hash), Sha2::sha256().words(T ++ Sha2::one_bit(63 - T.len())))> {
    let R = Sha256::run(Sha256::filled(s, fill)).after;
    let is: (Sha256::pad(s, fill).after = Sha256::zero(R, 0).after) = simp_only(Sha256::pad::False(s, fill, λ (lt: fill.toNat() < 56) => omega));
    let filled = Sha256::filled_block(s, T, fill, at, below, held);
    let zeros = Sha256::zeroed_block(64, R, 0, Nil, refl, refl, Sha256::block(R).take_zero());
    simp_only(is, Sha256::zero_from(R, 0, 64, refl), zeros.left, zeros.right, Sha256::run_block, filled.right, filled.left)
}

// The length's two words stored, and `Sha256::close` as the padding, those, and the block run.
fn Sha256::lengthed(s: Sha256, count: u64) → Sha256 {
    (s with { schedule = vector_update(vector_update(s.schedule, 14, (count >> 29).truncate(32, 32)), 15, (count << 3).truncate(32, 32)) })
}

theorem Sha256::close_is(s: Sha256, count: u64): Sha256::close(s, count) = Sha256::run(Sha256::lengthed(Sha256::pad(s, count & 63).after, count)) { refl }

theorem Sha256::lengthed_block(s: Sha256, count: u64):
    Sha256::block(Sha256::lengthed(s, count)) = Sha256::block(s).take(56) ++ Sha2::spelled([(count >> 29).truncate(32, 32), (count << 3).truncate(32, 32)]) { refl }

theorem Sha256::lengthed_is(s: Sha256, count: u64, n: Nat, counted: count = BitVec::ofNat(n)):
    Sha256::block(Sha256::lengthed(s, count)) = Sha256::block(s).take(56) ++ Sha2::be_bytes(8 * n, 8) {
    simp_only(Sha256::lengthed_block, Sha2::length_spelled(count, n, counted))
}

// The message's end where the padding fits the block it ends in.
theorem Sha256::close_short(s: Sha256, full: List<List<u8>>, T: List<u8>, room: Nat, count: u64, n: Nat, t: Sha256Tracks(s, full, T, room),
    fill: (count & 63).toNat() = T.len(), counted: count = BitVec::ofNat(n), total: n = 64 * full.len() + T.len(), short: T.len() < 56):
    Sha256::state(Sha256::close(s, count).after.hash) = Sha2::sha256().hash(List::joined(full) ++ T) {
    let Pd = Sha256::pad(s, count & 63).after;
    let L = Sha256::lengthed(Pd, count);
    let padded = Sha256::pad_short(s, T, count & 63, fill, short, t.held);
    let lb = Sha2::be_bytes(8 * n, 8);
    let head = T ++ Sha2::one_bit(55 - T.len());
    let count_zeros: (63 - T.len() = 8 + (55 - T.len())) = omega;
    let zeros: (Sha2::zero_bytes(63 - T.len()) = Sha2::zero_bytes(55 - T.len()) ++ Sha2::zero_bytes(8)) =
        trans(cong_fn(λ (c: Nat) => Sha2::zero_bytes(c), count_zeros), Sha2::zero_bytes_add(55 - T.len(), 8));
    let cut: (T ++ Sha2::one_bit(63 - T.len()) = head ++ Sha2::zero_bytes(8)) =
        trans(cong_fn(λ (z: List<u8>) => T ++ Cons(BitVec::ofNat(0x80), z), zeros), sym(T.append_assoc(Sha2::one_bit(55 - T.len()), Sha2::zero_bytes(8))));
    let l1 = T.len_append(Sha2::one_bit(55 - T.len()));
    let l2 = Sha2::len_zero_bytes(55 - T.len());
    let sized: (56 = head.len()) = omega;
    let front: (Sha256::block(Pd).take(56) = head) =
        simp_only(padded.left, cut, sized, List::take_append_len);
    simp_only(Sha256::close_is, Sha256::run_block, Sha256::lengthed_is(Pd, count, n, counted), front, List::append_assoc, total, Sha2::one_bit, Sha2::ending,
        padded.right, t.hashed, Sha2::hash_short(full, T, t.whole, short))
}

// The message's end where the padding takes a block more.
theorem Sha256::close_long(s: Sha256, full: List<List<u8>>, T: List<u8>, room: Nat, count: u64, n: Nat, t: Sha256Tracks(s, full, T, room),
    fill: (count & 63).toNat() = T.len(), counted: count = BitVec::ofNat(n), total: n = 64 * full.len() + T.len(), long: 56 <= T.len()):
    Sha256::state(Sha256::close(s, count).after.hash) = Sha2::sha256().hash(List::joined(full) ++ T) {
    let Pd = Sha256::pad(s, count & 63).after;
    let L = Sha256::lengthed(Pd, count);
    let space = t.space;
    let below: (T.len() < 64) = omega;
    let padded = Sha256::pad_long(s, T, count & 63, fill, long, below, t.held);
    simp_only(Sha256::close_is, Sha256::run_block, Sha256::lengthed_is(Pd, count, n, counted), padded.left, total, Sha2::length_block,
        padded.right, t.hashed, Sha2::hash_long(full, T, t.whole, long, below))
}

// A context closed holds the specification's hash of the bytes it was tracking.
theorem Sha256::close_hash(s: Sha256, full: List<List<u8>>, T: List<u8>, room: Nat, count: u64, n: Nat, t: Sha256Tracks(s, full, T, room),
    fill: (count & 63).toNat() = T.len(), counted: count = BitVec::ofNat(n), total: n = 64 * full.len() + T.len()):
    Sha256::state(Sha256::close(s, count).after.hash) = Sha2::sha256().hash(List::joined(full) ++ T) {
    match T.len().lt_or_ge(56) {
        Inl(short) => Sha256::close_short(s, full, T, room, count, n, t, fill, counted, total, short),
        Inr(long) => Sha256::close_long(s, full, T, room, count, n, t, fill, counted, total, long),
    }
}

// A byte pushed keeps the context on the message.
theorem Sha256::push_fed(s: Sha256, full: List<List<u8>>, T: List<u8>, room: Nat, fill, byte: u64, t: Sha256Tracks(s, full, T, room), at: fill.toNat() = T.len()):
    And<Sha256Tracks(Sha256::push(s, fill, byte).after, Sha2Feed::fed(full, T, room, byte.truncate(8, 56)).full, Sha2Feed::fed(full, T, room, byte.truncate(8, 56)).tail, Sha2Feed::fed(full, T, room, byte.truncate(8, 56)).room),
        Sha256::push(s, fill, byte).value.toNat() = Sha2Feed::fed(full, T, room, byte.truncate(8, 56)).tail.len()> {
    (match room as λ r => Sha256Tracks(s, full, T, r) →
        And<Sha256Tracks(Sha256::push(s, fill, byte).after, Sha2Feed::fed(full, T, r, byte.truncate(8, 56)).full, Sha2Feed::fed(full, T, r, byte.truncate(8, 56)).tail, Sha2Feed::fed(full, T, r, byte.truncate(8, 56)).room),
            Sha256::push(s, fill, byte).value.toNat() = Sha2Feed::fed(full, T, r, byte.truncate(8, 56)).tail.len()> {
        Zero => λ t => Sha256::push_full(s, full, T, fill, byte, t, at),
        Succ(k) => λ t => simp_only(List::len_append, using := Sha256::push_room(s, full, T, k, fill, byte, t, at)),
    })(t)
}

// A context and the count of its block's bytes, on a message fed.
fn Sha256::Fed(m: Mutated<Sha256, u64>, f: Sha2Feed) → Type { And<Sha256Tracks(m.after, f.full, f.tail, f.room), m.value.toNat() = f.tail.len()> }

// The byte loop from `j`: the context is on the message fed the bytes from there.
theorem Sha256::absorb_from(n: Nat): (s: Sha256) → (message: List<u8>) → (mn, j, fill: u64) → (full: List<List<u8>>) → (T: List<u8>) → (room: Nat) →
    j.toNat() + n = mn.toNat() → message.len() = mn.toNat() → Sha256Tracks(s, full, T, room) → fill.toNat() = T.len() →
    Sha256::Fed(Sha256::absorb(s, message, mn, j, fill), Sha2Feed(full, T, room).bytes(message.drop(j.toNat()))) {
    match n {
        Zero => λ s message mn j fill full T room left sized t at => {
            let end: (j.toNat() = message.len()) = omega;
            let done = Sha256::absorb::done(s, message, mn, j, fill, λ (lt: j.toNat() < mn.toNat()) => omega);
            simp_only(done, end, List::drop_len, then := And(t, at))
        },
        Succ(m, ih) => λ s message mn j fill full T room left sized t at => {
            let zero: u8 = 0;
            let B = message.byte_within(mn, j).zero_extend(56);
            let b = message.nth(j.toNat()).unwrap_or(zero);
            let byte: (B.truncate(8, 56) = b) = trans(BitVec::truncate_zero_extend(8, 56, message.byte_within(mn, j)), message.byte_within_inside(mn, j, omega));
            let pushed = Sha256::push_fed(s, full, T, room, fill, B, t, at);
            let P = Sha256::push(s, fill, B);
            let F = Sha2Feed::fed(full, T, room, B.truncate(8, 56));
            let inside: (j.toNat() < mn.toNat()) = omega;
            let next: ((j + 1).toNat() = j.toNat() + 1) = bv_omega;
            let after: ((j + 1).toNat() = Succ(j.toNat())) = omega;
            let rest = ih(P.after, message, mn, j + 1, P.value, F.full, F.tail, F.room, omega, sized, pushed.left, pushed.right);
            let cut: (message.drop(j.toNat()) = Cons(b, message.drop(Succ(j.toNat())))) = message.drop_at(j.toNat(), zero, omega);
            simp_only(Sha256::absorb::step(s, message, mn, j, fill, inside), after, byte, cut, Sha2Feed::byte, using := rest)
        },
    }
}

// A context that has taken a message: its hash value has absorbed the
// whole blocks, its block begins with the bytes after them, and its count
// is the message's length.
record Sha256Took(s: Sha256, message: List<u8>) {
    feed: Sha2Feed,
    tracks: Sha256Tracks(s, feed.full, feed.tail, feed.room),
    said: feed.message() = message,
    counted: s.count = BitVec::ofNat(message.len()),
}

theorem Sha256Took::length(s: Sha256, message: List<u8>, took: Sha256Took(s, message)): message.len() = 64 * took.feed.full.len() + took.feed.tail.len() {
    let whole = Sha2::len_joined(took.feed.full, took.tracks.whole);
    let sum = List::joined(took.feed.full).len_append(took.feed.tail);
    let same: (took.feed.message().len() = message.len()) = simp_only(took.said);
    omega
}

// A context begun has taken nothing.
theorem Sha256::init_took(s: Sha256): Sha256Took(Sha256::init(s).after, Nil) {
    let I = Sha256::init(s).after;
    let none: List<u8> = Nil;
    let tracks: Sha256Tracks(I, Nil, none, 63) = Sha256Tracks(refl, Sha256::block(I).take_zero(), refl, trivial);
    Sha256Took(Sha2Feed(Nil, none, 63), tracks, refl, refl)
}

theorem Sha256Took::fill(s: Sha256, message: List<u8>, took: Sha256Took(s, message)): (s.count & 63).toNat() = took.feed.tail.len() {
    let f = took.feed;
    let length = Sha256Took::length(s, message, took);
    let space = took.tracks.space;
    Sha2::fill_of_count(s.count, f.full.len(), f.tail.len(), simp_only(length, using := took.counted), omega)
}

// One more part taken.
theorem Sha256::update_took(s: Sha256, message, part: List<u8>, mn: u64, sized: part.len() = mn.toNat(), took: Sha256Took(s, message)):
    Sha256Took(Sha256::update(s, part, mn).after, message ++ part) {
    let f = took.feed;
    let fill = Sha256Took::fill(s, message, took);
    let zero: u64 = 0;
    let A = Sha256::absorb(s, part, mn, 0, s.count & 63);
    let fed = Sha256::absorb_from(mn.toNat(), s, part, mn, 0, s.count & 63, f.full, f.tail, f.room, omega, sized, took.tracks, fill);
    let G = f.bytes(part);
    let on: Sha256::Fed(A, G) = simp_only(List::drop_zero, using := fed);
    let updated: (Sha256::update(s, part, mn).after = (A.after with { count = s.count + mn })) = refl;
    let tracks: Sha256Tracks(A.after with { count = s.count + mn }, G.full, G.tail, G.room) = Sha256Tracks(on.left.hashed, on.left.held, on.left.space, on.left.whole);
    let said: (G.message() = message ++ part) = simp_only(Sha2Feed::message_bytes, took.said);
    let word: (mn = BitVec::ofNat(part.len())) = simp_only(sized, BitVec::ofNat_toNat);
    let counted: (s.count + mn = BitVec::ofNat((message ++ part).len())) = simp_only(List::len_append, using := BitVec::ofNat_add_of(64, took.counted, word));
    j(sym(updated), λ u _ => Sha256Took(u, message ++ part), Sha256Took(G, tracks, said, counted))
}

// The message ended: the hash value is the specification's.
theorem Sha256::finish_hash(s: Sha256, message: List<u8>, took: Sha256Took(s, message)):
    Sha256::state(Sha256::finish(s).after.hash) = Sha2::sha256().hash(message) {
    let f = took.feed;
    let closed = Sha256::close_hash(s, f.full, f.tail, f.room, s.count, message.len(), took.tracks, Sha256Took::fill(s, message, took), took.counted, Sha256Took::length(s, message, took));
    trans(closed, cong_fn(λ (m: List<u8>) => Sha2::sha256().hash(m), took.said))
}

// The digest a context holds: its hash value's thirty-two bytes, as the
// span stores them.
fn Sha256::digest(s: Sha256) → List<u8> { Sha2::spelled(vector_entries(s.hash)) }

theorem Sha256::spell_state(v: [u32; 8]): Sha2::sha256().spell(Sha256::state(v)) = Sha2::spelled(vector_entries(v)) { refl }

// The digest left is the specification's.
theorem Sha256::finish_digest(s: Sha256, message: List<u8>, took: Sha256Took(s, message)):
    Sha256::digest(Sha256::finish(s).after) = Sha2::sha256().digest(message) {
    simp_only(Sha256::digest, sym(Sha256::spell_state(Sha256::finish(s).after.hash)), Sha256::finish_hash(s, message, took))
}

// A message in one part.
theorem Sha256::digest_spec(s: Sha256, message: List<u8>, mn: u64, sized: message.len() = mn.toNat()):
    Sha256::digest(Sha256::finish(Sha256::update(Sha256::init(s).after, message, mn).after).after) = Sha2::sha256().digest(message) {
    let none: List<u8> = Nil;
    let took: Sha256Took(Sha256::update(Sha256::init(s).after, message, mn).after, none ++ message) = Sha256::update_took(Sha256::init(s).after, none, message, mn, sized, Sha256::init_took(s));
    Sha256::finish_digest(Sha256::update(Sha256::init(s).after, message, mn).after, message, took)
}

// A span that holds a context has the context's digest where the hash
// value lies.
theorem Sha256::digest_bytes(span: List<u8>, length: u64, s: Sha256, holds: Sha256::stored().Holds(span, length, s)):
    span.window(SHA256_DIGEST_AT, 32 + SHA256_DIGEST_AT) = Sha256::digest(s) {
    let inside: (328 <= length.toNat()) = holds.left;
    let own: (length.toNat() <= span.len()) = holds.right.left;
    let fits: (328 + 0 <= span.len()) = omega;
    let exact = Stored::u32_be().exact_array(8, refl, Stored::be_bytes(4).exact_aligned(2, Stored::exact_be_bytes(4)));
    let read = Sha256::hash_part().window_of(exact, span, 0, fits);
    simp_only(read, holds.right.right)
}

// The linked hash, on the bytes: a span that holds any context, after the
// code of `init`, `update` over the message and `finish`, has the
// specification's digest where the context lays its hash value.
theorem Sha256::linked_digest(span: List<u8>, s: Sha256, length: u64, message: List<u8>, mn: u64,
    holds: Sha256::stored().Holds(span, length, s), sized: message.len() = mn.toNat()):
    Sha256::finish::bytes(Sha256::update::bytes(Sha256::init::bytes(span, length).after, length, message, mn).after, length).after
        .window(SHA256_DIGEST_AT, 32 + SHA256_DIGEST_AT) = Sha2::sha256().digest(message) {
    let begun = Sha256::init::bytes(span, length).after;
    let taken = Sha256::update::bytes(begun, length, message, mn).after;
    let h1: Sha256::stored().Holds(begun, length, Sha256::init(s).after) = Sha256::init_holds(span, s, length, holds);
    let h2 = Sha256::update_holds(begun, Sha256::init(s).after, length, message, mn, h1);
    let h3 = Sha256::finish_holds(taken, Sha256::update(Sha256::init(s).after, message, mn).after, length, h2);
    trans(Sha256::digest_bytes(Sha256::finish::bytes(taken, length).after, length, Sha256::finish(Sha256::update(Sha256::init(s).after, message, mn).after).after, h3),
        Sha256::digest_spec(s, message, mn, sized))
}

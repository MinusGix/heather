import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;
import runtime;
import runtime_file;
import sha2;
import sha256_round;
import sha256_block;
import stored_words;
import vector;
import bitvec_bytes;
import list_window;
import layout;
import stored;
import part;
import laid;
import sha256_context;
import rt_file_reflect;
import stored_accessor;
import rt_held;
import rt_held_fields;
import rt_held_reflect;
import sha256_schedule;
import sha256_working;

// Rounds `i` to 63: T1, then T2 and the working variables' turn.
runtime fn Sha256::rounds(mut self s: Sha256, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        let t1 = s.t1(i, s.schedule.at(i).zero_extend(32));
        s.turn(t1);
        s.rounds(i + 1)
    } else {
        i
    }
}

// The hash value with the working variables added, word by word (step 4).
runtime fn Sha256::end(mut self s: Sha256, i: u64) → u64
    decreases (8 - i).toNat() {
    if h: i < 8 {
        s.hash := s.hash.put(i, s.hash.at(i) + s.working.at(i));
        s.end(i + 1)
    } else {
        i
    }
}

// The compression of the block whose sixteen words are the schedule's
// first: H(i) where H(i−1) was.
runtime fn Sha256::run(mut self s: Sha256) → u64 {
    s.expand(0);
    s.begin(0);
    s.rounds(0);
    s.end(0)
}

// A span that held a context is left holding the context compressed.
theorem Sha256::run_holds(own: List<u8>, s: Sha256, length: u64, holds: Sha256::stored().Holds(own, length, s)):
    Sha256::stored().Holds(Sha256::run::bytes(own, length).after, length, Sha256::run(s).after) {
    Sha256::run::runs_held(own, s, length, holds).holds
}

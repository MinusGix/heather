import rt_held;
import rt_held_fields;
import rt_held_reflect;
import sha256_schedule;
import sha256_working;

// Rounds `i` to 63: T1, then T2 and the working variables' turn.
runtime fn Sha256::rounds(mut self s: Sha256, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        let t1 = s.t1(i);
        s.turn(t1);
        s.rounds(i + 1)
    } else {
        i
    }
}

// The hash value with the working variables added, word by word (step 4).
runtime fn Sha256::end(mut self s: Sha256, i: u64) → u64
    decreases (8 - i).toNat() {
    if h: i < 8 {
        s.hash := vector_update(s.hash, i.toNat(), vector_get(s.hash, i.toNat(), 0) + vector_get(s.working, i.toNat(), 0));
        s.end(i + 1)
    } else {
        i
    }
}

// The compression of the block whose sixteen words are the schedule's
// first: H(i) where H(i−1) was.
runtime fn Sha256::run(mut self s: Sha256) → u64 {
    s.expand(16);
    s.begin(0);
    s.rounds(0);
    s.end(0)
}

// A span that held a context is left holding the context compressed.
theorem Sha256::run_holds(own: List<u8>, s: Sha256, length: u64, holds: Sha256::stored().Holds(own, length, s)):
    Sha256::stored().Holds(Sha256::run::bytes(own, length).after, length, Sha256::run(s).after) {
    Sha256::run::runs_held(own, s, length, holds).holds
}

// The compression as a function over a span: the context's code run where
// the context is laid. What a caller that assembles a block in the context
// itself calls (`sha256_stream`).
runtime fn List::sha256_run(mut self ctx: List<u8>, cn: u64) → u64 {
    let ran = Sha256::run::bytes(ctx, cn);
    ctx := ran.after;
    ran.value
}

// §6.2.2: H(i) from H(i−1) and a block. Of the context the hash value is
// read, and it, the working variables and the schedule are written. What
// the hash value's thirty-two bytes spell after the last block is the
// digest.
runtime fn sha256_compress(ctx: List<u8>, cn: u64, block: List<u8>, bn: u64) → Mutated<List<u8>, u64> {
    let mut ctx = ctx;
    ctx.sha256_take_block(cn, block, bn, 0);
    let ran = ctx.sha256_run(cn);
    Mutated(ctx, ran)
}

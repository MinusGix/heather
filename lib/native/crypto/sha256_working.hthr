// A round of SHA-256 as functions of its context (FIPS 180-4 §6.2.2 step
// 3): the second of the three modules `sha256_compression.hthr` describes.
// A round's second half is two functions (`turn`, `set`) because a
// function passes at most six words; the seven moves are a third
// (`shift`). Its first half, T1, is `Sha256::t1` (`sha256_schedule.hthr`),
// and the loop calls the two (`Sha256::rounds`): a function that called
// `turn` itself would carry `turn`'s whole program in its own
// elaboration, which is the long part of it.
//
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import function_ir_lower;
import function_ir_lower_calls;
import nat_map;
import rt_held_loop;
import x86_64_asm;
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;

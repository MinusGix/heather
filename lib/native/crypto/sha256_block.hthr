// SHA-256's compression function as compiled code over two spans
// (issues/sha2-compress-native.md, stage C1 of
// docs/native-lexer-crypto-roadmap.md): `sha256_compress` takes a context it
// may store into and a block it only reads, and leaves H(i) where H(i−1)
// was (FIPS 180-4 §6.2.2).
//
// The context is 320 bytes: the hash value's eight words, then the working
// variables' eight, then the schedule's sixty-four, each word four bytes
// with the most significant first. Everything a round touches is in the
// span, because a function passes at most six words and a round has eight
// working variables, a constant and a schedule word: each step reads the
// words it needs from the span and stores its results back
// (issues/function-call-past-six-words.md is what would let the working
// variables be values). The word functions are `sha256_round`'s, which read
// the low half of each 64-bit word they are given.
//
// The loops are measured recursions on a counter, one function each, and
// the round is three functions (`sha256_step`, `sha256_turn`, `sha256_set`)
// so that no one of them holds more than the planner places in registers.
// Two of those have one Heather type, which is what the generator's link
// check once could not afford (issues/runtime-link-compares-functions.md):
// this module is that issue's regression at full size.
//
// Not proved here: that the compiled function is `Sha2::compress`. What it
// computes is held to an independent implementation and to the standard's
// vectors where it is linked (crates/linked/tests/sha256.rs).
import logic;
import bool;
import nat;
import list;
import option;
import pair;
import char;
import string;
import tactic;
import derive;
import bitvec;
import bitvec_nat;
import bitvec_omega;
import algebra;
import omega;
import rt;
import rt_reflect;
import rt_lower;
import rt_loop;
import rt_file;
import rt_file_lower;
import rt_file_loop;
import function_ir;
import function_ir_eval;
import function_ir_state;
import function_ir_writes;
import function_ir_run;
import function_ir_link;
import function_ir_placeless;
import runtime;
import runtime_file;
import sha2;
import sha256_round;

// The four bytes from `i` as a word, the first the most significant, each
// read under the span's length word.
runtime fn sha256_word_at(span: List<u8>, length, i: u64) → u64 {
    span.byte_within(length, i).zero_extend(56) << 24
        | span.byte_within(length, i + 1).zero_extend(56) << 16
        | span.byte_within(length, i + 2).zero_extend(56) << 8
        | span.byte_within(length, i + 3).zero_extend(56)
}

// A word's low four bytes stored from `i`, the most significant first.
runtime fn List::sha256_put_word(mut self span: List<u8>, length, i, word: u64) → u64 {
    span.put_within(length, i, (word >> 24).truncate(8, 56));
    span.put_within(length, i + 1, (word >> 16).truncate(8, 56));
    span.put_within(length, i + 2, (word >> 8).truncate(8, 56));
    span.put_within(length, i + 3, word.truncate(8, 56));
    word
}

// The round constant K(t) (FIPS 180-4 §4.2.2), found by halving: compiled
// code has no table to index (issues/rt-fixed-arrays-and-tables.md).
runtime fn sha256_k(t: u64) → u64 {
    if t < 32 {
        if t < 16 {
            if t < 8 {
                if t < 4 {
                    if t < 2 { if t < 1 { 0x428a2f98 } else { 0x71374491 } } else { if t < 3 { 0xb5c0fbcf } else { 0xe9b5dba5 } }
                } else {
                    if t < 6 { if t < 5 { 0x3956c25b } else { 0x59f111f1 } } else { if t < 7 { 0x923f82a4 } else { 0xab1c5ed5 } }
                }
            } else {
                if t < 12 {
                    if t < 10 { if t < 9 { 0xd807aa98 } else { 0x12835b01 } } else { if t < 11 { 0x243185be } else { 0x550c7dc3 } }
                } else {
                    if t < 14 { if t < 13 { 0x72be5d74 } else { 0x80deb1fe } } else { if t < 15 { 0x9bdc06a7 } else { 0xc19bf174 } }
                }
            }
        } else {
            if t < 24 {
                if t < 20 {
                    if t < 18 { if t < 17 { 0xe49b69c1 } else { 0xefbe4786 } } else { if t < 19 { 0x0fc19dc6 } else { 0x240ca1cc } }
                } else {
                    if t < 22 { if t < 21 { 0x2de92c6f } else { 0x4a7484aa } } else { if t < 23 { 0x5cb0a9dc } else { 0x76f988da } }
                }
            } else {
                if t < 28 {
                    if t < 26 { if t < 25 { 0x983e5152 } else { 0xa831c66d } } else { if t < 27 { 0xb00327c8 } else { 0xbf597fc7 } }
                } else {
                    if t < 30 { if t < 29 { 0xc6e00bf3 } else { 0xd5a79147 } } else { if t < 31 { 0x06ca6351 } else { 0x14292967 } }
                }
            }
        }
    } else {
        if t < 48 {
            if t < 40 {
                if t < 36 {
                    if t < 34 { if t < 33 { 0x27b70a85 } else { 0x2e1b2138 } } else { if t < 35 { 0x4d2c6dfc } else { 0x53380d13 } }
                } else {
                    if t < 38 { if t < 37 { 0x650a7354 } else { 0x766a0abb } } else { if t < 39 { 0x81c2c92e } else { 0x92722c85 } }
                }
            } else {
                if t < 44 {
                    if t < 42 { if t < 41 { 0xa2bfe8a1 } else { 0xa81a664b } } else { if t < 43 { 0xc24b8b70 } else { 0xc76c51a3 } }
                } else {
                    if t < 46 { if t < 45 { 0xd192e819 } else { 0xd6990624 } } else { if t < 47 { 0xf40e3585 } else { 0x106aa070 } }
                }
            }
        } else {
            if t < 56 {
                if t < 52 {
                    if t < 50 { if t < 49 { 0x19a4c116 } else { 0x1e376c08 } } else { if t < 51 { 0x2748774c } else { 0x34b0bcb5 } }
                } else {
                    if t < 54 { if t < 53 { 0x391c0cb3 } else { 0x4ed8aa4a } } else { if t < 55 { 0x5b9cca4f } else { 0x682e6ff3 } }
                }
            } else {
                if t < 60 {
                    if t < 58 { if t < 57 { 0x748f82ee } else { 0x78a5636f } } else { if t < 59 { 0x84c87814 } else { 0x8cc70208 } }
                } else {
                    if t < 62 { if t < 61 { 0x90befffa } else { 0xa4506ceb } } else { if t < 63 { 0xbef9a3f7 } else { 0xc67178f2 } }
                }
            }
        }
    }
}

// The block's sixty-four bytes stored from byte 64 of the context: the
// schedule's first sixteen words, a block's words being their bytes.
runtime fn List::sha256_take_block(mut self ctx: List<u8>, cn: u64, block: List<u8>, bn, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        ctx.put_within(cn, i + 64, block.byte_within(bn, i));
        ctx.sha256_take_block(cn, block, bn, i + 1)
    } else {
        i
    }
}

// Schedule words `i` to 63, each from the four before it that FIPS 180-4
// §6.2.2 step 1 names: W(t) is the word at byte 64 + 4t of the context.
runtime fn List::sha256_expand(mut self ctx: List<u8>, cn, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        let at = (i << 2) + 64;
        let word = sha256_next(sha256_word_at(ctx, cn, at - 8), sha256_word_at(ctx, cn, at - 28),
            sha256_word_at(ctx, cn, at - 60), sha256_word_at(ctx, cn, at - 64));
        ctx.sha256_put_word(cn, at, word);
        ctx.sha256_expand(cn, i + 1)
    } else {
        i
    }
}

// The hash value's thirty-two bytes copied to the working variables, at
// byte 32 of the context (§6.2.2 step 2).
runtime fn List::sha256_begin(mut self ctx: List<u8>, cn, i: u64) → u64
    decreases (32 - i).toNat() {
    if h: i < 32 {
        ctx.put_within(cn, i + 32, ctx.byte_within(cn, i));
        ctx.sha256_begin(cn, i + 1)
    } else {
        i
    }
}

// Seven of the working variables each moved to the next: h takes g first
// and b takes a last, so that a word is read before it is stored over
// (§6.2.2 step 3). Pass `i` moves the word at byte 56 − 4i.
runtime fn List::sha256_shift(mut self ctx: List<u8>, cn, i: u64) → u64
    decreases (7 - i).toNat() {
    if h: i < 7 {
        let at = 56 - (i << 2);
        ctx.sha256_put_word(cn, at + 4, sha256_word_at(ctx, cn, at));
        ctx.sha256_shift(cn, i + 1)
    } else {
        i
    }
}

// The working variables after a round, from the two new words: the seven
// move, then a and e are stored, e over the d that moved there.
runtime fn List::sha256_set(mut self ctx: List<u8>, cn, first, fifth: u64) → u64 {
    ctx.sha256_shift(cn, 0);
    ctx.sha256_put_word(cn, 32, first);
    ctx.sha256_put_word(cn, 48, fifth)
}

// A round from its T1: T2 is of a, b and c, and the two new words are
// T1 + T2 and d + T1, both computed before any word is stored.
runtime fn List::sha256_turn(mut self ctx: List<u8>, cn, t1: u64) → u64 {
    ctx.sha256_set(cn,
        t1 + sha256_t2(sha256_word_at(ctx, cn, 32), sha256_word_at(ctx, cn, 36), sha256_word_at(ctx, cn, 40)),
        sha256_word_at(ctx, cn, 44) + t1)
}

// Round `t`: T1 is of h, e, f and g, the round's constant and its schedule
// word, which is the word at byte 64 + 4t.
runtime fn List::sha256_step(mut self ctx: List<u8>, cn, t: u64) → u64 {
    ctx.sha256_turn(cn,
        sha256_t1(sha256_word_at(ctx, cn, 60), sha256_word_at(ctx, cn, 48), sha256_word_at(ctx, cn, 52),
            sha256_word_at(ctx, cn, 56), sha256_k(t), sha256_word_at(ctx, cn, (t << 2) + 64)))
}

// Rounds `i` to 63 on the working variables.
runtime fn List::sha256_rounds(mut self ctx: List<u8>, cn, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        ctx.sha256_step(cn, i);
        ctx.sha256_rounds(cn, i + 1)
    } else {
        i
    }
}

// Each working variable added into its word of the hash value (§6.2.2
// step 4).
runtime fn List::sha256_end(mut self ctx: List<u8>, cn, i: u64) → u64
    decreases (8 - i).toNat() {
    if h: i < 8 {
        let at = i << 2;
        ctx.sha256_put_word(cn, at, sha256_word_at(ctx, cn, at) + sha256_word_at(ctx, cn, at + 32));
        ctx.sha256_end(cn, i + 1)
    } else {
        i
    }
}

// §6.2.2 from a schedule whose first sixteen words are in place: the other
// forty-eight, the working variables from the hash value, the rounds, and
// the sums. What a caller that assembles a block in the context itself
// calls (`sha256_stream`).
runtime fn List::sha256_run(mut self ctx: List<u8>, cn: u64) → u64 {
    ctx.sha256_expand(cn, 16);
    ctx.sha256_begin(cn, 0);
    ctx.sha256_rounds(cn, 0);
    ctx.sha256_end(cn, 0)
}

// §6.2.2: H(i) from H(i−1) and a block. The context is the hash value's
// eight words, then the working variables' eight, then the schedule's
// sixty-four, each word four bytes with the most significant first: 320
// bytes, of which the first thirty-two are read and all are written. What
// the first thirty-two spell after the last block is the digest.
runtime fn sha256_compress(ctx: List<u8>, cn: u64, block: List<u8>, bn: u64) → Mutated<List<u8>, u64> {
    let mut ctx = ctx;
    ctx.sha256_take_block(cn, block, bn, 0);
    let ran = ctx.sha256_run(cn);
    Mutated(ctx, ran)
}

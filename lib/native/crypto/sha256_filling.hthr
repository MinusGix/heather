// `word` with its byte at `place` replaced, the most significant byte
// being place 0: what a store of one byte does to the big-endian word it
// lies in.
runtime fn u32_be_with_byte(word, place, byte: u64) → u64 {
    if place < 2 {
        if place < 1 { (word & 0x00ffffff) | ((byte & 0xff) << 24) } else { (word & 0xff00ffff) | ((byte & 0xff) << 16) }
    } else {
        if place < 3 { (word & 0xffff00ff) | ((byte & 0xff) << 8) } else { (word & 0xffffff00) | (byte & 0xff) }
    }
}

// Byte `at` of the schedule's bytes: of a block, its byte `at`.
runtime fn Sha256::put(mut self s: Sha256, at, byte: u64) → u64 {
    s.schedule := vector_update(s.schedule, (at >> 2).toNat(),
        u32_be_with_byte(vector_get(s.schedule, (at >> 2).toNat(), 0).zero_extend(32), at & 3, byte).truncate(32, 32));
    at
}

// One byte into the block at `fill`, and the block run when that fills
// it. Answers how full the block then is.
runtime fn Sha256::push(mut self s: Sha256, fill, byte: u64) → u64 {
    s.put(fill, byte);
    if fill = 63 {
        s.run();
        0
    } else {
        fill + 1
    }
}

// Zeros in the block from `i` to its end.
runtime fn Sha256::zero(mut self s: Sha256, i: u64) → u64
    decreases (64 - i).toNat() {
    if h: i < 64 {
        s.put(i, 0);
        s.zero(i + 1)
    } else {
        i
    }
}

// SHA-512's word functions as compiled code (issues/sha2-compress-native.md,
// stage C1 of docs/native-lexer-crypto-roadmap.md, at the machine's own
// width first).
//
// Three functions hold all of the compression function's arithmetic: `T1`
// and `T2` of a round (FIPS 180-4 §6.4.2 step 3) and one word of the message
// schedule (step 1). Each is a `runtime fn` over 64-bit words, so
// `compile-x86` certifies it, and each is proved here to be the
// specification's own function (`lib/std/crypto/sha2.hthr`) at SHA-512's
// parameters: each is written as the standard writes it, so the proofs are
// unfoldings.
//
// What is not here is what the pure fragment cannot hold yet: the eight
// working variables, the sixteen-word schedule and the table of constants
// (issues/rt-fixed-arrays-and-tables.md). Until then the caller keeps those
// and calls these for every word it computes (`crates/linked`), and
// `sha512_round_spec` says what the caller is trusted to do with the two
// results: `Sha2State::turn`, two additions and seven moves.

import bitvec;
import bitvec_rotate;
import algebra;
import bool;
import list;
import logic;
import nat;
import option;
import sha2;
// What the `runtime` generator reads (issues/runtime-generator-imports.md).
import tactic;
import char;
import string;
import rt;
import rt_lower;
import function_ir;
import function_ir_eval;
import runtime;

// Ch and Maj (§4.1.3), as the standard writes them. The generator reads
// `~x` as `all_ones ⊕ x` and a rotation as its shift pair
// (issues/rt-complement-and-rotate.md).
runtime fn sha512_ch(x, y, z: u64) → u64 { (x & y) ⊕ (~x & z) }

runtime fn sha512_maj(x, y, z: u64) → u64 { (x & y) ⊕ (x & z) ⊕ (y & z) }

// Σ0, Σ1, σ0, σ1 (§4.1.3).
runtime fn sha512_big0(x: u64) → u64 { x.rotr(28) ⊕ x.rotr(34) ⊕ x.rotr(39) }

runtime fn sha512_big1(x: u64) → u64 { x.rotr(14) ⊕ x.rotr(18) ⊕ x.rotr(41) }

runtime fn sha512_small0(x: u64) → u64 { x.rotr(1) ⊕ x.rotr(8) ⊕ (x >> 7) }

runtime fn sha512_small1(x: u64) → u64 { x.rotr(19) ⊕ x.rotr(61) ⊕ (x >> 6) }

// T1 = h + Σ1(e) + Ch(e, f, g) + K + W.
runtime fn sha512_t1(h, e, f, g, k, w: u64) → u64 { h + sha512_big1(e) + sha512_ch(e, f, g) + k + w }

// T2 = Σ0(a) + Maj(a, b, c).
runtime fn sha512_t2(a, b, c: u64) → u64 { sha512_big0(a) + sha512_maj(a, b, c) }

// W(t) = σ1(W(t−2)) + W(t−7) + σ0(W(t−15)) + W(t−16).
runtime fn sha512_next(w2, w7, w15, w16: u64) → u64 { sha512_small1(w2) + w7 + sha512_small0(w15) + w16 }

// ---------------------------------------------------------------------------
// Each is the specification's function.

theorem sha512_big0_spec(x: u64): sha512_big0(x) = Sha2::sha512().big0.big(x) { refl }
theorem sha512_big1_spec(x: u64): sha512_big1(x) = Sha2::sha512().big1.big(x) { refl }
theorem sha512_small0_spec(x: u64): sha512_small0(x) = Sha2::sha512().small0.small(x) { refl }
theorem sha512_small1_spec(x: u64): sha512_small1(x) = Sha2::sha512().small1.small(x) { refl }
theorem sha512_maj_spec(x, y, z: u64): sha512_maj(x, y, z) = x.maj(y, z) { refl }
theorem sha512_ch_spec(x, y, z: u64): sha512_ch(x, y, z) = x.ch(y, z) { refl }

theorem sha512_t1_spec(s: Sha2State(64), k, w: u64):
    sha512_t1(s.h, s.e, s.f, s.g, k, w) = Sha2::sha512().t1(s, k, w)
{ refl }

theorem sha512_t2_spec(s: Sha2State(64)): sha512_t2(s.a, s.b, s.c) = Sha2::sha512().t2(s) { refl }

// One round of the specification is the two compiled words and `turn`.
theorem sha512_round_spec(s: Sha2State(64), k, w: u64):
    Sha2::sha512().round(s, k, w) =
        s.turn(sha512_t1(s.h, s.e, s.f, s.g, k, w), sha512_t2(s.a, s.b, s.c))
{
    sym(trans(cong_fn(λ (t: u64) => s.turn(t, sha512_t2(s.a, s.b, s.c)), sha512_t1_spec(s, k, w)),
        cong_fn(λ (t: u64) => s.turn(Sha2::sha512().t1(s, k, w), t), sha512_t2_spec(s))))
}

// A schedule word is the compiled word of the four the window holds at
// those places, whatever the window holds past them.
theorem sha512_next_spec(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15: u64,
    rest: List<u64>):
    Sha2::sha512().next_word(
        Cons(a0, Cons(a1, Cons(a2, Cons(a3, Cons(a4, Cons(a5, Cons(a6, Cons(a7,
        Cons(a8, Cons(a9, Cons(a10, Cons(a11, Cons(a12, Cons(a13, Cons(a14, Cons(a15, rest))))))))))))))))) =
        sha512_next(a1, a6, a14, a15)
{
    refl
}

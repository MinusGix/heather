// A command-line argument copied into its buffer (issues/native-source-argv.md):
// what `Prog::args` does, as the claim of the code before it in terms of the
// claim after, as native_compile_calls does for a read.
//
// The command line is read through `Target::argv`, above the region, so
// the program's own stores keep it (`Target::kept_store`); RSP as the
// process started is in the slot past the scratch range (`Target::Stacking`).
// The count is compared with argc and, below it, the string copied a byte at
// a time up to its NUL, each byte stored while the count is below the
// buffer's capacity; its whole length is the word stored after. The entry's
// RSP save (`Prog::saves_rsp`) is here too, since it is what puts the
// command line in reach.
import native_source;
import native_compile;
import native_compile_facts;
import native_compile_region;
import native_compile_steps;
import native_compile_segments;
import native_compile_claims;
import native_compile_calls;
import native_compile_homes;
import native_alloc;
import linux_trees;
import linux_x86_64_io;
import linux_x86_64_byte_memory;
import linux_x86_64_sim;
import itree;
import x86_64;
import x86_64_block;
import x86_64_data_read;
import x86_64_fetched_code;
import x86_64_store;
import x86_64_byte_memory;
import x86_64_asm;
import x86_64_asm_runs;
import memory;
import bitvec;
import bitvec_nat;
import bool;
import list;
import logic;
import nat;
import option;
import omega;

// ---------------------------------------------------------------------------
// Lists and bytes

// A prefix's element is the list's, before the cut.
theorem List::take_nth<A>(self xs: List<A>): (n, k: Nat) → (c: A) → xs.take(n).nth(k) = Some(c) → (k < n) ∧ (xs.nth(k) = Some(c)) {
    match xs {
        Nil => λ n k c none => absurd(none),
        Cons(h, rest) => λ n => match n {
            Zero => λ k c none => absurd(none),
            Succ(m) => λ k => match k {
                Zero => λ c same => ⟨omega(), same⟩,
                Succ(l) => λ c got => rest.take_nth(m, l, c, got),
            },
        },
    }
}

theorem List::len_take_le<A>(self xs: List<A>): (n: Nat) → xs.take(n).len() <= n {
    match xs {
        Nil => λ n => {
            let none: (0 <= n) = omega();
            none
        },
        Cons(h, rest) => λ n => match n {
            Zero => Nat::le_refl(0),
            Succ(m) => rest.len_take_le(m),
        },
    }
}

// Bytes landed at a buffer's start: only as many as it holds land.
theorem fill_take(buffer: List<BitVec(8)>): (bytes: List<BitVec(8)>) → fill(buffer, bytes) = fill(buffer, bytes.take(buffer.len())) {
    match buffer {
        Nil => λ bytes => trans((bytes ++ Nil).take_zero(), sym((bytes.take(0) ++ Nil).take_zero())),
        Cons(x, rest) => λ bytes => match bytes {
            Nil => refl,
            Cons(y, ys) => List::cong_cons(y, fill_take(rest, ys)),
        },
    }
}

// TEST of a byte zero-extended with itself: ZF is set at NUL and clear
// otherwise.
theorem byte_tests_zero(byte: BitVec(8), zero: byte = BitVec::ofNat(0)):
    is_zero_bits(64, byte.zero_extend(56).band(byte.zero_extend(56))) = True {
    j(sym(zero), λ b _ => is_zero_bits(64, b.zero_extend(56).band(b.zero_extend(56))) = True, refl)
}

theorem byte_tests_nonzero(byte: BitVec(8), nonzero: Not(byte = BitVec::ofNat(0))):
    is_zero_bits(64, byte.zero_extend(56).band(byte.zero_extend(56))) = False {
    let value: (byte.zero_extend(56).toNat() = byte.toNat()) = BitVec::concat_zero_toNat(8, 56, byte);
    let positive: (0 < byte.toNat()) = match none: byte.toNat() {
        Zero => false_elim(nonzero(trans(sym(BitVec::ofNat_toNat(8, byte)), cong_fn<Nat, BitVec(8)>(λ n => BitVec::ofNat(n), none)))),
        Succ(_) => omega(),
    };
    test_self_nonzero(64, byte.zero_extend(56), j(sym(value), λ n _ => 0 < n, positive))
}

// ---------------------------------------------------------------------------
// The copy's invariant

// Where the copy has got to: the cells as they were (`v`) but the
// buffer's first `i`, each of those below the capacity the argument's
// byte; the command line kept, and the argument's string still at its
// pointer.
record ArgCells(t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat, m: X86Memory(t.r.profile)) {
    bytes: Nat → BitVec(8),
    holds: t.r.Holds(bytes, m),
    outside: (q: Nat) → ((q < t.layout().buffer_offset(buf)) ∨ (t.layout().buffer_offset(buf) + i <= q)) → bytes(q) = v(q),
    past: (q: Nat) → t.layout().buffer_offset(buf) + cap <= q → bytes(q) = v(q),
    copied: (k: Nat) → (c: BitVec(8)) → k < i → k < cap → arg.nth(k) = Some(c) → bytes(t.layout().buffer_offset(buf) + k) = c,
    stacking: t.Stacking(bytes, m),
    string: CStringAt(t.argv(), m, pointer, arg),
}

// The registers at the loop's head: R8 the count, R9 the capacity, RSI and
// RDI past the count in the string and the buffer; the home registers as
// they were (`vals`), the loop writing none.
record ArgRegs(t: Target, buf, cap: Nat, pointer: BitVec(64), i: Nat, vals: List<BitVec(64)>, g: Gprs) {
    count: read_gpr(R8, g) = word_of_nat(64, i),
    capacity: read_gpr(R9, g) = BitVec::ofNat(cap),
    source: read_gpr(Rsi, g) = word_of_nat(64, pointer.toNat() + i),
    dest: read_gpr(Rdi, g) = next_rip(t.r.low, t.layout().buffer_offset(buf) + i),
    homes: home_values(g) = vals,
}

record Target::ArgAt(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat,
    vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile)) {
    within: i <= arg.len(),
    regs: ArgRegs(t, buf, cap, pointer, i, vals, g),
    cells: ArgCells(t, v, buf, cap, arg, pointer, i, m),
}

// Past the byte's store (or its skip): the cells one further, the
// registers not yet stepped.
record ArgNext(t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat,
    vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile)) {
    below: i < arg.len(),
    regs: ArgRegs(t, buf, cap, pointer, i, vals, g),
    cells: ArgCells(t, v, buf, cap, arg, pointer, Succ(i), m),
}

// The start: nothing copied.
theorem Target::arg_cells_start(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64),
    m: X86Memory(t.r.profile), holds: t.r.Holds(v, m), stacking: t.Stacking(v, m), string: CStringAt(t.argv(), m, pointer, arg)):
    ArgCells(t, v, buf, cap, arg, pointer, 0, m) {
    ArgCells(bytes := v, holds := holds, outside := λ q _ => refl, past := λ q _ => refl, copied := λ k c early => false_elim(omega(early)),
        stacking := stacking, string := string)
}

// A byte stored below the capacity: one further.
theorem Target::arg_cells_store(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), arg: List<BitVec(8)>,
    pointer: BitVec(64), i: Nat, short: i < cap, m: X86Memory(t.r.profile), cells: ArgCells(t, v, buf, cap, arg, pointer, i, m),
    byte: BitVec(8), got: arg.nth(i) = Some(byte)):
    ArgCells(t, v, buf, cap, arg, pointer, Succ(i),
        t.r.profile.store(m, next_rip(t.r.low, t.layout().buffer_offset(buf) + i), [imm_byte0(byte.zero_extend(56))])) {
    let bo = t.layout().buffer_offset(buf);
    let w = cells.bytes;
    let one: List<BitVec(8)> = [imm_byte0(byte.zero_extend(56))];
    let ends = t.layout().buffer_end(buf, cap, found);
    let stack: (t.layout().stack_offset() = t.layout().scratch_offset() + (t.caps.largest() + 1)) = refl;
    let below: ((bo + i) + 1 <= t.layout().stack_offset()) = omega(ends, stack, short);
    let fits: ((bo + i) + 1 <= t.r.size) = omega(below, t.stack_fits());
    let w2 = t.r.buffer(w).set_span(bo + i, one.to_vector()).cells;
    let away = λ (q: Nat) (h: (q < bo + i) ∨ ((bo + i) + 1 <= q)) => t.r.cells_outside(w, bo + i, one, q, h);
    let back: (imm_byte0(byte.zero_extend(56)) = byte) = BitVec::truncate_zero_extend(8, 56, byte);
    let after = t.r.profile.store(m, next_rip(t.r.low, bo + i), one);
    ArgCells(bytes := w2, holds := t.r.store_holds(w, m, cells.holds, bo + i, one, fits),
        outside := λ q out => trans(away(q, match out {
                Inl(under) => Inl(omega(under)),
                Inr(over) => {
                    let past: ((bo + i) + 1 <= q) = omega(over);
                    Inr(past)
                },
            }), cells.outside(q, match out {
                Inl(under) => Inl(under),
                Inr(over) => {
                    let past: (bo + i <= q) = omega(over);
                    Inr(past)
                },
            })),
        past := λ q past => {
            let late: ((bo + i) + 1 <= q) = omega(past, short);
            trans(away(q, Inr(late)), cells.past(q, past))
         },
        copied := λ k c early capped got_k => match k.lt_or_ge(i) {
            Inl(before) => {
                let under: (bo + k < bo + i) = omega(before);
                trans(away(bo + k, Inl(under)), cells.copied(k, c, before, capped, got_k))
            },
            Inr(late) => {
                let here: (i = k) = omega(late, early);
                let same: (byte = c) = Option::some_inj(byte, c, trans(sym(got), j(sym(here), λ x _ => arg.nth(x) = Some(c), got_k)));
                j(here, λ x _ => w2(bo + x) = c, trans(t.r.cells_inside(w, bo + i, one, 0, imm_byte0(byte.zero_extend(56)), refl), trans(back, same)))
            },
         },
        stacking := t.stacking_store(w, m, bo + i, one, below, cells.stacking),
        string := cstring_at_kept(t.argv(), m, t.argv(), after, t.kept_store(m, bo + i, one, fits), pointer, arg,
            cells.string))
}

// A byte past the capacity is not stored: one further all the same.
theorem Target::arg_cells_skip(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat,
    over: cap <= i, m: X86Memory(t.r.profile), cells: ArgCells(t, v, buf, cap, arg, pointer, i, m)):
    ArgCells(t, v, buf, cap, arg, pointer, Succ(i), m) {
    let bo = t.layout().buffer_offset(buf);
    ArgCells(bytes := cells.bytes, holds := cells.holds,
        outside := λ q out => cells.outside(q, match out {
                Inl(under) => Inl(under),
                Inr(late) => {
                    let past: (bo + i <= q) = omega(late);
                    Inr(past)
                },
            }),
        past := cells.past,
        copied := λ k c early capped got => cells.copied(k, c, omega(capped, over), capped, got),
        stacking := cells.stacking, string := cells.string)
}

// Every byte copied: the environment placed with the argument filled in.
theorem Target::arg_cells_filled(self t: Target, env: Env, v: Nat → BitVec(8), keeps: t.layout().Keeps(env, v), same: env.args = t.args,
    buf, cap: Nat, found: t.caps.nth(buf) = Some(cap), arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat, all: i = arg.len(),
    m: X86Memory(t.r.profile), cells: ArgCells(t, v, buf, cap, arg, pointer, i, m)):
    t.Placed(env.set_buffer(buf, fill(env.buffer(buf), arg)), m) {
    let bo = t.layout().buffer_offset(buf);
    let w = cells.bytes;
    let bytes = arg.take(cap);
    let short: (bytes.len() <= cap) = arg.len_take_le(cap);
    let ends: ((bytes.len() = arg.len()) ∨ (bytes.len() = cap)) = match arg.len().lt_or_ge(cap) {
        Inl(under) => Inl(cong_fn<List<BitVec(8)>, Nat>(λ xs => xs.len(), arg.take_long(cap, Nat::le_of_lt(arg.len(), cap, under)))),
        Inr(over) => Inr(arg.len_take(cap, over)),
    };
    let kept = t.layout().keeps_fill(env, v, w, keeps, buf, cap, found, bytes, short,
        λ q out => match out {
            Inl(under) => cells.outside(q, Inl(under)),
            Inr(over) => match ends {
                Inl(whole) => cells.outside(q, Inr(omega(over, whole, all))),
                Inr(cut) => cells.past(q, omega(over, cut)),
            },
        },
        λ k c got => {
            let cut = arg.take_nth(cap, k, c, got);
            cells.copied(k, c, j(sym(all), λ x _ => k < x, arg.nth_some_below(k, c, cut.right)), cut.left, cut.right)
        });
    let len: (env.buffer(buf).len() = cap) = t.layout().keeps_buffer_len(env, v, keeps, buf, cap, found);
    let filled: (fill(env.buffer(buf), arg) = fill(env.buffer(buf), bytes)) = trans(fill_take(env.buffer(buf), arg),
        cong_fn<Nat, List<BitVec(8)>>(λ n => fill(env.buffer(buf), arg.take(n)), len));
    j(sym(filled), λ bs _ => t.Placed(env.set_buffer(buf, bs), m),
        Target::Placed(cells := w, holds := cells.holds, keeps := kept, stacked := Target::Stacked(same := same, stacking := cells.stacking)))
}

// ---------------------------------------------------------------------------
// The copy's steps

// The byte at the count: the argument's, not NUL, below its length; the NUL
// at it.
fn ArgByte(arg: List<BitVec(8)>, i: Nat, byte: BitVec(8)) → Type {
    ((i = arg.len()) ∧ (byte = BitVec::ofNat(0))) ∨ ((arg.nth(i) = Some(byte)) ∧ Not(byte = BitVec::ofNat(0)))
}

// The byte RSI points at, read below the canonical boundary.
theorem Target::arg_byte(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64),
    room: pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47), i: Nat, vals: List<BitVec(64)>, g: Gprs, m: X86Memory(t.r.profile),
    at: t.ArgAt(v, buf, cap, arg, pointer, i, vals, g, m)):
    Exists<BitVec(8)>(λ byte => (read_gpr(Rsi, g).toNat() < Nat::pow(2, 47)) ∧
        ((t.site().data.read(m, read_gpr(Rsi, g)) = Some(byte)) ∧ ArgByte(arg, i, byte))) {
    let a = word_of_nat(64, pointer.toNat() + i);
    let rsi: (read_gpr(Rsi, g) = a) = at.regs.source;
    let string = at.cells.string;
    let source = λ (k: Nat) => t.argv().read(m, word_of_nat(64, pointer.toNat() + k));
    let short: (pointer.toNat() + i < Nat::pow(2, 47)) = omega(room, at.within);
    let value: (a.toNat() = pointer.toNat() + i) = toNat_word_of_nat(64, pointer.toNat() + i,
        canonical_lt_word(pointer.toNat() + i, Nat::le_of_lt(pointer.toNat() + i, Nat::pow(2, 47), short)));
    let low: (a.toNat() < Nat::pow(2, 47)) = j(sym(value), λ n _ => n < Nat::pow(2, 47), short);
    let found: ((byte: BitVec(8)) → source(i) = Some(byte) → ArgByte(arg, i, byte) →
        Exists<BitVec(8)>(λ c => (read_gpr(Rsi, g).toNat() < Nat::pow(2, 47)) ∧
            ((t.site().data.read(m, read_gpr(Rsi, g)) = Some(c)) ∧ ArgByte(arg, i, c)))) = λ byte got which =>
        Exists(byte, ⟨j(sym(rsi), λ x _ => x.toNat() < Nat::pow(2, 47), low),
            ⟨j(sym(rsi), λ x _ => t.site().data.read(m, x) = Some(byte),
                t.r.profile.data().above_read(t.stack.low.toNat() + t.stack.size, m, a, byte, got).right), which⟩⟩);
    match i.lt_or_ge(arg.len()) {
        Inl(below) => {
            let present = arg.nth_present(i, below);
            let s = cstring_byte(arg, source, string, i, present.witness, present.proof);
            found(present.witness, s.left, Inr(⟨present.proof, s.right⟩))
        },
        Inr(over) => {
            let all: (i = arg.len()) = Nat::le_antisym(i, arg.len(), at.within, over);
            found(BitVec::ofNat(0), j(sym(all), λ k _ => source(k) = Some(BitVec::ofNat(0)), cstring_end(arg, source, string)), Inl(⟨all, refl⟩))
        },
    }
}

// CMP and its borrow, read as the counts' order.
theorem count_borrow(a, b: BitVec(64), i, cap: Nat, value: a.toNat() = i, bound: b.toNat() = cap):
    ((a.borrow_sub_bit(b) = True) → i < cap) ∧ ((a.borrow_sub_bit(b) = False) → cap <= i) {
    ⟨λ yes => j(bound, λ y _ => Succ(i) <= y, j(value, λ x _ => Succ(x) <= b.toNat(), BitVec::borrow_sub_of_bit_true(64, a, b, yes))),
     λ no => match i.lt_or_ge(cap) {
        Inl(under) => absurd(trans(sym(no), BitVec::borrow_sub_bit_of_borrow(64, a, b,
            j(sym(value), λ x _ => Succ(x) <= b.toNat(), j(sym(bound), λ y _ => Succ(i) <= y, under))))),
        Inr(over) => over,
     }⟩
}

// The adds: the count, RSI and RDI one further.
theorem Target::arg_step(self t: Target, v: Nat → BitVec(8), buf, cap: Nat, arg: List<BitVec(8)>, pointer: BitVec(64), i: Nat,
    vals: List<BitVec(64)>, s: MachineState<X86Memory(t.r.profile)>, next: ArgNext(t, v, buf, cap, arg, pointer, i, vals, s.gprs, s.memory)):
    t.ArgAt(v, buf, cap, arg, pointer, Succ(i), vals,
        execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))], s).gprs,
        execute_block_normal([AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))], s).memory) {
    let regs = next.regs;
    let one = λ (x: BitVec(64)) (y: BitVec(64)) (same: x = y) => cong_fn<BitVec(64), BitVec(64)>(λ z => z.add(BitVec::ofNat(1)), same);
    Target::ArgAt(within := next.below, cells := next.cells, regs := ArgRegs(
        count := trans(one(read_gpr(R8, s.gprs), word_of_nat(64, i), regs.count), sym(word_of_nat_succ(i))),
        capacity := regs.capacity,
        source := trans(one(read_gpr(Rsi, s.gprs), word_of_nat(64, pointer.toNat() + i), regs.source), sym(word_of_nat_succ(pointer.toNat() + i))),
        dest := trans(one(read_gpr(Rdi, s.gprs), next_rip(t.r.low, t.layout().buffer_offset(buf) + i), regs.dest),
            sym(next_rip_succ(t.r.low, t.layout().buffer_offset(buf) + i))),
        homes := regs.homes))
}

// A round of the copy from `i` bytes copied: at the NUL every byte is
// copied and the loop is left; before it the byte is stored where the count
// is below the capacity, and the copy is one further.
theorem Run::arg_round(self r: Run, loops: Nat → Nat → Gprs → X86Memory(r.t.r.profile) → Type, v: Nat → BitVec(8), buf, cap: Nat,
    found: r.t.caps.nth(buf) = Some(cap), arg: List<BitVec(8)>, pointer: BitVec(64), room: pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47),
    vals: List<BitVec(64)>, o: Nat, leave, again: r.State() → Type, s: r.State(), resident: r.t.site().Resident(s.memory), i: Nat,
    at: r.t.ArgAt(v, buf, cap, arg, pointer, i, vals, s.gprs, s.memory),
    fin: (g: Gprs) → (f: Flags) → (rip: BitVec(64)) → r.t.ArgAt(v, buf, cap, arg, pointer, arg.len(), vals, g, s.memory) → leave(MachineState(g, f, rip, s.memory)),
    step: i < arg.len() → (u: r.State()) → r.t.ArgAt(v, buf, cap, arg, pointer, Succ(i), vals, u.gprs, u.memory) → again(u)):
    r.cx().from(Succ(o)).arg_byte(Label(Succ(o))).cut().code.inside(r, loops, Some(o), leave, again)(s) {
    let t = r.t;
    let g = s.gprs;
    let m = s.memory;
    let bo = t.layout().buffer_offset(buf);
    let regs = at.regs;
    let b = t.arg_byte(v, buf, cap, arg, pointer, room, i, vals, g, m, at);
    let byte = b.witness;
    let adds: List<Instruction> = [AddRI8(Rsi, BitVec::ofNat(1)), AddRI8(Rdi, BitVec::ofNat(1)), AddRI8(R8, BitVec::ofNat(1))];
    let tested = execute_block_normal([TestRR(Rdx, Rdx)], byte_load_after(ByteLoad(Rdx, Rsi), byte, s));
    LoadsByte(byte := byte, low := b.proof.left, read := b.proof.right.left, after := Leaves(out := refl,
        // At the NUL every byte is copied.
        taken := λ nul rip => match b.proof.right.right {
            Inl(end) => fin(tested.gprs, tested.flags, rip, j(end.left, λ n _ => t.ArgAt(v, buf, cap, arg, pointer, n, vals, g, m), at)),
            Inr(more) => absurd(trans(sym(nul), byte_tests_nonzero(byte, more.right))),
        },
        straight := λ not_nul rip => match b.proof.right.right {
            Inl(end) => absurd(trans(sym(not_nul), byte_tests_zero(byte, end.right))),
            Inr(more) => {
                let below: (i < arg.len()) = arg.nth_some_below(i, byte, more.left);
                let small: (i < Nat::pow(2, 64)) = canonical_lt_word(i, omega(room, below));
                let bit = read_gpr(R8, g).borrow_sub_bit(read_gpr(R9, g));
                let order = count_borrow(read_gpr(R8, g), read_gpr(R9, g), i, cap,
                    trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), regs.count), toNat_word_of_nat(64, i, small)),
                    trans(cong_fn<BitVec(64), Nat>(λ y => y.toNat(), regs.capacity), BitVec::toNat_ofNat(64, cap, t.cap_small(buf, cap, found))));
                let compared = execute_block_normal([CmpRR(R8, R9)], MachineState(tested.gprs, tested.flags, rip, m));
                Branches(
                    // At or past the capacity the byte is not stored.
                    taken := λ over rip2 => {
                        let skipped = MachineState(compared.gprs, compared.flags, rip2, m);
                        step(below, execute_block_normal(adds, skipped), t.arg_step(v, buf, cap, arg, pointer, i, vals, skipped,
                            ArgNext(below := below, regs := regs,
                                cells := t.arg_cells_skip(v, buf, cap, arg, pointer, i, order.right(Bool::clear_of_not(bit, !bit, refl, over)), m, at.cells))))
                    },
                    // Below it the byte is stored at RDI.
                    straight := λ under rip2 => {
                        let short: (i < cap) = order.left(Bool::set_of_not(bit, !bit, refl, under));
                        let fits: ((bo + i) + 1 <= t.r.size) = omega(t.layout().buffer_end(buf, cap, found), short, t.scratch_fits());
                        let one: List<BitVec(8)> = [imm_byte0(byte.zero_extend(56))];
                        let stored = byte_store_after(t.writes(), ByteStore(Rdi, Rdx), MachineState(compared.gprs, compared.flags, rip2, m));
                        let goal = λ (a: BitVec(64)) => t.writes().writable(m, a, 1) ∧
                            (t.site().Resident(t.r.profile.store(m, a, one)) ∧ ArgNext(t, v, buf, cap, arg, pointer, i, vals, g, t.r.profile.store(m, a, one)));
                        let here: goal(next_rip(t.r.low, bo + i)) = ⟨t.writable(m, bo + i, 1, fits), ⟨t.store_resident(m, bo + i, one, fits, resident),
                            ArgNext(below := below, regs := regs, cells := t.arg_cells_store(v, buf, cap, found, arg, pointer, i, short, m, at.cells, byte, more.left))⟩⟩;
                        let there = j(sym(regs.dest), λ a _ => goal(a), here);
                        StoresByte(plain := refl, writable := there.left, resident := there.right.left,
                            after := step(below, execute_block_normal(adds, stored), t.arg_step(v, buf, cap, arg, pointer, i, vals, stored, there.right.right)))
                    },
                    defined := refl)
            },
        }, defined := refl))
}

// ---------------------------------------------------------------------------
// The count and the pointer

// The command line read above the region is read alike by the machine.
theorem Target::argv_reads(self t: Target, m: X86Memory(t.r.profile)): ReadsKept(t.argv(), m, t.r.profile.data(), m) {
    λ a byte got => t.r.profile.data().above_read(t.stack.low.toNat() + t.stack.size, m, a, byte, got).right
}

// The saved RSP, read at its slot.
theorem Target::read_stack(self t: Target, v: Nat → BitVec(8), m: X86Memory(t.r.profile), holds: t.r.Holds(v, m)):
    (t.layout().stack_at().toNat() + 8 <= Nat::pow(2, 47)) ∧
    (read_word(t.r.profile.data(), m, t.layout().stack_at()) = Some(word_in(v, t.layout().stack_offset()))) {
    let q = t.layout().stack_offset();
    let fits = t.stack_fits();
    let base = next_rip(t.r.low, q);
    let o = λ (k: Nat) => t.r.profile.read(m, next_rip(base, k));
    let g = λ (k: Nat) => t.r.buffer(v).get(q + k);
    let b = λ (k: Nat) (short: k < 8) => t.r.buffer_read(v, m, holds, q, k, Nat::le_trans(Succ(q + k), q + 8, t.r.size, q.add_le_mono_l(Succ(k), 8, short), fits));
    let read: (read_word(t.r.profile.data(), m, base) = Some(word_in(v, q))) =
        word_of_eight(o(0), o(1), o(2), o(3), o(4), o(5), o(6), o(7), g(0), g(1), g(2), g(3), g(4), g(5), g(6), g(7),
            b(0, trivial), b(1, trivial), b(2, trivial), b(3, trivial), b(4, trivial), b(5, trivial), b(6, trivial), b(7, trivial));
    let value = t.r.toNat_at(q, q.le_of_add_le(8, t.r.size, fits));
    let low = t.r.low.toNat();
    let ends: (low + (q + 8) <= Nat::pow(2, 47)) = Nat::le_trans(low + (q + 8), low + t.r.size, Nat::pow(2, 47),
        low.add_le_mono_l(q + 8, t.r.size, fits), t.r.canonical);
    j(sym(t.at_rip(q)), λ a _ => (a.toNat() + 8 <= Nat::pow(2, 47)) ∧ (read_word(t.r.profile.data(), m, a) = Some(word_in(v, q))),
        ⟨j(sym(value), λ x _ => x + 8 <= Nat::pow(2, 47), j(sym(low.add_assoc(q, 8)), λ x _ => x <= Nat::pow(2, 47), ends)), read⟩)
}

// RBX doubled three times, plus RSP and eight: argument `k`'s slot.
theorem argv_slot_sum(a, r: BitVec(64), k: Nat, value: a.toNat() = k):
    a.add(a).add(a.add(a)).add(a.add(a).add(a.add(a))).add(r).add(BitVec::ofNat(8)) = argv_slot(r, 1 + k) {
    let rn = r.toNat();
    let a1: (a = BitVec::ofNat(k)) = trans(sym(BitVec::ofNat_toNat(64, a)), BitVec::ofNat_cong(64, value));
    let a2 = BitVec::ofNat_add_of(64, a1, a1);
    let a4 = BitVec::ofNat_add_of(64, a2, a2);
    let a8 = BitVec::ofNat_add_of(64, a4, a4);
    let s1 = BitVec::ofNat_add_of(64, a8, sym(BitVec::ofNat_toNat(64, r)));
    let eight: (BitVec::ofNat(8, n := 64) = BitVec::ofNat(8)) = refl;
    let s2 = BitVec::ofNat_add_of(64, s1, eight);
    let same: ((((k + k) + (k + k)) + ((k + k) + (k + k)) + rn) + 8 = rn + 8 * (1 + k)) = omega();
    trans(s2, trans(BitVec::ofNat_cong(64, same), sym(word_of_nat_eq_ofNat(64, rn + 8 * (1 + k)))))
}

// The copy with `n` bytes to go: argument `k`'s, its string at a pointer
// whose bytes end below the canonical boundary, `done` of them copied.
record ArgLeft(t: Target, v: Nat → BitVec(8), buf, cap, k: Nat, vals: List<BitVec(64)>, n: Nat, g: Gprs, m: X86Memory(t.r.profile)) {
    arg: List<BitVec(8)>,
    pointer: BitVec(64),
    done: Nat,
    present: t.args.nth(k) = Some(arg),
    room: pointer.toNat() + arg.len() + 1 <= Nat::pow(2, 47),
    left: done + n = arg.len(),
    at: t.ArgAt(v, buf, cap, arg, pointer, done, vals, g, m),
}

// Where the two ways meet: RAX is what `len` is to hold, in an environment
// (as it was, or with the buffer filled) that gives the statement's once
// it is stored.
fn Target::ArgKept(self t: Target, live: List<Nat>, env: Env, index, buf, len: Nat, s: MachineState<X86Memory(t.r.profile)>) → Type {
    Exists<Env>(λ before => t.Held(live, before, s.gprs, s.memory) ∧ (before.set_word(len, read_gpr(Rax, s.gprs)) = env.arg(env.number(index), buf, len)))
}

theorem Env::arg_missing(self env: Env, k, buf, len: Nat, none: env.args.nth(k) = None): env.arg(k, buf, len) = env.set_word(len, missing_word()) {
    j(sym(none), λ o _ => (match o as λ _ => Env {
            None => env.set_word(len, missing_word()),
            Some(arg) => env.set_buffer(buf, fill(env.buffer(buf), arg)).set_word(len, count_word(arg.len())),
        }) = env.set_word(len, missing_word()), refl)
}

theorem Env::arg_present(self env: Env, k, buf, len: Nat, arg: List<BitVec(8)>, got: env.args.nth(k) = Some(arg)):
    env.arg(k, buf, len) = env.set_buffer(buf, fill(env.buffer(buf), arg)).set_word(len, count_word(arg.len())) {
    j(sym(got), λ o _ => (match o as λ _ => Env {
            None => env.set_word(len, missing_word()),
            Some(a) => env.set_buffer(buf, fill(env.buffer(buf), a)).set_word(len, count_word(a.len())),
        }) = env.set_buffer(buf, fill(env.buffer(buf), arg)).set_word(len, count_word(arg.len())), refl)
}

// Below argc: the argument's pointer is loaded from its slot, its bytes are
// copied, and RAX is its length.
theorem Target::arg_found(self t: Target, live, out: List<Nat>, env: Env, index, buf, len, cap, names: Nat, found: t.caps.nth(buf) = Some(cap),
    words: List<Nat>, vals: List<BitVec(64)>, agrees: t.Agreeing(live, env, words, vals),
    v: Nat → BitVec(8), keeps: t.layout().Keeps(env.with_words(words), v), same: env.args = t.args,
    u: MachineState<X86Memory(t.r.profile)>, holds: t.r.Holds(v, u.memory), stacking: t.Stacking(v, u.memory),
    rdx: read_gpr(Rdx, u.gprs) = word_in(v, t.layout().stack_offset()), rcx: read_gpr(Rcx, u.gprs).toNat() = env.number(index),
    under: env.number(index) < t.args.len(), homes: home_values(u.gprs) = vals):
    Emission(t.layout(), [], out).from(names + 2).arg_string(buf, cap).cut().code.inside(Run(t, [], out, live, env),
        λ _ => ArgLeft(t, v, buf, cap, env.number(index), vals), None, λ _ => False,
        λ x => (to: BitVec(64)) → t.ArgKept(live, env, index, buf, len, MachineState(x.gprs, x.flags, to, x.memory)))(u) {
    let layout = t.layout();
    let r = Run(t, [], out, live, env);
    let m = u.memory;
    let k = env.number(index);
    let rsp = word_in(v, layout.stack_offset());
    let present = t.args.nth_present(k, under);
    let arg = present.witness;
    let entry = argv_from_nth(t.argv(), m, rsp, t.args, 1, k, arg, present.proof, stacking.argv.right.right);
    let pointer = entry.witness;
    let slot_word = word_bytes_at_read(t.r.profile.data(), m, argv_slot(rsp, 1 + k), pointer,
        word_bytes_at_kept(t.argv(), m, t.r.profile.data(), m, t.argv_reads(m), argv_slot(rsp, 1 + k), pointer, entry.proof.left));
    let slots: List<Instruction> = [MovRR(Rbx, Rcx), AddRR(Rbx, Rbx), AddRR(Rbx, Rbx), AddRR(Rbx, Rbx), AddRR(Rbx, Rdx), AddRI8(Rbx, BitVec::ofNat(8))];
    let address: (read_gpr(Rbx, execute_block_normal(slots, u).gprs) = argv_slot(rsp, 1 + k)) = trans(
        argv_slot_sum(read_gpr(Rcx, u.gprs), read_gpr(Rdx, u.gprs), k, rcx), cong_fn<BitVec(64), BitVec(64)>(λ y => argv_slot(y, 1 + k), rdx));
    let done: r.State() → Type = λ x => (to: BitVec(64)) → t.ArgKept(live, env, index, buf, len,
        MachineState(execute_block_normal([MovRR(Rax, R8)], x).gprs, execute_block_normal([MovRR(Rax, R8)], x).flags, to, execute_block_normal([MovRR(Rax, R8)], x).memory));
    // A round: at the NUL the buffer is filled and RAX gets the length.
    let round: (n: Nat) → (w: r.State()) → t.site().Resident(w.memory) → ArgLeft(t, v, buf, cap, k, vals, n, w.gprs, w.memory) →
        r.cx().from(names + 4).arg_byte(Label(names + 4)).cut().code.inside(r, λ _ => ArgLeft(t, v, buf, cap, k, vals), Some(names + 3), done,
            λ x => Exists<Nat>(λ fewer => (fewer < n) ∧ ArgLeft(t, v, buf, cap, k, vals, fewer, x.gprs, x.memory)))(w) = λ n w resident left => {
        let a = left.arg;
        let filled = env.set_buffer(buf, fill(env.buffer(buf), a));
        let got: (env.args.nth(k) = Some(a)) = j(sym(same), λ xs _ => xs.nth(k) = Some(a), left.present);
        let again: r.State() → Type = λ x => Exists<Nat>(λ fewer => (fewer < n) ∧ ArgLeft(t, v, buf, cap, k, vals, fewer, x.gprs, x.memory));
        r.arg_round(λ _ => ArgLeft(t, v, buf, cap, k, vals), v, buf, cap, found, a, left.pointer, left.room, vals, names + 3, done, again, w, resident, left.done, left.at,
            λ g f rip all to => Exists(filled, ⟨Target::Held(words := words, placed := t.arg_cells_filled(env.with_words(words), v, keeps, same, buf, cap, found, a, left.pointer, a.len(), refl, w.memory, all.cells),
                    agreeing := j(sym(all.regs.homes), λ vs _ => t.Agreeing(live, filled, words, vs), Target::Agreeing(homes := agrees.homes, frame := agrees.frame, pins := agrees.pins))),
                trans(cong_fn<BitVec(64), Env>(λ y => filled.set_word(len, y), trans(all.regs.count, word_of_nat_eq_ofNat(64, a.len()))),
                    sym(env.arg_present(k, buf, len, a, got)))⟩),
            λ below x next => {
                let fewer = Nat::one_fewer(left.done, n, a.len(), left.left, below);
                Exists(fewer.witness, ⟨fewer.proof.left,
                    ArgLeft(arg := a, pointer := left.pointer, done := Succ(left.done), present := left.present, room := left.room, left := fewer.proof.right, at := next)⟩)
            })
    };
    // The start: the pointer loaded, nothing copied.
    let start: (0 + arg.len() = arg.len()) = omega();
    let cells = t.arg_cells_start(v, buf, cap, arg, pointer, m, holds, stacking, entry.proof.right.right);
    LoadsWord(word := pointer, low := j(sym(address), λ y _ => y.toNat() + 8 <= Nat::pow(2, 47), slot_word.left),
        read := j(sym(address), λ y _ => read_word(t.site().data, m, y) = Some(pointer), slot_word.right),
        after := Loops(round := round, entered := Exists(arg.len(),
            ArgLeft(arg := arg, pointer := pointer, done := 0, present := present.proof, room := entry.proof.right.left, left := start,
                at := Target::ArgAt(within := Nat::le_of_lt(0, Succ(arg.len()), omega()), cells := cells,
                    regs := ArgRegs(count := refl, capacity := refl, source := sym(word_of_nat_toNat(64, pointer)), dest := t.buffer_rip(buf), homes := homes))))))
}

// From the statement's start: the saved RSP and argc loaded, the index
// compared with argc; at or past it, minus one in the environment as it
// was; below it, the argument copied and its length. Either way the word
// is then stored.
theorem Target::goes_args(self t: Target, live, out: List<Nat>, env: Env, p: Prog, index, buf, len, cap, names: Nat,
    in_index: t.layout().word_fits(index).IsTrue(), in_len: t.layout().word_fits(len).IsTrue(), holds: Mem(index, live),
    sub: (i: Nat) → Mem(i, out) → i ≠ len → Mem(i, live), apart: t.homes.apart(len, out).IsTrue(), found: t.caps.nth(buf) = Some(cap),
    within: p.args(t.layout(), out, index, buf, len, cap, names).prog.Within(t.program), tree: ITree<BitVec(64)>(Events::linux()),
    next: t.At(prog_len(p.args(t.layout(), out, index, buf, len, cap, names).prog), out, tree, env.arg(env.number(index), buf, len))):
    t.At(prog_len(p), live, tree, env) {
    let layout = t.layout();
    let r = Run(t, [], out, live, env);
    let k = env.number(index);
    let argc = t.args.len();
    let code = r.cx().from(names).arg_copy(index, buf, cap).cut().code;
    let copied = code.onto(r.cx(), p);
    let w_copied = copied.word_from_within(layout, out, len, Rax, t.program, within);
    let kept: r.State() → Type = λ x => t.ArgKept(live, env, index, buf, len, x);
    let stored: t.Goes(prog_len(copied), tree, kept) = λ x here resident held =>
        t.goes_result(live, out, held.witness, env.arg(k, buf, len), copied, len, in_len, sub, apart, within, tree, next)(x, here, resident, held.proof);
    λ s here resident held => {
        let words = held.words;
        let v = held.placed.cells;
        let m = s.memory;
        let placed = held.placed;
        let same: (env.args = t.args) = placed.stacked.same;
        let stacking = placed.stacked.stacking;
        let rsp = word_in(v, layout.stack_offset());
        let stack = t.read_stack(v, m, placed.holds);
        let argc_word = word_bytes_at_read(t.r.profile.data(), m, rsp, word_of_nat(64, argc),
            word_bytes_at_kept(t.argv(), m, t.r.profile.data(), m, t.argv_reads(m), rsp, word_of_nat(64, argc), stacking.argv.right.left));
        let k_value: (env.word(index).toNat() = k) = t.held_number(live, env, s.gprs, m, held, index, holds, in_index);
        let bit = env.word(index).borrow_sub_bit(word_of_nat(64, argc));
        let order = count_borrow(env.word(index), word_of_nat(64, argc), k, argc, k_value,
            toNat_word_of_nat(64, argc, omega(stacking.argv.left, canonical_below_top())));
        let loaded = word_load_after(WordLoad(R9, Rdx), word_of_nat(64, argc),
            word_load_after(WordLoad(Rdx, Rbx), rsp, execute_block_normal([MovRI(Rbx, layout.stack_at())], s)));
        code.goes_with(r, λ _ => ArgLeft(t, v, buf, cap, k, home_values(s.gprs)), p, w_copied, tree, kept, stored)(s, here, resident,
            LoadsWord(word := rsp, low := stack.left, read := stack.right, after :=
            LoadsWord(word := word_of_nat(64, argc), low := argc_word.left, read := argc_word.right, after :=
            Fetches(fits := in_index, reads := holds, held := held, after := λ f rip => {
                    let compared = execute_block_normal([CmpRR(Rcx, R9)],
                        MachineState(write_gpr(Rcx, env.word(index), write_gpr(Rbx, t.rbx_known([], env, index), loaded.gprs)), f, rip, m));
                    Branches(
                        // At or past argc: minus one, the environment as it was.
                        taken := λ past rip2 => {
                            let none: (env.args.nth(k) = None) = j(sym(same), λ xs _ => xs.nth(k) = None,
                                t.args.nth_past_end(k, order.right(Bool::clear_of_not(bit, !bit, refl, past))));
                            Exists(env, ⟨held, sym(env.arg_missing(k, buf, len, none))⟩)
                        },
                        // Below it: the argument copied.
                        straight := λ below rip2 => t.arg_found(live, out, env, index, buf, len, cap, names, found, words, home_values(s.gprs), held.agreeing,
                            v, placed.keeps, same, MachineState(compared.gprs, compared.flags, rip2, m), placed.holds, stacking, refl, k_value,
                            order.left(Bool::set_of_not(bit, !bit, refl, below)), refl),
                        defined := refl)
                }))))
    }
}

// Loops in the default setup's lowering: a function that calls itself only
// in tail position is one FunctionIR `Loop`, and its soundness is proved
// once (docs/native/runtime-fn-setups-design.md §7.4, §16.10;
// issues/runtime-fn-default-setup.md).
//
// Two recursions are loops:
//
// - **Fuel.** `h(fuel: Nat, x…)` whose body matches its fuel at the top
//   (`Case`), the `Succ` arm recursing on the predecessor. The fuel arrives
//   as a word `b` with `b.toNat()` the fuel (a `Count`), the loop runs at
//   most `b` passes, each the `Succ` arm with its recursion going round, and
//   when the passes run out the `Zero` arm answers. The proof needs no fact
//   about `h` beyond the two equations of its structural recursion, which
//   hold by conversion (`Fun::FuelEqs`).
// - **Measured.** A function that `decreases` a measure `m` below `2^64`
//   (a word's `toNat`): a loop of up to `2^64 - 1` passes, the step the body
//   as written. The passes cannot run out first, since each lowers the
//   measure. What the proof needs about the function is `Fun::Guarded`: the
//   body, its recursion answered by anything that agrees with the function
//   below the measure, is the function. The generator proves it from the
//   function's own `f::ext` and `f::irrel` (docs/decreases-unfolding-
//   design.md), never by hand.
//
// A pass is the body lowered in **tail mode** (`Tm::lower_tail`): every
// leaf either goes round, moving the call's arguments to the loop's `next`
// ports with the flag word 0, or leaves, moving its value to the first of
// them with the flag 1. `Tm::tail_sound` says what a pass computes, for any
// continuation `again`: `Tm::tail_sem`, the body with each self-call
// answered by `again`. The two loop theorems feed it the continuation
// `loop_eval_agrees`/`loop_eval_agrees_measured` hand them.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import rt;
import function_ir::{Compose};
import function_ir_eval;
import function_ir_compile;
import rt_lower;
import dec_set;
import set_tactic;
import relation;
import relation_props;

// ---------------------------------------------------------------------------
// The tail meaning.

// Variables read as 64-bit words.
fn Tm::words(w: World, g: List<Ty>, env: Env(w.tys, g), vs: List<Nat>) → List<BitVec(64)> {
    match vs {
        Nil => Nil,
        Cons(v, rest) => Cons(Ty::cast(w.tys, Ty::at(g, v), Word(64), Env::get(w.tys, g, env, v)), Tm::words(w, g, env, rest)),
    }
}

// A term's value read at the loop's result code `res`.
fn Tm::leaf(self t: Tm, w: World, res: Ty, g: List<Ty>, env: Env(w.tys, g)) → res.sem(w.tys) {
    Ty::cast(w.tys, t.ty(w, g), res, t.sem(w, g, env))
}

// A loop step's meaning, at the function's result code `res` (a word, or a
// type held by its repr in one, design §16.13): `t` with each call of the
// function itself (entry 0) answered by `again` on its arguments past the
// first `skip` (a fuel recursion's first is the fuel, which the loop counts
// itself), the arguments read as the words a call passes, and every other
// result read at `res`. At a closed term it unfolds as `Tm::sem` does, so a
// step's equation with the function's body is a conversion; the result is
// read as a word only outside it (`Tm::TailHolds`), since reading it inside
// would put the repr's `emb` under each branch, where the body has it
// outside the match.
fn Tm::tail_sem(self t: Tm, w: World, skip: Nat, res: Ty, again: List<BitVec(64)> → res.sem(w.tys)) → (g: List<Ty>) → Env(w.tys, g) → res.sem(w.tys) {
    match t {
        Var(i) => λ g env => Tm::leaf(Var(i), w, res, g, env),
        Lit(c, n) => λ g env => Tm::leaf(Lit(c, n), w, res, g, env),
        Prim(op, args) => λ g env => Tm::leaf(Prim(op, args), w, res, g, env),
        Let(e, body) => λ g env => body.tail_sem(w, skip, res, again, Cons(e.ty(w, g), g), Pair(e.sem(w, g, env), env)),
        If(c, yes, no) => λ g env => match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)) {
            False => no.tail_sem(w, skip, res, again, g, env),
            True => yes.tail_sem(w, skip, res, again, g, env),
        },
        IfEq(c, yes, no) => λ g env => Tm::convoy(res.sem(w.tys), Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)),
            yes.tail_sem(w, skip, res, again, g, env), no.tail_sem(w, skip, res, again, g, env)),
        Make(i, args) => λ g env => Tm::leaf(Make(i, args), w, res, g, env),
        Field(i, k, of) => λ g env => Tm::leaf(Field(i, k, of), w, res, g, env),
        Call(f, args) => match f {
            Zero => λ g env => again(Tm::words(w, g, env, args.drop(skip))),
            Succ(h) => λ g env => Tm::leaf(Call(h + 1, args), w, res, g, env),
        },
        Fold(over, init, step) => λ g env => Tm::leaf(Fold(over, init, step), w, res, g, env),
        Case(c, zero, succ) => λ g env => Tm::leaf(Case(c, zero, succ), w, res, g, env),
        Byte(k, i, length) => λ g env => Tm::leaf(Byte(k, i, length), w, res, g, env),
    }
}

// A step's meaning reads its recursion only at the calls it makes: two
// recursions that answer alike give one meaning.
theorem Tm::tail_sem_ext(self t: Tm, w: World, skip: Nat, res: Ty, k1, k2: List<BitVec(64)> → res.sem(w.tys),
    same: (ys: List<BitVec(64)>) → k1(ys) = k2(ys)): (g: List<Ty>) → (env: Env(w.tys, g)) →
    t.tail_sem(w, skip, res, k1, g, env) = t.tail_sem(w, skip, res, k2, g, env) {
    match t {
        Var(_) => λ g env => refl,
        Lit(_, _) => λ g env => refl,
        Prim(_, _) => λ g env => refl,
        Make(_, _) => λ g env => refl,
        Field(_, _, _) => λ g env => refl,
        Fold(_, _, _) => λ g env => refl,
        Case(_, _, _) => λ g env => refl,
        Byte(_, _, _) => λ g env => refl,
        Call(f, args) => match f as λ f2 => (g: List<Ty>) → (env: Env(w.tys, g)) →
            Tm::tail_sem(Call(f2, args), w, skip, res, k1, g, env) = Tm::tail_sem(Call(f2, args), w, skip, res, k2, g, env) {
            Zero => λ g env => same(Tm::words(w, g, env, args.drop(skip))),
            Succ(_) => λ g env => refl,
        },
        Let(e, body) => λ g env => Tm::tail_sem_ext(body, w, skip, res, k1, k2, same, Cons(Tm::ty(e, w, g), g), Pair(Tm::sem(e, w, g, env), env)),
        If(c, yes, no) => λ g env => match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)) as λ bit =>
            (match bit { False => no.tail_sem(w, skip, res, k1, g, env), True => yes.tail_sem(w, skip, res, k1, g, env) }) =
                (match bit { False => no.tail_sem(w, skip, res, k2, g, env), True => yes.tail_sem(w, skip, res, k2, g, env) }) {
            False => Tm::tail_sem_ext(no, w, skip, res, k1, k2, same, g, env),
            True => Tm::tail_sem_ext(yes, w, skip, res, k1, k2, same, g, env),
        },
        IfEq(c, yes, no) => λ g env => eq2(λ (y: res.sem(w.tys)) (n: res.sem(w.tys)) =>
                Tm::convoy(res.sem(w.tys), Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)), y, n),
            Tm::tail_sem_ext(yes, w, skip, res, k1, k2, same, g, env), Tm::tail_sem_ext(no, w, skip, res, k1, k2, same, g, env)),
    }
}

// A value at `res` read as a word, and a word read at `res`: what a pass
// leaves for the loop, and what the loop's continuation is read at.
fn Tm::out(tys: Nat → RecInfo, res: Ty, v: res.sem(tys)) → BitVec(64) { Ty::cast(tys, res, Word(64), v) }

fn Tm::into(tys: Nat → RecInfo, res: Ty, x: BitVec(64)) → res.sem(tys) { Ty::cast(tys, Word(64), res, x) }

// A code held in one word: a word read at it and back is the word (the
// repr's round trip, `emb(abs(x)) = x`).
theorem Tm::out_into(tys: Nat → RecInfo, res: Ty, er: res.OneWord(tys), x: BitVec(64)): Tm::out(tys, res, Tm::into(tys, res, x)) = x {
    match res as λ t => t.OneWord(tys) → Tm::out(tys, t, Tm::into(tys, t, x)) = x {
        Word(n) => λ (e: n = 64) => j(sym(e), λ m _ => Tm::out(tys, Word(m), Tm::into(tys, Word(m), x)) = x,
            trans(Ty::cast_self(tys, Word(64), Ty::cast(tys, Word(64), Word(64), x)), Ty::cast_self(tys, Word(64), x))),
        Bit => λ never => false_elim(never),
        Bytes(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e => j(sym(e), λ fs _ => (mk: Ty::Flats(fs) → tys(i).T) → (get: tys(i).T → Ty::Flats(fs)) →
                ((t: Ty::Flats(fs)) → get(mk(t)) = t) → Ty::flats_head_word(fs, get(mk(Ty::flats_word(fs, x)))) = x,
            λ mk get round => cong_fn(λ (t: Ty::Flats([Word(64)])) => Ty::flats_head_word([Word(64)], t), round(Ty::flats_word([Word(64)], x))))(
            tys(i).mk, tys(i).get, tys(i).round),
        Count => λ never => false_elim(never),
    }(er)
}

// Read along an equation of codes, then as a word: the value read as a word.
theorem Tm::out_cast(tys: Nat → RecInfo, a, res: Ty, e: a = res, v: a.sem(tys)): Tm::out(tys, res, Ty::cast(tys, a, res, v)) = Ty::cast(tys, a, Word(64), v) {
    j(e, λ b _ => Tm::out(tys, b, Ty::cast(tys, a, b, v)) = Ty::cast(tys, a, Word(64), v),
        cong_fn(λ (u: a.sem(tys)) => Ty::cast(tys, a, Word(64), u), Ty::cast_self(tys, a, v)))
}

// A match read as a word is its arms read so.
theorem Tm::out_match(tys: Nat → RecInfo, res: Ty, b: Bool, yes, no: res.sem(tys)):
    (match b { False => Tm::out(tys, res, no), True => Tm::out(tys, res, yes) }) = Tm::out(tys, res, match b { False => no, True => yes }) {
    match b as λ c => (match c { False => Tm::out(tys, res, no), True => Tm::out(tys, res, yes) }) =
        Tm::out(tys, res, match c { False => no, True => yes }) {
        False => refl,
        True => refl,
    }
}

// ---------------------------------------------------------------------------
// Tail mode: a pass writes the flag word (1 to leave, 0 to go round) and the
// next state's moved words at `nexts`; leaving, the first of them is the
// result. The words of `kept` it hands on where they are.

theorem Tm::eq3<A, B, C, D>(g: A → B → C → D, {a, a2: A}, {b, b2: B}, {c, c2: C}, p: a = a2, q: b = b2, s: c = c2): g(a, b, c) = g(a2, b2, c2) {
    trans(eq2(λ (x: A) (y: B) => g(x, y, c), p, q), cong_fn(λ (z: C) => g(a2, b2, z), s))
}

// What a pass leaves for the loop: the result where the flag is 1, the
// continuation on the next state otherwise. The next state is the words
// the pass hands on in place (`kept`: ids it reads and never writes, a
// lent span's home among them) and then the ones it moves to `nexts`; the
// result is the first of `nexts`.
fn Tm::leave(after: Valuation(), flag: Nat, kept, nexts: List<Nat>, again: List<BitVec(64)> → BitVec(64)) → BitVec(64) {
    match after(64, flag).eq_bit(BitVec::ofNat(1)) {
        False => again(words_of(after, kept) ++ words_of(after, nexts)),
        True => words_of(after, nexts).head_or(BitVec::zero()),
    }
}

theorem Tm::leave_same(a, b: Valuation(), flag: Nat, kept, nexts: List<Nat>, again: List<BitVec(64)> → BitVec(64),
    same: (wd, id: Nat) → a(wd, id) = b(wd, id)): Tm::leave(a, flag, kept, nexts, again) = Tm::leave(b, flag, kept, nexts, again) {
    Tm::eq3(λ (x: BitVec(64)) (ks: List<BitVec(64)>) (ws: List<BitVec(64)>) =>
            match x.eq_bit(BitVec::ofNat(1)) { False => again(ks ++ ws), True => ws.head_or(BitVec::zero()) },
        same(64, flag), words_agree(kept, b, a, λ id _ => same(64, id)), words_agree(nexts, b, a, λ id _ => same(64, id)))
}

// Moves of words, `nexts[i]` from `qs[i]`.
fn Tm::moves_to(ns: List<Nat>, qs: List<Nat>) → List<Node> {
    match ns {
        Nil => Nil,
        Cons(n, rest) => match qs { Nil => Nil, Cons(q, more) => Cons(Move(64, n, q), Tm::moves_to(rest, more)) },
    }
}

theorem Tm::moves_to_writes(ns: List<Nat>): (qs: List<Nat>) → (id: Nat) → absent(id, ns).IsTrue() → absent(id, nodes_writes(Tm::moves_to(ns, qs))).IsTrue() {
    match ns {
        Nil => λ qs id _ => trivial,
        Cons(n, rest) => λ qs => match qs as λ q2 => (id: Nat) → absent(id, Cons(n, rest)).IsTrue() →
            absent(id, nodes_writes(Tm::moves_to(Cons(n, rest), q2))).IsTrue() {
            Nil => λ id _ => trivial,
            Cons(q, more) => λ id h => {
                let parts = Bool::is_true_and(id.differs(n), absent(id, rest), h);
                Bool::is_true_and_intro(id.differs(n), absent(id, nodes_writes(Tm::moves_to(rest, more))), parts.left,
                    Tm::moves_to_writes(rest, more, id, parts.right))
            },
        },
    }
}

theorem Tm::disjoint_tail(n: Nat, rest: List<Nat>, ys: List<Nat>): disjoint(Cons(n, rest), ys).IsTrue() → disjoint(rest, ys).IsTrue() { by sets() }

// Distinct targets, none a source, as many as the sources: the targets read
// the sources' words.
theorem Tm::moves_to_words(ns: List<Nat>, buffers: Buffers()): (qs: List<Nat>) → (values: Valuation()) → distinct(ns).IsTrue() → disjoint(ns, qs).IsTrue() →
    ns.len() = qs.len() → words_of(eval_nodes_over(buffers, Tm::moves_to(ns, qs), values), ns) = words_of(values, qs) {
    match ns {
        Nil => λ qs values _ _ => match qs as λ q2 => 0 = q2.len() → words_of(eval_nodes_over(buffers, Tm::moves_to(Nil, q2), values), Nil) = words_of(values, q2) {
            Nil => λ _ => refl,
            Cons(_, more) => λ (bad: 0 = more.len() + 1) => false_elim(more.len().zero_ne_succ(bad)),
        },
        Cons(n, rest) => λ qs values apart => match qs as λ q2 => disjoint(Cons(n, rest), q2).IsTrue() → rest.len() + 1 = q2.len() →
            words_of(eval_nodes_over(buffers, Tm::moves_to(Cons(n, rest), q2), values), Cons(n, rest)) = words_of(values, q2) {
            Nil => λ _ (bad: rest.len() + 1 = 0) => false_elim(rest.len().succ_ne_zero(bad)),
            Cons(q, more) => λ dis same => {
                let parts = Bool::is_true_and(absent(n, rest), distinct(rest), apart);
                let dparts = Bool::is_true_and(absent(q, Cons(n, rest)), disjoint(Cons(n, rest), more), dis);
                let moved = Valuation::set(values, n, λ wd => values(wd, q));
                let after = eval_nodes_over(buffers, Tm::moves_to(rest, more), moved);
                let head: (after(64, n) = values(64, q)) = trans(
                    eval_nodes_frame(Tm::moves_to(rest, more), buffers, moved, 64, n, Tm::moves_to_writes(rest, more, n, parts.left)),
                    Valuation::set_here(values, n, λ wd => values(wd, q), 64));
                // `n` is none of `more`'s sources.
                let fresh: (y: Nat) → Mem(y, more) → (moved(64, y) = values(64, y)) = λ y m =>
                    Valuation::set_other(values, n, λ wd => values(wd, q), 64, y, Nat::differs_ne(y, n,
                        Bool::is_true_and(y.differs(n), absent(y, rest), disjoint_mem(Cons(n, rest), more, dparts.right, y, m)).left));
                let tail = trans(Tm::moves_to_words(rest, buffers, more, moved, parts.right,
                        Tm::disjoint_tail(n, rest, more, dparts.right),
                        Nat::succ_inj(rest.len(), more.len(), same)),
                    words_agree(more, values, moved, fresh));
                eq2(λ (x: BitVec(64)) (ws: List<BitVec(64)>) => Cons(x, ws), head, tail)
            },
        },
    }
}

// A self-call's argument ports: each a word variable.
fn Tm::self_args(w: World, g: List<Ty>, ports: List<Nat>, args: List<Nat>) → Option<List<Nat>> {
    match args {
        Nil => Some(Nil),
        Cons(a, more) => port_at(ports, a).and_then(λ q =>
            Ty::at(g, a).check_one_word(w.tys).and_then(λ _ => Tm::self_args(w, g, ports, more).and_then(λ qs => Some(Cons(q, qs))))),
    }
}

theorem Tm::self_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), args: List<Nat>):
    (qs: List<Nat>) → Tm::self_args(w, g, ports, args) = Some(qs) → words_of(values, qs) = Tm::words(w, g, env, args) {
    match args {
        Nil => λ qs e => j(Option::some_inj(Nil, qs, e), λ z _ => words_of(values, z) = Nil, refl),
        Cons(a, more) => {
            let Goal = λ (qs: List<Nat>) => words_of(values, qs) = Tm::words(w, g, env, Cons(a, more));
            let P = λ (o: Option<List<Nat>>) => (qs: List<Nat>) → o = Some(qs) → Goal(qs);
            let none: P(None) = λ qs e => Option::none_ne_some(qs, e, Goal(qs));
            Option::and_then_elim(P, none, port_at(ports, a), λ q =>
                Ty::at(g, a).check_one_word(w.tys).and_then(λ _ => Tm::self_args(w, g, ports, more).and_then(λ qs => Some(Cons(q, qs)))), λ q at_q =>
            Option::and_then_elim(P, none, Ty::at(g, a).check_one_word(w.tys), λ _ => Tm::self_args(w, g, ports, more).and_then(λ qs => Some(Cons(q, qs))),
                λ ea _ =>
            Option::and_then_elim(P, none, Tm::self_args(w, g, ports, more), λ qs => Some(Cons(q, qs)), λ found e_rest =>
                λ qs e => j(Option::some_inj(Cons(q, found), qs, e), λ z _ => Goal(z),
                    eq2(λ (x: BitVec(64)) (ws: List<BitVec(64)>) => Cons(x, ws),
                        Ty::one_word_reads(w.tys, values, q, Ty::at(g, a), ea, Env::get(w.tys, g, env, a), env_holds_at(w.tys, values, g, ports, env, held, a, q, at_q)),
                        Tm::self_args_sound(w, g, ports, values, env, held, more, found, e_rest))))))
        },
    }
}

// Going round: the arguments moved to `nexts`, then the flag 0. The flag
// comes last in both arms of a pass, so the native planner finds each
// arm's sources dead by then and puts every one of `nexts` and the flag in
// the register the branch's join wants (`pick_targets`); with the flag
// first, an arm could take a register a source still held and the arms
// disagree, which `File::meet` drops.
fn Tm::again_region(flag: Nat, nexts, qs: List<Nat>) → StructuredRegion {
    Compose(nodes_region(Tm::moves_to(nexts, qs)), nodes_region([Const(64, flag, 0)]))
}

// The arguments a self-call hands on in place: the first of `qs` are the
// ids `kept` themselves. What is left of `qs` is moved.
fn Tm::split_kept(kept, qs: List<Nat>) → Option<List<Nat>> {
    match kept {
        Nil => Some(qs),
        Cons(k, rest) => match qs {
            Nil => None,
            Cons(q, more) => match k.same(q) { False => None, True => Tm::split_kept(rest, more) },
        },
    }
}

theorem Tm::split_kept_words(values: Valuation(), kept: List<Nat>): (qs, moved: List<Nat>) → Tm::split_kept(kept, qs) = Some(moved) →
    words_of(values, kept) ++ words_of(values, moved) = words_of(values, qs) {
    match kept {
        Nil => λ qs moved e => cong_fn(λ (l: List<Nat>) => words_of(values, l), sym(Option::some_inj(qs, moved, e))),
        Cons(k, rest) => λ qs => match qs as λ q2 => (moved: List<Nat>) → Tm::split_kept(Cons(k, rest), q2) = Some(moved) →
            words_of(values, Cons(k, rest)) ++ words_of(values, moved) = words_of(values, q2) {
            Nil => λ moved e => Option::none_ne_some(moved, e, words_of(values, Cons(k, rest)) ++ words_of(values, moved) = Nil),
            Cons(q, more) => λ moved e => (match k.same(q) as λ b => k.same(q) = b →
                (match b { False => None, True => Tm::split_kept(rest, more) }) = Some(moved) →
                words_of(values, Cons(k, rest)) ++ words_of(values, moved) = words_of(values, Cons(q, more)) {
                False => λ _ never => Option::none_ne_some(moved, never,
                    words_of(values, Cons(k, rest)) ++ words_of(values, moved) = words_of(values, Cons(q, more))),
                True => λ same found => eq2(λ (x: BitVec(64)) (ws: List<BitVec(64)>) => Cons(x, ws),
                    cong_fn(λ (id: Nat) => values(64, id), k.same_sound(q, same)), Tm::split_kept_words(values, rest, more, moved, found)),
            })(refl, e),
        },
    }
}

// Going round hands `kept` on in place, which is what the function compiler
// asks of a home it carries through a loop (`carried_sound`): the call
// passes each as the id it came in as, and the pass writes none of them.
fn Tm::lower_again(flag: Nat, kept, nexts: List<Nat>, next: Nat, qs: List<Nat>) → Option<Lowered> {
    Tm::split_kept(kept, qs).and_then(λ moved =>
        Tm::check_true((distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()))) &&
            disjoint(Cons(flag, nexts), kept))
            .and_then(λ _ => Some(Lowered(Tm::again_region(flag, nexts, moved), flag, next))))
}

// Leaving: the value moved to the first of `nexts` and copied to the rest,
// which nothing reads, then the flag 1: a branch's arms both write every
// one of `nexts`, so the native lowering finds them held in a register
// wherever the pass ends (`File::meet` keeps only what both arms hold).
fn Tm::copies(ns: List<Nat>, n0: Nat) → List<Nat> { ns.map(λ _ => n0) }

fn Tm::leave_region(l: Lowered, flag, n0: Nat, rest: List<Nat>) → StructuredRegion {
    Compose(l.region, Compose(nodes_region(Cons(Move(64, n0, l.result), Tm::moves_to(rest, Tm::copies(rest, n0)))),
        nodes_region([Const(64, flag, 1)])))
}

fn Tm::leave_at(flag: Nat, nexts: List<Nat>, l: Lowered) → Option<Lowered> {
    match nexts {
        Nil => None,
        Cons(n0, rest) => Tm::check_true(distinct(Cons(flag, Cons(n0, rest))))
            .and_then(λ _ => Some(Lowered(Tm::leave_region(l, flag, n0, rest), flag, l.next))),
    }
}

// A leaf at the result's code, held in one word (`Tm::tail_sound` assumes
// the code is).
fn Tm::lower_leaf(self t: Tm, w: World, res: Ty, flag: Nat, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    Tm::lower(t, w, g, ports, next).and_then(λ l => t.ty(w, g).check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l)))
}

// A branch of a pass: both arms write the flag and `nexts`.
fn Tm::tail_branch(g: List<Ty>, ports: List<Nat>, c, flag: Nat, nexts: List<Nat>, ly, ln: Lowered) → Option<Lowered> {
    port_at(ports, c).and_then(λ pc => Ty::at(g, c).check(Bit).and_then(λ _ =>
        Some(Lowered(branch(pc, Ports(word_ports(Cons(flag, nexts))), ly.region, ln.region), flag, ln.next))))
}

// A pass: `t` in tail mode. The flag and `nexts` are ports below `next`
// that nothing in the context is held at (checked where a call goes
// round, whose arguments are moved there).
fn Tm::lower_tail(self t: Tm, w: World, skip: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    match t {
        Let(e, body) => Tm::lower(e, w, g, ports, next).and_then(λ le =>
            Tm::lower_tail(body, w, skip, res, flag, kept, nexts, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb))),
        If(c, yes, no) => Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
            Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))),
        IfEq(c, yes, no) => Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
            Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))),
        Call(f, args) => match f {
            Zero => Tm::self_args(w, g, ports, args.drop(skip)).and_then(λ qs => Tm::lower_again(flag, kept, nexts, next, qs)),
            Succ(h) => Tm::lower_leaf(Call(h + 1, args), w, res, flag, nexts, g, ports, next),
        },
        Var(i) => Tm::lower_leaf(Var(i), w, res, flag, nexts, g, ports, next),
        Lit(c, n) => Tm::lower_leaf(Lit(c, n), w, res, flag, nexts, g, ports, next),
        Prim(op, args) => Tm::lower_leaf(Prim(op, args), w, res, flag, nexts, g, ports, next),
        Make(i, args) => Tm::lower_leaf(Make(i, args), w, res, flag, nexts, g, ports, next),
        Field(i, k, of) => Tm::lower_leaf(Field(i, k, of), w, res, flag, nexts, g, ports, next),
        Fold(over, init, step) => Tm::lower_leaf(Fold(over, init, step), w, res, flag, nexts, g, ports, next),
        Case(c, zero, succ) => Tm::lower_leaf(Case(c, zero, succ), w, res, flag, nexts, g, ports, next),
        Byte(k, i, length) => Tm::lower_leaf(Byte(k, i, length), w, res, flag, nexts, g, ports, next),
    }
}

// What a pass promises: from where the environment holds below `next`,
// with calls answered by the program's meanings, `next` grows and what it
// leaves for the loop is `Tm::tail_sem`, whatever the continuation.
fn Tm::TailHolds(self t: Tm, w: World, skip: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
            EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
            (next <= c.next) ∧ ((again: List<BitVec(64)> → res.sem(w.tys)) →
                Tm::leave(c.region.eval(call, values, buffers := w.spans), flag, kept, nexts, λ ys => Tm::out(w.tys, res, again(ys))) =
                    Tm::out(w.tys, res, t.tail_sem(w, skip, res, again, g, env))),
    }
}

theorem Tm::lower_again_sound(t: Tm, w: World, skip: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat, args: List<Nat>,
    means: (again: List<BitVec(64)> → res.sem(w.tys)) → (env: Env(w.tys, g)) → t.tail_sem(w, skip, res, again, g, env) = again(Tm::words(w, g, env, args))):
    Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next,
        Tm::self_args(w, g, ports, args).and_then(λ qs => Tm::lower_again(flag, kept, nexts, next, qs))) {
    let P = λ (r: Option<Lowered>) => Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next, r);
    Option::and_then_elim(P, trivial, Tm::self_args(w, g, ports, args), λ qs => Tm::lower_again(flag, kept, nexts, next, qs), λ qs e_qs =>
    Option::and_then_elim(P, trivial, Tm::split_kept(kept, qs), λ moved =>
        Tm::check_true((distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()))) &&
            disjoint(Cons(flag, nexts), kept))
            .and_then(λ _ => Some(Lowered(Tm::again_region(flag, nexts, moved), flag, next))), λ moved e_moved =>
    Option::and_then_elim(P, trivial,
        Tm::check_true((distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()))) &&
            disjoint(Cons(flag, nexts), kept)),
        λ _ => Some(Lowered(Tm::again_region(flag, nexts, moved), flag, next)), λ ok _ =>
        λ call agree values env held below => {
            let both = Bool::is_true_and(distinct(Cons(flag, nexts)) && (disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len())),
                disjoint(Cons(flag, nexts), kept), ok);
            let parts = Bool::is_true_and(distinct(Cons(flag, nexts)), disjoint(Cons(flag, nexts), moved) && nexts.len().matches(moved.len()), both.left);
            let rest = Bool::is_true_and(disjoint(Cons(flag, nexts), moved), nexts.len().matches(moved.len()), parts.right);
            let apart = Bool::is_true_and(absent(flag, nexts), distinct(nexts), parts.left);
            let shifted = eval_nodes_over(w.spans, Tm::moves_to(nexts, moved), values);
            let after = Valuation::set(shifted, flag, λ wd => BitVec::ofNat(0));
            // The flag is none of `nexts`.
            let at_flag: (after(64, flag) = BitVec::ofNat(0)) = Valuation::set_here(shifted, flag, λ wd => BitVec::ofNat(0), 64);
            let unflagged: (words_of(after, nexts) = words_of(shifted, nexts)) = words_agree(nexts, shifted, after, λ y m =>
                Valuation::set_other(shifted, flag, λ wd => BitVec::ofNat(0), 64, y, λ e => absent_mem(flag, nexts, apart.left, y, m, sym(e))));
            let moved_words: (words_of(after, nexts) = words_of(values, moved)) = trans(unflagged,
                Tm::moves_to_words(nexts, w.spans, moved, values, apart.right, Tm::disjoint_tail(flag, nexts, moved, rest.left),
                    nexts.len().matches_eq(moved.len(), rest.right)));
            // Nothing written is one of `kept`.
            let kept_words: (words_of(after, kept) = words_of(values, kept)) = words_agree(kept, values, after, λ y m => {
                let out = Bool::is_true_and(y.differs(flag), absent(y, nexts), disjoint_mem(Cons(flag, nexts), kept, both.right, y, m));
                trans(Valuation::set_other(shifted, flag, λ wd => BitVec::ofNat(0), 64, y, y.differs_ne(flag, out.left)),
                    eval_nodes_frame(Tm::moves_to(nexts, moved), w.spans, values, 64, y, Tm::moves_to_writes(nexts, moved, y, out.right)))
            });
            let state: (words_of(after, kept) ++ words_of(after, nexts) = Tm::words(w, g, env, args)) = trans(
                eq2(λ (a: List<BitVec(64)>) (b: List<BitVec(64)>) => a ++ b, kept_words, moved_words),
                trans(Tm::split_kept_words(values, kept, qs, moved, e_moved), Tm::self_args_sound(w, g, ports, values, env, held, args, qs, e_qs)));
            ⟨next.le_refl(), λ again => trans(
                cong_fn(λ (x: BitVec(64)) => match x.eq_bit(BitVec::ofNat(1)) {
                        False => Tm::out(w.tys, res, again(words_of(after, kept) ++ words_of(after, nexts))),
                        True => words_of(after, nexts).head_or(BitVec::zero()) },
                    at_flag),
                trans(cong_fn(λ (ws: List<BitVec(64)>) => Tm::out(w.tys, res, again(ws)), state),
                    cong_fn(λ (v: res.sem(w.tys)) => Tm::out(w.tys, res, v), sym(means(again, env)))))⟩
        })))
}

theorem Tm::lower_leaf_sound(t: Tm, w: World, skip: Nat, res: Ty, er: res.OneWord(w.tys), flag: Nat, kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    means: (again: List<BitVec(64)> → res.sem(w.tys)) → (env: Env(w.tys, g)) → t.tail_sem(w, skip, res, again, g, env) = Tm::leaf(t, w, res, g, env)):
    Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_leaf(t, w, res, flag, nexts, g, ports, next)) {
    match nexts as λ ns => Tm::TailHolds(t, w, skip, res, flag, kept, ns, g, ports, next, Tm::lower_leaf(t, w, res, flag, ns, g, ports, next)) {
        Nil => {
            let P = λ (r: Option<Lowered>) => Tm::TailHolds(t, w, skip, res, flag, kept, Nil, g, ports, next, r);
            Option::and_then_elim(P, trivial, Tm::lower(t, w, g, ports, next),
                λ l => t.ty(w, g).check(res).and_then(λ _ => Tm::leave_at(flag, Nil, l)), λ l _ =>
            Option::and_then_elim(P, trivial, t.ty(w, g).check(res), λ _ => Tm::leave_at(flag, Nil, l), λ _ _ => trivial))
        },
        Cons(n0, rest) => {
            let ns = Cons(n0, rest);
            let P = λ (r: Option<Lowered>) => Tm::TailHolds(t, w, skip, res, flag, kept, ns, g, ports, next, r);
            Option::and_then_elim(P, trivial, Tm::lower(t, w, g, ports, next),
                λ l => t.ty(w, g).check(res).and_then(λ _ => Tm::leave_at(flag, ns, l)), λ l lowered =>
            Option::and_then_elim(P, trivial, t.ty(w, g).check(res), λ _ => Tm::leave_at(flag, ns, l), λ e _ =>
            Option::and_then_elim(P, trivial, Tm::check_true(distinct(Cons(flag, Cons(n0, rest)))),
                λ _ => Some(Lowered(Tm::leave_region(l, flag, n0, rest), flag, l.next)), λ apart _ =>
                λ call agree values env held below => {
                    let ran = j(lowered, λ r _ => Tm::LowerHolds(t, w, g, ports, next, r), Tm::lower_sound(t, w, g, ports, next))(
                        call, agree, values, env, held, below);
                    let p1 = Bool::is_true_and(absent(flag, Cons(n0, rest)), distinct(Cons(n0, rest)), apart);
                    let pf = Bool::is_true_and(flag.differs(n0), absent(flag, rest), p1.left);
                    let pn = Bool::is_true_and(absent(n0, rest), distinct(rest), p1.right);
                    let mid = l.region.eval(call, values, buffers := w.spans);
                    let moved = Valuation::set(mid, n0, λ wd => mid(wd, l.result));
                    let copies = Tm::moves_to(rest, Tm::copies(rest, n0));
                    let copied = eval_nodes_over(w.spans, copies, moved);
                    let after = Valuation::set(copied, flag, λ wd => BitVec::ofNat(1));
                    let at_flag: (after(64, flag) = BitVec::ofNat(1)) = Valuation::set_here(copied, flag, λ wd => BitVec::ofNat(1), 64);
                    let at_n0: (after(64, n0) = mid(64, l.result)) = trans(
                        Valuation::set_other(copied, flag, λ wd => BitVec::ofNat(1), 64, n0, λ same => Nat::differs_ne(flag, n0, pf.left, sym(same))), trans(
                        eval_nodes_frame(copies, w.spans, moved, 64, n0, Tm::moves_to_writes(rest, Tm::copies(rest, n0), n0, pn.left)),
                        Valuation::set_here(mid, n0, λ wd => mid(wd, l.result), 64)));
                    let held_one: t.ty(w, g).OneWord(w.tys) = j(sym(e), λ x _ => x.OneWord(w.tys), er);
                    let value: (mid(64, l.result) = Tm::out(w.tys, res, Tm::leaf(t, w, res, g, env))) =
                        trans(Ty::one_word_reads(w.tys, mid, l.result, t.ty(w, g), held_one, t.sem(w, g, env), ran.right.right.right),
                            sym(Tm::out_cast(w.tys, t.ty(w, g), res, e, t.sem(w, g, env))));
                    ⟨ran.left, λ again => trans(
                        cong_fn(λ (x: BitVec(64)) => match x.eq_bit(BitVec::ofNat(1)) {
                            False => Tm::out(w.tys, res, again(words_of(after, kept) ++ words_of(after, ns))), True => words_of(after, ns).head_or(BitVec::zero()) }, at_flag),
                        trans(at_n0, trans(value, cong_fn(λ (v: res.sem(w.tys)) => Tm::out(w.tys, res, v), sym(means(again, env))))))⟩
                })))
        },
    }
}

// What a pass's branch leaves is what the arm its bit chooses leaves.
theorem Tm::leave_branch(values: Valuation(), pc: Nat, outs: Ports, wt, wf: StructuredRegion, call: Answers(), buffers: Buffers(), flag: Nat, kept, nexts: List<Nat>,
    again: List<BitVec(64)> → BitVec(64), b: Bool): values(1, pc).head_bit() = b →
    Tm::leave(branch(pc, outs, wt, wf).eval(call, values, buffers := buffers), flag, kept, nexts, again) =
        match b { False => Tm::leave(wf.eval(call, values, buffers := buffers), flag, kept, nexts, again), True => Tm::leave(wt.eval(call, values, buffers := buffers), flag, kept, nexts, again) } {
    match b {
        True => λ h => Tm::leave_same(branch(pc, outs, wt, wf).eval(call, values, buffers := buffers), wt.eval(call, values, buffers := buffers), flag, kept, nexts, again,
            λ wd id => branch_true(values, pc, outs, wt, wf, call, buffers, h, wd, id)),
        False => λ h => Tm::leave_same(branch(pc, outs, wt, wf).eval(call, values, buffers := buffers), wf.eval(call, values, buffers := buffers), flag, kept, nexts, again,
            λ wd id => branch_false(values, pc, outs, wt, wf, call, buffers, h, wd, id)),
    }
}

// A pass's branch, for any term that means the match of its arms.
theorem Tm::tail_if_sound(t: Tm, c: Nat, yes, no: Tm, w: World, skip: Nat, res: Ty, flag: Nat, kept, nexts: List<Nat>,
    ih_yes: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        Tm::TailHolds(yes, w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next)),
    ih_no: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
        Tm::TailHolds(no, w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat,
    means: (again: List<BitVec(64)> → res.sem(w.tys)) → (env: Env(w.tys, g)) → t.tail_sem(w, skip, res, again, g, env) =
        match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)) {
            False => no.tail_sem(w, skip, res, again, g, env), True => yes.tail_sem(w, skip, res, again, g, env) }):
    Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
        Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln)))) {
    let P = λ (r: Option<Lowered>) => Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next, r);
    let outs = Ports(word_ports(Cons(flag, nexts)));
    Option::and_then_elim(P, trivial, Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next),
        λ ly => Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln)),
        λ ly lowered_yes =>
    Option::and_then_elim(P, trivial, Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next),
        λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln), λ ln lowered_no =>
    Option::and_then_elim(P, trivial, port_at(ports, c),
        λ pc => Ty::at(g, c).check(Bit).and_then(λ _ => Some(Lowered(branch(pc, outs, ly.region, ln.region), flag, ln.next))), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Bit), λ _ => Some(Lowered(branch(pc, outs, ly.region, ln.region), flag, ln.next)),
        λ ec _ =>
        λ call agree values env held below => {
            let first = j(lowered_yes, λ r _ => Tm::TailHolds(yes, w, skip, res, flag, kept, nexts, g, ports, next, r), ih_yes(g, ports, next))(
                call, agree, values, env, held, below);
            let second = j(lowered_no, λ r _ => Tm::TailHolds(no, w, skip, res, flag, kept, nexts, g, ports, ly.next, r), ih_no(g, ports, ly.next))(
                call, agree, values, env, held, below_mono(w.tys, g, next, ly.next, first.left, ports, below));
            let scrutinee = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c));
            let bit = Tm::operand(w, g, ports, values, env, held, c, pc, at_c, Bit, ec);
            let chosen = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(scrutinee));
            ⟨Nat::le_trans(next, ly.next, ln.next, first.left, second.left), λ again => {
                let k = λ (ys: List<BitVec(64)>) => Tm::out(w.tys, res, again(ys));
                trans(Tm::leave_branch(values, pc, outs, ly.region, ln.region, call, w.spans, flag, kept, nexts, k, scrutinee, chosen),
                    trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => match scrutinee { False => y, True => x },
                        first.right(again), second.right(again)),
                        trans(Tm::out_match(w.tys, res, scrutinee, yes.tail_sem(w, skip, res, again, g, env), no.tail_sem(w, skip, res, again, g, env)),
                            cong_fn(λ (v: res.sem(w.tys)) => Tm::out(w.tys, res, v), sym(means(again, env))))))
            }⟩
        }))))
}

// What a pass computes, wherever the result's code is held in one word.
theorem Tm::tail_sound(self t: Tm, w: World, skip: Nat, res: Ty, er: res.OneWord(w.tys), flag: Nat, kept, nexts: List<Nat>): (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
    Tm::TailHolds(t, w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_tail(t, w, skip, res, flag, kept, nexts, g, ports, next)) {
    match t {
        Var(i) => λ g ports next => Tm::lower_leaf_sound(Var(i), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Lit(c, n) => λ g ports next => Tm::lower_leaf_sound(Lit(c, n), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Prim(op, args) => λ g ports next => Tm::lower_leaf_sound(Prim(op, args), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Make(i, args) => λ g ports next => Tm::lower_leaf_sound(Make(i, args), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Field(i, k, of) => λ g ports next => Tm::lower_leaf_sound(Field(i, k, of), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Fold(over, init, step) => λ g ports next =>
            Tm::lower_leaf_sound(Fold(over, init, step), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Case(c, zero, succ) => λ g ports next =>
            Tm::lower_leaf_sound(Case(c, zero, succ), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Byte(k, i, length) => λ g ports next =>
            Tm::lower_leaf_sound(Byte(k, i, length), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        Call(f, args) => match f as λ f2 => (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
            Tm::TailHolds(Call(f2, args), w, skip, res, flag, kept, nexts, g, ports, next, Tm::lower_tail(Call(f2, args), w, skip, res, flag, kept, nexts, g, ports, next)) {
            Zero => λ g ports next => Tm::lower_again_sound(Call(Zero, args), w, skip, res, flag, kept, nexts, g, ports, next, args.drop(skip), λ again env => refl),
            Succ(h) => λ g ports next =>
                Tm::lower_leaf_sound(Call(h + 1, args), w, skip, res, er, flag, kept, nexts, g, ports, next, λ again env => refl),
        },
        Let(e, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => Tm::TailHolds(Let(e, body), w, skip, res, flag, kept, nexts, g, ports, next, r);
            let inner = Cons(Tm::ty(e, w, g), g);
            Option::and_then_elim(P, trivial, Tm::lower(e, w, g, ports, next),
                λ le => Tm::lower_tail(body, w, skip, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb)),
                λ le lowered_e =>
            Option::and_then_elim(P, trivial, Tm::lower_tail(body, w, skip, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next),
                λ lb => Tm::compose(le, lb), λ lb lowered_body =>
                λ call agree values env held below => {
                    let first = j(lowered_e, λ r _ => Tm::LowerHolds(e, w, g, ports, next, r),
                        Tm::lower_sound(e, w, g, ports, next))(call, agree, values, env, held, below);
                    let mid = le.region.eval(call, values, buffers := w.spans);
                    let then = j(lowered_body, λ r _ => Tm::TailHolds(body, w, skip, res, flag, kept, nexts, inner, Cons(le.result, ports), le.next, r),
                        Tm::tail_sound(body, w, skip, res, er, flag, kept, nexts, inner, Cons(le.result, ports), le.next))(call, agree, mid,
                        Pair(Tm::sem(e, w, g, env), env),
                        ⟨first.right.right.right, env_holds_keeps(w.tys, g, values, mid, next, first.right.right.left, ports, env, below, held)⟩,
                        ⟨first.right.left, below_mono(w.tys, g, next, le.next, first.left, ports, below)⟩);
                    ⟨Nat::le_trans(next, le.next, lb.next, first.left, then.left), then.right⟩
                }))
        },
        If(c, yes, no) => λ g ports next => Tm::tail_if_sound(If(c, yes, no), c, yes, no, w, skip, res, flag, kept, nexts,
            λ g2 ports2 next2 => Tm::tail_sound(yes, w, skip, res, er, flag, kept, nexts, g2, ports2, next2),
            λ g2 ports2 next2 => Tm::tail_sound(no, w, skip, res, er, flag, kept, nexts, g2, ports2, next2), g, ports, next, λ again env => refl),
        IfEq(c, yes, no) => λ g ports next => Tm::tail_if_sound(IfEq(c, yes, no), c, yes, no, w, skip, res, flag, kept, nexts,
            λ g2 ports2 next2 => Tm::tail_sound(yes, w, skip, res, er, flag, kept, nexts, g2, ports2, next2),
            λ g2 ports2 next2 => Tm::tail_sound(no, w, skip, res, er, flag, kept, nexts, g2, ports2, next2), g, ports, next,
            λ again env => Tm::convoy_match(res.sem(w.tys), Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)),
                yes.tail_sem(w, skip, res, again, g, env), no.tail_sem(w, skip, res, again, g, env))),
    }
}

// ---------------------------------------------------------------------------
// Ids in a run: `Fun::param_ids(ps, m)` is `m, m+1, …` below `Fun::past(ps, m)`.

theorem Tm::differs_of_ne(a, b: Nat, ne: a ≠ b): a.differs(b).IsTrue() {
    match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => trivial,
    }
}

theorem Fun::past_ge(ps: List<Ty>): (m: Nat) → m <= Fun::past(ps, m) {
    match ps {
        Nil => λ m => m.le_refl(),
        Cons(_, rest) => λ m => Nat::le_of_lt(m, Fun::past(rest, m + 1), Fun::past_ge(rest, m + 1)),
    }
}

theorem Fun::ids_len(ps: List<Ty>): (m: Nat) → Fun::param_ids(ps, m).len() = ps.len() {
    match ps { Nil => λ m => refl, Cons(_, rest) => λ m => cong_fn(λ (k: Nat) => k + 1, Fun::ids_len(rest, m + 1)) }
}

// An id below the run or past it is none of it.
theorem Fun::absent_ids(ps: List<Ty>): (m, id: Nat) → (id < m) ∨ (Fun::past(ps, m) <= id) → absent(id, Fun::param_ids(ps, m)).IsTrue() {
    match ps {
        Nil => λ m id _ => trivial,
        Cons(_, rest) => λ m id out => {
            let ne: (id ≠ m) = match out {
                Inl(lt) => Nat::ne_of_lt(id, m, lt),
                Inr(ge) => Nat::ne_of_gt(id, m, Nat::lt_of_lt_of_le(m, Fun::past(rest, m + 1), id, Fun::past_ge(rest, m + 1), ge)),
            };
            let later: (id < m + 1) ∨ (Fun::past(rest, m + 1) <= id) = match out {
                Inl(lt) => Inl(Nat::lt_trans(id, m, m + 1, lt, m.lt_succ_self())),
                Inr(ge) => Inr(ge),
            };
            Bool::is_true_and_intro(id.differs(m), absent(id, Fun::param_ids(rest, m + 1)), Tm::differs_of_ne(id, m, ne),
                Fun::absent_ids(rest, m + 1, id, later))
        },
    }
}

theorem Fun::ids_distinct(ps: List<Ty>): (m: Nat) → distinct(Fun::param_ids(ps, m)).IsTrue() {
    match ps {
        Nil => λ m => trivial,
        Cons(_, rest) => λ m => Bool::is_true_and_intro(absent(m, Fun::param_ids(rest, m + 1)), distinct(Fun::param_ids(rest, m + 1)),
            Fun::absent_ids(rest, m + 1, m, Inl(m.lt_succ_self())), Fun::ids_distinct(rest, m + 1)),
    }
}

// Ids of a signature in two parts.
theorem Fun::past_append(ks, ws: List<Ty>): (m: Nat) → Fun::past(ks ++ ws, m) = Fun::past(ws, Fun::past(ks, m)) {
    match ks { Nil => λ m => refl, Cons(_, rest) => λ m => Fun::past_append(rest, ws, m + 1) }
}

theorem Fun::ids_append(ks, ws: List<Ty>): (m: Nat) →
    Fun::param_ids(ks ++ ws, m) = Fun::param_ids(ks, m) ++ Fun::param_ids(ws, Fun::past(ks, m)) {
    match ks { Nil => λ m => refl, Cons(_, rest) => λ m => cong_fn(λ (l: List<Nat>) => Cons(m, l), Fun::ids_append(rest, ws, m + 1)) }
}

theorem Fun::past_first(ks, ws: List<Ty>, m: Nat): Fun::past(ks, m) <= Fun::past(ks ++ ws, m) {
    j(sym(Fun::past_append(ks, ws, m)), λ y _ => Fun::past(ks, m) <= y, Fun::past_ge(ws, Fun::past(ks, m)))
}

theorem Fun::words_append(values: Valuation(), xs, ys: List<Nat>): words_of(values, xs ++ ys) = words_of(values, xs) ++ words_of(values, ys) {
    match xs { Nil => refl, Cons(x, rest) => cong_fn(λ (l: List<BitVec(64)>) => Cons(values(64, x), l), Fun::words_append(values, rest, ys)) }
}

// Words read back where they are bound, as `Fun::BoundWords`.
theorem Fun::bound_of_words(values: Valuation(), ids: List<Nat>): (xs: List<BitVec(64)>) → ids.len() = xs.len() → words_of(values, ids) = xs →
    Fun::BoundWords(values, ids, xs) {
    match ids {
        Nil => λ xs _ _ => trivial,
        Cons(id, rest) => λ xs => match xs as λ ys => rest.len() + 1 = ys.len() → words_of(values, Cons(id, rest)) = ys →
            Fun::BoundWords(values, Cons(id, rest), ys) {
            Nil => λ (bad: rest.len() + 1 = 0) _ => false_elim(rest.len().succ_ne_zero(bad)),
            Cons(x, more) => λ same read => ⟨cong_fn(λ (ws: List<BitVec(64)>) => ws.head_or(BitVec::zero()), read),
                Fun::bound_of_words(values, rest, more, Nat::succ_inj(rest.len(), more.len(), same),
                    cong_fn(λ (ws: List<BitVec(64)>) => ws.tail(), read))⟩,
        },
    }
}

// ---------------------------------------------------------------------------
// A loop whose passes are below a bound: `loop_eval_agrees`, with each pass
// told it is one of at most `bound` (a fuel recursion's pass holds its fuel
// as a word, which needs the fuel below `2^64`).

theorem Fun::loop_agrees_below(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    apart: distinct(parameters).IsTrue(), lengths: next.len() = parameters.len(), finish: LoopEnd → BitVec(64),
    run: Nat → List<BitVec(64)> → BitVec(64), bound: Nat,
    at_zero: (v: Valuation()) → finish(LoopEnd(words_of(v, parameters), True)) = run(0, words_of(v, parameters)),
    at_pass: (r: Nat) → r + 1 <= bound → (v: Valuation()) →
        loop_pass(step, parameters, count, exit, next, finish, λ (state: List<BitVec(64)>) => run(r, state), r, v) =
            run(r + 1, words_of(v, parameters)),
    remaining: Nat): remaining <= bound →
    (v: Valuation()) → finish(loop_eval(step, parameters, count, exit, next, remaining, words_of(v, parameters))) =
        run(remaining, words_of(v, parameters)) {
    match remaining {
        Zero => λ _ v => at_zero(v),
        Succ(r) => λ within v => {
            let after = step(pass_valuation(parameters, count, r + 1, words_of(v, parameters)));
            let state = words_of(after, next);
            let rebound: (words_of(Valuation::bind(Valuation::zero(), parameters, state), parameters) = state) =
                words_of_bind(Valuation::zero(), parameters, apart, state, sym(trans(words_of_len(after, next), lengths)));
            let earlier = Fun::loop_agrees_below(step, parameters, count, exit, next, apart, lengths, finish, run, bound, at_zero, at_pass, r,
                Nat::le_of_lt(r, bound, within), Valuation::bind(Valuation::zero(), parameters, state));
            let later: (finish(loop_eval(step, parameters, count, exit, next, r, state)) = run(r, state)) =
                j(rebound, λ st _ => finish(loop_eval(step, parameters, count, exit, next, r, st)) = run(r, st), earlier);
            (match after(1, exit).head_bit() as λ b =>
                (match b { False => run(r, state), True => finish(LoopEnd(state, False)) }) = run(r + 1, words_of(v, parameters)) →
                finish(match b { False => loop_eval(step, parameters, count, exit, next, r, state),
                    True => LoopEnd(state, False) }) = run(r + 1, words_of(v, parameters)) {
                False => λ passed => trans(later, passed),
                True => λ passed => passed,
            })(at_pass(r, within, v))
        },
    }
}

// ---------------------------------------------------------------------------
// Statements about every word list of a signature's length, curried: what a
// generator proves with one `refl` per function, at neutral words.

fn Ty::ForWords(ps: List<Ty>) → (List<BitVec(64)> → Type) → Type {
    match ps {
        Nil => λ P => P(Nil),
        Cons(_, rest) => λ P => (x: BitVec(64)) → Ty::ForWords(rest, λ (xs: List<BitVec(64)>) => P(Cons(x, xs))),
    }
}

theorem Ty::for_words_at(ps: List<Ty>): (P: List<BitVec(64)> → Type) → Ty::ForWords(ps, P) → (xs: List<BitVec(64)>) → xs.len() = ps.len() → P(xs) {
    match ps {
        Nil => λ P h xs => match xs as λ ys => ys.len() = 0 → P(ys) {
            Nil => λ _ => h,
            Cons(_, more) => λ (bad: more.len() + 1 = 0) => false_elim(more.len().succ_ne_zero(bad)),
        },
        Cons(_, rest) => λ P h xs => match xs as λ ys => ys.len() = rest.len() + 1 → P(ys) {
            Nil => λ (bad: 0 = rest.len() + 1) => false_elim(rest.len().zero_ne_succ(bad)),
            Cons(x, more) => λ same => Ty::for_words_at(rest, λ (ys: List<BitVec(64)>) => P(Cons(x, ys)), h(x), more, Nat::succ_inj(more.len(), rest.len(), same)),
        },
    }
}

theorem Ty::for_words_of(ps: List<Ty>): (P: List<BitVec(64)> → Type) → ((xs: List<BitVec(64)>) → xs.len() = ps.len() → P(xs)) → Ty::ForWords(ps, P) {
    match ps {
        Nil => λ P h => h(Nil, refl),
        Cons(_, rest) => λ P h => λ x => Ty::for_words_of(rest, λ (ys: List<BitVec(64)>) => P(Cons(x, ys)),
            λ ys len => h(Cons(x, ys), cong_fn(λ (n: Nat) => n + 1, len))),
    }
}

// A curried meaning on a word list: each word cast to its parameter's code
// (zero past the list's end, as `Ty::extend` reads).
fn Ty::apply(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → List<BitVec(64)> → r.sem(tys) {
    match ps {
        Nil => λ v ws => v,
        Cons(p, rest) => λ v ws => match ws {
            Nil => Ty::apply(tys, rest, r, v(Ty::cast(tys, Word(64), p, BitVec::zero())), Nil),
            Cons(x, more) => Ty::apply(tys, rest, r, v(Ty::cast(tys, Word(64), p, x)), more),
        },
    }
}

// The same, its result read as a word: the function a call answers.
fn Ty::uncurry(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → List<BitVec(64)> → BitVec(64) {
    λ v ws => Tm::out(tys, r, Ty::apply(tys, ps, r, v, ws))
}

// ---------------------------------------------------------------------------
// After a loop: leaving, the result is the first moved word of the state;
// with the passes run out, `exhausted` the region that computes it.

fn Fun::post(x, rr, o0: Nat, exhausted: StructuredRegion) → StructuredRegion {
    branch(x, Ports([Port(rr, 64)]), exhausted, nodes_region([Move(64, rr, o0)]))
}

// The word bound at `o0`, past a prefix of ids that are not it.
theorem Fun::bind_past(values: Valuation(), o0: Nat, os: List<Nat>, s0: BitVec(64), rest: List<BitVec(64)>, ko: List<Nat>):
    (kw: List<BitVec(64)>) → absent(o0, ko).IsTrue() → ko.len() = kw.len() →
    Valuation::bind(values, ko ++ Cons(o0, os), kw ++ Cons(s0, rest), 64, o0) = s0 {
    match ko {
        Nil => λ kw _ => match kw as λ k2 => 0 = k2.len() → Valuation::bind(values, Cons(o0, os), k2 ++ Cons(s0, rest), 64, o0) = s0 {
            Nil => λ _ => Valuation::set_here(Valuation::bind(values, os, rest), o0, word_value(s0), 64),
            Cons(_, more) => λ (bad: 0 = more.len() + 1) => false_elim(more.len().zero_ne_succ(bad)),
        },
        Cons(k, later) => λ kw fresh => match kw as λ k2 => later.len() + 1 = k2.len() →
            Valuation::bind(values, Cons(k, later) ++ Cons(o0, os), k2 ++ Cons(s0, rest), 64, o0) = s0 {
            Nil => λ (bad: later.len() + 1 = 0) => false_elim(later.len().succ_ne_zero(bad)),
            Cons(y, more) => λ same => {
                let parts = Bool::is_true_and(o0.differs(k), absent(o0, later), fresh);
                trans(Valuation::set_other(Valuation::bind(values, later ++ Cons(o0, os), more ++ Cons(s0, rest)), k, word_value(y), 64, o0,
                        o0.differs_ne(k, parts.left)),
                    Fun::bind_past(values, o0, os, s0, rest, later, more, parts.right, Nat::succ_inj(later.len(), more.len(), same)))
            },
        },
    }
}

// Leaving: the outputs are the kept words `ko` and then the moved ones, of
// which the first, at `o0`, is the result.
theorem Fun::post_left(x, rr, o0: Nat, ko, os: List<Nat>, exhausted: StructuredRegion, call: Answers(), buffers: Buffers(), values: Valuation(),
    kw: List<BitVec(64)>, s0: BitVec(64), rest: List<BitVec(64)>, apart: x ≠ o0, fresh: absent(o0, ko).IsTrue(), len: ko.len() = kw.len()):
    loop_finish_over(buffers, Fun::post(x, rr, o0, exhausted), call, values, ko ++ Cons(o0, os), x, rr, LoopEnd(kw ++ Cons(s0, rest), False)) = s0 {
    let bound = Valuation::bind(values, ko ++ Cons(o0, os), kw ++ Cons(s0, rest));
    let q = Valuation::set(bound, x, bit_value(False));
    let left: (q(1, x).head_bit() = False) = cong_fn(λ (v: BitVec(1)) => v.head_bit(), Valuation::set_here(bound, x, bit_value(False), 1));
    trans(branch_false(q, x, Ports([Port(rr, 64)]), exhausted, nodes_region([Move(64, rr, o0)]), call, buffers, left, 64, rr),
        trans(Valuation::set_here(q, rr, λ wd => q(wd, o0), 64),
            trans(Valuation::set_other(bound, x, bit_value(False), 64, o0, λ e => apart(sym(e))),
                Fun::bind_past(values, o0, os, s0, rest, ko, kw, fresh, len))))
}

// What the exhausted branch sees: the state at `os`, the bit at `x` set.
theorem Fun::post_exhausted(x, rr, o0: Nat, exhausted: StructuredRegion, call: Answers(), buffers: Buffers(), values: Valuation(), os: List<Nat>,
    st: List<BitVec(64)>):
    loop_finish_over(buffers, Fun::post(x, rr, o0, exhausted), call, values, os, x, rr)(LoopEnd(st, True)) =
        exhausted.eval(call, Valuation::set(Valuation::bind(values, os, st), x, bit_value(True)), buffers := buffers)(64, rr) {
    let q = Valuation::set(Valuation::bind(values, os, st), x, bit_value(True));
    branch_true(q, x, Ports([Port(rr, 64)]), exhausted, nodes_region([Move(64, rr, o0)]), call, buffers,
        cong_fn(λ (v: BitVec(1)) => v.head_bit(), Valuation::set_here(Valuation::bind(values, os, st), x, bit_value(True), 1)), 64, rr)
}

// The state bound at distinct `os`, a bit at `x` and a word at `z` set
// after, none of them in `os`: `os` still reads the state.
theorem Fun::state_kept(values: Valuation(), os: List<Nat>, st: List<BitVec(64)>, x, z: Nat, bx, bz: (wd: Nat) → BitVec(wd),
    apart: distinct(os).IsTrue(), len: os.len() = st.len(), x_out: absent(x, os).IsTrue(), z_out: absent(z, os).IsTrue()):
    words_of(Valuation::set(Valuation::set(Valuation::bind(values, os, st), x, bx), z, bz), os) = st {
    let bound = Valuation::bind(values, os, st);
    let q = Valuation::set(bound, x, bx);
    trans(words_agree(os, q, Valuation::set(q, z, bz), λ y m => Valuation::set_other(q, z, bz, 64, y, λ e => absent_mem(z, os, z_out, y, m, sym(e)))),
        trans(words_agree(os, bound, q, λ y m => Valuation::set_other(bound, x, bx, 64, y, λ e => absent_mem(x, os, x_out, y, m, sym(e)))),
            words_of_bind(values, os, apart, st, len)))
}

// ---------------------------------------------------------------------------
// A fuel recursion `h(fuel, x…)`, its body `Case(fuel, zero, succ)`: ids 0
// (the fuel) and `1…` (the words), then the count `c`, the pass's state
// `ps`, the predecessor `k` and the constant one after it, the next state
// `ns`, the flag, and the pass's own ids from there.

fn Fun::fuel_c(ws: List<Ty>) → Nat { Fun::past(ws, 1) }
fn Fun::fuel_ps(ws: List<Ty>) → List<Nat> { Fun::param_ids(ws, Fun::fuel_c(ws) + 1) }
fn Fun::fuel_k(ws: List<Ty>) → Nat { Fun::past(ws, Fun::fuel_c(ws) + 1) }
fn Fun::fuel_ns(ws: List<Ty>) → List<Nat> { Fun::param_ids(ws, Fun::fuel_k(ws) + 2) }
fn Fun::fuel_flag(ws: List<Ty>) → Nat { Fun::past(ws, Fun::fuel_k(ws) + 2) }

// The pass's context: the predecessor, the words, the fuel.
fn Fun::fuel_ctx(ws: List<Ty>) → List<Ty> { Ty::bind_onto(ws, [Count]) }
fn Fun::fuel_ports(ws: List<Ty>) → List<Nat> { Cons(Fun::fuel_k(ws), Fun::ports_onto(ws, Fun::fuel_c(ws) + 1, [Fun::fuel_c(ws)])) }

// A pass: the predecessor from the count, the `Succ` arm in tail mode, then
// the exit bit from the flag word.
fn Fun::fuel_pass(ws: List<Ty>, t: Lowered) → StructuredRegion {
    Compose(nodes_region([Const(64, Fun::fuel_k(ws) + 1, 1), Sub(64, Fun::fuel_k(ws), Fun::fuel_c(ws), Fun::fuel_k(ws) + 1)]),
        Compose(t.region, nodes_region([Const(64, t.next, 1), Equal(64, t.next + 1, Fun::fuel_flag(ws), t.next)])))
}

// The passes run out: the fuel is zero, held at `z`, and the `Zero` arm
// answers.
fn Fun::fuel_zero_region(z, rr: Nat, lz: Lowered) → StructuredRegion {
    Compose(nodes_region([Const(64, z, 0)]), Compose(lz.region, nodes_region([Move(64, rr, lz.result)])))
}

fn Fun::fuel_code(ws: List<Ty>, t: Lowered, lz: Lowered) → Function {
    Function(Cons(0, Fun::param_ids(ws, 1)),
        Compose(Loop(Fun::param_ids(ws, 1), 0, Fun::fuel_ps(ws), Fun::fuel_c(ws), Fun::fuel_pass(ws, t), t.next + 1, Fun::fuel_ns(ws),
                Fun::param_ids(ws, t.next + 3), Fun::past(ws, t.next + 3)),
            Fun::post(Fun::past(ws, t.next + 3), lz.next, t.next + 3,
                Fun::fuel_zero_region(t.next + 2, lz.next, lz))),
        lz.next)
}

fn Fun::fuel_zero_at(ws: List<Ty>, zero: Tm, w: World, t: Lowered) → Option<Lowered> {
    Tm::lower(zero, w, Fun::fuel_ctx(ws), Fun::ports_onto(ws, t.next + 3, [t.next + 2]),
        Fun::past(ws, t.next + 3) + 1)
}

fn Fun::fuel_finish(ws: List<Ty>, res: Ty, zero: Tm, w: World, t: Lowered) → Option<Function> {
    Fun::fuel_zero_at(ws, zero, w, t).and_then(λ lz => zero.ty(w, Fun::fuel_ctx(ws)).check(res).and_then(λ _ =>
        Some(Fun::fuel_code(ws, t, lz))))
}

// At least one word: the loop leaves with its result as the first. The
// state and the result are each held in one word (a type held by its repr
// among them, design §16.13).
fn Fun::lower_fuel(w0: Ty, wrest: List<Ty>, zero, succ: Tm, res: Ty, w: World) → Option<Function> {
    let ws = Cons(w0, wrest);
    Ty::check_one_words(w.tys, ws).and_then(λ _ => res.check_one_word(w.tys).and_then(λ _ =>
        Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
            Fun::fuel_flag(ws) + 1).and_then(λ t => Fun::fuel_finish(ws, res, zero, w, t))))
}

// What a fuel loop's code promises: on a word `b` and the words, the
// recursion at fuel `b.toNat()`.
fn Fun::FuelHolds(ws: List<Ty>, res: Ty, w: World, h: Nat → Ty::Arrows(w.tys, ws, res), r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Answers()) → Tm::CallsAgree(w, call) → (b: BitVec(64)) → (xs: List<BitVec(64)>) → xs.len() = ws.len() →
            code.eval(call, Cons(b, xs), buffers := w.spans) = Ty::uncurry(w.tys, ws, res, h(b.toNat()), xs),
    }
}

// The fuel and its predecessor as words, below `2^64`.
theorem Fun::count_words(r: Nat, small: r + 1 < Nat::pow(2, 64)):
    (BitVec::ofNat(r + 1, n := 64).toNat() = r + 1) ∧ (BitVec::ofNat(r + 1, n := 64).sub(BitVec::ofNat(1)).toNat() = r) {
    let whole: (BitVec::ofNat(r + 1, n := 64).toNat() = r + 1) = BitVec::toNat_ofNat(64, r + 1, small);
    let one: (BitVec::ofNat(1, n := 64).toNat() = 1) = refl;
    let fits: (BitVec::ofNat(1, n := 64).toNat() <= BitVec::ofNat(r + 1, n := 64).toNat()) =
        j(sym(whole), λ x _ => 1 <= x, r.nonneg());
    ⟨whole, trans(bitvec_nat::toNat_sub(64, BitVec::ofNat(r + 1), BitVec::ofNat(1), fits),
        trans(eq2(λ (a: Nat) (b: Nat) => a - b, whole, one), Nat::sub_zero(r)))⟩
}

// A fuel recursion's equations at the step, as a generator proves them (by
// conversion, one `refl` per function): with fuel `Succ(r)` it is its
// `Succ` arm, its recursion on the predecessor answered by the function at
// `r`.
fn Fun::FuelStep(ws: List<Ty>, res: Ty, succ: Tm, w: World, h: Nat → Ty::Arrows(w.tys, ws, res), r: Nat) → Type {
    Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => Ty::apply(w.tys, ws, res, h(r + 1), xs) =
        succ.tail_sem(w, 1, res, λ (ys: List<BitVec(64)>) => Ty::apply(w.tys, ws, res, h(r), ys), Cons(Count, Fun::fuel_ctx(ws)),
            Pair(r, Ty::extend(w.tys, ws, [Count], Pair(r + 1, trivial), xs))))
}

fn Fun::FuelZero(ws: List<Ty>, res: Ty, zero: Tm, w: World, h: Nat → Ty::Arrows(w.tys, ws, res)) → Type {
    Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => Ty::apply(w.tys, ws, res, h(0), xs) =
        Tm::leaf(zero, w, res, Fun::fuel_ctx(ws), Ty::extend(w.tys, ws, [Count], Pair(0, trivial), xs)))
}

theorem Fun::fuel_pass_sound(ws: List<Ty>, res: Ty, succ: Tm, w: World, h: Nat → Ty::Arrows(w.tys, ws, res), ok: Ty::OneWords(w.tys, ws),
    er: res.OneWord(w.tys), t: Lowered, lowered: Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
        Fun::fuel_flag(ws) + 1) = Some(t),
    call: Answers(), agree: Tm::CallsAgree(w, call), finish: LoopEnd → BitVec(64),
    left: (v: Valuation()) → finish(LoopEnd(words_of(v, Fun::fuel_ns(ws)), False)) = words_of(v, Fun::fuel_ns(ws)).head_or(BitVec::zero()),
    r: Nat, step_eq: Fun::FuelStep(ws, res, succ, w, h, r), small: r + 1 < Nat::pow(2, 64), v: Valuation()):
    loop_pass(λ (pass: Valuation()) => Fun::fuel_pass(ws, t).eval(call, pass, buffers := w.spans), Fun::fuel_ps(ws), Fun::fuel_c(ws), t.next + 1, Fun::fuel_ns(ws),
        finish, λ (state: List<BitVec(64)>) => Ty::uncurry(w.tys, ws, res, h(r), state), r, v) =
        Ty::uncurry(w.tys, ws, res, h(r + 1), words_of(v, Fun::fuel_ps(ws))) {
    let tys = w.tys;
    let c = Fun::fuel_c(ws);
    let ps = Fun::fuel_ps(ws);
    let k = Fun::fuel_k(ws);
    let ns = Fun::fuel_ns(ws);
    let flag = Fun::fuel_flag(ws);
    let st = words_of(v, ps);
    let later = λ (state: List<BitVec(64)>) => Ty::uncurry(tys, ws, res, h(r), state);
    let again = λ (state: List<BitVec(64)>) => Ty::apply(tys, ws, res, h(r), state);
    let counted = Valuation::set(Valuation::zero(), c, word_value(BitVec::ofNat(r + 1)));
    let pv = Valuation::bind(counted, ps, st);
    let one_set = Valuation::set(pv, k + 1, λ wd => BitVec::ofNat(1));
    let pred = λ (wd: Nat) => one_set(wd, c).sub(one_set(wd, k + 1));
    let pv1 = Valuation::set(one_set, k, pred);
    // Where the ids sit.
    let c_k: (c < k) = Nat::lt_of_lt_of_le(c, c + 1, k, c.lt_succ_self(), Fun::past_ge(ws, c + 1));
    let c_one: (c < k + 1) = Nat::lt_trans(c, k, k + 1, c_k, k.lt_succ_self());
    let k_two: (k < k + 2) = Nat::lt_trans(k, k + 1, k + 2, k.lt_succ_self(), (k + 1).lt_succ_self());
    let k_flag: (k < flag) = Nat::lt_of_lt_of_le(k, k + 2, flag, k_two, Fun::past_ge(ws, k + 2));
    let k_base: (k < flag + 1) = Nat::lt_trans(k, flag, flag + 1, k_flag, flag.lt_succ_self());
    let c_out = Fun::absent_ids(ws, c + 1, c, Inl(c.lt_succ_self()));
    let k_out = Fun::absent_ids(ws, c + 1, k, Inr(k.le_refl()));
    let one_out = Fun::absent_ids(ws, c + 1, k + 1, Inr(Nat::le_succ_r(k, k, k.le_refl())));
    let len: (ps.len() = st.len()) = sym(words_of_len(v, ps));
    // The count, the predecessor and the state in the pass's valuation.
    let pv_c: (pv(64, c) = BitVec::ofNat(r + 1)) = simp_only(Valuation::bind_frame, Valuation::set_here);
    let pv1_c: (pv1(64, c) = pv(64, c)) = simp_only(Valuation::set_other, discharge := omega(c_k, c_one));
    let pv1_k: (pv1(64, k) = BitVec::ofNat(r + 1, n := 64).sub(BitVec::ofNat(1))) =
        simp_only(Valuation::set_here, Valuation::set_other, pv_c, discharge := omega(c_one));
    let words: Fun::BoundWords(pv1, ps, st) = Fun::bound_frame(pv, pv1, ps, st,
        λ id m => trans(Valuation::set_other(one_set, k, pred, 64, id, λ e => absent_mem(k, ps, k_out, id, m, sym(e))),
            Valuation::set_other(pv, k + 1, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(k + 1, ps, one_out, id, m, sym(e)))),
        Fun::bound_of_words(pv, ps, st, len, words_of_bind(counted, ps, Fun::ids_distinct(ws, c + 1), st, len)));
    let counts = Fun::count_words(r, small);
    let env = Pair(r, Ty::extend(tys, ws, [Count], Pair(r + 1, trivial), st));
    let held: EnvHolds(tys, pv1, Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws), env) =
        ⟨trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), pv1_k), counts.right),
            Fun::env_extend_holds(tys, pv1, ws, [Count], [c], Pair(r + 1, trivial), c + 1, st, ok,
                ⟨trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), trans(pv1_c, pv_c)), counts.left), trivial⟩, words)⟩;
    let below: Below(tys, Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws), flag + 1) =
        ⟨k_base, below_mono(tys, Fun::fuel_ctx(ws), k, flag + 1, Nat::le_of_lt(k, flag + 1, k_base), Fun::ports_onto(ws, c + 1, [c]),
            Fun::below_onto(tys, ws, [Count], c + 1, [c], ok, ⟨c.lt_succ_self(), trivial⟩))⟩;
    let ran = j(lowered, λ o _ => Tm::TailHolds(succ, w, 1, res, flag, Nil, ns, Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws), flag + 1, o),
        Tm::tail_sound(succ, w, 1, res, er, flag, Nil, ns, Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws), flag + 1))(call, agree, pv1, env, held, below);
    // The exit bit, from the flag word.
    let pv2 = t.region.eval(call, pv1, buffers := w.spans);
    let pv2a = Valuation::set(pv2, t.next, λ wd => BitVec::ofNat(1));
    let exit_value = bit_value(pv2a(64, flag).eq_bit(pv2a(64, t.next)));
    let pv3 = Valuation::set(pv2a, t.next + 1, exit_value);
    let flag_lt: (flag < t.next) = Nat::lt_of_lt_of_le(flag, flag + 1, t.next, flag.lt_succ_self(), ran.left);
    let exit_bit: (pv3(1, t.next + 1).head_bit() = pv2(64, flag).eq_bit(BitVec::ofNat(1))) =
        simp_only(Valuation::set_here, bit_value, Valuation::set_other, discharge := omega(flag_lt));
    let ns_out = Fun::absent_ids(ws, k + 2, t.next, Inr(Nat::le_of_lt(flag, t.next, flag_lt)));
    let ns_out2 = Fun::absent_ids(ws, k + 2, t.next + 1, Inr(Nat::le_succ_r(flag, t.next, Nat::le_of_lt(flag, t.next, flag_lt))));
    let nexts_same: (words_of(pv3, ns) = words_of(pv2, ns)) = words_agree(ns, pv2, pv3, λ id m =>
        trans(Valuation::set_other(pv2a, t.next + 1, exit_value, 64, id, λ e => absent_mem(t.next + 1, ns, ns_out2, id, m, sym(e))),
            Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(t.next, ns, ns_out, id, m, sym(e)))));
    let M = λ (b: Bool) (s: List<BitVec(64)>) (fin: BitVec(64)) => match b { False => later(s), True => fin };
    trans(cong_fn(λ (fin: BitVec(64)) => M(pv3(1, t.next + 1).head_bit(), words_of(pv3, ns), fin), left(pv3)),
        trans(Tm::eq3(M, exit_bit, nexts_same, cong_fn(λ (s: List<BitVec(64)>) => s.head_or(BitVec::zero()), nexts_same)),
            trans(ran.right(again),
                cong_fn(λ (u: res.sem(tys)) => Tm::out(tys, res, u),
                    sym(Ty::for_words_at(ws, λ (xs: List<BitVec(64)>) => Ty::apply(tys, ws, res, h(r + 1), xs) =
                        succ.tail_sem(w, 1, res, again, Cons(Count, Fun::fuel_ctx(ws)), Pair(r, Ty::extend(tys, ws, [Count], Pair(r + 1, trivial), xs))),
                        step_eq, st, trans(words_of_len(v, ps), Fun::ids_len(ws, c + 1))))))))
}

// The passes run out: the `Zero` arm on the state.
theorem Fun::fuel_zero_sound(ws: List<Ty>, res: Ty, zero: Tm, w: World, h: Nat → Ty::Arrows(w.tys, ws, res), ok: Ty::OneWords(w.tys, ws), er: res.OneWord(w.tys),
    zero_eq: Fun::FuelZero(ws, res, zero, w, h), t, lz: Lowered, lowered_z: Fun::fuel_zero_at(ws, zero, w, t) = Some(lz),
    ez: zero.ty(w, Fun::fuel_ctx(ws)) = res, call: Answers(), agree: Tm::CallsAgree(w, call), values: Valuation(),
    st: List<BitVec(64)>, len: st.len() = ws.len()):
    loop_finish_over(w.spans, Fun::post(Fun::past(ws, t.next + 3), lz.next, t.next + 3,
            Fun::fuel_zero_region(t.next + 2, lz.next, lz)),
        call, values, Fun::param_ids(ws, t.next + 3), Fun::past(ws, t.next + 3), lz.next)(LoopEnd(st, True)) =
        Ty::uncurry(w.tys, ws, res, h(0), st) {
    let tys = w.tys;
    let z = t.next + 2;
    let os = Fun::param_ids(ws, z + 1);
    let x = Fun::past(ws, z + 1);
    let ctx = Fun::fuel_ctx(ws);
    let ports = Fun::ports_onto(ws, z + 1, [z]);
    let q = Valuation::set(Valuation::bind(values, os, st), x, bit_value(True));
    let qz = Valuation::set(q, z, λ wd => BitVec::ofNat(0));
    let env = Ty::extend(tys, ws, [Count], Pair(0, trivial), st);
    let len_os: (os.len() = st.len()) = trans(Fun::ids_len(ws, z + 1), sym(len));
    let read = Fun::state_kept(values, os, st, x, z, bit_value(True), λ wd => BitVec::ofNat(0), Fun::ids_distinct(ws, z + 1), len_os,
        Fun::absent_ids(ws, z + 1, x, Inr(x.le_refl())), Fun::absent_ids(ws, z + 1, z, Inl(z.lt_succ_self())));
    let held: EnvHolds(tys, qz, ctx, ports, env) = Fun::env_extend_holds(tys, qz, ws, [Count], [z], Pair(0, trivial), z + 1, st, ok,
        ⟨cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(q, z, λ wd => BitVec::ofNat(0), 64)), trivial⟩,
        Fun::bound_of_words(qz, os, st, len_os, read));
    let below: Below(tys, ctx, ports, x + 1) = below_mono(tys, ctx, x, x + 1, Nat::le_succ_r(x, x, x.le_refl()), ports,
        Fun::below_onto(tys, ws, [Count], z + 1, [z], ok, ⟨z.lt_succ_self(), trivial⟩));
    let ran = j(lowered_z, λ o _ => Tm::LowerHolds(zero, w, ctx, ports, x + 1, o), Tm::lower_sound(zero, w, ctx, ports, x + 1))(
        call, agree, qz, env, held, below);
    let after = lz.region.eval(call, qz, buffers := w.spans);
    let value: (after(64, lz.result) = Tm::out(tys, res, Tm::leaf(zero, w, res, ctx, env))) =
        trans(Ty::one_word_reads(tys, after, lz.result, zero.ty(w, ctx), j(sym(ez), λ y _ => y.OneWord(tys), er), zero.sem(w, ctx, env),
                ran.right.right.right),
            sym(Tm::out_cast(tys, zero.ty(w, ctx), res, ez, zero.sem(w, ctx, env))));
    // `value` as the unfolded evaluation spells it.
    let value_over: (lz.region.eval_over(w.spans, call, qz, 64, lz.result) = Tm::out(tys, res, Tm::leaf(zero, w, res, ctx, env))) = value;
    simp_only(Fun::post_exhausted(x, lz.next, z + 1, Fun::fuel_zero_region(z, lz.next, lz), call, w.spans, values, os, st), Fun::fuel_zero_region,
        nodes_region, Region::eval, Node::step, Valuation::set_here, value_over,
        Ty::uncurry, Ty::for_words_at(ws, λ (xs: List<BitVec(64)>) => Ty::apply(tys, ws, res, h(0), xs) =
            Tm::leaf(zero, w, res, ctx, Ty::extend(tys, ws, [Count], Pair(0, trivial), xs)), zero_eq, st, len))
}

// A fuel recursion's loop computes it: on a word `b` and the words, the
// function at fuel `b.toNat()`, from its two equations alone.
theorem Fun::fuel_sound(w0: Ty, wrest: List<Ty>, zero, succ: Tm, res: Ty, w: World, h: Nat → Ty::Arrows(w.tys, Cons(w0, wrest), res),
    zero_eq: Fun::FuelZero(Cons(w0, wrest), res, zero, w, h), step_eq: (r: Nat) → Fun::FuelStep(Cons(w0, wrest), res, succ, w, h, r)):
    Fun::FuelHolds(Cons(w0, wrest), res, w, h, Fun::lower_fuel(w0, wrest, zero, succ, res, w)) {
    let ws = Cons(w0, wrest);
    let tys = w.tys;
    let P = λ (o: Option<Function>) => Fun::FuelHolds(ws, res, w, h, o);
    let pass_ctx = Cons(Count, Fun::fuel_ctx(ws));
    Option::and_then_elim(P, trivial, Ty::check_one_words(w.tys, ws), λ _ => res.check_one_word(w.tys).and_then(λ _ =>
        Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), pass_ctx, Fun::fuel_ports(ws), Fun::fuel_flag(ws) + 1)
            .and_then(λ t => Fun::fuel_finish(ws, res, zero, w, t))), λ ok _ =>
    Option::and_then_elim(P, trivial, res.check_one_word(w.tys), λ _ =>
        Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), pass_ctx, Fun::fuel_ports(ws), Fun::fuel_flag(ws) + 1)
            .and_then(λ t => Fun::fuel_finish(ws, res, zero, w, t)), λ er _ =>
    Option::and_then_elim(P, trivial,
        Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), pass_ctx, Fun::fuel_ports(ws), Fun::fuel_flag(ws) + 1),
        λ t => Fun::fuel_finish(ws, res, zero, w, t), λ t lowered =>
    Option::and_then_elim(P, trivial, Fun::fuel_zero_at(ws, zero, w, t),
        λ lz => zero.ty(w, Fun::fuel_ctx(ws)).check(res).and_then(λ _ => Some(Fun::fuel_code(ws, t, lz))), λ lz lowered_z =>
    Option::and_then_elim(P, trivial, zero.ty(w, Fun::fuel_ctx(ws)).check(res), λ _ => Some(Fun::fuel_code(ws, t, lz)), λ ez _ =>
        λ call agree b xs len => {
            let c = Fun::fuel_c(ws);
            let ps = Fun::fuel_ps(ws);
            let z = t.next + 2;
            let x = Fun::past(ws, z + 1);
            let ids = Cons(0, Fun::param_ids(ws, 1));
            let values0 = Valuation::bind(Valuation::zero(), ids, Cons(b, xs));
            let post = Fun::post(x, lz.next, z + 1, Fun::fuel_zero_region(z, lz.next, lz));
            let fin = loop_finish_over(w.spans, post, call, values0, Fun::param_ids(ws, z + 1), x, lz.next);
            let step = λ (pass: Valuation()) => Fun::fuel_pass(ws, t).eval(call, pass, buffers := w.spans);
            let run = λ (r: Nat) (state: List<BitVec(64)>) => Ty::uncurry(tys, ws, res, h(r), state);
            let read: (words_of(values0, ids) = Cons(b, xs)) = words_of_bind(Valuation::zero(), ids, Fun::ids_distinct(Cons(Count, ws), 0), Cons(b, xs),
                cong_fn(λ (n: Nat) => n + 1, trans(Fun::ids_len(ws, 1), sym(len))));
            let b_at: (values0(64, 0) = b) = cong_fn(λ (l: List<BitVec(64)>) => l.head_or(BitVec::zero()), read);
            let xs_at: (words_of(values0, Fun::param_ids(ws, 1)) = xs) = cong_fn(λ (l: List<BitVec(64)>) => l.tail(), read);
            let bound = values0(64, 0).toNat();
            let st0 = words_of(values0, Fun::param_ids(ws, 1));
            let v0 = Valuation::bind(Valuation::zero(), ps, st0);
            let rebound: (words_of(v0, ps) = st0) = words_of_bind(Valuation::zero(), ps, Fun::ids_distinct(ws, c + 1), st0,
                trans(Fun::ids_len(ws, c + 1), sym(trans(words_of_len(values0, Fun::param_ids(ws, 1)), Fun::ids_len(ws, 1)))));
            let x_o0: (z + 1 < x) = Nat::lt_of_lt_of_le(z + 1, z + 2, x, (z + 1).lt_succ_self(), Fun::past_ge(wrest, z + 2));
            let left = λ (v: Valuation()) => Fun::post_left(x, lz.next, z + 1, Nil, Fun::param_ids(wrest, z + 2),
                Fun::fuel_zero_region(z, lz.next, lz), call, w.spans, values0, Nil, v(64, Fun::fuel_k(ws) + 2),
                words_of(v, Fun::param_ids(wrest, Fun::fuel_k(ws) + 3)), Nat::ne_of_gt(x, z + 1, x_o0), trivial, refl);
            let small_bound: (bound < Nat::pow(2, 64)) = BitVec::toNat_lt_pow(64, values0(64, 0));
            let agreed = Fun::loop_agrees_below(step, ps, c, t.next + 1, Fun::fuel_ns(ws), Fun::ids_distinct(ws, c + 1),
                trans(Fun::ids_len(ws, Fun::fuel_k(ws) + 2), sym(Fun::ids_len(ws, c + 1))), fin, run, bound,
                λ v => Fun::fuel_zero_sound(ws, res, zero, w, h, ok, er, zero_eq, t, lz, lowered_z, ez, call, agree, values0, words_of(v, ps),
                    trans(words_of_len(v, ps), Fun::ids_len(ws, c + 1))),
                λ r within v => Fun::fuel_pass_sound(ws, res, succ, w, h, ok, er, t, lowered, call, agree, fin, left, r, step_eq(r),
                    Nat::le_trans(r + 2, bound + 1, Nat::pow(2, 64), Nat::le_succ_succ(r + 1, bound, within), small_bound), v),
                bound, bound.le_refl(), v0);
            let started: (fin(loop_eval(step, ps, c, t.next + 1, Fun::fuel_ns(ws), bound, st0)) = run(bound, st0)) =
                j(rebound, λ s _ => fin(loop_eval(step, ps, c, t.next + 1, Fun::fuel_ns(ws), bound, s)) = run(bound, s), agreed);
            trans(started, eq2(λ (n: BitVec(64)) (l: List<BitVec(64)>) => run(n.toNat(), l), b_at, xs_at))
        })))))
}

// ---------------------------------------------------------------------------
// A measured recursion: a function that `decreases` a measure below `2^64`.
// Its words are `ks` and then `ws` (`all` is both): the first a pass hands
// on in place, the rest it moves. The kept words are the homes of the spans
// the function is lent, which the function compiler carries through a loop
// only as the pass's own parameters (`carried_sound`,
// docs/native/native-one-compiler-design.md §2.3); a function lent nothing keeps
// none, and its loop is the one it was.
//
// Ids `0…` are the words; then the bound, the pass's state `ps` (the kept
// ones first), the count, the moved words' next ids `ns`, the flag, and the
// pass's own ids. After the loop, the exhausted branch runs the body once
// more in tail mode at ids of its own.

fn Fun::meas_bnd(all: List<Ty>) → Nat { Fun::past(all, 0) }
fn Fun::meas_ps(all: List<Ty>) → List<Nat> { Fun::param_ids(all, Fun::meas_bnd(all) + 1) }
fn Fun::meas_kept(all, ks: List<Ty>) → List<Nat> { Fun::param_ids(ks, Fun::meas_bnd(all) + 1) }
fn Fun::meas_c(all: List<Ty>) → Nat { Fun::past(all, Fun::meas_bnd(all) + 1) }
fn Fun::meas_ns(all, ws: List<Ty>) → List<Nat> { Fun::param_ids(ws, Fun::meas_c(all) + 1) }
fn Fun::meas_flag(all, ws: List<Ty>) → Nat { Fun::past(ws, Fun::meas_c(all) + 1) }

// The loop's next state: the kept parameters themselves, then `ns`.
fn Fun::meas_next(all, ks, ws: List<Ty>) → List<Nat> { Fun::meas_kept(all, ks) ++ Fun::meas_ns(all, ws) }

// The most passes a measured loop is given: the measure is below `2^64`.
fn Fun::meas_passes() → Nat { 18446744073709551615 }

fn Fun::meas_pass(all, ws: List<Ty>, t: Lowered) → StructuredRegion {
    Compose(t.region, nodes_region([Const(64, t.next, 1), Equal(64, t.next + 1, Fun::meas_flag(all, ws), t.next)]))
}

// The exhausted branch's own ids, past the loop's exhausted bit `x`.
fn Fun::meas_ns2(ws: List<Ty>, x: Nat) → List<Nat> { Fun::param_ids(ws, x + 1) }
fn Fun::meas_flag2(ws: List<Ty>, x: Nat) → Nat { Fun::past(ws, x + 1) }

// The exhausted branch reads the loop's outputs, from `o`, the kept ones
// first; its ids start past the exhausted bit `x`.
fn Fun::meas_tail2(all, ks, ws: List<Ty>, res: Ty, body: Tm, w: World, o, x: Nat) → Option<Lowered> {
    Tm::lower_tail(body, w, 0, res, Fun::meas_flag2(ws, x), Fun::param_ids(ks, o), Fun::meas_ns2(ws, x), Ty::bind_onto(all, Nil),
        Fun::ports_onto(all, o, Nil), Fun::meas_flag2(ws, x) + 1)
}

fn Fun::meas_code(all, ks, ws: List<Ty>, lent: Nat, t, t2: Lowered) → Function {
    Function(Fun::param_ids(all, 0),
        Compose(nodes_region([Const(64, Fun::meas_bnd(all), Fun::meas_passes())]),
            Compose(Loop(Fun::param_ids(all, 0), Fun::meas_bnd(all), Fun::meas_ps(all), Fun::meas_c(all), Fun::meas_pass(all, ws, t), t.next + 1,
                    Fun::meas_next(all, ks, ws), Fun::param_ids(all, t.next + 2), Fun::past(all, t.next + 2)),
                Fun::post(Fun::past(all, t.next + 2), t2.next, Fun::past(ks, t.next + 2),
                    Compose(t2.region, nodes_region([Move(64, t2.next, Fun::past(all, t.next + 2) + 1)]))))),
        t2.next, lent)
}

fn Fun::lower_measured_at(all, ks, ws: List<Ty>, body: Tm, res: Ty, w: World, lent: Nat) → Option<Function> {
    Ty::check_one_words(w.tys, all).and_then(λ _ => res.check_one_word(w.tys).and_then(λ _ =>
        Tm::lower_tail(body, w, 0, res, Fun::meas_flag(all, ws), Fun::meas_kept(all, ks), Fun::meas_ns(all, ws), Ty::bind_onto(all, Nil),
            Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil), Fun::meas_flag(all, ws) + 1).and_then(λ t =>
        Fun::meas_tail2(all, ks, ws, res, body, w, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
            Some(Fun::meas_code(all, ks, ws, lent, t, t2))))))
}

// The words kept, then at least one moved: the loop leaves with its result
// as the first moved word.
fn Fun::lower_measured(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: Tm, res: Ty, w: World, lent: Nat) → Option<Function> {
    Fun::lower_measured_at(ks ++ Cons(w0, wrest), ks, Cons(w0, wrest), body, res, w, lent)
}

// What a measured function owes, generated from its own companions
// (`f::ext`, `f::irrel`): its measure is below `2^64`, and its body, its
// recursion answered by anything that agrees with it below the measure,
// is the function.
fn Fun::Bounded(ws: List<Ty>, m: List<BitVec(64)> → Nat) → Type { Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => m(xs) < Nat::pow(2, 64)) }

// The recursion `again` answers in words, as the loop's next pass does, and
// is read at the result's code (`Tm::into`, the repr's `abs`); the body's
// value is read back as a word outside it (`Tm::out`).
fn Fun::Guarded(ws: List<Ty>, res: Ty, body: Tm, w: World, h: Ty::Arrows(w.tys, ws, res), m: List<BitVec(64)> → Nat) → Type {
    Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (again: List<BitVec(64)> → BitVec(64)) →
        ((ys: List<BitVec(64)>) → ys.len() = ws.len() → m(ys) < m(xs) → again(ys) = Ty::uncurry(w.tys, ws, res, h, ys)) →
        Tm::out(w.tys, res, body.tail_sem(w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(w.tys, res, again(ys)), Ty::bind_onto(ws, Nil),
            Ty::extend(w.tys, ws, Nil, trivial, xs))) = Ty::uncurry(w.tys, ws, res, h, xs))
}

fn Fun::MeasuredHolds(ws: List<Ty>, res: Ty, w: World, h: Ty::Arrows(w.tys, ws, res), r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Answers()) → Tm::CallsAgree(w, call) → (xs: List<BitVec(64)>) → xs.len() = ws.len() →
            code.eval(call, xs, buffers := w.spans) = Ty::uncurry(w.tys, ws, res, h, xs),
    }
}

// Leaving or not, the first moved word, for a continuation that is it.
theorem Tm::leave_first(a: Valuation(), flag: Nat, kept, ns: List<Nat>):
    Tm::leave(a, flag, kept, ns, λ (ys: List<BitVec(64)>) => words_of(a, ns).head_or(BitVec::zero())) = words_of(a, ns).head_or(BitVec::zero()) {
    match a(64, flag).eq_bit(BitVec::ofNat(1)) as λ b => (match b { False => words_of(a, ns).head_or(BitVec::zero()),
        True => words_of(a, ns).head_or(BitVec::zero()) }) = words_of(a, ns).head_or(BitVec::zero()) {
        False => refl,
        True => refl,
    }
}

// What a pass leaves reads its continuation only at the next state.
theorem Tm::leave_cont(a: Valuation(), flag: Nat, kept, ns: List<Nat>, k1, k2: List<BitVec(64)> → BitVec(64),
    same: k1(words_of(a, kept) ++ words_of(a, ns)) = k2(words_of(a, kept) ++ words_of(a, ns))):
    Tm::leave(a, flag, kept, ns, k1) = Tm::leave(a, flag, kept, ns, k2) {
    cong_fn(λ (k: BitVec(64)) => match a(64, flag).eq_bit(BitVec::ofNat(1)) { False => k, True => words_of(a, ns).head_or(BitVec::zero()) }, same)
}

// What a pass leaves moves with its continuation, pointwise: `simp` crosses
// the continuation's `λ` by it.
evidence theorem Tm::leave_pointwise({a: Valuation()}, {flag: Nat}, {kept: List<Nat>}, {ns: List<Nat>}):
    PreservesRelation(Pointwise<List<BitVec(64)>, BitVec(64)>(RelId<BitVec(64)>), RelId<BitVec(64)>, λ k => Tm::leave(a, flag, kept, ns, k))
{
    λ k1 k2 same => Tm::leave_cont(a, flag, kept, ns, k1, k2, same(words_of(a, kept) ++ words_of(a, ns)))
}

// The pass's environment: the state bound at `ps` from a valuation that
// sets the count first.
theorem Fun::meas_env(ws: List<Ty>, tys: Nat → RecInfo, ok: Ty::OneWords(tys, ws), m: Nat, base: Valuation(), st: List<BitVec(64)>,
    len: st.len() = ws.len()):
    EnvHolds(tys, Valuation::bind(base, Fun::param_ids(ws, m), st), Ty::bind_onto(ws, Nil), Fun::ports_onto(ws, m, Nil),
        Ty::extend(tys, ws, Nil, trivial, st)) {
    let ids_len: (Fun::param_ids(ws, m).len() = st.len()) = trans(Fun::ids_len(ws, m), sym(len));
    Fun::env_extend_holds(tys, Valuation::bind(base, Fun::param_ids(ws, m), st), ws, Nil, Nil, trivial, m, st, ok, trivial,
        Fun::bound_of_words(Valuation::bind(base, Fun::param_ids(ws, m), st), Fun::param_ids(ws, m), st, ids_len,
            words_of_bind(base, Fun::param_ids(ws, m), Fun::ids_distinct(ws, m), st, ids_len)))
}

theorem Fun::meas_pass_sound(ks, ws: List<Ty>, res: Ty, body: Tm, w: World, h: Ty::Arrows(w.tys, ks ++ ws, res), ok: Ty::OneWords(w.tys, ks ++ ws),
    er: res.OneWord(w.tys), m: List<BitVec(64)> → Nat, guarded: Fun::Guarded(ks ++ ws, res, body, w, h, m), t: Lowered,
    lowered: Tm::lower_tail(body, w, 0, res, Fun::meas_flag(ks ++ ws, ws), Fun::meas_kept(ks ++ ws, ks), Fun::meas_ns(ks ++ ws, ws),
        Ty::bind_onto(ks ++ ws, Nil), Fun::ports_onto(ks ++ ws, Fun::meas_bnd(ks ++ ws) + 1, Nil), Fun::meas_flag(ks ++ ws, ws) + 1) = Some(t),
    call: Answers(), agree: Tm::CallsAgree(w, call), finish: LoopEnd → BitVec(64),
    left: (v: Valuation()) → finish(LoopEnd(words_of(v, Fun::meas_next(ks ++ ws, ks, ws)), False)) =
        words_of(v, Fun::meas_ns(ks ++ ws, ws)).head_or(BitVec::zero()),
    r: Nat, v: Valuation(), hr: m(words_of(v, Fun::meas_ps(ks ++ ws))) < r + 2,
    earlier: (state: List<BitVec(64)>) → state.len() = Fun::meas_ps(ks ++ ws).len() → (p: m(state) < r + 1) →
        finish(loop_eval(λ (pass: Valuation()) => Fun::meas_pass(ks ++ ws, ws, t).eval(call, pass, buffers := w.spans), Fun::meas_ps(ks ++ ws),
            Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), r, state)) = Ty::uncurry(w.tys, ks ++ ws, res, h, state)):
    loop_pass(λ (pass: Valuation()) => Fun::meas_pass(ks ++ ws, ws, t).eval(call, pass, buffers := w.spans), Fun::meas_ps(ks ++ ws),
        Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws),
        finish, λ (state: List<BitVec(64)>) => finish(loop_eval(λ (pass: Valuation()) => Fun::meas_pass(ks ++ ws, ws, t).eval(call, pass, buffers := w.spans),
            Fun::meas_ps(ks ++ ws), Fun::meas_c(ks ++ ws), t.next + 1, Fun::meas_next(ks ++ ws, ks, ws), r, state)), r, v) =
        Ty::uncurry(w.tys, ks ++ ws, res, h, words_of(v, Fun::meas_ps(ks ++ ws))) {
    let all = ks ++ ws;
    let tys = w.tys;
    let bnd = Fun::meas_bnd(all);
    let ps = Fun::meas_ps(all);
    let kept = Fun::meas_kept(all, ks);
    let c = Fun::meas_c(all);
    let ns = Fun::meas_ns(all, ws);
    let next = Fun::meas_next(all, ks, ws);
    let flag = Fun::meas_flag(all, ws);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, bnd + 1, Nil);
    let step = λ (pass: Valuation()) => Fun::meas_pass(all, ws, t).eval(call, pass, buffers := w.spans);
    let later = λ (state: List<BitVec(64)>) => finish(loop_eval(step, ps, c, t.next + 1, next, r, state));
    let st = words_of(v, ps);
    let len_st: (st.len() = all.len()) = trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1));
    let counted = Valuation::set(Valuation::zero(), c, word_value(BitVec::ofNat(r + 1)));
    let pv = Valuation::bind(counted, ps, st);
    let env = Ty::extend(tys, all, Nil, trivial, st);
    let held = Fun::meas_env(all, tys, ok, bnd + 1, counted, st, len_st);
    let c_flag: (c < flag + 1) = Nat::lt_of_lt_of_le(c, c + 1, flag + 1, c.lt_succ_self(),
        Nat::le_succ_r(c + 1, flag, Fun::past_ge(ws, c + 1)));
    let below: Below(tys, ctx, ports, flag + 1) = below_mono(tys, ctx, c, flag + 1, Nat::le_of_lt(c, flag + 1, c_flag), ports,
        Fun::below_onto(tys, all, Nil, bnd + 1, Nil, ok, trivial));
    let ran = j(lowered, λ o _ => Tm::TailHolds(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1, o),
        Tm::tail_sound(body, w, 0, res, er, flag, kept, ns, ctx, ports, flag + 1))(call, agree, pv, env, held, below);
    let pv2 = t.region.eval(call, pv, buffers := w.spans);
    let pv2a = Valuation::set(pv2, t.next, λ wd => BitVec::ofNat(1));
    let exit_value = bit_value(pv2a(64, flag).eq_bit(pv2a(64, t.next)));
    let pv3 = Valuation::set(pv2a, t.next + 1, exit_value);
    let flag_lt: (flag < t.next) = Nat::lt_of_lt_of_le(flag, flag + 1, t.next, flag.lt_succ_self(), ran.left);
    let exit_bit: (pv3(1, t.next + 1).head_bit() = pv2(64, flag).eq_bit(BitVec::ofNat(1))) =
        trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), Valuation::set_here(pv2a, t.next + 1, exit_value, 1)),
            eq2(λ (a: BitVec(64)) (b: BitVec(64)) => a.eq_bit(b),
                Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, flag, Nat::ne_of_lt(flag, t.next, flag_lt)),
                Valuation::set_here(pv2, t.next, λ wd => BitVec::ofNat(1), 64)));
    // Neither id the exit test writes is a next id or a kept one: the kept
    // ids end at or before the count.
    let kept_next: (Fun::past(ks, bnd + 1) <= t.next) = Nat::le_trans(Fun::past(ks, bnd + 1), c, t.next, Fun::past_first(ks, ws, bnd + 1),
        Nat::le_of_lt(c, t.next, Nat::lt_of_lt_of_le(c, flag + 1, t.next, c_flag, ran.left)));
    let ns_out = Fun::absent_ids(ws, c + 1, t.next, Inr(Nat::le_of_lt(flag, t.next, flag_lt)));
    let ns_out2 = Fun::absent_ids(ws, c + 1, t.next + 1, Inr(Nat::le_succ_r(flag, t.next, Nat::le_of_lt(flag, t.next, flag_lt))));
    let kept_out = Fun::absent_ids(ks, bnd + 1, t.next, Inr(kept_next));
    let kept_out2 = Fun::absent_ids(ks, bnd + 1, t.next + 1, Inr(Nat::le_succ_r(Fun::past(ks, bnd + 1), t.next, kept_next)));
    let nexts_same: (words_of(pv3, ns) = words_of(pv2, ns)) = words_agree(ns, pv2, pv3, λ id mem =>
        trans(Valuation::set_other(pv2a, t.next + 1, exit_value, 64, id, λ e => absent_mem(t.next + 1, ns, ns_out2, id, mem, sym(e))),
            Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(t.next, ns, ns_out, id, mem, sym(e)))));
    let kept_same: (words_of(pv3, kept) = words_of(pv2, kept)) = words_agree(kept, pv2, pv3, λ id mem =>
        trans(Valuation::set_other(pv2a, t.next + 1, exit_value, 64, id, λ e => absent_mem(t.next + 1, kept, kept_out2, id, mem, sym(e))),
            Valuation::set_other(pv2, t.next, λ wd => BitVec::ofNat(1), 64, id, λ e => absent_mem(t.next, kept, kept_out, id, mem, sym(e)))));
    let state_same: (words_of(pv3, next) = words_of(pv2, kept) ++ words_of(pv2, ns)) = trans(Fun::words_append(pv3, kept, ns),
        eq2(λ (a: List<BitVec(64)>) (b: List<BitVec(64)>) => a ++ b, kept_same, nexts_same));
    let M = λ (b: Bool) (s: List<BitVec(64)>) (fin: BitVec(64)) => match b { False => later(s), True => fin };
    let at_st = Ty::for_words_at(all, λ (xs: List<BitVec(64)>) => (again: List<BitVec(64)> → BitVec(64)) →
        ((ys: List<BitVec(64)>) → ys.len() = all.len() → m(ys) < m(xs) → again(ys) = Ty::uncurry(tys, all, res, h, ys)) →
        Tm::out(tys, res, body.tail_sem(w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(tys, res, again(ys)), ctx, Ty::extend(tys, all, Nil, trivial, xs))) =
            Ty::uncurry(tys, all, res, h, xs), guarded, st, len_st);
    let read_back = λ (ys: List<BitVec(64)>) => Tm::out(tys, res, Tm::into(tys, res, later(ys)));
    trans(cong_fn(λ (fin: BitVec(64)) => M(pv3(1, t.next + 1).head_bit(), words_of(pv3, next), fin), left(pv3)),
        trans(Tm::eq3(M, exit_bit, state_same, cong_fn(λ (s: List<BitVec(64)>) => s.head_or(BitVec::zero()), nexts_same)),
            trans(Tm::leave_cont(pv2, flag, kept, ns, later, read_back,
                sym(Tm::out_into(tys, res, er, later(words_of(pv2, kept) ++ words_of(pv2, ns))))),
            trans(ran.right(λ (ys: List<BitVec(64)>) => Tm::into(tys, res, later(ys))), at_st(later, λ ys len_ys lt =>
                earlier(ys, trans(len_ys, sym(Fun::ids_len(all, bnd + 1))), Nat::lt_of_lt_of_le(m(ys), m(st), r + 1, lt, hr)))))))
}

// The passes run out: the body once more, no recursion being reachable.
theorem Fun::meas_zero_sound(ks, ws: List<Ty>, res: Ty, body: Tm, w: World, h: Ty::Arrows(w.tys, ks ++ ws, res), ok: Ty::OneWords(w.tys, ks ++ ws),
    er: res.OneWord(w.tys), m: List<BitVec(64)> → Nat,
    guarded: Fun::Guarded(ks ++ ws, res, body, w, h, m), o, x, o0: Nat, t2: Lowered,
    lowered2: Fun::meas_tail2(ks ++ ws, ks, ws, res, body, w, o, x) = Some(t2),
    x_at: x = Fun::past(ks ++ ws, o), n0: Nat, ns_rest: List<Nat>, ns_at: Fun::meas_ns2(ws, x) = Cons(n0, ns_rest),
    call: Answers(), agree: Tm::CallsAgree(w, call), values: Valuation(), st: List<BitVec(64)>, len: st.len() = (ks ++ ws).len(), hz: m(st) < 1):
    loop_finish_over(w.spans, Fun::post(x, t2.next, o0, Compose(t2.region, nodes_region([Move(64, t2.next, n0)]))), call, values,
        Fun::param_ids(ks ++ ws, o), x, t2.next, LoopEnd(st, True)) = Ty::uncurry(w.tys, ks ++ ws, res, h, st) {
    let all = ks ++ ws;
    let tys = w.tys;
    let os = Fun::param_ids(all, o);
    let kept2 = Fun::param_ids(ks, o);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, o, Nil);
    let flag2 = Fun::meas_flag2(ws, x);
    let ns2 = Fun::meas_ns2(ws, x);
    let bound = Valuation::bind(values, os, st);
    let q = Valuation::set(bound, x, bit_value(True));
    let env = Ty::extend(tys, all, Nil, trivial, st);
    let len_os: (os.len() = st.len()) = trans(Fun::ids_len(all, o), sym(len));
    let x_out = Fun::absent_ids(all, o, x, Inr(j(sym(x_at), λ y _ => Fun::past(all, o) <= y, Fun::past(all, o).le_refl())));
    let read: (words_of(q, os) = st) = trans(words_agree(os, bound, q,
            λ y mem => Valuation::set_other(bound, x, bit_value(True), 64, y, λ e => absent_mem(x, os, x_out, y, mem, sym(e)))),
        words_of_bind(values, os, Fun::ids_distinct(all, o), st, len_os));
    let held: EnvHolds(tys, q, ctx, ports, env) = Fun::env_extend_holds(tys, q, all, Nil, Nil, trivial, o, st, ok, trivial,
        Fun::bound_of_words(q, os, st, len_os, read));
    let x_flag: (x <= flag2 + 1) = Nat::le_succ_r(x, flag2, Nat::le_of_lt(x, flag2,
        Nat::lt_of_lt_of_le(x, x + 1, flag2, x.lt_succ_self(), Fun::past_ge(ws, x + 1))));
    let below: Below(tys, ctx, ports, flag2 + 1) = below_mono(tys, ctx, x, flag2 + 1, x_flag, ports,
        j(sym(x_at), λ y _ => Below(tys, ctx, ports, y), Fun::below_onto(tys, all, Nil, o, Nil, ok, trivial)));
    let ran = j(lowered2, λ r _ => Tm::TailHolds(body, w, 0, res, flag2, kept2, ns2, ctx, ports, flag2 + 1, r),
        Tm::tail_sound(body, w, 0, res, er, flag2, kept2, ns2, ctx, ports, flag2 + 1))(call, agree, q, env, held, below);
    let q2 = t2.region.eval(call, q, buffers := w.spans);
    let first = λ (ys: List<BitVec(64)>) => words_of(q2, ns2).head_or(BitVec::zero());
    let at_st = Ty::for_words_at(all, λ (xs: List<BitVec(64)>) => (again: List<BitVec(64)> → BitVec(64)) →
        ((ys: List<BitVec(64)>) → ys.len() = all.len() → m(ys) < m(xs) → again(ys) = Ty::uncurry(tys, all, res, h, ys)) →
        Tm::out(tys, res, body.tail_sem(w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(tys, res, again(ys)), ctx, Ty::extend(tys, all, Nil, trivial, xs))) =
            Ty::uncurry(tys, all, res, h, xs), guarded, st, len);
    let moved: (q2(64, n0) = words_of(q2, ns2).head_or(BitVec::zero())) =
        j(sym(ns_at), λ l _ => q2(64, n0) = words_of(q2, l).head_or(BitVec::zero()), refl);
    // `moved` as the unfolded evaluation spells it.
    let moved_over: (t2.region.eval_over(w.spans, call, q, 64, n0) = words_of(q2, ns2).head_or(BitVec::zero())) = moved;
    simp_only(Fun::post_exhausted(x, t2.next, o0, Compose(t2.region, nodes_region([Move(64, t2.next, n0)])), call, w.spans, values, os, st),
        nodes_region, Region::eval, Node::step, Valuation::set_here, moved_over,
        sym(at_st(first, λ ys _ lt => false_elim(Nat::lt_of_lt_of_le(m(ys), m(st), 0, lt, hz)))),
        sym(ran.right(λ (ys: List<BitVec(64)>) => Tm::into(tys, res, first(ys)))), Tm::out_into(tys, res, er), Tm::leave_first)
}

// A measured recursion's loop computes it, from its bound and `Guarded`.
theorem Fun::measured_sound(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: Tm, res: Ty, w: World, lent: Nat,
    h: Ty::Arrows(w.tys, ks ++ Cons(w0, wrest), res), m: List<BitVec(64)> → Nat, bounded: Fun::Bounded(ks ++ Cons(w0, wrest), m),
    guarded: Fun::Guarded(ks ++ Cons(w0, wrest), res, body, w, h, m)):
    Fun::MeasuredHolds(ks ++ Cons(w0, wrest), res, w, h, Fun::lower_measured(ks, w0, wrest, body, res, w, lent)) {
    let ws = Cons(w0, wrest);
    let all = ks ++ ws;
    let tys = w.tys;
    let P = λ (o: Option<Function>) => Fun::MeasuredHolds(all, res, w, h, o);
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil);
    let flag = Fun::meas_flag(all, ws);
    let kept = Fun::meas_kept(all, ks);
    let ns = Fun::meas_ns(all, ws);
    Option::and_then_elim(P, trivial, Ty::check_one_words(w.tys, all), λ _ => res.check_one_word(w.tys).and_then(λ _ =>
        Tm::lower_tail(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            Fun::meas_tail2(all, ks, ws, res, body, w, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2))))),
        λ ok _ =>
    Option::and_then_elim(P, trivial, res.check_one_word(w.tys), λ _ =>
        Tm::lower_tail(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t =>
            Fun::meas_tail2(all, ks, ws, res, body, w, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
                Some(Fun::meas_code(all, ks, ws, lent, t, t2)))),
        λ er _ =>
    Option::and_then_elim(P, trivial, Tm::lower_tail(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1),
        λ t => Fun::meas_tail2(all, ks, ws, res, body, w, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
            Some(Fun::meas_code(all, ks, ws, lent, t, t2))),
        λ t lowered =>
    Option::and_then_elim(P, trivial, Fun::meas_tail2(all, ks, ws, res, body, w, t.next + 2, Fun::past(all, t.next + 2)),
        λ t2 => Some(Fun::meas_code(all, ks, ws, lent, t, t2)), λ t2 lowered2 =>
        λ call agree xs len => {
            let bnd = Fun::meas_bnd(all);
            let ps = Fun::meas_ps(all);
            let c = Fun::meas_c(all);
            let o = t.next + 2;
            let x = Fun::past(all, o);
            let o0 = Fun::past(ks, o);
            let ids = Fun::param_ids(all, 0);
            let values0 = Valuation::bind(Valuation::zero(), ids, xs);
            let values1 = Valuation::set(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()));
            let exhausted = Compose(t2.region, nodes_region([Move(64, t2.next, x + 1)]));
            let post = Fun::post(x, t2.next, o0, exhausted);
            let fin = loop_finish_over(w.spans, post, call, values1, Fun::param_ids(all, o), x, t2.next);
            let step = λ (pass: Valuation()) => Fun::meas_pass(all, ws, t).eval(call, pass, buffers := w.spans);
            let st0 = words_of(values1, ids);
            let len_ids: (ids.len() = xs.len()) = trans(Fun::ids_len(all, 0), sym(len));
            let bnd_out = Fun::absent_ids(all, 0, bnd, Inr(bnd.le_refl()));
            let read: (st0 = xs) = trans(words_agree(ids, values0, values1, λ y mem =>
                    Valuation::set_other(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64, y, λ e => absent_mem(bnd, ids, bnd_out, y, mem, sym(e)))),
                words_of_bind(Valuation::zero(), ids, Fun::ids_distinct(all, 0), xs, len_ids));
            let passes_below: (Fun::meas_passes() < Nat::pow(2, 64)) = trivial;
            let at_bound: (values1(64, bnd).toNat() = Fun::meas_passes()) = trans(
                cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(values0, bnd, λ wd => BitVec::ofNat(Fun::meas_passes()), 64)),
                BitVec::toNat_ofNat(64, Fun::meas_passes(), passes_below));
            let len0: (st0.len() = all.len()) = trans(words_of_len(values1, ids), Fun::ids_len(all, 0));
            let measured0: (m(st0) < Nat::pow(2, 64)) = Ty::for_words_at(all, λ (ys: List<BitVec(64)>) => m(ys) < Nat::pow(2, 64), bounded, st0, len0);
            let start: (m(st0) < values1(64, bnd).toNat() + 1) = j(sym(at_bound), λ b _ => m(st0) < b + 1, measured0);
            // The outputs are the kept words' and then the moved ones', the
            // first of those at `o0`, below the exhausted bit.
            let x_at: (x = Fun::past(ws, o0)) = Fun::past_append(ks, ws, o);
            let o_x: (o0 < x) = j(sym(x_at), λ y _ => o0 < y,
                Nat::lt_of_lt_of_le(o0, o0 + 1, Fun::past(wrest, o0 + 1), o0.lt_succ_self(), Fun::past_ge(wrest, o0 + 1)));
            let os_at: (Fun::param_ids(all, o) = Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1))) = Fun::ids_append(ks, ws, o);
            let kept_len = λ (v: Valuation()) => trans(Fun::ids_len(ks, o), sym(trans(words_of_len(v, kept), Fun::ids_len(ks, bnd + 1))));
            let left = λ (v: Valuation()) =>
                j(sym(os_at), λ os _ => loop_finish_over(w.spans, post, call, values1, os, x, t2.next,
                        LoopEnd(words_of(v, Fun::meas_next(all, ks, ws)), False)) = v(64, c + 1),
                    j(sym(Fun::words_append(v, kept, ns)), λ state _ => loop_finish_over(w.spans, post, call, values1,
                            Fun::param_ids(ks, o) ++ Cons(o0, Fun::param_ids(wrest, o0 + 1)), x, t2.next, LoopEnd(state, False)) = v(64, c + 1),
                        Fun::post_left(x, t2.next, o0, Fun::param_ids(ks, o), Fun::param_ids(wrest, o0 + 1), exhausted, call, w.spans, values1,
                            words_of(v, kept), v(64, c + 1), words_of(v, Fun::param_ids(wrest, c + 2)), Nat::ne_of_gt(x, o0, o_x),
                            Fun::absent_ids(ks, o, o0, Inr(o0.le_refl())), kept_len(v))));
            let agreed = loop_eval_agrees_measured(step, ps, c, t.next + 1, Fun::meas_next(all, ks, ws), Fun::ids_distinct(all, bnd + 1), fin, m,
                λ (r: Nat) (state: List<BitVec(64)>) _ => Ty::uncurry(tys, all, res, h, state),
                λ v hz => Fun::meas_zero_sound(ks, ws, res, body, w, h, ok, er, m, guarded, o, x, o0, t2, lowered2, refl, x + 1,
                    Fun::param_ids(wrest, x + 2), refl, call, agree, values1, words_of(v, ps),
                    trans(words_of_len(v, ps), Fun::ids_len(all, bnd + 1)), hz),
                λ r v hr earlier => Fun::meas_pass_sound(ks, ws, res, body, w, h, ok, er, m, guarded, t, lowered, call, agree, fin, left, r, v, hr, earlier),
                values1(64, bnd).toNat(), st0, trans(len0, sym(Fun::ids_len(all, bnd + 1))), start);
            trans(agreed, cong_fn(λ (l: List<BitVec(64)>) => Ty::uncurry(tys, all, res, h, l), read))
        }))))
}

// ---------------------------------------------------------------------------
// `Guarded` at every world of a family at once (docs/native/native-one-compiler-design.md
// §2.3). A function over a lent span is one function at each file, and its
// own `f::ext` asks its two recursions to agree at every span, because
// `decreases` takes every parameter into the recursor, the span among them
// (issues/decreases-generalizes-fixed-parameters.md). So what such a
// function proves from `f::ext` is this: `again` answers at every index and
// agrees with the function below the measure at every index. It gives
// `Guarded` at each index, the loop's theorem as it stands, by answering
// with the function wherever the hypothesis speaks and with the one world's
// `again` elsewhere; the body's meaning reads its recursion pointwise
// (`Tm::tail_sem_ext`).

fn Fun::GuardedAt<I>(ws: List<Ty>, res: Ty, body: Tm, worlds: I → World, h: (i: I) → Ty::Arrows(worlds(i).tys, ws, res),
    m: I → List<BitVec(64)> → Nat) → Type {
    (i: I) → Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (again: I → List<BitVec(64)> → BitVec(64)) →
        ((i2: I) → (ys: List<BitVec(64)>) → ys.len() = ws.len() → m(i2, ys) < m(i, xs) →
            again(i2, ys) = Ty::uncurry(worlds(i2).tys, ws, res, h(i2), ys)) →
        Tm::out(worlds(i).tys, res, body.tail_sem(worlds(i), 0, res, λ (ys: List<BitVec(64)>) => Tm::into(worlds(i).tys, res, again(i, ys)),
            Ty::bind_onto(ws, Nil), Ty::extend(worlds(i).tys, ws, Nil, trivial, xs))) = Ty::uncurry(worlds(i).tys, ws, res, h(i), xs))
}

theorem Fun::pick_same(b: Bool, yes, no: BitVec(64), same: b = True → yes = no): (match b { False => no, True => yes }) = no {
    (match b as λ c => (c = True → yes = no) → (match c { False => no, True => yes }) = no { False => λ _ => refl, True => λ s => s(refl) })(same)
}

// The family with its recursion keyed apart from its worlds. A file is a
// world, and a function lent a span is one function at each *span*: two
// files with one span 0 are two worlds and one function. So the worlds are
// indexed by `I` (the files) and the recursion by `K` (the spans), `key`
// reading an index's key and `value` being the function at a key, in words;
// `again` answers at every key, which is what `f::ext` can use, and a
// pass's own recursion is `again` at its world's key. `Fun::GuardedAt` is
// this with the worlds their own keys.
//
// It is what gives `Guarded` at a file as the file stands, with no
// comparison of the body's meaning at two spellings of one file
// (issues/runtime-measured-instance-conversion-budget.md): `meets` is the
// only place the two indices meet, and it is about the function alone.
fn Fun::GuardedBy<I, K>(ws: List<Ty>, res: Ty, body: Tm, worlds: I → World, h: (i: I) → Ty::Arrows(worlds(i).tys, ws, res), key: I → K,
    value: K → List<BitVec(64)> → BitVec(64), m: K → List<BitVec(64)> → Nat) → Type {
    (i: I) → Ty::ForWords(ws, λ (xs: List<BitVec(64)>) => (again: K → List<BitVec(64)> → BitVec(64)) →
        ((k: K) → (ys: List<BitVec(64)>) → ys.len() = ws.len() → m(k, ys) < m(key(i), xs) → again(k, ys) = value(k, ys)) →
        Tm::out(worlds(i).tys, res, body.tail_sem(worlds(i), 0, res, λ (ys: List<BitVec(64)>) => Tm::into(worlds(i).tys, res, again(key(i), ys)),
            Ty::bind_onto(ws, Nil), Ty::extend(worlds(i).tys, ws, Nil, trivial, xs))) = Ty::uncurry(worlds(i).tys, ws, res, h(i), xs))
}

theorem Fun::guarded_by<I, K>(ws: List<Ty>, res: Ty, body: Tm, worlds: I → World, h: (i: I) → Ty::Arrows(worlds(i).tys, ws, res), key: I → K,
    value: K → List<BitVec(64)> → BitVec(64), m: K → List<BitVec(64)> → Nat,
    meets: (i: I) → (ys: List<BitVec(64)>) → value(key(i), ys) = Ty::uncurry(worlds(i).tys, ws, res, h(i), ys),
    guarded: Fun::GuardedBy(ws, res, body, worlds, h, key, value, m), i: I):
    Fun::Guarded(ws, res, body, worlds(i), h(i), m(key(i))) {
    let w = worlds(i);
    let ctx = Ty::bind_onto(ws, Nil);
    Ty::for_words_of(ws, λ (xs: List<BitVec(64)>) => (again: List<BitVec(64)> → BitVec(64)) →
        ((ys: List<BitVec(64)>) → ys.len() = ws.len() → m(key(i), ys) < m(key(i), xs) → again(ys) = Ty::uncurry(w.tys, ws, res, h(i), ys)) →
        Tm::out(w.tys, res, body.tail_sem(w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(w.tys, res, again(ys)), ctx,
            Ty::extend(w.tys, ws, Nil, trivial, xs))) = Ty::uncurry(w.tys, ws, res, h(i), xs),
        λ xs len again hyp => {
            // Where the family's hypothesis speaks: a state of the words'
            // length, below the measure.
            let below = λ (k: K) (ys: List<BitVec(64)>) => ys.len().same(ws.len()) && (m(k, ys) + 1).leb(m(key(i), xs));
            let every = λ (k: K) (ys: List<BitVec(64)>) => match below(k, ys) {
                False => again(ys),
                True => value(k, ys),
            };
            let at_xs = Ty::for_words_at(ws, λ (zs: List<BitVec(64)>) => (again2: K → List<BitVec(64)> → BitVec(64)) →
                ((k: K) → (ys: List<BitVec(64)>) → ys.len() = ws.len() → m(k, ys) < m(key(i), zs) → again2(k, ys) = value(k, ys)) →
                Tm::out(w.tys, res, body.tail_sem(w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(w.tys, res, again2(key(i), ys)), ctx,
                    Ty::extend(w.tys, ws, Nil, trivial, zs))) = Ty::uncurry(w.tys, ws, res, h(i), zs), guarded(i), xs, len);
            let got = at_xs(every, λ k ys len_ys lt =>
                cong_fn(λ (c: Bool) => match c { False => again(ys), True => value(k, ys) },
                    eq2(λ (p: Bool) (q: Bool) => p && q, j(len_ys, λ n _ => ys.len().same(n) = True, ys.len().same_self()),
                        Nat::leb_true(m(k, ys) + 1, m(key(i), xs), lt))));
            let here = λ (ys: List<BitVec(64)>) => Fun::pick_same(below(key(i), ys), value(key(i), ys), again(ys), λ yes => {
                let both = Bool::is_true_and(ys.len().same(ws.len()), (m(key(i), ys) + 1).leb(m(key(i), xs)), j(sym(yes), λ c _ => c.IsTrue(), trivial));
                trans(meets(i, ys), sym(hyp(ys, Nat::same_sound(ys.len(), ws.len(), eq_true_of_is_true(ys.len().same(ws.len()), both.left)),
                    Nat::leb_sound(m(key(i), ys) + 1, m(key(i), xs), both.right))))
            });
            trans(cong_fn(λ (v: res.sem(w.tys)) => Tm::out(w.tys, res, v),
                    sym(Tm::tail_sem_ext(body, w, 0, res, λ (ys: List<BitVec(64)>) => Tm::into(w.tys, res, every(key(i), ys)),
                        λ (ys: List<BitVec(64)>) => Tm::into(w.tys, res, again(ys)),
                        λ ys => cong_fn(λ (x: BitVec(64)) => Tm::into(w.tys, res, x), here(ys)), ctx, Ty::extend(w.tys, ws, Nil, trivial, xs)))),
                got)
        })
}

theorem Fun::guarded_at<I>(ws: List<Ty>, res: Ty, body: Tm, worlds: I → World, h: (i: I) → Ty::Arrows(worlds(i).tys, ws, res),
    m: I → List<BitVec(64)> → Nat, guarded: Fun::GuardedAt(ws, res, body, worlds, h, m), i: I):
    Fun::Guarded(ws, res, body, worlds(i), h(i), m(i)) {
    Fun::guarded_by(ws, res, body, worlds, h, λ (i2: I) => i2, λ (i2: I) (ys: List<BitVec(64)>) => Ty::uncurry(worlds(i2).tys, ws, res, h(i2), ys), m,
        λ i2 ys => refl, guarded, i)
}

// The loop's theorem at each world of the family.
theorem Fun::measured_sound_at<I>(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: Tm, res: Ty, worlds: I → World, lent: Nat,
    h: (i: I) → Ty::Arrows(worlds(i).tys, ks ++ Cons(w0, wrest), res), m: I → List<BitVec(64)> → Nat,
    bounded: (i: I) → Fun::Bounded(ks ++ Cons(w0, wrest), m(i)),
    guarded: Fun::GuardedAt(ks ++ Cons(w0, wrest), res, body, worlds, h, m), i: I):
    Fun::MeasuredHolds(ks ++ Cons(w0, wrest), res, worlds(i), h(i), Fun::lower_measured(ks, w0, wrest, body, res, worlds(i), lent)) {
    Fun::measured_sound(ks, w0, wrest, body, res, worlds(i), lent, h(i), m(i), bounded(i),
        Fun::guarded_at(ks ++ Cons(w0, wrest), res, body, worlds, h, m, guarded, i))
}

// ---------------------------------------------------------------------------
// The default setup's lowering, by the function's shape (design §16.11): a
// fuel recursion and a measured one are loops, everything else the plain
// lowering. What a lowering promises depends on the shape too: the plain
// one, the function's meaning; a loop, any function that satisfies its
// recursion's equations, which the generator proves for the function
// itself (`Fun::fuel_sound`, `Fun::measured_sound`).

inductive RtShape {
    Plain,
    // `h(fuel: Nat, w0, wrest…) → BitVec(64)`, its body the fuel's `match`.
    Fuel(w0: Ty, wrest: List<Ty>, zero: Tm, succ: Tm),
    // `h(k…, w0, wrest…) → BitVec(64)` calling itself: a `decreases`
    // function's body as written. Its first words `ks` every pass hands on
    // in place: the homes of the spans the function is lent.
    Measured(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: Tm),
}

// Whether a term calls the function itself (entry 0).
fn Tm::calls_self(self t: Tm) → Bool {
    match t {
        Let(e, body) => e.calls_self() || body.calls_self(),
        If(_, yes, no) => yes.calls_self() || no.calls_self(),
        IfEq(_, yes, no) => yes.calls_self() || no.calls_self(),
        Call(f, _) => match f { Zero => True, Succ(_) => False },
        Case(_, zero, succ) => zero.calls_self() || succ.calls_self(),
        _ => False,
    }
}

fn Fun::shape_words(p: Ty, rest: List<Ty>, body: Tm) → RtShape {
    match p {
        Count => match rest {
            Nil => Plain,
            Cons(w0, wrest) => match body { Case(_, zero, succ) => Fuel(w0, wrest, zero, succ), _ => Plain },
        },
        _ => match body.calls_self() { True => Measured(Nil, p, rest, body), False => Plain },
    }
}

// A loop returns a word or a type held in one (its repr's, which the
// lowering checks against the table); anything else is plain, for the
// judgment to refuse.
fn Fun::shape_lent(ks, moved: List<Ty>, body: Tm) → RtShape {
    match moved {
        Nil => Plain,
        Cons(p, rest) => match body.calls_self() { True => Measured(ks, p, rest, body), False => Plain },
    }
}

// A function lent spans takes each one's home as two words before its own
// (`Fun.lent`); a loop over them is a measured one that keeps them.
fn Fun::shape_params(self f: Fun) → RtShape {
    match f.lent {
        Zero => match f.params { Nil => Plain, Cons(p, rest) => Fun::shape_words(p, rest, f.body) },
        Succ(_) => Fun::shape_lent(f.params.take(f.lent + f.lent), f.params.drop(f.lent + f.lent), f.body),
    }
}

fn Fun::shape(self f: Fun) → RtShape {
    match f.result {
        Word(_) => f.shape_params(),
        Named(_) => f.shape_params(),
        _ => Plain,
    }
}

fn Fun::lower_at(self f: Fun, w: World, s: RtShape) → Option<Function> {
    match s {
        Plain => f.lower(w),
        Fuel(w0, wrest, zero, succ) => Fun::lower_fuel(w0, wrest, zero, succ, f.result, w),
        Measured(ks, w0, wrest, body) => Fun::lower_measured(ks, w0, wrest, body, f.result, w, f.lent),
    }
}

// The default setup's lowering.
fn Fun::lower_any(self f: Fun, w: World) → Option<Function> { f.lower_at(w, f.shape()) }

// The loops' lowerings read the world as the plain one does: its type table
// and signatures (`Tm::lower_static`, lib/native/runtime/rt_lower.hthr).

theorem Tm::self_args_static(w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, g: List<Ty>, ports: List<Nat>, args: List<Nat>):
    Tm::self_args(w.over(cs, spans), g, ports, args) = Tm::self_args(w, g, ports, args) {
    match args {
        Nil => refl,
        Cons(a, more) => cong_fn(λ (o: Option<List<Nat>>) => port_at(ports, a).and_then(λ q =>
            Ty::at(g, a).check_one_word(w.tys).and_then(λ _ => o.and_then(λ qs => Some(Cons(q, qs))))),
            Tm::self_args_static(w, cs, spans, g, ports, more)),
    }
}

theorem Tm::lower_leaf_static(t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, res: Ty, flag: Nat, nexts: List<Nat>,
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::lower_leaf(t, w.over(cs, spans), res, flag, nexts, g, ports, next) = Tm::lower_leaf(t, w, res, flag, nexts, g, ports, next) {
    let v = w.over(cs, spans);
    trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(λ l => t.ty(v, g).check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l))),
            Tm::lower_static(t, w, cs, spans, g, ports, next)),
        Option::and_then_ext(Tm::lower(t, w, g, ports, next), λ l => t.ty(v, g).check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l)),
            λ l => t.ty(w, g).check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l)),
            λ l => cong_fn(λ (a: Ty) => a.check(res).and_then(λ _ => Tm::leave_at(flag, nexts, l)), Tm::ty_static(t, w, cs, spans, g))))
}

// A pass's two arms, each lowered alike at both worlds.
theorem Tm::tail_if_static(c: Nat, yes, no: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, skip: Nat, res: Ty, flag: Nat,
    kept, nexts: List<Nat>, g: List<Ty>, ports: List<Nat>, next: Nat,
    same_yes: (n: Nat) → Tm::lower_tail(yes, w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, n) =
        Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, n),
    same_no: (n: Nat) → Tm::lower_tail(no, w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, n) =
        Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, n)):
    Tm::lower_tail(yes, w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
        Tm::lower_tail(no, w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))) =
    Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next).and_then(λ ly =>
        Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln))) {
    let v = w.over(cs, spans);
    let rest_v = λ (ly: Lowered) => Tm::lower_tail(no, v, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln =>
        Tm::tail_branch(g, ports, c, flag, nexts, ly, ln));
    let rest_w = λ (ly: Lowered) => Tm::lower_tail(no, w, skip, res, flag, kept, nexts, g, ports, ly.next).and_then(λ ln =>
        Tm::tail_branch(g, ports, c, flag, nexts, ly, ln));
    trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), same_yes(next)),
        Option::and_then_ext(Tm::lower_tail(yes, w, skip, res, flag, kept, nexts, g, ports, next), rest_v, rest_w, λ ly =>
            cong_fn(λ (o: Option<Lowered>) => o.and_then(λ ln => Tm::tail_branch(g, ports, c, flag, nexts, ly, ln)), same_no(ly.next))))
}

theorem Tm::lower_tail_static(self t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, skip: Nat, res: Ty, flag: Nat,
    kept, nexts: List<Nat>): (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
    Tm::lower_tail(t, w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, next) = Tm::lower_tail(t, w, skip, res, flag, kept, nexts, g, ports, next) {
    match t {
        Var(i) => λ g ports next => Tm::lower_leaf_static(Var(i), w, cs, spans, res, flag, nexts, g, ports, next),
        Lit(c, n) => λ g ports next => Tm::lower_leaf_static(Lit(c, n), w, cs, spans, res, flag, nexts, g, ports, next),
        Prim(op, args) => λ g ports next => Tm::lower_leaf_static(Prim(op, args), w, cs, spans, res, flag, nexts, g, ports, next),
        Make(i, args) => λ g ports next => Tm::lower_leaf_static(Make(i, args), w, cs, spans, res, flag, nexts, g, ports, next),
        Field(i, k, of) => λ g ports next => Tm::lower_leaf_static(Field(i, k, of), w, cs, spans, res, flag, nexts, g, ports, next),
        Fold(over, init, step) => λ g ports next => Tm::lower_leaf_static(Fold(over, init, step), w, cs, spans, res, flag, nexts, g, ports, next),
        Case(c, zero, succ) => λ g ports next => Tm::lower_leaf_static(Case(c, zero, succ), w, cs, spans, res, flag, nexts, g, ports, next),
        Byte(k, i, length) => λ g ports next => Tm::lower_leaf_static(Byte(k, i, length), w, cs, spans, res, flag, nexts, g, ports, next),
        Call(f, args) => match f as λ f2 => (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
            Tm::lower_tail(Call(f2, args), w.over(cs, spans), skip, res, flag, kept, nexts, g, ports, next) =
                Tm::lower_tail(Call(f2, args), w, skip, res, flag, kept, nexts, g, ports, next) {
            Zero => λ g ports next => cong_fn(λ (o: Option<List<Nat>>) => o.and_then(λ qs => Tm::lower_again(flag, kept, nexts, next, qs)),
                Tm::self_args_static(w, cs, spans, g, ports, args.drop(skip))),
            Succ(h) => λ g ports next => Tm::lower_leaf_static(Call(h + 1, args), w, cs, spans, res, flag, nexts, g, ports, next),
        },
        Let(e, body) => λ g ports next => {
            let v = w.over(cs, spans);
            let rest_v = λ (le: Lowered) => Tm::lower_tail(body, v, skip, res, flag, kept, nexts, Cons(Tm::ty(e, v, g), g), Cons(le.result, ports),
                le.next).and_then(λ lb => Tm::compose(le, lb));
            let rest_w = λ (le: Lowered) => Tm::lower_tail(body, w, skip, res, flag, kept, nexts, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports),
                le.next).and_then(λ lb => Tm::compose(le, lb));
            trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), Tm::lower_static(e, w, cs, spans, g, ports, next)),
                Option::and_then_ext(Tm::lower(e, w, g, ports, next), rest_v, rest_w, λ le =>
                    cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lb => Tm::compose(le, lb)),
                        trans(cong_fn(λ (a: Ty) => Tm::lower_tail(body, v, skip, res, flag, kept, nexts, Cons(a, g), Cons(le.result, ports), le.next),
                                Tm::ty_static(e, w, cs, spans, g)),
                            Tm::lower_tail_static(body, w, cs, spans, skip, res, flag, kept, nexts, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports),
                                le.next)))))
        },
        If(c, yes, no) => λ g ports next => Tm::tail_if_static(c, yes, no, w, cs, spans, skip, res, flag, kept, nexts, g, ports, next,
            λ n => Tm::lower_tail_static(yes, w, cs, spans, skip, res, flag, kept, nexts, g, ports, n),
            λ n => Tm::lower_tail_static(no, w, cs, spans, skip, res, flag, kept, nexts, g, ports, n)),
        IfEq(c, yes, no) => λ g ports next => Tm::tail_if_static(c, yes, no, w, cs, spans, skip, res, flag, kept, nexts, g, ports, next,
            λ n => Tm::lower_tail_static(yes, w, cs, spans, skip, res, flag, kept, nexts, g, ports, n),
            λ n => Tm::lower_tail_static(no, w, cs, spans, skip, res, flag, kept, nexts, g, ports, n)),
    }
}

theorem Fun::lower_fuel_static(w0: Ty, wrest: List<Ty>, zero, succ: Tm, res: Ty, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>):
    Fun::lower_fuel(w0, wrest, zero, succ, res, w.over(cs, spans)) = Fun::lower_fuel(w0, wrest, zero, succ, res, w) {
    let v = w.over(cs, spans);
    let ws = Cons(w0, wrest);
    let finish = λ (t: Lowered) => trans(
        cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lz => zero.ty(v, Fun::fuel_ctx(ws)).check(res).and_then(λ _ => Some(Fun::fuel_code(ws, t, lz)))),
            Tm::lower_static(zero, w, cs, spans, Fun::fuel_ctx(ws), Fun::ports_onto(ws, t.next + 3, [t.next + 2]),
                Fun::past(ws, t.next + 3) + 1)),
        Option::and_then_ext(Fun::fuel_zero_at(ws, zero, w, t),
            λ lz => zero.ty(v, Fun::fuel_ctx(ws)).check(res).and_then(λ _ => Some(Fun::fuel_code(ws, t, lz))),
            λ lz => zero.ty(w, Fun::fuel_ctx(ws)).check(res).and_then(λ _ => Some(Fun::fuel_code(ws, t, lz))),
            λ lz => cong_fn(λ (a: Ty) => a.check(res).and_then(λ _ => Some(Fun::fuel_code(ws, t, lz))), Tm::ty_static(zero, w, cs, spans, Fun::fuel_ctx(ws)))));
    let pass: (Tm::lower_tail(succ, v, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
            Fun::fuel_flag(ws) + 1).and_then(λ t => Fun::fuel_finish(ws, res, zero, v, t)) =
        Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
            Fun::fuel_flag(ws) + 1).and_then(λ t => Fun::fuel_finish(ws, res, zero, w, t))) = trans(
        cong_fn(λ (o: Option<Lowered>) => o.and_then(λ t => Fun::fuel_finish(ws, res, zero, v, t)),
            Tm::lower_tail_static(succ, w, cs, spans, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
                Fun::fuel_flag(ws) + 1)),
        Option::and_then_ext(Tm::lower_tail(succ, w, 1, res, Fun::fuel_flag(ws), Nil, Fun::fuel_ns(ws), Cons(Count, Fun::fuel_ctx(ws)), Fun::fuel_ports(ws),
                Fun::fuel_flag(ws) + 1), λ t => Fun::fuel_finish(ws, res, zero, v, t), λ t => Fun::fuel_finish(ws, res, zero, w, t), finish));
    cong_fn(λ (o: Option<Function>) => Ty::check_one_words(w.tys, ws).and_then(λ _ => res.check_one_word(w.tys).and_then(λ _ => o)), pass)
}

theorem Fun::lower_measured_static(ks: List<Ty>, w0: Ty, wrest: List<Ty>, body: Tm, res: Ty, w: World, cs: Sig::Sems(w.tys, w.sigs),
    spans: List<List<BitVec(8)>>, lent: Nat):
    Fun::lower_measured(ks, w0, wrest, body, res, w.over(cs, spans), lent) = Fun::lower_measured(ks, w0, wrest, body, res, w, lent) {
    let v = w.over(cs, spans);
    let ws = Cons(w0, wrest);
    let all = ks ++ ws;
    let ctx = Ty::bind_onto(all, Nil);
    let ports = Fun::ports_onto(all, Fun::meas_bnd(all) + 1, Nil);
    let flag = Fun::meas_flag(all, ws);
    let kept = Fun::meas_kept(all, ks);
    let ns = Fun::meas_ns(all, ws);
    let second = λ (u: World) (t: Lowered) => Fun::meas_tail2(all, ks, ws, res, body, u, t.next + 2, Fun::past(all, t.next + 2)).and_then(λ t2 =>
        Some(Fun::meas_code(all, ks, ws, lent, t, t2)));
    let pass: (Tm::lower_tail(body, v, 0, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t => second(v, t)) =
        Tm::lower_tail(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1).and_then(λ t => second(w, t))) = trans(
        cong_fn(λ (o: Option<Lowered>) => o.and_then(λ t => second(v, t)),
            Tm::lower_tail_static(body, w, cs, spans, 0, res, flag, kept, ns, ctx, ports, flag + 1)),
        Option::and_then_ext(Tm::lower_tail(body, w, 0, res, flag, kept, ns, ctx, ports, flag + 1), λ t => second(v, t), λ t => second(w, t), λ t =>
            cong_fn(λ (o: Option<Lowered>) => o.and_then(λ t2 => Some(Fun::meas_code(all, ks, ws, lent, t, t2))),
                Tm::lower_tail_static(body, w, cs, spans, 0, res, Fun::meas_flag2(ws, Fun::past(all, t.next + 2)),
                    Fun::param_ids(ks, t.next + 2), Fun::meas_ns2(ws, Fun::past(all, t.next + 2)), ctx,
                    Fun::ports_onto(all, t.next + 2, Nil), Fun::meas_flag2(ws, Fun::past(all, t.next + 2)) + 1))));
    cong_fn(λ (o: Option<Function>) => Ty::check_one_words(w.tys, all).and_then(λ _ => res.check_one_word(w.tys).and_then(λ _ => o)), pass)
}

theorem Fun::lower_any_static(self f: Fun, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>):
    f.lower_any(w.over(cs, spans)) = f.lower_any(w) {
    match f.shape() as λ s => f.lower_at(w.over(cs, spans), s) = f.lower_at(w, s) {
        Plain => Fun::lower_static(f, w, cs, spans),
        Fuel(w0, wrest, zero, succ) => Fun::lower_fuel_static(w0, wrest, zero, succ, f.result, w, cs, spans),
        Measured(ks, w0, wrest, body) => Fun::lower_measured_static(ks, w0, wrest, body, f.result, w, cs, spans, f.lent),
    }
}

// What a lowering of the shape promises. A loop's promise is about any `h`
// that satisfies its equations; the generator gives the function itself.
fn Fun::HoldsAt(self f: Fun, w: World, s: RtShape, r: Option<Function>) → Type {
    match s {
        Plain => f.LowerHolds(w, r),
        Fuel(w0, wrest, zero, succ) => (h: Nat → Ty::Arrows(w.tys, Cons(w0, wrest), f.result)) →
            Fun::FuelZero(Cons(w0, wrest), f.result, zero, w, h) → ((n: Nat) → Fun::FuelStep(Cons(w0, wrest), f.result, succ, w, h, n)) →
            Fun::FuelHolds(Cons(w0, wrest), f.result, w, h, r),
        Measured(ks, w0, wrest, body) => (h: Ty::Arrows(w.tys, ks ++ Cons(w0, wrest), f.result)) → (m: List<BitVec(64)> → Nat) →
            Fun::Bounded(ks ++ Cons(w0, wrest), m) → Fun::Guarded(ks ++ Cons(w0, wrest), f.result, body, w, h, m) →
            Fun::MeasuredHolds(ks ++ Cons(w0, wrest), f.result, w, h, r),
    }
}

fn Fun::Holds(self f: Fun, w: World, r: Option<Function>) → Type { f.HoldsAt(w, f.shape(), r) }

// The default setup's soundness, proved once: the plain lowering's and the
// two loops'.
theorem Fun::lower_any_sound(self f: Fun, w: World): f.Holds(w, f.lower_any(w)) {
    match f.shape() as λ s => f.HoldsAt(w, s, f.lower_at(w, s)) {
        Plain => f.lower_sound(w),
        Fuel(w0, wrest, zero, succ) => λ h z st => Fun::fuel_sound(w0, wrest, zero, succ, f.result, w, h, z, st),
        Measured(ks, w0, wrest, body) => λ h m b g => Fun::measured_sound(ks, w0, wrest, body, f.result, w, f.lent, h, m, b, g),
    }
}

// What answers like an uncurried meaning on as many words as parameters
// answers like the meaning (the converse of `Ty::answers_at`).
theorem Ty::answers_of_uncurry(tys: Nat → RecInfo, ps: List<Ty>, r: Ty): (v: Ty::Arrows(tys, ps, r)) → (ans: List<BitVec(64)> → BitVec(64)) →
    ((xs: List<BitVec(64)>) → xs.len() = ps.len() → ans(xs) = Ty::uncurry(tys, ps, r, v, xs)) → Ty::Answers(tys, ps, r, v, ans) {
    match ps {
        Nil => λ v ans h => h(Nil, refl),
        Cons(p, rest) => λ v ans h => λ x => Ty::answers_of_uncurry(tys, rest, r, v(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws)),
            λ ws len => h(Cons(x, ws), cong_fn(λ (n: Nat) => n + 1, len))),
    }
}

// A fuel loop's code answers like the function, its fuel read off its word
// as `toNat` (how a count crosses a call).
theorem Fun::fuel_answers(ws: List<Ty>, res: Ty, w: World, h: Nat → Ty::Arrows(w.tys, ws, res), r: Option<Function>,
    lowered: (match r { None => False, Some(_) => True }).IsTrue(), held: Fun::FuelHolds(ws, res, w, h, r)):
    (call: Answers()) → Tm::CallsAgree(w, call) →
    Ty::Answers(w.tys, Cons(Count, ws), res, h, λ xs => (match r { None => Function([], nodes_region(Nil), 0), Some(c) => c }).eval(call, xs, buffers := w.spans)) {
    match r as λ o => (match o { None => False, Some(_) => True }).IsTrue() → Fun::FuelHolds(ws, res, w, h, o) →
        (call: Answers()) → Tm::CallsAgree(w, call) →
        Ty::Answers(w.tys, Cons(Count, ws), res, h, λ xs => (match o { None => Function([], nodes_region(Nil), 0), Some(c) => c }).eval(call, xs, buffers := w.spans)) {
        None => λ never _ => false_elim(never),
        Some(code) => λ _ holds call agree => λ b => Ty::answers_of_uncurry(w.tys, ws, res, h(b.toNat()), λ xs => code.eval(call, Cons(b, xs), buffers := w.spans),
            λ xs len => holds(call, agree, b, xs, len)),
    }(lowered, held)
}

// A measured loop's code answers like the function.
theorem Fun::measured_answers(ws: List<Ty>, res: Ty, w: World, h: Ty::Arrows(w.tys, ws, res), r: Option<Function>,
    lowered: (match r { None => False, Some(_) => True }).IsTrue(), held: Fun::MeasuredHolds(ws, res, w, h, r)):
    (call: Answers()) → Tm::CallsAgree(w, call) →
    Ty::Answers(w.tys, ws, res, h, λ xs => (match r { None => Function([], nodes_region(Nil), 0), Some(c) => c }).eval(call, xs, buffers := w.spans)) {
    match r as λ o => (match o { None => False, Some(_) => True }).IsTrue() → Fun::MeasuredHolds(ws, res, w, h, o) →
        (call: Answers()) → Tm::CallsAgree(w, call) →
        Ty::Answers(w.tys, ws, res, h, λ xs => (match o { None => Function([], nodes_region(Nil), 0), Some(c) => c }).eval(call, xs, buffers := w.spans)) {
        None => λ never _ => false_elim(never),
        Some(code) => λ _ holds call agree => Ty::answers_of_uncurry(w.tys, ws, res, h, λ xs => code.eval(call, xs, buffers := w.spans),
            λ xs len => holds(call, agree, xs, len)),
    }(lowered, held)
}

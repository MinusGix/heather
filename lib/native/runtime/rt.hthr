// The reflected language `rt` that every `runtime fn` setup reads, and its
// typed meaning (docs/native/runtime-fn-setups-design.md §4,
// issues/runtime-fn-reflected-language.md).
//
// A runtime fn's elaborated body is reflected into a `Program`, and the
// reflection is tied to the function by one equation checked by conversion,
// the pin: `p.meaning(tys, callees, xs…) = f(xs…)` at neutral `xs`. The
// meaning unfolds once per node and lands, node for node, on the term the
// elaborator built for `f`, so the pin is `refl` and carries no case split.
//
// Two choices make that work, and both are about keeping the pin a
// conversion:
//
// - **The meaning is type-directed, by synthesis.** Every node's type is
//   computed from the codes (`Tm::ty`), and its meaning lives at that type's
//   semantics. Where two types must agree (an operand at a primitive's
//   parameter, a branch at the other branch's type, an argument at a
//   callee's parameter) the meaning casts along `Ty::equation`, which at two
//   closed codes evaluates to `refl`, so the cast vanishes and only the
//   arguments stay neutral.
// - **Operands are variables (A-normal form).** A primitive, a call or a
//   record names its operands by de Bruijn index, and every intermediate
//   value is a `Let`. So `Tm` is a plain inductive (no `List<Tm>`, which the
//   kernel route does not have yet, `nested-inductives-container-fields`),
//   and a subterm the elaborated body shares (a block's `let` is an alias,
//   docs/language/let-and-blocks-design.md §4.4) is one `Let`, read once.
//
// Records are named, not structural: a record type's kernel lowering carries
// a nominal tag no surface term can spell (docs/inductives/inductive-tier0-lowering.md
// §3.3), so `Named(i)` reads its type, constructor and fields from a table
// of `RecInfo`s the program's meaning takes, as calls read their callees'
// meanings from a table. A record's fields are flat (words, bits, bytes).

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import function_ir_operation;

// ---------------------------------------------------------------------------
// Types.

inductive Ty {
    // `BitVec(w)`.
    Word(w: Nat),
    // `Bool`.
    Bit,
    // `List<BitVec(8)>`, held in a buffer of the capacity.
    ByteList(cap: Nat),
    // `List<List<BitVec(8)>>`, a list of byte strings (a file's lines), laid
    // out as the name of its first cell in an arena (N4,
    // docs/native/native-heap-arena-design.md §7; the cells are `native_arena`'s).
    Lines,
    // The record of the type table's entry `i`.
    Named(i: Nat),
    // `Nat` held in a 64-bit word, as `w.toNat()`: a loop's fuel (design
    // §7.2: a `Nat` is accepted only where a bound is structural).
    Count,
    // The enum of the type table's entry `i` (`RecInfo.alts`), held in one
    // word as its constructor's index (design §16.16).
    Enum(i: Nat),
}

// A record field's type, read without the table: a record's fields are
// flat, and a `Named` field (refused by every judgment) means `True`.
fn Ty::Flat(self t: Ty) → Type {
    match t { Word(w) => BitVec(w), Bit => Bool, ByteList(_) => List<BitVec(8)>, Lines => List<List<BitVec(8)>>, Named(_) => True, Count => Nat, Enum(_) => True }
}

// A tuple of flat fields, `True`-terminated.
fn Ty::Flats(ts: List<Ty>) → Type {
    match ts { Nil => True, Cons(t, rest) => Pair<t.Flat(), Ty::Flats(rest)> }
}

fn Ty::flat_default(self t: Ty) → t.Flat() {
    match t { Word(_) => BitVec::ofNat(0), Bit => False, ByteList(_) => Nil, Lines => Nil, Named(_) => trivial, Count => 0, Enum(_) => trivial }
}

fn Ty::flats_default(ts: List<Ty>) → Ty::Flats(ts) {
    match ts { Nil => trivial, Cons(t, rest) => Pair(t.flat_default(), Ty::flats_default(rest)) }
}

// The codes of slots `lo` to `lo + n` of `fs`: one constructor's fields
// in an enum's payload.
fn Ty::range(fs: List<Ty>, lo, n: Nat) → List<Ty> {
    match fs {
        Nil => Nil,
        Cons(f, rest) => match lo { Succ(l) => Ty::range(rest, l, n), Zero => match n { Zero => Nil, Succ(m) => Cons(f, Ty::range(rest, 0, m)) } },
    }
}

// Those slots of a tuple.
fn Ty::take_range(fs: List<Ty>, lo, n: Nat) → Ty::Flats(fs) → Ty::Flats(Ty::range(fs, lo, n)) {
    match fs {
        Nil => λ _ => trivial,
        Cons(f, rest) => match lo as λ l => Ty::Flats(Cons(f, rest)) → Ty::Flats(Ty::range(Cons(f, rest), l, n)) {
            Succ(l) => λ t => Ty::take_range(rest, l, n, t.snd),
            Zero => match n as λ m => Ty::Flats(Cons(f, rest)) → Ty::Flats(Ty::range(Cons(f, rest), 0, m)) {
                Zero => λ _ => trivial,
                Succ(m) => λ t => Pair(t.fst, Ty::take_range(rest, 0, m, t.snd)),
            },
        },
    }
}

// Those slots put back in a tuple of defaults.
fn Ty::spread(fs: List<Ty>, lo, n: Nat) → Ty::Flats(Ty::range(fs, lo, n)) → Ty::Flats(fs) {
    match fs {
        Nil => λ _ => trivial,
        Cons(f, rest) => match lo as λ l => Ty::Flats(Ty::range(Cons(f, rest), l, n)) → Ty::Flats(Cons(f, rest)) {
            Succ(l) => λ p => Pair(f.flat_default(), Ty::spread(rest, l, n, p)),
            Zero => match n as λ m => Ty::Flats(Ty::range(Cons(f, rest), 0, m)) → Ty::Flats(Cons(f, rest)) {
                Zero => λ _ => Ty::flats_default(Cons(f, rest)),
                Succ(m) => λ p => Pair(p.fst, Ty::spread(rest, 0, m, p.snd)),
            },
        },
    }
}

// A tuple with only those slots kept, the rest defaults: what a
// constructor's value holds in its enum's payload.
fn Ty::keep(fs: List<Ty>, lo, n: Nat, t: Ty::Flats(fs)) → Ty::Flats(fs) { Ty::spread(fs, lo, n, Ty::take_range(fs, lo, n, t)) }

theorem Ty::take_spread(fs: List<Ty>): (lo, n: Nat) → (p: Ty::Flats(Ty::range(fs, lo, n))) → Ty::take_range(fs, lo, n, Ty::spread(fs, lo, n, p)) = p {
    match fs {
        Nil => λ lo n p => refl,
        Cons(f, rest) => λ lo => match lo as λ l => (n: Nat) → (p: Ty::Flats(Ty::range(Cons(f, rest), l, n))) →
                Ty::take_range(Cons(f, rest), l, n, Ty::spread(Cons(f, rest), l, n, p)) = p {
            Succ(l) => λ n p => Ty::take_spread(rest, l, n, p),
            Zero => λ n => match n as λ m => (p: Ty::Flats(Ty::range(Cons(f, rest), 0, m))) →
                    Ty::take_range(Cons(f, rest), 0, m, Ty::spread(Cons(f, rest), 0, m, p)) = p {
                Zero => λ p => refl,
                Succ(m) => λ p => cong_fn(λ (q: Ty::Flats(Ty::range(rest, 0, m))) => Pair(p.fst, q), Ty::take_spread(rest, 0, m, p.snd)),
            },
        },
    }
}

// An enum as the meaning reads it (docs/native/runtime-fn-setups-design.md
// §16.16): its type, its last constructor's index, its payload's slots
// (every constructor's fields in turn, constructor `k`'s `arity(k)` of them
// from slot `lo(k)`; none, for an enum of constructors without fields),
// the constructor at each index from a tuple of the slots (`of`, the last
// past it, reading only its own), and its own `match` as a function of the
// arms by index and fields (`pick`), which is what a `match` on it means,
// so a pin over it stays a conversion. Its tag is the `match` that answers
// the index (`EnumInfo::tag`) and its fields the one that answers the tuple
// (`EnumInfo::fields`, the other constructors' slots defaults); the laws
// are that `pick` chooses the tag's arm at the fields, that `of` builds
// back every value from its tag and fields, and that a constructor built
// from a tuple has its index and the tuple's own slots. `convoy` is its
// `match h:` (the match at a convoyed motive applied to `refl`, each arm a
// function of the equation, `matching::plan_convoy`), which does not
// convert with the plain one, and which also chooses the tag's arm.
record EnumInfo {
    E: Type, last: Nat, slots: List<Ty>, lo: Nat → Nat, arity: Nat → Nat,
    of: Nat → Ty::Flats(slots) → E,
    pick: (R: Type) → (Nat → Ty::Flats(slots) → R) → E → R,
    picks: (R: Type) → (a: Nat → Ty::Flats(slots) → R) → (v: E) →
        pick(R, a, v) = a(pick(Nat, λ n _ => n, v), pick(Ty::Flats(slots), λ _ t => t, v)),
    of_tag: (v: E) → of(pick(Nat, λ n _ => n, v), pick(Ty::Flats(slots), λ _ t => t, v)) = v,
    tag_of: (n: Nat) → n <= last → (t: Ty::Flats(slots)) → pick(Nat, λ n _ => n, of(n, t)) = n,
    fields_of: (n: Nat) → n <= last → (t: Ty::Flats(slots)) → pick(Ty::Flats(slots), λ _ u => u, of(n, t)) = Ty::keep(slots, lo(n), arity(n), t),
    convoy: (R: Type) → (Nat → Ty::Flats(slots) → R) → E → R,
    convoys: (R: Type) → (a: Nat → Ty::Flats(slots) → R) → (v: E) →
        convoy(R, a, v) = a(pick(Nat, λ n _ => n, v), pick(Ty::Flats(slots), λ _ t => t, v)),
    // Every value's tag is a constructor's: what holding a word a call
    // returned as the value it names needs.
    bounded: (v: E) → pick(Nat, λ n _ => n, v) <= last,
}

fn EnumInfo::tag(self e: EnumInfo, v: e.E) → Nat { e.pick(Nat, λ n _ => n, v) }

fn EnumInfo::fields(self e: EnumInfo, v: e.E) → Ty::Flats(e.slots) { e.pick(Ty::Flats(e.slots), λ _ t => t, v) }

// The enum's `match` (`eq` False) or its `match h:` (`eq` True).
fn EnumInfo::choose(self e: EnumInfo, eq: Bool, R: Type, a: Nat → Ty::Flats(e.slots) → R, v: e.E) → R {
    match eq { False => e.pick(R, a, v), True => e.convoy(R, a, v) }
}

// Either chooses the tag's arm, at the fields.
theorem EnumInfo::chooses(self e: EnumInfo, eq: Bool, R: Type, a: Nat → Ty::Flats(e.slots) → R, v: e.E):
    e.choose(eq, R, a, v) = a(e.tag(v), e.fields(v)) {
    match eq { False => e.picks(R, a, v), True => e.convoys(R, a, v) }
}

// The constructor a word names, its fields defaults: its index, the last
// constructor past it. Only a tag is ever passed (`EnumInfo::Names`,
// `Ty::Admits`); past the last tag this is the meaning's total reading,
// which no code reaches.
fn EnumInfo::read(self e: EnumInfo, x: BitVec(64)) → e.E { e.of(x.toNat().min(e.last), Ty::flats_default(e.slots)) }

// A word that is the tag of `v`, one of the enum's.
fn EnumInfo::Names(self e: EnumInfo, x: BitVec(64), v: e.E) → Type { (x.toNat() = e.tag(v)) ∧ (x.toNat() <= e.last) }

// No enum: what a record's entry carries.
fn EnumInfo::none() → EnumInfo {
    EnumInfo(True, 0, [], λ _ => 0, λ _ => 0, λ _ _ => trivial, λ R a _ => a(0, trivial), λ R a v => refl, λ v => refl,
        λ n => match n as λ k => k <= 0 → (t: True) → 0 = k { Zero => λ _ _ => refl, Succ(_) => λ never => false_elim(never) },
        λ n _ t => refl, λ R a _ => a(0, trivial), λ R a v => refl, λ _ => trivial)
}

// The tags of an enum of `last + 1` constructors, each with its bound.
fn EnumInfo::Fin(last: Nat) → Type { Exists<Nat>(λ n => n <= last) }

fn EnumInfo::fin(last, n: Nat, le: n <= last) → EnumInfo::Fin(last) { Exists(witness := n, proof := le) }

// A constructor of an enum of `last + 1` and its fields, as a judgment and
// a lowering read it: the enum the generator's table holds before the
// enum's own (`EnumInfo::shape`, `runtime_rec_table`).
fn EnumInfo::Val(last: Nat, slots: List<Ty>, lo, arity: Nat → Nat) → Type {
    Exists<EnumInfo::Fin(last)>(λ t => Ty::Flats(Ty::range(slots, lo(t.witness), arity(t.witness))))
}

fn EnumInfo::val(last: Nat, slots: List<Ty>, lo, arity: Nat → Nat, t: EnumInfo::Fin(last),
    p: Ty::Flats(Ty::range(slots, lo(t.witness), arity(t.witness)))) → EnumInfo::Val(last, slots, lo, arity) {
    Exists(witness := t, proof := p)
}

theorem EnumInfo::val_of_tag(last: Nat, slots: List<Ty>, lo, arity: Nat → Nat, v: EnumInfo::Val(last, slots, lo, arity)):
    EnumInfo::val(last, slots, lo, arity, EnumInfo::fin(last, v.witness.witness.min(last), Nat::min_le_r(v.witness.witness, last)),
        Ty::take_range(slots, lo(v.witness.witness.min(last)), arity(v.witness.witness.min(last)),
            Ty::spread(slots, lo(v.witness.witness), arity(v.witness.witness), v.proof))) = v {
    let w = v.witness.witness;
    let q = v.witness.proof;
    let at_w = λ (q2: w <= last) => trans(
        cong_fn(λ (u: Ty::Flats(Ty::range(slots, lo(w), arity(w)))) => EnumInfo::val(last, slots, lo, arity, EnumInfo::fin(last, w, q2), u),
            Ty::take_spread(slots, lo(w), arity(w), v.proof)),
        cong_fn(λ (r: w <= last) => EnumInfo::val(last, slots, lo, arity, EnumInfo::fin(last, w, r), v.proof), w.le_unique(last, q2, q)));
    j(sym(Nat::min_eq_l(w, last, q)), λ m _ => (q2: m <= last) →
            EnumInfo::val(last, slots, lo, arity, EnumInfo::fin(last, m, q2),
                Ty::take_range(slots, lo(m), arity(m), Ty::spread(slots, lo(w), arity(w), v.proof))) = v,
        at_w)(Nat::min_le_r(w, last))
}

fn EnumInfo::shape(last: Nat, slots: List<Ty>, lo, arity: Nat → Nat) → EnumInfo {
    EnumInfo(EnumInfo::Val(last, slots, lo, arity), last, slots, lo, arity,
        λ n t => EnumInfo::val(last, slots, lo, arity, EnumInfo::fin(last, n.min(last), Nat::min_le_r(n, last)),
            Ty::take_range(slots, lo(n.min(last)), arity(n.min(last)), t)),
        λ R a v => a(v.witness.witness, Ty::spread(slots, lo(v.witness.witness), arity(v.witness.witness), v.proof)),
        λ R a v => refl,
        λ v => EnumInfo::val_of_tag(last, slots, lo, arity, v),
        λ n le t => Nat::min_eq_l(n, last, le),
        λ n le t => j(sym(Nat::min_eq_l(n, last, le)), λ m _ =>
            Ty::spread(slots, lo(m), arity(m), Ty::take_range(slots, lo(m), arity(m), t)) = Ty::keep(slots, lo(n), arity(n), t), refl),
        λ R a v => a(v.witness.witness, Ty::spread(slots, lo(v.witness.witness), arity(v.witness.witness), v.proof)),
        λ R a v => refl,
        λ v => v.witness.proof)
}

// A tag past `last` read as `last`'s constructor: every value's tag is at
// most `last`, as `of` and the tag are inverse below it.
theorem EnumInfo::bounded_by<E, F>(last: Nat, of: Nat → F → E, tag: E → Nat, fields: E → F, of_tag: (v: E) → of(tag(v), fields(v)) = v,
    tag_of: (n: Nat) → n <= last → (t: F) → tag(of(n, t)) = n, of_min: (n: Nat) → (t: F) → of(n, t) = of(n.min(last), t)): (v: E) → tag(v) <= last {
    λ v => {
        let below = Nat::min_le_r(tag(v), last);
        let back: (tag(of(tag(v).min(last), fields(v))) = tag(v).min(last)) = tag_of(tag(v).min(last), below, fields(v));
        let same: (of(tag(v).min(last), fields(v)) = v) = trans(sym(of_min(tag(v), fields(v))), of_tag(v));
        let tagged: (tag(v) = tag(v).min(last)) = j(same, λ y _ => tag(y) = tag(v).min(last), back);
        j(sym(tagged), λ y _ => y <= last, below)
    }
}

// Every index up to `m` passes `p`.
fn Nat::all_upto(m: Nat, p: Nat → Bool) → Bool {
    match m { Zero => p(0), Succ(k) => Nat::all_upto(k, p).and(p(k + 1)) }
}

theorem Nat::all_upto_at(p: Nat → Bool, m: Nat): Nat::all_upto(m, p) = True → (n: Nat) → n <= m → p(n) = True {
    match m {
        Zero => λ all n => match n as λ k => k <= 0 → p(k) = True { Zero => λ _ => all, Succ(_) => λ never => false_elim(never) },
        Succ(k) => λ all n le => {
            let parts = Bool::and_true_parts(Nat::all_upto(k, p), p(k + 1), all);
            match n.lt_or_ge(k + 1) {
                Inl(lt) => Nat::all_upto_at(p, k, parts.left, n, lt),
                Inr(ge) => j(Nat::le_antisym(k + 1, n, ge, le), λ y _ => p(y) = True, parts.right),
            }
        },
    }
}

// Every index up to `m` has `P`, one proof each: what a generator proves
// of each constructor, each by `refl` (a `Pair`, which it builds as a
// term).
fn Nat::AllUpTo(m: Nat, P: Nat → Type) → Type {
    match m { Zero => P(0), Succ(k) => Pair<Nat::AllUpTo(k, P), P(k + 1)> }
}

theorem Nat::all_up_to_at(P: Nat → Type, m: Nat): Nat::AllUpTo(m, P) → (n: Nat) → n <= m → P(n) {
    match m {
        Zero => λ all n => match n as λ k => k <= 0 → P(k) { Zero => λ _ => all, Succ(_) => λ never => false_elim(never) },
        Succ(k) => λ all n le => match n.lt_or_ge(k + 1) {
            Inl(lt) => Nat::all_up_to_at(P, k, all.fst, n, lt),
            Inr(ge) => j(Nat::le_antisym(k + 1, n, ge, le), λ y _ => P(y), all.snd),
        },
    }
}

// A layout of the slots by each constructor's number of fields, every
// constructor's after the ones before it: where constructor `n`'s first
// field is, and how many it has.
fn EnumInfo::lo_of(arities: List<Nat>) → Nat → Nat {
    match arities { Nil => λ n => 0, Cons(a, rest) => λ n => match n { Zero => 0, Succ(m) => a + EnumInfo::lo_of(rest, m) } }
}

fn EnumInfo::arity_of(arities: List<Nat>) → Nat → Nat { λ n => arities.nth(n).unwrap_or(0) }

// An enum from its constructors in order, each a function of the slots
// reading its own, its own `match` and its laws by cases, each
// constructor's index checked by evaluation and its fields by `refl`: what
// a generator builds.
fn EnumInfo::of_ctors<E>(slots: List<Ty>, lo, arity: Nat → Nat, first: Ty::Flats(slots) → E, rest: List<Ty::Flats(slots) → E>,
    pick: (R: Type) → (Nat → Ty::Flats(slots) → R) → E → R,
    picks: (R: Type) → (a: Nat → Ty::Flats(slots) → R) → (v: E) →
        pick(R, a, v) = a(pick(Nat, λ n _ => n, v), pick(Ty::Flats(slots), λ _ t => t, v)),
    of_tag: (v: E) → Cons(first, rest).nth(pick(Nat, λ n _ => n, v).min(rest.len())).unwrap_or(first)(pick(Ty::Flats(slots), λ _ t => t, v)) = v,
    checked: (t: Ty::Flats(slots)) →
        Nat::all_upto(rest.len(), λ n => pick(Nat, λ k _ => k, Cons(first, rest).nth(n.min(rest.len())).unwrap_or(first)(t)).same(n)) = True,
    kept: (t: Ty::Flats(slots)) → Nat::AllUpTo(rest.len(), λ n =>
        pick(Ty::Flats(slots), λ _ u => u, Cons(first, rest).nth(n.min(rest.len())).unwrap_or(first)(t)) = Ty::keep(slots, lo(n), arity(n), t)),
    convoy: (R: Type) → (Nat → Ty::Flats(slots) → R) → E → R,
    convoys: (R: Type) → (a: Nat → Ty::Flats(slots) → R) → (v: E) →
        convoy(R, a, v) = a(pick(Nat, λ n _ => n, v), pick(Ty::Flats(slots), λ _ t => t, v))) → EnumInfo {
    let of = λ (n: Nat) (t: Ty::Flats(slots)) => Cons(first, rest).nth(n.min(rest.len())).unwrap_or(first)(t);
    let tag_of = λ (n: Nat) (le: n <= rest.len()) (t: Ty::Flats(slots)) =>
        Nat::same_sound(pick(Nat, λ k _ => k, Cons(first, rest).nth(n.min(rest.len())).unwrap_or(first)(t)), n,
            Nat::all_upto_at(λ m => pick(Nat, λ k _ => k, Cons(first, rest).nth(m.min(rest.len())).unwrap_or(first)(t)).same(m), rest.len(), checked(t), n, le));
    let of_min = λ (n: Nat) (t: Ty::Flats(slots)) => cong_fn(λ (m: Nat) => Cons(first, rest).nth(m).unwrap_or(first)(t),
        sym(Nat::min_eq_l(n.min(rest.len()), rest.len(), Nat::min_le_r(n, rest.len()))));
    EnumInfo(E, rest.len(), slots, lo, arity, of, pick, picks, of_tag, tag_of,
        λ n le t => Nat::all_up_to_at(λ m => pick(Ty::Flats(slots), λ _ u => u, Cons(first, rest).nth(m.min(rest.len())).unwrap_or(first)(t)) =
            Ty::keep(slots, lo(m), arity(m), t), rest.len(), kept(t), n, le),
        convoy, convoys,
        EnumInfo::bounded_by(rest.len(), of, λ v => pick(Nat, λ k _ => k, v), λ v => pick(Ty::Flats(slots), λ _ u => u, v), of_tag, tag_of, of_min))
}

// The word of a value's tag reads back as the value: what a call passing
// an enum without fields as its tag word relies on
// (docs/native/runtime-fn-setups-design.md §16.16).
theorem EnumInfo::read_tag(self e: EnumInfo, v: e.E, small: (e.last + 1).leb(Nat::pow(2, 64)) = True,
    bare: e.fields(v) = Ty::flats_default(e.slots)): e.read(BitVec::ofNat(e.tag(v))) = v {
    let le = e.bounded(v);
    let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, le),
        Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), small));
    let word: (BitVec::ofNat(e.tag(v), n := 64).toNat() = e.tag(v)) = BitVec::toNat_ofNat(64, e.tag(v), lt);
    let clamped: (BitVec::ofNat(e.tag(v), n := 64).toNat().min(e.last) = e.tag(v)) =
        j(sym(word), λ y _ => y.min(e.last) = e.tag(v), Nat::min_eq_l(e.tag(v), e.last, le));
    let back: (e.of(e.tag(v), Ty::flats_default(e.slots)) = v) = j(bare, λ t _ => e.of(e.tag(v), t) = v, e.of_tag(v));
    j(sym(clamped), λ y _ => e.of(y, Ty::flats_default(e.slots)) = v, back)
}

// A record type as the meaning reads it: the type, its fields' codes, the
// constructor and the projections as functions of the field tuple, and that
// projecting what was built gives the fields back (`refl` for a record's own
// constructor and fields, by η for pairs and `True`): what a setup that keeps
// a record as its fields relies on.
record RecInfo {
    T: Type, fields: List<Ty>, mk: Ty::Flats(fields) → T, get: T → Ty::Flats(fields),
    round: (t: Ty::Flats(fields)) → get(mk(t)) = t,
    // And building from what was read off a record is the record (`refl`
    // by η for a record's own constructor and fields): what passing a
    // record held in one word to a call relies on.
    back: (v: T) → mk(get(v)) = v,
    // The entry's enum, for an `Enum` code (none for a record's).
    alts: EnumInfo := EnumInfo::none(),
}

// The enum of table entry `i`, as a type: what a certificate quantifies an
// enum parameter over.
fn RecInfo::enum_at(tys: Nat → RecInfo, i: Nat) → Type { tys(i).alts.E }

// The record of table entry `i`, as a type: what a certificate
// quantifies a record parameter of several words over.
fn RecInfo::record_at(tys: Nat → RecInfo, i: Nat) → Type { tys(i).T }

// The word an enum of table entry `i` is passed as: its tag.
fn RecInfo::enum_word(tys: Nat → RecInfo, i: Nat, v: tys(i).alts.E) → BitVec(64) { BitVec::ofNat(tys(i).alts.tag(v)) }

// The `i`th code, `Bit` past the end (every judgment refuses that index).
fn Ty::at(ts: List<Ty>, i: Nat) → Ty {
    match ts { Nil => Bit, Cons(t, rest) => match i { Zero => t, Succ(k) => Ty::at(rest, k) } }
}

fn Ty::sem(self t: Ty, tys: Nat → RecInfo) → Type {
    match t {
        Word(w) => BitVec(w), Bit => Bool, ByteList(_) => List<BitVec(8)>, Lines => List<List<BitVec(8)>>, Named(i) => tys(i).T, Count => Nat,
        Enum(i) => tys(i).alts.E,
    }
}

// Every type is inhabited, so a meaning is total: an ill-typed node (which
// every judgment refuses) means this.
fn Ty::default(self t: Ty, tys: Nat → RecInfo) → t.sem(tys) {
    match t {
        Word(_) => BitVec::ofNat(0),
        Bit => False,
        ByteList(_) => Nil,
        Lines => Nil,
        Named(i) => tys(i).mk(Ty::flats_default(tys(i).fields)),
        Count => 0,
        Enum(i) => tys(i).alts.of(0, Ty::flats_default(tys(i).alts.slots)),
    }
}

fn Ty::to_flat(self t: Ty, tys: Nat → RecInfo) → t.sem(tys) → t.Flat() {
    match t { Word(_) => λ v => v, Bit => λ v => v, ByteList(_) => λ v => v, Lines => λ v => v, Named(_) => λ _ => trivial, Count => λ v => v, Enum(_) => λ _ => trivial }
}

fn Ty::of_flat(self t: Ty, tys: Nat → RecInfo) → t.Flat() → t.sem(tys) {
    match t {
        Word(_) => λ v => v, Bit => λ v => v, ByteList(_) => λ v => v, Lines => λ v => v, Named(i) => λ _ => Named(i).default(tys), Count => λ v => v,
        Enum(i) => λ _ => Enum(i).default(tys),
    }
}

// The code of a list's elements: a byte for a byte buffer, a byte string
// for a list of lines (`Bit`, which nothing folds, for the rest).
fn Ty::elem(self t: Ty) → Ty {
    match t { Word(_) => Bit, Bit => Bit, ByteList(_) => Word(8), Lines => ByteList(0), Named(_) => Bit, Count => Bit, Enum(_) => Bit }
}

// A list's elements, at their code (empty for a code that is no list): at
// a closed code, the value itself.
fn Ty::items(self t: Ty, tys: Nat → RecInfo) → t.sem(tys) → List<t.elem().sem(tys)> {
    match t { Word(_) => λ _ => Nil, Bit => λ _ => Nil, ByteList(_) => λ v => v, Lines => λ v => v, Named(_) => λ _ => Nil, Count => λ _ => Nil, Enum(_) => λ _ => Nil }
}

// The equation between two codes, as data: at two closed codes it
// evaluates to `refl`, so a transport along it computes (as
// `Nat::equation`'s does).
fn Ty::equation(self a: Ty, b: Ty) → (a = b) ∨ True {
    match a {
        Word(w) => match b {
            Word(v) => match w.equation(v) { Inl(e) => Inl(j(e, λ x _ => Word(w) = Word(x), refl)), Inr(_) => Inr(trivial) },
            _ => Inr(trivial),
        },
        Bit => match b { Bit => Inl(refl), _ => Inr(trivial) },
        ByteList(c) => match b {
            ByteList(d) => match c.equation(d) { Inl(e) => Inl(j(e, λ x _ => ByteList(c) = ByteList(x), refl)), Inr(_) => Inr(trivial) },
            _ => Inr(trivial),
        },
        Lines => match b { Lines => Inl(refl), _ => Inr(trivial) },
        Named(i) => match b {
            Named(k) => match i.equation(k) { Inl(e) => Inl(j(e, λ x _ => Named(i) = Named(x), refl)), Inr(_) => Inr(trivial) },
            _ => Inr(trivial),
        },
        Count => match b { Count => Inl(refl), _ => Inr(trivial) },
        Enum(i) => match b {
            Enum(k) => match i.equation(k) { Inl(e) => Inl(j(e, λ x _ => Enum(i) = Enum(x), refl)), Inr(_) => Inr(trivial) },
            _ => Inr(trivial),
        },
    }
}

// A value read as a count: a word's `toNat` (how a count held in a word
// crosses a call, docs/native/runtime-fn-setups-design.md §16.11), 0 for the rest.
fn Ty::to_count(tys: Nat → RecInfo, a: Ty) → a.sem(tys) → Nat {
    match a as λ x => x.sem(tys) → Nat {
        Word(_) => λ v => v.toNat(),
        Bit => λ _ => 0,
        ByteList(_) => λ _ => 0,
        Lines => λ _ => 0,
        Named(_) => λ _ => 0,
        Count => λ n => n,
        Enum(_) => λ _ => 0,
    }
}

// A 64-bit word read at a flat code, and a flat value read back as a
// 64-bit word: the word itself at `Word(64)` (the transport along `64 = w`
// evaluates away at a literal width); at a narrower word, its low bits, and
// the narrow word zero-extended back (how a narrow word crosses a function's
// boundary in a 64-bit one, issues/runtime-repr-narrow-words.md: the low
// bits are what binding the word gives its port at that width,
// `word_value`); the default elsewhere.
fn Ty::word_at(self f: Ty, x: BitVec(64)) → f.Flat() {
    match f as λ y => y.Flat() {
        Word(w) => match Nat::equation(64, w) { Inl(e) => j(e, λ y _ => BitVec(y), x), Inr(_) => BitVec::ofNat(x.toNat()) },
        Bit => False,
        ByteList(_) => Nil,
        Lines => Nil,
        Named(_) => trivial,
        Count => 0,
        Enum(_) => trivial,
    }
}

fn Ty::flat_word(self f: Ty) → f.Flat() → BitVec(64) {
    match f as λ y => y.Flat() → BitVec(64) {
        Word(w) => λ v => match w.equation(64) { Inl(e) => j(e, λ y _ => BitVec(y), v), Inr(_) => BitVec::ofNat(v.toNat()) },
        Bit => λ _ => BitVec::ofNat(0),
        ByteList(_) => λ _ => BitVec::ofNat(0),
        Lines => λ _ => BitVec::ofNat(0),
        Named(_) => λ _ => BitVec::ofNat(0),
        Count => λ _ => BitVec::ofNat(0),
        Enum(_) => λ _ => BitVec::ofNat(0),
    }
}

// A record held in one word (a type at its `datarepr`'s word carrier,
// `SInt(64)` at `BitVec(64)`): built from the word, its first field is the
// word and the rest are defaults; read back, the word is its first field.
fn Ty::flats_word(fs: List<Ty>, x: BitVec(64)) → Ty::Flats(fs) {
    match fs { Nil => trivial, Cons(f, rest) => Pair(f.word_at(x), Ty::flats_default(rest)) }
}

fn Ty::flats_head_word(fs: List<Ty>) → Ty::Flats(fs) → BitVec(64) {
    match fs as λ g => Ty::Flats(g) → BitVec(64) { Nil => λ _ => BitVec::ofNat(0), Cons(f, _) => λ t => f.flat_word(t.fst) }
}

// The word a value crosses a function's boundary as, read off a word or a
// record held in one word (zero for the rest).
fn Ty::word_from(tys: Nat → RecInfo, a: Ty) → a.sem(tys) → BitVec(64) {
    match a as λ x => x.sem(tys) → BitVec(64) {
        Word(w) => λ v => Word(w).flat_word(v),
        // A bit as the word it is zero-extended to (C's `bool`, 0 or 1).
        Bit => λ b => BitVec::ofNat(BitVec::ofBool(b).toNat()),
        ByteList(_) => λ _ => BitVec::ofNat(0),
        Lines => λ _ => BitVec::ofNat(0),
        Named(i) => λ v => Ty::flats_head_word(tys(i).fields, tys(i).get(v)),
        Count => λ _ => BitVec::ofNat(0),
        Enum(i) => λ v => BitVec::ofNat(tys(i).alts.tag(v)),
    }
}

// A value at `a` read at a code it is not: a count from a word, a record
// held in one word from the word (its repr's `abs`) and the word from the
// record (its field), the default otherwise (every judgment refuses the
// other mismatches). The two record cases are how a function's boundary,
// which passes 64-bit words, reads a parameter or result held in one
// (`Ty::OneWord`, `rt_lower.hthr`).
fn Ty::convert(tys: Nat → RecInfo, a, b: Ty, v: a.sem(tys)) → b.sem(tys) {
    match b as λ y => y.sem(tys) {
        Word(w) => Word(w).word_at(Ty::word_from(tys, a, v)),
        // A word read as a bit is its lowest bit (what `Resize` to one bit
        // keeps).
        Bit => BitVec::ofNat(Ty::word_from(tys, a, v).toNat(), n := 1).head_bit(),
        ByteList(_) => Nil,
        Lines => Nil,
        Named(i) => tys(i).mk(Ty::flats_word(tys(i).fields, Ty::word_from(tys, a, v))),
        Count => Ty::to_count(tys, a, v),
        Enum(i) => tys(i).alts.read(Ty::word_from(tys, a, v)),
    }
}

// A value at `a` read at `b`: itself when the codes agree, which at closed
// codes is a conversion; a word read as a count is its `toNat`.
fn Ty::cast(tys: Nat → RecInfo, a, b: Ty, v: a.sem(tys)) → b.sem(tys) {
    match a.equation(b) { Inl(e) => j(e, λ x _ => x.sem(tys), v), Inr(_) => Ty::convert(tys, a, b, v) }
}

// The curried function type of a signature.
fn Ty::Arrows(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Type {
    match ps { Nil => r.sem(tys), Cons(p, rest) => p.sem(tys) → Ty::Arrows(tys, rest, r) }
}

fn Ty::arrows_default(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) {
    match ps { Nil => r.default(tys), Cons(_, rest) => λ _ => Ty::arrows_default(tys, rest, r) }
}

// A curried function of a signature's operands into any type: what a
// computation over a state means (`rt_io`, `rt_file`).
fn Ty::ArrowsTo(tys: Nat → RecInfo, ps: List<Ty>, R: Type) → Type {
    match ps { Nil => R, Cons(p, rest) => p.sem(tys) → Ty::ArrowsTo(tys, rest, R) }
}

// ---------------------------------------------------------------------------
// Environments: a value per variable, the most recent first.

fn Env(tys: Nat → RecInfo, g: List<Ty>) → Type {
    match g { Nil => True, Cons(t, rest) => Pair<t.sem(tys), Env(tys, rest)> }
}

fn Env::get(tys: Nat → RecInfo, g: List<Ty>) → Env(tys, g) → (i: Nat) → Ty::at(g, i).sem(tys) {
    match g {
        Nil => λ _ i => False,
        Cons(_, rest) => λ env i => match i { Zero => env.fst, Succ(k) => Env::get(tys, rest, env.snd, k) },
    }
}

// The context after binding `ps` in order onto `g`: the last parameter is
// variable 0.
fn Ty::bind_onto(ps: List<Ty>, g: List<Ty>) → List<Ty> {
    match ps { Nil => g, Cons(p, rest) => Ty::bind_onto(rest, Cons(p, g)) }
}

// A function of an environment, curried into the signature's arguments.
fn Ty::curry(tys: Nat → RecInfo, r: Ty, ps: List<Ty>)
    → (g: List<Ty>) → Env(tys, g) → (Env(tys, Ty::bind_onto(ps, g)) → r.sem(tys)) → Ty::Arrows(tys, ps, r)
{
    match ps {
        Nil => λ g env k => k(env),
        Cons(p, rest) => λ g env k => λ (x: p.sem(tys)) => Ty::curry(tys, r, rest, Cons(p, g), Pair(x, env), k),
    }
}

// ---------------------------------------------------------------------------
// Byte buffers: a read and a write at a word index. Out of range, the read
// is 0 and the write changes nothing (a setup that lowers them checks the
// index, or carries `InBounds`).

fn List::byte_at(self xs: List<BitVec(8)>, i: BitVec(64)) → BitVec(8) { xs.nth(i.toNat()).unwrap_or(BitVec::ofNat(0)) }

fn List::with_byte(self xs: List<BitVec(8)>, i: BitVec(64), v: BitVec(8)) → List<BitVec(8)> { xs.update(i.toNat(), λ _ => v) }

// A read under a length word: the byte where the index is below the word,
// 0 elsewhere. This is what code lent a span computes (`Tm::Byte`): it
// tests the index against the length it was handed and loads under the
// test. At the span's own length it is `byte_at` (`List::byte_within_own`).
fn List::byte_within(self xs: List<BitVec(8)>, length, i: BitVec(64)) → BitVec(8) {
    match i.unsigned_lt_bit(length) { False => BitVec::ofNat(0), True => xs.byte_at(i) }
}

// At a span's own length, where that fits a word, the read under it is the
// plain one: past the end both are 0. This is how a function lent a span
// is read at its source, which says `byte_at`: the caller hands the span's
// length (`Lending`, function_ir_lower_reads).
theorem List::byte_within_own(self xs: List<BitVec(8)>, i: BitVec(64), small: xs.len() < Nat::pow(2, 64)):
    xs.byte_within(BitVec::ofNat(xs.len()), i) = xs.byte_at(i) {
    let length: BitVec(64) = BitVec::ofNat(xs.len());
    (match i.unsigned_lt_bit(length) as λ b => i.unsigned_lt_bit(length) = b →
        (match b { False => BitVec::ofNat(0), True => xs.byte_at(i) }) = xs.byte_at(i) {
        True => λ _ => refl,
        False => λ at_or_past => {
            let not_below: ¬(i.toNat() < xs.len()) = λ below => absurd(trans(sym(
                BitVec::borrow_sub_bit_true_iff(64, i, length).mpr(j(sym(BitVec::toNat_ofNat(64, xs.len(), small)), λ n _ => i.toNat() < n, below))),
                at_or_past));
            sym(cong_fn(λ (o: Option<BitVec(8)>) => o.unwrap_or(BitVec::ofNat(0)),
                xs.nth_past_end(i.toNat(), Nat::le_of_not_lt(i.toNat(), xs.len(), not_below))))
        },
    })(refl)
}

// Below the length word, the read under it is the plain one.
theorem List::byte_within_inside(self xs: List<BitVec(8)>, length, i: BitVec(64), inside: i.toNat() < length.toNat()):
    xs.byte_within(length, i) = xs.byte_at(i) {
    let below: (i.unsigned_lt_bit(length) = True) = BitVec::borrow_sub_bit_of_borrow(64, i, length, inside);
    let read: ((match i.unsigned_lt_bit(length) { False => BitVec::ofNat(0), True => xs.byte_at(i) }) = xs.byte_at(i)) = rewrite(below, refl);
    read
}

// Span `k` of a file of spans: empty where there is none.
fn List::span(self spans: List<List<BitVec(8)>>, k: Nat) → List<BitVec(8)> {
    match spans.nth(k) { None => [], Some(bytes) => bytes }
}

// ---------------------------------------------------------------------------
// Primitives: the operations a setup may know, each with its signature and
// the Heather function it means. A setup's primitive table says which of
// them it lowers (§7.1).

inductive Op {
    Add(w: Nat), Sub(w: Nat), Band(w: Nat), Bor(w: Nat), Bxor(w: Nat),
    Eq(w: Nat), Ult(w: Nat), Slt(w: Nat),
    Conj, Disj, Neg,
    // `x.zero_extend(extra)` of a `BitVec(w)`.
    Zext(w: Nat, extra: Nat),
    // `xs.byte_at(i)` and `xs.with_byte(i, v)` of a byte buffer. A write
    // consumes its buffer: in place when nothing reads the old one after it
    // (`Unique`, lib/lang/facts/unique.hthr), a copy otherwise.
    Get(cap: Nat), Set(cap: Nat),
    // `Cons(line, lines)`: a line consed onto a list of lines, a byte
    // string from a buffer of the capacity. An arena cell written at the
    // top (`ArenaRef::cons_abs`); every other list in the arena keeps its
    // meaning (`ArenaRef::extend_abs`). `Nil` is a literal (`Lit(Lines, 0)`,
    // the name 0).
    ConsLine(cap: Nat),
    // `w.toNat()` of a 64-bit word: a loop's fuel, held in the word itself.
    ToNat,
    // `x.truncate(n, extra)` of a `BitVec(extra + n)`: its low `n` bits.
    Trunc(n: Nat, extra: Nat),
    // `x.shift_left(k)`, `x.shift_right(k)` and `x.arithmetic_shift_right(k)`
    // of a `BitVec(w)`, by a literal count.
    Shl(w: Nat, k: Nat), Lshr(w: Nat, k: Nat), Ashr(w: Nat, k: Nat),
    // `x.sign_extend(extra)` of a `BitVec(Succ(n))` (an `i32`'s `extend`
    // to `i64`, `MOVSX`).
    Sext(n: Nat, extra: Nat),
    // An operation of two words named once, with its meaning
    // (`function_ir_operation`): a multiply, a shift by a word, a divide.
    Apply(o: Operation, w: Nat),
    // Whether an enum of table entry `i` is its constructor `k`: how a
    // `match` on it tests each arm (`Tm::Pick`), a compare of its tag word.
    TagIs(i: Nat, k: Nat),
}

fn Op::params(self o: Op) → List<Ty> {
    match o {
        Add(w) => [Word(w), Word(w)], Sub(w) => [Word(w), Word(w)],
        Band(w) => [Word(w), Word(w)], Bor(w) => [Word(w), Word(w)], Bxor(w) => [Word(w), Word(w)],
        Eq(w) => [Word(w), Word(w)], Ult(w) => [Word(w), Word(w)], Slt(w) => [Word(w), Word(w)],
        Conj => [Bit, Bit], Disj => [Bit, Bit], Neg => [Bit],
        Zext(w, _) => [Word(w)],
        Get(c) => [ByteList(c), Word(64)], Set(c) => [ByteList(c), Word(64), Word(8)],
        ConsLine(c) => [ByteList(c), Lines],
        ToNat => [Word(64)],
        Trunc(n, extra) => [Word(extra + n)],
        Shl(w, _) => [Word(w)], Lshr(w, _) => [Word(w)], Ashr(w, _) => [Word(w)],
        Sext(n, _) => [Word(n + 1)],
        Apply(_, w) => [Word(w), Word(w)],
        TagIs(i, _) => [Enum(i)],
    }
}

fn Op::result(self o: Op) → Ty {
    match o {
        Add(w) => Word(w), Sub(w) => Word(w), Band(w) => Word(w), Bor(w) => Word(w), Bxor(w) => Word(w),
        Eq(_) => Bit, Ult(_) => Bit, Slt(_) => Bit,
        Conj => Bit, Disj => Bit, Neg => Bit,
        Zext(w, extra) => Word(extra + w),
        Get(_) => Word(8), Set(c) => ByteList(c),
        ConsLine(_) => Lines,
        ToNat => Count,
        Trunc(n, _) => Word(n),
        Shl(w, _) => Word(w), Lshr(w, _) => Word(w), Ashr(w, _) => Word(w),
        Sext(n, extra) => Word(extra + (n + 1)),
        Apply(_, w) => Word(w),
        TagIs(_, _) => Bit,
    }
}

fn Op::sem(self o: Op, tys: Nat → RecInfo) → Ty::Arrows(tys, o.params(), o.result()) {
    match o {
        Add(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.add(y),
        Sub(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.sub(y),
        Band(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.band(y),
        Bor(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.bor(y),
        Bxor(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.bxor(y),
        Eq(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.eq_bit(y),
        Ult(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.unsigned_lt_bit(y),
        Slt(w) => λ (x: BitVec(w)) (y: BitVec(w)) => x.signed_lt_bit(y),
        Conj => λ (x: Bool) (y: Bool) => x.and(y),
        Disj => λ (x: Bool) (y: Bool) => x.or(y),
        Neg => λ (x: Bool) => x.not(),
        Zext(w, extra) => λ (x: BitVec(w)) => x.zero_extend(extra),
        Get(_) => λ (xs: List<BitVec(8)>) (i: BitVec(64)) => xs.byte_at(i),
        Set(_) => λ (xs: List<BitVec(8)>) (i: BitVec(64)) (v: BitVec(8)) => xs.with_byte(i, v),
        ConsLine(_) => λ (x: List<BitVec(8)>) (xs: List<List<BitVec(8)>>) => Cons(x, xs),
        ToNat => λ (x: BitVec(64)) => x.toNat(),
        Trunc(n, extra) => λ (x: BitVec(extra + n)) => x.truncate(n, extra),
        Shl(w, k) => λ (x: BitVec(w)) => x.shift_left(k),
        Lshr(w, k) => λ (x: BitVec(w)) => x.shift_right(k),
        Ashr(w, k) => λ (x: BitVec(w)) => x.arithmetic_shift_right(k),
        Sext(n, extra) => λ (x: BitVec(n + 1)) => x.sign_extend(extra),
        Apply(o, w) => λ (x: BitVec(w)) (y: BitVec(w)) => o.run(x, y),
        TagIs(i, k) => λ (v: tys(i).alts.E) => tys(i).alts.tag(v).same(k),
    }
}

// ---------------------------------------------------------------------------
// Terms and programs.

inductive Tm {
    // A parameter or a `Let`, by de Bruijn index.
    Var(i: Nat),
    // A word literal `BitVec::ofNat(n)` at `Word(w)`; at `Bit`, `False` for 0
    // and `True` otherwise.
    Lit(t: Ty, n: Nat),
    // A primitive on variables.
    Prim(op: Op, args: List<Nat>),
    // A shared subterm, bound once: `body` sees `e` as variable 0.
    Let(e: Tm, body: Tm),
    // `match` on a `Bool` variable.
    If(c: Nat, yes: Tm, no: Tm),
    // `match h: c` on a `Bool` variable: the same branch, with the equation
    // `c = b` convoyed into the arms, which read it only in proofs (erased).
    IfEq(c: Nat, yes: Tm, no: Tm),
    // The record of table entry `i`, from field variables.
    Make(i: Nat, args: List<Nat>),
    // Field `k` of a record variable of table entry `i`.
    Field(i: Nat, k: Nat, of: Nat),
    // A function of the program, by index, on variables.
    Call(f: Nat, args: List<Nat>),
    // `over.foldl(step, init)`: a byte buffer or a list of lines folded by a
    // function of the program, the state at the step's result code, the
    // element at the list's element code (R3's loop shape).
    Fold(over: Nat, init: Nat, step: Nat),
    // `match` on a `Count` variable: `zero`, or `succ` with the predecessor
    // as variable 0. A fuel recursion's body is one at the top, matching its
    // fuel (design §7.4).
    Case(c: Nat, zero: Tm, succ: Tm),
    // `spans.span(k).byte_within(length, i)`: a byte of span `k` of the
    // file the function is run over (`World.spans`), read at the word
    // variable `i` under the length word variable `length`. The span is not
    // a value of the term: a function lent spans takes each as two words,
    // where it lies and how long it is (docs/native/native-one-compiler-design.md
    // §2.3), and reads through the second.
    Byte(k: Nat, i: Nat, length: Nat),
    // `match` on an enum variable `c` of table entry `i`: the enum's own
    // `match` (`EnumInfo.pick`), each constructor's arm `arms` read with
    // that constructor bound as variable 0. `arms` tests variable 0 against
    // each constructor in turn (`Prim(TagIs(i, k), …)` and `If`), the last
    // constructor's arm the default (docs/native/runtime-fn-setups-design.md
    // §16.16).
    Pick(i: Nat, c: Nat, arms: Tm, eq: Bool),
    // Constructor `k` of the enum of table entry `i`, its fields from
    // variables, one per field (its slots of `EnumInfo.slots`, the others
    // defaults).
    Inject(i: Nat, k: Nat, args: List<Nat>),
    // Payload slot `j` of an enum variable of table entry `i`: in an arm of
    // a `Pick`, a field of the arm's constructor.
    Slot(i: Nat, j: Nat, of: Nat),
}

record Sig { params: List<Ty>, result: Ty }

// `lent`: how many spans of the file the function reads. Span `k`'s two
// words are parameters `2k` (where it lies, which the meaning never reads)
// and `2k + 1` (its length).
record Fun { params: List<Ty>, result: Ty, body: Tm, lent: Nat := 0 }

record Program { funs: List<Fun>, entry: Nat }

// Past the end, a signature no call passes (its result is a list of lines,
// which no call reads back).
fn Sig::at(sigs: List<Sig>, i: Nat) → Sig {
    match sigs { Nil => Sig([], Lines), Cons(s, rest) => match i { Zero => s, Succ(k) => Sig::at(rest, k) } }
}

// The meanings of a program's functions, one per signature: what a `Call`
// is answered with. The pin of a function supplies its callees' own
// definitions, so no callee is unfolded.
fn Sig::Sems(tys: Nat → RecInfo, sigs: List<Sig>) → Type {
    match sigs { Nil => True, Cons(s, rest) => Pair<Ty::Arrows(tys, s.params, s.result), Sig::Sems(tys, rest)> }
}

fn Sig::get(tys: Nat → RecInfo, sigs: List<Sig>) → Sig::Sems(tys, sigs) → (i: Nat)
    → Ty::Arrows(tys, Sig::at(sigs, i).params, Sig::at(sigs, i).result)
{
    match sigs {
        Nil => λ _ i => Nil,
        Cons(_, rest) => λ cs i => match i { Zero => cs.fst, Succ(k) => Sig::get(tys, rest, cs.snd, k) },
    }
}

fn Fun::sig(self f: Fun) → Sig { Sig(f.params, f.result) }

fn Program::sigs(self p: Program) → List<Sig> { p.funs.map(Fun::sig) }

// What the meaning reads besides a term: the type table, the program's
// signatures, the meanings answering its calls, and the file of spans its
// functions are lent (none, for a function of words alone).
record World { tys: Nat → RecInfo, sigs: List<Sig>, callees: Sig::Sems(tys, sigs), spans: List<List<BitVec(8)>> := [] }

// A function of a signature applied to variables, each cast to its
// parameter's code.
fn Tm::apply(w: World, g: List<Ty>, env: Env(w.tys, g), r: Ty, ps: List<Ty>)
    → Ty::Arrows(w.tys, ps, r) → List<Nat> → r.sem(w.tys)
{
    match ps {
        Nil => λ f vs => f,
        Cons(p, rest) => λ f vs => match vs {
            Nil => r.default(w.tys),
            Cons(v, more) => Tm::apply(w, g, env, r, rest, f(Ty::cast(w.tys, Ty::at(g, v), p, Env::get(w.tys, g, env, v))), more),
        },
    }
}

// The flat field tuple of a record, from variables.
fn Tm::fields(w: World, g: List<Ty>, env: Env(w.tys, g), fs: List<Ty>) → List<Nat> → Ty::Flats(fs) {
    match fs {
        Nil => λ _ => trivial,
        Cons(f, rest) => λ vs => match vs {
            Nil => Ty::flats_default(Cons(f, rest)),
            Cons(v, more) => Pair(f.to_flat(w.tys, Ty::cast(w.tys, Ty::at(g, v), f, Env::get(w.tys, g, env, v))),
                Tm::fields(w, g, env, rest, more)),
        },
    }
}

fn Ty::flat_nth(fs: List<Ty>) → Ty::Flats(fs) → (k: Nat) → Ty::at(fs, k).Flat() {
    match fs {
        Nil => λ _ k => False,
        Cons(_, rest) => λ t k => match k { Zero => t.fst, Succ(n) => Ty::flat_nth(rest, t.snd, n) },
    }
}

fn Tm::lit(t: Ty, n: Nat, tys: Nat → RecInfo) → t.sem(tys) {
    match t {
        Word(_) => BitVec::ofNat(n),
        Bit => match n { Zero => False, Succ(_) => True },
        ByteList(_) => Nil,
        Lines => Nil,
        Named(i) => Named(i).default(tys),
        Count => n,
        // A constructor of an enum by its index, without fields (`EnumInfo.of`).
        Enum(i) => tys(i).alts.of(n, Ty::flats_default(tys(i).alts.slots)),
    }
}

// The code a term synthesizes in a context.
fn Tm::ty(self t: Tm, w: World, g: List<Ty>) → Ty {
    match t {
        Var(i) => Ty::at(g, i),
        Lit(c, _) => c,
        Prim(op, _) => op.result(),
        Let(e, body) => body.ty(w, Cons(e.ty(w, g), g)),
        If(_, yes, _) => yes.ty(w, g),
        IfEq(_, yes, _) => yes.ty(w, g),
        Make(i, _) => Named(i),
        Field(i, k, _) => Ty::at(w.tys(i).fields, k),
        Call(f, _) => Sig::at(w.sigs, f).result,
        Fold(_, _, step) => Sig::at(w.sigs, step).result,
        Case(_, zero, _) => zero.ty(w, g),
        Byte(_, _, _) => Word(8),
        Pick(i, _, arms, _) => arms.ty(w, Cons(Enum(i), g)),
        Inject(i, _, _) => Enum(i),
        Slot(i, j, _) => Ty::at(w.tys(i).alts.slots, j),
    }
}

// A fold's step: the program's function `k` as a function of the state and
// an element at the code `e`, its arguments cast to its parameters (at
// closed codes, the function itself up to η).
fn Tm::step(w: World, e: Ty, k: Nat)
    → Sig::at(w.sigs, k).result.sem(w.tys) → e.sem(w.tys) → Sig::at(w.sigs, k).result.sem(w.tys)
{
    λ acc b => Tm::apply(w, [e, Sig::at(w.sigs, k).result], Pair(b, Pair(acc, trivial)),
        Sig::at(w.sigs, k).result, Sig::at(w.sigs, k).params, Sig::get(w.tys, w.sigs, w.callees, k), [1, 0])
}

// `match h: c { True => yes, False => no }` as the elaborator builds it
// (`matching::plan_convoy`): the match at the convoyed motive, applied to
// `refl`, each arm a function of the equation.
fn Tm::convoy(T: Type, c: Bool, yes: T, no: T) → T {
    (match c as λ b => (c = b) → T { False => λ _ => no, True => λ _ => yes })(refl)
}

// The meaning of a term, at the code it synthesizes.
fn Tm::sem(self t: Tm, w: World) → (g: List<Ty>) → Env(w.tys, g) → t.ty(w, g).sem(w.tys) {
    match t {
        Var(i) => λ g env => Env::get(w.tys, g, env, i),
        Lit(c, n) => λ g env => Tm::lit(c, n, w.tys),
        Prim(op, args) => λ g env => Tm::apply(w, g, env, op.result(), op.params(), op.sem(w.tys), args),
        Let(e, body) => λ g env => body.sem(w, Cons(e.ty(w, g), g), Pair(e.sem(w, g, env), env)),
        If(c, yes, no) => λ g env =>
            match Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)) {
                False => Ty::cast(w.tys, no.ty(w, g), yes.ty(w, g), no.sem(w, g, env)),
                True => yes.sem(w, g, env),
            },
        IfEq(c, yes, no) => λ g env =>
            Tm::convoy(yes.ty(w, g).sem(w.tys), Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c)),
                yes.sem(w, g, env), Ty::cast(w.tys, no.ty(w, g), yes.ty(w, g), no.sem(w, g, env))),
        Make(i, args) => λ g env => w.tys(i).mk(Tm::fields(w, g, env, w.tys(i).fields, args)),
        Field(i, k, of) => λ g env =>
            Ty::at(w.tys(i).fields, k).of_flat(w.tys,
                Ty::flat_nth(w.tys(i).fields, w.tys(i).get(Ty::cast(w.tys, Ty::at(g, of), Named(i), Env::get(w.tys, g, env, of))), k)),
        Call(f, args) => λ g env =>
            Tm::apply(w, g, env, Sig::at(w.sigs, f).result, Sig::at(w.sigs, f).params, Sig::get(w.tys, w.sigs, w.callees, f), args),
        Fold(over, init, step) => λ g env =>
            List::foldl(Ty::at(g, over).items(w.tys, Env::get(w.tys, g, env, over)),
                Tm::step(w, Ty::at(g, over).elem(), step),
                Ty::cast(w.tys, Ty::at(g, init), Sig::at(w.sigs, step).result, Env::get(w.tys, g, env, init))),
        Case(c, zero, succ) => λ g env => match Ty::cast(w.tys, Ty::at(g, c), Count, Env::get(w.tys, g, env, c)) {
            Zero => zero.sem(w, g, env),
            Succ(k) => Ty::cast(w.tys, succ.ty(w, Cons(Count, g)), zero.ty(w, g), succ.sem(w, Cons(Count, g), Pair(k, env))),
        },
        Byte(k, i, length) => λ g env =>
            w.spans.span(k).byte_within(Ty::cast(w.tys, Ty::at(g, length), Word(64), Env::get(w.tys, g, env, length)),
                Ty::cast(w.tys, Ty::at(g, i), Word(64), Env::get(w.tys, g, env, i))),
        Pick(i, c, arms, eq) => λ g env =>
            w.tys(i).alts.choose(eq, arms.ty(w, Cons(Enum(i), g)).sem(w.tys), λ n t => arms.sem(w, Cons(Enum(i), g), Pair(w.tys(i).alts.of(n, t), env)),
                Ty::cast(w.tys, Ty::at(g, c), Enum(i), Env::get(w.tys, g, env, c))),
        Inject(i, k, args) => λ g env => w.tys(i).alts.of(k, Ty::spread(w.tys(i).alts.slots, w.tys(i).alts.lo(k), w.tys(i).alts.arity(k),
            Tm::fields(w, g, env, Ty::range(w.tys(i).alts.slots, w.tys(i).alts.lo(k), w.tys(i).alts.arity(k)), args))),
        Slot(i, j, of) => λ g env =>
            Ty::at(w.tys(i).alts.slots, j).of_flat(w.tys,
                Ty::flat_nth(w.tys(i).alts.slots, w.tys(i).alts.fields(Ty::cast(w.tys, Ty::at(g, of), Enum(i), Env::get(w.tys, g, env, of))), j)),
    }
}

// A function's meaning: its body under its parameters, curried, at its
// declared result.
fn Fun::meaning(self f: Fun, w: World) → Ty::Arrows(w.tys, f.params, f.result) {
    Ty::curry(w.tys, f.result, f.params, Nil, trivial, λ env =>
        Ty::cast(w.tys, Tm::ty(f.body, w, Ty::bind_onto(f.params, Nil)), f.result, Tm::sem(f.body, w, Ty::bind_onto(f.params, Nil), env)))
}

// The type table of a program with no records.
fn RecInfo::none(i: Nat) → RecInfo { RecInfo(True, [], λ _ => trivial, λ _ => trivial, λ t => refl, λ v => refl) }

// A type table with `r` first and `rest` after it (a `RecInfo` is too large
// for a `List`): a table of entries in order is `cons`es ending at
// `RecInfo::none`.
fn RecInfo::cons(r: RecInfo, rest: Nat → RecInfo) → Nat → RecInfo { λ i => match i { Zero => r, Succ(k) => rest(k) } }

// A record's shape alone, its type its field tuple: what a generator judges
// and lowers against, neither of which reads a record's type.
fn RecInfo::shape(fs: List<Ty>) → RecInfo { RecInfo(Ty::Flats(fs), fs, λ t => t, λ t => t, λ t => refl, λ t => refl) }

// An enum's entry in a type table: no record, the enum `e`.
fn RecInfo::of_enum(e: EnumInfo) → RecInfo { RecInfo(True, [], λ _ => trivial, λ _ => trivial, λ t => refl, λ v => refl, alts := e) }

// A type held in one 64-bit word by its `datarepr` (`SInt(64)` at
// `BitVec(64)`, docs/native/runtime-fn-setups-design.md §16.13): the spec type
// `S`, built from the word by the repr's `abs` and read back by its `emb`,
// with the round trip `emb(abs(x)) = x` (`refl` at a repr whose images
// are its constructors' fields).
fn RecInfo::word_repr<S>(abs: BitVec(64) → S, emb: S → BitVec(64), round: (x: BitVec(64)) → emb(abs(x)) = x,
    back: (s: S) → abs(emb(s)) = s) → RecInfo {
    RecInfo(S, [Word(64)], λ t => abs(t.fst), λ s => Pair(emb(s), trivial),
        λ t => j(sym(round(t.fst)), λ y _ => Pair(y, trivial) = t, refl), back)
}

// ---------------------------------------------------------------------------
// Equality of reflected code, as `Bool`: what a reflector's value numbering
// and its tests compare.

fn Ty::same(self a: Ty, b: Ty) → Bool {
    match a {
        Word(w) => match b { Word(v) => w.same(v), _ => False },
        Bit => match b { Bit => True, _ => False },
        ByteList(c) => match b { ByteList(d) => c.same(d), _ => False },
        Lines => match b { Lines => True, _ => False },
        Named(i) => match b { Named(k) => i.same(k), _ => False },
        Count => match b { Count => True, _ => False },
        Enum(i) => match b { Enum(k) => i.same(k), _ => False },
    }
}

fn Ty::all_same(xs: List<Ty>) → List<Ty> → Bool {
    match xs {
        Nil => λ ys => match ys { Nil => True, Cons(_, _) => False },
        Cons(x, rest) => λ ys => match ys { Nil => False, Cons(y, more) => x.same(y).and(Ty::all_same(rest, more)) },
    }
}

fn Tm::nats_same(xs: List<Nat>) → List<Nat> → Bool {
    match xs {
        Nil => λ ys => match ys { Nil => True, Cons(_, _) => False },
        Cons(x, rest) => λ ys => match ys { Nil => False, Cons(y, more) => x.same(y).and(Tm::nats_same(rest, more)) },
    }
}

// An operation as its constructor's number and its two widths.
fn Op::code(self o: Op) → Pair<Nat, Pair<Nat, Nat>> {
    match o {
        Add(w) => Pair(0, Pair(w, 0)), Sub(w) => Pair(1, Pair(w, 0)), Band(w) => Pair(2, Pair(w, 0)),
        Bor(w) => Pair(3, Pair(w, 0)), Bxor(w) => Pair(4, Pair(w, 0)),
        Eq(w) => Pair(5, Pair(w, 0)), Ult(w) => Pair(6, Pair(w, 0)), Slt(w) => Pair(7, Pair(w, 0)),
        Conj => Pair(8, Pair(0, 0)), Disj => Pair(9, Pair(0, 0)), Neg => Pair(10, Pair(0, 0)),
        Zext(w, extra) => Pair(11, Pair(w, extra)),
        Get(c) => Pair(12, Pair(c, 0)), Set(c) => Pair(13, Pair(c, 0)),
        ConsLine(c) => Pair(14, Pair(c, 0)),
        ToNat => Pair(15, Pair(0, 0)),
        Trunc(n, extra) => Pair(16, Pair(n, extra)),
        Shl(w, k) => Pair(17, Pair(w, k)), Lshr(w, k) => Pair(18, Pair(w, k)), Ashr(w, k) => Pair(19, Pair(w, k)),
        Sext(n, extra) => Pair(20, Pair(n, extra)),
        Apply(o, w) => Pair(21, Pair(w, o.code())),
        TagIs(i, k) => Pair(22, Pair(i, k)),
    }
}

fn Op::same(self a: Op, b: Op) → Bool {
    a.code().fst.same(b.code().fst).and(a.code().snd.fst.same(b.code().snd.fst)).and(a.code().snd.snd.same(b.code().snd.snd))
}

fn Tm::same(self t: Tm) → Tm → Bool {
    match t {
        Var(i) => λ u => match u { Var(k) => i.same(k), _ => False },
        Lit(c, n) => λ u => match u { Lit(d, m) => c.same(d).and(n.same(m)), _ => False },
        Prim(op, args) => λ u => match u { Prim(op2, args2) => op.same(op2).and(Tm::nats_same(args, args2)), _ => False },
        Let(e, body) => λ u => match u { Let(e2, body2) => e.same(e2).and(body.same(body2)), _ => False },
        If(c, yes, no) => λ u => match u { If(c2, yes2, no2) => c.same(c2).and(yes.same(yes2)).and(no.same(no2)), _ => False },
        IfEq(c, yes, no) => λ u => match u { IfEq(c2, yes2, no2) => c.same(c2).and(yes.same(yes2)).and(no.same(no2)), _ => False },
        Make(i, args) => λ u => match u { Make(i2, args2) => i.same(i2).and(Tm::nats_same(args, args2)), _ => False },
        Field(i, k, of) => λ u => match u { Field(i2, k2, of2) => i.same(i2).and(k.same(k2)).and(of.same(of2)), _ => False },
        Call(f, args) => λ u => match u { Call(f2, args2) => f.same(f2).and(Tm::nats_same(args, args2)), _ => False },
        Fold(over, init, step) => λ u => match u {
            Fold(over2, init2, step2) => over.same(over2).and(init.same(init2)).and(step.same(step2)),
            _ => False,
        },
        Case(c, zero, succ) => λ u => match u { Case(c2, zero2, succ2) => c.same(c2).and(zero.same(zero2)).and(succ.same(succ2)), _ => False },
        Byte(k, i, length) => λ u => match u { Byte(k2, i2, length2) => k.same(k2).and(i.same(i2)).and(length.same(length2)), _ => False },
        Pick(i, c, arms, eq) => λ u => match u {
            Pick(i2, c2, arms2, eq2) => i.same(i2).and(c.same(c2)).and(arms.same(arms2)).and(match eq { True => eq2, False => !eq2 }),
            _ => False,
        },
        Inject(i, k, args) => λ u => match u { Inject(i2, k2, args2) => i.same(i2).and(k.same(k2)).and(Tm::nats_same(args, args2)), _ => False },
        Slot(i, j, of) => λ u => match u { Slot(i2, j2, of2) => i.same(i2).and(j.same(j2)).and(of.same(of2)), _ => False },
    }
}

fn Fun::same(self f: Fun, g: Fun) → Bool {
    Ty::all_same(f.params, g.params).and(f.result.same(g.result)).and(f.body.same(g.body)).and(f.lent.same(g.lent))
}

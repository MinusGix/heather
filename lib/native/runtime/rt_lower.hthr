// The default setup's lowering of `rt` into FunctionIR, and its soundness
// proved once (docs/native/runtime-fn-setups-design.md §6.3, §16.5–§16.7;
// issues/runtime-default-setup-soundness.md).
//
// A term lowers in a context of ports, one per variable, and from a fresh
// id `next`: to a structured region, the port holding its value, and the
// next fresh id after everything the region writes. `Tm::lower_sound` is
// the theorem every case of the lowering is a case of, by induction over
// `Tm`, with no program in sight. Its invariant is three things:
//
// - **The environment holds.** Every variable's port holds its value's
//   encoding in the valuation the region starts from (`EnvHolds`): a word at
//   its width, a bit as a one-bit word.
// - **The ports are below `next`** (`Below`), and the region writes only at
//   or above it, so it keeps every id below (`Keeps`). That is what lets a
//   `Let` body read its context after its bound term's region ran, and what
//   lets two arms of a branch reuse the same fresh ids.
// - **The result holds:** the port the lowering names holds the encoding of
//   the term's meaning (`Tm::sem`), in the evaluated valuation.
//
// The lowering decides what the meaning only casts. Where the meaning reads
// a value at another code (an operand at a primitive's parameter, a branch
// at the other's type, the scrutinee at `Bit`), the lowering asks for the
// equation between the codes (`Ty::check`) and refuses without it, and the
// proof carries the operand's encoding along that equation
// (`Ty::cast_holds`). So the theorem needs no judgment: what the lowering
// accepts is typed, and the theorem assumes only that it accepted (and,
// for calls, what the next paragraph says).
//
// Calls are the one thing the region cannot decide alone: FunctionIR answers
// a `Call` from the program, so the theorem assumes `Tm::CallsAgree`, that
// every word-signature function is answered with its meaning, and
// `Fun::lower_sound` is the theorem a program discharges it with, function by
// function.
//
// Records are scalar-replaced: a record variable's port is its first
// field's, and its fields sit at the consecutive ports (`Ty::FieldsHold`), so
// what the invariant bounds and keeps of a variable is its span (`Ty::Below`,
// `Ty::Same`), not one port.
//
// The cases: variables, literals, `Let`, `If` and `IfEq` (the convoy is
// erased, the same branch), the primitives FunctionIR has a node for (word
// `+ - & | ^`, `== <u <s` as a bit, `&& || !` on bits, shifts by a literal,
// and `zero_extend` and `truncate` as one `Resize`), `Make` and `Field`,
// and calls at a signature of words; then `Fun::lower_sound`, from
// `Function::eval` to the curried meaning. `Fold` and the
// byte primitives lower to `None`, so the theorem holds of them vacuously
// until their case is written (issues/runtime-default-setup-soundness.md
// says what each waits on). `Case`, a fuel's `match`, lowers to `None` here
// too: a fuel recursion's body is one, and `rt_loop.hthr` lowers that
// function as a loop. `ToNat` is free: a count is held as the word it is
// the `toNat` of.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import rt;
import function_ir;
import function_ir_operation;
import function_ir_eval;

// ---------------------------------------------------------------------------
// Encodings: what a port holds for a value of a code.

// A record's field at one port: a word at its width, a bit as the one-bit
// word `ofBool`. A byte buffer is not in the valuation at all: it is held by
// its id in the buffer file, which the effectful layer relates
// (`rt_io_lower`'s `LocsHold`), and no region this lowering builds reads one
// (byte primitives and `Fold` lower to `None`), so the valuation asks
// nothing of it. A record field of a record type is refused, so it never
// holds.
fn Ty::FlatHolds(self t: Ty, values: Valuation(), port: Nat) → t.Flat() → Type {
    match t {
        Word(w) => λ v => values(w, port) = v,
        Bit => λ v => values(1, port) = BitVec::ofBool(v),
        ByteList(_) => λ _ => True,
        Lines => λ _ => False,
        Named(_) => λ _ => False,
        Count => λ n => values(64, port).toNat() = n,
        Enum(_) => λ _ => False,
    }
}

// A record's fields at consecutive ports from `port` (scalar replacement,
// design §7.2).
fn Ty::FieldsHold(fs: List<Ty>, values: Valuation()) → Nat → Ty::Flats(fs) → Type {
    match fs {
        Nil => λ port _ => True,
        Cons(f, rest) => λ port t => f.FlatHolds(values, port, t.fst) ∧ Ty::FieldsHold(rest, values, port + 1, t.snd),
    }
}

// A word at its width; a bit as the one-bit word `ofBool`, which is what a
// comparison node writes and what a conditional reads (its head bit); a
// record as its fields from the port on. A byte buffer asks nothing of the
// valuation: it lives in the buffer file (`FlatHolds`).
fn Ty::Holds(self t: Ty, tys: Nat → RecInfo, values: Valuation(), port: Nat) → t.sem(tys) → Type {
    match t {
        Word(w) => λ v => values(w, port) = v,
        Bit => λ v => values(1, port) = BitVec::ofBool(v),
        ByteList(_) => λ _ => True,
        Lines => λ _ => False,
        Named(i) => λ v => Ty::FieldsHold(tys(i).fields, values, port, tys(i).get(v)),
        // A count as the word it is the `toNat` of.
        Count => λ n => values(64, port).toNat() = n,
        // An enum as its tag word, one of the enum's (`EnumInfo::Names`).
        Enum(i) => λ v => tys(i).alts.Names(values(64, port), v),
    }
}

// The width a value of the code is moved at.
fn Ty::width(self t: Ty) → Nat {
    match t { Word(w) => w, Bit => 1, ByteList(_) => 64, Lines => 64, Named(_) => 64, Count => 64, Enum(_) => 64 }
}

// A code whose value is one port a record's field may be (every code but a
// record and an enum).
fn Ty::OnePort(self t: Ty) → Type {
    match t { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => False, Count => True, Enum(_) => False }
}

fn Ty::check_one(self t: Ty) → Option<t.OnePort()> {
    match t as λ x => Option<x.OnePort()> { Word(_) => Some(trivial), Bit => Some(trivial), ByteList(_) => Some(trivial), Lines => Some(trivial), Named(_) => None, Count => Some(trivial), Enum(_) => None }
}

fn Ty::OnePorts(fs: List<Ty>) → Type {
    match fs { Nil => True, Cons(f, rest) => f.OnePort() ∧ Ty::OnePorts(rest) }
}

fn Ty::check_ones(fs: List<Ty>) → Option<Ty::OnePorts(fs)> {
    match fs {
        Nil => Some(trivial),
        Cons(f, rest) => f.check_one().and_then(λ o => Ty::check_ones(rest).and_then(λ os => Some(⟨o, os⟩))),
    }
}

// Field `k`'s port, from the record's.
fn Ty::field_port(k: Nat) → Nat → Nat {
    match k { Zero => λ port => port, Succ(j) => λ port => Ty::field_port(j, port + 1) }
}

fn Ty::has_field(fs: List<Ty>, k: Nat) → Bool {
    match fs { Nil => False, Cons(_, rest) => match k { Zero => True, Succ(j) => Ty::has_field(rest, j) } }
}

// The first port after a record's fields from `port`, and after a value's.
fn Ty::fields_past(fs: List<Ty>) → Nat → Nat {
    match fs { Nil => λ port => port, Cons(_, rest) => λ port => Ty::fields_past(rest, port + 1) }
}

fn Ty::past(self t: Ty, tys: Nat → RecInfo, port: Nat) → Nat {
    match t { Word(_) => port + 1, Bit => port + 1, ByteList(_) => port + 1, Lines => port + 1, Named(i) => Ty::fields_past(tys(i).fields, port), Count => port + 1, Enum(_) => port + 1 }
}

// The equation between two codes, when they agree.
fn Ty::check(self a: Ty, b: Ty) → Option<a = b> {
    match a.equation(b) { Inl(e) => Some(e), Inr(_) => None }
}

// A code's equation with itself is `refl`, at an open code too.
theorem Ty::equation_self(self a: Ty): a.equation(a) = Inl(refl) {
    match a {
        Word(w) => j(sym(w.equation_self()), λ d _ =>
            (match d as λ _ => (Word(w) = Word(w)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Word(w) = Word(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Bit => refl,
        ByteList(c) => j(sym(c.equation_self()), λ d _ =>
            (match d as λ _ => (ByteList(c) = ByteList(c)) ∨ True { Inl(e) => Inl(j(e, λ x _ => ByteList(c) = ByteList(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Lines => refl,
        Named(i) => j(sym(i.equation_self()), λ d _ =>
            (match d as λ _ => (Named(i) = Named(i)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Named(i) = Named(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Count => refl,
        Enum(i) => j(sym(i.equation_self()), λ d _ =>
            (match d as λ _ => (Enum(i) = Enum(i)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Enum(i) = Enum(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
    }
}

// A value cast to its own code is itself.
theorem Ty::cast_self(tys: Nat → RecInfo, a: Ty, v: a.sem(tys)): Ty::cast(tys, a, a, v) = v {
    j(sym(a.equation_self()), λ d _ => (match d as λ _ => a.sem(tys) { Inl(e) => j(e, λ x _ => x.sem(tys), v), Inr(_) => Ty::convert(tys, a, a, v) }) = v, refl)
}

// A port holding a value holds it cast along an equation of codes.
theorem Ty::cast_holds(tys: Nat → RecInfo, values: Valuation(), port: Nat, a, b: Ty, e: a = b, v: a.sem(tys),
    h: a.Holds(tys, values, port, v)): b.Holds(tys, values, port, Ty::cast(tys, a, b, v)) {
    j(e, λ x _ => (u: a.sem(tys)) → a.Holds(tys, values, port, u) → x.Holds(tys, values, port, Ty::cast(tys, a, x, u)),
        λ u held => j(sym(Ty::cast_self(tys, a, u)), λ r _ => a.Holds(tys, values, port, r), held))(v, h)
}

// What a port holds depends only on the port's values: a port of `after`

// What a port holds depends only on the ports it spans: a value at `to` in
// `after` whose ports carry the values of the ports at `from` in `values`
// holds what that one holds.
fn Ty::SameFields(fs: List<Ty>, values, after: Valuation()) → Nat → Nat → Type {
    match fs {
        Nil => λ from to => True,
        Cons(_, rest) => λ from to => ((wd: Nat) → after(wd, to) = values(wd, from)) ∧ Ty::SameFields(rest, values, after, from + 1, to + 1),
    }
}

fn Ty::Same(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), from, to: Nat) → Type {
    match t {
        Word(_) => (wd: Nat) → after(wd, to) = values(wd, from),
        Bit => (wd: Nat) → after(wd, to) = values(wd, from),
        ByteList(_) => (wd: Nat) → after(wd, to) = values(wd, from),
        Lines => (wd: Nat) → after(wd, to) = values(wd, from),
        Named(i) => Ty::SameFields(tys(i).fields, values, after, from, to),
        Count => (wd: Nat) → after(wd, to) = values(wd, from),
        Enum(_) => (wd: Nat) → after(wd, to) = values(wd, from),
    }
}

theorem Ty::flat_at(self f: Ty, values, after: Valuation(), from, to: Nat, same: (wd: Nat) → after(wd, to) = values(wd, from)):
    (v: f.Flat()) → f.FlatHolds(values, from, v) → f.FlatHolds(after, to, v) {
    match f {
        Word(w) => λ v h => trans(same(w), h),
        Bit => λ v h => trans(same(1), h),
        ByteList(_) => λ v h => h,
        Lines => λ v h => h,
        Named(_) => λ v h => h,
        Count => λ v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64)), h),
        Enum(_) => λ v h => h,
    }
}

theorem Ty::fields_at(fs: List<Ty>, values, after: Valuation()): (from, to: Nat) → Ty::SameFields(fs, values, after, from, to) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, from, t) → Ty::FieldsHold(fs, after, to, t) {
    match fs {
        Nil => λ from to same t h => h,
        Cons(f, rest) => λ from to same t h =>
            ⟨f.flat_at(values, after, from, to, same.left, t.fst, h.left), Ty::fields_at(rest, values, after, from + 1, to + 1, same.right, t.snd, h.right)⟩,
    }
}

theorem Ty::holds_at(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), from, to: Nat):
    t.Same(tys, values, after, from, to) → (v: t.sem(tys)) → t.Holds(tys, values, from, v) → t.Holds(tys, after, to, v) {
    match t {
        Word(w) => λ same v h => trans(same(w), h),
        Bit => λ same v h => trans(same(1), h),
        ByteList(_) => λ same v h => h,
        Lines => λ same v h => h,
        Named(i) => λ same v h => Ty::fields_at(tys(i).fields, values, after, from, to, same, tys(i).get(v), h),
        Count => λ same v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64)), h),
        Enum(i) => λ same v h => j(sym(same(64)), λ x _ => tys(i).alts.Names(x, v), h),
    }
}

// A one-port code's span is its port.
theorem Ty::same_one(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), from, to: Nat):
    t.OnePort() → ((wd: Nat) → after(wd, to) = values(wd, from)) → t.Same(tys, values, after, from, to) {
    match t {
        Word(_) => λ _ same => same,
        Bit => λ _ same => same,
        ByteList(_) => λ _ same => same,
        Lines => λ _ same => same,
        Named(_) => λ never _ => false_elim(never),
        Count => λ _ same => same,
        Enum(_) => λ never _ => false_elim(never),
    }
}

// Two valuations equal everywhere agree on every span.
theorem Ty::fields_everywhere(fs: List<Ty>, values, after: Valuation(), all: (wd, id: Nat) → after(wd, id) = values(wd, id)):
    (p: Nat) → Ty::SameFields(fs, values, after, p, p) {
    match fs { Nil => λ p => trivial, Cons(_, rest) => λ p => ⟨λ wd => all(wd, p), Ty::fields_everywhere(rest, values, after, all, p + 1)⟩ }
}

theorem Ty::same_everywhere(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), p: Nat,
    all: (wd, id: Nat) → after(wd, id) = values(wd, id)): t.Same(tys, values, after, p, p) {
    match t {
        Word(_) => λ wd => all(wd, p),
        Bit => λ wd => all(wd, p),
        ByteList(_) => λ wd => all(wd, p),
        Lines => λ wd => all(wd, p),
        Named(i) => Ty::fields_everywhere(tys(i).fields, values, after, all, p),
        Count => λ wd => all(wd, p),
        Enum(_) => λ wd => all(wd, p),
    }
}

// A port holding a field holds the field read back at its code.
theorem Ty::holds_of_flat(self t: Ty, tys: Nat → RecInfo, values: Valuation(), port: Nat):
    (v: t.Flat()) → t.FlatHolds(values, port, v) → t.Holds(tys, values, port, t.of_flat(tys, v)) {
    match t { Word(_) => λ v h => h, Bit => λ v h => h, ByteList(_) => λ v h => h, Lines => λ v h => h, Named(_) => λ v h => false_elim(h), Count => λ v h => h, Enum(_) => λ v h => false_elim(h) }
}

// A one-port value's port holds it as a field.
theorem Ty::flat_of_holds(self t: Ty, tys: Nat → RecInfo, values: Valuation(), port: Nat):
    t.OnePort() → (v: t.sem(tys)) → t.Holds(tys, values, port, v) → t.FlatHolds(values, port, t.to_flat(tys, v)) {
    match t { Word(_) => λ _ v h => h, Bit => λ _ v h => h, ByteList(_) => λ _ v h => h, Lines => λ _ v h => h, Named(_) => λ never v h => false_elim(never), Count => λ _ v h => h, Enum(_) => λ never v h => false_elim(never) }
}

// Field `k` of a record's fields holds at its port.
theorem Ty::fields_hold_at(fs: List<Ty>, values: Valuation()): (port, k: Nat) → Ty::has_field(fs, k).IsTrue() →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, port, t) → Ty::at(fs, k).FlatHolds(values, Ty::field_port(k, port), Ty::flat_nth(fs, t, k)) {
    match fs {
        Nil => λ port k never => false_elim(never),
        Cons(_, rest) => λ port k => match k {
            Zero => λ _ t h => h.left,
            Succ(j) => λ has t h => Ty::fields_hold_at(rest, values, port + 1, j, has, t.snd, h.right),
        },
    }
}

// ---------------------------------------------------------------------------
// Spans below a bound.

fn Ty::FieldsBelow(fs: List<Ty>) → Nat → Nat → Type {
    match fs { Nil => λ port next => True, Cons(_, rest) => λ port next => (port < next) ∧ Ty::FieldsBelow(rest, port + 1, next) }
}

// Every port the value spans is below `next`.
fn Ty::Below(self t: Ty, tys: Nat → RecInfo, port, next: Nat) → Type {
    match t {
        Word(_) => port < next,
        Bit => port < next,
        ByteList(_) => port < next,
        Lines => port < next,
        Named(i) => Ty::FieldsBelow(tys(i).fields, port, next),
        Count => port < next,
        Enum(_) => port < next,
    }
}

theorem Ty::one_below(self t: Ty, tys: Nat → RecInfo, port, next: Nat): t.OnePort() → port < next → t.Below(tys, port, next) {
    match t { Word(_) => λ _ lt => lt, Bit => λ _ lt => lt, ByteList(_) => λ _ lt => lt, Lines => λ _ lt => lt, Named(_) => λ never _ => false_elim(never), Count => λ _ lt => lt, Enum(_) => λ never _ => false_elim(never) }
}

theorem Ty::below_one(self t: Ty, tys: Nat → RecInfo, port, next: Nat): t.OnePort() → t.Below(tys, port, next) → port < next {
    match t { Word(_) => λ _ b => b, Bit => λ _ b => b, ByteList(_) => λ _ b => b, Lines => λ _ b => b, Named(_) => λ never _ => false_elim(never), Count => λ _ b => b, Enum(_) => λ never _ => false_elim(never) }
}

theorem Ty::below_cast(tys: Nat → RecInfo, a, b: Ty, e: a = b, port, next: Nat, h: a.Below(tys, port, next)): b.Below(tys, port, next) {
    j(e, λ x _ => x.Below(tys, port, next), h)
}

theorem Ty::fields_below_mono(fs: List<Ty>, next, later: Nat, le: next <= later): (port: Nat) →
    Ty::FieldsBelow(fs, port, next) → Ty::FieldsBelow(fs, port, later) {
    match fs {
        Nil => λ port _ => trivial,
        Cons(_, rest) => λ port b => ⟨Nat::lt_of_lt_of_le(port, next, later, b.left, le), Ty::fields_below_mono(rest, next, later, le, port + 1, b.right)⟩,
    }
}

theorem Ty::below_mono(self t: Ty, tys: Nat → RecInfo, port, next, later: Nat, le: next <= later): t.Below(tys, port, next) → t.Below(tys, port, later) {
    match t {
        Word(_) => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Bit => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        ByteList(_) => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Lines => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Named(i) => λ b => Ty::fields_below_mono(tys(i).fields, next, later, le, port, b),
        Count => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Enum(_) => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
    }
}

theorem Ty::fields_below_at(fs: List<Ty>, next: Nat): (port, k: Nat) → Ty::has_field(fs, k).IsTrue() →
    Ty::FieldsBelow(fs, port, next) → Ty::field_port(k, port) < next {
    match fs {
        Nil => λ port k never => false_elim(never),
        Cons(_, rest) => λ port k => match k {
            Zero => λ _ b => b.left,
            Succ(j) => λ has b => Ty::fields_below_at(rest, next, port + 1, j, has, b.right),
        },
    }
}

// ---------------------------------------------------------------------------
// The invariant.

// Variable `i`'s port.
fn port_at(ports: List<Nat>, i: Nat) → Option<Nat> {
    match ports { Nil => None, Cons(p, rest) => match i { Zero => Some(p), Succ(k) => port_at(rest, k) } }
}

// Every variable's port holds its value, one port per variable.
fn EnvHolds(tys: Nat → RecInfo, values: Valuation(), g: List<Ty>) → List<Nat> → Env(tys, g) → Type {
    match g {
        Nil => λ ports _ => match ports { Nil => True, Cons(_, _) => False },
        Cons(t, rest) => λ ports env => match ports {
            Nil => False,
            Cons(p, ps) => t.Holds(tys, values, p, env.fst) ∧ EnvHolds(tys, values, rest, ps, env.snd),
        },
    }
}

// Every variable's span is below `next`, one port per variable.
fn Below(tys: Nat → RecInfo, g: List<Ty>) → List<Nat> → Nat → Type {
    match g {
        Nil => λ ports next => match ports { Nil => True, Cons(_, _) => False },
        Cons(t, rest) => λ ports next => match ports { Nil => False, Cons(p, ps) => t.Below(tys, p, next) ∧ Below(tys, rest, ps, next) },
    }
}

// `after` keeps every id below `next`.
fn Keeps(values, after: Valuation(), next: Nat) → Type {
    (wd: Nat) → (id: Nat) → id < next → after(wd, id) = values(wd, id)
}

theorem Ty::fields_kept(fs: List<Ty>, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next)): (port: Nat) →
    Ty::FieldsBelow(fs, port, next) → Ty::SameFields(fs, values, after, port, port) {
    match fs {
        Nil => λ port _ => trivial,
        Cons(_, rest) => λ port b => ⟨λ wd => keeps(wd, port, b.left), Ty::fields_kept(rest, values, after, next, keeps, port + 1, b.right)⟩,
    }
}

// A span below `next` is kept by what keeps every id below it.
theorem Ty::same_kept(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next), port: Nat):
    t.Below(tys, port, next) → t.Same(tys, values, after, port, port) {
    match t {
        Word(_) => λ b wd => keeps(wd, port, b),
        Bit => λ b wd => keeps(wd, port, b),
        ByteList(_) => λ b wd => keeps(wd, port, b),
        Lines => λ b wd => keeps(wd, port, b),
        Named(i) => λ b => Ty::fields_kept(tys(i).fields, values, after, next, keeps, port, b),
        Count => λ b wd => keeps(wd, port, b),
        Enum(_) => λ b wd => keeps(wd, port, b),
    }
}

theorem env_holds_at(tys: Nat → RecInfo, values: Valuation(), g: List<Ty>): (ports: List<Nat>) → (env: Env(tys, g)) →
    EnvHolds(tys, values, g, ports, env) → (i, p: Nat) → port_at(ports, i) = Some(p) →
    Ty::at(g, i).Holds(tys, values, p, Env::get(tys, g, env, i)) {
    match g {
        Nil => λ ports => match ports {
            Nil => λ env held i p (at: None<Nat>() = Some(p)) => Option::none_ne_some(p, at, Ty::at(Nil, i).Holds(tys, values, p, Env::get(tys, Nil, env, i))),
            Cons(_, _) => λ env held => false_elim(held),
        },
        Cons(t, rest) => λ ports => match ports {
            Nil => λ env held => false_elim(held),
            Cons(q, qs) => λ env held i => match i {
                Zero => λ p (at: Some(q) = Some(p)) => j(Option::some_inj(q, p, at), λ x _ => t.Holds(tys, values, x, env.fst), held.left),
                Succ(k) => λ p at => env_holds_at(tys, values, rest, qs, env.snd, held.right, k, p, at),
            },
        },
    }
}

theorem below_at(tys: Nat → RecInfo, g: List<Ty>): (ports: List<Nat>) → (next: Nat) → Below(tys, g, ports, next) →
    (i, p: Nat) → port_at(ports, i) = Some(p) → Ty::at(g, i).Below(tys, p, next) {
    match g {
        Nil => λ ports next => match ports {
            Nil => λ _ i p (at: None<Nat>() = Some(p)) => Option::none_ne_some(p, at, Ty::at(Nil, i).Below(tys, p, next)),
            Cons(_, _) => λ never => false_elim(never),
        },
        Cons(t, rest) => λ ports next => match ports {
            Nil => λ never => false_elim(never),
            Cons(q, qs) => λ below i => match i {
                Zero => λ p (at: Some(q) = Some(p)) => j(Option::some_inj(q, p, at), λ x _ => t.Below(tys, x, next), below.left),
                Succ(k) => λ p at => below_at(tys, rest, qs, next, below.right, k, p, at),
            },
        },
    }
}

theorem below_mono(tys: Nat → RecInfo, g: List<Ty>, next, later: Nat, le: next <= later): (ports: List<Nat>) →
    Below(tys, g, ports, next) → Below(tys, g, ports, later) {
    match g {
        Nil => λ ports => match ports { Nil => λ b => b, Cons(_, _) => λ b => b },
        Cons(t, rest) => λ ports => match ports {
            Nil => λ b => b,
            Cons(p, ps) => λ below => ⟨t.below_mono(tys, p, next, later, le, below.left), below_mono(tys, rest, next, later, le, ps, below.right)⟩,
        },
    }
}

// The environment still holds after a region that keeps its ports.
theorem env_holds_keeps(tys: Nat → RecInfo, g: List<Ty>, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next)):
    (ports: List<Nat>) → (env: Env(tys, g)) → Below(tys, g, ports, next) → EnvHolds(tys, values, g, ports, env) → EnvHolds(tys, after, g, ports, env) {
    match g {
        Nil => λ ports env _ held => held,
        Cons(t, rest) => λ ports => match ports {
            Nil => λ env _ held => held,
            Cons(p, ps) => λ env below held =>
                ⟨t.holds_at(tys, values, after, p, p, t.same_kept(tys, values, after, next, keeps, p, below.left), env.fst, held.left),
                    env_holds_keeps(tys, rest, values, after, next, keeps, ps, env.snd, below.right, held.right)⟩,
        },
    }
}

// ---------------------------------------------------------------------------
// Regions the lowering builds.

record Lowered { region: StructuredRegion, result: Nat, next: Nat }

fn no_ports() → Ports { Ports(Nil) }

fn nodes_region(nodes: List<Node>) → StructuredRegion { Dataflow(Region(no_ports(), nodes, no_ports())) }

// A branch: the arm the bit at `condition` chooses. `outputs` are the ports
// both arms write, which the evaluation does not read: the x86 planner puts
// each in one register for both arms, so that the join keeps it.
fn branch(condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion) → StructuredRegion {
    Conditional(no_ports(), condition, no_ports(), outputs, when_true, when_false)
}

// The ports moves write.
fn moved_ports(ns: List<Node>) → Ports { Ports(ns.map(node_output)) }

theorem branch_true(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(),
    h: values(1, condition).head_bit() = True, wd, id: Nat):
    branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = when_true.eval(call, values, buffers := buffers)(wd, id) {
    j(sym(h), λ b _ => (match b { False => when_false.eval(call, values, buffers := buffers)(wd, id), True => when_true.eval(call, values, buffers := buffers)(wd, id) })
        = when_true.eval(call, values, buffers := buffers)(wd, id), refl)
}

theorem branch_false(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(),
    h: values(1, condition).head_bit() = False, wd, id: Nat):
    branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = when_false.eval(call, values, buffers := buffers)(wd, id) {
    j(sym(h), λ b _ => (match b { False => when_false.eval(call, values, buffers := buffers)(wd, id), True => when_true.eval(call, values, buffers := buffers)(wd, id) })
        = when_false.eval(call, values, buffers := buffers)(wd, id), refl)
}

// A branch keeps what both its arms keep.
theorem branch_keeps(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(), next: Nat,
    kept_true: Keeps(values, when_true.eval(call, values, buffers := buffers), next), kept_false: Keeps(values, when_false.eval(call, values, buffers := buffers), next)):
    Keeps(values, branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), next) {
    λ wd id below => (match values(1, condition).head_bit() as λ b => values(1, condition).head_bit() = b →
        branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = values(wd, id) {
        True => λ h => trans(branch_true(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id), kept_true(wd, id, below)),
        False => λ h => trans(branch_false(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id), kept_false(wd, id, below)),
    })(refl)
}

// A branch on a bit holds, at a port both arms write, the value the bit
// chooses.
theorem branch_holds(t: Ty, tys: Nat → RecInfo, values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion,
    call: Answers(), buffers: Buffers(), out: Nat, b: Bool, yes, no: t.sem(tys), h: values(1, condition).head_bit() = b,
    held_true: t.Holds(tys, when_true.eval(call, values, buffers := buffers), out, yes), held_false: t.Holds(tys, when_false.eval(call, values, buffers := buffers), out, no)):
    t.Holds(tys, branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, match b { False => no, True => yes }) {
    match b {
        True => t.holds_at(tys, when_true.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, out,
            t.same_everywhere(tys, when_true.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out,
                λ wd id => branch_true(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id)), yes, held_true),
        False => t.holds_at(tys, when_false.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, out,
            t.same_everywhere(tys, when_false.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out,
                λ wd id => branch_false(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id)), no, held_false),
    }
}

// A value moved from `src` to fresh ports from `out`, a field at a time.
fn Ty::field_moves(fs: List<Ty>) → Nat → Nat → List<Node> {
    match fs { Nil => λ out src => Nil, Cons(f, rest) => λ out src => Cons(Move(f.width(), out, src), Ty::field_moves(rest, out + 1, src + 1)) }
}

fn Ty::moves(self t: Ty, tys: Nat → RecInfo, out, src: Nat) → List<Node> {
    match t {
        Word(w) => [Move(w, out, src)],
        Bit => [Move(1, out, src)],
        ByteList(_) => [Move(64, out, src)],
        Lines => [Move(64, out, src)],
        Named(i) => Ty::field_moves(tys(i).fields, out, src),
        Count => [Move(64, out, src)],
        Enum(_) => [Move(64, out, src)],
    }
}

// What a move to fresh ports promises: the value at its new ports, every
// id below them kept, the new span below its end.
fn Ty::MovedFields(fs: List<Ty>, values, after: Valuation(), out: Nat, t: Ty::Flats(fs)) → Type {
    Ty::FieldsHold(fs, after, out, t) ∧ (Keeps(values, after, out) ∧ (Ty::FieldsBelow(fs, out, Ty::fields_past(fs, out)) ∧ (out <= Ty::fields_past(fs, out))))
}

theorem Ty::field_moves_sound(fs: List<Ty>, buffers: Buffers()): (values: Valuation()) → (out, src: Nat) → Ty::FieldsBelow(fs, src, out) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, src, t) → Ty::MovedFields(fs, values, eval_nodes_over(buffers, Ty::field_moves(fs, out, src), values), out, t) {
    match fs {
        Nil => λ values out src _ t _ => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩,
        Cons(f, rest) => λ values out src below t h => {
            let moved = Valuation::set(values, out, λ wd => values(wd, src));
            let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
            let kept: Keeps(values, moved, out) = λ wd id lt => Valuation::set_other(values, out, λ x => values(x, src), wd, id, Nat::ne_of_lt(id, out, lt));
            let later = Ty::field_moves_sound(rest, buffers, moved, out + 1, src + 1,
                Ty::fields_below_mono(rest, out, out + 1, step, src + 1, below.right), t.snd,
                Ty::fields_at(rest, values, moved, src + 1, src + 1, Ty::fields_kept(rest, values, moved, out, kept, src + 1, below.right), t.snd, h.right));
            let after = eval_nodes_over(buffers, Ty::field_moves(rest, out + 1, src + 1), moved);
            ⟨⟨f.flat_at(values, after, src, out,
                    λ wd => trans(later.right.left(wd, out, out.lt_succ_self()), Valuation::set_here(values, out, λ x => values(x, src), wd)), t.fst, h.left),
                later.left⟩,
                ⟨λ wd id lt => trans(later.right.left(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)), kept(wd, id, lt)),
                    ⟨⟨later.right.right.right, later.right.right.left⟩,
                        Nat::le_trans(out, out + 1, Ty::fields_past(rest, out + 1), step, later.right.right.right)⟩⟩⟩
        },
    }
}

// The same for a value of any code.
fn Ty::Moved(self t: Ty, tys: Nat → RecInfo, values, after: Valuation(), out: Nat, v: t.sem(tys)) → Type {
    t.Holds(tys, after, out, v) ∧ (Keeps(values, after, out) ∧ (t.Below(tys, out, t.past(tys, out)) ∧ (out <= t.past(tys, out))))
}

theorem Ty::one_move_sound(t: Ty, tys: Nat → RecInfo, one: t.OnePort(), values: Valuation(), out, src: Nat, v: t.sem(tys),
    h: t.Holds(tys, values, src, v)):
    t.Holds(tys, Valuation::set(values, out, λ wd => values(wd, src)), out, v) ∧ (Keeps(values, Valuation::set(values, out, λ wd => values(wd, src)), out) ∧
        (t.Below(tys, out, out + 1) ∧ (out <= out + 1))) {
    ⟨t.holds_at(tys, values, Valuation::set(values, out, λ wd => values(wd, src)), src, out,
            t.same_one(tys, values, Valuation::set(values, out, λ wd => values(wd, src)), src, out, one,
                λ wd => Valuation::set_here(values, out, λ x => values(x, src), wd)), v, h),
        ⟨λ wd id lt => Valuation::set_other(values, out, λ x => values(x, src), wd, id, Nat::ne_of_lt(id, out, lt)),
            ⟨t.one_below(tys, out, out + 1, one, out.lt_succ_self()), Nat::le_succ_r(out, out, out.le_refl())⟩⟩⟩
}

theorem Ty::moves_sound(self t: Ty, tys: Nat → RecInfo, buffers: Buffers(), values: Valuation(), out, src: Nat):
    t.Below(tys, src, out) → (v: t.sem(tys)) → t.Holds(tys, values, src, v) → t.Moved(tys, values, eval_nodes_over(buffers, t.moves(tys, out, src), values), out, v) {
    match t {
        Word(w) => λ _ v h => Ty::one_move_sound(Word(w), tys, trivial, values, out, src, v, h),
        Bit => λ _ v h => Ty::one_move_sound(Bit, tys, trivial, values, out, src, v, h),
        ByteList(c) => λ _ v h => Ty::one_move_sound(ByteList(c), tys, trivial, values, out, src, v, h),
        Lines => λ _ v h => Ty::one_move_sound(Lines, tys, trivial, values, out, src, v, h),
        Named(i) => λ below v h => Ty::field_moves_sound(tys(i).fields, buffers, values, out, src, below, tys(i).get(v), h),
        Count => λ _ v h => Ty::one_move_sound(Count, tys, trivial, values, out, src, v, h),
        Enum(i) => λ _ v h => {
            let after = Valuation::set(values, out, λ wd => values(wd, src));
            ⟨Enum(i).holds_at(tys, values, after, src, out, λ wd => Valuation::set_here(values, out, λ x => values(x, src), wd), v, h),
                ⟨λ wd id lt => Valuation::set_other(values, out, λ x => values(x, src), wd, id, Nat::ne_of_lt(id, out, lt)),
                    ⟨out.lt_succ_self(), Nat::le_succ_r(out, out, out.le_refl())⟩⟩⟩
        },
    }
}

// ---------------------------------------------------------------------------
// Casts along equations of codes.

// Casting along `a = b` and on to `c` is casting straight to `c`.
theorem Ty::cast_trans(tys: Nat → RecInfo, a, b, c: Ty, e: a = b, v: a.sem(tys)):
    Ty::cast(tys, b, c, Ty::cast(tys, a, b, v)) = Ty::cast(tys, a, c, v) {
    j(e, λ x _ => Ty::cast(tys, x, c, Ty::cast(tys, a, x, v)) = Ty::cast(tys, a, c, v),
        cong_fn(λ (u: a.sem(tys)) => Ty::cast(tys, a, c, u), Ty::cast_self(tys, a, v)))
}

// A cast there and back along an equation is the value.
theorem Ty::cast_back(tys: Nat → RecInfo, a, b: Ty, e: a = b, v: a.sem(tys)): Ty::cast(tys, b, a, Ty::cast(tys, a, b, v)) = v {
    trans(Ty::cast_trans(tys, a, b, a, e, v), Ty::cast_self(tys, a, v))
}

// `Bit` is not a word: from such an equation anything follows.
theorem Ty::bit_ne_word(width: Nat, e: Bit = Word(width), T: Type): T {
    j(e, λ x _ => match x as λ _ => Type { Word(_) => T, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True, Enum(_) => True }, trivial)
}

// ---------------------------------------------------------------------------
// Calls. FunctionIR's `Call` takes and returns 64-bit words, so a call is
// lowered only at a signature of words (§7.3; wider signatures wait for
// `function-ir-multi-word-calls`). What a call is answered with is a
// hypothesis of the theorem, `Tm::CallsAgree`: every word-signature function
// of the program is answered with its meaning. A program discharges it
// function by function from the theorem for functions below (`Fun::lower_sound`).

// Every code is a 64-bit word.
fn Ty::Words(ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => (p = Word(64)) ∧ Ty::Words(rest) }
}

fn Ty::check_words(ps: List<Ty>) → Option<Ty::Words(ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check(Word(64)).and_then(λ e => Ty::check_words(rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A code a function takes or returns in one 64-bit word at its boundary:
// a 64-bit word, or a record whose one field is (a type held at its
// `datarepr`'s word carrier, `SInt(64)` as `BitVec(64)`). The word read at
// the record is the record built from it (`Ty::convert`), so the record is
// scalar-replaced into the word's port and its field is the word.
fn Ty::OneWord(self t: Ty, tys: Nat → RecInfo) → Type {
    match t { Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys(i).fields = [Word(64)], Count => False, Enum(_) => False }
}

fn Ty::check_fields_word(fs: List<Ty>) → Option<fs = [Word(64)]> {
    match fs as λ g => Option<g = [Word(64)]> {
        Nil => None,
        Cons(f, rest) => match rest as λ r => Option<Cons(f, r) = [Word(64)]> {
            Nil => f.check(Word(64)).and_then(λ e => Some(j(e, λ x _ => Cons(f, Nil) = Cons(x, Nil), refl))),
            Cons(_, _) => None,
        },
    }
}

fn Ty::check_one_word(self t: Ty, tys: Nat → RecInfo) → Option<t.OneWord(tys)> {
    match t as λ x => Option<x.OneWord(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys(i).fields),
        Count => None,
        Enum(_) => None,
    }
}

fn Ty::OneWords(tys: Nat → RecInfo, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.OneWord(tys) ∧ Ty::OneWords(tys, rest) }
}

fn Ty::check_one_words(tys: Nat → RecInfo, ps: List<Ty>) → Option<Ty::OneWords(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_one_word(tys).and_then(λ e => Ty::check_one_words(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// Every 64-bit word is held in one.
theorem Ty::words_one_words(tys: Nat → RecInfo, ps: List<Ty>): Ty::Words(ps) → Ty::OneWords(tys, ps) {
    match ps {
        Nil => λ _ => trivial,
        Cons(p, rest) => λ ok => ⟨j(sym(ok.left), λ x _ => x.OneWord(tys), refl), Ty::words_one_words(tys, rest, ok.right)⟩,
    }
}

// A record held in one word, built from the word at its port, holds there:
// its one field is the word.
theorem Ty::record_word_holds(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, get: T → Ty::Flats(fs),
    round: (t: Ty::Flats(fs)) → get(mk(t)) = t, e: fs = [Word(64)], values: Valuation(), port: Nat, x: BitVec(64),
    h: values(64, port) = x): Ty::FieldsHold(fs, values, port, get(mk(Ty::flats_word(fs, x)))) {
    let core = j(sym(e), λ g _ => Ty::FieldsHold(g, values, port, Ty::flats_word(g, x)), ⟨h, trivial⟩);
    j(sym(round(Ty::flats_word(fs, x))), λ r _ => Ty::FieldsHold(fs, values, port, r), core)
}

// A word at its port, read at a code held in one word, holds there.
theorem Ty::one_word_holds(tys: Nat → RecInfo, values: Valuation(), port: Nat, t: Ty): t.OneWord(tys) → (x: BitVec(64)) →
    values(64, port) = x → t.Holds(tys, values, port, Ty::cast(tys, Word(64), t, x)) {
    match t {
        Word(w) => λ (e: w = 64) x h => Ty::cast_holds(tys, values, port, Word(64), Word(w), j(sym(e), λ n _ => Word(64) = Word(n), refl), x, h),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e x h => Ty::record_word_holds(tys(i).T, tys(i).fields, tys(i).mk, tys(i).get, tys(i).round, e, values, port, x, h),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A code held in one word spans one port.
theorem Ty::one_word_below(tys: Nat → RecInfo, t: Ty): t.OneWord(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(_) => λ _ m => m.lt_succ_self(),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => j(sym(e), λ g _ => Ty::FieldsBelow(g, m, m + 1), ⟨m.lt_succ_self(), trivial⟩),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// The fields of a record held in one word hold the word its first field is.
theorem Ty::fields_word_reads(values: Valuation(), port: Nat, fs: List<Ty>, e: fs = [Word(64)]): (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → values(64, port) = Ty::flats_head_word(fs, t) {
    j(sym(e), λ g _ => (t: Ty::Flats(g)) → Ty::FieldsHold(g, values, port, t) → values(64, port) = Ty::flats_head_word(g, t),
        λ t held => held.left)
}

// A value of a code held in one word, at its port: the port's word is the
// value read as a word.
theorem Ty::one_word_reads(tys: Nat → RecInfo, values: Valuation(), port: Nat, t: Ty): t.OneWord(tys) → (v: t.sem(tys)) →
    t.Holds(tys, values, port, v) → values(64, port) = Ty::cast(tys, t, Word(64), v) {
    match t {
        Word(w) => λ (e: w = 64) v h => Ty::cast_holds(tys, values, port, Word(w), Word(64), j(e, λ n _ => Word(w) = Word(n), refl), v, h),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => Ty::fields_word_reads(values, port, tys(i).fields, e, tys(i).get(v), h),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A code held in one 64-bit word across a call: a word, a record held in
// one (`Ty::OneWord`, a type at its repr's word), a count (a loop's fuel,
// the word it is the `toNat` of), or an enum (its tag word, which the
// callee reads back as the constructor, `EnumInfo::read`).
fn Ty::Held(self p: Ty, tys: Nat → RecInfo) → Type {
    match p { Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys(i).fields = [Word(64)], Count => True, Enum(_) => True }
}

fn Ty::check_held(self p: Ty, tys: Nat → RecInfo) → Option<p.Held(tys)> {
    match p as λ x => Option<x.Held(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys(i).fields),
        Count => Some(trivial),
        Enum(_) => Some(trivial),
    }
}

fn Ty::Helds(tys: Nat → RecInfo, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Held(tys) ∧ Ty::Helds(tys, rest) }
}

fn Ty::check_helds(tys: Nat → RecInfo, ps: List<Ty>) → Option<Ty::Helds(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_held(tys).and_then(λ e => Ty::check_helds(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A record held in one word, holding at its port, is the record built from
// the port's word (`back`: building from the fields read off a record is
// the record).
theorem Ty::record_word_reads(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, get: T → Ty::Flats(fs),
    back: (v: T) → mk(get(v)) = v, e: fs = [Word(64)], values: Valuation(), port: Nat, v: T,
    h: Ty::FieldsHold(fs, values, port, get(v))): mk(Ty::flats_word(fs, values(64, port))) = v {
    let general = j(sym(e), λ g _ => (mk2: Ty::Flats(g) → T) → (get2: T → Ty::Flats(g)) → ((u: T) → mk2(get2(u)) = u) →
            Ty::FieldsHold(g, values, port, get2(v)) → mk2(Ty::flats_word(g, values(64, port))) = v,
        λ mk2 get2 back2 h2 => trans(cong_fn(λ (x: BitVec(64)) => mk2(Pair(x, trivial)), h2.left), back2(v)));
    general(mk, get, back, h)
}

// The word a code held in one word crosses a boundary as, read back at the
// code, is the value.
theorem Ty::one_word_back(tys: Nat → RecInfo, t: Ty): t.OneWord(tys) → (v: t.sem(tys)) →
    Ty::cast(tys, Word(64), t, Ty::cast(tys, t, Word(64), v)) = v {
    match t {
        Word(w) => λ (e: w = 64) v => Ty::cast_back(tys, Word(w), Word(64), j(e, λ n _ => Word(w) = Word(n), refl), v),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v => {
            let general = j(sym(e), λ g _ => (mk2: Ty::Flats(g) → tys(i).T) → (get2: tys(i).T → Ty::Flats(g)) →
                    ((u: tys(i).T) → mk2(get2(u)) = u) → mk2(Ty::flats_word(g, Ty::flats_head_word(g, get2(v)))) = v,
                λ mk2 get2 back2 => back2(v));
            general(tys(i).mk, tys(i).get, tys(i).back)
        },
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A decision whose equation does not hold is its `Inr`.
theorem Or::inr_apart<P>(o: P ∨ True, apart: P → False): o = Inr(trivial) {
    match o { Inl(e) => false_elim(apart(e)), Inr(_) => refl }
}

// A port holding a value of a code held in a word: the word, read back at
// the code, is the value (a count's `toNat` is the count, an enum's word
// names its constructor, `EnumInfo.of_tag`).
theorem Ty::held_reads(tys: Nat → RecInfo, p: Ty, values: Valuation(), port: Nat): p.Held(tys) → (v: p.sem(tys)) →
    p.Holds(tys, values, port, v) → Ty::cast(tys, Word(64), p, values(64, port)) = v {
    match p {
        Word(w) => λ (e: w = 64) => j(sym(e), λ x _ => (v: BitVec(x)) → values(x, port) = v → Ty::cast(tys, Word(64), Word(x), values(64, port)) = v,
            λ v held => trans(Ty::cast_self(tys, Word(64), values(64, port)), held)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v held => Ty::record_word_reads(tys(i).T, tys(i).fields, tys(i).mk, tys(i).get, tys(i).back, e, values, port, v, held),
        Count => λ _ n held => held,
        Enum(i) => λ _ v held =>
            trans(cong_fn(tys(i).alts.of, trans(Nat::min_eq_l(values(64, port).toNat(), tys(i).alts.last, held.right), held.left)), tys(i).alts.of_tag(v)),
    }
}

// The words a code's boundary admits: an enum's are its tags, any other
// code's every word. A contract passes only real values; a caller passes
// what holds one, which is admitted (`Ty::holds_admits`).
fn Ty::Admits(self t: Ty, tys: Nat → RecInfo, x: BitVec(64)) → Type {
    match t { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True, Enum(i) => x.toNat() <= tys(i).alts.last }
}

theorem Ty::holds_admits(tys: Nat → RecInfo, p: Ty, values: Valuation(), port: Nat): (v: p.sem(tys)) → p.Holds(tys, values, port, v) →
    p.Admits(tys, values(64, port)) {
    match p {
        Word(_) => λ _ _ => trivial, Bit => λ _ _ => trivial, ByteList(_) => λ _ _ => trivial, Lines => λ _ _ => trivial,
        Named(_) => λ _ _ => trivial, Count => λ _ _ => trivial, Enum(_) => λ _ h => h.right,
    }
}

// What a parameter's word asks before `B`: an enum's, that the word is a
// tag (`Ty::Admits`); any other code's, nothing, so that an agreement over
// words alone binds no premise.
fn Ty::Given(self p: Ty, tys: Nat → RecInfo, x: BitVec(64), B: Type) → Type {
    match p { Word(_) => B, Bit => B, ByteList(_) => B, Lines => B, Named(_) => B, Count => B, Enum(i) => x.toNat() <= tys(i).alts.last → B }
}

theorem Ty::given<B>(p: Ty, tys: Nat → RecInfo, x: BitVec(64)): (p.Admits(tys, x) → B) → p.Given(tys, x, B) {
    match p {
        Word(_) => λ f => f(trivial), Bit => λ f => f(trivial), ByteList(_) => λ f => f(trivial), Lines => λ f => f(trivial),
        Named(_) => λ f => f(trivial), Count => λ f => f(trivial), Enum(_) => λ f => f,
    }
}

theorem Ty::given_at<B>(p: Ty, tys: Nat → RecInfo, x: BitVec(64)): p.Given(tys, x, B) → p.Admits(tys, x) → B {
    match p {
        Word(_) => λ h _ => h, Bit => λ h _ => h, ByteList(_) => λ h _ => h, Lines => λ h _ => h,
        Named(_) => λ h _ => h, Count => λ h _ => h, Enum(_) => λ h a => h(a),
    }
}

// The same decided, what a list of a program's functions holds (a list's
// entries are of the lowest universe, and a predicate is not).
fn Ty::admits(self t: Ty, tys: Nat → RecInfo, x: BitVec(64)) → Bool {
    match t { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True, Enum(i) => x.toNat().leb(tys(i).alts.last) }
}

theorem Ty::admits_sound(tys: Nat → RecInfo, t: Ty, x: BitVec(64)): t.admits(tys, x).IsTrue() → t.Admits(tys, x) {
    match t {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(i) => λ h => x.toNat().leb_sound(tys(i).alts.last, h),
    }
}

theorem Ty::admits_complete(tys: Nat → RecInfo, t: Ty, x: BitVec(64)): t.Admits(tys, x) → t.admits(tys, x).IsTrue() {
    match t {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(i) => λ h => x.toNat().leb_complete(tys(i).alts.last, h),
    }
}

// An enum's tag word is admitted (its tags in a word).
theorem Ty::enum_word_admits(tys: Nat → RecInfo, i: Nat, v: tys(i).alts.E, le: tys(i).alts.tag(v) <= tys(i).alts.last,
    small: (tys(i).alts.last + 1).leb(Nat::pow(2, 64)) = True): Enum(i).admits(tys, RecInfo::enum_word(tys, i, v)).IsTrue() {
    let e = tys(i).alts;
    let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, le),
        Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), small));
    let word: (BitVec::ofNat(e.tag(v), n := 64).toNat() = e.tag(v)) = BitVec::toNat_ofNat(64, e.tag(v), lt);
    BitVec::ofNat(e.tag(v), n := 64).toNat().leb_complete(e.last, j(sym(word), λ y _ => y <= e.last, le))
}

// Words each admitted by its parameter's code, zero past the words' end
// (as `Ty::extend` reads them).
fn Ty::AdmitsAll(tys: Nat → RecInfo, ps: List<Ty>) → List<BitVec(64)> → Type {
    match ps {
        Nil => λ _ => True,
        Cons(p, rest) => λ xs => match xs {
            Nil => p.Admits(tys, BitVec::zero()) ∧ Ty::AdmitsAll(tys, rest, Nil),
            Cons(x, more) => p.Admits(tys, x) ∧ Ty::AdmitsAll(tys, rest, more),
        },
    }
}

fn Ty::admits_all(tys: Nat → RecInfo, ps: List<Ty>) → List<BitVec(64)> → Bool {
    match ps {
        Nil => λ _ => True,
        Cons(p, rest) => λ xs => match xs {
            Nil => p.admits(tys, BitVec::zero()) && Ty::admits_all(tys, rest, Nil),
            Cons(x, more) => p.admits(tys, x) && Ty::admits_all(tys, rest, more),
        },
    }
}

theorem Ty::admits_all_sound(tys: Nat → RecInfo, ps: List<Ty>): (xs: List<BitVec(64)>) → Ty::admits_all(tys, ps, xs).IsTrue() → Ty::AdmitsAll(tys, ps, xs) {
    match ps {
        Nil => λ xs _ => trivial,
        Cons(p, rest) => λ xs => match xs as λ ys => Ty::admits_all(tys, Cons(p, rest), ys).IsTrue() → Ty::AdmitsAll(tys, Cons(p, rest), ys) {
            Nil => λ h => {
                let parts = Bool::is_true_and(p.admits(tys, BitVec::zero()), Ty::admits_all(tys, rest, Nil), h);
                ⟨Ty::admits_sound(tys, p, BitVec::zero(), parts.left), Ty::admits_all_sound(tys, rest, Nil, parts.right)⟩
            },
            Cons(x, more) => λ h => {
                let parts = Bool::is_true_and(p.admits(tys, x), Ty::admits_all(tys, rest, more), h);
                ⟨Ty::admits_sound(tys, p, x, parts.left), Ty::admits_all_sound(tys, rest, more, parts.right)⟩
            },
        },
    }
}

theorem Ty::admits_all_complete(tys: Nat → RecInfo, ps: List<Ty>): (xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → Ty::admits_all(tys, ps, xs).IsTrue() {
    match ps {
        Nil => λ xs _ => trivial,
        Cons(p, rest) => λ xs => match xs as λ ys => Ty::AdmitsAll(tys, Cons(p, rest), ys) → Ty::admits_all(tys, Cons(p, rest), ys).IsTrue() {
            Nil => λ h => Bool::is_true_and_intro(p.admits(tys, BitVec::zero()), Ty::admits_all(tys, rest, Nil),
                Ty::admits_complete(tys, p, BitVec::zero(), h.left), Ty::admits_all_complete(tys, rest, Nil, h.right)),
            Cons(x, more) => λ h => Bool::is_true_and_intro(p.admits(tys, x), Ty::admits_all(tys, rest, more),
                Ty::admits_complete(tys, p, x, h.left), Ty::admits_all_complete(tys, rest, more, h.right)),
        },
    }
}

// Codes that admit every word: none an enum.
fn Ty::all_open(ps: List<Ty>) → Bool {
    match ps { Nil => True, Cons(p, rest) => (match p { Enum(_) => False, _ => True }) && Ty::all_open(rest) }
}

theorem Ty::open_admits(tys: Nat → RecInfo, p: Ty, x: BitVec(64)): (match p { Enum(_) => False, _ => True }).IsTrue() → p.Admits(tys, x) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::all_open_admits(tys: Nat → RecInfo, ps: List<Ty>): Ty::all_open(ps).IsTrue() → (xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) {
    match ps {
        Nil => λ _ xs => trivial,
        Cons(p, rest) => λ open xs => {
            let parts = Bool::is_true_and(match p { Enum(_) => False, _ => True }, Ty::all_open(rest), open);
            match xs as λ ys => Ty::AdmitsAll(tys, Cons(p, rest), ys) {
                Nil => ⟨Ty::open_admits(tys, p, BitVec::zero(), parts.left), Ty::all_open_admits(tys, rest, parts.right, Nil)⟩,
                Cons(x, more) => ⟨Ty::open_admits(tys, p, x, parts.left), Ty::all_open_admits(tys, rest, parts.right, more)⟩,
            }
        },
    }
}

// A signature the calling convention covers: each parameter held in a word,
// and a word result.
// A code a call returns in one 64-bit word: one held in one
// (`Ty::OneWord`), or an enum, as its tag word, which names the callee's
// value where the enum's tags fit a word (`EnumInfo.bounded`).
fn Ty::Returned(self t: Ty, tys: Nat → RecInfo) → Type {
    match t {
        Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys(i).fields = [Word(64)], Count => False,
        Enum(i) => (tys(i).alts.last + 1).leb(Nat::pow(2, 64)) = True,
    }
}

fn Ty::check_returned(self t: Ty, tys: Nat → RecInfo) → Option<t.Returned(tys)> {
    match t as λ x => Option<x.Returned(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys(i).fields),
        Count => None,
        Enum(i) => match (tys(i).alts.last + 1).leb(Nat::pow(2, 64)) as λ b => Option<b = True> { False => None, True => Some(refl) },
    }
}

// A word returned at its port holds the value it is the word of.
theorem Ty::returned_holds(tys: Nat → RecInfo, values: Valuation(), port: Nat, t: Ty): t.Returned(tys) → (v: t.sem(tys)) →
    values(64, port) = Ty::cast(tys, t, Word(64), v) → t.Holds(tys, values, port, v) {
    match t {
        Word(w) => λ (e: w = 64) v h => j(Ty::one_word_back(tys, Word(w), e, v), λ u _ => Word(w).Holds(tys, values, port, u),
            Ty::one_word_holds(tys, values, port, Word(w), e, Ty::cast(tys, Word(w), Word(64), v), h)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => j(Ty::one_word_back(tys, Named(i), e, v), λ u _ => Named(i).Holds(tys, values, port, u),
            Ty::one_word_holds(tys, values, port, Named(i), e, Ty::cast(tys, Named(i), Word(64), v), h)),
        Count => λ never => false_elim(never),
        Enum(i) => λ small v h => {
            let e = tys(i).alts;
            let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, e.bounded(v)),
                Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), small));
            let word: (values(64, port).toNat() = e.tag(v)) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), h), BitVec::toNat_ofNat(64, e.tag(v), lt));
            ⟨word, j(sym(word), λ y _ => y <= e.last, e.bounded(v))⟩
        },
    }
}

// A code returned in one word spans one port.
theorem Ty::returned_below(tys: Nat → RecInfo, t: Ty): t.Returned(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(w) => λ e m => Ty::one_word_below(tys, Word(w), e, m),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => Ty::one_word_below(tys, Named(i), e, m),
        Count => λ never => false_elim(never),
        Enum(_) => λ _ m => m.lt_succ_self(),
    }
}

fn Sig::Words(self s: Sig, tys: Nat → RecInfo) → Type { Ty::Helds(tys, s.params) ∧ s.result.Returned(tys) }

// A function on words answers like a curried meaning: on every word list
// its parameters admit, the meaning applied to the words (each cast to its
// parameter's code) cast to a word.
fn Ty::Answers(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → (List<BitVec(64)> → BitVec(64)) → Type {
    match ps {
        Nil => λ v ans => ans(Nil) = Ty::cast(tys, r, Word(64), v),
        Cons(p, rest) => λ v ans => (x: BitVec(64)) →
            p.Given(tys, x, Ty::Answers(tys, rest, r, v(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws)))),
    }
}

// Every word-signature function of the program is answered by `call` with
// its meaning.
fn Tm::CallsAgree(w: World, call: Answers()) → Type {
    (f: Nat) → Sig::at(w.sigs, f).Words(w.tys) →
        Ty::Answers(w.tys, Sig::at(w.sigs, f).params, Sig::at(w.sigs, f).result, Sig::get(w.tys, w.sigs, w.callees, f), λ ws => call(f, ws))
}

// A program with no functions has nothing to answer.
theorem Tm::calls_agree_none(tys: Nat → RecInfo, call: Answers()): Tm::CallsAgree(World(tys, [], trivial), call) {
    λ f ok => false_elim(ok.right)
}

// The same over a file of spans.
theorem Tm::calls_agree_none_over(tys: Nat → RecInfo, spans: List<List<BitVec(8)>>, call: Answers()):
    Tm::CallsAgree(World(tys, [], trivial, spans), call) {
    λ f ok => false_elim(ok.right)
}

// ---------------------------------------------------------------------------
// The lowering. Each step that can refuse is an `Option` chained by
// `and_then`, its continuation a named function where it is not recursive,
// so the soundness proof walks the same chain (`Option::and_then_elim`).

fn Tm::check_true(b: Bool) → Option<b.IsTrue()> {
    match b as λ x => Option<x.IsTrue()> { False => None, True => Some(trivial) }
}

// One node writing `next`, the result there.
fn Tm::one_node(node: Node, next: Nat) → Lowered { Lowered(nodes_region([node]), next, next + 1) }

// A literal: a constant node, a bit as the one-bit 0 or 1.
fn Tm::bit_code(n: Nat) → Nat { match n { Zero => 0, Succ(_) => 1 } }

// An enum's constructor as its tag, one of the enum's and in a word.
fn Tm::lit_tag(n, next: Nat) → Option<Lowered> {
    Tm::check_true((n + 1).leb(Nat::pow(2, 64))).and_then(λ _ => Some(Tm::one_node(Const(64, next, n), next)))
}

fn Tm::lower_lit(tys: Nat → RecInfo, c: Ty, n, next: Nat) → Option<Lowered> {
    match c {
        Word(width) => Some(Tm::one_node(Const(width, next, n), next)),
        Bit => Some(Tm::one_node(Const(1, next, Tm::bit_code(n)), next)),
        ByteList(_) => None,
        Lines => None,
        Named(_) => None,
        Count => None,
        Enum(i) => Tm::check_true(n.leb(tys(i).alts.last)).and_then(λ _ => Tm::lit_tag(n, next)),
    }
}

// A primitive on two variables of the code `t`: one node, once both are
// at `t`.
fn Tm::binary_b(g: List<Ty>, b: Nat, t: Ty, l: Lowered) → Option<Lowered> { Ty::at(g, b).check(t).and_then(λ _ => Some(l)) }

fn Tm::binary(g: List<Ty>, a, b: Nat, t: Ty, l: Lowered) → Option<Lowered> {
    Ty::at(g, a).check(t).and_then(λ _ => Tm::binary_b(g, b, t, l))
}

// The primitive table (§7.1): each binary operation FunctionIR has a node
// for. A bit is a one-bit word, so `&&` and `||` are its bitwise nodes.
fn Tm::prim2(op: Op, g: List<Ty>, next, a, b, pa, pb: Nat) → Option<Lowered> {
    match op {
        Add(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Add(width, next, pa, pb), next)),
        Sub(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Sub(width, next, pa, pb), next)),
        Band(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitAnd(width, next, pa, pb), next)),
        Bor(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitOr(width, next, pa, pb), next)),
        Bxor(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitXor(width, next, pa, pb), next)),
        Eq(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Equal(width, next, pa, pb), next)),
        Ult(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(UnsignedLessThan(width, next, pa, pb), next)),
        Slt(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(SignedLessThan(width, next, pa, pb), next)),
        Conj => Tm::binary(g, a, b, Bit, Tm::one_node(BitAnd(1, next, pa, pb), next)),
        Disj => Tm::binary(g, a, b, Bit, Tm::one_node(BitOr(1, next, pa, pb), next)),
        // An operation by its row: FunctionIR's one node for it.
        Apply(o, width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Node::Apply(o, width, next, pa, pb), next)),
        Neg => None,
        Zext(_, _) => None,
        Get(_) => None,
        Set(_) => None,
        // A cell written at the arena's top, which needs the arena's buffer
        // and an exit when it is full (issues/runtime-fn-arena-lists.md).
        ConsLine(_) => None,
        ToNat => None,
        Trunc(_, _) => None,
        Shl(_, _) => None, Lshr(_, _) => None, Ashr(_, _) => None,
        Sext(_, _) => None,
        TagIs(_, _) => None,
    }
}

// `!x`: the bit against a constant one.
fn Tm::neg_lowered(next, pa: Nat) → Lowered {
    Lowered(nodes_region([Const(1, next, 1), BitXor(1, next + 1, pa, next)]), next + 1, next + 2)
}

// A unary node on a variable of the code `t`, once it is at `t`.
fn Tm::unary(g: List<Ty>, a: Nat, t: Ty, l: Lowered) → Option<Lowered> { Ty::at(g, a).check(t).and_then(λ _ => Some(l)) }

// The primitive table's unary operations. A zero extension and a
// truncation are one `Resize` (both are `ofNat(x.toNat())` at the result's
// width); a shift by a literal is FunctionIR's immediate shift. The byte
// reads and writes need buffers (`Fold`'s round).
// `TagIs(i, k)`: the enum's word against `k`, a constant and one compare.
// Only a constructor before the last is tested: the last is every test's
// fall-through, which is also what a word past the last tag names
// (`EnumInfo::read`), so the compare agrees with the tag on every word.
fn Tm::tag_lowered(next, pa, k: Nat) → Lowered {
    Lowered(nodes_region([Const(64, next, k), Equal(64, next + 1, pa, next)]), next + 1, next + 2)
}

fn Tm::tag_small(tys: Nat → RecInfo, next, pa, i, k: Nat) → Option<Lowered> {
    Tm::check_true((k + 1).leb(Nat::pow(2, 64))).and_then(λ _ => Some(Tm::tag_lowered(next, pa, k)))
}

fn Tm::tag_below(tys: Nat → RecInfo, next, pa, i, k: Nat) → Option<Lowered> {
    Tm::check_true((k + 1).leb(tys(i).alts.last)).and_then(λ _ => Tm::tag_small(tys, next, pa, i, k))
}

fn Tm::lower_tag(tys: Nat → RecInfo, g: List<Ty>, next, a, pa, i, k: Nat) → Option<Lowered> {
    Ty::at(g, a).check(Enum(i)).and_then(λ _ => Tm::tag_below(tys, next, pa, i, k))
}

fn Tm::prim1(op: Op, tys: Nat → RecInfo, g: List<Ty>, next, a, pa: Nat) → Option<Lowered> {
    match op {
        TagIs(i, k) => Tm::lower_tag(tys, g, next, a, pa, i, k),
        Neg => Ty::at(g, a).check(Bit).and_then(λ _ => Some(Tm::neg_lowered(next, pa))),
        Zext(width, extra) => Tm::unary(g, a, Word(width), Tm::one_node(Resize(width, extra + width, next, pa), next)),
        Trunc(n, extra) => Tm::unary(g, a, Word(extra + n), Tm::one_node(Resize(extra + n, n, next, pa), next)),
        Shl(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(ShiftLeft(width, next, pa, k), next)),
        Lshr(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(LogicalShiftRight(width, next, pa, k), next)),
        Ashr(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(ArithmeticShiftRight(width, next, pa, k), next)),
        // A sign extension is one `SignResize`, `Resize`'s signed twin.
        Sext(n, extra) => Tm::unary(g, a, Word(n + 1), Tm::one_node(SignResize(n + 1, extra + (n + 1), next, pa), next)),
        // A count is held as the word it is the `toNat` of: no code.
        ToNat => Ty::at(g, a).check(Word(64)).and_then(λ _ => Some(Lowered(nodes_region(Nil), pa, next))),
        _ => None,
    }
}

fn Tm::prim2_port_b(op: Op, g: List<Ty>, ports: List<Nat>, next, a, b, pa: Nat) → Option<Lowered> {
    port_at(ports, b).and_then(λ pb => Tm::prim2(op, g, next, a, b, pa, pb))
}

fn Tm::lower_prim(op: Op, tys: Nat → RecInfo, g: List<Ty>, ports: List<Nat>, next: Nat, args: List<Nat>) → Option<Lowered> {
    match args {
        Nil => None,
        Cons(a, more) => match more {
            Nil => port_at(ports, a).and_then(λ pa => Tm::prim1(op, tys, g, next, a, pa)),
            Cons(b, rest) => match rest {
                Cons(_, _) => None,
                Nil => port_at(ports, a).and_then(λ pa => Tm::prim2_port_b(op, g, ports, next, a, b, pa)),
            },
        },
    }
}

// A bound term's region, then its body's.
fn Tm::compose(le, lb: Lowered) → Option<Lowered> { Some(Lowered(Compose(le.region, lb.region), lb.result, lb.next)) }

// A branch: each arm moves its result to fresh ports above both (a record
// a field at a time).
fn Tm::branch_lowered(tys: Nat → RecInfo, ty_yes: Ty, pc: Nat, ly, ln: Lowered) → Lowered {
    Lowered(branch(pc, moved_ports(ty_yes.moves(tys, ln.next, ly.result)),
            Compose(ly.region, nodes_region(ty_yes.moves(tys, ln.next, ly.result))),
            Compose(ln.region, nodes_region(ty_yes.moves(tys, ln.next, ln.result)))),
        ln.next, ty_yes.past(tys, ln.next))
}

fn Tm::branch_typed(tys: Nat → RecInfo, ty_yes, ty_no: Ty, pc: Nat, ly, ln: Lowered) → Option<Lowered> {
    ty_no.check(ty_yes).and_then(λ _ => Some(Tm::branch_lowered(tys, ty_yes, pc, ly, ln)))
}

fn Tm::branch_checked(tys: Nat → RecInfo, g: List<Ty>, c: Nat, ty_yes, ty_no: Ty, pc: Nat, ly, ln: Lowered) → Option<Lowered> {
    Ty::at(g, c).check(Bit).and_then(λ _ => Tm::branch_typed(tys, ty_yes, ty_no, pc, ly, ln))
}

fn Tm::lower_branch(tys: Nat → RecInfo, g: List<Ty>, ports: List<Nat>, c: Nat, ty_yes, ty_no: Ty, ly, ln: Lowered) → Option<Lowered> {
    port_at(ports, c).and_then(λ pc => Tm::branch_checked(tys, g, c, ty_yes, ty_no, pc, ly, ln))
}

// A record from field variables: each moved to the fields' ports from
// `out`, one per field.
fn Tm::make_args(g: List<Ty>, ports: List<Nat>, fs: List<Ty>, args: List<Nat>, out: Nat) → Option<List<Node>> {
    match fs {
        Nil => match args { Nil => Some(Nil), Cons(_, _) => None },
        Cons(f, rest) => match args {
            Nil => None,
            Cons(a, more) => port_at(ports, a).and_then(λ q =>
                Ty::at(g, a).check(f).and_then(λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))))),
        },
    }
}

fn Tm::make_moves(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::make_args(g, ports, w.tys(i).fields, args, next).and_then(λ ns =>
        Some(Lowered(nodes_region(ns), next, Ty::fields_past(w.tys(i).fields, next))))
}

// `Make`: the record at fresh ports, its fields flat (no record fields).
fn Tm::lower_make(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>) → Option<Lowered> {
    Ty::check_ones(w.tys(i).fields).and_then(λ _ => Tm::make_moves(w, g, ports, next, i, args))
}

fn Tm::field_one(w: World, next, i, k, p: Nat) → Option<Lowered> {
    Ty::at(w.tys(i).fields, k).check_one().and_then(λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(k, p), next)))
}

fn Tm::field_ranged(w: World, next, i, k, p: Nat) → Option<Lowered> {
    Tm::check_true(Ty::has_field(w.tys(i).fields, k)).and_then(λ _ => Tm::field_one(w, next, i, k, p))
}

fn Tm::field_typed(w: World, g: List<Ty>, next, i, k, of, p: Nat) → Option<Lowered> {
    Ty::at(g, of).check(Named(i)).and_then(λ _ => Tm::field_ranged(w, next, i, k, p))
}

// `Field`: no code at all, the field's own port.
fn Tm::lower_field(w: World, g: List<Ty>, ports: List<Nat>, next, i, k, of: Nat) → Option<Lowered> {
    port_at(ports, of).and_then(λ p => Tm::field_typed(w, g, next, i, k, of, p))
}

// A call's arguments: each a variable at its parameter's code, one per
// parameter, each held in a word (a word, or a count).
fn Tm::call_args(tys: Nat → RecInfo, g: List<Ty>, ports: List<Nat>, ps: List<Ty>, args: List<Nat>) → Option<List<Nat>> {
    match ps {
        Nil => match args { Nil => Some(Nil), Cons(_, _) => None },
        Cons(p, rest) => match args {
            Nil => None,
            Cons(a, more) => port_at(ports, a).and_then(λ q =>
                Ty::at(g, a).check(p).and_then(λ _ => p.check_held(tys).and_then(λ _ =>
                    Tm::call_args(tys, g, ports, rest, more).and_then(λ qs => Some(Cons(q, qs)))))),
        },
    }
}

// The call, its result then moved off the port the call writes: the x86
// lowering answers a call in RAX, which the next call does not keep, and a
// `Move` gives the result a port the planner places (as the Rust reflector's
// programs do).
fn Tm::called(f: Nat, qs: List<Nat>, next: Nat) → Lowered {
    Lowered(Compose(Call(f, qs, next), nodes_region([Move(64, next + 1, next)])), next + 1, next + 2)
}

fn Tm::lower_call_args(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::call_args(w.tys, g, ports, Sig::at(w.sigs, f).params, args).and_then(λ qs => Some(Tm::called(f, qs, next)))
}

fn Tm::lower_call_result(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Sig::at(w.sigs, f).result.check_returned(w.tys).and_then(λ _ => Tm::lower_call_args(w, g, ports, next, f, args))
}

// A call of the program's function `f`: FunctionIR's `Call` of the same
// index, at a signature of words.
fn Tm::lower_call(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Ty::check_helds(w.tys, Sig::at(w.sigs, f).params).and_then(λ _ => Tm::lower_call_result(w, g, ports, next, f, args))
}

// A byte of span `k`: the index tested against the length word, the load
// in the arm the test guards, zero in the other. The function compiler
// lowers a load only where the path knows its index below the length home
// of the buffer (`File::bounded`), so the test is the code's bounds check
// and the meaning's (`List::byte_within`) at once; that `pl` is span
// `k`'s length home is the function compiler's to check, not this
// lowering's. The load is a leaf of its own, as that lowering reads one;
// the byte is the low eight bits of the word it leaves.
fn Tm::byte_lowered(k, pi, pl, next: Nat) → Lowered {
    Lowered(Compose(nodes_region([UnsignedLessThan(64, next, pi, pl)]),
            branch(next, Ports([Port(next + 2, 8)]),
                Compose(nodes_region([BufferLoad(next + 1, k, pi)]), nodes_region([Resize(64, 8, next + 2, next + 1)])),
                nodes_region([Const(8, next + 2, 0)]))),
        next + 2, next + 3)
}

fn Tm::byte_port_l(g: List<Ty>, ports: List<Nat>, next, k, i, length, pi: Nat) → Option<Lowered> {
    port_at(ports, length).and_then(λ pl => Tm::binary(g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next)))
}

fn Tm::lower_byte(g: List<Ty>, ports: List<Nat>, next, k, i, length: Nat) → Option<Lowered> {
    port_at(ports, i).and_then(λ pi => Tm::byte_port_l(g, ports, next, k, i, length, pi))
}

fn Tm::lower(self t: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    match t {
        Var(i) => port_at(ports, i).and_then(λ p => Some(Lowered(nodes_region(Nil), p, next))),
        Lit(c, n) => Tm::lower_lit(w.tys, c, n, next),
        Prim(op, args) => Tm::lower_prim(op, w.tys, g, ports, next, args),
        // The body sees the term's port as variable 0, and takes fresh ids
        // above the term's.
        Let(e, body) => Tm::lower(e, w, g, ports, next).and_then(λ le =>
            Tm::lower(body, w, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb))),
        // Each arm from the same context; the second's fresh ids above the
        // first's (either may run, never both).
        If(c, yes, no) => Tm::lower(yes, w, g, ports, next).and_then(λ ly =>
            Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))),
        // The convoyed equation is erased: the same branch as `If`.
        IfEq(c, yes, no) => Tm::lower(yes, w, g, ports, next).and_then(λ ly =>
            Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))),
        Make(i, args) => Tm::lower_make(w, g, ports, next, i, args),
        Field(i, k, of) => Tm::lower_field(w, g, ports, next, i, k, of),
        Call(f, args) => Tm::lower_call(w, g, ports, next, f, args),
        Fold(_, _, _) => None,
        // A fuel's `match` is a loop function's body (`Fun::lower_loop`),
        // lowered there and nowhere else.
        Case(_, _, _) => None,
        Byte(k, i, length) => Tm::lower_byte(g, ports, next, k, i, length),
        // The arms read the constructor at the enum's own port: the
        // constructor its word names is the one `pick` chose.
        Pick(i, c, arms, eq) => port_at(ports, c).and_then(λ pc =>
            Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next))),
    }
}

// ---------------------------------------------------------------------------
// Soundness.

// What a lowering promises: from any valuation where the environment holds
// and the ports are below `next`, with calls answered by the program's
// meanings, the region's evaluation moves `next` up, writes only at or
// above it, and leaves the term's meaning at its result.
fn Tm::LowerHolds(self t: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
            EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
            (next <= c.next) ∧ (Tm::ty(t, w, g).Below(w.tys, c.result, c.next) ∧ (Keeps(values, c.region.eval(call, values, buffers := w.spans), next) ∧
                Tm::ty(t, w, g).Holds(w.tys, c.region.eval(call, values, buffers := w.spans), c.result, Tm::sem(t, w, g, env)))),
    }
}

// A region that sets one fresh port: what it promises, from the value it
// leaves there.
theorem Tm::set_sound(tys: Nat → RecInfo, values: Valuation(), next: Nat, r: Ty, one: r.OnePort(), v: (wd: Nat) → BitVec(wd), m: r.sem(tys),
    h: r.Holds(tys, Valuation::set(values, next, v), next, m)):
    (next <= next + 1) ∧ (r.Below(tys, next, next + 1) ∧ (Keeps(values, Valuation::set(values, next, v), next) ∧
        r.Holds(tys, Valuation::set(values, next, v), next, m))) {
    ⟨Nat::le_succ_r(next, next, next.le_refl()), ⟨r.one_below(tys, next, next + 1, one, next.lt_succ_self()),
        ⟨λ wd id lt => Valuation::set_other(values, next, v, wd, id, Nat::ne_of_lt(id, next, lt)), h⟩⟩⟩
}

// An operand's port holds the meaning's operand, cast to the code the
// lowering checked.
theorem Tm::operand(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), a, pa: Nat, at_a: port_at(ports, a) = Some(pa), t: Ty, ea: Ty::at(g, a) = t):
    t.Holds(w.tys, values, pa, Ty::cast(w.tys, Ty::at(g, a), t, Env::get(w.tys, g, env, a))) {
    Ty::cast_holds(w.tys, values, pa, Ty::at(g, a), t, ea, Env::get(w.tys, g, env, a), env_holds_at(w.tys, values, g, ports, env, held, a, pa, at_a))
}

// The node equations the primitive table reads (design §6.3's first row):
// a word operation at its width, a comparison as its bit, a bit operation
// on one-bit words.
theorem Tm::word_op_holds(values: Valuation(), next, pa, pb, width: Nat, op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd),
    x, y: BitVec(width), hx: values(width, pa) = x, hy: values(width, pb) = y):
    Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb)), width, next) = op(width, x, y) {
    trans(Valuation::set_here(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb)), width), eq2(op(width), hx, hy))
}

theorem Tm::cmp_op_holds(values: Valuation(), next, pa, pb, width: Nat, cmp: BitVec(width) → BitVec(width) → Bool,
    x, y: BitVec(width), hx: values(width, pa) = x, hy: values(width, pb) = y):
    Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb))), 1, next) = BitVec::ofBool(cmp(x, y)) {
    trans(Valuation::set_here(values, next, bit_value(cmp(values(width, pa), values(width, pb))), 1),
        trans(bit_value_bit(cmp(values(width, pa), values(width, pb))), cong_fn(BitVec::ofBool, eq2(cmp, hx, hy))))
}

theorem Tm::band_ofBool(a, b: Bool): BitVec::ofBool(a).band(BitVec::ofBool(b)) = BitVec::ofBool(a.and(b)) {
    match a { False => match b { False => refl, True => refl }, True => match b { False => refl, True => refl } }
}

theorem Tm::bor_ofBool(a, b: Bool): BitVec::ofBool(a).bor(BitVec::ofBool(b)) = BitVec::ofBool(a.or(b)) {
    match a { False => match b { False => refl, True => refl }, True => match b { False => refl, True => refl } }
}

theorem Tm::bxor_one(a: Bool): BitVec::ofBool(a).bxor(BitVec::ofNat(1)) = BitVec::ofBool(a.not()) {
    match a { False => refl, True => refl }
}

theorem Tm::bit_code_holds(tys: Nat → RecInfo, n: Nat): BitVec::ofBool(Tm::lit(Bit, n, tys)) = BitVec::ofNat(Tm::bit_code(n)) {
    match n { Zero => refl, Succ(_) => refl }
}

// One word node, its operands of the code `Word(width)`.
theorem Tm::word_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb), width: Nat,
    op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd), ea: Ty::at(g, a) = Word(width), eb: Ty::at(g, b) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next) ∧
        Word(width).Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next,
            op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
                Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => op(wd, values(wd, pa), values(wd, pb)),
        op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b))),
        Tm::word_op_holds(values, next, pa, pb, width, op, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)),
            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea),
            Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Word(width), eb)))
}

// One comparison node: its bit.
theorem Tm::cmp_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb), width: Nat,
    cmp: BitVec(width) → BitVec(width) → Bool, ea: Ty::at(g, a) = Word(width), eb: Ty::at(g, b) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb)))), next) ∧
        Bit.Holds(w.tys, Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb)))), next,
            cmp(Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
                Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Bit, trivial, bit_value(cmp(values(width, pa), values(width, pb))),
        cmp(Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b))),
        Tm::cmp_op_holds(values, next, pa, pb, width, cmp, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)),
            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea),
            Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Word(width), eb)))
}

// One bitwise node on two bits: the connective `f` its node computes on
// one-bit words (`law`).
theorem Tm::bit_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb),
    op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd), f: Bool → Bool → Bool,
    law: (x, y: Bool) → op(1, BitVec::ofBool(x), BitVec::ofBool(y)) = BitVec::ofBool(f(x, y)),
    ea: Ty::at(g, a) = Bit, eb: Ty::at(g, b) = Bit):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next) ∧
        Bit.Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a)), Ty::cast(w.tys, Ty::at(g, b), Bit, Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a));
        let y = Ty::cast(w.tys, Ty::at(g, b), Bit, Env::get(w.tys, g, env, b));
        Tm::set_sound(w.tys, values, next, Bit, trivial, λ wd => op(wd, values(wd, pa), values(wd, pb)), f(x, y),
            trans(Tm::word_op_holds(values, next, pa, pb, 1, op, BitVec::ofBool(x), BitVec::ofBool(y),
                Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Bit, ea),
                Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Bit, eb)), law(x, y)))
    }
}

// One word node on one operand of the code `Word(width)`, its value at
// every width that width's operation (an immediate shift).
theorem Tm::word1_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), width: Nat,
    op: (wd: Nat) → BitVec(wd) → BitVec(wd), ea: Ty::at(g, a) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa))), next) ∧
        Word(width).Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa))), next,
            op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => op(wd, values(wd, pa)),
        op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a))),
        trans(Valuation::set_here(values, next, λ wd => op(wd, values(wd, pa)), width),
            cong_fn(op(width), Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea))))
}

// One `Resize` from `Word(from)` to `Word(to)`: its value is the operand's
// number at the result's width, which is the operation `f` (`law`: a zero
// extension or a truncation).
theorem Tm::resize_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), from, to: Nat,
    f: BitVec(from) → BitVec(to), law: (x: BitVec(from)) → BitVec::ofNat(x.toNat(), n := to) = f(x), ea: Ty::at(g, a) = Word(from)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat())), next) ∧
        Word(to).Holds(w.tys, Valuation::set(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat())), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a));
        Tm::set_sound(w.tys, values, next, Word(to), trivial, λ wd => BitVec::ofNat(values(from, pa).toNat()), f(x),
            trans(Valuation::set_here(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat()), to),
                trans(cong_fn(λ (y: BitVec(from)) => BitVec::ofNat(y.toNat(), n := to),
                        Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(from), ea)),
                    law(x))))
    }
}

// The same for a `SignResize`: its value at the output's width is the
// operand read in two's complement there.
theorem Tm::sresize_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), from, to: Nat,
    f: BitVec(from) → BitVec(to), law: (x: BitVec(from)) → x.sresize(to) = f(x), ea: Ty::at(g, a) = Word(from)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => values(from, pa).sresize(wd)), next) ∧
        Word(to).Holds(w.tys, Valuation::set(values, next, λ wd => values(from, pa).sresize(wd)), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a));
        Tm::set_sound(w.tys, values, next, Word(to), trivial, λ wd => values(from, pa).sresize(wd), f(x),
            trans(Valuation::set_here(values, next, λ wd => values(from, pa).sresize(wd), to),
                trans(cong_fn(λ (y: BitVec(from)) => y.sresize(to),
                        Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(from), ea)),
                    law(x))))
    }
}

// A check of the operand's code, then the leaf.
theorem Tm::unary_sound(P: Option<Lowered> → Type, none: P(None), g: List<Ty>, a: Nat, t: Ty, l: Lowered,
    leaf: Ty::at(g, a) = t → P(Some(l))): P(Tm::unary(g, a, t, l)) {
    Option::and_then_elim(P, none, Ty::at(g, a).check(t), λ _ => Some(l), λ ea _ => leaf(ea))
}

// A check of both operands' codes, then the leaf.
theorem Tm::binary_sound(P: Option<Lowered> → Type, none: P(None), g: List<Ty>, a, b: Nat, t: Ty, l: Lowered,
    leaf: Ty::at(g, a) = t → Ty::at(g, b) = t → P(Some(l))): P(Tm::binary(g, a, b, t, l)) {
    Option::and_then_elim(P, none, Ty::at(g, a).check(t), λ _ => Tm::binary_b(g, b, t, l), λ ea _ =>
    Option::and_then_elim(P, none, Ty::at(g, b).check(t), λ _ => Some(l), λ eb _ => leaf(ea, eb)))
}

theorem Tm::lower_lit_sound(w: World, g: List<Ty>, ports: List<Nat>, next: Nat, c: Ty, n: Nat):
    Tm::LowerHolds(Lit(c, n), w, g, ports, next, Tm::lower_lit(w.tys, c, n, next)) {
    match c {
        Word(width) => λ call agree values env held below =>
            Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => BitVec::ofNat(n), BitVec::ofNat(n),
                Valuation::set_here(values, next, λ wd => BitVec::ofNat(n), width)),
        Bit => λ call agree values env held below =>
            Tm::set_sound(w.tys, values, next, Bit, trivial, λ wd => BitVec::ofNat(Tm::bit_code(n)), Tm::lit(Bit, n, w.tys),
                trans(Valuation::set_here(values, next, λ wd => BitVec::ofNat(Tm::bit_code(n)), 1), sym(Tm::bit_code_holds(w.tys, n)))),
        ByteList(_) => trivial,
        Lines => trivial,
        Named(_) => trivial,
        Count => trivial,
        // The constructor's tag, a constant: its word is the tag, which
        // `of` and the tag invert (`EnumInfo.tag_of`).
        Enum(i) => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Lit(Enum(i), n), w, g, ports, next, r);
            let e = w.tys(i).alts;
            Option::and_then_elim(P, trivial, Tm::check_true(n.leb(e.last)), λ _ => Tm::lit_tag(n, next), λ among _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((n + 1).leb(Nat::pow(2, 64))), λ _ => Some(Tm::one_node(Const(64, next, n), next)), λ fits _ =>
                λ call agree values env held below => {
                    let le: (n <= e.last) = Nat::leb_sound(n, e.last, among);
                    let set = λ (wd: Nat) => BitVec::ofNat(n, n := wd);
                    let word: (Valuation::set(values, next, set)(64, next).toNat() = n) =
                        trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), Valuation::set_here(values, next, set, 64)),
                            BitVec::toNat_ofNat(64, n, Nat::leb_sound(n + 1, Nat::pow(2, 64), fits)));
                    let at: e.Names(Valuation::set(values, next, set)(64, next), e.of(n)) =
                        ⟨trans(word, sym(e.tag_of(n, le))), j(sym(word), λ m _ => m <= e.last, le)⟩;
                    ⟨Nat::le_succ_r(next, next, next.le_refl()), ⟨next.lt_succ_self(),
                        ⟨λ wd id lt => Valuation::set_other(values, next, set, wd, id, Nat::ne_of_lt(id, next, lt)), at⟩⟩⟩
                }))
        },
    }
}

theorem Tm::prim2_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb)):
    Tm::LowerHolds(Prim(op, [a, b]), w, g, ports, next, Tm::prim2(op, g, next, a, b, pa, pb)) {
    match op {
        Add(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Add(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Add(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.add(y), ea, eb)),
        Sub(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Sub(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Sub(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.sub(y), ea, eb)),
        Band(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Band(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitAnd(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.band(y), ea, eb)),
        Bor(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Bor(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitOr(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.bor(y), ea, eb)),
        Bxor(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Bxor(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitXor(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.bxor(y), ea, eb)),
        Eq(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Eq(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Equal(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.eq_bit(y), ea, eb)),
        Ult(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Ult(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(UnsignedLessThan(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.unsigned_lt_bit(y), ea, eb)),
        Slt(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Slt(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(SignedLessThan(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.signed_lt_bit(y), ea, eb)),
        Conj => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Conj, [a, b]), w, g, ports, next, r), trivial, g, a, b, Bit,
            Tm::one_node(BitAnd(1, next, pa, pb), next), λ ea eb =>
            Tm::bit_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, λ wd x y => x.band(y), λ x y => x.and(y),
                λ x y => Tm::band_ofBool(x, y), ea, eb)),
        Disj => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Disj, [a, b]), w, g, ports, next, r), trivial, g, a, b, Bit,
            Tm::one_node(BitOr(1, next, pa, pb), next), λ ea eb =>
            Tm::bit_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, λ wd x y => x.bor(y), λ x y => x.or(y),
                λ x y => Tm::bor_ofBool(x, y), ea, eb)),
        Neg => trivial,
        Zext(_, _) => trivial,
        Get(_) => trivial,
        Set(_) => trivial,
        ConsLine(_) => trivial,
        ToNat => trivial,
        Trunc(_, _) => trivial,
        Shl(_, _) => trivial, Lshr(_, _) => trivial, Ashr(_, _) => trivial,
        Sext(_, _) => trivial,
        TagIs(_, _) => trivial,
        Apply(o, width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Apply(o, width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Node::Apply(o, width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => o.run(x, y), ea, eb)),
    }
}

// `!x`: the constant leaves the operand's port alone (it is below `next`),
// and the exclusive or with one is the negation.
theorem Tm::neg_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), ea: Ty::at(g, a) = Bit):
    Tm::LowerHolds(Prim(Neg, [a]), w, g, ports, next, Some(Tm::neg_lowered(next, pa))) {
    λ call agree values env held below => {
        let one = Valuation::set(values, next, λ wd => BitVec::ofNat(1));
        let x = Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a));
        let pa_lt: (pa < next) = Ty::below_cast(w.tys, Ty::at(g, a), Bit, ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a));
        let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
        ⟨Nat::le_succ_r(next, next + 1, step), ⟨(next + 1).lt_succ_self(),
            ⟨λ wd id lt => trans(Valuation::set_other(one, next + 1, λ v => one(v, pa).bxor(one(v, next)), wd, id,
                    Nat::ne_of_lt(id, next + 1, Nat::lt_of_lt_of_le(id, next, next + 1, lt, step))),
                Valuation::set_other(values, next, λ v => BitVec::ofNat(1), wd, id, Nat::ne_of_lt(id, next, lt))),
            trans(Valuation::set_here(one, next + 1, λ v => one(v, pa).bxor(one(v, next)), 1),
                trans(eq2(λ (p: BitVec(1)) (q: BitVec(1)) => p.bxor(q),
                        trans(Valuation::set_other(values, next, λ v => BitVec::ofNat(1), 1, pa, Nat::ne_of_lt(pa, next, pa_lt)),
                            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Bit, ea)),
                        Valuation::set_here(values, next, λ v => BitVec::ofNat(1), 1)),
                    Tm::bxor_one(x)))⟩⟩⟩
    }
}

// `same` on two apart numbers.
theorem Tm::same_apart(a, k: Nat, ne: a ≠ k): a.same(k) = False {
    (match a.same(k) as λ b => a.same(k) = b → a.same(k) = False {
        True => λ e => false_elim(ne(Nat::same_sound(a, k, e))),
        False => λ e => e,
    })(refl)
}

// The compare of an enum's word with a tag before the last is the test of
// its tag.
theorem Tm::tag_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa, i, k: Nat, at_a: port_at(ports, a) = Some(pa),
    ea: Ty::at(g, a) = Enum(i), lt: k < w.tys(i).alts.last, small: k < Nat::pow(2, 64)):
    Tm::LowerHolds(Prim(TagIs(i, k), [a]), w, g, ports, next, Some(Tm::tag_lowered(next, pa, k))) {
    λ call agree values env held below => {
        let e = w.tys(i).alts;
        let constant = Valuation::set(values, next, λ wd => BitVec::ofNat(k));
        let compared = bit_value(constant(64, pa).eq_bit(constant(64, next)));
        let v = Ty::cast(w.tys, Ty::at(g, a), Enum(i), Env::get(w.tys, g, env, a));
        let held_v: e.Names(values(64, pa), v) = Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Enum(i), ea);
        let pa_lt: (pa < next) = Ty::below_cast(w.tys, Ty::at(g, a), Enum(i), ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a));
        let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
        let at_pa: (constant(64, pa) = values(64, pa)) = Valuation::set_other(values, next, λ wd => BitVec::ofNat(k), 64, pa, Nat::ne_of_lt(pa, next, pa_lt));
        let at_next: (constant(64, next) = BitVec::ofNat(k)) = Valuation::set_here(values, next, λ wd => BitVec::ofNat(k), 64);
        let test: (constant(64, pa).eq_bit(constant(64, next)) = e.tag(v).same(k)) =
            trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => x.eq_bit(y), at_pa, at_next),
                trans(BitVec::eq_bit_nat(64, values(64, pa), BitVec::ofNat(k)),
                    trans(cong_fn(λ (n: Nat) => values(64, pa).toNat().same(n), BitVec::toNat_ofNat(64, k, small)),
                        cong_fn(λ (n: Nat) => n.same(k), held_v.left))));
        ⟨Nat::le_succ_r(next, next + 1, step), ⟨(next + 1).lt_succ_self(),
            ⟨λ wd id lt2 => trans(Valuation::set_other(constant, next + 1, compared, wd, id,
                    Nat::ne_of_lt(id, next + 1, Nat::lt_of_lt_of_le(id, next, next + 1, lt2, step))),
                Valuation::set_other(values, next, λ x => BitVec::ofNat(k), wd, id, Nat::ne_of_lt(id, next, lt2))),
            trans(Valuation::set_here(constant, next + 1, compared, 1),
                trans(bit_value_bit(constant(64, pa).eq_bit(constant(64, next))), cong_fn(BitVec::ofBool, test)))⟩⟩⟩
    }
}

theorem Tm::prim1_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa)):
    Tm::LowerHolds(Prim(op, [a]), w, g, ports, next, Tm::prim1(op, w.tys, g, next, a, pa)) {
    match op {
        TagIs(i, k) => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(TagIs(i, k), [a]), w, g, ports, next, r);
            Option::and_then_elim(P, trivial, Ty::at(g, a).check(Enum(i)), λ _ => Tm::tag_below(w.tys, next, pa, i, k), λ ea _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((k + 1).leb(w.tys(i).alts.last)), λ _ => Tm::tag_small(w.tys, next, pa, i, k), λ below_last _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((k + 1).leb(Nat::pow(2, 64))), λ _ => Some(Tm::tag_lowered(next, pa, k)), λ fits _ =>
                Tm::tag_sound(w, g, ports, next, a, pa, i, k, at_a, ea, Nat::leb_sound(k + 1, w.tys(i).alts.last, below_last),
                    Nat::leb_sound(k + 1, Nat::pow(2, 64), fits)))))
        },
        Neg => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(Neg, [a]), w, g, ports, next, r), trivial,
            Ty::at(g, a).check(Bit), λ _ => Some(Tm::neg_lowered(next, pa)), λ ea _ => Tm::neg_sound(w, g, ports, next, a, pa, at_a, ea)),
        ToNat => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(ToNat, [a]), w, g, ports, next, r), trivial,
            Ty::at(g, a).check(Word(64)), λ _ => Some(Lowered(nodes_region(Nil), pa, next)), λ ea _ =>
            λ call agree values env held below =>
                ⟨next.le_refl(), ⟨Ty::below_cast(w.tys, Ty::at(g, a), Word(64), ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a)),
                    ⟨λ wd id _ => refl, cong_fn(λ (x: BitVec(64)) => x.toNat(), Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(64), ea))⟩⟩⟩),
        Zext(width, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Zext(width, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(Resize(width, extra + width, next, pa), next), λ ea =>
            Tm::resize_node_sound(w, g, ports, next, a, pa, at_a, width, extra + width, λ x => x.zero_extend(extra),
                BitVec::ofNat_toNat_zero_extend(width, extra), ea)),
        Trunc(n, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Trunc(n, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(extra + n),
            Tm::one_node(Resize(extra + n, n, next, pa), next), λ ea =>
            Tm::resize_node_sound(w, g, ports, next, a, pa, at_a, extra + n, n, λ x => x.truncate(n, extra),
                BitVec::ofNat_toNat_truncate(n, extra), ea)),
        Shl(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Shl(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(ShiftLeft(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.shift_left(k), ea)),
        Lshr(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Lshr(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(LogicalShiftRight(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.shift_right(k), ea)),
        Ashr(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Ashr(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(ArithmeticShiftRight(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.arithmetic_shift_right(k), ea)),
        Sext(n, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Sext(n, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(n + 1),
            Tm::one_node(SignResize(n + 1, extra + (n + 1), next, pa), next), λ ea =>
            Tm::sresize_node_sound(w, g, ports, next, a, pa, at_a, n + 1, extra + (n + 1), λ x => x.sign_extend(extra),
                λ x => BitVec::sresize_sign_extend(n, extra, x), ea)),
        _ => trivial,
    }
}

theorem Tm::lower_prim_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next: Nat, args: List<Nat>):
    Tm::LowerHolds(Prim(op, args), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, args)) {
    match args {
        Nil => trivial,
        Cons(a, more) => match more as λ m =>
            Tm::LowerHolds(Prim(op, Cons(a, m)), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, Cons(a, m))) {
            Nil => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(op, [a]), w, g, ports, next, r), trivial,
                port_at(ports, a), λ pa => Tm::prim1(op, w.tys, g, next, a, pa), λ pa at_a => Tm::prim1_sound(op, w, g, ports, next, a, pa, at_a)),
            Cons(b, rest) => match rest as λ r2 =>
                Tm::LowerHolds(Prim(op, Cons(a, Cons(b, r2))), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, Cons(a, Cons(b, r2)))) {
                Cons(_, _) => trivial,
                Nil => {
                    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(op, [a, b]), w, g, ports, next, r);
                    Option::and_then_elim(P, trivial, port_at(ports, a), λ pa => Tm::prim2_port_b(op, g, ports, next, a, b, pa), λ pa at_a =>
                    Option::and_then_elim(P, trivial, port_at(ports, b), λ pb => Tm::prim2(op, g, next, a, b, pa, pb), λ pb at_b =>
                        Tm::prim2_sound(op, w, g, ports, next, a, b, pa, pb, at_a, at_b)))
                },
            },
        },
    }
}

// The `If` case, from what each arm's lowering promises.
theorem Tm::if_sound(c: Nat, yes, no: Tm, w: World,
    ih_yes: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(yes, w, g, ports, next, Tm::lower(yes, w, g, ports, next)),
    ih_no: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(no, w, g, ports, next, Tm::lower(no, w, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::LowerHolds(If(c, yes, no), w, g, ports, next, Tm::lower(If(c, yes, no), w, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(If(c, yes, no), w, g, ports, next, r);
    let ty_yes = Tm::ty(yes, w, g);
    let ty_no = Tm::ty(no, w, g);
    Option::and_then_elim(P, trivial, Tm::lower(yes, w, g, ports, next),
        λ ly => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, ty_yes, ty_no, ly, ln)), λ ly lowered_yes =>
    Option::and_then_elim(P, trivial, Tm::lower(no, w, g, ports, ly.next), λ ln => Tm::lower_branch(w.tys, g, ports, c, ty_yes, ty_no, ly, ln),
        λ ln lowered_no =>
    Option::and_then_elim(P, trivial, port_at(ports, c), λ pc => Tm::branch_checked(w.tys, g, c, ty_yes, ty_no, pc, ly, ln), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Bit), λ _ => Tm::branch_typed(w.tys, ty_yes, ty_no, pc, ly, ln), λ ec _ =>
    Option::and_then_elim(P, trivial, ty_no.check(ty_yes), λ _ => Some(Tm::branch_lowered(w.tys, ty_yes, pc, ly, ln)), λ en _ =>
        λ call agree values env held below => {
            let out = ln.next;
            let first = j(lowered_yes, λ r _ => Tm::LowerHolds(yes, w, g, ports, next, r),
                ih_yes(g, ports, next))(call, agree, values, env, held, below);
            let second = j(lowered_no, λ r _ => Tm::LowerHolds(no, w, g, ports, ly.next, r),
                ih_no(g, ports, ly.next))(call, agree, values, env, held, below_mono(w.tys, g, next, ly.next, first.left, ports, below));
            let mid_yes = ly.region.eval(call, values, buffers := w.spans);
            let mid_no = ln.region.eval(call, values, buffers := w.spans);
            let reaches: (next <= out) = Nat::le_trans(next, ly.next, out, first.left, second.left);
            let scrutinee = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c));
            let bit = Tm::operand(w, g, ports, values, env, held, c, pc, at_c, Bit, ec);
            let chosen = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(scrutinee));
            let no_cast = Ty::cast(w.tys, ty_no, ty_yes, Tm::sem(no, w, g, env));
            let moved_yes = ty_yes.moves_sound(w.tys, w.spans, mid_yes, out, ly.result,
                ty_yes.below_mono(w.tys, ly.result, ly.next, out, second.left, first.right.left), Tm::sem(yes, w, g, env), first.right.right.right);
            let moved_no = ty_yes.moves_sound(w.tys, w.spans, mid_no, out, ln.result, Ty::below_cast(w.tys, ty_no, ty_yes, en, ln.result, out, second.right.left),
                no_cast, Ty::cast_holds(w.tys, mid_no, ln.result, ty_no, ty_yes, en, Tm::sem(no, w, g, env), second.right.right.right));
            let when_true = Compose(ly.region, nodes_region(ty_yes.moves(w.tys, out, ly.result)));
            let when_false = Compose(ln.region, nodes_region(ty_yes.moves(w.tys, out, ln.result)));
            ⟨Nat::le_trans(next, out, ty_yes.past(w.tys, out), reaches, moved_yes.right.right.right), ⟨moved_yes.right.right.left,
                ⟨branch_keeps(values, pc, moved_ports(ty_yes.moves(w.tys, out, ly.result)), when_true, when_false, call, w.spans, next,
                    λ wd id lt => trans(moved_yes.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, out, lt, reaches)), first.right.right.left(wd, id, lt)),
                    λ wd id lt => trans(moved_no.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, out, lt, reaches)),
                        second.right.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, ly.next, lt, first.left)))),
                branch_holds(ty_yes, w.tys, values, pc, moved_ports(ty_yes.moves(w.tys, out, ly.result)), when_true, when_false, call, w.spans, out, scrutinee,
                    Tm::sem(yes, w, g, env), no_cast, chosen, moved_yes.left, moved_no.left)⟩⟩⟩
        })))))
}

// A convoy is the plain match: the equation it carries is read only by
// proofs.
theorem Tm::convoy_match(T: Type, b: Bool, yes, no: T): Tm::convoy(T, b, yes, no) = match b { False => no, True => yes } {
    match b { False => refl, True => refl }
}

// `IfEq` lowers as `If` does, and means what `If` means.
theorem Tm::ifeq_of_if(c: Nat, yes, no: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat):
    (r: Option<Lowered>) → Tm::LowerHolds(If(c, yes, no), w, g, ports, next, r) → Tm::LowerHolds(IfEq(c, yes, no), w, g, ports, next, r) {
    λ r => match r as λ q => Tm::LowerHolds(If(c, yes, no), w, g, ports, next, q) → Tm::LowerHolds(IfEq(c, yes, no), w, g, ports, next, q) {
        None => λ _ => trivial,
        Some(l) => λ h call agree values env held below => {
            let held_if = h(call, agree, values, env, held, below);
            let scrutinee = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c));
            let ty_yes = Tm::ty(yes, w, g);
            ⟨held_if.left, ⟨held_if.right.left, ⟨held_if.right.right.left,
                j(sym(Tm::convoy_match(ty_yes.sem(w.tys), scrutinee, Tm::sem(yes, w, g, env),
                        Ty::cast(w.tys, Tm::ty(no, w, g), ty_yes, Tm::sem(no, w, g, env)))),
                    λ v _ => ty_yes.Holds(w.tys, l.region.eval(call, values, buffers := w.spans), l.result, v), held_if.right.right.right)⟩⟩⟩
        },
    }
}

// A call's argument ports hold words whose answer is the callee's meaning
// on the meaning's arguments.
theorem Tm::call_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), r: Ty, ps: List<Ty>):
    (args: List<Nat>) → (F: Ty::Arrows(w.tys, ps, r)) → (ans: List<BitVec(64)> → BitVec(64)) →
    Ty::Answers(w.tys, ps, r, F, ans) → (qs: List<Nat>) → Tm::call_args(w.tys, g, ports, ps, args) = Some(qs) →
    ans(words_of(values, qs)) = Ty::cast(w.tys, r, Word(64), Tm::apply(w, g, env, r, ps, F, args)) {
    match ps {
        Nil => λ args => match args {
            Nil => λ F ans answers qs e =>
                j(Option::some_inj(Nil, qs, e), λ z _ => ans(words_of(values, z)) = Ty::cast(w.tys, r, Word(64), F), answers),
            Cons(a, more) => λ F ans answers qs e => Option::none_ne_some(qs, e,
                ans(words_of(values, qs)) = Ty::cast(w.tys, r, Word(64), Tm::apply(w, g, env, r, Nil, F, Cons(a, more)))),
        },
        Cons(p, rest) => λ args => match args {
            Nil => λ F ans answers qs e => Option::none_ne_some(qs, e,
                ans(words_of(values, qs)) = Ty::cast(w.tys, r, Word(64), Tm::apply(w, g, env, r, Cons(p, rest), F, Nil))),
            Cons(a, more) => λ F ans answers => {
                let Goal = λ (qs: List<Nat>) => ans(words_of(values, qs)) = Ty::cast(w.tys, r, Word(64), Tm::apply(w, g, env, r, Cons(p, rest), F, Cons(a, more)));
                let P = λ (o: Option<List<Nat>>) => (qs: List<Nat>) → o = Some(qs) → Goal(qs);
                let none: P(None) = λ qs e => Option::none_ne_some(qs, e, Goal(qs));
                let after = λ (q: Nat) => p.check_held(w.tys).and_then(λ _ => Tm::call_args(w.tys, g, ports, rest, more).and_then(λ qs => Some(Cons(q, qs))));
                Option::and_then_elim(P, none, port_at(ports, a), λ q => Ty::at(g, a).check(p).and_then(λ _ => after(q)), λ q at_q =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(p), λ _ => after(q), λ ea _ =>
                Option::and_then_elim(P, none, p.check_held(w.tys), λ _ => Tm::call_args(w.tys, g, ports, rest, more).and_then(λ qs => Some(Cons(q, qs))), λ hp _ =>
                Option::and_then_elim(P, none, Tm::call_args(w.tys, g, ports, rest, more), λ qs => Some(Cons(q, qs)), λ found e_rest =>
                    λ qs e => j(Option::some_inj(Cons(q, found), qs, e), λ z _ => Goal(z), {
                        let x = values(64, q);
                        let arg_eq: (Ty::cast(w.tys, Word(64), p, x) = Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a))) =
                            Ty::held_reads(w.tys, p, values, q, hp, Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a)),
                                Tm::operand(w, g, ports, values, env, held, a, q, at_q, p, ea));
                        trans(Tm::call_args_sound(w, g, ports, values, env, held, r, rest, more, F(Ty::cast(w.tys, Word(64), p, x)),
                                λ ws => ans(Cons(x, ws)), Ty::given_at(p, w.tys, x, answers(x), Ty::holds_admits(w.tys, p, values, q, Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a)),
                                    Tm::operand(w, g, ports, values, env, held, a, q, at_q, p, ea))), found, e_rest),
                            cong_fn(λ (u: p.sem(w.tys)) => Ty::cast(w.tys, r, Word(64), Tm::apply(w, g, env, r, rest, F(u), more)), arg_eq))
                    })))))
            },
        },
    }
}

theorem Tm::lower_call_sound(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>):
    Tm::LowerHolds(Call(f, args), w, g, ports, next, Tm::lower_call(w, g, ports, next, f, args)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Call(f, args), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, Ty::check_helds(w.tys, Sig::at(w.sigs, f).params), λ _ => Tm::lower_call_result(w, g, ports, next, f, args), λ ok _ =>
    Option::and_then_elim(P, trivial, Sig::at(w.sigs, f).result.check_returned(w.tys), λ _ => Tm::lower_call_args(w, g, ports, next, f, args), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::call_args(w.tys, g, ports, Sig::at(w.sigs, f).params, args),
        λ qs => Some(Tm::called(f, qs, next)), λ qs e_qs =>
        λ call agree values env held below => {
            let r = Sig::at(w.sigs, f).result;
            let meaning = Tm::apply(w, g, env, r, Sig::at(w.sigs, f).params, Sig::get(w.tys, w.sigs, w.callees, f), args);
            let answered = Tm::call_args_sound(w, g, ports, values, env, held, r, Sig::at(w.sigs, f).params, args,
                Sig::get(w.tys, w.sigs, w.callees, f), λ ws => call(f, ws), agree(f, ⟨ok, er⟩), qs, e_qs);
            let v = word_value(call(f, words_of(values, qs)));
            let called = Valuation::set(values, next, v);
            let word: (called(64, next) = Ty::cast(w.tys, r, Word(64), meaning)) = trans(Valuation::set_here(values, next, v, 64), answered);
            // The move: the result again, one port up.
            let moved = λ (wd: Nat) => called(wd, next);
            let after = Valuation::set(called, next + 1, moved);
            let word_moved: (after(64, next + 1) = Ty::cast(w.tys, r, Word(64), meaning)) =
                trans(Valuation::set_here(called, next + 1, moved, 64), word);
            // The result, held in one word (a word, or a record held at its
            // repr's word), holds at the moved port.
            let holds: r.Holds(w.tys, after, next + 1, meaning) = Ty::returned_holds(w.tys, after, next + 1, r, er, meaning, word_moved);
            ⟨Nat::le_succ_r(next, next + 1, Nat::le_succ_r(next, next, next.le_refl())),
                ⟨Ty::returned_below(w.tys, r, er, next + 1),
                    ⟨λ wd id lt => trans(Valuation::set_other(called, next + 1, moved, wd, id,
                            Nat::ne_of_lt(id, next + 1, Nat::lt_trans(id, next, next + 1, lt, next.lt_succ_self()))),
                        Valuation::set_other(values, next, v, wd, id, Nat::ne_of_lt(id, next, lt))),
                        holds⟩⟩⟩
        })))
}

// `Make`'s moves: the field variables' values at the fields' ports, from
// any valuation that still keeps the environment's (below `next`), each move
// at or above `next`.
fn Tm::MadeFields(w: World, g: List<Ty>, env: Env(w.tys, g), next: Nat, fs: List<Ty>, args: List<Nat>, out: Nat, ns: List<Node>,
    values0: Valuation()) → Type {
    (values: Valuation()) → Keeps(values0, values, next) → next <= out →
        Ty::MovedFields(fs, values, eval_nodes_over(w.spans, ns, values), out, Tm::fields(w, g, env, fs, args))
}

theorem Tm::make_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values0: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values0, g, ports, env), next: Nat, below: Below(w.tys, g, ports, next), fs: List<Ty>):
    (args: List<Nat>) → (out: Nat) → Ty::OnePorts(fs) → (ns: List<Node>) → Tm::make_args(g, ports, fs, args, out) = Some(ns) →
    Tm::MadeFields(w, g, env, next, fs, args, out, ns, values0) {
    match fs {
        Nil => λ args => match args {
            Nil => λ out ones ns e => j(Option::some_inj(Nil, ns, e), λ z _ => Tm::MadeFields(w, g, env, next, Nil, Nil, out, z, values0),
                λ values _ _ => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩),
            Cons(a, more) => λ out ones ns e => Option::none_ne_some(ns, e, Tm::MadeFields(w, g, env, next, Nil, Cons(a, more), out, ns, values0)),
        },
        Cons(f, rest) => λ args => match args {
            Nil => λ out ones ns e => Option::none_ne_some(ns, e, Tm::MadeFields(w, g, env, next, Cons(f, rest), Nil, out, ns, values0)),
            Cons(a, more) => λ out ones => {
                let Goal = λ (ns: List<Node>) => Tm::MadeFields(w, g, env, next, Cons(f, rest), Cons(a, more), out, ns, values0);
                let P = λ (o: Option<List<Node>>) => (ns: List<Node>) → o = Some(ns) → Goal(ns);
                let none: P(None) = λ ns e => Option::none_ne_some(ns, e, Goal(ns));
                Option::and_then_elim(P, none, port_at(ports, a), λ q =>
                    Ty::at(g, a).check(f).and_then(λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns)))),
                    λ q at_q =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(f),
                    λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))), λ ea _ =>
                Option::and_then_elim(P, none, Tm::make_args(g, ports, rest, more, out + 1), λ ns => Some(Cons(Move(f.width(), out, q), ns)),
                    λ found e_rest => λ ns e => j(Option::some_inj(Cons(Move(f.width(), out, q), found), ns, e), λ z _ => Goal(z),
                    λ values keeps0 le => {
                        let x = Ty::cast(w.tys, Ty::at(g, a), f, Env::get(w.tys, g, env, a));
                        let moved = Valuation::set(values, out, λ wd => values(wd, q));
                        let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
                        let q_next: (q < next) = f.below_one(w.tys, q, next, ones.left,
                            Ty::below_cast(w.tys, Ty::at(g, a), f, ea, q, next, below_at(w.tys, g, ports, next, below, a, q, at_q)));
                        let kept: Keeps(values0, moved, next) = λ wd id lt => trans(Valuation::set_other(values, out, λ v => values(v, q), wd, id,
                            Nat::ne_of_lt(id, out, Nat::lt_of_lt_of_le(id, next, out, lt, le))), keeps0(wd, id, lt));
                        let later = Tm::make_args_sound(w, g, ports, values0, env, held, next, below, rest, more, out + 1, ones.right, found, e_rest,
                            moved, kept, Nat::le_succ_r(next, out, le));
                        let after = eval_nodes_over(w.spans, found, moved);
                        ⟨⟨f.flat_at(values0, after, q, out,
                                λ wd => trans(later.right.left(wd, out, out.lt_succ_self()),
                                    trans(Valuation::set_here(values, out, λ v => values(v, q), wd), keeps0(wd, q, q_next))),
                                f.to_flat(w.tys, x),
                                f.flat_of_holds(w.tys, values0, q, ones.left, x, Tm::operand(w, g, ports, values0, env, held, a, q, at_q, f, ea))),
                            later.left⟩,
                            ⟨λ wd id lt => trans(later.right.left(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)),
                                    Valuation::set_other(values, out, λ v => values(v, q), wd, id, Nat::ne_of_lt(id, out, lt))),
                                ⟨⟨later.right.right.right, later.right.right.left⟩,
                                    Nat::le_trans(out, out + 1, Ty::fields_past(rest, out + 1), step, later.right.right.right)⟩⟩⟩
                    }))))
            },
        },
    }
}

// `Make`: the moves, and the record's projection of what it built is its
// fields (`RecInfo::round`).
theorem Tm::lower_make_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>):
    Tm::LowerHolds(Make(i, args), w, g, ports, next, Tm::lower_make(w, g, ports, next, i, args)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Make(i, args), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, Ty::check_ones(w.tys(i).fields), λ _ => Tm::make_moves(w, g, ports, next, i, args), λ ones _ =>
    Option::and_then_elim(P, trivial, Tm::make_args(g, ports, w.tys(i).fields, args, next),
        λ ns => Some(Lowered(nodes_region(ns), next, Ty::fields_past(w.tys(i).fields, next))), λ ns e_ns =>
        λ call agree values env held below => {
            let fs = w.tys(i).fields;
            let t = Tm::fields(w, g, env, fs, args);
            let made = Tm::make_args_sound(w, g, ports, values, env, held, next, below, fs, args, next, ones, ns, e_ns,
                values, λ wd id _ => refl, next.le_refl());
            ⟨made.right.right.right, ⟨made.right.right.left, ⟨made.right.left,
                j(sym(w.tys(i).round(t)), λ u _ => Ty::FieldsHold(fs, eval_nodes_over(w.spans, ns, values), next, u), made.left)⟩⟩⟩
        }))
}

// `Field`: the record's field `k` is at its port already.
theorem Tm::lower_field_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i, k, of: Nat):
    Tm::LowerHolds(Field(i, k, of), w, g, ports, next, Tm::lower_field(w, g, ports, next, i, k, of)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Field(i, k, of), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, port_at(ports, of), λ p => Tm::field_typed(w, g, next, i, k, of, p), λ p at_p =>
    Option::and_then_elim(P, trivial, Ty::at(g, of).check(Named(i)), λ _ => Tm::field_ranged(w, next, i, k, p), λ e _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(Ty::has_field(w.tys(i).fields, k)), λ _ => Tm::field_one(w, next, i, k, p), λ has _ =>
    Option::and_then_elim(P, trivial, Ty::at(w.tys(i).fields, k).check_one(),
        λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(k, p), next)), λ one _ =>
        λ call agree values env held below => {
            let fs = w.tys(i).fields;
            let x = Ty::cast(w.tys, Ty::at(g, of), Named(i), Env::get(w.tys, g, env, of));
            let record: Ty::FieldsHold(fs, values, p, w.tys(i).get(x)) = Tm::operand(w, g, ports, values, env, held, of, p, at_p, Named(i), e);
            let spans: Ty::FieldsBelow(fs, p, next) =
                Ty::below_cast(w.tys, Ty::at(g, of), Named(i), e, p, next, below_at(w.tys, g, ports, next, below, of, p, at_p));
            ⟨next.le_refl(), ⟨Ty::at(fs, k).one_below(w.tys, Ty::field_port(k, p), next, one, Ty::fields_below_at(fs, next, p, k, has, spans)),
                ⟨λ wd id _ => refl, Ty::at(fs, k).holds_of_flat(w.tys, values, Ty::field_port(k, p), Ty::flat_nth(fs, w.tys(i).get(x), k),
                    Ty::fields_hold_at(fs, values, p, k, has, w.tys(i).get(x), record))⟩⟩⟩
        }))))
}

// A byte of a lent span.

// The word a load leaves holds its byte in its low eight bits.
theorem Tm::byte_back(b: BitVec(8)): BitVec::ofNat(byte_word(b).toNat(), n := 8) = b {
    trans(BitVec::ofNat_toNat_truncate(8, 56, b.zero_extend(56)), BitVec::truncate_zero_extend(8, 56, b))
}

// FunctionIR's byte of a buffer of the file is the span's byte.
theorem Tm::span_byte(spans: List<List<BitVec(8)>>, k: Nat, i: BitVec(64)): buffer_byte(spans, k, i.toNat()) = spans.span(k).byte_at(i) {
    match spans.nth(k) as λ found => (match found { None => BitVec::zero(), Some(bytes) => match bytes.nth(i.toNat()) { None => BitVec::zero(), Some(byte) => byte } })
        = List::byte_at(match found { None => [], Some(bytes) => bytes }, i) {
        None => refl,
        Some(bytes) => match bytes.nth(i.toNat()) as λ at => (match at { None => BitVec::zero(), Some(byte) => byte }) = at.unwrap_or(BitVec::ofNat(0)) {
            None => refl,
            Some(_) => refl,
        },
    }
}

theorem Tm::lower_byte_sound(w: World, g: List<Ty>, ports: List<Nat>, next, k, i, length: Nat):
    Tm::LowerHolds(Byte(k, i, length), w, g, ports, next, Tm::lower_byte(g, ports, next, k, i, length)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Byte(k, i, length), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, port_at(ports, i), λ pi => Tm::byte_port_l(g, ports, next, k, i, length, pi), λ pi at_i =>
    Option::and_then_elim(P, trivial, port_at(ports, length), λ pl => Tm::binary(g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next)), λ pl at_l =>
    Tm::binary_sound(P, trivial, g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next), λ ei el =>
        λ call agree values env held below => {
            let index = Ty::cast(w.tys, Ty::at(g, i), Word(64), Env::get(w.tys, g, env, i));
            let bound = Ty::cast(w.tys, Ty::at(g, length), Word(64), Env::get(w.tys, g, env, length));
            let load = next + 1;
            let out = next + 2;
            let at_index: (values(64, pi) = index) = Tm::operand(w, g, ports, values, env, held, i, pi, at_i, Word(64), ei);
            let at_bound: (values(64, pl) = bound) = Tm::operand(w, g, ports, values, env, held, length, pl, at_l, Word(64), el);
            let under: (pi < next) = Ty::below_cast(w.tys, Ty::at(g, i), Word(64), ei, pi, next, below_at(w.tys, g, ports, next, below, i, pi, at_i));
            // The comparison's bit.
            let tested = Valuation::set(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))));
            let bit = Tm::cmp_op_holds(values, next, pi, pl, 64, λ (x: BitVec(64)) (y: BitVec(64)) => x.unsigned_lt_bit(y), index, bound, at_index, at_bound);
            let chosen: (tested(1, next).head_bit() = index.unsigned_lt_bit(bound)) =
                trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(index.unsigned_lt_bit(bound)));
            let kept_test: Keeps(values, tested, next) = λ wd id lt =>
                Valuation::set_other(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))), wd, id, Nat::ne_of_lt(id, next, lt));
            // The arm that loads.
            let loaded = Valuation::set(tested, load, load_value(w.spans, k, pi, tested));
            let narrowed = Valuation::set(loaded, out, λ wd => BitVec::ofNat(loaded(64, load).toNat()));
            let index_kept: (tested(64, pi) = index) = trans(kept_test(64, pi, under), at_index);
            let word: (loaded(64, load) = byte_word(w.spans.span(k).byte_at(index))) =
                trans(Valuation::set_here(tested, load, load_value(w.spans, k, pi, tested), 64),
                    cong_fn(byte_word, trans(cong_fn(λ (x: BitVec(64)) => buffer_byte(w.spans, k, x.toNat()), index_kept), Tm::span_byte(w.spans, k, index))));
            let held_true: (narrowed(8, out) = w.spans.span(k).byte_at(index)) =
                trans(Valuation::set_here(loaded, out, λ wd => BitVec::ofNat(loaded(64, load).toNat()), 8),
                    trans(cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(x.toNat(), n := 8), word), Tm::byte_back(w.spans.span(k).byte_at(index))));
            let kept_true: Keeps(tested, narrowed, next) = λ wd id lt =>
                trans(Valuation::set_other(loaded, out, λ x => BitVec::ofNat(loaded(64, load).toNat()), wd, id,
                        Nat::ne_of_lt(id, out, Nat::lt_trans(id, load, out, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()), load.lt_succ_self()))),
                    Valuation::set_other(tested, load, load_value(w.spans, k, pi, tested), wd, id,
                        Nat::ne_of_lt(id, load, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()))));
            // The arm that does not.
            let zeroed = Valuation::set(tested, out, λ wd => BitVec::ofNat(0));
            let held_false: (zeroed(8, out) = BitVec::ofNat(0)) = Valuation::set_here(tested, out, λ wd => BitVec::ofNat(0), 8);
            let kept_false: Keeps(tested, zeroed, next) = λ wd id lt =>
                Valuation::set_other(tested, out, λ x => BitVec::ofNat(0), wd, id,
                    Nat::ne_of_lt(id, out, Nat::lt_trans(id, load, out, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()), load.lt_succ_self())));
            let outs = Ports([Port(out, 8)]);
            let when_true = Compose(nodes_region([BufferLoad(load, k, pi)]), nodes_region([Resize(64, 8, out, load)]));
            let when_false = nodes_region([Const(8, out, 0)]);
            let kept = branch_keeps(tested, next, outs, when_true, when_false, call, w.spans, next, kept_true, kept_false);
            ⟨Nat::le_succ_r(next, out, Nat::le_succ_r(next, load, Nat::le_succ_r(next, next, next.le_refl()))),
                ⟨out.lt_succ_self(),
                    ⟨λ wd id lt => trans(kept(wd, id, lt), kept_test(wd, id, lt)),
                        branch_holds(Word(8), w.tys, tested, next, outs, when_true, when_false, call, w.spans, out, index.unsigned_lt_bit(bound),
                            w.spans.span(k).byte_at(index), BitVec::ofNat(0), chosen, held_true, held_false)⟩⟩⟩
        })))
}

// A `match` on an enum: the arms run with the constructor `pick` chose
// bound at the enum's port, which holds it (`of_tag`), and `pick` is the
// arm at the tag (`picks`).
theorem Tm::pick_sound(i, c: Nat, arms: Tm, eq: Bool, w: World,
    ih: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(arms, w, g, ports, next, Tm::lower(arms, w, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::LowerHolds(Pick(i, c, arms, eq), w, g, ports, next, Tm::lower(Pick(i, c, arms, eq), w, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Pick(i, c, arms, eq), w, g, ports, next, r);
    let inner = Cons(Enum(i), g);
    Option::and_then_elim(P, trivial, port_at(ports, c),
        λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, inner, Cons(pc, ports), next)), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Enum(i)), λ _ => Tm::lower(arms, w, inner, Cons(pc, ports), next), λ ec _ =>
    (match Tm::lower(arms, w, inner, Cons(pc, ports), next) as λ r => Tm::lower(arms, w, inner, Cons(pc, ports), next) = r → P(r) {
      None => λ _ => trivial,
      Some(l) => λ lowered => λ call agree values env held below => {
            let e = w.tys(i).alts;
            let R = arms.ty(w, inner);
            let v = Ty::cast(w.tys, Ty::at(g, c), Enum(i), Env::get(w.tys, g, env, c));
            let held_v: e.Names(values(64, pc), v) = Tm::operand(w, g, ports, values, env, held, c, pc, at_c, Enum(i), ec);
            let held_of: e.Names(values(64, pc), e.of(e.tag(v))) =
                ⟨trans(held_v.left, sym(cong_fn(λ (u: e.E) => e.tag(u), e.of_tag(v)))), held_v.right⟩;
            let pc_lt: (pc < next) = Ty::below_cast(w.tys, Ty::at(g, c), Enum(i), ec, pc, next, below_at(w.tys, g, ports, next, below, c, pc, at_c));
            let ran = j(lowered, λ r _ => Tm::LowerHolds(arms, w, inner, Cons(pc, ports), next, r), ih(inner, Cons(pc, ports), next))(
                call, agree, values, Pair(e.of(e.tag(v)), env), ⟨held_of, held⟩, ⟨pc_lt, below⟩);
            let after = l.region.eval(call, values, buffers := w.spans);
            let arm = λ (n: Nat) => arms.sem(w, inner, Pair(e.of(n), env));
            ⟨ran.left, ⟨ran.right.left, ⟨ran.right.right.left,
                j(sym(e.chooses(eq, R.sem(w.tys), arm, v)), λ y _ => R.Holds(w.tys, after, l.result, y), ran.right.right.right)⟩⟩⟩
        },
    })(refl)))
}

theorem Tm::lower_sound(self t: Tm, w: World): (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
    Tm::LowerHolds(t, w, g, ports, next, Tm::lower(t, w, g, ports, next)) {
    match t {
        Var(i) => λ g ports next =>
            Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Var(i), w, g, ports, next, r), trivial,
                port_at(ports, i), λ p => Some(Lowered(nodes_region(Nil), p, next)), λ p at =>
                λ call agree values env held below =>
                    ⟨next.le_refl(), ⟨below_at(w.tys, g, ports, next, below, i, p, at),
                        ⟨λ wd id _ => refl, env_holds_at(w.tys, values, g, ports, env, held, i, p, at)⟩⟩⟩),
        Lit(c, n) => λ g ports next => Tm::lower_lit_sound(w, g, ports, next, c, n),
        Prim(op, args) => λ g ports next => Tm::lower_prim_sound(op, w, g, ports, next, args),
        Let(e, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Let(e, body), w, g, ports, next, r);
            let inner = Cons(Tm::ty(e, w, g), g);
            Option::and_then_elim(P, trivial, Tm::lower(e, w, g, ports, next),
                λ le => Tm::lower(body, w, inner, Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb)), λ le lowered_e =>
            Option::and_then_elim(P, trivial, Tm::lower(body, w, inner, Cons(le.result, ports), le.next), λ lb => Tm::compose(le, lb),
                λ lb lowered_body => λ call agree values env held below => {
                    let first = j(lowered_e, λ r _ => Tm::LowerHolds(e, w, g, ports, next, r),
                        Tm::lower_sound(e, w, g, ports, next))(call, agree, values, env, held, below);
                    let mid = le.region.eval(call, values, buffers := w.spans);
                    let then = j(lowered_body, λ r _ => Tm::LowerHolds(body, w, inner, Cons(le.result, ports), le.next, r),
                        Tm::lower_sound(body, w, inner, Cons(le.result, ports), le.next))(call, agree, mid, Pair(Tm::sem(e, w, g, env), env),
                        ⟨first.right.right.right, env_holds_keeps(w.tys, g, values, mid, next, first.right.right.left, ports, env, below, held)⟩,
                        ⟨first.right.left, below_mono(w.tys, g, next, le.next, first.left, ports, below)⟩);
                    ⟨Nat::le_trans(next, le.next, lb.next, first.left, then.left), ⟨then.right.left,
                        ⟨λ wd id lt => trans(then.right.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, le.next, lt, first.left)),
                            first.right.right.left(wd, id, lt)),
                            then.right.right.right⟩⟩⟩
                }))
        },
        If(c, yes, no) => λ g ports next => Tm::if_sound(c, yes, no, w,
            λ g2 ports2 next2 => Tm::lower_sound(yes, w, g2, ports2, next2), λ g2 ports2 next2 => Tm::lower_sound(no, w, g2, ports2, next2),
            g, ports, next),
        IfEq(c, yes, no) => λ g ports next => Tm::ifeq_of_if(c, yes, no, w, g, ports, next, Tm::lower(If(c, yes, no), w, g, ports, next),
            Tm::if_sound(c, yes, no, w,
                λ g2 ports2 next2 => Tm::lower_sound(yes, w, g2, ports2, next2), λ g2 ports2 next2 => Tm::lower_sound(no, w, g2, ports2, next2),
                g, ports, next)),
        Make(i, args) => λ g ports next => Tm::lower_make_sound(w, g, ports, next, i, args),
        Field(i, k, of) => λ g ports next => Tm::lower_field_sound(w, g, ports, next, i, k, of),
        Call(f, args) => λ g ports next => Tm::lower_call_sound(w, g, ports, next, f, args),
        Fold(_, _, _) => λ g ports next => trivial,
        Case(_, _, _) => λ g ports next => trivial,
        Byte(k, i, length) => λ g ports next => Tm::lower_byte_sound(w, g, ports, next, k, i, length),
        Pick(i, c, arms, eq) => λ g ports next => Tm::pick_sound(i, c, arms, eq, w, λ g2 ports2 next2 => Tm::lower_sound(arms, w, g2, ports2, next2), g, ports, next),
    }
}

// ---------------------------------------------------------------------------
// Narrow words at a function's boundary (issues/runtime-repr-narrow-words.md).
// A plain function's parameter or result may be a word narrower than 64
// bits. It still crosses the boundary in a 64-bit word: a parameter is the
// word's low bits, read into a fresh port by one `Resize` before the body
// (`Fun::entry`), so that the x86 lowering finds it zero-extended in its
// register; the result is zero-extended into a fresh port by one `Resize`
// after the body (`widen`).
// Calls and loops keep `Ty::OneWord`: a call of a function with a narrow
// word would widen its argument first, which the call's lowering does not
// do yet.

// A code a plain function's boundary passes in one 64-bit word: one held
// in a 64-bit word (`Ty::OneWord`), or a word narrower than one.
fn Ty::Edge(self t: Ty, tys: Nat → RecInfo) → Type {
    match t { Word(w) => (w = 64) ∨ (w < 64), Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys(i).fields = [Word(64)], Count => False, Enum(_) => False }
}

fn Ty::check_narrow(w: Nat) → Option<(w = 64) ∨ (w < 64)> {
    match w.equation(64) {
        Inl(e) => Some(Inl(e)),
        Inr(_) => Tm::check_true((w + 1).leb(64)).and_then(λ h => Some(Inr(Nat::leb_sound(w + 1, 64, h)))),
    }
}

fn Ty::check_edge(self t: Ty, tys: Nat → RecInfo) → Option<t.Edge(tys)> {
    match t as λ x => Option<x.Edge(tys)> {
        Word(w) => Ty::check_narrow(w),
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys(i).fields),
        Count => None,
        Enum(_) => None,
    }
}

// A code a plain function takes at its boundary: one it passes in a word
// (`Ty::Edge`), or an enum, passed as its tag word (design §16.16).
fn Ty::Param(self t: Ty, tys: Nat → RecInfo) → Type {
    match t { Word(_) => t.Edge(tys), Bit => False, ByteList(_) => False, Lines => False, Named(_) => t.Edge(tys), Count => False, Enum(_) => True }
}

fn Ty::check_param(self t: Ty, tys: Nat → RecInfo) → Option<t.Param(tys)> {
    match t as λ x => Option<x.Param(tys)> {
        Word(w) => Word(w).check_edge(tys), Bit => None, ByteList(_) => None, Lines => None, Named(i) => Named(i).check_edge(tys), Count => None,
        Enum(_) => Some(trivial),
    }
}

// Every parameter passes the boundary (`Ty::Param`).
fn Ty::Edges(tys: Nat → RecInfo, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Param(tys) ∧ Ty::Edges(tys, rest) }
}

fn Ty::check_edges(tys: Nat → RecInfo, ps: List<Ty>) → Option<Ty::Edges(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_param(tys).and_then(λ e => Ty::check_edges(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A 64-bit word read at a narrower word is its low bits.
theorem Ty::cast_narrow_in(tys: Nat → RecInfo, w: Nat, ne: w ≠ 64, x: BitVec(64)): Ty::cast(tys, Word(64), Word(w), x) = BitVec::ofNat(x.toNat()) {
    let converted: (Ty::cast(tys, Word(64), Word(w), x) = Ty::convert(tys, Word(64), Word(w), x)) =
        j(sym(Or::inr_apart(Word(64).equation(Word(w)), λ e => ne(sym(cong_fn(Ty::width, e))))), λ d _ =>
            (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => y.sem(tys), x), Inr(_) => Ty::convert(tys, Word(64), Word(w), x) }) =
                Ty::convert(tys, Word(64), Word(w), x),
            refl);
    let truncated: (Ty::convert(tys, Word(64), Word(w), x) = BitVec::ofNat(x.toNat())) =
        j(sym(Or::inr_apart(Nat::equation(64, w), λ e => ne(sym(e)))), λ d _ =>
            (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => BitVec(y), x), Inr(_) => BitVec::ofNat(x.toNat()) }) = BitVec::ofNat(x.toNat()),
            refl);
    trans(converted, truncated)
}

// A narrow word read as a 64-bit word is its zero extension.
theorem Ty::cast_narrow_out(tys: Nat → RecInfo, w: Nat, ne: w ≠ 64, v: BitVec(w)): Ty::cast(tys, Word(w), Word(64), v) = BitVec::ofNat(v.toNat()) {
    let converted: (Ty::cast(tys, Word(w), Word(64), v) = Ty::convert(tys, Word(w), Word(64), v)) =
        j(sym(Or::inr_apart(Word(w).equation(Word(64)), λ e => ne(cong_fn(Ty::width, e)))), λ d _ =>
            (match d as λ _ => BitVec(64) { Inl(e) => j(e, λ y _ => y.sem(tys), v), Inr(_) => Ty::convert(tys, Word(w), Word(64), v) }) =
                Ty::convert(tys, Word(w), Word(64), v),
            refl);
    let extended: (Ty::convert(tys, Word(w), Word(64), v) = BitVec::ofNat(v.toNat())) =
        j(sym(Or::inr_apart(w.equation(64), ne)), λ d _ =>
            (match d as λ _ => BitVec(64) { Inl(e) => j(e, λ y _ => BitVec(y), v), Inr(_) => BitVec::ofNat(v.toNat()) }) = BitVec::ofNat(v.toNat()),
            refl);
    trans(converted, extended)
}

// A code the boundary passes spans one port.
theorem Ty::edge_below(tys: Nat → RecInfo, t: Ty): t.Edge(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(_) => λ _ m => m.lt_succ_self(),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => Ty::one_word_below(tys, Named(i), e, m),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A function's result at the boundary: a narrow word zero-extended into a
// fresh port by one `Resize`; any other code where the body left it.
fn Ty::widen_by(w: Nat, o: (w = 64) ∨ True, c: Lowered) → Lowered {
    match o { Inl(_) => c, Inr(_) => Lowered(Compose(c.region, nodes_region([Resize(w, 64, c.next, c.result)])), c.next, c.next + 1) }
}

fn Ty::widen(self t: Ty, tys: Nat → RecInfo, c: Lowered) → Lowered {
    match t { Word(w) => Ty::widen_by(w, w.equation(64), c), Bit => c, ByteList(_) => c, Lines => c, Named(_) => c, Count => c, Enum(_) => c }
}

// The result's 64-bit word, after the widening, is the value read as one.
theorem Ty::edge_reads(tys: Nat → RecInfo, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered): t.Edge(tys) →
    (v: t.sem(tys)) → t.Holds(tys, c.region.eval(call, values, buffers := buffers), c.result, v) →
    t.widen(tys, c).region.eval(call, values, buffers := buffers)(64, t.widen(tys, c).result) = Ty::cast(tys, t, Word(64), v) {
    match t {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (v: BitVec(y)) → c.region.eval(call, values, buffers := buffers)(y, c.result) = v →
                    Word(y).widen(tys, c).region.eval(call, values, buffers := buffers)(64, Word(y).widen(tys, c).result) = Ty::cast(tys, Word(y), Word(64), v),
                λ v h => trans(h, sym(Ty::cast_self(tys, Word(64), v)))),
            Inr(lt) => λ v h => {
                let ne = Nat::ne_of_lt(w, 64, lt);
                let after = c.region.eval(call, values, buffers := buffers);
                let read: (Valuation::set(after, c.next, λ wd => BitVec::ofNat(after(w, c.result).toNat()), 64, c.next) = Ty::cast(tys, Word(w), Word(64), v)) =
                    trans(Valuation::set_here(after, c.next, λ wd => BitVec::ofNat(after(w, c.result).toNat()), 64),
                        trans(cong_fn(λ (y: BitVec(w)) => BitVec::ofNat(y.toNat(), n := 64), h), sym(Ty::cast_narrow_out(tys, w, ne, v))));
                j(sym(Or::inr_apart(w.equation(64), ne)), λ o _ =>
                    Ty::widen_by(w, o, c).region.eval(call, values, buffers := buffers)(64, Ty::widen_by(w, o, c).result) = Ty::cast(tys, Word(w), Word(64), v),
                    read)
            },
        },
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => Ty::one_word_reads(tys, c.region.eval(call, values, buffers := buffers), c.result, Named(i), e, v, h),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A code a function returns at its boundary: one it passes in a word
// (`Ty::Edge`), a record of two 64-bit words, the second returned beside
// the first (`Function.also`, RDX; docs/native/runtime-fn-setups-design.md
// §16.16), or an enum, as its tag word. Only the program's entry returns two words: a call reads RAX alone, so a callee's
// signature still asks for one (`Sig::Words`).
fn Ty::Out(self t: Ty, tys: Nat → RecInfo) → Type {
    match t {
        Word(w) => (w = 64) ∨ (w < 64),
        Bit => False, ByteList(_) => False, Lines => False,
        Named(i) => (tys(i).fields = [Word(64)]) ∨ (tys(i).fields = [Word(64), Word(64)]),
        Count => False,
        Enum(_) => True,
    }
}

fn Ty::check_fields_two(fs: List<Ty>) → Option<fs = [Word(64), Word(64)]> {
    match fs as λ g => Option<g = [Word(64), Word(64)]> {
        Nil => None,
        Cons(f, rest) => f.check(Word(64)).and_then(λ e1 => Ty::check_fields_word(rest).and_then(λ e2 =>
            Some(trans(j(e1, λ x _ => Cons(f, rest) = Cons(x, rest), refl), cong_fn(λ (r: List<Ty>) => Cons(Word(64), r), e2))))),
    }
}

fn Ty::check_out(self t: Ty, tys: Nat → RecInfo) → Option<t.Out(tys)> {
    match t as λ x => Option<x.Out(tys)> {
        Word(w) => Ty::check_narrow(w),
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => match Ty::check_fields_word(tys(i).fields) {
            Some(e) => Some(Inl(e)),
            None => Ty::check_fields_two(tys(i).fields).and_then(λ e => Some(Inr(e))),
        },
        Count => None,
        Enum(_) => Some(trivial),
    }
}

// The result's first word, after the widening, is the value read as one:
// a record's of two words is its head field (`Ty::convert`), an enum's
// its tag word.
theorem Ty::out_reads(tys: Nat → RecInfo, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered): t.Out(tys) →
    (v: t.sem(tys)) → t.Holds(tys, c.region.eval(call, values, buffers := buffers), c.result, v) →
    t.widen(tys, c).region.eval(call, values, buffers := buffers)(64, t.widen(tys, c).result) = Ty::cast(tys, t, Word(64), v) {
    match t {
        Word(w) => λ ok => Ty::edge_reads(tys, call, buffers, values, Word(w), c, ok),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok => match ok {
            Inl(e) => Ty::edge_reads(tys, call, buffers, values, Named(i), c, e),
            Inr(e) => λ v h => {
                let after = c.region.eval(call, values, buffers := buffers);
                let general = j(sym(e), λ g _ => (t2: Ty::Flats(g)) → Ty::FieldsHold(g, after, c.result, t2) → after(64, c.result) = Ty::flats_head_word(g, t2),
                    λ t2 held => held.left);
                general(tys(i).get(v), h)
            },
        },
        Count => λ never => false_elim(never),
        Enum(i) => λ _ v h => {
            let x = c.region.eval(call, values, buffers := buffers)(64, c.result);
            trans(sym(BitVec::ofNat_toNat(64, x)), cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := 64), h.left))
        },
    }
}

// The ports of a record's fields from `port` on, and the words a field
// tuple's fields are.
fn Ty::ports_from(fs: List<Ty>, port: Nat) → List<Nat> {
    match fs { Nil => Nil, Cons(_, rest) => Cons(port, Ty::ports_from(rest, port + 1)) }
}

fn Ty::flats_words(fs: List<Ty>) → Ty::Flats(fs) → List<BitVec(64)> {
    match fs as λ g => Ty::Flats(g) → List<BitVec(64)> {
        Nil => λ _ => Nil,
        Cons(f, rest) => λ t => Cons(f.flat_word(t.fst), Ty::flats_words(rest, t.snd)),
    }
}

// A record result's words past the first: the ports of its fields after the
// head, and the words of those fields. Every other code returns one word.
fn Ty::fields_also_ports(fs: List<Ty>, port: Nat) → List<Nat> {
    match fs { Nil => Nil, Cons(_, rest) => Ty::ports_from(rest, port + 1) }
}

fn Ty::flats_tail_words(fs: List<Ty>) → Ty::Flats(fs) → List<BitVec(64)> {
    match fs as λ g => Ty::Flats(g) → List<BitVec(64)> { Nil => λ _ => Nil, Cons(f, rest) => λ t => Ty::flats_words(rest, t.snd) }
}

fn Ty::also_ports(self t: Ty, tys: Nat → RecInfo, port: Nat) → List<Nat> {
    match t { Word(_) => Nil, Bit => Nil, ByteList(_) => Nil, Lines => Nil, Named(i) => Ty::fields_also_ports(tys(i).fields, port), Count => Nil, Enum(_) => Nil }
}

fn Ty::rest_words(tys: Nat → RecInfo, t: Ty) → t.sem(tys) → List<BitVec(64)> {
    match t as λ x => x.sem(tys) → List<BitVec(64)> {
        Word(_) => λ _ => Nil, Bit => λ _ => Nil, ByteList(_) => λ _ => Nil, Lines => λ _ => Nil,
        Named(i) => λ v => Ty::flats_tail_words(tys(i).fields, tys(i).get(v)),
        Count => λ _ => Nil,
        Enum(_) => λ _ => Nil,
    }
}

// Fields that are all 64-bit words, held from `port`: their ports' words
// are the fields.
theorem Ty::ports_reads(values: Valuation(), fs: List<Ty>): (port: Nat) → Ty::Words(fs) → (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → words_of(values, Ty::ports_from(fs, port)) = Ty::flats_words(fs, t) {
    match fs {
        Nil => λ port _ t _ => refl,
        Cons(f, rest) => λ port ok t held => {
            let head = j(sym(ok.left), λ g _ => (x: g.Flat()) → g.FlatHolds(values, port, x) → values(64, port) = g.flat_word(x),
                λ x h => h)(t.fst, held.left);
            trans(cong_fn(λ (a: BitVec(64)) => Cons(a, words_of(values, Ty::ports_from(rest, port + 1))), head),
                cong_fn(λ (r: List<BitVec(64)>) => Cons(f.flat_word(t.fst), r), Ty::ports_reads(values, rest, port + 1, ok.right, t.snd, held.right)))
        },
    }
}

theorem Ty::fields_rest_reads(values: Valuation(), port: Nat, fs: List<Ty>): Ty::Words(fs) → (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → words_of(values, Ty::fields_also_ports(fs, port)) = Ty::flats_tail_words(fs, t) {
    match fs {
        Nil => λ _ t _ => refl,
        Cons(f, rest) => λ ok t held => Ty::ports_reads(values, rest, port + 1, ok.right, t.snd, held.right),
    }
}

// The result's words past the first, at the ports `Ty::also_ports` names,
// are the value's (none but for a record of two words).
theorem Ty::also_reads(tys: Nat → RecInfo, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered): t.Out(tys) →
    (v: t.sem(tys)) → t.Holds(tys, c.region.eval(call, values, buffers := buffers), c.result, v) →
    words_of(t.widen(tys, c).region.eval(call, values, buffers := buffers), t.also_ports(tys, t.widen(tys, c).result)) = Ty::rest_words(tys, t, v) {
    match t {
        Word(w) => λ _ _ _ => refl,
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok v h => {
            let words: Ty::Words(tys(i).fields) = match ok {
                Inl(e) => j(sym(e), λ g _ => Ty::Words(g), ⟨refl, trivial⟩),
                Inr(e) => j(sym(e), λ g _ => Ty::Words(g), ⟨refl, ⟨refl, trivial⟩⟩),
            };
            Ty::fields_rest_reads(c.region.eval(call, values, buffers := buffers), c.result, tys(i).fields, words, tys(i).get(v), h)
        },
        Count => λ never => false_elim(never),
        Enum(_) => λ _ _ _ => refl,
    }
}

// ---------------------------------------------------------------------------
// Functions: the wrapper from FunctionIR's `Function::eval`, which binds its
// parameters by `Valuation::bind`, to the reflected function's curried
// meaning (`Fun::meaning`). Parameters are 64-bit words, the ids 0, 1, …
// in order; the last is variable 0, so the context's ports are the ids
// reversed, and the body takes fresh ids above them.

fn Fun::param_ids(ps: List<Ty>, m: Nat) → List<Nat> {
    match ps { Nil => Nil, Cons(_, rest) => Cons(m, Fun::param_ids(rest, m + 1)) }
}

fn Fun::ports_onto(ps: List<Ty>, m: Nat, ports: List<Nat>) → List<Nat> {
    match ps { Nil => ports, Cons(_, rest) => Fun::ports_onto(rest, m + 1, Cons(m, ports)) }
}

fn Fun::past(ps: List<Ty>, m: Nat) → Nat {
    match ps { Nil => m, Cons(_, rest) => Fun::past(rest, m + 1) }
}

fn Fun::context(self f: Fun) → List<Ty> { Ty::bind_onto(f.params, Nil) }

// The parameters' entry: a narrow word's low bits read into a fresh port
// by one `Resize` (the x86 lowering holds a narrow value zero-extended in
// its register, and a parameter's register holds the whole word passed);
// any other parameter at its own id. `ports` are the context's, the last
// parameter's first; with no narrow word they are `Fun::ports_onto`'s.
record Entry { nodes: List<Node>, ports: List<Nat>, next: Nat }

fn Ty::narrow_by(w: Nat, o: (w = 64) ∨ True) → Bool { match o { Inl(_) => False, Inr(_) => True } }

fn Ty::narrow(self t: Ty) → Bool {
    match t { Word(w) => Ty::narrow_by(w, w.equation(64)), Bit => False, ByteList(_) => False, Lines => False, Named(_) => False, Count => False, Enum(_) => False }
}

fn Fun::entry_step(b: Bool, p: Ty, m, next: Nat, ports: List<Nat>, again: Nat → List<Nat> → Entry) → Entry {
    match b {
        True => Entry(Cons(Resize(64, p.width(), next, m), again(next + 1, Cons(next, ports)).nodes), again(next + 1, Cons(next, ports)).ports,
            again(next + 1, Cons(next, ports)).next),
        False => again(next, Cons(m, ports)),
    }
}

fn Fun::entry(ps: List<Ty>, m, next: Nat, ports: List<Nat>) → Entry {
    match ps {
        Nil => Entry(Nil, ports, next),
        Cons(p, rest) => Fun::entry_step(p.narrow(), p, m, next, ports, λ n2 ps2 => Fun::entry(rest, m + 1, n2, ps2)),
    }
}

fn Fun::entry_of(self f: Fun) → Entry { Fun::entry(f.params, 0, Fun::past(f.params, 0), Nil) }

// The body's code after the entry's nodes (with none, the body's alone).
fn Fun::entered(nodes: List<Node>, c: Lowered) → Lowered {
    match nodes { Nil => c, Cons(_, _) => Lowered(Compose(nodes_region(nodes), c.region), c.result, c.next) }
}

fn Fun::code_of(self f: Fun, tys: Nat → RecInfo, e: Entry, c: Lowered) → Function {
    Function(Fun::param_ids(f.params, 0), f.result.widen(tys, Fun::entered(e.nodes, c)).region, f.result.widen(tys, Fun::entered(e.nodes, c)).result,
        lent := f.lent, also := f.result.also_ports(tys, f.result.widen(tys, Fun::entered(e.nodes, c)).result))
}

fn Fun::lower_typed(self f: Fun, w: World, c: Lowered) → Option<Function> {
    Tm::ty(f.body, w, f.context()).check(f.result).and_then(λ _ => Some(f.code_of(w.tys, f.entry_of(), c)))
}

fn Fun::lower_body(self f: Fun, w: World) → Option<Function> {
    f.body.lower(w, f.context(), f.entry_of().ports, f.entry_of().next).and_then(λ c => f.lower_typed(w, c))
}

fn Fun::lower_distinct(self f: Fun, w: World) → Option<Function> {
    Tm::check_true(distinct(Fun::param_ids(f.params, 0))).and_then(λ _ => f.lower_body(w))
}

fn Fun::lower_result(self f: Fun, w: World) → Option<Function> {
    f.result.check_out(w.tys).and_then(λ _ => f.lower_distinct(w))
}

// A function of words to a word, lowered to a FunctionIR function: each
// parameter and the result a 64-bit word, a record held in one
// (`Ty::OneWord`), or a narrower word (`Ty::Edge`).
fn Fun::lower(self f: Fun, w: World) → Option<Function> {
    Ty::check_edges(w.tys, f.params).and_then(λ _ => f.lower_result(w))
}

// Words as an environment: the parameters bound onto `g` in order, each
// word cast to its parameter's code (zero past the words' end).
fn Ty::extend(tys: Nat → RecInfo, ps: List<Ty>) → (g: List<Ty>) → Env(tys, g) → List<BitVec(64)> → Env(tys, Ty::bind_onto(ps, g)) {
    match ps {
        Nil => λ g env xs => env,
        Cons(p, rest) => λ g env xs => match xs {
            Nil => Ty::extend(tys, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, BitVec::zero()), env), Nil),
            Cons(x, more) => Ty::extend(tys, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), more),
        },
    }
}

// A curried meaning answers like a word function that agrees with its
// uncurried form on every word list.
theorem Ty::curry_answers(tys: Nat → RecInfo, r: Ty, ps: List<Ty>): (g: List<Ty>) → (env: Env(tys, g)) →
    (k: Env(tys, Ty::bind_onto(ps, g)) → r.sem(tys)) → (ans: List<BitVec(64)> → BitVec(64)) →
    ((xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → ans(xs) = Ty::cast(tys, r, Word(64), k(Ty::extend(tys, ps, g, env, xs)))) →
    Ty::Answers(tys, ps, r, Ty::curry(tys, r, ps, g, env, k), ans) {
    match ps {
        Nil => λ g env k ans h => h(Nil, trivial),
        Cons(p, rest) => λ g env k ans h => λ x => Ty::given<Ty::Answers(tys, rest, r, Ty::curry(tys, r, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), k), λ ws => ans(Cons(x, ws)))>(p, tys, x, λ admitted =>
            Ty::curry_answers(tys, r, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), k, λ ws => ans(Cons(x, ws)),
                λ ws more => h(Cons(x, ws), ⟨admitted, more⟩))),
    }
}

// The words at `ids`, zero past the words' end.
fn Fun::BoundWords(values: Valuation(), ids: List<Nat>) → List<BitVec(64)> → Type {
    match ids {
        Nil => λ _ => True,
        Cons(id, rest) => λ xs => match xs {
            Nil => (values(64, id) = BitVec::zero()) ∧ Fun::BoundWords(values, rest, Nil),
            Cons(x, more) => (values(64, id) = x) ∧ Fun::BoundWords(values, rest, more),
        },
    }
}

theorem Fun::bound_frame(values, after: Valuation(), ids: List<Nat>): (xs: List<BitVec(64)>) →
    ((id: Nat) → Mem(id, ids) → after(64, id) = values(64, id)) → Fun::BoundWords(values, ids, xs) → Fun::BoundWords(after, ids, xs) {
    match ids {
        Nil => λ xs same bound => bound,
        Cons(id, rest) => λ xs same => match xs as λ ys => Fun::BoundWords(values, Cons(id, rest), ys) → Fun::BoundWords(after, Cons(id, rest), ys) {
            Nil => λ bound => ⟨trans(same(id, Inl(refl)), bound.left), Fun::bound_frame(values, after, rest, Nil, λ y m => same(y, Inr(m)), bound.right)⟩,
            Cons(_, more) => λ bound => ⟨trans(same(id, Inl(refl)), bound.left), Fun::bound_frame(values, after, rest, more, λ y m => same(y, Inr(m)), bound.right)⟩,
        },
    }
}

theorem Fun::bound_zero(ids: List<Nat>): Fun::BoundWords(Valuation::zero(), ids, Nil) {
    match ids { Nil => trivial, Cons(_, rest) => ⟨refl, Fun::bound_zero(rest)⟩ }
}

// Distinct ids bound to words hold them.
theorem Fun::bind_bound(ids: List<Nat>): (xs: List<BitVec(64)>) → distinct(ids).IsTrue() →
    Fun::BoundWords(Valuation::bind(Valuation::zero(), ids, xs), ids, xs) {
    match ids {
        Nil => λ xs _ => trivial,
        Cons(id, rest) => λ xs apart => match xs as λ ys => Fun::BoundWords(Valuation::bind(Valuation::zero(), Cons(id, rest), ys), Cons(id, rest), ys) {
            Nil => Fun::bound_zero(Cons(id, rest)),
            Cons(x, more) => {
                let parts = Bool::is_true_and(absent(id, rest), distinct(rest), apart);
                let inner = Valuation::bind(Valuation::zero(), rest, more);
                ⟨Valuation::set_here(inner, id, word_value(x), 64),
                    Fun::bound_frame(inner, Valuation::set(inner, id, word_value(x)), rest, more,
                        λ y m => Valuation::set_other(inner, id, word_value(x), 64, y, λ e => absent_mem(id, rest, parts.left, y, m, sym(e))),
                        Fun::bind_bound(rest, more, parts.right))⟩
            },
        },
    }
}

// The parameters' ports hold the environment the words make.
theorem Fun::env_extend_holds(tys: Nat → RecInfo, values: Valuation(), ps: List<Ty>): (g: List<Ty>) → (ports: List<Nat>) →
    (env: Env(tys, g)) → (m: Nat) → (xs: List<BitVec(64)>) → Ty::OneWords(tys, ps) → EnvHolds(tys, values, g, ports, env) →
    Fun::BoundWords(values, Fun::param_ids(ps, m), xs) →
    EnvHolds(tys, values, Ty::bind_onto(ps, g), Fun::ports_onto(ps, m, ports), Ty::extend(tys, ps, g, env, xs)) {
    match ps {
        Nil => λ g ports env m xs ok held bound => held,
        Cons(p, rest) => λ g ports env m xs ok held => match xs as λ ys =>
            Fun::BoundWords(values, Fun::param_ids(Cons(p, rest), m), ys) →
            EnvHolds(tys, values, Ty::bind_onto(Cons(p, rest), g), Fun::ports_onto(Cons(p, rest), m, ports), Ty::extend(tys, Cons(p, rest), g, env, ys)) {
            Nil => λ bound => Fun::env_extend_holds(tys, values, rest, Cons(p, g), Cons(m, ports),
                Pair(Ty::cast(tys, Word(64), p, BitVec::zero()), env), m + 1, Nil, ok.right,
                ⟨Ty::one_word_holds(tys, values, m, p, ok.left, BitVec::zero(), bound.left), held⟩, bound.right),
            Cons(x, more) => λ bound => Fun::env_extend_holds(tys, values, rest, Cons(p, g), Cons(m, ports),
                Pair(Ty::cast(tys, Word(64), p, x), env), m + 1, more, ok.right,
                ⟨Ty::one_word_holds(tys, values, m, p, ok.left, x, bound.left), held⟩, bound.right),
        },
    }
}

theorem Fun::below_onto(tys: Nat → RecInfo, ps: List<Ty>): (g: List<Ty>) → (m: Nat) → (ports: List<Nat>) → Ty::OneWords(tys, ps) →
    Below(tys, g, ports, m) → Below(tys, Ty::bind_onto(ps, g), Fun::ports_onto(ps, m, ports), Fun::past(ps, m)) {
    match ps {
        Nil => λ g m ports _ below => below,
        Cons(p, rest) => λ g m ports ok below => Fun::below_onto(tys, rest, Cons(p, g), m + 1, Cons(m, ports), ok.right,
            ⟨Ty::one_word_below(tys, p, ok.left, m),
                below_mono(tys, g, m, m + 1, Nat::le_succ_r(m, m, m.le_refl()), ports, below)⟩),
    }
}

theorem Fun::past_ge(ps: List<Ty>): (m: Nat) → m <= Fun::past(ps, m) {
    match ps {
        Nil => λ m => m.le_refl(),
        Cons(_, rest) => λ m => Nat::le_of_lt(m, Fun::past(rest, m + 1), Fun::past_ge(rest, m + 1)),
    }
}

// A parameter's id is below the ids' end.
theorem Fun::param_ids_below(ps: List<Ty>): (m, id: Nat) → Mem(id, Fun::param_ids(ps, m)) → id < Fun::past(ps, m) {
    match ps {
        Nil => λ m id never => false_elim(never),
        Cons(_, rest) => λ m id mem => match mem {
            Inl(e) => j(sym(e), λ y _ => y < Fun::past(rest, m + 1), Fun::past_ge(rest, m + 1)),
            Inr(later) => Fun::param_ids_below(rest, m + 1, id, later),
        },
    }
}

// What `narrow` decides at a code the boundary passes: a code held in a
// 64-bit word, or a narrow word.
// A code whose value the port a word is bound at holds, read at the code:
// what binding a parameter at its own id leaves.
fn Ty::FromWord(self p: Ty, tys: Nat → RecInfo) → Type {
    ((values: Valuation()) → (m: Nat) → (x: BitVec(64)) → p.Admits(tys, x) → values(64, m) = x → p.Holds(tys, values, m, Ty::cast(tys, Word(64), p, x))) ∧
        ((m: Nat) → p.Below(tys, m, m + 1))
}

theorem Ty::one_word_from(tys: Nat → RecInfo, p: Ty, one: p.OneWord(tys)): p.FromWord(tys) {
    ⟨λ values m x _ h => Ty::one_word_holds(tys, values, m, p, one, x, h), λ m => Ty::one_word_below(tys, p, one, m)⟩
}

// A tag read at an enum names the constructor of its index.
theorem Ty::enum_from_word(tys: Nat → RecInfo, i: Nat): Enum(i).FromWord(tys) {
    let e = tys(i).alts;
    ⟨λ values m x admitted h => ⟨trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), h),
                trans(sym(Nat::min_eq_l(x.toNat(), e.last, admitted)), sym(e.tag_of(x.toNat().min(e.last), Nat::min_le_r(x.toNat(), e.last))))),
            j(sym(h), λ y _ => y.toNat() <= e.last, admitted)⟩,
        λ m => m.lt_succ_self()⟩
}

theorem Ty::narrow_cases(tys: Nat → RecInfo, P: Bool → Type, p: Ty): p.Param(tys) → (p.FromWord(tys) → P(False)) →
    ((w: Nat) → p = Word(w) → w ≠ 64 → P(True)) → P(p.narrow()) {
    match p {
        Word(w) => λ ok own narrow => match ok {
            Inl(e) => j(sym(e), λ y _ => P(Ty::narrow_by(y, y.equation(64))), own(Ty::one_word_from(tys, Word(w), e))),
            Inr(lt) => j(sym(Or::inr_apart(w.equation(64), Nat::ne_of_lt(w, 64, lt))), λ o _ => P(Ty::narrow_by(w, o)),
                narrow(w, refl, Nat::ne_of_lt(w, 64, lt))),
        },
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok own _ => own(Ty::one_word_from(tys, Named(i), ok)),
        Count => λ never => false_elim(never),
        Enum(i) => λ _ own _ => own(Ty::enum_from_word(tys, i)),
    }
}

// A narrow word's port after its `Resize` holds the low bits of the word
// passed, which is that word read at the narrow code.
theorem Fun::narrow_holds(tys: Nat → RecInfo, values: Valuation(), p: Ty, w: Nat, hp: p = Word(w), ne: w ≠ 64, m, next: Nat, x: BitVec(64),
    bound: values(64, m) = x): p.Holds(tys, Valuation::set(values, next, λ wd => BitVec::ofNat(values(64, m).toNat())), next, Ty::cast(tys, Word(64), p, x)) {
    let after = Valuation::set(values, next, λ wd => BitVec::ofNat(values(64, m).toNat()));
    let at_word: (after(w, next) = Ty::cast(tys, Word(64), Word(w), x)) =
        trans(Valuation::set_here(values, next, λ wd => BitVec::ofNat(values(64, m).toNat()), w),
            trans(cong_fn(λ (y: BitVec(64)) => BitVec::ofNat(y.toNat(), n := w), bound), sym(Ty::cast_narrow_in(tys, w, ne, x))));
    j(sym(hp), λ q _ => q.Holds(tys, after, next, Ty::cast(tys, Word(64), q, x)), at_word)
}

// What the entry leaves: the parameters' ports hold the environment the
// words make, each below the entry's `next`.
fn Fun::EntryHolds(tys: Nat → RecInfo, buffers: Buffers(), ps: List<Ty>, g: List<Ty>, env: Env(tys, g), e: Entry, xs: List<BitVec(64)>,
    values: Valuation()) → Type {
    EnvHolds(tys, eval_nodes_over(buffers, e.nodes, values), Ty::bind_onto(ps, g), e.ports, Ty::extend(tys, ps, g, env, xs)) ∧
        Below(tys, Ty::bind_onto(ps, g), e.ports, e.next)
}

// One parameter's step of the entry, from the rest's (`ih`).
theorem Fun::entry_step_holds(tys: Nat → RecInfo, buffers: Buffers(), p: Ty, rest: List<Ty>, g: List<Ty>, ports: List<Nat>, env: Env(tys, g),
    m, next: Nat, x: BitVec(64), more: List<BitVec(64)>, values: Valuation(), ok: p.Param(tys), admitted: p.Admits(tys, x), held: EnvHolds(tys, values, g, ports, env),
    below: Below(tys, g, ports, next), bound: values(64, m) = x, bound_rest: Fun::BoundWords(values, Fun::param_ids(rest, m + 1), more),
    past: Fun::past(rest, m + 1) <= next,
    ih: (g2: List<Ty>) → (ports2: List<Nat>) → (env2: Env(tys, g2)) → (next2: Nat) → (values2: Valuation()) → EnvHolds(tys, values2, g2, ports2, env2) →
        Below(tys, g2, ports2, next2) → Fun::BoundWords(values2, Fun::param_ids(rest, m + 1), more) → Fun::past(rest, m + 1) <= next2 →
        Fun::EntryHolds(tys, buffers, rest, g2, env2, Fun::entry(rest, m + 1, next2, ports2), more, values2)):
    Fun::EntryHolds(tys, buffers, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env),
        Fun::entry_step(p.narrow(), p, m, next, ports, λ n2 ps2 => Fun::entry(rest, m + 1, n2, ps2)), more, values) {
    let again = λ (n2: Nat) (ps2: List<Nat>) => Fun::entry(rest, m + 1, n2, ps2);
    let env2 = Pair(Ty::cast(tys, Word(64), p, x), env);
    Ty::narrow_cases(tys, λ b => Fun::EntryHolds(tys, buffers, rest, Cons(p, g), env2, Fun::entry_step(b, p, m, next, ports, again), more, values), p, ok,
        λ one => ih(Cons(p, g), Cons(m, ports), env2, next, values,
            ⟨one.left(values, m, x, admitted, bound), held⟩,
            ⟨p.below_mono(tys, m, m + 1, next, Nat::le_trans(m + 1, Fun::past(rest, m + 1), next, Fun::past_ge(rest, m + 1), past),
                one.right(m)), below⟩,
            bound_rest, past),
        λ w hp ne => {
            let after = Valuation::set(values, next, λ wd => BitVec::ofNat(values(64, m).toNat()));
            let keeps: Keeps(values, after, next) = λ wd id lt =>
                Valuation::set_other(values, next, λ v => BitVec::ofNat(values(64, m).toNat()), wd, id, Nat::ne_of_lt(id, next, lt));
            ih(Cons(p, g), Cons(next, ports), env2, next + 1, after,
                ⟨Fun::narrow_holds(tys, values, p, w, hp, ne, m, next, x, bound), env_holds_keeps(tys, g, values, after, next, keeps, ports, env, below, held)⟩,
                ⟨j(sym(hp), λ q _ => q.Below(tys, next, next + 1), next.lt_succ_self()),
                    below_mono(tys, g, next, next + 1, Nat::le_succ_r(next, next, next.le_refl()), ports, below)⟩,
                Fun::bound_frame(values, after, Fun::param_ids(rest, m + 1), more, λ id mem =>
                    Valuation::set_other(values, next, λ v => BitVec::ofNat(values(64, m).toNat()), 64, id,
                        Nat::ne_of_lt(id, next, Nat::lt_of_lt_of_le(id, Fun::past(rest, m + 1), next, Fun::param_ids_below(rest, m + 1, id, mem), past))),
                    bound_rest),
                Nat::le_succ_r(Fun::past(rest, m + 1), next, past))
        })
}

theorem Fun::entry_holds(tys: Nat → RecInfo, buffers: Buffers(), ps: List<Ty>): (g: List<Ty>) → (ports: List<Nat>) → (env: Env(tys, g)) →
    (m, next: Nat) → (xs: List<BitVec(64)>) → (values: Valuation()) → Ty::Edges(tys, ps) → Ty::AdmitsAll(tys, ps, xs) → EnvHolds(tys, values, g, ports, env) →
    Below(tys, g, ports, next) → Fun::BoundWords(values, Fun::param_ids(ps, m), xs) → Fun::past(ps, m) <= next →
    Fun::EntryHolds(tys, buffers, ps, g, env, Fun::entry(ps, m, next, ports), xs, values) {
    match ps {
        Nil => λ g ports env m next xs values ok admitted held below bound past => ⟨held, below⟩,
        Cons(p, rest) => λ g ports env m next xs values ok => match xs as λ ys => Ty::AdmitsAll(tys, Cons(p, rest), ys) → EnvHolds(tys, values, g, ports, env) →
            Below(tys, g, ports, next) → Fun::BoundWords(values, Fun::param_ids(Cons(p, rest), m), ys) → Fun::past(Cons(p, rest), m) <= next →
            Fun::EntryHolds(tys, buffers, Cons(p, rest), g, env, Fun::entry(Cons(p, rest), m, next, ports), ys, values) {
            Nil => λ admitted held below bound past => Fun::entry_step_holds(tys, buffers, p, rest, g, ports, env, m, next, BitVec::zero(), Nil, values, ok.left,
                admitted.left, held, below, bound.left, bound.right, past,
                λ g2 ports2 env2 next2 values2 => Fun::entry_holds(tys, buffers, rest, g2, ports2, env2, m + 1, next2, Nil, values2, ok.right, admitted.right)),
            Cons(x, more) => λ admitted held below bound past => Fun::entry_step_holds(tys, buffers, p, rest, g, ports, env, m, next, x, more, values, ok.left,
                admitted.left, held, below, bound.left, bound.right, past,
                λ g2 ports2 env2 next2 values2 => Fun::entry_holds(tys, buffers, rest, g2, ports2, env2, m + 1, next2, more, values2, ok.right, admitted.right)),
        },
    }
}

// The body's code after the entry's nodes runs the body over what they
// leave.
theorem Fun::entered_holds(tys: Nat → RecInfo, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered,
    v: t.sem(tys)): (nodes: List<Node>) → t.Holds(tys, c.region.eval(call, eval_nodes_over(buffers, nodes, values), buffers := buffers), c.result, v) →
    t.Holds(tys, Fun::entered(nodes, c).region.eval(call, values, buffers := buffers), Fun::entered(nodes, c).result, v) {
    λ nodes => match nodes { Nil => λ h => h, Cons(_, _) => λ h => h }
}

// What a function's lowering promises: called on any words, with calls
// answered by the program's meanings, it answers with its meaning, over
// the file of spans the meaning reads. A function lent spans takes each as
// two words before its own (`Fun.lent`), and the agreement is at every
// word there: the meaning reads a span under the length word it is handed
// (`Tm::Byte`), as the code does, so nothing is asked of those words here.
// That they are the span's place and length is the caller's to supply
// (`Lending`, function_ir_lower_reads).
fn Fun::LowerHolds(self f: Fun, w: World, r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Answers()) → Tm::CallsAgree(w, call) →
            Ty::Answers(w.tys, f.params, f.result, f.meaning(w), λ xs => code.eval(call, xs, buffers := w.spans)),
    }
}

theorem Fun::lower_sound(self f: Fun, w: World): f.LowerHolds(w, f.lower(w)) {
    let P = λ (r: Option<Function>) => f.LowerHolds(w, r);
    let ids = Fun::param_ids(f.params, 0);
    let e = f.entry_of();
    Option::and_then_elim(P, trivial, Ty::check_edges(w.tys, f.params), λ _ => f.lower_result(w), λ ok _ =>
    Option::and_then_elim(P, trivial, f.result.check_out(w.tys), λ _ => f.lower_distinct(w), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(distinct(ids)), λ _ => f.lower_body(w), λ apart _ =>
    Option::and_then_elim(P, trivial, f.body.lower(w, f.context(), e.ports, e.next), λ c => f.lower_typed(w, c), λ c lowered =>
    Option::and_then_elim(P, trivial, Tm::ty(f.body, w, f.context()).check(f.result), λ _ => Some(f.code_of(w.tys, e, c)), λ eb _ =>
        λ call agree => Ty::curry_answers(w.tys, f.result, f.params, Nil, trivial,
            λ env => Ty::cast(w.tys, Tm::ty(f.body, w, f.context()), f.result, Tm::sem(f.body, w, f.context(), env)),
            λ xs => f.code_of(w.tys, e, c).eval(call, xs, buffers := w.spans), λ xs admitted => {
                let values = Valuation::bind(Valuation::zero(), ids, xs);
                let env = Ty::extend(w.tys, f.params, Nil, trivial, xs);
                let entered = Fun::entry_holds(w.tys, w.spans, f.params, Nil, Nil, trivial, 0, Fun::past(f.params, 0), xs, values, ok, admitted, trivial, trivial,
                    Fun::bind_bound(ids, xs, apart), Fun::past(f.params, 0).le_refl());
                let inside = eval_nodes_over(w.spans, e.nodes, values);
                let after = c.region.eval(call, inside, buffers := w.spans);
                let body_ty = Tm::ty(f.body, w, f.context());
                let value = Ty::cast(w.tys, body_ty, f.result, Tm::sem(f.body, w, f.context(), env));
                let ran = j(lowered, λ r _ => Tm::LowerHolds(f.body, w, f.context(), e.ports, e.next, r),
                    Tm::lower_sound(f.body, w, f.context(), e.ports, e.next))(call, agree, inside, env, entered.left, entered.right);
                Ty::out_reads(w.tys, call, w.spans, values, f.result, Fun::entered(e.nodes, c), er, value,
                    Fun::entered_holds(w.tys, call, w.spans, values, f.result, c, value, e.nodes,
                        Ty::cast_holds(w.tys, after, c.result, body_ty, f.result, eb, Tm::sem(f.body, w, f.context(), env), ran.right.right.right)))
            }))))))
}

// A function on words answers its words past the first like a curried
// meaning: on every word list, the meaning's words past its first
// (`Ty::rest_words`: none but for a record of two words).
fn Ty::AnswersAlso(tys: Nat → RecInfo, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → (List<BitVec(64)> → List<BitVec(64)>) → Type {
    match ps {
        Nil => λ v ans => ans(Nil) = Ty::rest_words(tys, r, v),
        Cons(p, rest) => λ v ans => (x: BitVec(64)) →
            p.Given(tys, x, Ty::AnswersAlso(tys, rest, r, v(Ty::cast(tys, Word(64), p, x)), λ ws => ans(Cons(x, ws)))),
    }
}

theorem Ty::curry_answers_also(tys: Nat → RecInfo, r: Ty, ps: List<Ty>): (g: List<Ty>) → (env: Env(tys, g)) →
    (k: Env(tys, Ty::bind_onto(ps, g)) → r.sem(tys)) → (ans: List<BitVec(64)> → List<BitVec(64)>) →
    ((xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → ans(xs) = Ty::rest_words(tys, r, k(Ty::extend(tys, ps, g, env, xs)))) →
    Ty::AnswersAlso(tys, ps, r, Ty::curry(tys, r, ps, g, env, k), ans) {
    match ps {
        Nil => λ g env k ans h => h(Nil, trivial),
        Cons(p, rest) => λ g env k ans h => λ x => Ty::given<Ty::AnswersAlso(tys, rest, r, Ty::curry(tys, r, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), k), λ ws => ans(Cons(x, ws)))>(p, tys, x, λ admitted =>
            Ty::curry_answers_also(tys, r, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), k, λ ws => ans(Cons(x, ws)),
                λ ws more => h(Cons(x, ws), ⟨admitted, more⟩))),
    }
}

// What a function's lowering promises of its words past the first
// (`Function::eval_also`): the meaning's, on any words.
fn Fun::LowerAlso(self f: Fun, w: World, r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Answers()) → Tm::CallsAgree(w, call) →
            Ty::AnswersAlso(w.tys, f.params, f.result, f.meaning(w), λ xs => code.eval_also(call, xs, buffers := w.spans)),
    }
}

theorem Fun::lower_sound_also(self f: Fun, w: World): f.LowerAlso(w, f.lower(w)) {
    let P = λ (r: Option<Function>) => f.LowerAlso(w, r);
    let ids = Fun::param_ids(f.params, 0);
    let e = f.entry_of();
    Option::and_then_elim(P, trivial, Ty::check_edges(w.tys, f.params), λ _ => f.lower_result(w), λ ok _ =>
    Option::and_then_elim(P, trivial, f.result.check_out(w.tys), λ _ => f.lower_distinct(w), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(distinct(ids)), λ _ => f.lower_body(w), λ apart _ =>
    Option::and_then_elim(P, trivial, f.body.lower(w, f.context(), e.ports, e.next), λ c => f.lower_typed(w, c), λ c lowered =>
    Option::and_then_elim(P, trivial, Tm::ty(f.body, w, f.context()).check(f.result), λ _ => Some(f.code_of(w.tys, e, c)), λ eb _ =>
        λ call agree => Ty::curry_answers_also(w.tys, f.result, f.params, Nil, trivial,
            λ env => Ty::cast(w.tys, Tm::ty(f.body, w, f.context()), f.result, Tm::sem(f.body, w, f.context(), env)),
            λ xs => f.code_of(w.tys, e, c).eval_also(call, xs, buffers := w.spans), λ xs admitted => {
                let values = Valuation::bind(Valuation::zero(), ids, xs);
                let env = Ty::extend(w.tys, f.params, Nil, trivial, xs);
                let entered = Fun::entry_holds(w.tys, w.spans, f.params, Nil, Nil, trivial, 0, Fun::past(f.params, 0), xs, values, ok, admitted, trivial, trivial,
                    Fun::bind_bound(ids, xs, apart), Fun::past(f.params, 0).le_refl());
                let inside = eval_nodes_over(w.spans, e.nodes, values);
                let after = c.region.eval(call, inside, buffers := w.spans);
                let body_ty = Tm::ty(f.body, w, f.context());
                let value = Ty::cast(w.tys, body_ty, f.result, Tm::sem(f.body, w, f.context(), env));
                let ran = j(lowered, λ r _ => Tm::LowerHolds(f.body, w, f.context(), e.ports, e.next, r),
                    Tm::lower_sound(f.body, w, f.context(), e.ports, e.next))(call, agree, inside, env, entered.left, entered.right);
                Ty::also_reads(w.tys, call, w.spans, values, f.result, Fun::entered(e.nodes, c), er, value,
                    Fun::entered_holds(w.tys, call, w.spans, values, f.result, c, value, e.nodes,
                        Ty::cast_holds(w.tys, after, c.result, body_ty, f.result, eb, Tm::sem(f.body, w, f.context(), env), ran.right.right.right)))
            }))))))
}

// ---------------------------------------------------------------------------
// The lowering reads the world's type table and signatures and nothing
// else: not the meanings that answer its calls, not the file. So a function
// has one code at every file, which is what lets an instance carry one
// `Function` and state its agreement over any buffers
// (docs/native/native-one-compiler-design.md §2.3, U3c step 3). `World::over` is a
// world's table and file replaced; each lowering at it is the lowering at
// the world, by the same walk as the definition.

fn World::over(self w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>) → World { World(w.tys, w.sigs, cs, spans) }

theorem Tm::ty_static(self t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): (g: List<Ty>) →
    t.ty(w.over(cs, spans), g) = t.ty(w, g) {
    match t {
        Var(_) => λ g => refl,
        Lit(_, _) => λ g => refl,
        Prim(_, _) => λ g => refl,
        Let(e, body) => λ g => trans(cong_fn(λ (a: Ty) => body.ty(w.over(cs, spans), Cons(a, g)), Tm::ty_static(e, w, cs, spans, g)),
            Tm::ty_static(body, w, cs, spans, Cons(e.ty(w, g), g))),
        If(_, yes, _) => λ g => Tm::ty_static(yes, w, cs, spans, g),
        IfEq(_, yes, _) => λ g => Tm::ty_static(yes, w, cs, spans, g),
        Make(_, _) => λ g => refl,
        Field(_, _, _) => λ g => refl,
        Call(_, _) => λ g => refl,
        Fold(_, _, _) => λ g => refl,
        Case(_, zero, _) => λ g => Tm::ty_static(zero, w, cs, spans, g),
        Byte(_, _, _) => λ g => refl,
        Pick(i, _, arms, _) => λ g => Tm::ty_static(arms, w, cs, spans, Cons(Enum(i), g)),
    }
}

// A branch's two arms, each lowered alike at both worlds.
theorem Tm::lower_if_static(c: Nat, yes, no: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, g: List<Ty>, ports: List<Nat>,
    next: Nat,
    same_yes: (n: Nat) → Tm::lower(yes, w.over(cs, spans), g, ports, n) = Tm::lower(yes, w, g, ports, n),
    same_no: (n: Nat) → Tm::lower(no, w.over(cs, spans), g, ports, n) = Tm::lower(no, w, g, ports, n)):
    Tm::lower(yes, w.over(cs, spans), g, ports, next).and_then(λ ly => Tm::lower(no, w.over(cs, spans), g, ports, ly.next).and_then(λ ln =>
        Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w.over(cs, spans), g), Tm::ty(no, w.over(cs, spans), g), ly, ln))) =
    Tm::lower(yes, w, g, ports, next).and_then(λ ly => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln =>
        Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))) {
    let v = w.over(cs, spans);
    let arms_v = λ (ly: Lowered) (ln: Lowered) => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, v, g), Tm::ty(no, v, g), ly, ln);
    let arms_w = λ (ly: Lowered) (ln: Lowered) => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln);
    let rest_v = λ (ly: Lowered) => Tm::lower(no, v, g, ports, ly.next).and_then(λ ln => arms_v(ly, ln));
    let rest_w = λ (ly: Lowered) => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => arms_w(ly, ln));
    trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), same_yes(next)),
        Option::and_then_ext(Tm::lower(yes, w, g, ports, next), rest_v, rest_w, λ ly =>
            trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(λ ln => arms_v(ly, ln)), same_no(ly.next)),
                Option::and_then_ext(Tm::lower(no, w, g, ports, ly.next), λ ln => arms_v(ly, ln), λ ln => arms_w(ly, ln), λ ln =>
                    eq2(λ (a: Ty) (b: Ty) => Tm::lower_branch(w.tys, g, ports, c, a, b, ly, ln), Tm::ty_static(yes, w, cs, spans, g),
                        Tm::ty_static(no, w, cs, spans, g))))))
}

theorem Tm::lower_static(self t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): (g: List<Ty>) → (ports: List<Nat>) →
    (next: Nat) → Tm::lower(t, w.over(cs, spans), g, ports, next) = Tm::lower(t, w, g, ports, next) {
    match t {
        Var(_) => λ g ports next => refl,
        Lit(_, _) => λ g ports next => refl,
        Prim(_, _) => λ g ports next => refl,
        Make(_, _) => λ g ports next => refl,
        Field(_, _, _) => λ g ports next => refl,
        Call(_, _) => λ g ports next => refl,
        Fold(_, _, _) => λ g ports next => refl,
        Case(_, _, _) => λ g ports next => refl,
        Byte(_, _, _) => λ g ports next => refl,
        Pick(i, c, arms, eq) => λ g ports next => Option::and_then_ext(port_at(ports, c),
            λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w.over(cs, spans), Cons(Enum(i), g), Cons(pc, ports), next)),
            λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next)),
            λ pc => Option::and_then_ext(Ty::at(g, c).check(Enum(i)),
                λ _ => Tm::lower(arms, w.over(cs, spans), Cons(Enum(i), g), Cons(pc, ports), next),
                λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next),
                λ _ => Tm::lower_static(arms, w, cs, spans, Cons(Enum(i), g), Cons(pc, ports), next))),
        Let(e, body) => λ g ports next => {
            let v = w.over(cs, spans);
            let rest_v = λ (le: Lowered) => Tm::lower(body, v, Cons(Tm::ty(e, v, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb));
            let rest_w = λ (le: Lowered) => Tm::lower(body, w, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb));
            trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), Tm::lower_static(e, w, cs, spans, g, ports, next)),
                Option::and_then_ext(Tm::lower(e, w, g, ports, next), rest_v, rest_w, λ le =>
                    cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lb => Tm::compose(le, lb)),
                        trans(cong_fn(λ (a: Ty) => Tm::lower(body, v, Cons(a, g), Cons(le.result, ports), le.next), Tm::ty_static(e, w, cs, spans, g)),
                            Tm::lower_static(body, w, cs, spans, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next)))))
        },
        If(c, yes, no) => λ g ports next => Tm::lower_if_static(c, yes, no, w, cs, spans, g, ports, next,
            λ n => Tm::lower_static(yes, w, cs, spans, g, ports, n), λ n => Tm::lower_static(no, w, cs, spans, g, ports, n)),
        IfEq(c, yes, no) => λ g ports next => Tm::lower_if_static(c, yes, no, w, cs, spans, g, ports, next,
            λ n => Tm::lower_static(yes, w, cs, spans, g, ports, n), λ n => Tm::lower_static(no, w, cs, spans, g, ports, n)),
    }
}

theorem Fun::lower_static(self f: Fun, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): f.lower(w.over(cs, spans)) = f.lower(w) {
    let v = w.over(cs, spans);
    let ports = f.entry_of().ports;
    let next = f.entry_of().next;
    let typed = λ (c: Lowered) => cong_fn(λ (a: Ty) => a.check(f.result).and_then(λ _ => Some(f.code_of(w.tys, f.entry_of(), c))),
        Tm::ty_static(f.body, w, cs, spans, f.context()));
    let body: (f.lower_body(v) = f.lower_body(w)) = trans(
        cong_fn(λ (o: Option<Lowered>) => o.and_then(λ c => f.lower_typed(v, c)), Tm::lower_static(f.body, w, cs, spans, f.context(), ports, next)),
        Option::and_then_ext(f.body.lower(w, f.context(), ports, next), λ c => f.lower_typed(v, c), λ c => f.lower_typed(w, c), typed));
    let apart: (f.lower_distinct(v) = f.lower_distinct(w)) = cong_fn(λ (o: Option<Function>) =>
        Tm::check_true(distinct(Fun::param_ids(f.params, 0))).and_then(λ _ => o), body);
    let result: (f.lower_result(v) = f.lower_result(w)) = cong_fn(λ (o: Option<Function>) => f.result.check_out(w.tys).and_then(λ _ => o), apart);
    cong_fn(λ (o: Option<Function>) => Ty::check_edges(w.tys, f.params).and_then(λ _ => o), result)
}

// The default setup's lowering of `rt` into FunctionIR, and its soundness
// proved once (docs/native/runtime-fn-setups-design.md §6.3, §16.5–§16.7;
// issues/runtime-default-setup-soundness.md).
//
// A term lowers in a context of ports, one per variable, and from a fresh
// id `next`: to a structured region, the port holding its value, and the
// next fresh id after everything the region writes. `Tm::lower_sound` is
// the theorem every case of the lowering is a case of, by induction over
// `Tm`, with no program in sight. Its invariant is three things:
//
// - **The environment holds.** Every variable's port holds its value's
//   encoding in the valuation the region starts from (`EnvHolds`): a word at
//   its width, a bit as a one-bit word.
// - **The ports are below `next`** (`Below`), and the region writes only at
//   or above it, so it keeps every id below (`Keeps`). That is what lets a
//   `Let` body read its context after its bound term's region ran, and what
//   lets two arms of a branch reuse the same fresh ids.
// - **The result holds:** the port the lowering names holds the encoding of
//   the term's meaning (`Tm::sem`), in the evaluated valuation.
//
// The lowering decides what the meaning only casts. Where the meaning reads
// a value at another code (an operand at a primitive's parameter, a branch
// at the other's type, the scrutinee at `Bit`), the lowering asks for the
// equation between the codes (`Ty::check`) and refuses without it, and the
// proof carries the operand's encoding along that equation
// (`Ty::cast_holds`). So the theorem needs no judgment: what the lowering
// accepts is typed, and the theorem assumes only that it accepted (and,
// for calls, what the next paragraph says).
//
// Calls are the one thing the region cannot decide alone: FunctionIR answers
// a `Call` from the program, so the theorem assumes `Tm::CallsAgree`, that
// every word-signature function is answered with its meaning, and
// `Fun::lower_sound` is the theorem a program discharges it with, function by
// function.
//
// Records are scalar-replaced: a record variable's port is its first
// field's, and its fields sit at the consecutive ports (`Ty::FieldsHold`), so
// what the invariant bounds and keeps of a variable is its span (`Ty::Below`,
// `Ty::Same`), not one port.
//
// The cases: variables, literals, `Let`, `If` and `IfEq` (the convoy is
// erased, the same branch), the primitives FunctionIR has a node for (word
// `+ - & | ^`, `== <u <s` as a bit, `&& || !` on bits, shifts by a literal,
// and `zero_extend` and `truncate` as one `Resize`), `Make` and `Field`,
// and calls at a signature of words; then `Fun::lower_sound`, from
// `Function::eval` to the curried meaning. `Fold` and the
// byte primitives lower to `None`, so the theorem holds of them vacuously
// until their case is written (issues/runtime-default-setup-soundness.md
// says what each waits on). `Case`, a fuel's `match`, lowers to `None` here
// too: a fuel recursion's body is one, and `rt_loop.hthr` lowers that
// function as a loop. `ToNat` is free: a count is held as the word it is
// the `toNat` of.

import logic;
import bool;
import nat;
import list;
import option;
import pair;
import bitvec;
import bitvec_nat;
import rt;
import function_ir;
import function_ir_operation;
import function_ir_eval;

// ---------------------------------------------------------------------------
// Encodings: what a port holds for a value of a code.

// A record's field at one port: a word at its width, a bit as the one-bit
// word `ofBool`. A byte buffer is not in the valuation at all: it is held by
// its id in the buffer file, which the effectful layer relates
// (`rt_io_lower`'s `LocsHold`), and no region this lowering builds reads one
// (byte primitives and `Fold` lower to `None`), so the valuation asks
// nothing of it. A record field of a record type is refused, so it never
// holds.
fn Ty::FlatHolds(self t: Ty, values: Valuation(), port: Nat) → t.Flat() → Type {
    match t {
        Word(w) => λ v => values(w, port) = v,
        Bit => λ v => values(1, port) = BitVec::ofBool(v),
        ByteList(_) => λ _ => True,
        Lines => λ _ => False,
        Named(_) => λ _ => False,
        Count => λ n => values(64, port).toNat() = n,
        Enum(_) => λ _ => False,
    }
}

// A record's fields at consecutive ports from `port` (scalar replacement,
// design §7.2).
fn Ty::FieldsHold(fs: List<Ty>, values: Valuation()) → Nat → Ty::Flats(fs) → Type {
    match fs {
        Nil => λ port _ => True,
        Cons(f, rest) => λ port t => f.FlatHolds(values, port, t.fst) ∧ Ty::FieldsHold(rest, values, port + 1, t.snd),
    }
}

// A word at its width; a bit as the one-bit word `ofBool`, which is what a
// comparison node writes and what a conditional reads (its head bit); a
// record as its fields from the port on. A byte buffer asks nothing of the
// valuation: it lives in the buffer file (`FlatHolds`).
fn Ty::Holds(self t: Ty, tys: Table, values: Valuation(), port: Nat) → t.sem(tys) → Type {
    match t {
        Word(w) => λ v => values(w, port) = v,
        Bit => λ v => values(1, port) = BitVec::ofBool(v),
        ByteList(_) => λ _ => True,
        Lines => λ _ => False,
        Named(i) => λ v => Ty::FieldsHold(tys.fields(i), values, port, tys.get(i, v)),
        // A count as the word it is the `toNat` of.
        Count => λ n => values(64, port).toNat() = n,
        // An enum as its tag word, one of the enum's (`EnumInfo::Names`),
        // then its payload's slots (`EnumInfo.slots`), each a field.
        Enum(i) => λ v => tys.ens(i).Names(values(64, port), v) ∧ Ty::FieldsHold(tys.ens(i).slots, values, port + 1, tys.ens(i).fields(v)),
    }
}

// The width a value of the code is moved at.
fn Ty::width(self t: Ty) → Nat {
    match t { Word(w) => w, Bit => 1, ByteList(_) => 64, Lines => 64, Named(_) => 64, Count => 64, Enum(_) => 64 }
}

// A code whose value is one port a record's field may be (every code but a
// record and an enum).
fn Ty::OnePort(self t: Ty) → Type {
    match t { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => False, Count => True, Enum(_) => False }
}

fn Ty::check_one(self t: Ty) → Option<t.OnePort()> {
    match t as λ x => Option<x.OnePort()> { Word(_) => Some(trivial), Bit => Some(trivial), ByteList(_) => Some(trivial), Lines => Some(trivial), Named(_) => None, Count => Some(trivial), Enum(_) => None }
}

fn Ty::OnePorts(fs: List<Ty>) → Type {
    match fs { Nil => True, Cons(f, rest) => f.OnePort() ∧ Ty::OnePorts(rest) }
}

fn Ty::check_ones(fs: List<Ty>) → Option<Ty::OnePorts(fs)> {
    match fs {
        Nil => Some(trivial),
        Cons(f, rest) => f.check_one().and_then(λ o => Ty::check_ones(rest).and_then(λ os => Some(⟨o, os⟩))),
    }
}

// A record's field the lowering holds at one port: a one-port code, or an
// enum, at its tag word (its leaf, `Ty::leaf`; a table's record holds only
// an enum without a payload, `RecInfo.fits`).
fn Ty::FieldOne(self f: Ty) → Type {
    match f { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => False, Count => True, Enum(_) => True }
}

fn Ty::check_field_one(self f: Ty) → Option<f.FieldOne()> {
    match f as λ x => Option<x.FieldOne()> {
        Word(_) => Some(trivial), Bit => Some(trivial), ByteList(_) => Some(trivial), Lines => Some(trivial), Named(_) => None, Count => Some(trivial), Enum(_) => Some(trivial),
    }
}

fn Ty::FieldOnes(fs: List<Ty>) → Type {
    match fs { Nil => True, Cons(f, rest) => f.FieldOne() ∧ Ty::FieldOnes(rest) }
}

fn Ty::check_field_ones(fs: List<Ty>) → Option<Ty::FieldOnes(fs)> {
    match fs {
        Nil => Some(trivial),
        Cons(f, rest) => f.check_field_one().and_then(λ o => Ty::check_field_ones(rest).and_then(λ os => Some(⟨o, os⟩))),
    }
}

// Field `k`'s port, from the record's.
fn Ty::field_port(k: Nat) → Nat → Nat {
    match k { Zero => λ port => port, Succ(j) => λ port => Ty::field_port(j, port + 1) }
}

fn Ty::has_field(fs: List<Ty>, k: Nat) → Bool {
    match fs { Nil => False, Cons(_, rest) => match k { Zero => True, Succ(j) => Ty::has_field(rest, j) } }
}

// The first port after a record's fields from `port`, and after a value's.
fn Ty::fields_past(fs: List<Ty>) → Nat → Nat {
    match fs { Nil => λ port => port, Cons(_, rest) => λ port => Ty::fields_past(rest, port + 1) }
}

fn Ty::past(self t: Ty, tys: Table, port: Nat) → Nat {
    match t { Word(_) => port + 1, Bit => port + 1, ByteList(_) => port + 1, Lines => port + 1, Named(i) => Ty::fields_past(tys.fields(i), port), Count => port + 1,
        Enum(i) => Ty::fields_past(tys.ens(i).slots, port + 1) }
}

// The equation between two codes, when they agree.
fn Ty::check(self a: Ty, b: Ty) → Option<a = b> {
    match a.equation(b) { Inl(e) => Some(e), Inr(_) => None }
}

// A code's equation with itself is `refl`, at an open code too.
theorem Ty::equation_self(self a: Ty): a.equation(a) = Inl(refl) {
    match a {
        Word(w) => j(sym(Ty::nat_equation_self(w)), λ d _ =>
            (match d as λ _ => (Word(w) = Word(w)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Word(w) = Word(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Bit => refl,
        ByteList(c) => j(sym(Ty::nat_equation_self(c)), λ d _ =>
            (match d as λ _ => (ByteList(c) = ByteList(c)) ∨ True { Inl(e) => Inl(j(e, λ x _ => ByteList(c) = ByteList(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Lines => refl,
        Named(i) => j(sym(Ty::nat_equation_self(i)), λ d _ =>
            (match d as λ _ => (Named(i) = Named(i)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Named(i) = Named(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
        Count => refl,
        Enum(i) => j(sym(Ty::nat_equation_self(i)), λ d _ =>
            (match d as λ _ => (Enum(i) = Enum(i)) ∨ True { Inl(e) => Inl(j(e, λ x _ => Enum(i) = Enum(x), refl)), Inr(_) => Inr(trivial) }) = Inl(refl), refl),
    }
}

// A value cast to its own code is itself.
theorem Ty::cast_self(tys: Table, a: Ty, v: a.sem(tys)): Ty::cast(tys, a, a, v) = v {
    j(sym(a.equation_self()), λ d _ => (match d as λ _ => a.sem(tys) { Inl(e) => j(e, λ x _ => x.sem(tys), v), Inr(_) => Ty::convert(tys, a, a, v) }) = v, refl)
}

// A port holding a value holds it cast along an equation of codes.
theorem Ty::cast_holds(tys: Table, values: Valuation(), port: Nat, a, b: Ty, e: a = b, v: a.sem(tys),
    h: a.Holds(tys, values, port, v)): b.Holds(tys, values, port, Ty::cast(tys, a, b, v)) {
    j(e, λ x _ => (u: a.sem(tys)) → a.Holds(tys, values, port, u) → x.Holds(tys, values, port, Ty::cast(tys, a, x, u)),
        λ u held => j(sym(Ty::cast_self(tys, a, u)), λ r _ => a.Holds(tys, values, port, r), held))(v, h)
}

// What a port holds depends only on the port's values: a port of `after`

// What a port holds depends only on the ports it spans: a value at `to` in
// `after` whose ports carry the values of the ports at `from` in `values`
// holds what that one holds.
fn Ty::SameFields(fs: List<Ty>, values, after: Valuation()) → Nat → Nat → Type {
    match fs {
        Nil => λ from to => True,
        Cons(_, rest) => λ from to => ((wd: Nat) → after(wd, to) = values(wd, from)) ∧ Ty::SameFields(rest, values, after, from + 1, to + 1),
    }
}

fn Ty::Same(self t: Ty, tys: Table, values, after: Valuation(), from, to: Nat) → Type {
    match t {
        Word(_) => (wd: Nat) → after(wd, to) = values(wd, from),
        Bit => (wd: Nat) → after(wd, to) = values(wd, from),
        ByteList(_) => (wd: Nat) → after(wd, to) = values(wd, from),
        Lines => (wd: Nat) → after(wd, to) = values(wd, from),
        Named(i) => Ty::SameFields(tys.fields(i), values, after, from, to),
        Count => (wd: Nat) → after(wd, to) = values(wd, from),
        Enum(i) => Ty::SameFields(Cons(Word(64), tys.ens(i).slots), values, after, from, to),
    }
}

theorem Ty::flat_at(self f: Ty, values, after: Valuation(), from, to: Nat, same: (wd: Nat) → after(wd, to) = values(wd, from)):
    (v: f.Flat()) → f.FlatHolds(values, from, v) → f.FlatHolds(after, to, v) {
    match f {
        Word(w) => λ v h => trans(same(w), h),
        Bit => λ v h => trans(same(1), h),
        ByteList(_) => λ v h => h,
        Lines => λ v h => h,
        Named(_) => λ v h => h,
        Count => λ v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64)), h),
        Enum(_) => λ v h => h,
    }
}

theorem Ty::fields_at(fs: List<Ty>, values, after: Valuation()): (from, to: Nat) → Ty::SameFields(fs, values, after, from, to) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, from, t) → Ty::FieldsHold(fs, after, to, t) {
    match fs {
        Nil => λ from to same t h => h,
        Cons(f, rest) => λ from to same t h =>
            ⟨f.flat_at(values, after, from, to, same.left, t.fst, h.left), Ty::fields_at(rest, values, after, from + 1, to + 1, same.right, t.snd, h.right)⟩,
    }
}

theorem Ty::holds_at(self t: Ty, tys: Table, values, after: Valuation(), from, to: Nat):
    t.Same(tys, values, after, from, to) → (v: t.sem(tys)) → t.Holds(tys, values, from, v) → t.Holds(tys, after, to, v) {
    match t {
        Word(w) => λ same v h => trans(same(w), h),
        Bit => λ same v h => trans(same(1), h),
        ByteList(_) => λ same v h => h,
        Lines => λ same v h => h,
        Named(i) => λ same v h => Ty::fields_at(tys.fields(i), values, after, from, to, same, tys.get(i, v), h),
        Count => λ same v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), same(64)), h),
        Enum(i) => λ same v h => ⟨j(sym(same.left(64)), λ x _ => tys.ens(i).Names(x, v), h.left),
            Ty::fields_at(tys.ens(i).slots, values, after, from + 1, to + 1, same.right, tys.ens(i).fields(v), h.right)⟩,
    }
}

// A one-port code's span is its port.
theorem Ty::same_one(self t: Ty, tys: Table, values, after: Valuation(), from, to: Nat):
    t.OnePort() → ((wd: Nat) → after(wd, to) = values(wd, from)) → t.Same(tys, values, after, from, to) {
    match t {
        Word(_) => λ _ same => same,
        Bit => λ _ same => same,
        ByteList(_) => λ _ same => same,
        Lines => λ _ same => same,
        Named(_) => λ never _ => false_elim(never),
        Count => λ _ same => same,
        Enum(_) => λ never _ => false_elim(never),
    }
}

// Two valuations equal everywhere agree on every span.
theorem Ty::fields_everywhere(fs: List<Ty>, values, after: Valuation(), all: (wd, id: Nat) → after(wd, id) = values(wd, id)):
    (p: Nat) → Ty::SameFields(fs, values, after, p, p) {
    match fs { Nil => λ p => trivial, Cons(_, rest) => λ p => ⟨λ wd => all(wd, p), Ty::fields_everywhere(rest, values, after, all, p + 1)⟩ }
}

theorem Ty::same_everywhere(self t: Ty, tys: Table, values, after: Valuation(), p: Nat,
    all: (wd, id: Nat) → after(wd, id) = values(wd, id)): t.Same(tys, values, after, p, p) {
    match t {
        Word(_) => λ wd => all(wd, p),
        Bit => λ wd => all(wd, p),
        ByteList(_) => λ wd => all(wd, p),
        Lines => λ wd => all(wd, p),
        Named(i) => Ty::fields_everywhere(tys.fields(i), values, after, all, p),
        Count => λ wd => all(wd, p),
        Enum(i) => Ty::fields_everywhere(Cons(Word(64), tys.ens(i).slots), values, after, all, p),
    }
}

// A port holding a field holds the field read back at its code.
theorem Ty::holds_of_flat(self t: Ty, tys: Table, values: Valuation(), port: Nat):
    (v: t.Flat()) → t.FlatHolds(values, port, v) → t.Holds(tys, values, port, t.of_slot(tys, v)) {
    match t { Word(_) => λ v h => h, Bit => λ v h => h, ByteList(_) => λ v h => h, Lines => λ v h => h, Named(_) => λ v h => false_elim(h), Count => λ v h => h, Enum(_) => λ v h => false_elim(h) }
}

// A one-port value's port holds it as a field.
theorem Ty::flat_of_holds(self t: Ty, tys: Table, values: Valuation(), port: Nat):
    t.OnePort() → (v: t.sem(tys)) → t.Holds(tys, values, port, v) → t.FlatHolds(values, port, t.to_slot(tys, v)) {
    match t { Word(_) => λ _ v h => h, Bit => λ _ v h => h, ByteList(_) => λ _ v h => h, Lines => λ _ v h => h, Named(_) => λ never v h => false_elim(never), Count => λ _ v h => h, Enum(_) => λ never v h => false_elim(never) }
}

// Field `k` of a record's fields holds at its port.
theorem Ty::fields_hold_at(fs: List<Ty>, values: Valuation()): (port, k: Nat) → Ty::has_field(fs, k).IsTrue() →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, port, t) → Ty::at(fs, k).FlatHolds(values, Ty::field_port(k, port), Ty::flat_nth(fs, t, k)) {
    match fs {
        Nil => λ port k never => false_elim(never),
        Cons(_, rest) => λ port k => match k {
            Zero => λ _ t h => h.left,
            Succ(j) => λ has t h => Ty::fields_hold_at(rest, values, port + 1, j, has, t.snd, h.right),
        },
    }
}

// ---------------------------------------------------------------------------
// Spans below a bound.

fn Ty::FieldsBelow(fs: List<Ty>) → Nat → Nat → Type {
    match fs { Nil => λ port next => True, Cons(_, rest) => λ port next => (port < next) ∧ Ty::FieldsBelow(rest, port + 1, next) }
}

// Every port the value spans is below `next`.
fn Ty::Below(self t: Ty, tys: Table, port, next: Nat) → Type {
    match t {
        Word(_) => port < next,
        Bit => port < next,
        ByteList(_) => port < next,
        Lines => port < next,
        Named(i) => Ty::FieldsBelow(tys.fields(i), port, next),
        Count => port < next,
        Enum(i) => Ty::FieldsBelow(Cons(Word(64), tys.ens(i).slots), port, next),
    }
}

theorem Ty::one_below(self t: Ty, tys: Table, port, next: Nat): t.OnePort() → port < next → t.Below(tys, port, next) {
    match t { Word(_) => λ _ lt => lt, Bit => λ _ lt => lt, ByteList(_) => λ _ lt => lt, Lines => λ _ lt => lt, Named(_) => λ never _ => false_elim(never), Count => λ _ lt => lt, Enum(_) => λ never _ => false_elim(never) }
}

theorem Ty::below_one(self t: Ty, tys: Table, port, next: Nat): t.OnePort() → t.Below(tys, port, next) → port < next {
    match t { Word(_) => λ _ b => b, Bit => λ _ b => b, ByteList(_) => λ _ b => b, Lines => λ _ b => b, Named(_) => λ never _ => false_elim(never), Count => λ _ b => b, Enum(_) => λ never _ => false_elim(never) }
}

theorem Ty::below_cast(tys: Table, a, b: Ty, e: a = b, port, next: Nat, h: a.Below(tys, port, next)): b.Below(tys, port, next) {
    j(e, λ x _ => x.Below(tys, port, next), h)
}

theorem Ty::fields_below_mono(fs: List<Ty>, next, later: Nat, le: next <= later): (port: Nat) →
    Ty::FieldsBelow(fs, port, next) → Ty::FieldsBelow(fs, port, later) {
    match fs {
        Nil => λ port _ => trivial,
        Cons(_, rest) => λ port b => ⟨Nat::lt_of_lt_of_le(port, next, later, b.left, le), Ty::fields_below_mono(rest, next, later, le, port + 1, b.right)⟩,
    }
}

theorem Ty::below_mono(self t: Ty, tys: Table, port, next, later: Nat, le: next <= later): t.Below(tys, port, next) → t.Below(tys, port, later) {
    match t {
        Word(_) => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Bit => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        ByteList(_) => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Lines => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Named(i) => λ b => Ty::fields_below_mono(tys.fields(i), next, later, le, port, b),
        Count => λ b => Nat::lt_of_lt_of_le(port, next, later, b, le),
        Enum(i) => λ b => Ty::fields_below_mono(Cons(Word(64), tys.ens(i).slots), next, later, le, port, b),
    }
}

theorem Ty::fields_below_at(fs: List<Ty>, next: Nat): (port, k: Nat) → Ty::has_field(fs, k).IsTrue() →
    Ty::FieldsBelow(fs, port, next) → Ty::field_port(k, port) < next {
    match fs {
        Nil => λ port k never => false_elim(never),
        Cons(_, rest) => λ port k => match k {
            Zero => λ _ b => b.left,
            Succ(j) => λ has b => Ty::fields_below_at(rest, next, port + 1, j, has, b.right),
        },
    }
}

// ---------------------------------------------------------------------------
// The invariant.

// Variable `i`'s port.
fn port_at(ports: List<Nat>, i: Nat) → Option<Nat> {
    match ports { Nil => None, Cons(p, rest) => match i { Zero => Some(p), Succ(k) => port_at(rest, k) } }
}

// Every variable's port holds its value, one port per variable.
fn EnvHolds(tys: Table, values: Valuation(), g: List<Ty>) → List<Nat> → Env(tys, g) → Type {
    match g {
        Nil => λ ports _ => match ports { Nil => True, Cons(_, _) => False },
        Cons(t, rest) => λ ports env => match ports {
            Nil => False,
            Cons(p, ps) => t.Holds(tys, values, p, env.fst) ∧ EnvHolds(tys, values, rest, ps, env.snd),
        },
    }
}

// Every variable's span is below `next`, one port per variable.
fn Below(tys: Table, g: List<Ty>) → List<Nat> → Nat → Type {
    match g {
        Nil => λ ports next => match ports { Nil => True, Cons(_, _) => False },
        Cons(t, rest) => λ ports next => match ports { Nil => False, Cons(p, ps) => t.Below(tys, p, next) ∧ Below(tys, rest, ps, next) },
    }
}

// `after` keeps every id below `next`.
fn Keeps(values, after: Valuation(), next: Nat) → Type {
    (wd: Nat) → (id: Nat) → id < next → after(wd, id) = values(wd, id)
}

theorem Ty::fields_kept(fs: List<Ty>, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next)): (port: Nat) →
    Ty::FieldsBelow(fs, port, next) → Ty::SameFields(fs, values, after, port, port) {
    match fs {
        Nil => λ port _ => trivial,
        Cons(_, rest) => λ port b => ⟨λ wd => keeps(wd, port, b.left), Ty::fields_kept(rest, values, after, next, keeps, port + 1, b.right)⟩,
    }
}

// A span below `next` is kept by what keeps every id below it.
theorem Ty::same_kept(self t: Ty, tys: Table, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next), port: Nat):
    t.Below(tys, port, next) → t.Same(tys, values, after, port, port) {
    match t {
        Word(_) => λ b wd => keeps(wd, port, b),
        Bit => λ b wd => keeps(wd, port, b),
        ByteList(_) => λ b wd => keeps(wd, port, b),
        Lines => λ b wd => keeps(wd, port, b),
        Named(i) => λ b => Ty::fields_kept(tys.fields(i), values, after, next, keeps, port, b),
        Count => λ b wd => keeps(wd, port, b),
        Enum(i) => λ b => Ty::fields_kept(Cons(Word(64), tys.ens(i).slots), values, after, next, keeps, port, b),
    }
}

theorem env_holds_at(tys: Table, values: Valuation(), g: List<Ty>): (ports: List<Nat>) → (env: Env(tys, g)) →
    EnvHolds(tys, values, g, ports, env) → (i, p: Nat) → port_at(ports, i) = Some(p) →
    Ty::at(g, i).Holds(tys, values, p, Env::get(tys, g, env, i)) {
    match g {
        Nil => λ ports => match ports {
            Nil => λ env held i p (at: None<Nat>() = Some(p)) => Option::none_ne_some(p, at, Ty::at(Nil, i).Holds(tys, values, p, Env::get(tys, Nil, env, i))),
            Cons(_, _) => λ env held => false_elim(held),
        },
        Cons(t, rest) => λ ports => match ports {
            Nil => λ env held => false_elim(held),
            Cons(q, qs) => λ env held i => match i {
                Zero => λ p (at: Some(q) = Some(p)) => j(Option::some_inj(q, p, at), λ x _ => t.Holds(tys, values, x, env.fst), held.left),
                Succ(k) => λ p at => env_holds_at(tys, values, rest, qs, env.snd, held.right, k, p, at),
            },
        },
    }
}

theorem below_at(tys: Table, g: List<Ty>): (ports: List<Nat>) → (next: Nat) → Below(tys, g, ports, next) →
    (i, p: Nat) → port_at(ports, i) = Some(p) → Ty::at(g, i).Below(tys, p, next) {
    match g {
        Nil => λ ports next => match ports {
            Nil => λ _ i p (at: None<Nat>() = Some(p)) => Option::none_ne_some(p, at, Ty::at(Nil, i).Below(tys, p, next)),
            Cons(_, _) => λ never => false_elim(never),
        },
        Cons(t, rest) => λ ports next => match ports {
            Nil => λ never => false_elim(never),
            Cons(q, qs) => λ below i => match i {
                Zero => λ p (at: Some(q) = Some(p)) => j(Option::some_inj(q, p, at), λ x _ => t.Below(tys, x, next), below.left),
                Succ(k) => λ p at => below_at(tys, rest, qs, next, below.right, k, p, at),
            },
        },
    }
}

theorem below_mono(tys: Table, g: List<Ty>, next, later: Nat, le: next <= later): (ports: List<Nat>) →
    Below(tys, g, ports, next) → Below(tys, g, ports, later) {
    match g {
        Nil => λ ports => match ports { Nil => λ b => b, Cons(_, _) => λ b => b },
        Cons(t, rest) => λ ports => match ports {
            Nil => λ b => b,
            Cons(p, ps) => λ below => ⟨t.below_mono(tys, p, next, later, le, below.left), below_mono(tys, rest, next, later, le, ps, below.right)⟩,
        },
    }
}

// The environment still holds after a region that keeps its ports.
theorem env_holds_keeps(tys: Table, g: List<Ty>, values, after: Valuation(), next: Nat, keeps: Keeps(values, after, next)):
    (ports: List<Nat>) → (env: Env(tys, g)) → Below(tys, g, ports, next) → EnvHolds(tys, values, g, ports, env) → EnvHolds(tys, after, g, ports, env) {
    match g {
        Nil => λ ports env _ held => held,
        Cons(t, rest) => λ ports => match ports {
            Nil => λ env _ held => held,
            Cons(p, ps) => λ env below held =>
                ⟨t.holds_at(tys, values, after, p, p, t.same_kept(tys, values, after, next, keeps, p, below.left), env.fst, held.left),
                    env_holds_keeps(tys, rest, values, after, next, keeps, ps, env.snd, below.right, held.right)⟩,
        },
    }
}

// ---------------------------------------------------------------------------
// Regions the lowering builds.

record Lowered { region: StructuredRegion, result: Nat, next: Nat }

fn no_ports() → Ports { Ports(Nil) }

fn nodes_region(nodes: List<Node>) → StructuredRegion { Dataflow(Region(no_ports(), nodes, no_ports())) }

// A branch: the arm the bit at `condition` chooses. `outputs` are the ports
// both arms write, which the evaluation does not read: the x86 planner puts
// each in one register for both arms, so that the join keeps it.
fn branch(condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion) → StructuredRegion {
    Conditional(no_ports(), condition, no_ports(), outputs, when_true, when_false)
}

// The ports moves write.
fn moved_ports(ns: List<Node>) → Ports { Ports(ns.map(node_output)) }

theorem branch_true(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(),
    h: values(1, condition).head_bit() = True, wd, id: Nat):
    branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = when_true.eval(call, values, buffers := buffers)(wd, id) {
    j(sym(h), λ b _ => (match b { False => when_false.eval(call, values, buffers := buffers)(wd, id), True => when_true.eval(call, values, buffers := buffers)(wd, id) })
        = when_true.eval(call, values, buffers := buffers)(wd, id), refl)
}

theorem branch_false(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(),
    h: values(1, condition).head_bit() = False, wd, id: Nat):
    branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = when_false.eval(call, values, buffers := buffers)(wd, id) {
    j(sym(h), λ b _ => (match b { False => when_false.eval(call, values, buffers := buffers)(wd, id), True => when_true.eval(call, values, buffers := buffers)(wd, id) })
        = when_false.eval(call, values, buffers := buffers)(wd, id), refl)
}

// A branch keeps what both its arms keep.
theorem branch_keeps(values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion, call: Answers(), buffers: Buffers(), next: Nat,
    kept_true: Keeps(values, when_true.eval(call, values, buffers := buffers), next), kept_false: Keeps(values, when_false.eval(call, values, buffers := buffers), next)):
    Keeps(values, branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), next) {
    λ wd id below => (match values(1, condition).head_bit() as λ b => values(1, condition).head_bit() = b →
        branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers)(wd, id) = values(wd, id) {
        True => λ h => trans(branch_true(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id), kept_true(wd, id, below)),
        False => λ h => trans(branch_false(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id), kept_false(wd, id, below)),
    })(refl)
}

// A branch on a bit holds, at a port both arms write, the value the bit
// chooses.
theorem branch_holds(t: Ty, tys: Table, values: Valuation(), condition: Nat, outputs: Ports, when_true, when_false: StructuredRegion,
    call: Answers(), buffers: Buffers(), out: Nat, b: Bool, yes, no: t.sem(tys), h: values(1, condition).head_bit() = b,
    held_true: t.Holds(tys, when_true.eval(call, values, buffers := buffers), out, yes), held_false: t.Holds(tys, when_false.eval(call, values, buffers := buffers), out, no)):
    t.Holds(tys, branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, match b { False => no, True => yes }) {
    match b {
        True => t.holds_at(tys, when_true.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, out,
            t.same_everywhere(tys, when_true.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out,
                λ wd id => branch_true(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id)), yes, held_true),
        False => t.holds_at(tys, when_false.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out, out,
            t.same_everywhere(tys, when_false.eval(call, values, buffers := buffers), branch(condition, outputs, when_true, when_false).eval(call, values, buffers := buffers), out,
                λ wd id => branch_false(values, condition, outputs, when_true, when_false, call, buffers, h, wd, id)), no, held_false),
    }
}

// A value moved from `src` to fresh ports from `out`, a field at a time.
fn Ty::field_moves(fs: List<Ty>) → Nat → Nat → List<Node> {
    match fs { Nil => λ out src => Nil, Cons(f, rest) => λ out src => Cons(Move(f.width(), out, src), Ty::field_moves(rest, out + 1, src + 1)) }
}

fn Ty::moves(self t: Ty, tys: Table, out, src: Nat) → List<Node> {
    match t {
        Word(w) => [Move(w, out, src)],
        Bit => [Move(1, out, src)],
        ByteList(_) => [Move(64, out, src)],
        Lines => [Move(64, out, src)],
        Named(i) => Ty::field_moves(tys.fields(i), out, src),
        Count => [Move(64, out, src)],
        Enum(i) => Ty::field_moves(Cons(Word(64), tys.ens(i).slots), out, src),
    }
}

// What a move to fresh ports promises: the value at its new ports, every
// id below them kept, the new span below its end.
fn Ty::MovedFields(fs: List<Ty>, values, after: Valuation(), out: Nat, t: Ty::Flats(fs)) → Type {
    Ty::FieldsHold(fs, after, out, t) ∧ (Keeps(values, after, out) ∧ (Ty::FieldsBelow(fs, out, Ty::fields_past(fs, out)) ∧ (out <= Ty::fields_past(fs, out))))
}

theorem Ty::field_moves_sound(fs: List<Ty>, buffers: Buffers()): (values: Valuation()) → (out, src: Nat) → Ty::FieldsBelow(fs, src, out) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, src, t) → Ty::MovedFields(fs, values, eval_nodes_over(buffers, Ty::field_moves(fs, out, src), values), out, t) {
    match fs {
        Nil => λ values out src _ t _ => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩,
        Cons(f, rest) => λ values out src below t h => {
            let moved = Valuation::set(values, out, λ wd => values(wd, src));
            let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
            let kept: Keeps(values, moved, out) = λ wd id lt => Valuation::set_other(values, out, λ x => values(x, src), wd, id, Nat::ne_of_lt(id, out, lt));
            let later = Ty::field_moves_sound(rest, buffers, moved, out + 1, src + 1,
                Ty::fields_below_mono(rest, out, out + 1, step, src + 1, below.right), t.snd,
                Ty::fields_at(rest, values, moved, src + 1, src + 1, Ty::fields_kept(rest, values, moved, out, kept, src + 1, below.right), t.snd, h.right));
            let after = eval_nodes_over(buffers, Ty::field_moves(rest, out + 1, src + 1), moved);
            ⟨⟨f.flat_at(values, after, src, out,
                    λ wd => trans(later.right.left(wd, out, out.lt_succ_self()), Valuation::set_here(values, out, λ x => values(x, src), wd)), t.fst, h.left),
                later.left⟩,
                ⟨λ wd id lt => trans(later.right.left(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)), kept(wd, id, lt)),
                    ⟨⟨later.right.right.right, later.right.right.left⟩,
                        Nat::le_trans(out, out + 1, Ty::fields_past(rest, out + 1), step, later.right.right.right)⟩⟩⟩
        },
    }
}

// The same for a value of any code.
fn Ty::Moved(self t: Ty, tys: Table, values, after: Valuation(), out: Nat, v: t.sem(tys)) → Type {
    t.Holds(tys, after, out, v) ∧ (Keeps(values, after, out) ∧ (t.Below(tys, out, t.past(tys, out)) ∧ (out <= t.past(tys, out))))
}

theorem Ty::one_move_sound(t: Ty, tys: Table, one: t.OnePort(), values: Valuation(), out, src: Nat, v: t.sem(tys),
    h: t.Holds(tys, values, src, v)):
    t.Holds(tys, Valuation::set(values, out, λ wd => values(wd, src)), out, v) ∧ (Keeps(values, Valuation::set(values, out, λ wd => values(wd, src)), out) ∧
        (t.Below(tys, out, out + 1) ∧ (out <= out + 1))) {
    ⟨t.holds_at(tys, values, Valuation::set(values, out, λ wd => values(wd, src)), src, out,
            t.same_one(tys, values, Valuation::set(values, out, λ wd => values(wd, src)), src, out, one,
                λ wd => Valuation::set_here(values, out, λ x => values(x, src), wd)), v, h),
        ⟨λ wd id lt => Valuation::set_other(values, out, λ x => values(x, src), wd, id, Nat::ne_of_lt(id, out, lt)),
            ⟨t.one_below(tys, out, out + 1, one, out.lt_succ_self()), Nat::le_succ_r(out, out, out.le_refl())⟩⟩⟩
}

theorem Ty::moves_sound(self t: Ty, tys: Table, buffers: Buffers(), values: Valuation(), out, src: Nat):
    t.Below(tys, src, out) → (v: t.sem(tys)) → t.Holds(tys, values, src, v) → t.Moved(tys, values, eval_nodes_over(buffers, t.moves(tys, out, src), values), out, v) {
    match t {
        Word(w) => λ _ v h => Ty::one_move_sound(Word(w), tys, trivial, values, out, src, v, h),
        Bit => λ _ v h => Ty::one_move_sound(Bit, tys, trivial, values, out, src, v, h),
        ByteList(c) => λ _ v h => Ty::one_move_sound(ByteList(c), tys, trivial, values, out, src, v, h),
        Lines => λ _ v h => Ty::one_move_sound(Lines, tys, trivial, values, out, src, v, h),
        Named(i) => λ below v h => Ty::field_moves_sound(tys.fields(i), buffers, values, out, src, below, tys.get(i, v), h),
        Count => λ _ v h => Ty::one_move_sound(Count, tys, trivial, values, out, src, v, h),
        // The tag word and the slots, each moved as a field.
        Enum(i) => λ below v h => {
            let moved = Ty::field_moves_sound(Cons(Word(64), tys.ens(i).slots), buffers, values, out, src, below,
                Pair(values(64, src), tys.ens(i).fields(v)), ⟨refl, h.right⟩);
            ⟨⟨j(sym(moved.left.left), λ x _ => tys.ens(i).Names(x, v), h.left), moved.left.right⟩, moved.right⟩
        },
    }
}

// ---------------------------------------------------------------------------
// Casts along equations of codes.

// Casting along `a = b` and on to `c` is casting straight to `c`.
theorem Ty::cast_trans(tys: Table, a, b, c: Ty, e: a = b, v: a.sem(tys)):
    Ty::cast(tys, b, c, Ty::cast(tys, a, b, v)) = Ty::cast(tys, a, c, v) {
    j(e, λ x _ => Ty::cast(tys, x, c, Ty::cast(tys, a, x, v)) = Ty::cast(tys, a, c, v),
        cong_fn(λ (u: a.sem(tys)) => Ty::cast(tys, a, c, u), Ty::cast_self(tys, a, v)))
}

// A cast there and back along an equation is the value.
theorem Ty::cast_back(tys: Table, a, b: Ty, e: a = b, v: a.sem(tys)): Ty::cast(tys, b, a, Ty::cast(tys, a, b, v)) = v {
    trans(Ty::cast_trans(tys, a, b, a, e, v), Ty::cast_self(tys, a, v))
}

// `Bit` is not a word: from such an equation anything follows.
theorem Ty::bit_ne_word(width: Nat, e: Bit = Word(width), T: Type): T {
    j(e, λ x _ => match x as λ _ => Type { Word(_) => T, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True, Enum(_) => True }, trivial)
}

// ---------------------------------------------------------------------------
// Calls. FunctionIR's `Call` takes and returns 64-bit words, so a call is
// lowered only at a signature of words (§7.3; wider signatures wait for
// `function-ir-multi-word-calls`). What a call is answered with is a
// hypothesis of the theorem, `Tm::CallsAgree`: every word-signature function
// of the program is answered with its meaning. A program discharges it
// function by function from the theorem for functions below (`Fun::lower_sound`).

// Every code is a 64-bit word.
fn Ty::Words(ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => (p = Word(64)) ∧ Ty::Words(rest) }
}

fn Ty::check_words(ps: List<Ty>) → Option<Ty::Words(ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check(Word(64)).and_then(λ e => Ty::check_words(rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A code a function takes or returns in one 64-bit word at its boundary:
// a 64-bit word, or a record whose one field is (a type held at its
// `datarepr`'s word carrier, `SInt(64)` as `BitVec(64)`). The word read at
// the record is the record built from it (`Ty::convert`), so the record is
// scalar-replaced into the word's port and its field is the word.
fn Ty::OneWord(self t: Ty, tys: Table) → Type {
    match t { Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys.recs(i).fields = [Word(64)], Count => False, Enum(_) => False }
}

fn Ty::check_fields_word(fs: List<Ty>) → Option<fs = [Word(64)]> {
    match fs as λ g => Option<g = [Word(64)]> {
        Nil => None,
        Cons(f, rest) => match rest as λ r => Option<Cons(f, r) = [Word(64)]> {
            Nil => f.check(Word(64)).and_then(λ e => Some(j(e, λ x _ => Cons(f, Nil) = Cons(x, Nil), refl))),
            Cons(_, _) => None,
        },
    }
}

fn Ty::check_one_word(self t: Ty, tys: Table) → Option<t.OneWord(tys)> {
    match t as λ x => Option<x.OneWord(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys.recs(i).fields),
        Count => None,
        Enum(_) => None,
    }
}

fn Ty::OneWords(tys: Table, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.OneWord(tys) ∧ Ty::OneWords(tys, rest) }
}

fn Ty::check_one_words(tys: Table, ps: List<Ty>) → Option<Ty::OneWords(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_one_word(tys).and_then(λ e => Ty::check_one_words(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// Every 64-bit word is held in one.
theorem Ty::words_one_words(tys: Table, ps: List<Ty>): Ty::Words(ps) → Ty::OneWords(tys, ps) {
    match ps {
        Nil => λ _ => trivial,
        Cons(p, rest) => λ ok => ⟨j(sym(ok.left), λ x _ => x.OneWord(tys), refl), Ty::words_one_words(tys, rest, ok.right)⟩,
    }
}

// A record held in one word has no enum field: its leaves are its fields,
// and building it from them and reading them back is the identity.
theorem Table::word_leaves(self tys: Table, i: Nat, e: tys.recs(i).fields = [Word(64)]): tys.fields(i) = [Word(64)] { cong_fn(Ty::leaves, e) }

theorem Table::word_round(self tys: Table, i: Nat, e: tys.recs(i).fields = [Word(64)], t: Ty::Flats(tys.fields(i))): tys.get(i, tys.mk(i, t)) = t {
    tys.round(i, j(sym(e), λ g _ => Ty::NoEnums(g), ⟨trivial, trivial⟩), t)
}

// A record held in one word, built from the word at its port, holds there:
// its one field is the word.
theorem Ty::record_word_holds(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, get: T → Ty::Flats(fs),
    round: (t: Ty::Flats(fs)) → get(mk(t)) = t, e: fs = [Word(64)], values: Valuation(), port: Nat, x: BitVec(64),
    h: values(64, port) = x): Ty::FieldsHold(fs, values, port, get(mk(Ty::flats_word(fs, x, EnumInfo::nones)))) {
    let core = j(sym(e), λ g _ => Ty::FieldsHold(g, values, port, Ty::flats_word(g, x, EnumInfo::nones)), ⟨h, trivial⟩);
    j(sym(round(Ty::flats_word(fs, x, EnumInfo::nones))), λ r _ => Ty::FieldsHold(fs, values, port, r), core)
}

// A word at its port, read at a code held in one word, holds there.
theorem Ty::one_word_holds(tys: Table, values: Valuation(), port: Nat, t: Ty): t.OneWord(tys) → (x: BitVec(64)) →
    values(64, port) = x → t.Holds(tys, values, port, Ty::cast(tys, Word(64), t, x)) {
    match t {
        Word(w) => λ (e: w = 64) x h => Ty::cast_holds(tys, values, port, Word(64), Word(w), j(sym(e), λ n _ => Word(64) = Word(n), refl), x, h),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e x h => Ty::record_word_holds(tys.recs(i).T, tys.fields(i), λ t => tys.mk(i, t), λ v => tys.get(i, v), λ t => tys.word_round(i, e, t), tys.word_leaves(i, e), values, port, x, h),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A code held in one word spans one port.
theorem Ty::one_word_below(tys: Table, t: Ty): t.OneWord(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(_) => λ _ m => m.lt_succ_self(),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => j(sym(tys.word_leaves(i, e)), λ g _ => Ty::FieldsBelow(g, m, m + 1), ⟨m.lt_succ_self(), trivial⟩),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// The fields of a record held in one word hold the word its first field is.
theorem Ty::fields_word_reads(values: Valuation(), port: Nat, fs: List<Ty>, e: fs = [Word(64)]): (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → values(64, port) = Ty::flats_head_word(fs, EnumInfo::nones, t) {
    j(sym(e), λ g _ => (t: Ty::Flats(g)) → Ty::FieldsHold(g, values, port, t) → values(64, port) = Ty::flats_head_word(g, EnumInfo::nones, t),
        λ t held => held.left)
}

// A value of a code held in one word, at its port: the port's word is the
// value read as a word.
theorem Ty::one_word_reads(tys: Table, values: Valuation(), port: Nat, t: Ty): t.OneWord(tys) → (v: t.sem(tys)) →
    t.Holds(tys, values, port, v) → values(64, port) = Ty::cast(tys, t, Word(64), v) {
    match t {
        Word(w) => λ (e: w = 64) v h => Ty::cast_holds(tys, values, port, Word(w), Word(64), j(e, λ n _ => Word(w) = Word(n), refl), v, h),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => Ty::fields_word_reads(values, port, tys.fields(i), tys.word_leaves(i, e), tys.get(i, v), h),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// An enum without a payload: none of its constructors has fields, so its
// tag word is all of it.
fn Ty::Bare(fs: List<Ty>) → Type { match fs { Nil => True, Cons(_, _) => False } }

fn Ty::check_bare(fs: List<Ty>) → Option<Ty::Bare(fs)> {
    match fs as λ g => Option<Ty::Bare(g)> { Nil => Some(trivial), Cons(_, _) => None }
}

theorem Ty::bare_holds(fs: List<Ty>, values: Valuation(), port: Nat): Ty::Bare(fs) → (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, port, t) {
    match fs { Nil => λ _ t => trivial, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::bare_words(fs: List<Ty>): Ty::Bare(fs) → Ty::Words(fs) {
    match fs { Nil => λ _ => trivial, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::bare_default(fs: List<Ty>): Ty::Bare(fs) → (t: Ty::Flats(fs)) → t = Ty::flats_default(fs) {
    match fs { Nil => λ _ t => refl, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::bare_below(fs: List<Ty>): Ty::Bare(fs) → (port, next: Nat) → Ty::FieldsBelow(fs, port, next) {
    match fs { Nil => λ _ port next => trivial, Cons(_, _) => λ never => false_elim(never) }
}

// A code held in one 64-bit word across a call: a word, a record held in
// one (`Ty::OneWord`, a type at its repr's word), a count (a loop's fuel,
// the word it is the `toNat` of), or an enum without a payload (its tag
// word, which the callee reads back as the constructor, `EnumInfo::read`).
fn Ty::Held(self p: Ty, tys: Table) → Type {
    match p {
        Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys.recs(i).fields = [Word(64)], Count => True,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Bare(tys.ens(i).slots),
    }
}

fn Ty::check_held(self p: Ty, tys: Table) → Option<p.Held(tys)> {
    match p as λ x => Option<x.Held(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys.recs(i).fields),
        Count => Some(trivial),
        Enum(i) => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Bare(tys.ens(i).slots)> {
            False => None,
            True => Ty::check_bare(tys.ens(i).slots).and_then(λ bare => Some(⟨refl, bare⟩)),
        },
    }
}

fn Ty::Helds(tys: Table, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Held(tys) ∧ Ty::Helds(tys, rest) }
}

fn Ty::check_helds(tys: Table, ps: List<Ty>) → Option<Ty::Helds(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_held(tys).and_then(λ e => Ty::check_helds(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A record held in one word, holding at its port, is the record built from
// the port's word (`back`: building from the fields read off a record is
// the record).
theorem Ty::record_word_reads(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, get: T → Ty::Flats(fs),
    back: (v: T) → mk(get(v)) = v, e: fs = [Word(64)], values: Valuation(), port: Nat, v: T,
    h: Ty::FieldsHold(fs, values, port, get(v))): mk(Ty::flats_word(fs, values(64, port), EnumInfo::nones)) = v {
    let general = j(sym(e), λ g _ => (mk2: Ty::Flats(g) → T) → (get2: T → Ty::Flats(g)) → ((u: T) → mk2(get2(u)) = u) →
            Ty::FieldsHold(g, values, port, get2(v)) → mk2(Ty::flats_word(g, values(64, port), EnumInfo::nones)) = v,
        λ mk2 get2 back2 h2 => trans(cong_fn(λ (x: BitVec(64)) => mk2(Pair(x, trivial)), h2.left), back2(v)));
    general(mk, get, back, h)
}

// The word a code held in one word crosses a boundary as, read back at the
// code, is the value.
theorem Ty::one_word_back(tys: Table, t: Ty): t.OneWord(tys) → (v: t.sem(tys)) →
    Ty::cast(tys, Word(64), t, Ty::cast(tys, t, Word(64), v)) = v {
    match t {
        Word(w) => λ (e: w = 64) v => Ty::cast_back(tys, Word(w), Word(64), j(e, λ n _ => Word(w) = Word(n), refl), v),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v => {
            let general = j(sym(tys.word_leaves(i, e)), λ g _ => (mk2: Ty::Flats(g) → tys.recs(i).T) → (get2: tys.recs(i).T → Ty::Flats(g)) →
                    ((u: tys.recs(i).T) → mk2(get2(u)) = u) → mk2(Ty::flats_word(g, Ty::flats_head_word(g, EnumInfo::nones, get2(v)), EnumInfo::nones)) = v,
                λ mk2 get2 back2 => back2(v));
            general(λ t => tys.mk(i, t), λ u => tys.get(i, u), λ u => tys.back(i, u))
        },
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A decision whose equation does not hold is its `Inr`.
theorem Or::inr_apart<P>(o: P ∨ True, apart: P → False): o = Inr(trivial) {
    match o { Inl(e) => false_elim(apart(e)), Inr(_) => refl }
}

// A port holding a value of a code held in a word: the word, read back at
// the code, is the value (a count's `toNat` is the count, an enum's word
// names its constructor, `EnumInfo.of_tag`).
theorem Ty::held_reads(tys: Table, p: Ty, values: Valuation(), port: Nat): p.Held(tys) → (v: p.sem(tys)) →
    p.Holds(tys, values, port, v) → Ty::cast(tys, Word(64), p, values(64, port)) = v {
    match p {
        Word(w) => λ (e: w = 64) => j(sym(e), λ x _ => (v: BitVec(x)) → values(x, port) = v → Ty::cast(tys, Word(64), Word(x), values(64, port)) = v,
            λ v held => trans(Ty::cast_self(tys, Word(64), values(64, port)), held)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v held => Ty::record_word_reads(tys.recs(i).T, tys.fields(i), λ t => tys.mk(i, t), λ u => tys.get(i, u), λ u => tys.back(i, u), tys.word_leaves(i, e), values, port, v, held),
        Count => λ _ n held => held,
        Enum(i) => λ bare v held => {
            let e = tys.ens(i);
            let tag = trans(Nat::min_eq_l(values(64, port).toNat(), e.last, held.left.right), held.left.left);
            trans(cong_fn(λ (n: Nat) => e.of(n, Ty::flats_default(e.slots)), tag),
                j(Ty::bare_default(e.slots, bare.right, e.fields(v)), λ t _ => e.of(e.tag(v), t) = v, e.of_tag(v)))
        },
    }
}

// The words a code's boundary admits: an enum's are its tags, any other
// code's every word. A contract passes only real values; a caller passes
// what holds one, which is admitted (`Ty::holds_admits`).
fn Ty::Admits(self t: Ty, tys: Table, x: BitVec(64)) → Type {
    match t { Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True, Enum(i) => x.toNat() <= tys.ens(i).last }
}

theorem Ty::holds_admits(tys: Table, p: Ty, values: Valuation(), port: Nat): (v: p.sem(tys)) → p.Holds(tys, values, port, v) →
    p.Admits(tys, values(64, port)) {
    match p {
        Word(_) => λ _ _ => trivial, Bit => λ _ _ => trivial, ByteList(_) => λ _ _ => trivial, Lines => λ _ _ => trivial,
        Named(_) => λ _ _ => trivial, Count => λ _ _ => trivial, Enum(_) => λ _ h => h.left.right,
    }
}

// ---------------------------------------------------------------------------
// A parameter's words (design §16.16): every code but an enum crosses a
// function's boundary in one word; an enum in its tag word, then its
// payload's slots in order, a word each (as C passes a struct of those
// words, member by member). A contract quantifies an enum as its value and
// passes its words (`Ty::Takes`), so it holds at real values only.

fn Ty::flats_words(fs: List<Ty>) → Ty::Flats(fs) → List<BitVec(64)> {
    match fs as λ g => Ty::Flats(g) → List<BitVec(64)> {
        Nil => λ _ => Nil,
        Cons(f, rest) => λ t => Cons(f.flat_word(EnumInfo::nones, t.fst), Ty::flats_words(rest, t.snd)),
    }
}

// The words an enum of table entry `i` is passed and returned in after its
// tag word: its payload's slots (`Ty::rest_words`).
fn RecInfo::enum_rest(tys: Table, i: Nat, v: tys.ens(i).E) → List<BitVec(64)> { Ty::flats_words(tys.ens(i).slots, tys.ens(i).fields(v)) }

// All of an enum's words: its tag word, then its slots.
fn RecInfo::enum_words(tys: Table, i: Nat, v: tys.ens(i).E) → List<BitVec(64)> {
    Cons(RecInfo::enum_word(tys, i, v), RecInfo::enum_rest(tys, i, v))
}

// A record's words: its fields', in order (`Ty::flats_words`), each a word.
fn RecInfo::record_words(tys: Table, i: Nat, v: tys.recs(i).T) → List<BitVec(64)> { Ty::flats_words(tys.fields(i), tys.get(i, v)) }

// How many words a code crosses the boundary in, and a signature's
// parameters (the last parameter's first).
fn Ty::span(self p: Ty, tys: Table) → Nat {
    match p { Word(_) => 1, Bit => 1, ByteList(_) => 1, Lines => 1, Named(i) => tys.fields(i).len(), Count => 1, Enum(i) => tys.ens(i).slots.len() + 1 }
}

fn Ty::spans(tys: Table, ps: List<Ty>) → Nat {
    match ps { Nil => 0, Cons(p, rest) => Ty::spans(tys, rest) + p.span(tys) }
}

// The first `n` words and those after them, zero past the words' end
// (each matches on `n` first, so that a closed count walks any list).
fn Ty::first(n: Nat, ws: List<BitVec(64)>) → List<BitVec(64)> {
    match n { Zero => Nil, Succ(k) => Cons(ws.head_or(BitVec::zero()), Ty::first(k, ws.tail())) }
}

fn Ty::skip(n: Nat, ws: List<BitVec(64)>) → List<BitVec(64)> {
    match n { Zero => ws, Succ(k) => Ty::skip(k, ws.tail()) }
}

// A payload read off words, one slot a word (zero past the words' end).
fn Ty::flats_of_words(fs: List<Ty>, ws: List<BitVec(64)>) → Ty::Flats(fs) {
    match fs { Nil => trivial, Cons(f, rest) => Pair(f.word_at(ws.head_or(BitVec::zero()), EnumInfo::nones), Ty::flats_of_words(rest, ws.tail())) }
}

// A code's words read back as its value: the first as the code reads a
// word (`Ty::cast`); at an enum, the tag word as its constructor (the last
// past it) and the slots after it as the payload's.
fn Ty::read_words(self p: Ty, tys: Table, ws: List<BitVec(64)>) → p.sem(tys) {
    match p as λ q => q.sem(tys) {
        Word(w) => Ty::cast(tys, Word(64), Word(w), ws.head_or(BitVec::zero())),
        Bit => Ty::cast(tys, Word(64), Bit, ws.head_or(BitVec::zero())),
        ByteList(n) => Ty::cast(tys, Word(64), ByteList(n), ws.head_or(BitVec::zero())),
        Lines => Ty::cast(tys, Word(64), Lines, ws.head_or(BitVec::zero())),
        Named(i) => tys.mk(i, Ty::flats_of_words(tys.fields(i), ws)),
        Count => Ty::cast(tys, Word(64), Count, ws.head_or(BitVec::zero())),
        Enum(i) => tys.ens(i).of(ws.head_or(BitVec::zero()).toNat().min(tys.ens(i).last), Ty::flats_of_words(tys.ens(i).slots, ws.tail())),
    }
}

// The words a code's boundary admits, from the first: an enum's, the
// words of a value (those it reads back as), every word list any other
// code's. A contract passes only real values; a caller passes the words of
// one, which are admitted (`Ty::enum_taken`).
fn Ty::AdmitsAt(self p: Ty, tys: Table, ws: List<BitVec(64)>) → Type {
    match p {
        Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True,
        Enum(i) => Ty::first(tys.ens(i).slots.len() + 1, ws) = RecInfo::enum_words(tys, i, Ty::read_words(Enum(i), tys, ws)),
    }
}

// Two word lists alike, decided.
fn Ty::words_eq(xs, ys: List<BitVec(64)>) → Bool {
    match xs {
        Nil => match ys { Nil => True, Cons(_, _) => False },
        Cons(x, r) => match ys { Nil => False, Cons(y, s) => x.eq_bit(y) && Ty::words_eq(r, s) },
    }
}

theorem Ty::words_eq_sound(xs: List<BitVec(64)>): (ys: List<BitVec(64)>) → Ty::words_eq(xs, ys).IsTrue() → xs = ys {
    match xs {
        Nil => λ ys => {
            let none: List<BitVec(64)> = Nil;
            match ys as λ zs => Ty::words_eq(none, zs).IsTrue() → none = zs { Nil => λ _ => refl, Cons(_, _) => λ never => false_elim(never) }
        },
        Cons(x, r) => λ ys => match ys as λ zs => Ty::words_eq(Cons(x, r), zs).IsTrue() → Cons(x, r) = zs {
            Nil => λ never => false_elim(never),
            Cons(y, s) => λ h => {
                let parts = Bool::is_true_and(x.eq_bit(y), Ty::words_eq(r, s), h);
                let head: (x = y) = BitVec::eq_of_eq_bit(64, x, y, eq_true_of_is_true(x.eq_bit(y), parts.left));
                trans(cong_fn(λ (a: BitVec(64)) => Cons(a, r), head), cong_fn(λ (t: List<BitVec(64)>) => Cons(y, t), Ty::words_eq_sound(r, s, parts.right)))
            },
        },
    }
}

theorem Ty::words_eq_self(xs: List<BitVec(64)>): Ty::words_eq(xs, xs).IsTrue() {
    match xs {
        Nil => trivial,
        Cons(x, r) => Bool::is_true_and_intro(x.eq_bit(x), Ty::words_eq(r, r), Bool::is_true_of_eq(BitVec::eq_bit_self(64, x)), Ty::words_eq_self(r)),
    }
}

// The same decided, what a list of a program's functions holds (a list's
// entries are of the lowest universe, and a predicate is not).
fn Ty::admits_at(self p: Ty, tys: Table, ws: List<BitVec(64)>) → Bool {
    match p {
        Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True,
        Enum(i) => Ty::words_eq(Ty::first(tys.ens(i).slots.len() + 1, ws), RecInfo::enum_words(tys, i, Ty::read_words(Enum(i), tys, ws))),
    }
}

theorem Ty::admits_at_sound(tys: Table, p: Ty, ws: List<BitVec(64)>): p.admits_at(tys, ws).IsTrue() → p.AdmitsAt(tys, ws) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial,
        Enum(i) => λ h => Ty::words_eq_sound(Ty::first(tys.ens(i).slots.len() + 1, ws), RecInfo::enum_words(tys, i, Ty::read_words(Enum(i), tys, ws)), h),
    }
}

theorem Ty::admits_at_complete(tys: Table, p: Ty, ws: List<BitVec(64)>): p.AdmitsAt(tys, ws) → p.admits_at(tys, ws).IsTrue() {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial,
        Enum(i) => λ h => j(h, λ zs _ => Ty::words_eq(Ty::first(tys.ens(i).slots.len() + 1, ws), zs).IsTrue(),
            Ty::words_eq_self(Ty::first(tys.ens(i).slots.len() + 1, ws))),
    }
}

// Words each parameter admits, each taking its own (zero past the words'
// end, as `Ty::extend_words` reads them).
fn Ty::AdmitsAll(tys: Table, ps: List<Ty>) → List<BitVec(64)> → Type {
    match ps {
        Nil => λ _ => True,
        Cons(p, rest) => λ xs => p.AdmitsAt(tys, xs) ∧ Ty::AdmitsAll(tys, rest, Ty::skip(p.span(tys), xs)),
    }
}

fn Ty::admits_all(tys: Table, ps: List<Ty>) → List<BitVec(64)> → Bool {
    match ps {
        Nil => λ _ => True,
        Cons(p, rest) => λ xs => p.admits_at(tys, xs) && Ty::admits_all(tys, rest, Ty::skip(p.span(tys), xs)),
    }
}

theorem Ty::admits_all_sound(tys: Table, ps: List<Ty>): (xs: List<BitVec(64)>) → Ty::admits_all(tys, ps, xs).IsTrue() → Ty::AdmitsAll(tys, ps, xs) {
    match ps {
        Nil => λ xs _ => trivial,
        Cons(p, rest) => λ xs h => {
            let parts = Bool::is_true_and(p.admits_at(tys, xs), Ty::admits_all(tys, rest, Ty::skip(p.span(tys), xs)), h);
            ⟨Ty::admits_at_sound(tys, p, xs, parts.left), Ty::admits_all_sound(tys, rest, Ty::skip(p.span(tys), xs), parts.right)⟩
        },
    }
}

theorem Ty::admits_all_complete(tys: Table, ps: List<Ty>): (xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → Ty::admits_all(tys, ps, xs).IsTrue() {
    match ps {
        Nil => λ xs _ => trivial,
        Cons(p, rest) => λ xs h => Bool::is_true_and_intro(p.admits_at(tys, xs), Ty::admits_all(tys, rest, Ty::skip(p.span(tys), xs)),
            Ty::admits_at_complete(tys, p, xs, h.left), Ty::admits_all_complete(tys, rest, Ty::skip(p.span(tys), xs), h.right)),
    }
}

// Codes that admit every word: none an enum.
fn Ty::all_open(ps: List<Ty>) → Bool {
    match ps { Nil => True, Cons(p, rest) => (match p { Enum(_) => False, _ => True }) && Ty::all_open(rest) }
}

theorem Ty::open_admits(tys: Table, p: Ty, xs: List<BitVec(64)>): (match p { Enum(_) => False, _ => True }).IsTrue() → p.AdmitsAt(tys, xs) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::all_open_admits(tys: Table, ps: List<Ty>): Ty::all_open(ps).IsTrue() → (xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) {
    match ps {
        Nil => λ _ xs => trivial,
        Cons(p, rest) => λ open xs => {
            let parts = Bool::is_true_and(match p { Enum(_) => False, _ => True }, Ty::all_open(rest), open);
            ⟨Ty::open_admits(tys, p, xs, parts.left), Ty::all_open_admits(tys, rest, parts.right, Ty::skip(p.span(tys), xs))⟩
        },
    }
}

// Word lists: the first `n` of a list of more than `n` and the rest make
// it up, and a list's own count of words from it.
theorem Ty::first_skip(n: Nat): (m: Nat) → (xs: List<BitVec(64)>) → xs.len() = m + n →
    (Ty::first(n, xs) ++ Ty::skip(n, xs) = xs) ∧ (Ty::skip(n, xs).len() = m) {
    match n {
        Zero => λ m xs len => ⟨refl, len⟩,
        Succ(k) => λ m xs => match xs as λ ys => ys.len() = m + Succ(k) →
            (Ty::first(Succ(k), ys) ++ Ty::skip(Succ(k), ys) = ys) ∧ (Ty::skip(Succ(k), ys).len() = m) {
            Nil => λ (bad: 0 = Succ(m + k)) => false_elim((m + k).zero_ne_succ(bad)),
            Cons(x, r) => λ (len: Succ(r.len()) = Succ(m + k)) => {
                let inner = Ty::first_skip(k, m, r, Nat::succ_inj(r.len(), m + k, len));
                ⟨cong_fn(λ (t: List<BitVec(64)>) => Cons(x, t), inner.left), inner.right⟩
            },
        },
    }
}

theorem Ty::first_append(xs: List<BitVec(64)>, more: List<BitVec(64)>): Ty::first(xs.len(), xs ++ more) = xs {
    match xs { Nil => refl, Cons(x, r) => cong_fn(λ (t: List<BitVec(64)>) => Cons(x, t), Ty::first_append(r, more)) }
}

theorem Ty::skip_append(xs: List<BitVec(64)>, more: List<BitVec(64)>): Ty::skip(xs.len(), xs ++ more) = more {
    match xs { Nil => refl, Cons(_, r) => Ty::skip_append(r, more) }
}

theorem Ty::flats_words_len(fs: List<Ty>): (t: Ty::Flats(fs)) → Ty::flats_words(fs, t).len() = fs.len() {
    match fs { Nil => λ t => refl, Cons(f, rest) => λ t => cong_fn(λ (n: Nat) => Succ(n), Ty::flats_words_len(rest, t.snd)) }
}

// A payload of 64-bit words read back off its words is itself.
theorem Ty::flats_round(fs: List<Ty>): Ty::Words(fs) → (t: Ty::Flats(fs)) → (more: List<BitVec(64)>) →
    Ty::flats_of_words(fs, Ty::flats_words(fs, t) ++ more) = t {
    match fs {
        Nil => λ _ t more => refl,
        Cons(f, rest) => λ ok t more => {
            let head = j(sym(ok.left), λ g _ => (x: g.Flat()) → g.word_at(g.flat_word(EnumInfo::nones, x), EnumInfo::nones) = x, λ x => refl)(t.fst);
            trans(cong_fn(λ (a: f.Flat()) => Pair(a, Ty::flats_of_words(rest, Ty::flats_words(rest, t.snd) ++ more)), head),
                cong_fn(λ (b: Ty::Flats(rest)) => Pair(t.fst, b), Ty::flats_round(rest, ok.right, t.snd, more)))
        },
    }
}

// A record's fields crossing the boundary: a word each, quantified in
// turn (`Ty::TakesFields`), so a contract names every word list of the
// record's length and the record they are read as
// (docs/native/runtime-fn-setups-design.md §16.17).
fn Ty::TakesFields(fs: List<Ty>, k: List<BitVec(64)> → Type) → Type {
    match fs { Nil => k(Nil), Cons(_, rest) => (x: BitVec(64)) → Ty::TakesFields(rest, λ (ws: List<BitVec(64)>) => k(Cons(x, ws))) }
}

theorem Ty::fields_intro(fs: List<Ty>): (k: List<BitVec(64)> → Type) → ((ws: List<BitVec(64)>) → ws.len() = fs.len() → k(ws)) → Ty::TakesFields(fs, k) {
    match fs {
        Nil => λ k h => h(Nil, refl),
        Cons(_, rest) => λ k h x => Ty::fields_intro(rest, λ (ws: List<BitVec(64)>) => k(Cons(x, ws)), λ ws len => h(Cons(x, ws), cong_fn(λ (n: Nat) => Succ(n), len))),
    }
}

theorem Ty::fields_taken_at(fs: List<Ty>): (k: List<BitVec(64)> → Type) → Ty::TakesFields(fs, k) → (xs: List<BitVec(64)>) → k(Ty::first(fs.len(), xs)) {
    match fs {
        Nil => λ k t xs => t,
        Cons(_, rest) => λ k t xs => Ty::fields_taken_at(rest, λ (ws: List<BitVec(64)>) => k(Cons(xs.head_or(BitVec::zero()), ws)), t(xs.head_or(BitVec::zero())), xs.tail()),
    }
}

theorem Ty::fields_map(fs: List<Ty>): (k, l: List<BitVec(64)> → Type) → ((ws: List<BitVec(64)>) → k(ws) → l(ws)) →
    Ty::TakesFields(fs, k) → Ty::TakesFields(fs, l) {
    match fs {
        Nil => λ k l f t => f(Nil, t),
        Cons(_, rest) => λ k l f t x => Ty::fields_map(rest, λ (ws: List<BitVec(64)>) => k(Cons(x, ws)), λ (ws: List<BitVec(64)>) => l(Cons(x, ws)), λ (ws: List<BitVec(64)>) => f(Cons(x, ws)), t(x)),
    }
}

// Fields read off their own words, whatever follows them, or off the first
// as many words as there are fields.
theorem Ty::flats_of_words_append(fs: List<Ty>): (ws, more: List<BitVec(64)>) → ws.len() = fs.len() →
    Ty::flats_of_words(fs, ws ++ more) = Ty::flats_of_words(fs, ws) {
    match fs {
        Nil => λ ws more _ => refl,
        Cons(f, rest) => λ ws more => match ws as λ us => us.len() = Succ(rest.len()) → Ty::flats_of_words(Cons(f, rest), us ++ more) = Ty::flats_of_words(Cons(f, rest), us) {
            Nil => λ (bad: 0 = Succ(rest.len())) => false_elim(rest.len().zero_ne_succ(bad)),
            Cons(x, r) => λ (len: Succ(r.len()) = Succ(rest.len())) =>
                cong_fn(λ (t: Ty::Flats(rest)) => Pair(f.word_at(x, EnumInfo::nones), t), Ty::flats_of_words_append(rest, r, more, Nat::succ_inj(r.len(), rest.len(), len))),
        },
    }
}

theorem Ty::flats_of_words_first(fs: List<Ty>): (xs: List<BitVec(64)>) → Ty::flats_of_words(fs, Ty::first(fs.len(), xs)) = Ty::flats_of_words(fs, xs) {
    match fs {
        Nil => λ xs => refl,
        Cons(f, rest) => λ xs => cong_fn(λ (t: Ty::Flats(rest)) => Pair(f.word_at(xs.head_or(BitVec::zero()), EnumInfo::nones), t), Ty::flats_of_words_first(rest, xs.tail())),
    }
}

// 64-bit fields' words, read and written back, are the first as many words.
theorem Ty::flats_words_of(fs: List<Ty>): Ty::Words(fs) → (xs: List<BitVec(64)>) → Ty::flats_words(fs, Ty::flats_of_words(fs, xs)) = Ty::first(fs.len(), xs) {
    match fs {
        Nil => λ _ xs => refl,
        Cons(f, rest) => λ ok xs => {
            let head = j(sym(ok.left), λ g _ => (x: BitVec(64)) → g.flat_word(EnumInfo::nones, g.word_at(x, EnumInfo::nones)) = x, λ x => refl)(xs.head_or(BitVec::zero()));
            eq2(λ (a: BitVec(64)) (r: List<BitVec(64)>) => Cons(a, r), head, Ty::flats_words_of(rest, ok.right, xs.tail()))
        },
    }
}

// A list's own count of its words is itself.
theorem Ty::first_all(xs: List<BitVec(64)>): Ty::first(xs.len(), xs) = xs {
    match xs { Nil => refl, Cons(x, r) => cong_fn(λ (t: List<BitVec(64)>) => Cons(x, t), Ty::first_all(r)) }
}

// A record whose one field is a 64-bit word is passed as that word: its
// fields read off a word list starting with it are the record that word
// reads as (`Ty::cast`), and a contract over its fields is one over the
// word.
theorem Ty::fields_one_read(fs: List<Ty>, e: fs = [Word(64)], x: BitVec(64), ws: List<BitVec(64)>): Ty::flats_of_words(fs, Cons(x, ws)) = Ty::flats_word(fs, x, EnumInfo::nones) {
    j(sym(e), λ g _ => Ty::flats_of_words(g, Cons(x, ws)) = Ty::flats_word(g, x, EnumInfo::nones), refl)
}

theorem Ty::fields_one_to(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, e: fs = [Word(64)], K: List<BitVec(64)> → T → Type):
    Ty::TakesFields(fs, λ (ws: List<BitVec(64)>) => K(ws, mk(Ty::flats_of_words(fs, ws)))) → (x: BitVec(64)) → K([x], mk(Ty::flats_word(fs, x, EnumInfo::nones))) {
    j(sym(e), λ g _ => (mk2: Ty::Flats(g) → T) → Ty::TakesFields(g, λ (ws: List<BitVec(64)>) => K(ws, mk2(Ty::flats_of_words(g, ws)))) →
        (x: BitVec(64)) → K([x], mk2(Ty::flats_word(g, x, EnumInfo::nones))), λ mk2 t => t)(mk)
}

theorem Ty::fields_one_from(T: Type, fs: List<Ty>, mk: Ty::Flats(fs) → T, e: fs = [Word(64)], K: List<BitVec(64)> → T → Type):
    ((x: BitVec(64)) → K([x], mk(Ty::flats_word(fs, x, EnumInfo::nones)))) → Ty::TakesFields(fs, λ (ws: List<BitVec(64)>) => K(ws, mk(Ty::flats_of_words(fs, ws)))) {
    j(sym(e), λ g _ => (mk2: Ty::Flats(g) → T) → ((x: BitVec(64)) → K([x], mk2(Ty::flats_word(g, x, EnumInfo::nones)))) →
        Ty::TakesFields(g, λ (ws: List<BitVec(64)>) => K(ws, mk2(Ty::flats_of_words(g, ws)))), λ mk2 h => h)(mk)
}

fn Tm::check_true(b: Bool) → Option<b.IsTrue()> {
    match b as λ x => Option<x.IsTrue()> { False => None, True => Some(trivial) }
}

fn Ty::check_narrow(w: Nat) → Option<(w = 64) ∨ (w < 64)> {
    match w.equation(64) {
        Inl(e) => Some(Inl(e)),
        Inr(_) => Tm::check_true((w + 1).leb(64)).and_then(λ h => Some(Inr(Nat::leb_sound(w + 1, 64, h)))),
    }
}

// ---------------------------------------------------------------------------
// Slots (design §16.18). A record's field or an enum's payload slot
// crosses the boundary in one word, as a narrow word or a `Bool` does on
// its own: a word of at most 64 bits zero-extended into it, a bit as zero
// or one. Where it lands it is read back by its low bits (`Ty::word_at`),
// and from a port the word is its zero extension (`Ty::flat_word`).

fn Ty::Slot(self f: Ty) → Type {
    match f { Word(w) => (w = 64) ∨ (w < 64), Bit => True, ByteList(_) => False, Lines => False, Named(_) => False, Count => False, Enum(_) => False }
}

fn Ty::check_slot(self f: Ty) → Option<f.Slot()> {
    match f as λ x => Option<x.Slot()> {
        Word(w) => Ty::check_narrow(w), Bit => Some(trivial), ByteList(_) => None, Lines => None, Named(_) => None, Count => None, Enum(_) => None,
    }
}

fn Ty::Slots(fs: List<Ty>) → Type {
    match fs { Nil => True, Cons(f, rest) => f.Slot() ∧ Ty::Slots(rest) }
}

fn Ty::check_slots(fs: List<Ty>) → Option<Ty::Slots(fs)> {
    match fs {
        Nil => Some(trivial),
        Cons(f, rest) => f.check_slot().and_then(λ e => Ty::check_slots(rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// Whether a slot is narrower than a word: its port is not its word.
fn Ty::slot_narrow(self f: Ty) → Bool {
    match f { Word(w) => match w.equation(64) { Inl(_) => False, Inr(_) => True }, Bit => True, ByteList(_) => False, Lines => False, Named(_) => False, Count => False, Enum(_) => False }
}

fn Ty::slots_narrow(fs: List<Ty>) → Bool {
    match fs { Nil => False, Cons(f, rest) => f.slot_narrow() || Ty::slots_narrow(rest) }
}

// Whether two adjacent fields are both narrow: a C structure of these
// fields lays the two in one eightbyte, which System V passes in one
// register, where a record here passes each field in a word of its own.
// `compile-x86` refuses such a record at a C boundary (§16.18).
fn Ty::slots_share(fs: List<Ty>) → Bool {
    match fs {
        Nil => False,
        Cons(f, rest) => match rest {
            Nil => False,
            Cons(g, _) => (f.slot_narrow() && g.slot_narrow()) || Ty::slots_share(rest),
        },
    }
}

theorem Ty::words_slots(fs: List<Ty>): Ty::Words(fs) → Ty::Slots(fs) {
    match fs {
        Nil => λ _ => trivial,
        Cons(f, rest) => λ ok => ⟨j(sym(ok.left), λ g _ => g.Slot(), Inl(refl)), Ty::words_slots(rest, ok.right)⟩,
    }
}

// Slots none of which is narrow are 64-bit words.
theorem Ty::slot_wide(f: Ty): f.Slot() → f.slot_narrow() = False → f = Word(64) {
    match f {
        Word(w) => λ ok => match ok {
            Inl(e) => λ _ => j(sym(e), λ y _ => Word(y) = Word(64), refl),
            Inr(lt) => λ (bad: (match w.equation(64) { Inl(_) => False, Inr(_) => True }) = False) =>
                absurd(j(Or::inr_apart(w.equation(64), Nat::ne_of_lt(w, 64, lt)), λ d _ => (match d { Inl(_) => False, Inr(_) => True }) = False, bad)),
        },
        Bit => λ _ (bad: True = False) => absurd(bad),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::slots_wide(fs: List<Ty>): Ty::Slots(fs) → Ty::slots_narrow(fs) = False → Ty::Words(fs) {
    match fs {
        Nil => λ _ _ => trivial,
        Cons(f, rest) => λ ok none => {
            let parts = Bool::or_false_parts(f.slot_narrow(), Ty::slots_narrow(rest), none);
            ⟨Ty::slot_wide(f, ok.left, parts.left), Ty::slots_wide(rest, ok.right, parts.right)⟩
        },
    }
}

// A word below 2^w, at most 64 bits, fits a 64-bit word.
theorem Ty::narrow_small(w: Nat, lt: w < 64, v: BitVec(w)): v.toNat() < Nat::pow(2, 64) {
    Nat::lt_of_lt_of_le(v.toNat(), Nat::pow(2, w), Nat::pow(2, 64), BitVec::toNat_lt_pow(w, v), Nat::pow_le_pow_r(2, w, 64, trivial, w.le_of_lt(64, lt)))
}

// A narrow slot's word and its reading, past the equation of its width.
theorem Ty::narrow_flat_word(w: Nat, ne: w ≠ 64, v: BitVec(w)): Word(w).flat_word(EnumInfo::nones, v) = BitVec::ofNat(v.toNat()) {
    j(sym(Or::inr_apart(w.equation(64), ne)), λ d _ =>
        (match d as λ _ => BitVec(64) { Inl(e) => j(e, λ y _ => BitVec(y), v), Inr(_) => BitVec::ofNat(v.toNat()) }) = BitVec::ofNat(v.toNat()), refl)
}

theorem Ty::narrow_word_at(w: Nat, ne: w ≠ 64, x: BitVec(64)): Word(w).word_at(x, EnumInfo::nones) = BitVec::ofNat(x.toNat()) {
    j(sym(Or::inr_apart(Nat::equation(64, w), λ e => ne(sym(e)))), λ d _ =>
        (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => BitVec(y), x), Inr(_) => BitVec::ofNat(x.toNat()) }) = BitVec::ofNat(x.toNat()), refl)
}

// A slot's word read back is the slot.
theorem Ty::slot_round(f: Ty): f.Slot() → (v: f.Flat()) → f.word_at(f.flat_word(EnumInfo::nones, v), EnumInfo::nones) = v {
    match f {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (v: Word(y).Flat()) → Word(y).word_at(Word(y).flat_word(EnumInfo::nones, v), EnumInfo::nones) = v, λ v => refl),
            Inr(lt) => λ v => {
                let ne = Nat::ne_of_lt(w, 64, lt);
                trans(cong_fn(λ (x: BitVec(64)) => Word(w).word_at(x, EnumInfo::nones), Ty::narrow_flat_word(w, ne, v)),
                    trans(Ty::narrow_word_at(w, ne, BitVec::ofNat(v.toNat())),
                        trans(cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := w), BitVec::toNat_ofNat(64, v.toNat(), Ty::narrow_small(w, lt, v))), BitVec::ofNat_toNat(w, v))))
            },
        },
        Bit => λ _ v => match v { False => refl, True => refl },
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// Slots read back off their words are themselves, whatever follows.
theorem Ty::slots_round(fs: List<Ty>): Ty::Slots(fs) → (t: Ty::Flats(fs)) → (more: List<BitVec(64)>) →
    Ty::flats_of_words(fs, Ty::flats_words(fs, t) ++ more) = t {
    match fs {
        Nil => λ _ t more => refl,
        Cons(f, rest) => λ ok t more =>
            trans(cong_fn(λ (a: f.Flat()) => Pair(a, Ty::flats_of_words(rest, Ty::flats_words(rest, t.snd) ++ more)), Ty::slot_round(f, ok.left, t.fst)),
                cong_fn(λ (b: Ty::Flats(rest)) => Pair(t.fst, b), Ty::slots_round(rest, ok.right, t.snd, more))),
    }
}

// What an enum asks of its table entry to cross the boundary in words:
// its tags in a word, and its payload's slots each a 64-bit word. Every
// other code crosses as it is.
fn Ty::Passes(self p: Ty, tys: Table) → Type {
    match p {
        Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Slots(tys.ens(i).slots),
    }
}

fn Ty::PassesAll(tys: Table, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Passes(tys) ∧ Ty::PassesAll(tys, rest) }
}

// The same decided: what a generator closes by evaluation.
fn Ty::passes(self p: Ty, tys: Table) → Bool {
    match p {
        Word(_) => True, Bit => True, ByteList(_) => True, Lines => True, Named(_) => True, Count => True,
        Enum(i) => (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) && (match Ty::check_slots(tys.ens(i).slots) { None => False, Some(_) => True }),
    }
}

theorem Ty::slots_checked(fs: List<Ty>): (o: Option<Ty::Slots(fs)>) → (match o { None => False, Some(_) => True }).IsTrue() → Ty::Slots(fs) {
    λ o => match o as λ c => (match c { None => False, Some(_) => True }).IsTrue() → Ty::Slots(fs) { None => λ never => false_elim(never), Some(h) => λ _ => h }
}

theorem Ty::passes_sound(tys: Table, p: Ty): p.passes(tys).IsTrue() → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial,
        Enum(i) => λ h => {
            let parts = Bool::is_true_and((tys.ens(i).last + 1).leb(Nat::pow(2, 64)), match Ty::check_slots(tys.ens(i).slots) { None => False, Some(_) => True }, h);
            ⟨eq_true_of_is_true((tys.ens(i).last + 1).leb(Nat::pow(2, 64)), parts.left),
                Ty::slots_checked(tys.ens(i).slots, Ty::check_slots(tys.ens(i).slots), parts.right)⟩
        },
    }
}

// Slots, decided: what a generator closes by evaluation.
fn Ty::slots_ok(fs: List<Ty>) → Bool { match Ty::check_slots(fs) { None => False, Some(_) => True } }

// A record's words, and any after them, read back as the record.
theorem RecInfo::record_reads(tys: Table, i: Nat, ok: Ty::Slots(tys.fields(i)), v: tys.recs(i).T, more: List<BitVec(64)>):
    Ty::read_words(Named(i), tys, RecInfo::record_words(tys, i, v) ++ more) = v {
    trans(cong_fn(λ (t: Ty::Flats(tys.fields(i))) => tys.mk(i, t), Ty::slots_round(tys.fields(i), ok, tys.get(i, v), more)), tys.back(i, v))
}

// An enum's own words, and any after them: admitted, the rest past its
// span, and read back as the value.
theorem RecInfo::enum_words_len(tys: Table, i: Nat, v: tys.ens(i).E): RecInfo::enum_words(tys, i, v).len() = tys.ens(i).slots.len() + 1 {
    cong_fn(λ (n: Nat) => Succ(n), Ty::flats_words_len(tys.ens(i).slots, tys.ens(i).fields(v)))
}

theorem RecInfo::enum_reads(tys: Table, i: Nat, ok: Enum(i).Passes(tys), v: tys.ens(i).E, more: List<BitVec(64)>):
    Ty::read_words(Enum(i), tys, RecInfo::enum_words(tys, i, v) ++ more) = v {
    let e = tys.ens(i);
    let le = e.bounded(v);
    let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, le),
        Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), ok.left));
    let word: (BitVec::ofNat(e.tag(v), n := 64).toNat() = e.tag(v)) = BitVec::toNat_ofNat(64, e.tag(v), lt);
    let clamped: (BitVec::ofNat(e.tag(v), n := 64).toNat().min(e.last) = e.tag(v)) =
        j(sym(word), λ y _ => y.min(e.last) = e.tag(v), Nat::min_eq_l(e.tag(v), e.last, le));
    let slots: (Ty::flats_of_words(e.slots, RecInfo::enum_rest(tys, i, v) ++ more) = e.fields(v)) = Ty::slots_round(e.slots, ok.right, e.fields(v), more);
    trans(cong_fn(λ (n: Nat) => e.of(n, Ty::flats_of_words(e.slots, RecInfo::enum_rest(tys, i, v) ++ more)), clamped),
        trans(cong_fn(λ (t: Ty::Flats(e.slots)) => e.of(e.tag(v), t), slots), e.of_tag(v)))
}

// What passing words `ws` as a value `a` of a code needs: they are as
// many as the code's span, and whatever words follow, the code admits
// them, takes `ws` and leaves the rest, and reads them as `a`.
fn Ty::Taken(self p: Ty, tys: Table, ws: List<BitVec(64)>, a: p.sem(tys)) → Type {
    (ws.len() = p.span(tys)) ∧
        ((more: List<BitVec(64)>) → p.AdmitsAt(tys, ws ++ more) ∧ ((Ty::skip(p.span(tys), ws ++ more) = more) ∧ (Ty::read_words(p, tys, ws ++ more) = a)))
}

theorem RecInfo::enum_taken(tys: Table, i: Nat, ok: Enum(i).Passes(tys), v: tys.ens(i).E): Enum(i).Taken(tys, RecInfo::enum_words(tys, i, v), v) {
    ⟨RecInfo::enum_words_len(tys, i, v), λ more => {
        let ws = RecInfo::enum_words(tys, i, v);
        let len = RecInfo::enum_words_len(tys, i, v);
        let read = RecInfo::enum_reads(tys, i, ok, v, more);
        let firsts: (Ty::first(tys.ens(i).slots.len() + 1, ws ++ more) = ws) = j(len, λ n _ => Ty::first(n, ws ++ more) = ws, Ty::first_append(ws, more));
        ⟨trans(firsts, cong_fn(λ (u: tys.ens(i).E) => RecInfo::enum_words(tys, i, u), sym(read))),
            ⟨j(len, λ n _ => Ty::skip(n, ws ++ more) = more, Ty::skip_append(ws, more)), read⟩⟩
    }⟩
}

// Words taken, and as many after them, are as many as the two.
theorem Ty::taken_len(tys: Table, p: Ty, ws: List<BitVec(64)>, a: p.sem(tys), taken: p.Taken(tys, ws, a), more: List<BitVec(64)>, m: Nat,
    len: more.len() = m): (ws ++ more).len() = m + p.span(tys) {
    trans(List::len_append(ws, more), trans(cong_fn(λ (n: Nat) => n + more.len(), taken.left),
        trans(cong_fn(λ (n: Nat) => p.span(tys) + n, len), Nat::add_comm(p.span(tys), m))))
}

// A parameter in a contract: any word, read at its code; an enum as its
// value, passed in its words (`RecInfo::enum_words`).
fn Ty::Takes(self p: Ty, tys: Table) → (List<BitVec(64)> → p.sem(tys) → Type) → Type {
    match p {
        Word(w) => λ k => (x: BitVec(64)) → k([x], Ty::cast(tys, Word(64), Word(w), x)),
        Bit => λ k => (x: BitVec(64)) → k([x], Ty::cast(tys, Word(64), Bit, x)),
        ByteList(n) => λ k => (x: BitVec(64)) → k([x], Ty::cast(tys, Word(64), ByteList(n), x)),
        Lines => λ k => (x: BitVec(64)) → k([x], Ty::cast(tys, Word(64), Lines, x)),
        Named(i) => λ k => Ty::TakesFields(tys.fields(i), λ (ws: List<BitVec(64)>) => k(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws)))),
        Count => λ k => (x: BitVec(64)) → k([x], Ty::cast(tys, Word(64), Count, x)),
        Enum(i) => λ k => (v: tys.ens(i).E) → k(RecInfo::enum_words(tys, i, v), v),
    }
}

// A contract's parameter from what holds of every words-and-value it is
// passed as.
theorem Ty::takes_intro(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Passes(tys) →
    ((ws: List<BitVec(64)>) → (a: p.sem(tys)) → p.Taken(tys, ws, a) → K(ws, a)) → p.Takes(tys, K) {
    match p {
        Word(w) => λ K _ h x => h([x], Ty::cast(tys, Word(64), Word(w), x), ⟨refl, λ more => ⟨trivial, ⟨refl, refl⟩⟩⟩),
        Bit => λ K _ h x => h([x], Ty::cast(tys, Word(64), Bit, x), ⟨refl, λ more => ⟨trivial, ⟨refl, refl⟩⟩⟩),
        ByteList(n) => λ K _ h x => h([x], Ty::cast(tys, Word(64), ByteList(n), x), ⟨refl, λ more => ⟨trivial, ⟨refl, refl⟩⟩⟩),
        Lines => λ K _ h x => h([x], Ty::cast(tys, Word(64), Lines, x), ⟨refl, λ more => ⟨trivial, ⟨refl, refl⟩⟩⟩),
        Named(i) => λ K _ h => Ty::fields_intro(tys.fields(i), λ (ws: List<BitVec(64)>) => K(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws))), λ ws len =>
            h(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws)), ⟨len, λ more => ⟨trivial,
                ⟨j(len, λ n _ => Ty::skip(n, ws ++ more) = more, Ty::skip_append(ws, more)),
                    cong_fn(λ (t: Ty::Flats(tys.fields(i))) => tys.mk(i, t), Ty::flats_of_words_append(tys.fields(i), ws, more, len))⟩⟩⟩)),
        Count => λ K _ h x => h([x], Ty::cast(tys, Word(64), Count, x), ⟨refl, λ more => ⟨trivial, ⟨refl, refl⟩⟩⟩),
        Enum(i) => λ K ok h v => h(RecInfo::enum_words(tys, i, v), v, RecInfo::enum_taken(tys, i, ok, v)),
    }
}

// A contract's parameter at admitted words: what holds of their first
// span read back.
theorem Ty::takes_at(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Takes(tys, K) → (xs: List<BitVec(64)>) →
    p.AdmitsAt(tys, xs) → K(Ty::first(p.span(tys), xs), Ty::read_words(p, tys, xs)) {
    match p {
        Word(_) => λ K t xs _ => t(xs.head_or(BitVec::zero())),
        Bit => λ K t xs _ => t(xs.head_or(BitVec::zero())),
        ByteList(_) => λ K t xs _ => t(xs.head_or(BitVec::zero())),
        Lines => λ K t xs _ => t(xs.head_or(BitVec::zero())),
        Named(i) => λ K t xs _ => j(Ty::flats_of_words_first(tys.fields(i), xs), λ fl _ => K(Ty::first(tys.fields(i).len(), xs), tys.mk(i, fl)),
            Ty::fields_taken_at(tys.fields(i), λ (ws: List<BitVec(64)>) => K(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws))), t, xs)),
        Count => λ K t xs _ => t(xs.head_or(BitVec::zero())),
        Enum(i) => λ K t xs adm => j(sym(adm), λ ws _ => K(ws, Ty::read_words(Enum(i), tys, xs)), t(Ty::read_words(Enum(i), tys, xs))),
    }
}

// A signature the calling convention covers: each parameter held in a word,
// and a word result.
// A code a call returns in one 64-bit word: one held in one
// (`Ty::OneWord`), or an enum, as its tag word, which names the callee's
// value where the enum's tags fit a word (`EnumInfo.bounded`).
fn Ty::Returned(self t: Ty, tys: Table) → Type {
    match t {
        Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => tys.recs(i).fields = [Word(64)], Count => False,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Bare(tys.ens(i).slots),
    }
}

fn Ty::check_returned(self t: Ty, tys: Table) → Option<t.Returned(tys)> {
    match t as λ x => Option<x.Returned(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys.recs(i).fields),
        Count => None,
        Enum(i) => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Bare(tys.ens(i).slots)> {
            False => None,
            True => Ty::check_bare(tys.ens(i).slots).and_then(λ bare => Some(⟨refl, bare⟩)),
        },
    }
}

// A word returned at its port holds the value it is the word of.
theorem Ty::returned_holds(tys: Table, values: Valuation(), port: Nat, t: Ty): t.Returned(tys) → (v: t.sem(tys)) →
    values(64, port) = Ty::cast(tys, t, Word(64), v) → t.Holds(tys, values, port, v) {
    match t {
        Word(w) => λ (e: w = 64) v h => j(Ty::one_word_back(tys, Word(w), e, v), λ u _ => Word(w).Holds(tys, values, port, u),
            Ty::one_word_holds(tys, values, port, Word(w), e, Ty::cast(tys, Word(w), Word(64), v), h)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => j(Ty::one_word_back(tys, Named(i), e, v), λ u _ => Named(i).Holds(tys, values, port, u),
            Ty::one_word_holds(tys, values, port, Named(i), e, Ty::cast(tys, Named(i), Word(64), v), h)),
        Count => λ never => false_elim(never),
        Enum(i) => λ ok v h => {
            let e = tys.ens(i);
            let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, e.bounded(v)),
                Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), ok.left));
            let word: (values(64, port).toNat() = e.tag(v)) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), h), BitVec::toNat_ofNat(64, e.tag(v), lt));
            ⟨⟨word, j(sym(word), λ y _ => y <= e.last, e.bounded(v))⟩, Ty::bare_holds(e.slots, values, port + 1, ok.right, e.fields(v))⟩
        },
    }
}

// A code returned in one word spans one port.
theorem Ty::returned_below(tys: Table, t: Ty): t.Returned(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(w) => λ e m => Ty::one_word_below(tys, Word(w), e, m),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => Ty::one_word_below(tys, Named(i), e, m),
        Count => λ never => false_elim(never),
        Enum(i) => λ ok m => ⟨m.lt_succ_self(), Ty::bare_below(tys.ens(i).slots, ok.right, m + 1, m + 1)⟩,
    }
}

fn Sig::Words(self s: Sig, tys: Table) → Type { Ty::Helds(tys, s.params) ∧ s.result.Returned(tys) }

// A function on words answers like a curried meaning: on every word list
// its parameters take (`Ty::Takes`: any word, read at its code; an enum's
// value, in its words), the meaning applied to what they are, cast to a
// word.
fn Ty::Answers(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → (List<BitVec(64)> → BitVec(64)) → Type {
    match ps {
        Nil => λ v ans => ans(Nil) = Ty::cast(tys, r, Word(64), v),
        Cons(p, rest) => λ v ans => p.Takes(tys, λ ws a => Ty::Answers(tys, rest, r, v(a), λ more => ans(ws ++ more))),
    }
}

// A value's words past its first: a record's fields after its head, an
// enum's slots, none for any other code.
fn Ty::flats_tail_words(fs: List<Ty>) → Ty::Flats(fs) → List<BitVec(64)> {
    match fs as λ g => Ty::Flats(g) → List<BitVec(64)> { Nil => λ _ => Nil, Cons(f, rest) => λ t => Ty::flats_words(rest, t.snd) }
}

fn Ty::rest_words(tys: Table, t: Ty) → t.sem(tys) → List<BitVec(64)> {
    match t as λ x => x.sem(tys) → List<BitVec(64)> {
        Word(_) => λ _ => Nil, Bit => λ _ => Nil, ByteList(_) => λ _ => Nil, Lines => λ _ => Nil,
        Named(i) => λ v => Ty::flats_tail_words(tys.fields(i), tys.get(i, v)),
        Count => λ _ => Nil,
        Enum(i) => λ v => RecInfo::enum_rest(tys, i, v),
    }
}

// All of a value's words, as a function returns them: its first as the
// code reads a word (`Ty::cast`), then the words past it
// (`Ty::rest_words`: a record's fields after its head, an enum's slots).
fn Ty::result_words(tys: Table, t: Ty, v: t.sem(tys)) → List<BitVec(64)> {
    Cons(Ty::cast(tys, t, Word(64), v), Ty::rest_words(tys, t, v))
}

// ---------------------------------------------------------------------------
// The ports a value spans past its first, and the ids a code's words take.

// The ports of a record's fields from `port` on, and the words a field
// tuple's fields are.
fn Ty::ports_from(fs: List<Ty>, port: Nat) → List<Nat> {
    match fs { Nil => Nil, Cons(_, rest) => Cons(port, Ty::ports_from(rest, port + 1)) }
}

// A record result's words past the first: the ports of its fields after the
// head, and the words of those fields; an enum's, its payload's slots after
// its tag. Every other code returns one word.
fn Ty::fields_also_ports(fs: List<Ty>, port: Nat) → List<Nat> {
    match fs { Nil => Nil, Cons(_, rest) => Ty::ports_from(rest, port + 1) }
}

fn Ty::also_ports(self t: Ty, tys: Table, port: Nat) → List<Nat> {
    match t {
        Word(_) => Nil, Bit => Nil, ByteList(_) => Nil, Lines => Nil, Named(i) => Ty::fields_also_ports(tys.fields(i), port), Count => Nil,
        Enum(i) => Ty::ports_from(tys.ens(i).slots, port + 1),
    }
}

// Fields that are all 64-bit words, held from `port`: their ports' words
// are the fields.
theorem Ty::ports_reads(values: Valuation(), fs: List<Ty>): (port: Nat) → Ty::Words(fs) → (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → words_of(values, Ty::ports_from(fs, port)) = Ty::flats_words(fs, t) {
    match fs {
        Nil => λ port _ t _ => refl,
        Cons(f, rest) => λ port ok t held => {
            let head = j(sym(ok.left), λ g _ => (x: g.Flat()) → g.FlatHolds(values, port, x) → values(64, port) = g.flat_word(EnumInfo::nones, x),
                λ x h => h)(t.fst, held.left);
            trans(cong_fn(λ (a: BitVec(64)) => Cons(a, words_of(values, Ty::ports_from(rest, port + 1))), head),
                cong_fn(λ (r: List<BitVec(64)>) => Cons(f.flat_word(EnumInfo::nones, t.fst), r), Ty::ports_reads(values, rest, port + 1, ok.right, t.snd, held.right)))
        },
    }
}

theorem Ty::fields_rest_reads(values: Valuation(), port: Nat, fs: List<Ty>): Ty::Words(fs) → (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → words_of(values, Ty::fields_also_ports(fs, port)) = Ty::flats_tail_words(fs, t) {
    match fs {
        Nil => λ _ t _ => refl,
        Cons(f, rest) => λ ok t held => Ty::ports_reads(values, rest, port + 1, ok.right, t.snd, held.right),
    }
}

theorem Ty::ports_from_len(fs: List<Ty>): (port: Nat) → Ty::ports_from(fs, port).len() = fs.len() {
    match fs { Nil => λ port => refl, Cons(_, rest) => λ port => cong_fn(λ (n: Nat) => Succ(n), Ty::ports_from_len(rest, port + 1)) }
}

// A plain function's parameters take their words (`Ty::span`): each word
// at the next id, a parameter's port the id of its first word (an enum's
// tag word, its slots' ids the ports after it, as `Ty::Holds` reads them).
fn Ty::ids(self p: Ty, tys: Table, m: Nat) → List<Nat> {
    match p {
        Word(_) => [m], Bit => [m], ByteList(_) => [m], Lines => [m], Named(i) => Ty::ports_from(tys.fields(i), m), Count => [m],
        Enum(i) => Cons(m, Ty::ports_from(tys.ens(i).slots, m + 1)),
    }
}

// A function answers every word like a curried meaning: on every word list
// its parameters take, the meaning's words (`Ty::result_words`). The first
// word is `Ty::Answers`'s and the rest `Ty::AnswersAlso`'s
// (docs/native/runtime-fn-setups-design.md §16.17).
fn Ty::AnswersWords(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → (List<BitVec(64)> → List<BitVec(64)>) → Type {
    match ps {
        Nil => λ v ans => ans(Nil) = Ty::result_words(tys, r, v),
        Cons(p, rest) => λ v ans => p.Takes(tys, λ ws a => Ty::AnswersWords(tys, rest, r, v(a), λ more => ans(ws ++ more))),
    }
}

// What a contract's parameter gives at each words-and-value, something
// weaker.
theorem Ty::takes_map(tys: Table, p: Ty): (K, L: List<BitVec(64)> → p.sem(tys) → Type) →
    ((ws: List<BitVec(64)>) → (a: p.sem(tys)) → K(ws, a) → L(ws, a)) → p.Takes(tys, K) → p.Takes(tys, L) {
    match p {
        Word(w) => λ K L f t x => f([x], Ty::cast(tys, Word(64), Word(w), x), t(x)),
        Bit => λ K L f t x => f([x], Ty::cast(tys, Word(64), Bit, x), t(x)),
        ByteList(n) => λ K L f t x => f([x], Ty::cast(tys, Word(64), ByteList(n), x), t(x)),
        Lines => λ K L f t x => f([x], Ty::cast(tys, Word(64), Lines, x), t(x)),
        Named(i) => λ K L f t => Ty::fields_map(tys.fields(i), λ (ws: List<BitVec(64)>) => K(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws))), λ (ws: List<BitVec(64)>) => L(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws))), λ (ws: List<BitVec(64)>) => f(ws, tys.mk(i, Ty::flats_of_words(tys.fields(i), ws))), t),
        Count => λ K L f t x => f([x], Ty::cast(tys, Word(64), Count, x), t(x)),
        Enum(i) => λ K L f t v => f(RecInfo::enum_words(tys, i, v), v, t(v)),
    }
}

// The first word of every word answered.
theorem Ty::answers_words_first(tys: Table, ps: List<Ty>, r: Ty): (v: Ty::Arrows(tys, ps, r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) →
    Ty::AnswersWords(tys, ps, r, v, ans) → Ty::Answers(tys, ps, r, v, λ ws => first_word(ans(ws))) {
    match ps {
        Nil => λ v ans h => cong_fn(first_word, h),
        Cons(p, rest) => λ v ans => Ty::takes_map(tys, p,
            λ ws a => Ty::AnswersWords(tys, rest, r, v(a), λ more => ans(ws ++ more)),
            λ ws a => Ty::Answers(tys, rest, r, v(a), λ more => first_word(ans(ws ++ more))),
            λ ws a inner => Ty::answers_words_first(tys, rest, r, v(a), λ more => ans(ws ++ more), inner)),
    }
}

// A code held in one 64-bit word (`Ty::OneWord`) has no words past its
// first.
theorem Ty::flats_words_nil(fs: List<Ty>): fs = Nil → (t: Ty::Flats(fs)) → Ty::flats_words(fs, t) = Nil {
    match fs { Nil => λ _ t => refl, Cons(f, rest) => λ e => false_elim(List::cons_ne_nil(rest, f, e)) }
}

theorem Ty::fields_word_rest(fs: List<Ty>): fs = [Word(64)] → (t: Ty::Flats(fs)) → Ty::flats_tail_words(fs, t) = Nil {
    match fs {
        Nil => λ e => false_elim(List::nil_ne_cons(Nil, Word(64), e)),
        Cons(f, rest) => λ e t => Ty::flats_words_nil(rest, cong_fn(λ (xs: List<Ty>) => xs.tail(), e), t.snd),
    }
}

theorem Ty::one_word_rest(tys: Table, t: Ty): t.OneWord(tys) → (v: t.sem(tys)) → Ty::rest_words(tys, t, v) = Nil {
    match t {
        Word(_) => λ _ v => refl, Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never), Named(i) => λ e v => Ty::fields_word_rest(tys.fields(i), tys.word_leaves(i, e), tys.get(i, v)),
        Count => λ never => false_elim(never), Enum(_) => λ never => false_elim(never),
    }
}

// A function returning one word (its code has no words past the first)
// answers every word where it answers its first, at a code held in one.
theorem Ty::answers_words_of_one(tys: Table, ps: List<Ty>, r: Ty, one: r.OneWord(tys)): (v: Ty::Arrows(tys, ps, r)) →
    (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::Answers(tys, ps, r, v, λ ws => first_word(ans(ws))) →
    ((ws: List<BitVec(64)>) → ans(ws) = [first_word(ans(ws))]) → Ty::AnswersWords(tys, ps, r, v, ans) {
    match ps {
        Nil => λ v ans first single => trans(single(Nil), trans(cong_fn(λ (x: BitVec(64)) => [x], first),
            cong_fn(λ (rest: List<BitVec(64)>) => Cons(Ty::cast(tys, r, Word(64), v), rest), sym(Ty::one_word_rest(tys, r, one, v))))),
        Cons(p, rest) => λ v ans first single => Ty::takes_map(tys, p,
            λ ws a => Ty::Answers(tys, rest, r, v(a), λ more => first_word(ans(ws ++ more))),
            λ ws a => Ty::AnswersWords(tys, rest, r, v(a), λ more => ans(ws ++ more)),
            λ ws a inner => Ty::answers_words_of_one(tys, rest, r, one, v(a), λ more => ans(ws ++ more), inner, λ more => single(ws ++ more)), first),
    }
}

// At a code a call passes in one word (`Ty::Held`), a contract's parameter
// holds at the word the caller's port holds, where the code admits it (an
// enum's tag word names a constructor without fields).
theorem Ty::bare_flats_words(fs: List<Ty>): Ty::Bare(fs) → (t: Ty::Flats(fs)) → Ty::flats_words(fs, t) = Nil {
    match fs { Nil => λ _ t => refl, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::takes_held(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Held(tys) → p.Takes(tys, K) →
    (x: BitVec(64)) → p.Admits(tys, x) → K([x], Ty::cast(tys, Word(64), p, x)) {
    match p {
        Word(_) => λ K _ t x _ => t(x), Bit => λ K _ t x _ => t(x), ByteList(_) => λ K _ t x _ => t(x), Lines => λ K _ t x _ => t(x),
        Named(i) => λ K e t x _ => Ty::fields_one_to(tys.recs(i).T, tys.fields(i), λ t => tys.mk(i, t), tys.word_leaves(i, e), K, t, x), Count => λ K _ t x _ => t(x),
        Enum(i) => λ K held t x adm => {
            let e = tys.ens(i);
            let d = Ty::flats_default(e.slots);
            let tag: (e.tag(e.read(x)) = x.toNat()) = trans(e.tag_of(x.toNat().min(e.last), Nat::min_le_r(x.toNat(), e.last), d), Nat::min_eq_l(x.toNat(), e.last, adm));
            let word: (RecInfo::enum_word(tys, i, e.read(x)) = x) = trans(cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := 64), tag), BitVec::ofNat_toNat(64, x));
            let words: (RecInfo::enum_words(tys, i, e.read(x)) = [x]) =
                trans(cong_fn(λ (a: BitVec(64)) => Cons(a, RecInfo::enum_rest(tys, i, e.read(x))), word),
                    cong_fn(λ (r: List<BitVec(64)>) => Cons(x, r), Ty::bare_flats_words(e.slots, held.right, e.fields(e.read(x)))));
            j(words, λ ws _ => K(ws, e.read(x)), t(e.read(x)))
        },
    }
}

// The converse at a code a call passes in one word: what holds at every
// word read at the code holds of every value the contract takes, an
// enum's tag word reading back as its value (`EnumInfo::read_tag`).
theorem Ty::takes_held_intro(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Held(tys) →
    ((x: BitVec(64)) → K([x], Ty::cast(tys, Word(64), p, x))) → p.Takes(tys, K) {
    match p {
        Word(_) => λ K _ h => h, Bit => λ K _ h => h, ByteList(_) => λ K _ h => h, Lines => λ K _ h => h,
        Named(i) => λ K e h => Ty::fields_one_from(tys.recs(i).T, tys.fields(i), λ t => tys.mk(i, t), tys.word_leaves(i, e), K, h), Count => λ K _ h => h,
        Enum(i) => λ K held h v => {
            let e = tys.ens(i);
            let x = RecInfo::enum_word(tys, i, v);
            let back: (e.read(x) = v) = e.read_tag(v, held.left, Ty::bare_default(e.slots, held.right, e.fields(v)));
            let words: ([x] = RecInfo::enum_words(tys, i, v)) =
                cong_fn(λ (r: List<BitVec(64)>) => Cons(x, r), sym(Ty::bare_flats_words(e.slots, held.right, e.fields(v))));
            j(back, λ u _ => K(RecInfo::enum_words(tys, i, v), u), j(words, λ ws _ => K(ws, e.read(x)), h(x)))
        },
    }
}

// A code a call passes in one word is one word, read as the code reads
// a word.
theorem Ty::bare_flats_of(fs: List<Ty>): Ty::Bare(fs) → (ws: List<BitVec(64)>) → Ty::flats_of_words(fs, ws) = Ty::flats_default(fs) {
    match fs { Nil => λ _ ws => refl, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::bare_len(fs: List<Ty>): Ty::Bare(fs) → fs.len() = 0 {
    match fs { Nil => λ _ => refl, Cons(_, _) => λ never => false_elim(never) }
}

theorem Ty::held_words(tys: Table, p: Ty): p.Held(tys) → (x: BitVec(64)) → (ws: List<BitVec(64)>) →
    (Ty::read_words(p, tys, Cons(x, ws)) = Ty::cast(tys, Word(64), p, x)) ∧ (Ty::skip(p.span(tys), Cons(x, ws)) = ws) {
    match p {
        Word(_) => λ _ x ws => ⟨refl, refl⟩, Bit => λ _ x ws => ⟨refl, refl⟩, ByteList(_) => λ _ x ws => ⟨refl, refl⟩, Lines => λ _ x ws => ⟨refl, refl⟩,
        Named(i) => λ e x ws => ⟨cong_fn(λ (t: Ty::Flats(tys.fields(i))) => tys.mk(i, t), Ty::fields_one_read(tys.fields(i), tys.word_leaves(i, e), x, ws)),
            j(sym(cong_fn(λ (fs: List<Ty>) => fs.len(), tys.word_leaves(i, e))), λ n _ => Ty::skip(n, Cons(x, ws)) = ws, refl)⟩,
        Count => λ _ x ws => ⟨refl, refl⟩,
        Enum(i) => λ held x ws => ⟨cong_fn(λ (t: Ty::Flats(tys.ens(i).slots)) => tys.ens(i).of(x.toNat().min(tys.ens(i).last), t),
                Ty::bare_flats_of(tys.ens(i).slots, held.right, ws)),
            j(sym(Ty::bare_len(tys.ens(i).slots, held.right)), λ n _ => Ty::skip(n + 1, Cons(x, ws)) = ws, refl)⟩,
    }
}

theorem Ty::held_span(tys: Table, p: Ty): p.Held(tys) → p.span(tys) = 1 {
    match p {
        Word(_) => λ _ => refl, Bit => λ _ => refl, ByteList(_) => λ _ => refl, Lines => λ _ => refl,
        Named(i) => λ e => cong_fn(λ (fs: List<Ty>) => fs.len(), tys.word_leaves(i, e)), Count => λ _ => refl,
        Enum(i) => λ held => cong_fn(λ (n: Nat) => n + 1, Ty::bare_len(tys.ens(i).slots, held.right)),
    }
}

theorem Ty::helds_spans(tys: Table, ps: List<Ty>): Ty::Helds(tys, ps) → Ty::spans(tys, ps) = ps.len() {
    match ps {
        Nil => λ _ => refl,
        Cons(p, rest) => λ ok => trans(cong_fn(λ (n: Nat) => Ty::spans(tys, rest) + n, Ty::held_span(tys, p, ok.left)),
            cong_fn(λ (n: Nat) => n + 1, Ty::helds_spans(tys, rest, ok.right))),
    }
}

theorem Ty::one_word_held(tys: Table, p: Ty): p.OneWord(tys) → p.Held(tys) {
    match p {
        Word(_) => λ e => e, Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(_) => λ e => e, Count => λ never => false_elim(never), Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::one_words_helds(tys: Table, ps: List<Ty>): Ty::OneWords(tys, ps) → Ty::Helds(tys, ps) {
    match ps {
        Nil => λ _ => trivial,
        Cons(p, rest) => λ ok => ⟨Ty::one_word_held(tys, p, ok.left), Ty::one_words_helds(tys, rest, ok.right)⟩,
    }
}

// At a code held in one 64-bit word (`Ty::OneWord`, never an enum), a
// contract's parameter is any word.
theorem Ty::takes_one(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.OneWord(tys) →
    ((x: BitVec(64)) → K([x], Ty::cast(tys, Word(64), p, x))) → p.Takes(tys, K) {
    match p {
        Word(_) => λ K _ h => h, Bit => λ K never => false_elim(never), ByteList(_) => λ K never => false_elim(never),
        Lines => λ K never => false_elim(never), Named(i) => λ K e h => Ty::fields_one_from(tys.recs(i).T, tys.fields(i), λ t => tys.mk(i, t), tys.word_leaves(i, e), K, h), Count => λ K never => false_elim(never),
        Enum(_) => λ K never => false_elim(never),
    }
}

// A code held in one word across a call passes as it is: an enum's tags
// fit a word, and it has no slots.
theorem Ty::held_passes(tys: Table, p: Ty): p.Held(tys) → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial,
        Enum(i) => λ held => ⟨held.left, Ty::words_slots(tys.ens(i).slots, Ty::bare_words(tys.ens(i).slots, held.right))⟩,
    }
}

theorem Ty::helds_pass(tys: Table, ps: List<Ty>): Ty::Helds(tys, ps) → Ty::PassesAll(tys, ps) {
    match ps { Nil => λ _ => trivial, Cons(p, rest) => λ ok => ⟨Ty::held_passes(tys, p, ok.left), Ty::helds_pass(tys, rest, ok.right)⟩ }
}

theorem Ty::one_word_passes(tys: Table, p: Ty): p.OneWord(tys) → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(_) => λ never => false_elim(never),
    }
}

// ---------------------------------------------------------------------------
// Calls of several words (docs/native/runtime-fn-setups-design.md §16.17).
// A call passes each argument in its code's words, as a function takes
// them (`Ty::ids`: an enum's tag word, then a word a slot), and reads its
// result back in the callee's words (`Ty::result_words`), the first at
// the port the value is held at and the rest at the ports after it
// (`Ty::also_ports`).

// A 64-bit word read at a narrower word is its low bits.
theorem Ty::cast_narrow_in(tys: Table, w: Nat, ne: w ≠ 64, x: BitVec(64)): Ty::cast(tys, Word(64), Word(w), x) = BitVec::ofNat(x.toNat()) {
    let converted: (Ty::cast(tys, Word(64), Word(w), x) = Ty::convert(tys, Word(64), Word(w), x)) =
        j(sym(Or::inr_apart(Word(64).equation(Word(w)), λ e => ne(sym(cong_fn(Ty::width, e))))), λ d _ =>
            (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => y.sem(tys), x), Inr(_) => Ty::convert(tys, Word(64), Word(w), x) }) =
                Ty::convert(tys, Word(64), Word(w), x),
            refl);
    let truncated: (Ty::convert(tys, Word(64), Word(w), x) = BitVec::ofNat(x.toNat())) =
        j(sym(Or::inr_apart(Nat::equation(64, w), λ e => ne(sym(e)))), λ d _ =>
            (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => BitVec(y), x), Inr(_) => BitVec::ofNat(x.toNat()) }) = BitVec::ofNat(x.toNat()),
            refl);
    trans(converted, truncated)
}

// A narrow word read as a 64-bit word is its zero extension.
theorem Ty::cast_narrow_out(tys: Table, w: Nat, ne: w ≠ 64, v: BitVec(w)): Ty::cast(tys, Word(w), Word(64), v) = BitVec::ofNat(v.toNat()) {
    let converted: (Ty::cast(tys, Word(w), Word(64), v) = Ty::convert(tys, Word(w), Word(64), v)) =
        j(sym(Or::inr_apart(Word(w).equation(Word(64)), λ e => ne(cong_fn(Ty::width, e)))), λ d _ =>
            (match d as λ _ => BitVec(64) { Inl(e) => j(e, λ y _ => y.sem(tys), v), Inr(_) => Ty::convert(tys, Word(w), Word(64), v) }) =
                Ty::convert(tys, Word(w), Word(64), v),
            refl);
    let extended: (Ty::convert(tys, Word(w), Word(64), v) = BitVec::ofNat(v.toNat())) =
        j(sym(Or::inr_apart(w.equation(64), ne)), λ d _ =>
            (match d as λ _ => BitVec(64) { Inl(e) => j(e, λ y _ => BitVec(y), v), Inr(_) => BitVec::ofNat(v.toNat()) }) = BitVec::ofNat(v.toNat()),
            refl);
    trans(converted, extended)
}

// A bit's word, zero or one, read back at one bit is the bit.
theorem Ty::bit_back(v: Bool): word_value(BitVec::ofNat(BitVec::ofBool(v).toNat(), n := 64), 1) = BitVec::ofBool(v) {
    match v { False => refl, True => refl }
}

// A slot's port bound to its word, as binding a word binds it at every
// width (`word_value`), holds the slot.
theorem Ty::slot_bound(f: Ty): f.Slot() → (values: Valuation()) → (port: Nat) → ((wd: Nat) → values(wd, port) = word_value(values(64, port), wd)) →
    (v: f.Flat()) → values(64, port) = f.flat_word(EnumInfo::nones, v) → f.FlatHolds(values, port, v) {
    match f {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (values: Valuation()) → (port: Nat) → ((wd: Nat) → values(wd, port) = word_value(values(64, port), wd)) →
                (v: Word(y).Flat()) → values(64, port) = Word(y).flat_word(EnumInfo::nones, v) → Word(y).FlatHolds(values, port, v), λ values port bound v h => h),
            Inr(lt) => λ values port bound v h => {
                let ne = Nat::ne_of_lt(w, 64, lt);
                let word: (values(64, port) = BitVec::ofNat(v.toNat())) = trans(h, Ty::narrow_flat_word(w, ne, v));
                trans(bound(w), trans(Ty::narrow_word_at(w, ne, values(64, port)), trans(cong_fn(λ (y: BitVec(64)) => BitVec::ofNat(y.toNat(), n := w), word),
                    trans(cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := w), BitVec::toNat_ofNat(64, v.toNat(), Ty::narrow_small(w, lt, v))), BitVec::ofNat_toNat(w, v)))))
            },
        },
        Bit => λ _ values port bound v h => trans(bound(1), trans(cong_fn(λ (x: BitVec(64)) => word_value(x, 1), h), Ty::bit_back(v))),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A slot's port zero-extended into a word holds the slot's word.
theorem Ty::slot_widened(f: Ty): f.Slot() → (values: Valuation()) → (port: Nat) → (v: f.Flat()) → f.FlatHolds(values, port, v) →
    BitVec::ofNat(values(f.width(), port).toNat(), n := 64) = f.flat_word(EnumInfo::nones, v) {
    match f {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (values: Valuation()) → (port: Nat) → (v: Word(y).Flat()) → Word(y).FlatHolds(values, port, v) →
                BitVec::ofNat(values(Word(y).width(), port).toNat(), n := 64) = Word(y).flat_word(EnumInfo::nones, v),
                λ values port v h => trans(BitVec::ofNat_toNat(64, values(64, port)), h)),
            Inr(lt) => λ values port v h => trans(cong_fn(λ (y: BitVec(w)) => BitVec::ofNat(y.toNat(), n := 64), h), sym(Ty::narrow_flat_word(w, Nat::ne_of_lt(w, 64, lt), v))),
        },
        Bit => λ _ values port v h => cong_fn(λ (y: BitVec(1)) => BitVec::ofNat(y.toNat(), n := 64), h),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A word's low bits at a slot's port (what `Resize` from the word writes)
// hold the word read at the slot.
theorem Ty::slot_narrowed(f: Ty): f.Slot() → (values: Valuation()) → (port: Nat) → (x: BitVec(64)) →
    values(f.width(), port) = BitVec::ofNat(x.toNat()) → f.FlatHolds(values, port, f.word_at(x, EnumInfo::nones)) {
    match f {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (values: Valuation()) → (port: Nat) → (x: BitVec(64)) →
                values(Word(y).width(), port) = BitVec::ofNat(x.toNat()) → Word(y).FlatHolds(values, port, Word(y).word_at(x, EnumInfo::nones)),
                λ values port x h => trans(h, BitVec::ofNat_toNat(64, x))),
            Inr(lt) => λ values port x h => trans(h, sym(Ty::narrow_word_at(w, Nat::ne_of_lt(w, 64, lt), x))),
        },
        Bit => λ _ values port x h => trans(h, BitVec::one_bit_eq_ofBool(BitVec::ofNat(x.toNat(), n := 1))),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// Ports bound to slots' words hold the slots.
fn Ty::BoundAt(values: Valuation(), ids: List<Nat>) → Type {
    match ids { Nil => True, Cons(id, rest) => ((wd: Nat) → values(wd, id) = word_value(values(64, id), wd)) ∧ Ty::BoundAt(values, rest) }
}

theorem Ty::slots_bound(values: Valuation(), fs: List<Ty>): (port: Nat) → Ty::Slots(fs) → Ty::BoundAt(values, Ty::ports_from(fs, port)) → (t: Ty::Flats(fs)) →
    words_of(values, Ty::ports_from(fs, port)) = Ty::flats_words(fs, t) → Ty::FieldsHold(fs, values, port, t) {
    match fs {
        Nil => λ port _ _ t _ => trivial,
        Cons(f, rest) => λ port ok bound t h => {
            let parts = words_cons_parts(values(64, port), words_of(values, Ty::ports_from(rest, port + 1)),
                Cons(f.flat_word(EnumInfo::nones, t.fst), Ty::flats_words(rest, t.snd)), h);
            ⟨Ty::slot_bound(f, ok.left, values, port, bound.left, t.fst, parts.left), Ty::slots_bound(values, rest, port + 1, ok.right, bound.right, t.snd, parts.right)⟩
        },
    }
}

theorem Ty::bound_at_frame(values, after: Valuation(), ids: List<Nat>): ((x: Nat) → Mem(x, ids) → (wd: Nat) → after(wd, x) = values(wd, x)) →
    Ty::BoundAt(values, ids) → Ty::BoundAt(after, ids) {
    match ids {
        Nil => λ _ _ => trivial,
        Cons(id, rest) => λ same b => ⟨λ wd => trans(same(id, Inl(refl), wd), trans(b.left(wd), cong_fn(λ (y: BitVec(64)) => word_value(y, wd), sym(same(id, Inl(refl), 64))))),
            Ty::bound_at_frame(values, after, rest, λ x m => same(x, Inr(m)), b.right)⟩,
    }
}

// Binding words binds each id at every width.
theorem Ty::bind_bound(values: Valuation(), ids: List<Nat>): distinct(ids).IsTrue() → (words: List<BitVec(64)>) → ids.len() = words.len() →
    Ty::BoundAt(Valuation::bind(values, ids, words), ids) {
    match ids {
        Nil => λ _ words _ => trivial,
        Cons(id, rest) => λ apart words => match words {
            Nil => λ (bad: rest.len() + 1 = 0) => false_elim(rest.len().succ_ne_zero(bad)),
            Cons(word, more) => λ (same: rest.len() + 1 = more.len() + 1) => {
                let parts = Bool::is_true_and(absent(id, rest), distinct(rest), apart);
                let inner = Valuation::bind(values, rest, more);
                let after = Valuation::set(inner, id, word_value(word));
                let here = λ (wd: Nat) => trans(Valuation::set_here(inner, id, word_value(word), wd),
                    cong_fn(λ (x: BitVec(64)) => word_value(x, wd), sym(Valuation::set_here(inner, id, word_value(word), 64))));
                let others: Ty::BoundAt(after, rest) = Ty::bound_at_frame(inner, after, rest, λ x m wd =>
                    Valuation::set_other(inner, id, word_value(word), wd, x, λ e => absent_mem(id, rest, parts.left, x, m, sym(e))),
                    Ty::bind_bound(values, rest, parts.right, more, Nat::succ_inj(rest.len(), more.len(), same)));
                ⟨here, others⟩
            },
        },
    }
}

// A code a call passes: one held in a word (`Ty::Held`), or an enum whose
// tags fit a word and whose payload's slots are 64-bit words, in its tag
// word and then a word a slot.
fn Ty::Sent(self p: Ty, tys: Table) → Type {
    match p {
        Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => Ty::Words(tys.fields(i)), Count => True,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Words(tys.ens(i).slots),
    }
}

fn Ty::check_sent(self p: Ty, tys: Table) → Option<p.Sent(tys)> {
    match p as λ x => Option<x.Sent(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None, ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_words(tys.fields(i)),
        Count => Some(trivial),
        Enum(i) => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Words(tys.ens(i).slots)> {
            False => None,
            True => Ty::check_words(tys.ens(i).slots).and_then(λ ws => Some(⟨refl, ws⟩)),
        },
    }
}

// A code a call passes slot by slot (`Ty::pieces`), each in a word of its
// own: a narrow word or a bit on its own, or a record or an enum whose
// fields or slots are words of at most 64 bits or bits (design §16.18).
// A narrow slot is zero-extended before the call, as the callee reads its
// low bits back.
fn Ty::pieces(self p: Ty, tys: Table) → List<Ty> {
    match p { Word(w) => [Word(w)], Bit => [Bit], ByteList(_) => Nil, Lines => Nil, Named(i) => tys.fields(i), Count => Nil, Enum(i) => Cons(Word(64), tys.ens(i).slots) }
}

fn Ty::Sliced(self p: Ty, tys: Table) → Type {
    match p {
        Word(w) => w < 64, Bit => True, ByteList(_) => False, Lines => False, Named(i) => Ty::Slots(tys.fields(i)), Count => False,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Slots(tys.ens(i).slots),
    }
}

// Sliced where it needs to be: a narrow word or a bit, or a record or an
// enum with a narrow slot (one of 64-bit words is passed whole).
fn Ty::check_sliced(self p: Ty, tys: Table) → Option<p.Sliced(tys)> {
    match p as λ x => Option<x.Sliced(tys)> {
        Word(w) => match Ty::check_narrow(w) { None => None, Some(o) => match o { Inl(_) => None, Inr(lt) => Some(lt) } },
        Bit => Some(trivial), ByteList(_) => None, Lines => None,
        Named(i) => match Ty::slots_narrow(tys.fields(i)) { False => None, True => Ty::check_slots(tys.fields(i)) },
        Count => None,
        Enum(i) => match Ty::slots_narrow(tys.ens(i).slots) {
            False => None,
            True => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Slots(tys.ens(i).slots)> {
                False => None,
                True => Ty::check_slots(tys.ens(i).slots).and_then(λ ok => Some(⟨refl, ok⟩)),
            },
        },
    }
}

// A sliced code's pieces are slots.
theorem Ty::sliced_slots(tys: Table, p: Ty): p.Sliced(tys) → Ty::Slots(p.pieces(tys)) {
    match p {
        Word(w) => λ lt => ⟨Inr(lt), trivial⟩,
        Bit => λ _ => ⟨trivial, trivial⟩,
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok => ok,
        Count => λ never => false_elim(never),
        Enum(i) => λ ok => ⟨Inl(refl), ok.right⟩,
    }
}

// A code a call can pass: in its own words (`Ty::Sent`), or a slot at a
// time, its narrow slots widened first (`Ty::Sliced`).
fn Ty::Sendable(self p: Ty, tys: Table) → Type { p.Sent(tys) ∨ p.Sliced(tys) }

fn Ty::check_sendable(self p: Ty, tys: Table) → Option<p.Sendable(tys)> {
    match p.check_sliced(tys) { Some(n) => Some(Inr(n)), None => p.check_sent(tys).and_then(λ e => Some(Inl(e))) }
}

fn Ty::Sents(tys: Table, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Sendable(tys) ∧ Ty::Sents(tys, rest) }
}

fn Ty::check_sents(tys: Table, ps: List<Ty>) → Option<Ty::Sents(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_sendable(tys).and_then(λ e => Ty::check_sents(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

theorem Ty::sent_passes(tys: Table, p: Ty): p.Sent(tys) → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(i) => λ ok => ⟨ok.left, Ty::words_slots(tys.ens(i).slots, ok.right)⟩,
    }
}

theorem Ty::sliced_passes(tys: Table, p: Ty): p.Sliced(tys) → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(_) => λ _ => trivial, Count => λ never => false_elim(never), Enum(_) => λ ok => ok,
    }
}

theorem Ty::sendable_passes(tys: Table, p: Ty, ok: p.Sendable(tys)): p.Passes(tys) {
    match ok { Inl(e) => Ty::sent_passes(tys, p, e), Inr(n) => Ty::sliced_passes(tys, p, n) }
}

theorem Ty::sents_pass(tys: Table, ps: List<Ty>): Ty::Sents(tys, ps) → Ty::PassesAll(tys, ps) {
    match ps { Nil => λ _ => trivial, Cons(p, rest) => λ ok => ⟨Ty::sendable_passes(tys, p, ok.left), Ty::sents_pass(tys, rest, ok.right)⟩ }
}

// A code held in one word is sent in it.
theorem Ty::held_sent(tys: Table, p: Ty): p.Held(tys) → p.Sent(tys) {
    match p {
        Word(_) => λ e => e, Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(i) => λ e => j(sym(tys.word_leaves(i, e)), λ g _ => Ty::Words(g), ⟨refl, trivial⟩), Count => λ _ => trivial,
        Enum(i) => λ held => ⟨held.left, Ty::bare_words(tys.ens(i).slots, held.right)⟩,
    }
}

theorem Ty::helds_sents(tys: Table, ps: List<Ty>): Ty::Helds(tys, ps) → Ty::Sents(tys, ps) {
    match ps { Nil => λ _ => trivial, Cons(p, rest) => λ ok => ⟨Inl(Ty::held_sent(tys, p, ok.left)), Ty::helds_sents(tys, rest, ok.right)⟩ }
}

// A contract's parameter at the words a caller's ports hold for a value
// is the value itself: a code held in one word is its word read back, an
// enum its tag word and then its slots (`RecInfo::enum_words`).
theorem Ty::takes_holds(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Sent(tys) → p.Takes(tys, K) →
    (values: Valuation()) → (port: Nat) → (v: p.sem(tys)) → p.Holds(tys, values, port, v) → K(words_of(values, p.ids(tys, port)), v) {
    match p {
        Word(w) => λ K (e: w = 64) t values port v h => {
            let read = j(sym(e), λ x _ => (u: BitVec(x)) → values(x, port) = u → Ty::cast(tys, Word(64), Word(x), values(64, port)) = u,
                λ u held => trans(Ty::cast_self(tys, Word(64), values(64, port)), held))(v, h);
            j(read, λ u _ => K([values(64, port)], u), t(values(64, port)))
        },
        Bit => λ K never => false_elim(never),
        ByteList(_) => λ K never => false_elim(never),
        Lines => λ K never => false_elim(never),
        Named(i) => λ K ok t values port v h => {
            let fs = tys.fields(i);
            let ws = Ty::flats_words(fs, tys.get(i, v));
            let reads: (words_of(values, Ty::ports_from(fs, port)) = ws) = Ty::ports_reads(values, fs, port, ok, tys.get(i, v), h);
            let at = j(reads, λ ys _ => K(Ty::first(fs.len(), ys), tys.mk(i, Ty::flats_of_words(fs, ys))),
                Ty::takes_at(tys, Named(i), K, t, words_of(values, Ty::ports_from(fs, port)), trivial));
            let firsts: (Ty::first(fs.len(), ws) = ws) = j(Ty::flats_words_len(fs, tys.get(i, v)), λ n _ => Ty::first(n, ws) = ws, Ty::first_all(ws));
            let value: (tys.mk(i, Ty::flats_of_words(fs, ws)) = v) = trans(cong_fn(λ (t: Ty::Flats(tys.fields(i))) => tys.mk(i, t),
                trans(cong_fn(λ (ys: List<BitVec(64)>) => Ty::flats_of_words(fs, ys), sym(ws.append_nil())), Ty::flats_round(fs, ok, tys.get(i, v), Nil))),
                tys.back(i, v));
            j(sym(reads), λ ys _ => K(ys, v), j(value, λ u _ => K(ws, u), j(firsts, λ ys _ => K(ys, tys.mk(i, Ty::flats_of_words(fs, ws))), at)))
        },
        Count => λ K _ t values port v h => j(h, λ u _ => K([values(64, port)], u), t(values(64, port))),
        Enum(i) => λ K ok t values port v h => {
            let e = tys.ens(i);
            let x = values(64, port);
            let head: (x = RecInfo::enum_word(tys, i, v)) = trans(sym(BitVec::ofNat_toNat(64, x)), cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := 64), h.left.left));
            let rest: (words_of(values, Ty::ports_from(e.slots, port + 1)) = RecInfo::enum_rest(tys, i, v)) =
                Ty::ports_reads(values, e.slots, port + 1, ok.right, e.fields(v), h.right);
            let words: (words_of(values, Enum(i).ids(tys, port)) = RecInfo::enum_words(tys, i, v)) =
                eq2(λ (a: BitVec(64)) (r: List<BitVec(64)>) => Cons(a, r), head, rest);
            j(sym(words), λ ws _ => K(ws, v), t(v))
        },
    }
}

// A value's pieces, as the fields its pieces hold.
fn Ty::flats_of(self p: Ty, tys: Table) → p.sem(tys) → Ty::Flats(p.pieces(tys)) {
    match p as λ x => x.sem(tys) → Ty::Flats(x.pieces(tys)) {
        Word(w) => λ v => Pair(v, trivial),
        Bit => λ v => Pair(v, trivial),
        ByteList(_) => λ _ => trivial,
        Lines => λ _ => trivial,
        Named(i) => λ v => tys.get(i, v),
        Count => λ _ => trivial,
        Enum(i) => λ v => Pair(RecInfo::enum_word(tys, i, v), tys.ens(i).fields(v)),
    }
}

// A code's ports are its pieces'.
theorem Ty::ids_pieces(tys: Table, p: Ty, q: Nat): p.Sliced(tys) → p.ids(tys, q) = Ty::ports_from(p.pieces(tys), q) {
    match p {
        Word(_) => λ _ => refl, Bit => λ _ => refl,
        ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(i) => λ _ => refl, Count => λ never => false_elim(never),
        Enum(i) => λ _ => refl,
    }
}

// A value held at its port holds its pieces there.
theorem Ty::holds_pieces(tys: Table, p: Ty, values: Valuation(), q: Nat): p.Sliced(tys) → (v: p.sem(tys)) → p.Holds(tys, values, q, v) →
    Ty::FieldsHold(p.pieces(tys), values, q, p.flats_of(tys, v)) {
    match p {
        Word(_) => λ _ v h => ⟨h, trivial⟩,
        Bit => λ _ v h => ⟨h, trivial⟩,
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ _ v h => h,
        Count => λ never => false_elim(never),
        Enum(i) => λ _ v h => ⟨trans(sym(BitVec::ofNat_toNat(64, values(64, q))), cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := 64), h.left.left)), h.right⟩,
    }
}

// A contract's parameter at a sliced value's words is the value: each
// piece read back off its word is itself (`Ty::slot_round`).
theorem Ty::takes_sliced(tys: Table, p: Ty): (K: List<BitVec(64)> → p.sem(tys) → Type) → p.Sliced(tys) → p.Takes(tys, K) →
    (v: p.sem(tys)) → K(Ty::flats_words(p.pieces(tys), p.flats_of(tys, v)), v) {
    match p {
        Word(w) => λ K (lt: w < 64) t v => {
            let ne = Nat::ne_of_lt(w, 64, lt);
            let x = Word(w).flat_word(EnumInfo::nones, v);
            let back: (Ty::cast(tys, Word(64), Word(w), x) = v) =
                trans(Ty::cast_narrow_in(tys, w, ne, x), trans(sym(Ty::narrow_word_at(w, ne, x)), Ty::slot_round(Word(w), Inr(lt), v)));
            j(back, λ u _ => K([x], u), t(x))
        },
        Bit => λ K _ t v => {
            let x = Bit.flat_word(EnumInfo::nones, v);
            let back: (Ty::cast(tys, Word(64), Bit, x) = v) = match v { False => refl, True => refl };
            j(back, λ u _ => K([x], u), t(x))
        },
        ByteList(_) => λ K never => false_elim(never),
        Lines => λ K never => false_elim(never),
        Named(i) => λ K ok t v => {
            let fs = tys.fields(i);
            let ws = Ty::flats_words(fs, tys.get(i, v));
            let at = Ty::takes_at(tys, Named(i), K, t, ws, trivial);
            let firsts: (Ty::first(fs.len(), ws) = ws) = j(Ty::flats_words_len(fs, tys.get(i, v)), λ n _ => Ty::first(n, ws) = ws, Ty::first_all(ws));
            let value: (tys.mk(i, Ty::flats_of_words(fs, ws)) = v) = trans(cong_fn(λ (t: Ty::Flats(tys.fields(i))) => tys.mk(i, t),
                trans(cong_fn(λ (ys: List<BitVec(64)>) => Ty::flats_of_words(fs, ys), sym(ws.append_nil())), Ty::slots_round(fs, ok, tys.get(i, v), Nil))),
                tys.back(i, v));
            j(value, λ u _ => K(ws, u), j(firsts, λ ys _ => K(ys, tys.mk(i, Ty::flats_of_words(fs, ws))), at))
        },
        Count => λ K never => false_elim(never),
        Enum(i) => λ K _ t v => t(v),
    }
}

theorem words_of_append(values: Valuation(), xs, ys: List<Nat>): words_of(values, xs ++ ys) = words_of(values, xs) ++ words_of(values, ys) {
    match xs { Nil => refl, Cons(x, rest) => cong_fn(λ (l: List<BitVec(64)>) => Cons(values(64, x), l), words_of_append(values, rest, ys)) }
}

// A code a call reads back in its words (`Ty::result_words`), each at the
// port the value holds it at: a 64-bit word, a record of 64-bit words, or
// an enum whose tags fit a word and whose payload's slots are 64-bit
// words.
fn Ty::Back(self t: Ty, tys: Table) → Type {
    match t {
        Word(w) => (w = 64) ∨ (w < 64), Bit => True, ByteList(_) => False, Lines => False, Named(i) => Ty::Slots(tys.fields(i)), Count => False,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Slots(tys.ens(i).slots),
    }
}

fn Ty::check_back(self t: Ty, tys: Table) → Option<t.Back(tys)> {
    match t as λ x => Option<x.Back(tys)> {
        Word(w) => Ty::check_narrow(w),
        Bit => Some(trivial), ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_slots(tys.fields(i)),
        Count => None,
        Enum(i) => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Slots(tys.ens(i).slots)> {
            False => None,
            True => Ty::check_slots(tys.ens(i).slots).and_then(λ ws => Some(⟨refl, ws⟩)),
        },
    }
}

// A code returned in one word is read back in it.
theorem Ty::returned_back(tys: Table, t: Ty): t.Returned(tys) → t.Back(tys) {
    match t {
        Word(_) => λ e => Inl(e), Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(i) => λ e => j(sym(tys.word_leaves(i, e)), λ g _ => Ty::Slots(g), ⟨Inl(refl), trivial⟩),
        Count => λ never => false_elim(never),
        Enum(i) => λ ok => ⟨ok.left, Ty::words_slots(tys.ens(i).slots, Ty::bare_words(tys.ens(i).slots, ok.right))⟩,
    }
}

// The ports past a value's first are above it.
theorem Ty::ports_from_above(fs: List<Ty>): (port, id: Nat) → Mem(id, Ty::ports_from(fs, port)) → port <= id {
    match fs {
        Nil => λ port id never => false_elim(never),
        Cons(_, rest) => λ port id mem => match mem {
            Inl(e) => j(sym(e), λ y _ => port <= y, port.le_refl()),
            Inr(later) => Nat::le_trans(port, port + 1, id, Nat::le_succ_r(port, port, port.le_refl()), Ty::ports_from_above(rest, port + 1, id, later)),
        },
    }
}

theorem Ty::fields_also_above(fs: List<Ty>, port, id: Nat): Mem(id, Ty::fields_also_ports(fs, port)) → port < id {
    match fs { Nil => λ never => false_elim(never), Cons(_, rest) => λ mem => Ty::ports_from_above(rest, port + 1, id, mem) }
}

theorem Ty::also_above(tys: Table, t: Ty, port, id: Nat): Mem(id, t.also_ports(tys, port)) → port < id {
    match t {
        Word(_) => λ never => false_elim(never), Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never), Count => λ never => false_elim(never),
        Named(i) => Ty::fields_also_above(tys.fields(i), port, id),
        Enum(i) => λ mem => Ty::ports_from_above(tys.ens(i).slots, port + 1, id, mem),
    }
}

// A value's ports are as many as its words.
theorem Ty::fields_also_len(fs: List<Ty>, port: Nat): (t: Ty::Flats(fs)) → Ty::fields_also_ports(fs, port).len() = Ty::flats_tail_words(fs, t).len() {
    match fs {
        Nil => λ t => refl,
        Cons(_, rest) => λ t => trans(Ty::ports_from_len(rest, port + 1), sym(Ty::flats_words_len(rest, t.snd))),
    }
}

theorem Ty::back_len(tys: Table, t: Ty, port: Nat): (v: t.sem(tys)) →
    Cons(port, t.also_ports(tys, port)).len() = Ty::result_words(tys, t, v).len() {
    match t {
        Word(_) => λ v => refl, Bit => λ v => refl, ByteList(_) => λ v => refl, Lines => λ v => refl, Count => λ v => refl,
        Named(i) => λ v => cong_fn(λ (n: Nat) => Succ(n), Ty::fields_also_len(tys.fields(i), port, tys.get(i, v))),
        Enum(i) => λ v => cong_fn(λ (n: Nat) => Succ(n), trans(Ty::ports_from_len(tys.ens(i).slots, port + 1),
            sym(Ty::flats_words_len(tys.ens(i).slots, tys.ens(i).fields(v))))),
    }
}

// Fields whose ports are bound to their words hold there.
theorem Ty::fields_back_holds(values: Valuation(), fs: List<Ty>, port: Nat): Ty::Slots(fs) → Ty::BoundAt(values, Cons(port, Ty::fields_also_ports(fs, port))) →
    (t: Ty::Flats(fs)) → words_of(values, Cons(port, Ty::fields_also_ports(fs, port))) = Cons(Ty::flats_head_word(fs, EnumInfo::nones, t), Ty::flats_tail_words(fs, t)) →
    Ty::FieldsHold(fs, values, port, t) {
    match fs {
        Nil => λ _ _ t _ => trivial,
        Cons(f, rest) => λ ok bound t h => Ty::slots_bound(values, Cons(f, rest), port, ok, bound, t, h),
    }
}

// A value whose ports read its words holds there.

theorem Ty::back_holds(tys: Table, t: Ty, values: Valuation(), port: Nat,
    bound_all: Ty::BoundAt(values, Cons(port, t.also_ports(tys, port)))): t.Back(tys) → (v: t.sem(tys)) →
    words_of(values, Cons(port, t.also_ports(tys, port))) = Ty::result_words(tys, t, v) → t.Holds(tys, values, port, v) {
    let bound = bound_all.left;
    match t {
        Word(w) => λ ok v h => match ok {
            Inl(e) => Ty::returned_holds(tys, values, port, Word(w), e, v, words_cons_parts(values(64, port), Nil, Ty::result_words(tys, Word(w), v), h).left),
            // A narrow word is read back from its zero extension, which
            // binding the word gives its port at its width.
            Inr(lt) => {
                let small: (v.toNat() < Nat::pow(2, 64)) = Nat::lt_of_lt_of_le(v.toNat(), Nat::pow(2, w), Nat::pow(2, 64),
                    BitVec::toNat_lt_pow(w, v), Nat::pow_le_pow_r(2, w, 64, trivial, w.le_of_lt(64, lt)));
                let ne = Nat::ne_of_lt(w, 64, lt);
                let word: (values(64, port) = BitVec::ofNat(v.toNat())) =
                    trans(words_cons_parts(values(64, port), Nil, Ty::result_words(tys, Word(w), v), h).left, Ty::cast_narrow_out(tys, w, ne, v));
                let at_w: (word_value(values(64, port), w) = BitVec::ofNat(values(64, port).toNat())) =
                    j(sym(Or::inr_apart(Nat::equation(64, w), λ e => ne(sym(e)))), λ d _ =>
                        (match d as λ _ => BitVec(w) { Inl(e) => j(e, λ y _ => BitVec(y), values(64, port)), Inr(_) => BitVec::ofNat(values(64, port).toNat()) })
                            = BitVec::ofNat(values(64, port).toNat()),
                        refl);
                trans(bound(w), trans(at_w, trans(cong_fn(λ (y: BitVec(64)) => BitVec::ofNat(y.toNat(), n := w), word),
                    trans(cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := w), BitVec::toNat_ofNat(64, v.toNat(), small)), BitVec::ofNat_toNat(w, v)))))
            },
        },
        // A bit is read back from the word it was returned in (zero or
        // one), which binding the word gives its port at one bit.
        Bit => λ _ v h => trans(bound(1), trans(cong_fn(λ (x: BitVec(64)) => word_value(x, 1),
            words_cons_parts(values(64, port), Nil, Ty::result_words(tys, Bit, v), h).left), Ty::bit_back(v))),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok v h => Ty::fields_back_holds(values, tys.fields(i), port, ok, bound_all, tys.get(i, v), h),
        Count => λ never => false_elim(never),
        Enum(i) => λ ok v h => {
            let e = tys.ens(i);
            let parts = words_cons_parts(values(64, port), words_of(values, Ty::ports_from(e.slots, port + 1)), Ty::result_words(tys, Enum(i), v), h);
            let lt: (e.tag(v) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(v) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(v), e.last, e.bounded(v)),
                Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), ok.left));
            let word: (values(64, port).toNat() = e.tag(v)) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), parts.left), BitVec::toNat_ofNat(64, e.tag(v), lt));
            ⟨⟨word, j(sym(word), λ y _ => y <= e.last, e.bounded(v))⟩, Ty::slots_bound(values, e.slots, port + 1, ok.right, bound_all.right, e.fields(v), parts.right)⟩
        },
    }
}

// A value's ports from `port` are below where it ends, which is past it.
theorem Ty::fields_below_past(fs: List<Ty>): (port: Nat) → Ty::FieldsBelow(fs, port, Ty::fields_past(fs, port)) ∧ (port <= Ty::fields_past(fs, port)) {
    match fs {
        Nil => λ port => ⟨trivial, port.le_refl()⟩,
        Cons(_, rest) => λ port => {
            let inner = Ty::fields_below_past(rest, port + 1);
            ⟨⟨inner.right, inner.left⟩, Nat::le_trans(port, port + 1, Ty::fields_past(rest, port + 1), Nat::le_succ_r(port, port, port.le_refl()), inner.right)⟩
        },
    }
}

theorem Ty::below_past(tys: Table, t: Ty, port: Nat): t.Below(tys, port, t.past(tys, port)) ∧ (port <= t.past(tys, port)) {
    let one: (port < port + 1) ∧ (port <= port + 1) = ⟨port.lt_succ_self(), Nat::le_succ_r(port, port, port.le_refl())⟩;
    match t {
        Word(_) => one, Bit => one, ByteList(_) => one, Lines => one, Count => one,
        Named(i) => Ty::fields_below_past(tys.fields(i), port),
        Enum(i) => Ty::fields_below_past(Cons(Word(64), tys.ens(i).slots), port),
    }
}

// A signature a call passes and reads back in words.
fn Sig::Sends(self s: Sig, tys: Table) → Type { Ty::Sents(tys, s.params) ∧ s.result.Back(tys) }

theorem Sig::words_sends(self s: Sig, tys: Table, ok: s.Words(tys)): s.Sends(tys) {
    ⟨Ty::helds_sents(tys, s.params, ok.left), Ty::returned_back(tys, s.result, ok.right)⟩
}

// Every function of the program a call passes and reads back in words is
// answered by `call` with its meaning, every word of it
// (`Ty::AnswersWords`).
fn Tm::CallsAgree(w: World, call: Answers()) → Type {
    (f: Nat) → Sig::at(w.sigs, f).Sends(w.tys) →
        Ty::AnswersWords(w.tys, Sig::at(w.sigs, f).params, Sig::at(w.sigs, f).result, Sig::get(w.tys, w.sigs, w.callees, f), λ ws => call(f, ws))
}

// A program with no functions has nothing to answer.
theorem Tm::calls_agree_none(tys: Table, call: Answers()): Tm::CallsAgree(World(tys, [], trivial), call) {
    λ f ok => false_elim(ok.right)
}

// The same over a file of spans.
theorem Tm::calls_agree_none_over(tys: Table, spans: List<List<BitVec(8)>>, call: Answers()):
    Tm::CallsAgree(World(tys, [], trivial, spans), call) {
    λ f ok => false_elim(ok.right)
}

// ---------------------------------------------------------------------------
// The lowering. Each step that can refuse is an `Option` chained by
// `and_then`, its continuation a named function where it is not recursive,
// so the soundness proof walks the same chain (`Option::and_then_elim`).

// One node writing `next`, the result there.
fn Tm::one_node(node: Node, next: Nat) → Lowered { Lowered(nodes_region([node]), next, next + 1) }

// A literal: a constant node, a bit as the one-bit 0 or 1.
fn Tm::bit_code(n: Nat) → Nat { match n { Zero => 0, Succ(_) => 1 } }

// An enum's constructor as its tag, one of the enum's and in a word.
fn Tm::lit_tag(n, next: Nat) → Option<Lowered> {
    Tm::check_true((n + 1).leb(Nat::pow(2, 64))).and_then(λ _ => Some(Tm::one_node(Const(64, next, n), next)))
}

fn Tm::lit_bare(tys: Table, i, n, next: Nat) → Option<Lowered> {
    Ty::check_bare(tys.ens(i).slots).and_then(λ _ => Tm::lit_tag(n, next))
}

fn Tm::lower_lit(tys: Table, c: Ty, n, next: Nat) → Option<Lowered> {
    match c {
        Word(width) => Some(Tm::one_node(Const(width, next, n), next)),
        Bit => Some(Tm::one_node(Const(1, next, Tm::bit_code(n)), next)),
        ByteList(_) => None,
        Lines => None,
        Named(_) => None,
        Count => None,
        // A constructor without fields of an enum without a payload (a
        // payload's constructor is an `Inject`).
        Enum(i) => Tm::check_true(n.leb(tys.ens(i).last)).and_then(λ _ => Tm::lit_bare(tys, i, n, next)),
    }
}

// A primitive on two variables of the code `t`: one node, once both are
// at `t`.
fn Tm::binary_b(g: List<Ty>, b: Nat, t: Ty, l: Lowered) → Option<Lowered> { Ty::at(g, b).check(t).and_then(λ _ => Some(l)) }

fn Tm::binary(g: List<Ty>, a, b: Nat, t: Ty, l: Lowered) → Option<Lowered> {
    Ty::at(g, a).check(t).and_then(λ _ => Tm::binary_b(g, b, t, l))
}

// The primitive table (§7.1): each binary operation FunctionIR has a node
// for. A bit is a one-bit word, so `&&` and `||` are its bitwise nodes.
fn Tm::prim2(op: Op, g: List<Ty>, next, a, b, pa, pb: Nat) → Option<Lowered> {
    match op {
        Add(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Add(width, next, pa, pb), next)),
        Sub(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Sub(width, next, pa, pb), next)),
        Band(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitAnd(width, next, pa, pb), next)),
        Bor(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitOr(width, next, pa, pb), next)),
        Bxor(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(BitXor(width, next, pa, pb), next)),
        Eq(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Equal(width, next, pa, pb), next)),
        Ult(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(UnsignedLessThan(width, next, pa, pb), next)),
        Slt(width) => Tm::binary(g, a, b, Word(width), Tm::one_node(SignedLessThan(width, next, pa, pb), next)),
        Conj => Tm::binary(g, a, b, Bit, Tm::one_node(BitAnd(1, next, pa, pb), next)),
        Disj => Tm::binary(g, a, b, Bit, Tm::one_node(BitOr(1, next, pa, pb), next)),
        // An operation by its row: FunctionIR's one node for it.
        Apply(o, width) => Tm::binary(g, a, b, Word(width), Tm::one_node(Node::Apply(o, width, next, pa, pb), next)),
        Neg => None,
        Zext(_, _) => None,
        Get(_) => None,
        Set(_) => None,
        // A cell written at the arena's top, which needs the arena's buffer
        // and an exit when it is full (issues/runtime-fn-arena-lists.md).
        ConsLine(_) => None,
        ToNat => None,
        Trunc(_, _) => None,
        Shl(_, _) => None, Lshr(_, _) => None, Ashr(_, _) => None,
        Sext(_, _) => None,
        TagIs(_, _) => None,
    }
}

// `!x`: the bit against a constant one.
fn Tm::neg_lowered(next, pa: Nat) → Lowered {
    Lowered(nodes_region([Const(1, next, 1), BitXor(1, next + 1, pa, next)]), next + 1, next + 2)
}

// A unary node on a variable of the code `t`, once it is at `t`.
fn Tm::unary(g: List<Ty>, a: Nat, t: Ty, l: Lowered) → Option<Lowered> { Ty::at(g, a).check(t).and_then(λ _ => Some(l)) }

// The primitive table's unary operations. A zero extension and a
// truncation are one `Resize` (both are `ofNat(x.toNat())` at the result's
// width); a shift by a literal is FunctionIR's immediate shift. The byte
// reads and writes need buffers (`Fold`'s round).
// `TagIs(i, k)`: the enum's word against `k`, a constant and one compare.
// Only a constructor before the last is tested: the last is every test's
// fall-through, which is also what a word past the last tag names
// (`EnumInfo::read`), so the compare agrees with the tag on every word.
fn Tm::tag_lowered(next, pa, k: Nat) → Lowered {
    Lowered(nodes_region([Const(64, next, k), Equal(64, next + 1, pa, next)]), next + 1, next + 2)
}

fn Tm::tag_small(tys: Table, next, pa, i, k: Nat) → Option<Lowered> {
    Tm::check_true((k + 1).leb(Nat::pow(2, 64))).and_then(λ _ => Some(Tm::tag_lowered(next, pa, k)))
}

fn Tm::tag_below(tys: Table, next, pa, i, k: Nat) → Option<Lowered> {
    Tm::check_true((k + 1).leb(tys.ens(i).last)).and_then(λ _ => Tm::tag_small(tys, next, pa, i, k))
}

fn Tm::lower_tag(tys: Table, g: List<Ty>, next, a, pa, i, k: Nat) → Option<Lowered> {
    Ty::at(g, a).check(Enum(i)).and_then(λ _ => Tm::tag_below(tys, next, pa, i, k))
}

fn Tm::prim1(op: Op, tys: Table, g: List<Ty>, next, a, pa: Nat) → Option<Lowered> {
    match op {
        TagIs(i, k) => Tm::lower_tag(tys, g, next, a, pa, i, k),
        Neg => Ty::at(g, a).check(Bit).and_then(λ _ => Some(Tm::neg_lowered(next, pa))),
        Zext(width, extra) => Tm::unary(g, a, Word(width), Tm::one_node(Resize(width, extra + width, next, pa), next)),
        Trunc(n, extra) => Tm::unary(g, a, Word(extra + n), Tm::one_node(Resize(extra + n, n, next, pa), next)),
        Shl(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(ShiftLeft(width, next, pa, k), next)),
        Lshr(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(LogicalShiftRight(width, next, pa, k), next)),
        Ashr(width, k) => Tm::unary(g, a, Word(width), Tm::one_node(ArithmeticShiftRight(width, next, pa, k), next)),
        // A sign extension is one `SignResize`, `Resize`'s signed twin.
        Sext(n, extra) => Tm::unary(g, a, Word(n + 1), Tm::one_node(SignResize(n + 1, extra + (n + 1), next, pa), next)),
        // A count is held as the word it is the `toNat` of: no code.
        ToNat => Ty::at(g, a).check(Word(64)).and_then(λ _ => Some(Lowered(nodes_region(Nil), pa, next))),
        _ => None,
    }
}

fn Tm::prim2_port_b(op: Op, g: List<Ty>, ports: List<Nat>, next, a, b, pa: Nat) → Option<Lowered> {
    port_at(ports, b).and_then(λ pb => Tm::prim2(op, g, next, a, b, pa, pb))
}

fn Tm::lower_prim(op: Op, tys: Table, g: List<Ty>, ports: List<Nat>, next: Nat, args: List<Nat>) → Option<Lowered> {
    match args {
        Nil => None,
        Cons(a, more) => match more {
            Nil => port_at(ports, a).and_then(λ pa => Tm::prim1(op, tys, g, next, a, pa)),
            Cons(b, rest) => match rest {
                Cons(_, _) => None,
                Nil => port_at(ports, a).and_then(λ pa => Tm::prim2_port_b(op, g, ports, next, a, b, pa)),
            },
        },
    }
}

// A bound term's region, then its body's.
fn Tm::compose(le, lb: Lowered) → Option<Lowered> { Some(Lowered(Compose(le.region, lb.region), lb.result, lb.next)) }

// A branch: each arm moves its result to fresh ports above both (a record
// a field at a time).
fn Tm::branch_lowered(tys: Table, ty_yes: Ty, pc: Nat, ly, ln: Lowered) → Lowered {
    Lowered(branch(pc, moved_ports(ty_yes.moves(tys, ln.next, ly.result)),
            Compose(ly.region, nodes_region(ty_yes.moves(tys, ln.next, ly.result))),
            Compose(ln.region, nodes_region(ty_yes.moves(tys, ln.next, ln.result)))),
        ln.next, ty_yes.past(tys, ln.next))
}

fn Tm::branch_typed(tys: Table, ty_yes, ty_no: Ty, pc: Nat, ly, ln: Lowered) → Option<Lowered> {
    ty_no.check(ty_yes).and_then(λ _ => Some(Tm::branch_lowered(tys, ty_yes, pc, ly, ln)))
}

fn Tm::branch_checked(tys: Table, g: List<Ty>, c: Nat, ty_yes, ty_no: Ty, pc: Nat, ly, ln: Lowered) → Option<Lowered> {
    Ty::at(g, c).check(Bit).and_then(λ _ => Tm::branch_typed(tys, ty_yes, ty_no, pc, ly, ln))
}

fn Tm::lower_branch(tys: Table, g: List<Ty>, ports: List<Nat>, c: Nat, ty_yes, ty_no: Ty, ly, ln: Lowered) → Option<Lowered> {
    port_at(ports, c).and_then(λ pc => Tm::branch_checked(tys, g, c, ty_yes, ty_no, pc, ly, ln))
}

// A record from field variables: each moved to the fields' ports from
// `out`, one per field.
fn Tm::make_args(g: List<Ty>, ports: List<Nat>, fs: List<Ty>, args: List<Nat>, out: Nat) → Option<List<Node>> {
    match fs {
        Nil => match args { Nil => Some(Nil), Cons(_, _) => None },
        Cons(f, rest) => match args {
            Nil => None,
            Cons(a, more) => port_at(ports, a).and_then(λ q =>
                Ty::at(g, a).check(f).and_then(λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))))),
        },
    }
}

fn Tm::make_moves(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::make_args(g, ports, w.tys.recs(i).fields, args, next).and_then(λ ns =>
        Some(Lowered(nodes_region(ns), next, Ty::fields_past(w.tys.fields(i), next))))
}

// `Make`: the record at fresh ports, its fields flat (no record fields),
// an enum field as its tag word.
fn Tm::lower_make(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>) → Option<Lowered> {
    Ty::check_field_ones(w.tys.recs(i).fields).and_then(λ _ => Tm::make_moves(w, g, ports, next, i, args))
}

fn Tm::field_one(w: World, next, i, k, p: Nat) → Option<Lowered> {
    Ty::at(w.tys.recs(i).fields, k).check_field_one().and_then(λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(k, p), next)))
}

fn Tm::field_ranged(w: World, next, i, k, p: Nat) → Option<Lowered> {
    Tm::check_true(Ty::has_field(w.tys.fields(i), k)).and_then(λ _ => Tm::field_one(w, next, i, k, p))
}

fn Tm::field_typed(w: World, g: List<Ty>, next, i, k, of, p: Nat) → Option<Lowered> {
    Ty::at(g, of).check(Named(i)).and_then(λ _ => Tm::field_ranged(w, next, i, k, p))
}

// `Field`: no code at all, the field's own port.
fn Tm::lower_field(w: World, g: List<Ty>, ports: List<Nat>, next, i, k, of: Nat) → Option<Lowered> {
    port_at(ports, of).and_then(λ p => Tm::field_typed(w, g, next, i, k, of, p))
}

// A payload slot's default, the constant zero (a bit's `False`, a count's
// 0): only a word, a bit or a count is a slot a constructor not its own
// leaves.
fn Ty::Defaults(self f: Ty) → Type {
    match f { Word(_) => True, Bit => True, ByteList(_) => False, Lines => False, Named(_) => False, Count => True, Enum(_) => False }
}

fn Ty::check_default(self f: Ty) → Option<f.Defaults()> {
    match f as λ x => Option<x.Defaults()> {
        Word(_) => Some(trivial), Bit => Some(trivial), ByteList(_) => None, Lines => None, Named(_) => None, Count => Some(trivial), Enum(_) => None,
    }
}

fn Ty::default_node(self f: Ty, out: Nat) → Option<Node> { f.check_default().and_then(λ _ => Some(Const(f.width(), out, 0))) }

// Slots from `out` at their defaults.
fn Ty::default_nodes(fs: List<Ty>, out: Nat) → Option<List<Node>> {
    match fs {
        Nil => Some(Nil),
        Cons(f, rest) => f.default_node(out).and_then(λ d => Ty::default_nodes(rest, out + 1).and_then(λ ds => Some(Cons(d, ds)))),
    }
}

// A constructor's fields in its enum's slots from `out` (`Ty::spread`):
// the slots from `lo` moved from its field variables, one per field, the
// others their defaults.
fn Tm::spread_args(g: List<Ty>, ports: List<Nat>, fs: List<Ty>) → Nat → Nat → List<Nat> → Nat → Option<List<Node>> {
    match fs {
        Nil => λ lo n args out => Some(Nil),
        Cons(f, rest) => λ lo => match lo {
            Succ(l) => λ n args out => f.default_node(out).and_then(λ d => Tm::spread_args(g, ports, rest, l, n, args, out + 1).and_then(λ ds => Some(Cons(d, ds)))),
            Zero => λ n => match n {
                Zero => λ args out => match args { Nil => Ty::default_nodes(Cons(f, rest), out), Cons(_, _) => None },
                Succ(m) => λ args out => match args {
                    Nil => None,
                    Cons(a, more) => port_at(ports, a).and_then(λ q => Ty::at(g, a).check(f).and_then(λ _ => f.check_one().and_then(λ _ =>
                        Tm::spread_args(g, ports, rest, 0, m, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns)))))),
                },
            },
        },
    }
}

fn Tm::inject_moves(w: World, g: List<Ty>, ports: List<Nat>, next, i, k: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::spread_args(g, ports, w.tys.ens(i).slots, w.tys.ens(i).lo(k), w.tys.ens(i).arity(k), args, next + 1).and_then(λ ns =>
        Some(Lowered(nodes_region(Cons(Const(64, next, k), ns)), next, Ty::fields_past(w.tys.ens(i).slots, next + 1))))
}

fn Tm::inject_small(w: World, g: List<Ty>, ports: List<Nat>, next, i, k: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::check_true((k + 1).leb(Nat::pow(2, 64))).and_then(λ _ => Tm::inject_moves(w, g, ports, next, i, k, args))
}

// `Inject`: the constructor's tag at fresh ports, then the payload's slots.
fn Tm::lower_inject(w: World, g: List<Ty>, ports: List<Nat>, next, i, k: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::check_true(k.leb(w.tys.ens(i).last)).and_then(λ _ => Tm::inject_small(w, g, ports, next, i, k, args))
}

fn Tm::slot_one(w: World, next, i, j, p: Nat) → Option<Lowered> {
    Ty::at(w.tys.ens(i).slots, j).check_one().and_then(λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(j, p + 1), next)))
}

fn Tm::slot_ranged(w: World, next, i, j, p: Nat) → Option<Lowered> {
    Tm::check_true(Ty::has_field(w.tys.ens(i).slots, j)).and_then(λ _ => Tm::slot_one(w, next, i, j, p))
}

fn Tm::slot_typed(w: World, g: List<Ty>, next, i, j, of, p: Nat) → Option<Lowered> {
    Ty::at(g, of).check(Enum(i)).and_then(λ _ => Tm::slot_ranged(w, next, i, j, p))
}

// `Slot`: no code, the slot's own port after the tag's.
fn Tm::lower_slot(w: World, g: List<Ty>, ports: List<Nat>, next, i, j, of: Nat) → Option<Lowered> {
    port_at(ports, of).and_then(λ p => Tm::slot_typed(w, g, next, i, j, of, p))
}

// A call's arguments: each a variable at its parameter's code, one per
// parameter, each passed in its code's words (`Ty::ids`): whole where its
// ports hold its words (`Ty::Sent`), else a slot at a time, a narrow slot
// first zero-extended into a port of its own from `next` on
// (`Ty::Sliced`, `Tm::send_slots`). `nodes` are the widenings, `ports`
// the words the call passes, `next` past the widened ports.
record Sending { nodes: List<Node>, ports: List<Nat>, next: Nat }

fn Tm::send_narrow_slot(f: Ty, port, next: Nat, s: Sending) → Sending { Sending(Cons(Resize(f.width(), 64, next, port), s.nodes), Cons(next, s.ports), s.next) }

fn Tm::send_wide_slot(port: Nat, s: Sending) → Sending { Sending(s.nodes, Cons(port, s.ports), s.next) }

fn Tm::send_slots(fs: List<Ty>, port, next: Nat) → Sending {
    match fs {
        Nil => Sending(Nil, Nil, next),
        Cons(f, rest) => match f.slot_narrow() {
            True => Tm::send_narrow_slot(f, port, next, Tm::send_slots(rest, port + 1, next + 1)),
            False => Tm::send_wide_slot(port, Tm::send_slots(rest, port + 1, next)),
        },
    }
}

fn Tm::then_send(a, b: Sending) → Sending { Sending(a.nodes ++ b.nodes, a.ports ++ b.ports, b.next) }

fn Tm::send_whole(tys: Table, p: Ty, q: Nat, s: Sending) → Sending { Sending(s.nodes, p.ids(tys, q) ++ s.ports, s.next) }

fn Tm::send_args(tys: Table, g: List<Ty>, ports: List<Nat>, ps: List<Ty>, args: List<Nat>, next: Nat) → Option<Sending> {
    match ps {
        Nil => match args { Nil => Some(Sending(Nil, Nil, next)), Cons(_, _) => None },
        Cons(p, rest) => match args {
            Nil => None,
            Cons(a, more) => port_at(ports, a).and_then(λ q => Ty::at(g, a).check(p).and_then(λ _ => match p.check_sliced(tys) {
                Some(_) => Tm::send_args(tys, g, ports, rest, more, Tm::send_slots(p.pieces(tys), q, next).next).and_then(λ s =>
                    Some(Tm::then_send(Tm::send_slots(p.pieces(tys), q, next), s))),
                None => p.check_sent(tys).and_then(λ _ => Tm::send_args(tys, g, ports, rest, more, next).and_then(λ s => Some(Tm::send_whole(tys, p, q, s)))),
            })),
        },
    }
}

// The same, each argument held in one word (`Ty::Held`): a call of the
// effectful layer's (`FTm::call_args`).
fn Tm::word_args(tys: Table, g: List<Ty>, ports: List<Nat>, ps: List<Ty>, args: List<Nat>) → Option<List<Nat>> {
    match ps {
        Nil => match args { Nil => Some(Nil), Cons(_, _) => None },
        Cons(p, rest) => match args {
            Nil => None,
            Cons(a, more) => port_at(ports, a).and_then(λ q =>
                Ty::at(g, a).check(p).and_then(λ _ => p.check_held(tys).and_then(λ _ =>
                    Tm::word_args(tys, g, ports, rest, more).and_then(λ qs => Some(Cons(q, qs)))))),
        },
    }
}

// The call, its words landing at `next` and the ports the result's value
// spans after it (`Ty::also_ports`), then moved off them: the x86 lowering
// answers a call in RAX, RDX, …, which the next call does not keep, and
// the moves give the result ports the planner places (as the Rust
// reflector's programs do).
fn Tm::called(tys: Table, r: Ty, f: Nat, qs: List<Nat>, next: Nat) → Lowered {
    let base = r.past(tys, next);
    Lowered(Compose(Call(f, qs, next, r.also_ports(tys, next)), nodes_region(r.moves(tys, base, next))), base, r.past(tys, base))
}

// A call answering one word, moved one port up.
fn Tm::called_word(f: Nat, qs: List<Nat>, next: Nat) → Lowered {
    Lowered(Compose(Call(f, qs, next, []), nodes_region([Move(64, next + 1, next)])), next + 1, next + 2)
}

// The widenings, then the code after them (none: the code alone).
fn Tm::sent_then(nodes: List<Node>, c: Lowered) → Lowered {
    Lowered(match nodes { Nil => c.region, Cons(_, _) => Compose(nodes_region(nodes), c.region) }, c.result, c.next)
}

theorem Tm::sent_then_eval(call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), c: Lowered): (nodes: List<Node>) →
    Tm::sent_then(nodes, c).region.eval(call, values, buffers := buffers) = c.region.eval(call, eval_nodes_over(buffers, nodes, values), buffers := buffers) {
    λ nodes => match nodes { Nil => refl, Cons(_, _) => refl }
}

// The ports the call's words land at are distinct, which the region's
// evaluation reads them back by (`words_of_bind`).
fn Tm::lower_call_at(w: World, r: Ty, f: Nat, s: Sending) → Option<Lowered> {
    Tm::check_true(distinct(Cons(s.next, r.also_ports(w.tys, s.next)))).and_then(λ _ => Some(Tm::sent_then(s.nodes, Tm::called(w.tys, r, f, s.ports, s.next))))
}

fn Tm::lower_call_args(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Tm::send_args(w.tys, g, ports, Sig::at(w.sigs, f).params, args, next).and_then(λ s => Tm::lower_call_at(w, Sig::at(w.sigs, f).result, f, s))
}

fn Tm::lower_call_result(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Sig::at(w.sigs, f).result.check_back(w.tys).and_then(λ _ => Tm::lower_call_args(w, g, ports, next, f, args))
}

// A call of the program's function `f`: FunctionIR's `Call` of the same
// index, at a signature a call passes and reads back in words.
fn Tm::lower_call(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>) → Option<Lowered> {
    Ty::check_sents(w.tys, Sig::at(w.sigs, f).params).and_then(λ _ => Tm::lower_call_result(w, g, ports, next, f, args))
}

// A byte of span `k`: the index tested against the length word, the load
// in the arm the test guards, zero in the other. The function compiler
// lowers a load only where the path knows its index below the length home
// of the buffer (`File::bounded`), so the test is the code's bounds check
// and the meaning's (`List::byte_within`) at once; that `pl` is span
// `k`'s length home is the function compiler's to check, not this
// lowering's. The load is a leaf of its own, as that lowering reads one;
// the byte is the low eight bits of the word it leaves.
fn Tm::byte_lowered(k, pi, pl, next: Nat) → Lowered {
    Lowered(Compose(nodes_region([UnsignedLessThan(64, next, pi, pl)]),
            branch(next, Ports([Port(next + 2, 8)]),
                Compose(nodes_region([BufferLoad(next + 1, k, pi)]), nodes_region([Resize(64, 8, next + 2, next + 1)])),
                nodes_region([Const(8, next + 2, 0)]))),
        next + 2, next + 3)
}

fn Tm::byte_port_l(g: List<Ty>, ports: List<Nat>, next, k, i, length, pi: Nat) → Option<Lowered> {
    port_at(ports, length).and_then(λ pl => Tm::binary(g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next)))
}

fn Tm::lower_byte(g: List<Ty>, ports: List<Nat>, next, k, i, length: Nat) → Option<Lowered> {
    port_at(ports, i).and_then(λ pi => Tm::byte_port_l(g, ports, next, k, i, length, pi))
}

// ---------------------------------------------------------------------------
// Ids in a run: `Fun::param_ids(ps, m)` is `m, m+1, …` below `Fun::past(ps, m)`.

fn Fun::param_ids(ps: List<Ty>, m: Nat) → List<Nat> {
    match ps { Nil => Nil, Cons(_, rest) => Cons(m, Fun::param_ids(rest, m + 1)) }
}

fn Fun::past(ps: List<Ty>, m: Nat) → Nat {
    match ps { Nil => m, Cons(_, rest) => Fun::past(rest, m + 1) }
}

theorem Fun::past_ge(ps: List<Ty>): (m: Nat) → m <= Fun::past(ps, m) {
    match ps {
        Nil => λ m => m.le_refl(),
        Cons(_, rest) => λ m => Nat::le_of_lt(m, Fun::past(rest, m + 1), Fun::past_ge(rest, m + 1)),
    }
}

// A parameter's id is below the ids' end.
theorem Fun::param_ids_below(ps: List<Ty>): (m, id: Nat) → Mem(id, Fun::param_ids(ps, m)) → id < Fun::past(ps, m) {
    match ps {
        Nil => λ m id never => false_elim(never),
        Cons(_, rest) => λ m id mem => match mem {
            Inl(e) => j(sym(e), λ y _ => y < Fun::past(rest, m + 1), Fun::past_ge(rest, m + 1)),
            Inr(later) => Fun::param_ids_below(rest, m + 1, id, later),
        },
    }
}

theorem Tm::differs_of_ne(a, b: Nat, ne: a ≠ b): a.differs(b).IsTrue() {
    match a.eq_dec(b) as λ d => Bool::IsTrue(match d { Inl(_) => False, Inr(_) => True }) {
        Inl(e) => false_elim(ne(e)),
        Inr(_) => trivial,
    }
}

theorem Fun::ids_len(ps: List<Ty>): (m: Nat) → Fun::param_ids(ps, m).len() = ps.len() {
    match ps { Nil => λ m => refl, Cons(_, rest) => λ m => cong_fn(λ (k: Nat) => k + 1, Fun::ids_len(rest, m + 1)) }
}

// An id below the run or past it is none of it.
theorem Fun::absent_ids(ps: List<Ty>): (m, id: Nat) → (id < m) ∨ (Fun::past(ps, m) <= id) → absent(id, Fun::param_ids(ps, m)).IsTrue() {
    match ps {
        Nil => λ m id _ => trivial,
        Cons(_, rest) => λ m id out => {
            let ne: (id ≠ m) = match out {
                Inl(lt) => Nat::ne_of_lt(id, m, lt),
                Inr(ge) => Nat::ne_of_gt(id, m, Nat::lt_of_lt_of_le(m, Fun::past(rest, m + 1), id, Fun::past_ge(rest, m + 1), ge)),
            };
            let later: (id < m + 1) ∨ (Fun::past(rest, m + 1) <= id) = match out {
                Inl(lt) => Inl(Nat::lt_trans(id, m, m + 1, lt, m.lt_succ_self())),
                Inr(ge) => Inr(ge),
            };
            Bool::is_true_and_intro(id.differs(m), absent(id, Fun::param_ids(rest, m + 1)), Tm::differs_of_ne(id, m, ne),
                Fun::absent_ids(rest, m + 1, id, later))
        },
    }
}

theorem Fun::ids_distinct(ps: List<Ty>): (m: Nat) → distinct(Fun::param_ids(ps, m)).IsTrue() {
    match ps {
        Nil => λ m => trivial,
        Cons(_, rest) => λ m => Bool::is_true_and_intro(absent(m, Fun::param_ids(rest, m + 1)), distinct(Fun::param_ids(rest, m + 1)),
            Fun::absent_ids(rest, m + 1, m, Inl(m.lt_succ_self())), Fun::ids_distinct(rest, m + 1)),
    }
}

// Ids of a signature in two parts.
theorem Fun::past_append(ks, ws: List<Ty>): (m: Nat) → Fun::past(ks ++ ws, m) = Fun::past(ws, Fun::past(ks, m)) {
    match ks { Nil => λ m => refl, Cons(_, rest) => λ m => Fun::past_append(rest, ws, m + 1) }
}

theorem Fun::ids_append(ks, ws: List<Ty>): (m: Nat) →
    Fun::param_ids(ks ++ ws, m) = Fun::param_ids(ks, m) ++ Fun::param_ids(ws, Fun::past(ks, m)) {
    match ks { Nil => λ m => refl, Cons(_, rest) => λ m => cong_fn(λ (l: List<Nat>) => Cons(m, l), Fun::ids_append(rest, ws, m + 1)) }
}

theorem Fun::past_first(ks, ws: List<Ty>, m: Nat): Fun::past(ks, m) <= Fun::past(ks ++ ws, m) {
    j(sym(Fun::past_append(ks, ws, m)), λ y _ => Fun::past(ks, m) <= y, Fun::past_ge(ws, Fun::past(ks, m)))
}

theorem Fun::words_append(values: Valuation(), xs, ys: List<Nat>): words_of(values, xs ++ ys) = words_of(values, xs) ++ words_of(values, ys) {
    match xs { Nil => refl, Cons(x, rest) => cong_fn(λ (l: List<BitVec(64)>) => Cons(values(64, x), l), Fun::words_append(values, rest, ys)) }
}

// ---------------------------------------------------------------------------
// A loop's context, carried into its passes
// (docs/language/loop-combinator-design.md §6.2). A FunctionIR loop's pass
// sees only its parameters and its count (`pass_valuation`), so every
// variable the loop's test and body may read is carried as parameters of
// its own: its ports' words are inputs of the loop, bound at fresh ids that
// each pass hands on unchanged. A loop moves words at 64 bits, so a
// variable is carried only at a code whose ports' 64-bit words hold it
// (`Ty::Carries`), and never a buffer: what a pass may write is then only
// what it makes, which keeps the ownership analysis (`unique`) out of loops.

// The codes of a value's ports, one per port: a record's fields, an
// enum's tag word and slots, any other code itself.
fn Ty::cells(self t: Ty, tys: Table) → List<Ty> {
    match t { Word(w) => [Word(w)], Bit => [Bit], ByteList(c) => [ByteList(c)], Lines => [Lines], Named(i) => tys.fields(i), Count => [Count],
        Enum(i) => Cons(Word(64), tys.ens(i).slots) }
}

// A field whose port's 64-bit word holds it.
fn Ty::CellCarries(self f: Ty) → Type {
    match f { Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(_) => False, Count => True, Enum(_) => False }
}

fn Ty::CellsCarry(fs: List<Ty>) → Type {
    match fs { Nil => True, Cons(f, rest) => f.CellCarries() ∧ Ty::CellsCarry(rest) }
}

// A code whose ports' 64-bit words hold its value.
fn Ty::Carries(self t: Ty, tys: Table) → Type {
    match t { Word(w) => w = 64, Bit => False, ByteList(_) => False, Lines => False, Named(i) => Ty::CellsCarry(tys.fields(i)), Count => True,
        Enum(i) => Ty::CellsCarry(tys.ens(i).slots) }
}

fn Ty::check_cell(self f: Ty) → Option<f.CellCarries()> {
    match f as λ x => Option<x.CellCarries()> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None,
        ByteList(_) => None,
        Lines => None,
        Named(_) => None,
        Count => Some(trivial),
        Enum(_) => None,
    }
}

fn Ty::check_cells(fs: List<Ty>) → Option<Ty::CellsCarry(fs)> {
    match fs {
        Nil => Some(trivial),
        Cons(f, rest) => f.check_cell().and_then(λ o => Ty::check_cells(rest).and_then(λ os => Some(⟨o, os⟩))),
    }
}

fn Ty::check_carries(self t: Ty, tys: Table) → Option<t.Carries(tys)> {
    match t as λ x => Option<x.Carries(tys)> {
        Word(w) => match w.equation(64) { Inl(e) => Some(e), Inr(_) => None },
        Bit => None,
        ByteList(_) => None,
        Lines => None,
        Named(i) => Ty::check_cells(tys.fields(i)),
        Count => Some(trivial),
        Enum(i) => Ty::check_cells(tys.ens(i).slots),
    }
}

// ---------------------------------------------------------------------------
// What a term reads. A loop carries the variables its test and body read and
// no others (docs/language/loop-combinator-design.md §6.2): a term's meaning
// is the same at two environments that agree on the variables it reads
// (`Tm::sem_kept`), so a pass may hold anything at the rest.

// `keep` seen under one more binder: the new variable 0 is kept.
fn Tm::under(keep: Nat → Bool) → Nat → Bool { λ i => match i { Zero => True, Succ(k) => keep(k) } }

fn Tm::AllKept(vs: List<Nat>, keep: Nat → Bool) → Type {
    match vs { Nil => True, Cons(v, more) => (keep(v) = True) ∧ Tm::AllKept(more, keep) }
}

// Every variable the term reads is kept.
fn Tm::Within(self t: Tm, keep: Nat → Bool) → Type {
    match t {
        Var(i) => keep(i) = True,
        Lit(_, _) => True,
        Prim(_, args) => Tm::AllKept(args, keep),
        Let(e, body) => e.Within(keep) ∧ body.Within(Tm::under(keep)),
        If(c, yes, no) => (keep(c) = True) ∧ (yes.Within(keep) ∧ no.Within(keep)),
        IfEq(c, yes, no) => (keep(c) = True) ∧ (yes.Within(keep) ∧ no.Within(keep)),
        Make(_, args) => Tm::AllKept(args, keep),
        Field(_, _, of) => keep(of) = True,
        Call(_, args) => Tm::AllKept(args, keep),
        Fold(over, init, _) => (keep(over) = True) ∧ (keep(init) = True),
        Case(c, zero, succ) => (keep(c) = True) ∧ (zero.Within(keep) ∧ succ.Within(Tm::under(keep))),
        Byte(_, i, length) => (keep(i) = True) ∧ (keep(length) = True),
        Pick(_, c, arms, _) => (keep(c) = True) ∧ arms.Within(Tm::under(keep)),
        Inject(_, _, args) => Tm::AllKept(args, keep),
        Slot(_, _, of) => keep(of) = True,
        Iterate(init, test, body) => (keep(init) = True) ∧ (test.Within(Tm::under(keep)) ∧ body.Within(Tm::under(keep))),
    }
}

fn Tm::kept_at(keep: Nat → Bool, i: Nat) → Option<keep(i) = True> {
    match keep(i) as λ b => Option<b = True> { True => Some(refl), False => None }
}

fn Tm::check_all_kept(vs: List<Nat>, keep: Nat → Bool) → Option<Tm::AllKept(vs, keep)> {
    match vs as λ l => Option<Tm::AllKept(l, keep)> {
        Nil => Some(trivial),
        Cons(v, more) => Tm::kept_at(keep, v).and_then(λ h => Tm::check_all_kept(more, keep).and_then(λ hs => Some(⟨h, hs⟩))),
    }
}

fn Tm::both<A, B>(a: Option<A>, b: Option<B>) → Option<A ∧ B> { a.and_then(λ x => b.and_then(λ y => Some(⟨x, y⟩))) }

// Whether the term reads only kept variables, with the proof.
fn Tm::check_within(self t: Tm) → (keep: Nat → Bool) → Option<t.Within(keep)> {
    match t as λ u => (keep: Nat → Bool) → Option<u.Within(keep)> {
        Var(i) => λ keep => Tm::kept_at(keep, i),
        Lit(_, _) => λ keep => Some(trivial),
        Prim(_, args) => λ keep => Tm::check_all_kept(args, keep),
        Let(e, body) => λ keep => Tm::both(e.check_within(keep), body.check_within(Tm::under(keep))),
        If(c, yes, no) => λ keep => Tm::both(Tm::kept_at(keep, c), Tm::both(yes.check_within(keep), no.check_within(keep))),
        IfEq(c, yes, no) => λ keep => Tm::both(Tm::kept_at(keep, c), Tm::both(yes.check_within(keep), no.check_within(keep))),
        Make(_, args) => λ keep => Tm::check_all_kept(args, keep),
        Field(_, _, of) => λ keep => Tm::kept_at(keep, of),
        Call(_, args) => λ keep => Tm::check_all_kept(args, keep),
        Fold(over, init, _) => λ keep => Tm::both(Tm::kept_at(keep, over), Tm::kept_at(keep, init)),
        Case(c, zero, succ) => λ keep => Tm::both(Tm::kept_at(keep, c), Tm::both(zero.check_within(keep), succ.check_within(Tm::under(keep)))),
        Byte(_, i, length) => λ keep => Tm::both(Tm::kept_at(keep, i), Tm::kept_at(keep, length)),
        Pick(_, c, arms, _) => λ keep => Tm::both(Tm::kept_at(keep, c), arms.check_within(Tm::under(keep))),
        Inject(_, _, args) => λ keep => Tm::check_all_kept(args, keep),
        Slot(_, _, of) => λ keep => Tm::kept_at(keep, of),
        Iterate(init, test, body) => λ keep => Tm::both(Tm::kept_at(keep, init), Tm::both(test.check_within(Tm::under(keep)), body.check_within(Tm::under(keep)))),
    }
}

// The variables a term reads, each as often as it is read (a guess the
// lowering checks with `check_within`, never trusted).
fn Tm::unbind(vs: List<Nat>) → List<Nat> {
    match vs { Nil => Nil, Cons(v, more) => match v { Zero => Tm::unbind(more), Succ(k) => Cons(k, Tm::unbind(more)) } }
}

fn Tm::vars(self t: Tm) → List<Nat> {
    match t {
        Var(i) => [i],
        Lit(_, _) => Nil,
        Prim(_, args) => args,
        Let(e, body) => e.vars() ++ Tm::unbind(body.vars()),
        If(c, yes, no) => Cons(c, yes.vars() ++ no.vars()),
        IfEq(c, yes, no) => Cons(c, yes.vars() ++ no.vars()),
        Make(_, args) => args,
        Field(_, _, of) => [of],
        Call(_, args) => args,
        Fold(over, init, _) => [over, init],
        Case(c, zero, succ) => Cons(c, zero.vars() ++ Tm::unbind(succ.vars())),
        Byte(_, i, length) => [i, length],
        Pick(_, c, arms, _) => Cons(c, Tm::unbind(arms.vars())),
        Inject(_, _, args) => args,
        Slot(_, _, of) => [of],
        Iterate(init, test, body) => Cons(init, Tm::unbind(test.vars()) ++ Tm::unbind(body.vars())),
    }
}

fn Tm::mem_nat(vs: List<Nat>, i: Nat) → Bool {
    match vs { Nil => False, Cons(v, more) => match v.equation(i) { Inl(_) => True, Inr(_) => Tm::mem_nat(more, i) } }
}

// Two environments that agree at every kept variable.
fn Env::Agree(tys: Table, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(tys, g)) → Type {
    (i: Nat) → keep(i) = True → Env::get(tys, g, e1, i) = Env::get(tys, g, e2, i)
}

theorem Env::agree_under(tys: Table, g: List<Ty>, t: Ty, keep: Nat → Bool, x1, x2: t.sem(tys), ex: x1 = x2, e1, e2: Env(tys, g),
    a: Env::Agree(tys, g, keep, e1, e2)): Env::Agree(tys, Cons(t, g), Tm::under(keep), Pair(x1, e1), Pair(x2, e2)) {
    λ i => match i as λ k => Tm::under(keep, k) = True → Env::get(tys, Cons(t, g), Pair(x1, e1), k) = Env::get(tys, Cons(t, g), Pair(x2, e2), k) {
        Zero => λ _ => ex,
        Succ(k) => λ h => a(k, h),
    }
}

theorem Tm::apply_kept(w: World, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(w.tys, g), a: Env::Agree(w.tys, g, keep, e1, e2), r: Ty, ps: List<Ty>):
    (f: Ty::Arrows(w.tys, ps, r)) → (vs: List<Nat>) → Tm::AllKept(vs, keep) → Tm::apply(w, g, e1, r, ps, f, vs) = Tm::apply(w, g, e2, r, ps, f, vs) {
    match ps {
        Nil => λ f vs _ => refl,
        Cons(p, rest) => λ f vs => match vs as λ l => Tm::AllKept(l, keep) → Tm::apply(w, g, e1, r, Cons(p, rest), f, l) = Tm::apply(w, g, e2, r, Cons(p, rest), f, l) {
            Nil => λ _ => refl,
            Cons(v, more) => λ h => trans(
                cong_fn(λ (x: Ty::at(g, v).sem(w.tys)) => Tm::apply(w, g, e1, r, rest, f(Ty::cast(w.tys, Ty::at(g, v), p, x)), more), a(v, h.left)),
                Tm::apply_kept(w, g, keep, e1, e2, a, r, rest, f(Ty::cast(w.tys, Ty::at(g, v), p, Env::get(w.tys, g, e2, v))), more, h.right)),
        },
    }
}

theorem Tm::fields_kept(w: World, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(w.tys, g), a: Env::Agree(w.tys, g, keep, e1, e2), fs: List<Ty>):
    (vs: List<Nat>) → Tm::AllKept(vs, keep) → Tm::fields(w, g, e1, fs, vs) = Tm::fields(w, g, e2, fs, vs) {
    match fs {
        Nil => λ vs _ => refl,
        Cons(f, rest) => λ vs => match vs as λ l => Tm::AllKept(l, keep) → Tm::fields(w, g, e1, Cons(f, rest), l) = Tm::fields(w, g, e2, Cons(f, rest), l) {
            Nil => λ _ => refl,
            Cons(v, more) => λ h => eq2(λ (x: f.Flat(en := Ty::types(w.tys.ens))) (y: Ty::Flats(rest, en := Ty::types(w.tys.ens))) => Pair(x, y),
                cong_fn(λ (x: Ty::at(g, v).sem(w.tys)) => f.to_flat(w.tys, Ty::cast(w.tys, Ty::at(g, v), f, x)), a(v, h.left)),
                Tm::fields_kept(w, g, keep, e1, e2, a, rest, more, h.right)),
        },
    }
}

theorem Tm::slots_kept(w: World, g: List<Ty>, keep: Nat → Bool, e1, e2: Env(w.tys, g), a: Env::Agree(w.tys, g, keep, e1, e2), fs: List<Ty>):
    (vs: List<Nat>) → Tm::AllKept(vs, keep) → Tm::slots(w, g, e1, fs, vs) = Tm::slots(w, g, e2, fs, vs) {
    match fs {
        Nil => λ vs _ => refl,
        Cons(f, rest) => λ vs => match vs as λ l => Tm::AllKept(l, keep) → Tm::slots(w, g, e1, Cons(f, rest), l) = Tm::slots(w, g, e2, Cons(f, rest), l) {
            Nil => λ _ => refl,
            Cons(v, more) => λ h => eq2(λ (x: f.Flat()) (y: Ty::Flats(rest)) => Pair(x, y),
                cong_fn(λ (x: Ty::at(g, v).sem(w.tys)) => f.to_slot(w.tys, Ty::cast(w.tys, Ty::at(g, v), f, x)), a(v, h.left)),
                Tm::slots_kept(w, g, keep, e1, e2, a, rest, more, h.right)),
        },
    }
}

// An enum's `match` whose arms agree everywhere answers alike.
theorem EnumInfo::choose_ext(self e: EnumInfo, eq: Bool, R: Type, a1, a2: Nat → Ty::Flats(e.slots) → R,
    same: (n: Nat) → (t: Ty::Flats(e.slots)) → a1(n, t) = a2(n, t), v: e.E): e.choose(eq, R, a1, v) = e.choose(eq, R, a2, v) {
    trans(e.chooses(eq, R, a1, v), trans(same(e.tag(v), e.fields(v)), sym(e.chooses(eq, R, a2, v))))
}

// A term's meaning reads only the variables it reads.
theorem Tm::sem_kept(self t: Tm, w: World): (keep: Nat → Bool) → (g: List<Ty>) → (e1, e2: Env(w.tys, g)) → t.Within(keep) →
    Env::Agree(w.tys, g, keep, e1, e2) → t.sem(w, g, e1) = t.sem(w, g, e2) {
    match t {
        Var(i) => λ keep g e1 e2 h a => a(i, h),
        Lit(_, _) => λ keep g e1 e2 h a => refl,
        Prim(op, args) => λ keep g e1 e2 h a => Tm::apply_kept(w, g, keep, e1, e2, a, op.result(), op.params(), op.sem(w.tys), args, h),
        Let(e, body) => λ keep g e1 e2 h a => {
            let same_e = Tm::sem_kept(e, w, keep, g, e1, e2, h.left, a);
            Tm::sem_kept(body, w, Tm::under(keep), Cons(e.ty(w, g), g), Pair(e.sem(w, g, e1), e1), Pair(e.sem(w, g, e2), e2), h.right,
                Env::agree_under(w.tys, g, e.ty(w, g), keep, e.sem(w, g, e1), e.sem(w, g, e2), same_e, e1, e2, a))
        },
        If(c, yes, no) => λ keep g e1 e2 h a => {
            let T = yes.ty(w, g).sem(w.tys);
            let pick = λ (b: Bool) (y: T) (n: no.ty(w, g).sem(w.tys)) => match b as λ _ => T { False => Ty::cast(w.tys, no.ty(w, g), yes.ty(w, g), n), True => y };
            trans(cong_fn(λ (x: Ty::at(g, c).sem(w.tys)) => pick(Ty::cast(w.tys, Ty::at(g, c), Bit, x), yes.sem(w, g, e1), no.sem(w, g, e1)), a(c, h.left)),
                eq2(λ (y: T) (n: no.ty(w, g).sem(w.tys)) => pick(Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, e2, c)), y, n),
                    Tm::sem_kept(yes, w, keep, g, e1, e2, h.right.left, a), Tm::sem_kept(no, w, keep, g, e1, e2, h.right.right, a)))
        },
        IfEq(c, yes, no) => λ keep g e1 e2 h a => {
            let T = yes.ty(w, g).sem(w.tys);
            let pick = λ (b: Bool) (y: T) (n: no.ty(w, g).sem(w.tys)) => Tm::convoy(T, b, y, Ty::cast(w.tys, no.ty(w, g), yes.ty(w, g), n));
            trans(cong_fn(λ (x: Ty::at(g, c).sem(w.tys)) => pick(Ty::cast(w.tys, Ty::at(g, c), Bit, x), yes.sem(w, g, e1), no.sem(w, g, e1)), a(c, h.left)),
                eq2(λ (y: T) (n: no.ty(w, g).sem(w.tys)) => pick(Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, e2, c)), y, n),
                    Tm::sem_kept(yes, w, keep, g, e1, e2, h.right.left, a), Tm::sem_kept(no, w, keep, g, e1, e2, h.right.right, a)))
        },
        Make(i, args) => λ keep g e1 e2 h a => cong_fn(w.tys.recs(i).mk, Tm::fields_kept(w, g, keep, e1, e2, a, w.tys.recs(i).fields, args, h)),
        Field(i, k, of) => λ keep g e1 e2 h a => cong_fn(λ (x: Ty::at(g, of).sem(w.tys)) =>
            Ty::at(w.tys.recs(i).fields, k).of_flat(w.tys, Ty::flat_nth_in(w.tys.recs(i).fields, Ty::types(w.tys.ens),
                w.tys.recs(i).get(Ty::cast(w.tys, Ty::at(g, of), Named(i), x)), k)), a(of, h)),
        Call(f, args) => λ keep g e1 e2 h a =>
            Tm::apply_kept(w, g, keep, e1, e2, a, Sig::at(w.sigs, f).result, Sig::at(w.sigs, f).params, Sig::get(w.tys, w.sigs, w.callees, f), args, h),
        Fold(over, init, step) => λ keep g e1 e2 h a => eq2(λ (x: Ty::at(g, over).sem(w.tys)) (y: Ty::at(g, init).sem(w.tys)) =>
            List::foldl(Ty::at(g, over).items(w.tys, x), Tm::step(w, Ty::at(g, over).elem(), step), Ty::cast(w.tys, Ty::at(g, init), Sig::at(w.sigs, step).result, y)),
            a(over, h.left), a(init, h.right)),
        Case(c, zero, succ) => λ keep g e1 e2 h a => {
            let T = zero.ty(w, g).sem(w.tys);
            let run = λ (e: Env(w.tys, g)) (n: Nat) => match n as λ _ => T {
                Zero => zero.sem(w, g, e),
                Succ(k) => Ty::cast(w.tys, succ.ty(w, Cons(Count, g)), zero.ty(w, g), succ.sem(w, Cons(Count, g), Pair(k, e))),
            };
            trans(cong_fn(λ (x: Ty::at(g, c).sem(w.tys)) => run(e1, Ty::cast(w.tys, Ty::at(g, c), Count, x)), a(c, h.left)),
                match Ty::cast(w.tys, Ty::at(g, c), Count, Env::get(w.tys, g, e2, c)) as λ n => run(e1, n) = run(e2, n) {
                    Zero => Tm::sem_kept(zero, w, keep, g, e1, e2, h.right.left, a),
                    Succ(k) => cong_fn(λ (y: succ.ty(w, Cons(Count, g)).sem(w.tys)) => Ty::cast(w.tys, succ.ty(w, Cons(Count, g)), zero.ty(w, g), y),
                        Tm::sem_kept(succ, w, Tm::under(keep), Cons(Count, g), Pair(k, e1), Pair(k, e2), h.right.right,
                            Env::agree_under(w.tys, g, Count, keep, k, k, refl, e1, e2, a))),
                })
        },
        Byte(k, i, length) => λ keep g e1 e2 h a => eq2(λ (x: Ty::at(g, i).sem(w.tys)) (y: Ty::at(g, length).sem(w.tys)) =>
            w.spans.span(k).byte_within(Ty::cast(w.tys, Ty::at(g, length), Word(64), y), Ty::cast(w.tys, Ty::at(g, i), Word(64), x)),
            a(i, h.left), a(length, h.right)),
        Pick(i, c, arms, eq) => λ keep g e1 e2 h a => {
            let e = w.tys.ens(i);
            let R = arms.ty(w, Cons(Enum(i), g)).sem(w.tys);
            let arm = λ (env: Env(w.tys, g)) (n: Nat) (t: Ty::Flats(e.slots)) => arms.sem(w, Cons(Enum(i), g), Pair(e.of(n, t), env));
            trans(cong_fn(λ (x: Ty::at(g, c).sem(w.tys)) => e.choose(eq, R, arm(e1), Ty::cast(w.tys, Ty::at(g, c), Enum(i), x)), a(c, h.left)),
                e.choose_ext(eq, R, arm(e1), arm(e2), λ n t => Tm::sem_kept(arms, w, Tm::under(keep), Cons(Enum(i), g), Pair(e.of(n, t), e1), Pair(e.of(n, t), e2),
                    h.right, Env::agree_under(w.tys, g, Enum(i), keep, e.of(n, t), e.of(n, t), refl, e1, e2, a)),
                    Ty::cast(w.tys, Ty::at(g, c), Enum(i), Env::get(w.tys, g, e2, c))))
        },
        Inject(i, k, args) => λ keep g e1 e2 h a => {
            let e = w.tys.ens(i);
            cong_fn(λ (fl: Ty::Flats(Ty::range(e.slots, e.lo(k), e.arity(k)))) => e.of(k, Ty::spread(e.slots, e.lo(k), e.arity(k), fl)),
                Tm::slots_kept(w, g, keep, e1, e2, a, Ty::range(e.slots, e.lo(k), e.arity(k)), args, h))
        },
        Slot(i, j, of) => λ keep g e1 e2 h a => cong_fn(λ (x: Ty::at(g, of).sem(w.tys)) =>
            Ty::at(w.tys.ens(i).slots, j).of_slot(w.tys, Ty::flat_nth(w.tys.ens(i).slots, w.tys.ens(i).fields(Ty::cast(w.tys, Ty::at(g, of), Enum(i), x)), j)),
            a(of, h)),
        Iterate(init, test, body) => λ keep g e1 e2 h a => {
            let st = Ty::at(g, init);
            let inner = Cons(st, g);
            let turn = λ (env: Env(w.tys, g)) (s: st.sem(w.tys)) => loop::Step::turn(
                Ty::cast(w.tys, test.ty(w, inner), Bit, test.sem(w, inner, Pair(s, env))),
                λ _ => Ty::cast(w.tys, body.ty(w, inner), st, body.sem(w, inner, Pair(s, env))), s);
            let under = λ (s: st.sem(w.tys)) => Env::agree_under(w.tys, g, st, keep, s, s, refl, e1, e2, a);
            trans(cong_fn(λ (x: st.sem(w.tys)) => loop::Loop::steps(loop::Loop::passes(), turn(e1), x), a(init, h.left)),
                loop::Loop::steps_ext(turn(e1), turn(e2), λ s => eq2(λ (b: Bool) (y: st.sem(w.tys)) => loop::Step::turn(b, λ _ => y, s),
                    cong_fn(λ (x: test.ty(w, inner).sem(w.tys)) => Ty::cast(w.tys, test.ty(w, inner), Bit, x),
                        Tm::sem_kept(test, w, Tm::under(keep), inner, Pair(s, e1), Pair(s, e2), h.right.left, under(s))),
                    cong_fn(λ (x: body.ty(w, inner).sem(w.tys)) => Ty::cast(w.tys, body.ty(w, inner), st, x),
                        Tm::sem_kept(body, w, Tm::under(keep), inner, Pair(s, e1), Pair(s, e2), h.right.right, under(s)))),
                    loop::Loop::passes(), Env::get(w.tys, g, e2, init)))
        },
    }
}

// The context carried: the ports read (`src`, each variable's in turn),
// each variable's port inside a pass (`inner`), and the code of each word
// carried (`cells`), bound at `at, at + 1, …`.
record Carry { src: List<Nat>, inner: List<Nat>, cells: List<Ty> }

// A variable a loop does not read is left out of its carry when a pass can
// read some value of its code back from ports it already has
// (`Ty::fill`): a word or a count from any port, a buffer (whose value no
// port holds) anywhere, and a record of the state's code, of words, from the
// state's own ports (the state's first value is such a record) when it has
// no enum field (an enum field's tag word reads back as its value only up
// to its fitting, `Table::round`).
fn Ty::Fills(self t: Ty, tys: Table) → Type {
    match t { Word(_) => True, Bit => False, ByteList(_) => True, Lines => False, Named(i) => Ty::CellsCarry(tys.fields(i)) ∧ Ty::NoEnums(tys.recs(i).fields), Count => True, Enum(_) => False }
}

fn Ty::read_flat(self f: Ty, values: Valuation(), port: Nat) → f.Flat() {
    match f as λ u => u.Flat() {
        Word(w) => values(w, port), Bit => False, ByteList(_) => Nil, Lines => Nil, Named(_) => trivial, Count => values(64, port).toNat(), Enum(_) => trivial,
    }
}

fn Ty::read_flats(fs: List<Ty>, values: Valuation()) → Nat → Ty::Flats(fs) {
    match fs { Nil => λ _ => trivial, Cons(f, rest) => λ port => Pair(f.read_flat(values, port), Ty::read_flats(rest, values, port + 1)) }
}

theorem Ty::read_flats_hold(fs: List<Ty>, values: Valuation()): Ty::CellsCarry(fs) → (port: Nat) → Ty::FieldsHold(fs, values, port, Ty::read_flats(fs, values, port)) {
    match fs {
        Nil => λ _ port => trivial,
        Cons(f, rest) => λ ok port => ⟨(match f as λ u => u.CellCarries() → u.FlatHolds(values, port, u.read_flat(values, port)) {
                Word(_) => λ _ => refl, Bit => λ never => false_elim(never), ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
                Named(_) => λ never => false_elim(never), Count => λ _ => refl, Enum(_) => λ never => false_elim(never),
            })(ok.left), Ty::read_flats_hold(rest, values, ok.right, port + 1)⟩,
    }
}

// What a port holds, read at a code that fills; any other code keeps `v`.
fn Ty::fill(self t: Ty, tys: Table, values: Valuation(), port: Nat) → t.sem(tys) → t.sem(tys) {
    match t as λ u => u.sem(tys) → u.sem(tys) {
        Word(w) => λ _ => values(w, port),
        Bit => λ v => v,
        ByteList(_) => λ v => v,
        Lines => λ v => v,
        Named(i) => λ _ => tys.mk(i, Ty::read_flats(tys.fields(i), values, port)),
        Count => λ _ => values(64, port).toNat(),
        Enum(_) => λ v => v,
    }
}

theorem Ty::fill_holds(self t: Ty, tys: Table, values: Valuation(), port: Nat): t.Fills(tys) → (v: t.sem(tys)) →
    t.Holds(tys, values, port, t.fill(tys, values, port, v)) {
    match t {
        Word(_) => λ _ v => refl,
        Bit => λ never => false_elim(never),
        ByteList(_) => λ _ v => trivial,
        Lines => λ never => false_elim(never),
        Named(i) => λ ok v => j(sym(tys.round(i, ok.right, Ty::read_flats(tys.fields(i), values, port))), λ x _ => Ty::FieldsHold(tys.fields(i), values, port, x),
            Ty::read_flats_hold(tys.fields(i), values, ok.left, port)),
        Count => λ _ v => refl,
        Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::fields_below_of_past(fs: List<Ty>): (p, n: Nat) → Fun::past(fs, p) <= n → Ty::FieldsBelow(fs, p, n) {
    match fs {
        Nil => λ p n _ => trivial,
        Cons(_, rest) => λ p n le => ⟨Nat::le_trans(p + 1, Fun::past(rest, p + 1), n, Fun::past_ge(rest, p + 1), le),
            Ty::fields_below_of_past(rest, p + 1, n, le)⟩,
    }
}

// A value whose ports end by `n` is below it.
theorem Ty::below_cells(self t: Ty, tys: Table, p, n: Nat): Fun::past(t.cells(tys), p) <= n → t.Below(tys, p, n) {
    match t {
        Word(_) => λ le => le, Bit => λ le => le, ByteList(_) => λ le => le, Lines => λ le => le,
        Named(i) => λ le => Ty::fields_below_of_past(tys.fields(i), p, n, le),
        Count => λ le => le,
        Enum(i) => λ le => Ty::fields_below_of_past(Cons(Word(64), tys.ens(i).slots), p, n, le),
    }
}

// Where a left-out variable reads back from, below anything past `at`
// (the state's ports, from `home`, end by `at`).
record DropAt(tys: Table, t, st: Ty, home, at: Nat) {
    port: Nat,
    fills: t.Fills(tys),
    below: (n: Nat) → at < n → Fun::past(st.cells(tys), home) <= at → t.Below(tys, port, n),
}

fn Ty::drop_at(self t: Ty, tys: Table, st: Ty, home, at: Nat) → Option<DropAt(tys, t, st, home, at)> {
    match t as λ u => Option<DropAt(tys, u, st, home, at)> {
        Word(w) => Some(DropAt(port := at, fills := trivial, below := λ n lt _ => lt)),
        Bit => None,
        ByteList(c) => Some(DropAt(port := at, fills := trivial, below := λ n lt _ => lt)),
        Lines => None,
        Named(i) => Named(i).check(st).and_then(λ e => Ty::check_cells(tys.fields(i)).and_then(λ cc =>
            Ty::check_no_enums(tys.recs(i).fields).and_then(λ ne => Some(DropAt(port := home, fills := ⟨cc, ne⟩, below := λ n lt le =>
                j(sym(e), λ u _ => u.Below(tys, home, n), st.below_cells(tys, home, n,
                    Nat::le_trans(Fun::past(st.cells(tys), home), at, n, le, Nat::le_of_lt(at, n, lt))))))))),
        Count => Some(DropAt(port := at, fills := trivial, below := λ n lt _ => lt)),
        Enum(_) => None,
    }
}

// Whether `drop_at` may answer (a guess `keeps` makes; `drop_at` decides).
fn Ty::can_drop(self t: Ty, st: Ty) → Bool {
    match t { Word(_) => True, Bit => False, ByteList(_) => True, Lines => False, Named(_) => match t.equation(st) { Inl(_) => True, Inr(_) => False }, Count => True, Enum(_) => False }
}

// Which of the context's variables a loop carries, one flag each: those
// its test or body reads (`vs`), and any a pass could not read back.
fn Tm::keeps(g: List<Ty>, st: Ty, vs: List<Nat>, i: Nat) → List<Bool> {
    match g { Nil => Nil, Cons(t, rest) => Cons(Tm::mem_nat(vs, i) || !t.can_drop(st), Tm::keeps(rest, st, vs, i + 1)) }
}

fn Tm::flag(ks: List<Bool>, i: Nat) → Bool {
    match ks { Nil => False, Cons(k, more) => match i { Zero => k, Succ(j) => Tm::flag(more, j) } }
}

// The context carried, a variable at a time: a carried one's ports read
// (`src`) and its cells, bound at `at, at + 1, …`; each variable's port
// inside a pass (`inner`), a left-out one's where it reads back (`drop_at`).
fn Tm::carry(tys: Table, st: Ty, home: Nat, g: List<Ty>) → List<Bool> → List<Nat> → Nat → Option<Carry> {
    match g {
        Nil => λ ks ports at => match ports { Nil => Some(Carry(Nil, Nil, Nil)), Cons(_, _) => None },
        Cons(t, rest) => λ ks ports at => match ports {
            Nil => None,
            Cons(p, ps) => match ks {
                Nil => None,
                Cons(k, more) => match k {
                    True => t.check_carries(tys).and_then(λ _ => Tm::carry(tys, st, home, rest, more, ps, Fun::past(t.cells(tys), at)).and_then(λ c =>
                        Some(Carry(Fun::param_ids(t.cells(tys), p) ++ c.src, Cons(at, c.inner), t.cells(tys) ++ c.cells)))),
                    False => t.drop_at(tys, st, home, at).and_then(λ d => Tm::carry(tys, st, home, rest, more, ps, at).and_then(λ c =>
                        Some(Carry(c.src, Cons(d.port, c.inner), c.cells)))),
                },
            },
        },
    }
}

// The environment a pass holds: a carried variable's value, a left-out
// one's read back from its port.
fn Env::refill(tys: Table, g: List<Ty>) → List<Bool> → List<Nat> → Valuation() → Env(tys, g) → Env(tys, g) {
    match g {
        Nil => λ ks inner b env => env,
        Cons(t, rest) => λ ks inner b env => match ks {
            Nil => env,
            Cons(k, more) => Pair(match k as λ _ => t.sem(tys) { True => env.fst, False => t.fill(tys, b, inner.head_or(0), env.fst) },
                Env::refill(tys, rest, more, inner.tail(), b, env.snd)),
        },
    }
}

theorem Env::refill_agree(tys: Table, g: List<Ty>): (ks: List<Bool>) → (inner: List<Nat>) → (b: Valuation()) → (env: Env(tys, g)) →
    Env::Agree(tys, g, λ i => Tm::flag(ks, i), env, Env::refill(tys, g, ks, inner, b, env)) {
    match g {
        Nil => λ ks inner b env i _ => refl,
        Cons(t, rest) => λ ks inner b env => match ks as λ l => Env::Agree(tys, Cons(t, rest), λ i => Tm::flag(l, i), env, Env::refill(tys, Cons(t, rest), l, inner, b, env)) {
            Nil => λ i _ => refl,
            Cons(k, more) => λ i => match i as λ m => Tm::flag(Cons(k, more), m) = True →
                Env::get(tys, Cons(t, rest), env, m) = Env::get(tys, Cons(t, rest), Env::refill(tys, Cons(t, rest), Cons(k, more), inner, b, env), m) {
                Zero => λ h => (match k as λ k2 => k2 = True → env.fst = (match k2 as λ _ => t.sem(tys) { True => env.fst, False => t.fill(tys, b, inner.head_or(0), env.fst) }) {
                    True => λ _ => refl,
                    False => λ (no: False = True) => absurd(no),
                })(h),
                Succ(j) => λ h => Env::refill_agree(tys, rest, more, inner.tail(), b, env.snd, j, h),
            },
        },
    }
}

// A `while` loop of state code `st`, the state at port `pi`, its test and
// body lowered to `lt` and `lb`. Ids from `next`: the bound, the state's
// parameters, the context's (from `at`), the count, and a pass's own from
// there: the test's, the body's, the branch that moves the next state to
// fresh ports (the body's value while the test holds, the state itself once
// it fails), and the exit bit, set where the test failed. Then the loop's
// outputs, the state's first (the result), and its exhausted bit. The loop
// is given `Tm::passes()` passes, the most a word counts, which is the
// meaning's fuel: a loop out of passes answers its state, as `Loop::steps`
// does out of fuel, so no pass follows it.
// The pass's branch: the next state at fresh ports from `lb.next`.
fn Tm::iter_branch(tys: Table, st: Ty, next: Nat, lt, lb: Lowered) → Lowered {
    Tm::branch_lowered(tys, st, lt.result, lb, Lowered(nodes_region(Nil), next + 1, lb.next))
}

// A pass: the test, the branch, and the exit bit, set where the test's bit
// is zero (the test's bit with 1 exclusive-ored in: a bit has no compare).
fn Tm::iter_pass(tys: Table, st: Ty, next: Nat, lt, lb: Lowered) → StructuredRegion {
    Compose(lt.region, Compose(Tm::iter_branch(tys, st, next, lt, lb).region,
        nodes_region([Const(1, Tm::iter_branch(tys, st, next, lt, lb).next, 1),
            BitXor(1, Tm::iter_branch(tys, st, next, lt, lb).next + 1, lt.result, Tm::iter_branch(tys, st, next, lt, lb).next)])))
}

fn Tm::iter_region(tys: Table, st: Ty, pi, next: Nat, c: Carry, lt, lb: Lowered) → Lowered {
    let z = Tm::iter_branch(tys, st, next, lt, lb).next;
    let at = Fun::past(st.cells(tys), next + 1);
    let all = st.cells(tys) ++ c.cells;
    Lowered(Compose(nodes_region([Const(64, next, Tm::passes())]),
            Loop(Fun::param_ids(st.cells(tys), pi) ++ c.src, next, Fun::param_ids(all, next + 1), Fun::past(c.cells, at),
                Tm::iter_pass(tys, st, next, lt, lb), z + 1, Fun::param_ids(st.cells(tys), lb.next) ++ Fun::param_ids(c.cells, at),
                Fun::param_ids(all, z + 2), Fun::past(all, z + 2))),
        z + 2, Fun::past(all, z + 2) + 1)
}

// The checks after both lowerings: a test of a bit, a body of the state's
// code.
fn Tm::iter_checked(w: World, st: Ty, inner: List<Ty>, test, body: Tm, pi, next: Nat, c: Carry, lt, lb: Lowered) → Option<Lowered> {
    Tm::ty(test, w, inner).check(Bit).and_then(λ _ => Tm::ty(body, w, inner).check(st).and_then(λ _ =>
        Some(Tm::iter_region(w.tys, st, pi, next, c, lt, lb))))
}

// The context's carry starts past the state's parameters; the test's ids
// past the count.
fn Tm::iter_at(tys: Table, st: Ty, next: Nat) → Nat { Fun::past(st.cells(tys), next + 1) }

// The flags of what a loop carries, and what its test and body may read
// (the state, variable 0, and the carried).
fn Tm::iter_keeps(g: List<Ty>, st: Ty, test, body: Tm) → List<Bool> { Tm::keeps(g, st, Tm::unbind(test.vars()) ++ Tm::unbind(body.vars()), 0) }

fn Tm::iter_keep(g: List<Ty>, st: Ty, test, body: Tm) → Nat → Bool { Tm::under(λ i => Tm::flag(Tm::iter_keeps(g, st, test, body), i)) }

fn Tm::lower_iterate(w: World, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test, body: Tm,
    lower_test: List<Nat> → Nat → Option<Lowered>, lower_body: List<Nat> → Nat → Option<Lowered>) → Option<Lowered> {
    Ty::at(g, init).check_carries(w.tys).and_then(λ _ =>
    Tm::both(test.check_within(Tm::iter_keep(g, Ty::at(g, init), test, body)), body.check_within(Tm::iter_keep(g, Ty::at(g, init), test, body))).and_then(λ _ =>
    Tm::carry(w.tys, Ty::at(g, init), next + 1, g, Tm::iter_keeps(g, Ty::at(g, init), test, body), ports, Tm::iter_at(w.tys, Ty::at(g, init), next)).and_then(λ c =>
    lower_test(Cons(next + 1, c.inner), Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1).and_then(λ lt =>
    lower_body(Cons(next + 1, c.inner), lt.next).and_then(λ lb =>
        Tm::iter_checked(w, Ty::at(g, init), Cons(Ty::at(g, init), g), test, body, pi, next, c, lt, lb))))))
}

fn Tm::lower(self t: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat) → Option<Lowered> {
    match t {
        Var(i) => port_at(ports, i).and_then(λ p => Some(Lowered(nodes_region(Nil), p, next))),
        Lit(c, n) => Tm::lower_lit(w.tys, c, n, next),
        Prim(op, args) => Tm::lower_prim(op, w.tys, g, ports, next, args),
        // The body sees the term's port as variable 0, and takes fresh ids
        // above the term's.
        Let(e, body) => Tm::lower(e, w, g, ports, next).and_then(λ le =>
            Tm::lower(body, w, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb))),
        // Each arm from the same context; the second's fresh ids above the
        // first's (either may run, never both).
        If(c, yes, no) => Tm::lower(yes, w, g, ports, next).and_then(λ ly =>
            Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))),
        // The convoyed equation is erased: the same branch as `If`.
        IfEq(c, yes, no) => Tm::lower(yes, w, g, ports, next).and_then(λ ly =>
            Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))),
        Make(i, args) => Tm::lower_make(w, g, ports, next, i, args),
        Field(i, k, of) => Tm::lower_field(w, g, ports, next, i, k, of),
        Call(f, args) => Tm::lower_call(w, g, ports, next, f, args),
        Fold(_, _, _) => None,
        // A fuel's `match` is a loop function's body (`Fun::lower_loop`),
        // lowered there and nowhere else.
        Case(_, _, _) => None,
        Byte(k, i, length) => Tm::lower_byte(g, ports, next, k, i, length),
        // The arms read the constructor at the enum's own port: the
        // constructor its word names is the one `pick` chose.
        Pick(i, c, arms, eq) => port_at(ports, c).and_then(λ pc =>
            Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next))),
        Inject(i, k, args) => Tm::lower_inject(w, g, ports, next, i, k, args),
        Slot(i, j, of) => Tm::lower_slot(w, g, ports, next, i, j, of),
        // A `while` loop: a FunctionIR loop over the state and the context
        // it carries (`Tm::lower_iterate`).
        Iterate(init, test, body) => port_at(ports, init).and_then(λ pi => Tm::lower_iterate(w, g, ports, next, init, pi, test, body,
            λ ps k => Tm::lower(test, w, Cons(Ty::at(g, init), g), ps, k), λ ps k => Tm::lower(body, w, Cons(Ty::at(g, init), g), ps, k))),
    }
}

// ---------------------------------------------------------------------------
// Soundness.

// What a lowering promises: from any valuation where the environment holds
// and the ports are below `next`, with calls answered by the program's
// meanings, the region's evaluation moves `next` up, writes only at or
// above it, and leaves the term's meaning at its result.
fn Tm::LowerHolds(self t: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat, r: Option<Lowered>) → Type {
    match r {
        None => True,
        Some(c) => (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
            EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
            (next <= c.next) ∧ (Tm::ty(t, w, g).Below(w.tys, c.result, c.next) ∧ (Keeps(values, c.region.eval(call, values, buffers := w.spans), next) ∧
                Tm::ty(t, w, g).Holds(w.tys, c.region.eval(call, values, buffers := w.spans), c.result, Tm::sem(t, w, g, env)))),
    }
}

// A region that sets one fresh port: what it promises, from the value it
// leaves there.
theorem Tm::set_sound(tys: Table, values: Valuation(), next: Nat, r: Ty, one: r.OnePort(), v: (wd: Nat) → BitVec(wd), m: r.sem(tys),
    h: r.Holds(tys, Valuation::set(values, next, v), next, m)):
    (next <= next + 1) ∧ (r.Below(tys, next, next + 1) ∧ (Keeps(values, Valuation::set(values, next, v), next) ∧
        r.Holds(tys, Valuation::set(values, next, v), next, m))) {
    ⟨Nat::le_succ_r(next, next, next.le_refl()), ⟨r.one_below(tys, next, next + 1, one, next.lt_succ_self()),
        ⟨λ wd id lt => Valuation::set_other(values, next, v, wd, id, Nat::ne_of_lt(id, next, lt)), h⟩⟩⟩
}

// An operand's port holds the meaning's operand, cast to the code the
// lowering checked.
theorem Tm::operand(w: World, g: List<Ty>, ports: List<Nat>, values: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values, g, ports, env), a, pa: Nat, at_a: port_at(ports, a) = Some(pa), t: Ty, ea: Ty::at(g, a) = t):
    t.Holds(w.tys, values, pa, Ty::cast(w.tys, Ty::at(g, a), t, Env::get(w.tys, g, env, a))) {
    Ty::cast_holds(w.tys, values, pa, Ty::at(g, a), t, ea, Env::get(w.tys, g, env, a), env_holds_at(w.tys, values, g, ports, env, held, a, pa, at_a))
}

// The node equations the primitive table reads (design §6.3's first row):
// a word operation at its width, a comparison as its bit, a bit operation
// on one-bit words.
theorem Tm::word_op_holds(values: Valuation(), next, pa, pb, width: Nat, op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd),
    x, y: BitVec(width), hx: values(width, pa) = x, hy: values(width, pb) = y):
    Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb)), width, next) = op(width, x, y) {
    trans(Valuation::set_here(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb)), width), eq2(op(width), hx, hy))
}

theorem Tm::cmp_op_holds(values: Valuation(), next, pa, pb, width: Nat, cmp: BitVec(width) → BitVec(width) → Bool,
    x, y: BitVec(width), hx: values(width, pa) = x, hy: values(width, pb) = y):
    Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb))), 1, next) = BitVec::ofBool(cmp(x, y)) {
    trans(Valuation::set_here(values, next, bit_value(cmp(values(width, pa), values(width, pb))), 1),
        trans(bit_value_bit(cmp(values(width, pa), values(width, pb))), cong_fn(BitVec::ofBool, eq2(cmp, hx, hy))))
}

theorem Tm::band_ofBool(a, b: Bool): BitVec::ofBool(a).band(BitVec::ofBool(b)) = BitVec::ofBool(a.and(b)) {
    match a { False => match b { False => refl, True => refl }, True => match b { False => refl, True => refl } }
}

theorem Tm::bor_ofBool(a, b: Bool): BitVec::ofBool(a).bor(BitVec::ofBool(b)) = BitVec::ofBool(a.or(b)) {
    match a { False => match b { False => refl, True => refl }, True => match b { False => refl, True => refl } }
}

theorem Tm::bxor_one(a: Bool): BitVec::ofBool(a).bxor(BitVec::ofNat(1)) = BitVec::ofBool(a.not()) {
    match a { False => refl, True => refl }
}

theorem Tm::bit_code_holds(tys: Table, n: Nat): BitVec::ofBool(Tm::lit(Bit, n, tys)) = BitVec::ofNat(Tm::bit_code(n)) {
    match n { Zero => refl, Succ(_) => refl }
}

// One word node, its operands of the code `Word(width)`.
theorem Tm::word_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb), width: Nat,
    op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd), ea: Ty::at(g, a) = Word(width), eb: Ty::at(g, b) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next) ∧
        Word(width).Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next,
            op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
                Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => op(wd, values(wd, pa), values(wd, pb)),
        op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b))),
        Tm::word_op_holds(values, next, pa, pb, width, op, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)),
            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea),
            Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Word(width), eb)))
}

// One comparison node: its bit.
theorem Tm::cmp_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb), width: Nat,
    cmp: BitVec(width) → BitVec(width) → Bool, ea: Ty::at(g, a) = Word(width), eb: Ty::at(g, b) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb)))), next) ∧
        Bit.Holds(w.tys, Valuation::set(values, next, bit_value(cmp(values(width, pa), values(width, pb)))), next,
            cmp(Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
                Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Bit, trivial, bit_value(cmp(values(width, pa), values(width, pb))),
        cmp(Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b))),
        Tm::cmp_op_holds(values, next, pa, pb, width, cmp, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)),
            Ty::cast(w.tys, Ty::at(g, b), Word(width), Env::get(w.tys, g, env, b)),
            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea),
            Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Word(width), eb)))
}

// One bitwise node on two bits: the connective `f` its node computes on
// one-bit words (`law`).
theorem Tm::bit_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb),
    op: (wd: Nat) → BitVec(wd) → BitVec(wd) → BitVec(wd), f: Bool → Bool → Bool,
    law: (x, y: Bool) → op(1, BitVec::ofBool(x), BitVec::ofBool(y)) = BitVec::ofBool(f(x, y)),
    ea: Ty::at(g, a) = Bit, eb: Ty::at(g, b) = Bit):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next) ∧
        Bit.Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa), values(wd, pb))), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a)), Ty::cast(w.tys, Ty::at(g, b), Bit, Env::get(w.tys, g, env, b)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a));
        let y = Ty::cast(w.tys, Ty::at(g, b), Bit, Env::get(w.tys, g, env, b));
        Tm::set_sound(w.tys, values, next, Bit, trivial, λ wd => op(wd, values(wd, pa), values(wd, pb)), f(x, y),
            trans(Tm::word_op_holds(values, next, pa, pb, 1, op, BitVec::ofBool(x), BitVec::ofBool(y),
                Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Bit, ea),
                Tm::operand(w, g, ports, values, env, held, b, pb, at_b, Bit, eb)), law(x, y)))
    }
}

// One word node on one operand of the code `Word(width)`, its value at
// every width that width's operation (an immediate shift).
theorem Tm::word1_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), width: Nat,
    op: (wd: Nat) → BitVec(wd) → BitVec(wd), ea: Ty::at(g, a) = Word(width)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => op(wd, values(wd, pa))), next) ∧
        Word(width).Holds(w.tys, Valuation::set(values, next, λ wd => op(wd, values(wd, pa))), next,
            op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => op(wd, values(wd, pa)),
        op(width, Ty::cast(w.tys, Ty::at(g, a), Word(width), Env::get(w.tys, g, env, a))),
        trans(Valuation::set_here(values, next, λ wd => op(wd, values(wd, pa)), width),
            cong_fn(op(width), Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(width), ea))))
}

// One `Resize` from `Word(from)` to `Word(to)`: its value is the operand's
// number at the result's width, which is the operation `f` (`law`: a zero
// extension or a truncation).
theorem Tm::resize_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), from, to: Nat,
    f: BitVec(from) → BitVec(to), law: (x: BitVec(from)) → BitVec::ofNat(x.toNat(), n := to) = f(x), ea: Ty::at(g, a) = Word(from)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat())), next) ∧
        Word(to).Holds(w.tys, Valuation::set(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat())), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a));
        Tm::set_sound(w.tys, values, next, Word(to), trivial, λ wd => BitVec::ofNat(values(from, pa).toNat()), f(x),
            trans(Valuation::set_here(values, next, λ wd => BitVec::ofNat(values(from, pa).toNat()), to),
                trans(cong_fn(λ (y: BitVec(from)) => BitVec::ofNat(y.toNat(), n := to),
                        Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(from), ea)),
                    law(x))))
    }
}

// The same for a `SignResize`: its value at the output's width is the
// operand read in two's complement there.
theorem Tm::sresize_node_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), from, to: Nat,
    f: BitVec(from) → BitVec(to), law: (x: BitVec(from)) → x.sresize(to) = f(x), ea: Ty::at(g, a) = Word(from)):
    (call: Answers()) → Tm::CallsAgree(w, call) → (values: Valuation()) → (env: Env(w.tys, g)) →
    EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (next <= next + 1) ∧ ((next < next + 1) ∧ (Keeps(values, Valuation::set(values, next, λ wd => values(from, pa).sresize(wd)), next) ∧
        Word(to).Holds(w.tys, Valuation::set(values, next, λ wd => values(from, pa).sresize(wd)), next,
            f(Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a)))))) {
    λ call agree values env held below => {
        let x = Ty::cast(w.tys, Ty::at(g, a), Word(from), Env::get(w.tys, g, env, a));
        Tm::set_sound(w.tys, values, next, Word(to), trivial, λ wd => values(from, pa).sresize(wd), f(x),
            trans(Valuation::set_here(values, next, λ wd => values(from, pa).sresize(wd), to),
                trans(cong_fn(λ (y: BitVec(from)) => y.sresize(to),
                        Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(from), ea)),
                    law(x))))
    }
}

// A check of the operand's code, then the leaf.
theorem Tm::unary_sound(P: Option<Lowered> → Type, none: P(None), g: List<Ty>, a: Nat, t: Ty, l: Lowered,
    leaf: Ty::at(g, a) = t → P(Some(l))): P(Tm::unary(g, a, t, l)) {
    Option::and_then_elim(P, none, Ty::at(g, a).check(t), λ _ => Some(l), λ ea _ => leaf(ea))
}

// A check of both operands' codes, then the leaf.
theorem Tm::binary_sound(P: Option<Lowered> → Type, none: P(None), g: List<Ty>, a, b: Nat, t: Ty, l: Lowered,
    leaf: Ty::at(g, a) = t → Ty::at(g, b) = t → P(Some(l))): P(Tm::binary(g, a, b, t, l)) {
    Option::and_then_elim(P, none, Ty::at(g, a).check(t), λ _ => Tm::binary_b(g, b, t, l), λ ea _ =>
    Option::and_then_elim(P, none, Ty::at(g, b).check(t), λ _ => Some(l), λ eb _ => leaf(ea, eb)))
}

theorem Tm::lower_lit_sound(w: World, g: List<Ty>, ports: List<Nat>, next: Nat, c: Ty, n: Nat):
    Tm::LowerHolds(Lit(c, n), w, g, ports, next, Tm::lower_lit(w.tys, c, n, next)) {
    match c {
        Word(width) => λ call agree values env held below =>
            Tm::set_sound(w.tys, values, next, Word(width), trivial, λ wd => BitVec::ofNat(n), BitVec::ofNat(n),
                Valuation::set_here(values, next, λ wd => BitVec::ofNat(n), width)),
        Bit => λ call agree values env held below =>
            Tm::set_sound(w.tys, values, next, Bit, trivial, λ wd => BitVec::ofNat(Tm::bit_code(n)), Tm::lit(Bit, n, w.tys),
                trans(Valuation::set_here(values, next, λ wd => BitVec::ofNat(Tm::bit_code(n)), 1), sym(Tm::bit_code_holds(w.tys, n)))),
        ByteList(_) => trivial,
        Lines => trivial,
        Named(_) => trivial,
        Count => trivial,
        // The constructor's tag, a constant: its word is the tag, which
        // `of` and the tag invert (`EnumInfo.tag_of`).
        Enum(i) => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Lit(Enum(i), n), w, g, ports, next, r);
            let e = w.tys.ens(i);
            Option::and_then_elim(P, trivial, Tm::check_true(n.leb(e.last)), λ _ => Tm::lit_bare(w.tys, i, n, next), λ among _ =>
            Option::and_then_elim(P, trivial, Ty::check_bare(e.slots), λ _ => Tm::lit_tag(n, next), λ bare _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((n + 1).leb(Nat::pow(2, 64))), λ _ => Some(Tm::one_node(Const(64, next, n), next)), λ fits _ =>
                λ call agree values env held below => {
                    let le: (n <= e.last) = Nat::leb_sound(n, e.last, among);
                    let set = λ (wd: Nat) => BitVec::ofNat(n, n := wd);
                    let word: (Valuation::set(values, next, set)(64, next).toNat() = n) =
                        trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), Valuation::set_here(values, next, set, 64)),
                            BitVec::toNat_ofNat(64, n, Nat::leb_sound(n + 1, Nat::pow(2, 64), fits)));
                    let d = Ty::flats_default(e.slots);
                    let at: Enum(i).Holds(w.tys, Valuation::set(values, next, set), next, e.of(n, d)) =
                        ⟨⟨trans(word, sym(e.tag_of(n, le, d))), j(sym(word), λ m _ => m <= e.last, le)⟩,
                            Ty::bare_holds(e.slots, Valuation::set(values, next, set), next + 1, bare, e.fields(e.of(n, d)))⟩;
                    ⟨Nat::le_succ_r(next, next, next.le_refl()), ⟨⟨next.lt_succ_self(), Ty::bare_below(e.slots, bare, next + 1, next + 1)⟩,
                        ⟨λ wd id lt => Valuation::set_other(values, next, set, wd, id, Nat::ne_of_lt(id, next, lt)), at⟩⟩⟩
                })))
        },
    }
}

theorem Tm::prim2_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next, a, b, pa, pb: Nat,
    at_a: port_at(ports, a) = Some(pa), at_b: port_at(ports, b) = Some(pb)):
    Tm::LowerHolds(Prim(op, [a, b]), w, g, ports, next, Tm::prim2(op, g, next, a, b, pa, pb)) {
    match op {
        Add(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Add(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Add(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.add(y), ea, eb)),
        Sub(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Sub(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Sub(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.sub(y), ea, eb)),
        Band(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Band(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitAnd(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.band(y), ea, eb)),
        Bor(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Bor(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitOr(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.bor(y), ea, eb)),
        Bxor(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Bxor(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(BitXor(width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => x.bxor(y), ea, eb)),
        Eq(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Eq(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Equal(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.eq_bit(y), ea, eb)),
        Ult(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Ult(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(UnsignedLessThan(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.unsigned_lt_bit(y), ea, eb)),
        Slt(width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Slt(width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(SignedLessThan(width, next, pa, pb), next), λ ea eb =>
            Tm::cmp_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ x y => x.signed_lt_bit(y), ea, eb)),
        Conj => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Conj, [a, b]), w, g, ports, next, r), trivial, g, a, b, Bit,
            Tm::one_node(BitAnd(1, next, pa, pb), next), λ ea eb =>
            Tm::bit_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, λ wd x y => x.band(y), λ x y => x.and(y),
                λ x y => Tm::band_ofBool(x, y), ea, eb)),
        Disj => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Disj, [a, b]), w, g, ports, next, r), trivial, g, a, b, Bit,
            Tm::one_node(BitOr(1, next, pa, pb), next), λ ea eb =>
            Tm::bit_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, λ wd x y => x.bor(y), λ x y => x.or(y),
                λ x y => Tm::bor_ofBool(x, y), ea, eb)),
        Neg => trivial,
        Zext(_, _) => trivial,
        Get(_) => trivial,
        Set(_) => trivial,
        ConsLine(_) => trivial,
        ToNat => trivial,
        Trunc(_, _) => trivial,
        Shl(_, _) => trivial, Lshr(_, _) => trivial, Ashr(_, _) => trivial,
        Sext(_, _) => trivial,
        TagIs(_, _) => trivial,
        Apply(o, width) => Tm::binary_sound(λ r => Tm::LowerHolds(Prim(Apply(o, width), [a, b]), w, g, ports, next, r), trivial, g, a, b, Word(width),
            Tm::one_node(Node::Apply(o, width, next, pa, pb), next), λ ea eb =>
            Tm::word_node_sound(w, g, ports, next, a, b, pa, pb, at_a, at_b, width, λ wd x y => o.run(x, y), ea, eb)),
    }
}

// `!x`: the constant leaves the operand's port alone (it is below `next`),
// and the exclusive or with one is the negation.
theorem Tm::neg_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa), ea: Ty::at(g, a) = Bit):
    Tm::LowerHolds(Prim(Neg, [a]), w, g, ports, next, Some(Tm::neg_lowered(next, pa))) {
    λ call agree values env held below => {
        let one = Valuation::set(values, next, λ wd => BitVec::ofNat(1));
        let x = Ty::cast(w.tys, Ty::at(g, a), Bit, Env::get(w.tys, g, env, a));
        let pa_lt: (pa < next) = Ty::below_cast(w.tys, Ty::at(g, a), Bit, ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a));
        let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
        ⟨Nat::le_succ_r(next, next + 1, step), ⟨(next + 1).lt_succ_self(),
            ⟨λ wd id lt => trans(Valuation::set_other(one, next + 1, λ v => one(v, pa).bxor(one(v, next)), wd, id,
                    Nat::ne_of_lt(id, next + 1, Nat::lt_of_lt_of_le(id, next, next + 1, lt, step))),
                Valuation::set_other(values, next, λ v => BitVec::ofNat(1), wd, id, Nat::ne_of_lt(id, next, lt))),
            trans(Valuation::set_here(one, next + 1, λ v => one(v, pa).bxor(one(v, next)), 1),
                trans(eq2(λ (p: BitVec(1)) (q: BitVec(1)) => p.bxor(q),
                        trans(Valuation::set_other(values, next, λ v => BitVec::ofNat(1), 1, pa, Nat::ne_of_lt(pa, next, pa_lt)),
                            Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Bit, ea)),
                        Valuation::set_here(values, next, λ v => BitVec::ofNat(1), 1)),
                    Tm::bxor_one(x)))⟩⟩⟩
    }
}

// `same` on two apart numbers.
theorem Tm::same_apart(a, k: Nat, ne: a ≠ k): a.same(k) = False {
    (match a.same(k) as λ b => a.same(k) = b → a.same(k) = False {
        True => λ e => false_elim(ne(Nat::same_sound(a, k, e))),
        False => λ e => e,
    })(refl)
}

// The compare of an enum's word with a tag before the last is the test of
// its tag.
theorem Tm::tag_sound(w: World, g: List<Ty>, ports: List<Nat>, next, a, pa, i, k: Nat, at_a: port_at(ports, a) = Some(pa),
    ea: Ty::at(g, a) = Enum(i), lt: k < w.tys.ens(i).last, small: k < Nat::pow(2, 64)):
    Tm::LowerHolds(Prim(TagIs(i, k), [a]), w, g, ports, next, Some(Tm::tag_lowered(next, pa, k))) {
    λ call agree values env held below => {
        let e = w.tys.ens(i);
        let constant = Valuation::set(values, next, λ wd => BitVec::ofNat(k));
        let compared = bit_value(constant(64, pa).eq_bit(constant(64, next)));
        let v = Ty::cast(w.tys, Ty::at(g, a), Enum(i), Env::get(w.tys, g, env, a));
        let held_v: e.Names(values(64, pa), v) = Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Enum(i), ea).left;
        let pa_lt: (pa < next) = Ty::below_cast(w.tys, Ty::at(g, a), Enum(i), ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a)).left;
        let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
        let at_pa: (constant(64, pa) = values(64, pa)) = Valuation::set_other(values, next, λ wd => BitVec::ofNat(k), 64, pa, Nat::ne_of_lt(pa, next, pa_lt));
        let at_next: (constant(64, next) = BitVec::ofNat(k)) = Valuation::set_here(values, next, λ wd => BitVec::ofNat(k), 64);
        let test: (constant(64, pa).eq_bit(constant(64, next)) = e.tag(v).same(k)) =
            trans(eq2(λ (x: BitVec(64)) (y: BitVec(64)) => x.eq_bit(y), at_pa, at_next),
                trans(BitVec::eq_bit_nat(64, values(64, pa), BitVec::ofNat(k)),
                    trans(cong_fn(λ (n: Nat) => values(64, pa).toNat().same(n), BitVec::toNat_ofNat(64, k, small)),
                        cong_fn(λ (n: Nat) => n.same(k), held_v.left))));
        ⟨Nat::le_succ_r(next, next + 1, step), ⟨(next + 1).lt_succ_self(),
            ⟨λ wd id lt2 => trans(Valuation::set_other(constant, next + 1, compared, wd, id,
                    Nat::ne_of_lt(id, next + 1, Nat::lt_of_lt_of_le(id, next, next + 1, lt2, step))),
                Valuation::set_other(values, next, λ x => BitVec::ofNat(k), wd, id, Nat::ne_of_lt(id, next, lt2))),
            trans(Valuation::set_here(constant, next + 1, compared, 1),
                trans(bit_value_bit(constant(64, pa).eq_bit(constant(64, next))), cong_fn(BitVec::ofBool, test)))⟩⟩⟩
    }
}

theorem Tm::prim1_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next, a, pa: Nat, at_a: port_at(ports, a) = Some(pa)):
    Tm::LowerHolds(Prim(op, [a]), w, g, ports, next, Tm::prim1(op, w.tys, g, next, a, pa)) {
    match op {
        TagIs(i, k) => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(TagIs(i, k), [a]), w, g, ports, next, r);
            Option::and_then_elim(P, trivial, Ty::at(g, a).check(Enum(i)), λ _ => Tm::tag_below(w.tys, next, pa, i, k), λ ea _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((k + 1).leb(w.tys.ens(i).last)), λ _ => Tm::tag_small(w.tys, next, pa, i, k), λ below_last _ =>
            Option::and_then_elim(P, trivial, Tm::check_true((k + 1).leb(Nat::pow(2, 64))), λ _ => Some(Tm::tag_lowered(next, pa, k)), λ fits _ =>
                Tm::tag_sound(w, g, ports, next, a, pa, i, k, at_a, ea, Nat::leb_sound(k + 1, w.tys.ens(i).last, below_last),
                    Nat::leb_sound(k + 1, Nat::pow(2, 64), fits)))))
        },
        Neg => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(Neg, [a]), w, g, ports, next, r), trivial,
            Ty::at(g, a).check(Bit), λ _ => Some(Tm::neg_lowered(next, pa)), λ ea _ => Tm::neg_sound(w, g, ports, next, a, pa, at_a, ea)),
        ToNat => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(ToNat, [a]), w, g, ports, next, r), trivial,
            Ty::at(g, a).check(Word(64)), λ _ => Some(Lowered(nodes_region(Nil), pa, next)), λ ea _ =>
            λ call agree values env held below =>
                ⟨next.le_refl(), ⟨Ty::below_cast(w.tys, Ty::at(g, a), Word(64), ea, pa, next, below_at(w.tys, g, ports, next, below, a, pa, at_a)),
                    ⟨λ wd id _ => refl, cong_fn(λ (x: BitVec(64)) => x.toNat(), Tm::operand(w, g, ports, values, env, held, a, pa, at_a, Word(64), ea))⟩⟩⟩),
        Zext(width, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Zext(width, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(Resize(width, extra + width, next, pa), next), λ ea =>
            Tm::resize_node_sound(w, g, ports, next, a, pa, at_a, width, extra + width, λ x => x.zero_extend(extra),
                BitVec::ofNat_toNat_zero_extend(width, extra), ea)),
        Trunc(n, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Trunc(n, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(extra + n),
            Tm::one_node(Resize(extra + n, n, next, pa), next), λ ea =>
            Tm::resize_node_sound(w, g, ports, next, a, pa, at_a, extra + n, n, λ x => x.truncate(n, extra),
                BitVec::ofNat_toNat_truncate(n, extra), ea)),
        Shl(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Shl(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(ShiftLeft(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.shift_left(k), ea)),
        Lshr(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Lshr(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(LogicalShiftRight(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.shift_right(k), ea)),
        Ashr(width, k) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Ashr(width, k), [a]), w, g, ports, next, r), trivial, g, a, Word(width),
            Tm::one_node(ArithmeticShiftRight(width, next, pa, k), next), λ ea =>
            Tm::word1_node_sound(w, g, ports, next, a, pa, at_a, width, λ wd x => x.arithmetic_shift_right(k), ea)),
        Sext(n, extra) => Tm::unary_sound(λ r => Tm::LowerHolds(Prim(Sext(n, extra), [a]), w, g, ports, next, r), trivial, g, a, Word(n + 1),
            Tm::one_node(SignResize(n + 1, extra + (n + 1), next, pa), next), λ ea =>
            Tm::sresize_node_sound(w, g, ports, next, a, pa, at_a, n + 1, extra + (n + 1), λ x => x.sign_extend(extra),
                λ x => BitVec::sresize_sign_extend(n, extra, x), ea)),
        _ => trivial,
    }
}

theorem Tm::lower_prim_sound(op: Op, w: World, g: List<Ty>, ports: List<Nat>, next: Nat, args: List<Nat>):
    Tm::LowerHolds(Prim(op, args), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, args)) {
    match args {
        Nil => trivial,
        Cons(a, more) => match more as λ m =>
            Tm::LowerHolds(Prim(op, Cons(a, m)), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, Cons(a, m))) {
            Nil => Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(op, [a]), w, g, ports, next, r), trivial,
                port_at(ports, a), λ pa => Tm::prim1(op, w.tys, g, next, a, pa), λ pa at_a => Tm::prim1_sound(op, w, g, ports, next, a, pa, at_a)),
            Cons(b, rest) => match rest as λ r2 =>
                Tm::LowerHolds(Prim(op, Cons(a, Cons(b, r2))), w, g, ports, next, Tm::lower_prim(op, w.tys, g, ports, next, Cons(a, Cons(b, r2)))) {
                Cons(_, _) => trivial,
                Nil => {
                    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Prim(op, [a, b]), w, g, ports, next, r);
                    Option::and_then_elim(P, trivial, port_at(ports, a), λ pa => Tm::prim2_port_b(op, g, ports, next, a, b, pa), λ pa at_a =>
                    Option::and_then_elim(P, trivial, port_at(ports, b), λ pb => Tm::prim2(op, g, next, a, b, pa, pb), λ pb at_b =>
                        Tm::prim2_sound(op, w, g, ports, next, a, b, pa, pb, at_a, at_b)))
                },
            },
        },
    }
}

// The `If` case, from what each arm's lowering promises.
theorem Tm::if_sound(c: Nat, yes, no: Tm, w: World,
    ih_yes: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(yes, w, g, ports, next, Tm::lower(yes, w, g, ports, next)),
    ih_no: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(no, w, g, ports, next, Tm::lower(no, w, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::LowerHolds(If(c, yes, no), w, g, ports, next, Tm::lower(If(c, yes, no), w, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(If(c, yes, no), w, g, ports, next, r);
    let ty_yes = Tm::ty(yes, w, g);
    let ty_no = Tm::ty(no, w, g);
    Option::and_then_elim(P, trivial, Tm::lower(yes, w, g, ports, next),
        λ ly => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => Tm::lower_branch(w.tys, g, ports, c, ty_yes, ty_no, ly, ln)), λ ly lowered_yes =>
    Option::and_then_elim(P, trivial, Tm::lower(no, w, g, ports, ly.next), λ ln => Tm::lower_branch(w.tys, g, ports, c, ty_yes, ty_no, ly, ln),
        λ ln lowered_no =>
    Option::and_then_elim(P, trivial, port_at(ports, c), λ pc => Tm::branch_checked(w.tys, g, c, ty_yes, ty_no, pc, ly, ln), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Bit), λ _ => Tm::branch_typed(w.tys, ty_yes, ty_no, pc, ly, ln), λ ec _ =>
    Option::and_then_elim(P, trivial, ty_no.check(ty_yes), λ _ => Some(Tm::branch_lowered(w.tys, ty_yes, pc, ly, ln)), λ en _ =>
        λ call agree values env held below => {
            let out = ln.next;
            let first = j(lowered_yes, λ r _ => Tm::LowerHolds(yes, w, g, ports, next, r),
                ih_yes(g, ports, next))(call, agree, values, env, held, below);
            let second = j(lowered_no, λ r _ => Tm::LowerHolds(no, w, g, ports, ly.next, r),
                ih_no(g, ports, ly.next))(call, agree, values, env, held, below_mono(w.tys, g, next, ly.next, first.left, ports, below));
            let mid_yes = ly.region.eval(call, values, buffers := w.spans);
            let mid_no = ln.region.eval(call, values, buffers := w.spans);
            let reaches: (next <= out) = Nat::le_trans(next, ly.next, out, first.left, second.left);
            let scrutinee = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c));
            let bit = Tm::operand(w, g, ports, values, env, held, c, pc, at_c, Bit, ec);
            let chosen = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(scrutinee));
            let no_cast = Ty::cast(w.tys, ty_no, ty_yes, Tm::sem(no, w, g, env));
            let moved_yes = ty_yes.moves_sound(w.tys, w.spans, mid_yes, out, ly.result,
                ty_yes.below_mono(w.tys, ly.result, ly.next, out, second.left, first.right.left), Tm::sem(yes, w, g, env), first.right.right.right);
            let moved_no = ty_yes.moves_sound(w.tys, w.spans, mid_no, out, ln.result, Ty::below_cast(w.tys, ty_no, ty_yes, en, ln.result, out, second.right.left),
                no_cast, Ty::cast_holds(w.tys, mid_no, ln.result, ty_no, ty_yes, en, Tm::sem(no, w, g, env), second.right.right.right));
            let when_true = Compose(ly.region, nodes_region(ty_yes.moves(w.tys, out, ly.result)));
            let when_false = Compose(ln.region, nodes_region(ty_yes.moves(w.tys, out, ln.result)));
            ⟨Nat::le_trans(next, out, ty_yes.past(w.tys, out), reaches, moved_yes.right.right.right), ⟨moved_yes.right.right.left,
                ⟨branch_keeps(values, pc, moved_ports(ty_yes.moves(w.tys, out, ly.result)), when_true, when_false, call, w.spans, next,
                    λ wd id lt => trans(moved_yes.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, out, lt, reaches)), first.right.right.left(wd, id, lt)),
                    λ wd id lt => trans(moved_no.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, out, lt, reaches)),
                        second.right.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, ly.next, lt, first.left)))),
                branch_holds(ty_yes, w.tys, values, pc, moved_ports(ty_yes.moves(w.tys, out, ly.result)), when_true, when_false, call, w.spans, out, scrutinee,
                    Tm::sem(yes, w, g, env), no_cast, chosen, moved_yes.left, moved_no.left)⟩⟩⟩
        })))))
}

// A convoy is the plain match: the equation it carries is read only by
// proofs.
theorem Tm::convoy_match(T: Type, b: Bool, yes, no: T): Tm::convoy(T, b, yes, no) = match b { False => no, True => yes } {
    match b { False => refl, True => refl }
}

// `IfEq` lowers as `If` does, and means what `If` means.
theorem Tm::ifeq_of_if(c: Nat, yes, no: Tm, w: World, g: List<Ty>, ports: List<Nat>, next: Nat):
    (r: Option<Lowered>) → Tm::LowerHolds(If(c, yes, no), w, g, ports, next, r) → Tm::LowerHolds(IfEq(c, yes, no), w, g, ports, next, r) {
    λ r => match r as λ q => Tm::LowerHolds(If(c, yes, no), w, g, ports, next, q) → Tm::LowerHolds(IfEq(c, yes, no), w, g, ports, next, q) {
        None => λ _ => trivial,
        Some(l) => λ h call agree values env held below => {
            let held_if = h(call, agree, values, env, held, below);
            let scrutinee = Ty::cast(w.tys, Ty::at(g, c), Bit, Env::get(w.tys, g, env, c));
            let ty_yes = Tm::ty(yes, w, g);
            ⟨held_if.left, ⟨held_if.right.left, ⟨held_if.right.right.left,
                j(sym(Tm::convoy_match(ty_yes.sem(w.tys), scrutinee, Tm::sem(yes, w, g, env),
                        Ty::cast(w.tys, Tm::ty(no, w, g), ty_yes, Tm::sem(no, w, g, env)))),
                    λ v _ => ty_yes.Holds(w.tys, l.region.eval(call, values, buffers := w.spans), l.result, v), held_if.right.right.right)⟩⟩⟩
        },
    }
}

theorem Tm::nodes_append(buffers: Buffers(), a: List<Node>): (b: List<Node>) → (values: Valuation()) →
    eval_nodes_over(buffers, a ++ b, values) = eval_nodes_over(buffers, b, eval_nodes_over(buffers, a, values)) {
    match a { Nil => λ b values => refl, Cons(n, rest) => λ b values => Tm::nodes_append(buffers, rest, b, n.step(values, buffers := buffers)) }
}

// What sending slots leaves: the widenings write from `next` on, the
// words passed are the slots', and every port passed is below the end.
fn Tm::SlotsSent(buffers: Buffers(), fs: List<Ty>, values: Valuation(), next: Nat, s: Sending, t: Ty::Flats(fs)) → Type {
    (next <= s.next) ∧ (Keeps(values, eval_nodes_over(buffers, s.nodes, values), next) ∧
        ((words_of(eval_nodes_over(buffers, s.nodes, values), s.ports) = Ty::flats_words(fs, t)) ∧ ((x: Nat) → Mem(x, s.ports) → x < s.next)))
}

theorem Tm::send_slots_sound(buffers: Buffers(), fs: List<Ty>): (port, next: Nat) → Ty::Slots(fs) → Ty::FieldsBelow(fs, port, next) → (values: Valuation()) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, port, t) → Tm::SlotsSent(buffers, fs, values, next, Tm::send_slots(fs, port, next), t) {
    match fs {
        Nil => λ port next _ _ values t _ => ⟨next.le_refl(), ⟨λ wd id lt => refl, ⟨refl, λ x never => false_elim(never)⟩⟩⟩,
        Cons(f, rest) => λ port next ok below values t held => {
            let G = λ (s: Sending) => Tm::SlotsSent(buffers, Cons(f, rest), values, next, s, t);
            let narrow = Tm::send_narrow_slot(f, port, next, Tm::send_slots(rest, port + 1, next + 1));
            let wide = Tm::send_wide_slot(port, Tm::send_slots(rest, port + 1, next));
            (match f.slot_narrow() as λ b => f.slot_narrow() = b → G(match b { True => narrow, False => wide }) {
                True => λ _ => {
                    let node = Resize(f.width(), 64, next, port);
                    let set = node.step(values, buffers := buffers);
                    let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
                    let kept: Keeps(values, set, next) = λ wd id lt => Valuation::set_other(values, next, node.value(values, buffers := buffers), wd, id, Nat::ne_of_lt(id, next, lt));
                    let s1 = Tm::send_slots(rest, port + 1, next + 1);
                    let ih = Tm::send_slots_sound(buffers, rest, port + 1, next + 1, ok.right, Ty::fields_below_mono(rest, next, next + 1, step, port + 1, below.right), set, t.snd,
                        Ty::fields_at(rest, values, set, port + 1, port + 1, Ty::fields_kept(rest, values, set, next, kept, port + 1, below.right), t.snd, held.right));
                    let after = eval_nodes_over(buffers, s1.nodes, set);
                    let head: (after(64, next) = f.flat_word(EnumInfo::nones, t.fst)) = trans(ih.right.left(64, next, next.lt_succ_self()),
                        trans(Valuation::set_here(values, next, node.value(values, buffers := buffers), 64), Ty::slot_widened(f, ok.left, values, port, t.fst, held.left)));
                    ⟨Nat::le_trans(next, next + 1, s1.next, step, ih.left),
                        ⟨λ wd id lt => trans(ih.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, next + 1, lt, step)), kept(wd, id, lt)),
                            ⟨eq2(λ (a: BitVec(64)) (r: List<BitVec(64)>) => Cons(a, r), head, ih.right.right.left),
                                λ x mem => match mem {
                                    Inl(e) => j(sym(e), λ y _ => y < s1.next, Nat::lt_of_lt_of_le(next, next + 1, s1.next, next.lt_succ_self(), ih.left)),
                                    Inr(later) => ih.right.right.right(x, later),
                                }⟩⟩⟩
                },
                False => λ e => {
                    let s1 = Tm::send_slots(rest, port + 1, next);
                    let ih = Tm::send_slots_sound(buffers, rest, port + 1, next, ok.right, below.right, values, t.snd, held.right);
                    let after = eval_nodes_over(buffers, s1.nodes, values);
                    let word: (values(64, port) = f.flat_word(EnumInfo::nones, t.fst)) = j(sym(Ty::slot_wide(f, ok.left, e)), λ g _ => (x: g.Flat()) → g.FlatHolds(values, port, x) → values(64, port) = g.flat_word(EnumInfo::nones, x),
                        λ x h => h)(t.fst, held.left);
                    ⟨ih.left, ⟨ih.right.left,
                        ⟨eq2(λ (a: BitVec(64)) (r: List<BitVec(64)>) => Cons(a, r), trans(ih.right.left(64, port, below.left), word), ih.right.right.left),
                            λ x mem => match mem {
                                Inl(same) => j(sym(same), λ y _ => y < s1.next, Nat::lt_of_lt_of_le(port, next, s1.next, below.left, ih.left)),
                                Inr(later) => ih.right.right.right(x, later),
                            }⟩⟩⟩
                },
            })(refl)
        },
    }
}

// A value's pieces are below where its ports end.
theorem Ty::pieces_below(tys: Table, p: Ty, q, next: Nat): p.Sliced(tys) → p.Below(tys, q, next) → Ty::FieldsBelow(p.pieces(tys), q, next) {
    match p {
        Word(_) => λ _ b => ⟨b, trivial⟩, Bit => λ _ b => ⟨b, trivial⟩,
        ByteList(_) => λ never => false_elim(never), Lines => λ never => false_elim(never),
        Named(i) => λ _ b => b, Count => λ never => false_elim(never),
        Enum(i) => λ _ b => b,
    }
}

theorem Tm::send_slots_keeps(buffers: Buffers(), fs: List<Ty>): (port, next: Nat) → (values: Valuation()) →
    (next <= Tm::send_slots(fs, port, next).next) ∧ Keeps(values, eval_nodes_over(buffers, Tm::send_slots(fs, port, next).nodes, values), next) {
    match fs {
        Nil => λ port next values => ⟨next.le_refl(), λ wd id lt => refl⟩,
        Cons(f, rest) => λ port next values => {
            let G = λ (s: Sending) => (next <= s.next) ∧ Keeps(values, eval_nodes_over(buffers, s.nodes, values), next);
            let narrow = Tm::send_narrow_slot(f, port, next, Tm::send_slots(rest, port + 1, next + 1));
            let wide = Tm::send_wide_slot(port, Tm::send_slots(rest, port + 1, next));
            (match f.slot_narrow() as λ b => f.slot_narrow() = b → G(match b { True => narrow, False => wide }) {
                True => λ _ => {
                    let node = Resize(f.width(), 64, next, port);
                    let set = node.step(values, buffers := buffers);
                    let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
                    let ih = Tm::send_slots_keeps(buffers, rest, port + 1, next + 1, set);
                    ⟨Nat::le_trans(next, next + 1, Tm::send_slots(rest, port + 1, next + 1).next, step, ih.left),
                        λ wd id lt => trans(ih.right(wd, id, Nat::lt_of_lt_of_le(id, next, next + 1, lt, step)),
                            Valuation::set_other(values, next, node.value(values, buffers := buffers), wd, id, Nat::ne_of_lt(id, next, lt)))⟩
                },
                False => λ _ => Tm::send_slots_keeps(buffers, rest, port + 1, next, values),
            })(refl)
        },
    }
}

// The widenings write only from `next` on.
theorem Tm::send_keeps(tys: Table, g: List<Ty>, ports: List<Nat>, buffers: Buffers(), ps: List<Ty>):
    (args: List<Nat>) → (next: Nat) → (s: Sending) → Tm::send_args(tys, g, ports, ps, args, next) = Some(s) →
    (values: Valuation()) → (next <= s.next) ∧ Keeps(values, eval_nodes_over(buffers, s.nodes, values), next) {
    match ps {
        Nil => λ args => match args {
            Nil => λ next s e => j(Option::some_inj(Sending(Nil, Nil, next), s, e), λ z _ =>
                (values: Valuation()) → (next <= z.next) ∧ Keeps(values, eval_nodes_over(buffers, z.nodes, values), next),
                λ values => ⟨next.le_refl(), λ wd id lt => refl⟩),
            Cons(a, more) => λ next s e => Option::none_ne_some(s, e,
                (values: Valuation()) → (next <= s.next) ∧ Keeps(values, eval_nodes_over(buffers, s.nodes, values), next)),
        },
        Cons(p, rest) => λ args => match args {
            Nil => λ next s e => Option::none_ne_some(s, e,
                (values: Valuation()) → (next <= s.next) ∧ Keeps(values, eval_nodes_over(buffers, s.nodes, values), next)),
            Cons(a, more) => λ next => {
                let Goal = λ (s: Sending) => (values: Valuation()) → (next <= s.next) ∧ Keeps(values, eval_nodes_over(buffers, s.nodes, values), next);
                let P = λ (o: Option<Sending>) => (s: Sending) → o = Some(s) → Goal(s);
                let none: P(None) = λ s e => Option::none_ne_some(s, e, Goal(s));
                let whole = λ (q: Nat) => p.check_sent(tys).and_then(λ _ => Tm::send_args(tys, g, ports, rest, more, next).and_then(λ s => Some(Tm::send_whole(tys, p, q, s))));
                let sliced = λ (q: Nat) => Tm::send_args(tys, g, ports, rest, more, Tm::send_slots(p.pieces(tys), q, next).next).and_then(λ s =>
                    Some(Tm::then_send(Tm::send_slots(p.pieces(tys), q, next), s)));
                let step = λ (q: Nat) => match p.check_sliced(tys) { Some(_) => sliced(q), None => whole(q) };
                Option::and_then_elim(P, none, port_at(ports, a), λ q => Ty::at(g, a).check(p).and_then(λ _ => step(q)), λ q _ =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(p), λ _ => step(q), λ _ _ =>
                    match p.check_sliced(tys) as λ o => P(match o { Some(_) => sliced(q), None => whole(q) }) {
                        Some(_) => {
                            let s1 = Tm::send_slots(p.pieces(tys), q, next);
                            Option::and_then_elim(P, none, Tm::send_args(tys, g, ports, rest, more, s1.next), λ s => Some(Tm::then_send(s1, s)),
                                λ s2 e2 s e => j(Option::some_inj(Tm::then_send(s1, s2), s, e), λ z _ => Goal(z), λ values => {
                                    let first = Tm::send_slots_keeps(buffers, p.pieces(tys), q, next, values);
                                    let ih = Tm::send_keeps(tys, g, ports, buffers, rest, more, s1.next, s2, e2, eval_nodes_over(buffers, s1.nodes, values));
                                    let same = Tm::nodes_append(buffers, s1.nodes, s2.nodes, values);
                                    ⟨Nat::le_trans(next, s1.next, s2.next, first.left, ih.left),
                                        λ wd id lt => trans(cong_fn(λ (u: Valuation()) => u(wd, id), same),
                                            trans(ih.right(wd, id, Nat::lt_of_lt_of_le(id, next, s1.next, lt, first.left)), first.right(wd, id, lt)))⟩
                                }))
                        },
                        None => Option::and_then_elim(P, none, p.check_sent(tys), λ _ => Tm::send_args(tys, g, ports, rest, more, next).and_then(λ s => Some(Tm::send_whole(tys, p, q, s))), λ _ _ =>
                            Option::and_then_elim(P, none, Tm::send_args(tys, g, ports, rest, more, next), λ s => Some(Tm::send_whole(tys, p, q, s)),
                                λ s1 e1 s e => j(Option::some_inj(Tm::send_whole(tys, p, q, s1), s, e), λ z _ => Goal(z),
                                    λ values => Tm::send_keeps(tys, g, ports, buffers, rest, more, next, s1, e1, values)))),
                    }))
            },
        },
    }
}

// The words a call passes, after its widenings, answer the callee's
// meaning on the meaning's arguments, every word of it.
theorem Tm::send_answers(w: World, g: List<Ty>, ports: List<Nat>, buffers: Buffers(), env: Env(w.tys, g), r: Ty, ps: List<Ty>):
    (args: List<Nat>) → (next: Nat) → (s: Sending) → Tm::send_args(w.tys, g, ports, ps, args, next) = Some(s) →
    (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
    (F: Ty::Arrows(w.tys, ps, r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::AnswersWords(w.tys, ps, r, F, ans) →
    ans(words_of(eval_nodes_over(buffers, s.nodes, values), s.ports)) = Ty::result_words(w.tys, r, Tm::apply(w, g, env, r, ps, F, args)) {
    match ps {
        Nil => λ args => match args {
            Nil => λ next s e => j(Option::some_inj(Sending(Nil, Nil, next), s, e), λ z _ =>
                (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
                (F: Ty::Arrows(w.tys, Nil, r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::AnswersWords(w.tys, Nil, r, F, ans) →
                ans(words_of(eval_nodes_over(buffers, z.nodes, values), z.ports)) = Ty::result_words(w.tys, r, Tm::apply(w, g, env, r, Nil, F, Nil)),
                λ values held below F ans answers => answers),
            Cons(a, more) => λ next s e => Option::none_ne_some(s, e,
                (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
                (F: Ty::Arrows(w.tys, Nil, r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::AnswersWords(w.tys, Nil, r, F, ans) →
                ans(words_of(eval_nodes_over(buffers, s.nodes, values), s.ports)) = Ty::result_words(w.tys, r, Tm::apply(w, g, env, r, Nil, F, Cons(a, more)))),
        },
        Cons(p, rest) => λ args => match args {
            Nil => λ next s e => Option::none_ne_some(s, e,
                (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
                (F: Ty::Arrows(w.tys, Cons(p, rest), r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::AnswersWords(w.tys, Cons(p, rest), r, F, ans) →
                ans(words_of(eval_nodes_over(buffers, s.nodes, values), s.ports)) = Ty::result_words(w.tys, r, Tm::apply(w, g, env, r, Cons(p, rest), F, Nil))),
            Cons(a, more) => λ next => {
                let Goal = λ (s: Sending) => (values: Valuation()) → EnvHolds(w.tys, values, g, ports, env) → Below(w.tys, g, ports, next) →
                    (F: Ty::Arrows(w.tys, Cons(p, rest), r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::AnswersWords(w.tys, Cons(p, rest), r, F, ans) →
                    ans(words_of(eval_nodes_over(buffers, s.nodes, values), s.ports)) = Ty::result_words(w.tys, r, Tm::apply(w, g, env, r, Cons(p, rest), F, Cons(a, more)));
                let P = λ (o: Option<Sending>) => (s: Sending) → o = Some(s) → Goal(s);
                let none: P(None) = λ s e => Option::none_ne_some(s, e, Goal(s));
                let whole = λ (q: Nat) => p.check_sent(w.tys).and_then(λ _ => Tm::send_args(w.tys, g, ports, rest, more, next).and_then(λ s => Some(Tm::send_whole(w.tys, p, q, s))));
                let sliced = λ (q: Nat) => Tm::send_args(w.tys, g, ports, rest, more, Tm::send_slots(p.pieces(w.tys), q, next).next).and_then(λ s =>
                    Some(Tm::then_send(Tm::send_slots(p.pieces(w.tys), q, next), s)));
                let step = λ (q: Nat) => match p.check_sliced(w.tys) { Some(_) => sliced(q), None => whole(q) };
                Option::and_then_elim(P, none, port_at(ports, a), λ q => Ty::at(g, a).check(p).and_then(λ _ => step(q)), λ q at_q =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(p), λ _ => step(q), λ ea _ =>
                    match p.check_sliced(w.tys) as λ o => P(match o { Some(_) => sliced(q), None => whole(q) }) {
                        Some(sl) => {
                            let s1 = Tm::send_slots(p.pieces(w.tys), q, next);
                            Option::and_then_elim(P, none, Tm::send_args(w.tys, g, ports, rest, more, s1.next), λ s => Some(Tm::then_send(s1, s)),
                                λ s2 e2 s e => j(Option::some_inj(Tm::then_send(s1, s2), s, e), λ z _ => Goal(z), λ values held below F ans answers => {
                                    let v = Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a));
                                    let fl = p.flats_of(w.tys, v);
                                    let fs = p.pieces(w.tys);
                                    let hv = Tm::operand(w, g, ports, values, env, held, a, q, at_q, p, ea);
                                    let bq = Ty::below_cast(w.tys, Ty::at(g, a), p, ea, q, next, below_at(w.tys, g, ports, next, below, a, q, at_q));
                                    let sent = Tm::send_slots_sound(buffers, fs, q, next, Ty::sliced_slots(w.tys, p, sl), Ty::pieces_below(w.tys, p, q, next, sl, bq),
                                        values, fl, Ty::holds_pieces(w.tys, p, values, q, sl, v, hv));
                                    let mid = eval_nodes_over(buffers, s1.nodes, values);
                                    let fin = eval_nodes_over(buffers, s2.nodes, mid);
                                    let later = Tm::send_keeps(w.tys, g, ports, buffers, rest, more, s1.next, s2, e2, mid);
                                    let words1: (words_of(fin, s1.ports) = Ty::flats_words(fs, fl)) =
                                        trans(words_agree(s1.ports, mid, fin, λ x m => later.right(64, x, sent.right.right.right(x, m))), sent.right.right.left);
                                    let taken = Ty::takes_sliced(w.tys, p, λ ws u => Ty::AnswersWords(w.tys, rest, r, F(u), λ more2 => ans(ws ++ more2)), sl, answers, v);
                                    let ih = Tm::send_answers(w, g, ports, buffers, env, r, rest, more, s1.next, s2, e2, mid,
                                        env_holds_keeps(w.tys, g, values, mid, next, sent.right.left, ports, env, below, held),
                                        below_mono(w.tys, g, next, s1.next, sent.left, ports, below),
                                        F(v), λ more2 => ans(Ty::flats_words(fs, fl) ++ more2), taken);
                                    trans(cong_fn(λ (u: Valuation()) => ans(words_of(u, s1.ports ++ s2.ports)), Tm::nodes_append(buffers, s1.nodes, s2.nodes, values)),
                                        trans(cong_fn(λ (l: List<BitVec(64)>) => ans(l), words_of_append(fin, s1.ports, s2.ports)),
                                            trans(cong_fn(λ (l: List<BitVec(64)>) => ans(l ++ words_of(fin, s2.ports)), words1), ih)))
                                }))
                        },
                        None => Option::and_then_elim(P, none, p.check_sent(w.tys), λ _ => Tm::send_args(w.tys, g, ports, rest, more, next).and_then(λ s => Some(Tm::send_whole(w.tys, p, q, s))), λ hp _ =>
                            Option::and_then_elim(P, none, Tm::send_args(w.tys, g, ports, rest, more, next), λ s => Some(Tm::send_whole(w.tys, p, q, s)),
                                λ s1 e1 s e => j(Option::some_inj(Tm::send_whole(w.tys, p, q, s1), s, e), λ z _ => Goal(z), λ values held below F ans answers => {
                                    let after = eval_nodes_over(buffers, s1.nodes, values);
                                    let kept = Tm::send_keeps(w.tys, g, ports, buffers, rest, more, next, s1, e1, values).right;
                                    let held_after = env_holds_keeps(w.tys, g, values, after, next, kept, ports, env, below, held);
                                    let v = Ty::cast(w.tys, Ty::at(g, a), p, Env::get(w.tys, g, env, a));
                                    let ids = p.ids(w.tys, q);
                                    let taken = Ty::takes_holds(w.tys, p, λ ws u => Ty::AnswersWords(w.tys, rest, r, F(u), λ more2 => ans(ws ++ more2)), hp, answers,
                                        after, q, v, Tm::operand(w, g, ports, after, env, held_after, a, q, at_q, p, ea));
                                    trans(cong_fn(λ (l: List<BitVec(64)>) => ans(l), words_of_append(after, ids, s1.ports)),
                                        Tm::send_answers(w, g, ports, buffers, env, r, rest, more, next, s1, e1, values, held, below,
                                            F(v), λ more2 => ans(words_of(after, ids) ++ more2), taken))
                                }))),
                    }))
            },
        },
    }
}

theorem Tm::lower_call_sound(w: World, g: List<Ty>, ports: List<Nat>, next, f: Nat, args: List<Nat>):
    Tm::LowerHolds(Call(f, args), w, g, ports, next, Tm::lower_call(w, g, ports, next, f, args)) {
    let r = Sig::at(w.sigs, f).result;
    let ps = Sig::at(w.sigs, f).params;
    let P = λ (o: Option<Lowered>) => Tm::LowerHolds(Call(f, args), w, g, ports, next, o);
    Option::and_then_elim(P, trivial, Ty::check_sents(w.tys, ps), λ _ => Tm::lower_call_result(w, g, ports, next, f, args), λ ok _ =>
    Option::and_then_elim(P, trivial, r.check_back(w.tys), λ _ => Tm::lower_call_args(w, g, ports, next, f, args), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::send_args(w.tys, g, ports, ps, args, next), λ s => Tm::lower_call_at(w, r, f, s), λ s e_s =>
    Option::and_then_elim(P, trivial, Tm::check_true(distinct(Cons(s.next, r.also_ports(w.tys, s.next)))),
        λ _ => Some(Tm::sent_then(s.nodes, Tm::called(w.tys, r, f, s.ports, s.next))), λ apart _ =>
        λ call agree values env held below => {
            let at = s.next;
            let outs = Cons(at, r.also_ports(w.tys, at));
            let sent = eval_nodes_over(w.spans, s.nodes, values);
            let widened = Tm::send_keeps(w.tys, g, ports, w.spans, ps, args, next, s, e_s, values);
            let meaning = Tm::apply(w, g, env, r, ps, Sig::get(w.tys, w.sigs, w.callees, f), args);
            let words = Ty::result_words(w.tys, r, meaning);
            let answer = call(f, words_of(sent, s.ports));
            let answered: (answer = words) = Tm::send_answers(w, g, ports, w.spans, env, r, ps, args, next, s, e_s, values, held, below,
                Sig::get(w.tys, w.sigs, w.callees, f), λ ws => call(f, ws), agree(f, ⟨ok, er⟩));
            // The call's words, read back at the ports they land at.
            let after = Valuation::bind(sent, outs, Answers::split(answer));
            let read: (words_of(after, outs) = words) =
                j(sym(answered), λ a _ => words_of(Valuation::bind(sent, outs, Answers::split(a)), outs) = words,
                    words_of_bind(sent, outs, apart, words, Ty::back_len(w.tys, r, at, meaning)));
            // The first word's port holds it at every width, as binding a
            // word does (`word_value`).
            let bound: Ty::BoundAt(after, outs) = j(sym(answered), λ a _ => Ty::BoundAt(Valuation::bind(sent, outs, Answers::split(a)), outs),
                Ty::bind_bound(sent, outs, apart, words, Ty::back_len(w.tys, r, at, meaning)));
            let holds: r.Holds(w.tys, after, at, meaning) = Ty::back_holds(w.tys, r, after, at, bound, er, meaning, read);
            // The moves: the result again, at the ports past its own.
            let base = r.past(w.tys, at);
            let span = Ty::below_past(w.tys, r, at);
            let moved = r.moves_sound(w.tys, w.spans, after, base, at, span.left, meaning, holds);
            let kept: Keeps(values, eval_nodes_over(w.spans, r.moves(w.tys, base, at), after), next) = λ wd id lt => {
                let below_at = Nat::lt_of_lt_of_le(id, next, at, lt, widened.left);
                trans(moved.right.left(wd, id, Nat::lt_of_lt_of_le(id, at, base, below_at, span.right)),
                    trans(Valuation::bind_frame(sent, outs, Answers::split(answer), wd, id, absent_of(id, outs, λ x m => match m {
                        Inl(e) => λ same => Nat::ne_of_lt(id, at, below_at, trans(same, e)),
                        Inr(past) => Nat::ne_of_lt(id, x, Nat::lt_trans(id, at, x, below_at, Ty::also_above(w.tys, r, at, x, past))),
                    })), widened.right(wd, id, lt)))
            };
            let c = Tm::called(w.tys, r, f, s.ports, at);
            let same = Tm::sent_then_eval(call, w.spans, values, c, s.nodes);
            j(sym(same), λ e _ => (next <= c.next) ∧ (r.Below(w.tys, c.result, c.next) ∧ (Keeps(values, e, next) ∧ r.Holds(w.tys, e, c.result, meaning))),
                ⟨Nat::le_trans(next, at, r.past(w.tys, base), widened.left, Nat::le_trans(at, base, r.past(w.tys, base), span.right, moved.right.right.right)),
                    ⟨moved.right.right.left, ⟨kept, moved.left⟩⟩⟩)
        }))))
}

// A field's code held at one port, holding a value: its leaf holds the
// value's leaf there (an enum's tag word, `EnumInfo::Names`).
theorem Ty::leaf_holds(self f: Ty, tys: Table, values: Valuation(), port: Nat): f.FieldOne() → (v: f.sem(tys)) → f.Holds(tys, values, port, v) →
    f.leaf().FlatHolds(values, port, f.leaf_of(tys.ens, f.to_flat(tys, v))) {
    match f {
        Word(_) => λ _ v h => h, Bit => λ _ v h => h, ByteList(_) => λ _ v h => h, Lines => λ _ v h => h,
        Named(_) => λ never => false_elim(never),
        Count => λ _ v h => h,
        Enum(j) => λ _ v h => trans(sym(BitVec::ofNat_toNat(64, values(64, port))), cong_fn(λ (k: Nat) => BitVec::ofNat(k, n := 64), h.left.left)),
    }
}

theorem Ty::leaf_below(self f: Ty, tys: Table, port, next: Nat): f.FieldOne() → f.Below(tys, port, next) → port < next {
    match f { Word(_) => λ _ b => b, Bit => λ _ b => b, ByteList(_) => λ _ b => b, Lines => λ _ b => b, Named(_) => λ never _ => false_elim(never), Count => λ _ b => b, Enum(_) => λ _ b => b.left }
}

// `Make`'s moves: the field variables' values at the fields' ports (an
// enum's as its tag word, the field's leaf), from any valuation that still
// keeps the environment's (below `next`), each move at or above `next`.
fn Tm::MadeFields(w: World, g: List<Ty>, env: Env(w.tys, g), next: Nat, fs: List<Ty>, args: List<Nat>, out: Nat, ns: List<Node>,
    values0: Valuation()) → Type {
    (values: Valuation()) → Keeps(values0, values, next) → next <= out →
        Ty::MovedFields(Ty::leaves(fs), values, eval_nodes_over(w.spans, ns, values), out, Ty::leafs(fs, w.tys.ens, Tm::fields(w, g, env, fs, args)))
}

theorem Tm::make_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values0: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values0, g, ports, env), next: Nat, below: Below(w.tys, g, ports, next), fs: List<Ty>):
    (args: List<Nat>) → (out: Nat) → Ty::FieldOnes(fs) → (ns: List<Node>) → Tm::make_args(g, ports, fs, args, out) = Some(ns) →
    Tm::MadeFields(w, g, env, next, fs, args, out, ns, values0) {
    match fs {
        Nil => λ args => match args {
            Nil => λ out ones ns e => j(Option::some_inj(Nil, ns, e), λ z _ => Tm::MadeFields(w, g, env, next, Nil, Nil, out, z, values0),
                λ values _ _ => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩),
            Cons(a, more) => λ out ones ns e => Option::none_ne_some(ns, e, Tm::MadeFields(w, g, env, next, Nil, Cons(a, more), out, ns, values0)),
        },
        Cons(f, rest) => λ args => match args {
            Nil => λ out ones ns e => Option::none_ne_some(ns, e, Tm::MadeFields(w, g, env, next, Cons(f, rest), Nil, out, ns, values0)),
            Cons(a, more) => λ out ones => {
                let Goal = λ (ns: List<Node>) => Tm::MadeFields(w, g, env, next, Cons(f, rest), Cons(a, more), out, ns, values0);
                let P = λ (o: Option<List<Node>>) => (ns: List<Node>) → o = Some(ns) → Goal(ns);
                let none: P(None) = λ ns e => Option::none_ne_some(ns, e, Goal(ns));
                Option::and_then_elim(P, none, port_at(ports, a), λ q =>
                    Ty::at(g, a).check(f).and_then(λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns)))),
                    λ q at_q =>
                Option::and_then_elim(P, none, Ty::at(g, a).check(f),
                    λ _ => Tm::make_args(g, ports, rest, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))), λ ea _ =>
                Option::and_then_elim(P, none, Tm::make_args(g, ports, rest, more, out + 1), λ ns => Some(Cons(Move(f.width(), out, q), ns)),
                    λ found e_rest => λ ns e => j(Option::some_inj(Cons(Move(f.width(), out, q), found), ns, e), λ z _ => Goal(z),
                    λ values keeps0 le => {
                        let x = Ty::cast(w.tys, Ty::at(g, a), f, Env::get(w.tys, g, env, a));
                        let moved = Valuation::set(values, out, λ wd => values(wd, q));
                        let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
                        let q_next: (q < next) = f.leaf_below(w.tys, q, next, ones.left,
                            Ty::below_cast(w.tys, Ty::at(g, a), f, ea, q, next, below_at(w.tys, g, ports, next, below, a, q, at_q)));
                        let kept: Keeps(values0, moved, next) = λ wd id lt => trans(Valuation::set_other(values, out, λ v => values(v, q), wd, id,
                            Nat::ne_of_lt(id, out, Nat::lt_of_lt_of_le(id, next, out, lt, le))), keeps0(wd, id, lt));
                        let later = Tm::make_args_sound(w, g, ports, values0, env, held, next, below, rest, more, out + 1, ones.right, found, e_rest,
                            moved, kept, Nat::le_succ_r(next, out, le));
                        let after = eval_nodes_over(w.spans, found, moved);
                        ⟨⟨f.leaf().flat_at(values0, after, q, out,
                                λ wd => trans(later.right.left(wd, out, out.lt_succ_self()),
                                    trans(Valuation::set_here(values, out, λ v => values(v, q), wd), keeps0(wd, q, q_next))),
                                f.leaf_of(w.tys.ens, f.to_flat(w.tys, x)),
                                f.leaf_holds(w.tys, values0, q, ones.left, x, Tm::operand(w, g, ports, values0, env, held, a, q, at_q, f, ea))),
                            later.left⟩,
                            ⟨λ wd id lt => trans(later.right.left(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)),
                                    Valuation::set_other(values, out, λ v => values(v, q), wd, id, Nat::ne_of_lt(id, out, lt))),
                                ⟨⟨later.right.right.right, later.right.right.left⟩,
                                    Nat::le_trans(out, out + 1, Ty::fields_past(Ty::leaves(rest), out + 1), step, later.right.right.right)⟩⟩⟩
                    }))))
            },
        },
    }
}

// `Make`: the moves, and the record's leaves, read off what it built, are
// its fields' (`Table::leaves_round`).
theorem Tm::lower_make_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i: Nat, args: List<Nat>):
    Tm::LowerHolds(Make(i, args), w, g, ports, next, Tm::lower_make(w, g, ports, next, i, args)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Make(i, args), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, Ty::check_field_ones(w.tys.recs(i).fields), λ _ => Tm::make_moves(w, g, ports, next, i, args), λ ones _ =>
    Option::and_then_elim(P, trivial, Tm::make_args(g, ports, w.tys.recs(i).fields, args, next),
        λ ns => Some(Lowered(nodes_region(ns), next, Ty::fields_past(w.tys.fields(i), next))), λ ns e_ns =>
        λ call agree values env held below => {
            let fs = w.tys.fields(i);
            let u = Tm::fields(w, g, env, w.tys.recs(i).fields, args);
            let made = Tm::make_args_sound(w, g, ports, values, env, held, next, below, w.tys.recs(i).fields, args, next, ones, ns, e_ns,
                values, λ wd id _ => refl, next.le_refl());
            ⟨made.right.right.right, ⟨made.right.right.left, ⟨made.right.left,
                j(sym(w.tys.leaves_round(i, u)), λ t _ => Ty::FieldsHold(fs, eval_nodes_over(w.spans, ns, values), next, t), made.left)⟩⟩⟩
        }))
}

// A field held at its leaf (an enum's tag word, when the enum has no
// payload and its tags fit a word) holds at its code.
theorem Ty::holds_of_leaf(self f: Ty, tys: Table, values: Valuation(), port: Nat): f.FieldOne() → f.EnumFieldOk(tys.ens) →
    (v: f.Flat(en := Ty::types(tys.ens))) → f.leaf().FlatHolds(values, port, f.leaf_of(tys.ens, v)) → f.Holds(tys, values, port, f.of_flat(tys, v)) {
    match f {
        Word(_) => λ _ _ v h => h, Bit => λ _ _ v h => h, ByteList(_) => λ _ _ v h => h, Lines => λ _ _ v h => h,
        Named(_) => λ never => false_elim(never),
        Count => λ _ _ v h => h,
        Enum(j) => λ _ ok v h => {
            let e = tys.ens(j);
            let named: (values(64, port).toNat() = e.tag(v)) = trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), h), e.tag_word(v, ok.right));
            ⟨⟨named, j(sym(named), λ n _ => n <= e.last, e.bounded(v))⟩,
                j(sym(ok.left), λ s _ => (t: Ty::Flats(s)) → Ty::FieldsHold(s, values, port + 1, t), λ t => trivial)(e.fields(v))⟩
        },
    }
}

theorem Ty::below_of_leaf(self f: Ty, tys: Table, port, next: Nat): f.FieldOne() → f.EnumFieldOk(tys.ens) → port < next → f.Below(tys, port, next) {
    match f {
        Word(_) => λ _ _ lt => lt, Bit => λ _ _ lt => lt, ByteList(_) => λ _ _ lt => lt, Lines => λ _ _ lt => lt,
        Named(_) => λ never => false_elim(never),
        Count => λ _ _ lt => lt,
        Enum(j) => λ _ ok lt => ⟨lt, j(sym(ok.left), λ s _ => Ty::FieldsBelow(s, port + 1, next), trivial)⟩,
    }
}

// A record's field `k`, its fields held at their leaves from `port`: the
// field at its code, at its port.
theorem Ty::field_leaf_holds(rs: List<Ty>, tys: Table, values: Valuation()): (port, k: Nat) → Ty::has_field(Ty::leaves(rs), k).IsTrue() →
    Ty::at(rs, k).FieldOne() → Ty::EnumFieldsOk(rs, tys.ens) → (t: Ty::FlatsIn(rs, Ty::types(tys.ens))) →
    Ty::FieldsHold(Ty::leaves(rs), values, port, Ty::leafs(rs, tys.ens, t)) →
    Ty::at(rs, k).Holds(tys, values, Ty::field_port(k, port), Ty::at(rs, k).of_flat(tys, Ty::flat_nth_in(rs, Ty::types(tys.ens), t, k))) {
    match rs {
        Nil => λ port k never => false_elim(never),
        Cons(f, rest) => λ port k => match k {
            Zero => λ _ one ok t h => f.holds_of_leaf(tys, values, port, one, ok.left, t.fst, h.left),
            Succ(n) => λ has one ok t h => Ty::field_leaf_holds(rest, tys, values, port + 1, n, has, one, ok.right, t.snd, h.right),
        },
    }
}

theorem Ty::field_leaf_below(rs: List<Ty>, tys: Table, next: Nat): (port, k: Nat) → Ty::has_field(Ty::leaves(rs), k).IsTrue() →
    Ty::at(rs, k).FieldOne() → Ty::EnumFieldsOk(rs, tys.ens) → Ty::FieldsBelow(Ty::leaves(rs), port, next) →
    Ty::at(rs, k).Below(tys, Ty::field_port(k, port), next) {
    match rs {
        Nil => λ port k never => false_elim(never),
        Cons(f, rest) => λ port k => match k {
            Zero => λ _ one ok b => f.below_of_leaf(tys, port, next, one, ok.left, b.left),
            Succ(n) => λ has one ok b => Ty::field_leaf_below(rest, tys, next, port + 1, n, has, one, ok.right, b.right),
        },
    }
}

// `Field`: the record's field `k` is at its port already.
theorem Tm::lower_field_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i, k, of: Nat):
    Tm::LowerHolds(Field(i, k, of), w, g, ports, next, Tm::lower_field(w, g, ports, next, i, k, of)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Field(i, k, of), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, port_at(ports, of), λ p => Tm::field_typed(w, g, next, i, k, of, p), λ p at_p =>
    Option::and_then_elim(P, trivial, Ty::at(g, of).check(Named(i)), λ _ => Tm::field_ranged(w, next, i, k, p), λ e _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(Ty::has_field(w.tys.fields(i), k)), λ _ => Tm::field_one(w, next, i, k, p), λ has _ =>
    Option::and_then_elim(P, trivial, Ty::at(w.tys.recs(i).fields, k).check_field_one(),
        λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(k, p), next)), λ one _ =>
        λ call agree values env held below => {
            let rs = w.tys.recs(i).fields;
            let fs = w.tys.fields(i);
            let fits = Ty::check_enum_fields(rs, w.tys.ens).get(w.tys.recs(i).fits);
            let x = Ty::cast(w.tys, Ty::at(g, of), Named(i), Env::get(w.tys, g, env, of));
            let record: Ty::FieldsHold(fs, values, p, w.tys.get(i, x)) = Tm::operand(w, g, ports, values, env, held, of, p, at_p, Named(i), e);
            let spans: Ty::FieldsBelow(fs, p, next) =
                Ty::below_cast(w.tys, Ty::at(g, of), Named(i), e, p, next, below_at(w.tys, g, ports, next, below, of, p, at_p));
            ⟨next.le_refl(), ⟨Ty::field_leaf_below(rs, w.tys, next, p, k, has, one, fits, spans),
                ⟨λ wd id _ => refl, Ty::field_leaf_holds(rs, w.tys, values, p, k, has, one, fits, w.tys.recs(i).get(x), record)⟩⟩⟩
        }))))
}

// A slot set by one node and the slots after it moved: the payload from
// `out` (what `Make`'s moves prove a field at a time, for any node that
// sets its port).
theorem Ty::moved_cons(spans: Buffers(), f: Ty, rest: List<Ty>, values: Valuation(), out: Nat, set: (wd: Nat) → BitVec(wd), ns: List<Node>,
    x: f.Flat(), t: Ty::Flats(rest), here: f.FlatHolds(Valuation::set(values, out, set), out, x),
    later: Ty::MovedFields(rest, Valuation::set(values, out, set), eval_nodes_over(spans, ns, Valuation::set(values, out, set)), out + 1, t)):
    Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(spans, ns, Valuation::set(values, out, set)), out, Pair(x, t)) {
    let moved = Valuation::set(values, out, set);
    let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
    ⟨⟨f.flat_at(moved, eval_nodes_over(spans, ns, moved), out, out, λ wd => later.right.left(wd, out, out.lt_succ_self()), x, here), later.left⟩,
        ⟨λ wd id lt => trans(later.right.left(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)),
                Valuation::set_other(values, out, set, wd, id, Nat::ne_of_lt(id, out, lt))),
            ⟨⟨later.right.right.right, later.right.right.left⟩,
                Nat::le_trans(out, out + 1, Ty::fields_past(rest, out + 1), step, later.right.right.right)⟩⟩⟩
}

// The constant zero holds a slot's default.
theorem Ty::default_flat(self f: Ty, values: Valuation(), out: Nat): f.Defaults() →
    f.FlatHolds(Valuation::set(values, out, λ (wd: Nat) => BitVec::ofNat(0, n := wd)), out, f.flat_default()) {
    match f {
        Word(width) => λ _ => Valuation::set_here(values, out, λ (wd: Nat) => BitVec::ofNat(0, n := wd), width),
        Bit => λ _ => Valuation::set_here(values, out, λ (wd: Nat) => BitVec::ofNat(0, n := wd), 1),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ _ => cong_fn(λ (y: BitVec(64)) => y.toNat(), Valuation::set_here(values, out, λ (wd: Nat) => BitVec::ofNat(0, n := wd), 64)),
        Enum(_) => λ never => false_elim(never),
    }
}

// What a list of nodes promises when it is `Some`: the slots from `out`
// hold `t`, from any valuation.
fn Ty::NodesMove(spans: Buffers(), fs: List<Ty>, out: Nat, t: Ty::Flats(fs), o: Option<List<Node>>) → Type {
    (ns: List<Node>) → o = Some(ns) → (values: Valuation()) → Ty::MovedFields(fs, values, eval_nodes_over(spans, ns, values), out, t)
}

// A default node, then slots that move: the slots from `out`.
theorem Ty::default_then(spans: Buffers(), f: Ty, rest: List<Ty>, out: Nat, t: Ty::Flats(rest), more: Option<List<Node>>,
    later: Ty::NodesMove(spans, rest, out + 1, t, more)):
    Ty::NodesMove(spans, Cons(f, rest), out, Pair(f.flat_default(), t), f.default_node(out).and_then(λ d => more.and_then(λ ds => Some(Cons(d, ds))))) {
    let P = λ (o: Option<List<Node>>) => Ty::NodesMove(spans, Cons(f, rest), out, Pair(f.flat_default(), t), o);
    let none: P(None) = λ ns e => Option::none_ne_some(ns, e, (values: Valuation()) → Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(spans, ns, values), out, Pair(f.flat_default(), t)));
    let Q = λ (o: Option<Node>) => P(o.and_then(λ d => more.and_then(λ ds => Some(Cons(d, ds)))));
    Option::and_then_elim(Q, none, f.check_default(), λ _ => Some(Const(f.width(), out, 0)), λ dflt _ =>
    Option::and_then_elim(P, none, more, λ ds => Some(Cons(Const(f.width(), out, 0), ds)), λ ds e_ds =>
        λ ns e => j(Option::some_inj(Cons(Const(f.width(), out, 0), ds), ns, e),
            λ z _ => (values: Valuation()) → Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(spans, z, values), out, Pair(f.flat_default(), t)),
            λ values => {
                let set = λ (wd: Nat) => BitVec::ofNat(0, n := wd);
                Ty::moved_cons(spans, f, rest, values, out, set, ds, f.flat_default(), t, f.default_flat(values, out, dflt),
                    later(ds, e_ds, Valuation::set(values, out, set)))
            })))
}

theorem Ty::default_nodes_sound(spans: Buffers(), fs: List<Ty>): (out: Nat) → Ty::NodesMove(spans, fs, out, Ty::flats_default(fs), Ty::default_nodes(fs, out)) {
    match fs {
        Nil => λ out ns e => j(Option::some_inj(Nil, ns, e), λ z _ => (values: Valuation()) → Ty::MovedFields(Nil, values, eval_nodes_over(spans, z, values), out, trivial),
            λ values => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩),
        Cons(f, rest) => λ out => Ty::default_then(spans, f, rest, out, Ty::flats_default(rest), Ty::default_nodes(rest, out + 1),
            Ty::default_nodes_sound(spans, rest, out + 1)),
    }
}

// `Inject`'s slots: from any valuation that keeps the environment's ports
// (below `next`), the constructor's fields spread over the slots from
// `out`.
fn Tm::SpreadMoves(w: World, g: List<Ty>, env: Env(w.tys, g), next: Nat, values0: Valuation(), fs: List<Ty>, lo, n: Nat, args: List<Nat>, out: Nat,
    o: Option<List<Node>>) → Type {
    (ns: List<Node>) → o = Some(ns) → (values: Valuation()) → Keeps(values0, values, next) → next <= out →
        Ty::MovedFields(fs, values, eval_nodes_over(w.spans, ns, values), out, Ty::spread(fs, lo, n, Tm::slots(w, g, env, Ty::range(fs, lo, n), args)))
}

theorem Tm::spread_args_sound(w: World, g: List<Ty>, ports: List<Nat>, values0: Valuation(), env: Env(w.tys, g),
    held: EnvHolds(w.tys, values0, g, ports, env), next: Nat, below: Below(w.tys, g, ports, next), fs: List<Ty>):
    (lo, n: Nat) → (args: List<Nat>) → (out: Nat) → Tm::SpreadMoves(w, g, env, next, values0, fs, lo, n, args, out, Tm::spread_args(g, ports, fs, lo, n, args, out)) {
    match fs {
        Nil => λ lo n args out ns e => j(Option::some_inj(Nil, ns, e),
            λ z _ => (values: Valuation()) → Keeps(values0, values, next) → next <= out → Ty::MovedFields(Nil, values, eval_nodes_over(w.spans, z, values), out, trivial),
            λ values _ _ => ⟨trivial, ⟨λ wd id _ => refl, ⟨trivial, out.le_refl()⟩⟩⟩),
        Cons(f, rest) => λ lo => match lo {
            Succ(l) => λ n args out => {
                let t = Ty::spread(rest, l, n, Tm::slots(w, g, env, Ty::range(rest, l, n), args));
                let P = λ (o: Option<List<Node>>) => Tm::SpreadMoves(w, g, env, next, values0, Cons(f, rest), Succ(l), n, args, out, o);
                let Goal = λ (ns: List<Node>) => (values: Valuation()) → Keeps(values0, values, next) → next <= out →
                    Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(w.spans, ns, values), out, Pair(f.flat_default(), t));
                let none: P(None) = λ ns e => Option::none_ne_some(ns, e, Goal(ns));
                let Q = λ (o: Option<Node>) => P(o.and_then(λ d => Tm::spread_args(g, ports, rest, l, n, args, out + 1).and_then(λ ds => Some(Cons(d, ds)))));
                Option::and_then_elim(Q, none, f.check_default(), λ _ => Some(Const(f.width(), out, 0)), λ dflt _ =>
                Option::and_then_elim(P, none, Tm::spread_args(g, ports, rest, l, n, args, out + 1), λ ds => Some(Cons(Const(f.width(), out, 0), ds)),
                    λ ds e_ds => λ ns e => j(Option::some_inj(Cons(Const(f.width(), out, 0), ds), ns, e), λ z _ => Goal(z),
                    λ values keeps0 le => {
                        let set = λ (wd: Nat) => BitVec::ofNat(0, n := wd);
                        let moved = Valuation::set(values, out, set);
                        let kept: Keeps(values0, moved, next) = λ wd id lt => trans(Valuation::set_other(values, out, set, wd, id,
                            Nat::ne_of_lt(id, out, Nat::lt_of_lt_of_le(id, next, out, lt, le))), keeps0(wd, id, lt));
                        Ty::moved_cons(w.spans, f, rest, values, out, set, ds, f.flat_default(), t, f.default_flat(values, out, dflt),
                            Tm::spread_args_sound(w, g, ports, values0, env, held, next, below, rest, l, n, args, out + 1, ds, e_ds, moved, kept,
                                Nat::le_succ_r(next, out, le)))
                    })))
            },
            Zero => λ n => match n {
                Zero => λ args => match args {
                    Nil => λ out ns e values _ _ => Ty::default_nodes_sound(w.spans, Cons(f, rest), out, ns, e, values),
                    Cons(a, more) => λ out ns e => Option::none_ne_some(ns, e, (values: Valuation()) → Keeps(values0, values, next) → next <= out →
                        Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(w.spans, ns, values), out, Ty::flats_default(Cons(f, rest)))),
                },
                Succ(m) => λ args => match args {
                    Nil => λ out ns e => Option::none_ne_some(ns, e, (values: Valuation()) → Keeps(values0, values, next) → next <= out →
                        Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(w.spans, ns, values), out,
                            Ty::spread(Cons(f, rest), 0, Succ(m), Tm::slots(w, g, env, Ty::range(Cons(f, rest), 0, Succ(m)), Nil)))),
                    Cons(a, more) => λ out => {
                        let x = Ty::cast(w.tys, Ty::at(g, a), f, Env::get(w.tys, g, env, a));
                        let t = Ty::spread(rest, 0, m, Tm::slots(w, g, env, Ty::range(rest, 0, m), more));
                        let P = λ (o: Option<List<Node>>) => Tm::SpreadMoves(w, g, env, next, values0, Cons(f, rest), 0, Succ(m), Cons(a, more), out, o);
                        let Goal = λ (ns: List<Node>) => (values: Valuation()) → Keeps(values0, values, next) → next <= out →
                            Ty::MovedFields(Cons(f, rest), values, eval_nodes_over(w.spans, ns, values), out, Pair(f.to_slot(w.tys, x), t));
                        let none: P(None) = λ ns e => Option::none_ne_some(ns, e, Goal(ns));
                        Option::and_then_elim(P, none, port_at(ports, a), λ q => Ty::at(g, a).check(f).and_then(λ _ => f.check_one().and_then(λ _ =>
                            Tm::spread_args(g, ports, rest, 0, m, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))))), λ q at_q =>
                        Option::and_then_elim(P, none, Ty::at(g, a).check(f), λ _ => f.check_one().and_then(λ _ =>
                            Tm::spread_args(g, ports, rest, 0, m, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns)))), λ ea _ =>
                        Option::and_then_elim(P, none, f.check_one(), λ _ =>
                            Tm::spread_args(g, ports, rest, 0, m, more, out + 1).and_then(λ ns => Some(Cons(Move(f.width(), out, q), ns))), λ one _ =>
                        Option::and_then_elim(P, none, Tm::spread_args(g, ports, rest, 0, m, more, out + 1), λ ns => Some(Cons(Move(f.width(), out, q), ns)),
                            λ found e_rest => λ ns e => j(Option::some_inj(Cons(Move(f.width(), out, q), found), ns, e), λ z _ => Goal(z),
                            λ values keeps0 le => {
                                let set = λ (wd: Nat) => values(wd, q);
                                let moved = Valuation::set(values, out, set);
                                let q_next: (q < next) = f.below_one(w.tys, q, next, one,
                                    Ty::below_cast(w.tys, Ty::at(g, a), f, ea, q, next, below_at(w.tys, g, ports, next, below, a, q, at_q)));
                                let kept: Keeps(values0, moved, next) = λ wd id lt => trans(Valuation::set_other(values, out, set, wd, id,
                                    Nat::ne_of_lt(id, out, Nat::lt_of_lt_of_le(id, next, out, lt, le))), keeps0(wd, id, lt));
                                Ty::moved_cons(w.spans, f, rest, values, out, set, found, f.to_slot(w.tys, x), t,
                                    f.flat_at(values0, moved, q, out, λ wd => trans(Valuation::set_here(values, out, set, wd), keeps0(wd, q, q_next)),
                                        f.to_slot(w.tys, x), f.flat_of_holds(w.tys, values0, q, one, x, Tm::operand(w, g, ports, values0, env, held, a, q, at_q, f, ea))),
                                    Tm::spread_args_sound(w, g, ports, values0, env, held, next, below, rest, 0, m, more, out + 1, found, e_rest, moved, kept,
                                        Nat::le_succ_r(next, out, le)))
                            })))))
                    },
                },
            },
        },
    }
}

// `Inject`: the tag's constant, then the slots; the constructor built
// from the spread fields has the tag and those fields (`EnumInfo.tag_of`,
// `fields_of`, `Ty::take_spread`).
theorem Tm::lower_inject_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i, k: Nat, args: List<Nat>):
    Tm::LowerHolds(Inject(i, k, args), w, g, ports, next, Tm::lower_inject(w, g, ports, next, i, k, args)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Inject(i, k, args), w, g, ports, next, r);
    let e = w.tys.ens(i);
    Option::and_then_elim(P, trivial, Tm::check_true(k.leb(e.last)), λ _ => Tm::inject_small(w, g, ports, next, i, k, args), λ among _ =>
    Option::and_then_elim(P, trivial, Tm::check_true((k + 1).leb(Nat::pow(2, 64))), λ _ => Tm::inject_moves(w, g, ports, next, i, k, args), λ fits _ =>
    Option::and_then_elim(P, trivial, Tm::spread_args(g, ports, e.slots, e.lo(k), e.arity(k), args, next + 1),
        λ ns => Some(Lowered(nodes_region(Cons(Const(64, next, k), ns)), next, Ty::fields_past(e.slots, next + 1))), λ ns e_ns =>
        λ call agree values env held below => {
            let le: (k <= e.last) = Nat::leb_sound(k, e.last, among);
            let set = λ (wd: Nat) => BitVec::ofNat(k, n := wd);
            let tagged = Valuation::set(values, next, set);
            let p = Tm::slots(w, g, env, Ty::range(e.slots, e.lo(k), e.arity(k)), args);
            let sp = Ty::spread(e.slots, e.lo(k), e.arity(k), p);
            let kept: Keeps(values, tagged, next) = λ wd id lt => Valuation::set_other(values, next, set, wd, id, Nat::ne_of_lt(id, next, lt));
            let step: (next <= next + 1) = Nat::le_succ_r(next, next, next.le_refl());
            let slots = Tm::spread_args_sound(w, g, ports, values, env, held, next, below, e.slots, e.lo(k), e.arity(k), args, next + 1, ns, e_ns,
                tagged, kept, step);
            let after = eval_nodes_over(w.spans, ns, tagged);
            let moved: Ty::MovedFields(Cons(Word(64), e.slots), values, after, next, Pair(BitVec::ofNat(k, n := 64), sp)) =
                Ty::moved_cons(w.spans, Word(64), e.slots, values, next, set, ns, BitVec::ofNat(k, n := 64), sp,
                    Valuation::set_here(values, next, set, 64), slots);
            let word: (after(64, next).toNat() = k) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), moved.left.left),
                BitVec::toNat_ofNat(64, k, Nat::leb_sound(k + 1, Nat::pow(2, 64), fits)));
            let own: (e.fields(e.of(k, sp)) = sp) = trans(e.fields_of(k, le, sp),
                cong_fn(λ (u: Ty::Flats(Ty::range(e.slots, e.lo(k), e.arity(k)))) => Ty::spread(e.slots, e.lo(k), e.arity(k), u),
                    Ty::take_spread(e.slots, e.lo(k), e.arity(k), p)));
            ⟨moved.right.right.right, ⟨moved.right.right.left, ⟨moved.right.left,
                ⟨⟨trans(word, sym(e.tag_of(k, le, sp))), j(sym(word), λ m _ => m <= e.last, le)⟩,
                    j(sym(own), λ u _ => Ty::FieldsHold(e.slots, after, next + 1, u), moved.left.right)⟩⟩⟩⟩
        })))
}

// `Slot`: the enum's slot `j` is at its port already.
theorem Tm::lower_slot_sound(w: World, g: List<Ty>, ports: List<Nat>, next, i, j, of: Nat):
    Tm::LowerHolds(Slot(i, j, of), w, g, ports, next, Tm::lower_slot(w, g, ports, next, i, j, of)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Slot(i, j, of), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, port_at(ports, of), λ p => Tm::slot_typed(w, g, next, i, j, of, p), λ p at_p =>
    Option::and_then_elim(P, trivial, Ty::at(g, of).check(Enum(i)), λ _ => Tm::slot_ranged(w, next, i, j, p), λ e _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(Ty::has_field(w.tys.ens(i).slots, j)), λ _ => Tm::slot_one(w, next, i, j, p), λ has _ =>
    Option::and_then_elim(P, trivial, Ty::at(w.tys.ens(i).slots, j).check_one(),
        λ _ => Some(Lowered(nodes_region(Nil), Ty::field_port(j, p + 1), next)), λ one _ =>
        λ call agree values env held below => {
            let fs = w.tys.ens(i).slots;
            let x = Ty::cast(w.tys, Ty::at(g, of), Enum(i), Env::get(w.tys, g, env, of));
            let payload: Ty::FieldsHold(fs, values, p + 1, w.tys.ens(i).fields(x)) = Tm::operand(w, g, ports, values, env, held, of, p, at_p, Enum(i), e).right;
            let spans: Ty::FieldsBelow(fs, p + 1, next) =
                Ty::below_cast(w.tys, Ty::at(g, of), Enum(i), e, p, next, below_at(w.tys, g, ports, next, below, of, p, at_p)).right;
            ⟨next.le_refl(), ⟨Ty::at(fs, j).one_below(w.tys, Ty::field_port(j, p + 1), next, one, Ty::fields_below_at(fs, next, p + 1, j, has, spans)),
                ⟨λ wd id _ => refl, Ty::at(fs, j).holds_of_flat(w.tys, values, Ty::field_port(j, p + 1), Ty::flat_nth(fs, w.tys.ens(i).fields(x), j),
                    Ty::fields_hold_at(fs, values, p + 1, j, has, w.tys.ens(i).fields(x), payload))⟩⟩⟩
        }))))
}

// A byte of a lent span.

// The word a load leaves holds its byte in its low eight bits.
theorem Tm::byte_back(b: BitVec(8)): BitVec::ofNat(byte_word(b).toNat(), n := 8) = b {
    trans(BitVec::ofNat_toNat_truncate(8, 56, b.zero_extend(56)), BitVec::truncate_zero_extend(8, 56, b))
}

// FunctionIR's byte of a buffer of the file is the span's byte.
theorem Tm::span_byte(spans: List<List<BitVec(8)>>, k: Nat, i: BitVec(64)): buffer_byte(spans, k, i.toNat()) = spans.span(k).byte_at(i) {
    match spans.nth(k) as λ found => (match found { None => BitVec::zero(), Some(bytes) => match bytes.nth(i.toNat()) { None => BitVec::zero(), Some(byte) => byte } })
        = List::byte_at(match found { None => [], Some(bytes) => bytes }, i) {
        None => refl,
        Some(bytes) => match bytes.nth(i.toNat()) as λ at => (match at { None => BitVec::zero(), Some(byte) => byte }) = at.unwrap_or(BitVec::ofNat(0)) {
            None => refl,
            Some(_) => refl,
        },
    }
}

theorem Tm::lower_byte_sound(w: World, g: List<Ty>, ports: List<Nat>, next, k, i, length: Nat):
    Tm::LowerHolds(Byte(k, i, length), w, g, ports, next, Tm::lower_byte(g, ports, next, k, i, length)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Byte(k, i, length), w, g, ports, next, r);
    Option::and_then_elim(P, trivial, port_at(ports, i), λ pi => Tm::byte_port_l(g, ports, next, k, i, length, pi), λ pi at_i =>
    Option::and_then_elim(P, trivial, port_at(ports, length), λ pl => Tm::binary(g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next)), λ pl at_l =>
    Tm::binary_sound(P, trivial, g, i, length, Word(64), Tm::byte_lowered(k, pi, pl, next), λ ei el =>
        λ call agree values env held below => {
            let index = Ty::cast(w.tys, Ty::at(g, i), Word(64), Env::get(w.tys, g, env, i));
            let bound = Ty::cast(w.tys, Ty::at(g, length), Word(64), Env::get(w.tys, g, env, length));
            let load = next + 1;
            let out = next + 2;
            let at_index: (values(64, pi) = index) = Tm::operand(w, g, ports, values, env, held, i, pi, at_i, Word(64), ei);
            let at_bound: (values(64, pl) = bound) = Tm::operand(w, g, ports, values, env, held, length, pl, at_l, Word(64), el);
            let under: (pi < next) = Ty::below_cast(w.tys, Ty::at(g, i), Word(64), ei, pi, next, below_at(w.tys, g, ports, next, below, i, pi, at_i));
            // The comparison's bit.
            let tested = Valuation::set(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))));
            let bit = Tm::cmp_op_holds(values, next, pi, pl, 64, λ (x: BitVec(64)) (y: BitVec(64)) => x.unsigned_lt_bit(y), index, bound, at_index, at_bound);
            let chosen: (tested(1, next).head_bit() = index.unsigned_lt_bit(bound)) =
                trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit), BitVec::head_bit_ofBool(index.unsigned_lt_bit(bound)));
            let kept_test: Keeps(values, tested, next) = λ wd id lt =>
                Valuation::set_other(values, next, bit_value(values(64, pi).unsigned_lt_bit(values(64, pl))), wd, id, Nat::ne_of_lt(id, next, lt));
            // The arm that loads.
            let loaded = Valuation::set(tested, load, load_value(w.spans, k, pi, tested));
            let narrowed = Valuation::set(loaded, out, λ wd => BitVec::ofNat(loaded(64, load).toNat()));
            let index_kept: (tested(64, pi) = index) = trans(kept_test(64, pi, under), at_index);
            let word: (loaded(64, load) = byte_word(w.spans.span(k).byte_at(index))) =
                trans(Valuation::set_here(tested, load, load_value(w.spans, k, pi, tested), 64),
                    cong_fn(byte_word, trans(cong_fn(λ (x: BitVec(64)) => buffer_byte(w.spans, k, x.toNat()), index_kept), Tm::span_byte(w.spans, k, index))));
            let held_true: (narrowed(8, out) = w.spans.span(k).byte_at(index)) =
                trans(Valuation::set_here(loaded, out, λ wd => BitVec::ofNat(loaded(64, load).toNat()), 8),
                    trans(cong_fn(λ (x: BitVec(64)) => BitVec::ofNat(x.toNat(), n := 8), word), Tm::byte_back(w.spans.span(k).byte_at(index))));
            let kept_true: Keeps(tested, narrowed, next) = λ wd id lt =>
                trans(Valuation::set_other(loaded, out, λ x => BitVec::ofNat(loaded(64, load).toNat()), wd, id,
                        Nat::ne_of_lt(id, out, Nat::lt_trans(id, load, out, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()), load.lt_succ_self()))),
                    Valuation::set_other(tested, load, load_value(w.spans, k, pi, tested), wd, id,
                        Nat::ne_of_lt(id, load, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()))));
            // The arm that does not.
            let zeroed = Valuation::set(tested, out, λ wd => BitVec::ofNat(0));
            let held_false: (zeroed(8, out) = BitVec::ofNat(0)) = Valuation::set_here(tested, out, λ wd => BitVec::ofNat(0), 8);
            let kept_false: Keeps(tested, zeroed, next) = λ wd id lt =>
                Valuation::set_other(tested, out, λ x => BitVec::ofNat(0), wd, id,
                    Nat::ne_of_lt(id, out, Nat::lt_trans(id, load, out, Nat::lt_trans(id, next, load, lt, next.lt_succ_self()), load.lt_succ_self())));
            let outs = Ports([Port(out, 8)]);
            let when_true = Compose(nodes_region([BufferLoad(load, k, pi)]), nodes_region([Resize(64, 8, out, load)]));
            let when_false = nodes_region([Const(8, out, 0)]);
            let kept = branch_keeps(tested, next, outs, when_true, when_false, call, w.spans, next, kept_true, kept_false);
            ⟨Nat::le_succ_r(next, out, Nat::le_succ_r(next, load, Nat::le_succ_r(next, next, next.le_refl()))),
                ⟨out.lt_succ_self(),
                    ⟨λ wd id lt => trans(kept(wd, id, lt), kept_test(wd, id, lt)),
                        branch_holds(Word(8), w.tys, tested, next, outs, when_true, when_false, call, w.spans, out, index.unsigned_lt_bit(bound),
                            w.spans.span(k).byte_at(index), BitVec::ofNat(0), chosen, held_true, held_false)⟩⟩⟩
        })))
}

// A `match` on an enum: the arms run with the constructor `pick` chose
// bound at the enum's port, which holds it (`of_tag`), and `pick` is the
// arm at the tag (`picks`).
theorem Tm::pick_sound(i, c: Nat, arms: Tm, eq: Bool, w: World,
    ih: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(arms, w, g, ports, next, Tm::lower(arms, w, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::LowerHolds(Pick(i, c, arms, eq), w, g, ports, next, Tm::lower(Pick(i, c, arms, eq), w, g, ports, next)) {
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Pick(i, c, arms, eq), w, g, ports, next, r);
    let inner = Cons(Enum(i), g);
    Option::and_then_elim(P, trivial, port_at(ports, c),
        λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, inner, Cons(pc, ports), next)), λ pc at_c =>
    Option::and_then_elim(P, trivial, Ty::at(g, c).check(Enum(i)), λ _ => Tm::lower(arms, w, inner, Cons(pc, ports), next), λ ec _ =>
    (match Tm::lower(arms, w, inner, Cons(pc, ports), next) as λ r => Tm::lower(arms, w, inner, Cons(pc, ports), next) = r → P(r) {
      None => λ _ => trivial,
      Some(l) => λ lowered => λ call agree values env held below => {
            let e = w.tys.ens(i);
            let R = arms.ty(w, inner);
            let v = Ty::cast(w.tys, Ty::at(g, c), Enum(i), Env::get(w.tys, g, env, c));
            let held_v: Enum(i).Holds(w.tys, values, pc, v) = Tm::operand(w, g, ports, values, env, held, c, pc, at_c, Enum(i), ec);
            let held_of: Enum(i).Holds(w.tys, values, pc, e.of(e.tag(v), e.fields(v))) =
                j(sym(e.of_tag(v)), λ u _ => Enum(i).Holds(w.tys, values, pc, u), held_v);
            let pc_below: Enum(i).Below(w.tys, pc, next) =
                Ty::below_cast(w.tys, Ty::at(g, c), Enum(i), ec, pc, next, below_at(w.tys, g, ports, next, below, c, pc, at_c));
            let ran = j(lowered, λ r _ => Tm::LowerHolds(arms, w, inner, Cons(pc, ports), next, r), ih(inner, Cons(pc, ports), next))(
                call, agree, values, Pair(e.of(e.tag(v), e.fields(v)), env), ⟨held_of, held⟩, ⟨pc_below, below⟩);
            let after = l.region.eval(call, values, buffers := w.spans);
            let arm = λ (n: Nat) (t: Ty::Flats(e.slots)) => arms.sem(w, inner, Pair(e.of(n, t), env));
            ⟨ran.left, ⟨ran.right.left, ⟨ran.right.right.left,
                j(sym(e.chooses(eq, R.sem(w.tys), arm, v)), λ y _ => R.Holds(w.tys, after, l.result, y), ran.right.right.right)⟩⟩⟩
        },
    })(refl)))
}

// ---------------------------------------------------------------------------
// A `while` loop's soundness (docs/language/loop-combinator-design.md §6.2).

// Every id is below `n`.
fn Tm::AllBelow(ids: List<Nat>, n: Nat) → Type {
    match ids { Nil => True, Cons(id, rest) => (id < n) ∧ Tm::AllBelow(rest, n) }
}

theorem Tm::all_below_append(n: Nat, ys: List<Nat>, below_ys: Tm::AllBelow(ys, n), xs: List<Nat>): Tm::AllBelow(xs, n) → Tm::AllBelow(xs ++ ys, n) {
    match xs { Nil => λ _ => below_ys, Cons(_, rest) => λ b => ⟨b.left, Tm::all_below_append(n, ys, below_ys, rest, b.right)⟩ }
}

// A run of ids is below anything at or past its end.
theorem Tm::ids_below(ps: List<Ty>): (m, n: Nat) → Fun::past(ps, m) <= n → Tm::AllBelow(Fun::param_ids(ps, m), n) {
    match ps {
        Nil => λ m n _ => trivial,
        Cons(_, rest) => λ m n le => ⟨Nat::lt_of_lt_of_le(m, m + 1, n, m.lt_succ_self(), Nat::le_trans(m + 1, Fun::past(rest, m + 1), n,
            Fun::past_ge(rest, m + 1), le)), Tm::ids_below(rest, m + 1, n, le)⟩,
    }
}

// Words at ids a region keeps are the words before it.
theorem Tm::words_kept(values, after: Valuation(), n: Nat, keeps: Keeps(values, after, n), ids: List<Nat>): Tm::AllBelow(ids, n) →
    words_of(after, ids) = words_of(values, ids) {
    match ids {
        Nil => λ _ => refl,
        Cons(id, rest) => λ b => eq2(λ (x: BitVec(64)) (xs: List<BitVec(64)>) => Cons(x, xs), keeps(64, id, b.left),
            Tm::words_kept(values, after, n, keeps, rest, b.right)),
    }
}

// Two lists split alike where their fronts are as long.
theorem Tm::split_eq<A>(xs, ys, us, vs: List<A>, e: xs ++ ys = us ++ vs, len: xs.len() = us.len()): (xs = us) ∧ (ys = vs) {
    let front: (xs = us) = trans(sym(List::take_append_len(xs, ys)),
        trans(cong_fn(λ (l: List<A>) => l.take(xs.len()), e), j(sym(len), λ k _ => (us ++ vs).take(k) = us, List::take_append_len(us, vs))));
    let back: (ys = vs) = trans(sym(List::drop_append_len(xs, ys)),
        trans(cong_fn(λ (l: List<A>) => l.drop(xs.len()), e), j(sym(len), λ k _ => (us ++ vs).drop(k) = vs, List::drop_append_len(us, vs))));
    ⟨front, back⟩
}

// The front of a list put before another, at its length.
theorem Tm::take_front<A>(xs, ys: List<A>, k: Nat, len: xs.len() = k): (xs ++ ys).take(k) = xs {
    j(len, λ m _ => (xs ++ ys).take(m) = xs, List::take_append_len(xs, ys))
}

theorem Ty::fields_past_is(fs: List<Ty>): (p: Nat) → Ty::fields_past(fs, p) = Fun::past(fs, p) {
    match fs { Nil => λ p => refl, Cons(_, rest) => λ p => Ty::fields_past_is(rest, p + 1) }
}

theorem Ty::past_cells(self t: Ty, tys: Table, p: Nat): t.past(tys, p) = Fun::past(t.cells(tys), p) {
    match t {
        Word(_) => refl, Bit => refl, ByteList(_) => refl, Lines => refl,
        Named(i) => Ty::fields_past_is(tys.fields(i), p),
        Count => refl,
        Enum(i) => Ty::fields_past_is(tys.ens(i).slots, p + 1),
    }
}

theorem Ty::fields_ids_below(fs: List<Ty>): (p, n: Nat) → Ty::FieldsBelow(fs, p, n) → Tm::AllBelow(Fun::param_ids(fs, p), n) {
    match fs { Nil => λ p n _ => trivial, Cons(_, rest) => λ p n b => ⟨b.left, Ty::fields_ids_below(rest, p + 1, n, b.right)⟩ }
}

// A value below `n` has its ports below it.
theorem Ty::cell_ids_below(self t: Ty, tys: Table, p, n: Nat): t.Below(tys, p, n) → Tm::AllBelow(Fun::param_ids(t.cells(tys), p), n) {
    match t {
        Word(_) => λ b => ⟨b, trivial⟩, Bit => λ b => ⟨b, trivial⟩, ByteList(_) => λ b => ⟨b, trivial⟩, Lines => λ b => ⟨b, trivial⟩,
        Named(i) => λ b => Ty::fields_ids_below(tys.fields(i), p, n, b),
        Count => λ b => ⟨b, trivial⟩,
        Enum(i) => λ b => Ty::fields_ids_below(Cons(Word(64), tys.ens(i).slots), p, n, b),
    }
}

// What a port holds moves with its 64-bit word, at a code that carries.
theorem Ty::carry_cell(self f: Ty, a, b: Valuation(), pa, pb: Nat, same: b(64, pb) = a(64, pa)):
    f.CellCarries() → (v: f.Flat()) → f.FlatHolds(a, pa, v) → f.FlatHolds(b, pb, v) {
    match f {
        Word(w) => λ (e: w = 64) => j(sym(e), λ m _ => (v: BitVec(m)) → a(m, pa) = v → b(m, pb) = v, λ v h => trans(same, h)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(_) => λ never => false_elim(never),
        Count => λ _ v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), same), h),
        Enum(_) => λ never => false_elim(never),
    }
}

theorem Ty::carry_fields(fs: List<Ty>, a, b: Valuation()): Ty::CellsCarry(fs) → (pa, pb: Nat) →
    words_of(b, Fun::param_ids(fs, pb)) = words_of(a, Fun::param_ids(fs, pa)) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, a, pa, t) → Ty::FieldsHold(fs, b, pb, t) {
    match fs {
        Nil => λ _ pa pb _ t h => h,
        Cons(f, rest) => λ ok pa pb same t h => {
            let head = cong_fn(λ (l: List<BitVec(64)>) => l.head_or(BitVec::zero()), same);
            let tail = cong_fn(λ (l: List<BitVec(64)>) => l.tail(), same);
            ⟨f.carry_cell(a, b, pa, pb, head, ok.left, t.fst, h.left), Ty::carry_fields(rest, a, b, ok.right, pa + 1, pb + 1, tail, t.snd, h.right)⟩
        },
    }
}

theorem Ty::carry_holds(self t: Ty, tys: Table, a, b: Valuation(), pa, pb: Nat):
    t.Carries(tys) → words_of(b, Fun::param_ids(t.cells(tys), pb)) = words_of(a, Fun::param_ids(t.cells(tys), pa)) →
    (v: t.sem(tys)) → t.Holds(tys, a, pa, v) → t.Holds(tys, b, pb, v) {
    let head = λ (same: Cons(b(64, pb), Nil) = Cons(a(64, pa), Nil)) => cong_fn(λ (l: List<BitVec(64)>) => l.head_or(BitVec::zero()), same);
    match t {
        Word(w) => λ (e: w = 64) same => j(sym(e), λ m _ => (v: BitVec(m)) → a(m, pa) = v → b(m, pb) = v, λ v h => trans(head(same), h)),
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok same v h => Ty::carry_fields(tys.fields(i), a, b, ok, pa, pb, same, tys.get(i, v), h),
        Count => λ _ same v h => trans(cong_fn(λ (x: BitVec(64)) => x.toNat(), head(same)), h),
        // The tag word moves as a word, the slots as a record's fields.
        Enum(i) => λ ok same v h => ⟨j(sym(cong_fn(λ (l: List<BitVec(64)>) => l.head_or(BitVec::zero()), same)), λ x _ => tys.ens(i).Names(x, v), h.left),
            Ty::carry_fields(tys.ens(i).slots, a, b, ok, pa + 1, pb + 1, cong_fn(λ (l: List<BitVec(64)>) => l.tail(), same), tys.ens(i).fields(v), h.right)⟩,
    }
}

// What a carry promises: as many words as cells; the ports read below
// whatever the context is below; the ports inside below anything past the
// cells' end; and the context held at the inner ports, a left-out
// variable's value read back (`Env::refill`), wherever the cells' words
// are the words read.
fn Tm::CarryHolds(tys: Table, g: List<Ty>, ks: List<Bool>, ports: List<Nat>, at: Nat, r: Option<Carry>) → Type {
    match r {
        None => True,
        Some(c) => (c.src.len() = c.cells.len()) ∧ (((n: Nat) → Below(tys, g, ports, n) → Tm::AllBelow(c.src, n)) ∧
            (((n: Nat) → Fun::past(c.cells, at) < n → Below(tys, g, c.inner, n)) ∧
            ((a, b: Valuation()) → (env: Env(tys, g)) → words_of(b, Fun::param_ids(c.cells, at)) = words_of(a, c.src) →
                EnvHolds(tys, a, g, ports, env) → EnvHolds(tys, b, g, c.inner, Env::refill(tys, g, ks, c.inner, b, env))))),
    }
}

theorem Tm::carry_sound(tys: Table, st: Ty, home: Nat, g: List<Ty>): (ks: List<Bool>) → (ports: List<Nat>) → (at: Nat) →
    Fun::past(st.cells(tys), home) <= at → Tm::CarryHolds(tys, g, ks, ports, at, Tm::carry(tys, st, home, g, ks, ports, at)) {
    match g {
        Nil => λ ks ports at _ => match ports {
            Nil => ⟨refl, ⟨λ n _ => trivial, ⟨λ n _ => trivial, λ a b env _ held => held⟩⟩⟩,
            Cons(_, _) => trivial,
        },
        Cons(t, rest) => λ ks ports at hp => match ports {
            Nil => trivial,
            Cons(p, ps) => match ks {
                Nil => trivial,
                Cons(k, more) => match k {
                    True => {
                        let cs = t.cells(tys);
                        let at2 = Fun::past(cs, at);
                        let P = λ (r: Option<Carry>) => Tm::CarryHolds(tys, Cons(t, rest), Cons(True, more), Cons(p, ps), at, r);
                        Option::and_then_elim(P, trivial, t.check_carries(tys), λ _ => Tm::carry(tys, st, home, rest, more, ps, at2).and_then(λ c =>
                            Some(Carry(Fun::param_ids(cs, p) ++ c.src, Cons(at, c.inner), cs ++ c.cells))), λ ok _ =>
                        Option::and_then_elim(P, trivial, Tm::carry(tys, st, home, rest, more, ps, at2), λ c =>
                            Some(Carry(Fun::param_ids(cs, p) ++ c.src, Cons(at, c.inner), cs ++ c.cells)), λ c carried => {
                            let ih = j(carried, λ r _ => Tm::CarryHolds(tys, rest, more, ps, at2, r), Tm::carry_sound(tys, st, home, rest, more, ps, at2,
                                Nat::le_trans(Fun::past(st.cells(tys), home), at, at2, hp, Fun::past_ge(cs, at))));
                            let len: ((Fun::param_ids(cs, p) ++ c.src).len() = (cs ++ c.cells).len()) =
                                trans(List::len_append(Fun::param_ids(cs, p), c.src), trans(eq2(λ (x: Nat) (y: Nat) => x + y, Fun::ids_len(cs, p), ih.left),
                                    sym(List::len_append(cs, c.cells))));
                            let past_at: (Fun::past(cs ++ c.cells, at) = Fun::past(c.cells, at2)) = Fun::past_append(cs, c.cells, at);
                            ⟨len, ⟨λ n below => Tm::all_below_append(n, c.src, ih.right.left(n, below.right), Fun::param_ids(cs, p),
                                    t.cell_ids_below(tys, p, n, below.left)),
                                ⟨λ n lt => {
                                    let lt2: (Fun::past(c.cells, at2) < n) = j(past_at, λ x _ => x < n, lt);
                                    ⟨t.below_cells(tys, at, n, Nat::le_of_lt(at2, n, Nat::le_trans(at2 + 1, Fun::past(c.cells, at2) + 1, n,
                                            Nat::le_succ_succ(at2, Fun::past(c.cells, at2), Fun::past_ge(c.cells, at2)), lt2))),
                                        ih.right.right.left(n, lt2)⟩
                                },
                                λ a b env same held => {
                                    let lhs: (words_of(b, Fun::param_ids(cs ++ c.cells, at)) =
                                        words_of(b, Fun::param_ids(cs, at)) ++ words_of(b, Fun::param_ids(c.cells, at2))) =
                                        trans(cong_fn(λ (l: List<Nat>) => words_of(b, l), Fun::ids_append(cs, c.cells, at)),
                                            Fun::words_append(b, Fun::param_ids(cs, at), Fun::param_ids(c.cells, at2)));
                                    let parts = Tm::split_eq(words_of(b, Fun::param_ids(cs, at)), words_of(b, Fun::param_ids(c.cells, at2)),
                                        words_of(a, Fun::param_ids(cs, p)), words_of(a, c.src),
                                        trans(sym(lhs), trans(same, Fun::words_append(a, Fun::param_ids(cs, p), c.src))),
                                        trans(words_of_len(b, Fun::param_ids(cs, at)), trans(Fun::ids_len(cs, at),
                                            sym(trans(words_of_len(a, Fun::param_ids(cs, p)), Fun::ids_len(cs, p))))));
                                    ⟨t.carry_holds(tys, a, b, p, at, ok, parts.left, env.fst, held.left),
                                        ih.right.right.right(a, b, env.snd, parts.right, held.right)⟩
                                }⟩⟩⟩
                        }))
                    },
                    False => {
                        let P = λ (r: Option<Carry>) => Tm::CarryHolds(tys, Cons(t, rest), Cons(False, more), Cons(p, ps), at, r);
                        Option::and_then_elim(P, trivial, t.drop_at(tys, st, home, at), λ d => Tm::carry(tys, st, home, rest, more, ps, at).and_then(λ c =>
                            Some(Carry(c.src, Cons(d.port, c.inner), c.cells))), λ d _ =>
                        Option::and_then_elim(P, trivial, Tm::carry(tys, st, home, rest, more, ps, at), λ c => Some(Carry(c.src, Cons(d.port, c.inner), c.cells)),
                            λ c carried => {
                            let ih = j(carried, λ r _ => Tm::CarryHolds(tys, rest, more, ps, at, r), Tm::carry_sound(tys, st, home, rest, more, ps, at, hp));
                            ⟨ih.left, ⟨λ n below => ih.right.left(n, below.right),
                                ⟨λ n lt => ⟨d.below(n, Nat::le_trans(at + 1, Fun::past(c.cells, at) + 1, n,
                                        Nat::le_succ_succ(at, Fun::past(c.cells, at), Fun::past_ge(c.cells, at)), lt), hp),
                                    ih.right.right.left(n, lt)⟩,
                                λ a b env same held => ⟨t.fill_holds(tys, b, d.port, d.fills, env.fst), ih.right.right.right(a, b, env.snd, same, held.right)⟩⟩⟩⟩
                        }))
                    },
                },
            },
        },
    }
}

// A state's words, read back at port 0 of a valuation binding them: what
// the loop's state relation asks of the state's part of its words.
fn Ty::WordsHold(self st: Ty, tys: Table, sw: List<BitVec(64)>, s: st.sem(tys)) → Type {
    st.Holds(tys, Valuation::bind(Valuation::zero(), Fun::param_ids(st.cells(tys), 0), sw), 0, s)
}

// The state held at a port's words.
theorem Ty::words_hold_in(self st: Ty, tys: Table, ok: st.Carries(tys), v: Valuation(), q: Nat, sw: List<BitVec(64)>, s: st.sem(tys),
    words: words_of(v, Fun::param_ids(st.cells(tys), q)) = sw, len: sw.len() = st.cells(tys).len(), h: st.WordsHold(tys, sw, s)):
    st.Holds(tys, v, q, s) {
    let ids0 = Fun::param_ids(st.cells(tys), 0);
    st.carry_holds(tys, Valuation::bind(Valuation::zero(), ids0, sw), v, 0, q, ok,
        trans(words, sym(words_of_bind(Valuation::zero(), ids0, Fun::ids_distinct(st.cells(tys), 0), sw, trans(Fun::ids_len(st.cells(tys), 0), sym(len))))),
        s, h)
}

// A state held at a port: its words hold it.
theorem Ty::words_hold_out(self st: Ty, tys: Table, ok: st.Carries(tys), v: Valuation(), q: Nat, s: st.sem(tys), h: st.Holds(tys, v, q, s)):
    st.WordsHold(tys, words_of(v, Fun::param_ids(st.cells(tys), q)), s) {
    let ids0 = Fun::param_ids(st.cells(tys), 0);
    let sw = words_of(v, Fun::param_ids(st.cells(tys), q));
    st.carry_holds(tys, v, Valuation::bind(Valuation::zero(), ids0, sw), q, 0, ok,
        words_of_bind(Valuation::zero(), ids0, Fun::ids_distinct(st.cells(tys), 0), sw,
            trans(Fun::ids_len(st.cells(tys), 0), sym(trans(words_of_len(v, Fun::param_ids(st.cells(tys), q)), Fun::ids_len(st.cells(tys), q))))),
        s, h)
}

// What a pass promises the loop of a step `q`: the exit bit set where it
// stops, and its next words related to the step's state.
fn Tm::Passes<S>(after: Valuation(), exit: Nat, next: List<Nat>, R: List<BitVec(64)> → S → Type, q: loop::Step<S>) → Type {
    match q {
        Next(t) => (after(1, exit).head_bit() = False) ∧ R(words_of(after, next), t),
        Stop(t) => (after(1, exit).head_bit() = True) ∧ R(words_of(after, next), t),
    }
}

// A loop whose passes each take words related to a state to the words of
// its step's runs the iteration: `loop_eval` with `k` passes left is
// `Loop::steps` with `k` fuel, out of passes answering the state as out of
// fuel.
theorem Tm::loop_steps<S>(step: Valuation() → Valuation(), parameters: List<Nat>, count, exit: Nat, next: List<Nat>,
    R: List<BitVec(64)> → S → Type, turn: S → loop::Step<S>,
    pass: (r: Nat) → (ws: List<BitVec(64)>) → (s: S) → R(ws, s) →
        Tm::Passes(step(pass_valuation(parameters, count, r + 1, ws)), exit, next, R, turn(s)), k: Nat):
    (ws: List<BitVec(64)>) → (s: S) → R(ws, s) →
    R(loop_eval(step, parameters, count, exit, next, k, ws).state, loop::Loop::steps(k, turn, s)) {
    match k {
        Zero => λ ws s h => h,
        Succ(r) => λ ws s h => {
            let after = step(pass_valuation(parameters, count, r + 1, ws));
            let ends = λ (b: Bool) => match b {
                False => loop_eval(step, parameters, count, exit, next, r, words_of(after, next)),
                True => LoopEnd(words_of(after, next), False),
            };
            (match turn(s) as λ q => Tm::Passes(after, exit, next, R, q) →
                R(ends(after(1, exit).head_bit()).state, match q { Next(t) => loop::Loop::steps(r, turn, t), Stop(t) => t }) {
                Next(t) => λ p => j(sym(p.left), λ b _ => R(ends(b).state, loop::Loop::steps(r, turn, t)),
                    Tm::loop_steps(step, parameters, count, exit, next, R, turn, pass, r, words_of(after, next), t, p.right)),
                Stop(t) => λ p => j(sym(p.left), λ b _ => R(ends(b).state, t), p.right),
            })(pass(r, ws, s, h))
        },
    }
}

// The exit bit: the test's bit with 1 exclusive-ored in.
theorem Tm::exit_bit(b: Bool): BitVec::ofBool(b).bxor(BitVec::ofNat(1)).head_bit() = b.not() {
    match b { False => refl, True => refl }
}

// The loop's relation of words to states: the state's words, held by it,
// then the context's `ctx`.
fn Tm::IterWords(tys: Table, st: Ty, ctx: List<BitVec(64)>) → List<BitVec(64)> → st.sem(tys) → Type {
    λ ws s => ((ws.take(st.cells(tys).len()) ++ ctx) = ws) ∧
        ((ws.take(st.cells(tys).len()).len() = st.cells(tys).len()) ∧ st.WordsHold(tys, ws.take(st.cells(tys).len()), s))
}

theorem Tm::iter_words(tys: Table, st: Ty, ctx, sw: List<BitVec(64)>, s: st.sem(tys), len: sw.len() = st.cells(tys).len(),
    h: st.WordsHold(tys, sw, s)): Tm::IterWords(tys, st, ctx, sw ++ ctx, s) {
    let front = Tm::take_front(sw, ctx, st.cells(tys).len(), len);
    ⟨cong_fn(λ (l: List<BitVec(64)>) => l ++ ctx, front), ⟨trans(cong_fn(λ (l: List<BitVec(64)>) => l.len(), front), len),
        j(sym(front), λ l _ => st.WordsHold(tys, l, s), h)⟩⟩
}

theorem Tm::iter_words_len(tys: Table, st: Ty, ctx, ws: List<BitVec(64)>, s: st.sem(tys), h: Tm::IterWords(tys, st, ctx, ws, s)):
    ws.len() = st.cells(tys).len() + ctx.len() {
    trans(cong_fn(λ (l: List<BitVec(64)>) => l.len(), sym(h.left)),
        trans(List::len_append(ws.take(st.cells(tys).len()), ctx), cong_fn(λ (k: Nat) => k + ctx.len(), h.right.left)))
}

// One pass: from words related to a state `s`, the test and body read the
// state at its parameters and the context at theirs; the exit bit is set
// where the test failed, and the next words are related to the step's
// state. The ids the pass reaches come with it.
theorem Tm::iterate_pass(w: World, g: List<Ty>, init: Nat, test, body: Tm, next: Nat, ok: Ty::at(g, init).Carries(w.tys), c: Carry,
    lt, lb: Lowered,
    c_below: Below(w.tys, g, c.inner, Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1),
    t_holds: Tm::LowerHolds(test, w, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner),
        Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1, Some(lt)),
    b_holds: Tm::LowerHolds(body, w, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner), lt.next, Some(lb)),
    e_t: Tm::ty(test, w, Cons(Ty::at(g, init), g)) = Bit, e_b: Tm::ty(body, w, Cons(Ty::at(g, init), g)) = Ty::at(g, init),
    call: Answers(), agree: Tm::CallsAgree(w, call), env: Env(w.tys, g), ctx: List<BitVec(64)>, ctx_len: ctx.len() = c.cells.len(),
    carried: (b: Valuation()) → words_of(b, Fun::param_ids(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next))) = ctx →
        EnvHolds(w.tys, b, g, c.inner, Env::refill(w.tys, g, Tm::iter_keeps(g, Ty::at(g, init), test, body), c.inner, b, env)),
    wi: test.Within(Tm::iter_keep(g, Ty::at(g, init), test, body)) ∧ body.Within(Tm::iter_keep(g, Ty::at(g, init), test, body)),
    r: Nat, ws: List<BitVec(64)>, s: Ty::at(g, init).sem(w.tys), h: Tm::IterWords(w.tys, Ty::at(g, init), ctx, ws, s)):
    (Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1 <= lt.next) ∧ ((lt.next <= lb.next) ∧
    Tm::Passes(Tm::iter_pass(w.tys, Ty::at(g, init), next, lt, lb).eval(call,
            pass_valuation(Fun::param_ids(Ty::at(g, init).cells(w.tys) ++ c.cells, next + 1),
                Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)), r + 1, ws), buffers := w.spans),
        Tm::iter_branch(w.tys, Ty::at(g, init), next, lt, lb).next + 1,
        Fun::param_ids(Ty::at(g, init).cells(w.tys), lb.next) ++ Fun::param_ids(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)),
        Tm::IterWords(w.tys, Ty::at(g, init), ctx),
        loop::Step::turn(
            Ty::cast(w.tys, test.ty(w, Cons(Ty::at(g, init), g)), Bit, test.sem(w, Cons(Ty::at(g, init), g), Pair(s, env))),
            λ _ => Ty::cast(w.tys, body.ty(w, Cons(Ty::at(g, init), g)), Ty::at(g, init), body.sem(w, Cons(Ty::at(g, init), g), Pair(s, env))),
            s))) {
    let tys = w.tys;
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let cs = st.cells(tys);
    let n = cs.len();
    let at = Tm::iter_at(tys, st, next);
    let c0 = Fun::past(c.cells, at);
    let all = cs ++ c.cells;
    let params = Fun::param_ids(all, next + 1);
    let sids = Fun::param_ids(cs, next + 1);
    let cids = Fun::param_ids(c.cells, at);
    let ports2 = Cons(next + 1, c.inner);
    let br = Tm::iter_branch(tys, st, next, lt, lb);
    let counted = Valuation::set(Valuation::zero(), c0, word_value(BitVec::ofNat(r + 1)));
    let pv = pass_valuation(params, c0, r + 1, ws);
    let ws_len: (params.len() = ws.len()) = trans(Fun::ids_len(all, next + 1),
        trans(List::len_append(cs, c.cells), sym(trans(Tm::iter_words_len(tys, st, ctx, ws, s, h), cong_fn(λ (k: Nat) => n + k, ctx_len)))));
    let bound: (words_of(pv, params) = ws) = words_of_bind(counted, params, Fun::ids_distinct(all, next + 1), ws, ws_len);
    let halves = Tm::split_eq(words_of(pv, sids), words_of(pv, cids), ws.take(n), ctx,
        trans(sym(Fun::words_append(pv, sids, cids)), trans(cong_fn(λ (l: List<Nat>) => words_of(pv, l), sym(Fun::ids_append(cs, c.cells, next + 1))),
            trans(bound, sym(h.left)))),
        trans(words_of_len(pv, sids), trans(Fun::ids_len(cs, next + 1), sym(h.right.left))));
    let held_s: st.Holds(tys, pv, next + 1, s) = st.words_hold_in(tys, ok, pv, next + 1, ws.take(n), s, halves.left, h.right.left, h.right.right);
    let c1: (c0 <= c0 + 1) = Nat::le_succ_r(c0, c0, c0.le_refl());
    let below2: Below(tys, inner, ports2, c0 + 1) =
        ⟨st.below_cells(tys, next + 1, c0 + 1, Nat::le_trans(at, c0, c0 + 1, Fun::past_ge(c.cells, at), c1)), c_below⟩;
    let env2 = Pair(s, env);
    // The pass holds the carried variables and reads the others back; the
    // test and body read only the carried, so they mean what they mean at
    // the loop's own environment.
    let ks = Tm::iter_keeps(g, Ty::at(g, init), test, body);
    let refilled = Env::refill(tys, g, ks, c.inner, pv, env);
    let env2x = Pair(s, refilled);
    let ag = Env::agree_under(tys, g, st, λ i => Tm::flag(ks, i), s, s, refl, env, refilled, Env::refill_agree(tys, g, ks, c.inner, pv, env));
    let same_t: (Tm::sem(test, w, inner, env2) = Tm::sem(test, w, inner, env2x)) =
        Tm::sem_kept(test, w, Tm::iter_keep(g, Ty::at(g, init), test, body), inner, env2, env2x, wi.left, ag);
    let same_b: (Tm::sem(body, w, inner, env2) = Tm::sem(body, w, inner, env2x)) =
        Tm::sem_kept(body, w, Tm::iter_keep(g, Ty::at(g, init), test, body), inner, env2, env2x, wi.right, ag);
    let held2: EnvHolds(tys, pv, inner, ports2, env2x) = ⟨held_s, carried(pv, halves.right)⟩;
    let ran_t = t_holds(call, agree, pv, env2x, held2, below2);
    let pvt = lt.region.eval(call, pv, buffers := w.spans);
    let tv = Ty::cast(tys, Tm::ty(test, w, inner), Bit, Tm::sem(test, w, inner, env2));
    let bit_t: (pvt(1, lt.result) = BitVec::ofBool(tv)) =
        trans(Ty::cast_holds(tys, pvt, lt.result, Tm::ty(test, w, inner), Bit, e_t, Tm::sem(test, w, inner, env2x), ran_t.right.right.right),
            cong_fn(λ (x: Tm::ty(test, w, inner).sem(tys)) => BitVec::ofBool(Ty::cast(tys, Tm::ty(test, w, inner), Bit, x)), sym(same_t)));
    let tr_lt: (lt.result < lt.next) = Ty::below_cast(tys, Tm::ty(test, w, inner), Bit, e_t, lt.result, lt.next, ran_t.right.left);
    let held_t: EnvHolds(tys, pvt, inner, ports2, env2x) = env_holds_keeps(tys, inner, pv, pvt, c0 + 1, ran_t.right.right.left, ports2, env2x, below2, held2);
    let ran_b = b_holds(call, agree, pvt, env2x, held_t, below_mono(tys, inner, c0 + 1, lt.next, ran_t.left, ports2, below2));
    let pvb = lb.region.eval(call, pvt, buffers := w.spans);
    let bv = Ty::cast(tys, Tm::ty(body, w, inner), st, Tm::sem(body, w, inner, env2));
    let held_b: st.Holds(tys, pvb, lb.result, bv) = j(sym(same_b), λ x _ => st.Holds(tys, pvb, lb.result, Ty::cast(tys, Tm::ty(body, w, inner), st, x)),
        Ty::cast_holds(tys, pvb, lb.result, Tm::ty(body, w, inner), st, e_b, Tm::sem(body, w, inner, env2x), ran_b.right.right.right));
    let below_b = Ty::below_cast(tys, Tm::ty(body, w, inner), st, e_b, lb.result, lb.next, ran_b.right.left);
    let out = lb.next;
    let moved_t = st.moves_sound(tys, w.spans, pvb, out, lb.result, below_b, bv, held_b);
    let below_s: st.Below(tys, next + 1, out) = st.below_mono(tys, next + 1, c0 + 1, out, Nat::le_trans(c0 + 1, lt.next, out, ran_t.left, ran_b.left), below2.left);
    let mid_no = nodes_region(Nil).eval(call, pvt, buffers := w.spans);
    let moved_f = st.moves_sound(tys, w.spans, mid_no, out, next + 1, below_s, s, held_t.left);
    let outs = moved_ports(st.moves(tys, out, lb.result));
    let when_true = Compose(lb.region, nodes_region(st.moves(tys, out, lb.result)));
    let when_false = Compose(nodes_region(Nil), nodes_region(st.moves(tys, out, next + 1)));
    let chosen: (pvt(1, lt.result).head_bit() = tv) = trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), bit_t), BitVec::head_bit_ofBool(tv));
    let pvbr = br.region.eval(call, pvt, buffers := w.spans);
    let fin = match tv { False => s, True => bv };
    let held_br: st.Holds(tys, pvbr, out, fin) =
        branch_holds(st, tys, pvt, lt.result, outs, when_true, when_false, call, w.spans, out, tv, bv, s, chosen, moved_t.left, moved_f.left);
    let keeps_br: Keeps(pvt, pvbr, lt.next) = branch_keeps(pvt, lt.result, outs, when_true, when_false, call, w.spans, lt.next,
        λ wd id below_id => trans(moved_t.right.left(wd, id, Nat::lt_of_lt_of_le(id, lt.next, out, below_id, ran_b.left)),
            ran_b.right.right.left(wd, id, below_id)),
        λ wd id below_id => moved_f.right.left(wd, id, Nat::lt_of_lt_of_le(id, lt.next, out, below_id, ran_b.left)));
    let z = br.next;
    let z_past: (z = Fun::past(cs, out)) = st.past_cells(tys, out);
    let out_z: (out <= z) = j(sym(z_past), λ y _ => out <= y, Fun::past_ge(cs, out));
    let q = Valuation::set(pvbr, z, λ wd => BitVec::ofNat(1));
    let exit_value = λ (w: Nat) => q(w, lt.result).bxor(q(w, z));
    let after = Valuation::set(q, z + 1, exit_value);
    let lt_z: (lt.result < z) = Nat::lt_of_lt_of_le(lt.result, lt.next, z, tr_lt, Nat::le_trans(lt.next, out, z, ran_b.left, out_z));
    let at_tr: (q(1, lt.result) = BitVec::ofBool(tv)) =
        trans(Valuation::set_other(pvbr, z, λ wd => BitVec::ofNat(1), 1, lt.result, Nat::ne_of_lt(lt.result, z, lt_z)),
            trans(keeps_br(1, lt.result, tr_lt), bit_t));
    let at_z: (q(1, z) = BitVec::ofNat(1)) = Valuation::set_here(pvbr, z, λ wd => BitVec::ofNat(1), 1);
    let exit: (after(1, z + 1).head_bit() = tv.not()) =
        trans(cong_fn(λ (x: BitVec(1)) => x.head_bit(), Valuation::set_here(q, z + 1, exit_value, 1)),
            trans(eq2(λ (a: BitVec(1)) (b: BitVec(1)) => a.bxor(b).head_bit(), at_tr, at_z), Tm::exit_bit(tv)));
    let keeps_end: Keeps(pvbr, after, z) = λ wd id below_id =>
        trans(Valuation::set_other(q, z + 1, exit_value, wd, id, Nat::ne_of_lt(id, z + 1, Nat::lt_of_lt_of_le(id, z, z + 1, below_id, Nat::le_succ_r(z, z, z.le_refl())))),
            Valuation::set_other(pvbr, z, λ x => BitVec::ofNat(1), wd, id, Nat::ne_of_lt(id, z, below_id)));
    let below_out: st.Below(tys, out, z) = st.below_cells(tys, out, z, j(sym(z_past), λ y _ => Fun::past(cs, out) <= y, Fun::past(cs, out).le_refl()));
    let held_end: st.Holds(tys, after, out, fin) = st.holds_at(tys, pvbr, after, out, out, st.same_kept(tys, pvbr, after, z, keeps_end, out, below_out), fin, held_br);
    let sw = words_of(after, Fun::param_ids(cs, out));
    let sw_len: (sw.len() = n) = trans(words_of_len(after, Fun::param_ids(cs, out)), Fun::ids_len(cs, out));
    let keeps_all: Keeps(pv, after, c0 + 1) = λ wd id below_id => {
        let lt1 = Nat::lt_of_lt_of_le(id, c0 + 1, lt.next, below_id, ran_t.left);
        trans(keeps_end(wd, id, Nat::lt_of_lt_of_le(id, lt.next, z, lt1, Nat::le_trans(lt.next, out, z, ran_b.left, out_z))),
            trans(keeps_br(wd, id, lt1), ran_t.right.right.left(wd, id, below_id)))
    };
    let ctx_same: (words_of(after, cids) = ctx) =
        trans(Tm::words_kept(pv, after, c0 + 1, keeps_all, cids, Tm::ids_below(c.cells, at, c0 + 1, c1)), halves.right);
    let next_words: (words_of(after, Fun::param_ids(cs, out) ++ cids) = sw ++ ctx) =
        trans(Fun::words_append(after, Fun::param_ids(cs, out), cids), cong_fn(λ (l: List<BitVec(64)>) => sw ++ l, ctx_same));
    let related = λ (t: st.sem(tys)) (hw: st.WordsHold(tys, sw, t)) =>
        j(sym(next_words), λ l _ => Tm::IterWords(tys, st, ctx, l, t), Tm::iter_words(tys, st, ctx, sw, t, sw_len, hw));
    let words_end = st.words_hold_out(tys, ok, after, out, fin, held_end);
    ⟨ran_t.left, ⟨ran_b.left,
        (match tv as λ b => (after(1, z + 1).head_bit() = b.not()) → st.WordsHold(tys, sw, match b { False => s, True => bv }) →
            Tm::Passes(after, z + 1, Fun::param_ids(cs, out) ++ cids, Tm::IterWords(tys, st, ctx), loop::Step::turn(b, λ _ => bv, s)) {
            True => λ ex hw => ⟨ex, related(bv, hw)⟩,
            False => λ ex hw => ⟨ex, related(s, hw)⟩,
        })(exit, words_end)⟩⟩
}

// The loop: its words start related to the state the variable holds, the
// passes keep them related, and its outputs hold the state they end at.
theorem Tm::iterate_holds(w: World, g: List<Ty>, ports: List<Nat>, next, init, pi: Nat, test, body: Tm, at_pi: port_at(ports, init) = Some(pi),
    ok: Ty::at(g, init).Carries(w.tys), wi: test.Within(Tm::iter_keep(g, Ty::at(g, init), test, body)) ∧ body.Within(Tm::iter_keep(g, Ty::at(g, init), test, body)), c: Carry,
    ch: Tm::CarryHolds(w.tys, g, Tm::iter_keeps(g, Ty::at(g, init), test, body), ports, Tm::iter_at(w.tys, Ty::at(g, init), next), Some(c)),
    lt, lb: Lowered,
    t_holds: Tm::LowerHolds(test, w, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner),
        Fun::past(c.cells, Tm::iter_at(w.tys, Ty::at(g, init), next)) + 1, Some(lt)),
    b_holds: Tm::LowerHolds(body, w, Cons(Ty::at(g, init), g), Cons(next + 1, c.inner), lt.next, Some(lb)),
    e_t: Tm::ty(test, w, Cons(Ty::at(g, init), g)) = Bit, e_b: Tm::ty(body, w, Cons(Ty::at(g, init), g)) = Ty::at(g, init)):
    Tm::LowerHolds(Iterate(init, test, body), w, g, ports, next, Some(Tm::iter_region(w.tys, Ty::at(g, init), pi, next, c, lt, lb))) {
    λ call agree values env held below => {
        let tys = w.tys;
        let st = Ty::at(g, init);
        let inner = Cons(st, g);
        let cs = st.cells(tys);
        let n = cs.len();
        let at = Tm::iter_at(tys, st, next);
        let c0 = Fun::past(c.cells, at);
        let all = cs ++ c.cells;
        let params = Fun::param_ids(all, next + 1);
        let cids = Fun::param_ids(c.cells, at);
        let br = Tm::iter_branch(tys, st, next, lt, lb);
        let z = br.next;
        let o = z + 2;
        let outs = Fun::param_ids(all, o);
        let x = Fun::past(all, o);
        let loopnext = Fun::param_ids(cs, lb.next) ++ cids;
        let values1 = Valuation::set(values, next, λ wd => BitVec::ofNat(Tm::passes()));
        let inputs = Fun::param_ids(cs, pi) ++ c.src;
        let ctx = words_of(values, c.src);
        let v0 = Env::get(tys, g, env, init);
        let held0: st.Holds(tys, values, pi, v0) = env_holds_at(tys, values, g, ports, env, held, init, pi, at_pi);
        let below0: st.Below(tys, pi, next) = below_at(tys, g, ports, next, below, init, pi, at_pi);
        let keeps1: Keeps(values, values1, next) = λ wd id below_id =>
            Valuation::set_other(values, next, λ y => BitVec::ofNat(Tm::passes()), wd, id, Nat::ne_of_lt(id, next, below_id));
        let in_below: Tm::AllBelow(inputs, next) =
            Tm::all_below_append(next, c.src, ch.right.left(next, below), Fun::param_ids(cs, pi), st.cell_ids_below(tys, pi, next, below0));
        let sw0 = words_of(values, Fun::param_ids(cs, pi));
        let ws0: (words_of(values1, inputs) = sw0 ++ ctx) =
            trans(Tm::words_kept(values, values1, next, keeps1, inputs, in_below), Fun::words_append(values, Fun::param_ids(cs, pi), c.src));
        let sw0_len: (sw0.len() = n) = trans(words_of_len(values, Fun::param_ids(cs, pi)), Fun::ids_len(cs, pi));
        let r0: Tm::IterWords(tys, st, ctx, words_of(values1, inputs), v0) = j(sym(ws0), λ l _ => Tm::IterWords(tys, st, ctx, l, v0),
            Tm::iter_words(tys, st, ctx, sw0, v0, sw0_len, st.words_hold_out(tys, ok, values, pi, v0, held0)));
        let ctx_len: (ctx.len() = c.cells.len()) = trans(words_of_len(values, c.src), ch.left);
        let c_below: Below(tys, g, c.inner, c0 + 1) = ch.right.right.left(c0 + 1, c0.lt_succ_self());
        let carried = λ (b: Valuation()) (same: words_of(b, cids) = ctx) => ch.right.right.right(values, b, env, same, held);
        let pass = λ (r: Nat) (ws: List<BitVec(64)>) (s: st.sem(tys)) (h: Tm::IterWords(tys, st, ctx, ws, s)) =>
            Tm::iterate_pass(w, g, init, test, body, next, ok, c, lt, lb, c_below, t_holds, b_holds, e_t, e_b, call, agree, env, ctx, ctx_len,
                carried, wi, r, ws, s, h);
        let turn = λ (s: st.sem(tys)) => loop::Step::turn(
            Ty::cast(tys, test.ty(w, inner), Bit, test.sem(w, inner, Pair(s, env))),
            λ _ => Ty::cast(tys, body.ty(w, inner), st, body.sem(w, inner, Pair(s, env))), s);
        let stepf = λ (pv: Valuation()) => Tm::iter_pass(tys, st, next, lt, lb).eval(call, pv, buffers := w.spans);
        let first = pass(0, words_of(values1, inputs), v0, r0);
        let ran = Tm::loop_steps(stepf, params, c0, z + 1, loopnext, Tm::IterWords(tys, st, ctx), turn, λ r ws s h => (pass(r, ws, s, h)).right.right,
            values1(64, next).toNat(), words_of(values1, inputs), v0, r0);
        let at_bound: (values1(64, next).toNat() = Tm::passes()) = trans(
            cong_fn(λ (v: BitVec(64)) => v.toNat(), Valuation::set_here(values, next, λ wd => BitVec::ofNat(Tm::passes()), 64)),
            BitVec::toNat_ofNat(64, Tm::passes(), trivial));
        let end = loop_eval(stepf, params, c0, z + 1, loopnext, values1(64, next).toNat(), words_of(values1, inputs));
        let fin = loop::Loop::steps(Tm::passes(), turn, v0);
        let rel: Tm::IterWords(tys, st, ctx, end.state, fin) =
            j(at_bound, λ k _ => Tm::IterWords(tys, st, ctx, end.state, loop::Loop::steps(k, turn, v0)), ran);
        let bv1 = Valuation::bind(values1, outs, end.state);
        let after = Valuation::set(bv1, x, bit_value(end.exhausted));
        let end_len: (outs.len() = end.state.len()) = trans(Fun::ids_len(all, o),
            trans(List::len_append(cs, c.cells), sym(trans(Tm::iter_words_len(tys, st, ctx, end.state, fin, rel), cong_fn(λ (k: Nat) => n + k, ctx_len)))));
        let bound_out: (words_of(bv1, outs) = end.state) = words_of_bind(values1, outs, Fun::ids_distinct(all, o), end.state, end_len);
        let ids_o = Fun::param_ids(cs, o);
        let rest_o = Fun::param_ids(c.cells, Fun::past(cs, o));
        let a_words = words_of(bv1, ids_o);
        let a_len: (a_words.len() = n) = trans(words_of_len(bv1, ids_o), Fun::ids_len(cs, o));
        let a_is: (a_words = end.state.take(n)) = trans(sym(Tm::take_front(a_words, words_of(bv1, rest_o), n, a_len)),
            cong_fn(λ (l: List<BitVec(64)>) => l.take(n), trans(sym(Fun::words_append(bv1, ids_o, rest_o)),
                trans(cong_fn(λ (l: List<Nat>) => words_of(bv1, l), sym(Fun::ids_append(cs, c.cells, o))), bound_out))));
        let keeps_x: Keeps(bv1, after, x) = λ wd id below_id => Valuation::set_other(bv1, x, bit_value(end.exhausted), wd, id, Nat::ne_of_lt(id, x, below_id));
        let o_past: (Fun::past(cs, o) <= x) = Fun::past_first(cs, c.cells, o);
        let read: (words_of(after, ids_o) = end.state.take(n)) =
            trans(Tm::words_kept(bv1, after, x, keeps_x, ids_o, Tm::ids_below(cs, o, x, o_past)), a_is);
        let held_fin: st.Holds(tys, after, o, fin) = st.words_hold_in(tys, ok, after, o, end.state.take(n), fin, read, rel.right.left, rel.right.right);
        // `next` below the pass's ids, and those below the outputs.
        let le_at: (next + 1 <= at) = Fun::past_ge(cs, next + 1);
        let le_c0: (at <= c0) = Fun::past_ge(c.cells, at);
        let le_lb: (c0 + 1 <= lb.next) = Nat::le_trans(c0 + 1, lt.next, lb.next, first.left, first.right.left);
        let le_z: (lb.next <= z) = j(sym(st.past_cells(tys, lb.next)), λ y _ => lb.next <= y, Fun::past_ge(cs, lb.next));
        let next_z: (next < z) = Nat::le_trans(next + 1, at, z, le_at, Nat::le_trans(at, c0 + 1, z, Nat::le_succ_r(at, c0, le_c0),
            Nat::le_trans(c0 + 1, lb.next, z, le_lb, le_z)));
        let next_o: (next < o) = Nat::lt_of_lt_of_le(next, z, o, next_z, Nat::le_succ_r(z, z + 1, Nat::le_succ_r(z, z, z.le_refl())));
        let o_x: (o <= x) = Fun::past_ge(all, o);
        ⟨Nat::le_succ_r(next, x, Nat::le_of_lt(next, x, Nat::lt_of_lt_of_le(next, o, x, next_o, o_x))),
            ⟨st.below_cells(tys, o, x + 1, Nat::le_succ_r(Fun::past(cs, o), x, o_past)),
                ⟨λ wd id below_id => {
                    let id_o: (id < o) = Nat::lt_trans(id, next, o, below_id, next_o);
                    trans(keeps_x(wd, id, Nat::lt_of_lt_of_le(id, o, x, id_o, o_x)),
                        trans(Valuation::bind_frame(values1, outs, end.state, wd, id, Fun::absent_ids(all, o, id, Inl(id_o))), keeps1(wd, id, below_id)))
                }, held_fin⟩⟩⟩
    }
}

theorem Tm::iterate_sound(init: Nat, test, body: Tm, w: World,
    ih_test: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(test, w, g, ports, next, Tm::lower(test, w, g, ports, next)),
    ih_body: (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) → Tm::LowerHolds(body, w, g, ports, next, Tm::lower(body, w, g, ports, next)),
    g: List<Ty>, ports: List<Nat>, next: Nat):
    Tm::LowerHolds(Iterate(init, test, body), w, g, ports, next, Tm::lower(Iterate(init, test, body), w, g, ports, next)) {
    let tys = w.tys;
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let at = Tm::iter_at(tys, st, next);
    let ks = Tm::iter_keeps(g, Ty::at(g, init), test, body);
    let K = Tm::iter_keep(g, Ty::at(g, init), test, body);
    let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Iterate(init, test, body), w, g, ports, next, r);
    let lower_test = λ (ps: List<Nat>) (k: Nat) => Tm::lower(test, w, inner, ps, k);
    let lower_body = λ (ps: List<Nat>) (k: Nat) => Tm::lower(body, w, inner, ps, k);
    let from_body = λ (pi: Nat) (c: Carry) (lt: Lowered) =>
        lower_body(Cons(next + 1, c.inner), lt.next).and_then(λ lb => Tm::iter_checked(w, st, inner, test, body, pi, next, c, lt, lb));
    let from_test = λ (pi: Nat) (c: Carry) => lower_test(Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt => from_body(pi, c, lt));
    let from_carry = λ (pi: Nat) => Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c => from_test(pi, c));
    let from_within = λ (pi: Nat) => Tm::both(test.check_within(K), body.check_within(K)).and_then(λ _ => from_carry(pi));
    Option::and_then_elim(P, trivial, port_at(ports, init),
        λ pi => Tm::lower_iterate(w, g, ports, next, init, pi, test, body, lower_test, lower_body), λ pi at_pi =>
    Option::and_then_elim(P, trivial, st.check_carries(tys), λ _ => from_within(pi), λ ok _ =>
    Option::and_then_elim(P, trivial, Tm::both(test.check_within(K), body.check_within(K)), λ _ => from_carry(pi), λ wi _ =>
    Option::and_then_elim(P, trivial, Tm::carry(tys, st, next + 1, g, ks, ports, at), λ c => from_test(pi, c), λ c carried =>
    Option::and_then_elim(P, trivial, lower_test(Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1), λ lt => from_body(pi, c, lt), λ lt lowered_t =>
    Option::and_then_elim(P, trivial, lower_body(Cons(next + 1, c.inner), lt.next),
        λ lb => Tm::iter_checked(w, st, inner, test, body, pi, next, c, lt, lb), λ lb lowered_b =>
    Option::and_then_elim(P, trivial, Tm::ty(test, w, inner).check(Bit), λ _ => Tm::ty(body, w, inner).check(st).and_then(λ _ =>
        Some(Tm::iter_region(tys, st, pi, next, c, lt, lb))), λ e_t _ =>
    Option::and_then_elim(P, trivial, Tm::ty(body, w, inner).check(st), λ _ => Some(Tm::iter_region(tys, st, pi, next, c, lt, lb)), λ e_b _ =>
        Tm::iterate_holds(w, g, ports, next, init, pi, test, body, at_pi, ok, wi, c,
            j(carried, λ r _ => Tm::CarryHolds(tys, g, ks, ports, at, r), Tm::carry_sound(tys, st, next + 1, g, ks, ports, at, Fun::past(st.cells(tys), next + 1).le_refl())), lt, lb,
            j(lowered_t, λ r _ => Tm::LowerHolds(test, w, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1, r),
                ih_test(inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1)),
            j(lowered_b, λ r _ => Tm::LowerHolds(body, w, inner, Cons(next + 1, c.inner), lt.next, r), ih_body(inner, Cons(next + 1, c.inner), lt.next)),
            e_t, e_b)))))))))
}

theorem Tm::lower_sound(self t: Tm, w: World): (g: List<Ty>) → (ports: List<Nat>) → (next: Nat) →
    Tm::LowerHolds(t, w, g, ports, next, Tm::lower(t, w, g, ports, next)) {
    match t {
        Var(i) => λ g ports next =>
            Option::and_then_elim(λ (r: Option<Lowered>) => Tm::LowerHolds(Var(i), w, g, ports, next, r), trivial,
                port_at(ports, i), λ p => Some(Lowered(nodes_region(Nil), p, next)), λ p at =>
                λ call agree values env held below =>
                    ⟨next.le_refl(), ⟨below_at(w.tys, g, ports, next, below, i, p, at),
                        ⟨λ wd id _ => refl, env_holds_at(w.tys, values, g, ports, env, held, i, p, at)⟩⟩⟩),
        Lit(c, n) => λ g ports next => Tm::lower_lit_sound(w, g, ports, next, c, n),
        Prim(op, args) => λ g ports next => Tm::lower_prim_sound(op, w, g, ports, next, args),
        Let(e, body) => λ g ports next => {
            let P = λ (r: Option<Lowered>) => Tm::LowerHolds(Let(e, body), w, g, ports, next, r);
            let inner = Cons(Tm::ty(e, w, g), g);
            Option::and_then_elim(P, trivial, Tm::lower(e, w, g, ports, next),
                λ le => Tm::lower(body, w, inner, Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb)), λ le lowered_e =>
            Option::and_then_elim(P, trivial, Tm::lower(body, w, inner, Cons(le.result, ports), le.next), λ lb => Tm::compose(le, lb),
                λ lb lowered_body => λ call agree values env held below => {
                    let first = j(lowered_e, λ r _ => Tm::LowerHolds(e, w, g, ports, next, r),
                        Tm::lower_sound(e, w, g, ports, next))(call, agree, values, env, held, below);
                    let mid = le.region.eval(call, values, buffers := w.spans);
                    let then = j(lowered_body, λ r _ => Tm::LowerHolds(body, w, inner, Cons(le.result, ports), le.next, r),
                        Tm::lower_sound(body, w, inner, Cons(le.result, ports), le.next))(call, agree, mid, Pair(Tm::sem(e, w, g, env), env),
                        ⟨first.right.right.right, env_holds_keeps(w.tys, g, values, mid, next, first.right.right.left, ports, env, below, held)⟩,
                        ⟨first.right.left, below_mono(w.tys, g, next, le.next, first.left, ports, below)⟩);
                    ⟨Nat::le_trans(next, le.next, lb.next, first.left, then.left), ⟨then.right.left,
                        ⟨λ wd id lt => trans(then.right.right.left(wd, id, Nat::lt_of_lt_of_le(id, next, le.next, lt, first.left)),
                            first.right.right.left(wd, id, lt)),
                            then.right.right.right⟩⟩⟩
                }))
        },
        If(c, yes, no) => λ g ports next => Tm::if_sound(c, yes, no, w,
            λ g2 ports2 next2 => Tm::lower_sound(yes, w, g2, ports2, next2), λ g2 ports2 next2 => Tm::lower_sound(no, w, g2, ports2, next2),
            g, ports, next),
        IfEq(c, yes, no) => λ g ports next => Tm::ifeq_of_if(c, yes, no, w, g, ports, next, Tm::lower(If(c, yes, no), w, g, ports, next),
            Tm::if_sound(c, yes, no, w,
                λ g2 ports2 next2 => Tm::lower_sound(yes, w, g2, ports2, next2), λ g2 ports2 next2 => Tm::lower_sound(no, w, g2, ports2, next2),
                g, ports, next)),
        Make(i, args) => λ g ports next => Tm::lower_make_sound(w, g, ports, next, i, args),
        Field(i, k, of) => λ g ports next => Tm::lower_field_sound(w, g, ports, next, i, k, of),
        Call(f, args) => λ g ports next => Tm::lower_call_sound(w, g, ports, next, f, args),
        Fold(_, _, _) => λ g ports next => trivial,
        Case(_, _, _) => λ g ports next => trivial,
        Byte(k, i, length) => λ g ports next => Tm::lower_byte_sound(w, g, ports, next, k, i, length),
        Pick(i, c, arms, eq) => λ g ports next => Tm::pick_sound(i, c, arms, eq, w, λ g2 ports2 next2 => Tm::lower_sound(arms, w, g2, ports2, next2), g, ports, next),
        Inject(i, k, args) => λ g ports next => Tm::lower_inject_sound(w, g, ports, next, i, k, args),
        Slot(i, j, of) => λ g ports next => Tm::lower_slot_sound(w, g, ports, next, i, j, of),
        Iterate(init, test, body) => λ g ports next => Tm::iterate_sound(init, test, body, w,
            λ g2 ports2 next2 => Tm::lower_sound(test, w, g2, ports2, next2), λ g2 ports2 next2 => Tm::lower_sound(body, w, g2, ports2, next2), g, ports, next),
    }
}

// ---------------------------------------------------------------------------
// Narrow words at a function's boundary (issues/runtime-repr-narrow-words.md).
// A plain function's parameter or result may be a word narrower than 64
// bits. It still crosses the boundary in a 64-bit word: a parameter is the
// word's low bits, read into a fresh port by one `Resize` before the body
// (`Fun::entry`), so that the x86 lowering finds it zero-extended in its
// register; the result is zero-extended into a fresh port by one `Resize`
// after the body (`widen`).
// Calls and loops keep `Ty::OneWord`: a call of a function with a narrow
// word would widen its argument first, which the call's lowering does not
// do yet.

// A code a plain function's boundary passes in one 64-bit word: one held
// in a 64-bit word (`Ty::OneWord`), or a word narrower than one.
fn Ty::Edge(self t: Ty, tys: Table) → Type {
    match t { Word(w) => (w = 64) ∨ (w < 64), Bit => True, ByteList(_) => False, Lines => False, Named(i) => tys.recs(i).fields = [Word(64)], Count => False, Enum(_) => False }
}

fn Ty::check_edge(self t: Ty, tys: Table) → Option<t.Edge(tys)> {
    match t as λ x => Option<x.Edge(tys)> {
        Word(w) => Ty::check_narrow(w),
        Bit => Some(trivial), ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_fields_word(tys.recs(i).fields),
        Count => None,
        Enum(_) => None,
    }
}

// A code a plain function takes at its boundary: one it passes in a word
// (`Ty::Edge`), or an enum, passed in its tag word and then a word for
// each of its payload's slots, each a 64-bit word (design §16.16).
fn Ty::Param(self t: Ty, tys: Table) → Type {
    match t {
        Word(_) => t.Edge(tys), Bit => True, ByteList(_) => False, Lines => False, Named(i) => Ty::Slots(tys.fields(i)) ∧ Ty::NoEnums(tys.recs(i).fields), Count => False,
        Enum(i) => ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Slots(tys.ens(i).slots),
    }
}

fn Ty::check_param(self t: Ty, tys: Table) → Option<t.Param(tys)> {
    match t as λ x => Option<x.Param(tys)> {
        Word(w) => Word(w).check_edge(tys), Bit => Some(trivial), ByteList(_) => None, Lines => None,
        Named(i) => Ty::check_slots(tys.fields(i)).and_then(λ ws => Ty::check_no_enums(tys.recs(i).fields).and_then(λ none => Some(⟨ws, none⟩))), Count => None,
        Enum(i) => match (tys.ens(i).last + 1).leb(Nat::pow(2, 64)) as λ b => Option<(b = True) ∧ Ty::Slots(tys.ens(i).slots)> {
            False => None,
            True => Ty::check_slots(tys.ens(i).slots).and_then(λ ws => Some(⟨refl, ws⟩)),
        },
    }
}

// Every parameter passes the boundary (`Ty::Param`).
fn Ty::Edges(tys: Table, ps: List<Ty>) → Type {
    match ps { Nil => True, Cons(p, rest) => p.Param(tys) ∧ Ty::Edges(tys, rest) }
}

fn Ty::check_edges(tys: Table, ps: List<Ty>) → Option<Ty::Edges(tys, ps)> {
    match ps {
        Nil => Some(trivial),
        Cons(p, rest) => p.check_param(tys).and_then(λ e => Ty::check_edges(tys, rest).and_then(λ ok => Some(⟨e, ok⟩))),
    }
}

// A code the boundary passes spans one port.
theorem Ty::edge_below(tys: Table, t: Ty): t.Edge(tys) → (m: Nat) → t.Below(tys, m, m + 1) {
    match t {
        Word(_) => λ _ m => m.lt_succ_self(),
        Bit => λ _ m => m.lt_succ_self(),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e m => Ty::one_word_below(tys, Named(i), e, m),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A record's or an enum's result with a narrow slot: every slot moved to
// fresh ports from `next`, a narrow one zero-extended by a `Resize`, so
// that each port passed back holds its slot's word (design §16.18).
fn Ty::widen_node(self f: Ty, out, src: Nat) → Node {
    match f.slot_narrow() { True => Resize(f.width(), 64, out, src), False => Move(64, out, src) }
}

fn Ty::widen_slots(fs: List<Ty>, out, src: Nat) → List<Node> {
    match fs { Nil => Nil, Cons(f, rest) => Cons(f.widen_node(out, src), Ty::widen_slots(rest, out + 1, src + 1)) }
}

fn Ty::widen_fields(fs: List<Ty>, c: Lowered) → Lowered {
    match Ty::slots_narrow(fs) { False => c, True => Lowered(Compose(c.region, nodes_region(Ty::widen_slots(fs, c.next, c.result))), c.next, c.next + fs.len()) }
}

theorem Ty::widen_node_output(f: Ty, out, src: Nat): node_output(f.widen_node(out, src)).id = out {
    (match f.slot_narrow() as λ b => node_output(match b { True => Resize(f.width(), 64, out, src), False => Move(64, out, src) }).id = out {
        True => refl, False => refl,
    })
}

// A slot's widening writes its word.
theorem Ty::widen_node_word(f: Ty, ok: f.Slot(), values: Valuation(), buffers: Buffers(), out, src: Nat, x: f.Flat(), h: f.FlatHolds(values, src, x)):
    f.widen_node(out, src).step(values, buffers := buffers)(64, out) = f.flat_word(EnumInfo::nones, x) {
    (match f.slot_narrow() as λ b => f.slot_narrow() = b →
            (match b { True => Resize(f.width(), 64, out, src), False => Move(64, out, src) }).step(values, buffers := buffers)(64, out) = f.flat_word(EnumInfo::nones, x) {
        True => λ _ => trans(Valuation::set_here(values, out, λ wd => BitVec::ofNat(values(f.width(), src).toNat()), 64), Ty::slot_widened(f, ok, values, src, x, h)),
        False => λ e => trans(Valuation::set_here(values, out, λ wd => values(wd, src), 64),
            j(sym(Ty::slot_wide(f, ok, e)), λ g _ => (y: g.Flat()) → g.FlatHolds(values, src, y) → values(64, src) = g.flat_word(EnumInfo::nones, y), λ y hy => hy)(x, h)),
    })(refl)
}

theorem Ty::widen_slots_sound(buffers: Buffers(), fs: List<Ty>): (out, src: Nat) → Ty::Slots(fs) → Ty::FieldsBelow(fs, src, out) → (values: Valuation()) →
    (t: Ty::Flats(fs)) → Ty::FieldsHold(fs, values, src, t) →
    (words_of(eval_nodes_over(buffers, Ty::widen_slots(fs, out, src), values), Ty::ports_from(fs, out)) = Ty::flats_words(fs, t)) ∧
        Keeps(values, eval_nodes_over(buffers, Ty::widen_slots(fs, out, src), values), out) {
    match fs {
        Nil => λ out src _ _ values t _ => ⟨refl, λ wd id lt => refl⟩,
        Cons(f, rest) => λ out src ok below values t held => {
            let node = f.widen_node(out, src);
            let set = node.step(values, buffers := buffers);
            let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
            let kept: Keeps(values, set, out) = λ wd id lt => j(sym(Ty::widen_node_output(f, out, src)), λ o _ =>
                Valuation::set(values, o, node.value(values, buffers := buffers))(wd, id) = values(wd, id),
                Valuation::set_other(values, out, node.value(values, buffers := buffers), wd, id, Nat::ne_of_lt(id, out, lt)));
            let ih = Ty::widen_slots_sound(buffers, rest, out + 1, src + 1, ok.right, Ty::fields_below_mono(rest, out, out + 1, step, src + 1, below.right), set, t.snd,
                Ty::fields_at(rest, values, set, src + 1, src + 1, Ty::fields_kept(rest, values, set, out, kept, src + 1, below.right), t.snd, held.right));
            let head = trans(ih.right(64, out, out.lt_succ_self()), Ty::widen_node_word(f, ok.left, values, buffers, out, src, t.fst, held.left));
            ⟨eq2(λ (a: BitVec(64)) (r: List<BitVec(64)>) => Cons(a, r), head, ih.left),
                λ wd id lt => trans(ih.right(wd, id, Nat::lt_of_lt_of_le(id, out, out + 1, lt, step)), kept(wd, id, lt))⟩
        },
    }
}

// The words at a result's pieces' ports, after the widening, are its
// slots'.
theorem Ty::widen_fields_reads(call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), fs: List<Ty>, c: Lowered, ok: Ty::Slots(fs),
    below: Ty::FieldsBelow(fs, c.result, c.next), t: Ty::Flats(fs), held: Ty::FieldsHold(fs, c.region.eval(call, values, buffers := buffers), c.result, t)):
    words_of(Ty::widen_fields(fs, c).region.eval(call, values, buffers := buffers), Ty::ports_from(fs, Ty::widen_fields(fs, c).result)) = Ty::flats_words(fs, t) {
    let at = c.region.eval(call, values, buffers := buffers);
    let narrow = Lowered(Compose(c.region, nodes_region(Ty::widen_slots(fs, c.next, c.result))), c.next, c.next + fs.len());
    (match Ty::slots_narrow(fs) as λ b => Ty::slots_narrow(fs) = b →
            words_of((match b { False => c, True => narrow }).region.eval(call, values, buffers := buffers), Ty::ports_from(fs, (match b { False => c, True => narrow }).result))
                = Ty::flats_words(fs, t) {
        False => λ e => Ty::ports_reads(at, fs, c.result, Ty::slots_wide(fs, ok, e), t, held),
        True => λ _ => Ty::widen_slots_sound(buffers, fs, c.next, c.result, ok, below, at, t, held).left,
    })(refl)
}

// Fields' words, split at the first.
theorem Ty::fields_words_split(values: Valuation(), fs: List<Ty>, port: Nat): (t: Ty::Flats(fs)) → (fs = Nil → False) →
    words_of(values, Ty::ports_from(fs, port)) = Ty::flats_words(fs, t) →
    (values(64, port) = Ty::flats_head_word(fs, EnumInfo::nones, t)) ∧ (words_of(values, Ty::fields_also_ports(fs, port)) = Ty::flats_tail_words(fs, t)) {
    match fs {
        Nil => λ t no _ => false_elim(no(refl)),
        Cons(f, rest) => λ t _ h => words_cons_parts(values(64, port), words_of(values, Ty::ports_from(rest, port + 1)), Ty::flats_words(Cons(f, rest), t), h),
    }
}

// A function's result at the boundary: a narrow word zero-extended into a
// fresh port by one `Resize`; any other code where the body left it.
fn Ty::widen_by(w: Nat, o: (w = 64) ∨ True, c: Lowered) → Lowered {
    match o { Inl(_) => c, Inr(_) => Lowered(Compose(c.region, nodes_region([Resize(w, 64, c.next, c.result)])), c.next, c.next + 1) }
}

fn Ty::widen(self t: Ty, tys: Table, c: Lowered) → Lowered {
    match t {
        Word(w) => Ty::widen_by(w, w.equation(64), c), Bit => Ty::widen_by(1, Inr(trivial), c), ByteList(_) => c, Lines => c,
        Named(i) => Ty::widen_fields(tys.fields(i), c), Count => c, Enum(i) => Ty::widen_fields(Cons(Word(64), tys.ens(i).slots), c),
    }
}

// The result's 64-bit word, after the widening, is the value read as one.
theorem Ty::edge_reads(tys: Table, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered): t.Edge(tys) →
    (v: t.sem(tys)) → t.Holds(tys, c.region.eval(call, values, buffers := buffers), c.result, v) →
    t.widen(tys, c).region.eval(call, values, buffers := buffers)(64, t.widen(tys, c).result) = Ty::cast(tys, t, Word(64), v) {
    match t {
        Word(w) => λ ok => match ok {
            Inl(e) => j(sym(e), λ y _ => (v: BitVec(y)) → c.region.eval(call, values, buffers := buffers)(y, c.result) = v →
                    Word(y).widen(tys, c).region.eval(call, values, buffers := buffers)(64, Word(y).widen(tys, c).result) = Ty::cast(tys, Word(y), Word(64), v),
                λ v h => trans(h, sym(Ty::cast_self(tys, Word(64), v)))),
            Inr(lt) => λ v h => {
                let ne = Nat::ne_of_lt(w, 64, lt);
                let after = c.region.eval(call, values, buffers := buffers);
                let read: (Valuation::set(after, c.next, λ wd => BitVec::ofNat(after(w, c.result).toNat()), 64, c.next) = Ty::cast(tys, Word(w), Word(64), v)) =
                    trans(Valuation::set_here(after, c.next, λ wd => BitVec::ofNat(after(w, c.result).toNat()), 64),
                        trans(cong_fn(λ (y: BitVec(w)) => BitVec::ofNat(y.toNat(), n := 64), h), sym(Ty::cast_narrow_out(tys, w, ne, v))));
                j(sym(Or::inr_apart(w.equation(64), ne)), λ o _ =>
                    Ty::widen_by(w, o, c).region.eval(call, values, buffers := buffers)(64, Ty::widen_by(w, o, c).result) = Ty::cast(tys, Word(w), Word(64), v),
                    read)
            },
        },
        Bit => λ _ v h => {
            let after = c.region.eval(call, values, buffers := buffers);
            trans(Valuation::set_here(after, c.next, λ wd => BitVec::ofNat(after(1, c.result).toNat()), 64),
                cong_fn(λ (y: BitVec(1)) => BitVec::ofNat(y.toNat(), n := 64), h))
        },
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e v h => {
            let fs = tys.fields(i);
            let held: Ty::FieldsHold(fs, c.region.eval(call, values, buffers := buffers), c.result, tys.get(i, v)) = h;
            let wide = j(sym(tys.word_leaves(i, e)), λ g _ => Ty::slots_narrow(g) = False, refl);
            let same: (Ty::widen_fields(fs, c) = c) = j(sym(wide), λ b _ => (match b { False => c, True => Lowered(Compose(c.region, nodes_region(Ty::widen_slots(fs, c.next, c.result))), c.next, c.next + fs.len()) }) = c, refl);
            j(sym(same), λ d _ => d.region.eval(call, values, buffers := buffers)(64, d.result) = Ty::cast(tys, Named(i), Word(64), v),
                Ty::one_word_reads(tys, c.region.eval(call, values, buffers := buffers), c.result, Named(i), e, v, h))
        },
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// A code a function returns at its boundary: one it passes in a word
// (`Ty::Edge`), a record whose fields are 64-bit words, the first returned
// as the function's word and the rest beside it (`Function.also`, the
// answer registers RDX, RCX, …; docs/native/runtime-fn-setups-design.md
// §16.16-17), or an enum, as its tag word and then a word for each slot of
// its payload, each a 64-bit word. A call reads every word back
// (`Ty::Back`); a C caller is handed two at most, which `compile-x86`
// checks.

// Fields that are 64-bit words, one at least: the first is the word
// returned, the rest beside it.
fn Ty::WordsOne(fs: List<Ty>) → Type {
    match fs { Nil => False, Cons(f, rest) => (f = Word(64)) ∧ Ty::Words(rest) }
}

fn Ty::check_words_one(fs: List<Ty>) → Option<Ty::WordsOne(fs)> {
    match fs as λ g => Option<Ty::WordsOne(g)> {
        Nil => None,
        Cons(f, rest) => f.check(Word(64)).and_then(λ e => Ty::check_words(rest).and_then(λ ws => Some(⟨e, ws⟩))),
    }
}

// Slots, one at least: the first is the word returned, the rest beside it.
fn Ty::SlotsOne(fs: List<Ty>) → Type {
    match fs { Nil => False, Cons(f, rest) => f.Slot() ∧ Ty::Slots(rest) }
}

fn Ty::check_slots_one(fs: List<Ty>) → Option<Ty::SlotsOne(fs)> {
    match fs as λ g => Option<Ty::SlotsOne(g)> { Nil => None, Cons(f, rest) => f.check_slot().and_then(λ e => Ty::check_slots(rest).and_then(λ ok => Some(⟨e, ok⟩))) }
}

theorem Ty::slots_one_all(fs: List<Ty>): Ty::SlotsOne(fs) → Ty::Slots(fs) {
    match fs { Nil => λ never => false_elim(never), Cons(_, _) => λ ok => ok }
}

theorem Ty::slots_one_cons(fs: List<Ty>): Ty::SlotsOne(fs) → fs = Nil → False {
    match fs { Nil => λ never _ => never, Cons(g, rest) => λ _ (bad: Cons(g, rest) = Nil) => absurd(bad) }
}

theorem Ty::words_one_all(fs: List<Ty>): Ty::WordsOne(fs) → Ty::Words(fs) {
    match fs { Nil => λ never => false_elim(never), Cons(_, _) => λ ok => ok }
}

// The first of such fields held from `port` is the word there.
theorem Ty::fields_head_reads(values: Valuation(), port: Nat, fs: List<Ty>): Ty::WordsOne(fs) → (t: Ty::Flats(fs)) →
    Ty::FieldsHold(fs, values, port, t) → values(64, port) = Ty::flats_head_word(fs, EnumInfo::nones, t) {
    match fs {
        Nil => λ never => false_elim(never),
        Cons(f, rest) => λ ok t held => j(sym(ok.left), λ g _ => (x: g.Flat()) → g.FlatHolds(values, port, x) → values(64, port) = g.flat_word(EnumInfo::nones, x),
            λ x h => h)(t.fst, held.left),
    }
}

fn Ty::Out(self t: Ty, tys: Table) → Type {
    match t {
        Word(w) => (w = 64) ∨ (w < 64),
        Bit => True, ByteList(_) => False, Lines => False,
        Named(i) => (tys.recs(i).fields = [Word(64)]) ∨ Ty::SlotsOne(tys.fields(i)),
        Count => False,
        Enum(i) => Ty::Bare(tys.ens(i).slots) ∨ Ty::Slots(tys.ens(i).slots),
    }
}

fn Ty::check_out(self t: Ty, tys: Table) → Option<t.Out(tys)> {
    match t as λ x => Option<x.Out(tys)> {
        Word(w) => Ty::check_narrow(w),
        Bit => Some(trivial), ByteList(_) => None, Lines => None,
        Named(i) => match Ty::check_fields_word(tys.recs(i).fields) {
            Some(e) => Some(Inl(e)),
            None => Ty::check_slots_one(tys.fields(i)).and_then(λ ws => Some(Inr(ws))),
        },
        Count => None,
        Enum(i) => match Ty::check_bare(tys.ens(i).slots) {
            Some(b) => Some(Inl(b)),
            None => Ty::check_slots(tys.ens(i).slots).and_then(λ ws => Some(Inr(ws))),
        },
    }
}

// A record's or an enum's result, after the widening: its first word and
// the words past it are its pieces' (`Ty::widen_fields`).
theorem Ty::out_pieces(tys: Table, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered): t.Out(tys) →
    (v: t.sem(tys)) → t.Holds(tys, c.region.eval(call, values, buffers := buffers), c.result, v) → t.Below(tys, c.result, c.next) →
    (t.widen(tys, c).region.eval(call, values, buffers := buffers)(64, t.widen(tys, c).result) = Ty::cast(tys, t, Word(64), v)) ∧
        (words_of(t.widen(tys, c).region.eval(call, values, buffers := buffers), t.also_ports(tys, t.widen(tys, c).result)) = Ty::rest_words(tys, t, v)) {
    match t {
        Word(w) => λ ok v h _ => ⟨Ty::edge_reads(tys, call, buffers, values, Word(w), c, ok, v, h), refl⟩,
        Bit => λ ok v h _ => ⟨Ty::edge_reads(tys, call, buffers, values, Bit, c, ok, v, h), refl⟩,
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok v h below => {
            let fs = tys.fields(i);
            let one: Ty::SlotsOne(fs) = match ok { Inl(e) => j(sym(tys.word_leaves(i, e)), λ g _ => Ty::SlotsOne(g), ⟨Inl(refl), trivial⟩), Inr(ws) => ws };
            let d = Ty::widen_fields(fs, c);
            let read = Ty::widen_fields_reads(call, buffers, values, fs, c, Ty::slots_one_all(fs, one), below, tys.get(i, v), h);
            Ty::fields_words_split(d.region.eval(call, values, buffers := buffers), fs, d.result, tys.get(i, v), Ty::slots_one_cons(fs, one), read)
        },
        Count => λ never => false_elim(never),
        Enum(i) => λ ok v h below => {
            let e = tys.ens(i);
            let fs = Cons(Word(64), e.slots);
            let slots: Ty::Slots(e.slots) = match ok { Inl(bare) => Ty::words_slots(e.slots, Ty::bare_words(e.slots, bare)), Inr(ws) => ws };
            let x = c.region.eval(call, values, buffers := buffers)(64, c.result);
            let tag: (x = RecInfo::enum_word(tys, i, v)) = trans(sym(BitVec::ofNat_toNat(64, x)), cong_fn(λ (m: Nat) => BitVec::ofNat(m, n := 64), h.left.left));
            let d = Ty::widen_fields(fs, c);
            let read = Ty::widen_fields_reads(call, buffers, values, fs, c, ⟨Inl(refl), slots⟩, below, Pair(RecInfo::enum_word(tys, i, v), e.fields(v)), ⟨tag, h.right⟩);
            words_cons_parts(d.region.eval(call, values, buffers := buffers)(64, d.result), words_of(d.region.eval(call, values, buffers := buffers), Ty::ports_from(e.slots, d.result + 1)),
                Ty::flats_words(fs, Pair(RecInfo::enum_word(tys, i, v), e.fields(v))), read)
        },
    }
}

// ---------------------------------------------------------------------------
// Functions: the wrapper from FunctionIR's `Function::eval`, which binds its
// parameters by `Valuation::bind`, to the reflected function's curried
// meaning (`Fun::meaning`). Parameters are 64-bit words, the ids 0, 1, …
// in order; the last is variable 0, so the context's ports are the ids
// reversed, and the body takes fresh ids above them.

fn Fun::ports_onto(ps: List<Ty>, m: Nat, ports: List<Nat>) → List<Nat> {
    match ps { Nil => ports, Cons(_, rest) => Fun::ports_onto(rest, m + 1, Cons(m, ports)) }
}

fn Fun::context(self f: Fun) → List<Ty> { Ty::bind_onto(f.params, Nil) }

fn Fun::word_ids(tys: Table, ps: List<Ty>, m: Nat) → List<Nat> {
    match ps { Nil => Nil, Cons(p, rest) => p.ids(tys, m) ++ Fun::word_ids(tys, rest, m + p.span(tys)) }
}

fn Fun::words_past(tys: Table, ps: List<Ty>, m: Nat) → Nat {
    match ps { Nil => m, Cons(p, rest) => Fun::words_past(tys, rest, m + p.span(tys)) }
}

// The parameters' entry: a narrow word's low bits read into a fresh port
// by one `Resize` (the x86 lowering holds a narrow value zero-extended in
// its register, and a parameter's register holds the whole word passed);
// any other parameter at its own id (an enum at its tag word's, its slots
// at the ids after it). `ports` are the context's, the last parameter's
// first.
record Entry { nodes: List<Node>, ports: List<Nat>, next: Nat }

fn Ty::narrow_by(w: Nat, o: (w = 64) ∨ True) → Bool { match o { Inl(_) => False, Inr(_) => True } }

fn Ty::narrow(self t: Ty, tys: Table) → Bool {
    match t {
        Word(w) => Ty::narrow_by(w, w.equation(64)), Bit => True, ByteList(_) => False, Lines => False,
        Named(i) => Ty::slots_narrow(tys.fields(i)), Count => False, Enum(i) => Ty::slots_narrow(tys.ens(i).slots),
    }
}

// A parameter with a narrow slot (`Ty::narrow`): every slot read into a
// fresh port from `next`, a narrow one by a `Resize` to its width (its low
// bits), a 64-bit one by a move, so that its value is held at consecutive
// ports as a record's or an enum's always is (design §16.18).
fn Ty::entry_node(self f: Ty, out, src: Nat) → Node {
    match f.slot_narrow() { True => Resize(64, f.width(), out, src), False => Move(64, out, src) }
}

fn Ty::entry_slots(fs: List<Ty>, out, src: Nat) → List<Node> {
    match fs { Nil => Nil, Cons(f, rest) => Cons(f.entry_node(out, src), Ty::entry_slots(rest, out + 1, src + 1)) }
}

fn Fun::entry_step(tys: Table, b: Bool, p: Ty, m, next: Nat, ports: List<Nat>, again: Nat → List<Nat> → Entry) → Entry {
    match b {
        True => Entry(Ty::entry_slots(p.pieces(tys), next, m) ++ again(next + p.span(tys), Cons(next, ports)).nodes, again(next + p.span(tys), Cons(next, ports)).ports,
            again(next + p.span(tys), Cons(next, ports)).next),
        False => again(next, Cons(m, ports)),
    }
}

fn Fun::entry(tys: Table, ps: List<Ty>, m, next: Nat, ports: List<Nat>) → Entry {
    match ps {
        Nil => Entry(Nil, ports, next),
        Cons(p, rest) => Fun::entry_step(tys, p.narrow(tys), p, m, next, ports, λ n2 ps2 => Fun::entry(tys, rest, m + p.span(tys), n2, ps2)),
    }
}

fn Fun::entry_of(self f: Fun, tys: Table) → Entry { Fun::entry(tys, f.params, 0, Fun::words_past(tys, f.params, 0), Nil) }

// The body's code after the entry's nodes (with none, the body's alone).
fn Fun::entered(nodes: List<Node>, c: Lowered) → Lowered {
    match nodes { Nil => c, Cons(_, _) => Lowered(Compose(nodes_region(nodes), c.region), c.result, c.next) }
}

fn Fun::code_of(self f: Fun, tys: Table, e: Entry, c: Lowered) → Function {
    Function(Fun::word_ids(tys, f.params, 0), f.result.widen(tys, Fun::entered(e.nodes, c)).region, f.result.widen(tys, Fun::entered(e.nodes, c)).result,
        lent := f.lent, also := f.result.also_ports(tys, f.result.widen(tys, Fun::entered(e.nodes, c)).result))
}

fn Fun::lower_typed(self f: Fun, w: World, c: Lowered) → Option<Function> {
    Tm::ty(f.body, w, f.context()).check(f.result).and_then(λ _ => Some(f.code_of(w.tys, f.entry_of(w.tys), c)))
}

fn Fun::lower_body(self f: Fun, w: World) → Option<Function> {
    f.body.lower(w, f.context(), f.entry_of(w.tys).ports, f.entry_of(w.tys).next).and_then(λ c => f.lower_typed(w, c))
}

fn Fun::lower_distinct(self f: Fun, w: World) → Option<Function> {
    Tm::check_true(distinct(Fun::word_ids(w.tys, f.params, 0))).and_then(λ _ => f.lower_body(w))
}

fn Fun::lower_result(self f: Fun, w: World) → Option<Function> {
    f.result.check_out(w.tys).and_then(λ _ => f.lower_distinct(w))
}

// A function of words to a word, lowered to a FunctionIR function: each
// parameter and the result a 64-bit word, a record held in one
// (`Ty::OneWord`), or a narrower word (`Ty::Edge`).
fn Fun::lower(self f: Fun, w: World) → Option<Function> {
    Ty::check_edges(w.tys, f.params).and_then(λ _ => f.lower_result(w))
}

// Words as an environment: the parameters bound onto `g` in order, each
// word cast to its parameter's code (zero past the words' end).
fn Ty::extend(tys: Table, ps: List<Ty>) → (g: List<Ty>) → Env(tys, g) → List<BitVec(64)> → Env(tys, Ty::bind_onto(ps, g)) {
    match ps {
        Nil => λ g env xs => env,
        Cons(p, rest) => λ g env xs => match xs {
            Nil => Ty::extend(tys, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, BitVec::zero()), env), Nil),
            Cons(x, more) => Ty::extend(tys, rest, Cons(p, g), Pair(Ty::cast(tys, Word(64), p, x), env), more),
        },
    }
}

// Words as an environment the plain way: each parameter reads its own
// words (`Ty::read_words`) and the next takes those after them.
fn Ty::extend_words(tys: Table, ps: List<Ty>) → (g: List<Ty>) → Env(tys, g) → List<BitVec(64)> → Env(tys, Ty::bind_onto(ps, g)) {
    match ps {
        Nil => λ g env xs => env,
        Cons(p, rest) => λ g env xs => Ty::extend_words(tys, rest, Cons(p, g), Pair(Ty::read_words(p, tys, xs), env), Ty::skip(p.span(tys), xs)),
    }
}

// A curried meaning applied to words the plain way, and its result read
// as a word: a function's source, the function a program's call of it
// answers (`Compile::uncurried`).
fn Ty::apply_words(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → List<BitVec(64)> → r.sem(tys) {
    match ps {
        Nil => λ v ws => v,
        Cons(p, rest) => λ v ws => Ty::apply_words(tys, rest, r, v(Ty::read_words(p, tys, ws)), Ty::skip(p.span(tys), ws)),
    }
}

fn Ty::uncurry_words(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → List<BitVec(64)> → BitVec(64) {
    λ v ws => Ty::cast(tys, r, Word(64), Ty::apply_words(tys, ps, r, v, ws))
}

// Every word of it, as a function returns them (`Ty::result_words`): a
// function's source, the words a program's call of it answers
// (`Compile::uncurried`).
fn Ty::uncurry_all(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → List<BitVec(64)> → List<BitVec(64)> {
    λ v ws => Ty::result_words(tys, r, Ty::apply_words(tys, ps, r, v, ws))
}

// A curried meaning answers like a word function that agrees with its
// uncurried form on every word list its parameters admit.
theorem Ty::curry_answers(tys: Table, r: Ty, ps: List<Ty>): (g: List<Ty>) → (env: Env(tys, g)) →
    (k: Env(tys, Ty::bind_onto(ps, g)) → r.sem(tys)) → (ans: List<BitVec(64)> → BitVec(64)) → Ty::PassesAll(tys, ps) →
    ((xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → ans(xs) = Ty::cast(tys, r, Word(64), k(Ty::extend_words(tys, ps, g, env, xs)))) →
    Ty::Answers(tys, ps, r, Ty::curry(tys, r, ps, g, env, k), ans) {
    match ps {
        Nil => λ g env k ans _ h => h(Nil, trivial),
        Cons(p, rest) => λ g env k ans ok h => Ty::takes_intro(tys, p,
            λ ws a => Ty::Answers(tys, rest, r, Ty::curry(tys, r, rest, Cons(p, g), Pair(a, env), k), λ more => ans(ws ++ more)), ok.left,
            λ ws a taken => Ty::curry_answers(tys, r, rest, Cons(p, g), Pair(a, env), k, λ more => ans(ws ++ more), ok.right, λ more admitted => {
                let t = taken.right(more);
                let xs = ws ++ more;
                let k_at = λ (u: p.sem(tys)) (s: List<BitVec(64)>) => Ty::cast(tys, r, Word(64), k(Ty::extend_words(tys, rest, Cons(p, g), Pair(u, env), s)));
                trans(h(xs, ⟨t.left, j(sym(t.right.left), λ s _ => Ty::AdmitsAll(tys, rest, s), admitted)⟩),
                    trans(cong_fn(λ (u: p.sem(tys)) => k_at(u, Ty::skip(p.span(tys), xs)), t.right.right),
                        cong_fn(λ (s: List<BitVec(64)>) => k_at(a, s), t.right.left)))
            })),
    }
}

// The words at `ids`, zero past the words' end.
fn Fun::BoundWords(values: Valuation(), ids: List<Nat>) → List<BitVec(64)> → Type {
    match ids {
        Nil => λ _ => True,
        Cons(id, rest) => λ xs => match xs {
            Nil => (values(64, id) = BitVec::zero()) ∧ Fun::BoundWords(values, rest, Nil),
            Cons(x, more) => (values(64, id) = x) ∧ Fun::BoundWords(values, rest, more),
        },
    }
}

theorem Fun::bound_frame(values, after: Valuation(), ids: List<Nat>): (xs: List<BitVec(64)>) →
    ((id: Nat) → Mem(id, ids) → after(64, id) = values(64, id)) → Fun::BoundWords(values, ids, xs) → Fun::BoundWords(after, ids, xs) {
    match ids {
        Nil => λ xs same bound => bound,
        Cons(id, rest) => λ xs same => match xs as λ ys => Fun::BoundWords(values, Cons(id, rest), ys) → Fun::BoundWords(after, Cons(id, rest), ys) {
            Nil => λ bound => ⟨trans(same(id, Inl(refl)), bound.left), Fun::bound_frame(values, after, rest, Nil, λ y m => same(y, Inr(m)), bound.right)⟩,
            Cons(_, more) => λ bound => ⟨trans(same(id, Inl(refl)), bound.left), Fun::bound_frame(values, after, rest, more, λ y m => same(y, Inr(m)), bound.right)⟩,
        },
    }
}

theorem Fun::bound_zero(ids: List<Nat>): Fun::BoundWords(Valuation::zero(), ids, Nil) {
    match ids { Nil => trivial, Cons(_, rest) => ⟨refl, Fun::bound_zero(rest)⟩ }
}

// Distinct ids bound to words hold them.
theorem Fun::bind_bound(ids: List<Nat>): (xs: List<BitVec(64)>) → distinct(ids).IsTrue() →
    Fun::BoundWords(Valuation::bind(Valuation::zero(), ids, xs), ids, xs) {
    match ids {
        Nil => λ xs _ => trivial,
        Cons(id, rest) => λ xs apart => match xs as λ ys => Fun::BoundWords(Valuation::bind(Valuation::zero(), Cons(id, rest), ys), Cons(id, rest), ys) {
            Nil => Fun::bound_zero(Cons(id, rest)),
            Cons(x, more) => {
                let parts = Bool::is_true_and(absent(id, rest), distinct(rest), apart);
                let inner = Valuation::bind(Valuation::zero(), rest, more);
                ⟨Valuation::set_here(inner, id, word_value(x), 64),
                    Fun::bound_frame(inner, Valuation::set(inner, id, word_value(x)), rest, more,
                        λ y m => Valuation::set_other(inner, id, word_value(x), 64, y, λ e => absent_mem(id, rest, parts.left, y, m, sym(e))),
                        Fun::bind_bound(rest, more, parts.right))⟩
            },
        },
    }
}

// Words bound at two runs of ids, one after the other: the first run's
// count of them at the first, the rest at the second.
theorem Fun::bound_split(values: Valuation(), ids: List<Nat>, later: List<Nat>): (xs: List<BitVec(64)>) →
    Fun::BoundWords(values, ids ++ later, xs) →
    Fun::BoundWords(values, ids, Ty::first(ids.len(), xs)) ∧ Fun::BoundWords(values, later, Ty::skip(ids.len(), xs)) {
    match ids {
        Nil => λ xs bound => ⟨trivial, bound⟩,
        Cons(id, rest) => λ xs => match xs as λ ys => Fun::BoundWords(values, Cons(id, rest) ++ later, ys) →
            Fun::BoundWords(values, Cons(id, rest), Ty::first(Succ(rest.len()), ys)) ∧ Fun::BoundWords(values, later, Ty::skip(Succ(rest.len()), ys)) {
            Nil => λ bound => {
                let inner = Fun::bound_split(values, rest, later, Nil, bound.right);
                ⟨⟨bound.left, inner.left⟩, inner.right⟩
            },
            Cons(_, more) => λ bound => {
                let inner = Fun::bound_split(values, rest, later, more, bound.right);
                ⟨⟨bound.left, inner.left⟩, inner.right⟩
            },
        },
    }
}

theorem Ty::ids_len(tys: Table, p: Ty, m: Nat): p.ids(tys, m).len() = p.span(tys) {
    match p {
        Word(_) => refl, Bit => refl, ByteList(_) => refl, Lines => refl, Named(i) => Ty::ports_from_len(tys.fields(i), m), Count => refl,
        Enum(i) => cong_fn(λ (n: Nat) => Succ(n), Ty::ports_from_len(tys.ens(i).slots, m + 1)),
    }
}

// 64-bit words bound at a payload's ports hold its fields.
theorem Ty::ports_hold(values: Valuation(), fs: List<Ty>): (port: Nat) → Ty::Words(fs) → (t: Ty::Flats(fs)) →
    Fun::BoundWords(values, Ty::ports_from(fs, port), Ty::flats_words(fs, t)) → Ty::FieldsHold(fs, values, port, t) {
    match fs {
        Nil => λ port _ t _ => trivial,
        Cons(f, rest) => λ port ok t bound => ⟨j(sym(ok.left), λ g _ => (x: g.Flat()) → values(64, port) = g.flat_word(EnumInfo::nones, x) → g.FlatHolds(values, port, x),
                λ x h => h)(t.fst, bound.left),
            Ty::ports_hold(values, rest, port + 1, ok.right, t.snd, bound.right)⟩,
    }
}

// Fields at ports from `port` on, as many as there are, are below where
// they end.
theorem Ty::fields_below_len(fs: List<Ty>): (port, next: Nat) → port + fs.len() <= next → Ty::FieldsBelow(fs, port, next) {
    match fs {
        Nil => λ port next _ => trivial,
        Cons(_, rest) => λ port next h => ⟨Nat::le_trans(port + 1, port + rest.len() + 1, next, Nat::le_succ_succ(port, port + rest.len(), Nat::le_add_l(port, rest.len())), h),
            Ty::fields_below_len(rest, port + 1, next, j(sym(Nat::add_succ_left(port, rest.len())), λ y _ => y <= next, h))⟩,
    }
}

theorem Ty::ports_from_below(fs: List<Ty>): (port, id: Nat) → Mem(id, Ty::ports_from(fs, port)) → id < port + fs.len() {
    match fs {
        Nil => λ port id never => false_elim(never),
        Cons(_, rest) => λ port id mem => match mem {
            Inl(e) => j(sym(e), λ y _ => y < port + Succ(rest.len()), Nat::le_succ_succ(port, port + rest.len(), Nat::le_add_l(port, rest.len()))),
            Inr(later) => j(Nat::add_succ_left(port, rest.len()), λ y _ => id < y, Ty::ports_from_below(rest, port + 1, id, later)),
        },
    }
}

// A parameter's ids are below its span's end.
theorem Ty::ids_below(tys: Table, p: Ty, m, id: Nat): Mem(id, p.ids(tys, m)) → id < m + p.span(tys) {
    let one = λ (mem: Mem(id, [m])) => match mem {
        Inl(e) => j(sym(e), λ y _ => y < m + 1, m.lt_succ_self()),
        Inr(never) => false_elim(never),
    };
    match p as λ q => Mem(id, q.ids(tys, m)) → id < m + q.span(tys) {
        Word(_) => one, Bit => one, ByteList(_) => one, Lines => one, Named(i) => Ty::ports_from_below(tys.fields(i), m, id), Count => one,
        Enum(i) => λ mem => match mem {
            Inl(e) => j(sym(e), λ y _ => y < m + (tys.ens(i).slots.len() + 1),
                Nat::le_succ_succ(m, m + tys.ens(i).slots.len(), Nat::le_add_l(m, tys.ens(i).slots.len()))),
            Inr(later) => j(Nat::add_succ_left(m, tys.ens(i).slots.len()), λ y _ => id < y, Ty::ports_from_below(tys.ens(i).slots, m + 1, id, later)),
        },
    }
}

theorem Fun::words_past_ge(tys: Table, ps: List<Ty>): (m: Nat) → m <= Fun::words_past(tys, ps, m) {
    match ps {
        Nil => λ m => m.le_refl(),
        Cons(p, rest) => λ m => Nat::le_trans(m, m + p.span(tys), Fun::words_past(tys, rest, m + p.span(tys)), Nat::le_add_l(m, p.span(tys)),
            Fun::words_past_ge(tys, rest, m + p.span(tys))),
    }
}

// A parameter's word id is below the ids' end.
theorem Fun::word_ids_below(tys: Table, ps: List<Ty>): (m, id: Nat) → Mem(id, Fun::word_ids(tys, ps, m)) → id < Fun::words_past(tys, ps, m) {
    match ps {
        Nil => λ m id never => false_elim(never),
        Cons(p, rest) => λ m id mem => match List::mem_append(p.ids(tys, m), Fun::word_ids(tys, rest, m + p.span(tys)), id, mem) {
            Inl(here) => Nat::lt_of_lt_of_le(id, m + p.span(tys), Fun::words_past(tys, rest, m + p.span(tys)), Ty::ids_below(tys, p, m, id, here),
                Fun::words_past_ge(tys, rest, m + p.span(tys))),
            Inr(later) => Fun::word_ids_below(tys, rest, m + p.span(tys), id, later),
        },
    }
}

// The parameters' ports hold the environment the words make.
theorem Fun::env_extend_holds(tys: Table, values: Valuation(), ps: List<Ty>): (g: List<Ty>) → (ports: List<Nat>) →
    (env: Env(tys, g)) → (m: Nat) → (xs: List<BitVec(64)>) → Ty::OneWords(tys, ps) → EnvHolds(tys, values, g, ports, env) →
    Fun::BoundWords(values, Fun::param_ids(ps, m), xs) →
    EnvHolds(tys, values, Ty::bind_onto(ps, g), Fun::ports_onto(ps, m, ports), Ty::extend(tys, ps, g, env, xs)) {
    match ps {
        Nil => λ g ports env m xs ok held bound => held,
        Cons(p, rest) => λ g ports env m xs ok held => match xs as λ ys =>
            Fun::BoundWords(values, Fun::param_ids(Cons(p, rest), m), ys) →
            EnvHolds(tys, values, Ty::bind_onto(Cons(p, rest), g), Fun::ports_onto(Cons(p, rest), m, ports), Ty::extend(tys, Cons(p, rest), g, env, ys)) {
            Nil => λ bound => Fun::env_extend_holds(tys, values, rest, Cons(p, g), Cons(m, ports),
                Pair(Ty::cast(tys, Word(64), p, BitVec::zero()), env), m + 1, Nil, ok.right,
                ⟨Ty::one_word_holds(tys, values, m, p, ok.left, BitVec::zero(), bound.left), held⟩, bound.right),
            Cons(x, more) => λ bound => Fun::env_extend_holds(tys, values, rest, Cons(p, g), Cons(m, ports),
                Pair(Ty::cast(tys, Word(64), p, x), env), m + 1, more, ok.right,
                ⟨Ty::one_word_holds(tys, values, m, p, ok.left, x, bound.left), held⟩, bound.right),
        },
    }
}

theorem Fun::below_onto(tys: Table, ps: List<Ty>): (g: List<Ty>) → (m: Nat) → (ports: List<Nat>) → Ty::OneWords(tys, ps) →
    Below(tys, g, ports, m) → Below(tys, Ty::bind_onto(ps, g), Fun::ports_onto(ps, m, ports), Fun::past(ps, m)) {
    match ps {
        Nil => λ g m ports _ below => below,
        Cons(p, rest) => λ g m ports ok below => Fun::below_onto(tys, rest, Cons(p, g), m + 1, Cons(m, ports), ok.right,
            ⟨Ty::one_word_below(tys, p, ok.left, m),
                below_mono(tys, g, m, m + 1, Nat::le_succ_r(m, m, m.le_refl()), ports, below)⟩),
    }
}

// What binding a parameter's words at its own ids leaves: the code's
// value, read off the words, held at its port, and its ports below the
// span's end.
fn Ty::FromWords(self p: Ty, tys: Table) → Type {
    ((values: Valuation()) → (m: Nat) → (xs: List<BitVec(64)>) → p.AdmitsAt(tys, xs) →
        Fun::BoundWords(values, p.ids(tys, m), Ty::first(p.span(tys), xs)) → p.Holds(tys, values, m, Ty::read_words(p, tys, xs))) ∧
        ((m: Nat) → p.Below(tys, m, m + p.span(tys)))
}

// A record of 64-bit words bound at its ids, a word a field: its fields
// are the words, and it is the record they build.
theorem Ty::record_from_words(tys: Table, i: Nat, ok: Ty::Words(tys.fields(i)), none: Ty::NoEnums(tys.recs(i).fields)): Named(i).FromWords(tys) {
    let fs = tys.fields(i);
    ⟨λ values m xs _ bound => {
        let fl = Ty::flats_of_words(fs, xs);
        let at = j(sym(Ty::flats_words_of(fs, ok, xs)), λ ws _ => Fun::BoundWords(values, Ty::ports_from(fs, m), ws), bound);
        let held: Ty::FieldsHold(fs, values, m, fl) = Ty::ports_hold(values, fs, m, ok, fl, at);
        j(sym(tys.round(i, none, fl)), λ t _ => Ty::FieldsHold(fs, values, m, t), held)
    }, λ m => Ty::fields_below_len(fs, m, m + fs.len(), (m + fs.len()).le_refl())⟩
}

theorem Ty::one_word_from(tys: Table, p: Ty): p.OneWord(tys) → p.FromWords(tys) {
    match p {
        Word(w) => λ e => ⟨λ values m xs _ bound => Ty::one_word_holds(tys, values, m, Word(w), e, xs.head_or(BitVec::zero()), bound.left),
            λ m => m.lt_succ_self()⟩,
        Bit => λ never => false_elim(never),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ e => Ty::record_from_words(tys, i, j(sym(tys.word_leaves(i, e)), λ g _ => Ty::Words(g), ⟨refl, trivial⟩),
            j(sym(e), λ g _ => Ty::NoEnums(g), ⟨trivial, trivial⟩)),
        Count => λ never => false_elim(never),
        Enum(_) => λ never => false_elim(never),
    }
}

// An enum's words bound at its ids: the tag word names the constructor
// they read as (its tags fit a word), and the slots are its fields.
theorem Ty::enum_from_words(tys: Table, i: Nat, ok: ((tys.ens(i).last + 1).leb(Nat::pow(2, 64)) = True) ∧ Ty::Words(tys.ens(i).slots)): Enum(i).FromWords(tys) {
    let e = tys.ens(i);
    ⟨λ values m xs adm bound => {
        let a = Ty::read_words(Enum(i), tys, xs);
        let at = j(adm, λ ws _ => Fun::BoundWords(values, Cons(m, Ty::ports_from(e.slots, m + 1)), ws), bound);
        let lt: (e.tag(a) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(a) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(a), e.last, e.bounded(a)),
            Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), ok.left));
        let tag: (values(64, m).toNat() = e.tag(a)) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), at.left), BitVec::toNat_ofNat(64, e.tag(a), lt));
        ⟨⟨tag, j(sym(tag), λ y _ => y <= e.last, e.bounded(a))⟩, Ty::ports_hold(values, e.slots, m + 1, ok.right, e.fields(a), at.right)⟩
    }, λ m => Ty::fields_below_len(Cons(Word(64), e.slots), m, m + (e.slots.len() + 1), (m + (e.slots.len() + 1)).le_refl())⟩
}

// The ports of fields below a bound are below it.
theorem Ty::ports_from_below_of(fs: List<Ty>): (port, next: Nat) → Ty::FieldsBelow(fs, port, next) → (id: Nat) → Mem(id, Ty::ports_from(fs, port)) → id < next {
    match fs {
        Nil => λ port next _ id never => false_elim(never),
        Cons(_, rest) => λ port next below id mem => match mem {
            Inl(e) => j(sym(e), λ y _ => y < next, below.left),
            Inr(later) => Ty::ports_from_below_of(rest, port + 1, next, below.right, id, later),
        },
    }
}

theorem Ty::entry_node_output(f: Ty, out, src: Nat): node_output(f.entry_node(out, src)).id = out {
    (match f.slot_narrow() as λ b => node_output(match b { True => Resize(64, f.width(), out, src), False => Move(64, out, src) }).id = out {
        True => refl, False => refl,
    })
}

// A slot read from its word holds the word read at the slot.
theorem Ty::entry_node_holds(f: Ty, ok: f.Slot(), values: Valuation(), buffers: Buffers(), out, src: Nat, x: BitVec(64), hx: values(64, src) = x):
    f.FlatHolds(f.entry_node(out, src).step(values, buffers := buffers), out, f.word_at(x, EnumInfo::nones)) {
    (match f.slot_narrow() as λ b => f.slot_narrow() = b →
            f.FlatHolds((match b { True => Resize(64, f.width(), out, src), False => Move(64, out, src) }).step(values, buffers := buffers), out, f.word_at(x, EnumInfo::nones)) {
        True => λ _ => Ty::slot_narrowed(f, ok, Valuation::set(values, out, λ wd => BitVec::ofNat(values(64, src).toNat())), out, x,
            trans(Valuation::set_here(values, out, λ wd => BitVec::ofNat(values(64, src).toNat()), f.width()),
                cong_fn(λ (y: BitVec(64)) => BitVec::ofNat(y.toNat(), n := f.width()), hx))),
        False => λ e => j(sym(Ty::slot_wide(f, ok, e)), λ g _ => (moved: Valuation()) → moved(64, out) = x → g.FlatHolds(moved, out, g.word_at(x, EnumInfo::nones)), λ moved h => h)(
            Valuation::set(values, out, λ wd => values(wd, src)), trans(Valuation::set_here(values, out, λ wd => values(wd, src), 64), hx)),
    })(refl)
}

theorem Ty::entry_slots_keeps(buffers: Buffers(), fs: List<Ty>): (out, src: Nat) → (values: Valuation()) →
    Keeps(values, eval_nodes_over(buffers, Ty::entry_slots(fs, out, src), values), out) {
    match fs {
        Nil => λ out src values wd id lt => refl,
        Cons(f, rest) => λ out src values wd id lt => {
            let node = f.entry_node(out, src);
            let set = node.step(values, buffers := buffers);
            trans(Ty::entry_slots_keeps(buffers, rest, out + 1, src + 1, set, wd, id, Nat::lt_trans(id, out, out + 1, lt, out.lt_succ_self())),
                j(sym(Ty::entry_node_output(f, out, src)), λ o _ => Valuation::set(values, o, node.value(values, buffers := buffers))(wd, id) = values(wd, id),
                    Valuation::set_other(values, out, node.value(values, buffers := buffers), wd, id, Nat::ne_of_lt(id, out, lt))))
        },
    }
}

// Slots read from their words, bound at the parameter's ids, hold at the
// fresh ports what the words read as.
theorem Ty::entry_slots_sound(buffers: Buffers(), fs: List<Ty>): (out, src: Nat) → Ty::Slots(fs) → Ty::FieldsBelow(fs, src, out) → (values: Valuation()) →
    (xs: List<BitVec(64)>) → Fun::BoundWords(values, Ty::ports_from(fs, src), Ty::first(fs.len(), xs)) →
    Ty::FieldsHold(fs, eval_nodes_over(buffers, Ty::entry_slots(fs, out, src), values), out, Ty::flats_of_words(fs, xs)) {
    match fs {
        Nil => λ out src _ _ values xs _ => trivial,
        Cons(f, rest) => λ out src ok below values xs bound => {
            let node = f.entry_node(out, src);
            let set = node.step(values, buffers := buffers);
            let same_set = λ (id: Nat) (lt: id < out) => j(sym(Ty::entry_node_output(f, out, src)), λ o _ =>
                Valuation::set(values, o, node.value(values, buffers := buffers))(64, id) = values(64, id),
                Valuation::set_other(values, out, node.value(values, buffers := buffers), 64, id, Nat::ne_of_lt(id, out, lt)));
            let bound_rest = Fun::bound_frame(values, set, Ty::ports_from(rest, src + 1), Ty::first(rest.len(), xs.tail()),
                λ id mem => same_set(id, Ty::ports_from_below_of(rest, src + 1, out, below.right, id, mem)), bound.right);
            let step: (out <= out + 1) = Nat::le_succ_r(out, out, out.le_refl());
            let ih = Ty::entry_slots_sound(buffers, rest, out + 1, src + 1, ok.right, Ty::fields_below_mono(rest, out, out + 1, step, src + 1, below.right),
                set, xs.tail(), bound_rest);
            let fin = eval_nodes_over(buffers, Ty::entry_slots(rest, out + 1, src + 1), set);
            let head = f.flat_at(set, fin, out, out, λ wd => Ty::entry_slots_keeps(buffers, rest, out + 1, src + 1, set, wd, out, out.lt_succ_self()),
                f.word_at(xs.head_or(BitVec::zero()), EnumInfo::nones), Ty::entry_node_holds(f, ok.left, values, buffers, out, src, xs.head_or(BitVec::zero()), bound.left));
            ⟨head, ih⟩
        },
    }
}

// What the entry needs of a code it reads slot by slot into fresh ports
// (`Ty::narrow`, `Ty::entry_slots`): from its words bound at its ids,
// below the fresh ports, the value they read as is held at the first
// fresh port, and its ports are below its span's end. A narrow word, a
// bit, and a record or an enum with a narrow slot are such codes.
fn Ty::Narrowed(self p: Ty, tys: Table) → Type {
    ((buffers: Buffers()) → (values: Valuation()) → (m, next: Nat) → (xs: List<BitVec(64)>) → p.AdmitsAt(tys, xs) →
        Fun::BoundWords(values, p.ids(tys, m), Ty::first(p.span(tys), xs)) → m + p.span(tys) <= next →
        p.Holds(tys, eval_nodes_over(buffers, Ty::entry_slots(p.pieces(tys), next, m), values), next, Ty::read_words(p, tys, xs))) ∧
    ((n: Nat) → p.Below(tys, n, n + p.span(tys)))
}

theorem Ty::word_narrowed(tys: Table, w: Nat, lt: w < 64): Word(w).Narrowed(tys) {
    let ne = Nat::ne_of_lt(w, 64, lt);
    ⟨λ buffers values m next xs _ bound le => {
        let held = Ty::entry_slots_sound(buffers, [Word(w)], next, m, ⟨Inr(lt), trivial⟩, ⟨Nat::lt_of_lt_of_le(m, m + 1, next, m.lt_succ_self(), le), trivial⟩,
            values, xs, bound);
        let x = xs.head_or(BitVec::zero());
        trans(held.left, sym(trans(Ty::cast_narrow_in(tys, w, ne, x), sym(Ty::narrow_word_at(w, ne, x)))))
    }, λ n => n.lt_succ_self()⟩
}

theorem Ty::bit_narrowed(tys: Table): Bit.Narrowed(tys) {
    ⟨λ buffers values m next xs _ bound le =>
        Ty::entry_slots_sound(buffers, [Bit], next, m, ⟨trivial, trivial⟩, ⟨Nat::lt_of_lt_of_le(m, m + 1, next, m.lt_succ_self(), le), trivial⟩, values, xs, bound).left,
        λ n => n.lt_succ_self()⟩
}

theorem Ty::record_narrowed(tys: Table, i: Nat, ok: Ty::Slots(tys.fields(i)), none: Ty::NoEnums(tys.recs(i).fields)): Named(i).Narrowed(tys) {
    let fs = tys.fields(i);
    ⟨λ buffers values m next xs _ bound le => {
        let fl = Ty::flats_of_words(fs, xs);
        let held = Ty::entry_slots_sound(buffers, fs, next, m, ok, Ty::fields_below_len(fs, m, next, le), values, xs, bound);
        j(sym(tys.round(i, none, fl)), λ t _ => Ty::FieldsHold(fs, eval_nodes_over(buffers, Ty::entry_slots(fs, next, m), values), next, t), held)
    }, λ n => Ty::fields_below_len(fs, n, n + fs.len(), (n + fs.len()).le_refl())⟩
}

theorem Ty::enum_narrowed(tys: Table, i: Nat, ok: Enum(i).Passes(tys)): Enum(i).Narrowed(tys) {
    let e = tys.ens(i);
    let fs = Cons(Word(64), e.slots);
    ⟨λ buffers values m next xs adm bound le => {
        let a = Ty::read_words(Enum(i), tys, xs);
        let ws = RecInfo::enum_words(tys, i, a);
        let len: (fs.len() = ws.len()) = sym(RecInfo::enum_words_len(tys, i, a));
        let at: Fun::BoundWords(values, Ty::ports_from(fs, m), Ty::first(fs.len(), ws)) =
            j(sym(j(sym(len), λ n _ => Ty::first(n, ws) = ws, Ty::first_all(ws))), λ l _ => Fun::BoundWords(values, Ty::ports_from(fs, m), l),
                j(adm, λ l _ => Fun::BoundWords(values, Ty::ports_from(fs, m), l), bound));
        let held = Ty::entry_slots_sound(buffers, fs, next, m, ⟨Inl(refl), ok.right⟩, Ty::fields_below_len(fs, m, next, le), values, ws, at);
        let after = eval_nodes_over(buffers, Ty::entry_slots(fs, next, m), values);
        let lt: (e.tag(a) < Nat::pow(2, 64)) = Nat::le_trans(e.tag(a) + 1, e.last + 1, Nat::pow(2, 64), Nat::le_succ_succ(e.tag(a), e.last, e.bounded(a)),
            Nat::le_of_leb(e.last + 1, Nat::pow(2, 64), ok.left));
        let tag: (after(64, next).toNat() = e.tag(a)) = trans(cong_fn(λ (y: BitVec(64)) => y.toNat(), held.left), BitVec::toNat_ofNat(64, e.tag(a), lt));
        let slots: (Ty::flats_of_words(e.slots, RecInfo::enum_rest(tys, i, a)) = e.fields(a)) =
            trans(cong_fn(λ (l: List<BitVec(64)>) => Ty::flats_of_words(e.slots, l), sym(RecInfo::enum_rest(tys, i, a).append_nil())),
                Ty::slots_round(e.slots, ok.right, e.fields(a), Nil));
        ⟨⟨tag, j(sym(tag), λ y _ => y <= e.last, e.bounded(a))⟩,
            j(slots, λ t _ => Ty::FieldsHold(e.slots, after, next + 1, t), held.right)⟩
    }, λ n => Ty::fields_below_len(fs, n, n + (e.slots.len() + 1), (n + (e.slots.len() + 1)).le_refl())⟩
}

// What `narrow` decides at a code a plain function takes: one whose value
// binding its words leaves (`Ty::FromWords`), or a narrow word.
theorem Ty::narrow_cases(tys: Table, P: Bool → Type, p: Ty): p.Param(tys) → (p.FromWords(tys) → P(False)) →
    (p.Narrowed(tys) → P(True)) → P(p.narrow(tys)) {
    match p {
        Word(w) => λ ok own narrow => match ok {
            Inl(e) => j(sym(e), λ y _ => P(Ty::narrow_by(y, y.equation(64))), own(Ty::one_word_from(tys, Word(w), e))),
            Inr(lt) => j(sym(Or::inr_apart(w.equation(64), Nat::ne_of_lt(w, 64, lt))), λ o _ => P(Ty::narrow_by(w, o)),
                narrow(Ty::word_narrowed(tys, w, lt))),
        },
        Bit => λ _ own narrow => narrow(Ty::bit_narrowed(tys)),
        ByteList(_) => λ never => false_elim(never),
        Lines => λ never => false_elim(never),
        Named(i) => λ ok own narrow => (match Ty::slots_narrow(tys.fields(i)) as λ b => Ty::slots_narrow(tys.fields(i)) = b → P(b) {
            False => λ e => own(Ty::record_from_words(tys, i, Ty::slots_wide(tys.fields(i), ok.left, e), ok.right)),
            True => λ _ => narrow(Ty::record_narrowed(tys, i, ok.left, ok.right)),
        })(refl),
        Count => λ never => false_elim(never),
        Enum(i) => λ ok own narrow => (match Ty::slots_narrow(tys.ens(i).slots) as λ b => Ty::slots_narrow(tys.ens(i).slots) = b → P(b) {
            False => λ e => own(Ty::enum_from_words(tys, i, ⟨ok.left, Ty::slots_wide(tys.ens(i).slots, ok.right, e)⟩)),
            True => λ _ => narrow(Ty::enum_narrowed(tys, i, ok)),
        })(refl),
    }
}

// What the entry leaves: the parameters' ports hold the environment the
// words make, each below the entry's `next`.
fn Fun::EntryHolds(tys: Table, buffers: Buffers(), ps: List<Ty>, g: List<Ty>, env: Env(tys, g), e: Entry, xs: List<BitVec(64)>,
    values: Valuation()) → Type {
    EnvHolds(tys, eval_nodes_over(buffers, e.nodes, values), Ty::bind_onto(ps, g), e.ports, Ty::extend_words(tys, ps, g, env, xs)) ∧
        Below(tys, Ty::bind_onto(ps, g), e.ports, e.next)
}

// One parameter's step of the entry, from the rest's (`ih`).
theorem Fun::entry_step_holds(tys: Table, buffers: Buffers(), p: Ty, rest: List<Ty>, g: List<Ty>, ports: List<Nat>, env: Env(tys, g),
    m, next: Nat, xs: List<BitVec(64)>, values: Valuation(), ok: p.Param(tys), admitted: p.AdmitsAt(tys, xs), held: EnvHolds(tys, values, g, ports, env),
    below: Below(tys, g, ports, next), bound: Fun::BoundWords(values, p.ids(tys, m), Ty::first(p.span(tys), xs)),
    bound_rest: Fun::BoundWords(values, Fun::word_ids(tys, rest, m + p.span(tys)), Ty::skip(p.span(tys), xs)),
    past: Fun::words_past(tys, rest, m + p.span(tys)) <= next,
    ih: (g2: List<Ty>) → (ports2: List<Nat>) → (env2: Env(tys, g2)) → (next2: Nat) → (values2: Valuation()) → EnvHolds(tys, values2, g2, ports2, env2) →
        Below(tys, g2, ports2, next2) → Fun::BoundWords(values2, Fun::word_ids(tys, rest, m + p.span(tys)), Ty::skip(p.span(tys), xs)) →
        Fun::words_past(tys, rest, m + p.span(tys)) <= next2 →
        Fun::EntryHolds(tys, buffers, rest, g2, env2, Fun::entry(tys, rest, m + p.span(tys), next2, ports2), Ty::skip(p.span(tys), xs), values2)):
    Fun::EntryHolds(tys, buffers, rest, Cons(p, g), Pair(Ty::read_words(p, tys, xs), env),
        Fun::entry_step(tys, p.narrow(tys), p, m, next, ports, λ n2 ps2 => Fun::entry(tys, rest, m + p.span(tys), n2, ps2)), Ty::skip(p.span(tys), xs), values) {
    let again = λ (n2: Nat) (ps2: List<Nat>) => Fun::entry(tys, rest, m + p.span(tys), n2, ps2);
    let env2 = Pair(Ty::read_words(p, tys, xs), env);
    let more = Ty::skip(p.span(tys), xs);
    let end = Fun::words_past(tys, rest, m + p.span(tys));
    Ty::narrow_cases(tys, λ b => Fun::EntryHolds(tys, buffers, rest, Cons(p, g), env2, Fun::entry_step(tys, b, p, m, next, ports, again), more, values), p, ok,
        λ from => ih(Cons(p, g), Cons(m, ports), env2, next, values,
            ⟨from.left(values, m, xs, admitted, bound), held⟩,
            ⟨p.below_mono(tys, m, m + p.span(tys), next, Nat::le_trans(m + p.span(tys), end, next, Fun::words_past_ge(tys, rest, m + p.span(tys)), past),
                from.right(m)), below⟩,
            bound_rest, past),
        λ nh => {
            let nodes = Ty::entry_slots(p.pieces(tys), next, m);
            let after = eval_nodes_over(buffers, nodes, values);
            let n2 = next + p.span(tys);
            let keeps: Keeps(values, after, next) = Ty::entry_slots_keeps(buffers, p.pieces(tys), next, m, values);
            let le: (m + p.span(tys) <= next) = Nat::le_trans(m + p.span(tys), end, next, Fun::words_past_ge(tys, rest, m + p.span(tys)), past);
            let grow: (next <= n2) = Nat::le_add_l(next, p.span(tys));
            let later = again(n2, Cons(next, ports));
            let inner = ih(Cons(p, g), Cons(next, ports), env2, n2, after,
                ⟨nh.left(buffers, values, m, next, xs, admitted, bound, le), env_holds_keeps(tys, g, values, after, next, keeps, ports, env, below, held)⟩,
                ⟨nh.right(next), below_mono(tys, g, next, n2, grow, ports, below)⟩,
                Fun::bound_frame(values, after, Fun::word_ids(tys, rest, m + p.span(tys)), more, λ id mem =>
                    keeps(64, id, Nat::lt_of_lt_of_le(id, end, next, Fun::word_ids_below(tys, rest, m + p.span(tys), id, mem), past)),
                    bound_rest),
                Nat::le_trans(end, next, n2, past, grow));
            j(sym(Tm::nodes_append(buffers, nodes, later.nodes, values)), λ u _ =>
                EnvHolds(tys, u, Ty::bind_onto(rest, Cons(p, g)), later.ports, Ty::extend_words(tys, rest, Cons(p, g), env2, more)) ∧
                    Below(tys, Ty::bind_onto(rest, Cons(p, g)), later.ports, later.next), inner)
        })
}

theorem Fun::entry_holds(tys: Table, buffers: Buffers(), ps: List<Ty>): (g: List<Ty>) → (ports: List<Nat>) → (env: Env(tys, g)) →
    (m, next: Nat) → (xs: List<BitVec(64)>) → (values: Valuation()) → Ty::Edges(tys, ps) → Ty::AdmitsAll(tys, ps, xs) → EnvHolds(tys, values, g, ports, env) →
    Below(tys, g, ports, next) → Fun::BoundWords(values, Fun::word_ids(tys, ps, m), xs) → Fun::words_past(tys, ps, m) <= next →
    Fun::EntryHolds(tys, buffers, ps, g, env, Fun::entry(tys, ps, m, next, ports), xs, values) {
    match ps {
        Nil => λ g ports env m next xs values ok admitted held below bound past => ⟨held, below⟩,
        Cons(p, rest) => λ g ports env m next xs values ok admitted held below bound past => {
            let later = Fun::word_ids(tys, rest, m + p.span(tys));
            let halves = Fun::bound_split(values, p.ids(tys, m), later, xs, bound);
            let len = Ty::ids_len(tys, p, m);
            Fun::entry_step_holds(tys, buffers, p, rest, g, ports, env, m, next, xs, values, ok.left, admitted.left, held, below,
                j(len, λ n _ => Fun::BoundWords(values, p.ids(tys, m), Ty::first(n, xs)), halves.left),
                j(len, λ n _ => Fun::BoundWords(values, later, Ty::skip(n, xs)), halves.right), past,
                λ g2 ports2 env2 next2 values2 => Fun::entry_holds(tys, buffers, rest, g2, ports2, env2, m + p.span(tys), next2, Ty::skip(p.span(tys), xs), values2,
                    ok.right, admitted.right))
        },
    }
}

// A plain function's parameters pass as they are (`Ty::Passes`).
theorem Ty::param_passes(tys: Table, p: Ty): p.Param(tys) → p.Passes(tys) {
    match p {
        Word(_) => λ _ => trivial, Bit => λ _ => trivial, ByteList(_) => λ _ => trivial, Lines => λ _ => trivial,
        Named(_) => λ _ => trivial, Count => λ _ => trivial, Enum(_) => λ ok => ok,
    }
}

theorem Ty::edges_pass(tys: Table, ps: List<Ty>): Ty::Edges(tys, ps) → Ty::PassesAll(tys, ps) {
    match ps { Nil => λ _ => trivial, Cons(p, rest) => λ ok => ⟨Ty::param_passes(tys, p, ok.left), Ty::edges_pass(tys, rest, ok.right)⟩ }
}

// The body's code after the entry's nodes runs the body over what they
// leave.
theorem Fun::entered_holds(tys: Table, call: function_ir_eval::Answers(), buffers: Buffers(), values: Valuation(), t: Ty, c: Lowered,
    v: t.sem(tys)): (nodes: List<Node>) → t.Holds(tys, c.region.eval(call, eval_nodes_over(buffers, nodes, values), buffers := buffers), c.result, v) →
    t.Holds(tys, Fun::entered(nodes, c).region.eval(call, values, buffers := buffers), Fun::entered(nodes, c).result, v) {
    λ nodes => match nodes { Nil => λ h => h, Cons(_, _) => λ h => h }
}

// A function on words answers its words past the first like a curried
// meaning: on every word list, the meaning's words past its first
// (`Ty::rest_words`: none but for a record of two words).
fn Ty::AnswersAlso(tys: Table, ps: List<Ty>, r: Ty) → Ty::Arrows(tys, ps, r) → (List<BitVec(64)> → List<BitVec(64)>) → Type {
    match ps {
        Nil => λ v ans => ans(Nil) = Ty::rest_words(tys, r, v),
        Cons(p, rest) => λ v ans => p.Takes(tys, λ ws a => Ty::AnswersAlso(tys, rest, r, v(a), λ more => ans(ws ++ more))),
    }
}

// The words past the first of every word answered.
theorem Ty::answers_words_also(tys: Table, ps: List<Ty>, r: Ty): (v: Ty::Arrows(tys, ps, r)) → (ans: List<BitVec(64)> → List<BitVec(64)>) →
    Ty::AnswersWords(tys, ps, r, v, ans) → Ty::AnswersAlso(tys, ps, r, v, λ ws => ans(ws).tail()) {
    match ps {
        Nil => λ v ans h => cong_fn(λ (xs: List<BitVec(64)>) => xs.tail(), h),
        Cons(p, rest) => λ v ans => Ty::takes_map(tys, p,
            λ ws a => Ty::AnswersWords(tys, rest, r, v(a), λ more => ans(ws ++ more)),
            λ ws a => Ty::AnswersAlso(tys, rest, r, v(a), λ more => ans(ws ++ more).tail()),
            λ ws a inner => Ty::answers_words_also(tys, rest, r, v(a), λ more => ans(ws ++ more), inner)),
    }
}

// A curried meaning answers every word like a word function that agrees
// with its uncurried form on every word list its parameters admit.
theorem Ty::curry_answers_words(tys: Table, r: Ty, ps: List<Ty>): (g: List<Ty>) → (env: Env(tys, g)) →
    (k: Env(tys, Ty::bind_onto(ps, g)) → r.sem(tys)) → (ans: List<BitVec(64)> → List<BitVec(64)>) → Ty::PassesAll(tys, ps) →
    ((xs: List<BitVec(64)>) → Ty::AdmitsAll(tys, ps, xs) → ans(xs) = Ty::result_words(tys, r, k(Ty::extend_words(tys, ps, g, env, xs)))) →
    Ty::AnswersWords(tys, ps, r, Ty::curry(tys, r, ps, g, env, k), ans) {
    match ps {
        Nil => λ g env k ans _ h => h(Nil, trivial),
        Cons(p, rest) => λ g env k ans ok h => Ty::takes_intro(tys, p,
            λ ws a => Ty::AnswersWords(tys, rest, r, Ty::curry(tys, r, rest, Cons(p, g), Pair(a, env), k), λ more => ans(ws ++ more)), ok.left,
            λ ws a taken => Ty::curry_answers_words(tys, r, rest, Cons(p, g), Pair(a, env), k, λ more => ans(ws ++ more), ok.right, λ more admitted => {
                let t = taken.right(more);
                let xs = ws ++ more;
                let k_at = λ (u: p.sem(tys)) (s: List<BitVec(64)>) => Ty::result_words(tys, r, k(Ty::extend_words(tys, rest, Cons(p, g), Pair(u, env), s)));
                trans(h(xs, ⟨t.left, j(sym(t.right.left), λ s _ => Ty::AdmitsAll(tys, rest, s), admitted)⟩),
                    trans(cong_fn(λ (u: p.sem(tys)) => k_at(u, Ty::skip(p.span(tys), xs)), t.right.right),
                        cong_fn(λ (s: List<BitVec(64)>) => k_at(a, s), t.right.left)))
            })),
    }
}

// What a function's lowering promises: called on any words, with calls
// answered by the program's meanings, it answers with its meaning's every
// word (its first, then its words past the first), over
// the file of spans the meaning reads. A function lent spans takes each as
// two words before its own (`Fun.lent`), and the agreement is at every
// word there: the meaning reads a span under the length word it is handed
// (`Tm::Byte`), as the code does, so nothing is asked of those words here.
// That they are the span's place and length is the caller's to supply
// (`Lending`, function_ir_lower_reads).
fn Fun::LowerHolds(self f: Fun, w: World, r: Option<Function>) → Type {
    match r {
        None => True,
        Some(code) => (call: Answers()) → Tm::CallsAgree(w, call) →
            Ty::AnswersWords(w.tys, f.params, f.result, f.meaning(w), λ xs => code.eval_words(call, xs, buffers := w.spans)),
    }
}

theorem Fun::lower_sound(self f: Fun, w: World): f.LowerHolds(w, f.lower(w)) {
    let P = λ (r: Option<Function>) => f.LowerHolds(w, r);
    let ids = Fun::word_ids(w.tys, f.params, 0);
    let e = f.entry_of(w.tys);
    Option::and_then_elim(P, trivial, Ty::check_edges(w.tys, f.params), λ _ => f.lower_result(w), λ ok _ =>
    Option::and_then_elim(P, trivial, f.result.check_out(w.tys), λ _ => f.lower_distinct(w), λ er _ =>
    Option::and_then_elim(P, trivial, Tm::check_true(distinct(ids)), λ _ => f.lower_body(w), λ apart _ =>
    Option::and_then_elim(P, trivial, f.body.lower(w, f.context(), e.ports, e.next), λ c => f.lower_typed(w, c), λ c lowered =>
    Option::and_then_elim(P, trivial, Tm::ty(f.body, w, f.context()).check(f.result), λ _ => Some(f.code_of(w.tys, e, c)), λ eb _ =>
        λ call agree => Ty::curry_answers_words(w.tys, f.result, f.params, Nil, trivial,
            λ env => Ty::cast(w.tys, Tm::ty(f.body, w, f.context()), f.result, Tm::sem(f.body, w, f.context(), env)),
            λ xs => f.code_of(w.tys, e, c).eval_words(call, xs, buffers := w.spans), Ty::edges_pass(w.tys, f.params, ok), λ xs admitted => {
                let values = Valuation::bind(Valuation::zero(), ids, xs);
                let env = Ty::extend_words(w.tys, f.params, Nil, trivial, xs);
                let entered = Fun::entry_holds(w.tys, w.spans, f.params, Nil, Nil, trivial, 0, Fun::words_past(w.tys, f.params, 0), xs, values, ok, admitted, trivial, trivial,
                    Fun::bind_bound(ids, xs, apart), Fun::words_past(w.tys, f.params, 0).le_refl());
                let inside = eval_nodes_over(w.spans, e.nodes, values);
                let after = c.region.eval(call, inside, buffers := w.spans);
                let body_ty = Tm::ty(f.body, w, f.context());
                let value = Ty::cast(w.tys, body_ty, f.result, Tm::sem(f.body, w, f.context(), env));
                let ran = j(lowered, λ r _ => Tm::LowerHolds(f.body, w, f.context(), e.ports, e.next, r),
                    Tm::lower_sound(f.body, w, f.context(), e.ports, e.next))(call, agree, inside, env, entered.left, entered.right);
                let holds = Fun::entered_holds(w.tys, call, w.spans, values, f.result, c, value, e.nodes,
                    Ty::cast_holds(w.tys, after, c.result, body_ty, f.result, eb, Tm::sem(f.body, w, f.context(), env), ran.right.right.right));
                let code = f.code_of(w.tys, e, c);
                let ended = code.body.eval(call, values, buffers := w.spans);
                let below_body: f.result.Below(w.tys, c.result, c.next) =
                    Ty::below_cast(w.tys, body_ty, f.result, eb, c.result, c.next, ran.right.left);
                let below = match e.nodes as λ ns => f.result.Below(w.tys, Fun::entered(ns, c).result, Fun::entered(ns, c).next) {
                    Nil => below_body, Cons(_, _) => below_body,
                };
                let out = Ty::out_pieces(w.tys, call, w.spans, values, f.result, Fun::entered(e.nodes, c), er, value, holds, below);
                let first: (ended(64, code.result) = Ty::cast(w.tys, f.result, Word(64), value)) = out.left;
                let also: (words_of(ended, code.also) = Ty::rest_words(w.tys, f.result, value)) = out.right;
                trans(cong_fn(λ (x: BitVec(64)) => Cons(x, words_of(ended, code.also)), first),
                    cong_fn(λ (rest: List<BitVec(64)>) => Cons(Ty::cast(w.tys, f.result, Word(64), value), rest), also))
            }))))))
}

// ---------------------------------------------------------------------------
// The lowering reads the world's type table and signatures and nothing
// else: not the meanings that answer its calls, not the file. So a function
// has one code at every file, which is what lets an instance carry one
// `Function` and state its agreement over any buffers
// (docs/native/native-one-compiler-design.md §2.3, U3c step 3). `World::over` is a
// world's table and file replaced; each lowering at it is the lowering at
// the world, by the same walk as the definition.

fn World::over(self w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>) → World { World(w.tys, w.sigs, cs, spans) }

theorem Tm::ty_static(self t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): (g: List<Ty>) →
    t.ty(w.over(cs, spans), g) = t.ty(w, g) {
    match t {
        Var(_) => λ g => refl,
        Lit(_, _) => λ g => refl,
        Prim(_, _) => λ g => refl,
        Let(e, body) => λ g => trans(cong_fn(λ (a: Ty) => body.ty(w.over(cs, spans), Cons(a, g)), Tm::ty_static(e, w, cs, spans, g)),
            Tm::ty_static(body, w, cs, spans, Cons(e.ty(w, g), g))),
        If(_, yes, _) => λ g => Tm::ty_static(yes, w, cs, spans, g),
        IfEq(_, yes, _) => λ g => Tm::ty_static(yes, w, cs, spans, g),
        Make(_, _) => λ g => refl,
        Field(_, _, _) => λ g => refl,
        Call(_, _) => λ g => refl,
        Fold(_, _, _) => λ g => refl,
        Case(_, zero, _) => λ g => Tm::ty_static(zero, w, cs, spans, g),
        Byte(_, _, _) => λ g => refl,
        Pick(i, _, arms, _) => λ g => Tm::ty_static(arms, w, cs, spans, Cons(Enum(i), g)),
        Inject(_, _, _) => λ g => refl,
        Slot(_, _, _) => λ g => refl,
        Iterate(_, _, _) => λ g => refl,
    }
}

// A branch's two arms, each lowered alike at both worlds.
theorem Tm::lower_if_static(c: Nat, yes, no: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, g: List<Ty>, ports: List<Nat>,
    next: Nat,
    same_yes: (n: Nat) → Tm::lower(yes, w.over(cs, spans), g, ports, n) = Tm::lower(yes, w, g, ports, n),
    same_no: (n: Nat) → Tm::lower(no, w.over(cs, spans), g, ports, n) = Tm::lower(no, w, g, ports, n)):
    Tm::lower(yes, w.over(cs, spans), g, ports, next).and_then(λ ly => Tm::lower(no, w.over(cs, spans), g, ports, ly.next).and_then(λ ln =>
        Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w.over(cs, spans), g), Tm::ty(no, w.over(cs, spans), g), ly, ln))) =
    Tm::lower(yes, w, g, ports, next).and_then(λ ly => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln =>
        Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln))) {
    let v = w.over(cs, spans);
    let arms_v = λ (ly: Lowered) (ln: Lowered) => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, v, g), Tm::ty(no, v, g), ly, ln);
    let arms_w = λ (ly: Lowered) (ln: Lowered) => Tm::lower_branch(w.tys, g, ports, c, Tm::ty(yes, w, g), Tm::ty(no, w, g), ly, ln);
    let rest_v = λ (ly: Lowered) => Tm::lower(no, v, g, ports, ly.next).and_then(λ ln => arms_v(ly, ln));
    let rest_w = λ (ly: Lowered) => Tm::lower(no, w, g, ports, ly.next).and_then(λ ln => arms_w(ly, ln));
    trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), same_yes(next)),
        Option::and_then_ext(Tm::lower(yes, w, g, ports, next), rest_v, rest_w, λ ly =>
            trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(λ ln => arms_v(ly, ln)), same_no(ly.next)),
                Option::and_then_ext(Tm::lower(no, w, g, ports, ly.next), λ ln => arms_v(ly, ln), λ ln => arms_w(ly, ln), λ ln =>
                    eq2(λ (a: Ty) (b: Ty) => Tm::lower_branch(w.tys, g, ports, c, a, b, ly, ln), Tm::ty_static(yes, w, cs, spans, g),
                        Tm::ty_static(no, w, cs, spans, g))))))
}

// A loop's lowering reads the world only through its test's and body's.
theorem Tm::iterate_static(init: Nat, test, body: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>, g: List<Ty>,
    ports: List<Nat>, next: Nat,
    same_test: (ps: List<Nat>) → (k: Nat) → Tm::lower(test, w.over(cs, spans), Cons(Ty::at(g, init), g), ps, k) = Tm::lower(test, w, Cons(Ty::at(g, init), g), ps, k),
    same_body: (ps: List<Nat>) → (k: Nat) → Tm::lower(body, w.over(cs, spans), Cons(Ty::at(g, init), g), ps, k) = Tm::lower(body, w, Cons(Ty::at(g, init), g), ps, k)):
    Tm::lower(Iterate(init, test, body), w.over(cs, spans), g, ports, next) = Tm::lower(Iterate(init, test, body), w, g, ports, next) {
    let v = w.over(cs, spans);
    let tys = w.tys;
    let st = Ty::at(g, init);
    let inner = Cons(st, g);
    let at = Tm::iter_at(tys, st, next);
    let checked_v = λ (pi: Nat) (c: Carry) (lt: Lowered) (lb: Lowered) => Tm::iter_checked(v, st, inner, test, body, pi, next, c, lt, lb);
    let checked_w = λ (pi: Nat) (c: Carry) (lt: Lowered) (lb: Lowered) => Tm::iter_checked(w, st, inner, test, body, pi, next, c, lt, lb);
    let body_v = λ (pi: Nat) (c: Carry) (lt: Lowered) => Tm::lower(body, v, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb => checked_v(pi, c, lt, lb));
    let body_w = λ (pi: Nat) (c: Carry) (lt: Lowered) => Tm::lower(body, w, inner, Cons(next + 1, c.inner), lt.next).and_then(λ lb => checked_w(pi, c, lt, lb));
    let test_v = λ (pi: Nat) (c: Carry) => Tm::lower(test, v, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt => body_v(pi, c, lt));
    let test_w = λ (pi: Nat) (c: Carry) => Tm::lower(test, w, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1).and_then(λ lt => body_w(pi, c, lt));
    let ks = Tm::iter_keeps(g, Ty::at(g, init), test, body);
    let K = Tm::iter_keep(g, Ty::at(g, init), test, body);
    let carry_v = λ (pi: Nat) => Tm::both(test.check_within(K), body.check_within(K)).and_then(λ _ =>
        Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c => test_v(pi, c)));
    let carry_w = λ (pi: Nat) => Tm::both(test.check_within(K), body.check_within(K)).and_then(λ _ =>
        Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c => test_w(pi, c)));
    Option::and_then_ext(port_at(ports, init), λ pi => st.check_carries(tys).and_then(λ _ => carry_v(pi)),
        λ pi => st.check_carries(tys).and_then(λ _ => carry_w(pi)), λ pi =>
    Option::and_then_ext(st.check_carries(tys), λ _ => carry_v(pi), λ _ => carry_w(pi), λ _ =>
    Option::and_then_ext(Tm::both(test.check_within(K), body.check_within(K)), λ _ => Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c => test_v(pi, c)),
        λ _ => Tm::carry(tys, st, next + 1, g, ks, ports, at).and_then(λ c => test_w(pi, c)), λ _ =>
    Option::and_then_ext(Tm::carry(tys, st, next + 1, g, ks, ports, at), λ c => test_v(pi, c), λ c => test_w(pi, c), λ c =>
        trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lt => body_v(pi, c, lt)), same_test(Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1)),
    Option::and_then_ext(Tm::lower(test, w, inner, Cons(next + 1, c.inner), Fun::past(c.cells, at) + 1), λ lt => body_v(pi, c, lt), λ lt => body_w(pi, c, lt), λ lt =>
        trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lb => checked_v(pi, c, lt, lb)), same_body(Cons(next + 1, c.inner), lt.next)),
    Option::and_then_ext(Tm::lower(body, w, inner, Cons(next + 1, c.inner), lt.next), λ lb => checked_v(pi, c, lt, lb), λ lb => checked_w(pi, c, lt, lb), λ lb =>
        eq2(λ (a: Ty) (b: Ty) => a.check(Bit).and_then(λ _ => b.check(st).and_then(λ _ => Some(Tm::iter_region(tys, st, pi, next, c, lt, lb)))),
            Tm::ty_static(test, w, cs, spans, inner), Tm::ty_static(body, w, cs, spans, inner))))))))))
}

theorem Tm::lower_static(self t: Tm, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): (g: List<Ty>) → (ports: List<Nat>) →
    (next: Nat) → Tm::lower(t, w.over(cs, spans), g, ports, next) = Tm::lower(t, w, g, ports, next) {
    match t {
        Var(_) => λ g ports next => refl,
        Lit(_, _) => λ g ports next => refl,
        Prim(_, _) => λ g ports next => refl,
        Make(_, _) => λ g ports next => refl,
        Field(_, _, _) => λ g ports next => refl,
        Call(_, _) => λ g ports next => refl,
        Fold(_, _, _) => λ g ports next => refl,
        Case(_, _, _) => λ g ports next => refl,
        Byte(_, _, _) => λ g ports next => refl,
        Inject(_, _, _) => λ g ports next => refl,
        Slot(_, _, _) => λ g ports next => refl,
        Pick(i, c, arms, eq) => λ g ports next => Option::and_then_ext(port_at(ports, c),
            λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w.over(cs, spans), Cons(Enum(i), g), Cons(pc, ports), next)),
            λ pc => Ty::at(g, c).check(Enum(i)).and_then(λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next)),
            λ pc => Option::and_then_ext(Ty::at(g, c).check(Enum(i)),
                λ _ => Tm::lower(arms, w.over(cs, spans), Cons(Enum(i), g), Cons(pc, ports), next),
                λ _ => Tm::lower(arms, w, Cons(Enum(i), g), Cons(pc, ports), next),
                λ _ => Tm::lower_static(arms, w, cs, spans, Cons(Enum(i), g), Cons(pc, ports), next))),
        Let(e, body) => λ g ports next => {
            let v = w.over(cs, spans);
            let rest_v = λ (le: Lowered) => Tm::lower(body, v, Cons(Tm::ty(e, v, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb));
            let rest_w = λ (le: Lowered) => Tm::lower(body, w, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next).and_then(λ lb => Tm::compose(le, lb));
            trans(cong_fn(λ (o: Option<Lowered>) => o.and_then(rest_v), Tm::lower_static(e, w, cs, spans, g, ports, next)),
                Option::and_then_ext(Tm::lower(e, w, g, ports, next), rest_v, rest_w, λ le =>
                    cong_fn(λ (o: Option<Lowered>) => o.and_then(λ lb => Tm::compose(le, lb)),
                        trans(cong_fn(λ (a: Ty) => Tm::lower(body, v, Cons(a, g), Cons(le.result, ports), le.next), Tm::ty_static(e, w, cs, spans, g)),
                            Tm::lower_static(body, w, cs, spans, Cons(Tm::ty(e, w, g), g), Cons(le.result, ports), le.next)))))
        },
        If(c, yes, no) => λ g ports next => Tm::lower_if_static(c, yes, no, w, cs, spans, g, ports, next,
            λ n => Tm::lower_static(yes, w, cs, spans, g, ports, n), λ n => Tm::lower_static(no, w, cs, spans, g, ports, n)),
        IfEq(c, yes, no) => λ g ports next => Tm::lower_if_static(c, yes, no, w, cs, spans, g, ports, next,
            λ n => Tm::lower_static(yes, w, cs, spans, g, ports, n), λ n => Tm::lower_static(no, w, cs, spans, g, ports, n)),
        Iterate(init, test, body) => λ g ports next => Tm::iterate_static(init, test, body, w, cs, spans, g, ports, next,
            λ ps k => Tm::lower_static(test, w, cs, spans, Cons(Ty::at(g, init), g), ps, k),
            λ ps k => Tm::lower_static(body, w, cs, spans, Cons(Ty::at(g, init), g), ps, k)),
    }
}

theorem Fun::lower_static(self f: Fun, w: World, cs: Sig::Sems(w.tys, w.sigs), spans: List<List<BitVec(8)>>): f.lower(w.over(cs, spans)) = f.lower(w) {
    let v = w.over(cs, spans);
    let ports = f.entry_of(w.tys).ports;
    let next = f.entry_of(w.tys).next;
    let typed = λ (c: Lowered) => cong_fn(λ (a: Ty) => a.check(f.result).and_then(λ _ => Some(f.code_of(w.tys, f.entry_of(w.tys), c))),
        Tm::ty_static(f.body, w, cs, spans, f.context()));
    let body: (f.lower_body(v) = f.lower_body(w)) = trans(
        cong_fn(λ (o: Option<Lowered>) => o.and_then(λ c => f.lower_typed(v, c)), Tm::lower_static(f.body, w, cs, spans, f.context(), ports, next)),
        Option::and_then_ext(f.body.lower(w, f.context(), ports, next), λ c => f.lower_typed(v, c), λ c => f.lower_typed(w, c), typed));
    let apart: (f.lower_distinct(v) = f.lower_distinct(w)) = cong_fn(λ (o: Option<Function>) =>
        Tm::check_true(distinct(Fun::word_ids(w.tys, f.params, 0))).and_then(λ _ => o), body);
    let result: (f.lower_result(v) = f.lower_result(w)) = cong_fn(λ (o: Option<Function>) => f.result.check_out(w.tys).and_then(λ _ => o), apart);
    cong_fn(λ (o: Option<Function>) => Ty::check_edges(w.tys, f.params).and_then(λ _ => o), result)
}
